────────────────────
_ do emit-function
    - id FunctionId

ir.reset(id)
function = tables.functions[id]
read-instance(function.instance)
unit = unit.source-module = function.module
returns-type = types.void-type
stepping = function.kind == .generator-body
bind-slots()
ir.signals = function.may-panic || function.carries || function.polls
ir.start-block(ir.reserve-block())
if function.polls
    open-polls()
clear-lazies()
open-uses()
if function.unplaced && (function.may-panic || raises-errors())
    refuse-own()
else if unit.instance != no-instance && tables.holds-unmade(unit.instance)
    . written = instances.rows[unit.instance].subtree
    refuse(.refused-function, if written.count != 0 then written.start + written.count - 1 else 0)
else if function.kind == .module-main
    open-environment(0)
    make-subscribers(0)
    emit-statements()
    end-main()
    close-cleanups(0)
    return-nothing()
else if function.kind == .instance-body && tables.is-region(unit.instance)
    emit-region-body()
else if function.kind == .instance-body && tables.body-functions[unit.instance] != no-function
    if tables.functions[tables.body-functions[unit.instance]].kind == .constructor-body
        emit-filling()
    else
        emit-view()
else if instance-or-init || function.kind == .viewed-body || function.kind == .constructor-body
    emit-body()
else if function.kind == .generator-body
    emit-body()
    check-steps()
else if function.kind == .lazy-property
    emit-lazy()
else if function.kind == .property-updater
    emit-updater()
else if function.kind == .class-rule-updater
    emit-class-rule-updater()
else if function.kind == .style-gate
    emit-style-gate()
else if function.kind == .style-scope-state
    emit-scope-cell()
else if function.kind == .slot-forward
    emit-slot-forward()
else if function.kind == .style-author
    emit-style-author()
else if function.kind == .style-given-author
    emit-given-author()
else if function.kind == .style-rule
    emit-style-rule()
else if function.kind == .style-static-value
    emit-static-value()
else if function.kind == .style-themed-value
    emit-themed-value()
else if function.kind == .markup-query
    emit-ancestor-query()
else if function.kind == .markup-query-add || function.kind == .markup-query-remove
    emit-descendant-query(function.kind == .markup-query-remove)
else if function.kind == .markup-trigger-add || function.kind == .markup-trigger-remove
    emit-trigger-change(function.kind == .markup-trigger-remove)
else if function.kind == .markup-trigger-ancestor
    emit-trigger-ancestor()
else if function.kind == .live-adapter
    emit-live-adapter()
else if function.kind == .idle-action
    emit-idle-action()
else if function.kind == .module-constants
    emit-globals(.global-constant)
else if function.kind == .module-globals
    emit-globals(.global-eager)
else if function.kind == .lazy-global
    emit-lazy-global()
else if function.kind == .task-local-init || function.kind == .thread-local-init || stack-init
    emit-local-global()
else if function.kind == .task-body
    emit-task-body()
else if function.kind == .module-statics
    emit-statics()
else if function.kind == .argument-default
    emit-argument-default()
else if function.kind == .stream-action
    emit-stream-action()
else if function.kind == .machine-handler
    emit-machine-handler()
else if function.kind == .machine-cast
    emit-machine-cast()
else if function.kind == .machine-activation
    emit-machine-activation()
else if function.kind == .machine-descriptor
    emit-machine-descriptor()
else if function.kind == .machine-deferral
    emit-machine-deferral()
else if function.kind == .machine-part
    emit-machine-part()
else if function.kind == .machine-stop
    emit-machine-stop()
else if function.kind == .pattern-helper
    emit-pattern-helper()
else if function.kind == .pattern-cast
    emit-pattern-cast()
else if function.kind == .lazy-rule
    emit-lazy-rule(function.place)
else if function.kind == .rule-adapter
    emit-rule-adapter(function.place)
else if function.kind == .mapped-rule
    emit-mapped-rule()
else if function.kind == .raising-rule
    emit-raising-rule()
else if function.kind == .adapter
    emit-adapter()
else if function.kind == .witness
    emit-witness()
else if function.kind == .class-adapter
    emit-class-adapter()
else if function.kind == .union-dispatch
    emit-union-dispatch()
else if function.kind == .interface-equality
    emit-interface-equality()
else if function.kind == .storage-growth
    emit-storage-growth()
else if function.kind == .source-attach
    emit-source-attach()
else if function.kind == .raise-panic
    emit-raise-panic()
else if function.kind == .raise-message
    emit-raise-message()
else if function.kind == .event-handler
    emit-event-handler()
else if function.kind == .event-matcher
    emit-event-matcher()
else if function.kind == .event-registrations
    emit-event-registrations()
else if function.kind == .style-registration
    emit-style-registration()
else if function.kind == .style-sheet-registration
    emit-sheet-registration()
else if function.kind == .batch-main
    emit-batch-main()
else if function.kind == .batch-finish
    emit-batch-finish()
else if function.kind == .probe-setup
    emit-probe-setup()
else if function.kind == .probe-teardown
    emit-probe-teardown()
else if function.kind == .probe-flush
    call-probe-function(instances.probe-runtime.task-flush, 0, pending.length)
    return-nothing()
else if function.kind == .probe-safepoint
    call-probe-function(instances.probe-runtime.safepoint, 0, pending.length)
    return-nothing()
else
    . placed = if function.kind == .module-init then init-site() else 0
    if function.kind == .module-init
        placed = register-styles(placed)
        if function.module == program.entry-module && tables.erased-publishes != 0
            count-event(.publish-sites-erased, 0, tables.erased-publishes)
    . starts-case = function.kind == .task-main && program.is-batch
    if starts-case
        start-case()
    for position in function.calls.start .. < function.calls.end
        if starts-case && tables.calls[position] == tables.probe-setup
            set-up-batch-probes()
        else
            call-function(tables.calls[position], placed)
    placing = false
    if starts-case
        fork-batch(tables.batch-finishes[function.place])
    if function.kind == .task-main || function.kind == .probe-closer
        call-runtime(.runtime-terminate-active-task, 0, pending.length)
    return-nothing()
.. instance-or-init = function.kind == .instance-body || function.kind == .instance-initializer
.. stack-init = function.kind == .stack-local-init
. ruled = function.kind == .pattern-helper || function.kind == .pattern-cast || function.kind == .lazy-rule || function.kind == .mapped-rule || function.kind == .stream-action || function.kind == .raising-rule || function.kind == .rule-adapter
. machined = handler-or-cast || activates || describes || function.kind == .machine-deferral
    .. handler-or-cast = function.kind == .machine-handler || function.kind == .machine-cast
    .. activates = function.kind == .machine-activation
    .. describes = function.kind == .machine-descriptor
machined = machined || function.kind == .machine-part || function.kind == .machine-stop
if !machined && no-result && not-entry && not-handler && !ruled
    if instances.signatures[unit.instance].errors.count != 0
        refuse-own()
.. no-result = unit.instance != no-instance && result-type == no-type
.. not-entry = function.kind != .module-main && function.kind != .task-body
.. not-handler = function.kind != .event-handler && function.kind != .class-rule-updater
if zone-answer != 0
    refuse-own()
close-uses()
finish-landing()

────────────────────
_ get tree AST

program.modules[unit.source-module].tree

────────────────────
_ do refuse ?! Refused
    - construct RefusedConstruct
    - syntax SyntaxId

refusal = Refusal(construct, unit.source-module, syntax)
?! Refused("Refused")

────────────────────
_ do refuse-function-at ?! Refused
    - module ModuleId
    - syntax SyntaxId

refusal = Refusal(.refused-function, module, syntax)
?! Refused("Refused")

────────────────────
_ do refuse-instance
    - refused InstanceId

. row = instances.rows[refused]
refuse-function-at
    - row.module
    - if row.subtree.count != 0 then row.subtree.start + row.subtree.count - 1 else 0

────────────────────
_ do refuse-class
    - type TypeId

do match? types.rows[type]
    | .type-class(row)
        refuse-function-at(row.module, class-site(type))
        =
refuse(.refused-function, 0)

────────────────────
_ do refuse-own

if function.kind == .adapter
    refuse-function-at(function.module, tables.adapters[function.place].site)
else if function.kind == .stream-action
    refuse-function-at(function.module, facts.outlined[function.place].arm)
else if unit.instance != no-instance
    refuse-instance(unit.instance)
else
    refuse(.refused-function, 0)

────────────────────
_ do bind-slots

` Makes the columns that find what a slot of the function's binding is kept in, and which
` argument a slot that is one is. They live in the function's arena.
unit = unit.slot-start = 0
unit = unit.slot-count = 0
unit = unit.own-scope = no-scope
if unit.instance != no-instance
    unit = unit.own-scope = tables.instance-scopes[unit.instance]
    . binding = instances.rows[unit.instance].binding
    if binding != no-binding
        . bound = bindings.bindings[binding].slots
        unit = unit.slot-start = bound.start
        unit = unit.slot-count = bound.count
unit = unit.cells = storage.allocate'U32(unit.slot-count + 1)
unit = unit.lazy-flags = storage.allocate'U32(unit.slot-count + 1)
unit = unit.lazy-readers = storage.allocate'U32(unit.slot-count + 1)
unit = unit.fill-flags = storage.allocate'U32(unit.slot-count + 1)
unit = unit.fill-cells = storage.allocate'U32(unit.slot-count + 1)
unit = unit.kept = storage.allocate'U32(unit.slot-count + 1)
unit = unit.kept-types = storage.allocate'U32(unit.slot-count + 1)
unit = unit.positions = storage.allocate'U32(unit.slot-count + 1)
unit = unit.open-held = no-place
. seen U32
for offset in 0 .. < unit.slot-count
    unit.cells[offset] = no-local
    unit.lazy-flags[offset] = no-local
    unit.lazy-readers[offset] = 0
    unit.fill-flags[offset] = no-local
    unit.fill-cells[offset] = no-local
    unit.kept[offset] = make-operand(.operand-void, 0)
    unit.kept-types[offset] = no-type
    unit.positions[offset] = seen
    if bindings.slots[unit.slot-start + offset].kind == .slot-argument && owns(unit.slot-start + offset)
        seen += 1

────────────────────
_ owns Bool
    - slot SlotId

` Whether a slot is one the emitted function declares, and no nested function written in
` it or function it is written in.
unit.own-scope == no-scope || tables.slot-functions[slot] == unit.own-scope

────────────────────
_ do sees Bool
    - slot SlotId

` Whether a slot is declared by the function's own scope or by one it is written in. The
` outermost scope of a binding has no parent before it.
. scope = unit.own-scope
if scope == no-scope
    = true
while tables.slot-functions[slot] != scope
    . parent = bindings.scopes[scope].parent
    if parent >= scope
        = false
    scope = parent
= true

────────────────────
_ is-captured Bool
    - slot SlotId

` Whether a slot is kept in an environment: one that nested functions capture, or any slot
` of a function that yields, whose environment keeps them from one step to the next. A
` function built with no environment keeps as locals those its own scope's would hold. A
` slot that only tasks spawned in its own function copy is a local there, and kept in the
` capture of each task's body.
homed || copied
    .. homed = tables.slot-homes[slot] != no-scope && !(unshared && tables.slot-homes[slot] == unit.own-scope)
    .. copied = tables.slot-copied[slot] != 0 && tables.slot-functions[slot] != unit.own-scope && spawned
    .. spawned = unit.instance != no-instance && tables.capture-rows[unit.instance] != no-place

────────────────────
_ do open-environment
    - site SyntaxId

` Makes the environment of the function's own scope, where nested functions capture
` locals it declares: an object the collector owns, which arrives zeroed, with the link to
` the environment the function was given. It is made once in a run of the function, before
` the arguments are bound. A function built with no environment makes none.
if unit.instance == no-instance || unit.own-scope == no-scope || unshared
    =
. layout = tables.environments[unit.instance]
if layout == no-layout
    =
if layout == unbuilt-environment
    refuse(.refused-function, site)
    =
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. made = call-runtime(.runtime-allocate-object, site, mark, managed-layout)
unit = unit.environment = ir.add-local(managed-layout)
store-local(unit.environment, made, site)
if unit.received
    store(made, 0, given-environment(site), true, site)

────────────────────
_ runs-in-body Bool
    - statement SyntaxId

` Whether a statement of a body is one that runs: one that declares nothing, or a nested
` function written there for its value, which the type pass typed as one.
tables.runs-statement(unit.source-module, probe-decl(), tree, statement) || closure-statement
.. closure-statement = is-closure(facts.node-type(unit.reading, statement))

────────────────────
_ do share-self
    - site SyntaxId

` The receiver of a member whose nested functions read it: the member copies it into its
` environment, and a nested function reads it from there once and has it as its own. An
` object is shared so, a value of an interface, a value of a function type, a value that
` is one number, and a tuple no constructor is making, which nothing changes in place; a
` struct, which a member changes where it is kept, has no shape here. A member that yields
` keeps its receiver the same way: where it is called it copies it, and each step of its
` body reads it from there. The body of a spawned task or of a `do without gc` block that does not
` copy it has none, nor has a function that captures a struct only for the tasks spawned in it,
` which no value owns.
. binding = instances.rows[unit.instance].binding
if binding == no-binding
    =
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    if bindings.slots[slot].kind != .slot-this || !is-captured(slot) || !sees(slot)
        continue
    if tables.capture-rows[unit.instance] != U32.max && tables.capture-field(unit.instance, slot) == U32.max
        continue
    . held = find-captured(slot, site).type
    . whole = tables.is-class(held) || intrinsic(held) == .interface
    whole = whole || !tables.layouts.is-struct(layout-of(held, site))
    whole = whole || layout-of(held, site) == tables.layouts.function-layout
    whole = whole || (intrinsic(held) == .tuple && !builds)
    if !whole && (bindings.slots[slot].flags /and/ SlotFlag.slot-self-used) == 0
        continue
    if !whole
        refuse(.refused-function, site)
    else if unit.received || stepping
        unit = unit.self = read-captured(slot, site, held).operand
        unit = unit.owner-type = held
        unit = unit.has-self = true
    else if unit.has-self
        keep-captured(slot, unit.self, held, site)

────────────────────
_ do find-captured LayoutField
    - slot SlotId
    - site SyntaxId

` Where a slot that nested functions capture is kept: its field in the environment of the
` scope that declares it. That scope is the emitted function's own, or that of a function
` it is written in, whose instance types the field, or a loop of either, a turn of which
` has an environment of its own. `hops` is left as how many environments lie between the
` one the function was given and that one, or as none for its own. `turn` is left as the
` local that holds the environment of a turn of the function's own loop, which must be
` the turn being emitted. A spawned task's body keeps what it copies in the capture it was
` given, which is the link of its environment, and that capture's own link leads on to the
` environments where what it shares is kept. A slot only tasks capture has no home: it is
` found in the capture of the task that copied it.
. nothing = LayoutField(0, void-layout)
hops = no-hops
turn = no-local
turn-place = no-place
through = no-place
home-owner = no-instance
home-layout = no-layout
. home = tables.slot-homes[slot]
. follows = unit.reading == unit.instance || unit.reading == unit.lender
. copied = tables.slot-copied[slot] != 0
if !follows || unit.own-scope == no-scope || (home == no-scope && !copied)
    refuse(.refused-expression, site)
    = nothing
. owner = unit.instance
. scope = unit.own-scope
if tables.slot-functions[slot] == unit.own-scope && home != unit.own-scope
    . position = open-turns.length
    while position != 0 && open-turns[position - 1].scope != home
        position -= 1
    . held = tables.turn-environment(unit.instance, home)
    if position == 0 || held == no-layout || held == unbuilt-environment
        refuse(.refused-expression, site)
        = nothing
    turn = open-turns[position - 1].local
    turn-place = open-turns[position - 1].place
    home-owner = unit.instance
    home-layout = held
    = tables.layouts.field(held, 1 + tables.slot-fields[slot])
if scope != home
    hops = 0
while scope != home
    if tables.capture-rows[owner] != no-place
        if tables.copies(owner, slot)
            = task-captured(slot, owner, site)
        if !tables.links-capture(owner)
            refuse(.refused-expression, site)
            = nothing
        hops += 1
    if bindings.scopes[scope].kind != .scope-nested
        refuse(.refused-expression, site)
        = nothing
    owner = facts-owner(instances.rows[owner].enclosing)
    scope = bindings.scopes[scope].parent
    while scope != home && bindings.scopes[scope].kind != .scope-function && bindings.scopes[scope].kind != .scope-nested
        if tables.is-turn-scope(scope) && tables.scope-captures[scope] != 0
            hops += 1
        scope = bindings.scopes[scope].parent
    if owner == no-instance
        refuse(.refused-expression, site)
        = nothing
    if scope != home && (tables.holds-environment(scope) || tables.holds-stacks(owner))
        hops += 1
. layout = tables.environments[owner]
if tables.is-turn-scope(home)
    layout = tables.turn-environment(owner, home)
if layout == no-layout || layout == unbuilt-environment
    refuse(.refused-expression, site)
    = nothing
home-owner = owner
home-layout = layout
= tables.layouts.field(layout, 1 + tables.slot-fields[slot])

────────────────────
_ facts-owner InstanceId
    - owner InstanceId

` The instance whose facts and environment are an instance's: the main of its module for the
` value of a global, whose facts the type pass moves there, and the instance itself otherwise.
|? owner == no-instance || instances.rows[owner].initializer == 0 || instances.keeps-facts(owner)
    owner
??
    tables.main-instances[instances.rows[owner].module]

────────────────────
_ do task-captured LayoutField
    - slot SlotId
    - owner InstanceId
    - site SyntaxId

` The field of the capture of a spawned task's body that holds a local it copies. Where the
` capture holds its address (`refers`), the local is at the start of what that address leads to.
. nothing = LayoutField(0, void-layout)
. layout = tables.captures[owner]
. field = tables.capture-field(owner, slot)
if layout == no-layout || layout == unbuilt-environment || field == U32.max
    refuse(.refused-expression, site)
    = nothing
home-owner = owner
home-layout = layout
. found = tables.layouts.field(layout, field)
if !tables.refers(owner, slot)
    = found
through = found.offset
= LayoutField(0, tables.layouts.values[found.type], found.type)

────────────────────
_ do captured-base Operand
    - site SyntaxId

` The environment `find-captured` found a slot in: that of the turn of a loop, the
` function's own, or the one it was given, or one as many links out from that as there
` are environments between. A slot the capture of a `do without gc` block refers to is found
` where the address it holds leads.
. nothing = make-operand(.operand-void, 0)
if turn != no-local || turn-place != no-place
    = turn-held(turn, turn-place, site)
if hops == no-hops
    if unit.environment == no-local
        refuse(.refused-expression, site)
        = nothing
    = load-local(unit.environment, site)
if !unit.received
    refuse(.refused-expression, site)
    = nothing
. base = given-environment(site)
if stepping
    base = load(base, 0, managed-layout, site)
for _ in 0 .. < hops
    base = load(base, 0, managed-layout, site)
if through != no-place
    = load(base, through, pointer-layout, site)
= base

────────────────────
_ do given-environment Operand
    - site SyntaxId

` The environment the function was given: its first argument, or for the function the event
` runtime calls for a section of a class, the one it made for the object it was given.
if made-environment != no-local
    = load-local(made-environment, site)
= make-operand(.operand-argument, 0)

────────────────────
_ do read-captured Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` The value of a local or an argument that nested functions capture, read from the
` environment that holds it. Where the type pass narrowed an optional one to what it
` holds, or a union to a case, the read is of that, as a local's is.
. nothing = make-operand(.operand-void, 0)
. field = find-captured(slot, id)
. held = field.type
. cased = held != type && facts.plan-of(unit.reading, id) == .plan-case-read
if held != type && !holds(held, type) && !cased
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. value = take(captured-base(id), field, id)
if held == type
    = Typed(value, held)
if shared-depth != 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if cased
    = read-case(id, value, held, type)
= payload(id, Typed(value, held))

────────────────────
_ do keep-captured
    - slot SlotId
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores a value in a local or an argument that nested functions capture: in the
` environment that holds it, through the write barrier where it is a managed pointer.
. field = find-captured(slot, site)
if field.type != type
    refuse(.refused-statement, site)
    =
. base = captured-base(site)
if tables.layouts.is-struct(field.layout)
    store-struct(base, field, value, site)
else if field.layout != void-layout
    store(base, field.offset, value, is-managed-pointer(field.layout), site)

────────────────────
_ do clear-lazies

` Gives each lazy local that is evaluated once in a run of the function the flag that says
` whether it has been, cleared here where the function starts, and notes whether any is
` evaluated by its one read. The locals one declaration names together have one flag. A lazy
` local held as an eager local is (`holds-lazy`) has its flag here, not in the environment.
unit = unit.inlines = false
for offset in 0 .. < unit.slot-count
    if bindings.slots[unit.slot-start + offset].kind != .slot-lazy || !owns(unit.slot-start + offset)
        continue
    . held = tables.holds-lazy(unit.slot-start + offset)
    if is-captured(unit.slot-start + offset) && !held
        continue
    if bindings.lazy-inlines(unit.slot-start + offset)
        unit = unit.inlines = true
    if bindings.lazy-policy(unit.slot-start + offset) != .lazy-memo && !held
        continue
    . group = bindings.slots[unit.slot-start + offset].group
    if offset != 0 && unit.lazy-flags[offset - 1] != no-local && same-group
        unit.lazy-flags[offset] = unit.lazy-flags[offset - 1]
        continue
    .. same-group = bindings.slots[unit.slot-start + offset - 1].group == group
    . flag = ir.add-local(u8-layout)
    unit.lazy-flags[offset] = flag
    store-local(flag, integer(.machine-u8, 0), 0)

────────────────────
_ do clear-fills

` Gives each lazy local of a constructor the flag that says whether it has been evaluated
` for the properties' first values, cleared here before the first of them.
for offset in 0 .. < unit.slot-count
    if bindings.slots[unit.slot-start + offset].kind != .slot-lazy
        continue
    . flag = ir.add-local(u8-layout)
    unit.fill-flags[offset] = flag
    store-local(flag, integer(.machine-u8, 0), 0)

────────────────────
_ do clear-checks

` Gives each property of the object being made that a value may first read on some of its paths
` alone the flag that says whether it has its first value, cleared here before the first of
` them, as the reference keeps one where such a read gives the property its value: so may a
` value given on some paths alone, which a flagged property's is. Where a read or its own turn
` finds the flag clear, the property is given its value (`check-property`). One whose value runs
` in a live action of its own has the trackers of the action made here, as the reference makes
` them, for whichever path gives it its value.
filling = filling.checks = storage.allocate'U32(filling.count + 1)
filling = filling.trackers = storage.allocate'U32(filling.count + 1)
for position in 0 .. < filling.count
    filling.checks[position] = no-local
    filling.trackers[position] = no-local
. changed = true
while changed
    changed = false
    for position in 0 .. < filling.count
        . unit-id = tables.value-unit(filling.start + position)
        if unit-id == no-instance
            continue
        . read = tables.first-read(unit-id)
        while read != no-fact
            . found = property-read(filling.type, read)
            . unsure = unsure-read || filling.checks[position] != no-local
                .. unsure-read = instances.rows[unit-id].branches && !facts.value-reads[read].surely
            if found && unsure
                . held = (found as U32) - filling.start
                if held < filling.count && filling.checks[held] == no-local
                    . flag = ir.add-local(u8-layout)
                    filling.checks[held] = flag
                    store-local(flag, integer(.machine-u8, 0), 0)
                    changed = true
            read = tables.next-read(read)
for position in 0 .. < filling.count
    . unit-id = tables.value-unit(filling.start + position)
    if filling.checks[position] != no-local && unit-id != no-instance && instances.rows[unit-id].is-live
        filling.trackers[position] = open-trackers(0)

────────────────────
_ do check-property ?! Refused
    - position U32
    - syntax SyntaxId

` Gives a property of the object being made its first value where its flag says it has none,
` and sets the flag, as the reference evaluates a property a read on some paths alone gives its
` value. A value run in a live action of its own notes what it reads in the trackers made for it
` where the constructor began; one with none has no shape here.
. flag = filling.checks[position]
. unit-id = tables.value-unit(filling.start + position)
. live = unit-id != no-instance && instances.rows[unit-id].is-live
if flag == no-local || filling.filled[position] == 1 || (live && filling.trackers[position] == no-local)
    refuse(.refused-expression, syntax)
    =
. given = ir.reserve-block()
. done = ir.reserve-block()
branch(load-local(flag, syntax), done, given)
ir.start-block(given)
filling.filled[position] = 0
checking += 1
store-property(position, syntax)
checking -= 1
store-local(flag, integer(.machine-u8, 1), syntax)
jump(done)
ir.start-block(done)

────────────────────
_ do slot-offset U32
    - slot SlotId
    - id SyntaxId

` The place of a slot in the columns, or a refusal for a slot of another binding.
if unit.reading != unit.instance || slot < unit.slot-start || slot - unit.slot-start >= unit.slot-count
    refuse(.refused-expression, id)
    = 0
= slot - unit.slot-start

────────────────────
_ do emit-statements

do match? tree.nodes[tree.root]
    | .node-top-level-syntax(row)
        for statement in tree.children[row.statements]
            if tables.runs-statement(unit.source-module, probe-decl(), tree, statement)
                emit-statement(statement)

────────────────────
_ do end-main

` Where the statements of the program's main end, before its cleanups run: the call of `end-main`
` of core that the type pass recorded at the main's node.
=? if !program.runs-main(function.module)
. fact = facts.first-call(unit.reading, tree.root)
if fact != no-fact
    call-instance(facts.calls[fact].callee, tree.root, pending.length)

────────────────────
_ do emit-block
    - body SyntaxId
    - ruled Bool = false

` The statements of a body in order: those of a block, or the one statement the body is, but
` the lines that are the rule's own where the body is a class's `• This` that writes its markup
` (`ruled`), and with the lines of a class's markup that declare properties it gives values
` (`content-property`). The cleanups the body opens run where it ends. Nothing after a
` statement that leaves is emitted, as the type pass checked none of it.
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
clear-turn-lazies(body)
raise-elements(body)
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            . runs = tables.runs-statement(unit.source-module, probe-decl(), tree, statement) || (tree.nodes[statement] is .node-property-syntax && tree.content-property(statement))
            if runs && !(ruled && tree.rule-part(statement))
                emit-statement(statement)
            if facts.is-leaving(unit.reading, statement)
                break
        close-cleanups(mark)
        scoping = own-scoping
        =
emit-statement(body)
close-cleanups(mark)
scoping = own-scoping

────────────────────
_ do clear-turn-lazies
    - body SyntaxId

` Clears again the flag of each lazy local a block declares in a loop that is evaluated once
` a turn, here where the block starts each turn, before any read of it.
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            if !is-lazy-local(statement)
                continue
            for offset in 0 .. < unit.slot-count
                . lazy = bindings.slots[unit.slot-start + offset]
                if lazy.group != statement || unit.lazy-flags[offset] == no-local
                    continue
                if (slot-use /and/ (LazyUseFlag.declared-in-loop)) != 0
                    store-local(unit.lazy-flags[offset], integer(.machine-u8, 0), 0)
                .. slot-use = bindings.lazy-use-of(unit.slot-start + offset).flags

────────────────────
_ do emit-do-body
    - id SyntaxId
    - body SyntaxId
    - effects CompilationEffect

` The body of a `do` block. One kept from the collector, written outside the zone, is a region
` of its own; any other runs in place, kept from what the block names as well.
if (effects /and/ CompilationEffect.gc-free) != 0 && !in-zone
    emit-region(id)
    =
. outer = block-effects
block-effects = block-effects /or/ restrictions-of(dispatch-effects(effects))
if !emit-match-statement(body)
    emit-block(body)
block-effects = outer

────────────────────
_ do emit-cancel-held
    - id SyntaxId
    - body SyntaxId
    - effects CompilationEffect

` `do without cancel`: the task holds off its cancellation from where the block begins to where
` it is left, by any way out, as a cleanup the block opens lets go. In a cleanup being run, the
` hold is let go where the block ends, by a pad of its own that a check made in it lands on
` before the cleanup's landing, and where an error or a `break` leaves it (`leave-held`).
. caught = landing
if scoping.cleaning && caught == no-block
    refuse(.refused-statement, id)
    =
call-runtime(.runtime-enter-cancel-shield, id, pending.length)
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
open-cleanup(id, UseCell(no-local, no-local, no-type))
if !scoping.cleaning
    emit-do-body(id, body, effects)
    close-cleanups(mark)
    scoping = own-scoping
    =
. pad = ir.reserve-block()
. checks = landings
landing = pad
emit-do-body(id, body, effects)
. landed = landings != checks
end-in-cleanup(mark, caught)
if landed
    . onward = ir.reserve-block()
    jump(onward)
    ir.start-block(pad)
    call-runtime(.runtime-leave-cancel-shield, id, pending.length)
    jump(caught)
    ir.start-block(onward)
scoping = own-scoping

────────────────────
_ do leave-held Bool
    - from Size
    - site SyntaxId

` Where a way out of a cleanup being run leaves what was opened in it from `from` on: each
` `do without cancel` block's hold is let go, newest first. Anything else opened there has no
` shape on such a way out, and then nothing is let go.
for position in from .. < open-cleanups.length
    . opened = open-cleanups[position]
    =? false if opened.cell.is-live-call || !(tree.nodes[opened.body] is .node-do-block)
. position = open-cleanups.length
while position > from
    position -= 1
    call-runtime(.runtime-leave-cancel-shield, site, pending.length)
= true

────────────────────
_ do emit-finally
    - id SyntaxId
    - body SyntaxId

` Opens a cleanup: a body that runs when the block it is written in is left, by any way out.
` A panic raised from here on runs it too, so the checks that follow land on a pad of their
` own. One written in a cleanup has no shape.
if scoping.cleaning
    refuse(.refused-statement, id)
    =
open-cleanup(body, UseCell(no-local, no-local, no-type))

────────────────────
_ do open-cleanup
    - item SyntaxId
    - cell UseCell

` Opens a cleanup in the block being emitted, which runs where the block is left: a body, a
` loop's streams or a `use`, with what a `use` reads. A panic raised from here on runs it
` too, so the checks that follow land on a pad of their own.
open-cleanups += OpenCleanup(item, scoping.block-base, cell, block-effects)
landing = no-block

────────────────────
_ do open-uses

` Where the function's binding has a `use`, the entry goes on to a head emitted once the body
` is, which clears the flag of each cell a `use` keeps its object in, and the body starts in a
` block of its own.
use-head = no-block
while use-flags.length != 0
    use-flags.pop()
if unit.instance == no-instance || stepping || instances.rows[unit.instance].binding == no-binding
    =
. range = bindings.bindings[instances.rows[unit.instance].binding].scans
. found = false
for scan in range.start .. < range.start + range.count
    if bindings.scans[scan].use-expressions != 0
        found = true
if !found
    =
use-head = ir.reserve-block()
use-body = ir.reserve-block()
jump(use-head)
ir.start-block(use-body)

────────────────────
_ do close-uses

` The head the entry goes on to in a function that has a `use`: each flag cleared, then the
` body.
if use-head == no-block
    =
ir.start-block(use-head)
for flag in use-flags
    store-local(flag, integer(.machine-u8, 0), 0)
jump(use-body)

────────────────────
_ can-use Bool
    - kept Bool

` Whether a `use` has a shape here: reading its own facts, and wherever `do finally` has one.
` One that keeps its object in a cell needs a function whose head clears the flags of its
` cells. In a generator, only one that keeps its object has a shape, which its slot keeps,
` and not in the loop of a comprehension or a list of bullets.
allowed && !is-free(unit.instance) && (stepping || !kept || use-head != no-block)
.. allowed = unit.reading == unit.instance && !scoping.cleaning && !builds && !initializes && (!stepping || generates)
.. generates = kept && given-loop == 0 && bullets == 0

────────────────────
_ chained-subject SyntaxId
    - expr SyntaxId

` What `use?` uses: the expression its optional chain holds, or none where it is written
` without one.
match tree.nodes[expr]
    | .node-optional-chain(row)
        row.expr
    ??
        0u32

────────────────────
_ do use-cell UseCell
    - id SyntaxId
    - type TypeId

` The cell a `use` keeps its object in, in the block being emitted: the one the cleanup the
` block opened for the node reads, or else a new one and the cleanup that reads it. A
` generator has none: its slot keeps the object.
for position in scoping.block-base .. < open-cleanups.length
    if open-cleanups[position].body == id
        = open-cleanups[position].cell
. layout = layout-of(type, id)
. cell = if stepping then UseCell(no-local, no-local, type) else UseCell(ir.add-local(u8-layout), ir.add-local(layout), type)
if !stepping
    use-flags += cell.flag
open-cleanup(id, cell)
= cell

────────────────────
_ do keep-used
    - id SyntaxId
    - cell UseCell
    - object Operand

` Keeps the object of a `use` where its end reads it: in its cell, with its flag set, or in
` the slot the binder declared for it, as an optional that holds it.
if cell.held != no-local
    store-local(cell.held, object, id)
    store-local(cell.flag, integer(.machine-u8, 1), id)
    =
. slot = using-slot(id)
. kept = facts.slot-type(unit.instance, slot-offset(slot, id))
if types.optional-inner(kept) != cell.type
    refuse(.refused-expression, id)
    =
. wrapped = wrap(id, Typed(object, cell.type), kept)
keep-state(slot, wrapped.operand, kept, id)

────────────────────
_ do using-slot SlotId
    - id SyntaxId

` The slot the binder declared for a `use`, in the function emitted.
. binding = instances.rows[unit.reading].binding
. slot = no-slot
if binding != no-binding && unit.reading == unit.instance
    slot = bindings.using-slot(binding, id)
if slot == no-slot
    refuse(.refused-expression, id)
= slot

────────────────────
_ do emit-use Typed
    - id SyntaxId
    - expr SyntaxId

` `use`: the subject is evaluated, and its `begin-using`, the first call the type pass recorded
` at the node, gives the value, or the subject itself where it only closes (`only-closes`). The
` object is then kept in the node's cell of the block being emitted, whose cleanup ends it where
` the block is left, by any way out. A subject written `use?` that holds nothing is used by
` nothing, and gives the optional that holds nothing; one that holds a value, or that the flow
` knows does, gives what `begin-using` gives, or itself, as an optional.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. begins = facts.first-call(unit.reading, id)
if !can-use(true) || begins == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. chain = chained-subject(expr)
. subject = emit-expression(if chain != 0 then chain else expr)
. joined = no-block
. made = void-layout
. slot = nothing
. mark = joins.length
. tests = chain != 0 && types.is-optional(subject.type)
if tests
    . held = subject.type
    made = layout-of(type, id)
    . empty = ir.reserve-block()
    . filled = ir.reserve-block()
    joined = ir.reserve-block()
    slot = join-slot(made)
    branch(present(id, subject).operand, filled, empty)
    ir.start-block(empty)
    arrive(id, empty-optional(type, made).operand, joined, slot)
    ir.start-block(filled)
    subject = payload(id, Typed(subject.operand, held))
. object-type = subject.type
. cell = use-cell(id, object-type)
. used = subject
if !only-closes(begins)
    . called = call-protocol(id, begins, subject.operand, object-type, nothing)
    used = Typed(called.operand, instances.signatures[facts.calls[begins].callee].returns)
keep-used(id, cell, subject.operand)
if chain != 0 && used.type != type
    used = wrap(id, used, type)
if !tests
    = used
arrive(id, used.operand, joined, slot)
= Typed(close-joins(joined, mark, made, slot), type)

────────────────────
_ do emit-use-block
    - id SyntaxId
    - subject SyntaxId
    - body SyntaxId

` `do use`: the subject is evaluated, and its `begin-using`, where it has one, called and what
` it gives dropped. The body runs in a block of its own, which ends the use of the subject where
` it is left, by any way out. A subject written `use?` that holds nothing runs nothing.
. begins = facts.first-call(unit.reading, id)
if !can-use(false) || begins == no-fact
    refuse(.refused-statement, id)
    =
. chain = chained-subject(subject)
. object = emit-expression(if chain != 0 then chain else subject)
. done = no-block
if chain != 0 && types.is-optional(object.type)
    . held = object.type
    . filled = ir.reserve-block()
    done = ir.reserve-block()
    branch(present(id, object).operand, filled, done)
    ir.start-block(filled)
    object = payload(id, Typed(object.operand, held))
. type = object.type
. cell = UseCell(no-local, ir.add-local(layout-of(type, id)), type)
if !only-closes(begins)
    call-protocol(id, begins, object.operand, type, make-operand(.operand-void, 0))
store-local(cell.held, object.operand, id)
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
open-cleanup(id, cell)
emit-block(body)
close-cleanups(mark)
scoping = own-scoping
if done != no-block
    jump(done)
    ir.start-block(done)

────────────────────
_ only-closes Bool
    - begins FactId

` Whether a `use` closes what it uses, which has no `begin-using`: the type pass recorded only
` its `close` at the node.
facts.calls[begins].next == no-fact

────────────────────
_ ending-call FactId
    - begins FactId

` The call that ends a `use`: `end-using`, the second the type pass recorded at the node, or
` `close`, the only one, where the use only closes.
if only-closes(begins) then begins else facts.calls[begins].next

────────────────────
_ do emit-forwarder
    - forward SwapForward

` A door a fake answers under a `do with`: it reads the fake from its effect's slot, where the
` `do with` or what holds its state put it, and calls the fake's method with it and the door's
` arguments, giving what that gives. Typed only under the binding, it finds the slot bound. Where
` the fake's class has no method that answers it, which only a door a function value reaches
` lets through, it panics.
. row = instances.rows[unit.instance]
. declared = match program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        fn.syntax
    ??
        0u32
. own = instances.signatures[unit.instance]
for position in 0 .. < own.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
returns-type = own.returns
ir.returns = layout-of(own.returns, declared)
if own.errors.count != 0
    return-results(own.result, declared)
if forward.callee == no-instance
    . name = program.effects.names[forward.effect].text
    raise-text(declared, "The fake bound to '$name' has no method '${paths-name(row)}' to answer its door")
    =
. slot = tables.storage-of(forward.module, forward.decl)
if slot == no-storage || tables.instance-functions[forward.callee] == no-function
    refuse(.refused-function, declared)
    =
. theirs = instances.signatures[forward.callee]
. kept = tables.storage[slot]
. state = stack-state(slot, declared)
. fake = take(state, tables.layouts.field(kept.layout, 1), declared)
. mark = pending.length
pending += fake
for position in 0 .. < own.args.count
    pending += make-operand(.operand-argument, position)
. forwards = theirs.errors.count != 0
takes-result = forwards
. answer = call-method(forward.callee, declared, mark, true)
if forwards && theirs.result != own.result
    return-recased(answer.operand, theirs.result, declared, no-instance, declared)
else if forwards
    return-held(answer.operand)
else if own.returns == types.void-type
    return-nothing()
else
    return-value(answer.operand, 0)

────────────────────
_ do emit-dispatch
    - declared SyntaxId
    - signature InstanceSignature

` A door reached where no `do with` binds a fake to its effect, in a program that binds one
` somewhere, as code a function value runs is: where the effect's slot holds a fake, it calls the
` door typed under a binding of that fake's class with its arguments and gives what that gives,
` which panics where that class has no method that answers it. It runs its body where the slot
` holds none.
. kind = make-operand(.operand-void, 0)
. read = false
for dispatch in facts.swap-dispatches
    if dispatch.instance == unit.instance
        . slot = tables.storage-of(dispatch.module, dispatch.decl)
        if slot == no-storage
            refuse(.refused-function, declared)
            =
        if !read
            . kept = tables.storage[slot]
            . flag = tables.layouts.field(kept.layout, 0)
            kind = load(stack-state(slot, declared), flag.offset, flag.layout, declared)
            read = true
        . chosen = ir.reserve-block()
        . next = ir.reserve-block()
        branch(compare(declared, .compare-equal, kind, integer(.machine-u8, dispatch.kind as U64)), chosen, next)
        ir.start-block(chosen)
        . mark = pending.length
        for position in 0 .. < signature.args.count
            pending += make-operand(.operand-argument, position)
        takes-result = signature.errors.count != 0
        . answer = call-instance(dispatch.forwarder, declared, mark)
        if signature.errors.count != 0
            return-held(answer.operand)
        else if signature.returns == types.void-type
            return-nothing()
        else
            return-value(answer.operand, 0)
        ir.start-block(next)

────────────────────
_ do paths-name String
    - row Instance

= match program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.name then fn.name.text else ""
    ??
        ""

────────────────────
_ do emit-stack-binding
    - id SyntaxId
    - value SyntaxId
    - body SyntaxId

` `do with`: the global is bound to the value, converted to its type, for the body. The slot's
` state is kept and the slot bound, and the body runs in a block of its own, whose reads of
` the global read the value, and which puts the slot back as it was where it is left, by any
` way out. One written where `do finally` has no shape has none. An effect is bound to a fake,
` an object of any class, as it is.
if scoping.cleaning || builds || initializes || is-free(unit.instance) || unit.reading != unit.instance
    refuse(.refused-statement, id)
    =
. row = stack-row(id)
if row == no-storage
    refuse(.refused-statement, id)
    =
. kept = tables.storage[row]
. fakes = program.modules[kept.module].decls[kept.decl] is .decl-effect
. bound = if fakes then emit-expression(value) else convert(id, .reason-assignment, emit-expression(value))
if bound.type != kept.type && !fakes
    refuse(.refused-conversion, id)
    =
. held = ir.add-local(if fakes then managed-layout else layout-of(kept.type, id))
store-local(held, bound.operand, id)
. previous = ir.add-local(kept.layout)
. slot = stack-slot(kept, id)
store-local(previous, slot, id)
. flag = if fakes then fake-kind(kept, bound.type) else 1u32
if flag == 0 || flag > 255
    refuse(.refused-statement, id)
    =
fill-stack(slot, kept, load-local(held, id), id, flag)
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
open-cleanup(id, UseCell(no-local, previous, no-type))
stack-bindings += StackBinding(row, held, flag)
emit-block(body)
stack-bindings.pop()
close-cleanups(mark)
scoping = own-scoping

────────────────────
_ do fake-kind U32
    - kept GlobalStorage
    - fake TypeId

. effect = program.effects.index-of(kept.module, kept.decl)
= if effect then instances.fake-kind(effect, fake) else 0u32

────────────────────
_ do unbind-stack
    - id SyntaxId
    - cell UseCell

` Puts the slot of the global a `do with` bound back as it was before, where a way out of its
` body runs it.
. row = stack-row(id)
if row == no-storage
    refuse(.refused-statement, id)
    =
. kept = tables.storage[row]
copy
    - stack-slot(kept, id)
    - load-local(cell.held, id)
    - kept.layout
    - tables.layouts.rows[kept.layout].is-managed
    - id

────────────────────
_ stack-row U32
    - id SyntaxId

` The storage of the global a `do with` binds.
|? global.kind != .resolve-global || tables.global-kind(global.module, global.decl) != .global-stack
    no-storage
??
    tables.storage-of(global.module, global.decl)

.. global = bindings.resolution-of(instances.rows[unit.reading].binding, id)

────────────────────
_ do stack-bound Bool
    - row U32

` Whether a binding of a global `do with` binds is open around what is being emitted.
for bound in stack-bindings
    if bound.bind == row
        = true
= false

────────────────────
_ do stack-slot Operand
    - kept GlobalStorage
    - site SyntaxId

` The slot of a global `do with` binds, in the memory of the task running.
= address(task-locals(site), kept.offset, kept.layout, site)

────────────────────
_ do fill-stack
    - target Operand
    - kept GlobalStorage
    - value Operand
    - site SyntaxId
    - bound U32 = 1

` Binds the state of a global `do with` binds, where it is kept, to a value: the flag is set,
` for an effect to the number of the fake's class, and the value stored, through the write barrier
` where it is a managed pointer.
. flag = tables.layouts.field(kept.layout, 0)
. held = tables.layouts.field(kept.layout, 1)
store(target, flag.offset, integer(.machine-u8, bound as U64), false, site)
if tables.layouts.is-struct(held.layout)
    copy
        - address(target, held.offset, held.layout, site)
        - value
        - held.layout
        - tables.layouts.rows[held.layout].is-managed
        - site
else if held.layout != void-layout
    store(target, held.offset, value, is-managed-pointer(held.layout), site)

────────────────────
_ do read-stack Typed
    - id SyntaxId
    - row U32

` A read of a global `do with` binds: the value of a binding of it open around the read in
` the function, or else the value its state holds, which raises a panic where it is not
` bound. That state is what a spawned task's body captured, or else the slot of the task
` running. A cleanup a landing pad runs is emitted once for all the checks that land there,
` where TypeScript reads what is bound where the panic was made, so a read in one is refused
` where a `do with` after the cleanup binds the global.
. nothing = make-operand(.operand-void, 0)
. kept = tables.storage[row]
if unit.reading != unit.instance || (scoping.unwinding-from != 0 && binds-after(row, scoping.unwinding-from))
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. position = stack-bindings.length
while position != 0
    position -= 1
    if stack-bindings[position].bind == row
        = Typed(load-local(stack-bindings[position].value, id), kept.type)
if !function.may-panic && !in-landing
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. state = stack-state(row, id)
. flag = tables.layouts.field(kept.layout, 0)
. unbound = ir.reserve-block()
. ready = ir.reserve-block()
. current = load(state, flag.offset, flag.layout, id)
branch(compare(id, .compare-equal, current, integer(.machine-u8, 1)), ready, unbound)
ir.start-block(unbound)
raise-text(id, "Stack-local variable '${tables.global-name(kept)}' is not bound")
ir.start-block(ready)
= Typed(take(state, tables.layouts.field(kept.layout, 1), id), kept.type)

────────────────────
_ do binds-after Bool
    - row U32
    - site SyntaxId

` Whether a `do with` of the function that begins after a node binds a global.
for scope in facts.stack-scopes
    if scope.instance == unit.reading && scope.first > site && same-storage
        = true
    .. same-storage = tables.storage-of(scope.module, scope.decl) == row
= false

────────────────────
_ do stack-state Operand
    - row U32
    - site SyntaxId

` Where the state of a global `do with` binds is read: in a spawned task's body, the capture
` it was given; in a lambda or a comprehension, the place that holds it in the environment it
` was given, as it was where it was made, which the steps of one that yields reach through the
` link of their own; and anywhere else the slot of the task running.
. kept = tables.storage[row]
if is-closure-body()
    . owner = instances.rows[unit.instance].enclosing
    . place = tables.stack-place(owner, instances.rows[unit.instance].decl, row)
    . held = if owner != no-instance then tables.environments[owner] else no-layout
    if place != no-place && held != no-layout && held != unbuilt-environment
        . field = tables.layouts.field(held, place)
        . held-environment = given-environment(site)
        if stepping
            held-environment = load(held-environment, 0, managed-layout, site)
        = address(held-environment, field.offset, field.layout, site)
    refuse(.refused-expression, site)
    = make-operand(.operand-void, 0)
if function.kind != .task-body
    = stack-slot(kept, site)
. layout = tables.captures[unit.instance]
. stacks = tables.stack-holds(unit.instance)
if layout != no-layout && layout != unbuilt-environment && tables.capture-rows[unit.instance] != no-place
    for index in 0 .. < stacks.length
        if stacks[index] == row
            . held = tables.capture-stacks(unit.instance) + index
            . field = tables.layouts.field(layout, held as U32)
            = address(make-operand(.operand-argument, 0), field.offset, field.layout, site)
refuse(.refused-expression, site)
= make-operand(.operand-void, 0)

────────────────────
_ do capture-stack
    - capture Operand
    - field LayoutField
    - row U32
    - site SyntaxId

` Stores in the capture of a spawned task, or in the environment a lambda is made with, the
` state of a global `do with` binds as it is where the task is spawned or the lambda made:
` bound to the value of a binding of it open there, or else as the function reads it.
if row == no-storage
    refuse(.refused-statement, site)
    =
. kept = tables.storage[row]
. target = address(capture, field.offset, field.layout, site)
. position = stack-bindings.length
while position != 0
    position -= 1
    if stack-bindings[position].bind == row
        fill-stack(target, kept, load-local(stack-bindings[position].value, site), site, stack-bindings[position].flag)
        =
copy(target, stack-state(row, site), kept.layout, tables.layouts.rows[kept.layout].is-managed, site)

────────────────────
_ do run-cleanups ?! Refused
    - mark Size
    - open Size
    - unwinding Bool = false

` Runs the cleanups from one of those open down to a mark, newest first, where the function
` is on a way out. Each is emitted again here. A panic raised in one ends that one and the
` rest still run: its checks land on what follows it. With `unwinding` a panic made the way
` out, and one raised here takes its place. On any other way out a panic raised here goes
` on once the cleanups of the block that opened them have run: it leaves through the landing
` pad of the cleanups still open, as a panic raised after the block would.
` A cleanup that may run while a panic is the task's, on a way out a panic made or after one
` of the block raised one, runs with that panic set aside. While one runs, `cleaning-open`
` counts the cleanups open around it, which an error it raises runs on its way out, and
` `cleaning-top` those open where they began to run, above which are those opened in it.
` A panic leaves the zone the collector never sees before it lands, so one that may be raised
` in a cleanup run in the zone has no shape. Each runs kept from what the `do` blocks around it
` were where it was opened, not where it runs.
. saved = landing
. inside = block-effects
. own-scoping = scoping
scoping = scoping.cleaning = true
scoping = scoping.cleaning-top = open-cleanups.length
. position = open
while position > mark
    . base = open-cleanups[position - 1].base
    if base < mark
        base = mark
    . entered = landings
    if !unwinding
        if cleanup-raised == no-local
            cleanup-raised = ir.add-local(u8-layout)
        store-local(cleanup-raised, integer(.machine-u8, 0), 0)
    while position > base
        position -= 1
        . following = ir.reserve-block()
        . raised = if unwinding then following else ir.reserve-block()
        . checks = landings
        landing = raised
        if unwinding
            scoping = scoping.unwinding-from = open-cleanups[position].body
        . aside = if unwinding || landings != entered then set-panic-aside() else no-local
        scoping = scoping.cleaning-open = position
        block-effects = open-cleanups[position].effects
        run-cleanup(open-cleanups[position].body, open-cleanups[position].cell)
        block-effects = inside
        if landings != checks && !unwinding && in-zone
            refuse(.refused-statement, open-cleanups[position].body)
        jump(following)
        if landings != checks && !unwinding
            ir.start-block(raised)
            store-local(cleanup-raised, integer(.machine-u8, 1), 0)
            jump(following)
        ir.start-block(following)
        if aside != no-local
            take-panic-back(aside)
    if landings != entered && !unwinding
        landing = saved
        scoping = scoping.cleaning = own-scoping.cleaning
        resume-panic(base)
        scoping = scoping.cleaning = true
scoping = own-scoping
landing = saved

────────────────────
_ do set-panic-aside LocalId

` Where a cleanup may run while a panic is the task's: the panic, where there is one, is set
` aside while the cleanup runs, so that nothing the cleanup calls sees it, though
` `Task().failure` reads it. The local says whether one was.
. active = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed-layout))
. flag = ir.add-local(u8-layout)
store-local
    - flag
    - compare(0, .compare-not-equal, active, integer(managed-layout as MachineKind, 0))
    - 0
. aside = ir.reserve-block()
. body = ir.reserve-block()
branch(active, aside, body)
ir.start-block(aside)
call-runtime(.runtime-panic-begin-cleanup, 0, pending.length)
jump(body)
ir.start-block(body)
= flag

────────────────────
_ do take-panic-back
    - flag LocalId

` Where a cleanup that set a panic aside ends: the panic is the task's again, unless the
` cleanup raised another, which takes its place.
. back = ir.reserve-block()
. done = ir.reserve-block()
branch(load-local(flag, 0), back, done)
ir.start-block(back)
call-runtime(.runtime-panic-end-cleanup, 0, pending.length)
jump(done)
ir.start-block(done)

────────────────────
_ do resume-panic
    - open Size

` Where the cleanups of a block have run on a way out no panic made: a panic one of them
` raised leaves through the landing pad of the cleanups still `open`.
. flagged = ir.reserve-block()
. resumed = ir.reserve-block()
branch(load-local(cleanup-raised, 0), flagged, resumed)
ir.start-block(flagged)
jump(pad-at(open, unsourced))
ir.start-block(resumed)

────────────────────
_ do pad-at IRBlockId
    - open Size
    - site SyntaxId = 0

` The landing pad of the checks made with a number of cleanups open, which may be fewer
` than are open where the function is, made with `site` as its first check where there is
` none. The pads are in the order of those numbers.
. position = pads.length
while position != 0 && pads[position - 1].cleanups > open
    position -= 1
if position != 0 && pads[position - 1].cleanups == open
    = pads[position - 1].block
. block = ir.reserve-block()
pads += LandingPad(block, open, site, unit.source-module)
. moved = pads.length - 1
while moved > position
    pads[moved] = pads[moved - 1]
    moved -= 1
pads[position] = LandingPad(block, open, site, unit.source-module)
= block

────────────────────
_ do close-cleanups
    - mark Size

` Ends a block that opened cleanups. Where the block ends they run, newest first. Each
` landing pad made while they were open runs the ones open at its checks and goes on to the
` pad of the block around, which runs its own. In a module's main or a spawned task's body a
` pad that knows its first check runs every cleanup open and reports the panic there itself.
` A panic reaches a pad outside the zone the collector never sees, so its cleanups run there.
` They are open no longer.
if open-cleanups.length == mark
    =
. zoned = in-zone
run-cleanups(mark, open-cleanups.length)
. resumed = ir.reserve-block()
jump(resumed)
. first = pads.length
while first != 0 && pads[first - 1].cleanups > mark
    first -= 1
. outer = no-block
. made = false
if first != 0 && pads[first - 1].cleanups == mark
    outer = pads[first - 1].block
for position in first .. < pads.length
    . pad = pads[position]
    ir.start-block(pad.block)
    in-zone = false
    if (function.kind == .module-main || function.kind == .task-body) && pad.site != 0
        run-cleanups(0, pad.cleanups, true)
        leave-pad(pad)
        in-zone = zoned
        continue
    run-cleanups(mark, pad.cleanups, true)
    in-zone = zoned
    if outer == no-block
        outer = ir.reserve-block()
        made = true
    jump(outer)
while pads.length > first
    pads.pop()
while open-cleanups.length > mark
    open-cleanups.pop()
if made
    pads += LandingPad(outer, mark, opening-site(0), unit.source-module)
landing = no-block
if pads.length != 0 && pads[pads.length - 1].cleanups == mark
    landing = pads[pads.length - 1].block
ir.start-block(resumed)

────────────────────
_ do emit-statement ?! Refused
    - id SyntaxId

` One statement. An expression written as a statement is evaluated, and its value dropped: one that
` is no call and whose value is an error has no shape here. A probe is compiled only where probes
` are asked for (`emit-probe-statement`): elsewhere it emits nothing, and nothing of it is
` evaluated. A lazy
` local emits nothing where it is declared: its value is evaluated where it is read. Nor does a
` local of a row of a markup loop region read as a getter. A block written for a feature of the
` compiler the program does not use emits nothing: the type pass typed none of it. Nor does the body
` of a branch written with a pattern, whose statements run in the arm of its condition. A match of a
` subject is run for what its arms do, as the reference compiles one written as a statement. A line
` of a markup element's body that the element takes is given to it. A statement that follows one
` that left a call crossing the zone the collector never sees unsettled has no shape. A line of a
` class's markup that declares a property stores its value there as an assignment does
` (`content-property`).
if zone-answer != 0
    refuse(.refused-statement, id)
    =
if is-probe(id)
    if compiles-probe(id)
        emit-probe-statement(id)
    =
. link = facts.content-link-of(unit.reading, id)
if link != U32.max
    if facts.content-links[link].call != no-fact
        emit-content(id, facts.content-links[link])
    =
. named = facts.named-store-of(unit.reading, id)
if named != U32.max
    . made = emit-expression(id)
    store-named(id, named, made)
    =
do match tree.nodes[id]
    | .node-noop
        =
    | .node-slot-outlet(row)
        do emit-outlet(id, row.name, row.body)
    | .node-print(row)
        emit-print(id, row.body)
    | .node-assertion-syntax(row)
        emit-raise(id, row.exception, row.condition)
    | .node-probe-snapshot
        refuse(.refused-probe, id)
    | .node-probe-preview
        refuse(.refused-probe, id)
    | .node-declare(row)
        if row.rollback && !row.is-lazy
            refuse(.refused-statement, id)
        else if !row.is-lazy && !declares-getter(row.left)
            emit-declare(id, row.left, machine-or-value(row.left, row.right))
    | .node-assign(row)
        . live = tables.live-statement-of(unit.instance, id)
        if live && unit.reading == unit.instance
            emit-live-statement(id, live, row.lhs, row.rhs)
        else
            emit-assign(id, row.op, row.lhs, row.rhs)
    | .node-property-syntax(row)
        . live = tables.live-statement-of(unit.instance, id)
        if live && unit.reading == unit.instance
            emit-live-statement(id, live, tree.content-property-name(id), row.value)
        else
            emit-assign(id, .eq-op, tree.content-property-name(id), row.value)
    | .node-if-block(row)
        if row.is-optional
            refuse(.refused-statement, id)
        else
            emit-if(id, row.condition, row.body, row.next)
    | .node-while-block(row)
        if row.is-optional
            refuse(.refused-statement, id)
        else
            emit-while(id, row.condition, row.body)
    | .node-for-block(row)
        if row.next != 0
            refuse(.refused-statement, id)
        else
            emit-for(id, row.loop, row.body)
    | .node-iterator-expression(row) { facts.plan-of(unit.reading, id) == .plan-content-loop }
        if row.next != 0
            refuse(.refused-statement, id)
        else
            emit-for(id, row.loop, row.body)
    | .node-iterator-expression(row) { subscribing == id }
        do match? tree.nodes[row.loop]
            | .node-loop-syntax(loop)
                emit-subscriber(row.loop, tested(row.loop, loop.clause), row.body, id)
    | .node-do-block(row)
        . is-off = !tables.compiles-features(row.feature-gate-features)
        if row.holds-cancel && !is-off
            emit-cancel-held(id, row.body, row.compilation-effects)
        else if !is-off
            emit-do-body(id, row.body, row.compilation-effects)
    | .node-block
        emit-block(id)
    | .node-do-finally-block(row)
        emit-finally(id, row.body)
    | .node-use-block(row)
        emit-use-block(id, row.subject, row.body)
    | .node-stack-local-binding-block(row)
        emit-stack-binding(id, row.value, row.body)
    | .node-do-task-block(row)
        . worker = if row.is-parallel then 0 else row.worker
        do emit-spawn(id, worker, row.is-parallel, row.scheduling == .task-scheduling-priority, row.large-stack)
    | .node-break
        if breaks-subscription()
            unsubscribe(id)
            emit-leave(id, false)
        else
            emit-leave(id, true)
    | .node-continue
        emit-leave(id, false)
    | .node-yield(row)
        emit-yield(id, row.expr, row.does-yield-all)
    | .node-return(row)
        emit-return(id, row.expr)
    | .node-return-if-true(row)
        emit-return-if(id, row.condition, row.expr)
    | .node-match-expression(row)
        if row.subject != 0 && helper-runs(row.helper)
            emit-subject-match(id, row.subject, row.body, row.is-optional, row.helper, true)
        else
            emit-expression(id)
    | .node-structure-match(row)
        . type = facts.node-type(unit.reading, id)
        if type == no-type || type == invalid-type || type == types.void-type
            run-arms(id, row.pattern)
        else
            emit-expression(id)
    | .node-catch-expression(row)
        . handled = row.catchers.count != 0 && is-caught(row.body)
        if tree.transformer-exception(row.body, row.catchers) != 0
            if row.catchers.count > 1 && catchers-bind(row.catchers)
                refuse(.refused-statement, id)
        else if handled && !carries-error(facts.node-type(unit.reading, id))
            emit-handled(id, row.body, row.catchers, true)
        else
            . emitted = emit-expression(id)
            if emitted.type != no-type && extends(emitted.type, types.error-type)
                refuse(.refused-statement, id)
    ??
        . emitted = emit-expression(id)
        if emitted.type != no-type && uncaught-error
            refuse(.refused-statement, id)
        .. uncaught-error = extends(emitted.type, types.error-type) && !is-caught(id)

────────────────────
_ do emit-content
    - id SyntaxId
    - link ContentLink

` A line of a markup element's body that the element takes: its value is evaluated, takes
` the conversion recorded for it as an argument, and is given to the method the type pass
` found for it, called on the element whose body is being run. What the method answers is
` dropped, but where the line is an element a name is declared for: the name then holds the
` answer, converted as a value assigned to it. A line that is a markup branch region or a
` markup loop region is the region, whose action is made once the element has taken it. A line
` whose value read something tracked is evaluated while a live action of its own is open, whose
` trackers note what it reads, and the action is made once the element has taken the value, as
` that of an attribute is (`give-again`), and what the element took of it is kept for the action
` to replace (`keep-taken`). An element named for the property its class's markup declares for
` it, which no local is declared for, gives the property what the element took it as, or the
` object where that is nothing; one a local is declared for gives it what the local holds, which
` the environment of a function the element is written in may keep. A slot outlet that is a
` branch region is written at its parameter (`region-site`).
. site = region-site(id)
. region = facts.branch-region-of(unit.reading, site)
. looped = facts.loop-region-of(unit.reading, id)
. live = tables.live-statement-of(unit.reading, id) if !region && !looped && !rerunning && unit.reading == unit.instance
. trackers = no-local
. made = Typed(make-operand(.operand-void, 0), no-type)
if region
    made = emit-branch(site, region)
else if looped
    made = emit-loop(id, looped)
else if live
    trackers = open-trackers(id)
    live-actions += LiveTrackers(trackers, trackers)
    made = emit-expression(id)
    live-actions.pop()
else
    made = emit-expression(id)
. converted = convert(id, .reason-argument, made)
. top = content-hosts.length
if top == 0 || content-hosts[top - 1].type != link.parent
    refuse(.refused-statement, id)
    =
if converted.type != link.taken
    refuse(.refused-conversion, id)
    =
. answer = call-protocol
    - id
    - link.call
    - content-hosts[top - 1].operand
    - link.parent
    - converted.operand
    - link.taken
    - false
if link.append != no-instance
    . mark = pending.length
    pending += content-hosts[top - 1].operand
    pending += answer.operand
    call-instance(link.append, id, mark)
. answered = answer.type
if live
    . whole = link.append != no-instance || answered != types.void-type
    keep-taken(id, (if whole then answer else made).operand, if whole then answered else made.type)
if live
    give-again(id, trackers, content-hosts[top - 1].operand, link.parent)
    =
if region
    own-branch(site, region, made.operand)
    =
if looped
    own-loop(id, looped, made.operand)
    =
if link.answers == no-type
    . named = facts.named-store-of(unit.reading, id)
    if named != U32.max
        do match? tree.nodes[id]
            | .node-markup(row)
                if !declares-element(id, row.id)
                    . gives = answered != no-type && answered != types.void-type
                    store-named(id, named, if gives then answer else made)
                    =
                . slot = local-slot(row.id, id, true, false, true)
                . outer = is-captured(slot) && tables.slot-functions[slot] != unit.own-scope
                . held = if outer then find-captured(slot, id).type else facts.slot-type(unit.instance, slot-offset(slot, id))
                . kept = if outer then read-captured(slot, id, held) else slot-value(slot, id, held)
                store-named(id, named, Typed(kept.operand, held))
if link.answers == no-type
    =
if answered != link.answers
    refuse(.refused-conversion, id)
    =
. raw = answer
answer = convert(id, .reason-assignment, answer)
do match? tree.nodes[id]
    | .node-markup(row)
        . slot = local-slot(row.id, id, true, false, true)
        if is-captured(slot) && tables.slot-functions[slot] != unit.own-scope
            keep-captured(slot, answer.operand, answer.type, id)
        else
            keep-state(slot, answer.operand, answer.type, id)
. named = facts.named-store-of(unit.reading, id)
if named != U32.max
    store-named(id, named, raw)

────────────────────
_ region-site SyntaxId
    - id SyntaxId

` Where the markup branch region a line may be is written: a slot outlet's parameter, or the line.
match tree.nodes[id]
    | .node-slot-outlet(row)
        if row.slot-parameter != 0 then row.slot-parameter else id
    ??
        id

────────────────────
_ do emit-branch Typed
    - id SyntaxId
    - region BranchRegion

` A markup branch region, as the reference makes one:
` the function of each arm, made the `MarkupBranchBuilder` recorded at the arm, in a
` list made at the `if`; the index of the arm whose condition holds, read while a live action
` of the region's own is open, whose trackers are kept to make the action with once the
` element has taken the region; and the region the markup runtime makes of them for the
` element being built. The batch in force is kept first for the arms, which the region builds
` as it is made, and the region is put under the batch found for the host. The arms of a match
` region read its subject again where the host is kept, which is first done here.
. nothing = make-operand(.operand-void, 0)
. top = content-hosts.length
if top == 0 || content-hosts[top - 1].type != region.host
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
if region.rooted
    keep-batch(id)
if tree.nodes[id] is .node-match-expression
    keep-captured(channel-slot(id), content-hosts[top - 1].operand, region.host, id)
. start = given.length
. count U32
for arm in tree.region-arms(id)
    . built = convert(arm, .reason-markup-arm, emit-closure(tree.region-arm-body(arm)))
    given += Typed(apart(built, arm, true), built.type)
    count += 1
. list = nothing
list = build-list(id, RowRange'SyntaxId(0, count), region.list, start, false).operand
drop-given(start)
. trackers = open-trackers(id)
live-actions += LiveTrackers(trackers, trackers)
. selected = emit-arm-index(id, region.selected)
live-actions.pop()
. mark = pending.length
pending += content-hosts[top - 1].operand
pending += list
pending += selected.operand
. made = raising-call(id, region.create, mark)
put-under-batch
    - id
    - region.ensure
    - region.hosted
    - made.operand
    - instances.signatures[region.create].returns
branch-trackers += trackers
= Typed(made.operand, instances.signatures[region.create].returns)

────────────────────
_ do emit-arm-index Typed
    - id SyntaxId
    - selected TypeId
    - keeps LocalId = no-local

` The index of the arm of a markup branch region to select, as the reference's
` `markupIfConditionArm` chooses it: that of the first arm whose condition holds, the
` conditions tested in turn, or else that of the first arm with no condition, or none. An arm
` written with a pattern holds where its subject matches it, tested binding nothing, as the
` reference's `markupIfActiveArm` tests it; an arm so chosen is selected again whatever arm the
` region holds, which `keeps` says where it is given: false for such an arm, else true. That of
` a match region is `emit-pattern-index`'s. That of a slot outlet that is a region is its one
` arm's, once the name its parameter gives is read, as the reference's `selectArm` reads it.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(selected, id)
if is-null-form(selected) || !tables.layouts.is-struct(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. inner = tables.layouts.field(layout, 0)
. flag = tables.layouts.field(layout, 1)
if !is-integer(inner.layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. held = frame(layout)
zero(held, layout)
if tree.nodes[id] is .node-match-expression
    emit-pattern-index(id, held, inner, flag)
    = Typed(held, selected)
do match? tree.nodes[id]
    | .node-markup-slot-parameter(row)
        do emit-expression(row.name)
        store(held, inner.offset, integer(inner.layout as MachineKind, 0), false, id)
        store(held, flag.offset, integer(.machine-i8, 1), false, id)
        = Typed(held, selected)
. done = ir.reserve-block()
if keeps != no-local
    store-local(keeps, integer(.machine-u8, 1), id)
. fallback U32 = U32.max
. index U32
. arm = id
while arm != 0
    . next SyntaxId = 0
    do match? tree.nodes[arm]
        | .node-if-block(row)
            . pattern = tree.pattern-arm(arm)
            if pattern != 0
                if !test-arm(pattern, matched-subject(row.condition), held, inner, flag, index, done, keeps)
                    ir.start-block(done)
                    = Typed(held, selected)
            else if row.condition == 0
                if fallback == U32.max
                    fallback = index
            else
                . tested = test(row.condition, emit-expression(row.condition))
                . chosen = ir.reserve-block()
                . later = ir.reserve-block()
                branch(tested.operand, chosen, later)
                ir.start-block(chosen)
                store
                    - held
                    - inner.offset
                    - integer(inner.layout as MachineKind, index)
                    - false
                    - arm
                store(held, flag.offset, integer(.machine-i8, 1), false, arm)
                jump(done)
                ir.start-block(later)
            next = row.next
    index += 1
    arm = next
if fallback != U32.max
    store(held, inner.offset, integer(inner.layout as MachineKind, fallback), false, id)
    store(held, flag.offset, integer(.machine-i8, 1), false, id)
jump(done)
ir.start-block(done)
= Typed(held, selected)

────────────────────
_ do test-arm Bool
    - arm SyntaxId
    - subject SyntaxId
    - held Operand
    - inner LayoutField
    - flag LayoutField
    - index U32
    - done IRBlockId
    - keeps LocalId

` Tests an arm of a markup branch region written with a pattern: its subject read, a struct
` copied, and matched against the pattern binding nothing; where it matches, `held` gets the
` arm's index, `keeps` false, and the test goes to `done`, and else on. False where the pattern
` always matches, so no arm after it is tested, or once refused.
if facts.plan-of(unit.reading, arm) == .plan-never
    = true
. value = emit-expression(subject)
. type = value.type
value = Typed(apart(value, subject, true), value.type)
. later = ir.reserve-block()
. jumps = fail-jumps
. own-matching = matching
matching = matching.testing = true
matching = matching.tested = subject
do match? tree.nodes[arm]
    | .node-type-transform(row)
        if row.pattern != 0
            emit-pattern(row.pattern, Typed(value.operand, type), later)
matching = own-matching
store(held, inner.offset, integer(inner.layout as MachineKind, index), false, arm)
store(held, flag.offset, integer(.machine-i8, 1), false, arm)
if keeps != no-local
    store-local(keeps, integer(.machine-u8, 0), arm)
jump(done)
if fail-jumps == jumps
    = false
ir.start-block(later)
= true

────────────────────
_ do has-pattern-arm Bool
    - id SyntaxId

` Whether a markup branch region has an arm written with a pattern, `if | x = v`.
. arm = id
while arm != 0
    if tree.pattern-arm(arm) != 0
        = true
    . next SyntaxId = 0
    do match? tree.nodes[arm]
        | .node-if-block(row)
            next = row.next
    arm = next
= false

────────────────────
_ matched-subject SyntaxId
    - matching SyntaxId

` The subject of a match, or none.
match tree.nodes[matching]
    | .node-match-expression(row)
        row.subject
    ??
        0

────────────────────
_ do emit-pattern-index
    - id SyntaxId
    - held Operand
    - inner LayoutField
    - flag LayoutField

` Stores in `held` the index of the arm of a markup match region to select, as the reference's
` `markupMatchActiveArm` chooses it: the subject is read once, a struct copied, and each arm's
` pattern tested against it in turn, binding nothing; that of the first that matches, or none.
` The arms after one that always matches are not tested.
. subject SyntaxId = 0
do match? tree.nodes[id]
    | .node-match-expression(row)
        subject = row.subject
. value = emit-expression(subject)
. type = value.type
value = Typed(apart(value, subject, true), value.type)
. done = ir.reserve-block()
. index U32
for arm in tree.region-arms(id)
    if facts.plan-of(unit.reading, arm) != .plan-never
        . later = ir.reserve-block()
        . jumps = fail-jumps
        . own-matching = matching
        matching = matching.testing = true
        matching = matching.tested = subject
        do match? tree.nodes[arm]
            | .node-type-transform(row)
                if row.pattern != 0
                    emit-pattern(row.pattern, Typed(value.operand, type), later)
        matching = own-matching
        store(held, inner.offset, integer(inner.layout as MachineKind, index), false, arm)
        store(held, flag.offset, integer(.machine-i8, 1), false, arm)
        jump(done)
        if fail-jumps == jumps
            ir.start-block(done)
            =
        ir.start-block(later)
    index += 1
jump(done)
ir.start-block(done)

────────────────────
_ do own-branch
    - id SyntaxId
    - region BranchRegion
    - made Operand

` The action of a markup branch region, once the element has taken the region: the element and
` the region are kept in the locals no name reaches declared at the `if`, for the function that
` selects the arm again, and the action, made by the markup runtime with the trackers the
` conditions noted and a callback that runs that function with the environment in force here,
` given the element as the host, or the batch found for it where the type pass found one, is
` owned by the element and marked structural.
. trackers = branch-trackers[branch-trackers.length - 1]
branch-trackers.pop()
. slot = channel-slot(id)
. code = tables.instance-functions[region.updater]
. top = content-hosts.length
if slot == no-slot || code == no-function || top == 0
    refuse(.refused-statement, id)
    =
. host = content-hosts[top - 1].operand
keep-captured(slot, host, region.host, id)
keep-captured(slot + 1, made, instances.signatures[region.create].returns, id)
. callback = make-callback(tables.live-adapter-of(code), written-environment(id), id)
. owner = if region.rooted || region.hosted then region-batch(id, region.hosted) else convert(id, .reason-markup-host, Typed(host, region.host)).operand
. mark = pending.length
pending += load-local(trackers, id)
pending += callback
pending += owner
. action = raising-call(id, region.action, mark)
attach-action(host, action.operand, id)
. marking = pending.length
pending += action.operand
pending += structural-owner(id, host, region.host, region.structural).operand
do raising-call(id, region.structural, marking)

────────────────────
_ do emit-loop Typed
    - id SyntaxId
    - region LoopRegion

` A markup loop region, as the reference makes one:
` the container, read while a live action of the region's own is open, whose trackers are kept
` to make the action with once the element has taken the region, and converted to the source the
` type pass recorded at the container where it is no collection; the function that builds each
` row, made the builder recorded at the `for`, and that keys it, where the loop is keyed, made
` the `MarkupKeyBuilder` recorded at its clause; and the region the markup runtime makes of
` them for the element being built. The batch in force is kept first for the rows, which the
` region builds as it is made, and the region is put under the batch found for the host.
. nothing = make-operand(.operand-void, 0)
. top = content-hosts.length
. container = region-container(id)
if top == 0 || content-hosts[top - 1].type != region.host || container == 0
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
if region.rooted
    keep-batch(id)
. trackers = open-trackers(id)
live-actions += LiveTrackers(trackers, trackers)
. source = emit-expression(container)
live-actions.pop()
if source.type != region.source
    source = convert(container, .reason-argument, source)
if source.type != region.source
    refuse(.refused-conversion, container)
    = Typed(nothing, no-type)
do match? tree.nodes[id]
    | .node-for-block(row)
        . built = convert(id, .reason-markup-row, emit-closure(row.body))
        if region.adapts != no-instance
            . filter = tree.when-clause(row.loop)
            . tester = if filter != 0 then convert(filter, .reason-markup-key, emit-closure(filter)).operand else nothing
            . adapting = pending.length
            pending += content-hosts[top - 1].operand
            pending += built.operand
            if filter != 0
                pending += tester
            built = raising-call(id, region.adapts, adapting)
        . keyed = tree.keyed-clause(row.loop)
        . keyer = if keyed != 0 then convert(keyed, .reason-markup-key, emit-closure(keyed)).operand else nothing
        . mark = pending.length
        pending += content-hosts[top - 1].operand
        pending += built.operand
        if keyed != 0
            pending += keyer
        pending += source.operand
        . made = raising-call(id, region.create, mark)
        put-under-batch
            - id
            - region.ensure
            - region.hosted
            - made.operand
            - instances.signatures[region.create].returns
        branch-trackers += trackers
        = Typed(made.operand, instances.signatures[region.create].returns)
refuse(.refused-statement, id)
= Typed(nothing, no-type)

────────────────────
_ region-container SyntaxId
    - id SyntaxId

` The container of the one header of a markup loop region's `for`.
match tree.nodes[id]
    | .node-for-block(row)
        match tree.nodes[row.loop]
            | .node-loop-syntax(loop)
                loop.container
            ??
                0
    ??
        0

────────────────────
_ do own-loop
    - id SyntaxId
    - region LoopRegion
    - made Operand

` The action of a markup loop region, once the element has taken the region: the element and the
` region are kept in the locals no name reaches declared at the `for`, for the function that reads
` the container again, and the action, made by the markup runtime with the trackers the container
` noted and a callback that runs that function with the environment in force here, given the region
` as the host, or the batch in force where there is one, is owned by the region and marked
` structural.
. trackers = branch-trackers[branch-trackers.length - 1]
branch-trackers.pop()
. slot = channel-slot(id)
. code = tables.instance-functions[region.updater]
. top = content-hosts.length
if slot == no-slot || code == no-function || top == 0
    refuse(.refused-statement, id)
    =
. made-type = instances.signatures[region.create].returns
keep-captured(slot, content-hosts[top - 1].operand, region.host, id)
keep-captured(slot + 1, made, made-type, id)
. callback = make-callback(tables.live-adapter-of(code), written-environment(id), id)
. owner = if region.rooted then region-batch(id, false) else convert(id, .reason-markup-host, Typed(made, made-type)).operand
. mark = pending.length
pending += load-local(trackers, id)
pending += callback
pending += owner
. action = raising-call(id, region.action, mark)
attach-action(made, action.operand, id)
. marking = pending.length
pending += action.operand
pending += structural-owner(id, made, made-type, region.structural).operand
do raising-call(id, region.structural, marking)

────────────────────
_ do structural-owner Typed
    - id SyntaxId
    - owner Operand
    - type TypeId
    - call InstanceId

` The host that owns the action of a markup region, as the optional the call that marks the
` action structural takes: the parent of a branch or the region of a loop, converted where the
` type pass recorded it as a markup host, and nothing where it is none.
. fact = facts.first-conversion(unit.reading, id)
while fact != no-fact
    if facts.conversions[fact].reason == .reason-markup-structural
        . host = convert(id, .reason-markup-host, Typed(owner, type))
        = convert(id, .reason-markup-structural, host)
    fact = facts.conversions[fact].next
. optional = types.child-type(instances.signatures[call].args, 1)
= empty-optional(optional, layout-of(optional, id))

────────────────────
_ do keep-batch
    - id SyntaxId

` Keeps the batch in force where a markup region is written in the third local no name
` reaches declared at the `if` or `for`, which the functions that build its arms or rows read.
. slot = channel-slot(id)
. batch = if content-roots.length != 0 then outer-root else make-operand(.operand-void, 0)
    .. outer-root = content-roots[content-roots.length - 1]
if slot == no-slot || operand-kind(batch) == .operand-void
    refuse(.refused-statement, id)
    =
. field = find-captured(slot + 2, id)
keep-captured(slot + 2, batch, field.type, id)

────────────────────
_ do region-batch Operand
    - id SyntaxId
    - hosted Bool

` The batch the reference finds for the host of a markup region: the host itself where it is
` one, converted at the `if` or `for`, else the one in force.
. nothing = make-operand(.operand-void, 0)
. top = content-hosts.length
if hosted && top != 0
    = convert(id, .reason-markup-batch, content-hosts[top - 1]).operand
if hosted || content-roots.length == 0 || void-root
    refuse(.refused-statement, id)
    = nothing
.. void-root = operand-kind(content-roots[content-roots.length - 1]) == .operand-void
= content-roots[content-roots.length - 1]

────────────────────
_ do put-under-batch
    - id SyntaxId
    - ensure InstanceId
    - hosted Bool
    - made Operand
    - type TypeId

` Puts the region a markup region made under the batch found for its host, where the type pass
` found one, as the markup runtime's `ensure-markup-root` does, given the region as a host and
` the batch as the optional it takes.
if ensure == no-instance
    =
. batch = region-batch(id, hosted)
. region = convert(id, .reason-markup-region, Typed(made, type))
. given = convert-from(id, .reason-markup-root, batch)
. mark = pending.length
pending += region.operand
pending += given.operand
call-instance(ensure, id, mark)

────────────────────
_ do emit-resource
    - declared SyntaxId
    - id SyntaxId

` The function the action of a markup loop region runs, given the environment the region was
` made in: the container is read again with the trackers of the action noting what it reads,
` the members of the region's host read by their names alone, and given to the region, read
` from where it was kept, by the markup runtime's replacer the type pass recorded at the `for`,
` as the reference's `collection-source` function does.
. live = instances.live
. region = facts.loop-region-of(instances.rows[unit.instance].enclosing, id)
. slot = channel-slot(id)
. container = region-container(id)
if !region || slot == no-slot || region.replace == no-instance || unanchored
    refuse(.refused-function, declared)
    =
.. unanchored = container == 0 || live.previous == no-instance || live.next == no-instance
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, id, pending.length).operand, id)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, id, pending.length).operand, id)
. made-type = instances.signatures[region.create].returns
. host = read-captured(slot, id, region.host)
. made = read-captured(slot + 1, id, made-type)
live-actions += LiveTrackers(previous, next)
content-hosts += Typed(host.operand, region.host)
content-roots += make-operand(.operand-void, 0)
. source = emit-expression(container)
content-hosts.pop()
content-roots.pop()
live-actions.pop()
if source.type != region.source
    source = convert(container, .reason-argument, source)
if source.type != region.source
    refuse(.refused-conversion, container)
    =
. mark = pending.length
pending += made.operand
pending += source.operand
do raising-call(id, region.replace, mark)
emit-end(declared)

────────────────────
_ do emit-row-item Typed
    - id SyntaxId
    - name Atom

` A name the row of a keyed markup loop region gives its item by: the row's argument, the
` `MarkupRowItem` that holds the item, is read, the read of its `item` noted in the trackers of
` the live action open where one is, and its `item` read, as the reference's
` `readMarkupRowItem` does.
. held = facts.row-item-of(unit.reading, id)
if !tables.is-class(held)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. base = emit-identifier(id, name, held)
. item = program.store-atom("item")
if live-actions.length != 0 || facts.pulls(unit.reading, id)
    track(id, base.operand, item)
= load-property(id, base.operand, held, item)

────────────────────
_ do emit-selector
    - declared SyntaxId
    - id SyntaxId

. live = instances.live
if live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, declared)
    =
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, id, pending.length).operand, id)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, id, pending.length).operand, id)
live-actions += LiveTrackers(previous, next)
. selected = emit-arm-index(id, returns-type)
live-actions.pop()
return-value(selected.operand, declared)

────────────────────
_ do emit-reselect
    - declared SyntaxId
    - id SyntaxId

` The function the action of a markup branch region runs, given the environment the region was
` made in: the index of the arm to select is read again with the trackers of the action noting
` what the conditions read, the members of the region's host read by their names alone, and
` where the region does not keep that arm, the actions the region owns are closed and the
` markup runtime selects it, as the reference's `markup-branch` function does. That of a match
` region selects the arm whatever arm the region holds, as does that of a branch region for an
` arm written with a pattern (`emit-arm-index`).
. live = instances.live
. region = facts.branch-region-of(instances.rows[unit.instance].enclosing, id)
. slot = channel-slot(id)
if !region || slot == no-slot || live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, declared)
    =
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, id, pending.length).operand, id)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, id, pending.length).operand, id)
live-actions += LiveTrackers(previous, next)
. host = read-captured(slot, id, region.host)
content-hosts += Typed(host.operand, region.host)
content-roots += make-operand(.operand-void, 0)
. patterned = has-pattern-arm(id)
. kept = if patterned then ir.add-local(u8-layout) else no-local
. selected = emit-arm-index(id, region.selected, kept)
content-hosts.pop()
content-roots.pop()
live-actions.pop()
. made-type = instances.signatures[region.create].returns
. made = read-captured(slot + 1, id, made-type)
. given = convert(id, .reason-argument, Typed(made.operand, made-type))
. selecting = ir.reserve-block()
. done = ir.reserve-block()
if region.keeps == no-instance
    jump(selecting)
else
    if patterned
        . asking-block = ir.reserve-block()
        branch(load-local(kept, id), asking-block, selecting)
        ir.start-block(asking-block)
    . asking = pending.length
    pending += given.operand
    pending += selected.operand
    . keeps = raising-call(id, region.keeps, asking)
    branch(keeps.operand, done, selecting)
ir.start-block(selecting)
close-actions(id, made.operand)
. choosing = pending.length
pending += given.operand
pending += selected.operand
do raising-call(id, region.select, choosing)
jump(done)
ir.start-block(done)
emit-end(declared)

────────────────────
_ do emit-arm ?! Refused
    - declared SyntaxId
    - body SyntaxId

` The function that builds an arm of a markup branch region: the arm's body runs as content of
` the region it is given, under the batch in force where the region is written, where the type
` pass found one, read from where it was kept; the region is put under it first, twice, as the
` reference's builder and then its `compileContents` each do. That of an arm of a match region
` runs its body only where its pattern matches the subject (`match-subject`).
. parent = make-operand(.operand-argument, 1)
. type = instances.argument-type(unit.instance, 0)
. batch = make-operand(.operand-void, 0)
. root = facts.region-root-of(unit.reading, body)
if root
    batch = read-captured(root.slot, body, root.batch).operand
    if root.ensure != no-instance
        for pass in 0 .. < 2
            . host = convert(body, .reason-markup-host, Typed(parent, type))
            . given = convert-from(body, .reason-markup-root, batch)
            . mark = pending.length
            pending += host.operand
            pending += given.operand
            call-instance(root.ensure, body, mark)
. matched = tree.body-arm(body)
. failed = ir.reserve-block()
. jumps = fail-jumps
. named = bound.length
if matched != 0 && !match-subject(matched, failed)
    drop-bound(named)
    emit-end(declared)
    =
content-hosts += Typed(parent, type)
content-roots += batch
emit-block(body)
content-hosts.pop()
content-roots.pop()
drop-bound(named)
if fail-jumps != jumps
    . finished = ir.reserve-block()
    jump(finished)
    ir.start-block(failed)
    jump(finished)
    ir.start-block(finished)
emit-end(declared)

────────────────────
_ do emit-row-region ?! Refused
    - declared SyntaxId
    - body SyntaxId

. parent = make-operand(.operand-argument, 2)
. type = instances.argument-type(unit.instance, 1)
. batch = make-operand(.operand-void, 0)
. root = facts.region-root-of(unit.reading, body)
if root
    batch = read-captured(root.slot, body, root.batch).operand
    if root.ensure != no-instance
        . host = convert(body, .reason-markup-host, Typed(parent, type))
        . given = convert-from(body, .reason-markup-root, batch)
        . mark = pending.length
        pending += host.operand
        pending += given.operand
        call-instance(root.ensure, body, mark)
content-hosts += Typed(parent, type)
content-roots += batch
emit-block(body)
content-hosts.pop()
content-roots.pop()
emit-end(declared)

────────────────────
_ do match-subject Bool
    - arm SyntaxId
    - failed IRBlockId

` Reads the subject of the match an arm of a markup match region, or of a branch region written
` with a pattern, is one of again, where a member of the region's host read by its name alone is
` read from the host kept where the region was made, copies a struct, and matches the arm's
` pattern against it, going to `failed` where it does not match, binding `it` and the names the
` pattern declares, as the reference's `markupCompileMatchedArm` does. False where the arm can
` never match, or once refused.
if facts.plan-of(unit.reading, arm) == .plan-never
    = false
. subject = matched-subject(tree.arm-match(arm))
. slot = channel-slot(tree.arm-site(arm))
. binding = instances.rows[unit.reading].binding
. site = if slot != no-slot && binding != no-binding then bindings.slots[slot].syntax else 0
. region = facts.branch-region-of(instances.rows[unit.instance].enclosing, site)
if !region || slot == no-slot || subject == 0
    refuse(.refused-function, arm)
    = false
. host = read-captured(slot, arm, region.host)
content-hosts += Typed(host.operand, region.host)
content-roots += make-operand(.operand-void, 0)
. value = emit-expression(subject)
. type = value.type
content-hosts.pop()
content-roots.pop()
value = Typed(apart(value, subject, true), value.type)
. passed = value
do match? tree.nodes[arm]
    | .node-type-transform(row)
        if row.pattern != 0
            passed = emit-pattern(row.pattern, Typed(value.operand, type), failed)
. it = arm-slot-of(arm, .slot-it)
if it != no-slot
    bound += BoundValue(it, passed.type, passed.operand)
= true

────────────────────
_ do store-named
    - id SyntaxId
    - place U32
    - value Typed

` Stores what the name of a markup element holds in the property of that name of the
` object the function runs on, converted as the type pass recorded at the element for a
` value the property is given.
. stored = convert(id, .reason-declaration, value)
if !unit.has-self
    refuse(.refused-statement, id)
    =
store-argument(unit.self, unit.owner-type, place, stored.operand, stored.type, id)

────────────────────
_ do emit-markup Typed
    - id SyntaxId
    - name SyntaxId
    - type-id SyntaxId
    - args RowRange'SyntaxId
    - body SyntaxId

` A markup element: its object, with the lines of its body run as its content, the object being the
` element they are given to. Where it is a statement, the objects of the elements it declares names
` for are made first (`raise-elements`). The object of an element a block declares a name for is read
` from the name: one this function has not made has no shape. One whose name is placed is made here
` and given to the name. A body a function of its own builds into the default slot's node is no
` content here.
. nothing = make-operand(.operand-void, 0)
. made = nothing
. type = no-type
raise-elements(id)
if facts.is-raised(unit.reading, id)
    . slot = local-slot(name, id, true, false, true)
    if built.find(id) == null
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    type = facts.slot-type(unit.instance, slot-offset(slot, id))
    made = slot-value(slot, id, type).operand
else
    . element = make-element(id, type-id, args)
    made = element.operand
    type = element.type
    if names-placed(name)
        name-element(id, name, element)
. root = batch-root(id, type-id, Typed(made, type))
if body != 0 && !is-closure(facts.node-type(unit.reading, body))
    content-hosts += Typed(made, type)
    content-roots += root
    emit-block(body)
    content-hosts.pop()
    content-roots.pop()
mount-root(id, type-id, made, type, root)
= Typed(made, type)

────────────────────
_ declares-element Bool
    - element SyntaxId
    - name SyntaxId

` Whether a block declares a local for a markup element's name, in the function whose facts
` are being read.
|? binding == no-binding
    false
??
    resolution.kind == .resolve-slot && bindings.slots[resolution.slot].group == element

.. binding = instances.rows[unit.reading].binding
.. resolution = bindings.resolution-of(binding, name)

────────────────────
_ names-placed Bool
    - name SyntaxId

` Whether a markup element's name is placed: given the element's object where the element is
` written, as no block made it where it starts.
|? name == 0 || binding == no-binding
    false
??
    resolution.kind == .resolve-slot && (bindings.slots[resolution.slot].flags /and/ SlotFlag.slot-placed) != 0

.. binding = instances.rows[unit.reading].binding
.. resolution = bindings.resolution-of(binding, name)

────────────────────
_ do batch-root Operand
    - id SyntaxId
    - type-id SyntaxId
    - made Typed

` The batch of markup in force in the body of a markup element, a `MarkupRootElement`: the element
` itself where its class is a batch, else the one in force where the element is written, if
` any. An element of a markup host is put under it first, given as the `MarkupRootElement?` the
` markup runtime takes.
. nothing = make-operand(.operand-void, 0)
. inherited = if content-roots.length != 0 then content-roots[content-roots.length - 1] else nothing
. root = facts.element-root-of(unit.reading, id)
if !root
    = inherited
. batch = inherited
if root.owns
    batch = convert(type-id, .reason-markup-batch, made).operand
if root.ensure != no-instance
    if operand-kind(batch) == .operand-void
        refuse(.refused-expression, id)
        = nothing
    . host = convert(type-id, .reason-markup-host, made)
    . given = convert-from(type-id, .reason-markup-root, batch)
    . mark = pending.length
    pending += host.operand
    pending += given.operand
    call-instance(root.ensure, id, mark)
= batch

────────────────────
_ do mount-root
    - id SyntaxId
    - type-id SyntaxId
    - made Operand
    - type TypeId
    - batch Operand

` Mounts a markup element that is no line of another as a root of the batch in force, once
` its body has run.
. root = facts.element-root-of(unit.reading, id)
if !root || root.mount == no-instance
    =
if operand-kind(batch) == .operand-void
    refuse(.refused-expression, id)
    =
. host = convert(type-id, .reason-markup-host, Typed(made, type))
. given = convert-from(type-id, .reason-markup-root, batch)
. mark = pending.length
pending += host.operand
pending += given.operand
call-instance(root.mount, id, mark)

────────────────────
_ do raise-elements
    - block SyntaxId

` Makes the object of each named markup element the type pass kept for a block of markup content,
` where it starts, or for a statement, where it runs, in order, and declares the element's name as
` a local that holds it.
. raised = facts.first-raised(unit.reading, block)
while raised != U32.max
    . fact = facts.raised-elements[raised]
    raise-element(fact.element)
    raised = fact.next

────────────────────
_ do raise-element
    - element SyntaxId

` Makes the object of a named markup element and declares its name as a local that holds it.
do match? tree.nodes[element]
    | .node-markup(row)
        . made = make-element(element, row.type-id, row.args)
        name-element(element, row.id, made)

────────────────────
_ do name-element
    - element SyntaxId
    - name SyntaxId
    - made Typed

` Gives the name of a markup element its cell and stores the element's object there, as a
` declaration of a local with that value does: one some read tracks tells no read of it. A
` name a function this one is written in declares is kept in its environment.
. slot = local-slot(name, element, true, false, true)
. offset = slot-offset(slot, element)
. type = if is-captured(slot) && tables.slot-functions[slot] != unit.own-scope then find-captured(slot, element).type else facts.slot-type(unit.instance, offset)
if type == no-type || type == invalid-type || type != made.type
    refuse(.refused-statement, element)
    =
. layout = layout-of(type, element)
built += element
if is-captured(slot)
    keep-captured(slot, made.operand, type, element)
    =
. local = ir.add-local(layout, (bindings.slots[slot].flags /and/ SlotFlag.slot-address-taken) != 0)
unit.cells[offset] = local
store-local(local, made.operand, element)

────────────────────
_ do make-element Typed
    - id SyntaxId
    - type-id SyntaxId
    - args RowRange'SyntaxId

` The object of a markup element, as its constructor makes it for its arguments and its
` attributes.
` 1. The constructor is called as a call written with the arguments is: an attribute that
`    names a parameter fills it, and the value of each other attribute is given after the
`    arguments. Each argument is kept as it was evaluated, before the call converted it, and
`    each attribute as given: converted to the property's type, and then, where it fills a
`    parameter, to the parameter's, as the call converted it.
`    The values given to the style rules written on the element are evaluated after the
`    attributes, before the call (`emit-rule-values`).
` 2. The object is kept for the functions that read its members by name alone, the gates of
`    the style rules written on it among them (`keep-element`). The state cells of the `when`s
`    around the rules written in rules the element sees, made before the call (`make-cells`),
`    are bound (`bind-cells`). The style rules the element applies run, then each attribute
`    that declares a style property declares it, in the order written.
` 3. Each value the type pass bound to a property is stored in the property: the
`    attributes, then the arguments, each in the order written. An argument takes the
`    conversion recorded for it as a value assigned. An attribute a setter answers is given
`    to the setter instead, in its place among them. Then the element's style site, if it has
`    one, is made ready.
` 4. Each attribute whose value read something tracked is given a live action, in the order
`    written, owned by the object, which gives it again: the object is kept where that
`    function reaches it. Then each argument given by position whose value did, so.
. nothing = make-operand(.operand-void, 0)
. own-styling = styling
. start = element-given.length
. filling = element-filled.length
. setting = setter-given.length
. valued = rule-givens.length
. lively = attribute-trackers.length
. arguing = argument-trackers.length
styling = styling.element = if facts.first-element-store(unit.reading, id) != U32.max || writes-attributes(id) then id else 0
styling = styling.valued = if gives-rule-values(id) then id else 0
make-cells(id)
. made = emit-call(id, type-id, args)
. type = made.type
styling = own-styling
keep-element(id, made.operand, type)
bind-cells(id, made.operand)
. association = declare-styles(id, made.operand, type)
while rule-givens.length > valued
    rule-givens.pop()
. store = facts.first-element-store(unit.reading, id)
while store != U32.max
    . fact = facts.element-stores[store]
    . place = start + fact.argument
    if fact.setter != 0
        set-attribute(fact.setter, made.operand, type, setting + fact.argument)
    else if place >= element-given.length
        refuse(.refused-expression, id)
    else
        . stored = element-given[place]
        if fact.converted != 0
            stored = convert(fact.converted, .reason-assignment, stored)
        store-argument(made.operand, type, fact.property, stored.operand, stored.type, id)
    store = fact.next
while element-given.length > start
    element-given.pop()
while element-filled.length > filling
    element-filled.pop()
while setter-given.length > setting
    setter-given.pop()
finish-styles(id, made.operand, type, association)
for position in lively .. < attribute-trackers.length
    give-again(attribute-trackers[position].member, attribute-trackers[position].trackers, made.operand, type)
for position in arguing .. < argument-trackers.length
    give-again(argument-trackers[position].member, argument-trackers[position].trackers, made.operand, type)
follow-bound(id, made.operand, type)
while attribute-trackers.length > lively
    attribute-trackers.pop()
while argument-trackers.length > arguing
    argument-trackers.pop()
= Typed(made.operand, type)

────────────────────
_ do follow-bound
    - id SyntaxId
    - made Operand
    - type TypeId

` Gives each binding of a markup element the action that stores back what the element holds as
` it changes: its first run only notes the read of the element's property, so that the place
` keeps the value it gave the element.
do match? tree.nodes[id]
    | .node-markup(element)
        do match? tree.nodes[element.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    do match? tree.nodes[statement]
                        | .node-assign(attribute)
                            if attribute.op == .bind-op
                                . name = identifier-name(tree, attribute.lhs)
                                if !name
                                    refuse(.refused-statement, statement)
                                    =
                                . trackers = open-trackers(attribute.lhs)
                                live-actions += LiveTrackers(trackers, trackers)
                                track(attribute.lhs, made, name)
                                live-actions.pop()
                                give-again(statement, trackers, made, type, attribute.lhs)

────────────────────
_ do set-attribute
    - target SyntaxId
    - made Operand
    - type TypeId
    - place Size

` Gives the object of a markup element, once made, the value of an attribute a setter
` answers, kept where it was evaluated, by calling the setter the type pass chose at the
` attribute's name.
. call = own-call(target)
if call == no-fact || facts.calls[call].form != .call-setter || place >= setter-given.length
    refuse(.refused-expression, target)
    =
. callee = facts.calls[call].callee
if callee == no-instance || facts.calls[call].is-partial || !is-callable(callee) || other-arity
    refuse(.refused-expression, target)
    =
.. other-arity = instances.signatures[callee].args.count != 1
if setter-given[place].type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, target)
    =
. receiver = convert(target, .reason-receiver, Typed(made, type))
if receiver.type != instances.rows[callee].self-type
    refuse(.refused-conversion, target)
. mark = pending.length
pending += receiver.operand
pending += setter-given[place].operand
call-method(callee, target, mark)

────────────────────
_ do declare-styles Operand
    - id SyntaxId
    - made Operand
    - type TypeId

` The style declarations of a markup element, made after its object and before its
` properties are stored, as the reference makes them: those of the style rules it applies, in
` order, then its own, in the order written (see `declare-style`). Answers the association of
` the object with the element's site, or nothing where none was made. Rules that declare no
` style still set the properties they name, where the element has no site.
. nothing = make-operand(.operand-void, 0)
. site = facts.style-site-of(unit.reading, unit.source-module, id)
. number = if site then site.number else U32.max
begin-recording(id, unit.source-module, number)
. association = nothing
. own-styling = styling
styling = styling.gate = U32.max
. applied = tables.first-application(unit.reading)
while applied != U32.max
    . application = facts.style-applications[applied]
    if applied-here && application.outer == U32.max
        association = apply-style-rule(applied, number, made, type, association, U32.max)
    .. applied-here = application.module == unit.source-module && application.site == id
    applied = tables.next-application(applied)
styling = own-styling
if !site
    = nothing
. place = facts.first-style-declaration(unit.reading)
while place != U32.max
    . row = facts.style-declarations[place]
    if row.element == id
        association = declare-style(row, row.layer, row.order, site.number, made, type, association)
    place = facts.next-style-declaration(place)
= association

────────────────────
_ do apply-style-rule Operand
    - index U32
    - number U32
    - made Operand
    - type TypeId
    - association Operand
    - inherited U32

` A style rule applied to an object at a site, as the reference applies one, read through the
` instance that types the rule for the class that writes it, which is the receiver's class
` while it is: first the rules it applies after its name, recorded after it with it as their
` `outer`; then its lines but its `when`s, in the order written, each declaration at the
` application's layer and each property the rule sets stored in the object
` (`update-rule-property`); then each `when`, gated by its condition made under those the
` rule is applied under (`inherited`): the rules its body applies, then its declarations. A
` rule applied under conditions gates its lines by them. Gated declarations take the
` conditional layer at least, and a default's the gated defaults layer (see `enter-gate`).
` Orders count on from the application's first, where the site applies it. The values a
` written application gives the rule are converted first, where the element or the rule that
` applies it is (`bind-rule-values`). A
` `shared` rule is applied by calling the reference's function for it (`call-shared-rule`),
` except in that function (`emit-style-rule`). The application's `action` makes the action of each
` declaration whose value reads something tracked. Answers the association, as
` `declare-style` does. Where the application has `live-values`, each declaration that reads
` them is declared again as they change (`declare-given-style`). A rule applied under the state
` cell of a `when` is applied under the
` condition of the cell first (`cell-condition`). The content the rule's lines generate follows
` its declarations, and that of each `when` the `when`'s (`generate-content`). What a site
` applies is read in the module the site is written in, which may be another's than this
` instance's for the defaults of a class (`emit-defaults`). One the site applies under a
` condition written with it gates everything under that too (`applied-condition`).
. application = facts.style-applications[index]
. unit-id = application.unit
if application.outer == U32.max && shared-rule != index
    style-order = application.order
if application.shared && shared-rule != index
    = call-shared-rule(index, number, made, type, association)
. conditions = cell-condition(application.cell, application.outer-cells, inherited)
if application.outer == U32.max
    conditions = applied-condition(application, conditions)
    site-self = unit.self
    site-self-type = unit.self-type
    site-has-self = unit.has-self
    site-deferred = unit.deferred-type
. own-styling = styling
styling = styling.action = application.action
. opening = association
. bound = rule-names.length
. own-unit = unit
if application.outer == U32.max
    unit = unit.source-module = application.module
if application.written != 0
    bind-rule-values
        - application.written
        - unit-id
        - application.outer != U32.max || tree.nodes[application.site] is .node-slot-outlet
        - application.values
if application.around-values != U32.max
    bind-around-values(application.around-values, unit-id, application.site)
. own-filling = filling
unit = unit.source-module = instances.rows[unit-id].module
unit = unit.reading = unit-id
unit = unit.self-type = instances.rows[unit-id].self-type
unit = unit.self = made
unit = unit.has-self = true
filling = filling.count = 0
unit = unit.deferred-type = no-type
unit = unit.running-rule = true
. associated = apply-inner-rules(index, 0, number, made, type, opening, conditions)
. lines = tree.children[rule-lines(unit-id)]
. marked = marks-up(unit-id)
. lined = false
. written [SyntaxId]
for statement in lines
    written += statement
    if application.family != U32.max && tree.nodes[statement] is .node-markup
        refuse(.refused-statement, statement)
    if !is-when && !is-rule && !is-markup && !(marked && !tree.rule-part(statement))
        lined = true
    .. is-when = tree.nodes[statement] is .node-style-when
    .. is-rule = tree.nodes[statement] is .node-rule-syntax
    .. is-markup = tree.nodes[statement] is .node-markup
. gate = U32.max
if lined && conditions != U32.max
    gate = enter-gate(conditions, made, type, associated)
styling = styling.live = if application.live-values then index else U32.max
styling = styling.family-gated = application.family != U32.max
if styling.family-gated && lined && number != U32.max
    record-family(application, number, true)
for statement in lines
    if when-node || tree.nodes[statement] is .node-rule-syntax || markup-node
        continue
    .. when-node = tree.nodes[statement] is .node-style-when
    .. markup-node = tree.nodes[statement] is .node-markup
    if marked && !tree.rule-part(statement)
        continue
    . row = facts.bound-declaration(unit-id, statement, index)
    . update = facts.rule-update-of(unit-id, statement)
    if row && number != U32.max
        associated = declare-rule-style
            - row
            - application.layer
            - conditions != U32.max
            - number
            - made
            - type
            - associated
    else if update && conditions == U32.max && !styling.family-gated
        update-rule-property(update, made, application)
    else
        refuse(.refused-statement, statement)
if styling.family-gated && lined && number != U32.max
    record-family(application, number, false)
styling = styling.family-gated = own-styling.family-gated
leave-gate(gate, made, type, associated)
associated = generate-content(index, written, conditions, number, made, type, associated)
for statement in lines
    if !(tree.nodes[statement] is .node-style-when)
        continue
    . condition = style-conditions.length as U32
    style-conditions += StyleCondition(StyleWhen(unit.source-module, statement), conditions)
    . entered = enter-gate(condition, made, type, associated)
    associated = apply-inner-rules(index, statement, number, made, type, associated, condition)
    styling = styling.family-gated = application.family != U32.max
    if styling.family-gated && number != U32.max
        record-family(application, number, true)
    for line in when-lines(statement)
        if styling.family-gated && tree.nodes[line] is .node-markup
            refuse(.refused-statement, line)
        if applies-rule || tree.nodes[line] is .node-rule-syntax || tree.nodes[line] is .node-markup
            continue
        .. applies-rule = tree.nodes[line] is .node-style-rule-application
        . row = facts.bound-declaration(unit-id, line, index)
        if row && number != U32.max
            associated = declare-rule-style
                - row
                - application.layer
                - true
                - number
                - made
                - type
                - associated
        else
            refuse(.refused-statement, line)
    if styling.family-gated && number != U32.max
        record-family(application, number, false)
    styling = styling.family-gated = own-styling.family-gated
    leave-gate(entered, made, type, associated)
    associated = generate-content
        - index
        - when-lines(statement)
        - condition
        - number
        - made
        - type
        - associated
unit = own-unit
filling = own-filling
styling = own-styling
while rule-names.length > bound
    rule-names.pop()
= associated

────────────────────
_ do applied-condition U32
    - application StyleApplication
    - conditions U32

` The condition a style rule written after `•` on a markup element is applied under, made under
` those given, as the reference puts it after the state cells: tested where each gate it is part
` of is made, and again by the function written for it. Those given where it writes none.
do match? program.modules[application.module].tree.nodes[application.written]
    | .node-style-rule-application(applied)
        if applied.condition != 0
            . live = tables.live-statement-of(application.instance, applied.condition)
            if !live
                refuse(.refused-statement, application.site)
                = conditions
            . next = style-conditions.length as U32
            style-conditions += StyleCondition(StyleWhen(application.module, applied.condition, U32.max, live.rerun), conditions)
            = next
= conditions

────────────────────
_ do marks-up Bool
    - unit-id InstanceId

` Whether the lines of the style rule an instance types that are not its own are the markup of
` the class that writes it, which its markup function runs: the rule is the class's `• This`,
` kept as its content (`defaults-content`).
. row = instances.rows[unit-id]
. owner = program.modules[row.module]
do match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        do match? owner.decls[rule.owner]
            | .decl-class(class)
                = class.content == rule.syntax
= false

────────────────────
_ do generate-content Operand
    - index U32
    - lines [SyntaxId]
    - conditions U32
    - number U32
    - made Operand
    - type TypeId
    - association Operand

` The content the lines given of a style rule applied at a site by the application `index`
` generate, in the order written, as the reference's `compileGuardedContent` makes it: the
` object made a `MarkupElement` once, the function of each line made a `MarkupSlotBuilder` of it, and
` the record of the line's content made for the association at the next order. Under conditions,
` the record is enabled as they hold (`enable-content`). A line the type pass generated nothing for
` is passed over. Answers the association, as `declare-style` does.
. associated = association
. target = make-operand(.operand-void, 0)
for line in lines
    if !(tree.nodes[line] is .node-markup)
        continue
    . found = content-of(index, line)
    if !found
        continue
    . row = found
    if number == U32.max
        refuse(.refused-statement, line)
        break
    if operand-kind(associated) == .operand-void
        associated = associate-style-site(line, made, type, number)
    if operand-kind(target) == .operand-void
        target = content-target(row.site, line, made, type).operand
    . builder = content-builder(row, line)
    . mark = pending.length
    pending += associated
    pending += target
    pending += integer(.machine-u32, row.slot)
    pending += order-value(line, style-order)
    pending += builder.operand
    style-order += 1
    . record = call-instance(facts.style-runtime.template-content, line, mark)
    if conditions != U32.max
        enable-content(conditions, record.operand, made, type, associated, line)
= associated

────────────────────
_ do content-of StyleContent?
    - index U32
    - line SyntaxId

` The content a line of a style rule generates where the application `index` applies it at the
` site of the instance emitted, as the type pass recorded it, or none.
for row in facts.style-contents
    if row.instance == unit.instance && row.application == index && row.line == line
        = row
= null

────────────────────
_ do content-target Typed
    - site SyntaxId
    - line SyntaxId
    - made Operand
    - type TypeId

` The object generated content is made for, as the `MarkupElement` the style runtime takes it as,
` converted as the type pass recorded at its markup element.
. fact = facts.first-conversion(unit.instance, site)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-markup-host && row.from == type
        = convert-one(line, row, Typed(made, type))
    fact = row.next
refuse(.refused-conversion, line)
= Typed(made, no-type)

────────────────────
_ do content-builder Typed
    - row StyleContent
    - line SyntaxId

` The function that builds the content a line of a style rule generates, made the
` `MarkupSlotBuilder` the style runtime takes, as the type pass recorded it in that function:
` a closure that captures nothing, whose environment is none or holds the values it keeps
` (`content-environment`).
. fact = facts.first-conversion(row.builder, row.line)
while fact != no-fact
    . held = facts.conversions[fact]
    if held.reason == .reason-markup-slot && held.from == row.closure
        . environment = content-environment(row, line)
        = make-function(line, held, environment)
    fact = held.next
refuse(.refused-conversion, line)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do content-environment Operand
    - row StyleContent
    - line SyntaxId

` The environment of the function that builds generated content where it keeps state cells or
` values of the rules around rules written in rules (`kept-layout-of`): no environment in force,
` then each state cell the markup element it is generated at holds of those it keeps, then each
` value, in turn (`around-local`). None where it keeps none.
. layout = tables.kept-layout-of(row.builder)
if layout == no-layout
    = integer(.machine-managed-pointer, 0)
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, line, mark, managed-layout), line)
. place U32 = 1
. taken U32
for held in facts.scope-cells
    if held.instance != row.builder || held.kept == U32.max
        continue
    . local = if held.kept < row.cells then cell-local(kept-cell) else no-local
        .. kept-cell = facts.content-cells[row.cell-first + held.kept]
    if local == no-local
        refuse(.refused-expression, line)
        = load-local(kept, line)
    store
        - load-local(kept, line)
        - tables.layouts.field(layout, held.kept + 1).offset
        - load-local(local, line)
        - true
        - line
    place += 1
for held in facts.scope-values
    if held.instance != row.builder || held.kept == U32.max
        continue
    if taken >= row.values
        refuse(.refused-expression, line)
        = load-local(kept, line)
    . source = facts.content-values[row.value-first + taken]
    for position in 0 .. < held.count
        . (local, type) = around-local(source, position)
        . field = tables.layouts.field(layout, place)
        if local == no-local || other-type || tables.layouts.is-struct(field.layout)
            refuse(.refused-expression, line)
            = load-local(kept, line)
        .. other-type = type != facts.scope-value-types[held.type-first + position]
        store
            - load-local(kept, line)
            - field.offset
            - load-local(local, line)
            - is-managed-pointer(field.layout)
            - line
        place += 1
    taken += 1
= load-local(kept, line)

────────────────────
_ do enable-content
    - conditions U32
    - record Operand
    - made Operand
    - type TypeId
    - association Operand
    - site SyntaxId

` Enables the record of generated content as the conditions it is made under hold, as the
` reference's `compileGuardedContent` does: they are evaluated once in a live action of their
` own, which gathers what they read, and the record is enabled or disabled there; then the
` association is given an action with those trackers that runs the function of the row of
` `style-gates` for the content (`emit-style-gate`) with what it keeps: the object, the record and
` what `gate-locals` holds. An error enabling it raises leaves the function.
. whens = gate-whens(conditions)
. row = facts.gate-of(type, whens, true)
if row == U32.max
    refuse(.refused-statement, site)
    =
. cells = gate-locals(whens, site)
. runtime = facts.style-runtime
. kept-record = ir.add-local(managed-layout)
store-local(kept-record, record, site)
. trackers = open-trackers(site)
live-actions += LiveTrackers(trackers, trackers)
. loaded [Operand]
for cell in cells
    loaded += load-local(cell, site)
. enabled = gate-conditions(whens, made, type, loaded, true)
. mark = pending.length
pending += load-local(kept-record, site)
pending += enabled
do raising-call(site, runtime.content-enabled, mark)
live-actions.pop()
. layout = tables.gate-layouts[row]
. size = tables.layouts.rows[layout].size
mark = pending.length
pending += integer(.machine-u64, size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, site, mark, managed-layout), site)
store(load-local(kept, site), tables.layouts.field(layout, 0).offset, made, true, site)
store
    - load-local(kept, site)
    - tables.layouts.field(layout, 1).offset
    - load-local(kept-record, site)
    - true
    - site
for position in 0 .. < cells.length
    store
        - load-local(kept, site)
        - tables.layouts.field(layout, (position as U32) + 2).offset
        - load-local(cells[position], site)
        - true
        - site
. callback = make-callback
    - tables.live-adapter-of(tables.gate-functions[row])
    - load-local(kept, site)
    - site
mark = pending.length
pending += made
pending += load-local(trackers, site)
pending += callback
. action = call-instance(facts.style-gates[row].action, site, mark)
mark = pending.length
pending += association
pending += action.operand
do call-instance(runtime.dynamic, site, mark)

────────────────────
_ do call-shared-rule Operand
    - index U32
    - number U32
    - made Operand
    - type TypeId
    - association Operand

` A `shared` application of a style rule, as the reference's `callStyleRuleFunction` makes one,
` at the type the element names, as the rule is matched by: the object's association with the
` site made first, then the function given the object, the association, the site's number and
` the order its declarations start from, which count on after them.
. application = facts.style-applications[index]
. code = tables.rule-function-of(index)
if code == no-function || number == U32.max
    refuse(.refused-statement, application.site)
    = association
. own-unit = unit
unit = unit.source-module = application.module
. called = application.site
do match? tree.nodes[called]
    | .node-markup(row)
        called = row.type-id
. opening = association
if operand-kind(opening) == .operand-void
    opening = associate-style-site(called, made, type, number)
. target = tables.functions[code]
. mark = pending.length
pending += made
pending += opening
pending += site-value(number)
pending += order-value(called, style-order)
ir.depend(.callee-function, code, may-panic-dependency)
call
    - make-operand(.operand-symbol, target.symbol)
    - called
    - mark
    - .callee-function
    - void-layout
    - !in-landing
unit = own-unit
style-order += application.span
= opening

────────────────────
_ do emit-style-rule

` The function the reference makes for a style rule applied `shared`, given the object, its
` association with the site, the site's number and the order to start from: the rule applied
` as at an element, its declarations at the number and orders given.
. index = function.place
. application = facts.style-applications[index]
. runtime = facts.style-runtime
unit = unit.source-module = instances.rows[application.unit].module
. association-layout = layout-of(instances.signatures[runtime.associate].returns, application.site)
ir.add-argument(managed-layout)
ir.add-argument(association-layout)
ir.add-argument(u64-layout)
ir.add-argument(u32-layout)
returns-type = types.void-type
ir.returns = void-layout
site-param = make-operand(.operand-argument, 2)
order-param = make-operand(.operand-argument, 3)
shared-rule = index
style-order = 0
begin-recording(application.site, application.module, 0)
do apply-style-rule(index, 0, styled, application.made, make-operand(.operand-argument, 1), U32.max)
    .. styled = make-operand(.operand-argument, 0)
return-value(make-operand(.operand-void, 0), application.site)

────────────────────
_ do site-value Operand
    - number U32

` The number of a style site as the runtime takes it: that given the function of a `shared`
` rule, or the site's own.
if site-param
    = site-param
= integer(.machine-u64, number)

────────────────────
_ do order-value Operand
    - site SyntaxId
    - order U32

` An order of a declaration as the runtime takes it: counted from that given the function of a
` `shared` rule, or as it is.
if order-param
    = arithmetic(site, .arithmetic-add, order-param, integer(.machine-u32, order), u32-layout)
= integer(.machine-u32, order)

────────────────────
_ do apply-inner-rules Operand ?! Refused
    - index U32
    - within SyntaxId
    - number U32
    - made Operand
    - type TypeId
    - association Operand
    - inherited U32

` Applies the rules a style rule applied at a site applies, after its name or, `within` the
` body of one of its `when`s, there, in the order recorded, under the conditions given.
. associated = association
. position = index + 1
while position < facts.style-applications.length
    . nested = facts.style-applications[position]
    if nested.outer == U32.max || nested.outer < index
        break
    if nested.outer == index && nested.within == within
        associated = apply-style-rule(position, number, made, type, associated, inherited)
    position += 1
= associated

────────────────────
_ do declare-rule-style Operand
    - row StyleDeclaration
    - layer U32
    - gated Bool
    - number U32
    - made Operand
    - type TypeId
    - association Operand

` A declaration of a style rule applied at a site, at the next order: in the block of the gate
` in force, opened for it where none is, at the conditional layer at least, or a default's at
` the gated defaults layer, where it is `gated`.
. order = style-order
style-order += 1
if !gated
    = declare-style(row, layer, order, number, made, type, association)
. associated = open-gate(styling.gate, row.site, made, type, number, association)
. floor = if layer == 0 then 3u32 else 4u32
= declare-style
    - row
    - if layer > floor then layer else floor
    - order
    - number
    - made
    - type
    - associated
    - true

────────────────────
_ do when-lines [SyntaxId]
    - branch SyntaxId

` The lines of the body of a `when` of a style rule: the one line of a `when` written on one,
` or those of its block.
. lines [SyntaxId]
do match? tree.nodes[branch]
    | .node-style-when(row)
        do match tree.nodes[row.body]
            | .node-block(block)
                for line in tree.children[block.body]
                    lines += line
            ??
                lines += row.body
= lines

────────────────────
_ do cell-condition U32
    - cell U32
    - outer-cells U32
    - inherited U32

` The condition a style rule applied under the state cells of `when`s is gated by, as the
` reference's `styleScopeStateConditions` puts the cells before those it is applied under: those
` of the `when`s further out (`outer-cells`), the outermost first, then the innermost's, then each
` of those made again over them. Those given where there is no cell.
if cell == U32.max
    = inherited
. chain [U32]
facts.link-cells(outer-cells, chain)
chain += cell
. top = U32.max
for place in chain
    . held = facts.scope-cells[place]
    . next = style-conditions.length as U32
    style-conditions += StyleCondition(StyleWhen(held.module, held.when, place), top)
    top = next
if inherited == U32.max
    = top
for place in gate-whens(inherited)
    . next = style-conditions.length as U32
    style-conditions += StyleCondition(place, top)
    top = next
= top

────────────────────
_ do bind-cells
    - site SyntaxId
    - subject Operand

` Binds the state cells made at a site of this instance, in the order made (`bind-cell`): at a
` markup element once its object is made, or, for none, in the function that fills an object
` with its class's markup before the markup runs.
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance == unit.reading && held.site == site
        bind-cell(index as U32, subject)

────────────────────
_ do make-cells
    - site SyntaxId

` Makes the state cells of a site of this instance, as the reference's
` `createStyleScopeState` does, each kept in a local of its own (`state-cells`).
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance != unit.reading || held.site != site
        continue
    . own-unit = unit
    unit = unit.source-module = held.module
    . local = ir.add-local(managed-layout)
    store-local
        - local
        - call-instance(facts.style-runtime.scope-state, held.when, pending.length).operand
        - held.when
    state-cells += StateCell(index as U32, local)
    unit = own-unit

────────────────────
_ do take-cells
    - declared SyntaxId

` Keeps the state cells the function that fills an object with its class's markup is given, each
` in a local of its own (`state-cells`).
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance != unit.reading || held.argument == U32.max
        continue
    . place = instances.value-argument(unit.instance, held.argument)
    . local = ir.add-local(managed-layout)
    store-local
        - local
        - make-operand(.operand-argument, if unit.takes-self then place + 1 else place)
        - declared
    state-cells += StateCell(index as U32, local)

────────────────────
_ do keep-cells
    - declared SyntaxId

` Keeps, in a function that builds markup, the state cells it keeps of the function it is written
` in, which the environment it is given holds after the one that function had in force where it
` made it (`kept-layout-of`), which is the environment it reads from, and then the values of rules
` it keeps (`taken-values`); then those it reads from the cells the slot outlet that mounts what it
` builds holds, as the reference's `style-outlet-state` reads one; each in a local of its own
` (`state-cells`).
. layout = tables.kept-layout-of(unit.instance)
if layout != no-layout
    . wrapper = make-operand(.operand-argument, 0)
    made-environment = ir.add-local(managed-layout)
    store-local
        - made-environment
        - load(wrapper, tables.layouts.field(layout, 0).offset, managed-layout, declared)
        - declared
    . place U32 = 1
    for index in 0 .. < facts.scope-cells.length
        . held = facts.scope-cells[index]
        if held.instance != unit.reading || held.kept == U32.max
            continue
        . local = ir.add-local(managed-layout)
        store-local
            - local
            - load
                - wrapper
                - tables.layouts.field(layout, held.kept + 1).offset
                - managed-layout
                - declared
            - declared
        state-cells += StateCell(index as U32, local)
        place += 1
    for index in 0 .. < facts.scope-values.length
        . held = facts.scope-values[index]
        if held.instance != unit.reading || held.kept == U32.max
            continue
        taken-values += TakenValues(index as U32, around-values.length as U32)
        for position in held.type-first .. < held.type-first + held.count
            . field = tables.layouts.field(layout, place)
            if tables.layouts.is-struct(field.layout)
                refuse(.refused-function, declared)
                =
            . local = ir.add-local(field.layout, false)
            store-local(local, load(wrapper, field.offset, field.layout, declared), declared)
            around-values += AroundValue(0, local, facts.scope-value-types[position])
            place += 1
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance != unit.reading || !held.read
        continue
    . mark = pending.length
    pending += integer(.machine-u32, tables.state-key-number(held.key))
    . local = ir.add-local(managed-layout)
    store-local(local, call-instance(facts.style-runtime.outlet-state, declared, mark).operand, declared)
    state-cells += StateCell(index as U32, local)

────────────────────
_ do kept-cells Operand
    - id SyntaxId
    - type TypeId
    - written Operand

` The environment a nested function written at a node is given where it keeps state cells or
` values of rules of the function it is written in (`kept-layout-of`): the environment in force
` where it is written, then each cell it keeps, as made or given here, then each value
` (`around-local`). The environment in force alone where it keeps none. One made by a function it
` is not written in has no shape.
. callee = kept-callee(type)
if callee == no-instance
    = written
if instances.rows[callee].enclosing != unit.reading
    refuse(.refused-expression, id)
    = written
. layout = tables.kept-layout-of(callee)
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, id, mark, managed-layout), id)
store(load-local(kept, id), tables.layouts.field(layout, 0).offset, written, true, id)
. place U32 = 1
for held in facts.scope-cells
    if held.instance != callee || held.kept == U32.max
        continue
    . local = cell-local(held.source)
    if local == no-local
        refuse(.refused-expression, id)
        = written
    store
        - load-local(kept, id)
        - tables.layouts.field(layout, held.kept + 1).offset
        - load-local(local, id)
        - true
        - id
    place += 1
for held in facts.scope-values
    if held.instance != callee || held.kept == U32.max
        continue
    for position in 0 .. < held.count
        . (local, type) = around-local(held.source, position)
        . field = tables.layouts.field(layout, place)
        if local == no-local || other-type || tables.layouts.is-struct(field.layout)
            refuse(.refused-expression, id)
            = written
        .. other-type = type != facts.scope-value-types[held.type-first + position]
        store
            - load-local(kept, id)
            - field.offset
            - load-local(local, id)
            - is-managed-pointer(field.layout)
            - id
        place += 1
= load-local(kept, id)

────────────────────
_ do kept-callee InstanceId
    - type TypeId

` The instance a closure type runs where it keeps state cells of the function it is written in,
` or none.
do match? types.rows[type]
    | .type-closure(row)
        for held in tables.kept-instances
            . shape = instances.rows[held]
            if shape.module == row.module && shape.decl == row.decl && same-enclosing
                = held
            .. same-enclosing = shape.enclosing == row.enclosing
= no-instance

────────────────────
_ do hold-outlet-cells LocalId
    - id SyntaxId

` Holds, while the function that builds what a slot outlet mounts runs, the state cells the
` outlet holds (`OutletCell`), each by where it was made, after a mark of those held already,
` which it answers in a local of its own, as the reference's `withMarkupOutletStyleStateCells`
` holds them; none where it holds none.
. mark = no-local
for held in facts.outlet-cells
    if held.instance != unit.reading || held.outlet != id
        continue
    . local = cell-local(held.cell)
    if local == no-local
        refuse(.refused-expression, id)
        = no-local
    if mark == no-local
        . runtime = facts.style-runtime
        mark = ir.add-local(layout-of(instances.signatures[runtime.outlet-mark].returns, id))
        store-local(mark, call-instance(runtime.outlet-mark, id, pending.length).operand, id)
    . first = pending.length
    pending += integer(.machine-u32, tables.state-key-number(facts.scope-cells[held.cell].key))
    pending += load-local(local, id)
    do call-instance(facts.style-runtime.outlet-push, id, first)
= mark

────────────────────
_ do bind-cell
    - index U32
    - subject Operand

` Binds a state cell `make-cells` made to an object, read as of the cell's `owner`, as the
` reference's `bindStyleScopeState` does: the cell is given its value once in a live action of
` its own to gather what it reads (`set-cell`), and a live action with those trackers runs the
` cell's function (`emit-scope-cell`) with what it keeps: the object and the cell. The object
` owns that action (`attach-action`), since the trackers hold it only weakly.
. held = facts.scope-cells[index]
. own-unit = unit
unit = unit.source-module = held.module
. site = held.when
. local = cell-local(index)
if local == no-local
    refuse(.refused-statement, site)
    unit = own-unit
    =
. code = tables.cell-functions[index]
. trackers = open-trackers(site)
live-actions += LiveTrackers(trackers, trackers)
set-cell(held, subject, held.owner, load-local(local, site))
live-actions.pop()
. layout = tables.cell-layouts[index]
. size = tables.layouts.rows[layout].size
. mark = pending.length
pending += integer(.machine-u64, size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, site, mark, managed-layout), site)
store(load-local(kept, site), tables.layouts.field(layout, 0).offset, subject, true, site)
store
    - load-local(kept, site)
    - tables.layouts.field(layout, 1).offset
    - load-local(local, site)
    - true
    - site
. action = make-action
    - load-local(trackers, site)
    - tables.live-adapter-of(code)
    - load-local(kept, site)
    - site
attach-action(subject, action.operand, site)
unit = own-unit

────────────────────
_ do set-cell
    - held ScopeCell
    - subject Operand
    - type TypeId
    - target Operand

` Gives a state cell whether the state its `when` names holds on an object of a type, read
` tracked, as the reference's `bindStyleScopeState` assigns it: true, or where the `when` is
` negated, false. The cell's `is-on` is set as an assignment sets it.
do match? tree.nodes[held.when]
    | .node-style-when(row)
        track(held.when, subject, row.state)
        . value = read-state(held.when, subject, type, row.state)
        if row.is-negated
            value = compare-zero(held.when, value, .compare-equal)
        . cell = tables.cell-type()
        . found = property-of(cell, program.store-atom("is-on"))
        if !found
            refuse(.refused-statement, held.when)
            =
        . field = held-field(held.when, cell, found)
        put-property(target, field, types.properties[found], value.operand, held.when)

────────────────────
_ do read-state Typed
    - id SyntaxId
    - object Operand
    - type TypeId
    - state Atom

` Reads the state a style `when` names on an object, as a `Bool`. No instance types the
` `when`, whose node is in the module that writes it, so the read consults no instance's facts.
. own-unit = unit
unit = unit.reading = no-instance
. value = load-property(id, object, type, state, true, types.bool-type)
unit = own-unit
= value

────────────────────
_ do cell-local LocalId
    - cell U32

` The local that keeps a state cell made where code is emitted, or none.
for kept in state-cells
    if kept.row == cell
        = kept.local
= no-local

────────────────────
_ do enter-gate U32
    - top U32
    - made Operand
    - type TypeId
    - association Operand

` Gates the declarations that follow at a site by a condition and those it was made under, as
` the reference's `compileStyleGatedBlock` does: they join the gate in force where it has the
` same conditions; otherwise that gate is closed and a gate of their own is entered. Answers
` the gate to leave, or `U32.max` where none was entered.
if styling.gate != U32.max && site-gates[styling.gate].top == top
    = U32.max
if styling.gate != U32.max
    close-gate(styling.gate, made, type, association)
. gate = site-gates.length as U32
site-gates += StyleGate(top, no-local, styling.gate)
styling = styling.gate = gate
= gate

────────────────────
_ do leave-gate
    - gate U32
    - made Operand
    - type TypeId
    - association Operand

` Leaves a gate `enter-gate` entered: the gate in force where it was entered is in force
` again, closed, and the gate is closed.
if gate == U32.max
    =
styling = styling.gate = site-gates[gate].outer
close-gate(gate, made, type, association)

────────────────────
_ do open-gate Operand
    - gate U32
    - site SyntaxId
    - made Operand
    - type TypeId
    - number U32
    - association Operand

` Opens a block of declarations for a gate at its first declaration, as the reference's
` `openStyleGate` does: the object is associated with the site where it was not, and the
` number of the block the association opens is kept. Answers the association.
if site-gates[gate].block != no-local
    = association
. associated = association
if operand-kind(associated) == .operand-void
    associated = associate-style-site(site, made, type, number)
. mark = pending.length
pending += associated
. block = call-instance(facts.style-runtime.open-block, site, mark)
. local = ir.add-local(i64-layout)
store-local(local, block.operand, site)
site-gates[gate] = site-gates[gate].block = local
= associated

────────────────────
_ do close-gate
    - gate U32
    - made Operand
    - type TypeId
    - association Operand

` Closes the block a gate has open, as the reference's `closeStyleGate` does, at its innermost
` `when`: the association closes it, its conditions are evaluated once in a live action of
` their own to gather what they read, and the association is given an action with those
` trackers that runs the gate's function (`emit-style-gate`) with what it keeps: the object, the
` block and what `gate-locals` holds. A gate with no block open does nothing.
. local = site-gates[gate].block
if local == no-local
    =
site-gates[gate] = site-gates[gate].block = no-local
. whens = gate-whens(site-gates[gate].top)
. row = facts.gate-of(type, whens)
. place = whens[whens.length - 1]
. own-unit = unit
unit = unit.source-module = place.module
. site = place.syntax
if row == U32.max
    refuse(.refused-statement, site)
    unit = own-unit
    =
. cells = gate-locals(whens, site)
. runtime = facts.style-runtime
. mark = pending.length
pending += association
pending += load-local(local, site)
do call-instance(runtime.close-block, site, mark)
. trackers = open-trackers(site)
live-actions += LiveTrackers(trackers, trackers)
. loaded [Operand]
for cell in cells
    loaded += load-local(cell, site)
gate-conditions(whens, made, type, loaded, true)
live-actions.pop()
. layout = tables.gate-layouts[row]
. size = tables.layouts.rows[layout].size
mark = pending.length
pending += integer(.machine-u64, size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, site, mark, managed-layout), site)
store(load-local(kept, site), tables.layouts.field(layout, 0).offset, made, true, site)
store
    - load-local(kept, site)
    - tables.layouts.field(layout, 1).offset
    - load-local(local, site)
    - false
    - site
for position in 0 .. < cells.length
    store
        - load-local(kept, site)
        - tables.layouts.field(layout, (position as U32) + 2).offset
        - load-local(cells[position], site)
        - true
        - site
. callback = make-callback
    - tables.live-adapter-of(tables.gate-functions[row])
    - load-local(kept, site)
    - site
mark = pending.length
pending += made
pending += load-local(trackers, site)
pending += callback
. action = call-instance(facts.style-gates[row].action, site, mark)
mark = pending.length
pending += association
pending += action.operand
do call-instance(runtime.dynamic, site, mark)
unit = own-unit

────────────────────
_ do gate-locals [LocalId]
    - whens [StyleWhen]
    - site SyntaxId

` The locals holding what the function of a gate keeps for its `when`s, in turn: the state cell
` of each that is one, and for each condition a rule is applied under the environment in force
` here, from which the function written for it reads what it captured. Refused where a cell is
` not made here.
. locals [LocalId]
for held in whens
    if held.cell != U32.max
        . local = cell-local(held.cell)
        if local == no-local
            refuse(.refused-statement, site)
            = locals
        locals += local
    else if held.test != no-instance
        . local = ir.add-local(managed-layout)
        store-local(local, written-environment(site), site)
        locals += local
= locals

────────────────────
_ do gate-whens [StyleWhen]
    - top U32

` The `when`s of a condition made at a site and of those it was made under, the outermost
` first.
. upward [StyleWhen]
. condition = top
while condition != U32.max
    upward += style-conditions[condition].when
    condition = style-conditions[condition].parent
. whens [StyleWhen]
for position in 0 .. < upward.length
    whens += upward[upward.length - 1 - position]
= whens

────────────────────
_ do gate-conditions Operand
    - whens [StyleWhen]
    - object Operand
    - type TypeId
    - cells [Operand]
    - at-site Bool

` Evaluates the states the `when`s given name, the outermost first, on an object, as the
` reference evaluates their conjunction: each read tracked, true or, where it is negated,
` false, and each but the first only where those before hold. The `when` of a state cell reads
` `is-on` of the cell, tracked. A condition a rule is applied under is evaluated where the
` element is written, `at-site` (`site-condition`), or else by the function written for it,
` given the environment kept for it. `cells` gives the cells and the environments in turn.
` Answers whether all hold.
. own-unit = unit
. place = whens[0]
unit = unit.source-module = place.module
. layout = layout-of(types.bool-type, place.syntax)
. held = ir.add-local(layout)
. done = ir.reserve-block()
. celled = 0
for position in 0 .. < whens.length
    place = whens[position]
    unit = unit.source-module = place.module
    . value = make-operand(.operand-void, 0)
    if place.cell != U32.max
        . is-on = program.store-atom("is-on")
        track(place.syntax, cells[celled], is-on)
        value = read-state(place.syntax, cells[celled], tables.cell-type(), is-on).operand
        celled += 1
    else if place.test != no-instance
        if at-site
            value = site-condition(place).operand
        else
            . mark = pending.length
            pending += cells[celled]
            value = call-instance(place.test, place.syntax, mark).operand
        celled += 1
    else
        do match? tree.nodes[place.syntax]
            | .node-style-when(row)
                track(place.syntax, object, row.state)
                . state-read = read-state(place.syntax, object, type, row.state)
                value = state-read.operand
                if row.is-negated
                    value = compare-zero(place.syntax, Typed(value, state-read.type), .compare-equal).operand
    store-local(held, value, place.syntax)
    if position + 1 < whens.length
        . next = ir.reserve-block()
        branch(load-local(held, place.syntax), next, done)
        ir.start-block(next)
jump(done)
ir.start-block(done)
. holds = load-local(held, place.syntax)
unit = own-unit
= holds

────────────────────
_ do site-condition Typed
    - place StyleWhen

` The condition a style rule written on a markup element is applied under, evaluated where the
` element is written, with the trackers of the live action open noting what it reads: as the
` instance that writes it types it, with the receiver there.
. own-unit = unit
unit = unit.reading = instances.rows[place.test].enclosing
unit = unit.self = site-self
unit = unit.self-type = site-self-type
unit = unit.has-self = site-has-self
unit = unit.running-rule = false
unit = unit.deferred-type = site-deferred
. value = emit-expression(place.syntax)
unit = own-unit
= Typed(value.operand, types.bool-type)

────────────────────
_ do gives-rule-values Bool
    - id SyntaxId

` Whether a markup element writes a style rule application that gives values, or applies a rule
` that the reference evaluates the values of once more as it prepares the element (`prepared`).
do match? tree.nodes[id]
    | .node-markup(element)
        for application in tree.children[element.style-rule-applications]
            do match? tree.nodes[application]
                | .node-style-rule-application(applied)
                    if applied.args.count != 0
                        = true
. place = tables.first-application(unit.reading)
while place != U32.max
    . held = facts.style-applications[place]
    if held.prepared && held.module == unit.source-module && held.site == id
        = true
    place = tables.next-application(place)
= false

────────────────────
_ do emit-rule-values
    - id SyntaxId

` Evaluates the values given to the style rules written on a markup element, in the order
` written, once its attributes are and before its object is made, as the reference evaluates
` them, whether or not a rule takes them: each is kept as evaluated, to be converted where its
` rule is applied. Those of a rule the rules written in it read (`ScopeValues`) are converted
` now, for the constructor to be given them too (`around-values`). The values the reference
` evaluates once more as it prepares the element are evaluated and let go after those of the
` application that applies their rules, those of rules the element applies by none first
` (`prepare-applied`).
do match? tree.nodes[id]
    | .node-markup(element)
        prepare-applied(id, 0)
        for application in tree.children[element.style-rule-applications]
            do match? tree.nodes[application]
                | .node-style-rule-application(applied)
                    . read = reads-around(application)
                    for value in tree.children[applied.args]
                        if facts.theme-read-of(unit.reading, value)
                            continue
                        . kept = emit-expression(value)
                        rule-givens += RuleValue(apart(kept, value, true), kept.type, value)
                        if read
                            . converted = convert(value, .reason-argument, kept)
                            . layout = layout-of(converted.type, value)
                            . local = ir.add-local(layout, false)
                            store-local(local, converted.operand, value)
                            around-values += AroundValue(value, local, converted.type)
                    prepare-applied(id, application)

────────────────────
_ do prepare-applied
    - site SyntaxId
    - written SyntaxId

` Evaluates the values the reference evaluates once more as it prepares a markup element, of the
` rules after the names of those the element applies by the application `written`, or by none
` it writes (`prepare-rule-values`).
. place = tables.first-application(unit.reading)
while place != U32.max
    . held = facts.style-applications[place]
    if held.module == unit.source-module && held.site == site && top-written
        prepare-rule-values(place)
    .. top-written = held.outer == U32.max && held.written == written
    place = tables.next-application(place)

────────────────────
_ do prepare-rule-values ?! Refused
    - index U32

` Evaluates, and lets go, the values that call a function given to the rules written after the
` name of the rule the application `index` applies, and after theirs in turn, in order, as the
` reference evaluates them as it prepares the markup element (`nestedRuleScopesForPrepared`),
` before its object is made (`prepared`): in the instance that types the rule that writes them,
` where there is no object yet, nor the values of the rules around. They are evaluated again as
` their rules are applied.
. position = index + 1
while position < facts.style-applications.length
    . nested = facts.style-applications[position]
    if nested.outer == U32.max || nested.outer < index
        break
    if nested.outer == index && nested.within == 0
        if nested.prepared
            drop-rule-values(nested.written, facts.style-applications[index].unit)
        prepare-rule-values(position)
    position += 1

────────────────────
_ do drop-rule-values
    - written SyntaxId
    - unit-id InstanceId

` Evaluates the values a written application gives, in the instance `unit-id` that types them, and
` lets them go (`prepare-rule-values`).
. own-unit = unit
. own-filling = filling
unit = unit.source-module = instances.rows[unit-id].module
unit = unit.reading = unit-id
unit = unit.self-type = instances.rows[unit-id].self-type
unit = unit.has-self = false
filling = filling.count = 0
unit = unit.deferred-type = no-type
unit = unit.running-rule = false
do match? tree.nodes[written]
    | .node-style-rule-application(applied)
        for value in tree.children[applied.args]
            emit-expression(value)
unit = own-unit
filling = own-filling

────────────────────
_ do reads-around Bool
    - application SyntaxId

` Whether the values an application written after `•` here gives are read by the rules written
` in the rule it applies (`ScopeValues`).
for held in facts.scope-values
    if held.instance == unit.instance && held.site == application && held.module == unit.source-module
        = true
= false

────────────────────
_ do bind-rule-values
    - written SyntaxId
    - unit-id InstanceId
    - now Bool
    - values InstanceId

` Converts each value a written application gives a style rule, at its node, to the type the
` rule takes it as, and keeps it in a local of its own for the rule's reads of the name that
` takes it. The values an element gives were evaluated before its object was made
` (`emit-rule-values`); those a rule gives a rule it applies are evaluated `now`, in it, as are
` those a slot outlet gives once its node is mounted, and those an instance of their own types
` (`values`), read through its facts. Those an element gives are kept for the rules written in
` the rule too (`around-values`).
. row = instances.rows[unit-id]
. owner = program.modules[row.module]
. names [SyntaxId]
do match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        do match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                for arg in owner.tree.children[declared.args]
                    do match? owner.tree.nodes[arg]
                        | .node-argument-decl(shape)
                            do match? owner.tree.nodes[shape.pattern]
                                | .node-type-capture(capture)
                                    names += capture.id
do match? tree.nodes[written]
    | .node-style-rule-application(applied)
        if applied.args.count != names.length
            refuse(.refused-statement, written)
            =
        for position in 0 .. < applied.args.count
            . value = tree.children[applied.args.start + position]
            if values == no-instance && facts.theme-read-of(unit.reading, value)
                continue
            . given = Typed(make-operand(.operand-void, 0), no-type)
            . converted = given
            if values != no-instance
                converted = root-value(value, values)
            else
                if !now
                    . found = around-place(value)
                    if found
                        rule-names += RuleName(bindings.resolution-of(row.binding, names[position]).slot, around-values[found].local, around-values[found].type)
                        continue
                if now
                    given = emit-expression(value)
                else
                    . index = rule-givens.length
                    while index != 0 && rule-givens[index - 1].written != value
                        index -= 1
                    if index == 0
                        refuse(.refused-expression, value)
                        =
                    given = Typed(rule-givens[index - 1].value, rule-givens[index - 1].type)
                converted = convert(value, .reason-argument, given)
            . layout = layout-of(converted.type, value)
            . local = ir.add-local(layout, false)
            store-local(local, converted.operand, value)
            rule-names += RuleName(bindings.resolution-of(row.binding, names[position]).slot, local, converted.type)
        =
refuse(.refused-statement, written)

────────────────────
_ do bind-around-values
    - index U32
    - unit-id InstanceId
    - site SyntaxId

` Gives a rule written in a rule, for its reads of the names the rule around it takes values by,
` the values the markup element that applied that rule gave it (`ScopeValues`), as the
` reference defines them in the frames it is applied within (`withStyleRuleLexicalFrames`): each
` as kept, converted, where the rule around was applied, or as given (`around-local`).
