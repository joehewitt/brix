_ do emit-themed-value

. row = facts.style-themed-values[function.place]
. site = row.site
unit = unit.source-module = row.module
unit = unit.reading = row.instance
ir.add-argument(managed-layout)
ir.add-argument(managed-layout)
theme-record = make-operand(.operand-argument, 1)
. made-type = facts.style-runtime.themed-made
. layout = layout-of(made-type, site)
returns-type = made-type
ir.returns = layout
bind-themed-givens(row)
. value = make-operand(.operand-void, 0)
do match? tree.nodes[site]
    | .node-assign(line)
        value = convert(site, .reason-assignment, emit-expression(line.rhs)).operand
. none = none-flag(site, row.type, value)
. bits = style-bits(site, row.type, value)
. made = frame(layout)
put(made, tables.layouts.field(layout, 0), bits, site)
put(made, tables.layouts.field(layout, 1), none.operand, site)
return-value(made, site)

────────────────────
_ do bind-themed-givens
    - row StyleThemedValue

` Keeps each value a style rule takes as a slot of a style sheet, which a line of the rule
` computes with, in a local read from the subtree's record, for the line's reads of the rule's
` value (`read-rule-value`).
for position in 0 .. < row.given-count
    . given = facts.themed-givens[row.given + position]
    . type = facts.sheet-slots[sheet-first + given.slot].type
        .. sheet-first = tables.style-sheet-uses[tables.sheet-number(row.sheet)].first
    . value = read-theme
        - row.site
        - ThemeRead(row.instance, row.module, row.site, row.sheet, given.slot)
    . layout = layout-of(type, row.site)
    . local = ir.add-local(layout, false)
    store-local(local, value.operand, row.site)
    rule-names += RuleName(given.param, local, type)

────────────────────
_ do read-theme Typed
    - id SyntaxId
    - read ThemeRead

. nothing = make-operand(.operand-void, 0)
if function.kind != .style-themed-value
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. runtime = facts.style-runtime
. use = tables.style-sheet-uses[tables.sheet-number(read.sheet)]
. type = facts.sheet-slots[use.first + read.slot].type
. mark = pending.length
pending += theme-record
pending += integer(.machine-u64, read.slot)
. bits = call-instance(runtime.themed-slot, id, mark)
if !types.is-optional(type)
    = decode-style(id, bits.operand, type)
mark = pending.length
pending += theme-record
pending += integer(.machine-u64, read.slot)
. none = call-instance(runtime.themed-none, id, mark)
. there = compare(id, .compare-equal, none.operand, integer(.machine-u8, 0))
. inner = types.optional-inner(type)
. layout = layout-of(type, id)
. cell = ir.add-local(layout)
. holding = ir.reserve-block()
. empty = ir.reserve-block()
. joined = ir.reserve-block()
branch(there, holding, empty)
ir.start-block(holding)
. held = decode-style(id, bits.operand, inner)
store-local(cell, wrap(id, held, type).operand, id)
jump(joined)
ir.start-block(empty)
store-local(cell, empty-optional(type, layout).operand, id)
jump(joined)
ir.start-block(joined)
= Typed(load-local(cell, id), type)

────────────────────
_ do emit-static-value

` The function that evaluates the value of a style declaration once for every making, which
` the style runtime calls through the function value it is given, as the reference's
` `style-static-value` does: the value, read through the instance that types the declaration
` and converted as where it is written, and the bits the runtime interns it as, packed with
` whether it holds nothing: twice one more than the bits, and one more again where it does.
. row = facts.style-static-values[function.place]
. site = row.site
unit = unit.source-module = row.module
unit = unit.reading = row.instance
ir.add-argument(managed-layout)
returns-type = types.type-row(.int64)
ir.returns = i64-layout
. value = make-operand(.operand-void, 0)
do match? tree.nodes[site]
    | .node-assign(line)
        value = convert(site, .reason-assignment, emit-expression(line.rhs)).operand
. none = none-flag(site, row.type, value)
. bits = style-bits(site, row.type, value)
. more = arithmetic(site, .arithmetic-add, bits, integer(.machine-i64, 1), i64-layout)
. doubled = arithmetic(site, .arithmetic-add, more, more, i64-layout)
return-value
    - arithmetic
        - site
        - .arithmetic-add
        - doubled
        - num-cast(site, none.operand, u8-layout, i64-layout)
        - i64-layout
    - site

────────────────────
_ do declare-sheet-slot Operand
    - row StyleDeclaration
    - info Operand
    - layer U32
    - order U32
    - number U32
    - association Operand

` A declaration that takes its value from the slot of a style sheet, as the reference's
` `compileStyleDeclaration` makes one: the record of the sheet by its number, then the runtime's
` declaration of the slot for the site. The runtime reads the slot's value as it settles, and
` where the slot is of another type than the property makes the property's bits of the slot's as
` the projection says.
. associated = association
. runtime = facts.style-runtime
. mark = pending.length
pending += integer(.machine-u64, tables.sheet-number(row.sheet))
. sheet = call-instance(runtime.sheet-info-required, row.site, mark)
. use = tables.style-uses[style-number(row.site, row.style)]
mark = pending.length
pending += site-value(number)
pending += info
pending += integer(.machine-u64, row.property - use.first)
pending += integer(.machine-u32, layer)
pending += order-value(row.site, order)
pending += sheet.operand
pending += integer(.machine-u64, row.sheet-slot)
if row.projection == U32.max
    do call-instance(runtime.site-sheet, row.site, mark)
    = associated
. projection = facts.style-projections[row.projection]
pending += integer(.machine-u32, projection.kind)
pending += integer(.machine-i64, projection.tag)
pending += integer
    - .machine-u64
    - if projection.kind == 2 then tables.remap-number(row.projection) else 0u32
pending += integer(.machine-u8, if projection.preserves-none then 1 else 0u64)
. remap = layout-of(runtime.remap-tags, row.site)
if projection.kind == 2
    . wrapped = wrap
        - row.site
        - Typed(make-operand(.operand-symbol, tables.remap-symbol(row.projection)), types.optional-inner(runtime.remap-tags))
        - runtime.remap-tags
    pending += wrapped.operand
else
    pending += empty-optional(runtime.remap-tags, remap).operand
do call-instance(runtime.site-projected, row.site, mark)
= associated

────────────────────
_ do none-flag Typed
    - site SyntaxId
    - type TypeId
    - value Operand

` Whether a value of a style property's type is none: an optional that holds nothing.
if !types.is-optional(type)
    = Typed(integer(.machine-u8, 0), types.bool-type)
. there = present(site, Typed(value, type))
. none = compare(site, .compare-equal, there.operand, integer(.machine-u8, 0))
= Typed(none, types.bool-type)

────────────────────
_ do holds-style-handle Bool
    - type TypeId

` Whether the runtime holds a handle to a value of a style property's type, as the reference's
` `styleValueNeedsHolder` says: an object, a value boxed, or a union with a case that is no
` whole number of at most 32 bits.
. inner = if types.is-optional(type) then types.optional-inner(type) else type
. kind = intrinsic(inner)
if intrinsic-is-numeric(kind) && kind != .cpointer && kind != .number
    = false
if kind != .union
    = true
for item in types.cases-of(inner)
    if !inline-style-case(item.type)
        = true
= false

────────────────────
_ boxed-style Bool
    - kind IntrinsicKind

` Whether a style value of a kind is kept in a box the runtime holds a handle to: a tuple, a
` struct or a string.
kind == .tuple || kind == .struct || kind == .string

────────────────────
_ inline-style-case Bool
    - type TypeId

` Whether a case of a union style value is kept in the slot's bits above its number: a whole
` number of at most 32 bits.
is-integer-kind(intrinsic(type)) && size > 0 && size <= 32

.. size = types.completions[type].bit-size

────────────────────
_ do author-value
    - site SyntaxId
    - type TypeId
    - value Operand
    - head [Operand]
    - bits-call InstanceId
    - object-call InstanceId

` Declares a value the runtime holds a handle to, as the reference's `compileStyleHolderValue`
` does, by calls given what comes before the value: an object by a holder of its own, which an
` optional that holds nothing is too, flagged none; an optional of any other value that holds
` nothing as no bits, flagged none; and what it holds otherwise as `author-held` says.
. inner = if types.is-optional(type) then types.optional-inner(type) else type
. optional = types.is-optional(type)
if intrinsic(inner) == .class
    . none = none-flag(site, type, value)
    . holder = value-holder(site, inner, value, optional)
    call-held(site, head, none.operand, holder.operand, 0, 0, object-call)
    =
if !optional
    author-held(site, inner, value, head, bits-call, object-call)
    =
. there = present(site, Typed(value, type))
. holding = ir.reserve-block()
. empty = ir.reserve-block()
. joined = ir.reserve-block()
branch(there.operand, holding, empty)
ir.start-block(holding)
author-held(site, inner, payload(site, Typed(value, type)).operand, head, bits-call, object-call)
jump(joined)
ir.start-block(empty)
call-bits(site, head, integer(.machine-i64, 0), integer(.machine-u8, 1), bits-call)
jump(joined)
ir.start-block(joined)

────────────────────
_ do author-held
    - site SyntaxId
    - type TypeId
    - value Operand
    - head [Operand]
    - bits-call InstanceId
    - object-call InstanceId

` A value that is no optional and no object, declared by a holder: its box, or for a union the
` case it holds, a whole number of at most 32 bits as bits above the case's number, an object
` by a holder of its own and any other value by its box, framed by the case's number.
. no = integer(.machine-u8, 0)
if intrinsic(type) != .union
    . box = wide-holder(site, type, value)
    call-held(site, head, no, box.operand, 0, 0, object-call)
    =
. layout = layout-of(type, site)
. cases = types.cases-of(type)
. joined = ir.reserve-block()
for index in 0 .. < cases.length
    . case-type = cases[index].type
    . holding = ir.reserve-block()
    . next = ir.reserve-block()
    branch(case-test(site, value, index as U32), holding, next)
    ir.start-block(holding)
    . field = tables.layouts.case-field(layout, index as U32)
    . held = take(value, field, site)
    if inline-style-case(case-type)
        . bits = num-cast(site, held, field.layout, i64-layout)
        . shifted = bitwise(site, .bitwise-shift-left, bits, integer(.machine-i64, 8), i64-layout)
        call-bits
            - site
            - head
            - bitwise(site, .bitwise-or, shifted, integer(.machine-i64, index as U64), i64-layout)
            - no
            - bits-call
    else if intrinsic(case-type) == .class
        . holder = value-holder(site, case-type, held, false)
        call-held(site, head, no, holder.operand, 8, index as U32, object-call)
    else
        . box = wide-holder(site, case-type, held)
        call-held(site, head, no, box.operand, 8, index as U32, object-call)
    jump(joined)
    ir.start-block(next)
jump(joined)
ir.start-block(joined)

────────────────────
_ do call-bits
    - site SyntaxId
    - head [Operand]
    - bits Operand
    - none Operand
    - callee InstanceId

` Declares the bits of a value by the call given, after what comes before the value.
. mark = pending.length
for operand in head
    pending += operand
pending += bits
pending += none
do call-instance(callee, site, mark)

────────────────────
_ do call-held
    - site SyntaxId
    - head [Operand]
    - none Operand
    - holder Operand
    - shift U32
    - tag U32
    - callee InstanceId

` Declares a value by its holder by the call given, after what comes before the value: whether
` it is none, the holder, and the shift and number of the union case that frames it.
. mark = pending.length
for operand in head
    pending += operand
pending += none
pending += holder
pending += integer(.machine-u32, shift)
pending += integer(.machine-i64, tag)
do call-instance(callee, site, mark)

────────────────────
_ do value-holder Typed
    - site SyntaxId
    - type TypeId
    - value Operand
    - optional Bool

` The runtime's holder of an object a declaration holds, which takes it as the optional of its
` class, as the reference's `makeStyleObjectHolder` makes one: a value given as the class is
` wrapped in it. The holder is given as the optional of the holders' base.
for coding in facts.style-codings
    if coding.type == type && coding.value-holder != no-instance
        . taken = value
        if !optional
            taken = wrap(site, Typed(value, type), coding.taken).operand
        . mark = pending.length
        pending += taken
        . holder = call-instance(coding.value-holder, site, mark)
        . held = facts.style-runtime.held
        = wrap(site, Typed(holder.operand, types.optional-inner(held)), held)
refuse(.refused-function, site)
= Typed(value, no-type)

────────────────────
_ do wide-holder Typed
    - site SyntaxId
    - type TypeId
    - value Operand

` The runtime's box of a value of a type no number fits, as the reference's
` `makeStyleWideHolder` makes one, given as the optional of the holders' base.
for coding in facts.style-codings
    if coding.type == type && coding.holder != no-instance
        . mark = pending.length
        pending += value
        . box = call-instance(coding.holder, site, mark)
        . held = facts.style-runtime.held
        = wrap(site, Typed(box.operand, types.optional-inner(held)), held)
refuse(.refused-function, site)
= Typed(value, no-type)

────────────────────
_ do declare-live-style Operand
    - row StyleDeclaration
    - live LiveStatement
    - number U32
    - made Operand
    - type TypeId
    - association Operand

` A style declaration whose value read something tracked, as the reference's tracked
` declaration makes one: the value is evaluated once in a live action of its own to gather
` what it reads, the object is kept where the declaration's function reaches it, and the
` association of the object with the site is given an action of the style runtime with those
` trackers that runs the function, which declares the value for the object as it changes
` (`author-again`). Answers the association.
. code = if live.rerun != no-instance then tables.instance-functions[live.rerun] else no-function
. slot = channel-slot(row.site)
if code == no-function || slot == no-slot || live.owned == no-instance
    refuse(.refused-statement, row.site)
    = association
. trackers = open-trackers(row.site)
live-actions += LiveTrackers(trackers, trackers)
do match? tree.nodes[row.site]
    | .node-assign(attribute)
        do convert(row.site, .reason-assignment, emit-expression(attribute.rhs))
live-actions.pop()
keep-captured(slot, made, type, row.site)
. callback = make-callback(tables.live-adapter-of(code), written-environment(row.site), row.site)
. mark = pending.length
pending += made
pending += load-local(trackers, row.site)
pending += callback
. action = call-instance(live.owned, row.site, mark)
. associated = association
if operand-kind(associated) == .operand-void
    associated = associate-style-site(row.site, made, type, number)
mark = pending.length
pending += associated
pending += action.operand
do call-instance(facts.style-runtime.dynamic, row.site, mark)
= associated

────────────────────
_ do declare-inherit Operand
    - row StyleDeclaration
    - info Operand
    - layer U32
    - order U32
    - number U32
    - association Operand

. use = tables.style-uses[style-number(row.site, row.style)]
. runtime = facts.style-runtime
. mark = pending.length
pending += site-value(number)
pending += info
pending += integer(.machine-u64, row.property - use.first)
pending += integer(.machine-u32, layer)
pending += order-value(row.site, order)
do call-instance(runtime.site-inherit, row.site, mark)
= association

────────────────────
_ do declare-authored-style Operand
    - row StyleDeclaration
    - author U32
    - layer U32
    - order U32
    - gated Bool
    - number U32
    - made Operand
    - type TypeId
    - association Operand

` A declaration of a style rule whose value read something tracked, as the reference makes
` one: the value is evaluated once in a live action of its own to gather what it reads, and the
` association of the object with the site is given an action of the style runtime, made by the
` application's `action`, with those trackers, that runs the declaration's function
` (`emit-style-author`) with what it keeps: the object, the block of the gate in force, or none,
` the layer and the order. Answers the association.
. code = tables.author-functions[author]
. layout = tables.author-layouts[author]
if code == no-function || styling.action == no-instance
    refuse(.refused-statement, row.site)
    = association
. trackers = open-trackers(row.site)
live-actions += LiveTrackers(trackers, trackers)
do match? tree.nodes[row.site]
    | .node-assign(line)
        do convert(row.site, .reason-assignment, emit-expression(line.rhs))
live-actions.pop()
. block = integer(.machine-i64, U64.max)
if gated
    block = load-local(site-gates[styling.gate].block, row.site)
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, row.site, mark, managed-layout), row.site)
store(load-local(kept, row.site), tables.layouts.field(layout, 0).offset, made, true, row.site)
store(load-local(kept, row.site), tables.layouts.field(layout, 1).offset, block, false, row.site)
store
    - load-local(kept, row.site)
    - tables.layouts.field(layout, 2).offset
    - integer(.machine-u32, layer)
    - false
    - row.site
store
    - load-local(kept, row.site)
    - tables.layouts.field(layout, 3).offset
    - order-value(row.site, order)
    - false
    - row.site
. callback = make-callback(tables.live-adapter-of(code), load-local(kept, row.site), row.site)
mark = pending.length
pending += made
pending += load-local(trackers, row.site)
pending += callback
. action = call-instance(styling.action, row.site, mark)
. associated = association
if operand-kind(associated) == .operand-void
    associated = associate-style-site(row.site, made, type, number)
mark = pending.length
pending += associated
pending += action.operand
do call-instance(facts.style-runtime.dynamic, row.site, mark)
= associated

────────────────────
_ given-place U32
    - row StyleDeclaration

` The place among `given-functions` of the function that declares again a line of the style rule
` being applied whose value reads values the application gives, where it has `live-values`, or
` `U32.max`.
|? styling.live == U32.max || !row.reads-given || row.fixed || row.once || row.sheet != U32.max || row.themed != U32.max
    U32.max
??
    tables.given-author(styling.live, row.site)

────────────────────
_ do declare-given-style Operand
    - row StyleDeclaration
    - place U32
    - layer U32
    - order U32
    - gated Bool
    - number U32
    - made Operand
    - type TypeId
    - association Operand

` A declaration of a style rule whose value reads values an application with `live-values`
` gives, as `declare-authored-style` makes one whose own value reads something tracked: the
` values, evaluated again where they are written (`bind-live-values`), and the declaration's
` value are evaluated once in a live action of their own to gather what they read, and the
` association of the object with the site is given an action, made by the application's
` `action`, with those trackers, that runs the function of `given-functions` with what it keeps:
` the object, the block of the gate in force, or none, the layer, the order, and the receiver
` where the values the site applies are written. Answers the association.
. code = tables.given-functions[place]
. layout = tables.given-layouts[place]
if code == no-function || styling.action == no-instance
    refuse(.refused-statement, row.site)
    = association
. trackers = open-trackers(row.site)
live-actions += LiveTrackers(trackers, trackers)
. bound = rule-names.length
bind-live-values(styling.live, made, site-self, site-deferred)
do match? tree.nodes[row.site]
    | .node-assign(line)
        do convert(row.site, .reason-assignment, emit-expression(line.rhs))
while rule-names.length > bound
    rule-names.pop()
live-actions.pop()
. block = integer(.machine-i64, U64.max)
if gated
    block = load-local(site-gates[styling.gate].block, row.site)
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, row.site, mark, managed-layout), row.site)
store(load-local(kept, row.site), tables.layouts.field(layout, 0).offset, made, true, row.site)
store(load-local(kept, row.site), tables.layouts.field(layout, 1).offset, block, false, row.site)
store
    - load-local(kept, row.site)
    - tables.layouts.field(layout, 2).offset
    - integer(.machine-u32, layer)
    - false
    - row.site
store
    - load-local(kept, row.site)
    - tables.layouts.field(layout, 3).offset
    - order-value(row.site, order)
    - false
    - row.site
store(load-local(kept, row.site), tables.layouts.field(layout, 4).offset, site-self, true, row.site)
keep-given-row-items(place, load-local(kept, row.site), row.site)
. callback = make-callback(tables.live-adapter-of(code), load-local(kept, row.site), row.site)
mark = pending.length
pending += made
pending += load-local(trackers, row.site)
pending += callback
. action = call-instance(styling.action, row.site, mark)
. associated = association
if operand-kind(associated) == .operand-void
    associated = associate-style-site(row.site, made, type, number)
mark = pending.length
pending += associated
pending += action.operand
do call-instance(facts.style-runtime.dynamic, row.site, mark)
= associated

────────────────────
_ do keep-given-row-items
    - place U32
    - kept Operand
    - site SyntaxId

. own-unit = unit
. field U32 = 5
. layout = tables.given-layouts[place]
for item in tables.given-row-items(tables.given-applications[place])
    unit = unit.reading = item.instance
    unit = unit.source-module = instances.rows[unit.reading].module
    do match? tree.nodes[item.site]
        | .node-identifier(named)
            . value = emit-identifier(item.site, named.name, item.held)
            store(kept, tables.layouts.field(layout, field).offset, value.operand, true, site)
    field += 1
unit = own-unit

────────────────────
_ do bind-given-row-items
    - place U32
    - kept Operand
    - site SyntaxId

. field U32 = 5
. layout = tables.given-layouts[place]
for item in tables.given-row-items(tables.given-applications[place])
    . binding = instances.rows[item.instance].binding
    . slot = bindings.resolution-of(binding, item.site).slot
    . local = ir.add-local(managed-layout)
    store-local(local, load(kept, tables.layouts.field(layout, field).offset, managed-layout, site), site)
    rule-names += RuleName(slot, local, item.held)
    field += 1

────────────────────
_ do bind-live-values
    - index U32
    - made Operand
    - receiver Operand
    - deferred TypeId

` Evaluates again the values given by the applications from the one a site applies out to the
` application `index` of `style-applications`, the outermost first, each where it is written, and
` binds them for the rules' reads of the names that take them, as `bind-rule-values` does: those
` the site gives on the receiver where they are written, read through the instance that types
` them, and those a rule gives on the object, read through the instance that types that rule.
` Values of the rules around a rule written in a rule, and a rule shared, have no shape here.
. chain [U32]
. position = index
while true
    chain += position
    . held = facts.style-applications[position]
    if held.around-values != U32.max || held.shared
        refuse(.refused-statement, held.site)
        =
    if held.outer == U32.max
        break
    position = held.outer
. own-unit = unit
. own-filling = filling
. step = chain.length
while step != 0
    step -= 1
    . held = facts.style-applications[chain[step]]
    if held.written == 0
        continue
    if held.outer == U32.max
        unit = unit.source-module = held.module
        unit = unit.reading = held.instance
        unit = unit.self = receiver
        unit = unit.self-type = tables.given-receiver(chain[step])
        unit = unit.running-rule = unit.reading != unit.instance
        unit = unit.deferred-type = deferred
    else
        . around = facts.style-applications[held.outer].unit
        unit = unit.source-module = instances.rows[around].module
        unit = unit.reading = around
        unit = unit.self = made
        unit = unit.self-type = instances.rows[around].self-type
        unit = unit.running-rule = true
        unit = unit.deferred-type = no-type
    unit = unit.has-self = true
    filling = filling.count = 0
    bind-rule-values(held.written, held.unit, true, held.values)
unit = own-unit
filling = own-filling

────────────────────
_ do finish-styles
    - id SyntaxId
    - made Operand
    - type TypeId
    - association Operand

` Makes the style site of a markup element ready once its properties are stored (see
` `finish-style-site`).
. site = facts.style-site-of(unit.reading, unit.source-module, id)
if site
    finish-style-site(id, made, type, association, site.number)

────────────────────
_ do finish-style-site
    - at SyntaxId
    - made Operand
    - type TypeId
    - association Operand
    - number U32

` Makes a style site ready for an object, associating the object with the site first where no
` declaration did, as the reference finishes a site.
if operand-kind(association) == .operand-void
    associate-style-site(at, made, type, number)
. recording = recording-local(number)
if recording != no-local
    . marking = ir.reserve-block()
    . joined = ir.reserve-block()
    branch(load-local(recording, at), marking, joined)
    ir.start-block(marking)
    . site = pending.length
    pending += site-value(number)
    do call-instance(facts.style-runtime.site-recorded, at, site)
    jump(joined)
    ir.start-block(joined)
. subject = style-subject(at, made, type)
. mark = pending.length
pending += subject
call-instance(facts.style-runtime.site-ready, at, mark)

────────────────────
_ do associate-style-site Operand
    - at SyntaxId
    - made Operand
    - type TypeId
    - number U32

` The association of an object with a style site, made at `at`.
. subject = style-subject(at, made, type)
. mark = pending.length
pending += subject
pending += site-value(number)
= call-instance(facts.style-runtime.associate, at, mark).operand

────────────────────
_ do style-subject Operand
    - site SyntaxId
    - value Operand
    - type TypeId

` An object as the `Pointer` the style runtime takes it as, cast as the reference casts it:
` that of an interface is the object it holds.
. layout = layout-of(type, site)
if intrinsic(type) == .interface
    = num-cast(site, load(value, 0, managed-layout, site), managed-layout, pointer-layout)
if !is-pointer(layout)
    refuse(.refused-type, site)
    = value
= num-cast(site, value, layout, pointer-layout)

────────────────────
_ do style-number U32
    - site SyntaxId
    - style TypeId

` The number of a style the program registers. One the program does not register, where only a
` function it does not reach was seen to use it, has no shape here.
. number U32
while number < tables.style-uses.length && tables.style-uses[number].type != style
    number += 1
if number < tables.style-uses.length && !tables.style-uses[number].registered
    refuse(.refused-function, site)
= number

────────────────────
_ do give-again
    - statement SyntaxId
    - trackers LocalId
    - made Operand
    - type TypeId
    - site SyntaxId = 0

` The live action of an attribute whose value read something tracked: the element's object
` is kept in the local no name reaches declared at the attribute, and the action, with the
` trackers the value noted and a callback that runs the attribute's function with the
` environment in force here, is owned by the object. That of an argument given by position
` keeps the object in the one declared at the element. The action of an element of a markup
` host is made by the markup runtime, given the element as its host, or where the type pass
` made it with a batch, given the element where it is the batch and else the one in force. That
` of a line of the element's body that gives content is made as an attribute's is, and that of a
` line of an arm's body is given what the arm's function is given, converted at the line. The
` action that stores back what a binding's element holds is made at the `site` it is written at.
. at = if site != 0 then site else statement
. row = tables.live-statement-of(unit.reading, at)
. element = tree.argument-element(statement)
. slot = if element != 0 then channel-slot(element) else line-keeper(statement)
. code = if row && row.rerun != no-instance then tables.instance-functions[row.rerun] else no-function
if code == no-function || slot == no-slot
    refuse(.refused-statement, at)
    =
if site == 0
    keep-captured(slot, made, type, statement)
if row!.owned == no-instance
    . action = make-action
        - load-local(trackers, at)
        - tables.live-adapter-of(code)
        - written-environment(at)
        - at
    attach-action(made, action.operand, at)
    =
. callback = make-callback(tables.live-adapter-of(code), written-environment(at), at)
. written = if element != 0 then element else tree.attribute-element(statement)
if written == 0
    written = tree.content-element(statement)
. type-id SyntaxId = if written == 0 then statement else 0u32
do match? tree.nodes[written]
    | .node-markup(row)
        type-id = row.type-id
    | .node-slot-outlet(row)
        type-id = row.type-id
. owner = make-operand(.operand-void, 0)
if row!.rooted
    . root = facts.element-root-of(unit.reading, written)
    if root && root.owns
        owner = convert(type-id, .reason-markup-batch, Typed(made, type)).operand
    else if content-roots.length != 0
        owner = content-roots[content-roots.length - 1]
    if operand-kind(owner) == .operand-void
        refuse(.refused-statement, statement)
else
    owner = convert(type-id, .reason-markup-host, Typed(made, type)).operand
. mark = pending.length
pending += load-local(trackers, at)
pending += callback
pending += owner
. action = raising-call(at, row!.owned, mark)
attach-action(made, action.operand, at)

────────────────────
_ do emit-attributes
    - id SyntaxId
    - callee InstanceId
    - fact CallFact
    - count U32

` Evaluates the attributes of a markup element that its constructor is given after its
` `count` arguments, in the order written: each takes the conversion recorded at its line as a
` value assigned, and is kept. One that names a parameter fills it; the place among the values
` kept of each other one is kept too, as the constructor is given those after its parameters.
` One whose value reads something tracked is evaluated in a live action of its own, whose
` trackers are kept to make the action with. One that declares a style is evaluated once the
` object is made, and one a setter answers is kept apart, for the setter (`set-attribute`). One
` the constructor is not given at the place it is written at has no shape here.
. given U32
. written U32
. declared = unfilled - instances.rows[callee].carried - instances.rows[callee].slots.count
    .. unfilled = instances.signatures[callee].args.count - instances.rows[callee].fills.count
do match? tree.nodes[id]
    | .node-markup(element)
        do match? tree.nodes[element.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    do match? tree.nodes[statement]
                        | .node-assign(attribute)
                            if facts.style-declaration-of(unit.reading, statement)
                                continue
                            . setter = own-call(attribute.lhs)
                            if setter != no-fact && facts.calls[setter].form == .call-setter
                                . tracked = tables.live-statement-of(unit.reading, statement)
                                . watching = if tracked then open-trackers(statement) else no-local
                                if tracked
                                    live-actions += LiveTrackers(watching, watching)
                                . given = convert
                                    - attribute.rhs
                                    - .reason-argument
                                    - emit-expression(attribute.rhs)
                                if tracked
                                    live-actions.pop()
                                    attribute-trackers += LiveMember(statement, watching)
                                setter-given += Typed(apart(given, attribute.rhs, true), given.type)
                                continue
                            . name = identifier-name(tree, attribute.lhs)
                            . place = if name then instances.fill-argument(callee, name) else U32.max
                            . fills = filled-parameter(fact, count + written) != U32.max
                            if !fills && place != declared + given
                                refuse(.refused-expression, statement)
                            else
                                . live = tables.live-statement-of(unit.reading, statement)
                                . trackers = if live then open-trackers(statement) else no-local
                                if live
                                    live-actions += LiveTrackers(trackers, trackers)
                                . value = convert
                                    - statement
                                    - .reason-assignment
                                    - emit-expression(attribute.rhs)
                                if fills
                                    value = convert(statement, .reason-argument, value)
                                if live
                                    live-actions.pop()
                                    attribute-trackers += LiveMember(statement, trackers)
                                if !fills
                                    element-filled += element-given.length as U32
                                    given += 1
                                element-given += Typed(apart(value, attribute.rhs, true), value.type)
                                written += 1

────────────────────
_ do give-cells
    - id SyntaxId
    - count U32

` Gives the constructor of a markup element the state cells the element's context gives, in the
` order the type pass recorded them (`CarriedCell`), each as made or given where code is
` emitted, and then the values of the rules around rules written in rules it gives
` (`CarriedValues`), each as kept where code is emitted (`around-local`).
. given U32
for held in facts.carried-cells
    if held.instance != unit.reading || held.site != id
        continue
    . local = cell-local(held.cell)
    if local == no-local
        refuse(.refused-expression, id)
        =
    pending += load-local(local, id)
    given += 1
for held in facts.carried-values
    if held.instance != unit.reading || held.site != id
        continue
    for position in 0 .. < around-count(held.values)
        . (local, type) = around-local(held.values, position)
        if local == no-local
            refuse(.refused-expression, id)
            =
        pending += load-local(local, id)
        given += 1
if given != count
    refuse(.refused-expression, id)

────────────────────
_ do give-slots
    - element SyntaxId
    - callee InstanceId

` Gives the constructor of a markup element the function that builds each slot the lines of
` its body give content, in the order the constructor takes them (`builder-value`). Making these
` runs nothing.
. slots = instances.rows[callee].slots.count
. first = instances.signatures[callee].args.count - slots
for offset in 0 .. < slots
    . name = instances.slot-name(callee, offset)
    . line = slot-line(element, name)
    if line == 0
        refuse(.refused-expression, element)
        break
    . built = if tree.holds-fills(line) then emit-choice(line, name) else builder-value(line)
    if built.type != instances.argument-type(callee, first + offset)
        refuse(.refused-conversion, line)
    pending += built.operand

────────────────────
_ do slot-line SyntaxId
    - element SyntaxId
    - name Atom

` The line of a markup element's body that gives the slot of a name content
` (`body-slot-line`), or the name of the element for the name of the function that gives the
` name its object; or none.
do match? tree.nodes[element]
    | .node-markup(row)
        if name.text == binder-slot
            = row.id
        = body-slot-line(row.body, name)
= 0

────────────────────
_ do body-slot-line SyntaxId
    - body SyntaxId
    - name Atom

` The line of a body that binds the slot of a name, or that gives the default slot, for the
` empty name, element or value, or the body where all of it does, that the type pass made a
` function of, or that forwards the slot of the name; or none.
. default = name.text.length == 0
if body == 0
    = 0
if default && is-closure(facts.node-type(unit.instance, body))
    = body
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if !default && fills-name(statement, name)
                = statement
            do match tree.nodes[statement]
                | .node-markup(line)
                    if is-closure(facts.node-type(unit.instance, statement))
                        if default && line.slot-binding == 0
                            = statement
                        if !default && line.slot-binding != 0 && same-name
                            = statement
                        .. same-name = identifier-name(tree, line.slot-binding) == name
                | .node-markup-slot-forward(line)
                    if !default && identifier-name(tree, line.slot-binding) == name
                        = statement
                ??
                    . attribute = tree.nodes[statement] is .node-assign
                    if default && !attribute && !tree.holds-fills(statement) && is-closure(facts.node-type(unit.instance, statement))
                        = statement
= 0

────────────────────
_ do fills-name Bool
    - control SyntaxId
    - name Atom

=? false if !tree.holds-fills(control)
= chosen-line(control, name) != 0

────────────────────
_ do chosen-line SyntaxId
    - control SyntaxId
    - name Atom

for arm in tree.region-arms(control)
    do match? tree.nodes[tree.region-arm-body(arm)]
        | .node-block(block)
            for line in tree.children[block.body]
                do match? tree.nodes[line]
                    | .node-markup(row)
                        if identifier-name(tree, row.slot-binding) == name
                            = line
= 0

────────────────────
_ do emit-choice Typed
    - control SyntaxId
    - name Atom

. nothing = Typed(make-operand(.operand-void, 0), no-type)
. fact = facts.slot-choice-of(unit.reading, chosen-line(control, name))
if !fact
    refuse(.refused-expression, control)
    = nothing
. arms = tree.region-arms(control)
. index-kind = layout-of(types.index-type, control) as MachineKind
. anchor = tree.selector-anchor(control)
. selector = convert(anchor, .reason-markup-slot, emit-closure(anchor, fact.selector))
. mark = pending.length
pending += selector.operand
pending += integer(index-kind, arms.length as U64)
. choice = call-instance(fact.create, control, mark)
. held = ir.add-local(managed-layout)
store-local(held, choice.operand, control)
for position in 0 .. < arms.length
    do match? tree.nodes[tree.region-arm-body(arms[position])]
        | .node-block(block)
            for line in tree.children[block.body]
                do match? tree.nodes[line]
                    | .node-markup(row)
                        if identifier-name(tree, row.slot-binding) == name
                            . built = builder-value(line)
                            . filling = pending.length
                            pending += load-local(held, control)
                            pending += integer(index-kind, position as U64)
                            pending += built.operand
                            do call-instance(fact.fill, line, filling)
= Typed(load-local(held, control), fact.choice)

────────────────────
_ do builder-value Typed
    - line SyntaxId

` What a line that gives a slot content gives as the slot's builder: its function, made the
` builder the type pass recorded at the line, with the batch in force kept first where the type
` pass found one, in the local the function reads it from; or, where it forwards a slot, the
` builder of that name this function was given, or reaches through the local that holds it.
. nothing = make-operand(.operand-void, 0)
do match? tree.nodes[line]
    | .node-markup-slot-forward(row)
        . fact = facts.slot-outlet-of(unit.reading, row.outlet)
        if fact && fact.argument != U32.max
            . position = fact.argument
            = forward-builder
                - line
                - Typed(make-operand(.operand-argument, if unit.takes-self then position + 1 else position), instances.argument-type(unit.instance, position))
        if fact && fact.held != no-slot
            . type = find-captured(fact.held, line).type
            = forward-builder(line, read-captured(fact.held, line, type))
        refuse(.refused-expression, line)
        = Typed(nothing, no-type)
. root = facts.region-root-of(unit.reading, line)
if root
    . batch = if content-roots.length != 0 then content-roots[content-roots.length - 1] else nothing
    if operand-kind(batch) == .operand-void
        refuse(.refused-expression, line)
        = Typed(nothing, no-type)
    . field = find-captured(root.slot, line)
    keep-captured(root.slot, batch, field.type, line)
= convert(line, .reason-markup-slot, emit-closure(line))

────────────────────
_ do emit-outlet Operand
    - id SyntaxId
    - name SyntaxId
    - body SyntaxId

` A slot outlet, as the function that fills an object with its class's markup mounts it
` (`SlotOutlet`): the node the function that builds the slot gives, the argument this function was
` given for it, or the local a function written in it reads it from, called, given the item the
` outlet names where the slot repeats; or else the one the element its body writes makes, or the
` node its lines are built into (`emit-wrapper`), cast to the type of the slot, which the local the
` outlet's name declares is given. Then each line of its body that assigns is evaluated, in the
` order written, converted as a value assigned to the property it names, and stored there, and the
` one whose value read something tracked is given its live action, owned by the node. The rules the
` outlet applies and the lines that declare styles declare them for the node first, at the outlet's
` own site (`declare-styles`), which is made ready last (`finish-styles`). An outlet that mounts
` nothing gives nothing. One built by the function of the arm it is (`builds-outlet`) gives its name
` nothing, unless that function builds it alone (`builds-outlet-alone`).
. nothing = make-operand(.operand-void, 0)
. fact = facts.slot-outlet-of(unit.reading, id)
if fact && fact.chosen != no-instance
    = emit-chosen-outlet(id, fact)
if tree.builds-outlet-alone(id) && !builds-outlet(id)
    emit-outlet-arm(id)
    = nothing
if !fact
    refuse(.refused-expression, id)
    = nothing
if fact.argument == U32.max && fact.held == no-slot && fact.fallback == 0
    = nothing
. type = fact.content
. built = Typed(nothing, no-type)
if fact.picks != no-type
    built = emit-picked-outlet(id, fact, type)
else if fact.argument != U32.max || fact.held != no-slot
    . source = nothing
    . builder = no-type
    if fact.argument != U32.max
        . position = fact.argument
        source = make-operand(.operand-argument, if unit.takes-self then position + 1 else position)
        builder = instances.argument-type(unit.instance, position)
    else
        builder = find-captured(fact.held, id).type
        source = read-captured(fact.held, id, builder).operand
    . item Operand? = null
    if fact.item != 0
        item = convert(fact.item, .reason-argument, emit-expression(fact.item)).operand
    built = call-outlet-builder(id, source, builder, item)
else
    built = emit-outlet-fallback(fact.fallback)
if built.type != type
    refuse(.refused-conversion, id)
    = nothing
. made = built.operand
if names-placed(name) && (!builds-outlet(id) || tree.builds-outlet-alone(id))
    name-element(id, name, built)
. association = declare-styles(id, made, type)
. lively = attribute-trackers.length
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            do match? tree.nodes[statement]
                | .node-assign(attribute)
                    if facts.style-declaration-of(unit.reading, statement)
                        continue
                    . name = identifier-name(tree, attribute.lhs)
                    . place = types.property-named(type, name) if name
                    if !place
                        refuse(.refused-statement, statement)
                        break
                    . live = tables.live-statement-of(unit.reading, statement)
                    . trackers = if live then open-trackers(statement) else no-local
                    if live
                        live-actions += LiveTrackers(trackers, trackers)
                    . value = convert(statement, .reason-assignment, emit-expression(attribute.rhs))
                    if live
                        live-actions.pop()
                        attribute-trackers += LiveMember(statement, trackers)
                    store-argument(made, type, place as U32, value.operand, value.type, statement)
for position in lively .. < attribute-trackers.length
    give-again(attribute-trackers[position].member, attribute-trackers[position].trackers, made, type)
while attribute-trackers.length > lively
    attribute-trackers.pop()
finish-styles(id, made, type, association)
= made

────────────────────
_ do call-outlet-builder Typed
    - id SyntaxId
    - source Operand
    - builder TypeId
    - item Operand? = null

. holding = hold-outlet-cells(id)
. built = call-builder(id, source, builder, item)
if holding != no-local
    . mark = pending.length
    pending += load-local(holding, id)
    do call-instance(facts.style-runtime.outlet-release, id, mark)
= built

────────────────────
_ do emit-outlet-fallback Typed
    - fallback SyntaxId

=? convert(fallback, .reason-assignment, emit-wrapper(fallback)) if tree.nodes[fallback] is .node-block
= convert(fallback, .reason-assignment, emit-expression(fallback))

────────────────────
_ do emit-picked-outlet Typed
    - id SyntaxId
    - fact SlotOutlet
    - type TypeId

. nothing = Typed(make-operand(.operand-void, 0), no-type)
. choice-type = find-captured(fact.held, id).type
. choice = read-captured(fact.held, id, choice-type)
. read = load-property(id, choice.operand, choice-type, program.store-atom("chosen"), true)
if !types.is-optional(read.type) || types.optional-inner(read.type) != fact.picks
    refuse(.refused-expression, id)
    = nothing
if fact.fallback == 0
    = call-outlet-builder(id, payload(id, read).operand, fact.picks)
. result = ir.add-local(layout-of(type, id), false)
. filled = ir.reserve-block()
. empty = ir.reserve-block()
. onward = ir.reserve-block()
branch(present(id, read).operand, filled, empty)
ir.start-block(filled)
. given = call-outlet-builder(id, payload(id, read).operand, fact.picks)
if given.type != type
    refuse(.refused-conversion, id)
    = nothing
store-local(result, given.operand, id)
jump(onward)
ir.start-block(empty)
. fell = emit-outlet-fallback(fact.fallback)
if fell.type != type
    refuse(.refused-conversion, id)
    = nothing
store-local(result, fell.operand, id)
jump(onward)
ir.start-block(onward)
= Typed(load-local(result, id), type)

────────────────────
_ do emit-chosen-outlet Operand
    - id SyntaxId
    - fact SlotOutlet

. nothing = make-operand(.operand-void, 0)
. top = content-hosts.length
if top == 0
    refuse(.refused-statement, id)
    = nothing
. choice = nothing
if fact.argument != U32.max
    . position = fact.argument
    choice = make-operand(.operand-argument, if unit.takes-self then position + 1 else position)
else
    choice = read-captured(fact.held, id, find-captured(fact.held, id).type).operand
. alone = tree.builds-outlet-alone(id)
. arm = if alone then convert(id, .reason-markup-arm, emit-closure(id, fact.arm)).operand else nothing
. mark = pending.length
pending += content-hosts[top - 1].operand
pending += choice
if alone
    pending += arm
    pending += integer(.machine-u8, if fact.fallback != 0 then 1 else 0)
= raising-call(id, fact.chosen, mark).operand

────────────────────
_ do emit-outlet-arm
    - id SyntaxId

. top = content-hosts.length
. slot = channel-slot(id)
if top == 0 || slot == no-slot
    refuse(.refused-statement, id)
    =
. batch = slot - 1
. kept = find-captured(batch, id)
if kept.type != types.void-type
    . root = if content-roots.length != 0 then content-roots[content-roots.length - 1] else make-operand(.operand-void, 0)
    if operand-kind(root) == .operand-void
        refuse(.refused-statement, id)
        =
    keep-captured(batch, root, kept.type, id)
. closure = convert(id, .reason-markup-arm, emit-closure(id))
do call-builder(id, closure.operand, closure.type, content-hosts[top - 1].operand)

────────────────────
_ do call-builder Typed
    - site SyntaxId
    - source Operand
    - builder TypeId
    - item Operand? = null

` A call of what a value of a function type that takes nothing, or the one `item`, holds, given the
` data it holds: the function that builds a slot, as a slot outlet calls it. What runs is not known
` here, so the call is checked for a panic, which the type pass has said of the caller. A type that
` carries errors answers with its value or one of them, and an error leaves the function at the
` call, as the type pass kept.
. nothing = make-operand(.operand-void, 0)
. fn = function-row(types, builder)
. returns = no-type
if fn != no-type
    do match? types.rows[fn]
        | .type-function(row)
            returns = value-returned(row.return-type)
. carried = if fn != no-type && carries(fn) then facts.carried-result(fn) else no-type
. fact = own-call(site)
if returns == no-type || uncarried || fact == no-fact || in-zone || uncaught-panic
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
.. uncarried = fn != no-type && carries(fn) && carried == no-type
.. uncaught-panic = !function.may-panic && !in-landing
. layout = layout-of(builder, site)
if layout != tables.layouts.function-layout
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. code = load(source, 0, pointer-layout, site)
. data = load(source, tables.layouts.field(layout, 1).offset, managed-layout, site)
. mark = pending.length
pending += data
if item
    pending += item
. answers = layout-of(if carried == no-type then returns else carried, site)
. result = Typed(call(code, site, mark, .callee-value, answers, !in-landing), returns)
if carried != no-type
    result = Typed(result.operand, carried)
    if facts.calls[fact].propagates
        result = propagate-held(site, carried, result.operand)
= result

────────────────────
_ do writes-attributes Bool
    - id SyntaxId

` Whether the body of a markup element gives its constructor an attribute: a line that assigns
` and declares no style.
do match? tree.nodes[id]
    | .node-markup(element)
        do match? tree.nodes[element.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    if tree.nodes[statement] is .node-assign && unstyled
                        = true
                    .. unstyled = !facts.style-declaration-of(unit.reading, statement)
= false

────────────────────
_ do store-argument
    - object Operand
    - type TypeId
    - place U32
    - value Operand
    - given TypeId
    - site SyntaxId

` Stores an argument of a markup element in the property of its parameter's name, as an
` assignment to the property stores a value of the property's type: a lazy property is
` marked as having its value.
. property = types.properties[place]
. held = if tables.is-class(type) then tables.layouts.objects[type] else no-layout
. is-lazy = property.storage-kind == .storage-lazy
if held == no-layout || unstored || given != property.type
    refuse(.refused-statement, site)
    =
.. unstored = property.storage-kind != .storage-eager && !is-lazy
. field = tables.layouts.field(held, object-header-fields + property.slot)
. flag-offset U32 = U32.max
if is-lazy
    if !tables.layouts.is-struct(field.layout)
        refuse(.refused-statement, site)
        =
    . pair = field
    . inner = tables.layouts.field(pair.layout, 0)
    flag-offset = pair.offset + tables.layouts.field(pair.layout, 1).offset
    field = LayoutField(pair.offset + inner.offset, inner.layout)
put-property(object, field, property, value, site, flag-offset, false, memo-flag-of(type, property))

────────────────────
_ do catchers-bind Bool
    - catchers RowRange'SyntaxId

` Whether a catcher declares a name for the error it names, or for one in its chain.
for catcher in tree.children[catchers]
    do match? tree.nodes[catcher]
        | .node-catcher(row)
            if is-capture(row.type)
                = true
            for pattern in tree.children[row.previous]
                if is-capture(pattern)
                    = true
= false

────────────────────
_ is-capture Bool
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-capture
        true
    ??
        false

────────────────────
_ is-probe Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-probe
        true
    | .node-probe-scope
        true
    | .node-probe-statement
        true
    | .node-probe-counter
        true
    | .node-probe-group
        true
    | .node-probe-assign
        true
    ??
        false

────────────────────
_ machine-or-value SyntaxId
    - pattern SyntaxId
    - value SyntaxId

` What a declaration's value is emitted as: the state machine it is, where it declares one
` name, or the value.
if tree.declared-local(pattern) != 0 then tree.declared-value(value) else value

────────────────────
_ do emit-declare ?! Refused
    - id SyntaxId
    - pattern SyntaxId
    - value SyntaxId

` A declaration of one local, with or without a type, of several that take no value, or of
` those a pattern names. A tuple taken apart from an optional panics where it holds nothing.
do match tree.nodes[pattern]
    | .node-type-capture(row)
        if row.type != 0 && reads-name(row.type)
            declare-shaped(id, pattern, value)
        else
            declare-local(id, row.id, row.type, value)
    | .node-type-property
        declare-shaped(id, pattern, value)
    | .node-type-and
        declare-shaped(id, pattern, value)
    | .node-type-list
        declare-shaped(id, pattern, value)
    | .node-identifier
        declare-local(id, pattern, 0, value)
    | .node-type-tuple(row)
        if value != 0
            . source = emit-expression(value)
            if types.is-optional(source.type)
                source = unwrap(pattern, source)
            destructure(id, row.field-types, source.operand, source.type, true)
        else
            for field in tree.children[row.field-types]
                emit-declare(id, field, 0)
    | .node-tuple-syntax(row)
        emit-destructure(id, row.items, value, true)
    ??
        refuse(.refused-statement, id)

────────────────────
_ do declare-shaped
    - id SyntaxId
    - pattern SyntaxId
    - value SyntaxId

` A declaration written with a pattern where a name or a type goes: the value is matched
` against the pattern, the names the pattern declares are locals that hold what it captured,
` and where it does not match the declaration panics. A pattern that the reference lets
` fail and go on from, its names unset, has no shape here.
if value == 0
    refuse(.refused-statement, id)
    =
. subject = emit-expression(value)
shape-declared(id, pattern, subject)

────────────────────
_ do shape-declared
    - id SyntaxId
    - pattern SyntaxId
    - subject Typed

` Matches a value a declaration, or the header of a loop, is given against the pattern
` written there, and panics where it does not fit.
if !fails-aloud(pattern)
    refuse(.refused-statement, id)
    =
. failed = ir.reserve-block()
. done = ir.reserve-block()
. own-matching = matching
. jumps = fail-jumps
matching = matching.declaring = true
emit-pattern(pattern, subject, failed)
matching = own-matching
jump(done)
ir.start-block(failed)
. plan = facts.plan-of(unit.reading, tested(pattern))
if fail-jumps == jumps
    jump(done)
else if !function.may-panic || other-plan
    refuse(.refused-statement, id)
else
    raise-text(pattern, "Pattern match failed")
.. other-plan = plan != .plan-unmatched && plan != .plan-list-pattern && plan != .plan-text-pattern
ir.start-block(done)

────────────────────
_ tested SyntaxId
    - pattern SyntaxId

` The pattern that tests what a declaration is given: the one written, or the one a name
` captures.
match tree.nodes[pattern]
    | .node-type-capture(row)
        row.type
    ??
        pattern

────────────────────
_ fails-aloud Bool
    - pattern SyntaxId

` Whether a pattern panics wherever it does not match as a declaration: one that reads a
` name or takes anything always matches, and whatever is joined after a pattern fails aloud,
` as a pattern of items or of texts does.
match tree.nodes[pattern]
    | .node-type-property
        true
    | .node-type-wildcard
        true
    | .node-type-list
        true
    | .node-type-capture(row)
        row.type == 0 || fails-aloud(row.type)
    | .node-type-and(row)
        facts.plan-of(unit.reading, pattern) == .plan-text-pattern || fails-aloud(row.left)
    ??
        false

────────────────────
_ reads-name Bool
    - pattern SyntaxId

` Whether a pattern passes on what a name read from its subject gives: one that reads a
` name, one joined after it, or a name that captures either.
match tree.nodes[pattern]
    | .node-type-property
        true
    | .node-type-and(row)
        reads-name(row.left)
    | .node-type-capture(row)
        row.type != 0 && reads-name(row.type)
    ??
        false

────────────────────
_ do emit-destructure
    - id SyntaxId
    - names RowRange'SyntaxId
    - value SyntaxId
    - declares Bool

` Takes a tuple written as a value apart, into the names written for its fields.
. source = emit-expression(value)
destructure(id, names, source.operand, source.type, declares)

────────────────────
_ do destructure ?! Refused
    - id SyntaxId
    - names RowRange'SyntaxId
    - source Operand
    - owner TypeId
    - declares Bool
    - item Bool = false

` Takes a tuple apart: each of its first fields into a local, a new one or one that exists,
` or into a global that exists. The local has the field's own type, or the type written for
` it where the type pass recorded the field's conversion there, or the type of a local that
` exists, which the type pass recorded the field's conversion to at its name; the global has
` the field's own type. A field written as `_` goes nowhere, and one written as a tuple of names is taken
` apart in turn. A lazy local,
` whose value is evaluated wherever a read comes first, keeps the cell it was first given.
` A local an environment holds is stored there. `item` says the tuple is the item of a
` loop, and the names those its pattern writes. A table or a span of one is taken apart, as
` TypeScript takes it, into a view of each field's column of the type of its local, one name
` after another; one written as `_` still has the table checked.
. layout = layout-of(owner, id)
. tabled = is-row-source(intrinsic(owner))
if !tabled && (!tables.layouts.is-struct(layout) || too-few-fields)
    refuse(.refused-statement, id)
    =
.. too-few-fields = tables.layouts.rows[layout].fields.count < names.count
for position in 0 .. < names.count
    . name = tree.children[names.start + position]
    . annotation SyntaxId = 0
    . skipped = false
    do match? tree.nodes[name]
        | .node-type-capture(row)
            name = row.id
            annotation = row.type
        | .node-type-wildcard
            skipped = true
    if skipped
        if tabled
            table-source(id, source, owner, layout)
        continue
    . inner = field-names(name)
    if tabled && inner.count != 0
        refuse(.refused-statement, name)
        =
    if inner.count != 0
        . nested = take(source, tables.layouts.field(layout, position), id)
        destructure(id, inner, nested, field-type(owner, position), declares, item)
        continue
    if !declares
        . kept = assigned-global(name, id)
        if kept != no-storage
            if tabled
                refuse(.refused-statement, name)
                =
            store-part-global
                - name
                - kept
                - take(source, tables.layouts.field(layout, position), id)
                - field-type(owner, position)
            continue
    . slot = local-slot(name, id, true, item)
    . offset = slot-offset(slot, id)
    . held = facts.slot-type(unit.instance, offset)
    if tabled
        . view = table-view(id, source, owner, layout, position, held)
        store-part(id, name, slot, offset, view.operand, held, layout-of(held, name), declares)
        continue
    . field = tables.layouts.field(layout, position)
    . kept = field.layout
    . part = take(source, field, id)
    if held != field-type(owner, position)
        if annotation == 0 && declares
            refuse(.refused-conversion, name)
            =
        . given = Typed(part, field-type(owner, position))
        . converted = if declares then convert(annotation, .reason-declaration, given, name) else convert(name, .reason-assignment, given)
        part = converted.operand
        if converted.type != held
            refuse(.refused-conversion, name)
        kept = layout-of(held, name)
    store-part(id, name, slot, offset, part, held, kept, declares)

────────────────────
_ do store-part
    - id SyntaxId
    - name SyntaxId
    - slot SlotId
    - offset U32
    - part Operand
    - held TypeId
    - kept LayoutId
    - declares Bool

` Stores a part of a value taken apart in the local a name gives it: in the environment that
` holds the local, or in its cell, which a declaration gives it unless it is a lazy one that
` keeps the cell it was first given.
if kept == void-layout
    =
if is-captured(slot)
    if bindings.slots[slot].kind == .slot-lazy
        refuse(.refused-statement, name)
        =
    keep-captured(slot, part, held, id)
    =
if declares && (unit.cells[offset] == no-local || bindings.slots[slot].kind != .slot-lazy)
    . taken = (bindings.slots[slot].flags /and/ SlotFlag.slot-address-taken) != 0
    unit.cells[offset] = ir.add-local(kept, taken)
if unit.cells[offset] == no-local
    refuse(.refused-statement, name)
    =
store-local(unit.cells[offset], part, id)

────────────────────
_ do store-part-global
    - name SyntaxId
    - kept U32
    - part Operand
    - type TypeId

` Stores a part of a value taken apart in the global a name gives it, where the global has the
` part's type, as an assignment of the global does.
. global = tables.storage[kept]
if type != global.type
    refuse(.refused-conversion, name)
    =
store-global(global, part, name)
if tables.global-kind(global.module, global.decl) == .global-lazy
    store-release(make-operand(.operand-symbol, global.state), 0, integer(.machine-u8, 1), name)

────────────────────
_ do declare-local
    - id SyntaxId
    - name SyntaxId
    - annotation SyntaxId
    - value SyntaxId

` Gives a local its cell and stores its first value there: the value written, converted to
` the type written for the local, or the value its type has when none is written. A local
` that holds nothing has no cell, and its value is evaluated for what it does. A local that
` holds a struct holds a copy of the one it is given. A tuple written in parentheses where
` the type goes is a pattern to TypeScript, which converts nothing and names what the pattern
` names, so a value of any other type has no rule here. A local that nested functions
` capture is stored in the environment that holds it. One some read tracks tells no read of
` its first value.
. slot = local-slot(name, id, true, false, true)
. offset = slot-offset(slot, id)
. type = facts.slot-type(unit.instance, offset)
if type == no-type || type == invalid-type
    refuse(.refused-statement, id)
    =
. layout = layout-of(type, id)
. initial = make-operand(.operand-void, 0)
if value != 0
    initial = declared-value(name, annotation, value, type).operand
else if layout != void-layout
    . defaulted = default-value(annotation, type, layout, id)
    initial = defaulted.operand
    if defaulted.type != type
        refuse(.refused-conversion, id)
if layout == void-layout
    =
if is-captured(slot)
    keep-captured(slot, initial, type, id)
    =
. local = ir.add-local(layout, (bindings.slots[slot].flags /and/ SlotFlag.slot-address-taken) != 0)
unit.cells[offset] = local
store-local(local, initial, id)

────────────────────
_ do declared-value Typed
    - name SyntaxId
    - annotation SyntaxId
    - value SyntaxId
    - type TypeId

` The value a declaration writes for a local, converted to the type written for the local,
` which is the type the local holds.
. initial = emit-expression(value)
if annotation != 0
    initial = convert(annotation, .reason-declaration, initial, name)
if initial.type != type
    refuse(.refused-conversion, value)
= initial

────────────────────
_ do default-value Typed
    - annotation SyntaxId
    - type TypeId
    - layout LayoutId
    - id SyntaxId

` The value a local has when its declaration writes none: the zero of a number, the empty
` text, the null pointer, an optional that holds nothing, a tuple with no name as it is with
` nothing written, or what the constructor the type pass chose at the local's type makes, and
` for a union none was chosen for, its first case (`first-case`).
. nothing = make-operand(.operand-void, 0)
if types.is-optional(type) && (tables.layouts.is-struct(layout) || is-null-form(type))
    = empty-optional(type, layout)
if is-plain-tuple(type) && tables.layouts.is-struct(layout)
    = null-value(type, layout, id)
if intrinsic(type) == .cpointer && (layout == pointer-layout || layout == managed-layout)
    = Typed(integer(layout as MachineKind, 0), type)
if type == types.null-type
    =? Typed(integer(layout as MachineKind, 0), type) if layout == pointer-layout || layout == managed-layout
    = Typed(nothing, type)
if is-numeric-type(type) || type == types.bool-type
    if is-float(layout)
        = Typed(float-number(layout, 0.0), type)
    = Typed(integer(tables.layouts.kind-of(layout), 0), type)
if type == types.string-type
    = Typed(make-operand(.operand-constant, ir.add-string("")), type)
. fact = if annotation == 0 then no-fact else facts.first-call(unit.reading, annotation)
if fact == no-fact && tables.layouts.is-union(layout)
    = first-case(type, layout, id)
if fact == no-fact || facts.calls[fact].next != no-fact || other-form
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
.. other-form = facts.calls[fact].form != .call-this-constructor
= emit-fact-call(annotation, facts.calls[fact], 0, RowRange'SyntaxId(), 0, 0, type)

────────────────────
_ do first-case Typed ?! Refused
    - type TypeId
    - layout LayoutId
    - id SyntaxId

` The first case of a union, holding the value a local of the case's type has with nothing
` written, as the reference's `defaultValue` of a union gives it; a case that holds nothing
` has nothing set.
if tables.layouts.rows[layout].cases.count == 0
    refuse(.refused-statement, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. field = tables.layouts.case-field(layout, 0)
if field.layout == void-layout
    . made = frame(layout)
    zero(made, layout)
    = Typed(made, type)
. held = default-value(0, field.type, field.layout, id)
= make-union(id, type, 0, held)

────────────────────
_ do local-slot SlotId
    - name SyntaxId
    - site SyntaxId
    - shared Bool = false
    - item Bool = false
    - tracked Bool = false

` The slot of a local a name declares or is assigned through, or of an argument it is assigned
` through, when it is one a cell holds: nothing captures it or tracks it. `shared` takes
` one that nested functions capture too, which an environment holds, and so a lazy local
` an environment holds. Any other lazy local is declared where its value is being evaluated.
` `item` takes instead a name the pattern of a loop writes for a field of its item, and
` `tracked` one some read tracks, for a declaration or an assignment, which tells the reads.
. binding = instances.rows[unit.reading].binding
. unkept = if shared then SlotFlag.slot-tracked else captured-tracked
    .. captured-tracked = SlotFlag.slot-captured /or/ SlotFlag.slot-tracked
if tracked
    unkept = unkept /and/ SlotFlag.slot-captured
if binding != no-binding && unit.reading == unit.instance
    do match? tree.nodes[name]
        | .node-identifier
            . resolution = bindings.resolution-of(binding, name)
            if resolution.kind == .resolve-slot
                . row = bindings.slots[resolution.slot]
                . is-held = row.kind == .slot-local || row.kind == .slot-argument
                if item
                    is-held = row.kind == .slot-loop-item
                if row.kind == .slot-lazy
                    is-held = shared && bindings.lazy-policy(resolution.slot) == .lazy-shared
                    for open in lazy-open
                        if open == resolution.slot
                            is-held = true
                if is-held && (row.flags /and/ unkept) == 0
                    = resolution.slot
refuse(.refused-statement, site)
= unit.slot-start

────────────────────
_ do assigned-lazy SlotId
    - name SyntaxId

` The slot of a lazy local a name is assigned through, when a flag of this function says
` whether the local has its value.
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    = no-slot
do match? tree.nodes[name]
    | .node-identifier
        . resolution = bindings.resolution-of(binding, name)
        if resolution.kind != .resolve-slot || !is-own-slot(resolution.slot)
            = no-slot
        if bindings.slots[resolution.slot].kind != .slot-lazy
            = no-slot
        if unit.lazy-flags[resolution.slot - unit.slot-start] != no-local
            = resolution.slot
= no-slot

────────────────────
_ do emit-assign Assignment ?! Refused
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` Stores a value in a local or a global: the one written, or for an assigning operator what its
` operator gives for the place and the value, in the way the type pass planned it. The value takes
` the conversion recorded for the store, and the store answers it with the value given
` (`Assignment`). A lazy global assigned is marked as having its value, which is then never
` evaluated. An assigning operator that a function of its own name answers stores nothing, unless
` the type pass planned its answer to be stored. A field is assigned in its own way, and so are the
` locals a tuple is taken apart into, the flag of a domain of styles, and a name of an object that
` declares a style for it. A local of no size, as a `Void` is, keeps nothing: its value is evaluated
` and goes nowhere. An array stored over an array where the value or the place is a link of an
` optional chain has no shape here: the runtime is told of no replaced storage there. A store to a
` local some read tracks runs the actions that read it where its bits change, as `watches` says,
` those of a struct against a copy taken before the store: a lazy one only where it had its value,
` since no action can read it before.
. chains = (is-chained(rhs) && !is-pinned(rhs)) || (is-link(lhs) && !is-pinned(receiver-of(lhs)))
if chains && facts.is-replacing(unit.reading, id)
    refuse(.refused-statement, id)
    = Assignment()
if is-chained(rhs) && !is-pinned(rhs)
    emit-withheld(id, op, lhs, rhs, false)
    = Assignment()
if is-link(lhs) && !is-pinned(receiver-of(lhs))
    emit-chained-assign(id, op, lhs, rhs)
    = Assignment()
. answered = op != .eq-op && assigning-call(lhs) != no-fact
. plan = facts.plan-of(unit.reading, id)
if answered && plan != .plan-store-answer
    emit-assigning-call(id, assigning-call(lhs), lhs, rhs)
    = Assignment()
do match? tree.nodes[lhs]
    | .node-style-read-expression(row)
        emit-style-write(id, row.object, rhs)
        = Assignment()
    | .node-get-expression(row)
        . styled = facts.style-write-of(unit.reading, id)
        if styled
            emit-style-assign(id, row.object, rhs, styled)
            = Assignment()
        if facts.plan-of(unit.reading, lhs) == .plan-view
            = emit-view-field-assign(id, op, lhs, row.object, rhs)
        if facts.plan-of(unit.reading, lhs) == .plan-table
            = emit-table-field-assign(id, op, lhs, row.object, rhs)
        = emit-field-assign(id, op, lhs, row.object, rhs)
    | .node-index-expression(row)
        if facts.plan-of(unit.reading, lhs) == .plan-view
            = emit-view-index-assign(id, op, lhs, row.object, row.index, rhs)
        if facts.plan-of(unit.reading, lhs) == .plan-table
            if op != .eq-op
                refuse(.refused-statement, id)
                = Assignment()
            if table-op(lhs) == TableOp.table-item-store
                emit-table-item-store(lhs, row.object, row.index, rhs)
                = Assignment()
            if table-op(lhs) == TableOp.table-range-store
                emit-table-range-store(lhs, row.object, row.index, rhs)
                = Assignment()
            emit-table-store(lhs, row.object, row.index, rhs)
            = Assignment()
        if facts.plan-of(unit.reading, lhs) == .plan-item
            = emit-item-assign(id, op, lhs, row.object, row.index, rhs)
        . stores = own-call(lhs)
        if op == .eq-op && stores != no-fact && facts.plan-of(unit.reading, lhs) == .plan-array-item
            = emit-array-store(lhs, facts.calls[stores].callee, row.object, row.index, rhs)
        if op == .eq-op && stores != no-fact && facts.calls[stores].form != .call-setter
            = emit-index-store(lhs, facts.calls[stores], row.object, row.index, rhs)
        . reached = !chains-at(lhs, row.is-optional) || is-pinned(row.object)
        if op != .eq-op && reached && facts.plan-of(unit.reading, lhs) == .plan-answer-item
            emit-item-answer(lhs, row.object, row.index, rhs)
            = Assignment()
        if op != .eq-op && reached && call-at(lhs, .call-operator) != no-fact
            = emit-index-update(lhs, op, row.object, row.index, rhs)
        = emit-field-assign(id, op, lhs, row.object, rhs)
    | .node-tuple-syntax(row)
        if op == .eq-op
            emit-destructure(id, row.items, rhs, false)
            = Assignment()
    | .node-identifier
        . styled = facts.style-write-of(unit.reading, id)
        if styled
            emit-style-assign(id, 0, rhs, styled)
            = Assignment()
        if is-own-field(lhs) || is-case-member(lhs)
            = emit-field-assign(id, op, lhs, 0, rhs)
        . setter = own-call(lhs)
        if setter != no-fact && facts.calls[setter].form == .call-setter && op == .eq-op
            emit-module-setter(lhs, rhs, facts.calls[setter])
            = Assignment()
        if op != .eq-op && call-at(lhs, .call-store-setter) != no-fact
            = emit-setter-update(id, op, lhs, 0, rhs, false)
. kept = assigned-global(lhs, id)
. local = no-local
. target = no-type
. memory = make-operand(.operand-void, 0)
. shared = no-slot
. written = no-local
. watched = no-slot
if kept == no-storage
    . slot = assigned-lazy(lhs)
    if slot == no-slot
        slot = local-slot(lhs, id, true, false, true)
    . offset = slot-offset(slot, id)
    if watches(slot, id)
        watched = slot
    if is-captured(slot)
        shared = slot
        target = find-captured(slot, id).type
    else
        target = facts.slot-type(unit.instance, offset)
        if unit.lazy-flags[offset] != no-local
            written = unit.lazy-flags[offset]
            if unit.cells[offset] == no-local && target != no-type && target != invalid-type
                . taken = (bindings.slots[slot].flags /and/ SlotFlag.slot-address-taken) != 0
                unit.cells[offset] = ir.add-local(layout-of(target, id), taken)
        local = unit.cells[offset]
        if local == no-local && layout-of(target, id) != void-layout
            memory = argument-memory(slot, target, id)
else
    target = tables.storage[kept].type
. given = Typed(make-operand(.operand-void, 0), no-type)
. base = increment-base(op)
if op == .eq-op
    given = emit-expression(rhs)
else if answered
    given = emit-assigning-call(id, assigning-call(lhs), lhs, rhs)
else if base && base == .concat-op
    given = emit-concat(id, lhs, rhs, false)
else if base && plan == .plan-builtin
    given = emit-builtin(id, base, lhs, rhs, true)
else if base && plan == .plan-call
    given = emit-operator-call(id, lhs, rhs, .plan-call, true)
else
    refuse(.refused-statement, id)
. converted = convert(id, .reason-assignment, given)
. value = converted.operand
if converted.type != target
    refuse(.refused-conversion, id)
    = Assignment()
. assignment = Assignment(converted, given)
if facts.is-replacing(unit.reading, id)
    . old = memory
    if shared != no-slot
        old = read-captured(shared, id, target).operand
    else if kept != no-storage
        old = load-global(tables.storage[kept], id).operand
    else if local != no-local
        old = load-local(local, id)
    replace-storage(id, old, target, given.operand, given.type)
. prior = make-operand(.operand-void, 0)
. armed = make-operand(.operand-void, 0)
if watched != no-slot
    if local == no-local && shared == no-slot
        refuse(.refused-statement, id)
        = Assignment()
    prior = if shared != no-slot then read-captured(shared, id, target).operand else load-local(local, id)
    . held = layout-of(target, id)
    if tables.layouts.is-struct(held)
        . saved = frame(held)
        copy(saved, prior, held, false, id)
        prior = saved
    if written != no-local
        armed = load-local(written, id)
if shared != no-slot
    if fills-share() && !filling.storing && bindings.slots[shared].kind == .slot-lazy
        refuse(.refused-statement, id)
        = Assignment()
    keep-captured(shared, value, target, id)
    if bindings.slots[shared].kind == .slot-lazy && !task-holds(shared)
        settle-shared(shared, id)
    if watched != no-slot
        dispatch-local(watched, prior, read-captured(shared, id, target).operand, target, id)
    = assignment
if kept == no-storage && local == no-local
    if layout-of(target, id) != void-layout
        copy(memory, value, layout-of(target, id), false, id)
    = assignment
if kept == no-storage
    store-local(local, value, id)
    if written != no-local
        store-local(written, integer(.machine-u8, 1), id)
    if watched != no-slot
        dispatch-local(watched, prior, load-local(local, id), target, id, armed)
    = assignment
. global = tables.storage[kept]
store-global(global, value, id)
if tables.global-kind(global.module, global.decl) == .global-lazy
    store-release(make-operand(.operand-symbol, global.state), 0, integer(.machine-u8, 1), id)
= assignment

────────────────────
_ do emit-style-assign
    - id SyntaxId
    - object SyntaxId
    - rhs SyntaxId
    - row StyleWrite

` An assignment that declares a style for an object, as the reference's
` `compileImperativeStyleWrite` makes one: the value, converted as assigned, then the object,
` cast to the runtime's `Pointer`, with the record of the property's style, given to the
` runtime's declaration at the imperative layer, by a holder where the runtime holds a handle
` to the value (`author-value`). The object is `this` where none is written, the receiver of
` the function, or the object a value of its class is evaluated for.
if object == 0 && !unit.has-self
    refuse(.refused-statement, id)
    =
. value = convert(id, .reason-assignment, emit-expression(rhs))
. subject = Typed(unit.self, if unit.reading != unit.instance then instances.rows[unit.reading].self-type else unit.owner-type)
if object != 0
    subject = emit-expression(object)
. pointer = style-subject(id, subject.operand, subject.type)
. runtime = facts.style-runtime
. index = style-number(id, row.style)
. property = facts.style-properties[row.property]
. mark = pending.length
pending += integer(.machine-u64, index)
. info = call-instance(runtime.info-required, id, mark)
. head [Operand]
head += pointer
head += info.operand
head += integer(.machine-u64, row.property - tables.style-uses[index].first)
if holds-style-handle(property.type)
    author-value(id, property.type, value.operand, head, runtime.imperative, runtime.imperative-object)
    =
. none = none-flag(id, property.type, value.operand)
. bits = style-bits(id, property.type, value.operand)
call-bits(id, head, bits, none.operand, runtime.imperative)

────────────────────
_ do argument-memory Operand
    - slot SlotId
    - type TypeId
    - id SyntaxId

` The memory of an argument that is a struct, which the function owns and which has no cell:
` an assignment to the argument copies the value there.
. nothing = make-operand(.operand-void, 0)
if !is-own-slot(slot) || bindings.slots[slot].kind != .slot-argument
    refuse(.refused-statement, id)
    = nothing
. position = argument-position(slot)
. index = if unit.takes-self then position + 1 else position
. layout = layout-of(type, id)
. passed = instances.argument-type(unit.instance, position) == type && index < ir.arguments.length
if !passed || !tables.layouts.is-struct(layout) || (ir.arguments[index] as LayoutId) != layout
    refuse(.refused-statement, id)
    = nothing
= make-operand(.operand-argument, index)

────────────────────
_ do assigned-global U32
    - lhs SyntaxId
    - id SyntaxId

` The storage of the global an assignment names, or none when it names something else. A
` global with no storage has no shape here.
. binding = instances.rows[unit.reading].binding
if binding == no-binding
    = no-storage
do match? tree.nodes[lhs]
    | .node-identifier
        . resolution = bindings.resolution-of(binding, lhs)
        if resolution.kind == .resolve-global
            . row = tables.storage-of(resolution.module, resolution.decl)
            if row == no-storage
                refuse(.refused-statement, id)
            = row
= no-storage

────────────────────
_ do assigning-call FactId
    - lhs SyntaxId

` The call of an assigning operator that a function of its own name answers, which the type
` pass records as an operator's call at the place assigned. No fact when the operator is not
` such a one.
do match? tree.nodes[lhs]
    | .node-index-expression
        = no-fact
. fact = own-call(lhs)
if fact == no-fact || facts.calls[fact].form != .call-operator
    = no-fact
= fact

────────────────────
_ do emit-assigning-call Typed
    - id SyntaxId
    - fact FactId
    - lhs SyntaxId
    - rhs SyntaxId

` An assigning operator that a function of its own name answers: the function is called on
` what the place holds with the value. A struct or a tuple is given as the place itself, so the
` function reads what the place holds when it is called, after the value is evaluated; a
` number or an object is read before. Nothing is stored here: where the type pass planned the
` answer to be stored, the assignment that called for it stores it.
. nothing = make-operand(.operand-void, 0)
. left = emit-expression(lhs)
. left-type = left.type
. right = emit-expression(rhs)
. right-type = right.type
= call-operator(id, fact, lhs, left.operand, left-type, rhs, right.operand, right-type)

────────────────────
_ do emit-field-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId

` An assignment to a field. A struct's field is stored in place: at its address inside the
` local, or inside the field, that holds the struct, or inside the receiver when no object is
` written. A tuple's field is stored only by its own constructor, which is making it: any
` other assignment gives a new tuple, which a statement drops. A property of an object is
` assigned in its own way. A store into a struct that an object holds has no shape yet when
` it writes a managed pointer. The value is evaluated before the object, as TypeScript does. An assigning operator whose answer
` the type pass planned to be stored stores it as any value, and has no shape in a tuple's
` field. A value named alone that a getter answers has no shape here unless it is an object. A
` struct that lies in storage, as `places-item` finds it, is stored where it lies, a managed
` pointer through the write barrier, as TypeScript stores once it has inlined what reads it;
` any other struct an index answered by a function gave has no shape here, since TypeScript
` stores into a copy of it. A field of the case of a row a name stands for is written in its
` cell, and so is one named alone in a member that runs on the case.
. cursor = if object != 0 then case-cursor-of(object) else this-cursor
if cursor != U32.max
    . named = member-name(lhs)
    . field = case-field(cursor, named) if named
    if !field
        refuse(.refused-statement, id)
        = Assignment()
    = emit-case-field-assign(id, op, lhs, cursor, field, rhs)
if object != 0 && is-getter-name(object) && !tables.is-class(held-type(object))
    refuse(.refused-statement, id)
    = Assignment()
if facts.plan-of(unit.reading, lhs) == .plan-forward
    emit-forward-set(id, op, lhs, object, rhs)
    = Assignment()
if op != .eq-op && call-at(lhs, .call-store-setter) != no-fact
    = emit-setter-update(id, op, lhs, object, rhs, true)
. owner = if object == 0 then unit.owner-type else held-type(object)
if owner != no-type && owner != invalid-type && tables.is-class(owner)
    = emit-property-assign(id, op, lhs, object, rhs, owner)
. setter = own-call(lhs)
if setter != no-fact && facts.calls[setter].form == .call-setter && op == .eq-op
    emit-setter(lhs, object, rhs, facts.calls[setter])
    = Assignment()
if owner == no-type || owner == invalid-type || !is-stored(owner, object)
    if facts.plan-of(unit.reading, id) == .plan-store-answer
        refuse(.refused-statement, id)
        = Assignment()
    emit-update(id, op, lhs, rhs)
    = Assignment()
. placed = object != 0 && places-item(object)
if object != 0 && !placed && through-answer(object)
    refuse(.refused-statement, id)
    = Assignment()
. layout = layout-of(owner, id)
. position = field-position(lhs, owner)
if !tables.layouts.is-struct(layout) || position >= tables.layouts.rows[layout].fields.count
    refuse(.refused-statement, id)
    = Assignment()
if managed-field && !is-framed(object) && !placed
    refuse(.refused-statement, id)
    = Assignment()
.. managed-field = tables.layouts.rows[tables.layouts.field(layout, position).layout].is-managed
. given = Typed(make-operand(.operand-void, 0), no-type)
. increment = increment-base(op)
. site = id
do match? tree.nodes[lhs]
    | .node-index-expression
        site = lhs
. stores-answer = facts.plan-of(unit.reading, site) == .plan-store-answer
if op == .eq-op
    . made = emit-expression(rhs)
    given = Typed(apart(made, rhs, object != 0 && !is-inert(object)), made.type)
else if stores-answer && assigning-call(lhs) != no-fact && (object == 0 || is-place(object))
    given = emit-assigning-call(site, assigning-call(lhs), lhs, rhs)
else if increment && builtin-plan && (object == 0 || is-place(object) || placed)
    given = emit-builtin(site, increment, lhs, rhs, true)
else
    refuse(.refused-statement, id)
.. builtin-plan = facts.plan-of(unit.reading, site) == .plan-builtin
. converted = convert(site, .reason-assignment, given)
. value = converted.operand
if converted.type != field-type(owner, position)
    refuse(.refused-conversion, id)
    = Assignment()
. assignment = Assignment(converted, given)
. base = if object == 0 then unit.self else if placed then place-of(object).operand else emit-expression(object).operand
if facts.is-replacing(unit.reading, id)
    replace-storage
        - id
        - take(base, tables.layouts.field(layout, position), id)
        - field-type(owner, position)
        - given.operand
        - given.type
if placed
    put-lent(base, tables.layouts.field(layout, position), value, id)
else
    put(base, tables.layouts.field(layout, position), value, id)
= assignment

────────────────────
_ do is-getter-name Bool
    - id SyntaxId

` Whether an expression is a name alone that a getter answers.
do match? tree.nodes[id]
    | .node-identifier
        = reads-getter(id)
= false

────────────────────
_ do emit-property-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId
    - owner TypeId
    - received Bool = false

` An assignment to a property of an object: of the value written before the property's
` name, or of the receiver when none is, or where the name alone is `received`, of the markup
` element `received-object` finds. A setter is called with the value. A stored
` property is stored at its place in the object: a managed pointer through the write
` barrier, and a struct by a copy. A lazy property is stored the same way and marked as
` having its value, which is then never evaluated. The value is evaluated before the object,
` as TypeScript does. An assigning operator reads the property first and then stores it, so
` its object is read twice. A tracked property runs the actions that read it where the store changed it.
. name = member-name(lhs)
. setter = own-call(lhs)
if setter != no-fact && facts.calls[setter].form == .call-setter && op == .eq-op
    emit-setter(lhs, object, rhs, facts.calls[setter])
    = Assignment()
. found = property-of(owner, name) if name
. held = tables.layouts.objects[owner]
if !found || held == no-layout
    refuse(.refused-statement, id)
    = Assignment()
. property = types.properties[found]
. is-lazy = property.storage-kind == .storage-lazy
if property.storage-kind != .storage-eager && !is-lazy
    refuse(.refused-statement, id)
    = Assignment()
. field = tables.layouts.field(held, object-header-fields + property.slot)
. flag-offset U32
if is-lazy
    if !tables.layouts.is-struct(field.layout)
        refuse(.refused-statement, id)
        = Assignment()
    . pair = field
    . inner = tables.layouts.field(pair.layout, 0)
    flag-offset = pair.offset + tables.layouts.field(pair.layout, 1).offset
    field = LayoutField(pair.offset + inner.offset, inner.layout)
if op == .eq-op && object == 0 && !received && !is-lazy
    . updated = emit-own-update(id, lhs, rhs, owner, property, field)
    if updated
        = updated
. given = Typed(make-operand(.operand-void, 0), no-type)
. increment = increment-base(op)
. plan = facts.plan-of(unit.reading, id)
if op == .eq-op
    . made = emit-expression(rhs)
    given = Typed(apart(made, rhs, object != 0 && !is-inert(object)), made.type)
else if plan == .plan-store-answer
    given = emit-assigning-call(id, assigning-call(lhs), lhs, rhs)
else if increment
    if increment == .concat-op
        given = emit-concat(id, lhs, rhs, false)
    else if plan == .plan-builtin
        given = emit-builtin(id, increment, lhs, rhs, true)
    else if plan == .plan-call
        given = emit-operator-call(id, lhs, rhs, .plan-call, true)
    else
        refuse(.refused-statement, id)
else
    refuse(.refused-statement, id)
. converted = convert(id, .reason-assignment, given)
. value = converted.operand
if converted.type != property.type
    refuse(.refused-conversion, id)
    = Assignment()
. assignment = Assignment(converted, given)
. base = if received then received-object(lhs, name!).operand else if object == 0 then unit.self else emit-expression(object).operand
if facts.is-replacing(unit.reading, id)
    if is-lazy
        refuse(.refused-statement, id)
        = Assignment()
    replace-storage(id, take(base, field, id), property.type, given.operand, given.type)
put-property
    - base
    - field
    - property
    - value
    - id
    - if is-lazy then flag-offset else U32.max
    - false
    - memo-flag-of(owner, property)
= assignment

────────────────────
_ do emit-own-update Assignment?
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - owner TypeId
    - property TypeProperty
    - field LayoutField

` An assignment to a field of the receiver that holds a tuple, of that tuple with one of its
` own fields assigned, as `frame = frame.depth = 2` is: the one field is stored where it lies
` inside the receiver, since the tuple stored would differ from the old one only there. The
` assignment gives the tuple as it then lies. Nothing is emitted where the assignment is other
` than that, or where the field stores more than its bits: one some read tracks, a memo, or
` storage the assignment replaces.
. named = member-name(lhs)
if !named || !tables.layouts.is-struct(field.layout) || tracks(property)
    = null
if memo-flag-of(owner, property) != U32.max || facts.is-replacing(unit.reading, id)
    = null
if facts.is-replacing(unit.reading, rhs) || tables.live-statement-of(unit.reading, rhs)
    = null
if facts.node-type(unit.reading, rhs) != property.type
    = null
. target SyntaxId = 0
. value SyntaxId = 0
do match? tree.nodes[rhs]
    | .node-assign(row)
        if row.op == .eq-op && !is-chained(row.rhs)
            target = row.lhs
            value = row.rhs
=? null if target == 0
. object SyntaxId = 0
. member Atom? = null
do match? tree.nodes[target]
    | .node-get-expression(row)
        if !row.is-optional
            object = row.object
            member = row.name
=? null if object == 0 || !member
. same = false
do match? tree.nodes[object]
    | .node-identifier(row)
        same = row.name == named && is-own-field(object)
. plan = facts.plan-of(unit.reading, rhs)
if !same || plan == .plan-extend || plan == .plan-truncate || stores-place(target)
    = null
. found = property-of(property.type, member)
if !found || types.properties[found].storage-kind != .storage-eager
    = null
. position = types.properties[found].slot
if position >= tables.layouts.rows[field.layout].fields.count
    = null
. converted = convert(rhs, .reason-assignment, emit-expression(value))
if converted.type != field-type(property.type, position)
    refuse(.refused-conversion, rhs)
    = Assignment()
. base = field-value(unit.self, field, id)
put-lent(base, tables.layouts.field(field.layout, position), converted.operand, id)
. stored = Typed(base, property.type)
= Assignment(stored, stored)

────────────────────
_ member-name Atom?
    - lhs SyntaxId

` The name an assignment gives a property by: after an object, or alone.
match? tree.nodes[lhs]
    | .node-get-expression(row)
        row.name
    | .node-identifier(row)
        row.name

────────────────────
_ do emit-setter
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId
    - fact CallFact

` An assignment a setter answers: the setter is called on the object with the value, which
` takes the conversion recorded for an argument. The value is evaluated before the object.
. callee = fact.callee
if callee == no-instance || fact.is-partial || !is-callable(callee)
    refuse(.refused-statement, lhs)
    =
if instances.signatures[callee].args.count != 1
    refuse(.refused-statement, lhs)
    =
. made = emit-expression(rhs)
. converted = convert(rhs, .reason-argument, Typed(apart(made, rhs, object != 0 && !is-inert(object)), made.type))
. value = converted.operand
if converted.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, rhs)
    =
. receiver = emit-receiver(lhs, object)
if receiver.type != instances.rows[callee].self-type
    refuse(.refused-conversion, lhs)
. mark = pending.length
pending += receiver.operand
pending += value
call-method(callee, lhs, mark)

────────────────────
_ do emit-setter-update Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId
    - is-member Bool

` An assigning operator on a property, of an object or of a module, that a getter and a setter
` answer: the getter reads the value, the machine operation of numbers, the join of text or the
` function that answers the operator makes the new value of it and the value written, and the
` setter stores that, as the reference does. The reference evaluates the object for the read and
` again for the store, so only an object that names storage has a shape here, read once before
` the value for both calls.
. read = call-at(lhs, .call-getter)
. store = call-at(lhs, .call-store-setter)
. increment = increment-base(op)
. plan = facts.plan-of(unit.reading, id)
if read == no-fact || store == no-fact || !increment || other-plan || unplaced
    refuse(.refused-statement, id)
    = Assignment()
.. other-plan = increment != .concat-op && plan != .plan-builtin && plan != .plan-call
.. unplaced = object != 0 && !is-place(object)
. getter = facts.calls[read].callee
. setter = facts.calls[store].callee
if getter == no-instance || setter == no-instance || partial-call || uncallable
    refuse(.refused-statement, id)
    = Assignment()
.. partial-call = facts.calls[read].is-partial || facts.calls[store].is-partial
.. uncallable = !is-callable(getter) || !is-callable(setter)
if instances.signatures[getter].args.count != 0 || instances.signatures[setter].args.count != 1
    refuse(.refused-statement, id)
    = Assignment()
. receiver = make-operand(.operand-void, 0)
if is-member
    . received = emit-receiver(lhs, object, true)
    receiver = received.operand
    if received.type != instances.rows[getter].self-type || other-setter
        refuse(.refused-conversion, lhs)
    .. other-setter = received.type != instances.rows[setter].self-type
. read-mark = pending.length
if is-member
    pending += receiver
. current = if is-member then call-method(getter, lhs, read-mark) else call-instance(getter, lhs, read-mark)
. current-type = current.type
. value = current
if increment == .concat-op
    value = join-text(id, lhs, current.operand, current-type, rhs, false)
else if plan == .plan-builtin
    value = combine-builtin(id, increment, lhs, current.operand, current-type, rhs, true)
else
    . combined = answering(facts.first-call(unit.reading, id))
    if combined == no-fact || answering(facts.calls[combined].next) != no-fact
        refuse(.refused-statement, id)
        = Assignment()
    . given = emit-expression(rhs)
    . given-type = given.type
    value = call-operator(id, combined, lhs, current.operand, current-type, rhs, given.operand, given-type)
. computed = value
value = convert(id, .reason-assignment, value)
value = convert(lhs, .reason-argument, value)
if value.type != instances.argument-type(setter, 0)
    refuse(.refused-conversion, id)
    = Assignment()
. assignment = Assignment(value, computed)
. mark = pending.length
if is-member
    pending += receiver
pending += value.operand
if is-member
    call-method(setter, lhs, mark)
else
    call-instance(setter, lhs, mark)
= assignment

────────────────────
_ do emit-module-setter
    - lhs SyntaxId
    - rhs SyntaxId
    - fact CallFact

. callee = fact.callee
if callee == no-instance || fact.is-partial || !is-callable(callee)
    refuse(.refused-statement, lhs)
    =
if instances.signatures[callee].args.count != 1
    refuse(.refused-statement, lhs)
    =
. value = convert(rhs, .reason-argument, emit-expression(rhs))
if value.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, rhs)
    =
. mark = pending.length
pending += value.operand
call-instance(callee, lhs, mark)

────────────────────
_ do field-position U32
    - lhs SyntaxId
    - owner TypeId

` Which stored field the left side of an assignment names: by a constant index the type pass
` recorded, or by the name of a property the type stores.
do match? tree.nodes[lhs]
    | .node-index-expression
        . place = indexed-field(lhs)
        if place != no-fact
            = facts.constants[place].bits as U32
    | .node-get-expression(row)
        . found = property-of(owner, row.name)
        if found && types.properties[found].storage-kind == .storage-eager
            = types.properties[found].slot
    | .node-identifier(row)
        . found = property-of(owner, row.name)
        if found && types.properties[found].storage-kind == .storage-eager
            = types.properties[found].slot
refuse(.refused-statement, lhs)
= 0

────────────────────
_ is-case-member Bool
    - name SyntaxId

` Whether a name is a member of the receiver, in a member that runs on the case of a row.
|? binding == no-binding || unit.reading != unit.instance || this-cursor == U32.max
    false
??
    bindings.resolution-of(binding, name).kind == .resolve-member

.. binding = instances.rows[unit.reading].binding

────────────────────
_ is-own-field Bool
    - name SyntaxId

` Whether a name is a field of the receiver, in a member of a struct or of a class, or in
` the constructor of a tuple, or in a rule of a class run on the object being made.
|? binding == no-binding || (unit.reading != unit.instance && !unit.running-rule) || !unit.has-self
    false
|? !is-stored(owner, 0) && !tables.is-class(owner)
    false
??
    bindings.resolution-of(binding, name).kind == .resolve-member

.. binding = instances.rows[unit.reading].binding
.. owner = unit.owner-type

────────────────────
_ is-stored Bool
    - owner TypeId
    - object SyntaxId

` Whether an assignment to a field of a type stores it in place: a struct's, or that of the
` tuple a constructor is making, written by its name alone.
is-mutable-value(owner) || (object == 0 && builds && intrinsic(owner) == .tuple)

────────────────────
_ is-mutable-value Bool
    - type TypeId

` Whether a value's fields are changed in place: a struct's.
intrinsic(type) == .struct

────────────────────
_ do is-framed Bool
    - id SyntaxId

` Whether an expression names memory of the frame: a local or an argument that holds a tuple
` or struct, the receiver that is one, or a field of any of them. No syntax is the receiver.
if id == 0
    = true
. type = facts.node-type(unit.reading, id)
if type == no-type || type == invalid-type || !is-aggregate(type)
    = false
. binding = instances.rows[unit.reading].binding
do match? tree.nodes[id]
    | .node-identifier
        if binding == no-binding || unit.reading != unit.instance
            = false
        . resolution = bindings.resolution-of(binding, id)
        if resolution.kind == .resolve-slot
            . kind = bindings.slots[resolution.slot].kind
            = kind == .slot-local || kind == .slot-argument || kind == .slot-this
        = resolution.kind == .resolve-member && is-stored(unit.owner-type, 0) && is-own-field(id)
    | .node-get-expression(row)
        = is-framed(row.object)
    | .node-index-expression(row)
        = names-field(id) && is-framed(row.object)
= false

────────────────────
_ names-field Bool
    - id SyntaxId

` Whether an index names a stored field of its object, by the constant the type pass
` recorded. One a function answers gives a value of its own, which names no storage.
indexed-field(id) != no-fact && own-call(id) == no-fact && facts.plan-of(unit.reading, id) != .plan-item

────────────────────
_ do through-answer Bool
    - id SyntaxId

` Whether a struct is read from what an index answered by a function gave, itself or as a
` field of it. A store into it would change a value nothing names. A property of an object
` is stored in the object, wherever the object came from.
do match? tree.nodes[id]
    | .node-get-expression(row)
        . owner = facts.node-type(unit.reading, row.object)
        if owner == no-type || owner == invalid-type || tables.is-class(owner)
            = false
        = through-answer(row.object)
    | .node-index-expression(row)
        if !names-field(id)
            = true
        = through-answer(row.object)
= false

────────────────────
_ do places-item Bool
    - id SyntaxId

` Whether a struct a store goes into is one that lies in storage, as TypeScript finds it once
` it has inlined what reads it: an item past a pointer, what an index answers by a function
` written `@inline` as an expression, or a struct stored in either.
do match? tree.nodes[id]
    | .node-get-expression(row)
        . owner = facts.node-type(unit.reading, row.object)
        if owner == no-type || owner == invalid-type || !is-mutable-value(owner) || is-link(id)
            = false
        if facts.plan-of(unit.reading, id) != .plan-none || own-call(id) != no-fact
            = false
        = places-item(row.object)
    | .node-index-expression(row)
        if is-link(id)
            = false
        if facts.plan-of(unit.reading, id) == .plan-item
            = true
        . fact = own-call(id)
        if fact == no-fact || facts.plan-of(unit.reading, id) != .plan-none
            = false
        . callee = facts.calls[fact].callee
        = callee != no-instance && inlined-answer(callee) != 0
= false

────────────────────
_ do place-of Typed ?! Refused
    - id SyntaxId

` Where a struct that `places-item` finds in storage lies, for a store into a field of it.
do match? tree.nodes[id]
    | .node-get-expression(row)
        . base = place-of(row.object)
        . owner = base.type
        = load-property(id, base.operand, owner, row.name)
    | .node-index-expression(row)
        if facts.plan-of(unit.reading, id) == .plan-item
            = item-place(id, row.object, row.index)
        = place-index-call(id, facts.calls[own-call(id)], row.object, row.index)
refuse(.refused-statement, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do item-place Typed
    - id SyntaxId
    - object SyntaxId
    - index SyntaxId

` The struct an index names past a pointer, where it lies: the pointer is evaluated before the
` index, as for a read, and nothing is copied.
. place = item-address(id, object, index)
. type = tables.layouts.pointee-type(place.type)
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout)
    refuse(.refused-expression, id)
    = place
= Typed(address(place.operand, 0, layout, id), type)

────────────────────
_ do inlined-answer SyntaxId
    - callee InstanceId

` The body of a member written `@inline` as an expression, which a store into what it answers
` runs where the store is, as TypeScript inlines it: 0 for any other function.
. row = instances.rows[callee]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        . is-member = fn.kind == .function-decl || fn.kind == .getter-decl
        if fn.is-generated || fn.is-static || fn.owner == 0 || !is-member
            = 0
        do match? program.modules[row.module].tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                if syntax.is-inline && !syntax.imperative
                    = syntax.body
= 0

────────────────────
_ do inlined-static-answer SyntaxId
    - callee InstanceId

` The body of a function with no receiver, a static one or one declared alone, written `@inline`
` as an expression, which a store into what it answers runs where the store is, as TypeScript
` inlines it: 0 for any other function.
if callee == no-instance
    = 0
. row = instances.rows[callee]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.is-generated || fn.kind != .function-decl || (!fn.is-static && fn.owner != 0)
            = 0
        do match? program.modules[row.module].tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                if syntax.is-inline && !syntax.imperative
                    = syntax.body
= 0

────────────────────
_ do is-inline Bool
    - callee InstanceId

` Whether a function is written `@inline`, which TypeScript runs where it is called.
. row = instances.rows[callee]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        do match? program.modules[row.module].tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                = syntax.is-inline
= false

────────────────────
_ answers-copy Bool
    - id SyntaxId

` Whether a call gives what a function answers in memory of the call's own, which nothing else
` names, as TypeScript's does where it calls the function: one it calls by itself, not through a
` witness table, that is not written `@inline`.
|? fact == no-fact
    false
|? !direct || row.is-partial || row.callee == no-instance || !is-callable(row.callee)
    false
??
    !is-inline(row.callee) && !tables.is-prototype(row.callee)

.. fact = own-call(id)
.. row = facts.calls[fact]
.. direct = row.form == .call-function || row.form == .call-method || row.form == .call-static

────────────────────
_ do place-index-call Typed
    - id SyntaxId
    - fact CallFact
    - object SyntaxId
    - index SyntaxId

` Where the struct an index answers lies, for a store into a field of it, where the function
` that answers it is a member written `@inline` as an expression. The receiver and
` the key are evaluated as for the call, each with its conversion, and then the function's body
` runs here as TypeScript inlines it, with its own locals for the run and the key in its
` argument's: its answer is where the storage it names lies. A function that raises, keeps an
` environment, takes a struct, or runs in another zone has no shape here, and nor has one run
` where a value is pinned, since its syntax is of its own module.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
if callee == no-instance || fact.is-partial || !is-callable(callee) || out-of-order
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
.. out-of-order = !fills-in-order(fact, callee, 1)
. body = inlined-answer(callee)
. owner = instances.rows[callee].self-type
. answer = facts.node-type(unit.reading, id)
. closed = tables.environments[callee] != no-layout || is-free(callee) != in-zone || has-pins
    .. has-pins = pins.length != 0
if body == 0 || closed || instances.signatures[callee].errors.count != 0 || owner == no-type
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
if instances.signatures[callee].returns != answer || names-slot(object, .slot-super)
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = convert(index, .reason-argument, emit-expression(index))
if receiver-type != owner
    refuse(.refused-conversion, object)
    = Typed(nothing, no-type)
if key.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, index)
    = Typed(nothing, no-type)
. key-layout = layout-of(key.type, index)
if tables.layouts.is-struct(key-layout)
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
= run-inlined-place(callee, body, answer, receiver.operand, true, [key.operand], [key-layout], id)

────────────────────
_ do place-static-call Typed
    - id SyntaxId
    - fact CallFact
    - written RowRange'SyntaxId

` Where the struct a call answers lies, in an inlined body, where the function is one with no
` receiver written `@inline` as an expression, as `GCBacking.load` is. The arguments are
` evaluated in the order written, each with its conversion, and then the function's body runs
` here as TypeScript inlines it. A function that raises, keeps an environment, takes a struct or
` runs in another zone has no shape here, and nor has one run where a value is pinned.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
. count = written.count as U32
if callee == no-instance || fact.is-partial || !is-callable(callee) || out-of-order
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. out-of-order = !fills-in-order(fact, callee, count)
. body = inlined-static-answer(callee)
. answer = facts.node-type(unit.reading, id)
. closed = tables.environments[callee] != no-layout || is-free(callee) != in-zone || has-pins
    .. has-pins = pins.length != 0
if body == 0 || closed || instances.signatures[callee].errors.count != 0 || other-answer
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. other-answer = instances.signatures[callee].returns != answer
. given [Operand]
. layouts [LayoutId]
. evaluated U32
for argument in tree.children[written]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    evaluated += 1
    . made = emit-expression(expression)
    . value = convert
        - argument
        - .reason-argument
        - Typed(settled(made, expression, written, evaluated), made.type)
    if value.type != instances.argument-type(callee, evaluated - 1)
        refuse(.refused-conversion, argument)
        = Typed(nothing, no-type)
    . layout = layout-of(value.type, argument)
    if tables.layouts.is-struct(layout)
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    given += value.operand
    layouts += layout
= run-inlined-place(callee, body, answer, nothing, false, given, layouts, id)

────────────────────
_ do run-inlined-place Typed
    - callee InstanceId
    - body SyntaxId
    - answer TypeId
    - receiver Operand
    - receives Bool
    - given [Operand]
    - layouts [LayoutId]
    - site SyntaxId

` Runs the body of a function written `@inline` as an expression where a store into what it
` answers is, as TypeScript inlines it, with its own locals for the run, the receiver where it
` `receives` one, and each argument in its parameter's cell, and answers where the storage its
` answer names lies. Its syntax is of its own module.
. own-unit = unit
. run = enter-unit(callee)
unit = unit.source-module = instances.rows[callee].module
if receives
    unit = unit.self = receiver
unit = unit.has-self = receives
unit = unit.takes-self = receives
bind-inlined-arguments(given, layouts, site)
. place = make-operand(.operand-void, 0)
. last = ending(body)
if last == 0
    refuse(.refused-expression, body)
. answered = place-answer(last)
place = answered.operand
if answered.type != answer
    refuse(.refused-conversion, last)
leave-unit(run)
unit = own-unit
= Typed(place, answer)

────────────────────
_ do bind-inlined-arguments
    - given [Operand]
    - layouts [LayoutId]
    - site SyntaxId

` Gives each argument of a function run where it is called the cell that holds the value it was
` given. One that nested functions capture, or some read tracks, has no shape here.
for offset in 0 .. < unit.slot-count
    . slot = bindings.slots[unit.slot-start + offset]
    if slot.kind != .slot-argument || !owns(unit.slot-start + offset)
        continue
    if is-captured(unit.slot-start + offset) || (slot.flags /and/ SlotFlag.slot-tracked) != 0
        refuse(.refused-statement, site)
        =
    . position = argument-position(unit.slot-start + offset) as Size
    if position >= given.length
        refuse(.refused-statement, site)
        =
    . layout = layouts[position]
    if layout == void-layout
        continue
    . local = ir.add-local(layout, (slot.flags /and/ SlotFlag.slot-address-taken) != 0)
    unit.cells[offset] = local
    store-local(local, given[position], site)

────────────────────
_ do place-answer Typed ?! Refused
    - id SyntaxId

` Where the struct the body of a function run where it is called answers lies: an item past a
` pointer, a stored field of the receiver, what an index answers by a function this runs where
` it is called in turn, what a function with no receiver this runs where it is called answers,
` or for a match with no subject, the place each arm's answer gives. What `answers-copy` says a
` call gives lies where the call left it, which nothing else names, as TypeScript's store
` through it goes nowhere else.
. nothing = make-operand(.operand-void, 0)
do match? tree.nodes[id]
    | .node-index-expression(row)
        if !is-link(id) && facts.plan-of(unit.reading, id) == .plan-item
            = item-place(id, row.object, row.index)
        if !is-link(id) && places-item(id)
            = place-of(id)
    | .node-identifier(row)
        . found = property-of(unit.owner-type, row.name) if is-own-field(id)
        . eager = found && types.properties[found].storage-kind == .storage-eager
        if eager && own-call(id) == no-fact && facts.plan-of(unit.reading, id) == .plan-none
            = load-property(id, unit.self, unit.owner-type, row.name)
    | .node-call-expression(row)
        if answers-copy(id)
            = emit-expression(id)
        . fact = own-call(id)
        if fact != no-fact && facts.plan-of(unit.reading, id) == .plan-none && static-inline
            = place-static-call(id, facts.calls[fact], row.args)
        .. static-inline = inlined-static-answer(facts.calls[fact].callee) != 0
    | .node-structure-match(row)
        = place-match(id, row.pattern)
    | .node-match-expression(row)
        if row.subject == 0 && !row.is-optional && row.helper == 0
            do match? tree.nodes[row.body]
                | .node-structure-match(arms)
                    = place-match(id, arms.pattern)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do place-match Typed
    - id SyntaxId
    - pattern SyntaxId

` Where the struct a match with no subject answers lies, in an inlined body: its arms are tested
` in order, and the place the arm taken answers is the match's. Arms that end in no else have
` no shape here.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if pattern == 0 || !tables.layouts.is-struct(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. joined = ir.reserve-block()
. mark = joins.length
. is-closed = place-arms(pattern, type, joined)
if !is-closed
    refuse(.refused-expression, id)
. result = close-joins(joined, mark, layout, nothing)
= Typed(result, type)

────────────────────
_ do place-arms Bool ?! Refused
    - pattern SyntaxId
    - type TypeId
    - joined IRBlockId

` Tests the arms of a match in an inlined body in order, as `emit-arms` does, each taken arm
` leaving the place its answer gives for the match to join, and says whether an else ended them.
` An arm that raises has no shape here.
do match? tree.nodes[pattern]
    | .node-type-or(row)
        if place-arms(row.left, type, joined)
            = true
        = place-arms(row.right, type, joined)
    | .node-type-transform(row)
        . condition SyntaxId = 0
        . is-else = row.pattern == 0
        if !is-else
            do match? tree.nodes[row.pattern]
                | .node-type-wildcard
                    is-else = true
                | .node-type-predicate(predicate)
                    condition = predicate.expr
        if (!is-else && condition == 0) || facts.plan-of(unit.reading, pattern) == .plan-raise
            refuse(.refused-expression, pattern)
            = false
        if is-else
            place-arm(row.expr, type, joined)
            = true
        . given = emit-expression(condition)
        . given-type = given.type
        . tested = test(condition, given)
        . taken = ir.reserve-block()
        . passed = ir.reserve-block()
        branch(tested.operand, taken, passed)
        ir.start-block(taken)
        . named = bound.length
        . it-slot = arm-slot-of(pattern, .slot-it)
        if it-slot != no-slot
            bound += BoundValue(it-slot, given-type, given.operand)
        place-arm(row.expr, type, joined)
        drop-bound(named)
        ir.start-block(passed)
        = false
refuse(.refused-expression, pattern)
= false

────────────────────
_ do place-arm
    - body SyntaxId
    - type TypeId
    - joined IRBlockId

` Leaves the place the answer of an arm gives for its match, and goes to the join. A body
` written as a block runs its statements first, and one that opens a cleanup has no shape here.
. opens = is-block(body)
. mark = open-cleanups.length
. own-scoping = scoping
if opens
    scoping = scoping.block-base = mark
. last = ending(body)
if last == 0
    refuse(.refused-expression, body)
. place = make-operand(.operand-void, 0)
. answered = place-answer(last)
place = answered.operand
scoping = own-scoping
if open-cleanups.length != mark
    refuse(.refused-expression, body)
if answered.type != type
    refuse(.refused-conversion, body)
    =
joins += place
joins += make-operand(.operand-block, ir.current)
jump(joined)

────────────────────
_ do is-place Bool
    - id SyntaxId

` Whether an expression only names storage: a local, or a field of one, at a place a key that
` calls nothing gives, or one of those forced or cast where that calls nothing. Reading it twice
` does nothing twice, so a name a getter answers is not one.
do match? tree.nodes[id]
    | .node-identifier
        = !reads-getter(id)
    | .node-get-expression(row)
        = !reads-getter(id) && is-place(row.object)
    | .node-index-expression(row)
        = names-field(id) && is-place(row.object) && is-inert(row.index)
    | .node-unary-expression(row)
        . calls = facts.first-call(unit.reading, id) != no-fact
        = row.op == .optional-force-op && !calls && is-place(row.operand)
    | .node-cast-expression(row)
        = facts.first-call(unit.reading, id) == no-fact && is-place(row.lhs)
= false

────────────────────
_ do reads-getter Bool
    - id SyntaxId

` Whether the type pass recorded the call of a getter at a node, for the node's value.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == .call-getter
        = true
    fact = facts.calls[fact].next
= false

────────────────────
_ do stores-place Bool
    - lhs SyntaxId

` Whether an assignment stores into the place it names: a name that is no field, a field
` of an object or of a struct, or an item of a text, which is stored whole. A tuple's field
` is not one: assigning it gives a new tuple. A field of a row of a table or of an array, and
` one of the case of a row a name stands for, is one, kept in its cell.
. owner = no-type
. indexes = false
do match? tree.nodes[lhs]
    | .node-identifier
        if !is-own-field(lhs)
            = true
        owner = unit.owner-type
    | .node-get-expression(row)
        . plan = facts.plan-of(unit.reading, lhs)
        if case-cursor-of(row.object) != U32.max || plan == .plan-view || plan == .plan-table
            = true
        owner = facts.node-type(unit.reading, row.object)
    | .node-index-expression(row)
        owner = facts.node-type(unit.reading, row.object)
        indexes = true
if owner == no-type || owner == invalid-type
    = false
= tables.is-class(owner) || is-mutable-value(owner) || (indexes && intrinsic(owner) == .string)

────────────────────
_ do stores-by-call Bool
    - lhs SyntaxId

` Whether an index is assigned through the function that answers `[]=`, which stores the value
` wherever the object keeps it.
do match? tree.nodes[lhs]
    | .node-index-expression
        if facts.plan-of(unit.reading, lhs) == .plan-item
            = false
        . stores = own-call(lhs)
        = stores != no-fact && facts.calls[stores].form != .call-setter
= false

────────────────────
_ do emit-update Typed ?! Refused
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` What an assignment gives as a value. An assigning operator that a function answers gives
` what the function answers; where the type pass planned the answer to be stored it is stored
` first, and the value is the one stored, when storing it changed its type in no way. An
` assignment that stores into the place it names gives the value stored, as a copy when it
` is a struct, or the value as it was before the store converted it: whichever is of the
` type the type pass gave the assignment.
` An assignment to a tuple's field gives a new tuple: its fields are those of
` the old one, but for the one assigned, which an assigning operator gives from the field's
` value. An extension adds a field, and a truncation keeps
` the first. The old tuple is evaluated after the value assigned, as TypeScript evaluates it,
` and that value is kept apart from what evaluating it may change. A live statement has no
` shape here as a value.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. plan = facts.plan-of(unit.reading, id)
if tables.live-statement-of(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if is-chained(rhs) && !is-pinned(rhs) && facts.is-replacing(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if is-chained(rhs) && !is-pinned(rhs)
    = emit-withheld(id, op, lhs, rhs, true)
if is-link(lhs)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if op != .eq-op && plan == .plan-store-answer
    . assignment = emit-assign(id, op, lhs, rhs)
    if assignment.stored.type != type
        refuse(.refused-conversion, id)
        = Typed(nothing, no-type)
    = assignment.stored
if op != .eq-op && assigning-call(lhs) != no-fact
    . answer = emit-assigning-call(id, assigning-call(lhs), lhs, rhs)
    if answer.type != type
        refuse(.refused-conversion, id)
    = answer
if plan != .plan-extend && plan != .plan-truncate && places-store
    . assignment = emit-assign(id, op, lhs, rhs)
    . unconverted = assignment.stored.type != type && assignment.given.type == type
    . gives = if unconverted then assignment.given else assignment.stored
    if gives.type != type
        refuse(.refused-conversion, id)
        = Typed(nothing, no-type)
    . stored = layout-of(type, id)
    = if tables.layouts.is-struct(stored) then Typed(snapshot(gives.operand, stored, id), type) else gives
.. places-store = stores-place(lhs) || (op == .eq-op && stores-by-call(lhs))
. extends = plan == .plan-extend && op == .add-eq-op
. object = lhs
if !extends
    do match? tree.nodes[lhs]
        | .node-get-expression(row)
            object = row.object
        | .node-index-expression(row)
            object = row.object
    if object == lhs
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
. given = nothing
. given-type = no-type
. increment = increment-base(op)
if !extends && op != .eq-op && (!increment || plan != .plan-builtin)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if extends || plan != .plan-truncate
    . value = if extends || op == .eq-op then emit-expression(rhs) else emit-builtin(id, increment!, lhs, rhs, true)
    if !extends
        . site = id
        do match? tree.nodes[lhs]
            | .node-index-expression
                site = lhs
        value = convert(site, .reason-assignment, value)
    given = apart(value, rhs, !is-place(object))
    given-type = value.type
. source = emit-expression(object)
. owner = source.type
. held-layout = layout-of(owner, id)
. layout = layout-of(type, id)
if !tables.layouts.is-struct(held-layout) || !tables.layouts.is-struct(layout) || mutable-owner
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. mutable-owner = is-mutable-value(owner)
. held = tables.layouts.rows[held-layout].fields.count
. count = tables.layouts.rows[layout].fields.count
. position = U32.max
if extends
    position = held
else if plan != .plan-truncate
    position = field-position(lhs, owner)
if position != U32.max && (position >= count || given-type != field-type(type, position))
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. made = frame(layout)
for index in 0 .. < count
    . field = tables.layouts.field(layout, index)
    if index == position
        put(made, field, given, id)
        continue
    if index >= held || field-type(type, index) != field-type(owner, index)
        refuse(.refused-conversion, id)
        = Typed(nothing, no-type)
    put(made, field, take(source.operand, tables.layouts.field(held-layout, index), id), id)
= Typed(made, type)

────────────────────
_ do emit-if
    - id SyntaxId
    - condition SyntaxId
    - body SyntaxId
    - next SyntaxId

` A branch runs its body where its condition tests as true, and otherwise what follows it:
` another branch, or the body of an `else`, which is a branch with no condition. A branch the
` type pass found never taken evaluates its condition and goes on to what follows it.
if condition == 0
    if next != 0
        refuse(.refused-statement, next)
        =
    emit-block(body)
    =
if facts.plan-of(unit.reading, id) == .plan-never
    test(condition, emit-expression(condition))
    if next != 0
        emit-statement(next)
    =
. taken = ir.reserve-block()
. done = ir.reserve-block()
. other = if next == 0 then done else ir.reserve-block()
branch-on(condition, taken, other)
ir.start-block(taken)
emit-block(body)
jump(done)
if next != 0
    ir.start-block(other)
    emit-statement(next)
    jump(done)
ir.start-block(done)

────────────────────
_ do emit-while
    - id SyntaxId
    - condition SyntaxId
    - body SyntaxId

` A loop that runs its body for as long as its condition tests as true. Each pass polls
` before the test. The loop is one to leave or to go on with from its condition on: written
` with a pattern, its body runs in the arm of the match that is the condition. A turn
` whose locals nested functions capture has an environment of its own. A condition that
` opens a cleanup, reading a lazy local whose value is a `use`, has no shape: TypeScript
` runs that cleanup where the body ends, and not at all where the condition first fails.
. nothing = make-operand(.operand-void, 0)
. head = ir.reserve-block()
. inside = ir.reserve-block()
. done = ir.reserve-block()
jump(head)
ir.start-block(head)
emit-poll(id)
. open = open-cleanups.length
loops += EmittedLoop(id, head, done, nothing, no-type, open, no-slot)
branch-on(condition, inside, done)
if open-cleanups.length != open
    refuse(.refused-expression, condition)
ir.start-block(inside)
. turns = open-turns.length
open-turn(id, nothing, no-type)
emit-block(body)
close-turns(turns)
loops.pop()
jump(head)
ir.start-block(done)

────────────────────
_ do emit-for
    - id SyntaxId
    - loop SyntaxId
    - body SyntaxId

` A loop over items, run as the type pass planned it: one that counts through a range of
` integers written in its header, or one over the container of each of its headers. One on a
` stream subscribes where it is written, and runs for an item in the function generated for
` it.
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if facts.plan-of(unit.reading, loop) == .plan-range-loop
            do match? tree.nodes[row.container]
                | .node-range-expression(range)
                    emit-range-loop(loop, range.op, range.left, range.right, row.clause, body)
                    =
        else if !row.is-subscriber
            emit-headed(loop, row.container, row.clause, body)
            =
        else if subscribing == id
            emit-subscriber(loop, tested(loop, row.clause), body)
            =
        else
            emit-subscription(id, loop, row.container)
            =
refuse(.refused-statement, id)

────────────────────
_ do emit-subscription
    - id SyntaxId
    - loop SyntaxId
    - container SyntaxId

` A loop on a stream where it is written: the container is made a `Broadcastable`, and the
` loop's subscriber, the environment in force here, is made a `Subscriber` and given to the
` broadcaster's `subscribe`, whose errors leave the function as the type pass said, or, where
` an object owns it, to the object (see `own-subscription`), or where it has a `whenever`
` clause, as `subscribe-whenever` says. A section of a class, which a constructor runs, has an
` environment of its own: see `lone-environment`.
. used = tables.event-use-of(unit.reading, id)
. source = Typed(make-operand(.operand-void, 0), no-type)
if used && used.second == no-instance
    refuse(.refused-statement, id)
    =
if used
    . owner = event-owner(used.reference, used.owner)
    . number = tables.event-number(used.owner, used.name)
    if number == U32.max
        =
    if used.address != 0
        . endpoint = keyed-endpoint(id, used, owner.operand, number)
        source = convert(loop, .reason-argument, endpoint)
    else
        source = event-endpoint(loop, used.first, owner.operand, number)
else
    source = emit-broadcastable(loop, container)
. stream = source.operand
. broadcaster = source.type
. written = Typed(make-operand(.operand-void, 0), no-type)
if unit.reading == unit.instance
    written = emit-closure(id)
else
    . closure = subscriber-closure(id)
    . lone = lone-environment(id, no-slot)
    if closure == no-type
        refuse(.refused-statement, id)
        =
    written = Typed(load-local(lone, id), closure)
. subscriber = convert(id, .reason-argument, written)
. given = subscriber.type
. owned = tables.owned-subscription-of(unit.reading, id)
. retested = tree.whenever-clause(loop)
. retest = tables.live-statement-of(unit.reading, retested) if retested != 0
if retest
    subscribe-whenever(id, retested, retest, stream, broadcaster, subscriber.operand)
else if retested != 0
    refuse(.refused-statement, retested)
else if owned
    own-subscription(id, owned, stream, subscriber.operand, used != null, arrives(loop))
else if used
    . wrapping = pending.length
    pending += subscriber.operand
    pending += integer(.machine-u8, if arrives(loop) then 1 else 0)
    . subscription = call-instance(used.second, id, wrapping)
    do call-protocol(id, own-call(id), stream, broadcaster, subscription.operand, subscription.type)
else
    do call-protocol(id, own-call(id), stream, broadcaster, subscriber.operand, given)

────────────────────
_ do tested SyntaxId
    - loop SyntaxId
    - clause SyntaxId

` The clauses the subscriber of a loop on a stream tests: those after the first where it says
` which publications a loop on an event hears. A `whenever` among them says whether the loop
` is subscribed and is not tested.
if facts.event-clause-of(unit.source-module, loop)
    do match? tree.nodes[clause]
        | .node-clause(row)
            = row.next
= clause

────────────────────
_ do subscribe-whenever
    - id SyntaxId
    - clause SyntaxId
    - retest LiveStatement
    - stream Operand
    - broadcaster TypeId
    - subscriber Operand

` A loop or a comprehension on a stream with a `whenever` clause, subscribed as the reference
` subscribes it: the clause's value is evaluated while a live action of its own is open, whose
` trackers note what it reads. Where no object owns the subscription, the subscriber is
` wrapped in a `Subscription`, which is given to the broadcaster's `subscribe` where the value
` holds, whose errors leave the function as the type pass said. Where an object owns it, the
` tracker `own-tracker` makes of it is added to the action's trackers where the value holds.
` What the value gave, the subscription or its tracker, and the broadcaster are kept in the
` locals declared at the clause, and the action is made with those trackers and a callback
` that tests the clause again through the function written for it, given the environment in
` force here, or one of its own where none is (see `lone-environment`). The object that owns
` the subscription owns the action.
. slot = channel-slot(clause)
. code = if retest.rerun != no-instance then rerun-function else no-function
    .. rerun-function = tables.instance-functions[retest.rerun]
. owned = tables.owned-subscription-of(unit.reading, clause)
. made = call-at(clause, .call-constructor)
if slot == no-slot || code == no-function || (!owned && made == no-fact) || (owned && !unit.has-self)
    refuse(.refused-statement, clause)
    =
. lone = if unit.reading != unit.instance then lone-environment(clause, slot, 3) else no-local
. trackers = open-trackers(clause)
live-actions += LiveTrackers(trackers, trackers)
. passed = emit-expression(clause-expr(clause))
live-actions.pop()
. kept = Typed(make-operand(.operand-void, 0), no-type)
if owned
    kept = own-tracker(clause, owned, stream, subscriber)
else
    . mark = pending.length
    pending += subscriber
    kept = call-instance(facts.calls[made].callee, clause, mark)
keep-hidden(lone, slot + 1, kept.operand, kept.type, clause)
keep-hidden(lone, slot, passed.operand, types.bool-type, clause)
. adding = ir.reserve-block()
. done = ir.reserve-block()
branch(passed.operand, adding, done)
ir.start-block(adding)
. given = convert(clause, .reason-argument, kept)
. given-type = given.type
if owned
    add-tracker(load-local(trackers, clause), given.operand, clause)
else
    do call-protocol(id, call-at(id, .call-method), stream, broadcaster, given.operand, given-type)
jump(done)
ir.start-block(done)
keep-hidden(lone, slot + 2, stream, broadcaster, clause)
. environment = if lone != no-local then load-local(lone, clause) else written-environment(clause)
if owned
    do own-action(load-local(trackers, clause), code, environment, clause)
else
    do make-action(load-local(trackers, clause), tables.live-adapter-of(code), environment, clause)

────────────────────
_ do keep-hidden
    - lone LocalId
    - slot SlotId
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores a value in a local no name reaches that a nested function captures: in the
` environment `lone` made for that function alone, where there is one.
if lone != no-local
    keep-lone(lone, slot, value, type, site)
else
    keep-captured(slot, value, type, site)

────────────────────
_ do add-tracker
    - trackers Operand
    - tracker Operand
    - site SyntaxId

` Adds a tracker, made a `Tracker`, to a list of trackers.
. adding = pending.length
pending += trackers
pending += tracker
do call-instance(instances.live.add-tracker, site, adding)

────────────────────
_ do clause-expr SyntaxId
    - clause SyntaxId

` The value a clause tests.
do match? tree.nodes[clause]
    | .node-clause(row)
        = row.expr
= 0

────────────────────
_ do retrack
    - clause SyntaxId
    - slot SlotId
    - passed Operand
    - next LocalId

` The rest of a test of a `whenever` clause again where an object owns the subscription: where
` the value holds, the tracker kept in `slot` is added to the trackers the action now has, so
` that it stays attached, and the subscription with it; where not, the action detaches it.
. type = find-captured(slot, clause).type
. adding = ir.reserve-block()
. done = ir.reserve-block()
branch(passed, adding, done)
ir.start-block(adding)
. tracker = read-captured(slot, clause, type)
. given = convert(clause, .reason-argument, Typed(tracker.operand, type))
add-tracker(load-local(next, clause), given.operand, clause)
jump(done)
ir.start-block(done)
emit-end(clause)

────────────────────
_ do emit-publish Typed
    - id SyntaxId
    - used EventUse
    - operands RowRange'SyntaxId

` A write to an event, as the reference publishes one: the object is evaluated, and where the
` event is live, the event runtime says whether anything listens to it on the object; only
` then is the payload made and published. A keyed event is asked at its address, the key the
` index gives, for the generation of the receiver there, which none is where nothing listens,
` and published at the address with it. One that bubbles is published with the object made
` the `EventNode` its parents are walked from.
. nothing = make-operand(.operand-void, 0)
. owner = event-owner(used.reference, used.owner)
. number = tables.event-number(used.owner, used.name)
if number == U32.max
    = Typed(nothing, types.void-type)
. pointer = num-cast(id, owner.operand, managed-layout, pointer-layout)
. keyed = used.address != 0
. key = if keyed then emit-key(used.address) else Typed(nothing, no-type)
count-event(.publish-attempts, id)
. asking = pending.length
pending += pointer
pending += integer(.machine-u64, number)
if keyed
    push-key(key.operand, key.type, id)
. answer = call-instance(used.first, id, asking)
. interested = if keyed then compare(id, .compare-not-equal, answer.operand, integer(.machine-u64, 0)) else answer.operand
. publishing = ir.reserve-block()
. done = ir.reserve-block()
. missing = done
if tables.event-counts[EventCount.publish-interest-misses as Size] != 0
    missing = ir.reserve-block()
branch(interested, publishing, missing)
ir.start-block(publishing)
count-event(.payload-builds, id)
. given = tree.children[operands.start]
. payload = convert(given, .reason-argument, emit-expression(argument-value(given)))
. node = if used.bubbles then convert-from(used.reference, .reason-event-node, owner.operand).operand else nothing
. mark = pending.length
pending += pointer
pending += integer(.machine-u64, number)
if keyed
    push-key(key.operand, key.type, id)
    pending += answer.operand
if used.bubbles
    pending += node
pending += payload.operand
do call-instance(used.second, id, mark)
jump(done)
if missing != done
    ir.start-block(missing)
    count-event(.publish-interest-misses, id)
    jump(done)
ir.start-block(done)
= Typed(nothing, types.void-type)

────────────────────
_ do emit-readdress Typed
    - id SyntaxId
    - used EventUse
    - operands RowRange'SyntaxId

` `rekey` or `release` of the address of a keyed event, as the reference makes them: the
` object and the key are evaluated, then for `rekey` the new key, converted to the event's
` key type, and the event runtime gives the address the receiver claimed there the new key,
` whose errors leave the function with the call, or under `catch` are what the call gives, or
` gives it up.
. nothing = make-operand(.operand-void, 0)
. owner = event-owner(used.reference, used.owner)
. number = tables.event-number(used.owner, used.name)
if number == U32.max
    = Typed(nothing, types.void-type)
. key = emit-key(used.address)
. key-type = key.type
. rekeys = used.kind == .event-rekey
. next = nothing
if rekeys
    . given = tree.children[operands.start]
    . converted = convert(given, .reason-argument, emit-expression(argument-value(given)))
    next = converted.operand
    if converted.type != key-type
        refuse(.refused-conversion, given)
. identity = receiver-identity(id)
. mark = pending.length
pending += num-cast(id, owner.operand, managed-layout, pointer-layout)
pending += integer(.machine-u64, number)
push-key(key.operand, key-type, id)
if rekeys
    push-key(next, key-type, id)
pending += identity
if carries-error(facts.node-type(unit.reading, id))
    takes-result = true
    . answer = call-instance(used.first, id, mark)
    takes-result = false
    = answer
do raising-call(id, used.first, mark)
= Typed(nothing, types.void-type)

────────────────────
_ do emit-route Typed
    - id SyntaxId
    - used EventUse
    - operands RowRange'SyntaxId

` A write of a `RoutedEvent`, as the reference publishes one: the object is evaluated, and
` where the event is live the payload is made and the event runtime publishes it along its
` route of owners, from the object on, whatever listens; one that bubbles is given the object
` made the `EventNode` its parents are walked from, where the payload has no route of its own.
. nothing = make-operand(.operand-void, 0)
. owner = event-owner(used.reference, used.owner)
. number = tables.event-number(used.owner, used.name)
if number == U32.max
    = Typed(nothing, types.void-type)
. pointer = num-cast(id, owner.operand, managed-layout, pointer-layout)
. given = tree.children[operands.start]
. payload = convert(given, .reason-argument, emit-expression(argument-value(given)))
count-event(.payload-builds, id)
. node = if used.bubbles then convert-from(used.reference, .reason-event-node, owner.operand).operand else no-node
    .. no-node = make-operand(.operand-void, 0)
. mark = pending.length
pending += integer(.machine-u64, number)
pending += pointer
if used.bubbles
    pending += node
pending += payload.operand
do call-instance(used.first, id, mark)
= Typed(nothing, types.void-type)

────────────────────
_ arrives Bool
    - loop SyntaxId

` Whether a loop on an event hears only the publications its object is the target of.
if clause then clause.arrival else false

.. clause = facts.event-clause-of(unit.source-module, loop)

────────────────────
_ do emit-escape Typed
    - id SyntaxId
    - used EventUse

` An event made a `Broadcastable`: the endpoint the event runtime keeps for the object's event,
` or the one at the address of a keyed event, which the receiver claims.
. owner = event-owner(used.reference, used.owner)
. number = tables.event-number(used.owner, used.name)
if number == U32.max
    refuse(.refused-expression, id)
if used.address != 0
    . endpoint = keyed-endpoint(id, used, owner.operand, number)
    = convert(id, .reason-argument, endpoint)
= event-endpoint(id, used.first, owner.operand, number)

────────────────────
_ do keyed-endpoint Typed
    - site SyntaxId
    - used EventUse
    - owner Operand
    - number U32

` The endpoint at the address of a keyed event, as the reference claims it for the receiver:
` the event runtime's `first` gives it for the object, the event's number, the key and the
` receiver's identity, and its errors leave the function at `site`; then a live action of the
` receiver holds a `ClosableTracker` of it, made as `claim` says, which closes it with the
` receiver.
. nothing = make-operand(.operand-void, 0)
. key = emit-key(used.address)
. key-type = key.type
. identity = receiver-identity(site)
. mark = pending.length
pending += num-cast(site, owner, managed-layout, pointer-layout)
pending += integer(.machine-u64, number)
push-key(key.operand, key-type, site)
pending += identity
. endpoint = raising-call(site, used.first, mark)
. endpoint-type = endpoint.type
claim(used.address, endpoint.operand, endpoint-type)
= Typed(endpoint.operand, endpoint-type)

────────────────────
_ do claim
    - address SyntaxId
    - endpoint Operand
    - endpoint-type TypeId

` The endpoint at the address of a keyed event claimed for the receiver: made a `Closable` at
` the node that names the event, and given to the `ClosableTracker` the type pass recorded
` there, which is made a `Tracker` there and added to the trackers of a live action of the
` receiver, whose callback does nothing.
. named SyntaxId = 0
do match? tree.nodes[address]
    | .node-index-expression(row)
        named = row.object
. claimed = facts.address-claim-of(unit.reading, named)
if !claimed
    refuse(.refused-statement, address)
    =
. closable = convert(named, .reason-argument, Typed(endpoint, endpoint-type))
. mark = pending.length
pending += closable.operand
. tracker = call-instance(claimed.closer, named, mark)
. given = convert(named, .reason-argument, tracker)
. trackers = open-trackers(named)
add-tracker(load-local(trackers, named), given.operand, named)
do own-callback(load-local(trackers, named), idle, integer(.machine-managed-pointer, 0), named)
    .. idle = tables.idle-action

────────────────────
_ do emit-key Typed
    - address SyntaxId

` The key an index addresses a keyed event with, converted to the event's key type as the type
` pass recorded at the key.
. nothing = make-operand(.operand-void, 0)
. key SyntaxId = 0
do match? tree.nodes[address]
    | .node-index-expression(row)
        key = row.index
if key == 0
    refuse(.refused-expression, address)
    = Typed(nothing, no-type)
= convert(key, .reason-argument, emit-expression(key))

────────────────────
_ do push-key
    - key Operand
    - type TypeId
    - site SyntaxId

` Gives the event runtime a key of a keyed event as the address it names, two `U64`s: an
` integer and none, or the index and the generation of a handle.
. layout = layout-of(type, site)
if is-integer(layout)
    pending += num-cast(site, key, layout, u64-layout)
    pending += integer(.machine-u64, 0)
    =
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 2
    refuse(.refused-conversion, site)
    =
for position in 0 .. < 2
    . field = tables.layouts.field(layout, position as U32)
    if !is-integer(field.layout)
        refuse(.refused-conversion, site)
        =
    pending += num-cast(site, take(key, field, site), field.layout, u64-layout)

────────────────────
_ do receiver-identity Operand
    - site SyntaxId

` The identity of the receiver that claims the address of a keyed event: the `uid` its header
` holds, as a `U64`. The receiver is the innermost markup element being built, or else the
` object `self` names.
. inside = content-hosts.length != 0
. receiver = if inside then content-hosts[content-hosts.length - 1].operand else unit.self
. type = if inside then content-hosts[content-hosts.length - 1].type else unit.owner-type
if (!inside && !unit.has-self) || !tables.is-class(type) || tables.layouts.objects[type] == no-layout
    refuse(.refused-expression, site)
    = make-operand(.operand-void, 0)
. uid = load
    - receiver
    - tables.layouts.field(tables.layouts.objects[type], 1).offset
    - u32-layout
    - site
= num-cast(site, uid, u32-layout, u64-layout)

────────────────────
_ do raising-call Typed
    - site SyntaxId
    - callee InstanceId
    - mark Size

` A call of a function of the event or markup runtime, given what is pending since `mark`,
` whose errors leave the function with the call, as the type pass noted.
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-instance(callee, site, mark)
takes-result = false
if raising
    = propagate(site, callee, answer.operand)
= answer

────────────────────
_ escaped-event EventUse?
    - id SyntaxId

` The event a node names that is made a `Broadcastable` there, or none.
used if facts.event-uses.length != 0 && used && used.kind == .event-escape

.. used = tables.event-use-of(unit.reading, id)

────────────────────
_ do event-owner Typed ?! Refused
    - reference SyntaxId
    - owner TypeId

` The object whose event of the class `owner` a node names: the value its name is read from,
` or where the name is written alone, the innermost markup element being built whose class has
` the event, where the name is read in the element's body, and else the receiver; or that of
` the event an index addresses. One read from the class that declares it is a loop's, which
` hears it as it bubbles to the loop's object (`bubbling-owner`).
do match? tree.nodes[reference]
    | .node-index-expression(row)
        = event-owner(row.object, owner)
    | .node-get-expression(get)
        if types.intrinsic-of(facts.node-type(unit.reading, get.object)) == .type-info
            = bubbling-owner(reference)
        = emit-expression(get.object)
    | .node-identifier
        . binding = instances.rows[unit.reading].binding
        if binding != no-binding && (resolution-flags /and/ ResolutionFlag.resolution-received) != 0
            . position = received-event(owner)
            if position
                = content-hosts[position]
        else if unit.has-self
            = Typed(unit.self, unit.owner-type)
        .. resolution-flags = bindings.resolution-of(binding, reference).flags
refuse(.refused-expression, reference)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do bubbling-owner Typed
    - reference SyntaxId

` The object a loop that names an event by the class that declares it subscribes on: the
` innermost markup element being built, or else the receiver.
if content-hosts.length != 0
    = content-hosts[content-hosts.length - 1]
if unit.has-self
    = Typed(unit.self, unit.owner-type)
refuse(.refused-expression, reference)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do received-event Size?
    - owner TypeId

` Where the innermost markup element being built whose class declares or inherits an event of
` the class or interface `owner` is kept.
. position = content-hosts.length
while position != 0
    position -= 1
    . parent = content-hosts[position].type
    if intrinsic(parent) == .class && types.implements-type(parent, owner)
        = position
= null

────────────────────
_ do event-endpoint Typed
    - site SyntaxId
    - callee InstanceId
    - owner Operand
    - number U32

` The endpoint the event runtime keeps for an object's event, which `callee` gives for the
` object and the event's number, made the event's `Broadcastable` as the type pass recorded at
` the site.
. mark = pending.length
pending += num-cast(site, owner, managed-layout, pointer-layout)
pending += integer(.machine-u64, number)
. made = call-instance(callee, site, mark)
= convert(site, .reason-argument, made)

────────────────────
_ do own-subscription
    - id SyntaxId
    - row OwnedSubscription
    - stream Operand
    - subscriber Operand
    - event Bool = false
    - arrival Bool = false

` A subscription the object owns, as the reference makes it: the tracker `own-tracker` makes
` of it is added to the trackers of a live action of the object, whose constructor attaches the
` tracker, which subscribes, and whose callback does nothing.
. tracker = own-tracker(id, row, stream, subscriber, event, arrival)
. given = convert(id, .reason-argument, tracker)
. trackers = open-trackers(id)
add-tracker(load-local(trackers, id), given.operand, id)
do own-callback(load-local(trackers, id), idle, integer(.machine-managed-pointer, 0), id)
    .. idle = tables.idle-action

────────────────────
_ do own-tracker Typed
    - id SyntaxId
    - row OwnedSubscription
    - stream Operand
    - subscriber Operand
    - event Bool = false
    - arrival Bool = false

` The tracker that subscribes a subscription an object owns: the subscriber is wrapped in a
` `Subscription`, or for an `event` in the event runtime's subscription, which hears every
` publication or with `arrival` only those the object is the target of, and given with the
` broadcaster to a `SubscriptionTracker`, whose type it has.
. nothing = make-operand(.operand-void, 0)
. mark = pending.length
pending += subscriber
if event
    pending += integer(.machine-u8, if arrival then 1 else 0)
. made = call-instance(row.subscription, id, mark)
. wrapped = convert(id, .reason-argument, made)
. tracking = pending.length
pending += stream
pending += wrapped.operand
= call-instance(row.tracker, id, tracking)

────────────────────
_ do emit-broadcastable Typed
    - loop SyntaxId
    - container SyntaxId

` The container of a loop or a comprehension on a stream made a `Broadcastable` as the type
` pass recorded at the header: given to `publisher`, or cast. It has the header's type.
. nothing = make-operand(.operand-void, 0)
. held = emit-expression(container)
. publisher = own-call(loop)
. stream = Typed(nothing, no-type)
if publisher != no-fact
    . mark = pending.length
    pending += convert(loop, .reason-argument, held).operand
    stream = call-instance(facts.calls[publisher].callee, loop, mark)
else
    stream = convert(loop, .reason-argument, held)
if stream.type != facts.node-type(unit.reading, loop)
    refuse(.refused-statement, loop)
= stream

────────────────────
_ do emit-broadcaster Typed
    - id SyntaxId
    - loop SyntaxId
    - container SyntaxId

` A comprehension on a stream where it is written: the container is made a `Broadcastable`,
` the channel is made and kept in the local the subscriber captures, and the subscriber, the
` environment in force here, is made a `Subscriber` and given to the broadcaster's
` `subscribe`, whose errors leave the function as the type pass said, or subscribed as
` `subscribe-whenever` says where the comprehension has a `whenever` clause. The channel, read again
` from where it is kept, is the comprehension's value. One written in the value of a global,
` where the function that types the value is not the one emitted, keeps the channel in an
` environment of its own: see `lone-environment`. One that is the value of a lazy local nested
` functions capture, evaluated by a function written in the one that declares the local, keeps
` it in the environment that holds the local, as `emit-closure` gives that environment.
. nothing = make-operand(.operand-void, 0)
. stream = emit-broadcastable(loop, container)
. broadcaster = stream.type
. made = call-at(id, .call-constructor)
. slot = channel-slot(id)
. channel = facts.node-type(unit.reading, id)
. closure = subscriber-closure(id)
if made == no-fact || slot == no-slot || closure == no-type || other-channel
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. other-channel = instances.signatures[facts.calls[made].callee].returns != channel
. lone = if unit.reading != unit.instance && shared-written(id) == no-slot then lone-environment(id, slot) else no-local
. object = call-instance(facts.calls[made].callee, id, pending.length)
. written = Typed(nothing, no-type)
if lone == no-local
    keep-captured(slot, object.operand, channel, id)
    written = emit-closure(id, closure)
else
    keep-lone(lone, slot, object.operand, channel, id)
    written = Typed(load-local(lone, id), closure)
. subscriber = convert(id, .reason-argument, written)
. given = subscriber.type
. owned = tables.owned-subscription-of(unit.reading, id)
. retested = tree.whenever-clause(loop)
. retest = tables.live-statement-of(unit.reading, retested) if retested != 0
if retest
    subscribe-whenever(id, retested, retest, stream.operand, broadcaster, subscriber.operand)
else if retested != 0
    refuse(.refused-expression, retested)
else if owned
    own-subscription(id, owned, stream.operand, subscriber.operand)
else
    do call-protocol(id, call-at(id, .call-method), stream.operand, broadcaster, subscriber.operand, given)
if lone != no-local
    = Typed(take(load-local(lone, id), lone-field(slot), id), channel)
= read-captured(slot, id, channel)

────────────────────
_ do lone-environment LocalId
    - id SyntaxId
    - slot SlotId
    - count U32 = 1

` The environment of a subscriber that the function emitted here does not type, where no
` environment of the function that types it is in force: in the value of a global, or in a
` section of a class, which a constructor runs. It is one of the layout of the function that
` types it, made for this subscriber alone, which holds the channel `slot` names, if any, and
` the object being made, where the layout holds it, since every function written there reads
` it then, and nothing else; one that holds nothing is given none. The function that tests a
` `whenever` clause again is given one so too, which holds the `count` locals from `slot` on
` that the clause keeps. A function that captures anything else, or holds the state of a
` global `do with` binds, has no shape there.
. layout = tables.environments[unit.reading]
if layout == unbuilt-environment || tables.holds-stacks(unit.reading)
    refuse(.refused-expression, id)
    = no-local
. binding = instances.rows[unit.reading].binding
. row = bindings.bindings[binding]
. home = tables.instance-scopes[unit.reading]
. alone = false
. captures = 0u32
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax != id
        continue
    alone = true
    captures = nested.captures.count
    for index in 0 .. < nested.captures.count
        . captured = bindings.captures[nested.captures.start + index].slot
        if tables.slot-homes[captured] != home
            alone = false
        else if bindings.slots[captured].kind == .slot-this && unit.has-self
            continue
        else if slot == no-slot || captured < slot || captured >= slot + count
            alone = false
. selves [SlotId]
if unit.has-self
    for offset in 0 .. < row.slots.count
        . held = row.slots.start + offset
        . captured = (bindings.slots[held].flags /and/ SlotFlag.slot-captured) != 0
        if bindings.slots[held].kind == .slot-this && captured && tables.slot-homes[held] == home
            selves += held
. bare = captures == 0 && selves.length == 0
if !alone || (layout == no-layout && !bare)
    refuse(.refused-expression, id)
    = no-local
. local = ir.add-local(managed-layout)
if bare
    store-local(local, integer(.machine-managed-pointer, 0), id)
    = local
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. made = call-runtime(.runtime-allocate-object, id, mark, managed-layout)
store-local(local, made, id)
for held in selves
    . field = lone-field(held)
    if !tables.is-class(field.type)
        refuse(.refused-expression, id)
        = no-local
    store(load-local(local, id), field.offset, unit.self, true, id)
= local

────────────────────
_ lone-field LayoutField
    - slot SlotId

` The field of a local a subscriber captures in its own environment.
tables.layouts.field(tables.environments[unit.reading], 1 + tables.slot-fields[slot])

────────────────────
_ do keep-lone
    - lone LocalId
    - slot SlotId
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores a local a nested function captures in the environment made for it alone: the
` channel of a comprehension on a stream, or what a `whenever` clause keeps.
. field = lone-field(slot)
if field.type != type
    refuse(.refused-statement, site)
    =
if tables.layouts.is-struct(field.layout)
    store-struct(load-local(lone, site), field, value, site)
else if field.layout != void-layout
    store(load-local(lone, site), field.offset, value, is-managed-pointer(field.layout), site)

────────────────────
_ channel-slot SlotId
    - id SyntaxId

` The local a node declares that no name reaches: the one a comprehension on a stream keeps
` its channel in, which its subscriber captures, or the first of those a `whenever` clause
` keeps what it gave, its subscription and its broadcaster in.
|? binding == no-binding
    no-slot
|? resolution.kind != .resolve-slot
    no-slot
??
    resolution.slot

.. binding = instances.rows[unit.reading].binding
.. resolution = bindings.resolution-of(binding, id)

────────────────────
_ do line-keeper SlotId
    - line SyntaxId

` The local no name reaches that keeps the object of the element a line given again is given
` to, declared at the line: an attribute or a line of content. It is found by its name, since a
` line of content may be a name its node resolves; the one after it keeps what the element took.
. binding = instances.rows[unit.reading].binding
if binding == no-binding
    = no-slot
= bindings.declared-at(bindings.bindings[binding].slots, line, program.store-atom("(element)"))

────────────────────
_ do subscriber-closure TypeId
    - id SyntaxId

` The closure a comprehension on a stream subscribes, as the conversion recorded where it is
` made a `Subscriber` gives it.
. scan = facts.first-conversion(unit.reading, id)
while scan != no-fact
    . row = facts.conversions[scan]
    if row.reason == .reason-argument && is-closure(row.from)
        = row.from
    scan = row.next
= no-type

────────────────────
_ do given-value Operand
    - at Operand
    - type TypeId
    - site SyntaxId

` A value of a type that lies at an address another function gave: the address itself where the
` value is a struct.
. layout = layout-of(type, site)
= if tables.layouts.is-struct(layout) then at else load(at, 0, layout, site)

────────────────────
_ do read-kept Typed
    - node SyntaxId
    - name String
    - site SyntaxId

` What the machine keeps under a name, read from its environment.
. slot = kept-slot(node, name, site)
. held = find-captured(slot, site).type
= read-captured(slot, site, held)

────────────────────
_ do turn-link Operand
    - scope ScopeId
    - site SyntaxId

` The environment in force around a scope that has turns: that of the turn being emitted of the
` nearest scope around it in its function that has turns with an environment, or else the
` function's own. One whose turn is not being emitted there has no shape here.
. around = bindings.scopes[scope].parent
while !opens-function(around)
    if tables.is-turn-scope(around) && tables.scope-captures[around] != 0
        . position = open-turns.length
        while position != 0 && open-turns[position - 1].scope != around
            position -= 1
        if position == 0
            refuse(.refused-statement, site)
            = make-operand(.operand-void, 0)
        = turn-held(open-turns[position - 1].local, open-turns[position - 1].place, site)
    around = bindings.scopes[around].parent
= function-environment(site)

────────────────────
_ do start-case

` Begins the case a root's task main runs in a batch: the runtime is told the case starts, so
` that what it prints goes to the batch's files, from the case's own directory.
. mark = pending.length
pending += text-constant(tables.batch-control)
pending += text-constant(tables.batch-ids[function.place])
pending += text-constant(tables.batch-directories[function.place])
pending += text-constant(tables.batch-output)
pending += text-constant(tables.batch-errors)
call-runtime(.runtime-batch-test-start, 0, mark)

────────────────────
_ do emit-batch-main

` The task main of a batch: it forks the task main of the root the batch is run from, the one
` `BRIXTEST_BATCH_START_INDEX` names, and ends its own task.
. first = call-runtime(.runtime-batch-start-index, 0, pending.length, i32-layout)
for position in function.calls.start .. < function.calls.end
    . forking = ir.reserve-block()
    . passed = ir.reserve-block()
    . case = (position - function.calls.start) as U64
    branch(compare(0, .compare-equal, first, integer(.machine-i32, case)), forking, passed)
    ir.start-block(forking)
    fork-batch(tables.calls[position], true)
    jump(passed)
    ir.start-block(passed)
call-runtime(.runtime-terminate-active-task, 0, pending.length)
return-nothing()

────────────────────
_ do emit-batch-finish

` Ends the case of a batch once every task it started has ended: while another task is active it
` forks itself again and ends. Then the runtime is told the case finished, what its probes wrote
` is flushed, and what the case left is cleared, so the next case starts as a program of its own
` does: each global of the modules its root started has no value, and each constant is zero until
` the next case lays its value down again, and what it made is collected and cleaned up. Then the task main of the next root is forked where the batch runs it, and where
` it runs no other, the record of probes is closed.
. waiting = ir.reserve-block()
. finishing = ir.reserve-block()
. done = ir.reserve-block()
. activity = call-runtime(.runtime-task-queue-activity, 0, pending.length, i32-layout)
branch(compare(0, .compare-greater, activity, integer(.machine-i32, 1)), waiting, finishing)
ir.start-block(waiting)
fork-batch(tables.batch-finishes[function.place])
jump(done)
ir.start-block(finishing)
. mark = pending.length
pending += text-constant(tables.batch-control)
pending += text-constant(tables.batch-ids[function.place])
call-runtime(.runtime-batch-test-finish, 0, mark)
if tables.probe-flush != no-function
    call-function(tables.probe-flush, 0)
. first = program.batch-order-starts[function.place]
. last = program.batch-order-starts[function.place + 1]
for position in first .. < last
    . module = program.batch-order-modules[position] as ModuleId
    for decl in 0 .. < program.modules[module].decls.length
        . row = tables.storage-of(module, decl as DeclId)
        if row == no-storage
            continue
        . kept = tables.storage[row]
        if kept.state != no-string
            zero(make-operand(.operand-symbol, kept.symbol), kept.layout)
            store(make-operand(.operand-symbol, kept.state), 0, integer(.machine-u8, 0), false, 0)
        else if tables.global-kind(module, decl as DeclId) == .global-constant
            zero(make-operand(.operand-symbol, kept.symbol), kept.layout)
call-runtime(.runtime-collect, 0, pending.length, u64-layout, true)
call-runtime(.runtime-drain-cleanups, 0, pending.length, u64-layout, true)
. closing = ir.reserve-block()
if function.calls.count != 0
    . end = call-runtime(.runtime-batch-end-index, 0, pending.length, i32-layout)
    . forking = ir.reserve-block()
    . next = integer(.machine-i32, function.place + 1)
    branch(compare(0, .compare-less, next, end), forking, closing)
    ir.start-block(forking)
    fork-batch(tables.calls[function.calls.start], true)
    jump(done)
else
    jump(closing)
ir.start-block(closing)
if tables.probe-teardown != no-function
    call-function(tables.probe-teardown, 0)
jump(done)
ir.start-block(done)
call-runtime(.runtime-terminate-active-task, 0, pending.length)
return-nothing()

────────────────────
_ do set-up-batch-probes

` Declares the probes of a batch where the case the batch is run from starts, the one
` `BRIXTEST_BATCH_START_INDEX` names, as the reference does: every case after it writes to the
` record of probes that case opened.
. first = call-runtime(.runtime-batch-start-index, 0, pending.length, i32-layout)
. setting = ir.reserve-block()
. passed = ir.reserve-block()
branch(compare(0, .compare-equal, first, integer(.machine-i32, function.place)), setting, passed)
ir.start-block(setting)
call-function(tables.probe-setup, 0)
jump(passed)
ir.start-block(passed)

────────────────────
_ do fork-batch
    - task FunctionId
    - main Bool = false

` Forks a task that runs a function of a batch, which is given nothing. The task is forked as
` native code forks one, so that a panic it reports names no task that spawned it; the `main` task
` of a case has the stack the first task of a program has.
ir.depend(.callee-function, task, 0)
. mark = pending.length
pending += make-operand(.operand-symbol, tables.functions[task].symbol)
pending += integer(.machine-u64, 0)
pending += integer(.machine-u64, tables.task-local-size as U64)
call-runtime
    - if main then .runtime-fork-main-task else .runtime-fork-plain-task
    - 0
    - mark
    - void-layout

────────────────────
_ do text-constant Operand
    - text String

` A literal of text, whose address is that of its bytes, which a zero byte follows.
= make-operand(.operand-constant, ir.add-string(text))

────────────────────
_ do emit-subscriber
    - loop SyntaxId
    - clause SyntaxId
    - body SyntaxId
    - writes SyntaxId = 0

` The function a loop on a stream runs for each item it is given, after the environment it
` was made with: the header's pattern takes the item, and a `when` that fails or an item a
` match passes over returns. A `while` or an `until` that fails unsubscribes and returns.
` Then the body runs, where a `break` that leaves no loop of the body unsubscribes and returns.
` That of a comprehension on a stream, which `writes` to the
` comprehension's channel, tests its clauses in the order written and writes what its body
` gives.
. type = instances.argument-type(unit.instance, 0)
. last = loop-slots(loop) + loop-state-count - 1
. skip = ir.reserve-block()
. ended = ir.reserve-block()
. item = make-operand(.operand-argument, 1)
take-item(loop, last, item, type, skip)
. turned = facts.slot-type(unit.instance, slot-offset(last, loop))
. depth = loops.length
loops += EmittedLoop(loop, skip, ended, item, turned, open-cleanups.length, last)
emit-clause(clause, skip, ended)
if writes != 0
    emit-write(writes, body)
else
    emit-block(body)
while loops.length > depth
    loops.pop()
jump(skip)
ir.start-block(ended)
if own-call(loop) != no-fact
    unsubscribe(loop)
jump(skip)
ir.start-block(skip)

────────────────────
_ do emit-write
    - id SyntaxId
    - body SyntaxId

` What the body of a comprehension on a stream gives, written to the channel the comprehension
` made, read from the environment it was kept in, by the call of `<-` the type pass recorded
` at the comprehension.
. value = emit-expression(body)
. written = value.type
. fact = call-at(id, .call-operator)
. slot = channel-slot(id)
if fact == no-fact || slot == no-slot || facts.calls[fact].callee == no-instance
    refuse(.refused-expression, id)
    =
. channel = instances.rows[facts.calls[fact].callee].self-type
. held = read-captured(slot, id, channel)
do call-operator(id, fact, id, held.operand, channel, body, value.operand, written)

────────────────────
_ do breaks-subscription Bool

` Whether a `break` here unsubscribes: the innermost loop is the one on a stream that the
` function being emitted runs for an item.
if subscribing == 0 || loops.length == 0
    = false
do match? tree.nodes[subscribing]
    | .node-for-block(row)
        = loops[loops.length - 1].syntax == row.loop
= false

────────────────────
_ do unsubscribe
    - site SyntaxId

` The subscriber being run, made a `Subscriber` again by the conversion recorded where it was
` subscribed, so it is the same value, given to `unsubscribe` of the stream it was given, as
` the type pass recorded at the node that unsubscribes. An error that leaves `unsubscribe` is
` given to the global `unhandled-error` and what follows runs, as the reference's raw call does.
. fact = own-call(site)
. closure = facts.node-type(unit.reading, subscribing)
. enclosing = facts-owner(instances.rows[unit.instance].enclosing)
. made = no-fact
. scan = if enclosing != no-instance then enclosing-first else no-fact
    .. enclosing-first = facts.first-conversion(enclosing, subscribing)
while scan != no-fact
    . row = facts.conversions[scan]
    if row.reason == .reason-argument && row.from == closure
        made = scan
    scan = row.next
if fact == no-fact || made == no-fact
    refuse(.refused-statement, site)
    =
. subscriber = convert-one(site, facts.conversions[made], Typed(make-operand(.operand-argument, 0), closure))
. given = subscriber.type
. stream = make-operand(.operand-argument, 2)
. broadcaster = instances.argument-type(unit.instance, 1)
call-subscription(site, fact, stream, broadcaster, subscriber.operand, given)

────────────────────
_ do call-subscription
    - site SyntaxId
    - fact FactId
    - stream Operand
    - broadcaster TypeId
    - given Operand
    - given-type TypeId

` The broadcaster's `subscribe` or `unsubscribe` the type pass recorded as `fact`, given a
` subscriber or a subscription, as the reference's raw call makes it: an error that leaves it is
` given to the global `unhandled-error` and what follows runs.
. callee = facts.calls[fact].callee
if layout-of(given-type, site) != layout-of(instances.argument-type(callee, 0), site) || other-self
    refuse(.refused-statement, site)
    =
.. other-self = broadcaster != instances.rows[callee].self-type
. raising = instances.signatures[callee].errors.count != 0
. mark = pending.length
pending += stream
pending += given
takes-result = raising
. answer = call-instance(callee, site, mark, false, true)
takes-result = false
if raising
    do report-result(site, instances.signatures[callee].result, answer.operand, true)

────────────────────
_ do emit-gate-test
    - condition SyntaxId

` The function that tests again the condition a style rule written on a markup element is
` applied under, given the environment the element was written in, as the reference's gate
` evaluates it: the condition's value, with the trackers of the action that runs the gate
` noting what it reads.
. live = instances.live
if live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, condition)
    =
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, condition, pending.length).operand, condition)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, condition, pending.length).operand, condition)
live-actions += LiveTrackers(previous, next)
. passed = emit-expression(condition)
live-actions.pop()
return-value(passed.operand, condition)

────────────────────
_ do emit-retest
    - clause SyntaxId

` The function a live action runs to test a `whenever` clause again, given the environment the
` loop was written in, as the reference's closure does: the clause's value, with the trackers
` of the action that runs it noting what it reads, is compared with the one the clause last
` gave, kept where the loop was written. Where it differs it is kept instead, and the
` subscription kept there is given to the broadcaster's `subscribe` where the value holds, or
` else to its `unsubscribe`, as `call-subscription` says. Where an object owns the
` subscription, the clause is tested as `retrack` says instead.
. live = instances.live
. calls = facts.whenever-calls-of(unit.instance)
. slot = channel-slot(clause)
if live.previous == no-instance || live.next == no-instance || !calls || slot == no-slot
    refuse(.refused-function, clause)
    =
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, clause, pending.length).operand, clause)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, clause, pending.length).operand, clause)
live-actions += LiveTrackers(previous, next)
. passed = emit-expression(clause-expr(clause))
live-actions.pop()
if calls.owns
    retrack(clause, slot + 1, passed.operand, next)
    =
. last = read-captured(slot, clause, types.bool-type)
. wrapped = find-captured(slot + 1, clause).type
. broadcaster = find-captured(slot + 2, clause).type
. changing = ir.reserve-block()
. done = ir.reserve-block()
branch(compare(clause, .compare-not-equal, passed.operand, last.operand), changing, done)
ir.start-block(changing)
keep-captured(slot, passed.operand, types.bool-type, clause)
. stream = read-captured(slot + 2, clause, broadcaster)
. subscription = read-captured(slot + 1, clause, wrapped)
. given = convert(clause, .reason-argument, Typed(subscription.operand, wrapped))
. given-type = given.type
. adding = ir.reserve-block()
. dropping = ir.reserve-block()
branch(passed.operand, adding, dropping)
ir.start-block(adding)
call-subscription(clause, calls.subscribe, stream.operand, broadcaster, given.operand, given-type)
jump(done)
ir.start-block(dropping)
call-subscription(clause, calls.unsubscribe, stream.operand, broadcaster, given.operand, given-type)
jump(done)
ir.start-block(done)
emit-end(clause)

────────────────────
_ field-names RowRange'SyntaxId
    - pattern SyntaxId

` The names a pattern writes for the fields of a tuple, where it is one that takes the tuple
` apart: the pattern of a loop, or a tuple of names within another. None for any other.
|? pattern == 0
    RowRange'SyntaxId()
??
    match tree.nodes[pattern]
        | .node-type-tuple(row)
            row.field-types
        | .node-tuple-syntax(row)
            row.items
        ??
            RowRange'SyntaxId()

────────────────────
_ do keep-state
    - slot SlotId
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores what a loop keeps from one pass to the next in a slot the binder declared for its
` header, which the type pass typed: in a cell made where the loop first stores it, or in
` the environment of a function that yields.
. offset = slot-offset(slot, site)
if slot == no-slot || facts.slot-type(unit.instance, offset) != type || type == no-type
    refuse(.refused-statement, site)
    =
. layout = layout-of(type, site)
if layout == void-layout
    =
if is-captured(slot)
    keep-captured(slot, value, type, site)
    =
if unit.cells[offset] == no-local
    unit.cells[offset] = ir.add-local(layout)
store-local(unit.cells[offset], value, site)

────────────────────
_ do state Typed
    - slot SlotId
    - site SyntaxId

` What a loop keeps in one of its slots, of the type the type pass gave the slot. One that
` holds nothing has no cell.
. nothing = make-operand(.operand-void, 0)
. offset = slot-offset(slot, site)
. type = facts.slot-type(unit.instance, offset)
if is-captured(slot)
    . held = read-captured(slot, site, type)
    = Typed(held.operand, type)
if unit.cells[offset] == no-local
    if layout-of(type, site) != void-layout
        refuse(.refused-expression, site)
    = Typed(nothing, type)
= Typed(load-local(unit.cells[offset], site), type)

────────────────────
_ do hold-container TypeId
    - loop SyntaxId
    - container SyntaxId
    - slot SlotId
    - kept Bool = false

` Evaluates the container of a loop, once, and keeps it in the first of the loop's slots,
` converted as the type pass recorded where it is written, and answers its type. The loop of
` a comprehension keeps its container already: the function generated for it was given the
` container where it was called. So does the loop of a bullet, which kept it where the bullet
` began, as `kept` says.
holding = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, loop) == .plan-table-loop && kept
    refuse(.refused-statement, loop)
    = no-type
if facts.plan-of(unit.reading, loop) == .plan-table-loop
    = hold-rows(loop, container, slot)
if loop == given-loop || kept
    . kept = state(slot, loop)
    holding = kept.operand
    = kept.type
if reads-place(loop)
    . base = facts.loop-base(unit.reading, loop)
    if base == U32.max
        refuse(.refused-statement, loop)
        = no-type
    if base != 0
        . object = emit-expression(base)
        pin(base, object.operand, object.type)
    . emitted = emit-expression(container)
    if !tables.layouts.is-struct(layout-of(emitted.type, loop))
        refuse(.refused-statement, loop)
    = emitted.type
. held = convert(container, .reason-operand, emit-expression(container))
. type = held.type
keep-state(slot, held.operand, type, loop)
holding = held.operand
= type

────────────────────
_ do hold-rows TypeId
    - loop SyntaxId
    - container SyntaxId
    - slot SlotId

` Begins a loop over a table or a span of one, as TypeScript begins it: the container is
` evaluated, once, and its rows found, checked where the table grows; the first row is kept,
` and the count of rows. An index span is kept, and its length. Answers the container's type.
` The loop of a comprehension reads the container it was given from the slot after its item.
. table = if loop == given-loop then state(slot + loop-state-count, loop) else convert(container, .reason-operand, emit-expression(container))
. type = table.type
if intrinsic(type) == .table-selection || intrinsic(type) == .immutable-table-selection
    hold-selection(loop, table.operand, type, slot)
    = type
if intrinsic(type) == .index-span
    . layout = layout-of(type, loop)
    keep-state(slot, table.operand, type, loop)
    keep-state(slot + 1, word-at(loop, table.operand, layout, 3), types.size-type, loop)
    = type
. offset = slot-offset(slot, loop)
. row = facts.slot-type(unit.instance, offset)
. layout = layout-of(type, loop)
. row-layout = layout-of(row, loop)
. source = table-source(loop, table.operand, type, layout)
. made = frame(row-layout)
if is-immutable-view(intrinsic(type))
    put
        - made
        - tables.layouts.field(row-layout, 0)
        - num-cast(loop, source.columns, pointer-layout, managed-layout)
        - loop
    put(made, tables.layouts.field(row-layout, 1), source.offset, loop)
else
    put
        - made
        - tables.layouts.field(row-layout, 0)
        - view-columns(loop, source.meta, source.columns)
        - loop
    put(made, tables.layouts.field(row-layout, 1), source.offset, loop)
    put-meta(loop, made, row-layout, 2, source.meta)
keep-state(slot, made, row, loop)
keep-state(slot + 1, source.length, types.size-type, loop)
. kind = intrinsic(type)
if facts.constant-of(unit.reading, loop) != no-fact && (kind == .table || kind == .table-span)
    . named = loop-name-slot(loop)
    if named != no-slot
        proven-items += ProvenItem(loop, named, source.columns)
= type

────────────────────
_ do hold-selection
    - loop SyntaxId
    - selection Operand
    - type TypeId
    - slot SlotId

` Begins a loop over a selection of a table's rows, as TypeScript's loop over rows begins it:
` the indices are resolved, then the table's columns and length found, checked where it
` grows. The selection is kept as a finished table of those columns and that length, read
` with no metadata, and, where the indices are not resolved again on each pass, with the
` indices where they lie; then the count of indices. A loop TypeScript leaves to the
` selection's own iteration is refused.
. constant = facts.constant-of(unit.reading, loop)
. reads = if constant != no-fact then facts.constants[constant].bits else 2u64
if reads == 2
    refuse(.refused-statement, loop)
    =
. layout = layout-of(type, loop)
. table-type = field-type(type, 0)
. span-type = field-type(type, 1)
. table-layout = layout-of(table-type, loop)
. span-layout = layout-of(span-type, loop)
. table = part(selection, layout, 0, loop)
. span = part(selection, layout, 1, loop)
. resolved = resolve-span(loop, span.operand, span-layout)
. source = table-source(loop, table.operand, table-type, table-layout)
. made = frame(layout)
copy(made, selection, layout, false, loop)
. kept-table = address(made, tables.layouts.field(layout, 0).offset, table-layout, loop)
put-word(loop, kept-table, table-layout, 0, source.columns, pointer-layout)
put-word(loop, kept-table, table-layout, 1, source.length, u64-layout)
for position in 2 .. < tables.layouts.rows[table-layout].fields.count
    put-word(loop, kept-table, table-layout, position, integer(.machine-u64, 0), u64-layout)
if reads == 0
    . kept-span = address(made, tables.layouts.field(layout, 1).offset, span-layout, loop)
    put-word(loop, kept-span, span-layout, 0, resolved.data, u64-layout)
    put-word(loop, kept-span, span-layout, 1, integer(.machine-u64, 0), u64-layout)
keep-state(slot, made, type, loop)
keep-state(slot + 1, word-at(loop, span.operand, span-layout, 3), types.size-type, loop)

────────────────────
_ do read-selected Typed
    - loop SyntaxId
    - slot SlotId
    - type TypeId
    - done IRBlockId

` The next row of a loop over a selection of a table's rows, or a leave to `done` once the
` count read reaches the count of indices: the indices are resolved, again where the loop
` finds them on each pass, the index read at the count, and checked against the table's
` length as found when the loop began; the row there holds no metadata.
. none = make-operand(.operand-void, 0)
. item-slot = slot-offset(slot + loop-state-count - 1, loop)
. row = facts.slot-type(unit.instance, item-slot)
. row-kind = intrinsic(row)
if row-kind != .table-row && row-kind != .immutable-table-row
    refuse(.refused-statement, loop)
    = Typed(none, no-type)
. layout = layout-of(type, loop)
. table-type = field-type(type, 0)
. span-type = field-type(type, 1)
. table-layout = layout-of(table-type, loop)
. span-layout = layout-of(span-type, loop)
. item = viewed-item(span-type)
. item-layout = layout-of(item, loop)
. row-layout = layout-of(row, loop)
. inside = ir.reserve-block()
branch(compare(loop, .compare-less, state(slot + 2, loop).operand, state(slot + 1, loop).operand), inside, done)
ir.start-block(inside)
. count = state(slot + 2, loop)
keep-state
    - slot + 2
    - arithmetic(loop, .arithmetic-add, count.operand, integer(.machine-u64, 1), u64-layout)
    - types.size-type
    - loop
. selection = state(slot, loop)
. table = part(selection.operand, layout, 0, loop)
. span = part(selection.operand, layout, 1, loop)
. index = selected-index(loop, resolve-span(loop, span.operand, span-layout), count.operand, item, item-layout)
fail-if
    - loop
    - compare(loop, .compare-greater-equal, index, word-at(loop, table.operand, table-layout, 1))
    - "TableSelection index is out of bounds"
. made = frame(row-layout)
put-word(loop, made, row-layout, 0, word-at(loop, table.operand, table-layout, 0), u64-layout)
put(made, tables.layouts.field(row-layout, 1), index, loop)
for position in 2 .. < tables.layouts.rows[row-layout].fields.count
    put-word(loop, made, row-layout, position, integer(.machine-u64, 0), u64-layout)
= Typed(made, row)

────────────────────
_ do read-index Typed
    - loop SyntaxId
    - slot SlotId
    - type TypeId
    - done IRBlockId

` The next index of a loop over an index span, or a leave to `done` once the count read
` reaches the length read when the loop began: the span is resolved, and the index read at
` the count, as `s[i]` reads it.
. layout = layout-of(type, loop)
. item = viewed-item(type)
. item-layout = layout-of(item, loop)
. inside = ir.reserve-block()
branch(compare(loop, .compare-less, state(slot + 2, loop).operand, state(slot + 1, loop).operand), inside, done)
ir.start-block(inside)
. count = state(slot + 2, loop)
keep-state
    - slot + 2
    - arithmetic(loop, .arithmetic-add, count.operand, integer(.machine-u64, 1), u64-layout)
    - types.size-type
    - loop
. span = state(slot, loop)
. value = span-item(loop, resolve-span(loop, span.operand, layout), count.operand, item-layout)
= Typed(value, item)

────────────────────
_ reads-place Bool
    - loop SyntaxId

` Whether a loop reads its container where it is kept at each item, as the type pass
` planned it: in a function that yields the loop keeps the container, as the reference's
` does there, and so does the loop of a comprehension, which is given it.
!stepping && loop != given-loop && is-place-loop-plan(facts.plan-of(unit.reading, loop))

────────────────────
_ do container-of Typed
    - loop SyntaxId
    - written SyntaxId
    - slot SlotId

` What a loop reads its items from: what it keeps, or its container read anew where it is
` kept, with the object it is a property of as that was when the loop began.
if !reads-place(loop)
    = state(slot, loop)
= emit-expression(written)

────────────────────
_ do keep-given
    - declared SyntaxId

` What the function generated for a comprehension does with the container it is given,
` its one argument after the environment it was written in: it keeps it in the first slot
` of the loop, converted as the type pass recorded for the loop's container, where the
` body of the generator finds it, or, for a loop over the rows of a table, in the slot after
` its item, where the loop finds its rows when it begins. That of a stream piped through a
` pattern keeps the value piped so, but for a bullet the pipe reads alone, which it is given
` nothing for.
if given-pipe != 0
    if tree.piped-bullet(given-pipe) != 0
        if instances.signatures[unit.instance].args.count != 0
            refuse(.refused-function, declared)
        =
    . slot = loop-slots(given-pipe)
    if instances.signatures[unit.instance].args.count != 1 || ir.arguments.length != 2
        refuse(.refused-function, declared)
        =
    keep-state
        - slot
        - make-operand(.operand-argument, 1)
        - instances.argument-type(unit.instance, 0)
        - given-pipe
    =
do match? tree.nodes[given-loop]
    | .node-loop-syntax(row)
        . slot = loop-slots(given-loop)
        if instances.signatures[unit.instance].args.count != 1 || ir.arguments.length != 2
            refuse(.refused-function, declared)
            =
        . held = convert(row.container, .reason-operand, Typed(make-operand(.operand-argument, 1), instances.argument-type(unit.instance, 0)))
        . kept = if facts.plan-of(unit.reading, given-loop) == .plan-table-loop then slot + loop-state-count else slot
        keep-state(kept, held.operand, held.type, given-loop)
        =
refuse(.refused-function, declared)

────────────────────
_ do emit-comprehension Typed
    - id SyntaxId
    - loop SyntaxId

` A comprehension written as a value: a call of the function generated for it. The
` container of its loop is evaluated here, where the comprehension is written, and given
` to the function. The call gives the generator. One on a stream subscribes here instead:
` see `emit-broadcaster`.
. container SyntaxId = 0
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        if row.is-subscriber
            = emit-broadcaster(id, loop, row.container)
        container = row.container
if container == 0
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
= emit-comprehension-call(id, container)

────────────────────
_ do emit-comprehension-call Typed
    - id SyntaxId
    - container SyntaxId
    - converts Bool = false

` The call of the function generated for a comprehension, or for a stream piped through a
` pattern, given the container, which gives the generator. A container that `converts` is
` converted as the type pass recorded for it as an argument.
. answer = call-generated(id, container, converts)
if answer.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
= answer

────────────────────
_ do call-generated Typed
    - id SyntaxId
    - given-site SyntaxId
    - converts Bool = false

` A call of the function generated for what is written at a node, a comprehension, a list
` of bullets or the right side of a pipe, which the type pass recorded there. It is given
` the environment in force, which the function reads the locals it captures from, and
` then the value written at `given-site`, where it takes one, evaluated here, and where it
` `converts`, converted as the type pass recorded for it as an argument. One written in
` the value a class writes for a property is typed by the instance that types that value,
` and given no environment, where that instance makes none: it captures nothing. Where it
` makes one it has no shape. One written in the value of a lazy local nested functions
` capture, evaluated by a function written in the one that declares it (`read-shared`), is
` given the environment that holds the local, which is the one in force where it is written.
` One a constructor makes has no shape where `emit-closure` gives a nested function none: while
` the properties are given their values, where nested functions read the receiver, and after,
` where the properties read a lazy local nested functions capture.
. nothing = make-operand(.operand-void, 0)
. callee = no-instance
. propagates = false
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == .call-closure
        callee = facts.calls[fact].callee
        propagates = facts.calls[fact].propagates
    fact = facts.calls[fact].next
. count U32 = if given-site != 0 then 1 else 0
. outside = unit.reading != unit.instance
. held = outside && tables.environments[unit.reading] != no-layout
. shared = shared-slot()
. receiving = filling.storing && !outside && shares-receiver()
. doubled = !filling.storing && !outside && fills-share() && shares-lazy()
if callee == no-instance || (held && shared == no-slot) || receiving || doubled
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if outside && instances.rows[callee].enclosing != unit.reading
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.instance-functions[callee] == no-function || other-arity
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. other-arity = instances.signatures[callee].args.count != count
. given-value = Typed(nothing, no-type)
if given-site != 0
    given-value = emit-expression(given-site)
    if converts
        given-value = convert(given-site, .reason-argument, given-value)
    if given-value.type != instances.argument-type(callee, 0)
        refuse(.refused-conversion, given-site)
. written = nested-environment(id)
if outside && tables.stack-holds(callee).length != 0
    refuse(.refused-expression, id)
hold-stacks(id, instances.rows[callee].decl, written)
. mark = pending.length
pending += written
if given-site != 0
    pending += given-value.operand
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-instance(callee, id, mark)
takes-result = false
=? propagate(id, callee, answer.operand) if raising && propagates
= answer

────────────────────
_ do emit-bullet-list Typed
    - id SyntaxId

` A list of bullets written as a value: a call of the function generated for it, which the
` type pass recorded at the first bullet, and which gives the generator.
= call-generated(id, 0)

────────────────────
_ do emit-bullets
    - first SyntaxId

` The body of the function generated for a list of bullets: each bullet in turn yields
` its item, converted as the type pass recorded for the list at the item; one written
` `*?` yields what an optional holds, where it holds anything; and one written `**`
` yields every item of what it writes, by the loop the type pass planned at the bullet.
` An item written as a cast keeps the cast's conversion where the list's is kept, so only
` the conversions of what the item gave are made. One written `*?` whose item is no
` optional has no shape yet.
. bullet = first
while bullet != 0
    . next SyntaxId = 0
    do match? tree.nodes[bullet]
        | .node-bullet-expression(row)
            next = row.next
            if row.is-multi
                emit-spread(bullet, row.item, row.is-optional)
            else
                . value = convert-matched
                    - row.item
                    - .reason-explicit
                    - emit-expression(row.item)
                    - no-type
                if row.is-optional && !types.is-optional(value.type)
                    refuse(.refused-expression, bullet)
                yield-item(facts.bullet-site(unit.reading, bullet), value, row.is-optional)
    bullet = next

────────────────────
_ do emit-built-bullets
    - declared SyntaxId
    - first SyntaxId

. list = build-bullets(first, first, returns-type, .reason-return)
return-value(list.operand, declared)

────────────────────
_ do emit-listed-bullets Typed
    - id SyntaxId
    - first SyntaxId

= build-bullets(id, first, facts.node-type(unit.reading, id), .reason-element)

────────────────────
_ do build-bullets Typed ?! Refused
    - home SyntaxId
    - first SyntaxId
    - listed TypeId
    - reason ConversionReason

. appends = call-at(home, .call-list-append)
if appends == no-fact || first == 0
    refuse(.refused-expression, home)
    = Typed(make-operand(.operand-void, 0), no-type)
. outer-list = built-list
. outer-item = built-item
. outer-append = built-append
. outer-reason = built-reason
. outer-spreading = spreading
built-append = facts.calls[appends].callee
built-item = instances.argument-type(built-append, 0)
built-reason = reason
spreading = 0
. count U32 = 0
. room U32 = 0
. leading = true
. bullet = first
while bullet != 0
    do match? tree.nodes[bullet]
        | .node-bullet-expression(row)
            leading = leading && !row.is-multi && !row.is-optional
            if leading
                count += 1
            else if !row.is-multi
                room += 1
    bullet = next-bullet(bullet)
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
. start = given.length
bullet = first
for _ in 0 .. < count
    do match? tree.nodes[bullet]
        | .node-bullet-expression(row)
            . value = convert-matched(row.item, .reason-explicit, emit-expression(row.item), no-type)
            . site = facts.bullet-site(unit.reading, bullet)
            . converted = built-value(site, value)
            if converted.type != built-item
                refuse(.refused-conversion, site)
            given += Typed(apart(converted, row.item, count > 1), converted.type)
    bullet = next-bullet(bullet)
. list = build-list(home, RowRange'SyntaxId(0, count), listed, start, false, first, room)
drop-given(start)
built-list = list.operand
while bullet != 0
    do match? tree.nodes[bullet]
        | .node-bullet-expression(row)
            if row.is-multi
                spreading = bullet
                emit-spread(bullet, row.item, row.is-optional)
                spreading = 0
            else
                . value = convert-matched(row.item, .reason-explicit, emit-expression(row.item), no-type)
                if row.is-optional && !types.is-optional(value.type) && reason == .reason-return
                    refuse(.refused-expression, bullet)
                append-built(facts.bullet-site(unit.reading, bullet), value, row.is-optional)
    bullet = next-bullet(bullet)
. built = close-value(list, mark, own-scoping, home)
built-list = outer-list
built-item = outer-item
built-append = outer-append
built-reason = outer-reason
spreading = outer-spreading
= built

────────────────────
_ do built-value Typed
    - site SyntaxId
    - value Typed

. converted = value
if built-reason == .reason-element
    converted = convert-matched(site, .reason-explicit, converted, built-item)
= convert-matched(site, built-reason, converted, built-item)

────────────────────
_ do append-built
    - site SyntaxId
    - given-value Typed
    - optional Bool

. staying = no-block
. value = given-value
if optional && types.is-optional(value.type)
    . held = value.type
    . tested = present(site, value)
    . given-block = ir.reserve-block()
    staying = ir.reserve-block()
    branch(tested.operand, given-block, staying)
    ir.start-block(given-block)
    value = payload(site, Typed(value.operand, held))
value = built-value(site, value)
if value.type != built-item
    refuse(.refused-conversion, site)
    =
. mark = pending.length
pending += built-list
pending += value.operand
call-method(built-append, site, mark)
if staying != no-block
    jump(staying)
    ir.start-block(staying)

────────────────────
_ do emit-spread
    - bullet SyntaxId
    - item SyntaxId
    - optional Bool

` A bullet that gives every item of what it writes. Of a range of integers written there,
` the loop that counts through it. Of a container, a loop over it by the protocol the type
` pass planned at the bullet, whose slots keep the container, converted first to the iterable
` it is read as where it is not one: `**?` reads what an optional holds and gives nothing
` where it holds none. Each item is yielded as it is read. What the
` loop does at the bullet is located on the line under it where the type pass noted that.
. plan = facts.plan-of(unit.reading, bullet)
if plan == .plan-range-loop && !optional
    do match? tree.nodes[item]
        | .node-range-expression(range)
            emit-range-loop(bullet, range.op, range.left, range.right, 0, 0)
            =
if plan != .plan-index-loop && plan != .plan-cursor-loop && plan != .plan-stream-loop
    refuse(.refused-expression, bullet)
    =
. slot = loop-slots(bullet)
. held = convert(item, .reason-explicit, emit-expression(item))
. beyond = no-block
if optional && types.is-optional(held.type)
    . wrapped = held.type
    . given = ir.reserve-block()
    beyond = ir.reserve-block()
    branch(present(bullet, held).operand, given, beyond)
    ir.start-block(given)
    held = payload(bullet, Typed(held.operand, wrapped))
. site = facts.bullet-site(unit.reading, bullet)
if site != 0
    held = convert(site, .reason-operand, held)
keep-state(slot, held.operand, held.type, bullet)
. shifted = lowered
lowered = if facts.is-bullet-below(unit.reading, bullet) then bullet else 0
emit-headed(bullet, item, 0, 0, true)
lowered = shifted
if beyond != no-block
    jump(beyond)
    ir.start-block(beyond)

────────────────────
_ protocol-calls FactId
    - loop SyntaxId

` The calls the type pass recorded for the protocol of a loop, in the order the loop makes
` them: at the header of a loop, and for a bullet that gives every item of a container from
` the first the type pass kept for it, beside others where it kept them, as at a bullet that
` also keeps those of the first bullet of its list.
|? facts.bullet-site(unit.reading, loop) != loop || start != no-fact
    start
??
    facts.first-call(unit.reading, loop)

.. start = facts.protocol-start(unit.reading, loop)

────────────────────
_ do open-turn
    - loop SyntaxId
    - item Operand
    - type TypeId

` Starts a turn of a loop whose body declares a local that nested functions capture. The
` turn has an environment of its own: an object the collector owns, which arrives zeroed,
` with the link to the environment in force around the loop. A nested function written in
` the turn is given it, so that each turn's functions read that turn's locals. The item of
` the turn is copied there under each name it is captured by: the one the loop writes for
` it, `each` and `it`. A local holds the environment of the turn; in a function that
` yields, a field of the function's own environment does, which keeps it from one step to
` the next.
if unit.instance == no-instance
    =
. scope = tables.turn-scope(instances.rows[unit.instance].module, loop)
if scope == no-scope
    =
. layout = tables.turn-environment(unit.instance, scope)
if unit.reading != unit.instance || layout == no-layout || layout == unbuilt-environment
    refuse(.refused-statement, loop)
    =
. place = if stepping then tables.turn-place(unit.instance, scope) else no-place
if stepping && (place == no-place || unit.environment == no-local)
    refuse(.refused-statement, loop)
    =
. link = written-environment(loop)
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. made = call-runtime(.runtime-allocate-object, loop, mark, managed-layout)
. local = no-local
if stepping
    . field = tables.layouts.field(tables.environments[unit.instance], place)
    store(load-local(unit.environment, loop), field.offset, made, true, loop)
else
    local = ir.add-local(managed-layout)
    store-local(local, made, loop)
store(made, 0, link, true, loop)
open-turns += TurnScope(scope, local, place)
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    . kind = bindings.slots[slot].kind
    if tables.slot-homes[slot] != scope
        continue
    if kind == .slot-each || kind == .slot-it || whole-item
        keep-captured(slot, item, type, loop)
    .. whole-item = kind == .slot-loop-item && facts.loop-take(unit.reading, loop) == .take-whole

────────────────────
_ do close-turns
    - mark Size

` Ends the turns opened since `mark`, where the body of their loop has been emitted.
while open-turns.length > mark
    open-turns.pop()

────────────────────
_ do turn-held Operand
    - local LocalId
    - place U32
    - site SyntaxId

` The environment of a turn of a loop being emitted: what the local for it holds, or in a
` function that yields what the field for it of the function's own environment holds.
if local != no-local
    = load-local(local, site)
. field = tables.layouts.field(tables.environments[unit.instance], place)
= load(load-local(unit.environment, site), field.offset, managed-layout, site)

────────────────────
_ is-turned Bool
    - slot SlotId

` Whether a slot is kept in the environment of a turn of a loop or of an activation.
tables.slot-homes[slot] != no-scope && tables.is-turn-scope(tables.slot-homes[slot])

────────────────────
_ do written-environment Operand
    - id SyntaxId

` The environment in force where a nested function is written, which its body reads the
` locals it captures from: that of the innermost turn being emitted, where an activation with
` none of its own has the one around it (`turn-link`), or else the function's own, or else the
` one the function was given, or nothing where it has none. A nested function written at the
` node is made here, so the lazy locals it reads that are held as eager locals are given their
` values first (`force-captured`).
force-captured(id)
. top = open-turns.length
if top != 0 && open-turns[top - 1].local == no-local && open-turns[top - 1].place == no-place
    = turn-link(open-turns[top - 1].scope, id)
if top != 0
    = turn-held(open-turns[top - 1].local, open-turns[top - 1].place, id)
= function-environment(id)

────────────────────
_ do function-environment Operand
    - id SyntaxId

` The environment of the function being emitted where a nested function is written outside any
` turn: its own, or else the one it was given, or nothing where it has none.
if unit.environment != no-local
    = load-local(unit.environment, id)
if unit.own-scope != no-scope && tables.environments[unit.instance] != no-layout
    refuse(.refused-expression, id)
if unit.received
    = given-environment(id)
= integer(.machine-managed-pointer, 0)

────────────────────
_ do loop-slots SlotId
    - loop SyntaxId

` The first of the slots the binder declared for what a loop keeps, in the function whose
` facts are being read, which is the one emitted.
. binding = instances.rows[unit.reading].binding
. slot = no-slot
if binding != no-binding && unit.reading == unit.instance
    slot = bindings.loop-state(binding, loop)
if slot == no-slot
    refuse(.refused-statement, loop)
= slot

────────────────────
_ do call-protocol Typed
    - site SyntaxId
    - fact FactId
    - receiver Operand
    - type TypeId
    - argument Operand
    - given TypeId = no-type
    - watched Bool = true
    - second Operand? = null
    - second-given TypeId = no-type
    - third Operand? = null
    - third-given TypeId = no-type

` A call the type pass recorded at a loop for its container, at a pattern for its subject, or for a
` helper a pattern is given, which no call in the source writes: of a function declared for the
` container's type or for a class it is derived from, with the container as it is and up to three
` arguments, each of the type the function takes or of another that is held the same. A call that
` would convert any has no shape here. A function some class declares again is chosen by the class
` of the object, as a call written in source is. An error the function raises is a panic at the
` loop, with the error's text as its message, but where the type pass says the call's errors leave
` the function with it, as a loop's read of a generator that raises does. A loop's call is
` `watched`, checked for a panic even where no other call of the function is: the reference notices
` a panic raised under a loop's read as the loop ends. A function a property the container
` delegates to answers is called with what the property holds.
. nothing = make-operand(.operand-void, 0)
if fact == no-fact || facts.calls[fact].callee == no-instance || uncallable
    refuse(.refused-statement, site)
    = Typed(nothing, no-type)
.. uncallable = !is-callable(facts.calls[fact].callee)
. callee = facts.calls[fact].callee
. declared = instances.rows[callee].self-type
. signature = instances.signatures[callee]
. object = receiver
. holder = type
if facts.calls[fact].through.count != 0
    . reached = read-through(site, Typed(receiver, type), facts.calls[fact].through)
    object = reached.operand
    holder = reached.type
. derived = tables.is-class(holder) && tables.is-class(declared) && tables.derives(holder, declared)
. count U32 = if given == no-type then 0 else if second-given == no-type then 1 else if third-given == no-type then 2 else 3
if (declared != holder && !derived) || signature.args.count != count
    refuse(.refused-statement, site)
    = Typed(nothing, no-type)
if given != no-type && layout-of(instances.argument-type(callee, 0), site) != layout-of(given, site)
    refuse(.refused-statement, site)
if second-given != no-type && layout-of(second-type, site) != layout-of(second-given, site)
    refuse(.refused-statement, site)
.. second-type = instances.argument-type(callee, 1)
if third-given != no-type && layout-of(third-type, site) != layout-of(third-given, site)
    refuse(.refused-statement, site)
.. third-type = instances.argument-type(callee, 2)
. raising = signature.errors.count != 0
. mark = pending.length
pending += object
if given != no-type
    pending += argument
if second-given != no-type
    pending += second!
if third-given != no-type
    pending += third!
takes-result = raising
. answer = Typed(nothing, no-type)
. start ValueId = ir.instructions.length as ValueId
. called ValueId = U32.max
if tables.is-class(holder) && tables.is-overridden(callee)
    answer = call-method(callee, site, mark)
else
    answer = call-instance(callee, site, mark, false, watched)
    called = last-call(start)
if raising && facts.calls[fact].propagates
    answer = propagate(site, callee, answer.operand)
else if raising
    answer = panic-on-error(site, callee, answer.operand)
protocol-row = called
= answer

────────────────────
_ do emit-headed
    - first SyntaxId
    - written SyntaxId
    - clause SyntaxId
    - body SyntaxId
    - kept Bool = false

` A loop over the container of each of its headers, by the protocol the type pass planned
` for each: by its indexes, by a cursor, or as a stream. A bullet that gives every item of
` a container is such a loop of one header, whose container the bullet keeps already (`kept`).
` 1. Every container is evaluated, in the order written, and then each is begun. From there
`    on, telling the streams among them that the loop has ended is a cleanup: it runs
`    however the loop is left, as the body of a `do finally` written there would.
` 2. A turn reads an item of each header in order. The head of a header polls and reads,
`    and a container with no more ends the loop. The header takes the item and tests its
`    clause; an item that does not match, or a `when` that fails, reads that header again.
` 3. The body runs. `continue` goes to the first head, as the end of the body does. The
`    body of a comprehension's loop is an expression, and is yielded, and a bullet has no
`    body and yields the item.
` In a cleanup being run, a check made in the loop lands where the cleanup ends, as in the rest
` of it, leaving its streams unended, as TypeScript's does (`end-in-cleanup`). A header that
` subscribes, the loop of a comprehension whose first header writes a pattern that is no match,
` and a stream read where the collector never looks have no shape.
. chain [SyntaxId]
. containers [SyntaxId]
. clauses [SyntaxId]
. streams = false
. header = first
. container = written
. tested = clause
while header != 0
    . plan = facts.plan-of(unit.reading, header)
    . next SyntaxId = 0
    do match? tree.nodes[header]
        | .node-loop-syntax(row)
            next = row.next
            if row.is-subscriber || (header == given-loop && !takes-item(header))
                refuse(.refused-statement, header)
    if plan == .plan-stream-loop
        streams = true
    else if !is-index-loop-plan(plan) && !is-cursor-loop-plan(plan) && other-loop-plan
        refuse(.refused-statement, header)
    .. other-loop-plan = plan != .plan-table-loop && plan != .plan-pattern-loop
    chain += header
    containers += container
    clauses += tested
    header = next
    do match? tree.nodes[header]
        | .node-loop-syntax(row)
            container = row.container
            tested = row.clause
. caught = landing
if streams && (is-free(unit.instance) || (scoping.cleaning && caught == no-block))
    refuse(.refused-statement, first)
    =
. pin-mark = pins.length
. slots [SlotId]
. kinds [TypeId]
. made = make-operand(.operand-void, 0)
for position in 0 .. < chain.length
    . slot = loop-slots(chain[position])
    . kind = hold-container(chain[position], containers[position], slot, kept && position == 0)
    made = holding
    slots += slot
    kinds += kind
protocol-row = U32.max
for position in 0 .. < chain.length
    begin-items(chain[position], containers[position], slots[position], kinds[position])
. stream = U32.max
if chain.length == 1 && streams && !stepping && value-made
    stream = ir.streams.length as U32
    ir.streams.append(IRStream(made, protocol-row, U32.max, IdList()))
    stream-loops += first
.. value-made = operand-kind(made) == .operand-value || operand-kind(made) == .operand-argument
. mark = open-cleanups.length
. own-scoping = scoping
if streams
    scoping = scoping.block-base = mark
    open-cleanup(first, UseCell(no-local, no-local, no-type))
    if scoping.cleaning
        landing = caught
. root = ir.reserve-block()
. done = ir.reserve-block()
. turns = open-turns.length
. depth = loops.length
. named = bound.length
. captured = stream-captures.length
. last = no-slot
jump(root)
. head = root
for position in 0 .. < chain.length
    . loop = chain[position]
    if position != 0
        head = ir.reserve-block()
        jump(head)
    ir.start-block(head)
    emit-poll(loop)
    . polled = ir.current
    protocol-row = U32.max
    . item = read-items(loop, first, containers[position], slots[position], kinds[position], done)
    if stream != U32.max
        ir.streams[stream].read = protocol-row
        ir.streams[stream].head = head
        ir.streams[stream].polled = polled
        ir.streams[stream].done = done
    . type = item.type
    last = slots[position] + loop-state-count - 1
    take-item(loop, last, item.operand, type, head)
    . turned = facts.slot-type(unit.instance, slot-offset(last, loop))
    loops += EmittedLoop(loop, root, done, item.operand, turned, open-cleanups.length, last)
    emit-clause(clauses[position], head, done)
if first == given-loop
    emit-yield(body, body, false)
else if gives-items(first, body)
    give-item(first, facts.bullet-site(unit.reading, first), state(last, first))
else if body != 0
    emit-block(body)
close-turns(turns)
drop-bound(named)
drop-captures(captured)
while loops.length > depth
    loops.pop()
for ended in chain
    forget-item(ended)
jump(root)
ir.start-block(done)
if streams && scoping.cleaning
    end-in-cleanup(mark, caught)
else if streams
    close-cleanups(mark)
if streams
    scoping = own-scoping
unpin(pin-mark)

────────────────────
_ do end-in-cleanup
    - mark Size
    - caught IRBlockId

` Where a loop that reads a stream in a cleanup being run ends: its own cleanups run, newest
` first, and a check made in one lands where the cleanup around ends, as one made in the loop
` does. They are open no longer.
while open-cleanups.length > mark
    landing = caught
    run-cleanup(open-cleanups[open-cleanups.length - 1].body, open-cleanups[open-cleanups.length - 1].cell)
    open-cleanups.pop()
landing = caught

────────────────────
_ do begin-items
    - loop SyntaxId
    - container SyntaxId
    - slot SlotId
    - type TypeId

` Begins what a header of a loop reads its container by, once every container of the loop
` is held. By its indexes: the length is read once, by the getter the type pass recorded
` for it or as the field of an array a constant fact names, and the count of items read
` starts at none. By a cursor: the container gives the state the cursor starts at. As a
` stream: the container is told that the loop begins. As a stream pattern: the stream the
` pattern reads the container through is made and kept.
. nothing = make-operand(.operand-void, 0)
. plan = facts.plan-of(unit.reading, loop)
if plan == .plan-table-loop
    keep-state(slot + 2, integer(.machine-u64, 0), types.size-type, loop)
    =
if plan == .plan-pattern-loop
    . held = state(slot, loop)
    . stream = stream-of(loop, held.operand, type, stream-maker(loop))
    keep-state(slot + 1, stream.operand, stream.type, loop)
    =
. begins = protocol-calls(loop)
if begins == no-fact
    refuse(.refused-statement, loop)
    =
if is-index-loop-plan(plan)
    . length = Typed(nothing, no-type)
    if facts.calls[begins].form == .call-getter
        length = call-protocol(loop, begins, container-of(loop, container, slot).operand, type, nothing)
    else
        length = array-length(loop, container-of(loop, container, slot).operand, type)
    if length.type != types.size-type
        refuse(.refused-statement, loop)
        =
    keep-state(slot + 1, length.operand, types.size-type, loop)
    keep-state(slot + 2, integer(.machine-u64, 0), types.size-type, loop)
    =
if is-cursor-loop-plan(plan)
    if facts.calls[begins].form != .call-getter
        refuse(.refused-statement, loop)
        =
    . started = call-protocol(loop, begins, container-of(loop, container, slot).operand, type, nothing)
    keep-state(slot + 1, started.operand, started.type, loop)
    =
. reads = facts.calls[begins].next
if reads == no-fact || facts.calls[reads].next == no-fact
    refuse(.refused-statement, loop)
    =
call-protocol(loop, begins, state(slot, loop).operand, type, nothing)

────────────────────
_ do read-items Typed
    - loop SyntaxId
    - place SyntaxId
    - container SyntaxId
    - slot SlotId
    - type TypeId
    - done IRBlockId

` Reads the next item of a header of a loop, where its head has polled, and leaves to
` `done` where its container has no more. By its indexes: the count of items read is tested
` against the length and moves on, and the item at the index it had is read by the
` container's `[]`. By a cursor: the container's function takes the state and gives the
` next with an item, or with none. As a stream: the container gives an item, or nothing,
` which is converted as the type pass said where a property the container delegates to gives
` it. As a stream pattern: the pattern matches once more on the stream kept for it.
` The calls are made at `place`, the loop's first header, where TypeScript makes the reads of
` every header.
. nothing = make-operand(.operand-void, 0)
. plan = facts.plan-of(unit.reading, loop)
if plan == .plan-table-loop
    = read-row(loop, slot, done)
if plan == .plan-pattern-loop
    = read-step(loop, slot, type, done)
. begins = protocol-calls(loop)
if begins == no-fact
    refuse(.refused-statement, loop)
    = Typed(nothing, no-type)
. inside = ir.reserve-block()
if is-index-loop-plan(plan)
    . reads = if facts.calls[begins].form == .call-getter then facts.calls[begins].next else begins
    branch(compare(loop, .compare-less, state(slot + 2, loop).operand, state(slot + 1, loop).operand), inside, done)
    ir.start-block(inside)
    . index = state(slot + 2, loop)
    . moved = arithmetic(loop, .arithmetic-add, index.operand, integer(.machine-u64, 1), u64-layout)
    keep-state(slot + 2, moved, types.size-type, loop)
    = call-protocol
        - place
        - reads
        - container-of(loop, container, slot).operand
        - type
        - index.operand
        - types.index-type
. next = nothing
. given = no-type
if is-cursor-loop-plan(plan)
    . offset = slot-offset(slot + 1, loop)
    . cursor = facts.slot-type(unit.instance, offset)
    . steps = facts.calls[begins].next
    . stepped = call-protocol
        - place
        - steps
        - container-of(loop, container, slot).operand
        - type
        - state(slot + 1, loop).operand
        - cursor
    . answer = stepped.type
    . layout = layout-of(answer, loop)
    if !tables.layouts.is-struct(layout) || unpaired
        refuse(.refused-statement, loop)
        = Typed(nothing, no-type)
    .. unpaired = tables.layouts.rows[layout].fields.count != 2
    given = field-type(answer, 1)
    if field-type(answer, 0) != cursor
        refuse(.refused-statement, loop)
        = Typed(nothing, no-type)
    keep-state(slot + 1, take(stepped.operand, tables.layouts.field(layout, 0), loop), cursor, loop)
    next = take(stepped.operand, tables.layouts.field(layout, 1), loop)
else
    . answered = call-protocol(place, facts.calls[begins].next, state(slot, loop).operand, type, nothing)
    next = answered.operand
    given = answered.type
if !types.is-optional(given)
    refuse(.refused-statement, loop)
    = Typed(nothing, no-type)
branch(present(loop, Typed(next, given)).operand, inside, done)
ir.start-block(inside)
= convert(loop, .reason-element, payload(loop, Typed(next, given)))

────────────────────
_ do read-step Typed
    - loop SyntaxId
    - slot SlotId
    - type TypeId
    - done IRBlockId

` One pass of a loop whose header is a stream pattern, as the reference makes it: the stream
` kept for the loop is asked whether it has more, and the loop ends where it has not; it
` gives its view, and the pattern is matched from where the view starts, as a rule's arms
` are, without reading the rest, asking the stream for more input where a part reads past
` the end of its buffer. Where it passes, the stream commits where it ended, and the item is
` what it gives; where it fails, the stream commits where it started, and the loop ends.
` Where it passed without moving the stream on, it panics, as a pipe does. The names it
` captures stay bound for the body.
. nothing = make-operand(.operand-void, 0)
. pattern = step-pattern(loop)
. result = if pattern != 0 then facts.node-type(unit.reading, pattern) else no-type
. made = stream-maker(loop)
. viewed = if made != no-fact then next-call(made) else facts.first-call(unit.reading, loop)
. commits = next-call(viewed)
. extends = next-call(commits)
. asks = next-call(extends)
if result == no-type || result == invalid-type || asks == no-fact
    refuse(.refused-statement, loop)
    = Typed(nothing, no-type)
. stream = state(slot + 1, loop)
. stream-type = stream.type
. more = call-protocol(loop, asks, stream.operand, stream-type, nothing)
if more.type != types.bool-type
    refuse(.refused-statement, loop)
    = Typed(nothing, no-type)
. reading = ir.reserve-block()
branch(compare(loop, .compare-not-equal, more.operand, integer(.machine-u8, 0)), reading, done)
ir.start-block(reading)
. refills = made == no-fact || chunked
    .. chunked = same-ref(class-ref(types, stream-type), types.chunked-token-stream-decl)
. run = view-stream(loop, stream.operand, stream-type, refills, viewed, extends)
. value = attempt-arms(loop, pattern, result, run, false, commits, done, true)
=? value if value.type == no-type
. moved = ir.reserve-block()
. stuck = ir.reserve-block()
branch(compare(loop, .compare-greater, load-local(attempt-end, loop), run.start), moved, stuck)
ir.start-block(stuck)
raise-text(loop, "Stream pattern loop made no input progress")
ir.start-block(moved)
= value

────────────────────
_ step-pattern SyntaxId
    - loop SyntaxId

` The stream pattern a loop's header is written as, out of the match that holds it where one
` does.
match tree.nodes[loop]
    | .node-loop-syntax(row)
        match tree.nodes[row.pattern]
            | .node-stream-match(written)
                written.pattern
            ??
                row.pattern
    ??
        0

────────────────────
_ stream-maker FactId
    - site SyntaxId

` The call the type pass recorded at a stream pattern or a loop's header that makes the
` stream it reads its subject through; none where the subject is a stream already.
if first != no-fact && facts.calls[first].form == .call-constructor then first else no-fact

.. first = facts.first-call(unit.reading, site)

────────────────────
_ do read-row Typed
    - loop SyntaxId
    - slot SlotId
    - done IRBlockId

` The next row of a loop over a table or a span of one, or a leave to `done` once the count
` read reaches the count of rows: the first row moved on by the count read.
. offset = slot-offset(slot, loop)
. row = facts.slot-type(unit.instance, offset)
if intrinsic(row) == .table-selection || intrinsic(row) == .immutable-table-selection
    = read-selected(loop, slot, row, done)
if intrinsic(row) == .index-span
    = read-index(loop, slot, row, done)
. layout = layout-of(row, loop)
. inside = ir.reserve-block()
branch(compare(loop, .compare-less, state(slot + 2, loop).operand, state(slot + 1, loop).operand), inside, done)
ir.start-block(inside)
. count = state(slot + 2, loop)
keep-state
    - slot + 2
    - arithmetic(loop, .arithmetic-add, count.operand, integer(.machine-u64, 1), u64-layout)
    - types.size-type
    - loop
. first = state(slot, loop)
. made = frame(layout)
copy(made, first.operand, layout, false, loop)
put
    - made
    - tables.layouts.field(layout, 1)
    - arithmetic(loop, .arithmetic-add, part(first.operand, layout, 1, loop).operand, count.operand, u64-layout)
    - loop
= Typed(made, row)

────────────────────
_ do take-item
    - loop SyntaxId
    - last SlotId
    - item Operand
    - type TypeId
    - head IRBlockId

` What a header of a loop does with an item it has read, as the type pass decided. The item
` is kept in the last of the header's slots, where the body reads it. A turn whose locals
` nested functions capture gets an environment of its own. Then the header's pattern takes
` the item: one that names it whole does no more; one that writes names for the fields of a
` tuple takes it apart; one written as a match (`for | pattern in`) passes over an item it
` does not fit, and the header reads its next; and any other is one a declaration is
` written with, a type for the name or a pattern, which panics where the item does not fit.
` A match written with arms gives the body what the arm an item fits gives, as
` `take-matched` emits it. A comprehension's own loop that takes its item apart, and a
` pattern matched that is not written as a match, have no shape yet.
. take = facts.loop-take(unit.reading, loop)
. pattern SyntaxId = 0
. written SyntaxId = 0
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        written = row.pattern
        pattern = matched-name(row.pattern)
if take == .take-arms
    take-matched(loop, written, pattern, last, item, type, head)
    =
keep-state(last, item, type, loop)
open-turn(loop, item, type)
if take == .take-whole
    =
if take == .take-unshaped || (pattern == written && (loop == given-loop || take == .take-fitted))
    refuse(.refused-statement, loop)
    =
if take == .take-fields
    destructure(loop, field-names(pattern), state(last, loop).operand, type, true, true)
    =
. held = state(last, loop)
. own-matching = matching
if take == .take-converted
    do match? tree.nodes[pattern]
        | .node-type-capture(capture)
            . given = convert(capture.type, .reason-declaration, Typed(held.operand, type), capture.id)
            matching = matching.declaring = true
            bind-name(capture.id, given)
            matching = own-matching
            =
    refuse(.refused-statement, loop)
    =
if take == .take-declared
    shape-declared(loop, pattern, Typed(held.operand, type))
    =
. failed = ir.reserve-block()
. passed = ir.reserve-block()
matching = matching.declaring = true
emit-pattern(pattern, Typed(held.operand, type), failed)
matching = own-matching
jump(passed)
ir.start-block(failed)
jump(head)
ir.start-block(passed)

────────────────────
_ do take-matched
    - loop SyntaxId
    - match SyntaxId
    - arms SyntaxId
    - last SlotId
    - item Operand
    - type TypeId
    - head IRBlockId

` What a header whose pattern is the arms of a match does with an item it has read. The
` arms are tried on the item in the order written, and what the first that fits gives is
` the item of the turn, kept where the body reads it, in the type the type pass gave the
` arms. `it` in an arm is the item as read. An item no arm fits is passed over, and so is one
` whose arm gives an optional that holds nothing: the header reads its next.
. given = facts.node-type(unit.reading, match)
if given == no-type || given == invalid-type
    refuse(.refused-statement, loop)
    =
. layout = layout-of(given, loop)
if layout == void-layout
    refuse(.refused-statement, loop)
    =
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. named = bound.length
. own-matching = matching
matching = matching.declaring = true
loops += EmittedLoop(loop, head, head, item, type, open-cleanups.length, no-slot)
. is-closed = match-arms(match, arms, item, type, given, given, joined, slot)
loops.pop()
matching = own-matching
drop-bound(named)
if !is-closed
    jump(head)
if operand-kind(slot) == .operand-void && joins.length == mark
    refuse(.refused-statement, loop)
. value = close-joins(joined, mark, layout, slot)
. kept = given
if types.is-optional(given)
    . passed = ir.reserve-block()
    branch(present(loop, Typed(value, given)).operand, passed, head)
    ir.start-block(passed)
    . inner = payload(loop, Typed(value, given))
    value = inner.operand
    kept = inner.type
keep-state(last, value, kept, loop)
open-turn(loop, value, kept)

────────────────────
_ do array-length Typed
    - loop SyntaxId
    - array Operand
    - type TypeId

` The length of an array a loop counts through: the field of it that the constant fact at
` the loop names.
. nothing = make-operand(.operand-void, 0)
. place = facts.constant-of(unit.reading, loop)
. layout = layout-of(type, loop)
if place == no-fact || !tables.layouts.is-struct(layout)
    refuse(.refused-statement, loop)
    = Typed(nothing, no-type)
. position = facts.constants[place].bits as U32
if position >= tables.layouts.rows[layout].fields.count
    refuse(.refused-statement, loop)
    = Typed(nothing, no-type)
= Typed(take(array, tables.layouts.field(layout, position), loop), field-type(type, position))

────────────────────
_ do end-streams
    - first SyntaxId

` Tells each container a loop reads as a stream that the loop has ended, in the order of
` its headers: the cleanup the loop opened where it began, emitted on each way out.
. header = first
while header != 0
    if facts.plan-of(unit.reading, header) == .plan-stream-loop
        end-stream(header)
    . next SyntaxId = 0
    do match? tree.nodes[header]
        | .node-loop-syntax(row)
            next = row.next
    header = next

────────────────────
_ do end-stream
    - loop SyntaxId

` Tells the container of a header that reads a stream that the loop has ended.
. slot = loop-slots(loop)
. held = state(slot, loop)
. type = held.type
. begins = protocol-calls(loop)
. reads = if begins == no-fact then no-fact else facts.calls[begins].next
if reads == no-fact
    refuse(.refused-statement, loop)
    =
call-protocol(loop, facts.calls[reads].next, held.operand, type, make-operand(.operand-void, 0))
for back in 0 .. < stream-loops.length
    . position = stream-loops.length - 1 - back
    if stream-loops[position] == loop
        ir.end-stream(position as U32, protocol-row)
        =

────────────────────
_ do last-call ValueId
    - start ValueId

. count = ir.instructions.length
for back in 0 .. < count - start
    . op = ir.instructions[count - 1 - back].op
    if op == .op-call || op == .op-call-void
        = (count - 1 - back) as ValueId
= U32.max

────────────────────
_ do run-cleanup
    - body SyntaxId
    - cell UseCell

` One cleanup, emitted where a way out runs it: the body of a `do finally`, for the first
` header of a loop that reads a stream, a bullet that gives every item of one, or a pipe
` whose loop writes each item of one, the calls that end the iteration of its streams, for a
` `use` or `do use` the call that ends the use of its object, and for a `do without cancel`
` block the call that lets go of its hold on cancellation.
if cell.is-live-call
    do call-instance(instances.live.leave, body, pending.length)
    =
if writes-each(body)
    end-streams(body)
    =
do match? tree.nodes[body]
    | .node-loop-syntax
        end-streams(body)
        =
    | .node-bullet-expression
        end-streams(body)
        =
    | .node-use-expression
        end-use(body, cell)
        =
    | .node-use-block
        end-use(body, cell)
        =
    | .node-stack-local-binding-block
        unbind-stack(body, cell)
        =
    | .node-probe-group
        emit-probe-group-end(body, 1)
        =
    | .node-do-block
        call-runtime(.runtime-leave-cancel-shield, body, pending.length)
        =
emit-block(body)

────────────────────
_ do end-use
    - id SyntaxId
    - cell UseCell

` Ends a use where a way out of its block runs it: `ending-call` is called on the object kept.
` The object of a `use` is kept only where its flag says so, or its slot holds it, and is taken
` out first: a copy is made and the flag or the slot cleared, so a way out that runs it again
` ends nothing.
. begins = facts.first-call(unit.reading, id)
. ends = if begins == no-fact then no-fact else ending-call(begins)
if cell.held == no-local
    end-kept-use(id, ends, cell.type)
    =
. layout = ir.locals[cell.held].layout
. ended = no-block
if cell.flag != no-local
    . filled = ir.reserve-block()
    ended = ir.reserve-block()
    branch(load-local(cell.flag, id), filled, ended)
    ir.start-block(filled)
. object = load-local(cell.held, id)
if tables.layouts.is-struct(layout)
    object = snapshot(object, layout, id)
if cell.flag != no-local
    store-local(cell.flag, integer(.machine-u8, 0), id)
call-protocol(id, ends, object, cell.type, make-operand(.operand-void, 0))
if ended != no-block
    jump(ended)
    ir.start-block(ended)

────────────────────
_ do end-kept-use
    - id SyntaxId
    - ends FactId
    - type TypeId

` Ends a `use` whose slot keeps its object, where the slot holds one.
. slot = using-slot(id)
. kept = state(slot, id)
. kept-type = kept.type
. filled = ir.reserve-block()
. ended = ir.reserve-block()
branch(present(id, kept).operand, filled, ended)
ir.start-block(filled)
. object = payload(id, Typed(kept.operand, kept-type))
. layout = layout-of(type, id)
if object.type != type
    refuse(.refused-statement, id)
    =
if tables.layouts.is-struct(layout)
    object = Typed(snapshot(object.operand, layout, id), object.type)
keep-state(slot, empty-optional(kept-type, layout-of(kept-type, id)).operand, kept-type, id)
call-protocol(id, ends, object.operand, type, make-operand(.operand-void, 0))
jump(ended)
ir.start-block(ended)

────────────────────
_ do emit-range-loop
    - loop SyntaxId
    - op Operator
    - first SyntaxId
    - last SyntaxId
    - clause SyntaxId
    - body SyntaxId

` A loop over a range of integers. Both ends are evaluated once, in the item's type. The loop
` counts up, or down when it starts above its end, which is decided once; one of an unsigned type
` that starts at a written 0 only counts up. A range written with
` `..` takes its end as an item and stops after it, and any other stops before its end. In
` a function that yields, the index, the end and the way it counts are kept in the loop's
` slots, and read again on each pass. The loop of a bullet that gives every item of a range
` has no body, and yields the item.
` 1. The head polls, then tests the index against the end.
` 2. Inside, the item is the index, the clause is tested, and the body runs.
` 3. The step ends the loop at an end the range takes, and otherwise moves the index.
. start = convert(first, .reason-element, emit-expression(first))
. type = start.type
. layout = layout-of(type, loop)
. counted = body != 0 && !stepping && !is-signed(layout) && range-plan && constant-bound
    .. range-plan = facts.plan-of(unit.reading, loop) == .plan-range-loop
    .. constant-bound = facts.constant-of(unit.reading, loop) != no-fact
. end = convert
    - last
    - .reason-element
    - if counted then counted-end(loop, last) else emit-expression(last)
if end.type != type
    refuse(.refused-conversion, loop)
    =
if !is-integer(layout) || !is-numeric-type(type)
    refuse(.refused-type, loop)
    =
if counted
    emit-counted-loop(loop, start.operand, end.operand, type, layout, clause, body)
    =
. wide = if tables.layouts.rows[layout].size >= 4 then layout else i32-layout
. rising = !is-signed(layout) && is-written-zero(first)
. falls = if rising then integer(.machine-u8, 0) else compare(loop, .compare-greater, start.operand, end.operand)
. pace = range-pace(loop, falls, wide, rising)
. index = no-local
. kept = no-slot
if stepping
    kept = loop-slots(loop)
    keep-state(kept, start.operand, type, loop)
    keep-state(kept + 1, end.operand, type, loop)
    keep-state(kept + 2, falls, types.bool-type, loop)
else
    index = ir.add-local(layout)
    store-local(index, start.operand, loop)
. head = ir.reserve-block()
. inside = ir.reserve-block()
. step = ir.reserve-block()
. done = ir.reserve-block()
jump(head)

ir.start-block(head)
emit-poll(loop)
. takes-end = op == .range-through-op
if stepping
    end = state(kept + 1, loop)
    falls = state(kept + 2, loop).operand
. item = if stepping then state(kept, loop) else Typed(load-local(index, loop), type)
. below = if takes-end then .compare-less-equal else .compare-less
if rising
    branch(compare(loop, below, item.operand, end.operand), inside, done)
else
    . up = ir.reserve-block()
    . down = ir.reserve-block()
    branch(falls, down, up)
    ir.start-block(down)
    branch
        - compare(loop, if takes-end then .compare-greater-equal else .compare-greater, item.operand, end.operand)
        - inside
        - done
    ir.start-block(up)
    branch(compare(loop, below, item.operand, end.operand), inside, done)

ir.start-block(inside)
. turns = open-turns.length
open-turn(loop, item.operand, type)
loops += EmittedLoop(loop, step, done, item.operand, type, open-cleanups.length, kept)
emit-clause(clause, step, done)
if gives-items(loop, body)
    give-item(loop, facts.bullet-site(unit.reading, loop), read-item(loop, loop, type))
else if body != 0
    emit-block(body)
close-turns(turns)
loops.pop()
jump(step)

ir.start-block(step)
if stepping
    item = state(kept, loop)
    end = state(kept + 1, loop)
    pace = range-pace(loop, state(kept + 2, loop).operand, wide, rising)
if takes-end
    . moving = ir.reserve-block()
    branch(compare(loop, .compare-equal, item.operand, end.operand), done, moving)
    ir.start-block(moving)
. moved = num-cast
    - loop
    - arithmetic(loop, .arithmetic-add, num-cast(loop, item.operand, layout, wide), pace, wide)
    - wide
    - layout
if stepping
    keep-state(kept, moved, type, loop)
else
    store-local(index, moved, loop)
jump(head)
ir.start-block(done)
forget-proven(loop)

────────────────────
_ do range-pace Operand
    - loop SyntaxId
    - falls Operand
    - wide LayoutId
    - rising Bool

if rising
    = integer(wide as MachineKind, 1)
. rises = bitwise(loop, .bitwise-xor, falls, integer(.machine-u8, 1), u8-layout)
= arithmetic
    - loop
    - .arithmetic-subtract
    - num-cast(loop, rises, u8-layout, wide)
    - num-cast(loop, falls, u8-layout, wide)
    - wide

────────────────────
_ gives-items Bool
    - loop SyntaxId
    - body SyntaxId

body == 0 && !(tree.nodes[loop] is .node-loop-syntax)

────────────────────
_ is-written-zero Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-integer-syntax(row)
        !row.unit && parse-integer-literal(row.value).value == 0
    ??
        false

────────────────────
_ do counted-end Typed
    - loop SyntaxId
    - last SyntaxId

do match? tree.nodes[last]
    | .node-get-expression(get)
        if table-plan && table-op(last) == TableOp.table-length && row-source
            . held = emit-expression(get.object)
            . type = held.type
            . layout = layout-of(type, last)
            . source = table-source(last, held.operand, type, layout)
            proven-tables += ProvenTable(loop, intrinsic(type), source)
            = Typed(source.length, types.size-type)
        .. table-plan = facts.plan-of(unit.reading, last) == .plan-table
        .. row-source = is-row-source(intrinsic(facts.node-type(unit.reading, get.object)))
= emit-expression(last)

────────────────────
_ do emit-counted-loop
    - loop SyntaxId
    - start Operand
    - end Operand
    - type TypeId
    - layout LayoutId
    - clause SyntaxId
    - body SyntaxId

. index = ir.add-local(layout)
store-local(index, start, loop)
. hoist = ir.reserve-block()
. head = ir.reserve-block()
. inside = ir.reserve-block()
. step = ir.reserve-block()
. done = ir.reserve-block()
jump(hoist)

ir.start-block(head)
emit-poll(loop)
. item = load-local(index, loop)
branch(compare(loop, .compare-less, item, end), inside, done)

ir.start-block(inside)
. turns = open-turns.length
open-turn(loop, item, type)
loops += EmittedLoop(loop, step, done, item, type, open-cleanups.length, no-slot)
emit-clause(clause, step, done)
emit-block(body)
close-turns(turns)
loops.pop()
jump(step)

ir.start-block(step)
. wide = if tables.layouts.rows[layout].size >= 4 then layout else i32-layout
. moved = arithmetic
    - loop
    - .arithmetic-add
    - num-cast(loop, item, layout, wide)
    - integer(wide as MachineKind, 1)
    - wide
store-local(index, num-cast(loop, moved, wide, layout), loop)
jump(head)

ir.start-block(hoist)
hoist-columns(loop)
jump(head)
ir.start-block(done)
forget-proven(loop)

────────────────────
_ do hoist-columns
    - loop SyntaxId

. found = proven-loop(loop)
if found == U32.max
    =
. columns = proven-tables[found].source.columns
while proven-columns.length != 0 && proven-columns[proven-columns.length - 1].loop == loop
    . held = proven-columns[proven-columns.length - 1]
    store-local(held.local, load(columns, held.column * 8, pointer-layout, loop), loop)
    proven-columns.pop()

────────────────────
_ do forget-proven
    - loop SyntaxId

while proven-tables.length != 0 && proven-tables[proven-tables.length - 1].loop == loop
    proven-tables.pop()
. kept [ProvenRead]
for held in proven-reads
    if held.loop != loop
        kept += held
proven-reads.clear()
for held in kept
    proven-reads += held

────────────────────
_ do loop-name-slot SlotId
    - loop SyntaxId

. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    = no-slot
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        . identifier = row.pattern
        do match? tree.nodes[row.pattern]
            | .node-type-capture(capture)
                identifier = capture.id
        . resolution = bindings.resolution-of(binding, identifier)
        if resolution.kind == .resolve-slot
            = resolution.slot
= no-slot

────────────────────
_ do proven-item U32
    - syntax SyntaxId

if proven-items.length == 0
    = U32.max
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    = U32.max
do match? tree.nodes[syntax]
    | .node-identifier
        . resolution = bindings.resolution-of(binding, syntax)
        if resolution.kind != .resolve-slot
            = U32.max
        . position = proven-items.length
        while position != 0
            position -= 1
            if proven-items[position].slot == resolution.slot
                = position as U32
= U32.max

────────────────────
_ do forget-item
    - loop SyntaxId

while proven-items.length != 0 && proven-items[proven-items.length - 1].loop == loop
    proven-items.pop()

────────────────────
_ do proven-loop U32
    - loop SyntaxId

. position = proven-tables.length
while position != 0
    position -= 1
    if proven-tables[position].loop == loop
        = position as U32
= U32.max

────────────────────
_ proven-table U32
    - id SyntaxId

|? facts.plan-of(unit.reading, id) != .plan-table || constant == no-fact
    U32.max
|? ((bits /and/ 4294967295) as U32) as TableOp != TableOp.proven-row
    U32.max
??
    proven-loop((bits /rshift/ 32) as SyntaxId)

.. constant = facts.constant-of(unit.reading, id)
.. bits = facts.constants[constant].bits

────────────────────
_ do proven-field Operand
    - id SyntaxId
    - loop SyntaxId
    - column U32
    - index Operand
    - field LayoutField

. found = proven-read(loop, column)
if found != U32.max
    = proven-reads[found].value
. read = take
    - item-cell(id, hoisted-column(loop, column), index, field.layout)
    - LayoutField(0, field.layout, field.type)
    - id
proven-reads += ProvenRead(loop, column, ir.current, read, field.type)
= read

────────────────────
_ do proven-read U32
    - loop SyntaxId
    - column U32

for position in 0 .. < proven-reads.length
    . held = proven-reads[position]
    if held.loop == loop && held.column == column && held.block == ir.current
        = position as U32
= U32.max

────────────────────
_ do forget-read
    - loop SyntaxId
    - column U32

. kept [ProvenRead]
for held in proven-reads
    if held.loop != loop || held.column != column
        kept += held
proven-reads.clear()
for held in kept
    proven-reads += held

────────────────────
_ innermost-loop SyntaxId

if loops.length == 0 then 0 else loops[loops.length - 1].syntax

────────────────────
_ do hoisted-column Operand
    - loop SyntaxId
    - column U32

for held in proven-columns
    if held.loop == loop && held.column == column
        = load-local(held.local, loop)
. local = ir.add-local(pointer-layout)
proven-columns += ProvenColumn(loop, column, local)
= load-local(local, loop)

────────────────────
_ do emit-clause
    - clause SyntaxId
    - step IRBlockId
    - done IRBlockId

` The clauses of a loop, tested in the order written before its body on each pass. A `when`
` that fails goes on to the next pass. A `while` that fails ends the loop, and so does an
` `until` that holds. The first clause that decides wins: the clauses after it are not tested.
` A `whenever` says whether a loop on a stream is subscribed and is not tested here.
. current = first-tested(clause)
while current != 0
    . expr SyntaxId = 0
    . next SyntaxId = 0
    . passes = no-block
    . fails = no-block
    . resumed = ir.reserve-block()
    do match? tree.nodes[current]
        | .node-clause(row)
            expr = row.expr
            next = row.next
            do match? row.op
                | .when-clause
                    passes = resumed
                    fails = step
                | .while-clause
                    passes = resumed
                    fails = done
                | .until-clause
                    passes = done
                    fails = resumed
    if passes == no-block
        refuse(.refused-statement, current)
        =
    . tested = test(expr, emit-expression(expr))
    branch(tested.operand, passes, fails)
    ir.start-block(resumed)
    current = first-tested(next)

────────────────────
_ do first-tested SyntaxId
    - clause SyntaxId

` A clause, or the first written after it, that is tested before a loop's body: one that is not
` a `whenever`. None where there is none.
if clause == 0
    = 0
do match? tree.nodes[clause]
    | .node-clause(row)
        if row.op == .whenever-clause
            = first-tested(row.next)
= clause

────────────────────
_ do emit-leave
    - site SyntaxId
    - is-break Bool

` Leaves the innermost loop, or goes on to its next pass, after the cleanups opened in the
` loop run. What follows is never run. In a cleanup being run, only the holds on cancellation
` taken in the loop are let go (`leave-held`), and leaving anything else opened there has no
` shape.
if loops.length == 0
    refuse(.refused-statement, site)
    =
. loop = loops[loops.length - 1]
if scoping.cleaning && loop.cleanups != open-cleanups.length
    if !leave-held(loop.cleanups, site)
        refuse(.refused-statement, site)
        =
else
    run-cleanups(loop.cleanups, open-cleanups.length)
jump(if is-break then loop.done else loop.step)
ir.start-block(ir.reserve-block())

────────────────────
_ do open-polls

` The cells a function's loops poll with: the budget, which runs out on the first pass, and where
` the loops look in on the probes, the count down to the next look.
budget = ir.add-local(u64-layout)
store-local(budget, integer(.machine-u64, 1), 0)
if tables.probe-loops && !is-unprobed()
    probe-countdown = ir.add-local(u64-layout)
    store-local(probe-countdown, integer(.machine-u64, 0), 0)

────────────────────
_ do look-in-on-probes
    - syntax SyntaxId

` The look a loop's poll takes in on the probes, where the count down has run out: it is given its
` period again, and the probes flush what is due and answer the controller. A loop in a `do` block
` kept from looking in on them never does.
if probe-countdown == no-local || is-unprobed()
    =
. left = load-local(probe-countdown, syntax)
. looking = ir.reserve-block()
. looked = ir.reserve-block()
branch(left, looked, looking)
ir.start-block(looking)
store-local(probe-countdown, integer(.machine-u64, probe-look-period), syntax)
call-probe-thunk(tables.probe-safepoint, syntax)
jump(looked)
ir.start-block(looked)
. one = integer(.machine-u64, 1)
store-local
    - probe-countdown
    - arithmetic(syntax, .arithmetic-subtract, load-local(probe-countdown, syntax), one, u64-layout)
    - syntax

────────────────────
_ do call-probe-thunk
    - callee FunctionId
    - site SyntaxId

` A call of the function that flushes what a thread's probes wrote or of the one that looks in on
` them, where either is made. Neither returns a panic.
if callee == no-function
    =
ir.depend(.callee-function, callee, 0)
call
    - make-operand(.operand-symbol, tables.functions[callee].symbol)
    - site
    - pending.length
    - .callee-function
    - void-layout

────────────────────
_ is-unprobed Bool

` Whether the loops of the code emitted and the calls it makes that suspend the task never look in
` on the probes, by what its function declares or a `do` block around it is kept from.
(effects-here() /and/ CompilationEffect.no-probe-safepoint) != 0

────────────────────
_ effects-here U32

` What the code emitted may not do: what its function declares, and what the `do` blocks around
` it are kept from.
declared /or/ block-effects
.. declared = if unit.instance == no-instance then 0u32 else restrictions-of(dispatch-effects(instances.rows[unit.instance].effects))

────────────────────
_ do emit-poll
    - syntax SyntaxId

` The poll a loop makes on each pass. The budget counts the passes down. Where it runs out it is
` given a period again, the loop looks in on the probes (`look-in-on-probes`), and the task is
` looked at. When the collector or the scheduler has asked something of it, it leaves through the
` landing pad with the termination panic when it is being terminated in a function that
` `raises-termination`, and otherwise stops at the task's safepoint, or at the collector's in a
` function that may not suspend. A loop where no safepoint is allowed polls nothing. A loop in any
` other function the type pass did not mark as one that polls has no shape.
if is-unpolled() && unit.lender == no-instance
    =
if budget == no-local || unit.lender != no-instance
    refuse(.refused-statement, syntax)
    =
. one = integer(.machine-u64, 1)
. left = arithmetic(syntax, .arithmetic-subtract, load-local(budget, syntax), one, u64-layout)
store-local(budget, left, syntax)
. polling = ir.reserve-block()
. dispatch = ir.reserve-block()
. stop = ir.reserve-block()
. resume = ir.reserve-block()
branch(left, resume, polling)

ir.start-block(polling)
store-local(budget, integer(.machine-u64, poll-period), syntax)
look-in-on-probes(syntax)
. flags-address = make-operand(.operand-symbol, tables.runtime-symbol(.runtime-interrupt-flags))
. control-address = make-operand(.operand-symbol, tables.bundle.gc-public-control-word-symbol)
. flags = load(flags-address, 0, u8-layout, syntax)
. control = load(control-address, 0, u8-layout, syntax)
. asked = integer(.machine-u8, handshake-requested-control)
. collecting = bitwise(syntax, .bitwise-and, control, asked, u8-layout)
branch(bitwise(syntax, .bitwise-or, flags, collecting, u8-layout), dispatch, resume)

ir.start-block(dispatch)
if raises-termination()
    check-termination(load(flags-address, 0, u8-layout, syntax), syntax, stop)
else
    jump(stop)

ir.start-block(stop)
. suspends = (effects-here() /and/ CompilationEffect.no-suspend) == 0
call-runtime
    - if suspends then .runtime-task-safepoint else .runtime-safepoint
    - syntax
    - pending.length
jump(resume)
ir.start-block(resume)

────────────────────
_ do check-termination
    - flags Operand
    - syntax SyntaxId
    - resume IRBlockId

` Leaves through the landing pad with the termination panic when the interrupt flags say the
` task is being terminated, and goes on at `resume` when they do not.
. requested = bitwise
    - syntax
    - .bitwise-and
    - flags
    - integer(.machine-u8, terminate-interrupt)
    - u8-layout
. check = ir.reserve-block()
branch(requested, check, resume)
ir.start-block(check)
. raised = call-instance(instances.report.termination, syntax, pending.length)
poll-landings += 1
branch(raised.operand, landing-block(syntax), resume)

────────────────────
_ do test Typed
    - site SyntaxId
    - value Typed
    - is-operand Bool = false
    - is-right Bool = false

` Whether a value tests as true as a condition. One of a class or a text is asked whether it
` is empty, by the call the type pass recorded at the site as the test, and is true when it
` is not. Any other is tested by its layout. The value is the site's own, or with
` `is-operand` an operand of the site: the left one, or with `is-right` the right one.
. nothing = make-operand(.operand-void, 0)
. fact = truth-call(site, is-operand, is-right)
if fact == no-fact
    = truth(site, value)
. row = facts.calls[fact]
if row.is-partial
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
= ask-empty(site, value, row.callee)

────────────────────
_ do ask-empty Typed
    - site SyntaxId
    - value Typed
    - callee InstanceId

` Whether a value of a class or a text is not empty, by the function that says it is.
. nothing = make-operand(.operand-void, 0)
if callee == no-instance || !is-callable(callee)
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
if instances.signatures[callee].args.count != 0 || value.type != instances.rows[callee].self-type
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. mark = pending.length
pending += value.operand
. empty = call-method(callee, site, mark)
if empty.type != types.bool-type
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
= compare-zero(site, empty, .compare-equal)

────────────────────
_ do truth-call FactId
    - site SyntaxId
    - is-operand Bool
    - is-right Bool

` The call the type pass recorded at a site as the test of a value as a condition: of the
` site's own value, or of its left or right operand. No fact when the value has no such test.
. form = if is-operand then CallForm.call-operand-truth else CallForm.call-truth
. fact = facts.first-call(unit.reading, site)
while fact != no-fact
    . row = facts.calls[fact]
    if row.form == form && row.is-swapped == is-right
        = fact
    fact = row.next
= no-fact

────────────────────
_ is-function-call Bool
    - id SyntaxId

` Whether the call a node makes for its own value is of a function by its name: an operator
` that a function of its name answers, with both operands as its arguments.
fact != no-fact && facts.calls[fact].form == .call-function

.. fact = own-call(id)

────────────────────
_ own-call FactId
    - id SyntaxId

` The call a node makes for its own value, as the instance being read records it.
call-in(unit.reading, id)

────────────────────
_ do call-in FactId
    - owner InstanceId
    - id SyntaxId

` The call a node makes for its own value, as an instance records it: the one recorded at it
` that is not the test of a value as a condition. No fact when there is none, or more than one.
. found = no-fact
. fact = facts.first-call(owner, id)
while fact != no-fact
    . row = facts.calls[fact]
    if answers-node(row.form)
        if found != no-fact
            = no-fact
        found = fact
    fact = row.next
= found

────────────────────
_ do emit-print
    - id SyntaxId
    - body SyntaxId

` Prints a value as text, by the conversion the print records. The items of a tuple written
` are all evaluated first, and then made text one by one and joined as a tuple is. `--? value`
` prints only where the optional written holds a value.
. value = Typed(make-operand(.operand-void, 0), no-type)
. skipped = ir.reserve-block()
. is-written = false
do match? tree.nodes[body]
    | .node-tuple-syntax
        is-written = true
if is-written
    . start = given.length
    gather-printed(body)
    print-fact = facts.first-conversion(unit.reading, id)
    print-next = start
    value = Typed(printed-text(id, body), types.string-type)
    drop-given(start)
else
    held-chain = body
    . emitted = emit-expression(body)
    held-chain = 0
    if is-chained(body) && types.is-optional(emitted.type)
        . tested = present(body, emitted)
        . printing = ir.reserve-block()
        branch(tested.operand, printing, skipped)
        ir.start-block(printing)
    value = convert(id, .reason-print, emitted)
if value.type != types.string-type
    refuse(.refused-print-conversion, id)
    =
. mark = pending.length
pending += value.operand
call-runtime(.runtime-print, id, mark)
jump(skipped)
ir.start-block(skipped)

────────────────────
_ do gather-printed ?! Refused
    - body SyntaxId

` Evaluates the items of a tuple written to be printed, and those of the tuples written
` inside it, in order. A struct that an item names is copied, so no later item changes it.
do match? tree.nodes[body]
    | .node-tuple-syntax(row)
        for item in tree.children[row.items]
            gather-printed(item)
        =
. value = emit-expression(body)
. layout = layout-of(value.type, body)
if tables.layouts.is-struct(layout) && !is-answer(value.operand)
    value = Typed(snapshot(value.operand, layout, body), value.type)
given += value

────────────────────
_ do printed-text Operand ?! Refused
    - id SyntaxId
    - body SyntaxId

` The text of what `gather-printed` evaluated. An item that is not text takes the next
` conversion the print records.
do match? tree.nodes[body]
    | .node-tuple-syntax(row)
        . text = make-operand(.operand-constant, ir.add-string("("))
        . position U32
        for item in tree.children[row.items]
            . piece = printed-text(id, item)
            if position != 0
                text = concat(id, text, make-operand(.operand-constant, ir.add-string(", ")))
            text = concat(id, text, piece)
            position += 1
        = concat(id, text, make-operand(.operand-constant, ir.add-string(")")))
. value = given[print-next]
print-next += 1
if value.type == types.string-type
    = value.operand
while print-fact != no-fact && facts.conversions[print-fact].reason != .reason-print
    print-fact = facts.conversions[print-fact].next
if print-fact == no-fact
    refuse(.refused-print-conversion, id)
    = value.operand
. row = facts.conversions[print-fact]
print-fact = row.next
= convert-one(id, row, value).operand

────────────────────
_ compiles-probe Bool
    - id SyntaxId

program.compiles-probe(unit.source-module, probe-decl(), id)

────────────────────
_ probe-decl DeclId

` The function whose probes compile as its own (see `Program.compiles-probe`): that of the
` instance read, where it is written in the module whose syntax is emitted.
if unit.reading != no-instance && instances.rows[unit.reading].module == unit.source-module then instances.rows[unit.reading].decl else 0

────────────────────
_ do emit-probe-statement
    - id SyntaxId

` A probe that compiles: a log or an event (`emit-probe`), the assignment of a property, a counter,
` a group, the lazy locals a probe reads with it, which are evaluated where it reads them, or the
` statement a probe runs.
do match? tree.nodes[id]
    | .node-probe(row)
        . skip = open-probe-gate(id)
        emit-probe(id, row)
        close-probe-gate(skip)
        =
    | .node-probe-assign(row)
        . skip = open-probe-gate(id)
        emit-probe-assign(id, row)
        close-probe-gate(skip)
        =
    | .node-probe-counter(row)
        . skip = open-probe-gate(id)
        emit-probe-counter(id, row)
        close-probe-gate(skip)
        =
    | .node-probe-group(row)
        emit-probe-group(id, row)
        =
    | .node-probe-scope(row)
        . mark = open-cleanups.length
        for statement in tree.children[row.body]
            emit-statement(statement)
        close-cleanups(mark)
        =
    | .node-probe-statement(row)
        emit-block(row.body)
        =
refuse(.refused-probe, id)

────────────────────
_ do open-probe-gate IRBlockId
    - site SyntaxId

. tracing = load
    - make-operand(.operand-symbol, tables.runtime-symbol(.runtime-probe-tracing))
    - 0
    - u8-layout
    - site
. records = ir.reserve-block()
. skip = ir.reserve-block()
branch(tracing, records, skip)
ir.start-block(records)
= skip

────────────────────
_ do close-probe-gate
    - skip IRBlockId

jump(skip)
ir.start-block(skip)

────────────────────
_ do emit-probe
    - id SyntaxId
    - row ASTProbe

` A log or an event whose probe compiles writes its record through the calls of the probes module
` the type pass recorded at it (`emit-probe-record`). The object it is written of, where it has one,
` and each value written in it are evaluated first, in order, then each value is cast, so that a
` probe a value runs writes its own record before this one starts, as the reference compiles them.
. number = tables.probe-number(unit.reading, id)
if number == 0
    refuse(.refused-probe, id)
    =
. made = probe-calls(id)
. logs = row.name == null
. start = given.length
. snapshots [Bool]
gather-probe-object(row.object)
. values = given.length
gather-probe-values(row.content, logs, snapshots)
cast-probe-values(row.content, logs, values)
. head = pending.length
pending += integer(.machine-u16, number)
push-probe-object(row.object, start)
emit-probe-record(id, made, 0, head, values, snapshots)
drop-given(start)

────────────────────
_ do emit-probe-assign
    - id SyntaxId
    - row ASTProbeAssign

` The assignment of a property a probe makes writes an event of the key and the value, of the
` object it is written of where it has one, through the calls the type pass recorded at it.
. number = tables.probe-number(unit.reading, id)
if number == 0
    refuse(.refused-probe, id)
    =
. made = probe-calls(id)
. start = given.length
gather-probe-object(row.object)
. values = given.length
given += Typed(make-operand(.operand-constant, ir.add-string(row.key.text)), types.string-type)
. value = emit-expression(row.content)
given += value
. converted = convert(row.content, .reason-print, Typed(value.operand, given[values + 1].type))
given[values + 1] = converted
. head = pending.length
pending += integer(.machine-u16, number)
push-probe-object(row.object, start)
. snapshots [Bool]
emit-probe-record(id, made, 0, head, values, snapshots)
drop-given(start)

────────────────────
_ do emit-probe-counter
    - id SyntaxId
    - row ASTProbeCounter

` A counter adds to the count the probes module keeps under its number, of the object it is written
` of where it has one: by one, or by what it is given, converted as the type pass recorded. One
` that compiles only as a metric of the profile adds to the metric of its number instead.
. number = tables.probe-number(unit.reading, id)
. made = probe-calls(id)
if number == 0 || made.length != 1
    refuse(.refused-probe, id)
    =
. start = given.length
gather-probe-object(row.object)
. delta = integer(.machine-u64, 1)
if row.delta != 0
    . emitted = emit-expression(row.delta)
    delta = emitted.operand
    delta = convert(row.delta, .reason-argument, Typed(delta, emitted.type)).operand
. mark = pending.length
pending += integer(.machine-u16, number)
push-probe-object(row.object, start)
pending += delta
if facts.calls[made[0]].form == .call-probe-metric
    call-runtime(.runtime-profile-counter-add, id, mark)
else
    call-probe-function(facts.calls[made[0]].callee, id, mark)
drop-given(start)

────────────────────
_ do emit-probe-group
    - id SyntaxId
    - row ASTProbeGroup

` A group writes the record that opens it, with its values, and the one that closes it, each through
` the calls the type pass recorded at it, in order. One that begins and ends closes where the block
` it is written in is left, by any way out, as a cleanup (`emit-probe-group-end`), which has no shape
` where `do finally` has none. One written as a log that only ends writes its values in a log of
` their own before it closes. A group of data is of the object it is written of where it has one.
` One that compiles only as a timer of the profile begins or ends the timer of its number instead,
` and one that begins and ends ends it where the block is left.
. number = tables.probe-number(unit.reading, id)
if number == 0
    refuse(.refused-probe, id)
    =
. made = probe-calls(id)
if made.length != 0 && facts.calls[made[0]].form == .call-probe-metric
    . timing = open-probe-gate(id)
    time-profile
        - if row.is-begin then .runtime-profile-timer-begin else .runtime-profile-timer-end
        - number
        - id
    close-probe-gate(timing)
    if row.is-begin && row.is-end
        if scoping.cleaning || builds || initializes
            refuse(.refused-probe, id)
            =
        open-cleanup(id, UseCell(no-local, no-local, no-type))
    =
. logs = !row.is-data
. object = if row.is-data then row.object else 0
. skip = open-probe-gate(id)
. start = given.length
. snapshots [Bool]
gather-probe-object(object)
. values = given.length
gather-probe-values(row.content, logs, snapshots)
cast-probe-values(row.content, logs, values)
. head = pending.length
pending += integer(.machine-u16, number)
if row.is-begin || !logs
    if object != 0
        pending += integer(.machine-u8, 7)
    push-probe-object(object, start)
emit-probe-record(id, made, 0, head, values, snapshots)
drop-given(start)
close-probe-gate(skip)
if row.is-begin && row.is-end
    if scoping.cleaning || builds || initializes
        refuse(.refused-probe, id)
        =
    open-cleanup(id, UseCell(no-local, no-local, no-type))
else if logs && row.is-end
    emit-probe-group-end(id, 1)

────────────────────
_ do emit-probe-group-end
    - id SyntaxId
    - part U32

` The record that closes a group, which writes no values: the second a group that begins and ends
` writes, where the block it is written in is left, or the one after the log of a group that only
` ends. A timer of the profile that begins and ends ends there instead.
. made = probe-calls(id)
. skip = open-probe-gate(id)
if made.length != 0 && facts.calls[made[0]].form == .call-probe-metric
    time-profile(.runtime-profile-timer-end, tables.probe-number(unit.reading, id), id)
else
    . head = pending.length
    pending += integer(.machine-u16, tables.probe-number(unit.reading, id) + part)
    . snapshots [Bool]
    emit-probe-record(id, made, part, head, given.length, snapshots)
close-probe-gate(skip)

────────────────────
_ do emit-probe-record
    - id SyntaxId
    - made [FactId]
    - part U32
    - head Size
    - values Size
    - snapshots [Bool]

` Writes one record of a probe through the calls the type pass recorded for it, the `part`-th
` among those recorded at the probe: its head, given what is pending from `head`, then each value
` given from `values`, with the class of an object or an array and whether its snapshot is
` written, then the flush. Calls that do not fit the values have no shape.
. first = probe-part-start(made, part)
. count = given.length - values
. flush = first + count + 1
if flush >= made.length || facts.calls[made[flush]].form != .call-probe || headless
    refuse(.refused-probe, id)
    drop-pending(head)
    =
.. headless = flush + 1 < made.length && facts.calls[made[flush + 1]].form != .call-probe-head
call-probe-function(facts.calls[made[first]].callee, id, head)
for offset in 0 .. < count
    . callee = facts.calls[made[first + offset + 1]].callee
    . mark = pending.length
    pending += given[values + offset].operand
    if instances.signatures[callee].args.count == 3
        . snapshot = offset < snapshots.length && snapshots[offset]
        pending += integer(.machine-u16, tables.probe-class-id(given[values + offset].type))
        pending += integer(.machine-u8, if snapshot then 1 else 0)
    call-probe-function(callee, id, mark)
call-probe-function(facts.calls[made[flush]].callee, id, pending.length)

────────────────────
_ do time-profile
    - callee RuntimeFunction
    - number U32
    - site SyntaxId

` Begins or ends the timer of the profile of a number.
. mark = pending.length
pending += integer(.machine-u16, number)
call-runtime(callee, site, mark)

────────────────────
_ do count-event
    - count EventCount
    - site SyntaxId
    - amount U64 = 1

` Adds to a count the compiler keeps of what events do, where it compiles.
. number = tables.event-counts[count as Size]
if number == 0
    =
. mark = pending.length
pending += integer(.machine-u16, number)
pending += integer(.machine-u64, amount)
call-probe-function(instances.probe-runtime.counter-add, site, mark)

────────────────────
_ do probe-calls [FactId]
    - id SyntaxId

` The calls of the probes module the type pass recorded at a probe, in order, or the mark of one
` that compiles only as a metric of the profile.
. made [FactId]
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    . form = facts.calls[fact].form
    if form == .call-probe || form == .call-probe-head || form == .call-probe-metric
        made += fact
    fact = facts.calls[fact].next
= made

────────────────────
_ do probe-part-start Size
    - made [FactId]
    - part U32

` Where the calls of a record a probe writes start among those recorded at it: at the head of the
` `part`-th record.
. seen U32
for position in 0 .. < made.length
    if facts.calls[made[position]].form == .call-probe-head
        if seen == part
            = position
        seen += 1
= made.length

────────────────────
_ do gather-probe-object
    - object SyntaxId

` Evaluates the object a probe is written of, where it has one, into what is given.
if object == 0
    =
. emitted = emit-expression(object)
given += emitted

────────────────────
_ do push-probe-object
    - object SyntaxId
    - start Size

` Passes the object a probe is written of, given at `start`, where it has one, with the id of its
` class.
if object == 0
    =
pending += given[start].operand
pending += integer(.machine-u16, tables.probe-class-id(given[start].type))

────────────────────
_ do gather-probe-values
    - content RowRange'SyntaxId
    - logs Bool
    - snapshots [Bool]

` Evaluates each value written in a probe, in order, into what is given, noting which are
` snapshots. The texts written in a log are its template, and no values.
for item in tree.children[content]
    if logs && tree.nodes[item] is .node-string-syntax
        continue
    snapshots += tree.nodes[item] is .node-probe-snapshot
    . emitted = emit-expression(probe-value(item))
    given += emitted

────────────────────
_ do cast-probe-values
    - content RowRange'SyntaxId
    - logs Bool
    - values Size

` Casts each value of a probe given from `values` as the type pass recorded: one written as its
` text is converted, and a preview written as the name of its type is that name.
. position = values
for item in tree.children[content]
    if logs && tree.nodes[item] is .node-string-syntax
        continue
    . value = probe-value(item)
    . type = facts.node-type(unit.reading, value)
    if tree.nodes[item] is .node-probe-preview && probe-cast(types, type) == .probe-converted
        . preview = make-operand(.operand-constant, ir.add-string(probe-preview-text(types, type)))
        given[position] = Typed(preview, types.string-type)
    else
        . converted = convert(value, .reason-print, given[position])
        given[position] = converted
    position += 1

────────────────────
_ probe-value SyntaxId
    - item SyntaxId

` The value a probe writes for an item written in it: the one a snapshot or a preview is of.
match tree.nodes[item]
    | .node-probe-snapshot(row)
        row.content
    | .node-probe-preview(row)
        row.content
    ??
        item

────────────────────
_ do emit-probe-setup

` The function the task main runs once the probes module has started, as the reference's
` `probesetup`: it opens the record of probes, makes room for the counters, numbered up to the last,
` and for the metrics of the profile, declares the key of each log and group and each class a value
` of a probe has, numbered after the probe data types, then each metric of the profile, then each
` probe the program compiles with the probe data type of each value it writes, and says the
` declarations are done.
. runtime = instances.probe-runtime
call-probe-function(runtime.begin, 0, pending.length)
. mark = pending.length
pending += integer(.machine-u64, tables.last-counter)
call-probe-function(runtime.counter-setup, 0, mark)
mark = pending.length
pending += integer(.machine-u64, tables.profile-metrics.length as U64)
call-probe-function(runtime.profile-setup, 0, mark)
for key in tables.probe-keys
    mark = pending.length
    pending += make-operand(.operand-constant, ir.add-string(key))
    call-probe-function(runtime.declare-key, 0, mark)
for position in 0 .. < tables.probe-classes.length
    mark = pending.length
    pending += integer(.machine-u16, (probe-data-type-count + position + 1) as U64)
    pending += make-operand(.operand-constant, ir.add-string(tables.probe-classes[position]))
    call-probe-function(runtime.declare-type, 0, mark)
for position in 0 .. < tables.profile-metrics.length
    declare-profile-metric(position, tables.profile-metrics[position])
for position in 0 .. < tables.probes.length
    declare-probe(position, tables.probes[position])
call-probe-function(runtime.ready, 0, pending.length)
return-nothing()

────────────────────
_ do emit-probe-teardown

` The function that closes the record of probes, as the reference's `probeteardown`: it counts what
` the collector did under the counters that compile for it, then closes the record.
. runtime = instances.probe-runtime
. counts = tables.collector-counts
if counts[0] != 0 || counts[1] != 0 || counts[2] != 0
    . mark = pending.length
    for count in counts
        pending += integer(.machine-u16, count)
    call-probe-function(runtime.collector-counts, 0, mark)
call-probe-function(runtime.end, 0, pending.length)
return-nothing()

────────────────────
_ do declare-probe
    - position Size
    - probe ProbeRow

` Declares a probe the program compiles by its number: a log with its key, its name, its template,
` which holds `%%` for each value, its module, file and line; an event with its key and name; or a
` counter with its key, module, file and line. A record of a group is named for whether it opens or
` closes it; one that closes it has no template. Then the probe data type of each value it writes,
` with its class.
. runtime = instances.probe-runtime
. number = integer(.machine-u16, (position + 1) as U64)
. count = integer(.machine-u32, probe.types.count)
. found = tables.probe-site(probe)
if !found
    refuse(.refused-probe, probe.syntax)
    =
. site = found
do match site.kind
    |= .log
        declare-probe-log
            - number
            - site.key
            - site.name
            - site.template
            - site.module-name
            - site.path
            - site.line
            - count
    |= .event
        declare-probe-event(number, site.key, site.name, site.module-name, count)
    ??
        declare-probe-counter(number, site.key, site.module-name, site.path, site.line)
        =
for offset in 0 .. < probe.types.count
    . mark = pending.length
    pending += integer(.machine-u8, tables.probe-types[probe.types.start + offset])
    pending += integer(.machine-u16, tables.probe-type-classes[probe.types.start + offset])
    call-probe-function(runtime.declare-argument, 0, mark)

────────────────────
_ do declare-profile-metric
    - position Size
    - metric ProbeRow

` Declares a metric of the profile by its number: its key, whether it counts or times, its module,
` file and line, and no class.
. owner = program.modules[instances.rows[metric.instance].module]
. mark = pending.length
pending += integer(.machine-u16, (position + 1) as U64)
pending += make-operand
    - .operand-constant
    - ir.add-string(tables.metric-key(metric.instance, metric.syntax))
pending += integer(.machine-u8, metric.part)
pending += make-operand(.operand-constant, ir.add-string(owner.name))
pending += make-operand(.operand-constant, ir.add-string(owner.path))
pending += integer(.machine-u32, owner.tree.nodes.loc[metric.syntax].begin.line + 1)
pending += integer(.machine-u16, 0)
call-probe-function(instances.probe-runtime.declare-profile-metric, 0, mark)

────────────────────
_ do declare-probe-log
    - number Operand
    - key String
    - name String
    - template String
    - module-name String
    - path String
    - line U32
    - count Operand

. mark = pending.length
pending += number
pending += make-operand(.operand-constant, ir.add-string(key))
pending += make-operand(.operand-constant, ir.add-string(name))
pending += make-operand(.operand-constant, ir.add-string(template))
pending += make-operand(.operand-constant, ir.add-string(module-name))
pending += make-operand(.operand-constant, ir.add-string(path))
pending += integer(.machine-u32, line)
pending += count
call-probe-function(instances.probe-runtime.declare-log, 0, mark)

────────────────────
_ do declare-probe-event
    - number Operand
    - key String
    - name String
    - module-name String
    - count Operand

. mark = pending.length
pending += number
pending += make-operand(.operand-constant, ir.add-string(key))
pending += make-operand(.operand-constant, ir.add-string(name))
pending += make-operand(.operand-constant, ir.add-string(module-name))
pending += count
call-probe-function(instances.probe-runtime.declare-event, 0, mark)

────────────────────
_ do declare-probe-counter
    - number Operand
    - key String
    - module-name String
    - path String
    - line U32

. mark = pending.length
pending += number
pending += make-operand(.operand-constant, ir.add-string(key))
pending += make-operand(.operand-constant, ir.add-string(module-name))
pending += make-operand(.operand-constant, ir.add-string(path))
pending += integer(.machine-u32, line)
call-probe-function(instances.probe-runtime.declare-counter, 0, mark)

────────────────────
_ do call-probe-function
    - callee InstanceId
    - site SyntaxId
    - mark Size

` A call of a function of the probes module that compiled probes make, or the functions that
` declare, flush and close them: an error that leaves it is reported as one no caller handles,
` and what follows runs, as the reference hands it off.
if callee == no-instance
    refuse(.refused-probe, site)
    drop-pending(mark)
    =
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-instance(callee, site, mark)
takes-result = false
if raising
    do report-result(site, instances.signatures[callee].result, answer.operand, false, true)

────────────────────
_ do emit-raise
    - id SyntaxId
    - exception SyntaxId
    - condition SyntaxId

` Raises a panic no handler of the function takes. The panic is given the place it is raised
` at when it has no source of its own, then its stack trace, and becomes the task's active
` panic. The function leaves through its landing pad, and what follows is never run. Under a
` condition the panic is raised only where the condition tests as true, and what follows runs
` where it does not. A function the collector never sees leaves that zone before it makes
` the panic, once, and everything up to the landing pad is outside it.
. resumed = no-block
if condition != 0
    . tested = test(condition, emit-expression(condition))
    . raising = ir.reserve-block()
    resumed = ir.reserve-block()
    branch(tested.operand, raising, resumed)
    ir.start-block(raising)
raise-given(id, exception)
ir.start-block(if resumed == no-block then ir.reserve-block() else resumed)

────────────────────
_ do raise-given
    - id SyntaxId
    - exception SyntaxId
    - planned SyntaxId = 0

` Evaluates a panic or an error and raises it at a node, which ends the block. An error is
` one the type pass said leaves the function there, at the node or at `planned` for an arm
` of a match that raises. Any other value has no shape here.
. report = instances.report
. object = tables.layouts.objects[types.panic-type]
. is-ready = object != no-layout && report.source-slot != U32.max && report.trace-slot != U32.max
if !is-ready || tables.instance-functions[report.source] == no-function
    refuse(.refused-statement, id)
    =
if in-zone
    cross-zone(id, false)
    in-zone = false
. raised = emit-expression(exception)
if extends(raised.type, types.panic-type)
    raise(raised.operand, id)
else if extends(raised.type, types.error-type) && planned-raise
    leave-with(raised.operand, raised.type, id)
else
    refuse(.refused-statement, id)
.. planned-raise = facts.plan-of(unit.reading, if planned != 0 then planned else id) == .plan-raise
in-zone = is-free(unit.instance)

────────────────────
_ do leave-with
    - error Operand
    - type TypeId
    - id SyntaxId

` Leaves the function with an error in place of its value. The error is given the place of
` the node where it has no source of its own, then its stack trace. Where the type pass
` planned transformers for it there, each is tried in turn, and the first whose chain of
` earlier errors matches raises its exception in the error's place. An error raised in a
` cleanup leaves as TypeScript's does: in place of what was leaving, a value, another error or
` a panic, which stays set aside. One raised by a lazy local's value that a nested function
` evaluates leaves the nested function, whose writer lets it out with the call. One raised in
` a constructor run on an object made elsewhere, or in the zone the collector never looks in,
` which an error leaves before it is raised, has no shape here, and neither has one a lazy
` local's value raises toward transformers, nor one a transformer the type pass marked may take.
. report = instances.report
. object = tables.layouts.objects[types.panic-type]
. is-ready = object != no-layout && report.source-slot != U32.max && report.trace-slot != U32.max
if !is-ready || tables.instance-functions[report.source] == no-function
    refuse(.refused-statement, id)
    =
if initializes || in-zone || (builds && result-type == no-type)
    refuse(.refused-statement, id)
    =
. leave = facts.leave-of(unit.reading, id, type)
if unit.lender != no-instance && leave != no-fact
    refuse(.refused-statement, id)
    =
trace-error(error, id)
if leave == no-fact
    leave-as(error, type, id)
    =
. tried = facts.leaves[leave].tried
for offset in 0 .. < tried.count
    if facts.transform-unheld(facts.leave-tried[tried.start + offset])
        refuse(.refused-statement, id)
        =
for offset in 0 .. < tried.count
    . transform = facts.transforms[facts.leave-tried[tried.start + offset]]
    . missed = no-block
    if transform.chain.count != 0
        missed = ir.reserve-block()
    . named = bound.length
    transform-error(error, transform, missed)
    drop-bound(named)
    if missed == no-block
        =
    ir.start-block(missed)
leave-as(error, type, id)

────────────────────
_ do trace-error
    - error Operand
    - site SyntaxId

` Gives an error the place of a node where it has no source of its own, then its stack trace.
. object = tables.layouts.objects[types.panic-type]
. begin = tree.nodes[site].loc.begin
attach-source(error, begin.line + 1, begin.column + 1, site)
. trace = tables.layouts.field(object, object-header-fields + instances.report.trace-slot)
. mark = pending.length
pending += address(error, trace.offset, managed-layout, site)
call-runtime(.runtime-ensure-stack-trace, site, mark)

────────────────────
_ do transform-error
    - error Operand
    - transform TransformFact
    - missed IRBlockId

` Raises a transformer's exception in place of an error leaving the function. Where the
` error's chain of `previous` holds the errors the transformer names, class by class, the
` names its catcher declares are bound, and its exception is evaluated, given the
` transformer's place and a trace, given the error as its `previous`, and leaves the
` function. Where the chain does not match it goes on to `missed`.
do match? tree.nodes[transform.catcher]
    | .node-catcher(row)
        bind-caught(row.type, Typed(error, transform.source))
        . current = error
        . position U32
        for pattern in tree.children[row.previous]
            if position == transform.chain.count
                break
            . link = facts.transform-chains[transform.chain.start + position]
            current = previous-of(current, link, missed, pattern)
            bind-caught(pattern, Typed(current, link))
            position += 1
        . raised = emit-expression(transform.exception)
        if raised.type != transform.raised || instances.report.previous-slot == U32.max
            refuse(.refused-statement, transform.site)
            =
        trace-error(raised.operand, transform.site)
        set-previous(raised.operand, error, transform.site)
        leave-as(raised.operand, transform.raised, transform.site)
        =
refuse(.refused-statement, transform.site)

────────────────────
_ do bind-caught
    - pattern SyntaxId
    - value Typed

` Binds the name a catcher's pattern declares, if any, to the error it names.
do match? tree.nodes[pattern]
    | .node-type-capture(capture)
        bind-name(capture.id, value)

────────────────────
_ do previous-of Operand
    - error Operand
    - link TypeId
    - missed IRBlockId
    - site SyntaxId

` The error an error was raised in place of, where it is of a class: its `previous`, going
` on to `missed` where it holds none or one of another class.
. layouts = tables.layouts
. object = layouts.objects[types.panic-type]
if instances.report.previous-slot == U32.max || !tables.is-class(link)
    refuse(.refused-statement, site)
    = error
. field = layouts.field(object, object-header-fields + instances.report.previous-slot)
if layouts.is-struct(field.layout)
    refuse(.refused-statement, site)
    = error
. previous = load(error, field.offset, field.layout, site)
. present = ir.reserve-block()
branch
    - compare(site, .compare-not-equal, previous, integer(field.layout as MachineKind, 0))
    - present
    - missed
ir.start-block(present)
. matched = ir.reserve-block()
class-branch(site, previous, link, matched, missed)
ir.start-block(matched)
= previous

────────────────────
_ do set-previous
    - error Operand
    - previous Operand
    - site SyntaxId

` Gives an error raised in place of another that one as its `previous`.
. layouts = tables.layouts
. object = layouts.objects[types.panic-type]
. field = layouts.field(object, object-header-fields + instances.report.previous-slot)
if layouts.is-struct(field.layout)
    refuse(.refused-statement, site)
    =
store(error, field.offset, previous, true, site)

────────────────────
_ do leave-as
    - error Operand
    - type TypeId
    - id SyntaxId

` Leaves the function with an error that has its place and its trace. The cleanups open
` run, and the function returns the error as a case of what it returns. The main of a module
` has no caller to return it to, and reports it, as the body of a spawned task does, which
` then terminates as TypeScript's does, and so does the function that gives a module's
` globals their values: TypeScript runs nothing after it. The function that evaluates a lazy
` global reports it and returns, leaving the global being evaluated, as TypeScript leaves it
` where a program goes on after an unhandled error. What follows is never run. A
` constructor that raises leaves what it was making behind. A function the event runtime
` calls for a section of a class, and the function that fills an object with the markup of
` its class, the handler of a state machine's group of event transitions, the function that
` stops a machine as its object closes, and the function a
` live action runs a rule of a class, a live statement or the value of a property again with,
` give the error to the global `unhandled-error` and return nothing, as the reference's live
` action does with the error such a function gives it. An error of a class above every error
` the function raises leaves, once the cleanups open have run, as the case of the most derived
` class below it that it is of (`leave-narrowed`). An error a cleanup raises runs only the
` cleanups open around that one, after the holds on cancellation the cleanup took, and one
` raised in a stream loop of a cleanup has no shape.
. open = if scoping.cleaning then scoping.cleaning-open else open-cleanups.length
if scoping.cleaning && open-cleanups.length != scoping.cleaning-top
    if !leave-held(scoping.cleaning-top, id)
        refuse(.refused-statement, id)
        =
if fusing
    leave-fused(error, type, id, open as U32)
    =
. stops = function.kind == .task-body || function.kind == .module-globals
. reports = function.kind == .module-main || function.kind == .lazy-global || stops
. hands = function.kind == .event-handler || machine-hands || function.kind == .class-rule-updater || function.kind == .property-updater || function.kind == .style-author || function.kind == .style-given-author || fills-content || reruns-statement
    .. machine-hands = function.kind == .machine-handler || function.kind == .machine-stop
. index = if reports || hands then U32.max else error-case(type)
. casts = !reports && !hands && index == U32.max
if casts && (narrower-error-case(type, 0) == U32.max || !function.may-panic)
    refuse(.refused-statement, id)
    =
. around = landing
if open != 0
    run-cleanups(0, open)
    landing = pad-at(0)
abandon-lazy(id)
if reports
    report-error(error, id)
    if stops
        call-runtime(.runtime-terminate, 0, pending.length)
    return-nothing()
else if hands
    hand-off(error, type, id)
    return-nothing()
else if casts
    leave-narrowed(error, type, id)
else
    leave-case(index, error, id)
landing = around

────────────────────
_ do leave-case
    - index U32
    - error Operand
    - id SyntaxId

` Returns an error as a case of what the function returns, leaving a callback the runtime
` called, and keeping a step of a function that yields as the last.
if in-callback
    call-runtime(callback-exit(), 0, pending.length)
if stepping
    keep-step(finished-step, id)
return-case(index, error, id)

────────────────────
_ do leave-narrowed
    - error Operand
    - type TypeId
    - id SyntaxId

` Leaves with an error of a class above every error the function raises as the case of the
` most derived class below it that it is of, as the reference converts it: the cases of
` classes below it are tested in turn, those of the classes derived furthest first, so that
` one of a class derived from another's is tested before it. An error of none of them is a
` panic, as the cast to the class of the last tested is.
. deepest = 0u32
. last = U32.max
for index in 1 .. < tables.layouts.rows[ir.returns].cases.count
    . below = narrower-depth(index, type)
    if below > deepest
        deepest = below
. depth = deepest
while depth > 0
    . index = narrower-error-case(type, depth)
    while index != U32.max
        . held = tables.layouts.case-field(ir.returns, index).type
        . matched = ir.reserve-block()
        . missed = ir.reserve-block()
        class-branch(id, error, held, matched, missed)
        ir.start-block(matched)
        leave-case(index, error, id)
        ir.start-block(missed)
        last = index
        index = narrower-error-case(type, depth, index + 1)
    depth -= 1
if last == U32.max
    refuse(.refused-statement, id)
    =
. held = tables.layouts.case-field(ir.returns, last).type
raise-text(id, "Invalid cast to ${type-display(types, held)}")

────────────────────
_ do leave-fused
    - error Operand
    - type TypeId
    - id SyntaxId
    - open U32

. index = if reads-errors then error-case-of(fused-read, type) else U32.max
if scoping.cleaning || index == U32.max
    refuse(.refused-statement, id)
    =
. around = landing
if open != 0
    run-cleanups(0, open)
    landing = pad-at(0)
. start U32 = ir.operands.length
ir.add-operand(read-case(index, error, id))
append(.op-return, id, Span(start, 1), ReturnKind.return-error)
landing = around

────────────────────
_ get reads-errors Bool

tables.layouts.is-struct(fused-read) && tables.layouts.rows[fused-read].cases.count > 1

────────────────────
_ do read-case Operand
    - index U32
    - held Operand
    - syntax SyntaxId

. made = frame(fused-read)
zero(made, fused-read)
store(made, 0, integer(.machine-u8, index), false, syntax)
put(made, tables.layouts.case-field(fused-read, index), held, syntax)
= made

────────────────────
_ do narrower-error-case U32
    - type TypeId
    - depth U32
    - from U32 = 1

` The first case of what the function returns, from a number on, that holds an error of a
` class below a class, as many classes below it as `depth` says, or with no depth at any, or
` none.
if result-type == no-type
    = U32.max
for index in from .. < tables.layouts.rows[ir.returns].cases.count
    . below = narrower-depth(index, type)
    if below != 0 && (depth == 0 || below == depth)
        = index
= U32.max

────────────────────
_ do narrower-depth U32
    - index U32
    - type TypeId

` How many classes below a class is the class of the error a case of what the function
` returns holds, or none where it is not below it.
. depth = 0u32
. current = tables.layouts.case-field(ir.returns, index).type
while current != no-type && current != invalid-type && current != type
    current = types.completions[current].base
    depth += 1
= if current == type then depth else 0

────────────────────
_ do get fills-content Bool

` Whether the function being emitted fills an object with the markup written in its class.
if function.kind != .instance-body || unit.instance == no-instance
    = false
. row = instances.rows[unit.instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.is-content
= false

────────────────────
_ do builds-outlet Bool
    - id SyntaxId

` Whether the function being emitted builds a slot outlet that is a markup branch region.
if function.kind != .instance-body || unit.instance == no-instance
    = false
. row = instances.rows[unit.instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.kind == .branch-arm-decl && fn.syntax == id
= false

────────────────────
_ do get reruns-statement Bool

` Whether the function being emitted is one a live action runs a live statement again with.
if function.kind != .instance-body || unit.instance == no-instance
    = false
. row = instances.rows[unit.instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.kind == .live-decl
= false

────────────────────
_ do hand-off
    - error Operand
    - type TypeId
    - id SyntaxId

` Gives an error to the global `unhandled-error` of core, as the reference hands off one that
` leaves a function it calls for a section of a class, or one that fills an object with the
` markup of its class: the global is read, evaluated first
` where it has no value yet, and the function it holds is called with the error as an
` `Error`, which it is held as already, and checked for a panic as the call of any function
` value is.
. global = facts.unhandled-error
. derived = tables.is-class(type) && is-error
    .. is-error = type == types.error-type || tables.derives(type, types.error-type)
if !global || !derived || in-zone || (!function.may-panic && !in-landing)
    refuse(.refused-statement, id)
    =
. held = read-global(id, global.module, global.decl)
. layout = layout-of(held.type, id)
if layout != tables.layouts.function-layout
    refuse(.refused-statement, id)
    =
. code = load(held.operand, 0, pointer-layout, id)
. data = load(held.operand, tables.layouts.field(layout, 1).offset, managed-layout, id)
. mark = pending.length
pending += data
pending += error
do call(code, id, mark, .callee-value, void-layout, !in-landing)

────────────────────
_ error-case U32
    - type TypeId

` Which case of what the function returns holds an error of a class: the case of that
` class, or of the nearest class above it that has one. The type pass settles the errors of a
` function after it has typed the body, so no node of the body records the case.
if result-type == no-type then U32.max else error-case-of(ir.returns, type)

────────────────────
_ do error-case-of U32
    - layout LayoutId
    - type TypeId

` Which case of a value that may be an error holds an error of a class: the case of that
` class, or of the nearest class above it that has one.
. current = type
while current != no-type && current != invalid-type
    for index in 1 .. < tables.layouts.rows[layout].cases.count
        if tables.layouts.case-field(layout, index).type == current
            = index
    current = types.completions[current].base
= U32.max

────────────────────
_ do propagate Typed
    - id SyntaxId
    - callee InstanceId
    - result Operand

` The value of a call whose errors leave the function with it. What the callee returned
` holds its value or one of its errors. An error leaves the function as one raised at the
` call would, and what follows runs with the value.
= propagate-held(id, instances.signatures[callee].result, result)

────────────────────
_ do propagate-held Typed
    - id SyntaxId
    - held TypeId
    - result Operand

` The value of what a call answered with, of a type that holds a value or one of several
` errors, where the errors leave the function with the call. An error that came back outside
` the zone the collector never sees leaves from there.
. nothing = make-operand(.operand-void, 0)
. answer = take-zone-answer()
. layout = layout-of(held, id)
if !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. count = tables.layouts.rows[layout].cases.count
. given = ir.reserve-block()
. raised = ir.reserve-block()
. zoned = in-zone
branch(case-test(id, result, 0), given, raised)
ir.start-block(raised)
if closes-zone(answer)
    close-zone(id)
if answer != 0
    in-zone = false
for index in 1 .. < count
    . field = tables.layouts.case-field(layout, index)
    . next = no-block
    if index + 1 != count
        . held = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(id, result, index), held, next)
        ir.start-block(held)
    leave-with(take(result, field, id), field.type, id)
    if next != no-block
        ir.start-block(next)
in-zone = zoned
ir.start-block(given)
settle-zone-answer(id, answer)
. field = tables.layouts.case-field(layout, 0)
= Typed(take(result, field, id), field.type)

────────────────────
_ do report-result Operand
    - id SyntaxId
    - type TypeId
    - result Operand
    - hands Bool = false
    - prints Bool = false

` The value of a call that returned a `type` that holds its value or one of its errors, whose
` error the reference reports, as one no caller handles, or with `hands` gives to the global
` `unhandled-error` (`hand-off`), and then goes on. One reported that `prints` goes on too.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(type, id)
if !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    = nothing
. count = tables.layouts.rows[layout].cases.count
. joined = ir.reserve-block()
. raised = ir.reserve-block()
branch(case-test(id, result, 0), joined, raised)
ir.start-block(raised)
for index in 1 .. < count
    . field = tables.layouts.case-field(layout, index)
    . next = joined
    if index + 1 != count
        . held = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(id, result, index), held, next)
        ir.start-block(held)
    if hands
        hand-off(take(result, field, id), field.type, id)
    else
        report-error(take(result, field, id), id, prints)
    jump(joined)
    if next != joined
        ir.start-block(next)
ir.start-block(joined)
= nothing

────────────────────
_ do panic-on-error Typed
    - id SyntaxId
    - callee InstanceId
    - result Operand

` The value of a call that converts a text written in source. What the callee returned
` holds its value or one of its errors. An error is a panic there, with the error's text as
` its message, and what follows runs with the value.
. nothing = make-operand(.operand-void, 0)
. text = instances.report.error-text
. layout = layout-of(instances.signatures[callee].result, id)
. is-ready = text != no-instance && tables.instance-functions[text] != no-function
if !tables.layouts.is-union(layout) || !is-ready || !function.may-panic
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. count = tables.layouts.rows[layout].cases.count
. given = ir.reserve-block()
. raised = ir.reserve-block()
branch(case-test(id, result, 0), given, raised)
ir.start-block(raised)
for index in 1 .. < count
    . field = tables.layouts.case-field(layout, index)
    . next = no-block
    if index + 1 != count
        . held = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(id, result, index), held, next)
        ir.start-block(held)
    . mark = pending.length
    pending += take(result, field, id)
    . message = call-method(text, id, mark)
    raise-message(id, message.operand)
    if next != no-block
        ir.start-block(next)
ir.start-block(given)
. field = tables.layouts.case-field(layout, 0)
= Typed(take(result, field, id), field.type)

────────────────────
_ do raise
    - panic Operand
    - id SyntaxId

` Makes a panic the task's active one, by the function each place that raises one calls
` (`emit-raise-panic`), and leaves through the landing pad. A function the collector never sees
` leaves that zone for the call.
. crosses = in-zone
if crosses
    cross-zone(id, false)
call-raiser(tables.panic-raiser, panic, id)
if crosses
    cross-zone(id, true)
jump(landing-block(0))

────────────────────
_ do call-raiser
    - raiser FunctionId
    - value Operand
    - id SyntaxId

` Calls a function that raises a panic, given the panic or its message, the path of the module,
` and the line and the column of the node it is raised at. One raised at no node, in a function
` the compiler makes, is given no place.
?! Panic("A panic is raised where no function raises it")
    if raiser == no-function
. path = program.modules[unit.source-module].relative-path
. line U64 = 0
. column U64 = 0
if id != 0
    . begin = tree.nodes[id].loc.begin
    line = begin.line + 1
    column = begin.column + 1
. mark = pending.length
pending += value
pending += make-operand(.operand-constant, ir.add-string(if path.length != 0 then path else "no file"))
pending += integer(.machine-u64, line)
pending += integer(.machine-u64, column)
ir.depend(.callee-function, raiser, 0)
call(make-operand(.operand-symbol, tables.functions[raiser].symbol), id, mark, .callee-function, void-layout)

────────────────────
_ do raise-text
    - id SyntaxId
    - text String

` Raises a panic the compiler writes, with its message, at a node.
raise-message(id, make-operand(.operand-constant, ir.add-string(text)))

────────────────────
_ do raise-union-error
    - id SyntaxId

` Raises what a union that holds another case than the one asked for raises: its error is
` constructed and made text, and a panic is raised with that text as its message.
. report = instances.report
. made = report.union-error
. text = report.union-text
if made == no-instance || text == no-instance
    refuse(.refused-conversion, id)
    =
if tables.instance-functions[made] == no-function || tables.instance-functions[text] == no-function
    refuse(.refused-conversion, id)
    =
. was-free = in-zone
if in-zone
    cross-zone(id, false)
    in-zone = false
. mark = pending.length
for position in 0 .. < instances.signatures[made].args.count
    pending += absent-argument(id, instances.argument-type(made, position)).operand
pending += call-instance(made, id, mark).operand
. message = call-method(text, id, mark)
raise-message(id, message.operand)
in-zone = was-free

────────────────────
_ do raise-message
    - id SyntaxId
    - message Operand

` Raises a panic with a message, at a node, by the function each place that raises one calls
` (`emit-raise-message`). Nothing after it in its block is run. A function the collector never
` sees leaves that zone to make the panic.
. was-free = in-zone
if tables.message-raiser == no-function
    . panic = compiler-panic(id, message)
    =? if panic == make-operand(.operand-void, 0)
    raise(panic, id)
    in-zone = was-free
    =
if in-zone
    cross-zone(id, false)
    in-zone = false
call-raiser(tables.message-raiser, message, id)
jump(landing-block(0))
in-zone = was-free

────────────────────
_ do compiler-panic Operand
    - id SyntaxId
    - message Operand

` A panic the compiler makes with a message, at a node, or none where the program has no
` panic to make. Its constructor is given the message, and nothing for what else it takes.
` A function the collector never sees leaves that zone to make it.
. nothing = make-operand(.operand-void, 0)
. report = instances.report
. object = tables.layouts.objects[types.panic-type]
. is-ready = object != no-layout && report.source-slot != U32.max && report.trace-slot != U32.max
. made = report.panic
if !is-ready || made == no-instance || tables.instance-functions[report.source] == no-function
    refuse(.refused-expression, id)
    = nothing
if tables.instance-functions[made] == no-function
    refuse(.refused-expression, id)
    = nothing
if in-zone
    cross-zone(id, false)
    in-zone = false
. signature = instances.signatures[made]
if signature.args.count == 0 || instances.argument-type(made, 0) != types.string-type
    refuse(.refused-expression, id)
    = nothing
. mark = pending.length
pending += message
for position in 1 .. < signature.args.count
    pending += absent-argument(id, instances.argument-type(made, position)).operand
= call-instance(made, id, mark).operand

────────────────────
_ do extends Bool
    - type TypeId
    - base TypeId

` Whether a class is another or is derived from it.
. current = type
while current != no-type && current != invalid-type
    if current == base
        = true
    current = types.completions[current].base
= false

────────────────────
_ do attach-source
    - panic Operand
    - line U64
    - column U64
    - syntax SyntaxId

` Gives a panic that has no source the place it is at: the module's path, a line and a
` column, by the function the tables declared for it (`emit-source-attach`). A function the
` collector never sees leaves that zone for the call.
. helper = tables.source-attacher
?! Panic("A panic is raised where no function gives it its source")
    if helper == no-function
. path = program.modules[unit.source-module].relative-path
. mark = pending.length
pending += panic
pending += make-operand
    - .operand-constant
    - ir.add-string(if path.length != 0 then path else "no file")
pending += integer(.machine-u64, line)
pending += integer(.machine-u64, column)
ir.depend(.callee-function, helper, 0)
. crosses = in-zone
if crosses
    cross-zone(syntax, false)
call
    - make-operand(.operand-symbol, tables.functions[helper].symbol)
    - syntax
    - mark
    - .callee-function
    - void-layout
if crosses
    cross-zone(syntax, true)

────────────────────
_ do emit-raise-panic

` The function each place that raises a panic calls, given the panic, the path of the module, a
` line and a column (`raise-at`).
add-raiser-arguments()
raise-at(make-operand(.operand-argument, 0))

────────────────────
_ do emit-raise-message

` The function each place that raises a panic the compiler writes calls, given its message, the
` path of the module, a line and a column. It makes the panic (`compiler-panic`) and raises it
` there (`raise-at`).
add-raiser-arguments()
. panic = compiler-panic(0, make-operand(.operand-argument, 0))
if panic == make-operand(.operand-void, 0)
    return-nothing()
    =
raise-at(panic)

────────────────────
_ do add-raiser-arguments

ir.add-argument(managed-layout)
ir.add-argument(managed-layout)
ir.add-argument(u64-layout)
ir.add-argument(u64-layout)

────────────────────
_ do raise-at
    - panic Operand

` Makes a panic the task's active one where a function that raises one was called with a path, a
` line and a column. A panic with no source of its own is given that place where the line is not
` 0 (`emit-source-attach`). Its stack trace starts at the caller, as the runtime takes it
` (`brixRaisePanic`).
. line = make-operand(.operand-argument, 2)
. attach = ir.reserve-block()
. raising = ir.reserve-block()
branch(line, attach, raising)
ir.start-block(attach)
. helper = tables.source-attacher
. given = pending.length
pending += panic
pending += make-operand(.operand-argument, 1)
pending += line
pending += make-operand(.operand-argument, 3)
ir.depend(.callee-function, helper, 0)
call(make-operand(.operand-symbol, tables.functions[helper].symbol), 0, given, .callee-function, void-layout)
jump(raising)
ir.start-block(raising)
. report = instances.report
. object = tables.layouts.objects[types.panic-type]
. trace = tables.layouts.field(object, object-header-fields + report.trace-slot)
. mark = pending.length
pending += panic
pending += address(panic, trace.offset, managed-layout, 0)
call-runtime(.runtime-raise-panic, 0, mark)
return-nothing()

────────────────────
_ do emit-source-attach

` The function that gives a panic that has no source the place it is raised at, given the
` panic, the path of the module, a line and a column, which each place that raises one calls
` (`attach-source`).
ir.add-argument(managed-layout)
ir.add-argument(managed-layout)
ir.add-argument(u64-layout)
ir.add-argument(u64-layout)
. panic = make-operand(.operand-argument, 0)
. report = instances.report
. layouts = tables.layouts
. object = layouts.objects[types.panic-type]
. field = layouts.field(object, object-header-fields + report.source-slot)
?! Panic("The source of a panic is not an optional struct")
    if !layouts.is-struct(field.layout)
. inner = layouts.field(field.layout, 0)
. flag = layouts.field(field.layout, 1)
. source = address(panic, field.offset, field.layout, 0)
. attach = ir.reserve-block()
. attached = ir.reserve-block()
. given = pending.length
pending += make-operand(.operand-argument, 1)
pending += make-operand(.operand-argument, 2)
pending += make-operand(.operand-argument, 3)
. made = call-instance(report.source, 0, given)
branch(load(source, flag.offset, flag.layout, 0), attached, attach)
ir.start-block(attach)
. wrapped = frame(field.layout)
zero(wrapped, field.layout)
copy(address(wrapped, inner.offset, inner.layout, 0), made.operand, inner.layout, false, 0)
store(wrapped, flag.offset, integer(.machine-i8, 1), false, 0)
copy(source, wrapped, field.layout, true, 0)
jump(attached)
ir.start-block(attached)
return-nothing()

────────────────────
_ do emit-body

` The body of an instance: one the compiler generates, or one written in source. That of a
` function of an interface run for a value of a type that is none is given its receiver as
` the interface, as the type pass typed it. The function generated for a comprehension is
` a nested function whose body is the comprehension's loop; the one for a list of bullets
` yields what the bullets give; and the one for the right side of a pipe gives the value
` written there, or runs it for nothing where the pipe only taps. A function written
` with no body gives what the type it returns makes with nothing written. A class's `close`
` closes the live actions the object owns where its body ends; one that returns early, or is
` written as a value, has no shape where the program makes live actions. The function that
` runs a live statement again is given the environment it was written in, as a closure is.
` A method that yields and is typed again for a class's table with the errors a base's
` generator carries has no shape where it is called as first typed too: the reference's method
` carries the errors of whichever it compiles first. A door a fake answers under a `do with`
` calls the fake's method (`emit-forwarder`).
. row = instances.rows[unit.instance]
for forward in facts.swap-forwards
    if forward.instance == unit.instance
        emit-forwarder(forward)
        =
. body SyntaxId = 0
. declared SyntaxId = 0
. unwritten SyntaxId = 0
. owned = false
. imperative = false
. fills = false
. rerun = false
. retest = false
. tests-gate = false
. reselects = false
. selects = false
. builds-arm = false
. sources = false
. builds-row = false
. builds-slot = false
. binds = false
. wraps = false
. starts = false
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        declared = fn.syntax
        if row.retyped != no-instance && tables.instance-functions[row.retyped] != no-function
            refuse(.refused-function, declared)
            =
        if row.gives-unwritten
            unwritten = fn.return-type
        if fn.kind == .termination-panic-decl
            emit-termination-check()
            =
        if fn.is-generated && fn.kind == .default-constructor-decl
            emit-default-constructor(declared)
            =
        if fn.is-generated && fn.kind == .tuple-constructor-decl
            emit-tuple-constructor(declared)
            =
        if fn.is-generated && fn.kind == .cast-constructor-decl
            emit-cast-constructor(declared)
            =
        if fn.is-generated && is-table-constructor-kind(fn.kind)
            emit-table-constructor(class-site(row.module, fn.owner), fn.kind)
            =
        if !fn.is-generated && fn.kind == .constructor-decl
            if rule-match(program, row.module, row.decl) != 0
                emit-rule(declared, fn.body)
                =
            if function.kind == .instance-initializer
                emit-initializer(declared, fn.body)
            else
                emit-constructor(declared, fn.body)
            =
        owned = fn.owner != 0 && !fn.is-static
        . is-written = function-or-getter || fn.kind == .setter-decl
            .. function-or-getter = fn.kind == .function-decl || fn.kind == .getter-decl
        if fn.kind == .closure-decl
            owned = false
            unit = unit.received = true
            is-written = true
        if fn.kind == .subscriber-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            subscribing = fn.syntax
        if fn.kind == .iterator-decl
            owned = false
            unit = unit.received = true
            do match? tree.nodes[fn.syntax]
                | .node-iterator-expression(syntax)
                    if syntax.next == 0 && takes-item(syntax.loop)
                        body = fn.syntax
                        imperative = true
                        given-loop = syntax.loop
                | .node-pipeline-expression
                    body = fn.syntax
                    imperative = true
                    given-pipe = fn.syntax
                | .node-binary-expression
                    body = fn.syntax
                    imperative = true
                    given-pipe = fn.syntax
        if fn.kind == .bullet-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            bullets = fn.syntax
        if fn.kind == .live-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            rerun = true
        if fn.kind == .whenever-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            retest = true
        if fn.kind == .gate-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            tests-gate = true
        if fn.kind == .branch-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            reselects = true
        if fn.kind == .selector-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            selects = true
        if fn.kind == .branch-arm-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            builds-arm = true
        if fn.kind == .row-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            builds-row = true
        if fn.kind == .slot-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            wraps = tree.nodes[fn.syntax] is .node-block
            builds-slot = !wraps
        if fn.kind == .binder-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            binds = true
        if fn.kind == .source-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            sources = true
        if fn.kind == .key-decl
            owned = false
            unit = unit.received = true
            body = fn.body
        if fn.kind == .machine-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            starts = true
        if fn.kind == .pipeline-decl
            owned = false
            unit = unit.received = true
            do match? tree.nodes[fn.syntax]
                | .node-pipeline-expression(syntax)
                    body = syntax.right
                    piped = fn.syntax
                | .node-binary-expression(syntax)
                    body = syntax.rhs
                    piped = fn.syntax
            imperative = instances.signatures[unit.instance].returns == types.void-type
        if !fn.is-generated && is-written
            do match? tree.nodes[fn.syntax]
                | .node-function-syntax(syntax)
                    body = syntax.body
                    imperative = syntax.imperative
        if fn.is-content
            fills = true
            body = fn.body
            imperative = true
            if declared == 0
                declared = class-site(row.module, fn.owner)
    | .decl-converter(converter)
        declared = converter.syntax
        owned = true
        do match? tree.nodes[converter.syntax]
            | .node-converter-syntax(syntax)
                body = syntax.body
                imperative = syntax.imperative
    | .decl-fromverter(fromverter)
        declared = fromverter.syntax
        do match? tree.nodes[fromverter.syntax]
            | .node-fromverter-syntax(syntax)
                body = syntax.body
                imperative = syntax.imperative
if rule-match(program, row.module, row.decl) != 0
    emit-rule(declared, body)
    =
if body == 0 && !fills && (unwritten == 0 || stepping || returns-void)
    refuse(.refused-function, declared)
    =
.. returns-void = instances.signatures[unit.instance].returns == types.void-type
. signature = instances.signatures[unit.instance]
if stepping
    emit-steps(declared, body, imperative && signature.errors.count == 0)
    =
unit = unit.takes-self = owned
unit = unit.has-self = owned
. adapted = instances.rows[unit.instance].row-receiver
if unit.takes-self
    unit = unit.self = make-operand(.operand-argument, 0)
    if function.kind == .viewed-body
        unit = unit.owner-type = tables.receiver-view(unit.instance)
    if adapted != no-type
        ir.add-argument(layout-of(adapted, declared))
    else
        ir.add-argument(layout-of(unit.owner-type, declared))
if unit.received
    unit = unit.takes-self = true
    ir.add-argument(managed-layout)
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
. columns-at U32 = 1 + signature.args.count + (if unit.received then 1 else 0)
if adapted != no-type && instances.rows[unit.instance].row-validated
    ir.add-argument(pointer-layout)
returns-type = signature.returns
ir.returns = layout-of(signature.returns, declared)
if bridged
    bridge-row-receiver(declared, columns-at)
    =
if signature.errors.count != 0 && function.kind != .event-handler
    return-results(signature.result, declared)
if !unit.takes-self && !unit.received
    emit-dispatch(declared, signature)
if function.kind == .event-handler
    open-handler()
if unit.received
    keep-cells(declared)
open-environment(declared)
share-self(declared)
bind-arguments(declared)
make-subscribers(declared)
if adapted != no-type && unit.takes-self && !unit.received
    bind-row-receiver(declared, columns-at)
if closes-actions()
    stop-owned(declared)
if rerun
    emit-rerun(declared, body)
    =
if starts
    emit-machine-start(declared)
    =
if retest
    emit-retest(body)
    =
if tests-gate
    emit-gate-test(body)
    =
if reselects
    emit-reselect(declared, body)
    =
if selects
    emit-selector(declared, tree.selector-control(body))
    =
if builds-arm
    emit-arm(declared, body)
    =
if builds-row && tree.row-region(body)
    emit-row-region(declared, body)
    =
if binds
    emit-binder(body)
    =
if wraps
    content-roots += kept-root(body)
    make-cells(U32.max - 1)
    emit-wrapped(body)
    content-roots.pop()
    =
if sources
    emit-resource(declared, body)
    =
if fills
    emit-filling(declared, body)
    =
if fusing
    if given-pipe != 0 || tables.step-functions[unit.instance] == no-function
        refuse(.refused-function, declared)
        =
    if given-loop != 0
        keep-given(declared)
    emit-fused-body
        - declared
        - body
        - (imperative || given-loop != 0) && (signature.errors.count == 0 || reads-errors)
    =
if given-loop != 0 || given-pipe != 0
    keep-given(declared)
    if tables.step-functions[unit.instance] == no-function
        refuse(.refused-function, declared)
        =
if tables.step-functions[unit.instance] != no-function
    make-generator(declared)
    =
if body == 0
    . made = default-value(unwritten, returns-type, layout-of(returns-type, declared), declared)
    return-value(made.operand, declared)
    =
if bullets != 0
    emit-built-bullets(declared, bullets)
    =
if imperative
    emit-block(body)
    if row.ends-generator
        end-generator(declared)
    if closes-actions()
        close-owned(declared)
    emit-end(declared)
    =
if closes-actions()
    emit-value(body, 0, true)
    =
if builds-row || builds-slot
    content-roots += kept-root(body)
    if builds-slot
        make-cells(U32.max - 1)
    emit-value(body, if builds-row then body else 0, false, builds-slot)
    content-roots.pop()
    =
emit-value(body, 0)

────────────────────
_ do kept-root Operand
    - body SyntaxId

` The batch the function that builds a row, or what a line gives a slot, is built under, read
` from the local the type pass found it kept in, or nothing.
. root = facts.region-root-of(unit.reading, body)
= if root then read-captured(root.slot, body, root.batch).operand else make-operand(.operand-void, 0)

────────────────────
_ do emit-filling
    - declared SyntaxId
    - body SyntaxId

` The body of the function that fills an object with the markup written in its class: the
` builders of slots the functions it writes reach are kept (`keep-builders`), the state cells and
` values of rules it is given are kept (`take-cells`, `take-values`) and those of the `when`s
` around the rules written in rules its
` own markup brings are made and bound (`bind-cells`), the function of
` the class above is run on the object, where the type pass kept its call (`run-above`), then
` the lines of the class's own markup are run as content of the object, those of its `• This`
` where that writes them, with the state machines written beside a root `<This` where they are
` written among the root's lines, and then the rules of the class that wait for them.
. type = instances.rows[unit.instance].self-type
keep-builders(declared)
take-cells(declared)
take-values(declared)
make-cells(0)
bind-cells(0, unit.self)
. above = facts.filler-of(unit.reading)
if above != no-fact
    run-above(declared, above, type, body)
content-hosts += Typed(unit.self, type)
for machine in tree.root-machines(declared, false)
    emit-statement(machine)
if body != 0
    emit-block(body, tree.nodes[declared] is .node-rule-syntax)
for machine in tree.root-machines(declared, true)
    emit-statement(machine)
content-hosts.pop()
run-markup-rules(type, declared)
emit-end(declared)

────────────────────
_ do keep-builders
    - declared SyntaxId

` Keeps, in the environment, the function that builds each slot this function was given that a
` function written in it reaches through the local that holds it.
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    if bindings.slots[slot].kind != .slot-builder || !owns(slot) || !is-captured(slot)
        continue
    . position = instances.slot-argument(unit.instance, bindings.slots[slot].name)
    if position == U32.max
        continue
    . type = instances.argument-type(unit.instance, position)
    if type != facts.slot-type(unit.instance, offset)
        refuse(.refused-conversion, declared)
        =
    keep-captured
        - slot
        - make-operand(.operand-argument, if unit.takes-self then position + 1 else position)
        - type
        - declared

────────────────────
_ do run-above
    - declared SyntaxId
    - call FactId
    - type TypeId
    - body SyntaxId

` Runs, on the object, the function that fills it with the markup of the class above, given the
` state cells this function was given, and the builder of each slot it takes, in the order it
` takes them: the one this function was given for the slot, or else the function of the line of
` its own markup that gives the slot content, made the `MarkupSlotBuilder` the type pass
` recorded at the line. Making these runs nothing.
. callee = facts.calls[call].callee
. slots = instances.rows[callee].slots.count
. carried = instances.rows[callee].carried
if slots == 0 && carried == 0
    call-protocol(declared, call, unit.self, type, make-operand(.operand-void, 0), no-type, false)
    =
. above = instances.rows[callee].self-type
if !is-callable(callee) || odd-arity || carried != instances.rows[unit.instance].carried || unrelated
    refuse(.refused-statement, declared)
    =
.. odd-arity = instances.signatures[callee].args.count != carried + slots
.. unrelated = !tables.is-class(type) || !tables.is-class(above) || !tables.derives(type, above)
. mark = pending.length
pending += unit.self
for offset in 0 .. < carried
    . argument = instances.value-argument(unit.instance, offset)
    pending += make-operand(.operand-argument, if unit.takes-self then argument + 1 else argument)
for offset in 0 .. < slots
    . name = instances.slot-name(callee, offset)
    . argument = instances.slot-argument(unit.instance, name)
    if argument != U32.max
        if instances.argument-type(unit.instance, argument) != callee-argument
            refuse(.refused-conversion, declared)
        .. callee-argument = instances.argument-type(callee, carried + offset)
        pending += make-operand(.operand-argument, if unit.takes-self then argument + 1 else argument)
        continue
    . line = body-slot-line(body, name)
    if line == 0
        refuse(.refused-expression, declared)
        break
    . built = builder-value(line)
    if built.type != instances.argument-type(callee, carried + offset)
        refuse(.refused-conversion, line)
    pending += built.operand
call-instance(callee, declared, mark)

────────────────────
_ do emit-fill
    - made Operand
    - type TypeId
    - declared SyntaxId

` Runs, on the object a constructor has made, the function that fills it with the markup
` written in its class, where the type pass kept the call: once the constructor's own body
` has run. It is given the state cells the constructor was given, then the function that builds
` each slot the constructor was given one for, which are the constructor's last arguments, in
` the order both take them. Where the constructor was given last the function that gives an
` element's name the object, that runs first.
. call = facts.filler-of(unit.reading)
if call == no-fact
    =
. first = instances.signatures[unit.instance].args.count - instances.rows[unit.instance].slots.count
. slots = instances.rows[unit.instance].slots.count
. carried = instances.rows[unit.instance].carried
if instances.takes-binder(unit.instance)
    slots -= 1
    run-binder(made, instances.argument-type(unit.instance, first + slots), first + slots, declared)
. callee = facts.calls[call].callee
if instances.rows[callee].slots.count == 0 && carried == 0 && instances.rows[callee].carried == 0
    call-protocol(declared, call, made, type, make-operand(.operand-void, 0), no-type, false)
    =
if !is-callable(callee) || other-arity || instances.rows[callee].carried != carried || other-self
    refuse(.refused-statement, declared)
    =
.. other-arity = instances.signatures[callee].args.count != carried + slots
.. other-self = instances.rows[callee].self-type != type
. mark = pending.length
pending += made
for offset in 0 .. < carried
    . position = instances.value-argument(unit.instance, offset)
    pending += make-operand(.operand-argument, if unit.takes-self then position + 1 else position)
for offset in 0 .. < slots
    . position = first + offset
    if instances.argument-type(unit.instance, position) != callee-argument
        refuse(.refused-conversion, declared)
    .. callee-argument = instances.argument-type(callee, carried + offset)
    pending += make-operand(.operand-argument, if unit.takes-self then position + 1 else position)
call-instance(callee, declared, mark)

────────────────────
_ do emit-binder
    - name SyntaxId

` The function a markup element's constructor is given to give the element's name its object:
` it stores its one argument in the local the name declares, which the environment of the
` function that declares it holds, and in the receiver's property of the name where the type
` pass kept that, and returns. A name no block declares a local for has only the property.
. resolution = bindings.resolution-of(instances.rows[unit.reading].binding, name)
. local = resolution.kind == .resolve-slot
. place = facts.named-store-of(unit.reading, name)
if (local && !is-captured(resolution.slot)) || (!local && place == U32.max)
    refuse(.refused-function, name)
    =
. host = make-operand(.operand-argument, 1)
if local
    keep-captured(resolution.slot, host, instances.argument-type(unit.instance, 0), name)
if place != U32.max
    store-named(name, place, Typed(host, instances.argument-type(unit.instance, 0)))
emit-end(name)

────────────────────
_ do emit-wrapped
    - body SyntaxId

` The function that builds the lines of a markup element's body, all content of its class's
` default slot, into a node (`emit-wrapper`), returned as the slot's type, once the state cells
` made for the rules the slot's outlet applies are bound to it.
. made = emit-wrapper(body)
. built = made.type
bind-cells(U32.max - 1, made.operand)
. value = convert(body, .reason-return, Typed(made.operand, built))
if value.type != returns-type
    refuse(.refused-conversion, body)
    =
value = leaving(value, body, true)
return-value(value.operand, body)

────────────────────
_ do emit-wrapper Typed
    - body SyntaxId

` Lines of markup content built into one node, as a slot's: an object of the slot's type made
` by the constructor the type pass recorded at the body, with the lines run as its content
` under the batch in force.
. made = emit-call(body, 0, RowRange'SyntaxId())
. type = made.type
content-hosts += Typed(made.operand, type)
content-roots += if content-roots.length != 0 then outer-root else make-operand(.operand-void, 0)
    .. outer-root = content-roots[content-roots.length - 1]
emit-block(body)
content-hosts.pop()
content-roots.pop()
= Typed(made.operand, type)

────────────────────
_ do run-binder
    - made Operand
    - binder TypeId
    - position U32
    - declared SyntaxId

` Runs the function a constructor is given to give a markup element's name the object it has
` made, which only stores it and so neither panics nor raises.
. layout = layout-of(binder, declared)
if layout != tables.layouts.function-layout
    refuse(.refused-statement, declared)
    =
. source = make-operand(.operand-argument, if unit.takes-self then position + 1 else position)
. code = load(source, 0, pointer-layout, declared)
. data = load(source, tables.layouts.field(layout, 1).offset, managed-layout, declared)
. mark = pending.length
pending += data
pending += made
call(code, declared, mark, .callee-value, void-layout)

────────────────────
_ do emit-deferred
    - type TypeId
    - declared SyntaxId

` Gives the properties a constructor put off their first values, once the markup of the
` class has run, in the order the type pass placed them. Each value reads the object as it
` is then, and one that reads something tracked is given its live action once stored.
. row = facts.deferred-of(unit.instance)
if row.count == 0
    =
. object = tables.layouts.objects[type]
unit = unit.deferred-type = type
for offset in 0 .. < row.count
    . place = facts.deferred-places[row.start + offset]
    . property = types.properties[place]
    . field = tables.layouts.field(object, object-header-fields + property.slot)
    store-default(unit.self, field, property, place, type, declared)
    if place-trackers.length != 0
        subscribe-value(place, place-trackers[0].trackers, type, declared)
        place-trackers.clear()
unit = unit.deferred-type = no-type

────────────────────
_ do bind-row-receiver
    - declared SyntaxId
    - columns-at U32

` The receiver of a member that runs on the case of a row, as TypeScript's
` `table-row-extension` makes it: the row is taken first, and the receiver is the case's
` cells, read through the columns taken last where TypeScript checked the row's storage where
` the case was read, and else through the row, checked again where its table grows. The
` receiver is no value of its own: each use goes through the cells, and as a value it is
` gathered from them.
. held = instances.rows[unit.instance]
. union = tables.unions.of(table-row-type(held.row-receiver))
. layout = layout-of(held.row-receiver, declared)
if union == U32.max || held.row-case == U32.max || held.binding == no-binding
    refuse(.refused-function, declared)
    =
. none = make-operand(.operand-void, 0)
. columns = if held.row-validated then make-operand(.operand-argument, columns-at) else none
. index = part(unit.self, layout, 1, declared)
. case-type = tables.unions.cases[tables.unions.layouts[union].cases.start + held.row-case].type
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    if bindings.slots[slot].kind == .slot-this
        if is-captured(slot)
            refuse(.refused-function, declared)
            =
        this-cursor = case-cursors.length as U32
        bound += BoundValue(slot, case-type, unit.self, this-cursor)
        case-cursors += CaseCursor
            - unit.self
            - held.row-receiver
            - union
            - held.row-case
            - held.row-validated
            - columns
            - index.operand
unit = unit.has-self = false
if held.row-validated
    row-columns = columns-at

────────────────────
_ do bridge-row-receiver
    - declared SyntaxId
    - columns-at U32

` The body TypeScript builds for a member that runs on a row's case where the member may move
` the row's storage: it gathers the case from the row's cells and runs the member's instance
` on the case with the arguments it was given.
. held = instances.rows[unit.instance]
. union = tables.unions.of(table-row-type(held.row-receiver))
. layout = layout-of(held.row-receiver, declared)
. signature = instances.signatures[unit.instance]
if union == U32.max || unbridged || unit.received || signature.errors.count != 0
    refuse(.refused-function, declared)
    =
.. unbridged = held.row-case == U32.max || held.materialized == no-instance
. columns = make-operand(.operand-argument, columns-at)
. index = part(unit.self, layout, 1, declared)
. gathered = gather-union-case(declared, union, held.row-case, columns, index.operand)
. mark = pending.length
pending += gathered.operand
for position in 0 .. < signature.args.count
    pending += make-operand(.operand-argument, 1 + position)
. result = call-instance(held.materialized, declared, mark)
return-value(result.operand, declared)

────────────────────
_ do emit-task-body

` The body of a spawned task: a function the runtime runs with the capture made where the
` task was spawned, and that returns to nothing. It runs `taskinit` where the program has
` one, then the body, flushes what it wrote of probes where they compile, and ends the task,
` where the body ends or returns. A task with handlers tries them where a panic ends it
` (`handle-failure`).
. row = instances.rows[unit.instance]
. body SyntaxId = 0
. declared SyntaxId = 0
. handlers = RowRange'SyntaxId()
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        declared = fn.syntax
        do match? tree.nodes[fn.syntax]
            | .node-do-task-block(task)
                body = task.body
                handlers = task.catchers
if body == 0 || tables.captures[unit.instance] == unbuilt-environment
    refuse(.refused-function, declared)
    =
unit = unit.received = true
unit = unit.takes-self = true
ir.add-argument(managed-layout)
ir.returns = void-layout
if tables.task-init != no-function
    call-function(tables.task-init, declared)
open-environment(declared)
share-self(declared)
task-leaving = ir.reserve-block()
if handlers.count != 0
    task-failing = ir.reserve-block()
    task-handlers = handlers
emit-block(body)
jump(task-leaving)
ir.start-block(task-leaving)
set-task-end(task-end-finished)
if tables.probe-flush != no-function
    call-function(tables.probe-flush, declared)
call-runtime(.runtime-terminate-active-task, 0, pending.length)
return-nothing()

────────────────────
_ do set-task-end
    - end U32

` Tells the runtime how the task ends, which the `Task` a `do new` gave reads. The first it is
` told stands.
. mark = pending.length
pending += integer(.machine-u32, end)
call-runtime(.runtime-set-task-end, 0, mark)

────────────────────
_ do make-capture Operand
    - id SyntaxId
    - callee InstanceId

` The capture the body of a task spawned at a node, or of a `do without gc` block, is given: an
` object the collector owns that holds the link to the environment in force here where the body
` shares a name, each local, argument and receiver the body copies, read here, where a lazy one
` is evaluated if it was not, as a lazy one the body shares is, and the state of each global
` `do with` binds that the body reads outside its own bindings. A block's body is given the
` address of each local and argument it refers to instead (`slot-address`). A body that captures
` nothing is given none.
. capture = integer(.machine-pointer, 0)
. layout = tables.captures[callee]
if layout == unbuilt-environment
    refuse(.refused-statement, id)
    = capture
if layout == no-layout
    = capture
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
if tables.layouts.rows[layout].is-managed
    pending += make-operand(.operand-descriptor, layout)
else
    pending += integer(.machine-pointer, 0)
capture = call-runtime(.runtime-allocate-object, id, mark, managed-layout)
if tables.links-capture(callee)
    if open-turns.length == 0 && unit.environment == no-local && !unit.received
        refuse(.refused-statement, id)
        = capture
    store(capture, tables.layouts.field(layout, 0).offset, written-environment(id), true, id)
. captured = bindings.nested[tables.capture-rows[callee]].captures
for index in 0 .. < captured.count
    . slot = bindings.captures[captured.start + index].slot
    if !tables.copies(callee, slot)
        if bindings.slots[slot].kind == .slot-lazy && !task-holds(slot)
            . shared = find-captured(slot, id)
            read-lazy-local(slot, id, shared.type)
        continue
    . field = tables.layouts.field(layout, tables.capture-field(callee, slot))
    if tables.refers(callee, slot)
        . place = slot-address(slot, id)
        store(capture, field.offset, place, false, id)
        continue
    . value = capture-value(slot, field.type, id)
    if value.type != field.type
        refuse(.refused-statement, id)
        = capture
    if tables.layouts.is-struct(field.layout)
        store-struct(capture, field, value.operand, id)
    else if field.layout != void-layout
        store(capture, field.offset, value.operand, is-managed-pointer(field.layout), id)
. stacks = tables.stack-holds(callee)
. first = tables.capture-stacks(callee)
for index in 0 .. < stacks.length
    capture-stack(capture, tables.layouts.field(layout, (first + index) as U32), stacks[index], id)
= capture

────────────────────
_ do slot-address Operand
    - slot SlotId
    - site SyntaxId

` The address of a local or an argument of the function that the capture of a `do without gc`
` block refers to: of its field in the environment that keeps it, of its cell, which stays in
` the frame, or of the memory a struct argument with no cell lies in, which the function owns.
. nothing = make-operand(.operand-void, 0)
. offset = slot-offset(slot, site)
if is-captured(slot)
    . field = find-captured(slot, site)
    = address(captured-base(site), field.offset, pointer-layout, site)
. cell = unit.cells[offset]
if cell != no-local && in-memory
    = make-operand(.operand-value, append(.op-local-address, site, Span(), cell, pointer-layout))
.. in-memory = ir.locals[cell].address-taken || tables.layouts.is-struct(ir.locals[cell].layout)
if bindings.slots[slot].kind == .slot-argument && cell == no-local && !stepping
    . index = argument-position(slot) + (if unit.takes-self then 1 else 0)
    if index < ir.arguments.length && tables.layouts.is-struct(ir.arguments[index])
        = address(make-operand(.operand-argument, index), 0, pointer-layout, site)
refuse(.refused-expression, site)
= nothing

────────────────────
_ do emit-region
    - id SyntaxId

` A `do without gc` block outlined, as the reference calls it: its body's function is called with
` the capture `make-capture` makes, crossing into the zone the collector never sees and back.
. callee = region-callee(id)
if callee == no-instance || tables.instance-functions[callee] == no-function
    refuse(.refused-statement, id)
    =
. capture = make-capture(id, callee)
. mark = pending.length
pending += capture
do call-instance(callee, id, mark)

────────────────────
_ do region-callee InstanceId
    - id SyntaxId

` The body of the `do without gc` block at a node, as the type pass recorded it.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == .call-function && tables.is-region(facts.calls[fact].callee)
        = facts.calls[fact].callee
    fact = facts.calls[fact].next
= no-instance

────────────────────
_ do emit-region-body

` The body of a `do without gc` block: a function called with the capture made where the block is,
` which returns nothing.
. row = instances.rows[unit.instance]
. body SyntaxId = 0
. declared SyntaxId = 0
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        declared = fn.syntax
        body = fn.body
if body == 0 || tables.captures[unit.instance] == unbuilt-environment
    refuse(.refused-function, declared)
    =
unit = unit.received = true
unit = unit.takes-self = true
ir.add-argument(managed-layout)
ir.returns = void-layout
open-environment(declared)
share-self(declared)
emit-block(body)
return-nothing()

────────────────────
_ do emit-task-value Operand
    - id SyntaxId
    - row ASTDoTaskBlock

` The `Task` a `do new` used as a value gives: the task is spawned as one written as a statement
` is, but the runtime is asked for the record it keeps of how the task ends, which the function
` the type pass recorded at the node makes the value of.
. worker = if row.is-parallel then 0 else row.worker
. priority = row.scheduling == .task-scheduling-priority
. ending = emit-spawn(id, worker, row.is-parallel, priority, row.large-stack, true)
. callee = task-value-callee(id)
if callee == no-instance
    refuse(.refused-expression, id)
    = make-operand(.operand-void, 0)
. mark = pending.length
pending += ending
= call-instance(callee, id, mark).operand

────────────────────
_ do task-value-callee InstanceId
    - id SyntaxId

` The function that makes the `Task` a `do new` used as a value gives, as the type pass
` recorded it at the node.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == .call-function
        = facts.calls[fact].callee
    fact = facts.calls[fact].next
= no-instance

────────────────────
_ do emit-spawn Operand
    - id SyntaxId
    - worker SyntaxId
    - parallel Bool
    - priority Bool
    - large-stack Bool
    - valued = false

` Spawns a task, given the capture `make-capture` makes for its body. The runtime is given the
` queue the worker named holds, where there is one, the body and its capture, the size of the
` memory a task holds its own globals in, the place the task was spawned at and how to run it.
` A `valued` spawn also asks for the record the runtime keeps of how the task ends, which it
` answers. A task an object owns is started with the object, which keeps it for its `close`
` to cancel.
. nothing = make-operand(.operand-void, 0)
. callee = task-callee(id)
. body = if callee != no-instance then tables.instance-functions[callee] else no-function
if body == no-function
    refuse(.refused-statement, id)
    = nothing
. owned = is-owned-task(id)
. owner = if owned then task-owner(id) else nothing
if owned && operand-kind(owner) == .operand-void
    = nothing
. capture = make-capture(id, callee)
. mark = pending.length
if owned
    pending += num-cast(id, owner, managed-layout, pointer-layout)
if worker != 0
    . queue = emit-expression(worker)
    . held = layout-of(queue.type, worker)
    if tables.layouts.is-struct(held) && tables.layouts.rows[held].fields.count == 1
        queue = Typed(take(queue.operand, tables.layouts.field(held, 0), worker), queue.type)
        held = tables.layouts.field(held, 0).layout
    if held != pointer-layout && held != managed-layout
        refuse(.refused-statement, worker)
        = nothing
    pending += queue.operand
else
    pending += integer(.machine-pointer, 0)
ir.depend(.callee-function, body, 0)
pending += make-operand(.operand-symbol, tables.functions[body].symbol)
pending += capture
pending += integer(.machine-u64, tables.task-local-size as U64)
. path = program.modules[unit.source-module].relative-path
pending += make-operand
    - .operand-constant
    - ir.add-string(if path.length != 0 then path else "no file")
. begin = tree.nodes[id].loc.begin
pending += integer(.machine-u32, begin.line + 1)
pending += integer(.machine-u32, begin.column + 1)
. options U32 = 0
if priority
    options = options /or/ task-start-priority
if parallel
    options = options /or/ task-start-spin
if large-stack
    options = options /or/ task-start-large-stack
if valued
    options = options /or/ task-start-handle
pending += integer(.machine-u32, options)
. start = if owned then RuntimeFunction.runtime-start-owned-task else RuntimeFunction.runtime-start-task
= call-runtime(start, id, mark, pointer-layout)

────────────────────
_ do is-owned-task Bool
    - id SyntaxId

` Whether the type pass found the task spawned at a node owned by an object.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == .call-owned-task
        = true
    fact = facts.calls[fact].next
= false

────────────────────
_ do task-owner Operand
    - site SyntaxId

` The object that owns a task the type pass found owned: the innermost markup element being
` built, or else the `TaskOwner` of the activation of a case the binder gave it to, or else the
` receiver, as `own-callback` finds the owner of a live action. An activation that keeps no
` `TaskOwner` leaves the task owned by nothing.
. binding = instances.rows[unit.reading].binding
. tasks = bindings.activation-tasks(binding, site, program.store-atom("(tasks)"))
if content-hosts.length != 0
    . host = content-hosts[content-hosts.length - 1]
    if tables.is-class(host.type)
        = host.operand
else if tasks != no-slot
    = read-captured(tasks, site, find-captured(tasks, site).type).operand
else if unit.has-self && tables.is-class(unit.owner-type)
    = unit.self
refuse(.refused-statement, site)
= make-operand(.operand-void, 0)

────────────────────
_ do capture-value Typed
    - slot SlotId
    - type TypeId
    - site SyntaxId

` The value of a local a spawned task's body captures, where the task is spawned.
if bindings.slots[slot].kind == .slot-lazy && !task-holds(slot)
    = read-lazy-local(slot, site, type)
if !is-captured(slot)
    = copied-value(slot, type, site)
. held = find-captured(slot, site)
= Typed(take(captured-base(site), held, site), held.type)

────────────────────
_ do copied-value Typed
    - slot SlotId
    - type TypeId
    - site SyntaxId

` The value a spawned task's body copies of a local, an argument, the item of a loop or the
` receiver that no environment holds: the spawning function's own.
. kind = bindings.slots[slot].kind
if kind == .slot-this && unit.has-self
    = Typed(unit.self, unit.owner-type)
if kind == .slot-local
    = read-local(slot, site, type)
if kind == .slot-loop-item
    . loop = bindings.scopes[bindings.slots[slot].scope].syntax
    if facts.loop-take(unit.reading, loop) == .take-whole
        = read-item(loop, site, type)
    = read-local(slot, site, type)
if kind == .slot-argument && is-own-slot(slot)
    . position = argument-position(slot)
    . cell = unit.cells[slot - unit.slot-start]
    if cell != no-local
        = Typed(load-local(cell, site), instances.argument-type(unit.instance, position))
    = Typed(make-operand(.operand-argument, if unit.takes-self then position + 1 else position), instances.argument-type(unit.instance, position))
refuse(.refused-expression, site)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do task-holds Bool
    - slot SlotId

` Whether a local of a function further out is held in the capture of a spawned task's body
` that the function is, or is written in, as one the body copies. A lazy one is held there as
` the value the spawn evaluated, the body's own to change.
. home = tables.slot-functions[slot]
. owner = unit.instance
while owner != no-instance && tables.instance-scopes[owner] != home
    if tables.capture-rows[owner] != no-place && tables.copies(owner, slot)
        = true
    owner = instances.rows[owner].enclosing
= false

────────────────────
_ do task-callee InstanceId
    - id SyntaxId

` The body of the task spawned at a node, as the type pass recorded it.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if spawns-task(facts.calls[fact].form)
        = facts.calls[fact].callee
    fact = facts.calls[fact].next
= no-instance

────────────────────
_ do end-generator
    - declared SyntaxId

` What the function that ends a generator does once its own body has run. A generator that
` has not finished is given the step that runs the cleanups open where it waits, and is
` called once more: it runs them and has finished. One that has not started runs nothing
` then. The receiver is the generator, a value of a function type whose data is the
` environment that keeps the step after its link.
. row = instances.rows[unit.instance]
. layout = if !unit.has-self then void-layout else layout-of(unit.owner-type, declared)
if layout != tables.layouts.function-layout || row.yields == no-type || in-zone
    refuse(.refused-function, declared)
    =
. answers = layout-of(row.yields, declared)
. place = tables.layouts.rows[managed-layout].size
. code = load(unit.self, 0, pointer-layout, declared)
. data = load(unit.self, tables.layouts.field(layout, 1).offset, managed-layout, declared)
. step = load(data, place, i32-layout, declared)
. waiting = ir.reserve-block()
. ended = ir.reserve-block()
branch(compare(declared, .compare-greater-equal, step, integer(.machine-i32, 0)), waiting, ended)
ir.start-block(waiting)
. last = arithmetic
    - declared
    - .arithmetic-subtract
    - integer(.machine-i32, finished-step)
    - step
    - i32-layout
store(data, place, last, false, declared)
. mark = pending.length
pending += data
call(code, declared, mark, .callee-value, answers, !in-landing)
jump(ended)
ir.start-block(ended)

────────────────────
_ do make-generator
    - declared SyntaxId

` What a function that yields does where it is called: its environment, made as any
` function's, holds its receiver and its arguments, and the step it has reached, which is
` none yet. It returns the generator, a value of a function type that holds the function of
` the body and the environment, or that value as the interface the function returns, or
` converted to what the function is declared to return, as the type pass recorded at the
` declaration. A function that raises errors has no shape yet, nor has one whose items'
` type the type pass says depends on the order its yields are folded in.
. row = instances.rows[unit.instance]
. step = tables.step-functions[unit.instance]
if unit.environment == no-local || row.makes == no-type || result-type != no-type || row.splits-yields
    refuse(.refused-function, declared)
    =
. layout = layout-of(row.makes, declared)
if layout != tables.layouts.function-layout
    refuse(.refused-function, declared)
    =
ir.depend(.callee-function, step, 0)
. made = frame(layout)
store(made, 0, make-operand(.operand-symbol, tables.functions[step].symbol), false, declared)
store
    - made
    - tables.layouts.field(layout, 1).offset
    - load-local(unit.environment, declared)
    - false
    - declared
if row.makes != returns-type && intrinsic(returns-type) == .interface
    made = make-interface(declared, row.makes, returns-type, made).operand
else if row.makes != returns-type
    . converted = convert(declared, .reason-return, Typed(made, row.makes))
    made = converted.operand
    if converted.type != returns-type
        refuse(.refused-function, declared)
return-value(made, declared)

────────────────────
_ do emit-steps
    - declared SyntaxId
    - body SyntaxId
    - plain Bool

` The body of a function that yields, which the generator it made runs a step at a time. It
` is given the environment the function made where it was called, and answers an optional
` of an item: the one the next yield gives, or nothing once the body has finished.
` 1. Each call reads the receiver from the environment, and then goes to where the step
`    kept there says: the start of the body, or what follows the yield that left last.
` 2. The body is emitted once, in order, as a block: the cleanups it opens run where it
`    ends. There, and wherever it returns but at a yield, it keeps the step that says it has
`    finished.
` 3. The dispatch is emitted last, when the steps are known.
` A step of a generator that raises answers its optional or an error, as a function that
` raises does, and has finished where an error leaves it.
` A body written as an expression has no shape yet. Neither
` has the loop of a comprehension or a list of bullets that checks anything but a loop's
` own poll for a panic, where functions of several instances share its name: TypeScript
` numbers the names in a stack trace in the order it compiles in. A stack trace through
` such a function is the one TypeScript prints with no inlining, which runs it as it is.
. row = instances.rows[unit.instance]
. layout = tables.environments[unit.instance]
if !plain || row.yields == no-type || layout == no-layout || layout == unbuilt-environment
    refuse(.refused-function, declared)
    =
unit = unit.takes-self = false
unit = unit.has-self = false
ir.add-argument(managed-layout)
returns-type = value-returned(row.yields)
ir.returns = layout-of(returns-type, declared)
if returns-type != row.yields
    return-results(row.yields, declared)
unit = unit.environment = ir.add-local(managed-layout)
store-local(unit.environment, make-operand(.operand-argument, 0), declared)
share-self(declared)
. dispatch = ir.reserve-block()
. entry = ir.reserve-block()
jump(dispatch)
ir.start-block(entry)
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
if given-loop != 0
    emit-given(body)
else if given-pipe != 0
    emit-pattern-pipe(given-pipe)
else if bullets != 0
    emit-bullets(bullets)
else
    emit-block(body)
close-cleanups(mark)
scoping = own-scoping
emit-end(declared)
ir.start-block(dispatch)
. base = make-operand(.operand-argument, 0)
. step = load(base, tables.layouts.field(layout, 1).offset, i32-layout, declared)
. next = ir.reserve-block()
branch(compare(declared, .compare-equal, step, integer(.machine-i32, 0)), entry, next)
ir.start-block(next)
for position in 0 .. < resumes.length
    next = ir.reserve-block()
    . number U64 = (position + 1) as U64
    branch
        - compare(declared, .compare-equal, step, integer(.machine-i32, number))
        - resumes[position]
        - next
    ir.start-block(next)
for position in 0 .. < closings.length
    if closings[position] == no-block
        continue
    next = ir.reserve-block()
    . number U64 = 0u64 - position - 2
    branch
        - compare(declared, .compare-equal, step, integer(.machine-i32, number))
        - closings[position]
        - next
    ir.start-block(next)
return-absent(declared)

────────────────────
_ do emit-fused-body
    - declared SyntaxId
    - body SyntaxId
    - plain Bool

. row = instances.rows[unit.instance]
if !plain || row.yields == no-type || row.splits-yields || result-type != no-type
    refuse(.refused-function, declared)
    =
. step = tables.functions[tables.step-functions[unit.instance]]
function.may-panic = step.may-panic
function.carries = step.carries
function.polls = step.polls
returns-type = value-returned(row.yields)
ir.returns = void-layout
ir.signals = step.may-panic || step.carries || step.polls
if step.polls && budget == no-local
    open-polls()
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
if given-loop != 0
    emit-given(body)
else if bullets != 0
    emit-bullets(bullets)
else
    emit-block(body)
close-cleanups(mark)
scoping = own-scoping
emit-end(declared)

────────────────────
_ do emit-given
    - id SyntaxId

` The body of the function generated for a comprehension: its loop, over the container
` the function was given.
do match? tree.nodes[id]
    | .node-iterator-expression(row)
        emit-for(id, row.loop, row.body)
        =
refuse(.refused-function, id)

────────────────────
_ do emit-pattern-pipe
    - pipe SyntaxId

` The body of the function generated for a stream piped through a pattern, as the reference
` makes it: the stream the pattern reads the value piped through is made, once, of what a
` bullet the pipe reads alone writes where it reads one, evaluated then and converted as the
` type pass recorded. Then on each pass a stream the type pass found the function makes for
` itself is released, where it can be; the stream is asked whether it has more, and the
` function ends where it has not; it is marked, and the pattern matched from where it is, as
` a rule's arms are, without reading the rest, asking the stream for more input where a part
` reads past the end of its buffer; the function ends where it fails. Where the match did not
` move the stream on, it panics; else what it gave is yielded. A helper the pipe is given is
` evaluated once, after the stream is made, and kept for every match to run under. One that
` marks the records a pipe matches is asked to begin each record, where the stream has more,
` before the stream is marked.
. right SyntaxId = 0
do match? tree.nodes[pipe]
    | .node-pipeline-expression(row)
        right = row.right
    | .node-binary-expression(row)
        right = row.rhs
. pattern = right
. helper SyntaxId = 0
do match? tree.nodes[right]
    | .node-stream-match(row)
        pattern = row.pattern
        helper = row.helper
. result = facts.node-type(unit.reading, pattern)
. first = facts.first-call(unit.reading, pipe)
. releases = if first != no-fact && facts.calls[first].form == .call-method then first else no-fact
. asks = if releases != no-fact then next-call(first) else first
. marks = next-call(asks)
. begins = next-call(marks)
if right == 0 || result == no-type || result == invalid-type || marks == no-fact
    refuse(.refused-statement, pipe)
    =
. slot = loop-slots(pipe)
do match? tree.nodes[tree.piped-bullet(pipe)]
    | .node-bullet-expression(row)
        . written = convert(row.item, .reason-argument, emit-expression(row.item))
        keep-state(slot, written.operand, written.type, pipe)
. container = state(slot, pipe)
. container-type = container.type
. made = stream-maker(right)
. viewed = if made != no-fact then next-call(made) else facts.first-call(unit.reading, right)
. commits = next-call(viewed)
if commits == no-fact
    refuse(.refused-statement, pipe)
    =
. opened = stream-of(right, container.operand, container-type, made)
keep-state(slot + 1, opened.operand, opened.type, pipe)
if helper != 0
    . helping = emit-expression(helper)
    keep-state(slot + 2, helping.operand, helping.type, pipe)
    if facts.plan-of(unit.reading, helper) != .plan-pattern-helper
        refuse(.refused-statement, pipe)
        =
. root = ir.reserve-block()
. done = ir.reserve-block()
jump(root)
ir.start-block(root)
emit-poll(pipe)
. stream = state(slot + 1, pipe)
. stream-type = stream.type
if releases != no-fact
    call-protocol(pipe, releases, stream.operand, stream-type, make-operand(.operand-void, 0))
. more = call-protocol(pipe, asks, stream.operand, stream-type, make-operand(.operand-void, 0))
if more.type != types.bool-type
    refuse(.refused-statement, pipe)
    =
. moving = ir.reserve-block()
branch(compare(pipe, .compare-not-equal, more.operand, integer(.machine-u8, 0)), moving, done)
ir.start-block(moving)
if begins != no-fact
    . kept = state(slot + 2, pipe)
    call-protocol(pipe, begins, kept.operand, kept.type, make-operand(.operand-void, 0))
. began = marked-cursor(pipe, marks, stream.operand, stream-type)
. refills = made == no-fact || chunked
    .. chunked = same-ref(class-ref(types, stream-type), types.chunked-token-stream-decl)
. run = view-stream(right, stream.operand, stream-type, refills, viewed, next-call(commits))
if helper != 0
    . kept-state = state(slot + 2, pipe)
    streaming = streaming.pattern-helper = kept-state.operand
    streaming = streaming.pattern-helper-type = kept-state.type
. value = attempt-arms(right, pattern, result, run, false, commits, done, false)
. ended = marked-cursor(pipe, marks, stream.operand, stream-type)
. moved = ir.reserve-block()
. stuck = ir.reserve-block()
branch(compare(pipe, .compare-greater, ended.operand, began.operand), moved, stuck)
ir.start-block(stuck)
raise-text(right, "Stream pattern pipeline made no input progress")
ir.start-block(moved)
yield-item(right, Typed(value.operand, result), false)
jump(root)
ir.start-block(done)

────────────────────
_ do marked-cursor Typed
    - site SyntaxId
    - fact FactId
    - stream Operand
    - stream-type TypeId

` Where a stream is, as the mark the call the type pass recorded makes of it holds it.
. mark = call-protocol(site, fact, stream, stream-type, make-operand(.operand-void, 0))
. layout = layout-of(mark.type, site)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 2
    refuse(.refused-type, site)
    = mark
= part(mark.operand, layout, 1, site)

────────────────────
_ do takes-item Bool
    - loop SyntaxId

` Whether the loop of a comprehension is one whose first header is over a container and
` subscribes to nothing, and whose body reads the item whole, as `each` or `it` or under
` the name written for it, or as a pattern written as a match fitted it or its arms gave
` it.
. take = facts.loop-take(unit.reading, loop)
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        . matched = take == .take-arms || fitted-match
            .. fitted-match = take == .take-fitted && matched-name(row.pattern) != row.pattern
        = !row.is-subscriber && (take == .take-whole || matched) && row.container != 0
= false

────────────────────
_ matched-name SyntaxId
    - pattern SyntaxId

` The pattern of a comprehension's loop as the binder declares it: the one a match written
` there holds, which names the item where it is a name alone.
|? pattern == 0
    0
??
    match tree.nodes[pattern]
        | .node-structure-match(row)
            row.pattern
        ??
            pattern

────────────────────
_ do check-steps

` Refuses a function that yields where a step of its body would read what the same call has
` not made: a value made before a yield, or a local stored before one. Only the environment
` keeps anything from one call to the next. On every path from where the function starts to
` a read, the value read must have been made, and the local stored; a local that holds a
` struct is stored where the whole of it is copied into or cleared, and one a call fills
` where the call is given its address. The values a join takes
` are made on the paths they arrive by, and are not looked at.
. values U32 = ir.instructions.length as U32
. width U32 = (values + ir.locals.length) as U32
. words U32 = (width + 63) / 64
. count = ir.blocks.length
. known = storage.allocate'U64(count * words + 1)
. reached = storage.allocate'U8(count + 1)
. made = storage.allocate'U64(words + 1)
for block in 0 .. < count
    reached[block] = 0
. first = ir.order[0]
reached[first] = 1
for word in 0 .. < words
    known[first * words + word] = 0
. checking = false
while true
    . changed = false
    for turn in 0 .. < ir.order.length
        . block = ir.order[turn]
        if reached[block] == 0
            continue
        for word in 0 .. < words
            made[word] = known[block * words + word]
        . rows = ir.blocks[block].instructions
        for id in rows.start .. < rows.end
            . row = ir.instructions[id]
            if row.op != .op-phi
                for position in row.operands.start .. < row.operands.end
                    . operand = ir.operands[position]
                    . payload = operand-payload(operand)
                    if operand-kind(operand) == .operand-block && !checking
                        if join-made(known, payload * words, made, words, reached[payload] == 0)
                            changed = true
                        reached[payload] = 1
                    if operand-kind(operand) != .operand-value
                        continue
                    if checking && !is-made(made, payload)
                        refuse(.refused-function, row.syntax)
                    . source = ir.instructions[payload]
                    if source.op != .op-local-address
                        continue
                    if (first-operand && copy-op) || (call-op && ir.locals[source.aux].filled)
                        mark-made(made, values + source.aux)
                    else if checking && !is-made(made, values + source.aux)
                        refuse(.refused-function, row.syntax)
                    .. first-operand = position == row.operands.start
                    .. copy-op = row.op == .op-copy || row.op == .op-zero
                    .. call-op = row.op == .op-call || row.op == .op-call-void
            if row.op == .op-load-local && checking && !is-made(made, values + row.aux)
                refuse(.refused-function, row.syntax)
            if row.op == .op-store-local
                mark-made(made, values + row.aux)
            mark-made(made, id)
    if checking
        break
    checking = !changed

────────────────────
_ is-made Bool
    - bits CPointer'U64
    - bit U32

(bits[bit / 64] /and/ (1u64 /lshift/ (bit % 64))) != 0

────────────────────
_ do mark-made
    - bits CPointer'U64
    - bit U32

bits[bit / 64] = bits[bit / 64] /or/ (1u64 /lshift/ (bit % 64))

────────────────────
_ do join-made Bool
    - known CPointer'U64
    - start U32
    - made CPointer'U64
    - words U32
    - fresh Bool

` Narrows what is known to be made where a block starts to what is also made on one more
` way in, or takes that whole for the first way found. Says whether anything changed.
. changed = fresh
for word in 0 .. < words
    . joined = if fresh then made[word] else known[start + word] /and/ made[word]
    if joined != known[start + word]
        changed = true
    known[start + word] = joined
= changed

────────────────────
_ do keep-step
    - number U64
    - site SyntaxId

` Keeps the step a function that yields has reached in its environment.
. layout = tables.environments[unit.instance]
store
    - make-operand(.operand-argument, 0)
    - tables.layouts.field(layout, 1).offset
    - integer(.machine-i32, number)
    - false
    - site

────────────────────
_ do emit-yield
    - id SyntaxId
    - expr SyntaxId
    - whole Bool

` A yield: the step that follows it is kept, and the function returns an optional that
` holds the item, converted to the type of the generator's items where the type pass
` recorded how. The next call goes on after the yield. A generator that is ended while it
` waits here runs the cleanups open here, as a return here would, and has finished.
` `<=? value` yields only where the optional written holds a value, what it holds, and
` goes on where it holds nothing. A yield written in a cleanup or outside a function that
` yields has no shape.
if whole || expr == 0
    refuse(.refused-statement, id)
    =
held-chain = expr
. value = emit-expression(expr)
held-chain = 0
yield-item(id, value, is-chained(expr))

────────────────────
_ do give-item
    - loop SyntaxId
    - site SyntaxId
    - item Typed

` What a loop with no body does with each item: the loop of a pipe that writes each item gives it to
` the write recorded at the pipe, and the loop of a bullet yields it, converted as recorded at
` `site`.
if writes.length == 0 || writes[writes.length - 1].pipe != loop
    if spreading != 0 && spreading == loop
        append-built(site, item, false)
        =
    yield-item(site, item, false)
    =
. write = writes[writes.length - 1]
. given = item.type
. sink = load-local(write.sink, loop)
call-operator(loop, write.fact, write.right, sink, write.sink-type, write.left, item.operand, given)

────────────────────
_ do yield-item
    - id SyntaxId
    - given-value Typed
    - optional Bool

` Yields a value, as `emit-yield` tells it: the whole of it, or for an `optional` one what it holds,
` where it holds anything. The conversion to the type of the generator's items is the one recorded
` at `id` for the type the value has.
if (!stepping && !fusing) || scoping.cleaning || unit.reading != unit.instance
    refuse(.refused-statement, id)
    =
. item = types.optional-inner(returns-type)
. staying = no-block
. value = given-value
if optional && types.is-optional(value.type)
    . held = value.type
    . tested = present(id, value)
    . given-block = ir.reserve-block()
    staying = ir.reserve-block()
    branch(tested.operand, given-block, staying)
    ir.start-block(given-block)
    value = payload(id, Typed(value.operand, held))
value = convert-matched(id, .reason-return, value, item)
if value.type != item
    refuse(.refused-conversion, id)
    =
. given = wrap(id, value, returns-type)
if fusing
    yield-fused(id, given.operand, staying)
    =
. resumed = ir.reserve-block()
resumes += resumed
keep-step(resumes.length as U64, id)
yielding = true
return-value(given.operand, id)
yielding = false
if open-cleanups.length == 0
    closings += no-block
else
    . closing = ir.reserve-block()
    closings += closing
    ir.start-block(closing)
    . around = landing
    run-cleanups(0, open-cleanups.length)
    landing = around
    return-absent(id)
ir.start-block(resumed)
if staying != no-block
    jump(staying)
    ir.start-block(staying)

────────────────────
_ do yield-fused
    - id SyntaxId
    - given Operand
    - staying IRBlockId

. resumed = ir.reserve-block()
. closing = if open-cleanups.length == 0 then no-block else ir.reserve-block()
. yielded = if reads-errors then read-case(0, given, id) else given
. start U32 = ir.operands.length
ir.add-operand(yielded)
ir.add-operand(make-operand(.operand-block, resumed))
append(.op-yield, id, Span(start, 2), closing)
if closing != no-block
    ir.start-block(closing)
    . around = landing
    run-cleanups(0, open-cleanups.length)
    landing = around
    return-absent(id)
ir.start-block(resumed)
if staying != no-block
    jump(staying)
    ir.start-block(staying)

────────────────────
_ do return-results
    - result TypeId
    - declared SyntaxId

` Makes the function one that raises errors: it returns a union whose first case is its
` value and whose others are the errors raised in its place, which the type pass made. A
` value that is itself an error is held in the first case too, as the reference holds it.
. held = ir.returns
if result == no-type
    refuse(.refused-function, declared)
    =
. layout = layout-of(result, declared)
if !tables.layouts.is-union(layout) || tables.layouts.case-field(layout, 0).layout != held
    refuse(.refused-function, declared)
    =
result-type = result
value-layout = held
ir.returns = layout

────────────────────
_ get returned LayoutId

` How the value the function returns is held, which is not what a function that raises
` errors returns.
if result-type != no-type then value-layout else ir.returns

────────────────────
_ do emit-rule
    - declared SyntaxId
    - body SyntaxId

` A rule a module declares, as the function a stream pattern calls: it is given the stream,
` as a `TokenStream` of its items, and the arguments written, then the address the stream's
` items start at, the cursor to start from and the count of items, as indexes, and the
` addresses where it keeps where it ended, how far it read and the farthest cursor a part of
` it failed at, which starts as the cursor it started from. Its arms are tried in turn from
` the cursor, as those of a local rule are, and the first that passes gives what it gave. It
` returns an optional of that, which holds nothing where no arm passed. One that raises
` returns that or an error raised in an action, and one made for a pattern that may raise,
` that or an error the pattern raised. One typed for the helper a pattern calls it
` under is given that helper after where it keeps the farthest cursor, and its pattern runs
` under it; one given its own helper as an argument runs under that. One whose pattern holds a
` rollback mark is then given where to keep the mark it holds as it passes. Its arms join as
` the type the optional it returns holds, which a rule that states its type states.
. signature = instances.signatures[unit.instance]
. matched = tree.stream-statement(body)
. pattern SyntaxId = 0
do match? tree.nodes[matched]
    | .node-stream-match(row)
        pattern = row.pattern
. returned = signature.returns
. result = if pattern != 0 && types.is-optional(returned) then returned-inner else no-type
    .. returned-inner = types.optional-inner(returned)
. buffer-type = facts.node-type(unit.reading, declared)
if pattern == 0 || result == no-type || !types.is-optional(returned) || unbuffered
    refuse(.refused-function, declared)
    =
.. unbuffered = buffer-type == no-type || signature.args.count == 0
. stream-type = instances.argument-type(unit.instance, 0)
ir.add-argument(layout-of(stream-type, declared))
for position in 1 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
. index-layout = layout-of(types.index-type, declared)
. buffer-layout = layout-of(buffer-type, declared)
layout-of(class-arg(types, buffer-type, 0), declared)
returns-type = returned
ir.returns = layout-of(returned, declared)
if signature.errors.count != 0
    return-results(signature.result, declared)
if carried-result != no-type
    return-results(carried-result, declared)
if unstructured || unpaired-buffer || !is-integer(index-layout)
    refuse(.refused-type, declared)
    =
.. unstructured = !tables.layouts.is-struct(buffer-layout)
.. unpaired-buffer = tables.layouts.rows[buffer-layout].fields.count != 2
. first U32 = ir.arguments.length
ir.add-argument(pointer-layout)
ir.add-argument(index-layout)
ir.add-argument(index-layout)
ir.add-argument(pointer-layout)
ir.add-argument(pointer-layout)
ir.add-argument(pointer-layout)
. helped = instances.rows[unit.instance].helper
if helped != no-type
    add-helper-argument(helped, declared)
else
    ambient-helper()
if carries(unit.instance)
    add-mark-argument()
for name in collector-args
    ir.add-argument(pointer-layout)
open-environment(declared)
bind-arguments(declared)
rule-arguments = true
. views = facts.first-call(unit.reading, matched)
match-direct
    - declared
    - matched
    - pattern
    - result
    - returned
    - stream-type
    - buffer-type
    - first
    - views
    - next-call(views)
    - matched
    - function.kind == .mapped-rule

────────────────────
_ do emit-raising-rule

` A rule as the function calls that give it a pattern whose function may raise errors run:
` as the rule's function, but a call of the pattern it is given takes the pattern's answer or
` one of the errors, which leaves the function with the call, and the function returns its
` own answer or one of them. The rule takes one pattern, and reads it only to call it, as
` `emit-identifier` checks. A local rule of the rule that runs as a function has such a
` function too, which the rule's calls.
. row = facts.raising-rules[function.place]
. signature = instances.signatures[unit.instance]
. patterns U32
for position in 0 .. < signature.args.count
    if is-pattern-func(instances.argument-type(unit.instance, position))
        patterns += 1
if patterns != 1 || signature.errors.count != 0
    refuse-own()
    =
carried-given = row.given
carried-result = row.result
if row.rule == 0
    emit-body()
else
    emit-lazy-rule(row.rule)

────────────────────
_ do is-pattern-func Bool
    - type TypeId

` Whether a type is a `PatternFunc` of any items.
if type == no-type || type == invalid-type
    = false
do match? types.rows[type]
    | .type-class(row)
        = types.pattern-func-decl.refers-to(row.module, row.decl)
= false

────────────────────
_ do emit-mapped-rule

` A rule, or a local rule of one, as the function calls of it that give it a set of
` collectors run: as the rule's function, given after its other arguments a pointer to each
` collector, whose list the rule's name it is given for adds to while it runs. No such call
` reads what the rule gives, so its arms make no text of what they matched. A set of no
` collectors adds no arguments.
. mapping = tables.rule-mappings[function.place]
if mapping.names != no-string
    for name in tables.bundle.text(mapping.names).split(",")
        collector-args += name
if mapping.rule == 0
    emit-body()
else
    emit-lazy-rule(mapping.rule)

────────────────────
_ do emit-lazy-rule
    - rule SyntaxId

` A local rule of a rule a module declares, as a function of its own that a pattern calls as
` it calls the rule: given the rule's stream and arguments, then the address the stream's
` items start at, the cursor to start from and the count of items, and where to keep where it
` ended, how far it read and the farthest cursor a part of it failed at. It reads the rule's
` arguments as the rule does. One of a rule that raises errors raises them too. One of a rule
` given its own helper as an argument runs under it, and one of a rule typed for a helper is
` given the helper as the rule is, and runs under it. One of a rule whose pattern holds a
` rollback mark holds one too, kept as the rule's, and gives it as the rule does. One no call
` reads the value of makes no text of what its arms matched. The function of a local rule
` beside a match that calls itself is given the stream alone before the address, and reads
` nothing of the function the rule is written in, as the tables made sure. Under a helper that
` observes literal words, one tells it of them only where `observes-literals` says its pattern
` holds any.
. signature = instances.signatures[unit.instance]
. declared SyntaxId = 0
do match? program.modules[unit.source-module].decls[instances.rows[unit.instance].decl]
    | .decl-function(fn)
        declared = fn.syntax
. matched SyntaxId = 0
do match? tree.nodes[rule]
    | .node-declare(declaration)
        matched = declaration.right
. pattern SyntaxId = 0
do match? tree.nodes[matched]
    | .node-stream-match(row)
        pattern = row.pattern
. result = facts.node-type(unit.reading, matched)
. place = facts.local-rule-of(unit.instance, rule)
. returned = if place != U32.max then facts.local-rules[place].answer else no-type
if tables.rule-adapter-of(unit.instance, rule) != no-function
    . local = facts.local-rules[place]
    if pattern == 0 || untyped-result || local.buffer == no-type || carrying
        refuse(.refused-function, rule)
        =
    .. untyped-result = result == no-type || returned == no-type
    .. carrying = carried-result != no-type || carries(unit.instance)
    ir.add-argument(layout-of(local.stream, rule))
    returns-type = returned
    ir.returns = layout-of(returned, rule)
    if signature.errors.count != 0
        return-results(local.result, rule)
    if !direct-arguments(local.buffer, rule)
        =
    inlining += rule
    . viewed = facts.first-call(unit.reading, matched)
    match-direct
        - rule
        - matched
        - pattern
        - result
        - returned
        - local.stream
        - local.buffer
        - 1
        - viewed
        - next-call(next-call(viewed))
    stop-inlining(rule)
    =
. buffer-type = facts.node-type(unit.reading, declared)
if declared == 0 || pattern == 0 || result == no-type || returned == no-type || unbuffered
    refuse(.refused-function, rule)
    =
.. unbuffered = buffer-type == no-type || signature.args.count == 0
. stream-type = instances.argument-type(unit.instance, 0)
ir.add-argument(layout-of(stream-type, rule))
for position in 1 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), rule))
returns-type = returned
ir.returns = layout-of(returned, rule)
if signature.errors.count != 0
    return-results(facts.local-rules[place].result, rule)
if carried-result != no-type
    return-results(carried-result, rule)
. first U32 = ir.arguments.length
if !direct-arguments(buffer-type, rule, instances.rows[unit.instance].helper, carries(unit.instance))
    =
if instances.rows[unit.instance].helper == no-type
    ambient-helper()
open-environment(declared)
bind-arguments(declared)
rule-arguments = true
. ruled = rule-match(program, instances.rows[unit.instance].module, instances.rows[unit.instance].decl)
. views = facts.first-call(unit.reading, ruled)
match-direct
    - rule
    - matched
    - pattern
    - result
    - returned
    - stream-type
    - buffer-type
    - first
    - views
    - next-call(views)
    - ruled
    - function.kind == .mapped-rule || !tables.reads-rule(unit.instance, rule)
    - observes-literals(tree, facts, unit.reading, pattern)

────────────────────
_ do add-helper-argument
    - helper TypeId
    - site SyntaxId

` Adds the argument a function a stream pattern calls is given the helper of the pattern
` calling it in, after where it keeps the farthest cursor, and runs its pattern under it.
streaming = streaming.pattern-helper = make-operand(.operand-argument, ir.arguments.length)
streaming = streaming.pattern-helper-type = helper
streaming = streaming.helper-argument = true
ir.add-argument(layout-of(helper, site))

────────────────────
_ do add-mark-argument

` Adds the argument a rule's function is given where to keep the rollback mark its pattern holds
` as it passes, after the helper.
streaming = streaming.marked-argument = make-operand(.operand-argument, ir.arguments.length)
streaming = streaming.marks-argument = true
ir.add-argument(pointer-layout)

────────────────────
_ do ambient-helper

` Keeps the argument of a rule's function that is the helper of the rule's pattern, where the
` rule is given one as `ambient-position` finds it.
. position = ambient-position(types, instances, unit.instance)
if position != U32.max
    streaming = streaming.pattern-helper = make-operand(.operand-argument, position)
    streaming = streaming.pattern-helper-type = instances.argument-type(unit.instance, position)

────────────────────
_ do match-direct
    - declared SyntaxId
    - matched SyntaxId
    - pattern SyntaxId
    - result TypeId
    - returned TypeId
    - stream-type TypeId
    - buffer-type TypeId
    - first U32
    - views FactId = no-fact
    - extends FactId = no-fact
    - marks SyntaxId = 0
    - unread Bool = false
    - observes Bool = true

` The body of a function a stream pattern calls, from the arguments at `first` on: the
` address the stream's items start at, the cursor to start from, the count of items, and
` where to keep where it ended, how far it read and the farthest cursor a part failed at.
` Its arms are tried in turn from the cursor, and the first that passes gives what it gave,
` an optional of which it returns; one that holds nothing where no arm passed. Where the
` stream may give more input, a part that reads past the end of the buffer asks it for more
` through the calls `views` and `extends`, and reads the address and count of its items
` again. The body the type pass found holds a rollback mark at `marks` gives the mark it holds
` where it passed, and gives it back where it failed. Where `unread`, no call reads what it
` gives, and its arms give the text they matched as `emit-bare-arm` says. Under a helper that
` observes literal words, the body tells it of them only where it `observes` them.
. index-layout = layout-of(types.index-type, declared)
. buffer-layout = layout-of(buffer-type, declared)
. item-layout = layout-of(class-arg(types, buffer-type, 0), declared)
. layout = layout-of(result, declared)
. answer-layout = layout-of(returned, declared)
. nothing = make-operand(.operand-void, 0)
. start = make-operand(.operand-argument, first + 1)
. extent = ir.add-local(index-layout)
store-local(extent, start, matched)
. error = ir.add-local(index-layout)
store-local(error, start, matched)
. data = make-operand(.operand-argument, first)
. length = make-operand(.operand-argument, first + 2)
. stream = make-operand(.operand-argument, 0)
. run = direct-run
    - matched
    - stream
    - stream-type
    - buffer-type
    - data
    - start
    - length
    - extent
    - error
    - index-layout
    - item-layout
    - buffer-layout
    - views
    - extends
. end = ir.add-local(index-layout)
. joined = ir.reserve-block()
. failed = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. held = bound.length
. captured = stream-captures.length
lent-first = (first + (if streaming.helper-argument then 7 else 6) + (if streaming.marks-argument then 1 else 0)) as U32
streaming = streaming.storage-row = if marks != 0 then facts.storage-body-of(unit.reading, marks) else U32.max
streaming = streaming.observer-row = if marks != 0 && observes then facts.observer-body-of(unit.reading, marks) else U32.max
hold-captures(run, pattern)
lent-first = U32.max
if lent.length != collector-args.length
    refuse(.refused-function, declared)
if marks != 0
    open-marks(marks)
if streaming.marks-argument && streaming.rollback-mark == no-local
    refuse(.refused-function, declared)
plan-choices(pattern)
. arrives = emit-stream-arms(run, pattern, result, start, false, end, joined, slot, failed, unread)
drop-bound(held)
drop-captures(captured)
if !arrives
    drop-joins(mark)
    refuse(.refused-function, declared)
    =
. given = close-joins(joined, mark, layout, slot)
. ended = make-operand(.operand-argument, first + 3)
. reached = make-operand(.operand-argument, first + 4)
. erred = make-operand(.operand-argument, first + 5)
store(ended, 0, load-local(end, matched), false, matched)
store(reached, 0, load-local(extent, matched), false, matched)
store(erred, 0, load-local(error, matched), false, matched)
if streaming.marks-argument
    give-mark(matched)
return-lent(false, matched)
. wrapped = wrap(matched, Typed(given, result), returned)
return-value(wrapped.operand, matched)
ir.start-block(failed)
rewind-mark(matched)
store(reached, 0, load-local(extent, matched), false, matched)
store(erred, 0, load-local(error, matched), false, matched)
return-lent(true, matched)
return-value(empty-optional(returned, answer-layout).operand, matched)

────────────────────
_ do direct-run StreamRun
    - matched SyntaxId
    - stream Operand
    - stream-type TypeId
    - buffer-type TypeId
    - data Operand
    - start Operand
    - length Operand
    - extent LocalId
    - error LocalId
    - index-layout LayoutId
    - item-layout LayoutId
    - buffer-layout LayoutId
    - views FactId
    - extends FactId

` What the pattern of a function a stream pattern calls runs over: the address the stream's
` items start at and their count as it is given them, kept in locals of their own where the
` stream may give more input and the type pass recorded the calls that ask it for more.
. nothing = make-operand(.operand-void, 0)
if views == no-fact || extends == no-fact || !may-grow(stream-type)
    = StreamRun
        - matched
        - stream
        - stream-type
        - nothing
        - buffer-type
        - data
        - start
        - length
        - extent
        - error
        - index-layout
        - item-layout
        - buffer-layout
. kept-data = ir.add-local(pointer-layout)
store-local(kept-data, data, matched)
. kept-length = ir.add-local(index-layout)
store-local(kept-length, length, matched)
= StreamRun
    - matched
    - stream
    - stream-type
    - nothing
    - buffer-type
    - data
    - start
    - length
    - extent
    - error
    - index-layout
    - item-layout
    - buffer-layout
    - views
    - extends
    - no-local
    - kept-data
    - kept-length

────────────────────
_ do return-lent
    - failed Bool
    - site SyntaxId

` Gives each collector a caller lent back what its list holds, cut back first to what it held
` as the function began where the rule failed, as the reference rewinds a borrowed collector.
for held in lent
    if failed
        rewind-level(held.level, held.mark, site)
    . pointer = make-operand(.operand-argument, held.argument)
    . layout = layout-of(held.level.collector, site)
    put(pointer, tables.layouts.field(layout, 0), load-local(held.level.items, site), site)
    put(pointer, tables.layouts.field(layout, 1), load-local(held.level.size, site), site)

────────────────────
_ do bind-arguments
    - declared SyntaxId

` Gives each argument of a body written in source its cell, and stores there the value it
` arrives with. A struct is the address of memory the function owns, and is read as that: it
` has no cell, and has no shape here where some read tracks it. An argument that nested
` functions capture is copied into the function's environment, and so is the item or the
` value a pipe gives the function generated for its right side. The arguments of a nested
` function written in the body are not this function's.
. binding = instances.rows[unit.instance].binding
if binding == no-binding
    =
if piped != 0
    keep-piped(declared)
. first U32 = if unit.takes-self then 1 else 0
. position U32
for offset in 0 .. < unit.slot-count
    . slot = bindings.slots[unit.slot-start + offset]
    if slot.kind != .slot-argument || !owns(unit.slot-start + offset)
        continue
    . index = first + position
    position += 1
    if index >= ir.arguments.length
        refuse(.refused-function, declared)
        =
    . watched = (slot.flags /and/ SlotFlag.slot-tracked) != 0
    if watched && tables.layouts.is-struct(ir.arguments[index])
        refuse(.refused-function, declared)
        =
    if is-captured(unit.slot-start + offset)
        . given = instances.argument-type(unit.instance, position - 1)
        keep-captured(unit.slot-start + offset, make-operand(.operand-argument, index), given, declared)
        continue
    . layout = ir.arguments[index] as LayoutId
    if layout == void-layout || tables.layouts.is-struct(layout)
        continue
    . local = ir.add-local(layout, (slot.flags /and/ SlotFlag.slot-address-taken) != 0)
    unit.cells[offset] = local
    store-local(local, make-operand(.operand-argument, index), 0)

────────────────────
_ do keep-piped
    - declared SyntaxId

` Copies the item, or the value, a pipe gives the function generated for its right side into
` the function's environment, where nested functions capture its `each` or its `it`.
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    . row = bindings.slots[slot]
    if (row.kind != .slot-each && row.kind != .slot-it) || row.syntax != piped || uncaptured
        continue
    .. uncaptured = !owns(slot) || !is-captured(slot)
    if ir.arguments.length != 2
        refuse(.refused-function, declared)
        =
    keep-captured
        - slot
        - make-operand(.operand-argument, 1)
        - instances.argument-type(unit.instance, 0)
        - declared

────────────────────
_ do emit-value
    - body SyntaxId
    - site SyntaxId = 0
    - closes Bool = false
    - binds Bool = false

` The body of a function that is an expression: the named markup elements the type pass made where
` it starts are made first, then its statements run in order, and the value of the last is what the
` function returns, converted to the type it returns, at the `site` the type pass converted it at
` where there is one, before the cleanups open run. A lazy local declared after it is no statement
` of these. A last statement that raises under no condition gives no value: the function leaves
` there. A markup element that ends it, as what a function builds for a slot or the row of a markup
` loop, gives the receiver's property of its name the object, once made, where the type pass kept
` that. A `close` that closes what the object owns, as `closes` says, closes it once the value is
` made, as it returns. Where the function `binds` the state cells it made for what it builds, they
` are bound to the value once made (`U32.max - 1`).
raise-elements(body)
. last = body
do match? tree.nodes[body]
    | .node-block(block)
        last = 0
        for statement in tree.children[block.body]
            if !runs-in-body(statement) || is-lazy-local(statement)
                continue
            if last != 0
                emit-statement(last)
            last = statement
if last == 0
    refuse(.refused-function, body)
    =
do match? tree.nodes[last]
    | .node-assertion-syntax(row)
        if row.condition == 0
            emit-statement(last)
            =
. made = emit-expression(last)
. named = facts.named-store-of(unit.reading, last)
if named != U32.max
    store-named(last, named, made)
if binds
    bind-cells(U32.max - 1, made.operand)
. value = convert(if site != 0 then site else last, .reason-return, made)
if value.type != returns-type
    refuse(.refused-conversion, last)
    =
value = leaving(value, last, true)
if closes
    close-owned(last)
return-value(value.operand, last)

────────────────────
_ do leaving Typed
    - value Typed
    - site SyntaxId
    - closes Bool = false

` The value a function returns, once the cleanups open have run. A struct is copied first:
` a cleanup may change the place it was read from. What converts a value to the type the
` function returns runs before it comes here, so a panic raised there runs the cleanups as one
` raised anywhere in the block does. Where the body ends, the cleanups are open no longer.
if open-cleanups.length == 0
    = value
. made = value.type
. kept = value
if made != no-type && made != invalid-type
    . layout = tables.layouts.values[made]
    if layout != no-layout && tables.layouts.is-struct(layout)
        kept = Typed(snapshot(value.operand, layout, site), kept.type)
if closes
    close-cleanups(0)
else
    run-cleanups(0, open-cleanups.length)
    landing = pad-at(0)
= Typed(kept.operand, made)

────────────────────
_ do emit-end
    - declared SyntaxId

` Where the body of an imperative function ends. One that returns nothing, a `Bool` or an
` optional returns there. Any other never gets there, which the type pass checked, and the
` return emitted for it only closes the block.
if returned == void-layout || returns-type == types.bool-type || types.is-optional(returns-type)
    return-absent(declared)
    =
return-zero(.return-normal)

────────────────────
_ do emit-return
    - id SyntaxId
    - expr SyntaxId

` Leaves the function with a value, or with nothing. What follows is never run. `=? value`
` leaves only where the optional written holds a value, with what it holds, and what follows
` runs where it holds nothing.
. staying = ir.reserve-block()
return-from(id, expr, if is-chained(expr) then staying else no-block, true)
ir.start-block(staying)

────────────────────
_ do is-chained Bool
    - expr SyntaxId

` Whether an expression is written after the `?` of a statement that runs only where an
` optional holds a value.
if expr == 0
    = false
do match? tree.nodes[expr]
    | .node-optional-chain
        = true
= false

────────────────────
_ do emit-return-if
    - id SyntaxId
    - condition SyntaxId
    - expr SyntaxId

` Leaves the function where a condition tests as true, with the value written or with what
` the function has for none.
if condition == 0
    refuse(.refused-statement, id)
    =
. tested = test(condition, emit-expression(condition))
. leaving = ir.reserve-block()
. staying = ir.reserve-block()
branch(tested.operand, leaving, staying)
ir.start-block(leaving)
return-from(id, expr)
ir.start-block(staying)

────────────────────
_ do return-from
    - id SyntaxId
    - expr SyntaxId
    - absent IRBlockId = no-block
    - defaulted Bool = false

` Returns a value converted to the type the function returns, as the type pass recorded where
` the value is written, or at the return itself for a type it inferred from the returns. A
` return of `null` gives the optional the function returns, holding nothing. With `absent`
` the return is one that happens only where its value is there: an optional that holds
` nothing goes on at `absent`, and one that holds a value returns what it holds. The
` cleanups open run after the value is made and converted, so a panic its conversion raises
` runs them as one raised anywhere in the block does. A value that may be an error returns
` the error in its place where it holds one. A return written in a cleanup has no shape. A function
` that yields has finished where it returns: the value written is evaluated and given to
` no one. `defaulted` is a return written with no value and no condition. A panic the
` conversion of a returned match raises is raised at the stream pattern the match runs. A
` `close` that closes what the object owns closes it as it returns, after the cleanups and
` after the value it returns is made, as the reference closes it before each return. In the
` body of a rule of a class, one with no value leaves only the body, after the cleanups opened
` in it, as it leaves the callback of the reference's live action. In the body of a spawned
` task, one with no value ends the task after the cleanups.
if unit.running-rule && scoping.rule-leaving != no-block && expr == 0 && !scoping.cleaning && !closes-actions()
    run-cleanups(scoping.rule-cleanups, open-cleanups.length)
    jump(scoping.rule-leaving)
    =
if scoping.cleaning || unit.running-rule
    refuse(.refused-statement, id)
    =
if expr == 0
    run-cleanups(0, open-cleanups.length)
    if closes-actions()
        close-owned(id)
    if task-leaving != no-block
        jump(task-leaving)
        =
    return-absent(id, defaulted)
    =
if initializes || (builds && (function.kind != .instance-body || tables.fills-apart(unit.instance)))
    refuse(.refused-statement, id)
    =
if stepping || fusing
    if absent != no-block
        refuse(.refused-statement, id)
        =
    emit-expression(expr)
    run-cleanups(0, open-cleanups.length)
    return-absent(id)
    =
held-chain = expr
. value = emit-expression(expr)
held-chain = 0
if absent != no-block && types.is-optional(value.type)
    . held = value.type
    . tested = present(expr, value)
    . given-block = ir.reserve-block()
    branch(tested.operand, given-block, absent)
    ir.start-block(given-block)
    value = payload(expr, Typed(value.operand, held))
. fused = carries-error(value.type) && facts.plan-of(unit.reading, id) == .plan-fused
if fused
    value = forward(id, value)
. missed SyntaxId = 0
do match? tree.nodes[expr]
    | .node-match-expression(row)
        missed = tree.stream-statement(row.body)
value = convert(expr, .reason-return, value, missed)
value = convert(id, .reason-return, value)
if value.type == types.null-type && types.is-optional(returns-type)
    value = empty-optional(returns-type, returned)
if value.type != returns-type
    refuse(.refused-conversion, expr)
    =
. around = landing
value = leaving(value, id)
landing = around
if closes-actions()
    close-owned(id)
return-value(value.operand, id)

────────────────────
_ do forward Typed
    - id SyntaxId
    - result Typed

` What a returned value that may be an error gives where it holds none, with the cleanups
` open still to run. An error it holds is returned in its place once they have run, as the
` case of what the function returns that is the error's class or the nearest above it, and
` the error is as it was raised.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(result.type, id)
if !tables.layouts.is-union(layout) || result-type == no-type || unit.lender != no-instance
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
. count = tables.layouts.rows[layout].cases.count
. given = ir.reserve-block()
. raised = ir.reserve-block()
branch(case-test(id, result.operand, 0), given, raised)
ir.start-block(raised)
. around = landing
. kept = leaving(result, id)
for index in 1 .. < count
    . field = tables.layouts.case-field(layout, index)
    . own = error-case(field.type)
    if own == U32.max
        refuse(.refused-statement, id)
        = Typed(nothing, no-type)
    . next = no-block
    if index + 1 != count
        . held = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(id, kept.operand, index), held, next)
        ir.start-block(held)
    return-case(own, take(kept.operand, field, id), id)
    if next != no-block
        ir.start-block(next)
landing = around
ir.start-block(given)
. field = tables.layouts.case-field(layout, 0)
= Typed(take(result.operand, field, id), field.type)

────────────────────
_ do return-absent
    - site SyntaxId
    - defaulted Bool = false

` The return of a function where it gives no value: nothing, or false for a `Bool`, or an
` optional that holds nothing, or the object a constructor has made. A return written with
` no value and no condition gives the zero of a number or a C pointer, the empty text, or a
` tuple or struct with no bits set but its texts, as TypeScript gives a type's default; an
` object is made by a constructor there, which has no shape here.
if builds
    return-value(unit.self, site)
    =
if returned == void-layout
    return-value(make-operand(.operand-void, 0), site)
    =
if types.is-optional(returns-type) && structured-null
    return-value(empty-optional(returns-type, returned).operand, site)
    =
.. structured-null = tables.layouts.is-struct(returned) || is-null-form(returns-type)
if returns-type == types.bool-type
    return-value(integer(.machine-u8, 0), site)
    =
if !defaulted
    refuse(.refused-statement, site)
    =
. kind = intrinsic(returns-type)
if kind == .tuple || kind == .struct
    if tables.layouts.is-struct(returned)
        return-value(null-value(returns-type, returned, site).operand, site)
        =
if kind == .cpointer && is-pointer(returned)
    return-value(integer(returned as MachineKind, 0), site)
    =
if is-numeric-type(returns-type)
    if is-float(returned)
        return-value(float-number(returned, 0.0), site)
        =
    return-value(integer(tables.layouts.kind-of(returned), 0), site)
    =
if returns-type == types.string-type
    return-value(make-operand(.operand-constant, ir.add-string("")), site)
    =
refuse(.refused-statement, site)

────────────────────
_ do emit-termination-check

` The check a polling call makes: the first time it finds the task being terminated, the
` termination panic becomes the active one, and the answer is true. It raises it once, so the
` task's cleanups run and can read it.
returns-type = types.bool-type
ir.returns = u8-layout
. report = instances.report
. raise = ir.reserve-block()
. quiet = ir.reserve-block()
. joined = ir.reserve-block()
. terminating = call-runtime(.runtime-take-task-termination, 0, pending.length, u8-layout)
branch(terminating, raise, quiet)
ir.start-block(quiet)
jump(joined)
ir.start-block(raise)
. error = call-instance(report.termination-error, 0, pending.length)
. mark = pending.length
pending += error.operand
call-runtime(.runtime-panic-set, 0, mark)
. raised = ir.current
jump(joined)
ir.start-block(joined)
return-value(phi(u8-layout, integer(.machine-u8, 1), raised, integer(.machine-u8, 0), quiet), 0)

────────────────────
_ do emit-default-constructor
    - declared SyntaxId

` Allocates an object of the class and gives each stored property the value its class writes
` for it, or the zero of its type. A type whose values hold nothing has nothing to make, a
` number or a C pointer is made as its zero, and an optional as one that holds nothing. One
` whose values raise errors returns what it made as the value of what a function that raises
` returns.
. type = instances.rows[unit.instance].self-type
for position in 0 .. < instances.signatures[unit.instance].args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
if tables.layouts.values[type] == void-layout
    returns-type = type
    ir.returns = void-layout
    return-nothing()
    =
if types.is-optional(type)
    returns-type = type
    ir.returns = layout-of(type, declared)
    return-value(empty-optional(type, ir.returns).operand, declared)
    =
if is-zeroed(type) || type == types.bool-type
    returns-type = type
    ir.returns = layout-of(type, declared)
    return-value(integer(tables.layouts.kind-of(ir.returns), 0), declared)
    =
. made = allocate(type, declared)
if instances.signatures[unit.instance].errors.count != 0
    return-results(instances.signatures[unit.instance].result, declared)
unit = unit.self = made
unit = unit.has-self = true
store-properties(type, declared)
run-class-rules(type, declared)
if function.kind != .constructor-body
    emit-fill(made, type, class-site(type))
    emit-deferred(type, declared)
return-value(made, declared)

────────────────────
_ do emit-filling

` A constructor whose body a function of its own holds (`fills-apart`): it calls that function
` with its arguments, then fills the object it answers with the markup of its class and gives
` the properties put off until then their values, as the constructor would, and returns it.
` The call is placed where the constructor places what it runs once its body has, the
` declaration of the class for one the compiler writes.
. row = instances.rows[unit.instance]
. type = row.self-type
. signature = instances.signatures[unit.instance]
. declared SyntaxId = 0
. placed SyntaxId = 0
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        declared = fn.syntax
        placed = if fn.is-generated then class-site(type) else fn.syntax
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
if !tables.is-class(type) || signature.returns != type || placed == 0
    refuse(.refused-function, declared)
    =
returns-type = type
ir.returns = managed-layout
. target-id = tables.body-functions[unit.instance]
. target = tables.functions[target-id]
. mark = pending.length
for position in 0 .. < signature.args.count
    pending += make-operand(.operand-argument, position)
ir.depend(.callee-function, target-id, if target.may-panic then may-panic-dependency else 0u32)
. made = call
    - make-operand(.operand-symbol, target.symbol)
    - placed
    - mark
    - .callee-function
    - managed-layout
    - target.may-panic && !in-landing
unit = unit.self = made
unit = unit.has-self = true
emit-fill(made, type, placed)
emit-deferred(type, declared)
return-value(made, declared)

────────────────────
_ do class-site SyntaxId
    - type TypeId

` Where a class is declared, which is where the reference places what the constructor it
` generates for the class calls, or none.
. ref = class-ref(types, type)
do match? program.modules[ref.module].decls[ref.decl]
    | .decl-class(class)
        = class.syntax
= 0

────────────────────
_ do emit-constructor
    - declared SyntaxId
    - body SyntaxId

` A constructor written in source.
` 1. Its environment is made, where nested functions capture what it declares, and the
`    arguments go into their cells.
` 2. The object of a class is allocated, and is the receiver from here on, shared with the
`    nested functions that read it. A tuple or struct is made in memory of the frame
`    instead, which is the receiver and is returned by a copy.
` 3. Each stored property takes its first value, in the order the properties are declared.
` 4. The body runs. A return with no value leaves with what was made, and one with a value
`    leaves with that, as the reference returns it, and what was made is given to no one.
` A constructor that returns a value of its own makes nothing and has no receiver: its
` arguments go into their cells and its body runs, as a function's does. One that raises
` errors returns what it made as the value of what a function that raises returns.
. type = instances.rows[unit.instance].self-type
. signature = instances.signatures[unit.instance]
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
if tables.returns-own(unit.instance)
    returns-type = signature.returns
    ir.returns = layout-of(signature.returns, declared)
    if signature.errors.count != 0
        return-results(signature.result, declared)
    open-environment(declared)
    bind-arguments(declared)
    emit-block(body)
    emit-end(declared)
    =
. is-struct = type != no-type && type != invalid-type && is-aggregate(type)
if (!tables.is-class(type) && !is-struct) || signature.returns != type
    refuse(.refused-function, declared)
    =
open-environment(declared)
bind-arguments(declared)
. made = make-operand(.operand-void, 0)
returns-type = type
if is-struct
    ir.returns = layout-of(type, declared)
    made = frame(ir.returns)
else
    made = allocate(type, declared)
if signature.errors.count != 0
    return-results(signature.result, declared)
unit = unit.self = made
unit = unit.has-self = true
builds = true
share-self(declared)
if is-struct
    fill-fields(type, declared)
else
    store-properties(type, declared)
if body != 0
    emit-block(body)
if !is-struct
    run-class-rules(type, declared)
if !is-struct && function.kind != .constructor-body
    emit-fill(made, type, declared)
    emit-deferred(type, declared)
return-value(made, declared)

────────────────────
_ do fill-fields
    - type TypeId
    - declared SyntaxId

` Gives each field of the tuple or struct being made its first value, in the order the
` fields are declared: the argument of the field's name, converted as the type pass recorded
` where the argument is written, or else the value its type writes for it, or the zero of
` its type.
. range = types.completions[type].properties
. outer = making
making = Making(unit.self, type, returned, declared, made.length, true, making.callee, making.default-holder)
for _ in 0 .. < range.count
    made += 0
for offset in 0 .. < range.count
    make-field(offset)
while made.length > making.mark
    made.pop()
making = outer

────────────────────
_ do emit-lazy

` The function of a lazy property: it takes the object and answers the property's value, or
` for a struct the address of the value stored in the object, which a read then reads where
` it lies, as a stored struct is read. When the object has none yet, the function claims the
` property from the runtime, which holds a task that reads it from elsewhere meanwhile until
` it has its value, then evaluates the value its class writes, stores it in the object, and
` releases the property as there. A read from the task evaluating it evaluates it again. A
` value that panics leaves the object without one, and so does one that lets out an error,
` which leaves the function with it; either gives up the claim (`abandon-lazy`). A value
` whose nested functions read what it declares is evaluated as the getter's own body: the
` getter takes the value's instance as its own, makes the environment of the value's scope,
` and shares its receiver there, as a method does.
. type = function.type
. place = function.place
. property = types.properties[place]
. object = if tables.is-class(type) then tables.layouts.objects[type] else no-layout
. default = tables.default-of(type, place)
unit = unit.source-module = default.module
if object == no-layout || property.storage-kind != .storage-lazy || default.value == 0
    refuse(.refused-function, default.site)
    =
. unit-id = tables.value-unit(place)
if unit-id != no-instance && tables.environments[unit-id] != no-layout
    read-instance(unit-id)
    bind-slots()
    clear-lazies()
. pair = tables.layouts.field(object, object-header-fields + property.slot)
if !tables.layouts.is-struct(pair.layout)
    refuse(.refused-function, default.site)
    =
. held = tables.layouts.field(pair.layout, 0)
. flag = tables.layouts.field(pair.layout, 1)
. slot = LayoutField(pair.offset + held.offset, held.layout)
unit = unit.takes-self = true
unit = unit.has-self = true
unit = unit.self-type = type
unit = unit.self = make-operand(.operand-argument, 0)
ir.add-argument(managed-layout)
returns-type = property.type
ir.returns = layout-of(property.type, default.site)
if tables.layouts.is-struct(held.layout)
    ir.returns = pointer-layout
. raised = tables.lazy-function-result(place)
if raised != no-type
    return-results(raised, default.site)
. state = LayoutField(pair.offset + flag.offset, flag.layout)
. claiming = ir.reserve-block()
. evaluate = ir.reserve-block()
. ready = ir.reserve-block()
. given = load-acquire(unit.self, state.offset, state.layout, default.site)
branch(compare(default.site, .compare-equal, given, integer(.machine-u8, 1)), ready, claiming)
ir.start-block(claiming)
. mark = pending.length
pending += address(unit.self, state.offset, state.layout, default.site)
. claim = call-runtime(.runtime-claim-lazy-global, default.site, mark, i32-layout)
branch(compare(default.site, .compare-equal, claim, integer(.machine-i32, 1)), ready, evaluate)
ir.start-block(evaluate)
lazy-claim = state
if unit.instance != no-instance
    open-environment(default.site)
    share-self(default.site)
. value = first-value(property, place, type, held.layout, default.site)
if tables.layouts.is-struct(held.layout)
    store-struct(unit.self, slot, value.operand, default.site)
else if held.layout != void-layout
    store(unit.self, slot.offset, value.operand, is-managed-pointer(held.layout), default.site)
. released = pending.length
pending += address(unit.self, state.offset, state.layout, default.site)
call-runtime(.runtime-release-lazy-global, default.site, released)
jump(ready)
ir.start-block(ready)
if held.layout == void-layout
    return-nothing()
else if tables.layouts.is-struct(held.layout)
    return-value(address(unit.self, slot.offset, held.layout, default.site), default.site)
else
    return-value(load(unit.self, slot.offset, held.layout, default.site), default.site)

────────────────────
_ evaluates-value Bool

` Whether what is emitted is written for the receiver's class, which `self-type` holds, as
` the value of a property or a rule of the class: a lazy property's value, one that reads
` something tracked evaluated again, or a rule.
function.kind == .lazy-property || function.kind == .property-updater || unit.running-rule

────────────────────
_ do emit-updater

` The function that evaluates again the value of a property that reads something tracked,
` which the live action the constructor made for it runs through its adapter, given the
` object. The trackers of the action that runs it are those it notes reads in, and the value
` is stored as an assignment stores it.
. type = function.type
. place = function.place
. property = types.properties[place]
. object = if tables.is-class(type) then tables.layouts.objects[type] else no-layout
. default = tables.default-of(type, place)
. unit-id = tables.value-unit(place)
. live = instances.live
unit = unit.source-module = default.module
if object == no-layout || not-eager || default.value == 0 || unit-id == no-instance
    refuse(.refused-function, default.site)
    =
.. not-eager = property.storage-kind != .storage-eager
if tables.environments[unit-id] != no-layout || unchained
    refuse(.refused-function, default.site)
    =
.. unchained = live.previous == no-instance || live.next == no-instance
. field = tables.layouts.field(object, object-header-fields + property.slot)
unit = unit.takes-self = true
unit = unit.has-self = true
unit = unit.self-type = type
unit = unit.self = make-operand(.operand-argument, 0)
ir.add-argument(managed-layout)
returns-type = types.void-type
ir.returns = void-layout
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, default.site, pending.length).operand, default.site)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, default.site, pending.length).operand, default.site)
live-actions += LiveTrackers(previous, next)
. value = first-value(property, place, type, field.layout, default.site)
live-actions.pop()
put-property
    - unit.self
    - field
    - property
    - value.operand
    - default.site
    - U32.max
    - false
    - memo-flag-of(type, property)
return-value(make-operand(.operand-void, 0), default.site)

────────────────────
_ do open-trackers LocalId
    - site SyntaxId

` A new list of trackers for a live action a value runs in, or one that owns a subscription,
` kept in a local of its own.
. made = call-instance(instances.live.trackers, site, pending.length)
. kept = ir.add-local(managed-layout)
store-local(kept, made.operand, site)
= kept

────────────────────
_ do subscribe-values
    - site SyntaxId

` Makes the live action of each value that read something tracked as the constructor gave it,
` in the order the properties are declared, with the trackers it noted and its property's
` updater as the callback, and gives the object the action.
for position in 0 .. < filling.count
    for index in 0 .. < place-trackers.length
        if place-trackers[index].place == filling.start + position
            subscribe-value(place-trackers[index].place, place-trackers[index].trackers, filling.type, site)
place-trackers.clear()

────────────────────
_ do subscribe-value
    - place U32
    - trackers LocalId
    - owner TypeId
    - site SyntaxId

` A live action of the object being made, with the trackers a value noted and a callback that
` runs the property's updater with the object. Where the object's class keeps a flag for the
` property, the action is its memo, which a change of what the value read marks rather than
` runs, and a read settles.
. code = tables.updater-of(place)
if code == no-function
    refuse(.refused-function, site)
    =
. flag = memo-flag-of(owner, types.properties[place])
. live = instances.live
if flag == U32.max || live.memo-action == no-instance
    do own-action(load-local(trackers, site), code, unit.self, site)
    =
. callback = make-callback(tables.live-adapter-of(code), unit.self, site)
. mark = pending.length
pending += load-local(trackers, site)
pending += callback
pending += num-cast(site, unit.self, managed-layout, pointer-layout)
pending += integer(.machine-u64, flag)
pending += make-operand(.operand-constant, ir.add-string(types.properties[place].name.text))
. action = call-instance(live.memo-action, site, mark)
attach-action(unit.self, action.operand, site)

────────────────────
_ memo-flag-of U32
    - owner TypeId
    - property TypeProperty

` Where an object of a class keeps the flag of a property whose value is a memo, which says
` what the value read changed since it ran, or `U32.max` where the property has none.
|? !tables.is-class(owner) || property.storage-kind != .storage-eager
    U32.max
|? held == no-layout
    U32.max
??
    tables.layouts.memo-flag(held, object-header-fields + property.slot)

.. held = tables.layouts.objects[owner]

────────────────────
_ do settle-memo
    - site SyntaxId
    - object Operand
    - owner TypeId
    - property TypeProperty

` Before a read of a property whose value is a memo, settles it where its flag is set: its
` memo runs again first.
. flag = memo-flag-of(owner, property)
. live = instances.live
=? if flag == U32.max || live.memo-settle == no-instance
. dirty = ir.reserve-block()
. clean = ir.reserve-block()
branch
    - compare
        - site
        - .compare-not-equal
        - load(object, flag, u8-layout, site)
        - integer(.machine-u8, 0)
    - dirty
    - clean
ir.start-block(dirty)
. mark = pending.length
pending += num-cast(site, object, managed-layout, pointer-layout)
pending += integer(.machine-u64, flag)
do call-instance(live.memo-settle, site, mark)
jump(clean)
ir.start-block(clean)

────────────────────
_ do own-action Operand
    - trackers Operand
    - code FunctionId
    - data Operand
    - site SyntaxId

` Gives the object being made a live action with the trackers given and a callback that runs
` a function again with the data given, through the function's adapter, and answers it. Where
` no markup element is being built and the object's class is a markup host or batch, the action
` is made the way the type pass chose (`SelfAction`), or refused where it chose none.
. nothing = make-operand(.operand-void, 0)
. owned = facts.self-action-of(unit.reading) if content-hosts.length == 0 && unit.has-self
if !owned
    = own-callback(trackers, tables.live-adapter-of(code), data, site)
if owned.maker == no-instance
    refuse(.refused-function, site)
    = nothing
. callback = make-callback(tables.live-adapter-of(code), data, site)
. owner = convert-self
    - owned.site
    - if owned.rooted then .reason-markup-batch else .reason-markup-host
. mark = pending.length
pending += trackers
pending += callback
pending += owner.operand
. action = raising-call(owned.site, owned.maker, mark)
attach-action(unit.self, action.operand, site)
= action.operand

────────────────────
_ do own-callback Operand
    - trackers Operand
    - code FunctionId
    - data Operand
    - site SyntaxId

` Gives the object that owns what is made here a live action with the trackers given and a
` callback that calls a function with the data given, and answers it: the owner is the
` innermost markup element being built, or else the object `self` names, as the reference
` gives it.
if content-hosts.length == 0 && !unit.has-self
    refuse(.refused-function, site)
    = make-operand(.operand-void, 0)
. owner = if content-hosts.length != 0 then content-hosts[content-hosts.length - 1].operand else unit.self
. action = make-action(trackers, code, data, site)
attach-action(owner, action.operand, site)
= action.operand

────────────────────
_ do read-received Typed
    - id SyntaxId
    - name Atom

` Reads a member of a markup element being built by its name alone: the property of the
` element `received-object` finds.
. object = received-object(id, name)
= load-property(id, object.operand, object.type, name)

────────────────────
_ do received-object Typed
    - id SyntaxId
    - name Atom

` The object of the markup element whose member a name alone reads or assigns, with its class
` as the value's type: the innermost element whose class has it (`received-position`), or in a
` function written in the element's body, the element kept where it was made (`read-kept`).
. kept = received-kept(id)
if kept != no-slot
    = read-kept(kept, id)
. position = received-position(name)
if !position
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
= content-hosts[position]

────────────────────
_ do read-unmade Typed
    - id SyntaxId
    - name Atom

` The name of a markup element of a class's markup read in a closure the markup makes before
` the element is made: the receiver's property of the name, as the reference reads it, which
` panics where the closure runs before the element is made.
if !unit.has-self
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
= guard-element(id, load-property(id, unit.self, unit.owner-type, name), name)

────────────────────
_ do keep-element
    - element SyntaxId
    - made Operand
    - type TypeId

` Keeps the object of a markup element in the local no name reaches declared at the element,
` where the functions that read its members by name alone capture it: those written in its
` body, and those that test again the conditions of the style rules written on it.
. slot = channel-slot(element)
if slot != no-slot && is-captured(slot)
    keep-captured(slot, made, type, element)

────────────────────
_ received-kept SlotId
    - id SyntaxId

` The local that keeps the object of the markup element whose member a name alone reads, where
` the read is in a function written in the element's body, or none.
if binding != no-binding then bindings.resolution-of(binding, id).slot else no-slot

.. binding = instances.rows[unit.reading].binding

────────────────────
_ do read-kept Typed
    - kept SlotId
    - site SyntaxId

` The object of a markup element, kept where it was made, read in a function written in its
` body, with its type as the value's.
. found = find-captured(kept, site)
. object = read-captured(kept, site, found.type)
= Typed(object.operand, found.type)

────────────────────
_ do received-position Size?
    - name Atom

` Where the innermost markup element being built whose class has a member of a name is kept,
` apart from one whose class's markup declares that member for an element, which is hidden
` there.
. position = content-hosts.length
while position != 0
    position -= 1
    . parent = content-hosts[position].type
    . place = types.property-named(parent, name) if intrinsic(parent) == .class
    if place && !names-element(types, types.properties[place])
        = position
= null

────────────────────
_ do make-action Typed
    - trackers Operand
    - code FunctionId
    - data Operand
    - site SyntaxId

` A live action with the trackers given and a callback that calls a function with the data
` given.
. live = instances.live
if live.action == no-instance
    refuse(.refused-function, site)
    = Typed(make-operand(.operand-void, 0), no-type)
. callback = make-callback(code, data, site)
. mark = pending.length
pending += trackers
pending += callback
= call-instance(live.action, site, mark)

────────────────────
_ do make-callback Operand
    - code FunctionId
    - data Operand
    - site SyntaxId

` A callback that calls a function with the data given.
. layout = tables.layouts.function-layout
if layout == no-layout || code == no-function
    refuse(.refused-function, site)
    = make-operand(.operand-void, 0)
ir.depend(.callee-function, code, 0)
. callback = frame(layout)
store(callback, 0, make-operand(.operand-symbol, tables.functions[code].symbol), false, site)
store(callback, tables.layouts.field(layout, 1).offset, data, false, site)
= callback

────────────────────
_ do attach-action
    - owner Operand
    - action Operand
    - site SyntaxId

` Gives an object a live action to own, in the list of its actions in a side lane of the
` collector, which its `close` closes.
. live = instances.live
. actions = side-list(site, owner, 1, live.actions)
. adding = pending.length
pending += actions.operand
pending += action
do call-instance(live.add-action, site, adding)

────────────────────
_ do emit-live-statement
    - id SyntaxId
    - row LiveStatement
    - lhs SyntaxId
    - rhs SyntaxId

` An assignment whose value reads something tracked, as the reference compiles it: it is
` stored as any assignment is, while a live action of its own is open, whose trackers note what
` the value reads. Then the action is made with those trackers and a callback that runs the
` statement again through the function written for it, given the environment in force here,
` and the object named alone whose property is assigned, read again, owns the action where it
` is of a class. Where that class is a markup host or batch, the action is made as the type
` pass chose for it (`LiveStatement`), given the object as its host or its batch.
. code = if row.rerun != no-instance then tables.instance-functions[row.rerun] else no-function
if code == no-function || is-chained(rhs) || is-link(lhs)
    refuse(.refused-statement, id)
    =
. trackers = open-trackers(id)
live-actions += LiveTrackers(trackers, trackers)
emit-assign(id, .eq-op, lhs, rhs)
live-actions.pop()
. owner = make-operand(.operand-void, 0)
. held = no-type
. owned = false
do match? tree.nodes[lhs]
    | .node-get-expression(get)
        . emitted = emit-expression(get.object)
        owner = emitted.operand
        held = emitted.type
        owned = tables.is-class(emitted.type)
. adapter = tables.live-adapter-of(code)
if row.owned != no-instance
    if !owned || held != row.holder
        refuse(.refused-statement, id)
        =
    . callback = make-callback(adapter, written-environment(id), id)
    . given = convert
        - id
        - if row.rooted then .reason-markup-batch else .reason-markup-host
        - Typed(owner, held)
    . mark = pending.length
    pending += load-local(trackers, id)
    pending += callback
    pending += given.operand
    . made = raising-call(id, row.owned, mark)
    attach-action(owner, made.operand, id)
    =
. action = make-action(load-local(trackers, id), adapter, written-environment(id), id)
if owned
    attach-action(owner, action.operand, id)

────────────────────
_ do emit-stream Typed
    - id SyntaxId
    - expr SyntaxId

` A stream of a value as it changes, as the reference makes it: the value is evaluated while a
` live action of its own is open, whose trackers note what it reads; the channel the type pass
` found is made, given the value by `<-write`, and kept in the local no name reaches declared at
` the stream; then the action is made with those trackers and a callback that writes the value
` again through the function written for it, given the environment in force here.
. nothing = make-operand(.operand-void, 0)
. row = tables.live-statement-of(unit.reading, id)
. code = if row && row.rerun != no-instance then tables.instance-functions[row.rerun] else no-function
. slot = channel-slot(id)
. made = stream-call(id, .call-constructor)
. write = stream-call(id, .call-method)
if code == no-function || slot == no-slot || made == no-fact || write == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. trackers = open-trackers(id)
live-actions += LiveTrackers(trackers, trackers)
. value = emit-expression(expr)
. held = value.type
live-actions.pop()
. type = facts.node-type(unit.reading, id)
. channel = emit-fact-call(id, facts.calls[made], 0, RowRange'SyntaxId(), 0, 0, type)
if channel.type != type
    refuse(.refused-conversion, id)
do call-protocol(id, write, channel.operand, type, value.operand, held, false)
keep-captured(slot, channel.operand, type, id)
do make-action(load-local(trackers, id), adapter, written-environment(id), id)
    .. adapter = tables.live-adapter-of(code)
= Typed(channel.operand, type)

────────────────────
_ do stream-call FactId ?! Refused
    - id SyntaxId
    - form CallForm

` The call of a form the type pass recorded at a stream of a value as it changes: the constructor
` of its channel, or its `<-write`.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == form
        = fact
    fact = facts.calls[fact].next
= no-fact

────────────────────
_ do write-again
    - statement SyntaxId
    - expr SyntaxId

` The value of a stream of a value as it changes, given again by its live action: evaluated with
` the trackers of the action noting what it reads, and written by `<-write` to the channel kept
` where the stream was made.
. slot = channel-slot(statement)
. write = stream-call(statement, .call-method)
if slot == no-slot || write == no-fact
    refuse(.refused-statement, statement)
    =
. found = find-captured(slot, statement)
. channel = read-captured(slot, statement, found.type)
. value = emit-expression(expr)
. held = value.type
do call-protocol(statement, write, channel.operand, found.type, value.operand, held, false)

────────────────────
_ do emit-rerun
    - declared SyntaxId
    - statement SyntaxId

` The function a live action runs a live statement again with, given the environment the
` statement was written in: the statement runs again with the trackers of the action that runs
` it noting what its value reads, as the reference's closure does, an assignment as one, and so
` a line of a class's markup that declares a property (`content-property`), a declaration as
` `declare-again` says, a line of a markup element's body that gives content
` as `absorb-again` or `replace-again` says, and the value of a stream as `write-again` says. An
` attribute of an element and a line of a style rule that sets a property are stored again in the
` object kept where they were written (`store-again`).
. live = instances.live
if live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, declared)
    =
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, statement, pending.length).operand, statement)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, statement, pending.length).operand, statement)
live-actions += LiveTrackers(previous, next)
rerunning = true
. element = tree.argument-element(statement)
. streamed SyntaxId = 0
do match? tree.nodes[statement]
    | .node-iterable-expression(row)
        streamed = row.expr
if streamed != 0
    write-again(statement, streamed)
else if element != 0
    . row = tables.live-statement-of(instances.rows[unit.instance].enclosing, statement)
    if row && row.property != U32.max
        store-again(statement, element, types.properties[row.property].name, statement)
    else
        refuse(.refused-statement, statement)
else if tree.content-line(statement)
    if replaces(statement)
        replace-again(statement)
    else
        absorb-again(statement)
else if bound-attribute(statement) != 0
    store-back(statement, bound-attribute(statement))
else
    do match tree.nodes[statement]
        | .node-assign(row)
            . styled = facts.style-declaration-of(instances.rows[unit.instance].enclosing, statement)
            if styled
                author-again(statement, row.rhs, styled)
            else if tree.attribute-element(statement) != 0 || rule-update
                . name = identifier-name(tree, row.lhs)
                . setter = own-call(row.lhs)
                if setter != no-fact && facts.calls[setter].form == .call-setter
                    set-again(statement, row.lhs, row.rhs, facts.calls[setter].callee)
                else if name
                    store-again(statement, statement, name, row.rhs)
                else
                    refuse(.refused-statement, statement)
            else
                emit-assign(statement, row.op, row.lhs, row.rhs)
            .. rule-update = facts.rule-update-of(instances.rows[unit.instance].enclosing, statement)
        | .node-property-syntax(row)
            emit-assign(statement, .eq-op, tree.content-property-name(statement), row.value)
        | .node-declare(row)
            declare-again(statement, row.left, row.right)
        ??
            refuse(.refused-statement, statement)
rerunning = false
live-actions.pop()
emit-end(declared)

────────────────────
_ do reruns-in Bool
    - owner InstanceId

` Whether the function being emitted runs again a statement the instance given writes.
if instances.rows[unit.instance].enclosing != owner
    = false
do match? program.modules[instances.rows[unit.instance].module].decls[instances.rows[unit.instance].decl]
    | .decl-function(fn)
        = fn.kind == .live-decl
= false

────────────────────
_ do author-again
    - statement SyntaxId
    - rhs SyntaxId
    - row StyleDeclaration

` A style declaration made again, as the reference's `style-` function makes it: its value,
` converted as where it is written, is declared by the style runtime for the object kept where
` the element was made, at the declaration's layer and order and in no block.
. slot = channel-slot(statement)
if slot == no-slot
    refuse(.refused-statement, statement)
    =
. type = find-captured(slot, statement).type
. subject = style-subject(statement, read-captured(slot, statement, type).operand, type)
. value = convert(statement, .reason-assignment, emit-expression(rhs))
. runtime = facts.style-runtime
. index = style-number(statement, row.style)
. property = facts.style-properties[row.property]
. mark = pending.length
pending += integer(.machine-u64, index)
. info = call-instance(runtime.info-required, statement, mark)
. head [Operand]
head += subject
head += info.operand
head += integer(.machine-u64, row.property - tables.style-uses[index].first)
head += integer(.machine-u32, row.layer)
head += integer(.machine-u32, row.order)
head += integer(.machine-i64, U64.max)
author-again-value(statement, property.type, value.operand, head)

────────────────────
_ do author-again-value
    - site SyntaxId
    - type TypeId
    - value Operand
    - head [Operand]

` Declares a value made again for an object, after what comes before it: by a holder where the
` runtime holds a handle to it (`author-value`), and otherwise its bits, flagged none where an
` optional holds nothing.
. runtime = facts.style-runtime
if holds-style-handle(type)
    author-value(site, type, value, head, runtime.author-dynamic, runtime.author-object)
    =
. none = none-flag(site, type, value)
. bits = style-bits(site, type, value)
call-bits(site, head, bits, none.operand, runtime.author-dynamic)

────────────────────
_ do store-again
    - statement SyntaxId
    - kept SyntaxId
    - name Atom
    - rhs SyntaxId

` An attribute of a markup element, or an argument given by position, given again, as the
` reference's `prop-` function gives it: its value, converted as where it is written, is
` stored in the property of `name` of the element's object, kept at `kept` where the element
` was made, as an assignment to the property stores it.
. slot = channel-slot(kept)
if slot == no-slot
    refuse(.refused-statement, statement)
    =
. found = find-captured(slot, statement)
. type = found.type
. place = types.property-named(type, name)
. held = if tables.is-class(type) then tables.layouts.objects[type] else no-layout
if !place || held == no-layout
    refuse(.refused-statement, statement)
    =
. property = types.properties[place]
if property.storage-kind != .storage-eager
    refuse(.refused-statement, statement)
    =
. value = convert(statement, .reason-assignment, emit-expression(rhs))
if value.type != property.type
    refuse(.refused-conversion, statement)
    =
. object = read-captured(slot, statement, type)
put-property
    - object.operand
    - tables.layouts.field(held, object-header-fields + property.slot)
    - property
    - value.operand
    - statement
    - U32.max
    - false
    - memo-flag-of(type, property)

────────────────────
_ do bound-attribute SyntaxId
    - anchor SyntaxId

. holder = tree.holder-of(anchor)
do match? tree.nodes[holder]
    | .node-assign(row)
        if row.op == .bind-op && row.lhs == anchor && tree.attribute-element(holder) != 0
            = holder
= 0

────────────────────
_ do store-back
    - anchor SyntaxId
    - statement SyntaxId

` A binding's element given again to its place, as its property changes: the property is read
` from the element's object, kept where the element was made, in the action's trackers, and
` stored in the place as an assignment to it stores. Where the type pass recorded a conversion
` back, the value stored is given back to the element, which then shows what the place holds.
. slot = channel-slot(statement)
. name = identifier-name(tree, anchor)
if slot == no-slot || !name
    refuse(.refused-statement, statement)
    =
. type = find-captured(slot, anchor).type
. place = types.property-named(type, name)
. held = if tables.is-class(type) then tables.layouts.objects[type] else no-layout
if !place || held == no-layout || types.properties[place].storage-kind != .storage-eager
    refuse(.refused-statement, statement)
    =
. property = types.properties[place]
. object = read-captured(slot, anchor, type)
track(anchor, object.operand, name)
. read = load-property(anchor, object.operand, type, name, true)
. tracking = live-actions.pop()
. unwraps = types.is-optional(read.type) && facts.node-type(unit.reading, anchor) == types.optional-inner(read.type)
. onward = if unwraps then ir.reserve-block() else no-block
if unwraps
    . filled = ir.reserve-block()
    branch(present(anchor, read).operand, filled, onward)
    ir.start-block(filled)
. value = if unwraps then payload(anchor, read) else read
. mark = pins.length
pin(anchor, value.operand, value.type)
do match? tree.nodes[statement]
    | .node-assign(row)
        . assignment = emit-assign(anchor, .eq-op, row.rhs, anchor)
        unpin(mark)
        if !unwraps && assignment.stored.type != no-type && assignment.stored.type != property.type
            . back = convert(statement, .reason-assignment, assignment.stored)
            if back.type == property.type
                put-property
                    - object.operand
                    - tables.layouts.field(held, object-header-fields + property.slot)
                    - property
                    - back.operand
                    - statement
                    - U32.max
                    - false
                    - memo-flag-of(type, property)
if unwraps
    jump(onward)
    ir.start-block(onward)
live-actions += tracking

────────────────────
_ do set-again
    - statement SyntaxId
    - target SyntaxId
    - rhs SyntaxId
    - callee InstanceId

. slot = channel-slot(statement)
if slot == no-slot || callee == no-instance || !is-callable(callee) || other-arity
    refuse(.refused-statement, statement)
    =
.. other-arity = instances.signatures[callee].args.count != 1
. type = find-captured(slot, statement).type
. given = convert(rhs, .reason-argument, emit-expression(rhs))
if given.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, statement)
    =
. object = read-captured(slot, statement, type)
. receiver = convert(target, .reason-receiver, Typed(object.operand, type))
if receiver.type != instances.rows[callee].self-type
    refuse(.refused-conversion, statement)
    =
. mark = pending.length
pending += receiver.operand
pending += given.operand
call-method(callee, target, mark)

────────────────────
_ do keep-taken
    - id SyntaxId
    - taken Operand
    - type TypeId

` Keeps what a markup element took of a line of its body that a live action gives again, in
` the local no name reaches after the one that keeps the element, which the action replaces;
` where the element absorbs the line again, that local holds nothing.
. slot = line-keeper(id)
if slot == no-slot
    refuse(.refused-statement, id)
    =
. kept = (slot + 1) as SlotId
. found = find-captured(kept, id)
if found.type == types.void-type
    =
keep-captured(kept, taken, type, id)

────────────────────
_ do replaces Bool
    - statement SyntaxId

` Whether a line of a markup element's body that a live action gives again replaces what the
` element took, rather than being absorbed again.
. slot = line-keeper(statement)
if slot == no-slot
    = false
. found = find-captured(slot + 1, statement)
= found.type != types.void-type

────────────────────
_ do replace-again
    - statement SyntaxId

` A line of a markup element's body given again in place of what the element took before, as
` the reference's replacer gives it: the element's object and what it took, kept where the
` element was made, are read, and the line's value is made the node a markup host's
` `markup-content` makes of it, which the markup runtime's `markup-replace` puts in place of the
` one before, or is given with the one before to the element's `replace`, whose answer, where it
` gives one, is kept in place of the value. What was taken before is closed, by its `close` or
` by closing each action it owns, and what is kept now is kept in its place.
. nothing = make-operand(.operand-void, 0)
. slot = line-keeper(statement)
. link = facts.content-link-of(unit.reading, statement)
if slot == no-slot || link == U32.max
    refuse(.refused-statement, statement)
    =
. row = facts.content-links[link]
. kept-slot = (slot + 1) as SlotId
. held = find-captured(slot, statement)
. object = read-captured(slot, statement, held.type)
. earlier = find-captured(kept-slot, statement)
. previous = read-captured(kept-slot, statement, earlier.type)
content-hosts += Typed(object.operand, held.type)
. value = emit-expression(statement)
content-hosts.pop()
. kept = value
. kept-type = kept.type
if row.append != no-instance
    . given = convert(statement, .reason-argument, Typed(value.operand, kept.type))
    if given.type != row.taken
        refuse(.refused-conversion, statement)
    kept = call-protocol(statement, row.call, object.operand, row.parent, given.operand, row.taken, false)
    kept-type = kept.type
    . mark = pending.length
    pending += object.operand
    pending += previous.operand
    pending += kept.operand
    do call-instance(row.append, statement, mark)
else
    . answer = call-protocol
        - statement
        - row.call
        - object.operand
        - row.parent
        - previous.operand
        - earlier.type
        - false
        - value.operand
        - kept-type
    if answer.type != types.void-type
        kept = answer
        kept-type = kept.type
if row.close != no-fact
    do call-protocol(statement, row.close, previous.operand, earlier.type, nothing)
else
    close-actions(statement, previous.operand)
keep-captured(kept-slot, kept.operand, kept-type, statement)

────────────────────
_ do absorb-again
    - statement SyntaxId

` A line of a markup element's body that gives content, given the element again, as the
` reference's absorber gives it: the element's object, kept at the line where the element was
` made, is the element being built while the line runs as content, as the type pass typed it.
. slot = line-keeper(statement)
. link = facts.content-link-of(unit.reading, statement)
if slot == no-slot || link == U32.max
    refuse(.refused-statement, statement)
    =
. found = find-captured(slot, statement)
. object = read-captured(slot, statement, found.type)
content-hosts += Typed(object.operand, found.type)
emit-content(statement, facts.content-links[link])
content-hosts.pop()

────────────────────
_ do declare-again
    - statement SyntaxId
    - left SyntaxId
    - right SyntaxId

` A lazy declaration run again, as the reference's `var` function runs it: its value is
` evaluated and stored in the local it declares, held by the environment of the function that
` declares it, which then has its value; the store runs the actions that read the local where
` its bits change, as an assignment's does. One that holds a struct has no shape here where a
` read tracks it.
. slot = declared-slot(statement)
if slot == no-slot || !is-captured(slot)
    refuse(.refused-statement, statement)
    =
. field = find-captured(slot, statement)
. value = declared-value(left, 0, right, field.type)
. watched = watches(slot, statement)
if watched && tables.layouts.is-struct(field.layout)
    refuse(.refused-statement, statement)
. prior = if watched then read-captured(slot, statement, field.type).operand else no-prior
    .. no-prior = make-operand(.operand-void, 0)
keep-captured(slot, value.operand, field.type, statement)
settle-shared(slot, statement)
if watched
    dispatch-local(slot, prior, read-captured(slot, statement, field.type).operand, field.type, statement)

────────────────────
_ do declared-slot SlotId
    - statement SyntaxId

` The lazy local a declaration declares, of those the function's binding holds, or none.
for offset in 0 .. < unit.slot-count
    . row = bindings.slots[unit.slot-start + offset]
    if row.kind == .slot-lazy && row.group == statement
        = unit.slot-start + offset
= no-slot

────────────────────
_ do run-class-rules
    - type TypeId
    - site SyntaxId

` Runs each rule of the class of the object a constructor has made, and of the classes above
` it, base first, once the constructor's body has run, as the reference runs them: each in a
` live action of its own whose trackers note what it reads, which is then the object's. What
` the rule keeps for the object is made here, holding the object, and is the data of the
` action's callback, which runs the rule again. A rule is read through the facts of the
` instance that types it, and a local it declares has no shape here. A section the event
` runtime runs from the table of the class is not subscribed. A state machine a property holds
` starts among them (see `start-member-machine`). The queries of the markup the
` object is in that each class declares are registered once its rules have run, and then its
` style defaults are declared (see `register-queries`, `apply-style-defaults`).
. chain [TypeId]
. level TypeId? = type
while level && tables.is-class(level)
    chain += level
    level = types.base-of(level)
. next U32
for index in tables.class-rules-of(type)
    . rule = tables.class-rules[index]
    while next < chain.length && chain[chain.length - 1 - next] != rule.level
        register-queries(chain[chain.length - 1 - next])
        apply-style-defaults(chain[chain.length - 1 - next])
        next += 1
    if next == chain.length
        refuse(.refused-function, site)
        break
    if program.modules[rule.module].tree.nodes[rule.syntax] is .node-state-machine
        start-member-machine(type, rule, site)
        continue
    run-class-rule(rule, facts.lowers(type, rule.module, section-of(rule)), site)
while next < chain.length
    register-queries(chain[chain.length - 1 - next])
    apply-style-defaults(chain[chain.length - 1 - next])
    next += 1

────────────────────
_ do start-member-machine
    - type TypeId
    - rule ClassRule
    - site SyntaxId

` Starts a state machine a property of the object's class holds, as the reference starts it
` once the constructor's body has run: through the facts of the instance that types the
` property's value for the object's class. The machine keeps its value in the property. Where
` the class refines the machine of its base's property, the machine it refines starts with it
` (`start-refined`), and not by a rule of its own.
. name = decl-name(rule.module, rule.decl)
. found = property-of(type, name) if name
. unit-id = if found then tables.value-unit(found as U32) else no-instance
if unit-id == no-instance
    refuse(.refused-function, site)
    =
. started = unit-machine(unit-id)
if started && started.refined != no-instance
    if started.module == rule.module && started.syntax == rule.syntax
        start-refined(started)
    =
. own-unit = unit
. own-filling = filling
unit = unit.source-module = rule.module
unit = unit.reading = unit-id
filling = filling.root = rule.syntax
do emit-expression(rule.syntax)
unit = own-unit
filling = own-filling

────────────────────
_ do decl-name Atom?
    - module ModuleId
    - decl DeclId

` The name of a property declared in a module.
do match? program.modules[module].decls[decl]
    | .decl-property(row)
        = row.name
= null

────────────────────
_ do register-queries
    - level TypeId

` The registrations a constructor makes once the rules of a class of its object have run, as
` the type pass recorded them (`QueryRegistration`): each markup query the class declares, in
` order, given to the markup runtime with the object as its host and a callback that runs each
` function made for the query with the object; then the object as a target of each descendant
` query that looks for the class or one above it (`ProgramTables.target-ids-of`), given with the
` number of its target, in the order of those numbers.
. keys [U64]
for position in 0 .. < facts.query-registrations.length
    . held = facts.query-registrations[position]
    if held.instance == unit.instance && held.level == level
        if held.query != U32.max
            keys += position as U64
        else
            for target-id in tables.target-ids-of(level)
                keys += (target-bits /lshift/ 32) /or/ (position as U64)
                    .. target-bits = tables.target-number(target-id) as U64
. ordered-keys = sort(keys)
for key in ordered-keys
    . registration = facts.query-registrations[(key /and/ 0xffffffff) as Size]
    . site = registration.site
    . owner = convert-self(site, .reason-markup-host)
    . mark = pending.length
    pending += owner.operand
    if registration.query == U32.max
        pending += integer(.machine-u64, key /rshift/ 32)
    else
        . query = facts.markup-queries[registration.query]
        if query.target-id != 0
            pending += integer(.machine-u64, tables.target-number(query.target-id))
        pending += make-callback(tables.query-function-of(registration.query), unit.self, site)
        if query.target-id != 0
            pending += make-callback(tables.query-function-of(registration.query, true), unit.self, site)
    do raising-call(site, registration.register, mark)

────────────────────
_ do enter-query MarkupQuery

` Begins a function made for a markup query, whose data, the object, is its first argument,
` read as an object of the class that declares the query, in the module that writes it: it
` answers a `Bool`.
. query = facts.markup-queries[function.place]
unit = unit.source-module = query.module
unit = unit.has-self = true
unit = unit.self-type = query.level
unit = unit.self = make-operand(.operand-argument, 0)
returns-type = types.bool-type
ir.returns = layout-of(types.bool-type, query.site)
= query

────────────────────
_ do emit-ancestor-query

` The function made for an ancestor query of the markup an object is in, which the markup
` runtime runs with the object as its data: the object of the first markup host above the
` object's, from its parent up, that is of the class the query looks for, or nothing, compared
` with what the property holds as one object and stored where they differ, which runs what
` reads the property. It answers whether they differed.
ir.add-argument(managed-layout)
. query = enter-query()
. site = query.site
. object = if tables.is-class(query.level) then tables.layouts.objects[query.level] else no-layout
. property = types.properties[query.place]
if object == no-layout || query.parent == no-instance
    refuse(.refused-function, site)
    =
. field = tables.layouts.field(object, object-header-fields + property.slot)
. held = layout-of(property.type, site)
. cursor-type = instances.signatures[query.parent].returns
. cursor-layout = layout-of(cursor-type, site)
. owner = convert-one(site, facts.conversions[query.hosted], Typed(unit.self, query.level))
. result = ir.add-local(held)
store-local(result, empty-optional(property.type, held).operand, site)
. cursor = ir.add-local(cursor-layout)
. first = pending.length
pending += owner.operand
store-local(cursor, call-instance(query.parent, site, first).operand, site)
. test = ir.reserve-block()
. body = ir.reserve-block()
. next = ir.reserve-block()
. ended = ir.reserve-block()
jump(test)
ir.start-block(test)
. holds = present(site, Typed(load-local(cursor, site), cursor-type))
branch(holds.operand, body, ended)
ir.start-block(body)
. host = payload(site, Typed(load-local(cursor, site), cursor-type))
. target = host-object(site, host.operand, query.target, next)
store-local(result, wrap(site, target, property.type).operand, site)
jump(ended)
ir.start-block(next)
. above = payload(site, Typed(load-local(cursor, site), cursor-type))
. again = pending.length
pending += above.operand
store-local(cursor, call-instance(query.parent, site, again).operand, site)
jump(test)
ir.start-block(ended)
. changed = bits-differ(field-value(unit.self, field, site), load-local(result, site), held, site)
. storing = ir.reserve-block()
. done = ir.reserve-block()
branch(changed, storing, done)
ir.start-block(storing)
put-property(unit.self, field, property, load-local(result, site), site)
jump(done)
ir.start-block(done)
return-value(changed, site)

────────────────────
_ do host-object Typed
    - site SyntaxId
    - host Operand
    - type TypeId
    - missed IRBlockId

` The object a markup host holds, as an object of a class, as the reference reads it for a
` query of the markup: where the object, by its own table, is of the class or of one derived
` from it, and else it leaves to `missed`.
. object = load(host, 0, managed-layout, site)
. passed = ir.reserve-block()
class-branch(site, object, type, passed, missed)
ir.start-block(passed)
= Typed(object, type)

────────────────────
_ do emit-descendant-query
    - removes Bool

` A function made for a descendant query of the markup an object is in, which the markup
` runtime runs with a markup host and the object as its data: where the host's object is of
` the class the query looks for, the markup runtime adds it to the list the property holds, in
` the order of the markup, or takes it from it, and where that changed the list it is stored
` again, which runs what reads the property though the list is the same. It answers whether
` the list changed.
. written = facts.markup-queries[function.place]
. host-type = facts.conversions[written.hosted].to
. host-layout = layout-of(host-type, written.site)
ir.add-argument(managed-layout)
ir.add-argument(host-layout)
. query = enter-query()
. site = query.site
. object = if tables.is-class(query.level) then tables.layouts.objects[query.level] else no-layout
. property = types.properties[query.place]
. callee = if removes then query.remove else query.add
if object == no-layout || callee == no-instance
    refuse(.refused-function, site)
    =
. candidate = ir.add-local(host-layout)
store-local(candidate, make-operand(.operand-argument, 1), site)
. field = tables.layouts.field(object, object-header-fields + property.slot)
. owner = convert-one(site, facts.conversions[query.hosted], Typed(unit.self, query.level))
. missed = ir.reserve-block()
. target = host-object(site, load-local(candidate, site), query.target, missed)
. current = field-value(unit.self, field, site)
. mark = pending.length
pending += current
pending += owner.operand
pending += target.operand
. changed = call-instance(callee, site, mark)
. storing = ir.reserve-block()
. done = ir.reserve-block()
branch(changed.operand, storing, done)
ir.start-block(storing)
put-property(unit.self, field, property, field-value(unit.self, field, site), site, U32.max, true)
jump(done)
ir.start-block(done)
return-value(changed.operand, site)
ir.start-block(missed)
return-value(integer(.machine-u8, 0), site)

────────────────────
_ do apply-style-defaults
    - level TypeId

` The style defaults of a class of the object a constructor has made, which its rule `• This`
` declares at the defaults layer, as the reference applies them once the class's rules have
` run: at a site of their own, which is then made ready, in the module that writes the rule;
` then the rules its root `<This` applies, which share one site, made ready after the last. A
` rule that declares no style has no site, and only sets the properties it names.
. association = make-operand(.operand-void, 0)
. place = tables.first-application(unit.instance)
. began = U32.max
while place != U32.max
    . application = facts.style-applications[place]
    . next = tables.next-application(place)
    if is-default(application, level)
        . row = facts.style-site-of(unit.instance, application.module, application.site)
        . number = if row then row.number else U32.max
        if number != began
            begin-recording(application.site, application.module, number)
            began = number
        association = apply-style-rule(place, number, unit.self, level, association, U32.max)
        if !shares-default-site(next, application, level)
            . own-unit = unit
            unit = unit.source-module = application.module
            if row
                finish-style-site(application.site, unit.self, level, association, number)
            unit = own-unit
            association = make-operand(.operand-void, 0)
            began = U32.max
    place = next

────────────────────
_ do shares-default-site Bool
    - place U32
    - application StyleApplication
    - level TypeId

` Whether the next default of the class `level` this instance applies, from the place `place` of
` its applications on, is applied at the same site as `application`, and so shares its site.
while place != U32.max
    . later = facts.style-applications[place]
    if is-default(later, level)
        = later.module == application.module && later.site == application.site
    place = tables.next-application(place)
= false

────────────────────
_ is-default Bool
    - application StyleApplication
    - level TypeId

` Whether a style rule applied by this instance is one of the defaults of the class `level`.
own-base && application.outer == U32.max && application.made == level
.. own-base = application.instance == unit.instance && application.layer == 0

────────────────────
_ do run-markup-rules
    - type TypeId
    - site SyntaxId

` Runs the rules a class runs once its markup has, on the object the function that fills it
` has filled, as `run-class-rules` runs those of a constructor. A section here is run from the
` table of every class that runs it or of none.
for index in tables.markup-rules-of(type)
    . rule = tables.class-rules[index]
    run-class-rule(rule, facts.lowers-only(rule.level, rule.module, section-of(rule)), site)

────────────────────
_ do section-of SyntaxId
    - rule ClassRule

` The loop of a rule that is a section, or none.
do match? program.modules[rule.module].tree.nodes[rule.syntax]
    | .node-subscriber-syntax(section)
        = section.iterator
= 0

────────────────────
_ do run-class-rule
    - rule ClassRule
    - tabled Bool
    - site SyntaxId

do match? program.modules[rule.module].tree.nodes[rule.syntax]
    | .node-dependency-declaration(dependency)
        subscribe-dependency(rule, dependency.left, dependency.right, site)
        =
    | .node-subscriber-syntax(section)
        if !tabled
            run-section(rule, section.iterator, site)
        =
if rule.unit == no-instance || rule.kept == no-layout || rule.updater == no-function
    refuse(.refused-function, site)
    =
. kept = make-kept(rule, site)
. trigger = facts.markup-trigger-of(rule.unit)
if trigger
    run-markup-trigger(rule, trigger, kept, site)
    =
. trackers = open-trackers(site)
live-actions += LiveTrackers(trackers, trackers)
. own-unit = unit
unit = unit.source-module = rule.module
unit = unit.reading = rule.unit
unit = unit.self-type = rule.level
unit = unit.running-rule = true
run-rule-first(rule, load-local(kept, site))
unit = unit.running-rule = false
unit = own-unit
live-actions.pop()
do own-action(load-local(trackers, site), rule.updater, load-local(kept, site), site)

────────────────────
_ do make-kept LocalId
    - rule ClassRule
    - site SyntaxId

` What a rule of a class keeps for the object being made, made here, which holds the object.
. layout = tables.layouts.rows[rule.kept]
. mark = pending.length
pending += integer(.machine-u64, layout.size)
pending += make-operand(.operand-descriptor, rule.kept)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, site, mark, managed-layout), site)
store(load-local(kept, site), tables.layouts.field(rule.kept, 0).offset, unit.self, true, site)
= kept

────────────────────
_ do run-rule-first
    - rule ClassRule
    - object Operand

` Runs a rule of a class the first time, where the constructor runs it, as the instance that
` types the rule, which the function a live action runs it again with is too: the locals the
` rule declares are the constructor's for the run, and what the constructor keeps of its own
` slots is put back after it. A rule whose nested functions read what it declares makes the
` environment of its scope for the run and shares the object there, as a method does.
. run = enter-unit(rule.unit)
unit = unit.environment = no-local
unit = unit.received = false
open-environment(rule.syntax)
share-self(rule.syntax)
apply-class-rule(rule, object, true)
leave-unit(run)

────────────────────
_ do enter-unit UnitRun
    - unit-id InstanceId

` Makes the function emitted that of another instance for a while, whose locals are its own for
` the run, and answers what the function kept of its own.
. run = UnitRun(unit, in-zone, block-effects)
block-effects = 0
read-instance(unit-id)
bind-slots()
clear-lazies()
= run

────────────────────
_ do leave-unit
    - run UnitRun

` Puts back what `enter-unit` kept of the function's own.
unit = run.unit
in-zone = run.in-zone
block-effects = run.block-effects

────────────────────
_ do run-markup-trigger
    - rule ClassRule
    - trigger MarkupTrigger
    - kept LocalId
    - site SyntaxId

` Runs a `whenever` rule on the markup an object is in once the constructor's body has, as the
` reference compiles it: what the rule keeps for the object holds the object as its markup
` host, the changes it names, made here, and for an ancestor nothing found yet, and then a
` live action of the object's with no trackers, whose callback runs the rule again. The rule
` is registered with the markup runtime, given the object as its host and callbacks that note
` what it looks for, given what it keeps: for children or descendants one as an object is
` added and one as it is removed, with the number of the class looked for, and for an
` ancestor one that looks for it again. The object is converted where the type pass converted
` it for the live actions it owns.
. owned = facts.self-action-of(unit.reading)
if !owned
    refuse(.refused-function, site)
    =
. owner = convert-self(owned.site, .reason-markup-host)
. hosted = tables.layouts.field(rule.kept, 3)
if tables.layouts.is-struct(hosted.layout)
    store-struct(load-local(kept, site), hosted, owner.operand, site)
else
    store(load-local(kept, site), hosted.offset, owner.operand, is-managed-pointer(hosted.layout), site)
. next U32 = 4
if trigger.changes != no-type
    . made = call-instance(trigger.made, site, pending.length)
    store(load-local(kept, site), tables.layouts.field(rule.kept, next).offset, made.operand, true, site)
    next += 1
if trigger.target-id == 0
    . field = tables.layouts.field(rule.kept, next)
    keep-rule-value
        - load-local(kept, site)
        - field
        - empty-optional(trigger.found, field.layout).operand
        - site
. trackers = open-trackers(site)
. action = own-action(load-local(trackers, site), rule.updater, load-local(kept, site), site)
store(load-local(kept, site), tables.layouts.field(rule.kept, 2).offset, action, true, site)
. mark = pending.length
pending += owner.operand
if trigger.target-id != 0
    pending += integer(.machine-u64, tables.target-number(trigger.target-id))
pending += make-callback(rule.add, load-local(kept, site), site)
if trigger.target-id != 0
    pending += make-callback(rule.remove, load-local(kept, site), site)
do call-instance(trigger.register, site, mark)

────────────────────
_ do run-section
    - rule ClassRule
    - iterator SyntaxId
    - site SyntaxId

` Subscribes the loop a section of a class writes to its stream for the object being made,
` which owns the subscription, recorded at the loop or at its `whenever` clause. The loop is
` read through the facts of the instance that types the section. One that follows an element a
` branch of the markup makes is subscribed in a live action of its own (`first-rebinding`).
if rule.unit == no-instance
    refuse(.refused-function, site)
    =
. own-unit = unit
unit = unit.source-module = rule.module
unit = unit.reading = rule.unit
unit = unit.self-type = rule.level
unit = unit.running-rule = true
. found = false
if facts.rebinds-section(rule.level, rule.module, iterator)
    found = true
    first-rebinding(rule, iterator, site)
else
    do match? tree.nodes[iterator]
        | .node-for-block(block)
            do match? tree.nodes[block.loop]
                | .node-loop-syntax(row)
                    . retested = tree.whenever-clause(block.loop)
                    . owned = tables.owned-subscription-of(unit.reading, iterator) || retest-owned
                        .. retest-owned = tables.owned-subscription-of(unit.reading, retested)
                    if row.is-subscriber && owned
                        found = true
                        emit-subscription(iterator, block.loop, row.container)
if !found
    refuse(.refused-statement, iterator)
unit = unit.running-rule = false
unit = own-unit

────────────────────
_ do first-rebinding
    - rule ClassRule
    - iterator SyntaxId
    - site SyntaxId

` Subscribes a section that follows an element a branch of the markup makes, as the reference's
` `loopAsRebindingSubscription` does: what it keeps for the object holds the object, the stream
` is read in a live action of its own (`rebind-section`), and a live action of the object holds
` the trackers it noted, with a callback that does it again as the branch makes the element.
if rule.kept == no-layout || rule.updater == no-function
    refuse(.refused-function, site)
    =
. kept = make-kept(rule, site)
. trackers = open-trackers(site)
live-actions += LiveTrackers(trackers, trackers)
rebind-section(rule, iterator, load-local(kept, site), true)
live-actions.pop()
do own-callback(load-local(trackers, site), adapter, load-local(kept, site), site)
    .. adapter = tables.live-adapter-of(rule.updater)

────────────────────
_ do rebind-section
    - rule ClassRule
    - iterator SyntaxId
    - kept Operand
    - first Bool

` Reads the stream of a section that follows an element a branch of the markup makes, with the
` element's name read tracked, and adds to the trackers of the live action open the tracker of
` a subscription to it the object owns, of the closure the section's loop subscribes: made and
` kept the first time, and read from what the section keeps after that. A loop on an event that
` is not live subscribes nothing.
. loop SyntaxId = 0
. container SyntaxId = 0
do match? tree.nodes[iterator]
    | .node-for-block(block)
        loop = block.loop
        do match? tree.nodes[block.loop]
            | .node-loop-syntax(row)
                container = row.container
. root = container
. reached = false
while !reached
    do match tree.nodes[root]
        | .node-get-expression(get)
            root = get.object
        ??
            reached = true
. name Atom? = null
do match? tree.nodes[root]
    | .node-identifier(read)
        name = read.name
. owned = tables.owned-subscription-of(unit.reading, iterator)
. closure = subscriber-closure(iterator)
if loop == 0 || !name || !owned || closure == no-type
    refuse(.refused-statement, iterator)
    =
track(root, unit.self, name)
. used = tables.event-use-of(unit.reading, iterator)
. stream = make-operand(.operand-void, 0)
if used && used.second == no-instance
    refuse(.refused-statement, iterator)
    =
if used
    . owner = event-owner(used.reference, used.owner)
    . number = tables.event-number(used.owner, used.name)
    if number == U32.max
        =
    if used.address != 0
        refuse(.refused-statement, iterator)
        =
    stream = event-endpoint(loop, used.first, owner.operand, number).operand
else
    stream = emit-broadcastable(loop, container).operand
. field = tables.layouts.field(rule.kept, 1)
. written = make-operand(.operand-void, 0)
if first
    . lone = lone-environment(iterator, no-slot)
    written = load-local(lone, iterator)
    store(kept, field.offset, written, true, iterator)
else
    written = load(kept, field.offset, managed-layout, iterator)
. subscriber = convert(iterator, .reason-argument, Typed(written, closure))
. tracker = own-tracker(iterator, owned, stream, subscriber.operand, used != null, arrives(loop))
. given = convert(iterator, .reason-argument, tracker)
add-tracker(load-local(live-actions[live-actions.length - 1].next, iterator), given.operand, iterator)

────────────────────
_ do subscribe-dependency
    - rule ClassRule
    - left SyntaxId
    - rights RowRange'SyntaxId
    - site SyntaxId

` Subscribes the method a dependency of a class names, read as a value of the object being
` made and made a `Doer` as the type pass recorded, to each property it names, in the order
` written, as `property-dependency-subscribe` does, or for an object of a markup host the
` markup runtime's `markup-property-dependency-subscribe`, given the object as its host too:
` the live action it answers is the object's.
. live = instances.live
. subscribe = if rule.unit != no-instance then facts.change-test-of(rule.unit) else no-instance
if subscribe == no-instance || live.add-action == no-instance
    refuse(.refused-function, site)
    =
. tree = program.modules[rule.module].tree
. own-unit = unit
unit = unit.source-module = rule.module
unit = unit.reading = rule.unit
. bound = facts.node-type(unit.reading, left)
. layout = layout-of(bound, left)
. defaults = bound-count(bound)
if !binds-object(bound) || layout == void-layout
    refuse(.refused-expression, left)
if tables.layouts.rows[layout].fields.count != 1 + defaults || other-level
    refuse(.refused-conversion, left)
.. other-level = tables.layouts.field(layout, 0).type != rule.level
for right in tree.children[rights]
    . made = frame(layout)
    put(made, tables.layouts.field(layout, 0), unit.self, left)
    put-defaults(left, made, layout, defaults)
    . doer = convert(rule.syntax, .reason-argument, Typed(made, bound))
    . name = ""
    do match? tree.nodes[right]
        | .node-identifier(row)
            name = row.name.text
    . host = make-operand(.operand-void, 0)
    if facts.hosts-dependency(rule.unit)
        host = convert(rule.syntax, .reason-markup-host, Typed(unit.self, rule.level)).operand
    . mark = pending.length
    pending += unit.self
    if operand-kind(host) != .operand-void
        pending += host
    pending += make-operand(.operand-constant, ir.add-string(name))
    pending += doer.operand
    . action = call-instance(subscribe, right, mark)
    . actions = side-list(site, unit.self, 1, live.actions)
    . adding = pending.length
    pending += actions.operand
    pending += action.operand
    do call-instance(live.add-action, site, adding)
unit = own-unit

────────────────────
_ do apply-class-rule
    - rule ClassRule
    - kept Operand
    - first Bool

` Runs a rule of a class on the object its kept memory holds. A `when` rule tests its value
` and runs its body where the test holds. A `whenever` rule takes its value: the first
` time it keeps it, and after that, where it changed as `value-changed` tells, it keeps the
` new one and runs its body. One on the markup an object is in runs its body where the markup
` changed since it last ran (`apply-markup-trigger`).
. trigger = facts.markup-trigger-of(rule.unit)
if trigger
    apply-markup-trigger(rule, trigger, kept)
    =
do match? program.modules[rule.module].tree.nodes[rule.syntax]
    | .node-when-rule-syntax(when)
        . tested = test(when.expr, emit-expression(when.expr))
        . holds = ir.reserve-block()
        . done = ir.reserve-block()
        branch(tested.operand, holds, done)
        ir.start-block(holds)
        emit-rule-body(when.body, done)
        jump(done)
        ir.start-block(done)
    | .node-whenever-rule-syntax(whenever)
        . field = tables.layouts.field(rule.kept, 1)
        . latest = emit-expression(whenever.expr)
        if first
            keep-rule-value(kept, field, latest.operand, whenever.expr)
            =
        . tester = facts.change-test-of(rule.unit)
        if tester == no-instance
            refuse(.refused-statement, whenever.expr)
            =
        . prior = if tables.layouts.is-struct(field.layout) then snapshot(field-value(kept, field, whenever.expr), field.layout, whenever.expr) else load(kept, field.offset, field.layout, whenever.expr)
        . mark = pending.length
        pending += prior
        pending += latest.operand
        . changed = call-instance(tester, whenever.expr, mark)
        . fires = ir.reserve-block()
        . done = ir.reserve-block()
        branch(changed.operand, fires, done)
        ir.start-block(fires)
        keep-rule-value(kept, field, latest.operand, whenever.expr)
        emit-rule-body(whenever.body, done)
        jump(done)
        ir.start-block(done)

────────────────────
_ do emit-rule-body
    - body SyntaxId
    - done IRBlockId

` Emits the body of a `when` or `whenever` rule of a class on a value, where a return leaves
` only the body and goes on at `done`.
. own-scoping = scoping
scoping = scoping.rule-leaving = done
scoping = scoping.rule-cleanups = open-cleanups.length as U32
emit-block(body)
scoping = own-scoping

────────────────────
_ do apply-markup-trigger
    - rule ClassRule
    - trigger MarkupTrigger
    - kept Operand

` Runs a `whenever` rule on the markup an object is in where the markup changed since it last
` ran: it notes that it has run, gives the changes it names to its body as a local, runs the
` body, and empties them.
. site = rule.syntax
. dirty = tables.layouts.field(rule.kept, 1)
. changes = tables.layouts.field(rule.kept, 4)
. fires = ir.reserve-block()
. done = ir.reserve-block()
branch(load(kept, dirty.offset, dirty.layout, site), fires, done)
ir.start-block(fires)
store(kept, dirty.offset, integer(.machine-u8, 0), false, site)
do match? tree.nodes[rule.syntax]
    | .node-whenever-rule-syntax(whenever)
        if trigger.changes != no-type
            give-changes(whenever.args, load(kept, changes.offset, managed-layout, site), site)
        emit-block(whenever.body)
if trigger.changes != no-type
    . mark = pending.length
    pending += load(kept, changes.offset, managed-layout, site)
    do call-method(trigger.clear, site, mark)
jump(done)
ir.start-block(done)

────────────────────
_ do give-changes
    - args RowRange'SyntaxId
    - changes Operand
    - site SyntaxId

` Gives the local the one argument of a `whenever` rule on the markup an object is in names
` the changes the rule keeps.
. name SyntaxId = 0
for arg in tree.children[args]
    do match? tree.nodes[arg]
        | .node-argument-decl(row)
            do match? tree.nodes[row.pattern]
                | .node-identifier
                    name = row.pattern
                | .node-type-capture(capture)
                    name = capture.id
. slot = local-slot(name, site, true)
. offset = slot-offset(slot, site)
. type = facts.slot-type(unit.instance, offset)
if is-captured(slot)
    keep-captured(slot, changes, type, site)
    =
. local = ir.add-local(managed-layout)
unit.cells[offset] = local
store-local(local, changes, site)

────────────────────
_ do emit-trigger-change
    - removes Bool

` The function the markup runtime calls with a markup host as one is added below the object a
` `whenever children` or `whenever descendants` rule runs on, or removed, given what the rule
` keeps for the object, as the reference compiles it: where the host's object is of the class
` the rule looks for, and for children where the host's parent is the object's own, the
` object is added to the changes the rule names, or to those removed, and the rule notes that
` the markup changed and runs its live action. It answers true.
. rule = tables.class-rules[function.place]
. trigger = facts.markup-trigger-of(rule.unit)
. site = rule.syntax
unit = unit.source-module = rule.module
if !trigger || rule.kept == no-layout
    refuse(.refused-function, site)
    =
. host-layout = layout-of(trigger.host, site)
ir.add-argument(managed-layout)
ir.add-argument(host-layout)
returns-type = types.bool-type
ir.returns = layout-of(types.bool-type, site)
. kept = make-operand(.operand-argument, 0)
. candidate = ir.add-local(host-layout)
store-local(candidate, make-operand(.operand-argument, 1), site)
. done = ir.reserve-block()
. target = host-object(site, load-local(candidate, site), trigger.target, done)
. children = false
do match? tree.nodes[rule.syntax]
    | .node-whenever-rule-syntax(whenever)
        children = whenever.kind.text == "children"
if children
    . mark = pending.length
    pending += load-local(candidate, site)
    . found = call-instance(trigger.parent, site, mark)
    . parent-type = instances.signatures[trigger.parent].returns
    . parent = ir.add-local(layout-of(parent-type, site))
    store-local(parent, found.operand, site)
    . holds = present(site, Typed(load-local(parent, site), parent-type))
    . above = ir.reserve-block()
    branch(holds.operand, above, done)
    ir.start-block(above)
    . host = payload(site, Typed(load-local(parent, site), parent-type))
    . owned = compare
        - site
        - .compare-equal
        - load(host.operand, 0, managed-layout, site)
        - load(kept, tables.layouts.field(rule.kept, 0).offset, managed-layout, site)
    . matched = ir.reserve-block()
    branch(owned, matched, done)
    ir.start-block(matched)
note-change(rule, trigger, kept, target.operand, removes, site)
mark-trigger(rule, trigger, kept, site)
jump(done)
ir.start-block(done)
return-value(integer(.machine-u8, 1), site)

────────────────────
_ do emit-trigger-ancestor

` The function the markup runtime calls where the ancestors of the object a `whenever
` ancestor` rule runs on might have changed, given what the rule keeps for the object, as the
` reference compiles it: the object of the first markup host above the object's, from its
` parent up, that is of the class the rule looks for, or nothing, compared with the one found
` last as one object. Where they differ, the one found last is taken from the changes the rule
` names and the new one added, it is kept, and the rule notes that the markup changed and runs
` its live action. It answers whether they differed.
. rule = tables.class-rules[function.place]
. trigger = facts.markup-trigger-of(rule.unit)
. site = rule.syntax
unit = unit.source-module = rule.module
if !trigger || rule.kept == no-layout
    refuse(.refused-function, site)
    =
. found = trigger
ir.add-argument(managed-layout)
returns-type = types.bool-type
ir.returns = layout-of(types.bool-type, site)
. kept = make-operand(.operand-argument, 0)
. hosted = tables.layouts.field(rule.kept, 3)
. last = tables.layouts.field(rule.kept, if found.changes != no-type then 5 else 4)
. optional = found.found
. cursor-type = instances.signatures[found.parent].returns
. cursor-layout = layout-of(cursor-type, site)
. prior = if tables.layouts.is-struct(last.layout) then snapshot(field-value(kept, last, site), last.layout, site) else load(kept, last.offset, last.layout, site)
. result = ir.add-local(last.layout)
store-local(result, empty-optional(optional, last.layout).operand, site)
. cursor = ir.add-local(cursor-layout)
. first = pending.length
pending += field-value(kept, hosted, site)
store-local(cursor, call-instance(found.parent, site, first).operand, site)
. test = ir.reserve-block()
. body = ir.reserve-block()
. next = ir.reserve-block()
. ended = ir.reserve-block()
jump(test)
ir.start-block(test)
. holds = present(site, Typed(load-local(cursor, site), cursor-type))
branch(holds.operand, body, ended)
ir.start-block(body)
. host = payload(site, Typed(load-local(cursor, site), cursor-type))
. target = host-object(site, host.operand, found.target, next)
store-local(result, wrap(site, target, optional).operand, site)
jump(ended)
ir.start-block(next)
. above = payload(site, Typed(load-local(cursor, site), cursor-type))
. again = pending.length
pending += above.operand
store-local(cursor, call-instance(found.parent, site, again).operand, site)
jump(test)
ir.start-block(ended)
. changed = bits-differ(prior, load-local(result, site), last.layout, site)
. fires = ir.reserve-block()
. done = ir.reserve-block()
branch(changed, fires, done)
ir.start-block(fires)
if found.changes != no-type
    note-ancestor(rule, found, kept, prior, true, site)
    note-ancestor(rule, found, kept, load-local(result, site), false, site)
keep-rule-value(kept, last, load-local(result, site), site)
mark-trigger(rule, found, kept, site)
jump(done)
ir.start-block(done)
return-value(changed, site)

────────────────────
_ do note-ancestor
    - rule ClassRule
    - trigger MarkupTrigger
    - kept Operand
    - value Operand
    - removes Bool
    - site SyntaxId

` Where an ancestor a `whenever ancestor` rule found holds an object, adds it to the changes
` the rule names, or to those removed.
. optional = trigger.found
. holds = present(site, Typed(value, optional))
. noting = ir.reserve-block()
. skipped = ir.reserve-block()
branch(holds.operand, noting, skipped)
ir.start-block(noting)
. held = payload(site, Typed(value, optional))
note-change(rule, trigger, kept, held.operand, removes, site)
jump(skipped)
ir.start-block(skipped)

────────────────────
_ do note-change
    - rule ClassRule
    - trigger MarkupTrigger
    - kept Operand
    - target Operand
    - removes Bool
    - site SyntaxId

` Adds an object to the changes a `whenever` rule on the markup an object is in names, as one
` added or, with `removes`, one removed: to the list the property of that name holds.
if trigger.changes == no-type
    =
. object = if tables.is-class(trigger.changes) then object-layout else no-layout
    .. object-layout = tables.layouts.objects[trigger.changes]
. place = types.property-named
    - trigger.changes
    - program.store-atom(if removes then "removed" else "added")
if object == no-layout || !place
    refuse(.refused-function, site)
    =
. changes = load(kept, tables.layouts.field(rule.kept, 4).offset, managed-layout, site)
. field = tables.layouts.field(object, object-header-fields + types.properties[place].slot)
. mark = pending.length
pending += load(changes, field.offset, field.layout, site)
pending += target
do call-method(trigger.record, site, mark)

────────────────────
_ do mark-trigger
    - rule ClassRule
    - trigger MarkupTrigger
    - kept Operand
    - site SyntaxId

` Notes that the markup a `whenever` rule on the markup an object is in looks at changed, and
` runs the rule's live action, which runs it where it is due.
store(kept, tables.layouts.field(rule.kept, 1).offset, integer(.machine-u8, 1), false, site)
. mark = pending.length
pending += load(kept, tables.layouts.field(rule.kept, 2).offset, managed-layout, site)
do call-method(trigger.schedule, site, mark)

────────────────────
_ do keep-rule-value
    - kept Operand
    - field LayoutField
    - value Operand
    - site SyntaxId

` Keeps the value of a `whenever` rule in what it keeps for an object: a managed pointer
` through the write barrier, and a struct by a copy.
if tables.layouts.is-struct(field.layout)
    store-struct(kept, field, value, site)
else if field.layout != void-layout
    store(kept, field.offset, value, is-managed-pointer(field.layout), site)

────────────────────
_ do emit-class-rule-updater

` The function a live action runs a rule of a class again with, given what the rule keeps for
` the object it runs on: it runs as the instance that types the rule, on that object, with
` the trackers of the action that runs it noting what it reads; the errors it lets out are
` handed off. A rule whose nested functions read what it declares makes the environment of its
` scope and shares the object there, as a method does. A section that follows an element a
` branch of the markup makes subscribes again (`rebind-section`).
. rule = tables.class-rules[function.place]
. live = instances.live
unit = unit.source-module = rule.module
if rule.unit == no-instance || rule.kept == no-layout || unchained
    refuse(.refused-function, rule.syntax)
    =
.. unchained = live.previous == no-instance || live.next == no-instance
. section = section-of(rule)
read-instance(rule.unit)
bind-slots()
clear-lazies()
ir.add-argument(managed-layout)
returns-type = types.void-type
ir.returns = void-layout
. kept = make-operand(.operand-argument, 0)
unit = unit.self = load(kept, tables.layouts.field(rule.kept, 0).offset, managed-layout, rule.syntax)
unit = unit.self-type = rule.level
unit = unit.has-self = true
if section == 0
    open-environment(rule.syntax)
    share-self(rule.syntax)
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, rule.syntax, pending.length).operand, rule.syntax)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, rule.syntax, pending.length).operand, rule.syntax)
live-actions += LiveTrackers(previous, next)
unit = unit.running-rule = true
if section != 0
    rebind-section(rule, section, kept, false)
else
    apply-class-rule(rule, kept, false)
unit = unit.running-rule = false
live-actions.pop()
return-value(make-operand(.operand-void, 0), rule.syntax)

────────────────────
_ do emit-style-gate

` The function the action that gates a block of style declarations runs, given what it keeps,
` as the reference's `style-gate` function does: the conditions of its row of `style-gates`
` are evaluated again on the object, the state cells and the environments kept, with the
` trackers of the action that runs it noting what they read, and the block is enabled where
` they hold and disabled where they do not; the record of generated content kept so, for a row
` that gates content, as the reference's `style-content` function enables it, which answers as
` the callback's type does: an error enabling it raises leaves with the answer.
. gate = facts.style-gates[function.place]
. layout = tables.gate-layouts[function.place]
. live = instances.live
. place = facts.style-gate-whens[gate.first + gate.count - 1]
unit = unit.source-module = place.module
. site = place.syntax
if live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, site)
    =
ir.add-argument(managed-layout)
returns-type = types.void-type
ir.returns = void-layout
if gate.content
    return-results(live.callback-result, site)
. kept = make-operand(.operand-argument, 0)
. object = load(kept, tables.layouts.field(layout, 0).offset, managed-layout, site)
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, site, pending.length).operand, site)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, site, pending.length).operand, site)
live-actions += LiveTrackers(previous, next)
. whens [StyleWhen]
. cells [Operand]
for position in 0 .. < gate.count
    . held = facts.style-gate-whens[gate.first + position]
    whens += held
    if held.cell != U32.max || held.test != no-instance
        cells += load
            - kept
            - tables.layouts.field(layout, (cells.length as U32) + 2).offset
            - managed-layout
            - site
. enabled = gate-conditions(whens, object, gate.type, cells, false)
live-actions.pop()
. mark = pending.length
if gate.content
    pending += load(kept, tables.layouts.field(layout, 1).offset, managed-layout, site)
    pending += enabled
    do raising-call(site, facts.style-runtime.content-enabled, mark)
else
    pending += num-cast(site, object, managed-layout, pointer-layout)
    pending += load(kept, tables.layouts.field(layout, 1).offset, i64-layout, site)
    pending += enabled
    do call-instance(facts.style-runtime.block-enabled, site, mark)
return-value(make-operand(.operand-void, 0), site)

────────────────────
_ do emit-scope-cell

` The function the action that keeps a state cell runs, given what it keeps, as the reference's
` `style-scope-state` function does: whether the state of its `when` holds on the object is
` evaluated again, with the trackers of the action that runs it noting what it reads, and the
` cell is given it (`set-cell`).
. held = facts.scope-cells[function.place]
. layout = tables.cell-layouts[function.place]
. live = instances.live
unit = unit.source-module = held.module
. site = held.when
if live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, site)
    =
ir.add-argument(managed-layout)
returns-type = types.void-type
ir.returns = void-layout
. kept = make-operand(.operand-argument, 0)
. subject = load(kept, tables.layouts.field(layout, 0).offset, managed-layout, site)
. cell = load(kept, tables.layouts.field(layout, 1).offset, managed-layout, site)
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, site, pending.length).operand, site)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, site, pending.length).operand, site)
live-actions += LiveTrackers(previous, next)
set-cell(held, subject, held.owner, cell)
live-actions.pop()
return-value(make-operand(.operand-void, 0), site)

────────────────────
_ do emit-slot-forward

` The function a line that forwards a slot gives in place of the builder it forwards where it
` holds state cells (`SlotForward`), as the reference's `markup-slot-forward` function runs: given
` what it keeps, the builder and the cells, and the item where the slot repeats, it holds the cells
` (`OutletCell`) while the builder runs, and answers what the builder answers.
. row = facts.slot-forwards[function.place]
. layout = tables.slot-forward-layouts[function.place]
. runtime = facts.style-runtime
unit = unit.source-module = instances.rows[row.instance].module
. site = row.line
. fn = function-row(types, row.builder)
. returns = no-type
if fn != no-type
    do match? types.rows[fn]
        | .type-function(shape)
            returns = value-returned(shape.return-type)
. carried = if fn != no-type && carries(fn) then facts.carried-result(fn) else no-type
if returns == no-type || (fn != no-type && carries(fn) && carried == no-type)
    refuse(.refused-function, site)
    =
. answers = if carried == no-type then returns else carried
ir.add-argument(managed-layout)
if row.item != no-type
    ir.add-argument(layout-of(row.item, site))
returns-type = answers
ir.returns = layout-of(answers, site)
. kept = make-operand(.operand-argument, 0)
. mark = ir.add-local(layout-of(instances.signatures[runtime.outlet-mark].returns, site))
store-local(mark, call-instance(runtime.outlet-mark, site, pending.length).operand, site)
. index U32
for held in facts.outlet-cells
    if held.instance != row.instance || held.outlet != row.line
        continue
    . first = pending.length
    pending += integer(.machine-u32, tables.state-key-number(facts.scope-cells[held.cell].key))
    pending += load(kept, tables.layouts.field(layout, 2 + index).offset, managed-layout, site)
    do call-instance(runtime.outlet-push, site, first)
    index += 1
. code = load(kept, tables.layouts.field(layout, 0).offset, pointer-layout, site)
. data = load(kept, tables.layouts.field(layout, 1).offset, managed-layout, site)
. first = pending.length
pending += data
if row.item != no-type
    pending += make-operand(.operand-argument, 1)
. result = call(code, site, first, .callee-value, layout-of(answers, site), true)
. held = ir.add-local(layout-of(answers, site))
store-local(held, result, site)
. last = pending.length
pending += load-local(mark, site)
do call-instance(runtime.outlet-release, site, last)
if carried != no-type
    return-held(load-local(held, site))
else
    return-value(load-local(held, site), site)

────────────────────
_ do forward-builder Typed
    - line SyntaxId
    - forwarded Typed

` The builder a line that forwards a slot gives where it holds state cells (`SlotForward`): the
` function of `slot-forward-functions` for it, with what it keeps, the builder `forwarded` it
` forwards and each cell, as made or given here. The builder forwarded where it holds none.
. index = U32.max
for position in 0 .. < facts.slot-forwards.length
    if facts.slot-forwards[position].instance == unit.reading && same-line
        index = position as U32
    .. same-line = facts.slot-forwards[position].line == line
if index == U32.max
    = forwarded
. builder = forwarded.type
. function-layout = layout-of(builder, line)
. layout = tables.slot-forward-layouts[index]
if function-layout != tables.layouts.function-layout
    refuse(.refused-expression, line)
    = forwarded
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, line, mark, managed-layout), line)
store
    - load-local(kept, line)
    - tables.layouts.field(layout, 0).offset
    - load(forwarded.operand, 0, pointer-layout, line)
    - false
    - line
store
    - load-local(kept, line)
    - tables.layouts.field(layout, 1).offset
    - load(forwarded.operand, tables.layouts.field(function-layout, 1).offset, managed-layout, line)
    - true
    - line
. place U32
for held in facts.outlet-cells
    if held.instance != unit.reading || held.outlet != line
        continue
    . local = cell-local(held.cell)
    if local == no-local
        refuse(.refused-expression, line)
        = forwarded
    store
        - load-local(kept, line)
        - tables.layouts.field(layout, 2 + place).offset
        - load-local(local, line)
        - true
        - line
    place += 1
. code = tables.slot-forward-functions[index]
ir.depend(.callee-function, code, 0)
. made = frame(function-layout)
store(made, 0, make-operand(.operand-symbol, tables.functions[code].symbol), false, line)
store(made, tables.layouts.field(function-layout, 1).offset, load-local(kept, line), false, line)
= Typed(made, builder)

────────────────────
_ do emit-style-author

` The function the action of a declaration of a style rule whose value read something tracked
` runs, given what it keeps, as the reference's `style-` function does: the value is evaluated
` again on the object, read through the instance that types the rule, with the trackers of the
` action that runs it noting what it reads, and declared by the style runtime for the object at
` the layer, the order and in the block kept, as `author-again-value` says.
. author = facts.style-authors[function.place]
. layout = tables.author-layouts[function.place]
. row = facts.style-declaration-of(author.instance, author.site)
. live = instances.live
. site = author.site
unit = unit.source-module = instances.rows[author.instance].module
if !row || live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, site)
    =
ir.add-argument(managed-layout)
returns-type = types.void-type
ir.returns = void-layout
. kept = make-operand(.operand-argument, 0)
unit = unit.reading = author.instance
unit = unit.self-type = instances.rows[author.instance].self-type
unit = unit.self = load(kept, tables.layouts.field(layout, 0).offset, managed-layout, site)
unit = unit.has-self = true
unit = unit.running-rule = true
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, site, pending.length).operand, site)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, site, pending.length).operand, site)
live-actions += LiveTrackers(previous, next)
. value = make-operand(.operand-void, 0)
do match? tree.nodes[site]
    | .node-assign(line)
        value = convert(site, .reason-assignment, emit-expression(line.rhs)).operand
live-actions.pop()
. runtime = facts.style-runtime
. index = style-number(site, row.style)
. property = facts.style-properties[row.property]
. mark = pending.length
pending += integer(.machine-u64, index)
. info = call-instance(runtime.info-required, site, mark)
. head [Operand]
head += num-cast(site, unit.self, managed-layout, pointer-layout)
head += info.operand
head += integer(.machine-u64, row.property - tables.style-uses[index].first)
head += load(kept, tables.layouts.field(layout, 2).offset, u32-layout, site)
head += load(kept, tables.layouts.field(layout, 3).offset, u32-layout, site)
head += load(kept, tables.layouts.field(layout, 1).offset, i64-layout, site)
author-again-value(site, property.type, value, head)
return-value(make-operand(.operand-void, 0), site)

────────────────────
_ do emit-given-author

` The function the action of a line of a style rule whose value reads values an application with
` `live-values` gives runs, given what it keeps, as `emit-style-author` runs one whose own value
` reads something tracked: the values are evaluated again where they are written
` (`bind-live-values`) and the line's value on the object, read through the instance that types
` the rule, with the trackers of the action that runs it noting what they read. A declaration's
` value is declared by the style runtime for the object at the layer, the order and in the block
` kept, as `author-again-value` says, and one that sets a property is stored in it.
. index = tables.given-applications[function.place]
. layout = tables.given-layouts[function.place]
. site = tables.given-sites[function.place]
. unit-id = facts.style-applications[index].unit
. row = facts.style-declaration-of(unit-id, site)
. update = facts.rule-update-of(unit-id, site)
. live = instances.live
unit = unit.source-module = instances.rows[unit-id].module
if (!row && !update) || live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, site)
    =
ir.add-argument(managed-layout)
returns-type = types.void-type
ir.returns = void-layout
. kept = make-operand(.operand-argument, 0)
unit = unit.reading = unit-id
unit = unit.self-type = instances.rows[unit-id].self-type
unit = unit.self = load(kept, tables.layouts.field(layout, 0).offset, managed-layout, site)
unit = unit.has-self = true
unit = unit.running-rule = true
. receiver = load(kept, tables.layouts.field(layout, 4).offset, managed-layout, site)
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, site, pending.length).operand, site)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, site, pending.length).operand, site)
live-actions += LiveTrackers(previous, next)
bind-given-row-items(function.place, kept, site)
bind-live-values(index, unit.self, receiver, no-type)
. value = Typed(make-operand(.operand-void, 0), no-type)
do match? tree.nodes[site]
    | .node-assign(line)
        value = convert(site, .reason-assignment, emit-expression(line.rhs))
live-actions.pop()
if !row
    store-argument(unit.self, unit.self-type, update!.property, value.operand, value.type, site)
    return-value(make-operand(.operand-void, 0), site)
    =
. runtime = facts.style-runtime
. number = style-number(site, row.style)
. property = facts.style-properties[row.property]
. mark = pending.length
pending += integer(.machine-u64, number)
. info = call-instance(runtime.info-required, site, mark)
. head [Operand]
head += num-cast(site, unit.self, managed-layout, pointer-layout)
head += info.operand
head += integer(.machine-u64, row.property - tables.style-uses[number].first)
head += load(kept, tables.layouts.field(layout, 2).offset, u32-layout, site)
head += load(kept, tables.layouts.field(layout, 3).offset, u32-layout, site)
head += load(kept, tables.layouts.field(layout, 1).offset, i64-layout, site)
author-again-value(site, property.type, value.operand, head)
return-value(make-operand(.operand-void, 0), site)

────────────────────
_ do emit-event-handler

` The function the event runtime calls for a section of a class that it runs from the table of
` the class, given the object and what was published, as the reference compiles it: the body of
` the section's subscriber, given the environment the section would make for the object, as
` the constructor would subscribe it (see `open-handler`). It returns nothing: an error its
` subscriber lets out is given to the global `unhandled-error` where it leaves (see
` `hand-off`).
. handler = tables.event-handlers[function.place]
if unit.instance == no-instance || unhandled-raise
    refuse(.refused-function, handler.syntax)
    =
.. unhandled-raise = instances.signatures[unit.instance].errors.count != 0 && !facts.unhandled-error
emit-body()

────────────────────
_ do open-handler

` Makes the environment a section of a class would make for the object the function the event
` runtime calls for it is given, as its first argument, which the body of the section's
` subscriber then reads as the environment it was given.
. handler = tables.event-handlers[function.place]
unit = unit.reading = handler.unit
unit = unit.self = make-operand(.operand-argument, 0)
unit = unit.self-type = handler.level
unit = unit.owner-type = handler.level
unit = unit.has-self = true
made-environment = lone-environment(handler.syntax, no-slot)
unit = unit.reading = unit.instance
unit = unit.self = make-operand(.operand-void, 0)
unit = unit.self-type = no-type
unit = unit.owner-type = instances.rows[unit.instance].self-type
unit = unit.has-self = false

────────────────────
_ do init-site SyntaxId

` Where the reference places the call of a module's main from its init: at the constructor of
` the class whose sections it puts last in the event runtime's tables at the head of the init,
` or nowhere.
. making = tables.init-constructor(function.module)
if making == no-instance || instances.rows[making].module != function.module
    = 0
. row = instances.rows[making]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = if fn.is-generated then class-site(row.module, fn.owner) else fn.syntax
= 0

────────────────────
_ do emit-event-matcher

` The function the event runtime asks whether an object is of a class whose table runs sections,
` and not of a class below it: the table the object names is the class's own.
. symbol = tables.table-symbols[function.type]
ir.add-argument(pointer-layout)
returns-type = types.bool-type
ir.returns = u8-layout
if symbol == no-string
    refuse-class(function.type)
    =
. table = load(make-operand(.operand-argument, 0), 0, pointer-layout, 0)
return-value(compare(0, .compare-equal, table, make-operand(.operand-symbol, symbol)), 0)

────────────────────
_ do register-styles SyntaxId
    - placed SyntaxId

` Registers, at the head of a module's init as the reference does, the domains of invalidation
` the program numbers where the module is the style runtime's, in the order of their places
` (`Facts.domain-order`), and the styles the module declares, each where the reference places it,
` in the file of the module that holds the place: the call of the module's main is then placed
` where the last was. Where the init also puts sections in the event runtime's tables at its head,
` it is placed at the later in the file of the last registration and the constructor `placed`
` names, as the reference places it at the last it compiled, in source order here; one where those
` are in two files has no shape where the init calls the main, which a stack trace through it then
` names.
. site = placed
. events = tables.init-constructor(function.module) != no-instance
placing = true
if function.module == tables.style-module()
    for index in facts.domain-order
        . domain = facts.domain-places[index]
        unit = unit.source-module = domain.module
        . mark = pending.length
        pending += make-operand
            - .operand-constant
            - ir.add-string(facts.style-domains[index].name.text)
        pending += integer(.machine-u64, tables.domain-number(index))
        call-instance(facts.style-runtime.register-domain, domain.site, mark)
        site = domain.site
for id in tables.style-registrations(function.module)
    . use = tables.style-uses[tables.functions[id].place]
    unit = unit.source-module = use.module
    call-function(id, use.site)
    site = use.site
for id in tables.sheet-registrations(function.module)
    . use = tables.style-sheet-uses[tables.functions[id].place]
    unit = unit.source-module = use.module
    call-function(id, use.site)
    site = use.site
if !events || site == placed || function.calls.start == function.calls.end
    = site
if placed == 0 || unit.source-module != function.module
    refuse(.refused-function, site)
    = site
. last = tree.nodes[site].loc.begin
. made = tree.nodes[placed].loc.begin
if made.line > last.line || (made.line == last.line && made.column > last.column)
    = placed
= site

────────────────────
_ do style-bits Operand
    - site SyntaxId
    - type TypeId
    - value Operand

` The bits of a style slot a value of a style property's type is: a number's own, cast; an
` object's number as the runtime interns it; a union's case number below the bits of what the
` case holds; and any other value's box, interned. An optional that holds nothing is no bits,
` and an object is interned as the optional it is.
if !types.is-optional(type)
    = held-style-bits(site, type, value)
. inner = types.optional-inner(type)
if intrinsic(inner) == .class
    = intern-style-object(site, inner, value, true)
. present-flag = present(site, Typed(value, type))
. cell = ir.add-local(i64-layout)
store-local(cell, integer(.machine-i64, 0), site)
. holding = ir.reserve-block()
. joined = ir.reserve-block()
branch(present-flag.operand, holding, joined)
ir.start-block(holding)
. inside = payload(site, Typed(value, type))
store-local(cell, held-style-bits(site, inner, inside.operand), site)
jump(joined)
ir.start-block(joined)
= load-local(cell, site)

────────────────────
_ do held-style-bits Operand
    - site SyntaxId
    - type TypeId
    - value Operand

` The bits of a style slot that a value of a type other than an optional is.
. kind = intrinsic(type)
if kind == .class
    = intern-style-object(site, type, value, false)
if kind == .union
    = union-style-bits(site, type, value)
if boxed-style(kind)
    = boxed-style-bits(site, type, value)
. layout = layout-of(type, site)
if layout == f32-layout || layout == f64-layout
    . wide = num-cast(site, value, layout, f64-layout)
    . cell = frame(f64-layout)
    store(cell, 0, wide, false, site)
    = load(cell, 0, i64-layout, site)
if !is-number(layout)
    refuse(.refused-type, site)
    = value
= num-cast(site, value, layout, i64-layout)

────────────────────
_ do union-style-bits Operand
    - site SyntaxId
    - type TypeId
    - value Operand

` The bits of a style slot a union is: the number of the case it holds, below the bits of
` what the case holds, a whole number of at most 32 bits its own, an object interned, and any
` other value boxed and interned; none where it holds no case it has.
. layout = layout-of(type, site)
. cell = ir.add-local(i64-layout)
store-local(cell, integer(.machine-i64, 0), site)
. joined = ir.reserve-block()
. cases = types.cases-of(type)
for index in 0 .. < cases.length
    . case-type = cases[index].type
    . holding = ir.reserve-block()
    . next = ir.reserve-block()
    branch(case-test(site, value, index as U32), holding, next)
    ir.start-block(holding)
    . field = tables.layouts.case-field(layout, index as U32)
    . held = take(value, field, site)
    . kind = intrinsic(case-type)
    . bits = held
    if is-integer-kind(kind) && types.completions[case-type].bit-size > 0 && small-bits
        bits = num-cast(site, held, field.layout, i64-layout)
    else if kind == .class
        bits = intern-style-object(site, case-type, held, false)
    else
        bits = boxed-style-bits(site, case-type, held)
    .. small-bits = types.completions[case-type].bit-size <= 32
    . shifted = bitwise(site, .bitwise-shift-left, bits, integer(.machine-i64, 8), i64-layout)
    store-local
        - cell
        - bitwise(site, .bitwise-or, shifted, integer(.machine-i64, index as U64), i64-layout)
        - site
    jump(joined)
    ir.start-block(next)
jump(joined)
ir.start-block(joined)
= load-local(cell, site)

────────────────────
_ do intern-style-object Operand
    - site SyntaxId
    - type TypeId
    - value Operand
    - optional Bool

` The number the style runtime interns an object as, which it takes as the optional of its
` class: a value given as the class is wrapped in it.
for coding in facts.style-codings
    if coding.type == type && coding.intern != no-instance
        . taken = value
        if !optional
            taken = wrap(site, Typed(value, type), coding.taken).operand
        . mark = pending.length
        pending += taken
        = call-instance(coding.intern, site, mark).operand
refuse(.refused-function, site)
= value

────────────────────
_ do boxed-style-bits Operand
    - site SyntaxId
    - type TypeId
    - value Operand

` The number the style runtime interns the box of a value as.
. optional = wide-holder(site, type, value)
. mark = pending.length
pending += optional.operand
= call-instance(facts.style-runtime.intern-holder, site, mark).operand

────────────────────
_ do emit-live-adapter

` The function a live action calls through the callback it holds, as the reference casts the
` function that runs a value or a rule again to the callback's type: given the data the
` callback holds, it calls that function with it where the value or the rule is written, the
` place a stack trace names, and answers as the callback's type does: an error that function
` raises leaves with the answer, as one the function that enables generated content answers
` does.
. code = function.place
. target = tables.functions[code]
. live = instances.live
. site = live-site(target)
ir.add-argument(managed-layout)
returns-type = types.void-type
ir.returns = void-layout
if live.callback-result != no-type
    return-results(live.callback-result, site)
. mark = pending.length
pending += make-operand(.operand-argument, 0)
if target.kind == .instance-body && instances.signatures[target.instance].errors.count != 0
    if live.callback-result == no-type
        refuse(.refused-function, site)
        =
    takes-result = true
    . answer = call-instance(target.instance, site, mark)
    takes-result = false
    do propagate(site, target.instance, answer.operand)
    return-value(make-operand(.operand-void, 0), site)
    =
if target.kind == .style-gate && facts.style-gates[target.place].content
    . answered = if live.callback-result != no-type then layout-of(live.callback-result, site) else no-layout
    if answered == no-layout
        refuse(.refused-function, site)
        =
    ir.depend(.callee-function, code, may-panic-dependency)
    . answer = call
        - make-operand(.operand-symbol, target.symbol)
        - site
        - mark
        - .callee-function
        - answered
        - !in-landing
    do propagate-held(site, live.callback-result, answer)
    return-value(make-operand(.operand-void, 0), site)
    =
ir.depend(.callee-function, code, may-panic-dependency)
call
    - make-operand(.operand-symbol, target.symbol)
    - site
    - mark
    - .callee-function
    - void-layout
    - !in-landing
return-value(make-operand(.operand-void, 0), site)

────────────────────
_ do emit-idle-action

` The function the live action that owns a subscription or the endpoint at the address of a
` keyed event calls, which does nothing: the subscription delivers to its subscriber itself,
` and the endpoint is only closed with the action.
. live = instances.live
ir.add-argument(managed-layout)
returns-type = types.void-type
ir.returns = void-layout
. site = tables.idle-site
unit = unit.source-module = instances.rows[tables.idle-instance].module
if live.callback-result != no-type
    return-results(live.callback-result, site)
return-value(make-operand(.operand-void, 0), site)

────────────────────
_ do retest-site SyntaxId
    - tree AST
    - clause SyntaxId

` Where the reference places the loop whose `whenever` clause a function tests again: the
` section of a class the loop is, or else the loop's header.
. loop = tree.clause-loop(clause)
for node in loop + 1 .. < (tree.nodes.length as SyntaxId)
    if tree.subtree-start(node) <= loop
        do match tree.nodes[node]
            | .node-for-block(block)
                if block.loop != loop
                    = loop
            | .node-subscriber-syntax
                = node
            ??
                = loop
= loop

────────────────────
_ do live-site SyntaxId
    - target EmittedFunction

` Where the reference places the call of a function a live action runs: the property whose
` value it evaluates again, the live statement it runs again or the first read of the
` declaration it runs again, the loop whose `whenever` clause it tests again (see
` `retest-site`), what a rule of a class reads or the class a rule on the markup an object is
` in looks for, the innermost `when` whose conditions a gate's function evaluates, the `when`
` whose state a state cell's function evaluates, or the declaration of a style rule whose
` value, or the values its rule is given, its function declares again. Its module is the one
` read.
if target.kind == .style-author
    . author = facts.style-authors[target.place]
    unit = unit.source-module = instances.rows[author.instance].module
    = author.site
if target.kind == .style-given-author
    unit = unit.source-module = instances.rows[given-unit].module
        .. given-unit = facts.style-applications[tables.given-applications[target.place]].unit
    = tables.given-sites[target.place]
if target.kind == .style-gate
    . gate = facts.style-gates[target.place]
    . place = facts.style-gate-whens[gate.first + gate.count - 1]
    unit = unit.source-module = place.module
    = place.syntax
if target.kind == .style-scope-state
    . held = facts.scope-cells[target.place]
    unit = unit.source-module = held.module
    = held.when
if target.kind == .property-updater
    . default = tables.default-of(target.type, target.place)
    unit = unit.source-module = default.module
    . declared = property-site(target.type, types.properties[target.place].name)
    = if declared != 0 then declared else default.site
if target.kind == .instance-body
    . row = instances.rows[target.instance]
    unit = unit.source-module = row.module
    do match? program.modules[row.module].decls[row.decl]
        | .decl-function(fn)
            if fn.kind == .whenever-decl
                = retest-site(program.modules[row.module].tree, fn.syntax)
            . live = tables.live-statement-of(row.enclosing, fn.syntax)
            = if live && live.read != 0 then live.read else fn.syntax
    = 0
. rule = tables.class-rules[target.place]
unit = unit.source-module = rule.module
do match? program.modules[rule.module].tree.nodes[rule.syntax]
    | .node-when-rule-syntax(when)
        = when.expr
    | .node-whenever-rule-syntax(whenever)
        = if whenever.expr != 0 then whenever.expr else whenever.target-type
= rule.syntax

────────────────────
_ do property-site SyntaxId
    - type TypeId
    - name Atom

` Where the reference places a property: at its declaration in the nearest class that
` declares it, past the values lines of a root `<This` give it, in that class's module.
. level TypeId? = type
while level
    . ref = class-ref(types, level)
    . member = owner-property(program, ref.module, ref.decl, name)
    do match? program.modules[ref.module].decls[member]
        | .decl-property(row)
            if member != 0 && !row.defaults-root
                unit = unit.source-module = ref.module
                = row.syntax
    level = types.base-of(level)
= 0

────────────────────
_ do side-list Typed
    - site SyntaxId
    - object Operand
    - lane U64
    - maker InstanceId

` The list an object keeps in a side lane of the collector: the subscribers of its properties
` in lane 0, its live actions in lane 1. One is made and published there where it has none.
. owner = num-cast(site, object, managed-layout, pointer-layout)
. mark = pending.length
pending += owner
pending += integer(.machine-u64, lane)
. raw = call-runtime(.runtime-object-side-payload, site, mark, managed-layout)
. held = ir.add-local(managed-layout)
store-local(held, raw, site)
. making = ir.reserve-block()
. ready = ir.reserve-block()
branch
    - compare
        - site
        - .compare-equal
        - num-cast(site, raw, managed-layout, u64-layout)
        - integer(.machine-u64, 0)
    - making
    - ready
ir.start-block(making)
. made = call-instance(maker, site, pending.length)
. publishing = pending.length
pending += owner
pending += integer(.machine-u64, lane)
pending += made.operand
store-local
    - held
    - call-runtime(.runtime-publish-side-payload, site, publishing, managed-layout)
    - site
jump(ready)
ir.start-block(ready)
= Typed(load-local(held, site), made.type)

────────────────────
_ do track
    - id SyntaxId
    - object Operand
    - name Atom

` Notes a read of a property of an object in the trackers of the live action open, with the
` object's list of subscribers, as `track-in` does.
. live = instances.live
. active = live-actions.length == 0 && facts.pulls(unit.reading, id)
if live.track == no-instance || live.subscribers == no-instance || (live-actions.length == 0 && !active)
    refuse(.refused-expression, id)
    =
. subscribers = side-list(id, object, 0, live.subscribers)
track-in(id, subscribers.operand, object, name)

────────────────────
_ do track-collection
    - id SyntaxId
    - value Typed

` Notes the read of a collection in the trackers of the live action open, where the type pass
` noted it (`CollectionRead`), so that the action runs again as the collection changes, as the
` reference's `trackCollectionRead` does. An optional collection is noted where it holds one.
if !facts.reads-collection(unit.reading, id)
    =
. live = instances.live
. active = live-actions.length == 0 && facts.pulls(unit.reading, id)
if active && live.track-active-collection == no-instance
    refuse(.refused-expression, id)
    =
if !active && (live.track-collection == no-instance || live-actions.length == 0)
    refuse(.refused-expression, id)
    =
. held = value.type
. tracked = value
. done = no-block
if types.is-optional(held)
    . filled = ir.reserve-block()
    done = ir.reserve-block()
    branch(present(id, Typed(value.operand, tracked.type)).operand, filled, done)
    ir.start-block(filled)
    tracked = payload(id, Typed(value.operand, held))
. mark = pending.length
if active
    pending += num-cast(id, tracked.operand, managed-layout, pointer-layout)
    do call-instance(live.track-active-collection, id, mark)
else
    pending += load-local(live-actions[live-actions.length - 1].previous, id)
    pending += load-local(live-actions[live-actions.length - 1].next, id)
    pending += num-cast(id, tracked.operand, managed-layout, pointer-layout)
    do call-instance(live.track-collection, id, mark)
if done != no-block
    jump(done)
    ir.start-block(done)

────────────────────
_ do track-in
    - id SyntaxId
    - subscribers Operand
    - owner Operand
    - name Atom

` Notes a read of a name in the trackers of the live action open, as the reference's
` `track-property-dependency` does: with the trackers the action had and those it gathers now,
` the name and a number for it, and the list of subscribers with its owner.
. live = instances.live
if live-actions.length == 0 && facts.pulls(unit.reading, id) && live.track-active != no-instance
    . start = pending.length
    pending += make-operand(.operand-constant, ir.add-string(name.text))
    pending += integer(.machine-u64, program.atom-ordinal(name) as U64)
    pending += subscribers
    pending += num-cast(id, owner, managed-layout, pointer-layout)
    do call-instance(live.track-active, id, start)
    =
if live.track == no-instance || live-actions.length == 0
    refuse(.refused-expression, id)
    =
. mark = pending.length
pending += load-local(live-actions[live-actions.length - 1].previous, id)
pending += load-local(live-actions[live-actions.length - 1].next, id)
pending += make-operand(.operand-constant, ir.add-string(name.text))
pending += integer(.machine-u64, program.atom-ordinal(name) as U64)
pending += subscribers
pending += num-cast(id, owner, managed-layout, pointer-layout)
do call-instance(live.track, id, mark)

────────────────────
_ do track-name
    - id SyntaxId
    - name Atom

` A tracked read of a name alone in a live action: a local is noted with the list of
` subscribers of the function that declares it, which owns the list, a member of a markup
` element being built read by its name with the element's, kept where it was made where the
` read is in a function written in its body, and a member of the receiver with the receiver's.
. binding = instances.rows[unit.reading].binding
if binding != no-binding && (resolution-flags /and/ ResolutionFlag.resolution-received) != 0
    . kept = received-kept(id)
    if kept != no-slot
        . object = read-kept(kept, id)
        track(id, object.operand, name)
        =
    . position = received-position(name)
    if !position
        refuse(.refused-expression, id)
        =
    track(id, content-hosts[position].operand, name)
    =
.. resolution-flags = bindings.resolution-of(binding, id).flags
. slot = tracked-local(id)
if slot == no-slot
    if !unit.has-self
        refuse(.refused-expression, id)
        =
    track(id, unit.self, name)
    =
. list = local-subscribers(slot, id)
track-in(id, list, list, name)

────────────────────
_ tracked-local SlotId
    - id SyntaxId

` The local or argument a name alone reads where some read tracks it, or none.
|? binding == no-binding
    no-slot
|? resolution.kind != .resolve-slot
    no-slot
|? kind != .slot-local && kind != .slot-lazy && kind != .slot-argument
    no-slot
??
    resolution.slot

.. binding = instances.rows[unit.reading].binding
.. resolution = bindings.resolution-of(binding, id)
.. kind = bindings.slots[resolution.slot].kind

────────────────────
_ do local-subscribers Operand
    - slot SlotId
    - site SyntaxId

` The list of subscribers of the function that declares a local, where it keeps it: in its
` environment where a function written in it reads it.
. nothing = make-operand(.operand-void, 0)
. list = subscribers-slot(slot)
if list == no-slot
    refuse(.refused-expression, site)
    = nothing
if is-captured(list)
    . field = find-captured(list, site)
    = take(captured-base(site), field, site)
. offset = list - unit.slot-start
if !owns(list) || unit.cells[offset] == no-local
    refuse(.refused-expression, site)
    = nothing
= load-local(unit.cells[offset], site)

────────────────────
_ do subscribers-slot SlotId
    - slot SlotId

` The hidden local that holds the list of subscribers of the function that declares a local.
. home = bindings.slots[slot].scope
while bindings.scopes[home].kind != .scope-function && bindings.scopes[home].kind != .scope-nested
    home = bindings.scopes[home].parent
for offset in 0 .. < unit.slot-count
    . row = bindings.slots[unit.slot-start + offset]
    if row.kind == .slot-subscribers && row.scope == home
        = unit.slot-start + offset
= no-slot

────────────────────
_ do make-subscribers
    - site SyntaxId

` Makes the lists of subscribers the function keeps for the locals it declares that some read
` tracks, where it starts, as the reference does in its head. One that nested functions read
` is kept in the environment.
. live = instances.live
if unit.instance == no-instance || live.subscribers == no-instance
    =
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    if bindings.slots[slot].kind != .slot-subscribers || !owns(slot)
        continue
    . type = facts.slot-type(unit.instance, offset)
    if type == no-type || type == invalid-type
        continue
    . made = call-instance(live.subscribers, site, pending.length)
    if is-captured(slot)
        keep-captured(slot, made.operand, type, site)
    else
        unit.cells[offset] = ir.add-local(managed-layout)
        store-local(unit.cells[offset], made.operand, site)

────────────────────
_ watches Bool
    - slot SlotId
    - id SyntaxId

` Whether a store to a local runs the actions that read it: some read tracks it, and the
` function that declares it has made its list of subscribers by then, as the reference makes
` it at the first tracked read of one of its locals that it compiles. The function that runs a
` live statement again stores after that, and so does any other function written in the one
` that declares the local, where that one reads one of its locals tracked.
|? (bindings.slots[slot].flags /and/ SlotFlag.slot-tracked) == 0 || undispatched
    false
|? kind != .slot-local && kind != .slot-lazy && kind != .slot-argument
    false
|? tables.is-rerun(unit.instance)
    facts.tracked-locals-from(instances.rows[unit.instance].enclosing) != 0
|? !owns(slot)
    declarer(slot) != no-instance && facts.tracked-locals-from(declarer(slot)) != 0
??
    first != 0 && first < id

.. undispatched = instances.live.dispatch == no-instance
.. kind = bindings.slots[slot].kind
.. first = facts.tracked-locals-from(unit.instance)

────────────────────
_ do declarer InstanceId
    - slot SlotId

` The function the emitted one is written in that declares a slot, or none.
. owner = unit.instance
while owner != no-instance && tables.instance-scopes[owner] != tables.slot-functions[slot]
    owner = instances.rows[owner].enclosing
= owner

────────────────────
_ do dispatch-local
    - slot SlotId
    - prior Operand
    - latest Operand
    - type TypeId
    - site SyntaxId
    - armed Operand = make-operand(.operand-void, 0)

` Runs the actions that read a tracked local where a store changed its bits, as `bits-differ`
` says, through the list of subscribers of the function that declares it, under the local's
` name; where `armed` is given, only where it is set.
. live = instances.live
. changed = bits-differ(prior, latest, layout-of(type, site), site)
if operand-kind(armed) != .operand-void
    changed = bitwise(site, .bitwise-and, changed, armed, u8-layout)
. sending = ir.reserve-block()
. done = ir.reserve-block()
branch(changed, sending, done)
ir.start-block(sending)
. list = local-subscribers(slot, site)
. mark = pending.length
pending += list
pending += make-operand(.operand-constant, ir.add-string(bindings.slots[slot].name.text))
do call-instance(live.dispatch, site, mark)
jump(done)
ir.start-block(done)

────────────────────
_ do emit-tracked-get Typed
    - id SyntaxId
    - object SyntaxId
    - name Atom

` A tracked read of a stored property of an object in a live action: the object is read once,
` the read is noted in the action's trackers, and the property is read from the object. An
` object written as a member of the receiver or a local named alone is tracked as it is read,
` as the reference tracks the start of the chain. Any other tracked read has no shape there.
. owner = held-type(object)
. fact = own-call(id)
. getter = fact != no-fact && facts.calls[fact].form == .call-getter
if owner == no-type || owner == invalid-type || !tables.is-class(owner) || planned || getter
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
.. planned = facts.plan-of(unit.reading, id) != .plan-none
. root = tracked-root(object)
if root && !pin-of(object)
    track(object, unit.self, root)
. local = if !pin-of(object) then tracked-root-local(object) else no-slot
if local != no-slot && !settles-once(local) && live-actions.length != 0
    . list = local-subscribers(local, object)
    track-in(object, list, list, bindings.slots[local].name)
. base = emit-expression(object)
track(id, base.operand, name)
. value = load-property(id, base.operand, owner, name)
track-collection(id, value)
= value

────────────────────
_ do settles-once Bool
    - slot SlotId

` Whether a local is a lazy one whose declaration no live action runs again, so that nothing
` stores to it after its value is evaluated and a read of it tracks nothing.
. row = bindings.slots[slot]
if row.kind != .slot-lazy
    = false
. binding = instances.rows[unit.reading].binding
. nested = bindings.bindings[binding].nested
for offset in 0 .. < nested.count
    . held = bindings.nested[nested.start + offset]
    if held.syntax == row.group
        do match? program.modules[unit.source-module].decls[held.decl]
            | .decl-function(fn)
                if fn.kind == .live-decl
                    = false
= true

────────────────────
_ do tracked-root Atom?
    - object SyntaxId

` The name of the member of the receiver a tracked read reads from, where its object is that
` member named alone and untracked, or none.
. binding = instances.rows[unit.reading].binding
if binding == no-binding
    = null
do match? tree.nodes[object]
    | .node-identifier(row)
        if !row.is-tracked && bindings.resolution-of(binding, object).kind == .resolve-member
            = row.name
= null

────────────────────
_ do tracked-root-local SlotId
    - object SyntaxId

` The local a tracked read reads from, where its object is that local named alone and
` untracked, or none.
do match? tree.nodes[object]
    | .node-identifier(row)
        if !row.is-tracked
            = tracked-local(object)
= no-slot

────────────────────
_ tracks Bool
    - property TypeProperty

` Whether some read tracks a property, by the topmost class that declares it (`tracked-root`),
` which an override shares.
|? property.owner == no-type || property.owner == invalid-type || undispatched
    false
??
    facts.is-tracked(ref.module, ref.decl, property.name)

.. undispatched = instances.live.dispatch == no-instance
.. ref = class-ref(types, types.tracked-root(property.owner, property.name))

────────────────────
_ do put-property
    - object Operand
    - field LayoutField
    - property TypeProperty
    - value Operand
    - site SyntaxId
    - flag-offset U32 = U32.max
    - always Bool = false
    - memo-flag U32 = U32.max

` Stores a value in a property of an object as an assignment does: a managed pointer through
` the write barrier, and a struct by a copy, and a lazy property is marked, at `flag-offset`,
` as having its value. A property whose value is a memo has its flag, at `memo-flag`, cleared,
` so a read keeps the value stored. A property some read tracks keeps a copy of its bits from
` before the store and runs the actions that read it where they changed, or `always`. One that
` holds nothing has no shape there yet.
. tracked = tracks(property)
if tracked && field.layout == void-layout
    refuse(.refused-statement, site)
    =
. prior = make-operand(.operand-void, 0)
if tracked
    prior = if tables.layouts.is-struct(field.layout) then snapshot(field-value(object, field, site), field.layout, site) else load(object, field.offset, field.layout, site)
if tables.layouts.is-struct(field.layout)
    store-struct(object, field, value, site)
else if field.layout != void-layout
    store(object, field.offset, value, is-managed-pointer(field.layout), site)
if flag-offset != U32.max
    store-release(object, flag-offset, integer(.machine-u8, 1), site)
if memo-flag != U32.max
    store(object, memo-flag, integer(.machine-u8, 0), false, site)
if tracked
    dispatch-change
        - object
        - prior
        - field-value(object, field, site)
        - field.layout
        - property.name
        - site
        - always

────────────────────
_ do dispatch-change
    - object Operand
    - prior Operand
    - latest Operand
    - layout LayoutId
    - name Atom
    - site SyntaxId
    - always Bool = false

` Runs the actions that read a tracked property of an object where a store changed its bits,
` as `bits-differ` says, or `always`. Nothing runs where the object keeps no list of
` subscribers.
. live = instances.live
. changed = if !always then bits-differ(prior, latest, layout, site) else unchanged
    .. unchanged = make-operand(.operand-void, 0)
. checking = ir.reserve-block()
. sending = ir.reserve-block()
. done = ir.reserve-block()
if always
    jump(checking)
else
    branch(changed, checking, done)
ir.start-block(checking)
. mark = pending.length
pending += num-cast(site, object, managed-layout, pointer-layout)
pending += integer(.machine-u64, 0)
. subscribers = call-runtime(.runtime-object-side-payload, site, mark, managed-layout)
branch
    - compare
        - site
        - .compare-not-equal
        - num-cast(site, subscribers, managed-layout, u64-layout)
        - integer(.machine-u64, 0)
    - sending
    - done
ir.start-block(sending)
. sent = pending.length
pending += subscribers
pending += make-operand(.operand-constant, ir.add-string(name.text))
do call-instance(live.dispatch, site, sent)
jump(done)
ir.start-block(done)

────────────────────
_ do bits-differ Operand ?! Refused
    - prior Operand
    - latest Operand
    - layout LayoutId
    - site SyntaxId

` Whether two stored values differ in their bits: a float by its bits, not its value, a
` reference by what it points at, a struct by each of its fields, and a union by the case it
` holds and, where both hold one case, by that case's value, as the reference compares the
` value whole.
if !tables.layouts.is-struct(layout)
    = compare
        - site
        - .compare-not-equal
        - stored-bits(prior, layout, site)
        - stored-bits(latest, layout, site)
if tables.layouts.is-union(layout)
    . cases = compare
        - site
        - .compare-not-equal
        - load(prior, 0, u8-layout, site)
        - load(latest, 0, u8-layout, site)
    for index in 0 .. < tables.layouts.rows[layout].cases.count
        . field = tables.layouts.case-field(layout, index)
        if field.type == types.void-type
            continue
        . part = bits-differ
            - field-value(prior, field, site)
            - field-value(latest, field, site)
            - field.layout
            - site
        . held = bitwise(site, .bitwise-and, case-test(site, prior, index), part, u8-layout)
        cases = bitwise(site, .bitwise-or, cases, held, u8-layout)
    = cases
. differ = integer(.machine-u8, 0)
for index in 0 .. < tables.layouts.rows[layout].fields.count
    . field = tables.layouts.field(layout, index)
    . part = bits-differ
        - field-value(prior, field, site)
        - field-value(latest, field, site)
        - field.layout
        - site
    differ = bitwise(site, .bitwise-or, differ, part, u8-layout)
= differ

────────────────────
_ do field-value Operand
    - base Operand
    - field LayoutField
    - site SyntaxId

` A field held in memory: a struct as its address, and anything else loaded.
if tables.layouts.is-struct(field.layout)
    = address(base, field.offset, field.layout, site)
= load(base, field.offset, field.layout, site)

────────────────────
_ do stored-bits Operand
    - value Operand
    - layout LayoutId
    - site SyntaxId

` A stored value as the bits it is stored as: a float is read back from memory as an integer of
` its width.
if layout != f64-layout && layout != f32-layout
    = value
. held = frame(layout)
store(held, 0, value, false, site)
= load(held, 0, if layout == f64-layout then u64-layout else u32-layout, site)

────────────────────
_ do closes-actions Bool

` Whether the function is a class's `close` that takes no arguments, which closes the live
` actions the object owns, where the program makes any, and stops the machines its properties hold
` and its markup writes, where the program starts any, as it starts, and closes the live actions
` made since and the object's events, where its class has any, and cancels the tasks it owns,
` where the program spawns any an object owns, as it leaves.
if unit.instance == no-instance || !unit.has-self || function.kind != .instance-body
    = false
if instances.live.has-actions == no-instance && !closes-events() && !stops-machines() && !tables.owns-tasks
    = false
if !tables.is-class(unit.owner-type)
    = false
. row = instances.rows[unit.instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.owner != 0 && fn.args.count == 0 && fn.name
            . named = fn.name
            = named.text == "close"
= false

────────────────────
_ do stop-owned
    - site SyntaxId

` Closes each live action the receiver owns, then stops each machine its properties hold and its
` markup writes, as the event runtime keeps them (`event-stop-machines`), before the body of
` `close` runs: nothing the object does again on its own runs while the body closes what it owns,
` and the machines' exit rows see the object as it was.
if instances.live.has-actions != no-instance
    close-actions(site, unit.self)
if stops-machines()
    . stopping = pending.length
    pending += num-cast(site, unit.self, managed-layout, pointer-layout)
    do call-instance(facts.machine-stop, site, stopping)

────────────────────
_ do close-owned
    - site SyntaxId

` Closes each live action the receiver owns, taking it off the list the receiver keeps in lane 1,
` and then clears the lane, as the reference's `close` does as it leaves; then closes the
` receiver's events, where its class has any, or where `stop-owned` stopped its machines; then
` cancels the tasks the receiver owns, where the program spawns any an object owns, without
` waiting for them or yielding to them. A task that closes its own owner is not cancelled.
if instances.live.has-actions != no-instance
    close-actions(site, unit.self)
if closes-events()
    . mark = pending.length
    pending += num-cast(site, unit.self, managed-layout, pointer-layout)
    do call-instance(facts.event-close, site, mark)
else if closes-stopped()
    . mark = pending.length
    pending += num-cast(site, unit.self, managed-layout, pointer-layout)
    do call-instance(facts.machine-close, site, mark)
if tables.owns-tasks
    . cancelling = pending.length
    pending += num-cast(site, unit.self, managed-layout, pointer-layout)
    call-runtime(.runtime-cancel-owned-tasks, site, cancelling)

────────────────────
_ stops-machines Bool

` Whether the program starts a machine a class's property holds or its markup writes, which each
` class's `close` stops (`own-machine`).
facts.machine-stop != no-instance && tables.instance-functions[facts.machine-stop] != no-function

────────────────────
_ closes-stopped Bool

stops-machines() && facts.machine-close != no-instance && tables.instance-functions[facts.machine-close] != no-function

────────────────────
_ do closes-events Bool

` Whether the function is a `close` whose class has events, which it closes as it leaves.
if facts.event-close == no-instance
    = false
for closer in facts.event-closers
    if closer == unit.instance
        = true
= false

────────────────────
_ do close-actions
    - site SyntaxId
    - owner Operand

` Closes each live action an object owns, taking it off the list the object keeps in lane 1,
` and then clears the lane.
. live = instances.live
. mark = pending.length
pending += num-cast(site, owner, managed-layout, pointer-layout)
pending += integer(.machine-u64, 1)
. actions = call-runtime(.runtime-object-side-payload, site, mark, managed-layout)
. looping = ir.reserve-block()
. closing = ir.reserve-block()
. clearing = ir.reserve-block()
. done = ir.reserve-block()
branch
    - compare
        - site
        - .compare-not-equal
        - num-cast(site, actions, managed-layout, u64-layout)
        - integer(.machine-u64, 0)
    - looping
    - done
ir.start-block(looping)
. asking = pending.length
pending += actions
. empty = call-instance(live.has-actions, site, asking)
branch(empty.operand, clearing, closing)
ir.start-block(closing)
. popping = pending.length
pending += actions
. action = call-instance(live.pop, site, popping)
. shutting = pending.length
pending += action.operand
do call-method(live.close, site, shutting)
jump(looping)
ir.start-block(clearing)
. clear = pending.length
pending += num-cast(site, owner, managed-layout, pointer-layout)
pending += integer(.machine-u64, 1)
call-runtime(.runtime-clear-side-payload, site, clear)
jump(done)
ir.start-block(done)

────────────────────
_ do read-lazy Typed
    - id SyntaxId
    - object Operand
    - place U32

` Reads a lazy property of an object: the function in the property's slot of the object's
` class table is called with the object, and answers the value, which it evaluates when the
` object has none yet. A struct is read where the object stores it, at the address the
` function answers. The call is checked when the value some class writes may panic,
` which the type pass must have said of the reader too. Where the value lets out errors, the
` function answers the value or one of them: the errors leave the reader with the read, or
` under `catch`, which the type pass typed the read as answering them, are answered.
. nothing = make-operand(.operand-void, 0)
. slot = tables.lazy-slots[place]
. property = types.properties[place]
. raises = tables.lazy-raises(place)
. raised = tables.lazy-result(place)
if (raises && !function.may-panic && !in-landing) || raised == invalid-type
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. caught = raised != no-type && facts.node-type(unit.reading, id) == raised
. returns = layout-of(if raised == no-type then property.type else raised, id)
if raised != no-type && tables.layouts.is-struct(layout-of(property.type, id))
    refuse(.refused-expression, id)
. table = load(object, 0, pointer-layout, id)
. method = load(table, table-header-size + slot * table-slot-size, pointer-layout, id)
. mark = pending.length
pending += object
if in-zone
    cross-zone(id, false)
. in-place = raised == no-type && tables.layouts.is-struct(returns)
. result = call
    - method
    - id
    - mark
    - .callee-value
    - if in-place then pointer-layout else returns
    - raises && !in-landing
if in-zone
    cross-zone(id, true)
if caught
    = Typed(result, raised)
if raised != no-type
    = propagate-held(id, raised, result)
if in-place
    = Typed(address(result, 0, returns, id), property.type)
= Typed(result, property.type)

────────────────────
_ do unread-value Typed
    - type TypeId
    - layout LayoutId
    - site SyntaxId

` What a read that never runs stands for: the value a type has with nothing written, in its
` layout.
if tables.layouts.is-struct(layout)
    = null-value(type, layout, site)
if is-float(layout)
    = Typed(float-number(layout, 0.0), type)
= Typed(integer(tables.layouts.kind-of(layout), 0), type)

────────────────────
_ do emit-globals
    - kind GlobalKind

` The function that gives a module's globals of one kind their first values, in the order
` they are declared: the constants, before any module starts, or the globals whose values
` run code, as the module starts. Each of the second kind is then marked as having its
` value. A value nothing reads is evaluated for what it does.
. module = function.module
. owner = program.modules[module]
unit = unit.source-module = module
unit = unit.reading = tables.main-instances[module]
for index in 0 .. < owner.decls.length
    if tables.global-kind(module, index as DeclId) != kind
        continue
    . row = tables.storage-of(module, index as DeclId)
    do match? owner.decls[index]
        | .decl-property(property)
            if row == no-storage
                if property.value != 0 && kind == .global-eager
                    emit-expression(property.value)
            else if property.value != 0 || kind == .global-eager
                . kept = tables.storage[row]
                store-global(kept, global-value(kept, property).operand, property.syntax)
                if kind == .global-eager
                    store
                        - make-operand(.operand-symbol, kept.state)
                        - 0
                        - integer(.machine-u8, 1)
                        - false
                        - property.syntax
return-nothing()

────────────────────
_ do enum-value Typed
    - kept GlobalStorage
    - case CaseDecl
    - decl DeclId

` What a module makes for a value of an enum as it starts. A constructor the type pass
` recorded where the value is declared makes it, given the value written or nothing. Any
` other is the value written, or the number of the value among those its enum declares,
` converted as recorded where it is written or declared.
. nothing = make-operand(.operand-void, 0)
. made = no-fact
. fact = facts.first-call(unit.reading, case.syntax)
while fact != no-fact
    if facts.calls[fact].form == .call-constructor
        made = fact
    fact = facts.calls[fact].next
if made != no-fact
    . none = RowRange'SyntaxId()
    . object = emit-fact-call(case.syntax, facts.calls[made], 0, none, 0, case.value, kept.type)
    if object.type != kept.type
        refuse(.refused-conversion, case.syntax)
    = object
. site = case.syntax
. value = Typed(nothing, no-type)
if case.value != 0
    site = case.value
    value = emit-expression(case.value)
else
    . counted = types.type-row(.int64)
    . layout = layout-of(counted, site)
    value = Typed(integer(tables.layouts.kind-of(layout), enum-ordinal(decl)), counted)
if value.type != kept.type
    value = convert(site, .reason-assignment, value)
if value.type != kept.type
    refuse(.refused-conversion, site)
= value

────────────────────
_ do enum-ordinal U32
    - decl DeclId

` The number of a value of an enum among those its enum declares, in their order.
. owner = program.modules[unit.source-module]
. declares DeclId = 0
do match? owner.decls[decl]
    | .decl-case(case)
        declares = case.owner
. ordinal U32
for index in 0 .. < decl
    do match? owner.decls[index]
        | .decl-case(case)
            if case.owner == declares
                ordinal += 1
= ordinal

────────────────────
_ do read-enum Typed
    - id SyntaxId

` A value of an enum named: read from where the module that declares it keeps it, which made
` it as it started.
. nothing = make-operand(.operand-void, 0)
. constant = facts.constant-of(unit.reading, id)
if constant == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. bits = facts.constants[constant].bits
. module ModuleId = (bits / 4294967296) as U32
. decl DeclId = (bits % 4294967296) as U32
if module >= program.modules.length || decl >= program.modules[module].decls.length
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. row = tables.storage-of(module, decl)
if row == no-storage || tables.global-kind(module, decl) != .global-enum
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. kept = tables.storage[row]
if kept.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
= load-global(kept, id)

────────────────────
_ do emit-statics

` The function that makes what a module keeps of its types as it starts, before its globals
` have their values, as TypeScript's statics: the values of its enums that an emitted
` function reads, in the order they are declared, then the defaults of its parameters that
` run code and are kept, once each.
. module = function.module
. owner = program.modules[module]
unit = unit.source-module = module
unit = unit.reading = tables.main-instances[module]
for index in 0 .. < owner.decls.length
    . row = tables.storage-of(module, index as DeclId)
    if row == no-storage || tables.global-kind(module, index as DeclId) != .global-enum
        continue
    do match? owner.decls[index]
        | .decl-case(case)
            . kept = tables.storage[row]
            store-global(kept, enum-value(kept, case, index as DeclId).operand, case.syntax)
. default = tables.first-default(function.module)
while default != no-storage
    . kept = tables.storage[default]
    unit = unit.reading = kept.owner
    . value = emit-expression(kept.syntax)
    if value.type != kept.type
        refuse(.refused-conversion, kept.syntax)
    store-global(kept, value.operand, kept.syntax)
    default = kept.next
return-nothing()

────────────────────
_ do emit-argument-default

` The function that evaluates the default of a parameter, which each call that leaves the
` argument out calls: it answers the default's value, typed by the instance whose parameter it
` is.
. kept = tables.storage[function.place]
unit = unit.source-module = instances.rows[kept.owner].module
unit = unit.reading = kept.owner
returns-type = kept.type
ir.returns = layout-of(kept.type, kept.syntax)
. value = emit-expression(kept.syntax)
if value.type != kept.type
    refuse(.refused-conversion, kept.syntax)
return-value(value.operand, kept.syntax)

────────────────────
_ do emit-stream-action

` The function the reference runs an action of a stream pattern in, which a panic in it
` shows. It is given what the arm binds that the action reads, in the order the type pass
` recorded them: `location`, `it` and the names the match captures. It binds each, runs the
` action and answers its value, or in an instance that raises errors its value or one of
` them, as `return-results` says.
. row = facts.outlined[function.place]
. body SyntaxId = 0
do match? tree.nodes[row.arm]
    | .node-stream-transform(arm)
        body = arm.right
. type = facts.node-type(unit.reading, row.arm)
if body == 0 || type == no-type || type == invalid-type
    refuse(.refused-function, row.arm)
    =
. named = bound.length
for position in row.params.start .. < row.params.start + row.params.count
    . given = facts.action-types[position]
    bound += BoundValue
        - facts.action-slots[position]
        - given
        - make-operand(.operand-argument, ir.arguments.length)
    ir.add-argument(layout-of(given, row.arm))
returns-type = type
ir.returns = layout-of(type, row.arm)
if instances.signatures[row.instance].errors.count != 0
    return-results(row.result, row.arm)
. value = arm-value(row.arm, body, type)
return-value(value.operand, body)
drop-bound(named)

────────────────────
_ do emit-pattern-helper

` The function the reference makes of a pattern given to a rule where it is written,
` `static-inline-match-direct`: it takes what the function of a rule takes but the arguments
` written, matches the pattern from the cursor as a rule's arms are matched, and returns an
` optional of what the pattern gives, which holds nothing where it did not match. One written
` under a helper takes the helper as a rule typed for it does, and runs under it; under one
` that can roll back, it gives the rollback mark it holds as a rule does. Last it takes the
` data the value it is passed as holds: the address of what the names the type pass kept
` for it held where the pattern was passed, which it binds each name to, and reads the
` arguments of the rule it is written in from where it runs a local rule of that rule. One
` that runs a local rule of a rule that raises errors as a function returns its answer or one
` of them, as `return-results` says, and the rule it is given to lets an error pass to the
` rule that wrote it.
. row = facts.pattern-arguments[function.place]
. pattern SyntaxId = 0
do match? tree.nodes[row.syntax]
    | .node-stream-match(written)
        pattern = written.pattern
if pattern == 0
    refuse(.refused-function, row.syntax)
    =
ir.add-argument(layout-of(row.stream, row.syntax))
returns-type = row.answer
ir.returns = layout-of(row.answer, row.syntax)
. raised = tables.pattern-raises(row.instance, row.syntax)
if raised != no-type
    return-results(raised, row.syntax)
if !direct-arguments(row.buffer, row.syntax, row.helper, helper-marks(row.helper))
    =
. given = make-operand(.operand-argument, ir.arguments.length)
ir.add-argument(pointer-layout)
. named = bound.length
if row.params.count != 0
    . layout = tables.pattern-environment(function.place)
    if layout == no-layout
        refuse(.refused-function, row.syntax)
        =
    for offset in 0 .. < row.params.count
        . position = row.params.start + offset
        bound += BoundValue
            - facts.action-slots[position]
            - facts.action-types[position]
            - take(given, tables.layouts.field(layout, offset), row.syntax)
given-slots = true
rule-arguments = rule-match(program, instance-module, instances.rows[unit.instance].decl) != 0
    .. instance-module = instances.rows[unit.instance].module
. views = facts.first-call(unit.reading, row.syntax)
match-direct
    - row.syntax
    - row.syntax
    - pattern
    - row.result
    - row.answer
    - row.stream
    - row.buffer
    - 1
    - views
    - next-call(views)
    - row.syntax
drop-bound(named)

────────────────────
_ do emit-pattern-cast

` The function the reference passes for a pattern given to a rule that is a call of a rule a
` module declares written alone, `Casting`: it takes what the rule's function takes and runs
` it, at the call, as the reference's cast of that function to the type the parameter takes
` does. One written under a helper takes the helper, which it gives a rule typed for it; under
` one that can roll back, it gives the rollback mark the rule gives, or none where the rule
` gives none. Last it takes the data the value it is passed as holds, which is none.
. row = facts.pattern-arguments[function.place]
. signature = instances.signatures[row.rule]
. site = row.syntax
do match? tree.nodes[row.syntax]
    | .node-stream-match(written)
        site = written.pattern
. helped = instances.rows[row.rule].helper
. carried = carries(row.rule)
. marked = helper-marks(row.helper)
if other-shape || unfit-stream || (helped != no-type && helped != row.helper) || unmarked-state
    refuse(.refused-function, site)
    =
.. other-shape = signature.returns != row.answer || signature.args.count != 1
.. unfit-stream = signature.errors.count != 0 || instances.argument-type(row.rule, 0) != row.stream
.. unmarked-state = collector-args.length != 0 || (carried && (helped == no-type || !marked))
ir.add-argument(layout-of(row.stream, site))
returns-type = row.answer
ir.returns = layout-of(row.answer, site)
if !direct-arguments(row.buffer, site, row.helper, marked)
    =
ir.add-argument(pointer-layout)
if marked
    open-marks(row.syntax)
    if streaming.rollback-mark == no-local
        refuse(.refused-function, site)
        =
. mark = pending.length
for position in 0 .. < 7
    pending += make-operand(.operand-argument, position as U32)
if helped != no-type
    pending += streaming.pattern-helper
if carried
    pending += streaming.marked-argument
calls-rule = true
. answer = call-instance(row.rule, site, mark)
if marked && !carried
    give-mark(site)
return-value(answer.operand, site)

────────────────────
_ do direct-arguments Bool
    - buffer-type TypeId
    - site SyntaxId
    - helper TypeId = no-type
    - marked Bool = false

` Adds the arguments every function a stream pattern calls takes after the stream and those
` written: the address the items start at, the cursor and the count of items, and the
` addresses of where it ended, how far it read and the farthest cursor a part failed at; then
` the helper of the pattern calling it, where it is given one; then where to keep the rollback
` mark it holds as it passes, where it is `marked`; then a pointer to each collector a set of
` them gives it. A buffer that is no array has no shape here.
. index-layout = layout-of(types.index-type, site)
. buffer-layout = layout-of(buffer-type, site)
layout-of(class-arg(types, buffer-type, 0), site)
if unstructured || unpaired-buffer || !is-integer(index-layout)
    refuse(.refused-type, site)
    = false
.. unstructured = !tables.layouts.is-struct(buffer-layout)
.. unpaired-buffer = tables.layouts.rows[buffer-layout].fields.count != 2
ir.add-argument(pointer-layout)
ir.add-argument(index-layout)
ir.add-argument(index-layout)
ir.add-argument(pointer-layout)
ir.add-argument(pointer-layout)
ir.add-argument(pointer-layout)
if helper != no-type
    add-helper-argument(helper, site)
if marked
    add-mark-argument()
for name in collector-args
    ir.add-argument(pointer-layout)
= true

────────────────────
_ do pattern-value Typed
    - arg SyntaxId

` A pattern given to a rule, as the value of the function type the rule's parameter takes:
` the function made of it, or the one that runs the rule it calls alone, with no data. One
` made of a pattern that is given what names hold has as its data the address of memory of
` the frame that holds them, each read here as it is where the pattern is passed.
. nothing = make-operand(.operand-void, 0)
. helper = tables.pattern-argument-of(unit.reading, arg)
. type = facts.node-type(unit.reading, arg)
. layout = layout-of(type, arg)
if helper == no-function || layout != tables.layouts.function-layout
    refuse(.refused-expression, arg)
    = Typed(nothing, no-type)
. target = tables.functions[helper]
. row = facts.pattern-arguments[target.place]
. data = integer(.machine-pointer, 0)
if target.kind == .pattern-helper && row.params.count != 0
    . held = tables.pattern-environment(target.place)
    if held == no-layout
        refuse(.refused-expression, arg)
        = Typed(nothing, no-type)
    . memory = frame(held)
    zero(memory, held)
    for offset in 0 .. < row.params.count
        . position = row.params.start + offset
        . value = slot-value(facts.action-slots[position], arg, facts.action-types[position])
        put(memory, tables.layouts.field(held, offset), value.operand, arg)
    data = address(memory, 0, pointer-layout, arg)
ir.depend(.callee-function, helper, if target.may-panic then may-panic-dependency else 0u32)
. made = frame(layout)
store(made, 0, make-operand(.operand-symbol, target.symbol), false, arg)
store(made, tables.layouts.field(layout, 1).offset, data, false, arg)
= Typed(made, type)

────────────────────
_ do slot-value Typed ?! Refused
    - slot SlotId
    - site SyntaxId
    - type TypeId

` What an argument or a local of the function being emitted holds, read with no name written
` for it, in the type the type pass kept for it: what the function was given for it, where it
` is the function made of a pattern; else as a name read is.
. nothing = make-operand(.operand-void, 0)
if is-bound(slot)
    = read-bound(slot, site, type)
if unit.reading != unit.instance || !is-own-slot(slot) || !owns(slot)
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. kind = bindings.slots[slot].kind
if is-captured(slot)
    = read-captured(slot, site, type)
if kind == .slot-local
    = read-local(slot, site, type)
if kind != .slot-argument
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. position = argument-position(slot)
if instances.argument-type(unit.instance, position) != type
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. cell = unit.cells[slot - unit.slot-start]
if cell != no-local
    = Typed(load-local(cell, site), type)
= Typed(make-operand(.operand-argument, if unit.takes-self then position + 1 else position), type)

────────────────────
_ do rule-argument Operand
    - position U32
    - id SyntaxId

` An argument the rule being emitted was given, for the function of one of its local rules:
` the argument, or in the function made of a pattern, what the function was given for it.
if !given-slots
    = make-operand(.operand-argument, position)
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    if bindings.slots[slot].kind == .slot-argument && owns(slot) && bound-here
        = read-bound(slot, id, instances.argument-type(unit.instance, position)).operand
    .. bound-here = unit.positions[offset] == position && is-bound(slot)
refuse(.refused-expression, id)
= make-operand(.operand-void, 0)

────────────────────
_ do pattern-call StreamPart
    - run StreamRun
    - id SyntaxId
    - value SyntaxId
    - cursor Operand
    - failed IRBlockId

` A call of a pattern given to the rule, `$name` or `\name`: the function the name holds is
` given the rule's stream, the address the items start at, the cursor and the count of items,
` and where to keep where it ended, how far it read and the farthest cursor a part of it
` failed at, which the pattern counts as its own, as a call of a rule is. Where it passed, the
` call gives what it gave and goes on where it ended; where not, the call fails. Only a rule's
` pattern, whose stream is the one the function takes, calls one. A rule typed for a helper
` gives the function the helper too, as every pattern it is given is typed for it, and under
` one that can roll back takes the rollback mark the function gives, as from a rule it calls.
` Last the function is given the data the value holds. In the function of a rule made for a
` pattern that may raise errors, the call takes the pattern's answer or one of them, and an
` error leaves the function with the call.
. result = facts.node-type(unit.reading, id)
. answer-type = facts.answer-type(unit.reading, id)
. row = instances.rows[unit.instance]
if answer-type == no-type || rule-match(program, row.module, row.decl) == 0 || other-stream
    refuse(.refused-expression, id)
    = bare-part(cursor)
.. other-stream = run.stream-type != instances.argument-type(unit.instance, 0)
if row.helper != no-type && streaming.pattern-helper-type != row.helper
    refuse(.refused-expression, id)
    = bare-part(cursor)
calling-pattern = true
. held = held-pattern(value)
calling-pattern = false
if layout-of(held.type, value) != tables.layouts.function-layout
    refuse(.refused-expression, id)
    = bare-part(cursor)
. code = load(held.operand, 0, pointer-layout, id)
. returns = layout-of(if carried-given != no-type then carried-given else answer-type, id)
. ended = ir.add-local(run.index-layout, true, true)
. reached = ir.add-local(run.index-layout, true, true)
. erred = ir.add-local(run.index-layout, true, true)
. mark = pending.length
pending += run.stream
pending += run-data(run, id)
pending += cursor
pending += run-length(run, id)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), ended, pointer-layout)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), reached, pointer-layout)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), erred, pointer-layout)
if row.helper != no-type
    pending += streaming.pattern-helper
. given-mark = no-local
if helper-marks(row.helper)
    if streaming.rollback-mark == no-local
        refuse(.refused-expression, id)
        drop-pending(mark)
        = bare-part(cursor)
    given-mark = ir.add-local(ir.locals[streaming.rollback-mark].layout, true, true)
    pending += make-operand
        - .operand-value
        - append(.op-local-address, id, Span(), given-mark, pointer-layout)
pending += load
    - held.operand
    - tables.layouts.field(tables.layouts.function-layout, 1).offset
    - pointer-layout
    - id
. answer = call(code, id, mark, .callee-value, returns, function.may-panic && !in-landing)
if carried-given != no-type
    . propagated = propagate-held(id, carried-given, answer)
    answer = propagated.operand
    if propagated.type != answer-type
        refuse(.refused-expression, id)
record-call-extent(run, id, load-local(reached, id))
record-error(run, id, load-local(erred, id))
. flag = present(id, Typed(answer, answer-type))
. passed = ir.reserve-block()
branch(flag.operand, passed, failed)
ir.start-block(passed)
take-mark(given-mark, id)
. given = payload(id, Typed(answer, answer-type))
if given.type != result
    refuse(.refused-type, id)
    = bare-part(cursor)
= StreamPart(load-local(ended, id), Typed(given.operand, result))

────────────────────
_ do held-pattern Typed
    - value SyntaxId

` The function a pattern given to a rule is held in, as `$name` names it, or as `\name` calls
` it, where the name is read in the type its function gives it.
do match? tree.nodes[value]
    | .node-stream-call(row)
        . resolution = bindings.resolution-of(instances.rows[unit.reading].binding, value)
        . type = if resolution.kind == .resolve-slot then slot-held-type(value, resolution.slot) else no-type
        if type == no-type
            refuse(.refused-expression, value)
            = Typed(make-operand(.operand-void, 0), no-type)
        . read = emit-identifier(value, row.name, type)
        = Typed(read.operand, type)
= emit-expression(value)

────────────────────
_ do action-call Typed
    - arm SyntaxId
    - result TypeId

` The call of the function the reference runs an action of a stream pattern in, made where the
` arm runs and given what the arm binds that the action reads; its value is converted as the
` arm's would be. The call is checked, which the type pass must have said of the caller too.
` An arm emitted again, as one of a local rule called twice is, calls the one function, where
` the reference makes another: a frame of it differs by its number alone. In an instance that
` raises errors the function answers its value or one of them, and an error leaves the
` function with the call.
. nothing = make-operand(.operand-void, 0)
. helper = tables.stream-action-of(unit.reading, arm)
if helper == no-function || (!function.may-panic && !in-landing)
    refuse(.refused-expression, arm)
    = Typed(nothing, no-type)
. target = tables.functions[helper]
. row = facts.outlined[target.place]
. type = facts.node-type(unit.reading, arm)
. raising = instances.signatures[row.instance].errors.count != 0
if raising && (in-zone || row.result == no-type)
    refuse(.refused-expression, arm)
    = Typed(nothing, no-type)
. returns = layout-of(if raising then row.result else type, arm)
. mark = pending.length
for position in row.params.start .. < row.params.start + row.params.count
    pending += read-bound(facts.action-slots[position], arm, facts.action-types[position]).operand
ir.depend(.callee-function, helper, may-panic-dependency)
if in-zone
    cross-zone(arm, false)
. value = call
    - make-operand(.operand-symbol, target.symbol)
    - arm
    - mark
    - .callee-function
    - returns
    - !in-landing
if in-zone
    cross-zone(arm, true)
if raising
    value = propagate-held(arm, row.result, value).operand
. answer = Typed(value, type)
if type != result
    answer = join(arm, answer)
if answer.type != result
    refuse(.refused-conversion, arm)
= answer

────────────────────
_ do emit-lazy-global

` The function that evaluates a lazy global, which a read calls while the global has no
` value. The runtime gives the global to one task to evaluate, and holds a task that reads it
` from elsewhere meanwhile until it has its value; a read from the task evaluating it is one
` its own value made, and raises a panic. A value that panics leaves the global held so.
. kept = tables.storage[function.place]
. state = make-operand(.operand-symbol, kept.state)
unit = unit.source-module = kept.module
unit = unit.reading = tables.main-instances[kept.module]
do match? program.modules[kept.module].decls[kept.decl]
    | .decl-property(property)
        . syntax = property.syntax
        . ready = ir.reserve-block()
        . unready = ir.reserve-block()
        . busy = ir.reserve-block()
        . evaluate = ir.reserve-block()
        . mark = pending.length
        pending += state
        . claim = call-runtime(.runtime-claim-lazy-global, syntax, mark, i32-layout)
        branch(compare(syntax, .compare-equal, claim, integer(.machine-i32, 1)), ready, unready)
        ir.start-block(ready)
        return-nothing()
        ir.start-block(unready)
        branch(compare(syntax, .compare-equal, claim, integer(.machine-i32, 2)), busy, evaluate)
        ir.start-block(busy)
        raise-text(syntax, "Global '${tables.global-name(kept)}' is read before it is initialized")
        ir.start-block(evaluate)
        store-global(kept, global-value(kept, property).operand, syntax)
        . released = pending.length
        pending += state
        call-runtime(.runtime-release-lazy-global, syntax, released)
return-nothing()

────────────────────
_ do emit-local-global

` The function that stores the value written for a global each task, or each thread, holds
` its own of in the memory of the task or thread running, or binds one `do with` binds to it.
` The main task runs those of tasks before its module's globals take their values;
` `threadinit` runs those of threads as each thread starts.
. kept = tables.storage[function.place]
unit = unit.source-module = kept.module
unit = unit.reading = tables.main-instances[kept.module]
do match? program.modules[kept.module].decls[kept.decl]
    | .decl-property(property)
        . value = global-value(kept, property)
        if function.kind != .stack-local-init
            store-global(kept, value.operand, property.syntax)
        else
            fill-stack(stack-slot(kept, property.syntax), kept, value.operand, property.syntax)
return-nothing()

────────────────────
_ do global-value Typed
    - kept GlobalStorage
    - property PropertyDecl

` The first value of a global: the one written, converted to the global's type as the type
` pass recorded for the declaration, or with none written the value its type has: the empty
` text, an object the type pass constructs at the declaration, an optional with no value, or
` a named tuple or struct: what the constructor the type pass chose at the declaration makes,
` or with no such call its fields with their first values, where it declares no constructor.
` A constructor that takes arguments has no shape here: TypeScript gives it none of the
` defaults they declare.
if property.value == 0
    if types.is-optional(kept.type)
        = absent-argument(property.syntax, kept.type)
    . fact = facts.first-call(unit.reading, property.syntax)
    if fact != no-fact && instances.signatures[facts.calls[fact].callee].args.count != 0
        refuse(.refused-type, property.syntax)
        = Typed(make-operand(.operand-void, 0), no-type)
    if is-aggregate(kept.type) && !is-plain-tuple(kept.type)
        . constructs = fact != no-fact && facts.calls[fact].next == no-fact
        if constructs && facts.calls[fact].form == .call-this-constructor
            = emit-fact-call
                - property.syntax
                - facts.calls[fact]
                - 0
                - RowRange'SyntaxId()
                - 0
                - 0
                - kept.type
        if tables.writes-constructor(kept.type)
            refuse(.refused-type, property.syntax)
            = Typed(make-operand(.operand-void, 0), no-type)
        . made = make-fields
            - kept.type
            - kept.layout
            - RowRange'ArgumentFill()
            - given.length
            - 0
            - property.syntax
        = Typed(made, kept.type)
    = default-value(property.syntax, kept.type, kept.layout, property.syntax)
. value = emit-expression(property.value)
for site in [property.syntax, property.value]
    . fact = facts.first-conversion(unit.reading, site)
    while fact != no-fact && value.type != kept.type
        . row = facts.conversions[fact]
        if row.reason == .reason-declaration && row.from == value.type
            value = convert-one(site, row, value)
        fact = row.next
if value.type != kept.type
    refuse(.refused-conversion, property.syntax)
= value

────────────────────
_ do store-global
    - kept GlobalStorage
    - value Operand
    - syntax SyntaxId

` Stores a value where a global is kept: a managed pointer through the write barrier, and a
` struct by a copy. A value that is nothing is kept nowhere.
if kept.layout == void-layout
    =
. target = global-base(kept, syntax)
if tables.layouts.is-struct(kept.layout)
    copy
        - address(target, global-offset(kept), kept.layout, syntax)
        - value
        - kept.layout
        - tables.layouts.rows[kept.layout].is-managed
        - syntax
else
    store(target, global-offset(kept), value, is-managed-pointer(kept.layout), syntax)

────────────────────
_ do load-global Typed
    - kept GlobalStorage
    - syntax SyntaxId

` The value kept in storage: a struct is read where it is kept, and nothing is read for a
` value that is nothing.
if kept.layout == void-layout
    = Typed(make-operand(.operand-void, 0), kept.type)
. target = global-base(kept, syntax)
if tables.layouts.is-struct(kept.layout)
    = Typed(address(target, global-offset(kept), kept.layout, syntax), kept.type)
= Typed(load(target, global-offset(kept), kept.layout, syntax), kept.type)

────────────────────
_ do global-base Operand
    - kept GlobalStorage
    - syntax SyntaxId

` Where the memory a global is kept in starts: its symbol, or for one each task or each thread
` holds its own of, the memory of the task or thread running.
if kept.offset == U32.max
    = make-operand(.operand-symbol, kept.symbol)
if kept.per-thread
    = call-runtime(.runtime-active-thread-memory, syntax, pending.length, pointer-layout)
= task-locals(syntax)

────────────────────
_ do task-locals Operand
    - site SyntaxId

= make-operand
    - .operand-value
    - append(.op-load-task-word, site, Span(), task-locals-offset, pointer-layout)

────────────────────
_ global-offset U32
    - kept GlobalStorage

if kept.offset == U32.max then 0 else kept.offset

────────────────────
_ do read-global Typed
    - id SyntaxId
    - module ModuleId
    - decl DeclId

` Reads a global from where it is kept. A lazy global that has no value yet is first
` evaluated by its function, which the read calls unless it is in that function. A read the
` type pass planned as checked, of any other global but a constant, raises a panic when the
` global has no value yet. Both read the byte of state beside the global.
. nothing = make-operand(.operand-void, 0)
. row = tables.storage-of(module, decl)
if row == no-storage
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.global-kind(module, decl) == .global-stack
    = read-stack(id, row)
. kept = tables.storage[row]
. is-lazy = tables.global-kind(module, decl) == .global-lazy
. checked = facts.plan-of(unit.reading, id) == .plan-guarded-read && tables.global-kind(module, decl) != .global-constant
if is-lazy && function.kind == .lazy-global && function.place == row
    = load-global(kept, id)
if !is-lazy && !checked
    = load-global(kept, id)
. target = if kept.function != no-function then tables.functions[kept.function] else function
if kept.state == no-string || (is-lazy && kept.function == no-function) || uncaught-panic
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. uncaught-panic = !function.may-panic && !in-landing
. missing = ir.reserve-block()
. ready = ir.reserve-block()
. current = load-acquire(make-operand(.operand-symbol, kept.state), 0, u8-layout, id)
branch(compare(id, .compare-equal, current, integer(.machine-u8, 1)), ready, missing)
ir.start-block(missing)
if is-lazy
    ir.depend(.callee-function, kept.function, may-panic-dependency)
    if in-zone
        cross-zone(id, false)
    call
        - make-operand(.operand-symbol, target.symbol)
        - id
        - pending.length
        - .callee-function
        - void-layout
        - !in-landing
    if in-zone
        cross-zone(id, true)
    jump(ready)
else
    raise-text(id, "Global '${tables.global-name(kept)}' is read before it is initialized")
ir.start-block(ready)
= load-global(kept, id)

────────────────────
_ do emit-initializer
    - declared SyntaxId
    - body SyntaxId

` A constructor as `super(…)` runs it: on the object being made, which it takes before its
` arguments, and it returns nothing.
` 1. The arguments go into their cells.
` 2. The properties the arguments fill are stored again, and so is each whose value reads
`    one that is. Every other property keeps what the constructor that called stored.
` 3. The body runs.
. type = instances.rows[unit.instance].self-type
. signature = instances.signatures[unit.instance]
if !tables.is-class(type) || signature.returns != type
    refuse(.refused-function, declared)
    =
unit = unit.takes-self = true
unit = unit.has-self = true
initializes = true
unit = unit.self = make-operand(.operand-argument, 0)
ir.add-argument(managed-layout)
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
returns-type = types.void-type
ir.returns = void-layout
bind-arguments(declared)
restore-properties(type, declared)
if body != 0
    emit-block(body)
return-nothing()

────────────────────
_ do restore-properties
    - type TypeId
    - declared SyntaxId

` Stores again the properties an initializer's arguments fill, and each property whose
` value reads one stored again, in the order the properties are declared. The rest have
` their values already. A lazy property whose value reads one stored again is stale: what
` it holds, if it was evaluated, was computed from what is replaced. It is evaluated again
` where a value stored again reads it, and is otherwise left as it is.
. range = types.completions[type].properties
filling = filling.type = type
filling = filling.start = range.start
filling = filling.count = range.count
filling = filling.filled = storage.allocate'Byte(range.count + 1)
for position in 0 .. < range.count
    . property = types.properties[range.start + position]
    . refills = property.storage-kind != .storage-getter && has-fill
        .. has-fill = tables.fill-of(unit.instance, property.name) != no-fact
    filling.filled[position] = if refills then 0 else 2
. changed = true
while changed
    changed = false
    for position in 0 .. < range.count
        if filling.filled[position] == 2 && reads-refilled(type, range.start + position)
            . is-lazy = types.properties[range.start + position].storage-kind == .storage-lazy
            filling.filled[position] = if is-lazy then 3 else 0
            changed = true
clear-fills()
clear-checks()
filling = filling.storing = true
for position in 0 .. < range.count
    if filling.filled[position] == 0 || filling.filled[position] == 4
        store-property(position, declared)
filling = filling.storing = false
filling = filling.count = 0

────────────────────
_ do reads-refilled Bool
    - type TypeId
    - place U32

` Whether the value a class writes for a stored or lazy property reads a property that is
` being stored again, or a lazy one that is stale, as the type pass recorded what the value
` reads: by a name the binder resolved to a member, or after the receiver. A value no
` instance typed may read any.
if types.properties[place].storage-kind == .storage-getter
    = false
if tables.default-of(type, place).value == 0
    = false
. unit-id = tables.value-unit(place)
if unit-id == no-instance
    = true
. read = tables.first-read(unit-id)
while read != no-fact
    . found = property-read(type, read)
    if found && filling.filled[(found as U32) - filling.start] != 2
        = true
    read = tables.next-read(read)
= false

────────────────────
_ do store-properties
    - type TypeId
    - declared SyntaxId

` Gives each stored property of the object being made its first value, in the order the
` properties are declared, base first. `filled` says which have theirs: a value that reads
` a property gives that one its value first. The live actions of the values that read
` something tracked are made once all have theirs.
. range = types.completions[type].properties
filling = filling.type = type
filling = filling.start = range.start
filling = filling.count = range.count
filling = filling.filled = storage.allocate'Byte(range.count + 1)
for position in 0 .. < range.count
    filling.filled[position] = 0
clear-fills()
clear-checks()
filling = filling.storing = true
for position in 0 .. < range.count
    store-property(position, declared)
filling = filling.storing = false
subscribe-values(declared)
filling = filling.count = 0

────────────────────
_ do store-property
    - position U32
    - syntax SyntaxId

` Gives one property of the object being made its first value, unless it has it: the
` argument of the property's name, or else the value its class writes for it, or the zero
` of its type. A lazy property is given only an argument of its name. A property whose
` value is being evaluated has no value to read. One whose value the constructor puts off
` holds nothing until the markup of the class has run. One a read gave its value on some paths
` alone is given it where its flag says it has none (`check-property`).
if filling.filled[position] == 4
    check-property(position, syntax)
    filling.filled[position] = if checking != 0 then 4 else 2
    =
if filling.filled[position] == 2
    =
if filling.filled[position] == 1
    refuse(.refused-expression, syntax)
    =
filling.filled[position] = 1
. place = filling.start + position
. property = types.properties[place]
if property.storage-kind == .storage-eager
    . object = tables.layouts.objects[filling.type]
    . field = tables.layouts.field(object, object-header-fields + property.slot)
    . fill = tables.fill-of(unit.instance, property.name)
    if facts.defers(unit.instance, place)
        store-unset(field, property, syntax)
    else if fill == no-fact
        store-default(unit.self, field, property, place, filling.type, syntax)
    else if facts.fills[fill].argument != U32.max
        store-given(field, property, facts.fills[fill].argument, syntax)
    else
        store-fill(unit.self, field, property, place, filling.type, facts.fills[fill], syntax)
else if property.storage-kind == .storage-lazy
    . fill = tables.fill-of(unit.instance, property.name)
    if fill != no-fact && facts.fills[fill].argument != U32.max
        . pair = tables.layouts.field
            - tables.layouts.objects[filling.type]
            - object-header-fields + property.slot
        if !tables.layouts.is-struct(pair.layout)
            refuse(.refused-function, syntax)
        else
            . inner = tables.layouts.field(pair.layout, 0)
            store-given
                - LayoutField(pair.offset + inner.offset, inner.layout)
                - property
                - facts.fills[fill].argument
                - syntax
            store
                - unit.self
                - pair.offset + tables.layouts.field(pair.layout, 1).offset
                - integer(.machine-u8, 1)
                - false
                - syntax
    else if fill != no-fact
        store-lazy-fill(property, facts.fills[fill], syntax)
filling.filled[position] = 2

────────────────────
_ do store-unset
    - field LayoutField
    - property TypeProperty
    - syntax SyntaxId

` Stores in a property of the object being made what the reference holds there before its
` first value: no bits set, but for the empty text wherever a text is held.
. value = if property.type == types.string-type then make-operand(.operand-constant, ir.add-string("")) else integer(tables.layouts.kind-of(field.layout), 0)
if tables.layouts.is-struct(field.layout)
    value = null-value(property.type, field.layout, syntax).operand
if tables.layouts.is-struct(field.layout)
    store-struct(unit.self, field, value, syntax)
else if field.layout != void-layout
    store(unit.self, field.offset, value, is-managed-pointer(field.layout), syntax)

────────────────────
_ do store-given
    - field LayoutField
    - property TypeProperty
    - argument U32
    - syntax SyntaxId

` Stores the value a markup element gives a constructor for a property, which arrives as an
` argument of the property's type: a managed pointer through the write barrier, and a
` struct by a copy.
if instances.argument-type(unit.instance, argument) != property.type
    refuse(.refused-conversion, syntax)
    =
. value = make-operand(.operand-argument, if unit.takes-self then argument + 1 else argument)
if tables.layouts.is-struct(field.layout)
    store-struct(unit.self, field, value, syntax)
else if field.layout != void-layout
    store(unit.self, field.offset, value, is-managed-pointer(field.layout), syntax)

────────────────────
_ do store-stale
    - position U32
    - syntax SyntaxId

` Evaluates a stale lazy property where a value stored again reads it: the value the
` constructor's class writes for it is stored, whatever the object held, and the property
` is marked as having its value.
filling.filled[position] = 1
. place = filling.start + position
. property = types.properties[place]
. pair = tables.layouts.field
    - tables.layouts.objects[filling.type]
    - object-header-fields + property.slot
if !tables.layouts.is-struct(pair.layout)
    refuse(.refused-function, syntax)
    =
. held = tables.layouts.field(pair.layout, 0)
. slot = LayoutField(pair.offset + held.offset, held.layout)
store-default(unit.self, slot, property, place, filling.type, syntax)
store
    - unit.self
    - pair.offset + tables.layouts.field(pair.layout, 1).offset
    - integer(.machine-u8, 1)
    - false
    - syntax
filling.filled[position] = 2

────────────────────
_ do store-lazy-fill
    - property TypeProperty
    - fact FillFact
    - syntax SyntaxId

` Stores the argument a constructor fills a lazy property from, and marks the property as
` having its value. An optional argument, which may leave the property to be evaluated, has
` no shape here. A lazy local of the property's name fills it with its value, evaluated
` here, as it fills a property that is not lazy.
. binding = instances.rows[unit.instance].binding
. kind = if binding == no-binding || !is-own-slot(fact.slot) then SlotKind.slot-local else slot-kind
    .. slot-kind = bindings.slots[fact.slot].kind
. pair = tables.layouts.field
    - tables.layouts.objects[filling.type]
    - object-header-fields + property.slot
if (kind != .slot-argument && kind != .slot-lazy) || !tables.layouts.is-struct(pair.layout)
    refuse(.refused-function, syntax)
    =
. inner = tables.layouts.field(pair.layout, 0)
. field = LayoutField(pair.offset + inner.offset, inner.layout)
. argument = Typed(make-operand(.operand-void, 0), no-type)
if kind == .slot-lazy
    . held = facts.slot-type(unit.instance, slot-offset(fact.slot, syntax))
    argument = Typed(read-lazy-local(fact.slot, syntax, held).operand, held)
else
    . position = argument-position(fact.slot)
    argument = Typed(make-operand(.operand-argument, if unit.takes-self then position + 1 else position), instances.argument-type(unit.instance, position))
    if types.is-optional(argument.type)
        refuse(.refused-function, syntax)
store-converted(unit.self, field, property, fact.site, argument, syntax)
store
    - unit.self
    - pair.offset + tables.layouts.field(pair.layout, 1).offset
    - integer(.machine-u8, 1)
    - false
    - syntax

────────────────────
_ do allocate Operand
    - type TypeId
    - declared SyntaxId

` A new object of a class, with its class table and its id written. The function returns it.
` An `ArrayTokenStream` is carved from the task's parse region where an allocation scope of it
` is open, as TypeScript carves one, and else comes from the collector.
. nothing = make-operand(.operand-void, 0)
. object = no-layout
. table = no-string
if tables.is-class(type)
    object = tables.layouts.objects[type]
    table = tables.table-symbols[type]
if object == no-layout || table == no-string
    refuse(.refused-function, declared)
    = nothing
returns-type = type
ir.returns = managed-layout
. layout = tables.layouts.rows[object]
. size = integer(.machine-u64, layout.size)
. described = if layout.is-managed then descriptor else integer(.machine-pointer, 0)
    .. descriptor = make-operand(.operand-descriptor, object)
. mark = pending.length
pending += size
pending += described
if !same-ref(class-ref(types, type), types.array-token-stream-decl)
    . made = call-runtime(.runtime-allocate-object, declared, mark, managed-layout)
    = stamp-object(made, table, object, declared)
drop-pending(mark)
. depth = make-operand
    - .operand-value
    - append(.op-load-task-word, declared, Span(), parse-region-offset, u64-layout)
. regional = ir.reserve-block()
. collected = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(declared, .compare-not-equal, depth, integer(.machine-u64, 0)), regional, collected)
ir.start-block(collected)
pending += size
pending += described
. made = call-runtime(.runtime-allocate-object, declared, mark, managed-layout)
. from-heap = ir.current
jump(joined)
ir.start-block(regional)
pending += size
pending += described
. carved = call-runtime(.runtime-parse-region-allocate-object, declared, mark, managed-layout)
. from-region = ir.current
jump(joined)
ir.start-block(joined)
= stamp-object(phi(managed-layout, carved, from-region, made, from-heap), table, object, declared)

────────────────────
_ do stamp-object Operand
    - made Operand
    - table StringId
    - object LayoutId
    - declared SyntaxId

` Writes a new object's class table and id, and gives the object.
store(made, 0, make-operand(.operand-symbol, table), false, declared)
. uid = call-runtime(.runtime-generate-uid, declared, pending.length, u32-layout)
store(made, tables.layouts.field(object, 1).offset, uid, false, declared)
= made

────────────────────
_ do store-fill
    - object Operand
    - field LayoutField
    - property TypeProperty
    - place U32
    - owner TypeId
    - fact FillFact
    - syntax SyntaxId

` Stores the argument a constructor fills a property from. An optional argument fills it only
` when it has a value; when it has none the property gets its default. An optional held as a
` pointer has a value where the pointer points at something. A lazy local of the
` property's name fills it with its value, read as any read made while the properties are
` given their values.
. binding = instances.rows[unit.instance].binding
if binding == no-binding || !is-own-slot(fact.slot)
    refuse(.refused-function, syntax)
    =
if bindings.slots[fact.slot].kind == .slot-lazy
    . held = facts.slot-type(unit.instance, slot-offset(fact.slot, syntax))
    . value = read-lazy-local(fact.slot, syntax, held)
    if field.layout != void-layout
        store-converted(object, field, property, fact.site, Typed(value.operand, held), syntax)
    =
if bindings.slots[fact.slot].kind != .slot-argument
    refuse(.refused-function, syntax)
    =
. position = argument-position(fact.slot)
. given = instances.argument-type(unit.instance, position)
. argument = make-operand(.operand-argument, if unit.takes-self then position + 1 else position)
if !types.is-optional(given)
    store-converted(object, field, property, fact.site, Typed(argument, given), syntax)
    =
. layout = layout-of(given, syntax)
. nullable = is-null-form(given)
if !tables.layouts.is-struct(layout) && !nullable
    refuse(.refused-type, syntax)
    =
. present = ir.reserve-block()
. absent = ir.reserve-block()
. stored = ir.reserve-block()
if nullable
    branch
        - compare(syntax, .compare-not-equal, argument, integer(layout as MachineKind, 0))
        - present
        - absent
else
    . flag = tables.layouts.field(layout, 1)
    branch(load(argument, flag.offset, flag.layout, syntax), present, absent)
ir.start-block(absent)
store-default(object, field, property, place, owner, syntax)
jump(stored)
ir.start-block(present)
. value = argument
if !nullable
    . inner = tables.layouts.field(layout, 0)
    if tables.layouts.is-struct(inner.layout)
        value = address(argument, inner.offset, inner.layout, syntax)
    else
        value = load(argument, inner.offset, inner.layout, syntax)
store-converted(object, field, property, fact.site, Typed(value, types.optional-inner(given)), syntax)
jump(stored)
ir.start-block(stored)

────────────────────
_ do store-converted
    - object Operand
    - field LayoutField
    - property TypeProperty
    - site SyntaxId
    - value Typed
    - syntax SyntaxId

` Stores a value in a property, converted to the property's type as the type pass recorded
` where the value is written. A value with no bits is held nowhere, and nothing is stored.
. converted = convert-fill(site, value)
if converted.type != property.type
    refuse(.refused-conversion, syntax)
    =
if tables.layouts.is-struct(field.layout)
    store-struct(object, field, converted.operand, syntax)
else if field.layout != void-layout
    store(object, field.offset, converted.operand, is-managed-pointer(field.layout), syntax)

────────────────────
_ do store-default
    - object Operand
    - field LayoutField
    - property TypeProperty
    - place U32
    - owner TypeId
    - syntax SyntaxId

` Stores a property's first value in an object. `place` is the property's place among all
` properties. A value that reads something tracked, while a constructor gives the values or
` those it put off, runs in a live action of its own, whose trackers are kept to make the
` action with: those made for it where the constructor began, where it was. A value put off is
` stored as an assignment stores it, since the markup that ran before it may already read it.
. unit-id = tables.value-unit(place)
. live = (filling.storing || unit.deferred-type != no-type) && unit-id != no-instance && live-unit
    .. live-unit = instances.rows[unit-id].is-live
. opened = if filling.count != 0 && place >= filling.start && place - filling.start < filling.count then filling.trackers[place - filling.start] else no-local
. trackers = no-local
if live
    trackers = if opened != no-local then opened else open-trackers(syntax)
    live-actions += LiveTrackers(trackers, trackers)
. value = first-value(property, place, owner, field.layout, syntax)
if live
    live-actions.pop()
if unit.deferred-type != no-type
    put-property(object, field, property, value.operand, syntax)
else if tables.layouts.is-struct(field.layout)
    store-struct(object, field, value.operand, syntax)
else if field.layout != void-layout
    store(object, field.offset, value.operand, is-managed-pointer(field.layout), syntax)
if live && (opened == no-local || !keeps-trackers(place))
    place-trackers += LivePlace(place, trackers)

────────────────────
_ do keeps-trackers Bool
    - place U32

` Whether the trackers of a property's own live action are kept (`place-trackers`).
for kept in place-trackers
    if kept.place == place
        = true
= false

────────────────────
_ do store-struct
    - object Operand
    - field LayoutField
    - value Operand
    - syntax SyntaxId

. target = address(object, field.offset, field.layout, syntax)
copy(target, value, field.layout, tables.layouts.rows[field.layout].is-managed, syntax)

────────────────────
_ do emit-tuple-constructor
    - declared SyntaxId

` Writes each argument to its field of a struct: in the memory the caller gave for one too
` large for registers, and else in memory of the frame, which is returned.
. type = instances.rows[unit.instance].self-type
. layout = layout-of(type, declared)
. signature = instances.signatures[unit.instance]
. row = tables.layouts.rows[layout]
if !tables.layouts.is-struct(layout) || signature.args.count != row.fields.count
    refuse(.refused-function, declared)
    =
returns-type = type
ir.returns = layout
. in-place = tables.layouts.is-large(layout)
. made = if in-place then make-operand(.operand-result, 0) else frame(layout)
if in-place && row.is-managed
    zero(made, layout)
for position in 0 .. < signature.args.count
    . field = tables.layouts.field(layout, position)
    . given = layout-of(instances.argument-type(unit.instance, position), declared)
    if given != field.layout
        refuse(.refused-type, declared)
        =
    ir.add-argument(given)
    put(made, field, make-operand(.operand-argument, position), declared)
if in-place
    return-nothing()
else
    return-value(made, declared)

────────────────────
_ do answers-itself Bool
    - callee InstanceId

` Whether a member of a table, or of a view of one, is one TypeScript answers itself where it
` is called: every one but `copy` and `fill`, and none of a row, whose getters run as any
` other. The type pass plans each call of one, so a call left to its body, which only the
` slot of an interface's table runs, has no shape.
. row = instances.rows[callee]
. owner = if row.self-type != no-type then intrinsic(row.self-type) else IntrinsicKind.none
if owner == .table-row || owner == .immutable-table-row
    = false
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        . named = if fn.name then fn.name.text else ""
        = table-member && named != "copy" && named != "fill"
            .. table-member = !fn.is-generated && fn.owner != 0 && row.module == types.table-module
= false

────────────────────
_ do class-site SyntaxId
    - module ModuleId
    - owner DeclId

` Where a class is declared, which is where TypeScript places the code of a function it
` generates for the class.
do match? program.modules[module].decls[owner]
    | .decl-class(class)
        = class.syntax
= 0

────────────────────
_ do emit-table-constructor
    - declared SyntaxId
    - kind DeclKind

` A table's constructor the compiler generates, as TypeScript generates it: one of a size
` makes storage for that many rows, each zero, and one of a size and a filler then fills each
` row in turn with what the filler answers for its index, scattering it into the columns. One
` of an arena, and of a capacity, makes a table that grows in the arena.
if is-index-span-constructor-kind(kind)
    emit-span-constructor(declared, kind)
    =
. type = instances.rows[unit.instance].self-type
. row = table-row-type(type)
. row-kind = if row != no-type then types.intrinsic-of(row) else IntrinsicKind.none
if row-kind != .struct && row-kind != .union
    refuse(.refused-function, declared)
    =
. grows = kind == .table-arena-constructor-decl || kind == .table-capacity-constructor-decl
if kind != .table-size-constructor-decl && kind != .table-filler-constructor-decl && !grows
    refuse(.refused-function, declared)
    =
. layout = layout-of(type, declared)
. row-layout = layout-of(row, declared)
. signature = instances.signatures[unit.instance]
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
if !tables.layouts.is-struct(layout) || !tables.layouts.is-struct(row-layout)
    refuse(.refused-function, declared)
    =
returns-type = type
ir.returns = layout
if row-kind == .union
    emit-union-constructor(declared, kind, layout, row, row-layout)
    =
if grows
    . needed = if kind == .table-capacity-constructor-decl then second else integer(.machine-u64, 0)
        .. second = make-operand(.operand-argument, 1)
    grown-table(declared, layout, row, row-layout, needed)
    =
. size = make-operand(.operand-argument, 0)
. columns = fixed-columns(declared, row-layout, size)
if kind == .table-filler-constructor-decl
    fill-table(declared, row, row-layout, columns, size, make-operand(.operand-argument, 1))
. zero = integer(.machine-u64, 0)
return-table(declared, layout, columns, size, TableMeta(zero, zero, zero, zero, zero))

────────────────────
_ do emit-union-constructor
    - declared SyntaxId
    - kind DeclKind
    - layout LayoutId
    - row TypeId
    - row-layout LayoutId

` A table of union rows, made as TypeScript makes it: one that does not grow has its columns,
` then each row set to the first case's first value, or filled in turn with what the filler
` answers; one that grows is made as a table of structs is, with a column for each region.
. place = tables.unions.of(row)
if place == U32.max
    refuse(.refused-function, declared)
    =
if kind == .table-arena-constructor-decl || kind == .table-capacity-constructor-decl
    . needed = if kind == .table-capacity-constructor-decl then second else integer(.machine-u64, 0)
        .. second = make-operand(.operand-argument, 1)
    grown-table(declared, layout, row, row-layout, needed)
    =
if kind != .table-size-constructor-decl && kind != .table-filler-constructor-decl
    refuse(.refused-function, declared)
    =
. size = make-operand(.operand-argument, 0)
. columns = union-columns(declared, place, size)
if kind == .table-filler-constructor-decl
    fill-table(declared, row, row-layout, columns, size, make-operand(.operand-argument, 1))
else
    clear-union-rows(declared, place, columns, size)
. zero = integer(.machine-u64, 0)
return-table(declared, layout, columns, size, TableMeta(zero, zero, zero, zero, zero))

────────────────────
_ do union-columns Operand
    - site SyntaxId
    - place U32
    - size Operand

` The storage of a table of union rows that does not grow, as TypeScript makes it: the rows
` are checked to keep their outside bytes within what a handle reaches, then a directory, the
` tags, a column for each shared field, the inline bytes, the handles and the outside bytes.
. union = tables.unions.layouts[place]
if union.external-stride != 0
    . most = integer(.machine-u64, (4294967295 / (union.external-stride as U64)))
    fail-if
        - site
        - compare(site, .compare-greater, size, most)
        - "Table union external storage exceeds the U32 handle limit"
. directory = table-buffer(site, managed-layout, integer(.machine-u64, union.columns))
store(directory, 0, table-buffer(site, u8-layout, size), false, site)
. first = types.cases-of(union.union)[0].type
. first-layout = layout-of(first, site)
for position in 0 .. < union.commons.count
    . common = tables.unions.fields[union.commons.start + position]
    . field = tables.layouts.field(first-layout, common.slot)
    store(directory, common.column * 8, table-buffer(site, field.layout, size), false, site)
if union.inline-column != U32.max
    . bytes = arithmetic
        - site
        - .arithmetic-multiply
        - size
        - integer(.machine-u64, union.inline-stride)
        - u64-layout
    store(directory, union.inline-column * 8, table-buffer(site, u8-layout, bytes), false, site)
if union.handle-column != U32.max
    store(directory, union.handle-column * 8, table-buffer(site, u32-layout, size), false, site)
if union.external-column != U32.max
    . bytes = arithmetic
        - site
        - .arithmetic-multiply
        - size
        - integer(.machine-u64, union.external-stride)
        - u64-layout
    store(directory, union.external-column * 8, table-buffer(site, u8-layout, bytes), false, site)
= directory

────────────────────
_ do clear-union-rows
    - site SyntaxId
    - place U32
    - columns Operand
    - size Operand

` Sets each row of a new table of unions, from the first, to the first case's first value, as
` TypeScript sets them to the union's default.
. first = types.cases-of(tables.unions.layouts[place].union)[0].type
. first-layout = layout-of(first, site)
if tables.writes-constructor(first)
    refuse(.refused-type, site)
    =
. counter = ir.add-local(u64-layout)
store-local(counter, integer(.machine-u64, 0), site)
. testing = ir.reserve-block()
. clearing = ir.reserve-block()
. cleared = ir.reserve-block()
jump(testing)
ir.start-block(testing)
branch(compare(site, .compare-less, load-local(counter, site), size), clearing, cleared)
ir.start-block(clearing)
. index = load-local(counter, site)
. empty = make-fields(first, first-layout, RowRange'ArgumentFill(), given.length, 0, site)
scatter-union-case(site, place, 0, columns, index, empty, no-meta(), false)
store-local
    - counter
    - arithmetic(site, .arithmetic-add, index, integer(.machine-u64, 1), u64-layout)
    - site
jump(testing)
ir.start-block(cleared)

────────────────────
_ do union-cell Operand
    - site SyntaxId
    - place U32
    - columns Operand
    - index Operand
    - field UnionField
    - item LayoutId
    - handle Operand

` Where a row of a table of unions keeps a field of a case: in its shared field's column, among
` the row's inline bytes, or among the outside bytes its handle leads to.
. union = tables.unions.layouts[place]
if field.region == .region-common
    = table-cell(site, columns, index, field.column, item)
if field.region == .region-inline
    . inline = load(columns, union.inline-column * 8, pointer-layout, site)
    . row = arithmetic
        - site
        - .arithmetic-multiply
        - index
        - integer(.machine-u64, union.inline-stride)
        - u64-layout
    = moved-bytes
        - site
        - inline
        - arithmetic(site, .arithmetic-add, row, integer(.machine-u64, field.offset), u64-layout)
. outside = load(columns, union.external-column * 8, pointer-layout, site)
. start = arithmetic
    - site
    - .arithmetic-subtract
    - num-cast(site, handle, u32-layout, u64-layout)
    - integer(.machine-u64, 1)
    - u64-layout
= moved-bytes
    - site
    - outside
    - arithmetic(site, .arithmetic-add, start, integer(.machine-u64, field.offset), u64-layout)

────────────────────
_ do union-handle Operand
    - site SyntaxId
    - place U32
    - columns Operand
    - index Operand

` The handle a row of a table of unions keeps for its outside bytes.
. union = tables.unions.layouts[place]
= load(table-cell(site, columns, index, union.handle-column, u32-layout), 0, u32-layout, site)

────────────────────
_ do scatter-union-case
    - site SyntaxId
    - place U32
    - case-index U32
    - columns Operand
    - index Operand
    - payload Operand
    - meta TableMeta
    - checked Bool

` Stores a row of one case in a table of unions, as TypeScript scatters it: the row's handle
` first, where the table keeps one, then each field of the case in the order it declares them,
` and the tag last. `checked` says the table's metadata is given: where the table grows, the
` handle is to the case's outside bytes reserved in its spill, the columns are read again from
` its header, and the fields are stored plainly.
. union = tables.unions.layouts[place]
. held = tables.unions.cases[union.cases.start + case-index]
. case-layout = layout-of(held.type, site)
. handle = integer(.machine-u32, 0)
if union.handle-column != U32.max
    if held.external-size != 0
        handle = case-handle(site, place, case-index, index, meta, checked)
    store(table-cell(site, columns, index, union.handle-column, u32-layout), 0, handle, false, site)
. into = if checked then growing-columns(site, columns, meta) else columns
for position in 0 .. < held.fields.count
    . field = tables.unions.fields[held.fields.start + position]
    . stored = tables.layouts.field(case-layout, field.slot)
    . cell = union-cell(site, place, into, index, field, stored.layout, handle)
    if checked
        store-row-cell(site, cell, stored.layout, take(payload, stored, site), meta)
    else
        store-cell(site, cell, stored.layout, take(payload, stored, site))
store(table-cell(site, into, index, 0, u8-layout), 0, integer(.machine-u8, case-index), false, site)

────────────────────
_ do case-handle Operand
    - site SyntaxId
    - place U32
    - case-index U32
    - index Operand
    - meta TableMeta
    - checked Bool

` The handle of the outside bytes of a row of a case: one past the row's place among them where
` the table does not grow, and one past the bytes reserved in its spill where it grows.
. union = tables.unions.layouts[place]
if !checked
    = fixed-handle(site, union, index)
. spilling = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), spilling, fixed)
ir.start-block(spilling)
. reserved = reserve-spill(site, place, case-index, meta)
. spilled = arithmetic
    - site
    - .arithmetic-add
    - num-cast(site, reserved, u64-layout, u32-layout)
    - integer(.machine-u32, 1)
    - u32-layout
. from-spilling = ir.current
jump(joined)
ir.start-block(fixed)
. placed = fixed-handle(site, union, index)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
= phi(u32-layout, spilled, from-spilling, placed, from-fixed)

────────────────────
_ do fixed-handle Operand
    - site SyntaxId
    - union UnionLayout
    - index Operand

` The handle of a row's outside bytes in a table that does not grow: one past its place.
. offset = arithmetic
    - site
    - .arithmetic-multiply
    - index
    - integer(.machine-u64, union.external-stride)
    - u64-layout
= arithmetic
    - site
    - .arithmetic-add
    - num-cast(site, offset, u64-layout, u32-layout)
    - integer(.machine-u32, 1)
    - u32-layout

────────────────────
_ do reserve-spill Operand
    - site SyntaxId
    - place U32
    - case-index U32
    - meta TableMeta

` Reserves a case's outside bytes in the spill of a table of unions that grows, as TypeScript
` does: the table is checked as a view, the spill's use aligned to the case and checked to stay
` within what a U32 handle reaches, the spill grown where it is full, and its use counted on.
` The spill is grown by the function the tables declared to, as `grow-outside` says, and where
` they declared none, here. The answer is where the bytes start.
. union = tables.unions.layouts[place]
. held = tables.unions.cases[union.cases.start + case-index]
. limit = 4294967295u64
. alignment = held.external-alignment as U64
. padding = alignment - 1
. text = "Table union spill exceeds the U32 handle limit"
validate-table(site, meta, "Table union spill", false)
. used = header-word(site, meta.header, 6)
fail-if(site, compare(site, .compare-greater, used, integer(.machine-u64, limit - padding)), text)
. aligned = used
if alignment > 1
    . raised = arithmetic(site, .arithmetic-add, used, integer(.machine-u64, padding), u64-layout)
    . counted = arithmetic
        - site
        - .arithmetic-divide
        - raised
        - integer(.machine-u64, alignment)
        - u64-layout
    aligned = arithmetic
        - site
        - .arithmetic-multiply
        - counted
        - integer(.machine-u64, alignment)
        - u64-layout
fail-if
    - site
    - compare
        - site
        - .compare-greater
        - aligned
        - integer(.machine-u64, limit - (held.external-size as U64))
    - text
. needed = arithmetic
    - site
    - .arithmetic-add
    - aligned
    - integer(.machine-u64, held.external-size)
    - u64-layout
. capacity = header-word(site, meta.header, 7)
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-greater, needed, capacity), growing, joined)
ir.start-block(growing)
. helper = tables.growth-of(union.union, 1)
if cold || helper == no-function
    grow-spill(site, union, meta, used, capacity, needed)
else
    grow-outside(site, helper, meta, used, capacity, needed)
jump(joined)
ir.start-block(joined)
put-header(site, meta.header, 6, needed)
= aligned

────────────────────
_ do grow-spill
    - site SyntaxId
    - union UnionLayout
    - meta TableMeta
    - used Operand
    - capacity Operand
    - needed Operand

` Grows the spill of a table of unions, as TypeScript's generated growth does: the capacity
` doubles as a table's of one-byte rows does, to at least 64 bytes and within what a U32
` handle reaches; the bytes are reserved in the arena and those used copied over, and the
` directory's slot of the outside bytes and the header are given the new spill.
. text = "Table union spill exceeds the U32 handle limit"
. chosen = next-capacity(site, capacity, needed, 8, "Table capacity overflow")
. least = integer(.machine-u64, 64)
. next = at-least(site, chosen, least)
fail-if(site, compare(site, .compare-greater, next, integer(.machine-u64, 4294967295)), text)
. owner = num-cast(site, meta.owner, u64-layout, pointer-layout)
. replacement = arena-reserve(site, owner, meta.incarnation, next, union.external-alignment, false)
fail-if
    - site
    - compare(site, .compare-equal, replacement, integer(.machine-pointer, 0))
    - "Arena allocation failed while growing Table union spill"
. copying = ir.reserve-block()
. copied = ir.reserve-block()
branch(compare(site, .compare-greater, used, integer(.machine-u64, 0)), copying, copied)
ir.start-block(copying)
. prior = num-cast(site, header-word(site, meta.header, 5), u64-layout, pointer-layout)
copy-bytes(site, replacement, prior, used)
jump(copied)
ir.start-block(copied)
. columns = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
store(columns, union.external-column * 8, replacement, false, site)
put-header(site, meta.header, 5, num-cast(site, replacement, pointer-layout, u64-layout))
put-header(site, meta.header, 7, next)

────────────────────
_ do at-least Operand
    - site SyntaxId
    - value Operand
    - least Operand

` A count raised to a least one where it is less.
. raising = ir.reserve-block()
. keeping = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-less, value, least), raising, keeping)
ir.start-block(raising)
jump(joined)
ir.start-block(keeping)
jump(joined)
ir.start-block(joined)
= phi(u64-layout, least, raising, value, keeping)

────────────────────
_ do no-meta TableMeta

` The metadata of a table that does not grow.
. zero = integer(.machine-u64, 0)
= TableMeta(zero, zero, zero, zero, zero)

────────────────────
_ do growing-columns Operand
    - site SyntaxId
    - columns Operand
    - meta TableMeta

` A table's columns read again from its header where it grows, as TypeScript reads them after
` a store that may grow it.
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, fixed)
ir.start-block(growing)
. held = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
= phi(pointer-layout, held, from-growing, columns, from-fixed)

────────────────────
_ do scatter-union
    - site SyntaxId
    - place U32
    - columns Operand
    - index Operand
    - value Operand
    - meta TableMeta
    - checked Bool

` Stores a union in a row of a table of unions: the case it holds, each case tested in turn.
. union = tables.unions.layouts[place]
. union-layout = layout-of(union.union, site)
. tag = load(value, 0, u8-layout, site)
. done = ir.reserve-block()
for position in 0 .. < union.cases.count
    . storing = ir.reserve-block()
    . next = ir.reserve-block()
    branch(compare(site, .compare-equal, tag, integer(.machine-u8, position)), storing, next)
    ir.start-block(storing)
    scatter-union-case
        - site
        - place
        - position
        - columns
        - index
        - take(value, tables.layouts.case-field(union-layout, position), site)
        - meta
        - checked
    jump(done)
    ir.start-block(next)
jump(done)
ir.start-block(done)

────────────────────
_ do gather-union Typed
    - site SyntaxId
    - place U32
    - columns Operand
    - index Operand

` A row of a table of unions read as the union, as TypeScript gathers it: the case the tag
` names, built from its fields; a tag that names no case gives the first case's first value.
. union = tables.unions.layouts[place]
. union-layout = layout-of(union.union, site)
. made = frame(union-layout)
. tag = load(table-cell(site, columns, index, 0, u8-layout), 0, u8-layout, site)
. done = ir.reserve-block()
for position in 0 .. < union.cases.count
    . reading = ir.reserve-block()
    . next = ir.reserve-block()
    branch(compare(site, .compare-equal, tag, integer(.machine-u8, position)), reading, next)
    ir.start-block(reading)
    . read = gather-union-case(site, place, position, columns, index)
    copy(made, make-union(site, union.union, position, read).operand, union-layout, false, site)
    jump(done)
    ir.start-block(next)
. first = types.cases-of(union.union)[0].type
. first-layout = layout-of(first, site)
if tables.writes-constructor(first)
    refuse(.refused-type, site)
    = Typed(columns, no-type)
. empty = make-fields(first, first-layout, RowRange'ArgumentFill(), given.length, 0, site)
copy(made, make-union(site, union.union, 0, Typed(empty, first)).operand, union-layout, false, site)
jump(done)
ir.start-block(done)
= Typed(made, union.union)

────────────────────
_ do gather-union-case Typed
    - site SyntaxId
    - place U32
    - case-index U32
    - columns Operand
    - index Operand

` A row of one case of a table of unions read as the case: each field from where it is kept.
. union = tables.unions.layouts[place]
. held = tables.unions.cases[union.cases.start + case-index]
. case-layout = layout-of(held.type, site)
. handle = if union.handle-column != U32.max then union-handle(site, place, columns, index) else integer(.machine-u32, 0)
. made = frame(case-layout)
for position in 0 .. < held.fields.count
    . field = tables.unions.fields[held.fields.start + position]
    . stored = tables.layouts.field(case-layout, field.slot)
    . cell = union-cell(site, place, columns, index, field, stored.layout, handle)
    put(made, stored, take(cell, LayoutField(0, stored.layout, stored.type), site), site)
= Typed(made, held.type)

────────────────────
_ do emit-span-constructor
    - declared SyntaxId
    - kind DeclKind

` The constructor the compiler generates of an index span, as TypeScript generates it: the
` span of the whole of its source, or of the range it is given, made forward.
. type = instances.rows[unit.instance].self-type
. layout = layout-of(type, declared)
. signature = instances.signatures[unit.instance]
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
if !tables.layouts.is-struct(layout)
    refuse(.refused-function, declared)
    =
returns-type = type
ir.returns = layout
. ranged = kind == .index-span-range-constructor-decl
. range = if ranged then make-operand(.operand-argument, 1) else make-operand(.operand-void, 0)
. range-type = if ranged then instances.argument-type(unit.instance, 1) else no-type
. in-place = tables.layouts.is-large(layout)
. made = if in-place then make-operand(.operand-result, 0) else frame(layout)
span-into
    - declared
    - made
    - type
    - layout
    - make-operand(.operand-argument, 0)
    - instances.argument-type(unit.instance, 0)
    - range
    - range-type
if in-place
    return-nothing()
else
    return-value(made, declared)

────────────────────
_ do span-into
    - site SyntaxId
    - made Operand
    - type TypeId
    - layout LayoutId
    - source Operand
    - source-type TypeId
    - range Operand
    - range-type TypeId

` An index span made of its source, as TypeScript makes one: of an array, where its items lie,
` from the first the range spans, or the first, for as many as the range spans, or the array
` holds; of an arena's builder, the identity of the builder's storage in place of where the
` items lie, with its mutation generation and its arena's owner, incarnation and generation,
` which say whether the span can still be read. A range is made forward where the
` constructor runs.
. item = viewed-item(type)
. item-layout = layout-of(item, site)
. source-layout = layout-of(source-type, site)
if viewed-item(source-type) != item
    refuse(.refused-expression, site)
    =
. width = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. zero = integer(.machine-u64, 0)
. words [Operand]
if is-array-type(source-type)
    . data = word-at(site, source, source-layout, 0)
    . length = word-at(site, source, source-layout, 1)
    . bounds = given-bounds(site, range, range-type, length)
    words = [data, zero, bounds.start, bounds.length, width, zero, zero, zero, zero]
else if intrinsic(source-type) == .array-builder
    . state = builder-state(site, source, source-layout)
    . bounds = given-bounds(site, range, range-type, state.size)
    . mark = pending.length
    pending += num-cast(site, state.owner, u64-layout, pointer-layout)
    pending += state.incarnation
    . generation = call-runtime(.runtime-arena-generation, site, mark, u64-layout)
    words = [zero, state.identity, bounds.start, bounds.length, width, state.mutation, state.owner, state.incarnation, generation]
else
    refuse(.refused-expression, site)
    =
for position in 0 .. < words.length
    put-word(site, made, layout, position as U32, words[position], u64-layout)

────────────────────
_ do builder-state BuilderState
    - site SyntaxId
    - builder Operand
    - layout LayoutId

` What an index span reads of an arena's builder, as TypeScript reads it: the builder holds
` the header its copies share, which is the identity of its storage and holds the storage, its
` capacity, the size and the mutation generation; the builder's context is its arena.
. identity = word-at(site, builder, layout, 0)
. held = num-cast(site, identity, u64-layout, pointer-layout)
. size = load(held, 16, u64-layout, site)
. mutation = load(held, 24, u64-layout, site)
. arena-layout = tables.layouts.field(layout, 1).layout
. arena = part(builder, layout, 1, site)
= BuilderState
    - identity
    - size
    - mutation
    - word-at(site, arena.operand, arena-layout, 0)
    - word-at(site, arena.operand, arena-layout, 1)

────────────────────
_ do given-bounds TableBounds
    - site SyntaxId
    - range Operand
    - range-type TypeId
    - length Operand

` The indices an index span's constructor spans: those its range spans, made forward by the
` call recorded for the constructor, or else every one of the source's.
if range-type == no-type
    = TableBounds(integer(.machine-u64, 0), length)
. none = make-operand(.operand-void, 0)
. fact = tables.loose-call(unit.instance, 0)
if fact == no-fact || facts.calls[fact].callee == no-instance || uncallable
    refuse(.refused-function, site)
    = TableBounds(none, none)
.. uncallable = !is-callable(facts.calls[fact].callee)
. mark = pending.length
pending += range
. forward = call-method(facts.calls[fact].callee, site, mark)
= checked-bounds(site, forward.operand, forward.type, length)

────────────────────
_ do checked-bounds TableBounds
    - site SyntaxId
    - forward Operand
    - forward-type TypeId
    - length Operand

` The indices a range made forward spans of an index span's, as TypeScript checks them: the
` range steps by one, and starts and ends inside the length, its end not before its start.
. none = make-operand(.operand-void, 0)
. layout = layout-of(forward-type, site)
. start = range-index(site, forward, forward-type, layout, "start")
. end = range-index(site, forward, forward-type, layout, "end")
. increment = range-index(site, forward, forward-type, layout, "increment")
. outside = "IndexSpan range is out of bounds"
fail-if
    - site
    - compare(site, .compare-not-equal, increment.operand, integer(.machine-u64, 1))
    - "IndexSpan requires a contiguous range"
fail-if(site, compare(site, .compare-greater, start.operand, length), outside)
fail-if(site, compare(site, .compare-greater, end.operand, length), outside)
fail-if(site, compare(site, .compare-less, end.operand, start.operand), outside)
= TableBounds(start.operand, arithmetic(site, .arithmetic-subtract, end.operand, start.operand, u64-layout))

────────────────────
_ do resolve-span ResolvedSpan
    - site SyntaxId
    - span Operand
    - layout LayoutId

` Where the indices an index span reads lie, as TypeScript finds them: an array's, where the
` span holds them; a builder's, once the span is checked to read it still, as its storage
` holds them now. The arena must not be reset, nor rewound past the storage, and the builder
` neither changed nor shrunk past the span since the span was made.
. source = word-at(site, span, layout, 0)
. identity = word-at(site, span, layout, 1)
. offset = word-at(site, span, layout, 2)
. length = word-at(site, span, layout, 3)
. built = ir.reserve-block()
. plain = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-not-equal, identity, integer(.machine-u64, 0)), built, plain)
ir.start-block(built)
. owner = num-cast(site, word-at(site, span, layout, 6), u64-layout, pointer-layout)
. incarnation = word-at(site, span, layout, 7)
. mark = pending.length
pending += owner
pending += incarnation
. current = call-runtime(.runtime-arena-generation, site, mark, u64-layout)
fail-if
    - site
    - compare(site, .compare-not-equal, current, word-at(site, span, layout, 8))
    - "IndexSpan is stale after Arena reset"
. rewound = "IndexSpan was invalidated by Arena rewind"
. held = num-cast(site, identity, u64-layout, pointer-layout)
fail-if
    - site
    - compare
        - site
        - .compare-equal
        - arena-owns(site, owner, incarnation, held)
        - integer(.machine-u8, 0)
    - rewound
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - load(held, 24, u64-layout, site)
        - word-at(site, span, layout, 5)
    - "IndexSpan was invalidated by ArrayBuilder mutation"
. size = load(held, 16, u64-layout, site)
. shrunk = "IndexSpan was invalidated by ArrayBuilder shrink"
fail-if(site, compare(site, .compare-greater, offset, size), shrunk)
fail-if
    - site
    - compare
        - site
        - .compare-greater
        - length
        - arithmetic(site, .arithmetic-subtract, size, offset, u64-layout)
    - shrunk
. data = load(held, 0, u64-layout, site)
. owning = ir.reserve-block()
. owned = ir.reserve-block()
branch(compare(site, .compare-not-equal, size, integer(.machine-u64, 0)), owning, owned)
ir.start-block(owning)
. pointer = num-cast(site, data, u64-layout, pointer-layout)
fail-if
    - site
    - compare
        - site
        - .compare-equal
        - arena-owns(site, owner, incarnation, pointer)
        - integer(.machine-u8, 0)
    - rewound
jump(owned)
ir.start-block(owned)
. from-built = ir.current
jump(joined)
ir.start-block(plain)
jump(joined)
ir.start-block(joined)
= ResolvedSpan(phi(u64-layout, data, from-built, source, plain), offset)

────────────────────
_ do arena-owns Operand
    - site SyntaxId
    - owner Operand
    - incarnation Operand
    - address Operand

` Whether an arena holds an address in what it has reserved.
. mark = pending.length
pending += owner
pending += incarnation
pending += address
= call-runtime(.runtime-arena-owns, site, mark, u8-layout)

────────────────────
_ do span-item Operand
    - site SyntaxId
    - resolved ResolvedSpan
    - position Operand
    - item LayoutId

` The index an index span reads at a position, where its indices lie.
. data = num-cast(site, resolved.data, u64-layout, pointer-layout)
. moved = arithmetic(site, .arithmetic-add, resolved.offset, position, u64-layout)
= load(item-cell(site, data, moved, item), 0, item, site)

────────────────────
_ do selected-index Operand
    - site SyntaxId
    - resolved ResolvedSpan
    - position Operand
    - item TypeId
    - item-layout LayoutId

` The index of a table's row a selection reads at a position, as TypeScript reads it: one of
` a signed type below zero is out of bounds.
. value = span-item(site, resolved, position, item-layout)
if is-signed-item(item)
    fail-if
        - site
        - compare(site, .compare-less, value, integer(tables.layouts.rows[item-layout].kind, 0))
        - "TableSelection index is out of bounds"
= num-cast(site, value, item-layout, u64-layout)

────────────────────
_ is-signed-item Bool
    - item TypeId

` Whether the indices of a span are of a signed type.
kind == .int8 || kind == .int16 || kind == .int32 || kind == .int64

.. kind = types.intrinsic-of(item)

────────────────────
_ do return-table
    - site SyntaxId
    - layout LayoutId
    - columns Operand
    - size Operand
    - meta TableMeta

` Answers a table made by its constructor: its columns, its size, and its header, owner,
` incarnation and generation, each zero for a table that does not grow.
. in-place = tables.layouts.is-large(layout)
. made = if in-place then make-operand(.operand-result, 0) else frame(layout)
put(made, tables.layouts.field(layout, 0), columns, site)
put(made, tables.layouts.field(layout, 1), size, site)
put(made, tables.layouts.field(layout, 2), meta.header, site)
put(made, tables.layouts.field(layout, 3), meta.owner, site)
put(made, tables.layouts.field(layout, 4), meta.incarnation, site)
put(made, tables.layouts.field(layout, 5), meta.generation, site)
if in-place
    return-nothing()
else
    return-value(made, site)

────────────────────
_ do grown-table
    - site SyntaxId
    - layout LayoutId
    - row TypeId
    - row-layout LayoutId
    - needed Operand

` The body of the constructor of a table that grows in an arena, as TypeScript writes it: the
` header is reserved in the arena, zeroed, then the directory of its columns, one slot for each
` column; the arena's generation is read, the header given the directory, and room reserved for
` the rows the capacity asks for. The table holds the directory, a size of zero, the header,
` and the arena's owner, incarnation and generation.
. arena-type = instances.argument-type(unit.instance, 0)
. arena = make-operand(.operand-argument, 0)
. arena-layout = layout-of(arena-type, site)
. owner = part(arena, arena-layout, 0, site)
. incarnation = part(arena, arena-layout, 1, site)
. header = arena-reserve(site, owner.operand, incarnation.operand, integer(.machine-u64, 64), 8, true)
fail-if
    - site
    - compare(site, .compare-equal, header, integer(.machine-pointer, 0))
    - "Arena allocation failed while creating Table header"
. count = directory-slots(row, row-layout)
. slots U64 = if count != 0 then count as U64 else 1
. directory = arena-reserve(site, owner.operand, incarnation.operand, integer(.machine-u64, slots * 8), 8, true)
fail-if
    - site
    - compare(site, .compare-equal, directory, integer(.machine-pointer, 0))
    - "Arena allocation failed while creating Table directory"
. mark = pending.length
pending += owner.operand
pending += incarnation.operand
. generation = call-runtime(.runtime-arena-generation, site, mark, u64-layout)
store(header, 0, directory, false, site)
for position in 1 .. < 8u32
    store(header, position * 8, integer(.machine-u64, 0), false, site)
. held = num-cast(site, header, pointer-layout, u64-layout)
. handle = word-at(site, arena, arena-layout, 0)
reserve-rows
    - site
    - row
    - row-layout
    - TableMeta(held, handle, incarnation.operand, generation, integer(.machine-u64, 0))
    - needed
. columns = num-cast(site, directory, pointer-layout, managed-layout)
return-table
    - site
    - layout
    - columns
    - integer(.machine-u64, 0)
    - TableMeta(held, handle, incarnation.operand, generation, integer(.machine-u64, 0))

────────────────────
_ do arena-reserve Operand
    - site SyntaxId
    - owner Operand
    - incarnation Operand
    - bytes Operand
    - alignment U64
    - zeroed Bool

` Reserves bytes in an arena, zeroed or not, as TypeScript reserves a table's storage: the
` address reserved, or null where the arena is gone or out of room.
. mark = pending.length
pending += owner
pending += incarnation
pending += bytes
pending += integer(.machine-u64, alignment)
pending += integer(.machine-u8, if zeroed then 1 else 0)
= call-runtime(.runtime-arena-reserve, site, mark, pointer-layout)

────────────────────
_ do reserve-rows
    - site SyntaxId
    - row TypeId
    - row-layout LayoutId
    - meta TableMeta
    - needed Operand

` Makes room in a table that grows for as many rows as are needed, where its capacity is less:
` by the function the tables declared to grow such rows, as `grow-outside` says, and where
` they declared none, here.
. header = num-cast(site, meta.header, u64-layout, pointer-layout)
. current = load(header, 16, u64-layout, site)
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-greater, needed, current), growing, joined)
ir.start-block(growing)
. helper = tables.growth-of(row, 0)
if cold || helper == no-function
    grow-rows(site, row, row-layout, meta, current, needed)
else
    grow-outside(site, helper, meta, current, needed, make-operand(.operand-void, 0))
jump(joined)
ir.start-block(joined)

────────────────────
_ do grow-rows
    - site SyntaxId
    - row TypeId
    - row-layout LayoutId
    - meta TableMeta
    - current Operand
    - needed Operand

` Grows a table's storage in its arena, as TypeScript's generated growth does: the capacity
` is chosen, each region reserved again in turn with its rows copied over, then a new
` directory reserved and given each region, and the slot of a union's outside bytes as it
` was; the header is given the directory and the capacity. What was reserved before stays in
` the arena.
. regions = grow-regions(site, row, row-layout)
. width U64
for region in regions
    width += region.stride as U64
if width == 0
    width = 1
. first U64 = if width == 1 then 8 else if width <= 1024 then 4 else 1
. next = next-capacity(site, current, needed, first, "Table capacity overflow")
. header = num-cast(site, meta.header, u64-layout, pointer-layout)
. owner = num-cast(site, meta.owner, u64-layout, pointer-layout)
. columns = num-cast(site, load(header, 0, u64-layout, site), u64-layout, pointer-layout)
. live = load(header, 8, u64-layout, site)
. replacements [Operand]
for region in regions
    . context = "Table ${region.name}"
    . bytes = checked-bytes(site, next, region.stride, context)
    . replacement = arena-reserve(site, owner, meta.incarnation, bytes, region.alignment, false)
    fail-if
        - site
        - compare(site, .compare-equal, replacement, integer(.machine-pointer, 0))
        - "Arena allocation failed while growing Table"
    . prior = load(columns, region.column * 8, pointer-layout, site)
    . copied = checked-bytes(site, live, region.stride, context)
    . copying = ir.reserve-block()
    . joined = ir.reserve-block()
    branch(compare(site, .compare-greater, copied, integer(.machine-u64, 0)), copying, joined)
    ir.start-block(copying)
    copy-bytes(site, replacement, prior, copied)
    jump(joined)
    ir.start-block(joined)
    replacements += replacement
. count = directory-slots(row, row-layout)
. slots U64 = if count != 0 then count as U64 else 1
. directory = arena-reserve
    - site
    - owner
    - meta.incarnation
    - integer(.machine-u64, slots * 8)
    - 8
    - true
fail-if
    - site
    - compare(site, .compare-equal, directory, integer(.machine-pointer, 0))
    - "Arena allocation failed while growing Table directory"
for slot in 0 .. < count
    . kept = make-operand(.operand-void, 0)
    . found = false
    for position in 0 .. < regions.length
        if regions[position].column == slot
            kept = replacements[position]
            found = true
    if !found
        kept = load(columns, slot * 8, pointer-layout, site)
    store(directory, slot * 8, kept, false, site)
store(header, 0, directory, false, site)
store(header, 16, next, false, site)

────────────────────
_ do grow-regions [GrowRegion]
    - site SyntaxId
    - row TypeId
    - row-layout LayoutId

` The regions of a growing table's storage, as TypeScript lists them: a column for each field
` of a struct row; for a union row the tag, each shared field, the inline bytes and the
` handles of the outside bytes.
. regions [GrowRegion]
. place = if types.intrinsic-of(row) == .union then tables.unions.of(row) else U32.max
if place == U32.max
    for position in 0 .. < tables.layouts.rows[row-layout].fields.count
        . item = tables.layouts.rows[tables.layouts.field(row-layout, position).layout]
        regions += GrowRegion(position, item.size, item.alignment, region-name(row, position))
    = regions
. union = tables.unions.layouts[place]
regions += GrowRegion(0, 1, 1, "tag")
. first = types.cases-of(row)[0].type
. first-layout = layout-of(first, site)
for position in 0 .. < union.commons.count
    . common = tables.unions.fields[union.commons.start + position]
    . item = tables.layouts.rows[tables.layouts.field(first-layout, common.slot).layout]
    regions += GrowRegion
        - common.column
        - item.size
        - item.alignment
        - "common ${region-name(first, common.slot)}"
if union.inline-column != U32.max
    regions += GrowRegion
        - union.inline-column
        - union.inline-stride
        - union.inline-alignment
        - "inline"
if union.handle-column != U32.max
    regions += GrowRegion(union.handle-column, 4, 4, "spill-handles")
= regions

────────────────────
_ directory-slots U32
    - row TypeId
    - row-layout LayoutId

` How many slots the directory of a table's columns has: one for each field of a struct row,
` and for a union row one for each column and one for its outside bytes.
|? types.intrinsic-of(row) == .union && tables.unions.of(row) != U32.max
    tables.unions.layouts[tables.unions.of(row)].columns
??
    tables.layouts.rows[row-layout].fields.count

────────────────────
_ do region-name String
    - row TypeId
    - position U32

` The name of a field of a row at its place in the row's layout, as TypeScript names the
` region of a table's storage that holds its column.
for property in types.properties-of(row)
    if property.slot == position
        = property.name.text
= "field $position"

────────────────────
_ do checked-bytes Operand
    - site SyntaxId
    - count Operand
    - stride U64
    - context String

` How many bytes a count of items of a size takes, checked first not to overflow.
. most = integer(.machine-u64, U64.max / stride)
fail-if(site, compare(site, .compare-greater, count, most), "$context capacity overflow")
= arithmetic(site, .arithmetic-multiply, count, integer(.machine-u64, stride), u64-layout)

────────────────────
_ do next-capacity Operand
    - site SyntaxId
    - current Operand
    - needed Operand
    - first U64
    - overflow String

` The capacity a table or an arena's builder grows to, as TypeScript chooses it: from none, the
` first capacity; under 1024, twice as many; and else half as many again, with the panic of an
` overflow. It is never less than is needed.
. most = integer(.machine-u64, U64.max)
. empty = ir.reserve-block()
. held = ir.reserve-block()
. small = ir.reserve-block()
. large = ir.reserve-block()
. grew = ir.reserve-block()
. chosen = ir.reserve-block()
branch(compare(site, .compare-equal, current, integer(.machine-u64, 0)), empty, held)
ir.start-block(empty)
jump(chosen)
ir.start-block(held)
branch(compare(site, .compare-less, current, integer(.machine-u64, 1024)), small, large)
ir.start-block(small)
fail-if
    - site
    - compare(site, .compare-greater, current, integer(.machine-u64, U64.max / 2))
    - overflow
. doubled = arithmetic(site, .arithmetic-multiply, current, integer(.machine-u64, 2), u64-layout)
. from-small = ir.current
jump(grew)
ir.start-block(large)
. half = arithmetic(site, .arithmetic-divide, current, integer(.machine-u64, 2), u64-layout)
fail-if
    - site
    - compare
        - site
        - .compare-greater
        - current
        - arithmetic(site, .arithmetic-subtract, most, half, u64-layout)
    - overflow
. grown = arithmetic(site, .arithmetic-add, current, half, u64-layout)
. from-large = ir.current
jump(grew)
ir.start-block(grew)
. later = phi(u64-layout, doubled, from-small, grown, from-large)
. from-grew = ir.current
jump(chosen)
ir.start-block(chosen)
. candidate = phi(u64-layout, integer(.machine-u64, first), empty, later, from-grew)
. short = ir.reserve-block()
. enough = ir.reserve-block()
. settled = ir.reserve-block()
branch(compare(site, .compare-less, candidate, needed), short, enough)
ir.start-block(short)
jump(settled)
ir.start-block(enough)
jump(settled)
ir.start-block(settled)
= phi(u64-layout, needed, short, candidate, enough)

────────────────────
_ do copy-bytes
    - site SyntaxId
    - target Operand
    - source Operand
    - count Operand

` Copies bytes from one place to another, as TypeScript copies a table's rows when it grows: a
` word at a time while a whole word is left, then a byte at a time.
. cursor = ir.add-local(u64-layout)
store-local(cursor, integer(.machine-u64, 0), site)
copy-by(site, target, source, count, cursor, 8, u64-layout)
copy-by(site, target, source, count, cursor, 1, u8-layout)

────────────────────
_ do copy-by
    - site SyntaxId
    - target Operand
    - source Operand
    - count Operand
    - cursor LocalId
    - width U64
    - layout LayoutId

` Copies bytes a width at a time from the cursor on, while a whole width is left.
. testing = ir.reserve-block()
. copying = ir.reserve-block()
. copied = ir.reserve-block()
jump(testing)
ir.start-block(testing)
. end = arithmetic
    - site
    - .arithmetic-add
    - load-local(cursor, site)
    - integer(.machine-u64, width)
    - u64-layout
branch(compare(site, .compare-greater, end, count), copied, copying)
ir.start-block(copying)
. done = load-local(cursor, site)
. value = load(moved-bytes(site, source, done), 0, layout, site)
store(moved-bytes(site, target, done), 0, value, false, site)
store-local
    - cursor
    - arithmetic(site, .arithmetic-add, done, integer(.machine-u64, width), u64-layout)
    - site
jump(testing)
ir.start-block(copied)

────────────────────
_ table-row-type TypeId
    - table TypeId

` The type of a table's rows, or of the rows a view of one reads.
viewed-item(table)

────────────────────
_ do fixed-columns Operand
    - site SyntaxId
    - row-layout LayoutId
    - size Operand

` The storage of a table that does not grow, as TypeScript makes it: a directory with a
` pointer to each field's column, and a buffer for each column. Where every field has the
` same type, which holds nothing the collector follows, the columns are parts of one buffer.
. fields = tables.layouts.rows[row-layout].fields
. count = fields.count
. directory = table-buffer(site, managed-layout, integer(.machine-u64, count))
if count == 0
    = directory
. first = tables.layouts.field(row-layout, 0)
. uniform = !tables.layouts.rows[first.layout].is-managed
for position in 1 .. < count
    if tables.layouts.field(row-layout, position).type != first.type
        uniform = false
if uniform
    . total = arithmetic(site, .arithmetic-multiply, size, integer(.machine-u64, count), u64-layout)
    . slab = table-buffer(site, first.layout, total)
    . width = tables.layouts.rows[first.layout].size as U64
    for position in 0 .. < count
        . start = integer(.machine-u64, 0)
        if position != 0
            start = arithmetic
                - site
                - .arithmetic-multiply
                - size
                - integer(.machine-u64, position)
                - u64-layout
        . bytes = arithmetic
            - site
            - .arithmetic-multiply
            - start
            - integer(.machine-u64, width)
            - u64-layout
        store(directory, position * 8, moved-bytes(site, slab, bytes), false, site)
    = directory
for position in 0 .. < count
    . column = table-buffer(site, tables.layouts.field(row-layout, position).layout, size)
    store(directory, position * 8, column, false, site)
= directory

────────────────────
_ do table-buffer Operand
    - site SyntaxId
    - item LayoutId
    - count Operand

` A buffer of a table's storage, as TypeScript allocates one: from the task's parse region
` where one is active, and else from the collector, with what describes its items where they
` hold pointers it follows.
. row = tables.layouts.rows[item]
if row.is-managed && row.buffer == no-string
    refuse(.refused-type, site)
    = make-operand(.operand-void, 0)
. descriptor = if row.is-managed then buffer-descriptor else integer(.machine-pointer, 0)
    .. buffer-descriptor = make-operand(.operand-buffer-descriptor, item)
. width = integer(.machine-u64, row.size)
. region = make-operand
    - .operand-value
    - append(.op-load-task-word, site, Span(), parse-region-offset, u64-layout)
. regional = ir.reserve-block()
. collected = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-not-equal, region, integer(.machine-u64, 0)), regional, collected)
ir.start-block(collected)
. mark = pending.length
pending += width
pending += count
pending += descriptor
. made = call-runtime(.runtime-allocate-buffer, site, mark, managed-layout)
. from-heap = ir.current
jump(joined)
ir.start-block(regional)
pending += width
pending += count
pending += descriptor
. carved = call-runtime(.runtime-parse-region-allocate-buffer, site, mark, managed-layout)
. from-region = ir.current
jump(joined)
ir.start-block(joined)
= phi(managed-layout, carved, from-region, made, from-heap)

────────────────────
_ do fill-table
    - site SyntaxId
    - row TypeId
    - row-layout LayoutId
    - columns Operand
    - size Operand
    - filler Operand

` Fills each row of a new table, from the first, with what a filler of a function type
` answers for the row's index, a call that may panic.
. counter = ir.add-local(u64-layout)
store-local(counter, integer(.machine-u64, 0), site)
. testing = ir.reserve-block()
. filling = ir.reserve-block()
. filled = ir.reserve-block()
jump(testing)
ir.start-block(testing)
branch(compare(site, .compare-less, load-local(counter, site), size), filling, filled)
ir.start-block(filling)
. index = load-local(counter, site)
. code = load(filler, 0, pointer-layout, site)
. data = load
    - filler
    - tables.layouts.field(tables.layouts.function-layout, 1).offset
    - managed-layout
    - site
. mark = pending.length
pending += data
pending += index
. made = call(code, site, mark, .callee-value, layout-of(row, site), !in-landing)
if types.intrinsic-of(row) == .union
    scatter-union(site, tables.unions.of(row), columns, index, made, no-meta(), false)
else
    scatter-row(site, row-layout, columns, index, made)
store-local
    - counter
    - arithmetic(site, .arithmetic-add, index, integer(.machine-u64, 1), u64-layout)
    - site
jump(testing)
ir.start-block(filled)

────────────────────
_ do table-cell Operand
    - site SyntaxId
    - columns Operand
    - index Operand
    - slot U32
    - item LayoutId

` Where a row's field lies in its column: the column the directory holds for the field,
` moved on by the row's index times the size of the field.
= item-cell(site, load(columns, slot * 8, pointer-layout, site), index, item)

────────────────────
_ do item-cell Operand
    - site SyntaxId
    - data Operand
    - index Operand
    - item LayoutId

` Where an item of a column lies: where the column's items start, moved on by the index times
` the size of an item.
. width = integer(.machine-u64, tables.layouts.rows[item].size)
= moved-bytes(site, data, arithmetic(site, .arithmetic-multiply, index, width, u64-layout))

────────────────────
_ do scatter-row
    - site SyntaxId
    - row-layout LayoutId
    - columns Operand
    - index Operand
    - value Operand

` Stores each field of a row in its column, in the order the row declares them, through the
` collector's barrier where the field holds pointers it follows.
for position in 0 .. < tables.layouts.rows[row-layout].fields.count
    . field = tables.layouts.field(row-layout, position)
    . cell = table-cell(site, columns, index, position, field.layout)
    store-cell(site, cell, field.layout, take(value, field, site))

────────────────────
_ do store-cell
    - site SyntaxId
    - cell Operand
    - layout LayoutId
    - value Operand

` Stores a value of a table's field in its cell of a table that does not grow.
. managed = tables.layouts.rows[layout].is-managed
if tables.layouts.is-struct(layout)
    copy(cell, value, layout, managed, site)
else if layout != void-layout
    store(cell, 0, value, managed, site)

────────────────────
_ do gather-row Operand
    - site SyntaxId
    - row-layout LayoutId
    - columns Operand
    - index Operand

` A row of a table read from its columns into the frame, field by field.
. made = frame(row-layout)
for position in 0 .. < tables.layouts.rows[row-layout].fields.count
    . field = tables.layouts.field(row-layout, position)
    . cell = table-cell(site, columns, index, position, field.layout)
    put(made, field, take(cell, LayoutField(0, field.layout, field.type), site), site)
= made

────────────────────
_ do table-op TableOp
    - id SyntaxId

` The operation the type pass planned at a node of a table.
. constant = facts.constant-of(unit.reading, id)
if constant == no-fact
    refuse(.refused-expression, id)
    = TableOp.table-row
= ((facts.constants[constant].bits /and/ 4294967295) as U32) as TableOp

────────────────────
_ table-slot U32
    - id SyntaxId

` The place in the row's layout of the field a table's node reads or writes.
if constant == no-fact then 0 else (facts.constants[constant].bits /rshift/ 32) as U32

.. constant = facts.constant-of(unit.reading, id)

────────────────────
_ do header-word Operand
    - site SyntaxId
    - header Operand
    - position U32

` A word of the header an arena's table keeps: its columns, length, capacity, shrink and
` mutation generations, and its spill's base, use and capacity.
= load(num-cast(site, header, u64-layout, pointer-layout), position * 8, u64-layout, site)

────────────────────
_ do grows Operand
    - site SyntaxId
    - header Operand

` Whether a table grows in an arena: it has a header.
= compare(site, .compare-not-equal, header, integer(.machine-u64, 0))

────────────────────
_ do view-grows Operand
    - site SyntaxId
    - meta TableMeta

` Whether a view of a table reads one that grows: it has a header and an owner.
. owned = compare(site, .compare-not-equal, meta.owner, integer(.machine-u64, 0))
= bitwise(site, .bitwise-and, grows(site, meta.header), owned, u8-layout)

────────────────────
_ do header-or-zero Operand
    - site SyntaxId
    - header Operand
    - position U32

` A word of a table's header where it grows, and zero where it does not.
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(grows(site, header), growing, fixed)
ir.start-block(growing)
. word = header-word(site, header, position)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
jump(joined)
ir.start-block(joined)
= phi(u64-layout, word, from-growing, integer(.machine-u64, 0), fixed)

────────────────────
_ do table-meta TableMeta
    - site SyntaxId
    - table Operand
    - layout LayoutId

` The metadata of a table value, its shrink generation read from its header where it grows.
. header = part(table, layout, 2, site)
. owner = part(table, layout, 3, site)
. incarnation = part(table, layout, 4, site)
. generation = part(table, layout, 5, site)
= TableMeta(header.operand, owner.operand, incarnation.operand, generation.operand, header-or-zero(site, header.operand, 3))

────────────────────
_ do row-meta TableMeta
    - site SyntaxId
    - row Operand
    - layout LayoutId

` The metadata a row of a table holds.
= TableMeta
    - part(row, layout, 2, site).operand
    - part(row, layout, 3, site).operand
    - part(row, layout, 4, site).operand
    - part(row, layout, 5, site).operand
    - part(row, layout, 6, site).operand

────────────────────
_ do fail-if
    - site SyntaxId
    - failed Operand
    - text String

` Raises a panic the compiler writes where a test holds. In a function that grows a table's
` storage, which raises none, the function answers the panic's message there.
. raising = ir.reserve-block()
. passed = ir.reserve-block()
branch(failed, raising, passed)
ir.start-block(raising)
if cold
    return-value(make-operand(.operand-constant, ir.add-string(text)), site)
else
    raise-text(site, text)
ir.start-block(passed)

────────────────────
_ do grow-outside
    - site SyntaxId
    - helper FunctionId
    - meta TableMeta
    - first Operand
    - second Operand
    - third Operand

` Grows a table's storage by the function the tables declared for it, given what
` `emit-storage-growth` says, and raises a panic with the message it answers where it
` answers one. A function the collector never sees leaves that zone for the call.
. target = tables.functions[helper]
. mark = pending.length
pending += meta.header
pending += meta.owner
pending += meta.incarnation
pending += first
pending += second
if operand-kind(third) != .operand-void
    pending += third
ir.depend(.callee-function, helper, 0)
. crosses = in-zone
if crosses
    cross-zone(site, false)
. message = call
    - make-operand(.operand-symbol, target.symbol)
    - site
    - mark
    - .callee-function
    - managed-layout
if crosses
    cross-zone(site, true)
. raising = ir.reserve-block()
. grown = ir.reserve-block()
branch
    - compare
        - site
        - .compare-not-equal
        - num-cast(site, message, managed-layout, u64-layout)
        - integer(.machine-u64, 0)
    - raising
    - grown
ir.start-block(raising)
raise-message(site, message)
ir.start-block(grown)

────────────────────
_ do validate-table
    - site SyntaxId
    - meta TableMeta
    - context String
    - checks-shrink Bool

` Checks that a table that grows can still be read, as TypeScript checks it: the arena has
` not been reset since, the table is not sealed, and it has not shrunk since the view was made.
` The runtime moves the generation of an arena's slot on at each reset and release and each
` time the slot is taken again, so the slot holds the generation a table was made under only
` while that arena lives unreset.
. current = load
    - num-cast(site, meta.owner, u64-layout, pointer-layout)
    - arena-generation-offset
    - u64-layout
    - site
fail-if
    - site
    - compare(site, .compare-not-equal, current, meta.generation)
    - "$context is stale after Arena reset"
fail-if
    - site
    - compare(site, .compare-equal, header-word(site, meta.header, 0), integer(.machine-u64, 0))
    - "Table is sealed"
if checks-shrink
    . shrunk = compare(site, .compare-not-equal, header-word(site, meta.header, 3), meta.shrink)
    fail-if(site, shrunk, "$context was invalidated by table shrink")

────────────────────
_ do table-columns Operand
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - meta TableMeta

` Where a table's columns are: the directory its header holds, once checked, where it grows,
` and the one it holds itself where it does not.
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(grows(site, meta.header), growing, fixed)
ir.start-block(growing)
validate-table(site, meta, "Table", false)
. held = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = num-cast(site, part(table, layout, 0, site).operand, managed-layout, pointer-layout)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
= phi(pointer-layout, held, from-growing, own, from-fixed)

────────────────────
_ do table-length Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - meta TableMeta

` How many rows a table has: its header's length, once checked, where it grows, and the size
` it holds itself where it does not.
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(grows(site, meta.header), growing, fixed)
ir.start-block(growing)
validate-table(site, meta, "Table", false)
. held = header-word(site, meta.header, 1)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = part(table, layout, 1, site)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
= Typed(phi(u64-layout, held, from-growing, own.operand, from-fixed), own.type)

────────────────────
_ do table-cursor TableCursor
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId

` `t[i]` of a table or of a span of one, as TypeScript reads it: the table, then the index,
` converted to one; the columns are found, and the index is checked against the length and
` moved on by the span's offset.
. none = make-operand(.operand-void, 0)
. empty = TableCursor(none, none, TableMeta(none, none, none, none, none))
. proven = proven-table(id)
if proven != U32.max
    . held = proven-tables[proven]
    . counted = convert(key, .reason-argument, emit-expression(key))
    if held.kind == .table || held.kind == .immutable-table
        = TableCursor(held.source.columns, counted.operand, held.source.meta)
    = TableCursor
        - held.source.columns
        - arithmetic(id, .arithmetic-add, held.source.offset, counted.operand, u64-layout)
        - held.source.meta
. table = emit-expression(object)
. type = table.type
. index = convert(key, .reason-argument, emit-expression(key))
if index.type != types.index-type || !is-row-source(intrinsic(type))
    refuse(.refused-expression, id)
    = empty
. layout = layout-of(type, id)
= row-place(id, table.operand, type, layout, index.operand)

────────────────────
_ do rows-length Typed
    - id SyntaxId
    - held Operand
    - type TypeId
    - layout LayoutId

` How many rows a table or a span of one holds, as TypeScript counts them: checked where the
` table grows, and held by a finished table and its spans.
. kind = intrinsic(type)
. length = make-operand(.operand-void, 0)
if kind == .table
    length = table-length(id, held, layout, table-meta(id, held, layout)).operand
else if kind == .table-span
    length = span-length(id, held, layout, span-meta(id, held, layout)).operand
else
    length = table-source(id, held, type, layout).length
= Typed(length, types.size-type)

────────────────────
_ do row-place TableCursor
    - id SyntaxId
    - table Operand
    - type TypeId
    - layout LayoutId
    - index Operand

` The row at an index of a table or of a span of one: the index checked against the length
` and moved on by the span's offset.
. kind = intrinsic(type)
. source = table-source(id, table, type, layout)
fail-if
    - id
    - compare(id, .compare-greater-equal, index, source.length)
    - "${source-name(kind)} index is out of bounds"
if kind == .table || kind == .immutable-table
    = TableCursor(source.columns, index, source.meta)
= TableCursor
    - source.columns
    - arithmetic(id, .arithmetic-add, source.offset, index, u64-layout)
    - source.meta

────────────────────
_ source-name String
    - kind IntrinsicKind

` The name of a table, or of a span of one, its panics give.
|? kind == .table
    "Table"
|? kind == .table-span
    "TableSpan"
|? kind == .immutable-table
    "ImmutableTable"
??
    "ImmutableTableSpan"

────────────────────
_ is-row-source Bool
    - kind IntrinsicKind

` Whether a value is a table or a span of one, whose rows can be read.
kind == .table || kind == .table-span || kind == .immutable-table || kind == .immutable-table-span

────────────────────
_ is-immutable-view Bool
    - kind IntrinsicKind

` Whether a value is a table that was finished, or a view of one, which holds no metadata.
table-or-span || kind == .immutable-table-row || kind == .immutable-table-column
.. table-or-span = kind == .immutable-table || kind == .immutable-table-span

────────────────────
_ do table-source TableSource
    - id SyntaxId
    - table Operand
    - type TypeId
    - layout LayoutId

` The rows of a table, from the first, or of a span of one, from its offset: the columns are
` found, then the length, each checked where the table grows. A finished table and its spans
` hold their columns and length themselves, and no metadata.
. kind = intrinsic(type)
. zero = integer(.machine-u64, 0)
if kind == .immutable-table
    = TableSource
        - part-address(id, table, layout, 0).operand
        - zero
        - part(table, layout, 1, id).operand
        - TableMeta(zero, zero, zero, zero, zero)
if kind == .immutable-table-span
    = TableSource
        - part-address(id, table, layout, 0).operand
        - part(table, layout, 1, id).operand
        - part(table, layout, 2, id).operand
        - TableMeta(zero, zero, zero, zero, zero)
if kind == .table
    = table-rows(id, table, layout, table-meta(id, table, layout))
= span-rows(id, table, layout, span-meta(id, table, layout))

────────────────────
_ do table-rows TableSource
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - meta TableMeta

` The columns and length of a table, from the first row: both from its header, checked once,
` where it grows, and both held by the table itself where it does not.
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(grows(site, meta.header), growing, fixed)
ir.start-block(growing)
validate-table(site, meta, "Table", false)
. held = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
. held-length = header-word(site, meta.header, 1)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = num-cast(site, part(table, layout, 0, site).operand, managed-layout, pointer-layout)
. own-length = part(table, layout, 1, site)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
. columns = phi(pointer-layout, held, from-growing, own, from-fixed)
. length = phi(u64-layout, held-length, from-growing, own-length.operand, from-fixed)
= TableSource(columns, integer(.machine-u64, 0), length, meta)

────────────────────
_ do span-rows TableSource
    - site SyntaxId
    - span Operand
    - layout LayoutId
    - meta TableMeta

` The columns, offset and length of a span of a table, the span checked once where its table
` grows: the columns are the directory its table's header holds there, and the ones the span
` holds where it does not.
. columns = span-columns(site, span, layout, meta)
= TableSource(columns, part(span, layout, 1, site).operand, part(span, layout, 2, site).operand, meta)

────────────────────
_ do span-meta TableMeta
    - site SyntaxId
    - span Operand
    - layout LayoutId

` The metadata a span of a table holds.
= TableMeta
    - part(span, layout, 3, site).operand
    - part(span, layout, 4, site).operand
    - part(span, layout, 5, site).operand
    - part(span, layout, 6, site).operand
    - part(span, layout, 7, site).operand

────────────────────
_ do span-columns Operand
    - site SyntaxId
    - span Operand
    - layout LayoutId
    - meta TableMeta

` Where a span's columns are: the directory its table's header holds, once the span is
` checked, where the table grows, and the one the span holds where it does not.
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, fixed)
ir.start-block(growing)
validate-table(site, meta, "TableSpan", true)
. held = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = part-address(site, span, layout, 0)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
= phi(pointer-layout, held, from-growing, own.operand, from-fixed)

────────────────────
_ do span-length Typed
    - site SyntaxId
    - span Operand
    - layout LayoutId
    - meta TableMeta

` How many rows a span of a table has, once the span is checked where its table grows.
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, joined)
ir.start-block(growing)
validate-table(site, meta, "TableSpan", true)
jump(joined)
ir.start-block(joined)
= part(span, layout, 2, site)

────────────────────
_ do emit-table-index Typed
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId

` A row of a table made a value at `t[i]`: the columns, left out where the table grows, the
` index, and the table's metadata.
. none = make-operand(.operand-void, 0)
if table-op(id) == TableOp.table-span
    = emit-table-span(id, object, key)
if table-op(id) == TableOp.table-item
    = emit-table-item(id, object, key)
if table-op(id) == TableOp.table-select
    = emit-table-select(id, object, key)
if table-op(id) == TableOp.span-item || table-op(id) == TableOp.selection-row
    = emit-span-index(id, object, key)
if table-op(id) == TableOp.span-range || table-op(id) == TableOp.selection-range
    = emit-span-range(id, object, key)
if table-op(id) != TableOp.table-row && table-op(id) != TableOp.proven-row
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. cursor = table-cursor(id, object, key)
= row-value(id, cursor, facts.node-type(unit.reading, id))

────────────────────
_ do emit-table-select Typed
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId

` The rows of a table indices select at `t[ids]`, as TypeScript selects them: the table, then
` the indices; a table that grows is checked, and the selection holds the table and an index
` span: the one given, or one made of the array or of the arena's builder given.
. none = make-operand(.operand-void, 0)
. table = emit-expression(object)
. type = table.type
. given = emit-expression(key)
. given-type = given.type
. kind = intrinsic(type)
if kind != .table && kind != .immutable-table
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. selection = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. selection-layout = layout-of(selection, id)
. span-type = field-type(selection, 1)
. span-layout = layout-of(span-type, id)
if kind == .table
    table-columns(id, table.operand, layout, table-meta(id, table.operand, layout))
. made = frame(selection-layout)
put(made, tables.layouts.field(selection-layout, 0), table.operand, id)
. span-field = tables.layouts.field(selection-layout, 1)
if given-type == span-type
    put(made, span-field, given.operand, id)
else
    span-into
        - id
        - address(made, span-field.offset, span-layout, id)
        - span-type
        - span-layout
        - given.operand
        - given-type
        - none
        - no-type
= Typed(made, selection)

────────────────────
_ do emit-span-index Typed
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId

` An index of an index span read at `s[i]`, or a row of a selection, as TypeScript reads it:
` the value, then the position, converted to one, which is checked against the length. The
` span is resolved and the index read there; a selection then reads its table's row at that
` index as `t[i]` reads it.
. none = make-operand(.operand-void, 0)
. held = emit-expression(object)
. type = held.type
. position = convert(key, .reason-argument, emit-expression(key))
if position.type != types.index-type
    refuse(.refused-conversion, key)
    = Typed(none, no-type)
. layout = layout-of(type, id)
if intrinsic(type) == .index-span
    . item = viewed-item(type)
    . item-layout = layout-of(item, id)
    fail-if
        - id
        - compare(id, .compare-greater-equal, position.operand, word-at(id, held.operand, layout, 3))
        - "IndexSpan index is out of bounds"
    . value = span-item(id, resolve-span(id, held.operand, layout), position.operand, item-layout)
    = Typed(value, item)
= row-value(id, selected-row(id, held.operand, type, layout, position.operand), facts.node-type(unit.reading, id))

────────────────────
_ do selection-cursor TableCursor
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId

` The row a selection reads at `s[i]`, where a field of it is read or written: the selection,
` then the position, converted to one.
. none = make-operand(.operand-void, 0)
. empty = TableCursor(none, none, TableMeta(none, none, none, none, none))
. held = emit-expression(object)
. type = held.type
. position = convert(key, .reason-argument, emit-expression(key))
. kind = intrinsic(type)
if position.type != types.index-type || not-selection
    refuse(.refused-expression, id)
    = empty
.. not-selection = kind != .table-selection && kind != .immutable-table-selection
. layout = layout-of(type, id)
= selected-row(id, held.operand, type, layout, position.operand)

────────────────────
_ do selected-row TableCursor
    - id SyntaxId
    - selection Operand
    - type TypeId
    - layout LayoutId
    - position Operand

` The row of a table a selection reads at a position, as TypeScript reads it: the position is
` checked against the selection's length, the indices resolved and the index read there, and
` the table's row at that index found as `t[i]` finds it.
. none = make-operand(.operand-void, 0)
. empty = TableCursor(none, none, TableMeta(none, none, none, none, none))
. table-type = field-type(type, 0)
. span-type = field-type(type, 1)
. item = viewed-item(span-type)
. table-layout = layout-of(table-type, id)
. span-layout = layout-of(span-type, id)
. item-layout = layout-of(item, id)
. span = part(selection, layout, 1, id)
fail-if
    - id
    - compare(id, .compare-greater-equal, position, word-at(id, span.operand, span-layout, 3))
    - "TableSelection position is out of bounds"
. table = part(selection, layout, 0, id)
. index = selected-index(id, resolve-span(id, span.operand, span-layout), position, item, item-layout)
= row-place(id, table.operand, table-type, table-layout, index)

────────────────────
_ do emit-span-range Typed
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId

` The indices a range spans of an index span at `s[a .. < b]`, or of a selection, as TypeScript
` spans them: the range is made forward and checked against the span's length, and the span
` made again from the range's start, of its length.
. none = make-operand(.operand-void, 0)
. held = emit-expression(object)
. type = held.type
. range = emit-expression(key)
. range-type = range.type
. layout = layout-of(type, id)
. spans = intrinsic(type) == .index-span
. span-type = if spans then type else field-type(type, 1)
. span-layout = layout-of(span-type, id)
. span = if spans then held else part(held.operand, layout, 1, id)
. forward = forward-range(id, range.operand, range-type, held.operand, type, object)
. bounds = checked-bounds(id, forward.operand, forward.type, word-at(id, span.operand, span-layout, 3))
. made = frame(layout)
copy(made, held.operand, layout, false, id)
. made-span = if spans then made else address(made, span-offset, span-layout, id)
    .. span-offset = tables.layouts.field(layout, 1).offset
. start = arithmetic
    - id
    - .arithmetic-add
    - word-at(id, span.operand, span-layout, 2)
    - bounds.start
    - u64-layout
put-word(id, made-span, span-layout, 2, start, u64-layout)
put-word(id, made-span, span-layout, 3, bounds.length, u64-layout)
