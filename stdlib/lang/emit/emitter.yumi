if closes-actions()
    stop-owned(declared)
if rerun
    emit-rerun(declared, body)
    =
if starts
    emit-machine-start(declared)
    =
if retest
    emit-retest(body)
    =
if tests-gate
    emit-gate-test(body)
    =
if reselects
    emit-reselect(declared, body)
    =
if selects
    emit-selector(declared, tree.selector-control(body))
    =
if builds-arm
    emit-arm(declared, body)
    =
if builds-row && tree.row-region(body)
