        =
    if given-loop != 0
        keep-given(declared)
    emit-fused-body
        - declared
        - body
        - (imperative || given-loop != 0) && (signature.errors.count == 0 || reads-errors)
    =
if given-loop != 0 || given-pipe != 0
    keep-given(declared)
    if tables.step-functions[unit.instance] == no-function
        refuse(.refused-function, declared)
        =
if tables.step-functions[unit.instance] != no-function
    make-generator(declared)
    =
if body == 0
    . made = default-value(unwritten, returns-type, layout-of(returns-type, declared), declared)
    return-value(made.operand, declared)
    =
if feeds != 0
    emit-built-feeds(declared, feeds)
    =
if imperative
    emit-block(body)
    if row.ends-generator
