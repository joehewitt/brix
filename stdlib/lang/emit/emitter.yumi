    if line == 0
        refuse(.refused-expression, declared)
        break
    . built = builder-value(line)
    if built.type != instances.argument-type(callee, carried + offset)
        refuse(.refused-conversion, line)
    pending += built.operand
call-instance(callee, declared, mark)

────────────────────
_ do emit-fill
    - made Operand
    - type TypeId
    - declared SyntaxId

` Runs, on the object a constructor has made, the function that fills it with the markup
` written in its class, where the type pass kept the call: once the constructor's own body
` has run. It is given the state cells the constructor was given, then the function that builds
` each slot the constructor was given one for, which are the constructor's last arguments, in
` the order both take them. Where the constructor was given last the function that gives an
` element's name the object, that runs first.
. call = facts.filler-of(unit.reading)
if call == no-fact
    =
. first = instances.signatures[unit.instance].args.count - instances.rows[unit.instance].slots.count
. slots = instances.rows[unit.instance].slots.count
. carried = instances.rows[unit.instance].carried
if instances.takes-binder(unit.instance)
    slots -= 1
    run-binder(made, instances.argument-type(unit.instance, first + slots), first + slots, declared)
. callee = facts.calls[call].callee
if instances.rows[callee].slots.count == 0 && carried == 0 && instances.rows[callee].carried == 0
    call-protocol(declared, call, made, type, make-operand(.operand-void, 0), no-type, false)
    =
if !is-callable(callee) || other-arity || instances.rows[callee].carried != carried || other-self
    refuse(.refused-statement, declared)
    =
.. other-arity = instances.signatures[callee].args.count != carried + slots
.. other-self = instances.rows[callee].self-type != type
. mark = pending.length
pending += made
for offset in 0 .. < carried
    . position = instances.value-argument(unit.instance, offset)
    pending += make-operand(.operand-argument, if unit.takes-self then position + 1 else position)
for offset in 0 .. < slots
    . position = first + offset
    if instances.argument-type(unit.instance, position) != callee-argument
