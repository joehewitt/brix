    =
ir.depend(.callee-function, step, 0)
. made = frame(layout)
store(made, 0, make-operand(.operand-symbol, tables.functions[step].symbol), false, declared)
store
    - made
    - tables.layouts.field(layout, 1).offset
    - load-local(unit.environment, declared)
    - false
    - declared
if row.makes != returns-type && intrinsic(returns-type) == .interface
    made = make-interface(declared, row.makes, returns-type, made).operand
else if row.makes != returns-type
    . converted = convert(declared, .reason-return, Typed(made, row.makes))
    made = converted.operand
    if converted.type != returns-type
        refuse(.refused-function, declared)
return-value(made, declared)

────────────────────
_ do emit-steps
    - declared SyntaxId
    - body SyntaxId
    - plain Bool

` The body of a function that yields, which the generator it made runs a step at a time. It
` is given the environment the function made where it was called, and answers an optional
` of an item: the one the next yield gives, or nothing once the body has finished.
` 1. Each call reads the receiver from the environment, and then goes to where the step
`    kept there says: the start of the body, or what follows the yield that left last.
` 2. The body is emitted once, in order, as a block: the cleanups it opens run where it
`    ends. There, and wherever it returns but at a yield, it keeps the step that says it has
`    finished.
` 3. The dispatch is emitted last, when the steps are known.
` A step of a generator that raises answers its optional or an error, as a function that
` raises does, and has finished where an error leaves it.
` A body written as an expression has no shape yet. Neither
` has the loop of a comprehension or a list of feeds that checks anything but a loop's
` own poll for a panic, where functions of several instances share its name: TypeScript
` numbers the names in a stack trace in the order it compiles in. A stack trace through
` such a function is the one TypeScript prints with no inlining, which runs it as it is.
. row = instances.rows[unit.instance]
. layout = tables.environments[unit.instance]
if !plain || row.yields == no-type || layout == no-layout || layout == unbuilt-environment
    refuse(.refused-function, declared)
    =
unit = unit.takes-self = false
unit = unit.has-self = false
ir.add-argument(managed-layout)
returns-type = value-returned(row.yields)
ir.returns = layout-of(returns-type, declared)
if returns-type != row.yields
    return-results(row.yields, declared)
unit = unit.environment = ir.add-local(managed-layout)
store-local(unit.environment, make-operand(.operand-argument, 0), declared)
share-self(declared)
. dispatch = ir.reserve-block()
. entry = ir.reserve-block()
jump(dispatch)
ir.start-block(entry)
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
if given-loop != 0
    emit-given(body)
else if given-pipe != 0
    emit-pattern-pipe(given-pipe)
else if feeds != 0
    emit-feeds(feeds)
else
    emit-block(body)
close-cleanups(mark)
scoping = own-scoping
emit-end(declared)
ir.start-block(dispatch)
. base = make-operand(.operand-argument, 0)
. step = load(base, tables.layouts.field(layout, 1).offset, i32-layout, declared)
. next = ir.reserve-block()
branch(compare(declared, .compare-equal, step, integer(.machine-i32, 0)), entry, next)
ir.start-block(next)
for position in 0 .. < resumes.length
    next = ir.reserve-block()
    . number U64 = (position + 1) as U64
    branch
        - compare(declared, .compare-equal, step, integer(.machine-i32, number))
        - resumes[position]
        - next
    ir.start-block(next)
for position in 0 .. < closings.length
    if closings[position] == no-block
        continue
    next = ir.reserve-block()
    . number U64 = 0u64 - position - 2
    branch
        - compare(declared, .compare-equal, step, integer(.machine-i32, number))
        - closings[position]
        - next
    ir.start-block(next)
return-absent(declared)

────────────────────
_ do emit-fused-body
    - declared SyntaxId
    - body SyntaxId
    - plain Bool

. row = instances.rows[unit.instance]
if !plain || row.yields == no-type || row.splits-yields || result-type != no-type
    refuse(.refused-function, declared)
    =
. step = tables.functions[tables.step-functions[unit.instance]]
function.may-panic = step.may-panic
function.carries = step.carries
function.polls = step.polls
returns-type = value-returned(row.yields)
ir.returns = void-layout
ir.signals = step.may-panic || step.carries || step.polls
if step.polls && budget == no-local
    open-polls()
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
if given-loop != 0
    emit-given(body)
else if feeds != 0
    emit-feeds(feeds)
else
    emit-block(body)
close-cleanups(mark)
scoping = own-scoping
emit-end(declared)

────────────────────
_ do emit-given
    - id SyntaxId

` The body of the function generated for a comprehension: its loop, over the container
` the function was given.
match? tree.nodes[id]
    | .node-iterator-expression(row)
        emit-for(id, row.loop, row.body)
        =
refuse(.refused-function, id)

────────────────────
_ do takes-item Bool
    - loop SyntaxId

` Whether the loop of a comprehension is one whose first header is over a container and
` subscribes to nothing, and whose body reads the item whole, as `each` or `it` or under
` the name written for it, or as a pattern written as a match fitted it or its arms gave
` it.
. take = facts.loop-take(unit.reading, loop)
match? tree.nodes[loop]
    | .node-loop-syntax(row)
        . matched = take == .take-arms || fitted-match
            .. fitted-match = take == .take-fitted && tree.matched-name(row.pattern) != row.pattern
        = !row.is-subscriber && (take == .take-whole || matched) && row.container != 0
= false

────────────────────
_ do check-steps

` Refuses a function that yields where a step of its body would read what the same call has
` not made: a value made before a yield, or a local stored before one. Only the environment
` keeps anything from one call to the next. On every path from where the function starts to
` a read, the value read must have been made, and the local stored; a local that holds a
` struct is stored where the whole of it is copied into or cleared, and one a call fills
` where the call is given its address. The values a join takes
` are made on the paths they arrive by, and are not looked at.
. values U32 = ir.instructions.length as U32
. width U32 = (values + ir.locals.length) as U32
. words U32 = (width + 63) / 64
. count = ir.blocks.length
. known = storage.allocate'U64(count * words + 1)
. reached = storage.allocate'U8(count + 1)
. made = storage.allocate'U64(words + 1)
for block in 0 .. < count
    reached[block] = 0
. first = ir.order[0]
reached[first] = 1
for word in 0 .. < words
    known[first * words + word] = 0
. checking = false
while true
    . changed = false
    for turn in 0 .. < ir.order.length
        . block = ir.order[turn]
        if reached[block] == 0
            continue
        for word in 0 .. < words
            made[word] = known[block * words + word]
        . rows = ir.blocks[block].instructions
        for id in rows.start .. < rows.end
            . row = ir.instructions[id]
            if row.op != .op-phi
                for position in row.operands.start .. < row.operands.end
                    . operand = ir.operands[position]
                    . payload = operand-payload(operand)
                    if operand-kind(operand) == .operand-block && !checking
                        if join-made(known, payload * words, made, words, reached[payload] == 0)
                            changed = true
                        reached[payload] = 1
                    if operand-kind(operand) != .operand-value
                        continue
                    if checking && !is-made(made, payload)
                        refuse(.refused-function, row.syntax)
                    . source = ir.instructions[payload]
                    if source.op != .op-local-address
                        continue
                    if (first-operand && copy-op) || (call-op && ir.locals[source.aux].filled)
                        mark-made(made, values + source.aux)
                    else if checking && !is-made(made, values + source.aux)
                        refuse(.refused-function, row.syntax)
                    .. first-operand = position == row.operands.start
                    .. copy-op = row.op == .op-copy || row.op == .op-zero
                    .. call-op = row.op == .op-call || row.op == .op-call-void
            if row.op == .op-load-local && checking && !is-made(made, values + row.aux)
                refuse(.refused-function, row.syntax)
            if row.op == .op-store-local
                mark-made(made, values + row.aux)
            mark-made(made, id)
    if checking
        break
    checking = !changed

────────────────────
_ do keep-step
    - number U64
    - site SyntaxId

` Keeps the step a function that yields has reached in its environment.
. layout = tables.environments[unit.instance]
store
    - make-operand(.operand-argument, 0)
    - tables.layouts.field(layout, 1).offset
    - integer(.machine-i32, number)
    - false
    - site

────────────────────
_ do emit-yield
    - id SyntaxId
    - expr SyntaxId
    - whole Bool

` A yield: the step that follows it is kept, and the function returns an optional that
` holds the item, converted to the type of the generator's items where the type pass
` recorded how. The next call goes on after the yield. A generator that is ended while it
` waits here runs the cleanups open here, as a return here would, and has finished.
` `<=? value` yields only where the optional written holds a value, what it holds, and
` goes on where it holds nothing. A yield written in a cleanup or outside a function that
` yields has no shape.
if whole || expr == 0
    refuse(.refused-statement, id)
    =
held-chain = expr
. value = emit-expression(expr)
held-chain = 0
yield-item(id, value, tree.is-chained(expr))

────────────────────
_ do give-item
    - loop SyntaxId
    - site SyntaxId
    - item Typed

` What a loop with no body does with each item: the loop of a pipe that writes each item gives it to
` the write recorded at the pipe, and the loop of a feed yields it, converted as recorded at
` `site`.
if writes.length == 0 || writes[writes.length - 1].pipe != loop
    if spreading != 0 && spreading == loop
        append-built(site, item, false)
        =
    yield-item(site, item, false)
    =
. write = writes[writes.length - 1]
. given = item.type
. sink = load-local(write.sink, loop)
call-operator(loop, write.fact, write.right, sink, write.sink-type, write.left, item.operand, given)

────────────────────
_ do yield-item
    - id SyntaxId
    - given-value Typed
    - optional Bool

` Yields a value, as `emit-yield` tells it: the whole of it, or for an `optional` one what it holds,
` where it holds anything. The conversion to the type of the generator's items is the one recorded
` at `id` for the type the value has.
if (!stepping && !fusing) || scoping.cleaning || unit.reading != unit.instance
    refuse(.refused-statement, id)
    =
. item = types.optional-inner(returns-type)
. staying = no-block
. value = given-value
if optional && types.is-optional(value.type)
    . held = value.type
    . tested = present(id, value)
    . given-block = ir.reserve-block()
    staying = ir.reserve-block()
    branch(tested.operand, given-block, staying)
    ir.start-block(given-block)
    value = payload(id, Typed(value.operand, held))
value = convert-matched(id, .reason-return, value, item)
if value.type != item
    refuse(.refused-conversion, id)
    =
. given = wrap(id, value, returns-type)
if fusing
    yield-fused(id, given.operand, staying)
    =
. resumed = ir.reserve-block()
resumes += resumed
keep-step(resumes.length as U64, id)
yielding = true
return-value(given.operand, id)
yielding = false
if open-cleanups.length == 0
    closings += no-block
else
    . closing = ir.reserve-block()
    closings += closing
    ir.start-block(closing)
    . around = landing
    run-cleanups(0, open-cleanups.length)
    landing = around
    return-absent(id)
ir.start-block(resumed)
if staying != no-block
    jump(staying)
    ir.start-block(staying)

────────────────────
_ do yield-fused
    - id SyntaxId
    - given Operand
    - staying IRBlockId

. resumed = ir.reserve-block()
. closing = if open-cleanups.length == 0 then no-block else ir.reserve-block()
. yielded = if reads-errors then read-case(0, given, id) else given
. start U32 = ir.operands.length
ir.add-operand(yielded)
ir.add-operand(make-operand(.operand-block, resumed))
append(.op-yield, id, Span(start, 2), closing)
if closing != no-block
    ir.start-block(closing)
    . around = landing
    run-cleanups(0, open-cleanups.length)
    landing = around
    return-absent(id)
ir.start-block(resumed)
if staying != no-block
    jump(staying)
    ir.start-block(staying)

────────────────────
_ do return-results
    - result TypeId
    - declared SyntaxId

` Makes the function one that raises errors: it returns a union whose first case is its
` value and whose others are the errors raised in its place, which the type pass made. A
` value that is itself an error is held in the first case too, as the reference holds it.
. held = ir.returns
if result == no-type
    refuse(.refused-function, declared)
    =
. layout = layout-of(result, declared)
if !tables.layouts.is-union(layout) || tables.layouts.case-field(layout, 0).layout != held
    refuse(.refused-function, declared)
    =
result-type = result
value-layout = held
ir.returns = layout

────────────────────
_ get returned LayoutId

` How the value the function returns is held, which is not what a function that raises
` errors returns.
if result-type != no-type then value-layout else ir.returns

────────────────────
_ do add-helper-argument
    - helper TypeId
    - site SyntaxId

` Adds the argument a function a grammar calls is given the helper of the pattern
` calling it in, after where it keeps the farthest cursor, and runs its pattern under it.
streaming = streaming.pattern-helper = make-operand(.operand-argument, ir.arguments.length)
streaming = streaming.pattern-helper-type = helper
streaming = streaming.helper-argument = true
ir.add-argument(layout-of(helper, site))

────────────────────
_ do add-mark-argument

` Adds the argument a rule's function is given where to keep the rollback mark its pattern holds
` as it passes, after the helper.
streaming = streaming.marked-argument = make-operand(.operand-argument, ir.arguments.length)
streaming = streaming.marks-argument = true
ir.add-argument(pointer-layout)

────────────────────
_ do ambient-helper

` Keeps the argument of a rule's function that is the helper of the rule's pattern, where the
` rule is given one as `ambient-position` finds it.
. position = ambient-position(types, instances, unit.instance)
if position != U32.max
    streaming = streaming.pattern-helper = make-operand(.operand-argument, position)
    streaming = streaming.pattern-helper-type = instances.argument-type(unit.instance, position)

────────────────────
_ do match-direct
    - declared SyntaxId
    - matched SyntaxId
    - pattern SyntaxId
    - result TypeId
    - returned TypeId
    - stream-type TypeId
    - buffer-type TypeId
    - first U32
    - views FactId = no-fact
    - extends FactId = no-fact
    - marks SyntaxId = 0
    - unread Bool = false
    - observes Bool = true

` The body of a function a grammar calls, from the arguments at `first` on: the
` address the stream's items start at, the cursor to start from, the count of items, and
` where to keep where it ended, how far it read and the farthest cursor a part failed at.
` Its arms are tried in turn from the cursor, and the first that passes gives what it gave,
` an optional of which it returns; one that holds nothing where no arm passed. Where the
` stream may give more input, a part that reads past the end of the buffer asks it for more
` through the calls `views` and `extends`, and reads the address and count of its items
` again. The body the type pass found holds a rollback mark at `marks` gives the mark it holds
` where it passed, and gives it back where it failed. Where `unread`, no call reads what it
` gives, and its arms give the text they matched as `emit-bare-arm` says. Under a helper that
` observes literal words, the body tells it of them only where it `observes` them.
. index-layout = layout-of(types.index-type, declared)
. buffer-layout = layout-of(buffer-type, declared)
. item-layout = layout-of(class-arg(types, buffer-type, 0), declared)
. layout = layout-of(result, declared)
. answer-layout = layout-of(returned, declared)
. nothing = make-operand(.operand-void, 0)
. start = make-operand(.operand-argument, first + 1)
. extent = ir.add-local(index-layout)
store-local(extent, start, matched)
. error = ir.add-local(index-layout)
store-local(error, start, matched)
. data = make-operand(.operand-argument, first)
. length = make-operand(.operand-argument, first + 2)
. stream = make-operand(.operand-argument, 0)
. run = direct-run
    - matched
    - stream
    - stream-type
    - buffer-type
    - data
    - start
    - length
    - extent
    - error
    - index-layout
    - item-layout
    - buffer-layout
    - views
    - extends
. end = ir.add-local(index-layout)
. joined = ir.reserve-block()
. failed = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. held = bound.length
. captured = stream-captures.length
lent-first = (first + (if streaming.helper-argument then 7 else 6) + (if streaming.marks-argument then 1 else 0)) as U32
streaming = streaming.storage-row = if marks != 0 then facts.storage-body-of(unit.reading, marks) else U32.max
streaming = streaming.observer-row = if marks != 0 && observes then facts.observer-body-of(unit.reading, marks) else U32.max
hold-captures(run, pattern)
lent-first = U32.max
if lent.length != collector-args.length
    refuse(.refused-function, declared)
if marks != 0
    open-marks(marks)
if streaming.marks-argument && streaming.rollback-mark == no-local
    refuse(.refused-function, declared)
plan-choices(pattern)
. arrives = emit-stream-arms(run, pattern, result, start, false, end, joined, slot, failed, unread)
drop-bound(held)
drop-captures(captured)
if !arrives
    drop-joins(mark)
    refuse(.refused-function, declared)
    =
. given = close-joins(joined, mark, layout, slot)
. ended = make-operand(.operand-argument, first + 3)
. reached = make-operand(.operand-argument, first + 4)
. erred = make-operand(.operand-argument, first + 5)
store(ended, 0, load-local(end, matched), false, matched)
store(reached, 0, load-local(extent, matched), false, matched)
store(erred, 0, load-local(error, matched), false, matched)
if streaming.marks-argument
    give-mark(matched)
return-lent(false, matched)
. wrapped = wrap(matched, Typed(given, result), returned)
return-value(wrapped.operand, matched)
ir.start-block(failed)
rewind-mark(matched)
store(reached, 0, load-local(extent, matched), false, matched)
store(erred, 0, load-local(error, matched), false, matched)
return-lent(true, matched)
return-value(empty-optional(returned, answer-layout).operand, matched)

────────────────────
_ do direct-run StreamRun
    - matched SyntaxId
    - stream Operand
    - stream-type TypeId
    - buffer-type TypeId
    - data Operand
    - start Operand
    - length Operand
    - extent LocalId
    - error LocalId
    - index-layout LayoutId
    - item-layout LayoutId
    - buffer-layout LayoutId
    - views FactId
    - extends FactId

` What the pattern of a function a grammar calls runs over: the address the stream's
` items start at and their count as it is given them, kept in locals of their own where the
` stream may give more input and the type pass recorded the calls that ask it for more.
. nothing = make-operand(.operand-void, 0)
if views == no-fact || extends == no-fact || !may-grow(stream-type)
    = StreamRun
        - matched
        - stream
        - stream-type
        - nothing
        - buffer-type
        - data
        - start
        - length
        - extent
        - error
        - index-layout
        - item-layout
        - buffer-layout
. kept-data = ir.add-local(pointer-layout)
store-local(kept-data, data, matched)
. kept-length = ir.add-local(index-layout)
store-local(kept-length, length, matched)
= StreamRun
    - matched
    - stream
    - stream-type
    - nothing
    - buffer-type
    - data
    - start
    - length
    - extent
    - error
    - index-layout
    - item-layout
    - buffer-layout
    - views
    - extends
    - no-local
    - kept-data
    - kept-length

────────────────────
_ do return-lent
    - failed Bool
    - site SyntaxId

` Gives each collector a caller lent back what its list holds, cut back first to what it held
` as the function began where the rule failed, as the reference rewinds a borrowed collector.
for held in lent
    if failed
        rewind-level(held.level, held.mark, site)
    . pointer = make-operand(.operand-argument, held.argument)
    . layout = layout-of(held.level.collector, site)
    put(pointer, tables.layouts.field(layout, 0), load-local(held.level.items, site), site)
    put(pointer, tables.layouts.field(layout, 1), load-local(held.level.size, site), site)

────────────────────
_ do bind-arguments
    - declared SyntaxId

` Gives each argument of a body written in source its cell, and stores there the value it
` arrives with. A struct is the address of memory the function owns, and is read as that: it
` has no cell, and has no shape here where some read tracks it. An argument that nested
` functions capture is copied into the function's environment, and so is the item or the
` value a pipe gives the function generated for its right side. The arguments of a nested
` function written in the body are not this function's.
. binding = instances.rows[unit.instance].binding
if binding == no-binding
    =
if piped != 0
    keep-piped(declared)
. first U32 = if unit.takes-self then 1 else 0
. position U32
for offset in 0 .. < unit.slot-count
    . slot = bindings.slots[unit.slot-start + offset]
    if slot.kind != .slot-argument || !owns(unit.slot-start + offset)
        continue
    . index = first + position
    position += 1
    if index >= ir.arguments.length
        refuse(.refused-function, declared)
        =
    . watched = (slot.flags /and/ SlotFlag.slot-tracked) != 0
    if watched && tables.layouts.is-struct(ir.arguments[index])
        refuse(.refused-function, declared)
        =
    if is-captured(unit.slot-start + offset)
        . given = instances.argument-type(unit.instance, position - 1)
        keep-captured(unit.slot-start + offset, make-operand(.operand-argument, index), given, declared)
        continue
    . layout = ir.arguments[index] as LayoutId
    if layout == void-layout || tables.layouts.is-struct(layout)
        continue
    . local = ir.add-local(layout, (slot.flags /and/ SlotFlag.slot-address-taken) != 0)
    unit.cells[offset] = local
    store-local(local, make-operand(.operand-argument, index), 0)

────────────────────
_ do emit-value
    - body SyntaxId
    - site SyntaxId = 0
    - closes Bool = false
    - binds Bool = false

` The body of a function that is an expression: the named markup elements the type pass made where
` it starts are made first, then its statements run in order, and the value of the last is what the
` function returns, converted to the type it returns, at the `site` the type pass converted it at
` where there is one, before the cleanups open run. A lazy local declared after it is no statement
` of these. A last statement that raises under no condition gives no value: the function leaves
` there. A markup element that ends it, as what a function builds for a slot or the row of a markup
` loop, gives the receiver's property of its name the object, once made, where the type pass kept
` that. A `close` that closes what the object owns, as `closes` says, closes it once the value is
` made, as it returns. Where the function `binds` the state cells it made for what it builds, they
` are bound to the value once made (`U32.max - 1`).
raise-elements(body)
. last = body
match? tree.nodes[body]
    | .node-block(block)
        last = 0
        for statement in tree.children[block.body]
            if !runs-in-body(statement) || is-lazy-local(statement)
                continue
            if last != 0
                emit-statement(last)
            last = statement
if last == 0
    refuse(.refused-function, body)
    =
match? tree.nodes[last]
    | .node-assertion-syntax(row)
        if row.condition == 0
            emit-statement(last)
            =
. made = emit-expression(last)
. named = facts.named-store-of(unit.reading, last)
if named != U32.max
    store-named(last, named, made)
if binds
    bind-cells(U32.max - 1, made.operand)
. value = convert(if site != 0 then site else last, .reason-return, made)
if value.type != returns-type
    refuse(.refused-conversion, last)
    =
value = leaving(value, last, true)
if closes
    close-owned(last)
return-value(value.operand, last)

────────────────────
_ do leaving Typed
    - value Typed
    - site SyntaxId
    - closes Bool = false

` The value a function returns, once the cleanups open have run. A struct is copied first:
` a cleanup may change the place it was read from. What converts a value to the type the
` function returns runs before it comes here, so a panic raised there runs the cleanups as one
` raised anywhere in the block does. Where the body ends, the cleanups are open no longer.
if open-cleanups.length == 0
    = value
. made = value.type
. kept = value
if made != no-type && made != invalid-type
    . layout = tables.layouts.values[made]
    if layout != no-layout && tables.layouts.is-struct(layout)
        kept = Typed(snapshot(value.operand, layout, site), kept.type)
if closes
    close-cleanups(0)
else
    run-cleanups(0, open-cleanups.length)
    landing = pad-at(0)
= Typed(kept.operand, made)

────────────────────
_ do emit-end
    - declared SyntaxId

` Where the body of an imperative function ends. One that returns nothing, a `Bool` or an
` optional returns there. Any other never gets there, which the type pass checked, and the
` return emitted for it only closes the block.
if returned == void-layout || returns-type == types.bool-type || types.is-optional(returns-type)
    return-absent(declared)
    =
return-zero(.return-normal)

────────────────────
_ do emit-return
    - id SyntaxId
    - expr SyntaxId

` Leaves the function with a value, or with nothing. What follows is never run. `=? value`
` leaves only where the optional written holds a value, with what it holds, and what follows
` runs where it holds nothing.
. staying = ir.reserve-block()
return-from(id, expr, if tree.is-chained(expr) then staying else no-block, true)
ir.start-block(staying)

────────────────────
_ do emit-return-if
    - id SyntaxId
    - condition SyntaxId
    - expr SyntaxId

` Leaves the function where a condition tests as true, with the value written or with what
` the function has for none.
if condition == 0
    refuse(.refused-statement, id)
    =
. tested = test(condition, emit-expression(condition))
. leaving = ir.reserve-block()
. staying = ir.reserve-block()
branch(tested.operand, leaving, staying)
ir.start-block(leaving)
return-from(id, expr)
ir.start-block(staying)

────────────────────
_ do return-from
    - id SyntaxId
    - expr SyntaxId
    - absent IRBlockId = no-block
    - defaulted Bool = false

` Returns a value converted to the type the function returns, as the type pass recorded where
` the value is written, or at the return itself for a type it inferred from the returns. A
` return of `null` gives the optional the function returns, holding nothing. With `absent`
` the return is one that happens only where its value is there: an optional that holds
` nothing goes on at `absent`, and one that holds a value returns what it holds. The
` cleanups open run after the value is made and converted, so a panic its conversion raises
` runs them as one raised anywhere in the block does. A value that may be an error returns
` the error in its place where it holds one. A return written in a cleanup has no shape. A function
` that yields has finished where it returns: the value written is evaluated and given to
` no one. `defaulted` is a return written with no value and no condition. A panic the
` conversion of a returned match raises is raised at the grammar the match runs. A
` `close` that closes what the object owns closes it as it returns, after the cleanups and
` after the value it returns is made, as the reference closes it before each return. In the
` body of a rule of a class, one with no value leaves only the body, after the cleanups opened
` in it, as it leaves the callback of the reference's live action. In the body of a spawned
` task, one with no value ends the task after the cleanups.
if unit.running-rule && scoping.rule-leaving != no-block && expr == 0 && !scoping.cleaning && !closes-actions()
    run-cleanups(scoping.rule-cleanups, open-cleanups.length)
    jump(scoping.rule-leaving)
    =
if scoping.cleaning || unit.running-rule
    refuse(.refused-statement, id)
    =
if expr == 0
    run-cleanups(0, open-cleanups.length)
    if closes-actions()
        close-owned(id)
    if task-leaving != no-block
        jump(task-leaving)
        =
    return-absent(id, defaulted)
    =
if initializes || (builds && (function.kind != .instance-body || tables.fills-apart(unit.instance)))
    refuse(.refused-statement, id)
    =
if stepping || fusing
    if absent != no-block
        refuse(.refused-statement, id)
        =
    emit-expression(expr)
    run-cleanups(0, open-cleanups.length)
    return-absent(id)
    =
held-chain = expr
. value = emit-expression(expr)
held-chain = 0
if absent != no-block && types.is-optional(value.type)
    . held = value.type
    . tested = present(expr, value)
    . given-block = ir.reserve-block()
    branch(tested.operand, given-block, absent)
    ir.start-block(given-block)
    value = payload(expr, Typed(value.operand, held))
. fused = carries-error(value.type) && facts.plan-of(unit.reading, id) == .plan-fused
if fused
    value = forward(id, value)
. missed SyntaxId = 0
match? tree.nodes[expr]
    | .node-match-expression(row)
        missed = tree.stream-statement(row.body)
value = convert(expr, .reason-return, value, missed)
value = convert(id, .reason-return, value)
if value.type == types.null-type && types.is-optional(returns-type)
    value = empty-optional(returns-type, returned)
if value.type != returns-type
    refuse(.refused-conversion, expr)
    =
. around = landing
value = leaving(value, id)
landing = around
if closes-actions()
    close-owned(id)
return-value(value.operand, id)

────────────────────
_ do forward Typed
    - id SyntaxId
    - result Typed

` What a returned value that may be an error gives where it holds none, with the cleanups
` open still to run. An error it holds is returned in its place once they have run, as the
` case of what the function returns that is the error's class or the nearest above it, and
` the error is as it was raised.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(result.type, id)
if !tables.layouts.is-union(layout) || result-type == no-type || unit.lender != no-instance
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
. count = tables.layouts.rows[layout].cases.count
. given = ir.reserve-block()
. raised = ir.reserve-block()
branch(case-test(id, result.operand, 0), given, raised)
ir.start-block(raised)
. around = landing
. kept = leaving(result, id)
for index in 1 .. < count
    . field = tables.layouts.case-field(layout, index)
    . own = error-case(field.type)
    if own == U32.max
        refuse(.refused-statement, id)
        = Typed(nothing, no-type)
    . next = no-block
    if index + 1 != count
        . held = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(id, kept.operand, index), held, next)
        ir.start-block(held)
    return-case(own, take(kept.operand, field, id), id)
    if next != no-block
        ir.start-block(next)
landing = around
ir.start-block(given)
. field = tables.layouts.case-field(layout, 0)
= Typed(take(result.operand, field, id), field.type)

────────────────────
_ do return-absent
    - site SyntaxId
    - defaulted Bool = false

` The return of a function where it gives no value: nothing, or false for a `Bool`, or an
` optional that holds nothing, or the object a constructor has made. A return written with
` no value and no condition gives the zero of a number or a C pointer, the empty text, or a
` tuple or struct with no bits set but its texts, as TypeScript gives a type's default; an
` object is made by a constructor there, which has no shape here.
if builds
    return-value(unit.self, site)
    =
if returned == void-layout
    return-value(make-operand(.operand-void, 0), site)
    =
if types.is-optional(returns-type) && structured-null
    return-value(empty-optional(returns-type, returned).operand, site)
    =
.. structured-null = tables.layouts.is-struct(returned) || is-null-form(returns-type)
if returns-type == types.bool-type
    return-value(integer(.machine-u8, 0), site)
    =
if !defaulted
    refuse(.refused-statement, site)
    =
. kind = intrinsic(returns-type)
if kind == .tuple || kind == .struct
    if tables.layouts.is-struct(returned)
        return-value(null-value(returns-type, returned, site).operand, site)
        =
if kind == .cpointer && is-pointer(returned)
    return-value(integer(returned as MachineKind, 0), site)
    =
if is-numeric-type(returns-type)
    if is-float(returned)
        return-value(float-number(returned, 0.0), site)
        =
    return-value(integer(tables.layouts.kind-of(returned), 0), site)
    =
if returns-type == types.string-type
    return-value(make-operand(.operand-constant, ir.add-string("")), site)
    =
refuse(.refused-statement, site)

────────────────────
_ do emit-termination-check

` The check a polling call makes: the first time it finds the task being terminated, the
` termination panic becomes the active one, and the answer is true. It raises it once, so the
` task's cleanups run and can read it.
returns-type = types.bool-type
ir.returns = u8-layout
. report = instances.report
. raise = ir.reserve-block()
. quiet = ir.reserve-block()
. joined = ir.reserve-block()
. terminating = call-runtime(.runtime-take-task-termination, 0, pending.length, u8-layout)
branch(terminating, raise, quiet)
ir.start-block(quiet)
jump(joined)
ir.start-block(raise)
. error = call-instance(report.termination-error, 0, pending.length)
. mark = pending.length
pending += error.operand
call-runtime(.runtime-panic-set, 0, mark)
. raised = ir.current
jump(joined)
ir.start-block(joined)
return-value(phi(u8-layout, integer(.machine-u8, 1), raised, integer(.machine-u8, 0), quiet), 0)

────────────────────
_ do emit-default-constructor
    - declared SyntaxId

` Allocates an object of the class and gives each stored property the value its class writes
` for it, or the zero of its type. A type whose values hold nothing has nothing to make, a
` number or a C pointer is made as its zero, and an optional as one that holds nothing. One
` whose values raise errors returns what it made as the value of what a function that raises
` returns.
. type = instances.rows[unit.instance].self-type
for position in 0 .. < instances.signatures[unit.instance].args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
if tables.layouts.values[type] == void-layout
    returns-type = type
    ir.returns = void-layout
    return-nothing()
    =
if types.is-optional(type)
    returns-type = type
    ir.returns = layout-of(type, declared)
    return-value(empty-optional(type, ir.returns).operand, declared)
    =
if is-zeroed(type) || type == types.bool-type
    returns-type = type
    ir.returns = layout-of(type, declared)
    return-value(integer(tables.layouts.kind-of(ir.returns), 0), declared)
    =
. made = allocate(type, declared)
if instances.signatures[unit.instance].errors.count != 0
    return-results(instances.signatures[unit.instance].result, declared)
unit = unit.self = made
unit = unit.has-self = true
store-properties(type, declared)
run-class-rules(type, declared)
if function.kind != .constructor-body
    emit-fill(made, type, class-site(type))
    emit-deferred(type, declared)
return-value(made, declared)

────────────────────
_ do emit-filling

` A constructor whose body a function of its own holds (`fills-apart`): it calls that function
` with its arguments, then fills the object it answers with the markup of its class and gives
` the properties put off until then their values, as the constructor would, and returns it.
` The call is placed where the constructor places what it runs once its body has, the
` declaration of the class for one the compiler writes.
. row = instances.rows[unit.instance]
. type = row.self-type
. signature = instances.signatures[unit.instance]
. declared SyntaxId = 0
. placed SyntaxId = 0
match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        declared = fn.syntax
        placed = if fn.is-generated then class-site(type) else fn.syntax
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
if !tables.is-class(type) || signature.returns != type || placed == 0
    refuse(.refused-function, declared)
    =
returns-type = type
ir.returns = managed-layout
. target-id = tables.body-functions[unit.instance]
. target = tables.functions[target-id]
. mark = pending.length
for position in 0 .. < signature.args.count
    pending += make-operand(.operand-argument, position)
ir.depend(.callee-function, target-id, if target.may-panic then may-panic-dependency else 0u32)
. made = call
    - make-operand(.operand-symbol, target.symbol)
    - placed
    - mark
    - .callee-function
    - managed-layout
    - target.may-panic && !in-landing
unit = unit.self = made
unit = unit.has-self = true
emit-fill(made, type, placed)
emit-deferred(type, declared)
return-value(made, declared)

────────────────────
_ do class-site SyntaxId
    - type TypeId

` Where a class is declared, which is where the reference places what the constructor it
` generates for the class calls, or none.
. ref = class-ref(types, type)
match? program.modules[ref.module].decls[ref.decl]
    | .decl-class(class)
        = class.syntax
= 0

────────────────────
_ do emit-constructor
    - declared SyntaxId
    - body SyntaxId

` A constructor written in source.
` 1. Its environment is made, where nested functions capture what it declares, and the
`    arguments go into their cells.
` 2. The object of a class is allocated, and is the receiver from here on, shared with the
`    nested functions that read it. A tuple or struct is made in memory of the frame
`    instead, which is the receiver and is returned by a copy.
` 3. Each stored property takes its first value, in the order the properties are declared.
` 4. The body runs. A return with no value leaves with what was made, and one with a value
`    leaves with that, as the reference returns it, and what was made is given to no one.
` A constructor that returns a value of its own makes nothing and has no receiver: its
` arguments go into their cells and its body runs, as a function's does. One that raises
` errors returns what it made as the value of what a function that raises returns.
. type = instances.rows[unit.instance].self-type
. signature = instances.signatures[unit.instance]
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
if tables.returns-own(unit.instance)
    returns-type = signature.returns
    ir.returns = layout-of(signature.returns, declared)
    if signature.errors.count != 0
        return-results(signature.result, declared)
    open-environment(declared)
    bind-arguments(declared)
    emit-block(body)
    emit-end(declared)
    =
. is-struct = type != no-type && type != invalid-type && is-aggregate(type)
if (!tables.is-class(type) && !is-struct) || signature.returns != type
    refuse(.refused-function, declared)
    =
open-environment(declared)
bind-arguments(declared)
. made = make-operand(.operand-void, 0)
returns-type = type
if is-struct
    ir.returns = layout-of(type, declared)
    made = frame(ir.returns)
else
    made = allocate(type, declared)
if signature.errors.count != 0
    return-results(signature.result, declared)
unit = unit.self = made
unit = unit.has-self = true
builds = true
share-self(declared)
if is-struct
    fill-fields(type, declared)
else
    store-properties(type, declared)
if body != 0
    emit-block(body)
if !is-struct
    run-class-rules(type, declared)
if !is-struct && function.kind != .constructor-body
    emit-fill(made, type, declared)
    emit-deferred(type, declared)
return-value(made, declared)

────────────────────
_ do fill-fields
    - type TypeId
    - declared SyntaxId

` Gives each field of the tuple or struct being made its first value, in the order the
` fields are declared: the argument of the field's name, converted as the type pass recorded
` where the argument is written, or else the value its type writes for it, or the zero of
` its type.
. range = types.completions[type].properties
. outer = making
making = Making(unit.self, type, returned, declared, made.length, true, making.callee, making.default-holder)
for _ in 0 .. < range.count
    made += 0
for offset in 0 .. < range.count
    make-field(offset)
while made.length > making.mark
    made.pop()
making = outer

────────────────────
_ evaluates-value Bool

` Whether what is emitted is written for the receiver's class, which `self-type` holds, as
` the value of a property or a rule of the class: a lazy property's value, one that reads
` something tracked evaluated again, or a rule.
function.kind == .lazy-property || function.kind == .property-updater || unit.running-rule

────────────────────
_ memo-flag-of U32
    - owner TypeId
    - property TypeProperty

` Where an object of a class keeps the flag of a property whose value is a memo, which says
` what the value read changed since it ran, or `U32.max` where the property has none.
|? !tables.is-class(owner) || property.storage-kind != .storage-eager
    U32.max
|? held == no-layout
    U32.max
??
    tables.layouts.memo-flag(held, object-header-fields + property.slot)

.. held = tables.layouts.objects[owner]

────────────────────
_ do settle-memo
    - site SyntaxId
    - object Operand
    - owner TypeId
    - property TypeProperty

` Before a read of a property whose value is a memo, settles it where its flag is set: its
` memo runs again first.
. flag = memo-flag-of(owner, property)
. live = instances.live
=? if flag == U32.max || live.memo-settle == no-instance
. dirty = ir.reserve-block()
. clean = ir.reserve-block()
branch
    - compare
        - site
        - .compare-not-equal
        - load(object, flag, u8-layout, site)
        - integer(.machine-u8, 0)
    - dirty
    - clean
ir.start-block(dirty)
. mark = pending.length
pending += num-cast(site, object, managed-layout, pointer-layout)
pending += integer(.machine-u64, flag)
do call-instance(live.memo-settle, site, mark)
jump(clean)
ir.start-block(clean)

────────────────────
_ do own-callback Operand
    - trackers Operand
    - code FunctionId
    - data Operand
    - site SyntaxId

` Gives the object that owns what is made here a live action with the trackers given and a
` callback that calls a function with the data given, and answers it: the owner is the
` innermost markup element being built, or else the object `self` names, as the reference
` gives it.
if content-hosts.length == 0 && !unit.has-self
    refuse(.refused-function, site)
    = make-operand(.operand-void, 0)
. owner = if content-hosts.length != 0 then content-hosts[content-hosts.length - 1].operand else unit.self
. action = make-action(trackers, code, data, site)
attach-action(owner, action.operand, site)
= action.operand

────────────────────
_ do read-received Typed
    - id SyntaxId
    - name Atom

` Reads a member of a markup element being built by its name alone: the property of the
` element `received-object` finds.
. object = received-object(id, name)
= load-property(id, object.operand, object.type, name)

────────────────────
_ do received-object Typed
    - id SyntaxId
    - name Atom

` The object of the markup element whose member a name alone reads or assigns, with its class
` as the value's type: the innermost element whose class has it (`received-position`), or in a
` function written in the element's body, the element kept where it was made (`read-kept`).
. kept = received-kept(id)
if kept != no-slot
    = read-kept(kept, id)
. position = received-position(name)
if !position
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
= content-hosts[position]

────────────────────
_ do read-unmade Typed
    - id SyntaxId
    - name Atom

` The name of a markup element of a class's markup read in a closure the markup makes before
` the element is made: the receiver's property of the name, as the reference reads it, which
` panics where the closure runs before the element is made.
if !unit.has-self
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
= guard-element(id, load-property(id, unit.self, unit.owner-type, name), name)

────────────────────
_ received-kept SlotId
    - id SyntaxId

` The local that keeps the object of the markup element whose member a name alone reads, where
` the read is in a function written in the element's body, or none.
if binding != no-binding then bindings.resolution-of(binding, id).slot else no-slot

.. binding = instances.rows[unit.reading].binding

────────────────────
_ do read-kept Typed
    - kept SlotId
    - site SyntaxId

` The object of a markup element, kept where it was made, read in a function written in its
` body, with its type as the value's.
. found = find-captured(kept, site)
. object = read-captured(kept, site, found.type)
= Typed(object.operand, found.type)

────────────────────
_ do received-position Size?
    - name Atom

` Where the innermost markup element being built whose class has a member of a name is kept,
` apart from one whose class's markup declares that member for an element, which is hidden
` there.
. position = content-hosts.length
while position != 0
    position -= 1
    . parent = content-hosts[position].type
    . place = types.property-named(parent, name) if intrinsic(parent) == .class
    if place && !names-element(types, types.properties[place])
        = position
= null

────────────────────
_ do make-action Typed
    - trackers Operand
    - code FunctionId
    - data Operand
    - site SyntaxId

` A live action with the trackers given and a callback that calls a function with the data
` given.
. live = instances.live
if live.action == no-instance
    refuse(.refused-function, site)
    = Typed(make-operand(.operand-void, 0), no-type)
. callback = make-callback(code, data, site)
. mark = pending.length
pending += trackers
pending += callback
= call-instance(live.action, site, mark)

────────────────────
_ do make-callback Operand
    - code FunctionId
    - data Operand
    - site SyntaxId

` A callback that calls a function with the data given.
. layout = tables.layouts.function-layout
if layout == no-layout || code == no-function
    refuse(.refused-function, site)
    = make-operand(.operand-void, 0)
ir.depend(.callee-function, code, 0)
. callback = frame(layout)
store(callback, 0, make-operand(.operand-symbol, tables.functions[code].symbol), false, site)
store(callback, tables.layouts.field(layout, 1).offset, data, false, site)
= callback

────────────────────
_ do attach-action
    - owner Operand
    - action Operand
    - site SyntaxId

` Gives an object a live action to own, in the list of its actions in a side lane of the
` collector, which its `close` closes.
. live = instances.live
. actions = side-list(site, owner, 1, live.actions)
. adding = pending.length
pending += actions.operand
pending += action
do call-instance(live.add-action, site, adding)

────────────────────
_ do emit-stream Typed
    - id SyntaxId
    - expr SyntaxId

` A stream of a value as it changes, as the reference makes it: the value is evaluated while a
` live action of its own is open, whose trackers note what it reads; the channel the type pass
` found is made, given the value by `<-write`, and kept in the local no name reaches declared at
` the stream; then the action is made with those trackers and a callback that writes the value
` again through the function written for it, given the environment in force here.
. nothing = make-operand(.operand-void, 0)
. row = tables.live-statement-of(unit.reading, id)
. code = if row && row.rerun != no-instance then tables.instance-functions[row.rerun] else no-function
. slot = channel-slot(id)
. made = stream-call(id, .call-constructor)
. write = stream-call(id, .call-method)
if code == no-function || slot == no-slot || made == no-fact || write == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. trackers = open-trackers(id)
live-actions += LiveTrackers(trackers, trackers)
. value = emit-expression(expr)
. held = value.type
live-actions.pop()
. type = facts.node-type(unit.reading, id)
. channel = emit-fact-call(id, facts.calls[made], 0, RowRange'SyntaxId(), 0, 0, type)
if channel.type != type
    refuse(.refused-conversion, id)
do call-protocol(id, write, channel.operand, type, value.operand, held, false)
keep-captured(slot, channel.operand, type, id)
do make-action(load-local(trackers, id), adapter, written-environment(id), id)
    .. adapter = tables.live-adapter-of(code)
= Typed(channel.operand, type)

────────────────────
_ do stream-call FactId ?! Refused
    - id SyntaxId
    - form CallForm

` The call of a form the type pass recorded at a stream of a value as it changes: the constructor
` of its channel, or its `<-write`.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == form
        = fact
    fact = facts.calls[fact].next
= no-fact

────────────────────
_ do decl-name Atom?
    - module ModuleId
    - decl DeclId

` The name of a property declared in a module.
match? program.modules[module].decls[decl]
    | .decl-property(row)
        = row.name
= null

────────────────────
_ do enter-query MarkupQuery

` Begins a function made for a markup query, whose data, the object, is its first argument,
` read as an object of the class that declares the query, in the module that writes it: it
` answers a `Bool`.
. query = facts.markup-queries[function.place]
unit = unit.source-module = query.module
unit = unit.has-self = true
unit = unit.self-type = query.level
unit = unit.self = make-operand(.operand-argument, 0)
returns-type = types.bool-type
ir.returns = layout-of(types.bool-type, query.site)
= query

────────────────────
_ do host-object Typed
    - site SyntaxId
    - host Operand
    - type TypeId
    - missed IRBlockId

` The object a markup host holds, as an object of a class, as the reference reads it for a
` query of the markup: where the object, by its own table, is of the class or of one derived
` from it, and else it leaves to `missed`.
. object = load(host, 0, managed-layout, site)
. passed = ir.reserve-block()
class-branch(site, object, type, passed, missed)
ir.start-block(passed)
= Typed(object, type)

────────────────────
_ do emit-descendant-query
    - removes Bool

` A function made for a descendant query of the markup an object is in, which the markup
` runtime runs with a markup host and the object as its data: where the host's object is of
` the class the query looks for, the markup runtime adds it to the list the property holds, in
` the order of the markup, or takes it from it, and where that changed the list it is stored
` again, which runs what reads the property though the list is the same. It answers whether
` the list changed.
. written = facts.markup-queries[function.place]
. host-type = facts.conversions[written.hosted].to
. host-layout = layout-of(host-type, written.site)
ir.add-argument(managed-layout)
ir.add-argument(host-layout)
. query = enter-query()
. site = query.site
. object = if tables.is-class(query.level) then tables.layouts.objects[query.level] else no-layout
. property = types.properties[query.place]
. callee = if removes then query.remove else query.add
if object == no-layout || callee == no-instance
    refuse(.refused-function, site)
    =
. candidate = ir.add-local(host-layout)
store-local(candidate, make-operand(.operand-argument, 1), site)
. field = tables.layouts.field(object, object-header-fields + property.slot)
. owner = convert-one(site, facts.conversions[query.hosted], Typed(unit.self, query.level))
. missed = ir.reserve-block()
. target = host-object(site, load-local(candidate, site), query.target, missed)
. current = field-value(unit.self, field, site)
. mark = pending.length
pending += current
pending += owner.operand
pending += target.operand
. changed = call-instance(callee, site, mark)
. storing = ir.reserve-block()
. done = ir.reserve-block()
branch(changed.operand, storing, done)
ir.start-block(storing)
put-property(unit.self, field, property, field-value(unit.self, field, site), site, U32.max, true)
jump(done)
ir.start-block(done)
return-value(changed.operand, site)
ir.start-block(missed)
return-value(integer(.machine-u8, 0), site)

────────────────────
_ is-default Bool
    - application StyleApplication
    - level TypeId

` Whether a style rule applied by this instance is one of the defaults of the class `level`.
own-base && application.outer == U32.max && application.made == level
.. own-base = application.instance == unit.instance && application.layer == 0

────────────────────
_ do section-of SyntaxId
    - rule ClassRule

` The loop of a rule that is a section, or none.
match? program.modules[rule.module].tree.nodes[rule.syntax]
    | .node-subscriber-syntax(section)
        = section.iterator
= 0

────────────────────
_ do enter-unit UnitRun
    - unit-id InstanceId

` Makes the function emitted that of another instance for a while, whose locals are its own for
` the run, and answers what the function kept of its own.
. run = UnitRun(unit, in-zone, block-effects)
block-effects = 0
read-instance(unit-id)
bind-slots()
clear-lazies()
= run

────────────────────
_ do leave-unit
    - run UnitRun

` Puts back what `enter-unit` kept of the function's own.
unit = run.unit
in-zone = run.in-zone
block-effects = run.block-effects

────────────────────
_ do forward-builder Typed
    - line SyntaxId
    - forwarded Typed

` The builder a line that forwards a slot gives where it holds state cells (`SlotForward`): the
` function of `slot-forward-functions` for it, with what it keeps, the builder `forwarded` it
` forwards and each cell, as made or given here. The builder forwarded where it holds none.
. index = U32.max
for position in 0 .. < facts.slot-forwards.length
    if facts.slot-forwards[position].instance == unit.reading && same-line
        index = position as U32
    .. same-line = facts.slot-forwards[position].line == line
if index == U32.max
    = forwarded
. builder = forwarded.type
. function-layout = layout-of(builder, line)
. layout = tables.slot-forward-layouts[index]
if function-layout != tables.layouts.function-layout
    refuse(.refused-expression, line)
    = forwarded
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, line, mark, managed-layout), line)
store
    - load-local(kept, line)
    - tables.layouts.field(layout, 0).offset
    - load(forwarded.operand, 0, pointer-layout, line)
    - false
    - line
store
    - load-local(kept, line)
    - tables.layouts.field(layout, 1).offset
    - load(forwarded.operand, tables.layouts.field(function-layout, 1).offset, managed-layout, line)
    - true
    - line
. place U32
for held in facts.outlet-cells
    if held.instance != unit.reading || held.outlet != line
        continue
    . local = cell-local(held.cell)
    if local == no-local
        refuse(.refused-expression, line)
        = forwarded
    store
        - load-local(kept, line)
        - tables.layouts.field(layout, 2 + place).offset
        - load-local(local, line)
        - true
        - line
    place += 1
. code = tables.slot-forward-functions[index]
ir.depend(.callee-function, code, 0)
. made = frame(function-layout)
store(made, 0, make-operand(.operand-symbol, tables.functions[code].symbol), false, line)
store(made, tables.layouts.field(function-layout, 1).offset, load-local(kept, line), false, line)
= Typed(made, builder)

────────────────────
_ do emit-event-handler

` The function the event runtime calls for a section of a class that it runs from the table of
` the class, given the object and what was published, as the reference compiles it: the body of
` the section's subscriber, given the environment the section would make for the object, as
` the constructor would subscribe it (see `open-handler`). It returns nothing: an error its
` subscriber lets out is given to the global `unhandled-error` where it leaves (see
` `hand-off`).
. handler = tables.event-handlers[function.place]
if unit.instance == no-instance || unhandled-raise
    refuse(.refused-function, handler.syntax)
    =
.. unhandled-raise = instances.signatures[unit.instance].errors.count != 0 && !facts.unhandled-error
emit-body()

────────────────────
_ do open-handler

` Makes the environment a section of a class would make for the object the function the event
` runtime calls for it is given, as its first argument, which the body of the section's
` subscriber then reads as the environment it was given.
. handler = tables.event-handlers[function.place]
unit = unit.reading = handler.unit
unit = unit.self = make-operand(.operand-argument, 0)
unit = unit.self-type = handler.level
unit = unit.owner-type = handler.level
unit = unit.has-self = true
made-environment = lone-environment(handler.syntax, no-slot)
unit = unit.reading = unit.instance
unit = unit.self = make-operand(.operand-void, 0)
unit = unit.self-type = no-type
unit = unit.owner-type = instances.rows[unit.instance].self-type
unit = unit.has-self = false

────────────────────
_ do init-site SyntaxId

` Where the reference places the call of a module's main from its init: at the constructor of
` the class whose sections it puts last in the event runtime's tables at the head of the init,
` or nowhere.
. making = tables.init-constructor(function.module)
if making == no-instance || instances.rows[making].module != function.module
    = 0
. row = instances.rows[making]
match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = if fn.is-generated then class-site(row.module, fn.owner) else fn.syntax
= 0

────────────────────
_ do emit-event-matcher

` The function the event runtime asks whether an object is of a class whose table runs sections,
` and not of a class below it: the table the object names is the class's own.
. symbol = tables.table-symbols[function.type]
ir.add-argument(pointer-layout)
returns-type = types.bool-type
ir.returns = u8-layout
if symbol == no-string
    refuse-class(function.type)
    =
. table = load(make-operand(.operand-argument, 0), 0, pointer-layout, 0)
return-value(compare(0, .compare-equal, table, make-operand(.operand-symbol, symbol)), 0)

────────────────────
_ do emit-idle-action

` The function the live action that owns a subscription or the endpoint at the address of a
` keyed event calls, which does nothing: the subscription delivers to its subscriber itself,
` and the endpoint is only closed with the action.
. live = instances.live
ir.add-argument(managed-layout)
returns-type = types.void-type
ir.returns = void-layout
. site = tables.idle-site
unit = unit.source-module = instances.rows[tables.idle-instance].module
if live.callback-result != no-type
    return-results(live.callback-result, site)
return-value(make-operand(.operand-void, 0), site)

────────────────────
_ do side-list Typed
    - site SyntaxId
    - object Operand
    - lane U64
    - maker InstanceId

` The list an object keeps in a side lane of the collector: the subscribers of its properties
` in lane 0, its live actions in lane 1. One is made and published there where it has none.
. owner = num-cast(site, object, managed-layout, pointer-layout)
. mark = pending.length
pending += owner
pending += integer(.machine-u64, lane)
. raw = call-runtime(.runtime-object-side-payload, site, mark, managed-layout)
. held = ir.add-local(managed-layout)
store-local(held, raw, site)
. making = ir.reserve-block()
. ready = ir.reserve-block()
branch
    - compare
        - site
        - .compare-equal
        - num-cast(site, raw, managed-layout, u64-layout)
        - integer(.machine-u64, 0)
    - making
    - ready
ir.start-block(making)
. made = call-instance(maker, site, pending.length)
. publishing = pending.length
pending += owner
pending += integer(.machine-u64, lane)
pending += made.operand
store-local
    - held
    - call-runtime(.runtime-publish-side-payload, site, publishing, managed-layout)
    - site
jump(ready)
ir.start-block(ready)
= Typed(load-local(held, site), made.type)

────────────────────
_ do put-property
    - object Operand
    - field LayoutField
    - property TypeProperty
    - value Operand
    - site SyntaxId
    - flag-offset U32 = U32.max
    - always Bool = false
    - memo-flag U32 = U32.max

` Stores a value in a property of an object as an assignment does: a managed pointer through
` the write barrier, and a struct by a copy, and a lazy property is marked, at `flag-offset`,
` as having its value. A property whose value is a memo has its flag, at `memo-flag`, cleared,
` so a read keeps the value stored. A property some read tracks keeps a copy of its bits from
` before the store and runs the actions that read it where they changed, or `always`. One that
` holds nothing has no shape there yet.
. tracked = tracks(property)
if tracked && field.layout == void-layout
    refuse(.refused-statement, site)
    =
. prior = make-operand(.operand-void, 0)
if tracked
    prior = if tables.layouts.is-struct(field.layout) then snapshot(field-value(object, field, site), field.layout, site) else load(object, field.offset, field.layout, site)
if tables.layouts.is-struct(field.layout)
    store-struct(object, field, value, site)
else if field.layout != void-layout
    store(object, field.offset, value, is-managed-pointer(field.layout), site)
if flag-offset != U32.max
    store-release(object, flag-offset, integer(.machine-u8, 1), site)
if memo-flag != U32.max
    store(object, memo-flag, integer(.machine-u8, 0), false, site)
if tracked
    dispatch-change
        - object
        - prior
        - field-value(object, field, site)
        - field.layout
        - property.name
        - site
        - always

────────────────────
_ do dispatch-change
    - object Operand
    - prior Operand
    - latest Operand
    - layout LayoutId
    - name Atom
    - site SyntaxId
    - always Bool = false

` Runs the actions that read a tracked property of an object where a store changed its bits,
` as `bits-differ` says, or `always`. Nothing runs where the object keeps no list of
` subscribers.
. live = instances.live
. changed = if !always then bits-differ(prior, latest, layout, site) else unchanged
    .. unchanged = make-operand(.operand-void, 0)
. checking = ir.reserve-block()
. sending = ir.reserve-block()
. done = ir.reserve-block()
if always
    jump(checking)
else
    branch(changed, checking, done)
ir.start-block(checking)
. mark = pending.length
pending += num-cast(site, object, managed-layout, pointer-layout)
pending += integer(.machine-u64, 0)
. subscribers = call-runtime(.runtime-object-side-payload, site, mark, managed-layout)
branch
    - compare
        - site
        - .compare-not-equal
        - num-cast(site, subscribers, managed-layout, u64-layout)
        - integer(.machine-u64, 0)
    - sending
    - done
ir.start-block(sending)
. sent = pending.length
pending += subscribers
pending += make-operand(.operand-constant, ir.add-string(name.text))
do call-instance(live.dispatch, site, sent)
jump(done)
ir.start-block(done)

────────────────────
_ do bits-differ Operand ?! Refused
    - prior Operand
    - latest Operand
    - layout LayoutId
    - site SyntaxId

` Whether two stored values differ in their bits: a float by its bits, not its value, a
` reference by what it points at, a struct by each of its fields, and a union by the case it
` holds and, where both hold one case, by that case's value, as the reference compares the
` value whole.
if !tables.layouts.is-struct(layout)
    = compare
        - site
        - .compare-not-equal
        - stored-bits(prior, layout, site)
        - stored-bits(latest, layout, site)
if tables.layouts.is-union(layout)
    . cases = compare
        - site
        - .compare-not-equal
        - load(prior, 0, u8-layout, site)
        - load(latest, 0, u8-layout, site)
    for index in 0 .. < tables.layouts.rows[layout].cases.count
        . field = tables.layouts.case-field(layout, index)
        if field.type == types.void-type
            continue
        . part = bits-differ
            - field-value(prior, field, site)
            - field-value(latest, field, site)
            - field.layout
            - site
        . held = bitwise(site, .bitwise-and, case-test(site, prior, index), part, u8-layout)
        cases = bitwise(site, .bitwise-or, cases, held, u8-layout)
    = cases
. differ = integer(.machine-u8, 0)
for index in 0 .. < tables.layouts.rows[layout].fields.count
    . field = tables.layouts.field(layout, index)
    . part = bits-differ
        - field-value(prior, field, site)
        - field-value(latest, field, site)
        - field.layout
        - site
    differ = bitwise(site, .bitwise-or, differ, part, u8-layout)
= differ

────────────────────
_ do field-value Operand
    - base Operand
    - field LayoutField
    - site SyntaxId

` A field held in memory: a struct as its address, and anything else loaded.
if tables.layouts.is-struct(field.layout)
    = address(base, field.offset, field.layout, site)
= load(base, field.offset, field.layout, site)

────────────────────
_ do stored-bits Operand
    - value Operand
    - layout LayoutId
    - site SyntaxId

` A stored value as the bits it is stored as: a float is read back from memory as an integer of
` its width.
if layout != f64-layout && layout != f32-layout
    = value
. held = frame(layout)
store(held, 0, value, false, site)
= load(held, 0, if layout == f64-layout then u64-layout else u32-layout, site)

────────────────────
_ do closes-actions Bool

` Whether the function is a class's `close` that takes no arguments, which closes the live
` actions the object owns, where the program makes any, and stops the machines its properties hold
` and its markup writes, where the program starts any, as it starts, and closes the live actions
` made since and the object's events, where its class has any, and cancels the tasks it owns,
` where the program spawns any an object owns, as it leaves.
if unit.instance == no-instance || !unit.has-self || function.kind != .instance-body
    = false
if instances.live.has-actions == no-instance && !closes-events() && !stops-machines() && !tables.owns-tasks
    = false
if !tables.is-class(unit.owner-type)
    = false
. row = instances.rows[unit.instance]
match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.owner != 0 && fn.args.count == 0 && fn.name
            . named = fn.name
            = named.text == "close"
= false

────────────────────
_ do stop-owned
    - site SyntaxId

` Closes each live action the receiver owns, then stops each machine its properties hold and its
` markup writes, as the event runtime keeps them (`event-stop-machines`), before the body of
` `close` runs: nothing the object does again on its own runs while the body closes what it owns,
` and the machines' exit rows see the object as it was.
if instances.live.has-actions != no-instance
    close-actions(site, unit.self)
if stops-machines()
    . stopping = pending.length
    pending += num-cast(site, unit.self, managed-layout, pointer-layout)
    do call-instance(facts.machine-stop, site, stopping)

────────────────────
_ do close-owned
    - site SyntaxId

` Closes each live action the receiver owns, taking it off the list the receiver keeps in lane 1,
` and then clears the lane, as the reference's `close` does as it leaves; then closes the
` receiver's events, where its class has any, or where `stop-owned` stopped its machines; then
` cancels the tasks the receiver owns, where the program spawns any an object owns, without
` waiting for them or yielding to them. A task that closes its own owner is not cancelled.
if instances.live.has-actions != no-instance
    close-actions(site, unit.self)
if closes-events()
    . mark = pending.length
    pending += num-cast(site, unit.self, managed-layout, pointer-layout)
    do call-instance(facts.event-close, site, mark)
else if closes-stopped()
    . mark = pending.length
    pending += num-cast(site, unit.self, managed-layout, pointer-layout)
    do call-instance(facts.machine-close, site, mark)
if tables.owns-tasks
    . cancelling = pending.length
    pending += num-cast(site, unit.self, managed-layout, pointer-layout)
    call-runtime(.runtime-cancel-owned-tasks, site, cancelling)

────────────────────
_ stops-machines Bool

` Whether the program starts a machine a class's property holds or its markup writes, which each
` class's `close` stops (`own-machine`).
facts.machine-stop != no-instance && tables.instance-functions[facts.machine-stop] != no-function

────────────────────
_ closes-stopped Bool

stops-machines() && facts.machine-close != no-instance && tables.instance-functions[facts.machine-close] != no-function

────────────────────
_ do closes-events Bool

` Whether the function is a `close` whose class has events, which it closes as it leaves.
if facts.event-close == no-instance
    = false
for closer in facts.event-closers
    if closer == unit.instance
        = true
= false

────────────────────
_ do close-actions
    - site SyntaxId
    - owner Operand

` Closes each live action an object owns, taking it off the list the object keeps in lane 1,
` and then clears the lane.
. live = instances.live
. mark = pending.length
pending += num-cast(site, owner, managed-layout, pointer-layout)
pending += integer(.machine-u64, 1)
. actions = call-runtime(.runtime-object-side-payload, site, mark, managed-layout)
. looping = ir.reserve-block()
. closing = ir.reserve-block()
. clearing = ir.reserve-block()
. done = ir.reserve-block()
branch
    - compare
        - site
        - .compare-not-equal
        - num-cast(site, actions, managed-layout, u64-layout)
        - integer(.machine-u64, 0)
    - looping
    - done
ir.start-block(looping)
. asking = pending.length
pending += actions
. empty = call-instance(live.has-actions, site, asking)
branch(empty.operand, clearing, closing)
ir.start-block(closing)
. popping = pending.length
pending += actions
. action = call-instance(live.pop, site, popping)
. shutting = pending.length
pending += action.operand
do call-method(live.close, site, shutting)
jump(looping)
ir.start-block(clearing)
. clear = pending.length
pending += num-cast(site, owner, managed-layout, pointer-layout)
pending += integer(.machine-u64, 1)
call-runtime(.runtime-clear-side-payload, site, clear)
jump(done)
ir.start-block(done)

────────────────────
_ do unread-value Typed
    - type TypeId
    - layout LayoutId
    - site SyntaxId

` What a read that never runs stands for: the value a type has with nothing written, in its
` layout.
if tables.layouts.is-struct(layout)
    = null-value(type, layout, site)
if is-float(layout)
    = Typed(float-number(layout, 0.0), type)
= Typed(integer(tables.layouts.kind-of(layout), 0), type)

────────────────────
_ do emit-globals
    - kind GlobalKind

` The function that gives a module's globals of one kind their first values, in the order
` they are declared: the constants, before any module starts, or the globals whose values
` run code, as the module starts. Each of the second kind is then marked as having its
` value. A value nothing reads is evaluated for what it does.
. module = function.module
. owner = program.modules[module]
unit = unit.source-module = module
unit = unit.reading = tables.main-instances[module]
for index in 0 .. < owner.decls.length
    if tables.global-kind(module, index as DeclId) != kind
        continue
    . row = tables.storage-of(module, index as DeclId)
    match? owner.decls[index]
        | .decl-property(property)
            if row == no-storage
                if property.value != 0 && kind == .global-eager
                    emit-expression(property.value)
            else if property.value != 0 || kind == .global-eager
                . kept = tables.storage[row]
                store-global(kept, global-value(kept, property).operand, property.syntax)
                if kind == .global-eager
                    store
                        - make-operand(.operand-symbol, kept.state)
                        - 0
                        - integer(.machine-u8, 1)
                        - false
                        - property.syntax
return-nothing()

────────────────────
_ do enum-value Typed
    - kept GlobalStorage
    - case CaseDecl
    - decl DeclId

` What a module makes for a value of an enum as it starts. A constructor the type pass
` recorded where the value is declared makes it, given the value written or nothing. Any
` other is the value written, or the number of the value among those its enum declares,
` converted as recorded where it is written or declared.
. nothing = make-operand(.operand-void, 0)
. made = no-fact
. fact = facts.first-call(unit.reading, case.syntax)
while fact != no-fact
    if facts.calls[fact].form == .call-constructor
        made = fact
    fact = facts.calls[fact].next
if made != no-fact
    . none = RowRange'SyntaxId()
    . object = emit-fact-call(case.syntax, facts.calls[made], 0, none, 0, case.value, kept.type)
    if object.type != kept.type
        refuse(.refused-conversion, case.syntax)
    = object
. site = case.syntax
. value = Typed(nothing, no-type)
if case.value != 0
    site = case.value
    value = emit-expression(case.value)
else
    . counted = types.type-row(.int64)
    . layout = layout-of(counted, site)
    value = Typed(integer(tables.layouts.kind-of(layout), enum-ordinal(decl)), counted)
if value.type != kept.type
    value = convert(site, .reason-assignment, value)
if value.type != kept.type
    refuse(.refused-conversion, site)
= value

────────────────────
_ do enum-ordinal U32
    - decl DeclId

` The number of a value of an enum among those its enum declares, in their order.
. owner = program.modules[unit.source-module]
. declares DeclId = 0
match? owner.decls[decl]
    | .decl-case(case)
        declares = case.owner
. ordinal U32
for index in 0 .. < decl
    match? owner.decls[index]
        | .decl-case(case)
            if case.owner == declares
                ordinal += 1
= ordinal

────────────────────
_ do read-enum Typed
    - id SyntaxId

` A value of an enum named: read from where the module that declares it keeps it, which made
` it as it started.
. nothing = make-operand(.operand-void, 0)
. constant = facts.constant-of(unit.reading, id)
if constant == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. bits = facts.constants[constant].bits
. module ModuleId = (bits / 4294967296) as U32
. decl DeclId = (bits % 4294967296) as U32
if module >= program.modules.length || decl >= program.modules[module].decls.length
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. row = tables.storage-of(module, decl)
if row == no-storage || tables.global-kind(module, decl) != .global-enum
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. kept = tables.storage[row]
if kept.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
= load-global(kept, id)

────────────────────
_ do emit-statics

` The function that makes what a module keeps of its types as it starts, before its globals
` have their values, as TypeScript's statics: the values of its enums that an emitted
` function reads, in the order they are declared, then the defaults of its parameters that
` run code and are kept, once each.
. module = function.module
. owner = program.modules[module]
unit = unit.source-module = module
unit = unit.reading = tables.main-instances[module]
for index in 0 .. < owner.decls.length
    . row = tables.storage-of(module, index as DeclId)
    if row == no-storage || tables.global-kind(module, index as DeclId) != .global-enum
        continue
    match? owner.decls[index]
        | .decl-case(case)
            . kept = tables.storage[row]
            store-global(kept, enum-value(kept, case, index as DeclId).operand, case.syntax)
. default = tables.first-default(function.module)
while default != no-storage
    . kept = tables.storage[default]
    unit = unit.reading = kept.owner
    . value = emit-expression(kept.syntax)
    if value.type != kept.type
        refuse(.refused-conversion, kept.syntax)
    store-global(kept, value.operand, kept.syntax)
    default = kept.next
return-nothing()

────────────────────
_ do emit-argument-default

` The function that evaluates the default of a parameter, which each call that leaves the
` argument out calls: it answers the default's value, typed by the instance whose parameter it
` is.
. kept = tables.storage[function.place]
unit = unit.source-module = instances.rows[kept.owner].module
unit = unit.reading = kept.owner
returns-type = kept.type
ir.returns = layout-of(kept.type, kept.syntax)
. value = emit-expression(kept.syntax)
if value.type != kept.type
    refuse(.refused-conversion, kept.syntax)
return-value(value.operand, kept.syntax)

────────────────────
_ do emit-stream-action

` The function the reference runs an action of a grammar in, which a panic in it
` shows. It is given what the arm binds that the action reads, in the order the type pass
` recorded them: `location`, `it` and the names the match captures. It binds each, runs the
` action and answers its value, or in an instance that raises errors its value or one of
` them, as `return-results` says.
. row = facts.outlined[function.place]
. body SyntaxId = 0
match? tree.nodes[row.arm]
    | .node-stream-transform(arm)
        body = arm.right
. type = facts.node-type(unit.reading, row.arm)
if body == 0 || type == no-type || type == invalid-type
    refuse(.refused-function, row.arm)
    =
. named = bound.length
for position in row.params.start .. < row.params.start + row.params.count
    . given = facts.action-types[position]
    bound += BoundValue
        - facts.action-slots[position]
        - given
        - make-operand(.operand-argument, ir.arguments.length)
    ir.add-argument(layout-of(given, row.arm))
returns-type = type
ir.returns = layout-of(type, row.arm)
if instances.signatures[row.instance].errors.count != 0
    return-results(row.result, row.arm)
. value = arm-value(row.arm, body, type)
return-value(value.operand, body)
drop-bound(named)

────────────────────
_ do emit-pattern-helper

` The function the reference makes of a pattern given to a rule where it is written,
` `static-inline-match-direct`: it takes what the function of a rule takes but the arguments
` written, matches the pattern from the cursor as a rule's arms are matched, and returns an
` optional of what the pattern gives, which holds nothing where it did not match. One written
` under a helper takes the helper as a rule typed for it does, and runs under it; under one
` that can roll back, it gives the rollback mark it holds as a rule does. Last it takes the
` data the value it is passed as holds: the address of what the names the type pass kept
` for it held where the pattern was passed, which it binds each name to, and reads the
` arguments of the rule it is written in from where it runs a local rule of that rule. One
` that runs a local rule of a rule that raises errors as a function returns its answer or one
` of them, as `return-results` says, and the rule it is given to lets an error pass to the
` rule that wrote it.
. row = facts.pattern-arguments[function.place]
. pattern SyntaxId = 0
match? tree.nodes[row.syntax]
    | .node-stream-match(written)
        pattern = written.pattern
if pattern == 0
    refuse(.refused-function, row.syntax)
    =
ir.add-argument(layout-of(row.stream, row.syntax))
returns-type = row.answer
ir.returns = layout-of(row.answer, row.syntax)
. raised = tables.pattern-raises(row.instance, row.syntax)
if raised != no-type
    return-results(raised, row.syntax)
if !direct-arguments(row.buffer, row.syntax, row.helper, helper-marks(row.helper))
    =
. given = make-operand(.operand-argument, ir.arguments.length)
ir.add-argument(pointer-layout)
. named = bound.length
if row.params.count != 0
    . layout = tables.pattern-environment(function.place)
    if layout == no-layout
        refuse(.refused-function, row.syntax)
        =
    for offset in 0 .. < row.params.count
        . position = row.params.start + offset
        bound += BoundValue
            - facts.action-slots[position]
            - facts.action-types[position]
            - take(given, tables.layouts.field(layout, offset), row.syntax)
given-slots = true
rule-arguments = rule-match(program, instance-module, instances.rows[unit.instance].decl) != 0
    .. instance-module = instances.rows[unit.instance].module
. views = facts.first-call(unit.reading, row.syntax)
match-direct
    - row.syntax
    - row.syntax
    - pattern
    - row.result
    - row.answer
    - row.stream
    - row.buffer
    - 1
    - views
    - next-call(views)
    - row.syntax
drop-bound(named)

────────────────────
_ do emit-pattern-cast

` The function the reference passes for a pattern given to a rule that is a call of a rule a
` module declares written alone, `Casting`: it takes what the rule's function takes and runs
` it, at the call, as the reference's cast of that function to the type the parameter takes
` does. One written under a helper takes the helper, which it gives a rule typed for it; under
` one that can roll back, it gives the rollback mark the rule gives, or none where the rule
` gives none. Last it takes the data the value it is passed as holds, which is none.
. row = facts.pattern-arguments[function.place]
. signature = instances.signatures[row.rule]
. site = row.syntax
match? tree.nodes[row.syntax]
    | .node-stream-match(written)
        site = written.pattern
. helped = instances.rows[row.rule].helper
. carried = carries(row.rule)
. marked = helper-marks(row.helper)
if other-shape || unfit-stream || (helped != no-type && helped != row.helper) || unmarked-state
    refuse(.refused-function, site)
    =
.. other-shape = signature.returns != row.answer || signature.args.count != 1
.. unfit-stream = signature.errors.count != 0 || instances.argument-type(row.rule, 0) != row.stream
.. unmarked-state = collector-args.length != 0 || (carried && (helped == no-type || !marked))
ir.add-argument(layout-of(row.stream, site))
returns-type = row.answer
ir.returns = layout-of(row.answer, site)
if !direct-arguments(row.buffer, site, row.helper, marked)
    =
ir.add-argument(pointer-layout)
if marked
    open-marks(row.syntax)
    if streaming.rollback-mark == no-local
        refuse(.refused-function, site)
        =
. mark = pending.length
for position in 0 .. < 7
    pending += make-operand(.operand-argument, position as U32)
if helped != no-type
    pending += streaming.pattern-helper
if carried
    pending += streaming.marked-argument
calls-rule = true
. answer = call-instance(row.rule, site, mark)
if marked && !carried
    give-mark(site)
return-value(answer.operand, site)

────────────────────
_ do direct-arguments Bool
    - buffer-type TypeId
    - site SyntaxId
    - helper TypeId = no-type
    - marked Bool = false

` Adds the arguments every function a grammar calls takes after the stream and those
` written: the address the items start at, the cursor and the count of items, and the
` addresses of where it ended, how far it read and the farthest cursor a part failed at; then
` the helper of the pattern calling it, where it is given one; then where to keep the rollback
` mark it holds as it passes, where it is `marked`; then a pointer to each collector a set of
` them gives it. A buffer that is no array has no shape here.
. index-layout = layout-of(types.index-type, site)
. buffer-layout = layout-of(buffer-type, site)
layout-of(class-arg(types, buffer-type, 0), site)
if unstructured || unpaired-buffer || !is-integer(index-layout)
    refuse(.refused-type, site)
    = false
.. unstructured = !tables.layouts.is-struct(buffer-layout)
.. unpaired-buffer = tables.layouts.rows[buffer-layout].fields.count != 2
ir.add-argument(pointer-layout)
ir.add-argument(index-layout)
ir.add-argument(index-layout)
ir.add-argument(pointer-layout)
ir.add-argument(pointer-layout)
ir.add-argument(pointer-layout)
if helper != no-type
    add-helper-argument(helper, site)
if marked
    add-mark-argument()
for name in collector-args
    ir.add-argument(pointer-layout)
= true

────────────────────
_ do slot-value Typed ?! Refused
    - slot SlotId
    - site SyntaxId
    - type TypeId

` What an argument or a local of the function being emitted holds, read with no name written
` for it, in the type the type pass kept for it: what the function was given for it, where it
` is the function made of a pattern; else as a name read is.
. nothing = make-operand(.operand-void, 0)
if is-bound(slot)
    = read-bound(slot, site, type)
if unit.reading != unit.instance || !is-own-slot(slot) || !owns(slot)
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. kind = bindings.slots[slot].kind
if is-captured(slot)
    = read-captured(slot, site, type)
if kind == .slot-local
    = read-local(slot, site, type)
if kind != .slot-argument
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. position = argument-position(slot)
if instances.argument-type(unit.instance, position) != type
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. cell = unit.cells[slot - unit.slot-start]
if cell != no-local
    = Typed(load-local(cell, site), type)
= Typed(make-operand(.operand-argument, if unit.takes-self then position + 1 else position), type)

────────────────────
_ do pattern-call StreamPart
    - run StreamRun
    - id SyntaxId
    - value SyntaxId
    - cursor Operand
    - failed IRBlockId

` A call of a pattern given to the rule, `$name` or `\name`: the function the name holds is
` given the rule's stream, the address the items start at, the cursor and the count of items,
` and where to keep where it ended, how far it read and the farthest cursor a part of it
` failed at, which the pattern counts as its own, as a call of a rule is. Where it passed, the
` call gives what it gave and goes on where it ended; where not, the call fails. Only a rule's
` pattern, whose stream is the one the function takes, calls one. A rule typed for a helper
` gives the function the helper too, as every pattern it is given is typed for it, and under
` one that can roll back takes the rollback mark the function gives, as from a rule it calls.
` Last the function is given the data the value holds. In the function of a rule made for a
` pattern that may raise errors, the call takes the pattern's answer or one of them, and an
` error leaves the function with the call.
. result = facts.node-type(unit.reading, id)
. answer-type = facts.answer-type(unit.reading, id)
. row = instances.rows[unit.instance]
if answer-type == no-type || rule-match(program, row.module, row.decl) == 0 || other-stream
    refuse(.refused-expression, id)
    = bare-part(cursor)
.. other-stream = run.stream-type != instances.argument-type(unit.instance, 0)
if row.helper != no-type && streaming.pattern-helper-type != row.helper
    refuse(.refused-expression, id)
    = bare-part(cursor)
calling-pattern = true
. held = held-pattern(value)
calling-pattern = false
if layout-of(held.type, value) != tables.layouts.function-layout
    refuse(.refused-expression, id)
    = bare-part(cursor)
. code = load(held.operand, 0, pointer-layout, id)
. returns = layout-of(if carried-given != no-type then carried-given else answer-type, id)
. ended = ir.add-local(run.index-layout, true, true)
. reached = ir.add-local(run.index-layout, true, true)
. erred = ir.add-local(run.index-layout, true, true)
. mark = pending.length
pending += run.stream
pending += run-data(run, id)
pending += cursor
pending += run-length(run, id)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), ended, pointer-layout)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), reached, pointer-layout)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), erred, pointer-layout)
if row.helper != no-type
    pending += streaming.pattern-helper
. given-mark = no-local
if helper-marks(row.helper)
    if streaming.rollback-mark == no-local
        refuse(.refused-expression, id)
        drop-pending(mark)
        = bare-part(cursor)
    given-mark = ir.add-local(ir.locals[streaming.rollback-mark].layout, true, true)
    pending += make-operand
        - .operand-value
        - append(.op-local-address, id, Span(), given-mark, pointer-layout)
pending += load
    - held.operand
    - tables.layouts.field(tables.layouts.function-layout, 1).offset
    - pointer-layout
    - id
. answer = call(code, id, mark, .callee-value, returns, function.may-panic && !in-landing)
if carried-given != no-type
    . propagated = propagate-held(id, carried-given, answer)
    answer = propagated.operand
    if propagated.type != answer-type
        refuse(.refused-expression, id)
record-call-extent(run, id, load-local(reached, id))
record-error(run, id, load-local(erred, id))
. flag = present(id, Typed(answer, answer-type))
. passed = ir.reserve-block()
branch(flag.operand, passed, failed)
ir.start-block(passed)
take-mark(given-mark, id)
. given = payload(id, Typed(answer, answer-type))
if given.type != result
    refuse(.refused-type, id)
    = bare-part(cursor)
= StreamPart(load-local(ended, id), Typed(given.operand, result))

────────────────────
_ do held-pattern Typed
    - value SyntaxId

` The function a pattern given to a rule is held in, as `$name` names it, or as `\name` calls
` it, where the name is read in the type its function gives it.
match? tree.nodes[value]
    | .node-stream-call(row)
        . resolution = bindings.resolution-of(instances.rows[unit.reading].binding, value)
        . type = if resolution.kind == .resolve-slot then slot-held-type(value, resolution.slot) else no-type
        if type == no-type
            refuse(.refused-expression, value)
            = Typed(make-operand(.operand-void, 0), no-type)
        . read = emit-identifier(value, row.name, type)
        = Typed(read.operand, type)
= emit-expression(value)

────────────────────
_ do action-call Typed
    - arm SyntaxId
    - result TypeId

` The call of the function the reference runs an action of a grammar in, made where the
` arm runs and given what the arm binds that the action reads; its value is converted as the
` arm's would be. The call is checked, which the type pass must have said of the caller too.
` An arm emitted again, as one of a local rule called twice is, calls the one function, where
` the reference makes another: a frame of it differs by its number alone. In an instance that
` raises errors the function answers its value or one of them, and an error leaves the
` function with the call.
. nothing = make-operand(.operand-void, 0)
. helper = tables.stream-action-of(unit.reading, arm)
if helper == no-function || (!function.may-panic && !in-landing)
    refuse(.refused-expression, arm)
    = Typed(nothing, no-type)
. target = tables.functions[helper]
. row = facts.outlined[target.place]
. type = facts.node-type(unit.reading, arm)
. raising = instances.signatures[row.instance].errors.count != 0
if raising && (in-zone || row.result == no-type)
    refuse(.refused-expression, arm)
    = Typed(nothing, no-type)
. returns = layout-of(if raising then row.result else type, arm)
. mark = pending.length
for position in row.params.start .. < row.params.start + row.params.count
    pending += read-bound(facts.action-slots[position], arm, facts.action-types[position]).operand
ir.depend(.callee-function, helper, may-panic-dependency)
if in-zone
    cross-zone(arm, false)
. value = call
    - make-operand(.operand-symbol, target.symbol)
    - arm
    - mark
    - .callee-function
    - returns
    - !in-landing
if in-zone
    cross-zone(arm, true)
if raising
    value = propagate-held(arm, row.result, value).operand
. answer = Typed(value, type)
if type != result
    answer = join(arm, answer)
if answer.type != result
    refuse(.refused-conversion, arm)
= answer

────────────────────
_ do emit-local-global

` The function that stores the value written for a global each task, or each thread, holds
` its own of in the memory of the task or thread running, or binds one `do with` binds to it.
` The main task runs those of tasks before its module's globals take their values;
` `threadinit` runs those of threads as each thread starts.
. kept = tables.storage[function.place]
unit = unit.source-module = kept.module
unit = unit.reading = tables.main-instances[kept.module]
match? program.modules[kept.module].decls[kept.decl]
    | .decl-property(property)
        . value = global-value(kept, property)
        if function.kind != .stack-local-init
            store-global(kept, value.operand, property.syntax)
        else
            fill-stack(stack-slot(kept, property.syntax), kept, value.operand, property.syntax)
return-nothing()

────────────────────
_ do global-value Typed
    - kept GlobalStorage
    - property PropertyDecl

` The first value of a global: the one written, converted to the global's type as the type
` pass recorded for the declaration, or with none written the value its type has: the empty
` text, an object the type pass constructs at the declaration, an optional with no value, or
` a named tuple or struct: what the constructor the type pass chose at the declaration makes,
` or with no such call its fields with their first values, where it declares no constructor.
` A constructor that takes arguments has no shape here: TypeScript gives it none of the
` defaults they declare.
if property.value == 0
    if types.is-optional(kept.type)
        = absent-argument(property.syntax, kept.type)
    . fact = facts.first-call(unit.reading, property.syntax)
    if fact != no-fact && instances.signatures[facts.calls[fact].callee].args.count != 0
        refuse(.refused-type, property.syntax)
        = Typed(make-operand(.operand-void, 0), no-type)
    if is-aggregate(kept.type) && !types.is-plain-tuple(kept.type)
        . constructs = fact != no-fact && facts.calls[fact].next == no-fact
        if constructs && facts.calls[fact].form == .call-this-constructor
            = emit-fact-call
                - property.syntax
                - facts.calls[fact]
                - 0
                - RowRange'SyntaxId()
                - 0
                - 0
                - kept.type
        if tables.writes-constructor(kept.type)
            refuse(.refused-type, property.syntax)
            = Typed(make-operand(.operand-void, 0), no-type)
        . made = make-fields
            - kept.type
            - kept.layout
            - RowRange'ArgumentFill()
            - given.length
            - 0
            - property.syntax
        = Typed(made, kept.type)
    = default-value(property.syntax, kept.type, kept.layout, property.syntax)
. value = emit-expression(property.value)
for site in [property.syntax, property.value]
    . fact = facts.first-conversion(unit.reading, site)
    while fact != no-fact && value.type != kept.type
        . row = facts.conversions[fact]
        if row.reason == .reason-declaration && row.from == value.type
            value = convert-one(site, row, value)
        fact = row.next
if value.type != kept.type
    refuse(.refused-conversion, property.syntax)
= value

────────────────────
_ do store-global
    - kept GlobalStorage
    - value Operand
    - syntax SyntaxId

` Stores a value where a global is kept: a managed pointer through the write barrier, and a
` struct by a copy. A value that is nothing is kept nowhere.
if kept.layout == void-layout
    =
. target = global-base(kept, syntax)
if tables.layouts.is-struct(kept.layout)
    copy
        - address(target, global-offset(kept), kept.layout, syntax)
        - value
        - kept.layout
        - tables.layouts.rows[kept.layout].is-managed
        - syntax
else
    store(target, global-offset(kept), value, is-managed-pointer(kept.layout), syntax)

────────────────────
_ do load-global Typed
    - kept GlobalStorage
    - syntax SyntaxId

` The value kept in storage: a struct is read where it is kept, and nothing is read for a
` value that is nothing.
if kept.layout == void-layout
    = Typed(make-operand(.operand-void, 0), kept.type)
. target = global-base(kept, syntax)
if tables.layouts.is-struct(kept.layout)
    = Typed(address(target, global-offset(kept), kept.layout, syntax), kept.type)
= Typed(load(target, global-offset(kept), kept.layout, syntax), kept.type)

────────────────────
_ do global-base Operand
    - kept GlobalStorage
    - syntax SyntaxId

` Where the memory a global is kept in starts: its symbol, or for one each task or each thread
` holds its own of, the memory of the task or thread running.
if kept.offset == U32.max
    = make-operand(.operand-symbol, kept.symbol)
if kept.per-thread
    = call-runtime(.runtime-active-thread-memory, syntax, pending.length, pointer-layout)
= task-locals(syntax)

────────────────────
_ do read-global Typed
    - id SyntaxId
    - module ModuleId
    - decl DeclId

` Reads a global from where it is kept. A lazy global that has no value yet is first
` evaluated by its function, which the read calls unless it is in that function. A read the
` type pass planned as checked, of any other global but a constant, raises a panic when the
` global has no value yet. Both read the byte of state beside the global.
. nothing = make-operand(.operand-void, 0)
. row = tables.storage-of(module, decl)
if row == no-storage
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.global-kind(module, decl) == .global-stack
    = read-stack(id, row)
. kept = tables.storage[row]
. is-lazy = tables.global-kind(module, decl) == .global-lazy
. checked = facts.plan-of(unit.reading, id) == .plan-guarded-read && tables.global-kind(module, decl) != .global-constant
if is-lazy && function.kind == .lazy-global && function.place == row
    = load-global(kept, id)
if !is-lazy && !checked
    = load-global(kept, id)
. target = if kept.function != no-function then tables.functions[kept.function] else function
if kept.state == no-string || (is-lazy && kept.function == no-function) || uncaught-panic
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. uncaught-panic = !function.may-panic && !in-landing
. missing = ir.reserve-block()
. ready = ir.reserve-block()
. current = load-acquire(make-operand(.operand-symbol, kept.state), 0, u8-layout, id)
branch(compare(id, .compare-equal, current, integer(.machine-u8, 1)), ready, missing)
ir.start-block(missing)
if is-lazy
    ir.depend(.callee-function, kept.function, may-panic-dependency)
    if in-zone
        cross-zone(id, false)
    call
        - make-operand(.operand-symbol, target.symbol)
        - id
        - pending.length
        - .callee-function
        - void-layout
        - !in-landing
    if in-zone
        cross-zone(id, true)
    jump(ready)
else
    raise-text(id, "Global '${tables.global-name(kept)}' is read before it is initialized")
ir.start-block(ready)
= load-global(kept, id)

────────────────────
_ do emit-initializer
    - declared SyntaxId
    - body SyntaxId

` A constructor as `super(…)` runs it: on the object being made, which it takes before its
` arguments, and it returns nothing.
` 1. The arguments go into their cells.
` 2. The properties the arguments fill are stored again, and so is each whose value reads
`    one that is. Every other property keeps what the constructor that called stored.
` 3. The body runs.
. type = instances.rows[unit.instance].self-type
. signature = instances.signatures[unit.instance]
if !tables.is-class(type) || signature.returns != type
    refuse(.refused-function, declared)
    =
unit = unit.takes-self = true
unit = unit.has-self = true
initializes = true
unit = unit.self = make-operand(.operand-argument, 0)
ir.add-argument(managed-layout)
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
returns-type = types.void-type
ir.returns = void-layout
bind-arguments(declared)
restore-properties(type, declared)
if body != 0
    emit-block(body)
return-nothing()

────────────────────
_ do allocate Operand
    - type TypeId
    - declared SyntaxId

` A new object of a class, with its class table and its id written. The function returns it.
` An `ArrayTokenStream` is carved from the task's parse region where an allocation scope of it
` is open, as TypeScript carves one, and else comes from the collector.
. nothing = make-operand(.operand-void, 0)
. object = no-layout
. table = no-string
if tables.is-class(type)
    object = tables.layouts.objects[type]
    table = tables.table-symbols[type]
if object == no-layout || table == no-string
    refuse(.refused-function, declared)
    = nothing
returns-type = type
ir.returns = managed-layout
. layout = tables.layouts.rows[object]
. size = integer(.machine-u64, layout.size)
. described = if layout.is-managed then descriptor else integer(.machine-pointer, 0)
    .. descriptor = make-operand(.operand-descriptor, object)
. mark = pending.length
pending += size
pending += described
if !same-decl(class-ref(types, type), types.array-token-stream-decl)
    . made = call-runtime(.runtime-allocate-object, declared, mark, managed-layout)
    = stamp-object(made, table, object, declared)
drop-pending(mark)
. depth = make-operand
    - .operand-value
    - append(.op-load-task-word, declared, Span(), parse-region-offset, u64-layout)
. regional = ir.reserve-block()
. collected = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(declared, .compare-not-equal, depth, integer(.machine-u64, 0)), regional, collected)
ir.start-block(collected)
pending += size
pending += described
. made = call-runtime(.runtime-allocate-object, declared, mark, managed-layout)
. from-heap = ir.current
jump(joined)
ir.start-block(regional)
pending += size
pending += described
. carved = call-runtime(.runtime-parse-region-allocate-object, declared, mark, managed-layout)
. from-region = ir.current
jump(joined)
ir.start-block(joined)
= stamp-object(phi(managed-layout, carved, from-region, made, from-heap), table, object, declared)

────────────────────
_ do stamp-object Operand
    - made Operand
    - table StringId
    - object LayoutId
    - declared SyntaxId

` Writes a new object's class table and id, and gives the object.
store(made, 0, make-operand(.operand-symbol, table), false, declared)
. uid = call-runtime(.runtime-generate-uid, declared, pending.length, u32-layout)
store(made, tables.layouts.field(object, 1).offset, uid, false, declared)
= made

────────────────────
_ do store-struct
    - object Operand
    - field LayoutField
    - value Operand
    - syntax SyntaxId

. target = address(object, field.offset, field.layout, syntax)
copy(target, value, field.layout, tables.layouts.rows[field.layout].is-managed, syntax)

────────────────────
_ do emit-tuple-constructor
    - declared SyntaxId

` Writes each argument to its field of a struct: in the memory the caller gave for one too
` large for registers, and else in memory of the frame, which is returned.
. type = instances.rows[unit.instance].self-type
. layout = layout-of(type, declared)
. signature = instances.signatures[unit.instance]
. row = tables.layouts.rows[layout]
if !tables.layouts.is-struct(layout) || signature.args.count != row.fields.count
    refuse(.refused-function, declared)
    =
returns-type = type
ir.returns = layout
. in-place = tables.layouts.is-large(layout)
. made = if in-place then make-operand(.operand-result, 0) else frame(layout)
if in-place && row.is-managed
    zero(made, layout)
for position in 0 .. < signature.args.count
    . field = tables.layouts.field(layout, position)
    . given = layout-of(instances.argument-type(unit.instance, position), declared)
    if given != field.layout
        refuse(.refused-type, declared)
        =
    ir.add-argument(given)
    put(made, field, make-operand(.operand-argument, position), declared)
if in-place
    return-nothing()
else
    return-value(made, declared)

────────────────────
_ do answers-itself Bool
    - callee InstanceId

` Whether a member of a table, or of a view of one, is one TypeScript answers itself where it
` is called: every one but `copy` and `fill`, and none of a row, whose getters run as any
` other. The type pass plans each call of one, so a call left to its body, which only the
` slot of an interface's table runs, has no shape.
. row = instances.rows[callee]
. owner = if row.self-type != no-type then intrinsic(row.self-type) else IntrinsicKind.none
if owner == .table-row || owner == .immutable-table-row
    = false
match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        . named = if fn.name then fn.name.text else ""
        = table-member && named != "copy" && named != "fill"
            .. table-member = !fn.is-generated && fn.owner != 0 && row.module == types.table-module
= false

────────────────────
_ do class-site SyntaxId
    - module ModuleId
    - owner DeclId

` Where a class is declared, which is where TypeScript places the code of a function it
` generates for the class.
match? program.modules[module].decls[owner]
    | .decl-class(class)
        = class.syntax
= 0

────────────────────
_ do copy-items
    - site SyntaxId
    - into Operand
    - out Operand
    - count Operand
    - item LayoutId

` Copies items of a column into another, as the runtime copies a slice: with what describes
` them where they hold pointers the collector follows.
. row = tables.layouts.rows[item]
. bytes = arithmetic(site, .arithmetic-multiply, count, integer(.machine-u64, row.size), u64-layout)
. mark = pending.length
pending += into
pending += out
pending += bytes
if !row.is-managed
    call-runtime(.runtime-copy-plain-slice, site, mark, pointer-layout)
    =
if row.buffer == no-string
    drop-pending(mark)
    refuse(.refused-type, site)
    =
pending += make-operand(.operand-buffer-descriptor, item)
call-runtime(.runtime-copy-slice, site, mark, pointer-layout)

────────────────────
_ do emit-cast-constructor
    - declared SyntaxId

` A value made from another by its type's name: a number, cast to the type, or a value of
` the type itself, which a union is called with once its argument is converted to it.
. type = instances.rows[unit.instance].self-type
. signature = instances.signatures[unit.instance]
if signature.args.count != 1
    refuse(.refused-function, declared)
    =
. source = instances.argument-type(unit.instance, 0)
ir.add-argument(layout-of(source, declared))
returns-type = type
ir.returns = layout-of(type, declared)
. value = make-operand(.operand-argument, 0)
if source != type
    value = cast(declared, Typed(value, source), type).operand
return-value(value, declared)

────────────────────
_ do layout-of LayoutId
    - type TypeId
    - syntax SyntaxId

` How a value of a type is held, or a refusal when the type has no layout yet.
. layout = no-layout
if type != no-type && type != invalid-type
    layout = tables.layouts.values[type]
if layout == no-layout
    refuse(.refused-type, syntax)
    = void-layout
= layout

────────────────────
_ intrinsic IntrinsicKind
    - type TypeId

` What a type is built on, as the type pass left it. Emission completes nothing: a type the
` type pass never completed is built on nothing, and no shape here takes it.
types.completions[type].intrinsic

────────────────────
_ is-aggregate Bool
    - type TypeId

` Whether a type's values are fields held in place: a tuple, a struct, an `ArrayBuilder`, or a
` table or a view of one, which TypeScript holds as the library's tuple.
intrinsic-is-tuple-like(intrinsic(type))

────────────────────
_ is-text Bool
    - type TypeId

intrinsic(type) == .string

────────────────────
_ is-zeroed Bool
    - type TypeId

` Whether the constructor of a type with no arguments makes its zero: a number, or a C
` pointer, which TypeScript holds as a number.
is-numeric-type(type) || intrinsic(type) == .cpointer

────────────────────
_ is-numeric-type Bool
    - type TypeId

` Whether a type is a number, as the type pass left it: an integer or a float, and no pointer.
intrinsic-is-numeric(kind) && kind != .cpointer

.. kind = intrinsic(type)

────────────────────
_ do emit-expression Typed ?! Refused
    - id SyntaxId

` The value of an expression before any conversion a use of it applies, with its type. A node the
` body being read did not reserve has no facts to follow. A tracked read has no shape here: nothing
` emitted follows what depends on it. `catch` of a value that carries no error is the value, and of
` any other has no shape yet. A name alone the type pass planned as a case, as a style declaration
` reads one, is that case.
. value = make-operand(.operand-void, 0)
if pins.length != 0
    . held = pin-of(id)
    if held
        = Typed(pins[held].value, pins[held].type)
if !facts.node-slot(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(value, no-type)
if !is-consumable(id)
    refuse(.refused-conversion, id)
    = Typed(value, no-type)
. type = facts.answer-type(unit.reading, id)
match tree.nodes[id]
    | .node-string-syntax(row)
        value = make-operand(.operand-constant, ir.add-string(row.text))
    | .node-integer-syntax(row)
        value = emit-integer(id, row.value).operand
    | .node-float-syntax(row)
        value = emit-float(id, row.value).operand
    | .node-identifier(row)
        . plan = facts.plan-of(unit.reading, id)
        if plan == .plan-case
            value = emit-case(id, RowRange'SyntaxId(), false).operand
        else if plan == .plan-enum-value
            value = read-enum(id).operand
        else
            . tracking = row.is-tracked && (live-actions.length != 0 || facts.pulls(unit.reading, id))
            if tracking
                track-name(id, row.name)
            . named = emit-identifier(id, row.name)
            value = named.operand
            if tracking
                track-collection(id, Typed(value, named.type))
    | .node-binary-expression(row)
        . binary = emit-binary(id, row.op, row.lhs, row.rhs)
        value = binary.operand
        if pipes-stream(row.op)
            type = binary.type
    | .node-unary-expression(row)
        value = emit-unary(id, row.op, row.operand).operand
    | .node-held-expression(row)
        value = emit-held(id, row.expr).operand
    | .node-latest-expression(row)
        value = emit-latest(id, row.expr).operand
    | .node-held-read
        . slot = held-slot(id)
        value = slot-value(slot, id).operand
    | .node-match-expression(row)
        . pattern SyntaxId = 0
        if row.subject == 0 && !row.is-optional && row.helper == 0
            match? tree.nodes[row.body]
                | .node-structure-match(arms)
                    pattern = arms.pattern
        if row.subject != 0 && helper-runs(row.helper)
            . matched = emit-subject-match
                - id
                - row.subject
                - row.body
                - row.is-optional
                - row.helper
                - false
            value = matched.operand
        else
            value = emit-match(id, pattern).operand
    | .node-structure-match(row)
        value = emit-match(id, row.pattern).operand
    | .node-stream-match(row)
        value = emit-scoped-match(id, row.pattern).operand
    | .node-block
        . block = emit-block-value(id, type)
        value = block.operand
        if type == no-type
            type = block.type
    | .node-cast-expression(row)
        if facts.plan-of(unit.reading, id) == .plan-caught-cast
            value = emit-caught-cast(id, row.lhs).operand
        else if facts.plan-of(unit.reading, id) == .plan-reinterpret
            value = reinterpret(id, emit-expression(row.lhs), type).operand
        else if case-cursor-of(row.lhs) != U32.max && cursor-typed
            value = case-cursors[case-cursor-of(row.lhs)].row
        else
            . converted = convert(id, .reason-explicit, emit-expression(row.lhs))
            value = converted.operand
            if converted.type != type
                refuse(.refused-conversion, id)
        .. cursor-typed = case-cursors[case-cursor-of(row.lhs)].type == type
    | .node-type-predicate(row)
        if row.is-contextual
            refuse(.refused-expression, id)
        else
            . emitted = emit-expression(row.expr)
            value = emitted.operand
            if emitted.type != type
                refuse(.refused-conversion, id)
    | .node-function-syntax
        value = emit-closure(id).operand
    | .node-do-task-block(row)
        value = emit-task-value(id, row)
    | .node-c-identifier(row)
        . constant = program.c-constant-text(unit.source-module, row.name)
        if constant
            value = emit-integer(id, constant).operand
        else if is-binding(type)
            value = name-binding(id, type, 0).operand
        else
            refuse(.refused-expression, id)
    | .node-range-expression(row)
        value = emit-range(id, row).operand
    | .node-call-expression(row)
        if is-link(row.callable) && !is-pinned(receiver-of(id))
            value = emit-chained(id).operand
        else
            value = emit-call-at(id, row.callable, row.args).operand
    | .node-optional-chain(row)
        if id != held-chain
            refuse(.refused-expression, id)
        else
            . emitted = emit-expression(row.expr)
            value = emitted.operand
            if emitted.type != type
                refuse(.refused-conversion, id)
    | .node-catch-expression(row)
        if row.catchers.count != 0 && is-caught(row.body)
            value = emit-handled(id, row.body, row.catchers).operand
        else if row.catchers.count != 0 || retyped-body
            refuse(.refused-expression, id)
        else if !is-caught(row.body)
            value = emit-expression(row.body).operand
        else
            value = emit-expression(row.body).operand
            settle-result(id, value)
        .. retyped-body = facts.node-type(unit.reading, row.body) != type
    | .node-use-expression(row)
        value = emit-use(id, row.expr).operand
    | .node-catch-optional-expression(row)
        if is-caught(row.body)
            value = emit-catch-optional(id, row.body).operand
        else
            value = emit-uncaught-optional(id, row.body).operand
    | .node-get-expression(row)
        if is-link(id) && !is-pinned(row.object)
            value = emit-chained(id).operand
        else if row.is-tracked && (live-actions.length != 0 || facts.pulls(unit.reading, id))
            value = emit-tracked-get(id, row.object, row.name).operand
        else
            value = emit-get(id, row.object, row.name).operand
    | .node-index-expression(row)
        . escaped = escaped-event(id)
        if escaped
            value = emit-escape(id, escaped).operand
        else if is-link(id) && !is-pinned(row.object)
            value = emit-chained(id).operand
        else if facts.plan-of(unit.reading, id) == .plan-view || proven-row
            value = emit-view-index(id, row.object, row.index).operand
        else if facts.plan-of(unit.reading, id) == .plan-table
            value = emit-table-index(id, row.object, row.index).operand
        else if facts.plan-of(unit.reading, id) == .plan-item
            value = emit-item(id, row.object, row.index).operand
        else if facts.plan-of(unit.reading, id) == .plan-array-item
            value = emit-array-item(id, row.object, row.index).operand
        else if own-call(id) != no-fact
            value = emit-index-call(id, facts.calls[own-call(id)], row.object, row.index).operand
        else
            value = emit-index(id, row.object).operand
        .. proven-row = facts.plan-of(unit.reading, id) == .plan-proven-row
    | .node-tuple-syntax(row)
        value = emit-tuple(id, row.items).operand
    | .node-header-expression(row)
        value = emit-header(id, row.expr, row.items)
    | .node-list-syntax(row)
        value = emit-list(id, row.items).operand
    | .node-assign(row)
        value = emit-update(id, row.op, row.lhs, row.rhs).operand
    | .node-print(row)
        emit-print(id, row.body)
    | .node-pipeline-expression(row)
        . pipeed = emit-pipe(id, row.op, row.left, row.right)
        value = pipeed.operand
        if pipes-stream(row.op)
            type = pipeed.type
    | .node-iterator-expression(row)
        value = emit-comprehension(id, row.loop).operand
    | .node-iterable-expression(row)
        value = emit-stream(id, row.expr).operand
    | .node-argument(row)
        value = emit-argument-value(id, row)
    | .node-feed-expression
        . listed = emit-feed-list(id)
        value = listed.operand
        type = listed.type
    | .node-anonymous-case(row)
        value = emit-case(id, row.args, facts.plan-of(unit.reading, id) == .plan-case-fields).operand
    | .node-state-machine
        value = emit-machine-site(id).operand
    | .node-markup(row)
        value = emit-markup(id, row.id, row.type-id, row.args, row.body).operand
    | .node-slot-outlet(row)
        value = emit-outlet(id, row.name, row.body)
    | .node-markup-read-expression(row)
        if is-link(id) && !is-pinned(row.object)
            value = emit-chained(id).operand
        else
            value = emit-markup-read(id, row.object).operand
    | .node-style-read-expression(row)
        if is-link(id) && !is-pinned(row.object)
            value = emit-chained(id).operand
        else
            value = emit-style-read(id, row.object).operand
    | .node-style-property-expression
        value = emit-style-property(id).operand
    | .node-ref-identifier
        value = emit-address-of(id)
    | .node-type-identifier
        value = type-value(id, type).operand
    | .node-core-type-identifier
        value = type-value(id, type).operand
    | .node-type-arguments
        value = type-value(id, type).operand
    | .node-symbol
        if facts.plan-of(unit.reading, id) == .plan-case
            value = emit-case(id, RowRange'SyntaxId(), false).operand
        else if facts.plan-of(unit.reading, id) == .plan-enum-value
            value = read-enum(id).operand
        else
            refuse(.refused-expression, id)
    ??
        refuse(.refused-expression, id)
= Typed(value, type)

────────────────────
_ is-link Bool
    - id SyntaxId

` Whether a node is a link of an optional chain: a read, a read of a style or of a markup link
` or an index written after `?`, or one of what such a link gives, or a call of one. It is made
` only where its receiver holds a value.
match tree.nodes[id]
    | .node-get-expression(row)
        chains-at(id, row.is-optional) || is-link(row.object)
    | .node-index-expression(row)
        chains-at(id, row.is-optional) || is-link(row.object)
    | .node-style-read-expression(row)
        chains-at(id, row.is-optional) || (row.object != 0 && is-link(row.object))
    | .node-markup-read-expression(row)
        chains-at(id, row.is-optional) || (row.object != 0 && is-link(row.object))
    | .node-call-expression(row)
        is-link(row.callable)
    ??
        false

────────────────────
_ chains-at Bool
    - id SyntaxId
    - is-optional Bool

is-optional && facts.chain-form(unit.reading, id) != .chain-plain

────────────────────
_ held-type TypeId
    - id SyntaxId

` The type of what an expression gives where it is read: that of the value pinned for it, or
` the node's own.
if held then pins[held].type else facts.node-type(unit.reading, id)

.. held = pin-of(id)

────────────────────
_ do pin
    - node SyntaxId
    - value Operand
    - type TypeId

` Keeps a value for every reading of an expression, until the pins are dropped back to where
` they stood before.
pins += Pin(node, value, type)

────────────────────
_ do unpin
    - mark Size

while pins.length > mark
    pins.pop()

────────────────────
_ do pin-of Size?
    - id SyntaxId

` Where the value pinned last for an expression is, or nothing when none is.
. position = pins.length
while position != 0
    position -= 1
    if pins[position].node == id
        = position
= null

────────────────────
_ is-pinned Bool
    - id SyntaxId

pin-of(id) != null

────────────────────
_ gives Bool
    - id SyntaxId
    - type TypeId

` Whether a type is that of what a node gives by itself: the node's own, or for a link of an
` optional chain what the optional its node has holds.
type == node || (is-link(id) && types.is-optional(node) && types.optional-inner(node) == type)

.. node = facts.node-type(unit.reading, id)

────────────────────
_ unlinked TypeId
    - id SyntaxId

` The type of what a node gives that is never an optional by itself: the node's own, or for
` a link of an optional chain what the optional its node has holds.
|? is-link(id) && node != no-type && node != invalid-type && types.is-optional(node)
    types.optional-inner(node)
??
    node

.. node = facts.node-type(unit.reading, id)

────────────────────
_ receiver-of SyntaxId
    - id SyntaxId

` The receiver of a call of a link of an optional chain: what the name it calls is read from,
` or for a write to an event, what the event is read from.
match tree.nodes[id]
    | .node-call-expression(row)
        receiver-of(called-link(id, row.callable))
    | .node-get-expression(row)
        row.object
    | .node-index-expression(row)
        row.object
    | .node-style-read-expression(row)
        row.object
    | .node-markup-read-expression(row)
        row.object
    ??
        0u32

────────────────────
_ do emit-chained Typed
    - id SyntaxId

` A link of an optional chain, with the links before it. Where an optional the chain tests
` holds nothing no link after it is made, and the chain gives an optional that holds
` nothing. Where each holds a value, what the last link gives is held by the optional the
` node has, unless it is an optional already. A link that gives nothing gives an optional
` that holds nothing, as TypeScript does, so the chain then says nothing of whether it ran.
. nothing = make-operand(.operand-void, 0)
if is-unmade(id)
    = emit-unmade(id)
. type = facts.node-type(unit.reading, id)
if type == no-type || type == invalid-type || !types.is-optional(type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout) && !is-null-form(type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. skipped = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. linked = emit-within(id, skipped)
if linked.type == types.void-type
    linked = empty-optional(type, layout)
else if linked.type != type
    linked = wrap(id, linked, type)
arrive(id, linked.operand, joined, slot)
ir.start-block(skipped)
arrive(id, empty-optional(type, layout).operand, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), type)

────────────────────
_ is-unmade Bool
    - id SyntaxId

facts.node-type(unit.reading, receiver-of(id)) == types.null-type

────────────────────
_ do emit-unmade Typed ?! Refused
    - id SyntaxId

. object = receiver-of(id)
if object == 0
    refuse(.refused-expression, id)
else if tests-receiver(id)
    emit-expression(object)
else
    emit-unmade(object)
= default-value(0, types.null-type, layout-of(types.null-type, id), id)

────────────────────
_ do emit-within Typed
    - id SyntaxId
    - skipped IRBlockId

` What a link of an optional chain gives by itself, where every optional the chain tests
` holds a value. Control leaves to `skipped` where one holds nothing. The link is the read,
` the index or the call its node is, made of the value its receiver holds as it is made of a
` receiver that is no optional.
. nothing = make-operand(.operand-void, 0)
. object = receiver-of(id)
. inside = held-receiver(id, object, skipped)
. pin-mark = pins.length
pin(object, inside.operand, inside.type)
. linked = emit-link(id)
unpin(pin-mark)
= linked

────────────────────
_ do held-receiver Typed ?! Refused
    - id SyntaxId
    - object SyntaxId
    - skipped IRBlockId

` The value a link of an optional chain is made of. A link written after `?` tests the
` optional before it, which is evaluated once, and is made of what that holds. A link
` written with no `?` after another link is made of what that link gives by itself, with no
` optional between the two, as TypeScript unrolls a chain: one that gives nothing, or an
` optional, has no shape here. A tracked read's object that is a member named alone is
` tracked before it is tested, as `emit-tracked-get` says.
. nothing = make-operand(.operand-void, 0)
if object == 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if !tests-receiver(id)
    . given = emit-within(object, skipped)
    if given.type == types.void-type || types.is-optional(given.type)
        refuse(.refused-expression, id)
    = given
. root = tracked-root(object) if tracks-link(id)
if root
    track(object, unit.self, root)
. receiver = emit-expression(object)
. held = receiver.type
if !types.is-optional(held)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. tested = present(object, receiver)
. filled = ir.reserve-block()
branch(tested.operand, filled, skipped)
ir.start-block(filled)
= payload(object, Typed(receiver.operand, held))

────────────────────
_ tests-receiver Bool
    - id SyntaxId

` Whether a link of an optional chain is written after `?`, or is a call of one that is.
match tree.nodes[id]
    | .node-get-expression(row)
        chains-at(id, row.is-optional)
    | .node-index-expression(row)
        chains-at(id, row.is-optional)
    | .node-style-read-expression(row)
        chains-at(id, row.is-optional)
    | .node-markup-read-expression(row)
        chains-at(id, row.is-optional)
    | .node-call-expression(row)
        tests-receiver(called-link(id, row.callable))
    ??
        false

────────────────────
_ do called-link SyntaxId
    - id SyntaxId
    - callable SyntaxId

if facts.event-uses.length != 0
    . used = tables.event-use-of(unit.reading, id)
    if used && (used.kind == .event-publish || used.kind == .event-route)
        match? tree.nodes[used.reference]
            | .node-index-expression(row)
                = row.object
        = used.reference
= callable

────────────────────
_ do emit-link Typed
    - id SyntaxId

` A link of an optional chain, made of the value its receiver holds: the read, the read of a
` style, the index or the call the node is, as it is made of a receiver that is no optional.
. nothing = make-operand(.operand-void, 0)
match? tree.nodes[id]
    | .node-get-expression(row)
        . plan = facts.plan-of(unit.reading, id)
        if row.is-tracked && (live-actions.length != 0 || facts.pulls(unit.reading, id))
            = emit-tracked-get(id, row.object, row.name)
        if plan == .plan-none || plan == .plan-field || plan == .plan-guarded-read || address-plan
            = emit-get(id, row.object, row.name)
        .. address-plan = plan == .plan-address || plan == .plan-reinterpret
    | .node-index-expression(row)
        if facts.plan-of(unit.reading, id) == .plan-item
            = emit-item(id, row.object, row.index)
        if facts.plan-of(unit.reading, id) == .plan-array-item
            = emit-array-item(id, row.object, row.index)
        if own-call(id) != no-fact
            = emit-index-call(id, facts.calls[own-call(id)], row.object, row.index)
        = emit-index(id, row.object)
    | .node-call-expression(row)
        = emit-call-at(id, row.callable, row.args)
    | .node-style-read-expression(row)
        = emit-style-read(id, row.object)
    | .node-style-property-expression
        = emit-style-property(id)
    | .node-markup-read-expression(row)
        = emit-markup-read(id, row.object)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do emit-caught-cast Typed
    - id SyntaxId
    - lhs SyntaxId

` A cast out of a union written under `catch`: what the union holds as the case asked for,
` as the value of what may be an error, and where it holds another case the error that is
` elsewhere the message of the panic raised. The error is given no source and no trace.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. made-error = instances.report.union-error
if !carries-error(type) || !tables.layouts.is-union(layout) || in-zone
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.layouts.rows[layout].cases.count != 2 || made-error == no-instance
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.instance-functions[made-error] == no-function
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. value = emit-expression(lhs)
. first = tables.layouts.case-field(layout, 0)
. second = tables.layouts.case-field(layout, 1)
. made = frame(layout)
zero(made, layout)
. failed = ir.reserve-block()
. joined = ir.reserve-block()
. own-matching = matching
. jumps = fail-jumps
matching = matching.failing = failed
. held = convert(id, .reason-explicit, value)
matching = own-matching
if held.type != first.type
    refuse(.refused-conversion, id)
put(made, first, held.operand, id)
jump(joined)
if fail-jumps != jumps
    ir.start-block(failed)
    . mark = pending.length
    for position in 0 .. < instances.signatures[made-error].args.count
        pending += absent-argument(id, instances.argument-type(made-error, position)).operand
    . error = nothing
    . called = call-instance(made-error, id, mark)
    error = called.operand
    if called.type != second.type
        refuse(.refused-conversion, id)
    store(made, 0, integer(.machine-u8, 1), false, id)
    put(made, second, error, id)
    jump(joined)
ir.start-block(joined)
= Typed(made, type)

────────────────────
_ do emit-handled Typed
    - id SyntaxId
    - body SyntaxId
    - catchers RowRange'SyntaxId
    - dropped Bool = false

` An expression with handlers: what it gives where no error was raised in its place, and
` else what the first handler that takes the error gives. A handler is a pattern the error
` is matched against, with what it captures, and its body. An error the type pass said no
` handler takes leaves the function, as one raised there would. A handler whose body is a
` block runs its statements, and its last gives the value. A handler that gives an
` error raises nothing: the whole is then a value that may be that error. An expression
` whose own value is an error has no shape here. One written as a statement, whose value is
` `dropped`, gives nothing: each handler runs its body for what it does. An error that came
` back outside the zone the collector never sees is handled there, and a handler that goes on
` enters the zone again where the caller runs in it. A handler the type pass found can not
` match is passed over. An optional chain to a call that raises is tested first: where it
` made no call the whole gives `null` as the type pass joined it, and handlers take the errors
` of the call it made.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. fact = facts.constant-of(unit.reading, id)
if facts.plan-of(unit.reading, id) != .plan-handled || fact == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. leaving = facts.constants[fact].bits
. raw = emit-expression(body)
. answer = take-zone-answer()
. zoned = in-zone
. held = raw.type
. absent = no-block
if types.is-optional(held) && carries-error(types.optional-inner(held))
    . tested = present(id, raw)
    . filled = ir.reserve-block()
    absent = ir.reserve-block()
    branch(tested.operand, filled, absent)
    ir.start-block(filled)
    raw = payload(id, Typed(raw.operand, held))
    held = raw.type
if !carries-error(held)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. layout = layout-of(held, id)
. gives = !dropped && type != no-type && type != invalid-type && type != types.void-type
. made = if gives then layout-of(type, id) else void-layout
. first = tables.layouts.case-field(layout, 0)
if extends(first.type, types.error-type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. joined = ir.reserve-block()
. slot = if gives then join-slot(made) else nothing
. mark = joins.length
. given = ir.reserve-block()
. raised = ir.reserve-block()
branch(case-test(id, raw.operand, 0), given, raised)
ir.start-block(given)
settle-zone-answer(id, answer)
if gives
    give-handled(id, Typed(take(raw.operand, first, id), first.type), type, joined, slot)
else
    jump(joined)
ir.start-block(raised)
if closes-zone(answer)
    close-zone(id)
if answer != 0
    in-zone = false
for catcher in tree.children[catchers]
    match? tree.nodes[catcher]
        | .node-catcher(row)
            if facts.plan-of(unit.reading, catcher) == .plan-never
                continue
            . next = ir.reserve-block()
            . named = bound.length
            emit-pattern(row.type, Typed(raw.operand, held), next)
            if !gives
                emit-block(row.body)
                rejoin-zone(id, answer, zoned)
                jump(joined)
            else if !arm-raises(row.body)
                . expression = only-expression(row.body)
                if tree.is-block(row.body)
                    . opened = open-cleanups.length
                    . own-scoping = scoping
                    scoping = scoping.block-base = opened
                    if expression == 0
                        expression = emit-leading(row.body)
                    if expression == 0
                        refuse(.refused-expression, row.body)
                    else
                        . value = emit-expression(expression)
                        . closed = close-value(value, opened, own-scoping, expression)
                        rejoin-zone(id, answer, zoned)
                        give-handled(id, closed, type, joined, slot)
                else if expression == 0
                    refuse(.refused-expression, row.body)
                else
                    . value = emit-expression(expression)
                    rejoin-zone(id, answer, zoned)
                    give-handled(id, value, type, joined, slot)
            drop-bound(named)
            ir.start-block(next)
. bit U64 = 1
for index in 1 .. < tables.layouts.rows[layout].cases.count
    . place = bit
    bit = bit * 2
    if (leaving /and/ place) == 0
        continue
    . field = tables.layouts.case-field(layout, index)
    . leaves = ir.reserve-block()
    . next = ir.reserve-block()
    branch(case-test(id, raw.operand, index), leaves, next)
    ir.start-block(leaves)
    leave-with(take(raw.operand, field, id), field.type, id)
    ir.start-block(next)
return-zero(.return-normal)
in-zone = zoned
if absent != no-block
    ir.start-block(absent)
    if gives
        give-handled
            - id
            - default-value(0, types.null-type, layout-of(types.null-type, id), id)
            - type
            - joined
            - slot
    else
        jump(joined)
if !gives
    ir.start-block(joined)
    = Typed(nothing, types.void-type)
. result = close-joins(joined, mark, made, slot)
= Typed(result, type)

────────────────────
_ do give-handled
    - id SyntaxId
    - value Typed
    - type TypeId
    - joined IRBlockId
    - slot Operand

` Leaves what one side of an expression with handlers gives for the whole. Where the whole
` is a value that may be an error, because some handler gives one, a side that gives an
` error is held as the case of its class or of the nearest above it, and any other side as
` the value. Else the side is converted as the sides record for its type, and one that
` gives an error has no shape.
. given = value
. is-error = extends(given.type, types.error-type)
if !carries-error(type)
    if is-error
        refuse(.refused-expression, id)
        =
    if given.type != type
        given = join(id, Typed(value.operand, given.type))
    if given.type != type
        refuse(.refused-conversion, id)
    arrive(id, given.operand, joined, slot)
    =
. layout = layout-of(type, id)
if is-error
    . index = error-case-of(layout, given.type)
    if index == U32.max
        refuse(.refused-expression, id)
        =
    given = make-union(id, type, index, Typed(value.operand, tables.layouts.case-field(layout, index).type))
else
    . inner = tables.layouts.case-field(layout, 0).type
    if given.type != inner
        given = join(id, Typed(value.operand, given.type))
    if given.type != inner
        refuse(.refused-conversion, id)
    given = make-union(id, type, 0, given)
arrive(id, given.operand, joined, slot)

────────────────────
_ do arm-raises Bool
    - body SyntaxId

` Whether the body of an arm that is to give a value leaves in place of it, as the type pass
` noted: its last statement raises under no condition, returns, or goes on to a loop's next
` turn or out of it. The body is emitted here, and what follows it is never run.
if !facts.is-leaving(unit.reading, body)
    = false
emit-block(body)
= true

────────────────────
_ is-caught Bool
    - body SyntaxId

` Whether what is written under `catch` is a call, whose errors are what the catch holds, an
` operator or an index a function answers, or a cast, which the type pass planned to give an
` error where it is out of a union and fails. Nothing else has a shape there.
match tree.nodes[body]
    | .node-call-expression
        true
    | .node-index-expression
        own-call(body) != no-fact
    | .node-identifier
        true
    | .node-get-expression
        true
    | .node-cast-expression
        true
    | .node-unary-expression
        own-call(body) != no-fact
    | .node-binary-expression
        own-call(body) != no-fact
    ??
        false

────────────────────
_ do emit-catch-optional Typed
    - id SyntaxId
    - body SyntaxId

` `catch? value`: what the expression gives as an optional, which holds nothing where an
` error was raised in its place. An expression that raises nothing gives its value so, and
` one that gives nothing or an optional gives it as it is. A value that is itself an optional
` and may be an error is that optional, or one that holds nothing where an error was raised.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. raw = emit-expression(body)
. raw-type = raw.type
settle-result(id, raw.operand)
if types.is-optional(raw-type) && carries-error(types.optional-inner(raw-type))
    = catch-held(id, Typed(raw.operand, raw-type), type)
if !carries-error(raw-type)
    if raw-type == type
        = Typed(raw.operand, raw-type)
    = wrap(id, Typed(raw.operand, raw-type), type)
= caught(id, Typed(raw.operand, raw-type), type)

────────────────────
_ do emit-uncaught-optional Typed
    - id SyntaxId
    - body SyntaxId

` `catch? value` over what is no call and so raises nothing: the value as an optional.
. type = facts.node-type(unit.reading, id)
. raw = emit-expression(body)
if carries-error(raw.type)
    refuse(.refused-expression, id)
    = raw
if raw.type == type
    = raw
= wrap(id, raw, type)

────────────────────
_ do catch-held Typed
    - id SyntaxId
    - raw Typed
    - type TypeId

` `catch?` of an optional that holds a value or an error raised in its place, as an optional
` chain to a call that raises gives: nothing where it holds nothing, and otherwise what holds
` the value, or nothing where an error was raised.
. nothing = make-operand(.operand-void, 0)
. held = raw.type
. made-layout = layout-of(type, id)
. tested = present(id, raw)
. given = ir.reserve-block()
. other = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(made-layout)
. mark = joins.length
branch(tested.operand, given, other)
ir.start-block(given)
. inner = payload(id, Typed(raw.operand, held))
. made = caught(id, inner, type)
arrive(id, made.operand, joined, slot)
ir.start-block(other)
arrive(id, empty-optional(type, made-layout).operand, joined, slot)
= Typed(close-joins(joined, mark, made-layout, slot), type)

────────────────────
_ do caught Typed
    - id SyntaxId
    - raw Typed
    - type TypeId

` What holds the value of an expression that may be an error raised in its place, or nothing
` where one was raised.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(raw.type, id)
. made-layout = layout-of(type, id)
. nullable = is-null-form(type)
if !tables.layouts.is-union(layout) || !types.is-optional(type) || unstructured
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. unstructured = !tables.layouts.is-struct(made-layout) && !nullable
. field = tables.layouts.case-field(layout, 0)
. held = types.optional-inner(type)
if field.type == type || (nullable && field.type == held)
    . slot = join-slot(made-layout)
    . mark = joins.length
    . given = ir.reserve-block()
    . other = ir.reserve-block()
    . joined = ir.reserve-block()
    branch(case-test(id, raw.operand, 0), given, other)
    ir.start-block(given)
    arrive(id, take(raw.operand, field, id), joined, slot)
    ir.start-block(other)
    arrive(id, empty-optional(type, made-layout).operand, joined, slot)
    = Typed(close-joins(joined, mark, made-layout, slot), type)
if nullable
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. inner = tables.layouts.field(made-layout, 0)
. flag = tables.layouts.field(made-layout, 1)
. holds = field.layout != void-layout
if types.is-optional(field.type) || (holds && (field.type != held || field.layout != inner.layout))
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if !holds && inner.layout != i8-layout
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. made = frame(made-layout)
zero(made, made-layout)
empty-texts(made, 0, type, made-layout, id)
. given = ir.reserve-block()
. joined = ir.reserve-block()
branch(case-test(id, raw.operand, 0), given, joined)
ir.start-block(given)
if holds
    put(made, inner, take(raw.operand, field, id), id)
store(made, flag.offset, integer(.machine-i8, 1), false, id)
jump(joined)
ir.start-block(joined)
= Typed(made, type)

────────────────────
_ carries-error Bool
    - type TypeId

` Whether a type is a value or one of the errors raised in its place.
match types.rows[type]
    | .type-result
        true
    ??
        false

────────────────────
_ do emit-held Typed ?! Refused
    - id SyntaxId
    - expr SyntaxId

` The middle of a chain of orderings is evaluated once, and its value is kept under its slot
` for the ordering that reads it. The value has the node's type.
. nothing = make-operand(.operand-void, 0)
. slot = held-slot(id)
. offset = slot-offset(slot, id)
. value = emit-expression(expr)
if value.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
unit.kept[offset] = value.operand
unit.kept-types[offset] = value.type
= value

────────────────────
_ do held-by U32
    - ordering SyntaxId

` The place of the slot an ordering keeps its right side under, for the ordering after it in
` a chain. No place for any other expression.
match? tree.nodes[ordering]
    | .node-binary-expression(row)
        match? tree.nodes[row.rhs]
            | .node-held-expression
                . slot = held-slot(row.rhs)
                = slot-offset(slot, row.rhs)
= no-place

────────────────────
_ do held-slot SlotId
    - id SyntaxId

` The slot the middle of a chain of orderings is kept under, which the node that holds it
` and the node that reads it both resolve to.
. binding = instances.rows[unit.reading].binding
if binding != no-binding
    . resolution = bindings.resolution-of(binding, id)
    if resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-held
        = resolution.slot
refuse(.refused-expression, id)
= unit.slot-start

────────────────────
_ do slot-value Typed ?! Refused
    - slot SlotId
    - id SyntaxId

` The value kept under the slot of a chain's middle, for the ordering that reads it. It is
` there only in the right side of the `&&` whose left side holds it: every path to that side
` has evaluated the middle. The value has the node's type.
. nothing = make-operand(.operand-void, 0)
. offset = slot-offset(slot, id)
if offset != unit.open-held || operand-kind(unit.kept[offset]) == .operand-void
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if unit.kept-types[offset] != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
= Typed(unit.kept[offset], unit.kept-types[offset])

────────────────────
_ do is-consumable Bool
    - id SyntaxId

` Whether every conversion recorded at a node is one a shape here applies.
. fact = facts.first-conversion(unit.reading, id)
while fact != no-fact
    . row = facts.conversions[fact]
    if !is-applied(row.reason)
        = false
    fact = row.next
= true

────────────────────
_ do emit-integer Typed
    - id SyntaxId
    - text String

` An integer literal as a number of the type it is written as: its bits cut to the width of
` the type and extended by the sign of its layout, or the float nearest it. A unit whose
` class has a constructor is constructed from the number.
. nothing = make-operand(.operand-void, 0)
. literal = parse-integer-literal(text)
if literal.overflow
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. type = written-type(id)
. layout = layout-of(type, id)
if is-float(layout)
    . magnitude = literal.value as F64
    = construct-unit
        - id
        - float-number(layout, if literal.negative then -magnitude else magnitude)
        - type
if !is-integer(layout)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. bits = if literal.negative then 0 - literal.value else literal.value
. width = types.completions[builtin-number(types, type)].bit-size
if width == 0
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
if width < 64
    . mask = (1u64 /lshift/ width) - 1
    . is-negative = (bits /zrshift/ (width - 1)) /and/ 1 == 1
    bits = bits /and/ mask
    if is-negative && is-signed(layout) && width == tables.layouts.rows[layout].size * 8
        bits = bits /or/ (U64.max - mask)
= construct-unit(id, integer(tables.layouts.kind-of(layout), bits), type)

────────────────────
_ do written-type TypeId
    - id SyntaxId

` The type a number is written as: its node's, or with a unit whose class has a constructor
` the type of what the constructor takes, which the type pass recorded as a call at the node.
. call = answering(facts.first-call(unit.reading, id))
if call == no-fact
    = facts.node-type(unit.reading, id)
. row = facts.calls[call]
. called = row.callee != no-instance && !row.is-partial && row.next == no-fact
. constructs = row.form == .call-constructor || row.form == .call-this-constructor
if !called || !constructs || instances.signatures[row.callee].args.count != 1
    refuse(.refused-expression, id)
    = no-type
= instances.argument-type(row.callee, 0)

────────────────────
_ do construct-unit Typed
    - id SyntaxId
    - number Operand
    - type TypeId

` A number as its literal gives it: the number itself, or with a unit whose class has a
` constructor what the constructor returns for the number.
. call = answering(facts.first-call(unit.reading, id))
if call == no-fact
    = Typed(number, type)
. mark = pending.length
pending += number
. made = call-instance(facts.calls[call].callee, id, mark)
if made.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
= made

────────────────────
_ do emit-float Typed
    - id SyntaxId
    - text String

` A float literal as the float of the type it is written as nearest to what it writes. A
` unit whose class has a constructor is constructed from the number.
. nothing = make-operand(.operand-void, 0)
. type = written-type(id)
. layout = layout-of(type, id)
if !is-float(layout)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
for index in 0 .. < text.length
    . char = text[index]
    . is-digit = char >= '0' && char <= '9'
    . is-sign = char == '+' || char == '-'
    if !is-digit && !is-sign && char != '.' && char != 'e' && char != 'E'
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
= construct-unit(id, float-number(layout, text as F64), type)

────────────────────
_ do float-number Operand
    - layout LayoutId
    - value F64

= make-operand(.operand-number, ir.add-float(tables.layouts.kind-of(layout), value))

────────────────────
_ do integer Operand
    - kind MachineKind
    - bits U64

= make-operand(.operand-number, ir.add-number(kind, bits))

────────────────────
_ do convert Typed
    - site SyntaxId
    - reason ConversionReason
    - value Typed
    - raised SyntaxId = 0
    - shared Bool = false

` Applies the conversions the type pass recorded at a site for one reason, in order. A panic
` one of them raises is raised at the site, or at the node given for it. The name of a lazy
` local that its one read evaluates has the conversion of that read recorded at the value it
` is declared with, and takes there the ones that convert what was read. A text written in
` source that a function returns has its conversion recorded for a reason of its own. A stream
` piped through a function keeps the conversion of the function at the pipe beside those of
` its own value, and only those that take the value's type apply there, as they do where the
` value is `shared` by calls that each recorded its own.
. result = value
. found = false
. several = shared || keeps-several(site)
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact
    . row = facts.conversions[fact]
    . fits = row.reason == reason || literal-return
        .. literal-return = reason == .reason-return && row.reason == .reason-literal-return
    if fits && (!several || row.from == result.type)
        result = convert-one(site, row, result, raised)
        found = true
    fact = row.next
if found || !unit.inlines
    = result
. declared = inlined-value(site)
if declared == 0
    = result
fact = facts.first-conversion(unit.reading, declared)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == reason && row.from == result.type
        result = convert-one(site, row, result, raised)
    fact = row.next
= result

────────────────────
_ do keeps-several Bool
    - site SyntaxId

` Whether a node keeps the conversions of several values: a stream piped through a function,
` a subscription an object owns, where the subscriber, the subscription and its tracker are
` each converted, or the name of a keyed event whose endpoint the receiver claims, where the
` endpoint and its tracker are.
if tables.owned-subscription-of(unit.reading, site) || claimed-or-read
    = true
.. claimed-or-read = facts.address-claim-of(unit.reading, site) || facts.latest-read-of(unit.reading, site)
match? tree.nodes[site]
    | .node-pipeline-expression(row)
        = pipes-stream(row.op)
    | .node-binary-expression(row)
        = pipes-stream(row.op)
= false

────────────────────
_ do inlined-value SyntaxId
    - id SyntaxId

` The value a lazy local is declared with, for a node that is the one read of the local and
` evaluates it. No node for any other.
if id == 0 || unit.instance == no-instance || unit.reading != unit.instance
    = 0
. binding = instances.rows[unit.instance].binding
if binding == no-binding
    = 0
match? tree.nodes[id]
    | .node-identifier
        . resolution = bindings.resolution-of(binding, id)
        if resolution.kind == .resolve-slot && bindings.lazy-inlines(resolution.slot)
            match? tree.nodes[bindings.slots[resolution.slot].group]
                | .node-declare(declaration)
                    = declaration.right
= 0

────────────────────
_ do convert-fill Typed
    - site SyntaxId
    - value Typed

` Converts what a constructor fills a property from to the property's type. The type pass
` records the conversion at the argument, or at the property, which is no node of the
` constructor's body.
if facts.first-conversion(unit.reading, site) != no-fact
    = convert(site, .reason-assignment, value)
. result = value
. fact = tables.loose-conversion(unit.instance, site, result.type)
while fact != no-fact
    . held = result.type
    result = convert-one(site, facts.conversions[fact], result)
    fact = if result.type != held then next-conversion else no-fact
        .. next-conversion = tables.loose-conversion(unit.instance, site, result.type)
= result

────────────────────
_ do convert-self Typed
    - site SyntaxId
    - reason ConversionReason

` The object being made converted as the type pass recorded at a site, which may be no node of
` the function's body, as `convert-fill` finds it. Refused where none was recorded.
if facts.first-conversion(unit.reading, site) != no-fact
    = convert(site, reason, Typed(unit.self, instances.rows[unit.reading].self-type))
. fact = tables.loose-conversion(unit.reading, site, instances.rows[unit.reading].self-type, reason)
if fact == no-fact
    refuse(.refused-function, site)
    = Typed(unit.self, no-type)
= convert-one(site, facts.conversions[fact], Typed(unit.self, instances.rows[unit.reading].self-type))

────────────────────
_ do convert-from Typed
    - site SyntaxId
    - reason ConversionReason
    - value Operand

` Applies the conversions the type pass recorded at a site for one reason, as `convert` does,
` to a value of the type the first of them converts from.
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == reason
        = convert(site, reason, Typed(value, row.from))
    fact = row.next
refuse(.refused-conversion, site)
= Typed(value, no-type)

────────────────────
_ do convert-one Typed ?! Refused
    - site SyntaxId
    - row ConversionFact
    - value Typed
    - raised SyntaxId = 0

` Applies one conversion the type pass recorded to a value of the type it converts from, as the
` reference converts it; an unwrap that fails is reported at `raised` where one is given.
if row.from != value.type
    refuse(.refused-conversion, site)
    = value
. kind = row.kind
if row.runs != no-instance || row.casts
    = make-function(site, row, value.operand)
if row.from == types.null-type && types.is-optional(row.to)
    . empty = layout-of(row.to, site)
    if !tables.layouts.is-struct(empty) && !is-null-form(row.to)
        refuse(.refused-conversion, site)
    = empty-optional(row.to, empty)
if kind == .relation-wrap-cast && row.case-index != U32.max
    = wrap-case(site, row, value)
if intrinsic(row.from) == .union
    . to-text = row.to == types.string-type
    if to-text && (kind == .relation-unwrap-cast || kind == .relation-string-cast)
        = union-text(site, row, value.operand)
    if kind == .relation-unwrap-cast || kind == .relation-down-cast
        = unwrap-case(if raised == 0 then site else raised, row, value.operand)
    if kind == .relation-final-cast && intrinsic(row.to) == .union
        = rewrap(site, row, value.operand)
if kind == .relation-unwrap-cast && view-shape(row.from) == 4 && row.to == viewed-item(row.from)
    = row-item(site, value.operand, row.from)
if kind == .relation-unwrap-cast && holds-row(row.from) && row.to == table-row-type(row.from)
    = table-row-item(site, value.operand, row.from)
if kind == .relation-unwrap-cast && holds-row(row.from) && union-row
    = shared-base(site, value.operand, row.from, row.to)
.. union-row = intrinsic(table-row-type(row.from)) == .union
if kind == .relation-side-cast && view-shape(row.from) != 0 && view-shape(row.to) != 0
    = Typed(value.operand, row.to)
if kind == .relation-side-cast && intrinsic(row.to) == .table-span && intrinsic(row.from) == .tuple
    = zip-span(site, value.operand, row.from, row.to)
if kind == .relation-unwrap-cast && optional-from && types.null-case(row.to) != U32.max
    = unwrap-or-null(site, row, value)
.. optional-from = types.is-optional(row.from)
if kind == .relation-unwrap-cast && types.is-optional(row.from) && text-to-pointer
    = text-or-null(site, row, value)
.. text-to-pointer = is-text(types.optional-inner(row.from)) && intrinsic(row.to) == .cpointer
if kind == .relation-unwrap-cast && types.is-optional(row.from)
    . held = unwrap(if raised == 0 then site else raised, value)
    if held.type == row.to
        = held
    if intrinsic(held.type) == .union && row.case-index != U32.max
        . inner = row
        inner.from = held.type
        = unwrap-case(if raised == 0 then site else raised, inner, held.operand)
    . scalar = is-numeric-type(held.type) || intrinsic(held.type) == .cpointer
    if row.callee == no-instance && scalar && scalar-target
        = cast(site, held, row.to)
    .. scalar-target = is-numeric-type(row.to) || intrinsic(row.to) == .cpointer
    if row.callee == no-instance && tables.is-class(held.type) && intrinsic(row.to) == .cpointer
        = cast(site, held, row.to)
    if row.callee == no-instance && interface-value && intrinsic(row.to) == .cpointer
        = held-object(site, held.operand, row.to)
    .. interface-value = intrinsic(held.type) == .interface
    if row.callee == no-instance && union-value && intrinsic(row.to) == .cpointer
        = union-object(site, held, row.to)
    .. union-value = intrinsic(held.type) == .union
    if row.callee == no-instance && tables.is-class(held.type) && descends(row.to, held.type)
        = down-cast
            - if raised == 0 then site else raised
            - held.operand
            - row.to
            - row.reason == .reason-declaration
    refuse(.refused-conversion, site)
    = value
if kind == .relation-same
    if layout-of(row.from, site) != layout-of(row.to, site)
        refuse(.refused-conversion, site)
    = Typed(value.operand, row.to)
if kind == .relation-interface-cast
    = make-interface(site, row.from, row.to, value.operand)
if kind == .relation-string-cast && intrinsic(row.from) == .type-relation && is-text(row.to)
    = Typed(value.operand, row.to)
if kind == .relation-equal
    = equalize(site, value, row.to, row.ratio)
if kind == .relation-up-cast && tables.is-class(row.from) && tables.is-class(row.to)
    = Typed(value.operand, row.to)
. declared = row.reason == .reason-declaration
if kind == .relation-down-cast && tables.is-class(row.from) && tables.is-class(row.to)
    = down-cast(if raised == 0 then site else raised, value.operand, row.to, declared)
if kind == .relation-interface-down-cast && tables.is-class(row.from)
    = subclass-interface(if raised == 0 then site else raised, value.operand, row.from, row.to, declared)
if kind == .relation-interface-down-cast
    = held-as(if raised == 0 then site else raised, value.operand, row.to, declared)
if kind == .relation-up-cast || kind == .relation-string-cast
    if is-text(row.from) && is-text(row.to)
        = Typed(value.operand, row.to)
if kind == .relation-up-cast && is-aggregate(row.from) && is-aggregate(row.to)
    . base = layout-of(row.to, site)
    . derived = layout-of(row.from, site)
    if !is-leading(base, derived)
        refuse(.refused-conversion, site)
        = value
    . led = snapshot(value.operand, base, site)
    = Typed(led, row.to)
if kind == .relation-string-cast && row.parts != no-fact && is-text(row.to)
    = tuple-text(site, row, value.operand)
if kind == .relation-final-cast && row.parts != no-fact
    = recast(site, row, value.operand)
if final-or-side && row.to == types.bool-type && row.callee != no-instance
    . asked = tables.instance-functions[row.callee]
    . raises = asked != no-function && asked-panics
        .. asked-panics = tables.functions[asked].may-panic || tables.raises-through(row.callee)
    if raises && !function.may-panic
        refuse(.refused-conversion, site)
        = value
    . tested = ask-empty(site, value, row.callee)
    = Typed(tested.operand, row.to)
.. final-or-side = kind == .relation-final-cast || kind == .relation-side-cast
if kind == .relation-final-cast && plain-bool && is-number(layout-of(row.from, site))
    = cast(site, value, row.to)
.. plain-bool = row.to == types.bool-type && row.parts == no-fact
if kind == .relation-final-cast && row.to == types.bool-type && row.parts == no-fact && from-pointer
    = compare-zero(site, value, .compare-not-equal)
.. from-pointer = intrinsic(row.from) == .cpointer
if kind == .relation-string-cast && is-text(row.to) && void-return
    = Typed(make-operand(.operand-constant, ir.add-string("")), row.to)
.. void-return = row.reason == .reason-return && intrinsic(row.from) == .void
if kind == .relation-string-cast && is-text(row.to)
    . text = string-cast-text(types, row.from)
    if text && (row.reason != .reason-return || intrinsic(row.from) != .void)
        = Typed(make-operand(.operand-constant, ir.add-string(text)), row.to)
if kind == .relation-side-cast
    if types.is-optional(row.to) && !types.is-optional(row.from)
        . held = if row.parts == no-fact then value else convert-one(site, parts-row, value)
            .. parts-row = facts.conversion-parts[row.parts]
        = wrap(site, held, row.to)
    if both-optional && row.parts != no-fact && !holds-atom(row.to)
        = rehouse(site, row, value)
    .. both-optional = types.is-optional(row.to) && types.is-optional(row.from)
    if is-text(row.to) && intrinsic(row.from) == .cpointer
        = adopt(site, value.operand, row.to)
    if intrinsic(row.to) == .cpointer && intrinsic(row.from) == .interface
        = held-object(site, value.operand, row.to)
    if intrinsic(row.to) == .cpointer && intrinsic(row.from) == .union
        = union-object(site, value, row.to)
    = cast(site, value, row.to)
if kind == .relation-converter && row.callee == no-instance && row.to == types.bool-type
    if types.is-optional(row.from)
        = present(site, value)
if kind == .relation-fromverter && row.callee == no-instance
    = number-enum(site, row, value.operand)
. gives = kind == .relation-converter
if kind == .relation-fromverter && row.callee != no-instance
    gives = instances.argument-type(row.callee, 0) == row.from
if gives && row.callee != no-instance
    . raising = instances.signatures[row.callee].errors.count != 0
    . mark = pending.length
    pending += value.operand
    takes-result = raising
    . converted = call-method(row.callee, site, mark)
    takes-result = false
    if raising
        converted = settle-raise(if raised == 0 then site else raised, row, converted.operand)
    if converted.type != row.to
        refuse(.refused-conversion, site)
    = converted
refuse(.refused-conversion, site)
= value

────────────────────
_ do make-interface Typed
    - site SyntaxId
    - from TypeId
    - to TypeId
    - value Operand

` A value converted to an interface: memory in the frame that holds the value and its
` witness table. An object's table is the one the table of its class holds for the
` interface, so an object held as a class it is derived from has its own. A value of an
` interface derived from the one asked for keeps what it holds, and its table is that
` interface's section of the one it has. A value that is no object is boxed, and its table
` is the one of its type, named here; code the collector never sees boxes nothing.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(to, site)
if layout != tables.layouts.interface-layout
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. second = tables.layouts.field(layout, 1).offset
. held = value
. table = nothing
. witness = tables.witness-of(from, to)
if intrinsic(from) == .interface
    . offset = tables.section-offset(from, to)
    if offset == no-slot-index
        refuse(.refused-conversion, site)
        = Typed(nothing, no-type)
    held = load(value, 0, managed-layout, site)
    table = load(value, second, pointer-layout, site)
    if offset != 0
        table = address(table, offset * table-slot-size, pointer-layout, site)
else if tables.is-class(from) && witness != no-slot-index && slotted-witness
    . class-table = load(value, 0, pointer-layout, site)
    . place = table-header-size + tables.witnesses[witness].slot * table-slot-size
    table = load(class-table, place, pointer-layout, site)
else if witness != no-slot-index && !tables.is-class(from) && !in-zone
    held = box(site, from, value)
    table = make-operand(.operand-symbol, tables.witnesses[witness].symbol)
else
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
.. slotted-witness = tables.witnesses[witness].slot != no-slot-index
. made = frame(layout)
store(made, 0, held, false, site)
store(made, second, table, false, site)
= Typed(made, to)

────────────────────
_ do box Operand
    - site SyntaxId
    - type TypeId
    - value Operand

` What an interface value holds of a value that is no object: a whole number widened to
` the size of a pointer, and anything else a copy in an object the collector owns.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(type, site)
if layout == void-layout
    refuse(.refused-conversion, site)
    = nothing
if is-integer(layout)
    = num-cast(site, value, layout, u64-layout)
. shape = tables.layouts.rows[layout]
. mark = pending.length
pending += integer(.machine-u64, shape.size)
if shape.is-managed
    pending += make-operand(.operand-descriptor, layout)
else
    pending += integer(.machine-pointer, 0)
. made = call-runtime(.runtime-allocate-object, site, mark, managed-layout)
if tables.layouts.is-struct(layout)
    copy(made, value, layout, shape.is-managed, site)
else
    store(made, 0, value, shape.is-managed, site)
= made

────────────────────
_ do unbox Typed
    - site SyntaxId
    - type TypeId
    - source Operand

` What an interface value holds, as its type holds it: an object as it is, a whole number
` narrowed again, and anything else a copy of what the object it was boxed in holds.
if tables.is-class(type)
    = Typed(load(source, 0, managed-layout, site), type)
. layout = layout-of(type, site)
if layout == void-layout
    refuse(.refused-conversion, site)
    = Typed(source, no-type)
if is-integer(layout)
    = Typed(num-cast(site, load(source, 0, u64-layout, site), u64-layout, layout), type)
. held = load(source, 0, managed-layout, site)
if tables.layouts.is-struct(layout)
    = Typed(snapshot(held, layout, site), type)
= Typed(load(held, 0, layout, site), type)

────────────────────
_ do settle-raise Typed
    - site SyntaxId
    - row ConversionFact
    - result Operand

` The value of a conversion by a function that raises errors, as the type pass settled it:
` an error leaves the function, or is a panic where the value is a text written in source.
` Where the type pass settled nothing there is no shape.
if row.raise == .raise-leaves
    = propagate(site, row.callee, result)
if row.raise == .raise-panics
    = panic-on-error(site, row.callee, result)
refuse(.refused-conversion, site)
= Typed(result, no-type)

────────────────────
_ do number-enum Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A whole number converted to an enum by its place: the value the enum declares at that
` place, counted from zero in the order declared, which the module that declares it made as
` it started. For any other number the enum is constructed with nothing given, by the call
` the type pass recorded at the node.
. nothing = make-operand(.operand-void, 0)
. made = no-fact
. fact = facts.first-call(unit.reading, site)
while fact != no-fact
    if facts.calls[fact].form == .call-enum-default
        made = fact
    fact = facts.calls[fact].next
. counted = layout-of(row.from, site)
. layout = layout-of(row.to, site)
. module ModuleId = U32.max
. decl DeclId = 0
match? types.rows[row.to]
    | .type-class(class)
        module = class.module
        decl = class.decl
if made == no-fact || !is-integer(counted) || module >= program.modules.length
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. owner = program.modules[module]
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. place U32
for index in 0 .. < owner.decls.length
    match? owner.decls[index]
        | .decl-case(case)
            if case.owner == decl
                . kept = tables.storage-of(module, index as DeclId)
                if kept == no-storage || not-enum || place > 127
                    refuse(.refused-conversion, site)
                else if tables.storage[kept].type != row.to
                    refuse(.refused-conversion, site)
                else
                    . taken = ir.reserve-block()
                    . next = ir.reserve-block()
                    . number = integer(tables.layouts.kind-of(counted), place)
                    branch(compare(site, .compare-equal, value, number), taken, next)
                    ir.start-block(taken)
                    arrive(site, load-global(tables.storage[kept], site).operand, joined, slot)
                    ir.start-block(next)
                    place += 1
                .. not-enum = tables.global-kind(module, index as DeclId) != .global-enum
. object = emit-fact-call(site, facts.calls[made], 0, RowRange'SyntaxId(), 0, 0, row.to)
if object.type != row.to
    refuse(.refused-conversion, site)
arrive(site, object.operand, joined, slot)
. answer = close-joins(joined, mark, layout, slot)
= Typed(answer, row.to)

────────────────────
_ do make-union Typed
    - site SyntaxId
    - type TypeId
    - index U32
    - held Typed

` A union that holds one case: memory in the frame with nothing set, the number of the case
` in its first byte, and behind it what the case holds, which is of the case's type.
. layout = layout-of(type, site)
if !tables.layouts.is-union(layout) || index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-conversion, site)
    = held
. field = tables.layouts.case-field(layout, index)
if field.type != held.type
    refuse(.refused-conversion, site)
    = held
. made = frame(layout)
zero(made, layout)
store(made, 0, integer(.machine-u8, index), false, site)
put(made, field, held.operand, site)
= Typed(made, type)

────────────────────
_ do wrap-case Typed
    - site SyntaxId
    - row ConversionFact
    - value Typed

` A value as the case of a union the type pass picked for it: converted as the conversion's
` one part says to what the case holds.
if row.parts == no-fact
    refuse(.refused-conversion, site)
    = Typed(value.operand, no-type)
. held = convert-one(site, facts.conversion-parts[row.parts], value)
= make-union(site, row.to, row.case-index, held)

────────────────────
_ do text-or-null Typed
    - site SyntaxId
    - row ConversionFact
    - value Typed

. layout = layout-of(row.to, site)
. holds = present(site, value)
. filled = ir.reserve-block()
. empty = ir.reserve-block()
. joined = ir.reserve-block()
branch(holds.operand, filled, empty)
ir.start-block(filled)
. pointer = cast(site, payload(site, Typed(value.operand, row.from)), row.to)
. from-filled = ir.current
jump(joined)
ir.start-block(empty)
. from-empty = ir.current
jump(joined)
ir.start-block(joined)
= Typed(phi(layout, pointer.operand, from-filled, integer(.machine-pointer, 0), from-empty), row.to)

────────────────────
_ do unwrap-or-null Typed
    - site SyntaxId
    - row ConversionFact
    - value Typed

` An optional made a union that has a case for null: what it holds converted as the
` conversion's one part says, or where it holds nothing the union holding null.
. layout = layout-of(row.to, site)
if row.parts == no-fact || !tables.layouts.is-union(layout)
    refuse(.refused-conversion, site)
    = Typed(value.operand, no-type)
. made = frame(layout)
. holds = present(site, value)
. filled = ir.reserve-block()
. empty = ir.reserve-block()
. done = ir.reserve-block()
branch(holds.operand, filled, empty)
ir.start-block(filled)
. converted = convert-one(site, facts.conversion-parts[row.parts], payload(site, Typed(value.operand, row.from)))
if converted.type != row.to
    refuse(.refused-conversion, site)
copy(made, converted.operand, layout, false, site)
jump(done)
ir.start-block(empty)
. none = tables.layouts.values[types.null-type]
. nothing = if none == managed-layout || none == pointer-layout then integer(none as MachineKind, 0) else make-operand(.operand-void, 0)
. union = make-union(site, row.to, types.null-case(row.to), Typed(nothing, types.null-type))
copy(made, union.operand, layout, false, site)
jump(done)
ir.start-block(done)
= Typed(made, row.to)

────────────────────
_ do case-test Operand
    - site SyntaxId
    - value Operand
    - index U32

` Whether a union holds the case of a number.
= compare(site, .compare-equal, load(value, 0, u8-layout, site), integer(.machine-u8, index))

────────────────────
_ do holding-branch
    - site SyntaxId
    - value Operand
    - layout LayoutId
    - row ConversionFact
    - matched IRBlockId
    - missed IRBlockId

` Leaves to `matched` where a union holds the case the type pass picked for a type, or, where
` that case is of the class asked for or of one it derives from, a case of a class below the
` class, whose object is one of it too, or a case of a class above it whose object is of it,
` and to `missed` where it holds none of them. Each such case holds its object where the picked
` case does, so it is read as one.
. field = tables.layouts.case-field(layout, row.case-index)
. lined = tables.is-class(row.to) && (field.type == row.to || derived-field)
    .. derived-field = tables.is-class(field.type) && descends(row.to, field.type)
if !lined
    branch(case-test(site, value, row.case-index), matched, missed)
    =
. cases = types.cases-of(row.from)
for index in 0 .. < cases.length
    . held = cases[index].type
    if held == no-type || !tables.is-class(held)
        continue
    . below = held == row.to || descends(held, row.to)
    if !below && !descends(row.to, held)
        continue
    . other = tables.layouts.case-field(layout, index as U32)
    if other.offset != field.offset || other.layout != field.layout
        refuse(.refused-conversion, site)
        continue
    . taken = ir.reserve-block()
    . passed = ir.reserve-block()
    branch(case-test(site, value, index as U32), taken, passed)
    ir.start-block(taken)
    if below
        jump(matched)
    else
        class-branch(site, take(value, other, site), row.to, matched, passed)
    ir.start-block(passed)
jump(missed)

────────────────────
_ do descends Bool
    - type TypeId
    - ancestor TypeId

` Whether a class is below another, the classes it is of followed up from it.
. current = types.base-of(type) ?? no-type
while current != no-type
    if current == ancestor
        = true
    current = types.base-of(current) ?? no-type
= false

────────────────────
_ do unwrap-case Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` What a union holds as the case the type pass picked, where any other case is a panic: of
` a declaration, which is a pattern, that the pattern did not match. Inside a pattern a case
` that is an optional of the type asked for matches where it holds a value, and gives that.
` A case of a number or pointer type is converted to the one asked for. A case of any other
` type than the one asked for, or than a class it derives from, has no shape here.
. layout = layout-of(row.from, site)
if !tables.layouts.is-union(layout) || row.case-index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. field = tables.layouts.case-field(layout, row.case-index)
if matching.failing != no-block && field.type != row.to && holds(field.type, row.to)
    pass-or-fail(case-test(site, value, row.case-index), matching.failing)
    = unwrap(site, Typed(take(value, field, site), field.type))
. lined = field.type == row.to || (both-classes && descends(row.to, field.type))
    .. both-classes = tables.is-class(row.to) && tables.is-class(field.type)
. converts = !lined && converts-scalar(field.type, row.to)
if (!lined && !converts) || (!function.may-panic && matching.failing == no-block)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
if matching.failing != no-block
    . passed = ir.reserve-block()
    holding-branch(site, value, layout, row, passed, matching.failing)
    fail-jumps += 1
    ir.start-block(passed)
    = held-case(site, value, field, row.to)
. matched = ir.reserve-block()
. missed = ir.reserve-block()
holding-branch(site, value, layout, row, matched, missed)
ir.start-block(missed)
if row.reason == .reason-declaration
    raise-text(site, "Pattern match failed")
else
    raise-union-error(site)
ir.start-block(matched)
= held-case(site, value, field, row.to)

────────────────────
_ converts-scalar Bool
    - from TypeId
    - to TypeId

|? !intrinsic-is-numeric(intrinsic(from)) || !intrinsic-is-numeric(intrinsic(to))
    false
??
    !types.completions[from].has-equalities || !types.completions[to].has-equalities

────────────────────
_ do held-case Typed
    - site SyntaxId
    - value Operand
    - field LayoutField
    - target TypeId

. held = take(value, field, site)
if field.type == target || tables.is-class(target)
    = Typed(held, target)
= cast(site, Typed(held, field.type), target)

────────────────────
_ do union-text Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A union as text: the name of a case that holds no value of its own, and of any other what
` it holds made text as the part for the case says. The cases are tested in their order.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(row.from, site)
if !tables.layouts.is-union(layout)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. joined = ir.reserve-block()
. mark = joins.length
. part = row.parts
. index U32
for fact in types.cases-of(row.from)
    if part == no-fact
        break
    . taken = ir.reserve-block()
    . passed = ir.reserve-block()
    branch(case-test(site, value, index), taken, passed)
    ir.start-block(taken)
    . text = nothing
    if fact.is-default
        . name = fact.name
        text = make-operand(.operand-constant, ir.add-string(if name then name.text else ""))
    else
        . field = tables.layouts.case-field(layout, index)
        . converted = convert-one(site, facts.conversion-parts[part], Typed(take(value, field, site), field.type))
        text = converted.operand
        if converted.type != types.string-type
            refuse(.refused-conversion, site)
    arrive(site, text, joined, nothing)
    ir.start-block(passed)
    part = facts.conversion-parts[part].next
    index += 1
if part != no-fact || index != tables.layouts.rows[layout].cases.count
    refuse(.refused-conversion, site)
arrive(site, make-operand(.operand-constant, ir.add-string("")), joined, nothing)
= Typed(close-joins(joined, mark, managed-layout, nothing), row.to)

────────────────────
_ do rewrap Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A union as another union: what it holds is made the case of the other that the part for
` its own case says. The cases are tested in their order, and the last is what is left.
. target = layout-of(row.to, site)
. layout = layout-of(row.from, site)
if !tables.layouts.is-union(layout) || !tables.layouts.is-union(target)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. count = tables.layouts.rows[layout].cases.count
. joined = ir.reserve-block()
. slot = join-slot(target)
. mark = joins.length
. part = row.parts
. index U32
while index < count && part != no-fact
    . tests = index + 1 != count
    . passed IRBlockId = 0
    if tests
        . taken = ir.reserve-block()
        passed = ir.reserve-block()
        branch(case-test(site, value, index), taken, passed)
        ir.start-block(taken)
    . field = tables.layouts.case-field(layout, index)
    . made = convert-one(site, facts.conversion-parts[part], Typed(take(value, field, site), field.type))
    if made.type != row.to
        refuse(.refused-conversion, site)
    arrive(site, made.operand, joined, slot)
    if tests
        ir.start-block(passed)
    part = facts.conversion-parts[part].next
    index += 1
if part != no-fact || index != count
    refuse(.refused-conversion, site)
= Typed(close-joins(joined, mark, target, slot), row.to)

────────────────────
_ do emit-case-number Typed
    - id SyntaxId
    - object SyntaxId

` `case` of a union: the number of the case it holds, which is the byte it starts with.
. held = emit-whole(object)
. layout = layout-of(held.type, id)
. type = facts.node-type(unit.reading, id)
. counted = layout-of(type, id)
if !tables.layouts.is-union(layout) || counted != u8-layout
    refuse(.refused-expression, id)
    = held
= Typed(load(held.operand, 0, u8-layout, id), type)

────────────────────
_ do emit-case-text Typed
    - id SyntaxId
    - object SyntaxId
    - plan OperatorPlan

` `name` or `type` of a union: the name of the case it holds, or the key of that case's
` type. The number of the case is compared with each case's in turn, and the text is the
` empty one where it is none of them, as TypeScript's chain ends. A case with no name has
` the empty text for its name, and a case that holds no value has the type of its number.
. nothing = make-operand(.operand-void, 0)
. held = emit-whole(object)
. union = held.type
. layout = layout-of(union, id)
. text-layout = layout-of(types.string-type, id)
if !tables.layouts.is-union(layout) || facts.node-type(unit.reading, id) != types.string-type
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. cases = types.cases-of(union)
. count = tables.layouts.rows[layout].cases.count
if cases.length != count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. number = load(held.operand, 0, u8-layout, id)
. joined = ir.reserve-block()
. mark = joins.length
for index in 0 .. < count
    . matched = ir.reserve-block()
    . next = ir.reserve-block()
    branch(compare(id, .compare-equal, number, integer(.machine-u8, index)), matched, next)
    ir.start-block(matched)
    . text = ""
    if plan == .plan-case-type
        text = type-runtime-key(types, tables.layouts.case-field(layout, index).type)
    else if cases[index].name
        text = cases[index].name!.text
    arrive(id, make-operand(.operand-constant, ir.add-string(text)), joined, nothing)
    ir.start-block(next)
arrive(id, make-operand(.operand-constant, ir.add-string("")), joined, nothing)
= Typed(close-joins(joined, mark, text-layout, nothing), types.string-type)

────────────────────
_ do emit-case-value Typed
    - id SyntaxId
    - object SyntaxId

` A union read by the name of one of its cases, whose number the type pass recorded: what
` the union holds where it holds that case, and where it holds another the value a local of
` the case's type has with nothing written for it, as TypeScript gives: for one made by a
` constructor, the construction the type pass recorded at the node.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. constant = facts.constant-of(unit.reading, id)
. held = emit-whole(object)
. layout = layout-of(held.type, id)
. given = layout-of(type, id)
if constant == no-fact || !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. index = facts.constants[constant].bits as U32
if index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. field = tables.layouts.case-field(layout, index)
if field.type != type || field.layout == void-layout
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. matched = ir.reserve-block()
. other = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(given)
. mark = joins.length
branch(case-test(id, held.operand, index), matched, other)
ir.start-block(matched)
arrive(id, take(held.operand, field, id), joined, slot)
ir.start-block(other)
. first = default-value(id, type, given, id)
arrive(id, first.operand, joined, slot)
= Typed(close-joins(joined, mark, given, slot), type)

────────────────────
_ do emit-whole Typed
    - object SyntaxId

` The receiver of a member a union answers: its value, or for a local read as the one case
` the flow knows it to hold, the union the local holds, whose member it is.
if facts.plan-of(unit.reading, object) != .plan-case-read || is-pinned(object)
    = emit-expression(object)
. binding = instances.rows[unit.reading].binding
if binding != no-binding && unit.reading == unit.instance
    match? tree.nodes[object]
        | .node-identifier
            . resolution = bindings.resolution-of(binding, object)
            if resolution.kind == .resolve-slot && names-local
                . offset = slot-offset(resolution.slot, object)
                . held = facts.slot-type(unit.instance, offset)
                . whole = read-local(resolution.slot, object, held)
                = Typed(whole.operand, held)
            .. names-local = bindings.slots[resolution.slot].kind == .slot-local
refuse(.refused-expression, object)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do answer-count U32
    - id SyntaxId

` How many of the calls recorded at a node answer for its value.
. count U32
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if answers-node(facts.calls[fact].form)
        count += 1
    fact = facts.calls[fact].next
= count

────────────────────
_ do nth-answer FactId
    - id SyntaxId
    - position U32

` The call recorded at a node that answers for its value, by its place among those that do.
. left = position
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if answers-node(facts.calls[fact].form)
        if left == 0
            = fact
        left -= 1
    fact = facts.calls[fact].next
= no-fact

────────────────────
_ do emit-forward Typed
    - id SyntaxId
    - object SyntaxId
    - operands RowRange'SyntaxId
    - name Atom? = null

` A member of a union that each case answers with its own, as the type pass planned it.
` 1. The union is evaluated, and then the arguments written, once each, in their order. A
`    row of a table of unions is gathered as the case it holds where the member is made in
`    place: TypeScript reads the case's cells where the member is stable, and gathers them
`    where it is not.
` 2. Where a case may panic or let errors out, the function made for the member, TypeScript's
`    `union-dispatch-N`, is called with them. Errors it answers with leave the function the
`    call is in. Such a member with no function made for it has no shape. Any other is made
`    in place, as `dispatch-cases` makes it.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
if tables.forward-unbuilt(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. held = emit-whole(object)
. whole = held.type
. dispatch = tables.forward-function(unit.reading, id)
if dispatch == no-function && holds-row(whole)
    held = table-row-item(id, held.operand, whole)
    whole = held.type
. union = if holds-row(whole) then table-row-type(whole) else whole
. layout = layout-of(union, id)
if !tables.layouts.is-union(layout) || type == no-type || type == invalid-type
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. disturbed = false
for argument in tree.children[operands]
    if !is-inert(argument)
        disturbed = true
held = Typed(apart(Typed(held.operand, whole), object, disturbed), whole)
. pin-mark = pins.length
for argument in tree.children[operands]
    . expression = tree.argument-value(argument)
    . made = emit-expression(expression)
    . value = apart(made, expression, true)
    if made.type != facts.node-type(unit.reading, expression)
        refuse(.refused-conversion, expression)
    pin(expression, value, made.type)
. answer = Typed(nothing, no-type)
if dispatch != no-function
    answer = call-forward(id, dispatch, held.operand, pin-mark, type)
else
    answer = dispatch-cases(id, object, operands, held.operand, layout, type, name)
unpin(pin-mark)
= answer

────────────────────
_ do call-forward Typed
    - id SyntaxId
    - dispatch FunctionId
    - held Operand
    - pin-mark Size
    - type TypeId

` A call of the function made for a member a union forwards, with the union and the
` arguments pinned from `pin-mark` on. It answers the member's value, or with the errors the
` cases let out, which leave the function the call is in. Where the collector never looks the
` call leaves that zone, as a call of each case's member would.
. nothing = make-operand(.operand-void, 0)
. forward = tables.forward-of(dispatch)
. target = tables.functions[dispatch]
. raising = forward.result != no-type
. returned = if raising then forward.result else type
. returns = layout-of(returned, id)
if in-zone && raising
    refuse(.refused-expression, id)
. mark = pending.length
pending += held
for position in pin-mark .. < pins.length
    pending += pins[position].value
ir.depend(.callee-function, dispatch, if target.may-panic then may-panic-dependency else 0u32)
. checked = target.may-panic && !in-landing
. crosses = in-zone
if crosses
    cross-zone(id, false)
. result = call
    - make-operand(.operand-symbol, target.symbol)
    - id
    - mark
    - .callee-function
    - returns
    - checked
if crosses
    cross-zone(id, true)
if raising
    = propagate-held(id, forward.result, result)
= Typed(result, returned)

────────────────────
_ holds-row Bool
    - type TypeId

` Whether a value is a row of a table, as a receiver a union's member is forwarded from.
intrinsic(type) == .table-row || intrinsic(type) == .immutable-table-row

────────────────────
_ do dispatch-cases Typed
    - id SyntaxId
    - object SyntaxId
    - operands RowRange'SyntaxId
    - held Operand
    - layout LayoutId
    - type TypeId
    - name Atom? = null

` A member of a union as each case answers it, with the union held and the arguments
` pinned.
` 1. The number of the case the union holds is read once and compared with each case's in
`    turn. The last case is the one left.
` 2. The member is made of what the union holds as that case: the call the type pass
`    recorded for the case, which it records in the order of the cases, or with no call
`    recorded the property the case stores, read by name.
` What a case gives in another type than the node's takes the conversion recorded at the
` node for that type, as one side of a join does.
. nothing = make-operand(.operand-void, 0)
. count = tables.layouts.rows[layout].cases.count
. answered = answer-count(id)
if count == 0 || (answered != 0 && answered != count) || unnamed-call
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. unnamed-call = answered == 0 && (!name || operands.count != 0)
. gives = type != types.void-type
. given = if gives then layout-of(type, id) else void-layout
. joined = ir.reserve-block()
. slot = if gives then join-slot(given) else nothing
. mark = joins.length
. tag = if count > 1 then load(held, 0, u8-layout, id) else nothing
for index in 0 .. < count
    . next = no-block
    if index + 1 < count
        . matched = ir.reserve-block()
        next = ir.reserve-block()
        branch(compare(id, .compare-equal, tag, integer(.machine-u8, index)), matched, next)
        ir.start-block(matched)
    . field = tables.layouts.case-field(layout, index)
    . inside = take(held, field, id)
    . case-mark = pins.length
    pin(object, inside, field.type)
    . answer = Typed(nothing, no-type)
    if answered == 0
        answer = load-property(id, inside, field.type, name!, true)
    else
        . fact = facts.calls[nth-answer(id, index)]
        answer = emit-fact-call(id, fact, object, operands, 0, 0, case-answer(fact))
    unpin(case-mark)
    if answer.type != type
        answer = join(id, answer)
    if answer.type != type
        refuse(.refused-conversion, id)
    if gives
        arrive(id, answer.operand, joined, slot)
    else
        jump(joined)
    if index + 1 < count
        ir.start-block(next)
if !gives
    ir.start-block(joined)
    = Typed(nothing, type)
= Typed(close-joins(joined, mark, given, slot), type)

────────────────────
_ case-answer TypeId
    - fact CallFact

` What the call of a case answers: the value, or what holds it or an error where the call
` raises errors that do not leave with it.
|? fact.callee == no-instance
    no-type
|? signature.errors.count != 0 && !fact.propagates
    signature.result
??
    signature.returns

.. signature = instances.signatures[fact.callee]

────────────────────
_ runs-on-row Bool
    - callee InstanceId
    - row TypeId

` Whether a member runs on a row: one of a case on the case's cells, or one of a base every
` case shares on the row itself.
instances.rows[callee].row-receiver == row || instances.rows[callee].self-type == row

────────────────────
_ do set-cases
    - id SyntaxId
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId
    - held Operand
    - layout LayoutId

` A setter of a union as each case answers it, with the union held and the value pinned: the
` setter the type pass recorded for the case the union holds, which it records in the order
` of the cases, is called on what the union holds with the value.
. count-answered = answer-count(lhs)
. joined = ir.reserve-block()
for index in 0 .. < count-answered
    . fact = facts.calls[nth-answer(lhs, index)]
    if fact.form != .call-setter
        refuse(.refused-statement, id)
        break
    . next = no-block
    if index + 1 < count-answered
        . matched = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(id, held, index), matched, next)
        ir.start-block(matched)
    . field = tables.layouts.case-field(layout, index)
    . inside = take(held, field, id)
    . case-mark = pins.length
    pin(object, inside, field.type)
    emit-setter(lhs, object, rhs, fact)
    unpin(case-mark)
    jump(joined)
    if index + 1 < count-answered
        ir.start-block(next)
ir.start-block(joined)

────────────────────
_ do emit-case Typed
    - id SyntaxId
    - operands RowRange'SyntaxId
    - fields Bool

` A case of a union named at a node, as the type pass planned it: with the value it is
` called with, with a tuple or struct made of the fields it is called with, or named alone
` with the number a case with no value of its own holds. One called with a value or fields is
` made in place, where TypeScript calls the constructor it generates for the case, as the IR
` notes.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. constant = facts.constant-of(unit.reading, id)
. layout = layout-of(type, id)
if constant == no-fact || !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. index = facts.constants[constant].bits as U32
if index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. field = tables.layouts.case-field(layout, index)
. held = Typed(nothing, no-type)
if fields
    held = emit-case-fields(id, field, operands)
else if operands.count == 1
    . given = tree.children[operands.start]
    held = convert(given, .reason-argument, emit-expression(tree.argument-value(given)))
else if operands.count == 0 && types.cases-of(type)[index].is-default
    held = Typed(integer(.machine-u8, index), field.type)
else
    refuse(.refused-expression, id)
. made = make-union(id, type, index, held)
if fields || operands.count != 0
    ir.note-made-call()
= made

────────────────────
_ do emit-case-fields Typed
    - id SyntaxId
    - field LayoutField
    - operands RowRange'SyntaxId

` The tuple or struct a case holds, made of the arguments the case is called with: each is
` converted as recorded at it and stored to the next field written with a value.
. nothing = make-operand(.operand-void, 0)
if !tables.layouts.is-struct(field.layout) || !is-aggregate(field.type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. made = frame(field.layout)
zero(made, field.layout)
. range = types.completions[field.type].properties
. position U32
for offset in 0 .. < range.count
    . property = types.properties[range.start + offset]
    if property.storage-kind != .storage-eager
        continue
    if position >= operands.count
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . given = tree.children[operands.start + position]
    . value = convert(given, .reason-argument, emit-expression(tree.argument-value(given)))
    . target = tables.layouts.field(field.layout, property.slot)
    if value.type != target.type
        refuse(.refused-conversion, given)
        = Typed(nothing, no-type)
    put(made, target, value.operand, given)
    position += 1
if position != operands.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= Typed(made, field.type)

────────────────────
_ do adopt Typed
    - site SyntaxId
    - value Operand
    - target TypeId

` Text copied from the C chars a pointer leads to. The runtime function that copies polls, so
` it is called between two polls, and the panic signal is read again after it. A function
` the collector never sees has no shape for it.
. returns = layout-of(target, site)
. mark = pending.length
pending += value
. text = call-polling(.runtime-string-adopt, site, mark, returns)
= Typed(text, target)

────────────────────
_ do call-polling Operand
    - callee RuntimeFunction
    - site SyntaxId
    - mark Size
    - returns LayoutId

` A call of a runtime function that polls, with the pending arguments from `mark` on. It is
` called between two polls, and the panic signal is read again after it. A function the
` collector never sees has no shape for it.
if in-zone || !ir.signals
    refuse(.refused-blocking-call, site)
    drop-pending(mark)
    = make-operand(.operand-void, 0)
poll(site)
. result = call-runtime(callee, site, mark, returns)
poll(site)
append(.op-load-panic-signal, site, Span(), 0)
. resumed = ir.reserve-block()
branch(make-operand(.operand-panic-signal, 0), landing-block(site), resumed)
ir.start-block(resumed)
= result

────────────────────
_ do tuple-text Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A tuple or struct as text: `(`, each field made text as its part says with `, ` between,
` and `)`, joined by the runtime.
. layout = layout-of(row.from, site)
if !tables.layouts.is-struct(layout)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. count = tables.layouts.rows[layout].fields.count
. text = make-operand(.operand-constant, ir.add-string("("))
. position U32
. part = row.parts
while part != no-fact && position < count
    . fact = facts.conversion-parts[part]
    . field = tables.layouts.field(layout, position)
    . piece = convert-one(site, fact, Typed(take(value, field, site), field.type))
    if position != 0
        text = concat(site, text, make-operand(.operand-constant, ir.add-string(", ")))
    text = concat(site, text, piece.operand)
    position += 1
    part = fact.next
if part != no-fact || position != count
    refuse(.refused-conversion, site)
text = concat(site, text, make-operand(.operand-constant, ir.add-string(")")))
= Typed(text, row.to)

────────────────────
_ do concat Operand
    - site SyntaxId
    - left Operand
    - right Operand

` Two texts joined by the runtime.
. mark = pending.length
pending += left
pending += right
= call-polling(.runtime-string-concat, site, mark, managed-layout)

────────────────────
_ do recast Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A tuple or struct cast to another: memory in the frame, with each field converted as its
` part says and stored to the field in the same place.
. held = layout-of(row.from, site)
. layout = layout-of(row.to, site)
if !tables.layouts.is-struct(held) || !tables.layouts.is-struct(layout)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
check-item-size(site, row.from, row.to)
. count = tables.layouts.rows[layout].fields.count
if tables.layouts.rows[held].fields.count != count
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. made = frame(layout)
. position U32
. part = row.parts
while part != no-fact && position < count
    . fact = facts.conversion-parts[part]
    . field = tables.layouts.field(layout, position)
    . source = tables.layouts.field(held, position)
    . converted = convert-one(site, fact, Typed(take(value, source, site), source.type))
    if converted.type != field.type
        refuse(.refused-conversion, site)
    put(made, field, converted.operand, site)
    position += 1
    part = fact.next
if part != no-fact || position != count
    refuse(.refused-conversion, site)
= Typed(made, row.to)

────────────────────
_ do check-item-size
    - site SyntaxId
    - from TypeId
    - to TypeId

=? if !holds-items(from) || !holds-items(to)
. from-item = viewed-item(from)
. to-item = viewed-item(to)
=? if from-item == to-item
. from-size = tables.layouts.rows[layout-of(from-item, site)].size
. to-size = tables.layouts.rows[layout-of(to-item, site)].size
=? if from-size == to-size
if !function.may-panic && !in-landing
    refuse(.refused-conversion, site)
    =
raise-text(site, "An array of ${from-size}-byte items cannot be cast to one of ${to-size}-byte items")
ir.start-block(ir.reserve-block())

────────────────────
_ holds-items Bool
    - type TypeId

same-decl(ref, types.array-decl) || same-decl(ref, types.immutable-array-decl)

.. ref = class-ref(types, type)

────────────────────
_ do is-leading Bool
    - base LayoutId
    - whole LayoutId

` Whether a struct starts with the fields of another, each in the same place: the address of
` the one is then the address of the other.
if !tables.layouts.is-struct(base) || !tables.layouts.is-struct(whole)
    = false
. count = tables.layouts.rows[base].fields.count
if count > tables.layouts.rows[whole].fields.count
    = false
for position in 0 .. < count
    . mine = tables.layouts.field(base, position)
    . theirs = tables.layouts.field(whole, position)
    if mine.offset != theirs.offset || mine.layout != theirs.layout
        = false
= true

────────────────────
_ do wrap Typed
    - site SyntaxId
    - value Typed
    - target TypeId

` A value as an optional that holds it: the value, and the flag that says there is one. The
` value is already what the optional holds: a conversion converts it first as its part says.
` A value with no bits leaves only the flag.
. layout = layout-of(target, site)
if is-null-form(target) && value.type == types.optional-inner(target)
    = Typed(value.operand, target)
if !types.is-optional(target) || !tables.layouts.is-struct(layout)
    refuse(.refused-conversion, site)
    = value
. inner = tables.layouts.field(layout, 0)
. flag = tables.layouts.field(layout, 1)
. held = types.optional-inner(target)
. given = value
if held != given.type || inner.layout != layout-of(given.type, site)
    refuse(.refused-conversion, site)
    = value
. wrapped = frame(layout)
zero(wrapped, layout)
if tables.layouts.is-struct(inner.layout)
    copy(address(wrapped, inner.offset, inner.layout, site), given.operand, inner.layout, false, site)
else if inner.layout != void-layout
    store(wrapped, inner.offset, given.operand, false, site)
store(wrapped, flag.offset, integer(.machine-i8, 1), false, site)
= Typed(wrapped, target)

────────────────────
_ do empty-optional Typed
    - type TypeId
    - layout LayoutId

` An optional that holds nothing: the flag is clear, and what it would hold is the value its
` type has with nothing written. One held as a pointer is the pointer that points at nothing.
if is-null-form(type)
    = Typed(integer(layout as MachineKind, 0), type)
= null-value(type, layout, 0)

────────────────────
_ do null-value Typed
    - type TypeId
    - layout LayoutId
    - site SyntaxId

` The value a type has with nothing written, in memory of the frame: no bits set, but for
` the empty text wherever a text is held, in a field of a tuple or struct or in an optional,
` however deep.
. empty = frame(layout)
zero(empty, layout)
empty-texts(empty, 0, type, layout, site)
= Typed(empty, type)

────────────────────
_ do empty-texts ?! Refused
    - memory Operand
    - offset U32
    - type TypeId
    - layout LayoutId
    - site SyntaxId

` Stores the empty text at each place of zeroed memory that holds a text.
if type == no-type || type == invalid-type
    =
if type == types.string-type
    store(memory, offset, make-operand(.operand-constant, ir.add-string("")), false, site)
    =
if !tables.layouts.is-struct(layout) || !tables.layouts.rows[layout].is-managed
    =
if types.is-optional(type)
    . inner = tables.layouts.field(layout, 0)
    empty-texts(memory, offset + inner.offset, types.optional-inner(type), inner.layout, site)
    =
if !is-aggregate(type)
    =
. range = types.completions[type].properties
for position in 0 .. < range.count
    . property = types.properties[range.start + position]
    if property.slot == U32.max
        continue
    . field = tables.layouts.field(layout, property.slot)
    empty-texts(memory, offset + field.offset, property.type, field.layout, site)

────────────────────
_ do rehouse Typed
    - site SyntaxId
    - row ConversionFact
    - value Typed

` An optional made an optional of another type: where it holds a value, that value converted
` as the conversion's one part says and held, and else the optional that holds nothing.
. source = value.type
. target = row.to
. layout = layout-of(target, site)
if is-null-form(target)
    = rehouse-pointer(site, row, value, layout)
if !tables.layouts.is-struct(layout)
    refuse(.refused-conversion, site)
    = value
. made = frame(layout)
zero(made, layout)
. holds = present(site, value)
. held = ir.reserve-block()
. done = ir.reserve-block()
branch(holds.operand, held, done)
ir.start-block(held)
. given = convert-one(site, facts.conversion-parts[row.parts], payload(site, Typed(value.operand, source)))
. housed = wrap(site, given, target)
copy(made, housed.operand, layout, false, site)
jump(done)
ir.start-block(done)
= Typed(made, target)

────────────────────
_ do rehouse-pointer Typed
    - site SyntaxId
    - row ConversionFact
    - value Typed
    - layout LayoutId

. source = value.type
. target = row.to
. holds = present(site, value)
. slot = join-slot(layout)
. mark = joins.length
. held = ir.reserve-block()
. other = ir.reserve-block()
. joined = ir.reserve-block()
branch(holds.operand, held, other)
ir.start-block(held)
. given = convert-one(site, facts.conversion-parts[row.parts], payload(site, Typed(value.operand, source)))
. housed = wrap(site, given, target)
arrive(site, housed.operand, joined, slot)
ir.start-block(other)
arrive(site, empty-optional(target, layout).operand, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), target)

────────────────────
_ do present Typed
    - site SyntaxId
    - value Typed

` Whether an optional holds a value, which its flag says, or for one held as a pointer that
` the pointer points at something.
. layout = layout-of(value.type, site)
if is-null-form(value.type)
    = Typed(compare(site, .compare-not-equal, value.operand, integer(layout as MachineKind, 0)), types.bool-type)
if !types.is-optional(value.type) || !tables.layouts.is-struct(layout)
    refuse(.refused-type, site)
    = value
. flag = tables.layouts.field(layout, 1)
. compared = compare
    - site
    - .compare-not-equal
    - load(value.operand, flag.offset, flag.layout, site)
    - integer(.machine-i8, 0)
= Typed(compared, types.bool-type)

────────────────────
_ do payload Typed
    - site SyntaxId
    - value Typed

` What an optional holds, read where it lies. Whether it holds anything is tested by what
` reads it, or was settled by the type pass. One held as a pointer is what it holds.
. layout = layout-of(value.type, site)
if is-null-form(value.type)
    = Typed(value.operand, types.optional-inner(value.type))
if !types.is-optional(value.type) || !tables.layouts.is-struct(layout)
    refuse(.refused-type, site)
    = value
= Typed(take(value.operand, tables.layouts.field(layout, 0), site), types.optional-inner(value.type))

────────────────────
_ do unwrap Typed
    - site SyntaxId
    - value Typed

` What an optional holds, where one that holds nothing is a panic, or inside a pattern a
` value that does not match.
. held = value.type
if !function.may-panic && matching.failing == no-block
    refuse(.refused-conversion, site)
    = value
. tested = present(site, value)
if matching.failing != no-block
    pass-or-fail(tested.operand, matching.failing)
    = payload(site, Typed(value.operand, held))
. filled = ir.reserve-block()
. missing = ir.reserve-block()
branch(tested.operand, filled, missing)
ir.start-block(missing)
raise-text(site, "Optional'${type-display(types, types.optional-inner(held))} is null")
ir.start-block(filled)
= payload(site, Typed(value.operand, held))

────────────────────
_ do emit-force Typed
    - id SyntaxId
    - operand SyntaxId

` `a!`: what an optional holds, or a panic where it holds nothing. An operand the type pass
` had narrowed already is what it holds, and nothing is tested: the force fact says so where
` the operand is read as the optional it is stored as. One the fact does not call narrowed,
` though the operand was typed narrowed where a lazy local's value was first typed, is read as
` stored (`stored-read`) and tested, as the reference does at a read that types the value again.
. fact = facts.first-force(unit.reading, id)
. outer = stored-read
stored-read = if fact != no-fact && !facts.forces[fact].is-narrowed then operand else 0
. value = emit-expression(operand)
stored-read = outer
if !types.is-optional(value.type)
    = value
if fact != no-fact && facts.forces[fact].is-narrowed
    if shared-depth != 0 && !facts.is-inside-read(unit.reading, operand)
        refuse(.refused-expression, id)
        = value
    = payload(id, value)
= unwrap(id, value)

────────────────────
_ holds Bool
    - held TypeId
    - type TypeId

` Whether a type is an optional of another: what a name narrowed to the other is stored as.
typed-held && types.is-optional(held) && types.optional-inner(held) == type
.. typed-held = held != no-type && held != invalid-type

────────────────────
_ do cast Typed
    - site SyntaxId
    - value Typed
    - target TypeId

` A cast between two numbers or between two pointers, of an integer to a pointer, or of a
` pointer that is no object to an integer. A number becomes a Bool by a test
` against zero, and a one-bit integer by its lowest bit. Any other number keeps its value as
` far as the target can hold it, and a pointer keeps its bits. An integer becomes the address
` it counts, with no sign, and a pointer the integer its address is, as far as the target can
` hold it. A pointer that becomes text is adopted by the runtime, which has no shape yet.
. source = layout-of(value.type, site)
. layout = layout-of(target, site)
. from-kind = intrinsic(value.type)
. to-kind = intrinsic(target)
. numbers = is-number(source) && is-number(layout)
. pointers = is-pointer(source) && is-pointer(layout)
. address = is-integer(source) && is-pointer(layout) && !is-text(target)
. points = from-kind == .cpointer || from-kind == .atom
. counted = pointer-to-integer && to-kind != .bool && to-kind != .int1
    .. pointer-to-integer = points && is-pointer(source) && is-integer(layout)
if !numbers && !pointers && !address && !counted
    refuse(.refused-conversion, site)
    = value
if pointers && is-text(target) && !is-text(value.type)
    refuse(.refused-conversion, site)
    = value
if numbers && to-kind == .bool && from-kind != .bool
    . tested = compare-zero(site, value, .compare-not-equal)
    = Typed(tested.operand, target)
if numbers && to-kind == .int1 && from-kind != .int1
    if !is-integer(source)
        refuse(.refused-conversion, site)
        = value
    . start U32 = ir.operands.length
    ir.add-operand(value.operand)
    ir.add-operand(integer(tables.layouts.kind-of(source), 1))
    . lowest = append(.op-bitwise, site, Span(start, 2), BitwiseOp.bitwise-and, source)
    = Typed(num-cast(site, make-operand(.operand-value, lowest), source, layout), target)
= Typed(num-cast(site, value.operand, source, layout), target)

────────────────────
_ do held-object Typed
    - site SyntaxId
    - value Operand
    - target TypeId

` The object a value of an interface holds, as a pointer: the first word of the value.
. layout = layout-of(target, site)
. first = tables.layouts.field(tables.layouts.interface-layout, 0)
if !is-pointer(first.layout) || !is-pointer(layout)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. object = load(value, first.offset, first.layout, site)
= Typed(num-cast(site, object, first.layout, layout), target)

────────────────────
_ do union-object Typed
    - site SyntaxId
    - value Typed
    - target TypeId

. union = layout-of(value.type, site)
. layout = layout-of(target, site)
if !tables.layouts.is-union(union) || !is-pointer(layout)
    refuse(.refused-conversion, site)
    = value
. held = tables.layouts.case-field(union, 0)
if !is-pointer(held.layout)
    refuse(.refused-conversion, site)
    = value
. object = load(value.operand, held.offset, held.layout, site)
= Typed(num-cast(site, object, held.layout, layout), target)

────────────────────
_ do reinterpret Typed
    - site SyntaxId
    - value Typed
    - target TypeId

` A value with its bits as they are, as another type: an atom as the text it points at, or a
` text as an atom. Both are pointers.
. source = layout-of(value.type, site)
. layout = layout-of(target, site)
. atoms = intrinsic(value.type) == .atom && is-text(target)
. texts = is-text(value.type) && intrinsic(target) == .atom
if (!atoms && !texts) || !is-pointer(source) || !is-pointer(layout)
    refuse(.refused-conversion, site)
    = value
= Typed(num-cast(site, value.operand, source, layout), target)

────────────────────
_ is-null-form Bool
    - type TypeId

` Whether an optional is held as the pointer it holds, which points at nothing where there
` is none: an optional of an atom, or of a class other than `Null`, whose value is that
` pointer.
optional-type && (atom-inner || (class-inner && types.optional-inner(type) != types.null-type))
.. optional-type = type != no-type && type != invalid-type && types.is-optional(type)
.. atom-inner = intrinsic(types.optional-inner(type)) == .atom
.. class-inner = intrinsic(types.optional-inner(type)) == .class

────────────────────
_ holds-atom Bool
    - type TypeId

types.is-optional(type) && intrinsic(types.optional-inner(type)) == .atom

────────────────────
_ do num-cast Operand
    - site SyntaxId
    - value Operand
    - source LayoutId
    - layout LayoutId

` A number or a pointer of one layout as one of another.
if source == layout
    = value
if operand-kind(value) == .operand-number && whole-layouts && source-number
    = integer
        - layout as MachineKind
        - cast-bits(ir.numbers[operand-payload(value)].bits, source, layout)
.. whole-layouts = is-integer(source) && is-integer(layout)
.. source-number = ir.numbers[operand-payload(value)].kind == source as MachineKind
. start U32 = ir.operands.length
ir.add-operand(value)
= make-operand(.operand-value, append(.op-num-cast, site, Span(start, 1), 0, layout))

────────────────────
_ cast-bits U64
    - bits U64
    - source LayoutId
    - layout LayoutId

widened(held, width, is-signed(layout))

.. source-width = tables.layouts.rows[source].size * 8
.. width = tables.layouts.rows[layout].size * 8
.. held = widened(bits, source-width, is-signed(source))

────────────────────
_ do equalize Typed
    - site SyntaxId
    - value Typed
    - target TypeId
    - ratio UnitRatio

` A number as a number of another unit: taken to the widest float, multiplied by the ratio's
` multiplier and divided by its divisor, each only when it is not one, and taken to the
` target.
. source = layout-of(value.type, site)
. layout = layout-of(target, site)
if !is-number(source) || !is-number(layout)
    refuse(.refused-conversion, site)
    = value
. scaled = num-cast(site, value.operand, source, f64-layout)
if ratio.multiplier != 1.0
    scaled = scale(site, scaled, .arithmetic-multiply, ratio.multiplier)
if ratio.divisor != 1.0
    scaled = scale(site, scaled, .arithmetic-divide, ratio.divisor)
= Typed(num-cast(site, scaled, f64-layout, layout), target)

────────────────────
_ do scale Operand
    - site SyntaxId
    - value Operand
    - op ArithmeticOp
    - amount F64

. start U32 = ir.operands.length
ir.add-operand(value)
ir.add-operand(float-number(f64-layout, amount))
= make-operand(.operand-value, append(.op-arithmetic, site, Span(start, 2), op, f64-layout))

────────────────────
_ do compare Operand
    - site SyntaxId
    - predicate ComparePredicate
    - left Operand
    - right Operand

. start U32 = ir.operands.length
ir.add-operand(left)
ir.add-operand(right)
= make-operand(.operand-value, append(.op-compare, site, Span(start, 2), predicate, u8-layout))

────────────────────
_ do compare-zero Typed
    - site SyntaxId
    - value Typed
    - predicate ComparePredicate

` Compares a number or a C pointer with the zero of its layout, and leaves a Bool.
. layout = layout-of(value.type, site)
if !is-number(layout) && (!is-pointer(layout) || intrinsic(value.type) != .cpointer)
    refuse(.refused-type, site)
    = value
. origin = integer(tables.layouts.kind-of(layout), 0)
if is-float(layout)
    origin = float-number(layout, 0.0)
= Typed(compare(site, predicate, value.operand, origin), types.bool-type)

────────────────────
_ do truth Typed
    - site SyntaxId
    - value Typed

` Whether a value tests as true, by its layout: a Bool is its own answer, an optional is true
` when it holds a value, and any other number is true when it is not zero. A value a function
` tests has no shape here.
if value.type == types.bool-type
    = value
if value.type != no-type && value.type != invalid-type && types.is-optional(value.type)
    = present(site, value)
= compare-zero(site, value, .compare-not-equal)

────────────────────
_ do emit-identifier Typed ?! Refused
    - id SyntaxId
    - name Atom
    - given TypeId = no-type

` A name: a constant the type pass worked out, one of the two truths, `null`, which is the
` pointer that points at nothing, a global, a type as a value, or in a body written in
` source the receiver, an argument, a local, the item of a loop, a property of the receiver
` or what a getter of it answers, or the name the receiver is written with as a number. A
` field named alone in a member that runs on the case of a row is read from its cell, and a
` getter named so runs on the row. A name the binder found a member of a markup element
` being built is read from the innermost such element that has it. A read of the name of a
` markup element the type pass made there first makes it (`raise-element`). What
` is read has the type the type pass gave the name, or the name has no shape here. A name
` a call calls is typed by no node, and is `given` its type. In the function of a rule made
` for a pattern that may raise errors, the pattern is read only where it is called. In the
` function that evaluates a line of a style rule from the slots of a style sheet, a value the
` rule takes as a slot is read from where `bind-themed-givens` kept it.
. themed = facts.theme-read-of(unit.reading, id)
if themed
    = read-theme(id, themed)
. binding = instances.rows[unit.reading].binding
. type = if given != no-type then given else facts.node-type(unit.reading, id)
if function.kind == .style-themed-value && rule-names.length != 0 && binding != no-binding
    . taken = bindings.resolution-of(binding, id)
    if taken.kind == .resolve-slot && bindings.slots[taken.slot].kind == .slot-argument
        = read-rule-value(taken.slot, id, type)
if carried-given != no-type && !calling-pattern && types.is-pattern-func(type)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if facts.plan-of(unit.reading, id) == .plan-constant
    = Typed(emit-constant(id), type)
if given == no-type && facts.plan-of(unit.reading, id) == .plan-row-item
    = emit-row-item(id, name)
if given == no-type && facts.plan-of(unit.reading, id) == .plan-getter
    = emit-getter(id)
if facts.plan-of(unit.reading, id) == .plan-element-property
    = read-unmade(id, name)
if binding != no-binding && (resolution-flags /and/ ResolutionFlag.resolution-received) != 0
    = read-received(id, name)
.. resolution-flags = bindings.resolution-of(binding, id).flags
if binding != no-binding
    . global = bindings.resolution-of(binding, id)
    if global.kind == .resolve-global && types.is-literal-global(global.module, global.decl)
        if name == types.true-atom && type == types.bool-type
            = Typed(integer(.machine-u8, 1), type)
        if name == types.false-atom && type == types.bool-type
            = Typed(integer(.machine-u8, 0), type)
        if name == types.null-atom! && type == types.null-type
            . held = tables.layouts.values[type]
            if held == managed-layout || held == pointer-layout
                = Typed(integer(held as MachineKind, 0), type)
            = Typed(make-operand(.operand-void, 0), type)
    else if global.kind == .resolve-global
        = read-global(id, global.module, global.decl)
    . names-type = global.kind != .resolve-slot && global.kind != .resolve-member && not-function
        .. not-function = global.kind != .resolve-function
    if names-type && type != no-type && type != invalid-type && intrinsic(type) == .type-info
        = type-value(id, type)
    if global.kind == .resolve-function && reads-getter(id)
        = emit-fact-call(id, facts.calls[own-call(id)], 0, RowRange'SyntaxId())
    if global.kind == .resolve-function && is-binding(type)
        = name-binding(id, type, 0)
    if global.kind == .resolve-member && making.type != no-type && filling.root != 0
        = read-made(id, name)
if binding != no-binding && unit.reading == unit.lender && unit.lender != unit.instance
    . lent = bindings.resolution-of(binding, id)
    if lent.kind == .resolve-slot && is-captured(lent.slot)
        . kind = bindings.slots[lent.slot].kind
        if kind == .slot-local && facts.plan-of(unit.reading, id) == .plan-guarded-read
            = guard-element(id, read-captured(lent.slot, id, type), name)
        if kind == .slot-local || kind == .slot-argument || kind == .slot-pattern
            = read-captured(lent.slot, id, type)
        if kind == .slot-loop-item || kind == .slot-each || kind == .slot-it
            = read-captured(lent.slot, id, type)
        if kind == .slot-lazy
            = read-lazy-local(lent.slot, id, type)
        if kind == .slot-this && unit.has-self && type == unit.owner-type
            = Typed(unit.self, type)
    if lent.kind == .resolve-slot && bindings.slots[lent.slot].kind == .slot-lazy
        = read-lent-lazy(lent.slot, id, type)
    if lent.kind == .resolve-member && unit.has-self
        . escaped = escaped-event(id)
        if escaped
            = emit-escape(id, escaped)
        . getter = own-call(id)
        if getter != no-fact && facts.calls[getter].form == .call-getter
            = emit-fact-call(id, facts.calls[getter], 0, RowRange'SyntaxId())
        if facts.plan-of(unit.reading, id) == .plan-none || guarded-read
            = load-property(id, unit.self, unit.owner-type, name)
        .. guarded-read = facts.plan-of(unit.reading, id) == .plan-guarded-read
if binding != no-binding && unit.reading == unit.instance
    . resolution = bindings.resolution-of(binding, id)
    . owner = unit.owner-type
    . early = facts.raised-at(unit.reading, id)
    if early != 0 && built.find(early) == null
        raise-element(early)
    if resolution.kind == .resolve-slot
        . kind = bindings.slots[resolution.slot].kind
        . kept = local-or-argument || kind == .slot-machine || bare-pattern
            .. local-or-argument = kind == .slot-local || kind == .slot-argument
            .. bare-pattern = kind == .slot-pattern && !holds-capture(resolution.slot)
        if given-slots && kept && is-bound(resolution.slot)
            = read-bound(resolution.slot, id, type)
        if is-captured(resolution.slot) && kind == .slot-local && guarded
            = guard-element(id, read-captured(resolution.slot, id, type), name)
        .. guarded = facts.plan-of(unit.reading, id) == .plan-guarded-read
        if is-captured(resolution.slot) && kept
            = read-captured(resolution.slot, id, type)
        if is-turned(resolution.slot) && turned-kind
            = read-captured(resolution.slot, id, type)
        .. turned-kind = kind == .slot-loop-item || kind == .slot-each || kind == .slot-it
        if kind == .slot-this && unit.has-self && type == owner
            = Typed(unit.self, type)
        if kind == .slot-super && unit.has-self && tables.is-class(owner) && tables.is-class(type)
            = Typed(unit.self, type)
        if kind == .slot-super && unit.has-self && !tables.is-class(owner)
            = Typed(unit.self, owner)
        if kind == .slot-argument && is-own-slot(resolution.slot)
            . position = argument-position(resolution.slot)
            . given = instances.argument-type(unit.instance, position)
            if type != given && shared-depth != 0 && !facts.is-inside-read(unit.reading, id)
                refuse(.refused-expression, id)
                = Typed(make-operand(.operand-void, 0), no-type)
            . cased = type != given && facts.plan-of(unit.reading, id) == .plan-case-read
            if type == given || holds(given, type) || cased
                . cell = unit.cells[resolution.slot - unit.slot-start]
                . argument = make-operand
                    - .operand-argument
                    - if unit.takes-self then position + 1 else position
                if cell != no-local
                    argument = load-local(cell, id)
                if type == given
                    = Typed(argument, given)
                if cased
                    = read-case(id, argument, given, type)
                = payload(id, Typed(argument, given))
        if kind == .slot-local
            = read-local(resolution.slot, id, type)
        if kind == .slot-lazy && task-holds(resolution.slot)
            = read-captured(resolution.slot, id, type)
        if kind == .slot-lazy
            = read-lazy-local(resolution.slot, id, type)
        if kind == .slot-loop-item && copied-slot && is-captured(resolution.slot)
            = read-captured(resolution.slot, id, type)
        .. copied-slot = tables.slot-copied[resolution.slot] != 0
        if kind == .slot-loop-item
            . loop = bindings.scopes[bindings.slots[resolution.slot].scope].syntax
            if facts.loop-take(unit.reading, loop) == .take-whole
                = read-item(loop, id, type)
            if is-captured(resolution.slot)
                = read-captured(resolution.slot, id, type)
            = read-local(resolution.slot, id, type)
        if kind == .slot-pattern || is-bound(resolution.slot)
            = read-bound(resolution.slot, id, type)
        if kind == .slot-location && is-captured(resolution.slot)
            = read-captured(resolution.slot, id, type)
        if kind == .slot-it || kind == .slot-each
            . home = bindings.scopes[bindings.slots[resolution.slot].scope]
            . written = if home.kind == .scope-loop then home.syntax else slot-syntax
                .. slot-syntax = bindings.slots[resolution.slot].syntax
            if is-own-slot(resolution.slot) && unit.cells[resolution.slot - unit.slot-start] != no-local
                = read-local(resolution.slot, id, type)
            if written == piped && !is-captured(resolution.slot) && ir.arguments.length == 2
                . given = instances.argument-type(unit.instance, 0)
                . argument = make-operand(.operand-argument, 1)
                if given == type
                    = Typed(argument, given)
                if facts.plan-of(unit.reading, id) == .plan-case-read
                    = read-case(id, argument, given, type)
                if !holds(given, type)
                    refuse(.refused-expression, id)
                    = Typed(argument, no-type)
                = payload(id, Typed(argument, given))
            = read-item(written, id, type)
    if resolution.kind == .resolve-member && unit.has-self
        . escaped = escaped-event(id)
        if escaped
            = emit-escape(id, escaped)
        if reads-unmade(id, name)
            = read-filled(id, name)
        if facts.plan-of(unit.reading, id) == .plan-unit-name
            = Typed(unit-text(owner), type)
        if facts.plan-of(unit.reading, id) == .plan-table
            = table-get(id, unit.self, owner)
        if facts.plan-of(unit.reading, id) == .plan-field
            = placed-field(id, unit.self, owner, facts.constant-of(unit.reading, id))
        if facts.plan-of(unit.reading, id) == .plan-through
            . held = read-through(id, Typed(unit.self, owner), facts.through-of(unit.reading, id))
            = load-property(id, held.operand, held.type, name, false, given)
        . getter = own-call(id)
        if getter != no-fact && facts.calls[getter].form == .call-getter
            = emit-fact-call(id, facts.calls[getter], 0, RowRange'SyntaxId())
        . told = facts.plan-of(unit.reading, id)
        if told == .plan-type-name || told == .plan-type-key
            = type-text(id, named-type(owner), told)
        = load-property(id, unit.self, owner, name, false, given)
    if resolution.kind == .resolve-member && this-cursor != U32.max
        . cursor = this-cursor
        . field = case-field(cursor, name)
        if field
            = emit-case-field(id, cursor, field)
        . asked = own-call(id)
        if asked != no-fact && facts.calls[asked].form == .call-getter
            = emit-fact-call(id, facts.calls[asked], 0, RowRange'SyntaxId())
if binding != no-binding && unit.reading != unit.instance && unit.has-self
    . written = bindings.resolution-of(binding, id)
    if written.kind == .resolve-member && filling.count != 0
        = read-filled(id, name)
    if written.kind == .resolve-member && unit.deferred-type != no-type
        . getter = own-call(id)
        if getter != no-fact && facts.calls[getter].form == .call-getter
            = emit-fact-call(id, facts.calls[getter], 0, RowRange'SyntaxId())
        = load-property(id, unit.self, unit.deferred-type, name)
    if written.kind == .resolve-member && evaluates-value()
        . getter = own-call(id)
        if getter != no-fact && facts.calls[getter].form == .call-getter
            = emit-fact-call(id, facts.calls[getter], 0, RowRange'SyntaxId())
        = load-property(id, unit.self, unit.self-type, name)
    if written.kind == .resolve-slot && evaluates-value()
        if bindings.slots[written.slot].kind == .slot-this
            = Typed(unit.self, unit.self-type)
        if bindings.slots[written.slot].kind == .slot-argument && rule-names.length != 0
            = read-rule-value(written.slot, id, type)
if binding != no-binding && unit.reading != unit.instance && unit.reading != unit.lender
    . apart = bindings.resolution-of(binding, id)
    if apart.kind == .resolve-slot && bindings.slots[apart.slot].kind == .slot-lazy
        = read-apart(apart.slot, id, type)
refuse(.refused-expression, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do read-apart Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` A lazy local declared under a value the type pass typed apart from the function that
` evaluates it, the value of a property or of a global: its one read evaluates in place the
` value it is declared with. One read in several places, or declared with others, has no
` shape there, and no local is read by its own value. A local the type pass kept no type
` for has the type of its read.
. nothing = make-operand(.operand-void, 0)
. bound = bindings.bindings[instances.rows[unit.reading].binding].slots
if slot < bound.start || slot >= bound.start + bound.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. kept = facts.slot-type(unit.reading, slot - bound.start)
. held = if kept == no-type then type else kept
. inline = bindings.lazy-reads-once(slot) && held == type && type != no-type
for open in lazy-open
    if open == slot
        inline = false
match? tree.nodes[bindings.slots[slot].group]
    | .node-declare(row)
        . name = row.left
        . annotation SyntaxId = 0
        match? tree.nodes[row.left]
            | .node-type-capture(capture)
                name = capture.id
                annotation = capture.type
        if inline && row.right != 0
            lazy-open += slot
            . value = declared-value(name, annotation, row.right, held)
            lazy-open.pop()
            = value
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do reads-surely Bool
    - id SyntaxId

` Whether the value being evaluated reads a property of the object at a node whenever it is
` evaluated, as the type pass recorded the read.
. read = tables.first-read(unit.reading)
while read != no-fact
    if facts.value-reads[read].syntax == id
        = facts.value-reads[read].surely
    read = tables.next-read(read)
= false

────────────────────
_ do names-slot Bool
    - id SyntaxId
    - kind SlotKind

` Whether a node of the body being emitted is a name bound to a slot of one kind: the
` receiver, or its base's part.
if id == 0 || unit.instance == no-instance || unit.reading != unit.instance
    = false
. binding = instances.rows[unit.instance].binding
if binding == no-binding
    = false
match? tree.nodes[id]
    | .node-identifier
        . resolution = bindings.resolution-of(binding, id)
        if resolution.kind == .resolve-slot
            = bindings.slots[resolution.slot].kind == kind
= false

────────────────────
_ do read-filled Typed
    - id SyntaxId
    - name Atom

` A property of the object being made, read by the value its class writes for another. A
` property with no value yet is given its own first, which is the order TypeScript evaluates
` them in. One read where its value may come on some paths alone, under a condition or in a
` value so given, is given it where its flag says it has none (`check-property`), as the
` reference gives it. A lazy property is evaluated by its function, which reads the object: it
` is read only when every property its value reads has its own.
. nothing = make-operand(.operand-void, 0)
. found = property-of(filling.type, name)
if !found
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. position = (found as U32) - filling.start
if filling.filled[position] != 3 && lazy-property && reads-unfilled(found as U32, 0)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. lazy-property = types.properties[found].storage-kind == .storage-lazy
if facts.defers(unit.instance, found as U32)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if filling.filled[position] != 2
    . unsure = (instances.rows[unit.reading].branches && !reads-surely(id)) || checking != 0
    if (unsure || filling.filled[position] == 4) && filling.filled[position] == 3
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . own-unit = unit
    . own-filling = filling
    unit = unit.source-module = function.module
    unit = unit.reading = unit.instance
    if unsure || filling.filled[position] == 4
        check-property(position, 0)
        filling.filled[position] = if unsure then 4 else 2
    else if filling.filled[position] == 3
        store-stale(position, 0)
    else
        store-property(position, 0)
    unit = own-unit
    filling = own-filling
= load-property(id, unit.self, filling.type, name)

────────────────────
_ reads-unmade Bool
    - id SyntaxId
    - name Atom

` Whether a name the constructor reads while it gives the properties their first values, as
` in the value of a `..` it writes for one, is a stored property of the object being made,
` which gets its own value first where it has none (`read-filled`), as TypeScript reads it.
|? !filling.storing || filling.count == 0 || unit.reading != unit.instance || facts.plan-of(unit.reading, id) != .plan-none
    false
|? getter != no-fact && facts.calls[getter].form == .call-getter
    false
|? !found
    false
??
    kind == .storage-eager || kind == .storage-lazy

.. getter = own-call(id)
.. found = property-of(filling.type, name)
.. kind = types.properties[found].storage-kind

────────────────────
_ do reads-unfilled Bool
    - place U32
    - depth U32

` Whether the value a class writes for a lazy property may read, in the object being made,
` a stored property that has no value yet: by its name, through another lazy property, or
` in some way the type pass recorded no name for, as through the receiver itself or a
` function of its class. A value no instance typed may.
if tables.default-of(filling.type, place).value == 0
    = false
. unit-id = tables.value-unit(place)
if depth > 8 || unit-id == no-instance || instances.rows[unit-id].reads-self
    = true
. read = tables.first-read(unit-id)
while read != no-fact
    . found = property-read(filling.type, read)
    if !found
        = true
    . kind = types.properties[found].storage-kind
    if kind == .storage-eager && filling.filled[(found as U32) - filling.start] != 2
        = true
    if kind == .storage-getter
        = true
    if kind == .storage-lazy && (found as U32) != place && reads-unfilled(found as U32, depth + 1)
        = true
    read = tables.next-read(read)
= false

────────────────────
_ do emit-address-of Operand
    - id SyntaxId

` The address of a local or of an argument: of its cell, which stays in the frame, as the
` cell of a struct always does. A lazy local is first given its value as a read of it is. A
` struct argument has no cell: it is the address of memory the function owns. In a function
` that yields it is the address of where the function's own environment keeps the local, a
` struct there too, which is there from one step to the next.
. binding = instances.rows[unit.reading].binding
if binding != no-binding && unit.reading == unit.instance
    . resolution = bindings.resolution-of(binding, id)
    if resolution.kind == .resolve-slot
        . offset = slot-offset(resolution.slot, id)
        . layout = layout-of(facts.node-type(unit.reading, id), id)
        . kind = bindings.slots[resolution.slot].kind
        if is-pointer(layout) && kind == .slot-lazy
            read-lazy-local(resolution.slot, id, facts.slot-type(unit.instance, offset))
        . kept = stepping && (kind == .slot-local || kind == .slot-argument) && slot-captured
            .. slot-captured = is-captured(resolution.slot)
        if is-pointer(layout) && kept
            . field = find-captured(resolution.slot, id)
            if hops == no-hops
                = address(captured-base(id), field.offset, layout, id)
            refuse(.refused-expression, id)
            = make-operand(.operand-void, 0)
        if is-pointer(layout) && unit.cells[offset] != no-local
            . cell = ir.locals[unit.cells[offset]]
            if cell.address-taken || tables.layouts.is-struct(cell.layout)
                . made = make-operand
                    - .operand-value
                    - append(.op-local-address, id, Span(), unit.cells[offset], layout)
                = made
        if is-pointer(layout) && !stepping && own-argument
            . index = argument-position(resolution.slot) + (if unit.takes-self then 1 else 0)
            if unit.cells[offset] == no-local && index < ir.arguments.length && struct-argument
                = address(make-operand(.operand-argument, index), 0, layout, id)
            .. struct-argument = tables.layouts.is-struct(ir.arguments[index])
        .. own-argument = kind == .slot-argument && is-own-slot(resolution.slot)
refuse(.refused-expression, id)
= make-operand(.operand-void, 0)

────────────────────
_ do read-local Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` The value of a local: what its cell holds, in the type the local was given. A local that
` holds nothing has no cell. Where the type pass narrowed an optional local to what it
` holds, the read is of that.
. nothing = make-operand(.operand-void, 0)
. offset = slot-offset(slot, id)
. held = facts.slot-type(unit.instance, offset)
. cased = held != type && facts.plan-of(unit.reading, id) == .plan-case-read
if held != type && !holds(held, type) && !cased
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if unit.cells[offset] == no-local
    if layout-of(held, id) != void-layout
        refuse(.refused-expression, id)
    = Typed(nothing, type)
. value = load-local(unit.cells[offset], id)
if held == type
    = Typed(value, type)
if id == stored-read && !cased
    = Typed(value, held)
if shared-depth != 0 && !facts.is-inside-read(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if cased
    = read-case(id, value, held, type)
= payload(id, Typed(value, held))

────────────────────
_ do read-case Typed
    - id SyntaxId
    - value Operand
    - held TypeId
    - type TypeId

` A union read as the one case the type pass knows it to hold: what the case holds, where it
` lies. An optional that holds the union is known to hold a value, and is read with no test.
` An object a case holds is read as a class it derives from, or as one derived from its own
` that a test the flow passed found it to be of.
. nothing = make-operand(.operand-void, 0)
. constant = facts.constant-of(unit.reading, id)
. whole = value
. union = held
if types.is-optional(held)
    . inner = payload(id, Typed(value, held))
    whole = inner.operand
    union = inner.type
. layout = layout-of(union, id)
if constant == no-fact || !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. index = facts.constants[constant].bits as U32
if index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. field = tables.layouts.case-field(layout, index)
. lined = tables.is-class(field.type) && tables.is-class(type) && related
    .. related = descends(field.type, type) || descends(type, field.type)
if field.type != type && !lined
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= Typed(take(whole, field, id), type)

────────────────────
_ do evaluated-before Bool
    - flag LocalId

` Whether an evaluation of a lazy local kept behind a flag, emitted in the function, ended in a
` block every way here passes, so that the flag is set here and a read evaluates nothing, as the
` reference skips a read whose block one of its evaluations dominates.
for position in 0 .. < ready-lazies.length
    if ready-lazies[position].flag == flag && ir.dominates(ready-lazies[position].block, ir.current)
        = true
= false

────────────────────
_ read-wavers Bool
    - slot SlotId
    - site SyntaxId

` Whether the value of a lazy local evaluated by a read is typed where what the flow knows of
` what it reads may not hold here: the type pass found a read that knows a local the value
` reads otherwise than the first, or found this read of the emitted function's own to evaluate
` nothing where it does.
facts.lazy-wavers(unit.reading, slot) || (unit.reading == unit.instance && facts.is-dominated-read(unit.instance, site))

────────────────────
_ do force-held
    - slot SlotId
    - site SyntaxId

` Gives a lazy local the emitted function declares and holds as an eager local is its value
` where it has none yet: tests the flag the function keeps for it, and evaluates the value
` where it is clear, stores it in the environment and sets the flag. What the flow knows in the
` value holds here as at a read, unless the type pass found a read where a local the value reads
` is known otherwise.
. offset = slot-offset(slot, site)
. flag = unit.lazy-flags[offset]
. field = find-captured(slot, site)
if flag == no-local || field.type == no-type || field.type == invalid-type
    refuse(.refused-expression, site)
    =
if evaluated-before(flag)
    =
. group = bindings.slots[slot].group
. evaluate = ir.reserve-block()
. ready = ir.reserve-block()
branch(load-local(flag, site), ready, evaluate)
ir.start-block(evaluate)
. wavers = read-wavers(slot, site)
if wavers
    shared-depth += 1
lazy-open += slot
. value = make-operand(.operand-void, 0)
match tree.nodes[group]
    | .node-declare(declaration)
        . name = declaration.left
        . annotation SyntaxId = 0
        match? tree.nodes[declaration.left]
            | .node-type-capture(capture)
                name = capture.id
                annotation = capture.type
        if declaration.right == 0
            refuse(.refused-expression, site)
        else
            value = declared-value(name, annotation, declaration.right, field.type).operand
            claim-lazy(group, value, field.type)
    ??
        refuse(.refused-expression, site)
lazy-open.pop()
if wavers
    shared-depth -= 1
keep-captured(slot, value, field.type, site)
store-local(flag, integer(.machine-u8, 1), site)
jump(ready)
ir.start-block(ready)
ready-lazies += ReadyLazy(flag, ready)

────────────────────
_ do force-captured
    - site SyntaxId

` Gives each lazy local held as an eager local is (`holds-lazy`) that the emitted function
` declares and the nested function written at a node reads its value before the nested function
` is made, as `read-held` requires.
if unit.instance == no-instance || unit.reading != unit.instance
    =
. binding = instances.rows[unit.instance].binding
if binding == no-binding
    =
. bound = bindings.bindings[binding]
for offset in 0 .. < bound.nested.count
    . nested = bindings.nested[bound.nested.start + offset]
    if nested.syntax != site
        continue
    for index in 0 .. < nested.captures.count
        . slot = bindings.captures[nested.captures.start + index].slot
        if bindings.slots[slot].kind != .slot-lazy || !tables.holds-lazy(slot) || uncaptured
            continue
        .. uncaptured = !owns(slot) || !is-captured(slot)
        . open = false
        for held in lazy-open
            open = open || held == slot
        if !open
            force-held(slot, site)

────────────────────
_ do read-item Typed
    - loop SyntaxId
    - id SyntaxId
    - type TypeId

` The item of a loop whose body is being emitted, in the type the loop gives it. Where the
` type pass narrowed an optional item to what it holds, or a union to a case, the read is of
` that, as a local's is.
. nothing = make-operand(.operand-void, 0)
. position = loops.length
while position != 0
    position -= 1
    . row = loops[position]
    if row.syntax != loop
        continue
    if row.item-type == type
        if row.kept != no-slot
            = state(row.kept, id)
        = Typed(row.item, type)
    . cased = facts.plan-of(unit.reading, id) == .plan-case-read
    if row.kept == no-slot || shared-depth != 0 || (!cased && !holds(row.item-type, type))
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . value = state(row.kept, id)
    if cased
        = read-case(id, value.operand, row.item-type, type)
    = payload(id, value)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do unit-text Operand
    - type TypeId

` The name a number of a type is written with, as text.
. text = ""
. name = unit-name(types, type)
if name
    text = name.text
= make-operand(.operand-constant, ir.add-string(text))

────────────────────
_ argument-position U32
    - slot SlotId

` Which of the function's arguments a slot of its own binding is.
unit.positions[slot - unit.slot-start]

────────────────────
_ is-own-slot Bool
    - slot SlotId

slot >= unit.slot-start && slot - unit.slot-start < unit.slot-count

────────────────────
_ do load-property Typed
    - id SyntaxId
    - object Operand
    - owner TypeId
    - name Atom
    - own Bool = false
    - read TypeId = no-type

` Reads a stored property of an object, or a field of a struct: a scalar is loaded, and a
` struct is its address inside its owner. A property with no bits is read as nothing. A lazy
` property is read through its function, and under `catch` it may have the type of what that
` function answers where the value lets out errors. The read has the property's own type, or,
` where the type pass knows an optional property to hold a value, the type of what it holds:
` the read is then of that, with no test. A link of an optional chain has the property's own
` type, which the chain then holds in the optional its node has, and so has, as `own` says,
` the property a case of a union stores, read for a member the union forwards. A name a
` call calls is typed by no node, and is read as the type given. Where no table holds a
` function for a lazy property, as no object of a class that has it is ever made, the read never
` runs, and stands for the value its type has with nothing written (`unread-value`).
. nothing = make-operand(.operand-void, 0)
if types.is-optional(owner)
    = optional-member(id, object, owner, name)
. found = property-of(owner, name)
if !found
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. property = types.properties[found]
. typed = if read != no-type then read else facts.node-type(unit.reading, id)
. type = if own || is-link(id) then property.type else typed
. holds = property.type != type && types.is-optional(property.type)
. narrowed = holds && types.optional-inner(property.type) == type
. is-lazy = property.storage-kind == .storage-lazy && tables.is-class(owner)
if is-lazy && !tables.lazy-runs(found as U32)
    = unread-value(type, layout-of(type, id), id)
. caught = is-lazy && type != property.type && type == tables.lazy-result(found as U32)
. cased = property.type != type && !is-lazy && unit.reading != no-instance && case-read
    .. case-read = facts.plan-of(unit.reading, id) == .plan-case-read
if ((property.type != type && !narrowed && !cased) || (narrowed && is-lazy)) && !caught
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if is-lazy
    = read-lazy(id, object, found as U32)
. field = held-field(id, owner, found)
if field.layout == void-layout
    = Typed(nothing, type)
settle-memo(id, object, owner, property)
if narrowed && id == stored-read
    = Typed(take(object, field, id), property.type)
if narrowed && shared-depth != 0 && !facts.is-inside-read(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if narrowed
    = payload(id, Typed(take(object, field, id), property.type))
if cased
    = read-case(id, take(object, field, id), property.type, type)
if tables.layouts.is-struct(field.layout)
    = Typed(address(object, field.offset, field.layout, id), type)
. loaded = load(object, field.offset, field.layout, id)
if unit.reading != no-instance && facts.plan-of(unit.reading, id) == .plan-guarded-read
    = guard-element(id, Typed(loaded, type), name)
= Typed(loaded, type)

────────────────────
_ do held-field LayoutField
    - site SyntaxId
    - owner TypeId
    - place Index

` Where an object or a struct holds a property it stores as declared, how, and its type.
. none = LayoutField(0, no-layout)
. property = types.properties[place]
if property.storage-kind != .storage-eager
    refuse(.refused-expression, site)
    = none
. holder = layout-of(owner, site)
. field = none
if tables.layouts.is-struct(holder)
    field = tables.layouts.field(holder, property.slot)
else if tables.is-class(owner) && tables.layouts.objects[owner] != no-layout
    . object-layout = tables.layouts.objects[owner]
    field = tables.layouts.field(object-layout, object-header-fields + property.slot)
if field.layout == no-layout
    refuse(.refused-type, site)
    = none
= LayoutField(field.offset, field.layout, property.type)

────────────────────
_ do optional-member Typed
    - id SyntaxId
    - object Operand
    - owner TypeId
    - name Atom

` What an optional answers by itself: `value`, what it holds, read with no test, and
` `has-value`, its flag.
if name == types.value-atom!
    = payload(id, Typed(object, owner))
if name == types.has-value-atom! && is-null-form(owner)
    = present(id, Typed(object, owner))
. layout = layout-of(owner, id)
if name != types.has-value-atom! || !tables.layouts.is-struct(layout)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. flag = tables.layouts.field(layout, 1)
= Typed(load(object, flag.offset, flag.layout, id), facts.node-type(unit.reading, id))

────────────────────
_ property-of Index?
    - owner TypeId
    - name Atom

` The property of a type by its name, among those the type pass completed it with, as the
` module whose code is emitted sees it.
types.property-seen(owner, name, unit.source-module)

────────────────────
_ property-read Index?
    - owner TypeId
    - read FactId

` The property a value written for another reads, as the module of the value sees it.
types.property-seen(owner, value.name, instances.rows[value.instance].module)

.. value = facts.value-reads[read]

────────────────────
_ do emit-binary Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` A binary operator, in the way the type pass planned it. A pipe written on one line with
` what it reads is one.
if op == .coalesce-op
    = emit-coalesce(id, lhs, rhs)
if op == .else-op
    match? tree.nodes[lhs]
        | .node-binary-expression(row)
            = emit-choice(id, row.lhs, row.rhs, rhs)
if forward-pipe || write-pipe || op == .grammar-pipe-op || pipes-stream(op)
    = emit-pipe(id, op, lhs, rhs)
.. forward-pipe = op == .pipe-forward-op || op == .pipe-closure-op
.. write-pipe = op == .pipe-write-all-op || op == .pipe-write-each-op
if op == .concat-op || op == .concat-string-op
    = emit-concat(id, lhs, rhs, op == .concat-string-op)
if op == .and-op || op == .or-op
    = emit-logic(id, op == .and-op, lhs, rhs)
if op == .if-op
    = emit-conditional(id, lhs, rhs)
= emit-planned(id, op, lhs, rhs, facts.plan-of(unit.reading, id))

────────────────────
_ do emit-planned Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId
    - plan OperatorPlan

` A binary operator answered by a plan: the one the type pass recorded at the node, or for
` operands compared as what they hold the plan of that comparison.
if plan == .plan-absent && (op == .equals-op || op == .not-equals-op)
    = emit-absent(id, lhs, rhs, op == .not-equals-op)
if plan == .plan-held && (op == .equals-op || op == .not-equals-op)
    = emit-held(id, lhs, rhs, op == .not-equals-op)
if plan == .plan-list-member
    = emit-list-member(id, op, lhs, rhs)
if plan == .plan-builtin
    = emit-builtin(id, op, lhs, rhs)
if plan == .plan-sign-checked-left || plan == .plan-sign-checked-right
    = emit-sign-checked(id, op, lhs, rhs, plan == .plan-sign-checked-left)
if plan == .plan-call && is-function-call(id)
    = emit-fact-call(id, facts.calls[own-call(id)], 0, RowRange'SyntaxId(), rhs, lhs)
if plan == .plan-call || plan == .plan-negated-call || plan == .plan-neither-call || not-or-plan
    = emit-operator-call(id, lhs, rhs, plan)
.. not-or-plan = plan == .plan-not-or-call
if plan == .plan-pointer-add && op == .add-op
    = emit-pointer-add(id, lhs, rhs)
if plan == .plan-table && op == .add-op && table-op(id) == TableOp.table-zip
    = emit-table-zip(id, lhs, rhs)
if plan == .plan-fields || plan == .plan-not-fields
    = emit-fields-compare(id, lhs, rhs, plan == .plan-not-fields)
if plan == .plan-class-test && (op == .is-op || op == .is-not-op)
    = emit-class-test(id, lhs, op == .is-not-op)
if plan == .plan-is
    = emit-is
        - id
        - lhs
        - rhs
        - op == .is-not-op || op == .is-not-exactly-op || op == .is-not-similar-op
if plan == .plan-identity && (op == .equals-op || op == .not-equals-op)
    = emit-identity(id, lhs, rhs, op == .not-equals-op)
if plan == .plan-address-compare && is-comparison(op)
    = emit-address-compare(id, op, lhs, rhs)
if plan == .plan-interface-equal && (op == .equals-op || op == .not-equals-op)
    = emit-interface-equal(id, lhs, rhs, op == .not-equals-op)
if plan == .plan-interface-unlike && (op == .equals-op || op == .not-equals-op)
    = emit-interface-unlike(id, lhs, rhs)
if (plan == .plan-unlike || plan == .plan-alike) && (op == .equals-op || op == .not-equals-op)
    emit-expression(lhs)
    emit-expression(rhs)
    = Typed(integer(.machine-u8, if (op == .not-equals-op) == (plan == .plan-unlike) then 1 else 0), types.bool-type)
refuse(.refused-expression, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do emit-list-member Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` `has` or `has not` of a list written in place, or `is in` or `not in` of a value in one,
` answered as `List.has` answers it without making the list: the operands are evaluated in the
` order they are written, the items converted as the list's are and the value as the argument
` of `has` is, and each item in turn is compared with the value by the plan of `==` recorded at
` the list, up to the first that is equal.
. nothing = make-operand(.operand-void, 0)
. is-right = op == .is-in-op || op == .not-in-op
. negated = op == .has-not-op || op == .not-in-op
. written = if is-right then rhs else lhs
. tested = if is-right then lhs else rhs
. items = RowRange'SyntaxId()
match? tree.nodes[written]
    | .node-list-syntax(row)
        items = row.items
. has = own-call(id)
. plan = facts.plan-of(unit.reading, written)
. equality = list-equality(written)
. machine = plan == .plan-builtin || plan == .plan-identity
if items.count == 0 || has == no-fact || (!machine && (plan != .plan-call || equality == no-fact))
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. item-type = instances.argument-type(facts.calls[has].callee, 0)
. value = Typed(nothing, no-type)
if is-right
    . emitted = emit-expression(tested)
    value = Typed(apart(emitted, tested, !is-inert(written)), emitted.type)
. start = given.length
. disturbed = items.count > 1 || (!is-right && !is-inert(tested))
for item in tree.children[items]
    . made = emit-expression(item)
    given += Typed(apart(made, item, disturbed), made.type)
for position in 0 .. < items.count
    . item = tree.children[items.start + position]
    given[start + position] = convert(item, .reason-element, given[start + position])
    if given[start + position].type != item-type
        refuse(.refused-conversion, item)
if !is-right
    value = emit-expression(tested)
value = convert(tested, .reason-argument, value)
if value.type != item-type
    refuse(.refused-conversion, tested)
. joined = ir.reserve-block()
. slot = make-operand(.operand-void, 0)
. arrivals = joins.length
. found = integer(.machine-u8, if negated then 0 else 1)
for position in 0 .. < items.count
    . item = tree.children[items.start + position]
    . element = given[start + position].operand
    . equal = nothing
    if machine
        equal = compare(item, .compare-equal, element, value.operand)
    else
        . answer = call-operator(written, equality, written, element, item-type, written, value.operand, item-type)
        if answer.type != types.bool-type
            refuse(.refused-expression, id)
        equal = answer.operand
    . matched = ir.reserve-block()
    . next = ir.reserve-block()
    branch(equal, matched, next)
    ir.start-block(matched)
    arrive(id, found, joined, slot)
    ir.start-block(next)
drop-given(start)
arrive(id, integer(.machine-u8, if negated then 1 else 0), joined, slot)
= Typed(close-joins(joined, arrivals, u8-layout, slot), types.bool-type)

────────────────────
_ do list-equality FactId
    - written SyntaxId

` The call of `==` recorded at a list written in place, after the calls that would make it, or
` no fact where none was.
. fact = facts.first-call(unit.reading, written)
while fact != no-fact
    if facts.calls[fact].form == .call-operator
        = fact
    fact = facts.calls[fact].next
= no-fact

────────────────────
_ do emit-held Typed ?! Refused
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` `==` of operands compared as what they hold, or with `negated` `!=`: optionals, or a union
` on the left tested for one case, after what an optional holds is taken from it. Both operands
` are evaluated once, the left one first. An
` optional that holds nothing equals nothing that holds a value, and two that hold nothing
` are equal where the type pass says so. A union that holds another case equals no value.
` What both hold is compared by the plan of that `==`, with the operands in the order the
` type pass planned it in.
. nothing = make-operand(.operand-void, 0)
. held = facts.held-of(unit.reading, id)
. mark = pins.length
. emitted = emit-expression(lhs)
. left = apart(emitted, lhs, !is-inert(rhs))
. left-type = emitted.type
. right = emit-expression(rhs)
. right-type = right.type
if held.left != types.is-optional(left-type) || right-differs || held.plan == .plan-held
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. right-differs = held.right != types.is-optional(right-type)
. joined = ir.reserve-block()
. slot = make-operand(.operand-void, 0)
. arrivals = joins.length
. differs = integer(.machine-u8, if negated then 1 else 0)
if held.left
    . filled = ir.reserve-block()
    . empty = ir.reserve-block()
    branch(present(id, Typed(left, left-type)).operand, filled, empty)
    ir.start-block(empty)
    if held.alike
        . other = present(id, Typed(right.operand, right-type))
        arrive(id, (if negated then other else compare-zero(id, other, .compare-equal)).operand, joined, slot)
    else
        arrive(id, differs, joined, slot)
    ir.start-block(filled)
    . inner = payload(id, Typed(left, left-type))
    left = inner.operand
    left-type = inner.type
if held.case-index != U32.max
    . layout = layout-of(left-type, id)
    if !tables.layouts.is-union(layout) || past-cases
        refuse(.refused-expression, id)
    .. past-cases = held.case-index >= tables.layouts.rows[layout].cases.count
    . filled = ir.reserve-block()
    . empty = ir.reserve-block()
    branch(case-test(id, left, held.case-index), filled, empty)
    ir.start-block(empty)
    arrive(id, differs, joined, slot)
    ir.start-block(filled)
    . field = tables.layouts.case-field(layout, held.case-index)
    left = take(left, field, id)
    left-type = field.type
if held.right
    . filled = ir.reserve-block()
    . empty = ir.reserve-block()
    branch(present(id, Typed(right.operand, right-type)).operand, filled, empty)
    ir.start-block(empty)
    arrive(id, differs, joined, slot)
    ir.start-block(filled)
    right = payload(id, Typed(right.operand, right-type))
    right-type = right.type
pin(lhs, left, left-type)
pin(rhs, right.operand, right-type)
. equal = Typed(nothing, no-type)
if held.exchanged
    equal = emit-planned(id, .equals-op, rhs, lhs, held.plan)
else
    equal = emit-planned(id, .equals-op, lhs, rhs, held.plan)
unpin(mark)
if equal.type != types.bool-type
    refuse(.refused-expression, id)
if negated
    equal = compare-zero(id, equal, .compare-equal)
arrive(id, equal.operand, joined, slot)
. answer = close-joins(joined, arrivals, u8-layout, slot)
= Typed(answer, types.bool-type)

────────────────────
_ do emit-absent Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` Compares an optional with `null`, written on either side: they are equal when the optional
` holds nothing. An operand that is not an optional is a local known to hold a value.
. nothing = make-operand(.operand-void, 0)
. left = emit-expression(lhs)
. left-type = left.type
. right = emit-expression(rhs)
. subject = right
if left-type != types.null-type
    subject = left
if !types.is-optional(subject.type)
    = Typed(integer(.machine-u8, if negated then 1 else 0), types.bool-type)
. filled = present(id, subject)
if negated
    = filled
= Typed(compare(id, .compare-equal, filled.operand, integer(.machine-u8, 0)), filled.type)

────────────────────
_ do emit-conditional Typed
    - id SyntaxId
    - chosen SyntaxId
    - condition SyntaxId

` `value if condition`: an optional that holds the value where the condition tests as true,
` and nothing where it does not. The value is evaluated only then, and arrives as the
` optional by the conversion recorded for a side.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. joinable = tables.layouts.is-struct(layout) || is-null-form(type)
if !types.is-optional(type) || !joinable
    refuse(.refused-type, id)
. tested = test(id, emit-expression(condition), true, true)
. taken = ir.reserve-block()
. passed = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
branch(tested.operand, taken, passed)
ir.start-block(taken)
emit-arm(id, chosen, type, joined, slot)
ir.start-block(passed)
arrive(id, empty-optional(type, layout).operand, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), type)

────────────────────
_ do emit-class-test Typed
    - id SyntaxId
    - lhs SyntaxId
    - negated Bool

` Whether an object is of a class or of one derived from it, or with `negated` whether it
` is not. The class is the constant the type pass recorded at the node.
. nothing = make-operand(.operand-void, 0)
. fact = facts.constant-of(unit.reading, id)
. value = emit-expression(lhs)
if fact == no-fact || !tables.is-class(value.type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. target = facts.constants[fact].bits as TypeId
if !tables.is-class(target)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. matched = ir.reserve-block()
. missed = ir.reserve-block()
. joined = ir.reserve-block()
class-branch(id, value.operand, target, matched, missed)
ir.start-block(matched)
jump(joined)
ir.start-block(missed)
jump(joined)
ir.start-block(joined)
. yes = integer(.machine-u8, 1)
. no = integer(.machine-u8, 0)
= Typed(phi(u8-layout, if negated then no else yes, matched, if negated then yes else no, missed), types.bool-type)

────────────────────
_ do class-branch
    - site SyntaxId
    - value Operand
    - type TypeId
    - matched IRBlockId
    - missed IRBlockId
    - witnessed Bool = false

` Leaves to `matched` when an object is of a class or of one derived from it, and to
` `missed` when it is not: the object's table, and then the table of each base in turn, is
` compared with the class's. A class the program constructs no object of, nor of any class
` derived from it, has no table, and no object is of it. With `witnessed` the value is one
` of an interface, and the first table is the one its witness table names, which is nothing
` where it holds no object.
. symbol = tables.table-symbols[type]
if symbol == no-string
    jump(missed)
    =
. cell = ir.add-local(pointer-layout)
if witnessed
    . second = tables.layouts.field(tables.layouts.interface-layout, 1).offset
    . witness = load(value, second, pointer-layout, site)
    store-local(cell, load(witness, 2 * table-slot-size, pointer-layout, site), site)
else
    store-local(cell, load(value, 0, pointer-layout, site), site)
. head = ir.reserve-block()
. held = ir.reserve-block()
. climb = ir.reserve-block()
jump(head)
ir.start-block(head)
. table = load-local(cell, site)
branch(table, held, missed)
ir.start-block(held)
if matching.exact-class
    branch
        - compare(site, .compare-equal, table, make-operand(.operand-symbol, symbol))
        - matched
        - missed
    ir.start-block(climb)
    jump(missed)
    =
branch(compare(site, .compare-equal, table, make-operand(.operand-symbol, symbol)), matched, climb)
ir.start-block(climb)
store-local(cell, load(table, 0, pointer-layout, site), site)
jump(head)

────────────────────
_ do down-cast Typed
    - site SyntaxId
    - value Operand
    - type TypeId
    - declared Bool = false

` An object as a class derived from the one it is known by: the object itself when it is of
` that class, and a panic when it is not, or inside a pattern a value that does not match.
` The panic of a cast names the class; where a declaration wrote the class for a local, it
` is that of a pattern that failed.
if matching.failing != no-block
    . passed = ir.reserve-block()
    class-branch(site, value, type, passed, matching.failing)
    fail-jumps += 1
    ir.start-block(passed)
    = Typed(value, type)
if !function.may-panic
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. matched = ir.reserve-block()
. missed = ir.reserve-block()
class-branch(site, value, type, matched, missed)
ir.start-block(missed)
raise-text
    - site
    - if declared then "Pattern match failed" else "Invalid cast to ${type-display(types, type)}"
ir.start-block(matched)
= Typed(value, type)

────────────────────
_ do held-as Typed
    - site SyntaxId
    - value Operand
    - type TypeId
    - declared Bool = false

` What a value of an interface holds, as the class or the tuple a cast or a pattern names.
` It holds an object of a class where the table its witness table names is the class's or
` that of one derived from it, and a value of any other type where the type its witness
` table describes is that one. A type nothing is converted to an interface from has no
` description named, and nothing holds it. A value that holds another panics, or inside a
` pattern does not match. The panic is that of a cast, or where a declaration wrote the type
` for a local, that of a pattern that failed.
. missed = matching.failing
if matching.failing == no-block
    if !function.may-panic
        refuse(.refused-conversion, site)
        = Typed(value, no-type)
    missed = ir.reserve-block()
else
    fail-jumps += 1
. passed = ir.reserve-block()
. named = tables.rtti-symbols[type]
if tables.is-class(type)
    class-branch(site, value, type, passed, missed, true)
else if named == no-string
    jump(missed)
else
    . second = tables.layouts.field(tables.layouts.interface-layout, 1).offset
    . described = load(load(value, second, pointer-layout, site), 0, pointer-layout, site)
    branch
        - compare(site, .compare-equal, described, make-operand(.operand-symbol, named))
        - passed
        - missed
if matching.failing == no-block
    ir.start-block(missed)
    raise-text(site, if declared then "Pattern match failed" else "Invalid cast to ${type-display(types, type)}")
ir.start-block(passed)
= unbox(site, type, value)

────────────────────
_ do subclass-interface Typed
    - site SyntaxId
    - value Operand
    - from TypeId
    - to TypeId
    - declared Bool = false

` An object as an interface that classes derived from the one it is known by declare: the
` slot the table of its class keeps for the interface holds the class's witness table, or
` nothing where the class declares none (`dynamic-slot`). One that holds nothing panics, or
` inside a pattern does not match, as a cast to a class does.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(to, site)
. slot = tables.dynamic-slot(from, to)
if layout != tables.layouts.interface-layout || slot == no-slot-index
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. missed = matching.failing
if matching.failing == no-block
    if !function.may-panic
        refuse(.refused-conversion, site)
        = Typed(nothing, no-type)
    missed = ir.reserve-block()
else
    fail-jumps += 1
. passed = ir.reserve-block()
. class-table = load(value, 0, pointer-layout, site)
. table = load(class-table, table-header-size + slot * table-slot-size, pointer-layout, site)
branch(compare(site, .compare-not-equal, table, integer(.machine-pointer, 0)), passed, missed)
if matching.failing == no-block
    ir.start-block(missed)
    raise-text
        - site
        - if declared then "Pattern match failed" else "Invalid cast to ${type-display(types, to)}"
ir.start-block(passed)
. made = frame(layout)
store(made, 0, value, false, site)
store(made, tables.layouts.field(layout, 1).offset, table, false, site)
= Typed(made, to)

────────────────────
_ do emit-identity Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` Two objects of one class compared, or of two classes one derived from the other, two atoms,
` or two values of one closure: equal when they are one object, one atom, or one closure's
` data, which is to say one pointer. Two values of one function type are equal when they run
` one code with one data.
. nothing = make-operand(.operand-void, 0)
. emitted = emit-expression(lhs)
. left = apart(emitted, lhs, !is-inert(rhs))
. type = emitted.type
. right = emit-expression(rhs)
if right.type == type && tables.layouts.values[type] == tables.layouts.function-layout
    . code = tables.layouts.field(tables.layouts.function-layout, 0).offset
    . data = tables.layouts.field(tables.layouts.function-layout, 1).offset
    . same-code = compare
        - id
        - .compare-equal
        - load(left, code, pointer-layout, id)
        - load(right.operand, code, pointer-layout, id)
    . same-data = compare
        - id
        - .compare-equal
        - load(left, data, managed-layout, id)
        - load(right.operand, data, managed-layout, id)
    . same = bitwise(id, .bitwise-and, same-code, same-data, u8-layout)
    = if negated then compare-zero(id, Typed(same, types.bool-type), .compare-equal) else Typed(same, types.bool-type)
. objects = tables.is-class(type) && tables.is-class(right.type)
if (right.type != type && !objects) || no-identity
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. no-identity = !tables.is-class(type) && intrinsic(type) != .atom && intrinsic(type) != .closure
= Typed(compare(id, if negated then .compare-not-equal else .compare-equal, left, right.operand), types.bool-type)

────────────────────
_ do emit-address-compare Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` Two C pointers compared by the addresses they hold, as unsigned numbers, the left one
` evaluated first.
. nothing = make-operand(.operand-void, 0)
. emitted = emit-expression(lhs)
. left = apart(emitted, lhs, !is-inert(rhs))
. left-type = emitted.type
. right = emit-expression(rhs)
. right-type = right.type
if left-type == types.null-type && intrinsic(right-type) == .cpointer
    left = integer(tables.layouts.kind-of(layout-of(right-type, id)), 0)
    left-type = right-type
if right-type == types.null-type && intrinsic(left-type) == .cpointer
    right = Typed(integer(tables.layouts.kind-of(layout-of(left-type, id)), 0), right.type)
    right-type = left-type
if intrinsic(left-type) != .cpointer || intrinsic(right-type) != .cpointer
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= Typed(compare(id, predicate-of(op), left, right.operand), types.bool-type)

────────────────────
_ do emit-fields-compare Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` Two tuples or structs compared field by field, in the order the fields are stored, up to
` the first that differs, or two unions of one type by the case they hold. The left one is
` copied first when evaluating the right one may change what it names.
. nothing = make-operand(.operand-void, 0)
. left = emit-expression(lhs)
. left-type = left.type
if !is-inert(rhs) && !is-answer(left.operand)
    left = Typed(snapshot(left.operand, layout-of(left-type, id), lhs), left.type)
. right = emit-expression(rhs)
. right-type = right.type
. differ = ir.reserve-block()
. joined = ir.reserve-block()
field-call = facts.first-call(unit.reading, id)
field-site = rhs
skip-truths()
compare-parts(id, left.operand, left-type, right.operand, right-type, differ)
if field-call != no-fact
    refuse(.refused-expression, id)
field-call = no-fact
field-site = 0
. same = ir.current
jump(joined)
ir.start-block(differ)
jump(joined)
ir.start-block(joined)
. yes = integer(.machine-u8, 1)
. no = integer(.machine-u8, 0)
= Typed(phi(u8-layout, if negated then no else yes, same, if negated then yes else no, differ), types.bool-type)

────────────────────
_ do emit-interface-equal Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` Two values of interfaces compared for equal, or with `negated` for not equal, as
` `compare-interfaces` compares them. The left one is copied first when evaluating the right
` one may change what it names.
. nothing = make-operand(.operand-void, 0)
. left = emit-expression(lhs)
. left-type = left.type
if !is-inert(rhs) && !is-answer(left.operand)
    left = Typed(snapshot(left.operand, layout-of(left-type, id), lhs), left.type)
. right = emit-expression(rhs)
field-call = facts.first-call(unit.reading, id)
skip-truths()
. equal = compare-interfaces(id, left.operand, right.operand)
if field-call != no-fact
    refuse(.refused-expression, id)
field-call = no-fact
= if negated then compare-zero(id, Typed(equal.operand, types.bool-type), .compare-equal) else Typed(equal.operand, types.bool-type)

────────────────────
_ do emit-interface-unlike Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId

` A value of an interface compared with one of a type that is none: both are evaluated, and
` it panics with the reference's text, which names the right one's type.
. nothing = make-operand(.operand-void, 0)
emit-expression(lhs)
. emitted = emit-expression(rhs)
. right-type = emitted.type
raise-text(id, "Unsupported interface equality with ${type-runtime-name(types, right-type)}")
ir.start-block(ir.reserve-block())
= Typed(integer(.machine-u8, 0), types.bool-type)

────────────────────
_ do compare-interfaces Typed
    - id SyntaxId
    - left Operand
    - right Operand

` Compares two values of interfaces as the reference does. Where the types their witness
` tables describe differ, the getter recorded next at the node says whether a tracker is
` comparing for a change: the answer is then false, and otherwise the panic `Unsupported
` interface equality: concrete types differ`. Where they agree, the function the left
` value's table holds for equality is given both, and answers; a panic it raises is the
` caller's.
. nothing = make-operand(.operand-void, 0)
if field-call == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. getter = facts.calls[field-call].callee
field-call = facts.calls[field-call].next
skip-truths()
if getter == no-instance || tables.instance-functions[getter] == no-function
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. second = tables.layouts.field(tables.layouts.interface-layout, 1).offset
. mine = load(left, second, pointer-layout, id)
. theirs = load(right, second, pointer-layout, id)
. same = ir.reserve-block()
. differ = ir.reserve-block()
. joined = ir.reserve-block()
branch
    - compare
        - id
        - .compare-equal
        - load(mine, 0, pointer-layout, id)
        - load(theirs, 0, pointer-layout, id)
    - same
    - differ
ir.start-block(differ)
. comparing = call-instance(getter, id, pending.length)
. tolerated = ir.reserve-block()
. unsupported = ir.reserve-block()
branch(comparing.operand, tolerated, unsupported)
ir.start-block(unsupported)
raise-text(id, "Unsupported interface equality: concrete types differ")
ir.start-block(tolerated)
. unequal = integer(.machine-u8, 0)
. from-differ = ir.current
jump(joined)
ir.start-block(same)
. method = load(mine, table-slot-size, pointer-layout, id)
. mark = pending.length
pending += left
pending += right
. answer = call(method, id, mark, .callee-value, u8-layout, !in-landing)
. from-same = ir.current
jump(joined)
ir.start-block(joined)
= Typed(phi(u8-layout, unequal, from-differ, answer, from-same), types.bool-type)

────────────────────
_ takes-argument Bool
    - callee InstanceId
    - given TypeId

` Whether a field's `==` takes a value of a type: as it is, or by the conversion the type pass
` recorded for it at `field-site`.
taken == given || argument-conversion(given, taken) != no-fact

.. taken = instances.argument-type(callee, 0)

────────────────────
_ do argument-conversion FactId
    - from TypeId
    - to TypeId

` The conversion the type pass recorded at `field-site` for a value a field's `==` takes, from
` the field's type to the type the `==` takes. No fact where none was recorded.
. fact = if field-site != 0 then facts.first-conversion(unit.reading, field-site) else no-fact
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-argument && row.from == from && row.to == to
        = fact
    fact = row.next
= no-fact

────────────────────
_ do skip-truths

` Moves on to the next call recorded for a field: the calls that test the node's own value
` as a condition are not for fields.
while field-call != no-fact
    if answers-node(facts.calls[field-call].form)
        =
    field-call = facts.calls[field-call].next

────────────────────
_ do compare-parts
    - id SyntaxId
    - left Operand
    - left-type TypeId
    - right Operand
    - right-type TypeId
    - differ IRBlockId

` Compares two values part by part, and leaves to `differ` at the first part that is not
` equal: two unions of one type by the case they hold, and two tuples or structs by their
` fields.
if left-type == right-type && intrinsic(left-type) == .union
    compare-cases(id, left, left-type, right, differ)
else
    compare-fields(id, left, left-type, right, right-type, differ)

────────────────────
_ do compare-cases
    - id SyntaxId
    - left Operand
    - type TypeId
    - right Operand
    - differ IRBlockId

` Compares two unions of one type, and leaves to `differ` where they hold different cases or
` what the case they hold is not equal. A case that holds a value of its own is a pair,
` compared as a field of a tuple is; one that holds none is equal to itself.
. layout = layout-of(type, id)
if !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    =
. same = ir.reserve-block()
. tag = load(left, 0, u8-layout, id)
branch(compare(id, .compare-equal, tag, load(right, 0, u8-layout, id)), same, differ)
ir.start-block(same)
. done = ir.reserve-block()
. index U32
for fact in types.cases-of(type)
    if index >= tables.layouts.rows[layout].cases.count
        refuse(.refused-expression, id)
        =
    if !fact.is-default && fact.type != no-type
        . field = tables.layouts.case-field(layout, index)
        . taken = ir.reserve-block()
        . next = ir.reserve-block()
        branch(case-test(id, left, index), taken, next)
        ir.start-block(taken)
        compare-pair(id, take(left, field, id), field, take(right, field, id), field, differ)
        jump(done)
        ir.start-block(next)
    index += 1
jump(done)
ir.start-block(done)

────────────────────
_ do compare-fields
    - id SyntaxId
    - left Operand
    - left-type TypeId
    - right Operand
    - right-type TypeId
    - differ IRBlockId

` Compares the fields of two tuples or structs in turn, and leaves to `differ` at the first
` pair that is not equal.
. mine = layout-of(left-type, id)
. theirs = layout-of(right-type, id)
if !tables.layouts.is-struct(mine) || !tables.layouts.is-struct(theirs)
    refuse(.refused-expression, id)
    =
. count = tables.layouts.rows[mine].fields.count
if tables.layouts.rows[theirs].fields.count != count
    refuse(.refused-expression, id)
    =
for position in 0 .. < count
    . held = tables.layouts.field(mine, position)
    . given = tables.layouts.field(theirs, position)
    compare-pair(id, take(left, held, id), held, take(right, given, id), given, differ)

────────────────────
_ do compare-pair ?! Refused
    - id SyntaxId
    - a Operand
    - held LayoutField
    - b Operand
    - given LayoutField
    - differ IRBlockId

` Compares one pair of parts, and leaves to `differ` where they are not equal. A pair is
` answered by the next call the type pass recorded when that call takes the pair, the second
` part converted first where the type pass recorded converting it for the call. One that no
` call takes is compared by the machine where it is of one type the machine compares, is, of
` one class or of atoms, equal when it is one object or one atom, of one function type, equal
` when the data they hold is one, is of interfaces compared as `compare-interfaces` does, is
` two optionals of one type compared as `compare-optionals` does, and is otherwise two values
` compared part by part the same way.
. equal = make-operand(.operand-void, 0)
. takes = false
if field-call != no-fact
    . callee = facts.calls[field-call].callee
    . self = instances.rows[callee].self-type
    takes = self == held.type && takes-argument(callee, given.type)
if takes
    . callee = facts.calls[field-call].callee
    . taken = instances.argument-type(callee, 0)
    . given-value = b
    if taken != given.type
        given-value = convert-one(id, facts.conversions[argument-conversion(given.type, taken)], Typed(b, given.type)).operand
    . mark = pending.length
    pending += a
    pending += given-value
    . called = call-method(callee, id, mark)
    equal = called.operand
    if called.type != types.bool-type
        refuse(.refused-conversion, id)
    field-call = facts.calls[field-call].next
    skip-truths()
else if held.type == given.type && compares-by-machine(types, held.type)
    if held.layout == void-layout
        =
    equal = compare(id, .compare-equal, a, b)
else if held.type == given.type && (tables.is-class(held.type) || intrinsic(held.type) == .atom)
    equal = compare(id, .compare-equal, a, b)
else if held.type == given.type && held.layout == tables.layouts.function-layout
    . data = tables.layouts.field(tables.layouts.function-layout, 1).offset
    equal = compare
        - id
        - .compare-equal
        - load(a, data, managed-layout, id)
        - load(b, data, managed-layout, id)
else if intrinsic(held.type) == .interface && intrinsic(given.type) == .interface
    equal = compare-interfaces(id, a, b).operand
else if held.type == given.type && types.is-optional(held.type)
    compare-optionals(id, a, b, held.type, differ)
    =
else
    compare-parts(id, a, held.type, b, given.type, differ)
    =
. next = ir.reserve-block()
branch(equal, next, differ)
ir.start-block(next)

────────────────────
_ do compare-optionals ?! Refused
    - id SyntaxId
    - a Operand
    - b Operand
    - type TypeId
    - differ IRBlockId

` Compares two optionals of one type, as the reference does, and leaves to `differ` where one
` holds a value and the other none, or both hold values that are not equal, compared as a pair
` of parts is with the right one first, as the reference compares what two optionals hold.
. holds = present(id, Typed(a, type))
. other = present(id, Typed(b, type))
. same = ir.reserve-block()
branch(compare(id, .compare-equal, holds.operand, other.operand), same, differ)
ir.start-block(same)
. filled = ir.reserve-block()
. done = ir.reserve-block()
branch(holds.operand, filled, done)
ir.start-block(filled)
. left = payload(id, Typed(a, type))
. inner = left.type
. right = payload(id, Typed(b, type))
. layout = layout-of(inner, id)
. field = LayoutField(0, layout, inner)
compare-pair(id, right.operand, field, left.operand, field, differ)
jump(done)
ir.start-block(done)

────────────────────
_ do item-address Typed
    - id SyntaxId
    - object SyntaxId
    - index SyntaxId

` Where the item an index names lies: the pointer moved on by the index times the bytes an
` item is held in. The pointer is evaluated before the index, and an index narrower than the
` pointer is widened as its own type says. It has the type of the pointer.
. nothing = make-operand(.operand-void, 0)
. base = emit-expression(object)
. type = base.type
. layout = layout-of(type, id)
. count = emit-expression(index)
. counted = layout-of(count.type, index)
. held = layout-of(tables.layouts.pointee-type(type), id)
if !is-pointer(layout) || !is-integer(counted) || held == void-layout
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. step = integer(.machine-u64, tables.layouts.rows[held].size)
. widest = if is-signed(counted) then i64-layout else u64-layout
. wide = num-cast(id, num-cast(id, count.operand, counted, widest), widest, u64-layout)
. distance = arithmetic(id, .arithmetic-multiply, wide, step, u64-layout)
. moved = arithmetic
    - id
    - .arithmetic-add
    - num-cast(id, base.operand, layout, u64-layout)
    - distance
    - u64-layout
= Typed(num-cast(id, moved, u64-layout, layout), type)

────────────────────
_ do emit-item Typed
    - id SyntaxId
    - object SyntaxId
    - index SyntaxId

` The item an index names past a pointer, read where it lies with no check. A struct is
` copied as it is read, so nothing stored there afterwards changes the value, unless a name is
` read from it at once (`read-in-place`).
. nothing = make-operand(.operand-void, 0)
. place = item-address(id, object, index)
. type = tables.layouts.pointee-type(place.type)
if !gives(id, type)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. layout = layout-of(type, id)
if layout == void-layout
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.layouts.is-struct(layout) && matching.read-in-place != id
    = Typed(snapshot(address(place.operand, 0, layout, id), layout, id), type)
if tables.layouts.is-struct(layout)
    = Typed(address(place.operand, 0, layout, id), type)
= Typed(load(place.operand, 0, layout, id), type)

────────────────────
_ view-shape U32
    - type TypeId

` What a type is among the views of an array: 1 a range of its rows, 2 the items of one field,
` 3 its fields, 4 one row, and 0 any other.
|? type == no-type || type == invalid-type
    0
|? same-decl(ref, types.array-rows-decl) || same-decl(ref, types.array-row-range-decl)
    1
|? same-decl(ref, types.array-field-decl)
    2
|? same-decl(ref, types.array-fields-decl)
    3
|? same-decl(ref, types.array-row-decl)
    4
??
    0

.. ref = class-ref(types, type)

────────────────────
_ viewed-item TypeId
    - type TypeId

` The item a view or an array holds.
match types.rows[type]
    | .type-class(row)
        if row.args.count != 0 then types.child-type(row.args, 0) else no-type
    ??
        no-type

────────────────────
_ view-slot U32
    - id SyntaxId

` The place in the item's layout of the field the type pass planned a view to read at a node.
if constant != no-fact then facts.constants[constant].bits as U32 else U32.max

.. constant = facts.constant-of(unit.reading, id)

────────────────────
_ do item-field LayoutField
    - id SyntaxId
    - view TypeId
    - slot U32

` The field of a view's item at a place in its layout.
. layout = layout-of(viewed-item(view), id)
if !tables.layouts.is-struct(layout) || past-fields
    refuse(.refused-expression, id)
    = LayoutField(0, void-layout)
.. past-fields = slot >= tables.layouts.rows[layout].fields.count
= tables.layouts.field(layout, slot)

────────────────────
_ do emit-view-get Typed
    - id SyntaxId
    - object SyntaxId

` A name the compiler answers for a view: the rows or the fields of an array, a view of its
` storage, the items of one field of a view of fields, or a field read through a row.
. nothing = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, object) == .plan-proven-row
    . found = proven-read(innermost-loop(), view-slot(id))
    if found != U32.max
        = Typed(proven-reads[found].value, proven-reads[found].type)
    . cell = proven-row-cell(id, object)
    . viewed = cell.type
    . field = item-field(id, viewed, view-slot(id))
    . read = take(cell.operand, field, id)
    proven-reads += ProvenRead(innermost-loop(), view-slot(id), ir.current, read, field.type)
    = Typed(read, field.type)
. base = emit-expression(object)
. held = base.type
. shape = view-shape(held)
if shape == 0
    = make-view(id, base.operand, held, facts.node-type(unit.reading, id))
if shape == 3
    = project-view(id, base.operand, held, view-slot(id), facts.node-type(unit.reading, id))
if shape == 4
    = row-field(id, base.operand, held, view-slot(id))
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do emit-view-index Typed
    - id SyntaxId
    - object SyntaxId
    - index SyntaxId

` An index the compiler answers for a view: a constant one names a field of a row or of the
` fields, a range a view of the rows or the items it spans, and any other the row or the item
` at that index. The view is evaluated before the key.
. nothing = make-operand(.operand-void, 0)
. emitted = emit-expression(object)
. base = apart(emitted, object, !is-inert(index))
. held = emitted.type
. shape = view-shape(held)
. type = facts.node-type(unit.reading, id)
if shape == 3
    = project-view(id, base, held, view-slot(id), type)
if shape == 4
    = row-field(id, base, held, view-slot(id))
if shape != 1 && shape != 2
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. layout = layout-of(held, id)
if view-shape(type) == shape && call-at(id, .call-view-range) != no-fact
    . range = emit-expression(index)
    . range-type = range.type
    = slice-view(id, base, held, range.operand, range-type, object, type)
. key = convert(index, .reason-argument, emit-expression(index))
if key.type != types.index-type
    refuse(.refused-conversion, index)
    = Typed(nothing, no-type)
. cell = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, id) == .plan-proven-row
    cell = proven-cell(id, base, layout, key.operand, held)
else
    cell = view-cell(id, base, layout, key.operand)
if shape == 2
    . item = viewed-item(held)
    . item-layout = layout-of(item, id)
    = Typed(take(cell, LayoutField(0, item-layout), id), item)
= view-value
    - id
    - type
    - cell
    - part(base, layout, 1, id).operand
    - integer(.machine-u64, 1)
    - part(base, layout, 3, id).operand

────────────────────
_ do make-view Typed
    - id SyntaxId
    - array Operand
    - held TypeId
    - type TypeId

` The rows or the fields of an array: its storage as bytes, the bytes of an item, its size,
` and the owner the runtime makes for the storage, which the runtime marks stale when the
` storage goes away or is replaced. The runtime's function is called as TypeScript calls it,
` with no poll around it and no panic read after it.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(held, id)
. item-layout = layout-of(viewed-item(type), id)
. data = part(array, layout, 0, id)
. data-layout = layout-of(data.type, id)
. size = part(array, layout, 1, id)
. size-layout = layout-of(size.type, id)
if !is-pointer(data-layout) || !is-integer(size-layout)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. bytes = num-cast(id, data.operand, data-layout, pointer-layout)
. count = num-cast(id, size.operand, size-layout, u64-layout)
. mark = pending.length
pending += bytes
pending += arithmetic(id, .arithmetic-multiply, count, stride, u64-layout)
. owner = call-runtime(.runtime-array-view-create, id, mark, pointer-layout)
= view-value(id, type, bytes, stride, count, owner)

────────────────────
_ do view-value Typed
    - id SyntaxId
    - type TypeId
    - bytes Operand
    - stride Operand
    - size Operand
    - owner Operand

` A view made of its four words in memory of the frame.
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 4
    refuse(.refused-type, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. memory = frame(layout)
put(memory, tables.layouts.field(layout, 0), bytes, id)
put(memory, tables.layouts.field(layout, 1), stride, id)
put(memory, tables.layouts.field(layout, 2), size, id)
put(memory, tables.layouts.field(layout, 3), owner, id)
= Typed(memory, type)

────────────────────
_ do validate-view
    - id SyntaxId
    - view Operand
    - layout LayoutId

` A view whose owner the runtime marked stale raises a panic.
. mark = pending.length
pending += part(view, layout, 3, id).operand
. valid = call-runtime(.runtime-array-view-valid, id, mark, u8-layout)
fail-view(id, compare(id, .compare-equal, valid, integer(.machine-u8, 0)), "Stale array view")

────────────────────
_ do fail-view
    - id SyntaxId
    - failed Operand
    - text String

` Raises a panic of a view where a test holds.
. raising = ir.reserve-block()
. passed = ir.reserve-block()
branch(failed, raising, passed)
ir.start-block(raising)
raise-text(id, text)
ir.start-block(passed)

────────────────────
_ do view-cell Operand
    - id SyntaxId
    - view Operand
    - layout LayoutId
    - index Operand

` Where the item at an index of a view lies, once the view is known not to be stale and the
` index to lie within it.
validate-view(id, view, layout)
. size = part(view, layout, 2, id)
fail-view(id, compare(id, .compare-greater-equal, index, size.operand), "Array view index out of bounds")
. moved = moved-bytes
    - id
    - part(view, layout, 0, id).operand
    - arithmetic(id, .arithmetic-multiply, index, part(view, layout, 1, id).operand, u64-layout)
= moved

────────────────────
_ do proven-cell Operand
    - id SyntaxId
    - view Operand
    - layout LayoutId
    - index Operand
    - held TypeId

. item-layout = layout-of(viewed-item(held), id)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. moved = moved-bytes
    - id
    - part(view, layout, 0, id).operand
    - arithmetic(id, .arithmetic-multiply, index, stride, u64-layout)
= moved

────────────────────
_ do proven-row-cell Typed
    - id SyntaxId
    - object SyntaxId

. nothing = make-operand(.operand-void, 0)
match? tree.nodes[object]
    | .node-index-expression(row)
        . view = emit-expression(row.object)
        . held = view.type
        . layout = layout-of(held, id)
        . key = convert(row.index, .reason-argument, emit-expression(row.index))
        if key.type != types.index-type
            refuse(.refused-conversion, row.index)
            = Typed(nothing, no-type)
        . cell = proven-cell(id, view.operand, layout, key.operand, held)
        = Typed(cell, held)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do moved-bytes Operand
    - id SyntaxId
    - bytes Operand
    - distance Operand

` An address moved on by a count of bytes.
. moved = arithmetic
    - id
    - .arithmetic-add
    - num-cast(id, bytes, pointer-layout, u64-layout)
    - distance
    - u64-layout
= num-cast(id, moved, u64-layout, pointer-layout)

────────────────────
_ do row-field Typed
    - id SyntaxId
    - row Operand
    - held TypeId
    - slot U32

` A field read through a row, where the row's one item lies.
. layout = layout-of(held, id)
. field = item-field(id, held, slot)
. cell = view-cell(id, row, layout, integer(.machine-u64, 0))
= Typed(take(cell, field, id), field.type)

────────────────────
_ do row-item Typed
    - id SyntaxId
    - row Operand
    - held TypeId

` The item a row views, read as the item.
. layout = layout-of(held, id)
. item = viewed-item(held)
. item-layout = layout-of(item, id)
. cell = view-cell(id, row, layout, integer(.machine-u64, 0))
= Typed(take(cell, LayoutField(0, item-layout), id), item)

────────────────────
_ do project-view Typed
    - id SyntaxId
    - fields Operand
    - held TypeId
    - slot U32
    - type TypeId

` The items of one field of a view of fields: the view's bytes moved on to the field.
. layout = layout-of(held, id)
. field = item-field(id, held, slot)
validate-view(id, fields, layout)
. bytes = moved-bytes(id, part(fields, layout, 0, id).operand, integer(.machine-u64, field.offset))
= view-value
    - id
    - type
    - bytes
    - part(fields, layout, 1, id).operand
    - part(fields, layout, 2, id).operand
    - part(fields, layout, 3, id).operand

────────────────────
_ do slice-view Typed
    - id SyntaxId
    - view Operand
    - held TypeId
    - range Operand
    - range-type TypeId
    - object SyntaxId
    - type TypeId

` The rows or the items a range spans of a view: its bytes moved on to the range's start, and
` its size the range's. The range is made forward first, and must lie within the view and
` step by one.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(held, id)
validate-view(id, view, layout)
. forward = forward-range(id, range, range-type, view, held, object)
. forward-type = forward.type
. forward-layout = layout-of(forward-type, id)
. start = range-index(id, forward.operand, forward-type, forward-layout, "start")
. end = range-index(id, forward.operand, forward-type, forward-layout, "end")
. length = arithmetic(id, .arithmetic-subtract, end.operand, start.operand, u64-layout)
. size = part(view, layout, 2, id)
fail-view(id, compare(id, .compare-greater, start.operand, size.operand), "Array view range out of bounds")
. left = arithmetic(id, .arithmetic-subtract, size.operand, start.operand, u64-layout)
fail-view(id, compare(id, .compare-greater, length, left), "Array view range out of bounds")
. step = range-part(id, forward.operand, forward-type, forward-layout, "increment")
. step-layout = layout-of(step.type, id)
if !is-integer(step-layout)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. one = integer(tables.layouts.kind-of(step-layout), 1)
fail-view
    - id
    - compare(id, .compare-not-equal, step.operand, one)
    - "Array views require a unit range increment"
. stride = part(view, layout, 1, id)
. bytes = moved-bytes
    - id
    - part(view, layout, 0, id).operand
    - arithmetic(id, .arithmetic-multiply, start.operand, stride.operand, u64-layout)
= view-value(id, type, bytes, stride.operand, length, part(view, layout, 3, id).operand)

────────────────────
_ do forward-range Typed
    - id SyntaxId
    - range Operand
    - range-type TypeId
    - view Operand
    - held TypeId
    - object SyntaxId

` A range made forward by the calls the type pass recorded at an index of a view: a range of
` positions is first made one of indexes by its `normalize`, given the view.
. nothing = make-operand(.operand-void, 0)
. fact = call-at(id, .call-view-range)
. current = Typed(range, range-type)
while fact != no-fact
    . row = facts.calls[fact]
    if row.form == .call-view-range
        . callee = row.callee
        if callee == no-instance || !is-callable(callee)
            refuse(.refused-expression, id)
            = Typed(nothing, no-type)
        . mark = pending.length
        pending += current.operand
        if instances.signatures[callee].args.count == 1
            . given = convert(object, .reason-argument, Typed(view, held))
            if given.type != instances.argument-type(callee, 0)
                refuse(.refused-conversion, object)
            pending += given.operand
        else if instances.signatures[callee].args.count != 0
            refuse(.refused-expression, id)
        current = call-method(callee, id, mark)
    fact = row.next
= current

────────────────────
_ do range-part Typed
    - id SyntaxId
    - range Operand
    - type TypeId
    - layout LayoutId
    - name String

` A field of a range, by its name.
. found = range-slot(type, name)
if found == U32.max
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
= part(range, layout, found, id)

────────────────────
_ do range-slot U32
    - type TypeId
    - name String

. properties = types.completions[type].properties
for offset in 0 .. < properties.count
    . property = types.properties[properties.start + offset]
    if property.name.text == name
        = property.slot
= U32.max

────────────────────
_ do range-index Typed
    - id SyntaxId
    - range Operand
    - type TypeId
    - layout LayoutId
    - name String

` A bound of a range, made an index.
. value = range-part(id, range, type, layout, name)
. held = layout-of(value.type, id)
if !is-integer(held)
    refuse(.refused-type, id)
    = value
= Typed(num-cast(id, value.operand, held, u64-layout), value.type)

────────────────────
_ is-array-type Bool
    - type TypeId

` Whether a type is an array, whose storage views can see.
|? type == no-type || type == invalid-type || intrinsic(type) != .tuple
    false
??
    types.ancestor-of(type, types.array-decl) != no-type || types.ancestor-of(type, types.immutable-array-decl) != no-type

────────────────────
_ do replace-storage
    - id SyntaxId
    - old Operand
    - old-type TypeId
    - next Operand
    - next-type TypeId

` Tells the runtime that the storage of an array is replaced by another's, before the other
` is stored: the views of the old storage are marked stale where it is not the new storage, or
` where the new one is smaller. The runtime's function is called as TypeScript calls it, with
` no poll around it and no panic read after it.
. old-layout = layout-of(old-type, id)
. next-layout = layout-of(next-type, id)
. item-layout = layout-of(viewed-item(next-type), id)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. mark = pending.length
for side in 0 .. < 2
    . array = if side == 0 then old else next
    . layout = if side == 0 then old-layout else next-layout
    . data = part(array, layout, 0, id)
    . data-layout = layout-of(data.type, id)
    . size = part(array, layout, 1, id)
    . size-layout = layout-of(size.type, id)
    pending += num-cast(id, data.operand, data-layout, pointer-layout)
    pending += arithmetic
        - id
        - .arithmetic-multiply
        - num-cast(id, size.operand, size-layout, u64-layout)
        - stride
        - u64-layout
call-runtime(.runtime-array-views-replace, id, mark, void-layout)

────────────────────
_ do copy-items
    - id SyntaxId
    - layout LayoutId
    - target Operand
    - target-stride Operand
    - source Operand
    - source-stride Operand
    - length Operand

` Copies items one by one from where one view's lie to where another's lie.
. counting = open-pass(id, length)
. place = counting.index
. reading-cell = moved-bytes
    - id
    - source
    - arithmetic(id, .arithmetic-multiply, place, source-stride, u64-layout)
. writing-cell = moved-bytes
    - id
    - target
    - arithmetic(id, .arithmetic-multiply, place, target-stride, u64-layout)
if tables.layouts.is-struct(layout)
    copy(writing-cell, reading-cell, layout, false, id)
else
    store(writing-cell, 0, load(reading-cell, 0, layout, id), false, id)
close-pass(id, counting)


────────────────────
_ do open-pass CountingPass
    - site SyntaxId
    - size Operand

` Begins a loop that counts its passes from 0 while the count, a U64, is below `size`, and
` starts its first pass. `close-pass` ends a pass and the loop.
. counter = ir.add-local(u64-layout)
store-local(counter, integer(.machine-u64, 0), site)
. testing = ir.reserve-block()
. passing = ir.reserve-block()
. done = ir.reserve-block()
jump(testing)
ir.start-block(testing)
branch(compare(site, .compare-less, load-local(counter, site), size), passing, done)
ir.start-block(passing)
= CountingPass(counter, testing, done, load-local(counter, site))

────────────────────
_ do close-pass
    - site SyntaxId
    - counting CountingPass

` Ends a pass of a loop `open-pass` began, counting it, and goes on after the loop.
store-local
    - counting.counter
    - arithmetic(site, .arithmetic-add, counting.index, integer(.machine-u64, 1), u64-layout)
    - site
jump(counting.testing)
ir.start-block(counting.done)
────────────────────
_ do emit-pointer-add Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId

` A pointer moved on by a count of the items it points at. The answer has the pointer's type.
` A count narrower than the pointer is widened by its own sign.
. nothing = make-operand(.operand-void, 0)
. base = emit-expression(lhs)
. type = base.type
. layout = layout-of(type, id)
. count = emit-expression(rhs)
. counted = layout-of(count.type, rhs)
if !is-pointer(layout) || !is-integer(counted) || type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. step = integer(.machine-u64, tables.layouts.pointee-size(type))
. widest = if is-signed(counted) then i64-layout else u64-layout
. wide = num-cast(id, num-cast(id, count.operand, counted, widest), widest, u64-layout)
. distance = arithmetic(id, .arithmetic-multiply, wide, step, u64-layout)
. moved = arithmetic
    - id
    - .arithmetic-add
    - num-cast(id, base.operand, layout, u64-layout)
    - distance
    - u64-layout
= Typed(num-cast(id, moved, u64-layout, layout), type)

────────────────────
_ do emit-unary Typed
    - id SyntaxId
    - op Operator
    - operand SyntaxId

` A prefix operator, in the way the type pass planned it: the function it recorded, or the
` machine operation on a number. `!` of an optional is true when it holds no value.
` `type-of` gives the type of its operand as a value: of an object the class it was
` constructed as, read from its table, of a value of an interface the type of what it
` holds, read from its witness table, and of anything else the type it is held as.
. nothing = make-operand(.operand-void, 0)
. plan = facts.plan-of(unit.reading, id)
if op == .type-of-op
    . subject = emit-expression(operand)
    . held = subject.type
    if held == no-type || held == invalid-type || !tables.is-class(held)
        if held != no-type && held != invalid-type && intrinsic(held) == .interface
            . second = tables.layouts.field(tables.layouts.interface-layout, 1).offset
            . witness = load(subject.operand, second, pointer-layout, id)
            = Typed(load(witness, 0, pointer-layout, id), facts.node-type(unit.reading, id))
        = type-value(id, facts.node-type(unit.reading, id))
    . table = load(subject.operand, 0, pointer-layout, id)
    = Typed(load(table, table-slot-size, pointer-layout, id), facts.node-type(unit.reading, id))
if op == .optional-force-op
    = emit-force(id, operand)
if op == .delete-op
    = emit-delete(id, operand)
if plan == .plan-call
    = emit-operator-call(id, operand, 0)
if plan != .plan-builtin
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if op == .not-op
    . tested = emit-expression(operand)
    if tested.type != no-type && tested.type != invalid-type && types.is-optional(tested.type)
        tested = present(operand, tested)
    = compare-zero(operand, tested, .compare-equal)
if op != .negative-op && op != .bitwise-not-op
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. type = facts.node-type(unit.reading, id)
. given = convert(operand, .reason-operand, emit-expression(operand))
. layout = layout-of(type, id)
. fits = if op == .bitwise-not-op then is-integer(layout) else is-number(layout)
if given.type != type || !fits
    refuse(.refused-conversion, operand)
    = Typed(nothing, no-type)
. start U32 = ir.operands.length
ir.add-operand(given.operand)
. row = if op == .bitwise-not-op then IROp.op-bitwise-not else IROp.op-negate
= Typed(make-operand(.operand-value, append(row, id, Span(start, 1), 0, layout)), given.type)

────────────────────
_ do emit-builtin Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId
    - assigns Bool = false

` The machine operation on two numbers. Each operand takes the conversions recorded at it,
` the right one also the conversion by a unit's ratio that the operator records as its own,
` and both arrive in one type. A conversion recorded for the result then gives it the node's
` type, but for an assigning operator, whose result the assignment converts as it stores it.
. left = emit-expression(lhs)
= combine-builtin(id, op, lhs, left.operand, left.type, rhs, assigns)

────────────────────
_ do combine-builtin Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - given Operand
    - given-type TypeId
    - rhs SyntaxId
    - assigns Bool

` The machine operation on two numbers, the left already evaluated as `lhs` gives it.
. nothing = make-operand(.operand-void, 0)
. left = convert(lhs, .reason-operand, Typed(given, given-type))
left = convert(lhs, .reason-promotion, left)
. machine = left.type
. right = convert(rhs, .reason-operand, emit-expression(rhs))
right = convert(id, .reason-operator, right)
right = convert(rhs, .reason-promotion, right)
if right.type != machine
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. layout = layout-of(machine, id)
. result = Typed(nothing, no-type)
if is-comparison(op)
    if !is-number(layout)
        refuse(.refused-type, id)
        = Typed(nothing, no-type)
    result = Typed(compare(id, predicate-of(op), left.operand, right.operand), types.bool-type)
else
    result = convert(id, .reason-result, Typed(operate(id, op, left.operand, right.operand, layout), right.type))
if !assigns && result.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
= result

────────────────────
_ do operate Operand
    - id SyntaxId
    - op Operator
    - left Operand
    - right Operand
    - layout LayoutId

` One row of arithmetic or of a bitwise operator on two numbers of a layout, with no check of
` any kind. The remainder of two floats is a call the collector never sees.
. nothing = make-operand(.operand-void, 0)
. bitwise = bitwise-of(op)
. arithmetic = arithmetic-of(op)
if bitwise != U32.max && is-integer(layout)
    . start U32 = ir.operands.length
    ir.add-operand(left)
    ir.add-operand(right)
    = make-operand(.operand-value, append(.op-bitwise, id, Span(start, 2), bitwise, layout))
if arithmetic == U32.max || !is-number(layout)
    refuse(.refused-type, id)
    = nothing
if op == .mod-op && is-float(layout)
    . remainder = RuntimeFunction.runtime-float-remainder
    if layout == f32-layout
        remainder = .runtime-float32-remainder
    . mark = pending.length
    pending += left
    pending += right
    = call-runtime(remainder, id, mark, layout)
. start U32 = ir.operands.length
ir.add-operand(left)
ir.add-operand(right)
= make-operand(.operand-value, append(.op-arithmetic, id, Span(start, 2), arithmetic, layout))

────────────────────
_ do emit-sign-checked Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId
    - is-left Bool

` A comparison of a signed integer with an unsigned one at least as wide. The signed side is
` tested first. When it is negative the answer is known, and otherwise both are compared in
` the unsigned type the type pass converted them to.
. nothing = make-operand(.operand-void, 0)
. left-given = emit-expression(lhs)
. left-type = left-given.type
. left = convert(lhs, .reason-operand, left-given)
. common = left.type
. right-given = emit-expression(rhs)
. right-type = right-given.type
. right = convert(rhs, .reason-operand, right-given)
if right.type != common || !is-comparison(op)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. signed-layout = layout-of(if is-left then left-type else right-type, id)
. layout = layout-of(common, id)
if !is-integer(signed-layout) || !is-integer(layout)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. origin = integer(tables.layouts.kind-of(signed-layout), 0)
. negative = compare(id, .compare-less, (if is-left then left-given else right-given).operand, origin)
. compared = ir.reserve-block()
. joined = ir.reserve-block()
. tested = ir.current
branch(negative, joined, compared)
ir.start-block(compared)
. answer = compare(id, predicate-of(op), left.operand, right.operand)
. compared-end = ir.current
jump(joined)
ir.start-block(joined)
. known = integer(.machine-u8, known-answer(op, is-left))
= Typed(phi(u8-layout, known, tested, answer, compared-end), types.bool-type)

────────────────────
_ do emit-logic Typed
    - id SyntaxId
    - is-and Bool
    - lhs SyntaxId
    - rhs SyntaxId

` `&&` and `||` on two values tested as conditions. The right one is evaluated only when the
` left one does not decide the answer. A left one that holds the middle of a chain of
` orderings opens its slot to the right one. Where the type pass found that the left one
` always decides it, the left one is evaluated and the answer is the one it decides.
. nothing = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, id) == .plan-never
    emit-expression(lhs)
    = Typed(integer(.machine-u8, if is-and then 0u64 else 1u64), types.bool-type)
. left = test(id, emit-expression(lhs), true)
. held = held-by(lhs)
. further = ir.reserve-block()
. joined = ir.reserve-block()
. decided = ir.current
if is-and
    branch(left.operand, further, joined)
else
    branch(left.operand, joined, further)
ir.start-block(further)
. own-unit = unit
if held != no-place
    unit = unit.open-held = held
. right = test(id, emit-expression(rhs), true, true)
unit = own-unit
. further-end = ir.current
jump(joined)
ir.start-block(joined)
. short = integer(.machine-u8, if is-and then 0u64 else 1u64)
= Typed(phi(u8-layout, short, decided, right.operand, further-end), types.bool-type)

────────────────────
_ do branch-on ?! Refused
    - condition SyntaxId
    - when-true IRBlockId
    - when-false IRBlockId
    - site SyntaxId = 0
    - is-right Bool = false

` Goes on to one block where a condition tests as true and to the other where it does not. Each
` side of `&&` and `||` branches in turn, as `emit-logic` evaluates them, so the answer is not
` made as a value. The condition is tested as itself, or with `site` as that `&&` or `||`
` tests its left side, or with `is-right` its right one. The predicate an `if` tests is seen
` through where it holds `&&` or `||` and tests it as itself.
match? tree.nodes[condition]
    | .node-type-predicate(row)
        . logic = tree.is-logic(row.expr) || logic-lazy(row.expr, 0, false) != no-slot
        if site == 0 && !row.is-contextual && logic && passes-through(condition, row.expr)
            branch-on(row.expr, when-true, when-false)
            =
    | .node-identifier
        . slot = logic-lazy(condition, site, is-right)
        if slot != no-slot
            lazy-open += slot
            branch-on(tree.lazy-value(bindings.slots[slot].group), when-true, when-false)
            lazy-open.pop()
            =
    | .node-binary-expression(row)
        if (row.op == .and-op || row.op == .or-op) && branches-apart(condition, site, is-right)
            . further = ir.reserve-block()
            if row.op == .and-op
                branch-on(row.lhs, further, when-false, condition)
            else
                branch-on(row.lhs, when-true, further, condition)
            . held = held-by(row.lhs)
            ir.start-block(further)
            . own-unit = unit
            if held != no-place
                unit = unit.open-held = held
            branch-on(row.rhs, when-true, when-false, condition, true)
            unit = own-unit
            =
. tested = if site == 0 then test(condition, emit-expression(condition)) else test(site, emit-expression(condition), true, is-right)
branch(tested.operand, when-true, when-false)

────────────────────
_ passes-through Bool
    - predicate SyntaxId
    - expr SyntaxId

` Whether the predicate of an `if` is its expression as it is: the type pass recorded no test,
` conversion or other type for it.
|? !facts.node-slot(unit.reading, predicate) || !is-consumable(predicate) || truth-tested
    false
|? pins.length != 0 && pin-of(predicate)
    false
??
    facts.answer-type(unit.reading, predicate) == facts.answer-type(unit.reading, expr)

.. truth-tested = truth-call(predicate, false, false) != no-fact

────────────────────
_ branches-apart Bool
    - id SyntaxId
    - site SyntaxId
    - is-right Bool

` Whether an `&&` or `||` can branch on each side: the type pass left its answer to be found
` as it runs, nothing pinned it, and its answer is tested as the Bool it is.
|? facts.plan-of(unit.reading, id) == .plan-never || !facts.node-slot(unit.reading, id) || !is-consumable(id)
    false
|? pins.length != 0 && pin-of(id)
    false
??
    fact == no-fact

.. fact = if site == 0 then truth-call(id, false, false) else truth-call(site, true, is-right)

────────────────────
_ do emit-delete Typed
    - id SyntaxId
    - operand SyntaxId

` `-=` of an item: the function that answers `-=[]` is called on the object with the key, the
` object evaluated first and then the key, as TypeScript does, each with the conversion
` recorded for it. The value is what the function answers, or the object where it answers
` nothing. Where the type pass planned the answer to be stored, it is stored where the object
` was read from, which then only names storage.
. nothing = make-operand(.operand-void, 0)
. object SyntaxId = 0
. index SyntaxId = 0
match? tree.nodes[operand]
    | .node-index-expression(row)
        if !chains-at(operand, row.is-optional)
            object = row.object
            index = row.index
. fact = if object != 0 then own-call(operand) else no-fact
if fact == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. call = facts.calls[fact]
. callee = call.callee
if callee == no-instance || call.is-partial || !is-callable(callee)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if !fills-in-order(call, callee, 1) || names-slot(object, .slot-super)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. owner = instances.rows[callee].self-type
. answers = instances.signatures[callee].returns
. stores-back = facts.plan-of(unit.reading, operand) == .plan-store-answer
. placed = answers == owner && is-place(object) && facts.node-type(unit.reading, object) == owner
if owner == no-type || (stores-back && !placed)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. pin-mark = pins.length
if stores-back
    pin-holder(object)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = receiver
. key-type = no-type
key = convert(index, .reason-argument, emit-expression(index))
key-type = key.type
if receiver-type != owner
    refuse(.refused-conversion, object)
if key-type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, index)
. answer = nothing
. mark = pending.length
pending += receiver.operand
pending += key.operand
answer = call-method(callee, operand, mark).operand
if stores-back && facts.is-replacing(unit.reading, operand)
    . old = emit-expression(object)
    replace-storage(operand, old.operand, old.type, answer, answers)
if stores-back
    store-place(object, answer, owner, operand)
unpin(pin-mark)
. result = if answers == types.void-type then receiver else Typed(answer, answers)
if result.type != facts.node-type(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= result

────────────────────
_ do emit-operator-call Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - plan OperatorPlan = OperatorPlan.plan-call
    - assigns Bool = false

` An operator that functions answer: the calls the type pass recorded at the node, each made
` on the operand it chose as receiver with the other as its argument. A prefix operator has
` no other. The operands are evaluated once. One call answers by itself, or negated by its
` opposite. Two answer together, both always asked: that neither holds, or that the first
` does not or the second does. The answer has the node's type. A struct or a tuple on the left
` is a copy of what its place held before the right is evaluated, but where the operator
` `assigns` to that place: there the function is given the place itself.
. nothing = make-operand(.operand-void, 0)
. pair = plan == .plan-neither-call || plan == .plan-not-or-call
. fact = answering(facts.first-call(unit.reading, id))
. second = no-fact
if fact != no-fact
    second = answering(facts.calls[fact].next)
if fact == no-fact || (second != no-fact) != pair
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. given = emit-expression(lhs)
. left = apart(given, lhs, !assigns && rhs != 0 && !is-inert(rhs))
. left-type = given.type
. right = nothing
. right-type = no-type
if rhs != 0
    . emitted = emit-expression(rhs)
    right = emitted.operand
    right-type = emitted.type
. answer = call-operator(id, fact, lhs, left, left-type, rhs, right, right-type)
if plan != .plan-call && answer.type != types.bool-type
    refuse(.refused-expression, id)
if plan != .plan-call
    answer = compare-zero(id, answer, .compare-equal)
if pair
    . equal = call-operator(id, second, lhs, left, left-type, rhs, right, right-type)
    if equal.type != types.bool-type
        refuse(.refused-expression, id)
    if plan == .plan-neither-call
        . combined = bitwise
            - id
            - .bitwise-and
            - answer.operand
            - compare-zero(id, equal, .compare-equal).operand
            - u8-layout
        answer = Typed(combined, types.bool-type)
    else
        answer = Typed(bitwise(id, .bitwise-or, answer.operand, equal.operand, u8-layout), equal.type)
if answer.type != facts.node-type(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= answer

────────────────────
_ do answering FactId
    - fact FactId

` The first call from one on that answers for a node's value: the calls that test a value as
` a condition are passed over.
. found = fact
while found != no-fact
    if answers-node(facts.calls[found].form)
        = found
    found = facts.calls[found].next
= no-fact

────────────────────
_ do call-operator Typed
    - id SyntaxId
    - fact FactId
    - lhs SyntaxId
    - left Operand
    - left-type TypeId
    - rhs SyntaxId
    - right Operand
    - right-type TypeId

` One call recorded for an operator, on operands already evaluated: the receiver is the left
` one, or the right one when the type pass exchanged them, and the other is the argument, in
` the type the function takes by the conversions recorded at it. An object of a class below
` the one that declares the function is given as it is. A function that raises answers with
` its value or an error, which leaves the function where the type pass says the call's errors
` do, as any call's.
. nothing = make-operand(.operand-void, 0)
. row = facts.calls[fact]
. callee = row.callee
if callee == no-instance || row.is-partial || !is-callable(callee)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if instances.signatures[callee].args.count != (if rhs == 0 then 0 else 1) || swapped-unary
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. swapped-unary = row.is-swapped && rhs == 0
. receiver = if row.is-swapped then right else left
. receiver-type = if row.is-swapped then right-type else left-type
if row.through.count != 0
    . reached = read-through(id, Typed(receiver, receiver-type), row.through)
    receiver = reached.operand
    receiver-type = reached.type
. self = instances.rows[callee].self-type
if receiver-type != self && !(tables.is-class(receiver-type) && descends(receiver-type, self))
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. mark = pending.length
pending += receiver
if rhs != 0
    . site = if row.is-swapped then lhs else rhs
    . argument = convert(site, .reason-argument, if row.is-swapped then Typed(left, left-type) else Typed(right, right-type))
    if argument.type != instances.argument-type(callee, 0)
        refuse(.refused-conversion, site)
    pending += argument.operand
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-method(callee, id, mark)
takes-result = false
if raising && row.propagates
    answer = propagate(id, callee, answer.operand)
= answer

────────────────────
_ do settled SharedArm
    - arm SyntaxId
    - start U32
    - result Operand
    - result-type TypeId

. kept = start
. carried = result
. carried-type = result-type
. end = match-steps.length as U32
for position in start .. < end
    . step = match-steps[position]
    if tree.nodes[step.pattern] is .node-type-wildcard
        if step.carries
            carried = step.subject
            carried-type = step.type
        continue
    match-steps[kept] = step
    kept += 1
while match-steps.length > kept
    match-steps.pop()
= SharedArm(arm, start, kept - start, carried, carried-type)

────────────────────
_ next-call FactId
    - fact FactId

if fact != no-fact then facts.calls[fact].next else no-fact

────────────────────
_ may-grow Bool
    - stream-type TypeId

` Whether a stream of a type may give more input as a pattern reads it: any but an
` `ArrayTokenStream` or an `IndexableTokenStream`, whose buffer holds all of it.
!same-decl(ref, types.array-token-stream-decl) && !same-decl(ref, types.indexable-token-stream-decl)

.. ref = class-ref(types, stream-type)

────────────────────
_ do parameter-default SyntaxId
    - callee InstanceId
    - position U32

` The default a parameter of a function is written with, or none.
. row = instances.rows[callee]
match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if position < fn.args.count
            = program.modules[row.module].arg-pool[fn.args.start + position].default-syntax
= 0

────────────────────
_ do emit-arm Bool ?! Refused
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - from Operand
    - whole Bool
    - end LocalId
    - joined IRBlockId
    - slot Operand
    - failed IRBlockId
    - entered LocalId = no-local
    - unread Bool = false

` One arm of a grammar, tried from a cursor. An arm with no pattern reads nothing and
` always passes. An arm that runs an expression binds `it` to the text its pattern matched, or
` to what a rule its pattern calls gave, where the expression reads it, or to the span of what
` it matched where the type pass kept `it` as one, and `location` to where
` its pattern began and ended, or with no pattern to where it is tried; one that only matches
` gives that text or that value. An action the reference runs in a function of its own, where
` a call may panic, has no shape here. One the type pass found asks for a rollback mark asks
` for it before its expression runs. Where it passes, the arms hold the rollback mark they held
` before it, where `entered` kept one. Where functions the expression makes read `it` or a
` name the pattern captures, its value is kept in the environment too, as the arm begins
` (`keep-arm-captures`). Where the input must be read whole, an arm whose pattern leaves some
` unread fails as its pattern does. Whether the arm reaches the join.
match? tree.nodes[id]
    | .node-stream-panic
        emit-stream-raise(run, id, failed)
        = false
    | .node-stream-transform(row)
        if row.pattern != 0 && tree.lazies-only(row.right)
            = emit-bare-arm
                - run
                - id
                - result
                - from
                - whole
                - end
                - joined
                - slot
                - failed
                - entered
                - unread
        . finish = from
        . given = make-operand(.operand-void, 0)
        . given-type = no-type
        if row.pattern != 0
            . part = lowered-part(row.pattern)
            . missed = observed-failure(part, from, observed-failure(id, from, failed))
            . reached = emit-stream-node(run, part, from, missed)
            finish = reached.ending
            given = reached.value.operand
            given-type = reached.value.type
            if whole
                stream-whole(run, id, finish, missed)
        if facts.is-marking-arm(unit.reading, id)
            ensure-mark(id)
        . named = bound.length
        . it-slot = arm-slot-of(id, .slot-it)
        . located = location-fact(id)
        . first = facts.first-call(unit.reading, id)
        . spans-it = facts.spanning-it(unit.reading, id)
        if spans-it != no-type
            . span = source-span(run, id, from, finish, spans-it)
            if it-slot == no-slot
                refuse(.refused-expression, id)
            bind-it(it-slot, span.operand, spans-it, id)
        else if row.pattern != 0 && gives-value(row.pattern)
            if given-type == no-type
                refuse(.refused-expression, id)
                = false
            if it-slot != no-slot
                bind-it(it-slot, given, given-type, id)
        else if (first != no-fact && first != located) || material-at(id, .material-text) != U32.max
            . text = stream-text(run, id, from, finish)
            . text-type = text.type
            if it-slot == no-slot
                refuse(.refused-expression, id)
            bind-it(it-slot, text.operand, text-type, id)
        if located != no-fact
            bind-location(run, id, located, from, finish, row.pattern != 0)
        bind-materials(run, id)
        if row.pattern != 0
            keep-arm-captures(row.pattern)
        . outlined = facts.plan-of(unit.reading, id) == .plan-outlined-panic
        . remade = material-at(id, .material-result)
        if outlined && remade != U32.max
            refuse(.refused-expression, id)
        . value = if outlined then action-call(id, result) else arm-value(id, row.right, result, false, no-type, remade)
        drop-bound(named)
        if facts.is-spanning-arm(unit.reading, id)
            value = source-span(run, id, from, finish, result)
        pass-marks(entered, id)
        store-local(end, finish, id)
        arrive(id, value.operand, joined, slot)
        = true
= emit-bare-arm(run, id, result, from, whole, end, joined, slot, failed, entered, unread)

────────────────────
_ do stream-call StreamPart ?! Refused
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` A call of a local rule, run where it is called, as the reference runs one: its arms are
` tried in turn from the cursor, as the arms of a match are but with no need to read the
` whole input, and the first that passes gives the call what it gave and where it ended.
` Where none passes, the call fails. The names the rule captures have their places while its
` arms are emitted. It keeps the farthest cursor a part of it failed at from the cursor it is
` called at, as the reference's call of it does, and the pattern then counts that as its own.
` A rule a module declares is called, but for one `inlined-rule` finds, which runs where it is
` called as `inline-rule-call` says; so is a function given the stream that is no rule,
` as `boundary-call` says, and a local rule the tables made a function of; one whose body is
` code runs it as `coded-call` says; one beside a match that calls itself runs where it is
` called, and a call of it from its own arms is as `adapter-call` says;
` one that calls itself and has none is refused. A call given collectors gives no value: one
` that runs the rule where it is called runs it with the lists the caller keeps for its names
` in place of the rule's own, cut back to what they held where the rule fails, and one of a
` function calls the function made for those collectors. Nor does one the type pass planned to
` give the text it matched. One run where it is called begins holding no rollback mark, as
` `enter-marks` says, and gives back the one it holds where it fails. Under a helper that
` observes literal words, it tells it of them only where `observes-literals` says its pattern
` holds any.
. pattern = rule-pattern(id)
. result = facts.node-type(unit.reading, id)
if result == no-type || result == invalid-type
    refuse(.refused-expression, id)
    = bare-part(cursor)
if facts.plan-of(unit.reading, id) == .plan-pattern-call
    = pattern-call(run, id, id, cursor, failed)
. mappings = RowRange'SyntaxId()
match? tree.nodes[id]
    | .node-stream-call(row)
        mappings = row.collector-mappings
. mapped = mappings.count != 0
. spanned = facts.plan-of(unit.reading, id) == .plan-span-call
. coded = coded-rule(id)
if coded != 0
    if mapped || spanned
        refuse(.refused-expression, id)
        = bare-part(cursor)
    = coded-call(run, id, coded, result, cursor, failed)
if pattern == 0 && !mapped && next-call(facts.first-call(unit.reading, id)) != no-fact
    = boundary-call(run, id, result, cursor, failed)
if pattern == 0 && !mapped
    . inlined = inlined-rule(run, id, result, spanned)
    if inlined.pattern != 0
        = inline-rule-call(run, id, inlined, cursor, failed, spanned)
if pattern == 0
    = rule-call(run, id, result, cursor, failed, mappings, spanned)
. declaration = rule-declaration(id)
. adapter = tables.rule-adapter-of(unit.reading, declaration)
if adapter != no-function && inlining.find(declaration) != null
    if mapped || spanned
        refuse(.refused-expression, id)
        = bare-part(cursor)
    = adapter-call(run, id, adapter, declaration, result, cursor, failed)
. helper = if adapter == no-function then tables.lazy-rule-of(unit.reading, declaration) else no-function
if helper != no-function && mapped
    . variant = tables.mapped-rule-of(unit.reading, declaration, tables.mapping-names(tree, mappings))
    if variant == no-function
        refuse(.refused-expression, id)
        = bare-part(cursor)
    = lazy-rule-call(run, id, variant, facts.node-type(unit.reading, pattern), cursor, failed, mappings)
if helper != no-function
    = lazy-rule-call(run, id, helper, result, cursor, failed, mappings, spanned)
if facts.is-recursive-rule(unit.reading, declaration) && adapter == no-function
    refuse(.refused-expression, id)
    = bare-part(cursor)
if mapped || spanned
    result = facts.node-type(unit.reading, pattern)
. layout = layout-of(result, id)
. end = ir.add-local(run.index-layout)
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. held = bound.length
. captured = stream-captures.length
. outer = load-local(run.error, id)
store-local(run.error, cursor, id)
. missed = ir.reserve-block()
. marks = borrow-levels(id, mappings)
. entered = enter-marks(id)
. own-streaming = streaming
streaming = streaming.capture-floor = captured as U32
hold-captures(run, pattern)
streaming = own-streaming
borrows.clear()
plan-choices(pattern)
inlining += declaration
if !observes-literals(tree, facts, unit.reading, pattern)
    streaming = streaming.observer-row = U32.max
. arrives = emit-stream-arms(run, pattern, result, cursor, false, end, joined, slot, missed, mapped || spanned)
streaming = own-streaming
stop-inlining(declaration)
drop-bound(held)
drop-captures(captured)
if !arrives
    drop-joins(mark)
    refuse(.refused-expression, id)
    = bare-part(cursor)
ir.start-block(missed)
rewind-levels(marks, id)
fail-marks(entered, id)
record-error(run, id, outer)
jump(failed)
. value = close-joins(joined, mark, layout, slot)
pass-marks(entered, id)
record-error(run, id, outer)
. ending = load-local(end, id)
if mapped || spanned
    = StreamPart(ending, spanned-value(run, id, spanned, cursor, ending))
= StreamPart(ending, Typed(value, result))

────────────────────
_ do stop-inlining
    - rule SyntaxId

` Ends the running of a local rule where it is called, as the reference ends it: the rule is
` no longer one being run, however many runs of it this one is inside.
. kept = 0
for position in 0 .. < inlining.length
    if inlining[position] != rule
        inlining[kept] = inlining[position]
        kept += 1
while inlining.length != kept
    inlining.pop()

────────────────────
_ do open-marks
    - body SyntaxId

` Gives a body of a grammar that the type pass found holds a rollback mark the local
` that holds it, which holds none as the body begins. A body that holds none has no such local,
` nor has one whose marks no arm of the program asks a helper for: it would never hold one.
` What emits a body inside another sets the other's aside.
. row = facts.rollback-body-of(unit.reading, body)
streaming = streaming.rollback-row = row
streaming = streaming.rollback-mark = no-local
if row == U32.max || !facts.asks-mark(facts.rollback-bodies[row].held)
    =
. layout = layout-of(facts.rollback-bodies[row].kept, body)
streaming = streaming.rollback-mark = ir.add-local(layout)
store-local(streaming.rollback-mark, no-mark(body).operand, body)

────────────────────
_ do rewind-mark
    - site SyntaxId

` Gives the helper back the rollback mark the part being emitted holds, where it holds one, which
` undoes what the actions since it was asked for did.
if streaming.rollback-mark == no-local
    =
. row = facts.rollback-bodies[streaming.rollback-row]
. held = ir.reserve-block()
. done = ir.reserve-block()
. mark = load-local(streaming.rollback-mark, site)
branch(holds-mark(mark, site), held, done)
ir.start-block(held)
. given = mark
if row.kept != row.held
    given = payload(site, Typed(mark, row.kept)).operand
call-protocol(site, row.rewind, streaming.pattern-helper, streaming.pattern-helper-type, given, row.held)
jump(done)
ir.start-block(done)

────────────────────
_ helper-marks Bool
    - helper TypeId

` Whether the functions of patterns given to a rule under a helper give the rollback mark they
` hold: where the helper can roll back, and some arm of the program asks a helper for a mark
` of its type.
helper != no-type && held != no-type && facts.asks-mark(held)

.. held = helper-mark-type(types, helper)

────────────────────
_ carries Bool
    - rule InstanceId

` Whether a rule's function gives the rollback mark its pattern holds as it passes: where the
` type pass found the pattern holds one, and some arm of the program asks a helper for a mark
` of that type.
|? !instances.rows[rule].carries-mark
    false
??
    body == U32.max || facts.asks-mark(facts.rollback-bodies[body].held)

.. body = facts.rollback-body-of
    - rule
    - rule-match(program, instances.rows[rule].module, instances.rows[rule].decl)

────────────────────
_ do give-mark
    - site SyntaxId

` Keeps the rollback mark a rule's pattern holds as it passed where its caller said to.
. layout = ir.locals[streaming.rollback-mark].layout
if tables.layouts.is-struct(layout)
    copy(streaming.marked-argument, load-local(streaming.rollback-mark, site), layout, false, site)
else
    store(streaming.marked-argument, 0, load-local(streaming.rollback-mark, site), false, site)

────────────────────
_ do read-layout LayoutId
    - run StreamRun
    - id SyntaxId

` The layout of an item a part of a pattern reads as a value: a character where the buffer is
` UTF-8, and else the buffer's item.
= if encodes(run) then layout-of(types.type-row(.char), id) else run.item-layout

────────────────────
_ do shifted Operand
    - id SyntaxId
    - value Operand
    - shift U64
    - layout LayoutId

= bitwise(id, .bitwise-shift-left, value, integer(tables.layouts.rows[layout].kind, shift), layout)

────────────────────
_ do arm-slot-of SlotId
    - arm SyntaxId
    - kind SlotKind

` The slot of a kind, `it` or `location`, that an arm of a match or a pattern that is a
` condition declares, or none.
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    = no-slot
. slots = bindings.bindings[binding].slots
for offset in 0 .. < slots.count
    . slot = slots.start + offset
    . row = bindings.slots[slot]
    if row.kind == kind && row.syntax == arm
        = slot
= no-slot

────────────────────
_ do drop-bound
    - mark Size

while bound.length > mark
    bound.pop()

────────────────────
_ do is-bound Bool
    - slot SlotId

for row in bound
    if row.slot == slot
        = true
= false

────────────────────
_ do read-bound Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` What a name a pattern bound holds where it is read: the value captured, or for `it` what
` the pattern was given or passed. Where the type pass narrowed the name, the read is of
` what it holds, as a local's is.
. nothing = make-operand(.operand-void, 0)
. position = bound.length
while position != 0
    position -= 1
    . row = bound[position]
    if row.slot != slot
        continue
    if row.capture != U32.max
        = read-capture(id, row.capture, type)
    if row.cursor != U32.max
        = gather-cursor(id, row.cursor, type)
    if row.type == type
        = Typed(row.value, type)
    if shared-depth != 0
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    if facts.plan-of(unit.reading, id) == .plan-case-read
        = read-case(id, row.value, row.type, type)
    if holds(row.type, type)
        = payload(id, Typed(row.value, row.type))
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do bind-name
    - name SyntaxId
    - value Typed

` Gives a name a pattern declares the value it captured. The name holds that value and no
` cell, since nothing assigns it, or, where nested functions capture it, the place the
` environment that holds it has for it. One the program tracks has no shape here. A pattern
` that only tests binds nothing. The name of a pattern a declaration
` is written with is a local: it gets its cell here, and the value is stored there, or in
` the environment of a function that yields, which keeps its locals from step to step.
if matching.testing
    =
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    refuse(.refused-expression, name)
    =
. resolution = bindings.resolution-of(binding, name)
if resolution.kind != .resolve-slot
    refuse(.refused-expression, name)
    =
. row = bindings.slots[resolution.slot]
. unkept = SlotFlag.slot-captured /or/ SlotFlag.slot-tracked
if matching.declaring
    . type = value.type
    . place = slot-offset(resolution.slot, name)
    . layout = layout-of(type, name)
    . item = row.kind == .slot-loop-item
    if (row.kind != .slot-local && !item) || (!item && (row.flags /and/ unkept) != 0)
        refuse(.refused-statement, name)
        =
    if facts.slot-type(unit.instance, place) != type
        refuse(.refused-conversion, name)
        =
    if is-captured(resolution.slot)
        keep-captured(resolution.slot, value.operand, type, name)
    else if layout != void-layout
        unit.cells[place] = ir.add-local(layout, (row.flags /and/ SlotFlag.slot-address-taken) != 0)
        store-local(unit.cells[place], value.operand, name)
    =
if row.kind != .slot-pattern
    refuse(.refused-expression, name)
    =
. offset = slot-offset(resolution.slot, name)
if facts.slot-type(unit.instance, offset) != value.type
    refuse(.refused-conversion, name)
    =
if is-captured(resolution.slot)
    keep-captured(resolution.slot, value.operand, value.type, name)
    =
bound += BoundValue(resolution.slot, value.type, value.operand)

────────────────────
_ do member-machine MachineFact?
    - module ModuleId
    - value SyntaxId

` The state machine a property of a class holds, by the property's value, or none.
for machine in facts.machines
    if machine.store == .store-member && machine.module == module && machine.syntax == value
        = machine
= null

────────────────────
_ do call-at FactId
    - site SyntaxId
    - form CallForm

` The first call of a form that the type pass recorded at a node, or none.
. fact = facts.first-call(unit.reading, site)
while fact != no-fact && facts.calls[fact].form != form
    fact = facts.calls[fact].next
= fact

────────────────────
_ do close-joins Operand
    - joined IRBlockId
    - mark Size
    - layout LayoutId
    - slot Operand

` Starts the block the sides of a join arrive in, and gives the value they left: one of them
` by the block each ended in, or for a struct the memory each copied its own into.
ir.start-block(joined)
if operand-kind(slot) != .operand-void
    drop-joins(mark)
    = slot
. start U32 = ir.operands.length
for position in mark .. < joins.length
    ir.add-operand(joins[position])
drop-joins(mark)
. count U32 = ir.operands.length - start
= make-operand(.operand-value, append(.op-phi, 0, Span(start, count), 0, layout))

────────────────────
_ do join-slot Operand
    - layout LayoutId

` Where the sides of a join leave a struct: memory in the frame that each copies its value
` into. Any other value needs none, and is joined by the block each side ends in.
if tables.layouts.is-struct(layout)
    = frame(layout)
= make-operand(.operand-void, 0)

────────────────────
_ do arrive
    - site SyntaxId
    - value Operand
    - joined IRBlockId
    - slot Operand

` Leaves the value of one side for its join, and goes there.
if operand-kind(slot) != .operand-void
    copy(slot, value, ir.operand-layout(slot), false, site)
else
    joins += value
    joins += make-operand(.operand-block, ir.current)
jump(joined)

────────────────────
_ do emit-choice Typed
    - id SyntaxId
    - chosen SyntaxId
    - condition SyntaxId
    - other SyntaxId

` `if condition then chosen else other`: the condition is tested, and only the side it picks is
` evaluated. Each side arrives in the type of the whole by the conversion recorded for a side
` of its type.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. tested = test(id, emit-expression(condition), true, false)
. taken = ir.reserve-block()
. passed = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
branch(tested.operand, taken, passed)
ir.start-block(taken)
emit-arm(id, chosen, type, joined, slot)
ir.start-block(passed)
emit-arm(id, other, type, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), type)

────────────────────
_ do emit-choice Typed
    - control SyntaxId
    - name Atom

. nothing = Typed(make-operand(.operand-void, 0), no-type)
. fact = facts.slot-choice-of(unit.reading, tree.chosen-line(control, name))
if !fact
    refuse(.refused-expression, control)
    = nothing
. arms = tree.region-arms(control)
. index-kind = layout-of(types.index-type, control) as MachineKind
. anchor = tree.selector-anchor(control)
. selector = convert(anchor, .reason-markup-slot, emit-closure(anchor, fact.selector))
. mark = pending.length
pending += selector.operand
pending += integer(index-kind, arms.length as U64)
. choice = call-instance(fact.create, control, mark)
. held = ir.add-local(managed-layout)
store-local(held, choice.operand, control)
for position in 0 .. < arms.length
    match? tree.nodes[tree.region-arm-body(arms[position])]
        | .node-block(block)
            for line in tree.children[block.body]
                match? tree.nodes[line]
                    | .node-markup(row)
                        if tree.identifier-name(row.slot-binding) == name
                            . built = builder-value(line)
                            . filling = pending.length
                            pending += load-local(held, control)
                            pending += integer(index-kind, position as U64)
                            pending += built.operand
                            do call-instance(fact.fill, line, filling)
= Typed(load-local(held, control), fact.choice)

────────────────────
_ do emit-arm ?! Refused
    - site SyntaxId
    - body SyntaxId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - guards Bool = false

` The value of one arm, converted as the match records for a side of its type, left for the
` match with the block the arm ends in. With `guards` an error is a value where the type of the
` match holds it, and has no shape where that type carries errors. With no type the arm is run
` for what it does.
if type == no-type
    emit-block(body)
    jump(joined)
    =
. value = arm-value(site, body, type, guards, type, U32.max, operand-kind(slot) != .operand-void)
arrive(site, value.operand, joined, slot)

────────────────────
_ do ending SyntaxId
    - body SyntaxId

` The expression a body ends in, which gives the body its value, once the statements a block
` holds before it have run in order. None where a block holds no statement.
clear-turn-lazies(body)
raise-elements(body)
. last = body
match? tree.nodes[body]
    | .node-block(block)
        last = 0
        for statement in tree.children[block.body]
            if !runs-in-body(statement) || is-lazy-local(statement)
                continue
            if last != 0
                emit-statement(last)
            last = statement
= last

────────────────────
_ do emit-block-value Typed
    - id SyntaxId
    - type TypeId

` A block written as a value: the assertions under it run, then its expression gives the
` value. It is a block of its own: the cleanups opened while its value is evaluated run where
` it ends, after a struct is copied out of what they may change.
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
clear-turn-lazies(id)
raise-elements(id)
. only = checked-expression(id)
if only == 0
    refuse(.refused-expression, id)
. emitted = emit-expression(only)
if type != no-type && emitted.type != type
    refuse(.refused-conversion, id)
= close-value(emitted, mark, own-scoping, id)

────────────────────
_ do close-value Typed
    - value Typed
    - mark Size
    - outer Scoping
    - id SyntaxId

` Ends a block written as a value, which began with the cleanups up to `mark` open, in a block
` whose cleanups begin where `outer` says. The cleanups it opened run here, after a struct is copied
` out of what they may change.
. kept = value
. given = kept.type
if open-cleanups.length != mark
    if given != no-type && given != types.void-type
        . layout = layout-of(given, id)
        if tables.layouts.is-struct(layout)
            kept = Typed(snapshot(value.operand, layout, id), kept.type)
    close-cleanups(mark)
scoping = outer
= kept

────────────────────
_ do emit-leading SyntaxId
    - body SyntaxId

` Runs in order the statements of a block written as a value but its last, and gives the
` last, whose value is the block's. A lazy local, which emits nothing where it is declared, is
` none of them. None where the block runs no statement.
. last SyntaxId = 0
match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if !runs-in-body(statement) || is-lazy-local(statement)
                continue
            if last != 0
                emit-statement(last)
            last = statement
= last

────────────────────
_ do only-expression SyntaxId
    - body SyntaxId

` The expression a body stands for: itself, or the one statement of a block that holds
` nothing else but lazy locals, which emit nothing where they are declared. A block of more
` has none.
match? tree.nodes[body]
    | .node-block(block)
        . found SyntaxId = 0
        for statement in tree.children[block.body]
            if is-lazy-local(statement)
                continue
            if found != 0
                = 0
            found = statement
        = found
= body

────────────────────
_ do checked-expression SyntaxId
    - body SyntaxId

` The expression a block gives its value by, once the assertions and the declarations written
` under it have run, which they do here in their order: the last statement of a block that
` holds nothing else but those and lazy locals, which emit nothing where they are declared. A
` block of anything else has none.
. last SyntaxId = 0
match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if is-lazy-local(statement)
                continue
            if last != 0
                if !tree.is-assertion(last) && !(tree.nodes[last] is .node-declare)
                    = 0
                emit-statement(last)
            last = statement
= if last == 0 || tree.is-assertion(last) || tree.nodes[last] is .node-declare then 0 else last

────────────────────
_ do declares-getter Bool
    - left SyntaxId

` Whether a declaration declares a local of a row of a markup loop region that is read as a
` getter: its value is made where it is read.
. binding = instances.rows[unit.reading].binding
if binding == no-binding
    = false
match? tree.nodes[left]
    | .node-type-capture(capture)
        . resolution = bindings.resolution-of(binding, capture.id)
        = resolution.kind == .resolve-slot && bindings.slots[resolution.slot].getter != 0
= false

────────────────────
_ do emit-getter Typed
    - id SyntaxId

` A read of a local of a row of a markup loop region read as a getter: the value its
` declaration writes, made here.
. resolution = bindings.resolution-of(instances.rows[unit.reading].binding, id)
match? tree.nodes[bindings.slots[resolution.slot].getter]
    | .node-declare(row)
        = emit-expression(row.right)
refuse(.refused-expression, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do join Typed
    - site SyntaxId
    - value Typed

` One side of a join in the type of the join: the conversion recorded at the join that
` starts at the side's type. Sides of one type convert alike, so the first such is taken. A
` lambda becomes its function first, and the conversions after that one take the function on.
. fact = facts.first-conversion(unit.reading, site)
. result = value
. found = false
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-join && row.from == result.type
        . lambda = intrinsic(result.type) == .closure
        result = convert-one(site, row, result)
        found = true
        if !lambda
            = result
    fact = row.next
if !found
    refuse(.refused-conversion, site)
= result

────────────────────
_ do drop-joins
    - mark Size

while joins.length > mark
    joins.pop()

────────────────────
_ do emit-concat Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - interpolated Bool

` Joins two values as text: the function the type pass chose for the left one's type, called
` with the right one. An interpolation makes its left piece text before it evaluates the
` right one. `++` evaluates both first.
. left = emit-expression(lhs)
= join-text(id, lhs, left.operand, left.type, rhs, interpolated)

────────────────────
_ do join-text Typed
    - id SyntaxId
    - lhs SyntaxId
    - given Operand
    - given-type TypeId
    - rhs SyntaxId
    - interpolated Bool

` Joins text to a left value already evaluated as `lhs` gives it.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
if fact == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. callee = facts.calls[fact].callee
. first = if interpolated then convert(id, .reason-operator, Typed(given, given-type)) else Typed(apart(Typed(given, given-type), lhs, disturbed), given-type)
    .. disturbed = !is-inert(rhs)
. left = first.operand
. left-type = first.type
. right = emit-expression(rhs)
. right-type = right.type
if !interpolated
    . converted = convert(id, .reason-operator, Typed(left, left-type))
    left = converted.operand
    left-type = converted.type
if callee == no-instance || left-type != instances.rows[callee].self-type
    refuse(.refused-conversion, lhs)
    = Typed(nothing, no-type)
right = convert(rhs, .reason-argument, Typed(right.operand, right-type))
if right.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, rhs)
    = Typed(nothing, no-type)
. mark = pending.length
pending += left
pending += right.operand
= call-method(callee, id, mark)

────────────────────
_ do emit-coalesce Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId

` The left value is kept unless it tests as empty, and then the right one is taken: a number
` is empty when it is zero, a C pointer when it points at nothing, and any other value when
` the function recorded as its test says so. The sides join as `close-joins` says, a struct in
` memory each copies its own into.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. test = truth-call(id, true, false)
. left = emit-expression(lhs)
if types.is-optional(left.type)
    = emit-fallback(id, left, rhs, type)
if left.type == types.null-type
    . right = emit-expression(rhs)
    if right.type != type
        right = join(id, right)
    if right.type != type
        refuse(.refused-conversion, rhs)
    = right
. layout = layout-of(type, id)
. held = left.type
. held-layout = layout-of(held, id)
. counts = test == no-fact && is-number(layout) && (held == type || is-number(held-layout))
. points = test == no-fact && held != type && is-pointer(held-layout) && c-pointer
    .. c-pointer = intrinsic(held) == .cpointer
if !counts && !points && (test == no-fact || held != type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. take-right = ir.reserve-block()
. keep-left = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. sides = joins.length
if counts || points
    branch(truth(lhs, Typed(left.operand, held)).operand, keep-left, take-right)
else
    . callee = facts.calls[test].callee
    if callee == no-instance || instances.rows[callee].self-type != type
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . mark = pending.length
    pending += left.operand
    . is-empty = call-method(callee, id, mark)
    branch(is-empty.operand, take-right, keep-left)
ir.start-block(keep-left)
. kept = left
if held != type
    kept = join(id, Typed(left.operand, held))
    if kept.type != type
        refuse(.refused-conversion, lhs)
arrive(id, kept.operand, joined, slot)
ir.start-block(take-right)
. right = emit-expression(rhs)
if right.type != type
    right = join(id, right)
if right.type != type
    refuse(.refused-conversion, rhs)
arrive(id, right.operand, joined, slot)
= Typed(close-joins(joined, sides, layout, slot), right.type)

────────────────────
_ do emit-fallback Typed
    - id SyntaxId
    - left Typed
    - rhs SyntaxId
    - type TypeId

` `a ?? b` where `a` is an optional: what it holds when it holds a value, and otherwise `b`,
` which is evaluated only then. Where `b` may hold nothing too, `a` is kept as the optional
` it is. Each side arrives in the type of the whole, by the conversion recorded for a side.
. nothing = make-operand(.operand-void, 0)
. held = left.type
. layout = layout-of(type, id)
. tested = present(id, left)
. keep = ir.reserve-block()
. other = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
branch(tested.operand, keep, other)
ir.start-block(keep)
. kept = left
if held != type
    kept = payload(id, Typed(left.operand, held))
    if kept.type != type
        kept = join(id, kept)
if kept.type != type
    refuse(.refused-conversion, id)
arrive(id, kept.operand, joined, slot)
ir.start-block(other)
emit-arm(id, rhs, type, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), type)

────────────────────
_ do convert-matched Typed
    - site SyntaxId
    - reason ConversionReason
    - value Typed
    - wanted TypeId

` Applies the conversions recorded at a site for one reason that take a value of the type
` this one has, in order, until it has the type wanted. A site that keeps the conversions
` of several values is read so.
. result = value
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact && result.type != wanted
    . row = facts.conversions[fact]
    . fits = row.reason == reason || literal-return
        .. literal-return = reason == .reason-return && row.reason == .reason-literal-return
    if fits && row.from == result.type
        result = convert-one(site, row, result)
    fact = row.next
= result

────────────────────
_ do emit-relation Typed
    - id SyntaxId
    - plan OperatorPlan
    - object SyntaxId
    - operands RowRange'SyntaxId

` A call the compiler answers itself, of the relation of two types:
` - `compare` of a type with another gives the relation. It is held as the text the type
`   pass recorded for it, which is all that can be asked of one when the program runs. The
`   two types are run first, as a type read for a constant is.
` - `cast` and `unify` of a relation give their argument, converted as the type pass
`   recorded at it. The relation is run first, for what its types do. A panic the
`   conversion raises is raised at the call.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
if plan == .plan-relation
    . constant = facts.constant-of(unit.reading, id)
    if constant == no-fact || !facts.constants[constant].text
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    run-type-operand(object)
    for operand in tree.children[operands]
        run-type-operand(tree.argument-value(operand))
    = Typed(make-operand(.operand-constant, ir.add-string(facts.constants[constant].text!.text)), type)
if operands.count != 1 || facts.plan-of(unit.reading, object) != .plan-relation
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
emit-expression(object)
. given = tree.children[operands.start]
. raw = convert(given, .reason-argument, emit-expression(tree.argument-value(given)))
. value = convert(given, .reason-relation, raw, id)
if value.type != type
    refuse(.refused-conversion, id)
= value

────────────────────
_ do emit-get Typed
    - id SyntaxId
    - object SyntaxId
    - name Atom

` A name read from a value: a constant the type pass worked out, the address a pointer
` holds, a stored field the type pass named by its place, what the getter it recorded at the
` node answers, a field of a tuple or struct, or a stored property of an object. A union
` answers some names by itself, and others with the member each of its cases has. A field
` of the case of a row a name stands for is read from its cell, and a field of numbers of an
` item of an array an index reads as TypeScript reads one, which has no shape in a link of an
` optional chain. An event named on a value is made a `Broadcastable`. The flag of a domain a
` `MarkupBatchFlush` reports is its bit of the domains the flush left pending. `path` of a
` value of a state machine's union lists its active cases (`emit-machine-path`), and `unit` of
` a number is the name its type is written with, read after the number is.
if facts.plan-of(unit.reading, id) == .plan-machine-path
    = emit-machine-path(id, object)
. escaped = escaped-event(id)
if escaped
    = emit-escape(id, escaped)
. flag = facts.style-flag-of(unit.reading, id)
if flag && flag.call == no-instance
    = flush-flag(id, object, tables.domain-number(flag.domain))
if object != 0 && case-cursor-of(object) != U32.max
    . cursor = case-cursor-of(object)
    . field = case-field(cursor, name)
    if field
        = emit-case-field(id, cursor, field)
if plans-array-item && types.intrinsic-of(facts.node-type(unit.reading, object)) == .struct
    if is-link(id)
        refuse(.refused-expression, id)
        = Typed(make-operand(.operand-void, 0), no-type)
    match? tree.nodes[object]
        | .node-index-expression(row)
            = emit-array-item(object, row.object, row.index, id, name)
.. plans-array-item = object != 0 && facts.plan-of(unit.reading, object) == .plan-array-item
. planned = facts.plan-of(unit.reading, id)
if planned == .plan-view
    = emit-view-get(id, object)
if planned == .plan-table && table-op(id) == TableOp.table-field
    = emit-table-field(id, object)
if planned == .plan-table
    . held = emit-expression(object)
    . type = held.type
    = table-get(id, held.operand, type)
if planned == .plan-none && is-binding(facts.node-type(unit.reading, id))
    = name-binding(id, facts.node-type(unit.reading, id), object)
if planned == .plan-case-number
    = emit-case-number(id, object)
if planned == .plan-case-name || planned == .plan-case-type
    = emit-case-text(id, object, planned)
if planned == .plan-case-value
    = emit-case-value(id, object)
if planned == .plan-forward
    = emit-forward(id, object, RowRange'SyntaxId(), name)
if planned == .plan-unit-name
    . held = emit-expression(object)
    = Typed(unit-text(held.type), facts.node-type(unit.reading, id))
if planned == .plan-object-uid || planned == .plan-property-subscribers
    = emit-object-member(id, object, planned)
if facts.plan-of(unit.reading, id) == .plan-constant
    run-type-operand(object)
    = Typed(emit-constant(id), facts.node-type(unit.reading, id))
if facts.plan-of(unit.reading, id) == .plan-case
    run-type-operand(object)
    = emit-case(id, RowRange'SyntaxId(), false)
if facts.plan-of(unit.reading, id) == .plan-enum-value
    run-type-operand(object)
    = read-enum(id)
if facts.plan-of(unit.reading, id) == .plan-address
    . pointer = emit-expression(object)
    = cast(id, pointer, unlinked(id))
if facts.plan-of(unit.reading, id) == .plan-reinterpret
    = reinterpret(id, emit-expression(object), unlinked(id))
if facts.plan-of(unit.reading, id) == .plan-field
    . held = emit-object(object)
    = placed-field(id, held.operand, held.type, facts.constant-of(unit.reading, id))
if planned == .plan-through
    . whole = emit-expression(object)
    . held = read-through(id, Typed(whole.operand, held-type(object)), facts.through-of(unit.reading, id))
    = load-property(id, held.operand, held.type, name)
. fact = own-call(id)
if fact != no-fact && facts.calls[fact].form == .call-getter
    = emit-fact-call(id, facts.calls[fact], object, RowRange'SyntaxId())
. owner = held-type(object)
if owner != no-type && owner != invalid-type && intrinsic(owner) == .type-info
    = emit-type-get(id, object)
if owner != no-type && owner != invalid-type && property-owner
    . base = emit-object(object)
    = load-property(id, base.operand, owner, name)
.. property-owner = is-aggregate(owner) || tables.is-class(owner) || types.is-optional(owner)
refuse(.refused-expression, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do emit-object Typed
    - object SyntaxId

` The value a name is read from at once, before anything else is evaluated: a struct an index
` names past a pointer is read from where it lies, not copied.
. own-matching = matching
matching = matching.read-in-place = object
. value = emit-expression(object)
matching = own-matching
= value

────────────────────
_ do flush-flag Typed
    - id SyntaxId
    - object SyntaxId
    - domain U32

. held = emit-expression(object)
. owner = held.type
. mask = load-property(id, held.operand, owner, program.store-atom("pending-domain-mask"), true)
. layout = layout-of(mask.type, id)
. bit = bitwise(id, .bitwise-and, mask.operand, integer(.machine-u32, 1u64 /lshift/ domain), layout)
. set = compare-zero(id, Typed(bit, types.type-row(.uint32)), .compare-not-equal)
= Typed(set.operand, types.bool-type)

────────────────────
_ do emit-object-member Typed
    - id SyntaxId
    - object SyntaxId
    - plan OperatorPlan

` A member every object has: the `uid` its header holds, or the list of the subscribers of its
` properties, made and published in lane 0 where it has none yet.
. held = emit-expression(object)
. owner = held.type
if plan == .plan-property-subscribers
    if instances.live.subscribers == no-instance
        refuse(.refused-expression, id)
        = held
    = side-list(id, held.operand, 0, instances.live.subscribers)
if !tables.is-class(owner) || tables.layouts.objects[owner] == no-layout
    refuse(.refused-expression, id)
    = held
= Typed(load(held.operand, tables.layouts.field(tables.layouts.objects[owner], 1).offset, u32-layout, id), facts.node-type(unit.reading, id))

────────────────────
_ do emit-type-get Typed
    - id SyntaxId
    - object SyntaxId

` What a type given as a value answers that the type pass worked out no constant for, as it
` planned the node: the name or the key of the class an object was constructed as, read from
` the value, the base of the type, which is the base of the type the value is held as, the
` size of the type, which is the bytes its layout holds a value in, the name or the key of
` the type the value is held as, or the name inlining knows of the type of a value of an
` interface, which the inliner settles from the type's descriptor and the interface's name.
. nothing = make-operand(.operand-void, 0)
. plan = facts.plan-of(unit.reading, id)
if plan == .plan-type-base
    run-type-operand(object)
    = type-value(id, facts.node-type(unit.reading, id))
if plan == .plan-type-name || plan == .plan-type-key
    run-type-operand(object)
    = type-text(id, named-type(facts.node-type(unit.reading, object)), plan)
if plan == .plan-type-size
    run-type-operand(object)
    . counted = facts.node-type(unit.reading, id)
    . held = layout-of(named-type(facts.node-type(unit.reading, object)), id)
    . counts = layout-of(counted, id)
    if !is-integer(counts)
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    = Typed(integer(tables.layouts.kind-of(counts), tables.layouts.rows[held].size), counted)
if plan == .plan-inlined-name
    . descriptor = emit-expression(object)
    . fallback = type-text(id, named-type(facts.node-type(unit.reading, object)), .plan-type-name)
    . start U32 = ir.operands.length
    ir.add-operand(descriptor.operand)
    ir.add-operand(fallback.operand)
    = Typed(make-operand(.operand-value, append(.op-inlined-name, id, Span(start, 2), 0, managed-layout)), fallback.type)
if plan == .plan-type-properties
    = type-properties(id, object)
if plan != .plan-concrete-name && plan != .plan-concrete-key
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. subject = emit-expression(object)
= Typed(load(subject.operand, if plan == .plan-concrete-name then 0 else table-slot-size, managed-layout, id), types.string-type)

────────────────────
_ do type-properties Typed
    - id SyntaxId
    - object SyntaxId

. nothing = make-operand(.operand-void, 0)
. listed = facts.node-type(unit.reading, id)
. layout = layout-of(listed, id)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 1
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. subject = emit-expression(object)
. field = tables.layouts.field(layout, 0)
. table = load(subject.operand, 2 * table-slot-size, field.layout, id)
. memory = frame(layout)
put(memory, field, table, id)
= Typed(memory, listed)

────────────────────
_ do type-value Typed
    - id SyntaxId
    - info TypeId

` A type as a value: the address of the constant that holds the type's name and its key.
` `info` is the type the type pass gave the node, which says what type the value is.
. named = named-type(info)
. symbol = if named != no-type && named != invalid-type then rtti-symbol else no-string
    .. rtti-symbol = tables.rtti-symbols[named]
if symbol == no-string
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
type-values += named
= Typed(make-operand(.operand-symbol, symbol), info)

────────────────────
_ do type-text Typed
    - id SyntaxId
    - named TypeId
    - plan OperatorPlan

` The name or the key of a type, as the text the constant of the type holds.
if named == no-type || named == invalid-type
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. text = if plan == .plan-type-name then type-runtime-name(types, named) else runtime-key
    .. runtime-key = type-runtime-key(types, named)
= Typed(make-operand(.operand-constant, ir.add-string(text)), types.string-type)

────────────────────
_ do named-type TypeId
    - info TypeId

` The type that a type given as a value is, which the type of the value says.
if info != no-type && info != invalid-type && intrinsic(info) == .type-info
    match? types.rows[info]
        | .type-class(row)
            if row.args.count == 1
                = types.child-type(row.args, 0)
= no-type

────────────────────
_ do emit-index Typed
    - id SyntaxId
    - object SyntaxId

` A field read by a constant index, which the type pass recorded.
. nothing = make-operand(.operand-void, 0)
. place = indexed-field(id)
if place == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. base = emit-expression(object)
= placed-field(id, base.operand, base.type, place)

────────────────────
_ do emit-array-item Typed
    - id SyntaxId
    - object SyntaxId
    - index SyntaxId
    - reader SyntaxId = 0
    - name Atom? = null

` An item of an array of numbers read by an index, or the field `name` of numbers that the node
` `reader` reads of an item of an array of structs, as TypeScript reads one: where the index is
` less than the array's size, from where the array's storage holds the item, and anywhere else
` from what the function recorded at the index gives, which answers for an index the array
` does not hold. The array is evaluated before the index, and each takes the conversion
` recorded for it.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
if fact == no-fact || (reader != 0 && !name)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = convert(index, .reason-argument, emit-expression(index))
. key-type = key.type
= array-item(id, facts.calls[fact].callee, receiver.operand, receiver-type, key.operand, key-type, reader, name)

────────────────────
_ do array-item Typed
    - id SyntaxId
    - callee InstanceId
    - receiver Operand
    - receiver-type TypeId
    - key Operand
    - key-type TypeId
    - reader SyntaxId = 0
    - name Atom? = null

` An item of an array an index reads as TypeScript reads it, once the array and the index are
` evaluated: from the array's storage where the index is less than its size, and anywhere else
` from what `callee` answers for them.
. nothing = make-operand(.operand-void, 0)
if receiver-type != instances.rows[callee].self-type || key-differs
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
.. key-differs = key-type != instances.argument-type(callee, 0)
. item = instances.signatures[callee].returns
. layout = layout-of(receiver-type, id)
. key-layout = layout-of(key-type, id)
. item-layout = layout-of(item, id)
. data = part(receiver, layout, 0, id)
. data-layout = layout-of(data.type, id)
. proven = facts.constant-of(unit.reading, id) != no-fact
. size = if proven then Typed(integer(.machine-u64, 0), types.size-type) else part(receiver, layout, 1, id)
. size-layout = if proven then u64-layout else layout-of(size.type, id)
. structured = tables.layouts.is-struct(item-layout)
if !is-pointer(data-layout) || !is-integer(size-layout) || !is-integer(key-layout) || wrong-reader
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
.. wrong-reader = structured != (reader != 0)
. wide = num-cast(id, key, key-layout, u64-layout)
. inside = ir.reserve-block()
. outside = ir.reserve-block()
. joined = ir.reserve-block()
if proven
    jump(inside)
else
    branch
        - compare(id, .compare-less, wide, num-cast(id, size.operand, size-layout, u64-layout))
        - inside
        - outside
ir.start-block(inside)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. cell = moved-bytes
    - id
    - num-cast(id, data.operand, data-layout, pointer-layout)
    - arithmetic(id, .arithmetic-multiply, wide, stride, u64-layout)
. held = nothing
. read = item
if structured
    . propertyed = load-property(reader, address(cell, 0, item-layout, id), item, name!)
    held = propertyed.operand
    read = propertyed.type
else
    held = load(cell, 0, item-layout, id)
if proven
    if !gives(if structured then reader else id, read)
        refuse(.refused-conversion, id)
        = Typed(nothing, no-type)
    = Typed(held, read)
. from-inside = ir.current
jump(joined)
ir.start-block(outside)
. mark = pending.length
pending += receiver
pending += key
. answer = call-method(callee, id, mark)
if structured
    answer = load-property(reader, answer.operand, item, name!)
if answer.type != read
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. from-outside = ir.current
jump(joined)
ir.start-block(joined)
. read-layout = layout-of(read, id)
if !gives(if structured then reader else id, read)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
= Typed(phi(read-layout, held, from-inside, answer.operand, from-outside), read)

────────────────────
_ do fills-in-order Bool
    - fact CallFact
    - callee InstanceId
    - count U32

` Whether a call gives its callee exactly `count` arguments, each parameter the one written
` in its place.
if instances.signatures[callee].args.count != count || fact.fills.count != count
    = false
for position in 0 .. < count
    if facts.call-fills[fact.fills.start + position] as U32 != position
        = false
= true

────────────────────
_ do pin-holder
    - place SyntaxId

` Evaluates, once, the object a place is a property or a field of, and keeps its value for
` every later reading of that object: what is stored in the place after other code has run
` goes where the place was read from, though that code may have changed what the object's
` expression names.
match? tree.nodes[place]
    | .node-get-expression(row)
        if row.object == 0 || is-pinned(row.object)
            =
        . held = emit-expression(row.object)
        pin(row.object, held.operand, held.type)

────────────────────
_ do emit-list Typed
    - id SyntaxId
    - written RowRange'SyntaxId

` A list written, made as TypeScript makes one: the items are evaluated in the order they are
` written, a struct among several copied, since what follows may change the storage it was
` read from, and the list is made of them.
. nothing = make-operand(.operand-void, 0)
. list-type = facts.node-type(unit.reading, id)
. count U32 = written.count
. start = given.length
for item in tree.children[written]
    . made = emit-expression(item)
    given += Typed(apart(made, item, count > 1), made.type)
. list = nothing
list = build-list(id, written, list-type, start, true).operand
drop-given(start)
= Typed(list, list-type)

────────────────────
_ do build-list Typed
    - id SyntaxId
    - written RowRange'SyntaxId
    - list-type TypeId
    - start Size
    - converts Bool
    - chain SyntaxId = 0
    - room U32 = 0

` A list of the items written at `written`, which `given` holds from `start` on, made with the
` functions the type pass recorded at the node:
` 1. The empty list is made, and room for the items is reserved in it.
` 2. Each item takes the conversion recorded for it, where it `converts`.
` 3. Each is stored where the array the list keeps its items in holds them, and the list's
`    size is set.
. nothing = make-operand(.operand-void, 0)
. makes = no-fact
. reserves = no-instance
. reads = no-instance
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    . row = facts.calls[fact]
    if row.form == .call-list-make
        makes = fact
    else if row.form == .call-list-reserve
        reserves = row.callee
    else if row.form == .call-list-data
        reads = row.callee
    fact = row.next
. count U32 = written.count
. kept = property-of(list-type, types.items-atom!)
. sized = property-of(list-type, types.size-atom!)
if makes == no-fact || reserves == no-instance || reads == no-instance || !kept || !sized
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.instance-functions[reserves] == no-function || no-reads-function
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. no-reads-function = tables.instance-functions[reads] == no-function
. list = emit-fact-call(id, facts.calls[makes], 0, RowRange'SyntaxId(), 0, 0, list-type)
if list.type != list-type
    refuse(.refused-conversion, id)
if count != 0 || room != 0
    fill-list(id, written, list.operand, list-type, start, reserves, reads, kept, converts, chain, room)
if count != 0
    . field = held-field(id, list-type, sized)
    if is-integer(field.layout)
        store(list.operand, field.offset, integer(field.layout as MachineKind, count), false, id)
    else
        refuse(.refused-expression, id)
= Typed(list.operand, list-type)

────────────────────
_ do fill-list
    - id SyntaxId
    - written RowRange'SyntaxId
    - list Operand
    - list-type TypeId
    - start Size
    - reserves InstanceId
    - reads InstanceId
    - kept Index
    - converts Bool
    - chain SyntaxId = 0
    - room U32 = 0

` Reserves room in a list just made for the items evaluated, which `given` holds from
` `start` on, converts each where it `converts`, and stores them where the list's array holds
` its items.
. count U32 = written.count
. counted = layout-of(types.size-type, id)
. takes-size = instances.signatures[reserves].args.count == 1 && is-integer(counted)
if !takes-size || instances.argument-type(reserves, 0) != types.size-type
    refuse(.refused-expression, id)
    =
if instances.rows[reserves].self-type != list-type
    refuse(.refused-conversion, id)
    =
. mark = pending.length
pending += list
pending += integer(counted as MachineKind, count + room)
call-method(reserves, id, mark)
for position in 0 .. < count
    if !converts
        break
    . item = tree.item-site(written, chain, position)
    . converted = convert(item, .reason-element, given[start + position])
    given[start + position] = converted
. array = held-field(id, list-type, kept)
if !tables.layouts.is-struct(array.layout) || array.type != instances.rows[reads].self-type
    refuse(.refused-expression, id)
    =
. reading-mark = pending.length
pending += address(list, array.offset, array.layout, id)
. data = call-method(reads, id, reading-mark)
. pointer = layout-of(data.type, id)
. item-type = tables.layouts.pointee-type(data.type)
if !is-pointer(pointer) || item-type == no-type
    refuse(.refused-expression, id)
    =
. layout = layout-of(item-type, id)
. size = tables.layouts.rows[layout].size
for position in 0 .. < count
    . item = tree.item-site(written, chain, position)
    if given[start + position].type != item-type
        refuse(.refused-conversion, item)
        =
    . value = given[start + position].operand
    if tables.layouts.is-struct(layout)
        store-struct(data.operand, LayoutField(position * size, layout), value, item)
    else if layout != void-layout
        store(data.operand, position * size, value, is-managed-pointer(layout), item)

────────────────────
_ do store-held
    - base Operand
    - object SyntaxId
    - owner TypeId
    - place Index
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores a value in a property an object stores, or in a field of a struct that lies where
` `object` names, which is the receiver when it is no syntax. A managed pointer written
` into an object goes through the write barrier. A struct that an object holds has no shape
` for a store that writes a managed pointer into it.
. field = held-field(site, owner, place)
if field.type != type
    refuse(.refused-statement, site)
    =
. in-object = tables.is-class(owner)
. managed = field.layout != void-layout && tables.layouts.rows[field.layout].is-managed
if !in-object && managed && !is-framed(object)
    refuse(.refused-statement, site)
    =
if tables.layouts.is-struct(field.layout)
    if in-object
        store-struct(base, field, value, site)
    else
        put(base, field, value, site)
else if field.layout != void-layout
    store(base, field.offset, value, in-object && is-managed-pointer(field.layout), site)

────────────────────
_ do placed-field Typed
    - id SyntaxId
    - base Operand
    - owner TypeId
    - place FactId

` The stored field of a tuple or struct that a constant of the type pass names by its place.
` The read has the field's own type, which is the node's.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(owner, id)
. position = facts.constants[place].bits as U32
if !tables.layouts.is-struct(layout) || position >= tables.layouts.rows[layout].fields.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. type = field-type(owner, position)
if !gives(id, type)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
= Typed(take(base, tables.layouts.field(layout, position), id), type)

────────────────────
_ indexed-field FactId
    - id SyntaxId

` The constant that says which stored field an index names, or none. The node of an index
` assigned with an operator keeps the constant under the operator's own plan.
if plan != .plan-field && plan != .plan-builtin then no-fact else facts.constant-of(unit.reading, id)

.. plan = facts.plan-of(unit.reading, id)

────────────────────
_ do emit-header Operand
    - id SyntaxId
    - expr SyntaxId
    - items RowRange'SyntaxId

` A header gives each item below it to the `with` of what the one before gave. The calls are
` those the type pass recorded at the header, in order: the first on the value written, each
` after on the answer of the one before, held as the header's own value. Only the last answers
` with the header's type. A call that leaves out a parameter or has a variadic tail has no
` shape where there are several, since what it records for them is kept at the header.
if items.count == 0
    = emit-expression(expr).operand
. nothing = make-operand(.operand-void, 0)
. fact = facts.first-call(unit.reading, id)
. value = nothing
. object = expr
. mark = pins.length
for position in 0 .. < items.count
    if fact == no-fact
        refuse(.refused-expression, id)
    . row = facts.calls[fact]
    if items.count > 1 && (row.fills.count != 1 || facts.call-fills[row.fills.start] as U32 != 0)
        refuse(.refused-expression, id)
        break
    . answers = if position + 1 == items.count then no-type else callee-returns
        .. callee-returns = instances.signatures[row.callee].returns
    . called = emit-fact-call
        - id
        - row
        - object
        - RowRange'SyntaxId(items.start + position, 1)
        - 0
        - 0
        - answers
    value = called.operand
    unpin(mark)
    pin(id, value, called.type)
    object = id
    fact = next-call(fact)
unpin(mark)
= value

────────────────────
_ do emit-tuple Typed
    - id SyntaxId
    - items RowRange'SyntaxId

` A tuple written: memory in the frame, with each item stored to its field in turn. An item
` is copied where it is stored, so nothing a later item does changes it.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != items.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. made = frame(layout)
for position in 0 .. < items.count
    . item = tree.children[items.start + position]
    match? tree.nodes[item]
        | .node-argument(named)
            item = named.expr
    . value = emit-expression(item)
    if value.type != field-type(type, position)
        refuse(.refused-conversion, item)
        = Typed(nothing, no-type)
    put(made, tables.layouts.field(layout, position), value.operand, item)
= Typed(made, type)

────────────────────
_ do run-type-operand
    - id SyntaxId

` What is run before a constant is read from a type or a value: `type-of` runs its operand, a
` name runs nothing, and any other expression is evaluated for what it does.
match? tree.nodes[id]
    | .node-unary-expression(row) { row.op == .type-of-op }
        emit-expression(row.operand)
        =
    | .node-identifier
        =
    | .node-type-identifier
        =
    | .node-core-type-identifier
        =
    | .node-type-arguments
        =
    | .node-type-associated
        =
    | .node-type-optional
        =
    | .node-type-numeric
        =
emit-expression(id)

────────────────────
_ do emit-constant Operand
    - id SyntaxId

` A constant the type pass worked out: the number or the text its fact holds, as a value of
` the node's type.
. nothing = make-operand(.operand-void, 0)
. fact = facts.constant-of(unit.reading, id)
. type = facts.node-type(unit.reading, id)
if fact == no-fact
    refuse(.refused-expression, id)
    = nothing
. row = facts.constants[fact]
if row.text
    if type != types.string-type
        refuse(.refused-type, id)
        = nothing
    = make-operand(.operand-constant, ir.add-string(row.text!.text))
. layout = layout-of(type, id)
if row.is-float && is-float(layout)
    = float-number(layout, row.float)
if !row.is-float && is-integer(layout)
    = integer(tables.layouts.kind-of(layout), row.bits)
refuse(.refused-type, id)
= nothing

────────────────────
_ do slot-held-type TypeId
    - site SyntaxId
    - slot SlotId

` The type a local, a lazy local, an argument, the item of a loop or a name a pattern binds
` holds where a site names it, as its function gives it or the environment that holds it; none
` for any other.
. kind = bindings.slots[slot].kind
. named = local-or-argument || kind == .slot-loop-item || kind == .slot-pattern
    .. local-or-argument = kind == .slot-local || kind == .slot-argument
if !named && kind != .slot-lazy
    = no-type
if is-captured(slot)
    = find-captured(slot, site).type
if !owns(slot)
    = no-type
if kind == .slot-argument
    = instances.argument-type(unit.instance, argument-position(slot))
= facts.slot-type(unit.instance, slot - unit.slot-start)

────────────────────
_ do emit-closure Typed
    - id SyntaxId
    - given TypeId = no-type

` A nested function written as a value: the environment in force where it is written,
` which its body reads the locals it captures from. That is the function's own
` environment, or else the one the function was given, or nothing where it has neither.
` One written in the body of a constructor whose properties read a captured lazy local, or
` made a nested function, has no shape where the constructor declares such a local: see
` `read-shared`. Nor has one made while a constructor gives the properties their values,
` where a nested function reads the receiver: TypeScript gives it a copy of what each
` property was given, which a later change of the property does not reach. One that is the
` value of a lazy local nested functions capture, made by a function written in the one that
` declares the local, as `read-shared` evaluates it there, is the environment that holds
` the local, which is the one in force where it is written; any other made by a function it
` is not written in has no shape, but where the one it is written in keeps no environment, as
` the value of a property is: it is given none. One written in a line of a root `<This` is given
` the environment made for the line (`hold-unit`). One the type pass made of no written function
` is `given` its type.
. type = if given != no-type then given else facts.node-type(unit.reading, id)
. outside = unit.reading != unit.instance
. held = outside && unit.reading == filling.held-unit
. bare = outside && !held && tables.environments[unit.reading] == no-layout
. shared = if outside && !bare && !held then shared-written(id) else no-slot
if unsharable || !is-closure(type) || (!filling.storing && fills-share() && shares-lazy())
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
.. unsharable = outside && !bare && !held && shared == no-slot
if filling.storing && !held && shares-receiver()
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if shared != no-slot
    find-captured(shared, id)
    . held = captured-base(id)
    = Typed(held, type)
. written = if bare then integer(.machine-managed-pointer, 0) else if held then load-local(filling.held-environment, id) else written-environment(id)
match? types.rows[type]
    | .type-closure(row)
        hold-stacks(id, row.decl, written)
. given = kept-cells(id, type, written)
= Typed(given, type)

────────────────────
_ do hold-stacks
    - id SyntaxId
    - decl DeclId
    - written Operand

` Where a lambda or a comprehension is made, the function writes into its own environment the
` state of each global `do with` binds that it holds, which one made again in the same run
` writes over, as TypeScript keeps it. One made in a loop whose turn has an environment,
` where TypeScript keeps the state, has no shape for it.
if !tables.holds-stacks(unit.instance)
    =
for position in 0 .. < tables.place-owners.length
    if tables.place-owners[position] == unit.instance && tables.place-decls[position] == decl
        . held = tables.environments[unit.instance]
        if open-turns.length != 0 || unit.environment == no-local || unbuilt-held
            refuse(.refused-expression, id)
            =
        .. unbuilt-held = held == no-layout || held == unbuilt-environment
        . field = tables.layouts.field(held, tables.place-children[position])
        capture-stack(written, field, tables.place-rows[position], id)

────────────────────
_ do is-closure-body Bool

` Whether the function emitted is the body of a lambda or a comprehension, or the steps of one
` that yields.
if unit.instance == no-instance || (function.kind != .instance-body && function.kind != .generator-body)
    = false
. row = instances.rows[unit.instance]
match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.kind == .iterator-decl
            match? program.modules[row.module].tree.nodes[fn.syntax]
                | .node-iterator-expression
                    = true
        = fn.kind == .closure-decl
= false

────────────────────
_ fills-share Bool

` Whether the function is a constructor whose properties, as it gives them their first values,
` read a lazy local nested functions capture or make a nested function, as the type pass
` found.
unit.instance != no-instance && instances.rows[unit.instance].fills-share

────────────────────
_ is-closure Bool
    - type TypeId

type != no-type && type != invalid-type && intrinsic(type) == .closure

────────────────────
_ do shares-receiver Bool

` Whether nested functions capture the receiver of the function.
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    if bindings.slots[slot].kind == .slot-this && is-captured(slot)
        = true
= false

────────────────────
_ do runs-as Bool
    - callee InstanceId
    - held U32
    - target TypeId

` Whether an instance takes, after the arguments a binding holds, those of a function type,
` and returns what the type returns: each as it is, or by a conversion the type pass
` recorded for it. A type that returns nothing takes any answer that needs no memory of the
` caller. A type that carries errors returns its value or one of them, which the type pass
` kept for the type.
. fn = function-row(types, target)
if fn == no-type || (carries(fn) && facts.carried-result(fn) == no-type)
    = false
match? types.rows[fn]
    | .type-function(row)
        . signature = instances.signatures[callee]
        if signature.args.count != held + row.args.count
            = false
        for offset in 0 .. < row.args.count
            . given = types.child-type(row.args, offset)
            . taken = instances.argument-type(callee, held + offset)
            if taken != given && given-conversion == no-fact
                = false
            .. given-conversion = facts.passed-conversion(callee, .reason-argument, given, taken)
        . returns = value-returned(row.return-type)
        if signature.returns == returns || converted != no-fact
            = true
        .. converted = facts.passed-conversion(callee, .reason-return, signature.returns, returns)
        . answered = tables.layouts.values[signature.returns]
        = returns == types.void-type && answered != no-layout && !tables.layouts.is-large(answered)
= false

────────────────────
_ do raises-errors Bool

` Whether an error can leave the function, or what it runs where it is one made for a
` value of a function type: an error raised under it names it in its stack trace, as a
` panic does. One can leave the function of a rule made for a pattern that may raise.
. runs = unit.instance
if function.kind == .adapter
    runs = tables.adapters[function.place].runs
if function.kind == .raising-rule
    = true
= runs != no-instance && instances.signatures[runs].errors.count != 0

────────────────────
_ do carries Bool
    - function TypeId

` Whether a function type carries errors: it declares some, or what it returns is already
` a value or an error.
match? types.rows[function]
    | .type-function(row)
        if row.errors.count != 0
            = true
        if row.return-type == no-type
            = false
        match? types.rows[row.return-type]
            | .type-result
                = true
= false

────────────────────
_ do value-returned TypeId
    - returns TypeId

` The value a function type returns: what it returns, the value of that where it is
` already a value or an error, or nothing.
if returns == no-type
    = types.void-type
match? types.rows[returns]
    | .type-result(held)
        = held.value
= returns

────────────────────
_ do recorded FactId
    - callee InstanceId
    - place SyntaxId
    - reason ConversionReason
    - from TypeId
    - to TypeId

` The conversion the type pass recorded for a function at a place, for a value that a
` function made with no syntax of its own takes from it. No fact where it recorded none.
` One recorded before the function's own nodes were typed is kept apart from them.
. fact = facts.first-conversion(callee, place)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == reason && row.from == from && row.to == to
        = fact
    fact = row.next
. apart = tables.loose-conversion(callee, place, from, reason)
if apart != no-fact && facts.conversions[apart].to == to
    = apart
= no-fact

────────────────────
_ do make-function Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A closure, a binding or a value of another function type made a value of a function
` type: memory in the frame that holds the code the value runs and the data that code is
` given first. The code is the function made for the two types. A closure, which is its
` environment, is the data. A binding's is a copy of the binding that the collector owns,
` or nothing where the binding holds nothing, and a value's is such a copy of the value.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(row.to, site)
. bare = is-c-function(types, row.to) && is-binding(row.from)
if layout != tables.layouts.function-layout && !bare
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. code = tables.adapter-of(row.from, row.to)
. data = value
if is-binding(row.from) || row.casts
    . held = layout-of(row.from, site)
    data = integer(.machine-managed-pointer, 0)
    if bare && held != void-layout
        code = no-function
    if held != void-layout && code != no-function
        . shape = tables.layouts.rows[held]
        . mark = pending.length
        pending += integer(.machine-u64, shape.size)
        if shape.is-managed
            pending += make-operand(.operand-descriptor, held)
        else
            pending += integer(.machine-pointer, 0)
        data = call-runtime(.runtime-allocate-object, site, mark, managed-layout)
        copy(data, value, held, shape.is-managed, site)
else if !is-closure(row.from)
    code = no-function
if code == no-function
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. target = tables.functions[code]
ir.depend(.callee-function, code, 0)
if bare
    = Typed(make-operand(.operand-symbol, target.symbol), row.to)
. made = frame(layout)
store(made, 0, make-operand(.operand-symbol, target.symbol), false, site)
store(made, tables.layouts.field(layout, 1).offset, data, false, site)
= Typed(made, row.to)

────────────────────
_ do emit-adapter

` The function a closure or a binding runs as a value of a function type. Its first argument is
` the data the value holds and the rest are the type's arguments. A closure's data is its
` environment, which its body is given first. A binding's is a copy of the binding, and what the
` type pass found the binding to call is called on the value the binding calls on, where it
` holds one, an object of the class the function is typed for or one derived from it, with the
` arguments it holds and then the adapter's own; a binding of a nested function holds the
` function, which its body is given first, and a binding of a class's name runs the constructor
` written for the class, as the type pass says the binding calls it. An argument a binding holds
` is given as it is, and one of the adapter's own and the answer are converted as the type pass
` recorded for the function called. The call is made where the value was first made, the place
` a stack trace names, or the line below it where the type pass noted that for a closure; for
` one made in several places a stack trace names no place.
` A binding's runs as a callback, which code the collector does not see may call: it enters
` managed code first and leaves it after the call, and where the call panics. A C function a
` binding names is called as it is, with no marks around the call. A C function type's takes
` no data, so its binding holds nothing, and TypeScript places its call where the type is
` declared.
` A type that carries errors returns its value or one of them: an error what runs gives
` leaves the function made as one raised at the call would, and is one the type carries,
` as the type pass requires.
. row = tables.adapters[function.place]
if row.runs == no-instance
    emit-cast(row)
    =
. callee = row.runs
. closes = is-closure(row.from)
line-shift = if row.below then 1 else 0
. count = if closes then 0 else bound-count(row.from)
. receives = !closes && binds-object(row.from)
. fits = closes
. nests = false
. foreign = false
. constructs = false
match? types.rows[row.from]
    | .type-binding(shape)
        nests = shape.form == .bound-closure
        foreign = shape.form == .bound-c-function
        constructs = shape.form == .bound-constructor
        fits = nests || foreign || constructs || function-bound || shape.form == .bound-method
            .. function-bound = shape.form == .bound-function
. owner = instances.rows[callee]
. written = constructs && owner.bound-call == .bound-call-constructor
. named = !constructs && matches
    .. matches = owner.bound-call == (if receives then .bound-call-method else .bound-call-function)
fits = fits && (closes || nests || foreign || written || named)
. held = tables.layouts.values[row.from]
. symbol = if foreign then tables.c-symbols[callee] else no-string
. emitted = tables.instance-functions[callee] != no-function || tables.is-prototype(callee)
if foreign
    emitted = symbol != no-string && tables.c-suspends[callee] == 0 && undescribed
        .. undescribed = tables.c-described[callee] == no-runtime-function
if !fits || held == no-layout || !runs-as(callee, count, row.to) || !emitted
    refuse-own()
    =
. bare = is-c-function(types, row.to)
if bare && (closes || held != void-layout)
    refuse-own()
    =
if !bare
    ir.add-argument(managed-layout)
. site = row.site
if bare
    ir.signals = false
    site = c-type-site(row.to)
    if site == 0
        refuse-own()
        =
match? types.rows[function-row(types, row.to)]
    | .type-function(shape)
        for offset in 0 .. < shape.args.count
            ir.add-argument(layout-of(types.child-type(shape.args, offset), 0))
        returns-type = value-returned(shape.return-type)
ir.returns = layout-of(returns-type, 0)
. target = function-row(types, row.to)
. carried = if carries(target) then facts.carried-result(target) else no-type
if carried != no-type
    return-results(carried, 0)
. raising = !foreign && instances.signatures[callee].errors.count != 0
. answers = void-layout
if foreign
    answers = layout-of(instances.signatures[callee].returns, 0)
. data = make-operand(.operand-argument, 0)
. first U32 = if bare then 0 else 1
. mark = pending.length
. place U32
if !closes
    in-callback = true
    foreign-callback = bare
    call-runtime(callback-entry(), 0, pending.length)
if closes
    pending += data
if receives
    . piece = part(data, held, 0, 0)
    pending += piece.operand
    place = 1
    . derived = tables.is-class(piece.type) && tables.derives(piece.type, owner.self-type)
    if piece.type != owner.self-type && !nests && !derived
        refuse-own()
for offset in 0 .. < count
    . kept = part(data, held, place + offset, 0)
    . taken = instances.argument-type(callee, offset)
    if kept.type != taken
        kept = convert-passed(callee, .reason-argument, site, kept, taken)
    pending += kept.operand
for position in count .. < instances.signatures[callee].args.count
    . own = Typed(make-operand(.operand-argument, first + position - count), own-type(row.to, position - count))
    . taken = instances.argument-type(callee, position)
    if own.type != taken
        own = convert-passed(callee, .reason-argument, site, own, taken)
    pending += own.operand
. answer = make-operand(.operand-void, 0)
if foreign
    ir.depend(.callee-c, symbol, 0)
    answer = call(make-operand(.operand-symbol, symbol), site, mark, .callee-c, answers)
else if receives && !nests
    takes-result = raising
    answer = call-method(callee, site, mark).operand
    takes-result = false
else
    takes-result = raising
    answer = call-instance(callee, site, mark).operand
    takes-result = false
if raising
    answer = propagate(site, callee, answer).operand
if !closes
    call-runtime(callback-exit(), 0, pending.length)
if returns-type == types.void-type
    return-value(make-operand(.operand-void, 0), 0)
    =
if instances.signatures[callee].returns != returns-type
    answer = convert-passed(callee, .reason-return, site, Typed(answer, instances.signatures[callee].returns), returns-type).operand
return-value(answer, 0)

────────────────────
_ callback-entry RuntimeFunction

if foreign-callback then .runtime-enter-foreign-callback else .runtime-enter-callback

────────────────────
_ callback-exit RuntimeFunction

if foreign-callback then .runtime-leave-foreign-callback else .runtime-leave-callback

────────────────────
_ do c-type-site SyntaxId
    - type TypeId

` Where a C function type is declared, which is where the reference places the call of a
` function made a value of it: the syntax of the class first declared as the type, with the
` module that holds it the one read. None where the type is written where it is used.
. declared = types.c-function-decl(type)
if !declared
    = 0
match? program.modules[declared.module].decls[declared.decl]
    | .decl-class(class)
        unit = unit.source-module = declared.module
        = class.syntax
= 0

────────────────────
_ do emit-cast
    - row Adapter

` The function a value of one function type runs as a value of another. Its first argument
` is the data the value holds, a copy of the first value, and the rest are the second
` type's arguments. It calls the code the copy holds with the data that holds and each
` argument as the first type takes it, and answers as the second type does, each converted
` as the type pass recorded for the two types. What runs is not known here, so the call is
` checked for a panic. It is made where the value is first made, the place a stack trace
` names, or where the type pass kept a place for the two types. Where the first type
` carries errors the second does, and an error the code gives leaves the function made as
` the second type's value or error holds it.
. taken = RowRange'TypeId()
. given = RowRange'TypeId()
. answered = types.void-type
. plain = false
. source = function-row(types, row.from)
. target = function-row(types, row.to)
match? types.rows[source]
    | .type-function(shape)
        taken = shape.args
        plain = !shape.is-c
        answered = value-returned(shape.return-type)
match? types.rows[target]
    | .type-function(shape)
        given = shape.args
        plain = plain && !shape.is-c
        returns-type = value-returned(shape.return-type)
. gives = if plain && carries(source) then facts.carried-result(source) else no-type
. makes = if plain && carries(target) then facts.carried-result(target) else no-type
if plain && ((carries(source) && gives == no-type) || (carries(target) && makes == no-type))
    plain = false
if !plain || taken.count != given.count || (gives != no-type && makes == no-type)
    refuse-own()
    =
ir.add-argument(managed-layout)
for offset in 0 .. < given.count
    ir.add-argument(layout-of(types.child-type(given, offset), 0))
ir.returns = layout-of(returns-type, 0)
if makes != no-type
    return-results(makes, 0)
. answers = layout-of(given-type, 0)
    .. given-type = if gives == no-type then answered else gives
. held = make-operand(.operand-argument, 0)
. code = load(held, 0, pointer-layout, row.site)
. mark = pending.length
pending += load
    - held
    - tables.layouts.field(tables.layouts.function-layout, 1).offset
    - managed-layout
    - row.site
for offset in 0 .. < given.count
    . own = make-operand(.operand-argument, 1 + offset)
    . wanted = types.child-type(taken, offset)
    if types.child-type(given, offset) != wanted
        own = convert-cast(row, .reason-argument, Typed(own, types.child-type(given, offset)), wanted).operand
    pending += own
. answer = call(code, row.site, mark, .callee-value, answers, true)
if gives != no-type
    answer = propagate-held(row.site, gives, answer).operand
if returns-type == types.void-type
    return-value(make-operand(.operand-void, 0), 0)
    =
if answered != returns-type
    answer = convert-cast(row, .reason-return, Typed(answer, answered), returns-type).operand
return-value(answer, 0)

────────────────────
_ do convert-cast Typed
    - row Adapter
    - reason ConversionReason
    - value Typed
    - to TypeId

` A value the function made for two function types gives the code it runs, or what that
` code answered, converted by the conversion the type pass recorded for the two types. One
` it recorded none for has no shape.
. fact = facts.cast-conversion(row.from, row.to, reason, value.type, to)
if fact == no-fact
    refuse-own()
    = value
= convert-one(row.site, facts.conversions[fact], value)

────────────────────
_ do own-type TypeId
    - target TypeId
    - offset U32

` The type of an argument of a function type.
match? types.rows[function-row(types, target)]
    | .type-function(shape)
        = types.child-type(shape.args, offset)
= no-type

────────────────────
_ is-binding Bool
    - type TypeId

` Whether a type is a binding: a function, a method or a constructor named, with the
` arguments given it so far.
type != no-type && type != invalid-type && intrinsic(type) == .binding

────────────────────
_ do binds-object Bool
    - type TypeId

` Whether a binding holds a value it calls on, or calls: the receiver of a method, a
` closure, or a value of a function type. A constructor's binding names its class and holds
` nothing for it.
match? types.rows[type]
    | .type-binding(row)
        = row.object != no-type && row.form != .bound-constructor
= false

────────────────────
_ do bound-count U32
    - type TypeId

` How many arguments a binding holds.
match? types.rows[type]
    | .type-binding(row)
        = row.items.count - row.param-count
= 0

────────────────────
_ do part Typed
    - source Operand
    - layout LayoutId
    - position U32
    - syntax SyntaxId

` What a binding holds at a place: a field of the tuple it is, read with the field's type.
` One with no size holds only values of no size.
if layout == void-layout
    = Typed(make-operand(.operand-void, 0), types.void-type)
. field = tables.layouts.field(layout, position)
. value = take(source, field, syntax)
= Typed(value, field.type)

────────────────────
_ do name-binding Typed
    - id SyntaxId
    - type TypeId
    - object SyntaxId

` A function or a method read as a value: a binding that holds no argument yet, but for a
` method the defaults the type pass bound, as `put-defaults` gives them. A method's holds the
` value it is read from, or with none written the receiver of the function the name is read
` in, which for a value written for the receiver's class is the object it is evaluated for. A
` function's holds nothing, and has no size.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(type, id)
. defaults = bound-count(type)
if defaults != 0 && !binds-object(type)
    refuse(.refused-expression, id)
if !binds-object(type)
    if object != 0
        emit-expression(object)
    = Typed(nothing, type)
. value = Typed(unit.self, unit.owner-type)
if object != 0
    value = emit-expression(object)
else if unit.has-self && unit.reading != unit.instance && evaluates-value() && filling.count == 0
    value = Typed(unit.self, unit.self-type)
else if !unit.has-self || unit.reading != unit.instance
    refuse(.refused-expression, id)
if layout == void-layout
    = Typed(nothing, type)
. field = tables.layouts.field(layout, 0)
if tables.layouts.rows[layout].fields.count != 1 + defaults || value.type != field.type
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. made = frame(layout)
put(made, field, value.operand, id)
put-defaults(id, made, layout, defaults)
= Typed(made, type)

────────────────────
_ do put-defaults
    - id SyntaxId
    - made Operand
    - layout LayoutId
    - defaults U32

` Stores in a binding of a method read as a value the defaults the type pass bound, from the
` second field on: each evaluated here in order, as a call that leaves it out evaluates it, of
` the method the type pass recorded at the read as called so.
if defaults == 0
    =
. fact = own-call(id)
if fact == no-fact || facts.calls[fact].form != .call-method
    refuse(.refused-expression, id)
    =
. callee = facts.calls[fact].callee
for position in 0 .. < defaults
    . taken = tables.layouts.field(layout, position + 1)
    . given = default-argument
        - id
        - callee
        - parameter-default(callee, position)
        - instances.argument-type(callee, position)
    if given.type != taken.type
        refuse(.refused-conversion, id)
        =
    put(made, taken, given.operand, id)

────────────────────
_ do make-fields Operand
    - type TypeId
    - layout LayoutId
    - fills RowRange'ArgumentFill
    - start Size
    - count U32
    - syntax SyntaxId

` Memory in the frame for a tuple or struct, with each field stored in turn: the argument
` held from `start` on that fills it, or its first value. Every argument fills one field.
. nothing = make-operand(.operand-void, 0)
if !tables.layouts.is-struct(layout)
    refuse(.refused-type, syntax)
    = nothing
. memory = frame(layout)
. range = types.completions[type].properties
. outer = making
making = Making(memory, type, layout, syntax, made.length, false, making.callee, making.default-holder)
for _ in 0 .. < range.count
    made += 0
. position U32
. placed U32
for offset in 0 .. < range.count
    . property = types.properties[range.start + offset]
    if property.slot == U32.max
        continue
    if property.storage-kind != .storage-eager
        refuse(.refused-type, syntax)
        break
    . fill U32 = ArgumentFill.fill-empty
    if position < fills.count
        fill = facts.call-fills[fills.start + position]
    position += 1
    if fill == ArgumentFill.fill-empty
        continue
    if fill >= count || given[start + fill].type != property.type
        refuse(.refused-conversion, syntax)
    else
        put(memory, tables.layouts.field(layout, property.slot), given[start + fill].operand, syntax)
        made[making.mark + offset] = 2
        placed += 1
for offset in 0 .. < range.count
    make-field(offset)
while made.length > making.mark
    made.pop()
making = outer
if placed != count
    refuse(.refused-expression, syntax)
= memory

────────────────────
_ do emit-range Typed
    - id SyntaxId
    - range ASTRangeExpression

` A range written as a value: the tuple of its start, its end, the step written or else
` one, and whether it runs through its end, made by its fields as the construction the type
` pass recorded says. The step of one and the truth of `..` are the literal's own, as
` TypeScript gives them, not the defaults `Range` declares. Each number is converted to the
` range's item as recorded, and so is the step of one where the item is no number. A range
` with a side left open, or of a type that declares a constructor, has no shape here.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
. type = facts.node-type(unit.reading, id)
if fact == no-fact || range.left == 0 || range.right == 0 || type == no-type || type == invalid-type
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout) || tables.writes-constructor(type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. item = tables.layouts.field(layout, 0).type
. counted = layout-of(item, id)
. start = given.length
. edge = convert(range.left, .reason-element, emit-expression(range.left))
given += edge
edge = convert(range.right, .reason-element, emit-expression(range.right))
given += edge
if range.increment != 0
    edge = convert(range.increment, .reason-element, emit-expression(range.increment))
    given += edge
else if is-integer(counted)
    given += Typed(integer(tables.layouts.kind-of(counted), 1), item)
else if is-float(counted)
    given += Typed(float-number(counted, 1.0), item)
else
    edge = convert(id, .reason-step, Typed(integer(.machine-i64, 1), types.type-row(.int64)))
    given += edge
    if edge.type != item
        refuse(.refused-expression, id)
. count U32 = 3
if range.op == .range-through-op
    given += Typed(integer(.machine-u8, 1), types.bool-type)
    count = 4
. made = nothing
made = make-fields(type, layout, facts.calls[fact].fills, start, count, id)
drop-given(start)
= Typed(made, type)

────────────────────
_ do make-field
    - offset U32

` Gives one field of the tuple or struct being made its first value, unless it has it: in
` the constructor of what is made the argument of the field's name, or the lazy local of its
` name, converted as the type pass recorded where it is written, or else the value its type
` writes for it, or the zero of its type. A field whose value is being evaluated has no value
` to read.
. state = made[making.mark + offset]
. place = types.completions[making.type].properties.start + offset
. property = types.properties[place]
if state == 2 || property.slot == U32.max
    =
if state == 1 || property.storage-kind != .storage-eager
    refuse(.refused-type, making.site)
    =
made[making.mark + offset] = 1
. site = making.site
. memory = making.memory
. field = tables.layouts.field(making.layout, property.slot)
. fill = if making.own then tables.fill-of(unit.instance, property.name) else no-fact
if fill == no-fact
    . value = first-value(property, place, making.type, field.layout, site)
    put(memory, field, value.operand, site)
else
    . fact = facts.fills[fill]
    . kind = if is-own-slot(fact.slot) then bindings.slots[fact.slot].kind else SlotKind.slot-local
    if kind != .slot-argument && kind != .slot-lazy
        refuse(.refused-function, site)
        =
    . given = Typed(make-operand(.operand-void, 0), no-type)
    if kind == .slot-lazy
        . held = facts.slot-type(unit.instance, slot-offset(fact.slot, site))
        given = Typed(read-lazy-local(fact.slot, site, held).operand, held)
    else
        . position = argument-position(fact.slot)
        given = Typed(make-operand(.operand-argument, position), instances.argument-type(unit.instance, position))
    . given-value = convert-fill(fact.site, given)
    if given-value.type != property.type
        refuse(.refused-conversion, site)
    put(memory, field, given-value.operand, site)
made[making.mark + offset] = 2

────────────────────
_ do read-made Typed
    - id SyntaxId
    - name Atom

` A field of the tuple or struct being made, read by the value its type writes for another.
` A field with no value yet is given its own first, which is the order TypeScript evaluates
` them in. One first read under a condition would have its value on one path alone, so only
` a value the type pass found to evaluate every part of itself may read one.
. nothing = make-operand(.operand-void, 0)
. found = property-of(making.type, name)
. range = types.completions[making.type].properties
if !found || (found as U32) < range.start || (found as U32) >= range.start + range.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. offset = (found as U32) - range.start
. property = types.properties[found]
if property.slot == U32.max || property.storage-kind != .storage-eager
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if made[making.mark + offset] != 2
    if instances.rows[unit.reading].branches
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    make-field(offset)
= Typed(take(making.memory, tables.layouts.field(making.layout, property.slot), id), property.type)

────────────────────
_ do first-value Typed ?! Refused
    - property TypeProperty
    - place U32
    - owner TypeId
    - layout LayoutId
    - syntax SyntaxId

` A property's first value: the one its class writes, read through the facts of the
` instance that types it for the type that holds the property, or else the zero of its
` type: no bits set, the empty text, or a named tuple or struct whose own fields have their
` first values. A tuple with no name and an optional have no bits set, whatever they hold,
` but for the empty text wherever they hold a text. A value the type pass typed for no such
` type has no shape. A property that holds an object and has no value written is given the
` object the type pass constructs for it: the call it recorded at the property for the
` constructor being emitted, or for the generated constructor of the tuple or struct being
` built where it is called. So is one that holds a named tuple or struct, where that call is
` of a constructor written in source; where the type declares one and no call is recorded
` here, the value has no shape. Where the call is of a generated constructor, the fields are
` made here with the first values that constructor gives them. A state machine a property
` holds is started later (see `start-member-machine`), and the property holds the first case of
` its union until then. One that holds an object and that a markup element's name or a line of the
` class's markup declares (`content-property`) holds none until the markup gives it one.
. default = tables.default-of(owner, place)
if default.value != 0
    . unit-id = tables.value-unit(place)
    if unit-id == no-instance
        refuse(.refused-expression, syntax)
        = Typed(make-operand(.operand-void, 0), no-type)
    . machine = member-machine(default.module, default.value)
    if machine
        = machine-default(facts.root-machine(machine), syntax)
    . own-unit = unit
    . own-filling = filling
    unit = unit.source-module = default.module
    . holds = holds-locals(unit-id, default.value, default.site)
    if holds
        fill-value-reads(unit-id)
    . run = enter-unit(unit-id) if holds
    if run
        filling = filling.storing = false
        make-subscribers(default.value)
    unit = unit.reading = unit-id
    filling = filling.root = default.value
    if tables.environments[unit-id] != no-layout
        hold-unit(unit-id, default.site, syntax)
    . value = emit-expression(default.value)
    filling = own-filling
    . fact = facts.first-conversion(unit.reading, default.site)
    while fact != no-fact && value.type != property.type
        . row = facts.conversions[fact]
        if row.reason == .reason-declaration && row.from == value.type
            value = convert-one(default.site, row, value)
        fact = row.next
    if run
        leave-unit(run)
    unit = own-unit
    if value.type != property.type
        refuse(.refused-conversion, syntax)
    = value
if default.decl != 0
    match? program.modules[default.module].decls[default.decl]
        | .decl-property(written)
            if written.element != 0 || (written.line != 0 && intrinsic(property.type) == .class)
                = Typed(integer(tables.layouts.kind-of(layout), 0), property.type)
if property.type == types.string-type
    = Typed(make-operand(.operand-constant, ir.add-string("")), property.type)
if intrinsic(property.type) == .class
    . fact = default-construction(owner, default)
    if fact == no-fact
        refuse(.refused-type, syntax)
        = Typed(make-operand(.operand-void, 0), no-type)
    = construct-default(default, fact, property.type)
if tables.layouts.is-struct(layout)
    if is-aggregate(property.type) && !types.is-plain-tuple(property.type)
        . fact = default-construction(owner, default)
        . constructs = fact != no-fact
        if constructs && !tables.builds-in-frame(facts.calls[fact].callee)
            = construct-default(default, fact, property.type)
        if !constructs && tables.writes-constructor(property.type)
            refuse(.refused-type, syntax)
            = Typed(make-operand(.operand-void, 0), no-type)
        . own-making = making
        if constructs
            making = making.callee = facts.calls[fact].callee
        . made = make-fields
            - property.type
            - layout
            - RowRange'ArgumentFill()
            - given.length
            - 0
            - syntax
        making = own-making
        = Typed(made, property.type)
    = null-value(property.type, layout, syntax)
. kind = tables.layouts.kind-of(layout)
if kind == .machine-void
    = Typed(make-operand(.operand-void, 0), property.type)
= Typed(integer(kind, 0), property.type)

────────────────────
_ do fill-value-reads
    - unit-id InstanceId

` Gives each stored property of the object being made that a value with locals of its own reads
` its first value before the value runs, as a read gives it one (`read-filled`). The value runs as
` an instance of its own (`enter-unit`), where a read cannot give the constructor's properties
` their values.
=? if !filling.storing || filling.count == 0
. read = tables.first-read(unit-id)
while read != no-fact
    . found = property-read(filling.type, read)
    if found
        . position = (found as U32) - filling.start
        . eager = types.properties[found].storage-kind == .storage-eager
        if eager && position < filling.count && filling.filled[position] == 0 && !facts.defers(unit.instance, found as U32)
            . own-unit = unit
            . own-filling = filling
            unit = unit.source-module = function.module
            unit = unit.reading = unit.instance
            store-property(position, 0)
            unit = own-unit
            filling = own-filling
    read = tables.next-read(read)

────────────────────
_ do hold-unit
    - unit-id InstanceId
    - property SyntaxId
    - syntax SyntaxId

` Makes the environment of a line of a root `<This` whose closures read the object, as those
` the class's markup writes read it: no link, then the object being made, which the closures
` written in the value are given while it is evaluated. One that keeps anything else has no
` shape here.
. layout = tables.environments[unit-id]
. binding = instances.rows[unit-id].binding
if layout == unbuilt-environment || binding == no-binding || !unit.has-self || unpaired
    refuse(.refused-function, syntax)
    =
.. unpaired = tables.layouts.rows[layout].fields.count != 2
. bound = bindings.window-of(binding, property)
. home = tables.instance-scopes[unit-id]
for slot in bound.start .. < bound.start + bound.count
    if bindings.slots[slot].kind != .slot-this || tables.slot-homes[slot] != home
        continue
    . mark = pending.length
    pending += integer(.machine-u64, tables.layouts.rows[layout].size)
    pending += make-operand(.operand-descriptor, layout)
    filling = filling.held-environment = ir.add-local(managed-layout)
    store-local
        - filling.held-environment
        - call-runtime(.runtime-allocate-object, syntax, mark, managed-layout)
        - syntax
    store
        - load-local(filling.held-environment, syntax)
        - tables.layouts.field(layout, 1 + tables.slot-fields[slot]).offset
        - unit.self
        - true
        - syntax
    filling = filling.held-unit = unit-id
    =
refuse(.refused-function, syntax)

────────────────────
_ do holds-locals Bool
    - unit-id InstanceId
    - value SyntaxId
    - property SyntaxId

` Whether a value an instance types, written at `value`, declares locals in a scope of its own,
` or a lazy local some read tracks, which its one read does not evaluate in place (see
` `read-apart`), which the function that evaluates the value where it is written holds as its
` own for the run (see `enter-unit`), where no nested function reads them. Only the slots the
` binder declared for the value of the property declared at `property` are looked at
` (`window-of`), not every slot of its module's main.
if tables.environments[unit-id] != no-layout
    = false
. binding = instances.rows[unit-id].binding
if binding == no-binding
    = false
. bound = bindings.window-of(binding, property)
. start = tree.subtree-start(value)
for slot in bound.start .. < bound.start + bound.count
    . row = bindings.slots[slot]
    . scoped = bindings.scopes[row.scope].syntax
    . tracked = row.kind == .slot-lazy && (row.flags /and/ SlotFlag.slot-tracked) != 0
    if (row.kind == .slot-local || tracked) && start <= scoped && scoped <= value
        = true
    if row.kind == .slot-loop-state && start <= row.syntax && row.syntax <= value
        = true
= false

────────────────────
_ do default-construction FactId
    - owner TypeId
    - default PropertyDefault

` The construction the type pass recorded at a property with no value written: for the
` constructor being emitted, or for the generated constructor of the tuple or struct being
` built where it is called. A property of another module's class has it recorded by the
` instance that typed it there for the class being made, and a field of another module's
` tuple or struct by that generated constructor, which is typed there.
if default.site == 0
    = no-fact
. builder = making.callee
if unit.instance != no-instance && default.module != instances.rows[unit.instance].module
    . built = no-fact
    if builder != no-instance && instances.rows[builder].self-type == owner && same-module
        built = tables.loose-call(builder, default.site)
    .. same-module = instances.rows[builder].module == default.module
    if built != no-fact && facts.calls[built].form == .call-this-constructor
        = built
    . unit-id = instances.find-initializer(default.module, default.decl, owner)
    if unit-id == no-instance
        = no-fact
    . made = facts.first-call(unit-id, default.site)
    while made != no-fact && facts.calls[made].form != .call-this-constructor
        made = facts.calls[made].next
    = made
. fact = if unit.reading == unit.instance && unit.instance != no-instance then instance-call else no-fact
    .. instance-call = tables.loose-call(unit.instance, default.site)
if fact == no-fact && builder != no-instance && instances.rows[builder].self-type == owner
    fact = tables.loose-call(builder, default.site)
if fact == no-fact || facts.calls[fact].form != .call-this-constructor
    = no-fact
= fact

────────────────────
_ do construct-default Typed
    - default PropertyDefault
    - fact FactId
    - type TypeId

` A property's construction with no value written. The defaults of the arguments it leaves
` out are converted as the instance that recorded the construction says, which is read with
` the source of its module where that is another module's.
. own-making = making
making = making.default-holder = if tables.loose-call(unit.instance, default.site) == fact then unit.instance else making.callee
. own-unit = unit
. holder = facts.calls[fact].instance
if holder != unit.instance && instances.rows[holder].module != instances.rows[unit.instance].module
    unit = unit.source-module = default.module
    unit = unit.reading = holder
. made = emit-fact-call(default.site, facts.calls[fact], 0, RowRange'SyntaxId(), 0, 0, type)
unit = own-unit
making = own-making
= made

────────────────────
_ do settled Operand
    - value Typed
    - expression SyntaxId
    - later RowRange'SyntaxId
    - next U32

` An operand that is the address of storage, copied before an operand after it that may
` change what is stored: any but a literal or a plain name. `later` are the operands of the
` call and `next` is the first that is evaluated after this one.
. disturbed = false
for position in next .. < later.count
    if !is-inert(tree.children[later.start + position])
        disturbed = true
= apart(value, expression, disturbed)

────────────────────
_ do apart Operand
    - value Typed
    - expression SyntaxId
    - disturbed Bool

` An operand that is the address of storage, copied when what is evaluated after it may
` change what is stored. A row `t[i]` made a value lies where nothing changes it.
if !disturbed || expression == 0
    = value.operand
if value.type == no-type || value.type == invalid-type
    = value.operand
. layout = tables.layouts.values[value.type]
if layout == no-layout || !tables.layouts.is-struct(layout) || is-answer(value.operand) || already-made
    = value.operand
.. already-made = made-row(value.operand) != U32.max
= snapshot(value.operand, layout, expression)

────────────────────
_ is-answer Bool
    - value Operand

` Whether a struct is the answer of a call, in memory that nothing names. Any other struct
` is taken to lie in storage that code run later may change.
operand-kind(value) == .operand-value && ir.instructions[operand-payload(value)].op == .op-call

────────────────────
_ do snapshot Operand
    - value Operand
    - layout LayoutId
    - syntax SyntaxId

` A copy of a struct in memory of the frame, which nothing else names.
. held = frame(layout)
copy(held, value, layout, false, syntax)
= held

────────────────────
_ do is-inert Bool
    - id SyntaxId

` Whether evaluating an operand can change nothing: a literal, a name that calls nothing and
` that the type pass said evaluates nothing where it is read, a stored member it said the same
` of read from such an operand, or an operation of the machine on two such operands.
match? tree.nodes[id]
    | .node-argument(named)
        = is-inert(named.expr)
    | .node-get-expression(row)
        = unplanned && get-uncalled && facts.is-plain(unit.reading, id) && is-inert(row.object)
            .. unplanned = facts.plan-of(unit.reading, id) == .plan-none
            .. get-uncalled = facts.first-call(unit.reading, id) == no-fact
    | .node-binary-expression(row)
        = builtin-plan && binary-uncalled && is-inert(row.lhs) && is-inert(row.rhs)
            .. builtin-plan = facts.plan-of(unit.reading, id) == .plan-builtin
            .. binary-uncalled = facts.first-call(unit.reading, id) == no-fact
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-string-syntax
        = true
    | .node-identifier
        = facts.first-call(unit.reading, id) == no-fact && facts.is-plain(unit.reading, id)
= false

────────────────────
_ do read-through Typed
    - site SyntaxId
    - value Typed
    - through RowRange'U32

` What a function takes that a property answers for its receiver: each property the type
` pass named is read from what the one before it gave, the first from the receiver `value`.
` One a getter answers is read by a call of the getter the type pass kept for it, each time.
` A property that holds an optional has no shape here.
. held = value
for offset in 0 .. < through.count
    . place = facts.steps[through.start + offset]
    . property = types.properties[place]
    . owner = held.type
    if property.storage-kind == .storage-getter
        . getter = facts.step-callees[through.start + offset]
        if getter == no-instance || !is-callable(getter) || getter-raises
            refuse(.refused-expression, site)
            break
        .. getter-raises = instances.signatures[getter].errors.count != 0
        . mark = pending.length
        pending += held.operand
        held = call-method(getter, site, mark)
        continue
    if property.type == no-type || types.is-optional(property.type)
        refuse(.refused-expression, site)
        break
    held = load-property(site, held.operand, owner, property.name, true, property.type)
= held

────────────────────
_ do emit-receiver Typed
    - id SyntaxId
    - object SyntaxId
    - shared Bool = false

` The receiver of a call: the value written before the callee's name, or with none written
` the receiver of the function the call is in. It takes the conversion recorded for a
` receiver where its value is written, or else the one recorded at the call for the receiver
` of the function it is in, kept apart since the call may be the receiver written for another.
` A name a call calls, which is the receiver of the function its type declares for a call, is
` read as `emit-callee` reads it. A receiver `shared` by calls that each recorded its conversion
` takes those of its type.
. nothing = make-operand(.operand-void, 0)
if object != 0
    = convert(object, .reason-receiver, emit-callee(object), 0, shared)
if unit.has-self && unit.reading != unit.instance && evaluates-value() && filling.count == 0
    = convert(id, .reason-own-receiver, Typed(unit.self, unit.self-type), 0, shared)
if !unit.has-self || (unit.reading != unit.instance && unit.reading != unit.lender)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= convert(id, .reason-own-receiver, Typed(unit.self, unit.owner-type), 0, shared)

────────────────────
_ do default-argument Typed
    - id SyntaxId
    - callee InstanceId
    - syntax SyntaxId
    - expected TypeId

` The value of a parameter a call leaves out. With no default written it is an optional with
` no value. A default that runs no code is a constant, read through the facts of the
` callee, which typed it. A default that runs code and is no constant is answered by its own
` function, called here; any other is read from where its module stored it as it started.
` Each is then converted as the call records for a default, at its node or, for a call that
` no node of the body writes, among those recorded outside its body by the instance, or by
` the generated constructor that recorded the construction of a property being made, or as
` the callee recorded where the default is written.
. nothing = make-operand(.operand-void, 0)
if syntax == 0
    = absent-argument(id, expected)
. callee-module = instances.rows[callee].module
. value = Typed(nothing, no-type)
if !tables.default-runs-code(callee, syntax)
    . own-unit = unit
    unit = unit.source-module = callee-module
    unit = unit.reading = callee
    value = emit-expression(syntax)
    unit = own-unit
else
    . row = tables.default-storage(callee, syntax)
    if row == no-storage
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . kept = tables.storage[row]
    if kept.function == no-function
        value = load-global(kept, id)
    else
        value = call-default(id, kept)
if value.type == expected
    = value
. fact = facts.first-conversion(unit.reading, id)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-default && row.from == value.type && row.to == expected
        = convert-one(id, row, value)
    fact = row.next
fact = facts.first-conversion(callee, syntax)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-default && row.from == value.type && row.to == expected
        = convert-one(id, row, value)
    fact = row.next
. holder = if making.default-holder != no-instance then making.default-holder else unit.instance
if holder != no-instance && (unit.reading == unit.instance || unit.reading == holder)
    . loose = tables.loose-conversion(holder, id, value.type, .reason-default, expected)
    if loose != no-fact
        = convert-one(id, facts.conversions[loose], value)
refuse(.refused-conversion, id)
= Typed(nothing, no-type)

────────────────────
_ do absent-argument Typed
    - id SyntaxId
    - expected TypeId

` The value of an argument a call leaves out that has no default: an optional with no value.
. nothing = make-operand(.operand-void, 0)
if !types.is-optional(expected)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. layout = layout-of(expected, id)
if !tables.layouts.is-struct(layout) && !is-null-form(expected)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
= empty-optional(expected, layout)

────────────────────
_ do drop-given
    - mark Size

while given.length > mark
    given.pop()

────────────────────
_ do poll
    - syntax SyntaxId

` A safepoint the collector can stop the task at, taken when the collector has asked for one,
` and the check that the task is not being terminated. The collector's control word says when
` either may be needed, so the poll reads that one word on its way through.
. control-address = make-operand(.operand-symbol, tables.bundle.gc-public-control-word-symbol)
. control = load(control-address, 0, u8-layout, syntax)
. watched = handshake-requested-control /or/ termination-requested-control
. asked = bitwise(syntax, .bitwise-and, control, integer(.machine-u8, watched), u8-layout)
. slow = ir.reserve-block()
. stop = ir.reserve-block()
. checking = ir.reserve-block()
. polled = ir.reserve-block()
branch(asked, slow, polled)
ir.start-block(slow)
. collecting = bitwise
    - syntax
    - .bitwise-and
    - control
    - integer(.machine-u8, handshake-requested-control)
    - u8-layout
branch(collecting, stop, checking)
ir.start-block(stop)
call-runtime(.runtime-safepoint, syntax, pending.length)
jump(checking)
ir.start-block(checking)
check-interrupt(syntax)
jump(polled)
ir.start-block(polled)

────────────────────
_ do check-interrupt
    - syntax SyntaxId

` The check that the task is not being terminated, in a function that `raises-termination`. A
` terminating task leaves through the landing pad with the termination panic.
if !raises-termination()
    =
. flags-address = make-operand(.operand-symbol, tables.runtime-symbol(.runtime-interrupt-flags))
. resume = ir.reserve-block()
check-termination(load(flags-address, 0, u8-layout, syntax), syntax, resume)
ir.start-block(resume)

────────────────────
_ raises-termination Bool

` Whether a poll or a C call that finds the task being terminated leaves with the termination
` panic: in a function that may panic already, or whose callers check the panic signal, or that
` no function calls, a module's main or a task's body. Elsewhere the task runs on until one of
` those finds it, so that no function may panic only because it polls.
signals-panic || function.kind == .module-main || function.kind == .task-body
.. signals-panic = function.may-panic || function.carries

────────────────────
_ is-unpolled Bool

` Whether the code emitted runs where no safepoint is allowed, by what its function declares or a
` `do` block around it is kept from, or because the collector never sees it: its loops poll
` nothing.
(effects-here() /and/ CompilationEffect.no-safepoint) != 0

────────────────────
_ do read-instance
    - read InstanceId

` Makes the function emitted that of an instance, whose facts it reads: what depends on the
` instance alone follows it.
unit = unit.instance = read
unit = unit.reading = read
unit = unit.owner-type = if read == no-instance then no-type else instances.rows[read].self-type
in-zone = is-free(read)

────────────────────
_ is-free Bool
    - function InstanceId

` Whether a function runs where the collector never sees it.
function != no-instance && (instances.rows[function].effects /and/ CompilationEffect.gc-free) != 0

────────────────────
_ do cross-zone
    - syntax SyntaxId
    - enters Bool

` Enters or leaves the zone the collector never sees. Either way the collector reads the
` caller's stack at the call. A function that runs in the zone steps out of it and back as a
` callback does, and the zone stays the one its caller entered: the collector reads the stack
` from where that caller entered it, as the function's own frame is gone once it returns.
. boundary =
    |? is-free(unit.instance)
        if enters then leave-callback else RuntimeFunction.runtime-enter-callback
        .. leave-callback = RuntimeFunction.runtime-leave-callback
    ??
        if enters then RuntimeFunction.runtime-enter-zone else RuntimeFunction.runtime-leave-zone
call-runtime(boundary, syntax, pending.length, void-layout, true)

────────────────────
_ closes-zone Bool
    - answer U8

` Whether the path of an error of a call ends the zone the caller entered for it: the callee
` runs in the zone and the caller does not, and the error came back with the callee stepped
` out of it.
answer == 3 && !is-free(unit.instance)

────────────────────
_ do close-zone
    - syntax SyntaxId

` Ends the zone entered for a call where an error or a panic came back with the callee stepped
` out of it: the step out is ended, then the zone.
call-runtime(.runtime-leave-callback, syntax, pending.length, void-layout, true)
call-runtime(.runtime-leave-zone, syntax, pending.length, void-layout, true)

────────────────────
_ do land-closed
    - pad IRBlockId
    - syntax SyntaxId

` Emits a pad `closing-pad` made: it ends the zone and takes the landing pad.
if pad == no-block
    =
. onward = ir.reserve-block()
jump(onward)
ir.start-block(pad)
close-zone(syntax)
jump(landing-block(syntax))
ir.start-block(onward)

────────────────────
_ do raised-text Operand
    - raised Operand
    - slot U32
    - raises Bool

` The text of a panic or an error, made by the converter its class has in a slot of its
` table. The call is checked where a converter some class has there may panic, unless a
` panic is being handled already.
. table = load(raised, 0, pointer-layout, 0)
. method = load(table, table-header-size + slot * table-slot-size, pointer-layout, 0)
. mark = pending.length
pending += raised
= call(method, 0, mark, .callee-value, managed-layout, raises && !in-landing)

────────────────────
_ do raised-place Typed
    - raised Operand

` The text of the source of a panic or an error, or the empty text for one that has none.
. report = instances.report
. layouts = tables.layouts
. object = layouts.objects[types.panic-type]
. field = layouts.field(object, object-header-fields + report.source-slot)
. inner = layouts.field(field.layout, 0)
. flag = layouts.field(field.layout, 1)
. source = address(raised, field.offset, field.layout, 0)
. with-source = ir.reserve-block()
. unplaced = ir.reserve-block()
. joined = ir.reserve-block()
branch(load(source, flag.offset, flag.layout, 0), with-source, unplaced)
ir.start-block(unplaced)
jump(joined)
ir.start-block(with-source)
. mark = pending.length
pending += address(source, inner.offset, inner.layout, 0)
. place = call-instance(report.source-text, 0, mark)
. placed = ir.current
jump(joined)
ir.start-block(joined)
. nowhere = make-operand(.operand-constant, ir.add-string(""))
= Typed(phi(managed-layout, place.operand, placed, nowhere, unplaced), place.type)

────────────────────
_ do report-error
    - error Operand
    - id SyntaxId
    - prints Bool = false

` Reports an error that left the main of a module or the body of a spawned task, which no
` caller is left to handle: its text, made through its class table, the text of its source
` and its stack trace are given to the runtime, which ends the process, or with `prints` only
` prints them. A panic raised while a text is made leaves the function as any other does, which
` the type pass said of every one that lets an error out.
. report = instances.report
. made = report.error-text
if made == no-instance || tables.instance-functions[made] == no-function || !function.may-panic
    refuse(.refused-statement, id)
    =
. slot = tables.slots[made]
if slot == no-slot-index || tables.instance-functions[report.source-text] == no-function
    refuse(.refused-statement, id)
    =
. object = tables.layouts.objects[types.panic-type]
. trace = tables.layouts.field(object, object-header-fields + report.trace-slot)
. message = raised-text(error, slot, tables.raises-through(made))
. placed = raised-place(error)
. mark = pending.length
if !prints
    pending += error
pending += message
pending += placed.operand
pending += load(error, trace.offset, trace.layout, 0)
call-runtime
    - if prints then .runtime-print-unhandled-error else .runtime-report-unhandled-error
    - 0
    - mark

────────────────────
_ do call-instance Typed
    - callee InstanceId
    - syntax SyntaxId
    - mark Size
    - restores Bool = false
    - watched Bool = false
    - variant FunctionId = no-function
    - held TypeId = no-type

` A call of an emitted instance with the pending arguments from `mark` on, or with
` `restores` of the initializer of a constructor, which returns nothing. One that may panic
` is checked, unless the call is made while a panic is already being handled, or the type
` pass says no call of the instance is checked and the call is not `watched`. A call between
` code the collector never sees and a function it does, or the other way, crosses the zone
` before the call and crosses back after it, unless the callee is one that reaches no safepoint
` there, which runs where it is called. A callee that returns a panic has stepped out
` of the zone, so the landing pad is always outside it, and a caller outside the zone ends
` the zone it entered before it lands. The slots of globals `do with` binds set
` for the call are put back on both ways out of it. Only a grammar calls a rule a
` module declares, which `calls-rule` says, and its function for a set of collectors is the
` `variant` where one is given, as is its function for a pattern that may raise errors, which
` answers with `held`.
if !restores && tables.is-prototype(callee)
    = call-slot(callee, syntax, mark, watched)
. rules = calls-rule
calls-rule = false
. ruled = rule-match(program, instances.rows[callee].module, instances.rows[callee].decl)
if !restores && rules != (ruled != 0)
    refuse(.refused-expression, syntax)
    drop-pending(mark)
    = Typed(make-operand(.operand-void, 0), no-type)
if !restores && function.kind != .witness && answers-itself(callee)
    refuse(.refused-expression, syntax)
    drop-pending(mark)
    = Typed(make-operand(.operand-void, 0), no-type)
. target-id = if restores then tables.initializer-functions[callee] else called-target
    .. called-target = if variant != no-function then variant else tables.instance-functions[callee]
?! Panic("A called instance is not in the emitted set")
    if target-id == no-function
. target = tables.functions[target-id]
. signature = instances.signatures[callee]
. raising = signature.errors.count != 0
. raw = takes-result
takes-result = false
if raising && (restores || !raw || zone-answer != 0)
    refuse(.refused-expression, syntax)
if held != no-type && (raising || restores || is-free(callee) || in-zone)
    refuse(.refused-expression, syntax)
. returned = if held != no-type then held else if restores then types.void-type else promised
    .. promised = if raising then signature.result else signature.returns
. returns = layout-of(returned, syntax)
. flags U32 = if instances.rows[callee].is-generator then generator-dependency else 0
if target.may-panic
    flags = flags /or/ may-panic-dependency
ir.depend(.callee-function, target-id, flags)
. checked = target.may-panic && !in-landing && (watched || !instances.rows[callee].quiet)
. symbol = make-operand(.operand-symbol, target.symbol)
. saved = prepare-stacks(callee, syntax)
. enters = is-free(callee) && (in-zone || !tables.is-bounded(callee))
. crosses = enters != in-zone
. closing = checked && crosses && enters && !is-free(unit.instance)
. restoring = no-block
if checked
    for local in saved
        if local != no-local
            restoring = ir.reserve-block()
            break
if closing && restoring == no-block
    restoring = ir.reserve-block()
if crosses
    cross-zone(syntax, enters)
. result = call(symbol, syntax, mark, .callee-function, returns, checked, false, restoring)
cross-back(syntax, enters, raising)
restore-stacks(callee, saved, syntax)
if restoring != no-block
    . onward = ir.reserve-block()
    jump(onward)
    ir.start-block(restoring)
    if closing
        close-zone(syntax)
    restore-stacks(callee, saved, syntax)
    jump(landing-block(syntax))
    ir.start-block(onward)
= Typed(result, returned)

────────────────────
_ do prepare-stacks [LocalId]
    - callee InstanceId
    - site SyntaxId

` Before the body of a spawned task, a lambda or a comprehension calls a function that reads
` globals `do with` binds outside its bindings of them, each slot no binding around the call
` holds is kept, and set to the state the body holds, as TypeScript does. The local each is
` kept in, or none. As a read of one, a call in a cleanup a landing pad runs is refused where a
` `do with` after the cleanup binds it. A nested function called holds what it captured, and is
` given nothing, as TypeScript gives a closure nothing.
. saved [LocalId]
if function.kind != .task-body && !is-closure-body()
    = saved
. called = instances.rows[callee]
match? program.modules[called.module].decls[called.decl]
    | .decl-function(fn)
        if is-nested-kind(fn.kind)
            = saved
for row in tables.stack-needs(callee)
    . local = no-local
    if row != no-storage && scoping.unwinding-from != 0 && binds-after(row, scoping.unwinding-from)
        refuse(.refused-expression, site)
    if row != no-storage && !stack-bound(row)
        . kept = tables.storage[row]
        local = ir.add-local(kept.layout)
        . slot = stack-slot(kept, site)
        store-local(local, slot, site)
        copy
            - slot
            - stack-state(row, site)
            - kept.layout
            - tables.layouts.rows[kept.layout].is-managed
            - site
    saved += local
= saved

────────────────────
_ is-callable Bool
    - callee InstanceId

` Whether a call of an instance has something to call: the function emitted for it, or the
` slot it has in a witness table.
tables.instance-functions[callee] != no-function || tables.is-prototype(callee)

────────────────────
_ do call-slot Typed
    - callee InstanceId
    - syntax SyntaxId
    - mark Size
    - watched Bool = false

` A call of a function of an interface through a value of it, the first of the pending
` arguments from `mark` on: of what the value's witness table holds in the function's slot
` of the interface's section, given the value and the arguments. What runs is not known
` here, so the call is checked for a panic, which the type pass must have said of the
` caller too. A function that raises errors answers with its value or one of them, to a
` caller that takes that. A call of a function the type pass says no call checks is not
` checked: a panic raised under it stays the task's, and what follows the call runs, as
` in the reference. A `watched` call is checked all the same. A call in the zone the
` collector never sees stays in it, as TypeScript's does, since what runs is not known.
. nothing = make-operand(.operand-void, 0)
. signature = instances.signatures[callee]
. raising = signature.errors.count != 0
. raw = takes-result
. checked = watched || !instances.rows[callee].quiet
takes-result = false
if mark >= pending.length || (raising && (!raw || in-zone)) || uncaught-panic
    refuse(.refused-expression, syntax)
.. uncaught-panic = checked && !function.may-panic && !in-landing
. returned = if raising then signature.result else signature.returns
. returns = layout-of(returned, syntax)
. layout = tables.layouts.interface-layout
. table = load(pending[mark], tables.layouts.field(layout, 1).offset, pointer-layout, syntax)
. place = (witness-header-slots + tables.slots[callee]) * table-slot-size
. method = load(table, place, pointer-layout, syntax)
. result = call(method, syntax, mark, .callee-value, returns, checked && !in-landing)
= Typed(result, returned)

────────────────────
_ do emit-view

` A function of an interface as a value of a type that is none runs it: it sees the value
` as the interface, and calls the function that holds the body with that and its
` arguments. It is a frame of its own in a stack trace, placed where the function is
` declared, as TypeScript's is. One that raises errors returns what the function that holds
` the body gave it, the value or one of the errors, which is held the same.
. row = instances.rows[unit.instance]
. signature = instances.signatures[unit.instance]
. declared = row.subtree.start + row.subtree.count - 1
. target-id = tables.body-functions[unit.instance]
. target = tables.functions[target-id]
. forwards = signature.errors.count != 0
if in-zone || (forwards && target.instance == no-instance)
    refuse(.refused-function, declared)
    =
if forwards && instances.signatures[target.instance].result != signature.result
    refuse(.refused-function, declared)
    =
ir.add-argument(layout-of(row.self-type, declared))
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
returns-type = signature.returns
ir.returns = layout-of(signature.returns, declared)
if forwards
    return-results(signature.result, declared)
. mark = pending.length
. view = tables.receiver-view(unit.instance)
pending += make-interface(declared, row.self-type, view, make-operand(.operand-argument, 0)).operand
for position in 0 .. < signature.args.count
    pending += make-operand(.operand-argument, position + 1)
ir.depend(.callee-function, target-id, if target.may-panic then may-panic-dependency else 0u32)
. symbol = make-operand(.operand-symbol, target.symbol)
. answer = call(symbol, declared, mark, .callee-function, ir.returns, target.may-panic)
if forwards
    return-held(answer)
else if returns-type == types.void-type
    return-nothing()
else
    return-value(answer, 0)

────────────────────
_ do emit-class-adapter

` The function a class's table holds in the slot of a base's method for an override that
` answers another type, as TypeScript's `(class-adapter)`. It takes what the base's method
` takes, the object first, and calls the override with them as they are, at its
` declaration, the place a stack trace names. What the override answers is converted to
` what the base's answers, as the type pass recorded at that declaration, and is the value
` with no error where the base's raises errors and the override raises none. Where the
` override answers nothing, it answers what a return written with no value gives, the
` default of the base's type, as the reference does. An override that raises errors the
` base's answers otherwise, or that takes an argument as another type, has no shape here. A
` property a class stores in place of a getter or a setter is read or stored as
` `emit-class-accessor` says.
. row = tables.class-adapters[function.place]
if row.override == no-instance
    emit-class-accessor(row)
    =
. theirs = instances.signatures[row.proto]
. mine = instances.signatures[row.override]
. written = instances.rows[row.override]
. forwards = mine.errors.count != 0
if theirs.args.count != mine.args.count || (forwards && theirs.result != mine.result)
    refuse-instance(row.override)
    =
ir.add-argument(layout-of(instances.rows[row.proto].self-type, 0))
for position in 0 .. < theirs.args.count
    . given = instances.argument-type(row.proto, position)
    if given != instances.argument-type(row.override, position)
        refuse-instance(row.override)
    ir.add-argument(layout-of(given, 0))
returns-type = theirs.returns
ir.returns = layout-of(returns-type, 0)
if theirs.errors.count != 0
    return-results(theirs.result, 0)
. kept = written.subtree.start + written.subtree.count - 1
. mark = pending.length
for position in 0 .. < theirs.args.count + 1
    pending += make-operand(.operand-argument, position)
takes-result = forwards
. answer = call-instance(row.override, kept, mark)
if !forwards && returns-type != types.void-type && answer.type == types.void-type
    return-absent(0, true)
    =
if returns-type == types.void-type
    answer = Typed(make-operand(.operand-void, 0), answer.type)
else if !forwards && answer.type != returns-type
    answer = convert-recorded(row.override, kept, .reason-return, kept, answer, returns-type)
if forwards
    return-held(answer.operand)
else if returns-type == types.void-type && result-type == no-type
    return-nothing()
else
    return-value(answer.operand, 0)

────────────────────
_ do emit-class-accessor
    - row ClassAdapter

` The function a class's table holds in the slot of a getter or a setter of an interface for
` objects of a class that store the property in its place: it reads the property of the
` object, wrapped in the optional the getter answers where it holds what that holds, or stores
` its argument there as an assignment does. A property stored any other way, one some read
` tracks, and one of another type than the getter answers or the setter is given have no
` shape here.
. theirs = instances.signatures[row.proto]
. place = row.property
if theirs.args.count > 1 || theirs.errors.count != 0 || place >= types.properties.length
    refuse-class(row.receiver)
    =
. property = types.properties[place]
. held = tables.layouts.objects[row.receiver]
if property.storage-kind != .storage-eager || tracks(property) || held == no-layout
    refuse-class(row.receiver)
    =
ir.add-argument(layout-of(instances.rows[row.proto].self-type, 0))
. object = make-operand(.operand-argument, 0)
if theirs.args.count == 1
    . given = instances.argument-type(row.proto, 0)
    ir.add-argument(layout-of(given, 0))
    if theirs.returns != types.void-type || given != property.type
        refuse-class(row.receiver)
        =
    . field = tables.layouts.field(held, object-header-fields + property.slot)
    put-property(object, field, property, make-operand(.operand-argument, 1), 0, U32.max, false, memo-flag-of(row.receiver, property))
    return-nothing()
    =
returns-type = theirs.returns
ir.returns = layout-of(returns-type, 0)
. answer = load-property(0, object, row.receiver, property.name, true, returns-type)
if answer.type != returns-type && wraps-value
    answer = wrap(0, answer, returns-type)
.. wraps-value = types.is-optional(returns-type) && types.optional-inner(returns-type) == answer.type
if answer.type != returns-type
    refuse-class(row.receiver)
    =
return-value(answer.operand, 0)

────────────────────
_ is-derived Bool
    - type TypeId
    - base TypeId

` Whether a value of a type is an object of a class derived from another, which a function
` of that class takes as it is.
tables.is-class(type) && tables.derives(type, base)

────────────────────
_ do convert-recorded Typed
    - callee InstanceId
    - place SyntaxId
    - reason ConversionReason
    - site SyntaxId
    - value Typed
    - to TypeId

` What a function called answered a function made with no syntax of its own, converted by
` the conversion the type pass recorded for the function called at a place. One it recorded
` none for has no shape.
. fact = recorded(callee, place, reason, value.type, to)
if fact == no-fact
    refuse-instance(callee)
    = value
= convert-one(site, facts.conversions[fact], value)

────────────────────
_ do convert-passed Typed
    - callee InstanceId
    - reason ConversionReason
    - site SyntaxId
    - value Typed
    - to TypeId

` A value a function made for a value of a function type gives the function it runs, or
` what that function answered, converted by the conversion the type pass recorded for the
` function run. One it recorded none for has no shape.
. fact = facts.passed-conversion(callee, reason, value.type, to)
if fact == no-fact
    refuse(.refused-function, site)
    = value
= convert-one(site, facts.conversions[fact], value)

────────────────────
_ do call-method Typed
    - callee InstanceId
    - syntax SyntaxId
    - mark Size
    - exact Bool = false

` A call of a method or of a converter, with the receiver first among the pending arguments
` from `mark` on. One that some class declares again is chosen by the class of the object:
` the function in the slot the callee has in the object's table. It is checked when a
` function some table holds there may panic, which the type pass must have said of the
` caller too. An `exact` call is of the callee itself, and so is one whose slot no table
` holds, as no object of a class that has it is ever made for the call to run on. One that
` raises errors answers what a function that raises returns, as each function a table holds
` in its slot does, which the caller takes apart.
. nothing = make-operand(.operand-void, 0)
if exact || !tables.is-overridden(callee) || (unslotted && has-function)
    = call-instance(callee, syntax, mark)
.. unslotted = tables.slots[callee] == no-slot-index
.. has-function = tables.instance-functions[callee] != no-function
. raw = takes-result
takes-result = false
. slot = tables.slots[callee]
. target-id = tables.instance-functions[callee]
. raises = tables.raises-through(callee)
. raising = instances.signatures[callee].errors.count != 0
if slot == no-slot-index || target-id == no-function || mark >= pending.length
    refuse(.refused-expression, syntax)
if raising && (!raw || zone-answer != 0)
    refuse(.refused-expression, syntax)
if raises && !function.may-panic && !in-landing
    refuse(.refused-expression, syntax)
. returned = if raising then instances.signatures[callee].result else callee-returns
    .. callee-returns = instances.signatures[callee].returns
. returns = layout-of(returned, syntax)
ir.depend(.callee-function, target-id, if raises then may-panic-dependency else 0u32)
. table = load(pending[mark], 0, pointer-layout, syntax)
. method = load(table, table-header-size + slot * table-slot-size, pointer-layout, syntax)
. enters = is-free(callee)
. crosses = enters != in-zone
. checked = raises && !in-landing
. closing = closing-pad(checked && crosses && enters)
if crosses
    cross-zone(syntax, enters)
. start ValueId = ir.instructions.length as ValueId
. result = call(method, syntax, mark, .callee-value, returns, checked, false, closing)
if tables.asks-inline(callee)
    ir.note(last-call(start), target-id, unit.source-module, syntax)
cross-back(syntax, enters, raising)
land-closed(closing, syntax)
= Typed(result, returned)

────────────────────
_ do cross-back
    - syntax SyntaxId
    - enters Bool
    - raising Bool

` After a call, crosses back to the zone the caller runs in where the call crossed it. A call
` that raises errors where the zone the collector never sees has to do with it, its caller's
` or its callee's, crosses back only on the path of its value, which `zone-answer` keeps for
` whoever takes the value apart: an error comes back outside the zone.
. crosses = enters != in-zone
if raising && (enters || in-zone)
    zone-answer = if !crosses then 1 else if enters then 3 else 2
else if crosses
    cross-zone(syntax, !enters)

────────────────────
_ do take-zone-answer U8

` What the call whose value is being taken apart left to do to the zone on the path of its
` value, which is cleared.
. answer = zone-answer
zone-answer = 0
= answer

────────────────────
_ do settle-zone-answer
    - id SyntaxId
    - answer U8

` On the path of the value of a call that raises errors, crosses the zone as the call left it to.
if answer == 2
    cross-zone(id, true)
else if answer == 3
    cross-zone(id, false)

────────────────────
_ do rejoin-zone
    - id SyntaxId
    - answer U8
    - zoned Bool

` Where the path of an error of such a call goes on with what follows, enters the zone again if
` the caller runs in it.
if answer != 0 && zoned
    cross-zone(id, true)

────────────────────
_ do settle-result
    - id SyntaxId
    - result Operand

` Where what may be an error is taken as it is, the paths of its value and of an error go on
` alike in the zone the caller runs in.
. answer = take-zone-answer()
if answer == 0
    =
if answer == 2
    cross-zone(id, true)
    =
. given = ir.reserve-block()
. raised = ir.reserve-block()
. joined = ir.reserve-block()
branch(case-test(id, result, 0), given, raised)
ir.start-block(given)
settle-zone-answer(id, answer)
jump(joined)
ir.start-block(raised)
if closes-zone(answer)
    close-zone(id)
rejoin-zone(id, answer, in-zone)
jump(joined)
ir.start-block(joined)

────────────────────
_ do call-function
    - callee FunctionId
    - site SyntaxId = 0

` A call of a function that takes nothing and returns nothing: a main or an init.
. target = tables.functions[callee]
. flags U32
if target.may-panic
    flags = flags /or/ may-panic-dependency
ir.depend(.callee-function, callee, flags)
. symbol = make-operand(.operand-symbol, target.symbol)
call(symbol, site, pending.length, .callee-function, void-layout, target.may-panic)

────────────────────
_ do call-runtime Operand
    - callee RuntimeFunction
    - syntax SyntaxId
    - mark Size
    - returns LayoutId = void-layout
    - records-stack Bool = false

` A call of a runtime function with the pending arguments from `mark` on. It is never
` checked: the runtime functions called here do not panic. One that may allocate from the
` collector, in a function that may not use the heap, is one typing did not plan, and is
` refused.
if (effects-here() /and/ CompilationEffect.no-heap) != 0
    . name = runtime-function-names[callee as Size]
    if may-allocate(name, safepoint-free-runtime-names.find(name) == null)
        refuse(.refused-allocation, syntax)
        drop-pending(mark)
        = make-operand(.operand-void, 0)
ir.depend(.callee-runtime, callee, 0)
. symbol = make-operand(.operand-symbol, tables.runtime-symbol(callee))
= call(symbol, syntax, mark, .callee-runtime, returns, false, records-stack)

────────────────────
_ do call Operand
    - callee Operand
    - syntax SyntaxId
    - mark Size
    - callee-kind CalleeKind
    - returns LayoutId
    - checked Bool = false
    - records-stack Bool = false
    - pad IRBlockId = no-block

` Appends a call with the pending arguments from `mark` on, and gives its value. A checked
` call ends its block: its last operand is the landing pad, or `pad` where one is given, and
` the code after it starts a new block. A call that records its caller's stack is one the
` collector reads that stack at.
. start U32 = ir.operands.length
ir.add-operand(callee)
for position in mark .. < pending.length
    ir.add-operand(pending[position])
drop-pending(mark)
. aux U32 = callee-kind
if records-stack
    aux = aux /or/ stack-map-call-flag
. resumed = no-block
if checked
    resumed = ir.reserve-block()
    . landed = pad
    if landed == no-block
        landed = landing-block(syntax)
    ir.add-operand(make-operand(.operand-block, landed))
    aux = aux /or/ checked-call-flag
. count U32 = ir.operands.length - start
. result = make-operand(.operand-void, 0)
if returns == void-layout
    append(.op-call-void, syntax, Span(start, count), aux)
else
    . made = append(.op-call, syntax, Span(start, count), aux, returns)
    result = make-operand(.operand-value, made)
if checked
    jump(resumed)
    ir.start-block(resumed)
= result

────────────────────
_ do drop-pending
    - mark Size

while pending.length > mark
    pending.pop()

────────────────────
_ do return-nothing

append(.op-return, 0, Span(), ReturnKind.return-normal)

────────────────────
_ do return-value
    - value Operand
    - syntax SyntaxId

` Returns a value: a scalar in a register, and a struct from its address. A function that
` raises errors returns it as the first case of what it returns.
if stepping && !yielding
    keep-step(finished-step, syntax)
if result-type != no-type
    return-case(0, value, syntax)
    =
if ir.returns == void-layout
    return-nothing()
    =
. start U32 = ir.operands.length
ir.add-operand(value)
append(.op-return, 0, Span(start, 1), ReturnKind.return-normal)

────────────────────
_ do return-held
    - held Operand

` Returns what a function that raises errors returns, as another function that raises the
` same gave it: its value or one of its errors.
. start U32 = ir.operands.length
ir.add-operand(held)
append(.op-return, 0, Span(start, 1), ReturnKind.return-normal)

────────────────────
_ do return-recased
    - held Operand
    - type TypeId
    - site SyntaxId
    - converts InstanceId = no-instance
    - place SyntaxId = 0

` Returns what a function that raises errors returns, as another function gave it that holds
` its value alike and raises errors of classes at or below those this one raises: each error
` is returned as the case of the nearest class above it that this function holds. Where
` `converts` is given, its value is of another type, converted as the type pass recorded for
` that function at `place`.
. layout = layout-of(type, site)
if !tables.layouts.is-union(layout) || (converts == no-instance && given-case != returned-case)
    refuse(.refused-function, site)
    =
.. given-case = tables.layouts.case-field(layout, 0).layout
.. returned-case = tables.layouts.case-field(ir.returns, 0).layout
. count = tables.layouts.rows[layout].cases.count
for index in 1 .. < count
    if error-case-of(ir.returns, tables.layouts.case-field(layout, index).type) == U32.max
        refuse(.refused-function, site)
        =
for index in 0 .. < count
    . field = tables.layouts.case-field(layout, index)
    . next = no-block
    if index + 1 != count
        . taken = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(site, held, index), taken, next)
        ir.start-block(taken)
    . target = if index == 0 then 0u32 else error-case-of(ir.returns, field.type)
    . given = take(held, field, site)
    if index == 0 && converts != no-instance
        given = convert-recorded(converts, place, .reason-return, site, Typed(given, field.type), returns-type).operand
    return-case(target, given, site)
    if next != no-block
        ir.start-block(next)

────────────────────
_ do return-case
    - index U32
    - held Operand
    - syntax SyntaxId

` Returns what a function that raises errors returns, holding one case: its value, or the
` error raised in its place. It is memory in the frame with nothing set, the number of the
` case in its first byte, and behind it what the case holds.
. layout = ir.returns
. made = frame(layout)
zero(made, layout)
store(made, 0, integer(.machine-u8, index), false, syntax)
put(made, tables.layouts.case-field(layout, index), held, syntax)
. start U32 = ir.operands.length
ir.add-operand(made)
append(.op-return, 0, Span(start, 1), ReturnKind.return-normal)

────────────────────
_ do return-zero
    - kind ReturnKind

` A return with the zero of the type the function returns: no bits set, or the empty text.
` A panic returns a struct from memory of the function's frame with no bits set, so that an
` optional a caller reads after a panic it does not check holds nothing, as in the
` reference; a return that only closes a block returns none. A function that yields has
` finished where it returns so.
if stepping
    keep-step(finished-step, 0)
. blank = make-operand(.operand-void, 0)
. is-struct = ir.returns != void-layout && tables.layouts.is-struct(ir.returns)
if is-struct && kind == .return-panic
    blank = frame(ir.returns)
    zero(blank, ir.returns)
. start U32 = ir.operands.length
. count U32
if is-struct && kind == .return-panic
    ir.add-operand(blank)
    count = 1
else if ir.returns != void-layout && !is-struct
    if returns-type == types.string-type
        ir.add-operand(make-operand(.operand-constant, ir.add-string("")))
    else
        ir.add-operand(integer(tables.layouts.kind-of(ir.returns), 0))
    count = 1
append(.op-return, 0, Span(start, count), kind)

────────────────────
_ do load-local Operand
    - local LocalId
    - syntax SyntaxId

` What a local holds. A struct is read as the address of the local's own memory: nothing is
` copied until it is stored.
. layout = ir.locals[local].layout
if tables.layouts.is-struct(layout)
    = make-operand(.operand-value, append(.op-local-address, syntax, Span(), local, layout))
= make-operand(.operand-value, append(.op-load-local, syntax, Span(), local, layout))

────────────────────
_ do store-local
    - local LocalId
    - value Operand
    - syntax SyntaxId

` Stores a value in a local. A struct is copied into the local's memory.
. layout = ir.locals[local].layout
if tables.layouts.is-struct(layout)
    copy(load-local(local, syntax), value, layout, false, syntax)
    =
. start U32 = ir.operands.length
ir.add-operand(value)
append(.op-store-local, syntax, Span(start, 1), local)

────────────────────
_ do put
    - target Operand
    - field LayoutField
    - value Operand
    - syntax SyntaxId

` Stores a value at a field of memory outside the heap. A struct is copied in.
if tables.layouts.is-struct(field.layout)
    copy(address(target, field.offset, field.layout, syntax), value, field.layout, false, syntax)
else if field.layout != void-layout
    store(target, field.offset, value, false, syntax)

────────────────────
_ do take Operand
    - source Operand
    - field LayoutField
    - syntax SyntaxId

` Reads a field of a struct: a scalar is loaded, and a struct is its address inside.
if tables.layouts.is-struct(field.layout)
    = address(source, field.offset, field.layout, syntax)
if field.layout == void-layout
    = make-operand(.operand-void, 0)
= load(source, field.offset, field.layout, syntax)

────────────────────
_ field-type TypeId
    - owner TypeId
    - position U32

` The type of the field a tuple or struct stores at a position.
|? owner == no-type || owner == invalid-type
    no-type
|? layout == no-layout || !tables.layouts.is-struct(layout)
    no-type
|? position >= tables.layouts.rows[layout].fields.count
    no-type
??
    tables.layouts.field(layout, position).type

.. layout = tables.layouts.values[owner]

────────────────────
_ do arithmetic Operand
    - syntax SyntaxId
    - op ArithmeticOp
    - left Operand
    - right Operand
    - layout LayoutId

if op == .arithmetic-multiply && is-integer(layout) && by-one
    = left
.. by-one = operand-kind(right) == .operand-number && ir.numbers[operand-payload(right)].bits == 1
. start U32 = ir.operands.length
ir.add-operand(left)
ir.add-operand(right)
= make-operand(.operand-value, append(.op-arithmetic, syntax, Span(start, 2), op, layout))

────────────────────
_ do bitwise Operand
    - syntax SyntaxId
    - op BitwiseOp
    - left Operand
    - right Operand
    - layout LayoutId

. start U32 = ir.operands.length
ir.add-operand(left)
ir.add-operand(right)
= make-operand(.operand-value, append(.op-bitwise, syntax, Span(start, 2), op, layout))

────────────────────
_ do load Operand
    - base Operand
    - offset U32
    - layout LayoutId
    - syntax SyntaxId

. start U32 = ir.operands.length
ir.add-operand(base)
= make-operand(.operand-value, append(.op-load, syntax, Span(start, 1), offset, layout))

────────────────────
_ do address Operand
    - base Operand
    - offset U32
    - layout LayoutId
    - syntax SyntaxId

` The address `offset` bytes into a base: of a struct held there, when the layout is one, or
` of a place a runtime function is given to write to.
. start U32 = ir.operands.length
ir.add-operand(base)
= make-operand(.operand-value, append(.op-address, syntax, Span(start, 1), offset, layout))

────────────────────
_ do store
    - base Operand
    - offset U32
    - value Operand
    - barrier Bool
    - syntax SyntaxId

. start U32 = ir.operands.length
ir.add-operand(base)
ir.add-operand(value)
append
    - .op-store
    - syntax
    - Span(start, 2)
    - if barrier then offset /or/ managed-store-flag else offset

────────────────────
_ do load-acquire Operand
    - base Operand
    - offset U32
    - layout LayoutId
    - syntax SyntaxId

` Reads the state of a lazy property or global, after which its value reads as it was stored
` before the state that reads as ready (`store-release`).
. start U32 = ir.operands.length
ir.add-operand(base)
= make-operand(.operand-value, append(.op-load-acquire, syntax, Span(start, 1), offset, layout))

────────────────────
_ do store-release
    - base Operand
    - offset U32
    - value Operand
    - syntax SyntaxId

` Marks a lazy property or global as having its value once the value is stored, so that a read
` of the state as ready on another thread (`load-acquire`) reads the value too.
. start U32 = ir.operands.length
ir.add-operand(base)
ir.add-operand(value)
append(.op-store-release, syntax, Span(start, 2), offset)

────────────────────
_ do copy
    - target Operand
    - source Operand
    - layout LayoutId
    - barrier Bool
    - syntax SyntaxId

` Copies a struct. A copy into an object goes through the write barrier for the managed
` pointers it writes.
. start U32 = ir.operands.length
ir.add-operand(target)
ir.add-operand(source)
append(.op-copy, syntax, Span(start, 2), if barrier then layout /or/ managed-store-flag else layout)

────────────────────
_ do zero
    - target Operand
    - layout LayoutId

. start U32 = ir.operands.length
ir.add-operand(target)
append(.op-zero, 0, Span(start, 1), layout)

────────────────────
_ do frame Operand
    - layout LayoutId

` Memory in the function's frame for a struct, and its address.
= make-operand(.operand-value, append(.op-frame, 0, Span(), layout, layout))

────────────────────
_ do branch
    - condition Operand
    - then-block IRBlockId
    - else-block IRBlockId

. start U32 = ir.operands.length
ir.add-operand(condition)
ir.add-operand(make-operand(.operand-block, then-block))
ir.add-operand(make-operand(.operand-block, else-block))
append(.op-branch, 0, Span(start, 3), 0)

────────────────────
_ do switch
    - condition Operand
    - fallback IRBlockId
    - values [U64]
    - blocks [IRBlockId]

. layout = ir.operand-layout(condition)
. start U32 = ir.operands.length
ir.add-operand(condition)
ir.add-operand(make-operand(.operand-block, fallback))
for position in 0 .. < values.length
    ir.add-operand(integer(layout as MachineKind, values[position]))
    ir.add-operand(make-operand(.operand-block, blocks[position]))
append(.op-switch, 0, Span(start, ir.operands.length - start), 0)

────────────────────
_ do jump
    - target IRBlockId

. start U32 = ir.operands.length
ir.add-operand(make-operand(.operand-block, target))
append(.op-jump, 0, Span(start, 1), 0)

────────────────────
_ do phi Operand
    - layout LayoutId
    - first Operand
    - first-block IRBlockId
    - second Operand
    - second-block IRBlockId

` The value two blocks join on: each value with the block it arrives from.
. start U32 = ir.operands.length
ir.add-operand(first)
ir.add-operand(make-operand(.operand-block, first-block))
ir.add-operand(second)
ir.add-operand(make-operand(.operand-block, second-block))
= make-operand(.operand-value, append(.op-phi, 0, Span(start, 4), 0, layout))

────────────────────
_ do append ValueId
    - op IROp
    - syntax SyntaxId
    - operands Span
    - aux U32
    - layout LayoutId = void-layout

` Adds an instruction to the function. A value with no bits may be given to a call, which
` passes nothing for it. Any other instruction that reads one, or a load of one, has no shape:
` nothing holds such a value, so the function is refused.
. is-call = op == .op-call || op == .op-call-void
for position in operands.start .. < operands.end
    if !is-call && ir.operand-layout(ir.operands[position]) == void-layout
        refuse(.refused-type, syntax)
if op == .op-load && layout == void-layout
    refuse(.refused-type, syntax)
. line U32
. column U32
. home = if function.site-module == U32.max then function.module else function.site-module
if syntax != 0 && (unit.source-module == home || placing)
    . begin = tree.nodes[syntax].loc.begin
    line = begin.line + 1 + line-shift + (if syntax == lowered then 1 else 0)
    column = begin.column + 1
. placed = if unit.source-module != home then unit.source-module else U32.max
= ir.append
    - IRInstruction(op, ir.current, layout, no-type, syntax, line, column, operands, aux, placed)

━━━━━━━━━━━━━━━━━━━━
_ is-made Bool
    - bits CPointer'U64
    - bit U32

(bits[bit / 64] /and/ (1u64 /lshift/ (bit % 64))) != 0

━━━━━━━━━━━━━━━━━━━━
_ do mark-made
    - bits CPointer'U64
    - bit U32

bits[bit / 64] = bits[bit / 64] /or/ (1u64 /lshift/ (bit % 64))

━━━━━━━━━━━━━━━━━━━━
_ do join-made Bool
    - known CPointer'U64
    - start U32
    - made CPointer'U64
    - words U32
    - fresh Bool

` Narrows what is known to be made where a block starts to what is also made on one more
` way in, or takes that whole for the first way found. Says whether anything changed.
. changed = fresh
for word in 0 .. < words
    . joined = if fresh then made[word] else known[start + word] /and/ made[word]
    if joined != known[start + word]
        changed = true
    known[start + word] = joined
= changed

━━━━━━━━━━━━━━━━━━━━
_ widened U64
    - bits U64
    - width U32
    - signed Bool

|? width >= 64
    bits
|? signed && (low /and/ (1u64 /lshift/ (width - 1))) != 0
    low /or/ (0 - (1u64 /lshift/ width))
??
    low

.. low = bits /and/ ((1u64 /lshift/ width) - 1)
