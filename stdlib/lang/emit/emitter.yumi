    store(capture, tables.layouts.field(layout, 0).offset, written-environment(id), true, id)
. captured = bindings.nested[tables.capture-rows[callee]].captures
for index in 0 .. < captured.count
    . slot = bindings.captures[captured.start + index].slot
    if !tables.copies(callee, slot)
