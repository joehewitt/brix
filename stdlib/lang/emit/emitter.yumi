. answers = layout-of(row.yields, declared)
. place = tables.layouts.rows[managed-layout].size
. code = load(unit.self, 0, pointer-layout, declared)
. data = load(unit.self, tables.layouts.field(layout, 1).offset, managed-layout, declared)
. step = load(data, place, i32-layout, declared)
