+ joins [Operand]
+ given [Typed]
+ element-given [Typed]
+ element-filled [U32]
+ setter-given [Typed]
+ rule-givens [RuleValue]
+ rule-names [RuleName]
+ around-values [AroundValue]
+ taken-values [TakenValues]
+ recordings [RecordedLocal]
+ style-conditions [StyleCondition]
+ site-gates [StyleGate]
+ state-cells [StateCell]
+ content-hosts [Typed]
+ content-roots [Operand]
+ built [SyntaxId]
+ coded [SyntaxId]
+ inlining [SyntaxId]
+ adapted [SyntaxId]
+ open-turns [TurnScope]
+ rebindings [Rebinding]
+ loops [EmittedLoop]
+ open-cleanups [OpenCleanup]
+ stack-bindings [StackBinding]
+ use-flags [LocalId]
+ pads [LandingPad]
