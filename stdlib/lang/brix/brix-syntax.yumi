./build
./grammar
./parse
/code/structure/rows
/core/table
/data/source-tree
/stream/aggregate

_ brix-keywords List
    * "if"
    * "else"
    * "while"
    * "for"
    * "in"
    * "on"
    * "do"
    * "match"
    * "is"
    * "as"
    * "has"
    * "not"
    * "and"
    * "or"
    * "use"
    * "catch"
    * "with"
    * "by"
    * "of"
    * "to"
    * "from"
    * "into"
    * "when"
    * "whenever"
    * "until"
    * "new"
    * "static"
    * "get"
    * "extend"
    * "event"
    * "keyed"
    * "throws"
    * "break"
    * "continue"
    * "true"
    * "false"
    * "this"
    * "This"
    * "using"
    * "each"
    * "then"
    * "finally"
    * "where"

_ brix-sigils List
    * "#"
    * "@"
    * "\$"
    * "%"
    * "&"
    * "!"
    * "."

━━━━━━━━━━━━━━━━━━━━
+ brix-highlight [SourceSpan]
    - text String

match text
    ~ spans \brix-highlight-grammar(text, false)
        brix-joined(List(spans))
    ?? List'SourceSpan(SourceSpan(.plain, text))

━━━━━━━━━━━━━━━━━━━━
+ brix-highlight-line [SourceSpan]
    - text String

match text
    ~ spans \brix-highlight-grammar(text, true)
        brix-joined(List(spans))
    ?? List'SourceSpan(SourceSpan(.string, text))

━━━━━━━━━━━━━━━━━━━━
+ do brix-joined [SourceSpan]
    - spans [SourceSpan]

. result [SourceSpan]
result ++= spans
. is-joined [Bool]
for span in result
    is-joined += false
. index = result.length - 1
while index > 0
    index -= 1
    . sigil = result[index].text
    . next = result[index + 1]
    if brix-sigils has sigil && (is-joined[index + 1] || brix-starts-name(next.text)) && brix-is-prefix(result, index)
        . kind = if sigil == "#" then SourceSpanKind.tracked else next.kind
        result[index] = SourceSpan(kind, sigil)
        result[index + 1] = SourceSpan(kind, next.text, next.is-optional)
        is-joined[index] = true
for at in 0 .. < result.length
    if brix-is-optional(result, at)
        . span = result[at]
        result[at] = SourceSpan(span.kind, span.text, true)
= result

━━━━━━━━━━━━━━━━━━━━
_ do brix-is-optional Bool
    - spans [SourceSpan]
    - index Index

. span = spans[index]
. before = if index > 0 then spans[index - 1] else SourceSpan(.plain, "")
. next = if index + 1 < spans.length then spans[index + 1].text else ""
=? span.kind == SourceSpanKind.identifier if span.text == "null"
=? before.kind == SourceSpanKind.type-name || next == "." || next == "[" if span.text == "?"
=? before.text == "?" if span.text == "."
=? brix-is-chain(spans, index + 1) || (next == "?" && span.kind == SourceSpanKind.type-name) if brix-starts-name(span.text)
= false

━━━━━━━━━━━━━━━━━━━━
_ brix-is-chain Bool
    - spans [SourceSpan]
    - index Index

index < spans.length && spans[index].text == "?" && index + 1 < spans.length && (spans[index + 1].text == "." || spans[index + 1].text == "[")

━━━━━━━━━━━━━━━━━━━━
_ brix-starts-name Bool
    - text String

text.length > 0 && ((first >= 'a' && first <= 'z') || (first >= 'A' && first <= 'Z'))

.. first = text[0]

━━━━━━━━━━━━━━━━━━━━
_ do brix-is-prefix Bool
    - spans [SourceSpan]
    - index Index

=? true if index == 0
. before = spans[index - 1].text
=? true if before.length == 0
. last = before[before.length - 1]
=? false if brix-starts-name("$last") || (last >= '0' && last <= '9')
=? false if last == ')' || last == ']' || last == '}' || last == '"' || last == '\'' || last == '_'
= spans[index].text != "." || !(last == '?' || last == '!' || last == '*')

━━━━━━━━━━━━━━━━━━━━
+ do brix-highlight-head [SourceSpan]
    - text String

. spans [SourceSpan]
. is-named = false
for span in brix-highlight(text)
    . is-word = span.kind == SourceSpanKind.identifier || span.kind == SourceSpanKind.type-name
    if is-word && !is-named
        spans += SourceSpan(if span.kind == SourceSpanKind.type-name then SourceSpanKind.type-definition else SourceSpanKind.definition, span.text)
        is-named = true
    else
        spans += span
= spans

━━━━━━━━━━━━━━━━━━━━
_ brix-highlight-grammar ~ Char ImmutableArray'SourceSpan
    - source String
    - is-text Bool

~ &\{ is-text } (...spans \text-run | \text-name(into spans) | \text-code(into spans))* !.
    spans
~ (...spans \space)? (\row-pattern(into spans))? (\code-item(into spans) | \stray(into spans))* !.
    spans

.. text-name Bool ~
    ~ &("$" [a-z]) ...spans \text-mark ...spans \text-word
        true

.. text-code Bool ~
    ~ &"\${" ...spans \text-mark (\code-item(into spans) | (!"}" \stray(into spans)))* (&"}" ...spans \text-mark)?
        true

.. code-item Bool ~
    ~ ...spans \space (\pattern(into spans))?
        true
    ~ ...spans \joined (...spans \tick)?
        true
    ~ ...spans \opener (\pattern(into spans))? (\code-item(into spans))* (\stray(into spans))?
        true
    ~ ...spans \loose
        true

.. stray Bool ~
    ~ ...spans \closer (...spans \tick)?
        true

.. row-pattern Bool ~
    ~ \pattern(into spans) ((\stray(into spans) | (&"," ...spans \loose)) (\pattern-item(into spans))*)*
        true

.. pattern Bool ~
    ~ &"~ " ...spans \loose (\pattern-item(into spans))*
        true

.. pattern-item Bool ~
    ~ ...spans \space
        true
    ~ ...spans \pattern-word (...spans \tick)?
        true
    ~ &"\\{" ...spans \pattern-leaf \pattern-code(into spans)
        true
    ~ ...spans \rule-name (...spans \tick (...spans \joined)?)* (\pattern-arguments(into spans))?
        true
    ~ &"$" ...spans \pattern-leaf (...spans \joined)?
        true
    ~ &"(" ...spans \opener (\pattern-item(into spans))* (\stray(into spans))?
        true
    ~ \pattern-code(into spans)
        true
    ~ ...spans \pattern-leaf
        true

.. pattern-arguments Bool ~
    ~ &"(" ...spans \opener (\pattern-argument(into spans))? (&"," ...spans \loose (\pattern-argument(into spans))?)* (\stray(into spans))?
        true

.. pattern-argument Bool ~
    ~ (...spans \space)? (\pattern(into spans) | \collector(into spans))? (!"," \code-item(into spans))*
        true

.. collector Bool ~
    ~ &"into " ...spans \joined (\pattern-item(into spans))*
        true

.. pattern-code Bool ~
    ~ &"{" ...spans \opener (\code-item(into spans))* (\stray(into spans))?
        true

.. space SourceSpan ~
    ~ " "+
        brix-span(source, location, .plain)

.. joined SourceSpan ~
    ~ \numeral
        brix-span(source, location, .number)
    ~ \word
        brix-word-span(source, location, .identifier)

.. tick SourceSpan ~
    ~ "'"
        brix-span(source, location, .punctuation)

.. opener SourceSpan ~
    ~ "(" | "[" | "{"
        brix-span(source, location, .punctuation)

.. closer SourceSpan ~
    ~ ")" | "]" | "}"
        brix-span(source, location, .punctuation)

.. loose SourceSpan ~
    ~ \comment
        brix-span(source, location, .comment)
    ~ \quoted
        brix-span(source, location, .string)
    ~ \character
        brix-span(source, location, .string)
    ~ "," | "." | ":" | "'"
        brix-span(source, location, .punctuation)
    ~ \symbol
        brix-span(source, location, .operator)

.. pattern-word SourceSpan ~
    ~ !(("in" | "on") ![a-zA-Z0-9_-]) \word
        brix-word-span(source, location, .capture)

.. rule-name SourceSpan ~
    ~ "\\" \word?
        brix-span(source, location, .rule)

.. pattern-leaf SourceSpan ~
    ~ \quoted
        brix-span(source, location, .string)
    ~ \character
        brix-span(source, location, .string)
    ~ \class
        brix-span(source, location, .string)
    ~ \numeral
        brix-span(source, location, .number)
    ~ "//" | "/"
        brix-span(source, location, .keyword)
    ~ "..."
        brix-span(source, location, .operator)
    ~ ![a-zA-Z)},=@`╌\u005D] .
        brix-span(source, location, .operator)

.. text-run SourceSpan ~
    ~ (("\\" .) | (!("\${" | ("$" [a-z])) .))+
        brix-span(source, location, .string)

.. text-mark SourceSpan ~
    ~ "\${" | "$" | "}"
        brix-span(source, location, .operator)

.. text-word SourceSpan ~
    ~ \word
        brix-span(source, location, .identifier)

.. comment ~
    ~ ("`" | "╌") .*

.. quoted Bool ~
    ~ "\"" (("\\" .) | \embedded | (!"\"" .))* "\""?
        true

.. embedded Bool ~
    ~ "\${" (("\\" .) | \embedded | \quoted | (!"}" .))* "}"?
        true

.. character ~
    ~ "'" "\\" . (!("'" | " ") .){0, 8} "'"
    ~ "'" !"\\" . (!("'" | " ") .){0, 9} "'"

.. numeral ~
    ~ [0-9] ([a-zA-Z0-9_] | \wide | ([-.'] [0-9]))*

.. word ~
    ~ ([a-zA-Z_] | \wide) ([a-zA-Z0-9_] | \wide | ("-" ([a-zA-Z0-9_] | \wide)))*

.. wide ~
    ~ ![\u0000-~] ![•¶→…═─━╌«»] .

.. class ~
    ~ "[" (!"]" .)* "]"?

.. symbol ~
    ~ ![)}\u005D] . [-+*/%<>!=?|&~^]*

━━━━━━━━━━━━━━━━━━━━
_ brix-span SourceSpan
    - source String
    - location MatchLocation
    - kind SourceSpanKind

SourceSpan(kind, source[location.begin.column .. < location.end.column + 1])

━━━━━━━━━━━━━━━━━━━━
_ brix-word-span SourceSpan
    - source String
    - location MatchLocation
    - named SourceSpanKind

SourceSpan(kind, text)

.. text = source[location.begin.column .. < location.end.column + 1]
.. word-kind = brix-word-kind(text)
.. kind = if word-kind == SourceSpanKind.identifier then named else word-kind

━━━━━━━━━━━━━━━━━━━━
_ brix-word-kind SourceSpanKind
    - text String

|? text == "_"
    SourceSpanKind.operator
|? brix-keywords has text
    SourceSpanKind.keyword
|? text[0] >= 'A' && text[0] <= 'Z'
    SourceSpanKind.type-name
??
    SourceSpanKind.identifier

━━━━━━━━━━━━━━━━━━━━
+ do brix-parse-text ImmutableTableRow'SourceNode
    - text String
    - store SourceStore

=? store.blank() if text.length == 0
. made = brix-parse-prose(text, store)
=? store.item(made, 1) if made && store.is-form(made, "paragraph") && store.count(made) == 2
= store.string(text)

━━━━━━━━━━━━━━━━━━━━
+ do brix-is-import Bool
    - text String

=? false if !(text.starts-with("/") || text.starts-with("./") || text.starts-with("../"))
= all(text.codepoints) • where each != ' ' && each != '(' && each != '"'

━━━━━━━━━━━━━━━━━━━━
+ do brix-parse-statement ImmutableTableRow'SourceNode?
    - text String
    - store SourceStore
    - scope BrixEntry

. body = brix-trimmed(text)
=? store.blank() if body.length == 0
if body.starts-with("`")
    . note = body[1 ...]
    = store.comment(if note.starts-with(" ") then note[1 ...] else note)
=? store.comment(body) if body.starts-with("╌")
. parsed = brix-parse-row(body, store, scope)
=? null if !parsed
= brix-prune(store, parsed)

━━━━━━━━━━━━━━━━━━━━
+ do brix-parse-declaration ImmutableTableRow'SourceNode?
    - text String
    - store SourceStore

= brix-parse-row(brix-trimmed(text), store, BrixEntry.head-row)

━━━━━━━━━━━━━━━━━━━━
+ do brix-parse-line ImmutableTableRow'SourceNode?
    - text String
    - store SourceStore

= brix-parse-row(brix-trimmed(text), store, BrixEntry.header-row)

━━━━━━━━━━━━━━━━━━━━
+ do brix-trimmed String
    - text String

. chars = text.codepoints
. start Index = 0
while start < chars.length && chars[start] == ' '
    start += 1
. last = chars.length
while last > start && chars[last - 1] == ' '
    last -= 1
= text[start .. < last]

━━━━━━━━━━━━━━━━━━━━
+ brix-takes-block Bool
    - store SourceStore
    - node ImmutableTableRow'SourceNode

is-keyword || heads has head || probes has head

.. head = store.head(node) ?? ""
.. is-keyword = head.starts-with(":") && !head.ends-with(":") && head.length > 1
.. heads = ["prop", "entry", "entry?", "return"]
.. probes = ["probe", "probe-log", "probe-count", "probe-group", "probe-assign"]

━━━━━━━━━━━━━━━━━━━━
+ do brix-prune ImmutableTableRow'SourceNode
    - store SourceStore
    - node ImmutableTableRow'SourceNode
    - is-bare Bool = false

. count = store.count(node)
=? node if count == 0
=? store.with-id(store.item(node, 1), node.id) if store.is-form(node, "scope") && count == 2
. last = store.item(node, count - 1)
. is-binding = store.is-form(node, "let") || store.is-form(node, "lazy")
if !(store.is-form(last, "block") && store.count(last) == 1)
    . next = brix-prune(store, last, is-bare)
    =? node if next.index == last.index
    . pruned = store.appended(store.trimmed(node, count - 1), next)
    . is-named = is-binding && count == 3 && store.is-atom(store.item(node, 1))
    . becomes-type = brix-is-type-form(store, next) && !brix-is-type-form(store, last)
    = if is-named && becomes-type then store.inserted(pruned, 2, store.atom("_")) else pruned
=? node if count < 2
=? store.trimmed(node, 2) if is-binding && count == 3
=? store.trimmed(node, count - 1) if brix-takes-block(store, node)
=? node if !store.is-form(node, "call")
=? store.with-id(store.item(node, 1), node.id) if count == 3 && is-bare
= store.trimmed(node, count - 1)
