/core/_bytes
/core/parsing
/core/table
/data/source-tree
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ BrixSpans

_ base U32
_ entries [BrixSpan]

────────────────────
+ This
    - store SourceStore

.. base = store.latest-id

────────────────────
+ start Index
    - node ImmutableTableRow'SourceNode

if slot != null then entries[slot].start else 0

.. slot = find(node)

────────────────────
+ end Index
    - node ImmutableTableRow'SourceNode

if slot != null then entries[slot].end else 0

.. slot = find(node)

────────────────────
+ do set
    - node ImmutableTableRow'SourceNode
    - start Index
    - end Index

. id = node.id
=? if id <= base
. slot = (id - base - 1) as Index
while entries.length < slot
    entries += BrixSpan(0, 0)
if slot == entries.length
    entries += BrixSpan(start, end)
else
    entries[slot] = BrixSpan(start, end)

────────────────────
+ do extend
    - node ImmutableTableRow'SourceNode
    - end Index

set(node, start(node), end)

────────────────────
_ find Index?
    - node ImmutableTableRow'SourceNode

|? id <= base
    null
|? slot >= entries.length
    null
??
    slot

.. id = node.id
.. slot = (id - base - 1) as Index

━━━━━━━━━━━━━━━━━━━━
+ BrixBuilder

+ store SourceStore

_ spans BrixSpans?

────────────────────
+ This
    - store
    - spans = null

────────────────────
+ do place ImmutableTableRow'SourceNode
    - location MatchLocation
    - node ImmutableTableRow'SourceNode

span(node, (location.begin.line as Index) + 1, (location.end.line as Index) + 1)
= node

────────────────────
+ do atom ImmutableTableRow'SourceNode
    - location MatchLocation
    - text String

= place(location, store.atom(text))

────────────────────
+ do text ImmutableTableRow'SourceNode
    - location MatchLocation
    - value String

= place(location, store.string(value))

────────────────────
+ do splice ImmutableTableRow'SourceNode
    - items [ImmutableTableRow'SourceNode]

= store.group(0, items)

────────────────────
+ do add
    - items [ImmutableTableRow'SourceNode]
    - node ImmutableTableRow'SourceNode?

=? if !node
if is-spliced(node)
    for part in store.items(node)
        add(items, part)
else
    items += node

────────────────────
+ do many ImmutableTableRow'SourceNode
    - nodes ImmutableArray'(ImmutableTableRow'SourceNode)?

. items [ImmutableTableRow'SourceNode]
. present = nodes ?? ImmutableArray'(ImmutableTableRow'SourceNode)()
for node in present
    add(items, node)
= splice(items)

────────────────────
+ do some ImmutableTableRow'SourceNode
    - nodes ImmutableArray'(ImmutableTableRow'SourceNode?)

. items [ImmutableTableRow'SourceNode]
for node in nodes
    add(items, node)
= splice(items)

────────────────────
+ do seq ImmutableTableRow'SourceNode
    - a ImmutableTableRow'SourceNode? = null
    - b ImmutableTableRow'SourceNode? = null
    - c ImmutableTableRow'SourceNode? = null
    - d ImmutableTableRow'SourceNode? = null
    - e ImmutableTableRow'SourceNode? = null
    - f ImmutableTableRow'SourceNode? = null

. items [ImmutableTableRow'SourceNode]
add(items, a)
add(items, b)
add(items, c)
add(items, d)
add(items, e)
add(items, f)
= splice(items)

────────────────────
+ only ImmutableTableRow'SourceNode?
    - node ImmutableTableRow'SourceNode

|? !is-spliced(node)
    node
|? store.count(node) != 1
    null
??
    only(store.item(node, 0))

────────────────────
+ count Size
    - node ImmutableTableRow'SourceNode?

|? !node
    0
|? is-spliced(node)
    store.count(node)
??
    1

────────────────────
+ do form ImmutableTableRow'SourceNode
    - location MatchLocation
    - head String
    - a ImmutableTableRow'SourceNode? = null
    - b ImmutableTableRow'SourceNode? = null
    - c ImmutableTableRow'SourceNode? = null
    - d ImmutableTableRow'SourceNode? = null
    - e ImmutableTableRow'SourceNode? = null
    - f ImmutableTableRow'SourceNode? = null
    - g ImmutableTableRow'SourceNode? = null
    - h ImmutableTableRow'SourceNode? = null

. first = count(a) + count(b) + count(c) + count(d)
. items [ImmutableTableRow'SourceNode]
items.reserve(1 + first + count(e) + count(f) + count(g) + count(h))
items += store.atom(head)
add(items, a)
add(items, b)
add(items, c)
add(items, d)
add(items, e)
add(items, f)
add(items, g)
add(items, h)
= place(location, store.list(items))

────────────────────
+ do group ImmutableTableRow'SourceNode
    - location MatchLocation
    - a ImmutableTableRow'SourceNode? = null
    - b ImmutableTableRow'SourceNode? = null

. items [ImmutableTableRow'SourceNode]
add(items, a)
add(items, b)
= place(location, store.list(items))

────────────────────
+ do blank-slot ImmutableTableRow'SourceNode
    - location MatchLocation
    - node ImmutableTableRow'SourceNode?

= node ?? atom(location, "_")

────────────────────
+ do flag ImmutableTableRow'SourceNode?
    - location MatchLocation
    - name String
    - is-set Bool

=? null if !is-set
= atom(location, name)

────────────────────
+ do pair ImmutableTableRow'SourceNode
    - location MatchLocation
    - op String
    - right ImmutableTableRow'SourceNode
    - helper ImmutableTableRow'SourceNode? = null

. items [ImmutableTableRow'SourceNode]
items += mark(op)
items += right
add(items, helper)
= place(location, store.list(items))

────────────────────
+ do chain ImmutableTableRow'SourceNode
    - location MatchLocation
    - left ImmutableTableRow'SourceNode
    - tails ImmutableArray'(ImmutableTableRow'SourceNode)

. result = left
. previous = ""
for tail in tails
    . op = store.text(store.item(tail, 0))
    . items [ImmutableTableRow'SourceNode]
    if op == previous
        items ++= store.listed(result)
    else
        items += store.atom(op)
        items += result
    for item in store.listed(tail, 1)
        add(items, item)
    result = place(location, store.list(items))
    previous = op
= result

────────────────────
+ do prefixed ImmutableTableRow'SourceNode
    - location MatchLocation
    - ops ImmutableArray'String
    - operand ImmutableTableRow'SourceNode

. result = operand
. index = ops.length
while index > 0
    index -= 1
    . op = ops[index]
    if op == "-" && store.is-atom(result) && brix-is-number(store.text(result))
        result = atom(location, "-${store.text(result)}")
    else
        result = form(location, op, result)
= result

────────────────────
+ do suffixed ImmutableTableRow'SourceNode
    - location MatchLocation
    - node ImmutableTableRow'SourceNode
    - suffix String?

=? node if !suffix
= match suffix
    |= "?"
        form(location, "?", node)
    |= "[]?"
        form(location, "?", form(location, "[]", node))
    |= "[]"
        form(location, "[]", node)
    ??
        form(location, "channel", node)

────────────────────
+ do applied ImmutableTableRow'SourceNode
    - location MatchLocation
    - node ImmutableTableRow'SourceNode
    - params ImmutableTableRow'SourceNode?

=? node if count(params) == 0
= form(location, "of", node, params)

────────────────────
+ is-call Bool
    - node ImmutableTableRow'SourceNode

store.is-form(node, "call") && !is-part(node)

────────────────────
+ do call ImmutableTableRow'SourceNode
    - location MatchLocation
    - callee ImmutableTableRow'SourceNode
    - params ImmutableTableRow'SourceNode? = null
    - args ImmutableTableRow'SourceNode? = null

. items = List'(ImmutableTableRow'SourceNode)(store.atom("call"), applied(location, callee, params))
add(items, args)
= place(location, store.list(items))

────────────────────
+ do auto-call ImmutableTableRow'SourceNode
    - location MatchLocation
    - target ImmutableTableRow'SourceNode
    - params ImmutableTableRow'SourceNode? = null
    - args ImmutableTableRow'SourceNode? = null

=? target if count(params) == 0 && count(args) == 0
if count(params) == 0 && is-call(target)
    . items = store.listed(target)
    add(items, args)
    = place(location, store.list(items))
. rows = only(args) if args != null && count(params) == 0
=? form(location, "scope", target, body(rows)) if rows != null && brix-is-scope(store, rows)
= call(location, target, params, args)

────────────────────
+ do member ImmutableTableRow'SourceNode
    - location MatchLocation
    - left ImmutableTableRow'SourceNode
    - op String
    - name ImmutableTableRow'SourceNode

=? form(location, op, left, name) if op != "." || !store.is-form(left, ".") || is-part(left)
. items = store.listed(left)
items += name
= place(location, store.list(items))

────────────────────
+ do named ImmutableTableRow'SourceNode
    - location MatchLocation
    - name String
    - is-optional Bool
    - value ImmutableTableRow'SourceNode? = null

= form(location, ":$name${if is-optional then "?" else ""}", value)

────────────────────
+ do body ImmutableTableRow'SourceNode?
    - node ImmutableTableRow'SourceNode?

=? null if !node
=? node if !store.is-form(node, "block")
= splice(store.listed(node, 1))

────────────────────
+ do inline-body ImmutableTableRow'SourceNode
    - location MatchLocation
    - node ImmutableTableRow'SourceNode

=? seq(body(node)) if store.is-form(node, "block") || store.is-form(node, "inline")
= form(location, "inline", node)

────────────────────
+ do rehead ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - head String

. parts = store.items(node)
if is-spliced(node) && parts.length > 0
    . spread = List'(ImmutableTableRow'SourceNode)(rehead(parts[0], head))
    for index in 1 .. < parts.length
        spread += parts[index]
    = splice(spread)
. items = List'(ImmutableTableRow'SourceNode)(store.atom(head))
for index in 1 .. < parts.length
    items += parts[index]
. next = store.list(items)
span(next, start-of(node), end-of(node))
= next

────────────────────
+ do wrap ImmutableTableRow'SourceNode?
    - location MatchLocation
    - head String
    - node ImmutableTableRow'SourceNode?

=? null if !node
= form(location, head, node)

────────────────────
+ do under ImmutableTableRow'SourceNode
    - location MatchLocation
    - node ImmutableTableRow'SourceNode
    - head String?

=? node if !head
= form(location, head, node)

────────────────────
+ do joined ImmutableTableRow'SourceNode
    - location MatchLocation
    - head String
    - first ImmutableTableRow'SourceNode
    - rest ImmutableArray'(ImmutableTableRow'SourceNode)?

. present = rest ?? ImmutableArray'(ImmutableTableRow'SourceNode)()
=? first if present.length == 0
= form(location, head, first, many(present))

────────────────────
+ do loop ImmutableTableRow'SourceNode
    - location MatchLocation
    - clauses ImmutableTableRow'SourceNode
    - block ImmutableTableRow'SourceNode?

=? form(location, "for", clauses, body(block)) if !store.is-form(clauses, "and-for")
. made [ImmutableTableRow'SourceNode]
. parts = store.listed(clauses)
. last = parts.length - 1
for index in 1 .. < parts.length
    . clause = parts[index]
    . items = List'(ImmutableTableRow'SourceNode)
        - store.atom(if index == 1 then "for" else "and-for")
        - clause
    if index == last
        add(items, body(block))
    . next = store.list(items)
    . end = if index == last then (location.end.line as Index) + 1 else end-of(clause)
    span(next, start-of(clause), end)
    made += next
= splice(made)

────────────────────
+ do arms ImmutableTableRow'SourceNode
    - clauses ImmutableTableRow'SourceNode

=? clauses if !store.is-form(clauses, "and-for")
. parts = store.listed(clauses)
. made = List'(ImmutableTableRow'SourceNode)(parts[1])
for index in 2 .. < parts.length
    . clause = parts[index]
    . next = store.list(List'(ImmutableTableRow'SourceNode)(store.atom("and-for"), clause))
    span(next, start-of(clause), end-of(clause))
    made += next
= splice(made)

────────────────────
+ do armed ImmutableTableRow'SourceNode
    - location MatchLocation
    - head ImmutableTableRow'SourceNode
    - arms ImmutableTableRow'SourceNode? = null

. parts [ImmutableTableRow'SourceNode]
add(parts, head)
add(parts, arms)
=? parts[0] if parts.length == 1
. items = store.listed(parts[0])
for index in 1 .. < parts.length
    items += parts[index]
= place(location, store.list(items))

────────────────────
+ do bracket ImmutableTableRow'SourceNode
    - location MatchLocation
    - items ImmutableTableRow'SourceNode

. first = store.item(items, 0) if store.count(items) == 1
=? form(location, "list", items) if !first || !store.is-form(first, "=") || store.count(first) != 3
= form(location, "map", store.item(first, 1), store.item(first, 2))

────────────────────
+ do tuple ImmutableTableRow'SourceNode
    - location MatchLocation
    - values ImmutableArray'(ImmutableTableRow'SourceNode)

=? values[0] if values.length == 1
= form(location, "tuple", many(values))

────────────────────
+ do invoke ImmutableTableRow'SourceNode
    - location MatchLocation
    - callee ImmutableTableRow'SourceNode
    - args ImmutableTableRow'SourceNode?

=? callee if !args
= call(location, callee, null, args)

────────────────────
+ do caught ImmutableTableRow'SourceNode
    - location MatchLocation
    - previous ImmutableTableRow'SourceNode
    - capture ImmutableTableRow'SourceNode?

=? blank-slot(location, capture) if count(previous) == 0
= form(location, "caught", blank-slot(location, capture), previous)

────────────────────
+ do function-head String
    - is-imperative Bool
    - key ImmutableTableRow'SourceNode

=? brix-callable-head(store, key, is-imperative) if !is-spliced(key)
for item in store.items(key)
    =? (if is-imperative then "fn-do" else "fn-expr") if store.is-form(item, "over:")
= brix-callable-head(store, store.item(key, 0), is-imperative)

────────────────────
+ do declared ImmutableTableRow'SourceNode
    - location MatchLocation
    - word String
    - left ImmutableTableRow'SourceNode
    - right ImmutableTableRow'SourceNode? = null

. parts = store.items(left)
. is-typed = store.is-form(left, ":") && parts.length == 3 && store.is-atom(parts[1]) && !brix-is-pattern-form(store, parts[2])
=? form(location, word, parts[1], parts[2], right) if is-typed && (right != null || brix-is-type-form(store, parts[2]))
=? form(location, word, left, atom(location, "_"), right) if right && store.is-atom(left) && brix-is-type-form(store, right)
= form(location, word, left, right)

────────────────────
+ do capture ImmutableTableRow'SourceNode
    - location MatchLocation
    - id ImmutableTableRow'SourceNode
    - type ImmutableTableRow'SourceNode?
    - prefix String = ""

. named = id
if prefix.length > 0
    named = atom(location, "$prefix${store.text(id)}")
=? named if !type
= form(location, ":", named, type)

────────────────────
+ do case-pattern ImmutableTableRow'SourceNode
    - location MatchLocation
    - name String
    - owner ImmutableTableRow'SourceNode? = null
    - value ImmutableTableRow'SourceNode? = null

. callee = atom(location, ".$name")
if owner
    callee = form(location, ".", owner, atom(location, name))
=? callee if !value
. items = List'(ImmutableTableRow'SourceNode)(store.atom("call"), callee)
if store.is-form(value, "tuple")
    items ++= store.listed(value, 1)
else
    items += value
= place(location, store.list(items))

────────────────────
+ do param ImmutableTableRow'SourceNode
    - location MatchLocation
    - parts ImmutableTableRow'SourceNode
    - marker ImmutableTableRow'SourceNode? = null

. items = List'(ImmutableTableRow'SourceNode)(store.atom("param"))
add(items, marker)
add(items, parts)
= place(location, store.list(items))

────────────────────
+ do partial ImmutableTableRow'SourceNode
    - location MatchLocation
    - params ImmutableTableRow'SourceNode? = null
    - args ImmutableTableRow'SourceNode? = null
    - is-bare Bool = false

. items = List'(ImmutableTableRow'SourceNode)(params ?? seq(), args ?? seq())
if is-bare
    items += store.atom("bare")
= place(location, store.list(items))

────────────────────
+ do completed ImmutableTableRow'SourceNode
    - location MatchLocation
    - left ImmutableTableRow'SourceNode
    - right ImmutableTableRow'SourceNode?

=? left if !right
=? auto-call(location, left, store.item(right, 0), store.item(right, 1)) if is-args(right)
= form(location, store.text(store.item(right, 0)), left, store.item(right, 1))

────────────────────
+ do access ImmutableTableRow'SourceNode
    - location MatchLocation
    - head ImmutableTableRow'SourceNode
    - tails ImmutableArray'(ImmutableTableRow'SourceNode)

. result = head
for tail in tails
    . next = result
    if is-args(tail)
        if store.count(tail) > 2
            next = applied(location, result, store.item(tail, 0))
        else
            next = call(location, result, store.item(tail, 0), store.item(tail, 1))
    else
        . op = store.text(store.item(tail, 0))
        if op == "!!"
            next = form(location, "!!", result)
        else if op == "[]" || op == "?[]"
            next = form(location, op, result, store.item(tail, 1))
        else
            next = member(location, result, op, store.item(tail, 1))
    span(next, start-of(next), end-of(tail))
    result = next
= result

────────────────────
+ do forced ImmutableTableRow'SourceNode
    - location MatchLocation
    - node ImmutableTableRow'SourceNode
    - ops ImmutableArray'String?

. result = node
. present = ops ?? ImmutableArray'String()
for index in 0 .. < present.length
    result = form(location, "!!", result)
= result

────────────────────
+ do owned ImmutableTableRow'SourceNode
    - location MatchLocation
    - node ImmutableTableRow'SourceNode
    - members ImmutableArray'(ImmutableTableRow'SourceNode)

. result = node
for item in members
    result = member(location, result, ".", item)
= result

────────────────────
+ do char ImmutableTableRow'SourceNode
    - location MatchLocation
    - value String

. bytes = byte-view(value)
if bytes.length == 1
    . byte = bytes[0]
    . is-visible = byte > 32 && byte < 127
    . is-special = byte == 34 || byte == 39 || byte == 40 || byte == 41 || byte == 59 || byte == 92
    if is-visible && !is-special
        = atom(location, "'$value'")
= form(location, "char", text(location, value))

────────────────────
+ do string ImmutableTableRow'SourceNode
    - location MatchLocation
    - head String
    - parts ImmutableTableRow'SourceNode

. items [ImmutableTableRow'SourceNode]
. run [String]
. has-embed = false
for part in store.items(parts)
    if store.is-text(part)
        run += store.text(part)
    else
        if run.length > 0
            items += store.string("".join(run))
            run = List'String()
        items += part
        has-embed = true
if !has-embed && head == "str"
    = text(location, "".join(run))
if run.length > 0
    items += store.string("".join(run))
= form(location, head, splice(items))

────────────────────
+ do embed ImmutableTableRow'SourceNode
    - location MatchLocation
    - expr ImmutableTableRow'SourceNode

=? expr if !store.is-text(expr)
= form(location, "str", expr)

────────────────────
+ do paragraph ImmutableTableRow'SourceNode
    - location MatchLocation
    - parts ImmutableTableRow'SourceNode

. lines [ImmutableTableRow'SourceNode]
. line [ImmutableTableRow'SourceNode]
for part in store.items(parts)
    if !store.is-text(part)
        line += part
        continue
    . pieces [String]
    for piece in store.text(part).split("\n")
        pieces += piece
    for index in 0 .. < pieces.length
        if index > 0
            lines += paragraph-line(line)
            line = List'(ImmutableTableRow'SourceNode)()
        if pieces[index].length > 0
            if line.length > 0 && store.is-text(line[line.length - 1])
                . joined = line.pop()
                line += store.string(store.text(joined) ++ pieces[index])
            else
                line += store.string(pieces[index])
if line.length > 0
    lines += paragraph-line(line)
while lines.length > 0 && store.is-blank(lines[lines.length - 1])
    lines.pop()
= form(location, "paragraph", splice(lines))

────────────────────
_ do span
    - node ImmutableTableRow'SourceNode
    - start Index
    - end Index

. kept = spans
if kept
    kept.set(node, start, end)

────────────────────
_ start-of Index
    - node ImmutableTableRow'SourceNode

if kept != null then kept.start(node) else 0

.. kept = spans

────────────────────
_ end-of Index
    - node ImmutableTableRow'SourceNode

if kept != null then kept.end(node) else 0

.. kept = spans

────────────────────
_ is-args Bool
    - node ImmutableTableRow'SourceNode

match store.items(node)
    | [.list(0, _, _), ...]
        true
    ??
        false

────────────────────
_ is-spliced Bool
    - node ImmutableTableRow'SourceNode

match node
    | .list(0, _, _)
        true
    ??
        false

────────────────────
_ is-part Bool
    - node ImmutableTableRow'SourceNode

is-spliced(node) || is-led

.. is-led = match store.items(node)
    | [.atom(0, _), ...]
        true
    | [.list(0, _, _), ...]
        true
    ??
        false

────────────────────
_ do mark ImmutableTableRow'SourceNode
    - text String

= store.place(SourceNode.atom(0, store.name(text)))

────────────────────
_ do paragraph-line ImmutableTableRow'SourceNode
    - parts [ImmutableTableRow'SourceNode]

=? store.blank() if parts.length == 0
=? parts[0] if parts.length == 1 && store.is-text(parts[0])
. items = List'(ImmutableTableRow'SourceNode)(store.atom("str"))
items ++= parts
= store.list(items)

━━━━━━━━━━━━━━━━━━━━
+ brix-is-number Bool
    - text String

bytes.length > 0 && (is-digit || is-fraction)

.. bytes = byte-view(text)
.. first = bytes[0]
.. is-digit = first >= 48 && first <= 57
.. is-fraction = first == 46 && bytes.length > 1 && bytes[1] >= 48 && bytes[1] <= 57

━━━━━━━━━━━━━━━━━━━━
+ do brix-is-scope Bool
    - store SourceStore
    - block ImmutableTableRow'SourceNode

=? false if !store.is-form(block, "block")
. items = store.items(block)
= all(1 .. < items.length) • where brix-is-scope-row(store, items[each])

━━━━━━━━━━━━━━━━━━━━
+ brix-is-arm Bool
    - store SourceStore
    - node ImmutableTableRow'SourceNode

head == "else-if" || head == "else" || head == "and-for" || head == "or-for"

.. head = store.head(node) ?? ""

━━━━━━━━━━━━━━━━━━━━
+ brix-takes-arm Bool
    - store SourceStore
    - node ImmutableTableRow'SourceNode
    - arm ImmutableTableRow'SourceNode

|? head == "and-for"
    is-loop || store.is-form(node, "subscribe-for")
|? head == "or-for"
    is-loop
??
    store.is-form(node, "if")

.. head = store.head(arm) ?? ""
.. is-loop = store.is-form(node, "for") || store.is-form(node, "iterate")

━━━━━━━━━━━━━━━━━━━━
+ brix-callable-head String
    - store SourceStore
    - name ImmutableTableRow'SourceNode
    - is-imperative Bool

if is-imperative || is-made then "fn-do" else "fn-expr"

.. made = if store.is-form(name, "of") && store.count(name) > 1 then store.item(name, 1) else name
.. is-made = store.is-atom(made) && store.text(made) == "This"

━━━━━━━━━━━━━━━━━━━━
+ do brix-is-type-form Bool
    - store SourceStore
    - node ImmutableTableRow'SourceNode

if store.is-atom(node)
    . text = store.text(node)
    = (!(text < "A") && text < "[" && !text.starts-with("C:")) || is-quoted
        .. is-quoted = text.length > 2 && text.starts-with("''")
. head = store.head(node) ?? ""
=? true if ["channel", "fn-type", "c-fn-type", "c-struct", "exact", "similar"] has head
=? false if store.count(node) < 2
=? false if !(["list", "?", "of", "map", "tuple", "[]", "stream", "."] has head)
for index in 1 .. < store.count(node)
    . item = store.item(node, index)
    . is-field = head == "tuple" && store.is-form(item, ":") && store.count(item) == 3 && is-named
        .. is-named = store.is-atom(store.item(item, 1))
    =? false if !brix-is-type-form(store, if is-field then store.item(item, 2) else item)
= true

━━━━━━━━━━━━━━━━━━━━
+ brix-is-pattern-form Bool
    - store SourceStore
    - node ImmutableTableRow'SourceNode

|? store.is-atom(node)
    store.text(node).starts-with("..")
??
    ["all", "|", "{}", "~"] has (store.head(node) ?? "")

━━━━━━━━━━━━━━━━━━━━
+ do brix-iterate-body Size
    - store SourceStore
    - node ImmutableTableRow'SourceNode

. items = store.items(node)
for index in 1 .. < items.length
    =? index if store.is-form(items[index], "block")
= items.length

━━━━━━━━━━━━━━━━━━━━
+ do brix-arm-start Size
    - store SourceStore
    - node ImmutableTableRow'SourceNode

. items = store.items(node)
. index = items.length
while index > 0 && brix-is-arm(store, items[index - 1]) && brix-takes-arm(store, node, items[index - 1])
    index -= 1
= index

━━━━━━━━━━━━━━━━━━━━
+ brix-is-scope-row Bool
    - store SourceStore
    - row ImmutableTableRow'SourceNode

is-comment || store.is-blank(row) || head == "lazy" || head == "on-error" || head == "throw"

.. head = store.head(row) ?? ""
.. is-comment = store.is-comment(row)

━━━━━━━━━━━━━━━━━━━━
+ brix-unescape String
    - c Char

match c
    |= 't'
        "\t"
    |= 'n'
        "\n"
    |= 'r'
        "\r"
    |= 'b'
        "\b"
    |= 'f'
        "\f"
    |= 'v'
        "\v"
    |= '/'
        "/"
    |= '\\'
        "\\"
    |= '$'
        "$"
    |= '"'
        "\""
    |= '\''
        "'"
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ BrixSpan is Tuple

+ start Index
+ end Index
