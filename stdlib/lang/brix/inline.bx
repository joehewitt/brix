(import ./brix)
(import ./convert)
(import /code/structure/document)
(import /code/structure/rows)
(import /math)

(type _ InlinePlace (is (tuple (: name String) (: before String) (: after String))))

(type _ InlineCut (is (tuple (: row Index) (: start Size) (: end Size))))

(fn-do + brix-inline-view (? String)
  (param form String)
  (let lines (call brix-inline-rows form))
  (return-if null (if (== lines null)))
  (return (call (. "\n" join) (in (call inline-line-text each) lines)))
)

(fn-do + brix-inline-rows (? (list (list SourceSpan)))
  (param form String)
  (for (in place (call inline-places (call inline-head form)))
    (return? (call inline-rows form place))
  )
  (return null)
)

(fn-expr _ inline-places (list InlinePlace)
  (param head String)
  (case? (== head "param")
    (list param)
  )
  (case? (or (== head "when") (== head "until") (== head "while"))
    (list clause statement)
  )
  (case? (or (== head "seq") (== head "chars") (== head "\\{}"))
    (list stream)
  )
  (case? (or (== head "exact") (== head "similar") (== head ":") (== head "{}") (== head "all") (== head "|"))
    (list pattern stream)
  )
  (case? (or (== head "case") (== head "case=") (== head "case?") (== head "default"))
    (list arm statement)
  )
  (case? (or (== head "then") (== head "else-state"))
    (list transition)
  )
  (case? (== head "fn-type")
    (list type statement)
  )
  (case? (or (call (. head starts-with) "fn-") (== head "type") (== head "type-line") (== head "extend") (== head "extend-line") (== head "import") (== head "export") (== head "unit"))
    (list module member)
  )
  (case? (or (== head "prop") (== head "event") (== head "depends") (== head "content"))
    (list member)
  )
  (case? (or (== head "when-rule") (== head "whenever-rule") (== head "subscribe-for") (== head "subscribe"))
    (list member)
  )
  (default
    (inline (list statement pattern type stream))
  )
  (where
    (lazy statement (call InlinePlace "statement" "(main\n  " "\n)"))
    (lazy module (call InlinePlace "module" "" "\n\n(main\n  (print 0)\n)"))
    (lazy member (call InlinePlace "member" "(type + T\n  " "\n)"))
    (lazy arm (call InlinePlace "arm" "(main\n  (match s\n    " "\n  )\n)"))
    (lazy transition (call InlinePlace "transition" "(main\n  (state s\n    " "\n  )\n)"))
    (lazy pattern (call InlinePlace "pattern" "(main\n  (match s\n    (case " " v)\n  )\n)"))
    (lazy stream (call InlinePlace "stream" "(main\n  (match s\n    (~ " " v)\n  )\n)"))
    (lazy type (call InlinePlace "type" "(main\n  (let x " " v)\n)"))
    (lazy param (call InlinePlace "param" "(fn-expr + f _\n  " "\n  v\n)"))
    (lazy clause (call InlinePlace "clause" "(main\n  (for (in x xs " ")\n    v\n  )\n)"))
  )
)

(fn-do _ inline-head String
  (param form String)
  (let head "")
  (let started false)
  (for (in c form)
    (if started
      (return-if head (if (or (== c (char " ")) (== c (char ")")) (== c (char "\n")))))
      (++= head c)
      (else-if (== c (char "("))
        (= started true)
      )
    )
  )
  (return head)
)

(fn-do _ inline-rows (? (list (list SourceSpan)))
  (param form String)
  (param place InlinePlace)
  (let source (++ (. place before) form (. place after)))
  (let read (catch (call brix-document-read source)))
  (return-if null (if (is read Error)))
  (let document (as read SourceDocument))
  (finally
    (inline (call (. document release)))
  )
  (let rows (call (. document view-rows)))
  (let lines (call (of List String) (in (. each text) rows)))
  (let text (call (. "\n" join) lines))
  (let back (catch (call brix-convert text)))
  (return-if null (if (is back Error)))
  (return-if null (if (!= (call squeezed (call unblanked (as back String))) (call squeezed source))))
  (let starts (list Size))
  (let at Size 0)
  (for (in line lines)
    (+= starts at)
    (+= at (+ (. line length) 1))
  )
  (let placed (list (list SourceSpan)))
  (for (in cut (call placed-cuts lines (. place name)))
    (+= placed (call cut-spans ([] rows (. cut row)) cut text ([] starts (. cut row))))
  )
  (if (and (== (. place name) "statement") (> (. placed length) 0))
    (return-if null (if (call (. (call inline-line-text ([] placed (- (. placed length) 1))) ends-with) "...")))
  )
  (return placed)
)

(fn-do _ placed-cuts (list InlineCut)
  (param lines (list String))
  (param place String)
  (let kept (list InlineCut))
  (let line-no 0)
  (let in-body (and (!= place "member") (!= place "param")))
  (for (in row (..< 0 (. lines length)))
    (let line ([] lines row))
    (+= line-no 1)
    (if (or (call (. line starts-with) "━") (call (. line starts-with) "─"))
      (continue)
    )
    (if (not in-body)
      (= in-body (or (== line "+ T") (== line "+ f")))
      (continue)
    )
    (if (and (== place "param") (not line))
      (break)
    )
    (if (and (== place "module") (== line "-- 0"))
      (break)
    )
    (match place
      (case= "arm"
        (+=? kept (only-if (call indented row line 4) (if (> line-no 1))))
      )
      (case= "transition"
        (+=? kept (only-if (call indented row line 4) (if (> line-no 1))))
      )
      (case= "pattern"
        (+=? kept (only-if (call indented row line 6) (if (== line-no 2))))
      )
      (case= "stream"
        (+=? kept (only-if (call indented row line 6) (if (== line-no 2))))
      )
      (case= "type"
        (+=? kept (only-if (call unassigned (call indented row line 4) line) (if (== line-no 1))))
      )
      (case= "param"
        (+= kept (call indented row line 4))
      )
      (case= "clause"
        (+=? kept (only-if (call indented row line 12) (if (== line-no 1))))
      )
      (default
        (+= kept (call indented row line 0))
      )
    )
  )
  (while (and (!= (. kept length) 0) (>= (. ([] kept 0) start) (. ([] kept 0) end)))
    (-= ([] kept 0))
  )
  (while (and (!= (. kept length) 0) (>= (. ([] kept (- (. kept length) 1)) start) (. ([] kept (- (. kept length) 1)) end)))
    (-= ([] kept (- (. kept length) 1)))
  )
  (return kept)
)

(fn-do _ cut-spans (list SourceSpan)
  (param row SourceRow)
  (param cut InlineCut)
  (param text String)
  (param start Size)
  (let spans (list SourceSpan))
  (let indent (. row content-start))
  (if (< (. cut start) indent)
    (+= spans (call SourceSpan (. SourceSpanKind plain) ([] text (..< (+ start (. cut start)) (+ start (call min indent (. cut end)))))))
  )
  (let at indent)
  (for (in span (. row spans))
    (let size (. span text length))
    (let low (call max at (. cut start)))
    (let high (call min (+ at size) (. cut end)))
    (if (> high low)
      (+= spans (call SourceSpan (. span kind) ([] text (..< (+ start low) (+ start high)))))
    )
    (+= at size)
  )
  (return spans)
)

(fn-expr _ inline-line-text String
  (param spans (list SourceSpan))
  (call (. "" join) (in (. each text) spans))
)

(fn-expr _ unassigned InlineCut
  (param cut InlineCut)
  (param line String)
  (if-expr (call (. ([] line (..< (. cut start) (. cut end))) ends-with) " = v") (call InlineCut (. cut row) (. cut start) (- (. cut end) 4)) cut)
)

(fn-expr _ indented InlineCut
  (param row Index)
  (param line String)
  (param depth Size)
  (call InlineCut row (call min depth (. line length)) (. line length))
)

(fn-expr _ unblanked String
  (param text String)
  (call (. "" join) (call (. text split) "(blank)"))
)

(fn-do _ squeezed String
  (param text String)
  (let out "")
  (let spaced false)
  (for (in c text)
    (if (or (== c (char " ")) (== c (char "\n")) (== c (char "\t")))
      (= spaced true)
      (else
        (++=? out (only-if " " (if (and spaced out (!= c (char ")")) (not (call (. out ends-with) "("))))))
        (= spaced false)
        (++= out c)
      )
    )
  )
  (return out)
)
