(import ./build)
(import ./layout)
(import /core/table)
(import /data/source-tree)
(import /stream/aggregate)

(type _ TriviaKind (is U8)
  (variant code)
  (variant blank)
  (variant comment)
  (variant divider)
  (variant ruler)
  (variant dropped)
)

(type _ BrixWoven (is Tuple)
  (prop + slot Size)
  (prop + node (of ImmutableTableRow SourceNode))
)

(type + BrixTrivia
  (prop _ store SourceStore)
  (prop _ spans BrixSpans)
  (prop _ layout BrixLayout)
  (prop _ kinds (list TriviaKind))
  (prop _ indents (list Size))
  (prop _ texts (list String))
  (prop _ woven (map U32 (list BrixWoven)))
  (fn-do + This _
    (param store _)
    (param spans _)
    (param source String)
    (lazy layout (call BrixLayout store))
    (for (in line (call (. source split) "\n"))
      (call scan line)
    )
  )
  (fn-do + weave (of ImmutableTableRow SourceNode)
    (param root (of ImmutableTableRow SourceNode))
    (call (. spans set) root 0 (. kinds length))
    (call conceal root)
    (call extend root)
    (let gathered (call gather root))
    (call drop-blanks)
    (for (in index (..< 0 (. kinds length)))
      (if (call is-loose index)
        (call plan gathered (+ index 1))
      )
    )
    (return (call settled gathered))
  )
  (fn-expr _ is-loose Bool
    (param index Size)
    (or (== ([] kinds index) (. TriviaKind blank)) (== ([] kinds index) (. TriviaKind comment)))
  )
  (fn-expr _ is-skipped Bool
    (param index Size)
    (or (== ([] kinds index) (. TriviaKind blank)) (== ([] kinds index) (. TriviaKind dropped)))
  )
  (fn-do _ scan _
    (param line String)
    (let bytes (call byte-view line))
    (let last (. bytes length))
    (if (and (> last 0) (== ([] bytes (- last 1)) 13))
      (-= last 1)
    )
    (let first Size 0)
    (while (and (< first last) (or (== ([] bytes first) 32) (== ([] bytes first) 9)))
      (+= first 1)
    )
    (+= indents first)
    (if (>= first last)
      (+= kinds (. TriviaKind blank))
      (+= texts "")
      (else-if (== ([] bytes first) 96)
        (let start (+ first 1))
        (if (and (< start last) (== ([] bytes start) 32))
          (+= start 1)
        )
        (+= kinds (. TriviaKind comment))
        (+= texts (call (. bytes slice-string) (..< start last)))
      )
      (else-if (call trivia-starts-box bytes first last 149 140)
        (+= kinds (. TriviaKind comment))
        (+= texts (call (. bytes slice-string) (..< first last)))
      )
      (else-if (call trivia-starts-box bytes first last 148 129)
        (+= kinds (. TriviaKind divider))
        (+= texts "thick")
      )
      (else-if (call trivia-starts-box bytes first last 148 128)
        (+= kinds (. TriviaKind divider))
        (+= texts "thin")
      )
      (else-if (call trivia-starts-box bytes first last 149 144)
        (+= kinds (. TriviaKind ruler))
        (+= texts "")
      )
      (else
        (+= kinds (. TriviaKind code))
        (+= texts (if-expr (call trivia-starts-arm (call (. bytes slice-string) (..< first last))) "arm" ""))
      )
    )
  )
  (fn-expr _ is-divided Bool
    (param node (of ImmutableTableRow SourceNode))
    (and (call (. store is-list) node) (> start 0) (<= start (. kinds length)) (== ([] kinds (- start 1)) (. TriviaKind divider)))
    (where
      (lazy start (call (. spans start) node))
    )
  )
  (fn-do _ extend _
    (param node (of ImmutableTableRow SourceNode))
    (let items (call (. store items) node))
    (for (in index (..< 0 (. items length)))
      (let item ([] items index))
      (if (call is-divided item)
        (let start (call (. spans start) item))
        (let end (call (. spans end) node))
        (let is-followed false)
        (for (in later (..< (+ index 1) (. items length)))
          (let next ([] items later))
          (if (and (call (. store is-list) next) (> (call (. spans start) next) start))
            (let first (call leading-start (call (. spans start) next) start))
            (if (< first (call (. spans start) next))
              (call drop-above first start)
            )
            (= end (- (?? (call orphan-divider first start) first) 1))
            (= is-followed true)
            (break)
          )
        )
        (if (or is-followed (> end (call (. spans end) item)))
          (call (. spans extend) item end)
        )
      )
    )
    (for (in item items)
      (if (call (. store is-list) item)
        (call extend item)
      )
    )
  )
  (fn-do _ leading-start Size
    (param line Size)
    (param floor Size)
    (let first line)
    (while (and (> (- first 1) floor) (== ([] kinds (- first 2)) (. TriviaKind comment)))
      (-= first 1)
    )
    (if (and (== first line) (> (- first 2) floor) (call is-skipped (- first 2)) (call is-section-comment (- first 3)))
      (-= first 2)
      (while (and (> (- first 1) floor) (call is-section-comment (- first 2)))
        (-= first 1)
      )
    )
    (return first)
  )
  (fn-do _ drop-above _
    (param first Size)
    (param floor Size)
    (let line first)
    (while (and (> (- line 1) floor) (== ([] kinds (- line 2)) (. TriviaKind blank)))
      (= ([] kinds (- line 2)) (. TriviaKind dropped))
      (-= line 1)
    )
  )
  (fn-do _ orphan-divider (? Size)
    (param first Size)
    (param floor Size)
    (let line first)
    (while (and (> (- line 1) floor) (or (call is-skipped (- line 2)) (== ([] kinds (- line 2)) (. TriviaKind comment))))
      (-= line 1)
    )
    (return-if (- line 1) (if (and (> (- line 1) floor) (== ([] kinds (- line 2)) (. TriviaKind divider)))))
    (return null)
  )
  (fn-expr _ is-section-comment Bool
    (param index Size)
    (and (== ([] kinds index) (. TriviaKind comment)) (call (. ([] texts index) starts-with) "`"))
  )
  (fn-do _ gather (of ImmutableTableRow SourceNode)
    (param root (of ImmutableTableRow SourceNode))
    (let items (call (. store listed) root))
    (let changed false)
    (for (in index (..< 0 (. kinds length)))
      (let is-thick (and (== ([] kinds index) (. TriviaKind divider)) (== ([] texts index) "thick")))
      (if (or (not is-thick) (>= (+ index 1) (. kinds length)) (!= ([] kinds (+ index 1)) (. TriviaKind blank)))
        (continue)
      )
      (let opened (+ index 1))
      (let limit (+ (. kinds length) 1))
      (for (in later (..< (+ index 1) (. kinds length)))
        (if (== ([] kinds later) (. TriviaKind divider))
          (= limit (+ later 1))
          (break)
        )
      )
      (let kept (call (of List (of ImmutableTableRow SourceNode)) ([] items 0)))
      (let held (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "content")))
      (let slot Size 0)
      (for (in position (..< 1 (. items length)))
        (let item ([] items position))
        (let start (call (. spans start) item))
        (if (and (> start opened) (< start limit))
          (if (== (. held length) 1)
            (= slot (. kept length))
          )
          (+= held item)
          (else
            (+= kept item)
          )
        )
      )
      (if (> (. held length) 1)
        (let section (call (. store list) held))
        (call (. spans set) section opened (- limit 1))
        (call (. kept insert) section slot)
        (= items kept)
        (= changed true)
      )
    )
    (return (if-expr changed (call (. store with-items) root items) root))
  )
  (fn-do _ conceal _
    (param node (of ImmutableTableRow SourceNode))
    (let first (if-expr (call is-opaque node) (call (. spans start) node) 0))
    (if (> first 0)
      (for (in line (.. first (call (. spans end) node)))
        (if (and (<= line (. kinds length)) (call is-loose (- line 1)))
          (= ([] kinds (- line 1)) (. TriviaKind code))
        )
      )
    )
    (for (in item (call (. store items) node))
      (if (call (. store is-list) item)
        (call conceal item)
      )
    )
  )
  (fn-do _ drop-blanks _
    (let total (. kinds length))
    (for (in index (..< 0 total))
      (if (and (or (== ([] kinds index) (. TriviaKind divider)) (== ([] kinds index) (. TriviaKind ruler))) (< (+ index 1) total))
        (let header (+ index 1))
        (let cursor header)
        (if (!= ([] kinds header) (. TriviaKind blank))
          (= cursor (+ header 1))
          (let depth ([] indents header))
          (while (and (< cursor total) (== ([] kinds cursor) (. TriviaKind code)) (or (> ([] indents cursor) depth) (== ([] texts cursor) "arm")))
            (+= cursor 1)
          )
        )
        (while (and (< cursor total) (== ([] kinds cursor) (. TriviaKind blank)))
          (= ([] kinds cursor) (. TriviaKind dropped))
          (+= cursor 1)
        )
      )
    )
    (let following (. TriviaKind divider))
    (let index total)
    (while (> index 0)
      (-= index 1)
      (if (== ([] kinds index) (. TriviaKind blank))
        (if (or (== following (. TriviaKind divider)) (== following (. TriviaKind ruler)))
          (= ([] kinds index) (. TriviaKind dropped))
        )
        (else-if (!= ([] kinds index) (. TriviaKind dropped))
          (= following ([] kinds index))
        )
      )
    )
    (let is-leading true)
    (let follows-blank false)
    (for (in line (..< 0 total))
      (if (== ([] kinds line) (. TriviaKind blank))
        (if (or is-leading follows-blank)
          (= ([] kinds line) (. TriviaKind dropped))
        )
        (= follows-blank true)
        (else-if (!= ([] kinds line) (. TriviaKind dropped))
          (= is-leading false)
          (= follows-blank false)
        )
      )
    )
  )
  (fn-do _ plan _
    (param root (of ImmutableTableRow SourceNode))
    (param line Size)
    (let index (- line 1))
    (let depth ([] indents index))
    (if (== ([] kinds index) (. TriviaKind blank))
      (let cursor (+ index 1))
      (while (and (< cursor (. kinds length)) (call is-skipped cursor))
        (+= cursor 1)
      )
      (= depth (if-expr (< cursor (. kinds length)) ([] indents cursor) 0))
    )
    (let node root)
    (let reach root)
    (while true
      (let inner (? (of ImmutableTableRow SourceNode)) null)
      (for (in item (call (. store items) reach))
        (if (and (call (. store is-list) item) (call covers item line) (not (call is-opaque item)))
          (= inner item)
        )
      )
      (if (not inner)
        (break)
      )
      (= reach inner)
      (if (!= (call (. layout header-count) inner) null)
        (= node inner)
      )
    )
    (let items (call (. store items) node))
    (let slot (. items length))
    (for (in position (..< 1 (. items length)))
      (if (> (call (. spans start) ([] items position)) line)
        (= slot position)
        (break)
      )
    )
    (while (and (> slot 1) (not (call has-woven node slot)))
      (let previous ([] items (- slot 1)))
      (let start (call (. spans start) previous))
      (let is-flat (or (not (call (. store is-list) previous)) (== start 0) (<= (call (. spans end) previous) start)))
      (if (or is-flat (and (<= depth ([] indents (- start 1))) (not (call brix-is-arm store previous))))
        (break)
      )
      (let deeper (call holder-in previous))
      (if (not deeper)
        (break)
      )
      (= node deeper)
      (= items (call (. store items) node))
      (= slot (. items length))
    )
    (return-if (if (and (== ([] kinds index) (. TriviaKind blank)) (< (as slot Int) (?? (call (. layout header-count) node) 0)))))
    (let made (if-expr (== ([] kinds index) (. TriviaKind blank)) (call (. store blank)) (call (. store comment) ([] texts index))))
    (call (. spans set) made line line)
    (let held ([] woven (. node id)))
    (if held
      (call (. held append) (call BrixWoven slot made))
      (else
        (= ([] woven (. node id)) (call (of List BrixWoven) (call BrixWoven slot made)))
      )
    )
  )
  (fn-do _ has-woven Bool
    (param node (of ImmutableTableRow SourceNode))
    (param slot Size)
    (let held ([] woven (. node id)))
    (return-if false (if (not held)))
    (return (call some held (:where (== (. each slot) slot))))
  )
  (fn-do _ settled (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (return-if node (if (not (call (. store is-list) node))))
    (let held ([] woven (. node id)))
    (let items (call (. store items) node))
    (let changed (!= held null))
    (let made (list (of ImmutableTableRow SourceNode)))
    (for (in index (..< 0 (. items length)))
      (if held
        (for (in entry held)
          (if (== (. entry slot) index)
            (+= made (. entry node))
          )
        )
      )
      (let item ([] items index))
      (let next (call settled item))
      (if (!= (. next index) (. item index))
        (= changed true)
      )
      (+= made next)
    )
    (if held
      (for (in entry held)
        (if (>= (. entry slot) (. items length))
          (+= made (. entry node))
        )
      )
    )
    (return (if-expr changed (call (. store with-items) node made) node))
  )
  (fn-expr _ covers Bool
    (param node (of ImmutableTableRow SourceNode))
    (param line Size)
    (and (> start 0) (< start line) (<= line (call (. spans end) node)))
    (where
      (lazy start (call (. spans start) node))
    )
  )
  (fn-do _ holder-in (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (let current node)
    (while (and (call (. store is-list) current) (not (call is-opaque current)))
      (return-if current (if (!= (call (. layout header-count) current) null)))
      (let count (call (. store count) current))
      (return-if null (if (or (== count 0) (call has-woven current count))))
      (= current (call (. store item) current (- count 1)))
    )
    (return null)
  )
  (fn-expr _ is-opaque Bool
    (param node (of ImmutableTableRow SourceNode))
    (or (call (. store is-form) node "paragraph") (call (. store is-form) node "str"))
  )
)

(fn-expr _ trivia-starts-arm Bool
  (param text String)
  (or (call (. text starts-with) "and ") (call (. text starts-with) "or "))
)

(fn-expr _ trivia-starts-box Bool
  (param bytes (of ImmutableArray Byte))
  (param first Size)
  (param last Size)
  (param second Byte)
  (param third Byte)
  (and (< (+ first 2) last) (== ([] bytes first) 226) (== ([] bytes (+ first 1)) second) (== ([] bytes (+ first 2)) third))
)
