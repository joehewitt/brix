(import ./brix-print)
(import ./brix-syntax)
(import ./layout)
(import /code/structure/rows)
(import /core/table)
(import /data/source-tree)

(type + BrixNames
  (prop + store SourceStore)
  (blank)
  (prop _ homes (map U32 U32))
  (prop _ owner (? U32))
  (prop _ owner-id U32)
  (prop _ length Size)
  (prop _ known (map String SourceSpanKind))
  (prop _ shared (map String SourceSpanKind))
  (prop _ blank (map String SourceSpanKind))
  (prop _ members-owner (? U32))
  (prop _ members-id U32)
  (prop _ members-length Size)
  (prop _ members (map String SourceSpanKind))
  (fn-do + This _
    (param store _)
  )
  (fn-do + home _
    (param member (of ImmutableTableRow SourceNode))
    (param type (of ImmutableTableRow SourceNode))
    (= ([] homes (as (. member index) U32)) (as (. type index) U32))
  )
  (fn-do + resolved (list SourceSpan)
    (param spans (list SourceSpan))
    (param tags (list BrixTag))
    (param holder (? U32))
    (return-if (call brix-joined spans) (if (== (. tags length) 0)))
    (call settle-scope holder)
    (let result (list SourceSpan))
    (let is-changed false)
    (let column Size 0)
    (let next Index 0)
    (for (in position (..< 0 (. spans length)))
      (let span ([] spans position))
      (let end (+ column (. span text length)))
      (while (and (< next (. tags length)) (< (. ([] tags next) start) column))
        (+= next 1)
      )
      (let is-tagged (and (< next (. tags length)) (== (. ([] tags next) start) column) (== (. ([] tags next) end) end)))
      (let kind (if-expr is-tagged (call resolved-kind span (. ([] tags next) kind)) (. span kind)))
      (if (and (!= kind (. span kind)) (not is-changed))
        (= is-changed true)
        (call (. result reserve) (. spans length))
        (for (in earlier (..< 0 position))
          (+= result ([] spans earlier))
        )
      )
      (if is-changed
        (+= result (call SourceSpan kind (. span text) (. span is-optional)))
      )
      (= column end)
    )
    (return (call brix-joined (if-expr is-changed result spans)))
  )
  (fn-expr _ resolved-kind SourceSpanKind
    (param span SourceSpan)
    (param tag BrixTagKind)
    (case? (== tag (. BrixTagKind exit))
      (if-expr (or (== (. span kind) (. SourceSpanKind operator)) (== (. span kind) (. SourceSpanKind keyword))) (. SourceSpanKind exit) (. span kind))
    )
    (case? (== tag (. BrixTagKind raise))
      (if-expr (or (== (. span kind) (. SourceSpanKind operator)) (== (. span kind) (. SourceSpanKind type-name))) (. SourceSpanKind exit) (. span kind))
    )
    (case? (== tag (. BrixTagKind markup))
      (if-expr (has (list (. SourceSpanKind operator) (. SourceSpanKind keyword) (. SourceSpanKind identifier)) (. span kind)) (. SourceSpanKind type-name) (. span kind))
    )
    (case? (and (== tag (. BrixTagKind binder)) (or (== (. span kind) (. SourceSpanKind identifier)) (== (. span kind) (. SourceSpanKind punctuation))))
      (. SourceSpanKind binder)
    )
    (case? (and (== (. span kind) (. SourceSpanKind definition)) (== found (. SourceSpanKind member)))
      (. SourceSpanKind member-binder)
    )
    (case? (!= (. span kind) (. SourceSpanKind identifier))
      (. span kind)
    )
    (case? (and (== tag (. BrixTagKind setting)) (== found (. SourceSpanKind member)))
      (. SourceSpanKind member-binder)
    )
    (default
      found
    )
    (where
      (lazy found (?? ([] known (. span text)) ([] shared (. span text)) (. SourceSpanKind identifier)))
    )
  )
  (fn-do _ settle-scope _
    (param holder (? U32))
    (return-if (if (and (== holder owner) (== (. store length) length) (== (call (. store id-at) holder) owner-id))))
    (= owner holder)
    (= owner-id (call (. store id-at) holder))
    (= length (. store length))
    (= known (call (of Map String SourceSpanKind)))
    (= shared blank)
    (let node (call (. store node-at) holder))
    (return-if (if (not node)))
    (let home (call home-of node))
    (let is-holder-type (call is-type node))
    (if home
      (= shared (call members-of home))
      (else-if is-holder-type
        (= shared (call members-of node))
      )
    )
    (call add-params node)
    (call add-locals node is-holder-type)
    (= ([] known "it") (. SourceSpanKind identifier))
  )
  (fn-do _ members-of (map String SourceSpanKind)
    (param type (of ImmutableTableRow SourceNode))
    (let at (as (. type index) U32))
    (return-if members (if (and (== at members-owner) (== (. store length) members-length) (== (call (. store id-at) at) members-id))))
    (= members-owner at)
    (= members-id (call (. store id-at) at))
    (= members-length (. store length))
    (= members (call (of Map String SourceSpanKind)))
    (for (in item (call (. store listed) type 1))
      (let head (?? (call (. store head) item) ""))
      (let slot (if-expr (== head "variant") 1 2))
      (if (and (or (== head "prop") (== head "event") (== head "variant") (call brix-is-callable head)) (> (call (. store count) item) slot))
        (let name (call (. store item) item slot))
        (if (and (call (. store is-atom) name) (call brix-is-name (call (. store text) name)))
          (= ([] members (call (. store text) name)) (. SourceSpanKind member))
        )
      )
    )
    (return members)
  )
  (fn-do _ home-of (? (of ImmutableTableRow SourceNode))
    (param member (of ImmutableTableRow SourceNode))
    (let place ([] homes (as (. member index) U32)))
    (return-if null (if (or (== place null) (>= place (. store length)))))
    (let type (call (. store node) place))
    (return-if null (if (not (call is-type type))))
    (for (in item (call (. store items) type))
      (return-if type (if (== (. item index) (. member index))))
    )
    (return null)
  )
  (fn-do _ add-params _
    (param node (of ImmutableTableRow SourceNode))
    (let head (?? (call (. store head) node) ""))
    (return-if (if (not (call brix-is-callable head))))
    (if (and (call (. head starts-with) "fn-from") (> (call (. store count) node) 2))
      (call bind (call (. store item) node 2) (. SourceSpanKind parameter))
    )
    (for (in item (call (. store listed) node 1))
      (if (call (. store is-form) item "param")
        (for (in index (..< 1 (call (. store count) item)))
          (if (and (< index 3) (call (. store is-atom) (call (. store item) item index)))
            (call bind (call (. store item) item index) (. SourceSpanKind parameter))
          )
        )
      )
    )
  )
  (fn-do _ add-locals _
    (param node (of ImmutableTableRow SourceNode))
    (param skips-members Bool)
    (return-if (if (< (call (. store count) node) 2)))
    (for (in item (call (. store listed) node 1))
      (if (and (call (. store is-list) item) (not (and skips-members (call brix-is-callable (?? (call (. store head) item) "")))))
        (call bind-in item)
        (call add-locals item false)
      )
    )
  )
  (fn-do _ bind-in _
    (param form (of ImmutableTableRow SourceNode))
    (return-if (if (< (call (. store count) form) 2)))
    (let head (?? (call (. store head) form) ""))
    (let first (call (. store item) form 1))
    (if (or (has (list "let" "lazy" "in" "on" "on-error" "on-failure" "do-with" "iterates" "=>") head) (and (== head "with") (== (call (. store count) form) 3)))
      (call bind first (. SourceSpanKind identifier))
      (else-if (has (list "case" "case-union" "state") head)
        (call bind (if-expr (and (call (. store is-form) first "=") (> (call (. store count) first) 1)) (call (. store item) first 1) first) (. SourceSpanKind identifier))
      )
    )
  )
  (fn-do _ bind _
    (param node (of ImmutableTableRow SourceNode))
    (param kind SourceSpanKind)
    (if (call (. store is-atom) node)
      (let text (call (. store text) node))
      (if (call brix-is-name text)
        (= ([] known text) kind)
      )
      (else
        (for (in item (call (. store listed) node))
          (call bind item kind)
        )
      )
    )
  )
  (fn-expr _ is-type Bool
    (param node (of ImmutableTableRow SourceNode))
    (has (list "type" "extend" "style" "style-extend") (?? (call (. store head) node) ""))
  )
)
