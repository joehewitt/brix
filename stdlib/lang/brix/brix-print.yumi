./build
./layout
/core/table
/data/source-sexp
/data/source-tree
/stream/aggregate

_ brix-level-tuple = 1
_ brix-level-closure = 2
_ brix-level-print = 3
_ brix-level-coalesce = 4
_ brix-level-if = 5
_ brix-level-named = 6
_ brix-level-assign = 7
_ brix-level-select = 8
_ brix-level-pipe = 9
_ brix-level-prefix = 23
_ brix-level-postfix = 24
_ brix-level-primary = 26

━━━━━━━━━━━━━━━━━━━━
+ BrixTagKind is Union

| name
| setting
| exit
| raise
| markup
| binder

━━━━━━━━━━━━━━━━━━━━
+ BrixTag is Tuple

+ start Size
+ end Size
+ kind BrixTagKind

━━━━━━━━━━━━━━━━━━━━
+ BrixPrinter

+ holder ImmutableTableRow'SourceNode?
+ start Size
+ armed ImmutableTableRow'SourceNode?
+ tail ImmutableTableRow'SourceNode?
+ has-text Bool
+ tags [BrixTag]

_ store SourceStore
_ layout BrixLayout
_ parts [String]
_ no-prep Bool
_ is-quiet Bool
_ binds-clause Bool
_ column Size
_ is-field Bool
_ is-setting Bool
_ is-binding Bool

────────────────────
+ This
    - store

.. layout = BrixLayout(store)

────────────────────
+ do row String
    - node ImmutableTableRow'SourceNode

begin(false)
statement(node)
= "".join(parts)

────────────────────
+ do heading String
    - node ImmutableTableRow'SourceNode

begin(false)
declaration(node)
= "".join(parts)

────────────────────
+ do line String
    - node ImmutableTableRow'SourceNode

begin(false)
text-line(node)
= "".join(parts)

────────────────────
+ do scan-row
    - node ImmutableTableRow'SourceNode

begin(true)
statement(node)

────────────────────
+ do scan-heading
    - node ImmutableTableRow'SourceNode

begin(true)
declaration(node)

────────────────────
+ do scan-line
    - node ImmutableTableRow'SourceNode

begin(true)
text-line(node)

────────────────────
+ header-count Size
    - node ImmutableTableRow'SourceNode

if count == null || count > total then total else count

.. total = store.count(node)
.. count = layout.header-count(node)

────────────────────
+ do text-body ImmutableTableRow'SourceNode?
    - items ImmutableTableSpan'SourceNode

. end = items.length
while end > 0 && (store.is-form(items[end - 1], "lazy") || store.is-form(items[end - 1], "blank") || store.is-form(items[end - 1], "where"))
    end -= 1
=? null if end == 0
= items[end - 1] if store.is-form(items[end - 1], "paragraph")

────────────────────
_ is-looped Bool
    - node ImmutableTableRow'SourceNode

|? (head == "and" || head == "and-for") && store.count(node) > 1
    is-looped(store.item(node, 1))
??
    head == "in" || head == "on" || head == "each" || head == "block" || brix-is-clause-head(head)

.. head = store.head(node) ?? ""

────────────────────
_ do begin
    - quiet Bool

if !quiet
    parts = List'String()
    tags = List'BrixTag()
holder = null
armed = null
tail = null
start = 0
no-prep = false
has-text = false
is-quiet = quiet
column = 0
is-field = false
is-setting = false
is-binding = false

────────────────────
_ do put
    - text String

=? if text.size == 0
has-text = true
if !is-quiet
    parts += text
    column += text.length

────────────────────
_ do quoted
    - text String

has-text = true
if !is-quiet
    . shown = brix-quoted(text)
    parts += shown
    column += shown.length

────────────────────
_ do tagged
    - text String
    - kind BrixTagKind

if !is-quiet && text.size != 0
    tags += BrixTag(column, column + text.length, kind)
put(text)

────────────────────
_ do hold
    - node ImmutableTableRow'SourceNode
    - origin Size

. count = store.count(node)
holder = node
armed = null
start = if origin < count then origin else count

────────────────────
_ is-word Bool
    - node ImmutableTableRow'SourceNode
    - text String

match node
    | .atom(_, held)
        held == text
    ??
        false

────────────────────
_ is-blank-slot Bool
    - node ImmutableTableRow'SourceNode

is-word(node, "_")

────────────────────
_ is-bare-shape Bool
    - node ImmutableTableRow'SourceNode

match node
    | .string(_, _)
        true
    ??
        is-number-atom(node) || store.is-form(node, "list")

────────────────────
_ is-number-atom Bool
    - node ImmutableTableRow'SourceNode

match node
    | .atom(_, text)
        brix-is-number(if text.starts-with("-") then text[1 ...] else text)
    ??
        false

────────────────────
_ is-attribute Bool
    - node ImmutableTableRow'SourceNode

match node
    | .atom(_, text)
        text.starts-with("@")
    ??
        false

────────────────────
_ is-ticked Bool
    - node ImmutableTableRow'SourceNode

match node
    | .atom(_, text)
        text.starts-with("''")
    ??
        false

────────────────────
_ is-bare-argument Bool
    - node ImmutableTableRow'SourceNode

match node
    | .list(_, _, _)
        ["tuple", "list", "map", "stream"] has (store.head(node) ?? "")
    ??
        true

────────────────────
_ continues Bool
    - node ImmutableTableRow'SourceNode

match node
    | .string(_, text)
        brix-continues-name(text)
    ??
        false

────────────────────
_ has-flag Bool
    - items ImmutableTableSpan'SourceNode
    - flag String

some(items) • where is-word(each, flag)

────────────────────
_ called ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode

if store.is-form(node, "scope") && store.count(node) > 1 then store.item(node, 1) else node

────────────────────
_ is-guard Bool
    - node ImmutableTableRow'SourceNode

store.is-form(node, "if") && store.count(node) == 2

────────────────────
_ unguarded ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode

if is-guard(node) then store.item(node, 1) else node

────────────────────
_ is-unbound-source Bool
    - items ImmutableTableSpan'SourceNode

items.length == 2 || brix-is-clause-head(store.head(items[2]) ?? "") || is-keyed

.. is-keyed = store.is-form(items[2], "keyed-by")

────────────────────
_ is-stream-match Bool
    - node ImmutableTableRow'SourceNode

store.is-form(node, "~") && store.count(node) == 2

────────────────────
_ is-stream-source Bool
    - node ImmutableTableRow'SourceNode

match store.items(node)
    | [.atom(_, {it == "in" || it == "on"}), first, _, ...]
        is-stream-match(first)
    ??
        false

────────────────────
_ is-closed Bool
    - node ImmutableTableRow'SourceNode

literals has head || ranges has head

.. head = store.head(node) ?? ""
.. literals = ["[]", "?[]", "!!", "list", "map", "tuple", "str", "char", "chars"]
.. ranges = ["..", "..<", "...", "{}", "stream", "select"]

────────────────────
_ ends-tail Bool
    - node ImmutableTableRow'SourceNode

match node
    | .comment(_, _)
        false
    | .list(_, _, _)
        is-closed(node)
    ??
        true

────────────────────
_ holds-rows Bool
    - node ImmutableTableRow'SourceNode

|? store.is-form(node, "scope")
    true
|? store.is-form(node, "call")
    some(store.items(node)[2 ...]) • where argument-kind(each) != BrixArgument.positional
??
    false

────────────────────
_ argument-kind U8
    - node ImmutableTableRow'SourceNode

|? is-bullet-argument(head)
    BrixArgument.named
|? head == "block" || head == "inline"
    BrixArgument.extra
??
    BrixArgument.positional

.. head = store.head(node) ?? ""

────────────────────
_ do text-line
    - node ImmutableTableRow'SourceNode

do match node
    | .string(_, text)
        if brix-starts-divider(text)
            put("\\")
        put(brix-line-escaped(text))
    | .list(_, start, count)
        text-form(node, store.nodes[start .. < start + count])
    ??
        statement(node)

────────────────────
_ do text-form
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode

do match items
    | [.atom(_, "str"), .string(_, {brix-starts-divider(it)}), ...]
        put("\\")
        interpolated(items, 1, false)
    | [.atom(_, "str"), ...]
        interpolated(items, 1, false)
    | [.atom(_, {it == source-blank-head})]
        =
    ??
        statement(node)

────────────────────
_ do statement
    - node ImmutableTableRow'SourceNode

do match node
    | .comment(_, text)
        put(if text.length > 0 then "` $text" else "`")
    | .list(_, start, count)
        form(node, store.nodes[start .. < start + count])
    ??
        expression(node, 0, true)

────────────────────
_ do form
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode

do match items
    | [.atom(_, {it == source-blank-head})]
        =
    | [.atom(_, {it == source-raw-head}), .string(_, raw), ...]
        put(raw)
        hold(node, 2)
    | [.atom(_, "import"), path]
        put(store.text(path))
    | [.atom(_, "export"), name]
        put("+ ${store.text(name)}")
    | [.atom(_, "let"), target, ...]
        binding(items, false, target)
    | [.atom(_, "lazy"), target, ...]
        binding(items, true, target)
    | [.atom(_, "return")]
        tagged("=", .exit)
    | [.atom(_, "return"), value, ...]
        tagged("=", .exit)
        put(" ")
        payload(value)
    | [.atom(_, mark {brix-is-yield(it)}), ...]
        put(brix-return-mark(mark))
        if items.length >= 2
            put(" ")
            payload(items[1])
    | [.atom(_, "return-if"), _, ...]
        . test = items[items.length - 1]
        if !is-guard(test) || items.length > 3
            put(sexp-inline-text(store, node))
        else
            tagged("=?", .exit)
            if items.length == 3
                put(" ")
                expression(items[1], brix-level-named, false)
            put(" if ")
            expression(unguarded(test), 0, true)
    | [.atom(_, word {it == "break" || it == "continue"}), ...]
        tagged(word, .exit)
    | [.atom(_, "print")]
        put("--")
    | [.atom(_, "throw"), raised, ...]
        tagged("?!", .exit)
        put(" ")
        expression(raised, 0, false)
        hold(node, 2)
    | [.atom(_, word {it == "on-error" || it == "on-failure"}), handler, ...]
        put("catch")
        if store.is-form(handler, "caught")
            caught(handler, 1)
        else if !is-blank-slot(handler)
            put(" ")
            expression(handler, 0, false)
        hold(node, 2)
    | [.atom(_, word {it == "if" || it == "while"}), _, ...]
        put(word)
        put(" ")
        condition(node, items)
    | [.atom(_, "else-if"), _, ...]
        put("else if ")
        condition(node, items)
    | [.atom(_, "else"), ...]
        put("else")
        inline-body(node, items, 1)
    | [.atom(_, word {it == "for" || it == "or-for" || it == "and-for"}), clause, ...]
        put(if word == "for" then "for " else if word == "or-for" then "or " else "and ")
        loop-clause(clause)
        inline-body(node, items, 2)
    | [.atom(_, word {brix-is-do-head(it)}), ...]
        do-block(node, items, word)
    | [.atom(_, "do-with"), name, value, ...]
        put("do with ${store.text(name)} = ")
        expression(value, 0, false)
        hold(node, 3)
    | [.atom(_, word {it == "do-use" || it == "do-use?"}), resource, ...]
        put(if word == "do-use" then "do use " else "do use? ")
        expression(resource, 0, false)
        if items.length == 3 && store.is-form(items[2], "inline")
            hold(items[2], 1)
        else
            hold(node, 2)
    | [.atom(_, "default"), ...]
        put("??")
        inline-body(node, items, 1)
    | [.atom(_, mark {brix-is-case(it)}), subject, ...]
        put(brix-case-mark(mark))
        put(" ")
        expression(subject, 0, false)
        inline-body(node, items, 2)
    | [.atom(_, "case-each"), subject, ...]
        put("<* ")
        expression(subject, 0, false)
        inline-body(node, items, 2)
    | [.atom(_, "~"), _, ...]
        alternative(node, items, true)
    | [.atom(_, "pipe"), op, value, ...]
        . mark = store.text(op)
        put("$mark ")
        if mark == "~>"
            expression(value, 0, false)
            hold(node, 3)
        else
            expression(value, 0, true)
    | [.atom(_, mark {brix-is-bullet(it)}), value]
        put("*${mark[6 ...]} ")
        payload(value)
    | [.atom(_, "arg"), value]
        put("- ")
        payload(value)
    | [.atom(_, word {it == "entry" || it == "entry?"}), key, ...]
        put(if word == "entry" then "• " else "•? ")
        if store.is-text(key)
            expression(key, 0, false)
        else
            put("(")
            expression(key, brix-level-closure, false)
            put(")")
        if items.length >= 3
            assigned(items[2])
    | [.atom(_, {brix-is-keyword-head(it)}), ...]
        named(node, items, true)
    | [.atom(_, "with"), value]
        put("with ")
        expression(value, 0, false)
    | [.atom(_, "header"), value]
        if store.is-list(value)
            plain(value)
        else
            expression(value, 0, false)
    | [.atom(_, word {it == "state" || it == "then" || it == "else-state"}), ...]
        state(node, items, word)
    | [.atom(_, "when-style"), state, ...]
        put("when ")
        expression(state, 0, false)
        inline-body(node, items, 2)
    | [.atom(_, "style-set"), domain, name, value]
        put("${store.text(domain)}:${store.text(name)} = ")
        expression(value, 0, false)
    | [.atom(_, "prop"), _, _, _, ...]
        property(items)
    | [.atom(_, "variant"), _, ...]
        variant(items)
    | [.atom(_, "event"), access, name, kind, ...]
        put("${store.text(access)} event ${store.text(name)} ")
        expression(kind, brix-level-primary, false)
        if items.length >= 5
            put(" keyed by ")
            expression(items[4], brix-level-primary, false)
    | [.atom(_, "unit"), access, name, value]
        put("${store.text(access)} ${store.text(name)} = ")
        expression(value, 0, true)
    | [.atom(_, "delegate"), ...]
        put("as ")
        list(items, 1, ", ", brix-level-closure)
        put(" for")
    | [.atom(_, "style-domains"), name, ...]
        put(". ${store.text(name)} -> ")
        for index in 2 .. < items.length
            if index > 2
                put(", ")
            . fields = store.items(items[index])
            put(store.text(fields[1]))
            if fields.length > 2
                put(" on ${store.text(fields[2])}")
    | [.atom(_, "depends"), name, ...]
        put(". ${store.text(name)} < ")
        list(items, 2, ", ", brix-level-closure)
    | [.atom(_, word {it == "rule" || it == "own-rule"}), name, ...]
        put(if word == "own-rule" then "• own ${store.text(name)}" else "• ${store.text(name)}")
        . origin Size = 2
        if origin < items.length && store.is-form(items[origin], "param")
            put(":")
            parameter(items[origin], false)
            origin += 1
        origin = rules(items, origin)
        hold(node, origin)
    | [.atom(_, "keyframes"), name, ...]
        put("• ${store.text(name)}")
        . origin Size = 2
        if origin < items.length && store.is-form(items[origin], "param")
            put(":")
            parameter(items[origin], false)
            origin += 1
        if origin + 1 < items.length
            put(" ${store.text(items[origin])} ")
            guarded(items[origin + 1], brix-level-closure, false)
        hold(node, origin + 2)
    | [.atom(_, "range"), property, from, to, ...]
        put("${store.text(property)} = ")
        if !is-blank-slot(from)
            expression(from, 18, false)
            put(" ")
        put("..")
        if !is-blank-slot(to)
            put(" ")
            expression(to, 18, false)
        keyframe-options(items, 4)
    | [.atom(_, "track"), property, ...]
        put(store.text(property))
        hold(node, keyframe-options(items, 2))
    | [.atom(_, "at"), at, value, ...]
        put("at ")
        expression(at, 18, false)
        put(" = ")
        expression(value, 18, false)
        keyframe-options(items, 3)
    | [.atom(_, {brix-is-header-head(it)}), ...]
        header-line(node, items)
    | [.atom(_, {it == "type-line" || it == "extend-line"}), ...]
        declaration(node)
    | [.atom(_, word {brix-is-probe(it)}), ...]
        probe(items, word)
    | [.atom(_, "•"), _, ...]
        put("• ")
        rule-use(items)
    ??
        plain(node)

────────────────────
_ do binding
    - items ImmutableTableSpan'SourceNode
    - is-lazy Bool
    - target ImmutableTableRow'SourceNode

tagged(".", .binder)
if is-lazy
    tagged(".", .binder)
put(" ")
is-binding = true
expression(target, 0, false)
is-binding = false
. is-flat = items.length >= 3 && store.is-atom(target) && is-typed-binding
    .. is-typed-binding = items.length >= 4 || brix-is-type-form(store, items[2])
if is-flat && !(store.is-atom(items[2]) && store.text(items[2]) == "_")
    put(" ")
    expression(items[2], brix-level-primary, false)
. spot Size = if is-flat then 3 else 2
=? if items.length <= spot
. value = items[spot]
. fields = store.items(value)
do match fields
    | [.atom(_, "block"), ...]
        put(" =")
        hold(value, 1)
    | [.atom(_, "machine"), ...]
        put(" ~>")
        hold(value, 1)
    | [.atom(_, "pattern"), ...]
        put(" ~")
        . origin Size = 1
        while origin < fields.length && store.is-atom(fields[origin])
            put(" ${store.text(fields[origin])}")
            origin += 1
        hold(value, origin)
    ??
        put(" = ")
        payload(value)

────────────────────
_ do plain
    - node ImmutableTableRow'SourceNode

. items = store.items(node)
. head = store.head(node) ?? ""
. level = if items.length >= 3 then brix-precedence(head) else 0
if level == brix-level-assign && items.length == 3
    is-setting = true
    expression(items[1], brix-level-assign + 1, false)
    is-setting = false
    put(" ")
    put(brix-operator-text(head))
    put(" ")
    payload(items[2])
    =
. shown = called(node)
. outer = store.head(shown) ?? ""
no-prep = outer == "tuple" || (store.count(shown) >= 3 && brix-precedence(outer) > 0)
expression(node, 0, true)
no-prep = false

────────────────────
_ do payload
    - node ImmutableTableRow'SourceNode

expression(node, if store.is-form(called(node), "tuple") then brix-level-closure else 0, true)

────────────────────
_ do condition
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode

expression(items[1], 0, false)
inline-body(node, items, 2)

────────────────────
_ do inline-body
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - origin Size

. end = brix-arm-start(store, node)
if end == origin + 1 && store.is-form(items[origin], "inline")
    put(if origin > 1 then ": " else " ")
    . body = store.item(items[origin], 1)
    expression(body, if store.is-form(body, "tuple") then brix-level-closure else 0, false)
    if end < items.length
        hold(node, end)
else
    hold(node, origin)

────────────────────
_ do assigned
    - value ImmutableTableRow'SourceNode

if store.is-form(value, "block")
    hold(value, 1)
else
    put(" ")
    expression(value, 0, true)

────────────────────
_ do caught
    - node ImmutableTableRow'SourceNode
    - origin Size

. items = store.items(node)
if origin < items.length && !is-blank-slot(items[origin])
    put(" ")
    expression(items[origin], 0, false)
for index in origin + 1 .. < items.length
    put(" <- ")
    expression(items[index], 0, false)

────────────────────
_ do do-block
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - head String

put(if head == "finally" then "do finally" else "do")
. origin Size = 1
if origin < items.length && store.is-form(items[origin], "worker:")
    put(" (")
    expression(store.item(items[origin], 1), 0, false)
    put(")")
    origin += 1
put(brix-do-suffix(head))
. attributed = origin < items.length && is-attribute(items[origin])
while origin < items.length && is-attribute(items[origin])
    put(" ${store.text(items[origin])}")
    origin += 1
. end = brix-arm-start(store, node)
. inline = end == origin + 1 && store.is-form(items[origin], "inline")
if inline && !attributed
    put(" ")
    expression(store.item(items[origin], 1), 0, true)
    if end < items.length
        hold(node, end)
else if inline
    hold(items[origin], 1)
    armed = node
else
    hold(node, origin)

────────────────────
_ do alternative
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - is-tail Bool

put("~ ")
expression(items[1], 0, false)
. origin Size = 2
while origin < items.length && alternative-part(items[origin])
    origin += 1
if is-tail
    hold(node, origin)
else if origin < items.length
    put(" {…}")

────────────────────
_ do alternative-part Bool
    - item ImmutableTableRow'SourceNode

. fields = store.items(item)
do match fields
    | [.atom(_, "of:"), value, ...]
        put(" = ")
        expression(value, 0, false)
        = true
    | [.atom(_, word {it == "in:" || it == "on:"}), ...]
        put(if word == "in:" then " in " else " on ")
        list(fields, 1, " ", 0)
        = true
    ??
        =? false if !is-word(item, "@rollback")
        put(" @rollback")
        = true

────────────────────
_ do state
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - head String

put(if head == "state" then "~> " else if head == "then" then "then " else "?? ")
if items.length > 1
    . target = items[1]
    . fields = store.items(target)
    if store.is-form(target, "call") && fields.length > 1
        put(store.text(fields[1]))
        put("(")
        list(fields, 2, ", ", brix-level-closure)
        put(")")
    else
        put(store.text(target))
. origin Size = 2
if origin < items.length && store.is-form(items[origin], "trigger")
    put(" ")
    trigger(items[origin])
    origin += 1
hold(node, origin)

────────────────────
_ do trigger
    - node ImmutableTableRow'SourceNode

. items = store.items(node)
do match items
    | [_, .atom(_, "for"), subject, source, ...]
        put("for ")
        expression(subject, 0, false)
        put(" on ")
        expression(source, brix-level-assign, false)
        if items.length > 4
            put(" when ")
            expression(items[4], brix-level-select, false)
    | [_, .atom(_, "when-on"), test, source]
        put("when ")
        expression(test, brix-level-select, false)
        put(" on ")
        expression(source, brix-level-assign, false)
    | [_, .atom(_, "on"), source, ...]
        put("on ")
        expression(source, brix-level-assign, false)
        if items.length > 3
            put(" when ")
            expression(items[3], brix-level-select, false)
    | [_, .atom(_, "if-match"), shape, value]
        put("if | ")
        expression(shape, 0, false)
        put(" = ")
        expression(value, brix-level-assign, false)
    | [_, kind, operand]
        . word = store.text(kind)
        . is-axis = word == "children" || word == "descendants" || word == "ancestor"
        put("$word ")
        expression(operand, if is-axis then brix-level-primary else brix-level-assign, false)
    ??
        put(sexp-inline-text(store, node))

────────────────────
_ do property
    - items ImmutableTableSpan'SourceNode

. count = items.length
. last = items[count - 1]
put(store.text(items[1]))
. origin Size = 4
while origin < count && is-attribute(items[origin])
    put(" ${store.text(items[origin])}")
    origin += 1
if !is-blank-slot(items[2])
    put(" ")
    expression(items[2], brix-level-primary, false)
if !is-blank-slot(items[3])
    put(" ")
    expression(items[3], brix-level-primary, false)
=? if origin >= count
. fields = store.items(last)
do match fields
    | [.atom(_, "block"), ...]
        hold(last, 1)
    | [.atom(_, "machine"), ...]
        put(" ~>")
        hold(last, 1)
    | [.atom(_, "=>"), _, ...]
        put(if fields.length > 2 then " => do" else " =>")
        assigned(fields[fields.length - 1])
    | [mark, value]
        put(" ${store.text(mark)}")
        assigned(value)
    ??
        put(" ")
        put(sexp-inline-text(store, last))

────────────────────
_ do variant
    - items ImmutableTableSpan'SourceNode

put("| ")
expression(items[1], brix-level-primary, false)
for index in 2 .. < items.length
    . item = items[index]
    . is-payload = index == 2 && store.is-atom(items[1])
    do match store.items(item)
        | [.atom(_, "="), value]
            put(" = ")
            expression(value, 0, true)
        | [.atom(_, {it == "tuple" && is-payload}), ...]
            is-field = true
            expression(item, brix-level-primary, false)
            is-field = false
        ??
            put(" ")
            expression(item, brix-level-primary, false)

────────────────────
_ do header-line
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode

. raw = store.raw-text(items[1]) if items.length == 2
if raw != null
    put(raw)
    =
do match items
    | [.atom(_, "param"), ...]
        parameter(node, true)
    | [.atom(_, "constraint"), op, left, right]
        put("- ")
        expression(left, brix-level-primary, false)
        put(" ${store.text(op)} ")
        expression(right, 0, false)
    | [.atom(_, "iterates"), name, source]
        put("= ${store.text(name)} ")
        expression(source, 0, false)
    | [_, value]
        put(if store.is-form(node, "implements") then "is " else "using ")
        expression(value, 0, false)
    ??
        put(sexp-inline-text(store, node))

────────────────────
_ do parameter
    - node ImmutableTableRow'SourceNode
    - is-line Bool

. items = store.items(node)
. lead = brix-parameter-mark(store.text(items[1])) if items.length > 1 && store.is-atom(items[1])
. origin Size = if lead != null then 2 else 1
put(lead ?? (if is-line then "- " else ""))
. wrote = false
for index in origin .. < items.length
    . item = items[index]
    if index - origin == 2 && store.is-form(item, "=") && store.count(item) == 2
        put(" = ")
        expression(store.item(item, 1), brix-level-closure, false)
    else if !is-blank-slot(item)
        if wrote
            put(" ")
        expression(item, brix-level-primary, false)
        wrote = true

────────────────────
_ do declaration
    - node ImmutableTableRow'SourceNode

. items = store.items(node)
. raw = store.raw-text(items[1]) if items.length >= 2
if raw != null
    put(raw)
    =
do match items
    | [.atom(_, word {it == "fn-do" || it == "fn-expr"}), access, key, result, ...]
        put("${store.text(access)} ")
        if has-flag(items, ":static")
            put("static ")
        if word == "fn-do" && !is-constructor(key)
            put("do ")
        if has-flag(items, ":set")
            expression(key, brix-level-primary, false)
            put(" = ")
            for index in 4 .. < items.length
                if store.is-form(items[index], "param")
                    parameter(items[index], false)
                    break
            =
        if text-body(items) != null
            put("¶ ")
        if has-flag(items, ":get")
            put("get ")
            expression(key, brix-level-primary, false)
            if !is-blank-slot(result)
                put(" ")
                expression(result, brix-level-primary, false)
            signature-tail(items, 4)
            =
        . spread ImmutableTableRow'SourceNode? = null
        for index in 4 .. < header-count(node)
            if store.is-form(items[index], "over:")
                spread = items[index]
        function-key(key, result, spread)
        signature-tail(items, 4)
    | [.atom(_, word {it.starts-with("fn-from-") || it.starts-with("fn-to-")}), access, other, ...]
        . is-from = word.starts-with("fn-from-")
        put("${store.text(access)} ")
        if word.ends-with("-do")
            put("do ")
        if text-body(items) != null
            put("¶ ")
        put(if is-from then "from " else "to ")
        expression(other, if is-from then 0 else brix-level-primary, false)
        signature-tail(items, 3)
    | [.atom(_, "when-rule"), test, ...]
        put("when ")
        expression(test, 0, false)
    | [.atom(_, "whenever-rule"), test, ...]
        put("whenever ")
        if store.is-form(test, "trigger")
            trigger(test)
        else
            expression(test, 0, false)
    | [.atom(_, "subscribe-for"), source, ...]
        put("for ")
        loop-clause(source)
    | [.atom(_, "subscribe"), source, ...]
        expression(source, 0, false)
    | [.atom(_, {it == "type" || it == "type-line"}), access, name, ...]
        put("${store.text(access)} ")
        expression(name, brix-level-primary, false)
        . index Size = 3
        while index < items.length && type-clause(items[index])
            index += 1
    | [.atom(_, {it == "extend" || it == "extend-line"}), access, name, ...]
        put("${store.text(access)} extend ")
        expression(name, brix-level-primary, false)
        . index Size = 3
        while index < items.length && extend-clause(items[index])
            index += 1
    | [.atom(_, "style"), name, ...]
        put("• ${store.text(name)}")
        . index Size = 2
        while index < items.length && type-clause(items[index])
            index += 1
    | [.atom(_, "style-extend"), name, ...]
        put("• extend ")
        expression(name, brix-level-primary, false)
    | [.atom(_, "prop"), _, _, _, ...]
        property(items)
    ??
        put(sexp-inline-text(store, node))

────────────────────
_ do type-clause Bool
    - item ImmutableTableRow'SourceNode

. fields = store.items(item)
do match fields
    | [.atom(_, "alias"), ...]
        put(" (")
        list(fields, 1, ", ", 0)
        put(")")
        = true
    | [.atom(_, "is"), ...]
        put(" is ")
        list(fields, 1, " || ", brix-level-primary)
        = true
    | [.atom(_, "for"), ...]
        put(" for ")
        list(fields, 1, ", ", 0)
        = true
    ??
        = false

────────────────────
_ do extend-clause Bool
    - item ImmutableTableRow'SourceNode

. fields = store.items(item)
do match fields
    | [.atom(_, "as"), ...]
        put(" as ")
        list(fields, 1, ", ", brix-level-primary)
        = true
    | [.atom(_, "where"), ...]
        put(" where ")
        for position in 1 .. < fields.length
            if position > 1
                put(", ")
            . constraint = store.items(fields[position])
            if constraint.length == 4
                expression(constraint[2], brix-level-primary, false)
                put(" ${store.text(constraint[1])} ")
                expression(constraint[3], brix-level-closure, false)
        = true
    ??
        = false

────────────────────
_ is-constructor Bool
    - key ImmutableTableRow'SourceNode

store.is-atom(name) && store.text(name) == "This"

.. name = if store.is-form(key, "of") && store.count(key) > 1 then store.item(key, 1) else key

────────────────────
_ do signature-tail
    - items ImmutableTableSpan'SourceNode
    - origin Size

. index = origin
while index < items.length && signature-part(items[index], origin != 4)
    index += 1

────────────────────
_ do signature-part Bool
    - item ImmutableTableRow'SourceNode
    - shows-spread Bool

do match item
    | .atom(_, text)
        if text.starts-with("@")
            put(" $text")
        else if text == ":throws"
            put(" throws")
        = true
    | .list(_, start, count)
        do match store.nodes[start .. < start + count]
            | [.atom(_, "over:"), spread, ...]
                if shows-spread
                    put(" ~ ")
                    expression(spread, brix-level-primary, false)
                = true
            | [.atom(_, "?!"), raised, ...]
                put(" ")
                tagged("?!", .raise)
                put(" ")
                if store.is-atom(raised)
                    tagged(store.text(raised), .raise)
                else
                    expression(raised, brix-level-primary, false)
                = true
            ??
                = false
    ??
        = false

────────────────────
_ do function-key
    - key ImmutableTableRow'SourceNode
    - result ImmutableTableRow'SourceNode
    - spread ImmutableTableRow'SourceNode?

. has-result = !is-blank-slot(result)
. items = store.items(key)
do match items
    | [.atom(_, "infix"), left, op, right]
        expression(left, brix-level-primary, false)
        if has-result
            put(" ")
            expression(result, brix-level-primary, false)
        put(" ${brix-operator-text(store.text(op))} ")
        parameter(right, false)
        =
    | [.atom(_, "index-delete"), target, slot]
        put("-= ")
        expression(target, brix-level-primary, false)
        put("[")
        parameter(slot, false)
        put("]")
        =
    | [.atom(_, {it == "index-get" || it == "index-set"}), target, slot, ...]
        expression(target, brix-level-primary, false)
        put("[")
        parameter(slot, false)
        put("]")
        if items.length == 4
            put(" = ")
            parameter(items[3], false)
    | [.atom(_, "prefix"), op, operand]
        . mark = store.text(op)
        put(mark)
        if mark != "!" && mark != "-"
            put(" ")
        expression(operand, brix-level-primary, false)
    ??
        expression(key, brix-level-primary, false)
if spread
    put(" ~ ")
    expression(store.item(spread, 1), brix-level-primary, false)
if has-result
    put(" ")
    expression(result, brix-level-primary, false)

────────────────────
_ do probe
    - items ImmutableTableSpan'SourceNode
    - head String

. is-grouped = head == "probe-group" && items.length > 1
. origin Size = if is-grouped then 2 else 1
put(if head == "probe" then "//!" else if is-grouped then "//${store.text(items[1])}" else "//")
if origin < items.length && !is-blank-slot(items[origin])
    selector(items[origin])
origin += 1
for index in origin .. < items.length
    . item = items[index]
    . fields = store.items(item)
    do match fields
        | [.atom(_, "block"), ...]
            hold(item, 1)
        | [.atom(_, "items:"), ...]
            put(" -> ")
            list(fields, 1, ", ", brix-level-closure)
        | [.atom(_, "text:"), ...]
            put(if origin > 1 && !is-blank-slot(items[origin - 1]) then "// " else " ")
            interpolated(fields, 1, false)
        ??
            probe-value(item, head)
if head == "probe-count" && items.length == 2
    put(" ++")

────────────────────
_ do probe-value
    - item ImmutableTableRow'SourceNode
    - head String

do match head
    |= "probe-count"
        put(" += ")
        expression(item, 0, false)
    |= "probe-assign"
        put(" = ")
        expression(item, 0, false)
    ??
        put(" ")
        statement-inline(item)

────────────────────
_ do statement-inline
    - node ImmutableTableRow'SourceNode

. saved-holder = holder
. saved-start = start
statement(node)
if holder == null
    holder = saved-holder
    start = saved-start

────────────────────
_ do selector
    - node ImmutableTableRow'SourceNode

do match store.items(node)
    | [.atom(_, ":"), target, name]
        expression(target, brix-level-closure, false)
        put(":${store.text(name)}")
    ??
        put(store.text(node))

────────────────────
_ do list
    - items ImmutableTableSpan'SourceNode
    - origin Size
    - separator String
    - minimum Int

for index in origin .. < items.length
    if index > origin
        put(separator)
    expression(items[index], minimum, false)

────────────────────
_ do keyframe-options Size
    - items ImmutableTableSpan'SourceNode
    - origin Size

. index = origin
while index < items.length && brix-is-keyword-head(store.head(items[index]) ?? "")
    put(" ")
    named(items[index], store.items(items[index]), false)
    index += 1
= index

────────────────────
_ do rules Size
    - items ImmutableTableSpan'SourceNode
    - origin Size

. index = origin
while index < items.length && store.is-form(items[index], "•")
    put(if index == origin then " • " else " ")
    rule-use(store.items(items[index]))
    index += 1
= index

────────────────────
_ do rule-use
    - rule ImmutableTableSpan'SourceNode

put(if rule.length > 1 then store.text(rule[1]) else "")
. last = rule.length
. guard ImmutableTableRow'SourceNode? = null
if last > 2 && store.is-form(rule[last - 1], "if:")
    guard = rule[last - 1]
    last -= 1
. barred = no-prep
no-prep = false
if last == 3
    put(":")
    expression(rule[2], brix-level-prefix, false)
else if last > 3
    put("(")
    for position in 2 .. < last
        if position > 2
            put(", ")
        expression(rule[position], brix-level-closure, false)
    put(")")
if guard
    put(" = ")
    expression(store.item(guard, 1), brix-level-assign, false)
no-prep = barred

────────────────────
_ do markup
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - is-tail Bool

. head = store.head(node) ?? ""
if head == "<+" && items.length == 2
    put("<+ (${store.text(items[1])})")
    =
if head != "<>"
    put("+ ")
tagged("<", .markup)
if store.is-atom(items[1])
    tagged(store.text(items[1]), .markup)
else
    expression(items[1], brix-level-primary, false)
. origin Size = 2
. has-id = false
. tags [ImmutableTableRow'SourceNode]
while origin < items.length
    . fields = store.items(items[origin])
    do match fields
        | [.atom(_, "for:"), ...]
            tags += items[origin]
        | [.atom(_, "id:"), name, ...]
            put(" ${store.text(name)}")
            has-id = true
        | [.atom(_, "slot:"), name, ...]
            put(if has-id then "(${store.text(name)})" else " (${store.text(name)})")
        | [.atom(_, "param:"), name, ...]
            put(" - ${store.text(name)}")
            if fields.length > 2
                put(" ")
                expression(fields[2], brix-level-primary, false)
        | [.atom(_, "value:"), value, ...]
            put(" = ")
            guarded(value, brix-level-named, false)
        | [.atom(_, "text:"), value, ...]
            put(" ")
            expression(value, brix-level-primary, false)
        ??
            break
    origin += 1
origin = rules(items, origin)
for position in 0 .. < tags.length
    . binding = store.items(tags[position])
    put(if position == 0 then " for " else ", ")
    put(if binding.length > 1 then store.text(binding[1]) else "")
    if binding.length > 2
        put(" = ")
        expression(binding[2], brix-level-assign, false)
if is-tail
    hold(node, origin)
else if origin < items.length
    put(" {…}")

────────────────────
_ do named
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - is-line Bool

. head = store.head(node) ?? ""
. is-optional = head.ends-with("?")
. name = if is-optional then head[1 .. < head.length - 1] else head[1 ...]
. mark = if is-optional then "?" else ""
. value ImmutableTableRow'SourceNode? = items[1] if items.length > 1
. least = if is-line then brix-level-closure else brix-level-print
if !value
    put("•$mark $name")
    =
. ability = brix-ability(name)
. flag = if store.is-atom(value) then store.text(value) else ""
if ability != null && (flag == "true" || flag == "false") && !is-optional
    . rest = name[ability.length + 1 ...]
    put(if flag == "true" then "• ${ability} $rest" else "• ${ability} !$rest")
    =
put("•$mark $name")
if store.is-form(value, "block") && is-line
    hold(value, 1)
else
    put(" ")
    guarded(value, least, is-line)

────────────────────
_ do guarded
    - node ImmutableTableRow'SourceNode
    - minimum Int
    - is-tail Bool

. barred = no-prep
no-prep = true
expression(node, minimum, is-tail)
no-prep = barred

────────────────────
_ do free
    - node ImmutableTableRow'SourceNode
    - minimum Int
    - is-tail Bool

. barred = no-prep
no-prep = false
expression(node, minimum, is-tail)
no-prep = barred

────────────────────
_ do call
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - origin Size
    - minimum Int
    - is-tail Bool

. named Size = 0
. extra Size = 0
. positional Size = 0
for index in origin + 1 .. < items.length
    do match argument-kind(items[index])
        |= BrixArgument.named
            named += 1
        |= BrixArgument.extra
            extra += 1
        ??
            positional += 1
. has-named = named > 0
. has-extra = extra > 0
. is-tight = minimum > brix-level-named
. is-wrapped = (has-named && (no-prep || is-tight)) || (has-extra && !has-named && is-tight)
if is-wrapped
    put("(")
else if is-tail && tail == null
    tail = node
expression(items[origin], brix-level-primary, false)
if positional > 0 || !(has-named || (has-extra && is-bare(items[items.length - 1])))
    put("(")
    . wrote = false
    for index in origin + 1 .. < items.length
        . item = items[index]
        if argument-kind(item) == BrixArgument.positional
            if wrote
                put(", ")
            free(item, brix-level-closure, false)
            wrote = true
    put(")")
for index in origin + 1 .. < items.length
    trailing(items[index], is-tail && !is-wrapped && index + 1 == items.length)
if is-wrapped
    put(")")

────────────────────
_ is-bare Bool
    - last ImmutableTableRow'SourceNode

store.is-form(last, "inline") || (store.is-form(last, "block") && !brix-is-scope(store, last))

────────────────────
_ do trailing
    - item ImmutableTableRow'SourceNode
    - is-line Bool

. fields = store.items(item)
do match fields
    | [.atom(_, {brix-is-keyword-head(it)}), ...]
        put(" ")
        named(item, fields, is-line)
    | [.atom(_, word {it == "entry" || it == "entry?"}), key, ...]
        put(if word == "entry" then " • (" else " •? (")
        expression(key, brix-level-closure, false)
        put(")")
        if fields.length >= 3
            put(" ")
            guarded(fields[2], if is-line then brix-level-closure else brix-level-print, is-line)
    | [.atom(_, "inline"), body]
        put(": ")
        free(body, 0, is-line)
    | [.atom(_, "block"), ...]
        if is-line
            hold(item, 1)
        else
            put(" {…}")
    ??
        =

────────────────────
_ do binary
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - level Int
    - minimum Int
    - is-tail Bool

. is-wrapped = level < minimum
if is-wrapped
    put("(")
else if is-tail && tail == null && level != brix-level-assign
    tail = node
. head = store.text(items[0])
. op = brix-operator-text(head)
. inner = if op == "||" then brix-level-prefix else level
. count = items.length
for index in 1 .. < count
    . item = items[index]
    if head == "only-if" && index > 1
        item = unguarded(item)
    . held = store.head(item) ?? ""
    . least = if index == 1 then level else level + 1
    if held == "and" && op == "||"
        least = inner
    if index == 1 && held == head
        least = level + 1
    . is-left = index + 1 < count || level >= brix-level-coalesce
    if is-left && level <= brix-level-named && ends-named(item)
        least = brix-level-primary
    if index > 1 && head.starts-with("is") && (held == "all" || held == "|")
        least = 0
    if index == 1 && head == "=" && is-stream-match(item)
        least = 0
    . inner-level = if store.count(item) >= 3 then brix-precedence(held) else 0
    . is-custom = inner-level >= 18 && inner-level <= 20
    if index == 1 && head == "as" && inner-level > 0 && held != "as"
        least = brix-level-primary
    if (level == 12 || level == 13) && is-custom
        least = brix-level-primary
    if level >= 18 && level <= 20 && inner-level > 0 && held != head
        least = brix-level-primary
    if inner-level == brix-level-assign && level != brix-level-assign
        least = brix-level-primary
    if level == brix-level-assign && index > 1 && index + 1 == count && holds-rows(item)
        least = brix-level-named
    if index > 2 && head == "~>" && held == "with" && store.count(item) == 2
        put(" with ")
        expression
            - store.items(item)[1]
            - brix-precedence("or")
            - is-tail && !is-wrapped && index + 1 == count
        continue
    if index > 1
        put(brix-glued-operator(op) ?? " $op ")
    expression(item, least, is-tail && !is-wrapped && index + 1 == count)
if is-wrapped
    put(")")

────────────────────
_ choice-level Int
    - node ImmutableTableRow'SourceNode

if level == brix-level-assign || ends-named(node) then brix-level-primary else brix-level-coalesce

.. level = if store.count(node) >= 3 then brix-precedence(store.head(node) ?? "") else 0

────────────────────
_ do ends-named Bool
    - node ImmutableTableRow'SourceNode

. items = store.items(node)
. count = items.length
=? false if count < 2
. head = store.head(node) ?? ""
=? ends-named(items[1]) if (head == "catch" || head == "catch?") && count == 2
. level = brix-precedence(head)
=? ends-named(unguarded(items[count - 1])) if level > 0 && level <= brix-level-named && count >= 3
=? false if level > 0 || head != "call"
= some(2 .. < count) • where is-bullet-argument(store.head(items[each]) ?? "")

────────────────────
_ is-bullet-argument Bool
    - head String

brix-is-keyword-head(head) || head == "entry" || head == "entry?"

────────────────────
_ do prefix
    - text String
    - node ImmutableTableRow'SourceNode
    - level Int
    - minimum Int
    - is-tail Bool

. is-wrapped = level < minimum
if is-wrapped
    put("(")
put(text)
expression(node, level, is-tail && !is-wrapped)
if is-wrapped
    put(")")

────────────────────
_ do closure
    - items ImmutableTableSpan'SourceNode
    - minimum Int
    - is-tail Bool

. is-wrapped = minimum > brix-level-closure
if is-wrapped
    put("(")
. params = store.items(items[1])
if params.length > 0
    put(":: ")
    for index in 0 .. < params.length
        if index > 0
            put(", ")
        . param = params[index]
        . spread = spread-name(param)
        if spread
            put("... $spread")
            if store.is-form(param, ":")
                put(" ")
                expression(store.items(param)[2], brix-level-primary, false)
        else
            expression(param, if store.is-form(param, ":") then 0 else brix-level-primary, false)
    put(" =>")
else
    put("=>")
. origin Size = 2
if origin < items.length && is-word(items[origin], ":do")
    put(" do")
    origin += 1
if origin < items.length
    . body = items[origin]
    if !store.is-form(body, "block")
        put(" ")
        expression(body, brix-level-closure, is-tail && !is-wrapped)
    else if is-tail && !is-wrapped
        hold(body, 1)
    else
        put(" {…}")
if is-wrapped
    put(")")

────────────────────
_ do spread-name String?
    - param ImmutableTableRow'SourceNode

. name = if store.is-form(param, ":") then store.items(param)[1] else param
=? null if !store.is-atom(name)
. text = store.text(name)
=? null if !text.starts-with("...") || text.length <= 3
. rest = ""
. column = 0
for c in text
    rest ++=? c if column >= 3
    column += 1
= rest

────────────────────
_ do interpolated
    - items ImmutableTableSpan'SourceNode
    - origin Size
    - is-quoted Bool

if is-quoted
    put("\"")
for index in origin .. < items.length
    . part = items[index]
    . is-joined = index + 1 < items.length && continues(items[index + 1])
    do match part
        | .string(_, text)
            put(if is-quoted then brix-escaped(text, true) else brix-line-escaped(text))
        | .atom(_, name)
            if brix-is-name(name) && !is-joined
                put("\$$name")
            else
                braced(part)
        | .list(_, start, count)
            embedded(part, store.nodes[start .. < start + count], is-joined)
        ??
            braced(part)
if is-quoted
    put("\"")

────────────────────
_ do embedded
    - part ImmutableTableRow'SourceNode
    - fields ImmutableTableSpan'SourceNode
    - is-joined Bool

do match fields
    | [.atom(_, word {it == "preview" || it == "snapshot"}), shown, ...]
        . mark = if word == "preview" then "\$?" else "\$!"
        . name = if store.is-atom(shown) then store.text(shown) else ""
        if brix-is-name(name) && !is-joined
            put("$mark$name")
        else
            put("$mark{")
            expression(shown, 0, false)
            put("}")
    ??
        braced(part)

────────────────────
_ do braced
    - part ImmutableTableRow'SourceNode

put("\${")
expression(part, 0, false)
put("}")

────────────────────
_ do range
    - items ImmutableTableSpan'SourceNode
    - head String
    - minimum Int

. is-wrapped = minimum > 17
if is-wrapped
    put("(")
. operands [ImmutableTableRow'SourceNode]
. step ImmutableTableRow'SourceNode? = null
for index in 1 .. < items.length
    if store.is-form(items[index], "by:")
        step = items[index]
    else
        operands += items[index]
if head == "..."
    open-range(operands)
else if operands.length == 2
    expression(operands[0], 18, false)
    put(if head == ".." then " .. " else " .. < ")
    expression(operands[1], 18, false)
if step
    put(" by ")
    expression(store.item(step, 1), 18, false)
if is-wrapped
    put(")")

────────────────────
_ do open-range
    - operands [ImmutableTableRow'SourceNode]

do match operands.length
    |= 2
        put("... ")
        expression(operands[1], 18, false)
    |= 1
        expression(operands[0], 18, false)
        put(" ...")
    ??
        put("...")

────────────────────
_ do expression
    - node ImmutableTableRow'SourceNode
    - minimum Int
    - is-tail Bool

if is-tail && tail == null && minimum <= brix-level-named && ends-tail(node)
    tail = node
do match node
    | .comment(_, text)
        put("` $text")
    | .string(_, text)
        quoted(text)
    | .atom(_, text)
        if is-field || !brix-is-name(text)
            put(text)
        else
            tagged(text, if is-setting then BrixTagKind.setting else if is-binding then BrixTagKind.binder else BrixTagKind.name)
        is-setting = false
    | .list(_, start, count)
        operation(node, store.nodes[start .. < start + count], minimum, is-tail)

────────────────────
_ do operation
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - minimum Int
    - is-tail Bool

do match items
    | []
        put("()")
    | [.atom(_, "call"), _, ...]
        call(node, items, 1, minimum, is-tail)
    | [.atom(_, "scope"), value, ...]
        . is-wrapped = minimum > brix-level-named
        if is-wrapped
            put("(")
        expression(value, minimum, false)
        if is-tail && !is-wrapped
            hold(node, 2)
        else
            put(" {…}")
        if is-wrapped
            put(")")
    | [.atom(_, op {it == "." || it == "?." || it == "*."}), target, _, ...]
        if is-tail && tail == null
            tail = node
        . is-number = is-number-atom(target)
        if is-number
            put("(")
        expression(target, brix-level-primary, false)
        if is-number
            put(")")
        for index in 2 .. < items.length
            put(op)
            is-field = true
            expression(items[index], brix-level-primary, false)
            is-field = false
    | [.atom(_, op {it == "[]" || it == "?[]"}), target, slot]
        expression(target, brix-level-primary, false)
        put(if op == "[]" then "[" else "?[")
        free(slot, 0, false)
        put("]")
    | [.atom(_, "[]"), target]
        expression(target, brix-level-primary, false)
        put("[]")
    | [.atom(_, "!!"), target]
        expression(target, brix-level-postfix, false)
        put("!")
    | [.atom(_, "shape"), shape, value]
        expression(shape, brix-level-primary, false)
        put(":")
        . is-bare = is-bare-shape(value)
        if !is-bare
            put("(")
        expression(value, if is-bare then brix-level-primary else 0, false)
        if !is-bare
            put(")")
    | [.atom(_, "of"), target, ...]
        if is-tail && tail == null
            tail = node
        expression(target, brix-level-primary, false)
        for index in 2 .. < items.length
            . argument = items[index]
            if !is-ticked(argument)
                put("'")
            if is-bare-argument(argument)
                expression(argument, brix-level-primary, false)
            else
                put("(")
                expression(argument, brix-level-closure, false)
                put(")")
    | [.atom(_, op {it == "?" || it == "*" || it == "+"}), target]
        expression(target, brix-level-primary, false)
        put(op)
    | [.atom(_, "channel"), target]
        expression(target, brix-level-primary, false)
        put("<>")
    | [.atom(_, op {it == "exact" || it == "similar"}), target]
        expression(target, brix-level-primary, false)
        put(if op == "exact" then "!" else "~")
    | [.atom(_, op {it == "!" || it == "-" || it == "&"}), operand]
        prefix(op, operand, brix-level-prefix, minimum, is-tail)
    | [.atom(_, "not"), operand]
        prefix("!", operand, brix-level-prefix, minimum, is-tail)
    | [.atom(_, op {brix-is-word-prefix(it)}), operand]
        prefix("$op ", operand, brix-level-prefix, minimum, is-tail)
    | [.atom(_, "~"), operand]
        prefix("~ ", operand, brix-level-closure, minimum, is-tail)
    | [.atom(_, "~"), _, _, ...]
        alternative(node, items, is-tail)
    | [.atom(_, op {it == "|" || it == "<*"}), operand]
        prefix("$op ", operand, brix-level-select, minimum, is-tail)
    | [.atom(_, "list"), ...]
        put("[")
        . barred = no-prep
        no-prep = false
        list(items, 1, ", ", brix-level-closure)
        no-prep = barred
        put("]")
    | [.atom(_, "map"), key, value]
        put("[")
        expression(key, brix-level-primary, false)
        put(" = ")
        expression(value, brix-level-primary, false)
        put("]")
    | [.atom(_, "stream"), item]
        put("<")
        expression(item, brix-level-closure, false)
        put(">")
    | [.atom(_, "tuple"), ...]
        . is-wrapped = minimum > brix-level-tuple || items.length == 2
        . barred = no-prep
        if is-wrapped
            put("(")
            no-prep = false
        list(items, 1, ", ", brix-level-closure)
        no-prep = barred
        if is-wrapped
            put(")")
    | [.atom(_, ":"), left, right]
        . is-wrapped = minimum >= brix-level-prefix
        if is-wrapped
            put("(")
        expression(left, brix-level-primary, false)
        put(" ")
        expression(right, brix-level-primary, false)
        if is-wrapped
            put(")")
    | [.atom(_, {it == "all" || it == "seq"}), ...]
        . is-wrapped = minimum > 2
        if is-wrapped
            put("(")
        list(items, 1, " ", 3)
        if is-wrapped
            put(")")
    | [.atom(_, "|"), _, _, ...]
        . is-wrapped = minimum > 3
        if is-wrapped
            put("(")
        list(items, 1, " | ", 4)
        if is-wrapped
            put(")")
    | [.atom(_, "str"), ...]
        interpolated(items, 1, true)
    | [.atom(_, "char"), value]
        put("'${brix-char-escaped(store.text(value))}'")
    | [.atom(_, "chars"), value]
        put("[${store.text(value)}]")
    | [.atom(_, "{}"), body]
        put("{ ")
        expression(body, 0, false)
        put(" }")
    | [.atom(_, "{}"), target, _, ...]
        expression(target, brix-level-primary, false)
        put("{")
        list(items, 2, ", ", brix-level-closure)
        put("}")
    | [.atom(_, "\\{}"), body]
        put("\\{ ")
        expression(body, 0, false)
        put(" }")
    | [.atom(_, "into"), ...]
        put("into ")
        list(items, 1, ": ", brix-level-primary)
    | [.atom(_, "=>"), _, ...]
        closure(items, minimum, is-tail)
    | [.atom(_, "if-expr"), test, value, otherwise]
        . is-wrapped = minimum > brix-level-closure
        if is-wrapped
            put("(")
        put("if ")
        expression(test, choice-level(test), false)
        put(" then ")
        expression(value, choice-level(value), false)
        put(" else ")
        . is-named = ends-named(otherwise)
        expression
            - otherwise
            - if is-named then brix-level-primary else brix-level-closure
            - is-tail && !is-wrapped && !is-named
        if is-wrapped
            put(")")
    | [.atom(_, op {it == "catch" || it == "catch?"}), operand]
        . is-wrapped = minimum > brix-level-pipe
        if is-wrapped
            put("(")
        put("$op ")
        expression(operand, brix-level-named, is-tail && !is-wrapped)
        if is-wrapped
            put(")")
    | [.atom(_, op {it == "print" || it == "print?"}), operand]
        prefix
            - if op.ends-with("?") then "--? " else "-- "
            - operand
            - brix-level-print
            - minimum
            - is-tail
    | [.atom(_, "##"), operand]
        prefix("##", operand, brix-level-tuple, minimum, is-tail)
    | [.atom(_, op {it == "use" || it == "use?"}), operand]
        prefix("$op ", operand, brix-level-tuple, minimum, is-tail)
    | [.atom(_, op {it == "in" || it == "on"}), _, ...]
        sourced(items, op, minimum)
    | [.atom(_, "each"), _, ...]
        list(items, 1, " ", brix-level-select)
    | [.atom(_, op {brix-is-clause-head(it)}), operand]
        put("$op ")
        expression(operand, brix-level-assign, false)
    | [.atom(_, "keyed-by"), operand]
        put("keyed by ")
        expression(operand, brix-level-assign, false)
    | [.atom(_, "by:"), operand]
        put("by ")
        expression(operand, 18, false)
    | [.atom(_, word {it == "and" || it == "and-for"}), first, ...]
        if is-looped(first)
            list(items, 1, " and ", brix-level-assign)
        else
            binary(node, items, brix-precedence(word), minimum, is-tail)
    | [.atom(_, word {it == "or" || it == "or-for"}), ...]
        if items.length < 3 || is-looped(items[1])
            put("or ")
            list(items, 1, " ", 0)
        else
            binary(node, items, brix-precedence(word), minimum, is-tail)
    | [.atom(_, op {it == ".." || it == "..<" || it == "..."}), ...]
        range(items, op, minimum)
    | [.atom(_, "select"), source, choice]
        . is-wrapped = minimum > brix-level-select
        if is-wrapped
            put("(")
        expression(source, brix-level-pipe, false)
        put(" ")
        expression(choice, brix-level-select, false)
        if is-wrapped
            put(")")
    | [.atom(_, op {it == "match" || it == "match?"}), subject, ...]
        put("$op ")
        expression(subject, 0, false)
        if is-tail
            hold(node, 2)
        else
            put(" {…}")
    | [.atom(_, "block"), ...]
        if is-tail
            hold(node, 1)
        else
            put("{…}")
    | [.atom(_, "inline"), body]
        put(": ")
        expression(body, 0, is-tail)
    | [.atom(_, {it == "<>" || it == "+<>" || it == "<+"}), ...]
        markup(node, items, is-tail)
    | [.atom(_, op {it == "fn-type" || it == "c-fn-type"}), result, ...]
        put(if op == "fn-type" then "() " else "(*C) ")
        expression(result, brix-level-primary, false)
        signature-tail(items, 2)
    | [.atom(_, "c-struct"), ...]
        put("C:(")
        list(items, 1, ", ", brix-level-closure)
        put(")")
    | [.atom(_, "iterate"), _, ...]
        iteration(node, items, is-tail)
    | [.atom(_, op {it == "preview" || it == "snapshot"}), body]
        put(if op == "preview" then "\$?{" else "\$!{")
        free(body, 0, false)
        put("}")
    | [.atom(_, op {brix-is-do-head(it)}), ...]
        do-block(node, items, op)
    | [.atom(_, op {it == "if" || it == "while"}), _, ...]
        put("$op ")
        condition(node, items)
    | [.atom(_, {brix-is-keyword-head(it)}), ...]
        named(node, items, false)
    | [.atom(_, {brix-is-inline-statement(it)}), ...]
        statement-inline(node)
    | [.atom(_, "only-if"), value, ...]
        if is-guard(value) || !is-guard(items[items.length - 1])
            put(sexp-inline-text(store, node))
        else
            binary(node, items, brix-level-if, minimum, is-tail)
    | [.atom(_, op {brix-precedence(it) > 0}), _, _, ...]
        binary(node, items, brix-precedence(op), minimum, is-tail)
    ??
        put(sexp-inline-text(store, node))

────────────────────
_ do sourced
    - items ImmutableTableSpan'SourceNode
    - op String
    - minimum Int

. first = items[1]
. is-binder = binds-clause
binds-clause = false
. is-wrapped = minimum > brix-level-assign
if is-wrapped
    put("(")
. origin = if is-unbound-source(items) then 1 else 2
if origin == 2 && store.is-form(first, "tuple") && store.count(first) > 2
    . is-listed = !is-binder || minimum >= brix-level-closure
    put(if is-listed then "(" else "")
    list(store.items(first), 1, ", ", brix-level-closure)
    put(if is-listed then ") " else " ")
else if origin == 2
    expression(first, if is-stream-match(first) then 0 else brix-level-select, false)
    put(" ")
put(op)
for index in origin .. < items.length
    put(" ")
    expression(items[index], if is-stream-source(items[index]) then 0 else brix-level-select, false)
if is-wrapped
    put(")")
binds-clause = is-binder

────────────────────
_ do loop-clause
    - node ImmutableTableRow'SourceNode

binds-clause = true
expression(node, 0, false)
binds-clause = false

────────────────────
_ do iteration
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - is-tail Bool

. count = items.length
if is-tail
    . body = brix-iterate-body(store, node)
    for index in 1 .. < count
        if index != body && !brix-takes-arm(store, node, items[index])
            if index > 1
                put(" ")
            loop-clause(items[index])
    hold(if body < count then items[body] else node, if body < count then 1 else count)
    armed = node
    =
. last = items[count - 1]
. shown = if store.is-form(last, "block") then count - 1 else count
for index in 1 .. < shown
    if index > 1
        put(" ")
    loop-clause(items[index])
if shown < count
    put(" {…}")

━━━━━━━━━━━━━━━━━━━━
+ brix-is-keyword-head Bool
    - head String

head.length > 1 && head.starts-with(":") && !head.ends-with(":")

━━━━━━━━━━━━━━━━━━━━
+ brix-is-case Bool
    - head String

head == "case" || head == "case?" || head == "case=" || is-union

.. is-union = head == "case-union" || head == "case-union?" || head == "case-union="

━━━━━━━━━━━━━━━━━━━━
+ brix-operator-text String
    - head String

match head
    |= "only-if"
        "if"
    |= "is-in"
        "is in"
    |= "not-in"
        "not in"
    |= "has-not"
        "has not"
    |= "is-not"
        "is not"
    |= "is!-not"
        "is! not"
    |= "is~-not"
        "is~ not"
    |= "and"
        "&&"
    |= "or"
        "||"
    ??
        head

━━━━━━━━━━━━━━━━━━━━
+ brix-precedence Int
    - head String

|? head == "??"
    brix-level-coalesce
|? head == "only-if"
    brix-level-if
|? is-assign
    brix-level-assign
|? is-pipe
    brix-level-pipe
|? head == "or"
    10
|? head == "and"
    11
|? head == "<" || head == ">" || head == "<=" || head == ">="
    12
|? head == "==" || head == "!="
    13
|? head == "as"
    14
|? is-test
    15
|? is-shift
    16
|? is-additive
    21
|? head == "*" || head == "/" || head == "%" || head == "%%"
    22
|? bytes.length < 3 || bytes[0] != 47 || bytes[bytes.length - 1] != 47
    0
|? head.starts-with("///")
    18
|? head.starts-with("//")
    19
??
    20

.. is-assign = is-update || is-guarded || head == "=" || head == "++=" || head == "<-*"
    .. is-update = head == "+=" || head == "-=" || head == "*=" || head == "/=" || is-modulo
    .. is-modulo = head == "%=" || head == "%%="
    .. is-guarded = is-guarded-update || head == "=?" || head == "++=?" || head == "<-*?"
        .. is-guarded-update = head == "+=?" || head == "-=?" || head == "*=?" || head == "/=?" || is-guarded-modulo
        .. is-guarded-modulo = head == "%=?" || head == "%%=?"
.. is-pipe = is-stage || is-flow || head == "|>" || head == "|=>" || head == "<|"
    .. is-stage = head == "*>" || head == "?>" || head == "*|>" || head == "?*>"
    .. is-flow = head == "*->" || head == "->" || head == "~>"
.. is-test = is-membership || is-kind || head == "is" || head == "is-not"
    .. is-membership = head == "is-in" || head == "not-in" || head == "has" || head == "has-not"
    .. is-kind = head == "is!" || head == "is!-not" || head == "is~" || head == "is~-not"
.. is-shift = is-move || head == "?>>" || head == "?<<" || head == "?<-"
    .. is-move = head == ">>" || head == "<<" || head == "<-"
.. is-additive = is-sum || head == "\\" || head == "*\\" || head == "*/"
    .. is-sum = head == "+" || head == "-" || head == "++" || head == "--"
.. bytes = byte-view(head)

━━━━━━━━━━━━━━━━━━━━
_ brix-glued-operator String?
    - op String

|? op == "?<-"
    "? <- "
|? op == "?>>"
    "? >> "
|? op == "?<<"
    "? << "

━━━━━━━━━━━━━━━━━━━━
+ do brix-is-name Bool
    - text String

. bytes = byte-view(text)
=? false if bytes.length == 0 || bytes[0] < 97 || bytes[0] > 122
= all(bytes) • where each == 45 || (each >= 48 && each <= 57) || (each >= 97 && each <= 122)

━━━━━━━━━━━━━━━━━━━━
+ brix-quoted String
    - value String

"\"${brix-escaped(value, true)}\""

━━━━━━━━━━━━━━━━━━━━
+ brix-escaped String
    - value String
    - is-quoted Bool

"".join(brix-escaped-char(each, is-quoted) in value)

━━━━━━━━━━━━━━━━━━━━
+ do brix-line-escaped String
    - value String

. chars = value.codepoints
. parts [String]
for index in 0 .. < chars.length
    . c = chars[index]
    . next = if index + 1 < chars.length then chars[index + 1] else ' '
    if c == '\\' || (c == '$' && brix-leads-embed(next))
        parts += "\\$c"
    else
        parts += "$c"
= "".join(parts)

━━━━━━━━━━━━━━━━━━━━
_ BrixArgument is U8

| positional
| named
| extra

━━━━━━━━━━━━━━━━━━━━
_ brix-do-suffix String
    - head String

match head
    |= "do-new"
        " new"
    |= "do-new-thread"
        " new thread"
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ brix-parameter-mark String?
    - text String

|? text == "..."
    "... "
??
    null

━━━━━━━━━━━━━━━━━━━━
_ brix-is-word-prefix Bool
    - head String

head == "-=" || head == "<-" || head == "type-of" || head == "facts-of"

━━━━━━━━━━━━━━━━━━━━
_ brix-is-clause-head Bool
    - head String

head == "when" || head == "whenever" || head == "while" || head == "until"

━━━━━━━━━━━━━━━━━━━━
_ brix-is-inline-statement Bool
    - head String

brix-is-case(head) || head == "case-each" || head == "default" || is-plain

.. is-plain = head == "throw" || head == "return" || head == "let" || head == "lazy" || head == "for"

━━━━━━━━━━━━━━━━━━━━
_ brix-is-yield Bool
    - head String

head == "return?" || head == "yield" || head == "yield?" || is-yield-all

.. is-yield-all = head == "yield-all" || head == "yield-all?"

━━━━━━━━━━━━━━━━━━━━
_ brix-is-do-head Bool
    - head String

head == "do" || head == "do-new" || head == "do-new-thread" || head == "finally"

━━━━━━━━━━━━━━━━━━━━
_ brix-is-bullet Bool
    - head String

head == "bullet" || head == "bullet*" || head == "bullet?" || head == "bullet*?"

━━━━━━━━━━━━━━━━━━━━
_ brix-is-header-head Bool
    - head String

head == "param" || head == "constraint" || head == "iterates" || is-binding

.. is-binding = head == "implements" || head == "using"

━━━━━━━━━━━━━━━━━━━━
_ brix-is-probe Bool
    - head String

head == "probe" || head == "probe-count" || head == "probe-group" || is-probe-write

.. is-probe-write = head == "probe-assign" || head == "probe-log"

━━━━━━━━━━━━━━━━━━━━
_ brix-case-mark String
    - head String

match head
    |= "case"
        "|"
    |= "case?"
        "|?"
    |= "case="
        "|="
    |= "case-union"
        "||"
    |= "case-union?"
        "||?"
    ??
        "||="

━━━━━━━━━━━━━━━━━━━━
_ brix-return-mark String
    - head String

match head
    |= "return?"
        "=?"
    |= "yield"
        "<="
    |= "yield?"
        "<=?"
    |= "yield-all"
        "<<="
    ??
        "<<=?"

━━━━━━━━━━━━━━━━━━━━
_ brix-starts-divider Bool
    - text String

chars.length > 0 && (first == '━' || first == '─' || first == '═')

.. chars = text.codepoints
.. first = chars[0]

━━━━━━━━━━━━━━━━━━━━
_ brix-continues-name Bool
    - text String

bytes.length > 0 && (byte == 45 || byte == 46 || is-digit || is-lower)

.. bytes = byte-view(text)
.. byte = bytes[0]
.. is-digit = byte >= 48 && byte <= 57
.. is-lower = byte >= 97 && byte <= 122

━━━━━━━━━━━━━━━━━━━━
_ brix-escaped-char String
    - c Char
    - is-quoted Bool

|? c == '\\' || ((c == '"' || c == '$') && is-quoted)
    "\\$c"
|? c == '\n' && is-quoted
    "\\n"
|? c == '\t' && is-quoted
    "\\t"
|? c == '\r'
    "\\r"
|? is-quoted && short != null
    short
|? is-quoted && brix-is-control(c)
    brix-unicode-escape(c)
??
    c as String

.. short = brix-short-escape(c)

━━━━━━━━━━━━━━━━━━━━
_ brix-leads-embed Bool
    - c Char

c == '{' || c == '°' || (c >= 'a' && c <= 'z') || is-greek

.. code = c as U32
.. is-greek = (code >= 913 && code <= 937) || (code >= 945 && code <= 969)

━━━━━━━━━━━━━━━━━━━━
_ brix-char-escaped String
    - value String

"".join(brix-char-escaped-char(each) in value)

━━━━━━━━━━━━━━━━━━━━
_ brix-char-escaped-char String
    - c Char

|? c == '\\' || c == '\''
    "\\$c"
|? c == '\n'
    "\\n"
|? c == '\t'
    "\\t"
|? c == '\r'
    "\\r"
|? short != null
    short
|? brix-is-control(c)
    brix-unicode-escape(c)
??
    c as String

.. short = brix-short-escape(c)

━━━━━━━━━━━━━━━━━━━━
_ brix-short-escape String?
    - c Char

match? c as U32
    |= 8
        "\\b"
    |= 11
        "\\v"
    |= 12
        "\\f"

━━━━━━━━━━━━━━━━━━━━
_ brix-is-control Bool
    - c Char

code < 32 || code == 127 || code == 133 || code == 8232 || code == 8233 || code == 64976

.. code = c as U32

━━━━━━━━━━━━━━━━━━━━
_ brix-unicode-escape String
    - c Char

|? code == 0
    "\\0"
|? code >= 256
    "\\u$high$low"
??
    "\\x$low"

.. code = c as U32
.. digits = "0123456789abcdef".codepoints
.. high = "${digits[(code / 4096) % 16]}${digits[(code / 256) % 16]}"
.. low = "${digits[(code / 16) % 16]}${digits[code % 16]}"

━━━━━━━━━━━━━━━━━━━━
_ do brix-ability String?
    - name String

for ability in ["is", "has", "can", "does", "should", "must"]
    =? ability if name.starts-with("${ability}-") && name.length > ability.length + 1
= null
