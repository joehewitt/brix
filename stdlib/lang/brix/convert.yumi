./brix
./layout
./parse
/code/structure/document
/data/sexp
/data/source-sexp
/data/source-tree

━━━━━━━━━━━━━━━━━━━━
+ do brix-yumi-text String ?! SexpError
    - source String

. document = use brix-document-read(source)
= "\n".join(document.view-lines())

━━━━━━━━━━━━━━━━━━━━
+ do brix-convert String ?! BrixSyntaxError
    - source String

. language = BrixLanguage()
. store = use language.store
= sexp-text(store, brix-woven(language, source), BrixLayout(store))
