/core/table
/data/source-sexp
/data/source-tree

━━━━━━━━━━━━━━━━━━━━
+ BrixLayout
    is SexpLayout

_ store SourceStore

────────────────────
+ This
    - store

────────────────────
+ do header-count Int?
    - node ImmutableTableRow'SourceNode

. items = store.items(node)
. head = store.head(node)
=? null if !head
. is-piped = head == "pipe" && items.length > 1
=? 3 if is-piped && store.is-atom(items[1]) && store.text(items[1]) == "~>"
if head == "for"
    . listed = items.length > 1
    for position in 1 .. < items.length
        listed = listed && store.is-atom(items[position])
    =? items.length if listed
if head == "keyframes"
    = if items.length > 2 && store.is-form(items[2], "param") then 5 else 4
. fixed = brix-fixed-header(head)
=? fixed if fixed != null
. first = brix-leading-header(head)
=? null if first == null
. count = first
. is-type = head == "type" || head == "extend" || head == "style" || head == "style-extend"
. is-function = brix-is-callable(head)
. is-setter = false
while count < items.length && is-attribute(items[count], is-type)
    . item = items[count]
    if is-function && store.is-list(item) && (store.head(item) ?? "").starts-with(":")
        break
    is-setter = is-setter || (store.is-atom(item) && store.text(item) == ":set")
    count += 1
= if is-setter && count < items.length then count + 1 else count

────────────────────
+ wrapper String?
    - node ImmutableTableRow'SourceNode

"main" if !(store.is-comment(node) || brix-is-top(store.head(node) ?? ""))

────────────────────
+ is-apart Bool
    - node ImmutableTableRow'SourceNode

brix-is-divided(store.head(node) ?? "")

────────────────────
_ is-attribute Bool
    - node ImmutableTableRow'SourceNode
    - is-type Bool

|? !text
    false
|? is-type && (text == "is" || text == "alias" || text == "as" || text == "where" || text == "for")
    true
|? bytes.length == 0
    false
|? bytes[0] == 58 || bytes[0] == 64 || bytes[bytes.length - 1] == 58
    true
??
    text == "?!" || text == "•" || text == "trigger"

.. text = if store.is-atom(node) then store.text(node) else store.head(node)
.. bytes = text as Byte[]

━━━━━━━━━━━━━━━━━━━━
+ brix-is-divided Bool
    - head String

brix-is-callable(head) || head == "content" || types has head || rules has head

.. types = ["type", "extend", "style", "style-extend"]
.. rules = ["when-rule", "whenever-rule", "subscribe", "subscribe-for"]

━━━━━━━━━━━━━━━━━━━━
+ brix-is-callable Bool
    - head String

["fn-do", "fn-expr", "fn-from-do", "fn-from-expr", "fn-to-do", "fn-to-expr"] has head

━━━━━━━━━━━━━━━━━━━━
+ brix-is-top Bool
    - head String

brix-is-divided(head) || rows has head

.. rows = ["import", "export", "prop", "type-line", "extend-line", "unit", "blank", "raw", "unparsed"]

━━━━━━━━━━━━━━━━━━━━
_ brix-fixed-header Int?
    - head String

match? head
    |= "block"
        1
    |= "before"
        1
    |= "where"
        1
    |= "content"
        1
    |= "machine"
        1
    |= "else"
        1
    |= "default"
        1
    |= "finally"
        1
    |= "pattern"
        1
    |= "paragraph"
        1
    |= "scope"
        2
    |= "if"
        2
    |= "else-if"
        2
    |= "while"
        2
    |= "for"
        2
    |= "or-for"
        2
    |= "and-for"
        2
    |= "when-style"
        2
    |= "else-state"
        2
    |= "match"
        2
    |= "match?"
        2
    |= "case"
        2
    |= "case?"
        2
    |= "case="
        2
    |= "case-union"
        2
    |= "case-union?"
        2
    |= "case-union="
        2
    |= "case-each"
        2
    |= "on-error"
        2
    |= "when-rule"
        2
    |= "subscribe"
        2
    |= "subscribe-for"
        2
    |= "do-use"
        2
    |= "do-use?"
        2
    |= "do-with"
        3

━━━━━━━━━━━━━━━━━━━━
_ brix-leading-header Int?
    - head String

match? head
    |= "fn-do"
        4
    |= "fn-expr"
        4
    |= "fn-from-do"
        3
    |= "fn-from-expr"
        3
    |= "fn-to-do"
        3
    |= "fn-to-expr"
        3
    |= "type"
        3
    |= "extend"
        3
    |= "style"
        2
    |= "style-extend"
        2
    |= "rule"
        2
    |= "track"
        2
    |= "own-rule"
        2
    |= "whenever-rule"
        2
    |= "<>"
        2
    |= "+<>"
        2
    |= "~"
        2
    |= "state"
        2
    |= "then"
        2
    |= "do"
        1
    |= "do-new"
        1
    |= "do-new-thread"
        1
