(import ./brix)
(import ./layout)
(import ./parse)
(import /code/structure/document)
(import /data/sexp)
(import /data/source-sexp)
(import /data/source-tree)

(fn-do + brix-yumi-text String (?! SexpError)
  (param source String)
  (let document (use (call brix-document-read source)))
  (return (call (. "\n" join) (call (. document view-lines))))
)

(fn-do + brix-convert String (?! BrixSyntaxError)
  (param source String)
  (let language (call BrixLanguage))
  (let store (use (. language store)))
  (return (call sexp-text store (call brix-woven language source) (call BrixLayout store)))
)
