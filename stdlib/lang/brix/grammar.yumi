    ~ "." \decimal-digit-sequence \exponent-part? \unit?

.. decimal-float-tail ~
    ~ \decimal-fraction \exponent-part?
    ~ \exponent-part

.. decimal-fraction ~
    ~ "." \decimal-digit-sequence?

.. decimal-integer-literal ~
    ~ "0"
    ~ \non-zero-decimal-digit-sequence

.. non-zero-decimal-digit-sequence ~
    ~ [1-9] [0-9]* \decimal-digit-separator*

.. decimal-digit-sequence ~
    ~ [0-9] [0-9]* \decimal-digit-separator*

.. decimal-digit-separator ~
    ~ "'" [0-9]+

.. decimal-digit ~
    ~ [0-9]

.. hex-digit ~
    ~ [0-9a-fA-F]

.. surrogate-escape ~
    ~ "\\u" [dD] [89a-fA-F]

.. hex-digit-sequence ~
    ~ [0-9a-fA-F] [0-9a-fA-F]* \hex-digit-separator*

.. hex-digit-separator ~
    ~ "'" [0-9a-fA-F]+

.. exponent-part ~
    ~ [eE] \signed-integer

.. signed-integer ~
    ~ !([+-] "'") [+-] \decimal-digit-sequence
    ~ \decimal-digit-sequence

.. unit String ~
    ~ [a-z] [a-z0-9]*
    ~ [$\u20ac\u00a3\u00a5\u00a2\u20b9\u20a8\u20b1\u20a9\u0e3f\u20ab\u20aa]
    ~ [%\u00b5°] [%\u00b5a-zA-Z-0-9]*

.. bool ImmutableTableRow'SourceNode ~
    ~ "true"
        bx.atom(location, "true")
    ~ "false"
        bx.atom(location, "false")

.. access String ~
    ~ "+"
    ~ "_"
    ~ "^"

.. infix-operator String ~
    ~ \increment-operator
    ~ \add-operator
    ~ \multiply-operator
    ~ \write-operator
    ~ \glt-compare-operator
    ~ \compare-operator
    ~ \contain-operator

.. increment-operator String ~
    ~ "+="
    ~ "-="
    ~ "*="
    ~ "/="
    ~ "%="
    ~ "%%="
    ~ "++="

.. user-operator-1 String ~
    ~ "/" \name "/"

.. user-operator-2 String ~
    ~ "//" \name "//"

.. user-operator-3 String ~
    ~ "///" \name "///"

.. add-operator String ~
    ~ "++"
    ~ "+"
    ~ "-"

.. multiply-operator String ~
    ~ "*"
    ~ "/"
    ~ "%%"
    ~ "%"

.. prefix-operator String ~
    ~ "!"
        "not"
    ~ "-=" /
        "-="
    ~ "-"
    ~ "<-" /
        "<-"
    ~ "type-of"  //
        "type-of"
    ~ "facts-of"  //
        "facts-of"

.. postfix-operator String ~
    ~ "!" !"="
        "!!"

.. coalesce-operator String ~
    ~ "??"

.. if-operator String ~
    ~ "if"
        "only-if"

.. assign-operator String ~
    ~ "="
    ~ "<-*"
    ~ \increment-operator

.. pipeline-operator String ~
    ~ "*>"
    ~ "?>"
    ~ "|>"
    ~ "|=>"
    ~ "*|>"
    ~ "?*>"
    ~ "*->"
    ~ "->"
    ~ "<|"

.. logical-and-operator String ~
    ~ "&&"
        "and"

.. logical-or-operator String ~
    ~ "||"
        "or"

.. glt-compare-operator String ~
    ~ "<" !"="
        "<"
    ~ ">" !"="
        ">"
    ~ "<="
    ~ ">="

.. compare-operator String ~
    ~ "=="
    ~ "!="

.. as-operator String ~
    ~ "as"

.. is-operator String ~
    ~ \contain-operator
    ~ "is!" is-not (// "not")?
        if is-not then "is!-not" else "is!"
    ~ "is~" is-not (// "not")?
        if is-not then "is~-not" else "is~"
    ~ "is" is-not (// "not")?
        if is-not then "is-not" else "is"

.. contain-operator String ~
    ~ "is" // "in"
        "is-in"
    ~ "not" // "in"
        "not-in"
    ~ "has" // "not"
        "has-not"
    ~ "has"
        "has"

.. compose-operator String ~
    ~ ">>"
    ~ "<<"
    ~ \write-operator

.. write-operator String ~
    ~ "<-"

.. clause-operator String ~
    ~ "whenever"
    ~ "when"
    ~ "while"
    ~ "until"

.. ws ~
    ~ " " | "\t"
