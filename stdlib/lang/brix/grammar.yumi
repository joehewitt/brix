./build
/core/parsing
/core/table
/data/source-tree

━━━━━━━━━━━━━━━━━━━━
+ BrixEntry is Union

| whole-file
| statement-row
| member-row
| rule-row
| use-row
| state-row
| keyframe-row
| prose-row
| head-row
| header-row

━━━━━━━━━━━━━━━━━━━━
+ brix-grammar ~ Char
    - bx BrixBuilder
    - entry BrixEntry

~ !\{ entry != BrixEntry.whole-file } / v \statements /
    bx.form(location, "file", v)
~ / v \row
    v

.. row ImmutableTableRow'SourceNode ~
    ~ &\{ entry == BrixEntry.statement-row } v \statement-row
        v
    ~ &\{ entry == BrixEntry.member-row } v \member-row
        v
    ~ &\{ entry == BrixEntry.rule-row } v \rule-row
        v
    ~ &\{ entry == BrixEntry.use-row } v \use-row
        v
    ~ &\{ entry == BrixEntry.state-row } v \state-row
        v
    ~ &\{ entry == BrixEntry.keyframe-row } v \keyframe-statement \row-end
        v
    ~ &\{ entry == BrixEntry.prose-row } v \string-block \row-end
        v
    ~ &\{ entry == BrixEntry.head-row } v \head-row
        v
    ~ &\{ entry == BrixEntry.header-row } v \header-row
        v

.. statement-row ImmutableTableRow'SourceNode ~
    ~ v \else-if-branch \row-end
        v
    ~ v \else-branch \row-end
        v
    ~ v \catch \row-end
        v
    ~ v \or-loop \row-end
        v
    ~ v \and-loop \row-end
        v
    ~ v \statement \row-end
        v

.. member-row ImmutableTableRow'SourceNode ~
    ~ v \keyframe-member \row-end
        v
    ~ v \own-rule-row \row-end
        v
    ~ v \style-rule-member \row-end
        v
    ~ v \member \row-end
        v
    ~ \statement-row

.. rule-row ImmutableTableRow'SourceNode ~
    ~ v \own-rule-row \row-end
        v
    ~ v \style-rule-member \row-end
        v
    ~ \statement-row

.. own-rule-row ImmutableTableRow'SourceNode ~
    ~ "•" // "own" // name \style-selector-name arg \style-rule-inline-argument? rules \style-rule-applications?
        bx.form(location, "own-rule", bx.atom(location, name), arg, rules)

.. use-row ImmutableTableRow'SourceNode ~
    ~ "•" // !("own" //) v \style-rule-application \row-end
        v
    ~ \rule-row

.. state-row ImmutableTableRow'SourceNode ~
    ~ v \state-case \row-end
        v
    ~ v \state-continuation \row-end
        v
    ~ v \state-fallback \row-end
        v
    ~ \statement-row

.. head-row ImmutableTableRow'SourceNode ~
    ~ v \extension-block \row-end
        v
    ~ v \style-sheet-extension-block \row-end
        v
    ~ v \style-sheet-block \row-end
        v
    ~ v \class-block \row-end
        v
    ~ v \function-block \row-end
        v

.. header-row ImmutableTableRow'SourceNode ~
    ~ v \class-header-declaration \row-end
        v
    ~ v \argument \row-end
        v

.. row-end ~
    ~ / \nl* !.

.. row-block ImmutableTableRow'SourceNode ~
    ~ \block
    ~ \unwritten-block

.. unwritten-block ImmutableTableRow'SourceNode ~
    ~ &\{ entry != BrixEntry.whole-file } &\row-end
        bx.form(location, "block")

.. open ~
    ~ "{"
    ~ "≤"

.. open-string ~
    ~ "Æ"

.. open-header ~
    ~ "═"

.. close ~
    ~ "}"
    ~ "≥"

.. statements ImmutableTableRow'SourceNode ~
    ~ \nl* lines \statement-line* / \nl?
        bx.some(lines)

.. statement-line ImmutableTableRow'SourceNode? ~
    ~ / s \statement / (\nl | &\close)
        s
    ~ / \nl
        null

.. block ImmutableTableRow'SourceNode ~
    ~ \indented-block-expression
    ~ \inline-block-expression

.. indented-block-expression ImmutableTableRow'SourceNode ~
    ~ \open s \statements / \close
        bx.form(location, "block", s)

.. inline-block-expression ImmutableTableRow'SourceNode ~
    ~ ":" / expr \print-block
        bx.form(location, "inline", expr)
    ~ ":" / expr \multi-line-expression
        bx.form(location, "inline", expr)

.. block-statements ImmutableTableRow'SourceNode ~
    ~ \nl* lines \statement-line+ / \nl?
        bx.some(lines)

.. block-or-expression ImmutableTableRow'SourceNode ~
    ~ // expr \multi-line-expression
        expr
    ~ / blk \row-block
        blk

.. block-or-expression-no-prep ImmutableTableRow'SourceNode ~
    ~ // expr \multi-line-expression-no-prep
        expr
    ~ / blk \row-block
        blk

.. block-or-inline-expression ImmutableTableRow'SourceNode ~
    ~ // expr \print-block
        expr
    ~ // expr \inline-expression
        expr
    ~ / blk \row-block
        blk

.. statement ImmutableTableRow'SourceNode ~
    ~ \import-statement
    ~ \string-block
    ~ \header-block
    ~ \extension-block
    ~ \style-sheet-extension-block
    ~ \style-sheet-block
    ~ \effect-declaration
    ~ \class-block
    ~ \function-block
    ~ \state-machine-declaration
    ~ \property-declaration
    ~ \unit-declaration
    ~ \if-block
    ~ \while-block
    ~ \style-when-statement
    ~ \for-block
    ~ \do-block
    ~ \return-statement
    ~ \pipeline-statement
    ~ \feed-statement
    ~ \pattern-helper-clause
    ~ \call-argument-line
    ~ \declaration
    ~ \assertion
    ~ \probe
    ~ \state-case
    ~ \attached-catch
    ~ \print-block
    ~ \multi-line-expression
    ~ \noop
    ~ \return-statement-final

.. state-machine-block ImmutableTableRow'SourceNode ~
    ~ \open statements \state-machine-statements / \close
        bx.form(location, "machine", statements)

.. machine-row-block ImmutableTableRow'SourceNode ~
    ~ \state-machine-block
    ~ &\{ entry != BrixEntry.whole-file } &\row-end
        bx.form(location, "machine")

.. state-machine-statements ImmutableTableRow'SourceNode ~
    ~ \nl* head \state-machine-first-line tail \state-machine-line* / \nl?
        bx.seq(head, bx.some(tail))

.. state-machine-first-line ImmutableTableRow'SourceNode ~
    ~ / statement \state-case / (\nl | &\close)
        statement

.. state-machine-line ImmutableTableRow'SourceNode? ~
    ~ / statement \state-machine-item / (\nl | &\close)
        statement
    ~ / \nl
        null

.. state-machine-item ImmutableTableRow'SourceNode ~
    ~ \state-case
    ~ \state-fallback

.. state-body-block ImmutableTableRow'SourceNode ~
    ~ \open statements \state-body-statements / \close
        statements

.. state-body-statements ImmutableTableRow'SourceNode ~
    ~ \nl* lines \state-body-line+ / \nl?
        bx.some(lines)

.. state-body-line ImmutableTableRow'SourceNode? ~
    ~ / statement \state-body-statement / (\nl | &\close)
        statement
    ~ / \nl
        null

.. state-body-statement ImmutableTableRow'SourceNode ~
    ~ \state-case
    ~ \state-continuation
    ~ \state-fallback
    ~ \statement

.. state-case ImmutableTableRow'SourceNode ~
    ~ "~>" // n \name values \state-target-values? trigger \state-trigger? body \state-body-block?
        bx.form(location, "state", bx.invoke(location, bx.atom(location, n), values), trigger, body)

.. state-continuation ImmutableTableRow'SourceNode ~
    ~ "then" // n \name values \state-target-values? trigger \state-trigger? body \state-body-block?
        bx.form(location, "then", bx.invoke(location, bx.atom(location, n), values), trigger, body)

.. state-fallback ImmutableTableRow'SourceNode ~
    ~ "??" // n \name values \state-target-values?
        bx.form(location, "else-state", bx.invoke(location, bx.atom(location, n), values))

.. state-target-values ImmutableTableRow'SourceNode ~
    ~ "(" / values \delimited(",", ~ \inline-expression-no-comma)? / ")"
        bx.many(values)

.. state-trigger ImmutableTableRow'SourceNode ~
    ~ // "whenever" // watched \bulleted-expression
        bx.form(location, "trigger", bx.atom(location, "whenever"), watched)
    ~ // "for" // pattern \structure-pattern // "on" // stream \bulleted-expression guard \state-when-guard?
        bx.form(location, "trigger", bx.atom(location, "for"), pattern, stream, guard)
    ~ // "when" // guard \state-guard-expression // "on" // stream \bulleted-expression
        bx.form(location, "trigger", bx.atom(location, "when-on"), guard, stream)
    ~ // "on" // stream \bulleted-expression guard \state-when-guard?
        bx.form(location, "trigger", bx.atom(location, "on"), stream, guard)
    ~ // "if" // pattern \structure-match // "=" // subject \bulleted-expression
        bx.form(location, "trigger", bx.atom(location, "if-match"), pattern, subject)
    ~ // "if" // condition \bulleted-expression
        bx.form(location, "trigger", bx.atom(location, "if"), condition)
    ~ // "when" // stream \bulleted-expression
        bx.form(location, "trigger", bx.atom(location, "when"), stream)

.. state-when-guard ImmutableTableRow'SourceNode ~
    ~ // "when" // guard \state-guard-expression
        guard

.. state-guard-expression ImmutableTableRow'SourceNode ~
    ~ \apply-expression

.. multi-line-expression ImmutableTableRow'SourceNode ~
    ~ \block-construct
    ~ \call-block

.. multi-line-expression-no-prep ImmutableTableRow'SourceNode ~
    ~ \block-construct
    ~ \inline-expression-no-prep

.. block-construct ImmutableTableRow'SourceNode ~
    ~ \task-block
    ~ \match-block
    ~ \iterator-block
    ~ \structure-match-block
    ~ \stream-match-block
    ~ \for-block
    ~ \use-block
    ~ \closure-block
    ~ \latest-block
    ~ \slot-outlet
    ~ \markup

.. extension-block ImmutableTableRow'SourceNode ~
    ~ \open \nl acc \access // "extend" // receiver \type as-types \extension-as? constraints \extension-where? body \class-body? / \nl* / \close
        bx.form(location, "extend", bx.atom(location, acc), receiver, as-types, constraints, body)
    ~ acc \access // "extend" // receiver \type as-types \extension-as? constraints \extension-where?
        bx.form(location, "extend-line", bx.atom(location, acc), receiver, as-types, constraints)

.. extension-as ImmutableTableRow'SourceNode ~
    ~ // "as" // types \delimited(",", ~ \type)
        bx.form(location, "as", bx.many(types))

.. extension-where ImmutableTableRow'SourceNode ~
    ~ // "where" // constraints \delimited(",", ~ \type-constraint-declaration)
        bx.form(location, "where", bx.many(constraints))

.. style-sheet-extension-block ImmutableTableRow'SourceNode ~
    ~ \open \nl "•" // "extend" // receiver \type header \class-header-block? body \class-body? / \nl* / \close
        bx.form(location, "style-extend", receiver, header, body)

.. style-sheet-block ImmutableTableRow'SourceNode ~
    ~ \open \nl "•" // id \type-name derived \sheet-derivation? header \class-header-block? body \class-body? / \nl* / \close
        bx.form(location, "style", bx.atom(location, id), derived, header, body)

.. sheet-derivation ImmutableTableRow'SourceNode ~
    ~ // "is" // base \type tags \sheet-tags?
        bx.seq
            - bx.form(location, "is", base)
            - tags

.. sheet-tags ImmutableTableRow'SourceNode ~
    ~ // "for" // tags \delimited(",", ~ \sheet-tag)
        bx.form(location, "for", bx.many(tags))

.. sheet-tag ImmutableTableRow'SourceNode ~
    ~ n \name
        bx.atom(location, n)

.. class-block ImmutableTableRow'SourceNode ~
    ~ \open \nl header \class-line body \class-body? / \nl* / \close
        bx.form(location, "type", header, body)
    ~ header \class-line
        bx.form(location, "type-line", header)

.. class-line ImmutableTableRow'SourceNode ~
    ~ acc \access // id \type-name type-args \type-argument* aliases \class-aliases? owner \class-facet-of? inherits \class-inherits? header \class-header-block?
        bx.seq
            - bx.atom(location, acc)
            - bx.applied(location, bx.atom(location, id), bx.many(type-args))
            - aliases
            - owner
            - inherits
            - header

.. class-aliases ImmutableTableRow'SourceNode ~
    ~ // "(" / aliases \alias-list / ")"
        bx.form(location, "alias", aliases)

.. alias-list ImmutableTableRow'SourceNode ~
    ~ names \delimited(",", ~ \alias)
        bx.many(names)

.. alias ImmutableTableRow'SourceNode ~
    ~ n \name !([a-zA-Z0-9])
        bx.atom(location, n)
    ~ n \type-name
        bx.atom(location, n)
    ~ n \unit
        bx.atom(location, n)

.. class-facet-of ImmutableTableRow'SourceNode ~
    ~ // "is" // "facet" // "of" // owner \type
        bx.form(location, "facet-of", owner)

.. class-inherits ImmutableTableRow'SourceNode ~
    ~ // "is" // types \class-or-list
        bx.form(location, "is", types)

.. class-or-list ImmutableTableRow'SourceNode ~
    ~ bases \delimited("||", ~ \class-base)
        bx.many(bases)

.. class-base-list ImmutableTableRow'SourceNode ~
    ~ bases \delimited(",", ~ \class-base)
        bx.many(bases)

.. class-base ImmutableTableRow'SourceNode ~
    ~ \class-tuple-base
    ~ \type
    ~ \numeric-literal

.. class-tuple-base ImmutableTableRow'SourceNode ~
    ~ "(" / id \identifier // ty \type / ")"
        bx.form(location, "tuple", bx.form(location, ":", id, ty))

.. class-header-block ImmutableTableRow'SourceNode ~
    ~ \open lines \class-header-lines / \close
        lines

.. class-header-lines ImmutableTableRow'SourceNode ~
    ~ \nl* head \class-header-declaration-line tail \class-header-line* / \nl*
        bx.seq(head, bx.some(tail))

.. class-header-declaration-line ImmutableTableRow'SourceNode ~
    ~ / arg \class-header-declaration / (\nl | &\close)
        arg

.. class-header-line ImmutableTableRow'SourceNode? ~
    ~ / arg \class-header-declaration / (\nl | &\close)
        arg
    ~ / \nl
        null

.. class-header-declaration ImmutableTableRow'SourceNode ~
    ~ "-" // arg \type-constraint-declaration
        arg
    ~ "is" // t \type
        bx.form(location, "implements", t)
    ~ "using" // t \type
        bx.form(location, "using", t)
    ~ "sees" // t \type
        bx.form(location, "sees", t)

.. class-body ImmutableTableRow'SourceNode ~
    ~ / \nl+ items \members
        items

.. member ImmutableTableRow'SourceNode ~
    ~ \event-declaration
    ~ \property-declaration
    ~ \enum-declaration
    ~ \implements-declaration
    ~ \style-annotation-declaration
    ~ \dependency-declaration
    ~ \function-block
    ~ \content-block

.. event-declaration ImmutableTableRow'SourceNode ~
    ~ acc \access // "event" // name \name // ty \type (// "keyed" // "by" // keyed \type)?
        bx.form(location, "event", bx.atom(location, acc), bx.atom(location, name), ty, keyed)

.. members ImmutableTableRow'SourceNode ~
    ~ leading \leading-member-line* divided \divided-member-line* / \nl?
        bx.seq(bx.some(leading), bx.some(divided))

.. leading-member-line ImmutableTableRow'SourceNode? ~
    ~ / mem \keyframe-member / (\nl | &\close | &\style-rule-member-start | &\open)
        mem
    ~ / mem \style-rule-member / (\nl | &\close | &\style-rule-member-start | &\open)
        mem
    ~ / !(\open) mem \member / (\nl | &\close | &\open)
        mem
    ~ / \nl
        null

.. divided-member-line ImmutableTableRow'SourceNode? ~
    ~ / &\open mem \member / (\nl | &\close)
        mem
    ~ / \nl
        null

.. style-rule-member-start ~
    ~ "•" // \style-rule-name

.. keyframe-member ImmutableTableRow'SourceNode ~
    ~ "•" // name \style-rule-name parameter \style-rule-inline-argument? // kind \keyframe-kind // duration \inline-expression-no-prep-no-comma lines \keyframe-body?
        bx.form
            - location
            - "keyframes"
            - bx.atom(location, name)
            - parameter
            - bx.atom(location, kind)
            - duration
            - lines

.. keyframe-kind String ~
    ~ "animation"
        "animation"
    ~ "motion"
        "motion"

.. keyframe-body ImmutableTableRow'SourceNode ~
    ~ / \open lines \keyframe-line+ / \close
        bx.some(lines)

.. keyframe-line ImmutableTableRow'SourceNode? ~
    ~ / line \keyframe-statement / (\nl | &\close)
        line
    ~ / \nl
        null

.. keyframe-statement ImmutableTableRow'SourceNode ~
    ~ \keyframe-stop
    ~ \keyframe-range
    ~ \keyframe-track
    ~ \keyframe-setting

.. keyframe-stop ImmutableTableRow'SourceNode ~
    ~ "at" // at \user-binary-expression3 / "=" / value \user-binary-expression3 bullets \bullet-argument-no-comma*
        bx.form(location, "at", at, value, bx.many(bullets))

.. keyframe-range ImmutableTableRow'SourceNode ~
    ~ property \keyframe-property / "=" / from \user-binary-expression3? / ".." !"." (/ to \user-binary-expression3)? bullets \bullet-argument-no-comma*
        bx.form
            - location
            - "range"
            - property
            - bx.blank-slot(location, from)
            - bx.blank-slot(location, to)
            - bx.many(bullets)

.. keyframe-track ImmutableTableRow'SourceNode ~
    ~ property \keyframe-property bullets \bullet-argument-no-comma* / \open stops \keyframe-stop-line+ / \close
        bx.form(location, "track", property, bx.many(bullets), bx.some(stops))
    ~ &\{ entry == BrixEntry.keyframe-row } property \keyframe-property bullets \bullet-argument-no-comma* &\row-end
        bx.form(location, "track", property, bx.many(bullets))

.. keyframe-stop-line ImmutableTableRow'SourceNode? ~
    ~ / stop \keyframe-stop / (\nl | &\close)
        stop
    ~ / \nl
        null

.. keyframe-setting ImmutableTableRow'SourceNode ~
    ~ name \name / "=" / value \inline-expression-no-prep-no-comma
        bx.form(location, "=", bx.atom(location, name), value)

.. keyframe-property ImmutableTableRow'SourceNode ~
    ~ n \keyframe-property-name
        bx.atom(location, n)

.. keyframe-property-name String ~
    ~ [a-z] [-a-z0-9]* ("." [a-z] [-a-z0-9]*)?

.. style-rule-member ImmutableTableRow'SourceNode ~
    ~ "•" // name \style-rule-name arg \style-rule-inline-argument? rules \style-rule-applications? body \style-rule-body?
        bx.form(location, "rule", bx.atom(location, name), arg, rules, body)

.. style-rule-inline-argument ImmutableTableRow'SourceNode ~
    ~ ":" arg \argument-declaration
        arg

.. style-rule-body ImmutableTableRow'SourceNode ~
    ~ / \open statements \style-rule-statements / \close
        statements

.. style-rule-statements ImmutableTableRow'SourceNode ~
    ~ lines \style-rule-statement-line+
        bx.some(lines)

.. style-rule-statement-line ImmutableTableRow'SourceNode? ~
    ~ / "•" // "own" // name \style-selector-name arg \style-rule-inline-argument? rules \style-rule-applications? body \style-rule-body? / (\nl | &\close | &\style-rule-member-start | &\open)
        bx.form(location, "own-rule", bx.atom(location, name), arg, rules, body)
    ~ / "•" // name \style-rule-name arg \style-rule-inline-argument? rules \style-rule-applications? body \style-rule-body? / (\nl | &\close | &\style-rule-member-start | &\open)
        bx.form(location, "rule", bx.atom(location, name), arg, rules, body)
    ~ / !(\style-rule-container-end) stmt \statement / (\nl | &\close)
        stmt
    ~ / \nl
        null

.. style-when-statement ImmutableTableRow'SourceNode ~
    ~ "when" // state \style-when-state body \style-when-body
        bx.form(location, "when-style", state, body)
    ~ state \name ":" property \name // "=" // value \inline-expression-no-prep-no-comma
        bx.form(location, "style-set", bx.atom(location, state), bx.atom(location, property), value)

.. style-when-state ImmutableTableRow'SourceNode ~
    ~ "!" state \style-when-state-name
        bx.form(location, "not", state)
    ~ \style-when-state-name

.. style-when-state-name ImmutableTableRow'SourceNode ~
    ~ tracked "#"? state \name
        bx.atom(location, if tracked then "#$state" else state)

.. style-when-body ImmutableTableRow'SourceNode ~
    ~ \open statements \style-when-statements / \close
        statements
    ~ \inline-block-expression
    ~ &\{ entry == BrixEntry.rule-row || entry == BrixEntry.use-row } &\row-end
        bx.seq()

.. style-when-statements ImmutableTableRow'SourceNode ~
    ~ lines \style-when-statement-line+
        bx.some(lines)

.. style-when-statement-line ImmutableTableRow'SourceNode? ~
    ~ / mem \style-when-rule-member / (\nl | &\close | &\style-rule-member-start | &\open)
        mem
    ~ / "•" // application \style-rule-application / (\nl | &\close)
        application
    ~ / stmt \statement / (\nl | &\close)
        stmt
    ~ / \nl
        null

.. style-when-rule-member ImmutableTableRow'SourceNode ~
    ~ "•" // "own" // name \style-selector-name arg \style-rule-inline-argument? rules \style-rule-applications? body \style-rule-body
        bx.form(location, "own-rule", bx.atom(location, name), arg, rules, body)
    ~ "•" // "own" // name \style-selector-name arg \style-rule-inline-argument? rules \style-rule-applications
        bx.form(location, "own-rule", bx.atom(location, name), arg, rules)
    ~ "•" // name \style-rule-name arg \style-rule-inline-argument? rules \style-rule-applications? body \style-rule-body
        bx.form(location, "rule", bx.atom(location, name), arg, rules, body)
    ~ "•" // name \style-rule-name arg \style-rule-inline-argument? rules \style-rule-applications
        bx.form(location, "rule", bx.atom(location, name), arg, rules)

.. style-rule-container-end ~
    ~ \close
    ~ \open

.. function-block ImmutableTableRow'SourceNode ~
    ~ \state-machine-function-block
    ~ \fromverter-block
    ~ \converter-block
    ~ \getter-block
    ~ \whenever-rule-block
    ~ \when-rule-block
    ~ \for-subscriber-block
    ~ \container-subscriber-block
    ~ \setter-block
    ~ \ordinary-function-block

.. state-machine-function-block ImmutableTableRow'SourceNode ~
    ~ \open \nl acc \access decorations \property-decorations // left \type-capture-parts // "~>" machine \machine-function-body
        bx.form(location, "prop", bx.atom(location, acc), left, decorations, machine)

.. machine-function-body ImmutableTableRow'SourceNode ~
    ~ / \nl statements \state-machine-statements / \close
        bx.form(location, "machine", statements)
    ~ &\{ entry != BrixEntry.whole-file } / \nl* / \close
        bx.form(location, "machine")

.. fromverter-block ImmutableTableRow'SourceNode ~
    ~ \open \nl acc \access // imperative \function-imperative? "from" // t \structure-pattern / body \function-block-body-tail
        bx.form
            - location
            - if !!imperative then "fn-from-do" else "fn-from-expr"
            - bx.atom(location, acc)
            - t
            - body

.. converter-block ImmutableTableRow'SourceNode ~
    ~ \open \nl acc \access // imperative \function-imperative? "to" // ty \type effects \annotation-names? scope \do-sections? args \arguments-block? / body \function-block-body-tail
        bx.form
            - location
            - if !!imperative then "fn-to-do" else "fn-to-expr"
            - bx.atom(location, acc)
            - ty
            - effects
            - scope
            - args
            - body

.. getter-block ImmutableTableRow'SourceNode ~
    ~ \open \nl acc \access // imperative \function-imperative? "get" // names \function-left (// t \type)? errors \function-error-declaration* effects \annotation-names? scope \do-sections? / body \function-block-body-tail
        bx.form
            - location
            - if !!imperative then "fn-do" else "fn-expr"
            - bx.atom(location, acc)
            - names
            - bx.blank-slot(location, t)
            - bx.atom(location, ":get")
            - bx.many(errors)
            - bx.seq(effects, scope)
            - body

.. when-rule-block ImmutableTableRow'SourceNode ~
    ~ \open \nl "when" // expr \inline-expression / body \function-block-body-tail
        bx.form(location, "when-rule", expr, body)

.. whenever-rule-block ImmutableTableRow'SourceNode ~
