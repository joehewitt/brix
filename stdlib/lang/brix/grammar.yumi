.. setter-block ImmutableTableRow'SourceNode ~
    ~ \open \nl acc \access // imperative \function-imperative? names \function-left // "=" // arg \argument-declaration / !(\same-line-body) body \function-block-body-tail
        bx.form
            - location
            - if !!imperative then "fn-do" else "fn-expr"
            - bx.atom(location, acc)
            - names
            - bx.atom(location, "_")
            - bx.atom(location, ":set")
            - arg
            - body

.. ordinary-function-block ImmutableTableRow'SourceNode ~
    ~ \open \nl acc \access // static \function-static? imperative \function-imperative? key \function-key errors \function-error-declaration* effects \annotation-names? scope \do-sections? throws (// "throws")? args \arguments-block? / !(\same-line-body) body \function-block-body-tail
        bx.form
            - location
            - bx.function-head(!!imperative, key)
            - bx.atom(location, acc)
            - key
            - bx.seq
                - bx.flag(location, ":static", !!static)
                - bx.many(errors)
                - effects
                - scope
                - bx.flag(location, ":throws", !!throws)
            - args
            - body

.. same-line-body ~
    ~ &(!(\nl | \open | \close) .)

.. function-imperative Bool ~
    ~ "do" //
        true

.. function-static Bool ~
    ~ "static" //
        true

.. function-block-body-tail ImmutableTableRow'SourceNode? ~
    ~ body \block-statements? / \nl* / \close
        body

.. function-key ImmutableTableRow'SourceNode ~
    ~ left \function-left type-args \type-argument* (// taty \type)? // op \infix-operator // arg \argument-declaration
        bx.seq
            - bx.form
                - location
                - "infix"
                - bx.applied(location, left, bx.many(type-args))
                - bx.atom(location, op)
                - arg
            - bx.blank-slot(location, taty)
    ~ left \function-left type-args \type-argument* "[" index \argument-declaration "]" // "=" // value \argument-declaration
        bx.seq
            - bx.form
                - location
                - "index-set"
                - bx.applied(location, left, bx.many(type-args))
                - index
                - value
            - bx.atom(location, "_")
    ~ left \function-left type-args \type-argument* "[" index \argument-declaration "]" (// tty \type)?
        bx.seq
            - bx.form(location, "index-get", bx.applied(location, left, bx.many(type-args)), index)
            - bx.blank-slot(location, tty)
    ~ "-=" // left \function-left type-args \type-argument* "[" index \argument-declaration "]"
        bx.seq
            - bx.form
                - location
                - "index-delete"
                - bx.applied(location, left, bx.many(type-args))
                - index
            - bx.atom(location, "_")
    ~ op \prefix-overload-operator / left \function-left type-args \type-argument* (// tgty \type)?
        bx.seq
            - bx.form
                - location
                - "prefix"
                - bx.atom(location, op)
                - bx.applied(location, left, bx.many(type-args))
            - bx.blank-slot(location, tgty)
    ~ left \function-left type-args \type-argument* pattern-type \pattern-item-type? (// ty \type)?
        bx.seq
            - bx.applied(location, left, bx.many(type-args))
            - bx.blank-slot(location, ty)
            - pattern-type

