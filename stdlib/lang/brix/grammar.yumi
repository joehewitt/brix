        bx.named(location, "${ab}-$n", false, bx.atom(location, if is-not then "false" else "true"))
    ~ "•" is-optional "?"? // n \name expr \block-or-expression?
        bx.named(location, n, !!is-optional, expr)
    ~ "•" is-optional "?"? // "(" key \inline-expression-no-comma ")" value \block-or-expression?
        bx.form(location, if is-optional then "entry?" else "entry", key, value)
    ~ "•" is-optional "?"? // key \string value \block-or-expression?
