    ~ "=?" condition \return-condition
        bx.form(location, "return-if", bx.form(location, "if", condition))
    ~ "=?" expr \block-or-expression
        bx.form(location, "return?", expr)
    ~ op \return-operator is-optional "?"? expr \block-or-expression
        bx.form(location, if is-optional then "$op?" else op, expr)
    ~ "break" !([-a-z0-9])
        bx.form(location, "break")
    ~ "continue" !([-a-z0-9])
