./build
./grammar
/core/arena
/core/parsing
/core/table
/data/source-tree
/lang/ast/preparse

━━━━━━━━━━━━━━━━━━━━
+ BrixSyntaxError is Error

+ line Size
+ column Size

────────────────────
+ This
    - line
    - column

message = "Syntax error at line $line, column $column"

━━━━━━━━━━━━━━━━━━━━
+ do brix-build ImmutableTableRow'SourceNode ?! BrixSyntaxError
    - source String
    - builder BrixBuilder

. scratch = use Arena()
. prepared = preparse(source, scratch)
= match prepared
    ~ parsed \brix-grammar(builder, BrixEntry.whole-file)
        parsed
    ?! BrixSyntaxError((location.line as Size) + 1, (location.column as Size) + 1)

━━━━━━━━━━━━━━━━━━━━
+ do brix-parse-row ImmutableTableRow'SourceNode?
    - text String
    - store SourceStore
    - entry BrixEntry

. builder = BrixBuilder(store)
. scratch = use Arena()
. source = if entry == BrixEntry.head-row then "━━━━━━━━━━━━━━━━━━━━\n${text}\n" else text
. prepared = preparse(source, scratch)
= match prepared
    ~ parsed \brix-grammar(builder, entry)
        builder.only(parsed)
    ?? null

━━━━━━━━━━━━━━━━━━━━
+ do brix-parse-prose ImmutableTableRow'SourceNode?
    - text String
    - store SourceStore

. builder = BrixBuilder(store)
= match "Æ${"\ufdd0".join(text.split("≥"))}\n≥"
    ~ parsed \brix-grammar(builder, BrixEntry.prose-row)
        builder.only(parsed)
    ?? null
