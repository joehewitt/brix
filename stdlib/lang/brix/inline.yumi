./brix
./convert
/code/structure/document
/code/structure/rows
/math

━━━━━━━━━━━━━━━━━━━━
_ InlinePlace is (name String, before String, after String)

━━━━━━━━━━━━━━━━━━━━
_ InlineCut is (row Index, start Size, end Size)

━━━━━━━━━━━━━━━━━━━━
+ do brix-inline-view String?
    - form String

. lines = brix-inline-rows(form)
=? null if lines == null
= "\n".join(inline-line-text(each) in lines)

━━━━━━━━━━━━━━━━━━━━
+ do brix-inline-rows [[SourceSpan]]?
    - form String

for place in inline-places(inline-head(form))
    =? inline-rows(form, place)
= null

━━━━━━━━━━━━━━━━━━━━
_ inline-places [InlinePlace]
    - head String

|? head == "param"
    [param]
|? head == "when" || head == "until" || head == "while"
    [clause, statement]
|? head == "seq" || head == "chars" || head == "\\{}"
    [stream]
|? head == "exact" || head == "similar" || head == ":" || head == "{}" || head == "all" || head == "|"
    [pattern, stream]
|? head == "case" || head == "case=" || head == "case?" || head == "default"
    [arm, statement]
|? head == "then" || head == "else-state"
    [transition]
|? head == "fn-type"
    [type, statement]
|? head.starts-with("fn-") || head == "type" || head == "type-line" || head == "extend" || head == "extend-line" || head == "import" || head == "export" || head == "unit"
    [module, member]
|? head == "prop" || head == "event" || head == "depends" || head == "content"
    [member]
|? head == "when-rule" || head == "whenever-rule" || head == "subscribe-for" || head == "subscribe"
    [member]
?? [statement, pattern, type, stream]

.. statement = InlinePlace("statement", "(main\n  ", "\n)")
.. module = InlinePlace("module", "", "\n\n(main\n  (print 0)\n)")
.. member = InlinePlace("member", "(type + T\n  ", "\n)")
.. arm = InlinePlace("arm", "(main\n  (match s\n    ", "\n  )\n)")
.. transition = InlinePlace("transition", "(main\n  (state s\n    ", "\n  )\n)")
.. pattern = InlinePlace("pattern", "(main\n  (match s\n    (case ", " v)\n  )\n)")
.. stream = InlinePlace("stream", "(main\n  (match s\n    (~ ", " v)\n  )\n)")
.. type = InlinePlace("type", "(main\n  (let x ", " v)\n)")
.. param = InlinePlace("param", "(fn-expr + f _\n  ", "\n  v\n)")
.. clause = InlinePlace("clause", "(main\n  (for (in x xs ", ")\n    v\n  )\n)")

━━━━━━━━━━━━━━━━━━━━
_ do inline-head String
    - form String

. head = ""
. started = false
for c in form
    if started
        =? head if c == ' ' || c == ')' || c == '\n'
        head ++= c
    else if c == '('
        started = true
= head

━━━━━━━━━━━━━━━━━━━━
_ do inline-rows [[SourceSpan]]?
    - form String
    - place InlinePlace

. source = place.before ++ form ++ place.after
. read = catch brix-document-read(source)
=? null if read is Error
. document = read as SourceDocument
do finally document.release()
. rows = document.view-rows()
. lines = List'String(each.text in rows)
. text = "\n".join(lines)
. back = catch brix-convert(text)
=? null if back is Error
=? null if squeezed(unblanked(back as String)) != squeezed(source)
. starts [Size]
. at Size = 0
for line in lines
    starts += at
    at += line.length + 1
. placed [[SourceSpan]]
for cut in placed-cuts(lines, place.name)
    placed += cut-spans(rows[cut.row], cut, text, starts[cut.row])
if place.name == "statement" && placed.length > 0
    =? null if inline-line-text(placed[placed.length - 1]).ends-with("...")
= placed

━━━━━━━━━━━━━━━━━━━━
_ do placed-cuts [InlineCut]
    - lines [String]
    - place String

. kept [InlineCut]
. line-no = 0
. in-body = place != "member" && place != "param"
for row in 0 .. < lines.length
    . line = lines[row]
    line-no += 1
    if line.starts-with("━") || line.starts-with("─")
        continue
    if !in-body
        in-body = line == "+ T" || line == "+ f"
        continue
    if place == "param" && !line
        break
    if place == "module" && line == "-- 0"
        break
    do match place
        |= "arm"
            kept +=? indented(row, line, 4) if line-no > 1
        |= "transition"
            kept +=? indented(row, line, 4) if line-no > 1
        |= "pattern"
            kept +=? indented(row, line, 6) if line-no == 2
        |= "stream"
            kept +=? indented(row, line, 6) if line-no == 2
        |= "type"
            kept +=? unassigned(indented(row, line, 4), line) if line-no == 1
        |= "param"
            kept += indented(row, line, 4)
        |= "clause"
            kept +=? indented(row, line, 12) if line-no == 1
        ??
            kept += indented(row, line, 0)
while kept.length != 0 && kept[0].start >= kept[0].end
    -= kept[0]
while kept.length != 0 && kept[kept.length - 1].start >= kept[kept.length - 1].end
    -= kept[kept.length - 1]
= kept

━━━━━━━━━━━━━━━━━━━━
_ do cut-spans [SourceSpan]
    - row SourceRow
    - cut InlineCut
    - text String
    - start Size

. spans [SourceSpan]
. indent = row.content-start
if cut.start < indent
    spans += SourceSpan(SourceSpanKind.plain, text[start + cut.start .. < start + min(indent, cut.end)])
. at = indent
for span in row.spans
    . size = span.text.length
    . low = max(at, cut.start)
    . high = min(at + size, cut.end)
    if high > low
        spans += SourceSpan(span.kind, text[start + low .. < start + high])
    at += size
= spans

━━━━━━━━━━━━━━━━━━━━
_ inline-line-text String
    - spans [SourceSpan]

"".join(each.text in spans)

━━━━━━━━━━━━━━━━━━━━
_ unassigned InlineCut
    - cut InlineCut
    - line String

if line[cut.start .. < cut.end].ends-with(" = v") then InlineCut(cut.row, cut.start, cut.end - 4) else cut

━━━━━━━━━━━━━━━━━━━━
_ indented InlineCut
    - row Index
    - line String
    - depth Size

InlineCut(row, min(depth, line.length), line.length)

━━━━━━━━━━━━━━━━━━━━
_ unblanked String
    - text String

"".join(text.split("(blank)"))

━━━━━━━━━━━━━━━━━━━━
_ do squeezed String
    - text String

. out = ""
. spaced = false
for c in text
    if c == ' ' || c == '\n' || c == '\t'
        spaced = true
    else
        out ++=? " " if spaced && out && c != ')' && !out.ends-with("(")
        spaced = false
        out ++= c
= out
