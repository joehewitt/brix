_ " facet-brix

(type + BoxScroll (facet-of Box)
  (sees BoxMeasure)
  (sees BoxFocus)
  (prop _ offset _ (= 0))
  (prop ^ pinned _ (= false))
)

━━━━━━━━━━━━━━━━━━━━
_ " facet-text

$thick
+ BoxScroll is facet of Box
    sees BoxMeasure
    sees BoxFocus

_ offset = 0
^ pinned = false

$thick

━━━━━━━━━━━━━━━━━━━━
_ " scoped-brix

(fn-do + step _ @inline (without heap suspend) (with depth 2) (with scope "step")
  (do (without gc) (with depth 3)
    (call tick)
  )
)

━━━━━━━━━━━━━━━━━━━━
