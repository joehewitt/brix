/code/structure/document
/code/structure/session
/lang/brix/brix
/lang/brix/convert
/test

_ thick = "━━━━━━━━━━━━━━━━━━━━"

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Brix Copy And Paste Round Trip")
cases.run(round-trip-tests)
cases = cases.then("Brix Copy", copy-tests)
cases = cases.then("Brix Paste Placement", placement-tests)
cases = cases.then("Brix Paste Indentation", indentation-tests)
cases = cases.then("Brix Line Deletion", deletion-tests)
cases = cases.then("Brix Unparsed Text", unparsed-tests)
cases = cases.then("Brix Conversion", conversion-tests)
cases = cases.then("Brix Task Arms", arm-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do round-trip-tests TestCase
    - t TestCase

. source = walk-source().trim()
t.expect("the fixture reads back as written", source, => shown(opened(source)))
t.expect("statements in a body", source, => pasted-back(". a = 1", ". x = 2", false))
t.expect
    - "whole lines through the start of the next"
    - source
    - => pasted-back(". a = 1", ". c = 3", true)
t.expect("whole lines up to an indented row", source, => pasted-back(". a = 1", ". x = 2", true))
t.expect("a first line deeper than the next", source, => pasted-back(". y = 3", ". c = 3", false))
t.expect("a header through its body", source, => pasted-back("+ do walk Int", "if b", false))
t.expect("lines across two functions", source, => pasted-back("if b", "+ do other Int", false))
t.expect("a whole function from its divider", source, => pasted-back(thick, "= a", false))
t.expect
    - "one undo restores a paste across functions"
    - source
    - => undone-paste("if b", "+ do other Int")
= t

━━━━━━━━━━━━━━━━━━━━
+ do copy-tests TestCase
    - t TestCase

t.expect("whole lines keep the first line's indentation", "    . x = 2\n    . y = 3\n", => copied(". x = 2", 0, ". c = 3", 0))
t.expect("a selection from mid-line starts there", "b\n    . x = 2", => copied("if b", 3, ". x = 2", 1000))
= t

━━━━━━━━━━━━━━━━━━━━
+ do placement-tests TestCase ?! Error
    - t TestCase

t.expect
    - "a block pasted at a line start keeps its nesting"
    - block-pasted().trim()
    - => pasted-at(". c = 3", "if c\n    . z = 4\n")
t.expect
    - "a declaration pasted into a body splits it"
    - body-split().trim()
    - => pasted-at(". c = 3", "$thick\n+ do mid Int\n\n. m = 1\n")
t.expect
    - "a block pasted on a divider goes above it"
    - divider-pasted().trim()
    - => pasted-on-divider("$thick\n+ do mid Int\n\n. m = 1")
t.expect
    - "a block pasted on the last row goes after the last declaration"
    - end-pasted().trim()
    - => pasted-at-end("$thick\n+ do last Int\n\n. n = 1")

. session = opened(walk-source())
session.place(row-of(session, ". c = 3"), 0)
session.paste("if c\n    . z = 4\n")
t.expect("the caret ends at the start of the line after the block", ". c = 3", session.row-at(session.row).content)
t.check
    - "the caret is at the line's first column"
    - session.column == session.row-at(session.row).content-start
= t

━━━━━━━━━━━━━━━━━━━━
+ do indentation-tests TestCase
    - t TestCase

t.expect
    - "whole lines move to the caret's depth"
    - moved-in().trim()
    - => pasted-at(". y = 3", "if c\n    . z = 4\n")
t.expect
    - "a line shallower than the first leaves the block"
    - moved-out().trim()
    - => pasted-at(". y = 3", "    . q = 5\nif r\n    . s = 6\n")
t.expect
    - "two-space code becomes four-space levels"
    - two-space().trim()
    - => pasted-at(". c = 3", "if c\n  . z = 4\n  if d\n    . w = 5\n")
t.expect("a tab is one level", block-pasted().trim(), => pasted-at(". c = 3", "if c\n\t. z = 4\n"))
= t

━━━━━━━━━━━━━━━━━━━━
+ do deletion-tests TestCase
    - t TestCase

t.expect
    - "whole lines go and the next keeps its indentation"
    - line-deleted().trim()
    - => deleted(". y = 3", 0, ". c = 3", 0)
t.expect
    - "a selection from mid-line to mid-line joins the rest"
    - lines-joined().trim()
    - => deleted(". a = 1", 3, ". c = 3", 3)
t.expect("a whole function from its divider goes", function-deleted().trim(), => deleted-function())
= t

━━━━━━━━━━━━━━━━━━━━
+ do unparsed-tests TestCase ?! Error
    - t TestCase

. broken = opened(walk-source())
broken.place(row-of(broken, ". c = 3"), 0)
broken.paste("if c\n    . z = )\n. w = 4\n")
t.expect("a broken line keeps its place in the structure", line-broken().trim(), shown(broken))
t.expect("only the broken line is invalid", "    . z = )", invalid-rows(broken))
. typo = row-of(broken, ". z = )")
broken.place(typo, 1000)
broken.delete-backward()
broken.insert("5")
broken.place(row-of(broken, ". a = 1"), 0)
t.check("fixing the broken line leaves no invalid rows", invalid-rows(broken).length == 0)

. header = opened(walk-source())
header.place(row-of(header, thick, 1), 0)
header.paste("$thick\n+ do (\n    - by Int\n\n. q = 1")
t.expect("a broken header keeps its declaration as written", header-broken().trim(), shown(header))
t.expect("every line of that declaration is invalid", "$thick|+ do (|    - by Int||. q = 1", invalid-rows(header))
. head = row-of(header, "+ do (")
header.place(head, 5)
header.delete-forward()
header.insert("fix Int")
header.place(row-of(header, ". a = 1"), 0)
t.expect("fixing the header reads the declaration again", header-fixed().trim(), shown(header))
t.check("the fixed declaration has no invalid rows", invalid-rows(header).length == 0)
= t

━━━━━━━━━━━━━━━━━━━━
+ do conversion-tests TestCase
    - t TestCase

. source = nested-arguments().trim()
t.expect("nested type arguments are written in parentheses", nested-text().trim(), => brix-yumi-text(source))
t.expect("nested type arguments read back nested", source, => brix-convert(brix-yumi-text(source)).trim())
. facet = facet-brix().trim()
t.expect("a facet's owner, sees and shared members are written in rows", facet-text().trim(), => brix-yumi-text(facet).trim())
t.expect("a facet's owner, sees and shared members read back", facet, => brix-convert(brix-yumi-text(facet)).trim())
. scoped = scoped-brix().trim()
t.expect("with and without parts are written on the header", scoped-text().trim(), => brix-yumi-text(scoped).trim())
t.expect("with and without parts read back", scoped, => brix-convert(brix-yumi-text(scoped)).trim())
= t

━━━━━━━━━━━━━━━━━━━━
+ do arm-tests TestCase ?! Error
    - t TestCase

t.expect
    - "a catch typed after a task's rows is the task's on-failure arm"
    - brix-convert(caught-task()).trim()
    - => typed-catch("do new\n    work()\n", true)
t.expect
    - "a catch typed after the rows of a task kept in a local is that task's arm"
    - brix-convert(caught-kept-task()).trim()
    - => typed-catch(". t = do new\n    work()\n", true)
t.expect
    - "a catch typed after a call handles the call's errors"
    - brix-convert(caught-call()).trim()
    - => typed-catch("work()\n", false)
= t

━━━━━━━━━━━━━━━━━━━━
_ do typed-catch String ?! Error
    - rows String
    - nested Bool

. session = opened("$thick\n+ do walk Int\n\n. a = 1\n${rows}. c = 3\n= a\n")
. last = row-of(session, "work()")
session.place(last, session.row-at(last).text.length)
session.split()
if nested
    session.outdent()
session.insert("catch failed")
session.split()
session.indent()
session.insert("print(failed)")
session.commit()
= session.document.written().text.trim()

━━━━━━━━━━━━━━━━━━━━
_ opened SourceSession ?! Error
    - source String

SourceSession(source-document-read(BrixLanguage(), brix-convert(source)))

━━━━━━━━━━━━━━━━━━━━
_ do shown String
    - session SourceSession

. lines [String]
for index in 0 .. < session.document.row-count - 1
    lines += session.row-at(index).text
= "\n".join(lines).trim()

━━━━━━━━━━━━━━━━━━━━
_ do invalid-rows String
    - session SourceSession

. lines [String]
for index in 0 .. < session.document.row-count
    . row = session.row-at(index)
    if row.is-invalid
        lines += row.text
= "|".join(lines)

━━━━━━━━━━━━━━━━━━━━
_ do row-of Size
    - session SourceSession
    - content String
    - skipped Size = 0

. seen Size = 0
for index in 0 .. < session.document.row-count
    if session.row-at(index).content == content
        =? index if seen == skipped
        seen += 1
?! Panic("No row reads $content")

━━━━━━━━━━━━━━━━━━━━
_ do selected SourceSession ?! Error
    - first String
    - start Size
    - last String
    - end Size

. session = opened(walk-source())
session.place(row-of(session, first), start)
session.place(row-of(session, last), end, true)
= session

━━━━━━━━━━━━━━━━━━━━
_ copied String ?! Error
    - first String
    - start Size
    - last String
    - end Size

selected(first, start, last, end).selected-text()

━━━━━━━━━━━━━━━━━━━━
_ do pasted-back String ?! Error
    - first String
    - last String
    - is-whole Bool

. session = selected(first, 0, last, if is-whole then 0 else 1000)
session.paste(session.selected-text())
= shown(session)

━━━━━━━━━━━━━━━━━━━━
_ do undone-paste String ?! Error
    - first String
    - last String

. session = selected(first, 0, last, 1000)
session.paste(session.selected-text())
session.undo()
= shown(session)

━━━━━━━━━━━━━━━━━━━━
_ do pasted-at String ?! Error
    - line String
    - text String

. session = opened(walk-source())
session.place(row-of(session, line), 0)
session.paste(text)
= shown(session)

━━━━━━━━━━━━━━━━━━━━
_ do pasted-on-divider String ?! Error
    - text String

. session = opened(walk-source())
session.place(row-of(session, thick, 1), 0)
session.paste(text)
= shown(session)

━━━━━━━━━━━━━━━━━━━━
_ do pasted-at-end String ?! Error
    - text String

. session = opened(walk-source())
session.place(session.document.row-count - 1, 0)
session.paste(text)
= shown(session)

━━━━━━━━━━━━━━━━━━━━
_ do deleted String ?! Error
    - first String
    - start Size
    - last String
    - end Size

. session = selected(first, start, last, end)
session.delete-selection()
= shown(session)

━━━━━━━━━━━━━━━━━━━━
_ do deleted-function String ?! Error

. session = opened(walk-source())
session.place(row-of(session, thick, 1), 0)
session.place(row-of(session, "= d"), 1000, true)
session.delete-selection()
= shown(session)

