(import ./ast/c-header)
(import ./ast/module)
(import ./ast/probe-selection)
(import ./ast/program)
(import ./ast/program-builder)
(import ./ast/syntax-program)
(import ./check/parallel-typing)
(import ./check/session)
(import ./constants)
(import ./report/facts-text)
(import ./target)
(import /os/path)

(type + BrixCompiler
  (prop + search-paths (list Path))
  (prop + c-module-paths (map String (list Path)))
  (prop + sources (map String String))
  (prop + parse-worker-count _ (= default-worker-count))
  (prop + typing-worker-count _ (= default-worker-count))
  (prop + probes _ (= (call ProbeSelection)))
  (prop + target (? Target))
  (prop + c-headers (? CHeaders))
  (prop + modules (? ModuleView))
  (fn-do + compile-program _
    (param source-path String)
    (param module-name _ (= "__source__"))
    (let ast-program (use (call source-to-ast source-path module-name)))
    (return (call ast-to-ir source-path ast-program))
  )
  (fn-do + source-to-syntax SyntaxProgram
    (param source-path String)
    (param module-name String)
    (param source (? String) (= null))
    (let syntax (call SyntaxProgram search-paths c-module-paths))
    (= (. syntax sources) sources)
    (= (. syntax probes) probes)
    (= (. syntax target) target)
    (if c-headers
      (call (. syntax use-c-headers) c-headers)
    )
    (if modules
      (call (. syntax use-modules) modules)
    )
    (probe-group + compiler.parse.syntax)
    (call (. syntax parse) source-path module-name parse-worker-count source)
    (probe-group - compiler.parse.syntax)
    (return syntax)
  )
  (fn-do + syntax-to-ast Program
    (param syntax SyntaxProgram)
    (probe-group + compiler.parse.headers)
    (call (. syntax materialize-c-headers))
    (probe-group - compiler.parse.headers)
    (let builder (call ProgramBuilder (call (. syntax take-atoms))))
    (= (. builder shares-atoms) (. syntax shares-atoms))
    (probe-group + compiler.parse.modules)
    (let program (call (. builder build) syntax))
    (probe-group - compiler.parse.modules)
    (= (. program probes) (. syntax probes))
    (= (. program target) (!! (. syntax target)))
    (= (. program absent-imports) (. syntax absent-imports))
    (return program)
  )
  (fn-do + source-to-ast Program
    (param source-path String)
    (param module-name String)
    (param source (? String) (= null))
    (let syntax (use (call source-to-syntax source-path module-name source)))
    (return (call syntax-to-ast syntax))
  )
  (fn-do + batch-to-ast Program
    (param roots (list (tuple String String)))
    ; The program of a batch: each root, given its path and the name of its module, and what each
    ; imports.
    (let syntax (use (call SyntaxProgram search-paths c-module-paths)))
    (= (. syntax sources) sources)
    (= (. syntax probes) probes)
    (= (. syntax target) target)
    (if c-headers
      (call (. syntax use-c-headers) c-headers)
    )
    (if modules
      (call (. syntax use-modules) modules)
    )
    (call (. syntax parse-batch) roots parse-worker-count)
    (return (call syntax-to-ast syntax))
  )
  (fn-do + ast-to-ir _
    (param source-path String)
    (param ast-program Program)
    (probe-log compiler.link (text: "linked " (. ast-program modules length) " modules"))
    (blank)
    (let session (use (call Session ast-program)))
    (call type-program session typing-worker-count)
    (call (. session seal))
    (blank)
    (let text (call FactsText session search-paths))
    (for (in position (..< 0 (. ast-program modules length)))
      (let module (as position ModuleId))
      (let report (call (. text rendered-diagnostics) module))
      (if (!= (. report length) 0)
        (print report)
      )
      (let declines (call (. text rendered-declines) module))
      (if (!= (. declines length) 0)
        (print declines)
      )
    )
    (call (. ast-program release-trees))
    (call (. session release-typing))
    (return (. session instances length))
  )
  (fn-do + path-to-module (? Path)
    (param name String)
    (let syntax (use (call SyntaxProgram search-paths c-module-paths)))
    (return (call (. syntax path-to-module) name))
  )
)
