(import ./ast)
(import ./ast-children)
(import ./ast-nodes)
(import ./row-range)
(import /core/arena)
(import /core/array-builder)
(import /core/atom-pool)
(import /core/map)
(import /core/parsing)
(import /core/table)
(import /stream/aggregate)

(type + ASTBuilder
  (implements (of Usable Void))
  (implements (of PatternCollectorStorage ArenaBacking))
  (implements (of PatternMaterializationRoot SyntaxId))
  (implements (of PatternCaptureMaterializer Char String))
  (implements (of PatternValueMaterializer String String))
  (implements (of PatternRollback ASTBuilderMark))
  (prop + text-arena Arena)
  (prop + storage-arena Arena)
  (prop + pattern-collector-context Arena)
  (prop + source String)
  (prop + source-path String)
  (prop + nodes (of Table Syntax))
  (prop + children (of ArrayBuilder SyntaxId ArenaBacking))
  (prop + atoms (of ArrayBuilder Atom ArenaBacking))
  (prop + stored-atoms (of ArrayBuilder Atom ArenaBacking))
  (prop + root SyntaxId (= 0))
  (prop + atom-state SyntaxAtomState (= .local))
  (prop + atom-pool (? AtomPool))
  (prop + is-released Bool)
  (blank)
  (prop _ local-atoms AtomPool)
  (prop _ atom-translation (? (of Map U64 Atom ArenaBacking)))
  (prop _ translation-arena (? Arena))
  (prop _ atom-miss Bool)
  (prop _ atom-lock (? Mutex))
  (blank)
  (delegate (of PatternCaptureMaterializer Char Atom))
  (delegate (of PatternValueMaterializer String Atom))
  (prop _ atom-materializer SyntaxAtomPatternMaterializer)
  (fn-do + This _
    (param input-source String)
    (param input-source-path String (= ""))
    (param capacity-length Size (= 0))
    (call (. children reserve) (call syntax-storage-capacity (+ (. input-source length) capacity-length) 16 0))
    (call (. atoms reserve) (call syntax-storage-capacity (+ (. input-source length) capacity-length) 32 0))
    (blank)
    (lazy pattern-collector-context storage-arena)
    (lazy source (call (. text-arena copy-string) input-source))
    (lazy source-path (call (. text-arena copy-string) input-source-path))
    (lazy children (call (of ArrayBuilder SyntaxId) storage-arena))
    (lazy atoms (call (of ArrayBuilder Atom) storage-arena))
    (lazy stored-atoms (call (of ArrayBuilder Atom) storage-arena))
    (lazy local-atoms (call AtomPool))
    (lazy atom-materializer (call SyntaxAtomPatternMaterializer local-atoms))
    (lazy nodes
      (call new-syntax-table
        (block
          (arg storage-arena)
          (arg (call syntax-storage-capacity (+ (. input-source length) capacity-length) 4 1))
        )
      )
    )
  )
  (fn-do + publish-program-atoms _
    (param pool AtomPool)
    (throw (call Panic "ASTBuilder is stale or released") (if is-released))
    (throw (call Panic "ASTBuilder Atom promotion is already published") (if (!= atom-state .local)))
    (blank)
    (= atom-pool pool)
    (= atom-state .program)
  )
  (fn-expr + materialize-capture String (without gc)
    (param source ([] Char))
    (param start Index)
    (param end Index)
    (call (. text-arena copy-span) source start end)
  )
  (fn-expr + materialize-value String (without gc)
    (param input String)
    (call store-string input)
  )
  (fn-expr + mark ASTBuilderMark
    (call ASTBuilderMark (. text-arena mark) (. nodes mark) (. children mark))
  )
  (fn-do + rewind _
    (param mark ASTBuilderMark)
    (call (. text-arena rewind) (. mark text))
    (call (. nodes rewind) (. mark nodes))
    (call (. children rewind) (. mark children))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _ (without gc)
    (call release)
  )
  (fn-do + release _ (without gc)
    (if (not is-released)
      (call release-translation)
      (call (. local-atoms release))
      (call (. text-arena release))
      (call (. storage-arena release))
      (= is-released true)
    )
  )
  (fn-do + finish AST
    (param program-atoms AtomPool)
    (throw (call Panic "ASTBuilder is stale or released") (if is-released))
    (blank)
    (call promote-atoms program-atoms)
    (blank)
    (let text text-arena)
    (let storage storage-arena)
    (let path source-path)
    (let node-data (call (. nodes finish)))
    (let child-data (call (. children finish-immutable)))
    (let atom-data (call (. atoms finish-immutable)))
    (let stored-data (call (. stored-atoms finish-immutable)))
    (let links (call link-children storage node-data child-data))
    (= is-released true)
    (return
      (call AST
        (block
          (arg text)
          (arg storage)
          (arg local-atoms)
          (arg source)
          (arg path)
          (arg node-data)
          (arg child-data)
          (arg atom-data)
          (arg stored-data)
          (arg (call (. links ids finish-immutable)))
          (arg (. links ends))
          (arg (. links starts))
          (arg root)
        )
      )
    )
  )
  (fn-expr + syntax-or-invalid SyntaxId
    (param value (? SyntaxId))
    (if-expr value value 0)
  )
  (fn-do + (of append Node) SyntaxId
    (param node Node)
    (constraint is Node SyntaxNode)
    (throw (call Panic "ASTBuilder node table exceeds the valid Syntax ID range") (if (>= (. nodes length) (. U32 max))))
    (blank)
    (let index (. nodes length))
    (call (. nodes append) node)
    (return (as index SyntaxId))
  )
  (fn-expr + child-ids (of IndexSpan SyntaxId)
    (param range (of RowRange SyntaxId))
    (call (of IndexSpan SyntaxId) children (..< (. range start) (. range end)))
  )
  (fn-do + store-child (of RowRange SyntaxId)
    (param first SyntaxId)
    (param second (? SyntaxId) (= null))
    (param third (? SyntaxId) (= null))
    (let count Size 1)
    (if second
      (+= count 1)
    )
    (if third
      (+= count 1)
    )
    (blank)
    (throw (call Panic "ASTBuilder child pool exceeds U32 capacity") (if (> (. children length) (- (. U32 max) count))))
    (blank)
    (let start (. children length))
    (call (. children append) first)
    (if second
      (call (. children append) second)
    )
    (if third
      (call (. children append) third)
    )
    (return (call (of RowRange SyntaxId) (as start U32) (as count U32)))
  )
  (fn-do + (of store-children Item) (of RowRange SyntaxId)
    (param items (of ImmutableArray Item))
    (constraint is Item SyntaxId)
    (throw (call Panic "ASTBuilder child pool exceeds U32 capacity") (if (or (> (. children length) (. U32 max)) (> (. items length) (- (. U32 max) (. children length))))))
    (blank)
    (let start (. children length))
    (for (in item items)
      (call (. children append) item)
    )
    (return (call (of RowRange SyntaxId) (as start U32) (as (. items length) U32)))
  )
  (fn-expr + (of store-optional-children Item) (of RowRange SyntaxId)
    (param items (? (of ImmutableArray Item)))
    (constraint is Item SyntaxId)
    (case? items
      (call store-children items)
    )
    (default
      (call (of RowRange SyntaxId))
    )
  )
  (fn-do + call-operands (of RowRange SyntaxId)
    (param params (of RowRange SyntaxId))
    (param args (of RowRange SyntaxId))
    (throw (call Panic "Call type arguments exceed the row's count width") (if (> (. params count) (. U8 max))))
    (return-if args (if (. params is-empty)))
    (return-if params (if (. args is-empty)))
    (return-if (call (of RowRange SyntaxId) (. params start) (+ (. params count) (. args count))) (if (== (. args start) (. params end))))
    (blank)
    (throw (call Panic "ASTBuilder child pool exceeds U32 capacity") (if (> (. children length) (- (. U32 max) (. params count) (. args count)))))
    (blank)
    (let start (. children length))
    (for (in offset (..< 0 (. params count)))
      (call (. children append) ([] children (+ (. params start) offset)))
    )
    (for (in offset (..< 0 (. args count)))
      (call (. children append) ([] children (+ (. args start) offset)))
    )
    (return (call (of RowRange SyntaxId) (as start U32) (+ (. params count) (. args count))))
  )
  (fn-do + make-call SyntaxId
    (param loc MatchLocation)
    (param callable SyntaxId)
    (param params (of ImmutableArray SyntaxId))
    (param args (of ImmutableArray SyntaxId))
    (param is-curried Bool)
    (let stored-params (call store-children params))
    (let stored-args (call store-children args))
    (let operands (call call-operands stored-params stored-args))
    (return (call append (call ASTCallExpression loc callable operands (as (. stored-params count) U8) is-curried)))
  )
  (fn-do + store-atoms (of RowRange Atom)
    (param items (of ImmutableArray Atom))
    (throw (call Panic "ASTBuilder atom pool exceeds U32 capacity") (if (or (> (. atoms length) (. U32 max)) (> (. items length) (- (. U32 max) (. atoms length))))))
    (blank)
    (let start (. atoms length))
    (call (. atoms append-all) items)
    (return (call (of RowRange Atom) (as start U32) (as (. items length) U32)))
  )
  (fn-expr + store-optional-atoms (of RowRange Atom)
    (param items (? (of ImmutableArray Atom)))
    (case? items
      (call store-atoms items)
    )
    (default
      (call (of RowRange Atom))
    )
  )
  (fn-expr + store-string String (without gc)
    (param value String)
    (case? (call (. text-arena owns) value)
      value
    )
    (default
      (call (. text-arena copy-string) value)
    )
  )
  (fn-do + atom Atom
    (param text String)
    (return-if (call (. local-atoms store) text) (if (== atom-state .local)))
    (blank)
    (let lock (!! atom-lock))
    (use lock)
    (let stored (call (. (!! atom-pool) store) text))
    (call (. stored-atoms append) stored)
    (return stored)
  )
  (fn-do + atom-bytes Atom
    (param source (of ImmutableArray Byte))
    (param start Index)
    (param end Index)
    (return-if (call (. local-atoms store) source start end) (if (== atom-state .local)))
    (return (call atom (call (. source slice-string) (..< start end))))
  )
  (fn-expr + owns-atom Bool
    (param atom Atom)
    (call (. local-atoms owns) atom)
  )
  (fn-expr + store-optional-string (? String)
    (param value (? String))
    (only-if (call store-string value) (if value))
  )
  (fn-do + store-property-decorations StoredPropertyDecorations
    (param decorations (of ImmutableArray SyntaxId))
    (let decoration (? Atom))
    (let annotations (call (of ArrayBuilder Atom)))
    (for (in id decorations)
      (match ([] nodes id)
        (case (call .node-decoration row)
          (if (or (== (. row name text) "task") (== (. row name text) "thread") (== (. row name text) "stack"))
            (= decoration (. row name))
            (else
              (call (. annotations append) (. row name))
            )
          )
        )
        (throw (call Panic "Expected a property decoration"))
      )
    )
    (blank)
    (return (call StoredPropertyDecorations decoration (call store-atoms (call (. annotations finish-immutable)))))
  )
  (fn-do + promote-atoms _
    (param program-atoms AtomPool)
    (throw (call Panic "ASTBuilder is stale or released") (if is-released))
    (blank)
    (if (== atom-state .program)
      (throw (call Panic "ASTBuilder Atoms belong to another Program") (if (!= (!! atom-pool) program-atoms)))
      (return)
    )
    (blank)
    (call translate-atoms program-atoms)
    (return-if (if (call apply-atom-translation program-atoms)))
    (blank)
    (let completed (call rewrite-atoms program-atoms null))
    (throw (call Panic "ASTBuilder atom promotion did not resolve every atom") (if (not completed)))
    (blank)
    (call publish-program-atoms program-atoms)
  )
  (fn-do + share-program-atoms _
    (param program-atoms AtomPool)
    (param lock Mutex)
    (call translate-atoms-holding program-atoms lock)
    (if (not (call apply-atom-translation program-atoms))
      (call promote-atoms-holding program-atoms lock)
    )
    (= atom-lock lock)
  )
  (fn-do _ translate-atoms-holding _
    (param program-atoms AtomPool)
    (param lock Mutex)
    (use lock)
    (call translate-atoms program-atoms)
  )
  (fn-do _ promote-atoms-holding _
    (param program-atoms AtomPool)
    (param lock Mutex)
    (use lock)
    (call promote-atoms program-atoms)
  )
  (fn-do + translate-atoms _
    (param program-atoms AtomPool)
    (throw (call Panic "ASTBuilder is stale or released") (if is-released))
    (return-if (if (== atom-state .program)))
    (blank)
    (call drop-translation)
    (let arena (call Arena))
    (let translation (call (of Map U64 Atom) arena))
    (for (in index (..< 0 (. local-atoms length)))
      (let atom ([] local-atoms index))
      (let stored (call (. program-atoms store) (. atom text)))
      (= ([] translation (. atom address)) stored)
      (call (. stored-atoms append) stored)
    )
    (= translation-arena arena)
    (= atom-translation translation)
  )
  (fn-do + apply-atom-translation Bool
    (param program-atoms AtomPool)
    (throw (call Panic "ASTBuilder is stale or released") (if is-released))
    (return-if true (if (== atom-state .program)))
    (return-if false (if (not atom-translation)))
    (blank)
    (let applied (call rewrite-atoms program-atoms atom-translation))
    (call drop-translation)
    (if applied
      (call publish-program-atoms program-atoms)
    )
    (return applied)
  )
  (fn-do _ release-translation _ (without gc)
    (if translation-arena
      (call (. translation-arena release))
    )
  )
  (fn-do _ drop-translation _
    (call release-translation)
    (= translation-arena null)
    (= atom-translation null)
  )
  (fn-do _ resolve-atom Atom
    (param atom Atom)
    (param program-atoms AtomPool)
    (param translation (? (of Map U64 Atom ArenaBacking)))
    (return-if (call (. program-atoms store) (. atom text)) (if (not translation)))
    (blank)
    (let resolved ([] translation (. atom address)))
    (return-if resolved (if resolved))
    (blank)
    (= atom-miss true)
    (return atom)
  )
  (fn-do _ rewrite-atoms Bool
    (param program-atoms AtomPool)
    (param translation (? (of Map U64 Atom ArenaBacking)))
    (= atom-miss false)
    (let atom-items atoms)
    (for (in index (..< 0 (. atom-items length)))
      (= ([] atom-items index) (call resolve-atom ([] atom-items index) program-atoms translation))
    )
    (blank)
    (for (in syntax-node nodes)
      (match? syntax-node
        (case (call .node-class-block node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-event-declaration node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-effect-declaration node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-function-syntax node)
          (if (. node door)
            (let door (. node door))
            (= (. node door) (call resolve-atom door program-atoms translation))
          )
        )
        (case (call .node-property-syntax node)
          (if (. node decoration)
            (let decoration (. node decoration))
            (= (. node decoration) (call resolve-atom decoration program-atoms translation))
          )
        )
        (case (call .node-state-case node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-state-continuation node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-state-fallback node)
          (= (. node target) (call resolve-atom (. node target) program-atoms translation))
        )
        (case (call .node-enum-declaration node)
          (if (. node name)
            (let name (. node name))
            (= (. node name) (call resolve-atom name program-atoms translation))
          )
        )
        (case (call .node-rule-syntax node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-style-when node)
          (= (. node state) (call resolve-atom (. node state) program-atoms translation))
        )
        (case (call .node-integer-syntax node)
          (if (. node unit)
            (let unit (. node unit))
            (= (. node unit) (call resolve-atom unit program-atoms translation))
          )
        )
        (case (call .node-float-syntax node)
          (if (. node unit)
            (let unit (. node unit))
            (= (. node unit) (call resolve-atom unit program-atoms translation))
          )
        )
        (case (call .node-identifier node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-ref-identifier node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-symbol node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-anonymous-case node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
          (if (. node owner)
            (let owner (. node owner))
            (= (. node owner) (call resolve-atom owner program-atoms translation))
          )
        )
        (case (call .node-decoration node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-c-identifier node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-style-rule-application node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-type-identifier node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-type-associated node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-type-case node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-type-property node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-probe-statement node)
          (if (. node key)
            (let key (. node key))
            (= (. node key) (call resolve-atom key program-atoms translation))
          )
        )
        (case (call .node-stack-local-binding-block node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-get-expression node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-style-read-expression node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-style-property-expression node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
          (if (. node component)
            (= (. node component) (call resolve-atom (. node component) program-atoms translation))
          )
        )
        (case (call .node-markup-read-expression node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-argument node)
          (if (. node name)
            (let name (. node name))
            (= (. node name) (call resolve-atom name program-atoms translation))
          )
        )
        (case (call .node-stream-call node)
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
        (case (call .node-stream-collector-mapping node)
          (if (. node callee)
            (let callee (. node callee))
            (= (. node callee) (call resolve-atom callee program-atoms translation))
          )
          (= (. node caller) (call resolve-atom (. node caller) program-atoms translation))
        )
        (case (call .node-probe node)
          (if (. node name)
            (let name (. node name))
            (= (. node name) (call resolve-atom name program-atoms translation))
          )
          (if (. node key)
            (let key (. node key))
            (= (. node key) (call resolve-atom key program-atoms translation))
          )
        )
        (case (call .node-probe-group node)
          (if (. node key)
            (let key (. node key))
            (= (. node key) (call resolve-atom key program-atoms translation))
          )
        )
        (case (call .node-probe-assign node)
          (= (. node key) (call resolve-atom (. node key) program-atoms translation))
        )
        (case (call .node-probe-counter node)
          (= (. node key) (call resolve-atom (. node key) program-atoms translation))
        )
        (case (call .node-whenever-rule-syntax node)
          (= (. node kind) (call resolve-atom (. node kind) program-atoms translation))
        )
        (case (call .node-core-type-identifier node)
          (= (. node module-name) (call resolve-atom (. node module-name) program-atoms translation))
          (= (. node name) (call resolve-atom (. node name) program-atoms translation))
        )
      )
    )
    (blank)
    (return (not atom-miss))
  )
)

(type + SyntaxAtomState (is U8)
  (variant local (= 0))
  (variant program (= 1))
)

(type _ StoredPropertyDecorations (is Tuple)
  (prop + decoration (? Atom))
  (prop + annotations (of RowRange Atom))
)

(type + ASTBuilderMark (is Tuple)
  (prop + text ArenaMark)
  (prop + nodes TableMark)
  (prop + children Size)
)

(type _ SyntaxAtomPatternMaterializer (is Tuple)
  (implements (of PatternCaptureMaterializer Char Atom))
  (implements (of PatternValueMaterializer String Atom))
  (prop _ pool AtomPool)
  (fn-do + This _
    (param pool AtomPool)
  )
  (fn-expr + materialize-capture Atom (without gc)
    (param source ([] Char))
    (param start Index)
    (param end Index)
    (call (. pool store) source start end)
  )
  (fn-expr + materialize-value Atom (without gc)
    (param input String)
    (call (. pool store) input)
  )
)

(fn-do _ new-syntax-table (of Table Syntax)
  (param arena Arena)
  (param capacity Size)
  (let nodes (call (of Table Syntax) arena capacity))
  (call (. nodes append) (call ASTNoop (call MatchLocation)))
  (return nodes)
)

(fn-do _ syntax-storage-capacity Size
  (param source-length Size)
  (param source-width Size)
  (param minimum Size)
  (let capacity (/ source-length source-width))
  (if (< capacity minimum)
    (= capacity minimum)
  )
  (if (> capacity (. U32 max))
    (= capacity (. U32 max))
  )
  (return capacity)
)
