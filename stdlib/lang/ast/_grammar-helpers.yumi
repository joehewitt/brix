+ do make-assignment SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - op Operator
    - left SyntaxId
    - right SyntaxId
    - is-optional Bool

. rhs = if is-optional then tree.append(ASTOptionalChain(loc, right)) else right
match? tree.nodes[left]
    | .node-structure-match
        = tree.append(ASTMatchExpression(loc, rhs, left, false))
    | .node-stream-match
        = tree.append(ASTMatchExpression(loc, rhs, rooted-stream-match(tree, left), false))
if op == .write-all-op
    = make-write-all(tree, loc, left, rhs)
if op == .bind-op
    track-place(tree, rhs)
match? tree.nodes[left]
    | .node-identifier(identifier)
        assign-anonymous-case-owner-tree(tree, rhs, identifier.name)
= tree.append(ASTAssign(loc, op, left, rhs))

