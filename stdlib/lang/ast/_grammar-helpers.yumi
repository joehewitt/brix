if dependencies
    . items = sequence-pair'SyntaxId(tree, probe, dependencies)
    match? tree.nodes[dependencies]
        | .node-block(block)
            items = prepended-statements(tree, probe, block.body)
    . linked = link-statements(tree, items, false)
    = tree.append(ASTProbeScope(MatchLocation(), tree.store-children(linked)))
