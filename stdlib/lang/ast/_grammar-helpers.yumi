+ make-iterator-from-partial SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - body SyntaxId
    - partial SyntaxId

match tree.nodes[partial]
    | .node-loop-syntax(loop)
        make-iterator-line
            - tree
            - loc
            - loop.container
            - loop.is-subscriber
            - body
            - null
            - loop.clause
            - null
            - null
    ?! Panic("Expected a partial iterator loop")

━━━━━━━━━━━━━━━━━━━━
+ do make-iterator-block SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - container SyntaxId
    - args ImmutableArray'SyntaxId
    - is-subscriber Bool
    - pattern SyntaxId?
    - initial-clauses SyntaxId?

. body SyntaxId?
. clauses = initial-clauses
. last-clause = initial-clauses
. loop SyntaxId?
. last-loop SyntaxId?
. iterator SyntaxId?
. last-iterator SyntaxId?

for arg in args
    match tree.nodes[arg]
        | .node-loop-syntax
            if loop
                tree.set-next(last-loop!, arg)
            else
                loop = arg
            last-loop = arg
        | .node-iterator-expression
            if iterator
                tree.set-next(last-iterator!, arg)
            else
                iterator = arg
            last-iterator = arg
        | .node-clause
            if clauses
                tree.set-next(last-clause!, arg)
            else
                clauses = arg
            last-clause = arg
        ??
            ?! YumiSyntaxError(tree.location(arg), "Redundant block")
                if body
            body = arg

= make-iterator-line(tree, loc, container, is-subscriber, body, pattern, clauses, loop, iterator)

━━━━━━━━━━━━━━━━━━━━
+ make-write-all SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - left SyntaxId
    - right SyntaxId

match tree.nodes[right]
    | .node-iterator-expression(iterator)
        match tree.nodes[iterator.loop]
            | .node-loop-syntax(loop) { !loop.is-subscriber && !iterator.next }
                tree.append(ASTForBlock(loc, iterator.loop, writer, 0))
                    .. item
                        |? iterator.body
                            iterator.body
                        ??
                            tree.append(ASTIdentifier(loc, tree.atom("each"), false))
                    .. writer = tree.append(ASTBinaryExpression(loc, .write-op, left, item))
            ??
                make-write-all-loop(tree, loc, left, right)
    ??
        make-write-all-loop(tree, loc, left, right)

━━━━━━━━━━━━━━━━━━━━
+ make-write-all-loop SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - left SyntaxId
    - right SyntaxId

tree.append(ASTForBlock(loc, loop, writer, 0))
    .. item = tree.append(ASTIdentifier(loc, tree.atom("(item)"), false))
    .. pattern = tree.append(ASTTypeCapture(loc, item, 0))
    .. loop = tree.append(ASTLoop(loc, pattern, right, 0, false, false, 0))
    .. writer = tree.append(ASTBinaryExpression(loc, .write-op, left, item))

