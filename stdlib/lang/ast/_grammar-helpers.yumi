+ anonymous-case-owner-children AnonymousCaseTraversal
    - tree ASTBuilder
    - id SyntaxId
    - owner Atom

match tree.nodes[id]
    | .node-anonymous-case(row)
        update-anonymous-case-owner(tree, id, row.loc, row.name, row.args, owner)
    | .node-block(row)
        AnonymousCaseTraversal(0, 0, 0, 0, row.body, RowRange'SyntaxId())
    | .node-match-expression(row)
        AnonymousCaseTraversal
            - row.subject
            - row.body
            - row.helper
            - 0
            - RowRange'SyntaxId()
            - RowRange'SyntaxId()
    | .node-structure-match(row)
        AnonymousCaseTraversal(row.pattern, 0, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-stream-match(row)
        AnonymousCaseTraversal(row.pattern, 0, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-type-transform(row)
