+ reduce-binary-op SyntaxId
    - tree ASTBuilder
    - loc
    - seed SyntaxId
    - stream
    - is-optional = false

reduce(seed, stream) • using :: accum, pair =>
    binary-op(tree, loc, pair[0], accum, pair[1], is-optional)

━━━━━━━━━━━━━━━━━━━━
+ do reduce-glt-op SyntaxId
    - tree ASTBuilder
    - loc
    - seed SyntaxId
    - stream

` A chain of orderings: `a < b < c` is `a < b && b < c`, and each further ordering compares
` with the right side of the one before it. That side is evaluated once: the ordering before
` holds it, and the next one reads what was held. The orderings are joined from the right,
` `a < b && (b < c && c < d)`, so each read is in the right side of the `&&` whose left side
` holds its value.
. chain = seed
. last = seed
. links [SyntaxId]
for pair in stream
    . shared = compared-right(tree, last)
    if shared != 0
        hold-right(tree, last)
        . read = tree.append(ASTHeldRead(tree.location(shared)))
        last = tree.append(ASTBinaryExpression(loc, pair[0], read, pair[1]))
        links += last
    else
        chain = tree.append
            - ASTBinaryExpression(loc, pair[0], join-orderings(tree, loc, chain, links), pair[1])
        links.clear()
        last = chain
= join-orderings(tree, loc, chain, links)

━━━━━━━━━━━━━━━━━━━━
+ do join-orderings SyntaxId
    - tree ASTBuilder
    - loc
    - first SyntaxId
    - links [SyntaxId]

` The orderings of a chain joined by `&&` from the right.
if links.length == 0
    = first
. index = links.length - 1
. joined = links[index]
while index != 0
    index -= 1
    joined = tree.append(ASTBinaryExpression(loc, .and-op, links[index], joined))
= tree.append(ASTBinaryExpression(loc, .and-op, first, joined))

━━━━━━━━━━━━━━━━━━━━
+ do hold-right
    - tree ASTBuilder
    - ordering SyntaxId

` Makes the right side of an ordering a node that holds its value.
match? tree.nodes[ordering]
    | .node-binary-expression(row)
        . holder = tree.append(ASTHeldExpression(tree.location(row.rhs), row.rhs))
        tree.nodes[ordering] = ASTBinaryExpression(row.loc, row.op, row.lhs, holder)

