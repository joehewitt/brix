+ do make-pattern-bracket SyntaxId
    - tree ASTBuilder
    - loc
    - patterns ImmutableArray'SyntaxId

validate-single-remainder(tree, patterns)

. first-kind String?
. mixed SyntaxId?
for pattern in patterns
    . kind = tree.pattern-container-kind(pattern)
    if kind
        if !first-kind
            first-kind = kind
        else if first-kind != kind
            mixed = pattern
            break

if mixed
    ?! YumiSyntaxError(mixed-end, "Cannot mix sequence and map items in one bracket pattern")
    .. mixed-end = exclusive-end-location(tree.location(mixed))

. type =
    |? first-kind == "map"
        tree.append(ASTTypeMap(loc, tree.store-children(patterns)))
    ??
        tree.append(ASTTypeList(loc, tree.store-children(patterns)))
= type

━━━━━━━━━━━━━━━━━━━━
+ do validate-single-remainder
    - tree ASTBuilder
    - patterns ImmutableArray'SyntaxId

. found = false
for pattern in patterns
    if tree.is-type-remainder(pattern)
        if found
            ?! YumiSyntaxError(pattern-end, "Pattern may contain only one remainder")
            .. pattern-end = exclusive-end-location(tree.location(pattern))
        found = true

━━━━━━━━━━━━━━━━━━━━
+ make-pattern-and-chain SyntaxId
    - tree ASTBuilder
    - loc
    - head SyntaxId
    - tail ImmutableArray'SyntaxId

reduce(head, tail) • using :: left, right =>
    ?! YumiSyntaxError(exclusive-end-location(tree.location(right)), "Pattern may contain only one remainder")
        if contains-pattern-remainder(tree, left) && contains-pattern-remainder(tree, right)
    tree.append(ASTTypeAnd(loc, left, right))

━━━━━━━━━━━━━━━━━━━━
+ contains-pattern-remainder Bool
    - tree ASTBuilder
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-remainder
        true
    | .node-type-and(and-pattern)
        contains-pattern-remainder(tree, and-pattern.left) || has-right-remainder
        .. has-right-remainder = contains-pattern-remainder(tree, and-pattern.right)
    | .node-type-or(or-pattern)
        contains-pattern-remainder(tree, or-pattern.left) || has-alternate-remainder
        .. has-alternate-remainder = contains-pattern-remainder(tree, or-pattern.right)
    | .node-type-capture(capture)
        if capture.type != 0 then contains-pattern-remainder(tree, capture.type) else false
    | .node-type-match(match-type)
        contains-pattern-remainder(tree, match-type.type)
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ do task-scheduling TaskSchedulingClass
    - loc MatchLocation
    - annotations ImmutableArray'Atom

. scheduling TaskSchedulingClass = .task-scheduling-normal
. found = false
for name in annotations
    if name.text == "large-stack" || name.text == "detached"
        continue
    . requested TaskSchedulingClass = match name.text
        |= "normal"
            .task-scheduling-normal
        |= "priority"
            .task-scheduling-priority
        ?! YumiSyntaxError(loc, "Unsupported do task annotation '${name.text}'")
    ?! YumiSyntaxError(loc, "Conflicting do task scheduling annotation '${name.text}'")
        if found && scheduling != requested
    scheduling = requested
    found = true
= scheduling

━━━━━━━━━━━━━━━━━━━━
+ do task-large-stack Bool
    - annotations ImmutableArray'Atom

for name in annotations
    if name.text == "large-stack"
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do task-detached Bool
    - annotations ImmutableArray'Atom

for name in annotations
    if name.text == "detached"
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ unannotated-body SyntaxId
    - loc MatchLocation
    - body DoBody
    - kind String

?! YumiSyntaxError(loc, "Unsupported $kind annotation '${body.annotations[0].text}'")
    if body.annotations.length > 0

body.body

━━━━━━━━━━━━━━━━━━━━
+ do has-annotation Bool
    - names ImmutableArray'Atom
    - text String

for name in names
    if name.text == text
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ compilation-effect-named CompilationEffect
    - text String

match text
    |= "no-heap"
        CompilationEffect.no-heap
    |= "no-safepoint"
        CompilationEffect.no-safepoint
    |= "no-safepoints"
        CompilationEffect.no-safepoint
    |= "no-probe-safepoint"
        CompilationEffect.no-probe-safepoint
    |= "no-probe-safepoints"
        CompilationEffect.no-probe-safepoint
    |= "no-suspend"
        CompilationEffect.no-suspend
    |= "no-gc"
        CompilationEffect.gc-free /or/ gc-free-parts()
    |= "gc-leaf"
        CompilationEffect.gc-leaf
    |= "gc-polling"
        CompilationEffect.gc-polling
    ??
        CompilationEffect.none

━━━━━━━━━━━━━━━━━━━━
+ gc-free-parts CompilationEffect

CompilationEffect.no-heap /or/ CompilationEffect.no-safepoint /or/ CompilationEffect.no-suspend

━━━━━━━━━━━━━━━━━━━━
+ effects-conflict Bool
    - mask CompilationEffect
    - effect CompilationEffect

gc-free-joined || (mask /and/ effect) == effect

.. gc-free = CompilationEffect.gc-free
.. gc-free-joined = (has(mask, gc-free) && has(effect, gc-free-parts())) || (has(effect, gc-free) && has(mask, gc-free-parts()))

━━━━━━━━━━━━━━━━━━━━
+ has Bool
    - effects CompilationEffect
    - effect CompilationEffect

(effects /and/ effect) != CompilationEffect.none

━━━━━━━━━━━━━━━━━━━━
+ do compilation-effects CompilationEffect
    - loc MatchLocation
    - names ImmutableArray'Atom
    - skips-rollback Bool

. mask = CompilationEffect.none
for name in names
    if name.text == "inline" || is-lowered(name) || (skips-rollback && (name.text == "rollback" || name.text == "live" || name.text == "no-return"))
        continue
    . effect = compilation-effect-named(name.text)
    ?! YumiSyntaxError(loc, "Unknown compilation effect '${name.text}'")
        if effect == CompilationEffect.none
    ?! YumiSyntaxError(loc, "Conflicting compilation effect '${name.text}'")
        if effects-conflict(mask, effect)
    mask = mask /or/ effect
= normalize-compilation-effects(mask)

━━━━━━━━━━━━━━━━━━━━
+ do do-annotation-masks DoAnnotationMasks
    - loc MatchLocation
    - names ImmutableArray'Atom

. effects = CompilationEffect.none
. features = CompilerFeature.none
for name in names
    if name.text == "feature-collection-observers"
        features = features /or/ CompilerFeature.collection-observers
        continue
    ?! YumiSyntaxError(loc, "'@door' is only for a function")
        if name.text.starts-with("door:")
    if name.text.starts-with("without:")
        continue
    . effect = compilation-effect-named(name.text)
    ?! YumiSyntaxError(loc, "Unknown do annotation '${name.text}'")
        if effect == CompilationEffect.none
    ?! YumiSyntaxError(loc, "Conflicting do annotation '${name.text}'")
        if effects-conflict(effects, effect)
    effects = effects /or/ effect
= DoAnnotationMasks(normalize-compilation-effects(effects), features)

━━━━━━━━━━━━━━━━━━━━
+ do written-annotation Atom ?! YumiSyntaxError
    - loc MatchLocation
    - name Atom

` An annotation written with `@`. A restriction and a C function's label are written in a
` `without` section, and the names they lower to are refused here.
. meant = restriction-name(name.text)
if meant
    ?! YumiSyntaxError(loc, "Write 'without $meant' in place of '@${name.text}'")
= name

━━━━━━━━━━━━━━━━━━━━
+ restriction-name String?
    - text String

` The name after `without` that the annotation a restriction lowers to stands for, if it is one.
match text
    |= "no-heap"
        "heap"
    |= "no-suspend"
        "suspend"
    |= "no-gc"
        "gc"
    |= "gc-leaf"
        "gc"
    |= "no-safepoint"
        "safepoints"
    |= "no-safepoints"
        "safepoints"
    |= "no-probe-safepoint"
        "probe-safepoints"
    |= "no-probe-safepoints"
        "probe-safepoints"
    |= "gc-polling"
        "blocking"
    ??
        null

━━━━━━━━━━━━━━━━━━━━
+ do door-annotation Atom
    - tree ASTBuilder
    - effect Atom

` The annotation `@door(effect)` stands for, which the function it is written on keeps as its
` `door`.
= tree.atom("door:${effect.text}")

━━━━━━━━━━━━━━━━━━━━
+ is-lowered Bool
    - name Atom

` Whether an annotation stands for a door or a ban, which a function or a `do` block keeps apart
` from its masks.
name.text.starts-with("door:") || name.text.starts-with("without:")

━━━━━━━━━━━━━━━━━━━━
+ do unlowered ImmutableArray'Atom ?! YumiSyntaxError
    - loc MatchLocation
    - names ImmutableArray'Atom

` The annotations of a conversion, which is no door and bans no effect.
for name in names
    ?! YumiSyntaxError(loc, "A conversion cannot be a door")
        if name.text.starts-with("door:")
    ?! YumiSyntaxError(loc, "A conversion cannot ban an effect, as 'without ${name.text["without:".length ...]}' does")
        if name.text.starts-with("without:")
= names

━━━━━━━━━━━━━━━━━━━━
+ do lowered-bans RowRange'Atom
    - tree ASTBuilder
    - names ImmutableArray'Atom

` The effects the `without` section of a function or a `do` block bans, which the checker looks
` up among those declared.
. bans = scratch-array'Atom(tree, names.length)
. filled Size = 0
for name in names
    if name.text.starts-with("without:")
        bans[filled] = tree.atom(name.text["without:".length ...])
        filled += 1
=? RowRange'Atom() if filled == 0
= tree.store-atoms(scratch-items(bans, filled))

━━━━━━━━━━━━━━━━━━━━
+ do lowered-door Atom? ?! YumiSyntaxError
    - tree ASTBuilder
    - loc MatchLocation
    - names ImmutableArray'Atom

` The effect a function is a door of, if it names one.
. door Atom? = null
for name in names
    if name.text.starts-with("door:")
        ?! YumiSyntaxError(loc, "A function is the door of one effect")
            if door
        door = tree.atom(name.text["door:".length ...])
= door

━━━━━━━━━━━━━━━━━━━━
+ do section-annotations ImmutableArray'Atom ?! YumiSyntaxError
    - tree ASTBuilder
    - loc MatchLocation
    - annotations ImmutableArray'Atom
    - sections SectionsPartial?
    - is-block Bool

` The annotations a `without` section stands for, after those written with `@`: a restriction's,
` and for any other name a ban of the effect it names, which the checker looks up. In a header
` module `gc` and `blocking` are the labels of a C function, and no other name is known.
=? annotations if !sections
. names = sections.without
=? annotations if names.length == 0
. native = tree.source-path.ends-with(".h")
. joined = scratch-array'Atom(tree, annotations.length + names.length)
. filled Size = 0
for annotation in annotations
    joined[filled] = annotation
    filled += 1
for name in names
    . text = name.text
    if text == "cancel"
        ?! YumiSyntaxError(loc, "'without cancel' is only for a do block")
            if !is-block
        continue
    ?! YumiSyntaxError(loc, "'without blocking' is only for a C function")
        if text == "blocking" && !native
    . meant = match text
        |= "heap"
            "no-heap"
        |= "suspend"
            "no-suspend"
        |= "gc"
            if native then "gc-leaf" else "no-gc"
        |= "safepoints"
            "no-safepoints"
        |= "probe-safepoints"
            "no-probe-safepoints"
        |= "blocking"
            "gc-polling"
        ??
            if native then "" else "without:$text"
    ?! YumiSyntaxError(loc, "Unknown name '$text' after without")
        if meant.length == 0
    for index in 0 .. < filled
        ?! YumiSyntaxError(loc, "'$text' is named twice")
            if joined[index].text == meant
    joined[filled] = tree.atom(meant)
    filled += 1
= scratch-items(joined, filled)

━━━━━━━━━━━━━━━━━━━━
+ do stack-bound SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - bindings ImmutableArray'StackBindingPartial
    - body SyntaxId

` The body inside the bindings of a `with` section, the first binding outermost.
. inner = body
. index = bindings.length
while index > 0
    index -= 1
    . binding = bindings[index]
    . held = if index == bindings.length - 1 then inner else tree.append(ASTBlock(loc, tree.store-child(inner)))
    inner = tree.append(ASTStackLocalBindingBlock(loc, binding.name, binding.value, held))
= inner

━━━━━━━━━━━━━━━━━━━━
+ do sectioned-do SyntaxId ?! YumiSyntaxError
    - tree ASTBuilder
    - loc MatchLocation
    - sections SectionsPartial
    - body DoBody

. annotations = section-annotations(tree, loc, body.annotations, sections, true)
. bindings = sections.bindings
. holds = names-cancel(sections.without)
=? stack-bound(tree, loc, bindings, body.body) if annotations.length == 0 && bindings.length > 0 && !holds
. masks = do-annotation-masks(loc, annotations)
. block = tree.append(ASTDoBlock(loc, body.body, masks.effects, masks.features, holds, lowered-bans(tree, annotations)))
=? block if bindings.length == 0
= stack-bound(tree, loc, bindings, tree.append(ASTBlock(loc, tree.store-child(block))))

━━━━━━━━━━━━━━━━━━━━
_ do names-cancel Bool
    - names ImmutableArray'Atom

for name in names
    =? true if name.text == "cancel"
= false

━━━━━━━━━━━━━━━━━━━━
+ do sectioned-body SyntaxId? ?! YumiSyntaxError
    - tree ASTBuilder
    - loc MatchLocation
    - sections SectionsPartial?
    - is-imperative Bool
    - body SyntaxId?

` A function's body inside the bindings of the `with` section on its header.
=? body if !sections
. bindings = sections.bindings
=? body if bindings.length == 0
?! YumiSyntaxError(loc, "A 'with' section needs a do function")
    if !is-imperative
?! YumiSyntaxError(loc, "A 'with' section needs a body")
    if !body
= tree.append(ASTBlock(loc, tree.store-child(stack-bound(tree, loc, bindings, body))))

━━━━━━━━━━━━━━━━━━━━
+ normalize-compilation-effects CompilationEffect
    - effects CompilationEffect

match effects /and/ CompilationEffect.gc-free
    |= CompilationEffect.none
        match effects /and/ CompilationEffect.no-safepoint
            |= CompilationEffect.none
                effects
            ??
                effects /or/ CompilationEffect.no-suspend
    ??
        no-heap-effects /or/ CompilationEffect.no-safepoint /or/ CompilationEffect.no-suspend
        .. no-heap-effects = effects /or/ CompilationEffect.no-heap

━━━━━━━━━━━━━━━━━━━━
+ do imperative-body SyntaxId?
    - tree ASTBuilder
    - is-imperative Bool
    - body SyntaxId?

if is-imperative
    =? body ?? tree.append(ASTBlock(MatchLocation(), RowRange'SyntaxId()))
= body

━━━━━━━━━━━━━━━━━━━━
+ declaration-body SyntaxId? ?! YumiSyntaxError
    - tree ASTBuilder
    - body SyntaxId?
    - same-line MatchLocation?

?! YumiSyntaxError(same-line, "$cause $correction", tree.source, tree.source-path)
    if body && same-line
body

.. cause = "A divider made this line a function header, and a function body cannot start on its header line."
.. correction = "Declare values before the first divider, or leave a blank line after a thick divider (━)."

━━━━━━━━━━━━━━━━━━━━
+ extend ASTBuilder

────────────────────
+ location MatchLocation
    - id SyntaxId

nodes.loc[id]

────────────────────
+ capture-name Atom
    - id SyntaxId

match nodes[id]
    | .node-type-capture(capture)
        match nodes[capture.id]
            | .node-identifier(identifier)
                identifier.name
            ?! Panic("Type capture identifier has the wrong syntax case")
    ?! Panic("Expected a type capture")

────────────────────
+ capture-type SyntaxId
    - id SyntaxId

match nodes[id]
    | .node-type-capture(capture)
        capture.type
    ?! Panic("Expected a type capture")

────────────────────
+ identifier-name Atom
    - id SyntaxId

match nodes[id]
    | .node-identifier(identifier)
        identifier.name
    ?! Panic("Expected an identifier")

────────────────────
+ is-type-remainder Bool
    - id SyntaxId

match nodes[id]
    | .node-type-remainder
        true
    ??
        false

────────────────────
+ pattern-container-kind String?
    - id SyntaxId

match nodes[id]
    | .node-type-remainder
        null
    | .node-type-map-item
        "map"
    ??
        "sequence"

━━━━━━━━━━━━━━━━━━━━
+ extend ASTBuilder

────────────────────
+ do mark-style-sheet
    - id SyntaxId
    - tags RowRange'Atom

match? nodes[id]
    | .node-class-block(row)
        row.is-style-sheet = true
        row.tags = tags

────────────────────
+ set-next
    - id SyntaxId
    - next SyntaxId?

match nodes[id]
    | .node-if-block(row)
        row.next = next-id
    | .node-for-block(row)
        row.next = next-id
    | .node-loop-syntax(row)
        row.next = next-id
    | .node-iterator-expression(row)
        row.next = next-id
    | .node-clause(row)
        row.next = next-id
    ?! Panic("Syntax node does not support next links")

.. next-id = if next then next else 0

────────────────────
_ do children-appending ImmutableArray'SyntaxId
    - range RowRange'SyntaxId
    - child SyntaxId

. joined = scratch-array'SyntaxId(this, range.count + 1)
for offset in 0 .. < range.count
    joined[offset] = children[range.start + offset]
joined[range.count] = child
= scratch-items(joined, range.count + 1)

────────────────────
_ do children-prepending ImmutableArray'SyntaxId
    - child SyntaxId
    - range RowRange'SyntaxId

. joined = scratch-array'SyntaxId(this, range.count + 1)
joined[0] = child
for offset in 0 .. < range.count
    joined[offset + 1] = children[range.start + offset]
= scratch-items(joined, range.count + 1)

────────────────────
_ do children-concat ImmutableArray'SyntaxId
    - left RowRange'SyntaxId
    - right RowRange'SyntaxId

. joined = scratch-array'SyntaxId(this, left.count + right.count)
for offset in 0 .. < left.count
    joined[offset] = children[left.start + offset]
for offset in 0 .. < right.count
    joined[left.count + offset] = children[right.start + offset]
= scratch-items(joined, left.count + right.count)

────────────────────
+ auto-join SyntaxId?
    - left SyntaxId
    - right SyntaxId

match nodes[left]
    | .node-declare(declaration)
        auto-join-declare(left, declaration.right, right)
    | .node-assertion-syntax
        auto-join-assertion(left, right)
    | .node-catch-expression(catch-expression)
        auto-join-catch-expression(left, catch-expression.body, catch-expression.catchers, right)
    | .node-header-expression
        auto-join-header(left, right)
    | .node-pipeline-expression
        auto-join-pipeline(left, right)
    | .node-feed-expression
        auto-join-feed(left, right)
    | .node-structure-match
        auto-join-structure-match(left, right)
    | .node-stream-match
        auto-join-stream-match(left, right)
    | .node-state-machine(machine)
        match? nodes[right]
            | .node-state-case
                append(ASTStateMachine(machine.loc, extended-body))
                    .. extended-body = store-children(children-appending(machine.body, right))
            | .node-state-fallback
                append(ASTStateMachine(machine.loc, extended-body))
                    .. extended-body = store-children(children-appending(machine.body, right))
            | .node-state-machine(right-machine)
                append(ASTStateMachine(machine.loc, merged-body))
                    .. merged-body = store-children(merged-children)
                    .. merged-children = children-concat(machine.body, right-machine.body)
    | .node-state-case(state)
        match? nodes[right]
            | .node-state-case
                append(ASTStateMachine(state.loc, joined-body))
                    .. joined-body = store-child(left, right)
            | .node-state-fallback
                append(ASTStateMachine(state.loc, joined-body))
                    .. joined-body = store-child(left, right)
            | .node-state-machine(machine)
                append(ASTStateMachine(state.loc, merged-body))
                    .. merged-body = store-children(children-prepending(left, machine.body))
    ??
        auto-join-expression(left, right)

────────────────────
_ do auto-join-structure-match SyntaxId?
    - left SyntaxId
    - right SyntaxId

. right-pattern = match nodes[right]
    | .node-structure-match(row)
        row.pattern
    | .node-assertion-syntax(assertion)
        . condition SyntaxId = 0
        if assertion.condition
            condition = match nodes[assertion.condition]
                | .node-type-predicate(predicate)
                    append(ASTTypePredicate(predicate.loc, predicate.expr, true))
                ??
                    append
                        - ASTTypePredicate
                            - nodes.loc[assertion.condition]
                            - assertion.condition
                            - true
        append
            - ASTTypePanic
                - assertion.loc
                - append(ASTTypeTransform(assertion.loc, assertion.exception, condition, false))
    ??
        0
=? null if !right-pattern

. left-pattern = match nodes[left]
    | .node-structure-match(row)
        row.pattern
    ?! Panic("Expected a structure match syntax node")
. joined = append(ASTTypeOr(nodes.loc[right-pattern], left-pattern, right-pattern))
match nodes[left]
    | .node-structure-match(row)
        row.pattern = joined
    ?! Panic("Expected a structure match syntax node")
= left

────────────────────
_ do auto-join-stream-match SyntaxId?
    - left SyntaxId
    - right SyntaxId

. right-pattern = match nodes[right]
    | .node-stream-match(row)
        row.pattern
    | .node-structure-match(row)
        match nodes[row.pattern]
            | .node-type-transform(transform) { !transform.pattern }
                append(ASTStreamTransform(transform.loc, 0, transform.expr, false))
            ??
                0
    | .node-assertion-syntax(assertion) { !assertion.condition }
        append
            - ASTStreamPanic
                - assertion.loc
                - append(ASTStreamTransform(assertion.loc, 0, assertion.exception, false))
    ??
        0
=? null if !right-pattern

. left-pattern = match nodes[left]
    | .node-stream-match(row)
        row.pattern
    ?! Panic("Expected a stream match syntax node")
. joined = append(ASTStreamOr(nodes.loc[right-pattern], left-pattern, right-pattern))
match nodes[left]
    | .node-stream-match(row)
        row.pattern = joined
    ?! Panic("Expected a stream match syntax node")
= left

────────────────────
_ do auto-join-header SyntaxId?
    - left SyntaxId
    - right SyntaxId

=? null if !is-joinable-header-item(right)

` The header is written again after the item it gains, so that a node always follows what it
` holds.
= match nodes[left]
    | .node-header-expression(header)
        append(ASTHeaderExpression(header.loc, header.expr, items))
            .. items = store-children(children-appending(header.items, right))
    ?! Panic("Expected a header syntax node")

────────────────────
_ auto-join-pipeline SyntaxId?
    - left SyntaxId
    - right SyntaxId

match? nodes[right]
    | .node-feed-expression
        append-pipeline-feed(left, right)
    | .node-pipeline-expression
        set-pipeline-left(right, left)

────────────────────
_ auto-join-feed SyntaxId?
    - left SyntaxId
    - right SyntaxId

match? nodes[right]
    | .node-feed-expression
        append-feed-join(left, right)
    | .node-pipeline-expression
        set-pipeline-left(right, left)

────────────────────
_ auto-join-expression SyntaxId?
    - left SyntaxId
    - right SyntaxId

|? !is-expression(left)
    null
??
    match? nodes[right]
        | .node-pipeline-expression(pipeline)
            set-pipeline-left(right, left)
        | .node-catcher
            append(ASTCatchExpression(nodes.loc[left], left, false, store-child(right)))

────────────────────
_ do auto-join-declare SyntaxId?
    - left SyntaxId
    - expression SyntaxId
    - right SyntaxId

=? null if !expression
=? null if nodes[right] is not .node-catcher

. joined = auto-join(expression, right)
=? null if !joined || !is-expression(joined)

= match nodes[left]
    | .node-declare(row)
        append
            - ASTDeclare
                - row.loc
                - row.left
                - joined
                - row.is-lazy
                - row.is-pattern
                - row.rollback
                - row.is-scoped
    ?! Panic("Expected a declaration syntax node")

────────────────────
_ auto-join-assertion SyntaxId?
    - left SyntaxId
    - right SyntaxId

match? nodes[right]
    | .node-catcher
        append(ASTCatchExpression(nodes.loc[left], left, false, store-child(right)))

────────────────────
_ do auto-join-catch-expression SyntaxId?
    - left SyntaxId
    - body SyntaxId
    - catchers RowRange'SyntaxId
    - right SyntaxId

. raw = match nodes[left]
    | .node-catch-expression(row)
        row.is-raw-result
    ?! Panic("Expected a catch expression syntax node")
if nodes[right] is .node-catcher
    . extended = store-children(children-appending(catchers, right))
    = append(ASTCatchExpression(nodes.loc[left], body, raw, extended))

=? null if is-error-transformer-declaration(body, catchers)
. joined = auto-join(body, right)
=? null if !joined
= append(ASTCatchExpression(nodes.loc[left], joined, raw, catchers))

────────────────────
_ is-error-transformer-declaration Bool
    - body SyntaxId
    - catchers RowRange'SyntaxId

|? !catchers.count
    false
??
    match nodes[body]
        | .node-assertion-syntax(assertion)
            !assertion.condition
        ??
            false

────────────────────
_ append-pipeline-feed SyntaxId
    - left SyntaxId
    - right SyntaxId

append(ASTFeedExpression(nodes.loc[left], left, right, true, false))

────────────────────
_ do set-pipeline-left SyntaxId
    - pipeline-id SyntaxId
    - left SyntaxId

` A pipeline takes the statement before it as its left side. When that statement was itself
` joined after the pipeline was written, the pipeline is written again after it.
match nodes[pipeline-id]
    | .node-pipeline-expression(pipeline)
        if left > pipeline-id
            = append(ASTPipelineExpression(pipeline.loc, pipeline.op, left, pipeline.right))
        pipeline.left = left
    ?! Panic("Expected a pipeline syntax node")

= pipeline-id

────────────────────
_ do append-feed-join SyntaxId
    - left SyntaxId
    - right SyntaxId

append-feed(left, right)
= left

────────────────────
_ do append-feed
    - head SyntaxId
    - addition SyntaxId

. current = head
while current
    match nodes[current]
        | .node-feed-expression(feed)
            if feed.next
                current = feed.next
            else
                feed.next = addition
                current = 0
        ?! Panic("Expected a feed syntax node")

────────────────────
+ auto-join-passes-over Bool
    - left SyntaxId
    - right SyntaxId

match nodes[left]
    | .node-header-expression
        is-lazy-declaration(right)
    ??
        false

────────────────────
_ is-lazy-declaration Bool
    - id SyntaxId

match nodes[id]
    | .node-declare(declaration)
        declaration.is-lazy
    ??
        false

────────────────────
_ is-joinable-header-item Bool
    - id SyntaxId

match nodes[id]
    | .node-function-syntax(function)
        true
    | .node-getter-syntax(function)
        function.names.count > 0
    | .node-setter-syntax(function)
        function.names.count > 0
    ??
        is-expression(id)

────────────────────
_ is-expression Bool
    - id SyntaxId

match nodes[id]
    | .node-noop
        false
    | .node-top-level-syntax
        false
    | .node-declare
        false
    | .node-assertion-syntax
        false
    | .node-class-block
        false
    | .node-event-declaration
        false
    | .node-effect-declaration
        false
    | .node-property-syntax
        false
    | .node-state-case
        false
    | .node-state-continuation
        false
    | .node-state-fallback
        false
    | .node-state-trigger
        false
    | .node-unit-declaration
        false
    | .node-enum-declaration
        false
    | .node-delegate-declaration
        false
    | .node-implements-declaration
        false
    | .node-using-declaration
        false
    | .node-sees-declaration
        false
    | .node-style-domain-item
        false
    | .node-style-annotation
        false
    | .node-dependency-declaration
        false
    | .node-content-block
        false
    | .node-fromverter-syntax
        false
    | .node-converter-syntax
        false
    | .node-subscriber-syntax
        false
    | .node-when-rule-syntax
        false
    | .node-rule-syntax
        false
    | .node-decoration
        false
    | .node-markup-head
        false
    | .node-markup-slot-parameter
        false
    | .node-style-rule-application
        false
    | .node-if-block
        false
    | .node-while-block
        false
    | .node-for-block
        false
    | .node-do-block
        false
    | .node-probe-statement
        false
    | .node-do-finally-block
        false
    | .node-do-task-block
        false
    | .node-use-block
        false
    | .node-stack-local-binding-block
        false
    | .node-loop-syntax
        false
    | .node-return
        false
    | .node-return-if-true
        false
    | .node-yield
        false
    | .node-break
        false
    | .node-continue
        false
    | .node-catcher
        false
    | .node-pattern-helper-syntax
        false
    | .node-argument
        false
    | .node-argument-decl
        false
    | .node-import-syntax
        false
    | .node-clause
        false
    | .node-stream-call-expression-argument
        false
    | .node-stream-collector-mapping
        false
    | .node-probe
        false
    | .node-probe-scope
        false
    | .node-probe-group
        false
    | .node-probe-assign
        false
    | .node-probe-counter
        false
    | .node-param-constraint
        false
    | .node-param-assignment
        false
    ??
        true

────────────────────
+ auto-join-close SyntaxId
    - node SyntaxId

match nodes[node]
    | .node-state-case(state)
        append(ASTStateMachine(state.loc, store-child(node)))
    ??
        node

━━━━━━━━━━━━━━━━━━━━
+ extend ASTBuilder

────────────────────
+ do make-argument SyntaxId
    - loc MatchLocation
    - expr SyntaxId
    - name Atom?
    - is-optional Bool = false

. expression = expr
if name
    if has-auto-closure-each(expr)
        expression = make-auto-closure(expr)
= append(ASTArgument(loc, expression, name, is-optional))

────────────────────
+ do make-pattern-helper SyntaxId
    - loc MatchLocation
    - helper SyntaxId

. expression = helper
if has-auto-closure-each(helper)
    expression = make-auto-closure(helper)
= append(ASTPatternHelper(loc, expression))

────────────────────
_ make-auto-closure SyntaxId
    - expr SyntaxId

append(auto-closure-data(loc, args, expr))
    .. loc = nodes.loc[expr]
    .. each = append(ASTIdentifier(loc, atom("each"), false))
    .. capture = append(ASTTypeCapture(loc, each, 0))
    .. argument = append(ASTArgumentDecl(loc, capture, 0, false))
    .. args = store-child(argument)

────────────────────
_ auto-closure-data ASTFunction
    - loc MatchLocation
    - args RowRange'SyntaxId
    - expr SyntaxId

ASTFunction
    - loc
    - .private-access
    - RowRange'Atom()
    - 0
    - args
    - RowRange'SyntaxId()
    - 0
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - expr
    - CompilationEffect.none
    - false
    - false
    - false
    - false
    - false

────────────────────
_ has-auto-closure-each Bool
    - id SyntaxId

|? !id
    false
??
    match nodes[id]
        | .node-block(row)
            children-have-auto-closure-each(row.body)
        | .node-identifier(row)
            row.name.text == "each"
        | .node-print(row)
            has-auto-closure-each(row.body)
        | .node-use-expression(row)
            has-auto-closure-each(row.expr)
        | .node-latest-expression(row)
            has-auto-closure-each(row.expr)
        | .node-header-expression(row)
            has-auto-closure-each(row.expr)
        | .node-pipeline-expression(row)
            !binds-each(row.op) && has-each
            .. has-each = has-auto-closure-each(row.left) || has-auto-closure-each(row.right)
        | .node-feed-expression(row)
            has-auto-closure-each(row.item)
        | .node-unary-expression(row)
            has-auto-closure-each(row.operand)
        | .node-binary-expression(row)
            !binds-each(row.op) && has-each
            .. has-each = has-auto-closure-each(row.lhs) || has-auto-closure-each(row.rhs)
        | .node-cast-expression(row)
            has-auto-closure-each(row.lhs) || has-auto-closure-each(row.rhs)
        | .node-call-expression(row)
            has-callable || has-params || has-args
            .. has-callable = has-auto-closure-each(row.callable)
            .. has-params = children-have-auto-closure-each(row.params)
            .. has-args = children-have-auto-closure-each(row.args)
        | .node-range-expression(row)
            has-left || has-right || has-increment
            .. has-left = has-auto-closure-each(row.left)
            .. has-right = has-auto-closure-each(row.right)
            .. has-increment = has-auto-closure-each(row.increment)
        | .node-get-expression(row)
            has-auto-closure-each(row.object)
        | .node-style-read-expression(row)
            has-auto-closure-each(row.object)
        | .node-markup-read-expression(row)
            has-auto-closure-each(row.object)
        | .node-index-expression(row)
            has-auto-closure-each(row.object) || has-auto-closure-each(row.index)
        | .node-match-expression(row)
            has-auto-closure-each(row.subject) || has-auto-closure-each(row.body)
        | .node-catch-optional-expression(row)
            has-auto-closure-each(row.body)
        | .node-catch-expression(row)
            has-auto-closure-each(row.body) || children-have-auto-closure-each(row.catchers)
        | .node-tuple-syntax(row)
            children-have-auto-closure-each(row.items)
        | .node-list-syntax(row)
            children-have-auto-closure-each(row.items)
        | .node-iterable-expression(row)
            has-auto-closure-each(row.expr)
        | .node-optional-chain(row)
            has-auto-closure-each(row.expr)
        | .node-argument(row)
            has-auto-closure-each(row.expr)
        | .node-assign(row)
            has-auto-closure-each(row.lhs) || has-auto-closure-each(row.rhs)
        ??
            false

────────────────────
_ do children-have-auto-closure-each Bool
    - range RowRange'SyntaxId

for offset in 0 .. < range.count
    if has-auto-closure-each(children[range.start + offset])
        = true
= false

────────────────────
_ binds-each Bool
    - op Operator

match op
    | .map-op
        true
    | .filter-op
        true
    | .map-filter-op
        true
    | .pipe-repeat-op
        true
    | .pipe-closure-op
        true
    ??
        false

────────────────────
+ do name-closures

. closure-count U32
for node in nodes[1 .. < nodes.length]
    match node
        | .node-function-syntax(function)
            if !function.names.count
                closure-count += 1
                . name = "(closure)"
                if closure-count > 1
                    name = "(closure${closure-count})"
                . start = atoms.length
                atoms.append(atom(name))
                function.names = RowRange'Atom(start as U32, 1)
        ??
            continue

────────────────────
+ do finalize-syntax ?! YumiSyntaxError

. end = nodes.length
for node in nodes[1 .. < end]
    match node
        | .node-state-case(row)
            row.body = normalized-state-body(row.body)
            validate-state-fallbacks(row.body)
        | .node-state-continuation(row)
            row.body = normalized-state-body(row.body)
            validate-state-fallbacks(row.body)
        | .node-state-machine(row)
            validate-state-fallbacks(row.body)
        | .node-slot-outlet(row)
            . loc = exclusive-end-location(row.loc)
            ?! YumiSyntaxError(loc, "Slot type inference is not supported yet", source, source-path)
                if slot-type-declares-params(row.type-id)
            ?! YumiSyntaxError(loc, "Slot parameter requires a named slot", source, source-path)
                if row.slot-parameter && !row.name
        ??
            continue

────────────────────
_ do normalized-state-body RowRange'SyntaxId
    - body RowRange'SyntaxId

. builder = ArrayBuilder'SyntaxId()
for offset in 0 .. < body.count
    . item = children[body.start + offset]
    . flattened = match nodes[item]
        | .node-state-machine(machine)
            do 
                for child-offset in 0 .. < machine.body.count
                    builder.append(children[machine.body.start + child-offset])
            true
        ??
            do
                builder.append(item)
            false
= store-children(builder.finish-immutable())

────────────────────
_ do validate-state-fallbacks ?! YumiSyntaxError
    - body RowRange'SyntaxId

. found = false
for item in nodes[child-ids(body)]
    match? item
        | .node-state-fallback(row)
            . loc = exclusive-end-location(row.loc)
            . message = "Multiple fallbacks in one state transition group"
            ?! YumiSyntaxError(loc, message, source, source-path)
                if found
            found = true

────────────────────
_ do slot-type-declares-params Bool
    - id SyntaxId

match nodes[id]
    | .node-type-identifier(row)
        = row.is-declare
    | .node-type-arguments(row)
        =? true if slot-type-declares-params(row.base)
        
        for offset in 0 .. < row.args.count
            . arg = children[row.args.start + offset]
            =? true if slot-type-declares-params(arg)
        = false
    ??
        = false
