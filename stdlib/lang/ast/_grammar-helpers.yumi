+ character-literal-string String ?! YumiSyntaxError
    - loc MatchLocation
    - char Char

?! YumiSyntaxError(loc, "Character literal must contain a valid Unicode scalar")
    if value >= 55296 && value <= 57343
"$value"

.. value = char as U32

━━━━━━━━━━━━━━━━━━━━
+ negative-number-string String?
    - tree ASTBuilder
    - operators ImmutableArray'Operator
    - syntax SyntaxId

match? tree.nodes[syntax]
    | .node-integer-syntax(number)
        negated-number-text(number.value, count) if count
    | .node-float-syntax(number)
        negated-number-text(number.value, count) if count

.. count = trailing-negative-count(operators)

━━━━━━━━━━━━━━━━━━━━
+ negated-number-text String
    - text String
    - count Size

` The text of a number under `count` minus signs. A number that already has one loses it to
` the next, so an even count leaves a number with no sign.
if total % 2 == 1 then "-" ++ digits else digits

.. signed = text.length != 0 && text[0] == '-'
.. digits = if signed then text[1 .. < text.length] else text
.. total = if signed then count + 1 else count

━━━━━━━━━━━━━━━━━━━━
+ do escaped-text String
    - tree ASTBuilder
    - chars ImmutableArray'Char

` The text of the characters a literal writes with escapes. A copy an arena makes of
` characters stops at a NUL, so text that holds one is made whole first and copied after.
for char in chars
    if char == 0 as Char
        = tree.store-string(chars.slice-string())
= chars.slice-string(tree.text-arena)

━━━━━━━━━━━━━━━━━━━━
+ do concat-string-parts SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - parts ImmutableArray'SyntaxId

. has-expression = false
. has-text = false
for part in parts
    match tree.nodes[part]
        | .node-string-syntax(row)
            has-text = has-text || row.text.length > 0
        ??
            has-expression = true
. result SyntaxId?
if has-expression && !has-text
    result = tree.append(ASTString(loc, tree.store-string("")))
for part in parts
    if is-empty-string(tree, part)
        continue
    . piece = relocated-string(tree, loc, part)
    match result
        | previous SyntaxId
            result = tree.append(ASTBinaryExpression(loc, .concat-string-op, previous, piece))
        ??
            result = piece
= result ?? tree.append(ASTString(loc, tree.store-string("")))

━━━━━━━━━━━━━━━━━━━━
_ do is-empty-string Bool
    - tree ASTBuilder
    - part SyntaxId

` A piece of text with no characters, which a line continuation alone leaves.
match? tree.nodes[part]
    | .node-string-syntax(row)
        = row.text.length == 0
= false

