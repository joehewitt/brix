            - row.loop
            - row.body
            - row.next
            - 0
            - RowRange'SyntaxId()
            - RowRange'SyntaxId()
    | .node-loop-syntax(row)
        AnonymousCaseTraversal
            - row.pattern
            - row.container
            - row.clause
            - row.next
            - RowRange'SyntaxId()
            - RowRange'SyntaxId()
    | .node-unary-expression(row)
        AnonymousCaseTraversal(row.operand, 0, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-binary-expression(row)
        AnonymousCaseTraversal(row.lhs, row.rhs, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-call-expression(row)
        AnonymousCaseTraversal(row.callable, 0, 0, 0, row.params, row.args)
    | .node-get-expression(row)
        AnonymousCaseTraversal(row.object, 0, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-tuple-syntax(row)
        AnonymousCaseTraversal(0, 0, 0, 0, row.items, RowRange'SyntaxId())
    | .node-list-syntax(row)
        AnonymousCaseTraversal(0, 0, 0, 0, row.items, RowRange'SyntaxId())
