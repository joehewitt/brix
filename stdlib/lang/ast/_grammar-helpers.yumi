            - row.pattern
            - row.expr
            - 0
            - 0
            - RowRange'SyntaxId()
            - RowRange'SyntaxId()
    | .node-type-and(row)
        AnonymousCaseTraversal(row.left, row.right, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-type-or(row)
        AnonymousCaseTraversal(row.left, row.right, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-type-panic(row)
        AnonymousCaseTraversal(row.pattern, 0, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-stream-transform(row)
        AnonymousCaseTraversal
            - row.pattern
            - row.right
            - 0
            - 0
            - RowRange'SyntaxId()
            - RowRange'SyntaxId()
    | .node-stream-and(row)
        AnonymousCaseTraversal(row.left, row.right, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-stream-or(row)
        AnonymousCaseTraversal(row.left, row.right, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-stream-panic(row)
        AnonymousCaseTraversal(row.pattern, 0, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId())
    | .node-iterator-expression(row)
