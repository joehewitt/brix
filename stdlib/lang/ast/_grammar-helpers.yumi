━━━━━━━━━━━━━━━━━━━━
+ do link-statements ImmutableArray'SyntaxId ?! YumiSyntaxError
    - tree ASTBuilder
    - statements ImmutableArray'SyntaxId
    - allow-function-declarations = true

. items = Array'SyntaxId'ArenaBacking(tree.pattern-collector-context, statements.length)
. size Size = 0
. previous SyntaxId?
. passed SyntaxId?
for node in statements
    if !allow-function-declarations
        match? tree.nodes[node]
            | .node-function-syntax(row) { row.names.count > 0 }
                . begin = TokenLocation(row.loc.begin.line - 1, row.loc.begin.column)
                . end = TokenLocation(begin.line, begin.column + 1)
                ?! YumiSyntaxError(MatchLocation(begin, end), "$nesting $correction")
    . is-held = false
    if passed
        . rejoined = tree.auto-join(passed, node)
        if rejoined
            passed = rejoined
            is-held = true
        else
            items[size] = tree.auto-join-close(passed)
            size += 1
            passed = null
    if !is-held
        if previous
            if tree.auto-join-passes-over(previous, node)
                passed = node
                is-held = true
    if !is-held
        . next-previous SyntaxId?
        if previous
            . joined = tree.auto-join(previous, node)
            if joined
                next-previous = joined
            else
                items[size] = tree.auto-join-close(previous)
                size += 1
                next-previous = node
        else
            next-previous = node
        previous = next-previous

if passed
    items[size] = tree.auto-join-close(passed)
    size += 1
if previous
    items[size] = tree.auto-join-close(previous)
    size += 1

= Array'SyntaxId(items.data, size).immutable

.. nesting = "A thin-divider function cannot be declared inside another function."
.. correction = "Use a thick divider (━) for a module-level function."

