+ do make-pattern-tuple SyntaxId
    - tree ASTBuilder
    - loc
    - patterns ImmutableArray'SyntaxId

for pattern in patterns
    if tree.is-type-remainder(pattern)
        ?! YumiSyntaxError(exclusive-end-location(tree.location(pattern)), "Remainder pattern is only valid inside sequence, map, or text patterns")

= match patterns
    | [pattern]
        pattern
    ??
        tree.append(ASTTypeTuple(loc, tree.store-children(patterns)))

