━━━━━━━━━━━━━━━━━━━━
+ do hex-integer-value String
    - digits String

` The value of hexadecimal digits in decimal, however many digits there are.
. places [U32]
places += 0
for char in digits
    . digit = 0u32
    if char >= '0' && char <= '9'
        digit = char - '0'
    else if char >= 'a' && char <= 'f'
        digit = ((char - 'a') as U32) + 10
    else if char >= 'A' && char <= 'F'
        digit = ((char - 'A') as U32) + 10
    . carry = digit
    for place in 0 .. < places.length
        . scaled = places[place] * 16 + carry
        places[place] = scaled % 10
        carry = scaled / 10
    while carry != 0
        places += carry % 10
        carry = carry / 10
. shown = ""
for offset in 0 .. < places.length
    shown += "${places[places.length - 1 - offset]}"
= shown

━━━━━━━━━━━━━━━━━━━━
+ hex-integer-unit Atom
    - tree ASTBuilder
    - digits String

|? digits.length <= 2
    tree.atom("u8")
|? digits.length <= 4
    tree.atom("u16")
|? digits.length <= 8
    tree.atom("u32")
??
    tree.atom("u64")

