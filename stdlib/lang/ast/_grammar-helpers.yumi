━━━━━━━━━━━━━━━━━━━━
+ do detached-piece YumiPiece
    - piece YumiPiece

=? YumiPiece(piece.location, detached(piece.items)) if !piece.header
. header = piece.header
. aliases = detached(header.aliases) if header.aliases
. inherits = detached(header.inherits) if header.inherits
. variants = detached(header.header) if header.header
. detached-header = ClassHeader
    - header.location
    - header.access
    - header.name
    - detached(header.type-args)
    - aliases
    - inherits
    - variants
    - header.facet-of
= YumiPiece(piece.location, detached(piece.items), detached-header)

