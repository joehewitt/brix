reduce(seed, stream) • using :: accum, pair =>
    user-binary-op(tree, loc, pair[0], accum, pair[1])

━━━━━━━━━━━━━━━━━━━━
+ user-binary-op SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - op SyntaxId
    - left SyntaxId
    - right SyntaxId

match tree.identifier-name(op).text
    |= "and"
        tree.append(ASTBinaryExpression(loc, .bitwise-and-op, left, right))
    |= "or"
        tree.append(ASTBinaryExpression(loc, .bitwise-or-op, left, right))
    |= "xor"
        tree.append(ASTBinaryExpression(loc, .bitwise-xor-op, left, right))
    |= "lshift"
        tree.append(ASTBinaryExpression(loc, .bitwise-lshift-op, left, right))
    |= "rshift"
        tree.append(ASTBinaryExpression(loc, .bitwise-rshift-op, left, right))
    |= "zrshift"
        tree.append(ASTBinaryExpression(loc, .bitwise-zrshift-op, left, right))
    |= "not"
        tree.append(ASTUnaryExpression(loc, .bitwise-not-op, right))
    ??
        tree.append
            - ASTCallExpression
                - loc
                - op
                - tree.store-child
                    - tree.make-argument(tree.location(left), left, null, false)
                    - tree.make-argument(tree.location(right), right, null, false)
                - 0
                - false

