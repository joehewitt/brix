. names = tail ?? ImmutableArray'Atom()
. place = head
for name in names
    place = optional-get(tree, place, name, false, false, false)
= relocated-get(tree, loc, place)

━━━━━━━━━━━━━━━━━━━━
+ do track-place
    - tree ASTBuilder
    - place SyntaxId

match? tree.nodes[place]
    | .node-identifier(row)
        tree.nodes[place] = ASTIdentifier(tree.location(place), row.name, true)
    | .node-get-expression(row)
        tree.nodes[place] = ASTGetExpression(tree.location(place), row.object, row.name, true, row.is-optional, row.is-loop)

━━━━━━━━━━━━━━━━━━━━
+ do make-iterator-line SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - container SyntaxId
    - is-subscriber Bool
    - body SyntaxId?
    - binding SyntaxId?
    - clauses SyntaxId?
    - next-loop SyntaxId?
    - next-iterator SyntaxId?

. normalized-body SyntaxId = 0
if body
    normalized-body = match tree.nodes[body]
        | .node-block(block) { block.body.count == 1 }
            tree.children[block.body.start]
        ??
            body
. normalized-binding = if binding then binding else 0
if normalized-body
    normalized-binding, normalized-body = match tree.nodes[normalized-body]
        | .node-binary-expression(binary) { !normalized-binding && binary.op == .map-op }
            match tree.nodes[binary.rhs]
                | .node-identifier
                    (tree.append(ASTTypeCapture(tree.location(binary.rhs), binary.rhs, 0)), binary.lhs)
                ??
                    (normalized-binding, normalized-body)
        | .node-structure-match
            (normalized-body, 0)
        | .node-stream-match(stream-match)
            (stream-match.pattern, 0)
        ??
            (normalized-binding, normalized-body)

. final-body = if normalized-body then normalized-body else default-body
.. default-body = tree.append(ASTIdentifier(loc, tree.atom("each"), false))
. loop = tree.append
    - ASTLoop
        - loc
        - normalized-binding
        - container
        - tree.syntax-or-invalid(clauses)
        - is-subscriber
        - true
        - tree.syntax-or-invalid(next-loop)
= tree.append(ASTIteratorExpression(loc, loop, final-body, tree.syntax-or-invalid(next-iterator)))

