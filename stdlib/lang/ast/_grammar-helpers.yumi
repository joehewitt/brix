+ unescape
    - c

match c
    |= "t"
        "\t"
    |= "n"
        "\n"
    |= "r"
        "\r"
    |= "b"
        "\b"
    |= "f"
        "\f"
    |= "v"
        "\v"
    |= "/"
        "/"
    |= "\\"
        "\\"
    |= "$"
        "$"
    |= "\""
        "\""
    |= "'"
        "'"
    ??
        ""

