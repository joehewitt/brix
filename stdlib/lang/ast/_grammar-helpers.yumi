match? tree.nodes[expr]
    | .node-get-expression
        tree.nodes.loc[expr] = loc
= expr

━━━━━━━━━━━━━━━━━━━━
+ do relocated-string SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - part SyntaxId

match? tree.nodes[part]
    | .node-string-syntax(row)
        = tree.append(ASTString(loc, row.text))
= part

━━━━━━━━━━━━━━━━━━━━
+ do make-block-string SyntaxId
    - tree ASTBuilder
    - loc MatchLocation
    - parts ImmutableArray'BlockStringComponent

. end = parts.length
. final-text String?
while end
    match parts[end - 1]
        | .literal(text)
            . trimmed = trim-block-string-end(text)
            if trimmed.length
                final-text = trimmed
                break
            end -= 1
        ??
            break

. has-expression = false
. has-text = false
for index in 0 .. < end
    match parts[index]
        | .syntax
            has-expression = true
        | .literal(text)
            has-text = has-text || text.length > 0

. result SyntaxId?
if has-expression && !has-text
    result = tree.append(ASTString(loc, tree.store-string("")))

for index in 0 .. < end
    . node = match parts[index]
        | .syntax(id)
            id
        | .literal(value)
            tree.append(ASTString(loc, tree.store-string(text))) if text.length
                .. text = if final-text && index == end - 1 then final-text else value
    if node
        match result
            | previous SyntaxId
                result = tree.append(ASTBinaryExpression(loc, .concat-string-op, previous, node))
            ??
                result = node

= result ?? tree.append(ASTString(loc, tree.store-string("")))

━━━━━━━━━━━━━━━━━━━━
+ do trim-block-string-end String
    - text String

. end = text.length
while end && is-block-string-end-whitespace(text[end - 1])
    end -= 1
= text[0 .. < end]

━━━━━━━━━━━━━━━━━━━━
+ is-block-string-end-whitespace Bool
    - char Char

match char as U32
    |= 9u32
        true
    |= 10u32
        true
    |= 11u32
        true
    |= 12u32
        true
    |= 13u32
        true
    |= 32u32
        true
    |= 160u32
        true
    |= 5760u32
        true
    |? it >= 8192 && it <= 8202
        true
    |= 8232u32
        true
    |= 8233u32
        true
    |= 8239u32
        true
    |= 8287u32
        true
    |= 12288u32
        true
    |= 65279u32
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ do strip-numeric-separators String
    - text String

. has-separators = false
for c in text
    if (c as U32) == 39
        has-separators = true
        break

=? text if !has-separators

. stripped = ""
for c in text
    if (c as U32) != 39
        stripped += c

= stripped

━━━━━━━━━━━━━━━━━━━━
+ do auto-call SyntaxId ?! YumiSyntaxError
    - tree ASTBuilder
    - location
    - expr
    - params
    - args
    - is-curried

=? expr if !args || !args.length

refuse-repeated-labels(tree, args)
. result = match tree.nodes[expr]
    | .node-call-expression(call)
        . callable = call.callable
        . curried = call.is-curried
        . existing-params = call.params
        . existing-args = call.args
        . merged-params = store-auto-call-children(tree, existing-params, params)
        . merged-args = store-auto-call-args(tree, existing-args, args)
        . operands = tree.call-operands(merged-params, merged-args)
        . merged-call = ASTCallExpression
            - location
            - callable
            - operands
            - merged-params.count as U8
            - curried
        tree.append(merged-call)
    ??
        . stored-params = tree.store-optional-children(params)
        . stored-args = store-auto-call-args(tree, RowRange'SyntaxId(), args)
        . created = expr
        if stored-params.count || stored-args.count
            . operands = tree.call-operands(stored-params, stored-args)
            . param-count = stored-params.count
            . call = ASTCallExpression(location, expr, operands, param-count as U8, is-curried)
            created = tree.append(call)
        else
            tree.nodes.loc[expr] = location
        created

. outer-block = auto-call-outer-block(tree, params, args)
if outer-block
    result = auto-call-outer-block-expression(tree, location, result, outer-block)

. catchers = store-auto-call-catchers(tree, args)
for offset in 0 .. < catchers.count
    . catcher = tree.children[catchers.start + offset]
    . joined = tree.auto-join(result, catcher)
    if !joined
        ?! Panic("Call catch handler did not join")
    result = joined
= result

━━━━━━━━━━━━━━━━━━━━
+ do refuse-repeated-labels ?! YumiSyntaxError
    - tree ASTBuilder
    - args ImmutableArray'SyntaxId

for offset in 0 .. < args.length
    . arg = args[offset]
    match? tree.nodes[arg]
        | .node-argument(later)
            . name = later.name
            if name
                for earlier-offset in 0 .. < offset
                    match? tree.nodes[args[earlier-offset]]
                        | .node-argument(earlier)
                            if earlier.name == name
                                reject-syntax(tree, tree.nodes.loc[arg], "\"${name.text}\" is given twice in one call; the bullets on a line all belong to one call, so give a nested call its bullets inside parentheses, as in \"• where (some(each.kids) • where each > 2)\"")

━━━━━━━━━━━━━━━━━━━━
+ do auto-call-outer-block SyntaxId
    - tree ASTBuilder
    - params
    - args ImmutableArray'SyntaxId

=? 0 if params && params.length

. result SyntaxId = 0
for arg in args
    . node = tree.nodes[arg]
    if node is .node-block
        . block = match node
            | .node-block(value)
                value
            ??
                ASTBlock(MatchLocation(), RowRange'SyntaxId())
        . has-outer-statements = auto-call-block-has-outer-statements(tree, block.body)
        if has-outer-statements && !auto-call-block-has-body(tree, block.body)
            result = arg
= result

━━━━━━━━━━━━━━━━━━━━
+ do auto-call-block-has-outer-statements Bool
    - tree ASTBuilder
    - body RowRange'SyntaxId

for child in tree.nodes[tree.child-ids(body)]
    match? child
        | .node-declare(declaration)
            =? true if declaration.is-lazy
        | .node-assertion-syntax
            = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do auto-call-block-has-body Bool
    - tree ASTBuilder
    - body RowRange'SyntaxId

for child in tree.nodes[tree.child-ids(body)]
    match child
        | .node-declare(declaration)
            =? true if !declaration.is-lazy
        | .node-list-syntax
            continue
        | .node-argument
            continue
        | .node-assertion-syntax
            continue
        | .node-catcher
            continue
        ??
            = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do store-auto-call-args RowRange'SyntaxId
    - tree ASTBuilder
    - existing RowRange'SyntaxId
    - args ImmutableArray'SyntaxId

. start = tree.children.length
for offset in 0 .. < existing.count
    append-auto-call-child(tree, tree.children[existing.start + offset])

for arg in args
    if tree.nodes[arg] is .node-block
        . block = match tree.nodes[arg]
            | .node-block(value)
                value
            ??
                ASTBlock(MatchLocation(), RowRange'SyntaxId())
        for offset in 0 .. < block.body.count
            . child = tree.children[block.body.start + offset]
            if tree.nodes[child] is .node-list-syntax
                . list = match tree.nodes[child]
                    | .node-list-syntax(value)
                        value
                    ??
                        ASTList(MatchLocation(), RowRange'SyntaxId())
                for item-offset in 0 .. < list.items.count
                    . item = tree.children[list.items.start + item-offset]
                    . argument = tree.make-argument(tree.location(item), item, null, false)
                    append-auto-call-child(tree, argument)
            else if tree.nodes[child] is .node-argument
                append-auto-call-child(tree, child)
        if auto-call-block-has-body(tree, block.body)
            . argument = tree.make-argument(tree.location(arg), arg, null, false)
            append-auto-call-child(tree, argument)
    else if tree.nodes[arg] is .node-argument
        append-auto-call-child(tree, arg)
    else
        . argument = tree.make-argument(tree.location(arg), arg, null, false)
        append-auto-call-child(tree, argument)

=? RowRange'SyntaxId() if tree.children.length == start
= RowRange'SyntaxId(start as U32, (tree.children.length - start) as U32)

━━━━━━━━━━━━━━━━━━━━
+ do auto-call-outer-block-expression SyntaxId
    - tree ASTBuilder
    - location MatchLocation
    - expression SyntaxId
    - block-id SyntaxId

. block = match tree.nodes[block-id]
    | .node-block(value)
        value
    ??
        ASTBlock(MatchLocation(), RowRange'SyntaxId())

. start = tree.children.length
for offset in 0 .. < block.body.count
    . child = tree.children[block.body.start + offset]
    if tree.nodes[child] is .node-declare
        . declaration = match tree.nodes[child]
            | .node-declare(value)
                value
            ??
