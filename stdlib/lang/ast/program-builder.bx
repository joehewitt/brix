(import ./ast)
(import ./ast-children)
(import ./ast-nodes)
(import ./decl)
(import ./effects)
(import ./facets)
(import ./module)
(import ./module-builder)
(import ./module-resolver)
(import ./program)
(import ./slot-hosts)
(import ./syntax-program)
(import /core/arena)
(import /core/array-builder)
(import /core/atom-pool)
(import /core/list)
(import /core/map)
(import /lang/constants)
(import /lang/target)

(type + ProgramBuilder
  (implements (of Usable Void))
  (prop + shares-atoms Bool)
  (prop _ atoms AtomPool)
  (prop _ atom-lock _ (= (call Mutex)))
  (prop _ program-arena Arena)
  (prop _ module-arena Arena)
  (prop _ scratch Arena)
  (prop _ modules (of ArrayBuilder Module ArenaBacking))
  (prop _ edge-froms (of List U32 ArenaBacking))
  (prop _ edge-tos (of List U32 ArenaBacking))
  (prop _ edge-exports (of List Bool ArenaBacking))
  (prop _ edge-builtins (of List Bool ArenaBacking))
  (prop _ edge-follows (of List Bool ArenaBacking))
  (prop _ pair-names (of List U32 ArenaBacking))
  (prop _ pair-modules (of List U32 ArenaBacking))
  (prop _ pair-decls (of List U32 ArenaBacking))
  (prop _ name-ids (of Map Atom U32 ArenaBacking))
  (prop _ name-count Size)
  (prop _ borrows Bool)
  (prop _ families (list U32))
  (prop _ finished Bool)
  (prop _ scratch-released Bool)
  (prop _ released Bool)
  (fn-do + This _
    (param atoms AtomPool)
    (lazy modules (call (of ArrayBuilder Module) module-arena))
    (lazy edge-froms (call (of List U32) scratch))
    (lazy edge-tos (call (of List U32) scratch))
    (lazy edge-exports (call (of List Bool) scratch))
    (lazy edge-builtins (call (of List Bool) scratch))
    (lazy edge-follows (call (of List Bool) scratch))
    (lazy pair-names (call (of List U32) scratch))
    (lazy pair-modules (call (of List U32) scratch))
    (lazy pair-decls (call (of List U32) scratch))
  )
  (fn-do + build Program
    (param syntax SyntaxProgram)
    (throw (call Panic "ProgramBuilder is stale or already finished") (if (or released finished)))
    (blank)
    (use this)
    (let shared (. syntax atom-lock))
    (if shared
      (= atom-lock shared)
    )
    (let hosts (call SlotHosts))
    (= (. hosts builtin-paths) (. syntax builtin-paths))
    (for (in parsed-module (. syntax modules))
      (call (. hosts scan) (. parsed-module tree) (. parsed-module path))
    )
    (for (in edge (. syntax edges))
      (call (. hosts add-import) (. edge from) (. edge to) (. edge is-export))
    )
    (call (. hosts settle))
    (let view (. syntax view))
    (= borrows (!= view null))
    (let jobs (list ModuleJob))
    (let reused (list (? Module)))
    (finally
      (for (in job jobs)
        (call (. job release))
      )
    )
    (for (in parsed-module (. syntax modules))
      (let tree (call (. parsed-module take-tree)))
      (let names (call (. hosts names-for) (. parsed-module path)))
      (let held
        (scope (only-if (call (. view built) (. parsed-module path) (. parsed-module name) relative-path names) (if view))
          (lazy relative-path (. parsed-module relative-path))
        )
      )
      (+= reused held)
      (if (not held)
        (let builder
          (call ModuleBuilder
            (block
              (arg (. parsed-module path))
              (arg (. parsed-module relative-path))
              (arg (. parsed-module name))
              (arg (. tree source))
            )
          )
        )
        (= (. builder default-hosts) names)
        (+= jobs (call ModuleJob builder tree))
      )
    )
    (call finish-modules jobs)
    (let module-ids (map String Index))
    (let next-job Size 0)
    (for (in held reused)
      (if held
        (= ([] module-ids (. held path)) (call add-module held))
        (else
          (let job ([] jobs next-job))
          (+= next-job 1)
          (if view
            (throw (call Panic "A module the program shares is not in its cache") (if (not (call (. view keep-module) (. job builder path) (!! (. job module)) consulted default-hosts))))
            (lazy consulted (. job builder consulted))
            (lazy default-hosts (. job builder default-hosts))
          )
          (= ([] module-ids (. job builder path)) (call add-module (!! (. job module))))
          (= (. job transferred) true)
        )
      )
    )
    (call note-families (. syntax resolver) module-ids)
    (blank)
    (return (call link (. syntax builtin-paths) (. syntax edges) (. syntax source-path) module-ids (. syntax root-paths)))
  )
  (fn-do _ finish-modules _
    (param jobs (list ModuleJob))
    (let pool (call Worker default-worker-count))
    (finally
      (call (. pool stop))
    )
    (let group (call TaskGroup))
    (for (in job jobs)
      (let task
        (do-new (worker: pool)
          (call (. job finish) atoms atom-lock)
          (on-failure failed
            (call (. group keep) failed)
          )
        )
      )
      (call (. group add) task)
    )
    (call (. group wait))
  )
  (fn-do _ note-families _
    (param resolver ModuleResolver)
    (param module-ids (map String Index))
    ; The file family of each module, as the module of its family's base, or a number past the
    ; modules for a base the program does not load. A module of no family is its own.
    (let unloaded (map String U32))
    (for (in index (..< 0 (. modules length)))
      (let base (call (. resolver family-base) (. ([] modules index) path)))
      (let loaded (only-if ([] module-ids base) (if base)))
      (if (not base)
        (+= families (as index U32))
        (else-if loaded
          (+= families (as loaded U32))
        )
        (else
          (let next (as (+ (. modules length) (. unloaded length)) U32))
          (let family (?? ([] unloaded base) next))
          (= ([] unloaded base) family)
          (+= families family)
        )
      )
    )
  )
  (fn-expr _ is-family-base Bool
    (param module U32)
    (param base U32)
    ; Whether a module belongs to the file family whose base is another, as `box.scroll.yumi` does
    ; to that of `box.yumi`, or is that module.
    (or (== module base) (and (< module (. families length)) (== ([] families module) base)))
  )
  (fn-do _ link Program
    (param builtin-paths (list String))
    (param edges (list ImportEdge))
    (param entry-path String)
    (param module-ids (map String Index))
    (param root-paths (list String) (= (list)))
    (for (in module-index (..< 0 (. modules length)))
      (for (in builtin-path builtin-paths)
        (let builtin-id ([] module-ids builtin-path))
        (if builtin-id
          (if (!= builtin-id module-index)
            (call add-import module-index builtin-id false true)
          )
        )
      )
    )
    (blank)
    (for (in edge edges)
      (let from-id ([] module-ids (. edge from)))
      (let to-id ([] module-ids (. edge to)))
      (if (and from-id to-id)
        (call add-import from-id to-id (. edge is-export) false (. edge follows))
      )
    )
    (blank)
    (let roots (list U32))
    (for (in root-path root-paths)
      (let root ([] module-ids root-path))
      (throw (call Panic "Batch root module was not linked") (if (not root)))
      (+= roots (as root U32))
    )
    (let entry ([] module-ids entry-path))
    (if roots
      (= entry (as ([] roots 0) Index))
    )
    (throw (call Panic "Entry module was not linked") (if (not entry)))
    (return (call finish (as entry ModuleId) roots))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (if (not released)
      (if (not finished)
        (if (not borrows)
          (for (in module modules)
            (call (. module release))
          )
          (if (not shares-atoms)
            (call (. atoms release))
          )
        )
        (call (. program-arena release))
        (call (. module-arena release))
      )
      (if (not scratch-released)
        (call (. scratch release))
        (= scratch-released true)
      )
      (= released true)
    )
  )
  (fn-do _ finish Program
    (param entry-module ModuleId)
    (param roots (list U32) (= (list)))
    (throw (call Panic "ProgramBuilder is stale or already finished") (if (or released finished)))
    (blank)
    (= name-ids (call (of Map Atom U32) program-arena))
    (let ranks (call build-ranks program-arena true))
    (let listings (call build-listing program-arena))
    (let outgoing (call module-edges))
    (let init-order (call build-module-order entry-module roots false outgoing))
    (let declare-order (call build-module-order entry-module roots true outgoing))
    (let batch (call build-batch-orders roots outgoing))
    (let feature-gates (call build-feature-gates))
    (let index (call build-name-index program-arena))
    (let facets (call build-facet-table index ranks))
    (let extensions (call build-extension-index program-arena index ranks facets))
    (let parsed (call gather-atoms))
    (let atom-ordinals (call build-atom-ordinals program-arena parsed))
    (let parse-atoms (call build-parse-atoms program-arena parsed))
    (call (. scratch release))
    (= scratch-released true)
    (blank)
    (let path-ids (call (of Map Atom U32) program-arena))
    (let module-names (call (of Map Atom U32) program-arena))
    (call store-names path-ids module-names)
    (blank)
    (let program
      (call Program
        (block
          (arg atoms)
          (arg program-arena)
          (arg module-arena)
          (arg (call (. modules finish-immutable)))
          (arg entry-module)
          (arg init-order)
          (arg declare-order)
          (arg name-ids)
          (arg path-ids)
          (arg module-names)
          (arg (. index bucket-starts))
          (arg (. index entry-modules))
          (arg (. index entry-decls))
          (arg ranks)
          (arg ranks)
          (arg (. extensions key-modules))
          (arg (. extensions key-decls))
          (arg (. extensions starts))
          (arg (. extensions entry-modules))
          (arg (. extensions entry-decls))
          (arg (. listings first))
          (arg (. listings last))
          (arg parse-atoms)
          (arg atom-ordinals)
          (arg (. batch roots))
          (arg (. batch starts))
          (arg (. batch modules))
          (arg (. batch cases))
          (arg (. feature-gates starts))
          (arg (. feature-gates gates))
          (arg borrows)
          (arg shares-atoms)
          (arg atom-lock)
        )
      )
    )
    (= (. program facets) facets)
    (= (. program families) families)
    (= (. program effects) (call build-effect-table program))
    (= finished true)
    (return program)
  )
  (fn-do _ build-effect-table EffectTable
    (param program Program)
    ; The effects of the program, with the C functions each claims, and the bans and the door of each
    ; function that writes them, read where it is declared.
    (let table (call EffectTable))
    (for (in position (..< 0 (. program modules length)))
      (let tree (. ([] (. program modules) position) tree))
      (let decl 0u32)
      (for (in row (. ([] (. program modules) position) decls))
        (match? row
          (case (call .decl-effect effect)
            (let index (as (. table modules length) U32))
            (+= (. table modules) (as position U32))
            (+= (. table decls) decl)
            (+= (. table names) (. effect name))
            (for (in offset (..< 0 (. effect claims count)))
              (let claim ([] (. tree atoms) (+ (. effect claims start) offset)))
              (if (== ([] (. table claims) claim) null)
                (= ([] (. table claims) claim) index)
                (else
                  (= ([] (. table contested) claim) index)
                )
              )
            )
          )
        )
        (+= decl 1)
      )
    )
    (return-if table (if (== (. table count) 0)))
    (= (. program effects) table)
    (for (in position (..< 0 (. program modules length)))
      (let tree (. ([] (. program modules) position) tree))
      (let decl 0u32)
      (for (in row (. ([] (. program modules) position) decls))
        (match? row
          (case (call .decl-function function)
            (match? ([] (. tree nodes) (. function syntax))
              (case (call .node-function-syntax node)
                (let place (call effect-place (as position U32) decl))
                (let bans (call (. program bans-named) (as position ModuleId) (. node bans)))
                (if (!= bans 0)
                  (= ([] (. table bans) place) bans)
                )
                (if (. node door)
                  (let effect (call (. program effect-named) (as position ModuleId) (. node door)))
                  (if effect
                    (= ([] (. table doors) place) effect)
                  )
                )
              )
              (case (call .node-do-block node)
                (let bans (call (. program bans-named) (as position ModuleId) (. node bans)))
                (if (!= bans 0)
                  (= ([] (. table bans) (call effect-place (as position U32) decl)) bans)
                )
              )
            )
          )
        )
        (+= decl 1)
      )
    )
    (return table)
  )
  (fn-do _ store-names _
    (param path-ids (of Map Atom U32 ArenaBacking))
    (param module-names (of Map Atom U32 ArenaBacking))
    (use atom-lock)
    (for (in position (..< 0 (. modules length)))
      (let module ([] modules position))
      (= ([] path-ids (call (. atoms store) (. module path))) (as position U32))
      (= ([] module-names (call (. atoms store) (. module name))) (as position U32))
    )
  )
  (fn-do _ add-module Index
    (param module Module)
    (throw (call Panic "ProgramBuilder is stale or already finished") (if (or released finished)))
    (throw (call Panic "ProgramBuilder module count exceeds U16 capacity") (if (>= (. modules length) (. U16 max))))
    (blank)
    (let index (. modules length))
    (call (. modules append) module)
    (return index)
  )
  (fn-do _ add-import _
    (param from Index)
    (param to Index)
    (param is-export Bool)
    (param is-builtin Bool (= false))
    (param follows Bool (= false))
    (throw (call Panic "ProgramBuilder is stale or already finished") (if (or released finished)))
    (throw (call OutOfBoundsError "ProgramBuilder import module index out of bounds") (if (or (>= from (. modules length)) (>= to (. modules length)))))
    (blank)
    (+= edge-froms (as from U32))
    (+= edge-tos (as to U32))
    (+= edge-exports is-export)
    (+= edge-builtins is-builtin)
    (+= edge-follows follows)
  )
  (fn-do _ build-ranks (of ImmutableArray U16 ArenaBacking)
    (param arena Arena)
    (param include-builtins Bool)
    ; For each module, where each module it can name comes in the order the reference looks
    ; through what they declare: itself, then the modules it imports, the import made last first,
    ; each followed at once by those it exports in turn, a module where it is first reached. One
    ; it cannot name has the most there is. The imports of each module are gathered first, in that
    ; order, so a module reached reads only its own.
    (let total (. modules length))
    (let edge-count (. edge-froms length))
    (let ranks (call (of Array U16) arena (* total total)))
    (for (in index (..< 0 (* total total)))
      (= ([] ranks index) (. U16 max))
    )
    (let starts (call (of Array U32) scratch (+ total 1)))
    (let fills (call (of Array U32) scratch (+ total 1)))
    (let targets (call (of Array U32) scratch (+ edge-count 1)))
    (let exports (call (of Array Bool) scratch (+ edge-count 1)))
    (for (in position (..< 0 (+ total 1)))
      (= ([] starts position) 0)
    )
    (for (in edge (..< 0 edge-count))
      (if (or include-builtins (not ([] edge-builtins edge)))
        (+= ([] starts (+ ([] edge-froms edge) 1)) 1)
      )
    )
    (for (in position (..< 0 total))
      (+= ([] starts (+ position 1)) ([] starts position))
      (= ([] fills position) ([] starts position))
    )
    (for (in reverse (..< 0 edge-count))
      (let edge (- edge-count 1 reverse))
      (if (or include-builtins (not ([] edge-builtins edge)))
        (let origin ([] edge-froms edge))
        (= ([] targets ([] fills origin)) ([] edge-tos edge))
        (= ([] exports ([] fills origin)) ([] edge-exports edge))
        (+= ([] fills origin) 1)
      )
    )
    (let imports (call ImportEdges starts targets exports))
    (for (in caller (..< 0 total))
      (let row (* caller total))
      (= ([] ranks (+ row caller)) 0)
      (call rank-imports ranks row (as caller U32) true imports 1)
    )
    (return (. ranks immutable))
  )
  (fn-do _ rank-imports U16
    (param ranks (of Array U16 ArenaBacking))
    (param row Size)
    (param module U32)
    (param all Bool)
    (param imports ImportEdges)
    (param next U16)
    ; Ranks from `next` on the modules a module imports that are not ranked yet, the import made
    ; last first, each followed at once by those it exports in turn, and gives the rank after
    ; them. With `all`, every import of the module counts, as for the module that names them;
    ; otherwise only those it exports.
    (let rank next)
    (for (in position (..< ([] (. imports starts) module) ([] (. imports starts) (+ module 1))))
      (if (or all ([] (. imports exports) position))
        (let target ([] (. imports targets) position))
        (if (== ([] ranks (+ row target)) (. U16 max))
          (= ([] ranks (+ row target)) rank)
          (= rank (call rank-imports ranks row target false imports (+ rank 1)))
        )
      )
    )
    (return rank)
  )
  (fn-do _ gather-atoms (of List Atom ArenaBacking)
    (let seen (call (of Map Atom Bool) scratch))
    (let gathered (call (of List Atom) scratch))
    (for (in position (..< 0 (. modules length)))
      (let module ([] modules position))
      (for (in atom (. module tree stored-atoms))
        (if (not ([] seen atom))
          (= ([] seen atom) true)
          (+= gathered atom)
        )
      )
      (for (in atom (. module made-atoms))
        (if (not ([] seen atom))
          (= ([] seen atom) true)
          (+= gathered atom)
        )
      )
    )
    (return gathered)
  )
  (fn-do _ build-atom-ordinals (of Map Atom U32 ArenaBacking)
    (param arena Arena)
    (param parsed (of List Atom ArenaBacking))
    ; For each atom the parse made, its place in the order of the atoms' texts. Modules are parsed on
    ; several threads, each adding its atoms as it ends, so the order they were made in differs from
    ; one compile to the next, and the order of their texts does not.
    (let count (. parsed length))
    (let order (call (of Array U32) scratch (+ count 1)))
    (let spare (call (of Array U32) scratch (+ count 1)))
    (for (in index (..< 0 count))
      (= ([] order index) (as index U32))
    )
    (let width Size 1)
    (while (< width count)
      (let start Size 0)
      (while (< start count)
        (let middle (if-expr (< (+ start width) count) (+ start width) count))
        (let end (if-expr (< (+ start (* 2 width)) count) (+ start (* 2 width)) count))
        (call merge-atoms parsed order spare start middle end)
        (= start end)
      )
      (let merged spare)
      (= spare order)
      (= order merged)
      (*= width 2)
    )
    (let ordinals (call (of Map Atom U32) arena))
    (for (in position (..< 0 count))
      (= ([] ordinals ([] parsed ([] order position))) (as position U32))
    )
    (return ordinals)
  )
  (fn-do _ build-parse-atoms (of Map String Atom ArenaBacking)
    (param arena Arena)
    (param parsed (of List Atom ArenaBacking))
    ; The atoms the parse made, by their texts, which typing reads on many threads at once.
    (let texts (call (of Map String Atom) arena))
    (for (in atom parsed)
      (= ([] texts (. atom text)) atom)
    )
    (return texts)
  )
  (fn-do _ merge-atoms _
    (param parsed (of List Atom ArenaBacking))
    (param from (of Array U32 ArenaBacking))
    (param into (of Array U32 ArenaBacking))
    (param start Size)
    (param middle Size)
    (param end Size)
    ; Merges two runs of atoms, each in the order of their texts, from `start` to `middle` and from
    ; `middle` to `end`, into one run at the same places.
    (let left start)
    (let right middle)
    (for (in place (..< start end))
      (if (or (>= right end) (and (< left middle) (not (< (. ([] parsed ([] from right)) text) (. ([] parsed ([] from left)) text)))))
        (= ([] into place) ([] from left))
        (+= left 1)
        (else
          (= ([] into place) ([] from right))
          (+= right 1)
        )
      )
    )
  )
  (fn-do _ build-listing Listings
    (param arena Arena)
    ; For each module, where each module it can name comes in the order the reference lists
    ; what they declare: a module after the modules it imports, the builtin modules before the
    ; others and of each the import made last first, and of a module that is itself imported
    ; only what it exports. A module is listed where it first ends, and also by where it last
    ; ends, as one that is not entered ends each time it is reached; one that cannot be named has
    ; the most there is.
    (let total (. modules length))
    (let edge-count (. edge-froms length))
    (let listing (call (of Array U16) arena (* total total)))
    (let latest (call (of Array U32) arena (* total total)))
    (for (in index (..< 0 (* total total)))
      (= ([] listing index) (. U16 max))
      (= ([] latest index) (. U32 max))
    )
    (let starts (call (of Array U32) scratch (+ total 1)))
    (let fills (call (of Array U32) scratch (+ total 1)))
    (let targets (call (of Array U32) scratch (+ edge-count 1)))
    (let exports (call (of Array Bool) scratch (+ edge-count 1)))
    (for (in position (..< 0 (+ total 1)))
      (= ([] starts position) 0)
    )
    (for (in edge (..< 0 edge-count))
      (+= ([] starts (+ ([] edge-froms edge) 1)) 1)
    )
    (for (in position (..< 0 total))
      (+= ([] starts (+ position 1)) ([] starts position))
      (= ([] fills position) ([] starts position))
    )
    (for (in pass (..< 0 2))
      (for (in reverse (..< 0 edge-count))
        (let edge (- edge-count 1 reverse))
        (if (== ([] edge-builtins edge) (== pass 0))
          (let origin ([] edge-froms edge))
          (= ([] targets ([] fills origin)) ([] edge-tos edge))
          (= ([] exports ([] fills origin)) ([] edge-exports edge))
          (+= ([] fills origin) 1)
        )
      )
    )
    (let entered (call (of Array Bool) scratch total))
    (let open-modules (call (of Array U32) scratch (+ total 1)))
    (let open-cursors (call (of Array U32) scratch (+ total 1)))
    (for (in caller (..< 0 total))
      (let row (* caller total))
      (for (in position (..< 0 total))
        (= ([] entered position) false)
      )
      (let next U16)
      (let ends 0u32)
      (let depth 1)
      (= ([] open-modules 0) (as caller U32))
      (= ([] open-cursors 0) ([] starts caller))
      (while (!= depth 0)
        (let module ([] open-modules (- depth 1)))
        (let cursor ([] open-cursors (- depth 1)))
        (let descends false)
        (while (and (< cursor ([] starts (+ module 1))) (not descends))
          (let position cursor)
          (+= cursor 1)
          (if (or (== depth 1) ([] exports position))
            (= ([] entered module) true)
            (let target ([] targets position))
            (if (not ([] entered target))
              (= ([] open-cursors (- depth 1)) cursor)
              (= ([] open-modules depth) target)
              (= ([] open-cursors depth) ([] starts target))
              (+= depth 1)
              (= descends true)
            )
          )
        )
        (if (not descends)
          (if (== ([] listing (+ row module)) (. U16 max))
            (= ([] listing (+ row module)) next)
            (+= next 1)
          )
          (= ([] latest (+ row module)) ends)
          (+= ends 1)
          (-= depth 1)
        )
      )
    )
    (return (call Listings (. listing immutable) (. latest immutable)))
  )
  (fn-do _ build-module-order (of ImmutableArray U32 ArenaBacking)
    (param entry-module ModuleId)
    (param roots (list U32))
    (param declaring Bool)
    (param outgoing ModuleEdges)
    ; The modules the entry module reaches, or each root of a batch in turn, in the order they
    ; initialize: each after the modules it imports, depth first, a module's imports of builtin
    ; modules before its others and each group in the order it is declared. Every other module
    ; imports the builtin modules first; a builtin module imports only what it declares. In the order
    ; TypeScript `declaring` declares them, an import that follows comes after the module that makes
    ; it.
    (let total (. modules length))
    (let is-builtin (call builtin-modules))
    (let visited (call (of Array Bool) scratch total))
    (let reached (call (of List U32) scratch))
    (if roots
      (for (in root roots)
        (call visit-module root declaring is-builtin outgoing visited reached)
      )
      (else
        (call visit-module entry-module declaring is-builtin outgoing visited reached)
      )
    )
    (let order (call (of Array U32) module-arena (. reached length)))
    (for (in position (..< 0 (. reached length)))
      (= ([] order position) ([] reached position))
    )
    (return (. order immutable))
  )
  (fn-do _ builtin-modules (of Array Bool ArenaBacking)
    ; Which modules some import names as builtin.
    (let is-builtin (call (of Array Bool) scratch (. modules length)))
    (for (in edge (..< 0 (. edge-froms length)))
      (if ([] edge-builtins edge)
        (= ([] is-builtin ([] edge-tos edge)) true)
      )
    )
    (return is-builtin)
  )
  (fn-do _ module-edges ModuleEdges
    (let total (. modules length))
    (let edge-count (. edge-froms length))
    (let starts (call (of Array U32) scratch (+ total 1)))
    (let fills (call (of Array U32) scratch (+ total 1)))
    (let edges (call (of Array U32) scratch (+ edge-count 1)))
    (for (in position (..< 0 (+ total 1)))
      (= ([] starts position) 0)
    )
    (for (in edge (..< 0 edge-count))
      (+= ([] starts (+ ([] edge-froms edge) 1)) 1)
    )
    (for (in position (..< 0 total))
      (+= ([] starts (+ position 1)) ([] starts position))
      (= ([] fills position) ([] starts position))
    )
    (for (in edge (..< 0 edge-count))
      (let origin ([] edge-froms edge))
      (= ([] edges ([] fills origin)) (as edge U32))
      (+= ([] fills origin) 1)
    )
    (return (call ModuleEdges starts edges))
  )
  (fn-do _ build-batch-orders BatchOrders
    (param roots (list U32))
    (param outgoing ModuleEdges)
    ; The roots of a batch and the modules each reaches, in the order they initialize as though it
    ; were the entry module alone: those of a root lie from its start to the next root's. Each module
    ; has a word of bits for each 64 roots, a bit set for each root that reaches it.
    (let is-builtin (call builtin-modules))
    (let reached (call (of List U32) scratch))
    (let root-ids (call (of Array U32) module-arena (. roots length)))
    (let starts (call (of Array U32) module-arena (+ (. roots length) 1)))
    (for (in position (..< 0 (. roots length)))
      (= ([] root-ids position) ([] roots position))
      (= ([] starts position) (as (. reached length) U32))
      (call visit-module
        (block
          (arg ([] roots position))
          (arg false)
          (arg is-builtin)
          (arg outgoing)
          (arg (call (of Array Bool) scratch (. modules length)))
          (arg reached)
        )
      )
    )
    (= ([] starts (. roots length)) (as (. reached length) U32))
    (let order (call (of Array U32) module-arena (. reached length)))
    (for (in position (..< 0 (. reached length)))
      (= ([] order position) ([] reached position))
    )
    (let words (/ (+ (. roots length) 63) 64))
    (let cases (call (of Array U64) module-arena (* (. modules length) words)))
    (for (in position (..< 0 (* (. modules length) words)))
      (= ([] cases position) 0)
    )
    (for (in root (..< 0 (. roots length)))
      (for (in position (..< ([] starts root) ([] starts (+ root 1))))
        (let place (+ (* (as ([] order (as position Size)) Size) words) (/ root 64)))
        (= ([] cases place) (/or/ ([] cases place) (/lshift/ 1u64 (as (% root 64) U64))))
      )
    )
    (return (call BatchOrders (. root-ids immutable) (. starts immutable) (. order immutable) (. cases immutable)))
  )
  (fn-do _ build-feature-gates FeatureGates
    (let total (. modules length))
    (let found (call (of List U32) scratch))
    (let starts (call (of Array U32) module-arena (+ total 1)))
    (for (in position (..< 0 total))
      (= ([] starts position) (as (. found length) U32))
      (call scan-gates (. ([] modules position) tree) found)
    )
    (= ([] starts total) (as (. found length) U32))
    (let gates (call (of Array U32) module-arena (. found length)))
    (for (in position (..< 0 (. found length)))
      (= ([] gates position) ([] found position))
    )
    (return (call FeatureGates (. starts immutable) (. gates immutable)))
  )
  (fn-do _ visit-module _
    (param module U32)
    (param declaring Bool)
    (param is-builtin (of Array Bool ArenaBacking))
    (param outgoing ModuleEdges)
    (param visited (of Array Bool ArenaBacking))
    (param reached (of List U32 ArenaBacking))
    (if ([] visited module)
      (return)
    )
    (= ([] visited module) true)
    (let first ([] (. outgoing starts) module))
    (let last ([] (. outgoing starts) (+ module 1)))
    (for (in wants-builtin (list true false))
      (for (in position (..< first last))
        (let edge ([] (. outgoing edges) position))
        (if (!= ([] is-builtin ([] edge-tos edge)) wants-builtin)
          (continue)
        )
        (if (and ([] edge-builtins edge) ([] is-builtin module))
          (continue)
        )
        (if (and declaring ([] edge-follows edge))
          (continue)
        )
        (call visit-module ([] edge-tos edge) declaring is-builtin outgoing visited reached)
      )
    )
    (+= reached module)
    (if declaring
      (for (in position (..< first last))
        (let edge ([] (. outgoing edges) position))
        (if ([] edge-follows edge)
          (call visit-module ([] edge-tos edge) declaring is-builtin outgoing visited reached)
        )
      )
    )
  )
  (fn-do _ build-extension-index BuiltExtensionIndex
    (param arena Arena)
    (param index BuiltNameIndex)
    (param ranks (of ImmutableArray U16 ArenaBacking))
    (param facets FacetTable)
    (let key-modules (call (of List U32) scratch))
    (let key-decls (call (of List U32) scratch))
    (let entry-keys (call (of List U32) scratch))
    (let entry-modules (call (of List U32) scratch))
    (let entry-decls (call (of List U32) scratch))
    (for (in position (..< 0 (. modules length)))
      (let module ([] modules position))
      (let decl 0u32)
      (for (in row (. module decls))
        (match? row
          (case (call .decl-extension extension)
            (let head (only-if (call receiver-head (. module tree) (. extension receiver)) (if (not (. extension facet)))))
            (if head
              (let receiver (call first-class-named index ranks (as position ModuleId) head))
              (if receiver
                (let key (call extension-key key-modules key-decls receiver))
                (+= entry-keys key)
                (+= entry-modules (as position U32))
                (+= entry-decls decl)
              )
            )
          )
        )
        (+= decl 1)
      )
    )
    (for (in facet (..< 0 (. facets count)))
      (if (== ([] (. facets states) facet) .facet-bound)
        (let owner (call Candidate ([] (. facets owner-modules) facet) ([] (. facets owner-decls) facet) 0))
        (+= entry-keys (call extension-key key-modules key-decls owner))
        (+= entry-modules ([] (. facets modules) facet))
        (+= entry-decls ([] (. facets decls) facet))
      )
    )
    (blank)
    (let key-count (. key-modules length))
    (let entry-count (. entry-keys length))
    (let counts (call (of Array U32) scratch key-count))
    (let cursors (call (of Array U32) scratch key-count))
    (let starts (call (of Array U32) arena (+ key-count 1)))
    (let sorted-modules (call (of Array U32) arena entry-count))
    (let sorted-decls (call (of Array U32) arena entry-count))
    (let stored-key-modules (call (of Array U32) arena key-count))
    (let stored-key-decls (call (of Array U32) arena key-count))
    (for (in key (..< 0 key-count))
      (= ([] counts key) 0)
      (= ([] stored-key-modules key) ([] key-modules key))
      (= ([] stored-key-decls key) ([] key-decls key))
    )
    (for (in entry (..< 0 entry-count))
      (+= ([] counts ([] entry-keys entry)) 1)
    )
    (let sum Size 0)
    (for (in key (..< 0 key-count))
      (= ([] starts key) (as sum U32))
      (= ([] cursors key) (as sum U32))
      (+= sum ([] counts key))
    )
    (= ([] starts key-count) (as sum U32))
    (for (in entry (..< 0 entry-count))
      (let key ([] entry-keys entry))
      (let slot ([] cursors key))
      (= ([] sorted-modules slot) ([] entry-modules entry))
      (= ([] sorted-decls slot) ([] entry-decls entry))
      (= ([] cursors key) (+ slot 1))
    )
    (return
      (call BuiltExtensionIndex
        (block
          (arg (. stored-key-modules immutable))
          (arg (. stored-key-decls immutable))
          (arg (. starts immutable))
          (arg (. sorted-modules immutable))
          (arg (. sorted-decls immutable))
        )
      )
    )
  )
  (fn-do _ extension-key U32
    (param key-modules (of List U32 ArenaBacking))
    (param key-decls (of List U32 ArenaBacking))
    (param receiver Candidate)
    (for (in key (..< 0 (. key-modules length)))
      (if (and (== ([] key-modules key) (. receiver module)) (== ([] key-decls key) (. receiver decl)))
        (return (as key U32))
      )
    )
    (+= key-modules (. receiver module))
    (+= key-decls (. receiver decl))
    (return (as (- (. key-modules length) 1) U32))
  )
  (fn-do _ receiver-head (? Atom)
    (param tree AST)
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-type-identifier row)
        (return (. row name))
      )
      (case (call .node-type-arguments row)
        (return (call receiver-head tree (. row base)))
      )
    )
    (return null)
  )
  (fn-do _ first-class-named (? Candidate)
    (param index BuiltNameIndex)
    (param ranks (of ImmutableArray U16 ArenaBacking))
    (param caller ModuleId)
    (param name Atom)
    (param facets Bool (= false))
    (let name-id ([] name-ids name))
    (if (not name-id)
      (return null)
    )
    (let total (. modules length))
    (let begin ([] (. index bucket-starts) name-id))
    (let end ([] (. index bucket-starts) (+ name-id 1)))
    (let best-key (. Size max))
    (let best (? Candidate) null)
    (for (in entry (..< begin end))
      (let entry-module ([] (. index entry-modules) entry))
      (let rank ([] ranks (+ (* caller total) entry-module)))
      (if (!= rank (. U16 max))
        (let entry-decl (as ([] (. index entry-decls) entry) DeclId))
        (let is-class
          (match ([] (. ([] modules entry-module) decls) entry-decl)
            (case .decl-class
              true
            )
            (case (call .decl-extension extension)
              (and facets (!= (. extension facet) null))
            )
            (default
              false
            )
          )
        )
        (if is-class
          (let key (/or/ (/lshift/ (+ (as rank Size) 1) 32) (- entry begin)))
          (if (< key best-key)
            (= best-key key)
            (= best (call Candidate entry-module entry-decl rank))
          )
        )
      )
    )
    (return best)
  )
  (fn-do _ build-facet-table FacetTable
    (param index BuiltNameIndex)
    (param ranks (of ImmutableArray U16 ArenaBacking))
    ; The facets of the program, each bound to what its `facet-of` names, read where it is declared,
    ; and to the class at the root of that chain, with the siblings its `sees` names; and for each
    ; class, its facets by module name and then by declaration.
    (let table (call FacetTable))
    (for (in position (..< 0 (. modules length)))
      (let decl 0u32)
      (for (in row (. ([] modules position) decls))
        (match? row
          (case (call .decl-extension extension)
            (if (. extension facet)
              (= ([] (. table places) (call place-key (as position U32) decl)) (as (. table modules length) U32))
              (+= (. table modules) (as position U32))
              (+= (. table decls) decl)
            )
          )
        )
        (+= decl 1)
      )
    )
    (for (in _ (..< 0 (. modules length)))
      (+= (. table hosts) (. U32 max))
    )
    (let count (. table modules length))
    (for (in facet (..< 0 count))
      (call bind-facet table index ranks facet)
    )
    (for (in facet (..< 0 count))
      (call root-facet table facet)
    )
    (for (in facet (..< 0 count))
      (+= (. table sees-starts) (as (. table sees length) U32))
      (call see-facets table facet)
    )
    (+= (. table sees-starts) (as (. table sees length) U32))
    (call order-facets table)
    (for (in facet (..< 0 count))
      (if (== ([] (. table states) facet) .facet-bound)
        (= ([] (. table hosts) ([] (. table modules) facet)) ([] (. table owner-modules) facet))
      )
    )
    (return table)
  )
  (fn-do _ bind-facet _
    (param table FacetTable)
    (param index BuiltNameIndex)
    (param ranks (of ImmutableArray U16 ArenaBacking))
    (param facet Size)
    (let module ([] (. table modules) facet))
    (let tree (. ([] modules module) tree))
    (let receiver (call facet-receiver module ([] (. table decls) facet)))
    (let head (call receiver-head tree receiver))
    (let found (only-if (call first-class-named index ranks (as module ModuleId) head true) (if head)))
    (let state (. FacetState facet-bound))
    (let parent (. U32 max))
    (if (not found)
      (= state .facet-owner-missing)
      (else
        (match ([] (. ([] modules (. found module)) decls) (. found decl))
          (case (call .decl-class owner)
            (if (or (!= (. owner type-args count) 0) (is ([] (. tree nodes) receiver) .node-type-arguments))
              (= state .facet-owner-generic)
            )
          )
          (case .decl-extension
            (= parent (?? (call (. table index-of) (. found module) (. found decl)) (. U32 max)))
          )
          (default
            (= state .facet-owner-not-class)
          )
        )
      )
    )
    (+= (. table parents) parent)
    (+= (. table parent-modules) (if-expr found (. found module) (. U32 max)))
    (+= (. table parent-decls) (if-expr found (. found decl) (. U32 max)))
    (+= (. table owner-modules) (. U32 max))
    (+= (. table owner-decls) (. U32 max))
    (+= (. table states) state)
  )
  (fn-do _ root-facet _
    (param table FacetTable)
    (param facet Size)
    ; Follows a facet's chain of parents to the class at its root, which must be declared in the
    ; base module of the facet's file family.
    (return-if (if (!= ([] (. table states) facet) .facet-bound)))
    (let current facet)
    (let steps Size 0)
    (while (!= ([] (. table parents) current) (. U32 max))
      (= current ([] (. table parents) current))
      (+= steps 1)
      (if (> steps (. table count))
        (= ([] (. table states) facet) .facet-cycle)
        (return)
      )
      (if (!= ([] (. table states) current) .facet-bound)
        (= ([] (. table states) facet) .facet-owner-missing)
        (return)
      )
    )
    (let owner-module ([] (. table parent-modules) current))
    (let owner-decl ([] (. table parent-decls) current))
    (if (not (call is-family-base ([] (. table modules) facet) owner-module))
      (= ([] (. table states) facet) .facet-outside-family)
      (return)
    )
    (= ([] (. table owner-modules) facet) owner-module)
    (= ([] (. table owner-decls) facet) owner-decl)
  )
  (fn-do _ see-facets _
    (param table FacetTable)
    (param facet Size)
    ; The siblings a facet's `sees` names, found among the other facets of its class by name, or
    ; none for a name that is no such facet's.
    (let module ([] (. table modules) facet))
    (let target ([] modules module))
    (match? ([] (. target decls) ([] (. table decls) facet))
      (case (call .decl-extension row)
        (for (in offset (..< 0 (. row sees count)))
          (let syntax ([] (. target syntax-pool) (+ (. row sees start) offset)))
          (let head (call receiver-head (. target tree) syntax))
          (let seen (. U32 max))
          (if (and head (== ([] (. table states) facet) .facet-bound))
            (for (in other (..< 0 (. table count)))
              (let bound (== ([] (. table states) other) .facet-bound))
              (if (and bound (!= other facet) (call is-sibling table facet other))
                (if (== (call facet-name table other) head)
                  (= seen (as other U32))
                )
              )
            )
          )
          (+= (. table sees) seen)
        )
      )
    )
  )
  (fn-expr _ is-sibling Bool
    (param table FacetTable)
    (param facet Size)
    (param other Size)
    (and (== ([] (. table owner-modules) other) ([] (. table owner-modules) facet)) same-decl)
    (where
      (lazy same-decl (== ([] (. table owner-decls) other) ([] (. table owner-decls) facet)))
    )
  )
  (fn-expr _ facet-name (? Atom)
    (param table FacetTable)
    (param facet Size)
    (match ([] (. ([] modules ([] (. table modules) facet)) decls) ([] (. table decls) facet))
      (case (call .decl-extension row)
        (. row facet)
      )
      (default
        null
      )
    )
  )
  (fn-do _ order-facets _
    (param table FacetTable)
    ; Groups the bound facets by their class, each group by the name of the module that declares a
    ; facet and then by declaration.
    (let sorted (list U32))
    (for (in facet (..< 0 (. table count)))
      (if (== ([] (. table states) facet) .facet-bound)
        (let place (. sorted length))
        (while (and (> place 0) (call facet-after table ([] sorted (- place 1)) (as facet U32)))
          (-= place 1)
        )
        (call (. sorted insert) (as facet U32) place)
      )
    )
    (for (in facet sorted)
      (let module ([] (. table owner-modules) facet))
      (let decl ([] (. table owner-decls) facet))
      (let last (. table class-modules length))
      (if (or (== last 0) (!= ([] (. table class-modules) (- last 1)) module) (!= ([] (. table class-decls) (- last 1)) decl))
        (+= (. table class-modules) module)
        (+= (. table class-decls) decl)
        (+= (. table class-starts) (as (. table class-facets length) U32))
      )
      (+= (. table class-facets) facet)
    )
    (+= (. table class-starts) (as (. table class-facets length) U32))
  )
  (fn-expr _ facet-after Bool
    (param table FacetTable)
    (param first U32)
    (param second U32)
    ; Whether one facet goes after another: by its class, then by the name of the module that
    ; declares it, then by declaration.
    (case? (!= ([] (. table owner-modules) first) ([] (. table owner-modules) second))
      (> ([] (. table owner-modules) first) ([] (. table owner-modules) second))
    )
    (case? (!= ([] (. table owner-decls) first) ([] (. table owner-decls) second))
      (> ([] (. table owner-decls) first) ([] (. table owner-decls) second))
    )
    (case? (!= first-name second-name)
      (> first-name second-name)
    )
    (default
      (> ([] (. table decls) first) ([] (. table decls) second))
    )
    (where
      (lazy first-name (. ([] modules ([] (. table modules) first)) name))
      (lazy second-name (. ([] modules ([] (. table modules) second)) name))
    )
  )
  (fn-expr _ facet-receiver SyntaxId
    (param module U32)
    (param decl U32)
    (match ([] (. ([] modules module) decls) decl)
      (case (call .decl-extension row)
        (. row receiver)
      )
      (default
        0
      )
    )
  )
  (fn-do _ build-name-index BuiltNameIndex
    (param arena Arena)
    (for (in index (..< 0 (. modules length)))
      (call collect-module-names index)
    )
    (blank)
    (let pair-count (. pair-names length))
    (let counts (call (of Array U32) scratch name-count))
    (let cursors (call (of Array U32) scratch name-count))
    (let starts (call (of Array U32) arena (+ name-count 1)))
    (let entry-modules (call (of Array U32) arena pair-count))
    (let entry-decls (call (of Array U32) arena pair-count))
    (blank)
    (for (in index (..< 0 name-count))
      (= ([] counts index) 0)
    )
    (for (in pair (..< 0 pair-count))
      (let name-id ([] pair-names pair))
      (+= ([] counts name-id) 1)
    )
    (blank)
    (let sum Size 0)
    (for (in index (..< 0 name-count))
      (= ([] starts index) (as sum U32))
      (= ([] cursors index) (as sum U32))
      (+= sum ([] counts index))
    )
    (= ([] starts name-count) (as sum U32))
    (blank)
    (for (in pair (..< 0 pair-count))
      (let name-id ([] pair-names pair))
      (let slot ([] cursors name-id))
      (= ([] entry-modules slot) ([] pair-modules pair))
      (= ([] entry-decls slot) ([] pair-decls pair))
      (= ([] cursors name-id) (+ slot 1))
    )
    (blank)
    (return (call BuiltNameIndex (. starts immutable) (. entry-modules immutable) (. entry-decls immutable)))
  )
  (fn-do _ collect-module-names _
    (param index Index)
    (let module ([] modules index))
    (let tree (. module tree))
    (for (in decl (..< 1 (. module decls length)))
      (match? ([] (. module decls) decl)
        (case (call .decl-function row)
          (if (and (== (. row owner) 0) (. row name))
            (call add-pair (. row name) (as index ModuleId) (as decl DeclId))
          )
        )
        (case (call .decl-class row)
          (do
            (call add-pair (. row name) (as index ModuleId) (as decl DeclId))
            (for (in offset (..< 0 (. row aliases count)))
              (call add-pair
                (block
                  (arg ([] (. tree atoms) (+ (. row aliases start) offset)))
                  (arg (as index ModuleId))
                  (arg (as decl DeclId))
                )
              )
            )
          )
        )
        (case (call .decl-property row)
          (if (and (== (. row owner) 0) (. row name))
            (call add-pair (. row name) (as index ModuleId) (as decl DeclId))
          )
        )
        (case (call .decl-event row)
          (if (== (. row owner) 0)
            (call add-pair (. row name) (as index ModuleId) (as decl DeclId))
          )
        )
        (case (call .decl-effect row)
          (call add-pair (. row name) (as index ModuleId) (as decl DeclId))
        )
        (case (call .decl-extension row)
          (if (. row facet)
            (call add-pair (. row facet) (as index ModuleId) (as decl DeclId))
          )
        )
      )
    )
  )
  (fn-do _ add-pair _
    (param name Atom)
    (param module ModuleId)
    (param decl DeclId)
    (throw (call Panic "ProgramBuilder name pair pool exceeds U32 capacity") (if (>= (. pair-names length) (. U32 max))))
    (blank)
    (let name-id (call store-name name))
    (+= pair-names (as name-id U32))
    (+= pair-modules module)
    (+= pair-decls decl)
  )
  (fn-do _ store-name Index
    (param atom Atom)
    (throw (call Panic "ProgramBuilder name count exceeds U32 capacity") (if (>= name-count (. U32 max))))
    (blank)
    (let existing ([] name-ids atom))
    (if existing
      (return existing)
    )
    (blank)
    (let id name-count)
    (= ([] name-ids atom) (as id U32))
    (+= name-count 1)
    (return id)
  )
)

(type _ ModuleJob
  (prop + builder ModuleBuilder)
  (prop + tree AST)
  (prop + module (? Module))
  (prop + transferred Bool)
  (prop _ finished Bool)
  (prop _ released Bool)
  (fn-do + This _
    (param builder ModuleBuilder)
    (param tree AST)
  )
  (fn-do + finish _
    (param atoms AtomPool)
    (param atom-lock Mutex)
    (= module (call (. builder finish) tree atoms atom-lock))
    (= finished true)
  )
  (fn-do + release _
    (if (not released)
      (if (not finished)
        (call (. tree release))
        (else-if (not transferred)
          (call (. (!! module) release))
        )
      )
      (call (. builder release))
      (= released true)
    )
  )
)

(type _ BuiltExtensionIndex (is Tuple)
  (prop + key-modules (of ImmutableArray U32 ArenaBacking))
  (prop + key-decls (of ImmutableArray U32 ArenaBacking))
  (prop + starts (of ImmutableArray U32 ArenaBacking))
  (prop + entry-modules (of ImmutableArray U32 ArenaBacking))
  (prop + entry-decls (of ImmutableArray U32 ArenaBacking))
)

(type _ FeatureGates (is Tuple)
  (prop + starts (of ImmutableArray U32 ArenaBacking))
  (prop + gates (of ImmutableArray U32 ArenaBacking))
)

(type _ BatchOrders (is Tuple)
  ; The roots of a batch, and the modules each initializes, those of a root from its start to the
  ; next one's, and for each module the bits of the roots that reach it.
  (blank)
  (prop + roots (of ImmutableArray U32 ArenaBacking))
  (prop + starts (of ImmutableArray U32 ArenaBacking))
  (prop + modules (of ImmutableArray U32 ArenaBacking))
  (prop + cases (of ImmutableArray U64 ArenaBacking))
)

(type _ Listings (is Tuple)
  ; Where each module comes among those each module can name, as the reference lists them, where
  ; it first ends and where it last ends.
  (blank)
  (prop + first (of ImmutableArray U16 ArenaBacking))
  (prop + last (of ImmutableArray U32 ArenaBacking))
)

(type _ ImportEdges (is Tuple)
  ; The imports of each module as ranking reads them: those of a module lie from its start to the
  ; next module's, the import made last first, each the module imported and whether it is exported.
  (blank)
  (prop + starts (of Array U32 ArenaBacking))
  (prop + targets (of Array U32 ArenaBacking))
  (prop + exports (of Array Bool ArenaBacking))
)

(type _ ModuleEdges (is Tuple)
  (prop + starts (of Array U32 ArenaBacking))
  (prop + edges (of Array U32 ArenaBacking))
)

(type _ BuiltNameIndex (is Tuple)
  (prop + bucket-starts (of ImmutableArray U32 ArenaBacking))
  (prop + entry-modules (of ImmutableArray U32 ArenaBacking))
  (prop + entry-decls (of ImmutableArray U32 ArenaBacking))
)

(fn-do _ scan-gates _
  (param tree AST)
  (param gates (of List U32 ArenaBacking))
  (for (in id (..< 0 (. tree nodes length)))
    (match? ([] (. tree nodes) id)
      (case (call .node-do-block row)
        (if (!= (. row feature-gate-features) (. CompilerFeature none))
          (+= gates (as id U32))
        )
      )
    )
  )
)
