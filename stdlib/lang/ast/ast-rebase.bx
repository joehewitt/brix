        (= (. row pattern) (call (. shift node) (. row pattern)))
      )
      (case (call .node-stream-type row)
        (= (. row type) (call (. shift node) (. row type)))
      )
      (case (call .node-stream-equality row)
        (= (. row value) (call (. shift node) (. row value)))
      )
      (case (call .node-stream-length row)
        (= (. row operand) (call (. shift node) (. row operand)))
        (= (. row min) (call (. shift node) (. row min)))
        (= (. row max) (call (. shift node) (. row max)))
      )
      (case (call .node-stream-unary row)
        (= (. row operand) (call (. shift node) (. row operand)))
      )
      (case (call .node-stream-call row)
        (= (. row params) (call (. shift child-range) (. row params)))
        (= (. row args) (call (. shift child-range) (. row args)))
        (= (. row collector-mappings) (call (. shift child-range) (. row collector-mappings)))
      )
      (case (call .node-stream-call-expression-argument row)
        (= (. row expression) (call (. shift node) (. row expression)))
      )
      (case (call .node-stream-predicate row)
        (= (. row predicate) (call (. shift node) (. row predicate)))
      )
      (case (call .node-stream-capture row)
        (= (. row name) (call (. shift node) (. row name)))
        (= (. row pattern) (call (. shift node) (. row pattern)))
      )
      (case (call .node-stream-char-range row)
        (= (. row first) (call (. shift node) (. row first)))
        (= (. row last) (call (. shift node) (. row last)))
      )
      (case (call .node-stream-string row)
        (= (. row text) (call store-string (. row text)))
      )
      (case (call .node-probe row)
        (= (. row object) (call (. shift node) (. row object)))
        (= (. row content) (call (. shift child-range) (. row content)))
      )
      (case (call .node-probe-group row)
        (= (. row content) (call (. shift child-range) (. row content)))
        (= (. row object) (call (. shift node) (. row object)))
      )
      (case (call .node-probe-assign row)
        (= (. row object) (call (. shift node) (. row object)))
        (= (. row content) (call (. shift node) (. row content)))
      )
      (case (call .node-probe-counter row)
        (= (. row object) (call (. shift node) (. row object)))
        (= (. row delta) (call (. shift node) (. row delta)))
      )
      (case (call .node-probe-snapshot row)
        (= (. row content) (call (. shift node) (. row content)))
      )
      (case (call .node-probe-preview row)
        (= (. row content) (call (. shift node) (. row content)))
      )
      (case (call .node-param-constraint row)
        (= (. row left) (call (. shift node) (. row left)))
        (= (. row right) (call (. shift node) (. row right)))
      )
      (case (call .node-param-assignment row)
        (= (. row left) (call (. shift node) (. row left)))
        (= (. row right) (call (. shift node) (. row right)))
      )
      (case (call .node-whenever-rule-syntax row)
        (= (. row target-type) (call (. shift node) (. row target-type)))
        (= (. row expr) (call (. shift node) (. row expr)))
        (= (. row args) (call (. shift child-range) (. row args)))
        (= (. row body) (call (. shift node) (. row body)))
      )
      (case (call .node-probe-scope row)
        (= (. row body) (call (. shift child-range) (. row body)))
      )
    )
  )
)
