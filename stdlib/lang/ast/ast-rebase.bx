        (= (. row type-id) (call (. shift node) (. row type-id)))
        (= (. row slot-parameter) (call (. shift node) (. row slot-parameter)))
        (= (. row slot-attrs) (call (. shift child-range) (. row slot-attrs)))
        (= (. row style-rule-applications) (call (. shift child-range) (. row style-rule-applications)))
        (= (. row body) (call (. shift node) (. row body)))
