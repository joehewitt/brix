(import ./ast-builder)
(import ./ast-nodes)
(import ./row-range)
(import /core/array-builder)
(import /core/parsing)
(import /core/table)

(type + SyntaxShift (is Tuple)
  (prop + nodes U32)
  (prop + children U32)
  (prop + atoms U32)
  (prop + lines U32)
  (fn-expr + node SyntaxId
    (param id SyntaxId)
    (if-expr (== id 0) id (+ id nodes))
  )
  (fn-expr + child-range (of RowRange SyntaxId)
    (param range (of RowRange SyntaxId))
    (call (of RowRange SyntaxId) (+ (. range start) children) (. range count))
  )
  (fn-expr + atom-range (of RowRange Atom)
    (param range (of RowRange Atom))
    (call (of RowRange Atom) (+ (. range start) atoms) (. range count))
  )
  (fn-expr + location MatchLocation
    (param loc MatchLocation)
    (if-expr (== loc (call MatchLocation)) loc (call MatchLocation shifted-begin shifted-end))
    (where
      (lazy shifted-begin (call TokenLocation (+ (. loc begin line) lines) (. loc begin column)))
      (lazy shifted-end (call TokenLocation (+ (. loc end line) lines) (. loc end column)))
    )
  )
)

(extend + ASTBuilder
  (fn-do + append-piece SyntaxShift
    (param piece ASTBuilder)
    (param lines U32)
    (let shift (call SyntaxShift (as (- (. nodes length) 1) U32) (as (. children length) U32) (as (. atoms length) U32) lines))
    (let first (. nodes length))
    (call (. nodes reserve) (- (+ first (. piece nodes length)) 1))
    (for (in row ([] (. piece nodes) (..< 1 (. piece nodes length))))
      (call (. nodes append) row)
    )
    (call (. children reserve) (+ (. children length) (. piece children length)))
    (for (in index (..< 0 (. piece children length)))
      (call (. children append) (call (. shift node) ([] (. piece children) index)))
    )
    (call (. atoms reserve) (+ (. atoms length) (. piece atoms length)))
    (for (in index (..< 0 (. piece atoms length)))
      (call (. atoms append) ([] (. piece atoms) index))
    )
    (for (in index (..< 0 (. piece stored-atoms length)))
      (call (. stored-atoms append) ([] (. piece stored-atoms) index))
    )
    (for (in id (..< first (. nodes length)))
      (call rebase-node (as id SyntaxId) shift)
    )
    (return shift)
  )
  (fn-do _ rebase-node _
    (param id SyntaxId)
    (param shift SyntaxShift)
    (= ([] (. nodes loc) id) (call (. shift location) ([] (. nodes loc) id)))
    (match? ([] nodes id)
      (case (call .node-top-level-syntax row)
        (= (. row statements) (call (. shift child-range) (. row statements)))
      )
      (case (call .node-block row)
        (= (. row body) (call (. shift child-range) (. row body)))
      )
      (case (call .node-print row)
        (= (. row body) (call (. shift node) (. row body)))
      )
      (case (call .node-declare row)
        (= (. row left) (call (. shift node) (. row left)))
        (= (. row right) (call (. shift node) (. row right)))
      )
      (case (call .node-assertion-syntax row)
        (= (. row exception) (call (. shift node) (. row exception)))
        (= (. row condition) (call (. shift node) (. row condition)))
      )
      (case (call .node-class-block row)
        (= (. row type-args) (call (. shift child-range) (. row type-args)))
        (= (. row aliases) (call (. shift atom-range) (. row aliases)))
        (= (. row base) (call (. shift node) (. row base)))
        (= (. row or-bases) (call (. shift child-range) (. row or-bases)))
        (= (. row members) (call (. shift child-range) (. row members)))
        (= (. row param-constraints) (call (. shift child-range) (. row param-constraints)))
        (= (. row param-assignments) (call (. shift child-range) (. row param-assignments)))
        (= (. row tags) (call (. shift atom-range) (. row tags)))
        (= (. row facet-of) (call (. shift node) (. row facet-of)))
      )
      (case (call .node-extension row)
        (= (. row receiver) (call (. shift node) (. row receiver)))
        (= (. row as-types) (call (. shift child-range) (. row as-types)))
        (= (. row param-constraints) (call (. shift child-range) (. row param-constraints)))
        (= (. row param-assignments) (call (. shift child-range) (. row param-assignments)))
        (= (. row body) (call (. shift child-range) (. row body)))
      )
      (case (call .node-style-sheet-extension row)
        (= (. row receiver) (call (. shift node) (. row receiver)))
        (= (. row body) (call (. shift child-range) (. row body)))
      )
      (case (call .node-effect-declaration row)
        (= (. row claims) (call (. shift atom-range) (. row claims)))
      )
      (case (call .node-event-declaration row)
        (= (. row type) (call (. shift node) (. row type)))
        (= (. row key-type) (call (. shift node) (. row key-type)))
      )
      (case (call .node-function-syntax row)
        (= (. row names) (call (. shift atom-range) (. row names)))
        (= (. row pattern) (call (. shift node) (. row pattern)))
        (= (. row args) (call (. shift child-range) (. row args)))
        (= (. row type-args) (call (. shift child-range) (. row type-args)))
        (= (. row return-type) (call (. shift node) (. row return-type)))
        (= (. row errors) (call (. shift child-range) (. row errors)))
        (= (. row param-constraints) (call (. shift child-range) (. row param-constraints)))
        (= (. row param-assignments) (call (. shift child-range) (. row param-assignments)))
        (= (. row body) (call (. shift node) (. row body)))
        (= (. row property-annotations) (call (. shift atom-range) (. row property-annotations)))
        (= (. row bans) (call (. shift atom-range) (. row bans)))
        (= (. row property-site) (call (. shift node) (. row property-site)))
      )
      (case (call .node-getter-syntax row)
        (= (. row names) (call (. shift atom-range) (. row names)))
        (= (. row pattern) (call (. shift node) (. row pattern)))
        (= (. row args) (call (. shift child-range) (. row args)))
        (= (. row type-args) (call (. shift child-range) (. row type-args)))
        (= (. row return-type) (call (. shift node) (. row return-type)))
        (= (. row errors) (call (. shift child-range) (. row errors)))
        (= (. row param-constraints) (call (. shift child-range) (. row param-constraints)))
        (= (. row param-assignments) (call (. shift child-range) (. row param-assignments)))
        (= (. row body) (call (. shift node) (. row body)))
        (= (. row property-annotations) (call (. shift atom-range) (. row property-annotations)))
        (= (. row bans) (call (. shift atom-range) (. row bans)))
        (= (. row property-site) (call (. shift node) (. row property-site)))
      )
      (case (call .node-setter-syntax row)
        (= (. row names) (call (. shift atom-range) (. row names)))
        (= (. row pattern) (call (. shift node) (. row pattern)))
        (= (. row args) (call (. shift child-range) (. row args)))
        (= (. row type-args) (call (. shift child-range) (. row type-args)))
        (= (. row return-type) (call (. shift node) (. row return-type)))
        (= (. row errors) (call (. shift child-range) (. row errors)))
        (= (. row param-constraints) (call (. shift child-range) (. row param-constraints)))
        (= (. row param-assignments) (call (. shift child-range) (. row param-assignments)))
        (= (. row body) (call (. shift node) (. row body)))
        (= (. row property-annotations) (call (. shift atom-range) (. row property-annotations)))
        (= (. row bans) (call (. shift atom-range) (. row bans)))
        (= (. row property-site) (call (. shift node) (. row property-site)))
      )
      (case (call .node-property-syntax row)
        (= (. row left) (call (. shift node) (. row left)))
        (= (. row value) (call (. shift node) (. row value)))
        (= (. row annotations) (call (. shift atom-range) (. row annotations)))
      )
      (case (call .node-state-machine row)
        (= (. row body) (call (. shift child-range) (. row body)))
