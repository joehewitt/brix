━━━━━━━━━━━━━━━━━━━━
+ ProgramBuilder
    is Usable'Void

+ shares-atoms Bool
_ atoms AtomPool
_ atom-lock = Mutex()
_ program-arena Arena
_ module-arena Arena
_ scratch Arena
_ modules ArrayBuilder'Module'ArenaBacking
_ edge-froms List'U32'ArenaBacking
_ edge-tos List'U32'ArenaBacking
_ edge-exports List'Bool'ArenaBacking
_ edge-builtins List'Bool'ArenaBacking
_ edge-follows List'Bool'ArenaBacking
_ pair-names List'U32'ArenaBacking
_ pair-modules List'U32'ArenaBacking
_ pair-decls List'U32'ArenaBacking
_ name-ids Map'Atom'U32'ArenaBacking
_ name-count Size
_ borrows Bool
_ finished Bool
_ scratch-released Bool
_ released Bool

────────────────────
+ This
    - atoms AtomPool

.. modules = ArrayBuilder'Module(module-arena)
.. edge-froms = List'U32(scratch)
.. edge-tos = List'U32(scratch)
.. edge-exports = List'Bool(scratch)
.. edge-builtins = List'Bool(scratch)
.. edge-follows = List'Bool(scratch)
.. pair-names = List'U32(scratch)
.. pair-modules = List'U32(scratch)
.. pair-decls = List'U32(scratch)

────────────────────
+ do build Program
    - syntax SyntaxProgram

?! Panic("ProgramBuilder is stale or already finished")
    if released || finished

use this
. shared = syntax.atom-lock
if shared
    atom-lock = shared
. hosts = SlotHosts()
hosts.builtin-paths = syntax.builtin-paths
for parsed-module in syntax.modules
    hosts.scan(parsed-module.tree, parsed-module.path)
for edge in syntax.edges
    hosts.add-import(edge.from, edge.to, edge.is-export)
hosts.settle()
. view = syntax.view
borrows = view != null
. jobs [ModuleJob]
. reused [Module?]
do finally
    for job in jobs
        job.release()
for parsed-module in syntax.modules
    . tree = parsed-module.take-tree()
    . names = hosts.names-for(parsed-module.path)
    . held = view.built(parsed-module.path, parsed-module.name, relative-path, names) if view
        .. relative-path = parsed-module.relative-path
    reused += held
    if !held
        . builder = ModuleBuilder
            - parsed-module.path
            - parsed-module.relative-path
            - parsed-module.name
            - tree.source
        builder.default-hosts = names
        jobs += ModuleJob(builder, tree)
finish-modules(jobs)
. module-ids [String = Index]
. next-job Size = 0
for held in reused
    if held
        module-ids[held.path] = add-module(held)
    else
        . job = jobs[next-job]
        next-job += 1
        if view
            ?! Panic("A module the program shares is not in its cache")
                if !view.keep-module(job.builder.path, job.module!, consulted, default-hosts)
            .. consulted = job.builder.consulted
            .. default-hosts = job.builder.default-hosts
        module-ids[job.builder.path] = add-module(job.module!)
        job.transferred = true

= link(syntax.builtin-paths, syntax.edges, syntax.source-path, module-ids, syntax.root-paths)

────────────────────
_ do finish-modules
    - jobs [ModuleJob]

. pool = Worker(default-worker-count)
. done SyncBufferedChannel'Bool
for job in jobs
    do (pool) new
        job.finish(atoms, atom-lock)
        done <- true
for _ in 0 .. < jobs.length
    <- done
pool.stop()

────────────────────
_ do link Program
    - builtin-paths [String]
    - edges [ImportEdge]
    - entry-path String
    - module-ids [String = Index]
    - root-paths [String] = []

for module-index in 0 .. < modules.length
    for builtin-path in builtin-paths
        . builtin-id = module-ids[builtin-path]
        if builtin-id
            if builtin-id != module-index
                add-import(module-index, builtin-id, false, true)

for edge in edges
    . from-id = module-ids[edge.from]
    . to-id = module-ids[edge.to]
    if from-id && to-id
        add-import(from-id, to-id, edge.is-export, false, edge.follows)

. roots [U32]
for root-path in root-paths
    . root = module-ids[root-path]
    ?! Panic("Batch root module was not linked")
        if !root
    roots += root as U32
. entry = module-ids[entry-path]
if roots
    entry = roots[0] as Index
?! Panic("Entry module was not linked")
    if !entry
= finish(entry as ModuleId, roots)

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

if !released
    if !finished
        if !borrows
            for module in modules
                module.release()
            if !shares-atoms
                atoms.release()
        program-arena.release()
        module-arena.release()
    if !scratch-released
        scratch.release()
        scratch-released = true
    released = true

────────────────────
_ do finish Program
    - entry-module ModuleId
    - roots [U32] = []

?! Panic("ProgramBuilder is stale or already finished")
    if released || finished

name-ids = Map'Atom'U32(program-arena)
. ranks = build-ranks(program-arena, true)
. listings = build-listing(program-arena)
. outgoing = module-edges()
. init-order = build-module-order(entry-module, roots, false, outgoing)
. declare-order = build-module-order(entry-module, roots, true, outgoing)
. batch = build-batch-orders(roots, outgoing)
. feature-gates = build-feature-gates()
. index = build-name-index(program-arena)
. extensions = build-extension-index(program-arena, index, ranks)
. parsed = gather-atoms()
. atom-ordinals = build-atom-ordinals(program-arena, parsed)
. parse-atoms = build-parse-atoms(program-arena, parsed)
scratch.release()
scratch-released = true

. path-ids = Map'Atom'U32(program-arena)
. module-names = Map'Atom'U32(program-arena)
store-names(path-ids, module-names)

. program = Program
    - atoms
    - program-arena
    - module-arena
    - modules.finish-immutable()
    - entry-module
    - init-order
    - declare-order
    - name-ids
    - path-ids
    - module-names
    - index.bucket-starts
    - index.entry-modules
    - index.entry-decls
    - ranks
    - ranks
    - extensions.key-modules
    - extensions.key-decls
    - extensions.starts
    - extensions.entry-modules
    - extensions.entry-decls
    - listings.first
    - listings.last
    - parse-atoms
    - atom-ordinals
    - batch.roots
    - batch.starts
    - batch.modules
    - batch.cases
    - feature-gates.starts
    - feature-gates.gates
    - borrows
    - shares-atoms
    - atom-lock
finished = true
= program

────────────────────
_ do store-names
    - path-ids Map'Atom'U32'ArenaBacking
    - module-names Map'Atom'U32'ArenaBacking

use atom-lock
for position in 0 .. < modules.length
    . module = modules[position]
    path-ids[atoms.store(module.path)] = position as U32
    module-names[atoms.store(module.name)] = position as U32

────────────────────
_ do add-module Index
    - module Module

?! Panic("ProgramBuilder is stale or already finished")
    if released || finished
?! Panic("ProgramBuilder module count exceeds U16 capacity")
    if modules.length >= U16.max

. index = modules.length
modules.append(module)
= index

────────────────────
_ do add-import
    - from Index
    - to Index
    - is-export Bool
    - is-builtin Bool = false
    - follows Bool = false

?! Panic("ProgramBuilder is stale or already finished")
    if released || finished
?! OutOfBoundsError("ProgramBuilder import module index out of bounds")
    if from >= modules.length || to >= modules.length

edge-froms += from as U32
edge-tos += to as U32
edge-exports += is-export
edge-builtins += is-builtin
edge-follows += follows

────────────────────
_ do build-ranks ImmutableArray'U16'ArenaBacking
    - arena Arena
    - include-builtins Bool

` For each module, where each module it can name comes in the order the reference looks
` through what they declare: itself, then the modules it imports, the import made last first,
` each followed at once by those it exports in turn, a module where it is first reached. One
` it cannot name has the most there is. The imports of each module are gathered first, in that
` order, so a module reached reads only its own.
. total = modules.length
. edge-count = edge-froms.length
. ranks = Array'U16(arena, total * total)
for index in 0 .. < total * total
    ranks[index] = U16.max
. starts = Array'U32(scratch, total + 1)
. fills = Array'U32(scratch, total + 1)
. targets = Array'U32(scratch, edge-count + 1)
. exports = Array'Bool(scratch, edge-count + 1)
for position in 0 .. < total + 1
    starts[position] = 0
for edge in 0 .. < edge-count
    if include-builtins || !edge-builtins[edge]
        starts[edge-froms[edge] + 1] += 1
for position in 0 .. < total
    starts[position + 1] += starts[position]
    fills[position] = starts[position]
for reverse in 0 .. < edge-count
    . edge = edge-count - 1 - reverse
    if include-builtins || !edge-builtins[edge]
        . origin = edge-froms[edge]
        targets[fills[origin]] = edge-tos[edge]
        exports[fills[origin]] = edge-exports[edge]
        fills[origin] += 1
. imports = ImportEdges(starts, targets, exports)
for caller in 0 .. < total
    . row = caller * total
    ranks[row + caller] = 0
    rank-imports(ranks, row, caller as U32, true, imports, 1)
= ranks.immutable

────────────────────
_ do rank-imports U16
    - ranks Array'U16'ArenaBacking
    - row Size
    - module U32
    - all Bool
    - imports ImportEdges
    - next U16

` Ranks from `next` on the modules a module imports that are not ranked yet, the import made
` last first, each followed at once by those it exports in turn, and gives the rank after
` them. With `all`, every import of the module counts, as for the module that names them;
` otherwise only those it exports.
. rank = next
for position in imports.starts[module] .. < imports.starts[module + 1]
    if all || imports.exports[position]
        . target = imports.targets[position]
        if ranks[row + target] == U16.max
            ranks[row + target] = rank
            rank = rank-imports(ranks, row, target, false, imports, rank + 1)
= rank

────────────────────
_ do gather-atoms List'Atom'ArenaBacking

. seen = Map'Atom'Bool(scratch)
. gathered = List'Atom(scratch)
for position in 0 .. < modules.length
    . module = modules[position]
    for atom in module.tree.stored-atoms
        if !seen[atom]
            seen[atom] = true
            gathered += atom
    for atom in module.made-atoms
        if !seen[atom]
            seen[atom] = true
            gathered += atom
= gathered

────────────────────
_ do build-atom-ordinals Map'Atom'U32'ArenaBacking
    - arena Arena
    - parsed List'Atom'ArenaBacking

` For each atom the parse made, its place in the order of the atoms' texts. Modules are parsed on
` several threads, each adding its atoms as it ends, so the order they were made in differs from
` one compile to the next, and the order of their texts does not.
. count = parsed.length
. order = Array'U32(scratch, count + 1)
. spare = Array'U32(scratch, count + 1)
for index in 0 .. < count
    order[index] = index as U32
. width Size = 1
while width < count
    . start Size = 0
    while start < count
        . middle = if start + width < count then start + width else count
        . end = if start + 2 * width < count then start + 2 * width else count
        merge-atoms(parsed, order, spare, start, middle, end)
        start = end
    . merged = spare
    spare = order
    order = merged
    width *= 2
. ordinals = Map'Atom'U32(arena)
for position in 0 .. < count
    ordinals[parsed[order[position]]] = position as U32
= ordinals

────────────────────
_ do build-parse-atoms Map'String'Atom'ArenaBacking
    - arena Arena
    - parsed List'Atom'ArenaBacking

` The atoms the parse made, by their texts, which typing reads on many threads at once.
. texts = Map'String'Atom(arena)
for atom in parsed
    texts[atom.text] = atom
= texts

────────────────────
_ do merge-atoms
    - parsed List'Atom'ArenaBacking
    - from Array'U32'ArenaBacking
    - into Array'U32'ArenaBacking
    - start Size
    - middle Size
    - end Size

` Merges two runs of atoms, each in the order of their texts, from `start` to `middle` and from
` `middle` to `end`, into one run at the same places.
. left = start
. right = middle
for place in start .. < end
    if right >= end || (left < middle && !(parsed[from[right]].text < parsed[from[left]].text))
        into[place] = from[left]
        left += 1
    else
        into[place] = from[right]
        right += 1

────────────────────
_ do build-listing Listings
    - arena Arena

` For each module, where each module it can name comes in the order the reference lists
` what they declare: a module after the modules it imports, the builtin modules before the
` others and of each the import made last first, and of a module that is itself imported
` only what it exports. A module is listed where it first ends, and also by where it last
` ends, as one that is not entered ends each time it is reached; one that cannot be named has
` the most there is.
. total = modules.length
. edge-count = edge-froms.length
. listing = Array'U16(arena, total * total)
. latest = Array'U32(arena, total * total)
for index in 0 .. < total * total
    listing[index] = U16.max
    latest[index] = U32.max
. starts = Array'U32(scratch, total + 1)
. fills = Array'U32(scratch, total + 1)
. targets = Array'U32(scratch, edge-count + 1)
. exports = Array'Bool(scratch, edge-count + 1)
for position in 0 .. < total + 1
    starts[position] = 0
for edge in 0 .. < edge-count
    starts[edge-froms[edge] + 1] += 1
for position in 0 .. < total
    starts[position + 1] += starts[position]
    fills[position] = starts[position]
for pass in 0 .. < 2
    for reverse in 0 .. < edge-count
        . edge = edge-count - 1 - reverse
        if edge-builtins[edge] == (pass == 0)
            . origin = edge-froms[edge]
            targets[fills[origin]] = edge-tos[edge]
            exports[fills[origin]] = edge-exports[edge]
            fills[origin] += 1
. entered = Array'Bool(scratch, total)
. open-modules = Array'U32(scratch, total + 1)
. open-cursors = Array'U32(scratch, total + 1)
for caller in 0 .. < total
    . row = caller * total
    for position in 0 .. < total
        entered[position] = false
    . next U16
    . ends = 0u32
    . depth = 1
    open-modules[0] = caller as U32
    open-cursors[0] = starts[caller]
    while depth != 0
        . module = open-modules[depth - 1]
        . cursor = open-cursors[depth - 1]
        . descends = false
        while cursor < starts[module + 1] && !descends
            . position = cursor
            cursor += 1
            if depth == 1 || exports[position]
                entered[module] = true
                . target = targets[position]
                if !entered[target]
                    open-cursors[depth - 1] = cursor
                    open-modules[depth] = target
                    open-cursors[depth] = starts[target]
                    depth += 1
                    descends = true
        if !descends
            if listing[row + module] == U16.max
                listing[row + module] = next
                next += 1
            latest[row + module] = ends
            ends += 1
            depth -= 1
= Listings(listing.immutable, latest.immutable)

────────────────────
_ do build-module-order ImmutableArray'U32'ArenaBacking
    - entry-module ModuleId
    - roots [U32]
    - declaring Bool
    - outgoing ModuleEdges

` The modules the entry module reaches, or each root of a batch in turn, in the order they
` initialize: each after the modules it imports, depth first, a module's imports of builtin
` modules before its others and each group in the order it is declared. Every other module
` imports the builtin modules first; a builtin module imports only what it declares. In the order
` TypeScript `declaring` declares them, an import that follows comes after the module that makes
` it.
. total = modules.length
. is-builtin = builtin-modules()
. visited = Array'Bool(scratch, total)
. reached = List'U32(scratch)
if roots
    for root in roots
        visit-module(root, declaring, is-builtin, outgoing, visited, reached)
else
    visit-module(entry-module, declaring, is-builtin, outgoing, visited, reached)
. order = Array'U32(module-arena, reached.length)
for position in 0 .. < reached.length
    order[position] = reached[position]
= order.immutable

────────────────────
_ do builtin-modules Array'Bool'ArenaBacking

` Which modules some import names as builtin.
. is-builtin = Array'Bool(scratch, modules.length)
for edge in 0 .. < edge-froms.length
    if edge-builtins[edge]
        is-builtin[edge-tos[edge]] = true
= is-builtin

────────────────────
_ do module-edges ModuleEdges

. total = modules.length
. edge-count = edge-froms.length
. starts = Array'U32(scratch, total + 1)
. fills = Array'U32(scratch, total + 1)
. edges = Array'U32(scratch, edge-count + 1)
for position in 0 .. < total + 1
    starts[position] = 0
for edge in 0 .. < edge-count
    starts[edge-froms[edge] + 1] += 1
for position in 0 .. < total
    starts[position + 1] += starts[position]
    fills[position] = starts[position]
for edge in 0 .. < edge-count
    . origin = edge-froms[edge]
    edges[fills[origin]] = edge as U32
    fills[origin] += 1
= ModuleEdges(starts, edges)

────────────────────
_ do build-batch-orders BatchOrders
    - roots [U32]
    - outgoing ModuleEdges

` The roots of a batch and the modules each reaches, in the order they initialize as though it
` were the entry module alone: those of a root lie from its start to the next root's. Each module
` has a word of bits for each 64 roots, a bit set for each root that reaches it.
. is-builtin = builtin-modules()
. reached = List'U32(scratch)
. root-ids = Array'U32(module-arena, roots.length)
. starts = Array'U32(module-arena, roots.length + 1)
for position in 0 .. < roots.length
    root-ids[position] = roots[position]
    starts[position] = reached.length as U32
    visit-module
        - roots[position]
        - false
        - is-builtin
        - outgoing
        - Array'Bool(scratch, modules.length)
        - reached
starts[roots.length] = reached.length as U32
. order = Array'U32(module-arena, reached.length)
for position in 0 .. < reached.length
    order[position] = reached[position]
. words = (roots.length + 63) / 64
. cases = Array'U64(module-arena, modules.length * words)
for position in 0 .. < modules.length * words
    cases[position] = 0
for root in 0 .. < roots.length
    for position in starts[root] .. < starts[root + 1]
        . place = (order[position as Size] as Size) * words + root / 64
        cases[place] = cases[place] /or/ (1u64 /lshift/ ((root % 64) as U64))
= BatchOrders(root-ids.immutable, starts.immutable, order.immutable, cases.immutable)

────────────────────
_ do build-feature-gates FeatureGates

. total = modules.length
. found = List'U32(scratch)
. starts = Array'U32(module-arena, total + 1)
for position in 0 .. < total
    starts[position] = found.length as U32
    scan-gates(modules[position].tree, found)
starts[total] = found.length as U32
. gates = Array'U32(module-arena, found.length)
for position in 0 .. < found.length
    gates[position] = found[position]
= FeatureGates(starts.immutable, gates.immutable)

────────────────────
_ do visit-module
    - module U32
    - declaring Bool
    - is-builtin Array'Bool'ArenaBacking
    - outgoing ModuleEdges
    - visited Array'Bool'ArenaBacking
    - reached List'U32'ArenaBacking

if visited[module]
    =
visited[module] = true
. first = outgoing.starts[module]
. last = outgoing.starts[module + 1]
for wants-builtin in [true, false]
    for position in first .. < last
        . edge = outgoing.edges[position]
        if is-builtin[edge-tos[edge]] != wants-builtin
            continue
        if edge-builtins[edge] && is-builtin[module]
            continue
        if declaring && edge-follows[edge]
            continue
        visit-module(edge-tos[edge], declaring, is-builtin, outgoing, visited, reached)
reached += module
if declaring
    for position in first .. < last
        . edge = outgoing.edges[position]
        if edge-follows[edge]
            visit-module(edge-tos[edge], declaring, is-builtin, outgoing, visited, reached)

────────────────────
_ do build-extension-index BuiltExtensionIndex
    - arena Arena
    - index BuiltNameIndex
    - ranks ImmutableArray'U16'ArenaBacking

. key-modules = List'U32(scratch)
. key-decls = List'U32(scratch)
. entry-keys = List'U32(scratch)
. entry-modules = List'U32(scratch)
. entry-decls = List'U32(scratch)
for position in 0 .. < modules.length
    . module = modules[position]
    . decl = 0u32
    for row in module.decls
        do match? row
            | .decl-extension(extension)
                . head = receiver-head(module.tree, extension.receiver)
                if head
                    . receiver = first-class-named(index, ranks, position as ModuleId, head)
                    if receiver
                        . key = extension-key(key-modules, key-decls, receiver)
                        entry-keys += key
                        entry-modules += position as U32
                        entry-decls += decl
        decl += 1

. key-count = key-modules.length
. entry-count = entry-keys.length
. counts = Array'U32(scratch, key-count)
. cursors = Array'U32(scratch, key-count)
. starts = Array'U32(arena, key-count + 1)
. sorted-modules = Array'U32(arena, entry-count)
. sorted-decls = Array'U32(arena, entry-count)
. stored-key-modules = Array'U32(arena, key-count)
. stored-key-decls = Array'U32(arena, key-count)
for key in 0 .. < key-count
    counts[key] = 0
    stored-key-modules[key] = key-modules[key]
    stored-key-decls[key] = key-decls[key]
for entry in 0 .. < entry-count
    counts[entry-keys[entry]] += 1
. sum Size = 0
for key in 0 .. < key-count
    starts[key] = sum as U32
    cursors[key] = sum as U32
    sum += counts[key]
starts[key-count] = sum as U32
for entry in 0 .. < entry-count
    . key = entry-keys[entry]
    . slot = cursors[key]
    sorted-modules[slot] = entry-modules[entry]
    sorted-decls[slot] = entry-decls[entry]
    cursors[key] = slot + 1
= BuiltExtensionIndex
    - stored-key-modules.immutable
    - stored-key-decls.immutable
    - starts.immutable
    - sorted-modules.immutable
    - sorted-decls.immutable

────────────────────
_ do extension-key U32
    - key-modules List'U32'ArenaBacking
    - key-decls List'U32'ArenaBacking
    - receiver Candidate

for key in 0 .. < key-modules.length
    if key-modules[key] == receiver.module && key-decls[key] == receiver.decl
        = key as U32
key-modules += receiver.module
key-decls += receiver.decl
= (key-modules.length - 1) as U32

────────────────────
_ do receiver-head Atom?
    - tree AST
    - id SyntaxId

do match? tree.nodes[id]
    | .node-type-identifier(row)
        = row.name
    | .node-type-arguments(row)
        = receiver-head(tree, row.base)
= null

────────────────────
_ do first-class-named Candidate?
    - index BuiltNameIndex
    - ranks ImmutableArray'U16'ArenaBacking
    - caller ModuleId
    - name Atom

. name-id = name-ids[name]
if !name-id
    = null
. total = modules.length
. begin = index.bucket-starts[name-id]
. end = index.bucket-starts[name-id + 1]
. best-key = Size.max
. best Candidate? = null
for entry in begin .. < end
    . entry-module = index.entry-modules[entry]
    . rank = ranks[caller * total + entry-module]
    if rank != U16.max
        . entry-decl = index.entry-decls[entry] as DeclId
        . is-class = match? modules[entry-module].decls[entry-decl]
            | .decl-class
                true
        if is-class
            . key = (((rank as Size) + 1) /lshift/ 32) /or/ (entry - begin)
            if key < best-key
                best-key = key
                best = Candidate(entry-module, entry-decl, rank)
= best

────────────────────
_ do build-name-index BuiltNameIndex
    - arena Arena

for index in 0 .. < modules.length
    collect-module-names(index)

. pair-count = pair-names.length
. counts = Array'U32(scratch, name-count)
. cursors = Array'U32(scratch, name-count)
. starts = Array'U32(arena, name-count + 1)
. entry-modules = Array'U32(arena, pair-count)
. entry-decls = Array'U32(arena, pair-count)

for index in 0 .. < name-count
    counts[index] = 0
for pair in 0 .. < pair-count
    . name-id = pair-names[pair]
    counts[name-id] += 1

. sum Size = 0
for index in 0 .. < name-count
    starts[index] = sum as U32
    cursors[index] = sum as U32
    sum += counts[index]
starts[name-count] = sum as U32

for pair in 0 .. < pair-count
    . name-id = pair-names[pair]
    . slot = cursors[name-id]
    entry-modules[slot] = pair-modules[pair]
    entry-decls[slot] = pair-decls[pair]
    cursors[name-id] = slot + 1

= BuiltNameIndex(starts.immutable, entry-modules.immutable, entry-decls.immutable)

────────────────────
_ do collect-module-names
    - index Index

. module = modules[index]
. tree = module.tree
for decl in 1 .. < module.decls.length
    do match? module.decls[decl]
        | .decl-function(row)
            if row.owner == 0 && row.name
                add-pair(row.name, index as ModuleId, decl as DeclId)
        | .decl-class(row)
            do
                add-pair(row.name, index as ModuleId, decl as DeclId)
                for offset in 0 .. < row.aliases.count
                    add-pair
                        - tree.atoms[row.aliases.start + offset]
                        - index as ModuleId
                        - decl as DeclId
        | .decl-property(row)
            if row.owner == 0 && row.name
                add-pair(row.name, index as ModuleId, decl as DeclId)
        | .decl-event(row)
            if row.owner == 0
                add-pair(row.name, index as ModuleId, decl as DeclId)

────────────────────
_ do add-pair
    - name Atom
    - module ModuleId
    - decl DeclId

?! Panic("ProgramBuilder name pair pool exceeds U32 capacity")
    if pair-names.length >= U32.max

. name-id = store-name(name)
pair-names += name-id as U32
pair-modules += module
pair-decls += decl

────────────────────
_ do store-name Index
    - atom Atom

?! Panic("ProgramBuilder name count exceeds U32 capacity")
    if name-count >= U32.max

. existing = name-ids[atom]
if existing
    = existing

. id = name-count
name-ids[atom] = id as U32
name-count += 1
= id

━━━━━━━━━━━━━━━━━━━━
_ ModuleJob

+ builder ModuleBuilder
+ tree AST
+ module Module?
+ transferred Bool
_ finished Bool
_ released Bool

────────────────────
+ This
    - builder ModuleBuilder
    - tree AST

────────────────────
+ do finish
    - atoms AtomPool
    - atom-lock Mutex

module = builder.finish(tree, atoms, atom-lock)
finished = true

────────────────────
+ do release

if !released
    if !finished
        tree.release()
    else if !transferred
        module!.release()
    builder.release()
    released = true

━━━━━━━━━━━━━━━━━━━━
_ BuiltExtensionIndex is Tuple

+ key-modules ImmutableArray'U32'ArenaBacking
+ key-decls ImmutableArray'U32'ArenaBacking
+ starts ImmutableArray'U32'ArenaBacking
+ entry-modules ImmutableArray'U32'ArenaBacking
+ entry-decls ImmutableArray'U32'ArenaBacking

━━━━━━━━━━━━━━━━━━━━
_ FeatureGates is Tuple

+ starts ImmutableArray'U32'ArenaBacking
+ gates ImmutableArray'U32'ArenaBacking

━━━━━━━━━━━━━━━━━━━━
_ BatchOrders is Tuple

` The roots of a batch, and the modules each initializes, those of a root from its start to the
` next one's, and for each module the bits of the roots that reach it.

+ roots ImmutableArray'U32'ArenaBacking
+ starts ImmutableArray'U32'ArenaBacking
+ modules ImmutableArray'U32'ArenaBacking
+ cases ImmutableArray'U64'ArenaBacking

━━━━━━━━━━━━━━━━━━━━
_ Listings is Tuple

` Where each module comes among those each module can name, as the reference lists them, where
` it first ends and where it last ends.

+ first ImmutableArray'U16'ArenaBacking
+ last ImmutableArray'U32'ArenaBacking

━━━━━━━━━━━━━━━━━━━━
_ ImportEdges is Tuple

` The imports of each module as ranking reads them: those of a module lie from its start to the
` next module's, the import made last first, each the module imported and whether it is exported.

+ starts Array'U32'ArenaBacking
+ targets Array'U32'ArenaBacking
+ exports Array'Bool'ArenaBacking

━━━━━━━━━━━━━━━━━━━━
_ ModuleEdges is Tuple

+ starts Array'U32'ArenaBacking
+ edges Array'U32'ArenaBacking

━━━━━━━━━━━━━━━━━━━━
_ BuiltNameIndex is Tuple

+ bucket-starts ImmutableArray'U32'ArenaBacking
+ entry-modules ImmutableArray'U32'ArenaBacking
+ entry-decls ImmutableArray'U32'ArenaBacking

━━━━━━━━━━━━━━━━━━━━
_ do scan-gates
    - tree AST
    - gates List'U32'ArenaBacking

for id in 0 .. < tree.nodes.length
    do match? tree.nodes[id]
        | .node-do-block(row)
            if row.feature-gate-features != CompilerFeature.none
                gates += id as U32
