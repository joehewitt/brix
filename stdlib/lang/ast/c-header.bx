(import ./c-header-snapshot)
(import /BxCHeaderScan/BxCHeaderScan.h)
(import /core/list)
(import /core/map)
(import /data)
(import /lang/constants)
(import /lang/runtime-config)
(import /lang/target)
(import /os/env)
(import /os/file)
(import /os/path)
(import /stream/sort)
(import /string.h)
(blank)
(prop + allowed-word-chars _ (= "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"))
(prop _ gc-leaf-suffix _ (= ",brix:gc_leaf"))
(prop _ gc-polling-suffix _ (= ",brix:gc_polling"))
(blank)
(prop + implicit-leaf-names List
  (block
    (item "abs")
    (item "labs")
    (item "llabs")
    (item "fabs")
    (item "fabsf")
    (item "floor")
    (item "floorf")
    (item "ceil")
    (item "ceilf")
    (item "round")
    (item "roundf")
    (item "trunc")
    (item "truncf")
    (item "fmod")
    (item "fmodf")
    (item "modf")
    (item "modff")
    (item "sqrt")
    (item "sqrtf")
    (item "cbrt")
    (item "cbrtf")
    (item "pow")
    (item "powf")
    (item "exp")
    (item "expf")
    (item "log")
    (item "logf")
    (item "log2")
    (item "log2f")
    (item "log10")
    (item "log10f")
    (item "sin")
    (item "sinf")
    (item "cos")
    (item "cosf")
    (item "tan")
    (item "tanf")
    (item "asin")
    (item "asinf")
    (item "acos")
    (item "acosf")
    (item "atan")
    (item "atanf")
    (item "atan2")
    (item "atan2f")
    (item "sinh")
    (item "cosh")
    (item "tanh")
    (item "hypot")
    (item "hypotf")
    (item "strtol")
    (item "strtoll")
    (item "strtoul")
    (item "strtoull")
    (item "strtod")
    (item "strtof")
    (item "strlen")
    (item "strcmp")
    (item "strncmp")
    (item "memcmp")
    (item "memchr")
  )
)
(blank)
(prop + host-c-headers CHeaders (:= (call target-c-headers (call host-target))))
(blank)
(prop + host-libclang (? String) (:= (call configured-libclang)))

(type + CHeaders (is Tuple)
  ; Where a target's C headers are read: the directory its C library's headers are in, and the
  ; arguments that point the scanner at them. Headers read from a snapshot are its records, in place
  ; of what scanning gives, and a recording keeps the records of each header scanned.
  (blank)
  (prop + target-name String)
  (prop + c-root Path)
  (prop + arguments (list String))
  (prop + snapshot (? CHeaderSnapshot) (= null))
  (prop + recording (? CHeaderSnapshot) (= null))
)

(fn-do + target-c-headers CHeaders (?! Error)
  (param target Target)
  ; A target whose entry in the runtime build config names a sysroot reads its headers there, parsed
  ; for its triple with the sysroot's GCC; the sysroot is installed with the target's runtime when it
  ; is missing. Every other target reads the default SDK's headers.
  (let entry (call target-config (call runtime-config) target))
  (let sysroot-name (call config-optional-string entry "sysroot"))
  (if (not sysroot-name)
    (return (call CHeaders (. target name) (/ sdk-root "usr/include") (list "-isysroot" (as sdk-root String))))
  )
  (let build-path (call target-build-path target entry))
  (let sysroot (call runtime-file sysroot-name build-path))
  (if (not (. sysroot exists))
    (call build-runtime target build-path)
  )
  (throw (call Error (str "The " (. target name) " sysroot is not at " sysroot)) (if (not (. sysroot exists))))
  (let gcc (/ sysroot (call config-string entry "gccInstallDirectory")))
  (let arguments
    (block
      (list "-target" (call config-string entry "triple") (str "--sysroot=" sysroot) (str "--gcc-install-dir=" gcc))
    )
  )
  (return (call CHeaders (. target name) (/ sysroot "usr/include") arguments))
)

(fn-do + c-header-source String
  (param headers CHeaders)
  (param include-paths (list Path))
  (param header String)
  (param wanted (map String Bool))
  (return (call c-records-source (call c-header-records headers include-paths header) wanted))
)

(fn-do + c-header-records String
  (param headers CHeaders)
  (param include-paths (list Path))
  (param header String)
  ; The records of `header`: the snapshot's when the headers are read from one, and otherwise the
  ; scanner's, from the cache while the files it read are unchanged.
  (let key (call snapshot-key (. headers c-root) include-paths header))
  (if (. headers snapshot)
    (let kept (call (. headers snapshot records) key))
    (throw (call Panic (str "The C header snapshot has no records of <" header ">")) (if (not kept)))
    (return kept)
  )
  (let cache (call scan-cache headers include-paths header))
  (let records (call cached-records cache))
  (if (not records)
    (= records (call scan-header headers include-paths header))
    (call store-records cache include-paths header records)
  )
  (if (and (. headers recording) key)
    (call (. headers recording keep) key (call recorded-records records include-paths))
  )
  (return records)
)

(fn-do + snapshot-key (? String)
  (param c-root Path)
  (param include-paths (list Path))
  (param header String)
  ; The name a snapshot keeps the records of `header` under, the same on every host: its path in the
  ; C library's headers under `c/`, or in the runtime's include paths under `runtime/`.
  (let library (str c-root "/"))
  (return-if (str "c/" ([] header (... (. library length)))) (if (call (. header starts-with) library)))
  (for (in include include-paths)
    (let root (str include "/"))
    (return-if (str "runtime/" ([] header (... (. root length)))) (if (call (. header starts-with) root)))
  )
  (return null)
)

(fn-do _ recorded-records String
  (param records String)
  (param include-paths (list Path))
  ; `records` as a snapshot keeps them, with the runtime's headers named as `snapshot-key` names
  ; them, not by where this host keeps them.
  (let recorded records)
  (for (in include include-paths)
    (= recorded (call (. ",runtime/" join) (call (. recorded split) (str "," include "/"))))
  )
  (return recorded)
)

(type + CHeaderFunction (is Tuple)
  ; A function a C header declares, with a key that every declaration of the same symbol shares where
  ; they agree on its linkage, type and annotations, or none where the scanner's records do not prove
  ; what the declaration is.
  (blank)
  (prop + name String)
  (prop + declaration-key (? String))
)

(fn-do + c-header-functions (list CHeaderFunction)
  (param headers CHeaders)
  (param include-paths (list Path))
  (param header String)
  (return (call c-records-functions (call c-header-records headers include-paths header)))
)

(fn-do + c-records-functions (list CHeaderFunction)
  (param records String)
  (let evidence (map String (list String)))
  (let annotations (map String (list String)))
  (let lines (list String) (call (. records split) "\n"))
  (for (in line lines)
    (let parts (list String) (call (. line split) ","))
    (if (< (. parts length) 5)
      (continue)
    )
    (let key (call (. "," join) ([] parts (..< 1 4))))
    (if (and (== ([] parts 0) "D") (== (. parts length) 5) (call (. ([] parts 4) starts-with) "v1:"))
      (let known (?? ([] evidence key) (call (of List String))))
      (+= known (call declared-identity ([] parts 4)))
      (= ([] evidence key) known)
    )
    (if (== ([] parts 0) "A")
      (let known (?? ([] annotations key) (call (of List String))))
      (for (in annotation ([] parts (... 4)))
        (if (== (call (. known find) annotation) null)
          (+= known annotation)
        )
      )
      (= ([] annotations key) known)
    )
  )
  (blank)
  (let functions (list CHeaderFunction))
  (for (in line lines)
    (let parts (list String) (call (. line split) ","))
    (if (or (< (. parts length) 5) (!= ([] parts 0) "F") (not (call is-c-identifier ([] parts 1))))
      (continue)
    )
    (let key (call (. "," join) ([] parts (..< 1 4))))
    (let found ([] evidence key))
    (let declaration-key (? String) null)
    (if (and (call (. ([] parts 2) starts-with) "/") (> (call Int ([] parts 3)) 0) found (== (. found length) 1))
      (let proof (list ([] parts 1) (call (. "," join) ([] parts (... 4))) ([] found 0)))
      (++= proof (call sort (?? ([] annotations key) (call (of List String)))))
      (= declaration-key (call (. "\n" join) proof))
    )
    (+= functions (call CHeaderFunction ([] parts 1) declaration-key))
  )
  (return functions)
)

(fn-expr _ declared-identity String
  (param evidence String)
  ; A declaration's evidence without the column and offset it is written at.
  (str "v1:" identity)
  (where
    (lazy identity (call (. ":" join) ([] fields (... 3))))
    (lazy fields (call List (call (. evidence split) ":")))
  )
)

(fn-do _ scan-header String
  (param headers CHeaders)
  (param include-paths (list Path))
  (param header String)
  (let arguments (list String))
  (++= arguments (. headers arguments))
  (for (in include include-paths)
    (+= arguments (str "-I" include))
  )
  (if host-libclang
    (call C:brixCHeaderScanUseLibclang host-libclang)
  )
  (let status I32)
  (let scanned (call C:brixCHeaderScan header "" (call (. "\n" join) arguments) &status))
  (throw (call Panic (str "Unable to scan the C header <" header ">")) (if (not scanned)))
  (let records (as scanned String))
  (call C:brixCHeaderScanFree scanned)
  (return records)
)

(fn-do _ configured-libclang (? String) (?! Error)
  ; The libclang that the host's entry in the runtime build config names, which the scanner loads in
  ; place of finding one itself.
  (let entry (call target-config (call runtime-config) (call host-target)))
  (let name (call config-optional-string entry "libclang"))
  (return-if null (if (not name)))
  (return (as (call runtime-file name (call target-build-path (call host-target) entry)) String))
)

(type + ScanCache (is Tuple)
  (prop + records Path)
  (prop + manifest Path)
)

(fn-do _ scan-cache ScanCache
  (param headers CHeaders)
  (param include-paths (list Path))
  (param header String)
  (let version (as (call C:brixCHeaderScanVersion) String))
  (let key (str "cheaderscan-" version "|" (. headers target-name)))
  (for (in argument (. headers arguments))
    (+= key (str "|" argument))
  )
  (for (in include include-paths)
    (+= key (str "|" include))
  )
  (+= key (str "|" header))
  (let root (/ (call Path (?? (call env "TMPDIR") "/tmp")) "brix" "cheaderscan"))
  (let base (/ root (str (call file-word header) "-" (call hash-for key))))
  (return (call ScanCache (call Path (str base ".records")) (call Path (str base ".manifest"))))
)

(fn-do _ file-word String
  (param text String)
  (let word "")
  (for (in char text)
    (let piece (str char))
    (+= word (if-expr (!= (call (. allowed-word-chars find) piece) null) piece "_"))
  )
  (return word)
)

(fn-do _ cached-records (? String)
  (param cache ScanCache)
  (let manifest (call read-text (. cache manifest)))
  (if (not manifest)
    (return null)
  )
  (let lines (list String) (call (. manifest split) "\n"))
  (if (< (. lines length) 2)
    (return null)
  )
  (let records (call read-text (. cache records)))
  (if (not records)
    (return null)
  )
  (if (!= (str (. records length)) ([] lines 0))
    (return null)
  )
  (for (in position (..< 1 (. lines length)))
    (let line ([] lines position))
    (if (== (. line length) 0)
      (continue)
    )
    (let parts (list String) (call (. line split) "|"))
    (if (!= (. parts length) 3)
      (return null)
    )
    (let stamped (call Path ([] parts 0)))
    (if (not (. stamped exists))
      (return null)
    )
    (let time (. stamped stat mtime))
    (if (or (!= (str (. time s)) ([] parts 1)) (!= (str (. time ns)) ([] parts 2)))
      (return null)
    )
  )
  (return records)
)

(fn-do _ store-records _
  (param cache ScanCache)
  (param include-paths (list Path))
  (param header String)
  (param records String)
  (if (or (call (. records starts-with) "M,") (!= (call (. records find) "\nM,") null))
    (return)
  )
  (let dir (. cache records dir))
  (if (not (. dir is-dir))
    (let parent (. dir dir))
    (if (not (. parent is-dir))
      (catch (call (. parent dir make-directory) (. parent name)))
    )
    (catch (call (. parent make-directory) (. dir name)))
  )
  (if (not (. dir is-dir))
    (return)
  )
  (let files (map String Bool))
  (let lines (list String) (call (. records split) "\n"))
  (for (in line lines)
    (if (not (call is-file-record line))
      (continue)
    )
    (let parts (list String) (call (. line split) ","))
    (if (and (> (. parts length) 2) (call (. ([] parts 2) starts-with) "/"))
      (= ([] files ([] parts 2)) true)
    )
  )
  (for (in include include-paths)
    (let candidate (/ include (call Path header)))
    (if (. candidate is-file)
      (= ([] files (str candidate)) true)
    )
  )
  (let manifest (str (. records length) "\n"))
  (for (in (tuple path listed) files)
    (let stamped (call Path path))
    (if (not (. stamped exists))
      (return)
    )
    (let time (. stamped stat mtime))
    (+= manifest (str path "|" (. time s) "|" (. time ns) "\n"))
  )
  (call write-text (. cache records) records)
  (call write-text (. cache manifest) manifest)
)

(fn-expr _ is-file-record Bool
  (param line String)
  (or (call (. line starts-with) "F,") (call (. line starts-with) "S,") (call (. line starts-with) "U,") (call (. line starts-with) "A,"))
)

(fn-do _ read-text (? String)
  (param path Path)
  (if (not (. path is-file))
    (return null)
  )
  (return (catch? (call read-file-text path)))
)

(fn-do _ write-text _
  (param path Path)
  (param text String)
  (let temp (call Path (str path ".tmp")))
  (let flags (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
  (let file (catch? (call File temp flags)))
  (if (not file)
    (return)
  )
  (catch (call (. file write) text))
  (catch (call (. file close)))
  (catch (call (. temp move) path))
)

(fn-do + c-records-source String
  (param records String)
  (param wanted (map String Bool))
  (let bytes (call byte-view records))
  (let data (as bytes (of CPointer Byte)))
  (let length (. bytes length))
  (let structs (map String String))
  (let leaves (map String Bool))
  (let polling (map String Bool))
  (for (in name implicit-leaf-names)
    (= ([] leaves name) true)
  )
  (let functions (list String))
  (let constants (list String))
  (let declared (map String Bool))
  (let base (. (as data Pointer) address))
  (let line-start Index)
  (while (< line-start length)
    (let line-end Index length)
    (let newline (call C:memchr (+ data line-start) 10 (- length line-start)))
    (if newline
      (= line-end (as (- (. (as newline Pointer) address) base) Index))
    )
    (let kind ([] data line-start))
    (if (== kind 70)
      (let found (call record-name bytes line-start line-end))
      (if (and found ([] wanted found))
        (+= functions (call (. bytes slice-string) (..< line-start line-end)))
      )
      (else-if (== kind 75)
        (let constant (call record-name bytes line-start line-end))
        (if (and constant ([] wanted constant) (not ([] declared constant)))
          (= ([] declared constant) true)
          (let parts (list String) (call (. (call (. bytes slice-string) (..< line-start line-end)) split) ","))
          (+= constants (str "(prop + C:" constant " _ (= " ([] parts (- (. parts length) 1)) "))"))
        )
      )
      (else-if (or (== kind 83) (== kind 85))
        (let struct-name (call record-name bytes line-start line-end))
        (if struct-name
          (= ([] structs struct-name) (call (. bytes slice-string) (..< line-start line-end)))
        )
      )
      (else-if (and (== kind 65) (call record-line-ends-with bytes line-start line-end gc-leaf-suffix))
        (let leaf (call record-name bytes line-start line-end))
        (if leaf
          (= ([] leaves leaf) true)
        )
      )
      (else-if (and (== kind 65) (call record-line-ends-with bytes line-start line-end gc-polling-suffix))
        (let polled (call record-name bytes line-start line-end))
        (if polled
          (= ([] polling polled) true)
        )
      )
    )
    (= line-start (+ line-end 1))
  )
  (let out (list String))
  (++= out constants)
  (let written (map String Bool))
  (for (in line functions)
    (call append-function-source line structs leaves polling written out)
  )
  (return (str (call (. "\n" join) out) "\n"))
)

(fn-do _ append-function-source _
  (param line String)
  (param structs (map String String))
  (param leaves (map String Bool))
  (param polling (map String Bool))
  (param written (map String Bool))
  (param out (list String))
  ; Writes the declaration of one function a header declares. A header read as C++ declares a
  ; function once for each C type it overloads it by, and two of those can be one type here:
  ; `abs` of a `long` and of a `long long`. The declaration is written once.
  (let parts (list String) (call (. line split) ","))
  (if (< (. parts length) 5)
    (return)
  )
  (let name ([] parts 1))
  (if (not (call is-c-identifier name))
    (return)
  )
  (let returned (call c-type-text ([] parts 4) structs))
  (if (not returned)
    (return)
  )
  (let args (list String))
  (for (in position (..< 5 (. parts length)))
    (let part ([] parts position))
    (if (== part "...")
      (return)
    )
    (let arg (call argument-text part (str "a" (- position 5)) structs))
    (if (not arg)
      (return)
    )
    (+= args (str "  " arg))
  )
  (let head (str "(fn-do + C:" name " " (if-expr (!= returned "Void") returned "_")))
  (let signature (str head "\n" (call (. "\n" join) args)))
  (if (== ([] written signature) true)
    (return)
  )
  (= ([] written signature) true)
  (let annotated (if-expr (== ([] polling name) true) (++ head " (without blocking)") head))
  (+= out (if-expr (== ([] leaves name) true) (++ head " (without gc)") annotated))
  (++= out args)
  (+= out ")")
)

(fn-do _ argument-text (? String)
  (param part String)
  (param name String)
  (param structs (map String String))
  ; The declaration of one argument, or none where its type does not map. A pointer to a C function
  ; is the C function type of what it returns and what it takes; one that takes any number of
  ; arguments is a plain pointer.
  (let trimmed (call (. part trim)))
  (if (or (not (call (. trimmed starts-with) "fnptr(")) (not (call (. trimmed ends-with) ")")))
    (let mapped (call c-type-text part structs))
    (if (not mapped)
      (return null)
    )
    (return (str "(param " name " " mapped ")"))
  )
  (let pieces (call top-level-parts ([] trimmed (..< 6 (- (. trimmed length) 1)))))
  (if (== (. pieces length) 0)
    (return null)
  )
  (if (== ([] pieces (- (. pieces length) 1)) "...")
    (return (str "(param " name " Pointer)"))
  )
  (let returned (call c-type-text ([] pieces 0) structs))
  (if (not returned)
    (return null)
  )
  (let type (str "(c-fn-type " returned))
  (for (in position (..< 1 (. pieces length)))
    (let inner (call argument-text ([] pieces position) (str "a" (- position 1)) structs))
    (if (not inner)
      (return null)
    )
    (+= type (str " " inner))
  )
  (return (str "(param " name " " type "))"))
)

(fn-do _ top-level-parts (list String)
  (param text String)
  ; The parts of a function pointer record, split at the semicolons outside any nested record.
  (let parts (list String))
  (let piece "")
  (let depth 0)
  (for (in char text)
    (if (== char (char "("))
      (+= depth 1)
      (else-if (== char (char ")"))
        (-= depth 1)
      )
    )
    (if (and (== char (char ";")) (== depth 0))
      (+= parts piece)
      (= piece "")
      (else
        (+= piece char)
      )
    )
  )
  (if (!= (. piece length) 0)
    (+= parts piece)
  )
  (return parts)
)

(fn-do _ record-name (? String)
  (param bytes (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (let data (as bytes (of CPointer Byte)))
  (if (or (< (- end start) 3) (!= ([] data (+ start 1)) 44))
    (return null)
  )
  (let cursor (+ start 2))
  (while (and (< cursor end) (!= ([] data cursor) 44))
    (+= cursor 1)
  )
  (if (== cursor end)
    (return null)
  )
  (return (call (. bytes slice-string) (..< (+ start 2) cursor)))
)

(fn-do _ record-line-ends-with Bool
  (param bytes (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (param suffix String)
  (let suffix-bytes (call byte-view suffix))
  (if (< (- end start) (. suffix-bytes length))
    (return false)
  )
  (let offset (- end (. suffix-bytes length)))
  (for (in index (..< 0 (. suffix-bytes length)))
    (if (!= ([] bytes (+ offset index)) ([] suffix-bytes index))
      (return false)
    )
  )
  (return true)
)

(fn-do _ is-c-identifier Bool
  (param name String)
  (if (or (== (. name length) 0) (call (. name starts-with) "operator"))
    (return false)
  )
  (for (in forbidden (list ":" "<" "~" " "))
    (if (!= (call (. name find) forbidden) null)
      (return false)
    )
  )
  (return true)
)

(fn-do _ c-struct-text (? String)
  (param record String)
  (param structs (map String String))
  ; A struct passed by value is the struct of its fields; a union, or a field with no mapped
  ; type, leaves the function that takes it undeclared.
  (let parts (list String) (call (. record split) ","))
  (if (or (< (. parts length) 6) (!= ([] parts 0) "S"))
    (return null)
  )
  (let fields (list String))
  (let position 4)
  (while (< (+ position 1) (. parts length))
    (let mapped (call c-type-text ([] parts (+ position 1)) structs))
    (if (or (not mapped) (not (call is-c-identifier ([] parts position))))
      (return null)
    )
    (+= fields (str "(: " ([] parts position) " " mapped ")"))
    (+= position 2)
  )
  (return (str "(c-struct " (call (. " " join) fields) ")"))
)

(fn-do _ c-type-text (? String)
  (param text String)
  (param structs (map String String))
  (let trimmed (call (. text trim)))
  (if (call (. trimmed starts-with) "const ")
    (= trimmed (call (. ([] trimmed (... 6)) trim)))
  )
  (if (call (. trimmed starts-with) "fnptr(")
    (return "Pointer")
  )
  (let pointers 0)
  (while (call (. trimmed ends-with) "*")
    (= trimmed (call (. ([] trimmed (... _ (- (. trimmed length) 1))) trim)))
    (+= pointers 1)
  )
  (if (== (. trimmed length) 0)
    (return null)
  )
  (let record ([] structs trimmed))
  (if (and (!= record null) (== pointers 0))
    (return (call c-struct-text record structs))
  )
  (let remaining pointers)
  (while (>= remaining 0)
    (let key trimmed)
    (for (in _ (..< 0 remaining))
      (+= key "*")
    )
    (let mapped (call c-type-name key))
    (if mapped
      (return (call pointer-wrapped mapped (- pointers remaining)))
    )
    (-= remaining 1)
  )
  (return (call pointer-wrapped "I8" 1))
)

(fn-expr _ pointer-wrapped String
  (param name String)
  (param pointers Int)
  (case? (<= pointers 0)
    name
  )
  (case? (== pointers 1)
    (str "(of CPointer " name ")")
  )
  (default
    (str "(of CPointer " (call pointer-wrapped name (- pointers 1)) ")")
  )
)

(fn-expr _ c-type-name (? String)
  (param key String)
  (match? key
    (case= "void"
      "Void"
    )
    (case= "bool"
      "Bool"
    )
    (case= "char"
      "Char8"
    )
    (case= "signed char"
      "I8"
    )
    (case= "unsigned char"
      "U8"
    )
    (case= "wchar_t"
      "I32"
    )
    (case= "short"
      "I16"
    )
    (case= "unsigned short"
      "U16"
    )
    (case= "int"
      "I32"
    )
    (case= "unsigned int"
      "U32"
    )
    (case= "long"
      "I64"
    )
    (case= "unsigned long"
      "U64"
    )
    (case= "long long"
      "I64"
    )
    (case= "unsigned long long"
      "U64"
    )
    (case= "float"
      "F32"
    )
    (case= "double"
      "F64"
    )
    (case= "long double"
      "F128"
    )
    (case= "string"
      "String"
    )
    (case= "BrixStringData*"
      "String"
    )
    (case= "struct BrixStringData*"
      "String"
    )
    (case= "size_t"
      "Size"
    )
    (case= "time_t"
      "I64"
    )
  )
)
