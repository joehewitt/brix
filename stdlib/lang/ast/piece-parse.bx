(import ./ast-builder)
(import ./ast-nodes)
(import ./ast-rebase)
(import ./error)
(import ./grammar)
(import ./grammar-helpers)
(import ./preparse)
(import ./row-range)
(import /core/arena)
(import /core/array-builder)
(import /core/atom-pool)
(import /core/parsing)
(blank)
(prop _ default-piece-length Size (= 65536))

(fn-do + parse-yumi-in-pieces ASTBuilder (?! YumiSyntaxError)
  (param source String)
  (param source-path String)
  (param scratch Arena)
  (param pool Worker)
  (param atoms AtomPool)
  (param atom-lock Mutex)
  (param piece-length Size (= default-piece-length))
  (let dividers (list PreparseDivider))
  (let preparsed (call preparse source scratch dividers))
  (let plan (call plan-pieces preparsed dividers piece-length))
  (if (> (. plan pieces length) 1)
    (let merged (call parse-pieces preparsed source source-path plan scratch pool atoms atom-lock))
    (return-if merged (if merged))
  )
  (return (call parse-yumi-preparsed preparsed source source-path scratch))
)

(type _ PieceKind (is U8)
  (variant statements-piece)
  (variant class-head-piece)
  (variant members-piece)
  (variant class-end-piece)
)

(type _ PieceSpan (is Tuple)
  (prop + kind PieceKind)
  (prop + start Index)
  (prop + end Index)
  (prop + lines U32)
  (prop + class-location MatchLocation (= (call MatchLocation)))
)

(type _ PiecePlan (is Tuple)
  (prop + pieces (list PieceSpan))
  (prop + end TokenLocation)
)

(type _ ParsedPiece (is Tuple)
  (prop + index Index)
  (prop + tree (? ASTBuilder))
  (prop + piece (? YumiPiece))
)

(fn-do _ plan-pieces PiecePlan
  (param preparsed ([] Char))
  (param dividers (list PreparseDivider))
  (param piece-length Size)
  (let pieces (list PieceSpan))
  (return-if (call PiecePlan pieces (call TokenLocation 0 0)) (if (< (. preparsed size) (* piece-length 2))))
  (let starts (list Index))
  (+= starts 0)
  (for (in offset (..< 0 (. preparsed size)))
    (let char ([] preparsed offset))
    (if (== char (char "\n"))
      (+= starts (+ offset 1))
      (else-if (== char (char "\r"))
        (return (call PiecePlan pieces (call TokenLocation 0 0)))
      )
    )
  )
  (blank)
  (let size (. preparsed size))
  (let last (- (. starts length) 1))
  (let start Index 0)
  (let start-line Index 0)
  (let position Index 0)
  (while (< position (. dividers length))
    (let divider ([] dividers position))
    (+= position 1)
    (if (not (. divider thick))
      (continue)
    )
    (let section-line (. divider line))
    (let section-start ([] starts section-line))
    (let next position)
    (while (and (< next (. dividers length)) (not (. ([] dividers next) thick)))
      (+= next 1)
    )
    (let end-line (if-expr (< next (. dividers length)) (. ([] dividers next) line) last))
    (let section-end ([] starts end-line))
    (if (> (- section-end section-start) piece-length)
      (let cuts
        (call class-cuts
          (block
            (arg preparsed)
            (arg starts)
            (arg dividers)
            (arg position)
            (arg next)
            (arg section-line)
            (arg end-line)
            (arg piece-length)
          )
        )
      )
      (if (!= (. cuts length) 0)
        (if (> section-start start)
          (+= pieces (call PieceSpan .statements-piece start section-start (as start-line U32)))
        )
        (call add-class-pieces pieces starts cuts section-line end-line)
        (= start section-end)
        (= start-line end-line)
        (= position next)
        (continue)
      )
    )
    (if (>= (- section-start start) piece-length)
      (+= pieces (call PieceSpan .statements-piece start section-start (as start-line U32)))
      (= start section-start)
      (= start-line section-line)
    )
  )
  (if (< start size)
    (+= pieces (call PieceSpan .statements-piece start size (as start-line U32)))
  )
  (return (call PiecePlan pieces (call TokenLocation (as (- last 1) U32) (as (- size 1 ([] starts (- last 1))) U32))))
)

(fn-do _ class-cuts (list Index)
  (param preparsed ([] Char))
  (param starts (list Index))
  (param dividers (list PreparseDivider))
  (param first Index)
  (param limit Index)
  (param section-line Index)
  (param end-line Index)
  (param piece-length Size)
  (let cuts (list Index))
  (return-if cuts (if (== section-line 0)))
  (let section-start ([] starts section-line))
  (let close (- ([] starts end-line) 2))
  (return-if cuts (if (or (!= ([] preparsed section-start) (char "≤")) (!= ([] preparsed (+ section-start 1)) (char "\n")))))
  (return-if cuts (if (not (call is-class-line preparsed (+ section-start 2)))))
  (return-if cuts (if (or (!= ([] preparsed close) (char "≥")) (!= ([] preparsed (- close 1)) (char "≥")) (!= ([] preparsed (+ close 1)) (char "\n")))))
  (let start section-start)
  (for (in position (..< first limit))
    (let offset ([] starts (. ([] dividers position) line)))
    (if (and (>= (- offset start) piece-length) (>= (- close offset) (/ piece-length 2)))
      (+= cuts (. ([] dividers position) line))
      (= start offset)
    )
  )
  (return cuts)
)

(fn-expr _ is-class-line Bool
  (param preparsed ([] Char))
  (param offset Index)
  (scope (and has-room (or (== lead '+') (== lead '_')) has-space (>= initial 'A') (<= initial 'Z'))
    (lazy lead ([] preparsed offset))
    (lazy initial ([] preparsed (+ offset 2)))
    (lazy has-room (< (+ offset 2) (. preparsed size)))
    (lazy has-space (== ([] preparsed (+ offset 1)) (char " ")))
  )
)

(fn-do _ add-class-pieces _
  (param pieces (list PieceSpan))
  (param starts (list Index))
  (param cuts (list Index))
  (param section-line Index)
  (param end-line Index)
  (let close (- ([] starts end-line) 2))
  (let close-line (- end-line 1))
  (let location
    (call MatchLocation
      (block
        (arg (call TokenLocation (as section-line U32) 0))
        (arg (call TokenLocation (as close-line U32) (as (- close ([] starts close-line)) U32)))
      )
    )
  )
  (+= pieces
    (call PieceSpan
      (block
        (arg .class-head-piece)
        (arg ([] starts section-line))
        (arg ([] starts ([] cuts 0)))
        (arg (as (- section-line 1) U32))
      )
    )
  )
  (for (in index (..< 0 (. cuts length)))
    (let line ([] cuts index))
    (if (< (+ index 1) (. cuts length))
      (+= pieces
        (call PieceSpan
          (block
            (arg .members-piece)
            (arg ([] starts line))
            (arg ([] starts ([] cuts (+ index 1))))
            (arg (as (- line 1) U32))
          )
        )
      )
      (else
        (+= pieces (call PieceSpan .class-end-piece ([] starts line) close (as (- line 1) U32) location))
      )
    )
  )
)

(fn-do _ parse-pieces (? ASTBuilder)
  (param preparsed ([] Char))
  (param source String)
  (param source-path String)
  (param plan PiecePlan)
  (param scratch Arena)
  (param pool Worker)
  (param atoms AtomPool)
  (param atom-lock Mutex)
  (let count (. plan pieces length))
  (let results (of SyncBufferedChannel ParsedPiece))
  (let group (call TaskGroup))
  (for (in index (..< 0 count))
    (let span ([] (. plan pieces) index))
    (let task
      (do-new (worker: pool)
        (<- results (call parse-piece preparsed source source-path span index atoms atom-lock))
        (on-failure failed
          (call (. group keep) failed)
          (<- results (call ParsedPiece index null null))
        )
      )
    )
    (call (. group add) task)
  )
  (let slots (list (? ParsedPiece)))
  (for (in _ (..< 0 count))
    (+= slots null)
  )
  (let merge (call PieceMerge plan scratch))
  (let failed false)
  (for (in _ (..< 0 count))
    (let result (!! (<- results)))
    (= ([] slots (. result index)) result)
    (= failed (or failed (not (. result tree))))
    (while (and (not failed) (< (. merge next) count) ([] slots (. merge next)))
      (let ready (!! ([] slots (. merge next))))
      (= ([] slots (. merge next)) null)
      (call (. merge take) ready)
    )
  )
  (if failed
    (call (. merge release))
    (for (in slot slots)
      (if (and slot (. slot tree))
        (call (. slot tree release))
      )
    )
    (call (. group wait))
    (return null)
  )
  (let merged (catch (call (. merge finish))))
  (return-if null (if (is merged Error)))
  (return (as merged ASTBuilder))
)

(fn-do _ parse-piece ParsedPiece
  (param preparsed ([] Char))
  (param source String)
  (param source-path String)
  (param span PieceSpan)
  (param index Index)
  (param atoms AtomPool)
  (param atom-lock Mutex)
  (let tree
    (scope (if-expr (== index 0) (call ASTBuilder source source-path) blank-tree)
      (lazy blank-tree (call ASTBuilder "" source-path (- (. span end) (. span start))))
    )
  )
  (let scratch (use (call Arena)))
  (let parsed (catch (call parse-yumi-piece (call piece-buffer preparsed span) scratch tree)))
  (if (is parsed Error)
    (call (. tree release))
    (return (call ParsedPiece index null null))
  )
  (let piece (as parsed YumiPiece))
  (call (. tree share-program-atoms) atoms atom-lock)
  (return
    (call ParsedPiece
      (block
        (arg index)
        (arg tree)
        (arg (call YumiPiece (. piece location) (. piece items) (call shared-header atoms atom-lock (. piece header))))
      )
    )
  )
)

(fn-do _ piece-buffer ([] Char)
  (param preparsed ([] Char))
  (param span PieceSpan)
  (let length (- (. span end) (. span start)))
  (return-if ([] preparsed (..< (. span start) (. span end))) (if (== (. span kind) .statements-piece)))
  (let ending (if-expr (== (. span kind) .class-end-piece) 1 0))
  (let buffer ([] Char (+ length 2 ending)))
  (= ([] buffer 0) (if-expr (== (. span kind) .class-head-piece) (char "﷑") (char "﷒")))
  (= ([] buffer 1) (char "\n"))
  (= ([] buffer (..< 2 (+ 2 length))) ([] preparsed (..< (. span start) (. span end))))
  (if (!= ending 0)
    (= ([] buffer (+ length 2)) (char "\n"))
  )
  (return buffer)
)

(fn-do _ shared-header (? ClassHeader)
  (param atoms AtomPool)
  (param atom-lock Mutex)
  (param header (? ClassHeader))
  (return-if null (if (not header)))
  (let found header)
  (use atom-lock)
  (let name (call (. atoms store) (. found name text)))
  (let aliases (only-if (call shared-atoms (. found aliases) atoms) (if (. found aliases))))
  (return
    (call ClassHeader
      (block
        (arg (. found location))
        (arg (. found access))
        (arg name)
        (arg (. found type-args))
        (arg aliases)
        (arg (. found inherits))
        (arg (. found header))
        (arg (. found facet-of))
      )
    )
  )
)

(fn-do _ shared-atoms (of ImmutableArray Atom)
  (param names (of ImmutableArray Atom))
  (param atoms AtomPool)
  (let shared (call (of ArrayBuilder Atom)))
  (for (in name names)
    (call (. shared append) (call (. atoms store) (. name text)))
  )
  (return (call (. shared finish-immutable)))
)

(type _ PieceMerge
  (prop + next Index)
  (prop _ plan PiecePlan)
  (prop _ scratch Arena)
  (prop _ tree (? ASTBuilder))
  (prop _ top _ (= (call (of ArrayBuilder SyntaxId))))
  (prop _ header (? ClassHeader))
  (prop _ members _ (= (call (of ArrayBuilder SyntaxId))))
  (fn-do + This _
    (param plan PiecePlan)
    (param scratch Arena)
  )
  (fn-do + take _
    (param parsed ParsedPiece)
    (let piece (!! (. parsed piece)))
    (let span ([] (. plan pieces) next))
    (+= next 1)
    (if (not tree)
      (let first (!! (. parsed tree)))
      (= (. first pattern-collector-context) scratch)
      (= tree first)
      (for (in item (. piece items))
        (call (. top append) item)
      )
      (return)
    )
    (let merged tree)
    (let piece-tree (!! (. parsed tree)))
    (let shift (call (. merged append-piece) piece-tree (. span lines)))
    (call (. piece-tree release))
    (if (== (. span kind) .class-head-piece)
      (= header (call shifted-header (!! (. piece header)) shift))
      (= members (call (of ArrayBuilder SyntaxId)))
    )
    (for (in item (. piece items))
      (if (== (. span kind) .statements-piece)
        (call (. top append) (call (. shift node) item))
        (else
          (call (. members append) (call (. shift node) item))
        )
      )
    )
    (if (== (. span kind) .class-end-piece)
      (call (. top append)
        (block
          (arg (call make-class-declaration merged (. span class-location) (!! header) (call (. members finish-immutable))))
        )
      )
    )
  )
  (fn-do + finish ASTBuilder (?! YumiSyntaxError)
    (let merged (!! tree))
    (let succeeded false)
    (finally
      (= (. merged pattern-collector-context) (. merged storage-arena))
      (if (not succeeded)
        (call (. merged release))
      )
    )
    (let statements (call link-statements merged (call (. top finish-immutable))))
    (let root
      (call (. merged append)
        (block
          (arg (call ASTTopLevel (call MatchLocation (call TokenLocation 0 0) (. plan end)) (call (. merged store-children) statements)))
        )
      )
    )
    (call (. merged name-closures))
    (call (. merged finalize-syntax))
    (= (. merged root) root)
    (call (. scratch reset))
    (= succeeded true)
    (return merged)
  )
  (fn-do + release _
    (if tree
      (call (. tree release))
    )
  )
)

(fn-expr _ shifted-header ClassHeader
  (param header ClassHeader)
  (param shift SyntaxShift)
  (call ClassHeader
    (block
      (arg (call (. shift location) (. header location)))
      (arg (. header access))
      (arg (. header name))
      (arg (call shifted-ids (. header type-args) shift))
      (arg (. header aliases))
      (arg inherits)
      (arg variants)
      (arg (call (. shift node) (. header facet-of)))
    )
  )
  (where
    (lazy inherits (only-if (call shifted-ids (. header inherits) shift) (if (. header inherits))))
    (lazy variants (only-if (call shifted-variants (. header header) shift) (if (. header header))))
  )
)

(fn-do _ shifted-ids (of ImmutableArray SyntaxId)
  (param ids (of ImmutableArray SyntaxId))
  (param shift SyntaxShift)
  (let shifted (call (of ArrayBuilder SyntaxId)))
  (for (in id ids)
    (call (. shifted append) (call (. shift node) id))
  )
  (return (call (. shifted finish-immutable)))
)

(fn-do _ shifted-variants (of ImmutableArray ArgumentVariant)
  (param variants (of ImmutableArray ArgumentVariant))
  (param shift SyntaxShift)
  (let shifted (call (of ArrayBuilder ArgumentVariant)))
  (for (in variant variants)
    (call (. shifted append) (call shifted-variant variant shift))
  )
  (return (call (. shifted finish-immutable)))
)

(fn-expr _ shifted-variant ArgumentVariant
  (param variant ArgumentVariant)
  (param shift SyntaxShift)
  (match variant
    (case (call .param-constraint value)
      (call .param-constraint (call (. shift node) value))
    )
    (case (call .param-assignment value)
      (call .param-assignment (call (. shift node) value))
    )
    (case (call .argument-decl value)
      (call .argument-decl (call (. shift node) value))
    )
    (case (call .implements-declaration value)
      (call .implements-declaration (call (. shift node) value))
    )
    (case (call .using-declaration value)
      (call .using-declaration (call (. shift node) value))
    )
    (case (call .sees-declaration value)
      (call .sees-declaration (call (. shift node) value))
    )
    (case (call .iterator-header location loop)
      (call .iterator-header (call (. shift location) location) (call (. shift node) loop))
    )
  )
)
