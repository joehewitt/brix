(import ./ast-builder)
(import ./ast-nodes)
(import ./error)
(import ./grammar-helpers)
(import ./operator)
(import ./preparse)
(import ./row-range)
(import ./syntax-advice)
(import /core/arena)
(import /core/parsing)
(import /stream/aggregate)

(fn-do + parse-yumi _
  (param source String)
  (param source-path _ (= ""))
  (let scratch (use (call Arena)))
  (return (call parse-yumi source source-path scratch))
)

(fn-expr + parse-yumi _
  (param source String)
  (param source-path String)
  (param scratch Arena)
  (call parse-yumi-preparsed preparsed source source-path scratch)
  (where
    (lazy preparsed (call preparse source scratch))
  )
)

(fn-expr + parse-yumi-preparsed _
  (param preparsed ([] Char))
  (param source String)
  (param source-path String)
  (param scratch Arena)
  (call parse-yumi-preparsed-with preparsed source source-path scratch tree tree)
  (where
    (lazy tree (call ASTBuilder source source-path))
  )
)

(fn-do + (of parse-yumi-preparsed-with Context) ASTBuilder
  (param preparsed ([] Char))
  (param source String)
  (param source-path String)
  (param scratch Arena)
  (param tree ASTBuilder)
  (param context Context)
  (constraint is Context (of PatternRollback ASTBuilderMark))
  (return
    (call parse-tree preparsed source source-path scratch tree context
      (block
        (on-error (: error YumiSyntaxError)
          (call (. error attach-source) source source-path)
          (throw error)
        )
      )
    )
  )
)

(fn-do _ (of parse-tree Context) ASTBuilder
  (param preparsed ([] Char))
  (param source String)
  (param source-path String)
  (param scratch Arena)
  (param tree ASTBuilder)
  (param context Context)
  (constraint is Context (of PatternRollback ASTBuilderMark))
  (finally
    (call (. scratch reset))
  )
  (= (. tree pattern-collector-context) scratch)
  (finally
    (= (. tree pattern-collector-context) (. tree storage-arena))
  )
  (let succeeded false)
  (finally
    (if (not succeeded)
      (call (. tree release))
    )
  )
  (blank)
  (let piece
    (match preparsed
      (with context)
      (~ (: parsed (call \yumi-grammar tree))
        parsed
      )
      (throw (call YumiSyntaxError (call MatchLocation location location) (call syntax-advice source location) source source-path))
    )
  )
  (blank)
  (let root
    (call (. tree append)
      (block
        (arg (call ASTTopLevel (. piece location) (call (. tree store-children) (call link-statements tree (. piece items)))))
      )
    )
  )
  (call (. tree name-closures))
  (call (. tree finalize-syntax))
  (= succeeded true)
  (= (. tree root) root)
  (return tree)
)

(fn-do + parse-yumi-piece YumiPiece (?! YumiSyntaxError)
  (param buffer ([] Char))
  (param scratch Arena)
  (param tree ASTBuilder)
  (finally
    (call (. scratch reset))
  )
  (= (. tree pattern-collector-context) scratch)
  (finally
    (= (. tree pattern-collector-context) (. tree storage-arena))
  )
  (blank)
  (let piece
    (match buffer
      (with tree)
      (~ (: parsed (call \yumi-grammar tree))
        parsed
      )
      (throw (call YumiSyntaxError (call MatchLocation location location) "Syntax error"))
    )
  )
  (return (call detached-piece piece))
)

(fn-expr + yumi-grammar YumiPiece (over: Char) (?! YumiSyntaxError)
  (param tree ASTBuilder)
  (~ (seq "﷑" \nl \open \nl (: header \class-line) (: body (? \class-body)))
    (call YumiPiece location (?? body (call (of ImmutableArray SyntaxId))) header)
  )
  (~ (seq "﷒" \nl (: items \members))
    (call YumiPiece location items)
  )
  (~ (seq / (: v \statements) /)
    (call YumiPiece location v)
  )
  (where
    (lazy open
      (pattern
        (~ "{")
        (~ "≤")
      )
    )
    (blank)
    (lazy open-string
      (pattern
        (~ "Æ")
      )
    )
    (blank)
    (lazy open-header
      (pattern
        (~ "═")
      )
    )
    (blank)
    (lazy close
      (pattern
        (~ "}")
        (~ "≥")
      )
    )
    (blank)
    (lazy statements (of ImmutableArray SyntaxId)
      (pattern
        (~ (seq (* \nl) (: lines (* \statement-line)) / (? \nl))
          (call true-optionals tree lines)
        )
      )
    )
    (blank)
    (lazy statement-line (? SyntaxId)
      (pattern
        (~ (seq / (: s \statement) / (| \nl (& \close)))
          s
        )
        (~ (seq / \nl)
          null
        )
      )
    )
    (blank)
    (lazy block SyntaxId
      (pattern
        (~ \indented-block-expression)
        (~ \inline-block-expression)
      )
    )
    (blank)
    (lazy indented-block-expression SyntaxId
      (pattern
        (~ (seq \open (: s \statements) / \close)
          (call located-block tree location (call block-with-statements tree s))
        )
      )
    )
    (blank)
    (lazy inline-block-expression SyntaxId
      (pattern
        (~ (seq ":" / (: expr \print-block))
          expr
        )
        (~ (seq ":" / (: expr \multi-line-expression))
          expr
        )
      )
    )
    (blank)
    (lazy block-statements SyntaxId
      (pattern
        (~ (seq (* \nl) (: lines (+ \statement-line)) / (? \nl))
          (call block-with-statements tree (call true-optionals tree lines))
        )
      )
    )
    (blank)
    (lazy block-or-expression SyntaxId
      (pattern
        (~ (seq // (: expr \multi-line-expression))
          expr
        )
        (~ (seq / (: b \block))
          b
        )
      )
    )
    (blank)
    (lazy block-or-expression-no-prep SyntaxId
      (pattern
        (~ (seq // (: expr \multi-line-expression-no-prep))
          expr
        )
        (~ (seq / (: b \block))
          b
        )
      )
    )
    (blank)
    (lazy block-or-inline-expression SyntaxId
      (pattern
        (~ (seq // (: expr \print-block))
          expr
        )
        (~ (seq // (: expr \inline-expression))
          expr
        )
        (~ (seq / (: b \block))
          b
        )
      )
    )
    (blank)
    (lazy statement SyntaxId
      (pattern
        (~ \import-statement)
        (~ \string-block)
        (~ \header-block)
        (~ \extension-block)
        (~ \style-sheet-extension-block)
        (~ \style-sheet-block)
        (~ \c-constant-declaration)
        (~ \effect-declaration)
        (~ \class-block)
        (~ \function-block)
        (~ \state-machine-declaration)
        (~ \property-declaration)
        (~ \unit-declaration)
        (~ \if-block)
        (~ \while-block)
        (~ \style-when-statement)
        (~ \for-block)
        (~ \do-block)
        (~ \return-statement)
        (~ \pipeline-statement)
        (~ \feed-statement)
        (~ \pattern-helper-clause)
        (~ \call-argument-line)
        (~ \declaration)
        (~ \assertion)
        (~ \probe)
        (~ \state-case)
        (~ \invalid-state-continuation)
        (~ \attached-catch)
        (~ \print-block)
        (~ \multi-line-expression)
        (~ \noop)
        (~ \return-statement-final)
      )
    )
    (blank)
    (lazy state-machine-block SyntaxId
      (pattern
        (~ (seq \open (: statements \state-machine-statements) / \close)
          (call (. tree append) (call ASTStateMachine location (call (. tree store-children) statements)))
        )
      )
    )
    (blank)
    (lazy state-machine-statements (of ImmutableArray SyntaxId)
      (pattern
        (~ (seq (* \nl) (: head \state-machine-first-line) (: tail (* \state-machine-line)) / (? \nl))
          (call true-optionals tree tail head)
        )
      )
    )
    (blank)
    (lazy state-machine-first-line SyntaxId
      (pattern
        (~ (seq / (: statement \state-case) / (| \nl (& \close)))
          statement
        )
      )
    )
    (blank)
    (lazy state-machine-line (? SyntaxId)
      (pattern
        (~ (seq / (: statement \state-machine-item) / (| \nl (& \close)))
          statement
        )
        (~ (seq / \nl)
          null
        )
      )
    )
    (blank)
    (lazy state-machine-item SyntaxId
      (pattern
        (~ \state-case)
        (~ \state-fallback)
      )
    )
    (blank)
    (lazy state-body-block (of ImmutableArray SyntaxId)
      (pattern
        (~ (seq \open (: statements \state-body-statements) / \close)
          statements
        )
      )
    )
    (blank)
    (lazy state-body-statements (of ImmutableArray SyntaxId)
      (pattern
        (~ (seq (* \nl) (: lines (+ \state-body-line)) / (? \nl))
          (call link-statements tree (call true-optionals tree lines))
        )
      )
    )
    (blank)
    (lazy state-body-line (? SyntaxId)
      (pattern
        (~ (seq / (: statement \state-body-statement) / (| \nl (& \close)))
          statement
        )
        (~ (seq / \nl)
          null
        )
      )
    )
    (blank)
    (lazy state-body-statement SyntaxId
      (pattern
        (~ \state-case)
        (~ \state-continuation)
        (~ \state-fallback)
        (~ \statement)
      )
    )
    (blank)
    (lazy state-case SyntaxId
      (pattern
        (~ (seq "~>" // (: n \name) (: values (? \state-target-values)) (: trigger (? \state-trigger)) (: body (? \state-body-block)))
          (call (. tree append) (call ASTStateCase location n (call (. tree store-children) (?? values (call (of ImmutableArray SyntaxId)))) (call (. tree syntax-or-invalid) typed-trigger) (call (. tree store-children) (?? body (call (of ImmutableArray SyntaxId)))))
            (block
              (lazy typed-trigger (only-if trigger (if trigger)))
            )
          )
        )
      )
    )
    (blank)
    (lazy state-continuation SyntaxId
      (pattern
        (~ (seq "then" // (: n \name) (: values (? \state-target-values)) (: trigger (? \state-trigger)) (: body (? \state-body-block)))
          (call (. tree append) (call ASTStateContinuation location n (call (. tree store-children) (?? values (call (of ImmutableArray SyntaxId)))) (call (. tree syntax-or-invalid) typed-trigger) (call (. tree store-children) (?? body (call (of ImmutableArray SyntaxId)))))
            (block
              (lazy typed-trigger (only-if trigger (if trigger)))
            )
          )
        )
      )
    )
    (blank)
    (lazy invalid-state-continuation SyntaxId
      (pattern
        (~ "then"
          (call reject-syntax
            (block
              (arg tree)
              (arg (call exclusive-end-location location))
              (arg "State continuation has no owning state")
            )
          )
        )
      )
    )
    (blank)
    (lazy state-fallback SyntaxId
      (pattern
        (~ (seq "??" // (: n \name) (: values (? \state-target-values)))
          (call (. tree append)
            (block
              (arg
                (call ASTStateFallback
                  (block
                    (arg location)
                    (arg n)
                    (arg (call (. tree store-children) (?? values (call (of ImmutableArray SyntaxId)))))
                  )
                )
              )
            )
          )
        )
      )
    )
    (blank)
    (lazy state-target-values (of ImmutableArray SyntaxId)
      (pattern
        (~ (seq "(" / (: values (? (call \delimited "," (~ \inline-expression-no-comma)))) / ")")
          (?? values (call (of ImmutableArray SyntaxId)))
        )
      )
    )
    (blank)
    (lazy state-trigger SyntaxId
      (pattern
        (~ (seq // "whenever" // (: watched \bulleted-expression))
          (call (. tree append) (call ASTStateTrigger location .state-trigger-whenever (call (. tree store-child) closure))
            (block
              (lazy closure (call make-closure tree location false null watched))
            )
          )
        )
        (~ (seq // "for" // (: pattern \structure-pattern) // "on" // (: stream \bulleted-expression) (: guard (? \state-when-guard)))
          (case? guard
            (call (. tree append) (call ASTStateTrigger location .state-trigger-for-on-when children)
              (block
                (lazy pattern-node (call (. tree append) (call ASTStructureMatch location pattern)))
                (lazy children (call (. tree store-child) pattern-node stream guard))
              )
            )
          )
          (default
            (call (. tree append) (call ASTStateTrigger location .state-trigger-for-on children)
              (block
                (lazy pattern-node (call (. tree append) (call ASTStructureMatch location pattern)))
                (lazy children (call (. tree store-child) pattern-node stream))
              )
            )
          )
        )
        (~ (seq // "when" // (: guard \state-guard-expression) // "on" // (: stream \bulleted-expression))
          (call (. tree append)
            (block
              (arg (call ASTStateTrigger location .state-trigger-on-when (call (. tree store-child) stream guard)))
            )
          )
        )
        (~ (seq // "on" // (: stream \bulleted-expression) (: guard (? \state-when-guard)))
          (case? guard
            (call (. tree append) (call ASTStateTrigger location .state-trigger-on-when children)
              (block
                (lazy children (call (. tree store-child) stream guard))
              )
            )
          )
          (default
            (call (. tree append) (call ASTStateTrigger location .state-trigger-on (call (. tree store-child) stream)))
          )
        )
        (~ (seq // "if" // (: pattern \structure-match) // "=" // (: subject \bulleted-expression))
          (call (. tree append) (call ASTStateTrigger location .state-trigger-if-match child)
            (block
              (lazy child (call (. tree store-child) (call (. tree append) m)))
              (lazy m (call ASTStateMatchExpression location subject (call (. tree append) s)))
              (lazy s (call ASTStructureMatch location pattern))
            )
          )
        )
        (~ (seq // "if" // (: condition \bulleted-expression))
          (call (. tree append) (call ASTStateTrigger location .state-trigger-if (call (. tree store-child) condition)))
        )
        (~ (seq // "when" // (: stream \bulleted-expression))
          (call (. tree append) (call ASTStateTrigger location .state-trigger-when-stream (call (. tree store-child) stream)))
        )
      )
    )
    (blank)
    (lazy state-when-guard SyntaxId
      (pattern
        (~ (seq // "when" // (: guard \state-guard-expression))
          guard
        )
      )
    )
    (blank)
    (lazy state-guard-expression SyntaxId
      (pattern
        (~ \apply-expression)
      )
    )
    (blank)
    (lazy multi-line-expression SyntaxId
      (pattern
        (~ \block-construct)
        (~ \call-block)
      )
    )
    (blank)
    (lazy multi-line-expression-no-prep SyntaxId
      (pattern
        (~ \block-construct)
        (~ \inline-expression-no-prep)
      )
    )
    (blank)
    (lazy block-construct SyntaxId
      (pattern
        (~ \task-block)
        (~ \match-block)
        (~ \iterator-block)
        (~ \structure-match-block)
        (~ \stream-match-block)
        (~ \for-block)
        (~ \use-block)
        (~ \closure-block)
        (~ \latest-block)
        (~ \slot-outlet)
        (~ \markup)
      )
    )
    (blank)
    (lazy extension-block SyntaxId
      (pattern
        (~ (seq \open \nl (: acc \access) // "extend" // (: receiver \type) (: as-types (? \extension-as)) (: constraints (? \extension-where)) (: body (? \class-body)) / (* \nl) / \close)
          (call make-extension-declaration tree location acc receiver as-types constraints body)
        )
        (~ (seq (: acc \access) // "extend" // (: receiver \type) (: as-types (? \extension-as)) (: constraints (? \extension-where)))
          (call make-extension-declaration tree location acc receiver as-types constraints null)
        )
      )
    )
    (blank)
    (lazy extension-as (of ImmutableArray SyntaxId)
      (pattern
        (~ (seq // "as" // (: types (call \delimited "," (~ \type))))
          types
        )
      )
    )
    (blank)
    (lazy extension-where (of ImmutableArray ArgumentVariant)
      (pattern
        (~ (seq // "where" // (: constraints (call \delimited "," (~ \type-constraint-declaration))))
          constraints
        )
      )
    )
    (blank)
    (lazy style-sheet-extension-block SyntaxId
      (pattern
        (~ (seq \open \nl "•" // "extend" // (: receiver \type) (: header (? \class-header-block)) (: body (? \class-body)) / (* \nl) / \close)
          (call make-style-sheet-extension-declaration tree location receiver header body)
        )
      )
    )
    (blank)
    (lazy style-sheet-block SyntaxId
      (pattern
        (~ (seq \open \nl "•" // (: id \type-name) (: derived (? \sheet-derivation)) (: header (? \class-header-block)) (: body (? \class-body)) / (* \nl) / \close)
          (call make-style-sheet-declaration tree location id derived header body)
        )
      )
    )
    (blank)
    (lazy sheet-derivation SheetDerivation
      (pattern
        (~ (seq // "is" // (: base \type) (: tags (? \sheet-tags)))
          (call SheetDerivation base tags)
        )
      )
    )
    (blank)
    (lazy sheet-tags (of ImmutableArray Atom)
      (pattern
        (~ (seq // "for" // (: tags (call \delimited "," (~ \name))))
          tags
        )
      )
    )
    (blank)
    (lazy class-block
      (pattern
        (~ (seq \open \nl (: header \class-line) (: body (? \class-body)) / (* \nl) / \close)
          (call make-class-declaration tree location header body)
        )
        (~ (: header \class-line)
          (call make-class-declaration tree (. header location) header null)
        )
      )
    )
    (blank)
    (lazy class-line ClassHeader
      (pattern
        (~ (seq (: acc \access) // (: id \type-name) (: type-args (* \type-argument)) (: aliases (? \class-aliases)) (: owner (? \class-facet-of)) (: inherits (? \class-inherits)) (: header (? \class-header-block)))
          (call ClassHeader location acc id type-args aliases inherits header (?? owner 0))
        )
      )
    )
    (blank)
    (lazy class-aliases
      (pattern
        (~ (seq // "(" / (: aliases \alias-list) / ")")
          aliases
        )
      )
    )
    (blank)
    (lazy alias-list
      (pattern
        (~ (call \delimited "," (~ \alias)))
      )
    )
    (blank)
    (lazy alias Atom
      (pattern
        (~ \name)
        (~ \type-name)
        (~ \unit)
      )
    )
    (blank)
    (lazy class-facet-of SyntaxId
      (pattern
        (~ (seq // "is" // "facet" // "of" // (: owner \type))
          owner
        )
      )
    )
    (blank)
    (lazy class-inherits
      (pattern
        (~ (seq // "is" // (: types \class-or-list))
          types
        )
      )
    )
    (blank)
    (lazy class-or-list
      (pattern
        (~ (call \delimited "||" (~ \class-base)))
      )
    )
    (blank)
    (lazy class-base-list
      (pattern
        (~ (call \delimited "," (~ \class-base)))
      )
    )
    (blank)
    (lazy class-base SyntaxId
      (pattern
        (~ \class-tuple-base)
        (~ \type)
        (~ \numeric-literal
          (call (. tree append) (call ASTTypeNumeric location it))
        )
      )
    )
    (blank)
    (lazy class-tuple-base SyntaxId
      (pattern
        (~ (seq "(" / (: id \identifier) // (: ty \type) / ")")
          (call (. tree append) (call ASTTypeTuple location (call (. tree store-child) capture))
            (block
              (lazy capture (call (. tree append) (call ASTTypeCapture location id ty)))
            )
          )
        )
      )
    )
    (blank)
    (lazy class-header-block
      (pattern
        (~ (seq \open (: lines \class-header-lines) / \close)
          lines
        )
      )
    )
    (blank)
    (lazy class-header-lines (of ImmutableArray ArgumentVariant)
      (pattern
        (~ (seq (* \nl) (: head \class-header-declaration-line) (: tail (* \class-header-line)) / (* \nl))
          (call true-optionals tree tail head)
        )
      )
    )
    (blank)
    (lazy class-header-declaration-line ArgumentVariant
      (pattern
        (~ (seq / (: arg \class-header-declaration) / (| \nl (& \close)))
          arg
        )
      )
    )
    (blank)
    (lazy class-header-line (? ArgumentVariant)
      (pattern
        (~ (seq / (: arg \class-header-declaration) / (| \nl (& \close)))
          arg
        )
        (~ (seq / \nl)
          null
        )
      )
    )
    (blank)
    (lazy class-header-declaration ArgumentVariant
      (pattern
        (~ (seq "-" // (: arg \type-constraint-declaration))
          arg
        )
        (~ (seq "is" // (: t \type))
          (call .implements-declaration (call (. tree append) (call ASTImplementsDeclaration location t)))
        )
        (~ (seq "using" // (: t \type))
          (call .using-declaration (call (. tree append) (call ASTUsingDeclaration location t)))
        )
        (~ (seq "sees" // (: t \type))
          (call .sees-declaration (call (. tree append) (call ASTSeesDeclaration location t)))
        )
      )
    )
    (blank)
    (lazy class-body (of ImmutableArray SyntaxId)
      (pattern
        (~ (seq / (+ \nl) (: items \members))
          items
        )
      )
    )
    (blank)
    (lazy member SyntaxId
      (pattern
        (~ \event-declaration)
        (~ \invalid-state-machine-member)
        (~ \property-declaration)
        (~ \enum-declaration)
        (~ \implements-declaration)
        (~ \style-annotation-declaration)
        (~ \dependency-declaration)
        (~ \invalid-style-flag-annotation)
        (~ \function-block)
        (~ \content-block)
      )
    )
    (blank)
    (lazy event-declaration SyntaxId
      (pattern
        (~ (seq (: acc \access) // "event" // (: name \name) // (: ty \type) (? (seq // "keyed" // "by" // (: keyed \type))))
          (call (. tree append) (call ASTEventDeclaration location acc name ty (call (. tree syntax-or-invalid) keyed)))
        )
      )
    )
    (blank)
    (lazy invalid-state-machine-member SyntaxId
      (pattern
        (~ \state-machine-declaration
          (call reject-syntax
            (block
              (arg tree)
              (arg (call exclusive-end-location location))
              (arg "A class state machine follows a thin divider, with its cases at column zero")
            )
          )
        )
      )
    )
    (blank)
    (lazy invalid-style-flag-annotation SyntaxId
      (pattern
        (~ (seq "." // \identifier // (: invalid \invalid-style-flag-operator))
          (call reject-syntax tree invalid "Syntax error")
        )
      )
    )
    (blank)
    (lazy invalid-style-flag-operator MatchLocation
      (pattern
        (~ "is"
          location
        )
      )
    )
    (blank)
    (lazy members (of ImmutableArray SyntaxId)
      (pattern
        (~ (seq (: leading (* \leading-member-line)) (: divided (* \divided-member-line)) / (? \nl))
          (call syntax-optionals tree leading divided)
        )
      )
    )
    (blank)
    (lazy leading-member-line (? SyntaxId)
      (pattern
        (~ (seq / (: mem \keyframe-member) / (| \nl (& \close) (& \style-rule-member-start) (& \open)))
          mem
        )
        (~ (seq / (: mem \style-rule-member) / (| \nl (& \close) (& \style-rule-member-start) (& \open)))
          mem
        )
        (~ (seq / (! \open) (: mem \member) / (| \nl (& \close) (& \open)))
          mem
        )
        (~ (seq / \nl)
          null
        )
      )
    )
    (blank)
    (lazy divided-member-line (? SyntaxId)
      (pattern
        (~ (seq / (& \open) (: mem \member) / (| \nl (& \close)))
          mem
        )
