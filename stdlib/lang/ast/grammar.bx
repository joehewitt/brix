          (call reduce head tail
            (:using
              (=> (left right)
                (match right
                  (case (call .get-partial name is-tracked is-optional is-loop)
                    (call (. tree append)
                      (block
                        (arg
                          (call ASTGetExpression
                            (block
                              (arg (call (. tree location) left))
                              (arg left)
                              (arg name)
                              (arg is-tracked)
                              (arg is-optional)
                              (arg is-loop)
