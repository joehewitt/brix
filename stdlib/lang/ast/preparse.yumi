
/BxCore/BxString.h
/core/arena
/math

+ indent-size = 4
_ literal-close = '\ufdd0'

━━━━━━━━━━━━━━━━━━━━
+ do preparse
    - source String
    - scratch Arena
    - dividers [PreparseDivider]? = null

. input = byte-view(source)
. line-count Size = 1
. codepoint-count Size = 0
. byte-count Size = 0
while byte-count < input.size && input[byte-count] != 0
    . byte = input[byte-count]
    if byte == 10
        line-count += 1
    if byte < 128 || byte >= 192
        codepoint-count += 1
    byte-count += 1
C:brixStringValidateUtf8(input, byte-count)
    ?! Panic("Unable to read UTF8 content")
        if it
input = input[0 .. < byte-count]

. output = PreparseBuffer(scratch, codepoint-count * 2 + line-count * 4 + 8)
. source-cursor Index = 0
. last-text-line Index = 0
. last-text-end Index = 0
. previous-line-start Index = 0
. previous-line-end Index = 0
. indent-level = 0
. header-level = 0
. last-line-header = 0
. expecting-paragraph = false
. expecting-text = false
. is-paragraph = false
. prefix-next-line = false

` Process the split lines plus the sentinel line that the grammar expects.
for line-no in 0 .. < line-count + 1
    . line-start = source-cursor
    . line-end = source-cursor
    if line-no < line-count
        while line-end < input.size && input[line-end] != 10
            line-end += 1
        source-cursor = line-end + 1

    . prefix-line = prefix-next-line
    prefix-next-line = false
    if prefix-line && is-header-line(input, line-start, line-end)
        output.insert('Æ', previous-line-end)
        output.insert('≥', previous-line-end + 1)
        previous-line-end += 2
        prefix-line = false
        expecting-text = false
    . line-has-content = prefix-line || line-end > line-start

    . first-content = line-start
    while first-content < line-end && is-whitespace(input[first-content])
        first-content += 1

    . is-comment = is-plain-line && first-content < line-end && input[first-content] == 96
        .. is-plain-line = !prefix-line && !is-paragraph
    . output-kind = 0
    . paragraph-access Index?
    . current-suffix-count = 0

    if is-comment
        output-kind = 1
    else
        if !is-paragraph
            . indent = if !prefix-line then parse-indent(input, line-start, line-end) else 0
            if indent > indent-level
                if last-text-line == line-no
                    current-suffix-count += 1
                else
                    output.insert('≤', last-text-end)
                    last-text-end += 1
                    previous-line-end += 1
            else if line-has-content && indent < indent-level
                for _ in indent .. < indent-level
                    if last-text-line == line-no
                        current-suffix-count += 1
                    else
                        output.insert('≥', last-text-end)
                        last-text-end += 1
                        previous-line-end += 1

            if line-has-content
                indent-level = indent

        . is-header1 = !prefix-line && is-repeated-char(input, line-start, line-end, '━')
        . is-header2 = !prefix-line && is-repeated-char(input, line-start, line-end, '─')
        . is-header3 = !prefix-line && is-repeated-char(input, line-start, line-end, '═')
        paragraph-access = find-paragraph-marker(input, line-start, line-end) if !prefix-line
        . is-paragraph-line = paragraph-access != null
        . is-empty-line = !prefix-line && first-content == line-end

        if is-header1
            if header-level == 1
                output.insert('≥', previous-line-end)
                previous-line-end += 1
                if last-text-line == line-no - 1
                    last-text-end += 1
            else if header-level == 2
                for _ in 0 .. < 2
                    output.insert('≥', previous-line-end)
                    previous-line-end += 1
                    if last-text-line == line-no - 1
                        last-text-end += 1

            if is-paragraph
                output.insert('≥', previous-line-end)
                previous-line-end += 1
                if last-text-line == line-no - 1
                    last-text-end += 1
                is-paragraph = false

            output-kind = 2
            current-suffix-count = 0
            header-level = 1
            last-line-header = 1
            if dividers
                dividers += PreparseDivider(line-no, true)
        else if is-header2
            if header-level == 2
                output.insert('≥', previous-line-end)
                previous-line-end += 1
                if last-text-line == line-no - 1
                    last-text-end += 1

            if is-paragraph
                output.insert('≥', previous-line-end)
                previous-line-end += 1
                if last-text-line == line-no - 1
                    last-text-end += 1
                is-paragraph = false

            output-kind = 2
            current-suffix-count = 0
            header-level = 2
            last-line-header = 2
            if dividers
                dividers += PreparseDivider(line-no, false)
        else if is-header3
            if is-paragraph
                output.insert('≥', previous-line-end)
                previous-line-end += 1
                if last-text-line == line-no - 1
                    last-text-end += 1
                output-kind = 1
                is-paragraph = false
            else
                output-kind = 3
            current-suffix-count = 0
        else if is-paragraph-line && !is-paragraph
            expecting-paragraph = true
            output-kind = 4
            current-suffix-count = 0
            last-line-header = 0
        else if is-empty-line && !is-paragraph
            if expecting-paragraph
                prefix-next-line = true
                expecting-paragraph = false
                expecting-text = true
            if last-line-header == 1
                output.remove(previous-line-start, previous-line-end)
                if last-text-line == line-no - 1
                    last-text-end = previous-line-start
                previous-line-end = previous-line-start
                header-level = 0
                last-line-header = 0
        else
            last-line-header = 0

            if expecting-text
                expecting-text = false
                is-paragraph = true

        . current-line-start = output.length
        if output-kind == 0
            if prefix-line
                output.append('Æ')
            output.append(input, line-start, line-end)
            if is-paragraph
                output.mark-literal-closes(current-line-start)
        else if output-kind == 2
            output.append('≤')
        else if output-kind == 3
            output.append('═')
        else if output-kind == 4
            append-paragraph-line(output, input, line-start, line-end, paragraph-access!)

        for _ in 0 .. < current-suffix-count
            output.append('≤')

        . current-line-end = output.length
        if line-has-content
            last-text-line = line-no
            last-text-end = current-line-end

        output.append('\n')
        previous-line-start = current-line-start
        previous-line-end = current-line-end
        continue

    previous-line-start = output.length
    previous-line-end = output.length
    output.append('\n')

for _ in 0 .. < indent-level
    output.insert('≥', previous-line-end)
    previous-line-end += 1

if header-level == 1
    output.insert('≥', previous-line-end)
    previous-line-end += 1
else if header-level == 2
    for _ in 0 .. < 2
        output.insert('≥', previous-line-end)
        previous-line-end += 1

if is-paragraph
    output.insert('≥', previous-line-end)

= Array'Char(output.data.data, output.length)

━━━━━━━━━━━━━━━━━━━━
+ PreparseDivider is Tuple

+ line Index
+ thick Bool

━━━━━━━━━━━━━━━━━━━━
_ PreparseBuffer

+ data Char[]
+ length Size = 0

────────────────────
+ This
    - scratch Arena
    - capacity Size

.. data = Array'Char(scratch.allocate'Char(capacity), capacity)

────────────────────
+ do append
    - char Char

data[length] = char
length += 1

────────────────────
+ do append
    - source ImmutableArray'Byte
    - start Index
    - end Index

=? if end <= start
. input = source[start .. < end]
. output = Array'Char(data.data + length, data.size - length)
. decoded-count Size
. bytes-decoded Size
decoded-count, bytes-decoded = decode-utf8-buffer(input, input.size, output)
?! Panic("Preparse buffer capacity exceeded")
    if bytes-decoded != input.size
length += decoded-count

────────────────────
+ do insert
    - char Char
    - at Index

. cursor = length
while cursor > at
    data[cursor] = data[cursor - 1]
    cursor -= 1
data[at] = char
length += 1

────────────────────
+ do mark-literal-closes
    - start Index

. cursor = start
while cursor < length
    if data[cursor] == '≥'
        data[cursor] = literal-close
    cursor += 1

────────────────────
+ do remove
    - start Index
    - end Index

=? if end <= start

. amount = end - start
. cursor = start
while cursor + amount < length
    data[cursor] = data[cursor + amount]
    cursor += 1
length -= amount

━━━━━━━━━━━━━━━━━━━━
_ do parse-indent Int
    - input ImmutableArray'Byte
    - start Index
    - end Index

. cursor = start
while cursor < end && input[cursor] == 32
    cursor += 1

= (cursor - start) / indent-size

━━━━━━━━━━━━━━━━━━━━
_ is-header-line Bool
    - input ImmutableArray'Byte
    - start Index
    - end Index

|? true if is-repeated-char(input, start, end, '━')
|? true if is-repeated-char(input, start, end, '─')
?? is-repeated-char(input, start, end, '═')

━━━━━━━━━━━━━━━━━━━━
_ do is-repeated-char Bool
    - input ImmutableArray'Byte
    - start Index
    - end Index
    - char Char
    - min-length = 3

. count = 0
. cursor = start
while cursor < end
    . scalar = source-scalar(input, cursor)
    =? false if scalar.char != char
    cursor += scalar.byte-count as Size
    count += 1

= count >= min-length

━━━━━━━━━━━━━━━━━━━━
_ do find-paragraph-marker Index?
    - input ImmutableArray'Byte
    - start Index
    - end Index

. cursor = start
while cursor < end && is-whitespace(input[cursor])
    cursor += 1

=? if cursor >= end
=? if input[cursor] != 43 && input[cursor] != 95

. access-index = cursor
cursor += 1

. spaces = 0
while cursor < end && is-whitespace(input[cursor])
    spaces += 1
    cursor += 1

=? if spaces == 0
=? if cursor >= end
=? if source-scalar(input, cursor).char != '¶'

cursor += 2
while cursor < end && is-whitespace(input[cursor])
    cursor += 1

=? if cursor >= end

= access-index

━━━━━━━━━━━━━━━━━━━━
_ do append-paragraph-line
    - output PreparseBuffer
    - input ImmutableArray'Byte
    - start Index
    - end Index
    - access-index Index

output.append(input, start, access-index)
output.append(input[access-index] as Char)
output.append(' ')

. cursor = access-index + 1
while cursor < end && is-whitespace(input[cursor])
    cursor += 1
cursor += 2
while cursor < end && is-whitespace(input[cursor])
    cursor += 1

. rest-end = end
while rest-end > cursor && is-whitespace(input[rest-end - 1])
    rest-end -= 1

output.append(input, cursor, rest-end)

━━━━━━━━━━━━━━━━━━━━
_ is-whitespace
    - c Byte

c == 32 || c == 9 || c == 13 || c == 10

━━━━━━━━━━━━━━━━━━━━
_ SourceScalar is (byte-count I32, char Char)

━━━━━━━━━━━━━━━━━━━━
_ do source-scalar SourceScalar
    - input ImmutableArray'Byte
    - offset Index

. first = input[offset]
=? SourceScalar(1, first as Char) if first < 128

. result SourceScalar
. status = C:brixStringGetNextChar((input as CPointer'Byte) + offset, &result)
?! Panic("Unable to read UTF8 content")
    if status != 0 || result.byte-count <= 0 || offset + result.byte-count as Size > input.size
= result
