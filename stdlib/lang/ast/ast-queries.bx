(import ./ast)
(import ./ast-children)
(import ./ast-nodes)
(import ./decl)
(import ./facets)
(import ./module)
(import ./operator)
(import ./program)
(import ./row-range)
(import ./state-machines)
(import ./viability)
(import /core/arena)
(import /core/scratch)
(import /lang/target)
(import /stream/aggregate)
(import /stream/sort)

(type + IntegerLiteral (is Tuple)
  (prop + value U64)
  (prop + negative Bool)
  (prop + overflow Bool)
)

(fn-do + parse-integer-literal IntegerLiteral
  (param text String)
  (let negative (and (!= (. text length) 0) (== ([] text 0) '-')))
  (let start (if-expr negative 1 0))
  (let base 10u64)
  (if (and (>= (. text length) (+ start 2)) (== ([] text start) '0'))
    (let marker ([] text (+ start 1)))
    (if (or (== marker 'x') (== marker 'X'))
      (= base 16)
      (+= start 2)
      (else-if (or (== marker 'b') (== marker 'B'))
        (= base 2)
        (+= start 2)
      )
      (else-if (or (== marker 'o') (== marker 'O'))
        (= base 8)
        (+= start 2)
      )
    )
  )
  (let value 0u64)
  (let overflow false)
  (for (in index (..< start (. text length)))
    (let char ([] text index))
    (if (== char '_')
      (continue)
    )
    (let digit 0u64)
    (if (and (>= char '0') (<= char '9'))
      (= digit (- char '0'))
      (else-if (and (>= char 'a') (<= char 'f'))
        (= digit (+ (as (- char 'a') U64) 10))
      )
      (else-if (and (>= char 'A') (<= char 'F'))
        (= digit (+ (as (- char 'A') U64) 10))
      )
      (else
        (break)
      )
    )
    (if (> value (/ (- (. U64 max) digit) base))
      (= overflow true)
      (else
        (= value (+ (* value base) digit))
      )
    )
  )
  (return (call IntegerLiteral value negative overflow))
)

(extend + AST
  (fn-expr + binds-line Bool
    (param line SyntaxId)
    (match ([] nodes line)
      (case (call .node-assign row)
        (== (. row op) .bind-op)
      )
      (default
        false
      )
    )
  )
  (fn-do + binding-line SyntaxId
    (param body SyntaxId)
    (for (in node (.. (call subtree-start body) body))
      (if (call binds-line node)
        (return node)
      )
    )
    (return 0)
  )
  (fn-do + is-inherit Bool
    (param value SyntaxId)
    ; Whether a style value is the keyword `inherit`.
    (match? ([] nodes value)
      (case (call .node-identifier row)
        (return (== (. row name text) "inherit"))
      )
    )
    (return false)
  )
  (fn-do + leaves-early Bool
    (param body SyntaxId)
    ; Whether the body of a constructor leaves before its end by a return of its own, apart
    ; from those of the functions written in it.
    (if (== body 0)
      (return false)
    )
    (let skip-from SyntaxId 0)
    (let skip-to SyntaxId 0)
    (let node body)
    (while (> node (call subtree-start body))
      (-= node 1)
      (match? ([] nodes node)
        (case .node-function-syntax
          (if (not (and (>= node skip-from) (< node skip-to)))
            (= skip-from (call subtree-start node))
            (= skip-to node)
          )
        )
        (case .node-return
          (if (not (and (>= node skip-from) (< node skip-to)))
            (return true)
          )
        )
        (case .node-return-if-true
          (if (not (and (>= node skip-from) (< node skip-to)))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-expr + is-empty-block Bool
    (param id SyntaxId)
    (match ([] nodes id)
      (case (call .node-block row)
        (== (. row body count) 0)
      )
      (default
        false
      )
    )
  )
  (fn-do + yields-itself Bool
    (param declaration CheckedDecl)
    ; Whether a function's own statements yield, outside the functions nested in it.
    (let start (. declaration subtree start))
    (let position (. declaration syntax))
    (while (> position start)
      (-= position 1)
      (match? ([] nodes position)
        (case .node-yield
          (return true)
        )
        (case .node-function-syntax
          (= position (call subtree-start position))
        )
      )
    )
    (return false)
  )
  (fn-do + identifier-atom (? Atom)
    (param id SyntaxId)
    ; The name an identifier writes, or none for any other node.
    (match? ([] nodes id)
      (case (call .node-identifier row)
        (return (. row name))
      )
    )
    (return null)
  )
  (fn-expr + is-empty-list Bool
    (param syntax SyntaxId)
    ; Whether an expression is a list written with no items, which takes the type of the
    ; parameter it is the default of and has no type anywhere else.
    (match ([] nodes syntax)
      (case (call .node-list-syntax row)
        (== (. row items count) 0)
      )
      (default
        false
      )
    )
  )
  (fn-do + offset-of SyntaxId
    (param expr SyntaxId)
    ; The first number with no unit a side of an equality adds to or takes from a number in a unit
    ; other than zero, which is no ratio, or none. Zero in a unit adds nothing, as in
    ; `(1 / 3) + 0foo`, which writes a third of foo.
    (match? ([] nodes expr)
      (case (call .node-binary-expression row)
        (let inner (call offset-of (. row lhs)))
        (if (!= inner 0)
          (return inner)
        )
        (let right (call offset-of (. row rhs)))
        (if (!= right 0)
          (return right)
        )
        (if (and (!= (. row op) .add-op) (!= (. row op) .subtract-op))
          (return 0)
        )
        (let left-unit (call has-unit (. row lhs)))
        (let right-unit (call has-unit (. row rhs)))
        (if (and left-unit (not right-unit) (not (call zero-amount (. row lhs))))
          (return (. row rhs))
        )
        (if (and right-unit (not left-unit) (not (call zero-amount (. row rhs))))
          (return (. row lhs))
        )
      )
    )
    (return 0)
  )
  (fn-expr + has-unit Bool
    (param expr SyntaxId)
    ; Whether a side of an equality writes a number in a unit.
    (match ([] nodes expr)
      (case (call .node-integer-syntax row)
        (!= (. row unit) null)
      )
      (case (call .node-float-syntax row)
        (!= (. row unit) null)
      )
      (case (call .node-binary-expression row)
        (or (call has-unit (. row lhs)) (call has-unit (. row rhs)))
      )
      (default
        false
      )
    )
  )
  (fn-expr + zero-amount Bool
    (param expr SyntaxId)
    ; Whether a side of an equality is a number written as zero.
    (match ([] nodes expr)
      (case (call .node-integer-syntax row)
        (== (as (. row value) F64) 0.0)
      )
      (case (call .node-float-syntax row)
        (== (as (. row value) F64) 0.0)
      )
      (default
        false
      )
    )
  )
  (fn-do + unevaluated-operation SyntaxId
    (param expr SyntaxId)
    ; The first operation of a side of an equality that gives no number, its operands before it and
    ; the left before the right, as the reference evaluates them, or none.
    (match? ([] nodes expr)
      (case (call .node-binary-expression row)
        (let left (call unevaluated-operation (. row lhs)))
        (if (!= left 0)
          (return left)
        )
        (let right (call unevaluated-operation (. row rhs)))
        (if (!= right 0)
          (return right)
        )
        (if (not (call is-constant-arithmetic (. row op)))
          (return expr)
        )
      )
    )
    (return 0)
  )
  (fn-do + first-unexpressed SyntaxId
    (param body SyntaxId)
    (param statements Bool)
    ; The first node of a body, in the order the reference visits them, that a function written as
    ; one expression may not hold: an explicit return or, with `statements`, an immediate
    ; declaration, a loop or a yield outside a `do` block. Neither is looked for in the functions,
    ; tasks and deferred blocks written in the body.
    (let found SyntaxId 0)
    (let floor (call subtree-start body))
    (let node (+ body 1))
    (while (> node floor)
      (-= node 1)
      (match? ([] nodes node)
        (case .node-function-syntax
          (= node (call subtree-start node))
        )
        (case .node-do-task-block
          (= node (call subtree-start node))
        )
        (case .node-do-finally-block
          (= node (call subtree-start node))
        )
        (case .node-do-block
          (if statements
            (= node (call subtree-start node))
          )
        )
        (case .node-return
          (if (not statements)
            (= found node)
          )
        )
        (case .node-return-if-true
          (if (not statements)
            (= found node)
          )
        )
        (case (call .node-declare row)
          (if (and statements (not (. row is-lazy)))
            (= found node)
          )
        )
        (case .node-for-block
          (if statements
            (= found node)
          )
        )
        (case .node-while-block
          (if statements
            (= found node)
          )
        )
        (case .node-yield
          (if statements
            (= found node)
          )
        )
      )
    )
    (return found)
  )
  (fn-expr + requires-do-text String
    (param statement SyntaxId)
    (match ([] nodes statement)
      (case (call .node-declare row)
        (if-expr (. row is-lazy) "Lazy before the value requires do" "Immediate declaration requires do")
      )
      (case .node-yield
        "Yield requires do"
      )
      (case .node-assign
        "Assignment requires do"
      )
      (case .node-if-block
        "If statement requires do"
      )
      (case .node-call-expression
        "Call before the value requires do"
      )
      (default
        "Loop requires do"
      )
    )
  )
  (fn-expr + is-trailing-row Bool
    (param statement SyntaxId)
    (match ([] nodes statement)
      (case (call .node-declare row)
        (. row is-lazy)
      )
      (case (call .node-pipeline-expression row)
        (== (. row left) 0)
      )
      (default
        false
      )
    )
  )
  (fn-do + same-syntaxes Bool
    (param left (of RowRange SyntaxId))
    (param right (of RowRange SyntaxId))
    (if (!= (. left count) (. right count))
      (return false)
    )
    (for (in offset (..< 0 (. left count)))
      (if (not (call same-syntax ([] children (+ (. left start) offset)) ([] children (+ (. right start) offset))))
        (return false)
      )
    )
    (return true)
  )
  (fn-do + same-syntax Bool
    (param left SyntaxId)
    (param right SyntaxId)
    ; Whether two types are written the same way. A way of writing a type this does not know is
    ; never the same as another.
    (if (or (== left 0) (== right 0))
      (return (== left right))
    )
    (match? ([] nodes left)
      (case (call .node-type-identifier mine)
        (match? ([] nodes right)
          (case (call .node-type-identifier theirs)
            (return (and (== (. mine name) (. theirs name)) (== (. mine is-declare) (. theirs is-declare))))
          )
        )
      )
      (case (call .node-type-arguments mine)
        (match? ([] nodes right)
          (case (call .node-type-arguments theirs)
            (return (and (call same-syntax (. mine base) (. theirs base)) (call same-syntaxes (. mine args) (. theirs args))))
          )
        )
      )
      (case (call .node-type-optional mine)
        (match? ([] nodes right)
          (case (call .node-type-optional theirs)
            (return (call same-syntaxes (. mine field-types) (. theirs field-types)))
          )
        )
      )
      (case (call .node-type-tuple mine)
        (match? ([] nodes right)
          (case (call .node-type-tuple theirs)
            (return (call same-syntaxes (. mine field-types) (. theirs field-types)))
          )
        )
      )
      (case (call .node-type-capture mine)
        (match? ([] nodes right)
          (case (call .node-type-capture theirs)
            (return (and (call same-syntax (. mine id) (. theirs id)) (call same-syntax (. mine type) (. theirs type))))
          )
        )
      )
      (case (call .node-identifier mine)
        (match? ([] nodes right)
          (case (call .node-identifier theirs)
            (return (== (. mine name) (. theirs name)))
          )
        )
      )
      (case (call .node-param-constraint mine)
        (match? ([] nodes right)
          (case (call .node-param-constraint theirs)
            (return (and (call same-syntax (. mine left) (. theirs left)) (call same-syntax (. mine right) (. theirs right))))
          )
        )
      )
    )
    (return false)
  )
  (fn-expr + is-brix Bool
    ; Whether the source is written in Brix, as a `.bx` file is.
    (call (. source-path ends-with) brix-extension)
  )
  (fn-do + kept-row SyntaxId
    (param body (of RowRange SyntaxId))
    (let position (. body count))
    (while (> position 0)
      (-= position 1)
      (let row ([] children (+ (. body start) position)))
      (return-if row (if (not (call is-lazy-declare row))))
    )
    (return 0)
  )
  (fn-do + final-print SyntaxId
    (param body SyntaxId)
    (match? ([] nodes body)
      (case (call .node-block row)
        (let kept (call kept-row (. row body)))
        (return (if-expr (and (!= kept 0) (is ([] nodes kept) .node-print)) kept 0))
      )
    )
    (return (if-expr (is ([] nodes body) .node-print) body 0))
  )
  (fn-expr + is-finally Bool
    (param statement SyntaxId)
    ; A finally block runs as its enclosing block ends, after every other statement of it.
    (match ([] nodes statement)
      (case .node-do-finally-block
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-lazy-declare Bool
    (param statement SyntaxId)
    (match ([] nodes statement)
      (case (call .node-declare row)
        (. row is-lazy)
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-conditional-value Bool
    (param expr SyntaxId)
    ; Whether an expression is a value chosen by a condition, `x if c` or `if c then x else y`, or
    ; one with a fallback.
    (match ([] nodes expr)
      (case (call .node-binary-expression row)
        (or (== (. row op) .if-op) (== (. row op) .coalesce-op) (== (. row op) .else-op))
      )
      (default
        false
      )
    )
  )
  (fn-expr + calls-symbol Bool
    (param expr SyntaxId)
    ; Whether an expression calls a case by its symbol alone, which the type expected of it names.
    (match ([] nodes expr)
      (case (call .node-call-expression row)
        (!= (call symbol-of (. row callable)) null)
      )
      (default
        false
      )
    )
  )
  (fn-do + first-named SyntaxId
    (param pattern SyntaxId)
    ; The name a declaration declares, or the first of those it declares together: they are
    ; typed together, so what is known of the first is known of each.
    (match? ([] nodes pattern)
      (case (call .node-type-capture row)
        (return (. row id))
      )
      (case (call .node-tuple-syntax row)
        (if (!= (. row items count) 0)
          (return (call first-named ([] children (. row items start))))
        )
      )
      (case (call .node-type-tuple row)
        (if (!= (. row field-types count) 0)
          (return (call first-named ([] children (. row field-types start))))
        )
      )
    )
    (return pattern)
  )
  (fn-do + place-syntax SyntaxId
    (param value SyntaxId)
    (param position U32)
    (param count Size)
    ; What a pattern of items declares a place with: the item at that place where it is declared
    ; with a tuple written with as many items, or else the value.
    (match? ([] nodes value)
      (case (call .node-tuple-syntax row)
        (if (== (. row items count) count)
          (let offset 0u32)
          (for (in item ([] children (. row items)))
            (return-if item (if (== offset position)))
            (+= offset 1)
          )
        )
      )
    )
    (return value)
  )
  (fn-expr + machine-or-value SyntaxId
    (param pattern SyntaxId)
    (param value SyntaxId)
    ; What a declaration's value is checked as: the state machine it is, where it declares one
    ; name, or the value.
    (if-expr (!= (call declared-local pattern) 0) (call declared-value value) value)
  )
  (fn-expr + pattern-identifier SyntaxId
    (param pattern SyntaxId)
    (match ([] nodes pattern)
      (case (call .node-type-capture row)
        (. row id)
      )
      (default
        pattern
      )
    )
  )
  (fn-expr + force-operand SyntaxId
    (param syntax SyntaxId)
    (match ([] nodes syntax)
      (case (call .node-unary-expression row)
        (. row operand)
      )
      (default
        0
      )
    )
  )
  (fn-expr + returned-expr SyntaxId
    (param statement SyntaxId)
    (match ([] nodes statement)
      (case (call .node-return row)
        (. row expr)
      )
      (case (call .node-return-if-true row)
        (. row expr)
      )
      (default
        0
      )
    )
  )
  (fn-expr + yielded-syntax SyntaxId
    (param site SyntaxId)
    ; What a yield written as a statement gives, so an integer it gives with no suffix converts to the
    ; items as that integer does; any other site is its own value.
    (match ([] nodes site)
      (case (call .node-yield row)
        (. row expr)
      )
      (default
        site
      )
    )
  )
  (fn-expr + is-integer-literal Bool
    (param expr SyntaxId)
    (match ([] nodes expr)
      (case .node-integer-syntax
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-match-syntax Bool
    (param expr SyntaxId)
    (match ([] nodes expr)
      (case .node-match-expression
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + arms-value SyntaxId
    (param expr SyntaxId)
    ; The value a declaration gives where it is written alone in a block of its own, as arms are.
    (match ([] nodes expr)
      (case (call .node-block row)
        (if-expr (== (. row body count) 1) ([] children (. row body start)) expr)
      )
      (default
        expr
      )
    )
  )
  (fn-expr + is-arms-syntax Bool
    (param expr SyntaxId)
    (match ([] nodes expr)
      (case .node-match-expression
        true
      )
      (case .node-structure-match
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-quasi-syntax Bool
    (param expr SyntaxId)
    ; Whether a statement gives no value though it is typed as an expression: an assignment, a line
    ; of markup that declares a property, a print, or a `do` block.
    (match ([] nodes expr)
      (case .node-assign
        true
      )
      (case .node-property-syntax
        true
      )
      (case .node-print
        true
      )
      (case .node-do-block
        true
      )
      (case .node-do-finally-block
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-string-syntax Bool
    (param expr SyntaxId)
    (match ([] nodes expr)
      (case .node-string-syntax
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + return-site SyntaxId
    (param expr SyntaxId)
    (match ([] nodes expr)
      (case (call .node-match-expression row)
        (. row body)
      )
      (default
        expr
      )
    )
  )
  (fn-do + is-direct-statement Bool
    (param body SyntaxId)
    (param id SyntaxId)
    (if (== body id)
      (return true)
    )
    (match? ([] nodes body)
      (case (call .node-block row)
        (for (in statement ([] children (. row body)))
          (if (== statement id)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-expr + tested SyntaxId
    (param condition SyntaxId)
    ; The match a condition is, where `if` or `while` is written with a pattern: its arm runs
    ; the body, so what the body assigns is assigned under the condition. No node for any other
    ; condition.
    (match ([] nodes condition)
      (case (call .node-match-expression row)
        (if-expr (and (!= (. row subject) 0) (not (. row is-optional)) (not (. row is-block))) condition 0)
      )
      (default
        0
      )
    )
  )
  (fn-expr + is-plain-name Bool
    (param pattern SyntaxId)
    ; Whether what a declaration declares is one name, with no type and no pattern.
    (match ([] nodes pattern)
      (case .node-identifier
        true
      )
      (case (call .node-type-capture row)
        (== (. row type) 0)
      )
      (default
        false
      )
    )
  )
  (fn-do + in-body-loop Bool
    (param node SyntaxId)
    (param body SyntaxId)
    ; Whether a node is written in the body of a `for` within a body, which runs it each turn.
    (for (in around (..< (+ node 1) body))
      (if (and (<= (call subtree-start around) node) (is ([] nodes around) .node-for-block))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + in-attribute Bool
    (param node SyntaxId)
    (param body SyntaxId)
    ; Whether a node is written in a line of a block that assigns.
    (match? ([] nodes body)
      (case (call .node-block row)
        (for (in statement ([] children (. row body)))
          (if (and (is ([] nodes statement) .node-assign) after-start (< node statement))
            (return true)
          )
          (lazy after-start (<= (call subtree-start statement) node))
        )
      )
    )
    (return false)
  )
  (fn-do + tests-plainly Bool
    (param pattern SyntaxId)
    ; Whether a pattern tests with no expression of its own that reads what it binds.
    (if (== pattern 0)
      (return true)
    )
    (for (in node (.. (call subtree-start pattern) pattern))
      (if (is ([] nodes node) .node-type-predicate)
        (return false)
      )
    )
    (return true)
  )
  (fn-do + in-operator-value Bool
    (param id SyntaxId)
    ; Whether a node is in the value of an assignment written with an operator other than `=`, and
    ; in no function written there.
    (for (in node (..< (+ id 1) (as (. nodes length) SyntaxId)))
      (if (> (call subtree-start node) id)
        (continue)
      )
      (match? ([] nodes node)
        (case (call .node-assign row)
          (return (and (!= (. row op) .eq-op) (<= (call subtree-start (. row rhs)) id) (<= id (. row rhs))))
        )
        (case .node-declare
          (return false)
        )
        (case .node-function-syntax
          (return false)
        )
        (case .node-markup
          (return false)
        )
      )
    )
    (return false)
  )
  (fn-do + has-handlers Bool
    (param task SyntaxId)
    (match? ([] nodes task)
      (case (call .node-do-task-block row)
        (return (!= (. row catchers count) 0))
      )
    )
    (return false)
  )
  (fn-expr + both-targets-text String
    ; The error of a task forked onto a worker and onto the pool's threads both.
    (str "A task runs on a worker or on the pool's threads, not both; write " forms)
    (where
      (lazy forms (if-expr (call (. source-path ends-with) ".bx") brix-forms rows-forms))
      (lazy brix-forms "\"(do-new (worker: w) …)\" or \"(do-new-thread …)\"")
      (lazy rows-forms "\"do (w) new\" or \"do new thread\"")
    )
  )
  (fn-expr + optional-chain-expr SyntaxId
    (param id SyntaxId)
    (match ([] nodes id)
      (case (call .node-optional-chain row)
        (. row expr)
      )
      (default
        0u32
      )
    )
  )
  (fn-expr + handled-type SyntaxId
    (param pattern SyntaxId)
    ; The type a handler's pattern names, or none for one that names only the panic.
    (match ([] nodes pattern)
      (case (call .node-type-capture row)
        (. row type)
      )
      (case .node-type-identifier
        pattern
      )
      (default
        0
      )
    )
  )
  (fn-do + never-reads Bool
    (param id SyntaxId)
    ; Whether a grammar matches without ever reading an item: one made only of lookaheads.
    (match? ([] nodes id)
      (case (call .node-stream-match row)
        (return (call never-reads (. row pattern)))
      )
      (case (call .node-stream-unary row)
        (return (or (== (. row op) .positive-lookahead-op) (== (. row op) .negative-lookahead-op)))
      )
      (case (call .node-stream-and row)
        (return (and (call never-reads (. row left)) (call never-reads (. row right))))
      )
      (case (call .node-stream-or row)
        (return (and (call never-reads (. row left)) (call never-reads (. row right))))
      )
      (case (call .node-stream-capture row)
        (return (call never-reads (. row pattern)))
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call never-reads (. row pattern))))
      )
    )
    (return false)
  )
  (fn-do + clause-expr SyntaxId
    (param clause SyntaxId)
    ; The value a clause tests.
    (match? ([] nodes clause)
      (case (call .node-clause row)
        (return (. row expr))
      )
    )
    (return 0)
  )
  (fn-expr + symbol-of (? Atom)
    (param expr SyntaxId)
    (match? ([] nodes expr)
      (case (call .node-symbol row)
        (. row name)
      )
    )
  )
  (fn-expr + argument-symbol (? Atom)
    (param expr SyntaxId)
    ; The case an argument names by its symbol alone, bare or called with the case's values: the
    ; parameter it fills names the union.
    (match? ([] nodes expr)
      (case (call .node-symbol row)
        (. row name)
