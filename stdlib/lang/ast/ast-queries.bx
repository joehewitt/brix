        )
      )
    )
    (return false)
  )
  (fn-do + enclosed-element Bool
    (param element SyntaxId)
    (param content SyntaxId)
    ; Whether a markup element of a class's markup is written in a function or a loop there.
    (for (in node (..< (+ element 1) content))
      (if (<= (call subtree-start node) element)
        (match? ([] nodes node)
          (case .node-function-syntax
            (return true)
