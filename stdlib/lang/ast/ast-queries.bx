  (fn-expr + rule-body SyntaxId
    (param syntax SyntaxId)
    (match ([] nodes syntax)
      (case (call .node-rule-syntax row)
        (. row body)
      )
      (default
        0
      )
    )
  )
  (fn-do + rule-content (list SyntaxId)
    (param body SyntaxId)
    ; The lines of the body of a style rule that generate content, in the order written: markup
    ; elements that bind a slot.
    (let lines (list SyntaxId))
