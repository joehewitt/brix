          (case .node-for-block
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do + ends-returning Bool
    (param body SyntaxId)
    ; Whether the last line of a block returns or raises a panic or an error with no condition.
    (match? ([] nodes body)
      (case (call .node-block block)
        (if (== (. block body count) 0)
          (return false)
        )
        (match? ([] nodes ([] children (- (+ (. block body start) (. block body count)) 1)))
          (case .node-return
            (return true)
          )
          (case (call .node-assertion-syntax row)
            (return (== (. row condition) 0))
