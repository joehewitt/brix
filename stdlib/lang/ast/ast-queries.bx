    (let trigger (call state-trigger (. source node)))
    (let captures (list Atom))
    (if (!= trigger 0)
      (call pattern-names (call trigger-pattern trigger) captures)
    )
    (if (!= (. source owner) 0)
      (call pattern-names (call trigger-pattern (call state-trigger (. source owner))) captures)
    )
    (for (in target ([] children (call state-targets (. source node))))
      (match? ([] nodes target)
        (case (call .node-identifier named)
          (if (== (call (. captures find) (. named name)) null)
