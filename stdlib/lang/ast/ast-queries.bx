      (case (call .node-call-expression row)
        (call symbol-of (. row callable))
      )
    )
  )
  (fn-expr + other-side SyntaxId
    (param expr SyntaxId)
    (match ([] nodes expr)
      (case (call .node-binary-expression row)
        (. row rhs)
      )
      (default
        0
      )
    )
  )
  (fn-do + reads-once Bool
    (param id SyntaxId)
    ; Whether a node is the operand of a `<-` written before it, which reads one item.
    (match? ([] nodes (call holder-of id))
      (case (call .node-unary-expression row)
