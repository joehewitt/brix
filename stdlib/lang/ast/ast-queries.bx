      )
    )
    (return false)
  )
  (fn-do + in-gated Bool
    (param node SyntaxId)
    (param conditions (list SyntaxId))
    ; Whether a node is written in one of the conditions given.
    (for (in condition conditions)
      (if (and (<= (call subtree-start condition) node) (<= node condition))
