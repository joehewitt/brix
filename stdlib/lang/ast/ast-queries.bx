    (return false)
  )
  (fn-do + stable-key Bool
    (param key SyntaxId)
    ; Whether a key names what lasts as long as the address it makes, as the reference decides:
    ; a name, a number, a text or a case written alone, a name read from one, or a tuple of them.
    (match? ([] nodes key)
      (case .node-identifier
        (return true)
      )
      (case .node-integer-syntax
        (return true)
      )
      (case .node-string-syntax
        (return true)
      )
      (case .node-anonymous-case
        (return true)
      )
      (case (call .node-get-expression get)
        (return (call stable-key (. get object)))
      )
      (case (call .node-tuple-syntax row)
        (for (in item ([] children (. row items)))
          (if (not (call stable-key item))
            (return false)
          )
        )
        (return true)
      )
    )
    (return false)
  )
  (fn-do + index-key SyntaxId
    (param index SyntaxId)
    ; The key an index is written with.
    (match? ([] nodes index)
      (case (call .node-index-expression row)
        (return (. row index))
      )
    )
    (return 0)
  )
  (fn-do + index-object SyntaxId
    (param index SyntaxId)
    ; What an index is read from.
    (match? ([] nodes index)
      (case (call .node-index-expression row)
        (return (. row object))
      )
    )
    (return 0)
  )
  (fn-expr + lazy-value SyntaxId
    (param declaration SyntaxId)
    ; The value a lazy local is declared with.
    (match ([] nodes declaration)
      (case (call .node-declare row)
        (. row right)
      )
      (default
        0
      )
    )
  )
  (fn-expr + is-typed Bool
    (param pattern SyntaxId)
    (match ([] nodes pattern)
      (case (call .node-type-capture row)
        (!= (. row type) 0)
      )
      (default
        false
      )
    )
  )
  (fn-expr + coalesces-condition Bool
    (param id SyntaxId)
    (param left SyntaxId)
    ; Whether `??` takes the other side of a value written `value if condition`, as its left side
    ; or as the last of the sides before it in one chain, which shares the chain's place.
    (match ([] nodes left)
      (case (call .node-binary-expression row)
        (case? (== (. row op) .if-op)
          true
        )
        (case? (and (== (. row op) .coalesce-op) (== ([] (. nodes loc) left) ([] (. nodes loc) id)))
          (call is-if-syntax (. row rhs))
        )
        (default
          false
        )
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-if-syntax Bool
    (param expr SyntaxId)
    (match ([] nodes expr)
      (case (call .node-binary-expression row)
        (== (. row op) .if-op)
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-choice-syntax Bool
    (param expr SyntaxId)
    ; Whether an expression is `if condition then value else other`.
    (match ([] nodes expr)
      (case (call .node-binary-expression row)
        (and (== (. row op) .else-op) (call is-if-syntax (. row lhs)))
      )
      (default
        false
      )
    )
  )
  (fn-expr + escaped-subject SyntaxId
    (param value SyntaxId)
    (match ([] nodes value)
      (case (call .node-cast-expression row)
        (call escaped-subject (. row lhs))
      )
      (case (call .node-unary-expression row)
        (if-expr (== (. row op) .optional-force-op) (call escaped-subject (. row operand)) 0)
      )
      (default
        value
      )
    )
  )
  (fn-expr + matched-subject SyntaxId
    (param matching SyntaxId)
    ; The subject of a match, or none.
    (match ([] nodes matching)
      (case (call .node-match-expression row)
        (. row subject)
      )
      (default
        0
      )
    )
  )
  (fn-do + bound-attribute SyntaxId
    (param anchor SyntaxId)
    (let holder (call holder-of anchor))
    (match? ([] nodes holder)
      (case (call .node-assign row)
        (if (and (== (. row op) .bind-op) (== (. row lhs) anchor) (!= (call attribute-element holder) 0))
          (return holder)
        )
      )
    )
    (return 0)
  )
  (fn-do + when-lines (list SyntaxId)
    (param branch SyntaxId)
    ; The lines of the body of a `when` of a style rule, in the order written: the one line of a
    ; `when` written on one, or those of its block.
    (let lines (list SyntaxId))
    (match? ([] nodes branch)
      (case (call .node-style-when row)
        (match ([] nodes (. row body))
          (case (call .node-block block)
            (for (in line ([] children (. block body)))
              (+= lines line)
            )
          )
          (default
            (+= lines (. row body))
          )
        )
      )
    )
    (return lines)
  )
  (fn-do + falls-back Bool
    (param row ASTSlotOutlet)
    (match? ([] nodes (. row body))
      (case (call .node-block block)
        (for (in statement ([] children (. block body)))
          (if (not (is ([] nodes statement) .node-assign))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-expr + tests-row Bool
    (param clause SyntaxId)
    (match ([] nodes clause)
      (case (call .node-clause row)
        (== (. row op) .when-clause)
      )
      (default
        false
      )
    )
  )
  (fn-do + assigning-line SyntaxId
    (param body SyntaxId)
    ; The first line of a block that assigns, or none.
    (match? ([] nodes body)
      (case (call .node-block row)
        (for (in statement ([] children (. row body)))
          (if (is ([] nodes statement) .node-assign)
            (return statement)
          )
        )
      )
    )
    (return 0)
  )
  (fn-expr + assigns Bool
    (param expr SyntaxId)
    ; An arrow body that is an assignment gives the value assigned.
    (match ([] nodes expr)
      (case .node-assign
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + holds-struct Bool
    (param object-syntax SyntaxId)
    ; Whether a struct whose field is assigned is held where the change stays: not one a cast or
    ; a call gives.
    (match ([] nodes object-syntax)
      (case .node-cast-expression
        false
      )
      (case .node-call-expression
        false
      )
      (default
        true
      )
    )
  )
  (fn-expr + holds-text Bool
    (param object-syntax SyntaxId)
    ; Whether a text whose item is assigned is held where the new text is stored: not a literal, a
    ; text joined from parts, or one a cast or a call gives.
    (match ([] nodes object-syntax)
      (case .node-string-syntax
        false
      )
      (case .node-binary-expression
        false
      )
      (case .node-cast-expression
        false
      )
      (case .node-call-expression
        false
      )
      (default
        true
      )
    )
  )
  (fn-expr + is-identifier-syntax Bool
    (param expr SyntaxId)
    (match ([] nodes expr)
      (case .node-identifier
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + writes-type Bool
    (param pattern SyntaxId)
    ; Whether a declaration's pattern writes the type of what it declares.
    (match ([] nodes pattern)
      (case (call .node-type-capture row)
        (!= (. row type) 0)
      )
      (default
        false
      )
    )
  )
  (fn-expr + written-part SyntaxId
    (param rhs SyntaxId)
    (param position U32)
    ; The item written at a position of a tuple written as a value, or none.
