  (fn-expr + rule-takes U32
    (param syntax SyntaxId)
    (match ([] nodes syntax)
      (case (call .node-rule-syntax row)
        (. row args count)
      )
      (default
        0
      )
    )
  )
  (fn-expr + rule-takes-nothing Bool
    (param syntax SyntaxId)
    (match ([] nodes syntax)
      (case (call .node-rule-syntax row)
        (== (. row args count) 0)
      )
      (default
        false
      )
    )
  )
  (fn-do + rule-whens (list SyntaxId)
    (param body SyntaxId)
    ; The `when`s of the body of a style rule, in the order written.
    (let whens (list SyntaxId))
    (if (== body 0)
      (return whens)
    )
    (match? ([] nodes body)
      (case (call .node-block block)
        (for (in statement ([] children (. block body)))
          (if (is ([] nodes statement) .node-style-when)
            (+= whens statement)
