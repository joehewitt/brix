    ; Whether a slot outlet of the markup written in a class is no slot's: one a line forwards, or one
    ; in the body of another, which is content the other mounts where it is given none.
    (for (in node (..< (call subtree-start content) content))
      (match? ([] nodes node)
        (case (call .node-markup-slot-forward row)
          (if (== (. row outlet) outlet)
            (return true)
          )
        )
        (case (call .node-slot-outlet row)
          (if (and (!= node outlet) (!= (. row body) 0) in-body)
            (return true)
