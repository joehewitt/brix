      (default
        0
      )
    )
  )
  (fn-expr + names-super Bool
    (param callable SyntaxId)
    (match ([] nodes callable)
      (case (call .node-identifier row)
        (== (. row name text) "super")
      )
      (default
        false
      )
    )
  )
  (fn-expr + feed-site SyntaxId
    (param id SyntaxId)
    (param consumer SyntaxId)
    (match ([] nodes id)
      (case (call .node-feed-expression row)
        (if-expr (!= (. row next) 0) (. row next) (if-expr (!= consumer 0) consumer id))
      )
      (default
        id
      )
    )
  )
  (fn-do + consumer-of SyntaxId
    (param id SyntaxId)
    ; The pipeline whose left operand is the feed list, if one consumes it.
    (let total (. nodes length))
    (for (in candidate (..< (+ id 1) total))
      (match? ([] nodes candidate)
        (case (call .node-pipeline-expression row)
          (if (== (. row left) id)
            (return (as candidate SyntaxId))
          )
        )
      )
    )
    (return 0)
  )
  (fn-do + is-piped-row Bool
    (param body (of RowRange SyntaxId))
    (param statement SyntaxId)
    (for (in position (..< 0 (- (. body count) 1)))
      (if (== ([] children (+ (. body start) position)) statement)
        (match? ([] nodes ([] children (+ (. body start) position 1)))
          (case (call .node-pipeline-expression row)
            (return (== (. row left) 0))
          )
        )
        (return false)
      )
    )
    (return false)
  )
  (fn-do + pipeline-of SyntaxId
    (param id SyntaxId)
    (for (in node (..< (+ id 1) (as (. nodes length) SyntaxId)))
      (if (> (call subtree-start node) id)
        (continue)
      )
      (match? ([] nodes node)
        (case (call .node-iterator-expression row)
          (match? ([] nodes (. row loop))
            (case (call .node-loop-syntax loop)
              (if (or (> (call subtree-start (. loop container)) id) (> id (. loop container)))
                (return node)
              )
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-expr + source-site SyntaxId
    (param left SyntaxId)
    (param id SyntaxId)
    ; The reference converts a pipeline's left value where that value was produced: at the left
    ; operand, which for a feed list is where its shifted first feed lands.
    (match ([] nodes left)
      (case .node-feed-expression
        (call feed-site left id)
      )
      (default
        left
      )
    )
  )
  (fn-do + written-feeds SyntaxId
    (param expr SyntaxId)
    (let feeds expr)
    (match? ([] nodes feeds)
      (case (call .node-argument row)
        (= feeds (if-expr (. row name) 0 (. row expr)))
      )
    )
    (match? ([] nodes feeds)
      (case (call .node-block row)
        (= feeds (if-expr (== (. row body count) 1) ([] children (. row body start)) 0))
      )
    )
    (return-if feeds (if (and (!= feeds 0) (is ([] nodes feeds) .node-feed-expression))))
    (return 0)
  )
  (fn-do + declaring-type-names (list SyntaxId)
    (let found (list SyntaxId))
    (for (in id (..< 1u32 (. nodes length)))
      (match? ([] nodes id)
        (case (call .node-type-identifier row)
          (if (. row is-declare)
            (+= found (as id SyntaxId))
          )
        )
      )
    )
    (return found)
  )
  (fn-do + evaluated-surely Bool
    (param value SyntaxId)
    (param node SyntaxId)
    ; Whether a node of a value is evaluated whenever the value is: each node around it that tests
    ; something holds it in the part evaluated before the test, the left side of `&&`, `||` or
    ; `??`, or the object an optional read or index reads from.
    (for (in around (..< (+ node 1) (+ value 1)))
      (if (or (> (call subtree-start around) node) (call tests-nothing around))
        (continue)
      )
      (let first
        (match ([] nodes around)
          (case (call .node-binary-expression row)
            (if-expr (!= (. row op) .if-op) (. row lhs) 0)
          )
          (case (call .node-get-expression row)
            (. row object)
          )
          (case (call .node-index-expression row)
            (. row object)
          )
          (default
            0
          )
        )
      )
      (if (or (== first 0) (< node (call subtree-start first)) (> node first))
        (return false)
      )
    )
    (return true)
  )
  (fn-expr + tests-nothing Bool
    (param node SyntaxId)
    ; Whether a node of a value evaluates all it holds whenever it is evaluated: a name, a literal,
    ; a call, a block, which evaluates its lines in order, a read or an operator that tests
    ; nothing.
    (match ([] nodes node)
      (case .node-integer-syntax
        true
      )
      (case .node-block
        true
      )
      (case .node-float-syntax
        true
      )
      (case .node-string-syntax
        true
      )
      (case .node-identifier
        true
      )
      (case .node-call-expression
        true
      )
      (case .node-argument
        true
      )
      (case (call .node-get-expression row)
        (not (. row is-optional))
      )
      (case (call .node-index-expression row)
        (not (. row is-optional))
      )
      (case .node-tuple-syntax
        true
      )
      (case .node-unary-expression
        true
      )
      (case .node-cast-expression
        true
      )
      (case .node-type-identifier
        true
      )
      (case .node-type-arguments
        true
      )
      (case (call .node-binary-expression row)
        (and no-short-circuit (!= (. row op) .if-op) (!= (. row op) .else-op))
        (blank)
        (lazy no-short-circuit (and (!= (. row op) .and-op) (!= (. row op) .or-op) (!= (. row op) .coalesce-op)))
      )
      (default
        false
      )
    )
  )
  (fn-do + arrival-clause Bool
    (param clause SyntaxId)
    ; Whether a loop on an event asks with its first clause, `when arrival` or `when bubbling`,
    ; for only the events that arrive at the object or for those that bubble too.
    (match? ([] nodes clause)
      (case (call .node-clause row)
        (if (is (. row op) .when-clause)
          (match? ([] nodes (. row expr))
            (case (call .node-identifier name)
              (return (or (== (. name name text) "arrival") (== (. name name text) "bubbling")))
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + clause-delivery U32
    (param clause SyntaxId)
    ; Which publications a loop on an event hears where its only clause says so: 1 for
    ; `when arrival`, 2 for `when bubbling`, and else 0.
    (match? ([] nodes clause)
      (case (call .node-clause row)
        (if (and (is (. row op) .when-clause) (== (. row next) 0))
          (match? ([] nodes (. row expr))
            (case (call .node-identifier name)
              (if (== (. name name text) "arrival")
                (return 1)
              )
              (if (== (. name name text) "bubbling")
                (return 2)
              )
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do + ends-subscription Bool
    (param clause SyntaxId)
    ; Whether a loop's clauses include a `while` or an `until`, which end a subscription.
    (let current clause)
    (while (!= current 0)
      (let next SyntaxId 0)
      (match? ([] nodes current)
        (case (call .node-clause row)
          (if (or (== (. row op) .while-clause) (== (. row op) .until-clause))
            (return true)
          )
          (= next (. row next))
        )
      )
      (= current next)
    )
    (return false)
  )
  (fn-do + gives-closure Bool
    (param function SyntaxId)
    ; Whether a function written as a value is the whole value of an attribute of a markup element.
    (let holder (call holder-of function))
    (match? ([] nodes holder)
      (case (call .node-assign row)
        (return (and (== (. row rhs) function) (!= (call attribute-element holder) 0)))
      )
    )
    (return false)
  )
  (fn-do + has-whenever Bool
    (param clause SyntaxId)
    ; Whether a loop's clauses include a `whenever`.
    (let current clause)
    (while (!= current 0)
      (let next SyntaxId 0)
      (match? ([] nodes current)
        (case (call .node-clause row)
          (if (== (. row op) .whenever-clause)
            (return true)
          )
          (= next (. row next))
        )
      )
      (= current next)
    )
    (return false)
  )
  (fn-do + in-arm-body Bool
    (param region SyntaxId)
    (param id SyntaxId)
    ; Whether a node is written in the body of an arm of a markup branch or match region.
    (for (in arm (call region-arms region))
      (let body (call region-arm-body arm))
      (if (and (<= (call subtree-start body) id) (<= id body))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + in-container Bool
    (param region SyntaxId)
    (param id SyntaxId)
    ; Whether a node is written in the container of a markup loop region.
    (match? ([] nodes region)
      (case (call .node-for-block row)
        (match? ([] nodes (. row loop))
          (case (call .node-loop-syntax loop)
            (return
              (scope (and (!= (. loop container) 0) after-start (<= id (. loop container)))
                (lazy after-start (<= (call subtree-start (. loop container)) id))
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + in-key Bool
    (param region SyntaxId)
    (param id SyntaxId)
    ; Whether a node is written in the `keyed by` clause of a markup loop region.
    (match? ([] nodes region)
      (case (call .node-for-block row)
        (let clause (call keyed-clause (. row loop)))
        (return (and (!= clause 0) (<= (call subtree-start clause) id) (<= id clause)))
      )
    )
    (return false)
  )
  (fn-do + is-live-rule Bool
    (param syntax SyntaxId)
    ; Whether a rule a class writes runs as a live action of the object: a `when` or `whenever`
    ; rule.
    (match? ([] nodes syntax)
      (case .node-when-rule-syntax
        (return true)
      )
      (case .node-whenever-rule-syntax
        (return true)
      )
    )
    (return false)
  )
  (fn-do + is-subscriber-loop Bool
    (param loop SyntaxId)
    ; Whether the header of a loop reads a stream: `for x on s`.
    (match? ([] nodes loop)
      (case (call .node-loop-syntax row)
        (return (. row is-subscriber))
      )
    )
    (return false)
  )
  (fn-do + tracked-read (? Atom)
    (param id SyntaxId)
    ; The name of a property or a local that an expression reads tracked, written `#name`, where
    ; it reads one.
    (for (in node (..< (call subtree-start id) (+ id 1)))
      (match? ([] nodes node)
        (case (call .node-identifier row)
          (if (. row is-tracked)
            (return (. row name))
          )
        )
        (case (call .node-get-expression row)
          (if (. row is-tracked)
            (return (. row name))
          )
        )
      )
    )
    (return null)
  )
  (fn-do + tracks-reads Bool
    (param value SyntaxId)
    ; Whether a value reads a name or a member that it tracks.
    (for (in node (.. (call subtree-start value) value))
      (match? ([] nodes node)
        (case (call .node-identifier row)
          (if (. row is-tracked)
            (return true)
          )
        )
        (case (call .node-get-expression row)
          (if (. row is-tracked)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do + block-names _
    (param root SyntaxId)
    (param blocked (list Atom))
    ; Notes each name written under a node as changed.
    (for (in node (..< (call subtree-start root) (+ root 1)))
      (match? ([] nodes node)
        (case (call .node-identifier row)
          (+= blocked (. row name))
        )
      )
    )
  )
  (fn-expr + counts-from-zero Bool
    (param container SyntaxId)
    (match ([] nodes container)
      (case (call .node-range-expression range)
        (and (== (. range op) .range-to-op) (== (. range increment) 0) (call is-zero-literal (. range left)))
      )
      (default
        false
      )
    )
  )
  (fn-expr + has-arms Bool
    (param pattern SyntaxId)
    (match ([] nodes pattern)
      (case .node-type-or
        true
      )
      (case .node-type-transform
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-simple-loop-pattern Bool
    (param pattern SyntaxId)
    (case? (== pattern 0)
      true
    )
    (default
      (match ([] nodes pattern)
        (case .node-identifier
          true
        )
        (case (call .node-type-capture capture)
          (== (. capture type) 0)
        )
        (default
          false
        )
      )
    )
  )
  (fn-expr + is-zero-literal Bool
    (param syntax SyntaxId)
    (match ([] nodes syntax)
      (case (call .node-integer-syntax literal)
        (and (== (. literal value) "0") (not (. literal unit)))
      )
      (default
        false
      )
    )
  )
  (fn-expr + names-whole Bool
    (param pattern SyntaxId)
    ; Whether a pattern of a loop is its item whole under a name, or is not written.
    (case? (== pattern 0)
      true
    )
    (default
      (match ([] nodes pattern)
        (case .node-identifier
          true
        )
        (case (call .node-type-capture capture)
          (== (. capture type) 0)
        )
        (default
          false
        )
      )
    )
