  (fn-do + is-control-line Bool
    (param line SyntaxId)
    ; Whether a line of markup content is an `if`, a `match`, or a loop that is no loop on a stream,
    ; as the reference's `isMarkupControlFlow` finds it.
    (match? ([] nodes line)
      (case .node-if-block
        (return true)
      )
      (case .node-match-expression
        (return true)
      )
      (case (call .node-for-block row)
        (return (not (call is-subscriber-loop (. row loop))))
      )
      (case (call .node-iterator-expression row)
        (return (not (call is-subscriber-loop (. row loop))))
      )
