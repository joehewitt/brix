    (return false)
  )
  (fn-do + is-markup-trigger Bool
    (param syntax SyntaxId)
    ; Whether a rule a class writes is a `whenever` rule on the markup an object is in.
    (match? ([] nodes syntax)
      (case (call .node-whenever-rule-syntax rule)
        (return (!= (. rule kind text) "value"))
      )
    )
    (return false)
  )
  (fn-expr + row-loop SyntaxId
    (param body SyntaxId)
    (match ([] nodes (call holder-of body))
      (case (call .node-for-block row)
        (. row loop)
      )
      (default
        0
      )
    )
  )
  (fn-do + arm-value SyntaxId
    (param body SyntaxId)
    ; The node that gives the body of an arm its value: the body, or of a block the last statement
    ; that runs where it stands, or none where there is none.
    (match? ([] nodes body)
      (case (call .node-block block)
        (let last SyntaxId 0)
        (for (in statement ([] children (. block body)))
          (match? ([] nodes statement)
            (case (call .node-declare row)
              (if (. row is-lazy)
                (continue)
              )
            )
          )
          (if (and (not (call is-declaration-syntax this statement)) (not (call is-comment-syntax this statement)))
            (= last statement)
