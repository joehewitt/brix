      (default
        false
      )
    )
  )
  (fn-expr + is-bare-value Bool
    (param statement SyntaxId)
    (match ([] nodes statement)
      (case .node-identifier
        true
      )
      (case .node-integer-syntax
        true
      )
      (case .node-float-syntax
        true
      )
      (case .node-string-syntax
        true
      )
      (case .node-get-expression
        true
      )
      (case .node-index-expression
        true
      )
      (case .node-list-syntax
        true
      )
      (case .node-tuple-syntax
        true
      )
      (case .node-range-expression
        true
      )
      (case .node-cast-expression
        true
      )
      (case (call .node-binary-expression row)
        (or (call is-arithmetic (. row op)) (call is-comparison (. row op)) (has valued-ops (. row op)))
      )
      (case (call .node-unary-expression row)
        (or (== (. row op) .not-op) (== (. row op) .negative-op) (== (. row op) .bitwise-not-op))
      )
      (default
        false
      )
    )
    (where
      (lazy valued-ops (list (. Operator concat-op) (. Operator concat-string-op) (. Operator and-op) (. Operator or-op) (. Operator is-op) (. Operator is-not-op) (. Operator is-exactly-op) (. Operator is-not-exactly-op) (. Operator is-similar-op) (. Operator is-not-similar-op) (. Operator is-in-op) (. Operator not-in-op) (. Operator has-op) (. Operator has-not-op)))
    )
  )
  (fn-expr + is-number Bool
    (param value SyntaxId)
    (match ([] nodes value)
      (case .node-integer-syntax
        true
      )
      (case .node-float-syntax
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-string-literal Bool
    (param value SyntaxId)
    (match ([] nodes value)
      (case .node-string-syntax
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + member-name (? Atom)
    (param lhs SyntaxId)
    ; The name an assignment gives a property by: after an object, or alone.
    (match? ([] nodes lhs)
      (case (call .node-get-expression row)
        (. row name)
      )
      (case (call .node-identifier row)
        (. row name)
      )
    )
  )
  (fn-expr + is-named Bool
    (param argument SyntaxId)
    ; Whether an argument is written with the name of the parameter it is for.
    (match ([] nodes argument)
      (case (call .node-argument named)
        (!= (. named name) null)
      )
      (default
        false
      )
    )
  )
  (fn-expr + next-feed SyntaxId
    (param feed SyntaxId)
    (match ([] nodes feed)
      (case (call .node-feed-expression row)
        (. row next)
      )
      (default
        0
      )
    )
  )
  (fn-do + retest-site SyntaxId
    (param clause SyntaxId)
    ; Where the reference places the loop whose `whenever` clause a function tests again: the
    ; section of a class the loop is, or else the loop's header.
    (let loop (call clause-loop clause))
    (for (in node (..< (+ loop 1) (as (. nodes length) SyntaxId)))
      (if (<= (call subtree-start node) loop)
        (match ([] nodes node)
          (case (call .node-for-block block)
            (if (!= (. block loop) loop)
              (return loop)
            )
          )
          (case .node-subscriber-syntax
            (return node)
          )
          (default
            (return loop)
          )
        )
      )
    )
    (return loop)
  )
  (fn-expr + gives-items Bool
    (param loop SyntaxId)
    (param body SyntaxId)
    (and (== body 0) (not (is ([] nodes loop) .node-loop-syntax)))
  )
  (fn-expr + step-pattern SyntaxId
    (param loop SyntaxId)
    ; The grammar a loop's header is written as, out of the match that holds it where one
    ; does.
    (match ([] nodes loop)
      (case (call .node-loop-syntax row)
        (match ([] nodes (. row pattern))
          (case (call .node-stream-match written)
            (. written pattern)
          )
          (default
            (. row pattern)
          )
        )
      )
      (default
        0
      )
    )
  )
  (fn-expr + region-container SyntaxId
    (param id SyntaxId)
    ; The container of the one header of a markup loop region's `for`.
    (match ([] nodes id)
      (case (call .node-for-block row)
        (match ([] nodes (. row loop))
          (case (call .node-loop-syntax loop)
            (. loop container)
          )
          (default
            0
          )
        )
      )
      (default
        0
      )
    )
  )
  (fn-expr + region-site SyntaxId
    (param id SyntaxId)
    ; Where the markup branch region a line may be is written: a slot outlet's parameter, or the line.
    (match ([] nodes id)
      (case (call .node-slot-outlet row)
        (if-expr (!= (. row slot-parameter) 0) (. row slot-parameter) id)
      )
      (default
        id
      )
    )
  )
  (fn-expr + arm-test SyntaxId
    (param arm SyntaxId)
    (match ([] nodes arm)
      (case (call .node-type-transform row)
        (if-expr (or (== (. row pattern) 0) (is ([] nodes (. row pattern)) .node-type-wildcard)) 0 (. row pattern))
      )
      (default
        0
      )
    )
  )
  (fn-expr + case-inner SyntaxId
    (param pattern SyntaxId)
    (match ([] nodes pattern)
      (case (call .node-type-case row)
        (. row value)
      )
      (default
        0
      )
    )
  )
  (fn-expr + equality-expr SyntaxId
    (param pattern SyntaxId)
    (match ([] nodes pattern)
      (case (call .node-type-equality row)
        (. row expr)
      )
      (default
        0
      )
    )
  )
  (fn-do + first-item SyntaxId
    (param pattern SyntaxId)
    (match? ([] nodes pattern)
      (case (call .node-type-list row)
        (if (!= (. row patterns count) 0)
          (let item ([] children (. row patterns start)))
          (if (not (is ([] nodes item) .node-type-remainder))
            (return item)
          )
        )
      )
    )
    (return 0)
  )
  (fn-expr + has-name Bool
    (param remainder SyntaxId)
    ; Whether the rest of a pattern of a list has a name.
    (match ([] nodes remainder)
      (case (call .node-type-remainder row)
        (!= (. row name) 0)
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-block Bool
    (param body SyntaxId)
    (match ([] nodes body)
      (case .node-block
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + key-of SyntaxId
    (param key SyntaxId)
    ; The expression a key of a map pattern is compared to: what is written, or the name read.
    (match ([] nodes key)
      (case (call .node-type-equality row)
        (. row expr)
      )
      (default
        key
      )
    )
  )
  (fn-expr + names-type Bool
    (param pattern SyntaxId)
    ; Whether a pattern is a type named and no more.
    (match ([] nodes pattern)
      (case .node-type-identifier
        true
      )
      (case .node-type-arguments
        true
      )
      (case .node-type-optional
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + pattern-case-name (? Atom)
    (param pattern SyntaxId)
    ; The name of the case a pattern names.
    (match? ([] nodes pattern)
      (case (call .node-type-case row)
        (. row name)
      )
      (case (call .node-symbol row)
        (. row name)
      )
    )
  )
  (fn-expr + transform-body SyntaxId
    (param arm SyntaxId)
    (match ([] nodes arm)
      (case (call .node-type-transform row)
        (. row expr)
      )
      (default
        0
      )
    )
  )
  (fn-do + trigger-match SyntaxId
    (param trigger SyntaxId)
    ; The pattern a trigger matches what it tests with, inside its structure match, or none.
    (let pattern (call trigger-pattern trigger))
    (match? ([] nodes pattern)
      (case (call .node-structure-match row)
        (return (. row pattern))
      )
    )
    (return pattern)
  )
  (fn-expr + literal-bound Bool
    (param id SyntaxId)
    ; Whether a bound of a count is a number written.
    (match ([] nodes id)
      (case (call .node-integer-syntax row)
        (not (. row unit))
      )
      (default
        false
      )
    )
  )
  (fn-do + optional-part Bool
    (param id SyntaxId)
    ; Whether a part of a grammar is an optional part.
    (match? ([] nodes id)
      (case (call .node-stream-unary row)
        (return (== (. row op) .zero-or-one-op))
      )
    )
    (return false)
  )
  (fn-expr + argument-value SyntaxId
    (param argument SyntaxId)
    ; The expression of an argument written: what follows its name, when it has one.
    (match ([] nodes argument)
      (case (call .node-argument named)
        (. named expr)
      )
      (default
        argument
      )
    )
  )
  (fn-do + catchers-bind Bool
    (param catchers (of RowRange SyntaxId))
    ; Whether a catcher declares a name for the error it names, or for one in its chain.
    (for (in catcher ([] children catchers))
      (match? ([] nodes catcher)
        (case (call .node-catcher row)
          (if (call is-capture (. row type))
            (return true)
          )
          (for (in pattern ([] children (. row previous)))
            (if (call is-capture pattern)
              (return true)
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-expr + chained-subject SyntaxId
    (param expr SyntaxId)
    ; What `use?` uses: the expression its optional chain holds, or none where it is written
    ; without one.
    (match ([] nodes expr)
      (case (call .node-optional-chain row)
        (. row expr)
      )
      (default
        0u32
      )
    )
  )
  (fn-expr + field-names (of RowRange SyntaxId)
    (param pattern SyntaxId)
    ; The names a pattern writes for the fields of a tuple, where it is one that takes the tuple
    ; apart: the pattern of a loop, or a tuple of names within another. None for any other.
    (case? (== pattern 0)
      (call (of RowRange SyntaxId))
    )
    (default
      (match ([] nodes pattern)
        (case (call .node-type-tuple row)
          (. row field-types)
        )
        (case (call .node-tuple-syntax row)
          (. row items)
        )
        (default
          (call (of RowRange SyntaxId))
        )
      )
    )
  )
  (fn-do + has-pattern-arm Bool
    (param id SyntaxId)
    ; Whether a markup branch region has an arm written with a pattern, `if | x = v`.
    (let arm id)
    (while (!= arm 0)
      (if (!= (call pattern-arm arm) 0)
        (return true)
      )
      (let next SyntaxId 0)
      (match? ([] nodes arm)
        (case (call .node-if-block row)
          (= next (. row next))
        )
      )
      (= arm next)
    )
    (return false)
  )
  (fn-expr + is-assertion Bool
    (param statement SyntaxId)
    (match ([] nodes statement)
      (case .node-assertion-syntax
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-capture Bool
    (param pattern SyntaxId)
    (match ([] nodes pattern)
      (case .node-type-capture
        true
      )
      (default
        false
      )
    )
  )
  (fn-do + is-chained Bool
    (param expr SyntaxId)
    ; Whether an expression is written after the `?` of a statement that runs only where an
    ; optional holds a value.
    (if (== expr 0)
      (return false)
    )
    (match? ([] nodes expr)
      (case .node-optional-chain
        (return true)
      )
    )
    (return false)
  )
  (fn-do + is-logic Bool
    (param id SyntaxId)
    ; Whether an expression is `&&` or `||`.
    (match? ([] nodes id)
      (case (call .node-binary-expression row)
        (return (or (== (. row op) .and-op) (== (. row op) .or-op)))
      )
    )
    (return false)
  )
  (fn-expr + is-probe Bool
    (param id SyntaxId)
    (match ([] nodes id)
      (case .node-probe
        true
      )
      (case .node-probe-scope
        true
      )
      (case .node-probe-statement
        true
      )
      (case .node-probe-counter
        true
      )
      (case .node-probe-group
        true
      )
      (case .node-probe-assign
        true
      )
      (default
        false
      )
    )
  )
  (fn-do + item-site SyntaxId
    (param written (of RowRange SyntaxId))
    (param chain SyntaxId)
    (param position U32)
    (return-if ([] children (+ (. written start) position)) (if (== chain 0)))
    (let feed chain)
    (for (in _ (..< 0 position))
      (= feed (call next-feed feed))
    )
    (return
      (match ([] nodes feed)
        (case (call .node-feed-expression row)
          (. row item)
        )
        (default
          feed
        )
      )
    )
  )
  (fn-expr + matched-name SyntaxId
    (param pattern SyntaxId)
    ; The pattern of a comprehension's loop as the binder declares it: the one a match written
    ; there holds, which names the item where it is a name alone.
    (case? (== pattern 0)
      0
    )
    (default
      (match ([] nodes pattern)
        (case (call .node-structure-match row)
          (. row pattern)
        )
        (default
          pattern
        )
      )
    )
  )
  (fn-do + observes Bool
    (param id SyntaxId)
    ; Whether the reference takes a part of a pattern as one of its own: not a part that only
    ; declares lazy locals around another, nor an arm that raises.
    (match? ([] nodes id)
      (case (call .node-stream-transform row)
        (return (or (== (. row pattern) 0) (not (call lazies-only (. row right)))))
      )
      (case .node-stream-panic
        (return false)
      )
    )
    (return true)
  )
  (fn-expr + probe-value SyntaxId
    (param item SyntaxId)
    ; The value a probe writes for an item written in it: the one a snapshot or a preview is of.
    (match ([] nodes item)
      (case (call .node-probe-snapshot row)
        (. row content)
      )
      (case (call .node-probe-preview row)
        (. row content)
      )
      (default
        item
      )
    )
  )
  (fn-expr + matches-named Bool
    (param pattern SyntaxId)
    ; Whether a pattern is a type named with how near a value must be to it (`Int~`): it is
    ; planned for the value it is given, as the type named alone is.
    (match ([] nodes pattern)
      (case (call .node-type-match row)
        (call names-type (. row type))
      )
      (default
        false
      )
    )
  )
  (fn-expr + identifier-name (? Atom)
    (param id SyntaxId)
    (match? ([] nodes id)
      (case (call .node-identifier row)
        (. row name)
      )
      (case (call .node-ref-identifier row)
        (. row name)
      )
    )
  )
  (fn-expr + filled-name (? Atom)
    (param line SyntaxId)
    (match ([] nodes line)
      (case (call .node-markup row)
        (call identifier-name (. row slot-binding))
      )
      (case (call .node-markup-slot-forward row)
        (call identifier-name (. row slot-binding))
      )
      (default
        null
      )
    )
  )
  (fn-do + reads-slot-scope Bool
    (param id SyntaxId)
    (let object SyntaxId 0)
    (match? ([] nodes id)
      (case (call .node-get-expression row)
        (= object (. row object))
      )
    )
    (return-if false (if (== object 0)))
    (let scope (call identifier-name object))
    (return-if false (if (not scope)))
    (for (in node (..< (+ id 1) (as (. nodes length) SyntaxId)))
      (if (<= (call subtree-start node) id)
        (match? ([] nodes node)
          (case (call .node-markup row)
            (match? ([] nodes (. row slot-parameter))
              (case (call .node-markup-slot-parameter written)
                (return-if true (if (== (call identifier-name (. written name)) scope)))
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + takes-all (? String)
    (param pattern SyntaxId)
    (if (== pattern 0)
      (return "??")
    )
    (match? ([] nodes pattern)
      (case .node-type-wildcard
        (return "| _")
      )
      (case (call .node-type-capture row)
        (let name (call identifier-name (. row id)))
        (if (and (== (. row type) 0) name)
          (return (str "| " (. name text)))
        )
      )
    )
    (return null)
  )
  (fn-expr + name-text String
    (param id SyntaxId)
    (if-expr name (. name text) "")
    (where
      (lazy name (call identifier-name id))
    )
  )
  (fn-expr + uncovered-text String
    (param read SyntaxId)
    ; The error for an action that reads a name some way its pattern passes doesn't capture.
    (str "Capture " (call name-text read) " holds no value on some ways this arm matches; capture it in every alternative")
  )
  (fn-expr + bound U64
    (param id SyntaxId)
    ; The code point a bound of a range of characters is written as.
    (match ([] nodes id)
      (case (call .node-integer-syntax row)
        (. (call parse-integer-literal (. row value)) value)
      )
      (default
        0
      )
    )
  )
  (fn-do + negative-literal Bool
    (param id SyntaxId)
    ; Whether a node is a negative number written in source.
    (match? ([] nodes id)
      (case (call .node-integer-syntax row)
        (return (. (call parse-integer-literal (. row value)) negative))
      )
      (case (call .node-unary-expression row)
        (if (== (. row op) .negative-op)
          (match? ([] nodes (. row operand))
            (case .node-integer-syntax
              (return true)
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + chosen-line SyntaxId
    (param control SyntaxId)
    (param name Atom)
    (for (in arm (call region-arms control))
      (match? ([] nodes (call region-arm-body arm))
        (case (call .node-block block)
          (for (in line ([] children (. block body)))
            (match? ([] nodes line)
              (case (call .node-markup row)
                (if (== (call identifier-name (. row slot-binding)) name)
                  (return line)
                )
              )
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do + fills-name Bool
    (param control SyntaxId)
    (param name Atom)
    (return-if false (if (not (call holds-fills control))))
    (return (!= (call chosen-line control name) 0))
  )
  (fn-expr + is-written-zero Bool
    (param id SyntaxId)
    (match ([] nodes id)
      (case (call .node-integer-syntax row)
        (and (not (. row unit)) (== (. (call parse-integer-literal (. row value)) value) 0))
      )
      (default
        false
      )
    )
  )
  (fn-expr + switch-number U64
    (param expr SyntaxId)
    (match ([] nodes expr)
      (case (call .node-integer-syntax row)
        (. (call parse-integer-literal (. row value)) value)
      )
      (default
        (. U64 max)
      )
    )
  )
  (fn-expr + stream-bound U64
    (param id SyntaxId)
    ; The number a bound of a pattern's range or count is written as.
    (match ([] nodes id)
      (case (call .node-integer-syntax row)
        (. (call parse-integer-literal (. row value)) value)
      )
      (default
        0
      )
    )
  )
)
