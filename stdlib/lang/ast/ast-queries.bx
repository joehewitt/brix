  (fn-do + next-clause SyntaxId
    (param clause SyntaxId)
    ; The clause written after a clause, or none.
    (match? ([] nodes clause)
      (case (call .node-clause row)
        (return (. row next))
      )
    )
    (return 0)
  )
  (fn-do + branched Bool
    (param content SyntaxId)
    (param element SyntaxId)
    (param outlets _ (= false))
    ; Whether an element of a class's markup is written in an `if` or a `match` of it, or with
    ; `outlets` in the default content of a slot, and in no function or loop of it.
    (let found false)
    (for (in node (..< (+ element 1) content))
      (if (<= (call subtree-start node) element)
        (match? ([] nodes node)
          (case .node-function-syntax
            (return false)
          )
          (case .node-for-block
            (return false)
          )
          (case .node-if-block
            (= found true)
          )
          (case .node-match-expression
            (= found true)
          )
          (case .node-slot-outlet
            (= found (or found outlets))
          )
        )
      )
    )
    (return found)
  )
  (fn-do + branches-element Bool
    (param content SyntaxId)
    (param name Atom)
