  (fn-expr + is-alternative Bool
    (param pattern SyntaxId)
    (match ([] nodes pattern)
      (case .node-type-or
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + key-expr SyntaxId
    (param key SyntaxId)
    ; A map pattern's key is an equality on a literal or a `$name`: the expression it compares to.
    (match ([] nodes key)
      (case (call .node-type-equality row)
        (. row expr)
      )
      (default
        key
      )
    )
  )
  (fn-expr + pattern-is-else Bool
    (param pattern SyntaxId)
    (case? (== pattern 0)
      true
    )
    (default
      (match ([] nodes pattern)
        (case .node-type-wildcard
          true
        )
        (default
          false
        )
      )
    )
  )
  (fn-expr + predicate-expr SyntaxId
    (param pattern SyntaxId)
    (case? (== pattern 0)
      0
    )
    (default
      (match ([] nodes pattern)
        (case (call .node-type-predicate row)
          (. row expr)
        )
        (default
          0
        )
      )
    )
  )
  (fn-do + subject-property (? Atom)
    (param subject SyntaxId)
    ; The name of the property a subject reads from an object, or none.
    (match? ([] nodes subject)
      (case (call .node-get-expression row)
        (return (. row name))
      )
    )
    (return null)
  )
  (fn-do + gives-nothing Bool
    (param source StateSource)
    ; Whether a source of a case's payload gives no value, as the reference finds none there: a
    ; case one of whose names neither its trigger, if it has one, nor its owner's trigger captures.
    (if (not (is ([] nodes (. source node)) .node-state-case))
      (return false)
