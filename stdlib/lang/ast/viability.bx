(import ./decl)
(import ./module)
(import ./row-range)

(fn-do + viable Viability
  (param module Module)
  (param decl DeclId)
  (param calls (list CallArgument))
  (param slots (list U32))
  (match? ([] (. module decls) decl)
    (case (call .decl-function row)
      (return (call viable-shapes module row calls slots))
    )
  )
  (call (. slots clear))
  (return (call Viability .not-viable 0 0))
)

(fn-do + viable-shapes Viability
  (param module Module)
  (param row FunctionDecl)
  (param calls (list CallArgument))
  (param slots (list U32))
  (let count (. row args count))
  (let empty (. ArgumentFill fill-empty))
  (call (. slots clear))
  (for (in _ (..< 0 count))
    (+= slots empty)
  )
  (blank)
  (let is-variadic (!= (. row variadic-index) (. U32 max)))
  (let next 0u32)
  (let filled 0u32)
  (let tail 0u32)
  (let position 0u32)
  (for (in call calls)
    (let index position)
    (+= position 1)
    (if (. call is-skipped)
      (continue)
    )
    (if (. call name)
      (let found (call shape-index module row (. call name)))
      (if (and (== found (. U32 max)) (. call is-property))
        (continue)
      )
      (if (!= found (. U32 max))
        (if (!= ([] slots found) empty)
          (if (. call is-property)
            (continue)
          )
          (return (call Viability .not-viable 0 0))
        )
        (= ([] slots found) index)
        (if (> (+ found 1) filled)
          (= filled (+ found 1))
        )
        (if (== found next)
          (+= next 1)
        )
        (if is-variadic
          (+= tail 1)
        )
        (else-if (and is-variadic (>= index (. row variadic-index)) (not (. call is-variadic-list)))
          (+= tail 1)
        )
        (else
          (return (call Viability .not-viable 0 0))
        )
      )
      (else-if (and is-variadic (>= index (. row variadic-index)) (not (. call is-variadic-list)))
        (+= tail 1)
      )
      (else
        (if (< next count)
          (= ([] slots next) index)
        )
        (+= next 1)
        (if (> next filled)
          (= filled next)
        )
      )
    )
  )
  (blank)
  (if (!= tail 0)
    (if (< filled count)
      (= ([] slots filled) (. ArgumentFill fill-variadic))
    )
    (+= filled 1)
  )
  (blank)
  (if (!= count 0)
    (let offset 0)
    (for (in shape ([] (. module arg-pool) (. row args)))
      (if (and (== ([] slots offset) empty) (not (. shape has-default)))
        (return (call Viability .partially-viable filled tail))
      )
      (+= offset 1)
    )
  )
  (blank)
  (if (> filled count)
    (return (call Viability .not-viable 0 0))
  )
  (return (call Viability .fully-viable filled tail))
)

(fn-expr + shape-index U32
  (param module Module)
  (param row FunctionDecl)
  (param name Atom)
  (case? (== (. row args count) 0)
    (. U32 max)
  )
  (default
    (call scan-shapes module row name)
  )
)

(fn-do _ scan-shapes U32
  (param module Module)
  (param row FunctionDecl)
  (param name Atom)
  (let offset 0u32)
  (for (in shape ([] (. module arg-pool) (. row args)))
    (if (and (. shape name) (== (. shape name) name))
      (return offset)
    )
    (+= offset 1)
  )
  (return (. U32 max))
)
