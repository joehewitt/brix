────────────────────
+ get is-batch Bool

` Whether the program is a batch of cases, each a root module that starts in a task of its own.
batch-roots.length != 0

────────────────────
+ do runs-main Bool
    - module ModuleId

` Whether the statements of a module are a program's main: those of the entry module, or of the
` root module of each case of a batch.
if module == entry-module
    = true
for root in batch-roots
    if root == module as U32
        = true
= false

────────────────────
+ do shares-case Bool
    - first ModuleId
    - second ModuleId

` Whether some case of a batch reaches both of two modules, as each module of a program that is
` not one reaches every other.
if batch-roots.length == 0
    = true
. words = (batch-roots.length + 63) / 64
for word in 0 .. < words
    if (batch-cases[(first as Size) * words + word] /and/ second-cases) != 0
        = true
    .. second-cases = batch-cases[(second as Size) * words + word]
= false

────────────────────
+ do note-derived-names

. live = Map'Atom'Bool()
for module in modules
    for decl in module.decls
        do match? decl
            | .decl-function(fn)
                . name = fn.name
                if name
                    do match? module.tree.nodes[fn.syntax]
                        | .node-function-syntax(row)
                            if row.is-live
                                live[name] = true
. found = Map'Atom'Bool()
for module in modules
    for decl in module.decls
        do match? decl
            | .decl-property(row)
                . name = row.name
                if name && row.value != 0 && !row.is-lazy && reaches-live
                    found[name] = true
                .. reaches-live = reads-live(module.tree, row.value, live)
derived-names = found

────────────────────
+ is-derived-name Bool
    - name Atom

derived-names has name

────────────────────
+ do same-derived-names Bool
    - other Program

=? false if derived-names.length != other.derived-names.length
= all(derived-names.keys) • where other.derived-names has each

────────────────────
_ do reads-live Bool
    - tree AST
    - value SyntaxId
    - live Map'Atom'Bool

for node in tree.subtree-start(value) .. < value + 1
    do match? tree.nodes[node]
        | .node-identifier(row)
            =? true if row.is-tracked || live has row.name
        | .node-get-expression(row)
            =? true if row.is-tracked || live has row.name
        | .node-style-read-expression
            = true
        | .node-latest-expression
            = true
= false

────────────────────
+ do compiles-probe Bool
    - module ModuleId
    - decl DeclId
    - id SyntaxId

` Whether a probe written in a function of a module compiles (see `ProbeSelection`). Every one
` written in a function named `inspectable-snapshot`, which writes the snapshot of an object,
` compiles wherever probes do.
. snapshots = false
do match? modules[module].decls[decl]
    | .decl-function(row)
        snapshots = row.name != null && row.name.text == "inspectable-snapshot"
= probes.compiles-node(modules[module].name, modules[module].tree, id, snapshots)

────────────────────
+ do store-atom Atom
    - text String

` The atom of a text. One the parse made is found without the pool. Typing stores others on many
` threads at once, so the pool is locked.
. parsed = parse-atoms[text]
if parsed
    = parsed
use atom-lock
= atoms.store(text)

────────────────────
+ do atom-ordinal Index
    - atom Atom

` A number for an atom that no other atom has, and that does not depend on the order modules were
` parsed in: the atoms the modules made are numbered in the order of their texts, and others in
` the order they are first numbered, after all of those.
= numbered(atom, later-ordinals)

────────────────────
+ do atom-key Index
    - atom Atom

. carried = carried-keys
if carried
    use atom-lock
    . found = carried[atom]
    =? found if found
    . made = carried.length
    carried[atom] = made
    = made
= numbered(atom, later-keys)

────────────────────
_ do numbered Index
    - atom Atom
    - later Map'Atom'U32

. ranked = atom-ordinals[atom]
if ranked
    = ranked
use atom-lock
. found = later[atom]
=? found if found
. made = atom-ordinals.length + later.length
later[atom] = made
= made

────────────────────
+ do continue-keys
    - other Program

. carried = Map'Atom'U32()
. kept = other.carried-keys
if kept
    for atom, key in kept
        carried[atom] = key
else
    for atom, ordinal in other.atom-ordinals
        carried[atom] = ordinal
    for atom, key in other.later-keys
        carried[atom] = key
carried-keys = carried

────────────────────
+ shares-atoms-with Bool
    - other Program

atoms == other.atoms

────────────────────
+ module-by-path Index?
    - path String

|? found
    found

.. found = path-ids[store-atom(path)]

────────────────────
+ module-by-name Index?
    - name String

|? found
    found

.. found = module-names[store-atom(name)]

────────────────────
+ sees Bool
    - caller ModuleId
    - module ModuleId

` Whether a module can name what another declares: itself, or a module it imports.
ranks[caller * modules.length + module] != U16.max

────────────────────
+ listed U16
    - caller ModuleId
    - module ModuleId

` Where a module comes among those another can name, in the order the reference lists what
` they declare: the modules it imports first, and itself last. The most there is for a
` module it cannot name.
listing[caller * modules.length + module]

────────────────────
+ listed-last U32
    - caller ModuleId
    - module ModuleId

` Where a module comes last among those another can name, in the order `listed` follows; the
` reference looks for a type written by name from the last of these places to the first.
latest-listing[caller * modules.length + module]

────────────────────
+ lookup Candidates
    - caller ModuleId
    - name Atom

?! OutOfBoundsError("Program caller module index out of bounds")
    if caller >= modules.length

|? !name-id
    Candidates(this, caller, 0, 0)
??
    Candidates(this, caller, bucket-starts[name-id], bucket-starts[name-id + 1])

.. name-id = name-ids[name]

────────────────────
+ do c-constant-text String?
    - caller ModuleId
    - name Atom

` The number a constant a C header defines is written as, where a header module the caller
` imports declares one by the name, behind a minus sign when it is negative. A name read as a
` constant is that number written with no suffix.
for candidate in lookup(caller, name)
    . owner = modules[candidate.module]
    if owner.name.ends-with(".h")
        do match? owner.decls[candidate.decl]
            | .decl-property(property)
                do match? owner.tree.nodes[property.value]
                    | .node-integer-syntax(row)
                        = row.value
                    | .node-unary-expression(row)
                        do match? owner.tree.nodes[row.operand]
                            | .node-integer-syntax(literal)
                                if row.op == .negative-op
                                    = "-${literal.value}"
= null

────────────────────
+ do unseen-declarations [Candidate]
    - caller ModuleId
    - name Atom

. found [Candidate]
if caller >= modules.length
    = found
. name-id = name-ids[name]
if !name-id
    = found
for entry in bucket-starts[name-id] .. < bucket-starts[name-id + 1]
    if entry-rank(caller, entry) == U16.max
        found += Candidate(entry-modules[entry], entry-decls[entry], U16.max)
= found

────────────────────
+ do visible-names [Atom]
    - caller ModuleId

. found [Atom]
if caller >= modules.length
    = found
for name in name-ids.keys
    . name-id = name-ids[name]!
    for entry in bucket-starts[name-id] .. < bucket-starts[name-id + 1]
        if entry-rank(caller, entry) != U16.max
            found += name
            break
= found

────────────────────
+ do candidate-after (Size, Candidate?)
    - found Candidates
    - last-key Size

` The nearest candidate past the one whose key was last, with its own key. A key is the import
` distance and then the position among the name's declarations, and no key is zero.
. best-key = Size.max
. best-offset = Size.max
for entry in found.begin .. < found.end
    . rank = entry-rank(found.caller, entry)
    if rank != U16.max
        . key = (((rank as Size) + 1) /lshift/ 32) /or/ (entry - found.begin)
        if key < best-key && key > last-key
            best-key = key
            best-offset = entry
. none Candidate?
if best-offset == Size.max
    = (last-key, none)
. found-module = entry-modules[best-offset]
. found-rank = entry-rank(found.caller, best-offset)
= (best-key, Candidate(found-module, entry-decls[best-offset], found-rank))

────────────────────
_ do entry-rank U16
    - caller ModuleId
    - entry Size

` How far a module is through its imports from a declaration a name finds, or none. A facet's
` name is as near as its owner's module, whose import brings it.
. total = modules.length
. module = entry-modules[entry]
. rank = ranks[caller * total + module]
=? rank if rank != U16.max || module >= facets.hosts.length || facets.hosts[module] == U32.max
. facet = facets.index-of(module, entry-decls[entry])
=? rank if !facet || facets.states[facet] != .facet-bound
= ranks[caller * total + facets.owner-modules[facet]]

────────────────────
+ do facet-listed-last U32
    - caller ModuleId
    - module ModuleId

` Where a module that declares a facet comes last among those another can name, or where its
` owner's module does, whose import brings the facet's name.
. own = listed-last(caller, module)
=? own if own != U32.max || module >= facets.hosts.length || facets.hosts[module] == U32.max
= listed-last(caller, facets.hosts[module])

────────────────────
+ do extensions-for Extensions
    - caller ModuleId
    - module ModuleId
    - decl DeclId

?! OutOfBoundsError("Program caller module index out of bounds")
    if caller >= modules.length

for key in 0 .. < extension-key-modules.length
    if extension-key-modules[key] == module && extension-key-decls[key] == decl
        = Extensions(this, caller, extension-starts[key], extension-starts[key + 1])
= Extensions(this, caller, 0, 0)

────────────────────
+ do extension-after (Size, ExtensionRef?)
    - found Extensions
    - entry Size

` The first extension at or past an entry that the caller can see, with the entry after it. A
` facet is seen wherever its class is, but code in a module that declares facets of the class
` sees only those it reaches.
. total = modules.length
for position in entry .. < found.end
    . owner = extension-modules[position]
    . extension = extension-decls[position] as DeclId
    . facet = facets.index-of(owner, extension) if facets.count != 0
    if facet
        if owner == found.caller || sees-facet(found.caller, facet)
            = (position + 1, ExtensionRef(owner, extension))
    else if extension-ranks[found.caller * total + owner] != U16.max
        if extension-is-public(owner, extension) || reaches-private(found.caller, owner)
            = (position + 1, ExtensionRef(owner, extension))
. none ExtensionRef?
= (found.end, none)

────────────────────
+ do sees-facet Bool
    - caller ModuleId
    - facet U32

` Whether code in a module sees a facet: anywhere but a module other than its class's that declares
` facets of the class, and there, one of those, an ancestor of one, or one that one of them sees.
. owner-module = facets.owner-modules[facet]
. owner-decl = facets.owner-decls[facet]
=? true if caller == owner-module || !facets.declares-facet-of(caller, owner-module, owner-decl)
= facets.reaches(caller, facet)

────────────────────
+ same-family Bool
    - module ModuleId
    - other ModuleId

` Whether two modules are of one file family, or are one module.
module == other || (module < families.length && other < families.length && joined)

.. joined = families[module] == families[other]

────────────────────
+ reaches-access Bool
    - caller ModuleId
    - module ModuleId
    - access Access

` Whether code in a module reaches a declaration of a module with an access: a public one, one
` shared with the file family of the caller's own, and a private one as `reaches-private` says.
match access
    | .public-access
        true
    | .family-access
        same-family(caller, module)
    ??
        reaches-private(caller, module)

────────────────────
+ reaches-private Bool
    - caller ModuleId
    - module ModuleId

` Whether code in a module reaches the private declarations of a module: its own, and those of the
` module that declares the class of a facet it declares.
caller == module || (caller < facets.hosts.length && facets.hosts[caller] == module)

────────────────────
+ do effect-named U32?
    - caller ModuleId
    - name Atom

` The number of the effect a name names where code in a module sees it.
for candidate in lookup(caller, name)
    do match? modules[candidate.module].decls[candidate.decl]
        | .decl-effect(row)
            if is-public || reaches-private(caller, candidate.module)
                = effects.index-of(candidate.module, candidate.decl)
            .. is-public = row.access == .public-access
= null

────────────────────
+ do bans-named EffectMask
    - caller ModuleId
    - names RowRange'Atom

` The bans of the effects a `without` section names where code in a module sees them. A name
` that names no effect bans nothing; the binder reports it.
=? 0 if names.count == 0
. tree = modules[caller].tree
. mask EffectMask = 0
for offset in 0 .. < names.count
    . found = effect-named(caller, tree.atoms[names.start + offset])
    if found && found < most-effects()
        mask = mask /or/ ban-bit(found)
= mask

────────────────────
_ extension-is-public Bool
    - module ModuleId
    - decl DeclId

match modules[module].decls[decl]
    | .decl-extension(row)
        match row.access
            | .public-access
                true
            ??
                false
    ??
        false

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release-trees

` Frees every module's syntax tree and the name and extension index, which only name
` resolution reads. Declarations and atoms stay until release.
if !trees-released
    if !borrows
        for module in modules
            module.release-tree()
    index-arena.release()
    trees-released = true

────────────────────
+ do release

if !released
    release-trees()
    if !borrows
        for module in modules
            module.release()
        if !shares-atoms
            atoms.release()
    module-arena.release()
    released = true

