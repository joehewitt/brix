━━━━━━━━━━━━━━━━━━━━
+ CheckedDecl is Tuple

+ kind DeclKind
+ body SyntaxId
+ syntax SyntaxId
+ subtree SyntaxRange
+ is-generated Bool
+ is-imperative Bool
+ is-main Bool
+ is-content Bool

━━━━━━━━━━━━━━━━━━━━
+ do describe CheckedDecl?
    - program Program
    - module ModuleId
    - decl DeclId

. tree = program.modules[module].tree
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        . imperative = true
        do match? tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                imperative = syntax.imperative
            | .node-getter-syntax(syntax)
                imperative = syntax.imperative
            | .node-setter-syntax(syntax)
                imperative = syntax.imperative
        if fn.kind == .pipeline-decl
            imperative = false
        . is-main = fn.kind == .main-decl
        = CheckedDecl
            - fn.kind
            - fn.body
            - fn.syntax
            - fn.subtree
            - fn.is-generated
            - imperative
            - is-main
            - fn.is-content
    | .decl-converter(row)
        do match? tree.nodes[row.syntax]
            | .node-converter-syntax(node)
                = described-body(tree, row.syntax, node.body, node.imperative)
    | .decl-fromverter(row)
        do match? tree.nodes[row.syntax]
            | .node-fromverter-syntax(node)
                = described-body(tree, row.syntax, node.body, node.imperative)
= null

━━━━━━━━━━━━━━━━━━━━
+ do rule-match SyntaxId
    - program Program
    - module ModuleId
    - decl DeclId

` The stream pattern of a rule a module declares: the body of a function declared over the
` items of a stream, where the body is that pattern, beside any lazy locals declared for it.
` None for any other declaration.
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        . tree = program.modules[module].tree
        do match? tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                if syntax.pattern != 0 && !fn.is-generated
                    = tree.stream-statement(fn.body)
= 0

━━━━━━━━━━━━━━━━━━━━
_ described-body CheckedDecl
    - tree AST
    - syntax SyntaxId
    - body SyntaxId
    - imperative Bool

CheckedDecl(.function-decl, body, syntax, subtree, false, imperative, false)

.. start = tree.subtree-start(syntax)
.. subtree = SyntaxRange(start, syntax - start + 1)

━━━━━━━━━━━━━━━━━━━━
+ checks-at-declaration Bool
    - declaration CheckedDecl

` Whether how a function returns is checked as the module declares it (`check-return-mode`):
` a function, getter, setter or conversion written in the module as one expression.
declared-plain && declaration.body != 0 && (function-or-getter || declaration.kind == .setter-decl)

.. declared-plain = !declaration.is-generated && !declaration.is-imperative && !declaration.is-main
.. function-or-getter = declaration.kind == .function-decl || declaration.kind == .getter-decl
