./ast
./ast-nodes
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ ProbeSelection

` The probes a program compiles, from the selectors given to `--probes`, which spaces and commas
` part. None compile where probes are not enabled. Where they are and no selectors are given, every
` probe of a module named among `locals` compiles, and every log and group written with no key;
` selectors choose the probes in their place.
+ is-enabled Bool
+ selectors [String]
+ locals [String]
+ includes-defaults = false

────────────────────
+ This
    - is-enabled = false
    - text String = ""
    - locals [String] = List'String()

. selector = ""
for char in text
    if char == ' ' || char == ',' || char == '\t' || char == '\n' || char == '\r'
        if selector != ""
            selectors += selector
        selector = ""
    else
        selector += "$char"
if selector != ""
    selectors += selector
includes-defaults = selectors.length == 0

────────────────────
+ compiles-probe Bool
    - module String
    - name String?
    - key String?

` Whether a probe written in a module compiles. One with a `name` records an event, under its
` key where it has one, and any other writes to the log, as does a group.
|? !is-enabled
    false
|? is-local(module) || selects-all()
    true
|? logs && !key && includes-defaults
    true
|? !logs && names-namespace(key ?? name!, "event")
    true
|? logs && selects-log(key ?? "")
    true
??
    has("compiler") && module.starts-with("lang/")

.. logs = !name || name == "groupBegin" || name == "groupEnd"

────────────────────
+ compiles-statement Bool
    - module String
    - key String?

` Whether the statement a probe runs compiles: one with no key wherever probes do, and one with a
` key where a probe of that name would, or where its key is selected as a statement's.
|? !is-enabled
    false
|? !key
    true
??
    compiles-probe(module, key, key) || names-namespace(key, null) || selects-log(key) || names-namespace(key, "statement", false)

────────────────────
+ compiles-node Bool
    - module String
    - tree AST
    - id SyntaxId
    - snapshots Bool = false

` Whether a probe the syntax of a module writes compiles: every one written in a function that
` writes the snapshot of an object (`snapshots`), wherever probes compile, and any other as it is
` selected (`selects-node`).
(snapshots && is-enabled) || selects-node(module, tree, id)

────────────────────
_ selects-node Bool
    - module String
    - tree AST
    - id SyntaxId

` Whether a probe is selected: a probe with the lazy locals it reads as the probe is, and a group
` as the probe of its kind is, under a name for where it begins and ends.
match tree.nodes[id]
    | .node-probe(row)
        compiles-probe(module, row.name?.text, row.key?.text)
    | .node-probe-scope(row)
        row.body.count != 0 && compiles-node(module, tree, tree.children[row.body.start])
    | .node-probe-statement(row)
        compiles-statement(module, row.key?.text)
    | .node-probe-counter(row)
        compiles-counter(module, row.key.text) || is-profiled
        .. is-profiled = row.object == 0 && compiles-profile(row.key.text)
    | .node-probe-assign(row)
        compiles-probe(module, "set-property", row.key.text)
    | .node-probe-group(row)
        |? row.is-data
            compiles-data(module, row.key?.text ?? "") || compiles-profile(row.key?.text ?? "")
        ??
            compiles-probe
                - module
                - if row.is-begin then "groupBegin" else ("groupEnd" if row.is-end)
                - row.key?.text
    ??
        false

────────────────────
+ do compiles-safepoints Bool

` Whether loops look in on the probes as they run: wherever probes compile, unless every selector
` is one of the profile.
=? false if !is-enabled
for selector in selectors
    =? true if selector != "profile" && selector != "profile:*" && !selector.starts-with("profile:")
= selectors.length == 0

────────────────────
+ compiles-counter Bool
    - module String
    - name String

` Whether a counter compiles: in a module named among `locals`, under every selector of a counter,
` or one that names its namespace.
|? !is-enabled
    false
|? is-local(module) || has("counter") || has("counter:*")
    true
??
    names-namespace(name, "counter")

────────────────────
+ compiles-profile Bool
    - key String

` Whether a counter or a group of data compiles as a metric of the profile, which a selector of
` the profile or one that names its namespace asks for.
|? !is-enabled
    false
|? has("profile") || has("profile:*")
    true
??
    names-namespace(key, "profile")

────────────────────
+ compiles-data Bool
    - module String
    - key String

` Whether a group of data compiles: in a module named among `locals`, with no key, under every
` selector, or one that names its namespace alone or as data or an event, and in the compiler where
` it is selected.
|? !is-enabled
    false
|? is-local(module) || selects-all() || (key == "" && includes-defaults)
    true
|? names-namespace(key, null) || names-namespace(key, "data") || names-namespace(key, "event")
    true
??
    has("compiler") && module.starts-with("lang/")

────────────────────
_ is-local Bool
    - module String

includes-defaults && locals has module

────────────────────
_ selects-all Bool

has("*") || has("all")

────────────────────
_ has Bool
    - wanted String

some(selectors) • where each == wanted

────────────────────
_ do names-namespace Bool
    - namespace String
    - kind String?
    - wildcards Bool = true

` Whether a selector names a namespace or one inside it, written alone or after the `kind` it
` selects for, where `*` after a kind names every one unless `wildcards` is false.
for token in selectors
    =? true if token == "*" || token == "all"
    . selector = token
    . tag = token.find(":")
    if tag
        if !kind || token[0 .. < tag] != kind
            continue
        selector = token[tag + 1 ...]
    =? true if wildcards && selector == "*"
    =? true if in-namespace(namespace, selector)
= false

────────────────────
+ do compiles-metrics Bool
    - namespace String

` Whether the metrics the compiler counts of its own accord under a namespace compile: under every
` selector, every one of a counter or the profile, and one that names the namespace, alone or
` after either.
=? false if !is-enabled
for token in selectors
    =? true if token == "*" || token == "all" || token == "counter" || token == "profile"
    . selector = token
    . tag = token.find(":")
    if tag
        . kind = token[0 .. < tag]
        if kind != "counter" && kind != "profile"
            continue
        selector = token[tag + 1 ...]
    =? true if in-namespace(namespace, selector)
= false

────────────────────
_ do selects-log Bool
    - key String

` Whether the log is selected, or a log key that is the key of a probe or holds it, after `log:`
` or alone.
for token in selectors
    =? true if token == "log"
    if token.starts-with("log:")
        . selector = token[4 ...]
        =? true if selector == "*" || key == selector || in-namespace(key, selector)
    else if key != "" && !token.find(":")
        =? true if in-namespace(key, token)
= false

────────────────────
_ in-namespace Bool
    - namespace String
    - selector String

` Whether a namespace is the one a selector names or one inside it, where a selector may end in
` `.*`.
named != "" && (namespace == named || namespace.starts-with("$named."))

.. named = if selector.ends-with(".*") then selector[0 .. < selector.length - 2] else selector
