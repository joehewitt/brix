(import ./ast)
(import ./ast-nodes)
(import ./decl)
(import ./row-range)
(import /core/arena)
(import /core/array-builder)
(import /core/table)
(blank)
(type-line + ModuleId (is U32))
(prop + no-member _ (= (. U32 max)))

(type + MemberKey (is Tuple)
  (implements Hashable)
  (prop + owner U32)
  (prop + name Atom)
  (fn-expr + (infix this == (param other This)) _
    (and (== owner (. other owner)) (== name (. other name)))
  )
  (fn-expr + hash Hash :get
    (/xor/ (call hash-for name) (call hash-for owner))
  )
)

(type + MembersNamed (is Tuple)
  (implements (of CursorIterable DeclId U32))
  ; The members of a class or extension with a name, in the order the module declared them, as
  ; `Module.members-named` finds them.
  (blank)
  (prop + module Module)
  (prop + first U32)
  (fn-expr + initial-iterator-state U32 :get @inline
    first
  )
  (fn-do + next-iterator (tuple U32 (? DeclId)) @inline
    (param place U32)
    (if (== place no-member)
      (let none (? DeclId))
      (return (tuple place none))
    )
    (return (tuple ([] (. module member-links) place) ([] (. module member-pool) place)))
  )
)

(type + Module
  (implements (of Usable Void))
  (prop + path String)
  (prop + relative-path String)
  (prop + name String)
  (prop + tree AST)
  (prop + decls (of ImmutableTable Decl))
  (prop + member-pool (of ImmutableArray DeclId ArenaBacking))
  (prop + member-links (of ImmutableArray U32 ArenaBacking))
  (prop _ member-heads (of Map MemberKey U32 ArenaBacking))
  (prop + arg-pool (of ImmutableArray ArgumentShape ArenaBacking))
  (prop + syntax-pool (of ImmutableArray SyntaxId ArenaBacking))
  (prop + undeclared (of ImmutableArray SyntaxId ArenaBacking))
  (prop + undeclared-owners (of ImmutableArray DeclId ArenaBacking))
  (prop + made-atoms (of ImmutableArray Atom ArenaBacking))
  (prop + main-decl DeclId)
  (prop + init-decl DeclId)
  (prop + task-main-decl DeclId)
  (prop _ arena Arena)
  (prop _ tree-released Bool)
  (prop _ released Bool)
  (fn-do + This _
    (param path String)
    (param relative-path String)
    (param name String)
    (param tree AST)
    (param arena Arena)
    (param decls (of ImmutableTable Decl))
    (param member-pool (of ImmutableArray DeclId ArenaBacking))
    (param member-links (of ImmutableArray U32 ArenaBacking))
    (param member-heads (of Map MemberKey U32 ArenaBacking))
    (param arg-pool (of ImmutableArray ArgumentShape ArenaBacking))
    (param syntax-pool (of ImmutableArray SyntaxId ArenaBacking))
    (param undeclared (of ImmutableArray SyntaxId ArenaBacking))
    (param undeclared-owners (of ImmutableArray DeclId ArenaBacking))
    (param made-atoms (of ImmutableArray Atom ArenaBacking))
    (param main-decl DeclId)
    (param init-decl DeclId)
    (param task-main-decl DeclId)
  )
  (fn-expr + first-member U32
    (param members (of RowRange DeclId))
    (param name Atom)
    ; The place in the member pool of the first member of a class or extension with a name, or
    ; `no-member`. The next with the name is at the place in `member-links`.
    (if-expr (== (. members count) 0) no-member (?? ([] member-heads (call MemberKey (. members start) name)) no-member))
  )
  (fn-expr + members-named MembersNamed
    (param members (of RowRange DeclId))
    (param name Atom)
    ; The members of a class or extension with a name, which `first-member` and `member-links` chain.
    (call MembersNamed this (call first-member members name))
  )
  (fn-do + begin-using _)
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release-tree _
    ; Frees the syntax tree alone. The declarations, member pools, and argument shapes stay in the
    ; module arena until release.
    (if (not tree-released)
      (call (. tree release))
      (= tree-released true)
    )
  )
  (fn-do + release _
    (if (not released)
      (call release-tree)
      (call (. arena release))
      (= released true)
    )
  )
  (fn-do + has-event-member Bool
    (param members (of RowRange DeclId))
    ; Whether a class's or a facet's members hold an event.
    (for (in member ([] member-pool members))
      (return-if true (if (is ([] decls member) .decl-event)))
    )
    (return false)
  )
  (fn-do + member-event (? DeclId)
    (param members (of RowRange DeclId))
    (param name Atom)
    ; The event of a name among a class's or a facet's members.
    (for (in member (call members-named members name))
      (match? ([] decls member)
        (case (call .decl-event event)
          (return-if member (if (== (. event name) name)))
        )
      )
    )
    (return null)
  )
  (fn-expr + member-name (tuple (? Atom) Bool SyntaxId)
    (param member DeclId)
    (match ([] decls member)
      (case (call .decl-property row)
        (tuple (. row name) (!= (. row access) .private-access) (. row syntax))
      )
      (case (call .decl-function row)
        (tuple (. row name) (!= (. row access) .private-access) (. row syntax))
      )
      (case (call .decl-event row)
        (tuple (. row name) true (. row syntax))
      )
      (default
        (tuple null false 0)
      )
    )
  )
)

(fn-do + extension-ordinal U32
  (param module Module)
  (param decl DeclId)
  (let ordinal 0u32)
  (let index 0u32)
  (for (in row (. module decls))
    (if (== index decl)
      (return ordinal)
    )
    (match? row
      (case .decl-extension
        (+= ordinal 1)
      )
    )
    (+= index 1)
  )
  (return ordinal)
)

(fn-expr + plan-key U64
  (param module ModuleId)
  (param id SyntaxId)
  ; A node of the syntax of a module, as one number.
  (/or/ (/lshift/ (as module U64) 32) (as id U64))
)
