+ ModuleId is U32
+ no-member = U32.max

━━━━━━━━━━━━━━━━━━━━
+ MemberKey is Tuple
    is Hashable

+ owner U32
+ name Atom

────────────────────
+ this == other This

owner == other.owner && name == other.name

────────────────────
+ get hash Hash

hash-for(name) /xor/ hash-for(owner)

━━━━━━━━━━━━━━━━━━━━
+ MembersNamed is Tuple
    is CursorIterable'DeclId'U32

` The members of a class or extension with a name, in the order the module declared them, as
` `Module.members-named` finds them.

+ module Module
+ first U32

────────────────────
+ get initial-iterator-state U32 @inline

first

────────────────────
+ do next-iterator (U32, DeclId?) @inline
    - place U32

if place == no-member
    . none DeclId?
    = (place, none)
= (module.member-links[place], module.member-pool[place])

━━━━━━━━━━━━━━━━━━━━
+ Module
    is Usable'Void

+ path String
+ relative-path String
+ name String
+ tree AST
+ decls ImmutableTable'Decl
+ member-pool ImmutableArray'DeclId'ArenaBacking
+ member-links ImmutableArray'U32'ArenaBacking
_ member-heads Map'MemberKey'U32'ArenaBacking
+ arg-pool ImmutableArray'ArgumentShape'ArenaBacking
+ syntax-pool ImmutableArray'SyntaxId'ArenaBacking
+ undeclared ImmutableArray'SyntaxId'ArenaBacking
+ undeclared-owners ImmutableArray'DeclId'ArenaBacking
+ made-atoms ImmutableArray'Atom'ArenaBacking
+ main-decl DeclId
+ init-decl DeclId
+ task-main-decl DeclId
_ arena Arena
_ tree-released Bool
_ released Bool

────────────────────
+ This
    - path String
    - relative-path String
    - name String
    - tree AST
    - arena Arena
    - decls ImmutableTable'Decl
    - member-pool ImmutableArray'DeclId'ArenaBacking
    - member-links ImmutableArray'U32'ArenaBacking
    - member-heads Map'MemberKey'U32'ArenaBacking
    - arg-pool ImmutableArray'ArgumentShape'ArenaBacking
    - syntax-pool ImmutableArray'SyntaxId'ArenaBacking
    - undeclared ImmutableArray'SyntaxId'ArenaBacking
    - undeclared-owners ImmutableArray'DeclId'ArenaBacking
    - made-atoms ImmutableArray'Atom'ArenaBacking
    - main-decl DeclId
    - init-decl DeclId
    - task-main-decl DeclId

────────────────────
+ first-member U32
    - members RowRange'DeclId
    - name Atom

` The place in the member pool of the first member of a class or extension with a name, or
` `no-member`. The next with the name is at the place in `member-links`.
if members.count == 0 then no-member else member-heads[MemberKey(members.start, name)] ?? no-member

────────────────────
+ members-named MembersNamed
    - members RowRange'DeclId
    - name Atom

` The members of a class or extension with a name, which `first-member` and `member-links` chain.
MembersNamed(this, first-member(members, name))

────────────────────
+ do begin-using

────────────────────
+ do end-using

release()

────────────────────
+ do release-tree

` Frees the syntax tree alone. The declarations, member pools, and argument shapes stay in the
` module arena until release.
if !tree-released
    tree.release()
    tree-released = true

────────────────────
+ do release

if !released
    release-tree()
    arena.release()
    released = true

────────────────────
+ do has-event-member Bool
    - members RowRange'DeclId

` Whether a class's or a facet's members hold an event.
for member in member-pool[members]
    =? true if decls[member] is .decl-event
= false

────────────────────
+ do member-event DeclId?
    - members RowRange'DeclId
    - name Atom

` The event of a name among a class's or a facet's members.
for member in members-named(members, name)
    do match? decls[member]
        | .decl-event(event)
            =? member if event.name == name
= null

────────────────────
+ member-name (Atom?, Bool, SyntaxId)
    - member DeclId

match decls[member]
    | .decl-property(row)
        (row.name, row.access != .private-access, row.syntax)
    | .decl-function(row)
        (row.name, row.access != .private-access, row.syntax)
    | .decl-event(row)
        (row.name, true, row.syntax)
    ??
        (null, false, 0)

━━━━━━━━━━━━━━━━━━━━
+ do extension-ordinal U32
    - module Module
    - decl DeclId

. ordinal = 0u32
. index = 0u32
for row in module.decls
    if index == decl
        = ordinal
    do match? row
        | .decl-extension
            ordinal += 1
    index += 1
= ordinal

━━━━━━━━━━━━━━━━━━━━
+ plan-key U64
    - module ModuleId
    - id SyntaxId

` A node of the syntax of a module, as one number.
((module as U64) /lshift/ 32) /or/ (id as U64)
