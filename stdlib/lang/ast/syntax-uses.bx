(import ./ast)
(import ./ast-nodes)

(fn-do + uses-markup-syntax Bool
  (param tree AST)
  ; Whether a module writes markup, a slot, or the forwarding of a slot, which import the markup
  ; module into it.
  (for (in node (. tree nodes))
    (match? node
      (case .node-markup
        (return true)
      )
      (case .node-markup-slot-forward
        (return true)
      )
      (case .node-slot-outlet
        (return true)
      )
    )
  )
  (return false)
)

(fn-do + uses-probe-syntax Bool
  (param tree AST)
  ; Whether a module writes a probe, which imports the probes module into it where probes compile.
  (for (in node (. tree nodes))
    (match? node
      (case .node-probe
        (return true)
      )
      (case .node-probe-statement
        (return true)
      )
      (case .node-probe-counter
        (return true)
      )
      (case .node-probe-group
        (return true)
      )
      (case .node-probe-assign
        (return true)
      )
    )
  )
  (return false)
)

(fn-do + uses-style-sheet-syntax Bool
  (param tree AST)
  ; Whether a module declares a style sheet with `•`, or extends one, which imports the style
  ; module into it.
  (for (in node (. tree nodes))
    (match? node
      (case (call .node-class-block row)
        (if (. row is-style-sheet)
          (return true)
        )
      )
      (case .node-style-sheet-extension
        (return true)
      )
    )
  )
  (return false)
)

(fn-do + uses-stream-syntax Bool
  (param tree AST)
  (for (in node (. tree nodes))
    (match? node
      (case .node-pattern-helper-syntax
        (return true)
      )
      (case .node-stream-match
        (return true)
      )
      (case .node-stream-and
        (return true)
      )
      (case .node-stream-or
        (return true)
      )
      (case .node-stream-transform
        (return true)
      )
      (case .node-stream-panic
        (return true)
      )
      (case .node-stream-type
        (return true)
      )
      (case .node-stream-equality
        (return true)
      )
      (case .node-stream-length
        (return true)
      )
      (case .node-stream-unary
        (return true)
      )
      (case .node-stream-call
        (return true)
      )
      (case .node-stream-call-expression-argument
        (return true)
      )
      (case .node-stream-collector-mapping
        (return true)
      )
      (case .node-stream-predicate
        (return true)
      )
      (case .node-stream-capture
        (return true)
      )
      (case .node-stream-char-range
        (return true)
      )
      (case .node-stream-string
        (return true)
      )
      (case .node-stream-any
        (return true)
      )
    )
  )
  (return false)
)
