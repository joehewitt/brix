    )
    (case (call .node-catch-expression row)
      (call (. links one) (. row body))
      (call (. links all) ([] children (. row catchers)))
    )
    (case (call .node-tuple-syntax row)
      (call (. links all) ([] children (. row items)))
    )
    (case (call .node-list-syntax row)
      (call (. links all) ([] children (. row items)))
    )
    (case (call .node-iterable-expression row)
      (call (. links one) (. row expr))
    )
    (case (call .node-iterator-expression row)
      (call (. links one) (. row loop))
      (call (. links one) (. row body))
      (call (. links one) (. row next))
    )
    (case (call .node-optional-chain row)
      (call (. links one) (. row expr))
    )
    (case (call .node-argument row)
      (call (. links one) (. row expr))
    )
    (case (call .node-argument-decl row)
      (call (. links one) (. row pattern))
      (call (. links one) (. row default-value))
    )
    (case (call .node-assign row)
      (call (. links one) (. row lhs))
      (call (. links one) (. row rhs))
    )
    (case (call .node-clause row)
      (call (. links one) (. row expr))
      (call (. links one) (. row next))
    )
    (case (call .node-stream-match row)
      (call (. links one) (. row pattern))
      (call (. links one) (. row helper))
    )
    (case (call .node-stream-and row)
      (call (. links one) (. row left))
      (call (. links one) (. row right))
    )
    (case (call .node-stream-or row)
      (call (. links one) (. row left))
      (call (. links one) (. row right))
    )
    (case (call .node-stream-transform row)
      (call (. links one) (. row pattern))
      (call (. links one) (. row right))
    )
    (case (call .node-stream-panic row)
      (call (. links one) (. row pattern))
    )
    (case (call .node-stream-type row)
      (call (. links one) (. row type))
    )
    (case (call .node-stream-equality row)
      (call (. links one) (. row value))
    )
    (case (call .node-stream-length row)
      (call (. links one) (. row operand))
      (call (. links one) (. row min))
      (call (. links one) (. row max))
    )
    (case (call .node-stream-unary row)
      (call (. links one) (. row operand))
    )
    (case (call .node-stream-call row)
      (call (. links all) ([] children (. row params)))
      (call (. links all) ([] children (. row args)))
      (call (. links all) ([] children (. row collector-mappings)))
    )
    (case (call .node-stream-call-expression-argument row)
      (call (. links one) (. row expression))
    )
    (case (call .node-stream-predicate row)
      (call (. links one) (. row predicate))
    )
    (case (call .node-stream-capture row)
      (call (. links one) (. row name))
      (call (. links one) (. row pattern))
    )
    (case (call .node-stream-char-range row)
      (call (. links one) (. row first))
      (call (. links one) (. row last))
    )
    (case (call .node-probe row)
      (call (. links one) (. row object))
      (call (. links all) ([] children (. row content)))
    )
    (case (call .node-probe-group row)
      (call (. links all) ([] children (. row content)))
      (call (. links one) (. row object))
    )
    (case (call .node-probe-assign row)
      (call (. links one) (. row object))
      (call (. links one) (. row content))
    )
    (case (call .node-probe-counter row)
      (call (. links one) (. row object))
      (call (. links one) (. row delta))
    )
    (case (call .node-probe-snapshot row)
      (call (. links one) (. row content))
    )
    (case (call .node-probe-preview row)
      (call (. links one) (. row content))
    )
    (case (call .node-param-constraint row)
      (call (. links one) (. row left))
      (call (. links one) (. row right))
    )
    (case (call .node-param-assignment row)
      (call (. links one) (. row left))
      (call (. links one) (. row right))
    )
    (case (call .node-whenever-rule-syntax row)
