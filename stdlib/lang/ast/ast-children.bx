                )
              )
            )
            (return named)
          )
        )
      )
    )
    (return 0)
  )
  (fn-expr _ names-member Bool
    (param node SyntaxId)
    (param name Atom)
    ; Whether a node names a name: an identifier, or a member read by that name of any object.
    (match ([] nodes node)
      (case (call .node-identifier row)
        (== (. row name) name)
      )
      (case (call .node-ref-identifier row)
        (== (. row name) name)
      )
      (case (call .node-get-expression row)
        (== (. row name) name)
      )
      (default
        false
      )
    )
  )
  (fn-do + content-lines SyntaxId
    (param content SyntaxId)
    ; The block whose lines are the markup written in a class: the body of its root `<This`, or
    ; else the section itself, or the body of its `• This` where that writes the markup
    ; (`defaults-content`), whose lines that are the rule's own are none of it (`runs-line`). No
    ; block where the class writes none, or a root with no body.
    (if (== content 0)
      (return 0)
    )
    (let root (call root-this content))
    (match? ([] nodes root)
      (case (call .node-markup element)
        (return (. element body))
      )
    )
    (match? ([] nodes content)
      (case (call .node-content-block row)
        (return (. row body))
      )
      (case (call .node-rule-syntax row)
        (return (. row body))
      )
    )
    (return 0)
  )
  (fn-expr + is-empty-section Bool
    (param id SyntaxId)
    ; Whether a member of a type is a section with nothing written in it, which no type may hold.
    (match ([] nodes id)
      (case (call .node-content-block row)
        (match ([] nodes (. row body))
          (case (call .node-block block)
            (== (. block body count) 0)
          )
          (default
            false
          )
        )
      )
      (default
        false
      )
    )
  )
  (fn-expr + rule-part Bool
    (param statement SyntaxId)
    ; Whether a line of the body of a style rule is the rule's own: a line that declares a style, a
    ; `when`, a rule written in it, and a line that binds a slot or forwards one, which is content
    ; the rule generates.
    (match ([] nodes statement)
      (case .node-assign
        true
      )
      (case .node-style-when
        true
      )
      (case .node-rule-syntax
        true
      )
      (case .node-markup-slot-forward
        true
      )
      (case (call .node-markup row)
        (!= (. row slot-binding) 0)
      )
      (default
        false
      )
    )
  )
  (fn-expr + runs-line Bool
    (param content SyntaxId)
    (param statement SyntaxId)
    ; Whether a line of the block `content-lines` gives for a class's markup is a line of that
    ; markup: any but the rule's own where the markup is that of the class's `• This`.
    (or (not (is ([] nodes content) .node-rule-syntax)) (not (call rule-part statement)))
  )
  (fn-do + defaults-content Bool
    (param rule SyntaxId)
    ; Whether a style rule is a class's `• This` that writes its markup: a line of its body that is
    ; not the rule's own (`rule-part`). The reference makes those lines the class's markup and
    ; drops the content the rule would generate, so one that generates some is not taken for it.
    (match? ([] nodes rule)
      (case (call .node-rule-syntax row)
        (if (or (!= (. row name text) "This") (!= (. row args count) 0) (== (. row body) 0))
          (return false)
        )
        (let found false)
        (match? ([] nodes (. row body))
          (case (call .node-block block)
            (for (in statement ([] children (. block body)))
              (if (is ([] nodes statement) .node-markup-slot-forward)
                (return false)
              )
              (match? ([] nodes statement)
                (case (call .node-markup element)
                  (if (!= (. element slot-binding) 0)
                    (return false)
                  )
                )
              )
              (if (not (call rule-part statement))
                (= found true)
              )
            )
          )
        )
        (return found)
      )
    )
    (return false)
  )
  (fn-do + piped-feed SyntaxId
    (param pipe SyntaxId)
    ; The feed a stream piped through a pattern reads, where it is one feed alone that gives
    ; every item of what it writes: the reference evaluates what it writes inside the generator
    ; the pipe is, at its first pull. None for any other pipe.
    (let left SyntaxId 0)
    (match? ([] nodes pipe)
      (case (call .node-pipeline-expression row)
        (if (== (. row op) .grammar-pipe-op)
          (= left (. row left))
        )
      )
      (case (call .node-binary-expression row)
        (if (== (. row op) .grammar-pipe-op)
          (= left (. row lhs))
        )
      )
    )
    (match? ([] nodes left)
      (case (call .node-feed-expression row)
        (if (and (. row is-spread) (not (. row is-optional)) (== (. row next) 0))
          (return left)
        )
      )
    )
    (return 0)
  )
  (fn-do + listed-feeds SyntaxId
    (param consumer SyntaxId)
    (let written SyntaxId 0)
    (let callee SyntaxId 0)
    (match? ([] nodes consumer)
      (case (call .node-call-expression row)
        (if (and (== (. row param-count) 0) (== (. row operands count) 1) (not (. row is-curried)))
          (= written ([] children (. row operands start)))
          (= callee (. row callable))
        )
      )
      (case (call .node-pipeline-expression row)
        (if (== (. row op) .pipe-forward-op)
          (= written (. row left))
          (= callee (. row right))
        )
      )
    )
    (return-if 0 (if (or (== written 0) (not (call names-list callee)))))
    (match? ([] nodes written)
      (case (call .node-argument row)
        (= written (if-expr (or (. row name) (. row is-optional)) 0 (. row expr)))
      )
    )
    (match? ([] nodes written)
      (case (call .node-block row)
        (= written (if-expr (== (. row body count) 1) ([] children (. row body start)) 0))
      )
    )
    (return-if written (if (and (!= written 0) (is ([] nodes written) .node-feed-expression))))
    (return 0)
  )
  (fn-do _ names-list Bool
    (param callee SyntaxId)
    (match? ([] nodes callee)
      (case (call .node-type-identifier row)
        (return (== (. row name text) "List"))
      )
      (case (call .node-type-arguments row)
        (return (call names-list (. row base)))
      )
    )
    (return false)
  )
  (fn-do + whenever-clause SyntaxId
    (param loop SyntaxId)
    ; The `whenever` clause of a loop on a stream, which tests whether the loop is subscribed
    ; rather than whether an item passes: the first of its header's clauses that is one. None for
    ; any other loop.
    (match? ([] nodes loop)
      (case (call .node-loop-syntax row)
        (if (not (. row is-subscriber))
          (return 0)
        )
        (let current (. row clause))
        (while (!= current 0)
          (let next SyntaxId 0)
          (match? ([] nodes current)
            (case (call .node-clause clause)
              (if (== (. clause op) .whenever-clause)
                (return current)
              )
              (= next (. clause next))
            )
          )
          (= current next)
        )
      )
    )
    (return 0)
  )
  (fn-do + clause-loop SyntaxId
    (param clause SyntaxId)
    ; The loop header a clause is written in, or none.
    (for (in node (..< (+ clause 1) (. nodes length)))
      (if (<= ([] subtree-starts node) clause)
        (match? ([] nodes node)
          (case .node-loop-syntax
            (return (as node SyntaxId))
          )
        )
      )
    )
    (return 0)
  )
  (fn-do + lazies-only Bool
    (param body SyntaxId)
    ; Whether the body of an arm of a grammar only declares lazy locals, which the arm's
    ; pattern reads: such an arm gives what its pattern gives, as one with no body does.
    (match? ([] nodes body)
      (case (call .node-declare row)
        (return (. row is-lazy))
      )
      (case (call .node-block block)
        (if (== (. block body count) 0)
          (return false)
        )
        (for (in statement ([] children (. block body)))
          (match? ([] nodes statement)
            (case (call .node-declare row)
              (if (. row is-lazy)
                (continue)
              )
            )
          )
          (return false)
        )
        (return true)
      )
    )
    (return false)
  )
  (fn-expr + is-grammar Bool
    (param id SyntaxId)
    ; Whether a node is a grammar, as the pattern of a loop over what a stream matches is.
    (match ([] nodes id)
      (case .node-stream-match
        true
      )
      (case .node-stream-and
        true
      )
      (case .node-stream-or
        true
      )
      (case .node-stream-transform
        true
      )
      (case .node-stream-panic
        true
      )
      (case .node-stream-type
        true
      )
      (case .node-stream-equality
        true
      )
      (case .node-stream-length
        true
      )
      (case .node-stream-unary
        true
      )
      (case .node-stream-call
        true
      )
      (case .node-stream-predicate
        true
      )
      (case .node-stream-capture
        true
      )
      (case .node-stream-char-range
        true
      )
      (case .node-stream-string
        true
      )
      (case .node-stream-any
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + transformer-exception SyntaxId
    (param caught SyntaxId)
    (param catchers (of RowRange SyntaxId))
    ; The exception of a catch expression that declares error transformers: what it catches is a
    ; raise with no condition, and each catcher's error leaves the function as the exception from
    ; there on. None for any other.
    (case? (== (. catchers count) 0)
      0
    )
    (default
      (match ([] nodes caught)
        (case (call .node-assertion-syntax row)
          (if-expr (== (. row condition) 0) (. row exception) 0)
        )
        (default
          0
        )
      )
    )
  )
  (fn-do + post-order-violation (? SyntaxId)
    (let total (. nodes length))
    (return-if root (if (!= root (- total 1))))
    (for (in id (..< 1u32 total))
      (for (in child (call children-of id))
        (return-if child (if (and (>= child id) (not (call late-linked this id child)))))
      )
    )
    (return null)
  )
)

(fn-expr _ late-linked Bool
  (param tree AST)
  (param parent SyntaxId)
  (param child SyntaxId)
  (match ([] (. tree nodes) parent)
    (case (call .node-if-block row)
      (== child (. row next))
    )
    (case (call .node-for-block row)
      (== child (. row next))
    )
    (case (call .node-loop-syntax row)
      (== child (. row next))
    )
    (case (call .node-iterator-expression row)
      (== child (. row next))
    )
    (case (call .node-clause row)
      (== child (. row next))
    )
    (case (call .node-feed-expression row)
      (== child (. row next))
    )
    (case (call .node-structure-match row)
      (== child (. row pattern))
    )
    (case (call .node-stream-match row)
      (== child (. row pattern))
    )
    (case (call .node-binary-expression row)
      (and (== child (. row rhs)) (call holds tree child))
    )
    (default
      false
    )
  )
)

(fn-expr _ holds Bool
  (param tree AST)
  (param id SyntaxId)
  ; Whether a node holds the middle of a chain of orderings. The chain is known only when its
  ; next ordering is read, so the holder is made after the ordering it is the right side of.
  (match ([] (. tree nodes) id)
    (case .node-held-expression
      true
    )
    (default
      false
    )
  )
)
