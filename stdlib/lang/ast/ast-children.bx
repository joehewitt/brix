(type + ChildLinks
  (prop + ids (of ArrayBuilder SyntaxId ArenaBacking))
  (prop + ends (of Array U32 ArenaBacking))
  (prop + starts (of Array SyntaxId ArenaBacking))
  (fn-do + This _
    (param arena Arena)
    (param count Size)
    (call (. ids reserve) count)
    (if (!= count 0)
      (= ([] ends 0) 0)
      (= ([] starts 0) 0)
    )
    (blank)
    (lazy ids (call (of ArrayBuilder SyntaxId) arena))
    (lazy ends (call (of Array U32) arena count))
    (lazy starts (call (of Array SyntaxId) arena count))
  )
  (fn-do + one _
    (param id SyntaxId)
    (if (!= id 0)
      (call (. ids append) id)
    )
  )
  (fn-do + all _
    (param found (of ImmutableArray SyntaxId ArenaBacking))
    (for (in id found)
      (call (. ids append) id)
    )
  )
)

(fn-do + link-children ChildLinks
  (param arena Arena)
  (param nodes (of ImmutableTable Syntax))
  (param children (of ImmutableArray SyntaxId ArenaBacking))
  ; Every node's children, and where its subtree starts. A child linked after its parent was made
  ; has a higher id and can reach below it, so the starts settle over further passes.
  (let links (call ChildLinks arena (. nodes length)))
  (let unsettled false)
  (for (in id (..< 1u32 (. nodes length)))
    (let first (. links ids length))
    (call gather-children nodes children (as id SyntaxId) links)
    (let start id)
    (for (in position (..< first (. links ids length)))
      (let child ([] (. links ids) position))
      (if (> child id)
        (= unsettled true)
        (else-if (< ([] (. links starts) child) start)
          (= start ([] (. links starts) child))
        )
      )
    )
    (= ([] (. links starts) id) (as start SyntaxId))
    (= ([] (. links ends) id) (as (. links ids length) U32))
  )
  (while unsettled
    (= unsettled false)
    (for (in id (..< 1u32 (. nodes length)))
      (let start ([] (. links starts) id))
      (for (in position (..< ([] (. links ends) (- id 1)) ([] (. links ends) id)))
        (let child ([] (. links ids) position))
        (if (< ([] (. links starts) child) start)
          (= start ([] (. links starts) child))
        )
      )
      (if (!= start ([] (. links starts) id))
        (= ([] (. links starts) id) start)
        (= unsettled true)
      )
    )
  )
  (return links)
)

(extend + AST
  (fn-expr + children-of (of ImmutableArray SyntaxId ArenaBacking)
    (param id SyntaxId)
    ([] child-links (call (of RowRange SyntaxId) first (- ([] child-ends id) first)))
    (where
      (lazy first (if-expr (!= id 0) ([] child-ends (- id 1)) 0u32))
    )
  )
  (fn-expr + subtree-start SyntaxId
    (param id SyntaxId)
    ([] subtree-starts id)
  )
  (fn-do + stream-statement SyntaxId
    (param body SyntaxId)
    ; The grammar a match body runs on its subject: the body itself, or the one statement of a
    ; block beside the lazy locals declared for it. None for any other body.
    (match? ([] nodes body)
      (case .node-stream-match
        (return body)
      )
      (case (call .node-block block)
        (let found SyntaxId 0)
        (for (in statement ([] children (. block body)))
          (match? ([] nodes statement)
            (case (call .node-declare row)
              (if (. row is-lazy)
                (continue)
              )
            )
          )
          (if (or (!= found 0) (not (is ([] nodes statement) .node-stream-match)))
            (return 0)
          )
          (= found statement)
        )
        (return found)
      )
    )
    (return 0)
  )
  (fn-do + root-this SyntaxId
    (param content SyntaxId)
    ; The root `<This` of the markup written in a class: the first line of the section that is
    ; an element of the type `This`, or none.
    (match? ([] nodes content)
      (case (call .node-content-block row)
        (match? ([] nodes (. row body))
          (case (call .node-block block)
            (for (in statement ([] children (. block body)))
              (match? ([] nodes statement)
                (case (call .node-markup element)
                  (if (call names-this (. element type-id))
                    (return statement)
                  )
                )
              )
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do + names-this Bool
    (param type-id SyntaxId)
    ; Whether the type of a markup element is `This`, the class the markup is written in.
    (match? ([] nodes type-id)
      (case (call .node-type-identifier named)
        (return (and (== (. named name text) "This") (not (. named is-declare))))
      )
    )
    (return false)
  )
  (fn-do + attribute-element SyntaxId
    (param statement SyntaxId)
    ; The markup element a line that assigns is an attribute of, as a line of the element's
    ; body, or the slot outlet whose node it gives a property, as a line of the outlet's body; or
    ; none.
    (if (not (is ([] nodes statement) .node-assign))
      (return 0)
    )
    (let holder (call holder-of statement))
    (let element (call body-element holder))
    (if (!= element 0)
      (return element)
    )
