(import ./ast)
(import ./ast-nodes)
(import ./operator)
(import ./row-range)
(import /core/arena)
(import /core/array-builder)
(import /core/table)

(fn-do + gather-children _
  (param nodes (of ImmutableTable Syntax))
  (param children (of ImmutableArray SyntaxId ArenaBacking))
  (param id SyntaxId)
  (param links ChildLinks)
  (match? ([] nodes id)
    (case (call .node-top-level-syntax row)
      (call (. links all) ([] children (. row statements)))
    )
    (case (call .node-block row)
      (call (. links all) ([] children (. row body)))
    )
    (case (call .node-print row)
      (call (. links one) (. row body))
    )
    (case (call .node-declare row)
      (call (. links one) (. row left))
      (call (. links one) (. row right))
    )
    (case (call .node-assertion-syntax row)
      (call (. links one) (. row exception))
      (call (. links one) (. row condition))
    )
    (case (call .node-class-block row)
      (call (. links all) ([] children (. row type-args)))
      (call (. links one) (. row facet-of))
      (call (. links one) (. row base))
      (call (. links all) ([] children (. row or-bases)))
      (call (. links all) ([] children (. row members)))
      (call (. links all) ([] children (. row param-constraints)))
      (call (. links all) ([] children (. row param-assignments)))
    )
    (case (call .node-extension row)
      (call (. links one) (. row receiver))
      (call (. links all) ([] children (. row as-types)))
      (call (. links all) ([] children (. row param-constraints)))
      (call (. links all) ([] children (. row param-assignments)))
      (call (. links all) ([] children (. row body)))
    )
    (case (call .node-style-sheet-extension row)
      (call (. links one) (. row receiver))
      (call (. links all) ([] children (. row body)))
    )
    (case (call .node-event-declaration row)
      (call (. links one) (. row type))
      (call (. links one) (. row key-type))
    )
    (case (call .node-function-syntax row)
      (call (. links one) (. row pattern))
      (call (. links all) ([] children (. row args)))
      (call (. links all) ([] children (. row type-args)))
      (call (. links one) (. row return-type))
      (call (. links all) ([] children (. row errors)))
      (call (. links all) ([] children (. row param-constraints)))
      (call (. links all) ([] children (. row param-assignments)))
      (call (. links one) (. row body))
      (call (. links one) (. row property-site))
    )
    (case (call .node-getter-syntax row)
      (call (. links one) (. row pattern))
      (call (. links all) ([] children (. row args)))
      (call (. links all) ([] children (. row type-args)))
      (call (. links one) (. row return-type))
      (call (. links all) ([] children (. row errors)))
      (call (. links all) ([] children (. row param-constraints)))
      (call (. links all) ([] children (. row param-assignments)))
      (call (. links one) (. row body))
      (call (. links one) (. row property-site))
    )
    (case (call .node-setter-syntax row)
      (call (. links one) (. row pattern))
      (call (. links all) ([] children (. row args)))
      (call (. links all) ([] children (. row type-args)))
      (call (. links one) (. row return-type))
      (call (. links all) ([] children (. row errors)))
      (call (. links all) ([] children (. row param-constraints)))
      (call (. links all) ([] children (. row param-assignments)))
      (call (. links one) (. row body))
      (call (. links one) (. row property-site))
    )
    (case (call .node-property-syntax row)
      (call (. links one) (. row left))
      (call (. links one) (. row value))
    )
    (case (call .node-state-machine row)
      (call (. links all) ([] children (. row body)))
    )
    (case (call .node-state-case row)
      (call (. links all) ([] children (. row target)))
      (call (. links one) (. row trigger))
      (call (. links all) ([] children (. row body)))
    )
    (case (call .node-state-continuation row)
      (call (. links all) ([] children (. row target)))
      (call (. links one) (. row trigger))
      (call (. links all) ([] children (. row body)))
    )
    (case (call .node-state-fallback row)
      (call (. links all) ([] children (. row values)))
    )
    (case (call .node-state-trigger row)
      (call (. links all) ([] children (. row items)))
    )
    (case (call .node-state-match-expression row)
      (call (. links one) (. row subject))
      (call (. links one) (. row pattern))
    )
    (case (call .node-unit-declaration row)
      (call (. links one) (. row number))
      (call (. links one) (. row value))
    )
    (case (call .node-enum-declaration row)
      (call (. links one) (. row type))
      (call (. links one) (. row value))
    )
    (case (call .node-delegate-declaration row)
      (call (. links all) ([] children (. row types)))
    )
    (case (call .node-implements-declaration row)
      (call (. links one) (. row type))
    )
    (case (call .node-using-declaration row)
      (call (. links one) (. row type))
    )
    (case (call .node-sees-declaration row)
      (call (. links one) (. row type))
    )
    (case (call .node-style-domain-item row)
      (call (. links one) (. row domain))
      (call (. links one) (. row target))
    )
    (case (call .node-style-annotation row)
      (call (. links one) (. row left))
      (call (. links all) ([] children (. row domains)))
    )
    (case (call .node-dependency-declaration row)
      (call (. links one) (. row left))
      (call (. links all) ([] children (. row right)))
    )
    (case (call .node-content-block row)
      (call (. links one) (. row body))
    )
    (case (call .node-fromverter-syntax row)
      (call (. links one) (. row type))
      (call (. links one) (. row body))
    )
    (case (call .node-converter-syntax row)
      (call (. links one) (. row type))
      (call (. links all) ([] children (. row param-constraints)))
      (call (. links all) ([] children (. row param-assignments)))
      (call (. links one) (. row body))
    )
    (case (call .node-subscriber-syntax row)
      (call (. links one) (. row iterator))
    )
    (case (call .node-when-rule-syntax row)
      (call (. links one) (. row expr))
      (call (. links one) (. row body))
    )
    (case (call .node-rule-syntax row)
      (call (. links all) ([] children (. row args)))
      (call (. links one) (. row body))
      (call (. links all) ([] children (. row style-rule-applications)))
    )
    (case (call .node-style-when row)
      (call (. links one) (. row body))
    )
    (case (call .node-anonymous-case row)
      (call (. links all) ([] children (. row args)))
    )
    (case (call .node-use-expression row)
      (call (. links one) (. row expr))
    )
    (case (call .node-latest-expression row)
      (call (. links one) (. row expr))
    )
    (case (call .node-header-expression row)
      (call (. links one) (. row expr))
      (call (. links all) ([] children (. row items)))
    )
    (case (call .node-pipeline-expression row)
      (call (. links one) (. row left))
      (call (. links one) (. row right))
    )
    (case (call .node-feed-expression row)
      (call (. links one) (. row item))
      (call (. links one) (. row next))
    )
    (case (call .node-markup-head row)
      (call (. links one) (. row id))
      (call (. links one) (. row slot-binding))
    )
    (case (call .node-markup-slot-parameter row)
      (call (. links one) (. row name))
      (call (. links one) (. row type-id))
    )
    (case (call .node-markup row)
      (call (. links one) (. row type-id))
      (call (. links one) (. row id))
      (call (. links one) (. row slot-binding))
      (call (. links one) (. row slot-parameter))
      (call (. links all) ([] children (. row args)))
      (call (. links all) ([] children (. row style-rule-applications)))
      (call (. links one) (. row body))
    )
    (case (call .node-markup-slot-forward row)
      (call (. links one) (. row slot-binding))
      (call (. links one) (. row outlet))
    )
    (case (call .node-slot-outlet row)
      (call (. links one) (. row name))
      (call (. links one) (. row type-id))
      (call (. links one) (. row slot-parameter))
      (call (. links all) ([] children (. row slot-attrs)))
      (call (. links all) ([] children (. row style-rule-applications)))
      (call (. links one) (. row body))
    )
    (case (call .node-style-rule-application row)
      (call (. links all) ([] children (. row args)))
      (call (. links one) (. row condition))
    )
    (case (call .node-structure-match row)
      (call (. links one) (. row pattern))
    )
    (case (call .node-type-arguments row)
      (call (. links one) (. row base))
      (call (. links all) ([] children (. row args)))
    )
    (case (call .node-type-associated row)
      (call (. links one) (. row owner))
      (call (. links all) ([] children (. row args)))
    )
    (case (call .node-type-optional row)
      (call (. links all) ([] children (. row field-types)))
    )
    (case (call .node-type-tuple row)
      (call (. links all) ([] children (. row field-types)))
    )
    (case (call .node-type-capture row)
      (call (. links one) (. row id))
      (call (. links one) (. row type))
    )
    (case (call .node-type-predicate row)
      (call (. links one) (. row expr))
    )
    (case (call .node-type-equality row)
      (call (. links one) (. row expr))
    )
    (case (call .node-type-transform row)
      (call (. links one) (. row expr))
      (call (. links one) (. row pattern))
    )
    (case (call .node-type-panic row)
      (call (. links one) (. row pattern))
    )
    (case (call .node-type-and row)
      (call (. links one) (. row left))
      (call (. links one) (. row right))
    )
    (case (call .node-type-or row)
      (call (. links one) (. row left))
      (call (. links one) (. row right))
    )
    (case (call .node-type-relation row)
      (call (. links one) (. row left))
      (call (. links one) (. row right))
    )
    (case (call .node-type-match row)
      (call (. links one) (. row type))
    )
    (case (call .node-type-remainder row)
      (call (. links one) (. row name))
    )
    (case (call .node-type-list row)
      (call (. links all) ([] children (. row patterns)))
    )
    (case (call .node-type-map row)
      (call (. links all) ([] children (. row patterns)))
    )
    (case (call .node-type-map-item row)
      (call (. links one) (. row key))
      (call (. links one) (. row value))
    )
    (case (call .node-type-function row)
      (call (. links one) (. row return-type))
      (call (. links all) ([] children (. row args)))
      (call (. links all) ([] children (. row errors)))
    )
    (case (call .node-type-iterable row)
      (call (. links one) (. row pattern))
    )
    (case (call .node-type-case row)
      (call (. links one) (. row type))
      (call (. links one) (. row value))
    )
    (case (call .node-type-numeric row)
      (call (. links one) (. row value))
    )
    (case (call .node-if-block row)
      (call (. links one) (. row condition))
      (call (. links one) (. row body))
      (call (. links one) (. row next))
    )
    (case (call .node-while-block row)
      (call (. links one) (. row condition))
      (call (. links one) (. row body))
    )
    (case (call .node-for-block row)
      (call (. links one) (. row loop))
      (call (. links one) (. row body))
      (call (. links one) (. row next))
    )
    (case (call .node-do-block row)
      (call (. links one) (. row body))
    )
    (case (call .node-probe-statement row)
      (call (. links one) (. row body))
      (call (. links one) (. row object))
    )
    (case (call .node-do-finally-block row)
      (call (. links one) (. row body))
    )
    (case (call .node-do-task-block row)
      (call (. links one) (. row body))
      (call (. links one) (. row worker))
      (call (. links all) ([] children (. row catchers)))
    )
    (case (call .node-use-block row)
      (call (. links one) (. row subject))
      (call (. links one) (. row body))
    )
    (case (call .node-stack-local-binding-block row)
      (call (. links one) (. row value))
      (call (. links one) (. row body))
    )
    (case (call .node-loop-syntax row)
      (call (. links one) (. row pattern))
      (call (. links one) (. row container))
      (call (. links one) (. row clause))
      (call (. links one) (. row next))
    )
    (case (call .node-return row)
      (call (. links one) (. row expr))
    )
    (case (call .node-return-if-true row)
      (call (. links one) (. row condition))
      (call (. links one) (. row expr))
    )
    (case (call .node-yield row)
      (call (. links one) (. row expr))
    )
    (case (call .node-catcher row)
      (call (. links one) (. row body))
      (call (. links one) (. row type))
      (call (. links all) ([] children (. row previous)))
    )
    (case (call .node-unary-expression row)
      (call (. links one) (. row operand))
    )
    (case (call .node-binary-expression row)
      (call (. links one) (. row lhs))
      (call (. links one) (. row rhs))
    )
    (case (call .node-held-expression row)
      (call (. links one) (. row expr))
    )
    (case (call .node-cast-expression row)
      (call (. links one) (. row lhs))
      (call (. links one) (. row rhs))
    )
    (case (call .node-call-expression row)
      (call (. links one) (. row callable))
      (call (. links all) ([] children (. row operands)))
    )
    (case (call .node-range-expression row)
      (call (. links one) (. row left))
      (call (. links one) (. row right))
      (call (. links one) (. row increment))
    )
    (case (call .node-get-expression row)
      (call (. links one) (. row object))
    )
    (case (call .node-style-read-expression row)
      (call (. links one) (. row object))
    )
    (case (call .node-markup-read-expression row)
      (call (. links one) (. row object))
    )
    (case (call .node-index-expression row)
      (call (. links one) (. row object))
      (call (. links one) (. row index))
    )
    (case (call .node-match-expression row)
      (call (. links one) (. row subject))
      (call (. links one) (. row body))
      (call (. links one) (. row helper))
    )
    (case (call .node-pattern-helper-syntax row)
      (call (. links one) (. row helper))
    )
    (case (call .node-catch-optional-expression row)
