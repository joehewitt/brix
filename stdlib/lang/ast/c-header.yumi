+ allowed-word-chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
_ gc-leaf-suffix = ",yumi:gc_leaf"
_ gc-polling-suffix = ",yumi:gc_polling"

+ implicit-leaf-names List
    * "abs"
    * "labs"
    * "llabs"
    * "fabs"
    * "fabsf"
    * "floor"
    * "floorf"
    * "ceil"
    * "ceilf"
    * "round"
    * "roundf"
    * "trunc"
    * "truncf"
    * "fmod"
    * "fmodf"
    * "modf"
    * "modff"
    * "sqrt"
    * "sqrtf"
    * "cbrt"
    * "cbrtf"
    * "pow"
    * "powf"
    * "exp"
    * "expf"
    * "log"
    * "logf"
    * "log2"
    * "log2f"
    * "log10"
    * "log10f"
    * "sin"
    * "sinf"
    * "cos"
    * "cosf"
    * "tan"
    * "tanf"
    * "asin"
    * "asinf"
    * "acos"
    * "acosf"
    * "atan"
    * "atanf"
    * "atan2"
    * "atan2f"
    * "sinh"
    * "cosh"
    * "tanh"
    * "hypot"
    * "hypotf"
    * "strtol"
    * "strtoll"
    * "strtoul"
    * "strtoull"
    * "strtod"
    * "strtof"
    * "strlen"
    * "strcmp"
    * "strncmp"
    * "memcmp"

+ host-c-headers CHeaders := target-c-headers(host-target())

+ host-libclang String? := configured-libclang()

━━━━━━━━━━━━━━━━━━━━
+ CHeaders is Tuple

` Where a target's C headers are read: the directory its C library's headers are in, and the
` arguments that point the scanner at them. Headers read from a snapshot are its records, in place
` of what scanning gives, and a recording keeps the records of each header scanned.

+ target-name String
+ c-root Path
+ arguments [String]
+ snapshot CHeaderSnapshot? = null
+ recording CHeaderSnapshot? = null

━━━━━━━━━━━━━━━━━━━━
+ do target-c-headers CHeaders ?! Error
    - target Target

` A target whose entry in the runtime build config names a sysroot reads its headers there, parsed
` for its triple with the sysroot's GCC; the sysroot is installed with the target's runtime when it
` is missing. Every other target reads the default SDK's headers.
. entry = target-config(runtime-config(), target)
. sysroot-name = config-optional-string(entry, "sysroot")
if !sysroot-name
    = CHeaders(target.name, sdk-root / "usr/include", ["-isysroot", sdk-root as String])
. build-path = target-build-path(target, entry)
. sysroot = runtime-file(sysroot-name, build-path)
if !sysroot.exists
    build-runtime(target, build-path)
?! Error("The ${target.name} sysroot is not at $sysroot")
    if !sysroot.exists
. gcc = sysroot / config-string(entry, "gccInstallDirectory")
. arguments = ["-target", config-string(entry, "triple"), "--sysroot=$sysroot", "--gcc-install-dir=$gcc"]
= CHeaders(target.name, sysroot / "usr/include", arguments)

━━━━━━━━━━━━━━━━━━━━
+ do c-header-source String
    - headers CHeaders
    - include-paths [Path]
    - header String
    - wanted [String = Bool]

= c-records-source(c-header-records(headers, include-paths, header), wanted)

━━━━━━━━━━━━━━━━━━━━
+ do c-header-records String
    - headers CHeaders
    - include-paths [Path]
    - header String

` The records of `header`: the snapshot's when the headers are read from one, and otherwise the
` scanner's, from the cache while the files it read are unchanged.
. key = snapshot-key(headers.c-root, include-paths, header)
if headers.snapshot
    . kept = headers.snapshot.records(key)
    ?! Panic("The C header snapshot has no records of <$header>")
        if !kept
    = kept
. cache = scan-cache(headers, include-paths, header)
. records = cached-records(cache)
if !records
    records = scan-header(headers, include-paths, header)
    store-records(cache, include-paths, header, records)
if headers.recording && key
    headers.recording.keep(key, recorded-records(records, include-paths))
= records

━━━━━━━━━━━━━━━━━━━━
+ do snapshot-key String?
    - c-root Path
    - include-paths [Path]
    - header String

` The name a snapshot keeps the records of `header` under, the same on every host: its path in the
` C library's headers under `c/`, or in the runtime's include paths under `runtime/`.
. library = "$c-root/"
=? "c/${header[library.length ...]}" if header.starts-with(library)
for include in include-paths
    . root = "$include/"
    =? "runtime/${header[root.length ...]}" if header.starts-with(root)
= null

━━━━━━━━━━━━━━━━━━━━
_ do recorded-records String
    - records String
    - include-paths [Path]

` `records` as a snapshot keeps them, with the runtime's headers named as `snapshot-key` names
` them, not by where this host keeps them.
. recorded = records
for include in include-paths
    recorded = ",runtime/".join(recorded.split(",$include/"))
= recorded

━━━━━━━━━━━━━━━━━━━━
+ CHeaderFunction is Tuple

` A function a C header declares, with a key that every declaration of the same symbol shares where
` they agree on its linkage, type and annotations, or none where the scanner's records do not prove
` what the declaration is.

+ name String
+ declaration-key String?

━━━━━━━━━━━━━━━━━━━━
+ do c-header-functions [CHeaderFunction]
    - headers CHeaders
    - include-paths [Path]
    - header String

= c-records-functions(c-header-records(headers, include-paths, header))

━━━━━━━━━━━━━━━━━━━━
+ do c-records-functions [CHeaderFunction]
    - records String

. evidence [String = [String]]
. annotations [String = [String]]
. lines [String] = records.split("\n")
for line in lines
    . parts [String] = line.split(",")
    if parts.length < 5
        continue
    . key = ",".join(parts[1 .. < 4])
    if parts[0] == "D" && parts.length == 5 && parts[4].starts-with("v1:")
        . known = evidence[key] ?? List'String()
        known += declared-identity(parts[4])
        evidence[key] = known
    if parts[0] == "A"
        . known = annotations[key] ?? List'String()
        for annotation in parts[4 ...]
            if known.find(annotation) == null
                known += annotation
        annotations[key] = known

. functions [CHeaderFunction]
for line in lines
    . parts [String] = line.split(",")
    if parts.length < 5 || parts[0] != "F" || !is-c-identifier(parts[1])
        continue
    . key = ",".join(parts[1 .. < 4])
    . found = evidence[key]
    . declaration-key String? = null
    if parts[2].starts-with("/") && Int(parts[3]) > 0 && found && found.length == 1
        . proof = [parts[1], ",".join(parts[4 ...]), found[0]]
        proof ++= sort((annotations[key] ?? List'String()))
        declaration-key = "\n".join(proof)
    functions += CHeaderFunction(parts[1], declaration-key)
= functions

━━━━━━━━━━━━━━━━━━━━
_ declared-identity String
    - evidence String

` A declaration's evidence without the column and offset it is written at.
"v1:$identity"
.. identity = ":".join(fields[3 ...])
.. fields = List(evidence.split(":"))

━━━━━━━━━━━━━━━━━━━━
_ do scan-header String
    - headers CHeaders
    - include-paths [Path]
    - header String

. arguments [String]
arguments ++= headers.arguments
for include in include-paths
    arguments += "-I$include"
if host-libclang
    C:yumiCHeaderScanUseLibclang(host-libclang)
. status I32
. scanned = C:yumiCHeaderScan(header, "", "\n".join(arguments), &status)
?! Panic("Unable to scan the C header <$header>")
    if !scanned
. records = scanned as String
C:yumiCHeaderScanFree(scanned)
= records

━━━━━━━━━━━━━━━━━━━━
_ do configured-libclang String? ?! Error

` The libclang that the host's entry in the runtime build config names, which the scanner loads in
` place of finding one itself.
. entry = target-config(runtime-config(), host-target())
. name = config-optional-string(entry, "libclang")
=? null if !name
= runtime-file(name, target-build-path(host-target(), entry)) as String

━━━━━━━━━━━━━━━━━━━━
+ ScanCache is Tuple

+ records Path
+ manifest Path

━━━━━━━━━━━━━━━━━━━━
_ do scan-cache ScanCache
    - headers CHeaders
    - include-paths [Path]
    - header String

. version = C:yumiCHeaderScanVersion() as String
. key = "cheaderscan-$version|${headers.target-name}"
for argument in headers.arguments
    key += "|$argument"
for include in include-paths
    key += "|$include"
key += "|$header"
. root = Path(env("TMPDIR") ?? "/tmp") / "yumi" / "cheaderscan"
. base = root / "${file-word(header)}-${hash-for(key)}"
= ScanCache(Path("${base}.records"), Path("${base}.manifest"))

━━━━━━━━━━━━━━━━━━━━
_ do file-word String
    - text String

. word = ""
for char in text
    . piece = "$char"
    word += if allowed-word-chars.find(piece) != null then piece else "_"
= word

━━━━━━━━━━━━━━━━━━━━
_ do cached-records String?
    - cache ScanCache

. manifest = read-text(cache.manifest)
if !manifest
    = null
. lines [String] = manifest.split("\n")
if lines.length < 2
    = null
. records = read-text(cache.records)
if !records
    = null
if "${records.length}" != lines[0]
    = null
for position in 1 .. < lines.length
    . line = lines[position]
    if line.length == 0
        continue
    . parts [String] = line.split("|")
    if parts.length != 3
        = null
    . stamped = Path(parts[0])
    if !stamped.exists
        = null
    . time = stamped.stat.mtime
    if "${time.s}" != parts[1] || "${time.ns}" != parts[2]
        = null
= records

━━━━━━━━━━━━━━━━━━━━
_ do store-records
    - cache ScanCache
    - include-paths [Path]
    - header String
    - records String

if records.starts-with("M,") || records.find("\nM,") != null
    =
. dir = cache.records.dir
if !dir.is-dir
    . parent = dir.dir
    if !parent.is-dir
        catch parent.dir.make-directory(parent.name)
    catch parent.make-directory(dir.name)
if !dir.is-dir
    =
. files [String = Bool]
. lines [String] = records.split("\n")
for line in lines
    if !is-file-record(line)
        continue
    . parts [String] = line.split(",")
    if parts.length > 2 && parts[2].starts-with("/")
        files[parts[2]] = true
for include in include-paths
    . candidate = include / Path(header)
    if candidate.is-file
        files["$candidate"] = true
. manifest = "${records.length}\n"
for path, listed in files
    . stamped = Path(path)
    if !stamped.exists
        =
    . time = stamped.stat.mtime
    manifest += "$path|${time.s}|${time.ns}\n"
write-text(cache.records, records)
write-text(cache.manifest, manifest)

━━━━━━━━━━━━━━━━━━━━
_ is-file-record Bool
    - line String

line.starts-with("F,") || line.starts-with("S,") || line.starts-with("U,") || line.starts-with("A,")

━━━━━━━━━━━━━━━━━━━━
_ do read-text String?
    - path Path

if !path.is-file
    = null
= catch? read-file-text(path)

━━━━━━━━━━━━━━━━━━━━
_ do write-text
    - path Path
    - text String

. temp = Path("${path}.tmp")
. flags = FileFlags.write-mode + FileFlags.create-mode + FileFlags.truncate-mode
. file = catch? File(temp, flags)
if !file
    =
catch file.write(text)
catch file.close()
catch temp.move(path)

━━━━━━━━━━━━━━━━━━━━
+ do c-records-source String
    - records String
    - wanted [String = Bool]

. bytes = byte-view(records)
. data = bytes.data
. length = bytes.length
. structs [String = String]
. leaves [String = Bool]
. polling [String = Bool]
for name in implicit-leaf-names
    leaves[name] = true
. functions [String]
. constants [String]
. declared [String = Bool]
. base = (data as Pointer).address
. line-start Index
while line-start < length
    . line-end Index = length
    . newline = C:memchr(data + line-start, 10, length - line-start)
    if newline
        line-end = ((newline as Pointer).address - base) as Index
    . kind = data[line-start]
    if kind == 70
        . found = record-name(bytes, line-start, line-end)
        if found && wanted[found]
            functions += bytes.slice-string(line-start .. < line-end)
    else if kind == 75
        . constant = record-name(bytes, line-start, line-end)
        if constant && wanted[constant] && !declared[constant]
            declared[constant] = true
            . parts [String] = bytes.slice-string(line-start .. < line-end).split(",")
            constants += "+ C:$constant = ${parts[parts.length - 1]}"
    else if kind == 83 || kind == 85
        . struct-name = record-name(bytes, line-start, line-end)
        if struct-name
            structs[struct-name] = bytes.slice-string(line-start .. < line-end)
    else if kind == 65 && record-line-ends-with(bytes, line-start, line-end, gc-leaf-suffix)
        . leaf = record-name(bytes, line-start, line-end)
        if leaf
            leaves[leaf] = true
    else if kind == 65 && record-line-ends-with(bytes, line-start, line-end, gc-polling-suffix)
        . polled = record-name(bytes, line-start, line-end)
        if polled
            polling[polled] = true
    line-start = line-end + 1
. out [String]
out ++= constants
. written [String = Bool]
for line in functions
    append-function-source(line, structs, leaves, polling, written, out)
= "${"\n".join(out)}\n"

━━━━━━━━━━━━━━━━━━━━
_ do append-function-source
    - line String
    - structs [String = String]
    - leaves [String = Bool]
    - polling [String = Bool]
    - written [String = Bool]
    - out [String]

` Writes the declaration of one function a header declares. A header read as C++ declares a
` function once for each C type it overloads it by, and two of those can be one type here:
` `abs` of a `long` and of a `long long`. The declaration is written once.
. parts [String] = line.split(",")
if parts.length < 5
    =
. name = parts[1]
if !is-c-identifier(name)
    =
. returned = c-type-text(parts[4], structs)
if !returned
    =
. args [String]
for position in 5 .. < parts.length
    . part = parts[position]
    if part == "..."
        =
    if !append-argument(part, "a${position - 5}", "    ", structs, args)
        =
. head = if returned != "Void" then "+ do C:$name ${returned}" else "+ do C:$name"
. signature = "$head\n${"\n".join(args)}"
if written[signature] == true
    =
written[signature] = true
out += thick-divider()
. annotated = if polling[name] == true then head ++ " without blocking" else head
out += if leaves[name] == true then head ++ " without gc" else annotated
for arg in args
    out += arg
out += ""

━━━━━━━━━━━━━━━━━━━━
_ do append-argument Bool
    - part String
    - name String
    - indent String
    - structs [String = String]
    - lines [String]

` Declares one argument, and says whether its type maps. A pointer to a C function is the C
` function type of what it returns, with what it takes declared beneath it; one that takes any
` number of arguments is a plain pointer.
. trimmed = part.trim()
if !trimmed.starts-with("fnptr(") || !trimmed.ends-with(")")
    . mapped = c-type-text(part, structs)
    if !mapped
        = false
    lines += "${indent}- $name $mapped"
    = true
. pieces = top-level-parts(trimmed[6 .. < trimmed.length - 1])
if pieces.length == 0
    = false
if pieces[pieces.length - 1] == "..."
    lines += "${indent}- $name Pointer"
    = true
. returned = c-type-text(pieces[0], structs)
if !returned
    = false
lines += "${indent}- $name (*C) $returned"
for position in 1 .. < pieces.length
    if !append-argument(pieces[position], "a${position - 1}", indent ++ "    ", structs, lines)
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do top-level-parts [String]
    - text String

` The parts of a function pointer record, split at the semicolons outside any nested record.
. parts [String]
. piece = ""
. depth = 0
for char in text
    if char == '('
        depth += 1
    else if char == ')'
        depth -= 1
    if char == ';' && depth == 0
        parts += piece
        piece = ""
    else
        piece += char
if piece.length != 0
    parts += piece
= parts

━━━━━━━━━━━━━━━━━━━━
_ do record-name String?
    - bytes Byte[]
    - start Index
    - end Index

. data = bytes.data
if end - start < 3 || data[start + 1] != 44
    = null
. cursor = start + 2
while cursor < end && data[cursor] != 44
    cursor += 1
if cursor == end
    = null
= bytes.slice-string(start + 2 .. < cursor)

━━━━━━━━━━━━━━━━━━━━
_ do record-line-ends-with Bool
    - bytes Byte[]
    - start Index
    - end Index
    - suffix String

. suffix-bytes = byte-view(suffix)
if end - start < suffix-bytes.length
    = false
. offset = end - suffix-bytes.length
for index in 0 .. < suffix-bytes.length
    if bytes[offset + index] != suffix-bytes[index]
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ thick-divider String

"━" * 100

━━━━━━━━━━━━━━━━━━━━
_ do is-c-identifier Bool
    - name String

if name.length == 0 || name.starts-with("operator")
    = false
for forbidden in [":", "<", "~", " "]
    if name.find(forbidden) != null
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do c-struct-text String?
    - record String
    - structs [String = String]

` A struct passed by value is the struct of its fields; a union, or a field with no mapped
` type, leaves the function that takes it undeclared.
. parts [String] = record.split(",")
if parts.length < 6 || parts[0] != "S"
    = null
. fields [String]
. position = 4
while position + 1 < parts.length
    . mapped = c-type-text(parts[position + 1], structs)
    if !mapped || !is-c-identifier(parts[position])
        = null
    fields += "${parts[position]} $mapped"
    position += 2
= "C:(${", ".join(fields)})"

━━━━━━━━━━━━━━━━━━━━
_ do c-type-text String?
    - text String
    - structs [String = String]

. trimmed = text.trim()
if trimmed.starts-with("const ")
    trimmed = trimmed[6 ...].trim()
if trimmed.starts-with("fnptr(")
    = "Pointer"
. pointers = 0
while trimmed.ends-with("*")
    trimmed = trimmed[... trimmed.length - 1].trim()
    pointers += 1
if trimmed.length == 0
    = null
. record = structs[trimmed]
if record != null && pointers == 0
    = c-struct-text(record, structs)
. remaining = pointers
while remaining >= 0
    . key = trimmed
    for _ in 0 .. < remaining
        key += "*"
    . mapped = c-type-name(key)
    if mapped
        = pointer-wrapped(mapped, pointers - remaining)
    remaining -= 1
= pointer-wrapped("I8", 1)

━━━━━━━━━━━━━━━━━━━━
_ pointer-wrapped String
    - name String
    - pointers Int

|? pointers <= 0
    name
|? pointers == 1
    "CPointer'$name"
??
    "CPointer'(${pointer-wrapped(name, pointers - 1)})"

━━━━━━━━━━━━━━━━━━━━
_ c-type-name String?
    - key String

match? key
    |= "void"
        "Void"
    |= "bool"
        "Bool"
    |= "char"
        "Char8"
    |= "signed char"
        "I8"
    |= "unsigned char"
        "U8"
    |= "wchar_t"
        "I32"
    |= "short"
        "I16"
    |= "unsigned short"
        "U16"
    |= "int"
        "I32"
    |= "unsigned int"
        "U32"
    |= "long"
        "I64"
    |= "unsigned long"
        "U64"
    |= "long long"
        "I64"
    |= "unsigned long long"
        "U64"
    |= "float"
        "F32"
    |= "double"
        "F64"
    |= "long double"
        "F128"
    |= "string"
        "String"
    |= "YumiStringData*"
        "String"
    |= "struct YumiStringData*"
        "String"
    |= "size_t"
        "Size"
    |= "time_t"
        "I64"
