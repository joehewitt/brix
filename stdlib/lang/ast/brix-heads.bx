(import /core/arena)
(import /data/sexp)
(blank)
(prop _ brix-head-mask Index (= 1023))
(prop + brix-head-names _ (:= (call brix-built-head-names)))
(prop _ brix-head-bytes _ (:= (call brix-built-head-bytes)))
(prop _ brix-head-slots _ (:= (call brix-built-head-slots)))

(fn-do + brix-form-heads (of Array U8 ArenaBacking)
  (param tape SexpTape)
  (param arena Arena)
  (let heads (call (of Array U8) arena (+ (. tape length) 1)))
  (let kinds (. heads data))
  (let bytes (. tape bytes))
  (for (in index (..< 0 (. tape length)))
    (let first (+ index 1))
    (if (and (call (. tape is-open) index) (call (. tape is-atom) first))
      (= ([] kinds index) (as (call brix-head bytes (call (. tape start) first) (call (. tape end) first)) U8))
      (else
        (= ([] kinds index) 0)
      )
    )
  )
  (= ([] kinds (. tape length)) 0)
  (return heads)
)

(fn-expr + brix-head BrixHead
  (param bytes (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (case? (!= found .none)
    found
  )
  (case? (or (< (- end start) 2) (!= ([] bytes (- end 1)) 63))
    .none
  )
  (default
    (call brix-head-slot bytes start (- end 1))
  )
  (where
    (lazy found (call brix-head-slot bytes start end))
  )
)

(fn-do + brix-head-slot BrixHead
  (param bytes (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (let slots brix-head-slots)
  (let keys brix-head-bytes)
  (let slot (/and/ (call brix-head-hash bytes start end) brix-head-mask))
  (while (!= ([] slots slot) 0)
    (let found (as ([] slots slot) Index))
    (let key ([] keys found))
    (if (and (== (. key length) (- end start)) (call brix-span-equal key bytes start))
      (return (as found BrixHead))
    )
    (= slot (/and/ (+ slot 1) brix-head-mask))
  )
  (return .none)
)

(fn-do _ brix-head-hash Index
  (param bytes (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (let data (as bytes (of CPointer Byte)))
  (let hash 2166136261u32)
  (for (in index (..< start end))
    (= hash (* (/xor/ hash (as ([] data index) U32)) 16777619))
  )
  (return hash)
)

(fn-do + brix-span-equal Bool
  (param expected (of ImmutableArray Byte))
  (param bytes (of ImmutableArray Byte))
  (param start Index)
  (for (in offset (..< 0 (. expected length)))
    (return-if false (if (!= ([] expected offset) ([] bytes (+ start offset)))))
  )
  (return true)
)

(fn-expr _ brix-built-head-bytes (list (of ImmutableArray Byte))
  (spread (in (call byte-view each) brix-head-names))
)

(fn-do _ brix-built-head-slots (list U16)
  (let slots (call List (in 0u16 (.. 0 brix-head-mask))))
  (let keys brix-head-bytes)
  (for (in found (..< 1 (. keys length)))
    (let key ([] keys found))
    (let slot (/and/ (call brix-head-hash key 0 (. key length)) brix-head-mask))
    (while (!= ([] slots slot) 0)
      (= slot (/and/ (+ slot 1) brix-head-mask))
    )
    (= ([] slots slot) (as found U16))
  )
  (return slots)
)

