(import /BxCore/BxString.h)
(import /core/arena)
(import /math)
(blank)
(prop + indent-size _ (= 4))
(prop _ literal-close _ (= (char "\ufdd0")))

(fn-do + preparse _
  (param source String)
  (param scratch Arena)
  (param dividers (? (list PreparseDivider)) (= null))
  (let input (call byte-view source))
  (let line-count Size 1)
  (let codepoint-count Size 0)
  (let byte-count Size 0)
  (while (and (< byte-count (. input size)) (!= ([] input byte-count) 0))
    (let byte ([] input byte-count))
    (if (== byte 10)
      (+= line-count 1)
    )
    (if (or (< byte 128) (>= byte 192))
      (+= codepoint-count 1)
    )
    (+= byte-count 1)
  )
  (call C:brixStringValidateUtf8 input byte-count
    (block
      (throw (call Panic "Unable to read UTF8 content") (if it))
    )
  )
  (= input ([] input (..< 0 byte-count)))
  (blank)
  (let output (call PreparseBuffer scratch (+ (* codepoint-count 2) (* line-count 4) 8)))
  (let source-cursor Index 0)
  (let last-text-line Index 0)
  (let last-text-end Index 0)
  (let previous-line-start Index 0)
  (let previous-line-end Index 0)
  (let indent-level 0)
  (let header-level 0)
  (let last-line-header 0)
  (let expecting-paragraph false)
  (let expecting-text false)
  (let is-paragraph false)
  (let prefix-next-line false)
  (let block-indent -1)
  (let block-end Index 0)
  (let block-line Index 0)
  (blank)
  ; Process the split lines plus the sentinel line that the grammar expects.
  (for (in line-no (..< 0 (+ line-count 1)))
    (let line-start source-cursor)
    (let line-end source-cursor)
    (if (< line-no line-count)
      (while (and (< line-end (. input size)) (!= ([] input line-end) 10))
        (+= line-end 1)
      )
      (= source-cursor (+ line-end 1))
    )
    (blank)
    (if (>= block-indent 0)
      (let is-blank (call is-blank-line input line-start line-end))
      (if (and (< line-no line-count) (or is-blank (> (call parse-indent input line-start line-end) block-indent)))
        (let text-start (. output length))
        (if (not is-blank)
          (call (. output append) input (+ line-start (* (+ block-indent 1) indent-size)) line-end)
          (call (. output mark-literal-closes) text-start)
          (= block-end (. output length))
          (= block-line line-no)
        )
        (= previous-line-start text-start)
        (= previous-line-end (. output length))
        (call (. output append) (char "\n"))
        (continue)
      )
      (call (. output insert) (char "≥") block-end)
      (if (> previous-line-start block-end)
        (+= previous-line-start 1)
      )
      (if (>= previous-line-end block-end)
        (+= previous-line-end 1)
      )
      (= last-text-end (+ block-end 1))
      (= last-text-line block-line)
      (= block-indent -1)
    )
    (blank)
    (let prefix-line prefix-next-line)
    (= prefix-next-line false)
    (if (and prefix-line (call is-header-line input line-start line-end))
      (call (. output insert) (char "Æ") previous-line-end)
      (call (. output insert) (char "≥") (+ previous-line-end 1))
      (+= previous-line-end 2)
      (= prefix-line false)
      (= expecting-text false)
    )
    (let line-has-content (or prefix-line (> line-end line-start)))
    (blank)
    (let first-content line-start)
    (while (and (< first-content line-end) (call is-whitespace ([] input first-content)))
      (+= first-content 1)
    )
    (blank)
    (let is-comment
      (scope (and is-plain-line (< first-content line-end) (== ([] input first-content) 96))
        (lazy is-plain-line (and (not prefix-line) (not is-paragraph)))
      )
    )
    (let output-kind 0)
    (let paragraph-access (? Index))
    (let current-suffix-count 0)
    (blank)
    (if is-comment
      (= output-kind 1)
      (else
        (if (not is-paragraph)
          (let indent (if-expr (not prefix-line) (call parse-indent input line-start line-end) 0))
          (if (> indent indent-level)
            (if (== last-text-line line-no)
              (+= current-suffix-count 1)
              (else
                (call (. output insert) (char "≤") last-text-end)
                (+= last-text-end 1)
                (+= previous-line-end 1)
              )
            )
            (else-if (and line-has-content (< indent indent-level))
              (for (in _ (..< indent indent-level))
                (if (== last-text-line line-no)
                  (+= current-suffix-count 1)
                  (else
                    (call (. output insert) (char "≥") last-text-end)
                    (+= last-text-end 1)
                    (+= previous-line-end 1)
                  )
                )
              )
            )
          )
          (blank)
          (if line-has-content
            (= indent-level indent)
          )
        )
        (blank)
        (let is-header1 (and (not prefix-line) (call is-repeated-char input line-start line-end (char "━"))))
        (let is-header2 (and (not prefix-line) (call is-repeated-char input line-start line-end (char "─"))))
        (let is-header3 (and (not prefix-line) (call is-repeated-char input line-start line-end (char "═"))))
        (= paragraph-access (only-if (call find-paragraph-marker input line-start line-end) (if (not prefix-line))))
        (let is-paragraph-line (!= paragraph-access null))
        (let is-empty-line (and (not prefix-line) (== first-content line-end)))
        (blank)
        (if is-header1
          (if (== header-level 1)
            (call (. output insert) (char "≥") previous-line-end)
            (+= previous-line-end 1)
            (if (== last-text-line (- line-no 1))
              (+= last-text-end 1)
            )
            (else-if (== header-level 2)
              (for (in _ (..< 0 2))
                (call (. output insert) (char "≥") previous-line-end)
                (+= previous-line-end 1)
                (if (== last-text-line (- line-no 1))
                  (+= last-text-end 1)
                )
              )
            )
          )
          (blank)
          (if is-paragraph
            (call (. output insert) (char "≥") previous-line-end)
            (+= previous-line-end 1)
            (if (== last-text-line (- line-no 1))
              (+= last-text-end 1)
            )
            (= is-paragraph false)
          )
          (blank)
          (= output-kind 2)
          (= current-suffix-count 0)
          (= header-level 1)
          (= last-line-header 1)
          (if dividers
            (+= dividers (call PreparseDivider line-no true))
          )
          (else-if is-header2
            (if (== header-level 2)
              (call (. output insert) (char "≥") previous-line-end)
              (+= previous-line-end 1)
              (if (== last-text-line (- line-no 1))
                (+= last-text-end 1)
              )
            )
            (blank)
            (if is-paragraph
              (call (. output insert) (char "≥") previous-line-end)
              (+= previous-line-end 1)
              (if (== last-text-line (- line-no 1))
                (+= last-text-end 1)
              )
              (= is-paragraph false)
            )
            (blank)
            (= output-kind 2)
            (= current-suffix-count 0)
            (= header-level 2)
            (= last-line-header 2)
            (if dividers
              (+= dividers (call PreparseDivider line-no false))
            )
          )
          (else-if is-header3
            (if is-paragraph
              (call (. output insert) (char "≥") previous-line-end)
              (+= previous-line-end 1)
              (if (== last-text-line (- line-no 1))
                (+= last-text-end 1)
              )
              (= output-kind 1)
              (= is-paragraph false)
              (else
                (= output-kind 3)
              )
            )
            (= current-suffix-count 0)
          )
          (else-if (and is-paragraph-line (not is-paragraph))
            (= expecting-paragraph true)
            (= output-kind 4)
            (= current-suffix-count 0)
            (= last-line-header 0)
          )
          (else-if (and is-empty-line (not is-paragraph))
            (if expecting-paragraph
              (= prefix-next-line true)
              (= expecting-paragraph false)
              (= expecting-text true)
            )
            (if (== last-line-header 1)
              (call (. output remove) previous-line-start previous-line-end)
              (if (== last-text-line (- line-no 1))
                (= last-text-end previous-line-start)
              )
              (= previous-line-end previous-line-start)
              (= header-level 0)
              (= last-line-header 0)
            )
          )
          (else
            (= last-line-header 0)
            (blank)
            (if expecting-text
              (= expecting-text false)
              (= is-paragraph true)
            )
          )
        )
        (blank)
        (let current-line-start (. output length))
        (let block-at (if-expr (and (== output-kind 0) (not prefix-line) (not is-paragraph)) (call find-block-marker input first-content line-end) null))
        (if block-at
          (call (. output append) input line-start block-at)
          (= block-end (. output length))
          (= block-line line-no)
          (= block-indent (call parse-indent input line-start line-end))
          (else-if (== output-kind 0)
            (if prefix-line
              (call (. output append) (char "Æ"))
            )
            (call (. output append) input line-start line-end)
            (if is-paragraph
              (call (. output mark-literal-closes) current-line-start)
            )
          )
          (else-if (== output-kind 2)
            (call (. output append) (char "≤"))
          )
          (else-if (== output-kind 3)
            (call (. output append) (char "═"))
          )
          (else-if (== output-kind 4)
            (call append-paragraph-line output input line-start line-end (!! paragraph-access))
          )
        )
        (blank)
        (for (in _ (..< 0 current-suffix-count))
          (call (. output append) (char "≤"))
        )
        (blank)
        (let current-line-end (. output length))
        (if line-has-content
          (= last-text-line line-no)
          (= last-text-end current-line-end)
        )
        (blank)
        (call (. output append) (char "\n"))
        (= previous-line-start current-line-start)
        (= previous-line-end current-line-end)
        (continue)
      )
    )
    (blank)
    (= previous-line-start (. output length))
    (= previous-line-end (. output length))
    (call (. output append) (char "\n"))
  )
  (blank)
  (if (>= block-indent 0)
    (call (. output insert) (char "≥") block-end)
    (if (>= previous-line-end block-end)
      (+= previous-line-end 1)
    )
  )
  (blank)
  (for (in _ (..< 0 indent-level))
    (call (. output insert) (char "≥") previous-line-end)
    (+= previous-line-end 1)
  )
  (blank)
  (if (== header-level 1)
    (call (. output insert) (char "≥") previous-line-end)
    (+= previous-line-end 1)
    (else-if (== header-level 2)
      (for (in _ (..< 0 2))
        (call (. output insert) (char "≥") previous-line-end)
        (+= previous-line-end 1)
      )
    )
  )
  (blank)
  (if is-paragraph
    (call (. output insert) (char "≥") previous-line-end)
  )
  (blank)
  (return (call (of Array Char) (. output data data) (. output length)))
)

(type + PreparseDivider (is Tuple)
  (prop + line Index)
  (prop + thick Bool)
)

(type _ PreparseBuffer
  (prop + data ([] Char))
  (prop + length Size (= 0))
  (fn-do + This _
    (param scratch Arena)
    (param capacity Size)
    (lazy data (call (of Array Char) (call (of (. scratch allocate) Char) capacity) capacity))
  )
  (fn-do + append _
    (param char Char)
    (= ([] data length) char)
    (+= length 1)
  )
  (fn-do + append _
    (param source (of ImmutableArray Byte))
    (param start Index)
    (param end Index)
    (return-if (if (<= end start)))
    (let input ([] source (..< start end)))
    (let output (call (of Array Char) (+ (. data data) length) (- (. data size) length)))
    (let decoded-count Size)
    (let bytes-decoded Size)
    (= (tuple decoded-count bytes-decoded) (call decode-utf8-buffer input (. input size) output))
    (throw (call Panic "Preparse buffer capacity exceeded") (if (!= bytes-decoded (. input size))))
    (+= length decoded-count)
  )
  (fn-do + insert _
    (param char Char)
    (param at Index)
    (let cursor length)
    (while (> cursor at)
      (= ([] data cursor) ([] data (- cursor 1)))
      (-= cursor 1)
    )
    (= ([] data at) char)
    (+= length 1)
  )
  (fn-do + mark-literal-closes _
    (param start Index)
    (let cursor start)
    (while (< cursor length)
      (if (== ([] data cursor) (char "≥"))
        (= ([] data cursor) literal-close)
      )
      (+= cursor 1)
    )
  )
  (fn-do + remove _
    (param start Index)
    (param end Index)
    (return-if (if (<= end start)))
    (blank)
    (let amount (- end start))
    (let cursor start)
    (while (< (+ cursor amount) length)
      (= ([] data cursor) ([] data (+ cursor amount)))
      (+= cursor 1)
    )
    (-= length amount)
  )
)

(fn-do _ parse-indent Int
  (param input (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (let cursor start)
  (while (and (< cursor end) (== ([] input cursor) 32))
    (+= cursor 1)
  )
  (blank)
  (return (/ (- cursor start) indent-size))
)

(fn-expr _ is-header-line Bool
  (param input (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (case? (only-if true (if (call is-repeated-char input start end (char "━")))))
  (case? (only-if true (if (call is-repeated-char input start end (char "─")))))
  (default
    (inline (call is-repeated-char input start end (char "═")))
  )
)

(fn-do _ is-repeated-char Bool
  (param input (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (param char Char)
  (param min-length _ (= 3))
  (let count 0)
  (let cursor start)
  (while (< cursor end)
    (let scalar (call source-scalar input cursor))
    (return-if false (if (!= (. scalar char) char)))
    (+= cursor (as (. scalar byte-count) Size))
    (+= count 1)
  )
  (blank)
  (return (>= count min-length))
)

(fn-do _ find-paragraph-marker (? Index)
  (param input (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (let cursor start)
  (while (and (< cursor end) (call is-whitespace ([] input cursor)))
    (+= cursor 1)
  )
  (blank)
  (return-if (if (>= cursor end)))
  (return-if (if (and (!= ([] input cursor) 43) (!= ([] input cursor) 95))))
  (blank)
  (let access-index cursor)
  (+= cursor 1)
  (blank)
  (let spaces 0)
  (while (and (< cursor end) (call is-whitespace ([] input cursor)))
    (+= spaces 1)
    (+= cursor 1)
  )
  (blank)
  (return-if (if (== spaces 0)))
  (return-if (if (or (>= cursor end) (!= ([] input cursor) 34))))
  (blank)
  (+= cursor 1)
  (return-if (if (or (>= cursor end) (not (call is-whitespace ([] input cursor))))))
  (while (and (< cursor end) (call is-whitespace ([] input cursor)))
    (+= cursor 1)
  )
  (blank)
  (return-if (if (>= cursor end)))
  (blank)
  (return access-index)
)

(fn-do _ find-block-marker (? Index)
  (param input (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (let last end)
  (while (and (> last start) (call is-whitespace ([] input (- last 1))))
    (-= last 1)
  )
  (return-if (if (or (== last start) (== ([] input start) 96))))
  (return-if (if (and (>= (- last start) 2) (== ([] input start) 47) (== ([] input (+ start 1)) 47))))
  (let quote (- last 1))
  (return-if (if (or (!= ([] input quote) 34) (and (> quote start) (not (call is-whitespace ([] input (- quote 1))))))))
  (return-if (if (or (call continues-text input start) (not (call quote-opens input start quote)))))
  (return last)
)

(fn-do _ continues-text Bool
  (param input (of ImmutableArray Byte))
  (param start Index)
  (let at start)
  (while (and (> at 0) (!= ([] input (- at 1)) 10))
    (-= at 1)
  )
  (return-if false (if (< at 2)))
  (let before (if-expr (and (== ([] input (- at 2)) 13) (>= at 3)) (- at 3) (- at 2)))
  (return (== ([] input before) 92))
)

(fn-do _ quote-opens Bool
  (param input (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (let cursor start)
  (let in-text false)
  (let depths (list Size))
  (while (< cursor end)
    (let byte ([] input cursor))
    (if in-text
      (if (== byte 92)
        (+= cursor 1)
        (else-if (== byte 34)
          (= in-text false)
        )
        (else-if (and (== byte 36) (< (+ cursor 1) end) (== ([] input (+ cursor 1)) 123))
          (+= depths 0)
          (= in-text false)
          (+= cursor 1)
        )
      )
      (else-if (== byte 34)
        (= in-text true)
      )
      (else-if (== byte 96)
        (return false)
      )
      (else-if (and (== byte 39) (< (+ cursor 2) end) (== ([] input (+ cursor 2)) 39))
        (+= cursor 2)
      )
      (else-if (and (== byte 39) (< (+ cursor 3) end) (== ([] input (+ cursor 1)) 92) (== ([] input (+ cursor 3)) 39))
        (+= cursor 3)
      )
      (else-if (and (== byte 123) (> (. depths length) 0))
        (+= ([] depths (- (. depths length) 1)) 1)
      )
      (else-if (and (== byte 125) (> (. depths length) 0))
        (if (== ([] depths (- (. depths length) 1)) 0)
          (call (. depths pop))
          (= in-text true)
          (else
            (-= ([] depths (- (. depths length) 1)) 1)
          )
        )
      )
    )
    (+= cursor 1)
  )
  (return (not in-text))
)

(fn-do _ is-blank-line Bool
  (param input (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (for (in cursor (..< start end))
    (return-if false (if (not (call is-whitespace ([] input cursor)))))
  )
  (return true)
)

(fn-do _ append-paragraph-line _
  (param output PreparseBuffer)
  (param input (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (param access-index Index)
  (call (. output append) input start access-index)
  (call (. output append) (as ([] input access-index) Char))
  (call (. output append) (char " "))
  (blank)
  (let cursor (+ access-index 1))
  (while (and (< cursor end) (call is-whitespace ([] input cursor)))
    (+= cursor 1)
  )
  (+= cursor 1)
  (while (and (< cursor end) (call is-whitespace ([] input cursor)))
    (+= cursor 1)
  )
  (blank)
  (let rest-end end)
  (while (and (> rest-end cursor) (call is-whitespace ([] input (- rest-end 1))))
    (-= rest-end 1)
  )
  (blank)
  (call (. output append) input cursor rest-end)
)

(fn-expr _ is-whitespace _
  (param c Byte)
  (or (== c 32) (== c 9) (== c 13) (== c 10))
)

(type _ SourceScalar (is (tuple (: byte-count I32) (: char Char))))

(fn-do _ source-scalar SourceScalar
  (param input (of ImmutableArray Byte))
  (param offset Index)
  (let first ([] input offset))
  (return-if (call SourceScalar 1 (as first Char)) (if (< first 128)))
  (blank)
  (let result SourceScalar)
  (let status (call C:brixStringGetNextChar (+ (as input (of CPointer Byte)) offset) &result))
  (throw (call Panic "Unable to read UTF8 content") (if (or (!= status 0) (<= (. result byte-count) 0) (> (as (+ offset (. result byte-count)) Size) (. input size)))))
  (return result)
)
