    - id SyntaxId

for node in id + 1 .. < (nodes.length as SyntaxId)
    if subtree-start(node) <= id && nodes[node] is .node-style-rule-application
        = true
= false

────────────────────
+ do in-gated Bool
    - node SyntaxId
    - conditions [SyntaxId]

` Whether a node is written in one of the conditions given.
for condition in conditions
    if subtree-start(condition) <= node && node <= condition
        = true
= false

────────────────────
+ do reads-tracked Bool
    - value SyntaxId

` Whether a value reads something tracked.
for node in subtree-start(value) .. value
    do match? nodes[node]
        | .node-identifier(row)
            if row.is-tracked
                = true
        | .node-get-expression(row)
            if row.is-tracked
                = true
= false

────────────────────
+ do roots-values Bool
    - application SyntaxId

` Whether an application written after `•` is written on the root `<This` of a class's markup,
` whose values an instance of their own types (`check-root-values`).
do match? nodes[holder-of(application)]
    | .node-markup(row)
        = names-this(row.type-id)
= false

────────────────────
+ do rule-argument-type SyntaxId
    - argument SyntaxId

` The type written for a value a style rule takes, or the pattern that takes it where it is
` written with none.
. pattern = argument
do match? nodes[argument]
    | .node-argument-decl(row)
        pattern = row.pattern
do match? nodes[pattern]
    | .node-type-capture(capture)
        = capture.type
= pattern

────────────────────
+ rule-body SyntaxId
    - syntax SyntaxId

match nodes[syntax]
    | .node-rule-syntax(row)
        row.body
    ??
        0

────────────────────
+ do rule-content [SyntaxId]
    - body SyntaxId

` The lines of the body of a style rule that generate content, in the order written: markup
` elements that bind a slot.
. lines [SyntaxId]
do match? nodes[body]
    | .node-block(block)
        for line in children[block.body]
            if this.generates(line)
                lines += line
= lines

────────────────────
+ rule-takes U32
    - syntax SyntaxId

match nodes[syntax]
    | .node-rule-syntax(row)
        row.args.count
    ??
        0

────────────────────
+ rule-takes-nothing Bool
    - syntax SyntaxId

match nodes[syntax]
    | .node-rule-syntax(row)
        row.args.count == 0
    ??
        false

────────────────────
+ do rule-whens [SyntaxId]
    - body SyntaxId

` The `when`s of the body of a style rule, in the order written.
. whens [SyntaxId]
if body == 0
    = whens
do match? nodes[body]
    | .node-block(block)
        for statement in children[block.body]
            if nodes[statement] is .node-style-when
                whens += statement
= whens

────────────────────
+ when-applications [SyntaxId]
    - branch SyntaxId

` The rules the body of a `when` of a style rule applies, in the order written.
each in when-lines(branch) when nodes[each] is .node-style-rule-application

────────────────────
+ when-content [SyntaxId]
    - branch SyntaxId

` The lines of the body of a `when` of a style rule that generate content, in the order written.
each in when-lines(branch) when this.generates(each)

────────────────────
+ argument-type-syntax SyntaxId
    - argument SyntaxId

` The type written for a value a style rule takes, `name Type`, or none.
match nodes[argument]
    | .node-argument-decl(row)
        match nodes[row.pattern]
            | .node-type-capture(capture)
                capture.type
            ??
                0
    ??
        0

────────────────────
+ generates Bool
    - line SyntaxId

` Whether a line of a style rule generates content: a markup element that binds a slot.
match nodes[line]
    | .node-markup(row)
        row.slot-binding != 0
    ??
        false

────────────────────
+ is-bare-value Bool
    - statement SyntaxId

match nodes[statement]
    | .node-identifier
        true
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    | .node-string-syntax
        true
    | .node-get-expression
        true
    | .node-index-expression
        true
    | .node-list-syntax
        true
    | .node-tuple-syntax
        true
    | .node-range-expression
        true
    | .node-cast-expression
        true
    | .node-binary-expression(row)
        is-arithmetic(row.op) || is-comparison(row.op) || valued-ops has row.op
    | .node-unary-expression(row)
        row.op == .not-op || row.op == .negative-op || row.op == .bitwise-not-op
    ??
        false

.. valued-ops = [Operator.concat-op, Operator.concat-string-op, Operator.and-op, Operator.or-op, Operator.is-op, Operator.is-not-op, Operator.is-exactly-op, Operator.is-not-exactly-op, Operator.is-similar-op, Operator.is-not-similar-op, Operator.is-in-op, Operator.not-in-op, Operator.has-op, Operator.has-not-op]

────────────────────
+ is-number Bool
    - value SyntaxId

match nodes[value]
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    ??
        false

────────────────────
+ is-string-literal Bool
    - value SyntaxId

match nodes[value]
    | .node-string-syntax
        true
    ??
        false
