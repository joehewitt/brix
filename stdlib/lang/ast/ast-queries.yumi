    | .node-string-syntax
        false
    | .node-binary-expression
        false
    | .node-cast-expression
        false
    | .node-call-expression
        false
    ??
        true

────────────────────
+ is-identifier-syntax Bool
    - expr SyntaxId

match nodes[expr]
    | .node-identifier
        true
    ??
        false

────────────────────
+ writes-type Bool
    - pattern SyntaxId

` Whether a declaration's pattern writes the type of what it declares.
match nodes[pattern]
    | .node-type-capture(row)
        row.type != 0
    ??
        false

