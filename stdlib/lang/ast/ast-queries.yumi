. trigger = state-trigger(source.node)
. captures [Atom]
if trigger != 0
    pattern-names(trigger-pattern(trigger), captures)
if source.owner != 0
    pattern-names(trigger-pattern(state-trigger(source.owner)), captures)
for target in children[state-targets(source.node)]
    do match? nodes[target]
        | .node-identifier(named)
            if captures.find(named.name) == null
                = true
= false

