+ bullet-site SyntaxId
    - id SyntaxId
    - consumer SyntaxId

match nodes[id]
    | .node-bullet-expression(row)
        if row.next != 0 then row.next else if consumer != 0 then consumer else id
    ??
        id

────────────────────
+ do consumer-of SyntaxId
    - id SyntaxId

` The pipeline whose left operand is the bullet list, if one consumes it.
. total = nodes.length
for candidate in id + 1 .. < total
    do match? nodes[candidate]
        | .node-pipeline-expression(row)
            if row.left == id
                = candidate as SyntaxId
= 0

────────────────────
+ do is-piped-row Bool
    - body RowRange'SyntaxId
    - statement SyntaxId

for position in 0 .. < body.count - 1
    if children[body.start + position] == statement
        do match? nodes[children[body.start + position + 1]]
            | .node-pipeline-expression(row)
                = row.left == 0
        = false
= false

────────────────────
+ do pipeline-of SyntaxId
    - id SyntaxId

for node in id + 1 .. < (nodes.length as SyntaxId)
    if subtree-start(node) > id
        continue
    do match? nodes[node]
        | .node-iterator-expression(row)
            do match? nodes[row.loop]
                | .node-loop-syntax(loop)
                    if subtree-start(loop.container) > id || id > loop.container
                        = node
= 0

