+ written-part SyntaxId
    - rhs SyntaxId
    - position U32

` The item written at a position of a tuple written as a value, or none.
match nodes[rhs]
    | .node-tuple-syntax(row)
        if position < row.items.count then children[row.items.start + position] else 0
    ??
        0

────────────────────
+ names-super Bool
    - callable SyntaxId

match nodes[callable]
    | .node-identifier(row)
        row.name.text == "super"
    ??
        false

