    | .node-block(block)
        . last SyntaxId = 0
        for statement in children[block.body]
            do match? nodes[statement]
                | .node-declare(row)
                    if row.is-lazy
                        continue
            if !is-declaration-syntax(this, statement) && !is-comment-syntax(this, statement)
                last = statement
        = last
= body

