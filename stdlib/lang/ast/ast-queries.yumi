+ do branched Bool
    - content SyntaxId
    - element SyntaxId
    - outlets = false

` Whether an element of a class's markup is written in an `if` or a `match` of it, or with
` `outlets` in the default content of a slot, and in no function or loop of it.
. found = false
for node in element + 1 .. < content
    if subtree-start(node) <= element
        do match? nodes[node]
            | .node-function-syntax
                = false
            | .node-for-block
                = false
            | .node-if-block
                found = true
            | .node-match-expression
                found = true
            | .node-slot-outlet
                found = found || outlets
= found

