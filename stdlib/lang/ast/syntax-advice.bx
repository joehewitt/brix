(import ./error)
(import /core/parsing)
(blank)
(prop + reserved-words _ (= (list "in" "on" "and" "or" "do" "for" "while" "if" "else")))
(prop + preposition-words _ (= (list "about" "after" "at" "before" "between" "both" "by" "during" "despite" "except" "every" "from" "into" "like" "near" "of" "onto" "over" "since" "through" "toward" "to" "using" "whenever" "when" "where" "within" "without" "with" "unless" "unlike" "until" "via")))
(prop + header-words _ (= (list "if" "else" "while" "match" "for")))

(fn-expr + syntax-advice String
  (param source String)
  (param spot TokenLocation)
  (case? (== (call (. line char) (. line indent)) '#')
    "Comments start with a backtick (`), not \"#\""
  )
  (case? surrogate
    (str "\"" surrogate "\" is half of a surrogate pair, which is no character by itself; write the character itself in the text")
  )
  (case? (== lead "return")
    "Brix has no \"return\"; in a do function, return a value with \"= value\""
  )
  (case? (or (== lead "let") (== lead "var") (== lead "const") (== lead "val"))
    (str "Declare a local with \". name = value\", not \"" lead "\"")
  )
  (case? (or (== lead "def") (== lead "fn") (== lead "func") (== lead "function"))
    "Declare a function after a thick divider (━) as \"+ name ReturnType\", with each parameter on an indented \"- name Type\" line"
  )
  (case? (== (call (. line char) column) (char ";"))
    "A line needs no \";\"; remove it"
  )
  (case? (call (. line prints-value) column)
    "A print is a step and gives no value; print on a line of its own, or after \":\" as a one-step body"
  )
  (case? (call (. line opens-brace) column)
    "Blocks are written by indentation, not braces; remove \"{\" and \"}\" and indent the body below the line"
  )
  (case? (and (== (call (. line char) column) (char "\\")) (call (. line inside-embed) column))
    "Inside \"\${...}\", write quotes without a backslash, as in \"\${name.find(\"a\")}\""
  )
  (case? (and (!= (. declared length) 0) (!= (call (. reserved-words find) declared) null))
    (str "\"" declared "\" is a reserved word and cannot be a name; choose another name")
  )
  (case? (and owned (!= (call (. header-words find) lead) null))
    (str "\"" lead "\" owns the block below it, so \"• " owned "\" at the end of its line cannot take that block; finish the argument on this line, or compute it in a local above")
  )
  (case? (and (== label "where") (== lead "for"))
    "A loop has no \"where\" clause; filter its items with \"when\", as in \"for x in items when x > 2\""
  )
  (case? label
    (str "\"" label "\" cannot follow an expression; a call takes its arguments in parentheses, as in \"sort(keys)\", and a callback after a bullet, as in \"some(items) • where each > 2\"")
  )
  (case? cast
    (str "A cast cannot be followed by an operator; wrap it in parentheses, as in \"(" cast " as " (call (. line type-before) column) ") " (call (. line operator-at) column) " " (call (. line operand-after) column) "\"")
  )
  (case? (call (. line binds-before) column)
    "The place of \"<->\" is a name or a chain of members, written without \"#\", as in \"value <-> settings.volume\""
  )
  (case? (call is-camel camel)
    (str "Names are kebab-case; write \"" (call kebab camel) "\", not \"" camel "\"")
  )
  (case? power
    power
  )
  (case? spaced
    (str "An operator needs a space on each side; write \"" spaced "\"")
  )
  (case? stacked
    (str "A part of a pattern takes one of ?, * or +, not \"" stacked "\"; to repeat a repeated part, wrap it in parentheses first")
  )
  (case? (or (== ending "(") (== ending "["))
    (str "An expression ends at the end of its line, so this \"" (!! ending) "\" is never closed; write it on one line, or give a call its arguments on indented \"- value\" lines below it")
  )
  (case? (== ending "{")
    (str "An expression ends at the end of its line, so this \"" (!! ending) "\" is never closed; write it on one line")
  )
  (case? ending
    (str "An expression ends at the end of its line, so nothing follows this \"" ending "\"; write the whole expression on one line")
  )
  (case? (and (== (. line indent) 0) (!= (. line chars length) 0) (not (call (. line starts-declaration))) (call (. previous starts-with) "━"))
    "A divider starts a declaration, so a statement cannot follow it; put module-level statements above the first divider"
  )
  (case? untyped
    (str "An event names the type of what it carries, as in \"+ event " untyped " String\"")
  )
  (case? signed
    signed
  )
  (case? (and (call (. line starts-declaration)) (!= (. previous length) 0) (not (call (. previous starts-with) "━")) (not (call (. previous starts-with) "─")))
    "A declaration with a body needs a divider line above it: a thick divider (━) at module level, or a thin divider (─) for a member of a type"
  )
  (case? header
    (str "\"" header "\" needs a divider line above it: a thick divider (━) at module level, or a thin divider (─) for a member of a type")
  )
  (default
    "Syntax error"
  )
  (where
    (lazy line (call SourceLine source (. spot line)))
    (lazy surrogate (call (. line surrogate-escape)))
    (lazy column (as (. spot column) Index))
    (lazy lead (call (. line leading-word)))
    (lazy declared (call (. line declared-name)))
    (lazy owned (call (. line trailing-label)))
    (lazy label (call (. line label-after-expression) column))
    (lazy cast (call (. line cast-before) column))
    (lazy camel (if-expr (call is-camel (call (. line word-around) column)) (call (. line word-around) column) declared))
    (lazy spaced (call (. line unspaced-operator) column))
    (lazy power (call (. line power-advice) column))
    (lazy previous (call previous-code source (. spot line)))
    (lazy ending (call (. line dangling-end) column))
    (lazy stacked (call (. line stacked-repeat) column))
    (lazy header (call undivided-header source (. spot line)))
    (lazy untyped (call untyped-event source (. spot line)))
    (lazy signed (call signed-unit source (. spot line)))
  )
)

(fn-do _ signed-unit (? String)
  (param source String)
  (param line U32)
  ; The advice for a unit a line declares from a signed amount of another, as in
  ; "+ Bar (bar) is -1foo" (`signed-unit-advice`).
  (let lines (list String))
  (for (in text (call (. source split) "\n"))
    (+= lines text)
  )
  (return-if null (if (>= (as line Index) (. lines length))))
  (let words (list String))
  (for (in word (call (. (call (. ([] lines (as line Index)) trim)) split) " "))
    (+= words word)
  )
  (return-if null (if (or (!= (. words length) 5) (!= ([] words 3) "is"))))
  (return-if null (if (and (!= ([] words 0) "+") (!= ([] words 0) "_"))))
  (return-if null (if (or (not (call (. ([] words 2) starts-with) "(")) (not (call (. ([] words 2) ends-with) ")")))))
  (return-if null (if (and (not (call (. ([] words 4) starts-with) "-")) (not (call (. ([] words 4) starts-with) "(-")))))
  (let suffix ([] ([] words 2) (..< 1 (- (. ([] words 2) length) 1))))
  (let amount "")
  (for (in char ([] words 4))
    (if (and (!= char (char "(")) (!= char (char ")")))
      (+= amount (str char))
    )
  )
  (return (call signed-unit-advice ([] words 0) ([] words 1) suffix amount))
)

(fn-do _ untyped-event (? String)
  (param source String)
  (param line U32)
  ; The name of an event a line declares with no type, as in "+ event rang".
  (let lines (list String))
  (for (in text (call (. source split) "\n"))
    (+= lines text)
  )
  (return-if null (if (>= (as line Index) (. lines length))))
  (let words (list String))
  (for (in word (call (. (call (. ([] lines (as line Index)) trim)) split) " "))
    (+= words word)
  )
  (return-if null (if (or (!= (. words length) 3) (!= ([] words 1) "event"))))
  (return-if null (if (and (!= ([] words 0) "+") (!= ([] words 0) "_"))))
  (return ([] words 2))
)

(fn-do _ undivided-header (? String)
  (param source String)
  (param line U32)
  (let lines (list String))
  (for (in text (call (. source split) "\n"))
    (+= lines text)
  )
  (let position (as line Index))
  (return-if null (if (>= position (. lines length))))
  (let current ([] lines position))
  (let code (call (. current trim)))
  (return-if null (if (or (== (. code length) 0) (call (. code starts-with) "+ ") (call (. code starts-with) "_ "))))
  (return-if null (if (and (call (. current starts-with) " ") (not (call (. code starts-with) "- ")))))
  (while (> position 0)
    (-= position 1)
    (let text ([] lines position))
    (let trimmed (call (. text trim)))
    (if (or (== (. trimmed length) 0) (call (. trimmed starts-with) "`") (and (call (. text starts-with) " ") (call (. trimmed starts-with) "- ")))
      (continue)
    )
    (return-if null (if (or (not (or (call (. trimmed starts-with) "+ ") (call (. trimmed starts-with) "_ "))) (!= (call (. trimmed find) " = ") null) (!= (call (. trimmed find) " := ") null))))
    (let above (call previous-code source (as position U32)))
    (return-if null (if (or (== (. above length) 0) (call (. above starts-with) "━") (call (. above starts-with) "─"))))
    (return trimmed)
  )
  (return null)
)

(fn-do _ previous-code String
  (param source String)
  (param line U32)
  (let lines (list String))
  (for (in text (call (. source split) "\n"))
    (+= lines text)
  )
  (let position (as line Index))
  (while (> position 0)
    (-= position 1)
    (let text (if-expr (< position (. lines length)) (call (. ([] lines position) trim)) ""))
    (if (and (!= (. text length) 0) (not (call (. text starts-with) "`")))
      (return text)
    )
  )
  (return "")
)

(fn-expr + is-camel Bool
  (param word String)
  (and (> (. word length) 1) (>= ([] word (..< 0 1)) "a") (<= ([] word (..< 0 1)) "z") (call has-camel-step word))
)

(fn-do _ has-camel-step Bool
  (param word String)
  (let previous (as 0 Char))
  (for (in char word)
    (if (and (>= char 'A') (<= char 'Z') (>= previous 'a') (<= previous 'z'))
      (return true)
    )
    (= previous char)
  )
  (return false)
)

(fn-do _ kebab String
  (param word String)
  (let text "")
  (for (in char word)
    (if (and (>= char 'A') (<= char 'Z'))
      (+= text "-")
      (+= text (. char lowercase))
      (else
        (+= text char)
      )
    )
  )
  (return text)
)

(fn-expr _ is-surrogate-digit Bool
  (param char Char)
  (or (and (>= char '8') (<= char '9')) (and (>= char 'a') (<= char 'f')) (and (>= char 'A') (<= char 'F')))
)

(fn-expr _ is-name-char Bool
  (param char Char)
  (or is-letter (and (>= char '0') (<= char '9')) (== char '-') (== char '_') (== char (char "'")))
  (where
    (lazy is-letter (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z'))))
  )
)

(fn-expr _ is-word-char Bool
  (param char Char)
  (and (call is-name-char char) (!= char (char "'")))
)

(fn-expr _ is-operator-char Bool
  (param char Char)
  (or (== char '+') (== char '*') (== char '/') (== char '%') (== char '<') (== char '>') (== char '=') (== char '-') (== char '&') (== char '|'))
)

(type + SourceLine
  (prop + chars (list Char))
  (prop + indent Index (= 0))
  (fn-do + This _
    (param source String)
    (param line U32)
    (let current 0u32)
    (for (in char source)
      (if (== char (char "\n"))
        (if (== current line)
          (break)
        )
        (+= current 1)
        (else-if (== current line)
          (+= chars char)
        )
      )
    )
    (while (and (< indent (. chars length)) (== ([] chars indent) (char " ")))
      (+= indent 1)
    )
  )
  (fn-expr + char Char
    (param spot Index)
    (if-expr (< spot (. chars length)) ([] chars spot) (as 0 Char))
  )
  (fn-do + text String
    (param start Index)
    (param end Index)
    (let written "")
    (for (in spot (..< start end))
      (if (< spot (. chars length))
        (+= written ([] chars spot))
      )
    )
    (return written)
  )
  (fn-do + binds-before Bool
    (param column Index)
    (let found (call (. (call text 0 (. chars length)) find) " <-> "))
    (return (and (!= found null) (< (as found Index) column)))
  )
  (fn-do + surrogate-escape (? String)
    ; The first escape on the line that writes half of a surrogate pair, from "\uD800" to "\uDFFF".
    (for (in spot (..< 0 (. chars length)))
      (if (and (== (call char spot) (char "\\")) (== (call char (+ spot 1)) 'u') (or (== (call char (+ spot 2)) 'd') (== (call char (+ spot 2)) 'D')))
        (if (and (call is-surrogate-digit (call char (+ spot 3))) (or (== spot 0) (!= (call char (- spot 1)) (char "\\"))))
          (return (call text spot (+ spot 6)))
        )
      )
    )
    (return null)
  )
  (fn-do + word-from String
    (param start Index)
    (let end start)
    (while (and (< end (. chars length)) (call is-name-char ([] chars end)))
      (+= end 1)
    )
    (return (call text start end))
  )
  (fn-expr + leading-word String
    (call word-from indent)
  )
  (fn-do + declared-name String
    (let rest (call text indent (. chars length)))
    (for (in prefix (list ".. " ". " "- " "for " "+ do " "_ do " "+ get " "+ set " "+ " "_ "))
      (if (call (. rest starts-with) prefix)
        (return (call word-from (+ indent (. prefix length))))
      )
    )
    (return "")
  )
  (fn-expr + starts-declaration Bool
    (or (call (. rest starts-with) "+ ") (call (. rest starts-with) "_ "))
    (where
      (lazy rest (call text indent (. chars length)))
    )
  )
  (fn-expr + opens-brace Bool
    (param spot Index)
    (case? (== (call char spot) '{')
      (or (== spot 0) (!= (call char (- spot 1)) '$'))
    )
    (default
      (and (!= last (. Index max)) (== ([] chars last) '{') (>= spot last) (or (== last 0) (!= ([] chars (- last 1)) '$')))
    )
    (where
      (lazy last (call last-visible))
    )
  )
  (fn-do + inside-embed Bool
    (param spot Index)
    (let depth 0)
    (for (in position (..< 0 spot))
      (if (and (< (+ position 1) (. chars length)) (== ([] chars position) '$') (== ([] chars (+ position 1)) '{'))
        (+= depth 1)
        (else-if (and (== ([] chars position) '}') (> depth 0))
          (-= depth 1)
        )
      )
    )
    (return (> depth 0))
  )
  (fn-do + label-after-expression (? String)
    (param spot Index)
    (let start (if-expr (< spot (. chars length)) spot (. chars length)))
    (while (and (< start (. chars length)) (== ([] chars start) (char " ")))
      (+= start 1)
    )
    (let word (call word-from start))
    (return-if null (if (or (== (call (. preposition-words find) word) null) (!= (call char (+ start (. word length))) (char " ")))))
    (let before (call previous-visible start))
    (return-if null (if (or (== before (. Index max)) (< before indent))))
    (let last ([] chars before))
    (return-if null (if (not (or (call is-name-char last) (== last (char ")")) (== last ']') (== last (char "\""))))))
    (return word)
  )
  (fn-expr + trailing-label (? String)
    (case? (== last (. Index max))
      null
    )
    (case? (or (== (. word length) 0) (< (+ last 1) (+ (. word length) 2)))
      null
    )
    (case? (or (== mark (. Index max)) (!= ([] chars mark) (char "•")))
      null
    )
    (default
      word
    )
    (where
      (lazy last (call last-visible))
      (lazy word (call word-ending last))
      (lazy mark (call previous-visible (- (+ last 1) (. word length))))
    )
  )
  (fn-do + last-visible Index
    (let spot (. chars length))
    (while (> spot 0)
      (-= spot 1)
      (if (!= ([] chars spot) (char " "))
        (return spot)
      )
    )
    (return (. Index max))
  )
  (fn-do + word-around String
    (param spot Index)
    (let start (if-expr (< spot (. chars length)) spot (. chars length)))
    (while (and (> start 0) (call is-word-char ([] chars (- start 1))))
      (-= start 1)
    )
    (let end start)
    (while (and (< end (. chars length)) (call is-word-char ([] chars end)))
      (+= end 1)
    )
    (return (call text start end))
  )
  (fn-do + previous-visible Index
    (param spot Index)
    (let position (if-expr (< spot (. chars length)) spot (. chars length)))
    (while (> position 0)
      (-= position 1)
      (if (!= ([] chars position) (char " "))
        (return position)
      )
    )
    (return (. Index max))
  )
  (fn-expr + prints-value Bool
    (param spot Index)
    (case? (== last (. Index max))
      false
    )
    (default
      (and (> (- mark 1) indent) (== ([] chars mark) '-') (== ([] chars (- mark 1)) '-'))
    )
    (where
      (lazy last (call previous-visible spot))
      (lazy mark (if-expr (== ([] chars last) '?') (- last 1) last))
    )
  )
  (fn-do + word-ending String
    (param spot Index)
    (let start (+ spot 1))
    (while (and (> start 0) (call is-name-char ([] chars (- start 1))))
      (-= start 1)
    )
    (return (call text start (+ spot 1)))
  )
  (fn-expr + type-before String
    (param spot Index)
    (if-expr (== last (. Index max)) "" (call word-ending last))
    (where
      (lazy last (call previous-visible spot))
    )
  )
  (fn-expr + cast-before (? String)
    (param spot Index)
    (case? (not (call is-operator-char (call char spot)))
      null
    )
    (case? (or (== type-end (. Index max)) (not (call is-name-char ([] chars type-end))))
      null
    )
    (case? (or (== (. type-name length) 0) (< ([] type-name (..< 0 1)) "A") (> ([] type-name (..< 0 1)) "Z"))
      null
    )
    (case? (or (== as-end (. Index max)) (!= (call word-ending as-end) "as"))
      null
    )
    (case? (or (== value-end (. Index max)) (not (call is-name-char ([] chars value-end))))
      "x"
    )
    (default
      (call word-ending value-end)
    )
    (where
      (lazy type-end (call previous-visible spot))
      (lazy type-name (call word-ending type-end))
      (lazy as-end (call previous-visible (- (+ type-end 1) (. type-name length))))
      (lazy value-end (call previous-visible (- as-end 1)))
    )
  )
  (fn-do + operator-at String
    (param spot Index)
    (let end spot)
    (while (and (< end (. chars length)) (call is-operator-char ([] chars end)))
      (+= end 1)
    )
    (return (call text spot end))
  )
  (fn-do + operand-after String
    (param spot Index)
    (let end spot)
    (while (and (< end (. chars length)) (call is-operator-char ([] chars end)))
      (+= end 1)
    )
    (while (and (< end (. chars length)) (== ([] chars end) (char " ")))
      (+= end 1)
    )
    (let word (call word-from end))
    (return (if-expr (!= (. word length) 0) word "..."))
  )
  (fn-expr + unspaced-operator (? String)
    (param spot Index)
    (case? (or (== (. op length) 0) (== spot 0))
      null
    )
    (case? (not (or (call is-name-char left) (== left (char ")")) (== left ']')))
      null
    )
    (case? (and (call (. op starts-with) "-") (!= op "-="))
      null
    )
    (case? (and (!= (. left-word length) 0) (>= ([] left-word (..< 0 1)) "0") (<= ([] left-word (..< 0 1)) "9"))
      null
    )
    (case? (and (== (. right-word length) 0) (!= (call char rest-start) (char " ")))
      null
    )
    (default
      (str left-word " " op " " (if-expr (!= (. right-word length) 0) (call (. right-word trim)) "..."))
    )
    (where
      (lazy op (call operator-at spot))
      (lazy left ([] chars (- spot 1)))
      (lazy left-word (call word-ending (- spot 1)))
      (lazy rest-start (+ spot (. op length)))
      (lazy right-word (call word-from rest-start))
    )
  )
  (fn-expr + power-advice (? String)
    (param spot Index)
    (case? (and (== (call char spot) '^') (> spot indent))
      "Raise to a power with \"a %% b\"; for the bits set in one but not the other, write \"a /xor/ b\""
    )
    (case? (or (!= (call char spot) '*') (and (!= (call char (+ spot 1)) '*') (or (== spot 0) (!= (call char (- spot 1)) '*'))))
      null
    )
    (case? (or (== (call char (+ spot 1)) '=') (== (call char (+ spot 2)) '='))
      "Raise in place with \"x %%= b\""
    )
    (default
      "Raise to a power with \"a %% b\""
    )
  )
  (fn-expr + stacked-repeat (? String)
    (param spot Index)
    ; Two repeats written together on a pattern's part, ending at a spot, as in "a"+*.
    (case? (or (== spot 0) (not (call repeat (call char spot))) (not (call repeat (call char (- spot 1)))) (== (call (. (call text 0 (. chars length)) find) "~") null))
      null
    )
    (default
      (str (call char (- spot 1)) (call char spot))
    )
  )
  (fn-expr _ repeat Bool
    (param c Char)
    (or (== c '?') (== c '*') (== c '+'))
  )
  (fn-expr + dangling-end (? String)
    (param spot Index)
    (case? (or (== last (. Index max)) (< spot last))
      null
    )
    (case? (or (== ending '[') (== ending (char "(")) (== ending '{') (== ending ',') (== ending '+') (== ending '*') (== ending '/') (== ending '='))
      (str ending)
    )
    (case? (or (== word "and") (== word "or"))
      word
    )
    (default
      null
    )
    (where
      (lazy last (call last-visible))
      (lazy ending ([] chars last))
      (lazy word (call word-ending last))
    )
  )
)
