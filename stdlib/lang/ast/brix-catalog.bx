(import ./brix-forms)
(import ./brix-heads)
(import /core/arena)
(import /data/sexp)
(import /stream/aggregate)
(blank)
(prop + brix-catalog BrixCatalog (:= (call BrixCatalog)))

(type + BrixKind
  (prop + name String)
  (prop + index Index)
  (prop + accepts (list String))
  (prop + meaning String)
  (prop + note (? String))
  (prop + overflow (? String))
  (fn-do + This _
    (param name _)
    (param index _)
    (param accepts _)
    (param meaning _)
  )
)

(type + BrixPlace
  (prop + wanted (list String))
  (prop + admits (list Bool))
  (prop + rejects (list Bool))
  (prop + literals (list String))
  (prop + leads (list String))
  (prop + is-free Bool)
  (prop + takes-atoms Bool)
  (prop + takes-types Bool)
  (prop + takes-strings Bool)
  (prop + takes-params Bool)
  (prop + takes-piped Bool)
  (prop + note (? String))
  (prop + width Size)
  (prop _ literal-bytes (list (of ImmutableArray Byte)))
  (prop _ lead-bytes (list (of ImmutableArray Byte)))
  (fn-do + This _
    (param wanted _)
    (param admits _)
    (param rejects _)
    (param literals _)
    (param leads _)
    (param is-free _)
    (param takes-atoms _)
    (param takes-types _)
    (param takes-strings _)
    (param takes-params _)
    (param takes-piped _)
    (param note _)
    (param width _)
    (lazy literal-bytes (call List (in (call byte-view each) literals)))
    (lazy lead-bytes (call List (in (call byte-view each) leads)))
  )
  (fn-expr + names String :get
    (call (. " or " join) wanted)
  )
  (fn-do + takes-atom Bool
    (param tape SexpTape)
    (param index Index)
    (return-if true (if is-free))
    (for (in literal literal-bytes)
      (return-if true (if (call (. tape atom-matches) index literal)))
    )
    (let bytes (. tape bytes))
    (let start (call (. tape start) index))
    (let size (- (call (. tape end) index) start))
    (for (in lead lead-bytes)
      (if (and (>= size (. lead length)) (call brix-span-equal lead bytes start))
        (return true)
      )
    )
    (let first ([] bytes start))
    (return-if true (if (and takes-types (or (and (>= first 65) (<= first 90)) (== first 39)))))
    (return (and takes-atoms (not (and (== size 1) (== first 95))) (!= first 58) (!= first 64)))
  )
  (fn-do + takes Bool
    (param sense BrixSense)
    (return-if true (if is-free))
    (let is-admitted false)
    (for (in kind (. sense kind-ids))
      (return-if false (if ([] rejects kind)))
      (if ([] admits kind)
        (= is-admitted true)
      )
    )
    (return is-admitted)
  )
)

(type + BrixSlot
  (prop + role String)
  (prop + place (? BrixPlace))
  (prop + literal (? String))
  (prop + form (? BrixSense))
  (prop + mark String)
  (prop + label String)
  (prop + spot String)
  (prop + is-repeating Bool)
  (prop + is-optional Bool)
  (prop + width Size)
  (prop + literal-bytes (? (of ImmutableArray Byte)))
  (fn-do + This _
    (param role _)
    (param mark _)
    (param label _)
    (param spot _)
    (param place (? BrixPlace))
    (param literal (? String) (= null))
    (param form (? BrixSense) (= null))
    (= is-repeating (or (== mark "*") (== mark "+")))
    (= is-optional (or (== mark "?") (== mark "*")))
    (= width (?? (?. place width) 0))
    (= literal-bytes (only-if (call byte-view literal) (if literal)))
  )
  (fn-expr + is-skippable Bool
    (param used Size)
    (or is-optional (and is-repeating (> used 0)))
  )
)

(type + BrixSense
  (prop + kinds (list String))
  (prop + kind-ids (list Index))
  (prop + head String)
  (prop + slots (list BrixSlot))
  (prop + meaning String)
  (prop + shape String)
  (prop + is-doing Bool)
  (prop + head-bytes (of ImmutableArray Byte))
  (fn-do + This _
    (param kinds _)
    (param kind-ids _)
    (param head _)
    (param slots _)
    (param meaning _)
    (param shape _)
    (param is-doing _)
    (lazy head-bytes (call byte-view head))
  )
)

(type + BrixSection
  (prop + title String)
  (prop + senses (list BrixSense))
  (fn-do + This _
    (param title _)
  )
)

(type + BrixCatalog
  (prop + kinds (list BrixKind))
  (prop + sections (list BrixSection))
  (prop + top BrixPlace)
  (prop + binder BrixPlace)
  (prop + section BrixPlace)
  (prop + piped BrixPlace)
  (blank)
  (prop + label-senses (? (list BrixSense)))
  (prop + infix-senses (? (list BrixSense)))
  (blank)
  (prop _ named (map String BrixKind))
  (prop _ headed (map String (list BrixSense)))
  (prop _ exact (list (? (list BrixSense))))
  (prop _ optional (list (? (list BrixSense))))
  (prop _ head-sizes (list Size))
  (prop _ firm-heads (list Bool))
  (prop _ places (map String BrixPlace))
  (prop _ hints (map String String))
  (prop _ refusals (map String (list BrixSense)))
  (prop _ refused (list (? (list BrixSense))))
  (fn-do + This _
    (call load-forms)
    (= top (call place (list "Top")))
    (= binder (call place (list "Binder")))
    (= section (call place (list "Section")))
    (= piped (call place (list "Value")))
    (= label-senses ([] headed ":label"))
    (= infix-senses ([] headed "/infix/"))
    (= exact (call List (in ([] headed each) brix-head-names)))
    (= optional (call List (in ([] headed (str each "?")) brix-head-names)))
    (= refused (call List (in ([] refusals each) brix-head-names)))
    (= head-sizes (call List (in (. each size) brix-head-names)))
    (= firm-heads (call List (in (call is-firm each) brix-head-names)))
    (for (in name brix-head-names)
      (throw (call Panic (str "The Brix reader reads a head the catalog does not declare: " name)) (if (and name (not ([] headed name)))))
    )
  )
  (fn-expr _ is-firm Bool
    (param head String)
    (call some (. hints keys) (:where (call (. each starts-with) (str head " "))))
  )
  (fn-expr + senses (? (list BrixSense))
    (param head String)
    (case? (!= found null)
      found
    )
    (case? (and (> (. head length) 1) (call (. head starts-with) ":") (not (call (. head ends-with) ":")))
      ([] headed ":label")
    )
    (case? (and (> (. head length) 2) (call (. head starts-with) "/") (call (. head ends-with) "/"))
      ([] headed "/infix/")
    )
    (default
      null
    )
    (where
      (lazy found ([] headed head))
    )
  )
  (fn-expr + senses-of (? (list BrixSense))
    (param head BrixHead)
    (param size Size)
    (param is-marked Bool)
    (if-expr (and is-marked (!= size ([] head-sizes head))) ([] optional head) ([] exact head))
  )
  (fn-expr + refusals-of (? (list BrixSense))
    (param head BrixHead)
    ([] refused head)
  )
  (fn-expr + has-firm-hint Bool
    (param head BrixHead)
    ([] firm-heads head)
  )
  (fn-do + has-forms Bool
    (param kind BrixKind)
    (for (in section sections)
      (for (in sense (. section senses))
        (return-if true (if (has (. sense kind-ids) (. kind index))))
      )
    )
    (return false)
  )
  (fn-expr + hint (? String)
    (param head String)
    (param place BrixPlace)
    (?? (call firm-hint head place) ([] hints head))
  )
  (fn-expr + remark (? String)
    (param head String)
    (param topic String)
    ([] hints (str head " " topic))
  )
  (fn-do + overflow (? String)
    (param place BrixPlace)
    (for (in name (. place wanted))
      (let text (. (call kind name) overflow))
      (return-if text (if (!= text null)))
    )
    (return null)
  )
  (fn-do + firm-hint (? String)
    (param head String)
    (param place BrixPlace)
    (for (in kind (. place wanted))
      (let found ([] hints (str head " " kind)))
      (return-if found (if (!= found null)))
    )
    (return null)
  )
  (fn-do _ place BrixPlace
    (param wanted (list String))
    (let key (call (. "/" join) wanted))
    (let known ([] places key))
    (return-if known (if (!= known null)))
    (let reach (list String))
    (let queue (list String))
    (++= queue wanted)
    (let cursor Index 0)
    (while (< cursor (. queue length))
      (let name ([] queue cursor))
      (+= cursor 1)
      (if (has reach name)
        (continue)
      )
      (+= reach name)
      (for (in word (. (call kind name) accepts))
        (if (and (> (. word length) 1) (call (. word starts-with) "+"))
          (+= queue ([] word (... 1)))
        )
      )
    )
    (let dropped (list String))
    (for (in name reach)
      (for (in word (. (call kind name) accepts))
        (if (and (> (. word length) 1) (call (. word starts-with) "-"))
          (+= dropped ([] word (... 1)))
        )
      )
    )
    (let admits (call List (in false kinds)))
    (let rejects (call List (in false kinds)))
    (for (in name reach)
      (for (in word (. (call kind name) accepts))
        (if (and (> (. word length) 1) (call (. word starts-with) "!"))
          (= ([] rejects (. (call kind ([] word (... 1))) index)) true)
        )
      )
    )
    (let literals (list String))
    (let leads (list String))
    (let is-free false)
    (let takes-atoms false)
    (let takes-types false)
    (let takes-strings false)
    (let takes-params false)
    (let takes-piped false)
    (let width Size 0)
    (for (in name reach)
      (if (has dropped name)
        (continue)
      )
      (let held (call kind name))
      (= ([] admits (. held index)) true)
      (+= width 1)
      (if (== name "Params")
        (= takes-params true)
      )
      (for (in word (. held accepts))
        (if (== word "any")
          (= is-free true)
          (else-if (== word "atoms")
            (= takes-atoms true)
          )
          (else-if (== word "types")
            (= takes-types true)
          )
          (else-if (== word "strings")
            (= takes-strings true)
          )
          (else-if (== word "piped")
            (= takes-piped true)
          )
          (else-if (and (> (. word length) 1) has-prefix-mark)
            (continue)
          )
          (else-if (and (> (. word length) 1) (call (. word ends-with) "*"))
            (+= leads ([] word (..< 0 (- (. word length) 1))))
          )
          (else
            (+= literals word)
          )
        )
        (lazy has-prefix-mark (or (call (. word starts-with) "+") (call (. word starts-with) "-") (call (. word starts-with) "!")))
      )
    )
    (let note (? String) null)
    (for (in name wanted)
      (let text (. (call kind name) note))
      (if (and (!= text null) (== note null))
        (= note text)
      )
    )
    (let made
      (call BrixPlace
        (block
          (arg wanted)
          (arg admits)
          (arg rejects)
          (arg literals)
          (arg leads)
          (arg is-free)
          (arg takes-atoms)
          (arg takes-types)
          (arg takes-strings)
          (arg takes-params)
          (arg takes-piped)
          (arg note)
          (arg width)
        )
      )
    )
    (= ([] places key) made)
    (return made)
  )
  (fn-expr _ kind BrixKind
    (param name String)
    (before
      (throw (call Panic (str "The Brix catalog names a kind it does not declare: " name)) (if (== known null)))
    )
    known
    (where
      (lazy known ([] named name))
    )
  )
  (fn-do _ load-forms _
    (let scratch (use (call Arena)))
    (for (in line brix-form-lines)
      (call load line scratch)
    )
  )
  (fn-do _ load _
    (param line String)
    (param scratch Arena)
    (if (call (. line starts-with) "= ")
      (+= sections (call BrixSection ([] line (... 2))))
      (return)
    )
    (let parts (call List (call (. line split) " | ")))
    (let lead ([] parts 0))
    (if (call (. lead starts-with) "kind ")
      (let made (call BrixKind ([] lead (... 5)) (. kinds length) (call words ([] parts 1)) ([] parts 2)))
      (+= kinds made)
      (= ([] named (. made name)) made)
      (return)
    )
    (if (call (. lead starts-with) "note ")
      (= (. (call kind ([] lead (... 5))) note) ([] parts 1))
      (return)
    )
    (if (call (. lead starts-with) "after ")
      (= (. (call kind ([] lead (... 6))) overflow) ([] parts 1))
      (return)
    )
    (if (call (. lead starts-with) "hint ")
      (= ([] hints ([] lead (... 5))) ([] parts 1))
      (return)
    )
    (throw (call Panic (str "The Brix catalog has a malformed line: " line)) (if (!= (. parts length) 3)))
    (let is-refusal (call (. lead starts-with) "refuse "))
    (let tape
      (call sexp-tape ([] parts 1) scratch false
        (block
          (on-error (: failure SexpError)
            (throw (call Panic (str "The Brix catalog has a malformed form: " ([] parts 1))))
          )
        )
      )
    )
    (let sense (call read (call (. (if-expr is-refusal ([] lead (... 7)) lead) split) ",") tape 0 ([] parts 2) ([] parts 1)))
    (call (. scratch reset))
    (if is-refusal
      (let held ([] refusals (. sense head)))
      (if (!= held null)
        (+= held sense)
        (else
          (= ([] refusals (. sense head)) (call (of List BrixSense) sense))
        )
      )
      (return)
    )
    (let known ([] headed (. sense head)))
    (if (!= known null)
      (+= known sense)
      (else
        (= ([] headed (. sense head)) (call (of List BrixSense) sense))
      )
    )
    (if (> (. sections length) 0)
      (+= (. ([] sections (- (. sections length) 1)) senses) sense)
    )
  )
  (fn-expr _ words (list String)
    (param text String)
    (if-expr (== text "-") (call (of List String)) (call List (call (. text split) " ")))
  )
  (fn-do _ read BrixSense
    (param names (stream String))
    (param tape SexpTape)
    (param index Index)
    (param meaning String)
    (param shape String)
    (let close (call (. tape close-of) index))
    (let head (call (. tape atom-text) (+ index 1)))
    (let slots (list BrixSlot))
    (let is-doing false)
    (let item (call (. tape after) (+ index 1)))
    (while (< item close)
      (if (call (. tape is-open) item)
        (let form (call read (call (of List String)) tape item "" ""))
        (= item (call (. tape after) item))
        (let mark "")
        (if (and (< item close) (call is-mark tape item))
          (= mark (call (. tape atom-text) item))
          (= item (call (. tape after) item))
        )
        (+= slots (call BrixSlot "" mark (str "(" (. form head) " …)") "" null null form))
        (continue)
      )
      (let text (call (. tape atom-text) item))
      (= item (call (. tape after) item))
      (let mark (call suffix text))
      (let body (if-expr (!= mark "") ([] text (..< 0 (- (. text length) 1))) text))
      (let pieces (call List (call (. body split) ":")))
      (if (and (== (. pieces length) 2) (!= ([] pieces 0) "") (!= ([] pieces 1) ""))
        (let role ([] pieces 0))
        (+= slots
          (call BrixSlot
            (block
              (arg role)
              (arg mark)
              (arg body)
              (arg (call spot role mark head))
              (arg (call place (call List (call (. ([] pieces 1) split) "/"))))
            )
          )
        )
        (else
          (if (== body ":do")
            (= is-doing true)
          )
          (+= slots (call BrixSlot "" mark (str "`" body "`") "" null body))
        )
      )
    )
    (let kinds (call List names))
    (return (call BrixSense kinds (call List (in (. (call kind each) index) kinds)) head slots meaning shape is-doing))
  )
  (fn-expr _ is-mark Bool
    (param tape SexpTape)
    (param index Index)
    (and (call (. tape is-atom) index) is-quantifier)
    (where
      (lazy is-quantifier (or (call (. tape atom-is) index "?") (call (. tape atom-is) index "*") (call (. tape atom-is) index "+")))
    )
  )
  (fn-expr _ suffix String
    (param text String)
    (case? (< (. text length) 2)
      ""
    )
    (case? (call (. text ends-with) "?")
      "?"
    )
    (case? (call (. text ends-with) "*")
      "*"
    )
    (case? (call (. text ends-with) "+")
      "+"
    )
    (default
      ""
    )
  )
  (fn-expr _ spot String
    (param role String)
    (param mark String)
    (param head String)
    (str article " `" role "` of (" head " …)")
    (where
      (lazy is-many (or (== mark "*") (== mark "+")))
      (lazy is-vowel (has (list "a" "e" "i" "o" "u") ([] role (..< 0 1))))
      (lazy article (if-expr is-many (if-expr is-vowel "an" "a") "the"))
    )
  )
)
