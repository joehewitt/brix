        row.body = shift.node(row.body)
    | .node-markup-slot-forward(row)
        row.slot-binding = shift.node(row.slot-binding)
        row.outlet = shift.node(row.outlet)
    | .node-slot-outlet(row)
        row.name = shift.node(row.name)
        row.type-id = shift.node(row.type-id)
        row.slot-parameter = shift.node(row.slot-parameter)
        row.slot-attrs = shift.child-range(row.slot-attrs)
        row.style-rule-applications = shift.child-range(row.style-rule-applications)
        row.body = shift.node(row.body)
    | .node-style-rule-application(row)
        row.args = shift.child-range(row.args)
        row.condition = shift.node(row.condition)
    | .node-structure-match(row)
        row.pattern = shift.node(row.pattern)
    | .node-type-arguments(row)
        row.base = shift.node(row.base)
        row.args = shift.child-range(row.args)
    | .node-type-associated(row)
        row.owner = shift.node(row.owner)
