./ast-builder
./ast-nodes
./row-range
/core/array-builder
/core/parsing
/core/table

━━━━━━━━━━━━━━━━━━━━
+ SyntaxShift is Tuple

+ nodes U32
+ children U32
+ atoms U32
+ lines U32

────────────────────
+ node SyntaxId
    - id SyntaxId

if id == 0 then id else id + nodes

────────────────────
+ child-range RowRange'SyntaxId
    - range RowRange'SyntaxId

RowRange'SyntaxId(range.start + children, range.count)

────────────────────
+ atom-range RowRange'Atom
    - range RowRange'Atom

RowRange'Atom(range.start + atoms, range.count)

────────────────────
+ location MatchLocation
    - loc MatchLocation

if loc == MatchLocation() then loc else MatchLocation(shifted-begin, shifted-end)

.. shifted-begin = TokenLocation(loc.begin.line + lines, loc.begin.column)
.. shifted-end = TokenLocation(loc.end.line + lines, loc.end.column)

━━━━━━━━━━━━━━━━━━━━
+ extend ASTBuilder

────────────────────
+ do append-piece SyntaxShift
    - piece ASTBuilder
    - lines U32

. shift = SyntaxShift((nodes.length - 1) as U32, children.length as U32, atoms.length as U32, lines)
. first = nodes.length
nodes.reserve(first + piece.nodes.length - 1)
for row in piece.nodes[1 .. < piece.nodes.length]
    nodes.append(row)
children.reserve(children.length + piece.children.length)
for index in 0 .. < piece.children.length
    children.append(shift.node(piece.children[index]))
atoms.reserve(atoms.length + piece.atoms.length)
for index in 0 .. < piece.atoms.length
    atoms.append(piece.atoms[index])
for index in 0 .. < piece.stored-atoms.length
    stored-atoms.append(piece.stored-atoms[index])
for id in first .. < nodes.length
    rebase-node(id as SyntaxId, shift)
= shift

────────────────────
_ do rebase-node
    - id SyntaxId
    - shift SyntaxShift

nodes.loc[id] = shift.location(nodes.loc[id])
match? nodes[id]
    | .node-top-level-syntax(row)
        row.statements = shift.child-range(row.statements)
    | .node-block(row)
        row.body = shift.child-range(row.body)
    | .node-print(row)
        row.body = shift.node(row.body)
    | .node-declare(row)
        row.left = shift.node(row.left)
        row.right = shift.node(row.right)
    | .node-assertion-syntax(row)
        row.exception = shift.node(row.exception)
        row.condition = shift.node(row.condition)
    | .node-class-block(row)
        row.type-args = shift.child-range(row.type-args)
        row.aliases = shift.atom-range(row.aliases)
        row.base = shift.node(row.base)
        row.or-bases = shift.child-range(row.or-bases)
        row.members = shift.child-range(row.members)
        row.param-constraints = shift.child-range(row.param-constraints)
        row.param-assignments = shift.child-range(row.param-assignments)
        row.tags = shift.atom-range(row.tags)
        row.facet-of = shift.node(row.facet-of)
    | .node-extension(row)
        row.receiver = shift.node(row.receiver)
        row.as-types = shift.child-range(row.as-types)
        row.param-constraints = shift.child-range(row.param-constraints)
        row.param-assignments = shift.child-range(row.param-assignments)
        row.body = shift.child-range(row.body)
    | .node-style-sheet-extension(row)
        row.receiver = shift.node(row.receiver)
        row.body = shift.child-range(row.body)
    | .node-effect-declaration(row)
        row.claims = shift.atom-range(row.claims)
    | .node-event-declaration(row)
        row.type = shift.node(row.type)
        row.key-type = shift.node(row.key-type)
    | .node-function-syntax(row)
        row.names = shift.atom-range(row.names)
        row.pattern = shift.node(row.pattern)
        row.args = shift.child-range(row.args)
        row.type-args = shift.child-range(row.type-args)
        row.return-type = shift.node(row.return-type)
        row.errors = shift.child-range(row.errors)
        row.param-constraints = shift.child-range(row.param-constraints)
        row.param-assignments = shift.child-range(row.param-assignments)
        row.body = shift.node(row.body)
        row.property-annotations = shift.atom-range(row.property-annotations)
        row.bans = shift.atom-range(row.bans)
        row.property-site = shift.node(row.property-site)
    | .node-getter-syntax(row)
        row.names = shift.atom-range(row.names)
        row.pattern = shift.node(row.pattern)
        row.args = shift.child-range(row.args)
        row.type-args = shift.child-range(row.type-args)
        row.return-type = shift.node(row.return-type)
        row.errors = shift.child-range(row.errors)
        row.param-constraints = shift.child-range(row.param-constraints)
        row.param-assignments = shift.child-range(row.param-assignments)
        row.body = shift.node(row.body)
        row.property-annotations = shift.atom-range(row.property-annotations)
        row.bans = shift.atom-range(row.bans)
        row.property-site = shift.node(row.property-site)
    | .node-setter-syntax(row)
        row.names = shift.atom-range(row.names)
        row.pattern = shift.node(row.pattern)
        row.args = shift.child-range(row.args)
        row.type-args = shift.child-range(row.type-args)
        row.return-type = shift.node(row.return-type)
        row.errors = shift.child-range(row.errors)
        row.param-constraints = shift.child-range(row.param-constraints)
        row.param-assignments = shift.child-range(row.param-assignments)
        row.body = shift.node(row.body)
        row.property-annotations = shift.atom-range(row.property-annotations)
        row.bans = shift.atom-range(row.bans)
        row.property-site = shift.node(row.property-site)
    | .node-property-syntax(row)
        row.left = shift.node(row.left)
        row.value = shift.node(row.value)
        row.annotations = shift.atom-range(row.annotations)
    | .node-state-machine(row)
        row.body = shift.child-range(row.body)
    | .node-state-case(row)
        row.target = shift.child-range(row.target)
        row.trigger = shift.node(row.trigger)
