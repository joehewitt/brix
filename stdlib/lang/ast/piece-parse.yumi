./ast-builder
./ast-nodes
./ast-rebase
./error
./grammar
./grammar-helpers
./preparse
./row-range
/core/arena
/core/array-builder
/core/atom-pool
/core/parsing

_ default-piece-length Size = 65536

━━━━━━━━━━━━━━━━━━━━
+ do parse-yumi-in-pieces ASTBuilder ?! YumiSyntaxError
    - source String
    - source-path String
    - scratch Arena
    - pool Worker
    - atoms AtomPool
    - atom-lock Mutex
    - piece-length Size = default-piece-length

. dividers [PreparseDivider]
. preparsed = preparse(source, scratch, dividers)
. plan = plan-pieces(preparsed, dividers, piece-length)
if plan.pieces.length > 1
    . merged = parse-pieces(preparsed, source, source-path, plan, scratch, pool, atoms, atom-lock)
    =? merged if merged
= parse-yumi-preparsed(preparsed, source, source-path, scratch)

━━━━━━━━━━━━━━━━━━━━
_ PieceKind is U8

| statements-piece
| class-head-piece
| members-piece
| class-end-piece

━━━━━━━━━━━━━━━━━━━━
_ PieceSpan is Tuple

+ kind PieceKind
+ start Index
+ end Index
+ lines U32
+ class-location MatchLocation = MatchLocation()

━━━━━━━━━━━━━━━━━━━━
_ PiecePlan is Tuple

+ pieces [PieceSpan]
+ end TokenLocation

━━━━━━━━━━━━━━━━━━━━
_ ParsedPiece is Tuple

+ index Index
+ tree ASTBuilder?
+ piece YumiPiece?

━━━━━━━━━━━━━━━━━━━━
_ do plan-pieces PiecePlan
    - preparsed Char[]
    - dividers [PreparseDivider]
    - piece-length Size

. pieces [PieceSpan]
=? PiecePlan(pieces, TokenLocation(0, 0)) if preparsed.size < piece-length * 2
. starts [Index]
starts += 0
for offset in 0 .. < preparsed.size
    . char = preparsed[offset]
    if char == '\n'
        starts += offset + 1
    else if char == '\r'
        = PiecePlan(pieces, TokenLocation(0, 0))

. size = preparsed.size
. last = starts.length - 1
. start Index = 0
. start-line Index = 0
. position Index = 0
while position < dividers.length
    . divider = dividers[position]
    position += 1
    if !divider.thick
        continue
    . section-line = divider.line
    . section-start = starts[section-line]
    . next = position
    while next < dividers.length && !dividers[next].thick
        next += 1
    . end-line = if next < dividers.length then dividers[next].line else last
    . section-end = starts[end-line]
    if section-end - section-start > piece-length
        . cuts = class-cuts
            - preparsed
            - starts
            - dividers
            - position
            - next
            - section-line
            - end-line
            - piece-length
        if cuts.length != 0
            if section-start > start
                pieces += PieceSpan(.statements-piece, start, section-start, start-line as U32)
            add-class-pieces(pieces, starts, cuts, section-line, end-line)
            start = section-end
            start-line = end-line
            position = next
            continue
    if section-start - start >= piece-length
        pieces += PieceSpan(.statements-piece, start, section-start, start-line as U32)
        start = section-start
        start-line = section-line
if start < size
    pieces += PieceSpan(.statements-piece, start, size, start-line as U32)
= PiecePlan(pieces, TokenLocation((last - 1) as U32, (size - 1 - starts[last - 1]) as U32))

━━━━━━━━━━━━━━━━━━━━
_ do class-cuts [Index]
    - preparsed Char[]
    - starts [Index]
    - dividers [PreparseDivider]
    - first Index
    - limit Index
    - section-line Index
    - end-line Index
    - piece-length Size

. cuts [Index]
=? cuts if section-line == 0
. section-start = starts[section-line]
. close = starts[end-line] - 2
=? cuts if preparsed[section-start] != '≤' || preparsed[section-start + 1] != '\n'
=? cuts if !is-class-line(preparsed, section-start + 2)
=? cuts if preparsed[close] != '≥' || preparsed[close - 1] != '≥' || preparsed[close + 1] != '\n'
. start = section-start
for position in first .. < limit
    . offset = starts[dividers[position].line]
    if offset - start >= piece-length && close - offset >= piece-length / 2
        cuts += dividers[position].line
        start = offset
= cuts

━━━━━━━━━━━━━━━━━━━━
_ is-class-line Bool
    - preparsed Char[]
    - offset Index

has-room && (lead == '+' || lead == '_') && has-space && initial >= 'A' && initial <= 'Z'
    .. lead = preparsed[offset]
    .. initial = preparsed[offset + 2]
    .. has-room = offset + 2 < preparsed.size
    .. has-space = preparsed[offset + 1] == ' '

━━━━━━━━━━━━━━━━━━━━
_ do add-class-pieces
    - pieces [PieceSpan]
    - starts [Index]
    - cuts [Index]
    - section-line Index
    - end-line Index

. close = starts[end-line] - 2
. close-line = end-line - 1
. location = MatchLocation
    - TokenLocation(section-line as U32, 0)
    - TokenLocation(close-line as U32, (close - starts[close-line]) as U32)
pieces += PieceSpan
    - .class-head-piece
    - starts[section-line]
    - starts[cuts[0]]
    - (section-line - 1) as U32
for index in 0 .. < cuts.length
    . line = cuts[index]
    if index + 1 < cuts.length
        pieces += PieceSpan
            - .members-piece
            - starts[line]
            - starts[cuts[index + 1]]
            - (line - 1) as U32
    else
        pieces += PieceSpan(.class-end-piece, starts[line], close, (line - 1) as U32, location)

━━━━━━━━━━━━━━━━━━━━
_ do parse-pieces ASTBuilder?
    - preparsed Char[]
    - source String
    - source-path String
    - plan PiecePlan
    - scratch Arena
    - pool Worker
    - atoms AtomPool
    - atom-lock Mutex

. count = plan.pieces.length
. results SyncBufferedChannel'ParsedPiece
for index in 0 .. < count
    . span = plan.pieces[index]
    do (pool) new
        results <- parse-piece(preparsed, source, source-path, span, index, atoms, atom-lock)
. slots [ParsedPiece?]
for _ in 0 .. < count
    slots += null
. merge = PieceMerge(plan, scratch)
. failed = false
for _ in 0 .. < count
    . result = (<- results)!
    slots[result.index] = result
    failed = failed || !result.tree
    while !failed && merge.next < count && slots[merge.next]
        . ready = slots[merge.next]!
        slots[merge.next] = null
        merge.take(ready)
if failed
    merge.release()
    for slot in slots
        if slot && slot.tree
            slot.tree.release()
    = null
. merged = catch merge.finish()
=? null if merged is Error
= merged as ASTBuilder

━━━━━━━━━━━━━━━━━━━━
_ do parse-piece ParsedPiece
    - preparsed Char[]
    - source String
    - source-path String
    - span PieceSpan
    - index Index
    - atoms AtomPool
    - atom-lock Mutex

. tree = if index == 0 then ASTBuilder(source, source-path) else blank-tree
    .. blank-tree = ASTBuilder("", source-path, span.end - span.start)
. scratch = use Arena()
. parsed = catch parse-yumi-piece(piece-buffer(preparsed, span), scratch, tree)
if parsed is Error
    tree.release()
    = ParsedPiece(index, null, null)
. piece = parsed as YumiPiece
tree.share-program-atoms(atoms, atom-lock)
= ParsedPiece
    - index
    - tree
    - YumiPiece(piece.location, piece.items, shared-header(atoms, atom-lock, piece.header))

━━━━━━━━━━━━━━━━━━━━
_ do piece-buffer Char[]
    - preparsed Char[]
    - span PieceSpan

. length = span.end - span.start
=? preparsed[span.start .. < span.end] if span.kind == .statements-piece
. ending = if span.kind == .class-end-piece then 1 else 0
. buffer = Char[length + 2 + ending]
buffer[0] = if span.kind == .class-head-piece then '\ufdd1' else '\ufdd2'
buffer[1] = '\n'
buffer[2 .. < 2 + length] = preparsed[span.start .. < span.end]
if ending != 0
    buffer[length + 2] = '\n'
= buffer

━━━━━━━━━━━━━━━━━━━━
_ do shared-header ClassHeader?
    - atoms AtomPool
    - atom-lock Mutex
    - header ClassHeader?

=? null if !header
. found = header
use atom-lock
. name = atoms.store(found.name.text)
. aliases = shared-atoms(found.aliases, atoms) if found.aliases
= ClassHeader
    - found.location
    - found.access
    - name
    - found.type-args
    - aliases
    - found.inherits
    - found.header

━━━━━━━━━━━━━━━━━━━━
_ do shared-atoms ImmutableArray'Atom
    - names ImmutableArray'Atom
    - atoms AtomPool

. shared = ArrayBuilder'Atom()
for name in names
    shared.append(atoms.store(name.text))
= shared.finish-immutable()

━━━━━━━━━━━━━━━━━━━━
_ PieceMerge

+ next Index
_ plan PiecePlan
_ scratch Arena
_ tree ASTBuilder?
_ top = ArrayBuilder'SyntaxId()
_ header ClassHeader?
_ members = ArrayBuilder'SyntaxId()

────────────────────
+ This
    - plan PiecePlan
    - scratch Arena

────────────────────
+ do take
    - parsed ParsedPiece

. piece = parsed.piece!
. span = plan.pieces[next]
next += 1
if !tree
    . first = parsed.tree!
    first.pattern-collector-context = scratch
    tree = first
    for item in piece.items
        top.append(item)
    =
. merged = tree
. piece-tree = parsed.tree!
. shift = merged.append-piece(piece-tree, span.lines)
piece-tree.release()
if span.kind == .class-head-piece
    header = shifted-header(piece.header!, shift)
    members = ArrayBuilder'SyntaxId()
for item in piece.items
    if span.kind == .statements-piece
        top.append(shift.node(item))
    else
        members.append(shift.node(item))
if span.kind == .class-end-piece
    top.append
        - make-class-declaration(merged, span.class-location, header!, members.finish-immutable())

────────────────────
+ do finish ASTBuilder ?! YumiSyntaxError

. merged = tree!
. succeeded = false
do finally
    merged.pattern-collector-context = merged.storage-arena
    if !succeeded
        merged.release()
. statements = link-statements(merged, top.finish-immutable())
. root = merged.append
    - ASTTopLevel(MatchLocation(TokenLocation(0, 0), plan.end), merged.store-children(statements))
merged.name-closures()
merged.finalize-syntax()
merged.root = root
scratch.reset()
succeeded = true
= merged

────────────────────
+ do release

if tree
    tree.release()

━━━━━━━━━━━━━━━━━━━━
_ shifted-header ClassHeader
    - header ClassHeader
    - shift SyntaxShift

ClassHeader
    - shift.location(header.location)
    - header.access
    - header.name
    - shifted-ids(header.type-args, shift)
    - header.aliases
    - inherits
    - variants

.. inherits = shifted-ids(header.inherits, shift) if header.inherits
.. variants = shifted-variants(header.header, shift) if header.header

━━━━━━━━━━━━━━━━━━━━
_ do shifted-ids ImmutableArray'SyntaxId
    - ids ImmutableArray'SyntaxId
    - shift SyntaxShift

. shifted = ArrayBuilder'SyntaxId()
for id in ids
    shifted.append(shift.node(id))
= shifted.finish-immutable()

━━━━━━━━━━━━━━━━━━━━
_ do shifted-variants ImmutableArray'ArgumentVariant
    - variants ImmutableArray'ArgumentVariant
    - shift SyntaxShift

. shifted = ArrayBuilder'ArgumentVariant()
for variant in variants
    shifted.append(shifted-variant(variant, shift))
= shifted.finish-immutable()

━━━━━━━━━━━━━━━━━━━━
_ shifted-variant ArgumentVariant
    - variant ArgumentVariant
    - shift SyntaxShift

match variant
    | .param-constraint(value)
        .param-constraint(shift.node(value))
    | .param-assignment(value)
        .param-assignment(shift.node(value))
    | .argument-decl(value)
        .argument-decl(shift.node(value))
    | .implements-declaration(value)
        .implements-declaration(shift.node(value))
    | .using-declaration(value)
        .using-declaration(shift.node(value))
    | .iterator-header(location, loop)
        .iterator-header(shift.location(location), shift.node(loop))
