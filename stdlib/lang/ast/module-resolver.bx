(import ./c-header)
(import /core/parsing)
(import /lang/constants)
(import /lang/target)
(import /os/env)
(import /os/path)
(import /stream/aggregate)
(blank)
(prop _ private-prefix _ (= "_"))

(type + ResolvedModule (is Tuple)
  (prop + name String)
  (prop + path Path)
)

(type + AbsentImport (is Tuple)
  (prop + module String)
  (prop + path String)
)

(type + ModuleResolver
  (prop + search-paths (list Path))
  (prop + c-module-paths (map String (list Path)))
  (prop + c-headers _ (= host-c-headers))
  (prop _ module-hits (map String ResolvedModule))
  (prop _ module-misses (map String Bool))
  (prop _ c-module-hits (map String Path))
  (prop _ c-module-misses (map String Bool))
  (prop _ absent (list String))
  (fn-do + This _
    (param configured-search-paths (list Path))
    (param configured-c-module-paths (map String (list Path)))
    (for (in configured configured-search-paths)
      (+= search-paths (call resolved-path configured ""))
    )
    (+= c-module-paths runtime-c-paths)
    (= ([] c-module-paths "c") (list (. c-headers c-root)))
    (+= c-module-paths configured-c-module-paths)
  )
  (fn-do + use-c-headers _
    (param headers CHeaders)
    ; Finds and reads C headers in `headers` from now on.
    (= c-headers headers)
    (= ([] c-module-paths "c") (list (. headers c-root)))
    (call (. c-module-hits clear))
    (call (. c-module-misses clear))
  )
  (fn-expr + path-to-module (? Path)
    (param name String)
    (match? (call find-module name null null)
      (case (tuple _ module-path)
        module-path
      )
    )
  )
  (fn-do + module-name-of (? String)
    (param path String)
    ; The name an import finds the module at `path` by: its place in a search path, without its
    ; extension, named as `search-module` names what it finds. Nothing where no search path holds it,
    ; or where that name finds another file first.
    (return-if null (if (not path)))
    (blank)
    (let whole (call resolved-path path ""))
    (let file Path whole)
    (for (in root search-paths)
      (let base (as root String))
      (if (call (. whole starts-with) (str base separator))
        (let place ([] whole (... (+ (. base length) 1))))
        (let stem ([] place (..< 0 (+ (- (. place length) (. file name length)) (. file base-name length)))))
        (match? (call find-module (call folder-name stem file) null null)
          (case (tuple module-name module-path)
            (return-if module-name (if (== (as module-path String) whole)))
          )
        )
      )
    )
    (return null)
  )
  (fn-do + relative-path String
    (param path String)
    (param root-paths (list String))
    (return-if path (if (not path)))
    (blank)
    (let whole (call resolved-path path ""))
    (for (in root search-paths)
      (let base (as root String))
      (return-if ([] whole (... (+ (. base length) 1))) (if (call (. whole starts-with) (str base separator))))
    )
    (for (in (tuple _ roots) c-module-paths)
      (for (in root roots)
        (let base (call resolved-path root ""))
        (return-if ([] whole (... (+ (. base length) 1))) (if (call (. whole starts-with) (str base separator))))
      )
    )
    (for (in root-path root-paths)
      (let base (call resolved-path (. (call Path root-path) dir) ""))
      (return-if ([] whole (... (+ (. base length) 1))) (if (call (. whole starts-with) (str base separator))))
    )
    (return (call path-between (call resolved-path (. (call Path (if-expr root-paths ([] root-paths 0) "")) dir) "") whole))
  )
  (fn-do + resolve-module (? ResolvedModule)
    (param name String)
    (param base-path (? String))
    (let header (call find-c-module name))
    (if header
      (return (call ResolvedModule name header))
    )
    (blank)
    (return
      (match? (call find-module name null base-path)
        (case (tuple module-name module-path)
          (call ResolvedModule module-name module-path)
        )
      )
    )
  )
  (fn-expr + c-module-functions (list CHeaderFunction)
    (param header String)
    (call c-header-functions c-headers (call c-include-paths) header)
  )
  (fn-do + find-module _
    (param written String)
    (param base-name (? String))
    (param base-path (? String))
    (return-if null (if (!= (call refused-folder written base-name base-path) null)))
    (return (call locate-module written base-name base-path))
  )
  (fn-do + family-base (? String)
    (param path String)
    ; The base module of the file family a module belongs to: the module named after the first part
    ; of its name, beside it, as `box.bx` is for `box.scroll.bx`. A module whose name has one part,
    ; or with no such module beside it, belongs to none.
    (let file (call Path path))
    (let stem (call source-stem (. file name)))
    (return-if null (if (not stem)))
    (blank)
    (let first (call (. stem find) "."))
    (return-if null (if (not first)))
    (blank)
    (let base (call source-file (as (/ (. file dir) ([] stem (..< 0 first))) String)))
    (return (only-if (as base String) (if base)))
  )
  (fn-do + in-family Bool
    (param path String)
    (param base String)
    ; Whether a module is the base module of a file family or one of its modules.
    (return (or (== path base) (== (call family-base path) base)))
  )
  (fn-do + refused-folder (? String)
    (param written String)
    (param base-name (? String))
    (param base-path (? String))
    (return-if null (if (not base-path)))
    (return
      (match? (call locate-module written base-name base-path)
        (case (tuple module-name module-path)
          (call private-folder-outside module-name module-path base-path)
        )
      )
    )
  )
  (fn-expr _ private-folder-outside (? String)
    (param module-name String)
    (param module-path Path)
    (param base-path String)
    (case? (or (not (call (. module-path name starts-with) private-prefix)) inside)
      null
    )
    (default
      (as (. (call Path module-name) dir) String)
    )
    (where
      (lazy inside (or (== importer folder) (call (. importer starts-with) (str folder separator))))
      (lazy folder (call resolved-path (. module-path dir) ""))
      (lazy importer (call resolved-path (. (call Path base-path) dir) ""))
    )
  )
  (fn-do _ locate-module _
    (param written String)
    (param base-name (? String))
    (param base-path (? String))
    (let name (if-expr (call (. written starts-with) "../") (str "./" written) written))
    (let key
      (block
        (case? (call (. name starts-with) "./")
          (str name "\n" (. (call Path (?? base-name "")) dir) "\n" (. (call Path (?? base-path "")) dir))
        )
        (default
          name
        )
      )
    )
    (return?
      (match? ([] module-hits key)
        (case (: hit ResolvedModule)
          (tuple (. hit name) (. hit path))
        )
      )
    )
    (blank)
    (if ([] module-misses key)
      (return null)
    )
    (blank)
    (let found (call search-module name base-name base-path))
    (match? found
      (case (tuple module-name module-path)
        (= ([] module-hits key) (call ResolvedModule module-name module-path))
      )
    )
    (if (not found)
      (= ([] module-misses key) true)
    )
    (return found)
  )
  (fn-do + take-absent (list String)
    (let taken absent)
    (= absent (call (of List String)))
    (return taken)
  )
  (fn-do + find-c-module (? Path)
    (param name String)
    (return?
      (match? ([] c-module-hits name)
        (case (: hit Path)
          hit
        )
      )
    )
    (blank)
    (if ([] c-module-misses name)
      (return null)
    )
    (blank)
    (let found (call search-c-module name))
    (if found
      (= ([] c-module-hits name) found)
      (else
        (= ([] c-module-misses name) true)
      )
    )
    (return found)
  )
  (fn-do _ search-module _
    (param name String)
    (param base-name (? String))
    (param base-path (? String))
    (let tail-name
      (block
        (case? (call (. name find-reverse) "/")
          ([] name (... (+ (!! it) 1)))
        )
        (default
          name
        )
      )
    )
    (for (in each (call try-module-paths name base-name base-path))
      (let found (?? (call source-file (str ([] each 1) "/" tail-name)) (call source-file (as ([] each 1) String))))
      (return-if (tuple (call folder-name ([] each 0) found) found) (if found))
    )
    (return null)
  )
  (fn-expr _ folder-name String
    (param name String)
    (param file Path)
    (case? (and (== (. file dir name) stem) (or (== name doubled) (call (. name ends-with) (str "/" doubled))))
      ([] name (..< 0 (- (. name length) (. stem length) 1)))
    )
    (default
      name
    )
    (where
      (lazy stem (. file base-name))
      (lazy doubled (str stem "/" stem))
    )
  )
  (fn-do _ source-file (? Path)
    (param stem String)
    (let brix-path Path (str stem brix-extension))
    (let has-brix (?? (catch? (. brix-path is-file)) false))
    (return-if brix-path (if has-brix))
    (blank)
    (+= absent (as brix-path String))
    (return null)
  )
  (fn-do _ search-c-module (? Path)
    (param name String)
    (let head (as (. (call Path name) head) String))
    (let tail (as (. (call Path name) tail) String))
    (let c-root head)
    (let c-tail tail)
    (blank)
    (if (== head name)
      (= c-root "c")
      (= c-tail name)
    )
    (blank)
    (let c-paths ([] c-module-paths c-root))
    (if (not c-paths)
      (= c-root "c")
      (= c-tail name)
      (= c-paths ([] c-module-paths c-root))
    )
    (blank)
    (let found
      (block
        (spread? c-paths)
        (pipe *>
          (match c-root
            (case= "c"
              (/ each c-tail)
            )
            (default
              (/ each c-root c-tail)
            )
          )
        )
        (pipe ?> (call has-c-file each))
        (pipe |> first)
      )
    )
    (blank)
    (return found)
  )
  (fn-do _ has-c-file Bool
    (param path Path)
    ; Whether a C header is at `path`: in the snapshot the headers are read from, or on disk.
    (return-if (call (. c-headers snapshot has) header-key) (if (. c-headers snapshot)))
    (blank)
    (lazy header-key (call snapshot-key (. c-headers c-root) (call c-include-paths) (as path String)))
    (return (?? (catch? (. path is-file)) false))
  )
  (fn-do + c-include-paths (list Path)
    (let paths (list Path))
    (for (in (tuple root roots) c-module-paths)
      (if (!= root "c")
        (++= paths roots)
      )
    )
    (return paths)
  )
  (fn-expr _ try-module-paths _
    (param name String)
    (param base-name (? String))
    (param base-path (? Path))
    ; The names and paths a module `name` may be found at, in order. A name that starts with `./` is
    ; found beside the module at `base-path`, or its private file there; any other name in each
    ; search path. A path beside a module is absolute, as the search paths are, so a module reached
    ; by a relative import and by a rooted one has one name. One in no search path is named from the
    ; module that imports it, with its `..` folded (`folded-name`), so that relative imports from
    ; modules in different directories name it alike. Every path has its `.` and `..` segments
    ; folded, so a module reached by different paths is one module.
    (case? (call (. name starts-with) "./")
      (item (tuple full-name (as full-path Path)))
      (item (tuple private-full-name private-path))
      (blank)
      (lazy private-full-name (as (/ (. (call Path full-name) dir) (str private-prefix (. (call Path abs-name) name))) String))
      (lazy full-name
        (scope (?? local-name default-name)
          (lazy local-name
            (block
              (as search-paths (stream String))
              (pipe ?> (call (. full-path starts-with) each))
              (pipe *>
                (scope ([] full-path (... (+ (. each length) (if-expr has-tail-slash 0 1))))
                  (lazy has-tail-slash (call (. each ends-with) "/"))
                )
              )
              (pipe |> first)
            )
          )
          (lazy default-name
            (call folded-name (as (/ base-dir abs-name) String)
              (block
                (lazy base-dir (. (call Path (?? base-name "")) dir))
              )
            )
          )
        )
      )
      (blank)
      (lazy full-path (call resolved-path abs-base-path abs-name))
      (blank)
      (lazy private-path Path
        (call resolved-path abs-base-path private-name
          (block
            (lazy private-name (as (/ dir-name (str private-prefix file-name)) String))
            (lazy dir-name (. name-as-path dir))
            (lazy file-name (. name-as-path name))
            (lazy name-as-path Path abs-name)
          )
        )
      )
      (blank)
      (lazy abs-name ([] name (... 2)))
      (lazy abs-base-path (?? (?. base-path dir) (as (call cwd) Path)))
    )
    (default
      search-paths
      (pipe *> (tuple rooted-name (as (call resolved-path (as each String) rooted-name) Path)))
      (blank)
      (lazy rooted-name (if-expr (call (. name starts-with) "/") ([] name (... 1)) name))
    )
  )
  (fn-do _ folded-name String
    (param name String)
    ; `name` without its `.` segments, and with each `..` segment folded into the segment before it.
    (let parts (list String))
    (for (in part (call (. name split) separator))
      (if (and (== part "..") (!= (. parts length) 0) (!= ([] parts (- (. parts length) 1)) ".."))
        (call (. parts pop))
        (else-if (and part (!= part "."))
          (+= parts part)
        )
      )
    )
    (return (call (. separator join) parts))
  )
  (fn-do _ path-between String
    (param base String)
    (param whole String)
    (let base-parts (list String) (call (. base split) separator))
    (let whole-parts (list String) (call (. whole split) separator))
    (let shared Size 0)
    (while (and (< shared (. base-parts length)) (< shared (. whole-parts length)) (== ([] base-parts shared) ([] whole-parts shared)))
      (+= shared 1)
    )
    (let parts (list String))
    (for (in part ([] base-parts (... shared)))
      (if part
        (+= parts "..")
      )
    )
    (for (in part ([] whole-parts (... shared)))
      (+= parts part)
    )
    (return (call (. separator join) parts))
  )
)
