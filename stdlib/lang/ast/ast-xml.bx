(extend + ASTWheneverRule
  (fn-expr + xml XML :get
    (<> XML (text: "Whenever") (:kind (. kind text))
      (case? target-type
        (call child-xml target-type)
      )
      (default
        (call child-xml expr)
      )
      (call child-xmls args)
      (call child-xml body)
    )
  )
)

(extend + ASTRule
  (fn-do + xml XML :get
    (lazy style-rule-applications-xml (call child-xmls style-rule-applications))
    (let params (call (of ArrayBuilder XML)))
    (for (in offset (..< 0 (. args count)))
      (let id ([] (. syntax-xml-tree children) (+ (. args start) offset)))
      (let argument
        (match ([] (. syntax-xml-tree nodes) id)
          (case (call .node-argument-decl row)
            row
          )
          (throw (call Panic "Expected a style rule argument"))
        )
      )
      (let param
        (match ([] (. syntax-xml-tree nodes) (. argument pattern))
          (case (call .node-type-capture capture)
            (<> XML (text: "Param") (:name (call rule-parameter-name (. capture id)))
              (case? (. capture type)
                (call child-xml (. capture type))
              )
              (default
                (call child-xml (. argument pattern))
              )
            )
          )
          (default
            (<> XML (text: "Param")
              (call child-xml (. argument pattern))
            )
          )
        )
      )
      (call (. params append) param)
    )
    (blank)
    (return
      (<> XML (text: "StyleRule") (:name (. name text)) (:own? is-own)
        (call (. params finish-immutable))
        (if style-rule-applications-xml
          (<> XML (text: "StyleRuleApplications")
            style-rule-applications-xml
          )
        )
        (call child-xml body)
      )
    )
  )
)

(fn-expr _ rule-parameter-name String
  (param id SyntaxId)
  (match ([] (. syntax-xml-tree nodes) id)
    (case (call .node-identifier row)
      (. row name text)
    )
    (throw (call Panic "Expected a style rule parameter name"))
  )
)

