(import ./ast-builder)
(import ./ast-nodes)
(import ./row-range)
(import /core/array-builder)
(import /lang/xmlwriter)
(import /stream/aggregate)
(blank)
(prop _ syntax-xml-tree ASTBuilder @stack)

(extend + ASTBuilder
  (fn-do + syntax-xml XML
    (param id SyntaxId)
    (do-with syntax-xml-tree this
      (return (. ([] (. syntax-xml-tree nodes) id) xml))
    )
  )
  (fn-expr + view XML
    (param id SyntaxId)
    (call syntax-xml id)
  )
  (fn-expr + xml XML :get
    (call syntax-xml root)
  )
  (fn-to-expr + XML
    xml
  )
  (fn-to-expr + String
    xml
  )
)

(fn-expr _ child-xml (? XML)
  (param id SyntaxId)
  (only-if (. ([] (. syntax-xml-tree nodes) id) xml) (if (!= id 0)))
)

(fn-do _ child-xmls (? (of ImmutableArray XML))
  (param range (of RowRange SyntaxId))
  (return-if (if (== (. range count) 0)))
  (blank)
  (let builder (call (of ArrayBuilder XML)))
  (for (in syntax-node ([] (. syntax-xml-tree nodes) (call (. syntax-xml-tree child-ids) range)))
    (let xml (. syntax-node xml))
    (if (or (. xml node-name) (. xml children length))
      (call (. builder append) xml)
    )
  )
  (return (call (. builder finish-immutable)))
)

(fn-do _ atoms-in (of ImmutableArray Atom)
  (param range (of RowRange Atom))
  (let builder (call (of ArrayBuilder Atom)))
  (for (in offset (..< 0 (. range count)))
    (call (. builder append) ([] (. syntax-xml-tree atoms) (+ (. range start) offset)))
  )
  (return (call (. builder finish-immutable)))
)

(fn-expr _ syntax-type-name String
  (param id SyntaxId)
  (match ([] (. syntax-xml-tree nodes) id)
    (case (call .node-type-identifier type)
      (. type name text)
    )
    (case (call .node-core-type-identifier type)
      (. type name text)
    )
    (case (call .node-type-arguments type)
      (str (call syntax-type-name (. type base)) suffix)
      (lazy suffix (if-expr (. type args count) (str "'" argument-names) ""))
      (lazy argument-names
        (call (. "'" join) (in (call syntax-type-name each) argument-ids)
          (block
            (lazy argument-ids (call (. syntax-xml-tree child-ids) (. type args)))
          )
        )
      )
    )
    (case (call .node-type-associated type)
      (str (call syntax-type-name (. type owner)) "." (. type name text) suffix)
      (lazy suffix (if-expr (. type args count) (str "'" argument-names) ""))
      (lazy argument-names
        (call (. "'" join) (in (call syntax-type-name each) argument-ids)
          (block
            (lazy argument-ids (call (. syntax-xml-tree child-ids) (. type args)))
          )
        )
      )
    )
    (throw (call Panic "Expected a named type syntax node"))
  )
)

(fn-do _ probe-object (tuple (? String) (? XML))
  (param id SyntaxId)
  (return-if (tuple null null) (if (not id)))
  (blank)
  (let object-name (? String))
  (let object-child (? XML))
  (match ([] (. syntax-xml-tree nodes) id)
    (case (call .node-identifier row)
      (= object-name (. row name text))
    )
    (default
      (= object-child
        (<> XML (text: "Object")
          (call child-xml id)
        )
      )
    )
  )
  (return (tuple object-name object-child))
)

(extend + ASTNoop
  (fn-expr + xml XML :get
    (<> XML)
  )
)

(extend + ASTTopLevel
  (fn-expr + xml XML :get
    (<> XML
      (call child-xmls statements)
    )
  )
)

(extend + ASTBlock
  (fn-expr + xml XML :get
    (<> XML (text: "Block")
      (if (. body count)
        (call child-xmls body)
      )
    )
  )
)

(extend + ASTProbeScope
  (fn-expr + xml XML :get
    (<> XML (text: "Block")
      (call child-xmls body)
    )
  )
)

(extend + ASTPrint
  (fn-expr + xml XML :get
    (<> XML (text: "Print")
      (call child-xml body)
