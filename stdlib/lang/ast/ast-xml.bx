(extend + ASTDeclare
  (fn-expr + xml XML :get
    (<> XML (text: "Declaration") (:lazy? is-lazy) (:pattern? is-pattern) (:rollback?)
      (call child-xml left)
      (call child-xml right)
    )
  )
)

(extend + ASTAssertion
  (fn-expr + xml XML :get
    (<> XML (text: "Assert")
      (call child-xml condition)
      (call child-xml exception)
    )
  )
)

(extend + ASTClassBlock
  (fn-expr + xml XML :get
    (<> XML (text: "Class") (:name (. name text)) (:access)
      (if (. alias-atoms length)
        (:aliases (call (. ", " join) (in (. each text) alias-atoms)))
      )
      (if (. tag-atoms length)
        (:tags (call (. ", " join) (in (. each text) tag-atoms)))
      )
      (call child-xmls type-args)
      (if facet-of
        (<> XML (text: "FacetOf")
          (call child-xml facet-of)
        )
      )
      (if base
        (<> XML (text: "Implements") (:inherited true)
          (call child-xml base)
        )
      )
      (if (. or-bases count)
        (<> XML (text: "Or")
          (call child-xmls or-bases)
        )
      )
      (call child-xmls param-constraints)
      (call child-xmls param-assignments)
      (call child-xmls members)
    )
    (where
      (lazy alias-atoms (call atoms-in aliases))
      (lazy tag-atoms (call atoms-in tags))
    )
  )
)

(extend + ASTExtension
  (fn-expr + xml XML :get
    (<> XML (text: "Extension") (:access)
      (call child-xml receiver)
      (if (. as-types count)
        (<> XML (text: "As")
          (call child-xmls as-types)
        )
      )
      (call child-xmls param-constraints)
      (call child-xmls param-assignments)
      (call child-xmls body)
    )
  )
)

(extend + ASTStyleSheetExtension
  (fn-expr + xml XML :get
    (<> XML (text: "StyleSheetExtension")
      (call child-xml receiver)
      (call child-xmls body)
    )
  )
)

(extend + ASTEventDeclaration
  (fn-expr + xml XML :get
    (<> XML (text: "Event") (:name (. name text)) (:type (call syntax-type-name type)) (:access)
      (if key-type
        (:keyed (call syntax-type-name key-type))
      )
    )
  )
)

(extend + ASTEffectDeclaration
  (fn-expr + xml XML :get
    (<> XML (text: "Effect") (:name (. name text)) (:access) (:claims (call (. ", " join) (in (. each text) (call atoms-in claims)))))
  )
)

(extend + ASTFunction
  (fn-expr + xml XML :get
    (<> XML (text: "Function") (:names (call (. ", " join) (in (. each text) (call atoms-in names)))) (:access)
      (if is-getter
        (:getter true)
        (else-if is-setter
          (:setter true)
        )
      )
      (:imperative?)
      (if is-static
        (entry "static" true)
      )
      (if compilation-effects
        (:effects (call format-compilation-effect-mask compilation-effects))
      )
      (if is-inline
        (entry "inline" true)
      )
      (if is-live
        (entry "live" true)
      )
      (if is-no-return
        (entry "no-return" true)
      )
      (:rollback?)
      (if (. bans count)
        (:without (call (. ", " join) (in (. each text) (call atoms-in bans))))
      )
      (if door
        (:door (. door text))
      )
      (if pattern
        (<> XML (text: "pattern")
          (call child-xml pattern)
        )
      )
      (call child-xmls type-args)
      (call child-xmls args)
      (call child-xmls param-constraints)
      (call child-xmls param-assignments)
      (call child-xml return-type)
      (if (. errors count)
        (<> XML (text: "errors")
          (call child-xmls errors)
        )
      )
      (call child-xml body)
    )
  )
)

(extend + ASTGetter
  (fn-expr + xml XML :get
    (<> XML (text: "Getter") (:access) (:names (call (. ", " join) (in (. each text) (call atoms-in names)))) (:imperative)
      (call child-xmls type-args)
      (call child-xmls args)
      (call child-xml return-type)
      (call child-xml body)
    )
  )
)

(extend + ASTSetter
  (fn-expr + xml XML :get
    (<> XML (text: "Setter") (:access) (:names (call (. ", " join) (in (. each text) (call atoms-in names)))) (:imperative)
      (call child-xmls args)
      (call child-xml body)
    )
  )
)

(extend + ASTProperty
  (fn-expr + xml XML :get
    (<> XML (text: "Property") (:access) (:decoration? (?. decoration text)) (:lazy? is-lazy)
      (if (. annotation-atoms length)
        (:annotations (call (. ", " join) (in (. each text) annotation-atoms)))
      )
      (call child-xml left)
      (call child-xml value)
    )
    (where
      (lazy annotation-atoms (call atoms-in annotations))
    )
  )
)

