(extend + ASTStateTrigger
  (fn-expr + xml XML :get
    (<> XML (text: "StateTrigger")
      (:kind
        (match kind
          (case= .state-trigger-for-on-when
            "for-on-when"
          )
          (case= .state-trigger-for-on
            "for-on"
          )
          (case= .state-trigger-on-when
            "on-when"
          )
          (case= .state-trigger-on
            "on"
          )
          (case= .state-trigger-if-match
            "if-match"
          )
          (case= .state-trigger-if
            "if"
          )
          (case= .state-trigger-when-stream
            "when-stream"
          )
          (case= .state-trigger-whenever
            "whenever"
          )
        )
      )
      (call child-xmls items)
    )
  )
)

