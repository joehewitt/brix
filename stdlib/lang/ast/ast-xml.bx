(extend + ASTTypeMatch
  (fn-expr + xml XML :get
    (<> XML (text: "TypeMatch")
      (:op
        (match op
          (case .match-convertible
            "convertible"
          )
          (case .match-similar
            "similar"
          )
          (case .match-exactly
            "exactly"
          )
        )
      )
      (call child-xml type)
    )
  )
)

