(extend + ASTDoBlock
  (fn-expr + xml XML :get
    (<> XML (text: "Do")
      (if compilation-effects
        (:effects (call format-compilation-effect-mask compilation-effects))
      )
      (if feature-gate-features
        (:features "feature-collection-observers")
      )
      (if holds-cancel
        (:cancel "held")
      )
      (if (. bans count)
        (:without (call (. ", " join) (in (. each text) (call atoms-in bans))))
      )
      (call child-xml body)
    )
  )
)

(fn-do _ format-compilation-effect-mask String
  (param effects CompilationEffect)
  (let visible
    (match (/and/ effects (. CompilationEffect gc-free))
      (case= (. CompilationEffect none)
        effects
      )
      (default
        (- effects (/and/ effects (/or/ (. CompilationEffect no-heap) (. CompilationEffect no-safepoint))))
      )
    )
  )
  (= visible
    (match (/and/ effects (. CompilationEffect no-safepoint))
      (case= (. CompilationEffect none)
        visible
      )
      (default
        (- visible (/and/ visible (. CompilationEffect no-suspend)))
      )
    )
  )
  (let names (call (of ArrayBuilder String)))
  (for (in index (..< 0 5))
    (let (tuple effect name)
      (match index
        (case= 0
          (tuple (. CompilationEffect gc-free) "no-gc")
        )
        (case= 1
          (tuple (. CompilationEffect no-heap) "no-heap")
        )
        (case= 2
          (tuple (. CompilationEffect no-safepoint) "no-safepoint")
        )
        (case= 3
          (tuple (. CompilationEffect no-probe-safepoint) "no-probe-safepoint")
        )
        (default
          (tuple (. CompilationEffect no-suspend) "no-suspend")
        )
      )
    )
    (if (!= (/and/ visible effect) (. CompilationEffect none))
      (call (. names append) name)
    )
  )
  (return (call (. "," join) (call (. names finish-immutable))))
)

