(extend + ASTBinaryExpression
  (fn-expr + xml XML :get
    (<> XML (text: "BinaryExpression") (:operator)
      (call child-xml lhs)
      (call child-xml rhs)
    )
    (where
      (lazy operator
        (match op
          (case= .or-op
            "||"
          )
          (case= .and-op
            "&&"
          )
          (case= .bitwise-or-op
            "or"
          )
          (case= .bitwise-and-op
            "and"
          )
          (case= .bitwise-xor-op
            "xor"
          )
          (default
            (str op)
          )
        )
      )
    )
  )
)

