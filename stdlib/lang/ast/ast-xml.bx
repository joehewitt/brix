(extend + ASTDoTaskBlock
  (fn-expr + xml XML :get
    (<> XML (text: "DoTask") (:parallel? is-parallel)
      (if (== scheduling .task-scheduling-priority)
        (:scheduling "priority")
      )
      (if large-stack
        (:stack "large")
      )
      (:detached? detached)
      (if worker-xml
        (<> XML (text: "worker")
          worker-xml
        )
      )
      (call child-xml body)
      (call child-xmls catchers)
    )
    (where
      (lazy worker-xml (call child-xml worker))
    )
  )
)

