(extend + ASTMarkup
  (fn-expr + xml XML :get
    (<> XML (text: "Markup")
      (call child-xml type-id)
      (call child-xml id)
      (if slot-binding-xml
        (<> XML (text: "SlotBinding")
          slot-binding-xml
          (call child-xml slot-parameter)
        )
      )
      (if (. args count)
        (<> XML (text: "args")
          args-xml
        )
      )
      (if style-rule-applications-xml
        (<> XML (text: "StyleRuleApplications")
          style-rule-applications-xml
        )
      )
      (call child-xml body)
    )
    (where
      (lazy slot-binding-xml (call child-xml slot-binding))
      (lazy args-xml (call child-xmls args))
      (lazy style-rule-applications-xml (call child-xmls style-rule-applications))
    )
  )
)

