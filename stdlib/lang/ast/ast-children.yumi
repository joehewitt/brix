+ do gather-children
    - nodes ImmutableTable'Syntax
    - children ImmutableArray'SyntaxId'ArenaBacking
    - id SyntaxId
    - links ChildLinks

do match? nodes[id]
    | .node-top-level-syntax(row)
        links.all(children[row.statements])
    | .node-block(row)
        links.all(children[row.body])
    | .node-print(row)
        links.one(row.body)
    | .node-declare(row)
        links.one(row.left)
        links.one(row.right)
    | .node-assertion-syntax(row)
        links.one(row.exception)
        links.one(row.condition)
    | .node-class-block(row)
        links.all(children[row.type-args])
        links.one(row.facet-of)
        links.one(row.base)
        links.all(children[row.or-bases])
        links.all(children[row.members])
        links.all(children[row.param-constraints])
        links.all(children[row.param-assignments])
    | .node-extension(row)
        links.one(row.receiver)
        links.all(children[row.as-types])
        links.all(children[row.param-constraints])
        links.all(children[row.param-assignments])
        links.all(children[row.body])
    | .node-style-sheet-extension(row)
        links.one(row.receiver)
        links.all(children[row.body])
    | .node-event-declaration(row)
        links.one(row.type)
        links.one(row.key-type)
    | .node-function-syntax(row)
        links.one(row.pattern)
        links.all(children[row.args])
        links.all(children[row.type-args])
        links.one(row.return-type)
        links.all(children[row.errors])
        links.all(children[row.param-constraints])
        links.all(children[row.param-assignments])
        links.one(row.body)
        links.one(row.property-site)
    | .node-getter-syntax(row)
        links.one(row.pattern)
        links.all(children[row.args])
        links.all(children[row.type-args])
        links.one(row.return-type)
        links.all(children[row.errors])
        links.all(children[row.param-constraints])
        links.all(children[row.param-assignments])
        links.one(row.body)
        links.one(row.property-site)
    | .node-setter-syntax(row)
        links.one(row.pattern)
        links.all(children[row.args])
        links.all(children[row.type-args])
        links.one(row.return-type)
        links.all(children[row.errors])
        links.all(children[row.param-constraints])
        links.all(children[row.param-assignments])
        links.one(row.body)
        links.one(row.property-site)
    | .node-property-syntax(row)
        links.one(row.left)
        links.one(row.value)
    | .node-state-machine(row)
        links.all(children[row.body])
    | .node-state-case(row)
        links.all(children[row.target])
        links.one(row.trigger)
        links.all(children[row.body])
    | .node-state-continuation(row)
        links.all(children[row.target])
        links.one(row.trigger)
        links.all(children[row.body])
    | .node-state-fallback(row)
        links.all(children[row.values])
    | .node-state-trigger(row)
        links.all(children[row.items])
    | .node-state-match-expression(row)
        links.one(row.subject)
        links.one(row.pattern)
    | .node-unit-declaration(row)
        links.one(row.number)
        links.one(row.value)
    | .node-enum-declaration(row)
        links.one(row.type)
        links.one(row.value)
    | .node-delegate-declaration(row)
        links.all(children[row.types])
    | .node-implements-declaration(row)
        links.one(row.type)
    | .node-using-declaration(row)
        links.one(row.type)
    | .node-sees-declaration(row)
        links.one(row.type)
    | .node-style-domain-item(row)
        links.one(row.domain)
        links.one(row.target)
    | .node-style-annotation(row)
        links.one(row.left)
        links.all(children[row.domains])
    | .node-dependency-declaration(row)
        links.one(row.left)
        links.all(children[row.right])
    | .node-content-block(row)
        links.one(row.body)
    | .node-fromverter-syntax(row)
        links.one(row.type)
        links.one(row.body)
    | .node-converter-syntax(row)
