    | .node-type-or(row)
        links.one(row.left)
        links.one(row.right)
    | .node-type-relation(row)
        links.one(row.left)
        links.one(row.right)
    | .node-type-match(row)
        links.one(row.type)
    | .node-type-remainder(row)
        links.one(row.name)
    | .node-type-list(row)
        links.all(children[row.patterns])
    | .node-type-map(row)
        links.all(children[row.patterns])
    | .node-type-map-item(row)
        links.one(row.key)
        links.one(row.value)
    | .node-type-function(row)
        links.one(row.return-type)
        links.all(children[row.args])
        links.all(children[row.errors])
    | .node-type-iterable(row)
        links.one(row.pattern)
    | .node-type-case(row)
        links.one(row.type)
        links.one(row.value)
    | .node-type-numeric(row)
        links.one(row.value)
    | .node-if-block(row)
        links.one(row.condition)
        links.one(row.body)
        links.one(row.next)
    | .node-while-block(row)
        links.one(row.condition)
        links.one(row.body)
    | .node-for-block(row)
        links.one(row.loop)
        links.one(row.body)
        links.one(row.next)
    | .node-do-block(row)
        links.one(row.body)
    | .node-probe-statement(row)
        links.one(row.body)
        links.one(row.object)
    | .node-do-finally-block(row)
        links.one(row.body)
    | .node-do-task-block(row)
        links.one(row.body)
        links.one(row.worker)
        links.all(children[row.catchers])
    | .node-use-block(row)
        links.one(row.subject)
        links.one(row.body)
    | .node-stack-local-binding-block(row)
