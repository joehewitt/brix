        links.one(row.body)
    | .node-style-rule-application(row)
        links.all(children[row.args])
        links.one(row.condition)
    | .node-structure-match(row)
        links.one(row.pattern)
    | .node-type-arguments(row)
        links.one(row.base)
        links.all(children[row.args])
    | .node-type-associated(row)
        links.one(row.owner)
        links.all(children[row.args])
    | .node-type-optional(row)
        links.all(children[row.field-types])
    | .node-type-tuple(row)
        links.all(children[row.field-types])
    | .node-type-capture(row)
