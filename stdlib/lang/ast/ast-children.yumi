+ ChildLinks

+ ids ArrayBuilder'SyntaxId'ArenaBacking
+ ends Array'U32'ArenaBacking
+ starts Array'SyntaxId'ArenaBacking

────────────────────
+ This
    - arena Arena
    - count Size

ids.reserve(count)
if count != 0
    ends[0] = 0
    starts[0] = 0

.. ids = ArrayBuilder'SyntaxId(arena)
.. ends = Array'U32(arena, count)
.. starts = Array'SyntaxId(arena, count)

────────────────────
+ do one
    - id SyntaxId

if id != 0
    ids.append(id)

────────────────────
+ do all
    - found ImmutableArray'SyntaxId'ArenaBacking

for id in found
    ids.append(id)

━━━━━━━━━━━━━━━━━━━━
+ do link-children ChildLinks
    - arena Arena
    - nodes ImmutableTable'Syntax
    - children ImmutableArray'SyntaxId'ArenaBacking

` Every node's children, and where its subtree starts. A child linked after its parent was made
` has a higher id and can reach below it, so the starts settle over further passes.
. links = ChildLinks(arena, nodes.length)
. unsettled = false
for id in 1u32 .. < nodes.length
    . first = links.ids.length
    gather-children(nodes, children, id as SyntaxId, links)
    . start = id
    for position in first .. < links.ids.length
        . child = links.ids[position]
        if child > id
            unsettled = true
        else if links.starts[child] < start
            start = links.starts[child]
    links.starts[id] = start as SyntaxId
    links.ends[id] = links.ids.length as U32
while unsettled
    unsettled = false
    for id in 1u32 .. < nodes.length
        . start = links.starts[id]
        for position in links.ends[id - 1] .. < links.ends[id]
            . child = links.ids[position]
            if links.starts[child] < start
                start = links.starts[child]
        if start != links.starts[id]
            links.starts[id] = start
            unsettled = true
= links

━━━━━━━━━━━━━━━━━━━━
+ extend AST

────────────────────
+ children-of ImmutableArray'SyntaxId'ArenaBacking
    - id SyntaxId

child-links[RowRange'SyntaxId(first, child-ends[id] - first)]

.. first = if id != 0 then child-ends[id - 1] else 0u32

────────────────────
+ subtree-start SyntaxId
    - id SyntaxId

subtree-starts[id]

────────────────────
+ do stream-statement SyntaxId
    - body SyntaxId

` The stream pattern a match body runs on its subject: the body itself, or the one statement of a
` block beside the lazy locals declared for it. None for any other body.
do match? nodes[body]
    | .node-stream-match
        = body
    | .node-block(block)
        . found SyntaxId = 0
        for statement in children[block.body]
            do match? nodes[statement]
                | .node-declare(row)
                    if row.is-lazy
                        continue
            if found != 0 || !(nodes[statement] is .node-stream-match)
                = 0
            found = statement
        = found
= 0

────────────────────
+ do root-this SyntaxId
    - content SyntaxId

` The root `<This` of the markup written in a class: the first line of the section that is
` an element of the type `This`, or none.
do match? nodes[content]
    | .node-content-block(row)
        do match? nodes[row.body]
            | .node-block(block)
                for statement in children[block.body]
                    do match? nodes[statement]
                        | .node-markup(element)
                            if names-this(element.type-id)
                                = statement
= 0

────────────────────
+ do names-this Bool
    - type-id SyntaxId

` Whether the type of a markup element is `This`, the class the markup is written in.
do match? nodes[type-id]
    | .node-type-identifier(named)
        = named.name.text == "This" && !named.is-declare
= false

────────────────────
+ do attribute-element SyntaxId
    - statement SyntaxId

` The markup element a line that assigns is an attribute of, as a line of the element's
` body, or the slot outlet whose node it gives a property, as a line of the outlet's body; or
` none.
if !(nodes[statement] is .node-assign)
    = 0
. holder = holder-of(statement)
. element = body-element(holder)
if element != 0
    = element
. outlet = if holder != 0 && nodes[holder] is .node-block then holder-of(holder) else 0u32
do match? nodes[outlet]
    | .node-slot-outlet(row)
        if row.body == holder
            = outlet
= 0

────────────────────
+ content-element SyntaxId
    - statement SyntaxId

` The markup element a line that gives content is a line of the body of, or none: a line that
` assigns is an attribute.
|? nodes[statement] is .node-assign
    0
??
    body-element(holder-of(statement))

────────────────────
+ gives-content Bool
    - line SyntaxId

` Whether a line of a markup element's body is a value the element takes as content, which the
` reference gives the element again where it reads something tracked: a text, a name, a member,
` an index, a call, a latest item read or a value forced from an optional.
match nodes[line]
    | .node-binary-expression(row)
        row.op == .concat-string-op || row.op == .concat-op
    | .node-unary-expression(row)
        row.op == .optional-force-op
    | .node-identifier
        true
    | .node-get-expression
        true
    | .node-index-expression
        true
    | .node-call-expression
        true
    | .node-latest-expression
        true
    ??
        false

────────────────────
+ do content-line Bool
    - statement SyntaxId

` Whether a line is a value given as content (`gives-content`) to the markup element whose body
` holds it, or to the region whose arm's body does: an arm of an `if` or of a match
` (`body-arm`).
if !gives-content(statement)
    = false
if content-element(statement) != 0
    = true
. body = holder-of(statement)
if body == 0 || !(nodes[body] is .node-block)
    = false
do match? nodes[holder-of(body)]
    | .node-if-block(row)
        if row.body == body
            = true
= body-arm(body) != 0

────────────────────
+ do arm-body SyntaxId
    - branch SyntaxId

` The body an arm of an `if` runs: its own, or, for an arm that matches a pattern, whose own
` body is empty, the block the match runs once the pattern holds.
do match? nodes[branch]
    | .node-if-block(row)
        if nodes[row.body] is .node-noop
            do match? nodes[row.condition]
                | .node-match-expression(matching)
                    do match? nodes[matching.body]
                        | .node-structure-match(structure)
                            do match? nodes[structure.pattern]
                                | .node-type-transform(transform)
                                    do match? nodes[transform.expr]
                                        | .node-block(block)
                                            if block.body.count != 0
                                                do match? nodes[children[block.body.start]]
                                                    | .node-do-block(done)
                                                        = done.body
        = row.body
= 0

────────────────────
+ do row-region Bool
    - body SyntaxId

do match? nodes[holder-of(body)]
    | .node-for-block(row)
        if row.body == body && when-clause(row.loop) != 0
            = true
do match? nodes[body]
    | .node-block(block)
        . elements = 0u32
        for line in children[block.body]
            do match? nodes[line]
                | .node-if-block
                    = true
                | .node-match-expression
                    = true
                | .node-for-block
                    = true
                | .node-iterator-expression
                    = true
                | .node-markup
                    elements += 1
        = elements > 1
= false

────────────────────
+ do when-clause SyntaxId
    - loop SyntaxId

do match? nodes[loop]
    | .node-loop-syntax(row)
        . clause = row.clause
        while clause != 0
            . next SyntaxId = 0
            do match? nodes[clause]
                | .node-clause(item)
                    if item.op == .when-clause
                        = clause
                    next = item.next
            clause = next
= 0

────────────────────
+ do keyed-clause SyntaxId
    - loop SyntaxId

` The last `keyed by` clause of a loop's header, which the reference keys a markup loop region
` by, or none.
. found SyntaxId = 0
do match? nodes[loop]
    | .node-loop-syntax(row)
        . clause = row.clause
        while clause != 0
            . next SyntaxId = 0
            do match? nodes[clause]
                | .node-clause(item)
                    if item.op == .keyed-by-clause
                        found = clause
                    next = item.next
            clause = next
= found

────────────────────
+ do is-condition-reference Bool
    - condition SyntaxId

` Whether the condition a style rule is applied under is one the reference takes: a name or a
` member read tracked, or the latest value of a name or a member.
do match? nodes[condition]
    | .node-identifier(row)
        = row.is-tracked
    | .node-get-expression(row)
        = row.is-tracked
    | .node-latest-expression(row)
        = nodes[row.expr] is .node-identifier || nodes[row.expr] is .node-get-expression
= false

────────────────────
+ do argument-element SyntaxId
    - id SyntaxId

` The markup element a node is written as an argument of, by position, or none.
. element = holder-of(id)
do match? nodes[element]
    | .node-markup(row)
        for arg in children[row.args]
            if arg == id
                = element
= 0

────────────────────
+ do body-element SyntaxId
    - block SyntaxId

` The markup element whose body a block is, or none.
if block == 0 || !(nodes[block] is .node-block)
    = 0
. element = holder-of(block)
do match? nodes[element]
    | .node-markup(row)
        if row.body == block
            = element
= 0

────────────────────
+ do holder-of SyntaxId
    - id SyntaxId

` The node whose subtree holds a node next, or none.
for node in id + 1 .. < (nodes.length as SyntaxId)
    if subtree-start(node) <= id
        = node
= 0

────────────────────
+ do text-parts
    - id SyntaxId
    - parts [SyntaxId]

` Adds to `parts` the parts of a pattern of texts, in the order written, as the reference's
` `textPatternParts` reads them: two or more joined by `and`, each a text written, a name given
` one or a rest, and one at least a text. Where the pattern is not one, adds none.
. start = parts.length
. texts = 0
if gather-texts(id, parts)
    for position in start .. < parts.length
        if text-of(parts[position])
            texts += 1
if texts == 0 || parts.length - start < 2
    -= parts[start .. < parts.length]

────────────────────
_ do gather-texts Bool
    - id SyntaxId
    - parts [SyntaxId]

` Adds the parts of a pattern joined by `and`, and says whether each is one of texts.
do match? nodes[id]
    | .node-type-and(row)
        = gather-texts(row.left, parts) && gather-texts(row.right, parts)
parts += id
= text-of(id) != null || nodes[id] is .node-type-remainder

────────────────────
+ do text-of String?
    - part SyntaxId

` The text a part of a pattern of texts writes: a text, or a name given one. A rest writes none.
. written SyntaxId = 0
do match? nodes[part]
    | .node-type-equality(row)
        written = row.expr
    | .node-type-capture(row)
        if row.type != 0
            do match? nodes[row.type]
                | .node-type-equality(equality)
                    written = equality.expr
if written != 0
    do match? nodes[written]
        | .node-string-syntax(row)
            = row.text
= null

────────────────────
+ do match-arms
    - id SyntaxId
    - arms [SyntaxId]

` Adds to `arms` the arms of a match, in the order written, where every one is a pattern with a
` body, as the reference's `markupMatchBranchArms` gathers them; where one is not, adds none.
. pattern SyntaxId = 0
do match? nodes[id]
    | .node-match-expression(row)
        do match? nodes[row.body]
            | .node-structure-match(structure)
                pattern = structure.pattern
. start = arms.length
if pattern == 0 || !gather-arms(pattern, arms)
    -= arms[start .. < arms.length]

────────────────────
_ do gather-arms Bool
    - pattern SyntaxId
    - arms [SyntaxId]

` Adds the arms a chain of alternatives holds, and says whether each is a pattern with a body.
do match? nodes[pattern]
    | .node-type-or(row)
        = gather-arms(row.left, arms) && gather-arms(row.right, arms)
    | .node-type-transform(row)
        if row.expr == 0
            = false
        arms += pattern
        = true
= false

────────────────────
+ do region-arms [SyntaxId]
    - region SyntaxId

` The arms of a markup branch region in order: each `if` of its chain, each arm of a match
` (`match-arms`), or the slot outlet whose parameter the region of its one arm is written at.
. arms [SyntaxId]
if nodes[region] is .node-match-expression
    match-arms(region, arms)
    = arms
if nodes[region] is .node-markup-slot-parameter
    arms += holder-of(region)
    = arms
. arm = region
while arm != 0
    arms += arm
    . next SyntaxId = 0
    do match? nodes[arm]
        | .node-if-block(row)
            next = row.next
    arm = next
= arms

────────────────────
+ do region-arm-body SyntaxId
    - arm SyntaxId

` The body a function of its own builds for an arm of a markup branch region: that of an `if`
` or of an arm of a match, or the slot outlet the arm is.
do match? nodes[arm]
    | .node-if-block
        = arm-body(arm)
    | .node-type-transform(row)
        = row.expr
    | .node-slot-outlet
        = arm
= 0

────────────────────
+ do arm-match SyntaxId
    - arm SyntaxId

` The match whose arms an arm of a match is one of, or none. The arms follow the node of the
` structure they are written in, so the match is found after the arm, not above it.
. arms [SyntaxId]
for node in arm + 1 .. < (nodes.length as SyntaxId)
    if nodes[node] is .node-match-expression
        arms.clear()
        match-arms(node, arms)
        if arms.find(arm) != null
            = node
= 0

────────────────────
+ do body-arm SyntaxId
    - body SyntaxId

` The arm of a match whose body a node is, or none: the body of an arm of a match, or the block
` the match an arm of an `if` is written with runs once its pattern holds (`arm-body`). The arm
` follows its body, but not always next above it.
for node in body + 1 .. < nodes.length
    do match? nodes[node]
        | .node-type-transform(row)
            if row.expr == body
                = node as SyntaxId
            do match? nodes[row.expr]
                | .node-block(block)
                    if block.body.count != 0
                        do match? nodes[children[block.body.start]]
                            | .node-do-block(done)
                                if done.body == body
                                    = node as SyntaxId
= 0

────────────────────
+ do arm-site SyntaxId
    - arm SyntaxId

` Where the markup branch region an arm of a match is built for keeps its host: the match, or the
` arm of an `if` whose condition the match is.
. head = arm-match(arm)
for node in head + 1 .. < nodes.length
    do match? nodes[node]
        | .node-if-block(row)
            if row.condition == head
                = node as SyntaxId
= head

────────────────────
+ do pattern-arm SyntaxId
    - branch SyntaxId

` The arm of the match an arm of an `if` is written with, `if | x = v`, whose pattern its subject
` is tested against, or none for an arm with a condition or none.
do match? nodes[branch]
    | .node-if-block(row)
        do match? nodes[row.condition]
            | .node-match-expression(matching)
                do match? nodes[matching.body]
                    | .node-structure-match(structure)
                        if nodes[structure.pattern] is .node-type-transform && is-other-body
                            = structure.pattern
                        .. is-other-body = arm-body(branch) != row.body
= 0

────────────────────
+ content-property Bool
    - statement SyntaxId

` Whether a line `+ name = value` of a class's markup declares a property of the class that the
` markup gives its value where the line runs (`content-property-name`).
content-property-name(statement) != 0

────────────────────
+ do content-property-name SyntaxId
    - statement SyntaxId

` The name of the property a line `+ name = value` of a class's markup declares, which the markup
` gives its value where the line runs, as the reference's content declares one, or none: a public
` name alone with no type, given a value, with no decoration, annotation or `:=`, on a line of a
` section with no root `<This`, whose lines name it nowhere else. The reference holds it in a
` lazy local, which a read before the line would evaluate early. Each line is searched within its
` own subtree, apart from nodes the parser left between lines.
do match? nodes[statement]
    | .node-property-syntax(row)
        if row.value == 0 || row.is-lazy || row.decoration || is-annotated-or-private
            = 0
        .. is-annotated-or-private = row.annotations.count != 0 || row.access != .public-access
        . named = row.left
        do match? nodes[row.left]
            | .node-type-capture(capture)
                if capture.type != 0
                    = 0
                named = capture.id
        . name = match? nodes[named]
            | .node-identifier(identifier)
                identifier.name
        if !name
            = 0
        . block = holder-of(statement)
        . content = holder-of(block)
        do match? nodes[content]
            | .node-content-block(section)
                if section.body != block || root-this(content) != 0
                    = 0
                do match? nodes[block]
                    | .node-block(lines)
                        for line in children[lines.body]
                            . last = if line == statement then row.value else line
                            for node in subtree-start(last) .. last
                                if names-member(node, name)
                                    = 0
                = named
= 0

────────────────────
_ names-member Bool
    - node SyntaxId
    - name Atom

` Whether a node names a name: an identifier, or a member read by that name of any object.
match nodes[node]
    | .node-identifier(row)
        row.name == name
    | .node-ref-identifier(row)
        row.name == name
    | .node-get-expression(row)
        row.name == name
    ??
        false

────────────────────
+ do content-lines SyntaxId
    - content SyntaxId

` The block whose lines are the markup written in a class: the body of its root `<This`, or
` else the section itself, or the body of its `• This` where that writes the markup
` (`defaults-content`), whose lines that are the rule's own are none of it (`runs-line`). No
` block where the class writes none, or a root with no body.
if content == 0
    = 0
. root = root-this(content)
do match? nodes[root]
    | .node-markup(element)
        = element.body
do match? nodes[content]
    | .node-content-block(row)
        = row.body
    | .node-rule-syntax(row)
        = row.body
= 0

────────────────────
+ is-empty-section Bool
    - id SyntaxId

` Whether a member of a type is a section with nothing written in it, which no type may hold.
match nodes[id]
    | .node-content-block(row)
        match nodes[row.body]
            | .node-block(block)
                block.body.count == 0
            ??
                false
    ??
        false

────────────────────
+ rule-part Bool
    - statement SyntaxId

` Whether a line of the body of a style rule is the rule's own: a line that declares a style, a
` `when`, a rule written in it, and a line that binds a slot or forwards one, which is content
` the rule generates.
match nodes[statement]
    | .node-assign
        true
    | .node-style-when
        true
    | .node-rule-syntax
        true
    | .node-markup-slot-forward
        true
    | .node-markup(row)
        row.slot-binding != 0
    ??
        false

────────────────────
+ runs-line Bool
    - content SyntaxId
    - statement SyntaxId

` Whether a line of the block `content-lines` gives for a class's markup is a line of that
` markup: any but the rule's own where the markup is that of the class's `• This`.
!(nodes[content] is .node-rule-syntax) || !rule-part(statement)

────────────────────
+ do defaults-content Bool
    - rule SyntaxId

` Whether a style rule is a class's `• This` that writes its markup: a line of its body that is
` not the rule's own (`rule-part`). The reference makes those lines the class's markup and
` drops the content the rule would generate, so one that generates some is not taken for it.
do match? nodes[rule]
    | .node-rule-syntax(row)
        if row.name.text != "This" || row.args.count != 0 || row.body == 0
            = false
        . found = false
        do match? nodes[row.body]
            | .node-block(block)
                for statement in children[block.body]
                    if nodes[statement] is .node-markup-slot-forward
                        = false
                    do match? nodes[statement]
                        | .node-markup(element)
                            if element.slot-binding != 0
                                = false
                    if !rule-part(statement)
                        found = true
        = found
= false

────────────────────
+ do piped-bullet SyntaxId
    - pipe SyntaxId

` The bullet a stream piped through a pattern reads, where it is one bullet alone that gives
` every item of what it writes: the reference evaluates what it writes inside the generator
` the pipe is, at its first pull. None for any other pipe.
. left SyntaxId = 0
do match? nodes[pipe]
    | .node-pipeline-expression(row)
        if row.op == .stream-pattern-pipe-op
            left = row.left
    | .node-binary-expression(row)
        if row.op == .stream-pattern-pipe-op
            left = row.lhs
do match? nodes[left]
    | .node-bullet-expression(row)
        if row.is-multi && !row.is-optional && row.next == 0
            = left
= 0

────────────────────
+ do listed-bullets SyntaxId
    - consumer SyntaxId

. written SyntaxId = 0
. callee SyntaxId = 0
do match? nodes[consumer]
    | .node-call-expression(row)
        if row.param-count == 0 && row.operands.count == 1 && !row.is-curried
            written = children[row.operands.start]
            callee = row.callable
    | .node-pipeline-expression(row)
        if row.op == .pipe-forward-op
            written = row.left
            callee = row.right
=? 0 if written == 0 || !names-list(callee)
do match? nodes[written]
    | .node-argument(row)
        written = if row.name || row.is-optional then 0 else row.expr
do match? nodes[written]
    | .node-block(row)
        written = if row.body.count == 1 then children[row.body.start] else 0
=? written if written != 0 && nodes[written] is .node-bullet-expression
= 0

────────────────────
_ do names-list Bool
    - callee SyntaxId

do match? nodes[callee]
    | .node-type-identifier(row)
        = row.name.text == "List"
    | .node-type-arguments(row)
        = names-list(row.base)
= false

────────────────────
+ do whenever-clause SyntaxId
    - loop SyntaxId

` The `whenever` clause of a loop on a stream, which tests whether the loop is subscribed
` rather than whether an item passes: the first of its header's clauses that is one. None for
` any other loop.
do match? nodes[loop]
    | .node-loop-syntax(row)
        if !row.is-subscriber
            = 0
        . current = row.clause
        while current != 0
            . next SyntaxId = 0
            do match? nodes[current]
                | .node-clause(clause)
                    if clause.op == .whenever-clause
                        = current
                    next = clause.next
            current = next
= 0

────────────────────
+ do clause-loop SyntaxId
    - clause SyntaxId

` The loop header a clause is written in, or none.
for node in clause + 1 .. < nodes.length
    if subtree-starts[node] <= clause
        do match? nodes[node]
            | .node-loop-syntax
                = node as SyntaxId
= 0

────────────────────
+ do lazies-only Bool
    - body SyntaxId

` Whether the body of an arm of a stream pattern only declares lazy locals, which the arm's
` pattern reads: such an arm gives what its pattern gives, as one with no body does.
do match? nodes[body]
    | .node-declare(row)
        = row.is-lazy
    | .node-block(block)
        if block.body.count == 0
            = false
        for statement in children[block.body]
            do match? nodes[statement]
                | .node-declare(row)
                    if row.is-lazy
                        continue
            = false
        = true
= false

────────────────────
+ is-stream-pattern Bool
    - id SyntaxId

` Whether a node is a stream pattern, as the pattern of a loop over what a stream matches is.
match nodes[id]
    | .node-stream-match
        true
    | .node-stream-and
        true
    | .node-stream-or
        true
    | .node-stream-transform
        true
    | .node-stream-panic
        true
    | .node-stream-type
        true
    | .node-stream-equality
        true
    | .node-stream-length
        true
    | .node-stream-unary
        true
    | .node-stream-call
        true
    | .node-stream-predicate
        true
    | .node-stream-capture
        true
    | .node-stream-char-range
        true
    | .node-stream-string
        true
    | .node-stream-any
        true
    ??
        false

────────────────────
+ transformer-exception SyntaxId
    - caught SyntaxId
    - catchers RowRange'SyntaxId

` The exception of a catch expression that declares error transformers: what it catches is a
` raise with no condition, and each catcher's error leaves the function as the exception from
` there on. None for any other.
|? catchers.count == 0
    0
??
    match nodes[caught]
        | .node-assertion-syntax(row)
            if row.condition == 0 then row.exception else 0
        ??
            0

────────────────────
+ do post-order-violation SyntaxId?

. total = nodes.length
=? root if root != total - 1
for id in 1u32 .. < total
    for child in children-of(id)
        =? child if child >= id && !late-linked(this, id, child)
= null

━━━━━━━━━━━━━━━━━━━━
_ late-linked Bool
    - tree AST
    - parent SyntaxId
    - child SyntaxId

match tree.nodes[parent]
    | .node-if-block(row)
        child == row.next
    | .node-for-block(row)
        child == row.next
    | .node-loop-syntax(row)
        child == row.next
    | .node-iterator-expression(row)
        child == row.next
    | .node-clause(row)
        child == row.next
    | .node-bullet-expression(row)
        child == row.next
    | .node-structure-match(row)
        child == row.pattern
    | .node-stream-match(row)
        child == row.pattern
    | .node-binary-expression(row)
        child == row.rhs && holds(tree, child)
    ??
        false

━━━━━━━━━━━━━━━━━━━━
_ holds Bool
    - tree AST
    - id SyntaxId

` Whether a node holds the middle of a chain of orderings. The chain is known only when its
` next ordering is read, so the holder is made after the ordering it is the right side of.
match tree.nodes[id]
    | .node-held-expression
        true
    ??
        false
