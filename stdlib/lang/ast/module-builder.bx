(import ./ast)
(import ./ast-children)
(import ./ast-nodes)
(import ./decl)
(import ./module)
(import ./operator)
(import ./row-range)
(import ./slot-hosts)
(import ./state-machines)
(import /core/arena)
(import /core/array-builder)
(import /core/atom-pool)
(import /core/table)

(type + ModuleBuilder
  (implements (of Usable Void))
  (prop + path String)
  (prop + relative-path String)
  (prop + name String)
  (prop + source String)
  (prop + default-hosts (list String))
  (prop + consulted (list String))
  (prop _ arena Arena)
  (prop _ decls (of Table Decl))
  (prop _ member-pool (of ArrayBuilder DeclId ArenaBacking))
  (prop _ member-links (of ArrayBuilder U32 ArenaBacking))
  (prop _ member-heads (of Map MemberKey U32 ArenaBacking))
  (prop _ arg-pool (of ArrayBuilder ArgumentShape ArenaBacking))
  (prop _ syntax-pool (of ArrayBuilder SyntaxId ArenaBacking))
  (prop _ undeclared (of ArrayBuilder SyntaxId ArenaBacking))
  (prop _ undeclared-owners (of ArrayBuilder DeclId ArenaBacking))
  (prop _ made-atoms (of ArrayBuilder Atom ArenaBacking))
  (prop _ atom-pool (? AtomPool))
  (prop _ atom-lock (? Mutex))
  (prop _ next-syntax SyntaxId (= 1))
  (prop _ pending-delegates (of RowRange SyntaxId))
  (prop _ written-content SyntaxId)
  (prop _ finished Bool)
  (prop _ released Bool)
  (fn-do + This _
    (param path String)
    (param relative-path String)
    (param name String)
    (param source String)
    (lazy decls (call new-decl-table arena))
    (lazy member-pool (call (of ArrayBuilder DeclId) arena))
    (lazy member-links (call (of ArrayBuilder U32) arena))
    (lazy member-heads (call (of Map MemberKey U32) arena))
    (lazy arg-pool (call (of ArrayBuilder ArgumentShape) arena))
    (lazy syntax-pool (call (of ArrayBuilder SyntaxId) arena))
    (lazy undeclared (call (of ArrayBuilder SyntaxId) arena))
    (lazy undeclared-owners (call (of ArrayBuilder DeclId) arena))
    (lazy made-atoms (call (of ArrayBuilder Atom) arena))
  )
  (fn-do + finish Module
    (param ast AST)
    (param atoms AtomPool)
    (param atom-lock Mutex)
    ; The program's atom pool names the generated declarations, so a call site's `other` and a
    ; cast constructor's `other` are one atom.
    (throw (call Panic "ModuleBuilder is stale or already finished") (if (or released finished)))
    (blank)
    (= atom-pool atoms)
    (= (. this atom-lock) atom-lock)
    (call scan-root ast)
    (let main (call add-main ast))
    (call scan-nested ast main)
    (let init (call add-startup ast .init-decl))
    (let task-main (call add-startup ast .task-main-decl))
    (if (== name "core/error")
      (call add-startup ast .termination-panic-decl)
    )
    (call index-members)
    (let module
      (call Module
        (block
          (arg (call (. arena copy-string) path))
          (arg (call (. arena copy-string) relative-path))
          (arg (call (. arena copy-string) name))
          (arg ast)
          (arg arena)
          (arg (call (. decls finish)))
          (arg (call (. member-pool finish-immutable)))
          (arg (call (. member-links finish-immutable)))
          (arg member-heads)
          (arg (call (. arg-pool finish-immutable)))
          (arg (call (. syntax-pool finish-immutable)))
          (arg (call (. undeclared finish-immutable)))
          (arg (call (. undeclared-owners finish-immutable)))
          (arg (call (. made-atoms finish-immutable)))
          (arg main)
          (arg init)
          (arg task-main)
        )
      )
    )
    (= finished true)
    (return module)
  )
  (fn-do _ store-atom Atom
    (param text String)
    (let lock (!! atom-lock))
    (use lock)
    (let stored (call (. (!! atom-pool) store) text))
    (call (. made-atoms append) stored)
    (return stored)
  )
  (fn-do _ index-members _
    ; Chains the members of each class and extension that share a name, in the order written, so
    ; that a member is found by its name without reading every member of its owner.
    (for (in _ (..< 0 (. member-pool length)))
      (call (. member-links append) no-member)
    )
    (for (in index (..< 0 (. decls length)))
      (match? ([] decls index)
        (case (call .decl-class row)
          (call index-range (. row members))
        )
        (case (call .decl-extension row)
          (call index-range (. row members))
        )
        (case (call .decl-sheet-extension row)
          (call index-range (. row members))
        )
      )
    )
  )
  (fn-do _ index-range _
    (param members (of RowRange DeclId))
    (for (in offset (..< 0 (. members count)))
      (let place (- (+ (. members start) (. members count)) 1 offset))
      (let name (call member-name ([] decls ([] member-pool place))))
      (if name
        (let key (call MemberKey (. members start) name))
        (= ([] member-links place) (?? ([] member-heads key) no-member))
        (= ([] member-heads key) place)
      )
    )
  )
  (fn-expr _ member-name (? Atom)
    (param decl Decl)
    (match? decl
      (case (call .decl-function row)
        (. row name)
      )
      (case (call .decl-property row)
        (. row name)
      )
      (case (call .decl-case row)
        (. row name)
      )
      (case (call .decl-event row)
        (. row name)
      )
      (case (call .decl-associated row)
        (. row name)
      )
    )
  )
  (fn-do + begin-using _)
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (if (not released)
      (if (not finished)
        (call (. arena release))
      )
      (= released true)
    )
  )
  (fn-do + (of append Node) DeclId
    (param node Node)
    (constraint is Node DeclNode)
    (throw (call Panic "Module declaration table exceeds the valid Decl ID range") (if (>= (. decls length) (. U32 max))))
    (blank)
    (let index (. decls length))
    (call (. decls append) node)
    (return (as index DeclId))
  )
  (fn-do _ scan-root _
    (param tree AST)
    ; A declaration no row is made for is kept as one the module does not declare, so that the
    ; passes after this one know it was written.
    (match ([] (. tree nodes) (. tree root))
      (case (call .node-top-level-syntax root)
        (for (in offset (..< 0 (. root statements count)))
          (let id ([] (. tree children) (+ (. root statements start) offset)))
          (let declared (. decls length))
          (call scan-statement tree id)
          (if (and (== (. decls length) declared) (call is-declaration-syntax tree id))
            (call keep-undeclared id 0)
          )
        )
      )
      (throw (call Panic "AST root has the wrong syntax case"))
    )
  )
  (fn-do _ keep-undeclared _
    (param id SyntaxId)
    (param owner DeclId)
    ; Keeps a declaration no row is made for, with the class it is a member of, or none.
    (call (. undeclared append) id)
    (call (. undeclared-owners append) owner)
  )
  (fn-do _ scan-statement _
    (param tree AST)
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-import-syntax row)
        (call append (call ImportDecl id (. row paths) (. row is-export)))
      )
      (case (call .node-function-syntax row)
        (call add-function
          (block
            (arg tree)
            (arg id)
            (arg (. row names))
            (arg (. row args))
            (arg (. row access))
            (arg (call function-kind (. row is-getter) (. row is-setter)))
            (arg (. row return-type))
            (arg (. row errors))
            (arg (. row body))
            (arg (. row compilation-effects))
            (arg (. row is-static))
            (arg 0)
            (arg (. row type-args))
            (arg (. row param-constraints))
            (arg (. row param-assignments))
          )
        )
      )
      (case (call .node-getter-syntax row)
        (call add-function
          (block
            (arg tree)
            (arg id)
            (arg (. row names))
            (arg (. row args))
            (arg (. row access))
            (arg (. DeclKind getter-decl))
            (arg (. row return-type))
            (arg (. row errors))
            (arg (. row body))
            (arg (. row compilation-effects))
            (arg (. row is-static))
            (arg 0)
            (arg (. row type-args))
            (arg (. row param-constraints))
            (arg (. row param-assignments))
          )
        )
      )
      (case (call .node-setter-syntax row)
        (call add-function
          (block
            (arg tree)
            (arg id)
            (arg (. row names))
            (arg (. row args))
            (arg (. row access))
            (arg (. DeclKind setter-decl))
            (arg (. row return-type))
            (arg (. row errors))
            (arg (. row body))
            (arg (. row compilation-effects))
            (arg (. row is-static))
            (arg 0)
            (arg (. row type-args))
            (arg (. row param-constraints))
            (arg (. row param-assignments))
          )
        )
      )
      (case (call .node-class-block row)
        (= next-syntax
          (call class-body-start
            (block
              (arg tree)
              (arg (. row type-args))
              (arg (if-expr (> (. row facet-of) (. row base)) (. row facet-of) (. row base)))
              (arg (. row or-bases))
              (arg (. row param-constraints))
              (arg (. row param-assignments))
            )
          )
        )
        (if (!= (. row facet-of) 0)
          (call add-extension
            (block
              (arg tree)
              (arg id)
              (arg (. row facet-of))
              (arg (. row members))
              (arg (. row access))
              (arg (call (of RowRange SyntaxId)))
              (arg (call (of RowRange SyntaxId)))
              (arg (. row name))
            )
          )
          (else
            (call add-class
              (block
                (arg tree)
                (arg id)
                (arg (. row name))
                (arg (. row aliases))
                (arg (. row type-args))
                (arg (. row base))
                (arg (. row members))
                (arg (. row access))
                (arg (. row param-constraints))
                (arg (. row param-assignments))
                (arg (. row or-bases))
              )
            )
          )
        )
      )
      (case (call .node-extension row)
        (= next-syntax
          (call extension-body-start
            (block
              (arg tree)
              (arg (. row receiver))
              (arg (. row as-types))
              (arg (. row param-constraints))
              (arg (. row param-assignments))
            )
          )
        )
        (call add-extension
          (block
            (arg tree)
            (arg id)
            (arg (. row receiver))
            (arg (. row body))
            (arg (. row access))
            (arg (. row param-constraints))
            (arg (. row param-assignments))
          )
        )
      )
      (case (call .node-style-sheet-extension row)
        (= next-syntax (+ (. row receiver) 1))
        (call add-sheet-extension tree id (. row receiver) (. row body))
      )
      (case (call .node-property-syntax row)
        (call add-property tree id (. row left) (. row value) (. row access) 0 (. row is-lazy) (. row decoration))
      )
      (case (call .node-unit-declaration row)
        (call append (call UnitDecl id 0 (. row access) (. row number) (. row value)))
      )
      (case (call .node-effect-declaration row)
        (call append (call EffectDecl id (. row name) (. row access) (. row claims)))
      )
    )
    (if (>= id next-syntax)
      (= next-syntax (+ id 1))
    )
  )
  (fn-expr _ scan-member DeclId
    (param tree AST)
    (param id SyntaxId)
    (param owner DeclId)
    (match ([] (. tree nodes) id)
      (case (call .node-function-syntax row)
        (call add-function
          (block
            (arg tree)
            (arg id)
            (arg (. row names))
            (arg (. row args))
            (arg (. row access))
            (arg (call function-kind (. row is-getter) (. row is-setter)))
            (arg (. row return-type))
            (arg (. row errors))
            (arg (. row body))
            (arg (. row compilation-effects))
            (arg (. row is-static))
            (arg owner)
            (arg (. row type-args))
            (arg (. row param-constraints))
            (arg (. row param-assignments))
          )
        )
      )
      (case (call .node-getter-syntax row)
        (call add-function
          (block
            (arg tree)
            (arg id)
            (arg (. row names))
            (arg (. row args))
            (arg (. row access))
            (arg (. DeclKind getter-decl))
            (arg (. row return-type))
            (arg (. row errors))
            (arg (. row body))
            (arg (. row compilation-effects))
            (arg (. row is-static))
            (arg owner)
            (arg (. row type-args))
            (arg (. row param-constraints))
            (arg (. row param-assignments))
          )
        )
      )
      (case (call .node-setter-syntax row)
        (call add-function
          (block
            (arg tree)
            (arg id)
            (arg (. row names))
            (arg (. row args))
            (arg (. row access))
            (arg (. DeclKind setter-decl))
            (arg (. row return-type))
            (arg (. row errors))
            (arg (. row body))
            (arg (. row compilation-effects))
            (arg (. row is-static))
            (arg owner)
            (arg (. row type-args))
            (arg (. row param-constraints))
            (arg (. row param-assignments))
          )
        )
      )
      (case (call .node-property-syntax row)
        (call add-property tree id (. row left) (. row value) (. row access) owner (. row is-lazy) (. row decoration))
      )
      (case (call .node-converter-syntax row)
        (call append
          (block
            (arg
              (call ConverterDecl
                (block
                  (arg id)
                  (arg owner)
                  (arg (. row type))
                  (arg (. row access))
                  (arg (. row param-constraints))
                  (arg (. row param-assignments))
                )
              )
            )
          )
        )
      )
      (case (call .node-fromverter-syntax row)
        (call append (call FromverterDecl id owner (. row type) (. row access)))
      )
      (case (call .node-event-declaration row)
        (call append (call EventDecl id (. row name) owner (. row access) (. row type) (. row key-type)))
      )
      (case (call .node-unit-declaration row)
        (call append (call UnitDecl id owner (. row access) (. row number) (. row value)))
      )
      (case (call .node-enum-declaration row)
        (call append (call CaseDecl id (. row name) owner (. row type) (. row value)))
      )
      (case (call .node-using-declaration row)
        (call append (call UsingDecl id owner (. row type)))
      )
      (case .node-when-rule-syntax
        (call add-rule id owner)
      )
      (case (call .node-whenever-rule-syntax row)
        (if-expr (or (== (. row args count) 0) is-single-arg) (call add-rule id owner) 0)
        (lazy is-single-arg (and (!= (. row kind text) "value") (== (. row args count) 1)))
      )
      (case .node-dependency-declaration
        (call add-rule id owner)
      )
      (case .node-subscriber-syntax
        (call add-rule id owner)
      )
      (case .node-style-annotation
        (if-expr (is ([] decls owner) .decl-class) (call append (call StyleDomainsDecl id owner)) 0)
      )
      (case (call .node-rule-syntax row)
        (if-expr (is ([] decls owner) .decl-class) (call add-style-rule tree id (. row name) owner 0) 0)
      )
      (default
        0
      )
    )
  )
  (fn-do _ add-sheet-extension DeclId
    (param tree AST)
    (param syntax SyntaxId)
    (param receiver SyntaxId)
    (param member-syntax (of RowRange SyntaxId))
    ; An extension of a style sheet, with the usings and style rules it adds as its members, each
    ; owned by it. Any other member, a slot among them, is kept as one the module does not declare,
    ; held by the extension, whose check says what becomes of it.
    (throw (call Panic "Module member pool exceeds U32 capacity") (if (>= (. member-pool length) (. U32 max))))
    (blank)
    (let id (call append (call SheetExtensionDecl syntax receiver (call (of RowRange DeclId)))))
    (let start (. member-pool length))
    (for (in member-id ([] (. tree children) member-syntax))
      (let member-decl DeclId 0)
      (match? ([] (. tree nodes) member-id)
        (case (call .node-using-declaration row)
          (= member-decl (call append (call UsingDecl member-id id (. row type))))
        )
        (case (call .node-rule-syntax row)
          (= member-decl (call add-style-rule tree member-id (. row name) id 0))
        )
      )
      (if (== member-decl 0)
        (call keep-undeclared member-id id)
        (else
          (call (. member-pool append) member-decl)
        )
      )
      (if (>= member-id next-syntax)
        (= next-syntax (+ member-id 1))
      )
    )
    (match? ([] decls id)
      (case (call .decl-sheet-extension row)
        (= (. row members) (call (of RowRange DeclId) (as start U32) (as (- (. member-pool length) start) U32)))
      )
    )
    (return id)
  )
  (fn-do _ add-style-rule DeclId
    (param tree AST)
    (param id SyntaxId)
    (param name Atom)
    (param owner DeclId)
    (param outer DeclId)
    ; A style rule a class writes, or one written in the body of another, and after it each written
    ; in its own body and in the bodies of its `when`s, in the order written, with it as their
    ; `outer`.
    (let decl (call append (call StyleRuleDecl id name owner outer)))
    (match? ([] (. tree nodes) id)
      (case (call .node-rule-syntax row)
        (match? ([] (. tree nodes) (. row body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (match? ([] (. tree nodes) statement)
                (case (call .node-rule-syntax nested)
                  (call add-style-rule tree statement (. nested name) owner decl)
                )
                (case (call .node-style-when branch)
                  (call add-when-rules tree (. branch body) owner decl)
                )
              )
            )
          )
        )
      )
    )
    (return decl)
  )
  (fn-do _ add-when-rules _
    (param tree AST)
    (param body SyntaxId)
    (param owner DeclId)
    (param outer DeclId)
    ; The style rules written in the body of a `when` of a style rule, each with the rule as its
    ; `outer`.
    (match? ([] (. tree nodes) body)
      (case (call .node-rule-syntax nested)
        (call add-style-rule tree body (. nested name) owner outer)
      )
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-rule-syntax nested)
              (call add-style-rule tree statement (. nested name) owner outer)
            )
          )
        )
      )
    )
  )
  (fn-do _ add-rule DeclId
    (param id SyntaxId)
    (param owner DeclId)
    ; A rule a class or a facet of one writes that runs as what it reads changes: a `when` rule, a
    ; `whenever` rule on a value, or one on the markup an object is in, which names at most its
    ; changes, or a dependency `. m < p`, which runs a method as properties change; or a section that
    ; subscribes the object to a stream, `on s` or `for x on s`, which its constructors run. A rule
    ; of any other type declares nothing.
    (return (if-expr writes-rules (call append (call RuleDecl id owner)) 0))
    (blank)
    (lazy writes-rules
      (match ([] decls owner)
        (case .decl-class
          true
        )
        (case (call .decl-extension row)
          (!= (. row facet) null)
        )
        (default
          false
        )
      )
    )
  )
  (fn-do _ add-function DeclId
    (param tree AST)
    (param syntax SyntaxId)
    (param names (of RowRange Atom))
    (param args (of RowRange SyntaxId))
    (param access Access)
    (param kind DeclKind)
    (param return-type SyntaxId)
    (param errors (of RowRange SyntaxId))
    (param body SyntaxId)
    (param effects CompilationEffect)
    (param is-static Bool)
    (param owner DeclId)
    (param type-args (of RowRange SyntaxId))
    (param param-constraints (of RowRange SyntaxId))
    (param param-assignments (of RowRange SyntaxId))
    ; A function's subtree starts where the declaration before it ended, so that what is written
    ; between the two is the function's. A statement before it whose node was made after the
    ; function's leaves nothing between, and the subtree is the function's own node.
    (let shapes (call store-arg-shapes tree args))
    (let primary (? Atom))
    (if (!= (. names count) 0)
      (= primary ([] (. tree atoms) (. names start)))
    )
    (let decl-kind kind)
    (if (and (== kind (. DeclKind function-decl)) primary (== (. primary text) "This"))
      (= decl-kind (. DeclKind constructor-decl))
    )
    (let start (if-expr (<= next-syntax syntax) next-syntax (call (. tree subtree-start) syntax)))
    (let subtree (call SyntaxRange start (+ (- syntax start) 1)))
    (let fn
      (call FunctionDecl
        (block
          (arg syntax)
          (arg primary)
          (arg names)
          (arg owner)
          (arg access)
          (arg decl-kind)
          (arg (. shapes range))
          (arg return-type)
          (arg errors)
          (arg effects)
          (arg is-static)
          (arg body)
          (arg subtree)
          (arg type-args)
          (arg param-constraints)
          (arg param-assignments)
          (arg (. shapes variadic-index))
          (arg (. shapes required-count))
          (arg false)
        )
      )
    )
    (return (call append fn))
  )
  (fn-do _ add-class DeclId
    (param tree AST)
    (param syntax SyntaxId)
    (param name Atom)
    (param aliases (of RowRange Atom))
    (param type-args (of RowRange SyntaxId))
    (param base SyntaxId)
    (param member-syntax (of RowRange SyntaxId))
    (param access Access)
    (param param-constraints (of RowRange SyntaxId))
    (param param-assignments (of RowRange SyntaxId))
    (param or-bases (of RowRange SyntaxId))
    (let interfaces (call store-interfaces tree member-syntax))
    (let decl
      (call ClassDecl
        (block
          (arg syntax)
          (arg name)
          (arg aliases)
          (arg type-args)
          (arg base)
          (arg (call (of RowRange DeclId)))
          (arg access)
          (arg interfaces)
          (arg param-constraints)
          (arg param-assignments)
          (arg or-bases)
        )
      )
    )
    (let id (call append decl))
    (let members (call scan-members tree member-syntax id))
    (let content written-content)
    (let generated (+ (call add-generated-constructors id) (call add-table-constructors id name)))
    (let given (call add-content-members tree id content members))
    (let projected (call add-content-machine-members tree id content members))
    (let filler (call add-content-function tree id content))
    (let delegated (call store-delegations tree member-syntax))
    (match? ([] decls id)
      (case (call .decl-class row)
        (= (. row members) (call (of RowRange DeclId) (. members start) (+ (. members count) generated given projected)))
        (= (. row content) content)
        (= (. row delegated) delegated)
        (= (. row content-function) filler)
      )
    )
    (return id)
  )
  (fn-do _ add-content-function DeclId
    (param tree AST)
    (param owner DeclId)
    (param content SyntaxId)
    ; Every class has a function that fills an object of it with the markup written in the
    ; class, run once the object's constructor has. Its body is the lines of that markup: those
    ; of a root `<This`, or else of the section. A class that writes none has a function with no
    ; body, which runs what the class above it writes. It is no member: nothing names it.
    (let lines (call (. tree content-lines) content))
    (let start (if-expr (!= content 0) (call (. tree subtree-start) content) 0u32))
    (let subtree (if-expr (!= content 0) (call SyntaxRange start (+ (- content start) 1)) (call SyntaxRange 0 0)))
    (let fn
      (call FunctionDecl
        (block
          (arg content)
          (arg null)
          (arg (call (of RowRange Atom)))
          (arg owner)
          (arg (. Access public-access))
          (arg (. DeclKind function-decl))
          (arg (call (of RowRange ArgumentShape)))
          (arg 0)
          (arg (call (of RowRange SyntaxId)))
          (arg (. CompilationEffect none))
          (arg false)
          (arg lines)
          (arg subtree)
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (. U32 max))
          (arg 0)
          (arg true)
          (arg (call (of RowRange SyntaxId)))
          (arg 0)
          (arg true)
        )
      )
    )
    (return (call append fn))
  )
  (fn-do _ add-machine-members _
    (param tree AST)
    (param owner DeclId)
    (param member DeclId)
    ; The flags of the state machine a property of a class holds, as members before the property, as
    ; the reference declares them: for each of its cases, in order, a private property of the object
    ; no program names, which says whether the case is active; then for each group of its event
    ; transitions at its root on a name alone or read from `this`, one that holds the group's
    ; activation for the event runtime's table. A class derived from another may refine the machine
    ; its base's property of that name holds, whose flags are then the base's where the cases are.
    ; Two more, named after the class, hold the machine's part for the object, which the machines
    ; that refine it call (`MachineComposite`), and the part of the machine that refines it for the
    ; object, which it calls.
    (match? ([] decls member)
      (case (call .decl-property row)
        (let machine (if-expr (and (. row name) (not (. row is-lazy))) (call (. tree declared-machine) (. row value)) 0))
        (if (!= machine 0)
          (let items (call (. tree state-items) (call (. tree state-body) machine)))
          (for (in node (call (. tree machine-cases) items))
            (let name (call store-atom (str "(" (. (!! (. row name)) text) "-" (. (!! (call (. tree state-name) node)) text) "-active)")))
            (call (. member-pool append) (call append (call hidden-property node name owner node 0)))
          )
          (let place 0u32)
          (for (in head (call (. tree group-heads) items))
            (if (call self-stream tree (call (. tree group-stream) head))
              (let name (call store-atom (str "(" (. (!! (. row name)) text) "-event-descriptor-context-" place ")")))
              (call (. member-pool append) (call append (call hidden-property head name owner 0 head)))
              (+= place 1)
            )
          )
          (match? ([] decls owner)
            (case (call .decl-class class)
              (for (in suffix (list "part" "below"))
                (let name (call store-atom (str "(" (. class name text) "-" (. (!! (. row name)) text) "-" suffix ")")))
                (call (. member-pool append) (call append (call part-holder machine name owner)))
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ add-content-machine-members U32
    (param tree AST)
    (param owner DeclId)
    (param content SyntaxId)
    (param members (of RowRange DeclId))
    ; The flags of each state machine written as a line of a class's markup, as members after the
    ; others: for each of its cases, in order, a public property of the object named after the case,
    ; which says whether it is active, or for a case that holds a value, projects it, as the
    ; reference declares them, but where the class declares that name otherwise; then for each group
    ; of its event transitions at its root on a name alone or read from `this`, a private one that
    ; holds the group's activation for the event runtime's table. A class derived from another may
    ; refine the machine of its base's markup that has a case of a name its machine has at its root,
    ; whose flags and projections are then the base's where the cases are. Two more, named after
    ; the class and the machine's place among those of its markup, hold the machine's part for the
    ; object, which the machines that refine it call (`MachineComposite`), and the part of the
    ; machine that refines it for the object, which it calls. How many there are.
    (let start (. member-pool length))
    (let added (as (+ (. members start) (. members count)) Size))
    (let position 0u32)
    (for (in machine (call (. tree content-machines) content))
      (let items (call (. tree state-items) (call (. tree state-body) machine)))
      (for (in node (call (. tree machine-cases) items))
        (let name (!! (call (. tree state-name) node)))
        (if (not (call declares members added name))
          (let holds (!= (call (. tree payload-source) items name) null))
          (let decl
            (call PropertyDecl
              (block
                (arg node)
                (arg name)
                (arg owner)
                (arg 0)
                (arg 0)
                (arg null)
                (arg (. Access public-access))
                (arg false)
                (arg (call (of RowRange SyntaxId)))
                (arg false)
                (arg 0)
                (arg (if-expr holds 0 node))
                (arg 0)
                (arg 0)
                (arg 0)
                (arg (if-expr holds node 0))
              )
            )
          )
          (call (. member-pool append) (call append decl))
        )
      )
      (let place 0u32)
      (for (in head (call (. tree group-heads) items))
        (if (call self-stream tree (call (. tree group-stream) head))
          (let name (call store-atom (str "(state-" position "-event-descriptor-context-" place ")")))
          (call (. member-pool append) (call append (call hidden-property head name owner 0 head)))
          (+= place 1)
        )
      )
      (match? ([] decls owner)
        (case (call .decl-class class)
          (for (in suffix (list "part" "below"))
            (let name (call store-atom (str "(" (. class name text) "-state-" position "-" suffix ")")))
            (call (. member-pool append) (call append (call part-holder machine name owner)))
          )
        )
      )
      (+= position 1)
    )
    (return (as (- (. member-pool length) start) U32))
  )
  (fn-expr _ part-holder PropertyDecl
    (param machine SyntaxId)
    (param name Atom)
    (param owner DeclId)
    ; A private property of an object that holds a part of a state machine merged with others, which
    ; no program names.
    (call PropertyDecl
      (block
        (arg machine)
        (arg name)
        (arg owner)
        (arg 0)
        (arg 0)
        (arg null)
        (arg (. Access private-access))
        (arg false)
        (arg (call (of RowRange SyntaxId)))
        (arg false)
        (arg 0)
        (arg 0)
        (arg 0)
        (arg 0)
        (arg machine)
      )
    )
  )
  (fn-expr _ hidden-property PropertyDecl
    (param node SyntaxId)
    (param name Atom)
    (param owner DeclId)
    (param flag SyntaxId)
    (param context SyntaxId)
    ; A private property of an object a state machine keeps no program names.
    (call PropertyDecl
      (block
        (arg node)
        (arg name)
        (arg owner)
        (arg 0)
        (arg 0)
        (arg null)
        (arg (. Access private-access))
        (arg false)
        (arg (call (of RowRange SyntaxId)))
        (arg false)
        (arg 0)
        (arg flag)
        (arg context)
      )
    )
  )
  (fn-do _ self-stream Bool
    (param tree AST)
    (param stream SyntaxId)
    ; Whether a stream is written as a name alone, or as a name read from `this`.
    (match? ([] (. tree nodes) stream)
      (case .node-identifier
        (return true)
      )
      (case (call .node-get-expression row)
        (match? ([] (. tree nodes) (. row object))
          (case (call .node-identifier object)
            (return (== (. object name text) "this"))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ add-content-members U32
    (param tree AST)
    (param owner DeclId)
    (param content SyntaxId)
    (param members (of RowRange DeclId))
    ; The properties the markup written in a class declares, as members after those the class
    ; writes; how many there are. An attribute of a root `<This` gives a property of a class
    ; above a new value, as a property declared again does, and so does one of a property the
    ; class declares itself with no value. An element written with a name is a private property
    ; of that name and the element's type, which holds nothing until the markup makes the
    ; element. A line of a section with no root that declares a property the markup gives its value
    ; (`content-property`) declares it, public and stored, after them. A name the class declares
    ; otherwise declares nothing more.
    (if (== content 0)
      (return 0)
    )
    (let start (. member-pool length))
    (let root (call (. tree root-this) content))
    (match? ([] (. tree nodes) root)
      (case (call .node-markup element)
        (match? ([] (. tree nodes) (. element body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (match? ([] (. tree nodes) statement)
                (case (call .node-assign attribute)
                  (let name (call attribute-name tree (. attribute op) (. attribute lhs)))
                  (if (and name (or (not (call declares members start name)) (call awaits-value members name)))
                    (let decl
                      (call PropertyDecl
                        (block
                          (arg statement)
                          (arg name)
                          (arg owner)
                          (arg 0)
                          (arg (. attribute rhs))
                          (arg null)
                          (arg (. Access public-access))
                          (arg false)
                          (arg (call (of RowRange SyntaxId)))
                          (arg true)
                        )
                      )
                    )
                    (call (. member-pool append) (call append decl))
                  )
                )
              )
            )
          )
        )
      )
    )
    (let first (call (. tree subtree-start) content))
    (let lines (call (. tree content-lines) content))
    (for (in node (..< first content))
      (if (not (call is-markup-line tree content lines node))
        (continue)
      )
      (match? ([] (. tree nodes) node)
        (case (call .node-markup element)
          (let name (call element-name tree (. element id)))
          (if (and name (!= node root) (not is-enclosed-node) (not (call declares members start name)))
            (let decl
              (call PropertyDecl
                (block
                  (arg (. element id))
                  (arg name)
                  (arg owner)
                  (arg (. element type-id))
                  (arg 0)
                  (arg null)
                  (arg (. Access private-access))
                  (arg false)
                  (arg (call (of RowRange SyntaxId)))
                  (arg false)
                  (arg node)
                )
              )
            )
            (call (. member-pool append) (call append decl))
          )
          (lazy is-enclosed-node (call is-enclosed tree content node))
        )
      )
    )
    (if (== root 0)
      (match? ([] (. tree nodes) lines)
        (case (call .node-block block)
          (for (in statement ([] (. tree children) (. block body)))
            (let name (call element-name tree (call (. tree content-property-name) statement)))
            (if (and name (not (call declares members start name)))
              (let decl
                (call PropertyDecl
                  (block
                    (arg statement)
                    (arg name)
                    (arg owner)
                    (arg 0)
                    (arg 0)
                    (arg null)
                    (arg (. Access public-access))
                    (arg false)
                    (arg (call (of RowRange SyntaxId)))
                    (arg false)
                    (arg 0)
                    (arg 0)
                    (arg 0)
                    (arg statement)
                  )
                )
              )
              (call (. member-pool append) (call append decl))
            )
          )
        )
      )
    )
    (return (as (- (. member-pool length) start) U32))
  )
  (fn-do _ is-markup-line Bool
    (param tree AST)
    (param content SyntaxId)
    (param lines SyntaxId)
    (param node SyntaxId)
    ; Whether a node of a class's content is written in a line of its markup: any node of a
    ; section, but in a `• This` only those of the lines that are not the rule's own (`runs-line`).
    (if (not (is ([] (. tree nodes) content) .node-rule-syntax))
      (return true)
    )
    (match? ([] (. tree nodes) lines)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (and (<= (call (. tree subtree-start) statement) node) (<= node statement))
            (return (call (. tree runs-line) content statement))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ declares Bool
    (param members (of RowRange DeclId))
    (param added Size)
    (param name Atom)
    ; Whether a class declares a property or an event of a name: among the members it writes, or
    ; among those its markup has declared so far.
    (for (in offset (..< 0 (. members count)))
      (if (call names-property ([] member-pool (+ (. members start) offset)) name)
        (return true)
      )
    )
    (for (in place (..< added (. member-pool length)))
      (if (call names-property ([] member-pool place) name)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ awaits-value Bool
    (param members (of RowRange DeclId))
    (param name Atom)
    ; Whether a class writes a property of a name that it stores, with no value and no element.
    (for (in offset (..< 0 (. members count)))
      (match? ([] decls ([] member-pool (+ (. members start) offset)))
        (case (call .decl-property row)
          (if (and (. row name) (== (. row name) name))
            (return (and (== (. row value) 0) (not (. row is-lazy)) (== (. row element) 0)))
          )
        )
      )
    )
    (return false)
  )
  (fn-expr _ names-property Bool
    (param member DeclId)
    (param name Atom)
    (match ([] decls member)
      (case (call .decl-property row)
        (and (!= (. row name) null) (== (. row name) name))
      )
      (case (call .decl-event row)
        (== (. row name) name)
      )
      (default
        false
      )
    )
  )
  (fn-do _ is-enclosed Bool
    (param tree AST)
    (param content SyntaxId)
    (param node SyntaxId)
    ; Whether a node of a class's markup is written in a function or a loop there: an element
    ; named in one is no property of the class.
    (for (in outer (..< (+ node 1) content))
      (if (> (call (. tree subtree-start) outer) node)
        (continue)
      )
      (match? ([] (. tree nodes) outer)
        (case .node-function-syntax
          (return true)
        )
        (case .node-for-block
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ attribute-name (? Atom)
    (param tree AST)
    (param op Operator)
    (param target SyntaxId)
    (if (!= op .eq-op)
      (return null)
    )
    (match? ([] (. tree nodes) target)
      (case (call .node-identifier row)
        (return (. row name))
      )
    )
    (return null)
  )
  (fn-do _ element-name (? Atom)
    (param tree AST)
    (param id SyntaxId)
    (if (== id 0)
      (return null)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-identifier row)
        (return (. row name))
      )
    )
    (return null)
  )
  (fn-do _ scan-nested _
    (param tree AST)
    (param main DeclId)
    ; Lambdas and task bodies are nested functions. Walking ids downward visits every enclosing function
    ; before the functions inside it, so a stack of the open subtrees names each owner; anything outside
    ; every function, such as a lambda in a property initializer, belongs to main. A second stack holds
    ; the declarations and assignments whose values are open, which name the nested functions written in
    ; them. A feed a stream piped through a pattern reads alone is no function: the pipe's evaluates
    ; what it writes. A `for` block on a stream with one header is the subscriber its body runs as, a
    ; class's section of one too. An assignment whose value reads something tracked, which gives no
    ; property of a root `<This` its value, is run again by a function of its own (`add-live`), as is a
    ; lazy declaration, no attribute, of one name whose value does, but one in the value of a property
    ; or of a statement run again so, which runs again with that value; so is an attribute of another
    ; element, whose function stores in the element's property, and an argument of one given by
    ; position, but a comprehension. The
    ; `whenever` clause of a loop on a stream is tested again by one too (`add-whenever`). An `if`
    ; written as a line of markup content, or of a body that runs as content, whose conditions read
    ; something tracked is a region: each arm is built by a function of its own, written at its body,
    ; and one selects the arm again (`add-branch`), and so is a `match` written as such a line whose
    ; subject does (`is-match-region`). So is a `for` written as such a line whose container reads
    ; something tracked: each row is built by a function of its own, written at its body, one reads the
    ; container again (`add-source`), and where the loop is keyed one keys each row, written at its
    ; `keyed by` clause. The condition a style rule written on a markup element, but a root `<This`, is
    ; applied under is tested again by a function of its own, written at the condition, where the
    ; reference takes it (`add-gate`). In the row of a keyed loop, a read of the loop's item and of the
    ; row's own declarations that read it is tracked (`RowNames`). A lazy declaration written as a line
    ; of a row is read as a getter, never run again on its own. A markup element that binds a slot, but
    ; a root `<This`, is built by a function of its own, which the constructor of the element it is a
    ; line of is given. So is the one line of an element's body that is neither an attribute nor bound
    ; to a slot, where the element's class is one of `default-hosts` and that line is a markup element:
    ; it fills the default slot; and so is such a body whose lines all give the slot content, where the
    ; reference builds them into a node of the slot's type (`mark-default`). The lines of the markup a
    ; class writes fill so the default slot of the class it derives from. Each class name looked up so
    ; is `consulted`. The body of a slot outlet is content, as an element's is, and so are the lines of
    ; a class's markup section written with no root `<This`. An element written with a name whose body
    ; gives slots content gives its constructor a function of its own, written at the name, that gives
    ; the name the element's object before the markup of its class runs. A state machine is a function
    ; of its own, but a named one written in a case of another, which is part of that one's. A line of
    ; an element's body, or of the body of an arm of a region, that gives content and reads something
    ; tracked is given again by a function of its own. A slot outlet that gives its slot's function a
    ; name the row of a keyed loop reads tracked is a region of one arm (`rebuilds-outlet`).
    (let declared (list DeclId))
    (let inline (list Bool))
    (let chained (list Bool))
    (let piped (list Bool))
    (let listed (list Bool))
    (let attributes (list Bool))
    (let defaults (list Bool))
    (let content (list Bool))
    (let arms (list Bool))
    (let rows (list Bool))
    (let keys (list Bool))
    (let positions (list Bool))
    (let gates (list Bool))
    (let defaulted (list Bool))
    (let binders (list Bool))
    (let machines (list Bool))
    (let ruled (list Bool))
    (for (in _ (..< 0 (+ (. tree root) 1)))
      (+= defaulted false)
      (+= binders false)
      (+= machines false)
      (+= declared 0)
      (+= inline false)
      (+= chained false)
      (+= piped false)
      (+= listed false)
      (+= attributes false)
      (+= defaults false)
      (+= content false)
      (+= arms false)
      (+= rows false)
      (+= keys false)
      (+= positions false)
      (+= gates false)
      (+= ruled false)
    )
    (let total (+ (. tree root) 1))
    (let row-names (call RowNames))
    (for (in id (..< 1u32 total))
      (let listing (call (. tree listed-feeds) id))
      (if (!= listing 0)
        (= ([] listed listing) true)
      )
      (match? ([] (. tree nodes) id)
        (case (call .node-feed-expression row)
          (if (!= (. row next) 0)
            (= ([] chained (. row next)) true)
          )
        )
        (case (call .node-markup row)
          (call mark-content tree (. row body) content arms rows keys row-names)
        )
        (case (call .node-slot-outlet row)
          (call mark-content tree (. row body) content arms rows keys row-names)
        )
        (case (call .node-content-block row)
          (if (== (call (. tree root-this) id) 0)
            (call mark-content tree (. row body) content arms rows keys row-names)
          )
        )
        (case (call .node-class-block row)
          (call mark-default tree (. row base) (call class-lines tree (. row members)) defaulted)
        )
        (case (call .node-property-syntax row)
          (if (and (!= (. row value) 0) (is ([] (. tree nodes) (. row value)) .node-state-machine))
            (= ([] machines (. row value)) true)
          )
        )
        (case (call .node-rule-syntax row)
          (call mark-rule-lines tree (. row body) ruled)
        )
      )
    )
    (let getters (list Bool))
    (for (in _ (..< 0 total))
      (+= getters false)
    )
    (for (in id (..< 1u32 total))
      (match? ([] (. tree nodes) id)
        (case (call .node-block row)
          (if ([] rows id)
            (for (in line ([] (. tree children) (. row body)))
              (match? ([] (. tree nodes) line)
                (case (call .node-declare declared)
                  (= ([] getters line) (. declared is-lazy))
                )
              )
            )
          )
        )
      )
    )
    (for (in index (..< 0 (. decls length)))
      (match? ([] decls index)
        (case (call .decl-function fn)
          (if (and (not (. fn is-generated)) (< (. fn syntax) (. declared length)))
            (= ([] declared (. fn syntax)) (as index DeclId))
          )
        )
      )
    )
    (blank)
    (let owners (list DeclId))
    (let starts (list SyntaxId))
    (let floors (list Size))
    (let namings (call Namings))
    (let parents (call tree-parents tree total))
    (for (in reverse (..< 1 (. tree root)))
      (let id (- (. tree root) reverse))
      (while (and (!= (. starts length) 0) (< id ([] starts (- (. starts length) 1))))
        (call (. owners pop))
        (call (. starts pop))
        (call (. floors pop))
      )
      (call (. namings close) id)
      (let existing ([] declared id))
      (if (!= existing 0)
        (match? ([] decls existing)
          (case (call .decl-function fn)
            (+= owners existing)
            (+= starts (. fn subtree start))
            (+= floors (. namings nodes length))
          )
        )
        (continue)
      )
      (let depth (call holding-depth id owners parents))
      (let owner (if-expr (!= depth 0) ([] owners (- depth 1)) main))
      (let named (call naming tree id owners floors namings depth))
      (let nested 0u32)
      (match? ([] (. tree nodes) id)
        (case (call .node-function-syntax row)
          (= nested
            (call add-nested-function
              (block
                (arg tree)
                (arg id)
                (arg (. row names))
                (arg (. row args))
                (arg (. row return-type))
                (arg (. row errors))
                (arg (. row body))
                (arg (. row compilation-effects))
                (arg (. DeclKind closure-decl))
                (arg owner)
                (arg 0)
                (arg named)
              )
            )
          )
        )
        (case (call .node-do-task-block row)
          (= nested
            (call add-nested-function
              (block
                (arg tree)
                (arg id)
                (arg (call (of RowRange Atom)))
                (arg (call (of RowRange SyntaxId)))
                (arg 0)
                (arg (call (of RowRange SyntaxId)))
                (arg (. row body))
                (arg (. CompilationEffect none))
                (arg (. DeclKind task-decl))
                (arg owner)
                (arg 0)
                (arg named)
              )
            )
          )
        )
        (case (call .node-do-block row)
          (if (call opens-region (. row compilation-effects) owner)
            (= nested
              (call add-nested-function
                (block
                  (arg tree)
                  (arg id)
                  (arg (call (of RowRange Atom)))
                  (arg (call (of RowRange SyntaxId)))
                  (arg 0)
                  (arg (call (of RowRange SyntaxId)))
                  (arg (. row body))
                  (arg (. row compilation-effects))
                  (arg (. DeclKind region-decl))
                  (arg owner)
                  (arg 0)
                  (arg named)
                )
              )
            )
          )
        )
        (case .node-state-machine
          (if (or (not ([] machines id)) (not (call is-machine-decl owner)))
            (= nested
              (call add-nested-function
                (block
                  (arg tree)
                  (arg id)
                  (arg (call (of RowRange Atom)))
                  (arg (call (of RowRange SyntaxId)))
                  (arg 0)
                  (arg (call (of RowRange SyntaxId)))
                  (arg id)
                  (arg (. CompilationEffect none))
                  (arg (. DeclKind machine-decl))
                  (arg owner)
                  (arg 0)
                  (arg named)
                )
              )
            )
          )
        )
        (case (call .node-feed-expression row)
          (if (and (!= (. row item) 0) (not (. row is-spread)))
            (= ([] inline (. row item)) true)
          )
          (if (and (not ([] chained id)) (not ([] piped id)) (not ([] listed id)))
            (= nested
              (call add-nested-function
                (block
                  (arg tree)
                  (arg id)
                  (arg (call (of RowRange Atom)))
                  (arg (call (of RowRange SyntaxId)))
                  (arg 0)
                  (arg (call (of RowRange SyntaxId)))
                  (arg id)
                  (arg (. CompilationEffect none))
                  (arg (. DeclKind feed-decl))
                  (arg owner)
                  (arg (call last-feed tree id))
                  (arg named)
                )
              )
            )
          )
        )
        (case (call .node-pipeline-expression row)
          (if (call is-pipeline-nested (. row op))
            (= nested
              (call add-nested-function
                (block
                  (arg tree)
                  (arg id)
                  (arg (call (of RowRange Atom)))
                  (arg (call (of RowRange SyntaxId)))
                  (arg 0)
                  (arg (call (of RowRange SyntaxId)))
                  (arg (. row right))
                  (arg (. CompilationEffect none))
                  (arg (. DeclKind pipeline-decl))
                  (arg owner)
                  (arg 0)
                  (arg named)
                )
              )
            )
            (else-if (== (. row op) .grammar-pipe-op)
              (= nested (call add-pattern-pipe tree id owner named))
              (let feed (call (. tree piped-feed) id))
              (if (!= feed 0)
                (= ([] piped feed) true)
              )
            )
          )
        )
        (case (call .node-binary-expression row)
          (if (call is-pipeline-nested (. row op))
            (= nested
              (call add-nested-function
                (block
                  (arg tree)
                  (arg id)
                  (arg (call (of RowRange Atom)))
                  (arg (call (of RowRange SyntaxId)))
                  (arg 0)
                  (arg (call (of RowRange SyntaxId)))
                  (arg (. row rhs))
                  (arg (. CompilationEffect none))
                  (arg (. DeclKind pipeline-decl))
                  (arg owner)
                  (arg 0)
                  (arg named)
                )
              )
            )
            (else-if (== (. row op) .grammar-pipe-op)
              (= nested (call add-pattern-pipe tree id owner named))
              (let feed (call (. tree piped-feed) id))
              (if (!= feed 0)
                (= ([] piped feed) true)
              )
            )
          )
        )
        (case (call .node-markup row)
          (for (in child (call (. tree children-of) id))
            (= ([] inline child) true)
          )
          (let root (call (. tree names-this) (. row type-id)))
          (if (not root)
            (let defaults (call mark-default tree (. row type-id) (. row body) defaulted))
            (if (and (!= (. row id) 0) (or defaults (call binds-slots tree (. row body))))
              (= ([] binders (. row id)) true)
            )
          )
          (if (and (or (!= (. row slot-binding) 0) ([] defaulted id)) (not root))
            (= nested
              (call add-nested-function
                (block
                  (arg tree)
                  (arg id)
                  (arg (call (of RowRange Atom)))
                  (arg (call (of RowRange SyntaxId)))
                  (arg 0)
                  (arg (call (of RowRange SyntaxId)))
                  (arg id)
                  (arg (. CompilationEffect none))
                  (arg (. DeclKind slot-decl))
                  (arg owner)
                  (arg 0)
                  (arg named)
                )
              )
            )
          )
          (match? ([] (. tree nodes) (. row body))
            (case (call .node-block block)
              (for (in line ([] (. tree children) (. block body)))
                (= ([] attributes line) true)
                (= ([] defaults line) root)
                (if (and (call (. tree gives-content) line) (call reads-tracked tree line row-names))
                  (= ([] positions line) true)
                )
              )
            )
          )
          (for (in arg ([] (. tree children) (. row args)))
            (if (and (not root) (not (is ([] (. tree nodes) arg) .node-iterator-expression)) is-tracked-arg)
              (= ([] positions arg) true)
            )
            (lazy is-tracked-arg (call reads-tracked tree arg row-names))
          )
          (for (in application ([] (. tree children) (. row style-rule-applications)))
            (match? ([] (. tree nodes) application)
              (case (call .node-style-rule-application applied)
                (if (and (not root) (!= (. applied condition) 0) is-reference)
                  (= ([] gates (. applied condition)) true)
                )
                (lazy is-reference (call (. tree is-condition-reference) (. applied condition)))
              )
            )
          )
        )
        (case .node-if-block
          (if (and ([] attributes id) (call (. tree holds-fills) id))
            (call add-selector tree id owner named)
          )
          (if (and ([] content id) (not (call (. tree fills-only) id)) (call is-branch-region tree id row-line))
            (call add-branch tree id owner named)
          )
          (lazy row-line (only-if row-names (if ([] rows (call (. tree holder-of) id)))))
        )
        (case .node-match-expression
          (if (and ([] attributes id) (call (. tree holds-fills) id))
            (call add-selector tree id owner named)
          )
          (if (and ([] content id) (not (call (. tree fills-only) id)) (call is-match-region tree id row-line))
            (call add-branch tree id owner named)
          )
          (lazy row-line (only-if row-names (if ([] rows (call (. tree holder-of) id)))))
        )
        (case (call .node-slot-outlet row)
          (if (call (. tree builds-outlet-alone) id)
            (= nested
              (call add-nested-function
                (block
                  (arg tree)
                  (arg id)
                  (arg (call (of RowRange Atom)))
                  (arg (call (of RowRange SyntaxId)))
                  (arg 0)
                  (arg (call (of RowRange SyntaxId)))
                  (arg id)
                  (arg (. CompilationEffect none))
                  (arg (. DeclKind branch-arm-decl))
                  (arg owner)
                  (arg 0)
                  (arg named)
                )
              )
            )
            (else-if (call rebuilds-outlet tree (. row slot-parameter) row-names)
              (do
                (inline
                  (call add-nested-function
                    (block
                      (arg tree)
                      (arg (. row slot-parameter))
                      (arg (call (of RowRange Atom)))
                      (arg (call (of RowRange SyntaxId)))
                      (arg 0)
                      (arg (call (of RowRange SyntaxId)))
                      (arg (. row slot-parameter))
                      (arg (. CompilationEffect none))
                      (arg (. DeclKind branch-decl))
                      (arg owner)
                      (arg 0)
                      (arg named)
                    )
                  )
                )
              )
              (= nested
                (call add-nested-function
                  (block
                    (arg tree)
                    (arg id)
                    (arg (call (of RowRange Atom)))
                    (arg (call (of RowRange SyntaxId)))
                    (arg 0)
                    (arg (call (of RowRange SyntaxId)))
                    (arg id)
                    (arg (. CompilationEffect none))
                    (arg (. DeclKind branch-arm-decl))
                    (arg owner)
                    (arg 0)
                    (arg named)
                  )
                )
              )
            )
          )
        )
        (case (call .node-block block)
          (if ([] defaulted id)
            (= nested
              (call add-nested-function
                (block
                  (arg tree)
                  (arg id)
                  (arg (call (of RowRange Atom)))
                  (arg (call (of RowRange SyntaxId)))
                  (arg 0)
                  (arg (call (of RowRange SyntaxId)))
                  (arg id)
                  (arg (. CompilationEffect none))
                  (arg (. DeclKind slot-decl))
                  (arg owner)
                  (arg 0)
                  (arg named)
                )
              )
            )
            (else-if (or ([] arms id) ([] rows id))
              (if (or ([] arms id) (and ([] rows id) (call (. tree row-region) id)))
                (for (in line ([] (. tree children) (. block body)))
                  (if (and (call (. tree gives-content) line) (call reads-tracked tree line row-names))
                    (= ([] positions line) true)
                  )
                )
              )
              (= nested
                (call add-nested-function
                  (block
                    (arg tree)
                    (arg id)
                    (arg (call (of RowRange Atom)))
                    (arg (call (of RowRange SyntaxId)))
                    (arg 0)
                    (arg (call (of RowRange SyntaxId)))
                    (arg id)
                    (arg (. CompilationEffect none))
                    (arg (if-expr ([] rows id) (. DeclKind row-decl) (. DeclKind branch-arm-decl)))
                    (arg owner)
                    (arg 0)
                    (arg named)
                  )
                )
              )
            )
          )
        )
        (case (call .node-assign row)
          (if (and (not ([] defaults id)) (== (. row op) .bind-op) ([] attributes id))
            (= nested (call add-live tree id owner named))
            (do
              (inline (call add-live tree (. row lhs) owner named id))
            )
          )
          (if (and (not ([] defaults id)) (== (. row op) .eq-op) (or is-tracked-value is-styled-value))
            (= nested (call add-live tree id owner named))
          )
          (lazy is-tracked-value (call reads-tracked tree (. row rhs) row-names))
          (lazy is-styled-value (and (or ([] attributes id) ([] ruled id)) (call reads-styles tree (. row rhs))))
        )
        (case (call .node-property-syntax row)
          (if (and ([] content id) (call (. tree content-property) id) (call reads-tracked tree (. row value) row-names))
            (= nested (call add-live tree id owner named))
          )
        )
        (case (call .node-declare row)
          (let plain (call declared-plainly tree (. row left)))
          (if (and is-unclaimed (. row is-lazy) plain (!= (. row right) 0) is-live)
            (= nested (call add-live tree id owner named))
          )
          (lazy is-unclaimed (and (not ([] attributes id)) (not ([] getters id))))
          (lazy is-live
            (block
              (and (call reads-tracked tree (. row right)) (not (call in-property-value tree id parents)) (not attached))
            )
          )
          (lazy attached (call in-live-value id owners depth parents))
        )
        (case (call .node-iterable-expression row)
          (if (call reads-tracked tree (. row expr))
            (= nested (call add-live tree id owner named))
          )
        )
        (case (call .node-for-block row)
          (if (and (not ([] inline id)) (call is-subscriber-loop tree (. row loop)))
            (= nested
              (call add-nested-function
                (block
                  (arg tree)
                  (arg id)
                  (arg (call (of RowRange Atom)))
                  (arg (call (of RowRange SyntaxId)))
                  (arg 0)
                  (arg (call (of RowRange SyntaxId)))
                  (arg id)
                  (arg (. CompilationEffect none))
                  (arg (. DeclKind subscriber-decl))
                  (arg owner)
                  (arg 0)
                  (arg named)
                )
              )
            )
            (call add-whenever tree (. row loop) owner named)
            (else-if (and ([] content id) (call is-markup-loop tree (. row loop)))
              (call add-source tree id owner named)
            )
          )
        )
        (case (call .node-clause row)
          (if ([] keys id)
            (= nested
              (call add-nested-function
                (block
                  (arg tree)
                  (arg id)
                  (arg (call (of RowRange Atom)))
                  (arg (call (of RowRange SyntaxId)))
                  (arg 0)
                  (arg (call (of RowRange SyntaxId)))
                  (arg (. row expr))
                  (arg (. CompilationEffect none))
                  (arg (. DeclKind key-decl))
                  (arg owner)
                  (arg 0)
                  (arg named)
                )
              )
            )
          )
        )
        (case (call .node-iterator-expression row)
          (if (and ([] content id) (call is-content-loop tree (. row loop)))
            (= nested 0)
            (else-if (and (not ([] inline id)) (call is-generator-loop tree (. row loop)))
              (= nested
                (call add-nested-function
                  (block
                    (arg tree)
                    (arg id)
                    (arg (call (of RowRange Atom)))
                    (arg (call (of RowRange SyntaxId)))
                    (arg 0)
                    (arg (call (of RowRange SyntaxId)))
                    (arg id)
                    (arg (. CompilationEffect none))
                    (arg (. DeclKind iterator-decl))
                    (arg owner)
                    (arg 0)
                    (arg named)
                  )
                )
              )
            )
            (else-if (and (not ([] inline id)) (call is-subscriber-loop tree (. row loop)))
              (= nested
                (call add-nested-function
                  (block
                    (arg tree)
                    (arg id)
                    (arg (call (of RowRange Atom)))
                    (arg (call (of RowRange SyntaxId)))
                    (arg 0)
                    (arg (call (of RowRange SyntaxId)))
                    (arg id)
                    (arg (. CompilationEffect none))
                    (arg (. DeclKind subscriber-decl))
                    (arg owner)
                    (arg 0)
                    (arg named)
                  )
                )
              )
              (call add-whenever tree (. row loop) owner named)
            )
          )
        )
      )
      (if (and (== nested 0) ([] defaulted id) (call gives-value tree id))
        (= nested
          (call add-nested-function
            (block
              (arg tree)
              (arg id)
              (arg (call (of RowRange Atom)))
              (arg (call (of RowRange SyntaxId)))
              (arg 0)
              (arg (call (of RowRange SyntaxId)))
              (arg id)
              (arg (. CompilationEffect none))
              (arg (. DeclKind slot-decl))
              (arg owner)
              (arg 0)
              (arg named)
            )
          )
        )
      )
      (if (and (== nested 0) ([] positions id))
        (= nested (call add-live tree id owner named))
      )
      (if (and (== nested 0) ([] gates id))
        (= nested (call add-gate tree id owner named))
      )
      (if (and (== nested 0) ([] binders id))
        (= nested
          (call add-nested-function
            (block
              (arg tree)
              (arg id)
              (arg (call (of RowRange Atom)))
              (arg (call (of RowRange SyntaxId)))
              (arg 0)
              (arg (call (of RowRange SyntaxId)))
              (arg id)
              (arg (. CompilationEffect none))
              (arg (. DeclKind binder-decl))
              (arg owner)
              (arg 0)
              (arg named)
            )
          )
        )
      )
      (if (!= nested 0)
        (match? ([] decls nested)
          (case (call .decl-function fn)
            (+= owners nested)
            (+= starts (. fn subtree start))
            (+= floors (. namings nodes length))
          )
        )
      )
      (call (. namings open) tree id)
    )
  )
  (fn-do _ mark-default Bool
    (param tree AST)
    (param type SyntaxId)
    (param body SyntaxId)
    (param defaulted (list Bool))
    ; Marks what fills the default slot of an element's class, and answers whether it marked
    ; anything: the one line of the body that gives the slot content, where that is an element or a
    ; value the reference converts to the slot's type (`gives-value`); or the body itself, where
    ; several of its lines give the slot content, or one that is an `if`, a `match` or a loop of
    ; content, which the reference builds into a node of its own of those lines alone, whatever
    ; attributes and content bound to other slots the body holds too.
    (let lines 0)
    (let total 0)
    (let line SyntaxId 0)
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in each ([] (. tree children) (. block body)))
          (+= total 1)
          (if (call gives-default tree each)
            (+= lines 1)
            (= line each)
          )
        )
      )
    )
    (return-if false (if (== lines 0)))
    (let head (call head-name tree type))
    (return-if false (if (== (. head length) 0)))
    (if (== (call (. consulted find) head) null)
      (+= consulted head)
    )
    (return-if false (if (== (call (. default-hosts find) head) null)))
    (if (== lines 1)
      (match? ([] (. tree nodes) line)
        (case (call .node-markup row)
          (if (not (call (. tree names-this) (. row type-id)))
            (= ([] defaulted line) true)
            (return true)
          )
          (return false)
        )
      )
      (if (call gives-value tree line)
        (= ([] defaulted line) true)
        (return true)
      )
    )
    (if (and (== lines 1) (not (call is-control-line tree line)))
      (return false)
    )
    (= ([] defaulted body) true)
    (return true)
  )
  (fn-expr _ gives-value Bool
    (param tree AST)
    (param line SyntaxId)
    ; Whether a line of markup content is a value, which the one line that gives a default slot
    ; content is converted from to the slot's type: a value given as content (`gives-content`), but
    ; for a joining operator, or a value a `use` lends.
    (match ([] (. tree nodes) line)
      (case .node-binary-expression
        false
      )
      (case .node-use-expression
        true
      )
      (default
        (call (. tree gives-content) line)
      )
    )
  )
  (fn-do _ class-lines SyntaxId
    (param tree AST)
    (param members (of RowRange SyntaxId))
    ; The block whose lines are the markup a class writes, or none.
    (for (in member ([] (. tree children) members))
      (if (is ([] (. tree nodes) member) .node-content-block)
        (return (call (. tree content-lines) member))
      )
    )
    (return 0)
  )
  (fn-do _ is-control-line Bool
    (param tree AST)
    (param line SyntaxId)
    ; Whether a line of markup content is an `if`, a `match`, or a loop of content, as the
    ; reference's `isMarkupControlFlow` finds it.
    (match? ([] (. tree nodes) line)
      (case .node-if-block
        (return true)
      )
      (case .node-match-expression
        (return true)
      )
      (case (call .node-for-block row)
        (return (not (call is-subscriber-loop tree (. row loop))))
      )
      (case (call .node-iterator-expression row)
        (return (call is-content-loop tree (. row loop)))
      )
    )
    (return false)
  )
  (fn-do _ binds-slots Bool
    (param tree AST)
    (param body SyntaxId)
    ; Whether a line of an element's body is content bound to a slot by name.
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in line ([] (. tree children) (. block body)))
          (if (and (not (call gives-default tree line)) (not (is ([] (. tree nodes) line) .node-assign)))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-expr _ gives-default Bool
    (param tree AST)
    (param line SyntaxId)
    ; Whether a line of an element's body is content of the default slot: neither an attribute nor
    ; content bound to a slot.
    (match ([] (. tree nodes) line)
      (case .node-assign
        false
      )
      (case .node-markup-slot-forward
        false
      )
      (case (call .node-markup row)
        (== (. row slot-binding) 0)
      )
      (default
        (not (call (. tree fills-only) line))
      )
    )
  )
  (fn-do _ naming SyntaxId
    (param tree AST)
    (param id SyntaxId)
    (param owners (list DeclId))
    (param floors (list Size))
    (param namings Namings)
    (param depth Size)
    ; The innermost declaration or assignment whose value holds a node, within the function that
    ; writes the node: its owner, the innermost of the first `depth` open ones, or past a pipe whose
    ; right side does not hold it, the function the pipe is in. None where there is no such one.
    (let floor Size 0)
    (let level depth)
    (while (> level 0)
      (-= level 1)
      (let climbs false)
      (match? ([] decls ([] owners level))
        (case (call .decl-function fn)
          (= climbs
            (scope (and (== (. fn kind) .pipeline-decl) (not holds-id))
              (lazy holds-id (and (<= (call (. tree subtree-start) (. fn body)) id) (<= id (. fn body))))
            )
          )
        )
      )
      (if (not climbs)
        (= floor ([] floors level))
        (break)
      )
    )
    (return (call (. namings innermost) id floor))
  )
  (fn-do _ holding-depth Size
    (param id SyntaxId)
    (param owners (list DeclId))
    (param parents (list SyntaxId))
    ; How many of the open declarations hold a node. A state machine merged from cases written as
    ; statements of a block is made once the block is read, after its other statements, which fall
    ; within its range though it does not hold them; it is passed over for them.
    (let depth (. owners length))
    (while (!= depth 0)
      (let passed false)
      (match? ([] decls ([] owners (- depth 1)))
        (case (call .decl-function fn)
          (= passed (and (== (. fn kind) .machine-decl) (not (call descends id (. fn syntax) parents))))
        )
      )
      (if (not passed)
        (return depth)
      )
      (-= depth 1)
    )
    (return depth)
  )
  (fn-do _ descends Bool
    (param id SyntaxId)
    (param ancestor SyntaxId)
    (param parents (list SyntaxId))
    ; Whether a node is below another, as the links of their children say.
    (let node ([] parents id))
    (while (and (!= node 0) (< node ancestor))
      (= node ([] parents node))
    )
    (return (== node ancestor))
  )
  (fn-do _ tree-parents (list SyntaxId)
    (param tree AST)
    (param total Size)
    ; The node each node is a child of, or none. A node linked as the child of two, as one merged
    ; into another node made after it is, has the later.
    (let parents (list SyntaxId))
    (for (in _ (..< 0 total))
      (+= parents 0)
    )
    (let limit (as total U32))
    (for (in id (..< 1u32 limit))
      (for (in child (call (. tree children-of) id))
        (= ([] parents child) id)
      )
    )
    (return parents)
  )
  (fn-do _ in-live-value Bool
    (param id SyntaxId)
    (param owners (list DeclId))
    (param depth Size)
    (param parents (list SyntaxId))
    (let open depth)
    (while (!= open 0)
      (match? ([] decls ([] owners (- open 1)))
        (case (call .decl-function fn)
          (if (call descends id (. fn syntax) parents)
            (return (== (. fn kind) .live-decl))
          )
        )
      )
      (-= open 1)
    )
    (return false)
  )
  (fn-do _ in-property-value Bool
    (param tree AST)
    (param id SyntaxId)
    (param parents (list SyntaxId))
    ; Whether a node is written in the value of a property, outside the functions written in it.
    (let node ([] parents id))
    (while (!= node 0)
      (match? ([] (. tree nodes) node)
        (case .node-property-syntax
          (return true)
        )
        (case .node-function-syntax
          (return false)
        )
      )
      (= node ([] parents node))
    )
    (return false)
  )
  (fn-do _ last-feed SyntaxId
    (param tree AST)
    (param id SyntaxId)
    (let feed id)
    (while true
      (match ([] (. tree nodes) feed)
        (case (call .node-feed-expression row)
          (if (== (. row next) 0)
            (return feed)
          )
          (= feed (. row next))
        )
        (default
          (return feed)
        )
      )
    )
  )
  (fn-do _ reads-tracked Bool
    (param tree AST)
    (param value SyntaxId)
    (param rows (? RowNames) (= null))
    ; Whether a value reads a name or a member tracked outside the functions written in it, the
    ; latest item of a stream, or one of the `rows` names in the row of a keyed markup loop that
    ; reads them tracked.
    (let id value)
    (while (and (>= id (call (. tree subtree-start) value)) (!= id 0))
      (match? ([] (. tree nodes) id)
        (case (call .node-identifier row)
          (if (or (. row is-tracked) (and rows (call (. rows reads) id (. row name text))))
            (return true)
          )
        )
        (case (call .node-get-expression row)
          (if (. row is-tracked)
            (return true)
          )
        )
        (case .node-latest-expression
          (return true)
        )
        (case .node-function-syntax
          (= id (call (. tree subtree-start) id))
        )
      )
      (-= id 1)
    )
    (return false)
  )
  (fn-do _ mark-rule-lines _
    (param tree AST)
    (param body SyntaxId)
    (param ruled (list Bool))
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in line ([] (. tree children) (. block body)))
          (= ([] ruled line) true)
          (match? ([] (. tree nodes) line)
            (case (call .node-style-when branch)
              (call mark-rule-lines tree (. branch body) ruled)
            )
          )
        )
      )
    )
  )
  (fn-do _ reads-styles Bool
    (param tree AST)
    (param value SyntaxId)
    (let id value)
    (while (and (>= id (call (. tree subtree-start) value)) (!= id 0))
      (match? ([] (. tree nodes) id)
        (case .node-style-read-expression
          (return true)
        )
        (case .node-function-syntax
          (= id (call (. tree subtree-start) id))
        )
      )
      (-= id 1)
    )
    (return false)
  )
  (fn-do _ rebuilds-outlet Bool
    (param tree AST)
    (param parameter SyntaxId)
    (param rows RowNames)
    ; Whether a slot outlet gives the function that builds its slot a name the row of a keyed markup
    ; loop reads tracked (`RowNames`), which the reference reads as a getter: the outlet is then a
    ; branch region of one arm, the outlet itself, built again whenever what the name reads changes,
    ; as `markupRebuildingSlotOutlet` makes it. The function that selects the arm again is written at
    ; the outlet's parameter, whose name it reads, and the arm at the outlet.
    (match? ([] (. tree nodes) parameter)
      (case (call .node-markup-slot-parameter row)
        (match? ([] (. tree nodes) (. row name))
          (case (call .node-identifier named)
            (return (call (. rows reads) (. row name) (. named name text)))
          )
        )
      )
    )
    (return false)
  )
  (fn-expr _ declared-plainly Bool
    (param tree AST)
    (param left SyntaxId)
    ; Whether a declaration names one local with no type written.
    (match ([] (. tree nodes) left)
      (case .node-identifier
        true
      )
      (case (call .node-type-capture row)
        (and (== (. row type) 0) (is ([] (. tree nodes) (. row id)) .node-identifier))
      )
      (default
        false
      )
    )
  )
  (fn-do _ add-whenever _
    (param tree AST)
    (param loop SyntaxId)
    (param owner DeclId)
    (param named SyntaxId)
    ; The function that tests a loop's `whenever` clause again when what it read tracked changes,
    ; where the loop has one. It belongs to the function the loop is written in, and its subtree
    ; is the clause's, whose first test is that function's.
    (let clause (call (. tree whenever-clause) loop))
    (if (== clause 0)
      (return)
    )
    (let start (call (. tree subtree-start) clause))
    (let fn
      (call FunctionDecl
        (block
          (arg clause)
          (arg null)
          (arg (call (of RowRange Atom)))
          (arg owner)
          (arg (. Access private-access))
          (arg (. DeclKind whenever-decl))
          (arg (call (of RowRange DeclId)))
          (arg 0)
          (arg (call (of RowRange SyntaxId)))
          (arg (. CompilationEffect none))
          (arg false)
          (arg 0)
          (arg (call SyntaxRange start (+ (- clause start) 1)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (. U32 max))
          (arg 0)
          (arg false)
          (arg (call (of RowRange SyntaxId)))
          (arg named)
        )
      )
    )
    (do
      (inline (call append fn))
    )
  )
  (fn-do _ add-live DeclId
    (param tree AST)
    (param id SyntaxId)
    (param owner DeclId)
    (param named SyntaxId)
    (param whole SyntaxId (= 0))
    ; The function that runs a statement, an argument of a markup element, or the value of a stream
    ; of a value as it changes, again when what it read tracked changes. Its subtree is the node's,
    ; whose first run is the enclosing function's, or that of the `whole` statement it is written in,
    ; as for the function that stores back what a binding's element holds.
    (let covered (if-expr (!= whole 0) whole id))
    (let start (call (. tree subtree-start) covered))
    (let fn
      (call FunctionDecl
        (block
          (arg id)
          (arg null)
          (arg (call (of RowRange Atom)))
          (arg owner)
          (arg (. Access private-access))
          (arg (. DeclKind live-decl))
          (arg (call (of RowRange DeclId)))
          (arg 0)
          (arg (call (of RowRange SyntaxId)))
          (arg (. CompilationEffect none))
          (arg false)
          (arg 0)
          (arg (call SyntaxRange start (+ (- covered start) 1)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (. U32 max))
          (arg 0)
          (arg false)
          (arg (call (of RowRange SyntaxId)))
          (arg named)
        )
      )
    )
    (return (call append fn))
  )
  (fn-do _ add-gate DeclId
    (param tree AST)
    (param condition SyntaxId)
    (param owner DeclId)
    (param named SyntaxId)
    ; The function that tests again the condition a style rule written on a markup element is
    ; applied under when what it read tracked changes. Its subtree is the condition's, whose first
    ; test is the enclosing function's.
    (let start (call (. tree subtree-start) condition))
    (let fn
      (call FunctionDecl
        (block
          (arg condition)
          (arg null)
          (arg (call (of RowRange Atom)))
          (arg owner)
          (arg (. Access private-access))
          (arg (. DeclKind gate-decl))
          (arg (call (of RowRange DeclId)))
          (arg 0)
          (arg (call (of RowRange SyntaxId)))
          (arg (. CompilationEffect none))
          (arg false)
          (arg 0)
          (arg (call SyntaxRange start (+ (- condition start) 1)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (. U32 max))
          (arg 0)
          (arg false)
          (arg (call (of RowRange SyntaxId)))
          (arg named)
        )
      )
    )
    (return (call append fn))
  )
  (fn-do _ mark-content _
    (param tree AST)
    (param body SyntaxId)
    (param content (list Bool))
    (param arms (list Bool))
    (param rows (list Bool))
    (param keys (list Bool))
    (param row-names RowNames)
    ; Marks the lines of a body that runs as markup content, and those of the bodies its lines run as
    ; content in turn: each arm of an `if` and of a markup match region, and the body of a `for`, or of
    ; a loop written as an expression with `in`, that is no loop on a stream. The body of each arm of a
    ; markup branch or match region is marked as one a function of its own builds, and so is the body of
    ; a markup loop region, which builds each row and is no content, and its `keyed by` clause, which
    ; keys each row. The arms after the first of an `if` follow it in the tree, so they are reached by
    ; their links.
    (let row-lines (only-if row-names (if ([] rows body))))
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in line ([] (. tree children) (. block body)))
          (= ([] content line) true)
          (match? ([] (. tree nodes) line)
            (case .node-if-block
              (let region (and (call is-branch-region tree line row-lines) (not (call (. tree fills-only) line))))
              (let arm line)
              (while (!= arm 0)
                (let next SyntaxId 0)
                (match? ([] (. tree nodes) arm)
                  (case (call .node-if-block branch)
                    (= ([] arms (call (. tree arm-body) arm)) region)
                    (call mark-content
                      (block
                        (arg tree)
                        (arg (call (. tree arm-body) arm))
                        (arg content)
                        (arg arms)
                        (arg rows)
                        (arg keys)
                        (arg row-names)
                      )
                    )
                    (= next (. branch next))
                  )
                )
                (= arm next)
              )
            )
            (case .node-match-expression
              (if (and (call is-match-region tree line row-lines) (not (call (. tree fills-only) line)))
                (let held (list SyntaxId))
                (call (. tree match-arms) line held)
                (for (in arm held)
                  (match? ([] (. tree nodes) arm)
                    (case (call .node-type-transform transform)
                      (= ([] arms (. transform expr)) true)
                      (call mark-content
                        (block
                          (arg tree)
                          (arg (. transform expr))
                          (arg content)
                          (arg arms)
                          (arg rows)
                          (arg keys)
                          (arg row-names)
                        )
                      )
                    )
                  )
                )
              )
            )
            (case (call .node-for-block row)
              (if (call is-markup-loop tree (. row loop))
                (= ([] rows (. row body)) true)
                (if (!= (call (. tree keyed-clause) (. row loop)) 0)
                  (call (. row-names add) tree (. row loop) (. row body))
                )
                (= ([] keys (call (. tree keyed-clause) (. row loop))) true)
                (= ([] keys (call (. tree when-clause) (. row loop))) true)
                (if (call (. tree row-region) (. row body))
                  (call mark-content tree (. row body) content arms rows keys row-names)
                )
                (else-if (not (call is-subscriber-loop tree (. row loop)))
                  (call mark-content tree (. row body) content arms rows keys row-names)
                )
              )
            )
            (case (call .node-iterator-expression row)
              (if (call is-content-loop tree (. row loop))
                (call mark-content tree (. row body) content arms rows keys row-names)
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ add-branch _
    (param tree AST)
    (param id SyntaxId)
    (param owner DeclId)
    (param named SyntaxId)
    (param kind _ (= (. DeclKind branch-decl)))
    (param anchor SyntaxId (= 0))
    ; The function that selects the arm of a markup branch region again when what its conditions
    ; read tracked changes, whose first selection is the enclosing function's; each arm is built by
    ; a function of its own, written at its body. The arms after the first follow the `if` in the
    ; tree, so its subtree runs from the first node of the `if` through its last arm. That of a
    ; markup match region selects again when what its subject reads changes; its subtree is the
    ; `match`'s.
    (let start (call (. tree subtree-start) id))
    (let last id)
    (let arm id)
    (while (!= arm 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) arm)
        (case (call .node-if-block row)
          (if (> arm last)
            (= last arm)
          )
          (= next (. row next))
        )
      )
      (= arm next)
    )
    (let fn
      (call FunctionDecl
        (block
          (arg (if-expr (!= anchor 0) anchor id))
          (arg null)
          (arg (call (of RowRange Atom)))
          (arg owner)
          (arg (. Access private-access))
          (arg kind)
          (arg (call (of RowRange DeclId)))
          (arg 0)
          (arg (call (of RowRange SyntaxId)))
          (arg (. CompilationEffect none))
          (arg false)
          (arg 0)
          (arg (call SyntaxRange start (+ (- last start) 1)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (. U32 max))
          (arg 0)
          (arg false)
          (arg (call (of RowRange SyntaxId)))
          (arg named)
        )
      )
    )
    (do
      (inline (call append fn))
    )
  )
  (fn-do _ add-selector _
    (param tree AST)
    (param id SyntaxId)
    (param owner DeclId)
    (param named SyntaxId)
    (let anchor (call (. tree selector-anchor) id))
    (if (!= anchor 0)
      (call add-branch tree id owner named (. DeclKind selector-decl) anchor)
    )
  )
  (fn-do _ add-source _
    (param tree AST)
    (param id SyntaxId)
    (param owner DeclId)
    (param named SyntaxId)
    ; The function that reads the container of a markup loop region again when what it read
    ; tracked changes, and gives the region what it gives, whose first read is the enclosing
    ; function's; each row is built by a function of its own, written at the loop's body.
    (let start (call (. tree subtree-start) id))
    (let fn
      (call FunctionDecl
        (block
          (arg id)
          (arg null)
          (arg (call (of RowRange Atom)))
          (arg owner)
          (arg (. Access private-access))
          (arg (. DeclKind source-decl))
          (arg (call (of RowRange DeclId)))
          (arg 0)
          (arg (call (of RowRange SyntaxId)))
          (arg (. CompilationEffect none))
          (arg false)
          (arg 0)
          (arg (call SyntaxRange start (+ (- id start) 1)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (. U32 max))
          (arg 0)
          (arg false)
          (arg (call (of RowRange SyntaxId)))
          (arg named)
        )
      )
    )
    (do
      (inline (call append fn))
    )
  )
  (fn-expr _ is-content-loop Bool
    (param tree AST)
    (param loop SyntaxId)
    ; Whether a loop written as an expression with `in` as a line of markup content runs its body
    ; as content, as a `for` does, and as the reference's `isMarkupControlFlow` finds one: it is no
    ; loop on a stream. One whose container reads something tracked, which the reference makes a
    ; region of, is none here: it has no shape yet.
    (and (not (call is-subscriber-loop tree loop)) (not (call is-markup-loop tree loop)))
  )
  (fn-do _ is-markup-loop Bool
    (param tree AST)
    (param loop SyntaxId)
    ; Whether a `for` written as a line of markup content is a region whose rows functions of
    ; their own build, as the reference's `markupLoopHeader` finds one: the container of one of
    ; its headers reads something tracked, before any header on a stream.
    (let header loop)
    (while (!= header 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) header)
        (case (call .node-loop-syntax row)
          (if (. row is-subscriber)
            (return false)
          )
          (if (and (!= (. row container) 0) (call reads-tracked tree (. row container)))
            (return true)
          )
          (= next (. row next))
        )
      )
      (= header next)
    )
    (return false)
  )
  (fn-do _ is-branch-region Bool
    (param tree AST)
    (param id SyntaxId)
    (param row-names (? RowNames))
    ; Whether an `if` written as a line of markup content is a region whose arm is selected again
    ; when what its conditions read tracked changes, as the reference's `hasDynamicMarkupCondition`
    ; finds one: one of its conditions reads something tracked, or of an arm written with a pattern,
    ; `if | x = v`, its subject or its pattern (`pattern-arm`).
    (let tracked false)
    (let arm id)
    (while (!= arm 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) arm)
        (case (call .node-if-block row)
          (let pattern (call (. tree pattern-arm) arm))
          (if (!= pattern 0)
            (let subject SyntaxId 0)
            (match? ([] (. tree nodes) (. row condition))
              (case (call .node-match-expression matching)
                (= subject (. matching subject))
              )
            )
            (match? ([] (. tree nodes) pattern)
              (case (call .node-type-transform transform)
                (if (or tracks-subject (and (!= (. transform pattern) 0) tracks-pattern))
                  (= tracked true)
                )
                (lazy tracks-subject (call reads-tracked tree subject row-names))
                (lazy tracks-pattern (call reads-tracked tree (. transform pattern) row-names))
              )
            )
            (else-if (!= (. row condition) 0)
              (if (not (is ([] (. tree nodes) (. row condition)) .node-type-predicate))
                (return false)
              )
              (if (call reads-tracked tree (. row condition) row-names)
                (= tracked true)
              )
            )
          )
          (= next (. row next))
        )
      )
      (= arm next)
    )
    (return tracked)
  )
  (fn-do _ is-match-region Bool
    (param tree AST)
    (param id SyntaxId)
    (param row-names (? RowNames))
    ; Whether a `match` written as a line of markup content is a region whose arm is selected again
    ; when what its subject reads tracked changes, as the reference's `markupMatchBranch` compiles
    ; one: its subject reads something tracked, and its arms are each a pattern with a body
    ; (`match-arms`). One with a helper is no region here.
    (match? ([] (. tree nodes) id)
      (case (call .node-match-expression row)
        (if (or (== (. row subject) 0) (!= (. row helper) 0) (not (call reads-tracked tree (. row subject) row-names)))
          (return false)
        )
        (let held (list SyntaxId))
        (call (. tree match-arms) id held)
        (return (!= (. held length) 0))
      )
    )
    (return false)
  )
  (fn-expr _ is-subscriber-loop Bool
    (param tree AST)
    (param loop SyntaxId)
    ; A loop on a stream, `for x on s` or the comprehension `<* x on s`, with no header chained
    ; after it.
    (match ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (and (. row is-subscriber) (== (. row next) 0))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-generator-loop Bool
    (param tree AST)
    (param loop SyntaxId)
    ; A comprehension in expression position compiles as a generator closure that takes its
    ; container; a feed body or markup child is a loop of its owner, and a subscription is not a
    ; generator.
    (match ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (not (. row is-subscriber))
      )
      (default
        false
      )
    )
  )
  (fn-do _ add-pattern-pipe DeclId
    (param tree AST)
    (param id SyntaxId)
    (param owner DeclId)
    (param named SyntaxId)
    ; A stream piped through a pattern, `s ~> p`, which the reference compiles as the comprehension
    ; `~ p in s`: a generator closure given the stream, which yields what each match of the
    ; pattern gives.
    (return
      (call add-nested-function
        (block
          (arg tree)
          (arg id)
          (arg (call (of RowRange Atom)))
          (arg (call (of RowRange SyntaxId)))
          (arg 0)
          (arg (call (of RowRange SyntaxId)))
          (arg id)
          (arg (. CompilationEffect none))
          (arg (. DeclKind iterator-decl))
          (arg owner)
          (arg 0)
          (arg named)
        )
      )
    )
  )
  (fn-do _ add-nested-function DeclId
    (param tree AST)
    (param syntax SyntaxId)
    (param names (of RowRange Atom))
    (param args (of RowRange SyntaxId))
    (param return-type SyntaxId)
    (param errors (of RowRange SyntaxId))
    (param body SyntaxId)
    (param effects CompilationEffect)
    (param kind DeclKind)
    (param owner DeclId)
    (param last SyntaxId)
    (param named SyntaxId)
    ; The subtree is the whole node, as for every function row; a task's worker expression sits
    ; inside it although the spawning function evaluates it. A feed list's later feeds follow
    ; its first one in the tree, so its subtree runs through the last feed of the chain. `named`
    ; is the declaration or assignment the function is written in.
    (let shapes (call store-arg-shapes tree args))
    (let primary (? Atom))
    (if (!= (. names count) 0)
      (= primary ([] (. tree atoms) (. names start)))
    )
    (let start (call (. tree subtree-start) syntax))
    (let end (if-expr (!= last 0) last syntax))
    (let fn
      (call FunctionDecl
        (block
          (arg syntax)
          (arg primary)
          (arg names)
          (arg owner)
          (arg (. Access private-access))
          (arg kind)
          (arg (. shapes range))
          (arg return-type)
          (arg errors)
          (arg effects)
          (arg false)
          (arg body)
          (arg (call SyntaxRange start (+ (- end start) 1)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (. shapes variadic-index))
          (arg (. shapes required-count))
          (arg false)
          (arg (call (of RowRange SyntaxId)))
          (arg named)
        )
      )
    )
    (return (call append fn))
  )
  (fn-do _ opens-region Bool
    (param effects CompilationEffect)
    (param owner DeclId)
    ; Whether a `do` block with effects is the body of a function of its own, as the reference
    ; outlines one: a block that makes the zone the collector never sees, written where code is not
    ; in that zone already, in a function that makes it or in such a block.
    (if (== (/and/ effects (. CompilationEffect gc-free)) 0)
      (return false)
    )
    (match? ([] decls owner)
      (case (call .decl-function fn)
        (return (== (/and/ (. fn effects) (. CompilationEffect gc-free)) 0))
      )
    )
    (return true)
  )
  (fn-do _ is-machine-decl Bool
    (param decl DeclId)
    ; Whether a function is a state machine's, whose cases a named machine written in them belongs
    ; to.
    (match? ([] decls decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .machine-decl))
      )
    )
    (return false)
  )
  (fn-do _ add-main DeclId
    (param tree AST)
    (let root (. tree root))
    (let fn
      (call FunctionDecl
        (block
          (arg root)
          (arg null)
          (arg (call (of RowRange Atom)))
          (arg 0)
          (arg (. Access private-access))
          (arg (. DeclKind main-decl))
          (arg (call (of RowRange DeclId)))
          (arg 0)
          (arg (call (of RowRange SyntaxId)))
          (arg (. CompilationEffect none))
          (arg false)
          (arg root)
          (arg (call SyntaxRange 1 root))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (. U32 max))
          (arg 0)
          (arg true)
        )
      )
    )
    (return (call append fn))
  )
  (fn-do _ add-startup DeclId
    (param tree AST)
    (param kind DeclKind)
    ; A module's init or task main, or the check for a terminating task: a generated function
    ; with no syntax of its own, whose body emission builds.
    (let fn
      (call FunctionDecl
        (block
          (arg (. tree root))
          (arg null)
          (arg (call (of RowRange Atom)))
          (arg 0)
          (arg (. Access private-access))
          (arg kind)
          (arg (call (of RowRange ArgumentShape)))
          (arg 0)
          (arg (call (of RowRange SyntaxId)))
          (arg (. CompilationEffect none))
          (arg false)
          (arg 0)
          (arg (call SyntaxRange (. tree root) 0))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (call (of RowRange SyntaxId)))
          (arg (. U32 max))
          (arg 0)
          (arg true)
        )
      )
    )
    (return (call append fn))
  )
  (fn-do _ add-generated-constructors U32
    (param owner DeclId)
    (throw (call Panic "Module member pool exceeds U32 capacity") (if (>= (+ (. member-pool length) 3) (. U32 max))))
    (throw (call Panic "Module argument pool exceeds U32 capacity") (if (>= (. arg-pool length) (. U32 max))))
    (blank)
    (let this-name (call store-atom "This"))
    (let other-name (call store-atom "other"))
    (let no-args (call (of RowRange ArgumentShape)))
    (let default (call generated-function owner this-name .default-constructor-decl no-args 0))
    (call (. member-pool append) (call append default))
    (let arg-start (. arg-pool length))
    (call (. arg-pool append) (call ArgumentShape other-name 0 0 0 false .none false))
    (let cast-args (call (of RowRange ArgumentShape) (as arg-start U32) 1))
    (let cast (call generated-function owner this-name .cast-constructor-decl cast-args 1))
    (call (. member-pool append) (call append cast))
    (let tuple (call generated-function owner this-name .tuple-constructor-decl no-args 0))
    (call (. member-pool append) (call append tuple))
    (return 3)
  )
  (fn-do _ add-table-constructors U32
    (param owner DeclId)
    (param class-name Atom)
    ; The table classes of core/table pick their generated constructor by argument type and
    ; count, so their rows carry named arguments and no type syntax; L4 evaluates the types.
    (if (!= name "core/table")
      (return 0)
    )
    (let this-name (call store-atom "This"))
    (if (== (. class-name text) "IndexSpan")
      (let source-name (call store-atom "source"))
      (let source-args (call named-args source-name null))
      (let source-kind (. DeclKind index-span-source-constructor-decl))
      (call (. member-pool append) (call append (call generated-function owner this-name source-kind source-args 1)))
      (let range-args (call named-args source-name (call store-atom "range")))
      (let range-kind (. DeclKind index-span-range-constructor-decl))
      (call (. member-pool append) (call append (call generated-function owner this-name range-kind range-args 2)))
      (return 2)
    )
    (if (!= (. class-name text) "Table")
      (return 0)
    )
    (let size-name (call store-atom "size"))
    (let arena-name (call store-atom "arena"))
    (let capacity-name (call store-atom "initial-capacity"))
    (let with-name (call store-atom "with"))
    (let count 0u32)
    (let size-args (call named-args size-name null))
    (let size (call generated-function owner this-name .table-size-constructor-decl size-args 1))
    (call (. member-pool append) (call append size))
    (+= count 1)
    (let filler-args (call named-args size-name with-name))
    (let filler (call generated-function owner this-name .table-filler-constructor-decl filler-args 2))
    (call (. member-pool append) (call append filler))
    (+= count 1)
    (let arena-args (call named-args arena-name null))
    (let arena (call generated-function owner this-name .table-arena-constructor-decl arena-args 1))
    (call (. member-pool append) (call append arena))
    (let capacity-args (call named-args arena-name capacity-name))
    (let capacity-kind (. DeclKind table-capacity-constructor-decl))
    (let capacity (call generated-function owner this-name capacity-kind capacity-args 2))
    (call (. member-pool append) (call append capacity))
    (+= count 2)
    (return count)
  )
  (fn-do _ named-args (of RowRange ArgumentShape)
    (param first Atom)
    (param second (? Atom))
    (let start (. arg-pool length))
    (call (. arg-pool append) (call ArgumentShape first 0 0 0 false .none false))
    (if second
      (call (. arg-pool append) (call ArgumentShape second 0 0 0 false .none false))
    )
    (return (call (of RowRange ArgumentShape) (as start U32) (if-expr second 2 1)))
  )
  (fn-expr _ generated-function FunctionDecl
    (param owner DeclId)
    (param name Atom)
    (param kind DeclKind)
    (param args (of RowRange ArgumentShape))
    (param required U32)
    (call FunctionDecl
      (block
        (arg 0)
        (arg name)
        (arg (call (of RowRange Atom)))
        (arg owner)
        (arg (. Access public-access))
        (arg kind)
        (arg args)
        (arg 0)
        (arg (call (of RowRange SyntaxId)))
        (arg (. CompilationEffect none))
        (arg false)
        (arg 0)
        (arg (call SyntaxRange 0 0))
        (arg (call (of RowRange SyntaxId)))
        (arg (call (of RowRange SyntaxId)))
        (arg (call (of RowRange SyntaxId)))
        (arg (. U32 max))
        (arg required)
        (arg true)
      )
    )
  )
  (fn-do _ add-extension DeclId
    (param tree AST)
    (param syntax SyntaxId)
    (param receiver SyntaxId)
    (param member-syntax (of RowRange SyntaxId))
    (param access Access)
    (param param-constraints (of RowRange SyntaxId))
    (param param-assignments (of RowRange SyntaxId))
    (param facet (? Atom) (= null))
    (let decl
      (call ExtensionDecl
        (block
          (arg syntax)
          (arg receiver)
          (arg (call (of RowRange DeclId)))
          (arg access)
          (arg param-constraints)
          (arg param-assignments)
          (arg facet)
          (arg (if-expr facet (call store-sees tree member-syntax) (call (of RowRange SyntaxId))))
          (arg (if-expr facet (call store-interfaces tree member-syntax) (call (of RowRange SyntaxId))))
        )
      )
    )
    (let id (call append decl))
    (let members (call scan-members tree member-syntax id))
    (if (!= written-content 0)
      (call keep-undeclared written-content 0)
    )
    (match? ([] decls id)
      (case (call .decl-extension row)
        (= (. row members) members)
      )
    )
    (return id)
  )
  (fn-do _ store-interfaces (of RowRange SyntaxId)
    (param tree AST)
    (param member-syntax (of RowRange SyntaxId))
    (throw (call Panic "Module syntax pool exceeds U32 capacity") (if (>= (. syntax-pool length) (. U32 max))))
    (blank)
    (let start (. syntax-pool length))
    (for (in member ([] (. tree nodes) ([] (. tree children) member-syntax)))
      (match? member
        (case (call .node-implements-declaration row)
          (call (. syntax-pool append) (. row type))
        )
      )
    )
    (return (call (of RowRange SyntaxId) (as start U32) (as (- (. syntax-pool length) start) U32)))
  )
  (fn-do _ store-sees (of RowRange SyntaxId)
    (param tree AST)
    (param member-syntax (of RowRange SyntaxId))
    ; The sibling facets a facet names with `sees`, in the order they are written.
    (throw (call Panic "Module syntax pool exceeds U32 capacity") (if (>= (. syntax-pool length) (. U32 max))))
    (blank)
    (let start (. syntax-pool length))
    (for (in member ([] (. tree nodes) ([] (. tree children) member-syntax)))
      (match? member
        (case (call .node-sees-declaration row)
          (call (. syntax-pool append) (. row type))
        )
      )
    )
    (return (call (of RowRange SyntaxId) (as start U32) (as (- (. syntax-pool length) start) U32)))
  )
  (fn-do _ store-delegations (of RowRange SyntaxId)
    (param tree AST)
    (param member-syntax (of RowRange SyntaxId))
    ; The types the properties of a class delegate, in the order they are written.
    (throw (call Panic "Module syntax pool exceeds U32 capacity") (if (>= (. syntax-pool length) (. U32 max))))
    (blank)
    (let start (. syntax-pool length))
    (for (in member ([] (. tree nodes) ([] (. tree children) member-syntax)))
      (match? member
        (case (call .node-delegate-declaration row)
          (for (in type ([] (. tree children) (. row types)))
            (call (. syntax-pool append) type)
          )
        )
      )
    )
    (return (call (of RowRange SyntaxId) (as start U32) (as (- (. syntax-pool length) start) U32)))
  )
  (fn-do _ scan-members (of RowRange DeclId)
    (param tree AST)
    (param member-syntax (of RowRange SyntaxId))
    (param owner DeclId)
    ; A member no row is made for is kept as one the module does not declare. The first section
    ; with markup written in it is left in `written-content`, and so is a class's `• This` that
    ; writes its markup (`defaults-content`), as the reference makes its lines the class's content.
    ; A second is kept as any other member, and so is a section with nothing written in it. The
    ; delegations written before a property or getter are all its own. A property of a class that
    ; holds a state machine has its flags before it (`add-machine-members`).
    (throw (call Panic "Module member pool exceeds U32 capacity") (if (>= (. member-pool length) (. U32 max))))
    (blank)
    (let start (. member-pool length))
    (= written-content 0)
    (= pending-delegates (call (of RowRange SyntaxId)))
    (for (in offset (..< 0 (. member-syntax count)))
      (let member-id ([] (. tree children) (+ (. member-syntax start) offset)))
      (match? ([] (. tree nodes) member-id)
        (case (call .node-delegate-declaration row)
          (call queue-delegates tree (. row types))
        )
      )
      (let member-decl (call scan-member tree member-id owner))
      (if (and (== member-decl 0) (not (call is-attached-syntax tree member-id)))
        (if (and (== written-content 0) (not (call (. tree is-empty-section) member-id)) is-markup)
          (= written-content member-id)
          (else
            (call keep-undeclared member-id (if-expr (is ([] decls owner) .decl-class) owner 0))
          )
        )
        (lazy is-markup (call is-markup-section tree member-id))
      )
      (if (!= member-decl 0)
        (if (is ([] decls owner) .decl-class)
          (call add-machine-members tree owner member-decl)
        )
        (call (. member-pool append) member-decl)
        (match? ([] decls member-decl)
          (case (call .decl-function fn)
            (if (and (== (. fn kind) .getter-decl) (!= (. pending-delegates count) 0))
              (= (. fn delegates) pending-delegates)
              (= pending-delegates (call (of RowRange SyntaxId)))
            )
          )
        )
        (if (and (== written-content 0) (is ([] decls owner) .decl-class) (call (. tree defaults-content) member-id))
          (= written-content member-id)
        )
      )
      (if (>= member-id next-syntax)
        (= next-syntax (+ member-id 1))
      )
    )
    (return (call (of RowRange DeclId) (as start U32) (as (- (. member-pool length) start) U32)))
  )
  (fn-do _ queue-delegates _
    (param tree AST)
    (param types (of RowRange SyntaxId))
    ; Adds the types of a delegation to those waiting for the next property or getter, kept in the
    ; syntax pool.
    (throw (call Panic "Module syntax pool exceeds U32 capacity") (if (>= (. syntax-pool length) (. U32 max))))
    (blank)
    (let start (. syntax-pool length))
    (if (== (+ (. pending-delegates start) (. pending-delegates count)) start)
      (= start (. pending-delegates start))
      (else
        (for (in offset (..< 0 (. pending-delegates count)))
          (call (. syntax-pool append) ([] syntax-pool (+ (. pending-delegates start) offset)))
        )
      )
    )
    (for (in type ([] (. tree children) types))
      (call (. syntax-pool append) type)
    )
    (= pending-delegates (call (of RowRange SyntaxId) (as start U32) (as (- (. syntax-pool length) start) U32)))
  )
  (fn-expr _ is-attached-syntax Bool
    (param tree AST)
    (param id SyntaxId)
    ; A member with no row of its own that is kept on another: the interfaces a type implements,
    ; and the types the next property or getter delegates to.
    (match ([] (. tree nodes) id)
      (case .node-implements-declaration
        true
      )
      (case .node-sees-declaration
        true
      )
      (case .node-delegate-declaration
        true
      )
      (default
        false
      )
    )
  )
  (fn-do _ is-markup-section Bool
    (param tree AST)
    (param id SyntaxId)
    ; A section of a type whose lines are markup: none of them declares anything but a lazy local
    ; the markup reads or a property the markup gives its value (`content-property`), and a state
    ; machine is written in it only as a line of its own, which the reference keeps on the object.
    (match? ([] (. tree nodes) id)
      (case (call .node-content-block row)
        (match? ([] (. tree nodes) (. row body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (if (call (. tree content-property) statement)
                (continue)
              )
              (if (call is-declaration-syntax tree statement)
                (return false)
              )
              (match? ([] (. tree nodes) statement)
                (case (call .node-declare declared)
                  (if (not (. declared is-lazy))
                    (return false)
                  )
                )
              )
              (if (and (not (is ([] (. tree nodes) statement) .node-state-machine)) is-writer)
                (return false)
              )
              (lazy is-writer (call writes-machine tree statement))
            )
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ writes-machine Bool
    (param tree AST)
    (param id SyntaxId)
    ; Whether a state machine is written in a node.
    (for (in node (.. (call (. tree subtree-start) id) id))
      (if (is ([] (. tree nodes) node) .node-state-machine)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ class-body-start SyntaxId
    (param tree AST)
    (param type-args (of RowRange SyntaxId))
    (param base SyntaxId)
    (param or-bases (of RowRange SyntaxId))
    (param constraints (of RowRange SyntaxId))
    (param assignments (of RowRange SyntaxId))
    (let last SyntaxId (- next-syntax 1))
    (if (and (== (. or-bases count) 0) (> base last))
      (= last base)
    )
    (for (in range (list type-args or-bases constraints assignments))
      (if (. range count)
        (let child ([] (. tree children) (- (+ (. range start) (. range count)) 1)))
        (if (> child last)
          (= last child)
        )
      )
    )
    (return (+ last 1))
  )
  (fn-do _ extension-body-start SyntaxId
    (param tree AST)
    (param receiver SyntaxId)
    (param as-types (of RowRange SyntaxId))
    (param constraints (of RowRange SyntaxId))
    (param assignments (of RowRange SyntaxId))
    (let last receiver)
    (if (. as-types count)
      (let child ([] (. tree children) (- (+ (. as-types start) (. as-types count)) 1)))
      (if (> child last)
        (= last child)
      )
    )
    (if (. constraints count)
      (let child ([] (. tree children) (- (+ (. constraints start) (. constraints count)) 1)))
      (if (> child last)
        (= last child)
      )
    )
    (if (. assignments count)
      (let child ([] (. tree children) (- (+ (. assignments start) (. assignments count)) 1)))
      (if (> child last)
        (= last child)
      )
    )
    (return (+ last 1))
  )
  (fn-do _ add-property DeclId
    (param tree AST)
    (param syntax SyntaxId)
    (param left SyntaxId)
    (param value SyntaxId)
    (param access Access)
    (param owner DeclId)
    (param is-lazy Bool)
    (param decoration (? Atom))
    (match? ([] (. tree nodes) left)
      (case (call .node-type-identifier ident)
        (return (call append (call AssociatedDecl syntax (. ident name) owner (call (of RowRange SyntaxId)) value access)))
      )
      (case (call .node-type-arguments args)
        (let base
          (match? ([] (. tree nodes) (. args base))
            (case (call .node-type-identifier ident)
              (. ident name)
            )
          )
        )
        (if base
          (return (call append (call AssociatedDecl syntax base owner (. args args) value access)))
        )
      )
    )
    (blank)
    (let parts (call capture-parts tree left))
    (let decl
      (call PropertyDecl
        (block
          (arg syntax)
          (arg (. parts name))
          (arg owner)
          (arg (. parts type-syntax))
          (arg value)
          (arg decoration)
          (arg access)
          (arg is-lazy)
          (arg pending-delegates)
        )
      )
    )
    (= pending-delegates (call (of RowRange SyntaxId)))
    (return (call append decl))
  )
  (fn-do _ store-arg-shapes StoredShapes
    (param tree AST)
    (param args (of RowRange SyntaxId))
    (throw (call Panic "Module argument pool exceeds U32 capacity") (if (>= (. arg-pool length) (. U32 max))))
    (blank)
    (let start (. arg-pool length))
    (let variadic-index (. U32 max))
    (let required 0u32)
    (for (in offset (..< 0 (. args count)))
      (let arg-id ([] (. tree children) (+ (. args start) offset)))
      (match ([] (. tree nodes) arg-id)
        (case (call .node-argument-decl arg)
          (let parts (call capture-parts tree (. arg pattern)))
          (let default (. arg default-value))
          (let pattern (. arg pattern))
          (let variadic (. arg is-variadic))
          (let type-syntax (. parts type-syntax))
          (let specificity (call type-specificity tree type-syntax))
          (let has-default (!= default 0))
          (if (and variadic (== variadic-index (. U32 max)))
            (= variadic-index offset)
          )
          (if (and (not has-default) (== variadic-index (. U32 max)))
            (+= required 1)
          )
          (call (. arg-pool append)
            (block
              (arg
                (call ArgumentShape
                  (block
                    (arg (. parts name))
                    (arg type-syntax)
                    (arg default)
                    (arg pattern)
                    (arg variadic)
                    (arg specificity)
                    (arg has-default)
                  )
                )
              )
            )
          )
        )
        (default
          (call (. arg-pool append) (call ArgumentShape null 0 0 arg-id false .none false))
        )
      )
    )
    (blank)
    (let range (call (of RowRange ArgumentShape) (as start U32) (as (- (. arg-pool length) start) U32)))
    (return (call StoredShapes range variadic-index required))
  )
  (fn-expr _ type-specificity Specificity
    (param tree AST)
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-type-match row)
        (match (. row op)
          (case .match-exactly
            .exact
          )
          (case .match-similar
            .similar
          )
          (case .match-convertible
            .convertible
          )
        )
      )
      (default
        (. Specificity none)
      )
    )
  )
  (fn-expr _ capture-parts CapturedName
    (param tree AST)
    (param id SyntaxId)
    (case? (== id 0)
      (call CapturedName null 0)
    )
    (default
      (match ([] (. tree nodes) id)
        (case (call .node-type-capture capture)
          (call CapturedName (call capture-identifier-name tree (. capture id)) (. capture type))
        )
        (case (call .node-identifier identifier)
          (call CapturedName (. identifier name) 0)
        )
        (default
          (call CapturedName null 0)
        )
      )
    )
  )
  (fn-expr _ capture-identifier-name (? Atom)
    (param tree AST)
    (param id SyntaxId)
    (case? (== id 0)
      null
    )
    (default
      (match? ([] (. tree nodes) id)
        (case (call .node-identifier identifier)
          (. identifier name)
        )
      )
    )
  )
)

(type + StoredShapes (is Tuple)
  (prop + range (of RowRange ArgumentShape))
  (prop + variadic-index U32)
  (prop + required-count U32)
)

(fn-expr _ function-kind DeclKind
  (param is-getter Bool)
  (param is-setter Bool)
  (case? is-getter
    (. DeclKind getter-decl)
  )
  (case? is-setter
    (. DeclKind setter-decl)
  )
  (default
    (. DeclKind function-decl)
  )
)

(fn-do _ new-decl-table (of Table Decl)
  (param arena Arena)
  (let decls (call (of Table Decl) arena 1))
  (call (. decls append) (call NoDecl 0))
  (return decls)
)

(type _ RowNames
  ; The names the row of each keyed markup loop reads tracked, as the reference gives them: the
  ; loop's item, by the name its header writes, `each` and `it`, and each declaration of the row's
  ; body, in order, that is lazy or whose value reads one of the names before it, which the
  ; reference reads again each time. Each loop's names hold in its body, from `starts` to
  ; `ends`, from its first in `firsts`.
  (blank)
  (prop _ starts (list SyntaxId))
  (prop _ ends (list SyntaxId))
  (prop _ firsts (list Size))
  (prop _ names (list String))
  (fn-do + add _
    (param tree AST)
    (param loop SyntaxId)
    (param body SyntaxId)
    (let first (. names length))
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (match? ([] (. tree nodes) (. row pattern))
          (case (call .node-type-capture capture)
            (match? ([] (. tree nodes) (. capture id))
              (case (call .node-identifier named)
                (+= names (. named name text))
              )
            )
          )
        )
      )
    )
    (+= names "each")
    (+= names "it")
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in line ([] (. tree children) (. block body)))
          (match? ([] (. tree nodes) line)
            (case (call .node-declare declared)
              (let plain
                (scope (and (not (. declared is-pattern)) (!= (. declared right) 0) holds-no-machine)
                  (lazy holds-no-machine (== (call (. tree declared-machine) (. declared right)) 0))
                )
              )
              (match? ([] (. tree nodes) (. declared left))
                (case (call .node-type-capture capture)
                  (match? ([] (. tree nodes) (. capture id))
                    (case (call .node-identifier named)
                      (if (and plain (or (. declared is-lazy) names-first))
                        (+= names (. named name text))
                      )
                      (lazy names-first (call names-in tree (. declared right) first))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (+= starts (call (. tree subtree-start) body))
    (+= ends body)
    (+= firsts first)
  )
  (fn-do _ names-in Bool
    (param tree AST)
    (param value SyntaxId)
    (param first Size)
    ; Whether a value reads one of the names from `first` on, functions written in it included.
    (for (in id (..< (call (. tree subtree-start) value) (+ value 1)))
      (match? ([] (. tree nodes) id)
        (case (call .node-identifier row)
          (for (in position (..< first (. names length)))
            (if (== ([] names position) (. row name text))
              (return true)
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + reads Bool
    (param id SyntaxId)
    (param name String)
    ; Whether a name read at a node is one a keyed markup loop's row reads tracked there.
    (for (in index (..< 0 (. starts length)))
      (if (and (<= ([] starts index) id) (<= id ([] ends index)))
        (let last (if-expr (< (+ index 1) (. firsts length)) ([] firsts (+ index 1)) (. names length)))
        (for (in position (..< ([] firsts index) last))
          (if (== ([] names position) name)
            (return true)
          )
        )
      )
    )
    (return false)
  )
)

(type _ Namings
  ; The declarations and assignments whose values are open while a tree is walked from its last
  ; node down, each with the nodes of its value.
  (blank)
  (prop + nodes (list SyntaxId))
  (prop _ starts (list SyntaxId))
  (prop _ ends (list SyntaxId))
  (fn-do + open _
    (param tree AST)
    (param id SyntaxId)
    ; Opens a node that is a declaration or an assignment with a value.
    (let value 0u32)
    (match? ([] (. tree nodes) id)
      (case (call .node-declare row)
        (= value (. row right))
      )
      (case (call .node-assign row)
        (= value (. row rhs))
      )
    )
    (if (== value 0)
      (return)
    )
    (+= nodes id)
    (+= starts (call (. tree subtree-start) value))
    (+= ends value)
  )
  (fn-do + close _
    (param id SyntaxId)
    ; Closes what the walk has gone below.
    (while (and (!= (. nodes length) 0) (< id ([] starts (- (. starts length) 1))))
      (call (. nodes pop))
      (call (. starts pop))
      (call (. ends pop))
    )
  )
  (fn-do + innermost SyntaxId
    (param id SyntaxId)
    (param floor Size)
    ; The innermost open one above `floor` whose value holds a node, or none.
    (let position (. nodes length))
    (while (> position floor)
      (-= position 1)
      (if (and (<= ([] starts position) id) (<= id ([] ends position)))
        (return ([] nodes position))
      )
    )
    (return 0)
  )
)
