        "/and/"
    |= .bitwise-or-op
        "/or/"
    |= .bitwise-xor-op
        "/xor/"
    |= .bitwise-lshift-op
        "/lshift/"
    |= .bitwise-rshift-op
        "/rshift/"
    |= .bitwise-zrshift-op
        "/zrshift/"
    |= .eq-op
        "="
    |= .write-all-op
        "<-*"
    |= .bind-op
        "<->"
    |= .index-get-op
        "[]"
    |= .index-assign-op
        "[]="
    |= .index-delete-op
        "-=[]"
    |= .coalesce-op
        "??"
    |= .if-op
        "if"
    |= .else-op
        "else"
    |= .map-op
        "*>"
    |= .filter-op
        "?>"
    |= .pipe-forward-op
        "|>"
    |= .pipe-closure-op
        "|=>"
    |= .pipe-repeat-op
        "*|>"
    |= .map-filter-op
        "?*>"
    |= .stream-pattern-pipe-op
        "~>"
    |= .pipe-write-each-op
        "*->"
    |= .pipe-write-all-op
        "->"
    |= .pipe-backward-op
        "<|"
    |= .as-op
        "as"
    |= .is-op
        "is"
    |= .is-not-op
        "is not"
    |= .is-exactly-op
        "is!"
    |= .is-not-exactly-op
        "is! not"
    |= .is-similar-op
        "is~"
    |= .is-not-similar-op
        "is~ not"
    |= .and-op
        "and"
    |= .or-op
        "or"
    |= .less-than-op
        "<"
    |= .greater-than-op
        ">"
    |= .less-than-equals-op
        "<="
    |= .greater-than-equals-op
        ">="
    |= .equals-op
        "=="
    |= .not-equals-op
        "!="
    |= .is-in-op
        "is in"
    |= .not-in-op
        "not in"
    |= .has-op
        "has"
    |= .has-not-op
        "has not"
    |= .compose-forward-op
        ">>"
    |= .compose-backward-op
        "<<"
    |= .write-op
        "<-write"
    |= .range-to-op
        ".."
    |= .range-through-op
        "thru"
    |= .pattern-ancestor-op
        "*\\"
    |= .pattern-parent-op
        "\\"
    |= .pattern-descendant-op
        "*/"
    |= .pattern-child-op
        "/"
    |= .pattern-prev-sibling-op
        "--"
    |= .pattern-next-sibling-op
        "++"
    |= .zero-or-one-op
        "?"
    |= .zero-or-more-op
        "*"
    |= .one-or-more-op
        "+"
    |= .positive-lookahead-op
        "&"
    |= .negative-lookahead-op
        "!"
    |= .add-eq-op
        "+="
    |= .subtract-eq-op
        "-="
    |= .multiply-eq-op
        "*="
    |= .divide-eq-op
        "/="
    |= .mod-eq-op
        "%="
    |= .pow-eq-op
        "%%="
    |= .concat-eq-op
        "++="
    ??
        ""

