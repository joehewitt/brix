────────────────────
+ to String

match this
    |= .multiply-op
        "*"
    |= .divide-op
        "/"
    |= .pow-op
        "%%"
    |= .mod-op
        "%"
    |= .add-op
        "+"
    |= .subtract-op
        "-"
    |= .concat-op
        "++"
    |= .concat-string-op
        "++"
    |= .not-op
        "!"
    |= .delete-op
        "-="
    |= .negative-op
        "-neg"
    |= .read-op
        "<-read"
    |= .type-of-op
        "type-of"
    |= .facts-of-op
        "facts-of"
    |= .bitwise-not-op
        "not"
    |= .optional-force-op
        "!"
