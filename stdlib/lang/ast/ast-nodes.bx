(import ./row-range)
(blank)
(import ./operator)
(import /core/parsing)
(blank)
(type-line + SyntaxId (is U32))

(type + Syntax (is Union)
  (variant node-noop ASTNoop)
  (variant node-top-level-syntax ASTTopLevel)
  (variant node-block ASTBlock)
  (variant node-print ASTPrint)
  (variant node-declare ASTDeclare)
  (variant node-assertion-syntax ASTAssertion)
  (variant node-class-block ASTClassBlock)
  (variant node-extension ASTExtension)
  (variant node-style-sheet-extension ASTStyleSheetExtension)
  (variant node-event-declaration ASTEventDeclaration)
  (variant node-function-syntax ASTFunction)
  (variant node-getter-syntax ASTGetter)
  (variant node-setter-syntax ASTSetter)
  (variant node-property-syntax ASTProperty)
  (variant node-state-machine ASTStateMachine)
  (variant node-state-case ASTStateCase)
  (variant node-state-continuation ASTStateContinuation)
  (variant node-state-fallback ASTStateFallback)
  (variant node-state-trigger ASTStateTrigger)
  (variant node-state-match-expression ASTStateMatchExpression)
  (variant node-unit-declaration ASTUnitDeclaration)
  (variant node-enum-declaration ASTEnumDeclaration)
  (variant node-delegate-declaration ASTDelegateDeclaration)
  (variant node-implements-declaration ASTImplementsDeclaration)
  (variant node-using-declaration ASTUsingDeclaration)
  (variant node-sees-declaration ASTSeesDeclaration)
  (variant node-style-domain-item ASTStyleDomainItem)
  (variant node-style-annotation ASTStyleAnnotation)
  (variant node-dependency-declaration ASTDependencyDeclaration)
  (variant node-content-block ASTContentBlock)
  (variant node-fromverter-syntax ASTFromverter)
  (variant node-converter-syntax ASTConverter)
  (variant node-subscriber-syntax ASTSubscriber)
  (variant node-when-rule-syntax ASTWhenRule)
  (variant node-rule-syntax ASTRule)
  (variant node-style-when ASTStyleWhen)
  (variant node-integer-syntax ASTInteger)
  (variant node-float-syntax ASTFloat)
  (variant node-string-syntax ASTString)
  (variant node-identifier ASTIdentifier)
  (variant node-ref-identifier ASTRefIdentifier)
  (variant node-symbol ASTSymbol)
  (variant node-anonymous-case ASTAnonymousCase)
  (variant node-decoration ASTDecoration)
  (variant node-c-identifier ASTCIdentifier)
  (variant node-use-expression ASTUseExpression)
  (variant node-latest-expression ASTLatestExpression)
  (variant node-header-expression ASTHeaderExpression)
  (variant node-pipeline-expression ASTPipelineExpression)
  (variant node-feed-expression ASTFeedExpression)
  (variant node-markup-head ASTMarkupHead)
  (variant node-markup-slot-parameter ASTMarkupSlotParameter)
  (variant node-markup ASTMarkup)
  (variant node-markup-slot-forward ASTMarkupSlotForward)
  (variant node-slot-outlet ASTSlotOutlet)
  (variant node-style-rule-application ASTStyleRuleApplication)
  (variant node-structure-match ASTStructureMatch)
  (variant node-type-identifier ASTTypeIdentifier)
  (variant node-type-arguments ASTTypeArguments)
  (variant node-type-associated ASTTypeAssociated)
  (variant node-type-optional ASTTypeOptional)
  (variant node-type-tuple ASTTypeTuple)
  (variant node-type-capture ASTTypeCapture)
  (variant node-type-predicate ASTTypePredicate)
  (variant node-type-equality ASTTypeEquality)
  (variant node-type-transform ASTTypeTransform)
  (variant node-type-panic ASTTypePanic)
  (variant node-type-and ASTTypeAnd)
  (variant node-type-or ASTTypeOr)
  (variant node-type-relation ASTTypeRelation)
  (variant node-type-match ASTTypeMatch)
  (variant node-type-wildcard ASTTypeWildcard)
  (variant node-type-remainder ASTTypeRemainder)
  (variant node-type-list ASTTypeList)
  (variant node-type-map ASTTypeMap)
  (variant node-type-map-item ASTTypeMapItem)
  (variant node-type-function ASTTypeFunction)
  (variant node-type-iterable ASTTypeIterable)
  (variant node-type-case ASTTypeCase)
  (variant node-type-property ASTTypeProperty)
  (variant node-type-numeric ASTTypeNumeric)
  (variant node-if-block ASTIfBlock)
  (variant node-while-block ASTWhileBlock)
  (variant node-for-block ASTForBlock)
  (variant node-do-block ASTDoBlock)
  (variant node-probe-statement ASTProbeStatement)
  (variant node-do-finally-block ASTDoFinallyBlock)
  (variant node-do-task-block ASTDoTaskBlock)
  (variant node-use-block ASTUseBlock)
  (variant node-stack-local-binding-block ASTStackLocalBindingBlock)
  (variant node-loop-syntax ASTLoop)
  (variant node-return ASTReturn)
  (variant node-return-if-true ASTReturnIfTrue)
  (variant node-yield ASTYield)
  (variant node-break ASTBreak)
  (variant node-continue ASTContinue)
  (variant node-catcher ASTCatcher)
  (variant node-unary-expression ASTUnaryExpression)
  (variant node-binary-expression ASTBinaryExpression)
  (variant node-held-expression ASTHeldExpression)
  (variant node-held-read ASTHeldRead)
  (variant node-cast-expression ASTCastExpression)
  (variant node-call-expression ASTCallExpression)
  (variant node-range-expression ASTRangeExpression)
  (variant node-get-expression ASTGetExpression)
  (variant node-style-read-expression ASTStyleReadExpression)
  (variant node-style-property-expression ASTStylePropertyExpression)
  (variant node-markup-read-expression ASTMarkupReadExpression)
  (variant node-index-expression ASTIndexExpression)
  (variant node-match-expression ASTMatchExpression)
  (variant node-pattern-helper-syntax ASTPatternHelper)
  (variant node-catch-optional-expression ASTCatchOptionalExpression)
  (variant node-catch-expression ASTCatchExpression)
  (variant node-tuple-syntax ASTTuple)
  (variant node-list-syntax ASTList)
  (variant node-iterable-expression ASTIterableExpression)
  (variant node-iterator-expression ASTIteratorExpression)
  (variant node-optional-chain ASTOptionalChain)
  (variant node-argument ASTArgument)
  (variant node-argument-decl ASTArgumentDecl)
  (variant node-import-syntax ASTImport)
  (variant node-assign ASTAssign)
  (variant node-clause ASTClause)
  (variant node-stream-match ASTStreamMatch)
  (variant node-stream-and ASTStreamAnd)
  (variant node-stream-or ASTStreamOr)
  (variant node-stream-transform ASTStreamTransform)
  (variant node-stream-panic ASTStreamPanic)
  (variant node-stream-type ASTStreamType)
  (variant node-stream-equality ASTStreamEquality)
  (variant node-stream-length ASTStreamLength)
  (variant node-stream-unary ASTStreamUnary)
  (variant node-stream-call ASTStreamCall)
  (variant node-stream-call-expression-argument ASTStreamCallExpressionArgument)
  (variant node-stream-collector-mapping ASTStreamCollectorMapping)
  (variant node-stream-predicate ASTStreamPredicate)
  (variant node-stream-capture ASTStreamCapture)
  (variant node-stream-char-range ASTStreamCharRange)
  (variant node-stream-string ASTStreamString)
  (variant node-stream-any ASTStreamAny)
  (variant node-probe ASTProbe)
  (variant node-probe-group ASTProbeGroup)
  (variant node-probe-assign ASTProbeAssign)
  (variant node-probe-counter ASTProbeCounter)
  (variant node-probe-snapshot ASTProbeSnapshot)
  (variant node-probe-preview ASTProbePreview)
  (variant node-param-constraint ASTParamConstraint)
  (variant node-param-assignment ASTParamAssignment)
  (blank)
  (variant node-whenever-rule-syntax ASTWheneverRule)
  (variant node-probe-scope ASTProbeScope)
  (variant node-core-type-identifier ASTCoreTypeIdentifier)
  (variant node-effect-declaration ASTEffectDeclaration)
)

(type + SyntaxNode (is Tuple)
  (prop + loc MatchLocation)
)

(type + ASTNoop (is SyntaxNode))

(type + ASTTopLevel (is SyntaxNode)
  (prop + statements (of RowRange SyntaxId))
)

(type + ASTExpression (is SyntaxNode))

(type + ASTDeclare (is SyntaxNode)
  (prop + left SyntaxId)
  (prop + right SyntaxId)
  (prop + is-lazy Bool)
  (prop + is-pattern Bool)
  (prop + rollback Bool)
  (prop + is-scoped Bool)
)

(type + ASTAssertion (is SyntaxNode)
  (prop + exception SyntaxId)
  (prop + condition SyntaxId)
)

(type + ASTClassBlock (is SyntaxNode)
  (prop + access Access)
  (prop + name Atom)
  (prop + type-args (of RowRange SyntaxId))
  (prop + aliases (of RowRange Atom))
  (prop + base SyntaxId)
  (prop + or-bases (of RowRange SyntaxId))
  (prop + members (of RowRange SyntaxId))
  (prop + param-constraints (of RowRange SyntaxId))
  (prop + param-assignments (of RowRange SyntaxId))
  (prop + is-style-sheet Bool)
  (prop + tags (of RowRange Atom) (= (call (of RowRange Atom))))
  (prop + facet-of SyntaxId (= 0))
)

(type + ASTExtension (is SyntaxNode)
  (prop + access Access)
  (prop + receiver SyntaxId)
  (prop + as-types (of RowRange SyntaxId))
  (prop + param-constraints (of RowRange SyntaxId))
  (prop + param-assignments (of RowRange SyntaxId))
  (prop + body (of RowRange SyntaxId))
)

(type + ASTStyleSheetExtension (is SyntaxNode)
  (prop + receiver SyntaxId)
  (prop + body (of RowRange SyntaxId))
)

(type + ASTEventDeclaration (is SyntaxNode)
  (prop + access Access)
  (prop + name Atom)
  (prop + type SyntaxId)
  (prop + key-type SyntaxId)
)

(type + ASTEffectDeclaration (is SyntaxNode)
  ; An effect a library declares, with the C functions it claims.
  (blank)
  (prop + access Access)
  (prop + name Atom)
  (prop + claims (of RowRange Atom))
)

(type + ASTProperty (is SyntaxNode)
  (prop + access Access)
  (prop + left SyntaxId)
  (prop + value SyntaxId)
  (prop + decoration (? Atom))
  (prop + is-lazy Bool)
  (prop + annotations (of RowRange Atom))
)

(type + ASTStateCase (is SyntaxNode)
  (prop + name Atom)
  (prop + target (of RowRange SyntaxId))
  (prop + trigger SyntaxId)
  (prop + body (of RowRange SyntaxId))
)

(type + ASTStateContinuation (is SyntaxNode)
  (prop + name Atom)
  (prop + target (of RowRange SyntaxId))
  (prop + trigger SyntaxId)
  (prop + body (of RowRange SyntaxId))
)

(type + ASTStateFallback (is SyntaxNode)
  (prop + target Atom)
  (prop + values (of RowRange SyntaxId))
)

(type + StateTriggerKind (is U8)
  (variant state-trigger-for-on-when)
  (variant state-trigger-for-on)
  (variant state-trigger-on-when)
  (variant state-trigger-on)
  (variant state-trigger-if-match)
  (variant state-trigger-if)
  (variant state-trigger-when-stream)
  (variant state-trigger-whenever)
)

(type + ASTStateTrigger (is SyntaxNode)
  (prop + kind StateTriggerKind)
  (prop + items (of RowRange SyntaxId))
)

(type + ASTStateMatchExpression (is ASTExpression)
  (prop + subject SyntaxId)
  (prop + pattern SyntaxId)
)

(type + ASTUnitDeclaration (is SyntaxNode)
  (prop + access Access)
  (prop + number SyntaxId)
  (prop + value SyntaxId)
)

(type + ASTEnumDeclaration (is SyntaxNode)
  (prop + name (? Atom))
  (prop + type SyntaxId)
  (prop + value SyntaxId)
)

(type + ASTDelegateDeclaration (is SyntaxNode)
  (prop + types (of RowRange SyntaxId))
)

(type + ASTImplementsDeclaration (is SyntaxNode)
  (prop + type SyntaxId)
)

(type + ASTUsingDeclaration (is SyntaxNode)
  (prop + type SyntaxId)
)

(type + ASTSeesDeclaration (is SyntaxNode)
  (prop + type SyntaxId)
)

(type + ASTStyleDomainItem (is SyntaxNode)
  (prop + domain SyntaxId)
  (prop + target SyntaxId)
)

(type + ASTStyleAnnotation (is SyntaxNode)
  (prop + left SyntaxId)
  (prop + domains (of RowRange SyntaxId))
)

(type + ASTDependencyDeclaration (is SyntaxNode)
  (prop + left SyntaxId)
  (prop + right (of RowRange SyntaxId))
)

(type + ASTContentBlock (is SyntaxNode)
  (prop + body SyntaxId)
)

(type + ASTFromverter (is SyntaxNode)
  (prop + access Access)
  (prop + type SyntaxId)
  (prop + body SyntaxId)
  (prop + imperative Bool)
)

(type + ASTConverter (is SyntaxNode)
  (prop + access Access)
  (prop + type SyntaxId)
  (prop + param-constraints (of RowRange SyntaxId))
  (prop + param-assignments (of RowRange SyntaxId))
  (prop + body SyntaxId)
  (prop + imperative Bool)
  (prop + compilation-effects CompilationEffect (= (. CompilationEffect none)))
  (prop + is-inline Bool (= false))
)

(type + ASTSubscriber (is SyntaxNode)
  (prop + iterator SyntaxId)
)

(type + ASTWhenRule (is SyntaxNode)
  (prop + expr SyntaxId)
  (prop + body SyntaxId)
)

(type + ASTWheneverRule (is SyntaxNode)
  (prop + kind Atom)
  (prop + target-type SyntaxId)
  (prop + expr SyntaxId)
  (prop + args (of RowRange SyntaxId))
  (prop + body SyntaxId)
)

(type + ASTRule (is SyntaxNode)
  (prop + name Atom)
  (prop + args (of RowRange SyntaxId))
  (prop + body SyntaxId)
  (prop + style-rule-applications (of RowRange SyntaxId))
  (prop + is-own Bool)
)

(type + ASTStyleWhen (is SyntaxNode)
  (prop + state Atom)
  (prop + body SyntaxId)
  (prop + is-negated Bool)
)

(type + ASTDecoration (is SyntaxNode)
  (prop + name Atom)
)

(type + ASTMarkupHead (is SyntaxNode)
  (prop + id SyntaxId)
  (prop + slot-binding SyntaxId)
)

(type + ASTMarkupSlotParameter (is SyntaxNode)
  (prop + name SyntaxId)
  (prop + type-id SyntaxId)
)

(type + ASTStyleRuleApplication (is SyntaxNode)
  (prop + name Atom)
  (prop + args (of RowRange SyntaxId))
  (prop + condition SyntaxId)
)

(type + ASTIfBlock (is SyntaxNode)
  (prop + condition SyntaxId)
  (prop + body SyntaxId)
  (prop + is-optional Bool)
  (prop + next SyntaxId)
)

(type + ASTWhileBlock (is SyntaxNode)
  (prop + condition SyntaxId)
  (prop + body SyntaxId)
  (prop + is-optional Bool)
)

(type + ASTForBlock (is SyntaxNode)
  (prop + loop SyntaxId)
  (prop + body SyntaxId)
  (prop + next SyntaxId)
)

(type + ASTDoBlock (is SyntaxNode)
  (prop + body SyntaxId)
  (prop + compilation-effects CompilationEffect)
  (prop + feature-gate-features CompilerFeature)
  (prop + holds-cancel Bool)
  (prop + bans (of RowRange Atom) (= (call (of RowRange Atom))))
)

(type + ASTProbeStatement (is SyntaxNode)
  (prop + body SyntaxId)
  (prop + object SyntaxId)
  (prop + key (? Atom))
)

(type + ASTDoFinallyBlock (is SyntaxNode)
  (prop + body SyntaxId)
)

(type + TaskSchedulingClass (is U8)
  (variant task-scheduling-normal)
  (variant task-scheduling-priority)
)

(type + ASTDoTaskBlock (is SyntaxNode)
  (prop + body SyntaxId)
  (prop + worker SyntaxId)
  (prop + is-parallel Bool)
  (prop + scheduling TaskSchedulingClass)
  (prop + large-stack Bool)
  (prop + catchers (of RowRange SyntaxId))
  (prop + detached Bool (= false))
)

(type + ASTUseBlock (is SyntaxNode)
  (prop + subject SyntaxId)
  (prop + body SyntaxId)
)

(type + ASTStackLocalBindingBlock (is SyntaxNode)
  (prop + name Atom)
  (prop + value SyntaxId)
  (prop + body SyntaxId)
)

(type + ASTLoop (is SyntaxNode)
  (prop + pattern SyntaxId)
  (prop + container SyntaxId)
  (prop + clause SyntaxId)
  (prop + is-subscriber Bool)
  (prop + is-match Bool)
  (prop + next SyntaxId)
)

(type + ASTReturn (is SyntaxNode)
  (prop + expr SyntaxId)
)

(type + ASTReturnIfTrue (is SyntaxNode)
  (prop + condition SyntaxId)
  (prop + expr SyntaxId)
)

(type + ASTYield (is SyntaxNode)
  (prop + expr SyntaxId)
  (prop + does-yield-all Bool)
)

(type + ASTBreak (is SyntaxNode))

(type + ASTContinue (is SyntaxNode))

(type + ASTCatcher (is SyntaxNode)
  (prop + body SyntaxId)
  (prop + type SyntaxId)
  (prop + previous (of RowRange SyntaxId))
)

(type + ASTPatternHelper (is SyntaxNode)
  (prop + helper SyntaxId)
)

(type + ASTArgument (is SyntaxNode)
  (prop + expr SyntaxId)
  (prop + name (? Atom))
  (prop + is-optional Bool)
)

(type + ASTArgumentDecl (is SyntaxNode)
  (prop + pattern SyntaxId)
  (prop + default-value SyntaxId)
  (prop + is-variadic Bool)
)

(type + ASTImport (is SyntaxNode)
  (prop + paths (of RowRange Atom))
  (prop + is-export Bool)
)

(type + ASTClause (is SyntaxNode)
  (prop + op ClauseOperator)
  (prop + expr SyntaxId)
  (prop + next SyntaxId)
)

(type + ASTStreamCallArgumentVariant (is SyntaxNode))

(type + ASTProbe (is SyntaxNode)
  (prop + object SyntaxId)
  (prop + name (? Atom))
  (prop + key (? Atom))
  (prop + content (of RowRange SyntaxId))
)

(type + ASTProbeGroup (is SyntaxNode)
  (prop + content (of RowRange SyntaxId))
  (prop + is-begin Bool)
  (prop + is-end Bool)
  (prop + is-data Bool)
  (prop + object SyntaxId)
  (prop + key (? Atom))
)

(type + ASTProbeAssign (is SyntaxNode)
  (prop + object SyntaxId)
  (prop + key Atom)
  (prop + content SyntaxId)
)

(type + ASTProbeCounter (is SyntaxNode)
  (prop + object SyntaxId)
  (prop + key Atom)
  (prop + delta SyntaxId)
)

(type + ASTParamConstraint (is SyntaxNode)
  (prop + op TypeMatchOperator)
  (prop + left SyntaxId)
  (prop + right SyntaxId)
)

(type + ASTParamAssignment (is SyntaxNode)
  (prop + left SyntaxId)
  (prop + right SyntaxId)
  (prop + is-specificity Bool)
)

(type + ASTBlock (is ASTExpression)
  (prop + body (of RowRange SyntaxId))
)

(type + ASTProbeScope (is SyntaxNode)
  (prop + body (of RowRange SyntaxId))
)

(type + ASTPrint (is ASTExpression)
  (prop + body SyntaxId)
)

(type + ASTFunction (is ASTExpression)
  (prop + access Access)
  (prop + names (of RowRange Atom))
  (prop + pattern SyntaxId)
  (prop + args (of RowRange SyntaxId))
  (prop + type-args (of RowRange SyntaxId))
  (prop + return-type SyntaxId)
  (prop + errors (of RowRange SyntaxId))
  (prop + param-constraints (of RowRange SyntaxId))
  (prop + param-assignments (of RowRange SyntaxId))
  (prop + body SyntaxId)
  (prop + compilation-effects CompilationEffect)
  (prop + imperative Bool)
  (prop + is-static Bool)
  (prop + rollback Bool)
  (prop + is-getter Bool)
  (prop + is-setter Bool)
  (prop + is-inline Bool)
  (prop + property-annotations (of RowRange Atom) (= (call (of RowRange Atom))))
  (prop + property-site SyntaxId (= 0))
  (prop + is-live Bool)
  (prop + is-no-return _ (= false))
  (prop + bans (of RowRange Atom) (= (call (of RowRange Atom))))
  (prop + door (? Atom) (= null))
)

(type + ASTStateMachine (is ASTExpression)
  (prop + body (of RowRange SyntaxId))
)

(type + ASTNumber (is ASTExpression)
  (prop + value String)
  (prop + unit (? Atom))
)

(type + ASTString (is ASTExpression)
  (prop + text String)
)

(type + ASTIdentifier (is ASTExpression)
  (prop + name Atom)
  (prop + is-tracked Bool)
)

(type + ASTRefIdentifier (is ASTExpression)
  (prop + name Atom)
)

(type + ASTSymbol (is ASTExpression)
  (prop + name Atom)
)

(type + ASTAnonymousCase (is ASTExpression)
  (prop + name Atom)
  (prop + args (of RowRange SyntaxId))
  (prop + owner (? Atom))
)

(type + ASTCIdentifier (is ASTExpression)
  (prop + name Atom)
