(type + CompilationEffect (is U32)
  (variant none (= 0))
  (variant no-heap (= 2))
  (variant no-safepoint (= 4))
  (variant no-probe-safepoint (= 8))
  (variant no-suspend (= 16))
  (variant gc-free (= 64))
  (variant gc-leaf (= 128))
  (variant gc-polling (= 256))
)

(type + EffectMask (is U64))

(fn-expr + most-effects Size
  ; How many effects a program can ban, each with a bit of a mask past those of the restrictions.
  32
)

(fn-expr + outside-name String
  "outside"
)

(fn-expr + ban-bit EffectMask
  (param effect U32)
  ; The bit of an effect's ban in a mask of restrictions and bans.
  (/lshift/ 1u64 (+ 16 (as effect U64)))
)

(fn-expr + ban-bits EffectMask
  0x0000FFFFFFFF0000
)

(fn-expr + swap-bits EffectMask
  ; The bits of a mask past the bans, which hold the number of the fakes bound where it is, among
  ; those a type pass interns (`Instances.swap-sets`), or 0 for none.
  (/lshift/ (. U64 max) 48)
)

(fn-expr + swap-set-of U32
  (param effects EffectMask)
  (as (/zrshift/ effects 48) U32)
)

(fn-expr + with-swap-set EffectMask
  (param effects EffectMask)
  (param set U32)
  (/or/ (/and/ effects 0x0000FFFFFFFFFFFF) (/lshift/ (as set U64) 48))
)

(fn-expr + restrictions-of U32
  (param effects EffectMask)
  ; The restrictions of a mask, without its bans and fakes, which change nothing a function compiles
  ; to.
  (as (/and/ effects 0x000000000000FFFF) U32)
)

(type + CompilerFeature (is U32)
  (variant none (= 0))
  (variant collection-observers (= 1))
)

(type + SyntaxRange (is Tuple)
  (prop + start SyntaxId)
  (prop + count U32)
)

(fn-expr + exclusive-end-location MatchLocation
  (param location MatchLocation)
  (call MatchLocation (. location begin) (call TokenLocation (. location end line) (+ (. location end column) 1)))
)

(fn-do + declares-within Bool
  (param declaring (list SyntaxId))
  (param range SyntaxRange)
  (let low 0)
  (let high (. declaring length))
  (while (< low high)
    (let middle (/ (+ low high) 2))
    (if (< ([] declaring middle) (. range start))
      (= low (+ middle 1))
      (else
        (= high middle)
      )
    )
  )
  (return (and (< low (. declaring length)) (< ([] declaring low) (+ (. range start) (. range count)))))
)
