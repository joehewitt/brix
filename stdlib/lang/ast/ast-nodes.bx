(type + ASTCallExpression (is ASTExpression)
  (prop + callable SyntaxId)
  (prop + operands (of RowRange SyntaxId))
  (prop + param-count U8)
  (prop + is-curried Bool)
  (fn-expr + params (of RowRange SyntaxId) :get @inline
    (call (of RowRange SyntaxId) (. operands start) param-count)
  )
  (fn-expr + args (of RowRange SyntaxId) :get @inline
    (call (of RowRange SyntaxId) (+ (. operands start) param-count) (- (. operands count) param-count))
  )
)

