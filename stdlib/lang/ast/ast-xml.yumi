+ extend ASTClassBlock

────────────────────
+ get xml XML

<XML "Class"
    • name name.text
    • access
    if alias-atoms.length
        • aliases ", ".join(each.text in alias-atoms)
    if tag-atoms.length
        • tags ", ".join(each.text in tag-atoms)
    child-xmls(type-args)
    if base
        <XML "Implements"
            • inherited true
            child-xml(base)
    if or-bases.count
        <XML "Or"
            child-xmls(or-bases)
    child-xmls(param-constraints)
    child-xmls(param-assignments)
    child-xmls(members)

.. alias-atoms = atoms-in(aliases)
.. tag-atoms = atoms-in(tags)

