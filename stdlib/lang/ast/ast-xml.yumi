━━━━━━━━━━━━━━━━━━━━
+ extend ASTDoBlock

────────────────────
+ get xml XML

<XML "Do"
    if compilation-effects
        • effects format-compilation-effect-mask(compilation-effects)
    if feature-gate-features
        • features "feature-collection-observers"
    child-xml(body)

━━━━━━━━━━━━━━━━━━━━
_ do format-compilation-effect-mask String
    - effects CompilationEffect

. visible = match effects /and/ CompilationEffect.gc-free
    |= CompilationEffect.none
        effects
    ??
        effects - (effects /and/ (CompilationEffect.no-heap /or/ CompilationEffect.no-safepoint))
visible = match effects /and/ CompilationEffect.no-safepoint
    |= CompilationEffect.none
        visible
    ??
        visible - (visible /and/ CompilationEffect.no-suspend)
. names = ArrayBuilder'String()
for index in 0 .. < 5
    . effect, name = match index
        |= 0
            (CompilationEffect.gc-free, "no-gc")
        |= 1
            (CompilationEffect.no-heap, "no-heap")
        |= 2
            (CompilationEffect.no-safepoint, "no-safepoint")
        |= 3
            (CompilationEffect.no-probe-safepoint, "no-probe-safepoint")
        ??
            (CompilationEffect.no-suspend, "no-suspend")
    if (visible /and/ effect) != CompilationEffect.none
        names.append(name)
= ",".join(names.finish-immutable())

