./ast-builder
./ast-nodes
./row-range
/core/array-builder
/lang/xmlwriter
/stream/aggregate

_ @stack syntax-xml-tree ASTBuilder

━━━━━━━━━━━━━━━━━━━━
+ extend ASTBuilder

────────────────────
+ do syntax-xml XML
    - id SyntaxId

do with syntax-xml-tree = this
    = syntax-xml-tree.nodes[id].xml

────────────────────
+ view XML
    - id SyntaxId

syntax-xml(id)

────────────────────
+ get xml XML

syntax-xml(root)

────────────────────
+ to XML

xml

────────────────────
+ to String

xml

━━━━━━━━━━━━━━━━━━━━
_ child-xml XML?
    - id SyntaxId

syntax-xml-tree.nodes[id].xml if id != 0

━━━━━━━━━━━━━━━━━━━━
_ do child-xmls ImmutableArray'XML?
    - range RowRange'SyntaxId

=? if range.count == 0

. builder = ArrayBuilder'XML()
for syntax-node in syntax-xml-tree.nodes[syntax-xml-tree.child-ids(range)]
    . xml = syntax-node.xml
    if xml.node-name || xml.children.length
        builder.append(xml)
= builder.finish-immutable()

━━━━━━━━━━━━━━━━━━━━
_ do atoms-in ImmutableArray'Atom
    - range RowRange'Atom

. builder = ArrayBuilder'Atom()
for offset in 0 .. < range.count
    builder.append(syntax-xml-tree.atoms[range.start + offset])
= builder.finish-immutable()

━━━━━━━━━━━━━━━━━━━━
_ syntax-type-name String
    - id SyntaxId

match syntax-xml-tree.nodes[id]
    | .node-type-identifier(type)
        type.name.text
    | .node-core-type-identifier(type)
        type.name.text
    | .node-type-arguments(type)
        "${syntax-type-name(type.base)}$suffix"
        .. suffix = if type.args.count then "'${argument-names}" else ""
        .. argument-names = "'".join(syntax-type-name(each) in argument-ids)
            .. argument-ids = syntax-xml-tree.child-ids(type.args)
    | .node-type-associated(type)
        "${syntax-type-name(type.owner)}.${type.name.text}$suffix"
        .. suffix = if type.args.count then "'${argument-names}" else ""
        .. argument-names = "'".join(syntax-type-name(each) in argument-ids)
            .. argument-ids = syntax-xml-tree.child-ids(type.args)
    ?! Panic("Expected a named type syntax node")

━━━━━━━━━━━━━━━━━━━━
_ do probe-object (String?, XML?)
    - id SyntaxId

=? (null, null) if !id
. object-name String?
. object-child XML?
do match syntax-xml-tree.nodes[id]
    | .node-identifier(row)
        object-name = row.name.text
    ??
        object-child = <XML "Object"
            child-xml(id)
= (object-name, object-child)

