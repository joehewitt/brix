━━━━━━━━━━━━━━━━━━━━
+ extend ASTRule

────────────────────
+ do get xml XML

.. style-rule-applications-xml = child-xmls(style-rule-applications)
. params = ArrayBuilder'XML()
for offset in 0 .. < args.count
    . id = syntax-xml-tree.children[args.start + offset]
    . argument = match syntax-xml-tree.nodes[id]
        | .node-argument-decl(row)
            row
        ?! Panic("Expected a style rule argument")
    . param = match syntax-xml-tree.nodes[argument.pattern]
        | .node-type-capture(capture)
            <XML "Param"
                • name rule-parameter-name(capture.id)
                |? capture.type
                    child-xml(capture.type)
                ??
                    child-xml(argument.pattern)
        ??
            <XML "Param"
                child-xml(argument.pattern)
    params.append(param)

= <XML "StyleRule"
    • name name.text
    •? own is-own
    params.finish-immutable()
    if style-rule-applications-xml
        <XML "StyleRuleApplications"
            style-rule-applications-xml
    child-xml(body)

━━━━━━━━━━━━━━━━━━━━
_ rule-parameter-name String
    - id SyntaxId

match syntax-xml-tree.nodes[id]
    | .node-identifier(row)
        row.name.text
    ?! Panic("Expected a style rule parameter name")

