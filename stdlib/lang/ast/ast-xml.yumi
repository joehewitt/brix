━━━━━━━━━━━━━━━━━━━━
+ extend ASTFunction

────────────────────
+ get xml XML

<XML "Function"
    • names ", ".join(each.text in atoms-in(names))
    • access
    if is-getter
        • getter true
    else if is-setter
        • setter true
    •? imperative
    if is-static
        • ("static") true
    if compilation-effects
        • effects format-compilation-effect-mask(compilation-effects)
    if is-inline
        • ("inline") true
    if is-live
        • ("live") true
    if is-no-return
        • ("no-return") true
    •? rollback
    if pattern
        <XML "pattern"
            child-xml(pattern)
    child-xmls(type-args)
    child-xmls(args)
    child-xmls(param-constraints)
    child-xmls(param-assignments)
    child-xml(return-type)
    if errors.count
        <XML "errors"
            child-xmls(errors)
    child-xml(body)

