(import /os/file)
(import /os/path)
(import /stream/sort)
(blank)
(prop _ snapshot-format _ (= "brix-c-headers 1"))

(type + CHeaderSnapshot
  ; The records of the C headers one build read for a target, each under the name `snapshot-key`
  ; gives its header, and where the target's C library headers were. A build reads a snapshot's
  ; records in place of scanning the headers, so a host without the target's SDK reads them as the
  ; host that took the snapshot did.
  (blank)
  (prop + target-name String)
  (prop + c-root Path)
  (prop _ headers (map String String))
  (prop _ lock _ (= (call Mutex)))
  (fn-do + This _
    (param target-name _)
    (param c-root _)
  )
  (fn-do + has Bool
    (param key (? String))
    (use lock)
    (return (and (!= key null) (!= ([] headers key) null)))
  )
  (fn-do + records (? String)
    (param key (? String))
    (use lock)
    (return-if null (if (not key)))
    (return ([] headers key))
  )
  (fn-do + keep _
    (param key String)
    (param records String)
    (use lock)
    (= ([] headers key) records)
  )
  (fn-do + write _ (?! Error)
    (param path Path)
    ; Writes the snapshot at `path`: a line naming the format, the target, and the directory its C
    ; library headers were in, then for each header, by name, a line of its name and the length of
    ; its records, and the records.
    (use lock)
    (let parts (list String))
    (+= parts snapshot-format)
    (+= parts (str "target " target-name))
    (+= parts (str "root " c-root))
    (for (in key (call sort (. headers keys)))
      (let records (!! ([] headers key)))
      (+= parts (str "header " key " " (. records size)))
      (+= parts records)
    )
    (call write-file-atomically path (str (call (. "\n" join) parts) "\n"))
  )
)

(fn-do + read-c-header-snapshot CHeaderSnapshot (?! Error)
  (param path Path)
  ; The snapshot that `CHeaderSnapshot.write` wrote at `path`.
  (let text (catch? (call read-file-text path)))
  (throw (call Error (str "Unable to read the C header snapshot " path)) (if (not text)))
  (let reader (call SnapshotReader (call byte-view text)))
  (let target (only-if (call (. reader field) "target") (if (== (call (. reader line)) snapshot-format))))
  (let root (call (. reader field) "root"))
  (throw (call Error (str path " is not a C header snapshot")) (if (or (not target) (not root))))
  (let snapshot (call CHeaderSnapshot target (call Path root)))
  (while (. reader has-more)
    (let named (call (. reader field) "header"))
    (let space (call (?. named find-reverse) " "))
    (throw (call Error (str path " has a header line that names no length")) (if (or (not named) (not space))))
    (let length (call Int ([] named (... (+ space 1)))))
    (let records (call (. reader take) length))
    (throw (call Error (str path " ends inside the records of " ([] named (..< 0 space)))) (if (not records)))
    (call (. snapshot keep) ([] named (..< 0 space)) records)
  )
  (return snapshot)
)

(type _ SnapshotReader
  ; Reads a snapshot's lines, and the records that follow a header's line by their length.
  (blank)
  (prop _ bytes (of ImmutableArray Byte))
  (prop _ cursor Index)
  (fn-do + This _
    (param bytes _)
  )
  (fn-expr + has-more Bool :get
    (< cursor (. bytes length))
  )
  (fn-do + line (? String)
    (return-if null (if (>= cursor (. bytes length))))
    (let data (as bytes (of CPointer Byte)))
    (let end cursor)
    (while (and (< end (. bytes length)) (!= ([] data end) 10))
      (+= end 1)
    )
    (let found (call (. bytes slice-string) (..< cursor end)))
    (= cursor (+ end 1))
    (return found)
  )
  (fn-do + field (? String)
    (param name String)
    (let found (call line))
    (let prefix (str name " "))
    (return-if null (if (or (not found) (not (call (. found starts-with) prefix)))))
    (return ([] found (... (. prefix length))))
  )
  (fn-do + take (? String)
    (param length Index)
    (return-if null (if (> (+ cursor length) (. bytes length))))
    (let found (call (. bytes slice-string) (..< cursor (+ cursor length))))
    (+= cursor (+ length 1))
    (return found)
  )
)
