./error
/core/parsing

+ reserved-words = ["in", "on", "and", "or", "do", "for", "while", "if", "else"]
+ preposition-words = ["about", "after", "at", "before", "between", "both", "by", "during", "despite", "except", "every", "from", "into", "like", "near", "of", "onto", "over", "since", "through", "toward", "to", "using", "whenever", "when", "where", "within", "without", "with", "unless", "unlike", "until", "via"]
+ header-words = ["if", "else", "while", "match", "for"]

━━━━━━━━━━━━━━━━━━━━
+ syntax-advice String
    - source String
    - spot TokenLocation

|? line.char(line.indent) == '#'
    "Comments start with a backtick (`), not \"#\""
|? surrogate
    "\"$surrogate\" is half of a surrogate pair, which is no character by itself; write the character itself in the text"
|? lead == "return"
    "Brix has no \"return\"; in a do function, return a value with \"= value\""
|? lead == "let" || lead == "var" || lead == "const" || lead == "val"
    "Declare a local with \". name = value\", not \"$lead\""
|? lead == "def" || lead == "fn" || lead == "func" || lead == "function"
    "Declare a function after a thick divider (━) as \"+ name ReturnType\", with each parameter on an indented \"- name Type\" line"
|? line.char(column) == ';'
    "A line needs no \";\"; remove it"
|? line.prints-value(column)
    "A print is a step and gives no value; print on a line of its own, or after \":\" as a one-step body"
|? line.opens-brace(column)
    "Blocks are written by indentation, not braces; remove \"{\" and \"}\" and indent the body below the line"
|? line.char(column) == '\\' && line.inside-embed(column)
    "Inside \"\${...}\", write quotes without a backslash, as in \"\${name.find(\"a\")}\""
|? declared.length != 0 && reserved-words.find(declared) != null
    "\"$declared\" is a reserved word and cannot be a name; choose another name"
|? owned && header-words.find(lead) != null
    "\"$lead\" owns the block below it, so \"• $owned\" at the end of its line cannot take that block; finish the argument on this line, or compute it in a local above"
|? label == "where" && lead == "for"
    "A loop has no \"where\" clause; filter its items with \"when\", as in \"for x in items when x > 2\""
|? label
    "\"$label\" cannot follow an expression; a call takes its arguments in parentheses, as in \"sort(keys)\", and a callback after a bullet, as in \"some(items) • where each > 2\""
|? cast
    "A cast cannot be followed by an operator; wrap it in parentheses, as in \"(${cast} as ${line.type-before(column)}) ${line.operator-at(column)} ${line.operand-after(column)}\""
|? line.binds-before(column)
    "The place of \"<->\" is a name or a chain of members, written without \"#\", as in \"value <-> settings.volume\""
|? is-camel(camel)
    "Names are kebab-case; write \"${kebab(camel)}\", not \"$camel\""
|? power
    power
|? spaced
    "An operator needs a space on each side; write \"${spaced}\""
|? stacked
    "A part of a pattern takes one of ?, * or +, not \"$stacked\"; to repeat a repeated part, wrap it in parentheses first"
|? ending == "(" || ending == "["
    "An expression ends at the end of its line, so this \"${ending!}\" is never closed; write it on one line, or give a call its arguments on indented \"- value\" lines below it"
|? ending == "{"
    "An expression ends at the end of its line, so this \"${ending!}\" is never closed; write it on one line"
|? ending
    "An expression ends at the end of its line, so nothing follows this \"${ending}\"; write the whole expression on one line"
|? line.indent == 0 && line.chars.length != 0 && !line.starts-declaration() && previous.starts-with("━")
    "A divider starts a declaration, so a statement cannot follow it; put module-level statements above the first divider"
|? untyped
    "An event names the type of what it carries, as in \"+ event ${untyped} String\""
|? signed
    signed
|? line.starts-declaration() && previous.length != 0 && !previous.starts-with("━") && !previous.starts-with("─")
    "A declaration with a body needs a divider line above it: a thick divider (━) at module level, or a thin divider (─) for a member of a type"
|? header
    "\"${header}\" needs a divider line above it: a thick divider (━) at module level, or a thin divider (─) for a member of a type"
??
    "Syntax error"

.. line = SourceLine(source, spot.line)
.. surrogate = line.surrogate-escape()
.. column = spot.column as Index
.. lead = line.leading-word()
.. declared = line.declared-name()
.. owned = line.trailing-label()
.. label = line.label-after-expression(column)
.. cast = line.cast-before(column)
.. camel = if is-camel(line.word-around(column)) then line.word-around(column) else declared
.. spaced = line.unspaced-operator(column)
.. power = line.power-advice(column)
.. previous = previous-code(source, spot.line)
.. ending = line.dangling-end(column)
.. stacked = line.stacked-repeat(column)
.. header = undivided-header(source, spot.line)
.. untyped = untyped-event(source, spot.line)
.. signed = signed-unit(source, spot.line)

━━━━━━━━━━━━━━━━━━━━
_ do signed-unit String?
    - source String
    - line U32

` The advice for a unit a line declares from a signed amount of another, as in
` "+ Bar (bar) is -1foo" (`signed-unit-advice`).
. lines [String]
for text in source.split("\n")
    lines += text
=? null if line as Index >= lines.length
. words [String]
for word in lines[line as Index].trim().split(" ")
    words += word
=? null if words.length != 5 || words[3] != "is"
=? null if words[0] != "+" && words[0] != "_"
=? null if !words[2].starts-with("(") || !words[2].ends-with(")")
=? null if !words[4].starts-with("-") && !words[4].starts-with("(-")
. suffix = words[2][1 .. < words[2].length - 1]
. amount = ""
for char in words[4]
    if char != '(' && char != ')'
        amount += "$char"
= signed-unit-advice(words[0], words[1], suffix, amount)

━━━━━━━━━━━━━━━━━━━━
_ do untyped-event String?
    - source String
    - line U32

` The name of an event a line declares with no type, as in "+ event rang".
. lines [String]
for text in source.split("\n")
    lines += text
=? null if line as Index >= lines.length
. words [String]
for word in lines[line as Index].trim().split(" ")
    words += word
=? null if words.length != 3 || words[1] != "event"
=? null if words[0] != "+" && words[0] != "_"
= words[2]

━━━━━━━━━━━━━━━━━━━━
_ do undivided-header String?
    - source String
    - line U32

. lines [String]
for text in source.split("\n")
    lines += text
. position = line as Index
=? null if position >= lines.length
. current = lines[position]
. code = current.trim()
=? null if code.length == 0 || code.starts-with("+ ") || code.starts-with("_ ")
=? null if current.starts-with(" ") && !code.starts-with("- ")
while position > 0
    position -= 1
    . text = lines[position]
    . trimmed = text.trim()
    if trimmed.length == 0 || trimmed.starts-with("`") || (text.starts-with(" ") && trimmed.starts-with("- "))
        continue
    =? null if !(trimmed.starts-with("+ ") || trimmed.starts-with("_ ")) || trimmed.find(" = ") != null || trimmed.find(" := ") != null
    . above = previous-code(source, position as U32)
    =? null if above.length == 0 || above.starts-with("━") || above.starts-with("─")
    = trimmed
= null

━━━━━━━━━━━━━━━━━━━━
_ do previous-code String
    - source String
    - line U32

. lines [String]
for text in source.split("\n")
    lines += text
. position = line as Index
while position > 0
    position -= 1
    . text = if position < lines.length then lines[position].trim() else ""
    if text.length != 0 && !text.starts-with("`")
        = text
= ""

━━━━━━━━━━━━━━━━━━━━
+ is-camel Bool
    - word String

word.length > 1 && word[0 .. < 1] >= "a" && word[0 .. < 1] <= "z" && has-camel-step(word)

━━━━━━━━━━━━━━━━━━━━
_ do has-camel-step Bool
    - word String

. previous = 0 as Char
for char in word
    if char >= 'A' && char <= 'Z' && previous >= 'a' && previous <= 'z'
        = true
    previous = char
= false

━━━━━━━━━━━━━━━━━━━━
_ do kebab String
    - word String

. text = ""
for char in word
    if char >= 'A' && char <= 'Z'
        text += "-"
        text += char.lowercase
    else
        text += char
= text

━━━━━━━━━━━━━━━━━━━━
_ is-surrogate-digit Bool
    - char Char

(char >= '8' && char <= '9') || (char >= 'a' && char <= 'f') || (char >= 'A' && char <= 'F')

━━━━━━━━━━━━━━━━━━━━
_ is-name-char Bool
    - char Char

is-letter || (char >= '0' && char <= '9') || char == '-' || char == '_' || char == '\''

.. is-letter = (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z')

━━━━━━━━━━━━━━━━━━━━
_ is-word-char Bool
    - char Char

is-name-char(char) && char != '\''

━━━━━━━━━━━━━━━━━━━━
_ is-operator-char Bool
    - char Char

char == '+' || char == '*' || char == '/' || char == '%' || char == '<' || char == '>' || char == '=' || char == '-' || char == '&' || char == '|'

━━━━━━━━━━━━━━━━━━━━
+ SourceLine

+ chars [Char]
+ indent Index = 0

────────────────────
+ This
    - source String
    - line U32

. current = 0u32
for char in source
    if char == '\n'
        if current == line
            break
        current += 1
    else if current == line
        chars += char
while indent < chars.length && chars[indent] == ' '
    indent += 1

────────────────────
+ char Char
    - spot Index

if spot < chars.length then chars[spot] else 0 as Char

────────────────────
+ do text String
    - start Index
    - end Index

. written = ""
for spot in start .. < end
    if spot < chars.length
        written += chars[spot]
= written

────────────────────
+ do binds-before Bool
    - column Index

. found = text(0, chars.length).find(" <-> ")
= found != null && (found as Index) < column

────────────────────
+ do surrogate-escape String?

` The first escape on the line that writes half of a surrogate pair, from "\uD800" to "\uDFFF".
for spot in 0 .. < chars.length
    if char(spot) == '\\' && char(spot + 1) == 'u' && (char(spot + 2) == 'd' || char(spot + 2) == 'D')
        if is-surrogate-digit(char(spot + 3)) && (spot == 0 || char(spot - 1) != '\\')
            = text(spot, spot + 6)
= null

────────────────────
+ do word-from String
    - start Index

. end = start
while end < chars.length && is-name-char(chars[end])
    end += 1
= text(start, end)

────────────────────
+ leading-word String

word-from(indent)

────────────────────
+ do declared-name String

. rest = text(indent, chars.length)
for prefix in [".. ", ". ", "- ", "for ", "+ do ", "_ do ", "+ get ", "+ set ", "+ ", "_ "]
    if rest.starts-with(prefix)
        = word-from(indent + prefix.length)
= ""

────────────────────
+ starts-declaration Bool

rest.starts-with("+ ") || rest.starts-with("_ ")

.. rest = text(indent, chars.length)

────────────────────
+ opens-brace Bool
    - spot Index

|? char(spot) == '{'
    spot == 0 || char(spot - 1) != '$'
??
    last != Index.max && chars[last] == '{' && spot >= last && (last == 0 || chars[last - 1] != '$')

.. last = last-visible()

────────────────────
+ do inside-embed Bool
    - spot Index

. depth = 0
for position in 0 .. < spot
    if position + 1 < chars.length && chars[position] == '$' && chars[position + 1] == '{'
        depth += 1
    else if chars[position] == '}' && depth > 0
        depth -= 1
= depth > 0

────────────────────
+ do label-after-expression String?
    - spot Index

. start = if spot < chars.length then spot else chars.length
while start < chars.length && chars[start] == ' '
    start += 1
. word = word-from(start)
=? null if preposition-words.find(word) == null || char(start + word.length) != ' '
. before = previous-visible(start)
=? null if before == Index.max || before < indent
. last = chars[before]
=? null if !(is-name-char(last) || last == ')' || last == ']' || last == '"')
= word

────────────────────
+ trailing-label String?

|? last == Index.max
    null
|? word.length == 0 || last + 1 < word.length + 2
    null
|? mark == Index.max || chars[mark] != '•'
    null
??
    word

.. last = last-visible()
.. word = word-ending(last)
.. mark = previous-visible(last + 1 - word.length)

────────────────────
+ do last-visible Index

. spot = chars.length
while spot > 0
    spot -= 1
    if chars[spot] != ' '
        = spot
= Index.max

────────────────────
+ do word-around String
    - spot Index

. start = if spot < chars.length then spot else chars.length
while start > 0 && is-word-char(chars[start - 1])
    start -= 1
. end = start
while end < chars.length && is-word-char(chars[end])
    end += 1
= text(start, end)

────────────────────
+ do previous-visible Index
    - spot Index

. position = if spot < chars.length then spot else chars.length
while position > 0
    position -= 1
    if chars[position] != ' '
        = position
= Index.max

────────────────────
+ prints-value Bool
    - spot Index

|? last == Index.max
    false
??
    mark - 1 > indent && chars[mark] == '-' && chars[mark - 1] == '-'

.. last = previous-visible(spot)
.. mark = if chars[last] == '?' then last - 1 else last

────────────────────
+ do word-ending String
    - spot Index

. start = spot + 1
while start > 0 && is-name-char(chars[start - 1])
    start -= 1
= text(start, spot + 1)

────────────────────
+ type-before String
    - spot Index

if last == Index.max then "" else word-ending(last)

.. last = previous-visible(spot)

────────────────────
+ cast-before String?
    - spot Index

|? !is-operator-char(char(spot))
    null
|? type-end == Index.max || !is-name-char(chars[type-end])
    null
|? type-name.length == 0 || type-name[0 .. < 1] < "A" || type-name[0 .. < 1] > "Z"
    null
|? as-end == Index.max || word-ending(as-end) != "as"
    null
|? value-end == Index.max || !is-name-char(chars[value-end])
    "x"
??
    word-ending(value-end)

.. type-end = previous-visible(spot)
.. type-name = word-ending(type-end)
.. as-end = previous-visible(type-end + 1 - type-name.length)
.. value-end = previous-visible(as-end - 1)

────────────────────
+ do operator-at String
    - spot Index

. end = spot
while end < chars.length && is-operator-char(chars[end])
    end += 1
= text(spot, end)

────────────────────
+ do operand-after String
    - spot Index

. end = spot
while end < chars.length && is-operator-char(chars[end])
    end += 1
while end < chars.length && chars[end] == ' '
    end += 1
. word = word-from(end)
= if word.length != 0 then word else "..."

────────────────────
+ unspaced-operator String?
    - spot Index

|? op.length == 0 || spot == 0
    null
|? !(is-name-char(left) || left == ')' || left == ']')
    null
|? op.starts-with("-") && op != "-="
    null
|? left-word.length != 0 && left-word[0 .. < 1] >= "0" && left-word[0 .. < 1] <= "9"
    null
|? right-word.length == 0 && char(rest-start) != ' '
    null
??
    "$left-word $op ${if right-word.length != 0 then right-word.trim() else "..."}"

.. op = operator-at(spot)
.. left = chars[spot - 1]
.. left-word = word-ending(spot - 1)
.. rest-start = spot + op.length
.. right-word = word-from(rest-start)

────────────────────
+ power-advice String?
    - spot Index

|? char(spot) == '^' && spot > indent
    "Raise to a power with \"a %% b\"; for the bits set in one but not the other, write \"a /xor/ b\""
|? char(spot) != '*' || (char(spot + 1) != '*' && (spot == 0 || char(spot - 1) != '*'))
    null
|? char(spot + 1) == '=' || char(spot + 2) == '='
    "Raise in place with \"x %%= b\""
??
    "Raise to a power with \"a %% b\""

────────────────────
+ stacked-repeat String?
    - spot Index

` Two repeats written together on a pattern's part, ending at a spot, as in "a"+*.
|? spot == 0 || !repeat(char(spot)) || !repeat(char(spot - 1)) || text(0, chars.length).find("~") == null
    null
??
    "${char(spot - 1)}${char(spot)}"

────────────────────
_ repeat Bool
    - c Char

c == '?' || c == '*' || c == '+'

────────────────────
+ dangling-end String?
    - spot Index

|? last == Index.max || spot < last
    null
|? ending == '[' || ending == '(' || ending == '{' || ending == ',' || ending == '+' || ending == '*' || ending == '/' || ending == '='
    "$ending"
|? word == "and" || word == "or"
    word
??
    null

.. last = last-visible()
.. ending = chars[last]
.. word = word-ending(last)
