./ast
./ast-children
./ast-nodes
./operator
./row-range

━━━━━━━━━━━━━━━━━━━━
+ SlotHosts

` The classes whose markup, or that of a class above them, holds the default slot outlet, as the
` parsed modules of a program write them, and the names each module knows such a class by. The
` module builder must know, before any type is known, which line of a markup element's body gives
` the default slot its content, since a function of its own builds it. A module knows a name for a
` class it declares, or where it declares none of that name, for a public class of a module it can
` name: a builtin module, one it imports, or one such a module exports in turn.

+ builtin-paths [String]
_ paths [String]
_ path-ids [String = Index]
_ classes [String]
_ class-modules [Index]
_ publics [Bool]
_ bases [String]
_ holders [Bool]
_ hosts [Bool]
_ first-named [String = Index]
_ next-named [Index]
_ edge-froms [String]
_ edge-tos [String]
_ edge-exports [Bool]
_ visible [Bool]

────────────────────
+ do scan
    - tree AST
    - path String

` Notes each class a module's tree declares, by its name and each alias, with whether it is
` public, the name of the type it derives from and whether the markup it writes holds the default
` slot outlet.
. module = module-of(path)
for id in 1u32 .. < tree.root + 1
    match? tree.nodes[id]
        | .node-class-block(row)
            . base = head-name(tree, row.base)
            . public = row.access == .public-access
            . holds = false
            for member in tree.children[row.members]
                match? tree.nodes[member]
                    | .node-content-block(content)
                        for node in tree.subtree-start(content.body) .. < content.body
                            match? tree.nodes[node]
                                | .node-slot-outlet(outlet)
                                    if outlet.name == 0
                                        holds = true
            note(row.name.text, module, public, base, holds)
            for offset in 0 .. < row.aliases.count
                note(tree.atoms[row.aliases.start + offset].text, module, public, base, holds)

────────────────────
+ do add-import
    - importer String
    - imported String
    - is-export Bool

` Notes that a module imports another, and whether it exports it.
edge-froms += importer
edge-tos += imported
edge-exports += is-export

────────────────────
+ do settle

` Finds the modules each module can name, then the classes that hold the default slot outlet, and
` each that derives from such a class by a name its module knows for one, until no more are.
. total = paths.length
visible.clear()
for _ in 0 .. < total * total
    visible += false
. builtins [Index]
for builtin in builtin-paths
    . found = path-ids[builtin]
    if found
        builtins += found
. importers [Index]
. importeds [Index]
for edge in 0 .. < edge-froms.length
    importers += path-ids[edge-froms[edge]] ?? Index.max
    importeds += path-ids[edge-tos[edge]] ?? Index.max
. starts [Index]
. targets [Index]
. exported [Bool]
for module in 0 .. < total
    starts += targets.length
    for builtin in builtins
        if builtin != module
            targets += builtin
            exported += false
    for edge in 0 .. < importers.length
        if importers[edge] == module && importeds[edge] != Index.max
            targets += importeds[edge]
            exported += edge-exports[edge]
starts += targets.length
for module in 0 .. < total
    visible[module * total + module] = true
    reach(module * total, module, true, starts, targets, exported)
hosts.clear()
for holds in holders
    hosts += holds
. grew = true
while grew
    grew = false
    for position in 0 .. < classes.length
        if !hosts[position] && bases[position].length != 0 && has-known-host
            hosts[position] = true
            grew = true
        .. has-known-host = knows-host(bases[position], class-modules[position])

────────────────────
+ do names-for [String]
    - path String

` The names a module knows for classes that hold the default slot outlet.
. names [String]
. found = path-ids[path]
if !found
    = names
for position in 0 .. < classes.length
    . name = classes[position]
    if hosts[position] && names.find(name) == null && knows-host(name, found)
        names += name
= names

────────────────────
_ do module-of Index
    - path String

. found = path-ids[path]
if found
    = found
. module = paths.length
paths += path
path-ids[path] = module
= module

────────────────────
_ do note
    - name String
    - module Index
    - public Bool
    - base String
    - holds Bool

. position = classes.length
classes += name
class-modules += module
publics += public
bases += base
holders += holds
. first = first-named[name]
next-named += if first then first else Index.max
first-named[name] = position

────────────────────
_ do reach
    - row Index
    - module Index
    - all Bool
    - starts [Index]
    - targets [Index]
    - exported [Bool]

` Marks in a module's row each module another it reaches imports and has not been marked: every
` import of the module itself, and only those each module it reaches exports.
for position in starts[module] .. < starts[module + 1]
    . target = targets[position]
    if (all || exported[position]) && !visible[row + target]
        visible[row + target] = true
        reach(row, target, false, starts, targets, exported)

────────────────────
_ do knows-host Bool
    - name String
    - module Index

` Whether the class a module knows by a name holds the default slot outlet: one it declares by
` that name decides, and otherwise any public one of a module it can name.
. total = paths.length
. found = false
. position = first-named[name] ?? Index.max
while position != Index.max
    . owner = class-modules[position]
    if owner == module
        = hosts[position]
    if publics[position] && visible[module * total + owner] && hosts[position]
        found = true
    position = next-named[position]
= found

━━━━━━━━━━━━━━━━━━━━
+ head-name String
    - tree AST
    - id SyntaxId

` The name a type is written with, past its arguments, or the empty text where it is written
` some other way or not at all.
match tree.nodes[id]
    | .node-type-identifier(row)
        row.name.text
    | .node-identifier(row)
        row.name.text
    | .node-type-arguments(row)
        head-name(tree, row.base)
    ??
        ""
