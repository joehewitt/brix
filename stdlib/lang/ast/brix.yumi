./ast-builder
./ast-nodes
./brix-catalog
./brix-check
./brix-heads
./error
./grammar-helpers
./operator
./row-range
/core/arena
/core/array-builder
/core/parsing
/data/sexp
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ do parse-brix ASTBuilder ?! YumiSyntaxError
    - source String
    - source-path = ""

. scratch = use Arena()
= parse-brix(source, source-path, scratch)

━━━━━━━━━━━━━━━━━━━━
+ do parse-brix ASTBuilder ?! YumiSyntaxError
    - source String
    - source-path String
    - scratch Arena

= brix-tree(source, source-path, scratch)
    catch error YumiSyntaxError
        error.attach-source(source, source-path)
        ?! error

━━━━━━━━━━━━━━━━━━━━
_ do brix-tree ASTBuilder ?! YumiSyntaxError
    - source String
    - source-path String
    - scratch Arena

do finally
    scratch.reset()
. tape = brix-tape(source, scratch)
. heads = brix-form-heads(tape, scratch)
. checker = BrixChecker(brix-catalog, tape, heads)
checker.check()
if checker.issues.length != 0
    . issue = checker.issues[0]
    . place = tape.token-location(issue.index)
    ?! YumiSyntaxError(MatchLocation(place, place), checker.message(issue))
= brix-reduced(source, source-path, tape, heads, scratch)

━━━━━━━━━━━━━━━━━━━━
_ do brix-reduced ASTBuilder ?! YumiSyntaxError
    - source String
    - source-path String
    - tape SexpTape
    - heads Array'U8'ArenaBacking
    - scratch Arena

. tree = ASTBuilder(source, source-path)
tree.pattern-collector-context = scratch
do finally
    tree.pattern-collector-context = tree.storage-arena
. succeeded = false
do finally
    if !succeeded
        tree.release()

. reducer = BrixReducer(tape, heads, tree)
. statements = reducer.top-level()
. root = tree.append
    - ASTTopLevel(reducer.whole-location(), tree.store-children(link-statements(tree, statements)))
tree.name-closures()
tree.finalize-syntax()
succeeded = true
tree.root = root
= tree

━━━━━━━━━━━━━━━━━━━━
_ do brix-tape SexpTape ?! YumiSyntaxError
    - source String
    - scratch Arena

. bytes = byte-view(source)
. tape = sexp-tape(source, scratch, false)
    catch error SexpError
        ?! YumiSyntaxError(brix-place(bytes, error.offset), brix-message(error.message, error.hint))
. dollar = tape.first-dollar
if dollar
    ?! YumiSyntaxError(brix-place(bytes, dollar), "Unescaped “\$” in Brix text. Write “\\\$” for a dollar sign, or build the text from its parts with (str …).")
= tape

━━━━━━━━━━━━━━━━━━━━
_ brix-place MatchLocation
    - bytes Byte[]
    - offset Index

MatchLocation(place, place)

.. place = sexp-location(bytes, offset)

━━━━━━━━━━━━━━━━━━━━
+ BrixReport is Tuple

+ place TokenLocation
+ text String

━━━━━━━━━━━━━━━━━━━━
+ do brix-reports [BrixReport]
    - source String

. scratch = use Arena()
. tape = brix-tape(source, scratch)
    catch failure YumiSyntaxError
        = List'BrixReport(BrixReport(failure.loc.begin, failure.message))
. heads = brix-form-heads(tape, scratch)
. checker = BrixChecker(brix-catalog, tape, heads)
checker.check()
=? List(BrixReport(tape.token-location(each.index), checker.message(each)) in checker.issues) if checker.issues.length != 0
. tree = brix-reduced(source, "", tape, heads, scratch)
    catch failure YumiSyntaxError
        = List'BrixReport(BrixReport(failure.loc.begin, failure.message))
tree.release()
= List'BrixReport()

━━━━━━━━━━━━━━━━━━━━
_ brix-message String
    - text String
    - hint String?

if hint then "$text. $hint" else text

━━━━━━━━━━━━━━━━━━━━
_ BrixReducer

_ tape SexpTape
_ tree ASTBuilder
_ bytes Byte[]
_ heads Array'U8'ArenaBacking

────────────────────
+ This
    - tape
    - heads
    - tree

.. bytes = tape.bytes

────────────────────
+ whole-location MatchLocation

|? tape.length == 0
    MatchLocation(begin, begin)
??
    MatchLocation(begin, tape.location(bytes.length - 1))

.. begin = TokenLocation(0, 0)

────────────────────
+ do top-level ImmutableArray'SyntaxId ?! YumiSyntaxError

. capacity Size = 0
. index Index = 0
while index < tape.length
    capacity += if head(index) == .main-head then count-from(index + 2, tape.close-of(index)) else 1
    index = tape.after(index)
. items = scratch-array'SyntaxId(tree, capacity)
. count Size = 0
index = 0
while index < tape.length
    if head(index) == .main-head
        . close = tape.close-of(index)
        . row = index + 2
        while row < close
            . made = statement(row)
            if made
                items[count] = made
                count += 1
            row = tape.after(row)
    else
        . made = top-statement(index)
        if made
            items[count] = made
            count += 1
    index = tape.after(index)
= scratch-items(items, count)

────────────────────
_ do top-statement SyntaxId? ?! YumiSyntaxError
    - index Index

. kind = head(index)
do match? kind
    |= .blank-head
        = null
    |= .import-head
        = import(index, false)
    |= .export-head
        = import(index, true)
    |= .fn-do-head
        = callable(index)
    |= .fn-expr-head
        = callable(index)
    |= .type-head
        = class-block(index)
    |= .type-line-head
        = class-block(index)
    |= .extend-head
        = extension(index)
    |= .extend-line-head
        = extension(index)
    |= .style-head
        = style-sheet(index)
    |= .style-extend-head
        = style-sheet(index)
= member(index)

────────────────────
_ do import SyntaxId
    - index Index
    - is-export Bool

. begin = begin-at(index)
. path = index + 2
. first = tape.start(path)
. last = tape.end(path)
. count Size = 0
for offset in first .. < last
    if bytes[offset] == 47
        count += 1
if bytes[first] != 47
    count += 1
. names = scratch-array'Atom(tree, count)
. filled Size = 0
. segment = first
if bytes[first] == 47
    segment = first + 1
for offset in segment .. < last
    if bytes[offset] == 47
        names[filled] = tree.atom-bytes(bytes, segment, offset)
        filled += 1
        segment = offset + 1
names[filled] = tree.atom-bytes(bytes, segment, last)
filled += 1
. loc = located(begin, index)
= tree.append(ASTImport(loc, tree.store-atoms(scratch-items(names, filled)), is-export))

────────────────────
_ do callable SyntaxId ?! YumiSyntaxError
    - index Index

=? getter(index) if has-role(index, ":get")
=? setter(index) if has-role(index, ":set")
= function(index)

────────────────────
_ do has-role Bool
    - index Index
    - role String

. close = tape.close-of(index)
. item = tape.after(tape.after(tape.after(index + 2)))
while item < close && tape.is-atom(item)
    =? true if atom-is(item, role)
    item = tape.after(item)
= false

────────────────────
_ do function SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. access-index = index + 2
. key-index = tape.after(access-index)
. result-index = tape.after(key-index)
. access = access-at(access-index)
. header = tape.after(result-index)
. pattern-type SyntaxId? = null
if header < close && head(header) == .over-label-head
    pattern-type = reduce-type(header + 2)
    header = tape.after(header)
. first-header = header
. annotation-count Size = 0
. error-count Size = 0
. variant-count Size = 0
. is-imperative = head(index) == .fn-do-head
. is-static = false
while header < close && is-header-item(header)
    if tape.is-atom(header)
        if bytes[tape.start(header)] == 64
            annotation-count += 1
        else if atom-is(header, ":static")
            is-static = true
    else if head(header) == .raises-head
        error-count += 1
    else if head(header) == .door-head
        annotation-count += 1
    else if !is-scope(header)
        variant-count += 1
    header = tape.after(header)
. key = function-key(key-index, result-index, pattern-type)
. annotations = scratch-array'Atom(tree, annotation-count)
. errors = scratch-array'SyntaxId(tree, error-count)
. variants = scratch-array'ArgumentVariant(tree, variant-count)
. annotation-filled Size = 0
. error-filled Size = 0
. variant-filled Size = 0
. item = first-header
while item < header
    if tape.is-atom(item)
        if bytes[tape.start(item)] == 64
            annotations[annotation-filled] = annotation-at(item)
            annotation-filled += 1
    else if head(item) == .raises-head
        errors[error-filled] = reduce-type(item + 2)
        error-filled += 1
    else if head(item) == .door-head
        annotations[annotation-filled] = door-annotation(tree, atom-at(item + 2, 0))
        annotation-filled += 1
    else if !is-scope(item)
        variants[variant-filled] = variant(item)
        variant-filled += 1
    item = tape.after(item)
. loc = located(begin, index)
. sections = scope-of(first-header, header)
. body = sectioned-body(tree, loc, sections, is-imperative, function-body(header, close))
. stream-item = tree.atom("StreamItem")
= placed
    - make-function
        - tree
        - loc
        - access
        - is-imperative
        - is-static
        - key
        - scratch-items(errors, error-filled)
        - section-annotations(tree, loc, scratch-items(annotations, annotation-filled), sections, false)
        - stream-item
        - scratch-items(variants, variant-filled)
        - body
    - loc

────────────────────
_ do function-body SyntaxId? ?! YumiSyntaxError
    - first Index
    - close Index

=? null if first >= close
. size Size = 0
. index = first
while index < close
    size += if is-section(index) then count-from(index + 2, tape.close-of(index)) else 1
    index = tape.after(index)
. items = scratch-array'SyntaxId(tree, size)
. count Size = 0
index = first
while index < close
    . is-split = is-section(index)
    . row = if is-split then index + 2 else index
    . end = if is-split then tape.close-of(index) else tape.after(index)
    while row < end
        . made = statement(row)
        if made
            items[count] = made
            count += 1
        row = tape.after(row)
    index = tape.after(index)
= block-with-statements(tree, scratch-items(items, count))

────────────────────
_ is-section Bool
    - index Index

head(index) == .before-head || head(index) == .where-head

────────────────────
_ is-header-item Bool
    - index Index

|? tape.is-atom(index)
    lead == 64 || (lead == 58 && tape.end(index) - tape.start(index) > 1)
??
    kind == .raises-head || kind == .param-head || kind == .constraint-head || kind == .iterates-head || kind == .door-head || is-scope(index)

.. lead = bytes[tape.start(index)]
.. kind = head(index)

────────────────────
_ do variant ArgumentVariant ?! YumiSyntaxError
    - index Index

. kind = head(index)
=? ArgumentVariant.argument-decl(parameter(index)) if kind == .param-head
=? iterator-header(index) if kind == .iterates-head
= constraint(index)

────────────────────
_ do iterator-header ArgumentVariant ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. word = index + 2
. container = expression(tape.after(word))
. loc = located(begin, index)
= ArgumentVariant.iterator-header
    - loc
    - tree.append(ASTLoop(loc, 0, container, 0, atom-is(word, "on"), false, 0))

────────────────────
_ do constraint ArgumentVariant ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. op = index + 2
. left = tape.after(op)
. right = tape.after(left)
if atom-is(op, "=") || atom-is(op, "=~")
    . assigned-left = reduce-type(left)
    . assigned-right = expression(right)
    = ArgumentVariant.param-assignment
        - tree.append
            - ASTParamAssignment
                - located(begin, index)
                - assigned-left
                - assigned-right
                - atom-is(op, "=~")
. match-op = if atom-is(op, "is!") then TypeMatchOperator.match-exactly else if atom-is(op, "is~") then TypeMatchOperator.match-similar else TypeMatchOperator.match-convertible
. constrained = reduce-type(left)
. bound = reduce-type(right)
= ArgumentVariant.param-constraint
    - tree.append(ASTParamConstraint(located(begin, index), match-op, constrained, bound))

────────────────────
_ do parameter SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. item = index + 2
. is-variadic = false
if tape.is-atom(item) && atom-is(item, "...")
    is-variadic = true
    item = tape.after(item)
. name = item
. type = tape.after(name)
. fallback = tape.after(type)
. type-id SyntaxId = 0
if atom-is(name, "_")
    type-id = reduce-type(type)
else
    . id = identifier(name)
    . captured SyntaxId = 0
    if type < close && !atom-is(type, "_")
        captured = reduce-type(type)
    type-id = tree.append(ASTTypeCapture(located(begin, name), id, captured))
. default SyntaxId = 0
if fallback < close
    default = expression(fallback + 2)
= tree.append(ASTArgumentDecl(located(begin, index), type-id, default, is-variadic))

────────────────────
_ do function-key FunctionKey ?! YumiSyntaxError
    - key Index
    - result Index
    - pattern-type SyntaxId?

. returns SyntaxId? = null
if !atom-is(result, "_")
    returns = reduce-type(result)
. kind = head(key)
do match? kind
    |= .infix-head
        . left = key + 2
        . op = tape.after(left)
        . names = function-names(left, infix-name(op))
        = FunctionKey
            - names
            - function-type-args(left)
            - returns
            - null
            - sequence-singleton(tree, parameter(tape.after(op)))
    |= .index-get-head
        . left = key + 2
        = FunctionKey
            - function-names(left, "[]")
            - function-type-args(left)
            - returns
            - null
            - sequence-singleton(tree, parameter(tape.after(left)))
    |= .index-set-head
        . left = key + 2
        . index-param = parameter(tape.after(left))
        . value-param = parameter(tape.after(tape.after(left)))
        = FunctionKey
            - function-names(left, "[]=")
            - function-type-args(left)
            - null
            - null
            - sequence-pair(tree, index-param, value-param)
    |= .index-delete-head
        . left = key + 2
        = FunctionKey
            - function-names(left, "-=[]")
            - function-type-args(left)
            - null
            - null
            - sequence-singleton(tree, parameter(tape.after(left)))
    |= .prefix-head
        . op = key + 2
        . left = tape.after(op)
        = FunctionKey
            - function-names(left, prefix-name(op))
            - function-type-args(left)
            - returns
            - null
            - ImmutableArray'SyntaxId()
. names = function-names(key, null)
. chosen = if names.length == 0 then sequence-singleton(tree, tree.atom("()")) else names
= FunctionKey(chosen, function-type-args(key), returns, pattern-type)

────────────────────
_ do function-names ImmutableArray'Atom ?! YumiSyntaxError
    - key Index
    - suffix String?

. named = if head(key) == .of-head then key + 2 else key
. first = tape.start(named)
. last = tape.end(named)
. extra = if suffix then 1 else 0
if atom-is(named, "this")
    . names = scratch-array'Atom(tree, extra)
    if suffix
        names[0] = tree.atom(suffix)
    = scratch-items(names, extra)
if atom-is(named, "This")
    . names = scratch-array'Atom(tree, 1 + extra)
    names[0] = tree.atom("This")
    if suffix
        names[1] = tree.atom(suffix)
    = scratch-items(names, 1 + extra)
if last - first > 2 && bytes[first] == 67 && bytes[first + 1] == 58
    . symbol = c-declaration-name
        - tree
        - located(begin-at(named), named)
        - tree.atom-bytes(bytes, first + 2, last)
    =? symbol if !suffix
    = sequence-appending(tree, symbol, tree.atom(suffix))
. count Size = 1 + extra
for offset in first .. < last
    if bytes[offset] == 46
        count += 1
. names = scratch-array'Atom(tree, count)
. filled Size = 0
. segment = first
for offset in first .. < last
    if bytes[offset] == 46
        names[filled] = tree.atom-bytes(bytes, segment, offset)
        filled += 1
        segment = offset + 1
names[filled] = tree.atom-bytes(bytes, segment, last)
filled += 1
if suffix
    names[filled] = tree.atom(suffix)
    filled += 1
= scratch-items(names, filled)

────────────────────
_ do function-type-args ImmutableArray'SyntaxId ?! YumiSyntaxError
    - key Index

=? ImmutableArray'SyntaxId() if head(key) != .of-head
= type-arguments(tape.after(key + 2), tape.close-of(key))

────────────────────
_ infix-name String
    - op Index

|? kind == .write-head
    "<-write"
|? brix-binary-operator(kind) != .no-op
    brix-binary-operator(kind) as String
??
    brix-assign-operator(kind) as String

.. kind = brix-head(bytes, tape.start(op), tape.end(op))

────────────────────
_ prefix-name String
    - op Index

brix-prefix-operator(brix-head(bytes, tape.start(op), tape.end(op))) as String

────────────────────
_ do property SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. access-index = index + 2
. name = tape.after(access-index)
. type = tape.after(name)
. access = access-at(access-index)
. left SyntaxId = 0
if atom-is(name, "_")
    left = reduce-type(type)
else
    . id = identifier(name)
    . captured SyntaxId = 0
    if !atom-is(type, "_")
        captured = reduce-type(type)
    left = tree.append(ASTTypeCapture(located(begin, type), id, captured))
. decoration-count Size = 0
. item = tape.after(type)
while item < close && tape.is-atom(item) && bytes[tape.start(item)] == 64
    decoration-count += 1
    item = tape.after(item)
. decorations = scratch-array'SyntaxId(tree, decoration-count)
. filled Size = 0
. decoration = tape.after(type)
while decoration < item
    . decoration-begin = begin-at(decoration)
    decorations[filled] = tree.append
        - ASTDecoration(located(decoration-begin, decoration), atom-at(decoration, 1))
    filled += 1
    decoration = tape.after(decoration)
. loc = located(begin, index)
if item < close && head(item) == .machine-head
    . stored = tree.store-property-decorations(scratch-items(decorations, filled))
    . machine = multi(item)
    = tree.append
        - ASTProperty(loc, access, left, machine, stored.decoration, false, stored.annotations)
. value PropertyAssignmentParts? = null
if item < close
    value = property-value(item)
= make-property-declaration(tree, loc, access, scratch-items(decorations, filled), left, value)

────────────────────
_ do property-value PropertyAssignmentParts ?! YumiSyntaxError
    - index Index

. kind = head(index)
do match? kind
    |= .block-head
        = PropertyAssignmentParts(.property-assignment-immediate, multi(index), false)
    |= .assign-head
        = PropertyAssignmentParts(.property-assignment-immediate, multi(index + 2), false)
    |= .lazy-assign-head
        = PropertyAssignmentParts(.property-assignment-lazy, multi(index + 2), false)
    |= .closure-head
        . value = index + 2
        . is-imperative = atom-is(value, ":do")
        . expr = if is-imperative then tape.after(value) else value
        = PropertyAssignmentParts(.property-assignment-getter, multi(expr), is-imperative)
?! unsupported-error(index)

────────────────────
_ do class-block SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. access-index = index + 2
. named = tape.after(access-index)
. access = access-at(access-index)
. is-applied = head(named) == .of-head
. name = atom-at(if is-applied then named + 2 else named, 0)
. type-args = if is-applied then type-arguments(named + 3, tape.close-of(named)) else empty-args
    .. empty-args = ImmutableArray'SyntaxId()
. item = tape.after(named)
. aliases ImmutableArray'Atom? = null
if item < close && head(item) == .alias-head
    aliases = listed-names(item)
    item = tape.after(item)
. facet-of SyntaxId = 0
if item < close && head(item) == .facet-of-head
    facet-of = reduce-type(item + 2)
    item = tape.after(item)
. inherits ImmutableArray'SyntaxId? = null
if item < close && head(item) == .is-head
    inherits = class-bases(item + 2, tape.close-of(item))
    signed-base(access, name, aliases, inherits)
    item = tape.after(item)
. first-member = item
. header-count Size = 0
. member-count Size = 0
while item < close
    if is-class-header-item(item)
        header-count += 1
    else
        member-count += 1
    item = tape.after(item)
. variants = scratch-array'ArgumentVariant(tree, header-count)
. members = scratch-array'SyntaxId(tree, member-count)
. header-filled Size = 0
. member-filled Size = 0
item = first-member
while item < close
    if is-class-header-item(item)
        variants[header-filled] = class-header-item(item)
        header-filled += 1
    else
        . made = member(item)
        if made
            members[member-filled] = made
            member-filled += 1
    item = tape.after(item)
. loc = located(begin, index)
. header = ClassHeader
    - loc
    - access
    - name
    - type-args
    - aliases
    - inherits
    - scratch-items(variants, header-filled)
    - facet-of
= placed(make-class-declaration(tree, loc, header, scratch-items(members, member-filled)), loc)

────────────────────
_ do signed-base ?! YumiSyntaxError
    - access Access
    - name Atom
    - aliases ImmutableArray'Atom?
    - bases ImmutableArray'SyntaxId

` Rejects a unit declared from a signed amount of another, as in `(is -1foo)`, which rows can't
` write either (`signed-unit-advice`).
for base in bases
    do match? tree.nodes[base]
        | .node-type-numeric(numeric)
            . amount = signed-amount(numeric.value)
            if amount
                . lead = access-text(access)
                . suffix String? = if aliases && aliases.length != 0 then aliases[0].text else null
                ?! YumiSyntaxError(tree.nodes.loc[numeric.value], signed-unit-advice(lead, name.text, suffix, amount))

────────────────────
_ signed-amount String?
    - id SyntaxId

` A number in a unit written with a sign, as `-1foo` is, or none.
match tree.nodes[id]
    | .node-integer-syntax(row)
        if row.unit && row.value.starts-with("-") then "${row.value}${row.unit.text}" else null
    | .node-float-syntax(row)
        if row.unit && row.value.starts-with("-") then "${row.value}${row.unit.text}" else null
    ??
        null

────────────────────
_ do listed-names ImmutableArray'Atom
    - index Index

. close = tape.close-of(index)
. names = scratch-array'Atom(tree, count-from(index + 2, close))
. filled Size = 0
. item = index + 2
while item < close
    names[filled] = atom-at(item, 0)
    filled += 1
    item = tape.after(item)
= scratch-items(names, filled)

────────────────────
_ do class-bases ImmutableArray'SyntaxId ?! YumiSyntaxError
    - first Index
    - close Index

. bases = scratch-array'SyntaxId(tree, count-from(first, close))
. filled Size = 0
. item = first
while item < close
    bases[filled] = class-base(item)
    filled += 1
    item = tape.after(item)
= scratch-items(bases, filled)

────────────────────
_ do class-base SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
if tape.is-atom(index) && is-number(tape.start(index), tape.end(index))
    . loc = located(begin, index)
    = tree.append(ASTTypeNumeric(loc, number(index, loc)))
if head(index) == .tuple-head && has-one-item && head(index + 2) == .capture-head
    . field = index + 2
    . loc = located(begin, index)
    . capture = tree.append
        - ASTTypeCapture(loc, identifier(field + 2), reduce-type(tape.after(field + 2)))
    = tree.append(ASTTypeTuple(loc, tree.store-child(capture)))
.. has-one-item = count-from(index + 2, tape.close-of(index)) == 1
= reduce-type(index)

────────────────────
_ is-class-header-item Bool
    - index Index

kind == .constraint-head || kind == .implements-head || kind == .using-head || kind == .sees-head

.. kind = head(index)

────────────────────
_ do class-header-item ArgumentVariant ?! YumiSyntaxError
    - index Index

. kind = head(index)
=? constraint(index) if kind == .constraint-head
. loc = located(begin-at(index), index)
. type = reduce-type(index + 2)
=? ArgumentVariant.implements-declaration(tree.append(ASTImplementsDeclaration(loc, type))) if kind == .implements-head
=? ArgumentVariant.sees-declaration(tree.append(ASTSeesDeclaration(loc, type))) if kind == .sees-head
= ArgumentVariant.using-declaration(tree.append(ASTUsingDeclaration(loc, type)))

────────────────────
_ do extension SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. access-index = index + 2
. access = access-at(access-index)
. receiver-index = tape.after(access-index)
. receiver = reduce-type(receiver-index)
. item = tape.after(receiver-index)
. as-types ImmutableArray'SyntaxId? = null
if item < close && head(item) == .as-head
    as-types = type-arguments(item + 2, tape.close-of(item))
    item = tape.after(item)
. constraints ImmutableArray'ArgumentVariant? = null
if item < close && head(item) == .where-head
    . where-close = tape.close-of(item)
    . found = scratch-array'ArgumentVariant(tree, count-from(item + 2, where-close))
    . filled Size = 0
    . part = item + 2
    while part < where-close
        found[filled] = constraint(part)
        filled += 1
        part = tape.after(part)
    constraints = scratch-items(found, filled)
    item = tape.after(item)
. body = class-members(item, close)
= placed
    - make-extension-declaration
        - tree
        - located(begin, index)
        - access
        - receiver
        - as-types
        - constraints
        - body
    - located(begin, index)

────────────────────
_ do class-members ImmutableArray'SyntaxId ?! YumiSyntaxError
    - first Index
    - close Index

. items = scratch-array'SyntaxId(tree, count-from(first, close))
. filled Size = 0
. item = first
while item < close
    . made = member(item)
    if made
        items[filled] = made
        filled += 1
    item = tape.after(item)
= scratch-items(items, filled)

────────────────────
_ do member SyntaxId? ?! YumiSyntaxError
    - index Index

. kind = head(index)
. begin = begin-at(index)
. first = index + 2
do match? kind
    |= .blank-head
        = null
    |= .prop-head
        = property(index)
    |= .fn-do-head
        = callable(index)
    |= .fn-expr-head
        = callable(index)
    |= .fn-to-do-head
        = converter(index)
    |= .fn-to-expr-head
        = converter(index)
    |= .fn-from-do-head
        = fromverter(index)
    |= .fn-from-expr-head
        = fromverter(index)
    |= .event-head
        . name = tape.after(first)
        . type = tape.after(name)
        . keyed = tape.after(type)
        . keyed-type SyntaxId = 0
        if keyed < tape.close-of(index)
            keyed-type = reduce-type(keyed)
        = tree.append
            - ASTEventDeclaration
                - located(begin, index)
                - access-at(first)
                - atom-at(name, 0)
                - reduce-type(type)
                - keyed-type
    |= .variant-head
        = enum-case(index)
    |= .delegate-head
        = tree.append
            - ASTDelegateDeclaration
                - located(begin, index)
                - tree.store-children(class-bases(first, tape.close-of(index)))
    |= .style-domains-head
        . close = tape.close-of(index)
        . domains = scratch-array'SyntaxId(tree, count-from(tape.after(first), close))
        . filled Size = 0
        . item = tape.after(first)
        while item < close
            . domain = item + 2
            . target = tape.after(domain)
            . target-id SyntaxId = 0
            if target < tape.close-of(item)
                target-id = identifier(target)
            domains[filled] = tree.append
                - ASTStyleDomainItem(located(begin-at(item), item), identifier(domain), target-id)
            filled += 1
            item = tape.after(item)
        = tree.append
            - ASTStyleAnnotation
                - located(begin, index)
                - identifier(first)
                - tree.store-children(scratch-items(domains, filled))
    |= .depends-head
        . close = tape.close-of(index)
        . names = scratch-array'SyntaxId(tree, count-from(tape.after(first), close))
        . filled Size = 0
        . item = tape.after(first)
        while item < close
            names[filled] = identifier(item)
            filled += 1
            item = tape.after(item)
        = tree.append
            - ASTDependencyDeclaration
                - located(begin, index)
                - identifier(first)
                - tree.store-children(scratch-items(names, filled))
    |= .content-head
        . loc = located(begin, index)
        = tree.append
            - ASTContentBlock(loc, block-with-statements(tree, rows(first, tape.close-of(index))))
    |= .rule-head
        = style-rule(index)
    |= .keyframes-head
        = keyframes(index)
    |= .subscribe-for-head
        . loc = located(begin, index)
        . close = tape.close-of(index)
        . loop = loop-head(first)
        . rows = joined-sources(loop, tape.after(first), close)
        . body = function-body(rows, close)
        = tree.append
            - ASTSubscriber
                - loc
                - tree.append(ASTForBlock(loc, loop, tree.syntax-or-invalid(body), 0))
    |= .subscribe-head
        . loc = located(begin, index)
        ?! named-source-error(first, "(subscribe …)", "(on source)", " To name the item, write `(subscribe-for (on item source) …)`.") if !is-unbound-source(first)
        . container = first + 2
        . clauses = loop-clauses(tape.after(container), tape.close-of(first))
        . loop = tree.append
            - ASTLoop(loc, 0, expression(container), clauses, head(first) == .on-head, false, 0)
        . body = function-body(tape.after(first), tape.close-of(index))
        = tree.append
            - ASTSubscriber
                - loc
                - tree.append(ASTForBlock(loc, loop, tree.syntax-or-invalid(body), 0))
    |= .when-rule-head
        . condition = expression(first)
        . body = function-body(tape.after(first), tape.close-of(index))
        = tree.append(ASTWhenRule(located(begin, index), condition, tree.syntax-or-invalid(body)))
    |= .whenever-rule-head
        = whenever-rule(index, begin)
    |= .unit-head
        . left = tape.after(first)
        . loc = located(begin, index)
        = tree.append
            - ASTUnitDeclaration
                - loc
                - access-at(first)
                - number(left, located(begin-at(left), left))
                - multi(tape.after(left))
    |= .effect-head
        = effect-declaration(index, begin)
?! unsupported-error(index)

────────────────────
_ do effect-declaration SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. access-index = index + 2
. name-index = tape.after(access-index)
. claims = scratch-array'Atom(tree, count-from(tape.after(name-index), close))
. filled Size = 0
. item = tape.after(name-index)
while item < close
    ?! unsupported-error(item)
        if tape.is-atom(item) || head(item) != .claim-head
    claims[filled] = atom-at(item + 2, 2)
    filled += 1
    item = tape.after(item)
= tree.append(ASTEffectDeclaration(located(begin, index), access-at(access-index), atom-at(name-index, 0), tree.store-atoms(scratch-items(claims, filled))))

────────────────────
_ do style-sheet SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. named = index + 2
. item = tape.after(named)
. derived SheetDerivation? = null
if item < close && head(item) == .is-head
    . base = class-base(item + 2)
    item = tape.after(item)
    . tags ImmutableArray'Atom? = null
    if item < close && head(item) == .for-head
        tags = listed-names(item)
        item = tape.after(item)
    derived = SheetDerivation(base, tags)
. header-count Size = 0
. member-count Size = 0
. first-member = item
while item < close
    if is-class-header-item(item)
        header-count += 1
    else
        member-count += 1
    item = tape.after(item)
. variants = scratch-array'ArgumentVariant(tree, header-count)
. members = scratch-array'SyntaxId(tree, member-count)
. header-filled Size = 0
. member-filled Size = 0
item = first-member
while item < close
    if is-class-header-item(item)
        variants[header-filled] = class-header-item(item)
        header-filled += 1
    else
        . made = member(item)
        if made
            members[member-filled] = made
            member-filled += 1
    item = tape.after(item)
. loc = located(begin, index)
. header = scratch-items(variants, header-filled)
. body = scratch-items(members, member-filled)
=? placed(make-style-sheet-extension-declaration(tree, loc, reduce-type(named), header, body), loc) if head(index) == .style-extend-head
= placed(make-style-sheet-declaration(tree, loc, atom-at(named, 0), derived, header, body), loc)

────────────────────
_ do style-rule SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. named = index + 2
. item = tape.after(named)
. argument SyntaxId? = null
if item < close && head(item) == .param-head
    argument = parameter(item)
    item = tape.after(item)
. first-application = item
item = style-applications-end(item, close)
. applications = style-applications(first-application, item)
. body SyntaxId = 0
if item < close
    body = block-with-statements(tree, rows(item, close))
. loc = located(begin, index)
= make-style-rule
    - tree
    - StyleRuleHeader(loc, atom-at(named, 0), argument, applications, head(index) == .own-rule-head)
    - body

────────────────────
_ do keyframes SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. named = index + 2
. item = tape.after(named)
. argument SyntaxId? = null
if item < close && head(item) == .param-head
    argument = parameter(item)
    item = tape.after(item)
. kind = atom-at(item, 0)
. duration-index = tape.after(item)
. duration = expression(duration-index)
. lines = keyframe-lines(tape.after(duration-index), close)
= make-keyframe-declaration
    - tree
    - located(begin, index)
    - atom-at(named, 0)
    - argument
    - kind
    - duration
    - lines

────────────────────
_ do keyframe-lines ImmutableArray'KeyframeLine ?! YumiSyntaxError
    - first Index
    - close Index

. lines = scratch-array'KeyframeLine(tree, count-from(first, close))
. count Size = 0
. index = first
while index < close
    if head(index) != .blank-head
        lines[count] = keyframe-line(index)
        count += 1
    index = tape.after(index)
= scratch-items(lines, count)

────────────────────
_ do keyframe-line KeyframeLine ?! YumiSyntaxError
    - index Index

. loc = located(begin-at(index), index)
. close = tape.close-of(index)
. first = index + 2
. none = ImmutableArray'KeyframeLine()
do match? head(index)
    |= .assign-head
        . value = expression(tape.after(first))
        = KeyframeLine
            - .keyframe-setting
            - loc
            - atom-at(first, 0)
            - null
            - value
            - 0
            - ImmutableArray'SyntaxId()
            - none
    |= .keyframe-range-head
        . property = keyframe-property(first)
        . from = tape.after(first)
        . to = tape.after(from)
        . bullets = keyframe-options(tape.after(to), close)
        = KeyframeLine
            - .keyframe-range
            - loc
            - property[0]
            - property[1]
            - keyframe-value(from)
            - keyframe-value(to)
            - bullets
            - none
    |= .keyframe-track-head
        . property = keyframe-property(first)
        . options = tape.after(first)
        . item = options
        while item < close && is-named(item)
            item = tape.after(item)
        . bullets = keyframe-options(options, item)
        = KeyframeLine
            - .keyframe-track
            - loc
            - property[0]
            - property[1]
            - 0
            - 0
            - bullets
            - keyframe-lines(item, close)
    |= .keyframe-stop-head
        . value = tape.after(first)
        . bullets = keyframe-options(tape.after(value), close)
        = KeyframeLine
            - .keyframe-stop
            - loc
            - null
            - null
            - expression(first)
            - expression(value)
            - bullets
            - none
?! unsupported-error(index)

────────────────────
_ do keyframe-property (Atom, Atom?)
    - index Index

. start = tape.start(index)
. end = tape.end(index)
for offset in start .. < end
    =? (tree.atom-bytes(bytes, start, offset), tree.atom-bytes(bytes, offset + 1, end)) if is-dot
    .. is-dot = bytes[offset] == 46
= (tree.atom-bytes(bytes, start, end), null)

────────────────────
_ do keyframe-value SyntaxId ?! YumiSyntaxError
    - index Index

=? 0 if atom-is(index, "_")
= expression(index)

────────────────────
_ do keyframe-options ImmutableArray'SyntaxId ?! YumiSyntaxError
    - first Index
    - close Index

. options = scratch-array'SyntaxId(tree, count-from(first, close))
. count Size = 0
. index = first
while index < close
    ?! unsupported-error(index) if !is-named(index)
    options[count] = named-argument(index, begin-at(index))
    count += 1
    index = tape.after(index)
= scratch-items(options, count)

────────────────────
_ do style-application SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. named = index + 2
. item = tape.after(named)
. last = close
. condition SyntaxId = 0
if item < close
    . final = last-item(item, close)
    if head(final) == .if-label-head
        condition = expression(final + 2)
        last = final
. args = expressions(item, last)
= tree.append
    - ASTStyleRuleApplication
        - located(begin, index)
        - atom-at(named, 0)
        - tree.store-children(args)
        - condition

────────────────────
_ do markup SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. type-index = index + 2
. type = reduce-type(type-index)
. item = tape.after(type-index)
. markup-id SyntaxId = 0
if item < close && head(item) == .id-label-head
    markup-id = identifier(item + 2)
    item = tape.after(item)
. slot-binding SyntaxId = 0
if item < close && head(item) == .slot-label-head
    slot-binding = identifier(item + 2)
    item = tape.after(item)
. parameter-id SyntaxId = 0
if item < close && head(item) == .param-label-head
    parameter-id = slot-parameter(item)
    item = tape.after(item)
. args ImmutableArray'SyntaxId? = null
if item < close && (head(item) == .value-label-head || head(item) == .text-label-head)
    args = sequence-singleton(tree, multi(item + 2))
    item = tape.after(item)
. rules-end = style-applications-end(item, close)
. rules = style-applications(item, rules-end)
item = rules-end
. tag-start = item
. tag-count Size = 0
while item < close && head(item) == .for-label-head
    tag-count += 1
    item = tape.after(item)
?! attribute-order-error(item) if item < close && (is-attribute-head(head(item)) || is-late-rule)
.. is-late-rule = tag-count != 0 && head(item) == .style-apply-head
. tags = theme-tag-bindings(tag-start, tag-count)
. body = optional-block(begin, index, item, close)
. loc = located(begin, index)
= tree.append
    - ASTMarkup
        - loc
        - type
        - markup-id
        - slot-binding
        - parameter-id
        - tree.store-optional-children(args)
        - tree.store-optional-children(rules)
        - theme-tag-body(tree, loc, type, tags, body)

────────────────────
_ is-attribute-head Bool
    - kind BrixHead

is-named || is-valued || kind == .for-label-head
.. is-named = kind == .id-label-head || kind == .slot-label-head || kind == .param-label-head
.. is-valued = kind == .value-label-head || kind == .text-label-head

────────────────────
_ attribute-order-error YumiSyntaxError
    - index Index

YumiSyntaxError(MatchLocation(place, place), "(${tape.atom-text(index + 1)} …) is out of order. An element's attributes follow its type in this order: (id: …), (slot: …), (param: …), (value: …) or (text: …), then its (• …) rules, then (for: …).")

.. place = tape.token-location(index)

────────────────────
_ do theme-tag-bindings ImmutableArray'SyntaxId? ?! YumiSyntaxError
    - first Index
    - count Size

=? null if count == 0
. bindings = scratch-array'SyntaxId(tree, count)
. cursor = first
for position in 0 .. < count
    . close = tape.close-of(cursor)
    . named = cursor + 2
    . value = tape.after(named)
    . condition SyntaxId? = null
    if value < close
        condition = expression(value)
    bindings[position] = theme-tag-row(tree, located(begin-at(cursor), cursor), atom-at(named, 0), condition)
    cursor = tape.after(cursor)
= scratch-items(bindings, count)

────────────────────
_ do slot-outlet SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. type-index = index + 2
. item = tape.after(type-index)
. name SyntaxId = 0
if item < close && head(item) == .id-label-head
    name = identifier(item + 2)
    item = tape.after(item)
. parameter-id SyntaxId = 0
if item < close && head(item) == .param-label-head
    parameter-id = slot-parameter(item)
    item = tape.after(item)
. rules-end = style-applications-end(item, close)
. rules = style-applications(item, rules-end)
. body = optional-block(begin, index, rules-end, close)
. loc = located(begin, index)
= tree.append
    - ASTSlotOutlet
        - loc
        - name
        - reduce-type(type-index)
        - parameter-id
        - RowRange'SyntaxId()
        - tree.store-optional-children(rules)
        - tree.syntax-or-invalid(body)

────────────────────
_ do paragraph SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. loc = located(begin, index)
. parts = ArrayBuilder'BlockStringComponent()
. pending = ""
. line = index + 2
while line < close
    if line > index + 2
        pending ++= "\n"
    if tape.is-text(line)
        pending ++= tape.text-value(line)
    else if head(line) == .str-head
        . part-close = tape.close-of(line)
        . part = line + 2
        while part < part-close
            if tape.is-text(part)
                pending ++= tape.text-value(part)
            else
                if pending.length > 0
                    parts.append(BlockStringComponent.literal(pending))
                    pending = ""
                parts.append(BlockStringComponent.syntax(expression(part)))
            part = tape.after(part)
    line = tape.after(line)
if pending.length > 0
    parts.append(BlockStringComponent.literal(pending))
. components = parts.finish-immutable()
=? tree.append(ASTString(loc, tree.store-string(""))) if components.length == 0
= make-block-string(tree, loc, components)

────────────────────
_ do probe-object SyntaxId ?! YumiSyntaxError
    - index Index

=? 0 if head(index) != .capture-head
= expression(index + 2)

────────────────────
_ do probe-key Atom
    - index Index

=? atom-at(tape.after(index + 2), 0) if head(index) == .capture-head
= atom-at(index, 0)

────────────────────
_ do probe-dependencies SyntaxId? ?! YumiSyntaxError
    - index Index
    - close Index

=? null if index >= close
= multi(index)

────────────────────
_ do probe-items ImmutableArray'SyntaxId ?! YumiSyntaxError
    - index Index

. close = tape.close-of(index)
. items = scratch-array'SyntaxId(tree, count-from(index + 2, close))
. filled Size = 0
. item = index + 2
while item < close
    items[filled] = probe-part(item)
    filled += 1
    item = tape.after(item)
= scratch-items(items, filled)

────────────────────
_ do probe-string ImmutableArray'SyntaxId ?! YumiSyntaxError
    - index Index

. close = tape.close-of(index)
=? sequence-singleton(tree, tree.append(ASTString(located(begin-at(index), index), tree.store-string("")))) if index + 2 >= close
= probe-items(index)

────────────────────
_ do probe-part SyntaxId ?! YumiSyntaxError
    - index Index

. kind = head(index)
. loc = located(begin-at(index), index)
=? tree.append(ASTProbePreview(loc, expression(index + 2))) if kind == .preview-head
=? tree.append(ASTProbeSnapshot(loc, expression(index + 2))) if kind == .snapshot-head
= expression(index)

────────────────────
_ do state-step SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - is-continuation Bool

. close = tape.close-of(index)
. target = index + 2
. name = state-target-name(target)
. values = tree.store-children(state-target-values(target))
. item = tape.after(target)
. trigger SyntaxId = 0
if item < close && head(item) == .trigger-head
    trigger = state-trigger(item)
    item = tape.after(item)
. body = tree.store-children(link-statements(tree, rows(item, close)))
. loc = located(begin, index)
=? tree.append(ASTStateContinuation(loc, name, values, trigger, body)) if is-continuation
= tree.append(ASTStateCase(loc, name, values, trigger, body))

────────────────────
_ do state-target-name Atom
    - index Index

= atom-at(if head(index) == .call-head then index + 2 else index, 0)

────────────────────
_ do state-target-values ImmutableArray'SyntaxId ?! YumiSyntaxError
    - index Index

=? ImmutableArray'SyntaxId() if head(index) != .call-head
= expressions(tape.after(index + 2), tape.close-of(index))

────────────────────
_ do state-trigger SyntaxId ?! YumiSyntaxError
    - index Index

. close = tape.close-of(index)
. loc = located(begin-at(index), index)
. kind = index + 2
. first = tape.after(kind)
. second = tape.after(first)
. third = tape.after(second)
if atom-is(kind, "for")
    . matched = tree.append(ASTStructureMatch(loc, pattern(first)))
    . stream = expression(second)
    if third < close
        = tree.append
            - ASTStateTrigger
                - loc
                - .state-trigger-for-on-when
                - tree.store-child(matched, stream, expression(third))
    = tree.append(ASTStateTrigger(loc, .state-trigger-for-on, tree.store-child(matched, stream)))
if atom-is(kind, "when-on")
    . guard = expression(first)
    = tree.append
        - ASTStateTrigger(loc, .state-trigger-on-when, tree.store-child(expression(second), guard))
if atom-is(kind, "on")
    . stream = expression(first)
    if second < close
        = tree.append
            - ASTStateTrigger
                - loc
                - .state-trigger-on-when
                - tree.store-child(stream, expression(second))
    = tree.append(ASTStateTrigger(loc, .state-trigger-on, tree.store-child(stream)))
if atom-is(kind, "if-match")
    . matched = tree.append(ASTStructureMatch(loc, pattern(first)))
    . subject = expression(second)
    = tree.append
        - ASTStateTrigger
            - loc
            - .state-trigger-if-match
            - tree.store-child(tree.append(ASTStateMatchExpression(loc, subject, matched)))
=? tree.append(ASTStateTrigger(loc, .state-trigger-if, tree.store-child(expression(first)))) if atom-is(kind, "if")
if atom-is(kind, "whenever")
    . closure = make-closure(tree, loc, false, null, expression(first))
    = tree.append(ASTStateTrigger(loc, .state-trigger-whenever, tree.store-child(closure)))
= tree.append(ASTStateTrigger(loc, .state-trigger-when-stream, tree.store-child(expression(first))))

────────────────────
_ do stream-match-block SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. loc = located(begin, index)
. matched = stream-pattern(index + 2)
. item = tape.after(index + 2)
=? tree.append(ASTStreamMatch(loc, matched)) if item >= close
. kind = head(item)
if kind == .of-label-head
    . value = expression(item + 2)
    . body = optional-block(begin, index, tape.after(item), close)
    . transformed = if body then tree.append(ASTStreamTransform(loc, matched, body, false)) else matched
    = tree.append
        - ASTMatchExpression(loc, value, tree.append(ASTStreamMatch(loc, transformed, true)), false)
if kind == .in-label-head || kind == .on-label-head
    . container = expression(item + 2)
    . clauses = loop-clauses(tape.after(item + 2), tape.close-of(item))
    . body = optional-block(begin, index, tape.after(item), close)
    . transformed = if body then tree.append(ASTStreamTransform(loc, matched, body, false)) else matched
    . stream-match = tree.append(ASTStreamMatch(loc, transformed))
    = make-iterator-line
        - tree
        - loc
        - container
        - kind == .on-label-head
        - null
        - stream-match
        - clauses
        - null
        - null
. is-rollback = atom-is(item, "@rollback")
. body = arm-body(begin, index, if is-rollback then tape.after(item) else item, close)
= tree.append(ASTStreamMatch(loc, tree.append(ASTStreamTransform(loc, matched, body, is-rollback))))

────────────────────
_ do stream-pattern SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. loc = located(begin, index)
=? tree.append(ASTStreamString(loc, tree.store-string(tape.text-value(index)))) if is-text
.. is-text = tape.is-text(index)
if tape.is-atom(index)
    = stream-atom(index, loc)
?! unsupported-error(index) if !tape.is-open(index)
. kind = head(index)
. close = tape.close-of(index)
. first = index + 2
do match? kind
    |= .seq-head
        . accumulated = stream-pattern(first)
        . item = tape.after(first)
        while item < close
            . right = stream-pattern(item)
            accumulated = tree.append(ASTStreamAnd(loc, accumulated, right))
            item = tape.after(item)
        = accumulated
    |= .alternative-head
        . accumulated = stream-pattern(first)
        . item = tape.after(first)
        while item < close
            . right = stream-pattern(item)
            accumulated = tree.append(ASTStreamOr(loc, accumulated, right))
            item = tape.after(item)
        = accumulated
    |= .optional-head
        = tree.append(ASTStreamUnary(loc, .zero-or-one-op, stream-pattern(first)))
    |= .multiply-head
        = tree.append(ASTStreamUnary(loc, .zero-or-more-op, stream-pattern(first)))
    |= .add-head
        = tree.append(ASTStreamUnary(loc, .one-or-more-op, stream-pattern(first)))
    |= .lookahead-head
        = tree.append(ASTStreamUnary(loc, .positive-lookahead-op, stream-pattern(first)))
    |= .not-head
        = tree.append(ASTStreamUnary(loc, .negative-lookahead-op, stream-pattern(first)))
    |= .predicate-head
        . operand = stream-pattern(first)
        . low = tape.after(first)
        . high = tape.after(low)
        . low-id = expression(low)
        . high-id SyntaxId = 0
        if high < close
            high-id = expression(high)
        = tree.append(ASTStreamLength(loc, operand, low-id, high-id))
    |= .stream-predicate-head
        = tree.append(ASTStreamPredicate(loc, expression(first)))
    |= .chars-head
        = character-class(first, loc)
    |= .capture-head
        . start = tape.start(first)
        . is-accumulating = is-dotted && bytes[start + 1] == 46 && bytes[start + 2] == 46
            .. is-dotted = tape.end(first) - start > 3 && bytes[start] == 46
        . name = tree.append
            - ASTIdentifier
                - located(begin-at(first), first)
                - atom-at(first, if is-accumulating then 3 else 0)
                - false
        = tree.append
            - ASTStreamCapture(loc, name, stream-pattern(tape.after(first)), is-accumulating)
    |= .call-head
        = stream-call(first, tape.after(first), close, loc, true)
    |= .of-head
        =? stream-call(index, close, close, loc, false) if is-stream-call-name(first)
= tree.append(ASTStreamType(loc, reduce-type(index)))

────────────────────
_ is-stream-call-name Bool
    - index Index

tape.is-atom(index) && bytes[tape.start(index)] == 92

────────────────────
_ do stream-atom SyntaxId ?! YumiSyntaxError
    - index Index
    - loc MatchLocation

. first = tape.start(index)
. last = tape.end(index)
. lead = bytes[first]
=? tree.append(ASTStreamAny(loc)) if atom-is(index, ".")
if atom-is(index, "//") || atom-is(index, "/")
    . empty = RowRange'SyntaxId()
    . call = tree.append(ASTStreamCall(loc, tree.atom("ws"), empty, empty, empty))
    = tree.append
        - ASTStreamUnary
            - loc
            - if atom-is(index, "//") then .one-or-more-op else .zero-or-more-op
            - call
=? stream-call(index, index, index, loc, false) if lead == 92
=? tree.append(ASTStreamEquality(loc, tree.append(ASTIdentifier(loc, atom-at(index, 1), false)))) if lead == 36
=? tree.append(ASTStreamEquality(loc, number(index, loc))) if is-number(first, last)
=? tree.append(ASTStreamEquality(loc, atom-expression(index))) if lead == 46
=? tree.append(ASTStreamEquality(loc, atom-expression(index))) if lead == 39 && !is-doubled-quote
.. is-doubled-quote = last - first > 2 && bytes[first + 1] == 39
= tree.append(ASTStreamType(loc, reduce-type(index)))

────────────────────
_ do stream-call SyntaxId ?! YumiSyntaxError
    - callee Index
    - args-first Index
    - close Index
    - loc MatchLocation
    - has-arguments Bool

. is-applied = head(callee) == .of-head
. named = if is-applied then callee + 2 else callee
. params = if is-applied then type-arguments(tape.after(named), callee-close) else empty-params
    .. callee-close = tape.close-of(callee)
    .. empty-params = ImmutableArray'SyntaxId()
. name = atom-at(named, 1)
=? make-stream-call(tree, loc, name, params, null) if !has-arguments
. args = scratch-array'SyntaxId(tree, count-from(args-first, close))
. filled Size = 0
. item = args-first
while item < close
    args[filled] = stream-argument(item)
    filled += 1
    item = tape.after(item)
= make-stream-call(tree, loc, name, params, scratch-items(args, filled))

────────────────────
_ do stream-argument SyntaxId ?! YumiSyntaxError
    - index Index

. loc = located(begin-at(index), index)
. kind = head(index)
if kind == .into-head
    . first = index + 2
    . second = tape.after(first)
    =? tree.append(ASTStreamCollectorMapping(loc, null, atom-at(first, 0))) if lacks-second
    .. lacks-second = second >= tape.close-of(index)
    = tree.append(ASTStreamCollectorMapping(loc, atom-at(first, 0), atom-at(second, 0)))
=? tree.append(ASTStreamCallExpressionArgument(MatchLocation(), tree.append(ASTStreamMatch(loc, stream-pattern(index + 2))))) if kind == .tilde-head
= tree.append(ASTStreamCallExpressionArgument(MatchLocation(), expression(index)))

────────────────────
_ do character-class SyntaxId ?! YumiSyntaxError
    - index Index
    - loc MatchLocation

. chars [Char]
for char in tape.text-value(index)
    chars += char
. result SyntaxId = 0
. position Index = 0
while position < chars.length
    . low = class-char(chars, position)
    position = class-char-end(chars, position)
    . high = low
    if position + 1 < chars.length && chars[position] == '-'
        high = class-char(chars, position + 1)
        position = class-char-end(chars, position + 1)
    . low-node = tree.append
        - ASTInteger(loc, tree.store-string(character-literal-string(loc, low)), tree.atom("(char)"))
    . high-node = tree.append
        - ASTInteger(loc, tree.store-string(character-literal-string(loc, high)), tree.atom("(char)"))
    . range = tree.append(ASTStreamCharRange(loc, low-node, high-node))
    result = if result == 0 then range else tree.append(ASTStreamOr(loc, result, range))
= result

────────────────────
_ do class-char Char
    - chars [Char]
    - position Index

=? chars[position] if !is-class-escape(chars, position)
. value U32
for offset in 2 .. < 6
    value = value * 16 + hex-value(chars[position + offset])
= value as Char

────────────────────
_ class-char-end Index
    - chars [Char]
    - position Index

if is-class-escape(chars, position) then position + 6 else position + 1

────────────────────
_ do is-class-escape Bool
    - chars [Char]
    - position Index

=? false if position + 6 > chars.length || chars[position] != '\\' || chars[position + 1] != 'u'
= all(2 .. < 6) • where hex-value(chars[position + each]) <= 15

────────────────────
_ hex-value U32
    - char Char

|? code >= 48 && code <= 57
    code - 48
|? code >= 97 && code <= 102
    code - 87
|? code >= 65 && code <= 70
    code - 55
??
    16

.. code = char as U32

────────────────────
_ do slot-parameter SyntaxId ?! YumiSyntaxError
    - index Index

. name = index + 2
. type = tape.after(name)
. type-id SyntaxId = 0
if type < tape.close-of(index)
    type-id = reduce-type(type)
= tree.append(ASTMarkupSlotParameter(located(begin-at(index), index), identifier(name), type-id))

────────────────────
_ do style-applications-end Index
    - first Index
    - close Index

. item = first
while item < close && head(item) == .style-apply-head
    item = tape.after(item)
= item

────────────────────
_ do style-applications ImmutableArray'SyntaxId? ?! YumiSyntaxError
    - first Index
    - end Index

=? null if first >= end
. found = scratch-array'SyntaxId(tree, count-from(first, end))
. filled Size = 0
. item = first
while item < end
    found[filled] = style-application(item)
    filled += 1
    item = tape.after(item)
= scratch-items(found, filled)

────────────────────
_ do state-name Atom
    - index Index

= atom-at(index, if bytes[tape.start(index)] == 35 then 1 else 0)

────────────────────
_ do whenever-rule SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. trigger = index + 2
. kind = tree.atom("value")
. target SyntaxId = 0
. value SyntaxId = 0
if head(trigger) == .trigger-head
    kind = atom-at(trigger + 2, 0)
    target = reduce-type(tape.after(trigger + 2))
else
    value = expression(trigger)
. item = tape.after(trigger)
. variants-first = item
while item < close && tape.is-open(item) && is-header-item(item)
    item = tape.after(item)
. found = scratch-array'ArgumentVariant(tree, count-from(variants-first, item))
. filled Size = 0
. part = variants-first
while part < item
    found[filled] = variant(part)
    filled += 1
    part = tape.after(part)
. args = tree.store-children(argument-declarations(tree, scratch-items(found, filled)))
. body = function-body(item, close)
= tree.append
    - ASTWheneverRule
        - located(begin, index)
        - kind
        - target
        - value
        - args
        - tree.syntax-or-invalid(body)

────────────────────
_ is-joined Bool
    - index Index

head(index) == .and-for-head

────────────────────
_ do loop-and-list SyntaxId ?! YumiSyntaxError
    - index Index

=? loop-head(index) if !is-joined(index)
. close = tape.close-of(index)
. first-loop = loop-head(index + 2)
. tail = scratch-array'SyntaxId(tree, count-from(tape.after(index + 2), close))
. filled Size = 0
. item = tape.after(index + 2)
while item < close
    tail[filled] = loop-head(item)
    filled += 1
    item = tape.after(item)
= linked-list-tail(tree, first-loop, scratch-items(tail, filled))

────────────────────
_ do task-block SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - is-parallel Bool

. close = tape.close-of(index)
. item = index + 2
. worker SyntaxId = 0
if item < close && head(item) == .worker-label-head
    worker = expression(item + 2)
    item = tape.after(item)
. failures = failure-start(item, close)
. loc = located(begin, index)
. body = do-body(item, failures, begin, index)
. catchers = scratch-array'SyntaxId(tree, count-from(failures, close))
. filled Size = 0
. arm = failures
while arm < close
    catchers[filled] = catcher(arm)
    filled += 1
    arm = tape.after(arm)
= tree.append
    - ASTDoTaskBlock
        - loc
        - body.body
        - worker
        - is-parallel
        - task-scheduling(loc, body.annotations)
        - task-large-stack(body.annotations)
        - tree.store-children(scratch-items(catchers, filled))
        - task-detached(body.annotations)

────────────────────
_ do failure-start Index
    - first Index
    - close Index

. start = close
. index = first
while index < close
    if head(index) == .on-failure-head
        if start == close
            start = index
    else
        start = close
    index = tape.after(index)
= start

────────────────────
_ access-at Access
    - index Index

|? atom-is(index, "+")
    Access.public-access
|? atom-is(index, "^")
    Access.family-access
??
    Access.private-access

────────────────────
_ access-text String
    - access Access

match access
    | .public-access
        "+"
    | .family-access
        "^"
    ??
        "_"

────────────────────
_ do enum-case SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. loc = located(begin, index)
. first = index + 2
if !tape.is-atom(first) || is-type-name(first)
    = tree.append(ASTEnumDeclaration(loc, null, reduce-type(first), 0))
. item = tape.after(first)
. type SyntaxId = 0
if item < close && head(item) != .assign-head
    type = reduce-type(item)
    item = tape.after(item)
. value SyntaxId = 0
if item < close
    value = multi(item + 2)
= tree.append(ASTEnumDeclaration(loc, atom-at(first, 0), type, value))

────────────────────
_ do body-start Index
    - first Index
    - close Index
    - raises Bool = false

. item = first
while item < close && precedes-body(item, raises)
    item = tape.after(item)
= item

────────────────────
_ precedes-body Bool
    - item Index
    - raises Bool

` Whether an item of a property's form comes before its rows: `:get`, `:set`, an annotation, a
` door, a `without` or `with` part, or where the property `raises`, an error it raises.
|? tape.is-atom(item)
    atom-is(item, ":get") || atom-is(item, ":set") || bytes[tape.start(item)] == 64
??
    (raises && head(item) == .raises-head) || head(item) == .door-head || is-scope(item)

────────────────────
_ do raised-types ImmutableArray'SyntaxId ?! YumiSyntaxError
    - first Index
    - end Index

. errors = scratch-array'SyntaxId(tree, count-from(first, end))
. filled Size = 0
. item = first
while item < end
    if !tape.is-atom(item) && head(item) == .raises-head
        errors[filled] = reduce-type(item + 2)
        filled += 1
    item = tape.after(item)
= scratch-items(errors, filled)

────────────────────
_ do annotation-atoms ImmutableArray'Atom ?! YumiSyntaxError
    - first Index
    - end Index

. names = scratch-array'Atom(tree, count-from(first, end))
. filled Size = 0
. item = first
while item < end
    if tape.is-atom(item) && bytes[tape.start(item)] == 64
        names[filled] = annotation-at(item)
        filled += 1
    else if !tape.is-atom(item) && head(item) == .door-head
        names[filled] = door-annotation(tree, atom-at(item + 2, 0))
        filled += 1
    item = tape.after(item)
= scratch-items(names, filled)

────────────────────
_ do annotation-at Atom ?! YumiSyntaxError
    - item Index

` The annotation an `@` atom names, which may not be one a `without` section is written for.
= written-annotation(located(begin-at(item), item), atom-at(item, 1))

────────────────────
_ do getter SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. access-index = index + 2
. names-index = tape.after(access-index)
. type-index = tape.after(names-index)
. flags = tape.after(type-index)
. rows-first = body-start(flags, close, true)
. returns SyntaxId? = null
if !atom-is(type-index, "_")
    returns = reduce-type(type-index)
. names = function-names(names-index, null)
. errors = raised-types(flags, rows-first)
. body = function-body(rows-first, close)
. loc = located(begin, index)
. is-imperative = head(index) == .fn-do-head
. sections = scope-of(flags, rows-first)
= placed
    - make-getter-function
        - tree
        - loc
        - access-at(access-index)
        - names
        - is-imperative
        - section-annotations(tree, loc, annotation-atoms(flags, rows-first), sections, false)
        - returns
        - sectioned-body(tree, loc, sections, is-imperative, body)
        - errors
    - loc

────────────────────
_ do setter SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. access-index = index + 2
. names-index = tape.after(access-index)
. flags = tape.after(tape.after(names-index))
. param-index = body-start(flags, close)
. rows-first = tape.after(param-index)
. is-imperative = head(index) == .fn-do-head
. names = function-names(names-index, null)
. argument = parameter(param-index)
. body = function-body(rows-first, close)
. loc = located(begin, index)
= tree.append
    - ASTFunction
        - loc
        - access-at(access-index)
        - tree.store-atoms(names)
        - 0
        - tree.store-child(argument)
        - RowRange'SyntaxId()
        - 0
        - RowRange'SyntaxId()
        - RowRange'SyntaxId()
        - RowRange'SyntaxId()
        - tree.syntax-or-invalid(imperative-body(tree, is-imperative, body))
        - CompilationEffect.none
        - is-imperative
        - false
        - false
        - false
        - true

────────────────────
_ do converter SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. access-index = index + 2
. type-index = tape.after(access-index)
. flags = tape.after(type-index)
. variants-first = body-start(flags, close)
. item = variants-first
while item < close && tape.is-open(item) && is-header-item(item)
    item = tape.after(item)
. found = scratch-array'ArgumentVariant(tree, count-from(variants-first, item))
. filled Size = 0
. part = variants-first
while part < item
    found[filled] = variant(part)
    filled += 1
    part = tape.after(part)
. variants = scratch-items(found, filled)
. is-imperative = head(index) == .fn-to-do-head
. loc = located(begin, index)
. sections = scope-of(flags, variants-first)
. names = unlowered(loc, section-annotations(tree, loc, annotation-atoms(flags, variants-first), sections, false))
. body = sectioned-body(tree, loc, sections, is-imperative, function-body(item, close))
. constraints = tree.store-optional-children(parameter-constraints(tree, variants))
. assignments = tree.store-optional-children(parameter-assignments(tree, variants))
= tree.append
    - ASTConverter
        - loc
        - access-at(access-index)
        - reduce-type(type-index)
        - constraints
        - assignments
        - tree.syntax-or-invalid(imperative-body(tree, is-imperative, body))
        - is-imperative
        - compilation-effects(loc, names, false)
        - has-annotation(names, "inline")

────────────────────
_ do fromverter SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. access-index = index + 2
. pattern-index = tape.after(access-index)
. flags = tape.after(pattern-index)
. rows-first = body-start(flags, close)
. is-imperative = head(index) == .fn-from-do-head
. matched = pattern(pattern-index)
. body = function-body(rows-first, close)
= tree.append
    - ASTFromverter
        - located(begin, index)
        - access-at(access-index)
        - matched
        - tree.syntax-or-invalid(imperative-body(tree, is-imperative, body))
        - is-imperative

────────────────────
_ do statement SyntaxId? ?! YumiSyntaxError
    - index Index

=? multi(index) if !tape.is-open(index)
. kind = head(index)
. begin = begin-at(index)
. close = tape.close-of(index)
. first = index + 2
do match? kind
    |= .blank-head
        = null
    |= .let-head
        = declaration(index, begin, false)
    |= .lazy-head
        = declaration(index, begin, true)
    |= .return-head
        =? tree.append(ASTReturn(located(begin, index), 0)) if first >= close
        . value = multi(first)
        . loc = located(begin, index)
        = tree.append(ASTReturn(loc, maybe-optional(tree, loc, value, is-optional(index))))
    |= .yield-head
        . value = multi(first)
        . loc = located(begin, index)
        = tree.append(ASTYield(loc, maybe-optional(tree, loc, value, is-optional(index)), false))
    |= .yield-all-head
        . value = multi(first)
        . loc = located(begin, index)
        = make-yield-all(tree, loc, maybe-optional(tree, loc, value, is-optional(index)))
    |= .return-if-head
        if head(first) == .if-head
            . condition = expression(first + 2)
            = tree.append(ASTReturnIfTrue(located(begin, index), condition, 0))
        . value = expression(first)
        . condition = expression(tape.after(first) + 2)
        = tree.append(ASTReturnIfTrue(located(begin, index), condition, value))
    |= .break-head
        = tree.append(ASTBreak(located(begin, index)))
    |= .continue-head
        = tree.append(ASTContinue(located(begin, index)))
    |= .if-head
        = if-block(index, begin)
    |= .while-head
        = while-block(index, begin)
    |= .do-head
        = do-block(index, begin)
    |= .finally-head
        . body = do-body(first, close, begin, index)
        = tree.append
            - ASTDoFinallyBlock
                - located(begin, index)
                - unannotated-body(located(begin, index), body, "do finally")
    |= .do-use-head
        . resource = expression(first)
        . body = do-body(tape.after(first), close, begin, index)
        . loc = located(begin, index)
        = tree.append
            - ASTUseBlock
                - loc
                - maybe-optional(tree, loc, resource, is-optional(index))
                - unannotated-body(loc, body, "do use")
    |= .do-with-head
        . name = atom-at(first, 0)
        . value = expression(tape.after(first))
        . body = do-body(tape.after(tape.after(first)), close, begin, index)
        = tree.append
            - ASTStackLocalBindingBlock
                - located(begin, index)
                - name
                - value
                - unannotated-body(located(begin, index), body, "do with")
    |= .print-word-head
        =? tree.append(ASTNoop(located(begin, index))) if first >= close
        . value = multi(first)
        . loc = located(begin, index)
        = tree.append(ASTPrint(loc, maybe-optional(tree, loc, value, is-optional(index))))
    |= .throw-head
        = assertion(index, begin)
    |= .probe-count-head
        . selector = first
        . item = tape.after(selector)
        . delta SyntaxId = 0
        if item < close && head(item) != .block-head
            delta = expression(item)
            item = tape.after(item)
        . counter = tree.append
            - ASTProbeCounter
                - located(begin, index)
                - probe-object(selector)
                - probe-key(selector)
                - delta
        = probe-with-dependencies(tree, counter, probe-dependencies(item, close))
    |= .probe-assign-head
        . selector = first
        . content = tape.after(selector)
        . assigned = tree.append
            - ASTProbeAssign
                - located(begin, index)
                - probe-object(selector)
                - probe-key(selector)
                - expression(content)
        = probe-with-dependencies(tree, assigned, probe-dependencies(tape.after(content), close))
    |= .probe-log-head
        . selector = first
        . item = tape.after(selector)
        . loc = located(begin, index)
        . is-blank = atom-is(selector, "_")
        . object = if is-blank then 0 else probe-object(selector)
        . key = if is-blank then null else probe-key(selector)
        . category = key
        . content = RowRange'SyntaxId()
        if item < close && head(item) == .text-label-head
            category = null
            content = tree.store-children(probe-string(item))
            item = tape.after(item)
        else if item < close && head(item) == .items-label-head
            content = tree.store-children(probe-items(item))
            item = tape.after(item)
        . logged = tree.append(ASTProbe(loc, object, category, key, content))
        = probe-with-dependencies(tree, logged, probe-dependencies(item, close))
    |= .probe-group-head
        . mark = first
        . selector = tape.after(mark)
        . item = tape.after(selector)
        . loc = located(begin, index)
        . is-blank = atom-is(selector, "_")
        . object = if is-blank then 0 else probe-object(selector)
        . key = if is-blank then null else probe-key(selector)
        . is-begin = bytes[tape.start(mark)] == 43
        . is-end = bytes[tape.end(mark) - 1] == 45
        . is-keyed = true
        . content = RowRange'SyntaxId()
        if item < close && head(item) == .text-label-head
            is-keyed = false
            content = tree.store-children(probe-string(item))
            item = tape.after(item)
        else if item < close && head(item) == .items-label-head
            content = tree.store-children(probe-items(item))
            item = tape.after(item)
        . group = tree.append(ASTProbeGroup(loc, content, is-begin, is-end, is-keyed, object, key))
        = probe-with-dependencies(tree, group, probe-dependencies(item, close))
    |= .probe-head
        . selector = first
        . is-blank = atom-is(selector, "_")
        . object = if is-blank then 0 else probe-object(selector)
        . key = if is-blank then null else probe-key(selector)
        . body = statement(tape.after(selector))
        = tree.append
            - ASTProbeStatement(located(begin, index), tree.syntax-or-invalid(body), object, key)
    |= .on-error-head
        = catcher(index)
    |= .do-new-head
        = task-block(index, begin, false)
    |= .do-new-thread-head
        = task-block(index, begin, true)
    |= .pipe-head
        . op = brix-binary-operator(brix-head(bytes, tape.start(first), tape.end(first)))
        . loc = located(begin, index)
        if op == .stream-pattern-pipe-op
            . pattern-index = tape.after(first)
            . matched = stream-pattern(pattern-index)
            . rest = tape.after(pattern-index)
            . has-helper = rest < close && head(rest) == .with-head
            . helper = if has-helper then expression(rest + 2) else 0
            . body = optional-block
                - begin
                - index
                - if has-helper then tape.after(rest) else rest
                - close
            . transformed = if body then tree.append(ASTStreamTransform(loc, matched, body, false)) else matched
            = tree.append
                - ASTPipelineExpression
                    - loc
                    - op
                    - 0
                    - tree.append(ASTStreamMatch(loc, transformed, false, helper))
        = tree.append(ASTPipelineExpression(loc, op, 0, multi(tape.after(first))))
    |= .rule-head
        = style-rule(index)
    |= .own-rule-head
        = style-rule(index)
    |= .style-apply-head
        = style-application(index)
    |= .when-style-head
        . state = first
        . is-negated = head(state) == .not-word-head
        . named = if is-negated then state + 2 else state
        . body = arm-body(begin, index, tape.after(state), close)
        = tree.append(ASTStyleWhen(located(begin, index), state-name(named), body, is-negated))
    |= .style-set-head
        . property = tape.after(first)
        . loc = located(begin, index)
        . property-node = tree.append(ASTIdentifier(loc, atom-at(property, 0), false))
        . assignment = make-assignment
            - tree
            - loc
            - .eq-op
            - property-node
            - expression(tape.after(property))
            - false
        = tree.append(ASTStyleWhen(loc, state-name(first), assignment, false))
    |= .arg-head
        . value = multi(first)
        = tree.make-argument(located(begin, index), value, null, false)
    |= .entry-head
        = entry(index, begin)
|? is-named(index)
    = named-argument(index, begin)
|? is-declaration-head(kind)
    = top-statement(index)
??
    = multi-from(index, kind, begin)

────────────────────
_ do is-declaration-head Bool
    - kind BrixHead

do match? kind
    |= .import-head
        = true
    |= .export-head
        = true
    |= .fn-do-head
        = true
    |= .fn-expr-head
        = true
    |= .prop-head
        = true
    |= .fn-from-do-head
        = true
    |= .fn-from-expr-head
        = true
    |= .fn-to-do-head
        = true
    |= .fn-to-expr-head
        = true
    |= .unit-head
        = true
    |= .effect-head
        = true
    |= .type-head
        = true
    |= .type-line-head
        = true
    |= .extend-head
        = true
    |= .extend-line-head
        = true
    |= .style-head
        = true
    |= .style-extend-head
        = true
= false

────────────────────
_ do optional-block SyntaxId? ?! YumiSyntaxError
    - begin TokenLocation
    - owner Index
    - first Index
    - close Index

=? null if first >= close
= arm-body(begin, owner, first, close)

────────────────────
_ do case-arm SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - is-union Bool

. close = tape.close-of(index)
. first = index + 2
. loc = located(begin, index)
. body = optional-block(begin, index, tape.after(first), close)
if head(first) == .assign-head
    . matched = pattern(first + 2)
    . subject = expression(tape.after(first + 2))
    . transformed = if body then tree.append(ASTTypeTransform(loc, body, matched, is-union)) else matched
    = tree.append
        - ASTMatchExpression(loc, subject, tree.append(ASTStructureMatch(loc, transformed)), false)
. matched = pattern(first)
. transformed = if body then tree.append(ASTTypeTransform(loc, body, matched, is-union)) else matched
= tree.append(ASTStructureMatch(loc, transformed))

────────────────────
_ do case-test SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - is-union Bool
    - is-equality Bool

. close = tape.close-of(index)
. first = index + 2
. loc = located(begin, index)
. body = optional-block(begin, index, tape.after(first), close)
. value = expression(first)
if is-equality
    . test = tree.append(ASTTypeEquality(loc, value, false))
    = tree.append
        - ASTStructureMatch(loc, tree.append(ASTTypeTransform(loc, body ?? value, test, is-union)))
. test = tree.append(ASTTypePredicate(loc, value, false))
. result = body ?? tree.append(ASTUnaryExpression(tree.nodes.loc[value], .optional-force-op, value))
= tree.append(ASTStructureMatch(loc, tree.append(ASTTypeTransform(loc, result, test, is-union))))

────────────────────
_ do declaration SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - is-lazy Bool

. close = tape.close-of(index)
. target = index + 2
. typed = tape.after(target)
. is-flat = is-atom-target && typed < close && (tape.after(typed) < close || is-type-form(typed))
    .. is-atom-target = tape.is-atom(target)
. value = if is-flat then tape.after(typed) else typed
. left = if is-flat then flat-binding(target, typed) else pattern(target)
. right SyntaxId = 0
if value < close && head(value) == .pattern-head
    . value-close = tape.close-of(value)
    . marked = value + 2
    . is-rollback = marked < value-close && atom-is(marked, "@rollback")
    . rows-first = if is-rollback then tape.after(marked) else marked
    . block = located-block
        - tree
        - located(begin-at(value), value)
        - block-with-statements(tree, rows(rows-first, value-close))
    = make-declaration(tree, located(begin, index), left, block, is-lazy, true, is-rollback)
if value < close
    right = multi(value)
= make-declaration(tree, located(begin, index), left, right, is-lazy, false, false)

────────────────────
_ do flat-binding SyntaxId ?! YumiSyntaxError
    - target Index
    - typed Index

=? pattern(target) if atom-is(typed, "_")
. loc = located(begin-at(target), typed)
= tree.append(ASTTypeCapture(loc, identifier(target), pattern(typed)))

────────────────────
_ do is-type-form Bool
    - index Index

=? is-type-name(index) if !tape.is-open(index)
. kind = head(index)
=? true if kind == .channel-head || is-function-type || kind == .c-struct-head || is-matched-type
.. is-function-type = kind == .fn-type-head || kind == .c-fn-type-head
.. is-matched-type = kind == .exact-head || kind == .similar-head
. close = tape.close-of(index)
. item = index + 2
=? false if item >= close
=? false if is-not-generic && is-not-compound && kind != .stream-head && kind != .member-head
.. is-not-generic = kind != .list-head && kind != .optional-head && kind != .of-head
.. is-not-compound = kind != .map-head && kind != .tuple-head && kind != .index-head
while item < close
    . is-field = kind == .tuple-head && head(item) == .capture-head && tape.is-atom(item + 2)
    =? false if !is-type-form(if is-field then tape.after(item + 2) else item)
    item = tape.after(item)
= true

────────────────────
_ do assertion SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. raised = index + 2
. item = tape.after(raised)
. exception = expression(raised)
. loc = located(begin, index)
. condition SyntaxId = 0
if item < close && head(item) == .if-head
    condition = expression(item + 2)
    item = tape.after(item)
. catchers = scratch-array'SyntaxId(tree, count-from(item, close))
. filled Size = 0
while item < close
    ?! unsupported-error(item) if head(item) != .on-error-head
    catchers[filled] = catcher(item)
    filled += 1
    item = tape.after(item)
. predicate = if condition != 0 then tree.append(ASTTypePredicate(loc, condition, false)) else 0
. assertion = tree.append(ASTAssertion(loc, exception, predicate))
=? assertion if filled == 0
= tree.append
    - ASTCatchExpression
        - loc
        - assertion
        - false
        - tree.store-children(scratch-items(catchers, filled))

────────────────────
_ do catcher SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. caught = index + 2
. type SyntaxId = 0
. previous = ImmutableArray'SyntaxId()
if head(caught) == .caught-head
    type = caught-type(caught + 2)
    . caught-close = tape.close-of(caught)
    . found = scratch-array'SyntaxId(tree, count-from(tape.after(caught + 2), caught-close))
    . filled Size = 0
    . item = tape.after(caught + 2)
    while item < caught-close
        found[filled] = caught-type(item)
        filled += 1
        item = tape.after(item)
    previous = scratch-items(found, filled)
else
    type = caught-type(caught)
. body SyntaxId = 0
. rows-first = tape.after(caught)
if rows-first < close
    body = block-with-statements(tree, rows(rows-first, close))
= tree.append(ASTCatcher(located(begin, index), body, type, tree.store-children(previous)))

────────────────────
_ do caught-type SyntaxId ?! YumiSyntaxError
    - index Index

=? 0 if atom-is(index, "_")
. loc = located(begin-at(index), index)
if head(index) == .capture-head
    . id = identifier(index + 2)
    = tree.append(ASTTypeCapture(loc, id, reduce-type(tape.after(index + 2))))
=? reduce-type(index) if !tape.is-atom(index) || is-type-name(index)
= tree.append(ASTTypeCapture(loc, identifier(index), 0))

────────────────────
_ do entry SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. key = expression(index + 2)
. value-index = tape.after(index + 2)
. value SyntaxId? = null
if value-index < close
    value = multi(value-index)
. loc = located(begin, index)
. pair = tree.append(ASTTuple(loc, tree.store-child(key, value)))
= tree.make-argument(loc, pair, null, is-optional(index))

────────────────────
_ do named-argument SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. mark = index + 1
. first = tape.start(mark) + 1
. is-marked-optional = bytes[tape.end(mark) - 1] == 63
. last = if is-marked-optional then tape.end(mark) - 1 else tape.end(mark)
. name = tree.atom-bytes(bytes, first, last)
. value-index = index + 2
. value SyntaxId = 0
if value-index < close
    value = multi(value-index)
else
    value = tree.append(ASTIdentifier(located(begin, mark), name, false))
= tree.make-argument(located(begin, index), value, name, is-marked-optional)

────────────────────
_ is-named Bool
    - index Index

|? !tape.is-open(index) || !tape.is-atom(index + 1)
    false
|? tape.end(index + 1) - first < 2 || bytes[first] != 58
    false
??
    next >= 97 && next <= 122

.. first = tape.start(index + 1)
.. next = bytes[first + 1]

────────────────────
_ is-optional Bool
    - index Index

last - tape.start(mark) > 1 && bytes[last - 1] == 63

.. mark = index + 1
.. last = tape.end(mark)

────────────────────
_ do if-block SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. condition = index + 2
. arms = arm-start(tape.after(condition), close, false)
. head-block = if-arm(index, begin, condition, arms)
. else-count Size = 0
. arm = arms
while arm < close
    if head(arm) == .else-if-head
        else-count += 1
    arm = tape.after(arm)
. elseifs = scratch-array'SyntaxId(tree, else-count)
. filled Size = 0
. otherwise SyntaxId? = null
arm = arms
while arm < close
    . arm-begin = begin-at(arm)
    . arm-close = tape.close-of(arm)
    if head(arm) == .else-if-head
        elseifs[filled] = if-arm(arm, arm-begin, arm + 2, arm-close)
        filled += 1
    else
        . body = arm-body(arm-begin, arm, arm + 2, arm-close)
        otherwise = tree.append(ASTIfBlock(located(arm-begin, arm), 0, body, false, 0))
    arm = tape.after(arm)
= link-if-block(tree, head-block, scratch-items(elseifs, filled), otherwise)

────────────────────
_ do if-arm SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - condition Index
    - end Index

. body = arm-body(begin, index, tape.after(condition), end)
=? conditional-match(index, begin, condition, body, false) if is-match-condition(condition)
. condition-begin = begin-at(condition)
. test = expression(condition)
. predicate = tree.append(ASTTypePredicate(located(condition-begin, condition), test, false))
= tree.append(ASTIfBlock(located(begin, index), predicate, body, false, 0))

────────────────────
_ do conditional-match SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - condition Index
    - body SyntaxId
    - is-loop Bool

. marked = condition + 2
. is-stream = head(marked) == .tilde-head
. matched = if is-stream then stream-pattern(marked + 2) else pattern(marked + 2)
. subject = expression(tape.after(marked))
= make-conditional-match-block
    - tree
    - located(begin, index)
    - matched
    - subject
    - body
    - is-stream
    - is-loop

────────────────────
_ is-match-condition Bool
    - index Index

|? head(index) != .assign-head
    false
??
    kind == .tilde-head || (kind == .alternative-head && is-single-alternative)

.. kind = head(index + 2)
.. is-single-alternative = count-from(index + 4, tape.close-of(index + 2)) == 1

────────────────────
_ do arm-start Index
    - first Index
    - close Index
    - is-loop Bool

. start = close
. index = first
while index < close
    . kind = head(index)
    . is-arm = if is-loop then is-loop-arm else (kind == .else-if-head || kind == .else-head)
        .. is-loop-arm = kind == .and-for-head || kind == .or-for-head
    if is-arm
        if start == close
            start = index
    else
        start = close
    index = tape.after(index)
= start

────────────────────
_ do while-block SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. condition = index + 2
. body = arm-body(begin, index, tape.after(condition), close)
=? conditional-match(index, begin, condition, body, true) if is-match-condition(condition)
. test = expression(condition)
= tree.append(ASTWhileBlock(located(begin, index), test, body, false))

────────────────────
_ do for-block SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. clause = index + 2
. arms = arm-start(tape.after(clause), close, true)
. or-count Size = 0
. arm = arms
while arm < close
    if head(arm) == .or-for-head
        or-count += 1
    arm = tape.after(arm)
. head-loop = for-group(index, begin, clause, tape.after(clause), arms, arms, close)
. alternatives = scratch-array'SyntaxId(tree, or-count)
. filled Size = 0
arm = arms
while arm < close
    if head(arm) == .or-for-head
        . arm-begin = begin-at(arm)
        . arm-close = tape.close-of(arm)
        alternatives[filled] = make-loop-or
            - tree
            - for-group
                - arm
                - arm-begin
                - arm + 2
                - tape.after(arm + 2)
                - arm-close
                - tape.after(arm)
                - close
        filled += 1
    arm = tape.after(arm)
linked-list-tail(tree, head-loop, scratch-items(alternatives, filled))
= head-loop

────────────────────
_ do for-group SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - clause Index
    - rows-first Index
    - rows-end Index
    - and-first Index
    - close Index

. and-count Size = 0
. arm = and-first
while arm < close && head(arm) == .and-for-head
    and-count += 1
    arm = tape.after(arm)
. head-loop = loop-head(clause)
. joined = scratch-array'SyntaxId(tree, and-count)
. filled Size = 0
. body-owner = index
. body-first = rows-first
. body-end = rows-end
arm = and-first
while arm < close && head(arm) == .and-for-head
    joined[filled] = loop-head(arm + 2)
    filled += 1
    body-owner = arm
    body-first = tape.after(arm + 2)
    body-end = tape.close-of(arm)
    arm = tape.after(arm)
linked-list-tail(tree, head-loop, scratch-items(joined, filled))
. body SyntaxId = 0
if body-first < body-end
    body = arm-body(begin, body-owner, body-first, body-end)
= tree.append(ASTForBlock(located(begin, index), head-loop, body, 0))

────────────────────
_ do joined-sources Index ?! YumiSyntaxError
    - loop SyntaxId
    - first Index
    - close Index

. count Size = 0
. arm = first
while arm < close && head(arm) == .and-for-head
    count += 1
    arm = tape.after(arm)
. joined = scratch-array'SyntaxId(tree, count)
. filled Size = 0
arm = first
while filled < count
    joined[filled] = loop-head(arm + 2)
    filled += 1
    arm = tape.after(arm)
linked-list-tail(tree, loop, scratch-items(joined, filled))
= arm

────────────────────
_ do loop-head SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. close = tape.close-of(index)
. kind = head(index)
. target = index + 2
. is-sourced = kind == .in-head || kind == .on-head
?! unsupported-error(index) if !is-sourced && kind != .each-head
. is-subscriber = kind == .on-head
. is-unbound = is-sourced && is-unbound-source(index)
. pattern-id SyntaxId = if is-unbound then 0 else loop-pattern(target)
. next = tape.after(target)
. container SyntaxId = 0
if is-unbound
    container = expression(target)
else if is-sourced
    container = expression(next)
    next = tape.after(next)
. clauses = loop-clauses(next, close)
= tree.append
    - ASTLoop(located(begin, index), pattern-id, container, clauses, is-subscriber, false, 0)

────────────────────
_ do selected SyntaxId ?! YumiSyntaxError
    - value SyntaxId
    - index Index
    - loc MatchLocation

. kind = head(index)
=? tree.append(ASTStreamMatch(loc, tree.append(ASTStreamTransform(loc, stream-pattern(index + 2), value, false)))) if kind == .tilde-head
?! unsupported-error(index) if kind != .alternative-head && kind != .every-match-head
= tree.append
    - ASTStructureMatch(loc, tree.append(ASTTypeTransform(loc, value, pattern(index + 2), false)))

────────────────────
_ do loop-pattern SyntaxId ?! YumiSyntaxError
    - index Index

=? stream-pattern(index + 2) if head(index) == .tilde-head
if head(index) == .alternative-head && count-from(index + 2, tape.close-of(index)) == 1
    = tree.append(ASTStructureMatch(located(begin-at(index), index), pattern(index + 2)))
= pattern(index)

────────────────────
_ do loop-clauses SyntaxId ?! YumiSyntaxError
    - first Index
    - close Index

=? 0 if first >= close
. clauses = scratch-array'SyntaxId(tree, count-from(first, close))
. filled Size = 0
. index = first
while index < close
    . begin = begin-at(index)
    . kind = head(index)
    . op = clause-operator(index)
    . expr = expression(index + 2)
    clauses[filled] = tree.append(ASTClause(located(begin, index), op, expr, 0))
    filled += 1
    index = tape.after(index)
. items = scratch-items(clauses, filled)
linked-list-tail(tree, items[0], items[1 .. < filled])
= items[0]

────────────────────
_ do clause-operator ClauseOperator ?! YumiSyntaxError
    - index Index

do match? head(index)
    |= .when-head
        = .when-clause
    |= .whenever-head
        = .whenever-clause
    |= .while-head
        = .while-clause
    |= .until-head
        = .until-clause
    |= .keyed-by-head
        = .keyed-by-clause
?! unsupported-error(index)

────────────────────
_ do iterator-block SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. loc = located(begin, index)
. initial = index + 2
?! named-source-error(initial, "(iterate …)", "(in source)", "") if !is-unbound-source(initial)
. container-index = initial + 2
. container = expression(container-index)
. clauses = loop-clauses(tape.after(container-index), tape.close-of(initial))
. args = scratch-array'SyntaxId(tree, count-from(tape.after(initial), close))
. filled Size = 0
. item = tape.after(initial)
while item < close
    args[filled] = iterator-arg(item)
    filled += 1
    item = tape.after(item)
. initial-clauses SyntaxId? = clauses if clauses != 0
= make-iterator-block
    - tree
    - loc
    - container
    - scratch-items(args, filled)
    - head(initial) == .on-head
    - null
    - initial-clauses

────────────────────
_ do iterator-arg SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. loc = located(begin, index)
. close = tape.close-of(index)
. kind = head(index)
. first = index + 2
if kind == .and-for-head
    . inner = head(first)
    =? loop-and-list(first) if inner == .in-head || inner == .on-head || is-each || is-joined(first)
    .. is-each = inner == .each-head
    = tree.append(ASTClause(loc, clause-operator(first), multi(first + 2), 0))
if kind == .or-for-head
    . has-loop = first < close && (is-in-head || head(first) == .on-head || is-joined(first))
        .. is-in-head = head(first) == .in-head
    . loop = if has-loop then loop-and-list(first) else 0
    . body = optional-block(begin, index, if has-loop then tape.after(first) else first, close)
    = tree.append(ASTIteratorExpression(loc, loop, tree.syntax-or-invalid(body), 0))
=? multi(index) if kind == .block-head || kind == .inline-head
= tree.append(ASTClause(loc, clause-operator(index), multi(first), 0))

────────────────────
_ do do-block SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. loc = located(begin, index)
. first = index + 2
. scopes = first
while scopes < close && tape.is-atom(scopes) && bytes[tape.start(scopes)] == 64
    scopes = tape.after(scopes)
. rows = scopes
while rows < close && is-scope(rows)
    rows = tape.after(rows)
. sections = scope-of(scopes, rows)
if sections
    = sectioned-do(tree, loc, sections, DoBody(arm-body(begin, index, rows, close), annotation-atoms(first, scopes)))
. body = do-body(first, close, begin, index)
. masks = do-annotation-masks(loc, body.annotations)
= tree.append(ASTDoBlock(loc, body.body, masks.effects, masks.features))

────────────────────
_ is-scope Bool
    - index Index

|? tape.is-atom(index)
    false
|? head(index) == .with-head
    count-from(index + 2, tape.close-of(index)) == 2
??
    head(index) == .without-head

────────────────────
_ do scope-of SectionsPartial? ?! YumiSyntaxError
    - first Index
    - end Index

. named Size = 0
. bound Size = 0
. item = first
while item < end
    if is-scope(item) && head(item) == .without-head
        named += count-from(item + 2, tape.close-of(item))
    else if is-scope(item)
        bound += 1
    item = tape.after(item)
=? null if named == 0 && bound == 0
. names = scratch-array'Atom(tree, named)
. bindings = scratch-array'StackBindingPartial(tree, bound)
. named-filled Size = 0
. bound-filled Size = 0
item = first
while item < end
    if is-scope(item) && head(item) == .without-head
        . name = item + 2
        while name < tape.close-of(item)
            names[named-filled] = atom-at(name, 0)
            named-filled += 1
            name = tape.after(name)
    else if is-scope(item)
        bindings[bound-filled] = StackBindingPartial(atom-at(item + 2, 0), expression(tape.after(item + 2)))
        bound-filled += 1
    item = tape.after(item)
= SectionsPartial(scratch-items(names, named-filled), scratch-items(bindings, bound-filled))

────────────────────
_ do do-body DoBody ?! YumiSyntaxError
    - first Index
    - close Index
    - begin TokenLocation
    - owner Index

. count Size = 0
. index = first
while index < close && tape.is-atom(index) && bytes[tape.start(index)] == 64
    count += 1
    index = tape.after(index)
. annotations = scratch-array'Atom(tree, count)
. filled Size = 0
. annotation = first
while annotation < index
    annotations[filled] = annotation-at(annotation)
    filled += 1
    annotation = tape.after(annotation)
= DoBody(arm-body(begin, owner, index, close), scratch-items(annotations, filled))

────────────────────
_ do arm-body SyntaxId ?! YumiSyntaxError
    - begin TokenLocation
    - owner Index
    - first Index
    - close Index

if first < close && tape.after(first) == close && head(first) == .inline-head
    = multi(first + 2)
. statements = rows(first, close)
= located-block(tree, located(begin, owner), block-with-statements(tree, statements))

────────────────────
_ do rows ImmutableArray'SyntaxId ?! YumiSyntaxError
    - first Index
    - close Index

. items = scratch-array'SyntaxId(tree, count-from(first, close))
. count Size = 0
. index = first
while index < close
    . made = statement(index)
    if made
        items[count] = made
        count += 1
    index = tape.after(index)
= scratch-items(items, count)

────────────────────
_ do multi SyntaxId ?! YumiSyntaxError
    - index Index

=? expression(index) if !tape.is-open(index)
= multi-from(index, head(index), begin-at(index))

────────────────────
_ do multi-from SyntaxId ?! YumiSyntaxError
    - index Index
    - kind BrixHead
    - begin TokenLocation

. close = tape.close-of(index)
. first = index + 2
do match? kind
    |= .block-head
        . statements = rows(first, close)
        = located-block(tree, located(begin, index), block-with-statements(tree, statements))
    |= .inline-head
        = multi(first)
    |= .print-word-head
        . value = multi(first)
        . loc = located(begin, index)
        = tree.append(ASTPrint(loc, maybe-optional(tree, loc, value, is-optional(index))))
    |= .use-head
        . value = multi(first)
        . loc = located(begin, index)
        = tree.append(ASTUseExpression(loc, maybe-optional(tree, loc, value, is-optional(index))))
    |= .closure-head
        = closure(index, begin)
    |= .do-new-head
        = task-block(index, begin, false)
    |= .do-new-thread-head
        = task-block(index, begin, true)
    |= .for-head
        = for-block(index, begin)
    |= .latest-head
        . value = multi(first)
        = tree.append(ASTLatestExpression(located(begin, index), value))
    |= .match-head
        . subject = expression(first)
        . body = arm-body(begin, index, tape.after(first), close)
        = make-match-block(tree, located(begin, index), subject, body, is-optional(index))
    |= .case-head
        = case-arm(index, begin, false)
    |= .case-union-head
        = case-arm(index, begin, true)
    |= .case-if-head
        = case-test(index, begin, false, false)
    |= .case-union-if-head
        = case-test(index, begin, true, false)
    |= .case-equals-head
        = case-test(index, begin, false, true)
    |= .case-union-equals-head
        = case-test(index, begin, true, true)
    |= .default-head
        . loc = located(begin, index)
        . value = if first < close && tape.after(first) == close && head(first) == .inline-head then expression(first + 2) else located-block(tree, loc, block-with-statements(tree, rows(first, close)))
        = tree.append(ASTStructureMatch(loc, tree.append(ASTTypeTransform(loc, value, 0, false))))
    |= .case-each-head
        . loc = located(begin, index)
        . target = first + 2
        . container = expression(tape.after(target))
        . clauses = loop-clauses(tape.after(tape.after(target)), tape.close-of(first))
        . body = optional-block(begin, index, tape.after(first), close)
        . binding = tree.append(ASTStructureMatch(loc, pattern(target)))
        = make-iterator-line
            - tree
            - loc
            - container
            - head(first) == .on-head
            - body
            - binding
            - clauses
            - null
            - null
    |= .paragraph-head
        = paragraph(index, begin)
    |= .header-head
        = tree.append
            - ASTHeaderExpression(located(begin, index), expression(first), RowRange'SyntaxId())
    |= .bullet-head
        = tree.append
            - ASTBulletExpression(located(begin, index), multi(first), 0, false, is-optional(index))
    |= .bullet-many-head
        = tree.append
            - ASTBulletExpression(located(begin, index), multi(first), 0, true, is-optional(index))
    |= .tilde-head
        = stream-match-block(index, begin)
    |= .machine-head
        = tree.append
            - ASTStateMachine(located(begin, index), tree.store-children(rows(first, close)))
    |= .state-head
        = state-step(index, begin, false)
    |= .then-head
        = state-step(index, begin, true)
    |= .else-state-head
        . name = state-target-name(first)
        . values = state-target-values(first)
        = tree.append(ASTStateFallback(located(begin, index), name, tree.store-children(values)))
    |= .with-head
        = tree.make-pattern-helper(located(begin, index), expression(first))
    |= .markup-head
        = markup(index, begin)
    |= .slot-outlet-head
        = slot-outlet(index, begin)
    |= .slot-forward-head
        . loc = located(begin, index)
        . name = identifier(first)
        . outlet = tree.append
            - ASTSlotOutlet(loc, name, 0, 0, RowRange'SyntaxId(), RowRange'SyntaxId(), 0)
        = tree.append(ASTMarkupSlotForward(loc, name, outlet))
    |= .scope-head
        . target = expression(first)
        . statements = rows(tape.after(first), close)
        . loc = located(begin, index)
        . block = located-block(tree, loc, block-with-statements(tree, statements))
        . spanned = MatchLocation(tree.nodes.loc[target].begin, loc.end)
        = auto-call
            - tree
            - spanned
            - target
            - ImmutableArray'SyntaxId()
            - sequence-singleton(tree, block)
            - false
. assign-op = brix-assign-operator(kind)
if assign-op != .no-op && tape.after(first) < close
    . left = expression(first)
    . right = multi(tape.after(first))
    if assign-op == .bind-op && !is-place(right)
        ?! YumiSyntaxError(tree.location(right), "The place of “<->” is a name or a chain of members, written without “#”, as in “(<-> value (. settings volume))”")
    = make-assignment(tree, located(begin, index), assign-op, left, right, is-optional(index))
= expression-from(index, kind, begin)

────────────────────
_ do expression SyntaxId ?! YumiSyntaxError
    - index Index

=? atom-expression(index) if tape.is-atom(index)
=? text(index) if tape.is-text(index)
= expression-from(index, head(index), begin-at(index))

────────────────────
_ do expression-from SyntaxId ?! YumiSyntaxError
    - index Index
    - kind BrixHead
    - begin TokenLocation

. close = tape.close-of(index)
. first = index + 2
do match? kind
    |= .call-head
        = call(index, begin)
    |= .member-head
        = members(index, begin)
    |= .optional-member-head
        = member(index, begin, true, false)
    |= .loop-member-head
        = member(index, begin, false, true)
    |= .index-head
        . object = first
        . selector = tape.after(object)
        if selector >= close
            . buffer = type-buffer(tree, reduce-type(object), tree.atom("Array"))
            = tree.append
                - ASTCallExpression(located(begin, index), buffer, RowRange'SyntaxId(), 0, false)
        . target = expression(object)
        . chosen = expression(selector)
        = tree.append(ASTIndexExpression(located(begin, index), target, chosen, false))
    |= .optional-index-head
        . target = expression(first)
        . chosen = expression(tape.after(first))
        = tree.append(ASTIndexExpression(located(begin, index), target, chosen, true))
    |= .force-head
        . target = expression(first)
        = tree.append(ASTUnaryExpression(located(begin, index), .optional-force-op, target))
    |= .of-head
        =? reduce-type-from(index, kind, begin) if is-type-name(first)
        . callee = expression(first)
        . params = type-arguments(tape.after(first), close)
        = tree.make-call(located(begin, index), callee, params, ImmutableArray'SyntaxId(), false)
    |= .str-head
        = string(index, begin)
    |= .char-head
        . value = tape.text-value(first)
        . loc = located(begin, index)
        ?! YumiSyntaxError(loc, "(char …) takes a text of one character, as in (char \"a\"), but this one has ${value.length}")
            if value.length != 1
        = tree.append
            - ASTInteger
                - loc
                - tree.store-string(character-literal-string(loc, value[0]))
                - tree.atom("(char)")
    |= .list-head
        =? tree.append(ASTList(located(begin, index), RowRange'SyntaxId())) if first >= close
        . items = expressions(first, close)
        = tree.append(ASTList(located(begin, index), tree.store-children(items)))
    |= .tuple-head
        . items = expressions(first, close)
        = tuple-maybe(tree, located(begin, index), items)
    |= .stream-head
        . value = expression(first)
        = tree.append(ASTIterableExpression(located(begin, index), value))
    |= .optional-head
        = reduce-type-from(index, kind, begin)
    |= .channel-head
        . channel = type-channel(tree, reduce-type(first), tree.atom("SyncChannel"))
        = tree.append
            - ASTCallExpression(located(begin, index), channel, RowRange'SyntaxId(), 0, false)
    |= .range-through-head
        = range(index, begin, .range-through-op)
    |= .range-to-head
        = range(index, begin, .range-to-op)
    |= .range-open-head
        = open-range(index, begin)
    |= .closure-head
        = closure(index, begin)
    |= .print-word-head
        . value = expression(first)
        . loc = located(begin, index)
        = tree.append(ASTPrint(loc, maybe-optional(tree, loc, value, is-optional(index))))
    |= .catch-head
        . body = expression(first)
        =? tree.append(ASTCatchOptionalExpression(located(begin, index), body)) if is-optional-catch
        .. is-optional-catch = is-optional(index)
        = tree.append(ASTCatchExpression(located(begin, index), body, true, RowRange'SyntaxId()))
    |= .latest-head
        . value = expression(first)
        = tree.append(ASTLatestExpression(located(begin, index), value))
    |= .in-head
        = iterator(index, begin, false)
    |= .on-head
        = iterator(index, begin, true)
    |= .tilde-head
        = stream-match-block(index, begin)
    |= .alternative-head
        ?! unsupported-error(index) if tape.after(first) != close
        = tree.append(ASTStructureMatch(located(begin, index), pattern(first)))
    |= .every-match-head
        = tree.append(ASTStructureMatch(located(begin, index), pattern(first)))
    |= .select-head
        = selected(expression(first), tape.after(first), located(begin, index))
    |= .iterate-head
        = iterator-block(index, begin)
    |= .only-if-head
        . value = expression(first)
        . condition = expression(tape.after(first) + 2)
        = binary-op(tree, located(begin, index), .if-op, value, condition)
    |= .if-expr-head
        . test = expression(first)
        . value = expression(tape.after(first))
        . otherwise = expression(tape.after(tape.after(first)))
        = make-conditional-value(tree, located(begin, index), test, value, otherwise)
    |= .shape-head
        . shape = expression(first)
        = make-shaped(tree, located(begin, index), shape, expression(tape.after(first)))
    |= .write-head
        =? prefix(index, begin, .read-op) if tape.after(first) >= close
        = compose(index, begin, false)
    |= .optional-write-head
        = compose(index, begin, true)
    |= .not-word-head
        = prefix(index, begin, .not-op)
    |= .type-of-head
        = prefix(index, begin, .type-of-op)
    |= .facts-of-head
        = prefix(index, begin, .facts-of-op)
    |= .subtract-head
        =? prefix(index, begin, .negative-op) if tape.after(first) >= close
    |= .subtract-assign-head
        =? prefix(index, begin, .delete-op) if tape.after(first) >= close
    |= .markup-head
        ?! inline-markup-error(index)
. assign-op = brix-assign-operator(kind)
if assign-op != .no-op && tape.after(first) < close
    . left = expression(first)
    . right = expression(tape.after(first))
    = make-assignment(tree, located(begin, index), assign-op, left, right, is-optional(index))
. op = brix-binary-operator(kind)
=? binary(index, begin, op) if op != .no-op
=? user-binary(index, begin) if is-user-operator(index + 1)
?! unsupported-error(index)

────────────────────
_ do expressions ImmutableArray'SyntaxId ?! YumiSyntaxError
    - first Index
    - close Index

. items = scratch-array'SyntaxId(tree, count-from(first, close))
. count Size = 0
. index = first
while index < close
    items[count] = expression(index)
    count += 1
    index = tape.after(index)
= scratch-items(items, count)

────────────────────
_ do atom-expression SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. first = tape.start(index)
. last = tape.end(index)
. lead = bytes[first]
. loc = located(begin, index)
=? number(index, loc) if is-number(first, last)
if lead == 39
    if last - first > 2 && bytes[first + 1] == 39
        = tree.append(ASTTypeIdentifier(loc, tree.atom-bytes(bytes, first + 2, last), true))
    . value = bytes.slice-string(first + 1 .. < last - 1)
    = tree.append
        - ASTInteger
            - loc
            - tree.store-string(character-literal-string(loc, value[0]))
            - tree.atom("(char)")
=? tree.append(ASTIdentifier(loc, tree.atom-bytes(bytes, first + 1, last), true)) if lead == 35
=? tree.append(ASTRefIdentifier(loc, tree.atom-bytes(bytes, first + 1, last))) if lead == 38
if lead == 46
    =? tree.append(ASTAnonymousCase(loc, tree.atom-bytes(bytes, first + 2, last), RowRange'SyntaxId(), null)) if last - first > 2 && bytes[first + 1] == 46
    = tree.append(ASTSymbol(loc, tree.atom-bytes(bytes, first + 1, last)))
=? tree.append(ASTStyleReadExpression(loc, 0, tree.atom-bytes(bytes, first + 1, last), false)) if lead == 36
=? tree.append(ASTMarkupReadExpression(loc, 0, tree.atom-bytes(bytes, first + 1, last), false)) if lead == 37
=? tree.append(ASTCIdentifier(loc, tree.atom-bytes(bytes, first + 2, last))) if is-c-identifier
.. is-c-identifier = lead == 67 && last - first > 2 && bytes[first + 1] == 58
=? tree.append(ASTTypeIdentifier(loc, tree.atom-bytes(bytes, first, last), false)) if is-capital
.. is-capital = lead >= 65 && lead <= 90
= tree.append(ASTIdentifier(loc, tree.atom-bytes(bytes, first, last), false))

────────────────────
_ do identifier SyntaxId
    - index Index

. begin = begin-at(index)
= tree.append(ASTIdentifier(located(begin, index), atom-at(index, 0), false))

────────────────────
_ do text SyntaxId
    - index Index

. begin = begin-at(index)
. value = tape.text-value(index)
= tree.append(ASTString(located(begin, index), tree.store-string(value)))

────────────────────
_ do string SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. parts = expressions(index + 2, tape.close-of(index))
= concat-string-parts(tree, located(begin, index), parts)

────────────────────
_ is-number Bool
    - first Index
    - last Index

|? lead >= 48 && lead <= 57
    true
|? last - first < 2
    false
|? lead == 46
    next >= 48 && next <= 57
|? lead != 45
    false
|? next >= 48 && next <= 57
    true
??
    next == 46 && last - first > 2 && bytes[first + 2] >= 48 && bytes[first + 2] <= 57

.. lead = bytes[first]
.. next = bytes[first + 1]

────────────────────
_ do number SyntaxId ?! YumiSyntaxError
    - index Index
    - loc MatchLocation

. first = tape.start(index)
. last = tape.end(index)
. is-negative = bytes[first] == 45
. cursor = if is-negative then first + 1 else first
if cursor + 1 < last && bytes[cursor] == 48 && bytes[cursor + 1] == 120
    . digits = strip-numeric-separators(bytes.slice-string(cursor + 2 .. < last))
    . value = hex-integer-value(digits)
    . shown = if is-negative then negated-number-text(value, 1) else value
    = tree.append(ASTInteger(loc, tree.store-string(shown), hex-integer-unit(tree, digits)))
. integer-start = cursor
while cursor < last && (is-digit(bytes[cursor]) || bytes[cursor] == 39)
    cursor += 1
. integer = if cursor == integer-start then "0" else strip-numeric-separators(tree.text-arena.copy-span(bytes, integer-start, cursor))
. tail String? = null
if cursor < last && bytes[cursor] == 46
    . fraction-start = cursor + 1
    cursor += 1
    while cursor < last && (is-digit(bytes[cursor]) || bytes[cursor] == 39)
        cursor += 1
    tail = ".${strip-numeric-separators(bytes.slice-string(fraction-start .. < cursor))}"
if cursor < last && (bytes[cursor] == 101 || bytes[cursor] == 69) && has-exponent(cursor, last)
    . exponent-start = cursor
    cursor += 1
    if bytes[cursor] == 43 || bytes[cursor] == 45
        cursor += 1
    while cursor < last && (is-digit(bytes[cursor]) || bytes[cursor] == 39)
        cursor += 1
    . exponent = strip-numeric-separators(bytes.slice-string(exponent-start .. < cursor))
    tail = "${tail ?? ""}$exponent"
. unit Atom? = null
if cursor < last
    unit = tree.atom-bytes(bytes, cursor, last)
. made = make-decimal-literal(tree, loc, integer, tail, unit)
=? made if !is-negative
. negated = negative-number-string(tree, sequence-singleton(tree, Operator.negative-op), made)
= negative-number(tree, loc, made, negated!)

────────────────────
_ has-exponent Bool
    - cursor Index
    - last Index

|? next >= last
    false
|? bytes[next] != 43 && bytes[next] != 45
    is-digit(bytes[next])
??
    next + 1 < last && is-digit(bytes[next + 1])

.. next = cursor + 1

────────────────────
_ do call SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. callee-index = index + 2
. first = tape.after(callee-index)
if tape.is-atom(callee-index) && is-anonymous-case(callee-index)
    . args = expressions(first, close)
    . name = tree.atom-bytes(bytes, tape.start(callee-index) + 2, tape.end(callee-index))
    = tree.append(ASTAnonymousCase(located(begin, index), name, tree.store-children(args), null))
. callee SyntaxId = 0
. params = ImmutableArray'SyntaxId()
if head(callee-index) == .of-head && !is-type-name(callee-index + 2)
    callee = expression(callee-index + 2)
    params = type-arguments(tape.after(callee-index + 2), tape.close-of(callee-index))
else
    callee = expression(callee-index)
. positional-count Size = 0
. other-count Size = 0
. is-curried = false
. item = first
while item < close
    if atom-is(item, "...")
        is-curried = true
    else if is-call-extra(item)
        other-count += 1
    else
        positional-count += 1
    item = tape.after(item)
. positional = scratch-array'SyntaxId(tree, positional-count)
. others = scratch-array'SyntaxId(tree, other-count)
. positional-filled Size = 0
. other-filled Size = 0
item = first
while item < close
    if !atom-is(item, "...")
        if is-call-extra(item)
            others[other-filled] = call-extra(item)
            other-filled += 1
        else
            positional[positional-filled] = expression(item)
            positional-filled += 1
    item = tape.after(item)
. loc = located(begin, index)
. arguments = arguments-from-expressions(tree, loc, scratch-items(positional, positional-filled))
. made = tree.make-call(loc, callee, params, arguments, is-curried)
=? made if other-filled == 0
= auto-call(tree, loc, made, ImmutableArray'SyntaxId(), scratch-items(others, other-filled), false)

────────────────────
_ is-call-extra Bool
    - index Index

|? !tape.is-open(index)
    false
??
    is-named(index) || kind == .entry-head || kind == .block-head || kind == .inline-head

.. kind = head(index)

────────────────────
_ do call-extra SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. kind = head(index)
do match? kind
    |= .entry-head
        = entry(index, begin)
    |= .block-head
        = multi(index)
    |= .inline-head
        = multi(index + 2)
= named-argument(index, begin)

────────────────────
_ is-anonymous-case Bool
    - index Index

tape.end(index) - first > 2 && bytes[first] == 46 && bytes[first + 1] == 46 && bytes[first + 2] != 46

.. first = tape.start(index)

────────────────────
_ do members SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. object = index + 2
. is-type = is-type-name(object) || (head(object) == .of-head && is-type-name(object + 2))
. left = expression(object)
. name = tape.after(object)
while name < close
    if is-type && is-type-member(name)
        left = associated-type(left, name, begin)
    else
        is-type = false
        left = get(left, name, begin, false, false)
        if tape.after(name) >= close
            left = placed(left, located(begin, index))
    name = tape.after(name)
= left

────────────────────
_ do member SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - is-optional Bool
    - is-loop Bool

. close = tape.close-of(index)
. left = expression(index + 2)
. name = tape.after(index + 2)
while name < close
    left = get(left, name, begin, is-optional, is-loop)
    name = tape.after(name)
= placed(left, located(begin, index))

────────────────────
_ do get SyntaxId
    - left SyntaxId
    - name Index
    - begin TokenLocation
    - is-optional Bool
    - is-loop Bool

. first = tape.start(name)
. last = tape.end(name)
. lead = bytes[first]
if lead == 36
    = tree.append
        - ASTStyleReadExpression
            - located(begin, name)
            - left
            - tree.atom-bytes(bytes, first + 1, last)
            - is-optional
if lead == 37
    = tree.append
        - ASTMarkupReadExpression
            - located(begin, name)
            - left
            - tree.atom-bytes(bytes, first + 1, last)
            - is-optional
. is-tracked = lead == 35
. atom = tree.atom-bytes(bytes, if is-tracked then first + 1 else first, last)
= optional-get(tree, left, atom, is-tracked, is-optional, is-loop)

────────────────────
_ is-type-member Bool
    - index Index

if is-atom-member then is-type-name(index) else head(index) == .of-head && is-type-name(index + 2)

.. is-atom-member = tape.is-atom(index)

────────────────────
_ do associated-type SyntaxId ?! YumiSyntaxError
    - owner SyntaxId
    - index Index
    - begin TokenLocation

if tape.is-atom(index)
    = tree.append
        - ASTTypeAssociated(located(begin, index), owner, atom-at(index, 0), RowRange'SyntaxId())
. args = type-arguments(tape.after(index + 2), tape.close-of(index))
= tree.append
    - ASTTypeAssociated
        - located(begin, index)
        - owner
        - atom-at(index + 2, 0)
        - tree.store-children(args)

────────────────────
_ do range SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - op Operator

. close = tape.close-of(index)
. left = expression(index + 2)
. right-index = tape.after(index + 2)
. right = expression(right-index)
. step = tape.after(right-index)
. increment SyntaxId = 0
if step < close
    increment = expression(step + 2)
= tree.append(ASTRangeExpression(located(begin, index), op, left, right, increment))

────────────────────
_ do open-range SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. first = index + 2
if head(first) == .by-head
    . increment = expression(first + 2)
    . start = range-position(tree, "first")
    . end = range-position(tree, "end")
    = tree.append(ASTRangeExpression(located(begin, index), .range-to-op, start, end, increment))
. left SyntaxId = 0
. right SyntaxId = 0
. next = tape.after(first)
if atom-is(first, "_")
    left = range-position(tree, "first")
    right = expression(next)
    next = tape.after(next)
else
    left = expression(first)
    right = range-position(tree, "end")
. increment SyntaxId = 0
if next < close
    increment = expression(next + 2)
= tree.append(ASTRangeExpression(located(begin, index), .range-to-op, left, right, increment))

────────────────────
_ do closure SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. group = index + 1 + 1
. group-close = tape.close-of(group)
. args = scratch-array'SyntaxId(tree, count-from(group + 1, group-close))
. filled Size = 0
. arg = group + 1
while arg < group-close
    args[filled] = closure-argument(arg)
    filled += 1
    arg = tape.after(arg)
. value = tape.after(group)
. is-imperative = value < close && atom-is(value, ":do")
if is-imperative
    value = tape.after(value)
. body SyntaxId? = null
if value < close
    body = multi(value)
= make-closure(tree, located(begin, index), is-imperative, scratch-items(args, filled), body)

────────────────────
_ do closure-argument SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. name = if tape.is-open(index) then index + 2 else index
. first = tape.start(name)
. is-variadic = is-dotted && bytes[first + 1] == 46 && bytes[first + 2] == 46
    .. is-dotted = tape.end(name) - first > 3 && bytes[first] == 46
. id = tree.append
    - ASTIdentifier
        - located(begin, name)
        - tree.atom-bytes(bytes, if is-variadic then first + 3 else first, tape.end(name))
        - false
. type SyntaxId? = null
if tape.is-open(index)
    type = reduce-type(tape.after(name))
= make-closure-argument(tree, located(begin, index), id, is-variadic, type)

────────────────────
_ do iterator SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - is-subscriber Bool

. close = tape.close-of(index)
. body = expression(index + 2)
. container-index = tape.after(index + 2)
. container = expression(container-index)
. clauses = loop-clauses(tape.after(container-index), close)
. loc = located(begin, index)
. loop = tree.append(ASTLoop(loc, 0, container, clauses, is-subscriber, false, 0))
= make-iterator-from-partial(tree, loc, body, loop)

────────────────────
_ do prefix SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - op Operator

. operand = expression(index + 2)
. ops = sequence-singleton(tree, op)
= reduce-prefix-ops
    - tree
    - located(begin, index)
    - ops
    - operand
    - negative-number-string(tree, ops, operand)

────────────────────
_ do compose SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - is-optional Bool

. close = tape.close-of(index)
. accumulated = expression(index + 2)
. operand = tape.after(index + 2)
while operand < close
    accumulated = binary-op
        - tree
        - located(begin, index)
        - .write-op
        - accumulated
        - expression(operand)
        - is-optional
        - tree.atom("<-write")
    operand = tape.after(operand)
= accumulated

────────────────────
_ do binary SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - op Operator

=? comparison(index, begin) if is-glt-compare-op(op)
. close = tape.close-of(index)
. operand = index + 2
. accumulated = expression(operand)
operand = tape.after(operand)
while operand < close
    . next = tape.after(operand)
    if op == .stream-pattern-pipe-op && next < close && head(next) == .with-head
        . stage = tree.append
            - ASTStreamMatch
                - located(begin-at(operand), operand)
                - stream-pattern(operand)
                - false
                - expression(next + 2)
        accumulated = binary-op(tree, located(begin, index), op, accumulated, stage)
        operand = tape.after(next)
        continue
    . right = binary-right(operand, op)
    accumulated = binary-op(tree, located(begin, index), op, accumulated, right)
    operand = next
= accumulated

────────────────────
_ do comparison SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. count = comparison-count(index)
. links = scratch-array'(Operator, SyntaxId)(tree, count)
. seed = comparison-seed(index, links, count)
= reduce-glt-op(tree, located(begin, index), seed, scratch-items(links, count))

────────────────────
_ comparison-count Size
    - index Index

if is-comparison(first) then own + comparison-count(first) else own

.. first = index + 2
.. own = count-from(first, tape.close-of(index)) - 1

────────────────────
_ do comparison-seed SyntaxId ?! YumiSyntaxError
    - index Index
    - links Array'(Operator, SyntaxId)'ArenaBacking
    - end Size

. close = tape.close-of(index)
. op = brix-binary-operator(head(index))
. first = index + 2
. slot = end - (count-from(first, close) - 1)
. seed = if is-comparison(first) then comparison-seed(first, links, slot) else expression(first)
. operand = tape.after(first)
while operand < close
    . right = expression(operand)
    links[slot] = (op, right)
    slot += 1
    operand = tape.after(operand)
= seed

────────────────────
_ is-comparison Bool
    - index Index

tape.is-open(index) && is-glt-compare-op(brix-binary-operator(head(index)))

────────────────────
_ do binary-right SyntaxId ?! YumiSyntaxError
    - index Index
    - op Operator

=? reduce-type(index) if op == .as-op
=? tree.append(ASTStreamMatch(loc, stream-pattern(index), false, 0)) if is-pattern-pipe
.. loc = located(begin-at(index), index)
.. is-pattern-pipe = op == .stream-pattern-pipe-op
if op == .is-op || op == .is-not-op || is-exact-test || is-similar-test
    =? pattern(index) if tape.is-text(index) || atom-is(index, "_") || head(index) == .list-head || head(index) == .map-head || head(index) == .all-head || is-remainder-atom(index)
.. is-exact-test = op == .is-exactly-op || op == .is-not-exactly-op
.. is-similar-test = op == .is-similar-op || op == .is-not-similar-op
= expression(index)

────────────────────
_ do user-binary SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. mark = index + 1
. first = tape.start(mark)
. last = tape.end(mark)
. width Size = 1
while bytes[first + width] == 47
    width += 1
. op-name = tree.atom-bytes(bytes, first + width, last - width)
. operand = index + 2
. accumulated = expression(operand)
operand = tape.after(operand)
while operand < close
    . right = expression(operand)
    . loc = located(begin, index)
    . op = tree.append(ASTIdentifier(loc, op-name, false))
    accumulated = user-binary-op(tree, loc, op, accumulated, right)
    operand = tape.after(operand)
= accumulated

────────────────────
_ is-user-operator Bool
    - index Index

|? !tape.is-atom(index)
    false
??
    last - first > 2 && bytes[first] == 47 && bytes[last - 1] == 47 && bytes[first + 1] != 61

.. first = tape.start(index)
.. last = tape.end(index)

────────────────────
_ do pattern SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
. loc = located(begin, index)
=? tree.append(ASTTypeEquality(loc, text(index), false)) if tape.is-text(index)
if tape.is-atom(index)
    = atom-pattern(index, loc)
?! unsupported-error(index) if !tape.is-open(index)
. kind = head(index)
. close = tape.close-of(index)
. first = index + 2
do match? kind
    |= .capture-head
        . id = identifier(first)
        . bound = pattern(tape.after(first))
        = tree.append(ASTTypeCapture(loc, id, bound))
    |= .tuple-head
        . items = patterns(first, close)
        = make-pattern-tuple(tree, loc, items)
    |= .list-head
        . items = scratch-array'SyntaxId(tree, count-from(first, close))
        . count Size = 0
        . item = first
        while item < close
            items[count] = bracket-item(item)
            count += 1
            item = tape.after(item)
        = make-pattern-bracket(tree, loc, scratch-items(items, count))
    |= .map-head
        . pair = tree.append(ASTTypeMapItem(loc, pattern(first), pattern(tape.after(first))))
        = make-pattern-bracket(tree, loc, sequence-singleton(tree, pair))
    |= .optional-head
        . inner = pattern(first)
        = type-optional(tree, inner, tree.atom("Optional"))
    |= .index-head
        . inner = pattern(first)
        = type-buffer(tree, inner, tree.atom("Array"))
    |= .channel-head
        . inner = pattern(first)
        = type-channel(tree, inner, tree.atom("SyncChannel"))
    |= .stream-head
        . inner = pattern(first)
        = type-iterable(tree, inner, tree.atom("Stream"))
    |= .exact-head
        = tree.append(ASTTypeMatch(loc, pattern(first), .match-exactly))
    |= .similar-head
        = tree.append(ASTTypeMatch(loc, pattern(first), .match-similar))
    |= .all-head
        . head-pattern = pattern(first)
        = make-pattern-and-chain(tree, loc, head-pattern, patterns(tape.after(first), close))
    |= .alternative-head
        . accumulated = pattern(first)
        . item = tape.after(first)
        while item < close
            . right = pattern(item)
            accumulated = tree.append(ASTTypeOr(loc, accumulated, right))
            item = tape.after(item)
        = accumulated
    |= .predicate-head
        = tree.append(ASTTypePredicate(loc, expression(first), true))
    |= .str-head
        = tree.append(ASTTypeEquality(loc, string(index, begin), false))
    |= .char-head
        = tree.append(ASTTypeEquality(loc, expression(index), false))
    |= .call-head
        . callee = first
        . owner SyntaxId = 0
        . name = callee
        if head(callee) == .member-head
            name = last-item(callee + 2, tape.close-of(callee))
            owner = case-owner(callee, begin)
        . values = patterns(tape.after(callee), close)
        = tree.append
            - ASTTypeCase(loc, case-name(name), owner, make-pattern-tuple(tree, loc, values))
    |= .member-head
        . last = last-item(first, close)
        if tape.is-atom(last) && !is-type-name(last)
            = tree.append(ASTTypeCase(loc, case-name(last), case-owner(index, begin), 0))
        = reduce-type-from(index, kind, begin)
    |= .of-head
        = reduce-type-from(index, kind, begin)
    |= .fn-type-head
        = reduce-type-from(index, kind, begin)
. relation = pattern-relation(kind)
?! unsupported-error(index) if relation == .no-op
. accumulated = pattern(first)
. item = tape.after(first)
while item < close
    . right = pattern(item)
    accumulated = tree.append(ASTTypeRelation(loc, relation, accumulated, right))
    item = tape.after(item)
= accumulated

────────────────────
_ do case-owner SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation

. close = tape.close-of(index)
. first = index + 2
. last = last-item(first, close)
. owner = reduce-type(first)
. member = tape.after(first)
while member < last
    owner = associated-type(owner, member, begin)
    member = tape.after(member)
= owner

────────────────────
_ do case-name Atom
    - index Index

. first = tape.start(index)
= tree.atom-bytes(bytes, if bytes[first] == 46 then first + 1 else first, tape.end(index))

────────────────────
_ do last-item Index
    - first Index
    - close Index

. item = first
while tape.after(item) < close
    item = tape.after(item)
= item

────────────────────
_ do pattern-relation Operator
    - kind BrixHead

do match? kind
    |= .pattern-ancestor-head
        = .pattern-ancestor-op
    |= .pattern-parent-head
        = .pattern-parent-op
    |= .pattern-descendant-head
        = .pattern-descendant-op
    |= .divide-head
        = .pattern-child-op
    |= .print-head
        = .pattern-prev-sibling-op
    |= .concat-head
        = .pattern-next-sibling-op
= .no-op

────────────────────
_ do atom-pattern SyntaxId ?! YumiSyntaxError
    - index Index
    - loc MatchLocation

. first = tape.start(index)
. last = tape.end(index)
. lead = bytes[first]
=? tree.append(ASTTypeWildcard(loc)) if atom-is(index, "_")
=? tree.append(ASTTypeEquality(loc, number(index, loc), false)) if is-number(first, last)
if lead == 46
    if last - first >= 3 && bytes[first + 1] == 46 && bytes[first + 2] == 46
        . name SyntaxId = 0
        if last - first > 3
            name = tree.append(ASTIdentifier(loc, tree.atom-bytes(bytes, first + 3, last), false))
        = tree.append(ASTTypeRemainder(loc, name))
    =? tree.append(ASTTypeProperty(loc, tree.atom-bytes(bytes, first + 2, last))) if is-property
    .. is-property = last - first > 2 && bytes[first + 1] == 46
    = tree.append(ASTTypeCase(loc, tree.atom-bytes(bytes, first + 1, last), 0, 0))
=? tree.append(ASTTypeEquality(loc, tree.append(ASTIdentifier(loc, tree.atom-bytes(bytes, first + 1, last), false)), false)) if lead == 36
if lead == 39 && !(last - first > 2 && bytes[first + 1] == 39)
    = tree.append(ASTTypeEquality(loc, atom-expression(index), false))
=? tree.append(ASTTypeEquality(loc, identifier(index), false)) if is-bool
.. is-bool = atom-is(index, "true") || atom-is(index, "false")
=? reduce-type(index) if is-type-name(index)
= tree.append(ASTTypeCapture(loc, identifier(index), 0))

────────────────────
_ do bracket-item SyntaxId ?! YumiSyntaxError
    - index Index

=? pattern(index) if !tape.is-open(index) || head(index) != .assign-head
. left = index + 2
= tree.append
    - ASTTypeMapItem(located(begin-at(index), index), pattern(left), pattern(tape.after(left)))

────────────────────
_ do patterns ImmutableArray'SyntaxId ?! YumiSyntaxError
    - first Index
    - close Index

. items = scratch-array'SyntaxId(tree, count-from(first, close))
. count Size = 0
. index = first
while index < close
    items[count] = pattern(index)
    count += 1
    index = tape.after(index)
= scratch-items(items, count)

────────────────────
_ do reduce-type SyntaxId ?! YumiSyntaxError
    - index Index

. begin = begin-at(index)
if tape.is-atom(index)
    . first = tape.start(index)
    . last = tape.end(index)
    . loc = located(begin, index)
    =? tree.append(ASTTypeIdentifier(loc, tree.atom-bytes(bytes, first + 2, last), true)) if last - first > 2 && bytes[first] == 39 && bytes[first + 1] == 39
    = tree.append(ASTTypeIdentifier(loc, tree.atom-bytes(bytes, first, last), false))
?! unsupported-error(index) if !tape.is-open(index)
= reduce-type-from(index, head(index), begin)

────────────────────
_ do reduce-type-from SyntaxId ?! YumiSyntaxError
    - index Index
    - kind BrixHead
    - begin TokenLocation

. close = tape.close-of(index)
. first = index + 2
do match? kind
    |= .of-head
        . base = reduce-type(first)
        . args = type-arguments(tape.after(first), close)
        = tree.append(ASTTypeArguments(located(begin, index), base, tree.store-children(args)))
    |= .member-head
        . owner = reduce-type(first)
        . member = tape.after(first)
        while member < close
            owner = associated-type(owner, member, begin)
            member = tape.after(member)
        = owner
    |= .optional-head
        . inner = reduce-type(first)
        = type-optional(tree, inner, tree.atom("Optional"))
    |= .index-head
        . inner = reduce-type(first)
        = type-buffer(tree, inner, tree.atom("Array"))
    |= .channel-head
        . inner = reduce-type(first)
        = type-channel(tree, inner, tree.atom("SyncChannel"))
    |= .stream-head
        . inner = reduce-type(first)
        = type-iterable(tree, inner, tree.atom("Stream"))
    |= .tuple-head
        . items = type-captures(first, close)
        = type-tuple-maybe(tree, located(begin, index), items)
    |= .list-head
        . item = reduce-type(first)
        . loc = located(begin, index)
        . list = tree.append(ASTTypeIdentifier(loc, tree.atom("List"), false))
        = tree.append(ASTTypeArguments(loc, list, tree.store-child(item)))
    |= .map-head
        . key = reduce-type(first)
        . value = reduce-type(tape.after(first))
        . loc = located(begin, index)
        . map = tree.append(ASTTypeIdentifier(loc, tree.atom("Map"), false))
        = tree.append(ASTTypeArguments(loc, map, tree.store-child(key, value)))
    |= .fn-type-head
        = function-type(index, begin, false)
    |= .c-fn-type-head
        = function-type(index, begin, true)
    |= .c-struct-head
        . fields = scratch-array'SyntaxId(tree, count-from(first, close))
        . filled Size = 0
        . field = first
        while field < close
            . field-begin = begin-at(field)
            . id = identifier(field + 2)
            . field-type = reduce-type(tape.after(field + 2))
            fields[filled] = tree.append
                - ASTTypeCapture(located(field-begin, field), id, field-type)
            filled += 1
            field = tape.after(field)
        = tree.append
            - ASTTypeTuple
                - located(begin, index)
                - tree.store-children(scratch-items(fields, filled))
                - true
    |= .exact-head
        . inner = reduce-type(first)
        = tree.append(ASTTypeMatch(located(begin, index), inner, .match-exactly))
    |= .similar-head
        . inner = reduce-type(first)
        = tree.append(ASTTypeMatch(located(begin, index), inner, .match-similar))
?! unsupported-error(index)

────────────────────
_ do type-captures ImmutableArray'SyntaxId ?! YumiSyntaxError
    - first Index
    - close Index

. items = scratch-array'SyntaxId(tree, count-from(first, close))
. count Size = 0
. index = first
while index < close
    if tape.is-atom(index) && !is-type-name(index)
        . begin = begin-at(index)
        . id = identifier(index)
        items[count] = tree.append(ASTTypeCapture(located(begin, index), id, 0))
    else if head(index) == .capture-head
        . begin = begin-at(index)
        . id = identifier(index + 2)
        . bound = reduce-type(tape.after(index + 2))
        items[count] = tree.append(ASTTypeCapture(located(begin, index), id, bound))
    else
        items[count] = reduce-type(index)
    count += 1
    index = tape.after(index)
= scratch-items(items, count)

────────────────────
_ do type-arguments ImmutableArray'SyntaxId ?! YumiSyntaxError
    - first Index
    - close Index

. items = scratch-array'SyntaxId(tree, count-from(first, close))
. count Size = 0
. index = first
while index < close
    items[count] = reduce-type(index)
    count += 1
    index = tape.after(index)
= scratch-items(items, count)

────────────────────
_ do function-type SyntaxId ?! YumiSyntaxError
    - index Index
    - begin TokenLocation
    - is-c Bool

. close = tape.close-of(index)
. result = reduce-type(index + 2)
. error-count Size = 0
. param-count Size = 0
. item = tape.after(index + 2)
while item < close
    . kind = head(item)
    if kind == .raises-head
        error-count += 1
    else if kind == .param-head
        param-count += 1
    item = tape.after(item)
. errors = scratch-array'SyntaxId(tree, error-count)
. params = scratch-array'SyntaxId(tree, param-count)
. error-filled Size = 0
. param-filled Size = 0
item = tape.after(index + 2)
while item < close
    . kind = head(item)
    if kind == .raises-head
        errors[error-filled] = reduce-type(item + 2)
        error-filled += 1
    else if kind == .param-head
        params[param-filled] = parameter(item)
        param-filled += 1
    item = tape.after(item)
. stored-params = tree.store-children(scratch-items(params, param-filled))
. stored-errors = tree.store-children(scratch-items(errors, error-filled))
= tree.append(ASTTypeFunction(located(begin, index), result, stored-params, is-c, stored-errors))

────────────────────
_ is-type-name Bool
    - index Index

|? !tape.is-atom(index)
    false
|? lead >= 65 && lead <= 90 && !(lead == 67 && tape.end(index) - first > 1 && bytes[first + 1] == 58)
    true
??
    lead == 39 && tape.end(index) - first > 2 && bytes[first + 1] == 39

.. first = tape.start(index)
.. lead = bytes[first]

────────────────────
_ do count-from Size
    - first Index
    - close Index

. count Size = 0
. index = first
while index < close
    count += 1
    index = tape.after(index)
= count

────────────────────
_ head BrixHead @inline
    - index Index

heads.data[index] as BrixHead

────────────────────
_ is-remainder-atom Bool
    - index Index

|? !tape.is-atom(index)
    false
??
    tape.end(index) - first >= 3 && bytes[first] == 46 && bytes[first + 1] == 46 && bytes[first + 2] == 46

.. first = tape.start(index)

────────────────────
_ atom-is Bool
    - index Index
    - text String

tape.is-atom(index) && tape.atom-is(index, text)

────────────────────
_ do atom-at Atom
    - index Index
    - skip Size

= tree.atom-bytes(bytes, tape.start(index) + skip, tape.end(index))

────────────────────
_ begin-at TokenLocation
    - index Index

tape.token-location(index)

────────────────────
_ do placed SyntaxId
    - id SyntaxId
    - loc MatchLocation

tree.nodes.loc[id] = loc
= id

────────────────────
_ located MatchLocation
    - begin TokenLocation
    - index Index

MatchLocation(begin, TokenLocation(end.line, end.column - 1))

.. end = tape.token-end-location(index)

────────────────────
_ inline-markup-error YumiSyntaxError
    - index Index

YumiSyntaxError(MatchLocation(place, place), "(<> …) cannot be written inside an expression. Give it as a row: an argument row, as in (call f (block (arg (<> …)))), a named argument, as in (call f (:name (<> …))), or a bullet, as in (bullet (<> …)); or name it with (let name (<> …)) first.")

.. place = tape.token-location(index)

────────────────────
_ do is-place Bool
    - node SyntaxId

do match? tree.nodes[node]
    | .node-identifier(row)
        = !row.is-tracked
    | .node-get-expression(row)
        = !row.is-tracked && !row.is-optional && !row.is-loop && is-place(row.object)
= false

────────────────────
_ unsupported-error YumiSyntaxError
    - index Index

|? tape.is-atom(index)
    YumiSyntaxError(loc, "Brix atom “${tape.atom-text(index)}” is not supported here yet")
|? !tape.is-open(index)
    YumiSyntaxError(loc, "Brix text is not supported here yet")
|? !tape.is-atom(index + 1)
    YumiSyntaxError(loc, "Brix list is not supported here yet")
??
    YumiSyntaxError(loc, "Brix form “(${tape.atom-text(index + 1)} …)” is not supported yet")

.. place = tape.token-location(index)
.. loc = MatchLocation(place, place)

────────────────────
_ is-unbound-source Bool
    - index Index

|? next >= tape.close-of(index)
    true
|? !tape.is-open(next)
    false
??
    kind == .when-head || kind == .whenever-head || kind == .while-head || kind == .until-head || kind == .keyed-by-head

.. next = tape.after(index + 2)
.. kind = head(next)

────────────────────
_ named-source-error YumiSyntaxError
    - index Index
    - form String
    - spelling String
    - hint String

YumiSyntaxError(MatchLocation(place, place), "$form names no item, so its source is written `$spelling`, and its rows read the item as `each`.$hint")

.. place = tape.token-location(index + 2)

━━━━━━━━━━━━━━━━━━━━
_ is-digit Bool
    - byte Byte

byte >= 48 && byte <= 57

━━━━━━━━━━━━━━━━━━━━
_ brix-assign-operator Operator
    - kind BrixHead

match kind
    |= .assign-head
        .eq-op
    |= .add-assign-head
        .add-eq-op
    |= .subtract-assign-head
        .subtract-eq-op
    |= .multiply-assign-head
        .multiply-eq-op
    |= .divide-assign-head
        .divide-eq-op
    |= .mod-assign-head
        .mod-eq-op
    |= .pow-assign-head
        .pow-eq-op
    |= .concat-assign-head
        .concat-eq-op
    |= .write-all-head
        .write-all-op
    |= .bind-head
        .bind-op
    ??
        .no-op

━━━━━━━━━━━━━━━━━━━━
_ brix-binary-operator Operator
    - kind BrixHead

match kind
    |= .add-head
        .add-op
    |= .subtract-head
        .subtract-op
    |= .multiply-head
        .multiply-op
    |= .divide-head
        .divide-op
    |= .mod-head
        .mod-op
    |= .pow-head
        .pow-op
    |= .concat-head
        .concat-op
    |= .equals-head
        .equals-op
    |= .not-equals-head
        .not-equals-op
    |= .less-head
        .less-than-op
    |= .greater-head
        .greater-than-op
    |= .less-equals-head
        .less-than-equals-op
    |= .greater-equals-head
        .greater-than-equals-op
    |= .and-head
        .and-op
    |= .or-head
        .or-op
    |= .coalesce-head
        .coalesce-op
    |= .as-head
        .as-op
    |= .is-head
        .is-op
    |= .is-not-head
        .is-not-op
    |= .is-exactly-head
        .is-exactly-op
    |= .is-not-exactly-head
        .is-not-exactly-op
    |= .is-similar-head
        .is-similar-op
    |= .is-not-similar-head
        .is-not-similar-op
    |= .is-in-head
        .is-in-op
    |= .not-in-head
        .not-in-op
    |= .has-head
        .has-op
    |= .has-not-head
        .has-not-op
    |= .compose-forward-head
        .compose-forward-op
    |= .compose-backward-head
        .compose-backward-op
    |= .map-pipe-head
        .map-op
    |= .filter-pipe-head
        .filter-op
    |= .forward-pipe-head
        .pipe-forward-op
    |= .closure-pipe-head
        .pipe-closure-op
    |= .repeat-pipe-head
        .pipe-repeat-op
    |= .map-filter-pipe-head
        .map-filter-op
    |= .write-each-pipe-head
        .pipe-write-each-op
    |= .write-all-pipe-head
        .pipe-write-all-op
    |= .backward-pipe-head
        .pipe-backward-op
    |= .stream-pipe-head
        .stream-pattern-pipe-op
    ??
        .no-op

━━━━━━━━━━━━━━━━━━━━
_ brix-prefix-operator Operator
    - kind BrixHead

match kind
    |= .not-head
        .not-op
    |= .subtract-head
        .negative-op
    |= .subtract-assign-head
        .delete-op
    |= .write-head
        .read-op
    ??
        .no-op
