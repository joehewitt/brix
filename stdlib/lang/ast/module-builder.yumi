./ast
./ast-children
./ast-nodes
./decl
./module
./operator
./row-range
./slot-hosts
./state-machines
/core/arena
/core/array-builder
/core/atom-pool
/core/table

━━━━━━━━━━━━━━━━━━━━
+ ModuleBuilder
    is Usable'Void

+ path String
+ relative-path String
+ name String
+ source String
+ default-hosts [String]
+ consulted [String]
_ arena Arena
_ decls Table'Decl
_ member-pool ArrayBuilder'DeclId'ArenaBacking
_ member-links ArrayBuilder'U32'ArenaBacking
_ member-heads Map'MemberKey'U32'ArenaBacking
_ arg-pool ArrayBuilder'ArgumentShape'ArenaBacking
_ syntax-pool ArrayBuilder'SyntaxId'ArenaBacking
_ undeclared ArrayBuilder'SyntaxId'ArenaBacking
_ undeclared-owners ArrayBuilder'DeclId'ArenaBacking
_ made-atoms ArrayBuilder'Atom'ArenaBacking
_ atom-pool AtomPool?
_ atom-lock Mutex?
_ next-syntax SyntaxId = 1
_ pending-delegates RowRange'SyntaxId
_ written-content SyntaxId
_ finished Bool
_ released Bool

────────────────────
+ This
    - path String
    - relative-path String
    - name String
    - source String

.. decls = new-decl-table(arena)
.. member-pool = ArrayBuilder'DeclId(arena)
.. member-links = ArrayBuilder'U32(arena)
.. member-heads = Map'MemberKey'U32(arena)
.. arg-pool = ArrayBuilder'ArgumentShape(arena)
.. syntax-pool = ArrayBuilder'SyntaxId(arena)
.. undeclared = ArrayBuilder'SyntaxId(arena)
.. undeclared-owners = ArrayBuilder'DeclId(arena)
.. made-atoms = ArrayBuilder'Atom(arena)

────────────────────
+ do finish Module
    - ast AST
    - atoms AtomPool
    - atom-lock Mutex

` The program's atom pool names the generated declarations, so a call site's `other` and a
` cast constructor's `other` are one atom.
?! Panic("ModuleBuilder is stale or already finished")
    if released || finished

atom-pool = atoms
this.atom-lock = atom-lock
scan-root(ast)
. main = add-main(ast)
scan-nested(ast, main)
. init = add-startup(ast, .init-decl)
. task-main = add-startup(ast, .task-main-decl)
if name == "core/error"
    add-startup(ast, .termination-panic-decl)
index-members()
. module = Module
    - arena.copy-string(path)
    - arena.copy-string(relative-path)
    - arena.copy-string(name)
    - ast
    - arena
    - decls.finish()
    - member-pool.finish-immutable()
    - member-links.finish-immutable()
    - member-heads
    - arg-pool.finish-immutable()
    - syntax-pool.finish-immutable()
    - undeclared.finish-immutable()
    - undeclared-owners.finish-immutable()
    - made-atoms.finish-immutable()
    - main
    - init
    - task-main
finished = true
= module

────────────────────
_ do store-atom Atom
    - text String

. lock = atom-lock!
use lock
. stored = atom-pool!.store(text)
made-atoms.append(stored)
= stored

────────────────────
_ do index-members

` Chains the members of each class and extension that share a name, in the order written, so
` that a member is found by its name without reading every member of its owner.
for _ in 0 .. < member-pool.length
    member-links.append(no-member)
for index in 0 .. < decls.length
    do match? decls[index]
        | .decl-class(row)
            index-range(row.members)
        | .decl-extension(row)
            index-range(row.members)
        | .decl-sheet-extension(row)
            index-range(row.members)

────────────────────
_ do index-range
    - members RowRange'DeclId

for offset in 0 .. < members.count
    . place = members.start + members.count - 1 - offset
    . name = member-name(decls[member-pool[place]])
    if name
        . key = MemberKey(members.start, name)
        member-links[place] = member-heads[key] ?? no-member
        member-heads[key] = place

────────────────────
_ member-name Atom?
    - decl Decl

match? decl
    | .decl-function(row)
        row.name
    | .decl-property(row)
        row.name
    | .decl-case(row)
        row.name
    | .decl-event(row)
        row.name
    | .decl-associated(row)
        row.name

────────────────────
+ do begin-using

────────────────────
+ do end-using

release()

────────────────────
+ do release

if !released
    if !finished
        arena.release()
    released = true

────────────────────
+ do append'Node DeclId
    - node Node
    - Node is DeclNode

?! Panic("Module declaration table exceeds the valid Decl ID range")
    if decls.length >= U32.max

. index = decls.length
decls.append(node)
= index as DeclId

────────────────────
_ do scan-root
    - tree AST

` A declaration no row is made for is kept as one the module does not declare, so that the
` passes after this one know it was written.
do match tree.nodes[tree.root]
    | .node-top-level-syntax(root)
        for offset in 0 .. < root.statements.count
            . id = tree.children[root.statements.start + offset]
            . declared = decls.length
            scan-statement(tree, id)
            if decls.length == declared && is-declaration-syntax(tree, id)
                keep-undeclared(id, 0)
    ?! Panic("AST root has the wrong syntax case")

────────────────────
_ do keep-undeclared
    - id SyntaxId
    - owner DeclId

` Keeps a declaration no row is made for, with the class it is a member of, or none.
undeclared.append(id)
undeclared-owners.append(owner)

────────────────────
_ do scan-statement
    - tree AST
    - id SyntaxId

do match? tree.nodes[id]
    | .node-import-syntax(row)
        append(ImportDecl(id, row.paths, row.is-export))
    | .node-function-syntax(row)
        add-function
            - tree
            - id
            - row.names
            - row.args
            - row.access
            - function-kind(row.is-getter, row.is-setter)
            - row.return-type
            - row.errors
            - row.body
            - row.compilation-effects
            - row.is-static
            - 0
            - row.type-args
            - row.param-constraints
            - row.param-assignments
    | .node-getter-syntax(row)
        add-function
            - tree
            - id
            - row.names
            - row.args
            - row.access
            - DeclKind.getter-decl
            - row.return-type
            - row.errors
            - row.body
            - row.compilation-effects
            - row.is-static
            - 0
            - row.type-args
            - row.param-constraints
            - row.param-assignments
    | .node-setter-syntax(row)
        add-function
            - tree
            - id
            - row.names
            - row.args
            - row.access
            - DeclKind.setter-decl
            - row.return-type
            - row.errors
            - row.body
            - row.compilation-effects
            - row.is-static
            - 0
            - row.type-args
            - row.param-constraints
            - row.param-assignments
    | .node-class-block(row)
        next-syntax = class-body-start
            - tree
            - row.type-args
            - if row.facet-of > row.base then row.facet-of else row.base
            - row.or-bases
            - row.param-constraints
            - row.param-assignments
        if row.facet-of != 0
            add-extension
                - tree
                - id
                - row.facet-of
                - row.members
                - row.access
                - RowRange'SyntaxId()
                - RowRange'SyntaxId()
                - row.name
        else
            add-class
                - tree
                - id
                - row.name
                - row.aliases
                - row.type-args
                - row.base
                - row.members
                - row.access
                - row.param-constraints
                - row.param-assignments
                - row.or-bases
    | .node-extension(row)
        next-syntax = extension-body-start
            - tree
            - row.receiver
            - row.as-types
            - row.param-constraints
            - row.param-assignments
        add-extension
            - tree
            - id
            - row.receiver
            - row.body
            - row.access
            - row.param-constraints
            - row.param-assignments
    | .node-style-sheet-extension(row)
        next-syntax = row.receiver + 1
        add-sheet-extension(tree, id, row.receiver, row.body)
    | .node-property-syntax(row)
        add-property(tree, id, row.left, row.value, row.access, 0, row.is-lazy, row.decoration)
    | .node-unit-declaration(row)
        append(UnitDecl(id, 0, row.access, row.number, row.value))
    | .node-effect-declaration(row)
        append(EffectDecl(id, row.name, row.access, row.claims))
if id >= next-syntax
    next-syntax = id + 1

────────────────────
_ scan-member DeclId
    - tree AST
    - id SyntaxId
    - owner DeclId

match tree.nodes[id]
    | .node-function-syntax(row)
        add-function
            - tree
            - id
            - row.names
            - row.args
            - row.access
            - function-kind(row.is-getter, row.is-setter)
            - row.return-type
            - row.errors
            - row.body
            - row.compilation-effects
            - row.is-static
            - owner
            - row.type-args
            - row.param-constraints
            - row.param-assignments
    | .node-getter-syntax(row)
        add-function
            - tree
            - id
            - row.names
            - row.args
            - row.access
            - DeclKind.getter-decl
            - row.return-type
            - row.errors
            - row.body
            - row.compilation-effects
            - row.is-static
            - owner
            - row.type-args
            - row.param-constraints
            - row.param-assignments
    | .node-setter-syntax(row)
        add-function
            - tree
            - id
            - row.names
            - row.args
            - row.access
            - DeclKind.setter-decl
            - row.return-type
            - row.errors
            - row.body
            - row.compilation-effects
            - row.is-static
            - owner
            - row.type-args
            - row.param-constraints
            - row.param-assignments
    | .node-property-syntax(row)
        add-property(tree, id, row.left, row.value, row.access, owner, row.is-lazy, row.decoration)
    | .node-converter-syntax(row)
        append
            - ConverterDecl
                - id
                - owner
                - row.type
                - row.access
                - row.param-constraints
                - row.param-assignments
    | .node-fromverter-syntax(row)
        append(FromverterDecl(id, owner, row.type, row.access))
    | .node-event-declaration(row)
        append(EventDecl(id, row.name, owner, row.access, row.type, row.key-type))
    | .node-unit-declaration(row)
        append(UnitDecl(id, owner, row.access, row.number, row.value))
    | .node-enum-declaration(row)
        append(CaseDecl(id, row.name, owner, row.type, row.value))
    | .node-using-declaration(row)
        append(UsingDecl(id, owner, row.type))
    | .node-when-rule-syntax
        add-rule(id, owner)
    | .node-whenever-rule-syntax(row)
        if row.args.count == 0 || is-single-arg then add-rule(id, owner) else 0
        .. is-single-arg = row.kind.text != "value" && row.args.count == 1
    | .node-dependency-declaration
        add-rule(id, owner)
    | .node-subscriber-syntax
        add-rule(id, owner)
    | .node-style-annotation
        if decls[owner] is .decl-class then append(StyleDomainsDecl(id, owner)) else 0
    | .node-rule-syntax(row)
        if decls[owner] is .decl-class then add-style-rule(tree, id, row.name, owner, 0) else 0
    ??
        0

────────────────────
_ do add-sheet-extension DeclId
    - tree AST
    - syntax SyntaxId
    - receiver SyntaxId
    - member-syntax RowRange'SyntaxId

` An extension of a style sheet, with the usings and style rules it adds as its members, each
` owned by it. Any other member, a slot among them, is kept as one the module does not declare,
` held by the extension, whose check says what becomes of it.
?! Panic("Module member pool exceeds U32 capacity")
    if member-pool.length >= U32.max

. id = append(SheetExtensionDecl(syntax, receiver, RowRange'DeclId()))
. start = member-pool.length
for member-id in tree.children[member-syntax]
    . member-decl DeclId = 0
    do match? tree.nodes[member-id]
        | .node-using-declaration(row)
            member-decl = append(UsingDecl(member-id, id, row.type))
        | .node-rule-syntax(row)
            member-decl = add-style-rule(tree, member-id, row.name, id, 0)
    if member-decl == 0
        keep-undeclared(member-id, id)
    else
        member-pool.append(member-decl)
    if member-id >= next-syntax
        next-syntax = member-id + 1
do match? decls[id]
    | .decl-sheet-extension(row)
        row.members = RowRange'DeclId(start as U32, (member-pool.length - start) as U32)
= id

────────────────────
_ do add-style-rule DeclId
    - tree AST
    - id SyntaxId
    - name Atom
    - owner DeclId
    - outer DeclId

` A style rule a class writes, or one written in the body of another, and after it each written
` in its own body and in the bodies of its `when`s, in the order written, with it as their
` `outer`.
. decl = append(StyleRuleDecl(id, name, owner, outer))
do match? tree.nodes[id]
    | .node-rule-syntax(row)
        do match? tree.nodes[row.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    do match? tree.nodes[statement]
                        | .node-rule-syntax(nested)
                            add-style-rule(tree, statement, nested.name, owner, decl)
                        | .node-style-when(branch)
                            add-when-rules(tree, branch.body, owner, decl)
= decl

────────────────────
_ do add-when-rules
    - tree AST
    - body SyntaxId
    - owner DeclId
    - outer DeclId

` The style rules written in the body of a `when` of a style rule, each with the rule as its
` `outer`.
do match? tree.nodes[body]
    | .node-rule-syntax(nested)
        add-style-rule(tree, body, nested.name, owner, outer)
    | .node-block(block)
        for statement in tree.children[block.body]
            do match? tree.nodes[statement]
                | .node-rule-syntax(nested)
                    add-style-rule(tree, statement, nested.name, owner, outer)

────────────────────
_ do add-rule DeclId
    - id SyntaxId
    - owner DeclId

` A rule a class or a facet of one writes that runs as what it reads changes: a `when` rule, a
` `whenever` rule on a value, or one on the markup an object is in, which names at most its
` changes, or a dependency `. m < p`, which runs a method as properties change; or a section that
` subscribes the object to a stream, `on s` or `for x on s`, which its constructors run. A rule
` of any other type declares nothing.
= if writes-rules then append(RuleDecl(id, owner)) else 0

.. writes-rules = match decls[owner]
    | .decl-class
        true
    | .decl-extension(row)
        row.facet != null
    ??
        false

────────────────────
_ do add-function DeclId
    - tree AST
    - syntax SyntaxId
    - names RowRange'Atom
    - args RowRange'SyntaxId
    - access Access
    - kind DeclKind
    - return-type SyntaxId
    - errors RowRange'SyntaxId
    - body SyntaxId
    - effects CompilationEffect
    - is-static Bool
    - owner DeclId
    - type-args RowRange'SyntaxId
    - param-constraints RowRange'SyntaxId
    - param-assignments RowRange'SyntaxId

` A function's subtree starts where the declaration before it ended, so that what is written
` between the two is the function's. A statement before it whose node was made after the
` function's leaves nothing between, and the subtree is the function's own node.
. shapes = store-arg-shapes(tree, args)
. primary Atom?
if names.count != 0
    primary = tree.atoms[names.start]
. decl-kind = kind
if kind == DeclKind.function-decl && primary && primary.text == "This"
    decl-kind = DeclKind.constructor-decl
. start = if next-syntax <= syntax then next-syntax else tree.subtree-start(syntax)
. subtree = SyntaxRange(start, syntax - start + 1)
. fn = FunctionDecl
    - syntax
    - primary
    - names
    - owner
    - access
    - decl-kind
    - shapes.range
    - return-type
    - errors
    - effects
    - is-static
    - body
    - subtree
    - type-args
    - param-constraints
    - param-assignments
    - shapes.variadic-index
    - shapes.required-count
    - false
= append(fn)

────────────────────
_ do add-class DeclId
    - tree AST
    - syntax SyntaxId
    - name Atom
    - aliases RowRange'Atom
    - type-args RowRange'SyntaxId
    - base SyntaxId
    - member-syntax RowRange'SyntaxId
    - access Access
    - param-constraints RowRange'SyntaxId
    - param-assignments RowRange'SyntaxId
    - or-bases RowRange'SyntaxId

. interfaces = store-interfaces(tree, member-syntax)
. decl = ClassDecl
    - syntax
    - name
    - aliases
    - type-args
    - base
    - RowRange'DeclId()
    - access
    - interfaces
    - param-constraints
    - param-assignments
    - or-bases
. id = append(decl)
. members = scan-members(tree, member-syntax, id)
. content = written-content
. generated = add-generated-constructors(id) + add-table-constructors(id, name)
. given = add-content-members(tree, id, content, members)
. projected = add-content-machine-members(tree, id, content, members)
. filler = add-content-function(tree, id, content)
. delegated = store-delegations(tree, member-syntax)
do match? decls[id]
    | .decl-class(row)
        row.members = RowRange'DeclId(members.start, members.count + generated + given + projected)
        row.content = content
        row.delegated = delegated
        row.content-function = filler
= id

────────────────────
_ do add-content-function DeclId
    - tree AST
    - owner DeclId
    - content SyntaxId

` Every class has a function that fills an object of it with the markup written in the
` class, run once the object's constructor has. Its body is the lines of that markup: those
` of a root `<This`, or else of the section. A class that writes none has a function with no
` body, which runs what the class above it writes. It is no member: nothing names it.
. lines = tree.content-lines(content)
. start = if content != 0 then tree.subtree-start(content) else 0u32
. subtree = if content != 0 then SyntaxRange(start, content - start + 1) else SyntaxRange(0, 0)
. fn = FunctionDecl
    - content
    - null
    - RowRange'Atom()
    - owner
    - Access.public-access
    - DeclKind.function-decl
    - RowRange'ArgumentShape()
    - 0
    - RowRange'SyntaxId()
    - CompilationEffect.none
    - false
    - lines
    - subtree
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - U32.max
    - 0
    - true
    - RowRange'SyntaxId()
    - 0
    - true
= append(fn)

────────────────────
_ do add-machine-members
    - tree AST
    - owner DeclId
    - member DeclId

` The flags of the state machine a property of a class holds, as members before the property, as
` the reference declares them: for each of its cases, in order, a private property of the object
` no program names, which says whether the case is active; then for each group of its event
` transitions at its root on a name alone or read from `this`, one that holds the group's
` activation for the event runtime's table. A class derived from another may refine the machine
` its base's property of that name holds, whose flags are then the base's where the cases are.
` Two more, named after the class, hold the machine's part for the object, which the machines
` that refine it call (`MachineComposite`), and the part of the machine that refines it for the
` object, which it calls.
do match? decls[member]
    | .decl-property(row)
        . machine = if row.name && !row.is-lazy then tree.declared-machine(row.value) else 0
        if machine != 0
            . items = tree.state-items(tree.state-body(machine))
            for node in tree.machine-cases(items)
                . name = store-atom("(${row.name!.text}-${tree.state-name(node)!.text}-active)")
                member-pool.append(append(hidden-property(node, name, owner, node, 0)))
            . place = 0u32
            for head in tree.group-heads(items)
                if self-stream(tree, tree.group-stream(head))
                    . name = store-atom("(${row.name!.text}-event-descriptor-context-$place)")
                    member-pool.append(append(hidden-property(head, name, owner, 0, head)))
                    place += 1
            do match? decls[owner]
                | .decl-class(class)
                    for suffix in ["part", "below"]
                        . name = store-atom("(${class.name.text}-${row.name!.text}-$suffix)")
                        member-pool.append(append(part-holder(machine, name, owner)))

────────────────────
_ do add-content-machine-members U32
    - tree AST
    - owner DeclId
    - content SyntaxId
    - members RowRange'DeclId

` The flags of each state machine written as a line of a class's markup, as members after the
` others: for each of its cases, in order, a public property of the object named after the case,
` which says whether it is active, or for a case that holds a value, projects it, as the
` reference declares them, but where the class declares that name otherwise; then for each group
` of its event transitions at its root on a name alone or read from `this`, a private one that
` holds the group's activation for the event runtime's table. A class derived from another may
` refine the machine of its base's markup that has a case of a name its machine has at its root,
` whose flags and projections are then the base's where the cases are. Two more, named after
` the class and the machine's place among those of its markup, hold the machine's part for the
` object, which the machines that refine it call (`MachineComposite`), and the part of the
` machine that refines it for the object, which it calls. How many there are.
. start = member-pool.length
. added = (members.start + members.count) as Size
. position = 0u32
for machine in tree.content-machines(content)
    . items = tree.state-items(tree.state-body(machine))
    for node in tree.machine-cases(items)
        . name = tree.state-name(node)!
        if !declares(members, added, name)
            . holds = tree.payload-source(items, name) != null
            . decl = PropertyDecl
                - node
                - name
                - owner
                - 0
                - 0
                - null
                - Access.public-access
                - false
                - RowRange'SyntaxId()
                - false
                - 0
                - if holds then 0 else node
                - 0
                - 0
                - 0
                - if holds then node else 0
            member-pool.append(append(decl))
    . place = 0u32
    for head in tree.group-heads(items)
        if self-stream(tree, tree.group-stream(head))
            . name = store-atom("(state-${position}-event-descriptor-context-$place)")
            member-pool.append(append(hidden-property(head, name, owner, 0, head)))
            place += 1
    do match? decls[owner]
        | .decl-class(class)
            for suffix in ["part", "below"]
                . name = store-atom("(${class.name.text}-state-${position}-$suffix)")
                member-pool.append(append(part-holder(machine, name, owner)))
    position += 1
= (member-pool.length - start) as U32

────────────────────
_ part-holder PropertyDecl
    - machine SyntaxId
    - name Atom
    - owner DeclId

` A private property of an object that holds a part of a state machine merged with others, which
` no program names.
PropertyDecl
    - machine
    - name
    - owner
    - 0
    - 0
    - null
    - Access.private-access
    - false
    - RowRange'SyntaxId()
    - false
    - 0
    - 0
    - 0
    - 0
    - machine

────────────────────
_ hidden-property PropertyDecl
    - node SyntaxId
    - name Atom
    - owner DeclId
    - flag SyntaxId
    - context SyntaxId

` A private property of an object a state machine keeps no program names.
PropertyDecl
    - node
    - name
    - owner
    - 0
    - 0
    - null
    - Access.private-access
    - false
    - RowRange'SyntaxId()
    - false
    - 0
    - flag
    - context

────────────────────
_ do self-stream Bool
    - tree AST
    - stream SyntaxId

` Whether a stream is written as a name alone, or as a name read from `this`.
do match? tree.nodes[stream]
    | .node-identifier
        = true
    | .node-get-expression(row)
        do match? tree.nodes[row.object]
            | .node-identifier(object)
                = object.name.text == "this"
= false

────────────────────
_ do add-content-members U32
    - tree AST
    - owner DeclId
    - content SyntaxId
    - members RowRange'DeclId

` The properties the markup written in a class declares, as members after those the class
` writes; how many there are. An attribute of a root `<This` gives a property of a class
` above a new value, as a property declared again does, and so does one of a property the
` class declares itself with no value. An element written with a name is a private property
` of that name and the element's type, which holds nothing until the markup makes the
` element. A line of a section with no root that declares a property the markup gives its value
` (`content-property`) declares it, public and stored, after them. A name the class declares
` otherwise declares nothing more.
if content == 0
    = 0
. start = member-pool.length
. root = tree.root-this(content)
do match? tree.nodes[root]
    | .node-markup(element)
        do match? tree.nodes[element.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    do match? tree.nodes[statement]
                        | .node-assign(attribute)
                            . name = attribute-name(tree, attribute.op, attribute.lhs)
                            if name && (!declares(members, start, name) || awaits-value(members, name))
                                . decl = PropertyDecl
                                    - statement
                                    - name
                                    - owner
                                    - 0
                                    - attribute.rhs
                                    - null
                                    - Access.public-access
                                    - false
                                    - RowRange'SyntaxId()
                                    - true
                                member-pool.append(append(decl))
. first = tree.subtree-start(content)
. lines = tree.content-lines(content)
for node in first .. < content
    if !is-markup-line(tree, content, lines, node)
        continue
    do match? tree.nodes[node]
        | .node-markup(element)
            . name = element-name(tree, element.id)
            if name && node != root && !is-enclosed-node && !declares(members, start, name)
                . decl = PropertyDecl
                    - element.id
                    - name
                    - owner
                    - element.type-id
                    - 0
                    - null
                    - Access.private-access
                    - false
                    - RowRange'SyntaxId()
                    - false
                    - node
                member-pool.append(append(decl))
            .. is-enclosed-node = is-enclosed(tree, content, node)
if root == 0
    do match? tree.nodes[lines]
        | .node-block(block)
            for statement in tree.children[block.body]
                . name = element-name(tree, tree.content-property-name(statement))
                if name && !declares(members, start, name)
                    . decl = PropertyDecl
                        - statement
                        - name
                        - owner
                        - 0
                        - 0
                        - null
                        - Access.public-access
                        - false
                        - RowRange'SyntaxId()
                        - false
                        - 0
                        - 0
                        - 0
                        - statement
                    member-pool.append(append(decl))
= (member-pool.length - start) as U32

────────────────────
_ do is-markup-line Bool
    - tree AST
    - content SyntaxId
    - lines SyntaxId
    - node SyntaxId

` Whether a node of a class's content is written in a line of its markup: any node of a
` section, but in a `• This` only those of the lines that are not the rule's own (`runs-line`).
if !(tree.nodes[content] is .node-rule-syntax)
    = true
do match? tree.nodes[lines]
    | .node-block(block)
        for statement in tree.children[block.body]
            if tree.subtree-start(statement) <= node && node <= statement
                = tree.runs-line(content, statement)
= false

────────────────────
_ do declares Bool
    - members RowRange'DeclId
    - added Size
    - name Atom

` Whether a class declares a property or an event of a name: among the members it writes, or
` among those its markup has declared so far.
for offset in 0 .. < members.count
    if names-property(member-pool[members.start + offset], name)
        = true
for place in added .. < member-pool.length
    if names-property(member-pool[place], name)
        = true
= false

────────────────────
_ do awaits-value Bool
    - members RowRange'DeclId
    - name Atom

` Whether a class writes a property of a name that it stores, with no value and no element.
for offset in 0 .. < members.count
    do match? decls[member-pool[members.start + offset]]
        | .decl-property(row)
            if row.name && row.name == name
                = row.value == 0 && !row.is-lazy && row.element == 0
= false

────────────────────
_ names-property Bool
    - member DeclId
    - name Atom

match decls[member]
    | .decl-property(row)
        row.name != null && row.name == name
    | .decl-event(row)
        row.name == name
    ??
        false

────────────────────
_ do is-enclosed Bool
    - tree AST
    - content SyntaxId
    - node SyntaxId

` Whether a node of a class's markup is written in a function or a loop there: an element
` named in one is no property of the class.
for outer in node + 1 .. < content
    if tree.subtree-start(outer) > node
        continue
    do match? tree.nodes[outer]
        | .node-function-syntax
            = true
        | .node-for-block
            = true
= false


────────────────────
_ do attribute-name Atom?
    - tree AST
    - op Operator
    - target SyntaxId

if op != .eq-op
    = null
do match? tree.nodes[target]
    | .node-identifier(row)
        = row.name
= null

────────────────────
_ do element-name Atom?
    - tree AST
    - id SyntaxId

if id == 0
    = null
do match? tree.nodes[id]
    | .node-identifier(row)
        = row.name
= null

────────────────────
_ do scan-nested
    - tree AST
    - main DeclId

` Lambdas and task bodies are nested functions. Walking ids downward visits every enclosing function
` before the functions inside it, so a stack of the open subtrees names each owner; anything outside
` every function, such as a lambda in a property initializer, belongs to main. A second stack holds
` the declarations and assignments whose values are open, which name the nested functions written in
` them. A bullet a stream piped through a pattern reads alone is no function: the pipe's evaluates
` what it writes. A `for` block on a stream with one header is the subscriber its body runs as, a
` class's section of one too. An assignment whose value reads something tracked, which gives no
` property of a root `<This` its value, is run again by a function of its own (`add-live`), as is a
` lazy declaration, no attribute, of one name whose value does, but one in the value of a property,
` which runs again with the value; so is an attribute of another element, whose function stores in
` the element's property, and an argument of one given by position, but a comprehension. The
` `whenever` clause of a loop on a stream is tested again by one too (`add-whenever`). An `if`
` written as a line of markup content, or of a body that runs as content, whose conditions read
` something tracked is a region: each arm is built by a function of its own, written at its body,
` and one selects the arm again (`add-branch`), and so is a `match` written as such a line whose
` subject does (`is-match-region`). So is a `for` written as such a line whose container reads
` something tracked: each row is built by a function of its own, written at its body, one reads the
` container again (`add-source`), and where the loop is keyed one keys each row, written at its
` `keyed by` clause. The condition a style rule written on a markup element, but a root `<This`, is
` applied under is tested again by a function of its own, written at the condition, where the
` reference takes it (`add-gate`). In the row of a keyed loop, a read of the loop's item and of the
` row's own declarations that read it is tracked (`RowNames`). A lazy declaration written as a line
` of a row is read as a getter, never run again on its own. A markup element that binds a slot, but
` a root `<This`, is built by a function of its own, which the constructor of the element it is a
` line of is given. So is the one line of an element's body that is neither an attribute nor bound
` to a slot, where the element's class is one of `default-hosts` and that line is a markup element:
` it fills the default slot; and so is such a body whose lines all give the slot content, where the
` reference builds them into a node of the slot's type (`mark-default`). The lines of the markup a
` class writes fill so the default slot of the class it derives from. Each class name looked up so
` is `consulted`. The body of a slot outlet is content, as an element's is, and so are the lines of
` a class's markup section written with no root `<This`. An element written with a name whose body
` gives slots content gives its constructor a function of its own, written at the name, that gives
` the name the element's object before the markup of its class runs. A state machine is a function
` of its own, but a named one written in a case of another, which is part of that one's. A line of
` an element's body, or of the body of an arm of a region, that gives content and reads something
` tracked is given again by a function of its own. A slot outlet that gives its slot's function a
` name the row of a keyed loop reads tracked is a region of one arm (`rebuilds-outlet`).
. declared [DeclId]
. inline [Bool]
. chained [Bool]
. piped [Bool]
. listed [Bool]
. attributes [Bool]
. defaults [Bool]
. content [Bool]
. arms [Bool]
. rows [Bool]
. keys [Bool]
. positions [Bool]
. gates [Bool]
. defaulted [Bool]
. binders [Bool]
. machines [Bool]
. ruled [Bool]
for _ in 0 .. < tree.root + 1
    defaulted += false
    binders += false
    machines += false
    declared += 0
    inline += false
    chained += false
    piped += false
    listed += false
    attributes += false
    defaults += false
    content += false
    arms += false
    rows += false
    keys += false
    positions += false
    gates += false
    ruled += false
. total = tree.root + 1
for id in 1u32 .. < total
    . listing = tree.listed-bullets(id)
    if listing != 0
        listed[listing] = true
    do match? tree.nodes[id]
        | .node-bullet-expression(row)
            if row.next != 0
                chained[row.next] = true
        | .node-markup(row)
            mark-content(tree, row.body, content, arms, rows, keys)
        | .node-slot-outlet(row)
            mark-content(tree, row.body, content, arms, rows, keys)
        | .node-content-block(row)
            if tree.root-this(id) == 0
                mark-content(tree, row.body, content, arms, rows, keys)
        | .node-class-block(row)
            mark-default(tree, row.base, class-lines(tree, row.members), defaulted)
        | .node-property-syntax(row)
            if row.value != 0 && tree.nodes[row.value] is .node-state-machine
                machines[row.value] = true
        | .node-rule-syntax(row)
            mark-rule-lines(tree, row.body, ruled)
. row-names = RowNames()
. getters [Bool]
for _ in 0 .. < total
    getters += false
for id in 1u32 .. < total
    do match? tree.nodes[id]
        | .node-for-block(row)
            if rows[row.body] && tree.keyed-clause(row.loop) != 0
                row-names.add(tree, row.loop, row.body)
        | .node-block(row)
            if rows[id]
                for line in tree.children[row.body]
                    do match? tree.nodes[line]
                        | .node-declare(declared)
                            getters[line] = declared.is-lazy
for index in 0 .. < decls.length
    do match? decls[index]
        | .decl-function(fn)
            if !fn.is-generated && fn.syntax < declared.length
                declared[fn.syntax] = index as DeclId

. owners [DeclId]
. starts [SyntaxId]
. floors [Size]
. namings = Namings()
. parents = tree-parents(tree, total)
for reverse in 1 .. < tree.root
    . id = tree.root - reverse
    while starts.length != 0 && id < starts[starts.length - 1]
        owners.pop()
        starts.pop()
        floors.pop()
    namings.close(id)
    . existing = declared[id]
    if existing != 0
        do match? decls[existing]
            | .decl-function(fn)
                owners += existing
                starts += fn.subtree.start
                floors += namings.nodes.length
        continue
    . depth = holding-depth(id, owners, parents)
    . owner = if depth != 0 then owners[depth - 1] else main
    . named = naming(tree, id, owners, floors, namings, depth)
    . nested = 0u32
    do match? tree.nodes[id]
        | .node-function-syntax(row)
            nested = add-nested-function
                - tree
                - id
                - row.names
                - row.args
                - row.return-type
                - row.errors
                - row.body
                - row.compilation-effects
                - DeclKind.closure-decl
                - owner
                - 0
                - named
        | .node-do-task-block(row)
            nested = add-nested-function
                - tree
                - id
                - RowRange'Atom()
                - RowRange'SyntaxId()
                - 0
                - RowRange'SyntaxId()
                - row.body
                - CompilationEffect.none
                - DeclKind.task-decl
                - owner
                - 0
                - named
        | .node-do-block(row)
            if opens-region(row.compilation-effects, owner)
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - row.body
                    - row.compilation-effects
                    - DeclKind.region-decl
                    - owner
                    - 0
                    - named
        | .node-state-machine
            if !machines[id] || !is-machine-decl(owner)
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - id
                    - CompilationEffect.none
                    - DeclKind.machine-decl
                    - owner
                    - 0
                    - named
        | .node-bullet-expression(row)
            if row.item != 0 && !row.is-multi
                inline[row.item] = true
            if !chained[id] && !piped[id] && !listed[id]
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - id
                    - CompilationEffect.none
                    - DeclKind.bullet-decl
                    - owner
                    - last-bullet(tree, id)
                    - named
        | .node-pipeline-expression(row)
            if is-pipeline-nested(row.op)
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - row.right
                    - CompilationEffect.none
                    - DeclKind.pipeline-decl
                    - owner
                    - 0
                    - named
            else if row.op == .stream-pattern-pipe-op
                nested = add-pattern-pipe(tree, id, owner, named)
                . bullet = tree.piped-bullet(id)
                if bullet != 0
                    piped[bullet] = true
        | .node-binary-expression(row)
            if is-pipeline-nested(row.op)
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - row.rhs
                    - CompilationEffect.none
                    - DeclKind.pipeline-decl
                    - owner
                    - 0
                    - named
            else if row.op == .stream-pattern-pipe-op
                nested = add-pattern-pipe(tree, id, owner, named)
                . bullet = tree.piped-bullet(id)
                if bullet != 0
                    piped[bullet] = true
        | .node-markup(row)
            for child in tree.children-of(id)
                inline[child] = true
            . root = tree.names-this(row.type-id)
            if !root
                . defaults = mark-default(tree, row.type-id, row.body, defaulted)
                if row.id != 0 && (defaults || binds-slots(tree, row.body))
                    binders[row.id] = true
            if (row.slot-binding != 0 || defaulted[id]) && !root
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - id
                    - CompilationEffect.none
                    - DeclKind.slot-decl
                    - owner
                    - 0
                    - named
            do match? tree.nodes[row.body]
                | .node-block(block)
                    for line in tree.children[block.body]
                        attributes[line] = true
                        defaults[line] = root
                        if tree.gives-content(line) && reads-tracked(tree, line, row-names)
                            positions[line] = true
            for arg in tree.children[row.args]
                if !root && !(tree.nodes[arg] is .node-iterator-expression) && is-tracked-arg
                    positions[arg] = true
                .. is-tracked-arg = reads-tracked(tree, arg, row-names)
            for application in tree.children[row.style-rule-applications]
                do match? tree.nodes[application]
                    | .node-style-rule-application(applied)
                        if !root && applied.condition != 0 && is-reference
                            gates[applied.condition] = true
                        .. is-reference = tree.is-condition-reference(applied.condition)
        | .node-if-block
            if content[id] && is-branch-region(tree, id)
                add-branch(tree, id, owner, named)
        | .node-match-expression
            if content[id] && is-match-region(tree, id)
                add-branch(tree, id, owner, named)
        | .node-slot-outlet(row)
            if rebuilds-outlet(tree, row.slot-parameter, row-names)
                do add-nested-function
                    - tree
                    - row.slot-parameter
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - row.slot-parameter
                    - CompilationEffect.none
                    - DeclKind.branch-decl
                    - owner
                    - 0
                    - named
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - id
                    - CompilationEffect.none
                    - DeclKind.branch-arm-decl
                    - owner
                    - 0
                    - named
        | .node-block(block)
            if defaulted[id]
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - id
                    - CompilationEffect.none
                    - DeclKind.slot-decl
                    - owner
                    - 0
                    - named
            else if arms[id] || rows[id]
                if arms[id] || (rows[id] && tree.row-region(id))
                    for line in tree.children[block.body]
                        if tree.gives-content(line) && reads-tracked(tree, line, row-names)
                            positions[line] = true
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - id
                    - CompilationEffect.none
                    - if rows[id] then DeclKind.row-decl else DeclKind.branch-arm-decl
                    - owner
                    - 0
                    - named
        | .node-assign(row)
            if !defaults[id] && row.op == .bind-op && attributes[id]
                nested = add-live(tree, id, owner, named)
                do add-live(tree, row.lhs, owner, named, id)
            if !defaults[id] && row.op == .eq-op && (is-tracked-value || is-styled-value)
                nested = add-live(tree, id, owner, named)
            .. is-tracked-value = reads-tracked(tree, row.rhs, row-names)
            .. is-styled-value = (attributes[id] || ruled[id]) && reads-styles(tree, row.rhs)
        | .node-property-syntax(row)
            if content[id] && tree.content-property(id) && reads-tracked(tree, row.value, row-names)
                nested = add-live(tree, id, owner, named)
        | .node-declare(row)
            . plain = declared-plainly(tree, row.left)
            if is-unclaimed && row.is-lazy && plain && row.right != 0 && is-live
                nested = add-live(tree, id, owner, named)
            .. is-unclaimed = !attributes[id] && !getters[id]
            .. is-live = reads-tracked(tree, row.right) && !in-property-value(tree, id, parents)
        | .node-iterable-expression(row)
            if reads-tracked(tree, row.expr)
                nested = add-live(tree, id, owner, named)
        | .node-for-block(row)
            if !inline[id] && is-subscriber-loop(tree, row.loop)
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - id
                    - CompilationEffect.none
                    - DeclKind.subscriber-decl
                    - owner
                    - 0
                    - named
                add-whenever(tree, row.loop, owner, named)
            else if content[id] && is-markup-loop(tree, row.loop)
                add-source(tree, id, owner, named)
        | .node-clause(row)
            if keys[id]
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - row.expr
                    - CompilationEffect.none
                    - DeclKind.key-decl
                    - owner
                    - 0
                    - named
        | .node-iterator-expression(row)
            if content[id] && is-content-loop(tree, row.loop)
                nested = 0
            else if !inline[id] && is-generator-loop(tree, row.loop)
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - id
                    - CompilationEffect.none
                    - DeclKind.iterator-decl
                    - owner
                    - 0
                    - named
            else if !inline[id] && is-subscriber-loop(tree, row.loop)
                nested = add-nested-function
                    - tree
                    - id
                    - RowRange'Atom()
                    - RowRange'SyntaxId()
                    - 0
                    - RowRange'SyntaxId()
                    - id
                    - CompilationEffect.none
                    - DeclKind.subscriber-decl
                    - owner
                    - 0
                    - named
                add-whenever(tree, row.loop, owner, named)
    if nested == 0 && defaulted[id] && gives-value(tree, id)
        nested = add-nested-function
            - tree
            - id
            - RowRange'Atom()
            - RowRange'SyntaxId()
            - 0
            - RowRange'SyntaxId()
            - id
            - CompilationEffect.none
            - DeclKind.slot-decl
            - owner
            - 0
            - named
    if nested == 0 && positions[id]
        nested = add-live(tree, id, owner, named)
    if nested == 0 && gates[id]
        nested = add-gate(tree, id, owner, named)
    if nested == 0 && binders[id]
        nested = add-nested-function
            - tree
            - id
            - RowRange'Atom()
            - RowRange'SyntaxId()
            - 0
            - RowRange'SyntaxId()
            - id
            - CompilationEffect.none
            - DeclKind.binder-decl
            - owner
            - 0
            - named
    if nested != 0
        do match? decls[nested]
            | .decl-function(fn)
                owners += nested
                starts += fn.subtree.start
                floors += namings.nodes.length
    namings.open(tree, id)

────────────────────
_ do mark-default Bool
    - tree AST
    - type SyntaxId
    - body SyntaxId
    - defaulted [Bool]

` Marks what fills the default slot of an element's class, and answers whether it marked
` anything: the one line of the body that gives the slot content, where that is an element or a
` value the reference converts to the slot's type (`gives-value`); or the body itself, where
` several of its lines give the slot content, or one that is an `if`, a `match` or a loop of
` content, which the reference builds into a node of its own of those lines alone, whatever
` attributes and content bound to other slots the body holds too.
. lines = 0
. total = 0
. line SyntaxId = 0
do match? tree.nodes[body]
    | .node-block(block)
        for each in tree.children[block.body]
            total += 1
            if gives-default(tree, each)
                lines += 1
                line = each
=? false if lines == 0
. head = head-name(tree, type)
=? false if head.length == 0
if consulted.find(head) == null
    consulted += head
=? false if default-hosts.find(head) == null
if lines == 1
    do match? tree.nodes[line]
        | .node-markup(row)
            if !tree.names-this(row.type-id)
                defaulted[line] = true
                = true
            = false
    if gives-value(tree, line)
        defaulted[line] = true
        = true
if lines == 1 && !is-control-line(tree, line)
    = false
defaulted[body] = true
= true

────────────────────
_ gives-value Bool
    - tree AST
    - line SyntaxId

` Whether a line of markup content is a value, which the one line that gives a default slot
` content is converted from to the slot's type: a value given as content (`gives-content`), but
` for a joining operator, or a value a `use` lends.
match tree.nodes[line]
    | .node-binary-expression
        false
    | .node-use-expression
        true
    ??
        tree.gives-content(line)

────────────────────
_ do class-lines SyntaxId
    - tree AST
    - members RowRange'SyntaxId

` The block whose lines are the markup a class writes, or none.
for member in tree.children[members]
    if tree.nodes[member] is .node-content-block
        = tree.content-lines(member)
= 0

────────────────────
_ do is-control-line Bool
    - tree AST
    - line SyntaxId

` Whether a line of markup content is an `if`, a `match`, or a loop of content, as the
` reference's `isMarkupControlFlow` finds it.
do match? tree.nodes[line]
    | .node-if-block
        = true
    | .node-match-expression
        = true
    | .node-for-block(row)
        = !is-subscriber-loop(tree, row.loop)
    | .node-iterator-expression(row)
        = is-content-loop(tree, row.loop)
= false

────────────────────
_ do binds-slots Bool
    - tree AST
    - body SyntaxId

` Whether a line of an element's body is content bound to a slot by name.
do match? tree.nodes[body]
    | .node-block(block)
        for line in tree.children[block.body]
            if !gives-default(tree, line) && !(tree.nodes[line] is .node-assign)
                = true
= false

────────────────────
_ gives-default Bool
    - tree AST
    - line SyntaxId

` Whether a line of an element's body is content of the default slot: neither an attribute nor
` content bound to a slot.
match tree.nodes[line]
    | .node-assign
        false
    | .node-markup-slot-forward
        false
    | .node-markup(row)
        row.slot-binding == 0
    ??
        true

────────────────────
_ do naming SyntaxId
    - tree AST
    - id SyntaxId
    - owners [DeclId]
    - floors [Size]
    - namings Namings
    - depth Size

` The innermost declaration or assignment whose value holds a node, within the function that
` writes the node: its owner, the innermost of the first `depth` open ones, or past a pipe whose
` right side does not hold it, the function the pipe is in. None where there is no such one.
. floor Size = 0
. level = depth
while level > 0
    level -= 1
    . climbs = false
    do match? decls[owners[level]]
        | .decl-function(fn)
            climbs = fn.kind == .pipeline-decl && !holds-id
                .. holds-id = tree.subtree-start(fn.body) <= id && id <= fn.body
    if !climbs
        floor = floors[level]
        break
= namings.innermost(id, floor)

────────────────────
_ do holding-depth Size
    - id SyntaxId
    - owners [DeclId]
    - parents [SyntaxId]

` How many of the open declarations hold a node. A state machine merged from cases written as
` statements of a block is made once the block is read, after its other statements, which fall
` within its range though it does not hold them; it is passed over for them.
. depth = owners.length
while depth != 0
    . passed = false
    do match? decls[owners[depth - 1]]
        | .decl-function(fn)
            passed = fn.kind == .machine-decl && !descends(id, fn.syntax, parents)
    if !passed
        = depth
    depth -= 1
= depth

────────────────────
_ do descends Bool
    - id SyntaxId
    - ancestor SyntaxId
    - parents [SyntaxId]

` Whether a node is below another, as the links of their children say.
. node = parents[id]
while node != 0 && node < ancestor
    node = parents[node]
= node == ancestor

────────────────────
_ do tree-parents [SyntaxId]
    - tree AST
    - total Size

` The node each node is a child of, or none. A node linked as the child of two, as one merged
` into another node made after it is, has the later.
. parents [SyntaxId]
for _ in 0 .. < total
    parents += 0
. limit = total as U32
for id in 1u32 .. < limit
    for child in tree.children-of(id)
        parents[child] = id
= parents

────────────────────
_ do in-property-value Bool
    - tree AST
    - id SyntaxId
    - parents [SyntaxId]

` Whether a node is written in the value of a property, outside the functions written in it.
. node = parents[id]
while node != 0
    do match? tree.nodes[node]
        | .node-property-syntax
            = true
        | .node-function-syntax
            = false
    node = parents[node]
= false

────────────────────
_ do last-bullet SyntaxId
    - tree AST
    - id SyntaxId

. bullet = id
while true
    do match tree.nodes[bullet]
        | .node-bullet-expression(row)
            if row.next == 0
                = bullet
            bullet = row.next
        ??
            = bullet

────────────────────
_ do reads-tracked Bool
    - tree AST
    - value SyntaxId
    - rows RowNames? = null

` Whether a value reads a name or a member tracked outside the functions written in it, the
` latest item of a stream, or one of the `rows` names in the row of a keyed markup loop that
` reads them tracked.
. id = value
while id >= tree.subtree-start(value) && id != 0
    do match? tree.nodes[id]
        | .node-identifier(row)
            if row.is-tracked || (rows && rows.reads(id, row.name.text))
                = true
        | .node-get-expression(row)
            if row.is-tracked
                = true
        | .node-latest-expression
            = true
        | .node-function-syntax
            id = tree.subtree-start(id)
    id -= 1
= false

────────────────────
_ do mark-rule-lines
    - tree AST
    - body SyntaxId
    - ruled [Bool]

do match? tree.nodes[body]
    | .node-block(block)
        for line in tree.children[block.body]
            ruled[line] = true
            do match? tree.nodes[line]
                | .node-style-when(branch)
                    mark-rule-lines(tree, branch.body, ruled)

────────────────────
_ do reads-styles Bool
    - tree AST
    - value SyntaxId

. id = value
while id >= tree.subtree-start(value) && id != 0
    do match? tree.nodes[id]
        | .node-style-read-expression
            = true
        | .node-function-syntax
            id = tree.subtree-start(id)
    id -= 1
= false

────────────────────
_ do rebuilds-outlet Bool
    - tree AST
    - parameter SyntaxId
    - rows RowNames

` Whether a slot outlet gives the function that builds its slot a name the row of a keyed markup
` loop reads tracked (`RowNames`), which the reference reads as a getter: the outlet is then a
` branch region of one arm, the outlet itself, built again whenever what the name reads changes,
` as `markupRebuildingSlotOutlet` makes it. The function that selects the arm again is written at
` the outlet's parameter, whose name it reads, and the arm at the outlet.
do match? tree.nodes[parameter]
    | .node-markup-slot-parameter(row)
        do match? tree.nodes[row.name]
            | .node-identifier(named)
                = rows.reads(row.name, named.name.text)
= false

────────────────────
_ declared-plainly Bool
    - tree AST
    - left SyntaxId

` Whether a declaration names one local with no type written.
match tree.nodes[left]
    | .node-identifier
        true
    | .node-type-capture(row)
        row.type == 0 && tree.nodes[row.id] is .node-identifier
    ??
        false

────────────────────
_ do add-whenever
    - tree AST
    - loop SyntaxId
    - owner DeclId
    - named SyntaxId

` The function that tests a loop's `whenever` clause again when what it read tracked changes,
` where the loop has one. It belongs to the function the loop is written in, and its subtree
` is the clause's, whose first test is that function's.
. clause = tree.whenever-clause(loop)
if clause == 0
    =
. start = tree.subtree-start(clause)
. fn = FunctionDecl
    - clause
    - null
    - RowRange'Atom()
    - owner
    - Access.private-access
    - DeclKind.whenever-decl
    - RowRange'DeclId()
    - 0
    - RowRange'SyntaxId()
    - CompilationEffect.none
    - false
    - 0
    - SyntaxRange(start, clause - start + 1)
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - U32.max
    - 0
    - false
    - RowRange'SyntaxId()
    - named
do append(fn)

────────────────────
_ do add-live DeclId
    - tree AST
    - id SyntaxId
    - owner DeclId
    - named SyntaxId
    - whole SyntaxId = 0

` The function that runs a statement, an argument of a markup element, or the value of a stream
` of a value as it changes, again when what it read tracked changes. Its subtree is the node's,
` whose first run is the enclosing function's, or that of the `whole` statement it is written in,
` as for the function that stores back what a binding's element holds.
. covered = if whole != 0 then whole else id
. start = tree.subtree-start(covered)
. fn = FunctionDecl
    - id
    - null
    - RowRange'Atom()
    - owner
    - Access.private-access
    - DeclKind.live-decl
    - RowRange'DeclId()
    - 0
    - RowRange'SyntaxId()
    - CompilationEffect.none
    - false
    - 0
    - SyntaxRange(start, covered - start + 1)
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - U32.max
    - 0
    - false
    - RowRange'SyntaxId()
    - named
= append(fn)

────────────────────
_ do add-gate DeclId
    - tree AST
    - condition SyntaxId
    - owner DeclId
    - named SyntaxId

` The function that tests again the condition a style rule written on a markup element is
` applied under when what it read tracked changes. Its subtree is the condition's, whose first
` test is the enclosing function's.
. start = tree.subtree-start(condition)
. fn = FunctionDecl
    - condition
    - null
    - RowRange'Atom()
    - owner
    - Access.private-access
    - DeclKind.gate-decl
    - RowRange'DeclId()
    - 0
    - RowRange'SyntaxId()
    - CompilationEffect.none
    - false
    - 0
    - SyntaxRange(start, condition - start + 1)
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - U32.max
    - 0
    - false
    - RowRange'SyntaxId()
    - named
= append(fn)

────────────────────
_ do mark-content
    - tree AST
    - body SyntaxId
    - content [Bool]
    - arms [Bool]
    - rows [Bool]
    - keys [Bool]

` Marks the lines of a body that runs as markup content, and those of the bodies its lines run as
` content in turn: each arm of an `if` and of a markup match region, and the body of a `for`, or of
` a loop written as an expression with `in`, that is no loop on a stream. The body of each arm of a
` markup branch or match region is marked as one a function of its own builds, and so is the body of
` a markup loop region, which builds each row and is no content, and its `keyed by` clause, which
` keys each row. The arms after the first of an `if` follow it in the tree, so they are reached by
` their links.
do match? tree.nodes[body]
    | .node-block(block)
        for line in tree.children[block.body]
            content[line] = true
            do match? tree.nodes[line]
                | .node-if-block
                    . region = is-branch-region(tree, line)
                    . arm = line
                    while arm != 0
                        . next SyntaxId = 0
                        do match? tree.nodes[arm]
                            | .node-if-block(branch)
                                arms[tree.arm-body(arm)] = region
                                mark-content(tree, tree.arm-body(arm), content, arms, rows, keys)
                                next = branch.next
                        arm = next
                | .node-match-expression
                    if is-match-region(tree, line)
                        . held [SyntaxId]
                        tree.match-arms(line, held)
                        for arm in held
                            do match? tree.nodes[arm]
                                | .node-type-transform(transform)
                                    arms[transform.expr] = true
                                    mark-content(tree, transform.expr, content, arms, rows, keys)
                | .node-for-block(row)
                    if is-markup-loop(tree, row.loop)
                        rows[row.body] = true
                        keys[tree.keyed-clause(row.loop)] = true
                        if tree.row-region(row.body)
                            mark-content(tree, row.body, content, arms, rows, keys)
                    else if !is-subscriber-loop(tree, row.loop)
                        mark-content(tree, row.body, content, arms, rows, keys)
                | .node-iterator-expression(row)
                    if is-content-loop(tree, row.loop)
                        mark-content(tree, row.body, content, arms, rows, keys)

────────────────────
_ do add-branch
    - tree AST
    - id SyntaxId
    - owner DeclId
    - named SyntaxId

` The function that selects the arm of a markup branch region again when what its conditions
` read tracked changes, whose first selection is the enclosing function's; each arm is built by
` a function of its own, written at its body. The arms after the first follow the `if` in the
` tree, so its subtree runs from the first node of the `if` through its last arm. That of a
` markup match region selects again when what its subject reads changes; its subtree is the
` `match`'s.
. start = tree.subtree-start(id)
. last = id
. arm = id
while arm != 0
    . next SyntaxId = 0
    do match? tree.nodes[arm]
        | .node-if-block(row)
            if arm > last
                last = arm
            next = row.next
    arm = next
. fn = FunctionDecl
    - id
    - null
    - RowRange'Atom()
    - owner
    - Access.private-access
    - DeclKind.branch-decl
    - RowRange'DeclId()
    - 0
    - RowRange'SyntaxId()
    - CompilationEffect.none
    - false
    - 0
    - SyntaxRange(start, last - start + 1)
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - U32.max
    - 0
    - false
    - RowRange'SyntaxId()
    - named
do append(fn)

────────────────────
_ do add-source
    - tree AST
    - id SyntaxId
    - owner DeclId
    - named SyntaxId

` The function that reads the container of a markup loop region again when what it read
` tracked changes, and gives the region what it gives, whose first read is the enclosing
` function's; each row is built by a function of its own, written at the loop's body.
. start = tree.subtree-start(id)
. fn = FunctionDecl
    - id
    - null
    - RowRange'Atom()
    - owner
    - Access.private-access
    - DeclKind.source-decl
    - RowRange'DeclId()
    - 0
    - RowRange'SyntaxId()
    - CompilationEffect.none
    - false
    - 0
    - SyntaxRange(start, id - start + 1)
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - U32.max
    - 0
    - false
    - RowRange'SyntaxId()
    - named
do append(fn)

────────────────────
_ is-content-loop Bool
    - tree AST
    - loop SyntaxId

` Whether a loop written as an expression with `in` as a line of markup content runs its body
` as content, as a `for` does, and as the reference's `isMarkupControlFlow` finds one: it is no
` loop on a stream. One whose container reads something tracked, which the reference makes a
` region of, is none here: it has no shape yet.
!is-subscriber-loop(tree, loop) && !is-markup-loop(tree, loop)

────────────────────
_ do is-markup-loop Bool
    - tree AST
    - loop SyntaxId

` Whether a `for` written as a line of markup content is a region whose rows functions of
` their own build, as the reference's `markupLoopHeader` finds one: the container of one of
` its headers reads something tracked, before any header on a stream.
. header = loop
while header != 0
    . next SyntaxId = 0
    do match? tree.nodes[header]
        | .node-loop-syntax(row)
            if row.is-subscriber
                = false
            if row.container != 0 && reads-tracked(tree, row.container)
                = true
            next = row.next
    header = next
= false

────────────────────
_ do is-branch-region Bool
    - tree AST
    - id SyntaxId

` Whether an `if` written as a line of markup content is a region whose arm is selected again
` when what its conditions read tracked changes, as the reference's `hasDynamicMarkupCondition`
` finds one: one of its conditions reads something tracked, or of an arm written with a pattern,
` `if | x = v`, its subject or its pattern (`pattern-arm`).
. tracked = false
. arm = id
while arm != 0
    . next SyntaxId = 0
    do match? tree.nodes[arm]
        | .node-if-block(row)
            . pattern = tree.pattern-arm(arm)
            if pattern != 0
                . subject SyntaxId = 0
                do match? tree.nodes[row.condition]
                    | .node-match-expression(matching)
                        subject = matching.subject
                do match? tree.nodes[pattern]
                    | .node-type-transform(transform)
                        if tracks-subject || (transform.pattern != 0 && tracks-pattern)
                            tracked = true
                        .. tracks-subject = reads-tracked(tree, subject)
                        .. tracks-pattern = reads-tracked(tree, transform.pattern)
            else if row.condition != 0
                if !(tree.nodes[row.condition] is .node-type-predicate)
                    = false
                if reads-tracked(tree, row.condition)
                    tracked = true
            next = row.next
    arm = next
= tracked

────────────────────
_ do is-match-region Bool
    - tree AST
    - id SyntaxId

` Whether a `match` written as a line of markup content is a region whose arm is selected again
` when what its subject reads tracked changes, as the reference's `markupMatchBranch` compiles
` one: its subject reads something tracked, and its arms are each a pattern with a body
` (`match-arms`). One with a helper is no region here.
do match? tree.nodes[id]
    | .node-match-expression(row)
        if row.subject == 0 || row.helper != 0 || !reads-tracked(tree, row.subject)
            = false
        . held [SyntaxId]
        tree.match-arms(id, held)
        = held.length != 0
= false

────────────────────
_ is-subscriber-loop Bool
    - tree AST
    - loop SyntaxId

` A loop on a stream, `for x on s` or the comprehension `<* x on s`, with no header chained
` after it.
match tree.nodes[loop]
    | .node-loop-syntax(row)
        row.is-subscriber && row.next == 0
    ??
        false

────────────────────
_ is-generator-loop Bool
    - tree AST
    - loop SyntaxId

` A comprehension in expression position compiles as a generator closure that takes its
` container; a bullet body or markup child is a loop of its owner, and a subscription is not a
` generator.
match tree.nodes[loop]
    | .node-loop-syntax(row)
        !row.is-subscriber
    ??
        false

────────────────────
_ do add-pattern-pipe DeclId
    - tree AST
    - id SyntaxId
    - owner DeclId
    - named SyntaxId

` A stream piped through a pattern, `s ~> p`, which the reference compiles as the comprehension
` `~ p in s`: a generator closure given the stream, which yields what each match of the
` pattern gives.
= add-nested-function
    - tree
    - id
    - RowRange'Atom()
    - RowRange'SyntaxId()
    - 0
    - RowRange'SyntaxId()
    - id
    - CompilationEffect.none
    - DeclKind.iterator-decl
    - owner
    - 0
    - named

────────────────────
_ do add-nested-function DeclId
    - tree AST
    - syntax SyntaxId
    - names RowRange'Atom
    - args RowRange'SyntaxId
    - return-type SyntaxId
    - errors RowRange'SyntaxId
    - body SyntaxId
    - effects CompilationEffect
    - kind DeclKind
    - owner DeclId
    - last SyntaxId
    - named SyntaxId

` The subtree is the whole node, as for every function row; a task's worker expression sits
` inside it although the spawning function evaluates it. A bullet list's later bullets follow
` its first one in the tree, so its subtree runs through the last bullet of the chain. `named`
` is the declaration or assignment the function is written in.
. shapes = store-arg-shapes(tree, args)
. primary Atom?
if names.count != 0
    primary = tree.atoms[names.start]
. start = tree.subtree-start(syntax)
. end = if last != 0 then last else syntax
. fn = FunctionDecl
    - syntax
    - primary
    - names
    - owner
    - Access.private-access
    - kind
    - shapes.range
    - return-type
    - errors
    - effects
    - false
    - body
    - SyntaxRange(start, end - start + 1)
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - shapes.variadic-index
    - shapes.required-count
    - false
    - RowRange'SyntaxId()
    - named
= append(fn)

────────────────────
_ do opens-region Bool
    - effects CompilationEffect
    - owner DeclId

` Whether a `do` block with effects is the body of a function of its own, as the reference
` outlines one: a block that makes the zone the collector never sees, written where code is not
` in that zone already, in a function that makes it or in such a block.
if (effects /and/ CompilationEffect.gc-free) == 0
    = false
do match? decls[owner]
    | .decl-function(fn)
        = (fn.effects /and/ CompilationEffect.gc-free) == 0
= true

────────────────────
_ do is-machine-decl Bool
    - decl DeclId

` Whether a function is a state machine's, whose cases a named machine written in them belongs
` to.
do match? decls[decl]
    | .decl-function(fn)
        = fn.kind == .machine-decl
= false

────────────────────
_ do add-main DeclId
    - tree AST

. root = tree.root
. fn = FunctionDecl
    - root
    - null
    - RowRange'Atom()
    - 0
    - Access.private-access
    - DeclKind.main-decl
    - RowRange'DeclId()
    - 0
    - RowRange'SyntaxId()
    - CompilationEffect.none
    - false
    - root
    - SyntaxRange(1, root)
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - U32.max
    - 0
    - true
= append(fn)

────────────────────
_ do add-startup DeclId
    - tree AST
    - kind DeclKind

` A module's init or task main, or the check for a terminating task: a generated function
` with no syntax of its own, whose body emission builds.
. fn = FunctionDecl
    - tree.root
    - null
    - RowRange'Atom()
    - 0
    - Access.private-access
    - kind
    - RowRange'ArgumentShape()
    - 0
    - RowRange'SyntaxId()
    - CompilationEffect.none
    - false
    - 0
    - SyntaxRange(tree.root, 0)
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - U32.max
    - 0
    - true
= append(fn)

────────────────────
_ do add-generated-constructors U32
    - owner DeclId

?! Panic("Module member pool exceeds U32 capacity")
    if member-pool.length + 3 >= U32.max
?! Panic("Module argument pool exceeds U32 capacity")
    if arg-pool.length >= U32.max

. this-name = store-atom("This")
. other-name = store-atom("other")
. no-args = RowRange'ArgumentShape()
. default = generated-function(owner, this-name, .default-constructor-decl, no-args, 0)
member-pool.append(append(default))
. arg-start = arg-pool.length
arg-pool.append(ArgumentShape(other-name, 0, 0, 0, false, .none, false))
. cast-args = RowRange'ArgumentShape(arg-start as U32, 1)
. cast = generated-function(owner, this-name, .cast-constructor-decl, cast-args, 1)
member-pool.append(append(cast))
. tuple = generated-function(owner, this-name, .tuple-constructor-decl, no-args, 0)
member-pool.append(append(tuple))
= 3

────────────────────
_ do add-table-constructors U32
    - owner DeclId
    - class-name Atom

` The table classes of core/table pick their generated constructor by argument type and
` count, so their rows carry named arguments and no type syntax; L4 evaluates the types.
if name != "core/table"
    = 0
. this-name = store-atom("This")
if class-name.text == "IndexSpan"
    . source-name = store-atom("source")
    . source-args = named-args(source-name, null)
    . source-kind = DeclKind.index-span-source-constructor-decl
    member-pool.append(append(generated-function(owner, this-name, source-kind, source-args, 1)))
    . range-args = named-args(source-name, store-atom("range"))
    . range-kind = DeclKind.index-span-range-constructor-decl
    member-pool.append(append(generated-function(owner, this-name, range-kind, range-args, 2)))
    = 2
if class-name.text != "Table"
    = 0
. size-name = store-atom("size")
. arena-name = store-atom("arena")
. capacity-name = store-atom("initial-capacity")
. with-name = store-atom("with")
. count = 0u32
. size-args = named-args(size-name, null)
. size = generated-function(owner, this-name, .table-size-constructor-decl, size-args, 1)
member-pool.append(append(size))
count += 1
. filler-args = named-args(size-name, with-name)
. filler = generated-function(owner, this-name, .table-filler-constructor-decl, filler-args, 2)
member-pool.append(append(filler))
count += 1
. arena-args = named-args(arena-name, null)
. arena = generated-function(owner, this-name, .table-arena-constructor-decl, arena-args, 1)
member-pool.append(append(arena))
. capacity-args = named-args(arena-name, capacity-name)
. capacity-kind = DeclKind.table-capacity-constructor-decl
. capacity = generated-function(owner, this-name, capacity-kind, capacity-args, 2)
member-pool.append(append(capacity))
count += 2
= count

────────────────────
_ do named-args RowRange'ArgumentShape
    - first Atom
    - second Atom?

. start = arg-pool.length
arg-pool.append(ArgumentShape(first, 0, 0, 0, false, .none, false))
if second
    arg-pool.append(ArgumentShape(second, 0, 0, 0, false, .none, false))
= RowRange'ArgumentShape(start as U32, if second then 2 else 1)

────────────────────
_ generated-function FunctionDecl
    - owner DeclId
    - name Atom
    - kind DeclKind
    - args RowRange'ArgumentShape
    - required U32

FunctionDecl
    - 0
    - name
    - RowRange'Atom()
    - owner
    - Access.public-access
    - kind
    - args
    - 0
    - RowRange'SyntaxId()
    - CompilationEffect.none
    - false
    - 0
    - SyntaxRange(0, 0)
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - RowRange'SyntaxId()
    - U32.max
    - required
    - true

────────────────────
_ do add-extension DeclId
    - tree AST
    - syntax SyntaxId
    - receiver SyntaxId
    - member-syntax RowRange'SyntaxId
    - access Access
    - param-constraints RowRange'SyntaxId
    - param-assignments RowRange'SyntaxId
    - facet Atom? = null

. decl = ExtensionDecl
    - syntax
    - receiver
    - RowRange'DeclId()
    - access
    - param-constraints
    - param-assignments
    - facet
    - if facet then store-sees(tree, member-syntax) else RowRange'SyntaxId()
    - if facet then store-interfaces(tree, member-syntax) else RowRange'SyntaxId()
. id = append(decl)
. members = scan-members(tree, member-syntax, id)
if written-content != 0
    keep-undeclared(written-content, 0)
do match? decls[id]
    | .decl-extension(row)
        row.members = members
= id

────────────────────
_ do store-interfaces RowRange'SyntaxId
    - tree AST
    - member-syntax RowRange'SyntaxId

?! Panic("Module syntax pool exceeds U32 capacity")
    if syntax-pool.length >= U32.max

. start = syntax-pool.length
for member in tree.nodes[tree.children[member-syntax]]
    do match? member
        | .node-implements-declaration(row)
            syntax-pool.append(row.type)
= RowRange'SyntaxId(start as U32, (syntax-pool.length - start) as U32)

────────────────────
_ do store-sees RowRange'SyntaxId
    - tree AST
    - member-syntax RowRange'SyntaxId

` The sibling facets a facet names with `sees`, in the order they are written.
?! Panic("Module syntax pool exceeds U32 capacity")
    if syntax-pool.length >= U32.max

. start = syntax-pool.length
for member in tree.nodes[tree.children[member-syntax]]
    do match? member
        | .node-sees-declaration(row)
            syntax-pool.append(row.type)
= RowRange'SyntaxId(start as U32, (syntax-pool.length - start) as U32)

────────────────────
_ do store-delegations RowRange'SyntaxId
    - tree AST
    - member-syntax RowRange'SyntaxId

` The types the properties of a class delegate, in the order they are written.
?! Panic("Module syntax pool exceeds U32 capacity")
    if syntax-pool.length >= U32.max

. start = syntax-pool.length
for member in tree.nodes[tree.children[member-syntax]]
    do match? member
        | .node-delegate-declaration(row)
            for type in tree.children[row.types]
                syntax-pool.append(type)
= RowRange'SyntaxId(start as U32, (syntax-pool.length - start) as U32)

────────────────────
_ do scan-members RowRange'DeclId
    - tree AST
    - member-syntax RowRange'SyntaxId
    - owner DeclId

` A member no row is made for is kept as one the module does not declare. The first section
` with markup written in it is left in `written-content`, and so is a class's `• This` that
` writes its markup (`defaults-content`), as the reference makes its lines the class's content.
` A second is kept as any other member, and so is a section with nothing written in it. The
` delegations written before a property or getter are all its own. A property of a class that
` holds a state machine has its flags before it (`add-machine-members`).
?! Panic("Module member pool exceeds U32 capacity")
    if member-pool.length >= U32.max

. start = member-pool.length
written-content = 0
pending-delegates = RowRange'SyntaxId()
for offset in 0 .. < member-syntax.count
    . member-id = tree.children[member-syntax.start + offset]
    do match? tree.nodes[member-id]
        | .node-delegate-declaration(row)
            queue-delegates(tree, row.types)
    . member-decl = scan-member(tree, member-id, owner)
    if member-decl == 0 && !is-attached-syntax(tree, member-id)
        if written-content == 0 && !tree.is-empty-section(member-id) && is-markup
            written-content = member-id
        else
            keep-undeclared(member-id, if decls[owner] is .decl-class then owner else 0)
        .. is-markup = is-markup-section(tree, member-id)
    if member-decl != 0
        if decls[owner] is .decl-class
            add-machine-members(tree, owner, member-decl)
        member-pool.append(member-decl)
        do match? decls[member-decl]
            | .decl-function(fn)
                if fn.kind == .getter-decl && pending-delegates.count != 0
                    fn.delegates = pending-delegates
                    pending-delegates = RowRange'SyntaxId()
        if written-content == 0 && decls[owner] is .decl-class && tree.defaults-content(member-id)
            written-content = member-id
    if member-id >= next-syntax
        next-syntax = member-id + 1
= RowRange'DeclId(start as U32, (member-pool.length - start) as U32)

────────────────────
_ do queue-delegates
    - tree AST
    - types RowRange'SyntaxId

` Adds the types of a delegation to those waiting for the next property or getter, kept in the
` syntax pool.
?! Panic("Module syntax pool exceeds U32 capacity")
    if syntax-pool.length >= U32.max

. start = syntax-pool.length
if pending-delegates.start + pending-delegates.count == start
    start = pending-delegates.start
else
    for offset in 0 .. < pending-delegates.count
        syntax-pool.append(syntax-pool[pending-delegates.start + offset])
for type in tree.children[types]
    syntax-pool.append(type)
pending-delegates = RowRange'SyntaxId(start as U32, (syntax-pool.length - start) as U32)

────────────────────
_ is-attached-syntax Bool
    - tree AST
    - id SyntaxId

` A member with no row of its own that is kept on another: the interfaces a type implements,
` and the types the next property or getter delegates to.
match tree.nodes[id]
    | .node-implements-declaration
        true
    | .node-sees-declaration
        true
    | .node-delegate-declaration
        true
    ??
        false

────────────────────
_ do is-markup-section Bool
    - tree AST
    - id SyntaxId

` A section of a type whose lines are markup: none of them declares anything but a lazy local
` the markup reads or a property the markup gives its value (`content-property`), and a state
` machine is written in it only as a line of its own, which the reference keeps on the object.
do match? tree.nodes[id]
    | .node-content-block(row)
        do match? tree.nodes[row.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    if tree.content-property(statement)
                        continue
                    if is-declaration-syntax(tree, statement)
                        = false
                    do match? tree.nodes[statement]
                        | .node-declare(declared)
                            if !declared.is-lazy
                                = false
                    if !(tree.nodes[statement] is .node-state-machine) && is-writer
                        = false
                    .. is-writer = writes-machine(tree, statement)
                = true
= false

────────────────────
_ do writes-machine Bool
    - tree AST
    - id SyntaxId

` Whether a state machine is written in a node.
for node in tree.subtree-start(id) .. id
    if tree.nodes[node] is .node-state-machine
        = true
= false

────────────────────
_ do class-body-start SyntaxId
    - tree AST
    - type-args RowRange'SyntaxId
    - base SyntaxId
    - or-bases RowRange'SyntaxId
    - constraints RowRange'SyntaxId
    - assignments RowRange'SyntaxId

. last SyntaxId = next-syntax - 1
if or-bases.count == 0 && base > last
    last = base
for range in [type-args, or-bases, constraints, assignments]
    if range.count
        . child = tree.children[range.start + range.count - 1]
        if child > last
            last = child
= last + 1

────────────────────
_ do extension-body-start SyntaxId
    - tree AST
    - receiver SyntaxId
    - as-types RowRange'SyntaxId
    - constraints RowRange'SyntaxId
    - assignments RowRange'SyntaxId

. last = receiver
if as-types.count
    . child = tree.children[as-types.start + as-types.count - 1]
    if child > last
        last = child
if constraints.count
    . child = tree.children[constraints.start + constraints.count - 1]
    if child > last
        last = child
if assignments.count
    . child = tree.children[assignments.start + assignments.count - 1]
    if child > last
        last = child
= last + 1

────────────────────
_ do add-property DeclId
    - tree AST
    - syntax SyntaxId
    - left SyntaxId
    - value SyntaxId
    - access Access
    - owner DeclId
    - is-lazy Bool
    - decoration Atom?

do match? tree.nodes[left]
    | .node-type-identifier(ident)
        = append(AssociatedDecl(syntax, ident.name, owner, RowRange'SyntaxId(), value, access))
    | .node-type-arguments(args)
        . base = match? tree.nodes[args.base]
            | .node-type-identifier(ident)
                ident.name
        if base
            = append(AssociatedDecl(syntax, base, owner, args.args, value, access))

. parts = capture-parts(tree, left)
. decl = PropertyDecl
    - syntax
    - parts.name
    - owner
    - parts.type-syntax
    - value
    - decoration
    - access
    - is-lazy
    - pending-delegates
pending-delegates = RowRange'SyntaxId()
= append(decl)

────────────────────
_ do store-arg-shapes StoredShapes
    - tree AST
    - args RowRange'SyntaxId

?! Panic("Module argument pool exceeds U32 capacity")
    if arg-pool.length >= U32.max

. start = arg-pool.length
. variadic-index = U32.max
. required = 0u32
for offset in 0 .. < args.count
    . arg-id = tree.children[args.start + offset]
    do match tree.nodes[arg-id]
        | .node-argument-decl(arg)
            . parts = capture-parts(tree, arg.pattern)
            . default = arg.default-value
            . pattern = arg.pattern
            . variadic = arg.is-variadic
            . type-syntax = parts.type-syntax
            . specificity = type-specificity(tree, type-syntax)
            . has-default = default != 0
            if variadic && variadic-index == U32.max
                variadic-index = offset
            if !has-default && variadic-index == U32.max
                required += 1
            arg-pool.append
                - ArgumentShape
                    - parts.name
                    - type-syntax
                    - default
                    - pattern
                    - variadic
                    - specificity
                    - has-default
        ??
            arg-pool.append(ArgumentShape(null, 0, 0, arg-id, false, .none, false))

. range = RowRange'ArgumentShape(start as U32, (arg-pool.length - start) as U32)
= StoredShapes(range, variadic-index, required)

────────────────────
_ type-specificity Specificity
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-type-match(row)
        match row.op
            | .match-exactly
                .exact
            | .match-similar
                .similar
            | .match-convertible
                .convertible
    ??
        Specificity.none

────────────────────
_ capture-parts CapturedName
    - tree AST
    - id SyntaxId

|? id == 0
    CapturedName(null, 0)
??
    match tree.nodes[id]
        | .node-type-capture(capture)
            CapturedName(capture-identifier-name(tree, capture.id), capture.type)
        | .node-identifier(identifier)
            CapturedName(identifier.name, 0)
        ??
            CapturedName(null, 0)

────────────────────
_ capture-identifier-name Atom?
    - tree AST
    - id SyntaxId

|? id == 0
    null
??
    match? tree.nodes[id]
        | .node-identifier(identifier)
            identifier.name

━━━━━━━━━━━━━━━━━━━━
+ StoredShapes is Tuple

+ range RowRange'ArgumentShape
+ variadic-index U32
+ required-count U32

━━━━━━━━━━━━━━━━━━━━
_ function-kind DeclKind
    - is-getter Bool
    - is-setter Bool

|? is-getter
    DeclKind.getter-decl
|? is-setter
    DeclKind.setter-decl
??
    DeclKind.function-decl

━━━━━━━━━━━━━━━━━━━━
_ do new-decl-table Table'Decl
    - arena Arena

. decls = Table'Decl(arena, 1)
decls.append(NoDecl(0))
= decls

━━━━━━━━━━━━━━━━━━━━
_ RowNames

` The names the row of each keyed markup loop reads tracked, as the reference gives them: the
` loop's item, by the name its header writes, `each` and `it`, and each declaration of the row's
` body, in order, that is lazy or whose value reads one of the names before it, which the
` reference reads again each time. Each loop's names hold in its body, from `starts` to
` `ends`, from its first in `firsts`.

_ starts [SyntaxId]
_ ends [SyntaxId]
_ firsts [Size]
_ names [String]

────────────────────
+ do add
    - tree AST
    - loop SyntaxId
    - body SyntaxId

. first = names.length
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        do match? tree.nodes[row.pattern]
            | .node-type-capture(capture)
                do match? tree.nodes[capture.id]
                    | .node-identifier(named)
                        names += named.name.text
names += "each"
names += "it"
do match? tree.nodes[body]
    | .node-block(block)
        for line in tree.children[block.body]
            do match? tree.nodes[line]
                | .node-declare(declared)
                    . plain = !declared.is-pattern && declared.right != 0 && holds-no-machine
                        .. holds-no-machine = tree.declared-machine(declared.right) == 0
                    do match? tree.nodes[declared.left]
                        | .node-type-capture(capture)
                            do match? tree.nodes[capture.id]
                                | .node-identifier(named)
                                    if plain && (declared.is-lazy || names-first)
                                        names += named.name.text
                                    .. names-first = names-in(tree, declared.right, first)
starts += tree.subtree-start(body)
ends += body
firsts += first

────────────────────
_ do names-in Bool
    - tree AST
    - value SyntaxId
    - first Size

` Whether a value reads one of the names from `first` on, functions written in it included.
for id in tree.subtree-start(value) .. < value + 1
    do match? tree.nodes[id]
        | .node-identifier(row)
            for position in first .. < names.length
                if names[position] == row.name.text
                    = true
= false

────────────────────
+ do reads Bool
    - id SyntaxId
    - name String

` Whether a name read at a node is one a keyed markup loop's row reads tracked there.
for index in 0 .. < starts.length
    if starts[index] <= id && id <= ends[index]
        . last = if index + 1 < firsts.length then firsts[index + 1] else names.length
        for position in firsts[index] .. < last
            if names[position] == name
                = true
= false

━━━━━━━━━━━━━━━━━━━━
_ Namings

` The declarations and assignments whose values are open while a tree is walked from its last
` node down, each with the nodes of its value.

+ nodes [SyntaxId]
_ starts [SyntaxId]
_ ends [SyntaxId]

────────────────────
+ do open
    - tree AST
    - id SyntaxId

` Opens a node that is a declaration or an assignment with a value.
. value = 0u32
do match? tree.nodes[id]
    | .node-declare(row)
        value = row.right
    | .node-assign(row)
        value = row.rhs
if value == 0
    =
nodes += id
starts += tree.subtree-start(value)
ends += value

────────────────────
+ do close
    - id SyntaxId

` Closes what the walk has gone below.
while nodes.length != 0 && id < starts[starts.length - 1]
    nodes.pop()
    starts.pop()
    ends.pop()

────────────────────
+ do innermost SyntaxId
    - id SyntaxId
    - floor Size

` The innermost open one above `floor` whose value holds a node, or none.
. position = nodes.length
while position > floor
    position -= 1
    if starts[position] <= id && id <= ends[position]
        = nodes[position]
= 0
