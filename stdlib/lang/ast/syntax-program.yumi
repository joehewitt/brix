_ leading-import-line-limit = 1024
_ leading-import-scan-limit = 65536
_ kept-module-rounds U64 = 4

━━━━━━━━━━━━━━━━━━━━
+ SyntaxProgram
    is Usable'Void

+ source-path String
+ root-paths [String]
+ modules [SyntaxModule]
+ edges [ImportEdge]
+ builtin-paths [String]
+ resolver ModuleResolver
+ sources [String = String]
+ keeps-going = false
+ probes = ProbeSelection()
+ target Target?
+ absent-imports [AbsentImport]
+ failures [String = String]

_ source-text String?
_ cached ModuleView?
_ module-cache [String = ModuleSource]
_ builtin-modules [String = ModuleSource]
_ parse-queue ParseQueue
_ active = 0
_ c-names [String = Bool]
_ pending-c-modules [ModuleSource]
_ atoms AtomPool
_ parse-worker-count = default-worker-count
_ root-names [String = Bool]
_ parsed Bool
_ materialized Bool
_ atoms-transferred Bool
_ atoms-shared Bool
_ shared-lock Mutex?
_ released Bool
_ chose-c-headers Bool

────────────────────
+ This
    - configured-search-paths [Path]
    - configured-c-module-paths [String = [Path]]

.. resolver = ModuleResolver(configured-search-paths, configured-c-module-paths)

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ get view ModuleView?

cached

────────────────────
+ get shares-atoms Bool

atoms-shared

────────────────────
+ get atom-lock Mutex?

shared-lock

────────────────────
+ do use-c-headers
    - headers CHeaders

` Reads C headers in `headers`, whatever the target of the roots says.
resolver.use-c-headers(headers)
chose-c-headers = true

────────────────────
+ do use-modules
    - view ModuleView

?! Panic("SyntaxProgram is stale or already parsed")
    if released || parsed
atoms.release()
atoms = view.cache.atoms
atoms-shared = true
shared-lock = view.cache.atom-lock
cached = view

────────────────────
+ do parse
    - source-path String
    - module-name String
    - parse-worker-count = default-worker-count
    - source String? = null

?! Error("Missing source path")
    if !source-path && !source
?! Panic("SyntaxProgram is stale or already parsed")
    if released || parsed

. path = if source-path then resolved-path(source-path, "") else source-path
this.source-path = path
this.source-text = source
this.parse-worker-count = parse-worker-count

do finally
    if !parsed
        release()

admit-root(path)
parse-queue.start(atoms, parse-worker-count, shared-lock)
import-builtin-modules()
. name = resolver.module-name-of(path) ?? module-name
root-names[name] = true
import-yumi-module(path, name, source)
parse-pending()
order-modules()
parsed = true

────────────────────
+ do parse-batch
    - roots [(String, String)]
    - parse-worker-count = default-worker-count

` Parses the modules of a batch: each root, given its path and module name, and what each imports.
` The first root stands as the entry module.
parse-roots(roots, parse-worker-count, true)

────────────────────
+ do parse-modules
    - roots [(String, String)]
    - parse-worker-count = default-worker-count

parse-roots(roots, parse-worker-count, false)

────────────────────
+ has-module Bool
    - path String

some(modules) • where each.path == path

────────────────────
+ do materialize-c-headers

?! Panic("SyntaxProgram is stale or not parsed")
    if released || !parsed || atoms-transferred
if materialized
    =

. scanned Size
while pending-c-modules.length != 0
    while scanned < modules.length
        collect-c-names(modules[scanned].tree)
        scanned += 1
    parse-queue = ParseQueue()
    parse-queue.start(atoms, parse-worker-count, shared-lock)
    queue-c-modules()
    parse-pending()
order-modules()
materialized = true

────────────────────
+ path-to-module Path?
    - name String

resolver.path-to-module(name)

────────────────────
+ do take-atoms AtomPool

?! Panic("SyntaxProgram is stale or not materialized")
    if released || !materialized || atoms-transferred
atoms-transferred = true
= atoms

────────────────────
+ do release

if !released
    parse-queue.close()
    parse-queue.settle()
    for module in modules
        module.release()
    if !atoms-transferred && !atoms-shared
        atoms.release()
    module-cache.clear()
    builtin-modules.clear()
    released = true

────────────────────
_ do parse-roots
    - roots [(String, String)]
    - parse-worker-count Int
    - batch Bool

?! Error("Missing source path")
    if !roots
?! Panic("SyntaxProgram is stale or already parsed")
    if released || parsed

. resolved [(String, String)] = (resolved-path(each[0], ""), each[1]) in roots
this.source-path = resolved[0][0]
this.parse-worker-count = parse-worker-count

do finally
    if !parsed
        release()

for root in resolved
    admit-root(root[0])
parse-queue.start(atoms, parse-worker-count, shared-lock)
import-builtin-modules()
for root in resolved
    root-names[root[1]] = true
    import-yumi-module(root[0], root[1])
    if batch
        root-paths += root[0]
parse-pending()
order-modules()
if !batch
    for root in resolved
        if has-module(root[0])
            this.source-path = root[0]
            break
parsed = true

────────────────────
_ do parse-pending

if active == 0
    parse-queue.close()
    =
. failure Error?
for result in parse-queue.results()
    if result.error && keeps-going && result.error is not Panic
        failures[result.source-path] = result.error.message
    else if result.error
        if failure is not Panic
            failure = result.error
        parse-queue.close()
    if result.is-partial
        if !failure
            . accepted = catch accept-imports(result.source-path, result.imports)
            if accepted is Error
                failure = accepted
                parse-queue.close()
        continue
    if result.tree
        . tree = kept-tree(result)
        if failure
            tree.release()
        else
            . accepted = catch accept-tree(tree, result)
            if accepted is Error
                failure = accepted
                parse-queue.close()
    active -= 1
    if active == 0
        parse-queue.close()
. absent = resolver.take-absent()
. view = cached
if view
    for path in absent
        view.note-absent(path)
?! failure as Panic
    if failure is Panic
if failure
    ?! failure

────────────────────
_ do kept-tree AST
    - result ParseResult

. tree = result.tree!
. view = cached
=? tree if !view || tree.is-lent
= view.keep(result)

────────────────────
_ do queue-parse
    - path String
    - source String?

active += 1
. view = cached
if view
    . found = view.found(path, source)
    if found
        parse-queue.reuse(found)
        =
    view.expect(path, source)
parse-queue.input-queue <- ParseJob(path, source)

────────────────────
_ do order-modules

. ordered-modules [SyntaxModule] = sort(modules) • using compare-module-paths
modules = ordered-modules
. ordered-edges [ImportEdge] = sort(edges) • using compare-edge-sources
edges = ordered-edges

────────────────────
_ do accept-imports
    - source-path String
    - imports [ParsedImport]

. source = module-cache[source-path]
?! Panic("Parsed module was not registered")
    if !source
. module = source
for import in imports
    admit(import.loc ?? MatchLocation(), import.path, module, source-path)

────────────────────
_ do accept-tree
    - tree AST
    - result ParseResult

. source = module-cache[result.source-path]
?! Panic("Parsed module was not registered")
    if !source
. module = source
. transferred = false
do finally
    if !transferred
        tree.release()
. imports-markup = false
. imports-style = false
. imports-probes = false
for import in result.imports
    . written = if import.loc then exclusive-end-location(import.loc) else MatchLocation()
    . imported = admit(written, import.path, module, result.source-path)
    if imported
        edges += ImportEdge(module.path, imported.path, import.is-export)
        if imported.name == markup-module-name
            imports-markup = true
        if imported.name == style-module-name
            imports-style = true
        if imported.name == probes-module-name
            imports-probes = true
if result.uses-streams && !builtin-modules[module.name]
    for stream-module in stream-module-names
        . imported = import-module(MatchLocation(), stream-module, module)
        edges += ImportEdge(module.path, imported.path, false, true)
if result.uses-markup && module.name != markup-module-name && !imports-markup
    . imported = import-module(MatchLocation(), markup-module-name, module)
    edges += ImportEdge(module.path, imported.path, false, true)
if result.uses-style-sheets && module.name != style-module-name && !imports-style
    . imported = import-module(MatchLocation(), style-module-name, module)
    edges += ImportEdge(module.path, imported.path, false, true)
if probes.is-enabled && module.name != probes-module-name && !imports-probes && wants-probes
    . imported = import-module(MatchLocation(), probes-module-name, module)
    edges += ImportEdge(module.path, imported.path, false, true)
.. wants-probes = root-names[module.name] || (result.uses-probes && !is-core-module(module.name))
modules += SyntaxModule
    - module.name
    - resolver.relative-path(module.path, if root-paths then root-paths else [source-path])
    - tree
transferred = true

────────────────────
_ do admit ModuleSource? ?! Error
    - loc MatchLocation
    - name String
    - scope-module ModuleSource
    - source-path String

=? import-present-module(loc, name, scope-module, source-path) if !keeps-going
. imported = catch import-present-module(loc, name, scope-module, source-path)
=? imported if !(imported is Error)
failures[source-path] = (imported as Error).message
= null

────────────────────
_ do admit-root ?! Error
    - path String

. suffix = module-platform(path)
if !target
    target = target-including(suffix)
?! Error("${file-name(path)} ends in \".${suffix}\", which isn't a platform")
    if suffix && !is-platform(suffix)
?! Error("${file-name(path)} isn't part of ${target!.name} builds")
    if !target!.includes(suffix)
if resolver.c-headers.target-name != target!.name
    ?! Error("The C headers are ${c-target}'s, and ${file-name(path)} is built for ${target!.name}")
        if chose-c-headers
    .. c-target = resolver.c-headers.target-name
    resolver.use-c-headers(target-c-headers(target!))

────────────────────
_ do module-platform String?
    - path String

` The platform a module is built for, from the last part of its name. A module of a file family
` that names none there is built for every platform, as `box.scroll.yumi` is.
. suffix = platform-suffix(path)
=? null if suffix && !is-platform(suffix) && resolver.family-base(path)
= suffix

────────────────────
_ do import-present-module ModuleSource? ?! Error
    - loc MatchLocation
    - name String
    - scope-module ModuleSource
    - source-path String

do match? resolver.find-module(name, scope-module.name, scope-module.path)
    | module-name, module-path
        . family = resolver.family-base(module-path as String)
        ?! YumiSyntaxError(loc, family-message, source-of(source-path), source-path)
            if family && !resolver.in-family(scope-module.path, family)
        .. family-message = "Module \"$name\" belongs to the file family of ${file-name(family)}, so only that family can import it"
        . suffix = module-platform(module-path as String)
        if !target!.includes(suffix)
            ?! YumiSyntaxError(loc, platform-message, source-of(source-path), source-path)
                if !is-platform(suffix!)
            .. platform-message = "Module \"$name\" ends in \".${suffix!}\", which isn't a platform"
            . importer = module-platform(scope-module.path)
            ?! YumiSyntaxError(loc, "Module \"$name\" is never part of the same build as ${file-name(scope-module.path)}", source-of(source-path), source-path)
                if !builds-together(importer, suffix)
            absent-imports += AbsentImport(scope-module.name, module-path as String)
            = null
= import-module(loc, name, scope-module, source-path)

────────────────────
_ do import-module ModuleSource ?! Error
    - loc MatchLocation
    - name String
    - scope-module ModuleSource? = null
    - source-path String? = null

=? match? resolver.find-c-module(name)
    | c-header-path Path
        import-c-module(c-header-path, name)

=? match? resolver.find-module(name, scope-module?.name, scope-module?.path)
    | module-name, module-path
        import-yumi-module(module-path, module-name)

. refused = resolver.refused-folder(name, scope-module?.name, scope-module?.path)
?! YumiSyntaxError(loc, message, source-of(source-path), source-path)
    if refused != null
.. message = "Module \"$name\" is private to $place, so only modules there can import it"
.. place = if refused.length != 0 then "$refused/" else "its folder"
?! YumiSyntaxError(loc, "Module \"$name\" not found", source-of(source-path), source-path)

────────────────────
_ do source-of String?
    - source-path String?

=? source-text if source-path != null && source-path == this.source-path && source-text
=? read-file-text(Path(source-path)) if source-path
= null

────────────────────
_ file-name String
    - path String

last(path.split("/")) ?? path

────────────────────
_ do import-builtin-modules

for module-name in builtin-module-names
    . module = import-module(MatchLocation(), module-name)
    builtin-modules[module-name] = module
    builtin-paths += module.path

for module-name in core-module-names
    import-module(MatchLocation(), runtime-name(module-name))

────────────────────
_ do create-module ModuleSource
    - path Path
    - name String

. mod = ModuleSource(path as String, name, "")
module-cache[path as String] = mod

= mod

────────────────────
_ do collect-c-names
    - tree AST

for node in tree.nodes
    do match? node
        | .node-c-identifier(reference)
            c-names[reference.name.text] = true

────────────────────
_ do import-yumi-module ModuleSource
    - path Path
    - name String
    - source String? = null

=? match? module-cache[path as String]
    | module ModuleSource
        module

. module = create-module(path, name)
queue-parse(path as String, source ?? sources[path as String])

= module

────────────────────
_ do import-c-module ModuleSource
    - path Path
    - name String

=? match? module-cache[path as String]
    | module ModuleSource
        module

. module = ModuleSource(path as String, name, "")
module-cache[path as String] = module
pending-c-modules += module

= module

────────────────────
_ do queue-c-modules Bool

if pending-c-modules.length == 0
    = false
. queued [ModuleSource] = pending-c-modules
pending-c-modules = List'ModuleSource()
for module in queued
    . source = c-header-source
        - resolver.c-headers
        - resolver.c-include-paths()
        - module.path
        - c-names
    module.source = source
    for module-name in builtin-c-module-names
        import-module(MatchLocation(), module-name, module)
    if source.find("String") != null
        import-module(MatchLocation(), "core/string", module)
    queue-parse(module.path, source)
= true

