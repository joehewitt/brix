────────────────────
+ This
    - name String
    - relative-path String
    - tree AST

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ get path String

tree.source-path

────────────────────
+ do take-tree AST

?! Panic("SyntaxModule is stale or already transferred")
    if released || transferred
transferred = true
= tree

────────────────────
+ do release

if !released
    if !transferred
        tree.release()
    released = true

━━━━━━━━━━━━━━━━━━━━
+ ImportEdge is Tuple

` An import of one module by another. One that `follows` is declared after what the importing
` module declares, as the stream modules are for a module that uses stream syntax.

+ from String
+ to String
+ is-export Bool
+ follows Bool

━━━━━━━━━━━━━━━━━━━━
+ ModuleCache
    is Usable'Void

+ atoms AtomPool
+ atom-lock = Mutex()

_ versions [String = [CachedModule]]
_ next-id = 0
_ lock = Mutex()
_ released Bool

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

use lock
if !released
    for _, held in versions
        for entry in held
            entry.release()
    versions.clear()
    atoms.release()
    released = true

────────────────────
+ view ModuleView

ModuleView(this)

────────────────────
+ do claim CachedModule?
    - path String
    - stamp ParseStamp

use lock
. held = versions[path]
=? null if !held
for entry in held
    if entry.stamp.matches(stamp)
        entry.holders += 1
        = entry
= null

────────────────────
+ do add CachedModule
    - stamp ParseStamp
    - result ParseResult

use lock
next-id += 1
. entry = CachedModule
    - next-id
    - result.source-path
    - stamp
    - result.tree!
    - result.imports
    - result.uses-streams
    - result.uses-markup
    - result.uses-style-sheets
    - result.uses-probes
entry.holders = 1
. held = versions[entry.path] ?? List'CachedModule()
held += entry
versions[entry.path] = held
= entry

────────────────────
+ do drop
    - entry CachedModule

use lock
entry.holders -= 1
=? if entry.holders != 0
. held = versions[entry.path]
if held
    . kept [CachedModule]
    for each in held
        if each.id != entry.id
            kept += each
    if kept.length == 0
        -= versions[entry.path]
    else
        versions[entry.path] = kept
entry.release()

────────────────────
+ do claim-build BuiltModule?
    - entry CachedModule
    - name String
    - relative-path String
    - hosts [String]

use lock
for build in entry.builds
    if build.module.name == name && build.module.relative-path == relative-path && serves-hosts
        build.holders += 1
        = build
    .. serves-hosts = build.serves(hosts)
= null

────────────────────
+ do add-build BuiltModule
    - entry CachedModule
    - module Module
    - consulted [String]
    - defaulted [String]

use lock
next-id += 1
. build = BuiltModule(next-id, module, consulted, defaulted)
build.holders = 1
entry.builds += build
= build

────────────────────
+ do drop-build
    - entry CachedModule
    - build BuiltModule

use lock
build.holders -= 1
=? if build.holders != 0
. kept [BuiltModule]
for each in entry.builds
    if each.id != build.id
        kept += each
entry.builds = kept
build.module.release()

────────────────────
_ do retain
    - entry CachedModule

use lock
entry.holders += 1

────────────────────
_ do retain-build
    - build BuiltModule

use lock
build.holders += 1

━━━━━━━━━━━━━━━━━━━━
+ ModuleView
    is Usable'Void

+ cache ModuleCache

_ current [String = CachedModule]
_ builds [String = BuiltModule]
_ expected [String = ParseStamp]
_ inputs [String = ParseStamp]
_ used [String = U64]
_ round U64
_ letting-go [CachedModule]
_ letting-go-builds [HeldBuild]
_ released Bool

────────────────────
+ This
    - cache ModuleCache

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

if !released
    for path, build in builds
        letting-go-builds += HeldBuild(current[path]!, build)
    builds.clear()
    for _, entry in current
        letting-go += entry
    current.clear()
    settle()
    released = true

────────────────────
+ do settle

for held in letting-go-builds
    cache.drop-build(held.entry, held.build)
letting-go-builds.clear()
for entry in letting-go
    cache.drop(entry)
letting-go.clear()

────────────────────
+ do finish-round

. stale [String]
for path, last in used
    if last + kept-module-rounds <= round
        stale += path
for path in stale
    -= used[path]
    release-build(path)
    . entry = current[path]
    if entry
        -= current[path]
        letting-go += entry
round += 1

────────────────────
+ do take-inputs [String = ParseStamp]

. taken = inputs
inputs = Map'String'ParseStamp()
= taken

────────────────────
+ do note-files
    - paths [String]

for path in paths
    . stamp = parse-stamp(path, null)
    if stamp
        note-input(path, stamp)

────────────────────
+ do pin ModulePins
    - paths [String]

. pins = ModulePins(cache)
for path in paths
    . entry = current[path]
    if entry
        pins.hold(entry, builds[path])
= pins

────────────────────
+ do found ParseResult?
    - path String
    - source String?

. stamp = parse-stamp(path, source)
=? null if !stamp
note-input(path, stamp)
. entry = cache.claim(path, stamp)
=? null if !entry
hold(entry)
. held = entry
= ParseResult
    - path
    - held.tree.lend()
    - null
    - held.imports
    - held.uses-streams
    - false
    - held.uses-markup
    - held.uses-style-sheets
    - held.uses-probes

────────────────────
+ do expect
    - path String
    - source String?

. stamp = parse-stamp(path, source)
if stamp
    expected[path] = stamp
    note-input(path, stamp)
else
    -= expected[path]
    note-absent(path)

────────────────────
+ do keep AST
    - result ParseResult

. tree = result.tree!
. path = result.source-path
. stamp = expected[path] ?? ParseStamp(tree.source, 0, 0, 0, false)
-= expected[path]
. entry = cache.add(stamp, result)
hold(entry)
= tree.lend()

────────────────────
+ do built Module?
    - path String
    - name String
    - relative-path String
    - hosts [String]

. entry = current[path]
=? null if !entry
. build = cache.claim-build(entry, name, relative-path, hosts)
=? null if !build
hold-build(entry, build)
= build.module

────────────────────
+ do keep-module Bool
    - path String
    - module Module
    - consulted [String]
    - hosts [String]

. entry = current[path]
=? false if !entry
. defaulted [String]
for name in consulted
    if hosts.find(name) != null
        defaulted += name
hold-build(entry, cache.add-build(entry, module, consulted, defaulted))
= true

────────────────────
+ do note-absent
    - path String

if !inputs[path]
    inputs[path] = ParseStamp("", 0, 0, 0, false)

────────────────────
_ do note-input
    - path String
    - stamp ParseStamp

if stamp.is-file
    inputs[path] = stamp

────────────────────
_ do hold
    - entry CachedModule

used[entry.path] = round
. previous = current[entry.path]
if previous && previous.id == entry.id
    cache.drop(entry)
    =
release-build(entry.path)
current[entry.path] = entry
if previous
    letting-go += previous

────────────────────
_ do hold-build
    - entry CachedModule
    - build BuiltModule

. previous = builds[entry.path]
if previous && previous.id == build.id
    cache.drop-build(entry, build)
    =
release-build(entry.path)
builds[entry.path] = build

────────────────────
_ do release-build
    - path String

. previous = builds[path]
=? if !previous
-= builds[path]
letting-go-builds += HeldBuild(current[path]!, previous)

━━━━━━━━━━━━━━━━━━━━
+ ModulePins

+ cache ModuleCache

_ entries [CachedModule]
_ builds [HeldBuild]

────────────────────
+ This
    - cache

────────────────────
+ do release

for held in builds
    cache.drop-build(held.entry, held.build)
builds.clear()
for entry in entries
    cache.drop(entry)
entries.clear()

────────────────────
_ do hold
    - entry CachedModule
    - build BuiltModule?

cache.retain(entry)
entries += entry
if build
    cache.retain-build(build)
    builds += HeldBuild(entry, build)

━━━━━━━━━━━━━━━━━━━━
+ ParseStamp is Tuple

+ text String
+ size I64
+ seconds I64
+ nanoseconds I64
+ is-file Bool

────────────────────
+ matches Bool
    - other ParseStamp

same-coarse-stat && nanoseconds == other.nanoseconds && text == other.text

.. same-coarse-stat = is-file == other.is-file && size == other.size && seconds == other.seconds

━━━━━━━━━━━━━━━━━━━━
+ do file-stamp ParseStamp?
    - path String

= parse-stamp(path, null)

━━━━━━━━━━━━━━━━━━━━
_ ModuleSource

+ path String
+ name String
+ source String

────────────────────
+ This
    - path String
    - name String
    - source String

━━━━━━━━━━━━━━━━━━━━
_ ParseQueue
    is Closable

+ input-queue SyncBufferedChannel'ParseJob
+ output-queue SyncBufferedChannel'ParseResult

_ worker Worker?
_ scratch-pool SyncBufferedChannel'Arena?
_ atom-lock Mutex

────────────────────
+ do close

input-queue.close()

────────────────────
+ do start
    - atoms AtomPool
    - thread-count = default-worker-count
    - lock Mutex? = null

?! Panic("ParseQueue is already started")
    if worker
if lock
    atom-lock = lock

. started = Worker(thread-count)
. scratch = SyncBufferedChannel'Arena()
for _ in 0 .. < thread-count
    scratch <- Arena()
worker = started
scratch-pool = scratch
//compiler.parse.queue.run -> thread-count

do new
    do finally
        started.stop()
        scratch.close()
        for each in scratch
            each.release()
        //compiler.parse.queue.stop -> thread-count
        output-queue.close()

    for job in input-queue
        do (started) new
            . arena = (<- scratch)!
            do finally
                scratch <- arena
            . result = parse-job(job, arena, output-queue, started, atoms, atom-lock)
                catch failure Error
                    ParseResult(job.source-path, null, failure, List'ParsedImport(), false, false)
            output-queue <- result
        catch failed
            output-queue <- ParseResult(job.source-path, null, failed, List'ParsedImport(), false, false)

────────────────────
+ do reuse
    - result ParseResult

output-queue <- result

────────────────────
+ do settle

=? if !worker
for result in output-queue
    if result.tree
        result.tree.release()

────────────────────
+ do results Iterable'ParseResult

?! Panic("ParseQueue is not started")
    if !worker

for result in output-queue
    <= result

━━━━━━━━━━━━━━━━━━━━
_ ParseJob is Tuple

+ source-path String
+ source String?

━━━━━━━━━━━━━━━━━━━━
_ ParsedImport is Tuple

+ loc MatchLocation?
+ path String
+ is-export Bool

━━━━━━━━━━━━━━━━━━━━
_ ParseResult is Tuple

+ source-path String
+ tree AST?
+ error Error?
+ imports [ParsedImport]
+ uses-streams Bool
+ is-partial Bool
+ uses-markup Bool
+ uses-style-sheets Bool
+ uses-probes Bool

━━━━━━━━━━━━━━━━━━━━
_ HeldBuild is Tuple

+ entry CachedModule
+ build BuiltModule

━━━━━━━━━━━━━━━━━━━━
_ CachedModule

+ id Int
+ path String
+ stamp ParseStamp
+ tree AST
+ imports [ParsedImport]
+ uses-streams Bool
+ uses-markup Bool
+ uses-style-sheets Bool
+ uses-probes Bool
+ builds [BuiltModule]
+ holders = 0

────────────────────
+ This
    - id
    - path
    - stamp
    - tree
    - imports
    - uses-streams
    - uses-markup
    - uses-style-sheets
    - uses-probes

────────────────────
+ do release

for build in builds
    build.module.release()
builds.clear()
tree.release()

━━━━━━━━━━━━━━━━━━━━
_ BuiltModule

+ id Int
+ module Module
+ consulted [String]
+ defaulted [String]
+ holders = 0

────────────────────
+ This
    - id
    - module
    - consulted
    - defaulted

────────────────────
+ serves Bool
    - hosts [String]

all(consulted) • where (hosts.find(each) != null) == (defaulted.find(each) != null)

━━━━━━━━━━━━━━━━━━━━
_ do parse-job ParseResult ?! Error
    - job ParseJob
    - scratch Arena
    - output SyncBufferedChannel'ParseResult
    - pool Worker
    - atoms AtomPool
    - atom-lock Mutex

. source String
. is-brix = job.source-path.ends-with(brix-extension)
if job.source
    source = job.source
else
    source = read-file-text(Path(job.source-path))
    . leading = if is-brix then brix-leading-imports(source) else leading-imports(source)
    if leading.length != 0
        output <- ParseResult(job.source-path, null, null, leading, false, true)

//compiler.parse.queue.start -> job.source-path, source.length, get-current-task-id(), (C:yumiGetActiveThreadMemory() as Pointer).address
. tree = if is-brix then parse-brix(source, job.source-path, scratch) else parse-yumi-in-pieces(source, job.source-path, scratch, pool, atoms, atom-lock)
//compiler.parse.queue.end -> job.source-path, source.length, get-current-task-id(), (C:yumiGetActiveThreadMemory() as Pointer).address, true
. imports = parsed-imports(tree)
tree.share-program-atoms(atoms, atom-lock)
. finished = tree.finish(atoms)
= ParseResult
    - job.source-path
    - finished
    - null
    - imports
    - uses-stream-syntax(finished)
    - false
    - uses-markup-syntax(finished)
    - uses-style-sheet-syntax(finished)
    - uses-probe-syntax(finished)

━━━━━━━━━━━━━━━━━━━━
_ do leading-imports [ParsedImport]
    - source String

. imports [ParsedImport]
. bytes = byte-view(source)
. scan-end = bytes.length
if scan-end > leading-import-scan-limit
    scan-end = leading-import-scan-limit
. line-start Index
. line = 0u32
for cursor in 0 .. < scan-end
    if bytes[cursor] == 10
        if !register-leading-import-line(bytes, line-start, cursor, line, imports)
            = imports
        line-start = cursor + 1
        line += 1
        continue

    if cursor - line-start >= leading-import-line-limit
        = imports

if scan-end == bytes.length && line-start < scan-end
    register-leading-import-line(bytes, line-start, scan-end, line, imports)
= imports

━━━━━━━━━━━━━━━━━━━━
_ do register-leading-import-line Bool
    - source Byte[]
    - start Index
    - end Index
    - line U32
    - imports [ParsedImport]

. line-end = end
if line-end > start && source[line-end - 1] == 13
    line-end -= 1

. cursor = start
while cursor < line-end && (source[cursor] == 32 || source[cursor] == 9)
    cursor += 1

if cursor == line-end || source[cursor] == 96
    = true
if cursor != start
    = false

. written = cursor
if cursor + 1 < line-end && source[cursor] == 43 && source[cursor + 1] == 32
    cursor += 2

. path-start = cursor
if cursor < line-end && source[cursor] == 47
    cursor += 1
    path-start = cursor
else if cursor < line-end && source[cursor] == 46
    if cursor + 2 < line-end && source[cursor + 1] == 46 && source[cursor + 2] == 47
        cursor += 3
    else if cursor + 1 < line-end && source[cursor + 1] == 47
        cursor += 2
    else
        = false
else
    = false

. segment-start = cursor
while cursor < line-end
    . byte = source[cursor]
    if byte == 47
        if cursor == segment-start
            = false
        segment-start = cursor + 1
    else
        if !is-leading-import-byte(byte)
            = false
    cursor += 1

if cursor == segment-start
    = false

. first = TokenLocation(line, (written - start) as U32)
. last = TokenLocation(line, (line-end - start) as U32)
. path = source.slice-string(path-start .. < line-end)
imports += ParsedImport(MatchLocation(first, last), path, false)
= true

━━━━━━━━━━━━━━━━━━━━
_ do brix-leading-imports [ParsedImport]
    - source String

. imports [ParsedImport]
. bytes = byte-view(source)
. scan-end = bytes.length
if scan-end > leading-import-scan-limit
    scan-end = leading-import-scan-limit
. cursor Index
. line-start Index
. line = 0u32
while cursor < scan-end
    . byte = bytes[cursor]
    if byte == 10
        cursor += 1
        line-start = cursor
        line += 1
    else if byte == 32 || byte == 9 || byte == 13
        cursor += 1
    else if byte == 59
        while cursor < scan-end && bytes[cursor] != 10
            cursor += 1
    else
        . next = register-brix-import(bytes, cursor, scan-end, line, line-start, imports)
        =? imports if next == 0
        cursor = next
= imports

━━━━━━━━━━━━━━━━━━━━
_ do register-brix-import Index
    - source Byte[]
    - start Index
    - end Index
    - line U32
    - line-start Index
    - imports [ParsedImport]

=? 0 if source[start] != 40
. head-end = start + 1
while head-end < end && source[head-end] >= 97 && source[head-end] <= 122
    head-end += 1
. head = source.slice-string(start + 1 .. < head-end)
if head == "blank"
    =? 0 if head-end >= end || source[head-end] != 41
    = head-end + 1
. is-export = head == "export"
=? 0 if !is-export && head != "import"
=? 0 if head-end >= end || source[head-end] != 32

. cursor = head-end
while cursor < end && source[cursor] == 32
    cursor += 1
. path-start = cursor
if cursor < end && source[cursor] == 47
    cursor += 1
    path-start = cursor
else if cursor < end && source[cursor] == 46
    if cursor + 2 < end && source[cursor + 1] == 46 && source[cursor + 2] == 47
        cursor += 3
    else if cursor + 1 < end && source[cursor + 1] == 47
        cursor += 2
    else
        = 0
else
    = 0

. segment-start = cursor
while cursor < end && source[cursor] != 32 && source[cursor] != 41
    . byte = source[cursor]
    if byte == 47
        =? 0 if cursor == segment-start
        segment-start = cursor + 1
    else if !is-leading-import-byte(byte)
        = 0
    cursor += 1
=? 0 if cursor == segment-start
. path-end = cursor
while cursor < end && source[cursor] == 32
    cursor += 1
=? 0 if cursor >= end || source[cursor] != 41

. first = TokenLocation(line, (start - line-start) as U32)
. last = TokenLocation(line, (cursor + 1 - line-start) as U32)
imports += ParsedImport
    - MatchLocation(first, last)
    - source.slice-string(path-start .. < path-end)
    - is-export
= cursor + 1

━━━━━━━━━━━━━━━━━━━━
_ is-leading-import-byte Bool
    - byte Byte

is-lowercase || is-uppercase || is-digit || byte == 95 || byte == 45 || byte == 46

.. is-lowercase = byte >= 97 && byte <= 122
.. is-uppercase = byte >= 65 && byte <= 90
.. is-digit = byte >= 48 && byte <= 57

━━━━━━━━━━━━━━━━━━━━
_ compare-module-paths
    - a SyntaxModule
    - b SyntaxModule

|? a.relative-path != b.relative-path
    compare-basic(a.relative-path, b.relative-path)
??
    compare-basic(a.path, b.path)

━━━━━━━━━━━━━━━━━━━━
_ compare-edge-sources
    - a ImportEdge
    - b ImportEdge

compare-basic(a.from, b.from)

━━━━━━━━━━━━━━━━━━━━
_ do parsed-imports [ParsedImport]
    - tree ASTBuilder

. imports [ParsedImport]
match tree.nodes[tree.root]
    | .node-top-level-syntax(root)
        for syntax-node in tree.nodes[tree.child-ids(root.statements)]
            do match? syntax-node
                | .node-import-syntax(import)
                    . path = ""
                    for path-offset in 0 .. < import.paths.count
                        if path-offset
                            path += "/"
                        path += tree.atoms[import.paths.start + path-offset].text
                    imports += ParsedImport(import.loc, path, import.is-export)
    ?! Panic("AST root has the wrong syntax case")
= imports

━━━━━━━━━━━━━━━━━━━━
_ is-core-module Bool
    - name String

name == "core" || name.starts-with("core/")

━━━━━━━━━━━━━━━━━━━━
_ do parse-stamp ParseStamp?
    - path String
    - source String?

=? ParseStamp(source, 0, 0, 0, false) if source
. file = Path(path)
=? null if !file.is-file
. stat = file.stat
= ParseStamp("", stat.size, stat.mtime.s, stat.mtime.ns, true)
