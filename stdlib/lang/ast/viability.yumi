./decl
./module
./row-range

━━━━━━━━━━━━━━━━━━━━
+ do viable Viability
    - module Module
    - decl DeclId
    - calls [CallArgument]
    - slots [U32]

match? module.decls[decl]
    | .decl-function(row)
        = viable-shapes(module, row, calls, slots)
slots.clear()
= Viability(.not-viable, 0, 0)

━━━━━━━━━━━━━━━━━━━━
+ do viable-shapes Viability
    - module Module
    - row FunctionDecl
    - calls [CallArgument]
    - slots [U32]

. count = row.args.count
. empty = ArgumentFill.fill-empty
slots.clear()
for _ in 0 .. < count
    slots += empty

. is-variadic = row.variadic-index != U32.max
. next = 0u32
. filled = 0u32
. tail = 0u32
. position = 0u32
for call in calls
    . index = position
    position += 1
    if call.is-skipped
        continue
    if call.name
        . found = shape-index(module, row, call.name)
        if found == U32.max && call.is-property
            continue
        if found != U32.max
            if slots[found] != empty
                if call.is-property
                    continue
                = Viability(.not-viable, 0, 0)
            slots[found] = index
            if found + 1 > filled
                filled = found + 1
            if found == next
                next += 1
            if is-variadic
                tail += 1
        else if is-variadic && index >= row.variadic-index && !call.is-variadic-list
            tail += 1
        else
            = Viability(.not-viable, 0, 0)
    else if is-variadic && index >= row.variadic-index && !call.is-variadic-list
        tail += 1
    else
        if next < count
            slots[next] = index
        next += 1
        if next > filled
            filled = next

if tail != 0
    if filled < count
        slots[filled] = ArgumentFill.fill-variadic
    filled += 1

if count != 0
    . offset = 0
    for shape in module.arg-pool[row.args]
        if slots[offset] == empty && !shape.has-default
            = Viability(.partially-viable, filled, tail)
        offset += 1

if filled > count
    = Viability(.not-viable, 0, 0)
= Viability(.fully-viable, filled, tail)

━━━━━━━━━━━━━━━━━━━━
+ shape-index U32
    - module Module
    - row FunctionDecl
    - name Atom

|? row.args.count == 0
    U32.max
??
    scan-shapes(module, row, name)

━━━━━━━━━━━━━━━━━━━━
_ do scan-shapes U32
    - module Module
    - row FunctionDecl
    - name Atom

. offset = 0u32
for shape in module.arg-pool[row.args]
    if shape.name && shape.name == name
        = offset
    offset += 1
= U32.max
