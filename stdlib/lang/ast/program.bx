(import ./ast)
(import ./ast-children)
(import ./ast-nodes)
(import ./decl)
(import ./effects)
(import ./facets)
(import ./module)
(import ./module-resolver)
(import ./operator)
(import ./probe-selection)
(import ./row-range)
(import /core/arena)
(import /core/array-builder)
(import /core/atom-pool)
(import /core/map)
(import /lang/target)
(import /stream/aggregate)
(blank)
(type-line + ImportDistance (is U16))

(type + Program
  (implements (of Usable Void))
  (prop + modules (of ImmutableArray Module ArenaBacking))
  (prop + entry-module ModuleId)
  (prop + init-order (of ImmutableArray U32 ArenaBacking))
  (prop + declare-order (of ImmutableArray U32 ArenaBacking))
  (prop _ atoms AtomPool)
  (prop _ index-arena Arena)
  (prop _ module-arena Arena)
  (prop _ name-ids (of Map Atom U32 ArenaBacking))
  (prop _ path-ids (of Map Atom U32 ArenaBacking))
  (prop _ module-names (of Map Atom U32 ArenaBacking))
  (prop _ bucket-starts (of ImmutableArray U32 ArenaBacking))
  (prop _ entry-modules (of ImmutableArray U32 ArenaBacking))
  (prop _ entry-decls (of ImmutableArray U32 ArenaBacking))
  (prop _ ranks (of ImmutableArray U16 ArenaBacking))
  (prop _ extension-ranks (of ImmutableArray U16 ArenaBacking))
  (prop _ extension-key-modules (of ImmutableArray U32 ArenaBacking))
  (prop _ extension-key-decls (of ImmutableArray U32 ArenaBacking))
  (prop _ extension-starts (of ImmutableArray U32 ArenaBacking))
  (prop _ extension-modules (of ImmutableArray U32 ArenaBacking))
  (prop _ extension-decls (of ImmutableArray U32 ArenaBacking))
  (prop _ listing (of ImmutableArray U16 ArenaBacking))
  (prop _ latest-listing (of ImmutableArray U32 ArenaBacking))
  (prop _ parse-atoms (of Map String Atom ArenaBacking))
  (prop _ atom-ordinals (of Map Atom U32 ArenaBacking))
  (prop _ later-ordinals _ (= (call (of Map Atom U32))))
  (prop _ later-keys _ (= (call (of Map Atom U32))))
  (prop _ carried-keys (? (of Map Atom U32)))
  (prop _ derived-names _ (= (call (of Map Atom Bool))))
  (prop _ atom-lock Mutex)
  (prop + batch-roots (of ImmutableArray U32 ArenaBacking))
  (prop + batch-order-starts (of ImmutableArray U32 ArenaBacking))
  (prop + batch-order-modules (of ImmutableArray U32 ArenaBacking))
  (prop + probes _ (= (call ProbeSelection)))
  (prop + target _ (= (call host-target)))
  (prop + shows-ubrix _ (= false))
  (prop + absent-imports (list AbsentImport))
  (prop + feature-gate-starts (of ImmutableArray U32 ArenaBacking))
  (prop + feature-gates (of ImmutableArray U32 ArenaBacking))
  (prop + facets _ (= (call FacetTable)))
  (prop + effects _ (= (call EffectTable)))
  (prop + families (list U32))
  (prop _ batch-cases (of ImmutableArray U64 ArenaBacking))
  (prop _ borrows Bool)
  (prop _ shares-atoms Bool)
  (prop _ trees-released Bool)
  (prop _ released Bool)
  (fn-do + This _
    (param atoms AtomPool)
    (param index-arena Arena)
    (param module-arena Arena)
    (param modules (of ImmutableArray Module ArenaBacking))
    (param entry-module ModuleId)
    (param init-order (of ImmutableArray U32 ArenaBacking))
    (param declare-order (of ImmutableArray U32 ArenaBacking))
    (param name-ids (of Map Atom U32 ArenaBacking))
    (param path-ids (of Map Atom U32 ArenaBacking))
    (param module-names (of Map Atom U32 ArenaBacking))
    (param bucket-starts (of ImmutableArray U32 ArenaBacking))
    (param entry-modules (of ImmutableArray U32 ArenaBacking))
    (param entry-decls (of ImmutableArray U32 ArenaBacking))
    (param ranks (of ImmutableArray U16 ArenaBacking))
    (param extension-ranks (of ImmutableArray U16 ArenaBacking))
    (param extension-key-modules (of ImmutableArray U32 ArenaBacking))
    (param extension-key-decls (of ImmutableArray U32 ArenaBacking))
    (param extension-starts (of ImmutableArray U32 ArenaBacking))
    (param extension-modules (of ImmutableArray U32 ArenaBacking))
    (param extension-decls (of ImmutableArray U32 ArenaBacking))
    (param listing (of ImmutableArray U16 ArenaBacking))
    (param latest-listing (of ImmutableArray U32 ArenaBacking))
    (param parse-atoms (of Map String Atom ArenaBacking))
    (param atom-ordinals (of Map Atom U32 ArenaBacking))
    (param batch-roots (of ImmutableArray U32 ArenaBacking))
    (param batch-order-starts (of ImmutableArray U32 ArenaBacking))
    (param batch-order-modules (of ImmutableArray U32 ArenaBacking))
    (param batch-cases (of ImmutableArray U64 ArenaBacking))
    (param feature-gate-starts (of ImmutableArray U32 ArenaBacking))
    (param feature-gates (of ImmutableArray U32 ArenaBacking))
    (param borrows Bool)
    (param shares-atoms Bool)
    (param atom-lock Mutex)
  )
  (fn-expr + is-batch Bool :get
    ; Whether the program is a batch of cases, each a root module that starts in a task of its own.
    (!= (. batch-roots length) 0)
  )
  (fn-do + runs-main Bool
    (param module ModuleId)
    ; Whether the statements of a module are a program's main: those of the entry module, or of the
    ; root module of each case of a batch.
    (if (== module entry-module)
      (return true)
    )
    (for (in root batch-roots)
      (if (== root (as module U32))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + shares-case Bool
    (param first ModuleId)
    (param second ModuleId)
    ; Whether some case of a batch reaches both of two modules, as each module of a program that is
    ; not one reaches every other.
    (if (== (. batch-roots length) 0)
      (return true)
    )
    (let words (/ (+ (. batch-roots length) 63) 64))
    (for (in word (..< 0 words))
      (if (!= (/and/ ([] batch-cases (+ (* (as first Size) words) word)) second-cases) 0)
        (return true)
      )
      (lazy second-cases ([] batch-cases (+ (* (as second Size) words) word)))
    )
    (return false)
  )
  (fn-do + note-derived-names _
    (let live (call (of Map Atom Bool)))
    (for (in module modules)
      (for (in decl (. module decls))
        (match? decl
          (case (call .decl-function fn)
            (let name (. fn name))
            (if name
              (match? ([] (. module tree nodes) (. fn syntax))
                (case (call .node-function-syntax row)
                  (if (. row is-live)
                    (= ([] live name) true)
                  )
                )
              )
            )
          )
        )
      )
    )
    (let found (call (of Map Atom Bool)))
    (for (in module modules)
      (for (in decl (. module decls))
        (match? decl
          (case (call .decl-property row)
            (let name (. row name))
            (if (and name (!= (. row value) 0) (not (. row is-lazy)) reaches-live)
              (= ([] found name) true)
            )
            (lazy reaches-live (call reads-live (. module tree) (. row value) live))
          )
        )
      )
    )
    (= derived-names found)
  )
  (fn-expr + is-derived-name Bool
    (param name Atom)
    (has derived-names name)
  )
  (fn-do + same-derived-names Bool
    (param other Program)
    (return-if false (if (!= (. derived-names length) (. other derived-names length))))
    (return (call all (. derived-names keys) (:where (has (. other derived-names) each))))
  )
  (fn-do _ reads-live Bool
    (param tree AST)
    (param value SyntaxId)
    (param live (of Map Atom Bool))
    (for (in node (..< (call (. tree subtree-start) value) (+ value 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-identifier row)
          (return-if true (if (or (. row is-tracked) (has live (. row name)))))
        )
        (case (call .node-get-expression row)
          (return-if true (if (or (. row is-tracked) (has live (. row name)))))
        )
        (case .node-style-read-expression
          (return true)
        )
        (case .node-latest-expression
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do + compiles-probe Bool
    (param module ModuleId)
    (param decl DeclId)
    (param id SyntaxId)
    ; Whether a probe written in a function of a module compiles (see `ProbeSelection`). Every one
    ; written in a function named `inspectable-snapshot`, which writes the snapshot of an object,
    ; compiles wherever probes do.
    (let snapshots false)
    (match? ([] (. ([] modules module) decls) decl)
      (case (call .decl-function row)
        (= snapshots (and (!= (. row name) null) (== (. row name text) "inspectable-snapshot")))
      )
    )
    (return (call (. probes compiles-node) (. ([] modules module) name) (. ([] modules module) tree) id snapshots))
  )
  (fn-do + store-atom Atom
    (param text String)
    ; The atom of a text. One the parse made is found without the pool. Typing stores others on many
    ; threads at once, so the pool is locked.
    (let parsed ([] parse-atoms text))
    (if parsed
      (return parsed)
    )
    (use atom-lock)
    (return (call (. atoms store) text))
  )
  (fn-do + atom-ordinal Index
    (param atom Atom)
    ; A number for an atom that no other atom has, and that does not depend on the order modules were
    ; parsed in: the atoms the modules made are numbered in the order of their texts, and others in
    ; the order they are first numbered, after all of those.
    (return (call numbered atom later-ordinals))
  )
  (fn-do + atom-key Index
    (param atom Atom)
    (let carried carried-keys)
    (if carried
      (use atom-lock)
      (let found ([] carried atom))
      (return-if found (if found))
      (blank)
      (let made (. carried length))
      (= ([] carried atom) made)
      (return made)
    )
    (return (call numbered atom later-keys))
  )
  (fn-do _ numbered Index
    (param atom Atom)
    (param later (of Map Atom U32))
    (let ranked ([] atom-ordinals atom))
    (if ranked
      (return ranked)
    )
    (use atom-lock)
    (let found ([] later atom))
    (return-if found (if found))
    (blank)
    (let made (+ (. atom-ordinals length) (. later length)))
    (= ([] later atom) made)
    (return made)
  )
  (fn-do + continue-keys _
    (param other Program)
    (let carried (call (of Map Atom U32)))
    (let kept (. other carried-keys))
    (if kept
      (for (in (tuple atom key) kept)
        (= ([] carried atom) key)
      )
      (else
        (for (in (tuple atom ordinal) (. other atom-ordinals))
          (= ([] carried atom) ordinal)
        )
        (for (in (tuple atom key) (. other later-keys))
          (= ([] carried atom) key)
        )
      )
    )
    (= carried-keys carried)
  )
  (fn-expr + shares-atoms-with Bool
    (param other Program)
    (== atoms (. other atoms))
  )
  (fn-expr + module-by-path (? Index)
    (param path String)
    (case? found
      found
    )
    (where
      (lazy found ([] path-ids (call store-atom path)))
    )
  )
  (fn-expr + module-by-name (? Index)
    (param name String)
    (case? found
      found
    )
    (where
      (lazy found ([] module-names (call store-atom name)))
    )
  )
  (fn-expr + sees Bool
    (param caller ModuleId)
    (param module ModuleId)
    ; Whether a module can name what another declares: itself, or a module it imports.
    (!= ([] ranks (+ (* caller (. modules length)) module)) (. U16 max))
  )
  (fn-expr + listed U16
    (param caller ModuleId)
    (param module ModuleId)
    ; Where a module comes among those another can name, in the order the reference lists what
    ; they declare: the modules it imports first, and itself last. The most there is for a
    ; module it cannot name.
    ([] listing (+ (* caller (. modules length)) module))
  )
  (fn-expr + listed-last U32
    (param caller ModuleId)
    (param module ModuleId)
    ; Where a module comes last among those another can name, in the order `listed` follows; the
    ; reference looks for a type written by name from the last of these places to the first.
    ([] latest-listing (+ (* caller (. modules length)) module))
  )
  (fn-expr + lookup Candidates
    (param caller ModuleId)
    (param name Atom)
    (before
      (throw (call OutOfBoundsError "Program caller module index out of bounds") (if (>= caller (. modules length))))
    )
    (case? (not name-id)
      (call Candidates this caller 0 0)
    )
    (default
      (call Candidates this caller ([] bucket-starts name-id) ([] bucket-starts (+ name-id 1)))
    )
    (where
      (lazy name-id ([] name-ids name))
    )
  )
  (fn-do + c-constant-text (? String)
    (param caller ModuleId)
    (param name Atom)
    ; The number a constant a C header defines is written as, where a header module the caller
    ; imports declares one by the name, behind a minus sign when it is negative. A name read as a
    ; constant is that number written with no suffix.
    (for (in candidate (call lookup caller name))
      (let owner ([] modules (. candidate module)))
      (if (call (. owner name ends-with) ".h")
        (match? ([] (. owner decls) (. candidate decl))
          (case (call .decl-property property)
            (match? ([] (. owner tree nodes) (. property value))
              (case (call .node-integer-syntax row)
                (return (. row value))
              )
              (case (call .node-unary-expression row)
                (match? ([] (. owner tree nodes) (. row operand))
                  (case (call .node-integer-syntax literal)
                    (if (== (. row op) .negative-op)
                      (return (str "-" (. literal value)))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-do + unseen-declarations (list Candidate)
    (param caller ModuleId)
    (param name Atom)
    (let found (list Candidate))
    (if (>= caller (. modules length))
      (return found)
    )
    (let name-id ([] name-ids name))
    (if (not name-id)
      (return found)
    )
    (for (in entry (..< ([] bucket-starts name-id) ([] bucket-starts (+ name-id 1))))
      (if (== (call entry-rank caller entry) (. U16 max))
        (+= found (call Candidate ([] entry-modules entry) ([] entry-decls entry) (. U16 max)))
      )
    )
    (return found)
  )
  (fn-do + visible-names (list Atom)
    (param caller ModuleId)
    (let found (list Atom))
    (if (>= caller (. modules length))
      (return found)
    )
    (for (in name (. name-ids keys))
      (let name-id (!! ([] name-ids name)))
      (for (in entry (..< ([] bucket-starts name-id) ([] bucket-starts (+ name-id 1))))
        (if (!= (call entry-rank caller entry) (. U16 max))
          (+= found name)
          (break)
        )
      )
    )
    (return found)
  )
  (fn-do + candidate-after (tuple Size (? Candidate))
    (param found Candidates)
    (param last-key Size)
    ; The nearest candidate past the one whose key was last, with its own key. A key is the import
    ; distance and then the position among the name's declarations, and no key is zero.
    (let best-key (. Size max))
    (let best-offset (. Size max))
    (for (in entry (..< (. found begin) (. found end)))
      (let rank (call entry-rank (. found caller) entry))
      (if (!= rank (. U16 max))
        (let key (/or/ (/lshift/ (+ (as rank Size) 1) 32) (- entry (. found begin))))
        (if (and (< key best-key) (> key last-key))
          (= best-key key)
          (= best-offset entry)
        )
      )
    )
    (let none (? Candidate))
    (if (== best-offset (. Size max))
      (return (tuple last-key none))
    )
    (let found-module ([] entry-modules best-offset))
    (let found-rank (call entry-rank (. found caller) best-offset))
    (return (tuple best-key (call Candidate found-module ([] entry-decls best-offset) found-rank)))
  )
  (fn-do _ entry-rank U16
    (param caller ModuleId)
    (param entry Size)
    ; How far a module is through its imports from a declaration a name finds, or none. A facet's
    ; name is as near as its owner's module, whose import brings it.
    (let total (. modules length))
    (let module ([] entry-modules entry))
    (let rank ([] ranks (+ (* caller total) module)))
    (return-if rank (if (or (!= rank (. U16 max)) (>= module (. facets hosts length)) (== ([] (. facets hosts) module) (. U32 max)))))
    (blank)
    (let facet (call (. facets index-of) module ([] entry-decls entry)))
    (return-if rank (if (or (not facet) (!= ([] (. facets states) facet) .facet-bound))))
    (return ([] ranks (+ (* caller total) ([] (. facets owner-modules) facet))))
  )
  (fn-do + facet-listed-last U32
    (param caller ModuleId)
    (param module ModuleId)
    ; Where a module that declares a facet comes last among those another can name, or where its
    ; owner's module does, whose import brings the facet's name.
    (let own (call listed-last caller module))
    (return-if own (if (or (!= own (. U32 max)) (>= module (. facets hosts length)) (== ([] (. facets hosts) module) (. U32 max)))))
    (return (call listed-last caller ([] (. facets hosts) module)))
  )
  (fn-do + extensions-for Extensions
    (param caller ModuleId)
    (param module ModuleId)
    (param decl DeclId)
    (throw (call OutOfBoundsError "Program caller module index out of bounds") (if (>= caller (. modules length))))
    (blank)
    (for (in key (..< 0 (. extension-key-modules length)))
      (if (and (== ([] extension-key-modules key) module) (== ([] extension-key-decls key) decl))
        (return (call Extensions this caller ([] extension-starts key) ([] extension-starts (+ key 1))))
      )
    )
    (return (call Extensions this caller 0 0))
  )
  (fn-do + extension-after (tuple Size (? ExtensionRef))
    (param found Extensions)
    (param entry Size)
    ; The first extension at or past an entry that the caller can see, with the entry after it. A
    ; facet is seen wherever its class is, but code in a module that declares facets of the class
    ; sees only those it reaches.
    (let total (. modules length))
    (for (in position (..< entry (. found end)))
      (let owner ([] extension-modules position))
      (let extension (as ([] extension-decls position) DeclId))
      (let facet (only-if (call (. facets index-of) owner extension) (if (!= (. facets count) 0))))
      (if facet
        (if (or (== owner (. found caller)) (call sees-facet (. found caller) facet))
          (return (tuple (+ position 1) (call ExtensionRef owner extension)))
        )
        (else-if (!= ([] extension-ranks (+ (* (. found caller) total) owner)) (. U16 max))
          (if (or (call extension-is-public owner extension) (call reaches-private (. found caller) owner))
            (return (tuple (+ position 1) (call ExtensionRef owner extension)))
          )
        )
      )
    )
    (let none (? ExtensionRef))
    (return (tuple (. found end) none))
  )
  (fn-do + sees-facet Bool
    (param caller ModuleId)
    (param facet U32)
    ; Whether code in a module sees a facet: anywhere but a module other than its class's that declares
    ; facets of the class, and there, one of those, an ancestor of one, or one that one of them sees.
    (let owner-module ([] (. facets owner-modules) facet))
    (let owner-decl ([] (. facets owner-decls) facet))
    (return-if true (if (or (== caller owner-module) (not (call (. facets declares-facet-of) caller owner-module owner-decl)))))
    (return (call (. facets reaches) caller facet))
  )
  (fn-expr + same-family Bool
    (param module ModuleId)
    (param other ModuleId)
    ; Whether two modules are of one file family, or are one module.
    (or (== module other) (and (< module (. families length)) (< other (. families length)) joined))
    (where
      (lazy joined (== ([] families module) ([] families other)))
    )
  )
  (fn-expr + reaches-access Bool
    (param caller ModuleId)
    (param module ModuleId)
    (param access Access)
    ; Whether code in a module reaches a declaration of a module with an access: a public one, one
    ; shared with the file family of the caller's own, and a private one as `reaches-private` says.
    (match access
      (case .public-access
        true
      )
      (case .family-access
        (call same-family caller module)
      )
      (default
        (call reaches-private caller module)
      )
    )
  )
  (fn-expr + reaches-private Bool
    (param caller ModuleId)
    (param module ModuleId)
    ; Whether code in a module reaches the private declarations of a module: its own, and those of the
    ; module that declares the class of a facet it declares.
    (or (== caller module) (and (< caller (. facets hosts length)) (== ([] (. facets hosts) caller) module)))
  )
  (fn-do + effect-named (? U32)
    (param caller ModuleId)
    (param name Atom)
    ; The number of the effect a name names where code in a module sees it.
    (for (in candidate (call lookup caller name))
      (match? ([] (. ([] modules (. candidate module)) decls) (. candidate decl))
        (case (call .decl-effect row)
          (if (or is-public (call reaches-private caller (. candidate module)))
            (return (call (. effects index-of) (. candidate module) (. candidate decl)))
          )
          (lazy is-public (== (. row access) .public-access))
        )
      )
    )
    (return null)
  )
  (fn-do + bans-named EffectMask
    (param caller ModuleId)
    (param names (of RowRange Atom))
    ; The bans of the effects a `without` section names where code in a module sees them. A name
    ; that names no effect bans nothing; the binder reports it.
    (return-if 0 (if (== (. names count) 0)))
    (blank)
    (let tree (. ([] modules caller) tree))
    (let mask EffectMask 0)
    (for (in offset (..< 0 (. names count)))
      (let found (call effect-named caller ([] (. tree atoms) (+ (. names start) offset))))
      (if (and found (< found (call most-effects)))
        (= mask (/or/ mask (call ban-bit found)))
      )
    )
    (return mask)
  )
  (fn-expr _ extension-is-public Bool
    (param module ModuleId)
    (param decl DeclId)
    (match ([] (. ([] modules module) decls) decl)
      (case (call .decl-extension row)
        (match (. row access)
          (case .public-access
            true
          )
          (default
            false
          )
        )
      )
      (default
        false
      )
    )
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release-trees _
    ; Frees every module's syntax tree and the name and extension index, which only name
    ; resolution reads. Declarations and atoms stay until release.
    (if (not trees-released)
      (if (not borrows)
        (for (in module modules)
          (call (. module release-tree))
        )
      )
      (call (. index-arena release))
      (= trees-released true)
    )
  )
  (fn-do + release _
    (if (not released)
      (call release-trees)
      (if (not borrows)
        (for (in module modules)
          (call (. module release))
        )
        (if (not shares-atoms)
          (call (. atoms release))
        )
      )
      (call (. module-arena release))
      (= released true)
    )
  )
)

(type + ExtensionRef (is Tuple)
  (prop + module ModuleId)
  (prop + decl DeclId)
)

(type + Candidate (is Tuple)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + rank ImportDistance)
)

(type + Candidates (is Tuple)
  (implements (of CursorIterable Candidate Size))
  ; The declarations a name reaches from a module, nearest first. It is a value a loop steps
  ; through, so looking a name up allocates nothing.
  (blank)
  (prop + program Program)
  (prop + caller ModuleId)
  (prop + begin Size)
  (prop + end Size)
  (fn-expr + initial-iterator-state Size :get
    0
  )
  (fn-expr + next-iterator (tuple Size (? Candidate))
    (param last-key Size)
    (call (. program candidate-after) this last-key)
  )
)

(type + Extensions (is Tuple)
  (implements (of CursorIterable ExtensionRef Size))
  ; The extensions of a class that a module can see.
  (blank)
  (prop + program Program)
  (prop + caller ModuleId)
  (prop + begin Size)
  (prop + end Size)
  (fn-expr + initial-iterator-state Size :get
    begin
  )
  (fn-expr + next-iterator (tuple Size (? ExtensionRef))
    (param entry Size)
    (call (. program extension-after) this entry)
  )
)

(type + CheckedDecl (is Tuple)
  (prop + kind DeclKind)
  (prop + body SyntaxId)
  (prop + syntax SyntaxId)
  (prop + subtree SyntaxRange)
  (prop + is-generated Bool)
  (prop + is-imperative Bool)
  (prop + is-main Bool)
  (prop + is-content Bool)
)

(fn-do + describe (? CheckedDecl)
  (param program Program)
  (param module ModuleId)
  (param decl DeclId)
  (let tree (. ([] (. program modules) module) tree))
  (match? ([] (. ([] (. program modules) module) decls) decl)
    (case (call .decl-function fn)
      (let imperative true)
      (match? ([] (. tree nodes) (. fn syntax))
        (case (call .node-function-syntax syntax)
          (= imperative (. syntax imperative))
        )
        (case (call .node-getter-syntax syntax)
          (= imperative (. syntax imperative))
        )
        (case (call .node-setter-syntax syntax)
          (= imperative (. syntax imperative))
        )
      )
      (if (== (. fn kind) .pipeline-decl)
        (= imperative false)
      )
      (let is-main (== (. fn kind) .main-decl))
      (return
        (call CheckedDecl
          (block
            (arg (. fn kind))
            (arg (. fn body))
            (arg (. fn syntax))
            (arg (. fn subtree))
            (arg (. fn is-generated))
            (arg imperative)
            (arg is-main)
            (arg (. fn is-content))
          )
        )
      )
    )
    (case (call .decl-converter row)
      (match? ([] (. tree nodes) (. row syntax))
        (case (call .node-converter-syntax node)
          (return (call described-body tree (. row syntax) (. node body) (. node imperative)))
        )
      )
    )
    (case (call .decl-fromverter row)
      (match? ([] (. tree nodes) (. row syntax))
        (case (call .node-fromverter-syntax node)
          (return (call described-body tree (. row syntax) (. node body) (. node imperative)))
        )
      )
    )
  )
  (return null)
)

(fn-do + rule-match SyntaxId
  (param program Program)
  (param module ModuleId)
  (param decl DeclId)
  ; The grammar of a rule a module declares: the body of a function declared over the
  ; items of a stream, where the body is that pattern, beside any lazy locals declared for it.
  ; None for any other declaration.
  (match? ([] (. ([] (. program modules) module) decls) decl)
    (case (call .decl-function fn)
      (let tree (. ([] (. program modules) module) tree))
      (match? ([] (. tree nodes) (. fn syntax))
        (case (call .node-function-syntax syntax)
          (if (and (!= (. syntax pattern) 0) (not (. fn is-generated)))
            (return (call (. tree stream-statement) (. fn body)))
          )
        )
      )
    )
  )
  (return 0)
)

(fn-expr _ described-body CheckedDecl
  (param tree AST)
  (param syntax SyntaxId)
  (param body SyntaxId)
  (param imperative Bool)
  (call CheckedDecl .function-decl body syntax subtree false imperative false)
  (where
    (lazy start (call (. tree subtree-start) syntax))
    (lazy subtree (call SyntaxRange start (+ (- syntax start) 1)))
  )
)

(fn-expr + checks-at-declaration Bool
  (param declaration CheckedDecl)
  ; Whether how a function returns is checked as the module declares it (`check-return-mode`):
  ; a function, getter, setter or conversion written in the module as one expression.
  (and declared-plain (!= (. declaration body) 0) (or function-or-getter (== (. declaration kind) .setter-decl)))
  (where
    (lazy declared-plain (and (not (. declaration is-generated)) (not (. declaration is-imperative)) (not (. declaration is-main))))
    (lazy function-or-getter (or (== (. declaration kind) .function-decl) (== (. declaration kind) .getter-decl)))
  )
)
