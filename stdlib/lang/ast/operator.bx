(type + Operator (is Union)
  (variant no-op)
  (variant multiply-op)
  (variant divide-op)
  (variant pow-op)
  (variant mod-op)
  (variant add-op)
  (variant subtract-op)
  (variant concat-op)
  (variant not-op)
  (variant delete-op)
  (variant negative-op)
  (variant read-op)
  (variant type-of-op)
  (variant facts-of-op)
  (variant bitwise-and-op)
  (variant bitwise-or-op)
  (variant bitwise-xor-op)
  (variant bitwise-lshift-op)
  (variant bitwise-rshift-op)
  (variant bitwise-zrshift-op)
  (variant optional-force-op)
  (variant eq-op)
  (variant write-all-op)
  (variant bind-op)
  (variant index-get-op)
  (variant index-assign-op)
  (variant index-delete-op)
  (variant coalesce-op)
  (variant if-op)
  (variant else-op)
  (variant map-op)
  (variant filter-op)
  (variant pipe-forward-op)
  (variant pipe-closure-op)
  (variant pipe-repeat-op)
  (variant map-filter-op)
  (variant grammar-pipe-op)
  (variant pipe-write-each-op)
  (variant pipe-write-all-op)
  (variant pipe-backward-op)
  (variant as-op)
  (variant is-op)
  (variant is-not-op)
  (variant is-exactly-op)
  (variant is-not-exactly-op)
  (variant is-similar-op)
  (variant is-not-similar-op)
  (variant and-op)
  (variant or-op)
  (variant less-than-op)
  (variant greater-than-op)
  (variant less-than-equals-op)
  (variant greater-than-equals-op)
  (variant equals-op)
  (variant not-equals-op)
  (variant is-in-op)
  (variant not-in-op)
  (variant has-op)
  (variant has-not-op)
  (variant compose-forward-op)
  (variant compose-backward-op)
  (variant write-op)
  (variant range-to-op)
  (variant range-through-op)
  (variant pattern-ancestor-op)
  (variant pattern-parent-op)
  (variant pattern-descendant-op)
  (variant pattern-child-op)
  (variant pattern-prev-sibling-op)
  (variant pattern-next-sibling-op)
  (variant zero-or-one-op)
  (variant zero-or-more-op)
  (variant one-or-more-op)
  (variant positive-lookahead-op)
  (variant negative-lookahead-op)
  (variant add-eq-op)
  (variant subtract-eq-op)
  (variant multiply-eq-op)
  (variant divide-eq-op)
  (variant mod-eq-op)
  (variant pow-eq-op)
  (variant concat-eq-op)
  (variant bitwise-not-op)
  (variant concat-string-op)
  (fn-to-expr + String
    (match this
      (case= .multiply-op
        "*"
      )
      (case= .divide-op
        "/"
      )
      (case= .pow-op
        "%%"
      )
      (case= .mod-op
        "%"
      )
      (case= .add-op
        "+"
      )
      (case= .subtract-op
        "-"
      )
      (case= .concat-op
        "++"
      )
      (case= .concat-string-op
        "++"
      )
      (case= .not-op
        "!"
      )
      (case= .delete-op
        "-="
      )
      (case= .negative-op
        "-neg"
      )
      (case= .read-op
        "<-read"
      )
      (case= .type-of-op
        "type-of"
      )
      (case= .facts-of-op
        "facts-of"
      )
      (case= .bitwise-not-op
        "not"
      )
      (case= .optional-force-op
        "!"
      )
      (case= .bitwise-and-op
        "/and/"
      )
      (case= .bitwise-or-op
        "/or/"
      )
      (case= .bitwise-xor-op
        "/xor/"
      )
      (case= .bitwise-lshift-op
        "/lshift/"
      )
      (case= .bitwise-rshift-op
        "/rshift/"
      )
      (case= .bitwise-zrshift-op
        "/zrshift/"
      )
      (case= .eq-op
        "="
      )
      (case= .write-all-op
        "<-*"
      )
      (case= .bind-op
        "<->"
      )
      (case= .index-get-op
        "[]"
      )
      (case= .index-assign-op
        "[]="
      )
      (case= .index-delete-op
        "-=[]"
      )
      (case= .coalesce-op
        "??"
      )
      (case= .if-op
        "if"
      )
      (case= .else-op
        "else"
      )
      (case= .map-op
        "*>"
      )
      (case= .filter-op
        "?>"
      )
      (case= .pipe-forward-op
        "|>"
      )
      (case= .pipe-closure-op
        "|=>"
      )
      (case= .pipe-repeat-op
        "*|>"
      )
      (case= .map-filter-op
        "?*>"
      )
      (case= .grammar-pipe-op
        "~>"
      )
      (case= .pipe-write-each-op
        "*->"
      )
      (case= .pipe-write-all-op
        "->"
      )
      (case= .pipe-backward-op
        "<|"
      )
      (case= .as-op
        "as"
      )
      (case= .is-op
        "is"
      )
      (case= .is-not-op
        "is not"
      )
      (case= .is-exactly-op
        "is!"
      )
      (case= .is-not-exactly-op
        "is! not"
      )
      (case= .is-similar-op
        "is~"
      )
      (case= .is-not-similar-op
        "is~ not"
      )
      (case= .and-op
        "and"
      )
      (case= .or-op
        "or"
      )
      (case= .less-than-op
        "<"
      )
      (case= .greater-than-op
        ">"
      )
      (case= .less-than-equals-op
        "<="
      )
      (case= .greater-than-equals-op
        ">="
      )
      (case= .equals-op
        "=="
      )
      (case= .not-equals-op
        "!="
      )
      (case= .is-in-op
        "is in"
      )
      (case= .not-in-op
        "not in"
      )
      (case= .has-op
        "has"
      )
      (case= .has-not-op
        "has not"
      )
      (case= .compose-forward-op
        ">>"
      )
      (case= .compose-backward-op
        "<<"
      )
      (case= .write-op
        "<-write"
      )
      (case= .range-to-op
        ".."
      )
      (case= .range-through-op
        "thru"
      )
      (case= .pattern-ancestor-op
        "*\\"
      )
      (case= .pattern-parent-op
        "\\"
      )
      (case= .pattern-descendant-op
        "*/"
      )
      (case= .pattern-child-op
        "/"
      )
      (case= .pattern-prev-sibling-op
        "--"
      )
      (case= .pattern-next-sibling-op
        "++"
      )
      (case= .zero-or-one-op
        "?"
      )
      (case= .zero-or-more-op
        "*"
      )
      (case= .one-or-more-op
        "+"
      )
      (case= .positive-lookahead-op
        "&"
      )
      (case= .negative-lookahead-op
        "!"
      )
      (case= .add-eq-op
        "+="
      )
      (case= .subtract-eq-op
        "-="
      )
      (case= .multiply-eq-op
        "*="
      )
      (case= .divide-eq-op
        "/="
      )
      (case= .mod-eq-op
        "%="
      )
      (case= .pow-eq-op
        "%%="
      )
      (case= .concat-eq-op
        "++="
      )
      (default
        ""
      )
    )
  )
)

(type + Access (is Union)
  (variant private-access)
  (variant public-access)
  (variant family-access)
)

(type + TypeMatchOperator (is Union)
  (variant match-convertible)
  (variant match-similar)
  (variant match-exactly)
)

(type + ClauseOperator (is Union)
  (variant whenever-clause)
  (variant when-clause)
  (variant while-clause)
  (variant until-clause)
  (variant keyed-by-clause)
)

(fn-expr + is-pipeline-closure Bool
  (param op Operator)
  ; A map or filter pipeline compiles its right operand as a closure over the item; a forward
  ; pipe passes the left value to a call and a write pipe loops in place.
  (or (== op .map-op) (== op .filter-op) (== op .map-filter-op))
)

(fn-expr + is-pipeline-nested Bool
  (param op Operator)
  ; Every pipeline whose right operand is the body of a generated closure: the map and filter
  ; forms over `each`, a tap over `each` whose result is discarded, and a closure pipe over `it`.
  (or (call is-pipeline-closure op) (== op .pipe-repeat-op) (== op .pipe-closure-op))
)

(fn-expr + is-constant-arithmetic Bool
  (param op Operator)
  ; The binary operators a constant expression of numbers can be evaluated through: arithmetic,
  ; powers, and the bitwise operators, which work on 32 bits.
  (or arithmetic (== op .mod-op) (== op .pow-op) bitwise shift)
  (where
    (lazy arithmetic (or (== op .add-op) (== op .subtract-op) (== op .multiply-op) (== op .divide-op)))
    (lazy bitwise (or (== op .bitwise-and-op) (== op .bitwise-or-op) (== op .bitwise-xor-op)))
    (lazy shift (or (== op .bitwise-lshift-op) (== op .bitwise-rshift-op) (== op .bitwise-zrshift-op)))
  )
)

(fn-expr + is-comparison Bool
  (param op Operator)
  (case? (or (== op .less-than-op) (== op .greater-than-op))
    true
  )
  (case? (or (== op .less-than-equals-op) (== op .greater-than-equals-op))
    true
  )
  (default
    (or (== op .equals-op) (== op .not-equals-op))
  )
)

(fn-expr + is-type-test Bool
  (param op Operator)
  (case? (or (== op .is-op) (== op .is-not-op))
    true
  )
  (case? (or (== op .is-exactly-op) (== op .is-not-exactly-op))
    true
  )
  (default
    (or (== op .is-similar-op) (== op .is-not-similar-op))
  )
)

(fn-expr + increment-base (? Operator)
  (param op Operator)
  (match? op
    (case= .add-eq-op
      .add-op
    )
    (case= .subtract-eq-op
      .subtract-op
    )
    (case= .multiply-eq-op
      .multiply-op
    )
    (case= .divide-eq-op
      .divide-op
    )
    (case= .mod-eq-op
      .mod-op
    )
    (case= .pow-eq-op
      .pow-op
    )
    (case= .concat-eq-op
      .concat-op
    )
  )
)

(fn-expr + steady-operator Bool
  (param op Operator)
  ; Whether an operator on two numbers or truths gives the same each time without doing anything:
  ; a comparison, `&&` and `||`, and arithmetic that wraps rather than panics.
  (or compares joins wraps)
  (where
    (lazy compares (or (== op .equals-op) (== op .not-equals-op) (== op .less-than-op) (== op .greater-than-op) (== op .less-than-equals-op) (== op .greater-than-equals-op)))
    (lazy joins (or (== op .and-op) (== op .or-op)))
    (lazy wraps (or (== op .add-op) (== op .subtract-op) (== op .multiply-op) (== op .bitwise-and-op) (== op .bitwise-or-op) (== op .bitwise-xor-op)))
  )
)

(fn-expr + is-negated-test Bool
  (param op Operator)
  (or (== op .is-not-op) (== op .is-not-exactly-op) (== op .is-not-similar-op))
)

(fn-expr + hidden-message String
  (param kind String)
  (param name Atom)
  (param access Access)
  ; What an error says of a member another module keeps from this one: that it is private, or that
  ; it is shared with a file family not this one's.
  (case? (is access .private-access)
    (str kind " \"" (. name text) "\" is private")
  )
  (default
    (str kind " \"" (. name text) "\" is shared, declared with ^, so only its own file family can use it")
  )
)

(fn-expr + is-arithmetic Bool
  (param op Operator)
  (case? (or (== op .add-op) (== op .subtract-op) (== op .multiply-op))
    true
  )
  (case? (or (== op .divide-op) (== op .mod-op) (== op .pow-op))
    true
  )
  (case? (or (== op .bitwise-and-op) (== op .bitwise-or-op) (== op .bitwise-xor-op))
    true
  )
  (default
    (or (== op .bitwise-lshift-op) (== op .bitwise-rshift-op) (== op .bitwise-zrshift-op))
  )
)

(fn-expr + is-bitwise Bool
  (param op Operator)
  (or (== op .bitwise-and-op) (== op .bitwise-or-op) (== op .bitwise-xor-op) (call is-shift op))
)

(fn-expr + is-shift Bool
  (param op Operator)
  (or (== op .bitwise-lshift-op) (== op .bitwise-rshift-op) (== op .bitwise-zrshift-op))
)

(fn-expr + negation-of Operator
  (param op Operator)
  ; The comparison that holds exactly when another does not.
  (match op
    (case= .not-equals-op
      .equals-op
    )
    (case= .less-than-op
      .greater-than-equals-op
    )
    (case= .greater-than-op
      .less-than-equals-op
    )
    (case= .less-than-equals-op
      .greater-than-op
    )
    (case= .greater-than-equals-op
      .less-than-op
    )
    (default
      .not-equals-op
    )
  )
)

(fn-expr + opposite-of Operator
  (param op Operator)
  (match op
    (case= .not-equals-op
      .equals-op
    )
    (case= .less-than-op
      .greater-than-op
    )
    (case= .greater-than-op
      .less-than-op
    )
    (case= .less-than-equals-op
      .greater-than-equals-op
    )
    (case= .greater-than-equals-op
      .less-than-equals-op
    )
    (case= .equals-op
      .not-equals-op
    )
    (default
      .equals-op
    )
  )
)

(fn-expr + pipes-stream Bool
  (param op Operator)
  ; Whether a pipe gives each item of a stream to the function written on its right.
  (or (== op .map-op) (== op .filter-op) (== op .map-filter-op) (== op .pipe-repeat-op))
)

(fn-expr + known-answer U64
  (param op Operator)
  (param is-left Bool)
  ; What a comparison answers when its signed side is negative, which the other side cannot be.
  (case? (== op .not-equals-op)
    1
  )
  (case? (or (== op .less-than-op) (== op .less-than-equals-op))
    (if-expr is-left 1u64 0u64)
  )
  (case? (or (== op .greater-than-op) (== op .greater-than-equals-op))
    (if-expr is-left 0u64 1u64)
  )
  (default
    0
  )
)
