/core/arena
/data/sexp

_ brix-head-mask Index = 1023
+ brix-head-names := brix-built-head-names()
_ brix-head-bytes := brix-built-head-bytes()
_ brix-head-slots := brix-built-head-slots()

━━━━━━━━━━━━━━━━━━━━
+ do brix-form-heads Array'U8'ArenaBacking
    - tape SexpTape
    - arena Arena

. heads = Array'U8(arena, tape.length + 1)
. kinds = heads.data
. bytes = tape.bytes
for index in 0 .. < tape.length
    . first = index + 1
    if tape.is-open(index) && tape.is-atom(first)
        kinds[index] = brix-head(bytes, tape.start(first), tape.end(first)) as U8
    else
        kinds[index] = 0
kinds[tape.length] = 0
= heads

━━━━━━━━━━━━━━━━━━━━
+ brix-head BrixHead
    - bytes Byte[]
    - start Index
    - end Index

|? found != .none
    found
|? end - start < 2 || bytes[end - 1] != 63
    .none
??
    brix-head-slot(bytes, start, end - 1)

.. found = brix-head-slot(bytes, start, end)

━━━━━━━━━━━━━━━━━━━━
+ do brix-head-slot BrixHead
    - bytes Byte[]
    - start Index
    - end Index

. slots = brix-head-slots
. keys = brix-head-bytes
. slot = brix-head-hash(bytes, start, end) /and/ brix-head-mask
while slots[slot] != 0
    . found = slots[slot] as Index
    . key = keys[found]
    if key.length == end - start && brix-span-equal(key, bytes, start)
        = found as BrixHead
    slot = (slot + 1) /and/ brix-head-mask
= .none

━━━━━━━━━━━━━━━━━━━━
_ do brix-head-hash Index
    - bytes Byte[]
    - start Index
    - end Index

. data = bytes.data
. hash = 2166136261u32
for index in start .. < end
    hash = (hash /xor/ (data[index] as U32)) * 16777619
= hash

━━━━━━━━━━━━━━━━━━━━
+ do brix-span-equal Bool
    - expected Byte[]
    - bytes Byte[]
    - start Index

for offset in 0 .. < expected.length
    =? false if expected[offset] != bytes[start + offset]
= true

━━━━━━━━━━━━━━━━━━━━
_ brix-built-head-bytes [Byte[]]

** byte-view(each) in brix-head-names

━━━━━━━━━━━━━━━━━━━━
_ do brix-built-head-slots [U16]

. slots = List(0u16 in 0 .. brix-head-mask)
. keys = brix-head-bytes
for found in 1 .. < keys.length
    . key = keys[found]
    . slot = brix-head-hash(key, 0, key.length) /and/ brix-head-mask
    while slots[slot] != 0
        slot = (slot + 1) /and/ brix-head-mask
    slots[slot] = found as U16
= slots

