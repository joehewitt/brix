(import ./ast)
(import ./ast-children)
(import ./ast-nodes)
(import ./row-range)

(type + StateSource (is Tuple)
  ; A case, continuation or fallback that names a case of a machine, with the case or
  ; continuation whose body it is written in, or none at the root.
  (prop + node SyntaxId)
  (prop + owner SyntaxId)
)

(extend + AST
  (fn-do + state-items (list SyntaxId)
    (param body (of RowRange SyntaxId))
    ; The items of the body of a machine, a case or a continuation, with those of a machine
    ; written among them in its place, as the reference joins them.
    (let items (list SyntaxId))
    (for (in item ([] children body))
      (match? ([] nodes item)
        (case (call .node-state-machine row)
          (for (in inner (call state-items (. row body)))
            (+= items inner)
          )
          (continue)
        )
      )
      (+= items item)
    )
    (return items)
  )
  (fn-expr + state-body (of RowRange SyntaxId)
    (param node SyntaxId)
    ; The body of a machine, a case or a continuation; none of anything else.
    (match ([] nodes node)
      (case (call .node-state-machine row)
        (. row body)
      )
      (case (call .node-state-case row)
        (. row body)
      )
      (case (call .node-state-continuation row)
        (. row body)
      )
      (default
        (call (of RowRange SyntaxId))
      )
    )
  )
  (fn-expr + state-name (? Atom)
    (param node SyntaxId)
    ; The case a case or a continuation enters, or a fallback clears.
    (match? ([] nodes node)
      (case (call .node-state-case row)
        (. row name)
      )
      (case (call .node-state-continuation row)
        (. row name)
      )
      (case (call .node-state-fallback row)
        (. row target)
      )
    )
  )
  (fn-expr + state-trigger SyntaxId
    (param node SyntaxId)
    ; The trigger of a case or a continuation, or none.
    (match ([] nodes node)
      (case (call .node-state-case row)
        (. row trigger)
      )
      (case (call .node-state-continuation row)
        (. row trigger)
      )
      (default
        0u32
      )
    )
  )
  (fn-expr + state-targets (of RowRange SyntaxId)
    (param node SyntaxId)
    ; What a case or a continuation gives the case it enters, or the values a fallback names.
    (match ([] nodes node)
      (case (call .node-state-case row)
        (. row target)
      )
      (case (call .node-state-continuation row)
        (. row target)
      )
      (case (call .node-state-fallback row)
        (. row values)
      )
      (default
        (call (of RowRange SyntaxId))
      )
    )
  )
  (fn-expr + is-transition Bool
    (param node SyntaxId)
    (or (is ([] nodes node) .node-state-case) (is ([] nodes node) .node-state-continuation))
  )
  (fn-expr + declared-machine SyntaxId
    (param value SyntaxId)
    ; The state machine a declaration's value is, as the reference reads it, or none for any other
    ; value.
    (case? (== value 0)
      0
    )
    (case? (is ([] nodes value) .node-state-machine)
      value
    )
    (default
      0
    )
  )
  (fn-do + content-machines (list SyntaxId)
    (param content SyntaxId)
    ; The state machines written as lines of a class's markup, each a line of its own, which the
    ; reference keeps on the object, each case's flag a property named after the case, in the order
    ; they run. Where a root `<This` holds the markup, those written beside it, before it and then
    ; after it; the reference declares no type for one among the root's lines.
    (let found (list SyntaxId))
    (if (== content 0)
      (return found)
    )
    (if (!= (call root-this content) 0)
      (for (in machine (call root-machines content false))
        (+= found machine)
      )
      (for (in machine (call root-machines content true))
        (+= found machine)
      )
      (return found)
    )
    (match? ([] nodes (call content-lines content))
      (case (call .node-block block)
        (for (in statement ([] children (. block body)))
          (if (and (is ([] nodes statement) .node-state-machine) (call runs-line content statement))
            (+= found statement)
          )
        )
      )
    )
    (return found)
  )
  (fn-do + root-machines (list SyntaxId)
    (param content SyntaxId)
    (param after Bool)
    ; The state machines written in a class's section beside its root `<This`: those before the
    ; root, or those `after` it. The reference runs them where they are written among the root's
    ; lines.
    (let found (list SyntaxId))
    (let root (call root-this content))
    (if (== root 0)
      (return found)
    )
    (let past false)
    (match? ([] nodes content)
      (case (call .node-content-block row)
        (match? ([] nodes (. row body))
          (case (call .node-block block)
            (for (in statement ([] children (. block body)))
              (if (== statement root)
                (= past true)
                (else-if (and (== past after) (is ([] nodes statement) .node-state-machine))
                  (+= found statement)
                )
              )
            )
          )
        )
      )
    )
    (return found)
  )
  (fn-expr + declared-value SyntaxId
    (param value SyntaxId)
    ; What a declaration's value is evaluated as: the state machine it is, or the value.
    (if-expr (!= machine 0) machine value)
    (where
      (lazy machine (call declared-machine value))
    )
  )
  (fn-expr + declared-local SyntaxId
    (param pattern SyntaxId)
    ; The name a declaration whose value is a state machine declares, or none: one name, with no
    ; type written.
    (match ([] nodes pattern)
      (case .node-identifier
        pattern
      )
      (case (call .node-type-capture row)
        (if-expr (and (== (. row type) 0) (is ([] nodes (. row id)) .node-identifier)) (. row id) 0)
      )
      (default
        0
      )
    )
  )
  (fn-expr + is-entry-item Bool
    (param item SyntaxId)
    ; Whether an item of a case's body runs as the case is entered: any but its cases,
    ; continuations, fallbacks and `do finally` blocks.
    (match ([] nodes item)
      (case .node-state-case
        false
      )
      (case .node-state-continuation
        false
      )
      (case .node-state-fallback
        false
      )
      (case .node-do-finally-block
        false
      )
      (default
        true
      )
    )
  )
  (fn-do + owns-in-case Bool
    (param items (list SyntaxId))
    (param case SyntaxId)
    ; Whether the activation of a case, among the cases of the machine whose body is `items`, owns a
    ; task or a loop on a stream started for it: one started in the body of the case, or of a
    ; continuation that enters it (`owns-in-body`).
    (let name (call state-name case))
    (return-if false (if (not name)))
    (if (and (is ([] nodes case) .node-state-case) (call owns-in-body case))
      (return true)
    )
    (for (in continuation (call continuations-named items name))
      (return-if true (if (call owns-in-body continuation)))
    )
    (return false)
  )
  (fn-do + owns-in-body Bool
    (param node SyntaxId)
    ; Whether a task not marked `@detached`, or a loop on a stream, is started in an entry statement
    ; of the body of a case or a continuation. One started in a `do finally` block, or in a case or
    ; machine written in the body, is not.
    (for (in item (call state-items (call state-body node)))
      (if (and (call is-entry-item item) (== (call nested-machine item) 0))
        (return-if true (if (call starts-owned item)))
      )
    )
    (return false)
  )
  (fn-do + starts-owned Bool
    (param item SyntaxId)
    ; Whether a task not marked `@detached`, or a loop on a stream, is started in a node, or in a
    ; node inside it.
    (for (in node (.. (call subtree-start item) item))
      (match? ([] nodes node)
        (case (call .node-do-task-block row)
          (return-if true (if (not (. row detached))))
        )
        (case (call .node-for-block row)
          (match? ([] nodes (. row loop))
            (case (call .node-loop-syntax loop)
              (return-if true (if (. loop is-subscriber)))
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-expr + group-stream SyntaxId
    (param head SyntaxId)
    ; The stream a group of a body's event transitions is on.
    (call trigger-stream (call state-trigger head))
  )
  (fn-do + trigger-kind (? StateTriggerKind)
    (param trigger SyntaxId)
    (match? ([] nodes trigger)
      (case (call .node-state-trigger row)
        (return (. row kind))
      )
    )
    (return null)
  )
  (fn-expr + is-immediate Bool
    (param trigger SyntaxId)
    ; Whether a trigger is tested where its owner is entered, `if` or `if | p = s`, rather than
    ; on an event.
    (case? (not kind)
      false
    )
    (default
      (or (== kind .state-trigger-if) (== kind .state-trigger-if-match))
    )
    (where
      (lazy kind (call trigger-kind trigger))
    )
  )
  (fn-expr + is-immediate-transition Bool
    (param item SyntaxId)
    ; Whether a case or a continuation is tested where its owner is entered: one with an `if`
    ; trigger, or a continuation with no trigger, which always passes.
    (case? (not (call is-transition item))
      false
    )
    (case? (== trigger 0)
      (is ([] nodes item) .node-state-continuation)
    )
    (default
      (call is-immediate trigger)
    )
    (where
      (lazy trigger (call state-trigger item))
    )
  )
  (fn-do + always-passes Bool
    (param items (list SyntaxId))
    ; Whether one of a body's immediate transitions is a continuation with no trigger, which always
    ; passes, so that where its owner settles, the reference never enters its first case.
    (for (in transition (call immediate-transitions items))
      (if (== (call state-trigger transition) 0)
        (return true)
      )
    )
    (return false)
  )
  (fn-do + trigger-item SyntaxId
    (param trigger SyntaxId)
    (param position U32)
    (match? ([] nodes trigger)
      (case (call .node-state-trigger row)
        (if (< position (. row items count))
          (return ([] children (+ (. row items start) position)))
        )
      )
    )
    (return 0)
  )
  (fn-expr + trigger-stream SyntaxId
    (param trigger SyntaxId)
    ; The stream an event trigger is on.
    (case? (not kind)
      0
    )
    (case? (or (== kind .state-trigger-for-on) (== kind .state-trigger-for-on-when))
      (call trigger-item trigger 1)
    )
    (case? (or (== kind .state-trigger-on) (== kind .state-trigger-on-when) (== kind .state-trigger-when-stream))
      (call trigger-item trigger 0)
    )
    (case? (== kind .state-trigger-whenever)
      (call trigger-item trigger 0)
    )
    (default
      0
    )
    (where
      (lazy kind (call trigger-kind trigger))
    )
  )
  (fn-expr + trigger-guard SyntaxId
    (param trigger SyntaxId)
    ; The `when` a trigger tests after its pattern, or none.
    (case? (not kind)
      0
    )
    (case? (== kind .state-trigger-for-on-when)
      (call trigger-item trigger 2)
    )
    (case? (== kind .state-trigger-on-when)
      (call trigger-item trigger 1)
    )
    (default
      0
    )
    (where
      (lazy kind (call trigger-kind trigger))
    )
  )
  (fn-do + trigger-pattern SyntaxId
    (param trigger SyntaxId)
    ; The structure match a `for ... on` trigger takes each item with, or the one an `if | p = s`
    ; trigger tests its subject with.
    (let kind (call trigger-kind trigger))
    (if (not kind)
      (return 0)
    )
    (if (or (== kind .state-trigger-for-on) (== kind .state-trigger-for-on-when))
      (return (call trigger-item trigger 0))
    )
    (if (== kind .state-trigger-if-match)
      (match? ([] nodes (call trigger-item trigger 0))
        (case (call .node-state-match-expression row)
          (return (. row pattern))
        )
      )
    )
    (return 0)
  )
  (fn-do + trigger-subject SyntaxId
    (param trigger SyntaxId)
    ; What an `if | p = s` trigger tests.
    (let kind (call trigger-kind trigger))
    (if (and kind (== kind .state-trigger-if-match))
      (match? ([] nodes (call trigger-item trigger 0))
        (case (call .node-state-match-expression row)
          (return (. row subject))
        )
      )
    )
    (return 0)
  )
  (fn-expr + trigger-condition SyntaxId
    (param trigger SyntaxId)
    ; What an `if` trigger tests.
    (case? (and kind (== kind .state-trigger-if))
      (call trigger-item trigger 0)
    )
    (default
      0
    )
    (where
      (lazy kind (call trigger-kind trigger))
    )
  )
  (fn-do + initial-case SyntaxId
    (param items (list SyntaxId))
    ; The case a body enters first: its first case with no trigger, or none.
    (for (in item items)
      (match? ([] nodes item)
        (case (call .node-state-case row)
          (if (== (. row trigger) 0)
            (return item)
          )
        )
      )
    )
    (return 0)
  )
  (fn-expr + enters-initial Bool
    (param items (list SyntaxId))
    (param owner SyntaxId)
    ; Whether the first case of a machine's body, or of a case or a continuation written in it, is
    ; entered and given what its own name is written with, as the reference enters it only where
    ; its owner settles: the machine's root, a continuation, a case a trigger enters or a
    ; continuation names, and the first case of an owner that settles. Where it gives nothing, the
    ; reference's entry is the same either way.
    (case? (== owner 0)
      true
    )
    (case? (or (== initial 0) (== (. (call state-targets initial) count) 0))
      true
    )
    (default
      (call settles items owner)
    )
    (where
      (lazy initial (call initial-case (call state-items (call state-body owner))))
    )
  )
  (fn-expr _ settles Bool
    (param items (list SyntaxId))
    (param node SyntaxId)
    (case? (or (is ([] nodes node) .node-state-continuation) (!= (call state-trigger node) 0))
      true
    )
    (case? (!= (. (call continuations-named items (!! (call state-name node))) length) 0)
      true
    )
    (case? (== (. path length) 0)
      true
    )
    (case? (!= (call initial-case body) node)
      false
    )
    (default
      (or (== (. path length) 1) (call settles items ([] path (- (. path length) 2))))
    )
    (where
      (lazy path (call case-path items node))
      (lazy body (if-expr (== (. path length) 1) items (call state-items (call state-body ([] path (- (. path length) 2))))))
    )
  )
  (fn-do + explicit-cases (list SyntaxId)
    (param items (list SyntaxId))
    ; The cases written in a body and in the bodies of its cases, in the order written.
    (let found (list SyntaxId))
    (for (in item items)
      (if (is ([] nodes item) .node-state-case)
        (+= found item)
        (for (in inner (call explicit-cases (call state-items (call state-body item))))
          (+= found inner)
        )
      )
    )
    (return found)
  )
  (fn-expr + child-cases (list SyntaxId)
    (param items (list SyntaxId))
    ; The cases written in a body itself.
    (in each items (when (is ([] nodes each) .node-state-case)))
  )
  (fn-do + machine-cases (list SyntaxId)
    (param items (list SyntaxId))
    ; Every case a machine has, in the order of its union: each case written, and each case only
    ; a continuation enters or a fallback clears, where it first names it. A case written later
    ; takes the place of one only named before it.
    (let found (list SyntaxId))
    (call collect-cases items found)
    (return found)
  )
  (fn-do _ collect-cases _
    (param items (list SyntaxId))
    (param found (list SyntaxId))
    (for (in item items)
      (let name (call state-name item))
      (if (not name)
        (continue)
      )
      (let known (call case-position found name))
      (let explicit (is ([] nodes item) .node-state-case))
      (if (== known null)
        (+= found item)
        (else-if (and explicit (not (is ([] nodes ([] found known)) .node-state-case)))
          (= ([] found known) item)
        )
      )
      (if (not (is ([] nodes item) .node-state-fallback))
        (call collect-cases (call state-items (call state-body item)) found)
      )
    )
  )
  (fn-do + case-position (? U32)
    (param cases (list SyntaxId))
    (param name Atom)
    ; Where a case of a name is among a machine's cases.
    (for (in position (..< 0 (. cases length)))
      (let named (call state-name ([] cases position)))
      (if (and named (== named name))
        (return (as position U32))
      )
    )
    (return null)
  )
  (fn-do + redefined-case SyntaxId
    (param items (list SyntaxId))
    ; The first case written again with the name of one written before it, or none.
    (let names (list Atom))
    (return (call find-redefined items names))
  )
  (fn-do _ find-redefined SyntaxId
    (param items (list SyntaxId))
    (param names (list Atom))
    (for (in item items)
      (match? ([] nodes item)
        (case (call .node-state-case row)
          (if (!= (call (. names find) (. row name)) null)
            (return item)
          )
          (+= names (. row name))
        )
      )
      (if (call is-transition item)
        (let inner (call find-redefined (call state-items (call state-body item)) names))
        (if (!= inner 0)
          (return inner)
        )
      )
    )
    (return 0)
  )
  (fn-do + find-case SyntaxId
    (param items (list SyntaxId))
    (param name Atom)
    ; The case of a name written in a body or in the bodies of its cases, or none.
    (for (in item items)
      (match? ([] nodes item)
        (case (call .node-state-case row)
          (if (== (. row name) name)
            (return item)
          )
          (let inner (call find-case (call state-items (. row body)) name))
          (if (!= inner 0)
            (return inner)
          )
        )
      )
    )
    (return 0)
  )
  (fn-do + case-path (list SyntaxId)
    (param items (list SyntaxId))
    (param target SyntaxId)
    ; The cases from the root of a body down to a case written in it, the case last, or none where
    ; it is not written there.
    (let found (list SyntaxId))
    (for (in item items)
      (if (is ([] nodes item) .node-state-case)
        (if (== item target)
          (+= found item)
          (return found)
        )
        (let inner (call case-path (call state-items (call state-body item)) target))
        (if (!= (. inner length) 0)
          (+= found item)
          (for (in below inner)
            (+= found below)
          )
          (return found)
        )
      )
    )
    (return found)
  )
  (fn-do + path-to (list SyntaxId)
    (param items (list SyntaxId))
    (param node SyntaxId)
    ; The cases from the root of a body down to a case, the case last; a continuation that enters a
    ; case none writes is alone.
    (let path (call case-path items node))
    (if (== (. path length) 0)
      (+= path node)
    )
    (return path)
  )
  (fn-do + transition-depth Size
    (param items (list SyntaxId))
    (param source SyntaxId)
    (param target SyntaxId)
    ; Where a move from one case of a body to another leaves the paths from the root down to them,
    ; as the reference moves between them: past the cases the two share, but no further than the
    ; last case of either.
    (let leaving (call path-to items source))
    (let entering (call path-to items target))
    (let common 0)
    (while (and (< common (. leaving length)) (< common (. entering length)) (== ([] leaving common) ([] entering common)))
      (+= common 1)
    )
    (if (>= common (. leaving length))
      (= common (- (. leaving length) 1))
    )
    (if (>= common (. entering length))
      (= common (- (. entering length) 1))
    )
    (return common)
  )
  (fn-do + immediate-path (list SyntaxId)
    (param items (list SyntaxId))
    (param active SyntaxId)
    (param transition SyntaxId)
    ; The cases an immediate transition of a case's body enters, as the reference passes it: a case
    ; alone; for a continuation, the cases of the path down to the case it names below the active
    ; case, or from where the two paths part, or the continuation alone where no case is written.
    (let path (list SyntaxId))
    (if (is ([] nodes transition) .node-state-case)
      (+= path transition)
      (return path)
    )
    (let target (call find-case items (!! (call state-name transition))))
    (if (== target 0)
      (+= path transition)
      (return path)
    )
    (let down (call path-to items target))
    (let place (call (. down find) active))
    (let below (and (!= place null) (< (+ place 1) (. down length))))
    (let start (if-expr below (+ (!! place) 1) (call transition-depth items active target)))
    (for (in position (..< start (. down length)))
      (+= path ([] down position))
    )
    (return path)
  )
  (fn-do + continuations-named (list SyntaxId)
    (param items (list SyntaxId))
    (param name Atom)
    ; The continuations written in a body, and in the bodies of its cases and continuations, that
    ; enter the case of a name, in the order written.
    (let found (list SyntaxId))
    (for (in item items)
      (if (not (call is-transition item))
        (continue)
      )
      (if (and (is ([] nodes item) .node-state-continuation) (== (!! (call state-name item)) name))
        (+= found item)
      )
      (for (in inner (call continuations-named (call state-items (call state-body item)) name))
        (+= found inner)
      )
    )
    (return found)
  )
  (fn-expr + immediate-transitions (list SyntaxId)
    (param items (list SyntaxId))
    ; The cases and continuations of a body tested where its owner is entered, in order.
    (in each items (when (call is-immediate-transition each)))
  )
  (fn-do + immediate-fallback SyntaxId
    (param items (list SyntaxId))
    ; The fallback of a body's immediate transitions: the last written right after one of them.
    (let last-immediate false)
    (let found SyntaxId 0)
    (for (in item items)
      (if (call is-immediate-transition item)
        (= last-immediate true)
        (else-if (and (call is-transition item) (!= (call state-trigger item) 0))
          (= last-immediate false)
        )
        (else-if (and (is ([] nodes item) .node-state-fallback) last-immediate)
          (= found item)
        )
      )
    )
    (return found)
  )
  (fn-do + group-heads (list SyntaxId)
    (param items (list SyntaxId))
    ; The first transition of each group of a body's event transitions, in order. A group is the
    ; transitions whose triggers are on one stream.
    (let heads (list SyntaxId))
    (for (in item items)
      (if (not (call is-transition item))
        (continue)
      )
      (let trigger (call state-trigger item))
      (if (or (== trigger 0) (call is-immediate trigger))
        (continue)
      )
      (let known false)
      (for (in head heads)
        (if (call same-key (call state-trigger head) trigger)
          (= known true)
        )
      )
      (if (not known)
        (+= heads item)
      )
    )
    (return heads)
  )
  (fn-do + group-transitions (list SyntaxId)
    (param items (list SyntaxId))
    (param head SyntaxId)
    ; The transitions of the group a transition heads, in order.
    (let found (list SyntaxId))
    (let key (call state-trigger head))
    (for (in item items)
      (if (call is-transition item)
        (let trigger (call state-trigger item))
        (if (and (!= trigger 0) (not (call is-immediate trigger)) (call same-key key trigger))
          (+= found item)
        )
      )
    )
    (return found)
  )
  (fn-do + group-fallback SyntaxId
    (param items (list SyntaxId))
    (param head SyntaxId)
    ; The fallback written after a transition of a group, with no immediate transition between.
    (let key (call state-trigger head))
    (let last SyntaxId 0)
    (let found SyntaxId 0)
    (for (in item items)
      (if (call is-immediate-transition item)
        (= last 0)
        (else-if (and (call is-transition item) (!= (call state-trigger item) 0))
          (= last (call state-trigger item))
        )
        (else-if (and (is ([] nodes item) .node-state-fallback) (!= last 0) (call same-key key last))
          (= found item)
        )
      )
    )
    (return found)
  )
  (fn-do + misplaced-fallback SyntaxId
    (param items (list SyntaxId))
    ; A second fallback written in one body, which the reference rejects as it joins the body, or
    ; one written where no group of event transitions or immediate ones owns it, in a body or the
    ; bodies of its cases; or none.
    (let last-immediate false)
    (let last SyntaxId 0)
    (let seen false)
    (for (in item items)
      (if (call is-immediate-transition item)
        (= last-immediate true)
        (else-if (and (call is-transition item) (!= (call state-trigger item) 0))
          (= last-immediate false)
          (= last (call state-trigger item))
        )
        (else-if (is ([] nodes item) .node-state-fallback)
          (if (or seen (and (not last-immediate) (== last 0)))
            (return item)
          )
          (= seen true)
        )
      )
      (if (call is-transition item)
        (let inner (call misplaced-fallback (call state-items (call state-body item))))
        (if (!= inner 0)
          (return inner)
        )
      )
    )
    (return 0)
  )
  (fn-expr + same-key Bool
    (param left SyntaxId)
    (param right SyntaxId)
    ; Whether two event triggers are on one stream, written alike, whatever their kinds.
    (case? (or (call is-immediate left) (call is-immediate right) (not (call trigger-kind left)) (not (call trigger-kind right)))
      false
    )
    (default
      (call same-stream (call trigger-stream left) (call trigger-stream right))
    )
  )
  (fn-expr + alike-key Bool
    (param other AST)
    (param left SyntaxId)
    (param right SyntaxId)
    ; Whether an event trigger is on a stream one of another tree is on, as `same-key` says.
    (case? (or (call is-immediate left) (call (. other is-immediate) right) (not (call trigger-kind left)) (not (call (. other trigger-kind) right)))
      false
    )
    (default
      (call alike-stream other (call trigger-stream left) (call (. other trigger-stream) right))
    )
  )
  (fn-expr + same-stream Bool
    (param left SyntaxId)
    (param right SyntaxId)
    ; Whether two streams are written alike: names, members, calls, indexes, type arguments and
    ; literals of the same text. Anything else is alike only with itself.
    (or (== left right) (call alike-stream this left right))
  )
  (fn-do + alike-stream Bool
    (param other AST)
    (param left SyntaxId)
    (param right SyntaxId)
    ; Whether a stream is written as one of another tree is, as `same-stream` compares them, but
    ; for what is alike only with itself.
    (if (or (== left 0) (== right 0))
      (return false)
    )
    (match? ([] nodes left)
      (case (call .node-identifier mine)
        (match? ([] (. other nodes) right)
          (case (call .node-identifier theirs)
            (return (and (== (. mine name) (. theirs name)) (== (. mine is-tracked) (. theirs is-tracked))))
          )
        )
      )
      (case (call .node-get-expression mine)
        (match? ([] (. other nodes) right)
          (case (call .node-get-expression theirs)
            (if (or (!= (. mine name) (. theirs name)) (!= (. mine is-optional) (. theirs is-optional)))
              (return false)
            )
            (return (call alike-stream other (. mine object) (. theirs object)))
          )
        )
      )
      (case (call .node-index-expression mine)
        (match? ([] (. other nodes) right)
          (case (call .node-index-expression theirs)
            (if (!= (. mine is-optional) (. theirs is-optional))
              (return false)
            )
            (return
              (scope (and (call alike-stream other (. mine object) (. theirs object)) same-index)
                (lazy same-index (call alike-stream other (. mine index) (. theirs index)))
              )
            )
          )
        )
      )
      (case (call .node-call-expression mine)
        (match? ([] (. other nodes) right)
          (case (call .node-call-expression theirs)
            (if (or (!= (. mine operands count) (. theirs operands count)) has-other-params)
              (return false)
            )
            (lazy has-other-params (!= (. mine param-count) (. theirs param-count)))
            (for (in offset (..< 0 (. mine operands count)))
              (let given ([] children (+ (. mine operands start) offset)))
              (if (not (call alike-stream other given ([] (. other children) (+ (. theirs operands start) offset))))
                (return false)
              )
            )
            (return (call alike-stream other (. mine callable) (. theirs callable)))
          )
        )
      )
      (case (call .node-type-identifier mine)
        (match? ([] (. other nodes) right)
          (case (call .node-type-identifier theirs)
            (return (and (== (. mine name) (. theirs name)) (== (. mine is-declare) (. theirs is-declare))))
          )
        )
      )
      (case (call .node-type-arguments mine)
        (match? ([] (. other nodes) right)
          (case (call .node-type-arguments theirs)
            (if (!= (. mine args count) (. theirs args count))
              (return false)
            )
            (for (in offset (..< 0 (. mine args count)))
              (let given ([] children (+ (. mine args start) offset)))
              (if (not (call alike-stream other given ([] (. other children) (+ (. theirs args start) offset))))
                (return false)
              )
            )
            (return (call alike-stream other (. mine base) (. theirs base)))
          )
        )
      )
      (case (call .node-integer-syntax mine)
        (match? ([] (. other nodes) right)
          (case (call .node-integer-syntax theirs)
            (return (== (. mine value) (. theirs value)))
          )
        )
      )
      (case (call .node-string-syntax mine)
        (match? ([] (. other nodes) right)
          (case (call .node-string-syntax theirs)
            (return (== (. mine text) (. theirs text)))
          )
        )
      )
    )
    (return false)
  )
  (fn-do + payload-source (? StateSource)
    (param items (list SyntaxId))
    (param name Atom)
    ; What gives a case's payload its type: of the cases, continuations and fallbacks that name it
    ; with targets, a `for ... on` one first, then one with any trigger, then a continuation or a
    ; fallback with none, then the case itself, the first of each. A continuation's body has the
    ; owner of the continuation.
    (let found (list StateSource))
    (call find-payload-sources items 0 name found)
    (let best (? StateSource) null)
    (let score 0u32)
    (for (in source found)
      (let given (call source-score (. source node)))
      (if (or (not best) (> given score))
        (= best source)
        (= score given)
      )
    )
    (return best)
  )
  (fn-do + payload-sources (list StateSource)
    (param items (list SyntaxId))
    (param name Atom)
    ; Each case, continuation and fallback that names a case with targets, in order, the source of
    ; its payload (`payload-source`) among them.
    (let found (list StateSource))
    (call find-payload-sources items 0 name found)
    (return found)
  )
  (fn-do _ find-payload-sources _
    (param items (list SyntaxId))
    (param owner SyntaxId)
    (param name Atom)
    (param found (list StateSource))
    (for (in item items)
      (let named (call state-name item))
      (if (not named)
        (continue)
      )
      (if (and (== named name) (!= (. (call state-targets item) count) 0))
        (+= found (call StateSource item owner))
      )
      (match? ([] nodes item)
        (case .node-state-case
          (call find-payload-sources (call state-items (call state-body item)) item name found)
        )
        (case .node-state-continuation
          (call find-payload-sources (call state-items (call state-body item)) owner name found)
        )
      )
    )
  )
  (fn-expr _ source-score U32
    (param node SyntaxId)
    (case? (not kind)
      (if-expr (is ([] nodes node) .node-state-case) 0 1)
    )
    (case? (or (== kind .state-trigger-for-on) (== kind .state-trigger-for-on-when))
      3
    )
    (default
      2
    )
    (where
      (lazy trigger (call state-trigger node))
      (lazy kind (call trigger-kind trigger))
    )
  )
  (fn-do _ find-capture-sources _
    (param items (list SyntaxId))
    (param owner SyntaxId)
    (param cases (list SyntaxId))
    (param found (list (list StateSource)))
    (for (in item items)
      (if (not (call is-transition item))
        (continue)
      )
      (if (!= (call state-trigger item) 0)
        (let position (call case-position cases (!! (call state-name item))))
        (if (!= position null)
          (+= ([] found position) (call StateSource item owner))
        )
      )
      (call find-capture-sources (call state-items (call state-body item)) item cases found)
    )
  )
  (fn-do + pattern-names _
    (param pattern SyntaxId)
    (param names (list Atom))
    ; The names a trigger's pattern captures, as the reference types them: a captured name, the
    ; fields of a tuple, and the payload of a case.
    (match? ([] nodes pattern)
      (case (call .node-structure-match row)
        (call pattern-names (. row pattern) names)
      )
      (case (call .node-type-capture row)
        (match? ([] nodes (. row id))
          (case (call .node-identifier named)
            (if (== (call (. names find) (. named name)) null)
              (+= names (. named name))
            )
          )
        )
      )
      (case (call .node-type-tuple row)
        (for (in field ([] children (. row field-types)))
          (call pattern-names field names)
        )
      )
      (case (call .node-type-case row)
        (call pattern-names (. row value) names)
      )
    )
  )
  (fn-do + target-names _
    (param node SyntaxId)
    (param names (list Atom))
    ; The names among what a case or a continuation gives the case it enters.
    (for (in target ([] children (call state-targets node)))
      (match? ([] nodes target)
        (case (call .node-identifier row)
          (if (== (call (. names find) (. row name)) null)
            (+= names (. row name))
          )
        )
      )
    )
  )
  (fn-do + machine-captures (list (list Atom))
    (param items (list SyntaxId))
    (param cases (list SyntaxId))
    ; The names each case of a machine keeps from what entered it, in the order of `cases`: of
    ; each case or continuation with a trigger that enters it, the names the activation it is
    ; written in sees where it inherits them (`inherits-owner`), and those its trigger's pattern
    ; captures, without the names it gives the case. The activation of a case sees the names of its
    ; targets and those it keeps, as far as they are known when its case is reached.
    (let kept (list (list Atom)))
    (let sources (list (list StateSource)))
    (for (in _ cases)
      (let none (list Atom))
      (+= kept none)
      (let unfound (list StateSource))
      (+= sources unfound)
    )
    (call find-capture-sources items 0 cases sources)
    (for (in position (..< 0 (. cases length)))
      (let names (list Atom))
      (for (in source ([] sources position))
        (let seen (list Atom))
        (if (and (!= (. source owner) 0) (call inherits-owner (. source node)))
          (call target-names (. source owner) seen)
          (let owner-name (!! (call state-name (. source owner))))
          (let owner-position (call case-position cases owner-name))
          (if (!= owner-position null)
            (for (in inner ([] kept owner-position))
              (if (== (call (. seen find) inner) null)
                (+= seen inner)
              )
            )
          )
        )
        (call pattern-names (call trigger-pattern (call state-trigger (. source node))) seen)
        (let given (list Atom))
        (call target-names (. source node) given)
        (for (in inner seen)
          (if (and (== (call (. given find) inner) null) (== (call (. names find) inner) null))
            (+= names inner)
          )
        )
      )
      (= ([] kept position) names)
    )
    (return kept)
  )
  (fn-do + inherits-owner Bool
    (param node SyntaxId)
    ; Whether the activation of a case entered by a transition sees the names the activation the
    ; transition is written in sees, as the reference captures them: a case's does, and a
    ; continuation's where its body writes transitions of its own.
    (if (is ([] nodes node) .node-state-case)
      (return true)
    )
    (for (in item ([] children (call state-body node)))
      (if (call is-transition item)
        (return true)
      )
    )
    (return false)
  )
  (fn-do + nested-machine SyntaxId
    (param item SyntaxId)
    ; The machine a property written in a case's body is, a named machine of its own, or none: its
    ; value, or the one statement of a block written for it, where it names no type.
    (match? ([] nodes item)
      (case (call .node-property-syntax row)
        (match? ([] nodes (. row left))
          (case (call .node-type-capture left)
            (if (== (. left type) 0)
              (return (call declared-machine (. row value)))
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do + nested-machine-name (? Atom)
    (param item SyntaxId)
    ; The name of the property a named machine written in a case's body is.
    (match? ([] nodes item)
      (case (call .node-property-syntax row)
        (match? ([] nodes (. row left))
          (case (call .node-type-capture left)
            (match? ([] nodes (. left id))
              (case (call .node-identifier named)
                (return (. named name))
              )
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-expr + nested-machines (list SyntaxId)
    (param items (list SyntaxId))
    ; The items of a body that are named machines written in it, in order.
    (in each items (when (!= (call nested-machine each) 0)))
  )
)
