━━━━━━━━━━━━━━━━━━━━
+ CompilationEffect is U32

| none = 0
| no-heap = 2
| no-safepoint = 4
| no-probe-safepoint = 8
| no-suspend = 16
| gc-free = 64
| gc-leaf = 128
| gc-polling = 256

━━━━━━━━━━━━━━━━━━━━
+ EffectMask is U64

━━━━━━━━━━━━━━━━━━━━
+ most-effects Size

` How many effects a program can ban, each with a bit of a mask past those of the restrictions.
32

━━━━━━━━━━━━━━━━━━━━
+ ban-bit EffectMask
    - effect U32

` The bit of an effect's ban in a mask of restrictions and bans.
1u64 /lshift/ (16u64 + (effect as U64))

━━━━━━━━━━━━━━━━━━━━
+ ban-bits EffectMask

0x0000FFFFFFFF0000

━━━━━━━━━━━━━━━━━━━━
+ swap-bits EffectMask

` The bits of a mask past the bans, which hold the number of the fakes bound where it is, among
` those a type pass interns (`Instances.swap-sets`), or 0 for none.
U64.max /lshift/ 48u64

━━━━━━━━━━━━━━━━━━━━
+ swap-set-of U32
    - effects EffectMask

(effects /zrshift/ 48u64) as U32

━━━━━━━━━━━━━━━━━━━━
+ with-swap-set EffectMask
    - effects EffectMask
    - set U32

(effects /and/ 0x0000FFFFFFFFFFFF) /or/ ((set as U64) /lshift/ 48u64)

━━━━━━━━━━━━━━━━━━━━
+ restrictions-of U32
    - effects EffectMask

` The restrictions of a mask, without its bans and fakes, which change nothing a function compiles
` to.
(effects /and/ 0x000000000000FFFF) as U32

━━━━━━━━━━━━━━━━━━━━
+ CompilerFeature is U32

| none = 0
| collection-observers = 1



━━━━━━━━━━━━━━━━━━━━
+ SyntaxRange is Tuple

+ start SyntaxId
+ count U32

━━━━━━━━━━━━━━━━━━━━
+ exclusive-end-location MatchLocation
    - location MatchLocation

MatchLocation(location.begin, TokenLocation(location.end.line, location.end.column + 1))

━━━━━━━━━━━━━━━━━━━━
+ do declares-within Bool
    - declaring [SyntaxId]
    - range SyntaxRange

. low = 0
. high = declaring.length
while low < high
    . middle = (low + high) / 2
    if declaring[middle] < range.start
        low = middle + 1
    else
        high = middle
= low < declaring.length && declaring[low] < range.start + range.count
