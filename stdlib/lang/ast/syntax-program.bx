(import ./ast)
(import ./ast-builder)
(import ./ast-nodes)
(import ./brix)
(import ./c-header)
(import ./error)
(import ./module)
(import ./module-resolver)
(import ./probe-selection)
(import ./row-range)
(import ./syntax-uses)
(import /BxEvents/BxEvents.h)
(import /core/arena)
(import /core/atom-pool)
(import /core/list)
(import /lang/constants)
(import /lang/target)
(import /os/env)
(import /os/file)
(import /os/path)
(import /stream/aggregate)
(import /stream/sort)
(blank)
(prop _ leading-import-scan-limit _ (= 65536))
(prop _ kept-module-rounds U64 (= 4))

(type + SyntaxProgram
  (implements (of Usable Void))
  (prop + source-path String)
  (prop + root-paths (list String))
  (prop + modules (list SyntaxModule))
  (prop + edges (list ImportEdge))
  (prop + builtin-paths (list String))
  (prop + resolver ModuleResolver)
  (prop + sources (map String String))
  (prop + keeps-going _ (= false))
  (prop + probes _ (= (call ProbeSelection)))
  (prop + target (? Target))
  (prop + absent-imports (list AbsentImport))
  (prop + failures (map String String))
  (blank)
  (prop _ source-text (? String))
  (prop _ cached (? ModuleView))
  (prop _ module-cache (map String ModuleSource))
  (prop _ builtin-modules (map String ModuleSource))
  (prop _ parse-queue ParseQueue)
  (prop _ active _ (= 0))
  (prop _ c-names (map String Bool))
  (prop _ pending-c-modules (list ModuleSource))
  (prop _ atoms AtomPool)
  (prop _ parse-worker-count _ (= default-worker-count))
  (prop _ root-names (map String Bool))
  (prop _ parsed Bool)
  (prop _ materialized Bool)
  (prop _ atoms-transferred Bool)
  (prop _ atoms-shared Bool)
  (prop _ shared-lock (? Mutex))
  (prop _ released Bool)
  (prop _ chose-c-headers Bool)
  (fn-do + This _
    (param configured-search-paths (list Path))
    (param configured-c-module-paths (map String (list Path)))
    (lazy resolver (call ModuleResolver configured-search-paths configured-c-module-paths))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-expr + view (? ModuleView) :get
    cached
  )
  (fn-expr + shares-atoms Bool :get
    atoms-shared
  )
  (fn-expr + atom-lock (? Mutex) :get
    shared-lock
  )
  (fn-do + use-c-headers _
    (param headers CHeaders)
    ; Reads C headers in `headers`, whatever the target of the roots says.
    (call (. resolver use-c-headers) headers)
    (= chose-c-headers true)
  )
  (fn-do + use-modules _
    (param view ModuleView)
    (throw (call Panic "SyntaxProgram is stale or already parsed") (if (or released parsed)))
    (call (. atoms release))
    (= atoms (. view cache atoms))
    (= atoms-shared true)
    (= shared-lock (. view cache atom-lock))
    (= cached view)
  )
  (fn-do + parse _
    (param source-path String)
    (param module-name String)
    (param parse-worker-count _ (= default-worker-count))
    (param source (? String) (= null))
    (throw (call Error "Missing source path") (if (and (not source-path) (not source))))
    (throw (call Panic "SyntaxProgram is stale or already parsed") (if (or released parsed)))
    (blank)
    (let path (if-expr source-path (call resolved-path source-path "") source-path))
    (= (. this source-path) path)
    (= (. this source-text) source)
    (= (. this parse-worker-count) parse-worker-count)
    (blank)
    (finally
      (if (not parsed)
        (call release)
      )
    )
    (blank)
    (call admit-root path)
    (call (. parse-queue start) atoms parse-worker-count shared-lock)
    (call import-builtin-modules)
    (let name (?? (call (. resolver module-name-of) path) module-name))
    (= ([] root-names name) true)
    (call import-source-module path name source)
    (call parse-pending)
    (call order-modules)
    (= parsed true)
  )
  (fn-do + parse-batch _
    (param roots (list (tuple String String)))
    (param parse-worker-count _ (= default-worker-count))
    ; Parses the modules of a batch: each root, given its path and module name, and what each imports.
    ; The first root stands as the entry module.
    (call parse-roots roots parse-worker-count true)
  )
  (fn-do + parse-modules _
    (param roots (list (tuple String String)))
    (param parse-worker-count _ (= default-worker-count))
    (call parse-roots roots parse-worker-count false)
  )
  (fn-expr + has-module Bool
    (param path String)
    (call some modules (:where (== (. each path) path)))
  )
  (fn-do + materialize-c-headers _
    (throw (call Panic "SyntaxProgram is stale or not parsed") (if (or released (not parsed) atoms-transferred)))
    (if materialized
      (return)
    )
    (blank)
    (let scanned Size)
    (while (!= (. pending-c-modules length) 0)
      (while (< scanned (. modules length))
        (call collect-c-names (. ([] modules scanned) tree))
        (+= scanned 1)
      )
      (= parse-queue (call ParseQueue))
      (call (. parse-queue start) atoms parse-worker-count shared-lock)
      (call queue-c-modules)
      (call parse-pending)
    )
    (call order-modules)
    (= materialized true)
  )
  (fn-expr + path-to-module (? Path)
    (param name String)
    (call (. resolver path-to-module) name)
  )
  (fn-do + take-atoms AtomPool
    (throw (call Panic "SyntaxProgram is stale or not materialized") (if (or released (not materialized) atoms-transferred)))
    (= atoms-transferred true)
    (return atoms)
  )
  (fn-do + release _
    (if (not released)
      (call (. parse-queue close))
      (call (. parse-queue settle))
      (for (in module modules)
        (call (. module release))
      )
      (if (and (not atoms-transferred) (not atoms-shared))
        (call (. atoms release))
      )
      (call (. module-cache clear))
      (call (. builtin-modules clear))
      (= released true)
    )
  )
  (fn-do _ parse-roots _
    (param roots (list (tuple String String)))
    (param parse-worker-count Int)
    (param batch Bool)
    (throw (call Error "Missing source path") (if (not roots)))
    (throw (call Panic "SyntaxProgram is stale or already parsed") (if (or released parsed)))
    (blank)
    (let resolved (list (tuple String String)) (in (tuple (call resolved-path ([] each 0) "") ([] each 1)) roots))
    (= (. this source-path) ([] ([] resolved 0) 0))
    (= (. this parse-worker-count) parse-worker-count)
    (blank)
    (finally
      (if (not parsed)
        (call release)
      )
    )
    (blank)
    (for (in root resolved)
      (call admit-root ([] root 0))
    )
    (call (. parse-queue start) atoms parse-worker-count shared-lock)
    (call import-builtin-modules)
    (for (in root resolved)
      (= ([] root-names ([] root 1)) true)
      (call import-source-module ([] root 0) ([] root 1))
      (if batch
        (+= root-paths ([] root 0))
      )
    )
    (call parse-pending)
    (call order-modules)
    (if (not batch)
      (for (in root resolved)
        (if (call has-module ([] root 0))
          (= (. this source-path) ([] root 0))
          (break)
        )
      )
    )
    (= parsed true)
  )
  (fn-do _ parse-pending _
    (if (== active 0)
      (call (. parse-queue close))
      (return)
    )
    (let failure (? Error))
    (for (in result (call (. parse-queue results)))
      (if (and (. result error) keeps-going (is-not (. result error) Panic))
        (= ([] failures (. result source-path)) (. result error message))
        (else-if (. result error)
          (if (is-not failure Panic)
            (= failure (. result error))
          )
          (call (. parse-queue close))
        )
      )
      (if (. result is-partial)
        (if (not failure)
          (let accepted (catch (call accept-imports (. result source-path) (. result imports))))
          (if (is accepted Error)
            (= failure accepted)
            (call (. parse-queue close))
          )
        )
        (continue)
      )
      (if (. result tree)
        (let tree (call kept-tree result))
        (if failure
          (call (. tree release))
          (else
            (let accepted (catch (call accept-tree tree result)))
            (if (is accepted Error)
              (= failure accepted)
              (call (. parse-queue close))
            )
          )
        )
      )
      (-= active 1)
      (if (== active 0)
        (call (. parse-queue close))
      )
    )
    (let absent (call (. resolver take-absent)))
    (let view cached)
    (if view
      (for (in path absent)
        (call (. view note-absent) path)
      )
    )
    (throw (as failure Panic) (if (is failure Panic)))
    (if failure
      (throw failure)
    )
  )
  (fn-do _ kept-tree AST
    (param result ParseResult)
    (let tree (!! (. result tree)))
    (let view cached)
    (return-if tree (if (or (not view) (. tree is-lent))))
    (return (call (. view keep) result))
  )
  (fn-do _ queue-parse _
    (param path String)
    (param source (? String))
    (+= active 1)
    (let view cached)
    (if view
      (let found (call (. view found) path source))
      (if found
        (call (. parse-queue reuse) found)
        (return)
      )
      (call (. view expect) path source)
    )
    (<- (. parse-queue input-queue) (call ParseJob path source))
  )
  (fn-do _ order-modules _
    (let ordered-modules (list SyntaxModule) (call sort modules (:using compare-module-paths)))
    (= modules ordered-modules)
    (let ordered-edges (list ImportEdge) (call sort edges (:using compare-edge-sources)))
    (= edges ordered-edges)
  )
  (fn-do _ accept-imports _
    (param source-path String)
    (param imports (list ParsedImport))
    (let source ([] module-cache source-path))
    (throw (call Panic "Parsed module was not registered") (if (not source)))
    (let module source)
    (for (in import imports)
      (call admit (?? (. import loc) (call MatchLocation)) (. import path) module source-path)
    )
  )
  (fn-do _ accept-tree _
    (param tree AST)
    (param result ParseResult)
    (let source ([] module-cache (. result source-path)))
    (throw (call Panic "Parsed module was not registered") (if (not source)))
    (let module source)
    (let transferred false)
    (finally
      (if (not transferred)
        (call (. tree release))
      )
    )
    (let imports-markup false)
    (let imports-style false)
    (let imports-probes false)
    (for (in import (. result imports))
      (let written (if-expr (. import loc) (call exclusive-end-location (. import loc)) (call MatchLocation)))
      (let imported (call admit written (. import path) module (. result source-path)))
      (if imported
        (+= edges (call ImportEdge (. module path) (. imported path) (. import is-export)))
        (if (== (. imported name) markup-module-name)
          (= imports-markup true)
        )
        (if (== (. imported name) style-module-name)
          (= imports-style true)
        )
        (if (== (. imported name) probes-module-name)
          (= imports-probes true)
        )
      )
    )
    (if (and (. result uses-streams) (not ([] builtin-modules (. module name))))
      (for (in stream-module stream-module-names)
        (let imported (call import-module (call MatchLocation) stream-module module))
        (+= edges (call ImportEdge (. module path) (. imported path) false true))
      )
    )
    (if (and (. result uses-markup) (!= (. module name) markup-module-name) (not imports-markup))
      (let imported (call import-module (call MatchLocation) markup-module-name module))
      (+= edges (call ImportEdge (. module path) (. imported path) false true))
    )
    (if (and (. result uses-style-sheets) (!= (. module name) style-module-name) (not imports-style))
      (let imported (call import-module (call MatchLocation) style-module-name module))
      (+= edges (call ImportEdge (. module path) (. imported path) false true))
    )
    (if (and (. probes is-enabled) (!= (. module name) probes-module-name) (not imports-probes) wants-probes)
      (let imported (call import-module (call MatchLocation) probes-module-name module))
      (+= edges (call ImportEdge (. module path) (. imported path) false true))
    )
    (lazy wants-probes (or ([] root-names (. module name)) (and (. result uses-probes) (not (call is-core-module (. module name))))))
    (+= modules
      (call SyntaxModule
        (block
          (arg (. module name))
          (arg (call (. resolver relative-path) (. module path) (if-expr root-paths root-paths (list source-path))))
          (arg tree)
        )
      )
    )
    (= transferred true)
  )
  (fn-do _ admit (? ModuleSource) (?! Error)
    (param loc MatchLocation)
    (param name String)
    (param scope-module ModuleSource)
    (param source-path String)
    (return-if (call import-present-module loc name scope-module source-path) (if (not keeps-going)))
    (let imported (catch (call import-present-module loc name scope-module source-path)))
    (return-if imported (if (not (is imported Error))))
    (= ([] failures source-path) (. (as imported Error) message))
    (return null)
  )
  (fn-do _ admit-root _ (?! Error)
    (param path String)
    (let suffix (call module-platform path))
    (if (not target)
      (= target (call target-including suffix))
    )
    (throw (call Error (str (call file-name path) " ends in \"." suffix "\", which isn't a platform")) (if (and suffix (not (call is-platform suffix)))))
    (throw (call Error (str (call file-name path) " isn't part of " (. (!! target) name) " builds")) (if (not (call (. (!! target) includes) suffix))))
    (if (!= (. resolver c-headers target-name) (. (!! target) name))
      (throw (call Error (str "The C headers are " c-target "'s, and " (call file-name path) " is built for " (. (!! target) name))) (if chose-c-headers))
      (lazy c-target (. resolver c-headers target-name))
      (call (. resolver use-c-headers) (call target-c-headers (!! target)))
    )
  )
  (fn-do _ module-platform (? String)
    (param path String)
    ; The platform a module is built for, from the last part of its name. A module of a file family
    ; that names none there is built for every platform, as `box.scroll.bx` is.
    (let suffix (call platform-suffix path))
    (return-if null (if (and suffix (not (call is-platform suffix)) (call (. resolver family-base) path))))
    (return suffix)
  )
  (fn-do _ import-present-module (? ModuleSource) (?! Error)
    (param loc MatchLocation)
    (param name String)
    (param scope-module ModuleSource)
    (param source-path String)
    (match? (call (. resolver find-module) name (. scope-module name) (. scope-module path))
      (case (tuple module-name module-path)
        (let family (call (. resolver family-base) (as module-path String)))
        (throw (call BrixSyntaxError loc family-message (call source-of source-path) source-path) (if (and family (not (call (. resolver in-family) (. scope-module path) family)))))
        (lazy family-message (str "Module \"" name "\" belongs to the file family of " (call file-name family) ", so only that family can import it"))
        (let suffix (call module-platform (as module-path String)))
        (if (not (call (. (!! target) includes) suffix))
          (throw (call BrixSyntaxError loc platform-message (call source-of source-path) source-path) (if (not (call is-platform (!! suffix)))))
          (lazy platform-message (str "Module \"" name "\" ends in \"." (!! suffix) "\", which isn't a platform"))
          (let importer (call module-platform (. scope-module path)))
          (throw (call BrixSyntaxError loc (str "Module \"" name "\" is never part of the same build as " (call file-name (. scope-module path))) (call source-of source-path) source-path) (if (not (call builds-together importer suffix))))
          (+= absent-imports (call AbsentImport (. scope-module name) (as module-path String)))
          (return null)
        )
      )
    )
    (return (call import-module loc name scope-module source-path))
  )
  (fn-do _ import-module ModuleSource (?! Error)
    (param loc MatchLocation)
    (param name String)
    (param scope-module (? ModuleSource) (= null))
    (param source-path (? String) (= null))
    (return?
      (match? (call (. resolver find-c-module) name)
        (case (: c-header-path Path)
          (call import-c-module c-header-path name)
        )
      )
    )
    (blank)
    (return?
      (match? (call (. resolver find-module) name (?. scope-module name) (?. scope-module path))
        (case (tuple module-name module-path)
          (call import-source-module module-path module-name)
        )
      )
    )
    (blank)
    (let refused (call (. resolver refused-folder) name (?. scope-module name) (?. scope-module path)))
    (throw (call BrixSyntaxError loc message (call source-of source-path) source-path) (if (!= refused null)))
    (lazy message (str "Module \"" name "\" is private to " place ", so only modules there can import it"))
    (lazy place (if-expr (!= (. refused length) 0) (str refused "/") "its folder"))
    (throw (call BrixSyntaxError loc (str "Module \"" name "\" not found") (call source-of source-path) source-path))
  )
  (fn-do _ source-of (? String)
    (param source-path (? String))
    (return-if source-text (if (and (!= source-path null) (== source-path (. this source-path)) source-text)))
    (return-if (call read-file-text (call Path source-path)) (if source-path))
    (return null)
  )
  (fn-expr _ file-name String
    (param path String)
    (?? (call last (call (. path split) "/")) path)
  )
  (fn-do _ import-builtin-modules _
    (for (in module-name builtin-module-names)
      (let module (call import-module (call MatchLocation) module-name))
      (= ([] builtin-modules module-name) module)
      (+= builtin-paths (. module path))
    )
    (blank)
    (for (in module-name core-module-names)
      (call import-module (call MatchLocation) module-name)
    )
  )
  (fn-do _ create-module ModuleSource
    (param path Path)
    (param name String)
    (let mod (call ModuleSource (as path String) name ""))
    (= ([] module-cache (as path String)) mod)
    (blank)
    (return mod)
  )
  (fn-do _ collect-c-names _
    (param tree AST)
    (for (in node (. tree nodes))
      (match? node
        (case (call .node-c-identifier reference)
          (= ([] c-names (. reference name text)) true)
        )
      )
    )
  )
  (fn-do _ import-source-module ModuleSource
    (param path Path)
    (param name String)
    (param source (? String) (= null))
    (return?
      (match? ([] module-cache (as path String))
        (case (: module ModuleSource)
          module
        )
      )
    )
    (blank)
    (let module (call create-module path name))
    (call queue-parse (as path String) (?? source ([] sources (as path String))))
    (blank)
    (return module)
  )
  (fn-do _ import-c-module ModuleSource
    (param path Path)
    (param name String)
    (return?
      (match? ([] module-cache (as path String))
        (case (: module ModuleSource)
          module
        )
      )
    )
    (blank)
    (let module (call ModuleSource (as path String) name ""))
    (= ([] module-cache (as path String)) module)
    (+= pending-c-modules module)
    (blank)
    (return module)
  )
  (fn-do _ queue-c-modules Bool
    (if (== (. pending-c-modules length) 0)
      (return false)
    )
    (let queued (list ModuleSource) pending-c-modules)
    (= pending-c-modules (call (of List ModuleSource)))
    (for (in module queued)
      (let source
        (call c-header-source
          (block
            (arg (. resolver c-headers))
            (arg (call (. resolver c-include-paths)))
            (arg (. module path))
            (arg c-names)
          )
        )
      )
      (= (. module source) source)
      (for (in module-name builtin-c-module-names)
        (call import-module (call MatchLocation) module-name module)
      )
      (if (!= (call (. source find) "String") null)
        (call import-module (call MatchLocation) "core/string" module)
      )
      (call queue-parse (. module path) source)
    )
    (return true)
  )
)

(type + SyntaxModule
  (implements (of Usable Void))
  (prop + name String)
  (prop + relative-path String)
  (prop + tree AST)
  (blank)
  (prop _ transferred Bool)
  (prop _ released Bool)
  (fn-do + This _
    (param name String)
    (param relative-path String)
    (param tree AST)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-expr + path String :get
    (. tree source-path)
  )
  (fn-do + take-tree AST
    (throw (call Panic "SyntaxModule is stale or already transferred") (if (or released transferred)))
    (= transferred true)
    (return tree)
  )
  (fn-do + release _
    (if (not released)
      (if (not transferred)
        (call (. tree release))
      )
      (= released true)
    )
  )
)

(type + ImportEdge (is Tuple)
  ; An import of one module by another. One that `follows` is declared after what the importing
  ; module declares, as the stream modules are for a module that uses stream syntax.
  (blank)
  (prop + from String)
  (prop + to String)
  (prop + is-export Bool)
  (prop + follows Bool)
)

(type + ModuleCache
  (implements (of Usable Void))
  (prop + atoms AtomPool)
  (prop + atom-lock _ (= (call Mutex)))
  (blank)
  (prop _ versions (map String (list CachedModule)))
  (prop _ next-id _ (= 0))
  (prop _ lock _ (= (call Mutex)))
  (prop _ released Bool)
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (use lock)
    (if (not released)
      (for (in (tuple _ held) versions)
        (for (in entry held)
          (call (. entry release))
        )
      )
      (call (. versions clear))
      (call (. atoms release))
      (= released true)
    )
  )
  (fn-expr + view ModuleView
    (call ModuleView this)
  )
  (fn-do + claim (? CachedModule)
    (param path String)
    (param stamp ParseStamp)
    (use lock)
    (let held ([] versions path))
    (return-if null (if (not held)))
    (for (in entry held)
      (if (call (. entry stamp matches) stamp)
        (+= (. entry holders) 1)
        (return entry)
      )
    )
    (return null)
  )
  (fn-do + add CachedModule
    (param stamp ParseStamp)
    (param result ParseResult)
    (use lock)
    (+= next-id 1)
    (let entry
      (call CachedModule
        (block
          (arg next-id)
          (arg (. result source-path))
          (arg stamp)
          (arg (!! (. result tree)))
          (arg (. result imports))
          (arg (. result uses-streams))
          (arg (. result uses-markup))
          (arg (. result uses-style-sheets))
          (arg (. result uses-probes))
        )
      )
    )
    (= (. entry holders) 1)
    (let held (?? ([] versions (. entry path)) (call (of List CachedModule))))
    (+= held entry)
    (= ([] versions (. entry path)) held)
    (return entry)
  )
  (fn-do + drop _
    (param entry CachedModule)
    (use lock)
    (-= (. entry holders) 1)
    (return-if (if (!= (. entry holders) 0)))
    (let held ([] versions (. entry path)))
    (if held
      (let kept (list CachedModule))
      (for (in each held)
        (if (!= (. each id) (. entry id))
          (+= kept each)
        )
      )
      (if (== (. kept length) 0)
        (-= ([] versions (. entry path)))
        (else
          (= ([] versions (. entry path)) kept)
        )
      )
    )
    (call (. entry release))
  )
  (fn-do + claim-build (? BuiltModule)
    (param entry CachedModule)
    (param name String)
    (param relative-path String)
    (param hosts (list String))
    (use lock)
    (for (in build (. entry builds))
      (if (and (== (. build module name) name) (== (. build module relative-path) relative-path) serves-hosts)
        (+= (. build holders) 1)
        (return build)
      )
      (lazy serves-hosts (call (. build serves) hosts))
    )
    (return null)
  )
  (fn-do + add-build BuiltModule
    (param entry CachedModule)
    (param module Module)
    (param consulted (list String))
    (param defaulted (list String))
    (use lock)
    (+= next-id 1)
    (let build (call BuiltModule next-id module consulted defaulted))
    (= (. build holders) 1)
    (+= (. entry builds) build)
    (return build)
  )
  (fn-do + drop-build _
    (param entry CachedModule)
    (param build BuiltModule)
    (use lock)
    (-= (. build holders) 1)
    (return-if (if (!= (. build holders) 0)))
    (let kept (list BuiltModule))
    (for (in each (. entry builds))
      (if (!= (. each id) (. build id))
        (+= kept each)
      )
    )
    (= (. entry builds) kept)
    (call (. build module release))
  )
  (fn-do _ retain _
    (param entry CachedModule)
    (use lock)
    (+= (. entry holders) 1)
  )
  (fn-do _ retain-build _
    (param build BuiltModule)
    (use lock)
    (+= (. build holders) 1)
  )
)

(type + ModuleView
  (implements (of Usable Void))
  (prop + cache ModuleCache)
  (blank)
  (prop _ current (map String CachedModule))
  (prop _ builds (map String BuiltModule))
  (prop _ expected (map String ParseStamp))
  (prop _ inputs (map String ParseStamp))
  (prop _ used (map String U64))
  (prop _ round U64)
  (prop _ letting-go (list CachedModule))
  (prop _ letting-go-builds (list HeldBuild))
  (prop _ released Bool)
  (fn-do + This _
    (param cache ModuleCache)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (if (not released)
      (for (in (tuple path build) builds)
        (+= letting-go-builds (call HeldBuild (!! ([] current path)) build))
      )
      (call (. builds clear))
      (for (in (tuple _ entry) current)
        (+= letting-go entry)
      )
      (call (. current clear))
      (call settle)
      (= released true)
    )
  )
  (fn-do + settle _
    (for (in held letting-go-builds)
      (call (. cache drop-build) (. held entry) (. held build))
    )
    (call (. letting-go-builds clear))
    (for (in entry letting-go)
      (call (. cache drop) entry)
    )
    (call (. letting-go clear))
  )
  (fn-do + finish-round _
    (let stale (list String))
    (for (in (tuple path last) used)
      (if (<= (+ last kept-module-rounds) round)
        (+= stale path)
      )
    )
    (for (in path stale)
      (-= ([] used path))
      (call release-build path)
      (let entry ([] current path))
      (if entry
        (-= ([] current path))
        (+= letting-go entry)
      )
    )
    (+= round 1)
  )
  (fn-do + take-inputs (map String ParseStamp)
    (let taken inputs)
    (= inputs (call (of Map String ParseStamp)))
    (return taken)
  )
  (fn-do + note-files _
    (param paths (list String))
    (for (in path paths)
      (let stamp (call parse-stamp path null))
      (if stamp
        (call note-input path stamp)
      )
    )
  )
  (fn-do + pin ModulePins
    (param paths (list String))
    (let pins (call ModulePins cache))
    (for (in path paths)
      (let entry ([] current path))
      (if entry
        (call (. pins hold) entry ([] builds path))
      )
    )
    (return pins)
  )
  (fn-do + found (? ParseResult)
    (param path String)
    (param source (? String))
    (let stamp (call parse-stamp path source))
    (return-if null (if (not stamp)))
    (call note-input path stamp)
    (let entry (call (. cache claim) path stamp))
    (return-if null (if (not entry)))
    (call hold entry)
    (let held entry)
    (return
      (call ParseResult
        (block
          (arg path)
          (arg (call (. held tree lend)))
          (arg null)
          (arg (. held imports))
          (arg (. held uses-streams))
          (arg false)
          (arg (. held uses-markup))
          (arg (. held uses-style-sheets))
          (arg (. held uses-probes))
        )
      )
    )
  )
  (fn-do + expect _
    (param path String)
    (param source (? String))
    (let stamp (call parse-stamp path source))
    (if stamp
      (= ([] expected path) stamp)
      (call note-input path stamp)
      (else
        (-= ([] expected path))
        (call note-absent path)
      )
    )
  )
  (fn-do + keep AST
    (param result ParseResult)
    (let tree (!! (. result tree)))
    (let path (. result source-path))
    (let stamp (?? ([] expected path) (call ParseStamp (. tree source) 0 0 0 false)))
    (-= ([] expected path))
    (let entry (call (. cache add) stamp result))
    (call hold entry)
    (return (call (. tree lend)))
  )
  (fn-do + built (? Module)
    (param path String)
    (param name String)
    (param relative-path String)
    (param hosts (list String))
    (let entry ([] current path))
    (return-if null (if (not entry)))
    (let build (call (. cache claim-build) entry name relative-path hosts))
    (return-if null (if (not build)))
    (call hold-build entry build)
    (return (. build module))
  )
  (fn-do + keep-module Bool
    (param path String)
    (param module Module)
    (param consulted (list String))
    (param hosts (list String))
    (let entry ([] current path))
    (return-if false (if (not entry)))
    (let defaulted (list String))
    (for (in name consulted)
      (if (!= (call (. hosts find) name) null)
        (+= defaulted name)
      )
    )
    (call hold-build entry (call (. cache add-build) entry module consulted defaulted))
    (return true)
  )
  (fn-do + note-absent _
    (param path String)
    (if (not ([] inputs path))
      (= ([] inputs path) (call ParseStamp "" 0 0 0 false))
    )
  )
  (fn-do _ note-input _
    (param path String)
    (param stamp ParseStamp)
    (if (. stamp is-file)
      (= ([] inputs path) stamp)
    )
  )
  (fn-do _ hold _
    (param entry CachedModule)
    (= ([] used (. entry path)) round)
    (let previous ([] current (. entry path)))
    (if (and previous (== (. previous id) (. entry id)))
      (call (. cache drop) entry)
      (return)
    )
    (call release-build (. entry path))
    (= ([] current (. entry path)) entry)
    (if previous
      (+= letting-go previous)
    )
  )
  (fn-do _ hold-build _
    (param entry CachedModule)
    (param build BuiltModule)
    (let previous ([] builds (. entry path)))
    (if (and previous (== (. previous id) (. build id)))
      (call (. cache drop-build) entry build)
      (return)
    )
    (call release-build (. entry path))
    (= ([] builds (. entry path)) build)
  )
  (fn-do _ release-build _
    (param path String)
    (let previous ([] builds path))
    (return-if (if (not previous)))
    (-= ([] builds path))
    (+= letting-go-builds (call HeldBuild (!! ([] current path)) previous))
  )
)

(type + ModulePins
  (prop + cache ModuleCache)
  (blank)
  (prop _ entries (list CachedModule))
  (prop _ builds (list HeldBuild))
  (fn-do + This _
    (param cache _)
  )
  (fn-do + release _
    (for (in held builds)
      (call (. cache drop-build) (. held entry) (. held build))
    )
    (call (. builds clear))
    (for (in entry entries)
      (call (. cache drop) entry)
    )
    (call (. entries clear))
  )
  (fn-do _ hold _
    (param entry CachedModule)
    (param build (? BuiltModule))
    (call (. cache retain) entry)
    (+= entries entry)
    (if build
      (call (. cache retain-build) build)
      (+= builds (call HeldBuild entry build))
    )
  )
)

(type + ParseStamp (is Tuple)
  (prop + text String)
  (prop + size I64)
  (prop + seconds I64)
  (prop + nanoseconds I64)
  (prop + is-file Bool)
  (fn-expr + matches Bool
    (param other ParseStamp)
    (and same-coarse-stat (== nanoseconds (. other nanoseconds)) (== text (. other text)))
    (where
      (lazy same-coarse-stat (and (== is-file (. other is-file)) (== size (. other size)) (== seconds (. other seconds))))
    )
  )
)

(fn-do + file-stamp (? ParseStamp)
  (param path String)
  (return (call parse-stamp path null))
)

(type _ ModuleSource
  (prop + path String)
  (prop + name String)
  (prop + source String)
  (fn-do + This _
    (param path String)
    (param name String)
    (param source String)
  )
)

(type _ ParseQueue
  (implements Closable)
  (prop + input-queue (of SyncBufferedChannel ParseJob))
  (prop + output-queue (of SyncBufferedChannel ParseResult))
  (blank)
  (prop _ worker (? Worker))
  (prop _ scratch-pool (? (of SyncBufferedChannel Arena)))
  (prop _ atom-lock Mutex)
  (fn-do + close _
    (call (. input-queue close))
  )
  (fn-do + start _
    (param atoms AtomPool)
    (param thread-count _ (= default-worker-count))
    (param lock (? Mutex) (= null))
    (throw (call Panic "ParseQueue is already started") (if worker))
    (if lock
      (= atom-lock lock)
    )
    (blank)
    (let started (call Worker thread-count))
    (let scratch (call (of SyncBufferedChannel Arena)))
    (for (in _ (..< 0 thread-count))
      (<- scratch (call Arena))
    )
    (= worker started)
    (= scratch-pool scratch)
    (probe-log compiler.parse.queue.run (items: thread-count))
    (blank)
    (do-new
      (finally
        (call (. started stop))
        (call (. scratch close))
        (for (in each scratch)
          (call (. each release))
        )
        (probe-log compiler.parse.queue.stop (items: thread-count))
        (call (. output-queue close))
      )
      (blank)
      (for (in job input-queue)
        (do-new (worker: started)
          (let arena (!! (<- scratch)))
          (finally
            (<- scratch arena)
          )
          (let result
            (call parse-job job arena output-queue atoms atom-lock
              (block
                (on-error (: failure Error)
                  (call ParseResult (. job source-path) null failure (call (of List ParsedImport)) false false)
                )
              )
            )
          )
          (<- output-queue result)
          (on-failure failed
            (<- output-queue (call ParseResult (. job source-path) null failed (call (of List ParsedImport)) false false))
          )
        )
      )
    )
  )
  (fn-do + reuse _
    (param result ParseResult)
    (<- output-queue result)
  )
  (fn-do + settle _
    (return-if (if (not worker)))
    (for (in result output-queue)
      (if (. result tree)
        (call (. result tree release))
      )
    )
  )
  (fn-do + results (of Iterable ParseResult)
    (throw (call Panic "ParseQueue is not started") (if (not worker)))
    (blank)
    (for (in result output-queue)
      (yield result)
    )
  )
)

(type _ ParseJob (is Tuple)
  (prop + source-path String)
  (prop + source (? String))
)

(type _ ParsedImport (is Tuple)
  (prop + loc (? MatchLocation))
  (prop + path String)
  (prop + is-export Bool)
)

(type _ ParseResult (is Tuple)
  (prop + source-path String)
  (prop + tree (? AST))
  (prop + error (? Error))
  (prop + imports (list ParsedImport))
  (prop + uses-streams Bool)
  (prop + is-partial Bool)
  (prop + uses-markup Bool)
  (prop + uses-style-sheets Bool)
  (prop + uses-probes Bool)
)

(type _ HeldBuild (is Tuple)
  (prop + entry CachedModule)
  (prop + build BuiltModule)
)

(type _ CachedModule
  (prop + id Int)
  (prop + path String)
  (prop + stamp ParseStamp)
  (prop + tree AST)
  (prop + imports (list ParsedImport))
  (prop + uses-streams Bool)
  (prop + uses-markup Bool)
  (prop + uses-style-sheets Bool)
  (prop + uses-probes Bool)
  (prop + builds (list BuiltModule))
  (prop + holders _ (= 0))
  (fn-do + This _
    (param id _)
    (param path _)
    (param stamp _)
    (param tree _)
    (param imports _)
    (param uses-streams _)
    (param uses-markup _)
    (param uses-style-sheets _)
    (param uses-probes _)
  )
  (fn-do + release _
    (for (in build builds)
      (call (. build module release))
    )
    (call (. builds clear))
    (call (. tree release))
  )
)

(type _ BuiltModule
  (prop + id Int)
  (prop + module Module)
  (prop + consulted (list String))
  (prop + defaulted (list String))
  (prop + holders _ (= 0))
  (fn-do + This _
    (param id _)
    (param module _)
    (param consulted _)
    (param defaulted _)
  )
  (fn-expr + serves Bool
    (param hosts (list String))
    (call all consulted (:where (== (!= (call (. hosts find) each) null) (!= (call (. defaulted find) each) null))))
  )
)

(fn-do _ parse-job ParseResult (?! Error)
  (param job ParseJob)
  (param scratch Arena)
  (param output (of SyncBufferedChannel ParseResult))
  (param atoms AtomPool)
  (param atom-lock Mutex)
  (let source String)
  (if (. job source)
    (= source (. job source))
    (else
      (= source (call read-file-text (call Path (. job source-path))))
      (let leading (call brix-leading-imports source))
      (if (!= (. leading length) 0)
        (<- output (call ParseResult (. job source-path) null null leading false true))
      )
    )
  )
  (blank)
  (probe-log compiler.parse.queue.start (items: (. job source-path) (. source length) (call get-current-task-id) (. (as (call C:brixGetActiveThreadMemory) Pointer) address)))
  (let tree (call parse-brix source (. job source-path) scratch))
  (probe-log compiler.parse.queue.end (items: (. job source-path) (. source length) (call get-current-task-id) (. (as (call C:brixGetActiveThreadMemory) Pointer) address) true))
  (let imports (call parsed-imports tree))
  (call (. tree share-program-atoms) atoms atom-lock)
  (let finished (call (. tree finish) atoms))
  (return
    (call ParseResult
      (block
        (arg (. job source-path))
        (arg finished)
        (arg null)
        (arg imports)
        (arg (call uses-stream-syntax finished))
        (arg false)
        (arg (call uses-markup-syntax finished))
        (arg (call uses-style-sheet-syntax finished))
        (arg (call uses-probe-syntax finished))
      )
    )
  )
)

(fn-do _ brix-leading-imports (list ParsedImport)
  (param source String)
  (let imports (list ParsedImport))
  (let bytes (call byte-view source))
  (let scan-end (. bytes length))
  (if (> scan-end leading-import-scan-limit)
    (= scan-end leading-import-scan-limit)
  )
  (let cursor Index)
  (let line-start Index)
  (let line 0u32)
  (while (< cursor scan-end)
    (let byte ([] bytes cursor))
    (if (== byte 10)
      (+= cursor 1)
      (= line-start cursor)
      (+= line 1)
      (else-if (or (== byte 32) (== byte 9) (== byte 13))
        (+= cursor 1)
      )
      (else-if (== byte 59)
        (while (and (< cursor scan-end) (!= ([] bytes cursor) 10))
          (+= cursor 1)
        )
      )
      (else
        (let next (call register-brix-import bytes cursor scan-end line line-start imports))
        (return-if imports (if (== next 0)))
        (= cursor next)
      )
    )
  )
  (return imports)
)

(fn-do _ register-brix-import Index
  (param source (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (param line U32)
  (param line-start Index)
  (param imports (list ParsedImport))
  (return-if 0 (if (!= ([] source start) 40)))
  (let head-end (+ start 1))
  (while (and (< head-end end) (>= ([] source head-end) 97) (<= ([] source head-end) 122))
    (+= head-end 1)
  )
  (let head (call (. source slice-string) (..< (+ start 1) head-end)))
  (if (== head "blank")
    (return-if 0 (if (or (>= head-end end) (!= ([] source head-end) 41))))
    (return (+ head-end 1))
  )
  (let is-export (== head "export"))
  (return-if 0 (if (and (not is-export) (!= head "import"))))
  (return-if 0 (if (or (>= head-end end) (!= ([] source head-end) 32))))
  (blank)
  (let cursor head-end)
  (while (and (< cursor end) (== ([] source cursor) 32))
    (+= cursor 1)
  )
  (let path-start cursor)
  (if (and (< cursor end) (== ([] source cursor) 47))
    (+= cursor 1)
    (= path-start cursor)
    (else-if (and (< cursor end) (== ([] source cursor) 46))
      (if (and (< (+ cursor 2) end) (== ([] source (+ cursor 1)) 46) (== ([] source (+ cursor 2)) 47))
        (+= cursor 3)
        (else-if (and (< (+ cursor 1) end) (== ([] source (+ cursor 1)) 47))
          (+= cursor 2)
        )
        (else
          (return 0)
        )
      )
    )
    (else
      (return 0)
    )
  )
  (blank)
  (let segment-start cursor)
  (while (and (< cursor end) (!= ([] source cursor) 32) (!= ([] source cursor) 41))
    (let byte ([] source cursor))
    (if (== byte 47)
      (return-if 0 (if (== cursor segment-start)))
      (= segment-start (+ cursor 1))
      (else-if (not (call is-leading-import-byte byte))
        (return 0)
      )
    )
    (+= cursor 1)
  )
  (return-if 0 (if (== cursor segment-start)))
  (let path-end cursor)
  (while (and (< cursor end) (== ([] source cursor) 32))
    (+= cursor 1)
  )
  (return-if 0 (if (or (>= cursor end) (!= ([] source cursor) 41))))
  (blank)
  (let first (call TokenLocation line (as (- start line-start) U32)))
  (let last (call TokenLocation line (as (- (+ cursor 1) line-start) U32)))
  (+= imports
    (call ParsedImport
      (block
        (arg (call MatchLocation first last))
        (arg (call (. source slice-string) (..< path-start path-end)))
        (arg is-export)
      )
    )
  )
  (return (+ cursor 1))
)

(fn-expr _ is-leading-import-byte Bool
  (param byte Byte)
  (or is-lowercase is-uppercase is-digit (== byte 95) (== byte 45) (== byte 46))
  (where
    (lazy is-lowercase (and (>= byte 97) (<= byte 122)))
    (lazy is-uppercase (and (>= byte 65) (<= byte 90)))
    (lazy is-digit (and (>= byte 48) (<= byte 57)))
  )
)

(fn-expr _ compare-module-paths _
  (param a SyntaxModule)
  (param b SyntaxModule)
  (case? (!= (. a relative-path) (. b relative-path))
    (call compare-basic (. a relative-path) (. b relative-path))
  )
  (default
    (call compare-basic (. a path) (. b path))
  )
)

(fn-expr _ compare-edge-sources _
  (param a ImportEdge)
  (param b ImportEdge)
  (call compare-basic (. a from) (. b from))
)

(fn-do _ parsed-imports (list ParsedImport)
  (param tree ASTBuilder)
  (let imports (list ParsedImport))
  (match ([] (. tree nodes) (. tree root))
    (case (call .node-top-level-syntax root)
      (for (in syntax-node ([] (. tree nodes) (call (. tree child-ids) (. root statements))))
        (match? syntax-node
          (case (call .node-import-syntax import)
            (let path "")
            (for (in path-offset (..< 0 (. import paths count)))
              (if path-offset
                (+= path "/")
              )
              (+= path (. ([] (. tree atoms) (+ (. import paths start) path-offset)) text))
            )
            (+= imports (call ParsedImport (. import loc) path (. import is-export)))
          )
        )
      )
    )
    (throw (call Panic "AST root has the wrong syntax case"))
  )
  (return imports)
)

(fn-expr _ is-core-module Bool
  (param name String)
  (or (== name "core") (call (. name starts-with) "core/"))
)

(fn-do _ parse-stamp (? ParseStamp)
  (param path String)
  (param source (? String))
  (return-if (call ParseStamp source 0 0 0 false) (if source))
  (let file (call Path path))
  (return-if null (if (not (. file is-file))))
  (let stat (. file stat))
  (return (call ParseStamp "" (. stat size) (. stat mtime s) (. stat mtime ns) true))
)
