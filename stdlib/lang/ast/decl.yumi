+ name Atom?
+ type-syntax SyntaxId
+ default-syntax SyntaxId
+ pattern SyntaxId
+ is-variadic Bool
+ specificity Specificity
+ has-default Bool

━━━━━━━━━━━━━━━━━━━━
+ CapturedName is Tuple

+ name Atom?
+ type-syntax SyntaxId



━━━━━━━━━━━━━━━━━━━━
+ DeclKind is U32

| function-decl = 0
| getter-decl = 1
| setter-decl = 2
| constructor-decl = 3
| default-constructor-decl = 4
| cast-constructor-decl = 5
| main-decl = 6
| tuple-constructor-decl = 7
| closure-decl = 8
| task-decl = 9
| table-size-constructor-decl = 10
| table-arena-constructor-decl = 11
| table-capacity-constructor-decl = 12
| table-filler-constructor-decl = 13
| iterator-decl = 14
| bullet-decl = 15
| pipeline-decl = 16
| index-span-source-constructor-decl = 17
| index-span-range-constructor-decl = 18
| init-decl = 19
| task-main-decl = 20
| termination-panic-decl = 21
| subscriber-decl = 22
| live-decl = 23
| whenever-decl = 24
| branch-arm-decl = 25
| branch-decl = 26
| row-decl = 27
| source-decl = 28
| key-decl = 29
| slot-decl = 30
| binder-decl = 31
| machine-decl = 32
| gate-decl = 33
| region-decl = 34
| selector-decl = 35

━━━━━━━━━━━━━━━━━━━━
+ is-table-constructor-kind Bool
    - kind DeclKind

` A generated constructor of a table type whose arguments follow from the kind rather than
` from declared argument syntax: size, arena, arena with capacity, or size with a filler, and
` an index span's source with or without a range.
|? kind == .table-size-constructor-decl || kind == .table-arena-constructor-decl
    true
|? kind == .table-capacity-constructor-decl || kind == .table-filler-constructor-decl
    true
??
    is-index-span-constructor-kind(kind)

━━━━━━━━━━━━━━━━━━━━
+ is-index-span-constructor-kind Bool
    - kind DeclKind

kind == .index-span-source-constructor-decl || kind == .index-span-range-constructor-decl

━━━━━━━━━━━━━━━━━━━━
+ is-startup-kind Bool
    - kind DeclKind

` A function the program's start runs and no source names: a module's init, which runs the
` module's statements, or the task main, which runs every init in order.
kind == .init-decl || kind == .task-main-decl

━━━━━━━━━━━━━━━━━━━━
+ is-nested-kind Bool
    - kind DeclKind

` A lambda, a task body, the body of a `do without gc` block, or a comprehension, bullet list,
` pipeline body or loop on a stream compiled as a closure, the function that runs a live statement
` again or tests a `whenever` clause again, one that builds an arm of a markup branch region or
` selects its arm again, or one that builds a row of a markup loop region, keys it or reads its
` container again, one that builds what a markup element gives a slot, one that gives the name of an
` element that gives slots content its object, a state machine, or one that tests again the
` condition a style rule written on a markup element is applied under: a function row that lives
` inside another function's subtree and is bound as part of its owner rather than on its own.
|? kind == .closure-decl || kind == .task-decl || kind == .iterator-decl || kind == .gate-decl
    true
|? kind == .region-decl
    true
|? kind == .bullet-decl || kind == .pipeline-decl
    true
|? kind == .branch-arm-decl || kind == .branch-decl || kind == .selector-decl
    true
|? kind == .row-decl || kind == .source-decl || kind == .key-decl
    true
|? kind == .slot-decl || kind == .binder-decl || kind == .machine-decl
    true
??
    kind == .subscriber-decl || kind == .live-decl || kind == .whenever-decl

━━━━━━━━━━━━━━━━━━━━
+ is-closure-like Bool
    - kind DeclKind

` A nested function a stack trace names as a closure: a lambda, or a comprehension, bullet
` list, pipeline body, loop on a stream or live statement compiled as one. A task body and the
` body of a `do without gc` block are nested and are no closures.
is-nested-kind(kind) && kind != .task-decl && kind != .region-decl

