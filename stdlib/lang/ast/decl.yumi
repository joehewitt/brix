./ast-nodes
./operator
./row-range

+ DeclId is U32

━━━━━━━━━━━━━━━━━━━━
+ Decl is Union

| decl-none NoDecl
| decl-function FunctionDecl
| decl-class ClassDecl
| decl-extension ExtensionDecl
| decl-converter ConverterDecl
| decl-fromverter FromverterDecl
| decl-property PropertyDecl
| decl-event EventDecl
| decl-unit UnitDecl
| decl-import ImportDecl
| decl-associated AssociatedDecl
| decl-case CaseDecl
| decl-using UsingDecl
| decl-rule RuleDecl
| decl-style-domains StyleDomainsDecl
| decl-style-rule StyleRuleDecl
| decl-sheet-extension SheetExtensionDecl
| decl-effect EffectDecl

━━━━━━━━━━━━━━━━━━━━
+ DeclNode is Tuple

+ syntax SyntaxId

━━━━━━━━━━━━━━━━━━━━
+ NoDecl is DeclNode

━━━━━━━━━━━━━━━━━━━━
+ FunctionDecl is DeclNode

+ name Atom?
+ names RowRange'Atom
+ owner DeclId
+ access Access
+ kind DeclKind
+ args RowRange'ArgumentShape
+ return-type SyntaxId
+ errors RowRange'SyntaxId
+ effects CompilationEffect
+ is-static Bool
+ body SyntaxId
+ subtree SyntaxRange
+ type-args RowRange'SyntaxId
+ param-constraints RowRange'SyntaxId
+ param-assignments RowRange'SyntaxId
+ variadic-index U32
+ required-count U32
+ is-generated Bool
+ delegates RowRange'SyntaxId = RowRange'SyntaxId()
+ named-by SyntaxId = 0
+ is-content Bool

━━━━━━━━━━━━━━━━━━━━
+ ClassDecl is DeclNode

+ name Atom
+ aliases RowRange'Atom
+ type-args RowRange'SyntaxId
+ base SyntaxId
+ members RowRange'DeclId
+ access Access
+ interfaces RowRange'SyntaxId
+ param-constraints RowRange'SyntaxId
+ param-assignments RowRange'SyntaxId
+ or-bases RowRange'SyntaxId
+ content SyntaxId = 0
+ delegated RowRange'SyntaxId = RowRange'SyntaxId()
+ content-function DeclId = 0

━━━━━━━━━━━━━━━━━━━━
+ ExtensionDecl is DeclNode

` Members added to a type declared elsewhere. One with a name is a facet: a part of the class
` its `receiver` names, or of another facet of it, declared in the class's file family, which
` holds state in the class's objects, reaches the facets its `sees` names and makes the class
` implement the `interfaces` it names.

+ receiver SyntaxId
+ members RowRange'DeclId
+ access Access
+ param-constraints RowRange'SyntaxId
+ param-assignments RowRange'SyntaxId
+ facet Atom? = null
+ sees RowRange'SyntaxId = RowRange'SyntaxId()
+ interfaces RowRange'SyntaxId = RowRange'SyntaxId()

━━━━━━━━━━━━━━━━━━━━
+ SheetExtensionDecl is DeclNode

` An extension of a style sheet, `• extend Name`, whose `members`, the usings and style rules it
` declares, the style sheet its `receiver` names has as its own.

+ receiver SyntaxId
+ members RowRange'DeclId

━━━━━━━━━━━━━━━━━━━━
+ ConverterDecl is DeclNode

+ owner DeclId
+ target-type SyntaxId
+ access Access
+ param-constraints RowRange'SyntaxId
+ param-assignments RowRange'SyntaxId

━━━━━━━━━━━━━━━━━━━━
+ FromverterDecl is DeclNode

+ owner DeclId
+ source-type SyntaxId
+ access Access

━━━━━━━━━━━━━━━━━━━━
+ PropertyDecl is DeclNode

` A property. `element` is the markup element whose name declares it, which makes it readable
` from any module, as the reference's `markupIds` does. `flag` is the case of a state machine
` whose flag it is, a `Bool` that says whether the case is active. `context` is the first
` transition of a group of a state machine's event transitions at its root whose activation it
` holds, a `Pointer` the event runtime's table reaches it by. `line` is the line of a class's
` markup that declares it and gives it its value where the line runs (`content-property`).
` `part` is the state machine of a property of a class, which may refine the machine the base's
` property of that name holds; it holds the machine's part for the object, the function the other
` machines merged with it call, with its environment, as a function value (`-> Void`).
` `projection` is the case of a machine a class's markup writes that holds a value, which it
` projects: what the case holds while it is active, and nothing while it is not.

+ name Atom?
+ owner DeclId
+ type-syntax SyntaxId
+ value SyntaxId
+ decoration Atom?
+ access Access
+ is-lazy Bool
+ delegates RowRange'SyntaxId
+ defaults-root Bool
+ element SyntaxId = 0
+ flag SyntaxId = 0
+ context SyntaxId = 0
+ line SyntaxId = 0
+ part SyntaxId = 0
+ projection SyntaxId = 0

━━━━━━━━━━━━━━━━━━━━
+ EventDecl is DeclNode

+ name Atom
+ owner DeclId
+ access Access
+ type-syntax SyntaxId
+ key-type SyntaxId

