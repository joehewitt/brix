(import ./ast)
(import ./ast-children)
(import ./ast-nodes)
(import ./operator)
(import ./row-range)

(type + SlotHosts
  ; The classes whose markup, or that of a class above them, holds the default slot outlet, as the
  ; parsed modules of a program write them, and the names each module knows such a class by. The
  ; module builder must know, before any type is known, which line of a markup element's body gives
  ; the default slot its content, since a function of its own builds it. A module knows a name for a
  ; class it declares, or where it declares none of that name, for a public class of a module it can
  ; name: a builtin module, one it imports, or one such a module exports in turn.
  (blank)
  (prop + builtin-paths (list String))
  (prop _ paths (list String))
  (prop _ path-ids (map String Index))
  (prop _ classes (list String))
  (prop _ class-modules (list Index))
  (prop _ publics (list Bool))
  (prop _ bases (list String))
  (prop _ holders (list Bool))
  (prop _ hosts (list Bool))
  (prop _ first-named (map String Index))
  (prop _ next-named (list Index))
  (prop _ edge-froms (list String))
  (prop _ edge-tos (list String))
  (prop _ edge-exports (list Bool))
  (prop _ visible (list Bool))
  (fn-do + scan _
    (param tree AST)
    (param path String)
    ; Notes each class a module's tree declares, by its name and each alias, with whether it is
    ; public, the name of the type it derives from and whether the markup it writes holds the default
    ; slot outlet.
    (let module (call module-of path))
    (for (in id (..< 1u32 (+ (. tree root) 1)))
      (match? ([] (. tree nodes) id)
        (case (call .node-class-block row)
          (let base (call head-name tree (. row base)))
          (let public (== (. row access) .public-access))
          (let holds false)
          (for (in member ([] (. tree children) (. row members)))
            (match? ([] (. tree nodes) member)
              (case (call .node-content-block content)
                (for (in node (..< (call (. tree subtree-start) (. content body)) (. content body)))
                  (match? ([] (. tree nodes) node)
                    (case (call .node-slot-outlet outlet)
                      (if (== (. outlet name) 0)
                        (= holds true)
                      )
                    )
                  )
                )
              )
            )
          )
          (call note (. row name text) module public base holds)
          (for (in offset (..< 0 (. row aliases count)))
            (call note (. ([] (. tree atoms) (+ (. row aliases start) offset)) text) module public base holds)
          )
        )
      )
    )
  )
  (fn-do + add-import _
    (param importer String)
    (param imported String)
    (param is-export Bool)
    ; Notes that a module imports another, and whether it exports it.
    (+= edge-froms importer)
    (+= edge-tos imported)
    (+= edge-exports is-export)
  )
  (fn-do + settle _
    ; Finds the modules each module can name, then the classes that hold the default slot outlet, and
    ; each that derives from such a class by a name its module knows for one, until no more are.
    (let total (. paths length))
    (call (. visible clear))
    (for (in _ (..< 0 (* total total)))
      (+= visible false)
    )
    (let builtins (list Index))
    (for (in builtin builtin-paths)
      (let found ([] path-ids builtin))
      (if found
        (+= builtins found)
      )
    )
    (let importers (list Index))
    (let importeds (list Index))
    (for (in edge (..< 0 (. edge-froms length)))
      (+= importers (?? ([] path-ids ([] edge-froms edge)) (. Index max)))
      (+= importeds (?? ([] path-ids ([] edge-tos edge)) (. Index max)))
    )
    (let starts (list Index))
    (let targets (list Index))
    (let exported (list Bool))
    (for (in module (..< 0 total))
      (+= starts (. targets length))
      (for (in builtin builtins)
        (if (!= builtin module)
          (+= targets builtin)
          (+= exported false)
        )
      )
      (for (in edge (..< 0 (. importers length)))
        (if (and (== ([] importers edge) module) (!= ([] importeds edge) (. Index max)))
          (+= targets ([] importeds edge))
          (+= exported ([] edge-exports edge))
        )
      )
    )
    (+= starts (. targets length))
    (for (in module (..< 0 total))
      (= ([] visible (+ (* module total) module)) true)
      (call reach (* module total) module true starts targets exported)
    )
    (call (. hosts clear))
    (for (in holds holders)
      (+= hosts holds)
    )
    (let grew true)
    (while grew
      (= grew false)
      (for (in position (..< 0 (. classes length)))
        (if (and (not ([] hosts position)) (!= (. ([] bases position) length) 0) has-known-host)
          (= ([] hosts position) true)
          (= grew true)
        )
        (lazy has-known-host (call knows-host ([] bases position) ([] class-modules position)))
      )
    )
  )
  (fn-do + names-for (list String)
    (param path String)
    ; The names a module knows for classes that hold the default slot outlet.
    (let names (list String))
    (let found ([] path-ids path))
    (if (not found)
      (return names)
    )
    (for (in position (..< 0 (. classes length)))
      (let name ([] classes position))
      (if (and ([] hosts position) (== (call (. names find) name) null) (call knows-host name found))
        (+= names name)
      )
    )
    (return names)
  )
  (fn-do _ module-of Index
    (param path String)
    (let found ([] path-ids path))
    (if found
      (return found)
    )
    (let module (. paths length))
    (+= paths path)
    (= ([] path-ids path) module)
    (return module)
  )
  (fn-do _ note _
    (param name String)
    (param module Index)
    (param public Bool)
    (param base String)
    (param holds Bool)
    (let position (. classes length))
    (+= classes name)
    (+= class-modules module)
    (+= publics public)
    (+= bases base)
    (+= holders holds)
    (let first ([] first-named name))
    (+= next-named (if-expr first first (. Index max)))
    (= ([] first-named name) position)
  )
  (fn-do _ reach _
    (param row Index)
    (param module Index)
    (param all Bool)
    (param starts (list Index))
    (param targets (list Index))
    (param exported (list Bool))
    ; Marks in a module's row each module another it reaches imports and has not been marked: every
    ; import of the module itself, and only those each module it reaches exports.
    (for (in position (..< ([] starts module) ([] starts (+ module 1))))
      (let target ([] targets position))
      (if (and (or all ([] exported position)) (not ([] visible (+ row target))))
        (= ([] visible (+ row target)) true)
        (call reach row target false starts targets exported)
      )
    )
  )
  (fn-do _ knows-host Bool
    (param name String)
    (param module Index)
    ; Whether the class a module knows by a name holds the default slot outlet: one it declares by
    ; that name decides, and otherwise any public one of a module it can name.
    (let total (. paths length))
    (let found false)
    (let position (?? ([] first-named name) (. Index max)))
    (while (!= position (. Index max))
      (let owner ([] class-modules position))
      (if (== owner module)
        (return ([] hosts position))
      )
      (if (and ([] publics position) ([] visible (+ (* module total) owner)) ([] hosts position))
        (= found true)
      )
      (= position ([] next-named position))
    )
    (return found)
  )
)

(fn-expr + head-name String
  (param tree AST)
  (param id SyntaxId)
  ; The name a type is written with, past its arguments, or the empty text where it is written
  ; some other way or not at all.
  (match ([] (. tree nodes) id)
    (case (call .node-type-identifier row)
      (. row name text)
    )
    (case (call .node-identifier row)
      (. row name text)
    )
    (case (call .node-type-arguments row)
      (call head-name tree (. row base))
    )
    (default
      ""
    )
  )
)
