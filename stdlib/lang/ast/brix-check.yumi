./brix-catalog
./brix-heads
/core/arena
/data/sexp

_ brix-keywords := ["in", "on", "and", "or", "do", "for", "while", "if", "else"]

━━━━━━━━━━━━━━━━━━━━
+ BrixIssueKind is U8

| empty-list
| headless
| raw-form
| unknown-head
| misfit
| firm-misfit
| refused
| late-flag
| bad-name
| wrong-literal
| wrong-form
| surplus
| missing

━━━━━━━━━━━━━━━━━━━━
+ BrixIssue is Tuple

+ index Index
+ rank Index
+ is-own Bool
+ kind BrixIssueKind
+ sense BrixSense? = null
+ slot BrixSlot? = null
+ place BrixPlace? = null
+ spot String
+ owner Index = 0

━━━━━━━━━━━━━━━━━━━━
+ BrixChecker

+ issues [BrixIssue]

_ catalog BrixCatalog
_ tape SexpTape
_ heads Array'U8'ArenaBacking
_ bytes ImmutableArray'Byte

────────────────────
+ This
    - catalog
    - tape
    - heads

.. bytes = tape.bytes

────────────────────
+ do check

. index Index = 0
while index < tape.length
    . broken = fits(index, catalog.top, top-spot)
    if broken
        issues += broken
    index = tape.after(index)

.. top-spot = "a form at the top level of a file"

────────────────────
+ do is-clean Bool
    - node Index
    - sense BrixSense

. mark = issues.length
. broken = follows(node, sense)
. clean = !broken && issues.length == mark
drop(mark)
= clean

────────────────────
+ do message String
    - issue BrixIssue

. node = issue.index
match issue.kind
    |= .empty-list
        = "`()` is empty. Every list starts with a form name."
    |= .headless
        = "Every list starts with a form name. This one starts with ${what(node + 1)}."
    |= .raw-form
        = "(raw …) holds text that is not Brix, and a file that holds it does not compile. Write the row as forms."
    |= .unknown-head
        . head = tape.atom-text(node + 1)
        = "`${head}` is not a form. ${unknown(head, issue.place!)}"
    |= .misfit
        = misfit-message(node, issue.place!, issue.spot)
    |= .firm-misfit
        = "${what(node)} cannot be ${issue.spot}. $hint"
            .. hint = catalog.firm-hint(tape.atom-text(node + 1), issue.place!)!
    |= .refused
        = issue.sense!.meaning
    |= .late-flag
        = late-flag-message(issue)
    |= .bad-name
        = name-advice(node)
    |= .wrong-literal
        . sense = issue.sense!
        = "(${sense.head} …) takes `${issue.slot!.literal!}` here, and ${what(node)} stands in its place. Its shape is ${sense.shape}."
    |= .wrong-form
        . sense = issue.sense!
        = "(${sense.head} …) takes (${issue.slot!.form!.head} …) here, and ${what(node)} stands in its place. Its shape is ${sense.shape}."
    |= .surplus
        = surplus-message(issue)
    |= .missing
        . sense = issue.sense!
        . slot = issue.slot!
        if slot.role == "row" && slot.is-repeating
            . empty = catalog.remark(sense.head, "Empty")
            =? empty if empty != null
        . text = "(${sense.head} …) needs ${slot.label}. Its shape is ${sense.shape}."
        . note = slot.place?.note
        = if note then "$text $note" else text

────────────────────
_ do fits BrixIssue?
    - node Index
    - place BrixPlace
    - spot String

if tape.is-atom(node)
    =? named(node, place) if place.takes-atom(tape, node)
    = BrixIssue(node, rank(node), true, .misfit, null, null, place, spot)
if tape.is-text(node)
    =? null if place.takes-strings || place.is-free
    = BrixIssue(node, rank(node), true, .misfit, null, null, place, spot)
. first = node + 1
if first == tape.close-of(node)
    =? params(node) if place.takes-params
    = BrixIssue(node, rank(node), true, .empty-list)
if !tape.is-atom(first)
    =? params(node) if place.takes-params
    = BrixIssue(node, rank(node), true, .headless)
. kind = heads.data[node] as BrixHead
=? BrixIssue(node, rank(node), true, .raw-form) if kind == .none && tape.atom-is(first, "raw")
. refused = refusal(node, kind, place, spot)
=? refused if refused
. senses = form-senses(node)
if senses == null
    =? params(node) if place.takes-params
    = BrixIssue(node, rank(node), true, .unknown-head, null, null, place)
. failed BrixIssue? = null
. kept [BrixIssue]? = null
. is-able = false
for sense in senses
    if !place.takes(sense)
        continue
    is-able = true
    . mark = issues.length
    . broken = follows(node, sense)
    if !broken
        =? null if issues.length == mark
        . found = taken(mark)
        if kept == null || found.length < kept.length || (found.length == kept.length && found[0].rank > kept[0].rank)
            kept = found
        continue
    drop(mark)
    if !failed || broken.rank > failed.rank
        failed = broken
if !is-able
    =? params(node) if place.takes-params
    = BrixIssue(node, rank(node), true, .misfit, null, null, place, spot)
if kept != null && !(failed && kept.length > 0 && failed.rank > kept[0].rank)
    issues ++= kept
    = null
if catalog.has-firm-hint(kind) && catalog.firm-hint(tape.atom-text(first), place)
    = BrixIssue(node, rank(node), true, .firm-misfit, null, null, place, spot)
= failed

────────────────────
_ do refusal BrixIssue?
    - node Index
    - kind BrixHead
    - place BrixPlace
    - spot String

=? null if kind == .none
. found = catalog.refusals-of(kind)
=? null if found == null
for sense in found
    =? BrixIssue(node, rank(node), true, .refused, sense, null, place, spot) if place.takes(sense) && is-clean(node, sense)
= null

────────────────────
_ do follows BrixIssue?
    - node Index
    - sense BrixSense

. close = tape.close-of(node)
. slots = sense.slots
. cursor Index = 0
. used Size = 0
. noted [Index]? = null
. last BrixSlot? = null
. previous Index = 0
. next = tape.after(node + 1)
while next < close
    . item = next
    next = tape.after(next)
    . spot = cursor
    . best BrixIssue? = null
    . origin Index = 0
    . is-placed = false
    while spot < slots.length
        . slot = slots[spot]
        . is-loose = slot.is-skippable(if spot == cursor then used else 0)
        . mark = issues.length
        . broken = fills(item, slot, sense)
        if broken && is-piped(item, close, slot)
            drop(mark)
            broken = null
        if !broken
            if issues.length > mark && is-loose
                . saved = taken(mark)
                . clean = later(item, sense, spot + 1)
                if clean == null
                    issues ++= saved
                else
                    spot = clean
            is-placed = true
            break
        if !best || broken.rank > best.rank || (broken.rank == best.rank && slot.width >= slots[origin].width)
            best = broken
            origin = spot
        if !is-loose
            break
        spot += 1
    if is-placed
        last = slots[spot]
        previous = item
        if spot != cursor
            used = 0
        cursor = spot
        used += 1
        if !slots[cursor].is-repeating
            cursor += 1
            used = 0
        continue
    . flag = late-flag(item, sense, cursor)
    =? BrixIssue(item, rank(item), true, .late-flag, sense, flag, null, "", node) if flag
    =? best if spot < slots.length
    if heads.data[item] as BrixHead == .blank-head
        continue
    . is-over = !best || (best.is-own && best.index == item)
    =? BrixIssue(item, rank(item), false, .surplus, sense, last, null, "", previous) if !best || (is-over && is-overflow(item, cursor >= slots.length, last))
    =? best if tape.is-atom(item) && bytes[tape.start(item)] == 58
    . resume = resumed(slots, cursor, origin)
    =? best if resume == null
    . is-blamed = best.is-own && best.index == item
    . seen = noted
    if !(is-blamed && seen && seen has resume)
        issues += best
    if is-blamed
        if seen
            seen += resume
        else
            noted = List'Index(resume)
    if resume != cursor
        used = 0
    cursor = resume
    used += 1
while cursor < slots.length
    . slot = slots[cursor]
    =? BrixIssue(node, rank(node, true), false, .missing, sense, slot) if !slot.is-skippable(used)
    cursor += 1
    used = 0
= null

────────────────────
_ do named BrixIssue?
    - node Index
    - place BrixPlace

=? null if place.is-free || place.wanted has "Atom"
. start = tape.start(node)
. end = tape.end(node)
. first = bytes[start]
. issue = BrixIssue(node, rank(node), true, .bad-name)
=? issue if first == 35 && (tape.atom-is(node, "#t") || tape.atom-is(node, "#f"))
=? null if first == 67 && end > start + 1 && bytes[start + 1] == 58
=? issue if tape.atom-is(node, "nil")
. is-split = (place.wanted has "Key" || place.wanted has "Keyed") && is-letter
    .. is-letter = (first >= 97 && first <= 122) || (first >= 65 && first <= 90)
. part = start
. segments = 0
for index in start .. end
    if index == end || (is-split && bytes[index] == 46)
        =? issue if index == part || !is-spelled(part, index)
        part = index + 1
        segments += 1
=? issue if place.wanted has "Keyed" && segments > 2
. is-declared = place.wanted has "Binder" || place.wanted has "Local"
if end - start <= 5 && (is-declared || place.wanted has "Key")
    for word in brix-keywords
        =? issue if tape.atom-is(node, word) && (is-declared || word == "do")
= null

────────────────────
_ do is-spelled Bool
    - start Index
    - end Index

. first = bytes[start]
. is-lower = first >= 97 && first <= 122
. is-upper = first >= 65 && first <= 90
=? true if !is-lower && !is-upper
for index in start + 1 .. < end
    . byte = bytes[index]
    . is-plain = (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)
    =? false if !is-plain && !(is-lower && byte == 45) && !(is-upper && byte >= 65 && byte <= 90)
= true

────────────────────
_ name-advice String
    - node Index

|? text == "nil"
    "`nil` is not a Brix value. Write `null`."
|? text == "#t"
    "`#t` is not a Brix value. Write `true`."
|? text == "#f"
    "`#f` is not a Brix value. Write `false`."
|? brix-keywords has text
    "`$text` is a Yumi keyword, and Brix cannot show it as this name. Choose another name."
|? parts.length > 1 && !(parts has "")
    "`$text` is not a name. To read a member, write `(. ${" ".join(parts)})`."
|? fixed != text && is-word(fixed, is-type)
    "`$text` is not a Brix $noun. $rule: write `$fixed`."
??
    "`$text` is not a Brix $noun. $rule."

.. text = tape.atom-text(node)
.. parts = List(text.split("."))
.. is-type = bytes[tape.start(node)] <= 90
.. fixed = if is-type then typed(text) else kebab(text)
.. rule = if is-type then "A type name is a capitalized word of letters and digits" else "A name is lowercase words joined by hyphens"
.. noun = if is-type then "type name" else "name"

────────────────────
_ do kebab String
    - text String

. word = text
while word.ends-with("?") || word.ends-with("!")
    word = word[0 .. < word.length - 1]
. joined = "-to-".join(word.split("->"))
. out = ""
for char in joined
    if char >= 'A' && char <= 'Z'
        if out != "" && !out.ends-with("-")
            out = "${out}-"
        out = "$out${"$char".lowercased}"
    else if char == '_'
        out = "${out}-"
    else
        out = "$out$char"
= out

────────────────────
_ do typed String
    - text String

. out = ""
. is-raised = false
for char in text
    if char == '_' || char == '-'
        is-raised = true
    else if is-raised
        out = "$out${"$char".uppercased}"
        is-raised = false
    else
        out = "$out$char"
= out

────────────────────
_ do is-word Bool
    - text String
    - is-type Bool

. is-first = true
for char in text
    . is-lower = char >= 'a' && char <= 'z'
    . is-upper = char >= 'A' && char <= 'Z'
    . is-digit = char >= '0' && char <= '9'
    =? false if is-first && !(if is-type then is-upper else is-lower)
    =? false if !is-lower && !is-digit && !(if is-type then is-upper else char == '-')
    is-first = false
= !is-first

────────────────────
_ do late-flag BrixSlot?
    - item Index
    - sense BrixSense
    - cursor Index

=? null if !tape.is-atom(item)
for index in 0 .. < cursor
    . slot = sense.slots[index]
    . literal = slot.literal
    =? slot if literal != null && literal.starts-with(":") && tape.atom-is(item, literal)
    . place = slot.place
    =? slot if place != null && place.leads has "@" && place.takes-atom(tape, item)
= null

────────────────────
_ do late-flag-message String
    - issue BrixIssue

. node = issue.owner
. close = tape.close-of(node)
. flag = tape.atom-text(issue.index)
. line = "(${issue.sense!.head}"
. named = ""
. item = tape.after(node + 1)
for slot in issue.sense!.slots
    if item >= close || slot.is-optional || slot.is-repeating || is-named-slot
        break
    .. is-named-slot = (slot.literal ?? "").starts-with(":")
    line = "$line ${inline-text(item)}"
    named = slot.role
    item = tape.after(item)
. place = if named == "result" then "the result type" else "`$named`"
= "`$flag` goes on the header line, after $place: `$line $flag`."

────────────────────
_ do is-piped Bool
    - item Index
    - close Index
    - slot BrixSlot

. place = slot.place
=? false if place == null || !place.takes-piped
. next = tape.after(item)
=? false if next >= close || heads.data[next] as BrixHead != .pipe-head
. mark = issues.length
. broken = fits(item, catalog.piped, "a value")
. clean = !broken && issues.length == mark
drop(mark)
= clean

────────────────────
_ do resumed Index?
    - slots [BrixSlot]
    - cursor Index
    - origin Index

=? origin if slots[origin].is-repeating
. spot = slots.length
while spot > cursor
    spot -= 1
    =? spot if slots[spot].is-repeating
= null

────────────────────
_ do later Index?
    - item Index
    - sense BrixSense
    - start Index

. spot = start
while spot < sense.slots.length
    . slot = sense.slots[spot]
    . mark = issues.length
    . broken = fills(item, slot, sense)
    . clean = !broken && issues.length == mark
    drop(mark)
    =? spot if clean
    =? null if !slot.is-skippable(0)
    spot += 1
= null

────────────────────
_ do fills BrixIssue?
    - item Index
    - slot BrixSlot
    - sense BrixSense

. literal = slot.literal-bytes
if literal != null
    =? null if tape.is-atom(item) && tape.atom-matches(item, literal)
    = BrixIssue(item, rank(item, false, true), false, .wrong-literal, sense, slot)
. form = slot.form
if form != null
    =? follows(item, form) if is-headed(item, form.head-bytes)
    = BrixIssue(item, rank(item, false, true), false, .wrong-form, sense, slot)
= fits(item, slot.place!, slot.spot)

────────────────────
_ is-overflow Bool
    - item Index
    - is-closed Bool
    - last BrixSlot?

|? head != null && catalog.firm-hint(head, catalog.section) != null
    true
|? last == null
    false
|? form != null
    is-closed && catalog.firm-hint(form.head, catalog.section) != null
??
    !last.is-repeating && place != null && catalog.overflow(place) != null

.. head = head-text(item)
.. form = last.form
.. place = last.place

────────────────────
_ do surplus-message String
    - issue BrixIssue

. node = issue.index
. sense = issue.sense!
. head = head-text(node)
if head != null
    . section = catalog.firm-hint(head, catalog.section)
    =? "${what(node)} is out of place. $section" if section != null
. last = issue.slot
if last != null
    . form = last.form
    if form != null
        . closing = catalog.firm-hint(form.head, catalog.section)
        =? "${what(node)} follows (${form.head} …). $closing" if closing != null
    . place = last.place
    if place != null
        . overflow = catalog.overflow(place)
        =? filled(overflow, sense.head, what(node), what(issue.owner)) if overflow != null
= "(${sense.head} …) takes nothing more, and ${what(node)} follows. Its shape is ${sense.shape}."

────────────────────
_ filled String
    - text String
    - head String
    - item String
    - value String

value.join(placed.split("{value}"))

.. named = head.join(text.split("{head}"))
.. doing = ("-do".join(head.split("-expr"))).join(named.split("{do}"))
.. placed = item.join(doing.split("{item}"))

────────────────────
_ do misfit-message String
    - node Index
    - place BrixPlace
    - spot String

. advice = place.note
. head = head-text(node)
if head != null
    . hint = catalog.hint(head, place)
    if hint != null
        advice = hint
. text = "${what(node)} cannot be $spot, which takes ${place.names}."
= if advice then "$text $advice" else text

────────────────────
_ do params BrixIssue?
    - node Index

. close = tape.close-of(node)
. item = node + 1
while item < close
    . broken = fits(item, catalog.binder, "a parameter of the list")
    =? broken if broken
    item = tape.after(item)
= null

────────────────────
_ unknown String
    - head String
    - place BrixPlace

|? hint != null
    hint
|? parts.length > 1 && parts[0] != "" && parts[parts.length - 1] != ""
    "To call a method, write `(call (. ${" ".join(parts)}) …)`."
??
    "To call a function named $head, write `(call $head …)`."

.. hint = catalog.hint(head, place)
.. parts = List(head.split("."))

────────────────────
_ what String
    - node Index

|? tape.is-atom(node)
    "`${tape.atom-text(node)}`"
|? tape.is-text(node)
    "the text ${clipped(inline-text(node))}"
|? head != null
    "($head …)"
??
    clipped(inline-text(node))

.. head = head-text(node)

────────────────────
_ do inline-text String
    - node Index

. text = ""
. last = ' '
. is-spaced = false
for char in bytes.slice-string(tape.start(node) .. < tape.end(node))
    if char == ' ' || char == '\n' || char == '\t' || char == '\r'
        is-spaced = true
        continue
    if is-spaced && char != ')' && last != '(' && text.length != 0
        text += ' '
    is-spaced = false
    text += char
    last = char
= text

────────────────────
_ head-text String?
    - node Index

|? !tape.is-open(node)
    null
|? first >= tape.close-of(node) || !tape.is-atom(first)
    null
??
    tape.atom-text(first)

.. first = node + 1

────────────────────
_ is-headed Bool
    - node Index
    - head ImmutableArray'Byte

|? !tape.is-open(node)
    false
??
    first < tape.close-of(node) && tape.is-atom(first) && tape.atom-matches(first, head)

.. first = node + 1

────────────────────
_ form-senses [BrixSense]?
    - node Index

|? kind != .none
    catalog.senses-of(kind, size, bytes[start + size - 1] == 63)
|? size > 1 && lead == 58 && bytes[start + size - 1] != 58
    catalog.label-senses
|? size > 2 && lead == 47 && bytes[start + size - 1] == 47
    catalog.infix-senses
??
    catalog.senses(tape.atom-text(first))

.. kind = heads.data[node] as BrixHead
.. first = node + 1
.. start = tape.start(first)
.. size = tape.end(first) - start
.. lead = bytes[start]

────────────────────
_ clipped String
    - text String

if text.length > 28 then "${text[0 .. < 28]}…" else text

────────────────────
_ rank Index
    - node Index
    - is-end = false
    - is-weak = false

place * 2 + (if is-weak then 0 else 1)

.. place = if is-end then tape.end(node) else tape.start(node)

────────────────────
_ do taken [BrixIssue]
    - mark Size

. found [BrixIssue]
for position in mark .. < issues.length
    found += issues[position]
drop(mark)
= found

────────────────────
_ do drop
    - mark Size

if issues.length > mark
    -= issues[mark .. < issues.length]

━━━━━━━━━━━━━━━━━━━━
+ do brix-text-fits Bool ?! SexpError
    - text String
    - sense BrixSense

. scratch = use Arena()
. tape = sexp-tape(text, scratch, false)
. checker = BrixChecker(brix-catalog, tape, brix-form-heads(tape, scratch))
= checker.is-clean(0, sense)
