./ast
./ast-nodes

━━━━━━━━━━━━━━━━━━━━
+ do uses-markup-syntax Bool
    - tree AST

` Whether a module writes markup, a slot, or the forwarding of a slot, which import the markup
` module into it.
for node in tree.nodes
    match? node
        | .node-markup
            = true
        | .node-markup-slot-forward
            = true
        | .node-slot-outlet
            = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do uses-probe-syntax Bool
    - tree AST

` Whether a module writes a probe, which imports the probes module into it where probes compile.
for node in tree.nodes
    match? node
        | .node-probe
            = true
        | .node-probe-statement
            = true
        | .node-probe-counter
            = true
        | .node-probe-group
            = true
        | .node-probe-assign
            = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do uses-style-sheet-syntax Bool
    - tree AST

` Whether a module declares a style sheet with `•`, or extends one, which imports the style
` module into it.
for node in tree.nodes
    match? node
        | .node-class-block(row)
            if row.is-style-sheet
                = true
        | .node-style-sheet-extension
            = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do uses-stream-syntax Bool
    - tree AST

for node in tree.nodes
    match? node
        | .node-pattern-helper-syntax
            = true
        | .node-stream-match
            = true
        | .node-stream-and
            = true
        | .node-stream-or
            = true
        | .node-stream-transform
            = true
        | .node-stream-panic
            = true
        | .node-stream-type
            = true
        | .node-stream-equality
            = true
        | .node-stream-length
            = true
        | .node-stream-unary
            = true
        | .node-stream-call
            = true
        | .node-stream-call-expression-argument
            = true
        | .node-stream-collector-mapping
            = true
        | .node-stream-predicate
            = true
        | .node-stream-capture
            = true
        | .node-stream-char-range
            = true
        | .node-stream-string
            = true
        | .node-stream-any
            = true
= false
