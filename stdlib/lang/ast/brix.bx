  (fn-do _ property-name SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (let first (call (. tape start) index))
    (let last (call (. tape end) index))
    (return-if (call identifier index) (if (not (and (> (- last first) 2) (== ([] bytes first) 67) (== ([] bytes (+ first 1)) 58)))))
    (let loc (call located (call begin-at index) index))
    (let symbol (call c-declaration-name tree loc (call (. tree atom-bytes) bytes (+ first 2) last)))
    (return (call (. tree append) (call ASTIdentifier loc ([] symbol 0) false)))
  )
  (fn-do _ property-value PropertyAssignmentParts (?! BrixSyntaxError)
    (param index Index)
    (let kind (call head index))
    (match? kind
      (case= .block-head
        (return (call PropertyAssignmentParts .property-assignment-immediate (call multi index) false))
      )
      (case= .assign-head
        (return (call PropertyAssignmentParts .property-assignment-immediate (call multi (+ index 2)) false))
      )
      (case= .lazy-assign-head
        (return (call PropertyAssignmentParts .property-assignment-lazy (call multi (+ index 2)) false))
      )
      (case= .closure-head
        (let value (+ index 2))
        (let is-imperative (call atom-is value ":do"))
        (let expr (if-expr is-imperative (call (. tape after) value) value))
        (return (call PropertyAssignmentParts .property-assignment-getter (call multi expr) is-imperative))
      )
    )
    (throw (call unsupported-error index))
  )
  (fn-do _ class-block SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (let close (call (. tape close-of) index))
    (let access-index (+ index 2))
    (let named (call (. tape after) access-index))
    (let access (call access-at access-index))
    (let is-applied (== (call head named) .of-head))
    (let name (call atom-at (if-expr is-applied (+ named 2) named) 0))
    (let type-args
      (scope (if-expr is-applied (call type-arguments (+ named 3) (call (. tape close-of) named)) empty-args)
        (lazy empty-args (call (of ImmutableArray SyntaxId)))
      )
    )
    (let item (call (. tape after) named))
    (let aliases (? (of ImmutableArray Atom)) null)
    (if (and (< item close) (== (call head item) .alias-head))
      (= aliases (call listed-names item))
      (= item (call (. tape after) item))
    )
    (let facet-of SyntaxId 0)
    (if (and (< item close) (== (call head item) .facet-of-head))
      (= facet-of (call reduce-type (+ item 2)))
      (= item (call (. tape after) item))
    )
    (let inherits (? (of ImmutableArray SyntaxId)) null)
    (if (and (< item close) (== (call head item) .is-head))
      (= inherits (call class-bases (+ item 2) (call (. tape close-of) item)))
      (call signed-base access name aliases inherits)
      (= item (call (. tape after) item))
    )
    (let first-member item)
    (let header-count Size 0)
    (let member-count Size 0)
    (while (< item close)
      (if (call is-class-header-item item)
        (+= header-count 1)
        (else
          (+= member-count 1)
        )
      )
      (= item (call (. tape after) item))
    )
    (let variants (call (of scratch-array ArgumentVariant) tree header-count))
    (let members (call (of scratch-array SyntaxId) tree member-count))
    (let header-filled Size 0)
    (let member-filled Size 0)
    (= item first-member)
    (while (< item close)
      (if (call is-class-header-item item)
        (= ([] variants header-filled) (call class-header-item item))
        (+= header-filled 1)
        (else
          (let made (call member item))
          (if made
            (= ([] members member-filled) made)
            (+= member-filled 1)
          )
        )
      )
      (= item (call (. tape after) item))
    )
    (let loc (call located begin index))
    (let header
      (call ClassHeader
        (block
          (arg loc)
          (arg access)
          (arg name)
          (arg type-args)
          (arg aliases)
          (arg inherits)
          (arg (call scratch-items variants header-filled))
          (arg facet-of)
        )
      )
    )
    (return (call placed (call make-class-declaration tree loc header (call scratch-items members member-filled)) loc))
  )
  (fn-do _ signed-base _ (?! BrixSyntaxError)
    (param access Access)
    (param name Atom)
    (param aliases (? (of ImmutableArray Atom)))
    (param bases (of ImmutableArray SyntaxId))
    ; Rejects a unit declared from a signed amount of another, as in `(is -1foo)`, which rows can't
    ; write either (`signed-unit-advice`).
    (for (in base bases)
      (match? ([] (. tree nodes) base)
        (case (call .node-type-numeric numeric)
          (let amount (call signed-amount (. numeric value)))
          (if amount
            (let lead (call access-text access))
            (let suffix (? String) (only-if (. ([] aliases 0) text) (if (and aliases (!= (. aliases length) 0)))))
            (throw (call BrixSyntaxError ([] (. tree nodes loc) (. numeric value)) (call signed-unit-advice lead (. name text) suffix amount)))
          )
        )
      )
    )
