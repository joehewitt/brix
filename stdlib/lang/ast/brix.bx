        (let body (call function-body rows close))
        (return
          (call (. tree append)
            (block
              (arg
                (call ASTSubscriber
                  (block
                    (arg loc)
                    (arg (call (. tree append) (call ASTForBlock loc loop (call (. tree syntax-or-invalid) body) 0)))
                  )
                )
              )
            )
          )
        )
      )
