        (let body (call function-body (call (. tape after) first) (call (. tape close-of) index)))
        (return
          (call (. tree append)
            (block
              (arg
                (call ASTSubscriber
                  (block
                    (arg loc)
                    (arg (call (. tree append) (call ASTForBlock loc loop (call (. tree syntax-or-invalid) body) 0)))
                  )
                )
              )
