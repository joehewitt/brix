    (let type (call reduce-type (+ index 2)))
    (if (== kind .implements-head)
      (return (call (. ArgumentVariant implements-declaration) (call (. tree append) (call ASTImplementsDeclaration loc type))))
    )
    (if (== kind .sees-head)
      (return (call (. ArgumentVariant sees-declaration) (call (. tree append) (call ASTSeesDeclaration loc type))))
    )
    (return (call (. ArgumentVariant using-declaration) (call (. tree append) (call ASTUsingDeclaration loc type))))
  )
  (fn-do _ extension SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (let close (call (. tape close-of) index))
    (let access-index (+ index 2))
    (let access (call access-at access-index))
    (let receiver-index (call (. tape after) access-index))
    (let receiver (call reduce-type receiver-index))
    (let item (call (. tape after) receiver-index))
    (let as-types (? (of ImmutableArray SyntaxId)) null)
    (if (and (< item close) (== (call head item) .as-head))
      (= as-types (call type-arguments (+ item 2) (call (. tape close-of) item)))
      (= item (call (. tape after) item))
    )
    (let constraints (? (of ImmutableArray ArgumentVariant)) null)
    (if (and (< item close) (== (call head item) .where-head))
      (let where-close (call (. tape close-of) item))
      (let found (call (of scratch-array ArgumentVariant) tree (call count-from (+ item 2) where-close)))
      (let filled Size 0)
      (let part (+ item 2))
