  )
  (fn-do _ effect-declaration SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (param begin TokenLocation)
    (let close (call (. tape close-of) index))
    (let access-index (+ index 2))
    (let name-index (call (. tape after) access-index))
    (let claims (call (of scratch-array Atom) tree (call count-from (call (. tape after) name-index) close)))
    (let filled Size 0)
    (let item (call (. tape after) name-index))
    (while (< item close)
      (throw (call unsupported-error item) (if (or (call (. tape is-atom) item) (!= (call head item) .claim-head))))
      (= ([] claims filled) (call atom-at (+ item 2) 2))
      (+= filled 1)
      (= item (call (. tape after) item))
    )
    (return
      (call (. tree append)
        (block
          (arg
            (call ASTEffectDeclaration
              (block
                (arg (call located begin index))
                (arg (call access-at access-index))
                (arg (call atom-at name-index 0))
                (arg (call (. tree store-atoms) (call scratch-items claims filled)))
              )
            )
          )
        )
      )
    )
