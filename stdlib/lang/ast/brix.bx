  (fn-do _ style-sheet SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (let close (call (. tape close-of) index))
    (let named (+ index 2))
    (let item (call (. tape after) named))
    (let derived (? SheetDerivation) null)
    (if (and (< item close) (== (call head item) .is-head))
      (let base (call class-base (+ item 2)))
      (= item (call (. tape after) item))
      (let tags (? (of ImmutableArray Atom)) null)
      (if (and (< item close) (== (call head item) .for-head))
        (= tags (call listed-names item))
        (= item (call (. tape after) item))
      )
      (= derived (call SheetDerivation base tags))
    )
    (let header-count Size 0)
    (let member-count Size 0)
    (let first-member item)
    (while (< item close)
      (if (call is-class-header-item item)
        (+= header-count 1)
        (else
          (+= member-count 1)
        )
      )
      (= item (call (. tape after) item))
    )
    (let variants (call (of scratch-array ArgumentVariant) tree header-count))
    (let members (call (of scratch-array SyntaxId) tree member-count))
    (let header-filled Size 0)
    (let member-filled Size 0)
    (= item first-member)
    (while (< item close)
      (if (call is-class-header-item item)
        (= ([] variants header-filled) (call class-header-item item))
        (+= header-filled 1)
        (else
          (let made (call member item))
          (if made
            (= ([] members member-filled) made)
            (+= member-filled 1)
          )
        )
      )
      (= item (call (. tape after) item))
    )
