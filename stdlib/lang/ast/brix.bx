  (fn-expr _ signed-amount (? String)
    (param id SyntaxId)
    ; A number in a unit written with a sign, as `-1foo` is, or none.
    (match ([] (. tree nodes) id)
      (case (call .node-integer-syntax row)
        (only-if (str (. row value) (. row unit text)) (if (and (. row unit) (call (. row value starts-with) "-"))))
      )
      (case (call .node-float-syntax row)
        (only-if (str (. row value) (. row unit text)) (if (and (. row unit) (call (. row value starts-with) "-"))))
      )
      (default
        null
      )
    )
  )
  (fn-do _ listed-names (of ImmutableArray Atom)
    (param index Index)
    (let close (call (. tape close-of) index))
    (let names (call (of scratch-array Atom) tree (call count-from (+ index 2) close)))
    (let filled Size 0)
    (let item (+ index 2))
    (while (< item close)
      (= ([] names filled) (call atom-at item 0))
      (+= filled 1)
      (= item (call (. tape after) item))
    )
    (return (call scratch-items names filled))
  )
  (fn-do _ class-bases (of ImmutableArray SyntaxId) (?! BrixSyntaxError)
    (param first Index)
    (param close Index)
    (let bases (call (of scratch-array SyntaxId) tree (call count-from first close)))
    (let filled Size 0)
    (let item first)
    (while (< item close)
      (= ([] bases filled) (call class-base item))
      (+= filled 1)
      (= item (call (. tape after) item))
    )
    (return (call scratch-items bases filled))
