        (let container (+ first 2))
        (let clauses (call loop-clauses (call (. tape after) container) (call (. tape close-of) first)))
        (let loop
          (call (. tree append)
            (block
              (arg (call ASTLoop loc 0 (call expression container) clauses (== (call head first) .on-head) false 0))
