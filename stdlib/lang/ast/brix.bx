    (return (call (. tree atom-bytes) bytes (+ (call (. tape start) index) skip) (call (. tape end) index)))
  )
  (fn-expr _ begin-at TokenLocation
    (param index Index)
    (call (. tape token-location) index)
  )
  (fn-do _ placed SyntaxId
    (param id SyntaxId)
    (param loc MatchLocation)
    (= ([] (. tree nodes loc) id) loc)
    (return id)
  )
  (fn-expr _ located MatchLocation
    (param begin TokenLocation)
    (param index Index)
    (call MatchLocation begin (call TokenLocation (. end line) (- (. end column) 1)))
    (where
      (lazy end (call (. tape token-end-location) index))
    )
  )
  (fn-expr _ inline-markup-error BrixSyntaxError
    (param index Index)
    (call BrixSyntaxError
      (block
        (arg (call MatchLocation place place))
        (arg
          (paragraph
            "(<> …) cannot be written inside an expression. Give it as a row: an argument row, as in (call f (block (arg (<> …)))), a named argument, as in (call f (:name (<> …))), or an item, as in (item (<> …)); or name it with (let name (<> …)) first."
          )
        )
      )
    )
    (where
      (lazy place (call (. tape token-location) index))
    )
  )
  (fn-do _ is-place Bool
    (param node SyntaxId)
    (match? ([] (. tree nodes) node)
      (case (call .node-identifier row)
        (return (not (. row is-tracked)))
      )
      (case (call .node-get-expression row)
        (return (and (not (. row is-tracked)) (not (. row is-optional)) (not (. row is-loop)) (call is-place (. row object))))
      )
    )
    (return false)
  )
  (fn-expr _ unsupported-error BrixSyntaxError
    (param index Index)
    (case? (call (. tape is-atom) index)
      (call BrixSyntaxError loc (str "Brix atom “" (call (. tape atom-text) index) "” is not supported here yet"))
    )
    (case? (not (call (. tape is-open) index))
      (call BrixSyntaxError loc "Brix text is not supported here yet")
    )
    (case? (not (call (. tape is-atom) (+ index 1)))
      (call BrixSyntaxError loc "Brix list is not supported here yet")
    )
    (default
      (call BrixSyntaxError loc (str "Brix form “(" (call (. tape atom-text) (+ index 1)) " …)” is not supported yet"))
    )
    (where
      (lazy place (call (. tape token-location) index))
      (lazy loc (call MatchLocation place place))
    )
  )
  (fn-expr _ is-unbound-source Bool
    (param index Index)
    (case? (>= next (call (. tape close-of) index))
      true
    )
    (case? (not (call (. tape is-open) next))
      false
    )
    (default
      (or (== kind .when-head) (== kind .whenever-head) (== kind .while-head) (== kind .until-head) (== kind .keyed-by-head))
    )
    (where
      (lazy next (call (. tape after) (+ index 2)))
      (lazy kind (call head next))
    )
  )
  (fn-expr _ named-source-error BrixSyntaxError
    (param index Index)
    (param form String)
    (param spelling String)
    (param hint String)
    (call BrixSyntaxError
      (block
        (arg (call MatchLocation place place))
        (arg
          (paragraph
            (str form " names no item, so its source is written `" spelling "`, and its rows read the item as `each`." hint)
          )
        )
      )
    )
    (where
      (lazy place (call (. tape token-location) (+ index 2)))
    )
  )
)

(fn-expr _ is-digit Bool
  (param byte Byte)
  (and (>= byte 48) (<= byte 57))
)

(fn-expr _ brix-assign-operator Operator
  (param kind BrixHead)
  (match kind
    (case= .assign-head
      .eq-op
    )
    (case= .add-assign-head
      .add-eq-op
    )
    (case= .subtract-assign-head
      .subtract-eq-op
    )
    (case= .multiply-assign-head
      .multiply-eq-op
    )
    (case= .divide-assign-head
      .divide-eq-op
    )
    (case= .mod-assign-head
      .mod-eq-op
    )
    (case= .pow-assign-head
      .pow-eq-op
    )
    (case= .concat-assign-head
      .concat-eq-op
    )
    (case= .write-all-head
      .write-all-op
    )
    (case= .bind-head
      .bind-op
    )
    (default
      .no-op
    )
  )
)

(fn-expr _ brix-binary-operator Operator
  (param kind BrixHead)
  (match kind
    (case= .add-head
      .add-op
    )
    (case= .subtract-head
      .subtract-op
    )
    (case= .multiply-head
      .multiply-op
    )
    (case= .divide-head
      .divide-op
    )
    (case= .mod-head
      .mod-op
    )
    (case= .pow-head
      .pow-op
    )
    (case= .concat-head
      .concat-op
    )
    (case= .equals-head
      .equals-op
    )
    (case= .not-equals-head
      .not-equals-op
    )
    (case= .less-head
      .less-than-op
    )
    (case= .greater-head
      .greater-than-op
    )
    (case= .less-equals-head
      .less-than-equals-op
    )
    (case= .greater-equals-head
      .greater-than-equals-op
    )
    (case= .and-head
      .and-op
    )
    (case= .or-head
      .or-op
    )
    (case= .coalesce-head
      .coalesce-op
    )
    (case= .as-head
      .as-op
    )
    (case= .is-head
      .is-op
    )
    (case= .is-not-head
      .is-not-op
    )
    (case= .is-exactly-head
      .is-exactly-op
    )
    (case= .is-not-exactly-head
      .is-not-exactly-op
    )
    (case= .is-similar-head
      .is-similar-op
    )
    (case= .is-not-similar-head
      .is-not-similar-op
    )
    (case= .is-in-head
      .is-in-op
    )
    (case= .not-in-head
      .not-in-op
    )
    (case= .has-head
      .has-op
    )
    (case= .has-not-head
      .has-not-op
    )
    (case= .compose-forward-head
      .compose-forward-op
    )
    (case= .compose-backward-head
      .compose-backward-op
    )
    (case= .map-pipe-head
      .map-op
    )
    (case= .filter-pipe-head
      .filter-op
    )
    (case= .forward-pipe-head
      .pipe-forward-op
    )
    (case= .closure-pipe-head
      .pipe-closure-op
    )
    (case= .repeat-pipe-head
      .pipe-repeat-op
    )
    (case= .map-filter-pipe-head
      .map-filter-op
    )
    (case= .write-each-pipe-head
      .pipe-write-each-op
    )
    (case= .write-all-pipe-head
      .pipe-write-all-op
    )
    (case= .backward-pipe-head
      .pipe-backward-op
    )
    (case= .stream-pipe-head
      .grammar-pipe-op
    )
    (default
      .no-op
    )
  )
)

(fn-expr _ brix-prefix-operator Operator
  (param kind BrixHead)
  (match kind
    (case= .not-head
      .not-op
    )
    (case= .subtract-head
      .negative-op
    )
    (case= .subtract-assign-head
      .delete-op
    )
    (case= .write-head
      .read-op
    )
    (default
      .no-op
    )
  )
)
