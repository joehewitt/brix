(import ./ast-builder)
(import ./ast-nodes)
(import ./brix-catalog)
(import ./brix-check)
(import ./brix-heads)
(import ./error)
(import ./grammar-helpers)
(import ./operator)
(import ./row-range)
(import /core/arena)
(import /core/array-builder)
(import /core/parsing)
(import /data/sexp)
(import /stream/aggregate)

(fn-do + parse-brix ASTBuilder (?! BrixSyntaxError)
  (param source String)
  (param source-path _ (= ""))
  (let scratch (use (call Arena)))
  (return (call parse-brix source source-path scratch))
)

(fn-do + parse-brix ASTBuilder (?! BrixSyntaxError)
  (param source String)
  (param source-path String)
  (param scratch Arena)
  (return
    (call brix-tree source source-path scratch
      (block
        (on-error (: error BrixSyntaxError)
          (call (. error attach-source) source source-path)
          (throw error)
        )
      )
    )
  )
)

(fn-do _ brix-tree ASTBuilder (?! BrixSyntaxError)
  (param source String)
  (param source-path String)
  (param scratch Arena)
  (finally
    (call (. scratch reset))
  )
  (let tape (call brix-tape source scratch))
  (let heads (call brix-form-heads tape scratch))
  (let checker (call BrixChecker brix-catalog tape heads))
  (call (. checker check))
  (if (!= (. checker issues length) 0)
    (let issue ([] (. checker issues) 0))
    (let place (call (. tape token-location) (. issue index)))
    (throw (call BrixSyntaxError (call MatchLocation place place) (call (. checker message) issue)))
  )
  (return (call brix-reduced source source-path tape heads scratch))
)

(fn-do _ brix-reduced ASTBuilder (?! BrixSyntaxError)
  (param source String)
  (param source-path String)
  (param tape SexpTape)
  (param heads (of Array U8 ArenaBacking))
  (param scratch Arena)
  (let tree (call ASTBuilder source source-path))
  (= (. tree pattern-collector-context) scratch)
  (finally
    (= (. tree pattern-collector-context) (. tree storage-arena))
  )
  (let succeeded false)
  (finally
    (if (not succeeded)
      (call (. tree release))
    )
  )
  (blank)
  (let reducer (call BrixReducer tape heads tree))
  (let statements (call (. reducer top-level)))
  (let root
    (call (. tree append)
      (block
        (arg (call ASTTopLevel (call (. reducer whole-location)) (call (. tree store-children) (call link-statements tree statements))))
      )
    )
  )
  (call (. tree name-closures))
  (call (. tree finalize-syntax))
  (= succeeded true)
  (= (. tree root) root)
  (return tree)
)

(fn-do _ brix-tape SexpTape (?! BrixSyntaxError)
  (param source String)
  (param scratch Arena)
  (let bytes (call byte-view source))
  (let tape
    (call sexp-tape source scratch false
      (block
        (on-error (: error SexpError)
          (throw (call BrixSyntaxError (call brix-place bytes (. error offset)) (call brix-message (. error message) (. error hint))))
        )
      )
    )
  )
  (let dollar (. tape first-dollar))
  (if dollar
    (throw (call BrixSyntaxError (call brix-place bytes dollar) "Unescaped “\$” in Brix text. Write “\\\$” for a dollar sign, or build the text from its parts with (str …)."))
  )
  (return tape)
)

(fn-expr _ brix-place MatchLocation
  (param bytes (of ImmutableArray Byte))
  (param offset Index)
  (call MatchLocation place place)
  (where
    (lazy place (call sexp-location bytes offset))
  )
)

(type + BrixReport (is Tuple)
  (prop + place TokenLocation)
  (prop + text String)
)

(fn-do + brix-reports (list BrixReport)
  (param source String)
  (let scratch (use (call Arena)))
  (let tape
    (call brix-tape source scratch
      (block
        (on-error (: failure BrixSyntaxError)
          (return (call (of List BrixReport) (call BrixReport (. failure loc begin) (. failure message))))
        )
      )
    )
  )
  (let heads (call brix-form-heads tape scratch))
  (let checker (call BrixChecker brix-catalog tape heads))
  (call (. checker check))
  (if (!= (. checker issues length) 0)
    (return (call List (in (call BrixReport (call (. tape token-location) (. each index)) (call (. checker message) each)) (. checker issues))))
  )
  (let tree
    (call brix-reduced source "" tape heads scratch
      (block
        (on-error (: failure BrixSyntaxError)
          (return (call (of List BrixReport) (call BrixReport (. failure loc begin) (. failure message))))
        )
      )
    )
  )
  (call (. tree release))
  (return (call (of List BrixReport)))
)

(fn-expr _ brix-message String
  (param text String)
  (param hint (? String))
  (if-expr hint (str text ". " hint) text)
)

(type _ BrixReducer
  (prop _ tape SexpTape)
  (prop _ tree ASTBuilder)
  (prop _ bytes (of ImmutableArray Byte))
  (prop _ heads (of Array U8 ArenaBacking))
  (fn-do + This _
    (param tape _)
    (param heads _)
    (param tree _)
    (lazy bytes (. tape bytes))
  )
  (fn-expr + whole-location MatchLocation
    (case? (== (. tape length) 0)
      (call MatchLocation begin begin)
    )
    (default
      (call MatchLocation begin (call (. tape location) (- (. bytes length) 1)))
    )
    (where
      (lazy begin (call TokenLocation 0 0))
    )
  )
  (fn-do + top-level (of ImmutableArray SyntaxId) (?! BrixSyntaxError)
    (let capacity Size 0)
    (let index Index 0)
    (while (< index (. tape length))
      (+= capacity (if-expr (== (call head index) .main-head) (call count-from (+ index 2) (call (. tape close-of) index)) 1))
      (= index (call (. tape after) index))
    )
    (let items (call (of scratch-array SyntaxId) tree capacity))
    (let count Size 0)
    (= index 0)
    (while (< index (. tape length))
      (if (== (call head index) .main-head)
        (let close (call (. tape close-of) index))
        (let row (+ index 2))
        (while (< row close)
          (let made (call statement row))
          (if made
            (= ([] items count) made)
            (+= count 1)
          )
          (= row (call (. tape after) row))
        )
        (else
          (let made (call top-statement index))
          (if made
            (= ([] items count) made)
            (+= count 1)
          )
        )
      )
      (= index (call (. tape after) index))
    )
    (return (call scratch-items items count))
  )
  (fn-do _ top-statement (? SyntaxId) (?! BrixSyntaxError)
    (param index Index)
    (let kind (call head index))
    (match? kind
      (case= .blank-head
        (return null)
      )
      (case= .import-head
        (return (call import index false))
      )
      (case= .export-head
        (return (call import index true))
      )
      (case= .fn-do-head
        (return (call callable index))
      )
      (case= .fn-expr-head
        (return (call callable index))
      )
      (case= .type-head
        (return (call class-block index))
      )
      (case= .type-line-head
        (return (call class-block index))
      )
      (case= .extend-head
        (return (call extension index))
      )
      (case= .extend-line-head
        (return (call extension index))
      )
      (case= .style-head
        (return (call style-sheet index))
      )
      (case= .style-extend-head
        (return (call style-sheet index))
      )
    )
    (return (call member index))
  )
  (fn-do _ import SyntaxId
    (param index Index)
    (param is-export Bool)
    (let begin (call begin-at index))
    (let path (+ index 2))
    (let first (call (. tape start) path))
    (let last (call (. tape end) path))
    (let count Size 0)
    (for (in offset (..< first last))
      (if (== ([] bytes offset) 47)
        (+= count 1)
      )
    )
    (if (!= ([] bytes first) 47)
      (+= count 1)
    )
    (let names (call (of scratch-array Atom) tree count))
    (let filled Size 0)
    (let segment first)
    (if (== ([] bytes first) 47)
      (= segment (+ first 1))
    )
    (for (in offset (..< segment last))
      (if (== ([] bytes offset) 47)
        (= ([] names filled) (call (. tree atom-bytes) bytes segment offset))
        (+= filled 1)
        (= segment (+ offset 1))
      )
    )
    (= ([] names filled) (call (. tree atom-bytes) bytes segment last))
    (+= filled 1)
    (let loc (call located begin index))
    (return (call (. tree append) (call ASTImport loc (call (. tree store-atoms) (call scratch-items names filled)) is-export)))
  )
  (fn-do _ callable SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (return-if (call getter index) (if (call has-role index ":get")))
    (return-if (call setter index) (if (call has-role index ":set")))
    (return (call function index))
  )
  (fn-do _ has-role Bool
    (param index Index)
    (param role String)
    (let close (call (. tape close-of) index))
    (let item (call (. tape after) (call (. tape after) (call (. tape after) (+ index 2)))))
    (while (and (< item close) (call (. tape is-atom) item))
      (return-if true (if (call atom-is item role)))
      (= item (call (. tape after) item))
    )
    (return false)
  )
  (fn-do _ function SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (let close (call (. tape close-of) index))
    (let access-index (+ index 2))
    (let key-index (call (. tape after) access-index))
    (let result-index (call (. tape after) key-index))
    (let access (call access-at access-index))
    (let header (call (. tape after) result-index))
    (let pattern-type (? SyntaxId) null)
    (if (and (< header close) (== (call head header) .over-label-head))
      (= pattern-type (call reduce-type (+ header 2)))
      (= header (call (. tape after) header))
    )
    (let first-header header)
    (let annotation-count Size 0)
    (let error-count Size 0)
    (let variant-count Size 0)
    (let is-imperative (== (call head index) .fn-do-head))
    (let is-static false)
    (while (and (< header close) (call is-header-item header))
      (if (call (. tape is-atom) header)
        (if (== ([] bytes (call (. tape start) header)) 64)
          (+= annotation-count 1)
          (else-if (call atom-is header ":static")
            (= is-static true)
          )
        )
        (else-if (== (call head header) .raises-head)
          (+= error-count 1)
        )
        (else-if (== (call head header) .door-head)
          (+= annotation-count 1)
        )
        (else-if (not (call is-scope header))
          (+= variant-count 1)
        )
      )
      (= header (call (. tape after) header))
    )
    (let key (call function-key key-index result-index pattern-type))
    (let annotations (call (of scratch-array Atom) tree annotation-count))
    (let errors (call (of scratch-array SyntaxId) tree error-count))
    (let variants (call (of scratch-array ArgumentVariant) tree variant-count))
    (let annotation-filled Size 0)
    (let error-filled Size 0)
    (let variant-filled Size 0)
    (let item first-header)
    (while (< item header)
      (if (call (. tape is-atom) item)
        (if (== ([] bytes (call (. tape start) item)) 64)
          (= ([] annotations annotation-filled) (call annotation-at item))
          (+= annotation-filled 1)
        )
        (else-if (== (call head item) .raises-head)
          (= ([] errors error-filled) (call reduce-type (+ item 2)))
          (+= error-filled 1)
        )
        (else-if (== (call head item) .door-head)
          (= ([] annotations annotation-filled) (call door-annotation tree (call atom-at (+ item 2) 0)))
          (+= annotation-filled 1)
        )
        (else-if (not (call is-scope item))
          (= ([] variants variant-filled) (call variant item))
          (+= variant-filled 1)
        )
      )
      (= item (call (. tape after) item))
    )
    (let loc (call located begin index))
    (let sections (call scope-of first-header header))
    (let body (call sectioned-body tree loc sections is-imperative (call function-body header close)))
    (let stream-item (call (. tree atom) "StreamItem"))
    (return
      (call placed
        (block
          (arg
            (call make-function
              (block
                (arg tree)
                (arg loc)
                (arg access)
                (arg is-imperative)
                (arg is-static)
                (arg key)
                (arg (call scratch-items errors error-filled))
                (arg
                  (call section-annotations
                    (block
                      (arg tree)
                      (arg loc)
                      (arg (call scratch-items annotations annotation-filled))
                      (arg sections)
                      (arg false)
                    )
                  )
                )
                (arg stream-item)
                (arg (call scratch-items variants variant-filled))
                (arg body)
              )
            )
          )
          (arg loc)
        )
      )
    )
  )
  (fn-do _ function-body (? SyntaxId) (?! BrixSyntaxError)
    (param first Index)
    (param close Index)
    (return-if null (if (>= first close)))
    (let size Size 0)
    (let index first)
    (while (< index close)
      (+= size (if-expr (call is-section index) (call count-from (+ index 2) (call (. tape close-of) index)) 1))
      (= index (call (. tape after) index))
    )
    (let items (call (of scratch-array SyntaxId) tree size))
    (let count Size 0)
    (= index first)
    (while (< index close)
      (let is-split (call is-section index))
      (let row (if-expr is-split (+ index 2) index))
      (let end (if-expr is-split (call (. tape close-of) index) (call (. tape after) index)))
      (while (< row end)
        (let made (call statement row))
        (if made
          (= ([] items count) made)
          (+= count 1)
        )
        (= row (call (. tape after) row))
      )
      (= index (call (. tape after) index))
    )
    (return (call block-with-statements tree (call scratch-items items count)))
  )
  (fn-expr _ is-section Bool
    (param index Index)
    (or (== (call head index) .before-head) (== (call head index) .where-head))
  )
  (fn-expr _ is-header-item Bool
    (param index Index)
    (case? (call (. tape is-atom) index)
      (or (== lead 64) (and (== lead 58) (> (- (call (. tape end) index) (call (. tape start) index)) 1)))
    )
    (default
      (or (== kind .raises-head) (== kind .param-head) (== kind .constraint-head) (== kind .iterates-head) (== kind .door-head) (call is-scope index))
    )
    (where
      (lazy lead ([] bytes (call (. tape start) index)))
      (lazy kind (call head index))
    )
  )
  (fn-do _ variant ArgumentVariant (?! BrixSyntaxError)
    (param index Index)
    (let kind (call head index))
    (return-if (call (. ArgumentVariant argument-decl) (call parameter index)) (if (== kind .param-head)))
    (return-if (call iterator-header index) (if (== kind .iterates-head)))
    (return (call constraint index))
  )
  (fn-do _ iterator-header ArgumentVariant (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (let word (+ index 2))
    (let container (call expression (call (. tape after) word)))
    (let loc (call located begin index))
    (return
      (call (. ArgumentVariant iterator-header)
        (block
          (arg loc)
          (arg (call (. tree append) (call ASTLoop loc 0 container 0 (call atom-is word "on") false 0)))
        )
      )
    )
  )
  (fn-do _ constraint ArgumentVariant (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (let op (+ index 2))
    (let left (call (. tape after) op))
    (let right (call (. tape after) left))
    (if (or (call atom-is op "=") (call atom-is op "=~"))
      (let assigned-left (call reduce-type left))
      (let assigned-right (call expression right))
      (return
        (call (. ArgumentVariant param-assignment)
          (block
            (arg
              (call (. tree append)
                (block
                  (arg
                    (call ASTParamAssignment
                      (block
                        (arg (call located begin index))
                        (arg assigned-left)
                        (arg assigned-right)
                        (arg (call atom-is op "=~"))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (let match-op
      (block
        (case? (call atom-is op "is!")
          (. TypeMatchOperator match-exactly)
        )
        (case? (call atom-is op "is~")
          (. TypeMatchOperator match-similar)
        )
        (default
          (. TypeMatchOperator match-convertible)
        )
      )
    )
    (let constrained (call reduce-type left))
    (let bound (call reduce-type right))
    (return
      (call (. ArgumentVariant param-constraint)
        (block
          (arg (call (. tree append) (call ASTParamConstraint (call located begin index) match-op constrained bound)))
        )
      )
    )
  )
  (fn-do _ parameter SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (let close (call (. tape close-of) index))
    (let item (+ index 2))
    (let is-variadic false)
    (if (and (call (. tape is-atom) item) (call atom-is item "..."))
      (= is-variadic true)
      (= item (call (. tape after) item))
    )
    (let name item)
    (let type (call (. tape after) name))
    (let fallback (call (. tape after) type))
    (let type-id SyntaxId 0)
    (if (call atom-is name "_")
      (= type-id (call reduce-type type))
      (else
        (let id (call identifier name))
        (let captured SyntaxId 0)
        (if (and (< type close) (not (call atom-is type "_")))
          (= captured (call reduce-type type))
        )
        (= type-id (call (. tree append) (call ASTTypeCapture (call located begin name) id captured)))
      )
    )
    (let default SyntaxId 0)
    (if (< fallback close)
      (= default (call expression (+ fallback 2)))
    )
    (return (call (. tree append) (call ASTArgumentDecl (call located begin index) type-id default is-variadic)))
  )
  (fn-do _ function-key FunctionKey (?! BrixSyntaxError)
    (param key Index)
    (param result Index)
    (param pattern-type (? SyntaxId))
    (let returns (? SyntaxId) null)
    (if (not (call atom-is result "_"))
      (= returns (call reduce-type result))
    )
    (let kind (call head key))
    (match? kind
      (case= .infix-head
        (let left (+ key 2))
        (let op (call (. tape after) left))
        (let names (call function-names left (call infix-name op)))
        (return
          (call FunctionKey
            (block
              (arg names)
              (arg (call function-type-args left))
              (arg returns)
              (arg null)
              (arg (call sequence-singleton tree (call parameter (call (. tape after) op))))
            )
          )
        )
      )
      (case= .index-get-head
        (let left (+ key 2))
        (return
          (call FunctionKey
            (block
              (arg (call function-names left "[]"))
              (arg (call function-type-args left))
              (arg returns)
              (arg null)
              (arg (call sequence-singleton tree (call parameter (call (. tape after) left))))
            )
          )
        )
      )
      (case= .index-set-head
        (let left (+ key 2))
        (let index-param (call parameter (call (. tape after) left)))
        (let value-param (call parameter (call (. tape after) (call (. tape after) left))))
        (return
          (call FunctionKey
            (block
              (arg (call function-names left "[]="))
              (arg (call function-type-args left))
              (arg null)
              (arg null)
              (arg (call sequence-pair tree index-param value-param))
            )
          )
        )
      )
      (case= .index-delete-head
        (let left (+ key 2))
        (return
          (call FunctionKey
            (block
              (arg (call function-names left "-=[]"))
              (arg (call function-type-args left))
              (arg null)
              (arg null)
              (arg (call sequence-singleton tree (call parameter (call (. tape after) left))))
            )
          )
        )
      )
      (case= .prefix-head
        (let op (+ key 2))
        (let left (call (. tape after) op))
        (return
          (call FunctionKey
            (block
              (arg (call function-names left (call prefix-name op)))
              (arg (call function-type-args left))
              (arg returns)
              (arg null)
              (arg (call (of ImmutableArray SyntaxId)))
            )
          )
        )
      )
    )
    (let names (call function-names key null))
    (let chosen (if-expr (== (. names length) 0) (call sequence-singleton tree (call (. tree atom) "()")) names))
    (return (call FunctionKey chosen (call function-type-args key) returns pattern-type))
  )
  (fn-do _ function-names (of ImmutableArray Atom) (?! BrixSyntaxError)
    (param key Index)
    (param suffix (? String))
    (let named (if-expr (== (call head key) .of-head) (+ key 2) key))
    (let first (call (. tape start) named))
    (let last (call (. tape end) named))
    (let extra (if-expr suffix 1 0))
    (if (call atom-is named "this")
      (let names (call (of scratch-array Atom) tree extra))
      (if suffix
        (= ([] names 0) (call (. tree atom) suffix))
      )
      (return (call scratch-items names extra))
    )
    (if (call atom-is named "This")
      (let names (call (of scratch-array Atom) tree (+ 1 extra)))
      (= ([] names 0) (call (. tree atom) "This"))
      (if suffix
        (= ([] names 1) (call (. tree atom) suffix))
      )
      (return (call scratch-items names (+ 1 extra)))
    )
    (if (and (> (- last first) 2) (== ([] bytes first) 67) (== ([] bytes (+ first 1)) 58))
      (let symbol
        (call c-declaration-name
          (block
            (arg tree)
            (arg (call located (call begin-at named) named))
            (arg (call (. tree atom-bytes) bytes (+ first 2) last))
          )
        )
      )
      (return-if symbol (if (not suffix)))
      (return (call sequence-appending tree symbol (call (. tree atom) suffix)))
    )
    (let count Size (+ 1 extra))
    (for (in offset (..< first last))
      (if (== ([] bytes offset) 46)
        (+= count 1)
      )
    )
    (let names (call (of scratch-array Atom) tree count))
    (let filled Size 0)
    (let segment first)
    (for (in offset (..< first last))
      (if (== ([] bytes offset) 46)
        (= ([] names filled) (call (. tree atom-bytes) bytes segment offset))
        (+= filled 1)
        (= segment (+ offset 1))
      )
    )
    (= ([] names filled) (call (. tree atom-bytes) bytes segment last))
    (+= filled 1)
    (if suffix
      (= ([] names filled) (call (. tree atom) suffix))
      (+= filled 1)
    )
    (return (call scratch-items names filled))
  )
  (fn-do _ function-type-args (of ImmutableArray SyntaxId) (?! BrixSyntaxError)
    (param key Index)
    (return-if (call (of ImmutableArray SyntaxId)) (if (!= (call head key) .of-head)))
    (return (call type-arguments (call (. tape after) (+ key 2)) (call (. tape close-of) key)))
  )
  (fn-expr _ infix-name String
    (param op Index)
    (case? (== kind .write-head)
      "<-write"
    )
    (case? (!= (call brix-binary-operator kind) .no-op)
      (as (call brix-binary-operator kind) String)
    )
    (default
      (as (call brix-assign-operator kind) String)
    )
    (where
      (lazy kind (call brix-head bytes (call (. tape start) op) (call (. tape end) op)))
    )
  )
  (fn-expr _ prefix-name String
    (param op Index)
    (as (call brix-prefix-operator (call brix-head bytes (call (. tape start) op) (call (. tape end) op))) String)
  )
  (fn-do _ property SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (let close (call (. tape close-of) index))
    (let access-index (+ index 2))
    (let name (call (. tape after) access-index))
    (let type (call (. tape after) name))
    (let access (call access-at access-index))
    (let left SyntaxId 0)
    (if (call atom-is name "_")
      (= left (call reduce-type type))
      (else
        (let id (call property-name name))
        (let captured SyntaxId 0)
        (if (not (call atom-is type "_"))
          (= captured (call reduce-type type))
        )
        (= left (call (. tree append) (call ASTTypeCapture (call located begin type) id captured)))
