    (let close (call (. tape close-of) index))
    (let loc (call located begin index))
    (let first (+ index 2))
    (if (or (not (call (. tape is-atom) first)) (call is-type-name first))
      (return (call (. tree append) (call ASTEnumDeclaration loc null (call reduce-type first) 0)))
    )
    (let item (call (. tape after) first))
