    )
    (let decoration-count Size 0)
    (let item (call (. tape after) type))
    (while (and (< item close) (call (. tape is-atom) item) (== ([] bytes (call (. tape start) item)) 64))
      (+= decoration-count 1)
      (= item (call (. tape after) item))
