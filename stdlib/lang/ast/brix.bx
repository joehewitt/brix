  (fn-do _ class-base SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (if (and (call (. tape is-atom) index) (call is-number (call (. tape start) index) (call (. tape end) index)))
      (let loc (call located begin index))
      (return (call (. tree append) (call ASTTypeNumeric loc (call number index loc))))
    )
    (if (and (== (call head index) .tuple-head) has-one-item (== (call head (+ index 2)) .capture-head))
      (let field (+ index 2))
      (let loc (call located begin index))
      (let capture
        (call (. tree append)
          (block
            (arg (call ASTTypeCapture loc (call identifier (+ field 2)) (call reduce-type (call (. tape after) (+ field 2)))))
          )
        )
      )
      (return (call (. tree append) (call ASTTypeTuple loc (call (. tree store-child) capture))))
    )
    (lazy has-one-item (== (call count-from (+ index 2) (call (. tape close-of) index)) 1))
    (return (call reduce-type index))
  )
  (fn-expr _ is-class-header-item Bool
    (param index Index)
    (or (== kind .constraint-head) (== kind .implements-head) (== kind .using-head) (== kind .sees-head))
    (where
      (lazy kind (call head index))
    )
