  (fn-do _ class-members (of ImmutableArray SyntaxId) (?! BrixSyntaxError)
    (param first Index)
    (param close Index)
    (let items (call (of scratch-array SyntaxId) tree (call count-from first close)))
    (let filled Size 0)
    (let item first)
    (while (< item close)
      (let made (call member item))
      (if made
        (= ([] items filled) made)
        (+= filled 1)
      )
      (= item (call (. tape after) item))
    )
    (return (call scratch-items items filled))
