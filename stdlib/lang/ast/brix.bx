  )
  (fn-do _ style-rule SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (let close (call (. tape close-of) index))
    (let named (+ index 2))
    (let item (call (. tape after) named))
    (let argument (? SyntaxId) null)
    (if (and (< item close) (== (call head item) .param-head))
      (= argument (call parameter item))
      (= item (call (. tape after) item))
    )
    (let first-application item)
    (= item (call style-applications-end item close))
    (let applications (call style-applications first-application item))
    (let body SyntaxId 0)
    (if (< item close)
      (= body (call block-with-statements tree (call rows item close)))
    )
    (let loc (call located begin index))
    (return
      (call make-style-rule
        (block
          (arg tree)
          (arg (call StyleRuleHeader loc (call atom-at named 0) argument applications (== (call head index) .own-rule-head)))
          (arg body)
        )
      )
    )
  )
  (fn-do _ keyframes SyntaxId (?! BrixSyntaxError)
    (param index Index)
    (let begin (call begin-at index))
    (let close (call (. tape close-of) index))
    (let named (+ index 2))
    (let item (call (. tape after) named))
    (let argument (? SyntaxId) null)
    (if (and (< item close) (== (call head item) .param-head))
      (= argument (call parameter item))
      (= item (call (. tape after) item))
    )
    (let kind (call atom-at item 0))
    (let duration-index (call (. tape after) item))
    (let duration (call expression duration-index))
    (let lines (call keyframe-lines (call (. tape after) duration-index) close))
    (return
      (call make-keyframe-declaration
        (block
          (arg tree)
          (arg (call located begin index))
          (arg (call atom-at named 0))
          (arg argument)
          (arg kind)
          (arg duration)
          (arg lines)
        )
      )
    )
  )
  (fn-do _ keyframe-lines (of ImmutableArray KeyframeLine) (?! BrixSyntaxError)
    (param first Index)
    (param close Index)
    (let lines (call (of scratch-array KeyframeLine) tree (call count-from first close)))
