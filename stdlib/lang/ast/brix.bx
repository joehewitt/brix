    (if (and (< item close) (== (call head item) .machine-head))
      (let stored (call (. tree store-property-decorations) (call scratch-items decorations filled)))
      (let machine (call multi item))
      (return
        (call (. tree append)
          (block
            (arg (call ASTProperty loc access left machine (. stored decoration) false (. stored annotations)))
          )
        )
      )
    )
    (let value (? PropertyAssignmentParts) null)
    (if (< item close)
      (= value (call property-value item))
    )
    (return (call make-property-declaration tree loc access (call scratch-items decorations filled) left value))
