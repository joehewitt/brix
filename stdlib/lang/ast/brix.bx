            (call make-extension-declaration
              (block
                (arg tree)
                (arg (call located begin index))
                (arg access)
                (arg receiver)
                (arg as-types)
                (arg constraints)
                (arg body)
              )
            )
          )
          (arg (call located begin index))
        )
      )
    )
