/os/path
/os/process

+ host-target-name = "macos"

━━━━━━━━━━━━━━━━━━━━
+ do apple-sdk-path Path ?! Error
    - sdk String?

` The path of an Apple SDK, by its `xcrun` name, or of the default SDK when the name is null.
. arguments [String]
if sdk
    arguments += "--sdk"
    arguments += sdk
arguments += "--show-sdk-path"
. process = Process("/usr/bin/xcrun", arguments)
. output = process as String
. status = process.wait(null) ?? 1
process.close()
?! Error("xcrun ${" ".join(arguments)} failed with status $status")
    if status != 0 || output.trim() == ""
= Path(output.trim())

━━━━━━━━━━━━━━━━━━━━
+ do apple-linker-path String ?! Error

. process = Process("/usr/bin/xcrun", "--find", "ld")
. output = process as String
. status = process.wait(null) ?? 1
process.close()
?! Error("xcrun --find ld failed with status $status")
    if status != 0 || output.trim() == ""
= output.trim()
