/data/json
/lang/constants
/lang/target
/os/file
/os/path
/os/process

━━━━━━━━━━━━━━━━━━━━
+ do runtime-config JSON ?! Error

` The project's runtime build config.
= JSON(read-file-text(runtime-config-path()))

━━━━━━━━━━━━━━━━━━━━
+ runtime-config-path Path

toolchain-root / toolchain-config-name

━━━━━━━━━━━━━━━━━━━━
+ target-config JSON ?! Error
    - config JSON
    - target Target

` A target's entry in the runtime build config.
config-member(config-member(config, "targets"), target.name)

━━━━━━━━━━━━━━━━━━━━
+ target-build-path Path ?! Error
    - target Target
    - entry JSON

` Where a target's runtime is built: the build root for the host, and the directory its entry
` names under the build root for any other target.
|? target.name == host-target().name
    yumi-build-path
??
    yumi-build-path / config-string(entry, "buildDirectory")

━━━━━━━━━━━━━━━━━━━━
+ do build-runtime ?! Error
    - target Target
    - build-path Path

` Builds a target's runtime when it is stale, with the toolchain's runtime builder, along with
` the dependencies its entry names. A toolchain without the builder has its runtimes built.
. builder = toolchain-root / "toolchain" / "runtime.py"
=? if !builder.is-file
. process = Process
    - builder as String
    - ["build", "--build", build-path as String, "--target", target.name]
. status = process.wait(null) ?? 1
process.close()
?! Error("Building the ${target.name} runtime failed with status $status")
    if status != 0

━━━━━━━━━━━━━━━━━━━━
+ runtime-file Path
    - path String
    - build-path Path

|? path.starts-with("/")
    Path(path)
|? path.starts-with("build/")
    build-path / path[6 ...]
??
    toolchain-root / path

━━━━━━━━━━━━━━━━━━━━
+ do config-member JSON ?! Error
    - object JSON
    - name String

if object is [String = JSON]
    . found = (object as [String = JSON])[name]
    if found
        = found
?! Error("The runtime build config does not define $name")

━━━━━━━━━━━━━━━━━━━━
+ config-string String ?! Error
    - object JSON
    - name String

?! Error("The runtime build config's $name is not a string")
    if value is not String

value

.. value = config-member(object, name)

━━━━━━━━━━━━━━━━━━━━
+ config-optional-string String? ?! Error
    - object JSON
    - name String

` The value of an optional string member, or null when the object has none.
?! Error("The runtime build config's $name is not a string")
    if found && found is not String

|? !found
    null
??
    found as String

.. found = (object as [String = JSON])[name] if object is [String = JSON]

━━━━━━━━━━━━━━━━━━━━
+ do config-strings [String]
    - object JSON
    - name String

` The strings of an optional list member.
. items [String]
if object is not [String = JSON]
    = items
. found = (object as [String = JSON])[name]
if !found || found is not [JSON]
    = items
for value in found as [JSON]
    if value is String
        items += value
= items
