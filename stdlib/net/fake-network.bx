(import ./dns)
(import ./network)
(import ./socket)
(import /BxCore/BxCore.h)
(import /errno.h)
(import /os/file)
(import /sys/socket.h)
(import /unistd.h)
(import /time/deadline)

(type + FakeNetwork
  (prop _ listeners (list FakeListener))
  (prop _ next-port Port (= 49152))
  (prop _ lock _ (= (call Mutex)))
  (fn-do + connect-to (of Socket Byte) (?! Error)
    (param host String)
    (param port Port)
    (param is-secure Bool)
    (param deadline (? Deadline) (= null))
    (return (call (of TCP Byte) (call open-connection host port)))
  )
  (fn-do + connect-to-host I32 (?! Error)
    (param host String)
    (param port Port)
    (param deadline (? Deadline) (= null))
    (return (call open-connection host port))
  )
  (fn-do + listen-on ListeningSocket (?! Error)
    (param host String)
    (param port Port)
    (let ends (call fake-socket-pair))
    (use lock)
    (let chosen port)
    (if (== port 0)
      (= chosen next-port)
      (+= next-port 1)
    )
    (+= listeners (call FakeListener (call fake-address host chosen) ([] ends 0) ([] ends 1)))
    (return (call ListeningSocket ([] ends 0) chosen))
  )
  (fn-do + accept-from I32 (?! Error)
    (param listener I32)
    (let found (call listener-with listener))
    (return-if -1 (if (not found)))
    (blank)
    (let signal ([] Byte 1))
    (while true
      (let taken (call take-waiting found))
      (return-if taken (if (>= taken 0)))
      (blank)
      (call wait-until-readable listener)
      (let got (call C:read listener signal 1))
      (if (== got 0)
        (return -1)
      )
      (if (and (< got 0) (!= (call C:brixGetErrNo) C:EAGAIN) (!= (call C:brixGetErrNo) C:EINTR))
        (return -1)
      )
    )
    (return -1)
  )
  (fn-do _ open-connection I32 (?! Error)
    (param host String)
    (param port Port)
    (let address (call fake-address host port))
    (let listening (call listener-at address))
    (if (not listening)
      (throw (call IOError (str "Unable to connect socket (no fake server listens on " address ")")))
    )
    (let ends (call fake-socket-pair))
    (call offer listening ([] ends 1))
    (return ([] ends 0))
  )
  (fn-do _ listener-at (? FakeListener)
    (param address String)
    (use lock)
    (for (in each listeners)
      (return-if each (if (== (. each address) address)))
    )
    (return null)
  )
  (fn-do _ listener-with (? FakeListener)
    (param fd I32)
    (use lock)
    (for (in each listeners)
      (return-if each (if (== (. each fd) fd)))
    )
    (return null)
  )
  (fn-do _ offer _
    (param listening FakeListener)
    (param connection I32)
    (do
      (use lock)
      (+= (. listening waiting) connection)
    )
    (let signal ([] Byte 1))
    (call C:write (. listening signal) signal 1)
  )
  (fn-do _ take-waiting I32
    (param listening FakeListener)
    (use lock)
    (return-if -1 (if (== (. listening waiting length) 0)))
    (return (call (. listening waiting pop-first)))
  )
)

(type _ FakeListener
  (prop + address String)
  (prop + fd I32)
  (prop + signal I32)
  (prop + waiting (list I32))
  (fn-do + This _
    (param address String)
    (param fd I32)
    (param signal I32)
  )
)

(fn-expr _ fake-address String
  (param host String)
  (param port Port)
  (str (if-expr (== host "localhost") "127.0.0.1" host) ":" port)
)

(fn-do _ fake-socket-pair ([] I32)
  (let ends ([] I32 2))
  (throw (call IOError "Unable to make a fake connection") (if (== (call C:socketpair C:AF_UNIX C:SOCK_STREAM 0 ends) -1)))
  (call (of File Byte) ([] ends 0) true false)
  (call (of File Byte) ([] ends 1) true false)
  (return ends)
)
