

+ URLPort is U16

_ url-unreserved-chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~"

━━━━━━━━━━━━━━━━━━━━
+ URL is Tuple

+ scheme String
+ has-slashes = false
+ auth URLAuth?
+ host String
+ port URLPort = 0
+ paths [String]
+ search URLQuery?
+ hash String?

────────────────────
+ This
    - scheme String
    - host String
    - path String

.. has-slashes = true
.. port = port-for-scheme(scheme)
.. paths = path.split("/")

────────────────────
+ This ~ Char

~ sc \scheme ":" hs \slashes au \auth? ho URLHost pa \path se \search? ha \hash?
    This(sc, hs, au, ho.address, port as URLPort, pa, se, ha)
        .. port =
            |? !ho.port
                port-for-scheme(sc)
            ??
                ho.port

.. scheme  ~
    ~ \alphanumeric+
.. slashes  ~
    ~ "/"*
        it.length > 0
.. auth ~
    ~ au URLAuth "@"
        au
.. path ~
    ~ "/" paths \delimited("/", ~ \segment)
        paths
    ??
        List'String()
.. segment String ~
    ~ \url-chars
    ??
        ""
.. search ~
    ~ "?" s URLQuery
        s
.. hash ~
    ~ "#" h .+
        h

.. url-chars String ~
    ~ head \url-char tail \url-chars
        head ++ tail
    ~ \url-char

.. url-char ~
    ~ [A-Za-z0-9-_.~!$&'()*+,;=@]
    ~ "%" hx \hex'Char8
        (hx as Char) as String

────────────────────
+ from text String

match text
    ~ This
    ?! SyntaxError("Invalid url")

────────────────────
+ to String

"$scheme:$slasher$auths$host$aport/$path$searcher$hasher"

.. auths = if auth then auth as String else ""
.. slasher = if has-slashes then "//" else ""
.. searcher = if search then "?$search" else ""
.. hasher = if hash then "#$hash" else ""
.. path = "/".join(paths)
.. aport = if port then ":$port" else ""

────────────────────
+ is-secure Bool

scheme == "https" || scheme == "wss"

────────────────────
+ this / new-path String

URL(scheme, has-slashes, auth, host, port, paths + new-path, search, hash)

━━━━━━━━━━━━━━━━━━━━
+ URLAuth is (user String, pass String)

────────────────────
+ This ~ Char

~ user \alphanumeric+ ":" pass \alphanumeric+
    This(user, pass)
~ user \alphanumeric+
    This(user, "")

────────────────────
+ to String

"$user:$pass@"

━━━━━━━━━━━━━━━━━━━━
+ URLHost is (address String, port URLPort)

────────────────────
+ This ~ Char

~ addr \address ":" p \port
    This(addr, p)
~ addr \address
    This(addr, 0)

.. address String ~
    ~ \numeric+ "." \numeric+ "." \numeric+ "." \numeric+
    ~ \name "." \address
    ~ \name
.. name ~
    ~ \alphanumeric ("-"* \alphanumeric)*
.. port URLPort ~
    ~ \numeric+

────────────────────
+ to String

|? port > 0
    "$address:$port"
??
    address

━━━━━━━━━━━━━━━━━━━━
+ URLQuery is Tuple

+ pairs [URLPair]

────────────────────
+ This ~ Char

~ pairs \delimited("&", ~ URLPair)
    This(pairs)

────────────────────
+ to String

"&".join(pairs)

━━━━━━━━━━━━━━━━━━━━
+ URLPair is (key String, value String)

────────────────────
+ This ~ Char

~ key \parts value \assignment
    This(key, value)

.. assignment ~
    ~ "=" value \parts
        value
    ~ values \parts*
        values as String

.. parts String ~
    ~ head \character tail \parts
        head + tail
    ~ \character

.. character ~
    ~ "%" hx \hex'Char8
        hx as String
    ~ "\\%"
        "%"
    ~ ![&#=] .

────────────────────
+ to String

if value.length then "$key=$value" else key

━━━━━━━━━━━━━━━━━━━━
+ port-for-scheme
    - scheme String

match scheme
    | "http"
        80
    | "ws"
        80
    | "https"
        443
    | "wss"
        443
    ??
        0

━━━━━━━━━━━━━━━━━━━━
+ do url-encode String
    - text String

. bytes = byte-view(text)
. encoded = ""
for i in 0 .. < bytes.size
    . piece = bytes[i] as Char as String
    if url-unreserved-chars.find(piece) != null
        encoded += piece
    else
        encoded += "%${(bytes[i] as Hex)[2 .. < 4].uppercased}"
= encoded
