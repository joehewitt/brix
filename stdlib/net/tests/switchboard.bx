(import /net/fake-network)
(import /net/http)
(import /net/http-server)
(import /net/network)
(import /net/url)
(import /net/websocket)
(import /test)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Switchboard HTTP"))
  (call (. cases run) http-tests)
  (= cases (call (. cases then) "Switchboard WebSocket" websocket-tests))
  (return cases)
)

(fn-do + http-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (<> HTTPServer (id: server)
      (= host "api.example.com")
      (= port 80)
      (blank)
      (<> Route (text: "/greeting")
        (= get greet)
      )
    )
    (call (. server start))
    (let response (call http-get (call URL "http://api.example.com/greeting")))
    (call (. t expect) "the server answers through the switchboard" (. HTTPStatus ok) (. response status))
    (call (. t expect) "the client reads the server's body" "hello from the switchboard" (. response text))
    (let secure (call http-get (call URL "https://api.example.com:80/greeting")))
    (call (. t expect) "a secure connection is a plain one under the fake" "hello from the switchboard" (. secure text))
    (call (. server close))
  )
  (return t)
)

(fn-do + websocket-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (<> HTTPServer (id: server)
      (= host "chat.example.com")
      (= port 80)
      (blank)
      (<> Route (text: "/echo")
        (= websocket echo)
      )
    )
    (call (. server start))
    (let socket (call WebSocket (call URL "ws://chat.example.com/echo")))
    (call (. socket send) "ping")
    (let heard "")
    (for (in line socket)
      (= heard line)
      (break)
    )
    (call (. t expect) "a websocket client hears the server through the switchboard" "echo: ping" heard)
    (call (. socket close))
    (call (. server close))
  )
  (return t)
)

(fn-expr + greet HTTPResponse
  (param request HTTPRequest)
  (call HTTPResponse (. HTTPStatus ok) "hello from the switchboard")
)

(fn-do + echo _ (?! Error)
  (param socket WebSocket)
  (for (in text socket)
    (call (. socket send) (str "echo: " text))
  )
)
