(import /core/tokenstream)
(import /data)
(import /data/stream)
(import /net/fake-network)
(import /net/http)
(import /net/http-server)
(import /net/network)
(import /net/socket)
(import /net/sse)
(import /net/url)
(import /net/websocket)
(import /test)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "HTTP Routing"))
  (call (. cases run) routing-tests)
  (= cases (call (. cases then) "HTTP Refusals" refusal-tests))
  (= cases (call (. cases then) "HTTP HEAD" head-tests))
  (= cases (call (. cases then) "HTTP Limits" limit-tests))
  (= cases (call (. cases then) "HTTP Framing" framing-tests))
  (= cases (call (. cases then) "HTTP Connections" connection-tests))
  (= cases (call (. cases then) "HTTP Streaming" streaming-tests))
  (return cases)
)

(fn-do + routing-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (<> HTTPServer (id: server)
      (= host "site.test")
      (= port 80)
      (blank)
      (<> Route (text: "/items/{id}")
        (= get show-item)
      )
      (<> Route (text: "/items/latest")
        (= get show-path)
      )
      (<> Route (text: "/shop")
        (<> Route (text: "cart")
          (= get show-path)
        )
      )
    )
    (call (. server start))
    (call (. t expect) "a parameter takes the segment it stands for" "item 7" (=> () (. (call fetch "/items/7") text)))
    (call (. t expect) "a literal segment wins over a parameter" "/items/latest" (=> () (. (call fetch "/items/latest") text)))
    (call (. t expect) "the query reaches the handler and does not change the route" "item 7, color=red" (=> () (. (call fetch "/items/7?color=red") text)))
    (call (. t expect) "a nested route joins its path to its parent's" "/shop/cart" (=> () (. (call fetch "/shop/cart") text)))
    (call (. t expect) "a route with no handlers of its own answers nothing" (. HTTPStatus not-found) (=> () (. (call fetch "/shop") status)))
    (call (. t expect) "a path no route names is not found" (. HTTPStatus not-found) (=> () (. (call fetch "/nowhere") status)))
    (call (. server close))
  )
  (return t)
)

(fn-do + refusal-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (<> HTTPServer (id: server)
      (= host "site.test")
      (= port 80)
      (blank)
      (<> Route (text: "/notes")
        (= get show-path)
        (= post show-path)
      )
      (<> Route (text: "/live")
        (= websocket hang-up)
      )
      (<> Route (text: "/broken")
        (= get fail)
      )
    )
    (call (. server start))
    (let deleted (call http-fetch (call HTTPRequest (. HTTPMethod delete) (call site-url "/notes"))))
    (call (. t expect) "a method the route has no handler for is not allowed" (. HTTPStatus method-not-allowed) (. deleted status))
    (call (. t expect) "the refusal names the methods the route allows" "GET, HEAD, POST" (call (. deleted header) "Allow"))
    (let plain (call fetch "/live"))
    (call (. t expect) "a plain request to a websocket route must upgrade" (. HTTPStatus upgrade-required) (. plain status))
    (call (. t expect) "the refusal names the protocol to upgrade to" "websocket" (call (. plain header) "Upgrade"))
    (call (. t expect) "a handler that raises gives a server error" (. HTTPStatus internal-server-error) (=> () (. (call fetch "/broken") status)))
    (call (. server close))
  )
  (return t)
)

(fn-do + head-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (<> HTTPServer (id: server)
      (= host "site.test")
      (= port 80)
      (blank)
      (<> Route (text: "/notes")
        (= get show-path)
      )
    )
    (call (. server start))
    (let got (call fetch "/notes"))
    (let headed (call http-fetch (call HTTPRequest (. HTTPMethod head) (call site-url "/notes"))))
    (call (. t expect) "HEAD is answered by the GET handler" (. HTTPStatus ok) (. headed status))
    (call (. t expect) "HEAD gives the length GET would" (call (. got header) "Content-Length") (call (. headed header) "Content-Length"))
    (let transcript (call exchange "HEAD /notes HTTP/1.1\r\nHost: site.test\r\nConnection: close\r\n\r\n"))
    (call (. t check) "nothing follows the head of a HEAD response" (call (. transcript ends-with) "\r\n\r\n"))
    (call (. server close))
  )
  (return t)
)

(fn-do + limit-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (<> HTTPServer (id: server)
      (= host "site.test")
      (= port 80)
      (= max-header-size 512)
      (= max-body-size 16)
      (blank)
      (<> Route (text: "/echo")
        (= post echo)
      )
    )
    (call (. server start))
    (let url (call site-url "/echo"))
    (let long-text "a body of thirty-two bytes long.")
    (call (. t expect) "a declared body over the limit is too large" (. HTTPStatus content-too-large) (=> () (. (call http-post url long-text) status)))
    (call (. t expect) "a chunked body over the limit is too large" (. HTTPStatus content-too-large) (=> () (. (call http-post url (call (of DataStream Byte) long-text)) status)))
    (call (. t expect) "a chunked body within the limit reaches the handler whole" "short body" (=> () (. (call http-post url (call (of DataStream Byte) "short body")) text)))
    (let padding (call (. "" join) (in "x" (..< 0 1000))))
    (let headers (list HTTPHeader))
    (+= headers (tuple "X-Padding" padding))
    (call (. t expect) "a head over the limit is refused" (. HTTPStatus request-header-fields-too-large) (=> () (. (call http-post url "short" headers) status)))
    (call (. server close))
  )
  (return t)
)

(fn-do + framing-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (<> HTTPServer (id: server)
      (= host "site.test")
      (= port 80)
      (blank)
      (<> Route (text: "/echo")
        (= post echo)
      )
    )
    (call (. server start))
    (call (. t expect) "a request that is not HTTP is bad" (list "400 ") (=> () (call replies (call exchange "NONSENSE\r\n\r\n"))))
    (let both "POST /echo HTTP/1.1\r\nHost: site.test\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n")
    (call (. t expect) "a request framed both by length and by chunks is bad" (list "400 ") (=> () (call replies (call exchange both))))
    (let twice "POST /echo HTTP/1.1\r\nHost: site.test\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello")
    (call (. t expect) "a request with two lengths is bad" (list "400 ") (=> () (call replies (call exchange twice))))
    (let zipped "POST /echo HTTP/1.1\r\nHost: site.test\r\nTransfer-Encoding: gzip\r\n\r\nhello")
    (call (. t expect) "a transfer encoding other than chunked is bad" (list "400 ") (=> () (call replies (call exchange zipped))))
    (call (. server close))
  )
  (return t)
)

(fn-do + connection-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (<> HTTPServer (id: server)
      (= host "site.test")
      (= port 80)
      (blank)
      (<> Route (text: "/{name}")
        (= get show-path)
      )
    )
    (call (. server start))
    (let pipelined "GET /first HTTP/1.1\r\nHost: site.test\r\n\r\nGET /second HTTP/1.1\r\nHost: site.test\r\nConnection: close\r\n\r\n")
    (call (. t expect) "an HTTP/1.1 connection serves requests until one asks to close" (list "200 /first" "200 /second") (=> () (call replies (call exchange pipelined))))
    (let old (call exchange "GET /old HTTP/1.0\r\nHost: site.test\r\n\r\nGET /older HTTP/1.0\r\nHost: site.test\r\n\r\n"))
    (call (. t expect) "an HTTP/1.0 connection closes after one request" (list "200 /old") (=> () (call replies old)))
    (call (. t check) "the HTTP/1.0 reply says it closes" (call (. old find) "Connection: close"))
    (let kept "GET /old HTTP/1.0\r\nHost: site.test\r\nConnection: keep-alive\r\n\r\nGET /older HTTP/1.0\r\nHost: site.test\r\n\r\n")
    (call (. t expect) "an HTTP/1.0 connection that asks to be kept serves another request" (list "200 /old" "200 /older") (=> () (call replies (call exchange kept))))
    (call (. server close))
  )
  (return t)
)

(fn-do + streaming-tests TestCase
  (param t TestCase)
  (let gate (channel Bool))
  (do-with network (call FakeNetwork)
    (<> HTTPServer (id: server)
      (= host "site.test")
      (= port 80)
      (blank)
      (<> Route (text: "/download")
        (= get download)
      )
      (<> Route (text: "/events")
        (= get (=> (request) (call HTTPResponse (. HTTPStatus ok) (call gated-events gate))))
      )
    )
    (call (. server start))
    (let downloaded (call fetch "/download"))
    (call (. t expect) "a body read from a source is sent in chunks" "chunked" (call (. downloaded header) "Transfer-Encoding"))
    (call (. t expect) "the chunks join into the source's bytes" 10000 (=> () (. downloaded text length)))
    (let response (call http-send (call HTTPRequest (. HTTPMethod get) (call site-url "/events"))))
    (call (. t expect) "events are sent as an event stream" "text/event-stream" (call (. response header) "Content-Type"))
    (call (. t expect) "an event stream is not cached" "no-cache" (call (. response header) "Cache-Control"))
    (let heard (list String))
    (for (in event (call server-sent-events (. response reader)))
      (+= heard (. event data))
      (if (== (. heard length) 1)
        (<- gate true)
      )
    )
    (call (. response close))
    (call (. t expect) "each event arrives before the server sends the next" (list "one" "two") heard)
    (call (. server close))
  )
  (return t)
)

(fn-expr + site-url URL
  (param path String)
  (call URL (str "http://site.test" path))
)

(fn-expr + fetch HTTPResponse (?! Error)
  (param path String)
  (call http-get (call site-url path))
)

(fn-do + exchange String (?! Error)
  (param text String)
  (let socket (call (of TCP Byte) "site.test" 80))
  (<- socket text)
  (let received (as socket ([] Byte)))
  (call (. socket close))
  (return (call (. received slice-string)))
)

(fn-do + replies (list String) (?! Error)
  (param transcript String)
  (let stream (call (of ChunkedTokenStream Byte) (call (of DataStream Byte) transcript)))
  (let found (list String))
  (while true
    (match (catch (call read-http-response stream))
      (case (: response HTTPResponse)
        (+= found (str (as (. response status) Int) " " (. response text)))
      )
      (default
        (break)
      )
    )
  )
  (return found)
)

(fn-expr + show-item HTTPResponse
  (param request HTTPRequest)
  (call HTTPResponse (. HTTPStatus ok) (str "item " ([] (. request params) "id") query))
  (where
    (lazy query (if-expr (. request query) (str ", " (. request query)) ""))
  )
)

(fn-expr + show-path HTTPResponse
  (param request HTTPRequest)
  (call HTTPResponse (. HTTPStatus ok) (. request path))
)

(fn-do + echo HTTPResponse (?! Error)
  (param request HTTPRequest)
  (return (call HTTPResponse (. HTTPStatus ok) (. request text)))
)

(fn-do + fail HTTPResponse (?! Error)
  (param request HTTPRequest)
  (throw (call Error "the handler failed"))
)

(fn-expr + download HTTPResponse
  (param request HTTPRequest)
  (call HTTPResponse (. HTTPStatus ok) (call (of DataStream Byte) (call (. "" join) (in "0123456789" (..< 0 1000)))))
)

(fn-do + hang-up _ (?! Error)
  (param socket WebSocket)
  (call (. socket close))
)

(fn-do + gated-events (stream ServerSentEvent)
  (param gate (channel Bool))
  (yield (call ServerSentEvent "one"))
  (blank)
  (<- gate)
  (yield (call ServerSentEvent "two"))
)
