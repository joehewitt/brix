(import /core/tokenstream)
(import /data)
(import /net/fake-network)
(import /net/http)
(import /net/http-server)
(import /net/network)
(import /net/socket)
(import /net/websocket)
(import /test)
(import /time/clock)
(import /time/duration)
(import /time/fake-clock)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "HTTP Idle Connections"))
  (call (. cases run) idle-tests)
  (= cases (call (. cases then) "HTTP Stalled Requests" stall-tests))
  (= cases (call (. cases then) "WebSocket Silent Peers" silent-tests))
  (return cases)
)

(fn-do + idle-tests TestCase
  (param t TestCase)
  (let fake (call FakeClock))
  (let heard (list String))
  (do-with clock fake
    (do-with network (call FakeNetwork)
      (let server (call site-server))
      (call (. server start))
      (let socket (call (of TCP Byte) "site.test" 80))
      (let stream (call (of ChunkedTokenStream Byte) socket))
      (<- socket "GET /first HTTP/1.1\r\nHost: site.test\r\n\r\n")
      (call (. t expect) "a request is served" "/first" (=> () (. (call read-http-response stream) text)))
      (let waiting
        (do-new
          (+= heard (call next-reply stream))
        )
      )
      (call (. fake advance) 0s)
      (call (. fake advance) 29s)
      (call (. t expect) "a connection kept alive waits for the next request until the read timeout" 0 (. heard length))
      (call (. fake advance) 1s)
      (call (. waiting wait))
      (call (. t expect) "an idle connection is closed at the read timeout" (list "closed") heard)
      (call (. socket close))
      (call (. server close))
    )
  )
  (return t)
)

(fn-do + stall-tests TestCase
  (param t TestCase)
  (let fake (call FakeClock))
  (let heard (list String))
  (do-with clock fake
    (do-with network (call FakeNetwork)
      (let server (call site-server))
      (call (. server start))
      (let socket (call (of TCP Byte) "site.test" 80))
      (let stream (call (of ChunkedTokenStream Byte) socket))
      (<- socket "GET /stalled HTTP/1.1\r\nHost: si")
      (let waiting
        (do-new
          (+= heard (call next-reply stream))
        )
      )
      (call (. fake advance) 0s)
      (call (. fake advance) 29s)
      (call (. t expect) "a request whose head stalls is waited for until the read timeout" 0 (. heard length))
      (call (. fake advance) 1s)
      (call (. waiting wait))
      (call (. t expect) "a request whose head stalls is dropped at the read timeout" (list "closed") heard)
      (call (. socket close))
      (call (. server close))
    )
  )
  (return t)
)

(fn-do + silent-tests TestCase
  (param t TestCase)
  (let fake (call FakeClock))
  (let heard (list String))
  (do-with clock fake
    (do-with network (call FakeNetwork)
      (let server (call site-server))
      (call (. server start))
      (let socket (call (of TCP Byte) "site.test" 80))
      (<- socket (call upgrade-request "/echo"))
      (let reply (call read-http-response (call (of ChunkedTokenStream Byte) socket)))
      (call (. t expect) "the handshake is accepted" (. HTTPStatus switching-protocols) (. reply status))
      (let waiting
        (do-new
          (let data (as socket ([] Byte)))
          (+= heard (str "closed after " (. data size) " bytes, the first frame " ([] data 0) " " ([] data 1)))
        )
      )
      (call (. fake advance) 0s)
      (call (. fake advance) 30s)
      (call (. t expect) "a peer is pinged after one interval and not yet dropped" 0 (. heard length))
      (call (. fake advance) 30s)
      (call (. waiting wait))
      (call (. t expect) "a peer that does not answer the ping is dropped at the next interval, sent only the ping" (list "closed after 2 bytes, the first frame 137 0") heard)
      (call (. socket close))
      (call (. server close))
    )
  )
  (return t)
)

(fn-do + site-server HTTPServer
  (<> HTTPServer (id: server)
    (= host "site.test")
    (= port 80)
    (= read-timeout 30s)
    (= websocket-ping-interval 30s)
    (blank)
    (<> Route (text: "/echo")
      (= websocket echo)
    )
    (<> Route (text: "/{name}")
      (= get show-path)
    )
  )
  (return server)
)

(fn-do + next-reply String
  (param stream (of ChunkedTokenStream Byte))
  (match (catch (call read-http-response stream))
    (case (: response HTTPResponse)
      (return (str "answered " (. response status)))
    )
    (default
      (return "closed")
    )
  )
)

(fn-expr + upgrade-request String
  (param path String)
  (call (. "\r\n" join) lines)
  (where
    (lazy lines (list String)
      (block
        (item (str "GET " path " HTTP/1.1"))
        (item "Host: site.test")
        (item "Upgrade: websocket")
        (item "Connection: Upgrade")
        (item "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==")
        (item "Sec-WebSocket-Version: 13")
        (item "")
        (item "")
      )
    )
  )
)

(fn-expr + show-path HTTPResponse
  (param request HTTPRequest)
  (call HTTPResponse (. HTTPStatus ok) (. request path))
)

(fn-do + echo _ (?! Error)
  (param socket WebSocket)
  (for (in text socket)
    (call (. socket send) text)
  )
)
