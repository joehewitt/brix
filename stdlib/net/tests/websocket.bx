(import /core/tokenstream)
(import /data)
(import /net/fake-network)
(import /net/http)
(import /net/http-server)
(import /net/network)
(import /net/socket)
(import /net/url)
(import /net/websocket)
(import /test)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "WebSocket Subprotocols"))
  (call (. cases run) subprotocol-tests)
  (= cases (call (. cases then) "WebSocket Messages" message-tests))
  (= cases (call (. cases then) "WebSocket Limits" limit-tests))
  (= cases (call (. cases then) "WebSocket Handshakes" handshake-tests))
  (= cases (call (. cases then) "WebSocket Endings" ending-tests))
  (return cases)
)

(fn-do + subprotocol-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call chat-server))
    (call (. server start))
    (let offered (call WebSocket (call chat-url "/protocol") (list "text" "json")))
    (call (. t expect) "the server picks the first of its own protocols the client offers" "json" (call next-text offered))
    (call (. t expect) "the client learns the protocol the server picked" "json" (. offered protocol))
    (call (. offered close))
    (let unshared (call WebSocket (call chat-url "/protocol") (list "xml")))
    (call (. t expect) "a connection with no protocol in common opens with none" "none" (call next-text unshared))
    (call (. t check) "the client then has no protocol" (not (. unshared protocol)))
    (call (. unshared close))
    (call (. server close))
  )
  (return t)
)

(fn-do + message-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call chat-server))
    (call (. server start))
    (let socket (call WebSocket (call chat-url "/echo")))
    (for (in size (list 125 126 65535 65536))
      (let text (call sized-text size))
      (call (. socket send) text)
      (call (. t expect) (str "a text of " size " bytes comes back whole") text (call next-text socket))
    )
    (call (. socket close))
    (let binary (call WebSocket (call chat-url "/bytes")))
    (call (. binary send) (call (of Array Byte) "bytes, not text"))
    (call (. t expect) "a binary message comes back as the same bytes" "bytes, not text" (call next-bytes binary))
    (call (. binary close))
    (call (. server close))
  )
  (return t)
)

(fn-do + limit-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call chat-server))
    (call (. server start))
    (let socket (call WebSocket (call chat-url "/flood") (call (of List String)) 100))
    (let heard (list String))
    (for (in text socket)
      (+= heard text)
    )
    (call (. t expect) "a message over the client's limit is not delivered" (call (of List String)) heard)
    (call (. t check) "a message over the client's limit closes the connection" (not (. socket is-open)))
    (call (. socket close))
    (call (. server close))
  )
  (return t)
)

(fn-do + handshake-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call chat-server))
    (call (. server start))
    (call (. t expect) "a route that does not take websockets refuses the handshake" "WebSocket handshake failed (200)" (call open-failure "/page"))
    (call (. t expect) "a path no route names refuses the handshake" "WebSocket handshake failed (404)" (call open-failure "/nowhere"))
    (let sample (call handshake "dGhlIHNhbXBsZSBub25jZQ==" "13"))
    (call (. t expect) "the server switches protocols for a good handshake" (. HTTPStatus switching-protocols) (. sample status))
    (call (. t expect) "the accept key answers the RFC 6455 sample key" "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=" (call (. sample header) "Sec-WebSocket-Accept"))
    (let old (call handshake "dGhlIHNhbXBsZSBub25jZQ==" "8"))
    (call (. t expect) "a version other than 13 must upgrade" (. HTTPStatus upgrade-required) (. old status))
    (call (. t expect) "the refusal names the version the server speaks" "13" (call (. old header) "Sec-WebSocket-Version"))
    (call (. t expect) "a key that is not 16 bytes is bad" (. HTTPStatus bad-request) (. (call handshake "c2hvcnQ=" "13") status))
    (call (. server close))
  )
  (return t)
)

(fn-do + ending-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call chat-server))
    (call (. server start))
    (let socket (call WebSocket (call chat-url "/broken")))
    (let heard (list String))
    (for (in text socket)
      (+= heard text)
    )
    (call (. t expect) "a handler that raises closes the connection after what it sent" (list "hello") heard)
    (call (. socket close))
    (call (. server close))
  )
  (return t)
)

(fn-do + chat-server HTTPServer
  (<> HTTPServer (id: server)
    (= host "chat.test")
    (= port 80)
    (blank)
    (<> Route (text: "/protocol")
      (= websocket tell-protocol)
      (= protocols (list "json" "text"))
    )
    (<> Route (text: "/echo")
      (= websocket echo)
    )
    (<> Route (text: "/bytes")
      (= websocket echo-bytes)
    )
    (<> Route (text: "/flood")
      (= websocket flood)
    )
    (<> Route (text: "/broken")
      (= websocket fail-after-hello)
    )
    (<> Route (text: "/page")
      (= get show-page)
    )
  )
  (return server)
)

(fn-expr + chat-url URL
  (param path String)
  (call URL (str "ws://chat.test" path))
)

(fn-do + next-text (? String)
  (param socket WebSocket)
  (for (in text socket)
    (return text)
  )
  (return null)
)

(fn-do + next-bytes (? String)
  (param socket WebSocket)
  (for (in data (as socket (of Iterable (of ReadableData Byte))))
    (return (call (. (as data ([] Byte)) slice-string)))
  )
  (return null)
)

(fn-do + open-failure String
  (param path String)
  (match (catch (call WebSocket (call chat-url path)))
    (case (: error IOError)
      (return (. error message))
    )
    (case (: socket WebSocket)
      (call (. socket close))
      (return "opened")
    )
    (case (: error Error)
      (return (str "raised " (. error message)))
    )
  )
)

(fn-do + handshake HTTPResponse (?! Error)
  (param key String)
  (param version String)
  (let socket (call (of TCP Byte) "chat.test" 80))
  (<- socket (call (. "\r\n" join) (list "GET /echo HTTP/1.1" "Host: chat.test" "Upgrade: websocket" "Connection: Upgrade" (str "Sec-WebSocket-Key: " key) (str "Sec-WebSocket-Version: " version) "" "")))
  (let response (call read-http-response (call (of ChunkedTokenStream Byte) socket)))
  (call (. socket close))
  (return response)
)

(fn-expr + sized-text String
  (param size Size)
  ([] whole (..< 0 size))
  (where
    (lazy whole (call (. "" join) (in "0123456789" (..< 0 (+ (/ size 10) 1)))))
  )
)

(fn-do + tell-protocol _ (?! Error)
  (param socket WebSocket)
  (call (. socket send) (?? (. socket protocol) "none"))
  (for (in text socket))
)

(fn-do + echo _ (?! Error)
  (param socket WebSocket)
  (for (in text socket)
    (call (. socket send) text)
  )
)

(fn-do + echo-bytes _ (?! Error)
  (param socket WebSocket)
  (for (in data (as socket (of Iterable (of ReadableData Byte))))
    (call (. socket send) (as data ([] Byte)))
  )
)

(fn-do + flood _ (?! Error)
  (param socket WebSocket)
  (call (. socket send) (call sized-text 200))
  (for (in text socket))
)

(fn-do + fail-after-hello _ (?! Error)
  (param socket WebSocket)
  (call (. socket send) "hello")
  (throw (call Error "the handler failed"))
)

(fn-expr + show-page HTTPResponse
  (param request HTTPRequest)
  (call HTTPResponse (. HTTPStatus ok) "a page")
)
