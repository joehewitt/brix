━━━━━━━━━━━━━━━━━━━━
+ tests TestRender

════════════════════
test("HTTP Stream")

"hello world", response.text
    .. response = read-http-response(ChunkedTokenStream'Byte(source))
        .. source = DataStream'Byte(text)
        .. text = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n$chunks"
        .. chunks = "5\r\nhello\r\n6;ext=1\r\n world\r\n0\r\n\r\n"
"hello world", response.text
    .. response = read-http-response(ChunkedTokenStream'Byte(source))
        .. source = ShortReadStream(text, text.find(body)!, 5)
        .. body = "hello world"
        .. text = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nB\r\n$body\r\n0\r\n\r\n"
"plain body", response.text
    .. response = read-http-response(ChunkedTokenStream'Byte(source))
        .. source = DataStream'Byte(text)
        .. text = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nplain body"

════════════════════
test("Server Sent Events")

"hello\none\ntwo\n7\n---\n\n[DONE]\n7\n---", "\n".join(sse-lines(source))
    .. source = DataStream'Byte(text)
    .. text = "event: hello\r\ndata: one\r\ndata: two\r\nid: 7\r\n\r\ndata: [DONE]\n\n"

════════════════════
test("URL Parse")

"http://joe:pass@foo.com:80/home/base?aa=bb&dd=ee&ccc#poop", parsed-url() as String

━━━━━━━━━━━━━━━━━━━━
+ ShortReadStream
    is ReadableData'Byte

+ data Byte[]
+ split Index
+ cursor Index
+ max-read Size

────────────────────
+ This
    - data Byte[]
    - split Index
    - max-read Size

────────────────────
+ get is-encoded

false

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

if amount > 0
    buffer[0 .. < amount] = data[cursor .. < cursor + amount]
    cursor += amount

= amount

.. remaining = data.size - cursor
.. capped =
    |? cursor < split
        split - cursor
    ??
        max-read
.. wanted = if size < capped then size else capped
.. amount = if remaining < wanted then remaining else wanted

━━━━━━━━━━━━━━━━━━━━
_ do sse-lines
    - source ReadableData'Byte

. lines [String]
for event in server-sent-events(source)
    lines += event.event
    lines += event.data
    lines += event.id
    lines += "---"

= lines

