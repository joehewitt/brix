+ websocket-message-limit Size = 0x1000000
+ websocket-close-timeout Seconds = 5s

_ websocket-guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
_ boundary-8bit = 126
_ boundary-16bit = 65535
_ control-limit U64 = 125

━━━━━━━━━━━━━━━━━━━━
+ WebSocketHandler is () Void ?! Error
    - socket WebSocket

━━━━━━━━━━━━━━━━━━━━
+ WebSocketClose is U16

| normal = 1000
| going-away = 1001
| protocol-error = 1002
| unsupported-data = 1003
| no-status = 1005
| invalid-data = 1007
| policy-violation = 1008
| too-big = 1009
| internal-error = 1011

━━━━━━━━━━━━━━━━━━━━
+ WebSocket
    is Closable
    is Writable'String
    is Writable'(Byte[])

+ request HTTPRequest
+ protocol String?

_ socket Socket'Byte
_ output WritableData
_ limit Size
_ is-client = false
_ is-closing = false
_ is-heard = true
_ pending Frame?
_ sender Task
_ receiver Task
_ keeper Task?
_ outgoing = SyncBufferedChannel'Frame()

as Iterable'ReadableData for
_ binary-incoming Frame<>
as Iterable'String for
_ text-incoming String<>

────────────────────
+ This ?! Error
    - url URL
    - protocols [String] = List'String()
    - limit = websocket-message-limit

. key = random-bytes(16) as Base64
request = HTTPRequest(HTTPMethod.get, url, handshake-headers(url, key, protocols))
is-client = true

//this:network.web.socket.open.start -> "", "$url", url.host, url.port, request.target

socket = Socket'Byte(url.host, url.port, url.is-secure())
output = socket
write-http-message(socket, request.start-line, request.headers, null)

. stream = ChunkedTokenStream'Byte(socket)
. handshake = read-http-response(stream)
//this:network.web.socket.handshake -> request-headers, handshake.status, response-headers
    .. request-headers = "\n".join("$each" in request.headers)
    .. response-headers = "\n".join("$each" in handshake.headers)

. failure = handshake-failure(handshake, key)
if failure
    catch socket.close()
    ?! failure

protocol = handshake.header("Sec-WebSocket-Protocol")
//this:network.web.socket.open -> ""

sender = do new send-frames()
receiver = do new receive-frames(stream)

────────────────────
+ This
    - request HTTPRequest
    - protocol String?
    - stream ChunkedTokenStream'Byte
    - socket Socket'Byte
    - output WritableData
    - ping-interval Seconds
    - limit = websocket-message-limit

sender = do new send-frames()
receiver = do new receive-frames(stream)
keeper = do new keep-alive(ping-interval)

────────────────────
+ get is-open

!is-closing && !receiver.is-finished

────────────────────
+ do send
    - text String

send-frame(Frame(text))

────────────────────
+ do send
    - data Byte[]

send-frame(Frame(data))

────────────────────
+ do this <- text String

send(text)

────────────────────
+ do this <- data Byte[]

send(data)

────────────────────
+ do send-ping
    - data = Byte[0]

send-frame(Frame(OpCode.ping, data))

────────────────────
+ do close

close(WebSocketClose.normal)

────────────────────
+ do close
    - code WebSocketClose
    - reason = ""

begin-closing(code, reason)
. watchdog = do new stop-receiving-after(websocket-close-timeout)
receiver.wait()
watchdog.cancel()
sender.wait()

────────────────────
_ do send-frame
    - frame Frame

=? if is-closing
outgoing <- frame

────────────────────
_ do begin-closing
    - code WebSocketClose
    - reason = ""

=? if is-closing
outgoing <- Frame(code, reason)
is-closing = true

────────────────────
_ do stop-receiving-after
    - delay Seconds

delay.wait()
receiver.cancel()

────────────────────
_ do keep-alive
    - interval Seconds

while true
    interval.wait()
    if !is-heard
        receiver.cancel()
        =
    is-heard = false
    send-ping()

────────────────────
_ do send-frames

do finally
    outgoing.close()
    catch socket.close()
catch write-frames()

────────────────────
_ do write-frames ?! Error

for frame in outgoing
    frame.write-frame(output, is-client)
    //this:network.web.socket.frame.sent -> frame.op, frame.is-fin, frame.payload.size, network-preview(frame.payload, frame.payload.size), network-is-truncated(frame.payload.size)

────────────────────
_ do receive-frames
    - stream ChunkedTokenStream'Byte

do finally
    keeper?.cancel()
    text-incoming.close()
    binary-incoming.close()
    outgoing.close()
catch read-frames(stream)

────────────────────
_ do read-frames ?! Error
    - stream ChunkedTokenStream'Byte

for frame in stream ~> \frame(limit)
    is-heard = true
    //this:network.web.socket.frame.received -> frame.op, frame.is-fin, frame.payload.size, network-preview(frame.payload, frame.payload.size), network-is-truncated(frame.payload.size)
    . ending = frame.refusal(!is-client, limit) ?? take(frame)
    if ending
        begin-closing(ending)
        =

────────────────────
_ do take WebSocketClose?
    - frame Frame

do match frame.op
    |= .close
        = frame.close-code
    |= .ping
        send-frame(Frame(OpCode.pong, frame.payload))
    |= .pong
        = null
    ??
        = take-data(frame)
= null

────────────────────
_ do take-data WebSocketClose?
    - frame Frame

. started = pending
=? WebSocketClose.protocol-error if frame.op == OpCode.continuation && !started
=? WebSocketClose.protocol-error if frame.op != OpCode.continuation && started

. message = if started then started.extended(frame) else frame
=? WebSocketClose.too-big if message.payload.size > limit

pending = if message.is-fin then null else message
= if message.is-fin then deliver(message) else null

────────────────────
_ do deliver WebSocketClose?
    - message Frame

if message.op == OpCode.text
    . text = catch? decode-utf8(message.payload)
    =? WebSocketClose.invalid-data if !text
    text-incoming <- text
else
    binary-incoming <- message
= null

━━━━━━━━━━━━━━━━━━━━
+ is-websocket-request Bool
    - request HTTPRequest

request.method == HTTPMethod.get && upgrade has "websocket" && connection has "upgrade"

.. upgrade = header-tokens(request.header("Upgrade")?.lowercased ?? "")
.. connection = header-tokens(request.header("Connection")?.lowercased ?? "")

━━━━━━━━━━━━━━━━━━━━
+ websocket-protocol String?
    - request HTTPRequest
    - protocols [String]

first(each in protocols when offered has each)

.. offered = header-tokens(request.header("Sec-WebSocket-Protocol") ?? "")

━━━━━━━━━━━━━━━━━━━━
+ websocket-handshake HTTPResponse
    - request HTTPRequest
    - protocol String?

|? request.header("Sec-WebSocket-Version") != "13"
    HTTPResponse(HTTPStatus.upgrade-required, null, version-headers)
|? (catch? decode-base64(key))?.size != 16
    HTTPResponse(HTTPStatus.bad-request)
??
    HTTPResponse(HTTPStatus.switching-protocols, null, accept-headers)

.. key = request.header("Sec-WebSocket-Key") ?? ""
.. version-headers [HTTPHeader]
    * "Sec-WebSocket-Version", "13"
.. accept-headers [HTTPHeader]
    * "Upgrade", "websocket"
    * "Connection", "Upgrade"
    * "Sec-WebSocket-Accept", websocket-accept(key)
    *? ("Sec-WebSocket-Protocol", protocol) if protocol

━━━━━━━━━━━━━━━━━━━━
+ websocket-accept String
    - key String

sha1(byte-view(key ++ websocket-guid)) as Base64

━━━━━━━━━━━━━━━━━━━━
_ handshake-headers [HTTPHeader]
    - url URL
    - key String
    - protocols [String]

* "Host", host
* "Connection", "Upgrade"
* "Upgrade", "websocket"
* "Sec-WebSocket-Key", key
* "Sec-WebSocket-Version", "13"
*? ("Sec-WebSocket-Protocol", ", ".join(protocols)) if protocols.length > 0

.. host = if url.port == port-for-scheme(url.scheme) then url.host else "${url.host}:${url.port}"

━━━━━━━━━━━━━━━━━━━━
_ handshake-failure IOError?
    - handshake HTTPResponse
    - key String

|? handshake.status != HTTPStatus.switching-protocols
    IOError("WebSocket handshake failed (${handshake.status})")
|? handshake.header("Sec-WebSocket-Accept") != websocket-accept(key)
    IOError("WebSocket handshake answered with the wrong Sec-WebSocket-Accept")

━━━━━━━━━━━━━━━━━━━━
_ header-tokens [String]
    - value String

List'String(~ \header-token in value)

━━━━━━━━━━━━━━━━━━━━
_ header-token ~ Char String

~ \ws* name (!"," !\ws .)+ \ws* ","?
    name

━━━━━━━━━━━━━━━━━━━━
_ OpCode is U8

| continuation = 0
| text = 1
| binary = 2
| close = 8
| ping = 9
| pong = 10

────────────────────
+ get is-control

this >= OpCode.close

────────────────────
+ get is-known

this <= OpCode.binary || this >= OpCode.close && this <= OpCode.pong

━━━━━━━━━━━━━━━━━━━━
_ Frame is Tuple

+ op OpCode
+ is-fin = true
+ payload Byte[]
+ reserved U8 = 0
+ is-masked = false
+ length U64 = 0

────────────────────
+ This
    - op OpCode
    - payload = Byte[0]
    - is-fin = true

= This(op, is-fin, payload, 0, false, payload.size as U64)

────────────────────
+ This
    - payload Byte[]
    - op = OpCode.binary
    - is-fin = true

= This(op, is-fin, payload, 0, false, payload.size as U64)

────────────────────
+ This
    - text String
    - is-fin = true

= This(OpCode.text, Array'Byte(text), is-fin)

────────────────────
+ This
    - code WebSocketClose
    - reason String

= This(OpCode.close, payload)

.. payload = if code == WebSocketClose.no-status then Byte[0] else joined-bytes([status, Array'Byte(reason)])
.. status = Array'Byte([((code as U16) /zrshift/ 8) as Byte, (code as U16) as Byte])

────────────────────
+ to ReadableData'Byte

DataStream(payload)

────────────────────
+ get close-code WebSocketClose

match payload
    ~ code U16 .*
        code as WebSocketClose
    ??
        WebSocketClose.no-status

────────────────────
+ refusal WebSocketClose?
    - must-mask Bool
    - limit Size

|? length > (limit as U64)
    WebSocketClose.too-big
|? reserved != 0 || is-masked != must-mask || !op.is-known
    WebSocketClose.protocol-error
|? op.is-control && (!is-fin || length > control-limit)
    WebSocketClose.protocol-error

────────────────────
+ extended This
    - next This

This(op, next.is-fin, joined-bytes([payload, next.payload]))

────────────────────
+ do write-frame ?! Error
    - bytes WritableData
    - is-masked Bool

. size = payload.size
. mask-flag = if is-masked then 128u8 else 0u8

bytes <- b1 //or// b2
    .. b1 = (op as U8) /and/ 15
    .. b2 = if is-fin then 128u8 else 0u8

if size < boundary-8bit
    bytes <- short //or// mask-flag
        .. short = (size as U8) /and/ 127
else if size <= boundary-16bit
    bytes <- 126 /or/ mask-flag
    bytes <- (size as U16)
else
    bytes <- 127 /or/ mask-flag
    bytes <- (size as U64)

if is-masked
    . mask = random-bytes(4)
    bytes <- mask
    bytes <- masked
        .. masked = Array'Byte(size) • with :: index => mask-byte(mask, payload[index], index)
else
    bytes <- payload

━━━━━━━━━━━━━━━━━━━━
_ frame ~ Byte Frame
    - limit Size

~ b1 U8 b2 U8 len \length msk \mask data Byte{if len <= (limit as U64) then len else 0}
    Frame(op, is-fin, payload, b1 /and/ 0x70, is-masked, len)

    .. op = (b1 /and/ 15u8) as OpCode
    .. is-fin = (b1 /zrshift/ 7u8) != 0u8
    .. is-masked = (b2 /zrshift/ 7u8) != 0u8
    .. length8 = b2 /and/ 127u8

    .. length ~
        |? length8 == 127
            ~ size U64
                size
        |? length8 == 126
            ~ size U16
                size as U64
        ??
            ~ U8{0}
                length8 as U64

    .. mask ~
        ~ Byte{if is-masked then 4 else 0}

    .. payload
        |? is-masked
            Array'Byte(data.size) • with :: index => mask-byte(msk, data[index], index)
        ??
            Array'Byte(data)

━━━━━━━━━━━━━━━━━━━━
_ mask-byte
    - mask Indexable'Byte
    - byte Byte
    - index Index

byte /xor/ mask[index % 4]
