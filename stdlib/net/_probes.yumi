
_ network-preview-limit = 4096

━━━━━━━━━━━━━━━━━━━━
+ network-preview
    - text String

text.truncate(network-preview-limit)

━━━━━━━━━━━━━━━━━━━━
+ network-preview
    - data Byte[]
    - size Size

|? amount > 0
    data[0 .. < amount].slice-string()
??
    ""

.. available = if data.size < size then data.size else size
.. amount = if available < network-preview-limit then available else network-preview-limit

━━━━━━━━━━━━━━━━━━━━
+ network-is-truncated
    - byte-length Size

byte-length > network-preview-limit
