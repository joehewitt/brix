/netdb.h

━━━━━━━━━━━━━━━━━━━━
+ CAddrInfo is Tuple

+ family I32
+ socktype I32
+ protocol I32
+ addrlen I32
+ addr CPointer'Char8

━━━━━━━━━━━━━━━━━━━━
