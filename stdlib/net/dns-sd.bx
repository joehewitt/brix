(import ./cnet)
(import ./dns)
(import /BxCore/BxCore.h)
(import /BxEvents/BxEvents.h)
(import /core/intrinsics)
(import /dns_sd.h)
(import /errno.h)
(import /os/file)
(import /string.h)
(import /sys/socket.h)
(import /time/deadline)
(import /time/duration)

(type + ServiceAddress (is Tuple)
  (prop + host String)
  (prop + port Port)
  (prop + text-record (of Map String String))
)

(type + ServiceBrowseEvent (is Tuple)
  (prop + name String)
  (prop + type String)
  (prop + domain String)
  (prop + is-added Bool)
)

(type + ServiceDiscoveryError (is Error)
  (fn-to-expr + String
    (?? message "Service discovery failed")
  )
)

(fn-do + resolve-service ServiceAddress (?! Error)
  (param name String)
  (param type String)
  (param domain _ (= "local."))
  (param timeout Milliseconds (= 5s))
  (let resolution (call ServiceResolution))
  (let service (of CPointer I8) null)
  (let started
    (call C:DNSServiceResolve
      (block
        (arg &service)
        (arg 0)
        (arg 0)
        (arg name)
        (arg type)
        (arg domain)
        (arg (as service-resolved ServiceResolveReply))
        (arg (as resolution Pointer))
      )
    )
  )
  (throw (call ServiceDiscoveryError (str "Unable to look up " name " (" started ")")) (if (!= started 0)))
  (blank)
  (finally
    (inline (call C:DNSServiceRefDeallocate service))
  )
  (let fd (call C:DNSServiceRefSockFD service))
  (finally
    (inline (call C:brixReleaseEventDescriptor fd))
  )
  (let deadline (call Deadline timeout))
  (while (and (not (. resolution host)) (== (. resolution error) 0))
    (call wait-until-readable fd deadline
      (block
        (on-error TimeoutError
          (throw (call ServiceDiscoveryError (str name " was not found")))
        )
      )
    )
    (if (call has-reply fd)
      (let processed (call C:DNSServiceProcessResult service))
      (throw (call ServiceDiscoveryError (str "Unable to look up " name " (" processed ")")) (if (!= processed 0)))
    )
  )
  (let host (. resolution host))
  (throw (call ServiceDiscoveryError (str "Unable to look up " name " (" (. resolution error) ")")) (if (not host)))
  (return (call ServiceAddress host (. resolution port) (. resolution text-record)))
)

(fn-expr + browse-services _
  (param type String)
  (param domain _ (= "local."))
  (call ServiceBrowseStream type domain)
)

(fn-do _ has-reply Bool
  (param fd I32)
  (let peeked ([] Byte 1))
  (return-if true (if (>= (call C:recv fd peeked 1 (/or/ C:MSG_PEEK C:MSG_DONTWAIT)) 0)))
  (return (!= (call C:brixGetErrNo) C:EWOULDBLOCK))
)

(type _ ServiceResolution
  (prop + host (? String) (= null))
  (prop + port Port (= 0))
  (prop + text-record (of Map String String))
  (prop + error I32)
)

(type _ ServiceResolveReply (is (c-fn-type Void (param service (of CPointer I8)) (param flags U32) (param interface U32) (param error I32) (param full-name (of CPointer Char8)) (param host (of CPointer Char8)) (param port U16) (param record-size U16) (param record (of CPointer U8)) (param context Pointer))))

(fn-do _ service-resolved _
  (param service (of CPointer I8))
  (param flags U32)
  (param interface U32)
  (param error I32)
  (param full-name (of CPointer Char8))
  (param host (of CPointer Char8))
  (param port U16)
  (param record-size U16)
  (param record (of CPointer U8))
  (param context Pointer)
  (let resolution (call (of gc-object-from-pointer ServiceResolution) context))
  (= (. resolution error) error)
  (if (== error 0)
    (= (. resolution host) (as host String))
    (= (. resolution port) (call network-to-host port))
    (= (. resolution text-record) (call text-record-entries record record-size))
  )
)

(fn-do _ text-record-entries (of Map String String)
  (param record (of CPointer U8))
  (param size Size)
  (let bytes ([] Byte size))
  (call C:memcpy (. bytes data) record size)
  (let entries (call (of Map String String)))
  (let offset Index 0)
  (while (< offset size)
    (let start (+ offset 1))
    (let end (+ start ([] bytes offset)))
    (= offset (if-expr (< end size) end size))
    (let entry (call (. bytes slice-string) (..< start offset)))
    (let equals (call (. entry find) "="))
    (let key (if-expr equals ([] entry (..< 0 equals)) entry))
    (if (and (> (. key length) 0) (== ([] entries key) null))
      (= ([] entries key) (if-expr equals ([] entry (..< (+ equals 1) (. entry length))) ""))
    )
  )
  (return entries)
)

(type _ ServiceBrowseStream
  (implements (of Usable Void))
  (prop + type String)
  (prop + domain String)
  (blank)
  (prop _ service (of CPointer I8) (= null))
  (prop _ presence (of Map String Int))
  (blank)
  (delegate (of Broadcastable ServiceBrowseEvent))
  (prop _ channel _ (:= (call (of AsyncOnDemandChannel ServiceBrowseEvent) this)))
  (fn-do + This _
    (param type String)
    (param domain String)
  )
  (fn-do + begin-using _
    (let browsing (of CPointer I8) null)
    (let started
      (call C:DNSServiceBrowse
        (block
          (arg &browsing)
          (arg 0)
          (arg 0)
          (arg type)
          (arg domain)
          (arg (as service-browsed ServiceBrowseReply))
          (arg (as this Pointer))
        )
      )
    )
    (throw (call ServiceDiscoveryError (str "Unable to browse " type " (" started ")")) (if (!= started 0)))
    (blank)
    (= service browsing)
    (let fd (call C:DNSServiceRefSockFD browsing))
    (do-new
      (finally
        (inline (call C:DNSServiceRefDeallocate browsing))
      )
      (while (== service browsing)
        (call wait-until-readable fd)
        (if (and (== service browsing) (call has-reply fd) (!= (call C:DNSServiceProcessResult browsing) 0))
          (= service null)
          (call C:brixReleaseEventDescriptor fd)
          (call (. channel close))
        )
      )
    )
  )
  (fn-do + end-using _
    (let browsing service)
    (return-if (if (not browsing)))
    (blank)
    (= service null)
    (= presence (call (of Map String Int)))
    (call C:brixReleaseEventDescriptor (call C:DNSServiceRefSockFD browsing))
  )
  (fn-do _ found _
    (param event ServiceBrowseEvent)
    (let key (str (. event name) "." (. event type) (. event domain)))
    (let before (?? ([] presence key) 0))
    (let after (if-expr (. event is-added) (+ before 1) (- before 1)))
    (return-if (if (< after 0)))
    (blank)
    (= ([] presence key) after)
    (if (!= (== before 0) (== after 0))
      (<- channel event)
    )
  )
)

(type _ ServiceBrowseReply (is (c-fn-type Void (param service (of CPointer I8)) (param flags U32) (param interface U32) (param error I32) (param name (of CPointer Char8)) (param type (of CPointer Char8)) (param domain (of CPointer Char8)) (param context Pointer))))

(fn-do _ service-browsed _
  (param service (of CPointer I8))
  (param flags U32)
  (param interface U32)
  (param error I32)
  (param name (of CPointer Char8))
  (param type (of CPointer Char8))
  (param domain (of CPointer Char8))
  (param context Pointer)
  (return-if (if (!= error 0)))
  (blank)
  (let stream (call (of gc-object-from-pointer ServiceBrowseStream) context))
  (let is-added (!= (/and/ flags C:kDNSServiceFlagsAdd) 0))
  (call (. stream found) (call ServiceBrowseEvent (as name String) (as type String) (as domain String) is-added))
)
