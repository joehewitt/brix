(import /core/tokenstream)
(import /data)
(import /math)
(import /net/http)
(import /net/socket)
(import /net/url)
(import /net/websocket)
(import /time/duration)

(type + MemorySocket
  (implements (of Socket Byte))
  (prop _ data ([] Byte))
  (prop _ cursor Size (= 0))
  (fn-do + This _
    (param data ([] Byte))
  )
  (fn-do + read Size
    (param size Size)
    (param buffer ([] Byte))
    (let count (call min size (- (. data size) cursor)))
    (= ([] buffer (..< 0 count)) ([] data (..< cursor (+ cursor count))))
    (+= cursor count)
    (return count)
  )
  (fn-do + write Size
    (param buffer (of ImmutableArray Byte))
    (param size Size)
    (return size)
  )
  (fn-do + close _
  )
)

(fn-do + masked-frames ([] Byte)
  (param messages Size)
  (param fragments Size)
  (param fragment-size Size)
  (let frame-size (+ fragment-size 8))
  (let bytes ([] Byte (* messages fragments frame-size)))
  (let offset Size 0)
  (for (in message (..< 0 messages))
    (for (in fragment (..< 0 fragments))
      (let op (if-expr (== fragment 0) 1u8 0u8))
      (let fin (if-expr (== fragment (- fragments 1)) 128u8 0u8))
      (= ([] bytes offset) (/or/ op fin))
      (= ([] bytes (+ offset 1)) 254)
      (= ([] bytes (+ offset 2)) (as (/zrshift/ fragment-size 8) Byte))
      (= ([] bytes (+ offset 3)) (as fragment-size Byte))
      (for (in index (..< 0 fragment-size))
        (= ([] bytes (+ offset 8 index)) (as (+ 97 (% (+ message fragment index) 26)) Byte))
      )
      (+= offset frame-size)
    )
  )
  (return bytes)
)

(fn-do + received-checksum Int
  (param input ([] Byte))
  (let socket (call MemorySocket input))
  (let request (call HTTPRequest (. HTTPMethod get) (call URL "http://localhost/")))
  (let stream (call (of ChunkedTokenStream Byte) socket))
  (let websocket (call WebSocket request null stream socket socket 3600s))
  (let checksum 0)
  (for (in message (as websocket (of Iterable String)))
    (= checksum (% (+ (* checksum 31) (. message size) (as ([] message 0) Int) (as ([] message (- (. message length) 1)) Int)) 1000000007))
  )
  (return checksum)
)
