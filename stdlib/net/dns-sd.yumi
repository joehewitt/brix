╌╌╌╌╌╌╌╌╌╌ is Error ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ to String

message ?? "Service discovery failed"

━━━━━━━━━━━━━━━━━━━━
+ do resolve-service ServiceAddress ?! Error
    - name String
    - type String
    - domain = "local."
    - timeout Milliseconds = 5s

. resolution = ServiceResolution()
. service CPointer'I8 = null
. started = C:DNSServiceResolve
    - &service
    - 0
    - 0
    - name
    - type
    - domain
    - service-resolved as ServiceResolveReply
    - resolution as Pointer
?! ServiceDiscoveryError("Unable to look up $name ($started)")
    if started != 0
do finally C:DNSServiceRefDeallocate(service)
. fd = C:DNSServiceRefSockFD(service)
do finally C:yumiReleaseEventDescriptor(fd)
. deadline = Deadline(timeout)
while !resolution.host && resolution.error == 0
    wait-until-readable(fd, deadline)
        catch TimeoutError
            ?! ServiceDiscoveryError("$name was not found")
    if has-reply(fd)
        . processed = C:DNSServiceProcessResult(service)
        ?! ServiceDiscoveryError("Unable to look up $name ($processed)")
            if processed != 0
. host = resolution.host
?! ServiceDiscoveryError("Unable to look up $name (${resolution.error})")
    if !host
= ServiceAddress(host, resolution.port, resolution.text-record)

━━━━━━━━━━━━━━━━━━━━
+ browse-services
    - type String
    - domain = "local."

ServiceBrowseStream(type, domain)

━━━━━━━━━━━━━━━━━━━━
_ do has-reply Bool
    - fd I32

. peeked = Byte[1]
=? true if C:recv(fd, peeked, 1, C:MSG_PEEK /or/ C:MSG_DONTWAIT) >= 0
= C:yumiGetErrNo() != C:EWOULDBLOCK

━━━━━━━━━━━━━━━━━━━━
_ ServiceResolution

+ host String? = null
+ port Port = 0
+ text-record Map'String'String
+ error I32

━━━━━━━━━━━━━━━━━━━━
_ ServiceResolveReply is (*C) Void
    - service CPointer'I8
    - flags U32
    - interface U32
    - error I32
    - full-name CPointer'Char8
    - host CPointer'Char8
    - port U16
    - record-size U16
    - record CPointer'U8
    - context Pointer

━━━━━━━━━━━━━━━━━━━━
_ do service-resolved
    - service CPointer'I8
    - flags U32
    - interface U32
    - error I32
    - full-name CPointer'Char8
    - host CPointer'Char8
    - port U16
    - record-size U16
    - record CPointer'U8
    - context Pointer

. resolution = gc-object-from-pointer'ServiceResolution(context)
resolution.error = error
if error == 0
    resolution.host = host as String
    resolution.port = network-to-host(port)
    resolution.text-record = text-record-entries(record, record-size)

━━━━━━━━━━━━━━━━━━━━
_ do text-record-entries Map'String'String
    - record CPointer'U8
    - size Size

. bytes = Byte[size]
C:memcpy(bytes.data, record, size)
. entries = Map'String'String()
. offset Index = 0
while offset < size
    . start = offset + 1
    . end = start + bytes[offset]
    offset = if end < size then end else size
    . entry = bytes.slice-string(start .. < offset)
    . equals = entry.find("=")
    . key = if equals then entry[0 .. < equals] else entry
    if key.length > 0 && entries[key] == null
        entries[key] = if equals then entry[equals + 1 .. < entry.length] else ""
= entries

━━━━━━━━━━━━━━━━━━━━
_ ServiceBrowseStream
    is Usable'Void

+ type String
+ domain String

_ service CPointer'I8 = null
_ presence Map'String'Int

as Broadcastable'ServiceBrowseEvent for
_ channel := AsyncOnDemandChannel'ServiceBrowseEvent(this)

────────────────────
+ This
    - type String
    - domain String

────────────────────
+ do begin-using

. browsing CPointer'I8 = null
. started = C:DNSServiceBrowse
    - &browsing
    - 0
    - 0
    - type
    - domain
    - service-browsed as ServiceBrowseReply
    - this as Pointer
?! ServiceDiscoveryError("Unable to browse $type ($started)")
    if started != 0
service = browsing
. fd = C:DNSServiceRefSockFD(browsing)
do new
    do finally C:DNSServiceRefDeallocate(browsing)
    while service == browsing
        wait-until-readable(fd)
        if service == browsing && has-reply(fd) && C:DNSServiceProcessResult(browsing) != 0
            service = null
            C:yumiReleaseEventDescriptor(fd)
            channel.close()

────────────────────
+ do end-using

. browsing = service
=? if !browsing
service = null
presence = Map'String'Int()
C:yumiReleaseEventDescriptor(C:DNSServiceRefSockFD(browsing))

────────────────────
_ do found
    - event ServiceBrowseEvent

. key = "${event.name}.${event.type}${event.domain}"
. before = presence[key] ?? 0
. after = if event.is-added then before + 1 else before - 1
=? if after < 0
presence[key] = after
if (before == 0) != (after == 0)
    channel <- event

━━━━━━━━━━━━━━━━━━━━
_ ServiceBrowseReply is (*C) Void
    - service CPointer'I8
    - flags U32
    - interface U32
    - error I32
    - name CPointer'Char8
    - type CPointer'Char8
    - domain CPointer'Char8
    - context Pointer

━━━━━━━━━━━━━━━━━━━━
_ do service-browsed
    - service CPointer'I8
    - flags U32
    - interface U32
    - error I32
    - name CPointer'Char8
    - type CPointer'Char8
    - domain CPointer'Char8
    - context Pointer

=? if error != 0
. stream = gc-object-from-pointer'ServiceBrowseStream(context)
. is-added = flags /and/ C:kDNSServiceFlagsAdd != 0
stream.found(ServiceBrowseEvent(name as String, type as String, domain as String, is-added))
