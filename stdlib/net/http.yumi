_ http-transfer-size Size = 4096
_ http-line-limit Size = 4096

━━━━━━━━━━━━━━━━━━━━
+ HTTPMethod is Union

| get
| head
| post
| put
| patch
| delete
| options
| other(name String)

────────────────────
+ to String

match this
    | .get
        "GET"
    | .head
        "HEAD"
    | .post
        "POST"
    | .put
        "PUT"
    | .patch
        "PATCH"
    | .delete
        "DELETE"
    | .options
        "OPTIONS"
    | .other(name)
        name

━━━━━━━━━━━━━━━━━━━━
+ HTTPStatus is I32

| switching-protocols = 101
| ok = 200
| created = 201
| accepted = 202
| no-content = 204
| moved-permanently = 301
| found = 302
| see-other = 303
| not-modified = 304
| temporary-redirect = 307
| permanent-redirect = 308
| bad-request = 400
| unauthorized = 401
| forbidden = 403
| not-found = 404
| method-not-allowed = 405
| not-acceptable = 406
| request-timeout = 408
| conflict = 409
| gone = 410
| length-required = 411
| content-too-large = 413
| uri-too-long = 414
| unsupported-media-type = 415
| unprocessable-content = 422
| upgrade-required = 426
| too-many-requests = 429
| request-header-fields-too-large = 431
| internal-server-error = 500
| not-implemented = 501
| bad-gateway = 502
| service-unavailable = 503
| gateway-timeout = 504
| http-version-not-supported = 505

────────────────────
+ get reason

match this
    |= .switching-protocols
        "Switching Protocols"
    |= .ok
        "OK"
    |= .created
        "Created"
    |= .accepted
        "Accepted"
    |= .no-content
        "No Content"
    |= .moved-permanently
        "Moved Permanently"
    |= .found
        "Found"
    |= .see-other
        "See Other"
    |= .not-modified
        "Not Modified"
    |= .temporary-redirect
        "Temporary Redirect"
    |= .permanent-redirect
        "Permanent Redirect"
    |= .bad-request
        "Bad Request"
    |= .unauthorized
        "Unauthorized"
    |= .forbidden
        "Forbidden"
    |= .not-found
        "Not Found"
    |= .method-not-allowed
        "Method Not Allowed"
    |= .not-acceptable
        "Not Acceptable"
    |= .request-timeout
        "Request Timeout"
    |= .conflict
        "Conflict"
    |= .gone
        "Gone"
    |= .length-required
        "Length Required"
    |= .content-too-large
        "Content Too Large"
    |= .uri-too-long
        "URI Too Long"
    |= .unsupported-media-type
        "Unsupported Media Type"
    |= .unprocessable-content
        "Unprocessable Content"
    |= .upgrade-required
        "Upgrade Required"
    |= .too-many-requests
        "Too Many Requests"
    |= .request-header-fields-too-large
        "Request Header Fields Too Large"
    |= .internal-server-error
        "Internal Server Error"
    |= .not-implemented
        "Not Implemented"
    |= .bad-gateway
        "Bad Gateway"
    |= .service-unavailable
        "Service Unavailable"
    |= .gateway-timeout
        "Gateway Timeout"
    |= .http-version-not-supported
        "HTTP Version Not Supported"
    ??
        ""

────────────────────
+ get has-body

!(this >= 100 && this < 200) && this != HTTPStatus.no-content && this != HTTPStatus.not-modified

━━━━━━━━━━━━━━━━━━━━
+ HTTPHeader is (name String, value String)

────────────────────
+ This ~ Char

~ name (!(":" | \nl) .)+ ":" / value (!\nl .)*
    This(name, value.trim())

────────────────────
+ to String

"$name: $value"

━━━━━━━━━━━━━━━━━━━━
+ HTTPBody is Union

| Null
| String
| Byte[]
| ReadableData'Byte
| Iterable'ServerSentEvent

━━━━━━━━━━━━━━━━━━━━
+ HTTPRequest

+ method HTTPMethod
+ target String
+ headers [HTTPHeader]
+ body HTTPBody
+ version = "HTTP/1.1"
+ url URL?
+ route Route?
+ params [String = String]

────────────────────
+ This
    - method HTTPMethod
    - url URL
    - headers [HTTPHeader] = List'HTTPHeader()
    - body HTTPBody = null

.. target = http-target(url)

────────────────────
+ This
    - method HTTPMethod
    - target String
    - headers [HTTPHeader]
    - body HTTPBody
    - version String

────────────────────
+ get start-line

"$method $target $version"

────────────────────
+ get path

|? target.find("?")
    target[0 .. < it!]
??
    target

────────────────────
+ get query String?

|? target.find("?")
    target[it! + 1 ...]

────────────────────
+ get paths [String]

** each in path.split("/") when each.length > 0

────────────────────
+ do get text String

= http-body-text(body)

────────────────────
+ do get reader ReadableData'Byte

= http-body-reader(body)

────────────────────
+ header String?
    - name String

http-header(headers, name)

━━━━━━━━━━━━━━━━━━━━
+ HTTPResponse
    is Closable

+ status HTTPStatus
+ headers [HTTPHeader]
+ body HTTPBody
+ version = "HTTP/1.1"

────────────────────
+ This
    - status HTTPStatus = HTTPStatus.ok
    - body HTTPBody = null
    - headers [HTTPHeader] = List'HTTPHeader()

────────────────────
+ This
    - status HTTPStatus
    - body HTTPBody
    - headers [HTTPHeader]
    - version String

────────────────────
+ from status HTTPStatus

This(status)

────────────────────
+ from text String

This(HTTPStatus.ok, text)

────────────────────
+ from data Byte[]

This(HTTPStatus.ok, data)

────────────────────
+ from events Iterable'ServerSentEvent

This(HTTPStatus.ok, events)

────────────────────
+ from json JSON

This(HTTPStatus.ok, to-json(json), headers)

.. headers [HTTPHeader]
    * "Content-Type", "application/json"

────────────────────
+ do close ?! Error

do match? body
    | reader HTTPBodyReader
        reader.close()

────────────────────
+ get start-line

"$version $status ${status.reason}"

────────────────────
+ do get text String

= http-body-text(body)

────────────────────
+ do get reader ReadableData'Byte

= http-body-reader(body)

────────────────────
+ header String?
    - name String

http-header(headers, name)

━━━━━━━━━━━━━━━━━━━━
+ HTTPStatusLine is (version String, status HTTPStatus, reason String)

────────────────────
+ This ~ Char

~ version (!" " .)+ // status HTTPStatus / reason (!\nl .)*
    This(version, status, reason)

━━━━━━━━━━━━━━━━━━━━
+ HTTPRequestLine is (method HTTPMethod, target String, version String)

────────────────────
+ This ~ Char

~ method (!" " .)+ // target (!" " .)+ // version (!\nl .)+
    This(http-method(method), target, version)

━━━━━━━━━━━━━━━━━━━━
+ HTTPFraming is Union

| length(size Size)
| chunked
| until-close

━━━━━━━━━━━━━━━━━━━━
+ HTTPBodyReader
    is ReadableData'Byte
    is Closable

+ framing HTTPFraming

_ stream ChunkedTokenStream'Byte
_ owner Closable?
_ limit Size
_ consumed Size
_ remaining Size
_ needs-chunk-end = false
_ is-done = false

────────────────────
+ This
    - stream ChunkedTokenStream'Byte
    - framing HTTPFraming
    - owner Closable? = null
    - limit = Size.max

do match? framing
    | .length(size)
        remaining = size
        is-done = size == 0

────────────────────
+ do close ?! Error

is-done = true
owner?.close()

────────────────────
+ get is-complete

is-done

────────────────────
+ get is-encoded

false

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

=? 0 if is-done || size == 0

. count = read-framed(size, buffer)
//this:network.http.response.body.chunk -> "", count, network-preview(buffer, count), network-is-truncated(count)
if is-done
    //this:network.http.response.end -> 0
= count

────────────────────
+ do drain

. buffer = Byte[http-transfer-size]
while !is-done
    . count = read(buffer.size, buffer)
    if count == 0
        break

────────────────────
_ do read-framed Size
    - size Size
    - buffer Byte[]

do match framing
    | .until-close
        . count = stream.read(size, buffer) • should read-once
        ?! stream.failure
            if count == 0 && stream.failure
        ?! SizeLimitError("HTTP body too large")
            if count > limit - consumed
        consumed += count
        is-done = count == 0
        = count
    | .length(total)
        ?! SizeLimitError("HTTP body too large")
            if total > limit
        . wanted = if remaining < size then remaining else size
        . count = stream.read(wanted, buffer) • should read-once
        ?! stream.failure ?? IOError("Incomplete HTTP body")
            if count == 0
        remaining -= count
        is-done = remaining == 0
        = count
    | .chunked
        if remaining == 0 && !next-chunk()
            = 0
        . wanted = if remaining < size then remaining else size
        . count = stream.read(wanted, buffer) • should read-once
        ?! stream.failure ?? IOError("Incomplete HTTP chunk")
            if count == 0
        remaining -= count
        = count

────────────────────
_ do next-chunk Bool

if needs-chunk-end
    stream.read("\r\n") • limit http-line-limit
    needs-chunk-end = false

. line = (stream.read("\r\n") • limit http-line-limit) ?? ""
. chunk-size = parse-chunk-size(chunk-size-text(line))
if chunk-size == 0
    skip-trailers()
    is-done = true
    = false

?! SizeLimitError("HTTP body too large")
    if chunk-size > limit - consumed
consumed += chunk-size
remaining = chunk-size
needs-chunk-end = true
= true

────────────────────
_ do skip-trailers

while true
    . line = (stream.read("\r\n") • limit http-line-limit) ?? ""
    =? if line.length == 0
    ?! SizeLimitError("HTTP trailers too large")
        if line.length > limit - consumed
    consumed += line.length

━━━━━━━━━━━━━━━━━━━━
+ do http-send HTTPResponse ?! Error
    - request HTTPRequest

. url = request.url
?! Error("HTTP request has no URL")
    if !url
. socket = Socket'Byte(url.host, url.port, url.is-secure())
. is-sent = false
do finally
    if !is-sent
        socket.close()

. outgoing-headers = http-request-headers(request)
//request:network.http.request.start -> "", "$request.method", "$url", url.host, url.port, request.target
//request:network.http.request.headers -> request-headers
    .. request-headers = "\n".join("$each" in outgoing-headers)
//request:network.http.request.body -> content-type, size, network-preview(preview), network-is-truncated(size)
    .. content-type = http-header(outgoing-headers, "Content-Type") ?? ""
    .. size = http-body-size(request.body) ?? 0
    .. preview = if request.body is String then request.body as String else ""

write-http-message(socket, request.start-line, outgoing-headers, request.body)
//request:network.http.request.sent -> http-body-size(request.body) ?? 0

. stream = ChunkedTokenStream'Byte(socket)
. response = read-http-response(stream, socket, request.method == HTTPMethod.head)
is-sent = true

//request:network.http.response.start -> response.version, response.status, ""
//request:network.http.response.headers -> response-headers
    .. response-headers = "\n".join("$each" in response.headers)

= response

━━━━━━━━━━━━━━━━━━━━
+ do http-fetch HTTPResponse ?! Error
    - request HTTPRequest

. response = use http-send(request)
. data = http-body-bytes(response.body)
= HTTPResponse(response.status, data, response.headers, response.version)

━━━━━━━━━━━━━━━━━━━━
+ http-get HTTPResponse ?! Error
    - url URL
    - headers [HTTPHeader] = List'HTTPHeader()

http-fetch(HTTPRequest(HTTPMethod.get, url, headers))

━━━━━━━━━━━━━━━━━━━━
+ http-post HTTPResponse ?! Error
    - url URL
    - body HTTPBody
    - headers [HTTPHeader] = List'HTTPHeader()

http-fetch(HTTPRequest(HTTPMethod.post, url, headers, body))

━━━━━━━━━━━━━━━━━━━━
+ do read-http-response HTTPResponse ?! Error
    - stream ChunkedTokenStream'Byte
    - owner Closable? = null
    - is-head-request = false

. text = stream.read("\r\n\r\n")
?! IOError("No HTTP response")
    if !text
. head = match text
    ~ HTTPResponseHead
    ?! SyntaxError("Invalid HTTP response")

. framing = http-response-framing(head.line.status, head.headers, is-head-request)
. reader = HTTPBodyReader(stream, framing, owner)
= HTTPResponse(head.line.status, reader, head.headers, head.line.version)

━━━━━━━━━━━━━━━━━━━━
+ do read-http-request HTTPRequest? ?! Error
    - stream ChunkedTokenStream'Byte
    - head-limit = Size.max
    - body-limit = Size.max

. text = stream.read("\r\n\r\n") • limit head-limit
=? null if !text
. head = match text
    ~ HTTPRequestHead
    ?! SyntaxError("Invalid HTTP request")

. framing = http-request-framing(head.headers)
. reader = HTTPBodyReader(stream, framing, null, body-limit)
= HTTPRequest(head.line.method, head.line.target, head.headers, reader, head.line.version)

━━━━━━━━━━━━━━━━━━━━
+ do write-http-message ?! Error
    - output WritableData
    - start-line String
    - headers [HTTPHeader]
    - body HTTPBody

output <- http-head-text(start-line, headers)

. is-chunked = http-is-chunked(headers)
do match? body
    | text String
        output <- text
    | data Byte[]
        output <- data
    | source ReadableData'Byte
        . buffer = Byte[http-transfer-size]
        while true
            . count = source.read(buffer.size, buffer)
            if count == 0
                break
            write-http-chunk(output, buffer, count, is-chunked)
        if is-chunked
            output <- "0\r\n\r\n"
    | events Iterable'ServerSentEvent
        for event in events
            . data = byte-view("$event")
            write-http-chunk(output, data, data.size, is-chunked)
        if is-chunked
            output <- "0\r\n\r\n"

━━━━━━━━━━━━━━━━━━━━
+ http-header String?
    - headers [HTTPHeader]
    - name String

header?.value

.. header = first(each in headers when each.name.lowercased == target)
    .. target = name.lowercased

━━━━━━━━━━━━━━━━━━━━
+ http-method HTTPMethod
    - name String

match name
    | "GET"
        HTTPMethod.get
    | "HEAD"
        HTTPMethod.head
    | "POST"
        HTTPMethod.post
    | "PUT"
        HTTPMethod.put
    | "PATCH"
        HTTPMethod.patch
    | "DELETE"
        HTTPMethod.delete
    | "OPTIONS"
        HTTPMethod.options
    ??
        HTTPMethod.other(name)

━━━━━━━━━━━━━━━━━━━━
+ http-body-size Size?
    - body HTTPBody

match? body
    | Null
        0
    | text String
        text.size
    | data Byte[]
        data.size

━━━━━━━━━━━━━━━━━━━━
+ do http-body-bytes Byte[] ?! Error
    - body HTTPBody

= match body
    | Null
        Byte[0]
    | text String
        Array'Byte(text)
    | data Byte[]
        data
    | source ReadableData'Byte
        source as Byte[]
    | events Iterable'ServerSentEvent
        Array'Byte("".join("$each" in events))

━━━━━━━━━━━━━━━━━━━━
+ do http-body-reader ReadableData'Byte ?! Error
    - body HTTPBody

= match body
    | source ReadableData'Byte
        source
    ??
        DataStream'Byte(http-body-bytes(body))

━━━━━━━━━━━━━━━━━━━━
+ do http-body-text String ?! Error
    - body HTTPBody

= match body
    | text String
        text
    ??
        http-body-bytes(body).slice-string()

━━━━━━━━━━━━━━━━━━━━
_ HTTPResponseHead is (line HTTPStatusLine, headers [HTTPHeader])

────────────────────
+ This ~ Char

~ line HTTPStatusLine \nl headers \delimited(~ \nl, ~ HTTPHeader)
    This(line, headers)
~ line HTTPStatusLine
    This(line, List'HTTPHeader())

━━━━━━━━━━━━━━━━━━━━
_ HTTPRequestHead is (line HTTPRequestLine, headers [HTTPHeader])

────────────────────
+ This ~ Char

~ line HTTPRequestLine \nl headers \delimited(~ \nl, ~ HTTPHeader)
    This(line, headers)
~ line HTTPRequestLine
    This(line, List'HTTPHeader())

━━━━━━━━━━━━━━━━━━━━
_ http-head-text
    - start-line String
    - headers [HTTPHeader]

"\r\n".join(lines)

.. lines
    * start-line
    ** "$each" in headers
    * ""
    * ""

━━━━━━━━━━━━━━━━━━━━
_ http-target
    - url URL

"/$paths$searcher"

.. paths = "/".join(url.paths)
.. searcher = if url.search then "?${url.search}" else ""

━━━━━━━━━━━━━━━━━━━━
_ http-request-headers [HTTPHeader]
    - request HTTPRequest

** request.headers
*? ("Content-Length", "${size}") if has-body && size != null
*? ("Transfer-Encoding", "chunked") if has-body && size == null
* "Connection", "close"
* "User-Agent", "Brix HTTP"
* "Accept-Language", "en"
* "Host", request.url?.host ?? ""
|> distinct • where each.name.lowercased
|> List

.. size = http-body-size(request.body)
.. has-body = request.body is not Null

━━━━━━━━━━━━━━━━━━━━
_ http-response-framing HTTPFraming
    - status HTTPStatus
    - headers [HTTPHeader]
    - is-head-request Bool

|? is-head-request || !status.has-body
    HTTPFraming.length(0)
|? http-is-chunked(headers)
    HTTPFraming.chunked
|? http-header(headers, "Content-Length")
    HTTPFraming.length(it! as Size)
??
    HTTPFraming.until-close

━━━━━━━━━━━━━━━━━━━━
_ http-request-framing HTTPFraming ?! Error
    - headers [HTTPHeader]

?! SyntaxError("A request may not have both Transfer-Encoding and Content-Length")
    if transfer && lengths.length > 0
?! SyntaxError("A request may not have more than one Content-Length")
    if lengths.length > 1
?! SyntaxError("Unsupported Transfer-Encoding: ${transfer}")
    if transfer && transfer.trim().lowercased != "chunked"

|? transfer
    HTTPFraming.chunked
|? lengths.length == 0
    HTTPFraming.length(0)
??
    HTTPFraming.length(http-content-length(lengths[0]))

.. transfer = http-header(headers, "Transfer-Encoding")
.. lengths = List'String
    ** each.value in headers when each.name.lowercased == "content-length"

━━━━━━━━━━━━━━━━━━━━
_ http-content-length Size ?! Error
    - text String

match text.trim()
    ~ [0-9]{1, 18} !.
        it as Size
    ?! SyntaxError("Invalid Content-Length: $text")

━━━━━━━━━━━━━━━━━━━━
_ http-is-chunked
    - headers [HTTPHeader]

if transfer?.lowercased.find("chunked") then true else false

.. transfer = http-header(headers, "Transfer-Encoding")

━━━━━━━━━━━━━━━━━━━━
_ do write-http-chunk
    - output WritableData
    - data ImmutableArray'Byte
    - size Size
    - is-chunked Bool

if is-chunked
    output <- "${chunk-size-digits(size)}\r\n"
output.write(data, size)
if is-chunked
    output <- "\r\n"

━━━━━━━━━━━━━━━━━━━━
_ do chunk-size-digits String
    - size Size

. digits = (size as Hex)[2 ...]
. start Index = 0
while start < digits.length - 1 && digits[start] == '0'
    start += 1
= digits[start ...]

━━━━━━━━━━━━━━━━━━━━
_ chunk-size-text
    - line String

|? line.find(";")
    line[0 .. < it!].trim()
??
    line.trim()

━━━━━━━━━━━━━━━━━━━━
_ parse-chunk-size
    - text String

match text
    ~ \hex'U32
    ?! SyntaxError("Invalid chunk size")
