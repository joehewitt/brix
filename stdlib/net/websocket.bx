(import ./http)
(import ./probes)
(import ./socket)
(import ./url)
(import /core/stream)
(import /core/tokenstream)
(import /crypto/bytes)
(import /crypto/digest)
(import /crypto/random)
(import /data)
(import /data/stream)
(import /stream/aggregate)
(import /time/duration)
(blank)
(prop + websocket-message-limit Size (= 0x1000000))
(prop + websocket-close-timeout Seconds (= 5s))
(blank)
(prop _ websocket-guid _ (= "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
(prop _ boundary-8bit _ (= 126))
(prop _ boundary-16bit _ (= 65535))
(prop _ control-limit U64 (= 125))
(prop _ unread-message-cost Size (= 64))

(type + WebSocketHandler (is (fn-type Void (?! Error) (param socket WebSocket))))

(type + WebSocketClose (is U16)
  (variant normal (= 1000))
  (variant going-away (= 1001))
  (variant protocol-error (= 1002))
  (variant unsupported-data (= 1003))
  (variant no-status (= 1005))
  (variant invalid-data (= 1007))
  (variant policy-violation (= 1008))
  (variant too-big (= 1009))
  (variant internal-error (= 1011))
)

(type + WebSocket
  (implements Closable)
  (implements (of Writable String))
  (implements (of Writable ([] Byte)))
  (prop + request HTTPRequest)
  (prop + protocol (? String))
  (blank)
  (prop _ socket (of Socket Byte))
  (prop _ output WritableData)
  (prop _ limit Size)
  (prop _ is-client _ (= false))
  (prop _ is-closing _ (= false))
  (prop _ is-heard _ (= true))
  (prop _ pending (? Frame))
  (prop _ sender Task)
  (prop _ receiver Task)
  (prop _ keeper (? Task))
  (prop _ outgoing _ (= (call (of SyncBufferedChannel Frame))))
  (blank)
  (prop _ unread WebSocketBudget)
  (delegate (of Iterable ReadableData))
  (prop _ binary-incoming (of WebSocketInbox Frame))
  (delegate (of Iterable String))
  (prop _ text-incoming (of WebSocketInbox String))
  (fn-do + This _ (?! Error)
    (param url URL)
    (param protocols (list String) (= (call (of List String))))
    (param limit _ (= websocket-message-limit))
    (let key (as (call random-bytes 16) Base64))
    (= request (call HTTPRequest (. HTTPMethod get) url (call handshake-headers url key protocols)))
    (= is-client true)
    (blank)
    (probe-log (: this network.web.socket.open.start) (items: "" (str url) (. url host) (. url port) (. request target)))
    (blank)
    (= socket (call (of Socket Byte) (. url host) (. url port) (call (. url is-secure))))
    (= output socket)
    (call write-http-message socket (. request start-line) (. request headers) null)
    (blank)
    (let stream (call (of ChunkedTokenStream Byte) socket))
    (let handshake (call read-http-response stream))
    (probe-log (: this network.web.socket.handshake) (items: request-headers (. handshake status) response-headers)
      (block
        (lazy request-headers (call (. "\n" join) (in (str each) (. request headers))))
        (lazy response-headers (call (. "\n" join) (in (str each) (. handshake headers))))
      )
    )
    (blank)
    (let failure (call handshake-failure handshake key))
    (if failure
      (catch (call (. socket close)))
      (throw failure)
    )
    (blank)
    (= protocol (call (. handshake header) "Sec-WebSocket-Protocol"))
    (probe-log (: this network.web.socket.open) (items: ""))
    (blank)
    (call open-inboxes)
    (= sender
      (do-new
        (inline (call send-frames))
      )
    )
    (= receiver
      (do-new
        (inline (call receive-frames stream))
      )
    )
  )
  (fn-do + This _
    (param request HTTPRequest)
    (param protocol (? String))
    (param stream (of ChunkedTokenStream Byte))
    (param socket (of Socket Byte))
    (param output WritableData)
    (param ping-interval Seconds)
    (param limit _ (= websocket-message-limit))
    (call open-inboxes)
    (= sender
      (do-new
        (inline (call send-frames))
      )
    )
    (= receiver
      (do-new
        (inline (call receive-frames stream))
      )
    )
    (= keeper
      (do-new
        (inline (call keep-alive ping-interval))
      )
    )
  )
  (fn-expr + is-open _ :get
    (and (not is-closing) (not (. receiver is-finished)))
  )
  (fn-do + send _
    (param text String)
    (call send-frame (call Frame text))
  )
  (fn-do + send _
    (param data ([] Byte))
    (call send-frame (call Frame data))
  )
  (fn-do + (infix this <- (param text String)) _
    (call send text)
  )
  (fn-do + (infix this <- (param data ([] Byte))) _
    (call send data)
  )
  (fn-do + send-ping _
    (param data _ (= ([] Byte 0)))
    (call send-frame (call Frame (. OpCode ping) data))
  )
  (fn-do + close _
    (call close (. WebSocketClose normal))
  )
  (fn-do + close _
    (param code WebSocketClose)
    (param reason _ (= ""))
    (call begin-closing code reason)
    (let watchdog
      (do-new
        (inline (call stop-receiving-after websocket-close-timeout))
      )
    )
    (call (. receiver wait))
    (call (. watchdog cancel))
    (call (. sender wait))
  )
  (fn-do _ open-inboxes _
    (= unread (call WebSocketBudget limit))
    (= binary-incoming (call (of WebSocketInbox Frame) unread))
    (= text-incoming (call (of WebSocketInbox String) unread))
  )
  (fn-do _ send-frame _
    (param frame Frame)
    (return-if (if is-closing))
    (<- outgoing frame)
  )
  (fn-do _ begin-closing _
    (param code WebSocketClose)
    (param reason _ (= ""))
    (return-if (if is-closing))
    (<- outgoing (call Frame code reason))
    (= is-closing true)
  )
  (fn-do _ stop-receiving-after _
    (param delay Seconds)
    (call (. delay wait))
    (call (. receiver cancel))
  )
  (fn-do _ keep-alive _
    (param interval Seconds)
    (while true
      (call (. interval wait))
      (if (not is-heard)
        (call (. receiver cancel))
        (return)
      )
      (= is-heard false)
      (call send-ping)
    )
  )
  (fn-do _ send-frames _
    (finally
      (call (. outgoing close))
      (catch (call (. socket close)))
    )
    (catch (call write-frames))
  )
  (fn-do _ write-frames _ (?! Error)
    (for (in frame outgoing)
      (call (. frame write-frame) output is-client)
      (probe-log (: this network.web.socket.frame.sent) (items: (. frame op) (. frame is-fin) (. frame payload size) (call network-preview (. frame payload) (. frame payload size)) (call network-is-truncated (. frame payload size))))
    )
  )
  (fn-do _ receive-frames _
    (param stream (of ChunkedTokenStream Byte))
    (finally
      (call (?. keeper cancel))
      (call (. text-incoming close))
      (call (. binary-incoming close))
      (call (. outgoing close))
    )
    (catch (call read-frames stream))
  )
  (fn-do _ read-frames _ (?! Error)
    (param stream (of ChunkedTokenStream Byte))
    (for (in frame (~> stream (call \frame limit)))
      (= is-heard true)
      (probe-log (: this network.web.socket.frame.received) (items: (. frame op) (. frame is-fin) (. frame payload size) (call network-preview (. frame payload) (. frame payload size)) (call network-is-truncated (. frame payload size))))
      (let ending (?? (call (. frame refusal) (not is-client) limit) (call take frame)))
      (if ending
        (call begin-closing ending)
        (return)
      )
    )
  )
  (fn-do _ take (? WebSocketClose)
    (param frame Frame)
    (match (. frame op)
      (case= .close
        (return (. frame close-code))
      )
      (case= .ping
        (call send-frame (call Frame (. OpCode pong) (. frame payload)))
      )
      (case= .pong
        (return null)
      )
      (default
        (return (call take-data frame))
      )
    )
    (return null)
  )
  (fn-do _ take-data (? WebSocketClose)
    (param frame Frame)
    (let started pending)
    (return-if (. WebSocketClose protocol-error) (if (and (== (. frame op) (. OpCode continuation)) (not started))))
    (return-if (. WebSocketClose protocol-error) (if (and (!= (. frame op) (. OpCode continuation)) started)))
    (blank)
    (let message (if-expr started (call (. started extended) frame) frame))
    (return-if (. WebSocketClose too-big) (if (> (. message payload size) limit)))
    (blank)
    (= pending (if-expr (. message is-fin) null message))
    (return (only-if (call deliver message) (if (. message is-fin))))
  )
  (fn-do _ deliver (? WebSocketClose)
    (param message Frame)
    (let size (. message payload size))
    (if (== (. message op) (. OpCode text))
      (let text (catch? (call decode-utf8 (. message payload))))
      (return-if (. WebSocketClose invalid-data) (if (not text)))
      (return-if (. WebSocketClose policy-violation) (if (not (call (. unread claim) size))))
      (call (. text-incoming push) text size)
      (else
        (return-if (. WebSocketClose policy-violation) (if (not (call (. unread claim) size))))
        (call (. binary-incoming push) message size)
      )
    )
    (return null)
  )
)

(type _ WebSocketBudget
  (prop _ lock _ (= (call Mutex)))
  (prop _ capacity Size)
  (prop _ used Size (= 0))
  (fn-do + This _
    (param limit Size)
    (= capacity (+ limit unread-message-cost))
  )
  (fn-do + claim Bool
    (param size Size)
    (use lock)
    (let cost (+ size unread-message-cost))
    (return-if false (if (> cost (- capacity used))))
    (+= used cost)
    (return true)
  )
  (fn-do + release _
    (param size Size)
    (use lock)
    (-= used (+ size unread-message-cost))
  )
)

(type _ (of WebSocketDelivery Message) (is (tuple (: message Message) (: size Size))))

(type _ (of WebSocketInbox Message)
  (implements (of Iterable Message))
  (implements Closable)
  (prop _ budget WebSocketBudget)
  (prop _ deliveries _ (= (call (of SyncBufferedChannel (of WebSocketDelivery Message)))))
  (fn-do + This _
    (param budget WebSocketBudget)
  )
  (fn-do + push _
    (param message Message)
    (param size Size)
    (<- deliveries (call WebSocketDelivery message size))
  )
  (fn-do + (prefix <- this) (? Message)
    (let delivery (<- deliveries))
    (return-if null (if (not delivery)))
    (call (. budget release) (. delivery size))
    (return (. delivery message))
  )
  (fn-do + close _
    (call (. deliveries close))
  )
)

(fn-expr + is-websocket-request Bool
  (param request HTTPRequest)
  (and (== (. request method) (. HTTPMethod get)) (has upgrade "websocket") (has connection "upgrade"))
  (where
    (lazy upgrade (call header-tokens (?? (?. (call (. request header) "Upgrade") lowercased) "")))
    (lazy connection (call header-tokens (?? (?. (call (. request header) "Connection") lowercased) "")))
  )
)

(fn-expr + websocket-protocol (? String)
  (param request HTTPRequest)
  (param protocols (list String))
  (call first (in each protocols (when (has offered each))))
  (where
    (lazy offered (call header-tokens (?? (call (. request header) "Sec-WebSocket-Protocol") "")))
  )
)

(fn-expr + websocket-handshake HTTPResponse
  (param request HTTPRequest)
  (param protocol (? String))
  (case? (!= (call (. request header) "Sec-WebSocket-Version") "13")
    (call HTTPResponse (. HTTPStatus upgrade-required) null version-headers)
  )
  (case? (!= (?. (catch? (call decode-base64 key)) size) 16)
    (call HTTPResponse (. HTTPStatus bad-request))
  )
  (default
    (call HTTPResponse (. HTTPStatus switching-protocols) null accept-headers)
  )
  (where
    (lazy key (?? (call (. request header) "Sec-WebSocket-Key") ""))
    (lazy version-headers (list HTTPHeader)
      (block
        (item (tuple "Sec-WebSocket-Version" "13"))
      )
    )
    (lazy accept-headers (list HTTPHeader)
      (block
        (item (tuple "Upgrade" "websocket"))
        (item (tuple "Connection" "Upgrade"))
        (item (tuple "Sec-WebSocket-Accept" (call websocket-accept key)))
        (item? (only-if (tuple "Sec-WebSocket-Protocol" protocol) (if protocol)))
      )
    )
  )
)

(fn-expr + websocket-accept String
  (param key String)
  (as (call sha1 (call byte-view (++ key websocket-guid))) Base64)
)

(fn-expr _ handshake-headers (list HTTPHeader)
  (param url URL)
  (param key String)
  (param protocols (list String))
  (item (tuple "Host" host))
  (item (tuple "Connection" "Upgrade"))
  (item (tuple "Upgrade" "websocket"))
  (item (tuple "Sec-WebSocket-Key" key))
  (item (tuple "Sec-WebSocket-Version" "13"))
  (item? (only-if (tuple "Sec-WebSocket-Protocol" (call (. ", " join) protocols)) (if (> (. protocols length) 0))))
  (where
    (lazy host (if-expr (== (. url port) (call port-for-scheme (. url scheme))) (. url host) (str (. url host) ":" (. url port))))
  )
)

(fn-expr _ handshake-failure (? IOError)
  (param handshake HTTPResponse)
  (param key String)
  (case? (!= (. handshake status) (. HTTPStatus switching-protocols))
    (call IOError (str "WebSocket handshake failed (" (. handshake status) ")"))
  )
  (case? (!= (call (. handshake header) "Sec-WebSocket-Accept") (call websocket-accept key))
    (call IOError "WebSocket handshake answered with the wrong Sec-WebSocket-Accept")
  )
)

(fn-expr _ header-tokens (list String)
  (param value String)
  (call (of List String) (in (~ \header-token) value))
)

(fn-expr _ header-token String (over: Char)
  (~ (seq (* \ws) (: name (+ (seq (! ",") (! \ws) .))) (* \ws) (? ","))
    name
  )
)

(type _ OpCode (is U8)
  (variant continuation (= 0))
  (variant text (= 1))
  (variant binary (= 2))
  (variant close (= 8))
  (variant ping (= 9))
  (variant pong (= 10))
  (fn-expr + is-control _ :get
    (>= this (. OpCode close))
  )
  (fn-expr + is-known _ :get
    (or (<= this (. OpCode binary)) (and (>= this (. OpCode close)) (<= this (. OpCode pong))))
  )
)

(type _ Frame (is Tuple)
  (prop + op OpCode)
  (prop + is-fin _ (= true))
  (prop + payload ([] Byte))
  (prop + reserved U8)
  (prop + is-masked _ (= false))
  (prop + length U64)
  (fn-do + This _
    (param op OpCode)
    (param payload _ (= ([] Byte 0)))
    (param is-fin _ (= true))
    (return (call This op is-fin payload 0 false (as (. payload size) U64)))
  )
  (fn-do + This _
    (param payload ([] Byte))
    (param op _ (= (. OpCode binary)))
    (param is-fin _ (= true))
    (return (call This op is-fin payload 0 false (as (. payload size) U64)))
  )
  (fn-do + This _
    (param text String)
    (param is-fin _ (= true))
    (return (call This (. OpCode text) (call (of Array Byte) text) is-fin))
  )
  (fn-do + This _
    (param code WebSocketClose)
    (param reason String)
    (return (call This (. OpCode close) payload))
    (blank)
    (lazy payload
      (match code
        (case= (. WebSocketClose no-status)
          ([] Byte 0)
        )
        (default
          (call joined-bytes (list status (call (of Array Byte) reason)))
        )
      )
    )
    (lazy status (call (of Array Byte) (list (as (/zrshift/ (as code U16) 8) Byte) (as (as code U16) Byte))))
  )
  (fn-to-expr + (of ReadableData Byte)
    (call DataStream payload)
  )
  (fn-expr + close-code WebSocketClose :get
    (match payload
      (~ (seq (: code U16) (* .))
        (as code WebSocketClose)
      )
      (default
        (. WebSocketClose no-status)
      )
    )
  )
  (fn-expr + refusal (? WebSocketClose)
    (param must-mask Bool)
    (param limit Size)
    (case? (> length (as limit U64))
      (. WebSocketClose too-big)
    )
    (case? (or (!= reserved 0) (!= is-masked must-mask) (not (. op is-known)))
      (. WebSocketClose protocol-error)
    )
    (case? (and (. op is-control) (or (not is-fin) (> length control-limit)))
      (. WebSocketClose protocol-error)
    )
  )
  (fn-expr + extended This
    (param next This)
    (call This op (. next is-fin) (call joined-bytes (list payload (. next payload))))
  )
  (fn-do + write-frame _ (?! Error)
    (param bytes WritableData)
    (param is-masked Bool)
    (let size (. payload size))
    (let mask-flag (if-expr is-masked 128u8 0u8))
    (blank)
    (scope (<- bytes (//or// b1 b2))
      (lazy b1 (/and/ (as op U8) 15))
      (lazy b2 (if-expr is-fin 128u8 0u8))
    )
    (blank)
    (if (< size boundary-8bit)
      (scope (<- bytes (//or// short mask-flag))
        (lazy short (/and/ (as size U8) 127))
      )
      (else-if (<= size boundary-16bit)
        (<- bytes (/or/ 126 mask-flag))
        (<- bytes (as size U16))
      )
      (else
        (<- bytes (/or/ 127 mask-flag))
        (<- bytes (as size U64))
      )
    )
    (blank)
    (if is-masked
      (let mask (call random-bytes 4))
      (<- bytes mask)
      (scope (<- bytes masked)
        (lazy masked (call (of Array Byte) size (:with (=> (index) (call mask-byte mask ([] payload index) index)))))
      )
      (else
        (<- bytes payload)
      )
    )
  )
)

(fn-expr _ frame Frame (over: Byte)
  (param limit Size)
  (~ (seq (: b1 U8) (: b2 U8) (: len \length) (: msk \mask) (: data ({} Byte (if-expr (<= len (as limit U64)) len 0))))
    (call Frame op is-fin payload (/and/ b1 0x70) is-masked len)
    (blank)
    (lazy op (as (/and/ b1 15u8) OpCode))
    (lazy is-fin (!= (/zrshift/ b1 7u8) 0u8))
    (lazy is-masked (!= (/zrshift/ b2 7u8) 0u8))
    (lazy length8 (/and/ b2 127u8))
    (blank)
    (lazy length
      (pattern
        (case? (== length8 127)
          (~ (: size U64)
            size
          )
        )
        (case? (== length8 126)
          (~ (: size U16)
            (as size U64)
          )
        )
        (default
          (~ ({} U8 0)
            (as length8 U64)
          )
        )
      )
    )
    (blank)
    (lazy mask
      (pattern
        (~ ({} Byte (if-expr is-masked 4 0)))
      )
    )
    (blank)
    (lazy payload
      (block
        (case? is-masked
          (call (of Array Byte) (. data size) (:with (=> (index) (call mask-byte msk ([] data index) index))))
        )
        (default
          (call (of Array Byte) data)
        )
      )
    )
  )
)

(fn-expr _ mask-byte _
  (param mask (of Indexable Byte))
  (param byte Byte)
  (param index Index)
  (/xor/ byte ([] mask (% index 4)))
)
