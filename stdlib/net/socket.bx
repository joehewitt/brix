(import /os/file)
(import /data)
(import /math)
(import /time/deadline)
(import /time/duration)
(import /unistd.h)
(import ./cnet)
(import ./dns)
(import /BxCore/BxCore.h)
(import /BxEvents/BxEvents.h)
(import /BxTLS/BxTLS.h)
(import /errno.h)
(import /netdb.h)
(import /stdlib.h)
(import /sys/socket.h)
(import /openssl/ssl.h)
(import /openssl/err.h)
(blank)
(prop _ listen-backlog _ (= 128))
(prop _ ssl-write-chunk-size Size (= 16384))
(prop _ ssl-close-drain-time Nanoseconds (= 1s))

(type + (of Socket Token) (is Interface)
  (constraint = Token Char)
  (implements (of ReadableData Token))
  (implements WritableData)
  (implements Closable)
  (fn-do + This _ (?! Error)
    (param host String)
    (param port Port)
    (param is-secure Bool)
    (return
      (block
        (case? is-secure
          (call (of SSL Token) host port)
        )
        (default
          (call (of TCP Token) host port)
        )
      )
    )
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (do
      (inline (call close))
    )
  )
)

(type + (of TCP Token)
  (constraint = Token Char)
  (implements (of Socket Token))
  (prop + fd I32)
  (prop + read-deadline (? Deadline))
  (prop + write-deadline (? Deadline))
  (fn-do + This _
    (param fd I32)
  )
  (fn-do + This _ (?! Error)
    (param host String)
    (param port Port)
    (param deadline (? Deadline) (= null))
    (let info
      (call get-addr-info host port
        (block
          (throw (call IOError "Couldn't create socket") (if (is it DNSError)))
        )
      )
    )
    (finally
      (inline (call C:free (. info addr)))
    )
    (let fd
      (call C:socket (. info family) (. info socktype) (. info protocol)
        (block
          (throw (call current-file-error) (if (== it -1)))
        )
      )
    )
    (blank)
    (let socket (call (of File Token) fd true false))
    (call (. socket set-flag) (. FileFlags non-block-mode) true)
    (blank)
    (let error
      (call C:connect fd (. info addr) (. info addrlen)
        (block
          (throw (call current-file-error) (if (and (== it -1) (!= (call C:brixGetErrNo) (. SocketErrorCode in-progress)))))
        )
      )
    )
    (if (== error -1)
      (call wait-until-writable fd deadline
        (block
          (on-error (: timeout TimeoutError)
            (do
              (call C:brixReleaseEventDescriptor fd)
              (call C:close fd)
            )
            (throw timeout)
          )
        )
      )
      (let connect-error (call socket-connect-error fd))
      (if (!= connect-error 0)
        (call C:brixReleaseEventDescriptor fd)
        (call C:close fd)
        (throw (call IOError (str "Unable to connect socket (" connect-error ")")))
      )
    )
    (blank)
    (return (call This socket))
  )
  (fn-do + local-address IP4Address (?! Error)
    (let address ([] CSockAddrInet4 1))
    (let length ([] I32 1))
    (= ([] length 0) (as (. CSockAddrInet4 size) I32))
    (call C:getsockname fd address length
      (block
        (throw (call current-file-error) (if (== it -1)))
      )
    )
    (return (call IP4Address (. ([] address 0) address) (call network-to-host (. ([] address 0) port))))
  )
  (fn-do + close _ (?! Error)
    (return-if (if (< fd 0)))
    (blank)
    (let descriptor fd)
    (= fd -1)
    (call C:brixReleaseEventDescriptor descriptor)
    (do
      (inline
        (call C:close descriptor
          (block
            (throw (call IOError "Unable to close socket") (if (!= it 0)))
          )
        )
      )
    )
  )
  (fn-do + shut-down-writes _
    (if (>= fd 0)
      (call C:shutdown fd C:SHUT_WR)
    )
  )
  (fn-do + read Size
    (param size Size)
    (param buffer ([] Byte))
    (while (>= fd 0)
      (let read-size (call C:recv fd buffer size 0))
      (if (>= read-size 0)
        (return read-size)
      )
      (blank)
      (let err (as (call C:brixGetErrNo) SocketErrorCode))
      (if (== err .bad-descriptor)
        (return 0)
      )
      (throw (call IOError (str "Unable to read socket (" err ")")) (if (!= err .would-block)))
      (blank)
      (call wait-until-readable fd read-deadline)
    )
    (blank)
    (return 0)
  )
  (fn-do + write Size
    (param buffer (of ImmutableArray Byte))
    (param size Size)
    (let total-size size)
    (while true
      (throw (call IOError "Socket is closed") (if (< fd 0)))
      (blank)
      (let wrote-size (call C:send fd buffer size 0))
      (if (== wrote-size size)
        (return total-size)
      )
      (blank)
      (if (and (>= wrote-size 0) (< wrote-size size))
        (call wait-until-writable fd write-deadline)
        (= buffer (+ buffer wrote-size))
        (= size (- size wrote-size))
        (else-if (== (call C:brixGetErrNo) (. SocketErrorCode would-block))
          (call wait-until-writable fd write-deadline)
        )
        (else
          (throw (call IOError (str "Unable to write socket (" (call C:brixGetErrNo) ")")))
        )
      )
    )
  )
)

(type + (of SSL Token)
  (constraint = Token Char)
  (implements (of Socket Token))
  (implements (of ReadableData Token))
  (implements WritableData)
  (prop _ socket (of TCP Token))
  (prop _ ssl (of CPointer I8) (= null))
  (prop _ read-bio (of CPointer I8) (= null))
  (prop _ write-bio (of CPointer I8) (= null))
  (prop _ read-buf _ (= ([] Byte 4096)))
  (prop _ write-buf _ (= ([] Byte (+ ssl-write-chunk-size 1024))))
  (prop _ write-lock _ (= (call Mutex)))
  (prop _ is-flushing _ (= false))
  (fn-do + This _ (?! Error)
    (param host String)
    (param port Port)
    (= socket (call (of TCP Token) host port))
    (let is-connected false)
    (finally
      (if (not is-connected)
        (catch (call close))
      )
    )
    (blank)
    (let ctx (call ssl-get-context))
    (= ssl (call C:SSL_new ctx))
    (call C:SSL_CTX_free ctx)
    (if (not ssl)
      (call ssl-error "Unable to create SSL")
    )
    (blank)
    (let reader (call C:BIO_new (call C:BIO_s_mem)))
    (let writer (call C:BIO_new (call C:BIO_s_mem)))
    (if (or (not reader) (not writer))
      (call C:BIO_free reader)
      (call C:BIO_free writer)
      (call ssl-error "Unable to create SSL buffers")
    )
    (call C:SSL_set_bio ssl reader writer)
    (= read-bio reader)
    (= write-bio writer)
    (blank)
    (call C:SSL_set_connect_state ssl)
    (call C:xSSL_set_tlsext_host_name ssl host)
    (if (!= (call C:xSSL_set1_host ssl host) 1)
      (call ssl-error "Unable to set SSL host")
    )
    (blank)
    (while (not (call C:xSSL_is_init_finished ssl))
      (call handshake)
    )
    (= is-connected true)
  )
  (fn-do + write Size
    (param buffer (of ImmutableArray Byte))
    (param size Size)
    (let wrote Size 0)
    (while (< wrote size)
      (throw (call IOError "Socket is closed") (if (not ssl)))
      (blank)
      (let remaining (- size wrote))
      (let amount (if-expr (> remaining ssl-write-chunk-size) ssl-write-chunk-size remaining))
      (let write-size (call C:SSL_write ssl (+ buffer wrote) amount))
      (if (> write-size 0)
        (+= wrote write-size)
        (call flush-writes)
        (else
          (let err (as (call C:SSL_get_error ssl write-size) SSLErrorCode))
          (if (== err .want-read)
            (call read-to-bio
              (block
                (throw (call IOError "Unable to write SSL") (if (not it)))
              )
            )
            (else-if (== err .want-write)
              (call flush-writes)
            )
            (else
              (call ssl-error "Unable to write SSL")
            )
          )
        )
      )
    )
    (blank)
    (return wrote)
  )
  (fn-do + close _ (?! Error)
    (if (and ssl (call C:xSSL_is_init_finished ssl))
      (catch (call shut-down))
    )
    (let owned ssl)
    (= ssl null)
    (= read-bio null)
    (= write-bio null)
    (if owned
      (call C:SSL_free owned)
    )
    (do
      (inline (call (. socket close)))
    )
  )
  (fn-do + read Size
    (param size Size)
    (param buffer ([] Byte))
    (while ssl
      (let read-size (call flush-reads size buffer))
      (if read-size
        (return read-size)
      )
      (blank)
      (if (not (call read-to-bio))
        (return 0)
      )
    )
    (blank)
    (return 0)
  )
  (fn-do _ shut-down _ (?! Error)
    (call C:SSL_shutdown ssl)
    (call C:ERR_clear_error)
    (call flush-writes)
    (call (. socket shut-down-writes))
    (let deadline (call Deadline ssl-close-drain-time))
    (= (. socket read-deadline) deadline)
    (let discard ([] Byte 4096))
    (let drained (call (. socket read) (. discard size) discard))
    (while (and (> drained 0) (not (. deadline has-passed)))
      (= drained (call (. socket read) (. discard size) discard))
    )
  )
  (fn-do _ handshake _
    (let r (call C:SSL_do_handshake ssl))
    (if (!= r 1)
      (let err (as (call C:SSL_get_error ssl r) SSLErrorCode))
      (if (== err .want-read)
        (call flush-writes)
        (call read-to-bio
          (block
            (throw (call IOError "Unable to handshake SSL") (if (not it)))
          )
        )
        (else-if (== err .want-write)
          (call flush-writes)
        )
        (else
          (call ssl-error "SSL Error")
        )
      )
    )
  )
  (fn-do _ read-to-bio Bool
    (let read-size (call (. socket read) (. read-buf size) read-buf))
    (return-if (if (or (== read-size 0) (not read-bio))))
    (blank)
    (call C:BIO_write read-bio read-buf read-size
      (block
        (throw (call IOError "Unable to write to SSL") (if (== it -1)))
      )
    )
    (blank)
    (return true)
  )
  (fn-do _ flush-writes _
    (use write-lock)
    (throw (call IOError "Socket is closed") (if (not write-bio)))
    (blank)
    (= is-flushing true)
    (finally
      (inline (= is-flushing false))
    )
    (while (and write-bio (> (call C:BIO_ctrl_pending write-bio) 0))
      (let bio-read-size
        (call C:BIO_read write-bio write-buf (. write-buf size)
          (block
            (throw (call IOError "Unable to write to SSL") (if (== it -1)))
          )
        )
      )
      (if (> bio-read-size 0)
        (call (. socket write) write-buf bio-read-size)
      )
    )
  )
  (fn-do _ flush-reads (? Size)
    (param size Size)
    (param buffer ([] Byte))
    (let read-size (call C:SSL_read ssl buffer size))
    (if (> read-size 0)
      (return read-size)
    )
    (blank)
    (let err (as (call C:SSL_get_error ssl read-size) SSLErrorCode))
    (return-if (if (== err .want-read)))
    (blank)
    (if (== err .want-write)
      (if (not is-flushing)
        (call flush-writes)
      )
      (return null)
      (else-if (== err .zero-return)
        (return 0)
      )
      (else
        (call ssl-error "Unable to read SSL")
      )
    )
  )
  (fn-do _ ssl-error _
    (param message String)
    (let e (call C:ERR_get_error))
    (let buf ([] Byte 4096))
    (call C:ERR_error_string_n e buf 4096)
    (throw (call IOError (str message ": " (as buf (of CPointer Char8)))))
  )
)

(type + TCPListener
  (implements Closable)
  (implements (of Usable TCPListener))
  (prop + host String)
  (prop + port Port)
  (blank)
  (prop _ fd I32 (= -1))
  (fn-do + This _ (?! Error)
    (param port Port (= 0))
    (param host _ (= "127.0.0.1"))
    (= fd (call listening-socket host port))
    (if (== port 0)
      (= (. this port) (call bound-port fd))
    )
  )
  (fn-expr + is-closed _ :get
    (< fd 0)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (do
      (inline (call close))
    )
  )
  (fn-do + accept (? (of TCP Byte)) (?! Error)
    (while (>= fd 0)
      (let connection (call C:accept fd null null))
      (if (>= connection 0)
        (call (of File Byte) connection true false)
        (return (call (of TCP Byte) connection))
      )
      (blank)
      (let err (as (call C:brixGetErrNo) SocketErrorCode))
      (if (== err .bad-descriptor)
        (return null)
        (else-if (== err .would-block)
          (call wait-until-readable fd)
        )
        (else-if (and (!= err .interrupted) (!= err .connection-aborted))
          (throw (call IOError (str "Unable to accept connection (" err ")")))
        )
      )
    )
    (blank)
    (return null)
  )
  (fn-do + close _ (?! Error)
    (return-if (if (< fd 0)))
    (blank)
    (let descriptor fd)
    (= fd -1)
    (call C:brixReleaseEventDescriptor descriptor)
    (do
      (inline
        (call C:close descriptor
          (block
            (throw (call IOError "Unable to close listening socket") (if (!= it 0)))
          )
        )
      )
    )
  )
)

(fn-do _ listening-socket I32 (?! Error)
  (param host String)
  (param port Port)
  (let info
    (call get-addr-info host port C:AI_PASSIVE
      (block
        (throw (call IOError (str "Unable to resolve " host)) (if (is it DNSError)))
      )
    )
  )
  (finally
    (inline (call C:free (. info addr)))
  )
  (let fd
    (call C:socket (. info family) (. info socktype) (. info protocol)
      (block
        (throw (call current-file-error) (if (== it -1)))
      )
    )
  )
  (blank)
  (let is-listening false)
  (finally
    (if (not is-listening)
      (call C:close fd)
    )
  )
  (blank)
  (let reuse ([] I32 1))
  (= ([] reuse 0) 1)
  (call C:setsockopt fd C:SOL_SOCKET C:SO_REUSEADDR reuse 4
    (block
      (throw (call current-file-error) (if (== it -1)))
    )
  )
  (call C:bind fd (. info addr) (. info addrlen)
    (block
      (throw (call IOError (str "Unable to listen on " host ":" port)) (if (== it -1)))
    )
  )
  (call C:listen fd listen-backlog
    (block
      (throw (call current-file-error) (if (== it -1)))
    )
  )
  (call (of File Byte) fd true false)
  (blank)
  (= is-listening true)
  (return fd)
)

(fn-do _ bound-port Port (?! Error)
  (param fd I32)
  (let address ([] CSockAddrInet4 1))
  (let length ([] I32 1))
  (= ([] length 0) (as (. CSockAddrInet4 size) I32))
  (call C:getsockname fd address length
    (block
      (throw (call current-file-error) (if (== it -1)))
    )
  )
  (return (call network-to-host (. ([] address 0) port)))
)

(type _ SocketErrorCode (is I32)
  (variant interrupted (= C:EINTR))
  (variant bad-descriptor (= C:EBADF))
  (variant would-block (= C:EWOULDBLOCK))
  (variant in-progress (= C:EINPROGRESS))
  (variant connection-aborted (= C:ECONNABORTED))
)

(type _ SSLErrorCode (is I32)
  (variant ssl (= 1))
  (variant want-read (= 2))
  (variant want-write (= 3))
  (variant zero-return (= 6))
)

(fn-do _ socket-connect-error _
  (param fd I32)
  (let error ([] I32 1))
  (let length ([] I32 1))
  (= ([] length 0) 4)
  (blank)
  (let result (call C:getsockopt fd C:SOL_SOCKET C:SO_ERROR error length))
  (if (== result -1)
    (throw (call current-file-error))
  )
  (blank)
  (return ([] error 0))
)

(fn-expr _ ssl-get-context _
  (call C:brixInitSSL certpem keypem capem
    (block
      (throw (call Error "Invalid SSL certificates") (if (not it)))
    )
  )
  (where
    (lazy keypem (?? (call C:getenv "BRIX_SSL_KEY_PEM") ""))
    (lazy certpem (?? (call C:getenv "BRIX_SSL_CERT_PEM") ""))
    (lazy capem (?? (call C:getenv "BRIX_SSL_CA_PEM") ""))
  )
)
