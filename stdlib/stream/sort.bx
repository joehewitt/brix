(fn-expr + (of sort Item) _ @inline
  (param stream (stream Item))
  (param using (of Comparer Item) (= compare-basic))
  (param is-reverse _ (= false))
  (call merge-sort-list (call List stream) using is-reverse)
)

(fn-expr + (of merge-sort Item) _ @inline
  (param stream (stream Item))
  (param using (of Comparer Item) (= compare-basic))
  (param is-reverse _ (= false))
  (call merge-sort-list (call List stream) using is-reverse)
)

(fn-do + (of bubble-sort Item) _
  (param stream (stream Item))
  (param using (of Comparer Item) (= compare-basic))
  (param is-reverse _ (= false))
  (let sorted (call List stream))
  (let length (. sorted length))
  (if (== length 0)
    (return sorted)
  )
  (blank)
  (for (in i (..< 0 (- length 1)))
    (for (in j (..< 0 (- length i 1)))
      (let item ([] sorted j))
      (let next ([] sorted (+ j 1)))
      (let cmp (call using item next))
      (if (or (and is-reverse (== cmp (. Comparison lesser))) (and (not is-reverse) (== cmp (. Comparison greater))))
        (= ([] sorted j) next)
        (= ([] sorted (+ j 1)) item)
      )
    )
  )
  (return sorted)
)

(fn-expr + compare-basic _
  (param a _)
  (param b _)
  (case? (> a b)
    (. Comparison greater)
  )
  (case? (< a b)
    (. Comparison lesser)
  )
  (default
    (. Comparison equal)
  )
)

(fn-expr _ (of merge-sort-list Item) (of List Item)
  (param items (of List Item))
  (param compare (of Comparer Item))
  (param is-reverse Bool)
  (case? (<= (. items length) 1)
    items
  )
  (default
    (call merge-sorted-lists left right compare is-reverse)
  )
  (where
    (lazy middle (/ (. items length) 2))
    (lazy left (call merge-sort-list ([] items (..< 0 middle)) compare is-reverse))
    (lazy right (call merge-sort-list ([] items (..< middle (. items length))) compare is-reverse))
  )
)

(fn-do _ (of merge-sorted-lists Item) (of List Item)
  (param left (of List Item))
  (param right (of List Item))
  (param compare (of Comparer Item))
  (param is-reverse Bool)
  (let merged (call (of List Item)))
  (call (. merged reserve) (+ (. left length) (. right length)))
  (blank)
  (let left-index Index 0)
  (let right-index Index 0)
  (while (and (< left-index (. left length)) (< right-index (. right length)))
    (let cmp (call compare ([] left left-index) ([] right right-index)))
    (if (call should-take-right cmp is-reverse)
      (+= merged ([] right right-index))
      (+= right-index 1)
      (else
        (+= merged ([] left left-index))
        (+= left-index 1)
      )
    )
  )
  (blank)
  (while (< left-index (. left length))
    (+= merged ([] left left-index))
    (+= left-index 1)
  )
  (blank)
  (while (< right-index (. right length))
    (+= merged ([] right right-index))
    (+= right-index 1)
  )
  (blank)
  (return merged)
)

(fn-expr _ should-take-right _
  (param cmp Comparison)
  (param is-reverse Bool)
  (or (and is-reverse (== cmp (. Comparison lesser))) (and (not is-reverse) (== cmp (. Comparison greater))))
)
