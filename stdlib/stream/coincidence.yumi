
./aggregate
/core/channel

`  =================================================================================================
`  + buffer'Item BufferedChannel'Item @task
`      of stream <Item>

`  for message in stream
`      <= message

`  buffer.close()

` =================================================================================================
` + window <Channel'Item>
`     - count Int
`     in stream <Item>
`
` . current-window Item<>
` . remaining = count
`
` for item in stream
`     if remaining == count
`         <= current-window
`     current-window <- item
`     remaining -= 1
`     if remaining == 0
`         current-window.close
`         current-window Item<>
`         remaining = count
`
` current-window.close
`
` =================================================================================================
` + window
`     in stream <Item>
`      until delimiter <Any>
`
` . current-window Channel'Item?
`
` for item in stream
`     if !current-window
`         current-window Item<>
`         <= current-window
`     current-window <- item
` or item in delimiter
`     if current-window
`         current-window.close
`         current-window = Nothing
`
━━━━━━━━━━━━━━━━━━━━
+ PairwisePair'Item is Tuple

+ a Item
+ b Item

━━━━━━━━━━━━━━━━━━━━
+ do buffer'Item
    - stream <Item>

. buffer = create-buffered-stream(stream)
do new
    for message in stream
        buffer <- message
    buffer.close()
= buffer

━━━━━━━━━━━━━━━━━━━━
+ do buffer'Item <List'Item> @inline
    - count Int
    - stream <Item>
    ` - Container ImmutableArray'Item
        ` = List'Item

. current-buffer = List'Item()
. remaining = count
for item in stream
    current-buffer += item
    remaining -= 1
    if remaining == 0
        <= current-buffer
        current-buffer = List'Item()
        remaining = count

━━━━━━━━━━━━━━━━━━━━
+ do window'Item @inline
    - stream <Item>
    - where Predicate'Item

. last Item? = null
. started = false
for item in stream
    if !started
        started = true
        <= item
        last = item
    else if where(item)
        <= item
        last = null
    else
        last = item

<=? last

` =================================================================================================
` + buffer <Container'Item>
`     of stream <Item>
`     until delimiter <Any>
`     - Container Container'Item
`         ` = List'Item
`
` . current-buffer = Container'Item()
` for item in stream
`     current-buffer <- item
` or item in delimiter
`     . completed-buffer = current-buffer
`     current-buffer = Container'Item()
`     <= completed-buffer

━━━━━━━━━━━━━━━━━━━━
+ do pairwise'Item @inline
    - stream <Item>
    - is-looped = false

. first Item? = null
. previous Item? = null
. started = false
for item in stream
    if started
        <= PairwisePair(previous!, item)
    else
        started = true
        first = item
    previous = item

if started && is-looped
    <= PairwisePair(previous!, first!)

━━━━━━━━━━━━━━━━━━━━
+ do partition'Item
    - stream <Item>
    - where Predicate'Item

. out1 SyncBufferedChannel'Item
. out2 SyncBufferedChannel'Item

do new
    for item in stream
        if where(item)
            out1 <- item
        else
            out2 <- item
    out1.close()
    out2.close()

= out1, out2

` =================================================================================================
` + split
`     - delimiter Item
`     in stream <Item>
`
` split for item in stream: item == delimiter
`
` =================================================================================================
` + split
`     of stream <Item>
`     where predicate Predicate'Item
`
` . windows Channel\<Item>
` . current-window Item<>
`
` windows <- current-window
`
` do new for item in stream
`     if predicate(item)
`         current-window.close
`         current-window Item<>
`         current-window >> windows
`     else
`         current-window <- item
`
` = windows
`
` =================================================================================================
` + group-by
`     of stream <Item>
`     where selector Selector'Item'Key
`
` . groups [Key = Channel'Item]
`
` for item in stream
`     . key = selector(item)
`     . group = groups[key]
`     if !group
`         group Item<>
`         groups[key] = group
`         <= group
`
`     group <- item
`
` for group in groups.values
`     group.close
`
` =================================================================================================
` + group-by
`     in stream <Item>
`     until terminator () <Any>
`         - group Channel'Item
`     where selector Selector'Item'Key
`
` . groups [Key = Channel'Item]
`
` for item in stream
`     . key = selector(item)
`     . group = groups[key]
`     if !group
`         group Item<>
`         groups[key] = group
`         . until-stream = terminator(group)
`         do new
`             <= until-stream
`             group.close
`             groups[key] = Nothing
`         <= group
`
`     group <- item
`
` for group in groups.values
`     group.close
`
` =================================================================================================
` + join
`     in (left <Left>, right <Right>)
`     with selector () Result
`         - left Left
`         - right Right
`
` . window-item Left?
` for right-item in right
`     if window-item
`         <= selector(window-item, right-item)
` or left-item in left
`     window-item = left-item
` or on left.closed
`     break

━━━━━━━━━━━━━━━━━━━━
+ do alternate'Item <Item> @inline
    - stream <Item>

. odds [Item]
. even = true
for item in stream
    if even
        <= item
    else
        odds += item
    even = !even
<<= odds

