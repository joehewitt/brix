
./aggregate
./combine

━━━━━━━━━━━━━━━━━━━━
+ identity'T
    - a T

a

━━━━━━━━━━━━━━━━━━━━
+ are'Item
    - type Type
    - stream <Item>

filter(stream) • where each is type

━━━━━━━━━━━━━━━━━━━━
+ do distinct'Item @inline
    - stream <Item>

. seen [Item]
for item in stream when !seen.find(item)
    seen += item
    <= item

━━━━━━━━━━━━━━━━━━━━
+ do distinct'Item'Key @inline
    - stream <Item>
    - where Selector'Item'Key

. seen [Key = Item]
for item in stream
    . key = where(item)
    if !seen[key]
        seen[key] = item
        <= item

━━━━━━━━━━━━━━━━━━━━
+ distinct-until-changed'Item
    - stream <Item>

distinct-until-changed(stream) • where :: a => a

━━━━━━━━━━━━━━━━━━━━
+ do distinct-until-changed'Item'Keyed @inline
    - stream <Item>
    - where Selector'Item'Keyed

. seen Keyed? = null
. started = false
for item in stream
    . key = where(item)
    if !started || key != seen
        started = true
        seen = key
        <= item

` ` Example
` > distinct-until-changed of item in values: item.key
` > distinct-until-changed where: each.key
` > distinct-until-changed of values where: each.key
`
` ** values
` > distinct-until-changed where: each.key

━━━━━━━━━━━━━━━━━━━━
+ do take'Item
    - number Int
    - stream Indexable'Item

<= stream[number]

━━━━━━━━━━━━━━━━━━━━
+ do take'Item
    - number Int
    - stream Iterable'Item

for i in 0 .. < number
    <- stream

<= <- stream

━━━━━━━━━━━━━━━━━━━━
+ do take-last'Item @inline
    - number Int
    - stream <Item>

. cache [Item]
. count = 0
for item in stream
    if count == number + 1
        cache.slide(-1)
    else
        count += 1
    cache += item

?! OutOfBoundsError("Not enough items in stream to take $number.")
    if count != number + 1

<= cache[0]

━━━━━━━━━━━━━━━━━━━━
+ do take'Item'Terminator
    - stream <Item>
    - terminator <Terminator>

. ok = true

for n on terminator
    ok = false
    break

for item in stream while ok
    <= item

`  for item in stream
`      <= item
`  or anything in terminator
`      break

━━━━━━━━━━━━━━━━━━━━
+ take'Item'Interval
    - stream <Item>
    - interval <Interval>

map(zip(stream, interval)) • with each[0]

━━━━━━━━━━━━━━━━━━━━
+ every'Item'Interval
    - stream <Item>
    - interval <Interval>

map(zip(stream, interval)) • with each[0]

` =================================================================================================
` + in stream <Item> until other <Any>
`
` for item in stream
`     --
` and x in other
`     <= item
`
` `Examples
` take for item in stream until 1s
` take for item until 1s
` take until 1s

` =================================================================================================
` + in stream <Item> while predicate Predicate'Item
`
` for item in stream
`     if predicate(item)
`         <= item
`     else
`         break
`
` ` Example
` take for item in values while: item > 10
` take while: * > 10

━━━━━━━━━━━━━━━━━━━━
+ do skip'Item
    - number Int
    - stream <Item>

for i in 0 .. < number
    <- stream
= stream

` =================================================================================================
` + skip in stream <Item>
`     until other <Any>
`
` for item in stream
`     --
` or x in other
`     break
` = stream
`
` ` Example
` skip until 1s

` =================================================================================================
` + skip in stream <Item>
`     while predicate Predicate'Item
`
` for item in stream while !predicate(item) do: --
` = stream
