(import ./aggregate)
(import /core/channel)

(type + (of PairwisePair Item) (is Tuple)
  (prop + a Item)
  (prop + b Item)
)

(fn-do + (of buffer Item) _
  (param stream (stream Item))
  (let buffer (call create-buffered-stream stream))
  (do-new
    (for (in message stream)
      (<- buffer message)
    )
    (call (. buffer close))
  )
  (return buffer)
)

(fn-do + (of buffer Item) (stream (of List Item)) @inline
  (param count Int)
  (param stream (stream Item))
  ; - Container ImmutableArray'Item
  ; = List'Item
  (blank)
  (throw (call Panic (str "Buffer size must be positive, not " count ".")) (if (<= count 0)))
  (let current-buffer (call (of List Item)))
  (let remaining count)
  (for (in item stream)
    (+= current-buffer item)
    (-= remaining 1)
    (if (== remaining 0)
      (yield current-buffer)
      (= current-buffer (call (of List Item)))
      (= remaining count)
    )
  )
)

(fn-do + (of window Item) _ @inline
  (param stream (stream Item))
  (param where (of Predicate Item))
  (let last (? Item) null)
  (let started false)
  (for (in item stream)
    (if (not started)
      (= started true)
      (yield item)
      (= last item)
      (else-if (call where item)
        (yield item)
        (= last null)
      )
      (else
        (= last item)
      )
    )
  )
  (blank)
  (yield? last)
  (blank)
  ; =================================================================================================
  ; + buffer <Container'Item>
  ;     of stream <Item>
  ;     until delimiter <Any>
  ;     - Container Container'Item
  ;         ` = List'Item
  ;
  ; . current-buffer = Container'Item()
  ; for item in stream
  ;     current-buffer <- item
  ; or item in delimiter
  ;     . completed-buffer = current-buffer
  ;     current-buffer = Container'Item()
  ;     <= completed-buffer
)

(fn-do + (of pairwise Item) _ @inline
  (param stream (stream Item))
  (param is-looped _ (= false))
  (let first (? Item) null)
  (let previous (? Item) null)
  (let started false)
  (for (in item stream)
    (if started
      (yield (call PairwisePair (!! previous) item))
      (else
        (= started true)
        (= first item)
      )
    )
    (= previous item)
  )
  (blank)
  (if (and started is-looped)
    (yield (call PairwisePair (!! previous) (!! first)))
  )
)

(fn-do + (of partition Item) _
  (param stream (stream Item))
  (param where (of Predicate Item))
  (let out1 (of SyncBufferedChannel Item))
  (let out2 (of SyncBufferedChannel Item))
  (blank)
  (do-new
    (for (in item stream)
      (if (call where item)
        (<- out1 item)
        (else
          (<- out2 item)
        )
      )
    )
    (call (. out1 close))
    (call (. out2 close))
  )
  (blank)
  (return (tuple out1 out2))
)

(fn-do + (of alternate Item) (stream Item) @inline
  (param stream (stream Item))
  (let odds (list Item))
  (let even true)
  (for (in item stream)
    (if even
      (yield item)
      (else
        (+= odds item)
      )
    )
    (= even (not even))
  )
  (yield-all odds)
)

(fn-do + (of evens Item) (stream Item) @inline
  (param stream (stream Item))
  (let even true)
  (for (in item stream)
    (if even
      (yield item)
    )
    (= even (not even))
  )
)

(fn-do + (of odds Item) (stream Item) @inline
  (param stream (stream Item))
  (let even true)
  (for (in item stream)
    (if (not even)
      (yield item)
    )
    (= even (not even))
  )
)
