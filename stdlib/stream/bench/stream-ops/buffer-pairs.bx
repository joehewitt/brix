; benchmark.meta description: Groups a 1,000,000-item source into pairs with buffer 2.
; benchmark.meta timing: recommended
(blank)
(import /stream)
(blank)

(main
  (let checksum 0)
  (for (in pair (call buffer 2 (call numbers 1000000)))
    (+= checksum (- ([] pair 1) ([] pair 0)))
  )
  (blank)
  (print (str "bench-result stream-ops/buffer-pairs checksum=" checksum))
)

(fn-do _ numbers (of Generator Int)
  (param count Int)
  (for (in index (..< 0 count))
    (yield index)
  )
)
