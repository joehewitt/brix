; benchmark.meta description: Asks more-than-one, only-one and exactly 3 of 10,000-item sources with one match, which must be read to the end.
; benchmark.meta timing: recommended
(blank)
(import /stream)
(blank)

(main
  (let hits 0)
  (for (in round (..< 0 1000))
    (if (call more-than-one (call numbers 10000) (:where (== each 5000)))
      (+= hits 1)
    )
    (if (call only-one (call numbers 10000) (:where (== each 5000)))
      (+= hits 1)
    )
    (if (call exactly 3 (call numbers 10000) (:where (== each 5000)))
      (+= hits 1)
    )
  )
  (blank)
  (print (str "bench-result stream-ops/count-predicates-undecided checksum=" hits))
)

(fn-do _ numbers (of Generator Int)
  (param count Int)
  (for (in index (..< 0 count))
    (yield index)
  )
)
