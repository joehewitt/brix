(type + (of Router Key RawEvent)
  (implements (of Iterable RawEvent))
  (implements (of Broadcastable RawEvent))
  (implements (of Writable RawEvent))
  (implements Closable)
  (prop _ dispatchers (list (of Dispatcher Key RawEvent)))
  (prop _ key-mapper (of Mapper RawEvent Key))
  (prop _ is-closed _ (= false))
  (prop _ all-route (of AsyncChannel RawEvent) (=> (call (of route RawEvent))))
  (fn-do + This _
    (param key-mapper (of Mapper RawEvent Key))
  )
  (fn-do + (infix this <- (param raw-event RawEvent)) _
    (return-if (if is-closed))
    (blank)
    (let key
      (call key-mapper raw-event
        (block
          (throw (call Error "Unrecognized event") (if (not it)))
        )
      )
    )
    (blank)
    (call dispatch key raw-event)
  )
  (fn-expr + (prefix <- this) _
    (<- all-route)
  )
  (fn-do + (of route Event Used) (of AsyncChannel Event)
    (param key Key)
    (param mapper (of MapKeyToUsable Key Used))
    (let dispatcher (call (of (. this create-dispatcher) Event) key mapper))
    (return (call (of (. dispatcher get-channel) Event)))
  )
  (fn-do + (of route Event Used) (of AsyncChannel Event)
    (param key Key)
    (param usable (of Usable Used))
    (let dispatcher (call (of (. this create-dispatcher) Event) key usable))
    (return (call (of (. dispatcher get-channel) Event)))
  )
  (fn-do + (of route Event) (of AsyncChannel Event)
    (param key Key)
    (let dispatcher (call (of (. this create-dispatcher) Event) key))
    (let channel (call (of (. dispatcher get-channel) Event)))
    (return channel)
  )
  (fn-expr + (of route Event) (of AsyncChannel Event)
    (call (of route Event) (. Event key))
  )
  (fn-expr + (of route Event) (of AsyncChannel Event)
    (constraint is! Event RawEvent)
    (call (of route Event) "")
  )
  (fn-expr + subscribe _
    (param subscriber (of Subscriber RawEvent))
    (call (. all-route subscribe) subscriber)
  )
  (fn-expr + unsubscribe _
    (param subscriber (of Subscriber RawEvent))
    (call (. all-route unsubscribe) subscriber)
  )
  (fn-do + close _
    (return-if (if is-closed))
    (blank)
    (= is-closed true)
    (for (in dispatcher dispatchers)
      (call (. dispatcher close))
    )
    (blank)
    (call (. all-route close))
  )
  (fn-do _ find-dispatcher _
    (param key Key)
    (for (in disp dispatchers)
      (if (call (. disp match) key)
        (return disp)
      )
    )
  )
  (fn-do _ (of create-dispatcher Event) (of Dispatcher Key RawEvent)
    (param key Key)
    (let existing (call (. this find-dispatcher) key))
    (if existing
      (return existing)
      (else-if is-closed
        (return (call (of closed-dispatcher Event) key))
      )
      (else
        (let channel (of AsyncChannel Event))
        (let dispatcher (call (of EventDispatcher Key RawEvent Event) key channel))
        (+= dispatchers dispatcher)
        (return dispatcher)
      )
    )
  )
  (fn-do _ (of create-dispatcher Event Used) (of Dispatcher Key RawEvent)
    (param key Key)
    (param mapper (of MapKeyToUsable Key Used))
    (let existing (call (. this find-dispatcher) key))
    (if existing
      (return existing)
      (else-if is-closed
        (return (call (of closed-dispatcher Event) key))
      )
      (else
        (let usable (call mapper key))
        (let channel (call (of AsyncOnDemandChannel Event) usable))
        (let dispatcher (call (of EventDispatcher Key RawEvent Event) key channel))
        (+= dispatchers dispatcher)
        (return dispatcher)
      )
    )
  )
  (fn-do _ (of create-dispatcher Event Used) (of Dispatcher Key RawEvent)
    (param key Key)
    (param usable (of Usable Used))
    (let existing (call (. this find-dispatcher) key))
    (if existing
      (return existing)
      (else-if is-closed
        (return (call (of closed-dispatcher Event) key))
      )
      (else
        (let channel (call (of AsyncOnDemandChannel Event) usable))
        (let dispatcher (call (of EventDispatcher Key RawEvent Event) key channel))
        (+= dispatchers dispatcher)
        (return dispatcher)
      )
    )
  )
  (fn-do _ (of closed-dispatcher Event) (of Dispatcher Key RawEvent)
    (param key Key)
    (let channel (of AsyncChannel Event))
    (call (. channel close))
    (return (call (of EventDispatcher Key RawEvent Event) key channel))
  )
  (fn-do _ dispatch _
    (param key Key)
    (param raw-event RawEvent)
    (let dispatcher (call (. this find-dispatcher) key))
    (call (?. dispatcher dispatch) key raw-event)
    (blank)
    (do
      (inline (<- all-route raw-event))
    )
  )
)

(type + (of MapKeyToUsable Key Used) (is (fn-type (of Usable Used) (param key Key))))

(type + (of Dispatcher Key RawEvent) (is Interface)
  (fn-expr + match Bool
    (param other Key)
  )
  (fn-expr + (of get-channel Event) (of AsyncChannel Event) (?! Error))
  (fn-expr + dispatch _
    (param key Key)
    (param raw-event RawEvent)
  )
  (fn-expr + close _)
)

(type + (of EventDispatcher Key RawEvent Event)
  (implements (of Dispatcher Key RawEvent))
  (prop + key Key)
  (prop + channel (of AsyncChannel Event))
  (fn-do + This _
    (param key Key)
    (param channel (of AsyncChannel Event))
  )
  (fn-expr + match Bool
    (param other Key)
    (== other key)
  )
  (fn-do + dispatch _
    (param key Key)
    (param raw-event RawEvent)
    (<- channel (as raw-event Event))
  )
  (fn-do + close _
    (call (. channel close))
  )
  (fn-do + (of get-channel Item) (of AsyncChannel Item)
    (throw (call Error "Unsupported event"))
  )
  (fn-expr + (of get-channel Item) (of AsyncChannel Item)
    (constraint is! Item Event)
    channel
  )
)
