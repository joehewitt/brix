/stream/sort
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Sort")
cases.run(sort-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do sort-tests
    - t TestCase

t.expect("ascending", "1, 1, 2, 3, 5, 8", ", ".join(sort([5,3,1,8,1,2])))
t.expect("descending", "8, 5, 3, 2, 1, 1", ", ".join(sort([5,3,1,8,1,2]) • is-reverse true))

. by-length = ", ".join(sort(["bear", "ant", "cat", "ox"]) • using compare-length)
t.expect("custom comparator", "ox, ant, cat, bear", by-length)
= t

━━━━━━━━━━━━━━━━━━━━
+ compare-length
    - left String
    - right String

compare-basic(left.length, right.length)
