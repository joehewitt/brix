./expression
./token
./value
/data/json
/graphics/color
/graphics/point
/math/easing

━━━━━━━━━━━━━━━━━━━━
+ do script-expression-json JSON
    - expression ScriptExpression

do match expression
    | literal ScriptLiteral
        = script-literal-json(literal)
    | reference ScriptReferenceExpression
        = script-reference-json(reference)
    | negation ScriptNegation
        = Map'String'JSON
            • "op" "neg"
            • "operand" script-expression-json(negation.operand)
    | binary ScriptBinary
        = Map'String'JSON
            • "op" binary.operator.symbol
            • "left" script-expression-json(binary.left)
            • "right" script-expression-json(binary.right)
    | point ScriptPointExpression
        . fields = Map'String'JSON
            • "x" script-expression-json(point.x)
            • "y" script-expression-json(point.y)
        if !point.closed
            fields["open"] = true
        = fields
    | group ScriptGroup
        . fields = Map'String'JSON
            • "group" script-expression-json(group.inner)
        if !group.closed
            fields["open"] = true
        = fields
    | phrase ScriptPhraseExpression
        . arguments = Map'String'JSON()
        for key, value in phrase.arguments
            arguments[key] = script-expression-json(value)
        = Map'String'JSON
            • "phrase" phrase.kind
            • "args" arguments
    | unresolved ScriptUnresolved
        = Map'String'JSON
            • "error" script-token-json(unresolved.token)
    | sequence ScriptSequence
        . items = List'JSON(script-expression-json(each) in sequence.items)
        = Map'String'JSON
            • "sequence" items
    | list ScriptListExpression
        . items = List'JSON(script-expression-json(each) in list.items)
        = Map'String'JSON
            • "list" items
    ??
        = Map'String'JSON
            • "hole" true

━━━━━━━━━━━━━━━━━━━━
+ do script-literal-json JSON
    - literal ScriptLiteral

do match literal.value
    | .number(number)
        . fields = Map'String'JSON
            • "number" number
        if literal.text != script-number-text(number)
            fields["typed"] = literal.text
        = fields
    | .point(point)
        = Map'String'JSON
            • "point" List'JSON(point.x as F64, point.y as F64)
    | .color(color)
        = Map'String'JSON
            • "color" script-color-text(color)
    | .text(text)
        = Map'String'JSON
            • "string" text
    | .node(node)
        = Map'String'JSON
            • "nodeValue" script-node-json(node)
    | .nodes(nodes)
        = Map'String'JSON
            • "nodes" List'JSON(script-node-json(each) in nodes)
    | .loop(loop)
        = Map'String'JSON
            • "number" loop.number
    | .range(range)
        = Map'String'JSON
            • "range" script-range-json(range)
    | .part(part)
        = script-part-json(part)
    | .parts(parts)
        = Map'String'JSON
            • "parts" List'JSON(script-part-json(each) in parts)
    | .truth(truth)
        = Map'String'JSON
            • "truth" truth

━━━━━━━━━━━━━━━━━━━━
+ script-part-json
    - part ScriptNodePart

Map'String'JSON
    • "part" part.kind
    • "of" script-node-json(part.node)
    • "number" part.number as Int

━━━━━━━━━━━━━━━━━━━━
+ script-part-from-json ?! Error
    - json JSON

ScriptNodePart(whole, script-json-string(fields["part"], "part"), place)

.. fields = script-json-fields(json, "part")
.. whole = script-node-from-json(fields["of"])
.. place = script-json-number(fields["number"], "number") as Index

━━━━━━━━━━━━━━━━━━━━
+ do script-range-json [String = JSON]
    - range ScriptRange

. fields = Map'String'JSON
    • "from" script-value-json(range.first)
    • "to" script-value-json(range.last)
if range.step
    fields["step"] = range.step
if range.items.length
    fields["items"] = List'JSON(script-value-json(each) in range.items)
do match? range.easing
    |= .ease-in
        fields["easing"] = "in"
    |= .ease-out
        fields["easing"] = "out"
    |= .ease-in-out
        fields["easing"] = "in and out"
= fields

━━━━━━━━━━━━━━━━━━━━
_ script-value-json JSON
    - value ScriptValue

script-literal-json
    - ScriptLiteral(value, if value.as-number then script-number-text(value.as-number!) else "")

━━━━━━━━━━━━━━━━━━━━
+ do script-range-from-json ScriptRange ?! Error
    - json JSON

. fields = script-json-fields(json, "range")
. first = script-json-value(fields["from"], "from")
. last = script-json-value(fields["to"], "to")
. items [ScriptValue]
if fields has "items"
    for item in script-json-list(fields["items"], "items")
        items += script-json-value(item, "item")
. step F64? = script-json-number(fields["step"], "step") if fields has "step"
. easing = Easing.linear
if fields has "easing"
    . name = script-json-string(fields["easing"], "easing")
    do match name
        |= "in"
            easing = Easing.ease-in
        |= "out"
            easing = Easing.ease-out
        |= "in and out"
            easing = Easing.ease-in-out
        ?! Error("Unknown easing '$name'")
= ScriptRange(first, last, step, items, easing)

━━━━━━━━━━━━━━━━━━━━
_ script-json-value ScriptValue ?! Error
    - json JSON?
    - label = "value"

?! Error("$label must be a literal")
    if !value
value

.. value = script-literal-value(script-expression-from-json(script-json-required(json, label)))

━━━━━━━━━━━━━━━━━━━━
+ script-node-json JSON
    - node ScriptNode

Map'String'JSON
    • "id" node.id as Int
    • "kind" node.kind

━━━━━━━━━━━━━━━━━━━━
+ do script-reference-json JSON
    - expression ScriptReferenceExpression

. reference = expression.reference
. fields = Map'String'JSON
    • "name" expression.name
do match reference.kind
    |= .node
        fields["node"] = reference.id as Int
    |= .variable
        fields["variable"] = reference.id as Int
. copy = reference.copy
if copy
    fields["copy"] = script-copy-json(copy)
= fields

━━━━━━━━━━━━━━━━━━━━
+ do script-copy-json [String = JSON]
    - copy ScriptCopy

do match copy
    | .previous(source)
        = Map'String'JSON
            • "copy" "previous"
            • "source" source as Int
    | .last
        = Map'String'JSON
            • "copy" "last"
    | .numbers(numbers)
        = Map'String'JSON
            • "copy" "numbers"
            • "numbers" List'JSON(each as Int in numbers)
    | .every
        = Map'String'JSON
            • "copy" "every"
    | .variable(id)
        = Map'String'JSON
            • "copy" "variable"
            • "variable" id as Int

━━━━━━━━━━━━━━━━━━━━
+ do script-copy-from-json ScriptCopy ?! Error
    - json JSON

. fields = script-json-fields(json, "copy")
. kind = script-json-string(fields["copy"], "copy")
do match? kind
    |= "previous"
        = ScriptCopy.previous(script-json-id(fields["source"], "source"))
    |= "last"
        = ScriptCopy.last
    |= "numbers"
        . numbers [Index]
        for item in script-json-list(fields["numbers"], "numbers")
            . number = script-json-id(item, "number")
            ?! Error("Copy numbers start at 1")
                if number == 0
            numbers += number as Index
        ?! Error("A copy needs a number")
            if !numbers.length
        = ScriptCopy.numbers(numbers)
    |= "every"
        = ScriptCopy.every
    |= "variable"
        = ScriptCopy.variable(script-json-id(fields["variable"], "variable"))
?! Error("Unknown copy '$kind'")

━━━━━━━━━━━━━━━━━━━━
+ do script-token-json JSON
    - token ScriptToken

. fields = Map'String'JSON
    • "kind" script-token-kind-name(token.kind)
    • "text" token.text
if token.kind == ScriptTokenKind.word
    fields["phrase"] = token.phrase
    fields["part"] = token.part as Int
= fields

━━━━━━━━━━━━━━━━━━━━
+ script-token-kind-name
    - kind ScriptTokenKind

kind.name

━━━━━━━━━━━━━━━━━━━━
+ script-token-kind-named ScriptTokenKind?
    - name String

match? name
    |= "number"
        ScriptTokenKind.number
    |= "query"
        ScriptTokenKind.query
    |= "chip"
        ScriptTokenKind.chip
    |= "literal"
        ScriptTokenKind.literal
    |= "operator"
        ScriptTokenKind.operator
    |= "open"
        ScriptTokenKind.open
    |= "close"
        ScriptTokenKind.close
    |= "comma"
        ScriptTokenKind.comma
    |= "word"
        ScriptTokenKind.word
    |= "hole"
        ScriptTokenKind.hole

━━━━━━━━━━━━━━━━━━━━
+ do script-expression-from-json ScriptExpression ?! Error
    - json JSON

. fields = script-json-fields(json, "expression")
if fields has "parts"
    . parts [ScriptNodePart]
    for item in script-json-list(fields["parts"], "parts")
        parts += script-part-from-json(item)
    = ScriptLiteral(ScriptValue.parts(parts), "")
if fields has "part"
    = ScriptLiteral(ScriptValue.part(script-part-from-json(json)), "")
if fields has "number"
    . number = script-json-number(fields["number"], "number")
    = ScriptLiteral(ScriptValue.number(number), if fields has "typed" then script-json-string(fields["typed"], "typed") else script-number-text(number))
if fields has "point"
    . coordinates = script-json-list(fields["point"], "point")
    ?! Error("A point literal needs two coordinates")
        if coordinates.length != 2
    . value = Point
        - script-json-number(coordinates[0], "x")
        - script-json-number(coordinates[1], "y")
    = ScriptLiteral(ScriptValue.point(value), "")
if fields has "color"
    . text = script-json-string(fields["color"], "color")
    . color = match? text
        ~ \ws* color RGBA \ws* !.
            color
    ?! Error("Invalid color literal '$text'")
        if !color
    = ScriptLiteral(ScriptValue.color(color), "")
if fields has "string"
    = ScriptLiteral(ScriptValue.text(script-json-string(fields["string"], "string")), "")
if fields has "nodeValue"
    = ScriptLiteral(ScriptValue.node(script-node-from-json(fields["nodeValue"])), "")
if fields has "nodes"
    . nodes = List'ScriptNode()
    for item in script-json-list(fields["nodes"], "nodes")
        nodes += script-node-from-json(item)
    = ScriptLiteral(ScriptValue.nodes(nodes), "")
if fields has "range"
    = ScriptLiteral(ScriptValue.range(script-range-from-json(fields["range"]!)), "")
if fields has "truth"
    do match fields["truth"]
        | truth Bool
            = ScriptLiteral(ScriptValue.truth(truth), if truth then "true" else "false")
        ?! Error("A truth literal needs true or false")
if fields has "node"
    . copy = script-copy-from-json(fields["copy"]!) if fields has "copy"
    . reference = ScriptReference
        - ScriptReferenceKind.node
        - script-json-id(fields["node"], "node")
        - copy
    = ScriptReferenceExpression(reference, script-json-string(fields["name"], "name"))
if fields has "variable"
    . reference = script-variable-reference(script-json-id(fields["variable"], "variable"))
    = ScriptReferenceExpression(reference, script-json-string(fields["name"], "name"))
if fields has "op"
    . symbol = script-json-string(fields["op"], "op")
    if symbol == "neg"
        = ScriptNegation
            - script-expression-from-json(script-json-required(fields["operand"], "operand"))
    . operator = script-operator-named(symbol)
    ?! Error("Unknown operator '$symbol'")
        if !operator
    . left = script-expression-from-json(script-json-required(fields["left"], "left"))
    . right = script-expression-from-json(script-json-required(fields["right"], "right"))
    = ScriptBinary(operator, left, right)
if fields has "x"
    . x = script-expression-from-json(script-json-required(fields["x"], "x"))
    . y = script-expression-from-json(script-json-required(fields["y"], "y"))
    = ScriptPointExpression(x, y, !(fields has "open"))
if fields has "group"
    = ScriptGroup
        - script-expression-from-json(script-json-required(fields["group"], "group"))
        - !(fields has "open")
if fields has "phrase"
    . arguments = Map'String'ScriptExpression()
    for key, value in script-json-fields(script-json-required(fields["args"], "args"), "args")
        arguments[key] = script-expression-from-json(value)
    = ScriptPhraseExpression(script-json-string(fields["phrase"], "phrase"), arguments)
if fields has "error"
    = ScriptUnresolved(script-token-from-json(script-json-required(fields["error"], "error")))
if fields has "sequence"
    . items = List'ScriptExpression()
    for item in script-json-list(fields["sequence"], "sequence")
        items += script-expression-from-json(item)
    = ScriptSequence(items)
if fields has "list"
    . items = List'ScriptExpression()
    for item in script-json-list(fields["list"], "list")
        items += script-expression-from-json(item)
    ?! Error("A list needs at least two items")
        if items.length < 2
    = ScriptListExpression(items)
if fields has "hole"
    = ScriptHole()
?! Error("Unknown script expression")

━━━━━━━━━━━━━━━━━━━━
+ script-token-from-json ScriptToken ?! Error
    - json JSON

?! Error("Unknown token kind '$name'")
    if !kind
|? kind != ScriptTokenKind.word
    ScriptToken(kind, text)
??
    script-word-token(script-json-string(fields["phrase"], "phrase"), part as Size, text, false)

.. fields = script-json-fields(json, "token")
.. name = script-json-string(fields["kind"], "kind")
.. kind = script-token-kind-named(name)
.. text = script-json-string(fields["text"], "text")
.. part = script-json-id(fields["part"], "part")

━━━━━━━━━━━━━━━━━━━━
+ script-node-from-json ScriptNode ?! Error
    - json JSON?

ScriptNode(script-json-id(fields["id"], "id"), script-json-string(fields["kind"], "kind"))

.. fields = script-json-fields(script-json-required(json, "node"), "node")

━━━━━━━━━━━━━━━━━━━━
_ script-json-required JSON ?! Error
    - json JSON?
    - label = "value"

match json
    | value JSON
        value
    ?! Error("Missing $label")

━━━━━━━━━━━━━━━━━━━━
_ script-json-fields [String = JSON] ?! Error
    - json JSON
    - label String

match json
    | fields [String = JSON]
        fields
    ?! Error("$label must be an object")

━━━━━━━━━━━━━━━━━━━━
_ script-json-list [JSON] ?! Error
    - json JSON?
    - label = "value"

match json
    | items [JSON]
        items
    ?! Error("$label must be an array")

━━━━━━━━━━━━━━━━━━━━
_ script-json-string String ?! Error
    - json JSON?
    - label = "value"

match json
    | text String
        text
    ?! Error("$label must be a string")

━━━━━━━━━━━━━━━━━━━━
_ script-json-number F64 ?! Error
    - json JSON?
    - label = "value"

match json
    | number Float
        number
    | number Int
        number as F64
    ?! Error("$label must be a number")

━━━━━━━━━━━━━━━━━━━━
_ script-json-id U64 ?! Error
    - json JSON?
    - label = "value"

match json
    | number Int
        number as U64
    ?! Error("$label must be an integer")
