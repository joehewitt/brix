    - symbol String
    - prefix = false

ScriptToken(ScriptTokenKind.operator, symbol) • prefix prefix

━━━━━━━━━━━━━━━━━━━━
+ script-close-token
    - ghost = false

ScriptToken(ScriptTokenKind.close, ")") • ghost ghost

━━━━━━━━━━━━━━━━━━━━
+ script-word-token
    - phrase String
    - part Size
    - text String
    - closes Bool

ScriptToken(ScriptTokenKind.word, text) • phrase phrase • part part • closes closes

━━━━━━━━━━━━━━━━━━━━
+ script-call-token
    - phrase String
    - name String

ScriptToken(ScriptTokenKind.word, name) • phrase phrase • called true

━━━━━━━━━━━━━━━━━━━━
+ script-hole-token
    - label = ""

ScriptToken(ScriptTokenKind.hole, label)

━━━━━━━━━━━━━━━━━━━━
+ do script-text String
    - tokens [ScriptToken]

. text = ""
. previous ScriptToken?
for token in tokens
    if previous && script-token-spaced(previous, token)
        text = "$text "
    text = "$text${script-token-text(token, previous)}"
    previous = token
= text

━━━━━━━━━━━━━━━━━━━━
+ script-token-text String
    - token ScriptToken
    - previous ScriptToken?

match token.kind
    |= .hole
        "‹${token.text}›"
    |= .word
        if script-possessive-elides(token, previous) then elided else token.text
        .. elided = "'${token.text[2 .. < token.text.length]}"
    ??
        token.text

━━━━━━━━━━━━━━━━━━━━
+ script-possessive-elides
    - token ScriptToken
    - previous ScriptToken?

possessive && previous?.kind == ScriptTokenKind.chip && previous!.text.ends-with("s")

.. possessive = token.text.starts-with("'s")

━━━━━━━━━━━━━━━━━━━━
+ script-token-spaced Bool
    - previous ScriptToken
    - next ScriptToken

|? previous.kind == ScriptTokenKind.open || next.kind == ScriptTokenKind.close
    false
|? next.kind == ScriptTokenKind.comma
    false
|? previous.called && next.kind == ScriptTokenKind.open
    false
|? (next.kind == ScriptTokenKind.word || next.kind == ScriptTokenKind.query) && next-apostrophe
    false
|? previous.kind == ScriptTokenKind.operator && previous.prefix
    false
??
    true

.. next-apostrophe = next.text.starts-with("'")
