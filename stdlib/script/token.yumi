./value

+ script-open-token = ScriptToken(ScriptTokenKind.open, "(")
+ script-comma-token = ScriptToken(ScriptTokenKind.comma, ",")

━━━━━━━━━━━━━━━━━━━━
+ ScriptReferenceKind is Union

| node
| variable

━━━━━━━━━━━━━━━━━━━━
+ ScriptReference is Tuple

+ kind ScriptReferenceKind
+ id U64 = 0
+ copy ScriptCopy? = null

━━━━━━━━━━━━━━━━━━━━
+ ScriptCopy is Union

| previous U64
| last
| numbers [Index]
| every
| variable U64

━━━━━━━━━━━━━━━━━━━━
+ do script-copy-equal Bool
    - left ScriptCopy?
    - right ScriptCopy?

=? left == null && right == null if !left || !right
do match left
    | .previous(source)
        do match? right
            | .previous(other)
                = source == other
    | .last
        do match? right
            | .last
                = true
    | .numbers(numbers)
        do match? right
            | .numbers(others)
                = numbers == others
    | .every
        do match? right
            | .every
                = true
    | .variable(id)
        do match? right
            | .variable(other)
                = id == other
= false

━━━━━━━━━━━━━━━━━━━━
+ do script-copy-text String
    - name String
    - copy ScriptCopy?
    - source = ""

=? name if !copy
do match copy
    | .previous
        = "${if source.length then source else name} last time"
    | .last
        = "last $name"
    | .numbers(numbers)
        . text = name
        for index in 0 .. < numbers.length
            text = if index == 0 then "$text #${numbers[index]}" else "$text, #${numbers[index]}"
        = text
    | .every
        = "every $name"
    | .variable
        = "$name #${if source.length then source else "?"}"

━━━━━━━━━━━━━━━━━━━━
+ script-node-reference
    - id U64

ScriptReference(ScriptReferenceKind.node, id)

━━━━━━━━━━━━━━━━━━━━
+ script-variable-reference
    - id U64

ScriptReference(ScriptReferenceKind.variable, id)

━━━━━━━━━━━━━━━━━━━━
+ ScriptTokenKind is Union

| number
| query
| chip
| literal
| operator
| open
| close
| comma
| word
| hole

━━━━━━━━━━━━━━━━━━━━
+ ScriptToken is Tuple

+ kind ScriptTokenKind
+ text = ""
+ reference = script-node-reference(0)
+ value ScriptValue?
+ phrase = ""
+ part Size = 0
+ closes = false
+ called = false
+ prefix = false
+ ghost = false
+ missing = false

────────────────────
+ get starts-operand

match kind
    |= .number
        true
    |= .query
        true
    |= .chip
        true
    |= .literal
        true
    |= .open
        true
    |= .hole
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ script-number-token
    - text String

ScriptToken(ScriptTokenKind.number, text)

━━━━━━━━━━━━━━━━━━━━
+ script-query-token
    - text String

ScriptToken(ScriptTokenKind.query, text)

━━━━━━━━━━━━━━━━━━━━
+ script-chip-token
    - reference ScriptReference
    - name String
    - missing = false

ScriptToken(ScriptTokenKind.chip, name, reference) • missing missing

━━━━━━━━━━━━━━━━━━━━
