./expression
./phrase
./range
./value
/graphics/point
/math

━━━━━━━━━━━━━━━━━━━━
+ do script-add-standard'Context
    - vocabulary ScriptVocabulary'Context

. number = script-number-type
. degrees = ScriptType(ScriptTypeKind.number, ScriptUnit.degrees)
. point = ScriptType(ScriptTypeKind.point)
. whole = ScriptType(ScriptTypeKind.number) • whole true
vocabulary.add-function
    - "script.min"
    - "min of {a:number} and {b:number}"
    - number
    - :: arguments, context => ScriptValue.number(min(arguments.number("a"), arguments.number("b")))
vocabulary.add-function
    - "script.max"
    - "max of {a:number} and {b:number}"
    - number
    - :: arguments, context => ScriptValue.number(max(arguments.number("a"), arguments.number("b")))
vocabulary.add-function
    - "script.round"
    - "round {value:number}"
    - number
    - :: arguments, context => ScriptValue.number(round(arguments.number("value")))
vocabulary.add-function
    - "script.abs"
    - "abs {value:number}"
    - number
    - :: arguments, context => ScriptValue.number(abs(arguments.number("value")))
vocabulary.add-function
    - "script.sqrt"
    - "sqrt {value:number}"
    - number
    - :: arguments, context => script-square-root(arguments)
vocabulary.add-function
    - "script.sin"
    - "sin {angle:degrees}"
    - number
    - :: arguments, context => ScriptValue.number(sin(arguments.number("angle") as Degrees))
vocabulary.add-function
    - "script.cos"
    - "cos {angle:degrees}"
    - number
    - :: arguments, context => ScriptValue.number(cos(arguments.number("angle") as Degrees))
vocabulary.add("script.pi", "pi", number, :: arguments, context => ScriptValue.number(π))
vocabulary.add
    - "script.true"
    - "true"
    - script-truth-type
    - :: arguments, context => ScriptValue.truth(true)
vocabulary.add
    - "script.false"
    - "false"
    - script-truth-type
    - :: arguments, context => ScriptValue.truth(false)
vocabulary.add("script.distance", "distance between {a:point} and {b:point}", number, :: arguments, context => ScriptValue.number(arguments.point("a").distance(arguments.point("b"))))
vocabulary.add
    - "script.angle-between"
    - "angle from {a:point} to {b:point}"
    - degrees
    - :: arguments, context => script-angle-between(arguments)
vocabulary.add
    - "script.angle"
    - "angle of {vector:point}"
    - degrees
    - :: arguments, context => script-angle(arguments)
vocabulary.add
    - "script.length"
    - "length of {vector:point}"
    - number
    - :: arguments, context => script-length(arguments)
vocabulary.add("script.midpoint", "midpoint between {a:point} and {b:point}", point, :: arguments, context => ScriptValue.point(arguments.point("a").midpoint(arguments.point("b"))))
vocabulary.add-function
    - "script.mix"
    - "mix of {a:any} and {b:any} at {position:percent}"
    - script-any-type
    - :: arguments, context => script-mixed(arguments)
vocabulary.add
    - "script.rotated"
    - "{point:point} rotated by {angle:degrees} around {center:point}"
    - point
    - :: arguments, context => script-rotated(arguments)
vocabulary.add
    - "script.moved"
    - "{point:point} moved by {distance:number} at {angle:degrees}"
    - point
    - :: arguments, context => script-moved(arguments)
vocabulary.add
    - "script.loop-number"
    - "{loop:loop}'s number"
    - whole
    - :: arguments, context => ScriptValue.number(arguments.loop("loop").number)
vocabulary.add
    - "script.loop-count"
    - "{loop:loop}'s count"
    - whole
    - :: arguments, context => ScriptValue.number(arguments.loop("loop").count)
vocabulary.add
    - "script.loop-progress"
    - "{loop:loop}'s progress"
    - ScriptType(ScriptTypeKind.number, ScriptUnit.percent)
    - :: arguments, context => ScriptValue.number(arguments.loop("loop").progress)
vocabulary.add-alternates(List'String("script.min", "script.max"))
vocabulary.add-alternates
    - List'String("script.loop-number", "script.loop-count", "script.loop-progress")
vocabulary.add-alternates(List'String("script.sin", "script.cos"))
script-add-ranges(vocabulary)

━━━━━━━━━━━━━━━━━━━━
+ script-square-root ScriptValue ?! ScriptError
    - arguments ScriptArguments

?! ScriptError(ScriptErrorKind.out-of-range, "Negative numbers have no square root")
    if value < 0
ScriptValue.number(sqrt(value))

.. value = arguments.number("value")

━━━━━━━━━━━━━━━━━━━━
+ script-mixed ?! ScriptError
    - arguments ScriptArguments

?! ScriptError(ScriptErrorKind.type-mismatch, "A mix needs two numbers, two points, or two colors", arguments.call)
    if !numbers && !points && !colors
script-range-blended
    - ScriptRange(first, last)
    - if colors then max(0.0, min(1.0, position)) else position

.. a = arguments.value("a")
.. b = arguments.value("b")
.. numbers = a.as-number != null && b.as-number != null
.. points = a.as-point != null && b.as-point != null
.. colors = a.as-color != null && b.as-color != null
.. position = arguments.number("position")
.. first = if numbers then ScriptValue.number(a.as-number!) else a
.. last = if numbers then ScriptValue.number(b.as-number!) else b

━━━━━━━━━━━━━━━━━━━━
+ script-angle-between ScriptValue ?! ScriptError
    - arguments ScriptArguments

ScriptValue.number(script-degrees(Point(b.x - a.x, b.y - a.y)))

.. a = arguments.point("a")
.. b = arguments.point("b")

━━━━━━━━━━━━━━━━━━━━
+ script-angle ScriptValue ?! ScriptError
    - arguments ScriptArguments

ScriptValue.number(script-degrees(arguments.point("vector")))

━━━━━━━━━━━━━━━━━━━━
+ script-length ScriptValue ?! ScriptError
    - arguments ScriptArguments

ScriptValue.number(arguments.point("vector").length)

━━━━━━━━━━━━━━━━━━━━
+ script-rotated ScriptValue ?! ScriptError
    - arguments ScriptArguments

ScriptValue.point(arguments.point("point").rotate(radians, arguments.point("center")))

.. radians = arguments.number("angle") as Degrees as Radians

━━━━━━━━━━━━━━━━━━━━
+ script-moved ScriptValue ?! ScriptError
    - arguments ScriptArguments

ScriptValue.point(Point(point.x + distance * cos(radians), point.y + distance * sin(radians)))

.. radians = arguments.number("angle") as Degrees as Radians
.. distance = arguments.number("distance")
.. point = arguments.point("point")

━━━━━━━━━━━━━━━━━━━━
+ script-degrees F64
    - vector Point

atan2(vector.y, vector.x) as Degrees
