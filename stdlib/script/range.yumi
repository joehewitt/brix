./expression
./phrase
./token
./value
/graphics/color
/graphics/point
/math
/math/easing

+ script-range-kind = "script.range"
+ script-range-step-kind = "script.range-step"
+ script-range-over-kind = "script.range-over"
+ script-ease-in-kind = "script.ease-in"
+ script-ease-out-kind = "script.ease-out"
+ script-ease-in-out-kind = "script.ease-in-out"

━━━━━━━━━━━━━━━━━━━━
+ do script-add-ranges'Context
    - vocabulary ScriptVocabulary'Context

. range = ScriptType(ScriptTypeKind.range)
vocabulary.add
    - script-range-kind
    - "{from:any} to {to:any}"
    - range
    - :: arguments, context => script-range-between(arguments)
vocabulary.add
    - script-range-step-kind
    - "{range:range} by {step:number}"
    - range
    - :: arguments, context => script-range-stepped(arguments)
vocabulary.add
    - script-range-over-kind
    - "{range:range} over {loop:loop}"
    - range
    - :: arguments, context => script-range-spread-over(arguments)
vocabulary.add
    - script-ease-in-kind
    - "{range:range} eased in"
    - range
    - :: arguments, context => script-range-eased(arguments, Easing.ease-in)
vocabulary.add
    - script-ease-out-kind
    - "{range:range} eased out"
    - range
    - :: arguments, context => script-range-eased(arguments, Easing.ease-out)
vocabulary.add
    - script-ease-in-out-kind
    - "{range:range} eased in and out"
    - range
    - :: arguments, context => script-range-eased(arguments, Easing.ease-in-out)
vocabulary.add-alternates
    - List'String(script-ease-in-kind, script-ease-out-kind, script-ease-in-out-kind)

━━━━━━━━━━━━━━━━━━━━
+ script-range-between ScriptValue ?! ScriptError
    - arguments ScriptArguments

?! ScriptError(ScriptErrorKind.type-mismatch, "A range can't start or end with another range", arguments.call)
    if first.as-range || last.as-range
?! ScriptError(ScriptErrorKind.type-mismatch, "A range needs two numbers, two points, or two colors", arguments.call)
    if !numbers && !points && !colors
ScriptValue.range(ScriptRange(first, last))

.. first = script-range-end(arguments.value("from"))
.. last = script-range-end(arguments.value("to"))
.. numbers = first.as-number != null && last.as-number != null
.. points = first.as-point != null && last.as-point != null
.. colors = first.as-color != null && last.as-color != null

━━━━━━━━━━━━━━━━━━━━
_ script-range-end ScriptValue
    - value ScriptValue

if value.as-loop then ScriptValue.number(value.as-number!) else value

━━━━━━━━━━━━━━━━━━━━
+ script-range-stepped ScriptValue ?! ScriptError
    - arguments ScriptArguments

?! ScriptError(ScriptErrorKind.type-mismatch, "This range already has a step", arguments.call)
    if range.counted
?! ScriptError(ScriptErrorKind.type-mismatch, "A list can't have a step", arguments.call)
    if range.items.length
?! ScriptError(ScriptErrorKind.type-mismatch, "Colors can't step; leave out “by”", arguments.call)
    if range.first.as-color
?! ScriptError(ScriptErrorKind.out-of-range, "A step must be more than 0", arguments.call)
    if size == 0
ScriptValue.range(range.with-step(size))

.. range = arguments.range("range")
.. size = abs(arguments.number("step"))

━━━━━━━━━━━━━━━━━━━━
+ script-range-spread-over ScriptValue ?! ScriptError
    - arguments ScriptArguments

ScriptValue.range(arguments.range("range").with-over(arguments.loop("loop")))

━━━━━━━━━━━━━━━━━━━━
+ script-range-eased ScriptValue ?! ScriptError
    - arguments ScriptArguments
    - easing Easing

?! ScriptError(ScriptErrorKind.type-mismatch, "A list can't be eased", arguments.call)
    if range.items.length
ScriptValue.range(range.with-easing(easing))

.. range = arguments.range("range")

━━━━━━━━━━━━━━━━━━━━
+ ScriptSpreads

+ plain = false
+ counted = false
+ variables [U64]

━━━━━━━━━━━━━━━━━━━━
+ do script-spreads ScriptSpreads
    - expression ScriptExpression

. found = ScriptSpreads()
script-spreads-into(expression, found)
= found

━━━━━━━━━━━━━━━━━━━━
_ do script-spreads-into
    - expression ScriptExpression
    - found ScriptSpreads

do match expression
    | phrase ScriptPhraseExpression
        if phrase.kind == script-range-over-kind
            . loop = phrase.arguments["loop"]
            if loop
                script-spreads-into(loop, found)
            =
        if phrase.kind == script-range-step-kind
            found.counted = true
        else if phrase.kind == script-range-kind
            found.plain = true
        for slot, argument in phrase.arguments
            script-spreads-into(argument, found)
    | list ScriptListExpression
        found.plain = true
        for item in list.items
            script-spreads-into(item, found)
    | reference ScriptReferenceExpression
        if reference.reference.kind == ScriptReferenceKind.variable && !already-found
            found.variables += reference.reference.id
        .. already-found = found.variables has reference.reference.id
    | negation ScriptNegation
        script-spreads-into(negation.operand, found)
    | binary ScriptBinary
        script-spreads-into(binary.left, found)
        script-spreads-into(binary.right, found)
    | point ScriptPointExpression
        script-spreads-into(point.x, found)
        script-spreads-into(point.y, found)
    | group ScriptGroup
        script-spreads-into(group.inner, found)
    ??
        =

━━━━━━━━━━━━━━━━━━━━
+ script-range-turns Bool
    - range ScriptRange

|? range.items.length || !start || !end
    false
|? span < 1
    false
??
    abs(turns - round(turns)) < 0.000001 && round(turns) >= 1

.. start = range.first.as-number
.. end = range.last.as-number
.. span = abs(end - start)
.. turns = span / 360

━━━━━━━━━━━━━━━━━━━━
+ script-range-count Index ?! ScriptError
    - range ScriptRange

|? range.items.length
    range.items.length
|? !range.step
    1
??
    ?! ScriptError(ScriptErrorKind.out-of-range, "That makes $result copies; the most is $script-range-limit")
        if result > script-range-limit
    result

.. result = (script-range-reach(range) as Index) + 1

━━━━━━━━━━━━━━━━━━━━
_ do script-range-reach ?! ScriptError
    - range ScriptRange

. size = abs(range.step!)
?! ScriptError(ScriptErrorKind.out-of-range, "A step must be more than 0")
    if size == 0 || !is-finite(size)
. span = script-range-distance(range)
. steps = floor(span / size + 0.000001)
if range.wraps && steps > 0 && abs(steps * size - span) < 0.000001 * max(1.0, span)
    steps -= 1
= steps

━━━━━━━━━━━━━━━━━━━━
+ script-range-step ?! ScriptError
    - range ScriptRange
    - position ScriptLoop?

|? length
    ScriptLoop(id, (((number - 1) as Index) % length + 1) as F64, length as F64)
|? range.step
    ScriptLoop(id, min(number, count), count)
??
    ScriptLoop(id, number, if position then position.count else 1.0)

.. id = if position then position.id else 0u64
.. number = if position then max(1.0, position.number) else 1.0
.. length = range.items.length
.. count = script-range-reach(range) + 1

━━━━━━━━━━━━━━━━━━━━
+ do script-range-distance F64 ?! ScriptError
    - range ScriptRange

. start = range.first.as-number
. end = range.last.as-number
=? abs(end - start) if start && end
. first-point = range.first.as-point
. last-point = range.last.as-point
=? first-point.distance(last-point) if first-point && last-point
?! ScriptError(ScriptErrorKind.type-mismatch, "Only numbers and points can step")

━━━━━━━━━━━━━━━━━━━━
+ do script-range-at ScriptValue ?! ScriptError
    - range ScriptRange
    - number F64
    - count F64

. index = max(0.0, number - 1)
if range.items.length
    = range.items[(index as Index) % range.items.length]
if range.step
    . size = abs(range.step)
    . span = script-range-distance(range)
    . held = min(index, script-range-reach(range))
    . t = if span > 0 then min(1.0, held * size / span) else 0.0
    . start = range.first.as-number
    . end = range.last.as-number
    if start && end && range.easing == Easing.linear
        . direction = if end >= start then 1.0 else -1.0
        = if t < 1 then ScriptValue.number(start + direction * size * held) else range.last
    = script-range-blended(range, range.easing.eased(t))
. spans = if range.wraps then count else count - 1
. t = if spans > 0 then min(1.0, index / spans) else 0.0
= script-range-blended(range, range.easing.eased(t))

━━━━━━━━━━━━━━━━━━━━
+ do script-range-blended ?! ScriptError
    - range ScriptRange
    - t F64

=? range.first if t == 0
=? range.last if t == 1
. start = range.first.as-number
. end = range.last.as-number
=? ScriptValue.number(start * (1 - t) + end * t) if start && end
. first-point = range.first.as-point
. last-point = range.last.as-point
if first-point && last-point
    . x = first-point.x * (1 - t) + last-point.x * t
    = ScriptValue.point(Point(x, first-point.y * (1 - t) + last-point.y * t))
. first-color = range.first.as-color
. last-color = range.last.as-color
if first-color && last-color
    . red = first-color.red * (1 - t) + last-color.red * t
    . green = first-color.green * (1 - t) + last-color.green * t
    . blue = first-color.blue * (1 - t) + last-color.blue * t
    = ScriptValue.color(RGBA(red, green, blue, first-color.alpha * (1 - t) + last-color.alpha * t))
?! ScriptError(ScriptErrorKind.type-mismatch, "A range needs two numbers, two points, or two colors")
