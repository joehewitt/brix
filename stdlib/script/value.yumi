/graphics/color
/graphics/point
/math
/math/easing

+ script-any-type = ScriptType(ScriptTypeKind.any)
+ script-number-type = ScriptType(ScriptTypeKind.number)
+ script-truth-type = ScriptType(ScriptTypeKind.truth)
+ script-range-limit Index = 10000

━━━━━━━━━━━━━━━━━━━━
+ ScriptNode is Tuple

+ id U64
+ kind String

━━━━━━━━━━━━━━━━━━━━
+ ScriptNodePart is Tuple

+ node ScriptNode
+ kind String
+ number Index

━━━━━━━━━━━━━━━━━━━━
+ ScriptLoop is Tuple

+ id U64
+ number F64
+ count F64

────────────────────
+ get progress F64

if count > 1 then (number - 1) / (count - 1) else 0

━━━━━━━━━━━━━━━━━━━━
+ ScriptValue is Union

| number F64
| point Point
| color RGBA
| text String
| node ScriptNode
| nodes [ScriptNode]
| loop ScriptLoop
| range ScriptRange
| part ScriptNodePart
| parts [ScriptNodePart]
| truth Bool

────────────────────
+ get as-truth Bool?

match? this
    | .truth(value)
        value

────────────────────
+ get as-part

match? this
    | .part(value)
        value

────────────────────
+ get as-parts

match? this
    | .parts(value)
        value

────────────────────
+ get as-number F64?

match? this
    | .number(value)
        value
    | .loop(value)
        value.number

────────────────────
+ get as-point Point?

match? this
    | .point(value)
        value

────────────────────
+ get as-color RGBA?

match? this
    | .color(value)
        value

────────────────────
+ get as-text String?

match? this
    | .text(value)
        value

────────────────────
+ get as-node ScriptNode?

match? this
    | .node(value)
        value

────────────────────
+ get as-nodes [ScriptNode]?

match? this
    | .nodes(value)
        value

────────────────────
+ get as-loop ScriptLoop?

match? this
    | .loop(value)
        value

────────────────────
+ get as-range ScriptRange?

match? this
    | .range(value)
        value

━━━━━━━━━━━━━━━━━━━━
+ ScriptRange

+ first ScriptValue
+ last ScriptValue
+ step F64?
+ items [ScriptValue]
+ easing Easing
+ wraps Bool
+ over ScriptLoop?
+ origin U64
+ ordinal Index

────────────────────
+ This
    - first
    - last
    - step F64? = null
    - items [ScriptValue] = List'ScriptValue()
    - easing = Easing.linear
    - wraps = false
    - over ScriptLoop? = null
    - origin U64 = 0
    - ordinal Index = 0

────────────────────
+ get counted

step != null

────────────────────
+ with-step ScriptRange
    - size F64

ScriptRange(first, last, size, items, easing, wraps, over, origin, ordinal)

────────────────────
+ with-easing ScriptRange
    - curve Easing

ScriptRange(first, last, step, items, curve, wraps, over, origin, ordinal)

────────────────────
+ with-wraps ScriptRange
    - turning Bool

ScriptRange(first, last, step, items, easing, turning, over, origin, ordinal)

────────────────────
+ with-over ScriptRange
    - loop ScriptLoop

ScriptRange(first, last, step, items, easing, wraps, loop, origin, ordinal)

────────────────────
+ with-origin ScriptRange
    - source U64
    - index Index

ScriptRange(first, last, step, items, easing, wraps, over, source, index)

────────────────────
+ with-ends ScriptRange
    - start ScriptValue
    - end ScriptValue
    - values [ScriptValue]
    - size F64? = null

ScriptRange(start, end, size, values, easing, wraps, over, origin, ordinal)

────────────────────
+ same-source Bool
    - other ScriptRange

origin == other.origin && ordinal == other.ordinal

━━━━━━━━━━━━━━━━━━━━
+ ScriptTypeKind is Union

| any
| number
| point
| color
| text
| node
| nodes
| loop
| range
| part
| parts
| truth

━━━━━━━━━━━━━━━━━━━━
+ ScriptUnit is Union

| none
| degrees
| percent

────────────────────
+ get suffix

match this
    |= .degrees
        "°"
    |= .percent
        "%"
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ ScriptType is Tuple

+ kind ScriptTypeKind
+ unit = ScriptUnit.none
+ whole = false
+ node-kind = ""
+ part-kind = ""

────────────────────
+ to String

match kind
    |= .number
        |? whole
            "whole number"
        |? unit == ScriptUnit.degrees
            "angle"
        |? unit == ScriptUnit.percent
            "percentage"
        ??
            "number"
    |= .point
        "point"
    |= .color
        "color"
    |= .text
        "text"
    |= .node
        if node-kind.length then node-kind else "node"
    |= .nodes
        "nodes"
    |= .loop
        "loop"
    |= .range
        "range"
    |= .part
        if part-kind.length then part-kind else "part"
    |= .parts
        "${if part-kind.length then part-kind else "part"} list"
    |= .truth
        "condition"
    ??
        "value"

────────────────────
+ get described

match kind
    |= .text
        "text"
    |= .nodes
        "nodes"
    ??
        "${script-article(name)} $name"

.. name = "$this"

────────────────────
+ do converted ScriptValue?
    - value ScriptValue

do match kind
    |= .any
        = value
    |= .number
        . number = value.as-number
        |? !number
            = null
        |? whole && number != round(number)
            = null
        ??
            = ScriptValue.number(number)
    |= .nodes
        . node = value.as-node
        =? ScriptValue.nodes(List'ScriptNode(node)) if node && accepts-kind(node)
        . nodes = value.as-nodes
        =? null if !nodes
        for each in nodes
            =? null if !accepts-kind(each)
        = value
    |= .node
        . node = value.as-node
        =? value if node && accepts-kind(node)
        = null
    |= .point
        = value if value.as-point
    |= .color
        = value if value.as-color
    |= .text
        = value if value.as-text
    |= .loop
        = value if value.as-loop
    |= .range
        = value if value.as-range
    |= .part
        . part = value.as-part
        =? value if part && accepts-part(part)
        = null
    |= .parts
        . part = value.as-part
        =? ScriptValue.parts(List'ScriptNodePart(part)) if part && accepts-part(part)
        . parts = value.as-parts
        =? null if !parts
        for each in parts
            =? null if !accepts-part(each)
        = value
    |= .truth
        = value if value.as-truth != null

────────────────────
+ accepts-part
    - part ScriptNodePart

part-kind.length == 0 || part.kind == part-kind

────────────────────
+ accepts-kind
    - node ScriptNode

node-kind.length == 0 || node.kind == node-kind

────────────────────
+ admits Bool
    - actual ScriptType

|? kind == ScriptTypeKind.any || actual.kind == ScriptTypeKind.any
    true
|? kind == ScriptTypeKind.nodes && actual.kind == ScriptTypeKind.node
    admits-kind(actual.node-kind)
|? kind == ScriptTypeKind.parts && actual.kind == ScriptTypeKind.part
    admits-part(actual.part-kind)
|? kind == ScriptTypeKind.number && actual.kind == ScriptTypeKind.loop
    true
|? actual.kind == ScriptTypeKind.range
    kind == .range || kind == .loop || kind == .number || kind == .point || kind == .color
|? kind != actual.kind
    false
|? kind == ScriptTypeKind.node || kind == ScriptTypeKind.nodes
    admits-kind(actual.node-kind)
|? kind == ScriptTypeKind.part || kind == ScriptTypeKind.parts
    admits-part(actual.part-kind)
??
    true

────────────────────
+ admits-kind
    - actual String

node-kind.length == 0 || actual.length == 0 || actual == node-kind

────────────────────
+ admits-part
    - actual String

part-kind.length == 0 || actual.length == 0 || actual == part-kind

────────────────────
+ get without-unit

ScriptType(kind)
    • node-kind node-kind
    • part-kind part-kind

━━━━━━━━━━━━━━━━━━━━
+ script-value-type ScriptType
    - value ScriptValue

match value
    | .number
        script-number-type
    | .point
        ScriptType(ScriptTypeKind.point)
    | .color
        ScriptType(ScriptTypeKind.color)
    | .text
        ScriptType(ScriptTypeKind.text)
    | .node(node)
        ScriptType(ScriptTypeKind.node) • node-kind node.kind
    | .nodes
        ScriptType(ScriptTypeKind.nodes)
    | .loop
        ScriptType(ScriptTypeKind.loop)
    | .range
        ScriptType(ScriptTypeKind.range)
    | .part(part)
        ScriptType(ScriptTypeKind.part) • part-kind part.kind
    | .parts(parts)
        ScriptType(ScriptTypeKind.parts) • part-kind if parts.length then parts[0].kind else ""
    | .truth
        script-truth-type

━━━━━━━━━━━━━━━━━━━━
+ script-type-named ScriptType?
    - name String
    - node-kinds [String]
    - part-kinds [String] = List'String()

match? name
    |= "any"
        script-any-type
    |= "number"
        script-number-type
    |= "whole"
        ScriptType(ScriptTypeKind.number) • whole true
    |= "degrees"
        ScriptType(ScriptTypeKind.number, ScriptUnit.degrees)
    |= "percent"
        ScriptType(ScriptTypeKind.number, ScriptUnit.percent)
    |= "point"
        ScriptType(ScriptTypeKind.point)
    |= "color"
        ScriptType(ScriptTypeKind.color)
    |= "text"
        ScriptType(ScriptTypeKind.text)
    |= "node"
        ScriptType(ScriptTypeKind.node)
    |= "nodes"
        ScriptType(ScriptTypeKind.nodes)
    |= "loop"
        ScriptType(ScriptTypeKind.loop)
    |= "range"
        ScriptType(ScriptTypeKind.range)
    |= "truth"
        script-truth-type
    |? node-kinds has name
        ScriptType(ScriptTypeKind.node) • node-kind name
    |? part-kinds has name
        ScriptType(ScriptTypeKind.part) • part-kind name
    |? script-singular(name, part-kinds) != null
        ScriptType(ScriptTypeKind.parts) • part-kind script-singular(name, part-kinds)!

━━━━━━━━━━━━━━━━━━━━
+ script-plural
    - noun String

if noun.ends-with("ex") then "${noun[0 .. < noun.length - 2]}ices" else "${noun}s"

━━━━━━━━━━━━━━━━━━━━
+ do script-singular
    - name String
    - nouns [String]

for noun in nouns
    =? noun if script-plural(noun) == name
= null

━━━━━━━━━━━━━━━━━━━━
+ script-type-name String
    - type ScriptType

match type.kind
    |= .number
        |? type.whole
            "whole"
        |? type.unit == ScriptUnit.degrees
            "degrees"
        |? type.unit == ScriptUnit.percent
            "percent"
        ??
            "number"
    |= .point
        "point"
    |= .color
        "color"
    |= .text
        "text"
    |= .node
        if type.node-kind.length then type.node-kind else "node"
    |= .nodes
        "${if type.node-kind.length then type.node-kind else "node"}s"
    |= .loop
        "loop"
    |= .range
        "range"
    |= .part
        if type.part-kind.length then type.part-kind else "part"
    |= .parts
        script-plural(if type.part-kind.length then type.part-kind else "part")
    |= .truth
        "truth"
    ??
        "any"

━━━━━━━━━━━━━━━━━━━━
+ script-number-text String
    - value F64

if rounded == 0 then "0" else "$rounded"

.. rounded = round(value * 10000) / 10000

━━━━━━━━━━━━━━━━━━━━
+ script-color-text
    - color RGBA

"#$r$g$b$a"

.. r = (color-channel-byte(color.red) as Hex)[2 .. < 4]
.. g = (color-channel-byte(color.green) as Hex)[2 .. < 4]
.. b = (color-channel-byte(color.blue) as Hex)[2 .. < 4]
.. a = if color.alpha < 1 then (color-channel-byte(color.alpha) as Hex)[2 .. < 4] else ""

━━━━━━━━━━━━━━━━━━━━
+ script-article
    - noun String

if noun.length && "aeiou".find(noun[0 .. < 1]) != null then "an" else "a"

━━━━━━━━━━━━━━━━━━━━
+ script-value-described
    - value ScriptValue

match value
    | .number
        "a number"
    | .point
        "a point"
    | .color
        "a color"
    | .text
        "text"
    | .node(node)
        if node.kind.length then "${script-article(node.kind)} ${node.kind}" else "a node"
    | .nodes
        "nodes"
    | .loop
        "a loop"
    | .range
        "a range"
    | .part(part)
        "${script-article(part.kind)} ${part.kind}"
    | .parts
        script-value-type(value).described
    | .truth
        "true or false"
