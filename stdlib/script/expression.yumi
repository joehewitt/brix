━━━━━━━━━━━━━━━━━━━━
+ ScriptErrorKind is Union

| incomplete
| unresolved
| type-mismatch
| missing
| out-of-range
| division-by-zero
| non-finite
| unknown-phrase
| failed
| dependency

━━━━━━━━━━━━━━━━━━━━
+ ScriptError is Error

+ kind ScriptErrorKind
+ subtree ScriptExpression?

────────────────────
+ This
    - kind
    - text String
    - subtree ScriptExpression? = null

message = text

━━━━━━━━━━━━━━━━━━━━
+ do script-literal-value ScriptValue?
    - expression ScriptExpression

do match expression
    | literal ScriptLiteral
        = literal.value
    | reference ScriptReferenceExpression
        =? null if reference.reference.kind != ScriptReferenceKind.node || reference.reference.copy
        = ScriptValue.node(ScriptNode(reference.reference.id, ""))
    | negation ScriptNegation
        . number = script-literal-value(negation.operand)?.as-number
        =? ScriptValue.number(-number) if number
        = null
    | point ScriptPointExpression
        . x = script-literal-value(point.x)?.as-number
        . y = script-literal-value(point.y)?.as-number
        =? ScriptValue.point(Point(x, y)) if x && y
        = null
    | group ScriptGroup
        = script-literal-value(group.inner)
    ??
        = null

━━━━━━━━━━━━━━━━━━━━
+ do script-is-complete Bool
    - expression ScriptExpression

do match expression
    | negation ScriptNegation
        = script-is-complete(negation.operand)
    | binary ScriptBinary
        = script-is-complete(binary.left) && script-is-complete(binary.right)
    | point ScriptPointExpression
        = script-is-complete(point.x) && script-is-complete(point.y)
    | group ScriptGroup
        = script-is-complete(group.inner)
    | phrase ScriptPhraseExpression
        = all(phrase.arguments.values) • where script-is-complete(each)
    | list ScriptListExpression
        = all(list.items) • where script-is-complete(each)
    | literal ScriptLiteral
        = true
    | reference ScriptReferenceExpression
        = true
    ??
        = false
