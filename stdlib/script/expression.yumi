+ x ScriptExpression
+ y ScriptExpression
+ closed Bool

────────────────────
+ This
    - x
    - y
    - closed = true

━━━━━━━━━━━━━━━━━━━━
+ ScriptGroup is ScriptExpression

+ inner ScriptExpression
+ closed Bool

────────────────────
+ This
    - inner
    - closed = true

━━━━━━━━━━━━━━━━━━━━
+ ScriptPhraseExpression is ScriptExpression

+ kind String
+ arguments [String = ScriptExpression]

────────────────────
+ This
    - kind
    - arguments [String = ScriptExpression] = Map'String'ScriptExpression()

