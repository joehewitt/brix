./token
./value
/graphics/point
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ ScriptPrecedence is Union

| slot
| comparison
| range
| sum
| product
| prefix
| postfix
| atom

────────────────────
+ get level Size

match this
    |= .slot
        0
    |= .comparison
        1
    |= .range
        2
    |= .sum
        3
    |= .product
        4
    |= .prefix
        5
    |= .postfix
        6
    ??
        7

━━━━━━━━━━━━━━━━━━━━
+ ScriptOperator is Union

| add
| subtract
| multiply
| divide
| remainder
| less
| greater
| at-most
| at-least
| equal
| unequal

────────────────────
+ get symbol

match this
    |= .add
        "+"
    |= .subtract
        "-"
    |= .multiply
        "*"
    |= .divide
        "/"
    |= .less
        "<"
    |= .greater
        ">"
    |= .at-most
        "<="
    |= .at-least
        ">="
    |= .equal
        "="
    |= .unequal
        "!="
    ??
        "%"

────────────────────
+ get compares Bool

match this
    |= .less
        true
    |= .greater
        true
    |= .at-most
        true
    |= .at-least
        true
    |= .equal
        true
    |= .unequal
        true
    ??
        false

────────────────────
+ get precedence

|? compares
    ScriptPrecedence.comparison
|? this == ScriptOperator.add || this == ScriptOperator.subtract
    ScriptPrecedence.sum
??
    ScriptPrecedence.product

━━━━━━━━━━━━━━━━━━━━
+ script-operator-named ScriptOperator?
    - symbol String

match? symbol
    |= "+"
        ScriptOperator.add
    |= "-"
        ScriptOperator.subtract
    |= "*"
        ScriptOperator.multiply
    |= "/"
        ScriptOperator.divide
    |= "%"
        ScriptOperator.remainder
    |= "<"
        ScriptOperator.less
    |= ">"
        ScriptOperator.greater
    |= "<="
        ScriptOperator.at-most
    |= ">="
        ScriptOperator.at-least
    |= "="
        ScriptOperator.equal
    |= "!="
        ScriptOperator.unequal

