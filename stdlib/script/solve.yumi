/math

+ script-solve-tolerance = 0.000001
+ script-solve-limit Index = 24
+ script-solve-nudge = 0.001
+ script-solve-noise = 0.0000000000001

━━━━━━━━━━━━━━━━━━━━
+ ScriptSolveFunction is () [F64]?
    - value F64

━━━━━━━━━━━━━━━━━━━━
+ ScriptSolution is Tuple

+ value F64
+ numbers [F64]
+ distance F64
+ reached Bool
+ steps Index

━━━━━━━━━━━━━━━━━━━━
+ do script-solve
    - measure ScriptSolveFunction
    - start F64
    - goal [F64]
    - tolerance F64 = script-solve-tolerance
    - limit = script-solve-limit

. count = goal.length
. first = script-solve-sample(measure, start, count)
=? null if !first
. close = max(tolerance, script-solve-noise)
. value = start
. numbers = first
. distance = script-solve-distance(numbers, goal)
. steps Index = 0
. upper F64? = null
. lower F64? = null
while steps < limit && distance > close
    . nudge = script-solve-nudge-at(value)
    . ahead-at = value + nudge
    . behind-at = value - nudge
    . ahead = script-solve-sample(measure, ahead-at, count) if !upper || ahead-at < upper
    . behind = script-solve-sample(measure, behind-at, count) if !lower || behind-at > lower
    if !ahead && !behind
        break
    if !ahead && !upper
        upper = ahead-at
    if !behind && !lower
        lower = behind-at
    . gaps [F64]
    . slopes [F64]
    . bends [F64]
    . gain = 0.0
    . pull = 0.0
    . curve = 0.0
    for index in 0 .. < count
        . here = numbers[index]
        . slope =
            |? ahead && behind
                (ahead[index] - behind[index]) / (2 * nudge)
            |? ahead
                (ahead[index] - here) / nudge
            ??
                (here - behind![index]) / nudge
        . bend =
            |? ahead && behind
                (ahead[index] - 2 * here + behind[index]) / (nudge * nudge)
            ??
                0.0
        gaps += goal[index] - here
        slopes += slope
        bends += bend
        gain += slope * slope
        pull += slope * (goal[index] - here)
        curve += bend * bend
    . steepness = sqrt(gain)
    . bending = sqrt(curve)
    . direction =
        |? pull > 0
            1.0
        |? pull < 0
            -1.0
        |? !behind
            1.0
        |? !ahead
            -1.0
        ??
            script-solve-nearer-side(ahead, behind, goal)
    . delta = direction * script-solve-reach(gaps, slopes, bends, direction, nudge)
    if script-solve-travel(steepness, bending, delta) <= close / 2
        break
    . wall = if delta > 0 then upper ?? lower else lower
    . blocked = false
    if wall && abs(delta) >= abs(wall - value)
        delta = (wall - value) / 2
        blocked = true
    . taken = 0.0
    . best = numbers
    . closest = distance
    while script-solve-travel(steepness, bending, delta) > close / 2
        . spot = value + taken + delta
        . trial = script-solve-sample(measure, spot, count)
        if !trial
            if delta > 0
                upper = spot
            else
                lower = spot
            delta /= 2
            continue
        . miss = script-solve-distance(trial, goal)
        if miss < closest
            taken += delta
            best = trial
            closest = miss
            if !blocked
                break
        delta /= 2
    if taken == 0
        break
    value += taken
    numbers = best
    distance = closest
    steps += 1
= ScriptSolution(value, numbers, distance, distance <= close, steps)

━━━━━━━━━━━━━━━━━━━━
+ do script-solve-moves
    - measure ScriptSolveFunction
    - value F64

. moves [Bool]
. numbers = measure(value)
=? moves if !numbers
. count = numbers.length
. nudge = script-solve-nudge-at(value)
. ahead = script-solve-sample(measure, value + nudge, count)
. behind = script-solve-sample(measure, value - nudge, count)
for index in 0 .. < count
    . here = numbers[index]
    . least = script-solve-noise * max(1.0, abs(here))
    . forward = !ahead || abs(ahead[index] - here) > least
    . backward = !behind || abs(behind[index] - here) > least
    moves += (ahead != null || behind != null) && forward && backward
= moves

━━━━━━━━━━━━━━━━━━━━
+ do script-solve-rounded
    - measure ScriptSolveFunction
    - value F64
    - tolerance F64 = script-solve-tolerance
    - scale = 1.0

. full = measure(value)
=? value if !full
. factor = scale
. rounded = value
for places in 0 .. 4
    rounded = round(value * factor) / factor
    . numbers = script-solve-sample(measure, rounded, full.length)
    =? rounded if numbers && script-solve-distance(numbers, full) <= tolerance
    factor *= 10
=? rounded if script-solve-sample(measure, rounded, full.length)
= value

━━━━━━━━━━━━━━━━━━━━
+ do script-solve-track
    - measure ScriptSolveFunction
    - start F64
    - stride F64
    - reach F64
    - limit Index = 256

. samples [[F64]]
. first = measure(start)
=? samples if !first
for number in first
    =? samples if !is-finite(number)
if stride <= 0
    samples += first
    = samples
. ahead = script-solve-walk(measure, start, first, 1.0, stride, reach, limit)
if !ahead.closed
    . behind = script-solve-walk(measure, start, first, -1.0, stride, reach, limit).samples
    . index = behind.length
    while index > 0
        index -= 1
        samples += behind[index]
samples += first
for sample in ahead.samples
    samples += sample
= samples

━━━━━━━━━━━━━━━━━━━━
_ ScriptSolveWalk is Tuple

+ samples [[F64]]
+ closed Bool

━━━━━━━━━━━━━━━━━━━━
_ do script-solve-walk
    - measure ScriptSolveFunction
    - start F64
    - first [F64]
    - direction F64
    - stride F64
    - reach F64
    - limit Index

. samples [[F64]]
. count = first.length
. value = start
. here = first
. step = script-solve-nudge-at(start)
. low = 0.0
. high F64? = null
. jumped [F64]? = null
. heading [F64]? = null
. left = false
. budget = limit * 8
while samples.length < limit && budget > 0
    budget -= 1
    . trial = script-solve-sample(measure, value + direction * step, count)
    . moved = if trial then script-solve-distance(trial, here) else 0.0
    . far = !trial || moved > stride * 2
    if far || moved < stride / 2
        if !high || high - low > script-solve-nudge-at(value) * 0.000001
            if far
                high = step
                jumped = trial
                step = (low + step) / 2
            else
                low = step
                =? ScriptSolveWalk(samples, false)
                    if !high && step > script-solve-nudge-at(value) * 1000000000
                step = if high then (low + high) / 2 else step * 2
            continue
        if jumped
            trial = jumped
            step = high
        else
            if !trial
                step = low
                trial = script-solve-sample(measure, value + direction * step, count)
                moved = if trial then script-solve-distance(trial, here) else 0.0
            =? ScriptSolveWalk(samples, false) if !trial || moved < stride / 16
    . previous = here
    value += direction * step
    here = trial!
    samples += here
    . gone = script-solve-distance(here, previous)
    if gone > 0
        step *= stride / gone
    low = 0.0
    high = null
    jumped = null
    . strayed = script-solve-distance(here, first)
    =? ScriptSolveWalk(samples, false) if strayed > reach
    if !heading
        heading = script-solve-gap(here, first)
    left = left || strayed > stride * 3
    . back = left && strayed <= stride * 2
    if back && script-solve-along(script-solve-gap(here, previous), heading) > 0
        samples += first
        = ScriptSolveWalk(samples, true)
= ScriptSolveWalk(samples, false)

━━━━━━━━━━━━━━━━━━━━
_ script-solve-gap
    - numbers [F64]
    - origin [F64]

List'F64(numbers[each] - origin[each] in 0 .. < origin.length)

━━━━━━━━━━━━━━━━━━━━
_ do script-solve-along
    - left [F64]
    - right [F64]

. total = 0.0
for index in 0 .. < right.length
    total += left[index] * right[index]
= total

━━━━━━━━━━━━━━━━━━━━
_ script-solve-nudge-at
    - value F64

script-solve-nudge * max(1.0, abs(value))

━━━━━━━━━━━━━━━━━━━━
_ do script-solve-sample
    - measure ScriptSolveFunction
    - value F64
    - count Index

. numbers = measure(value)
=? null if !numbers
=? null if numbers.length != count
for number in numbers
    =? null if !is-finite(number)
= numbers

━━━━━━━━━━━━━━━━━━━━
_ do script-solve-distance
    - numbers [F64]
    - goal [F64]

. total = 0.0
for index in 0 .. < goal.length
    . gap = goal[index] - numbers[index]
    total += gap * gap
= sqrt(total)

━━━━━━━━━━━━━━━━━━━━
_ script-solve-nearer-side
    - ahead [F64]
    - behind [F64]
    - goal [F64]

if script-solve-distance(ahead, goal) <= script-solve-distance(behind, goal) then 1.0 else -1.0

━━━━━━━━━━━━━━━━━━━━
_ script-solve-travel
    - steepness F64
    - bending F64
    - delta F64

steepness * abs(delta) + bending * delta * delta / 2

━━━━━━━━━━━━━━━━━━━━
_ do script-solve-descent
    - gaps [F64]
    - slopes [F64]
    - bends [F64]
    - delta F64

. total = 0.0
for index in 0 .. < gaps.length
    . left = gaps[index] - slopes[index] * delta - bends[index] * delta * delta / 2
    total += left * (slopes[index] + bends[index] * delta)
= total

━━━━━━━━━━━━━━━━━━━━
_ do script-solve-reach
    - gaps [F64]
    - slopes [F64]
    - bends [F64]
    - direction F64
    - nudge F64

. high = nudge
. doublings = 0
while doublings < 64 && direction * script-solve-descent(gaps, slopes, bends, direction * high) > 0
    high *= 2
    doublings += 1
. low = if doublings > 0 then high / 2 else 0.0
for index in 0 .. < 60
    . middle = (low + high) / 2
    if direction * script-solve-descent(gaps, slopes, bends, direction * middle) > 0
        low = middle
    else
        high = middle
= low
