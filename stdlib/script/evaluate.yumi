./expression
./phrase
./range
./token
./value
/graphics/point
/math

━━━━━━━━━━━━━━━━━━━━
+ ScriptEnvironment is Interface

────────────────────
+ do resolve ScriptValue ?! Error
    - reference ScriptReference

────────────────────
+ spread ScriptLoop? ?! ScriptError
    - range ScriptRange

null

━━━━━━━━━━━━━━━━━━━━
+ ScriptEvaluation is Interface

────────────────────
+ do evaluate ScriptValue ?! ScriptError
    - expression ScriptExpression
    - expected ScriptType

━━━━━━━━━━━━━━━━━━━━
+ ScriptEvaluator'Context
    is ScriptEvaluation

+ vocabulary ScriptVocabulary'Context
+ context Context
+ environment ScriptEnvironment

_ holding = false
_ unit = ScriptUnit.none
_ ordinals Index = 0

────────────────────
+ This
    - vocabulary
    - context
    - environment

────────────────────
+ do evaluate ScriptValue ?! ScriptError
    - expression ScriptExpression
    - expected ScriptType

holding = expected.kind == ScriptTypeKind.any || expected.kind == ScriptTypeKind.range
unit = expected.unit
= conform(settled(value-of(expression), expression), expected, expression)

────────────────────
_ conform ScriptValue ?! ScriptError
    - value ScriptValue
    - expected ScriptType
    - expression ScriptExpression

|? converted
    converted
??
    ?! ScriptError(ScriptErrorKind.type-mismatch, "Expected ${expected.described}, not ${script-value-described(value)}", expression)
        if !convert
    conform(coerced(convert, value, expression), expected, expression)

.. converted = expected.converted(value)
.. convert = vocabulary.converter(value, expected)

────────────────────
_ do coerced ?! ScriptError
    - convert ScriptConversionFunction'Context
    - value ScriptValue
    - expression ScriptExpression

. result = catch convert(value, context)
do match result
    | error ScriptError
        ?! script-located(error, expression)
    | error Error
        ?! ScriptError(ScriptErrorKind.failed, error.message, expression)
    | found ScriptValue
        = found

────────────────────
_ operand ?! ScriptError
    - value ScriptValue
    - expression ScriptExpression

if !convert then value else coerced(convert, value, expression)

.. convert = vocabulary.operand-converter(value)

────────────────────
_ do value-of ScriptValue ?! ScriptError
    - expression ScriptExpression

do match expression
    | literal ScriptLiteral
        = literal.value
    | reference ScriptReferenceExpression
        = resolved(reference)
    | negation ScriptNegation
        . inner = settled(value-of(negation.operand), negation.operand)
        = negated(operand(inner, negation.operand), negation)
    | binary ScriptBinary
        . left = operand(settled(value-of(binary.left), binary.left), binary.left)
        . right = operand(settled(value-of(binary.right), binary.right), binary.right)
        = combined(binary, left, right)
    | point ScriptPointExpression
        . saved = unit
        unit = ScriptUnit.none
        . x = settled(value-of(point.x), point.x)
        . y = settled(value-of(point.y), point.y)
        unit = saved
        = pointed(x, y, point)
    | list ScriptListExpression
        = listed(list)
    | group ScriptGroup
        = value-of(group.inner)
    | phrase ScriptPhraseExpression
        = called(phrase)
    | unresolved ScriptUnresolved
        ?! script-unresolved-error(unresolved)
    | sequence ScriptSequence
        for item in sequence.items
            if item is ScriptUnresolved
                ?! script-unresolved-error(item as ScriptUnresolved)
        ?! ScriptError(ScriptErrorKind.unresolved, "Missing an operator", sequence)
    ?! ScriptError(ScriptErrorKind.incomplete, "Incomplete expression", expression)

────────────────────
_ number-of F64 ?! ScriptError
    - value ScriptValue
    - expression ScriptExpression

?! ScriptError(ScriptErrorKind.type-mismatch, "Expected a number, not ${script-value-described(value)}", expression)
    if !number
number

.. number = value.as-number

────────────────────
_ do settled ScriptValue ?! ScriptError
    - value ScriptValue
    - expression ScriptExpression

. range = value.as-range
=? value if !range
. prepared = range.with-wraps(unit == ScriptUnit.degrees && script-range-turns(range))
. position = position-of(prepared, expression)
=? value if !position && holding
. number = if position then position.number else 1.0
. count = if position then position.count else 1.0
. result = catch script-range-at(prepared, number, count)
do match result
    | error ScriptError
        ?! script-located(error, expression)
    | found ScriptValue
        = found

────────────────────
_ do stepping ?! ScriptError
    - range ScriptRange
    - expression ScriptExpression

. position = position-of(range, expression)
. result = catch script-range-step(range, position)
do match result
    | error ScriptError
        ?! script-located(error, expression)
    | found ScriptLoop
        = ScriptValue.loop(found)

────────────────────
_ do position-of ScriptLoop? ?! ScriptError
    - range ScriptRange
    - expression ScriptExpression

=? range.over if range.over
. result = catch environment.spread(range)
do match? result
    | error ScriptError
        ?! script-located(error, expression)
    | position ScriptLoop
        = position
= null

────────────────────
_ do pointed ScriptValue ?! ScriptError
    - x ScriptValue
    - y ScriptValue
    - expression ScriptPointExpression

. x-range = x.as-range
. y-range = y.as-range
?! ScriptError(ScriptErrorKind.type-mismatch, "A point can hold only one range outside a loop", expression)
    if x-range && y-range
if x-range
    . fixed = number-of(y, expression.y)
    . ends [ScriptValue]
    for item in x-range.items
        ends += ScriptValue.point(Point(number-of(item, expression.x), fixed))
    . first = ScriptValue.point(Point(number-of(x-range.first, expression.x), fixed))
    . last = ScriptValue.point(Point(number-of(x-range.last, expression.x), fixed))
    = ScriptValue.range(x-range.with-ends(first, last, ends, x-range.step))
if y-range
    . fixed = number-of(x, expression.x)
    . ends [ScriptValue]
    for item in y-range.items
        ends += ScriptValue.point(Point(fixed, number-of(item, expression.y)))
    . first = ScriptValue.point(Point(fixed, number-of(y-range.first, expression.y)))
    . last = ScriptValue.point(Point(fixed, number-of(y-range.last, expression.y)))
    = ScriptValue.range(y-range.with-ends(first, last, ends, y-range.step))
= ScriptValue.point(Point(number-of(x, expression.x), number-of(y, expression.y)))

────────────────────
_ do listed ScriptValue ?! ScriptError
    - list ScriptListExpression

. items [ScriptValue]
for item in list.items
    . value = settled(value-of(item), item)
    ?! ScriptError(ScriptErrorKind.type-mismatch, "A list can't hold a range outside a loop", item)
        if value.as-range
    items += value
?! ScriptError(ScriptErrorKind.incomplete, "Incomplete expression", list)
    if !items.length
= ScriptValue.range(ScriptRange(items[0], items[items.length - 1], null, items))

────────────────────
_ do negated ScriptValue ?! ScriptError
    - value ScriptValue
    - expression ScriptNegation

. range = value.as-range
if range
    . items [ScriptValue]
    for item in range.items
        items += negated(item, expression)
    = ScriptValue.range
        - range.with-ends
            - negated(range.first, expression)
            - negated(range.last, expression)
            - items
            - range.step
. number = value.as-number
=? ScriptValue.number(-number) if number
. point = value.as-point
=? ScriptValue.point(Point(-point.x, -point.y)) if point
?! ScriptError(ScriptErrorKind.type-mismatch, "Cannot negate ${script-value-described(value)}", expression)

────────────────────
_ do combined ScriptValue ?! ScriptError
    - expression ScriptBinary
    - left ScriptValue
    - right ScriptValue

. operator = expression.operator
=? compared(expression, left, right) if operator.compares
. left-range = left.as-range
. right-range = right.as-range
?! ScriptError(ScriptErrorKind.type-mismatch, "Two ranges can be combined only inside a loop", expression)
    if left-range && right-range
=? shifted(expression, left-range, right, true) if left-range
=? shifted(expression, right-range, left, false) if right-range
. left-number = left.as-number
. right-number = right.as-number
if left-number && right-number
    = ScriptValue.number(arithmetic(operator, left-number, right-number, expression))
. left-point = left.as-point
. right-point = right.as-point
if left-point && right-point && additive
    . x = arithmetic(operator, left-point.x, right-point.x, expression)
    . y = arithmetic(operator, left-point.y, right-point.y, expression)
    = ScriptValue.point(Point(x, y))
.. additive = operator == ScriptOperator.add || operator == ScriptOperator.subtract
if left-point && right-number && scaling
    . x = arithmetic(operator, left-point.x, right-number, expression)
    . y = arithmetic(operator, left-point.y, right-number, expression)
    = ScriptValue.point(Point(x, y))
.. scaling = operator == ScriptOperator.multiply || operator == ScriptOperator.divide
if left-number && right-point && operator == ScriptOperator.multiply
    . x = arithmetic(operator, left-number, right-point.x, expression)
    . y = arithmetic(operator, left-number, right-point.y, expression)
    = ScriptValue.point(Point(x, y))
. message = "Cannot use '${operator.symbol}' with ${script-value-described(left)} and $right-text"
    .. right-text = script-value-described(right)
?! ScriptError(ScriptErrorKind.type-mismatch, message, expression)

────────────────────
_ do compared ScriptValue ?! ScriptError
    - expression ScriptBinary
    - left ScriptValue
    - right ScriptValue

. operator = expression.operator
. left-number = left.as-number
. right-number = right.as-number
if left-number != null && right-number != null
    = ScriptValue.truth(script-numbers-compare(operator, left-number, right-number))
if operator == ScriptOperator.equal || operator == ScriptOperator.unequal
    . same = script-values-same(left, right)
    if same != null
        = ScriptValue.truth(same == (operator == ScriptOperator.equal))
. message = "Cannot compare $left-text and $right-text with '${operator.symbol}'"
    .. left-text = script-value-described(left)
    .. right-text = script-value-described(right)
?! ScriptError(ScriptErrorKind.type-mismatch, message, expression)

────────────────────
_ do shifted ScriptValue ?! ScriptError
    - expression ScriptBinary
    - range ScriptRange
    - other ScriptValue
    - leading Bool

. operator = expression.operator
. affine = additive || operator == ScriptOperator.multiply || leading-divide
    .. additive = operator == ScriptOperator.add || operator == ScriptOperator.subtract
    .. leading-divide = operator == ScriptOperator.divide && leading
?! ScriptError(ScriptErrorKind.type-mismatch, "A range outside a loop can only be shifted or scaled", expression)
    if !affine
. items [ScriptValue]
for item in range.items
    items += paired(expression, item, other, leading)
. first = paired(expression, range.first, other, leading)
. last = paired(expression, range.last, other, leading)
. factor = other.as-number
. step F64? = range.step
if step && factor && operator == ScriptOperator.multiply
    step = abs(step * factor)
if step && factor && operator == ScriptOperator.divide
    step = abs(step / factor)
= ScriptValue.range(range.with-ends(first, last, items, step))

────────────────────
_ paired ScriptValue ?! ScriptError
    - expression ScriptBinary
    - end ScriptValue
    - other ScriptValue
    - leading Bool

if leading then combined(expression, end, other) else combined(expression, other, end)

────────────────────
_ arithmetic F64 ?! ScriptError
    - operator ScriptOperator
    - left F64
    - right F64
    - expression ScriptExpression

?! ScriptError(ScriptErrorKind.division-by-zero, "Division by zero", expression)
    if right == 0 && (operator == ScriptOperator.divide || operator == ScriptOperator.remainder)
?! ScriptError(ScriptErrorKind.non-finite, "The result is too large", expression)
    if !is-finite(result)
result

.. result = match operator
    |= .add
        left + right
    |= .subtract
        left - right
    |= .multiply
        left * right
    |= .divide
        left / right
    ??
        fmod(left, right)

────────────────────
_ do resolved ScriptValue ?! ScriptError
    - expression ScriptReferenceExpression

. result = catch environment.resolve(expression.reference)
do match result
    | error ScriptError
        ?! script-located(error, expression)
    | error Error
        ?! ScriptError(ScriptErrorKind.missing, error.message, expression)
    | value ScriptValue
        . range = value.as-range
        =? ScriptValue.range(range.with-origin(reference-id, 0)) if range && is-variable
        .. reference-id = expression.reference.id
        .. is-variable = expression.reference.kind == ScriptReferenceKind.variable
        = value

────────────────────
_ do called ScriptValue ?! ScriptError
    - expression ScriptPhraseExpression

. form = vocabulary.grammar.form(expression.kind)
. function = vocabulary.function(expression.kind)
?! ScriptError(ScriptErrorKind.unknown-phrase, "Unknown phrase '${expression.kind}'", expression)
    if !form || !function
. values [ScriptValue]
values.reserve(form.parts.length)
for part in form.parts when part.is-slot
    . argument = expression.arguments[part.slot] ?? ScriptHole()
    . saved = unit
    if part.type.kind == ScriptTypeKind.number || part.type.kind == ScriptTypeKind.point
        unit = part.type.unit
    . raw = value-of(argument)
    . value =
        |? part.type.kind == ScriptTypeKind.range
            raw
        |? part.type.kind == ScriptTypeKind.loop && raw.as-range != null
            stepping(raw.as-range!, argument)
        ??
            settled(raw, argument)
    unit = saved
    values += conform(value, part.type, argument)
. run = function
. result = catch run(ScriptArguments(expression, form, values), context)
do match result
    | error ScriptError
        ?! script-located(error, expression)
    | error Error
        ?! ScriptError(ScriptErrorKind.failed, error.message, expression)
    | value ScriptValue
        . number = value.as-number
        ?! ScriptError(ScriptErrorKind.non-finite, "The result is not a finite number", expression)
            if number && !is-finite(number)
        = conform(stamped(value), form.result, expression)

────────────────────
_ do stamped ScriptValue
    - value ScriptValue

. range = value.as-range
=? value if !range || !range.counted || range.origin != 0 || range.ordinal != 0
ordinals += 1
= ScriptValue.range(range.with-origin(0, ordinals))

━━━━━━━━━━━━━━━━━━━━
+ do script-located ScriptError
    - error ScriptError
    - expression ScriptExpression

if !error.subtree
    error.subtree = expression
= error

━━━━━━━━━━━━━━━━━━━━
+ script-unresolved-error
    - expression ScriptUnresolved

ScriptError(kind, message, expression)

.. token = expression.token
.. kind = ScriptErrorKind.unresolved
.. message =
    |? token.kind == ScriptTokenKind.query
        "Unknown name '${token.text}'"
    |? token.kind == ScriptTokenKind.number
        "Invalid number '${token.text}'"
    ??
        "Unexpected '${token.text}'"

━━━━━━━━━━━━━━━━━━━━
+ script-numbers-compare Bool
    - operator ScriptOperator
    - left F64
    - right F64

match operator
    |= .less
        left < right
    |= .greater
        left > right
    |= .at-most
        left <= right
    |= .at-least
        left >= right
    |= .equal
        left == right
    ??
        left != right

━━━━━━━━━━━━━━━━━━━━
+ script-values-same Bool?
    - left ScriptValue
    - right ScriptValue

|? left-point && right-point
    left-point.x == right-point.x && left-point.y == right-point.y
|? left-text != null && right-text != null
    left-text == right-text
|? left-color && right-color
    script-color-text(left-color) == script-color-text(right-color)
|? left-truth != null && right-truth != null
    left-truth == right-truth
??
    null

.. left-point = left.as-point
.. right-point = right.as-point
.. left-text = left.as-text
.. right-text = right.as-text
.. left-color = left.as-color
.. right-color = right.as-color
.. left-truth = left.as-truth
.. right-truth = right.as-truth
