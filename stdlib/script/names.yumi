./token
./value

━━━━━━━━━━━━━━━━━━━━
+ ScriptName is Tuple

+ reference ScriptReference
+ name String
+ type ScriptType
+ hint = ""

━━━━━━━━━━━━━━━━━━━━
+ ScriptNames is Interface

────────────────────
+ do lookup ScriptName?
    - reference ScriptReference

────────────────────
+ do candidates [ScriptName]

━━━━━━━━━━━━━━━━━━━━
+ ScriptNameList
    is ScriptNames

+ names [ScriptName] = List'ScriptName()

────────────────────
+ This
    - names [ScriptName] = List'ScriptName()

────────────────────
+ do lookup ScriptName?
    - reference ScriptReference

for name in names
    =? name if name.reference.kind == reference.kind && name.reference.id == reference.id
= null

────────────────────
+ candidates [ScriptName]

names
