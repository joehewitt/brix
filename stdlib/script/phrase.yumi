./expression
./names
./token
./value
/graphics/color
/graphics/point
/math

━━━━━━━━━━━━━━━━━━━━
+ ScriptPhrasePart is Tuple

+ word = ""
+ slot = ""
+ type = script-any-type

────────────────────
+ get is-slot

slot.length > 0

━━━━━━━━━━━━━━━━━━━━
+ ScriptPhraseForm is Tuple

+ kind String
+ parts [ScriptPhrasePart]
+ result ScriptType
+ is-function = false

────────────────────
+ get starts-with-slot

parts.length > 0 && parts[0].is-slot

────────────────────
+ get ends-with-slot

parts.length > 0 && parts[parts.length - 1].is-slot

────────────────────
+ get slots [ScriptPhrasePart]

List'ScriptPhrasePart(each in parts when each.is-slot)

────────────────────
+ do get template String

=? "${name}(${", ".join(script-part-display(each) in slots)})" if is-function
. text = ""
for part in parts
    . piece = script-part-display(part)
    if text.length && !piece.starts-with("'")
        text = "$text "
    text = "$text$piece"
= text

────────────────────
+ do get name String

=? "" if parts.length < 2 || parts[0].is-slot
. word = parts[0].word
. cut Index? = null
for index in 0 .. < word.length
    if word[index] == ' '
        cut = index
=? word if cut == null
= word[0 .. < cut]

────────────────────
+ do slot-type ScriptType
    - name String

for part in parts
    =? part.type if part.slot == name
= script-any-type

────────────────────
+ do next-word Index?
    - start Index

for index in start + 1 .. < parts.length
    =? index if !parts[index].is-slot
= null

━━━━━━━━━━━━━━━━━━━━
+ script-part-display
    - part ScriptPhrasePart

if part.is-slot then "‹${part.slot}›" else part.word

━━━━━━━━━━━━━━━━━━━━
+ script-part-words
    - part ScriptPhrasePart

|? part.is-slot
    "".join(" " in 0 .. < script-part-display(part).length)
??
    part.word

━━━━━━━━━━━━━━━━━━━━
+ do script-template-parts [ScriptPhrasePart]
    - template String
    - node-kinds [String]
    - part-kinds [String] = List'String()

. parts [ScriptPhrasePart]
. word = ""
. index = 0
while index < template.length
    if template[index] != '{'
        word = "$word${template[index]}"
        index += 1
        continue
    . close = index + 1
    while close < template.length && template[close] != '}'
        close += 1
    ?! Panic("Unclosed slot in phrase template '$template'")
        if close >= template.length
    . slot = template[index + 1 .. < close]
    . colon = slot.find(":")
    . name = if colon then slot[0 .. < colon] else slot
    . type-name = if colon then slot[colon + 1 .. < slot.length] else slot
    . type = script-type-named(type-name, node-kinds, part-kinds)
    ?! Panic("Unknown slot type '$type-name' in phrase template '$template'")
        if !type
    if word.trim().length
        parts += ScriptPhrasePart(word.trim())
    word = ""
    parts += ScriptPhrasePart("", name, type)
    index = close + 1
if word.trim().length
    parts += ScriptPhrasePart(word.trim())
= parts

━━━━━━━━━━━━━━━━━━━━
+ script-short-kind String
    - kind String

if !dot then kind else kind[dot + 1 .. < kind.length]

.. dot = kind.find(".")

━━━━━━━━━━━━━━━━━━━━
+ ScriptConversion is Tuple

+ source ScriptType
+ result ScriptType

━━━━━━━━━━━━━━━━━━━━
