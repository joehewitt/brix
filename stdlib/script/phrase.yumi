━━━━━━━━━━━━━━━━━━━━
+ ScriptVocabulary'Context

+ grammar = ScriptGrammar()

_ functions Map'String'(ScriptPhraseFunction'Context)
_ converters [ScriptConversionFunction'Context] = List'(ScriptConversionFunction'Context)()

────────────────────
+ do add-conversion
    - source ScriptType
    - result ScriptType
    - convert ScriptConversionFunction'Context

grammar.add-conversion(source, result)
converters += convert

────────────────────
+ converter
    - value ScriptValue
    - wanted ScriptType

converters[index] if index

.. index = grammar.conversion(script-value-type(value), wanted)

────────────────────
+ operand-converter
    - value ScriptValue

converters[index] if index

.. index = grammar.operand-conversion(script-value-type(value))

────────────────────
+ do add ScriptPhraseForm
    - kind String
    - template String
    - result ScriptType
    - evaluate ScriptPhraseFunction'Context

. form = grammar.add(kind, template, result)
functions[kind] = evaluate
= form

────────────────────
+ do add-function ScriptPhraseForm
    - kind String
    - template String
    - result ScriptType
    - evaluate ScriptPhraseFunction'Context

. form = grammar.add(kind, template, result, true)
functions[kind] = evaluate
= form

────────────────────
+ do widen
    - kind String
    - slot String
    - evaluate ScriptPhraseFunction'Context

. form = grammar.widen(kind, slot)
functions[kind] = evaluate
= form

────────────────────
+ do add-node-kind
    - kind String

grammar.add-node-kind(kind)

────────────────────
+ do add-part-kind
    - kind String
    - phrase String
    - number String
    - node String
    - plural = ""
    - numbers = ""

grammar.add-part-kind(kind, phrase, number, node, plural, numbers)

────────────────────
+ do add-alternates
    - kinds [String]

grammar.add-alternates(kinds)

────────────────────
+ function ScriptPhraseFunction'Context?
    - kind String

functions[kind]
