━━━━━━━━━━━━━━━━━━━━
+ ScriptGrammar

+ node-kinds [String]
+ part-kinds [String]
_ part-phrases Map'String'ScriptPartPhrase

_ forms Map'String'ScriptPhraseForm
_ ordered [ScriptPhraseForm]
_ families Map'String'([String])
_ short-counts Map'String'Index
_ short-kinds Map'String'String
_ conversions [ScriptConversion]

────────────────────
+ do add-conversion
    - source ScriptType
    - result ScriptType

conversions += ScriptConversion(source, result)

────────────────────
+ do conversion Index?
    - actual ScriptType
    - wanted ScriptType

=? null if actual.kind == ScriptTypeKind.any || wanted.kind == ScriptTypeKind.any
for index in 0 .. < conversions.length
    =? index if conversions[index].source.admits(actual) && wanted.admits(conversions[index].result)
= null

────────────────────
+ do operand-conversion Index?
    - actual ScriptType

=? null if actual.kind != ScriptTypeKind.node && actual.kind != ScriptTypeKind.part
for index in 0 .. < conversions.length
    . result = conversions[index].result.kind
    . computes = result == ScriptTypeKind.number || result == ScriptTypeKind.point
    =? index if computes && conversions[index].source.admits(actual)
= null

────────────────────
+ converts
    - actual ScriptType
    - wanted ScriptType

conversion(actual, wanted) != null

────────────────────
+ operand
    - actual ScriptType

if index then conversions[index].result else actual

.. index = operand-conversion(actual)

────────────────────
+ do add ScriptPhraseForm
    - kind String
    - template String
    - result ScriptType
    - is-function = false

. form = ScriptPhraseForm
    - kind
    - script-template-parts(template, node-kinds, part-kinds)
    - result
    - is-function
?! Panic("Phrase '$kind' is registered twice")
    if forms[kind]
if is-function
    ?! Panic("Function '$kind' needs a name and a slot")
        if !form.name.length
    for other in ordered
        ?! Panic("Function '${form.name}' is registered twice")
            if other.is-function && other.name == form.name
forms[kind] = form
ordered += form
. short = script-short-kind(kind)
short-counts[short] = (short-counts[short] ?? 0) + 1
short-kinds[short] = kind
= form

────────────────────
+ do widen
    - kind String
    - slot String

. form = forms[kind]
?! Panic("Widened phrase '$kind' is not registered")
    if !form
. parts [ScriptPhrasePart]
. found = false
for part in form.parts
    if part.slot == slot
        parts += ScriptPhrasePart("", slot, script-any-type)
        found = true
    else
        parts += part
?! Panic("Phrase '$kind' has no slot '$slot'")
    if !found
. widened = ScriptPhraseForm(kind, parts, form.result, form.is-function)
forms[kind] = widened
for index in 0 .. < ordered.length
    if ordered[index].kind == kind
        ordered[index] = widened
= widened

────────────────────
+ do add-node-kind
    - kind String

if !(node-kinds has kind)
    node-kinds += kind

────────────────────
+ do add-part-kind
    - kind String
    - phrase String
    - number String
    - node String
    - plural = ""
    - numbers = ""

if !(part-kinds has kind)
    part-kinds += kind
part-phrases[kind] = ScriptPartPhrase(phrase, number, node, plural, numbers)

────────────────────
+ part-expression ScriptExpression?
    - part ScriptNodePart

if !phrase || !forms[phrase.kind] then null else ScriptPhraseExpression(phrase.kind, arguments)

.. phrase = part-phrases[part.kind]
.. literal = ScriptLiteral
    - ScriptValue.number(part.number as F64)
    - script-number-text(part.number as F64)
.. arguments = Map'String'ScriptExpression
    • (phrase.number) literal
    • (phrase.node) ScriptReferenceExpression(script-node-reference(part.node.id), "")

────────────────────
+ do parts-expression
    - parts [ScriptNodePart]

=? null if !parts.length
=? part-expression(parts[0]) if parts.length == 1
. phrase = part-phrases[parts[0].kind]
=? null if !phrase || !forms[phrase.plural]
. numbers = List'ScriptExpression()
for part in parts
    =? null if part.kind != parts[0].kind || part.node.id != parts[0].node.id
    numbers += ScriptLiteral
        - ScriptValue.number(part.number as F64)
        - script-number-text(part.number as F64)
. arguments = Map'String'ScriptExpression
    • (phrase.numbers) ScriptListExpression(numbers)
    • (phrase.node) ScriptReferenceExpression(script-node-reference(parts[0].node.id), "")
= ScriptPhraseExpression(phrase.plural, arguments)

────────────────────
+ do expression-part ScriptNodePart?
    - expression ScriptExpression
    - names ScriptNames

=? null if expression is not ScriptPhraseExpression
. phrase = expression as ScriptPhraseExpression
for kind in part-kinds
    . found = part-phrases[kind]
    if found && found.kind == phrase.kind
        . number = phrase.arguments[found.number]
        . node = phrase.arguments[found.node]
        =? null if number is not ScriptLiteral || node is not ScriptReferenceExpression
        . index = (number as ScriptLiteral).value.as-number
        . reference = (node as ScriptReferenceExpression).reference
        . name = names.lookup(reference)
        =? null if !index || index != round(index) || not-node || reference.copy || !name
        .. not-node = reference.kind != ScriptReferenceKind.node
        = ScriptNodePart(ScriptNode(reference.id, name.type.node-kind), kind, index as Index)
= null

────────────────────
+ do add-alternates
    - kinds [String]

for kind in kinds
    ?! Panic("Alternate '$kind' is not a registered phrase")
        if !forms[kind]
    ?! Panic("Phrase '$kind' already has alternates")
        if families[kind]
    families[kind] = kinds

────────────────────
+ form ScriptPhraseForm?
    - kind String

forms[kind]

────────────────────
+ short-name String
    - kind String

|? (short-counts[short] ?? 0) != 1 || (short != kind && forms[short] != null)
    kind
??
    short

.. short = script-short-kind(kind)

────────────────────
+ form-named ScriptPhraseForm?
    - name String

|? found
    found
|? (short-counts[name] ?? 0) != 1
    null
??
    forms[short-kinds[name]!]

.. found = forms[name]

────────────────────
+ do alternates [ScriptPhraseForm]
    - kind String

. found [ScriptPhraseForm]
. family = families[kind]
=? found if !family
for other in family
    if other != kind
        found += forms[other]!
= found

────────────────────
+ get all [ScriptPhraseForm]

ordered

━━━━━━━━━━━━━━━━━━━━
+ ScriptArguments is Tuple

+ call ScriptPhraseExpression
+ form ScriptPhraseForm
+ values [ScriptValue]

────────────────────
+ do value ScriptValue ?! ScriptError
    - name String

. index Index = 0
for part in form.parts when part.is-slot
    =? values[index] if part.slot == name
    index += 1
?! ScriptError(ScriptErrorKind.failed, "Phrase '${call.kind}' has no argument '$name'", call)

────────────────────
+ number F64 ?! ScriptError
    - name String

?! mismatch(name, "a number")
    if !found
found

.. found = value(name).as-number

────────────────────
+ whole Int ?! ScriptError
    - name String

?! ScriptError(ScriptErrorKind.type-mismatch, "Expected a whole number for '$name'", call)
    if found != round(found)
found as Int

.. found = number(name)

────────────────────
+ point Point ?! ScriptError
    - name String

?! mismatch(name, "a point")
    if !found
found

.. found = value(name).as-point

────────────────────
+ color RGBA ?! ScriptError
    - name String

?! mismatch(name, "a color")
    if !found
found

.. found = value(name).as-color

────────────────────
+ text String ?! ScriptError
    - name String

?! mismatch(name, "text")
    if !found
found

.. found = value(name).as-text

────────────────────
+ node ScriptNode ?! ScriptError
    - name String

?! mismatch(name, "a node")
    if !found
found

.. found = value(name).as-node

────────────────────
+ part ScriptNodePart ?! ScriptError
    - name String

?! mismatch(name, "a part of a shape")
    if !found
found

.. found = value(name).as-part

────────────────────
+ parts [ScriptNodePart] ?! ScriptError
    - name String

?! mismatch(name, "parts of a shape")
    if !found
found

.. found = value(name).as-parts

────────────────────
+ nodes [ScriptNode] ?! ScriptError
    - name String

?! mismatch(name, "nodes")
    if !found
found

.. found = value(name).as-nodes

────────────────────
+ loop ScriptLoop ?! ScriptError
    - name String

?! mismatch(name, "a loop")
    if !found
found

.. found = value(name).as-loop

────────────────────
