script-test-vocabulary().grammar

━━━━━━━━━━━━━━━━━━━━
+ do script-call-grammar ScriptGrammar

. vocabulary = script-test-vocabulary()
vocabulary.add-function
    - "round"
    - "round {value:number}"
    - script-number-type
    - :: arguments, context => ScriptValue.number(0)
vocabulary.add-function
    - "least"
    - "least of {a:number} and {b:number}"
    - script-number-type
    - :: arguments, context => ScriptValue.number(0)
vocabulary.add
    - "reach"
    - "reach of {vector:point}"
    - script-number-type
    - :: arguments, context => ScriptValue.number(0)
= vocabulary.grammar

━━━━━━━━━━━━━━━━━━━━
+ script-call-tree ScriptExpression
    - text String

script-parse(script-read(text, grammar, script-test-names()), grammar)

.. grammar = script-call-grammar()

━━━━━━━━━━━━━━━━━━━━
+ script-call-describe String
    - text String

script-describe(script-call-tree(text), script-call-grammar())

━━━━━━━━━━━━━━━━━━━━
+ script-call-printed String
    - text String

script-text(script-print(script-call-tree(text), script-call-grammar()))

━━━━━━━━━━━━━━━━━━━━
+ do script-part-grammar ScriptGrammar

. vocabulary = ScriptVocabulary'ScriptTestContext()
vocabulary.add-node-kind("shape")
vocabulary.add-node-kind("path")
vocabulary.add-node-kind("layer")
vocabulary.add-part-kind("vertex", "point-of", "index", "path", "points-of", "indexes")
vocabulary.add-part-kind("segment", "segment", "index", "path")
vocabulary.add
    - "point-of"
    - "point {index:whole} of {path}"
    - script-part-type("vertex")
    - :: arguments, context => ScriptValue.number(0)
vocabulary.add
    - "points-of"
    - "points {indexes:range} of {path}"
    - script-parts-type("vertex")
    - :: arguments, context => ScriptValue.number(0)
vocabulary.add
    - "segment"
    - "{path}'s segment {index:whole}"
    - script-part-type("segment")
    - :: arguments, context => ScriptValue.number(0)
script-add-ranges(vocabulary)
= vocabulary.grammar

