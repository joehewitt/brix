━━━━━━━━━━━━━━━━━━━━
+ script-test-signature String
    - token ScriptToken

"${script-token-kind-name(token.kind)}:${token.text}$suffix"

.. suffix =
    |? token.called
        ":${token.phrase}:call"
    |? token.kind == ScriptTokenKind.word
        ":${token.phrase}:${token.part}"
    |? token.ghost
        ":ghost"
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ script-test-signatures String
    - tokens [ScriptToken]

" ".join(script-test-signature(each) in tokens)

━━━━━━━━━━━━━━━━━━━━
+ ScriptTreeGenerator

+ grammar ScriptGrammar
+ seed U64

────────────────────
+ This
    - grammar
    - seed U64

────────────────────
+ do next Size
    - bound Size

seed = (seed * 1103515245 + 12345) % 2147483648
= ((seed / 65536) % bound) as Size

────────────────────
+ do tree ScriptExpression
    - depth Size

=? leaf() if depth == 0 || next(3) == 0
. choice = next(8)
do match choice
    |= 0
        = ScriptNegation(tree(depth - 1))
    |= 1
        . operators = List'ScriptOperator
            * ScriptOperator.add
            * ScriptOperator.subtract
            * ScriptOperator.multiply
            * ScriptOperator.divide
            * ScriptOperator.remainder
        = ScriptBinary(operators[next(5)], tree(depth - 1), tree(depth - 1))
    |= 2
        = ScriptPointExpression(tree(depth - 1), tree(depth - 1), next(4) != 0)
    |= 3
        = ScriptGroup(tree(depth - 1), next(4) != 0)
    |= 4
        = ScriptSequence(List'ScriptExpression(tree(depth - 1), tree(depth - 1)))
    ??
        . forms = grammar.all
        . form = forms[next(forms.length)]
        . arguments = Map'String'ScriptExpression()
        for part in form.slots
            arguments[part.slot] = tree(depth - 1)
        = ScriptPhraseExpression(form.kind, arguments)

────────────────────
+ do leaf ScriptExpression

. choice = next(9)
do match choice
    |= 0
        = ScriptHole()
    |= 1
        = ScriptUnresolved(script-query-token("zz"))
    |= 2
        = ScriptReferenceExpression(script-node-reference(1), "Ball")
    |= 3
        = ScriptReferenceExpression(script-variable-reference(7), "i")
    |= 4
        = ScriptReferenceExpression(script-variable-reference(8), "star points")
    |= 5
        = ScriptLiteral(ScriptValue.point(Point(1, 2)), "")
    |= 6
        = ScriptLiteral(ScriptValue.text("hi"), "")
    ??
        . texts = List'String("2", "0.50", "50%", "45°", ".5", "12")
        . text = texts[next(texts.length)]
        = ScriptLiteral(ScriptValue.number(script-number-value(text)!), text)
