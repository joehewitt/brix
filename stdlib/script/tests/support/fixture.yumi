/data/json
/graphics/point
/script

━━━━━━━━━━━━━━━━━━━━
+ ScriptTestNode is Tuple

+ id U64
+ kind String
+ name String
+ width F64
+ center Point
+ points [Point]

━━━━━━━━━━━━━━━━━━━━
+ ScriptTestContext
    is ScriptEnvironment

+ nodes [ScriptTestNode]
+ variables [U64 = F64]

────────────────────
+ This

nodes += ScriptTestNode(1, "shape", "Ball", 40, Point(10, 20))
nodes += ScriptTestNode
    - 2
    - "path"
    - "Star"
    - 100
    - Point(50, 50)
    - List'Point(Point(0, 0), Point(10, 0), Point(10, 10))
nodes += ScriptTestNode(3, "layer", "Joe's layer", 300, Point(0, 0))
nodes += ScriptTestNode(4, "shape", "Bars", 12, Point(-5, 5))
variables[7] = 3
variables[8] = 5

────────────────────
+ do node ScriptTestNode ?! ScriptError
    - id U64

for each in nodes
    =? each if each.id == id
?! ScriptError(ScriptErrorKind.missing, "Node $id no longer exists")

────────────────────
+ do resolve ScriptValue ?! Error
    - reference ScriptReference

if reference.kind == ScriptReferenceKind.node
    . found = node(reference.id)
    = ScriptValue.node(ScriptNode(found.id, found.kind))
. value = variables[reference.id]
?! ScriptError(ScriptErrorKind.missing, "Variable ${reference.id} is not defined")
    if !value
= ScriptValue.number(value)

━━━━━━━━━━━━━━━━━━━━
+ script-test-names ScriptNameList

ScriptNameList(names)

.. names = List'ScriptName
    * ScriptName(script-node-reference(1), "Ball", ScriptType(ScriptTypeKind.node) • node-kind "shape")
    * ScriptName(script-node-reference(2), "Star", ScriptType(ScriptTypeKind.node) • node-kind "path")
    * ScriptName(script-node-reference(3), "Joe's layer", ScriptType(ScriptTypeKind.node) • node-kind "layer")
    * ScriptName(script-node-reference(4), "Bars", ScriptType(ScriptTypeKind.node) • node-kind "shape")
    * ScriptName(script-node-reference(9), "Ghost", ScriptType(ScriptTypeKind.node) • node-kind "shape")
    * ScriptName(script-variable-reference(7), "i", script-number-type)
    * ScriptName(script-variable-reference(8), "star points", script-number-type)

━━━━━━━━━━━━━━━━━━━━
+ do script-test-vocabulary ScriptVocabulary'ScriptTestContext

. vocabulary = ScriptVocabulary'ScriptTestContext()
vocabulary.add-node-kind("shape")
vocabulary.add-node-kind("path")
vocabulary.add-node-kind("layer")
vocabulary.add
    - "width"
    - "{node}'s width"
    - script-number-type
    - :: arguments, context => script-test-width(arguments, context)
vocabulary.add
    - "center"
    - "{node}'s center"
    - ScriptType(ScriptTypeKind.point)
    - :: arguments, context => script-test-center(arguments, context)
vocabulary.add
    - "x"
    - "{point}'s x"
    - script-number-type
    - :: arguments, context => ScriptValue.number(arguments.point("point").x)
vocabulary.add
    - "y"
    - "{point}'s y"
    - script-number-type
    - :: arguments, context => ScriptValue.number(arguments.point("point").y)
vocabulary.add
    - "point-of"
    - "point {index:whole} of {path}"
    - ScriptType(ScriptTypeKind.point)
    - :: arguments, context => script-test-point-of(arguments, context)
vocabulary.add
    - "tangent"
    - "tangent of {path} at {t:percent}"
    - ScriptType(ScriptTypeKind.point)
    - :: arguments, context => ScriptValue.point(Point(arguments.number("t"), 0))
vocabulary.add("distance", "{a:point}'s distance to {b:point}", script-number-type, :: arguments, context => ScriptValue.number(arguments.point("a").distance(arguments.point("b"))))
vocabulary.add
    - "rotated"
    - "{p:point} rotated by {angle:degrees} around {center:point}"
    - ScriptType(ScriptTypeKind.point)
    - :: arguments, context => ScriptValue.point(arguments.point("p"))
vocabulary.add("pi", "pi", script-number-type, :: arguments, context => ScriptValue.number(3.14159))
vocabulary.add
    - "failure"
    - "{node}'s failure"
    - script-number-type
    - :: arguments, context => script-test-failure(arguments)
vocabulary.add
    - "overflow"
    - "{node}'s overflow"
    - script-number-type
    - :: arguments, context => ScriptValue.number(1e308 * 10)
vocabulary.add
    - "label"
    - "{node}'s label"
    - script-number-type
    - :: arguments, context => ScriptValue.text("label")
= vocabulary

━━━━━━━━━━━━━━━━━━━━
+ script-test-width ScriptValue ?! Error
    - arguments ScriptArguments
    - context ScriptTestContext

ScriptValue.number(context.node(arguments.node("node").id).width)

━━━━━━━━━━━━━━━━━━━━
+ script-test-center ScriptValue ?! Error
    - arguments ScriptArguments
    - context ScriptTestContext

ScriptValue.point(context.node(arguments.node("node").id).center)

━━━━━━━━━━━━━━━━━━━━
+ script-test-point-of ScriptValue ?! Error
    - arguments ScriptArguments
    - context ScriptTestContext

?! ScriptError(ScriptErrorKind.out-of-range, "Star has only ${points.length} points")
    if index < 0 || index >= points.length

ScriptValue.point(points[index])

.. points = context.node(arguments.node("path").id).points
.. index = arguments.whole("index")

━━━━━━━━━━━━━━━━━━━━
+ script-test-failure ScriptValue ?! Error
    - arguments ScriptArguments

?! Error("The failure phrase always fails")
    if arguments.values.length > 0

ScriptValue.number(0)

━━━━━━━━━━━━━━━━━━━━
