./support/fixture
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ tests TestRender

════════════════════
test("Script Precedence")

"(+ 1 (* 2 3))", script-test-describe("1 + 2 * 3")
"(- (- 1 2) 3)", script-test-describe("1 - 2 - 3")
"(* (- 2) 3)", script-test-describe("-2 * 3")
"(- (width Ball))", script-test-describe("-Ball's width")

════════════════════
test("Script Possessives")

"(x (center Ball))", script-test-describe("Ball's center's x")

════════════════════
test("Script Prefix Phrases")

"(point-of (* i 2) Star)", script-test-describe("point i * 2 of Star")
"(point-of 1 (* Star 2))", script-test-describe("point 1 of Star * 2")
"(* [(point-of 1 Star)] 2)", script-test-describe("(point 1 of Star) * 2")
"(point-of (point-of 1 Ball) Star)", script-test-describe("point point 1 of Ball of Star")
"(* (pi) 2)", script-test-describe("pi * 2")

════════════════════
test("Script Calls")

"(least (point-of 1 Ball) (point 1 2))", script-call-describe("least(point 1 of Ball, (1, 2))")
"(least _ 2)", script-call-describe("least(, 2)")
"(list (least 1 (reach 2)) 3)", script-call-describe("least of 1 and reach of 2, 3")

════════════════════
test("Script Infix Phrases")

"(rotated (center Ball) (point-of 1 Star) Ball)", script-test-describe("Ball's center rotated by point 1 of Star around Ball")
"(+ (x [(distance Ball Star)]) 1)", script-test-describe("(Ball's distance to Star)'s x + 1")

════════════════════
test("Script Points")

"(point (+ 1 i) (* 2 3))", script-test-describe("(1 + i, 2 * 3)")
"(point 1 _ …)", script-test-describe("(1,")
"(point 1 (seq 2 ?, 3))", script-test-describe("(1, 2, 3)")

════════════════════
test("Script Total Parsing")

"(* _ 2)", script-test-describe("* 2")
"(list 1 2)", script-test-describe("1, 2")
"(seq Ball ?'s)", script-test-describe("Ball's")
"(point-of _ _)", script-test-describe("point")
"(point-of [1 …] Star)", script-test-describe("point (1 of Star")

════════════════════
test("Script Printing")

"1 + 2 * 3", script-test-printed("1 + 2 * 3")
"(1 + 2) * 3", script-test-printed("(1 + 2) * 3")
"point ‹index› of Star", script-test-printed("point of Star")
"2 * ‹›", script-test-printed("2 *")
"(1 + 2)", script-test-printed("(1 + 2")
"1 + 2)", script-test-printed("1 + 2)")

════════════════════
test("Script Printing Calls")

"round(2)", script-call-printed("round 2")
"round(2 * 3)", script-call-printed("round 2 * 3")
"round(2) * 3", script-call-printed("(round 2) * 3")
"round(2) * 3", script-call-printed("round((2)) * 3")
"round((2) * 3)", script-call-printed("round((2) * 3)")
"least(1, 2)", script-call-printed("least of 1 and 2")
"least(1, 2, 3)", script-call-printed("least(1, 2, 3)")
"least(1, ‹b›), 2 and 3", script-call-printed("least of 1, 2 and 3")
"least(1, ‹b›)", script-call-printed("least(1")
"round((1, 2))", script-call-printed("round((1, 2))")
"(reach of (1, 2)) + 1", script-call-printed("(reach of (1, 2)) + 1")
