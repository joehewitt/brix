./support/fixture
/data/json
/script
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ tests TestRender

════════════════════
test("Script Arithmetic")

"-1", evaluated("-7 % 3")

════════════════════
test("Script Errors")

"incomplete: Incomplete expression", evaluated("2 *")
"unresolved: Unknown name 'ba'", evaluated("2 * ba")
"unresolved: Missing an operator", evaluated("Ball 2")
"unresolved: Unexpected ')'", evaluated("1 + 2)")
"type-mismatch: Cannot use '+' with a point and a number", evaluated("Ball's center + 1")
"type-mismatch: Cannot use '*' with a point and a point", evaluated("Ball's center * Star's center")
"type-mismatch: Expected a whole number, not a number", evaluated("point 1.5 of Star")
"type-mismatch: Expected a path, not a shape", evaluated("point 1 of Ball")
"division-by-zero: Division by zero", evaluated("1 / 0")
"non-finite: The result is too large", evaluated(overflowing-product())
"unknown-phrase: Unknown phrase 'gone'", evaluated-json("{\"phrase\": \"gone\", \"args\": {}}")

════════════════════
test("Script Error Subtrees")

"(/ 1 0)", failing-subtree("2 * (1 / 0) + 3")
"Ghost", failing-subtree("Ghost's width + 1")
"?ba", failing-subtree("(1, ba)")

━━━━━━━━━━━━━━━━━━━━
+ overflowing-product

" * ".join("1000000000000000000000" in 0 .. < 16)

━━━━━━━━━━━━━━━━━━━━
+ evaluated String
    - text String

evaluated-expression(script-test-tree(text))

━━━━━━━━━━━━━━━━━━━━
+ evaluated-json String
    - text String

evaluated-expression(script-expression-from-json(JSON(text)))

━━━━━━━━━━━━━━━━━━━━
+ do evaluated-expression String
    - expression ScriptExpression

. context = ScriptTestContext()
. evaluator = ScriptEvaluator'ScriptTestContext(script-test-vocabulary(), context, context)
. result = catch evaluator.evaluate(expression, script-any-type)
do match result
    | error ScriptError
        = "${error.kind.name}: ${error.message}"
    | error Error
        = "error: ${error.message}"
    | value ScriptValue
        = script-literal-text(value)

━━━━━━━━━━━━━━━━━━━━
+ do failing-subtree String
    - text String

. context = ScriptTestContext()
. evaluator = ScriptEvaluator'ScriptTestContext(script-test-vocabulary(), context, context)
. result = catch evaluator.evaluate(script-test-tree(text), script-any-type)
do match result
    | error ScriptError
        =? script-describe(error.subtree, script-test-grammar()) if error.subtree
        = "no subtree"
    ??
        = "no error"
