+ tests TestRender

════════════════════
test("Script Solve Arithmetic")

"60 reached", solved(proportion(), 40, List'F64(60, 30))
"-2.5 reached", solved(scaled(-4), 8, List'F64(10))
"30 reached", solved(scaled(5), 30, List'F64(150))

════════════════════
test("Script Solve Curves")

"30 reached", solved(wave(), 20, List'F64(50))
"40 reached", solved(orbit(), 0, orbit-at(40))
"0.6 reached", solved(along(square-path()), 0.4, spot-along(square-path(), 0.6)!, 0.0001)

════════════════════
test("Script Solve Out Of Reach")

"90 short by 20", solved(wave(), 80, List'F64(120))
"56 short by 8.9443", solved(proportion(), 40, List'F64(60, 20))
"1 short by 30", solved(along(line((0, 0), (100, 0))), 0.9, List'F64(130, 0))
"0 short by 30", solved(orbit(), 30, List'F64(130, 50))
"0 short by 4", solved(along(square-path()), 0.1, spot-along(square-path(), 0.9)!)
"30.2 short by 10", solved(rounded(), 30.2, List'F64(40))
"none", solved(along(line((0, 0), (100, 0))), 2, List'F64(50, 0))

════════════════════
test("Script Solve Nearest Solution")

"2 reached", solved(squared(), 1, List'F64(4))
"-2 reached", solved(squared(), -1, List'F64(4))
"150 reached", solved(wave(), 100, List'F64(50))
"30 reached", solved(wave(), 89, List'F64(50))
"180 reached", solved(orbit(), 0, orbit-at(180))
"730 reached", solved(orbit(), 720, orbit-at(10))
"4 reached", solved(slanted(), 0, List'F64(5))
"4 reached", solved(cliff(), 1, List'F64(64))

════════════════════
test("Script Solve Limits")

false, script-solve(wave(), 89, List'F64(50), script-solve-tolerance, 2)!.reached
"30 reached", solved(scaled(5), 30, List'F64(160.4), 20)

