test("Script Solve Rounding")

"32", rounded(scaled(5), 32.0008, 0.01)
"32.0007", rounded(scaled(5), 32.0007, 0.001)
"0.304", rounded(scaled(100), 0.30449, 0.1, 100)
true, script-solve-rounded(scaled(1000000), 1.23456789, 0.001) == 1.2346
"0.5004", rounded(open-above(0.5), 0.5004, 0.01)

