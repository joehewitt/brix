test("Script Solve Moves")

"false", moves(rounded(), 30.5)
"true false", moves(pinned(), 30)
"true", moves(wave(), 90)
"true false", moves(along(line((0, 0), (100, 0))), 1)
"", moves(along(line((0, 0), (100, 0))), 2)

════════════════════
test("Script Solve Track")

"true true", track-past(proportion(), 40, 5, 60)
"2.5 to 10", track-gaps(proportion(), 40, 5, 60)
"160, 50 to 160, 50", track-ends(orbit(), 0, 10, 1000)
"40, -10 to 160, 110", track-reach(orbit(), 0, 10, 1000)
"0, 0 to 100, 0", track-ends(along(line((0, 0), (100, 0))), 0.4, 5, 1000)
"0, 0 to 10, 10", track-reach(along(square-path()), 0.4, 1, 1000)
"34.2 to 34.2", track-ends(wave(), 20, 10, 1000)
"-100 to 100", track-reach(wave(), 20, 10, 1000, 25)
"26 to 34", track-ends(rounded(), 30.2, 1, 3)
1, track-count(pinned-point(), 30, 5, 100)
true, track-count(proportion(), 40, 1, 100000, 20) <= 41

━━━━━━━━━━━━━━━━━━━━
_ scaled ScriptSolveFunction
    - factor F64

:: value => List'F64(value * factor)

━━━━━━━━━━━━━━━━━━━━
_ open-above ScriptSolveFunction
    - least F64

:: value => List'F64(value) if value > least

━━━━━━━━━━━━━━━━━━━━
_ proportion ScriptSolveFunction

:: value => List'F64(value, value / 2)

━━━━━━━━━━━━━━━━━━━━
_ pinned ScriptSolveFunction

:: value => List'F64(value, 7)

━━━━━━━━━━━━━━━━━━━━
_ pinned-point ScriptSolveFunction

:: value => List'F64(7, 7)

━━━━━━━━━━━━━━━━━━━━
_ squared ScriptSolveFunction

:: value => List'F64(value * value)

━━━━━━━━━━━━━━━━━━━━
_ rounded ScriptSolveFunction

:: value => List'F64(round(value))

━━━━━━━━━━━━━━━━━━━━
_ cliff ScriptSolveFunction

:: value => List'F64(if value < 5 then value * value * value else 0.0)

━━━━━━━━━━━━━━━━━━━━
_ slanted ScriptSolveFunction

:: value => List'F64(sqrt(value * value + 9))

━━━━━━━━━━━━━━━━━━━━
_ wave ScriptSolveFunction

:: value => List'F64(100 * sin(value as Degrees))

━━━━━━━━━━━━━━━━━━━━
_ orbit ScriptSolveFunction

:: value => orbit-at(value)

━━━━━━━━━━━━━━━━━━━━
_ orbit-at
    - degrees F64

List'F64(100 + 60 * cos(turn), 50 + 60 * sin(turn))

.. turn = degrees as Degrees as Radians

━━━━━━━━━━━━━━━━━━━━
_ along ScriptSolveFunction
    - path Path

:: value => spot-along(path, value)

━━━━━━━━━━━━━━━━━━━━
_ spot-along
    - path Path
    - position F64

|? position < -0.000001 || position > 1.000001
    null
??
    List'F64(point.x as F64, point.y as F64)

.. point = path.get-point-at-distance(max(0.0, min(position, 1.0)) * (path.length as F64))

━━━━━━━━━━━━━━━━━━━━
_ square-path

rectangle(Rect(0, 0, 10, 10))

━━━━━━━━━━━━━━━━━━━━
_ solved
    - measure ScriptSolveFunction
    - start F64
    - goal [F64]
    - tolerance F64 = script-solve-tolerance

|? !solution
    "none"
|? solution.reached
    "${script-number-text(solution.value)} reached"
??
    "${script-number-text(solution.value)} short by ${script-number-text(solution.distance)}"

.. solution = script-solve(measure, start, goal, tolerance)

━━━━━━━━━━━━━━━━━━━━
_ rounded
    - measure ScriptSolveFunction
    - value F64
    - tolerance F64
    - scale = 1.0

script-number-text(script-solve-rounded(measure, value, tolerance, scale))

━━━━━━━━━━━━━━━━━━━━
_ moves
    - measure ScriptSolveFunction
    - value F64

" ".join("$each" in script-solve-moves(measure, value))

━━━━━━━━━━━━━━━━━━━━
_ track-text
    - numbers [F64]

", ".join(script-number-text(round(each * 100) / 100) in numbers)

━━━━━━━━━━━━━━━━━━━━
_ track-ends
    - measure ScriptSolveFunction
    - start F64
    - stride F64
    - reach F64

|? samples.length
    "${track-text(samples[0])} to ${track-text(samples[samples.length - 1])}"
??
    "none"

.. samples = script-solve-track(measure, start, stride, reach)

━━━━━━━━━━━━━━━━━━━━
_ track-count Index
    - measure ScriptSolveFunction
    - start F64
    - stride F64
    - reach F64
    - limit Index = 256

script-solve-track(measure, start, stride, reach, limit).length

━━━━━━━━━━━━━━━━━━━━
_ do track-gaps
    - measure ScriptSolveFunction
    - start F64
    - stride F64
    - reach F64

. samples = script-solve-track(measure, start, stride, reach)
. least = 0.0
. most = 0.0
for index in 1 .. < samples.length
    . total = 0.0
    for place in 0 .. < samples[index].length
        . gap = samples[index][place] - samples[index - 1][place]
        total += gap * gap
    . length = sqrt(total)
    least = if index == 1 then length else min(least, length)
    most = max(most, length)
. low = if least >= stride / 2 then stride / 2 else least
. high = if most <= stride * 2 then stride * 2 else most
= "${script-number-text(low)} to ${script-number-text(high)}"

━━━━━━━━━━━━━━━━━━━━
_ do track-reach
    - measure ScriptSolveFunction
    - start F64
    - stride F64
    - reach F64
    - grain = 1.0

. samples = script-solve-track(measure, start, stride, reach)
=? "none" if !samples.length
. least = List'F64(each in samples[0])
. most = List'F64(each in samples[0])
for sample in samples
    for place in 0 .. < sample.length
        least[place] = min(least[place], sample[place])
        most[place] = max(most[place], sample[place])
. low = List'F64(round(each / grain) * grain in least)
. high = List'F64(round(each / grain) * grain in most)
= "${track-text(low)} to ${track-text(high)}"

━━━━━━━━━━━━━━━━━━━━
_ do track-past
    - measure ScriptSolveFunction
    - start F64
    - stride F64
    - reach F64

. samples = script-solve-track(measure, start, stride, reach)
. origin = measure(start)
=? "none" if !samples.length || !origin
. ends [String]
for sample in List'[F64](samples[0], samples[samples.length - 1])
    . total = 0.0
    for place in 0 .. < sample.length
        . gap = sample[place] - origin[place]
        total += gap * gap
    . length = sqrt(total)
    ends += "${length > reach && length <= reach + stride * 2}"
= " ".join(ends)
