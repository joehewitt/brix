./support/fixture
/data/json
/data/sexp
/script
/test

table-tests()

━━━━━━━━━━━━━━━━━━━━
+ table-tests TestRender

════════════════════
test("Script S-Expression Printing")

"(* (width @1) 2)", printed("Ball's width * 2")
"(+ 1 2 3)", printed("1 + 2 + 3")
"(- 1 (- 2 3))", printed("1 - (2 - 3)")
"45deg", printed("45°")

════════════════════
test("Script S-Expression Values")

"(previous @1)", reference-printed(ScriptCopy.previous(1))
"(previous @2 @1)", reference-printed(ScriptCopy.previous(2))
"\"say \\\"hi\\\"\"", value-printed(ScriptValue.text("say \"hi\""))

════════════════════
test("Script S-Expression Reading")

"Ball's width * 2", read-back("(* (width @1) 2)")
"1 + 2 + 3", read-back("(+ 1 2 3)")
"1 - (2 - 3)", read-back("(- 1 (- 2 3))")
"-i", read-back("(- @7)")
"-3 * 2", read-back("(* -3 2)")
"point 3 of Star", read-back("  (point-of 3\n  @2) ; the third point")
"Ball #2, #4", read-back("(copy @1 2 4)")
"Star last time", read-back("(previous @2 @1)")
"pi", read-back("pi")
"star points - i", read-back("(- @8 @7)")
"Ball's width * ‹›", read-back("(* (WIDTH @1) _)")

════════════════════
test("Script S-Expression Errors")

"Unknown phrase “wdith”; similar: width", failure("(wdith @1)")
"Unknown phrase “sparkle”", failure("(sparkle @1)")
"Star (@2) can't be used here", scoped-failure("(width @2)")

════════════════════
test("Script S-Expression Checks")

"tangent of Star at 50%", checked("(tangent @2 0.5)", ScriptType(ScriptTypeKind.point))
"0.5 * 2", checked("(* 0.5 2)", script-number-type)

════════════════════
test("Script Phrase Names")

"min", short-name("script.min")
"script.distance", short-name("script.distance")
"script.min", named("min")
"(min a:number b:number) -> number ; min(‹a›, ‹b›)", catalog-line("script.min")

━━━━━━━━━━━━━━━━━━━━
+ printed String
    - text String

sexp-written(script-expression-sexp(script-test-tree(text), script-test-grammar()))

━━━━━━━━━━━━━━━━━━━━
+ reference-printed String
    - copy ScriptCopy?

sexp-written
    - script-expression-sexp
        - ScriptReferenceExpression(ScriptReference(ScriptReferenceKind.node, 1, copy), "Ball")
        - script-test-grammar()

━━━━━━━━━━━━━━━━━━━━
+ value-printed String
    - value ScriptValue

sexp-written(script-expression-sexp(script-value-expression(value), script-test-grammar()))

━━━━━━━━━━━━━━━━━━━━
+ do read-back String
    - text String

. grammar = script-test-grammar()
. result = catch decoded(text, script-test-names())
do match result
    | error Error
        = "error: ${error.message}"
    | expression ScriptExpression
        = script-text(script-print(expression, grammar, script-test-names()))

━━━━━━━━━━━━━━━━━━━━
+ failure String
    - text String

failure-with(text, script-test-names())

━━━━━━━━━━━━━━━━━━━━
+ scoped-failure String
    - text String

failure-with(text, ScopedTestNames())

━━━━━━━━━━━━━━━━━━━━
+ do failure-with String
    - text String
    - names ScriptNames

. result = catch decoded(text, names)
do match result
    | error Error
        = error.message
    ??
        = "no error"

━━━━━━━━━━━━━━━━━━━━
+ decoded ScriptExpression ?! Error
    - text String
    - names ScriptNames

script-sexp-expression(sexp, script-test-grammar(), names)

.. sexp = script-sexp-read(text)

━━━━━━━━━━━━━━━━━━━━
+ do checked String
    - text String
    - expected ScriptType

. grammar = script-test-grammar()
. names = script-test-names()
. result = catch checked-expression(text, expected)
do match result
    | error Error
        = error.message
    | expression ScriptExpression
        = script-text(script-print(expression, grammar, names))

━━━━━━━━━━━━━━━━━━━━
+ checked-expression ScriptExpression ?! Error
    - text String
    - expected ScriptType

script-sexp-checked(expression, grammar, names, expected)

.. grammar = script-test-grammar()
.. names = script-test-names()
.. expression = decoded(text, names)

━━━━━━━━━━━━━━━━━━━━
+ do standard-grammar ScriptGrammar

. vocabulary = script-test-vocabulary()
script-add-standard(vocabulary)
= vocabulary.grammar

━━━━━━━━━━━━━━━━━━━━
+ short-name String
    - kind String

standard-grammar().short-name(kind)

━━━━━━━━━━━━━━━━━━━━
+ named String
    - name String

standard-grammar().form-named(name)?.kind ?? "none"

━━━━━━━━━━━━━━━━━━━━
+ catalog-line String
    - kind String

"${script-sexp-signature(form, grammar)} -> ${script-type-name(form.result)} ; ${form.template}"

.. grammar = standard-grammar()
.. form = grammar.form(kind)!

━━━━━━━━━━━━━━━━━━━━
+ ScopedTestNames
    is ScriptNames

╌╌╌╌╌╌╌╌╌╌ is ScriptNames ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ lookup ScriptName?
    - reference ScriptReference

script-test-names().lookup(reference)

────────────────────
+ candidates [ScriptName]

List'ScriptName(each in script-test-names().names when each.reference.id != 2)
