./expression
./names
./parse
./phrase
./print
./token
./value

━━━━━━━━━━━━━━━━━━━━
+ ScriptOperandTypes is Tuple

+ left ScriptType
+ right ScriptType

━━━━━━━━━━━━━━━━━━━━
+ script-binary-type ScriptType?
    - operator ScriptOperator
    - left ScriptType
    - right ScriptType

|? operator.compares
    script-compared-type(operator, first, second)
|? first == ScriptTypeKind.any || second == ScriptTypeKind.any
    script-any-type
|? first == ScriptTypeKind.number && second == ScriptTypeKind.number
    script-number-type
|? first == ScriptTypeKind.point && second == ScriptTypeKind.point && additive
    point
|? first == ScriptTypeKind.point && second == ScriptTypeKind.number && !additive && not-remainder
    point
|? first == ScriptTypeKind.number && second == ScriptTypeKind.point && multiplies
    point
??
    null

.. additive = operator == ScriptOperator.add || operator == ScriptOperator.subtract
.. point = ScriptType(ScriptTypeKind.point)
.. first = script-arithmetic-kind(left)
.. second = script-arithmetic-kind(right)
.. not-remainder = operator != ScriptOperator.remainder
.. multiplies = operator == ScriptOperator.multiply

━━━━━━━━━━━━━━━━━━━━
+ script-compared-type ScriptType?
    - operator ScriptOperator
    - first ScriptTypeKind
    - second ScriptTypeKind

|? first == ScriptTypeKind.any || second == ScriptTypeKind.any
    script-truth-type
|? first == ScriptTypeKind.number && second == ScriptTypeKind.number
    script-truth-type
|? first == second && equality && plain
    script-truth-type
??
    null

.. equality = operator == ScriptOperator.equal || operator == ScriptOperator.unequal
.. plain = first == ScriptTypeKind.point || first == ScriptTypeKind.text || first == ScriptTypeKind.color || first == ScriptTypeKind.truth

━━━━━━━━━━━━━━━━━━━━
+ script-arithmetic-kind ScriptTypeKind
    - type ScriptType

|? type.kind == ScriptTypeKind.loop
    ScriptTypeKind.number
|? type.kind == ScriptTypeKind.range
    ScriptTypeKind.any
??
    type.kind

━━━━━━━━━━━━━━━━━━━━
+ do script-operand-types ScriptOperandTypes
    - operator ScriptOperator
    - expected ScriptType
    - left ScriptType
    - right ScriptType

. number = script-number-type
. point = ScriptType(ScriptTypeKind.point)
. any = script-any-type
. additive = operator == ScriptOperator.add || operator == ScriptOperator.subtract
. left-point = left.kind == ScriptTypeKind.point
. right-point = right.kind == ScriptTypeKind.point
=? ScriptOperandTypes(right-type, script-arithmetic-type(left)) if operator.compares
.. right-type = script-arithmetic-type(right)
=? ScriptOperandTypes(number, number) if operator == ScriptOperator.remainder
do match expected.kind
    |= .number
        = ScriptOperandTypes(number, number)
    |= .point
        |? additive
            = ScriptOperandTypes(point, point)
        |? operator == ScriptOperator.divide
            = ScriptOperandTypes(point, number)
        |? left.kind == ScriptTypeKind.number || right-point
            = ScriptOperandTypes(number, point)
        |? left-point || right.kind == ScriptTypeKind.number
            = ScriptOperandTypes(point, number)
        ??
            = ScriptOperandTypes(any, any)
    |= .any
        |? additive
            = ScriptOperandTypes(script-arithmetic-type(right), script-arithmetic-type(left))
        |? operator == ScriptOperator.divide || left-point
            = ScriptOperandTypes(any, number)
        |? right-point
            = ScriptOperandTypes(number, any)
        ??
            = ScriptOperandTypes(any, any)
    ??
        = ScriptOperandTypes(any, any)

━━━━━━━━━━━━━━━━━━━━
+ script-arithmetic-type
    - type ScriptType

if type.kind == ScriptTypeKind.number || type.kind == ScriptTypeKind.point then type.without-unit else script-any-type

━━━━━━━━━━━━━━━━━━━━
+ script-range-expectation ScriptType
    - slot ScriptType
    - wanted ScriptType

|? slot.kind == ScriptTypeKind.any || slot.kind == ScriptTypeKind.range
    if wanted.kind == .range || wanted.kind == .loop then script-any-type else wanted
|? slot.kind == ScriptTypeKind.number
    if wanted.kind == ScriptTypeKind.number then number-type else slot
    .. number-type = ScriptType(ScriptTypeKind.number, wanted.unit)
??
    slot

━━━━━━━━━━━━━━━━━━━━
+ script-outline ScriptOutline
    - tokens [ScriptToken]
    - grammar ScriptGrammar
    - names ScriptNames? = null
    - expected = script-any-type

outline.regrouped() ?? outline

.. outline = ScriptOutline(script-parse(tokens, grammar), grammar, names, expected)

━━━━━━━━━━━━━━━━━━━━
+ ScriptOutline

+ expression ScriptExpression
+ grammar ScriptGrammar
+ names ScriptNames?
+ expected ScriptType
+ tokens [ScriptToken]
+ spans [ScriptSpan]
+ types [ScriptType]
+ expectations [ScriptType]
+ owners [Index]
+ children [[Index]]

────────────────────
+ This
    - expression
    - grammar
    - names ScriptNames? = null
    - expected = script-any-type

. printer = ScriptPrinter(grammar, names)
tokens = printer.print(expression)
spans = printer.spans
this.expression = spans[0].expression
for index in 0 .. < spans.length
    children += List'Index()
    types += script-any-type
    expectations += script-any-type
    . parent = spans[index].parent
    if parent
        children[parent] += index
for token in tokens
    owners += 0
for index in 0 .. < spans.length
    for position in spans[index].start .. < spans[index].end
        owners[position] = index
for offset in 0 .. < spans.length
    . index = spans.length - 1 - offset
    types[index] = static-type(index) ?? script-any-type
expectations[0] = expected
for index in 0 .. < spans.length
    expect-children(index)

────────────────────
+ get root-type

types[0]

────────────────────
+ do span-of Index?
    - expression ScriptExpression

for index in 0 .. < spans.length
    =? index if script-same(spans[index].expression, expression)
= null

────────────────────
+ do enclosing Index?
    - start Index
    - end Index

. best Index?
for index in 0 .. < spans.length
    . span = spans[index]
    if span.start <= start && span.end >= end && (span.start < start || span.end > end)
        if !best || span.end - span.start < spans[best].end - spans[best].start
            best = index
= best

────────────────────
+ do ending-operand Index?
    - end Index

=? null if end == 0
. index = owners[end - 1]
=? null if spans[index].end != end
while true
    . parent = spans[index].parent
    =? index if !parent
    . outer = spans[parent]
    =? index if outer-extends || outer.expression.precedence.level < ScriptPrecedence.postfix.level
    .. outer-extends = outer.end != end
    index = parent
= index

────────────────────
+ do regrouped ScriptOutline?

=? null if !script-is-complete(expression) || !issue()
for offset in 0 .. < spans.length
    . index = spans.length - 1 - offset
    . tail = greedy-tail(index)
    if tail != null
        . found = regrouped-under(index, tail)
        =? found if found
= null

────────────────────
_ regrouped-under ScriptOutline?
    - phrase Index
    - node Index

|? deeper
    deeper
|? left == null
    null
|? script-is-complete(candidate.expression) && !candidate.issue()
    candidate
??
    regrouped-under(phrase, left)

.. tail = greedy-tail(node)
.. deeper = regrouped-under(phrase, tail) if tail != null
.. left = leading(node)
.. tree = script-parse(bracketed(spans[phrase].start, spans[left].end), grammar)
.. candidate = ScriptOutline(tree, grammar, names, expected)

────────────────────
_ greedy-tail Index?
    - index Index

|? !form || !form.ends-with-slot
    null
|? !kids.length
    null
|? spans[last].slot != form.parts[form.parts.length - 1].slot
    null
??
    last

.. form = phrase-form(index)
.. kids = children[index]
.. last = kids[kids.length - 1]

────────────────────
_ leading Index?
    - index Index

|? !kids.length
    null
|? spans[index].expression is ScriptBinary
    kids[0]
|? form && form.starts-with-slot && spans[kids[0]].slot == form.parts[0].slot
    kids[0]
??
    null

.. kids = children[index]
.. form = phrase-form(index)

────────────────────
_ phrase-form ScriptPhraseForm?
    - index Index

|? expression is not ScriptPhraseExpression
    null
|? !form || form.is-function || form.result.kind == ScriptTypeKind.range
    null
??
    form

.. expression = spans[index].expression
.. form = grammar.form((expression as ScriptPhraseExpression).kind)

────────────────────
_ do bracketed [ScriptToken]
    - start Index
    - end Index

. result [ScriptToken]
for position in 0 .. < tokens.length
    if position == start
        result += script-open-token
    if position == end
        result += script-close-token()
    result += tokens[position]
= result

────────────────────
+ do issue ScriptError?

. best ScriptError?
. size Size = 0
for index in 0 .. < spans.length
    . found = issue-at(index)
    . length = spans[index].end - spans[index].start
    if found && (!best || length < size)
        best = found
        size = length
= best

────────────────────
+ issue-at ScriptError?
    - index Index

|? expression is ScriptBinary && !script-binary-type(binary.operator, left, right)
    ScriptError
        - ScriptErrorKind.type-mismatch
        - "Cannot use '${binary.operator.symbol}' with ${left.described} and ${right.described}"
        - expression
|? expression is ScriptNegation && operand.kind != ScriptTypeKind.any && operand.kind != ScriptTypeKind.number && operand.kind != ScriptTypeKind.point
    ScriptError(ScriptErrorKind.type-mismatch, "Cannot negate ${operand.described}", expression)
|? wanted.admits(actual) || grammar.converts(actual, wanted)
    null
|? !node && invalid-pair(spans[index].parent)
    null
|? fix
    ScriptError(ScriptErrorKind.type-mismatch, "$message; try “$fix”", expression)
??
    ScriptError(ScriptErrorKind.type-mismatch, message, expression)

.. expression = spans[index].expression
.. kids = children[index]
.. binary = expression as ScriptBinary
.. left = grammar.operand(types[kids[0]])
.. right = grammar.operand(types[kids[1]])
.. operand = grammar.operand(types[kids[0]])
.. actual = types[index]
.. wanted = expectations[index]
.. node = actual.kind == ScriptTypeKind.node || actual.kind == ScriptTypeKind.nodes
.. message = "Expected ${wanted.described}, not ${actual.described}"
.. fix = suggestion(index)

────────────────────
_ invalid-pair Bool
    - index Index?

|? !index
    false
|? !(expression is ScriptBinary)
    false
??
    script-binary-type((expression as ScriptBinary).operator, left, right) == null

.. expression = spans[index].expression
.. kids = children[index]
.. left = grammar.operand(types[kids[0]])
.. right = grammar.operand(types[kids[1]])

────────────────────
+ do suggestion String?
    - index Index

. actual = types[index]
. wanted = expectations[index]
=? null if actual.kind != ScriptTypeKind.node && actual.kind != ScriptTypeKind.nodes
for form in grammar.all
    if form.starts-with-slot && form.parts.length == 2 && !form.parts[1].is-slot
        if slot-admits && wanted.admits(form.result) && form.result.kind != ScriptTypeKind.any
            . subject = List'ScriptToken(tokens[each] in spans[index].start .. < spans[index].end)
            subject += script-word-token(form.kind, 1, form.parts[1].word, true)
            = script-text(subject)
        .. slot-admits = form.parts[0].type.admits(actual)
= null

────────────────────
+ do apply-units

for index in 0 .. < spans.length
    . expression = spans[index].expression
    if expression is ScriptLiteral && expectations[index].unit == ScriptUnit.percent
        . literal = expression as ScriptLiteral
        . typed = script-number-value(literal.text)
        if literal.value.as-number && typed && !has-percent && !literal.text.ends-with("°")
            literal.value = ScriptValue.number(typed / 100)
            literal.text = "${literal.text}%"
        .. has-percent = literal.text.ends-with("%")

────────────────────
_ do static-type ScriptType?
    - index Index

. expression = spans[index].expression
. kids = children[index]
do match expression
    | literal ScriptLiteral
        = script-value-type(literal.value)
    | reference ScriptReferenceExpression
        = names?.lookup(reference.reference)?.type
    | negation ScriptNegation
        . operand = grammar.operand(types[kids[0]])
        =? operand.without-unit if operand.kind == ScriptTypeKind.number || is-point
        .. is-point = operand.kind == ScriptTypeKind.point
        = null
    | binary ScriptBinary
        . left = grammar.operand(types[kids[0]])
        = script-binary-type(binary.operator, left, grammar.operand(types[kids[1]]))
    | point ScriptPointExpression
        = ScriptType(ScriptTypeKind.point)
    | group ScriptGroup
        = types[kids[0]]
    | phrase ScriptPhraseExpression
        = grammar.form(phrase.kind)?.result
    | list ScriptListExpression
        = ScriptType(ScriptTypeKind.range)
    ??
        = null

────────────────────
_ do expect-children
    - index Index

. kids = children[index]
=? if !kids.length
. wanted = expectations[index]
. expression = spans[index].expression
do match expression
    | binary ScriptBinary
        . left = grammar.operand(types[kids[0]])
        . right = grammar.operand(types[kids[1]])
        . operands = script-operand-types(binary.operator, wanted, left, right)
        expectations[kids[0]] = operands.left
        expectations[kids[1]] = operands.right
    | negation ScriptNegation
        . numeric = wanted.kind == ScriptTypeKind.number || wanted.kind == ScriptTypeKind.point
        expectations[kids[0]] = if numeric then wanted else script-any-type
    | point ScriptPointExpression
        . unit = if wanted.kind == ScriptTypeKind.point then wanted.unit else ScriptUnit.none
        for kid in kids
            expectations[kid] = ScriptType(ScriptTypeKind.number, unit)
    | phrase ScriptPhraseExpression
        . form = grammar.form(phrase.kind)
        . ranged = form != null && form.result.kind == ScriptTypeKind.range
        . passes = form != null && form.result.kind == ScriptTypeKind.any
        for kid in kids
            . slot = if form then form.slot-type(spans[kid].slot) else script-any-type
            expectations[kid] =
                |? ranged || (passes && slot.kind == ScriptTypeKind.any)
                    script-range-expectation(slot, wanted)
                ??
                    slot
    | list ScriptListExpression
        for kid in kids
            expectations[kid] = if wanted.kind == ScriptTypeKind.range then script-any-type else wanted
    ??
        for kid in kids
            expectations[kid] = wanted
