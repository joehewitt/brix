./expression
./names
./outline
./parse
./phrase
./print
./range
./read
./rewrite
./token
./value
/core/arena
/data/fuzzy
/data/sexp
/graphics/color
/math

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-form Sexp
    - head String
    - arguments [Sexp]

Sexp.list(List'Sexp(Sexp.atom(head)) ++ arguments)

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-head String?
    - sexp Sexp

match? sexp
    | .atom(name)
        name

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-reserved Bool
    - name String

List'String("+", "-", "*", "/", "%", "<", ">", "<=", ">=", "=", "!=", "_", "pt", "list", "nodes", "parts", "last", "every", "copy", "previous", "cannot") has name

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-read Sexp ?! Error
    - text String

?! Error("The reply is empty")
    if forms.length == 0
?! Error("Only one form is allowed, but more follows: ${tape.bytes.slice-string(tape.start(forms[1]) .. < tape.bytes.length).trim()}")
    if forms.length > 1
sexp-tree(tape, forms[0])

.. scratch = use Arena()
.. tape = sexp-tape(text, scratch, false)
.. forms = List(tape.forms())

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-phrase-name String
    - kind String
    - grammar ScriptGrammar

if script-sexp-reserved(short) then kind else short

.. short = grammar.short-name(kind)

━━━━━━━━━━━━━━━━━━━━
+ do script-expression-sexp Sexp
    - expression ScriptExpression
    - grammar ScriptGrammar

do match expression
    | literal ScriptLiteral
        . number = literal.value.as-number
        =? Sexp.atom(script-sexp-number-text(literal.text, number)) if number && !loop-value
        .. loop-value = literal.value.as-loop
        = script-value-sexp(literal.value, grammar)
    | reference ScriptReferenceExpression
        = script-reference-sexp(reference.reference)
    | negation ScriptNegation
        = script-sexp-form("-", List'Sexp(script-expression-sexp(negation.operand, grammar)))
    | binary ScriptBinary
        . items = List'Sexp(Sexp.atom(binary.operator.symbol))
        script-sexp-operands(binary.operator, binary.left, grammar, items)
        items += script-expression-sexp(binary.right, grammar)
        = Sexp.list(items)
    | point ScriptPointExpression
        = script-sexp-form
            - "pt"
            - List'Sexp
                - script-expression-sexp(point.x, grammar)
                - script-expression-sexp(point.y, grammar)
    | group ScriptGroup
        = script-expression-sexp(group.inner, grammar)
    | phrase ScriptPhraseExpression
        = script-phrase-sexp(phrase, grammar)
    | list ScriptListExpression
        = script-sexp-form("list", List'Sexp(script-expression-sexp(each, grammar) in list.items))
    ??
        = Sexp.atom("_")

━━━━━━━━━━━━━━━━━━━━
_ do script-sexp-operands
    - operator ScriptOperator
    - expression ScriptExpression
    - grammar ScriptGrammar
    - items [Sexp]

. inner = script-ungrouped(expression)
if inner is ScriptBinary && (inner as ScriptBinary).operator == operator
    . binary = inner as ScriptBinary
    script-sexp-operands(operator, binary.left, grammar, items)
    items += script-expression-sexp(binary.right, grammar)
else
    items += script-expression-sexp(expression, grammar)

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-number-text String
    - text String
    - value F64

|? typed != value
    script-number-text(value)
|? text.ends-with("°")
    "${text[0 .. < text.length - 1]}deg"
??
    text

.. typed = script-number-value(text)

━━━━━━━━━━━━━━━━━━━━
+ do script-value-sexp Sexp
    - value ScriptValue
    - grammar ScriptGrammar

do match value
    | .number(number)
        = Sexp.atom(script-number-text(number))
    | .point(point)
        = script-sexp-form
            - "pt"
            - List'Sexp
                - Sexp.atom(script-number-text(point.x))
                - Sexp.atom(script-number-text(point.y))
    | .color(color)
        = Sexp.atom(script-color-text(color))
    | .text(text)
        = Sexp.text(text)
    | .node(node)
        = Sexp.atom("@${node.id}")
    | .nodes(nodes)
        = script-sexp-form("nodes", List'Sexp(Sexp.atom("@${each.id}") in nodes))
    | .loop(loop)
        = Sexp.atom(script-number-text(loop.number))
    | .range(range)
        = script-range-sexp(range, grammar)
    | .part(part)
        . phrased = grammar.part-expression(part)
        =? script-expression-sexp(phrased, grammar) if phrased
        . place = Sexp.atom("${part.number}")
        . whole = Sexp.atom("@${part.node.id}")
        = script-sexp-form(part.kind, List'Sexp(place, whole))
    | .parts(parts)
        . phrased = grammar.parts-expression(parts)
        =? script-expression-sexp(phrased, grammar) if phrased
        . items = List'Sexp(script-value-sexp(ScriptValue.part(each), grammar) in parts)
        = script-sexp-form("parts", items)
    | .truth(truth)
        = Sexp.atom(if truth then "true" else "false")

━━━━━━━━━━━━━━━━━━━━
+ do script-range-sexp Sexp
    - range ScriptRange
    - grammar ScriptGrammar

if range.items.length
    = script-sexp-form("list", List'Sexp(script-value-sexp(each, grammar) in range.items))
. result = script-sexp-form
    - script-sexp-phrase-name(script-range-kind, grammar)
    - List'Sexp(script-value-sexp(range.first, grammar), script-value-sexp(range.last, grammar))
if range.step
    result = script-sexp-form
        - script-sexp-phrase-name(script-range-step-kind, grammar)
        - List'Sexp(result, Sexp.atom(script-number-text(range.step!)))
do match? range.easing
    |= .ease-in
        result = script-sexp-form
            - script-sexp-phrase-name(script-ease-in-kind, grammar)
            - List'Sexp(result)
    |= .ease-out
        result = script-sexp-form
            - script-sexp-phrase-name(script-ease-out-kind, grammar)
            - List'Sexp(result)
    |= .ease-in-out
        result = script-sexp-form
            - script-sexp-phrase-name(script-ease-in-out-kind, grammar)
            - List'Sexp(result)
= result

━━━━━━━━━━━━━━━━━━━━
+ do script-reference-sexp Sexp
    - reference ScriptReference

. id = Sexp.atom("@${reference.id}")
. copy = reference.copy
=? id if !copy
do match copy
    | .previous(source)
        . items = List'Sexp(Sexp.atom("previous"), Sexp.atom("@$source"))
        if source != reference.id
            items += id
        = Sexp.list(items)
    | .last
        = script-sexp-form("last", List'Sexp(id))
    | .numbers(numbers)
        . items = List'Sexp(Sexp.atom("copy"), id)
        for number in numbers
            items += Sexp.atom("$number")
        = Sexp.list(items)
    | .every
        = script-sexp-form("every", List'Sexp(id))
    | .variable(variable)
        = script-sexp-form("copy", List'Sexp(id, Sexp.atom("@$variable")))

━━━━━━━━━━━━━━━━━━━━
+ do script-phrase-sexp Sexp
    - phrase ScriptPhraseExpression
    - grammar ScriptGrammar

. items = List'Sexp(Sexp.atom(script-sexp-phrase-name(phrase.kind, grammar)))
. form = grammar.form(phrase.kind)
if form
    for part in form.slots
        items += script-expression-sexp(phrase.arguments[part.slot] ?? ScriptHole(), grammar)
else
    for slot, argument in phrase.arguments
        items += script-expression-sexp(argument, grammar)
= Sexp.list(items)

━━━━━━━━━━━━━━━━━━━━
+ do script-sexp-declined String?
    - sexp Sexp

do match? sexp
    | .list(items)
        =? null if !items.length || script-sexp-head(items[0]) != "cannot"
        =? "" if items.length == 1
        do match items[1]
            | .text(reason)
                = reason
            ??
                = sexp-written(items[1])
= null

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-expression ScriptExpression ?! Error
    - sexp Sexp
    - grammar ScriptGrammar
    - names ScriptNames

ScriptSexpDecoder(grammar, names).expression(sexp)

━━━━━━━━━━━━━━━━━━━━
+ ScriptSexpDecoder

+ grammar ScriptGrammar
+ names ScriptNames

_ scope Map'U64'ScriptName
_ scoped = false

────────────────────
+ This
    - grammar
    - names

────────────────────
+ do expression ScriptExpression ?! Error
    - sexp Sexp

do match sexp
    | .atom(atom)
        = atom-expression(atom)
    | .text(value)
        = ScriptLiteral(ScriptValue.text(value), "")
    | .list(items)
        = form-expression(items, sexp)

────────────────────
+ reference ScriptReference ?! Error
    - sexp Sexp

?! Error("Expected an id like @3, not ${sexp-written(sexp)}")
    if !(found is ScriptReferenceExpression)
(found as ScriptReferenceExpression).reference

.. found = expression(sexp)

────────────────────
+ do named ScriptName ?! Error
    - atom String

. id = script-sexp-id(atom)
?! Error("Expected an id like @3, not $atom")
    if !id
if !scoped
    for candidate in names.candidates()
        scope[candidate.reference.id] = candidate
    scoped = true
. found = scope[id]
=? found if found
. elsewhere = names.lookup(script-node-reference(id)) ?? names.lookup(script-variable-reference(id))
?! Error("${elsewhere.name} ($atom) can't be used here")
    if elsewhere
?! Error("Nothing has the id $atom")

────────────────────
_ do atom-expression ScriptExpression ?! Error
    - atom String

=? ScriptHole() if atom == "_"
if atom.starts-with("@")
    = referenced(atom, null)
if atom.starts-with("#")
    . color = script-sexp-color(atom)
    ?! Error("$atom is not a color; write colors like #ff8800")
        if !color
    = ScriptLiteral(ScriptValue.color(color), atom)
. number = script-sexp-number(atom)
=? number if number
. form = grammar.form-named(atom) ?? grammar.form-named(atom.lowercased)
=? ScriptPhraseExpression(form.kind) if form && !form.slots.length
?! Error("Expected ${script-sexp-signature(form, grammar)}, not $atom")
    if form
?! Error("${unknown(atom).message}. Write layers and variables by id, like @3")

────────────────────
_ referenced ScriptExpression ?! Error
    - atom String
    - copy ScriptCopy?

ScriptReferenceExpression
    - ScriptReference(found.reference.kind, found.reference.id, copy)
    - found.name

.. found = named(atom)

────────────────────
_ do form-expression ScriptExpression ?! Error
    - items [Sexp]
    - sexp Sexp

?! Error("A form can't be empty")
    if !items.length
. head = script-sexp-head(items[0])
?! Error("A form must start with a name: ${sexp-written(sexp)}")
    if !head
. count = items.length - 1
do match? head
    |= "-"
        ?! Error("“-” needs an argument: ${sexp-written(sexp)}")
            if count == 0
        =? ScriptNegation(expression(items[1])) if count == 1
        = folded(ScriptOperator.subtract, items, sexp)
    |= "pt"
        ?! Error("“pt” takes 2 arguments: ${sexp-written(sexp)}")
            if count != 2
        = ScriptPointExpression(expression(items[1]), expression(items[2]))
    |= "list"
        ?! Error("“list” needs at least 2 items: ${sexp-written(sexp)}")
            if count < 2
        . values [ScriptExpression]
        for index in 1 .. < items.length
            values += expression(items[index])
        = ScriptListExpression(values)
    |= "nodes"
        . nodes [ScriptNode]
        for index in 1 .. < items.length
            . found = named(script-sexp-head(items[index]) ?? sexp-written(items[index]))
            nodes += ScriptNode(found.reference.id, found.type.node-kind)
        = ScriptLiteral(ScriptValue.nodes(nodes), "")
    |= "parts"
        . parts [ScriptNodePart]
        for index in 1 .. < items.length
            . part = grammar.expression-part(expression(items[index]), names)
            ?! Error("Expected a part, not ${sexp-written(items[index])}")
                if !part
            parts += part
        = ScriptLiteral(ScriptValue.parts(parts), "")
    |= "last"
        = copied(items, sexp, ScriptCopy.last)
    |= "every"
        = copied(items, sexp, ScriptCopy.every)
    |= "copy"
        . counter = ""
        if count == 2
            counter = script-sexp-head(items[2]) ?? ""
        if counter.starts-with("@")
            . variable = named(counter)
            . shown = sexp-written(sexp)
            ?! Error("A copy is numbered by a variable or a loop, not a layer: $shown")
                if variable.reference.kind != ScriptReferenceKind.variable
            . numbered = ScriptCopy.variable(variable.reference.id)
            = copied(List'Sexp(items[0], items[1]), sexp, numbered)
        . numbers [Index]
        for index in 2 .. < items.length
            . number = script-sexp-count(script-sexp-head(items[index]) ?? "")
            ?! Error("Copy numbers are whole numbers from 1: ${sexp-written(sexp)}")
                if !number
            numbers += number
        . examples = "like (copy @3 2), or a variable, like (copy @3 @5)"
        ?! Error("“copy” needs an id and copy numbers, $examples: ${sexp-written(sexp)}")
            if !numbers.length
        = copied(List'Sexp(items[0], items[1]), sexp, ScriptCopy.numbers(numbers))
    |= "previous"
        ?! Error("“previous” takes an id and an optional first-pass id: ${sexp-written(sexp)}")
            if count < 1 || count > 2
        . source = named(script-sexp-head(items[1]) ?? sexp-written(items[1]))
        . fallback = if count == 2 then named(fallback-name) else source
            .. fallback-name = script-sexp-head(items[2]) ?? sexp-written(items[2])
        = ScriptReferenceExpression
            - ScriptReference
                - fallback.reference.kind
                - fallback.reference.id
                - ScriptCopy.previous(source.reference.id)
            - fallback.name
    |= "cannot"
        ?! Error("“cannot” must be the whole reply")
. operator = script-operator-named(head)
=? folded(operator, items, sexp) if operator
= phrase(head, items, sexp)

────────────────────
_ do folded ScriptExpression ?! Error
    - operator ScriptOperator
    - items [Sexp]
    - sexp Sexp

?! Error("“${operator.symbol}” needs at least 2 arguments: ${sexp-written(sexp)}")
    if items.length < 3
. result = expression(items[1])
for index in 2 .. < items.length
    result = ScriptBinary(operator, result, expression(items[index]))
= result

────────────────────
_ copied ScriptExpression ?! Error
    - items [Sexp]
    - sexp Sexp
    - copy ScriptCopy

?! Error("“$head” takes one id, like ($head @3): ${sexp-written(sexp)}")
    if items.length != 2
referenced(script-sexp-head(items[1]) ?? sexp-written(items[1]), copy)

.. head = script-sexp-head(items[0])!

────────────────────
_ do phrase ScriptExpression ?! Error
    - head String
    - items [Sexp]
    - sexp Sexp

. form = grammar.form-named(head) ?? grammar.form-named(head.lowercased)
?! unknown(head)
    if !form
. slots = form.slots
?! Error("Expected ${script-sexp-signature(form, grammar)}, not ${sexp-written(sexp)}")
    if items.length - 1 != slots.length
. arguments = Map'String'ScriptExpression()
for index in 0 .. < slots.length
    arguments[slots[index].slot] = expression(items[index + 1])
= ScriptPhraseExpression(form.kind, arguments)

────────────────────
_ unknown Error
    - name String

|? !nearest.length
    Error("Unknown phrase “$name”")
??
    Error("Unknown phrase “$name”; similar: ${", ".join(each in nearest)}")

.. nearest = script-sexp-nearest(name, grammar)

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-number ScriptExpression?
    - atom String

|? atom.starts-with("-") && atom.length > 1
    ScriptNegation(inner) if inner
    .. inner = script-sexp-number(atom[1 .. < atom.length])
|? !value
    null
??
    ScriptLiteral(ScriptValue.number(value), text)

.. text = if atom.ends-with("deg") then "${atom[0 .. < atom.length - 3]}°" else atom
.. value = script-number-value(text)

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-color RGBA?
    - atom String

match? atom
    ~ color RGBA !.
        color

━━━━━━━━━━━━━━━━━━━━
+ do script-sexp-id U64?
    - atom String

=? null if atom.length < 2 || !atom.starts-with("@")
. id U64
for index in 1 .. < atom.length
    . c = atom[index]
    =? null if !script-reader-digit(c)
    id = id * 10 + ((c as U64) - ('0' as U64))
= id

━━━━━━━━━━━━━━━━━━━━
+ do script-sexp-count Index?
    - atom String

=? null if !atom.length
. count Index = 0
for c in atom
    =? null if !script-reader-digit(c)
    count = count * 10 + ((c as Index) - ('0' as Index))
= count if count > 0

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-nearest [String]
    - name String
    - grammar ScriptGrammar

nearest-names(name, List'String(script-sexp-phrase-name(each.kind, grammar) in grammar.all))

━━━━━━━━━━━━━━━━━━━━
+ do script-sexp-signature String
    - form ScriptPhraseForm
    - grammar ScriptGrammar

. parts = List'String(script-sexp-phrase-name(form.kind, grammar))
for part in form.slots
    parts += script-sexp-slot(part.slot, script-type-name(part.type))
= "(${" ".join(each in parts)})"

━━━━━━━━━━━━━━━━━━━━
+ script-sexp-slot String
    - name String
    - type String

if name == type then name else "$name:$type"

━━━━━━━━━━━━━━━━━━━━
+ do script-phrase-catalog String
    - grammar ScriptGrammar

. lines [String]
for form in grammar.all
    lines += "$signature -> ${script-type-name(form.result)} ; ${form.template}"
        .. signature = script-sexp-signature(form, grammar)
= "\n".join(each in lines)

━━━━━━━━━━━━━━━━━━━━
+ do script-sexp-checked ScriptExpression ?! Error
    - expression ScriptExpression
    - grammar ScriptGrammar
    - names ScriptNames
    - expected = script-any-type

?! Error("Replace every _ with a value: ${sexp-written(script-expression-sexp(expression, grammar))}")
    if !script-is-complete(expression)
. outline = ScriptOutline(expression, grammar, names, expected)
. issue = outline.issue()
if issue
    . subtree = issue.subtree
    ?! Error("${issue.message}: ${sexp-written(script-expression-sexp(subtree, grammar))}")
        if subtree
    ?! Error(issue.message)
for index in 0 .. < outline.spans.length
    . found = outline.spans[index].expression
    if found is ScriptLiteral && outline.expectations[index].unit == ScriptUnit.percent
        . literal = found as ScriptLiteral
        . number = literal.value.as-number
        if number && !literal.value.as-loop && !literal.text.ends-with("%")
            literal.text = "${script-number-text(number * 100)}%"
= outline.expression
