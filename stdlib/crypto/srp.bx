(import ./bytes)
(import ./crypto-error)
(import ./digest)
(import ./random)
(import /openssl/bn.h)
(blank)
(prop + srp-size Size (= 384))
(blank)
(prop _ srp-prime Hex
  (=
    (paragraph
      ""
    )
  )
)
(prop _ srp-generator Hex (= "05"))

(type + SRPClient
  (prop + username String)
  (prop + password String)
  (prop + public-key ([] Byte))
  (prop + session-key _ (= ([] Byte 0)))
  (blank)
  (prop _ private-key ([] Byte))
  (prop _ expected-proof _ (= ([] Byte 0)))
  (fn-do + This _
    (param username _)
    (param password _)
    (param private-key _ (= (call random-bytes 32)))
    (lazy public-key (call srp-public-key private-key))
  )
  (fn-do + prove ([] Byte) (?! CryptoError)
    (param salt ([] Byte))
    (param server-public-key ([] Byte))
    (throw (call CryptoError "The server's public key is longer than the group") (if (> (. server-public-key size) srp-size)))
    (blank)
    (let numbers (use (call SRPNumbers)))
    (let server-public (call (. numbers number) server-public-key))
    (let remainder (call (. numbers fresh)))
    (call C:BN_nnmod remainder server-public (. numbers prime) (. numbers context))
    (throw (call CryptoError "The server's public key is a multiple of the group's prime") (if (== (call C:BN_is_zero remainder) 1)))
    (blank)
    (let server-padded (call (. numbers padded) server-public))
    (let scrambler (call (. numbers hashed) (call joined-bytes (list public-key server-padded))))
    (throw (call CryptoError "The SRP scrambling parameter is zero") (if (== (call C:BN_is_zero scrambler) 1)))
    (blank)
    (let generator-padded (call (. numbers padded) (. numbers generator)))
    (let multiplier (call (. numbers hashed) (call joined-bytes (list (as srp-prime ([] Byte)) generator-padded))))
    (let identity (call sha512 (call byte-view (str username ":" password))))
    (let password-exponent (call (. numbers hashed) (call joined-bytes (list salt identity))))
    (let verifier (call (. numbers power) (. numbers generator) password-exponent))
    (let multiplied (call (. numbers fresh)))
    (call C:BN_mod_mul multiplied multiplier verifier (. numbers prime) (. numbers context))
    (let base (call (. numbers fresh)))
    (call C:BN_mod_sub base server-public multiplied (. numbers prime) (. numbers context))
    (let scrambled (call (. numbers fresh)))
    (call C:BN_mul scrambled scrambler password-exponent (. numbers context))
    (let exponent (call (. numbers fresh)))
    (call C:BN_add exponent (call (. numbers number) private-key) scrambled)
    (= session-key (call sha512 (call (. numbers padded) (call (. numbers power) base exponent))))
    (let group-hash (call sha512 (as srp-prime ([] Byte))))
    (let generator-hash (call sha512 (as srp-generator ([] Byte))))
    (for (in index (..< 0 (. group-hash size)))
      (= ([] group-hash index) (/xor/ ([] group-hash index) ([] generator-hash index)))
    )
    (let transcript
      (block
        (list group-hash (call sha512 (call byte-view username)) salt public-key server-padded session-key)
      )
    )
    (let proof (call sha512 (call joined-bytes transcript)))
    (= expected-proof (call sha512 (call joined-bytes (list public-key proof session-key))))
    (return proof)
  )
  (fn-do + verify _ (?! CryptoError)
    (param server-proof ([] Byte))
    (throw (call CryptoError "The server's SRP proof does not match") (if (or (== (. expected-proof size) 0) (not (call bytes-match server-proof expected-proof)))))
  )
)

(fn-expr _ srp-public-key ([] Byte)
  (param private-key ([] Byte))
  (call (. numbers padded) (call (. numbers power) (. numbers generator) (call (. numbers number) private-key)))
  (where
    (lazy numbers (use (call SRPNumbers)))
  )
)

(type _ SRPNumbers
  (implements (of Usable SRPNumbers))
  (prop + context (of CPointer I8))
  (prop + prime (of CPointer I8))
  (prop + generator (of CPointer I8))
  (blank)
  (prop _ owned (list (of CPointer I8)))
  (fn-do + This _
    (= context (call C:BN_CTX_new))
    (= prime (call number srp-prime))
    (= generator (call number srp-generator))
  )
  (fn-do + number (of CPointer I8)
    (param bytes ([] Byte))
    (let value (call C:BN_bin2bn bytes (. bytes size) null))
    (+= owned value)
    (return value)
  )
  (fn-do + fresh (of CPointer I8)
    (let value (call C:BN_new))
    (+= owned value)
    (return value)
  )
  (fn-expr + hashed (of CPointer I8)
    (param bytes ([] Byte))
    (call number (call sha512 bytes))
  )
  (fn-do + power (of CPointer I8)
    (param base (of CPointer I8))
    (param exponent (of CPointer I8))
    (let result (call fresh))
    (call C:BN_mod_exp result base exponent prime context)
    (return result)
  )
  (fn-do + padded ([] Byte)
    (param value (of CPointer I8))
    (let bytes ([] Byte srp-size))
    (call C:BN_bn2binpad value bytes srp-size)
    (return bytes)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (for (in value owned)
      (call C:BN_clear_free value)
    )
    (= owned (call (of List (of CPointer I8))))
    (call C:BN_CTX_free context)
  )
)
