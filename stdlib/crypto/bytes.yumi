/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ do joined-bytes Byte[]
    - parts [Byte[]]

. result = Byte[sum(each.size in parts)]
. offset Size = 0
for part in parts
    result[offset .. < offset + part.size] = part
    offset += part.size
= result

━━━━━━━━━━━━━━━━━━━━
+ do bytes-match Bool
    - first Byte[]
    - second Byte[]

=? false if first.size != second.size
. difference Byte
for index in 0 .. < first.size
    difference = difference /or/ (first[index] /xor/ second[index])
= difference == 0
