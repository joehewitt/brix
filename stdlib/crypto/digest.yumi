./bytes
/openssl/evp.h
/openssl/hmac.h

+ sha1-size Size = 20
+ sha512-size Size = 64

━━━━━━━━━━━━━━━━━━━━
+ do sha1 Byte[]
    - data Byte[]

. digest = Byte[sha1-size]
C:EVP_Digest(data, data.size, digest, null, C:EVP_sha1(), null)
    ?! Panic("SHA-1 failed")
        if it != 1
= digest

━━━━━━━━━━━━━━━━━━━━
+ do sha512 Byte[]
    - data Byte[]

. digest = Byte[sha512-size]
C:EVP_Digest(data, data.size, digest, null, C:EVP_sha512(), null)
    ?! Panic("SHA-512 failed")
        if it != 1
= digest

━━━━━━━━━━━━━━━━━━━━
+ do hmac-sha512 Byte[]
    - key Byte[]
    - data Byte[]

. mac = Byte[sha512-size]
. size U32
C:HMAC(C:EVP_sha512(), key, key.size, data, data.size, mac, &size)
?! Panic("HMAC-SHA-512 failed")
    if size != sha512-size
= mac

━━━━━━━━━━━━━━━━━━━━
+ do hkdf-sha512 Byte[]
    - key Byte[]
    - salt Byte[]
    - info Byte[]
    - size = sha512-size

?! Panic("HKDF-SHA-512 gives at most ${255 * sha512-size} bytes")
    if size > 255 * sha512-size
. pseudorandom-key = hmac-sha512(salt, key)
. output = Byte[size]
. block = Byte[0]
. counter = Byte[1]
. offset Size = 0
while offset < size
    counter[0] += 1
    block = hmac-sha512(pseudorandom-key, joined-bytes([block, info, counter]))
    . taken = if size - offset < sha512-size then size - offset else sha512-size
    output[offset .. < offset + taken] = block[0 .. < taken]
    offset += taken
= output
