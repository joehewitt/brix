./bytes
./crypto-error
./digest
./random
/core/_bytes
/openssl/bn.h

+ srp-size Size = 384

_ srp-prime Hex = ""
_ srp-generator Hex = "05"

━━━━━━━━━━━━━━━━━━━━
+ SRPClient

+ username String
+ password String
+ public-key Byte[]
+ session-key = Byte[0]

_ private-key Byte[]
_ expected-proof = Byte[0]

────────────────────
+ This
    - username
    - password
    - private-key = random-bytes(32)

.. public-key = srp-public-key(private-key)

────────────────────
+ do prove Byte[] ?! CryptoError
    - salt Byte[]
    - server-public-key Byte[]

?! CryptoError("The server's public key is longer than the group")
    if server-public-key.size > srp-size
. numbers = use SRPNumbers()
. server-public = numbers.number(server-public-key)
. remainder = numbers.fresh()
C:BN_nnmod(remainder, server-public, numbers.prime, numbers.context)
?! CryptoError("The server's public key is a multiple of the group's prime")
    if C:BN_is_zero(remainder) == 1
. server-padded = numbers.padded(server-public)
. scrambler = numbers.hashed(joined-bytes([public-key, server-padded]))
?! CryptoError("The SRP scrambling parameter is zero")
    if C:BN_is_zero(scrambler) == 1
. generator-padded = numbers.padded(numbers.generator)
. multiplier = numbers.hashed(joined-bytes([srp-prime as Byte[], generator-padded]))
. identity = sha512(byte-view("$username:$password"))
. password-exponent = numbers.hashed(joined-bytes([salt, identity]))
. verifier = numbers.power(numbers.generator, password-exponent)
. multiplied = numbers.fresh()
C:BN_mod_mul(multiplied, multiplier, verifier, numbers.prime, numbers.context)
. base = numbers.fresh()
C:BN_mod_sub(base, server-public, multiplied, numbers.prime, numbers.context)
. scrambled = numbers.fresh()
C:BN_mul(scrambled, scrambler, password-exponent, numbers.context)
. exponent = numbers.fresh()
C:BN_add(exponent, numbers.number(private-key), scrambled)
session-key = sha512(numbers.padded(numbers.power(base, exponent)))
. group-hash = sha512(srp-prime)
. generator-hash = sha512(srp-generator)
for index in 0 .. < group-hash.size
    group-hash[index] = group-hash[index] /xor/ generator-hash[index]
. transcript = [group-hash, sha512(byte-view(username)), salt, public-key, server-padded, session-key]
. proof = sha512(joined-bytes(transcript))
expected-proof = sha512(joined-bytes([public-key, proof, session-key]))
= proof

────────────────────
+ do verify ?! CryptoError
    - server-proof Byte[]

?! CryptoError("The server's SRP proof does not match")
    if expected-proof.size == 0 || !bytes-match(server-proof, expected-proof)

━━━━━━━━━━━━━━━━━━━━
_ srp-public-key Byte[]
    - private-key Byte[]

numbers.padded(numbers.power(numbers.generator, numbers.number(private-key)))

.. numbers = use SRPNumbers()

━━━━━━━━━━━━━━━━━━━━
_ SRPNumbers
    is Usable'SRPNumbers

+ context CPointer'I8
+ prime CPointer'I8
+ generator CPointer'I8

_ owned [CPointer'I8]

────────────────────
+ This

context = C:BN_CTX_new()
prime = number(srp-prime)
generator = number(srp-generator)

────────────────────
+ do number CPointer'I8
    - bytes Byte[]

. value = C:BN_bin2bn(bytes, bytes.size, null)
owned += value
= value

────────────────────
+ do fresh CPointer'I8

. value = C:BN_new()
owned += value
= value

────────────────────
+ hashed CPointer'I8
    - bytes Byte[]

number(sha512(bytes))

────────────────────
+ do power CPointer'I8
    - base CPointer'I8
    - exponent CPointer'I8

. result = fresh()
C:BN_mod_exp(result, base, exponent, prime, context)
= result

────────────────────
+ do padded Byte[]
    - value CPointer'I8

. bytes = Byte[srp-size]
C:BN_bn2binpad(value, bytes, srp-size)
= bytes

╌╌╌╌╌╌╌╌╌╌ is Usable'SRPNumbers ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ begin-using

this

────────────────────
+ do end-using

for value in owned
    C:BN_clear_free(value)
owned = List'(CPointer'I8)()
C:BN_CTX_free(context)
