(import ./bytes)
(import /openssl/evp.h)
(import /openssl/hmac.h)
(blank)
(prop + sha1-size Size (= 20))
(prop + sha512-size Size (= 64))

(fn-do + sha1 ([] Byte)
  (param data (of ImmutableArray Byte))
  (let digest ([] Byte sha1-size))
  (call C:EVP_Digest data (. data size) digest null (call C:EVP_sha1) null
    (block
      (throw (call Panic "SHA-1 failed") (if (!= it 1)))
    )
  )
  (return digest)
)

(fn-do + sha512 ([] Byte)
  (param data (of ImmutableArray Byte))
  (let digest ([] Byte sha512-size))
  (call C:EVP_Digest data (. data size) digest null (call C:EVP_sha512) null
    (block
      (throw (call Panic "SHA-512 failed") (if (!= it 1)))
    )
  )
  (return digest)
)

(fn-do + hmac-sha512 ([] Byte)
  (param key (of ImmutableArray Byte))
  (param data (of ImmutableArray Byte))
  (let mac ([] Byte sha512-size))
  (let size U32)
  (call C:HMAC (call C:EVP_sha512) key (. key size) data (. data size) mac &size)
  (throw (call Panic "HMAC-SHA-512 failed") (if (!= size sha512-size)))
  (return mac)
)

(fn-do + hkdf-sha512 ([] Byte)
  (param key ([] Byte))
  (param salt ([] Byte))
  (param info ([] Byte))
  (param size _ (= sha512-size))
  (throw (call Panic (str "HKDF-SHA-512 gives at most " (* 255 sha512-size) " bytes")) (if (> size (* 255 sha512-size))))
  (blank)
  (let pseudorandom-key (call hmac-sha512 salt key))
  (let output ([] Byte size))
  (let block ([] Byte 0))
  (let counter ([] Byte 1))
  (let offset Size 0)
  (while (< offset size)
    (+= ([] counter 0) 1)
    (= block (call hmac-sha512 pseudorandom-key (call joined-bytes (list block info counter))))
    (let taken (if-expr (< (- size offset) sha512-size) (- size offset) sha512-size))
    (= ([] output (..< offset (+ offset taken))) ([] block (..< 0 taken)))
    (+= offset taken)
  )
  (return output)
)
