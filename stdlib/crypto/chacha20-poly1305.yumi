./crypto-error
/openssl/evp.h

+ chacha20-poly1305-key-size Size = 32
+ chacha20-poly1305-nonce-size Size = 12
+ chacha20-poly1305-tag-size Size = 16

━━━━━━━━━━━━━━━━━━━━
+ ChaCha20Poly1305

_ key Byte[]

────────────────────
+ This
    - key

?! Panic("A ChaCha20-Poly1305 key is $chacha20-poly1305-key-size bytes, not $key.size")
    if key.size != chacha20-poly1305-key-size

────────────────────
+ do seal Byte[]
    - nonce Byte[]
    - plaintext Byte[]
    - aad = Byte[0]

check-nonce(nonce)
. context = use CipherContext()
. sealed = Byte[plaintext.size + chacha20-poly1305-tag-size]
. written I32
C:EVP_EncryptInit_ex(context, C:EVP_chacha20_poly1305(), null, key, nonce)
    ?! Panic("ChaCha20-Poly1305 failed to start")
        if it != 1
if aad.size > 0
    C:EVP_EncryptUpdate(context, null, &written, aad, aad.size)
C:EVP_EncryptUpdate(context, sealed, &written, plaintext, plaintext.size)
C:EVP_EncryptFinal_ex(context, sealed + written, &written)
. tag = sealed + plaintext.size
C:EVP_CIPHER_CTX_ctrl(context, C:EVP_CTRL_AEAD_GET_TAG, chacha20-poly1305-tag-size, tag)
    ?! Panic("ChaCha20-Poly1305 failed to give its tag")
        if it != 1
= sealed

────────────────────
+ do open Byte[] ?! CryptoError
    - nonce Byte[]
    - sealed Byte[]
    - aad = Byte[0]

check-nonce(nonce)
?! CryptoError("Sealed data is shorter than its tag")
    if sealed.size < chacha20-poly1305-tag-size
. size = sealed.size - chacha20-poly1305-tag-size
. context = use CipherContext()
. plaintext = Byte[size]
. written I32
C:EVP_DecryptInit_ex(context, C:EVP_chacha20_poly1305(), null, key, nonce)
    ?! Panic("ChaCha20-Poly1305 failed to start")
        if it != 1
if aad.size > 0
    C:EVP_DecryptUpdate(context, null, &written, aad, aad.size)
C:EVP_DecryptUpdate(context, plaintext, &written, sealed, size)
. tag = sealed + size
C:EVP_CIPHER_CTX_ctrl(context, C:EVP_CTRL_AEAD_SET_TAG, chacha20-poly1305-tag-size, tag)
C:EVP_DecryptFinal_ex(context, plaintext + written, &written)
    ?! CryptoError("ChaCha20-Poly1305 authentication failed")
        if it != 1
= plaintext

────────────────────
_ do check-nonce
    - nonce Byte[]

?! Panic("A ChaCha20-Poly1305 nonce is $chacha20-poly1305-nonce-size bytes, not $nonce.size")
    if nonce.size != chacha20-poly1305-nonce-size

━━━━━━━━━━━━━━━━━━━━
_ CipherContext
    is Usable'(CPointer'I8)

_ handle CPointer'I8 = C:EVP_CIPHER_CTX_new()

────────────────────
+ begin-using

handle

────────────────────
+ do end-using

C:EVP_CIPHER_CTX_free(handle)
