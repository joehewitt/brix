(import /git)
(import /os/env)
(import /os/path)
(import /os/process)
(blank)
(prop + file-text-match-limit Size (= 2000))
(prop _ file-text-batch-size Size (= 64))
(prop _ file-text-chunk-size Size (= 65536))
(prop _ file-text-open-mark _ (= 30u8))
(prop _ file-text-close-mark _ (= 31u8))
(prop _ file-text-preview-limit Size (= 300))
(prop _ file-text-ripgrep-folders _ (= (list "/opt/homebrew/bin" "/usr/local/bin" "/usr/bin")))

(type + FileTextQuery (is Tuple)
  (prop + text String)
  (prop + is-regex _ (= false))
  (prop + is-case-sensitive (? Bool) (= null))
  (prop + is-whole-word _ (= false))
  (prop + scope String)
  (prop + limit _ (= file-text-match-limit))
  (fn-expr + matches-case Bool :get
    (?? is-case-sensitive (!= text (. text lowercased)))
  )
)

(type + FileTextHit (is Tuple)
  (prop + start Size)
  (prop + end Size)
)

(type + FileTextMatch (is Tuple)
  (prop + path String)
  (prop + line Size)
  (prop + column Size)
  (prop + text String)
  (prop + hits (list FileTextHit))
)

(type + FileTextSearch
  (implements Closable)
  (prop + root Path)
  (prop + query FileTextQuery)
  (prop + count Size (= 0))
  (prop + is-finished _ (= false))
  (prop + is-truncated _ (= false))
  (event + found (list FileTextMatch))
  (event + finished FileTextSearch)
  (blank)
  (prop _ process (? Process))
  (prop _ is-started _ (= false))
  (prop _ is-closed _ (= false))
  (fn-do + This _
    (param root _)
    (param query _)
  )
  (fn-do + start _
    (return-if (if (or is-started is-closed)))
    (= is-started true)
    (do-new @detached
      (call run)
    )
  )
  (fn-do + close _
    (return-if (if is-closed))
    (= is-closed true)
    (let active process)
    (= process null)
    (if (and active (not is-finished))
      (call (. active terminate))
    )
  )
  (fn-do _ run _
    (let ripgrep (call file-text-ripgrep))
    (let separator Byte (if-expr (!= ripgrep null) 58 0))
    (let spawned (catch? (call file-text-process (str root) query ripgrep)))
    (if (and spawned (not is-closed))
      (= process spawned)
      (finally
        (inline (call (. spawned reap)))
      )
      (call (. spawned close-input))
      (call read spawned separator)
      (if (and is-truncated (not is-closed))
        (call (. spawned terminate))
      )
      (call (. spawned close))
      (let ignored (call (. spawned wait) null))
    )
    (= is-finished true)
    (= process null)
    (if (not is-closed)
      (<- finished this)
    )
  )
  (fn-do _ read _
    (param source Process)
    (param separator Byte)
    (let needle (if-expr (not (. query is-regex)) (call byte-view (. query text)) ([] Byte 0)))
    (let folds (not (. query matches-case)))
    (let bounded (. query is-whole-word))
    (let has-marks (== separator 58))
    (let batch (list FileTextMatch))
    (let chunk ([] Byte file-text-chunk-size))
    (let data ([] Byte (* file-text-chunk-size 2)))
    (let held Size 0)
    (while (not is-truncated)
      (let size (call (. source read) (. chunk size) chunk))
      (return-if (if is-closed))
      (if (== size 0)
        (break)
      )
      (if (> (+ held size) (. data size))
        (let grown ([] Byte (* (+ held size) 2)))
        (= ([] grown (..< 0 held)) ([] data (..< 0 held)))
        (= data grown)
      )
      (= ([] data (..< held (+ held size))) ([] chunk (..< 0 size)))
      (let filled (+ held size))
      (let first Index 0)
      (for (in index (..< 0 filled))
        (if (and (== ([] data index) 10) (not is-truncated))
          (let match
            (call file-text-parse
              (block
                (arg data)
                (arg first)
                (arg index)
                (arg separator)
                (arg needle)
                (arg folds)
                (arg bounded)
                (arg has-marks)
              )
            )
          )
          (= first (+ index 1))
          (if match
            (+= batch match)
            (+= count 1)
            (if (>= count (. query limit))
              (= is-truncated true)
              (else-if (>= (. batch length) file-text-batch-size)
                (<- found batch)
                (= batch (call (of List FileTextMatch)))
              )
            )
          )
        )
      )
      (= held (- filled first))
      (if (and (> held 0) (> first 0))
        (let kept ([] Byte (. data size)))
        (= ([] kept (..< 0 held)) ([] data (..< first filled)))
        (= data kept)
      )
    )
    (if (and (> (. batch length) 0) (not is-closed))
      (<- found batch)
    )
  )
)

(fn-do _ file-text-process Process (?! Error)
  (param directory String)
  (param query FileTextQuery)
  (param ripgrep (? String))
  (let arguments (list String))
  (if ripgrep
    (+= arguments "--null")
    (+= arguments "--line-number")
    (+= arguments "--column")
    (+= arguments "--no-heading")
    (+= arguments "--color=never")
    (+= arguments "--no-messages")
    (+= arguments "--hidden")
    (+= arguments "--glob=!.git")
    (+= arguments (str "--max-columns=" file-text-preview-limit))
    (+= arguments "--max-columns-preview")
    (+= arguments (if-expr (. query matches-case) "--case-sensitive" "--ignore-case"))
    (if (not (. query is-regex))
      (+= arguments "--fixed-strings")
    )
    (if (. query is-whole-word)
      (+= arguments "--word-regexp")
    )
    (+= arguments (str "--regexp=" (. query text)))
    (+= arguments
      (scope (str "--replace=" open-marker "\$0" (call file-text-marker file-text-close-mark))
        (lazy open-marker (call file-text-marker file-text-open-mark))
      )
    )
    (+= arguments "--")
    (+= arguments (if-expr (. query scope) (. query scope) "."))
    (return (call Process ripgrep (. ProcessStderr discard) arguments directory))
  )
  (+= arguments "grep")
  (+= arguments "--line-number")
  (+= arguments "--column")
  (+= arguments "--null")
  (+= arguments "--no-color")
  (+= arguments "-I")
  (+= arguments "--untracked")
  (+= arguments "--exclude-standard")
  (+= arguments (if-expr (. query is-regex) "--extended-regexp" "--fixed-strings"))
  (if (not (. query matches-case))
    (+= arguments "--ignore-case")
  )
  (if (. query is-whole-word)
    (+= arguments "--word-regexp")
  )
  (+= arguments "-e")
  (+= arguments (. query text))
  (if (. query scope)
    (+= arguments "--")
    (+= arguments (. query scope))
  )
  (return (call git-process directory arguments))
)

(fn-do _ file-text-ripgrep (? String)
  (let folders (list String))
  (let listed ([] (call environment) "PATH"))
  (if listed
    (for (in folder (call (. listed split) ":"))
      (+= folders folder)
    )
  )
  (for (in folder file-text-ripgrep-folders)
    (+= folders folder)
  )
  (for (in folder folders)
    (let candidate (str folder "/rg"))
    (return-if candidate (if (and folder (. (call Path candidate 0) exists))))
  )
  (return null)
)

(fn-do _ file-text-parse (? FileTextMatch)
  (param bytes ([] Byte))
  (param first Index)
  (param size Index)
  (param separator Byte)
  (param needle (of ImmutableArray Byte))
  (param folds Bool)
  (param bounded Bool)
  (param has-marks Bool)
  (let cursor first)
  (while (and (< cursor size) (!= ([] bytes cursor) 0))
    (+= cursor 1)
  )
  (return-if (if (or (== cursor first) (>= cursor size))))
  (let start
    (block
      (case? (and (> cursor (+ first 2)) (== ([] bytes first) 46) (== ([] bytes (+ first 1)) 47))
        (+ first 2)
      )
      (default
        first
      )
    )
  )
  (let path (. (call file-text-decoded bytes start cursor (call (of List FileTextHit))) text))
  (+= cursor 1)
  (let number Size 0)
  (let digits Size 0)
  (while (and (< cursor size) (!= ([] bytes cursor) separator))
    (return-if (if (or (< ([] bytes cursor) 48) (> ([] bytes cursor) 57))))
    (= number (+ (* number 10) (as (- ([] bytes cursor) 48) Size)))
    (+= digits 1)
    (+= cursor 1)
  )
  (return-if (if (or (== digits 0) (== number 0) (>= cursor size))))
  (+= cursor 1)
  (let column Size 0)
  (= digits 0)
  (while (and (< cursor size) (!= ([] bytes cursor) separator))
    (return-if (if (or (< ([] bytes cursor) 48) (> ([] bytes cursor) 57))))
    (= column (+ (* column 10) (as (- ([] bytes cursor) 48) Size)))
    (+= digits 1)
    (+= cursor 1)
  )
  (return-if (if (or (== digits 0) (== column 0) (>= cursor size))))
  (+= cursor 1)
  (let end size)
  (if (and (> end cursor) (== ([] bytes (- end 1)) 13))
    (-= end 1)
  )
  (let clean ([] Byte (- end cursor)))
  (let count Index 0)
  (let hits (list FileTextHit))
  (let opened Index 0)
  (let is-open false)
  (for (in index (..< cursor end))
    (let byte ([] bytes index))
    (if (and has-marks (== byte file-text-open-mark))
      (= opened count)
      (= is-open true)
      (else-if (and has-marks (== byte file-text-close-mark))
        (if (and is-open (> count opened))
          (+= hits (call FileTextHit opened count))
        )
        (= is-open false)
      )
      (else
        (= ([] clean count) byte)
        (+= count 1)
      )
    )
  )
  (if (and (not has-marks) (> (. needle size) 0))
    (= hits (call file-text-literal-hits clean count needle folds bounded))
  )
  (let limit count)
  (if (> limit file-text-preview-limit)
    (= limit file-text-preview-limit)
    (while (and (> limit 0) (call utf8-is-continuation ([] clean limit)))
      (-= limit 1)
    )
  )
  (let kept (list FileTextHit))
  (for (in hit hits)
    (if (< (. hit start) limit)
      (+= kept (call FileTextHit (. hit start) (if-expr (< (. hit end) limit) (. hit end) limit)))
    )
  )
  (let decoded (call file-text-decoded clean 0 limit kept))
  (return (call FileTextMatch path (- number 1) (- column 1) (. decoded text) (. decoded hits)))
)

(type _ FileTextDecoding (is Tuple)
  (prop + text String)
  (prop + hits (list FileTextHit))
)

(fn-do _ file-text-decoded FileTextDecoding
  (param bytes ([] Byte))
  (param start Index)
  (param end Index)
  (param hits (list FileTextHit))
  (let output ([] Byte (* (- end start) 3)))
  (let moved ([] Index (+ (- end start) 1)))
  (let count Index 0)
  (let cursor start)
  (while (< cursor end)
    (let width (call file-text-sequence-width bytes cursor end))
    (= ([] moved (- cursor start)) count)
    (if (== width 0)
      (= ([] output count) 239)
      (= ([] output (+ count 1)) 191)
      (= ([] output (+ count 2)) 189)
      (+= count 3)
      (+= cursor 1)
      (else
        (for (in offset (..< 0 width))
          (= ([] moved (+ (- cursor start) offset)) (+ count offset))
          (= ([] output (+ count offset)) ([] bytes (+ cursor offset)))
        )
        (+= count width)
        (+= cursor width)
      )
    )
  )
  (= ([] moved (- end start)) count)
  (let shifted (list FileTextHit))
  (for (in hit hits)
    (+= shifted (call FileTextHit ([] moved (- (. hit start) start)) ([] moved (- (. hit end) start))))
  )
  (return (call FileTextDecoding (call (. output slice-string) (..< 0 count)) shifted))
)

(fn-do _ file-text-literal-hits (list FileTextHit)
  (param bytes ([] Byte))
  (param count Index)
  (param needle (of ImmutableArray Byte))
  (param folds Bool)
  (param bounded Bool)
  (let hits (list FileTextHit))
  (let width (. needle size))
  (let cursor Index 0)
  (while (<= (+ cursor width) count)
    (let matches true)
    (if bounded
      (if (and (> cursor 0) (call file-text-is-word ([] bytes (- cursor 1))))
        (= matches false)
      )
      (if (and (< (+ cursor width) count) (call file-text-is-word ([] bytes (+ cursor width))))
        (= matches false)
      )
    )
    (for (in offset (..< 0 width))
      (if (and matches (not (call file-text-same ([] bytes (+ cursor offset)) ([] needle offset) folds)))
        (= matches false)
      )
    )
    (if matches
      (+= hits (call FileTextHit cursor (+ cursor width)))
      (+= cursor width)
      (else
        (+= cursor 1)
      )
    )
  )
  (return hits)
)

(fn-expr _ file-text-is-word Bool
  (param byte Byte)
  (or is-digit (and (>= byte 65) (<= byte 90)) (and (>= byte 97) (<= byte 122)) (== byte 95) (>= byte 128))
  (where
    (lazy is-digit (and (>= byte 48) (<= byte 57)))
  )
)

(fn-expr _ file-text-same Bool
  (param left Byte)
  (param right Byte)
  (param folds Bool)
  (or (== left right) (and folds (== (call file-text-folded left) (call file-text-folded right))))
)

(fn-expr _ file-text-folded Byte
  (param byte Byte)
  (if-expr (and (>= byte 65) (<= byte 90)) (+ byte 32) byte)
)

(fn-do _ file-text-marker String
  (param byte Byte)
  (let bytes ([] Byte 1))
  (= ([] bytes 0) byte)
  (return (call (. bytes slice-string) (..< 0 1)))
)

(fn-do _ file-text-sequence-width Size
  (param bytes ([] Byte))
  (param cursor Index)
  (param end Index)
  (let lead ([] bytes cursor))
  (return-if 1 (if (< lead 128)))
  (let width Size 0)
  (let low 128u8)
  (let high 191u8)
  (if (and (>= lead 194) (<= lead 223))
    (= width 2)
    (else-if (and (>= lead 224) (<= lead 239))
      (= width 3)
      (if (== lead 224)
        (= low 160)
        (else-if (== lead 237)
          (= high 159)
        )
      )
    )
    (else-if (and (>= lead 240) (<= lead 244))
      (= width 4)
      (if (== lead 240)
        (= low 144)
        (else-if (== lead 244)
          (= high 143)
        )
      )
    )
  )
  (return-if 0 (if (or (== width 0) (> (+ cursor width) end))))
  (let second ([] bytes (+ cursor 1)))
  (return-if 0 (if (or (< second low) (> second high))))
  (for (in offset (..< 2 width))
    (return-if 0 (if (not (call utf8-is-continuation ([] bytes (+ cursor offset))))))
  )
  (return width)
)
