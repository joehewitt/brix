./code-comments
./code-folds
./code-text
./syntax
/data/diff
/math
/stream/aggregate
/ui/command-history

_ code-window-before Size = 100
_ code-window-after Size = 200
_ code-indent-sample-lines Size = 400
_ code-open-parse-budget U32 = 40000
_ code-edit-parse-budget U32 = 4000

━━━━━━━━━━━━━━━━━━━━
+ CodeSession
    is Closable

+ text CodeText
+ language SyntaxLanguage?
+ comment-marker String?
+ caret Size
+ anchor Size
+ revision U64 = 1
+ tab-width Size = 4
+ indent-unit String = "    "
+ has-parse-error Bool
+ widest-columns Size
+ line-changes [DiffLineChange]
+ folds = CodeFolds()
+ history = CommandHistory()
+ event updated U64

_ document SyntaxDocument?
_ goal-column Size?
_ window-first Size
_ window-spans [[SyntaxSpan]]
_ window-revision U64
_ baseline Byte[]?
_ edit-stamp U64
_ marker Task?
_ marked-stamp U64
_ fold-window [SyntaxFold]
_ fold-first Size
_ fold-last Size
_ fold-revision U64

────────────────────
+ This
    - source String = ""
    - language SyntaxLanguage? = null

.. text = CodeText(source)
this.language = language
history.limit = null
history.coalescing = null
indent-unit = detect-indent()
if language
    document = SyntaxDocument(language)
    reparse(code-open-parse-budget)
for line in 0 .. < text.line-count
    widest-columns = max(widest-columns, line-columns(line))

────────────────────
+ do close

baseline = null
. active = document
if active
    active.close()
    document = null

────────────────────
+ get line-count Size

text.line-count

────────────────────
+ get is-modified Bool

history.is-modified

────────────────────
+ get is-parsing Bool

document?.is-parsing ?? false

────────────────────
+ get has-selection Bool

caret != anchor

────────────────────
+ get selection-start Size

min(caret, anchor)

────────────────────
+ get selection-end Size

max(caret, anchor)

────────────────────
+ get selected-text String

text.text-in(selection-start, selection-end)

────────────────────
+ get caret-point SyntaxPoint

text.point-at(caret)

────────────────────
+ get caret-line Size

text.line-at(caret)

────────────────────
+ get caret-column Size

display-column(caret)

────────────────────
+ get caret-prefix String

text.text-in(text.line-start(text.line-at(caret)), caret)

────────────────────
+ do compare-with
    - source String?

edit-stamp += 1
if source == null
    baseline = null
    line-changes = List'DiffLineChange()
    updated <- revision
else
    baseline = code-text-bytes(CodeText(source))
    start-marking()

────────────────────
+ do mark-saved

history.mark-saved()
updated <- revision

────────────────────
+ do reload
    - source String

. fresh = CodeText(source)
. old-length = text.length
. new-length = fresh.length
. limit = min(old-length, new-length)
. prefix Size = 0
while prefix < limit && text.bytes[prefix] == fresh.bytes[prefix]
    prefix += 1
while prefix > 0 && (code-splits-character(text, prefix) || code-splits-character(fresh, prefix))
    prefix -= 1
. suffix Size = 0
while suffix < limit - prefix && text.bytes[old-length - suffix - 1] == fresh.bytes[new-length - suffix - 1]
    suffix += 1
while suffix > 0 && (code-splits-character(text, old-length - suffix) || code-splits-character(fresh, new-length - suffix))
    suffix -= 1
. old-end = old-length - suffix
. new-end = new-length - suffix
if prefix < old-end || prefix < new-end
    . old-caret = caret
    . old-anchor = anchor
    edit(prefix, old-end, fresh.text-in(prefix, new-end), "Reload")
    caret = code-reloaded-offset(old-caret, prefix, old-end, new-end)
    anchor = code-reloaded-offset(old-anchor, prefix, old-end, new-end)
mark-saved()

────────────────────
+ display-column Size
    - offset Size

columns-between(text.line-start(line), offset)

.. line = text.line-at(offset)

────────────────────
+ line-columns Size
    - line Size

columns-between(text.line-start(line), text.line-end(line))

────────────────────
+ do columns-between Size
    - start Size
    - end Size

. column Size = 0
. index = start
while index < end
    column = advance-column(index, column)
    index = text.next-char(index)
= column

────────────────────
+ do offset-at-column Size
    - line Size
    - target Float

. index = text.line-start(line)
. end = text.line-end(line)
. column Size = 0
while index < end
    . next-column = advance-column(index, column)
    . left = column as Float
    . right = next-column as Float
    if right > target
        =? text.next-char(index) if target - left > right - target
        = index
    column = next-column
    index = text.next-char(index)
= end

────────────────────
+ do line-spans [SyntaxSpan]
    - line Size

if window-revision != revision || line < window-first || line >= window-first + window-spans.length
    load-window(line)
= window-spans[line - window-first]

────────────────────
+ styled-runs [SyntaxStyledRun]
    - line Size

expanded-tabs(runs, start)

.. start = text.line-start(line)
.. roles = language?.roles ?? List'SyntaxRole()
.. runs = syntax-styled-runs(text.bytes, start, text.line-end(line), line-spans(line), roles)

────────────────────
+ do undo Bool

=? false if !history.can-undo
history.undo()
= true

────────────────────
+ do redo Bool

=? false if !history.can-redo
history.redo()
= true

────────────────────
+ do type
    - typed String
    - replaces-before Size = 0
    - replaces-length Size = 0

=? if typed.size == 0 && replaces-length == 0
. start = selection-start
. end = selection-end
if replaces-before > 0 && !has-selection
    for index in 0 .. < replaces-before
        start = text.previous-char(start)
    end = start
    for index in 0 .. < replaces-length
        end = text.next-char(end)
if is-closing(typed) && !has-selection && replaces-before == 0
    . line-start = text.line-start(text.line-at(start))
    . prefix = text.text-in(line-start, start)
    if prefix.size > 0 && prefix.trim().size == 0
        edit(line-start, end, outdented(prefix) + typed, "Typing")
        =
edit(start, end, typed, "Typing", typed.size == 1 && typed != "\n" && start == end)

────────────────────
+ do paste
    - pasted String

. normalized = "\n".join(pasted.split("\r\n"))
edit(selection-start, selection-end, normalized, "Paste")

────────────────────
+ do newline

. start = selection-start
. end = selection-end
. line-start = text.line-start(text.line-at(start))
. prefix = text.text-in(line-start, start)
. indent = leading-whitespace(prefix)
. opener = last-meaningful-byte(line-start, start)
. opens = code-opens-block(opener)
if opens && end < text.length && code-closer(opener) == text.byte-at(end)
    edit(start, end, "\n$indent$indent-unit\n$indent", "Typing")
    caret = start + 1 + indent.size + indent-unit.size
    anchor = caret
    =
edit(start, end, "\n$indent${if opens then indent-unit else ""}", "Typing")

────────────────────
+ do insert-tab

if has-selection && text.line-at(selection-start) != text.line-at(selection-end)
    indent-lines()
    =
if indent-unit == "\t"
    edit(selection-start, selection-end, "\t", "Typing")
    =
. column = display-column(selection-start)
edit(selection-start, selection-end, " " * (tab-width - column % tab-width), "Typing")

────────────────────
+ do indent-lines

. first = text.line-at(selection-start)
. last = last-selected-line()
. block-start = text.line-start(first)
. block-end = text.line-end(last)
. lines = text.text-in(block-start, block-end).split("\n")
. changed = "\n".join((if each.size == 0 then "" else indent-unit) + each in lines)
edit(block-start, block-end, changed, "Indent")
anchor = block-start
caret = block-start + changed.size

────────────────────
+ do toggle-comment

. marker = comment-marker
=? if !marker
. first = text.line-at(selection-start)
. last = last-selected-line()
. block-start = text.line-start(first)
. block-end = text.line-end(last)
. original = text.text-in(block-start, block-end)
. lines = List'String(original.split("\n"))
. changed = "\n".join(code-toggled-comments(lines, marker))
=? if changed == original
. keeps-selection = has-selection
. old-caret = caret
. marker-at = block-start + code-indent-size(lines[0])
edit(block-start, block-end, changed, "Toggle Comment")
if keeps-selection
    anchor = block-start
    caret = block-start + changed.size
else if old-caret >= marker-at
    caret = max(marker-at, old-caret + changed.size - original.size)
    anchor = caret
else
    caret = old-caret
    anchor = caret

────────────────────
+ do outdent-lines

. first = text.line-at(selection-start)
. last = last-selected-line()
. block-start = text.line-start(first)
. block-end = text.line-end(last)
. lines = text.text-in(block-start, block-end).split("\n")
. changed = "\n".join(outdented-line(each) in lines)
=? if changed == text.text-in(block-start, block-end)
. keeps-selection = has-selection
edit(block-start, block-end, changed, "Outdent")
if keeps-selection
    anchor = block-start
    caret = block-start + changed.size

────────────────────
+ do delete-backward

if has-selection
    delete-selection()
    =
=? if caret == 0
. line-start = text.line-start(text.line-at(caret))
. prefix = text.text-in(line-start, caret)
if prefix.size > 0 && indent-unit != "\t" && is-all-spaces(prefix)
    . column = display-column(caret)
    . count = (column - 1) % tab-width + 1
    edit(caret - min(count, prefix.size), caret, "", "Delete", true)
    =
edit(text.previous-char(caret), caret, "", "Delete", true)

────────────────────
+ do delete-forward

if has-selection
    delete-selection()
    =
=? if caret >= text.length
edit(caret, text.next-char(caret), "", "Delete", true)

────────────────────
+ do delete-word-backward

if has-selection
    delete-selection()
    =
edit(word-left(caret), caret, "", "Delete")

────────────────────
+ do delete-word-forward

if has-selection
    delete-selection()
    =
edit(caret, word-right(caret), "", "Delete")

────────────────────
+ do delete-to-line-start

if has-selection
    delete-selection()
    =
. line-start = text.line-start(text.line-at(caret))
edit(if caret > line-start then line-start else text.previous-char(caret), caret, "", "Delete")

────────────────────
+ do delete-to-line-end

if has-selection
    delete-selection()
    =
. line-end = text.line-end(text.line-at(caret))
edit(caret, if caret < line-end then line-end else text.next-char(caret), "", "Delete")

────────────────────
+ do replace
    - start Size
    - end Size
    - inserted String
    - coalescing = false
    - title String? = null

edit
    - min(start, text.length)
    - min(end, text.length)
    - inserted
    - title ?? (if coalescing then "Typing" else "Edit")
    - coalescing

────────────────────
+ do delete-selection

edit(selection-start, selection-end, "", "Delete")

────────────────────
+ do replace-ranges
    - starts [Size]
    - ends [Size]
    - texts [String]
    - title = "Replace"

=? if starts.length == 0
. low = starts[0]
. parts [String]
. last = low
for index in 0 .. < starts.length
    parts += text.text-in(last, starts[index])
    parts += texts[index]
    last = ends[index]
edit(low, last, "".join(parts), title)

────────────────────
+ do move-to
    - offset Size
    - extends = false
    - keeps-goal = false

caret = min(offset, text.length)
if !extends
    anchor = caret
if !keeps-goal
    goal-column = null
history.seal()

────────────────────
+ do move-left
    - extends = false

if has-selection && !extends
    move-to(selection-start)
else
    move-to(visible(text.previous-char(caret), false), extends)

────────────────────
+ do move-right
    - extends = false

if has-selection && !extends
    move-to(selection-end)
else
    move-to(visible(text.next-char(caret), true), extends)

────────────────────
+ do move-up
    - extends = false
    - count Size = 1

. display = folds.shown(text.line-at(caret))
if display == 0
    move-to(0, extends)
    =
. goal = goal-column ?? display-column(caret)
. target = folds.actual(if display > count then display - count else 0)
move-to(offset-at-column(target, goal as Float), extends, true)
goal-column = goal

────────────────────
+ do move-down
    - extends = false
    - count Size = 1

. display = folds.shown(text.line-at(caret))
. rows = folds.row-count(text.line-count)
if display + 1 >= rows
    move-to(text.line-end(folds.actual(rows - 1)), extends)
    =
. goal = goal-column ?? display-column(caret)
. target = folds.actual(min(display + count, rows - 1))
move-to(offset-at-column(target, goal as Float), extends, true)
goal-column = goal

────────────────────
+ do move-word-left
    - extends = false

move-to(visible(word-left(caret), false), extends)

────────────────────
+ do move-word-right
    - extends = false

move-to(visible(word-right(caret), true), extends)

────────────────────
+ do move-to-line-start
    - extends = false

. line-start = text.line-start(text.line-at(caret))
. indented = line-start + leading-whitespace(text.text-in(line-start, line-end)).size
    .. line-end = text.line-end(text.line-at(caret))
move-to(if caret == indented then line-start else indented, extends)

────────────────────
+ do move-to-line-end
    - extends = false

move-to(text.line-end(text.line-at(caret)), extends)

────────────────────
+ do move-to-start
    - extends = false

move-to(0, extends)

────────────────────
+ do move-to-end
    - extends = false

move-to(text.length, extends)

────────────────────
+ do select-all

anchor = 0
caret = text.length
goal-column = null
history.seal()

────────────────────
+ do collapse

anchor = caret

────────────────────
+ do place
    - line Size
    - column Float
    - extends = false

. target = min(line, text.line-count - 1)
move-to(offset-at-column(target, column), extends)

────────────────────
+ do select-range
    - start Size
    - end Size

anchor = min(start, text.length)
caret = min(end, text.length)
goal-column = null
history.seal()

────────────────────
+ do select-word-at
    - offset Size

. low = offset
. high = offset
. kind = if offset < text.length then char-class(offset) else CodeCharClass.newline
if kind == CodeCharClass.newline && offset > 0
    kind = char-class(text.previous-char(offset))
    low = text.previous-char(offset)
    high = low
while low > 0 && char-class(text.previous-char(low)) == kind
    low = text.previous-char(low)
while high < text.length && char-class(high) == kind
    high = text.next-char(high)
anchor = low
caret = high
goal-column = null
history.seal()

────────────────────
+ do word-at String
    - offset Size

. low = offset
. high = offset
while low > 0 && char-class(text.previous-char(low)) == CodeCharClass.word
    low = text.previous-char(low)
while high < text.length && char-class(high) == CodeCharClass.word
    high = text.next-char(high)
= text.text-in(low, high)

────────────────────
+ do select-line
    - line Size

. last = folds.folded-end(line) ?? line
anchor = text.line-start(line)
caret = if last + 1 < text.line-count then text.line-start(last + 1) else text.length
goal-column = null
history.seal()

────────────────────
+ do word-left Size
    - offset Size

. index = offset
while index > 0 && char-class(text.previous-char(index)) == CodeCharClass.space
    index = text.previous-char(index)
=? index if index == 0
. kind = char-class(text.previous-char(index))
=? text.previous-char(index) if kind == CodeCharClass.newline
while index > 0 && char-class(text.previous-char(index)) == kind
    index = text.previous-char(index)
= index

────────────────────
+ do word-right Size
    - offset Size

. index = offset
while index < text.length && char-class(index) == CodeCharClass.space
    index = text.next-char(index)
=? index if index >= text.length
. kind = char-class(index)
=? text.next-char(index) if kind == CodeCharClass.newline
while index < text.length && char-class(index) == kind
    index = text.next-char(index)
= index

────────────────────
+ char-class CodeCharClass
    - offset Size

code-byte-class(text.byte-at(offset))

────────────────────
+ do fold-ranges [SyntaxFold]
    - first Size
    - last Size

. active = document
=? List'SyntaxFold() if !active
if fold-revision != revision || first < fold-first || last > fold-last
    fold-first = if first > code-window-before then first - code-window-before else 0
    fold-last = last + code-window-after
    fold-window = active.folds(text.bytes, text.length, fold-first, fold-last)
    fold-revision = revision
= fold-window

────────────────────
+ do fold-at SyntaxFold?
    - line Size

for fold in fold-ranges(line, line)
    =? fold if fold.start == line
= null

────────────────────
+ can-fold Bool
    - line Size

fold-at(line) != null

────────────────────
+ do fold Bool

. line = text.line-at(caret)
. found SyntaxFold? = null
for fold in fold-ranges(line, line)
    if fold.start <= line && fold.end >= line && !folds.has-fold(fold.start)
        found = fold
=? false if !found
folds.collapse(found)
cover()
updated <- revision
= true

────────────────────
+ do unfold Bool

=? false if !folds.unfold(text.line-at(caret))
updated <- revision
= true

────────────────────
+ do toggle-fold Bool
    - line Size

if folds.has-fold(line)
    folds.unfold(line)
else
    . found = fold-at(line)
    =? false if !found
    folds.collapse(found)
    cover()
updated <- revision
= true

────────────────────
+ do fold-all

. active = document
=? if !active
folds.fold-all(active.folds(text.bytes, text.length))
cover()
updated <- revision

────────────────────
+ do unfold-all

folds.unfold-all()
updated <- revision

────────────────────
+ do reveal-anchor Bool

= folds.reveal(text.line-at(anchor))

────────────────────
_ advance-column Size
    - index Size
    - column Size

|? byte == code-tab
    (column / tab-width + 1) * tab-width
|? byte < 0x80
    column + 1
??
    column + (text.codepoint-at(index) as Char).display-width

.. byte = text.byte-at(index)

────────────────────
_ do expanded-tabs [SyntaxStyledRun]
    - runs [SyntaxStyledRun]
    - start Size

. expanded [SyntaxStyledRun]
. offset = start
. column Size = 0
for run in runs
    . end = offset + run.text.size
    . pieces [String]
    . piece-start = offset
    . index = offset
    while index < end
        if text.byte-at(index) == code-tab
            if index > piece-start
                pieces += text.text-in(piece-start, index)
            . next = (column / tab-width + 1) * tab-width
            pieces += " " * (next - column)
            column = next
            index += 1
            piece-start = index
        else
            column = advance-column(index, column)
            index = text.next-char(index)
    if end > piece-start
        pieces += text.text-in(piece-start, end)
    expanded += SyntaxStyledRun("".join(pieces), run.role, run.is-marked)
    offset = end
= expanded

────────────────────
_ do load-window
    - line Size

. first = if line > code-window-before then line - code-window-before else 0
. last = min(text.line-count, line + code-window-after)
. lines [[SyntaxSpan]]
for index in first .. < last
    lines += List'SyntaxSpan()
. active = document
if active && last > first
    . spans = active.highlight
        - text.bytes
        - text.length
        - text.line-start(first)
        - text.line-end(last - 1)
    . current = first
    for span in spans
        . position = span.start
        while position < span.end && current < last
            . line-end = text.line-end(current)
            if position > line-end
                current += 1
            else
                . piece-end = min(span.end, line-end)
                if piece-end > position
                    . bucket = lines[current - first]
                    bucket += SyntaxSpan(position, piece-end, span.capture)
                if span.end <= line-end
                    position = span.end
                else
                    position = line-end + 1
                    current += 1
window-first = first
window-spans = lines
window-revision = revision

────────────────────
_ do reparse
    - budget = code-edit-parse-budget

. active = document
=? if !active || active.is-parsing
if active.parse(text.bytes, text.length, budget)
    has-parse-error = active.has-error
else if active.is-parsing
    do new @detached
        finish-background-parse(active)

────────────────────
_ do finish-background-parse
    - active SyntaxDocument

. done = Semaphore'Bool()
do new thread @detached
    done.post(active.continue-parse())
done.await()
. edited = active.finish-parse()
=? if !document
has-parse-error = active.has-error
revision += 1
if edited
    reparse()
updated <- revision

────────────────────
_ do start-marking

` Starts a task that marks the lines that differ from the baseline, unless one runs already: it
` goes on until the marks match the last edit.
=? if marker && !marker.is-finished
marker = do new mark-changes()

────────────────────
_ do mark-changes

while baseline != null && marked-stamp != edit-stamp
    . stamp = edit-stamp
    . source = baseline
    . current = code-text-bytes(text)
    . done = Semaphore'[DiffLineChange]()
    do new thread
        done.post(diff-document(source, current).line-changes())
    . found = done.await()
    if found == null
        break
    if stamp == edit-stamp && baseline != null
        line-changes = found
        marked-stamp = stamp
        updated <- revision

────────────────────
_ do apply CodeTextChange
    - start Size
    - end Size
    - inserted String

. change = text.replace(start, end, inserted)
. active = document
if active
    active.edit
        - change.start
        - change.old-end
        - change.new-end
        - change.start-point
        - change.old-end-point
        - change.new-end-point
    reparse()
folds.shift(change.start-point, change.old-end-point, change.new-end-point)
for line in change.start-point.row .. change.new-end-point.row
    widest-columns = max(widest-columns, line-columns(line))
revision += 1
if baseline != null
    edit-stamp += 1
    . delta = (change.new-end-point.row as I64) - (change.old-end-point.row as I64)
    line-changes = diff-shifted-changes(line-changes, change.old-end-point.row, delta)
    start-marking()
= change

────────────────────
_ do edit
    - start Size
    - end Size
    - inserted String
    - title String
    - coalescing = false

. old-caret = caret
. old-anchor = anchor
. change = apply(start, end, inserted)
caret = change.new-end
anchor = caret
goal-column = null
if !coalescing
    history.seal()
history.record(title, CodeEdit(this, start, change.removed, inserted, old-caret, old-anchor, caret))
if !coalescing
    history.seal()
updated <- revision

────────────────────
_ do restore
    - start Size
    - end Size
    - inserted String
    - caret-to Size
    - anchor-to Size

. ignored = apply(start, end, inserted)
caret = caret-to
anchor = anchor-to
goal-column = null
updated <- revision

────────────────────
_ do cover

. line = text.line-at(caret)
if folds.is-hidden(line)
    . head = folds.actual(folds.shown(line))
    caret = offset-at-column(head, (goal-column ?? display-column(caret)) as Float)
    anchor = caret
    history.seal()
else if folds.is-hidden(text.line-at(anchor))
    anchor = caret

────────────────────
_ visible Size
    - offset Size
    - forward Bool

|? !folds.is-hidden(line)
    offset
|? !forward || display + 1 >= folds.row-count(text.line-count)
    text.line-end(head)
??
    text.line-start(folds.actual(display + 1))

.. line = text.line-at(offset)
.. display = folds.shown(line)
.. head = folds.actual(display)

────────────────────
_ last-selected-line Size

if has-selection && last > text.line-at(selection-start) && selection-end == text.line-start(last) then last - 1 else last

.. last = text.line-at(selection-end)

────────────────────
_ do last-meaningful-byte Byte
    - start Size
    - end Size

. index = end
while index > start
    index -= 1
    . byte = text.byte-at(index)
    =? byte if byte != code-space && byte != code-tab
= 0

────────────────────
_ outdented String
    - prefix String

|? prefix.ends-with("\t")
    prefix[0 .. < prefix.length - 1]
??
    prefix[0 .. < prefix.length - count]

.. count = min(indent-unit.size, prefix.size)

────────────────────
_ do outdented-line String
    - line String

=? line[1 ...] if line.starts-with("\t")
. count Size = 0
for char in line
    if char != ' ' || count >= indent-unit.size
        break
    count += 1
= if count > 0 then line[count ...] else line

────────────────────
_ do detect-indent String

. tabs Size = 0
. spaced Size = 0
. smallest Size = 0
for line in 0 .. < min(text.line-count, code-indent-sample-lines)
    . start = text.line-start(line)
    . end = text.line-end(line)
    if start < end
        if text.byte-at(start) == code-tab
            tabs += 1
        else if text.byte-at(start) == code-space
            . count Size = 0
            while start + count < end && text.byte-at(start + count) == code-space
                count += 1
            if start + count < end && count > 1
                spaced += 1
                if smallest == 0 || count < smallest
                    smallest = count
|? tabs > spaced
    = "\t"
|? smallest == 2 || smallest == 4 || smallest == 8
    = " " * smallest
??
    = "    "

━━━━━━━━━━━━━━━━━━━━
+ CodeCharClass is Union

| space
| word
| punctuation
| newline

━━━━━━━━━━━━━━━━━━━━
+ code-byte-class CodeCharClass
    - byte Byte

|? byte == code-newline
    CodeCharClass.newline
|? byte == code-space || byte == code-tab || byte == code-return
    CodeCharClass.space
|? byte >= 0x80 || byte == 95 || (byte >= 48 && byte <= 57) || is-letter
    CodeCharClass.word
??
    CodeCharClass.punctuation

.. is-letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)

━━━━━━━━━━━━━━━━━━━━
+ code-matching-line Size
    - from String
    - to String
    - line Size

diff-matching-line(code-text-bytes(CodeText(from)), code-text-bytes(CodeText(to)), line)

━━━━━━━━━━━━━━━━━━━━
_ CodeEdit
    is CommandHistoryEntry

_ session CodeSession
_ start Size
_ removed String
_ inserted String
_ caret-before Size
_ anchor-before Size
_ caret-after Size

────────────────────
_ This
    - session
    - start
    - removed
    - inserted
    - caret-before
    - anchor-before
    - caret-after

────────────────────
+ do undo

session.restore(start, start + inserted.size, removed, caret-before, anchor-before)

────────────────────
+ do redo

session.restore(start, start + removed.size, inserted, caret-after, caret-after)

────────────────────
+ do coalesce Bool
    - next CommandHistoryEntry

match? next
    | CodeEdit
        if !removed.size && !it.removed.size && start + inserted.size == it.start
            inserted += it.inserted
            caret-after = it.caret-after
            = true
        =? false if inserted.size || it.inserted.size || !removed.size || !it.removed.size
        if it.start + it.removed.size == start
            start = it.start
            removed = "${it.removed}$removed"
            caret-after = it.caret-after
            = true
        if it.start == start
            removed += it.removed
            caret-after = it.caret-after
            = true
= false

━━━━━━━━━━━━━━━━━━━━
_ do leading-whitespace String
    - line String

. count Size = 0
for char in line
    if char != ' ' && char != '\t'
        break
    count += 1
= line[0 .. < count]

━━━━━━━━━━━━━━━━━━━━
_ is-closing Bool
    - typed String

typed == "}" || typed == ")" || typed == "]"

━━━━━━━━━━━━━━━━━━━━
_ code-closer Byte?
    - opener Byte

match? opener
    |= code-open-brace
        code-close-brace
    |= code-open-paren
        code-close-paren
    |= code-open-bracket
        code-close-bracket

━━━━━━━━━━━━━━━━━━━━
_ code-opens-block Bool
    - opener Byte

opener == code-colon || code-closer(opener) != null

━━━━━━━━━━━━━━━━━━━━
_ is-all-spaces Bool
    - text String

all(text) • where each == ' '

━━━━━━━━━━━━━━━━━━━━
_ do code-text-bytes
    - text CodeText

. bytes = Byte[text.length]
bytes[0 .. < text.length] = text.bytes[0 .. < text.length]
= bytes

━━━━━━━━━━━━━━━━━━━━
_ code-splits-character Bool
    - text CodeText
    - offset Size

offset < text.length && utf8-is-continuation(text.bytes[offset])

━━━━━━━━━━━━━━━━━━━━
_ code-reloaded-offset Size
    - offset Size
    - start Size
    - old-end Size
    - new-end Size

|? offset <= start
    offset
|? offset >= old-end
    offset - old-end + new-end
??
    min(offset, new-end)
