/git
/os/env
/os/path
/os/process

+ file-text-match-limit Size = 2000
_ file-text-batch-size Size = 64
_ file-text-chunk-size Size = 65536
_ file-text-open-mark = 30u8
_ file-text-close-mark = 31u8
_ file-text-preview-limit Size = 300
_ file-text-ripgrep-folders = ["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin"]

━━━━━━━━━━━━━━━━━━━━
+ FileTextQuery is Tuple

+ text String
+ is-regex = false
+ is-case-sensitive Bool? = null
+ is-whole-word = false
+ scope String
+ limit = file-text-match-limit

────────────────────
+ get matches-case Bool

is-case-sensitive ?? text != text.lowercased

━━━━━━━━━━━━━━━━━━━━
+ FileTextHit is Tuple

+ start Size
+ end Size

━━━━━━━━━━━━━━━━━━━━
+ FileTextMatch is Tuple

+ path String
+ line Size
+ column Size
+ text String
+ hits [FileTextHit]

━━━━━━━━━━━━━━━━━━━━
+ FileTextSearch
    is Closable

+ root Path
+ query FileTextQuery
+ count Size = 0
+ is-finished = false
+ is-truncated = false
+ event found [FileTextMatch]
+ event finished FileTextSearch

_ process Process?
_ is-started = false
_ is-closed = false

────────────────────
+ This
    - root
    - query

────────────────────
+ do start

=? if is-started || is-closed
is-started = true
do new @detached
    run()

────────────────────
+ do close

=? if is-closed
is-closed = true
. active = process
process = null
if active && !is-finished
    active.terminate()

────────────────────
_ do run

. ripgrep = file-text-ripgrep()
. separator Byte = if ripgrep != null then 58 else 0
. spawned = catch? file-text-process("$root", query, ripgrep)
if spawned && !is-closed
    process = spawned
    do finally spawned.reap()
    spawned.close-input()
    read(spawned, separator)
    if is-truncated && !is-closed
        spawned.terminate()
    spawned.close()
    . ignored = spawned.wait(null)
is-finished = true
process = null
if !is-closed
    finished <- this

────────────────────
_ do read
    - source Process
    - separator Byte

. needle = if !query.is-regex then byte-view(query.text) else Byte[0]
. folds = !query.matches-case
. bounded = query.is-whole-word
. has-marks = separator == 58
. batch [FileTextMatch]
. chunk = Byte[file-text-chunk-size]
. data = Byte[file-text-chunk-size * 2]
. held Size = 0
while !is-truncated
    . size = source.read(chunk.size, chunk)
    =? if is-closed
    if size == 0
        break
    if held + size > data.size
        . grown = Byte[(held + size) * 2]
        grown[0 .. < held] = data[0 .. < held]
        data = grown
    data[held .. < held + size] = chunk[0 .. < size]
    . filled = held + size
    . first Index = 0
    for index in 0 .. < filled
        if data[index] == 10 && !is-truncated
            . match = file-text-parse
                - data
                - first
                - index
                - separator
                - needle
                - folds
                - bounded
                - has-marks
            first = index + 1
            if match
                batch += match
                count += 1
                if count >= query.limit
                    is-truncated = true
                else if batch.length >= file-text-batch-size
                    found <- batch
                    batch = List'FileTextMatch()
    held = filled - first
    if held > 0 && first > 0
        . kept = Byte[data.size]
        kept[0 .. < held] = data[first .. < filled]
        data = kept
if batch.length > 0 && !is-closed
    found <- batch

━━━━━━━━━━━━━━━━━━━━
_ do file-text-process Process ?! Error
    - directory String
    - query FileTextQuery
    - ripgrep String?

. arguments [String]
if ripgrep
    arguments += "--null"
    arguments += "--line-number"
    arguments += "--column"
    arguments += "--no-heading"
    arguments += "--color=never"
    arguments += "--no-messages"
    arguments += "--hidden"
    arguments += "--glob=!.git"
    arguments += "--max-columns=$file-text-preview-limit"
    arguments += "--max-columns-preview"
    arguments += if query.matches-case then "--case-sensitive" else "--ignore-case"
    if !query.is-regex
        arguments += "--fixed-strings"
    if query.is-whole-word
        arguments += "--word-regexp"
    arguments += "--regexp=${query.text}"
    arguments += "--replace=$open-marker$0${file-text-marker(file-text-close-mark)}"
        .. open-marker = file-text-marker(file-text-open-mark)
    arguments += "--"
    arguments += if query.scope then query.scope else "."
    = Process(ripgrep, ProcessStderr.discard, arguments, directory)
arguments += "grep"
arguments += "--line-number"
arguments += "--column"
arguments += "--null"
arguments += "--no-color"
arguments += "-I"
arguments += "--untracked"
arguments += "--exclude-standard"
arguments += if query.is-regex then "--extended-regexp" else "--fixed-strings"
if !query.matches-case
    arguments += "--ignore-case"
if query.is-whole-word
    arguments += "--word-regexp"
arguments += "-e"
arguments += query.text
if query.scope
    arguments += "--"
    arguments += query.scope
= git-process(directory, arguments)

━━━━━━━━━━━━━━━━━━━━
_ do file-text-ripgrep String?

. folders [String]
. listed = environment()["PATH"]
if listed
    for folder in listed.split(":")
        folders += folder
for folder in file-text-ripgrep-folders
    folders += folder
for folder in folders
    . candidate = "$folder/rg"
    =? candidate if folder && Path(candidate, 0).exists
= null

━━━━━━━━━━━━━━━━━━━━
_ do file-text-parse FileTextMatch?
    - bytes Byte[]
    - first Index
    - size Index
    - separator Byte
    - needle ImmutableArray'Byte
    - folds Bool
    - bounded Bool
    - has-marks Bool

. cursor = first
while cursor < size && bytes[cursor] != 0
    cursor += 1
=? if cursor == first || cursor >= size
. start = if cursor > first + 2 && bytes[first] == 46 && bytes[first + 1] == 47 then first + 2 else first
. path = file-text-decoded(bytes, start, cursor, List'FileTextHit()).text
cursor += 1
. number Size = 0
. digits Size = 0
while cursor < size && bytes[cursor] != separator
    =? if bytes[cursor] < 48 || bytes[cursor] > 57
    number = number * 10 + ((bytes[cursor] - 48) as Size)
    digits += 1
    cursor += 1
=? if digits == 0 || number == 0 || cursor >= size
cursor += 1
. column Size = 0
digits = 0
while cursor < size && bytes[cursor] != separator
    =? if bytes[cursor] < 48 || bytes[cursor] > 57
    column = column * 10 + ((bytes[cursor] - 48) as Size)
    digits += 1
    cursor += 1
=? if digits == 0 || column == 0 || cursor >= size
cursor += 1
. end = size
if end > cursor && bytes[end - 1] == 13
    end -= 1
. clean = Byte[end - cursor]
. count Index = 0
. hits [FileTextHit]
. opened Index = 0
. is-open = false
for index in cursor .. < end
    . byte = bytes[index]
    if has-marks && byte == file-text-open-mark
        opened = count
        is-open = true
    else if has-marks && byte == file-text-close-mark
        if is-open && count > opened
            hits += FileTextHit(opened, count)
        is-open = false
    else
        clean[count] = byte
        count += 1
if !has-marks && needle.size > 0
    hits = file-text-literal-hits(clean, count, needle, folds, bounded)
. limit = count
if limit > file-text-preview-limit
    limit = file-text-preview-limit
    while limit > 0 && utf8-is-continuation(clean[limit])
        limit -= 1
. kept [FileTextHit]
for hit in hits
    if hit.start < limit
        kept += FileTextHit(hit.start, if hit.end < limit then hit.end else limit)
. decoded = file-text-decoded(clean, 0, limit, kept)
= FileTextMatch(path, number - 1, column - 1, decoded.text, decoded.hits)

━━━━━━━━━━━━━━━━━━━━
_ FileTextDecoding is Tuple

+ text String
+ hits [FileTextHit]

━━━━━━━━━━━━━━━━━━━━
_ do file-text-decoded FileTextDecoding
    - bytes Byte[]
    - start Index
    - end Index
    - hits [FileTextHit]

. output = Byte[(end - start) * 3]
. moved = Index[end - start + 1]
. count Index = 0
. cursor = start
while cursor < end
    . width = file-text-sequence-width(bytes, cursor, end)
    moved[cursor - start] = count
    if width == 0
        output[count] = 239
        output[count + 1] = 191
        output[count + 2] = 189
        count += 3
        cursor += 1
    else
        for offset in 0 .. < width
            moved[cursor - start + offset] = count + offset
            output[count + offset] = bytes[cursor + offset]
        count += width
        cursor += width
moved[end - start] = count
. shifted [FileTextHit]
for hit in hits
    shifted += FileTextHit(moved[hit.start - start], moved[hit.end - start])
= FileTextDecoding(output.slice-string(0 .. < count), shifted)

━━━━━━━━━━━━━━━━━━━━
_ do file-text-literal-hits [FileTextHit]
    - bytes Byte[]
    - count Index
    - needle ImmutableArray'Byte
    - folds Bool
    - bounded Bool

. hits [FileTextHit]
. width = needle.size
. cursor Index = 0
while cursor + width <= count
    . matches = true
    if bounded
        if cursor > 0 && file-text-is-word(bytes[cursor - 1])
            matches = false
        if cursor + width < count && file-text-is-word(bytes[cursor + width])
            matches = false
    for offset in 0 .. < width
        if matches && !file-text-same(bytes[cursor + offset], needle[offset], folds)
            matches = false
    if matches
        hits += FileTextHit(cursor, cursor + width)
        cursor += width
    else
        cursor += 1
= hits

━━━━━━━━━━━━━━━━━━━━
_ file-text-is-word Bool
    - byte Byte

is-digit || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte >= 128

.. is-digit = byte >= 48 && byte <= 57

━━━━━━━━━━━━━━━━━━━━
_ file-text-same Bool
    - left Byte
    - right Byte
    - folds Bool

left == right || (folds && file-text-folded(left) == file-text-folded(right))

━━━━━━━━━━━━━━━━━━━━
_ file-text-folded Byte
    - byte Byte

if byte >= 65 && byte <= 90 then byte + 32 else byte

━━━━━━━━━━━━━━━━━━━━
_ do file-text-marker String
    - byte Byte

. bytes = Byte[1]
bytes[0] = byte
= bytes.slice-string(0 .. < 1)

━━━━━━━━━━━━━━━━━━━━
_ do file-text-sequence-width Size
    - bytes Byte[]
    - cursor Index
    - end Index

. lead = bytes[cursor]
=? 1 if lead < 128
. width Size = 0
. low = 128u8
. high = 191u8
if lead >= 194 && lead <= 223
    width = 2
else if lead >= 224 && lead <= 239
    width = 3
    if lead == 224
        low = 160
    else if lead == 237
        high = 159
else if lead >= 240 && lead <= 244
    width = 4
    if lead == 240
        low = 144
    else if lead == 244
        high = 143
=? 0 if width == 0 || cursor + width > end
. second = bytes[cursor + 1]
=? 0 if second < low || second > high
for offset in 2 .. < width
    =? 0 if !utf8-is-continuation(bytes[cursor + offset])
= width
