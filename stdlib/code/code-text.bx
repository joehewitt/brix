(import ./syntax)
(import /math)
(import /string.h)
(blank)
(prop + code-newline Byte (= 10))
(prop + code-return Byte (= 13))
(prop + code-tab Byte (= 9))
(prop + code-space Byte (= 32))
(prop + code-colon Byte (= 58))
(prop + code-open-paren Byte (= 40))
(prop + code-close-paren Byte (= 41))
(prop + code-open-bracket Byte (= 91))
(prop + code-close-bracket Byte (= 93))
(prop + code-open-brace Byte (= 123))
(prop + code-close-brace Byte (= 125))

(type + CodeTextChange (is Tuple)
  (prop + start Size)
  (prop + old-end Size)
  (prop + new-end Size)
  (prop + start-point SyntaxPoint)
  (prop + old-end-point SyntaxPoint)
  (prop + new-end-point SyntaxPoint)
  (prop + removed String)
  (prop + inserted String)
)

(type + CodeTextDamage
  (prop + is-damaged _ (= false))
  (prop + first-line Size)
  (prop + last-line Size)
  (prop + line-delta I64)
  (prop + byte-delta I64)
  (fn-do + add _
    (param change CodeTextChange)
    (let first (. change start-point row))
    (let old-last (. change old-end-point row))
    (let new-last (. change new-end-point row))
    (let delta (- (as new-last I64) (as old-last I64)))
    (if is-damaged
      (= last-line (if-expr (> last-line old-last) (as (+ (as last-line I64) delta) Size) new-last))
      (if (< first first-line)
        (= first-line first)
      )
      (else
        (= first-line first)
        (= last-line new-last)
        (= is-damaged true)
      )
    )
    (+= line-delta delta)
    (+= byte-delta (- (as (. change new-end) I64) (as (. change old-end) I64)))
  )
  (fn-do + clear _
    (= is-damaged false)
    (= line-delta 0)
    (= byte-delta 0)
  )
)

(type + CodeText
  (prop + bytes ([] Byte))
  (prop + length Size)
  (prop + line-starts (list Size))
  (prop + uses-crlf Bool)
  (blank)
  (prop _ damages (list CodeTextDamage))
  (fn-do + This _
    (param source String (= ""))
    (let raw (call byte-view source))
    (let count (. raw size))
    (= bytes ([] Byte (+ count 256)))
    (let write Size 0)
    (for (in index (..< 0 count))
      (let byte ([] raw index))
      (if (and (== byte code-return) (< (+ index 1) count) (== ([] raw (+ index 1)) code-newline))
        (= uses-crlf true)
        (else
          (= ([] bytes write) byte)
          (+= write 1)
        )
      )
    )
    (= length write)
    (+= line-starts 0)
    (for (in index (..< 0 length))
      (if (== ([] bytes index) code-newline)
        (+= line-starts (+ index 1))
      )
    )
  )
  (fn-expr + line-count Size :get
    (. line-starts length)
  )
  (fn-expr + line-start Size
    (param line Size)
    ([] line-starts line)
  )
  (fn-expr + line-end Size
    (param line Size)
    (if-expr (< (+ line 1) (. line-starts length)) (- ([] line-starts (+ line 1)) 1) length)
  )
  (fn-expr + line-length Size
    (param line Size)
    (- (call line-end line) (call line-start line))
  )
  (fn-expr + line-text String
    (param line Size)
    (call text-in (call line-start line) (call line-end line))
  )
  (fn-expr + text-in String
    (param start Size)
    (param end Size)
    (if-expr (> end start) (call (. bytes slice-string) (..< start end)) "")
  )
  (fn-expr + text String :get
    (call text-in 0 length)
  )
  (fn-expr + saved-text String :get
    (if-expr uses-crlf (call (. "\r\n" join) (call (. text split) "\n")) text)
  )
  (fn-expr + byte-at Byte
    (param offset Size)
    ([] bytes offset)
  )
  (fn-do + line-at Size
    (param offset Size)
    (let low Size 0)
    (let high (. line-starts length))
    (while (> (- high low) 1)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= ([] line-starts middle) offset)
        (= low middle)
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
  (fn-do + track _
    (param damage CodeTextDamage)
    (+= damages damage)
  )
  (fn-do + untrack _
    (param damage CodeTextDamage)
    (let index Size 0)
    (while (< index (. damages length))
      (if (== (as ([] damages index) Pointer) (as damage Pointer))
        (call (. damages remove) index)
        (return)
      )
      (+= index 1)
    )
  )
  (fn-expr + point-at SyntaxPoint
    (param offset Size)
    (call SyntaxPoint line (- offset ([] line-starts line)))
    (where
      (lazy line (call line-at offset))
    )
  )
  (fn-expr + offset-at Size
    (param line Size)
    (param column Size)
    (call min (+ (call line-start line) column) (call line-end line))
  )
  (fn-do + next-char Size
    (param offset Size)
    (return-if length (if (>= offset length)))
    (blank)
    (let next (+ offset 1))
    (while (and (< next length) (call utf8-is-continuation ([] bytes next)))
      (+= next 1)
    )
    (return next)
  )
  (fn-do + previous-char Size
    (param offset Size)
    (return-if 0 (if (== offset 0)))
    (blank)
    (let previous (- offset 1))
    (while (and (> previous 0) (call utf8-is-continuation ([] bytes previous)))
      (-= previous 1)
    )
    (return previous)
  )
  (fn-do + char-offset Size
    (param line Size)
    (param index Size)
    (let offset (call line-start line))
    (let end (call line-end line))
    (let count Size 0)
    (while (and (< count index) (< offset end))
      (= offset (call next-char offset))
      (+= count 1)
    )
    (return offset)
  )
  (fn-do + char-index Size
    (param offset Size)
    (let index (call line-start (call line-at offset)))
    (let count Size 0)
    (while (< index offset)
      (= index (call next-char index))
      (+= count 1)
    )
    (return count)
  )
  (fn-do + codepoint-at U32
    (param offset Size)
    (let lead (as ([] bytes offset) U32))
    (return-if lead (if (< lead 0x80)))
    (blank)
    (let extra Size (if-expr (< lead 0xe0) 1 (if-expr (< lead 0xf0) 2 3)))
    (let value (/and/ lead (if-expr (== extra 1) 0x1f (if-expr (== extra 2) 0x0f 0x07))))
    (for (in index (.. 1 extra))
      (if (< (+ offset index) length)
        (= value (/or/ (/lshift/ value 6) (/and/ (as ([] bytes (+ offset index)) U32) 0x3f)))
      )
    )
    (return value)
  )
  (fn-do + replace CodeTextChange
    (param start Size)
    (param end Size)
    (param inserted String)
    (let removed (call text-in start end))
    (let start-point (call point-at start))
    (let old-end-point (call point-at end))
    (let added (call byte-view inserted))
    (let added-size (. added size))
    (let removed-size (- end start))
    (let new-length (+ (- length removed-size) added-size))
    (if (> new-length (. bytes size))
      (= bytes (call (. bytes resize) (+ new-length (/ new-length 2) 256)))
    )
    (if (and (< end length) (!= added-size removed-size))
      (call C:memmove (+ (. bytes data) start added-size) (+ (. bytes data) end) (- length end))
    )
    (if (> added-size 0)
      (call C:memcpy (+ (. bytes data) start) added added-size)
    )
    (= length new-length)
    (blank)
    (let first (. start-point row))
    (let last (. old-end-point row))
    (if (> last first)
      (call (. line-starts remove) (+ first 1) (- last first))
    )
    (let shift (- (as added-size I64) (as removed-size I64)))
    (if (!= shift 0)
      (for (in line (..< (+ first 1) (. line-starts length)))
        (= ([] line-starts line) (+ (as ([] line-starts line) I64) shift))
      )
    )
    (let starts (list Size))
    (for (in index (..< 0 added-size))
      (if (== ([] added index) code-newline)
        (+= starts (+ start index 1))
      )
    )
    (if (> (. starts length) 0)
      (call (. line-starts insert) starts (+ first 1))
    )
    (blank)
    (let change
      (call CodeTextChange
        (block
          (arg start)
          (arg end)
          (arg (+ start added-size))
          (arg start-point)
          (arg old-end-point)
          (arg (call point-at (+ start added-size)))
          (arg removed)
          (arg inserted)
        )
      )
    )
    (for (in damage damages)
      (call (. damage add) change)
    )
    (return change)
  )
)
