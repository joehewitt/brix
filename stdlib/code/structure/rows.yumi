/stream/aggregate

+ SourceRowMode is U8
+ source-row-decoration SourceRowMode = 0
+ source-indent-columns Size = 4
+ source-divider-thick U8 = 1
+ source-divider-thin U8 = 2
+ source-divider-double U8 = 3

━━━━━━━━━━━━━━━━━━━━
+ SourceSpanKind is Union

| plain
| keyword
| definition
| identifier
| type-name
| rule
| capture
| number
| string
| operator
| punctuation
| decoration
| comment
| invalid
| parameter
| member
| member-binder
| binder
| type-definition
| exit
| tracked

━━━━━━━━━━━━━━━━━━━━
+ SourceRowZone is Union

| none
| header
| body
| loose
| preamble

━━━━━━━━━━━━━━━━━━━━
+ SourceRowBlock is Union

| none
| leaf
| steps
| text
| holder

━━━━━━━━━━━━━━━━━━━━
+ SourceSpan is Tuple

+ kind SourceSpanKind
+ text String
+ is-optional = false

━━━━━━━━━━━━━━━━━━━━
+ SourceOutlineRow is Tuple

+ node U32?
+ mode SourceRowMode
+ indent Size
+ is-invalid Bool
+ divider U8
+ owner U32?
+ is-empty Bool
+ zone = SourceRowZone.none
+ block = SourceRowBlock.none
+ is-text-only = false
+ is-padding = false
+ is-private = false

────────────────────
+ get content-start Size

indent * source-indent-columns

────────────────────
+ get is-divider Bool

divider > 0

━━━━━━━━━━━━━━━━━━━━
+ SourceOutlinePart is Tuple

+ id U32
+ place U32
+ kind U8
+ mode SourceRowMode
+ zone SourceRowZone
+ first Size
+ count Size

━━━━━━━━━━━━━━━━━━━━
+ SourceOutline

+ place U32
+ rows [SourceOutlineRow]
+ plain [SourceOutlineRow]
+ parts [SourceOutlinePart]
+ reused Size

────────────────────
+ This
    - place
    - rows
    - plain
    - parts
    - reused

━━━━━━━━━━━━━━━━━━━━
+ SourceRow is Tuple

+ node U32?
+ mode SourceRowMode
+ indent Size
+ spans [SourceSpan]
+ is-invalid Bool
+ divider U8
+ owner U32? = null
+ node-id U32
+ owner-id U32
+ zone = SourceRowZone.none
+ block = SourceRowBlock.none
+ is-padding = false
+ is-private = false

────────────────────
+ get text String

indentation ++ content

.. indentation = " " * (indent * source-indent-columns)

────────────────────
+ get content String

"".join(each.text in spans)

────────────────────
+ get content-start Size

indent * source-indent-columns

────────────────────
+ do get columns Size

. count = content-start
=? count if is-divider
for span in spans
    count += span.text.length
= count

────────────────────
+ get is-decoration Bool

node == null

────────────────────
+ get is-divider Bool

divider > 0

━━━━━━━━━━━━━━━━━━━━
+ do source-spans-same Bool
    - left [SourceSpan]
    - right [SourceSpan]

=? false if left.length != right.length
= all(0 .. < left.length) • where left[each].kind == right[each].kind && left[each].text == right[each].text && left[each].is-optional == right[each].is-optional
