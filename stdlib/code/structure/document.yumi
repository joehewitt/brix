./language
./rows
/core/table
/data/sexp
/data/source-sexp
/data/source-tree

_ source-drawn-capacity = 32
_ source-retired-capacity = 16
_ source-rendered-capacity Size = 4096

━━━━━━━━━━━━━━━━━━━━
+ SourceDocument

+ language SourceLanguage
+ store SourceStore
+ declarations [U32]
+ row-count Size
+ widest-columns Size
+ render-count Size
+ outline-count Size
+ reused-row-count Size
+ compaction-count Size
+ revision U64
+ line-ids [U32]

_ row-ends [Size]
_ kept [U32 = SourceShown]
_ retired [SourceShown]
_ drawn [SourceShown]
_ latest SourceShown?
_ rendered Size
_ settled U32
_ base Size
_ homes U32[]?
_ homes-revision U64
_ viewed [U32 = [String]]

────────────────────
+ This
    - language
    - declarations
    - line-ids

.. store = language.store
. end Size = 0
for position in declarations
    . entry = SourceShown(position, outlined(store.node(position), null))
    kept[position] = entry
    end += entry.outline.rows.length
    row-ends += end
row-count = end + 1
settled = store.mark
base = store.length

────────────────────
+ get cell-count Size

settled

────────────────────
+ get kept-row-count Size

rendered

────────────────────
+ get kept-outline-count Size

(kept.length as Size) + retired.length

────────────────────
+ get is-crowded Bool

store.length > base * 2 + source-compact-slack

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

store.release()

────────────────────
+ do shed

kept = Map'U32'SourceShown()
retired = List'SourceShown()
drawn = List'SourceShown()
latest = null
rendered = 0
homes = null

────────────────────
+ do compact SourceMoves
    - held [U32]

. roots [U32]
roots ++= declarations
roots ++= held
. moves = store.compact(roots)
for index in 0 .. < declarations.length
    declarations[index] = moves.place(declarations[index])
viewed = Map'U32'[String]()
shed()
settled = store.mark
base = store.length
compaction-count += 1
= moves

────────────────────
+ declaration ImmutableTableRow'SourceNode
    - index Index

store.node(declarations[index])

────────────────────
+ do declaration-at Index
    - row Size

. low Index = 0
. high = row-ends.length
while low < high
    . middle = low + (high - low) / 2
    if row < row-ends[middle]
        high = middle
    else
        low = middle + 1
= low

────────────────────
+ first-row Size
    - index Index

if index > 0 then row-ends[index - 1] else 0

────────────────────
+ do row-at SourceRow
    - row Size

?! OutOfBoundsError("Source row out of bounds ($row / $row-count)")
    if row >= row-count
=? language.closing-row() if row + 1 == row-count
. index = declaration-at(row)
. position = row - first-row(index)
. entry = shown-at(declarations[index])
. held = entry.rows[position]
=? held if held
. made = language.render(entry.outline.rows[position])
if entry.rows.length == 0
    drawn += entry
entry.rows[position] = made
rendered += 1
render-count += 1
. columns = made.columns
if columns > widest-columns
    widest-columns = columns
if drawn.length > source-drawn-capacity
    forget(drawn[0])
while rendered > source-rendered-capacity && drawn.length > 0
    forget(drawn[0])
= made

────────────────────
+ rows-of [SourceOutlineRow]
    - index Index

shown-at(declarations[index]).outline.rows

────────────────────
+ node-id U32
    - row SourceOutlineRow

store.id-at(row.node)

────────────────────
+ owner-id U32
    - row SourceOutlineRow

store.id-at(row.owner)

────────────────────
+ do replace-row-node
    - row Size
    - replacement ImmutableTableRow'SourceNode

. index = declaration-at(row)
. old = rows-of(index)[row - first-row(index)].node
?! Panic("Source row $row presents no node")
    if old == null
. next = store.swapped(declaration(index), store.node(old), replacement)
?! Panic("Source row $row is not in its declaration")
    if !next
replace(index, next)

────────────────────
+ do replace
    - index Index
    - declaration ImmutableTableRow'SourceNode

. places = store.settle(settled, List'(ImmutableTableRow'SourceNode)(language.grouped(declaration)))
settled = store.mark
. old = declarations[index]
. previous = kept[old]?.outline
retire(old)
declarations[index] = places[0]
shown-at(places[0], previous)
refresh(index)

────────────────────
+ do discard

store.rewind(settled)

────────────────────
+ do refresh
    - index Index

. previous = row-ends[index] - first-row(index)
. count = rows-of(index).length
if count != previous
    for later in index .. < row-ends.length
        row-ends[later] = row-ends[later] + count - previous
    row-count = row-count + count - previous
revision += 1

────────────────────
+ do splice
    - index Index
    - count Size
    - nodes [ImmutableTableRow'SourceNode]

. grouped [ImmutableTableRow'SourceNode]
for node in nodes
    grouped += language.grouped(node)
. places = store.settle(settled, grouped)
settled = store.mark
restore(index, count, places)

────────────────────
+ do restore
    - index Index
    - count Size
    - places [U32]

. next [U32]
. ends [Size]
. end Size = 0
. olds [SourceOutline?]
for position in index .. < index + count
    olds += kept[declarations[position]]?.outline
    retire(declarations[position])
for position in 0 .. < index
    next += declarations[position]
    end += row-ends[position] - first-row(position)
    ends += end
for slot in 0 .. < places.length
    . place = places[slot]
    . previous = olds[slot] if slot < olds.length
    next += place
    end += shown-at(place, previous).outline.rows.length
    ends += end
for position in index + count .. < declarations.length
    next += declarations[position]
    end += row-ends[position] - first-row(position)
    ends += end
declarations = next
row-ends = ends
row-count = end + 1
revision += 1

────────────────────
+ row-of-line Size?
    - line Size

|? line >= line-ids.length
    null
|? id == 0
    null
??
    row-of-node(id)

.. id = live-id-near(line)

────────────────────
+ do row-of-node Size?
    - id U32

. home = home-of(id)
=? null if home == null
. trail [U32]
=? null if !trailed(declaration(home), id, trail)
= row-on-trail(home, trail)

────────────────────
+ do written SexpWritten

. nodes [ImmutableTableRow'SourceNode]
for index in 0 .. < declarations.length
    . node = declaration(index)
    if !language.is-section(node)
        nodes += node
        continue
    . items = store.items(node)
    . start = language.header-count(node) ?? 0
    for position in start .. < items.length
        nodes += items[position]
= sexp-written(store, nodes, language, null)

────────────────────
+ text String

written().text

────────────────────
+ do view-rows [SourceRow]

. rows [SourceRow]
for place in declarations
    for row in shown-at(place).outline.rows
        rows += language.render(row)
rows += language.closing-row()
= rows

────────────────────
+ do view-lines [String]

. lines [String]
. next = Map'U32'[String]()
for place in declarations
    . held = viewed[place] ?? List'String(language.render(each).text in shown-at(place).outline.rows)
    next[place] = held
    lines ++= held
lines += language.closing-row().text
viewed = next
= lines

────────────────────
+ do collapse-blanks Bool

. changed = false
for index in 0 .. < declarations.length
    . next = source-collapsed(language, declaration(index))
    if next
        replace(index, next)
        changed = true
= changed

────────────────────
_ do outlined SourceOutline
    - declaration ImmutableTableRow'SourceNode
    - previous SourceOutline?

. made = language.outline(declaration, previous)
outline-count += 1
reused-row-count += made.reused
= made

────────────────────
_ do shown-at SourceShown
    - place U32
    - previous SourceOutline? = null

. recent = latest
=? recent if recent != null && recent.place == place
. entry = kept[place] ?? revived(place, previous)
latest = entry
= entry

────────────────────
_ do revived SourceShown
    - place U32
    - previous SourceOutline?

for position in 0 .. < retired.length
    . entry = retired[position]
    if entry.place == place
        retired.remove(position)
        kept[place] = entry
        = entry
. made = SourceShown(place, outlined(store.node(place), previous))
kept[place] = made
= made

────────────────────
_ do retire
    - place U32

. entry = kept[place]
=? if !entry
-= kept[place]
latest = null
retired += entry
if retired.length > source-retired-capacity
    forget(retired[0])
    retired.remove(0)

────────────────────
_ do forget
    - entry SourceShown

rendered -= entry.rows.length as Size
entry.rows = Map'Size'SourceRow()
for position in 0 .. < drawn.length
    if drawn[position].place == entry.place
        drawn.remove(position)
        =

────────────────────
_ do trailed Bool
    - node ImmutableTableRow'SourceNode
    - id U32
    - trail [U32]

if node.id != id
    . found = false
    for item in store.items(node)
        if trailed(item, id, trail)
            found = true
            break
    =? false if !found
trail += node.id
= true

────────────────────
_ do row-on-trail Size
    - index Index
    - trail [U32]

. rows = rows-of(index)
. best Index = 0
. depth = trail.length
for position in 0 .. < rows.length
    . row = rows[position]
    if row.node != null
        . found = trail.find(node-id(row))
        if found != null && found < depth
            best = position
            depth = found
            if depth == 0
                break
= first-row(index) + best

────────────────────
_ do live-id-near U32
    - line Size

for distance in 0 .. < line-ids.length
    . after = line + distance
    if after < line-ids.length && home-of(line-ids[after]) != null
        = line-ids[after]
    if distance > 0 && distance <= line && home-of(line-ids[line - distance]) != null
        = line-ids[line - distance]
= 0

────────────────────
_ home-of Index?
    - id U32

|? id == 0 || id >= table.length || table[id] == 0
    null
??
    (table[id] - 1) as Index

.. held = homes
.. table = if held != null && homes-revision == revision then held else housed()

────────────────────
_ do housed U32[]

. table = U32[store.latest-id + 1]
for index in 0 .. < declarations.length
    house(table, declaration(index), (index + 1) as U32)
homes = table
homes-revision = revision
= table

────────────────────
_ do house
    - table U32[]
    - node ImmutableTableRow'SourceNode
    - home U32

table[node.id] = home
for item in store.items(node)
    house(table, item, home)

━━━━━━━━━━━━━━━━━━━━
+ do source-document-read SourceDocument ?! SexpError
    - language SourceLanguage
    - text String

. store = language.store
?! Panic("A source language reads one document")
    if store.length > 0
. marks = SexpMarks(store.latest-id)
. roots = sexp-read(text, store, marks)
. forms [ImmutableTableRow'SourceNode]
for place in roots
    forms ++= language.unpacked(store.node(place))
. places [U32]
for declaration in source-declarations(language, forms, true)
    places += declaration.index as U32
= SourceDocument(language, places, marks.line-ids(text, store, roots))

━━━━━━━━━━━━━━━━━━━━
+ do source-declarations [ImmutableTableRow'SourceNode]
    - language SourceLanguage
    - forms [ImmutableTableRow'SourceNode]
    - opens Bool

. leading [ImmutableTableRow'SourceNode]
if opens
    while leading.length < forms.length && !language.is-declaration(forms[leading.length])
        leading += forms[leading.length]
. main = language.main(leading) if opens
. declarations [ImmutableTableRow'SourceNode]
. loose [ImmutableTableRow'SourceNode]
if main
    declarations += main
for index in (if main != null then leading.length else 0) .. < forms.length
    . form = forms[index]
    if !language.is-declaration(form)
        loose += form
        continue
    if loose.length > 0
        declarations += language.section(loose)
        loose = List'(ImmutableTableRow'SourceNode)()
    declarations += form
if loose.length > 0
    declarations += language.section(loose)
. tidy [ImmutableTableRow'SourceNode]
for declaration in declarations
    tidy += source-collapsed(language, declaration) ?? declaration
= tidy

━━━━━━━━━━━━━━━━━━━━
_ SourceShown

+ place U32
+ outline SourceOutline
+ rows [Size = SourceRow]

────────────────────
+ This
    - place
    - outline

━━━━━━━━━━━━━━━━━━━━
_ do source-collapsed ImmutableTableRow'SourceNode?
    - language SourceLanguage
    - node ImmutableTableRow'SourceNode

. store = language.store
. items = store.items(node)
. drops = !language.keeps-blanks(node)
. made [ImmutableTableRow'SourceNode]
. changed = false
. follows-blank = false
for index in 0 .. < items.length
    . item = items[index]
    . is-blank = store.is-blank(item)
    . is-dropped = drops && is-blank && follows-blank
    follows-blank = is-blank
    . next ImmutableTableRow'SourceNode? = null
    if !is-dropped && store.is-list(item)
        next = source-collapsed(language, item)
    if !changed && (is-dropped || next != null)
        changed = true
        for earlier in 0 .. < index
            made += items[earlier]
    if changed && !is-dropped
        made += next ?? item
= store.with-items(node, made) if changed
