(import ./language)
(import ./rows)
(import /core/table)
(import /data/source-tree)

(type + SourceFlowRow
  (prop + node (of ImmutableTableRow SourceNode))
  (prop + indent Size)
  (fn-do + This _
    (param node _)
    (param indent _)
  )
)

(fn-do + source-flow-rows (list SourceFlowRow)
  (param language SourceLanguage)
  (param rows (list SourceOutlineRow))
  (param owner (of ImmutableTableRow SourceNode))
  (let store (. language store))
  (let flow (list SourceFlowRow))
  (for (in row rows)
    (let node (. row node))
    (let held (. row owner))
    (if (and (!= node null) (!= held null) (== (. (call (. store node) held) id) (. owner id)) (call (. language is-flow) (. row mode)))
      (+= flow (call SourceFlowRow (call (. store node) node) (. row indent)))
    )
  )
  (return flow)
)

(fn-expr + source-flow-ids (list U32)
  (param flow (list SourceFlowRow))
  (in (. each node id) flow (when (== (. each indent) 0)))
)

(fn-do + source-flow-position Size
  (param flow (list SourceFlowRow))
  (param id U32)
  (for (in position (..< 0 (. flow length)))
    (return-if position (if (== (. ([] flow position) node id) id)))
  )
  (return (. flow length))
)

(fn-expr + source-flow-holds Bool
  (param flow (list SourceFlowRow))
  (param position Size)
  (and (< (+ position 1) (. flow length)) (> (. ([] flow (+ position 1)) indent) (. ([] flow position) indent)))
)

(fn-expr + source-flow-without (list SourceFlowRow)
  (param flow (list SourceFlowRow))
  (param low Size)
  (param high Size)
  (in ([] flow each) (..< 0 (. flow length)) (when (or (< each low) (>= each high))))
)

(fn-do + source-flow-rebuild (of ImmutableTableRow SourceNode)
  (param language SourceLanguage)
  (param owner (of ImmutableTableRow SourceNode))
  (param ids (list U32))
  (param flow (list SourceFlowRow))
  (return (call source-flow-assembled language owner ids flow (call (of List Index))))
)

(fn-do + source-flow-assembled (of ImmutableTableRow SourceNode)
  (param language SourceLanguage)
  (param owner (of ImmutableTableRow SourceNode))
  (param ids (list U32))
  (param flow (list SourceFlowRow))
  (param lifted (list Index))
  (let store (. language store))
  (let kept (list (of ImmutableTableRow SourceNode)))
  (let slot (? Index) null)
  (for (in item (call (. store items) (call (. language ungrouped) owner)))
    (if (has ids (. item id))
      (if (== slot null)
        (= slot (. kept length))
      )
      (else
        (+= kept item)
      )
    )
  )
  (let built (call source-flow-built language flow))
  (let shape (call SourceFlowShape (. flow length)))
  (call source-flow-plan language built flow shape)
  (call (. shape link))
  (let position (. flow length))
  (while (> position 0)
    (-= position 1)
    (let spots (call (. shape children) position))
    (if (== (. spots length) 0)
      (continue)
    )
    (let held (list (of ImmutableTableRow SourceNode)))
    (for (in spot spots)
      (+= held ([] built spot))
    )
    (let grown (call (. language attach) ([] built position) held))
    (= ([] built position) (. grown parent))
    (for (in refused (. grown refused))
      (call (. shape lift) ([] spots refused))
      (+= lifted ([] spots refused))
    )
  )
  (let start (?? slot (. kept length)))
  (let next (list (of ImmutableTableRow SourceNode)))
  (for (in index (..< 0 start))
    (+= next ([] kept index))
  )
  (for (in position (..< 0 (. flow length)))
    (if (call (. shape is-top) position)
      (+= next ([] built position))
    )
  )
  (for (in index (..< start (. kept length)))
    (+= next ([] kept index))
  )
  (return (call (. store with-items) owner next))
)

(fn-do + source-flow-heads (list (? Index))
  (param language SourceLanguage)
  (param flow (list SourceFlowRow))
  (return (call source-flow-plan language (call source-flow-built language flow) flow (call SourceFlowShape (. flow length))))
)

(fn-do + source-flow-span (tuple Size Size)
  (param language SourceLanguage)
  (param flow (list SourceFlowRow))
  (param heads (list (? Index)))
  (param position Size)
  (let store (. language store))
  (let first (?? ([] heads position) position))
  (let level (. ([] flow first) indent))
  (let end (+ first 1))
  (while (< end (. flow length))
    (if (or (> (. ([] flow end) indent) level) (== ([] heads end) first))
      (+= end 1)
      (continue)
    )
    (let next end)
    (while (and (< next (. flow length)) (== (. ([] flow next) indent) level) (call source-flow-is-note store (. ([] flow next) node)))
      (+= next 1)
    )
    (return-if (tuple first end) (if (or (== next end) (>= next (. flow length)) (!= ([] heads next) first))))
    (blank)
    (= end next)
  )
  (return (tuple first end))
)

(fn-do + source-same-unblanked Bool
  (param store SourceStore)
  (param left (of ImmutableTableRow SourceNode))
  (param right (of ImmutableTableRow SourceNode))
  (return-if (call (. store same) left right) (if (or (not (call (. store is-list) left)) (not (call (. store is-list) right)))))
  (blank)
  (let lefts (call source-unblanked store left))
  (let rights (call source-unblanked store right))
  (return-if false (if (!= (. lefts length) (. rights length))))
  (blank)
  (for (in index (..< 0 (. lefts length)))
    (return-if false (if (not (call source-same-unblanked store ([] lefts index) ([] rights index)))))
  )
  (return true)
)

(fn-do _ source-unblanked (list (of ImmutableTableRow SourceNode))
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (let kept (list (of ImmutableTableRow SourceNode)))
  (for (in item (call (. store items) node))
    (if (not (call (. store is-blank) item))
      (+= kept item)
    )
  )
  (return kept)
)

(fn-expr _ source-flow-is-note Bool
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (or (call (. store is-blank) node) (call (. store is-comment) node))
)

(fn-do _ source-flow-built (list (of ImmutableTableRow SourceNode))
  (param language SourceLanguage)
  (param flow (list SourceFlowRow))
  (let built (list (of ImmutableTableRow SourceNode)))
  (for (in row flow)
    (+= built (call (. language detach) (. row node)))
  )
  (return built)
)

(fn-do _ source-flow-plan (list (? Index))
  (param language SourceLanguage)
  (param built (list (of ImmutableTableRow SourceNode)))
  (param flow (list SourceFlowRow))
  (param shape SourceFlowShape)
  (let stack (list Index))
  (let depths (list Size))
  (let heads (list (? Index)))
  (for (in position (..< 0 (. flow length)))
    (let indent (. ([] flow position) indent))
    (let depth (if-expr (< indent (. stack length)) indent (. stack length)))
    (if (and (> depth 0) (== depth (. stack length)) (not (call (. language can-hold) ([] built ([] stack (- depth 1))))))
      (-= depth 1)
    )
    (while (> (. stack length) depth)
      (call (. stack pop))
    )
    (+= depths depth)
    (let head (call source-flow-head language built depths heads shape position))
    (+= heads head)
    (if (!= head null)
      (= ([] built position) (call (. language as-arm) ([] built position)))
      (call (. shape nest) head position)
      (else-if (> depth 0)
        (call (. shape nest) ([] stack (- depth 1)) position)
      )
    )
    (+= stack position)
  )
  (return heads)
)

(fn-do _ source-flow-head (? Index)
  (param language SourceLanguage)
  (param built (list (of ImmutableTableRow SourceNode)))
  (param depths (list Size))
  (param heads (list (? Index)))
  (param shape SourceFlowShape)
  (param position Index)
  (let row ([] built position))
  (return-if null (if (not (call (. language is-arm) row))))
  (blank)
  (let store (. language store))
  (let depth ([] depths position))
  (let skipped (list Index))
  (let cursor position)
  (while (> cursor 0)
    (-= cursor 1)
    (if (> ([] depths cursor) depth)
      (continue)
    )
    (return-if null (if (< ([] depths cursor) depth)))
    (blank)
    (let node ([] built cursor))
    (if (or (call (. store is-blank) node) (call (. store is-comment) node))
      (+= skipped cursor)
      (continue)
    )
    (let head (?? ([] heads cursor) cursor))
    (return-if null (if (not (call (. language takes-arm) ([] built head) row))))
    (blank)
    (if (> (. skipped length) 0)
      (let keeper (if-expr (call (. language can-hold) node) cursor head))
      (for (in spot skipped)
        (call (. shape nest) keeper spot)
      )
    )
    (return head)
  )
  (return null)
)

(type _ SourceFlowShape
  (prop _ parents (list (? Index)))
  (prop _ firsts (list (? Index)))
  (prop _ lasts (list (? Index)))
  (prop _ nexts (list (? Index)))
  (fn-do + This _
    (param count Size)
    (for (in position (..< 0 count))
      (+= parents null)
      (+= firsts null)
      (+= lasts null)
      (+= nexts null)
    )
  )
  (fn-do + nest _
    (param parent Index)
    (param child Index)
    (= ([] parents child) parent)
  )
  (fn-do + link _
    (for (in child (..< 0 (. parents length)))
      (let parent ([] parents child))
      (if (== parent null)
        (continue)
      )
      (let last ([] lasts parent))
      (if (!= last null)
        (= ([] nexts last) child)
        (else
          (= ([] firsts parent) child)
        )
      )
      (= ([] lasts parent) child)
    )
  )
  (fn-do + lift _
    (param child Index)
    (= ([] parents child) null)
  )
  (fn-expr + is-top Bool
    (param position Index)
    (== ([] parents position) null)
  )
  (fn-do + children (list Index)
    (param position Index)
    (let found (list Index))
    (let child ([] firsts position))
    (while (!= child null)
      (+= found child)
      (= child ([] nexts child))
    )
    (return found)
  )
)
