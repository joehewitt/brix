(import /stream/aggregate)
(blank)
(type-line + SourceRowMode (is U8))
(prop + source-row-decoration SourceRowMode (= 0))
(prop + source-indent-columns Size (= 4))
(prop + source-divider-thick U8 (= 1))
(prop + source-divider-thin U8 (= 2))
(prop + source-divider-double U8 (= 3))
(prop + source-divider-dashed U8 (= 4))

(type + SourceSpanKind (is Union)
  (variant plain)
  (variant keyword)
  (variant definition)
  (variant identifier)
  (variant type-name)
  (variant rule)
  (variant capture)
  (variant number)
  (variant string)
  (variant operator)
  (variant punctuation)
  (variant decoration)
  (variant comment)
  (variant invalid)
  (variant parameter)
  (variant member)
  (variant member-binder)
  (variant binder)
  (variant type-definition)
  (variant exit)
  (variant tracked)
)

(type + SourceRowZone (is Union)
  (variant none)
  (variant header)
  (variant body)
  (variant loose)
  (variant preamble)
)

(type + SourceRowBlock (is Union)
  (variant none)
  (variant leaf)
  (variant steps)
  (variant text)
  (variant holder)
)

(type + SourceSpan (is Tuple)
  (prop + kind SourceSpanKind)
  (prop + text String)
  (prop + is-optional _ (= false))
)

(type + SourceOutlineRow (is Tuple)
  (prop + node (? U32))
  (prop + mode SourceRowMode)
  (prop + indent Size)
  (prop + is-invalid Bool)
  (prop + divider U8)
  (prop + owner (? U32))
  (prop + is-empty Bool)
  (prop + zone _ (= (. SourceRowZone none)))
  (prop + block _ (= (. SourceRowBlock none)))
  (prop + is-text-only _ (= false))
  (prop + is-padding _ (= false))
  (prop + is-private _ (= false))
  (prop + is-open-end _ (= false))
  (fn-expr + content-start Size :get
    (* indent source-indent-columns)
  )
  (fn-expr + is-divider Bool :get
    (> divider 0)
  )
)

(type + SourceOutlinePart (is Tuple)
  (prop + id U32)
  (prop + place U32)
  (prop + kind U8)
  (prop + mode SourceRowMode)
  (prop + zone SourceRowZone)
  (prop + first Size)
  (prop + count Size)
)

(type + SourceOutline
  (prop + place U32)
  (prop + rows (list SourceOutlineRow))
  (prop + plain (list SourceOutlineRow))
  (prop + parts (list SourceOutlinePart))
  (prop + reused Size)
  (fn-do + This _
    (param place _)
    (param rows _)
    (param plain _)
    (param parts _)
    (param reused _)
  )
)

(type + SourceRow (is Tuple)
  (prop + node (? U32))
  (prop + mode SourceRowMode)
  (prop + indent Size)
  (prop + spans (list SourceSpan))
  (prop + is-invalid Bool)
  (prop + divider U8)
  (prop + owner (? U32) (= null))
  (prop + node-id U32)
  (prop + owner-id U32)
  (prop + zone _ (= (. SourceRowZone none)))
  (prop + block _ (= (. SourceRowBlock none)))
  (prop + is-prose _ (= false))
  (prop + is-padding _ (= false))
  (prop + is-private _ (= false))
  (prop + is-open-end _ (= false))
  (fn-expr + text String :get
    (++ indentation content)
    (where
      (lazy indentation (* " " (* indent source-indent-columns)))
    )
  )
  (fn-expr + content String :get
    (call (. "" join) (in (. each text) spans))
  )
  (fn-expr + content-start Size :get
    (* indent source-indent-columns)
  )
  (fn-do + columns Size :get
    (let count content-start)
    (return-if count (if is-divider))
    (for (in span spans)
      (+= count (. span text length))
    )
    (return count)
  )
  (fn-expr + is-decoration Bool :get
    (== node null)
  )
  (fn-expr + is-divider Bool :get
    (> divider 0)
  )
)

(fn-do + source-spans-same Bool
  (param left (list SourceSpan))
  (param right (list SourceSpan))
  (return-if false (if (!= (. left length) (. right length))))
  (return (call all (..< 0 (. left length)) (:where (and (== (. ([] left each) kind) (. ([] right each) kind)) (== (. ([] left each) text) (. ([] right each) text)) (== (. ([] left each) is-optional) (. ([] right each) is-optional))))))
)
