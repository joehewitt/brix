(import ./document)
(import ./rows)
(import /core/table)

(type _ SourceFoldSpans
  (prop + heads (list Size))
  (prop + counts (list Size))
  (prop + holds (list Bool))
  (prop + folds (list Bool))
  (prop + hidden Size)
  (prop + tucked Size)
  (fn-do + This _)
)

(type + SourceFolds
  (prop + document SourceDocument)
  (prop + version U64)
  (blank)
  (prop _ collapsed (map U32 U32))
  (prop _ spans (map U32 SourceFoldSpans))
  (prop _ ends (list Size))
  (prop _ total Size)
  (prop _ tucked Size)
  (prop _ synced U64)
  (prop _ synced-version U64)
  (prop _ compactions Size)
  (prop _ is-synced _ (= false))
  (fn-do + This _
    (param document _)
  )
  (fn-do + is-plain Bool :get
    (call sync)
    (return (and (== (. collapsed length) 0) (== tucked 0)))
  )
  (fn-do + row-count Size
    (return-if (. document row-count) (if is-plain))
    (blank)
    (call sync)
    (return total)
  )
  (fn-do + shown Size
    (param row Size)
    (return-if row (if is-plain))
    (blank)
    (call sync)
    (let index (call (. document declaration-at) row))
    (return-if (- total 1) (if (>= index (. document declarations length))))
    (blank)
    (let local (- row (call (. document first-row) index)))
    (let base (if-expr (> index 0) ([] ends (- index 1)) 0))
    (let found ([] spans ([] (. document declarations) index)))
    (return-if (+ base local) (if (not found)))
    (blank)
    (let hidden Size 0)
    (for (in slot (..< 0 (. found heads length)))
      (let head ([] (. found heads) slot))
      (if (>= head local)
        (break)
      )
      (return-if (- (+ base head) hidden) (if (<= local (+ head ([] (. found counts) slot)))))
      (blank)
      (+= hidden ([] (. found counts) slot))
    )
    (return (- (+ base local) hidden))
  )
  (fn-do + actual Size
    (param display Size)
    (return-if display (if is-plain))
    (blank)
    (call sync)
    (let low Index 0)
    (let high (. ends length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< display ([] ends middle))
        (= high middle)
        (else
          (= low (+ middle 1))
        )
      )
    )
    (return-if (- (. document row-count) 1) (if (>= low (. ends length))))
    (blank)
    (let local (- display (if-expr (> low 0) ([] ends (- low 1)) 0)))
    (let found ([] spans ([] (. document declarations) low)))
    (if found
      (for (in slot (..< 0 (. found heads length)))
        (if (>= ([] (. found heads) slot) local)
          (break)
        )
        (+= local ([] (. found counts) slot))
      )
    )
    (return (+ (call (. document first-row) low) local))
  )
  (fn-expr + above Size
    (param row Size)
    (if-expr (> display 0) (call actual (- display 1)) row)
    (where
      (lazy display (call shown row))
    )
  )
  (fn-expr + below Size
    (param row Size)
    (if-expr (< (+ display 1) (call row-count)) (call actual (+ display 1)) row)
    (where
      (lazy display (call shown row))
    )
  )
  (fn-expr + is-hidden Bool
    (param row Size)
    (and (not is-plain) (!= (call actual (call shown row)) row))
  )
  (fn-expr + is-folded Bool
    (param row Size)
    (!= (call slot-at row) null)
  )
  (fn-expr + holds-invalid Bool
    (param row Size)
    (if-expr (== slot null) false ([] (. (!! ([] spans ([] (. document declarations) (call (. document declaration-at) row)))) holds) slot))
    (where
      (lazy slot (call slot-at row))
    )
  )
  (fn-expr + can-fold Bool
    (param row Size)
    (and (< index (. document declarations length)) (> (call extent (call (. document rows-of) index) (- row (call (. document first-row) index)) (. (call (. document declaration) index) id)) 0))
    (where
      (lazy index (call (. document declaration-at) row))
    )
  )
  (fn-do + headers (list Size)
    (param row Size)
    (param limit Size)
    (let found (list Size))
    (let index (call (. document declaration-at) row))
    (return-if found (if (>= index (. document declarations length))))
    (blank)
    (let base (call (. document first-row) index))
    (let rows (call (. document rows-of) index))
    (let home (. (call (. document declaration) index) id))
    (let local (- row base))
    (let inner (list Size))
    (let probe local)
    (while true
      (if (and (!= (. ([] rows probe) node) null) (not (has collapsed (call (. document node-id) ([] rows probe)))))
        (let count (call extent rows probe home))
        (if (and (> count 0) (<= local (+ probe count)))
          (+= inner (+ base probe))
        )
      )
      (if (== probe 0)
        (break)
      )
      (-= probe 1)
    )
    (let position (. inner length))
    (while (and (> position 0) (< (. found length) limit))
      (-= position 1)
      (+= found ([] inner position))
    )
    (return found)
  )
  (fn-expr + section-end Size
    (param row Size)
    (case? (>= index (. document declarations length))
      row
    )
    (default
      (+ row (call extent (call (. document rows-of) index) (- row base) (. (call (. document declaration) index) id)))
    )
    (where
      (lazy index (call (. document declaration-at) row))
      (lazy base (call (. document first-row) index))
    )
  )
  (fn-do + fold (? Size)
    (param row Size)
    (let index (call (. document declaration-at) row))
    (return-if null (if (>= index (. document declarations length))))
    (blank)
    (let base (call (. document first-row) index))
    (let rows (call (. document rows-of) index))
    (let home (. (call (. document declaration) index) id))
    (let local (- row base))
    (let probe local)
    (while true
      (let id (call (. document node-id) ([] rows probe)))
      (if (and (!= (. ([] rows probe) node) null) (not (has collapsed id)))
        (let count (call extent rows probe home))
        (if (and (> count 0) (<= local (+ probe count)))
          (call close index id home)
          (return (+ base probe))
        )
      )
      (if (== probe 0)
        (break)
      )
      (-= probe 1)
    )
    (return null)
  )
  (fn-do + collapse Bool
    (param row Size)
    (let index (call (. document declaration-at) row))
    (return-if false (if (>= index (. document declarations length))))
    (blank)
    (let rows (call (. document rows-of) index))
    (let local (- row (call (. document first-row) index)))
    (let home (. (call (. document declaration) index) id))
    (return-if false (if (== (call extent rows local home) 0)))
    (blank)
    (let id (call (. document node-id) ([] rows local)))
    (return-if false (if (has collapsed id)))
    (blank)
    (call close index id home)
    (return true)
  )
  (fn-do + unfold Bool
    (param row Size)
    (return-if false (if is-plain))
    (blank)
    (let index (call (. document declaration-at) row))
    (return-if false (if (>= index (. document declarations length))))
    (blank)
    (let id (call (. document node-id) ([] (call (. document rows-of) index) (- row (call (. document first-row) index)))))
    (return-if false (if (not (has collapsed id))))
    (blank)
    (-= ([] collapsed id))
    (-= ([] spans ([] (. document declarations) index)))
    (+= version 1)
    (return true)
  )
  (fn-do + reveal Bool
    (param row Size)
    (let changed false)
    (while (not is-plain)
      (let head (call actual (call shown row)))
      (if (or (== head row) (not (call unfold head)))
        (break)
      )
      (= changed true)
    )
    (return changed)
  )
  (fn-do + fold-all _
    (for (in index (..< 0 (. document declarations length)))
      (let rows (call (. document rows-of) index))
      (let home (. (call (. document declaration) index) id))
      (for (in position (..< 0 (. rows length)))
        (let id (call (. document node-id) ([] rows position)))
        (let is-head
          (scope (or (== id home) (and (< (+ position 1) (. rows length)) next-owned))
            (lazy next-owned (== (call (. document owner-id) ([] rows (+ position 1))) id))
          )
        )
        (if (and (!= (. ([] rows position) node) null) is-head (> (call extent rows position home) 0))
          (= ([] collapsed id) home)
        )
      )
    )
    (= spans (call (of Map U32 SourceFoldSpans)))
    (+= version 1)
  )
  (fn-do + unfold-all _
    (return-if (if is-plain))
    (blank)
    (= collapsed (call (of Map U32 U32)))
    (= spans (call (of Map U32 SourceFoldSpans)))
    (+= version 1)
  )
  (fn-do _ close _
    (param index Index)
    (param id U32)
    (param home U32)
    (= ([] collapsed id) home)
    (-= ([] spans ([] (. document declarations) index)))
    (+= version 1)
  )
  (fn-do _ slot-at (? Size)
    (param row Size)
    (return-if null (if is-plain))
    (blank)
    (call sync)
    (let index (call (. document declaration-at) row))
    (return-if null (if (>= index (. document declarations length))))
    (blank)
    (let found ([] spans ([] (. document declarations) index)))
    (return-if null (if (not found)))
    (blank)
    (let local (- row (call (. document first-row) index)))
    (for (in slot (..< 0 (. found heads length)))
      (return-if slot (if (and (== ([] (. found heads) slot) local) ([] (. found folds) slot))))
    )
    (return null)
  )
  (fn-do _ extent Size
    (param rows (list SourceOutlineRow))
    (param position Size)
    (param home U32)
    (let row ([] rows position))
    (return-if 0 (if (== (. row node) null)))
    (blank)
    (let id (call (. document node-id) row))
    (let count Size 0)
    (if (== id home)
      (= count (- (. rows length) position 1))
      (else
        (let head (call (. document store node-at) (. row node)))
        (let inside id)
        (while (< (+ position count 1) (. rows length))
          (let owner (call (. document owner-id) ([] rows (+ position count 1))))
          (if (!= owner inside)
            (if (and (!= owner id) (or (== owner 0) (not head) (== (call (. document store find) head owner) null)))
              (break)
            )
            (= inside owner)
          )
          (+= count 1)
        )
        (if (== count 0)
          (while (and (< (+ position count 1) (. rows length)) (> (. ([] rows (+ position count 1)) indent) (. row indent)))
            (+= count 1)
          )
        )
      )
    )
    (if (and (> count 0) (== (. ([] rows (+ position count)) node) null) (== (. ([] rows (+ position count)) divider) 0))
      (-= count 1)
    )
    (return-if 0 (if (== count 0)))
    (blank)
    (for (in later (.. (+ position 1) (+ position count)))
      (return-if count (if (!= (. ([] rows later) node) null)))
    )
    (return 0)
  )
  (fn-do _ sync _
    (let compacted (. document compaction-count))
    (return-if (if (and is-synced (== synced (. document revision)) same-version (== compactions compacted))))
    (blank)
    (lazy same-version (== synced-version version))
    (if (!= compactions compacted)
      (= spans (call (of Map U32 SourceFoldSpans)))
      (= compactions compacted)
    )
    (= is-synced true)
    (= synced (. document revision))
    (= synced-version version)
    (let kept (call (of Map U32 SourceFoldSpans)))
    (let made (list Size))
    (let end Size 0)
    (let tucks Size 0)
    (for (in index (..< 0 (. document declarations length)))
      (let place ([] (. document declarations) index))
      (let found (?? ([] spans place) (call spanned index)))
      (= ([] kept place) found)
      (+= end (- (call (. document first-row) (+ index 1)) (call (. document first-row) index) (. found hidden)))
      (+= tucks (. found tucked))
      (+= made end)
    )
    (= ends made)
    (= spans kept)
    (= tucked tucks)
    (= total (+ end 1))
  )
  (fn-do _ spanned SourceFoldSpans
    (param index Index)
    (let rows (call (. document rows-of) index))
    (let home (. (call (. document declaration) index) id))
    (let made (call SourceFoldSpans))
    (let position Size 0)
    (while (< position (. rows length))
      (let id (call (. document node-id) ([] rows position)))
      (if (and (!= (. ([] rows position) node) null) (has collapsed id))
        (let count (call extent rows position home))
        (if (> count 0)
          (let holds false)
          (for (in later (.. (+ position 1) (+ position count)))
            (if (. ([] rows later) is-invalid)
              (= holds true)
            )
          )
          (+= (. made heads) position)
          (+= (. made counts) count)
          (+= (. made holds) holds)
          (+= (. made folds) true)
          (+= (. made hidden) count)
          (+= position (+ count 1))
          (continue)
        )
      )
      (if (and (. ([] rows position) is-text-only) (> position 0))
        (+= (. made heads) (- position 1))
        (+= (. made counts) 1)
        (+= (. made holds) false)
        (+= (. made folds) false)
        (+= (. made hidden) 1)
        (+= (. made tucked) 1)
      )
      (+= position 1)
    )
    (return made)
  )
)
