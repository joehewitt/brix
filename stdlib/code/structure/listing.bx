(import ./document)
(import ./rows)
(import /core/table)
(import /data/source-sexp)
(import /data/source-tree)

(type + SourceLineRange (is Tuple)
  (prop + first Size)
  (prop + last Size)
)

(type + SourceListing
  (prop + document SourceDocument)
  (prop + line-count Size)
  (prop + widest Size)
  (prop + revision U64)
  (blank)
  (prop _ parts (list SourceListedPart))
  (prop _ firsts (list Index))
  (prop _ heads (list Size))
  (prop _ ends (list Size))
  (prop _ kept (map U32 SourceListedPart))
  (prop _ compactions Size)
  (prop _ seen U64)
  (prop _ was-swapped Bool)
  (fn-do + This _
    (param document _)
  )
  (fn-do + sync Bool
    (param swap (? (of ImmutableTableRow SourceNode)))
    (param at Index)
    (return-if false (if (and (> revision 0) is-current (== swap null) (not was-swapped))))
    (lazy is-current (and (== seen (. document revision)) (== compactions (. document compaction-count))))
    (if (!= compactions (. document compaction-count))
      (= kept (call (of Map U32 SourceListedPart)))
      (= compactions (. document compaction-count))
    )
    (= seen (. document revision))
    (= was-swapped (!= swap null))
    (let language (. document language))
    (let count (. document declarations length))
    (let next (list SourceListedPart))
    (let starts (list Index))
    (let held (map U32 SourceListedPart))
    (let index Index 0)
    (while (< index count)
      (let last (+ index 1))
      (if (call (. language is-section) (call (. document declaration) index))
        (while (and (< last count) (call (. language is-section) (call (. document declaration) last)))
          (+= last 1)
        )
      )
      (let places (list U32))
      (for (in position (..< index last))
        (+= places ([] (. document declarations) position))
      )
      (let is-swapped (and (!= swap null) (>= at index) (< at last)))
      (let found ([] kept ([] places 0)))
      (let part (if-expr (and (!= found null) (not is-swapped) (call is-same (. found places) places)) found (call listed index last places (only-if swap (if is-swapped)))))
      (if (not is-swapped)
        (= ([] held ([] places 0)) part)
      )
      (+= next part)
      (+= starts index)
      (= index last)
    )
    (= kept held)
    (= parts next)
    (= firsts starts)
    (call measure)
    (+= revision 1)
    (return true)
  )
  (fn-expr + line String
    (param index Size)
    (if-expr (< index ([] heads slot)) "" ([] (. ([] parts slot) lines) (- index ([] heads slot))))
    (where
      (lazy slot (call part-at index))
    )
  )
  (fn-expr + id-at U32
    (param index Size)
    (if-expr (< index ([] heads slot)) 0 ([] (. ([] parts slot) ids) (- index ([] heads slot))))
    (where
      (lazy slot (call part-at index))
    )
  )
  (fn-expr + lines-of (? SourceLineRange)
    (param declaration Index)
    (case? (or (== (. parts length) 0) (>= declaration (. document declarations length)))
      null
    )
    (case? (>= ([] heads slot) ([] ends slot))
      null
    )
    (default
      (call SourceLineRange ([] heads slot) (- ([] ends slot) 1))
    )
    (where
      (lazy slot (call part-of declaration))
    )
  )
  (fn-do + find (? SourceLineRange)
    (param id U32)
    (param declaration Index)
    (return-if null (if (or (== id 0) (== (. parts length) 0) (>= declaration (. document declarations length)))))
    (let slot (call part-of declaration))
    (let ids (. ([] parts slot) ids))
    (let first (. ids length))
    (let last (. ids length))
    (for (in offset (..< 0 (. ids length)))
      (if (== ([] ids offset) id)
        (if (== first (. ids length))
          (= first offset)
        )
        (= last offset)
      )
    )
    (return-if null (if (== first (. ids length))))
    (return (call SourceLineRange (+ ([] heads slot) first) (+ ([] heads slot) last)))
  )
  (fn-do + row-of (? Size)
    (param line Size)
    (return-if null (if (>= line line-count)))
    (let slot (call part-at line))
    (let first ([] firsts slot))
    (let count (. document declarations length))
    (return-if null (if (>= first count)))
    (let next (if-expr (< (+ slot 1) (. firsts length)) ([] firsts (+ slot 1)) count))
    (let last (if-expr (< next count) next count))
    (let ids (. ([] parts slot) ids))
    (return-if (call (. document first-row) first) (if (== (. ids length) 0)))
    (let position (if-expr (> line ([] heads slot)) (- line ([] heads slot)) 0))
    (let found (call row-with ([] ids position) first last))
    (while (and (== found null) (> position 0))
      (-= position 1)
      (= found (call row-with ([] ids position) first last))
    )
    (return (?? found (call (. document first-row) first)))
  )
  (fn-do _ row-with (? Size)
    (param id U32)
    (param first Index)
    (param last Index)
    (return-if null (if (== id 0)))
    (for (in index (..< first last))
      (let rows (call (. document rows-of) index))
      (for (in position (..< 0 (. rows length)))
        (return-if (+ (call (. document first-row) index) position) (if (== (call (. document node-id) ([] rows position)) id)))
      )
    )
    (return null)
  )
  (fn-do _ listed SourceListedPart
    (param first Index)
    (param last Index)
    (param places (list U32))
    (param swap (? (of ImmutableTableRow SourceNode)))
    (let language (. document language))
    (let store (. document store))
    (let nodes (list (of ImmutableTableRow SourceNode)))
    (for (in index (..< first last))
      (let node (call (. document declaration) index))
      (if (not (call (. language is-section) node))
        (+= nodes node)
        (continue)
      )
      (let items (call (. store items) node))
      (let start (?? (call (. language header-count) node) 0))
      (for (in position (..< start (. items length)))
        (+= nodes ([] items position))
      )
    )
    (let written (call sexp-written store nodes language swap))
    (let lines (list String))
    (let widest Size 0)
    (for (in line (call (. written text split) "\n"))
      (+= lines line)
      (if (> (. line length) widest)
        (= widest (. line length))
      )
    )
    (if (> (. lines length) 0)
      (call (. lines remove) (- (. lines length) 1))
    )
    (throw (call Panic (str "Listed " (. lines length) " lines with " (. written ids length) " ids")) (if (!= (. lines length) (. written ids length))))
    (return
      (call SourceListedPart
        (block
          (arg places)
          (arg lines)
          (arg (. written ids))
          (arg (. written starts-apart))
          (arg (. written ends-apart))
          (arg (. written ends-comment))
          (arg widest)
        )
      )
    )
  )
  (fn-do _ measure _
    (let starts (list Size))
    (let lasts (list Size))
    (let line Size 0)
    (let widest-line Size 0)
    (let previous (? SourceListedPart) null)
    (for (in part parts)
      (let before previous)
      (if (and (> (. part lines length) 0) (!= before null) (or (. part starts-apart) (. before ends-apart)) (not (. before ends-comment)))
        (+= line 1)
      )
      (+= starts line)
      (+= line (. part lines length))
      (+= lasts line)
      (if (> (. part lines length) 0)
        (= previous part)
      )
      (if (> (. part widest) widest-line)
        (= widest-line (. part widest))
      )
    )
    (= heads starts)
    (= ends lasts)
    (= line-count line)
    (= widest widest-line)
  )
  (fn-expr _ is-same Bool
    (param left (list U32))
    (param right (list U32))
    (== left right)
  )
  (fn-do _ part-at Index
    (param line Size)
    (let low Index 0)
    (let high (. ends length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< line ([] ends middle))
        (= high middle)
        (else
          (= low (+ middle 1))
        )
      )
    )
    (return low)
  )
  (fn-do _ part-of Index
    (param declaration Index)
    (let low Index 0)
    (let high (. firsts length))
    (while (< (+ low 1) high)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= ([] firsts middle) declaration)
        (= low middle)
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
)

(fn-do + source-listing-spans (list SourceSpan)
  (param text String)
  (let chars (. text codepoints))
  (let spans (list SourceSpan))
  (let at Index 0)
  (let opens false)
  (while (< at (. chars length))
    (let c ([] chars at))
    (let start at)
    (+= at 1)
    (if (== c (char " "))
      (while (and (< at (. chars length)) (== ([] chars at) (char " ")))
        (+= at 1)
      )
      (+= spans (call SourceSpan (. SourceSpanKind plain) ([] text (..< start at))))
      (continue)
    )
    (if (or (== c (char "(")) (== c (char ")")))
      (= opens (== c (char "(")))
      (+= spans (call SourceSpan (. SourceSpanKind punctuation) ([] text (..< start at))))
      (continue)
    )
    (if (== c (char ";"))
      (= at (. chars length))
      (+= spans (call SourceSpan (. SourceSpanKind comment) ([] text (..< start at))))
      (continue)
    )
    (let kind (. SourceSpanKind identifier))
    (if (== c (char "\""))
      (= kind (. SourceSpanKind string))
      (while (and (< at (. chars length)) (!= ([] chars at) (char "\"")))
        (if (== ([] chars at) (char "\\"))
          (+= at 1)
        )
        (+= at 1)
      )
      (+= at 1)
      (if (> at (. chars length))
        (= at (. chars length))
      )
      (else
        (while (and (< at (. chars length)) (!= ([] chars at) (char " ")) (!= ([] chars at) (char "(")) (!= ([] chars at) (char ")")) (!= ([] chars at) (char "\"")))
          (+= at 1)
        )
        (if opens
          (= kind (. SourceSpanKind keyword))
          (else-if (and (>= c '0') (<= c '9'))
            (= kind (. SourceSpanKind number))
          )
        )
      )
    )
    (= opens false)
    (+= spans (call SourceSpan kind ([] text (..< start at))))
  )
  (return spans)
)

(type _ SourceListedPart
  (prop + places (list U32))
  (prop + lines (list String))
  (prop + ids (list U32))
  (prop + starts-apart Bool)
  (prop + ends-apart Bool)
  (prop + ends-comment Bool)
  (prop + widest Size)
  (fn-do + This _
    (param places _)
    (param lines _)
    (param ids _)
    (param starts-apart _)
    (param ends-apart _)
    (param ends-comment _)
    (param widest _)
  )
)
