./document
./rows
/core/table
/data/source-sexp
/data/source-tree

━━━━━━━━━━━━━━━━━━━━
+ SourceLineRange is Tuple

+ first Size
+ last Size

━━━━━━━━━━━━━━━━━━━━
+ SourceListing

+ document SourceDocument
+ line-count Size
+ widest Size
+ revision U64

_ parts [SourceListedPart]
_ firsts [Index]
_ heads [Size]
_ ends [Size]
_ kept [U32 = SourceListedPart]
_ compactions Size
_ seen U64
_ was-swapped Bool

────────────────────
+ This
    - document

────────────────────
+ do sync Bool
    - swap ImmutableTableRow'SourceNode?
    - at Index

=? false if revision > 0 && is-current && swap == null && !was-swapped
.. is-current = seen == document.revision && compactions == document.compaction-count
if compactions != document.compaction-count
    kept = Map'U32'SourceListedPart()
    compactions = document.compaction-count
seen = document.revision
was-swapped = swap != null
. language = document.language
. count = document.declarations.length
. next [SourceListedPart]
. starts [Index]
. held [U32 = SourceListedPart]
. index Index = 0
while index < count
    . last = index + 1
    if language.is-section(document.declaration(index))
        while last < count && language.is-section(document.declaration(last))
            last += 1
    . places [U32]
    for position in index .. < last
        places += document.declarations[position]
    . is-swapped = swap != null && at >= index && at < last
    . found = kept[places[0]]
    . part = if found != null && !is-swapped && is-same(found.places, places) then found else listed(index, last, places, swap if is-swapped)
    if !is-swapped
        held[places[0]] = part
    next += part
    starts += index
    index = last
kept = held
parts = next
firsts = starts
measure()
revision += 1
= true

────────────────────
+ line String
    - index Size

if index < heads[slot] then "" else parts[slot].lines[index - heads[slot]]

.. slot = part-at(index)

────────────────────
+ id-at U32
    - index Size

if index < heads[slot] then 0 else parts[slot].ids[index - heads[slot]]

.. slot = part-at(index)

────────────────────
+ lines-of SourceLineRange?
    - declaration Index

|? parts.length == 0 || declaration >= document.declarations.length
    null
|? heads[slot] >= ends[slot]
    null
??
    SourceLineRange(heads[slot], ends[slot] - 1)

.. slot = part-of(declaration)

────────────────────
+ do find SourceLineRange?
    - id U32
    - declaration Index

=? null if id == 0 || parts.length == 0 || declaration >= document.declarations.length
. slot = part-of(declaration)
. ids = parts[slot].ids
. first = ids.length
. last = ids.length
for offset in 0 .. < ids.length
    if ids[offset] == id
        if first == ids.length
            first = offset
        last = offset
=? null if first == ids.length
= SourceLineRange(heads[slot] + first, heads[slot] + last)

────────────────────
+ do row-of Size?
    - line Size

=? null if line >= line-count
. slot = part-at(line)
. first = firsts[slot]
. count = document.declarations.length
=? null if first >= count
. next = if slot + 1 < firsts.length then firsts[slot + 1] else count
. last = if next < count then next else count
. ids = parts[slot].ids
=? document.first-row(first) if ids.length == 0
. position = if line > heads[slot] then line - heads[slot] else 0
. found = row-with(ids[position], first, last)
while found == null && position > 0
    position -= 1
    found = row-with(ids[position], first, last)
= found ?? document.first-row(first)

────────────────────
_ do row-with Size?
    - id U32
    - first Index
    - last Index

=? null if id == 0
for index in first .. < last
    . rows = document.rows-of(index)
    for position in 0 .. < rows.length
        =? document.first-row(index) + position if document.node-id(rows[position]) == id
= null

────────────────────
_ do listed SourceListedPart
    - first Index
    - last Index
    - places [U32]
    - swap ImmutableTableRow'SourceNode?

. language = document.language
. store = document.store
. nodes [ImmutableTableRow'SourceNode]
for index in first .. < last
    . node = document.declaration(index)
    if !language.is-section(node)
        nodes += node
        continue
    . items = store.items(node)
    . start = language.header-count(node) ?? 0
    for position in start .. < items.length
        nodes += items[position]
. written = sexp-written(store, nodes, language, swap)
. lines [String]
. widest Size = 0
for line in written.text.split("\n")
    lines += line
    if line.length > widest
        widest = line.length
if lines.length > 0
    lines.remove(lines.length - 1)
?! Panic("Listed ${lines.length} lines with ${written.ids.length} ids")
    if lines.length != written.ids.length
= SourceListedPart
    - places
    - lines
    - written.ids
    - written.starts-apart
    - written.ends-apart
    - written.ends-comment
    - widest

────────────────────
_ do measure

. starts [Size]
. lasts [Size]
. line Size = 0
. widest-line Size = 0
. previous SourceListedPart? = null
for part in parts
    . before = previous
    if part.lines.length > 0 && before != null && (part.starts-apart || before.ends-apart) && !before.ends-comment
        line += 1
    starts += line
    line += part.lines.length
    lasts += line
    if part.lines.length > 0
        previous = part
    if part.widest > widest-line
        widest-line = part.widest
heads = starts
ends = lasts
line-count = line
widest = widest-line

────────────────────
_ is-same Bool
    - left [U32]
    - right [U32]

left == right

────────────────────
_ do part-at Index
    - line Size

. low Index = 0
. high = ends.length
while low < high
    . middle = low + (high - low) / 2
    if line < ends[middle]
        high = middle
    else
        low = middle + 1
= low

────────────────────
_ do part-of Index
    - declaration Index

. low Index = 0
. high = firsts.length
while low + 1 < high
    . middle = low + (high - low) / 2
    if firsts[middle] <= declaration
        low = middle
    else
        high = middle
= low

━━━━━━━━━━━━━━━━━━━━
+ do source-listing-spans [SourceSpan]
    - text String

. chars = text.codepoints
. spans [SourceSpan]
. at Index = 0
. opens = false
while at < chars.length
    . c = chars[at]
    . start = at
    at += 1
    if c == ' '
        while at < chars.length && chars[at] == ' '
            at += 1
        spans += SourceSpan(SourceSpanKind.plain, text[start .. < at])
        continue
    if c == '(' || c == ')'
        opens = c == '('
        spans += SourceSpan(SourceSpanKind.punctuation, text[start .. < at])
        continue
    if c == ';'
        at = chars.length
        spans += SourceSpan(SourceSpanKind.comment, text[start .. < at])
        continue
    . kind = SourceSpanKind.identifier
    if c == '"'
        kind = SourceSpanKind.string
        while at < chars.length && chars[at] != '"'
            if chars[at] == '\\'
                at += 1
            at += 1
        at += 1
        if at > chars.length
            at = chars.length
    else
        while at < chars.length && chars[at] != ' ' && chars[at] != '(' && chars[at] != ')' && chars[at] != '"'
            at += 1
        if opens
            kind = SourceSpanKind.keyword
        else if c >= '0' && c <= '9'
            kind = SourceSpanKind.number
    opens = false
    spans += SourceSpan(kind, text[start .. < at])
= spans

━━━━━━━━━━━━━━━━━━━━
_ SourceListedPart

+ places [U32]
+ lines [String]
+ ids [U32]
+ starts-apart Bool
+ ends-apart Bool
+ ends-comment Bool
+ widest Size

────────────────────
+ This
    - places
    - lines
    - ids
    - starts-apart
    - ends-apart
    - ends-comment
    - widest
