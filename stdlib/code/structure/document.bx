(import ./language)
(import ./rows)
(import /core/table)
(import /data/sexp)
(import /data/source-sexp)
(import /data/source-tree)
(blank)
(prop _ source-drawn-capacity _ (= 32))
(prop _ source-retired-capacity _ (= 16))
(prop _ source-rendered-capacity Size (= 4096))

(type + SourceDocument
  (prop + language SourceLanguage)
  (prop + store SourceStore)
  (prop + declarations (list U32))
  (prop + row-count Size)
  (prop + widest-columns Size)
  (prop + render-count Size)
  (prop + outline-count Size)
  (prop + reused-row-count Size)
  (prop + compaction-count Size)
  (prop + revision U64)
  (prop + line-ids (list U32))
  (blank)
  (prop _ marks SexpMarks)
  (prop _ row-ends (list Size))
  (prop _ kept (map U32 SourceShown))
  (prop _ retired (list SourceShown))
  (prop _ drawn (list SourceShown))
  (prop _ latest (? SourceShown))
  (prop _ rendered Size)
  (prop _ settled U32)
  (prop _ base Size)
  (prop _ homes (? ([] U32)))
  (prop _ homes-revision U64)
  (prop _ viewed (map U32 (list String)))
  (fn-do + This _
    (param language _)
    (param declarations _)
    (param line-ids _)
    (param marks _)
    (lazy store (. language store))
    (let end Size 0)
    (for (in position declarations)
      (let entry (call SourceShown position (call outlined (call (. store node) position) null)))
      (= ([] kept position) entry)
      (+= end (. entry outline rows length))
      (+= row-ends end)
    )
    (= row-count (+ end 1))
    (= settled (. store mark))
    (= base (. store length))
  )
  (fn-expr + cell-count Size :get
    settled
  )
  (fn-expr + kept-row-count Size :get
    rendered
  )
  (fn-expr + kept-outline-count Size :get
    (+ (as (. kept length) Size) (. retired length))
  )
  (fn-expr + is-crowded Bool :get
    (> (. store length) (+ (* base 2) source-compact-slack))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (call (. store release))
  )
  (fn-do + shed _
    (= kept (call (of Map U32 SourceShown)))
    (= retired (call (of List SourceShown)))
    (= drawn (call (of List SourceShown)))
    (= latest null)
    (= rendered 0)
    (= homes null)
  )
  (fn-do + compact SourceMoves
    (param held (list U32))
    (let roots (list U32))
    (++= roots declarations)
    (++= roots held)
    (let moves (call (. store compact) roots))
    (for (in index (..< 0 (. declarations length)))
      (= ([] declarations index) (call (. moves place) ([] declarations index)))
    )
    (= viewed (call (of Map U32 (list String))))
    (call shed)
    (= settled (. store mark))
    (= base (. store length))
    (+= compaction-count 1)
    (return moves)
  )
  (fn-expr + declaration (of ImmutableTableRow SourceNode)
    (param index Index)
    (call (. store node) ([] declarations index))
  )
  (fn-do + declaration-at Index
    (param row Size)
    (let low Index 0)
    (let high (. row-ends length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< row ([] row-ends middle))
        (= high middle)
        (else
          (= low (+ middle 1))
        )
      )
    )
    (return low)
  )
  (fn-expr + first-row Size
    (param index Index)
    (if-expr (> index 0) ([] row-ends (- index 1)) 0)
  )
  (fn-do + row-at SourceRow
    (param row Size)
    (throw (call OutOfBoundsError (str "Source row out of bounds (" row " / " row-count ")")) (if (>= row row-count)))
    (return-if (call (. language closing-row)) (if (== (+ row 1) row-count)))
    (blank)
    (let index (call declaration-at row))
    (let position (- row (call first-row index)))
    (let entry (call shown-at ([] declarations index)))
    (let held ([] (. entry rows) position))
    (return-if held (if held))
    (blank)
    (let made (call (. language render) ([] (. entry outline rows) position)))
    (if (== (. entry rows length) 0)
      (+= drawn entry)
    )
    (= ([] (. entry rows) position) made)
    (+= rendered 1)
    (+= render-count 1)
    (let columns (. made columns))
    (if (> columns widest-columns)
      (= widest-columns columns)
    )
    (if (> (. drawn length) source-drawn-capacity)
      (call forget ([] drawn 0))
    )
    (while (and (> rendered source-rendered-capacity) (> (. drawn length) 0))
      (call forget ([] drawn 0))
    )
    (return made)
  )
  (fn-expr + rows-of (list SourceOutlineRow)
    (param index Index)
    (. (call shown-at ([] declarations index)) outline rows)
  )
  (fn-expr + node-id U32
    (param row SourceOutlineRow)
    (call (. store id-at) (. row node))
  )
  (fn-expr + owner-id U32
    (param row SourceOutlineRow)
    (call (. store id-at) (. row owner))
  )
  (fn-do + replace-row-node _
    (param row Size)
    (param replacement (of ImmutableTableRow SourceNode))
    (let index (call declaration-at row))
    (let old (. ([] (call rows-of index) (- row (call first-row index))) node))
    (throw (call Panic (str "Source row " row " presents no node")) (if (== old null)))
    (blank)
    (let next (call (. store swapped) (call declaration index) (call (. store node) old) replacement))
    (throw (call Panic (str "Source row " row " is not in its declaration")) (if (not next)))
    (blank)
    (call replace index next)
  )
  (fn-do + replace _
    (param index Index)
    (param declaration (of ImmutableTableRow SourceNode))
    (let places (call (. store settle) settled (call (of List (of ImmutableTableRow SourceNode)) (call (. language grouped) declaration))))
    (= settled (. store mark))
    (let old ([] declarations index))
    (let previous (?. ([] kept old) outline))
    (call retire old)
    (= ([] declarations index) ([] places 0))
    (call shown-at ([] places 0) previous)
    (call refresh index)
  )
  (fn-do + discard _
    (call (. store rewind) settled)
  )
  (fn-do + refresh _
    (param index Index)
    (let previous (- ([] row-ends index) (call first-row index)))
    (let count (. (call rows-of index) length))
    (if (!= count previous)
      (for (in later (..< index (. row-ends length)))
        (= ([] row-ends later) (- (+ ([] row-ends later) count) previous))
      )
      (= row-count (- (+ row-count count) previous))
    )
    (+= revision 1)
  )
  (fn-do + splice _
    (param index Index)
    (param count Size)
    (param nodes (list (of ImmutableTableRow SourceNode)))
    (let grouped (list (of ImmutableTableRow SourceNode)))
    (for (in node nodes)
      (+= grouped (call (. language grouped) node))
    )
    (let places (call (. store settle) settled grouped))
    (= settled (. store mark))
    (call restore index count places)
  )
  (fn-do + restore _
    (param index Index)
    (param count Size)
    (param places (list U32))
    (let next (list U32))
    (let ends (list Size))
    (let end Size 0)
    (let olds (list (? SourceOutline)))
    (for (in position (..< index (+ index count)))
      (+= olds (?. ([] kept ([] declarations position)) outline))
      (call retire ([] declarations position))
    )
    (for (in position (..< 0 index))
      (+= next ([] declarations position))
      (+= end (- ([] row-ends position) (call first-row position)))
      (+= ends end)
    )
    (for (in slot (..< 0 (. places length)))
      (let place ([] places slot))
      (let previous (only-if ([] olds slot) (if (< slot (. olds length)))))
      (+= next place)
      (+= end (. (call shown-at place previous) outline rows length))
      (+= ends end)
    )
    (for (in position (..< (+ index count) (. declarations length)))
      (+= next ([] declarations position))
      (+= end (- ([] row-ends position) (call first-row position)))
      (+= ends end)
    )
    (= declarations next)
    (= row-ends ends)
    (= row-count (+ end 1))
    (+= revision 1)
  )
  (fn-expr + row-of-line (? Size)
    (param line Size)
    (case? (>= line (. line-ids length))
      null
    )
    (case? (== id 0)
      null
    )
    (default
      (call row-of-node id)
    )
    (where
      (lazy id (call live-id-near line))
    )
  )
  (fn-do + row-of-node (? Size)
    (param id U32)
    (let home (call home-of id))
    (return-if null (if (== home null)))
    (blank)
    (let trail (list U32))
    (return-if null (if (not (call trailed (call declaration home) id trail))))
    (return (call row-on-trail home trail))
  )
  (fn-do + trail-around (list U32)
    (param first Index)
    (param last Index)
    (let trail (list U32))
    (for (in index (..< 0 (. declarations length)))
      (return-if trail (if (call around (call declaration index) first last trail)))
    )
    (return trail)
  )
  (fn-do + written SexpWritten
    (let nodes (list (of ImmutableTableRow SourceNode)))
    (for (in index (..< 0 (. declarations length)))
      (let node (call declaration index))
      (if (not (call (. language is-section) node))
        (+= nodes node)
        (continue)
      )
      (let items (call (. store items) node))
      (let start (?? (call (. language header-count) node) 0))
      (for (in position (..< start (. items length)))
        (+= nodes ([] items position))
      )
    )
    (return (call sexp-written store nodes language null))
  )
  (fn-expr + text String
    (. (call written) text)
  )
  (fn-do + view-rows (list SourceRow)
    (let rows (list SourceRow))
    (for (in place declarations)
      (for (in row (. (call shown-at place) outline rows))
        (+= rows (call (. language render) row))
      )
    )
    (+= rows (call (. language closing-row)))
    (return rows)
  )
  (fn-do + view-lines (list String)
    (let lines (list String))
    (let next (call (of Map U32 (list String))))
    (for (in place declarations)
      (let held
        (block
          (?? ([] viewed place) (call (of List String) (in (. (call (. language render) each) text) (. (call shown-at place) outline rows))))
        )
      )
      (= ([] next place) held)
      (++= lines held)
    )
    (+= lines (. (call (. language closing-row)) text))
    (= viewed next)
    (return lines)
  )
  (fn-do + collapse-blanks Bool
    (let changed false)
    (for (in index (..< 0 (. declarations length)))
      (let next (call source-collapsed language (call declaration index)))
      (if next
        (call replace index next)
        (= changed true)
      )
    )
    (return changed)
  )
  (fn-do _ outlined SourceOutline
    (param declaration (of ImmutableTableRow SourceNode))
    (param previous (? SourceOutline))
    (let made (call (. language outline) declaration previous))
    (+= outline-count 1)
    (+= reused-row-count (. made reused))
    (return made)
  )
  (fn-do _ shown-at SourceShown
    (param place U32)
    (param previous (? SourceOutline) (= null))
    (let recent latest)
    (return-if recent (if (and (!= recent null) (== (. recent place) place))))
    (blank)
    (let entry (?? ([] kept place) (call revived place previous)))
    (= latest entry)
    (return entry)
  )
  (fn-do _ revived SourceShown
    (param place U32)
    (param previous (? SourceOutline))
    (for (in position (..< 0 (. retired length)))
      (let entry ([] retired position))
      (if (== (. entry place) place)
        (call (. retired remove) position)
        (= ([] kept place) entry)
        (return entry)
      )
    )
    (let made (call SourceShown place (call outlined (call (. store node) place) previous)))
    (= ([] kept place) made)
    (return made)
  )
  (fn-do _ retire _
    (param place U32)
    (let entry ([] kept place))
    (return-if (if (not entry)))
    (blank)
    (-= ([] kept place))
    (= latest null)
    (+= retired entry)
    (if (> (. retired length) source-retired-capacity)
      (call forget ([] retired 0))
      (call (. retired remove) 0)
    )
  )
  (fn-do _ forget _
    (param entry SourceShown)
    (-= rendered (as (. entry rows length) Size))
    (= (. entry rows) (call (of Map Size SourceRow)))
    (for (in position (..< 0 (. drawn length)))
      (if (== (. ([] drawn position) place) (. entry place))
        (call (. drawn remove) position)
        (return)
      )
    )
  )
  (fn-do _ trailed Bool
    (param node (of ImmutableTableRow SourceNode))
    (param id U32)
    (param trail (list U32))
    (if (!= (. node id) id)
      (let found false)
      (for (in item (call (. store items) node))
        (if (call trailed item id trail)
          (= found true)
          (break)
        )
      )
      (return-if false (if (not found)))
    )
    (+= trail (. node id))
    (return true)
  )
  (fn-do _ around Bool
    (param node (of ImmutableTableRow SourceNode))
    (param first Index)
    (param last Index)
    (param trail (list U32))
    (let end (call (. marks end) (. node id)))
    (return-if false (if (and (!= end 0) (or (> (call (. marks start) (. node id)) first) (>= last end)))))
    (blank)
    (for (in item (call (. store items) node))
      (if (call around item first last trail)
        (+= trail (. node id))
        (return true)
      )
    )
    (return-if false (if (== end 0)))
    (blank)
    (+= trail (. node id))
    (return true)
  )
  (fn-do _ row-on-trail Size
    (param index Index)
    (param trail (list U32))
    (let rows (call rows-of index))
    (let best Index 0)
    (let depth (. trail length))
    (for (in position (..< 0 (. rows length)))
      (let row ([] rows position))
      (if (!= (. row node) null)
        (let found (call (. trail find) (call node-id row)))
        (if (and (!= found null) (< found depth))
          (= best position)
          (= depth found)
          (if (== depth 0)
            (break)
          )
        )
      )
    )
    (return (+ (call first-row index) best))
  )
  (fn-do _ live-id-near U32
    (param line Size)
    (for (in distance (..< 0 (. line-ids length)))
      (let after (+ line distance))
      (if (and (< after (. line-ids length)) (!= (call home-of ([] line-ids after)) null))
        (return ([] line-ids after))
      )
      (if (and (> distance 0) (<= distance line) (!= (call home-of ([] line-ids (- line distance))) null))
        (return ([] line-ids (- line distance)))
      )
    )
    (return 0)
  )
  (fn-expr _ home-of (? Index)
    (param id U32)
    (case? (or (== id 0) (>= id (. table length)) (== ([] table id) 0))
      null
    )
    (default
      (as (- ([] table id) 1) Index)
    )
    (where
      (lazy held homes)
      (lazy table (if-expr (and (!= held null) (== homes-revision revision)) held (call housed)))
    )
  )
  (fn-do _ housed ([] U32)
    (let table ([] U32 (+ (. store latest-id) 1)))
    (for (in index (..< 0 (. declarations length)))
      (call house table (call declaration index) (as (+ index 1) U32))
    )
    (= homes table)
    (= homes-revision revision)
    (return table)
  )
  (fn-do _ house _
    (param table ([] U32))
    (param node (of ImmutableTableRow SourceNode))
    (param home U32)
    (= ([] table (. node id)) home)
    (for (in item (call (. store items) node))
      (call house table item home)
    )
  )
)

(fn-do + source-document-read SourceDocument (?! SexpError)
  (param language SourceLanguage)
  (param text String)
  (let store (. language store))
  (throw (call Panic "A source language reads one document") (if (> (. store length) 0)))
  (blank)
  (let marks (call SexpMarks (. store latest-id)))
  (let roots (call sexp-read text store marks))
  (let forms (list (of ImmutableTableRow SourceNode)))
  (for (in place roots)
    (++= forms (call (. language unpacked) (call (. store node) place)))
  )
  (let places (list U32))
  (for (in declaration (call source-declarations language forms true))
    (+= places (as (. declaration index) U32))
  )
  (return (call SourceDocument language places (call (. marks line-ids) text store roots) marks))
)

(fn-do + source-declarations (list (of ImmutableTableRow SourceNode))
  (param language SourceLanguage)
  (param forms (list (of ImmutableTableRow SourceNode)))
  (param opens Bool)
  (let leading (list (of ImmutableTableRow SourceNode)))
  (if opens
    (while (and (< (. leading length) (. forms length)) (not (call (. language is-declaration) ([] forms (. leading length)))))
      (+= leading ([] forms (. leading length)))
    )
  )
  (let main (only-if (call (. language main) leading) (if opens)))
  (let declarations (list (of ImmutableTableRow SourceNode)))
  (let loose (list (of ImmutableTableRow SourceNode)))
  (if main
    (+= declarations main)
  )
  (for (in index (..< (if-expr (!= main null) (. leading length) 0) (. forms length)))
    (let form ([] forms index))
    (if (not (call (. language is-declaration) form))
      (+= loose form)
      (continue)
    )
    (if (> (. loose length) 0)
      (+= declarations (call (. language section) loose))
      (= loose (call (of List (of ImmutableTableRow SourceNode))))
    )
    (+= declarations form)
  )
  (if (> (. loose length) 0)
    (+= declarations (call (. language section) loose))
  )
  (let tidy (list (of ImmutableTableRow SourceNode)))
  (for (in declaration declarations)
    (+= tidy (?? (call source-collapsed language declaration) declaration))
  )
  (return tidy)
)

(type _ SourceShown
  (prop + place U32)
  (prop + outline SourceOutline)
  (prop + rows (map Size SourceRow))
  (fn-do + This _
    (param place _)
    (param outline _)
  )
)

(fn-do _ source-collapsed (? (of ImmutableTableRow SourceNode))
  (param language SourceLanguage)
  (param node (of ImmutableTableRow SourceNode))
  (let store (. language store))
  (let items (call (. store items) node))
  (let drops (not (call (. language keeps-blanks) node)))
  (let made (list (of ImmutableTableRow SourceNode)))
  (let changed false)
  (let follows-blank false)
  (for (in index (..< 0 (. items length)))
    (let item ([] items index))
    (let is-blank (call (. store is-blank) item))
    (let is-dropped (and drops is-blank follows-blank))
    (= follows-blank is-blank)
    (let next (? (of ImmutableTableRow SourceNode)) null)
    (if (and (not is-dropped) (call (. store is-list) item))
      (= next (call source-collapsed language item))
    )
    (if (and (not changed) (or is-dropped (!= next null)))
      (= changed true)
      (for (in earlier (..< 0 index))
        (+= made ([] items earlier))
      )
    )
    (if (and changed (not is-dropped))
      (+= made (?? next item))
    )
  )
  (return (only-if (call (. store with-items) node made) (if changed)))
)
