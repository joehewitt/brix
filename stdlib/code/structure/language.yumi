━━━━━━━━━━━━━━━━━━━━
+ source-rows [SourceRow]
    - language SourceLanguage
    - declaration ImmutableTableRow'SourceNode

** language.outline(declaration, null).rows
*> language.render(each)
|> List

━━━━━━━━━━━━━━━━━━━━
+ SourceOpened is Tuple

+ declaration ImmutableTableRow'SourceNode
+ added U32

━━━━━━━━━━━━━━━━━━━━
+ SourceReleased is Tuple

+ declaration ImmutableTableRow'SourceNode
+ released ImmutableTableRow'SourceNode

━━━━━━━━━━━━━━━━━━━━
+ SourceHeld is Tuple

+ parent ImmutableTableRow'SourceNode
+ refused [Index]

━━━━━━━━━━━━━━━━━━━━
+ SourceClosed is Union

| kept
| row(declaration ImmutableTableRow'SourceNode)
| declaration
