────────────────────
+ This
    - document

.. folds = SourceFolds(document)
if document.row-count > 0
    row = stop-at(0, false)
    column = document.row-at(row).content-start
anchor-row = row
anchor-column = column
saved = List'U32(document.declarations)
charged = document.cell-count

────────────────────
+ get row-count Size

document.row-count

────────────────────
+ get is-modified Bool

is-dirty || !is-saved()

────────────────────
+ get has-selection Bool

anchor-row != row || anchor-column != column

────────────────────
+ get first-selected-row Size

if row < anchor-row then row else anchor-row

────────────────────
+ get last-selected-row Size

if row > anchor-row then row else anchor-row

────────────────────
+ get selection-start Size

|? row == anchor-row
    if column < anchor-column then column else anchor-column
|? row < anchor-row
    column
??
    anchor-column

────────────────────
+ get selection-end Size

|? row == anchor-row
    if column > anchor-column then column else anchor-column
|? row > anchor-row
    column
??
    anchor-column

────────────────────
+ row-at SourceRow
    - index Size

if is-dirty && index == row then dirty-row else document.row-at(index)

────────────────────
+ do view-text String

. lines = document.view-lines()
if is-dirty && row < lines.length
    lines[row] = dirty-row.text
= "${"\n".join(lines)}\n"

────────────────────
+ do collapse

anchor-row = row
anchor-column = column

────────────────────
+ do place
    - target-row Size
    - target-column Size
    - extends = false

=? if document.row-count == 0
. next = if target-row < document.row-count then target-row else document.row-count - 1
if next != row
    . home = row
    . count = document.row-count
    commit()
    discard-placeholder()
    . now = document.row-count
    if next > home && now < count
        . lost = count - now
        next = if next >= lost then next - lost else 0
    else if next > home
        next += now - count
    row = if next < now then next else now - 1
column = clamped(target-column)
goal-column = column
if !extends
    collapse()

────────────────────
+ do move-left

=? if document.row-count == 0
. current = row-at(row)
if column > current.content-start
    column -= 1
else if folds.shown(row) > 0
    commit()
    row = stop-at(folds.above(row), true)
    column = row-at(row).columns
goal-column = column

────────────────────
+ do move-right

=? if document.row-count == 0
if column < row-at(row).columns
    column += 1
else if folds.shown(row) + 1 < folds.row-count()
    commit()
    row = stop-at(folds.below(row), false)
    column = row-at(row).content-start
goal-column = column

────────────────────
+ do move-token-left

=? if document.row-count == 0
. current = row-at(row)
. offset = column - current.content-start
if offset == 0
    move-left()
    =
column = current.content-start + token-start(current, offset)
goal-column = column

────────────────────
+ do move-token-right

=? if document.row-count == 0
. current = row-at(row)
if column >= current.columns
    move-right()
    =
. offset = column - current.content-start
. target = current.columns - current.content-start
for token in source-tokens(current)
    if token.end > offset
        target = token.end
        break
column = current.content-start + target
goal-column = column

────────────────────
+ do move-up
    - count Size = 1

=? if folds.shown(row) == 0
commit()
. display = folds.shown(row)
row = stop-at(folds.actual(if display > count then display - count else 0), true)
column = clamped(goal-column)

────────────────────
+ do move-down
    - count Size = 1

=? if folds.shown(row) + 1 >= folds.row-count()
commit()
. display = folds.shown(row)
. last = folds.row-count() - 1
row = stop-at(folds.actual(if display + count < last then display + count else last), false)
column = clamped(goal-column)

────────────────────
+ do move-to-line-start

=? if document.row-count == 0
column = row-at(row).content-start
goal-column = column

────────────────────
+ do move-to-line-end

=? if document.row-count == 0
column = row-at(row).columns
goal-column = column

────────────────────
+ do move-to-start

place(stop-at(0, false), 0, true)

────────────────────
+ do move-to-end

=? if document.row-count == 0
. last = document.row-count - 1
place(last, document.row-at(last).columns, true)

────────────────────
+ do select-all

=? if document.row-count == 0
move-to-end()
anchor-row = 0
anchor-column = document.row-at(0).content-start

────────────────────
+ do select-token

=? if document.row-count == 0
. current = row-at(row)
=? if current.is-divider
. offset = column - current.content-start
. picked SourceToken? = null
for token in source-tokens(current)
    if offset >= token.start && offset <= token.end && (picked == null || offset < token.end)
        picked = token
        if offset < token.end
            break
=? if !picked
anchor-row = row
anchor-column = current.content-start + picked.start
column = current.content-start + picked.end
goal-column = column

────────────────────
+ do select-range
    - target-row Size
    - start Size
    - end Size

place(target-row, start)
column = clamped(end)
goal-column = column

────────────────────
+ can-edit Bool
    - index Size

index < document.row-count && is-editable(row-at(index))

────────────────────
+ in-preamble Bool
    - id U32

preamble-rows has id

────────────────────
+ is-padding Bool
    - index Size

index + 1 < document.row-count && shown.node == null && !shown.is-divider && (shown.is-padding || is-gap)

.. shown = row-at(index)
.. next = folds.below(index)
.. is-gap = shown.zone != SourceRowZone.body && next != index && !is-open-end(index) && (row-at(next).is-divider || is-open-end(next) || is-blank-line(next))

────────────────────
+ is-blank-line Bool
    - index Size

index < document.row-count && shown.node == null && !shown.is-divider && shown.zone == SourceRowZone.body

.. shown = row-at(index)

────────────────────
+ is-block-head Bool
    - index Size

index > 0 && index < document.row-count && (divider == source-divider-thick || divider == source-divider-thin)

.. divider = row-at(index - 1).divider

────────────────────
+ is-skipped Bool
    - index Size

is-padding(index) || (index + 1 < document.row-count && (divider == source-divider-thick || divider == source-divider-thin || divider == source-divider-dashed))

.. divider = row-at(index).divider

────────────────────
+ is-open-end Bool
    - index Size

index + 1 < document.row-count && row-at(index).is-open-end

────────────────────
+ do stop-at Size
    - index Size
    - upward Bool

. at = index
. up = upward
while is-skipped(at)
    if up && folds.shown(at) > 0
        at = folds.above(at)
    else if folds.shown(at) + 1 < folds.row-count()
        at = folds.below(at)
        up = false
    else
        break
= at

────────────────────
+ do fold Bool

=? false if folds.fold(row) == null
cover()
= true

────────────────────
+ do unfold Bool

= folds.unfold(row)

────────────────────
+ do toggle-fold Bool
    - target Size

=? true if folds.unfold(target)
=? false if !folds.collapse(target)
cover()
= true

────────────────────
+ do fold-all

folds.fold-all()
cover()

────────────────────
+ do unfold-all

folds.unfold-all()

────────────────────
+ do replace-rows SourceRewrite
    - targets [Size]
    - texts [String]

commit()
=? SourceRewrite(0, 0) if targets.length == 0
. low = document.declaration-at(targets[0])
. high = document.declaration-at(targets[targets.length - 1])
. old [U32]
for index in low .. < high + 1
    old += document.declarations[index]
pending = SourceUndo(low, old, high - low + 1, row, column)
. language = document.language
. changed Size = 0
. held Size = 0
. position = targets.length
while position > 0
    position -= 1
    . target = targets[position]
    . shown = document.row-at(target)
    if !is-editable(shown)
        continue
    document.discard()
    . next = rewritten(shown, texts[position])
    if !next
        continue
    if language.is-invalid(next, shown.mode)
        held += 1
    document.replace-row-node(target, next)
    changed += 1
if changed == 0
    pending = null
    = SourceRewrite(0, 0)
settle()
finish()
= SourceRewrite(changed, held)

────────────────────
+ do toggle-comment Bool

. targets [Size]
. texts [String]
for index in first-selected-row .. < last-selected-row + 1
    if can-edit(index)
        targets += index
        texts += row-at(index).text
=? false if targets.length == 0
. changed = code-toggled-comments(texts, document.language.comment-marker)
=? false if changed == texts
. first = first-selected-row
. last = last-selected-row
. keeps-selection = has-selection
. old-row = row
. old-column = column
=? false if replace-rows(targets, changed).changed == 0
if keeps-selection
    place(first, 0)
    place(last, row-at(last).text.length, true)
else
    . shift = (row-at(old-row).text.length as Int) - (texts[0].length as Int)
    place(old-row, max(0, (old-column as Int) + shift))
= true

────────────────────
+ do selected-text String

= "\n".join(selected-lines())

────────────────────
+ do clipboard-text String

. lines = selected-lines()
. first = first-selected-row
. last = last-selected-row
=? "\n".join(lines) if lines.length < 2 || selection-start > row-at(first).content-start || !is-block-head(first)
. is-ended = selection-end <= row-at(last).content-start
if is-ended && is-block-head(last)
    lines.remove(lines.length - 2)
else if !is-ended && selection-end >= row-at(last).columns && ends-block(last)
    lines += ""
lines.insert(row-at(first - 1).text, 0)
= "\n".join(lines)

────────────────────
_ do ends-block Bool
    - index Size

for below in index + 1 .. < document.row-count
    . shown = row-at(below)
    =? true if shown.divider == source-divider-thick || shown.divider == source-divider-thin
    =? false if shown.node != null
= true

────────────────────
_ do selected-lines [String]

. parts [String]
=? parts if !has-selection
. first = first-selected-row
. last = last-selected-row
. is-whole = last > first && selection-start <= row-at(first).content-start
. is-ended = last > first && selection-end <= row-at(last).content-start
for index in first .. < last + 1
    . text = row-at(index).text
    . low = if index == first && !is-whole then selection-start else 0
    . high = if index != last then text.length else if is-ended then 0 else selection-end
    if high > text.length
        high = text.length
    if low > high
        low = high
    parts += text[low .. < high]
= parts

────────────────────
+ do insert Bool
    - text String

=? paste(text) if text.find("\n") != null
if has-selection
    . first = first-selected-row
    . last = last-selected-row
    =? splice-text(first, selection-start, last, selection-end, text) if first != last
    delete-selection()
=? false if document.row-count == 0 || text.length == 0
if !is-dirty && document.row-at(row).node == null
    =? false if !open-here()
. current = row-at(row)
=? false if !is-editable(current)
. offset = column - current.content-start
. content = current.content
retype(current, content[... offset] ++ text ++ content[offset ...])
column += text.length
goal-column = column
collapse()
= true

────────────────────
+ do paste Bool
    - text String

. lines [String]
for line in text.split("\n")
    lines += if line.length > 0 && line.ends-with("\r") then line[... line.length - 1] else line
=? false if lines.length == 0
=? insert(lines[0]) if lines.length == 1
=? false if document.row-count < 2
. first = if has-selection then first-selected-row else row
. last = if has-selection then last-selected-row else row
. start = if has-selection then selection-start else column
. end = if has-selection then selection-end else column
. lead Size = 0
while lead < lines.length && lines[lead].trim().length == 0
    lead += 1
. divider = if lead < lines.length then document.language.divider-line(lines[lead]) else 0
. is-blocks = divider != 0
. is-verbatim = some(lines) • where document.language.divider-line(each) != 0
for _ in 0 .. < (if is-blocks then lead else 0)
    lines.remove(0)
if is-blocks
    if !has-selection && row-at(first).zone == SourceRowZone.header
        while first > 0 && !is-block-head(first)
            first -= 1
        last = first
        start = 0
        end = 0
    else if !has-selection && !is-line-start(first, start) && first + 1 < document.row-count
        first += 1
        last = first
        start = 0
        end = 0
    if is-line-start(first, start) && is-block-head(first)
        first -= 1
        start = 0
        if !has-selection
            last = first
            end = 0
    if has-selection && last > first + 1 && is-line-start(last, end) && is-block-head(last)
        last -= 1
        end = 0
    . outside = if divider == source-divider-thick && !has-selection then members-end(first) else null
    if outside
        first = outside
        last = first
. shown = row-at(first)
. is-ruled = !has-selection && !is-editable(shown) && shown.content.length > 0
. is-closing = is-ruled && first + 1 == document.row-count
if is-blocks
    if is-ruled && lines[lines.length - 1].length == 0
        lines.remove(lines.length - 1)
    else if !is-ruled && lines[lines.length - 1].length > 0 && (!has-selection || is-line-start(last, end) || end < row-at(last).text.length)
        lines += ""
if is-closing
    first -= 1
    last = first
    start = row-at(first).text.length
    end = start
else if is-ruled
    start = 0
    end = 0
. opening = row-at(first).text
. reach = if start < opening.length then start else opening.length
. left = if is-ruled || is-verbatim then "" else opening[... reach]
. placed = if is-verbatim then "\n".join(lines) else source-placed(lines, left)
. is-lines = whole-lines && (!has-selection || is-line-start(last, end))
    .. whole-lines = !is-ruled && lines[lines.length - 1].length == 0 && is-line-start(first, start)
=? splice-text(first, 0, last, 0, left ++ placed) if is-lines
. written = if is-closing || (is-blocks && !is-line-start(first, start)) then "\n" ++ placed else if is-ruled then placed ++ "\n" else placed
= splice-text(first, start, last, end, written)

────────────────────
_ do members-end Size?
    - index Size

. is-member = false
for below in index .. < document.row-count
    . shown = row-at(below)
    =? null if shown.divider == source-divider-thick && !is-member
    =? below if shown.divider == source-divider-thick
    is-member = is-member || shown.divider == source-divider-thin
=? null if !is-member
= document.row-count - 1

────────────────────
+ do delete-backward Bool

=? delete-selection() if has-selection
=? false if document.row-count == 0
. current = row-at(row)
. offset = column - current.content-start
=? join-up() if offset == 0 || current.node == null
=? false if !is-editable(current)
. content = current.content
retype(current, content[... offset - 1] ++ content[offset ...])
column -= 1
goal-column = column
collapse()
= true

────────────────────
+ do delete-forward Bool

=? delete-selection() if has-selection
=? false if document.row-count == 0
. current = row-at(row)
. offset = column - current.content-start
. content = current.content
=? join-down() if offset >= content.length
=? false if !is-editable(current)
retype(current, content[... offset] ++ content[offset + 1 ...])
collapse()
= true

────────────────────
