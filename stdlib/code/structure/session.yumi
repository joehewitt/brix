        flow[spot].node = store.with-id(store.raw(text, List'(ImmutableTableRow'SourceNode)()), node.id)
        is-moved = true
=? null if !is-moved
. lifted [Index]
. grown = rebuilt(index, owner, source-flow-ids(flow), flow, lifted)
=? null if lifted.length > 0
= grown

────────────────────
_ do is-swallowed Bool
    - flow [SourceFlowRow]
    - spot Index

. language = document.language
. node = flow[spot].node
=? false if document.store.raw-text(node) != null || !language.is-arm(node)
=? false if language.as-arm(node).index != node.index
. cursor = spot
while cursor > 0
    cursor -= 1
    =? language.takes-arm(flow[cursor].node, node) if flow[cursor].indent < flow[spot].indent
= false

────────────────────
_ do parent-in ImmutableTableRow'SourceNode?
    - root ImmutableTableRow'SourceNode
    - target ImmutableTableRow'SourceNode

for item in document.store.items(root)
    =? root if item.index == target.index
    . found = parent-in(item, target)
    =? found if found
= null

────────────────────
_ is-saved Bool

document.declarations == saved

────────────────────
_ is-line-start Bool
    - index Size
    - at Size

at <= row-at(index).content-start

────────────────────
_ do stays-invalid Bool
    - shown SourceRow

=? false if !shown.is-invalid || typed == shown.content
document.discard()
. next = rewritten(shown, typed)
. stays = next != null && document.language.is-invalid(next, shown.mode)
document.discard()
= stays

────────────────────
_ do promote Bool

=? false if !is-dirty
. shown = document.row-at(row)
=? false if shown.node == null
. index = document.declaration-at(row)
=? false if index >= document.declarations.length
. lead = document.language.lead-for(document.declaration(index), shown, typed)
=? false if !lead
. next = row + 1 < document.row-count && shares-flow(shown, document.row-at(row + 1))
. spaced = if next && document.row-at(row + 1).content.length > 0 then "\n" else ""
. home = row
splice-text(row, 0, row, row-at(row).text.length, "$lead$typed$spaced")
. head = typed.trim()
for spot in home .. < min(home + 8, document.row-count)
    . landed = document.row-at(spot)
    if landed.node != null && landed.content == head
        row = spot
        column = landed.content-start + landed.content.length
        goal-column = column
        collapse()
        = true
= true

────────────────────
_ do discard-placeholder

=? if row >= document.row-count
. index = document.declaration-at(row)
=? if index >= document.declarations.length
begin(index)
match document.language.leave-row(document.declaration(index), document.row-at(row))
    | .kept
        pending = null
        =
    | .declaration
        pending = SourceUndo(index, List'U32(document.declarations[index]), 0, row, column)
        document.splice(index, 1, List'(ImmutableTableRow'SourceNode)())
    | .row(next)
        document.replace(index, next)
settle()
finish()

────────────────────
_ do rereads Bool
    - shown SourceRow

. node = document.store.node-at(shown.node)
=? false if !node || typed == shown.content
= document.language.rereads(node, shown.mode, typed)

────────────────────
_ do cover

=? if !folds.is-hidden(row)
commit()
row = folds.actual(folds.shown(row))
column = clamped(goal-column)
collapse()

────────────────────
_ is-editable Bool
    - shown SourceRow

shown.node != null && document.language.is-editable(shown.mode)

────────────────────
_ do retype
    - shown SourceRow
    - text String

typed = text
. language = document.language
. spans = language.highlight(text, shown.mode)
. was-invalid = document.row-at(row).is-invalid
document.discard()
. next = rewritten(shown, text)
. is-invalid = if next then language.is-invalid(next, shown.mode) else was-invalid
dirty-row = SourceRow
    - shown.node
    - shown.mode
    - shown.indent
    - spans
    - is-invalid
    - 0
    - shown.owner
    - shown.node-id
    - shown.owner-id
    - shown.zone
    - shown.block
is-dirty = true
revision += 1
document.discard()

────────────────────
_ clamped Size
    - wanted Size

clamped-at(row, wanted)

────────────────────
_ clamped-at Size
    - index Size
    - wanted Size

|? index >= document.row-count
    0
|? wanted < start
    start
|? wanted > end
    end
??
    wanted

.. shown = row-at(index)
.. start = shown.content-start
.. end = shown.columns

────────────────────
_ do settle

. count = document.row-count
if row >= count
    row = if count > 0 then count - 1 else 0
if count > 0
    row = stop-at(row, false)
column = clamped(column)
goal-column = column
collapse()

────────────────────
_ do begin
    - index Index

pending = SourceUndo(index, List'U32(document.declarations[index]), 1, row, column)

────────────────────
_ do finish

. entry = pending
if entry
    . count = document.cell-count
    entry.cells = if count > charged then count - charged else 0
    undos += entry
    redos = List'SourceUndo()
    pending = null
    trim()
charged = document.cell-count
revision += 1
if document.is-crowded
    compact()

────────────────────
_ do trim

. total Size = 0
. keep = undos.length
while keep > 0
    . cells = undos[keep - 1].cells
    if keep < undos.length && total + cells > undo-budget
        break
    total += cells
    keep -= 1
=? if keep == 0
. kept [SourceUndo]
for position in keep .. < undos.length
    kept += undos[position]
undos = kept

────────────────────
_ do compact

. held [U32]
for entry in undos
    held ++= entry.old
for entry in redos
    held ++= entry.old
held ++= saved
. moves = document.compact(held)
for entry in undos
    entry.move(moves)
for entry in redos
    entry.move(moves)
for position in 0 .. < saved.length
    saved[position] = moves.place(saved[position])
charged = document.cell-count

────────────────────
_ do exchange
    - entry SourceUndo
    - target [SourceUndo]

. current [U32]
for position in entry.index .. < entry.index + entry.count
    current += document.declarations[position]
. reverse = SourceUndo(entry.index, current, entry.old.length, row, column)
reverse.cells = entry.cells
target += reverse
document.restore(entry.index, entry.count, entry.old)
row = entry.row
column = entry.column
settle()
revision += 1

────────────────────
_ owner-of ImmutableTableRow'SourceNode
    - index Index
    - shown SourceRow

document.store.node-at(shown.owner) ?? document.declaration(index)

────────────────────
_ shares-flow Bool
    - upper SourceRow
    - lower SourceRow

|? upper.node == null || lower.node == null
    false
|? !language.is-flow(upper.mode) || !language.is-flow(lower.mode)
    false
??
    upper.owner-id == lower.owner-id

.. language = document.language

────────────────────
_ flow-of [SourceFlowRow]
    - index Index
    - owner ImmutableTableRow'SourceNode

source-flow-rows(document.language, document.rows-of(index), owner)

────────────────────
_ do flow-content String
    - index Index
    - owner U32
    - id U32

. language = document.language
. rows = document.rows-of(index)
for position in 0 .. < rows.length
    . shown = rows[position]
    . is-held = document.node-id(shown) == id && document.owner-id(shown) == owner
    if shown.node != null && is-held && language.is-flow(shown.mode)
        = document.row-at(document.first-row(index) + position).content
= ""

────────────────────
_ do apply
    - index Index
    - owner ImmutableTableRow'SourceNode
    - ids [U32]
    - flow [SourceFlowRow]

document.replace(index, rebuilt(index, owner, ids, flow, List'Index()))

────────────────────
_ do lodge ImmutableTableRow'SourceNode
    - index Index
    - owner ImmutableTableRow'SourceNode
    - ids [U32]
    - flow [SourceFlowRow]
    - slot Size
    - is-after Bool
    - is-blank Bool
    - was-typed Bool

. language = document.language
. expected ImmutableTableRow'SourceNode? = null
. refused Size? = null
. at = slot
while true
    . lifted [Index]
    . grown = rebuilt(index, owner, ids, flow, lifted)
    if refused == null && (lifted.length > 0 || (is-blank && was-typed))
        . apart [Index]
        expected = language.grouped(without(index, owner, ids, flow, at, apart))
        refused = apart.length
    . is-kept = lifted.length <= (refused ?? 0)
    . base = expected ?? document.declaration(index)
    =? grown if is-kept && (!is-blank || source-same-unblanked(document.store, language.grouped(grown), base))
    . next = moved(flow, at, is-after)
    =? grown if next == null
    at = next

────────────────────
_ do without ImmutableTableRow'SourceNode
    - index Index
    - owner ImmutableTableRow'SourceNode
    - ids [U32]
    - flow [SourceFlowRow]
    - at Size
    - lifted [Index]

. row = flow[at]
flow.remove(at)
. tree = rebuilt(index, owner, ids, flow, lifted)
flow.insert(row, at)
= tree

────────────────────
_ do moved Size?
    - flow [SourceFlowRow]
    - at Size
    - is-after Bool

. language = document.language
. row = flow[at]
. level = row.indent
flow.remove(at)
. heads = source-flow-heads(language, flow)
if is-after
    . sibling = at
    while sibling > 0 && flow[sibling - 1].indent > level
        sibling -= 1
    if sibling > 0 && flow[sibling - 1].indent == level
        . end = source-flow-span(language, flow, heads, sibling - 1)[1]
        if end > at
            flow.insert(row, end)
            = end
else if at < flow.length && flow[at].indent == level && heads[at] != null
    . start = source-flow-span(language, flow, heads, at)[0]
    flow.insert(row, start)
    = start
. parent = at
while parent > 0 && flow[parent - 1].indent >= level
    parent -= 1
if parent == 0
    flow.insert(row, at)
    = null
. span = source-flow-span(language, flow, heads, parent - 1)
. next = if is-after then span[1] else span[0]
row.indent = flow[parent - 1].indent
flow.insert(row, next)
= next

────────────────────
_ do rebuilt ImmutableTableRow'SourceNode
    - index Index
    - owner ImmutableTableRow'SourceNode
    - ids [U32]
    - flow [SourceFlowRow]
    - lifted [Index]

. holder = document.language.flow-holder(owner)
. next = source-flow-assembled(document.language, holder, ids, flow, lifted)
. grown = document.store.swapped(document.declaration(index), holder, next)
?! Panic("A flow owner is not in its declaration")
    if !grown
= grown

────────────────────
_ do seek
    - index Index
    - id U32
    - offset Size

. rows = document.rows-of(index)
for position in 0 .. < rows.length
    if rows[position].node != null && document.node-id(rows[position]) == id
        row = document.first-row(index) + position
        column = clamped(rows[position].content-start + offset)
        goal-column = column
        collapse()
        =
settle()

────────────────────
_ do header-for ImmutableTableRow'SourceNode
    - text String
    - mode SourceRowMode
    - holds Bool

. language = document.language
. parsed = language.parse(text, mode)
if parsed
    =? parsed if !holds || language.can-hold(parsed)
= document.store.raw(text, List'(ImmutableTableRow'SourceNode)())

────────────────────
_ do header-as ImmutableTableRow'SourceNode
    - id U32
    - text String
    - mode SourceRowMode
    - holds Bool

= document.store.with-id(header-for(text, mode, holds), id)

────────────────────
_ do leading-spaces Size
    - text String

. count Size = 0
for c in text.codepoints
    if c != ' '
        break
    count += 1
= count

────────────────────
_ do token-start Size
    - shown SourceRow
    - offset Size

. start Size = 0
for token in source-tokens(shown)
    if token.start < offset
        start = token.start
= start

────────────────────
_ do join-up Bool

. current = row-at(row)
=? splice-text(row - 1, row-at(row - 1).text.length, row, 0, "") if row > 0 && unparsed
.. unparsed = document.language.is-unparsed(current.mode)
commit()
. shown = document.row-at(row)
. store = document.store
. node = store.node-at(shown.node)
=? back-over() if !node
. language = document.language
. index = document.declaration-at(row)
=? close(index, shown) if !language.is-flow(shown.mode)
. owner = owner-of(index, shown)
. flow = flow-of(index, owner)
. ids = source-flow-ids(flow)
. home = shown.node-id
. position = source-flow-position(flow, home)
=? false if position >= flow.length
if store.is-blank(node)
    . above U32 = if position > 0 then flow[position - 1].node.id else 0
    begin(index)
    apply(index, owner, ids, source-flow-without(flow, position, position + 1))
    if position > 0
        seek(index, above, source-far-column)
    else
        settle()
    finish()
    = true
=? false if position == 0
. upper = flow[position - 1]
. held = upper.node.id
begin(index)
if store.is-blank(upper.node)
    apply(index, owner, ids, source-flow-without(flow, position - 1, position))
    seek(index, home, 0)
else
    . above = flow-content(index, owner.id, held)
    . holds = position + 1 < flow.length && flow[position + 1].indent > upper.indent
    upper.node = header-as(held, joined(above, shown.content, shown.mode), shown.mode, holds)
    apply(index, owner, ids, source-flow-without(flow, position, position + 1))
    seek(index, held, above.length)
finish()
= true

────────────────────
_ do joined String
    - above String
    - below String
    - mode SourceRowMode

. close = above ++ below
. spaced = "$above $below"
= if reads(close, mode) || !reads(spaced, mode) then close else spaced

────────────────────
_ do reads Bool
    - text String
    - mode SourceRowMode

. parsed = document.language.parse(text, mode)
= parsed != null && !document.language.is-invalid(parsed, mode)

────────────────────
_ do back-over Bool

=? false if row == 0
. target = row - 1
while target > 0 && document.row-at(target).node == null
    target -= 1
. shown = document.row-at(target)
. node = document.store.node-at(shown.node)
if node && document.store.is-blank(node) && document.language.is-flow(shown.mode)
    . index = document.declaration-at(target)
    . owner = owner-of(index, shown)
    . flow = flow-of(index, owner)
    . ids = source-flow-ids(flow)
    . position = source-flow-position(flow, shown.node-id)
    begin(index)
    apply(index, owner, ids, source-flow-without(flow, position, position + 1))
    row -= 1
    settle()
    finish()
    = true
row = stop-at(row - 1, true)
if target == row
    column = source-far-column
settle()
= true

────────────────────
_ do join-down Bool

. current = row-at(row)
=? splice-text(row, current.text.length, row + 1, 0, "") if row + 2 < document.row-count && unparsed
.. unparsed = document.language.is-unparsed(current.mode)
