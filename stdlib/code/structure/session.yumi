    = true
. released = document.language.release(declaration, shown)
=? false if !released
. id = released.released.id
pending = SourceUndo(index, List'U32(document.declarations[index]), 2, row, column)
document.splice
    - index
    - 1
    - List'(ImmutableTableRow'SourceNode)(released.declaration, released.released)
land(index + 1, id, is-bare, offset)
= true

────────────────────
_ do land
    - index Index
    - id U32
    - is-bare Bool
    - offset Size

seek(index, id, offset)
if is-bare && row > 0
    row -= 1
    settle()
finish()

────────────────────
_ do splice-text Bool
    - first Size
    - start Size
    - last Size
    - end Size
    - text String

. count = document.row-count
=? false if count < 2
. closing = count - 1
. head-row = if first < closing then first else closing - 1
. head-column = if first < closing then start else row-at(head-row).text.length
. tail-row = if last < closing then last else closing - 1
. tail-column = if last < closing then end else row-at(tail-row).text.length
. low = document.declaration-at(head-row)
if low > 0 && head-row == document.first-row(low)
    low -= 1
. high = document.declaration-at(tail-row)
. top = document.first-row(low)
. bottom = document.first-row(high + 1)
. opening = row-at(head-row).text
. ending = row-at(tail-row).text
. reach = if head-column < opening.length then head-column else opening.length
. resume = if tail-column < ending.length then tail-column else ending.length
. left = opening[... reach]
. right = ending[resume ...]
. parts [String]
for index in top .. < head-row
    parts += row-at(index).text
parts += left ++ text ++ right
for index in tail-row + 1 .. < bottom
    parts += row-at(index).text
. olds [String]
for index in top .. < bottom
    olds += document.row-at(index).text
. next = "\n".join(parts)
. after = count - tail-row
is-dirty = false
revision += 1
if next == "\n".join(olds)
    row = tail-row
    column = clamped(tail-column)
    goal-column = column
    collapse()
    = true
document.discard()
. language = document.language
. made = source-declarations(language, language.read(next), low == 0)
. old [U32]
for index in low .. < high + 1
    old += document.declarations[index]
pending = SourceUndo(low, old, made.length, row, column)
document.splice(low, high - low + 1, made)
. now = document.row-count
row = stop-at(if now > after then now - after else 0, false)
. landed = row-at(row).text.length
column = clamped(if landed > right.length then landed - right.length else 0)
goal-column = column
collapse()
finish()
= true

────────────────────
_ do reindent Bool
    - shown SourceRow
    - deeper Bool

. offset = column
. lead = leading-spaces(shown.text)
. removed = if deeper then 0 else outdent-columns
    .. outdent-columns = if lead < source-indent-columns then lead else source-indent-columns
=? false if !deeper && removed == 0
splice-text(row, 0, row, removed, if deeper then " " * source-indent-columns else "")
. moved = if deeper then indented else if offset > removed then offset - removed else 0
    .. indented = offset + source-indent-columns
column = clamped(moved)
goal-column = column
collapse()
= true

────────────────────
_ do rewritten ImmutableTableRow'SourceNode?
    - shown SourceRow
    - text String

= remade(document.store.node(shown.node!), shown.mode, text)

────────────────────
_ do remade ImmutableTableRow'SourceNode?
    - old ImmutableTableRow'SourceNode
    - mode SourceRowMode
    - text String

. language = document.language
. store = document.store
. body = language.children(old)
. read = language.parse(text, mode)
. parsed = if read then language.recast(old, read) else null
. next = parsed if parsed != null && (body.length == 0 || language.can-hold(parsed))
. held = if next then language.attach(language.detach(next), body) else null
if held && held.refused.length == 0
    =? null if store.same(held.parent, old)
    = store.with-id(held.parent, old.id)
= store.with-id(store.raw(text, body), old.id)

━━━━━━━━━━━━━━━━━━━━
+ do source-write-text
    - session SourceSession
    - file-path String

. written = session.saved-written()
. flags = FileFlags.write-mode + FileFlags.create-mode + FileFlags.truncate-mode
. file = catch? File(file-path, flags)
=? false if !file
. wrote = catch? file.write(written.text)
catch file.close()
=? false if wrote == null
session.mark-saved(written)
= true

━━━━━━━━━━━━━━━━━━━━
_ SourceUndo

+ index Index
+ old [U32]
+ count Size
+ row Size
+ column Size
+ cells Size

────────────────────
+ This
    - index
    - old
    - count
    - row
    - column

────────────────────
+ do move
    - moves SourceMoves

for position in 0 .. < old.length
    old[position] = moves.place(old[position])

━━━━━━━━━━━━━━━━━━━━
_ do source-placed String
    - lines [String]
    - left String

. is-open = left.trim().length == 0
. dest = source-indent-width(left) as Int
. leads = source-unindented(lines[0]).length < lines[0].length
. anchor = if is-open || leads then source-indent-width(lines[0]) as Int else dest
. unit = source-indent-columns as Int
. step Int
for index in 1 .. < lines.length
    if lines[index].trim().length > 0
        . delta = (source-indent-width(lines[index]) as Int) - anchor
        step = source-gcd(step, if delta < 0 then -delta else delta)
. placed [String]
placed += source-unindented(lines[0])
for index in 1 .. < lines.length
    . line = lines[index]
    if line.trim().length == 0
        placed += ""
        continue
    . delta = (source-indent-width(line) as Int) - anchor
    . moved = if step == 0 || step % unit == 0 then delta else delta / step * unit
    . width = dest + moved
    placed += (" " * (if width > 0 then width as Size else 0)) ++ source-unindented(line)
= "\n".join(placed)

━━━━━━━━━━━━━━━━━━━━
_ source-gcd Int
    - a Int
    - b Int

if b == 0 then a else source-gcd(b, a % b)

━━━━━━━━━━━━━━━━━━━━
_ do source-indent-width Size
    - text String

. width Size = 0
for c in text.codepoints
    if c == ' '
        width += 1
    else if c == '\t'
        width += source-indent-columns
    else
        break
= width

━━━━━━━━━━━━━━━━━━━━
_ do source-unindented String
    - text String

. count Size = 0
for c in text.codepoints
    if c != ' ' && c != '\t'
        break
    count += 1
= text[count ...]

━━━━━━━━━━━━━━━━━━━━
_ SourceToken is (start Size, end Size)

━━━━━━━━━━━━━━━━━━━━
_ do source-tokens [SourceToken]
    - shown SourceRow

. tokens [SourceToken]
. position Size = 0
for span in shown.spans
    . end = position + span.text.length
    if span.kind == SourceSpanKind.string || span.kind == SourceSpanKind.comment
        tokens ++= source-word-tokens(span.text, position)
    else if span.kind != SourceSpanKind.plain
        tokens += SourceToken(position, end)
    position = end
= tokens

━━━━━━━━━━━━━━━━━━━━
_ do source-word-tokens [SourceToken]
    - text String
    - offset Size

. chars = text.codepoints
. tokens [SourceToken]
. index Index = 0
while index < chars.length
    . kind = source-char-class(chars[index])
    if kind == CodeCharClass.space
        index += 1
        continue
    . start = index
    while index < chars.length && source-char-class(chars[index]) == kind
        index += 1
    tokens += SourceToken(offset + start, offset + index)
= tokens

━━━━━━━━━━━━━━━━━━━━
_ source-char-class CodeCharClass
    - c Char

if (c as U32) >= 128 then CodeCharClass.word else code-byte-class(c as Byte)
