────────────────────
+ do delete-selection Bool

=? false if !has-selection
. first = first-selected-row
. last = last-selected-row
if first == last
    . current = row-at(row)
    . start = selection-start
    . low = start - current.content-start
    . high = selection-end - current.content-start
    column = start
    goal-column = column
    collapse()
    =? false if !is-editable(current)
    . content = current.content
    retype(current, content[... low] ++ content[high ...])
    = true
=? splice-text(first, 0, last, 0, "") if is-line-start(first, selection-start) && ends-line
.. ends-line = is-line-start(last, selection-end)
= splice-text(first, selection-start, last, selection-end, "")

────────────────────
+ do split

if has-selection
    delete-selection()
if column <= row-at(row).content-start && is-block-head(row)
    commit()
    if is-block-head(row)
        open(document.declaration-at(row - 1), row - 1)
        =
if is-dirty && column >= dirty-row.content-start + typed.length && promote()
    split()
    =
. language = document.language
. shown = row-at(row)
if language.is-unparsed(shown.mode)
    . lead = leading-spaces(shown.text)
    splice-text(row, column, row, column, "\n" ++ " " * (if lead < column then lead else column))
    =
. home = shown.node-id
. index = document.declaration-at(row)
if shown.node == null || !language.is-flow(shown.mode)
    commit()
    . was-blank = is-blank-line(row)
    open(index, row)
    if was-blank && is-blank-line(row + 1)
        row += 1
        column = 0
        goal-column = 0
        collapse()
    =
. was-typed = is-dirty
. content = shown.content
. offset = column - shown.content-start
. left = content[... offset]
. rest = content[offset ...]
. right = rest[leading-spaces(rest) ...]
. owner = owner-of(index, shown)
is-dirty = false
begin(index)
. flow = flow-of(index, owner)
. ids = source-flow-ids(flow)
. position = source-flow-position(flow, home)
. current = flow[position]
. holds = source-flow-holds(flow, position)
if offset == 0 && content.length > 0
    if was-typed
        current.node = header-as(home, content, shown.mode, holds)
    flow.insert(SourceFlowRow(document.store.blank(), current.indent), position)
    document.replace(index, lodge(index, owner, ids, flow, position, false, true, was-typed))
    seek(index, home, 0)
    finish()
    =
if was-typed || right.length > 0
    current.node = header-as(home, left, shown.mode, holds)
. added = header-for(right, shown.mode, false)
. opened = added.id
. header = language.header-count(current.node)
. is-filled = header != null && document.store.count(language.detach(current.node)) > (header as Size)
. is-open = header != null && document.store.raw-text(current.node) == null && !is-filled
. indent = if holds || is-open || language.opens(current.node) then current.indent + 1 else current.indent
. slot = position + 1
flow.insert(SourceFlowRow(added, indent), slot)
document.replace(index, lodge(index, owner, ids, flow, slot, true, right.length == 0, was-typed))
if shown.zone == SourceRowZone.preamble || preamble-rows has home
    preamble-rows[opened] = true
seek(index, opened, 0)
finish()

────────────────────
+ do indent Bool

= shift(true)

────────────────────
+ do outdent Bool

= shift(false)

────────────────────
+ do undo Bool

commit()
=? false if undos.length == 0
exchange(undos.pop(), redos)
= true

────────────────────
+ do redo Bool

=? false if is-dirty || redos.length == 0
exchange(redos.pop(), undos)
= true

────────────────────
+ do preview ImmutableTableRow'SourceNode?

=? null if !is-dirty
document.discard()
= rewritten(document.row-at(row), typed)

────────────────────
+ do saved-written SexpWritten

commit()
discard-placeholder()
preamble-rows.clear()
if document.collapse-blanks()
    settle()
    revision += 1
= document.written()

────────────────────
+ do mark-saved
    - written SexpWritten

saved = List'U32(document.declarations)
document.line-ids = written.ids
revision += 1

────────────────────
+ do revert

=? if !is-dirty
is-dirty = false
revision += 1
column = clamped(column)
goal-column = column
collapse()

────────────────────
+ do commit

=? if !is-dirty || promote()
. shown = document.row-at(row)
if document.language.is-unparsed(shown.mode) || stays-invalid(shown) || rereads(shown)
    splice-text(row, column, row, column, "")
    =
is-dirty = false
revision += 1
if typed != shown.content
    document.discard()
    . next = rewritten(shown, typed)
    if next
        . id = next.id
        . index = document.declaration-at(row)
        . count = document.row-count
        begin(index)
        . joined = rejoined(index, shown, next)
        if joined
            document.replace(index, joined)
        else
            document.replace-row-node(row, next)
        finish()
        if document.row-count != count
            . rows = document.rows-of(index)
            for position in 0 .. < rows.length
                if document.node-id(rows[position]) == id
                    row = document.first-row(index) + position
column = clamped(column)
anchor-column = clamped-at(anchor-row, anchor-column)

────────────────────
_ do rejoined ImmutableTableRow'SourceNode?
    - index Index
    - shown SourceRow
    - next ImmutableTableRow'SourceNode

. language = document.language
. store = document.store
. old = store.node(shown.node!)
=? null if !language.is-flow(shown.mode)
. declaration = document.declaration(index)
if language.is-arm(old) && language.is-arm(next)
    . parent = parent-in(declaration, old)
    if parent && language.takes-arm(parent, next)
        = store.swapped(declaration, old, language.as-arm(next))
. owner = owner-of(index, shown)
. flow = flow-of(index, owner)
. position = source-flow-position(flow, shown.node-id)
=? null if position >= flow.length
. before = source-flow-heads(language, flow)
flow[position].node = next
. after = source-flow-heads(language, flow)
. is-moved = before[position] != null || after[position] != null
for spot in 0 .. < flow.length
    if before[spot] != after[spot]
        is-moved = true
    if after[spot] == null && is-swallowed(flow, spot)
        . node = flow[spot].node
