_ source-far-column Size = 1000000
_ source-undo-cells Size = 320000

━━━━━━━━━━━━━━━━━━━━
+ SourceRewrite is Tuple

+ changed Size
+ held Size

━━━━━━━━━━━━━━━━━━━━
+ SourceSession

+ document SourceDocument
