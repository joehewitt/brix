=? false if row + 1 >= document.row-count
. shown = document.row-at(row)
. lower = document.row-at(row + 1)
=? false if !shares-flow(shown, lower)
. home-row = row
. home-column = column
row += 1
column = lower.content-start
=? true if join-up()
row = home-row
column = home-column
= false

────────────────────
_ do close Bool
    - index Index
    - shown SourceRow

. base = document.first-row(index)
. rows = document.rows-of(index)
. first = row
. is-divided = false
. id = shown.node-id
for position in 0 .. < rows.length
    if document.owner-id(rows[position]) == id
        first = base + position
        is-divided = rows[position].is-divider
        break
begin(index)
match document.language.close-row(document.declaration(index), shown)
    | .kept
        pending = null
        = false
    | .declaration
        pending = SourceUndo(index, List'U32(document.declarations[index]), 0, row, column)
        document.splice(index, 1, List'(ImmutableTableRow'SourceNode)())
    | .row(next)
        document.replace(index, next)
row = stop-at(if is-divided || first == 0 then first else first - 1, true)
column = source-far-column
settle()
finish()
= true

────────────────────
_ do open
    - index Index
    - at Size

if index >= document.declarations.length
    add-declaration(index)
    =
. shown = document.row-at(at)
. is-thick = shown.divider == source-divider-thick
begin(index)
. dropped = document.language.drop-row(document.declaration(index), shown)
if dropped
    document.replace(index, dropped)
    row = at
    while row + 1 < document.row-count && document.row-at(row).zone == SourceRowZone.header
        row += 1
    if document.row-at(row).node == null && !is-blank-line(row)
        . below = min(row + 1, document.row-count - 1)
        . lower = document.row-at(below)
        row = if lower.node == null && !lower.is-divider then stop-at(row, false) else stop-at(below, true)
    column = 0
    settle()
    finish()
    =
. opened = opened-at(index, at)
if opened
    document.replace(index, opened.declaration)
    seek(index, opened.added, source-far-column)
    finish()
    =
pending = null
if is-thick
    add-declaration(index)

────────────────────
_ do open-here Bool

. index = document.declaration-at(row)
. is-last = index >= document.declarations.length && row + 1 == document.row-count
if is-last
    add-declaration(index)
    = true
=? false if index >= document.declarations.length
begin(index)
. opened = opened-at(index, row)
if !opened
    pending = null
    = false
. added = opened.added
document.replace(index, opened.declaration)
seek(index, added, source-far-column)
finish()
= true

────────────────────
_ do opened-at SourceOpened?
    - index Index
    - at Size

. declaration = document.declaration(index)
=? document.language.open-end(declaration, document.row-at(at)) if is-open-end(at)
= document.language.open-below(declaration, document.row-at(at))

────────────────────
_ do add-declaration
    - slot Index

. added = document.language.declaration()
. id = added.id
pending = SourceUndo(slot, List'U32(), 1, row, column)
document.splice(slot, 0, List'(ImmutableTableRow'SourceNode)(added))
seek(slot, id, source-far-column)
finish()

────────────────────
_ do shift Bool
    - deeper Bool

. typed-row = row-at(row)
=? reindent(typed-row, deeper) if document.language.is-unparsed(typed-row.mode)
commit()
=? false if document.row-count == 0
. shown = document.row-at(row)
. home = shown.node-id
. language = document.language
=? regroup(shown, deeper) if shown.node == null || !language.is-flow(shown.mode)
. index = document.declaration-at(row)
. owner = owner-of(index, shown)
. flow = flow-of(index, owner)
. ids = source-flow-ids(flow)
. position = source-flow-position(flow, home)
. heads = source-flow-heads(language, flow)
. span = source-flow-span(language, flow, heads, position)
. first = span[0]
. level = flow[first].indent
. above = first
while above > 0 && flow[above - 1].indent > level
    above -= 1
if deeper
    =? false if above == 0 || flow[above - 1].indent < level || !language.can-hold(flow[above - 1].node)
else
    =? false if level == 0
. offset = column - shown.content-start
for moved in first .. < span[1]
    . lower = flow[moved]
    lower.indent = if deeper then lower.indent + 1 else lower.indent - 1
. moved-heads = source-flow-heads(language, flow)
for spot in 0 .. < flow.length
    =? false if moved-heads[spot] != heads[spot] && (spot != first || heads[spot] != null)
. store = document.store
. grown = rebuilt(index, owner, ids, flow, List'Index())
=? false if store.same(language.grouped(grown), document.declaration(index))
if deeper
    . parent = store.find(grown, flow[above - 1].node.id)
    =? false if !parent || !store.find(parent, home)
begin(index)
document.replace(index, grown)
seek(index, home, offset)
finish()
= true

────────────────────
_ do regroup Bool
    - shown SourceRow
    - deeper Bool

. index = document.declaration-at(row)
=? false if index >= document.declarations.length
. declaration = document.declaration(index)
. offset = column - shown.content-start
. is-bare = shown.node == null
if deeper
    =? false if index == 0
    . grown = document.language.adopt(document.declaration(index - 1), declaration, shown)
    =? false if !grown
    . id = declaration.id
    . pair = List'U32(document.declarations[index - 1], document.declarations[index])
    pending = SourceUndo(index - 1, pair, 1, row, column)
    document.splice(index - 1, 2, List'(ImmutableTableRow'SourceNode)(grown))
