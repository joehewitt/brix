./language
./rows
/core/table
/data/source-tree

━━━━━━━━━━━━━━━━━━━━
+ SourceFlowRow

+ node ImmutableTableRow'SourceNode
+ indent Size

────────────────────
+ This
    - node
    - indent

━━━━━━━━━━━━━━━━━━━━
+ do source-flow-rows [SourceFlowRow]
    - language SourceLanguage
    - rows [SourceOutlineRow]
    - owner ImmutableTableRow'SourceNode

. store = language.store
. flow [SourceFlowRow]
for row in rows
    . node = row.node
    . held = row.owner
    if node != null && held != null && store.node(held).id == owner.id && language.is-flow(row.mode)
        flow += SourceFlowRow(store.node(node), row.indent)
= flow

━━━━━━━━━━━━━━━━━━━━
+ source-flow-ids [U32]
    - flow [SourceFlowRow]

each.node.id in flow when each.indent == 0

━━━━━━━━━━━━━━━━━━━━
+ do source-flow-position Size
    - flow [SourceFlowRow]
    - id U32

for position in 0 .. < flow.length
    =? position if flow[position].node.id == id
= flow.length

━━━━━━━━━━━━━━━━━━━━
+ source-flow-holds Bool
    - flow [SourceFlowRow]
    - position Size

position + 1 < flow.length && flow[position + 1].indent > flow[position].indent

━━━━━━━━━━━━━━━━━━━━
+ source-flow-without [SourceFlowRow]
    - flow [SourceFlowRow]
    - low Size
    - high Size

flow[each] in 0 .. < flow.length when each < low || each >= high

━━━━━━━━━━━━━━━━━━━━
+ do source-flow-rebuild ImmutableTableRow'SourceNode
    - language SourceLanguage
    - owner ImmutableTableRow'SourceNode
    - ids [U32]
    - flow [SourceFlowRow]

= source-flow-assembled(language, owner, ids, flow, List'Index())

━━━━━━━━━━━━━━━━━━━━
+ do source-flow-assembled ImmutableTableRow'SourceNode
    - language SourceLanguage
    - owner ImmutableTableRow'SourceNode
    - ids [U32]
    - flow [SourceFlowRow]
    - lifted [Index]

. store = language.store
. kept [ImmutableTableRow'SourceNode]
. slot Index? = null
for item in store.items(language.ungrouped(owner))
    if ids has item.id
        if slot == null
            slot = kept.length
    else
        kept += item
. built = source-flow-built(language, flow)
. shape = SourceFlowShape(flow.length)
source-flow-plan(language, built, flow, shape)
shape.link()
. position = flow.length
while position > 0
    position -= 1
    . spots = shape.children(position)
    if spots.length == 0
        continue
    . held [ImmutableTableRow'SourceNode]
    for spot in spots
        held += built[spot]
    . grown = language.attach(built[position], held)
    built[position] = grown.parent
    for refused in grown.refused
        shape.lift(spots[refused])
        lifted += spots[refused]
. start = slot ?? kept.length
. next [ImmutableTableRow'SourceNode]
for index in 0 .. < start
    next += kept[index]
for position in 0 .. < flow.length
    if shape.is-top(position)
        next += built[position]
for index in start .. < kept.length
    next += kept[index]
= store.with-items(owner, next)

━━━━━━━━━━━━━━━━━━━━
+ do source-flow-heads [Index?]
    - language SourceLanguage
    - flow [SourceFlowRow]

= source-flow-plan(language, source-flow-built(language, flow), flow, SourceFlowShape(flow.length))

━━━━━━━━━━━━━━━━━━━━
+ do source-flow-span (Size, Size)
    - language SourceLanguage
    - flow [SourceFlowRow]
    - heads [Index?]
    - position Size

. store = language.store
. first = heads[position] ?? position
. level = flow[first].indent
. end = first + 1
while end < flow.length
    if flow[end].indent > level || heads[end] == first
        end += 1
        continue
    . next = end
    while next < flow.length && flow[next].indent == level && source-flow-is-note(store, flow[next].node)
        next += 1
    =? (first, end) if next == end || next >= flow.length || heads[next] != first
    end = next
= (first, end)

━━━━━━━━━━━━━━━━━━━━
+ do source-same-unblanked Bool
    - store SourceStore
    - left ImmutableTableRow'SourceNode
    - right ImmutableTableRow'SourceNode

=? store.same(left, right) if !store.is-list(left) || !store.is-list(right)
. lefts = source-unblanked(store, left)
. rights = source-unblanked(store, right)
=? false if lefts.length != rights.length
for index in 0 .. < lefts.length
    =? false if !source-same-unblanked(store, lefts[index], rights[index])
= true

━━━━━━━━━━━━━━━━━━━━
_ do source-unblanked [ImmutableTableRow'SourceNode]
    - store SourceStore
    - node ImmutableTableRow'SourceNode

. kept [ImmutableTableRow'SourceNode]
for item in store.items(node)
    if !store.is-blank(item)
        kept += item
= kept

━━━━━━━━━━━━━━━━━━━━
_ source-flow-is-note Bool
    - store SourceStore
    - node ImmutableTableRow'SourceNode

store.is-blank(node) || store.is-comment(node)

━━━━━━━━━━━━━━━━━━━━
_ do source-flow-built [ImmutableTableRow'SourceNode]
    - language SourceLanguage
    - flow [SourceFlowRow]

. built [ImmutableTableRow'SourceNode]
for row in flow
    built += language.detach(row.node)
= built

━━━━━━━━━━━━━━━━━━━━
_ do source-flow-plan [Index?]
    - language SourceLanguage
    - built [ImmutableTableRow'SourceNode]
    - flow [SourceFlowRow]
    - shape SourceFlowShape

. stack [Index]
. depths [Size]
. heads [Index?]
for position in 0 .. < flow.length
    . indent = flow[position].indent
    . depth = if indent < stack.length then indent else stack.length
    if depth > 0 && depth == stack.length && !language.can-hold(built[stack[depth - 1]])
        depth -= 1
    while stack.length > depth
        stack.pop()
    depths += depth
    . head = source-flow-head(language, built, depths, heads, shape, position)
    heads += head
    if head != null
        built[position] = language.as-arm(built[position])
        shape.nest(head, position)
    else if depth > 0
        shape.nest(stack[depth - 1], position)
    stack += position
= heads

━━━━━━━━━━━━━━━━━━━━
_ do source-flow-head Index?
    - language SourceLanguage
    - built [ImmutableTableRow'SourceNode]
    - depths [Size]
    - heads [Index?]
    - shape SourceFlowShape
    - position Index

. row = built[position]
=? null if !language.is-arm(row)
. store = language.store
. depth = depths[position]
. skipped [Index]
. cursor = position
while cursor > 0
    cursor -= 1
    if depths[cursor] > depth
        continue
    =? null if depths[cursor] < depth
    . node = built[cursor]
    if store.is-blank(node) || store.is-comment(node)
        skipped += cursor
        continue
    . head = heads[cursor] ?? cursor
    =? null if !language.takes-arm(built[head], row)
    if skipped.length > 0
        . keeper = if language.can-hold(node) then cursor else head
        for spot in skipped
            shape.nest(keeper, spot)
    = head
= null

━━━━━━━━━━━━━━━━━━━━
_ SourceFlowShape

_ parents [Index?]
_ firsts [Index?]
_ lasts [Index?]
_ nexts [Index?]

────────────────────
+ This
    - count Size

for position in 0 .. < count
    parents += null
    firsts += null
    lasts += null
    nexts += null

────────────────────
+ do nest
    - parent Index
    - child Index

parents[child] = parent

────────────────────
+ do link

for child in 0 .. < parents.length
    . parent = parents[child]
    if parent == null
        continue
    . last = lasts[parent]
    if last != null
        nexts[last] = child
    else
        firsts[parent] = child
    lasts[parent] = child

────────────────────
+ do lift
    - child Index

parents[child] = null

────────────────────
+ is-top Bool
    - position Index

parents[position] == null

────────────────────
+ do children [Index]
    - position Index

. found [Index]
. child = firsts[position]
while child != null
    found += child
    child = nexts[child]
= found
