./document
./rows
./session
/code/code-find

━━━━━━━━━━━━━━━━━━━━
_ SourceFindRows

+ rows [CodeFindRow]

────────────────────
+ This
    - rows

━━━━━━━━━━━━━━━━━━━━
+ SourceFindCache

_ texts = Map'U32'SourceFindRows()
_ compactions Size

────────────────────
+ do reset

texts = Map'U32'SourceFindRows()

────────────────────
+ do rows [CodeFindRow]
    - session SourceSession

. document = session.document
if document.compaction-count != compactions
    texts = Map'U32'SourceFindRows()
    compactions = document.compaction-count
. kept = Map'U32'SourceFindRows()
. made [CodeFindRow]
for index in 0 .. < document.declarations.length
    for shown in rows-of(document, index, kept)
        made += shown
texts = kept
if session.is-dirty && session.row < made.length
    . typed = session.row-at(session.row)
    made[session.row] = CodeFindRow(typed.content, typed.content-start, !typed.is-divider)
= made

────────────────────
_ do rows-of [CodeFindRow]
    - document SourceDocument
    - index Index
    - kept [U32 = SourceFindRows]

. place = document.declarations[index]
. cached = texts[place] ?? kept[place]
if cached
    kept[place] = cached
    = cached.rows
. made [CodeFindRow]
for outline in document.rows-of(index)
    . shown = document.language.render(outline)
    made += CodeFindRow(shown.content, shown.content-start, !shown.is-divider)
kept[place] = SourceFindRows(made)
= made
