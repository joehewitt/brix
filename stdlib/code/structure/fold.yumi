./document
./rows
/core/table

━━━━━━━━━━━━━━━━━━━━
_ SourceFoldSpans

+ heads [Size]
+ counts [Size]
+ holds [Bool]
+ folds [Bool]
+ hidden Size
+ tucked Size

────────────────────
+ This

━━━━━━━━━━━━━━━━━━━━
+ SourceFolds

+ document SourceDocument
+ version U64

_ collapsed [U32 = U32]
_ spans [U32 = SourceFoldSpans]
_ ends [Size]
_ total Size
_ tucked Size
_ synced U64
_ synced-version U64
_ compactions Size
_ is-synced = false

────────────────────
+ This
    - document

────────────────────
+ do get is-plain Bool

sync()
= collapsed.length == 0 && tucked == 0

────────────────────
+ do row-count Size

=? document.row-count if is-plain
sync()
= total

────────────────────
+ do shown Size
    - row Size

=? row if is-plain
sync()
. index = document.declaration-at(row)
=? total - 1 if index >= document.declarations.length
. local = row - document.first-row(index)
. base = if index > 0 then ends[index - 1] else 0
. found = spans[document.declarations[index]]
=? base + local if !found
. hidden Size = 0
for slot in 0 .. < found.heads.length
    . head = found.heads[slot]
    if head >= local
        break
    =? base + head - hidden if local <= head + found.counts[slot]
    hidden += found.counts[slot]
= base + local - hidden

────────────────────
+ do actual Size
    - display Size

=? display if is-plain
sync()
. low Index = 0
. high = ends.length
while low < high
    . middle = low + (high - low) / 2
    if display < ends[middle]
        high = middle
    else
        low = middle + 1
=? document.row-count - 1 if low >= ends.length
. local = display - (if low > 0 then ends[low - 1] else 0)
. found = spans[document.declarations[low]]
if found
    for slot in 0 .. < found.heads.length
        if found.heads[slot] >= local
            break
        local += found.counts[slot]
= document.first-row(low) + local

────────────────────
+ above Size
    - row Size

if display > 0 then actual(display - 1) else row

.. display = shown(row)

────────────────────
+ below Size
    - row Size

if display + 1 < row-count() then actual(display + 1) else row

.. display = shown(row)

────────────────────
+ is-hidden Bool
    - row Size

!is-plain && actual(shown(row)) != row

────────────────────
+ is-folded Bool
    - row Size

slot-at(row) != null

────────────────────
+ holds-invalid Bool
    - row Size

if slot == null then false else spans[document.declarations[document.declaration-at(row)]]!.holds[slot]

.. slot = slot-at(row)

────────────────────
+ can-fold Bool
    - row Size

index < document.declarations.length && extent(document.rows-of(index), row - document.first-row(index), document.declaration(index).id) > 0

.. index = document.declaration-at(row)

────────────────────
+ do headers [Size]
    - row Size
    - limit Size

. found [Size]
. index = document.declaration-at(row)
=? found if index >= document.declarations.length
. base = document.first-row(index)
. rows = document.rows-of(index)
. home = document.declaration(index).id
. local = row - base
. inner [Size]
. probe = local
while true
    if rows[probe].node != null && !(collapsed has document.node-id(rows[probe]))
        . count = extent(rows, probe, home)
        if count > 0 && local <= probe + count
            inner += base + probe
    if probe == 0
        break
    probe -= 1
. position = inner.length
while position > 0 && found.length < limit
    position -= 1
    found += inner[position]
= found

────────────────────
+ section-end Size
    - row Size

|? index >= document.declarations.length
    row
??
    row + extent(document.rows-of(index), row - base, document.declaration(index).id)

.. index = document.declaration-at(row)
.. base = document.first-row(index)

────────────────────
+ do fold Size?
    - row Size

. index = document.declaration-at(row)
=? null if index >= document.declarations.length
. base = document.first-row(index)
. rows = document.rows-of(index)
. home = document.declaration(index).id
. local = row - base
. probe = local
while true
    . id = document.node-id(rows[probe])
    if rows[probe].node != null && !(collapsed has id)
        . count = extent(rows, probe, home)
        if count > 0 && local <= probe + count
            close(index, id, home)
            = base + probe
    if probe == 0
        break
    probe -= 1
= null

────────────────────
+ do collapse Bool
    - row Size

. index = document.declaration-at(row)
=? false if index >= document.declarations.length
. rows = document.rows-of(index)
. local = row - document.first-row(index)
. home = document.declaration(index).id
=? false if extent(rows, local, home) == 0
. id = document.node-id(rows[local])
=? false if collapsed has id
close(index, id, home)
= true

────────────────────
+ do unfold Bool
    - row Size

=? false if is-plain
. index = document.declaration-at(row)
=? false if index >= document.declarations.length
. id = document.node-id(document.rows-of(index)[row - document.first-row(index)])
=? false if !(collapsed has id)
-= collapsed[id]
-= spans[document.declarations[index]]
version += 1
= true

────────────────────
+ do reveal Bool
    - row Size

. changed = false
while !is-plain
    . head = actual(shown(row))
    if head == row || !unfold(head)
        break
    changed = true
= changed

────────────────────
+ do fold-all

for index in 0 .. < document.declarations.length
    . rows = document.rows-of(index)
    . home = document.declaration(index).id
    for position in 0 .. < rows.length
        . id = document.node-id(rows[position])
        . is-head = id == home || (position + 1 < rows.length && next-owned)
            .. next-owned = document.owner-id(rows[position + 1]) == id
        if rows[position].node != null && is-head && extent(rows, position, home) > 0
            collapsed[id] = home
spans = Map'U32'SourceFoldSpans()
version += 1

────────────────────
+ do unfold-all

=? if is-plain
collapsed = Map'U32'U32()
spans = Map'U32'SourceFoldSpans()
version += 1

────────────────────
_ do close
    - index Index
    - id U32
    - home U32

collapsed[id] = home
-= spans[document.declarations[index]]
version += 1

────────────────────
_ do slot-at Size?
    - row Size

=? null if is-plain
sync()
. index = document.declaration-at(row)
=? null if index >= document.declarations.length
. found = spans[document.declarations[index]]
=? null if !found
. local = row - document.first-row(index)
for slot in 0 .. < found.heads.length
    =? slot if found.heads[slot] == local && found.folds[slot]
= null

────────────────────
_ do extent Size
    - rows [SourceOutlineRow]
    - position Size
    - home U32

. row = rows[position]
=? 0 if row.node == null
. id = document.node-id(row)
. count Size = 0
if id == home
    count = rows.length - position - 1
else
    . head = document.store.node-at(row.node)
    . inside = id
    while position + count + 1 < rows.length
        . owner = document.owner-id(rows[position + count + 1])
        if owner != inside
            if owner != id && (owner == 0 || !head || document.store.find(head, owner) == null)
                break
            inside = owner
        count += 1
    if count == 0
        while position + count + 1 < rows.length && rows[position + count + 1].indent > row.indent
            count += 1
if count > 0 && rows[position + count].node == null && rows[position + count].divider == 0
    count -= 1
=? 0 if count == 0
for later in position + 1 .. position + count
    =? count if rows[later].node != null
= 0

────────────────────
_ do sync

. compacted = document.compaction-count
=? if is-synced && synced == document.revision && same-version && compactions == compacted
.. same-version = synced-version == version
if compactions != compacted
    spans = Map'U32'SourceFoldSpans()
    compactions = compacted
is-synced = true
synced = document.revision
synced-version = version
. kept = Map'U32'SourceFoldSpans()
. made [Size]
. end Size = 0
. tucks Size = 0
for index in 0 .. < document.declarations.length
    . place = document.declarations[index]
    . found = spans[place] ?? spanned(index)
    kept[place] = found
    end += document.first-row(index + 1) - document.first-row(index) - found.hidden
    tucks += found.tucked
    made += end
ends = made
spans = kept
tucked = tucks
total = end + 1

────────────────────
_ do spanned SourceFoldSpans
    - index Index

. rows = document.rows-of(index)
. home = document.declaration(index).id
. made = SourceFoldSpans()
. position Size = 0
while position < rows.length
    . id = document.node-id(rows[position])
    if rows[position].node != null && collapsed has id
        . count = extent(rows, position, home)
        if count > 0
            . holds = false
            for later in position + 1 .. position + count
                if rows[later].is-invalid
                    holds = true
            made.heads += position
            made.counts += count
            made.holds += holds
            made.folds += true
            made.hidden += count
            position += count + 1
            continue
    if rows[position].is-text-only && position > 0
        made.heads += position - 1
        made.counts += 1
        made.holds += false
        made.folds += false
        made.hidden += 1
        made.tucked += 1
    position += 1
= made
