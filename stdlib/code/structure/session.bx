(import ./document)
(import ./flow)
(import ./fold)
(import ./language)
(import ./rows)
(import /code/code-comments)
(import /code/code-session)
(import /core/table)
(import /data/source-sexp)
(import /data/source-tree)
(import /math)
(import /os/file)
(import /stream/aggregate)
(blank)
(prop _ source-far-column Size (= 1000000))
(prop _ source-undo-cells Size (= 320000))

(type + SourceRewrite (is Tuple)
  (prop + changed Size)
  (prop + held Size)
)

(type + SourceSession
  (prop + document SourceDocument)
  (prop + row Size)
  (prop + column Size)
  (prop + anchor-row Size)
  (prop + anchor-column Size)
  (prop + revision U64)
  (prop + is-dirty Bool)
  (prop + undo-budget Size (= source-undo-cells))
  (prop + folds SourceFolds)
  (blank)
  (prop _ saved (list U32))
  (prop _ goal-column Size)
  (prop _ typed String)
  (prop _ dirty-row SourceRow)
  (prop _ undos (list SourceUndo))
  (prop _ redos (list SourceUndo))
  (prop _ pending (? SourceUndo))
  (prop _ charged Size)
  (prop _ preamble-rows (map U32 Bool))
  (fn-do + This _
    (param document _)
    (lazy folds (call SourceFolds document))
    (if (> (. document row-count) 0)
      (= row (call stop-at 0 false))
      (= column (. (call (. document row-at) row) content-start))
    )
    (= anchor-row row)
    (= anchor-column column)
    (= saved (call (of List U32) (. document declarations)))
    (= charged (. document cell-count))
  )
  (fn-expr + row-count Size :get
    (. document row-count)
  )
  (fn-expr + is-modified Bool :get
    (or is-dirty (not (call is-saved)))
  )
  (fn-expr + has-selection Bool :get
    (or (!= anchor-row row) (!= anchor-column column))
  )
  (fn-expr + first-selected-row Size :get
    (if-expr (< row anchor-row) row anchor-row)
  )
  (fn-expr + last-selected-row Size :get
    (if-expr (> row anchor-row) row anchor-row)
  )
  (fn-expr + selection-start Size :get
    (case? (== row anchor-row)
      (if-expr (< column anchor-column) column anchor-column)
    )
    (case? (< row anchor-row)
      column
    )
    (default
      anchor-column
    )
  )
  (fn-expr + selection-end Size :get
    (case? (== row anchor-row)
      (if-expr (> column anchor-column) column anchor-column)
    )
    (case? (> row anchor-row)
      column
    )
    (default
      anchor-column
    )
  )
  (fn-expr + row-at SourceRow
    (param index Size)
    (if-expr (and is-dirty (== index row)) dirty-row (call (. document row-at) index))
  )
  (fn-do + view-text String
    (let lines (call (. document view-lines)))
    (if (and is-dirty (< row (. lines length)))
      (= ([] lines row) (. dirty-row text))
    )
    (return (str (call (. "\n" join) lines) "\n"))
  )
  (fn-do + collapse _
    (= anchor-row row)
    (= anchor-column column)
  )
  (fn-do + place _
    (param target-row Size)
    (param target-column Size)
    (param extends _ (= false))
    (return-if (if (== (. document row-count) 0)))
    (let next (if-expr (< target-row (. document row-count)) target-row (- (. document row-count) 1)))
    (if (!= next row)
      (let home row)
      (let count (. document row-count))
      (call commit)
      (call discard-placeholder)
      (let now (. document row-count))
      (if (and (> next home) (< now count))
        (let lost (- count now))
        (= next (if-expr (>= next lost) (- next lost) 0))
        (else-if (> next home)
          (+= next (- now count))
        )
      )
      (= row (if-expr (< next now) next (- now 1)))
    )
    (= column (call clamped target-column))
    (= goal-column column)
    (if (not extends)
      (call collapse)
    )
  )
  (fn-do + move-left _
    (return-if (if (== (. document row-count) 0)))
    (let current (call row-at row))
    (if (> column (. current content-start))
      (-= column 1)
      (else-if (> (call (. folds shown) row) 0)
        (call commit)
        (= row (call stop-at (call (. folds above) row) true))
        (= column (. (call row-at row) columns))
      )
    )
    (= goal-column column)
  )
  (fn-do + move-right _
    (return-if (if (== (. document row-count) 0)))
    (if (< column (. (call row-at row) columns))
      (+= column 1)
      (else-if (< (+ (call (. folds shown) row) 1) (call (. folds row-count)))
        (call commit)
        (= row (call stop-at (call (. folds below) row) false))
        (= column (. (call row-at row) content-start))
      )
    )
    (= goal-column column)
  )
  (fn-do + move-token-left _
    (return-if (if (== (. document row-count) 0)))
    (let current (call row-at row))
    (let offset (- column (. current content-start)))
    (if (== offset 0)
      (call move-left)
      (return)
    )
    (= column (+ (. current content-start) (call token-start current offset)))
    (= goal-column column)
  )
  (fn-do + move-token-right _
    (return-if (if (== (. document row-count) 0)))
    (let current (call row-at row))
    (if (>= column (. current columns))
      (call move-right)
      (return)
    )
    (let offset (- column (. current content-start)))
    (let target (- (. current columns) (. current content-start)))
    (for (in token (call source-tokens current))
      (if (> (. token end) offset)
        (= target (. token end))
        (break)
      )
    )
    (= column (+ (. current content-start) target))
    (= goal-column column)
  )
  (fn-do + move-up _
    (param count Size (= 1))
    (return-if (if (== (call (. folds shown) row) 0)))
    (call commit)
    (let display (call (. folds shown) row))
    (= row (call stop-at (call (. folds actual) (if-expr (> display count) (- display count) 0)) true))
    (= column (call clamped goal-column))
  )
  (fn-do + move-down _
    (param count Size (= 1))
    (return-if (if (>= (+ (call (. folds shown) row) 1) (call (. folds row-count)))))
    (call commit)
    (let display (call (. folds shown) row))
    (let last (- (call (. folds row-count)) 1))
    (= row (call stop-at (call (. folds actual) (if-expr (< (+ display count) last) (+ display count) last)) false))
    (= column (call clamped goal-column))
  )
  (fn-do + move-to-line-start _
    (return-if (if (== (. document row-count) 0)))
    (= column (. (call row-at row) content-start))
    (= goal-column column)
  )
  (fn-do + move-to-line-end _
    (return-if (if (== (. document row-count) 0)))
    (= column (. (call row-at row) columns))
    (= goal-column column)
  )
  (fn-do + move-to-start _
    (call place (call stop-at 0 false) 0 true)
  )
  (fn-do + move-to-end _
    (return-if (if (== (. document row-count) 0)))
    (let last (- (. document row-count) 1))
    (call place last (. (call (. document row-at) last) columns) true)
  )
  (fn-do + select-all _
    (return-if (if (== (. document row-count) 0)))
    (call move-to-end)
    (= anchor-row 0)
    (= anchor-column (. (call (. document row-at) 0) content-start))
  )
  (fn-do + select-token _
    (return-if (if (== (. document row-count) 0)))
    (let current (call row-at row))
    (return-if (if (. current is-divider)))
    (let offset (- column (. current content-start)))
    (let picked (? SourceToken) null)
    (for (in token (call source-tokens current))
      (if (and (>= offset (. token start)) (<= offset (. token end)) (or (== picked null) (< offset (. token end))))
        (= picked token)
        (if (< offset (. token end))
          (break)
        )
      )
    )
    (return-if (if (not picked)))
    (= anchor-row row)
    (= anchor-column (+ (. current content-start) (. picked start)))
    (= column (+ (. current content-start) (. picked end)))
    (= goal-column column)
  )
  (fn-do + select-range _
    (param target-row Size)
    (param start Size)
    (param end Size)
    (call place target-row start)
    (= column (call clamped end))
    (= goal-column column)
  )
  (fn-expr + can-edit Bool
    (param index Size)
    (and (< index (. document row-count)) (call is-editable (call row-at index)))
  )
  (fn-expr + in-preamble Bool
    (param id U32)
    (has preamble-rows id)
  )
  (fn-expr + is-padding Bool
    (param index Size)
    (and (< (+ index 1) (. document row-count)) (== (. shown node) null) (not (. shown is-divider)) (or (. shown is-padding) is-gap))
    (where
      (lazy shown (call row-at index))
      (lazy next (call (. folds below) index))
      (lazy is-gap (and (!= (. shown zone) (. SourceRowZone body)) (!= next index) (not (call is-open-end index)) (or (. (call row-at next) is-divider) (call is-open-end next) (call is-blank-line next))))
    )
  )
  (fn-expr + is-blank-line Bool
    (param index Size)
    (and (< index (. document row-count)) (== (. shown node) null) (not (. shown is-divider)) (== (. shown zone) (. SourceRowZone body)))
    (where
      (lazy shown (call row-at index))
    )
  )
  (fn-expr + is-block-head Bool
    (param index Size)
    (and (> index 0) (< index (. document row-count)) (or (== divider source-divider-thick) (== divider source-divider-thin)))
    (where
      (lazy divider (. (call row-at (- index 1)) divider))
    )
  )
  (fn-expr + is-skipped Bool
    (param index Size)
    (or (call is-padding index) (and (< (+ index 1) (. document row-count)) (or (== divider source-divider-thick) (== divider source-divider-thin) (== divider source-divider-dashed))))
    (where
      (lazy divider (. (call row-at index) divider))
    )
  )
  (fn-expr + is-open-end Bool
    (param index Size)
    (and (< (+ index 1) (. document row-count)) (. (call row-at index) is-open-end))
  )
  (fn-do + stop-at Size
    (param index Size)
    (param upward Bool)
    (let at index)
    (let up upward)
    (while (call is-skipped at)
      (if (and up (> (call (. folds shown) at) 0))
        (= at (call (. folds above) at))
        (else-if (< (+ (call (. folds shown) at) 1) (call (. folds row-count)))
          (= at (call (. folds below) at))
          (= up false)
        )
        (else
          (break)
        )
      )
    )
    (return at)
  )
  (fn-do + fold Bool
    (return-if false (if (== (call (. folds fold) row) null)))
    (call cover)
    (return true)
  )
  (fn-do + unfold Bool
    (return (call (. folds unfold) row))
  )
  (fn-do + toggle-fold Bool
    (param target Size)
    (return-if true (if (call (. folds unfold) target)))
    (return-if false (if (not (call (. folds collapse) target))))
    (call cover)
    (return true)
  )
  (fn-do + fold-all _
    (call (. folds fold-all))
    (call cover)
  )
  (fn-do + unfold-all _
    (call (. folds unfold-all))
  )
  (fn-do + replace-rows SourceRewrite
    (param targets (list Size))
    (param texts (list String))
    (call commit)
    (return-if (call SourceRewrite 0 0) (if (== (. targets length) 0)))
    (let low (call (. document declaration-at) ([] targets 0)))
    (let high (call (. document declaration-at) ([] targets (- (. targets length) 1))))
    (let old (list U32))
    (for (in index (..< low (+ high 1)))
      (+= old ([] (. document declarations) index))
    )
    (= pending (call SourceUndo low old (+ (- high low) 1) row column))
    (let language (. document language))
    (let changed Size 0)
    (let held Size 0)
    (let position (. targets length))
    (while (> position 0)
      (-= position 1)
      (let target ([] targets position))
      (let shown (call (. document row-at) target))
      (if (not (call is-editable shown))
        (continue)
      )
      (call (. document discard))
      (let next (call rewritten shown ([] texts position)))
      (if (not next)
        (continue)
      )
      (if (call (. language is-invalid) next (. shown mode))
        (+= held 1)
      )
      (call (. document replace-row-node) target next)
      (+= changed 1)
    )
    (if (== changed 0)
      (= pending null)
      (return (call SourceRewrite 0 0))
    )
    (call settle)
    (call finish)
    (return (call SourceRewrite changed held))
  )
  (fn-do + toggle-comment Bool
    (let targets (list Size))
    (let texts (list String))
    (for (in index (..< first-selected-row (+ last-selected-row 1)))
      (if (call can-edit index)
        (+= targets index)
        (+= texts (. (call row-at index) text))
      )
    )
    (return-if false (if (== (. targets length) 0)))
    (let changed (call code-toggled-comments texts (. document language comment-marker)))
    (return-if false (if (== changed texts)))
    (let first first-selected-row)
    (let last last-selected-row)
    (let keeps-selection has-selection)
    (let old-row row)
    (let old-column column)
    (return-if false (if (== (. (call replace-rows targets changed) changed) 0)))
    (if keeps-selection
      (call place first 0)
      (call place last (. (call row-at last) text length) true)
      (else
        (let shift (- (as (. (call row-at old-row) text length) Int) (as (. ([] texts 0) length) Int)))
        (call place old-row (call max 0 (+ (as old-column Int) shift)))
      )
    )
    (return true)
  )
  (fn-do + selected-text String
    (return (call (. "\n" join) (call selected-lines)))
  )
  (fn-do + clipboard-text String
    (let lines (call selected-lines))
    (let first first-selected-row)
    (let last last-selected-row)
    (return-if (call (. "\n" join) lines) (if (or (< (. lines length) 2) (> selection-start (. (call row-at first) content-start)) (not (call is-block-head first)))))
    (let is-ended (<= selection-end (. (call row-at last) content-start)))
    (if (and is-ended (call is-block-head last))
      (call (. lines remove) (- (. lines length) 2))
      (else-if (and (not is-ended) (>= selection-end (. (call row-at last) columns)) (call ends-block last))
        (+= lines "")
      )
    )
    (call (. lines insert) (. (call row-at (- first 1)) text) 0)
    (return (call (. "\n" join) lines))
  )
  (fn-do _ ends-block Bool
    (param index Size)
    (for (in below (..< (+ index 1) (. document row-count)))
      (let shown (call row-at below))
      (return-if true (if (or (== (. shown divider) source-divider-thick) (== (. shown divider) source-divider-thin))))
      (return-if false (if (!= (. shown node) null)))
    )
    (return true)
  )
  (fn-do _ selected-lines (list String)
    (let parts (list String))
    (return-if parts (if (not has-selection)))
    (let first first-selected-row)
    (let last last-selected-row)
    (let is-whole (and (> last first) (<= selection-start (. (call row-at first) content-start))))
    (let is-ended (and (> last first) (<= selection-end (. (call row-at last) content-start))))
    (for (in index (..< first (+ last 1)))
      (let text (. (call row-at index) text))
      (let low (if-expr (and (== index first) (not is-whole)) selection-start 0))
      (let high (if-expr (!= index last) (. text length) (if-expr is-ended 0 selection-end)))
      (if (> high (. text length))
        (= high (. text length))
      )
      (if (> low high)
        (= low high)
      )
      (+= parts ([] text (..< low high)))
    )
    (return parts)
  )
  (fn-do + insert Bool
    (param text String)
    (return-if (call paste text) (if (!= (call (. text find) "\n") null)))
    (if has-selection
      (let first first-selected-row)
      (let last last-selected-row)
      (return-if (call splice-text first selection-start last selection-end text) (if (!= first last)))
      (call delete-selection)
    )
    (return-if false (if (or (== (. document row-count) 0) (== (. text length) 0))))
    (if (and (not is-dirty) (== (. (call (. document row-at) row) node) null))
      (return-if false (if (not (call open-here))))
    )
    (let current (call row-at row))
    (return-if false (if (not (call is-editable current))))
    (let offset (- column (. current content-start)))
    (let content (. current content))
    (call retype current (++ ([] content (... _ offset)) text ([] content (... offset))))
    (+= column (. text length))
    (= goal-column column)
    (call collapse)
    (return true)
  )
  (fn-do + paste Bool
    (param text String)
    (let lines (list String))
    (for (in line (call (. text split) "\n"))
      (+= lines (if-expr (and (> (. line length) 0) (call (. line ends-with) "\r")) ([] line (... _ (- (. line length) 1))) line))
    )
    (return-if false (if (== (. lines length) 0)))
    (return-if (call insert ([] lines 0)) (if (== (. lines length) 1)))
    (return-if false (if (< (. document row-count) 2)))
    (let first (if-expr has-selection first-selected-row row))
    (let last (if-expr has-selection last-selected-row row))
    (let start (if-expr has-selection selection-start column))
    (let end (if-expr has-selection selection-end column))
    (let lead Size 0)
    (while (and (< lead (. lines length)) (== (. (call (. ([] lines lead) trim)) length) 0))
      (+= lead 1)
    )
    (let divider (if-expr (< lead (. lines length)) (call (. document language divider-line) ([] lines lead)) 0))
    (let is-blocks (!= divider 0))
    (let is-verbatim (call some lines (:where (!= (call (. document language divider-line) each) 0))))
    (for (in _ (..< 0 (if-expr is-blocks lead 0)))
      (call (. lines remove) 0)
    )
    (if is-blocks
      (if (and (not has-selection) (== (. (call row-at first) zone) (. SourceRowZone header)))
        (while (and (> first 0) (not (call is-block-head first)))
          (-= first 1)
        )
        (= last first)
        (= start 0)
        (= end 0)
        (else-if (and (not has-selection) (not (call is-line-start first start)) (< (+ first 1) (. document row-count)))
          (+= first 1)
          (= last first)
          (= start 0)
          (= end 0)
        )
      )
      (if (and (call is-line-start first start) (call is-block-head first))
        (-= first 1)
        (= start 0)
        (if (not has-selection)
          (= last first)
          (= end 0)
        )
      )
      (if (and has-selection (> last (+ first 1)) (call is-line-start last end) (call is-block-head last))
        (-= last 1)
        (= end 0)
      )
      (let outside (if-expr (and (== divider source-divider-thick) (not has-selection)) (call members-end first) null))
      (if outside
        (= first outside)
        (= last first)
      )
    )
    (let shown (call row-at first))
    (let is-ruled (and (not has-selection) (not (call is-editable shown)) (> (. shown content length) 0)))
    (let is-closing (and is-ruled (== (+ first 1) (. document row-count))))
    (if is-blocks
      (if (and is-ruled (== (. ([] lines (- (. lines length) 1)) length) 0))
        (call (. lines remove) (- (. lines length) 1))
        (else-if (and (not is-ruled) (> (. ([] lines (- (. lines length) 1)) length) 0) (or (not has-selection) (call is-line-start last end) (< end (. (call row-at last) text length))))
          (+= lines "")
        )
      )
    )
    (if is-closing
      (-= first 1)
      (= last first)
      (= start (. (call row-at first) text length))
      (= end start)
      (else-if is-ruled
        (= start 0)
        (= end 0)
      )
    )
    (let opening (. (call row-at first) text))
    (let reach (if-expr (< start (. opening length)) start (. opening length)))
    (let left (if-expr (or is-ruled is-verbatim) "" ([] opening (... _ reach))))
    (let placed (if-expr is-verbatim (call (. "\n" join) lines) (call source-placed lines left)))
    (let is-lines
      (scope (and whole-lines (or (not has-selection) (call is-line-start last end)))
        (lazy whole-lines (and (not is-ruled) (== (. ([] lines (- (. lines length) 1)) length) 0) (call is-line-start first start)))
      )
    )
    (return-if (call splice-text first 0 last 0 (++ left placed)) (if is-lines))
    (let written (if-expr (or is-closing (and is-blocks (not (call is-line-start first start)))) (++ "\n" placed) (if-expr is-ruled (++ placed "\n") placed)))
    (return (call splice-text first start last end written))
  )
  (fn-do _ members-end (? Size)
    (param index Size)
    (let is-member false)
    (for (in below (..< index (. document row-count)))
      (let shown (call row-at below))
      (return-if null (if (and (== (. shown divider) source-divider-thick) (not is-member))))
      (return-if below (if (== (. shown divider) source-divider-thick)))
      (= is-member (or is-member (== (. shown divider) source-divider-thin)))
    )
    (return-if null (if (not is-member)))
    (return (- (. document row-count) 1))
  )
  (fn-do + delete-backward Bool
    (return-if (call delete-selection) (if has-selection))
    (return-if false (if (== (. document row-count) 0)))
    (let current (call row-at row))
    (let offset (- column (. current content-start)))
    (return-if (call join-up) (if (or (== offset 0) (== (. current node) null))))
    (return-if false (if (not (call is-editable current))))
    (let content (. current content))
    (call retype current (++ ([] content (... _ (- offset 1))) ([] content (... offset))))
    (-= column 1)
    (= goal-column column)
    (call collapse)
    (return true)
  )
  (fn-do + delete-forward Bool
    (return-if (call delete-selection) (if has-selection))
    (return-if false (if (== (. document row-count) 0)))
    (let current (call row-at row))
    (let offset (- column (. current content-start)))
    (let content (. current content))
    (return-if (call join-down) (if (>= offset (. content length))))
    (return-if false (if (not (call is-editable current))))
    (call retype current (++ ([] content (... _ offset)) ([] content (... (+ offset 1)))))
    (call collapse)
    (return true)
  )
  (fn-do + delete-token-backward Bool
    (return-if (call delete-selection) (if has-selection))
    (return-if false (if (== (. document row-count) 0)))
    (let current (call row-at row))
    (let offset (- column (. current content-start)))
    (return-if (call join-up) (if (or (== offset 0) (== (. current node) null))))
    (return-if false (if (not (call is-editable current))))
    (let start (call token-start current offset))
    (let content (. current content))
    (call retype current (++ ([] content (... _ start)) ([] content (... offset))))
    (= column (+ (. current content-start) start))
    (= goal-column column)
    (call collapse)
    (return true)
  )
  (fn-do + delete-to-line-start Bool
    (return-if (call delete-selection) (if has-selection))
    (return-if false (if (== (. document row-count) 0)))
    (let current (call row-at row))
    (let offset (- column (. current content-start)))
    (return-if false (if (or (not (call is-editable current)) (== offset 0))))
    (call retype current ([] (. current content) (... offset)))
    (= column (. current content-start))
    (= goal-column column)
    (call collapse)
    (return true)
  )
  (fn-do + delete-to-line-end Bool
    (return-if (call delete-selection) (if has-selection))
    (return-if false (if (== (. document row-count) 0)))
    (let current (call row-at row))
    (let offset (- column (. current content-start)))
    (let content (. current content))
    (return-if false (if (or (not (call is-editable current)) (>= offset (. content length)))))
    (call retype current ([] content (... _ offset)))
    (call collapse)
