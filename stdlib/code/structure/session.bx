    (lazy unparsed (call (. document language is-unparsed) (. current mode)))
    (call commit)
    (let shown (call (. document row-at) row))
    (let store (. document store))
    (let node (call (. store node-at) (. shown node)))
    (return-if (call back-over) (if (not node)))
    (let language (. document language))
    (let index (call (. document declaration-at) row))
    (return-if (call close index shown) (if (not (call (. language is-flow) (. shown mode)))))
    (let owner (call owner-of index shown))
    (let flow (call flow-of index owner))
    (let ids (call source-flow-ids flow))
    (let home (. shown node-id))
    (let position (call source-flow-position flow home))
    (return-if false (if (>= position (. flow length))))
    (if (call (. store is-blank) node)
      (let above U32 (if-expr (> position 0) (. ([] flow (- position 1)) node id) 0))
      (call begin index)
      (call apply index owner ids (call source-flow-without flow position (+ position 1)))
      (if (> position 0)
        (call seek index above source-far-column)
        (else
          (call settle)
        )
      )
      (call finish)
      (return true)
    )
    (return-if false (if (== position 0)))
    (let upper ([] flow (- position 1)))
    (let held (. upper node id))
    (call begin index)
    (if (call (. store is-blank) (. upper node))
      (call apply index owner ids (call source-flow-without flow (- position 1) position))
      (call seek index home 0)
      (else
        (let above (call flow-content index (. owner id) held))
        (let holds (and (< (+ position 1) (. flow length)) (> (. ([] flow (+ position 1)) indent) (. upper indent))))
        (= (. upper node) (call header-as held (call joined above (. shown content) (. shown mode)) (. shown mode) holds))
        (call apply index owner ids (call source-flow-without flow position (+ position 1)))
        (call seek index held (. above length))
      )
    )
    (call finish)
    (return true)
  )
  (fn-do _ joined String
    (param above String)
    (param below String)
    (param mode SourceRowMode)
    (let close (++ above below))
    (let spaced (str above " " below))
    (return (if-expr (or (call reads close mode) (not (call reads spaced mode))) close spaced))
  )
  (fn-do _ reads Bool
    (param text String)
    (param mode SourceRowMode)
    (let parsed (call (. document language parse) text mode))
    (return (and (!= parsed null) (not (call (. document language is-invalid) parsed mode))))
  )
  (fn-do _ back-over Bool
    (return-if false (if (== row 0)))
    (let target (- row 1))
    (while (and (> target 0) (== (. (call (. document row-at) target) node) null))
      (-= target 1)
    )
    (let shown (call (. document row-at) target))
    (let node (call (. document store node-at) (. shown node)))
    (if (and node (call (. document store is-blank) node) (call (. document language is-flow) (. shown mode)))
      (let index (call (. document declaration-at) target))
      (let owner (call owner-of index shown))
      (let flow (call flow-of index owner))
      (let ids (call source-flow-ids flow))
      (let position (call source-flow-position flow (. shown node-id)))
      (call begin index)
      (call apply index owner ids (call source-flow-without flow position (+ position 1)))
      (-= row 1)
      (call settle)
      (call finish)
      (return true)
    )
    (= row (call stop-at (- row 1) true))
    (if (== target row)
      (= column source-far-column)
    )
    (call settle)
    (return true)
  )
  (fn-do _ join-down Bool
    (let current (call row-at row))
    (return-if (call splice-text row (. current text length) (+ row 1) 0 "") (if (and (< (+ row 2) (. document row-count)) unparsed)))
    (lazy unparsed (call (. document language is-unparsed) (. current mode)))
    (call commit)
    (return-if false (if (>= (+ row 1) (. document row-count))))
    (let shown (call (. document row-at) row))
    (let lower (call (. document row-at) (+ row 1)))
    (return-if false (if (not (call shares-flow shown lower))))
    (let home-row row)
    (let home-column column)
    (+= row 1)
    (= column (. lower content-start))
    (return-if true (if (call join-up)))
    (= row home-row)
    (= column home-column)
    (return false)
  )
  (fn-do _ close Bool
    (param index Index)
    (param shown SourceRow)
    (let base (call (. document first-row) index))
    (let rows (call (. document rows-of) index))
    (let first row)
    (let is-divided false)
    (let id (. shown node-id))
    (for (in position (..< 0 (. rows length)))
      (if (== (call (. document owner-id) ([] rows position)) id)
        (= first (+ base position))
        (= is-divided (. ([] rows position) is-divider))
        (break)
      )
    )
    (call begin index)
    (match (call (. document language close-row) (call (. document declaration) index) shown)
      (case .kept
        (= pending null)
        (return false)
      )
      (case .declaration
        (= pending (call SourceUndo index (call (of List U32) ([] (. document declarations) index)) 0 row column))
        (call (. document splice) index 1 (call (of List (of ImmutableTableRow SourceNode))))
      )
      (case (call .row next)
        (call (. document replace) index next)
      )
    )
    (= row (call stop-at (if-expr (or is-divided (== first 0)) first (- first 1)) true))
    (= column source-far-column)
    (call settle)
    (call finish)
    (return true)
  )
  (fn-do _ open _
    (param index Index)
    (param at Size)
    (if (>= index (. document declarations length))
      (call add-declaration index)
      (return)
    )
    (let shown (call (. document row-at) at))
    (let is-thick (== (. shown divider) source-divider-thick))
    (call begin index)
    (let dropped (call (. document language drop-row) (call (. document declaration) index) shown))
    (if dropped
      (call (. document replace) index dropped)
      (= row at)
      (while (and (< (+ row 1) (. document row-count)) (== (. (call (. document row-at) row) zone) (. SourceRowZone header)))
        (+= row 1)
      )
      (if (and (== (. (call (. document row-at) row) node) null) (not (call is-blank-line row)))
        (let below (call min (+ row 1) (- (. document row-count) 1)))
        (let lower (call (. document row-at) below))
        (= row (if-expr (and (== (. lower node) null) (not (. lower is-divider))) (call stop-at row false) (call stop-at below true)))
      )
      (= column 0)
      (call settle)
      (call finish)
      (return)
    )
    (let opened (call opened-at index at))
    (if opened
      (call (. document replace) index (. opened declaration))
      (call seek index (. opened added) source-far-column)
      (call finish)
      (return)
    )
    (= pending null)
    (if is-thick
      (call add-declaration index)
    )
  )
  (fn-do _ open-here Bool
    (let index (call (. document declaration-at) row))
    (let is-last (and (>= index (. document declarations length)) (== (+ row 1) (. document row-count))))
    (if is-last
      (call add-declaration index)
      (return true)
    )
    (return-if false (if (>= index (. document declarations length))))
    (call begin index)
    (let opened (call opened-at index row))
    (if (not opened)
      (= pending null)
      (return false)
    )
    (let added (. opened added))
    (call (. document replace) index (. opened declaration))
    (call seek index added source-far-column)
    (call finish)
    (return true)
  )
  (fn-do _ opened-at (? SourceOpened)
    (param index Index)
    (param at Size)
    (let declaration (call (. document declaration) index))
    (return-if (call (. document language open-end) declaration (call (. document row-at) at)) (if (call is-open-end at)))
    (return (call (. document language open-below) declaration (call (. document row-at) at)))
  )
  (fn-do _ add-declaration _
    (param slot Index)
    (let added (call (. document language declaration)))
    (let id (. added id))
    (= pending (call SourceUndo slot (call (of List U32)) 1 row column))
    (call (. document splice) slot 0 (call (of List (of ImmutableTableRow SourceNode)) added))
    (call seek slot id source-far-column)
    (call finish)
  )
  (fn-do _ shift Bool
    (param deeper Bool)
    (let typed-row (call row-at row))
    (return-if (call reindent typed-row deeper) (if (call (. document language is-unparsed) (. typed-row mode))))
    (call commit)
    (return-if false (if (== (. document row-count) 0)))
    (let shown (call (. document row-at) row))
    (let home (. shown node-id))
    (let language (. document language))
    (return-if (call regroup shown deeper) (if (or (== (. shown node) null) (not (call (. language is-flow) (. shown mode))))))
    (let index (call (. document declaration-at) row))
    (let owner (call owner-of index shown))
    (let flow (call flow-of index owner))
    (let ids (call source-flow-ids flow))
    (let position (call source-flow-position flow home))
    (let heads (call source-flow-heads language flow))
    (let span (call source-flow-span language flow heads position))
    (let first ([] span 0))
    (let level (. ([] flow first) indent))
    (let above first)
    (while (and (> above 0) (> (. ([] flow (- above 1)) indent) level))
      (-= above 1)
    )
    (if deeper
      (return-if false (if (or (== above 0) (< (. ([] flow (- above 1)) indent) level) (not (call (. language can-hold) (. ([] flow (- above 1)) node))))))
      (else
        (return-if false (if (== level 0)))
      )
    )
    (let offset (- column (. shown content-start)))
    (for (in moved (..< first ([] span 1)))
      (let lower ([] flow moved))
      (= (. lower indent) (if-expr deeper (+ (. lower indent) 1) (- (. lower indent) 1)))
    )
    (let moved-heads (call source-flow-heads language flow))
    (for (in spot (..< 0 (. flow length)))
      (return-if false (if (and (!= ([] moved-heads spot) ([] heads spot)) (or (!= spot first) (!= ([] heads spot) null)))))
    )
    (let store (. document store))
    (let grown (call rebuilt index owner ids flow (call (of List Index))))
    (return-if false (if (call (. store same) (call (. language grouped) grown) (call (. document declaration) index))))
    (if deeper
      (let parent (call (. store find) grown (. ([] flow (- above 1)) node id)))
      (return-if false (if (or (not parent) (not (call (. store find) parent home)))))
    )
    (call begin index)
    (call (. document replace) index grown)
    (call seek index home offset)
    (call finish)
    (return true)
  )
  (fn-do _ regroup Bool
    (param shown SourceRow)
    (param deeper Bool)
    (let index (call (. document declaration-at) row))
    (return-if false (if (>= index (. document declarations length))))
    (let declaration (call (. document declaration) index))
    (let offset (- column (. shown content-start)))
    (let is-bare (== (. shown node) null))
    (if deeper
      (return-if false (if (== index 0)))
      (let grown (call (. document language adopt) (call (. document declaration) (- index 1)) declaration shown))
      (return-if false (if (not grown)))
      (let id (. declaration id))
      (let pair (call (of List U32) ([] (. document declarations) (- index 1)) ([] (. document declarations) index)))
      (= pending (call SourceUndo (- index 1) pair 1 row column))
      (call (. document splice) (- index 1) 2 (call (of List (of ImmutableTableRow SourceNode)) grown))
      (call land (- index 1) id is-bare offset)
      (return true)
    )
    (let released (call (. document language release) declaration shown))
    (return-if false (if (not released)))
    (let id (. released released id))
    (= pending (call SourceUndo index (call (of List U32) ([] (. document declarations) index)) 2 row column))
    (call (. document splice)
      (block
        (arg index)
        (arg 1)
        (arg (call (of List (of ImmutableTableRow SourceNode)) (. released declaration) (. released released)))
      )
    )
    (call land (+ index 1) id is-bare offset)
    (return true)
  )
  (fn-do _ land _
    (param index Index)
    (param id U32)
    (param is-bare Bool)
    (param offset Size)
    (call seek index id offset)
    (if (and is-bare (> row 0))
      (-= row 1)
      (call settle)
    )
    (call finish)
  )
  (fn-do _ splice-text Bool
    (param first Size)
    (param start Size)
    (param last Size)
    (param end Size)
    (param text String)
    (let count (. document row-count))
    (return-if false (if (< count 2)))
    (let closing (- count 1))
    (let head-row (if-expr (< first closing) first (- closing 1)))
    (let head-column (if-expr (< first closing) start (. (call row-at head-row) text length)))
    (let tail-row (if-expr (< last closing) last (- closing 1)))
    (let tail-column (if-expr (< last closing) end (. (call row-at tail-row) text length)))
    (let low (call (. document declaration-at) head-row))
    (if (and (> low 0) (== head-row (call (. document first-row) low)))
      (-= low 1)
    )
    (let high (call (. document declaration-at) tail-row))
    (let top (call (. document first-row) low))
    (let bottom (call (. document first-row) (+ high 1)))
    (let opening (. (call row-at head-row) text))
    (let ending (. (call row-at tail-row) text))
    (let reach (if-expr (< head-column (. opening length)) head-column (. opening length)))
    (let resume (if-expr (< tail-column (. ending length)) tail-column (. ending length)))
    (let left ([] opening (... _ reach)))
    (let right ([] ending (... resume)))
    (let parts (list String))
    (for (in index (..< top head-row))
      (+= parts (. (call row-at index) text))
    )
    (+= parts (++ left text right))
    (for (in index (..< (+ tail-row 1) bottom))
      (+= parts (. (call row-at index) text))
    )
    (let olds (list String))
    (for (in index (..< top bottom))
      (+= olds (. (call (. document row-at) index) text))
    )
    (let next (call (. "\n" join) parts))
    (let after (- count tail-row))
    (= is-dirty false)
    (+= revision 1)
    (if (== next (call (. "\n" join) olds))
      (= row tail-row)
      (= column (call clamped tail-column))
      (= goal-column column)
      (call collapse)
      (return true)
    )
    (call (. document discard))
    (let language (. document language))
    (let made (call source-declarations language (call (. language read) next) (== low 0)))
    (let old (list U32))
    (for (in index (..< low (+ high 1)))
      (+= old ([] (. document declarations) index))
    )
    (= pending (call SourceUndo low old (. made length) row column))
    (call (. document splice) low (+ (- high low) 1) made)
    (let now (. document row-count))
    (= row (call stop-at (if-expr (> now after) (- now after) 0) false))
    (let landed (. (call row-at row) text length))
    (= column (call clamped (if-expr (> landed (. right length)) (- landed (. right length)) 0)))
    (= goal-column column)
    (call collapse)
    (call finish)
    (return true)
  )
  (fn-do _ reindent Bool
    (param shown SourceRow)
    (param deeper Bool)
    (let offset column)
    (let lead (call leading-spaces (. shown text)))
    (let removed
      (scope (if-expr deeper 0 outdent-columns)
        (lazy outdent-columns (if-expr (< lead source-indent-columns) lead source-indent-columns))
      )
    )
    (return-if false (if (and (not deeper) (== removed 0))))
    (call splice-text row 0 row removed (if-expr deeper (* " " source-indent-columns) ""))
    (let moved
      (scope (if-expr deeper indented (if-expr (> offset removed) (- offset removed) 0))
        (lazy indented (+ offset source-indent-columns))
      )
    )
    (= column (call clamped moved))
    (= goal-column column)
    (call collapse)
    (return true)
  )
  (fn-do _ rewritten (? (of ImmutableTableRow SourceNode))
    (param shown SourceRow)
    (param text String)
    (return (call remade (call (. document store node) (!! (. shown node))) (. shown mode) text))
  )
  (fn-do _ remade (? (of ImmutableTableRow SourceNode))
    (param old (of ImmutableTableRow SourceNode))
    (param mode SourceRowMode)
    (param text String)
    (let language (. document language))
    (let store (. document store))
    (let body (call (. language children) old))
    (let read (call (. language parse) text mode))
    (let parsed (if-expr read (call (. language recast) old read) null))
    (let next (only-if parsed (if (and (!= parsed null) (or (== (. body length) 0) (call (. language can-hold) parsed))))))
    (let held (if-expr next (call (. language attach) (call (. language detach) next) body) null))
    (if (and held (== (. held refused length) 0))
      (return-if null (if (call (. store same) (. held parent) old)))
      (return (call (. store with-id) (. held parent) (. old id)))
    )
    (return (call (. store with-id) (call (. store raw) text body) (. old id)))
  )
)

(fn-do + source-write-text _
  (param session SourceSession)
  (param file-path String)
  (let written (call (. session saved-written)))
  (let flags (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
  (let file (catch? (call File file-path flags)))
  (return-if false (if (not file)))
  (let wrote (catch? (call (. file write) (. written text))))
  (catch (call (. file close)))
  (return-if false (if (== wrote null)))
  (call (. session mark-saved) written)
  (return true)
)

(type _ SourceUndo
  (prop + index Index)
  (prop + old (list U32))
  (prop + count Size)
  (prop + row Size)
  (prop + column Size)
  (prop + cells Size)
  (fn-do + This _
    (param index _)
    (param old _)
    (param count _)
    (param row _)
    (param column _)
  )
  (fn-do + move _
    (param moves SourceMoves)
    (for (in position (..< 0 (. old length)))
      (= ([] old position) (call (. moves place) ([] old position)))
    )
  )
)

(fn-do _ source-placed String
  (param lines (list String))
  (param left String)
  (let is-open (== (. (call (. left trim)) length) 0))
  (let dest (as (call source-indent-width left) Int))
  (let leads (< (. (call source-unindented ([] lines 0)) length) (. ([] lines 0) length)))
  (let anchor (if-expr (or is-open leads) (as (call source-indent-width ([] lines 0)) Int) dest))
  (let unit (as source-indent-columns Int))
  (let step Int)
  (for (in index (..< 1 (. lines length)))
    (if (> (. (call (. ([] lines index) trim)) length) 0)
      (let delta (- (as (call source-indent-width ([] lines index)) Int) anchor))
      (= step (call source-gcd step (if-expr (< delta 0) (- delta) delta)))
    )
  )
  (let placed (list String))
  (+= placed (call source-unindented ([] lines 0)))
  (for (in index (..< 1 (. lines length)))
    (let line ([] lines index))
    (if (== (. (call (. line trim)) length) 0)
      (+= placed "")
      (continue)
    )
    (let delta (- (as (call source-indent-width line) Int) anchor))
    (let moved (if-expr (or (== step 0) (== (% step unit) 0)) delta (* (/ delta step) unit)))
    (let width (+ dest moved))
    (+= placed (++ (* " " (if-expr (> width 0) (as width Size) 0)) (call source-unindented line)))
  )
  (return (call (. "\n" join) placed))
)

(fn-expr _ source-gcd Int
  (param a Int)
  (param b Int)
  (if-expr (== b 0) a (call source-gcd b (% a b)))
)

(fn-do _ source-indent-width Size
  (param text String)
  (let width Size 0)
  (for (in c (. text codepoints))
    (if (== c (char " "))
      (+= width 1)
      (else-if (== c (char "\t"))
        (+= width source-indent-columns)
      )
      (else
        (break)
      )
    )
  )
  (return width)
)

(fn-do _ source-unindented String
  (param text String)
  (let count Size 0)
  (for (in c (. text codepoints))
    (if (and (!= c (char " ")) (!= c (char "\t")))
      (break)
    )
    (+= count 1)
  )
  (return ([] text (... count)))
)

(type _ SourceToken (is (tuple (: start Size) (: end Size))))

(fn-do _ source-tokens (list SourceToken)
  (param shown SourceRow)
  (let tokens (list SourceToken))
  (let position Size 0)
  (for (in span (. shown spans))
    (let end (+ position (. span text length)))
    (if (or (== (. span kind) (. SourceSpanKind string)) (== (. span kind) (. SourceSpanKind comment)))
      (++= tokens (call source-word-tokens (. span text) position))
      (else-if (!= (. span kind) (. SourceSpanKind plain))
        (+= tokens (call SourceToken position end))
      )
    )
    (= position end)
  )
  (return tokens)
)

(fn-do _ source-word-tokens (list SourceToken)
  (param text String)
  (param offset Size)
  (let chars (. text codepoints))
  (let tokens (list SourceToken))
  (let index Index 0)
  (while (< index (. chars length))
    (let kind (call source-char-class ([] chars index)))
    (if (== kind (. CodeCharClass space))
      (+= index 1)
      (continue)
    )
    (let start index)
    (while (and (< index (. chars length)) (== (call source-char-class ([] chars index)) kind))
      (+= index 1)
    )
    (+= tokens (call SourceToken (+ offset start) (+ offset index)))
  )
  (return tokens)
)

(fn-expr _ source-char-class CodeCharClass
  (param c Char)
  (if-expr (>= (as c U32) 128) (. CodeCharClass word) (call code-byte-class (as c Byte)))
)
