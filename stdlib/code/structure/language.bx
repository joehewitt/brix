(import ./rows)
(import /core/table)
(import /data/source-sexp)
(import /data/source-tree)

(type + SourceLanguage (is Interface)
  (implements SexpLayout)
  (fn-expr + store SourceStore :get)
  (fn-expr + comment-marker String :get)
  (fn-expr + divider-line U8
    (param text String)
  )
  (fn-do + outline SourceOutline
    (param declaration (of ImmutableTableRow SourceNode))
    (param previous (? SourceOutline))
  )
  (fn-do + render SourceRow
    (param row SourceOutlineRow)
  )
  (fn-expr + mode-name String
    (param mode SourceRowMode)
  )
  (fn-expr + is-editable Bool
    (param mode SourceRowMode)
  )
  (fn-expr + is-flow Bool
    (param mode SourceRowMode)
  )
  (fn-expr + highlight (list SourceSpan)
    (param text String)
    (param mode SourceRowMode)
  )
  (fn-do + parse (? (of ImmutableTableRow SourceNode))
    (param text String)
    (param mode SourceRowMode)
  )
  (fn-do + read (list (of ImmutableTableRow SourceNode))
    (param text String)
  )
  (fn-expr + is-unparsed Bool
    (param mode SourceRowMode)
  )
  (fn-expr + is-invalid Bool
    (param node (of ImmutableTableRow SourceNode))
    (param mode SourceRowMode)
  )
  (fn-do + rereads Bool
    (param node (of ImmutableTableRow SourceNode))
    (param mode SourceRowMode)
    (param text String)
  )
  (fn-do + lead-for (? String)
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
    (param text String)
  )
  (fn-do + open-below (? SourceOpened)
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
  )
  (fn-do + open-end (? SourceOpened)
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
  )
  (fn-do + close-row SourceClosed
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
  )
  (fn-do + leave-row SourceClosed
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
  )
  (fn-do + drop-row (? (of ImmutableTableRow SourceNode))
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
  )
  (fn-do + adopt (? (of ImmutableTableRow SourceNode))
    (param upper (of ImmutableTableRow SourceNode))
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
  )
  (fn-do + release (? SourceReleased)
    (param declaration (of ImmutableTableRow SourceNode))
    (param row SourceRow)
  )
  (fn-do + children (list (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-do + detach (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-do + attach SourceHeld
    (param parent (of ImmutableTableRow SourceNode))
    (param children (list (of ImmutableTableRow SourceNode)))
  )
  (fn-do + can-hold Bool
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-do + opens Bool
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-expr + is-arm Bool
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-do + takes-arm Bool
    (param node (of ImmutableTableRow SourceNode))
    (param arm (of ImmutableTableRow SourceNode))
  )
  (fn-do + as-arm (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-do + recast (of ImmutableTableRow SourceNode)
    (param old (of ImmutableTableRow SourceNode))
    (param next (of ImmutableTableRow SourceNode))
  )
  (fn-expr + keeps-blanks Bool
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-expr + is-declaration Bool
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-do + main (? (of ImmutableTableRow SourceNode))
    (param items (list (of ImmutableTableRow SourceNode)))
  )
  (fn-do + section (of ImmutableTableRow SourceNode)
    (param items (list (of ImmutableTableRow SourceNode)))
  )
  (fn-expr + is-section Bool
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-do + unpacked (list (of ImmutableTableRow SourceNode))
    (param form (of ImmutableTableRow SourceNode))
  )
  (fn-do + grouped (of ImmutableTableRow SourceNode)
    (param declaration (of ImmutableTableRow SourceNode))
  )
  (fn-do + ungrouped (of ImmutableTableRow SourceNode)
    (param owner (of ImmutableTableRow SourceNode))
  )
  (fn-do + flow-holder (of ImmutableTableRow SourceNode)
    (param owner (of ImmutableTableRow SourceNode))
  )
  (fn-do + declaration (of ImmutableTableRow SourceNode))
  (fn-expr + closing-row SourceRow)
)

(fn-expr + source-rows (list SourceRow)
  (param language SourceLanguage)
  (param declaration (of ImmutableTableRow SourceNode))
  (spread (. (call (. language outline) declaration null) rows))
  (pipe *> (call (. language render) each))
  (pipe |> List)
)

(type + SourceOpened (is Tuple)
  (prop + declaration (of ImmutableTableRow SourceNode))
  (prop + added U32)
)

(type + SourceReleased (is Tuple)
  (prop + declaration (of ImmutableTableRow SourceNode))
  (prop + released (of ImmutableTableRow SourceNode))
)

(type + SourceHeld (is Tuple)
  (prop + parent (of ImmutableTableRow SourceNode))
  (prop + refused (list Index))
)

(type + SourceClosed (is Union)
  (variant kept)
  (variant row (tuple (: declaration (of ImmutableTableRow SourceNode))))
  (variant declaration)
)
