(import ./document)
(import ./rows)
(import ./session)
(import /code/code-find)

(type _ SourceFindRows
  (prop + rows (list CodeFindRow))
  (fn-do + This _
    (param rows _)
  )
)

(type + SourceFindCache
  (prop _ texts _ (= (call (of Map U32 SourceFindRows))))
  (prop _ compactions Size)
  (fn-do + reset _
    (= texts (call (of Map U32 SourceFindRows)))
  )
  (fn-do + rows (list CodeFindRow)
    (param session SourceSession)
    (let document (. session document))
    (if (!= (. document compaction-count) compactions)
      (= texts (call (of Map U32 SourceFindRows)))
      (= compactions (. document compaction-count))
    )
    (let kept (call (of Map U32 SourceFindRows)))
    (let made (list CodeFindRow))
    (for (in index (..< 0 (. document declarations length)))
      (for (in shown (call rows-of document index kept))
        (+= made shown)
      )
    )
    (= texts kept)
    (if (and (. session is-dirty) (< (. session row) (. made length)))
      (let typed (call (. session row-at) (. session row)))
      (= ([] made (. session row)) (call CodeFindRow (. typed content) (. typed content-start) (not (. typed is-divider))))
    )
    (return made)
  )
  (fn-do _ rows-of (list CodeFindRow)
    (param document SourceDocument)
    (param index Index)
    (param kept (map U32 SourceFindRows))
    (let place ([] (. document declarations) index))
    (let cached (?? ([] texts place) ([] kept place)))
    (if cached
      (= ([] kept place) cached)
      (return (. cached rows))
    )
    (let made (list CodeFindRow))
    (for (in outline (call (. document rows-of) index))
      (let shown (call (. document language render) outline))
      (+= made (call CodeFindRow (. shown content) (. shown content-start) (not (. shown is-divider))))
    )
    (= ([] kept place) (call SourceFindRows made))
    (return made)
  )
)
