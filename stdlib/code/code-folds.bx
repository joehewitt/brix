(import ./syntax)
(import /math)

(type + CodeFolds
  (prop + version U64)
  (blank)
  (prop _ collapsed (list SyntaxFold))
  (prop _ starts (list Size))
  (prop _ ends (list Size))
  (prop _ before (list Size))
  (prop _ hidden Size)
  (prop _ synced-version U64)
  (prop _ is-synced _ (= false))
  (fn-do + This _)
  (fn-expr + is-plain Bool :get
    (== (. collapsed length) 0)
  )
  (fn-do + row-count Size
    (param line-count Size)
    (return-if line-count (if is-plain))
    (blank)
    (call sync)
    (return (- line-count hidden))
  )
  (fn-do + shown Size
    (param line Size)
    (return-if line (if is-plain))
    (blank)
    (call sync)
    (let index (call spans-before line))
    (return-if line (if (== index 0)))
    (blank)
    (let span (- index 1))
    (return-if (- ([] starts span) ([] before span)) (if (<= line ([] ends span))))
    (return (- line ([] before span) (- ([] ends span) ([] starts span))))
  )
  (fn-do + actual Size
    (param display Size)
    (return-if display (if is-plain))
    (blank)
    (call sync)
    (let low Index 0)
    (let high (. starts length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< (- ([] starts middle) ([] before middle)) display)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return-if display (if (== low 0)))
    (blank)
    (let span (- low 1))
    (return (- (+ display ([] before span) ([] ends span)) ([] starts span)))
  )
  (fn-do + is-hidden Bool
    (param line Size)
    (return-if false (if is-plain))
    (blank)
    (call sync)
    (let index (call spans-before line))
    (return (and (> index 0) (<= line ([] ends (- index 1)))))
  )
  (fn-expr + is-folded Bool
    (param line Size)
    (!= (call folded-end line) null)
  )
  (fn-do + folded-end (? Size)
    (param line Size)
    (return-if null (if is-plain))
    (blank)
    (call sync)
    (let index (call spans-before (+ line 1)))
    (return-if null (if (or (== index 0) (!= ([] starts (- index 1)) line))))
    (return ([] ends (- index 1)))
  )
  (fn-do + has-fold Bool
    (param line Size)
    (for (in fold collapsed)
      (return-if true (if (== (. fold start) line)))
      (return-if false (if (> (. fold start) line)))
    )
    (return false)
  )
  (fn-do + collapse Bool
    (param fold SyntaxFold)
    (return-if false (if (<= (. fold end) (. fold start))))
    (blank)
    (let position Index 0)
    (while (and (< position (. collapsed length)) (< (. ([] collapsed position) start) (. fold start)))
      (+= position 1)
    )
    (return-if false (if (and (< position (. collapsed length)) (== (. ([] collapsed position) start) (. fold start)))))
    (blank)
    (call (. collapsed insert) fold position)
    (+= version 1)
    (return true)
  )
  (fn-do + unfold Bool
    (param line Size)
    (for (in position (..< 0 (. collapsed length)))
      (if (== (. ([] collapsed position) start) line)
        (call (. collapsed remove) position)
        (+= version 1)
        (return true)
      )
    )
    (return false)
  )
  (fn-do + reveal Bool
    (param line Size)
    (return-if false (if (not (call is-hidden line))))
    (blank)
    (let kept (list SyntaxFold))
    (for (in fold collapsed)
      (if (or (>= (. fold start) line) (< (. fold end) line))
        (+= kept fold)
      )
    )
    (= collapsed kept)
    (+= version 1)
    (return true)
  )
  (fn-do + fold-all _
    (param folds (list SyntaxFold))
    (let kept (list SyntaxFold))
    (for (in fold folds)
      (if (> (. fold end) (. fold start))
        (+= kept fold)
      )
    )
    (= collapsed kept)
    (+= version 1)
  )
  (fn-do + unfold-all _
    (return-if (if is-plain))
    (blank)
    (= collapsed (call (of List SyntaxFold)))
    (+= version 1)
  )
  (fn-do + shift _
    (param start SyntaxPoint)
    (param old-end SyntaxPoint)
    (param new-end SyntaxPoint)
    (return-if (if is-plain))
    (blank)
    (let kept (list SyntaxFold))
    (for (in fold collapsed)
      (if (> (. start row) (. fold end))
        (+= kept fold)
        (else-if (or ends-before (and (== (. old-end row) (. fold start)) (call keeps-head fold start old-end new-end)))
          (+= kept
            (call SyntaxFold
              (block
                (arg (+ (- (. fold start) (. old-end row)) (. new-end row)))
                (arg (+ (- (. fold end) (. old-end row)) (. new-end row)))
              )
            )
          )
        )
      )
      (lazy ends-before (< (. old-end row) (. fold start)))
    )
    (= collapsed kept)
    (+= version 1)
  )
  (fn-expr _ keeps-head Bool
    (param fold SyntaxFold)
    (param start SyntaxPoint)
    (param old-end SyntaxPoint)
    (param new-end SyntaxPoint)
    (or (< (. start row) (. fold start)) (== (. old-end column) 0) (== (. new-end row) (. old-end row)))
  )
  (fn-do _ spans-before Index
    (param line Size)
    (let low Index 0)
    (let high (. starts length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< ([] starts middle) line)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
  (fn-do _ sync _
    (return-if (if (and is-synced (== synced-version version))))
    (blank)
    (= is-synced true)
    (= synced-version version)
    (let made-starts (list Size))
    (let made-ends (list Size))
    (for (in fold collapsed)
      (let count (. made-starts length))
      (if (and (> count 0) (<= (. fold start) ([] made-ends (- count 1))))
        (= ([] made-ends (- count 1)) (call max ([] made-ends (- count 1)) (. fold end)))
        (else
          (+= made-starts (. fold start))
          (+= made-ends (. fold end))
        )
      )
    )
    (let made-before (list Size))
    (let total Size 0)
    (for (in index (..< 0 (. made-starts length)))
      (+= made-before total)
      (+= total (- ([] made-ends index) ([] made-starts index)))
    )
    (= starts made-starts)
    (= ends made-ends)
    (= before made-before)
    (= hidden total)
  )
)
