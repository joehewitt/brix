(import ./code-text)
(import ./syntax)
(import /math)
(blank)
(prop _ md-fence-lookback Size (= 400))

(type + CodeHighlighter (is Interface)
  (fn-do + runs (list SyntaxStyledRun)
    (param text CodeText)
    (param line Size)
  )
)

(type + MarkdownCodeHighlighter
  (implements CodeHighlighter)
  (fn-do + runs (list SyntaxStyledRun)
    (param text CodeText)
    (param line Size)
    (let raw (call (. text line-text) line))
    (return-if (call (of List SyntaxStyledRun)) (if (== (. raw size) 0)))
    (blank)
    (let bytes (call byte-view raw))
    (let length (. bytes size))
    (let in-fence (call markdown-in-fence text line))
    (let fence (call markdown-fence-info bytes length))
    (if (!= fence null)
      (return (call markdown-fence-runs raw bytes length fence))
    )
    (if in-fence
      (return (list (call SyntaxStyledRun raw (. SyntaxRole string))))
    )
    (let indent (call markdown-leading-space bytes length))
    (if (>= indent length)
      (return (list (call SyntaxStyledRun raw (. SyntaxRole plain))))
    )
    (let heading (call markdown-heading-prefix bytes length indent))
    (if (> heading 0)
      (let result (list SyntaxStyledRun))
      (if (> indent 0)
        (+= result (call SyntaxStyledRun (call slice-bytes raw 0 indent) (. SyntaxRole plain)))
      )
      (+= result (call SyntaxStyledRun (call slice-bytes raw indent (+ indent heading)) (. SyntaxRole operator)))
      (if (< (+ indent heading) length)
        (+= result (call SyntaxStyledRun (call slice-bytes raw (+ indent heading) length) (. SyntaxRole keyword)))
      )
      (return result)
    )
    (if (call markdown-is-rule bytes length indent)
      (return (list (call SyntaxStyledRun raw (. SyntaxRole comment))))
    )
    (if (== ([] bytes indent) 62)
      (let marker-end (+ indent 1))
      (while (and (< marker-end length) (or (== ([] bytes marker-end) 62) (== ([] bytes marker-end) 32)))
        (+= marker-end 1)
      )
      (let result (list SyntaxStyledRun))
      (if (> indent 0)
        (+= result (call SyntaxStyledRun (call slice-bytes raw 0 indent) (. SyntaxRole plain)))
      )
      (+= result (call SyntaxStyledRun (call slice-bytes raw indent marker-end) (. SyntaxRole operator)))
      (if (< marker-end length)
        (+= result (call SyntaxStyledRun (call slice-bytes raw marker-end length) (. SyntaxRole comment)))
      )
      (return result)
    )
    (let result (list SyntaxStyledRun))
    (let body-start indent)
    (if (> indent 0)
      (+= result (call SyntaxStyledRun (call slice-bytes raw 0 indent) (. SyntaxRole plain)))
    )
    (let list-end (call markdown-list-marker bytes length indent))
    (if (> list-end indent)
      (let is-ordered (and (>= ([] bytes indent) 48) (<= ([] bytes indent) 57)))
      (let role (if-expr is-ordered (. SyntaxRole number) (. SyntaxRole operator)))
      (+= result (call SyntaxStyledRun (call slice-bytes raw indent list-end) role))
      (= body-start list-end)
      (let check-end (call markdown-checkbox-end bytes length body-start))
      (if (> check-end body-start)
        (let mark ([] bytes (+ body-start 1)))
        (let is-checked (or (== mark 120) (== mark 88)))
        (let check-role (if-expr is-checked (. SyntaxRole constant) (. SyntaxRole punctuation)))
        (+= result (call SyntaxStyledRun (call slice-bytes raw body-start check-end) check-role))
        (= body-start check-end)
      )
    )
    (call markdown-inline-runs raw bytes body-start length result)
    (return result)
  )
)

(prop + markdown-code-highlighter _ (:= (call MarkdownCodeHighlighter)))

(fn-do _ markdown-in-fence Bool
  (param text CodeText)
  (param line Size)
  (let start (if-expr (> line md-fence-lookback) (- line md-fence-lookback) 0))
  (let open false)
  (let marker Byte 0)
  (let count Size 0)
  (for (in index (..< start line))
    (let raw (call (. text line-text) index))
    (let bytes (call byte-view raw))
    (let info (call markdown-fence-info bytes (. bytes size)))
    (if (!= info null)
      (let lead ([] bytes info))
      (let run (call markdown-fence-run bytes (. bytes size) info lead))
      (if (not open)
        (= open true)
        (= marker lead)
        (= count run)
        (else-if (and (== lead marker) (>= run count) (call markdown-rest-blank bytes (. bytes size) (+ info run)))
          (= open false)
        )
      )
    )
  )
  (return open)
)

(fn-do _ markdown-fence-info (? Size)
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (let indent (call markdown-leading-space bytes length))
  (return-if null (if (or (> indent 3) (>= indent length))))
  (blank)
  (let lead ([] bytes indent))
  (return-if null (if (and (!= lead 96) (!= lead 126))))
  (blank)
  (let run (call markdown-fence-run bytes length indent lead))
  (return-if null (if (< run 3)))
  (return indent)
)

(fn-do _ markdown-fence-run Size
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (param start Size)
  (param marker Byte)
  (let index start)
  (while (and (< index length) (== ([] bytes index) marker))
    (+= index 1)
  )
  (return (- index start))
)

(fn-do _ markdown-rest-blank Bool
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (param start Size)
  (let index start)
  (while (< index length)
    (let byte ([] bytes index))
    (return-if false (if (and (!= byte 32) (!= byte 9))))
    (+= index 1)
  )
  (return true)
)

(fn-do _ markdown-fence-runs (list SyntaxStyledRun)
  (param raw String)
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (param indent Size)
  (let result (list SyntaxStyledRun))
  (if (> indent 0)
    (+= result (call SyntaxStyledRun (call slice-bytes raw 0 indent) (. SyntaxRole plain)))
  )
  (let run (call markdown-fence-run bytes length indent ([] bytes indent)))
  (let fence-end (+ indent run))
  (+= result (call SyntaxStyledRun (call slice-bytes raw indent fence-end) (. SyntaxRole punctuation)))
  (if (< fence-end length)
    (+= result (call SyntaxStyledRun (call slice-bytes raw fence-end length) (. SyntaxRole type-name)))
  )
  (return result)
)

(fn-do _ markdown-leading-space Size
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (let index Size 0)
  (while (and (< index length) (or (== ([] bytes index) 32) (== ([] bytes index) 9)))
    (+= index 1)
  )
  (return index)
)

(fn-do _ markdown-heading-prefix Size
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (param indent Size)
  (let count Size 0)
  (while (and (< (+ indent count) length) (< count 6) (== ([] bytes (+ indent count)) 35))
    (+= count 1)
  )
  (return-if 0 (if (== count 0)))
  (blank)
  (let after (+ indent count))
  (return-if count (if (or (== after length) (== ([] bytes after) 32) (== ([] bytes after) 9))))
  (return 0)
)

(fn-do _ markdown-is-rule Bool
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (param indent Size)
  (let marker ([] bytes indent))
  (return-if false (if (and (!= marker 45) (!= marker 42) (!= marker 95))))
  (blank)
  (let count Size 0)
  (let index indent)
  (while (< index length)
    (let byte ([] bytes index))
    (if (== byte marker)
      (+= count 1)
      (else-if (and (!= byte 32) (!= byte 9))
        (return false)
      )
    )
    (+= index 1)
  )
  (return (>= count 3))
)

(fn-do _ markdown-list-marker Size
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (param indent Size)
  (let byte ([] bytes indent))
  (if (or (== byte 45) (== byte 42) (== byte 43))
    (let after (+ indent 1))
    (return-if (+ after 1) (if (and (< after length) (or (== ([] bytes after) 32) (== ([] bytes after) 9)))))
    (return indent)
  )
  (if (and (>= byte 48) (<= byte 57))
    (let index indent)
    (while (and (< index length) (>= ([] bytes index) 48) (<= ([] bytes index) 57))
      (+= index 1)
    )
    (if (and (< (+ index 1) length) (or (== ([] bytes index) 46) (== ([] bytes index) 41)) (or (== ([] bytes (+ index 1)) 32) (== ([] bytes (+ index 1)) 9)))
      (return (+ index 2))
    )
  )
  (return indent)
)

(fn-do _ markdown-checkbox-end Size
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (param start Size)
  (return-if start (if (< (- length start) 3)))
  (return-if start (if (or (!= ([] bytes start) 91) (!= ([] bytes (+ start 2)) 93))))
  (blank)
  (let mark ([] bytes (+ start 1)))
  (return-if start (if (and (!= mark 32) (!= mark 120) (!= mark 88))))
  (blank)
  (let after (+ start 3))
  (return-if after (if (== after length)))
  (return-if (+ after 1) (if (or (== ([] bytes after) 32) (== ([] bytes after) 9))))
  (return start)
)

(fn-do _ markdown-inline-runs _
  (param raw String)
  (param bytes (of ImmutableArray Byte))
  (param start Size)
  (param length Size)
  (param runs (list SyntaxStyledRun))
  (let plain-start start)
  (let index start)
  (while (< index length)
    (let byte ([] bytes index))
    (if (== byte 96)
      (let ticks Size 0)
      (while (and (< (+ index ticks) length) (== ([] bytes (+ index ticks)) 96))
        (+= ticks 1)
      )
      (let close (call find-backticks bytes (+ index ticks) length ticks))
      (if (!= close null)
        (call flush-plain raw plain-start index runs)
        (let end (+ close ticks))
        (+= runs (call SyntaxStyledRun (call slice-bytes raw index end) (. SyntaxRole string)))
        (= index end)
        (= plain-start end)
        (continue)
      )
      (+= index ticks)
      (continue)
    )
    (if (and (== byte 91) (< (+ index 2) length))
      (let close-bracket (call find-byte bytes (+ index 1) length 93))
      (if (and (!= close-bracket null) (< (+ close-bracket 2) length) (== ([] bytes (+ close-bracket 1)) 40))
        (let close-paren (call find-byte bytes (+ close-bracket 2) length 41))
        (if (!= close-paren null)
          (call flush-plain raw plain-start index runs)
          (+= runs (call SyntaxStyledRun "[" (. SyntaxRole punctuation)))
          (if (> close-bracket (+ index 1))
            (+= runs (call SyntaxStyledRun (call slice-bytes raw (+ index 1) close-bracket) (. SyntaxRole label)))
          )
          (+= runs (call SyntaxStyledRun "](" (. SyntaxRole punctuation)))
          (if (> close-paren (+ close-bracket 2))
            (+= runs (call SyntaxStyledRun (call slice-bytes raw (+ close-bracket 2) close-paren) (. SyntaxRole string)))
          )
          (+= runs (call SyntaxStyledRun ")" (. SyntaxRole punctuation)))
          (= index (+ close-paren 1))
          (= plain-start index)
          (continue)
        )
      )
    )
    (if (or (== byte 42) (== byte 95) (== byte 126))
      (let is-double (and (< (+ index 1) length) (== ([] bytes (+ index 1)) byte)))
      (if is-double
        (let close (call find-double-byte bytes (+ index 2) length byte))
        (if (and (!= close null) (> close (+ index 2)))
          (call flush-plain raw plain-start index runs)
          (let delim (call slice-bytes raw index (+ index 2)))
          (let role (if-expr (== byte 126) (. SyntaxRole comment) (. SyntaxRole function)))
          (+= runs (call SyntaxStyledRun delim (. SyntaxRole punctuation)))
          (+= runs (call SyntaxStyledRun (call slice-bytes raw (+ index 2) close) role))
          (+= runs (call SyntaxStyledRun delim (. SyntaxRole punctuation)))
          (= index (+ close 2))
          (= plain-start index)
          (continue)
        )
        (else-if (and (!= byte 126) (or (== index start) (== ([] bytes (- index 1)) 32) (== ([] bytes (- index 1)) 40)))
          (let close (call find-single-emph bytes (+ index 1) length byte))
          (if (and (!= close null) (> close (+ index 1)))
            (call flush-plain raw plain-start index runs)
            (let delim (call slice-bytes raw index (+ index 1)))
            (+= runs (call SyntaxStyledRun delim (. SyntaxRole punctuation)))
            (+= runs (call SyntaxStyledRun (call slice-bytes raw (+ index 1) close) (. SyntaxRole variable)))
            (+= runs (call SyntaxStyledRun delim (. SyntaxRole punctuation)))
            (= index (+ close 1))
            (= plain-start index)
            (continue)
          )
        )
      )
    )
    (if (and (== byte 104) (call starts-url bytes index length))
      (let end index)
      (while (and (< end length) (> ([] bytes end) 32) (!= ([] bytes end) 41) (!= ([] bytes end) 93) (!= ([] bytes end) 62))
        (+= end 1)
      )
      (call flush-plain raw plain-start index runs)
      (+= runs (call SyntaxStyledRun (call slice-bytes raw index end) (. SyntaxRole string)))
      (= index end)
      (= plain-start end)
      (continue)
    )
    (+= index 1)
  )
  (call flush-plain raw plain-start length runs)
)

(fn-do _ flush-plain _
  (param raw String)
  (param start Size)
  (param end Size)
  (param runs (list SyntaxStyledRun))
  (if (> end start)
    (+= runs (call SyntaxStyledRun (call slice-bytes raw start end) (. SyntaxRole plain)))
  )
)

(fn-expr _ slice-bytes String
  (param raw String)
  (param start Size)
  (param end Size)
  (call (. (call byte-view raw) slice-string) (..< start end))
)

(fn-do _ find-byte (? Size)
  (param bytes (of ImmutableArray Byte))
  (param start Size)
  (param length Size)
  (param target Byte)
  (let index start)
  (while (< index length)
    (return-if index (if (== ([] bytes index) target)))
    (+= index 1)
  )
  (return null)
)

(fn-do _ find-backticks (? Size)
  (param bytes (of ImmutableArray Byte))
  (param start Size)
  (param length Size)
  (param count Size)
  (let index start)
  (while (< index length)
    (if (== ([] bytes index) 96)
      (let run Size 0)
      (while (and (< (+ index run) length) (== ([] bytes (+ index run)) 96))
        (+= run 1)
      )
      (return-if index (if (== run count)))
      (+= index run)
      (else
        (+= index 1)
      )
    )
  )
  (return null)
)

(fn-do _ find-double-byte (? Size)
  (param bytes (of ImmutableArray Byte))
  (param start Size)
  (param length Size)
  (param target Byte)
  (let index start)
  (while (< (+ index 1) length)
    (return-if index (if (and (== ([] bytes index) target) (== ([] bytes (+ index 1)) target))))
    (+= index 1)
  )
  (return null)
)

(fn-do _ find-single-emph (? Size)
  (param bytes (of ImmutableArray Byte))
  (param start Size)
  (param length Size)
  (param target Byte)
  (return-if null (if (or (>= start length) (== ([] bytes start) 32))))
  (blank)
  (let index start)
  (while (< index length)
    (if (and (== ([] bytes index) target) (!= ([] bytes (- index 1)) 32))
      (return-if index (if (or (== (+ index 1) length) (!= ([] bytes (+ index 1)) target))))
    )
    (+= index 1)
  )
  (return null)
)

(fn-do _ starts-url Bool
  (param bytes (of ImmutableArray Byte))
  (param index Size)
  (param length Size)
  (return-if false (if (< (- length index) 8)))
  (return-if false (if (or (!= ([] bytes index) 104) (!= ([] bytes (+ index 1)) 116) (!= ([] bytes (+ index 2)) 116) (!= ([] bytes (+ index 3)) 112))))
  (blank)
  (let rest (+ index 4))
  (if (== ([] bytes rest) 115)
    (+= rest 1)
  )
  (return (and (< (+ rest 2) length) (== ([] bytes rest) 58) (== ([] bytes (+ rest 1)) 47) (== ([] bytes (+ rest 2)) 47)))
)
