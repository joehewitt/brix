(import ./code-comments)
(import ./code-folds)
(import ./code-text)
(import ./syntax)
(import /data/diff)
(import /math)
(import /stream/aggregate)
(import /ui/command-history)
(blank)
(prop _ code-window-before Size (= 100))
(prop _ code-window-after Size (= 200))
(prop _ code-indent-sample-lines Size (= 400))
(prop _ code-open-parse-budget U32 (= 40000))
(prop _ code-edit-parse-budget U32 (= 4000))

(type + CodeSession
  (implements Closable)
  (prop + text CodeText)
  (prop + language (? SyntaxLanguage))
  (prop + comment-marker (? String))
  (prop + caret Size)
  (prop + anchor Size)
  (prop + revision U64 (= 1))
  (prop + tab-width Size (= 4))
  (prop + indent-unit String (= "    "))
  (prop + has-parse-error Bool)
  (prop + widest-columns Size)
  (prop + line-changes (list DiffLineChange))
  (prop + folds _ (= (call CodeFolds)))
  (prop + history _ (= (call CommandHistory)))
  (event + updated U64)
  (blank)
  (prop _ document (? SyntaxDocument))
  (prop _ goal-column (? Size))
  (prop _ window-first Size)
  (prop _ window-spans (list (list SyntaxSpan)))
  (prop _ window-revision U64)
  (prop _ baseline (? ([] Byte)))
  (prop _ edit-stamp U64)
  (prop _ marker (? Task))
  (prop _ marked-stamp U64)
  (prop _ fold-window (list SyntaxFold))
  (prop _ fold-first Size)
  (prop _ fold-last Size)
  (prop _ fold-revision U64)
  (fn-do + This _
    (param source String (= ""))
    (param language (? SyntaxLanguage) (= null))
    (lazy text (call CodeText source))
    (= (. this language) language)
    (= (. history limit) null)
    (= (. history coalescing) null)
    (= indent-unit (call detect-indent))
    (if language
      (= document (call SyntaxDocument language))
      (call reparse code-open-parse-budget)
    )
    (for (in line (..< 0 (. text line-count)))
      (= widest-columns (call max widest-columns (call line-columns line)))
    )
  )
  (fn-do + close _
    (= baseline null)
    (let active document)
    (if active
      (call (. active close))
      (= document null)
    )
  )
  (fn-expr + line-count Size :get
    (. text line-count)
  )
  (fn-expr + is-modified Bool :get
    (. history is-modified)
  )
  (fn-expr + is-parsing Bool :get
    (?? (?. document is-parsing) false)
  )
  (fn-expr + has-selection Bool :get
    (!= caret anchor)
  )
  (fn-expr + selection-start Size :get
    (call min caret anchor)
  )
  (fn-expr + selection-end Size :get
    (call max caret anchor)
  )
  (fn-expr + selected-text String :get
    (call (. text text-in) selection-start selection-end)
  )
  (fn-expr + caret-point SyntaxPoint :get
    (call (. text point-at) caret)
  )
  (fn-expr + caret-line Size :get
    (call (. text line-at) caret)
  )
  (fn-expr + caret-column Size :get
    (call display-column caret)
  )
  (fn-expr + caret-prefix String :get
    (call (. text text-in) (call (. text line-start) (call (. text line-at) caret)) caret)
  )
  (fn-do + compare-with _
    (param source (? String))
    (+= edit-stamp 1)
    (if (== source null)
      (= baseline null)
      (= line-changes (call (of List DiffLineChange)))
      (<- updated revision)
      (else
        (= baseline (call code-text-bytes (call CodeText source)))
        (call start-marking)
      )
    )
  )
  (fn-do + mark-saved _
    (call (. history mark-saved))
    (<- updated revision)
  )
  (fn-do + reload _
    (param source String)
    (let fresh (call CodeText source))
    (let old-length (. text length))
    (let new-length (. fresh length))
    (let limit (call min old-length new-length))
    (let prefix Size 0)
    (while (and (< prefix limit) (== ([] (. text bytes) prefix) ([] (. fresh bytes) prefix)))
      (+= prefix 1)
    )
    (while (and (> prefix 0) (or (call code-splits-character text prefix) (call code-splits-character fresh prefix)))
      (-= prefix 1)
    )
    (let suffix Size 0)
    (while (and (< suffix (- limit prefix)) (== ([] (. text bytes) (- old-length suffix 1)) ([] (. fresh bytes) (- new-length suffix 1))))
      (+= suffix 1)
    )
    (while (and (> suffix 0) (or (call code-splits-character text (- old-length suffix)) (call code-splits-character fresh (- new-length suffix))))
      (-= suffix 1)
    )
    (let old-end (- old-length suffix))
    (let new-end (- new-length suffix))
    (if (or (< prefix old-end) (< prefix new-end))
      (let old-caret caret)
      (let old-anchor anchor)
      (call edit prefix old-end (call (. fresh text-in) prefix new-end) "Reload")
      (= caret (call code-reloaded-offset old-caret prefix old-end new-end))
      (= anchor (call code-reloaded-offset old-anchor prefix old-end new-end))
    )
    (call mark-saved)
  )
  (fn-expr + display-column Size
    (param offset Size)
    (call columns-between (call (. text line-start) line) offset)
    (where
      (lazy line (call (. text line-at) offset))
    )
  )
  (fn-expr + line-columns Size
    (param line Size)
    (call columns-between (call (. text line-start) line) (call (. text line-end) line))
  )
  (fn-do + columns-between Size
    (param start Size)
    (param end Size)
    (let column Size 0)
    (let index start)
    (while (< index end)
      (= column (call advance-column index column))
      (= index (call (. text next-char) index))
    )
    (return column)
  )
  (fn-do + offset-at-column Size
    (param line Size)
    (param target Float)
    (let index (call (. text line-start) line))
    (let end (call (. text line-end) line))
    (let column Size 0)
    (while (< index end)
      (let next-column (call advance-column index column))
      (let left (as column Float))
      (let right (as next-column Float))
      (if (> right target)
        (return-if (call (. text next-char) index) (if (> (- target left) (- right target))))
        (return index)
      )
      (= column next-column)
      (= index (call (. text next-char) index))
    )
    (return end)
  )
  (fn-do + line-spans (list SyntaxSpan)
    (param line Size)
    (if (or (!= window-revision revision) (< line window-first) (>= line (+ window-first (. window-spans length))))
      (call load-window line)
    )
    (return ([] window-spans (- line window-first)))
  )
  (fn-expr + styled-runs (list SyntaxStyledRun)
    (param line Size)
    (call expanded-tabs runs start)
    (where
      (lazy start (call (. text line-start) line))
      (lazy roles (?? (?. language roles) (call (of List SyntaxRole))))
      (lazy runs (call syntax-styled-runs (. text bytes) start (call (. text line-end) line) (call line-spans line) roles))
    )
  )
  (fn-do + undo Bool
    (return-if false (if (not (. history can-undo))))
    (call (. history undo))
    (return true)
  )
  (fn-do + redo Bool
    (return-if false (if (not (. history can-redo))))
    (call (. history redo))
    (return true)
  )
  (fn-do + type _
    (param typed String)
    (param replaces-before Size (= 0))
    (param replaces-length Size (= 0))
    (return-if (if (and (== (. typed size) 0) (== replaces-length 0))))
    (let start selection-start)
    (let end selection-end)
    (if (and (> replaces-before 0) (not has-selection))
      (for (in index (..< 0 replaces-before))
        (= start (call (. text previous-char) start))
      )
      (= end start)
      (for (in index (..< 0 replaces-length))
        (= end (call (. text next-char) end))
      )
    )
    (if (and (call is-closing typed) (not has-selection) (== replaces-before 0))
      (let line-start (call (. text line-start) (call (. text line-at) start)))
      (let prefix (call (. text text-in) line-start start))
      (if (and (> (. prefix size) 0) (== (. (call (. prefix trim)) size) 0))
        (call edit line-start end (+ (call outdented prefix) typed) "Typing")
        (return)
      )
    )
    (call edit start end typed "Typing" (and (== (. typed size) 1) (!= typed "\n") (== start end)))
  )
  (fn-do + paste _
    (param pasted String)
    (let normalized (call (. "\n" join) (call (. pasted split) "\r\n")))
    (call edit selection-start selection-end normalized "Paste")
  )
  (fn-do + newline _
    (let start selection-start)
    (let end selection-end)
    (let line-start (call (. text line-start) (call (. text line-at) start)))
    (let prefix (call (. text text-in) line-start start))
    (let indent (call leading-whitespace prefix))
    (let opener (call last-meaningful-byte line-start start))
    (let opens (call code-opens-block opener))
    (if (and opens (< end (. text length)) (== (call code-closer opener) (call (. text byte-at) end)))
      (call edit start end (str "\n" indent indent-unit "\n" indent) "Typing")
      (= caret (+ start 1 (. indent size) (. indent-unit size)))
      (= anchor caret)
      (return)
    )
    (call edit start end (str "\n" indent (if-expr opens indent-unit "")) "Typing")
  )
  (fn-do + insert-tab _
    (if (and has-selection (!= (call (. text line-at) selection-start) (call (. text line-at) selection-end)))
      (call indent-lines)
      (return)
    )
    (if (== indent-unit "\t")
      (call edit selection-start selection-end "\t" "Typing")
      (return)
    )
    (let column (call display-column selection-start))
    (call edit selection-start selection-end (* " " (- tab-width (% column tab-width))) "Typing")
  )
  (fn-do + indent-lines _
    (let first (call (. text line-at) selection-start))
    (let last (call last-selected-line))
    (let block-start (call (. text line-start) first))
    (let block-end (call (. text line-end) last))
    (let lines (call (. (call (. text text-in) block-start block-end) split) "\n"))
    (let changed (call (. "\n" join) (in (+ (if-expr (== (. each size) 0) "" indent-unit) each) lines)))
    (call edit block-start block-end changed "Indent")
    (= anchor block-start)
    (= caret (+ block-start (. changed size)))
  )
  (fn-do + toggle-comment _
    (let marker comment-marker)
    (return-if (if (not marker)))
    (let first (call (. text line-at) selection-start))
    (let last (call last-selected-line))
    (let block-start (call (. text line-start) first))
    (let block-end (call (. text line-end) last))
    (let original (call (. text text-in) block-start block-end))
    (let lines (call (of List String) (call (. original split) "\n")))
    (let changed (call (. "\n" join) (call code-toggled-comments lines marker)))
    (return-if (if (== changed original)))
    (let keeps-selection has-selection)
    (let old-caret caret)
    (let marker-at (+ block-start (call code-indent-size ([] lines 0))))
    (call edit block-start block-end changed "Toggle Comment")
    (if keeps-selection
      (= anchor block-start)
      (= caret (+ block-start (. changed size)))
      (else-if (>= old-caret marker-at)
        (= caret (call max marker-at (- (+ old-caret (. changed size)) (. original size))))
        (= anchor caret)
      )
      (else
        (= caret old-caret)
        (= anchor caret)
      )
    )
  )
  (fn-do + outdent-lines _
    (let first (call (. text line-at) selection-start))
    (let last (call last-selected-line))
    (let block-start (call (. text line-start) first))
    (let block-end (call (. text line-end) last))
    (let lines (call (. (call (. text text-in) block-start block-end) split) "\n"))
    (let changed (call (. "\n" join) (in (call outdented-line each) lines)))
    (return-if (if (== changed (call (. text text-in) block-start block-end))))
    (let keeps-selection has-selection)
    (call edit block-start block-end changed "Outdent")
    (if keeps-selection
      (= anchor block-start)
      (= caret (+ block-start (. changed size)))
    )
  )
  (fn-do + delete-backward _
    (if has-selection
      (call delete-selection)
      (return)
    )
    (return-if (if (== caret 0)))
    (let line-start (call (. text line-start) (call (. text line-at) caret)))
    (let prefix (call (. text text-in) line-start caret))
    (if (and (> (. prefix size) 0) (!= indent-unit "\t") (call is-all-spaces prefix))
      (let column (call display-column caret))
      (let count (+ (% (- column 1) tab-width) 1))
      (call edit (- caret (call min count (. prefix size))) caret "" "Delete" true)
      (return)
    )
    (call edit (call (. text previous-char) caret) caret "" "Delete" true)
  )
  (fn-do + delete-forward _
    (if has-selection
      (call delete-selection)
      (return)
    )
    (return-if (if (>= caret (. text length))))
    (call edit caret (call (. text next-char) caret) "" "Delete" true)
  )
  (fn-do + delete-word-backward _
    (if has-selection
      (call delete-selection)
      (return)
    )
    (call edit (call word-left caret) caret "" "Delete")
  )
  (fn-do + delete-word-forward _
    (if has-selection
      (call delete-selection)
      (return)
    )
    (call edit caret (call word-right caret) "" "Delete")
  )
  (fn-do + delete-to-line-start _
    (if has-selection
      (call delete-selection)
      (return)
    )
    (let line-start (call (. text line-start) (call (. text line-at) caret)))
    (call edit (if-expr (> caret line-start) line-start (call (. text previous-char) caret)) caret "" "Delete")
  )
  (fn-do + delete-to-line-end _
    (if has-selection
      (call delete-selection)
      (return)
    )
    (let line-end (call (. text line-end) (call (. text line-at) caret)))
    (call edit caret (if-expr (< caret line-end) line-end (call (. text next-char) caret)) "" "Delete")
  )
  (fn-do + replace _
    (param start Size)
    (param end Size)
    (param inserted String)
    (param coalescing _ (= false))
    (param title (? String) (= null))
    (call edit
      (block
        (arg (call min start (. text length)))
        (arg (call min end (. text length)))
        (arg inserted)
        (arg (?? title (if-expr coalescing "Typing" "Edit")))
        (arg coalescing)
      )
    )
  )
  (fn-do + delete-selection _
    (call edit selection-start selection-end "" "Delete")
  )
  (fn-do + replace-ranges _
    (param starts (list Size))
    (param ends (list Size))
    (param texts (list String))
    (param title _ (= "Replace"))
    (return-if (if (== (. starts length) 0)))
    (let low ([] starts 0))
    (let parts (list String))
    (let last low)
    (for (in index (..< 0 (. starts length)))
      (+= parts (call (. text text-in) last ([] starts index)))
      (+= parts ([] texts index))
      (= last ([] ends index))
    )
    (call edit low last (call (. "" join) parts) title)
  )
  (fn-do + move-to _
    (param offset Size)
    (param extends _ (= false))
    (param keeps-goal _ (= false))
    (= caret (call min offset (. text length)))
    (if (not extends)
      (= anchor caret)
    )
    (if (not keeps-goal)
      (= goal-column null)
    )
    (call (. history seal))
  )
  (fn-do + move-left _
    (param extends _ (= false))
    (if (and has-selection (not extends))
      (call move-to selection-start)
      (else
        (call move-to (call visible (call (. text previous-char) caret) false) extends)
      )
    )
  )
  (fn-do + move-right _
    (param extends _ (= false))
    (if (and has-selection (not extends))
      (call move-to selection-end)
      (else
        (call move-to (call visible (call (. text next-char) caret) true) extends)
      )
    )
  )
  (fn-do + move-up _
    (param extends _ (= false))
    (param count Size (= 1))
    (let display (call (. folds shown) (call (. text line-at) caret)))
    (if (== display 0)
      (call move-to 0 extends)
      (return)
    )
    (let goal (?? goal-column (call display-column caret)))
    (let target (call (. folds actual) (if-expr (> display count) (- display count) 0)))
    (call move-to (call offset-at-column target (as goal Float)) extends true)
    (= goal-column goal)
  )
  (fn-do + move-down _
    (param extends _ (= false))
    (param count Size (= 1))
    (let display (call (. folds shown) (call (. text line-at) caret)))
    (let rows (call (. folds row-count) (. text line-count)))
    (if (>= (+ display 1) rows)
      (call move-to (call (. text line-end) (call (. folds actual) (- rows 1))) extends)
      (return)
    )
    (let goal (?? goal-column (call display-column caret)))
    (let target (call (. folds actual) (call min (+ display count) (- rows 1))))
    (call move-to (call offset-at-column target (as goal Float)) extends true)
    (= goal-column goal)
  )
  (fn-do + move-word-left _
    (param extends _ (= false))
    (call move-to (call visible (call word-left caret) false) extends)
  )
  (fn-do + move-word-right _
    (param extends _ (= false))
    (call move-to (call visible (call word-right caret) true) extends)
  )
  (fn-do + move-to-line-start _
    (param extends _ (= false))
    (let line-start (call (. text line-start) (call (. text line-at) caret)))
    (let indented
      (scope (+ line-start (. (call leading-whitespace (call (. text text-in) line-start line-end)) size))
        (lazy line-end (call (. text line-end) (call (. text line-at) caret)))
      )
    )
    (call move-to (if-expr (== caret indented) line-start indented) extends)
  )
  (fn-do + move-to-line-end _
    (param extends _ (= false))
    (call move-to (call (. text line-end) (call (. text line-at) caret)) extends)
  )
  (fn-do + move-to-start _
    (param extends _ (= false))
    (call move-to 0 extends)
  )
  (fn-do + move-to-end _
    (param extends _ (= false))
    (call move-to (. text length) extends)
  )
  (fn-do + select-all _
    (= anchor 0)
    (= caret (. text length))
    (= goal-column null)
    (call (. history seal))
  )
  (fn-do + collapse _
    (= anchor caret)
  )
  (fn-do + place _
    (param line Size)
    (param column Float)
    (param extends _ (= false))
    (let target (call min line (- (. text line-count) 1)))
    (call move-to (call offset-at-column target column) extends)
  )
  (fn-do + select-range _
    (param start Size)
    (param end Size)
    (= anchor (call min start (. text length)))
    (= caret (call min end (. text length)))
    (= goal-column null)
    (call (. history seal))
  )
  (fn-do + select-word-at _
    (param offset Size)
    (let low offset)
    (let high offset)
    (let kind (if-expr (< offset (. text length)) (call char-class offset) (. CodeCharClass newline)))
    (if (and (== kind (. CodeCharClass newline)) (> offset 0))
      (= kind (call char-class (call (. text previous-char) offset)))
      (= low (call (. text previous-char) offset))
      (= high low)
    )
    (while (and (> low 0) (== (call char-class (call (. text previous-char) low)) kind))
      (= low (call (. text previous-char) low))
    )
    (while (and (< high (. text length)) (== (call char-class high) kind))
      (= high (call (. text next-char) high))
    )
    (= anchor low)
    (= caret high)
    (= goal-column null)
    (call (. history seal))
  )
  (fn-do + word-at String
    (param offset Size)
    (let low offset)
    (let high offset)
    (while (and (> low 0) (== (call char-class (call (. text previous-char) low)) (. CodeCharClass word)))
      (= low (call (. text previous-char) low))
    )
    (while (and (< high (. text length)) (== (call char-class high) (. CodeCharClass word)))
      (= high (call (. text next-char) high))
    )
    (return (call (. text text-in) low high))
  )
  (fn-do + select-line _
    (param line Size)
    (let last (?? (call (. folds folded-end) line) line))
    (= anchor (call (. text line-start) line))
    (= caret (if-expr (< (+ last 1) (. text line-count)) (call (. text line-start) (+ last 1)) (. text length)))
    (= goal-column null)
    (call (. history seal))
  )
  (fn-do + word-left Size
    (param offset Size)
    (let index offset)
    (while (and (> index 0) (== (call char-class (call (. text previous-char) index)) (. CodeCharClass space)))
      (= index (call (. text previous-char) index))
    )
    (return-if index (if (== index 0)))
    (let kind (call char-class (call (. text previous-char) index)))
    (return-if (call (. text previous-char) index) (if (== kind (. CodeCharClass newline))))
    (while (and (> index 0) (== (call char-class (call (. text previous-char) index)) kind))
      (= index (call (. text previous-char) index))
    )
    (return index)
  )
  (fn-do + word-right Size
    (param offset Size)
    (let index offset)
    (while (and (< index (. text length)) (== (call char-class index) (. CodeCharClass space)))
      (= index (call (. text next-char) index))
    )
    (return-if index (if (>= index (. text length))))
    (let kind (call char-class index))
    (return-if (call (. text next-char) index) (if (== kind (. CodeCharClass newline))))
    (while (and (< index (. text length)) (== (call char-class index) kind))
      (= index (call (. text next-char) index))
    )
    (return index)
  )
  (fn-expr + char-class CodeCharClass
    (param offset Size)
    (call code-byte-class (call (. text byte-at) offset))
  )
  (fn-do + fold-ranges (list SyntaxFold)
    (param first Size)
    (param last Size)
    (let active document)
    (return-if (call (of List SyntaxFold)) (if (not active)))
    (if (or (!= fold-revision revision) (< first fold-first) (> last fold-last))
      (= fold-first (if-expr (> first code-window-before) (- first code-window-before) 0))
      (= fold-last (+ last code-window-after))
      (= fold-window (call (. active folds) (. text bytes) (. text length) fold-first fold-last))
      (= fold-revision revision)
    )
    (return fold-window)
  )
  (fn-do + fold-at (? SyntaxFold)
    (param line Size)
    (for (in fold (call fold-ranges line line))
      (return-if fold (if (== (. fold start) line)))
    )
    (return null)
  )
  (fn-expr + can-fold Bool
    (param line Size)
    (!= (call fold-at line) null)
  )
  (fn-do + fold Bool
    (let line (call (. text line-at) caret))
    (let found (? SyntaxFold) null)
    (for (in fold (call fold-ranges line line))
      (if (and (<= (. fold start) line) (>= (. fold end) line) (not (call (. folds has-fold) (. fold start))))
        (= found fold)
      )
    )
    (return-if false (if (not found)))
    (call (. folds collapse) found)
    (call cover)
    (<- updated revision)
    (return true)
  )
  (fn-do + unfold Bool
    (return-if false (if (not (call (. folds unfold) (call (. text line-at) caret)))))
    (<- updated revision)
    (return true)
  )
  (fn-do + toggle-fold Bool
    (param line Size)
    (if (call (. folds has-fold) line)
      (call (. folds unfold) line)
      (else
        (let found (call fold-at line))
        (return-if false (if (not found)))
        (call (. folds collapse) found)
        (call cover)
      )
    )
    (<- updated revision)
    (return true)
  )
  (fn-do + fold-all _
    (let active document)
    (return-if (if (not active)))
    (call (. folds fold-all) (call (. active folds) (. text bytes) (. text length)))
    (call cover)
    (<- updated revision)
  )
  (fn-do + unfold-all _
    (call (. folds unfold-all))
    (<- updated revision)
  )
  (fn-do + reveal-anchor Bool
    (return (call (. folds reveal) (call (. text line-at) anchor)))
  )
  (fn-expr _ advance-column Size
    (param index Size)
    (param column Size)
    (case? (== byte code-tab)
      (* (+ (/ column tab-width) 1) tab-width)
    )
    (case? (< byte 0x80)
      (+ column 1)
    )
    (default
      (+ column (. (as (call (. text codepoint-at) index) Char) display-width))
    )
    (where
      (lazy byte (call (. text byte-at) index))
    )
  )
  (fn-do _ expanded-tabs (list SyntaxStyledRun)
    (param runs (list SyntaxStyledRun))
    (param start Size)
    (let expanded (list SyntaxStyledRun))
    (let offset start)
    (let column Size 0)
    (for (in run runs)
      (let end (+ offset (. run text size)))
      (let pieces (list String))
      (let piece-start offset)
      (let index offset)
      (while (< index end)
        (if (== (call (. text byte-at) index) code-tab)
          (if (> index piece-start)
            (+= pieces (call (. text text-in) piece-start index))
          )
          (let next (* (+ (/ column tab-width) 1) tab-width))
          (+= pieces (* " " (- next column)))
          (= column next)
          (+= index 1)
          (= piece-start index)
          (else
            (= column (call advance-column index column))
            (= index (call (. text next-char) index))
          )
        )
      )
      (if (> end piece-start)
        (+= pieces (call (. text text-in) piece-start end))
      )
      (+= expanded (call SyntaxStyledRun (call (. "" join) pieces) (. run role) (. run is-marked)))
      (= offset end)
    )
    (return expanded)
  )
  (fn-do _ load-window _
    (param line Size)
    (let first (if-expr (> line code-window-before) (- line code-window-before) 0))
    (let last (call min (. text line-count) (+ line code-window-after)))
    (let lines (list (list SyntaxSpan)))
    (for (in index (..< first last))
      (+= lines (call (of List SyntaxSpan)))
    )
    (let active document)
    (if (and active (> last first))
      (let spans
        (call (. active highlight)
          (block
            (arg (. text bytes))
            (arg (. text length))
            (arg (call (. text line-start) first))
            (arg (call (. text line-end) (- last 1)))
          )
        )
      )
      (let current first)
      (for (in span spans)
        (let position (. span start))
        (while (and (< position (. span end)) (< current last))
          (let line-end (call (. text line-end) current))
          (if (> position line-end)
            (+= current 1)
            (else
              (let piece-end (call min (. span end) line-end))
              (if (> piece-end position)
                (let bucket ([] lines (- current first)))
                (+= bucket (call SyntaxSpan position piece-end (. span capture)))
              )
              (if (<= (. span end) line-end)
                (= position (. span end))
                (else
                  (= position (+ line-end 1))
                  (+= current 1)
                )
              )
            )
          )
        )
      )
    )
    (= window-first first)
    (= window-spans lines)
    (= window-revision revision)
  )
  (fn-do _ reparse _
    (param budget _ (= code-edit-parse-budget))
    (let active document)
    (return-if (if (or (not active) (. active is-parsing))))
    (if (call (. active parse) (. text bytes) (. text length) budget)
      (= has-parse-error (. active has-error))
      (else-if (. active is-parsing)
        (do-new @detached
          (call finish-background-parse active)
        )
      )
    )
  )
  (fn-do _ finish-background-parse _
    (param active SyntaxDocument)
    (let done (call (of Semaphore Bool)))
    (do-new-thread @detached
      (call (. done post) (call (. active continue-parse)))
    )
    (call (. done await))
    (let edited (call (. active finish-parse)))
    (return-if (if (not document)))
    (= has-parse-error (. active has-error))
    (+= revision 1)
    (if edited
      (call reparse)
    )
    (<- updated revision)
  )
  (fn-do _ start-marking _
    ; Starts a task that marks the lines that differ from the baseline, unless one runs already: it
    ; goes on until the marks match the last edit.
    (return-if (if (and marker (not (. marker is-finished)))))
    (= marker
      (do-new
        (inline (call mark-changes))
      )
    )
  )
  (fn-do _ mark-changes _
    (while (and (!= baseline null) (!= marked-stamp edit-stamp))
      (let stamp edit-stamp)
      (let source baseline)
      (let current (call code-text-bytes text))
      (let done (call (of Semaphore (list DiffLineChange))))
      (do-new-thread
        (call (. done post) (call (. (call diff-document source current) line-changes)))
      )
      (let found (call (. done await)))
      (if (== found null)
        (break)
      )
      (if (and (== stamp edit-stamp) (!= baseline null))
        (= line-changes found)
        (= marked-stamp stamp)
        (<- updated revision)
      )
    )
  )
  (fn-do _ apply CodeTextChange
    (param start Size)
    (param end Size)
    (param inserted String)
    (let change (call (. text replace) start end inserted))
    (let active document)
    (if active
      (call (. active edit)
        (block
          (arg (. change start))
          (arg (. change old-end))
          (arg (. change new-end))
          (arg (. change start-point))
          (arg (. change old-end-point))
          (arg (. change new-end-point))
        )
      )
      (call reparse)
    )
    (call (. folds shift) (. change start-point) (. change old-end-point) (. change new-end-point))
    (for (in line (.. (. change start-point row) (. change new-end-point row)))
      (= widest-columns (call max widest-columns (call line-columns line)))
    )
    (+= revision 1)
    (if (!= baseline null)
      (+= edit-stamp 1)
      (let delta (- (as (. change new-end-point row) I64) (as (. change old-end-point row) I64)))
      (= line-changes (call diff-shifted-changes line-changes (. change old-end-point row) delta))
      (call start-marking)
    )
    (return change)
  )
  (fn-do _ edit _
    (param start Size)
    (param end Size)
    (param inserted String)
    (param title String)
    (param coalescing _ (= false))
    (let old-caret caret)
    (let old-anchor anchor)
    (let change (call apply start end inserted))
    (= caret (. change new-end))
    (= anchor caret)
    (= goal-column null)
    (if (not coalescing)
      (call (. history seal))
    )
    (call (. history record) title (call CodeEdit this start (. change removed) inserted old-caret old-anchor caret))
    (if (not coalescing)
      (call (. history seal))
    )
    (<- updated revision)
  )
  (fn-do _ restore _
    (param start Size)
    (param end Size)
    (param inserted String)
    (param caret-to Size)
    (param anchor-to Size)
    (let ignored (call apply start end inserted))
    (= caret caret-to)
    (= anchor anchor-to)
    (= goal-column null)
    (<- updated revision)
  )
  (fn-do _ cover _
    (let line (call (. text line-at) caret))
    (if (call (. folds is-hidden) line)
      (let head (call (. folds actual) (call (. folds shown) line)))
      (= caret (call offset-at-column head (as (?? goal-column (call display-column caret)) Float)))
      (= anchor caret)
      (call (. history seal))
      (else-if (call (. folds is-hidden) (call (. text line-at) anchor))
        (= anchor caret)
      )
    )
  )
  (fn-expr _ visible Size
    (param offset Size)
    (param forward Bool)
    (case? (not (call (. folds is-hidden) line))
      offset
    )
    (case? (or (not forward) (>= (+ display 1) (call (. folds row-count) (. text line-count))))
      (call (. text line-end) head)
    )
    (default
      (call (. text line-start) (call (. folds actual) (+ display 1)))
    )
    (where
      (lazy line (call (. text line-at) offset))
      (lazy display (call (. folds shown) line))
      (lazy head (call (. folds actual) display))
    )
  )
  (fn-expr _ last-selected-line Size
    (if-expr (and has-selection (> last (call (. text line-at) selection-start)) (== selection-end (call (. text line-start) last))) (- last 1) last)
    (where
      (lazy last (call (. text line-at) selection-end))
    )
  )
  (fn-do _ last-meaningful-byte Byte
    (param start Size)
    (param end Size)
    (let index end)
    (while (> index start)
      (-= index 1)
      (let byte (call (. text byte-at) index))
      (return-if byte (if (and (!= byte code-space) (!= byte code-tab))))
    )
    (return 0)
  )
  (fn-expr _ outdented String
    (param prefix String)
    (case? (call (. prefix ends-with) "\t")
      ([] prefix (..< 0 (- (. prefix length) 1)))
    )
    (default
      ([] prefix (..< 0 (- (. prefix length) count)))
    )
    (where
      (lazy count (call min (. indent-unit size) (. prefix size)))
    )
  )
  (fn-do _ outdented-line String
    (param line String)
    (return-if ([] line (... 1)) (if (call (. line starts-with) "\t")))
    (let count Size 0)
    (for (in char line)
      (if (or (!= char (char " ")) (>= count (. indent-unit size)))
        (break)
      )
      (+= count 1)
    )
    (return (if-expr (> count 0) ([] line (... count)) line))
  )
  (fn-do _ detect-indent String
    (let tabs Size 0)
    (let spaced Size 0)
    (let smallest Size 0)
    (for (in line (..< 0 (call min (. text line-count) code-indent-sample-lines)))
      (let start (call (. text line-start) line))
      (let end (call (. text line-end) line))
      (if (< start end)
        (if (== (call (. text byte-at) start) code-tab)
          (+= tabs 1)
          (else-if (== (call (. text byte-at) start) code-space)
            (let count Size 0)
            (while (and (< (+ start count) end) (== (call (. text byte-at) (+ start count)) code-space))
              (+= count 1)
            )
            (if (and (< (+ start count) end) (> count 1))
              (+= spaced 1)
              (if (or (== smallest 0) (< count smallest))
                (= smallest count)
              )
            )
          )
        )
      )
    )
    (case? (> tabs spaced)
      (return "\t")
    )
    (case? (or (== smallest 2) (== smallest 4) (== smallest 8))
      (return (* " " smallest))
    )
    (default
      (return "    ")
    )
  )
)

(type + CodeCharClass (is Union)
  (variant space)
  (variant word)
  (variant punctuation)
  (variant newline)
)

(fn-expr + code-byte-class CodeCharClass
  (param byte Byte)
  (case? (== byte code-newline)
    (. CodeCharClass newline)
  )
  (case? (or (== byte code-space) (== byte code-tab) (== byte code-return))
    (. CodeCharClass space)
  )
  (case? (or (>= byte 0x80) (== byte 95) (and (>= byte 48) (<= byte 57)) is-letter)
    (. CodeCharClass word)
  )
  (default
    (. CodeCharClass punctuation)
  )
  (where
    (lazy is-letter (or (and (>= byte 65) (<= byte 90)) (and (>= byte 97) (<= byte 122))))
  )
)

(fn-expr + code-matching-line Size
  (param from String)
  (param to String)
  (param line Size)
  (call diff-matching-line (call code-text-bytes (call CodeText from)) (call code-text-bytes (call CodeText to)) line)
)

(type _ CodeEdit
  (implements CommandHistoryEntry)
  (prop _ session CodeSession)
  (prop _ start Size)
  (prop _ removed String)
  (prop _ inserted String)
  (prop _ caret-before Size)
  (prop _ anchor-before Size)
  (prop _ caret-after Size)
  (fn-do _ This _
    (param session _)
    (param start _)
    (param removed _)
    (param inserted _)
    (param caret-before _)
    (param anchor-before _)
    (param caret-after _)
  )
  (fn-do + undo _
    (call (. session restore) start (+ start (. inserted size)) removed caret-before anchor-before)
  )
  (fn-do + redo _
    (call (. session restore) start (+ start (. removed size)) inserted caret-after caret-after)
  )
  (fn-do + coalesce Bool
    (param next CommandHistoryEntry)
    (match? next
      (case CodeEdit
        (if (and (not (. removed size)) (not (. it removed size)) (== (+ start (. inserted size)) (. it start)))
          (+= inserted (. it inserted))
          (= caret-after (. it caret-after))
          (return true)
        )
        (return-if false (if (or (. inserted size) (. it inserted size) (not (. removed size)) (not (. it removed size)))))
        (if (== (+ (. it start) (. it removed size)) start)
          (= start (. it start))
          (= removed (str (. it removed) removed))
          (= caret-after (. it caret-after))
          (return true)
        )
        (if (== (. it start) start)
          (+= removed (. it removed))
          (= caret-after (. it caret-after))
          (return true)
        )
      )
    )
    (return false)
  )
)

(fn-do _ leading-whitespace String
  (param line String)
  (let count Size 0)
  (for (in char line)
    (if (and (!= char (char " ")) (!= char (char "\t")))
      (break)
    )
    (+= count 1)
  )
  (return ([] line (..< 0 count)))
)

(fn-expr _ is-closing Bool
  (param typed String)
  (or (== typed "}") (== typed ")") (== typed "]"))
)

(fn-expr _ code-closer (? Byte)
  (param opener Byte)
  (match? opener
    (case= code-open-brace
      code-close-brace
    )
    (case= code-open-paren
      code-close-paren
    )
    (case= code-open-bracket
      code-close-bracket
    )
  )
)

(fn-expr _ code-opens-block Bool
  (param opener Byte)
  (or (== opener code-colon) (!= (call code-closer opener) null))
)

(fn-expr _ is-all-spaces Bool
  (param text String)
  (call all text (:where (== each (char " "))))
)

(fn-do _ code-text-bytes _
  (param text CodeText)
  (let bytes ([] Byte (. text length)))
  (= ([] bytes (..< 0 (. text length))) ([] (. text bytes) (..< 0 (. text length))))
  (return bytes)
)

(fn-expr _ code-splits-character Bool
  (param text CodeText)
  (param offset Size)
  (and (< offset (. text length)) (call utf8-is-continuation ([] (. text bytes) offset)))
)

(fn-expr _ code-reloaded-offset Size
  (param offset Size)
  (param start Size)
  (param old-end Size)
  (param new-end Size)
  (case? (<= offset start)
    offset
  )
  (case? (>= offset old-end)
    (+ (- offset old-end) new-end)
  )
  (default
    (call min offset new-end)
  )
)
