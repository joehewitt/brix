./syntax
/math
/string.h

+ code-newline Byte = 10
+ code-return Byte = 13
+ code-tab Byte = 9
+ code-space Byte = 32
+ code-colon Byte = 58
+ code-open-paren Byte = 40
+ code-close-paren Byte = 41
+ code-open-bracket Byte = 91
+ code-close-bracket Byte = 93
+ code-open-brace Byte = 123
+ code-close-brace Byte = 125

━━━━━━━━━━━━━━━━━━━━
+ CodeTextChange is Tuple

+ start Size
+ old-end Size
+ new-end Size
+ start-point SyntaxPoint
+ old-end-point SyntaxPoint
+ new-end-point SyntaxPoint
+ removed String
+ inserted String

━━━━━━━━━━━━━━━━━━━━
+ CodeTextDamage

+ is-damaged = false
+ first-line Size
+ last-line Size
+ line-delta I64
+ byte-delta I64

────────────────────
+ do add
    - change CodeTextChange

. first = change.start-point.row
. old-last = change.old-end-point.row
. new-last = change.new-end-point.row
. delta = (new-last as I64) - (old-last as I64)
if is-damaged
    last-line = if last-line > old-last then ((last-line as I64) + delta) as Size else new-last
    if first < first-line
        first-line = first
else
    first-line = first
    last-line = new-last
    is-damaged = true
line-delta += delta
byte-delta += (change.new-end as I64) - (change.old-end as I64)

────────────────────
+ do clear

is-damaged = false
line-delta = 0
byte-delta = 0

━━━━━━━━━━━━━━━━━━━━
+ CodeText

+ bytes Byte[]
+ length Size
+ line-starts [Size]
+ uses-crlf Bool

_ damages [CodeTextDamage]

────────────────────
+ This
    - source String = ""

. raw = byte-view(source)
. count = raw.size
bytes = Byte[count + 256]
. write Size = 0
for index in 0 .. < count
    . byte = raw[index]
    if byte == code-return && index + 1 < count && raw[index + 1] == code-newline
        uses-crlf = true
    else
        bytes[write] = byte
        write += 1
length = write
line-starts += 0
for index in 0 .. < length
    if bytes[index] == code-newline
        line-starts += index + 1

────────────────────
+ get line-count Size

line-starts.length

────────────────────
+ line-start Size
    - line Size

line-starts[line]

────────────────────
+ line-end Size
    - line Size

if line + 1 < line-starts.length then line-starts[line + 1] - 1 else length

────────────────────
+ line-length Size
    - line Size

line-end(line) - line-start(line)

────────────────────
+ line-text String
    - line Size

text-in(line-start(line), line-end(line))

────────────────────
+ text-in String
    - start Size
    - end Size

if end > start then bytes.slice-string(start .. < end) else ""

────────────────────
+ get text String

text-in(0, length)

────────────────────
+ get saved-text String

if uses-crlf then "\r\n".join(text.split("\n")) else text

────────────────────
+ byte-at Byte
    - offset Size

bytes[offset]

────────────────────
+ do line-at Size
    - offset Size

. low Size = 0
. high = line-starts.length
while high - low > 1
    . middle = low + (high - low) / 2
    if line-starts[middle] <= offset
        low = middle
    else
        high = middle
= low

────────────────────
+ do track
    - damage CodeTextDamage

damages += damage

────────────────────
+ do untrack
    - damage CodeTextDamage

. index Size = 0
while index < damages.length
    if damages[index] as Pointer == damage as Pointer
        damages.remove(index)
        =
    index += 1

────────────────────
+ point-at SyntaxPoint
    - offset Size

SyntaxPoint(line, offset - line-starts[line])

.. line = line-at(offset)

────────────────────
+ offset-at Size
    - line Size
    - column Size

min(line-start(line) + column, line-end(line))

────────────────────
+ do next-char Size
    - offset Size

=? length if offset >= length
. next = offset + 1
while next < length && utf8-is-continuation(bytes[next])
    next += 1
= next

────────────────────
+ do previous-char Size
    - offset Size

=? 0 if offset == 0
. previous = offset - 1
while previous > 0 && utf8-is-continuation(bytes[previous])
    previous -= 1
= previous

────────────────────
+ do char-offset Size
    - line Size
    - index Size

. offset = line-start(line)
. end = line-end(line)
. count Size = 0
while count < index && offset < end
    offset = next-char(offset)
    count += 1
= offset

────────────────────
+ do char-index Size
    - offset Size

. index = line-start(line-at(offset))
. count Size = 0
while index < offset
    index = next-char(index)
    count += 1
= count

────────────────────
+ do codepoint-at U32
    - offset Size

. lead = bytes[offset] as U32
=? lead if lead < 0x80
. extra Size = if lead < 0xe0 then 1 else if lead < 0xf0 then 2 else 3
. value = lead /and/ (if extra == 1 then 0x1f else if extra == 2 then 0x0f else 0x07)
for index in 1 .. extra
    if offset + index < length
        value = (value /lshift/ 6) /or/ ((bytes[offset + index] as U32) /and/ 0x3f)
= value

────────────────────
+ do replace CodeTextChange
    - start Size
    - end Size
    - inserted String

. removed = text-in(start, end)
. start-point = point-at(start)
. old-end-point = point-at(end)
. added = byte-view(inserted)
. added-size = added.size
. removed-size = end - start
. new-length = length - removed-size + added-size
if new-length > bytes.size
    bytes = bytes.resize(new-length + new-length / 2 + 256)
if end < length && added-size != removed-size
    C:memmove(bytes.data + start + added-size, bytes.data + end, length - end)
if added-size > 0
    C:memcpy(bytes.data + start, added, added-size)
length = new-length

. first = start-point.row
. last = old-end-point.row
if last > first
    line-starts.remove(first + 1, last - first)
. shift = (added-size as I64) - (removed-size as I64)
if shift != 0
    for line in first + 1 .. < line-starts.length
        line-starts[line] = (line-starts[line] as I64) + shift
. starts [Size]
for index in 0 .. < added-size
    if added[index] == code-newline
        starts += start + index + 1
if starts.length > 0
    line-starts.insert(starts, first + 1)

. change = CodeTextChange
    - start
    - end
    - start + added-size
    - start-point
    - old-end-point
    - point-at(start + added-size)
    - removed
    - inserted
for damage in damages
    damage.add(change)
= change
