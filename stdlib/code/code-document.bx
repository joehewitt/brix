(import ./code-session)
(import ./syntax)
(import /BxCore/BxString.h)
(import /os/file)
(import /os/path)
(import /time/debounced)
(import /time/duration)
(blank)
(prop + code-document-watch-delay _ (= 100ms))
(prop _ code-document-new-perms _
  (=
    (block
      (/or/ user-read-perm user-write-perm group-read-perm other-read-perm)
    )
  )
)

(type + CodeDocument
  (implements Closable)
  (prop + path Path)
  (prop + session CodeSession)
  (prop + is-modified _ (= false))
  (prop + is-changed-on-disk _ (= false))
  (prop + is-missing _ (= false))
  (blank)
  (prop _ disk-text String)
  (prop _ watcher (? Closable))
  (prop _ watched-path _ (= ""))
  (prop _ schedule-reload _ (:= (call throttled code-document-watch-delay (. this reload))))
  (prop _ generation U64)
  (fn-do + This _
    (param path _)
    (param text String)
    (lazy session (call CodeSession text (call syntax-language-for-file (. path name))))
    (= (. session comment-marker) (call syntax-comment-marker (. path name)))
    (= disk-text text)
    (call follow)
  )
  (fn-do + save _ (?! Error)
    (let text (. session text saved-text))
    (if is-missing
      (call (?. (. path parent) make-directories))
    )
    (call write-file-atomically path text (call code-document-perms path))
    (call (. session mark-saved))
    (= disk-text text)
    (= is-changed-on-disk false)
    (= is-missing false)
  )
  (fn-do + reload _
    (param discards _ (= false))
    (if (not (. path exists))
      (= is-missing true)
      (return)
    )
    (let text (call code-read-text path))
    (if (== text null)
      (= is-changed-on-disk true)
      (return)
    )
    (call adopt text discards)
  )
  (fn-do + adopt _
    (param text String)
    (param discards _ (= false))
    (= is-missing false)
    (if (and (not discards) (. session is-modified))
      (= is-changed-on-disk (!= text disk-text))
      (return)
    )
    (call (. session reload) text)
    (= disk-text text)
    (= is-changed-on-disk false)
    (call follow)
  )
  (fn-do + relocate _
    (param next Path)
    (= path next)
    (= (. session comment-marker) (call syntax-comment-marker (. next name)))
    (let stream watcher)
    (return-if (if (not stream)))
    (= watcher null)
    (call (. stream close))
    (catch (call watch))
  )
  (fn-do + watch _ (?! Error)
    (return-if (if watcher))
    (let resolved (?? (catch? (. path resolved)) path))
    (= watched-path (str resolved))
    (let folder (?? (. resolved parent) resolved))
    (= watcher (call listen-for-changes (as (call (. folder watch)) (of Broadcastable PathWatchEvent)) (. this note)))
  )
  (fn-do + close _
    (+= generation 1)
    (let stream watcher)
    (= watcher null)
    (if stream
      (call (. stream close))
    )
    (call (. session close))
  )
  (fn-do _ follow _
    (+= generation 1)
    (let current generation)
    (let followed session)
    (= is-modified (. followed is-modified))
    (for (on revision (. followed updated) (until (!= current generation)))
      (= is-modified (. followed is-modified))
    )
  )
  (fn-do _ note _
    (param event PathWatchEvent)
    (if (or (. event must-rescan) (== (str (. event path)) watched-path))
      (call schedule-reload)
    )
  )
)

(fn-do + code-read-text (? String)
  (param path Path)
  (let bytes (catch? (call read-file-bytes path)))
  (return-if null (if (or (== bytes null) (!= (call C:brixStringValidateUtf8 (. bytes data) (. bytes size)) 0))))
  (return (call (. bytes slice-string) (..< 0 (. bytes size))))
)

(fn-do _ code-document-perms FilePermissions
  (param path Path)
  (let mode (catch? (. path mode)))
  (return-if code-document-new-perms (if (== mode null)))
  (return (/and/ (as mode FilePermissions) all-rwx-perm))
)
