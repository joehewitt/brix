./code-session
./syntax
/YuCore/YuString.h
/os/file
/os/path
/time/debounced
/time/duration

+ code-document-watch-delay = 100ms
_ code-document-new-perms = user-read-perm /or/ user-write-perm /or/ group-read-perm /or/ other-read-perm

━━━━━━━━━━━━━━━━━━━━
+ CodeDocument
    is Closable

+ path Path
+ session CodeSession
+ is-modified = false
+ is-changed-on-disk = false
+ is-missing = false

_ disk-text String
_ watcher Closable?
_ watched-path = ""
_ schedule-reload := throttled(code-document-watch-delay, this.reload)
_ generation U64

────────────────────
+ This
    - path
    - text String

.. session = CodeSession(text, syntax-language-for-file(path.name))
session.comment-marker = syntax-comment-marker(path.name)
disk-text = text
follow()

────────────────────
+ do save ?! Error

. text = session.text.saved-text
if is-missing
    path.parent?.make-directories()
write-file-atomically(path, text, code-document-perms(path))
session.mark-saved()
disk-text = text
is-changed-on-disk = false
is-missing = false

────────────────────
+ do reload
    - discards = false

if !path.exists
    is-missing = true
    =
. text = code-read-text(path)
if text == null
    is-changed-on-disk = true
    =
adopt(text, discards)

────────────────────
+ do adopt
    - text String
    - discards = false

is-missing = false
if !discards && session.is-modified
    is-changed-on-disk = text != disk-text
    =
session.reload(text)
disk-text = text
is-changed-on-disk = false
follow()

────────────────────
+ do relocate
    - next Path

path = next
session.comment-marker = syntax-comment-marker(next.name)
. stream = watcher
=? if !stream
watcher = null
stream.close()
catch watch()

────────────────────
+ do watch ?! Error

=? if watcher
. resolved = catch? path.resolved ?? path
watched-path = "$resolved"
. folder = resolved.parent ?? resolved
watcher = listen-for-changes(folder.watch() as Broadcastable'PathWatchEvent, this.note)

╌╌╌╌╌╌╌╌╌╌ is Closable ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do close

generation += 1
. stream = watcher
watcher = null
if stream
    stream.close()
session.close()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ do follow

generation += 1
. current = generation
. followed = session
is-modified = followed.is-modified
for revision on followed.updated until current != generation
    is-modified = followed.is-modified

────────────────────
_ do note
    - event PathWatchEvent

if event.must-rescan || "${event.path}" == watched-path
    schedule-reload()

━━━━━━━━━━━━━━━━━━━━
+ do code-read-text String?
    - path Path

. bytes = catch? read-file-bytes(path)
=? null if bytes == null || C:yumiStringValidateUtf8(bytes.data, bytes.size) != 0
= bytes.slice-string(0 .. < bytes.size)

━━━━━━━━━━━━━━━━━━━━
_ do code-document-perms FilePermissions
    - path Path

. mode = catch? path.mode
=? code-document-new-perms if mode == null
= (mode as FilePermissions) /and/ all-rwx-perm
