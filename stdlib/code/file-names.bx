(import /data/fuzzy)
(import /git)
(import /os/path)
(import /stream/sort)
(import /time/debounced)
(import /time/duration)
(blank)
(prop + file-name-relist-delay _ (= 250ms))
(prop + file-name-match-limit Size (= 200))
(prop _ file-name-walk-limit Size (= 500000))
(prop _ file-name-name-bonus _ (= 10000))

(type + FileNameEntry (is Tuple)
  (prop + path String)
  (prop + name String)
  (prop + is-directory Bool)
)

(type + FileNameMatch (is Tuple)
  (prop + entry FileNameEntry)
  (prop + score Int)
  (prop + positions (list Index))
  (prop + is-in-name Bool)
)

(type + FileNameIndex
  (implements Closable)
  (prop + root Path)
  (prop + entries (list FileNameEntry))
  (prop + is-ready _ (= false))
  (prop + revision U64)
  (blank)
  (prop _ known (map String Bool))
  (prop _ listed _ (= (call OneShotChannel)))
  (prop _ watch (? Closable))
  (prop _ changes (? (of Broadcastable PathWatchEvent)))
  (prop _ is-started _ (= false))
  (prop _ is-listing _ (= false))
  (prop _ is-stale _ (= false))
  (prop _ schedule-relist _ (:= (call throttled file-name-relist-delay (. this relist))))
  (prop _ is-closed _ (= false))
  (fn-do + This _
    (param location Path)
    (param changes _ (= null))
    (let resolved (?? (catch? (. location resolved)) location))
    (= root resolved)
  )
  (fn-do + start _
    (return-if (if (or is-started is-closed)))
    (blank)
    (= is-started true)
    (= watch (catch? (call listen)))
    (do-new
      (inline (call relist))
    )
  )
  (fn-do + search (list FileNameMatch)
    (param query String)
    (param scope String (= ""))
    (param limit _ (= file-name-match-limit))
    (call await-listing)
    (let snapshot entries)
    (let done (call (of Semaphore (list FileNameMatch))))
    (do-new-thread @detached
      (call (. done post) (call file-name-ranked snapshot query scope limit))
    )
    (return (?? (call (. done await)) (call (of List FileNameMatch))))
  )
  (fn-do + await-listing _
    (call start)
    (while (and (not is-ready) (not is-closed))
      (<- listed)
    )
  )
  (fn-expr + relative (? String)
    (param location Path)
    (only-if (str inner) (if inner))
    (where
      (lazy inner (call (. location relative-to) root))
    )
  )
  (fn-do + close _
    (= is-closed true)
    (call (. listed done))
    (let stream watch)
    (= watch null)
    (if stream
      (catch? (call (. stream close)))
    )
  )
  (fn-do _ listen Closable (?! Error)
    (let source (?? changes (as (call (. root watch) true) (of Broadcastable PathWatchEvent))))
    (return (call listen-for-changes source (. this note)))
  )
  (fn-do _ note _
    (param event PathWatchEvent)
    (return-if (if is-closed))
    (blank)
    (if (. event must-rescan)
      (call schedule-relist)
      (return)
    )
    (let inner (call relative (. event path)))
    (return-if (if (or (== inner null) (== inner "") (call file-name-is-git inner))))
    (blank)
    (let name (. event path name))
    (let is-rule (== name ".gitignore"))
    (return-if (if (and (not is-rule) (not (call file-name-changes-names (. event flags))))))
    (blank)
    (let slash (call (. inner find-reverse) "/"))
    (let above (if-expr (!= slash null) ([] inner (..< 0 (as slash Index))) ""))
    (if (or is-rule (== above "") (has known inner) (has known above))
      (call schedule-relist)
    )
  )
  (fn-do _ relist _
    (= is-stale true)
    (return-if (if is-listing))
    (blank)
    (= is-listing true)
    (while (and is-stale (not is-closed))
      (= is-stale false)
      (let location root)
      (let done (call (of Semaphore FileNameListing)))
      (do-new-thread @detached
        (call (. done post) (call file-name-listing location))
      )
      (let found (call (. done await)))
      (if (and found (not is-closed))
        (= entries (. found entries))
        (= known (. found known))
        (+= revision 1)
      )
      (if (not is-ready)
        (= is-ready true)
        (call (. listed done))
      )
    )
    (= is-listing false)
  )
)

(type _ FileNameListing
  (prop + entries (list FileNameEntry))
  (prop + known (map String Bool))
)

(type _ FileNameRank (is Tuple)
  (prop + score Int)
  (prop + length Size)
  (prop + order Size)
)

(fn-do _ file-name-listing FileNameListing
  (param root Path)
  (let listing (call FileNameListing))
  (let paths (catch? (call file-name-git-paths (str root))))
  (if (!= paths null)
    (for (in path paths)
      (if (call (. path ends-with) "/")
        (call file-name-add listing ([] path (..< 0 (- (. path length) 1))) true)
        (else
          (call file-name-add listing path false)
        )
      )
    )
    (else
      (call file-name-walk listing root "")
    )
  )
  (return listing)
)

(fn-do _ file-name-git-paths (list String) (?! Error)
  (param directory String)
  (let listed
    (call git-fields
      (block
        (arg
          (call git-output
            (block
              (arg directory)
              (arg (list "ls-files" "-z" "--cached" "--others" "--exclude-standard" "--deduplicate"))
            )
          )
        )
      )
    )
  )
  (let deleted (call git-fields (call git-output directory (list "ls-files" "-z" "--deleted"))))
  (return-if listed (if (== (. deleted length) 0)))
  (blank)
  (let gone (call (of Map String Bool)))
  (for (in path deleted)
    (= ([] gone path) true)
  )
  (let kept (list String))
  (for (in path listed)
    (if (not (has gone path))
      (+= kept path)
    )
  )
  (return kept)
)

(fn-do _ file-name-walk _
  (param listing FileNameListing)
  (param location Path)
  (param prefix String)
  (let listed (catch? (call (of List PathEntry) (. location entries))))
  (return-if (if (== listed null)))
  (blank)
  (for (in entry listed)
    (return-if (if (>= (. listing entries length) file-name-walk-limit)))
    (blank)
    (if (not (call file-name-walk-hides (. entry name)))
      (let path (str prefix (. entry name)))
      (let is-directory (== (. entry kind) (. PathKind directory)))
      (call file-name-add listing path is-directory)
      (if is-directory
        (call file-name-walk listing (/ location (. entry name)) (str path "/"))
      )
    )
  )
)

(fn-do _ file-name-add _
  (param listing FileNameListing)
  (param path String)
  (param is-directory Bool)
  (return-if (if (or (not path) (has (. listing known) path))))
  (blank)
  (= ([] (. listing known) path) true)
  (let slash (call (. path find-reverse) "/"))
  (let name path)
  (if (!= slash null)
    (let cut (as slash Index))
    (= name ([] path (... (+ cut 1))))
    (call file-name-add listing ([] path (..< 0 cut)) true)
  )
  (+= (. listing entries) (call FileNameEntry path name is-directory))
)

(fn-do _ file-name-ranked (list FileNameMatch)
  (param entries (list FileNameEntry))
  (param query String)
  (param scope String)
  (param limit Size)
  (let found (list FileNameMatch))
  (let pattern (call FuzzyQuery query))
  (return-if found (if (. pattern is-empty)))
  (blank)
  (let prefix (if-expr scope (str scope "/") ""))
  (let ranks (list FileNameRank))
  (for (in order (..< 0 (. entries length)))
    (let entry ([] entries order))
    (if (or (not prefix) (call (. entry path starts-with) prefix))
      (let scored (call (. pattern score) (. entry path) (. prefix size)))
      (if (!= scored null)
        (let total scored)
        (let named (call (. pattern score) (. entry name)))
        (if (!= named null)
          (+= total (+ named file-name-name-bonus))
        )
        (+= ranks (call FileNameRank total (. entry path length) order))
      )
    )
  )
  (let ordered (call sort ranks (:using file-name-rank-compare)))
  (for (in rank ordered)
    (return-if found (if (>= (. found length) limit)))
    (blank)
    (let entry ([] entries (. rank order)))
    (let named (call (. pattern positions) (. entry name)))
    (if (> (. named length) 0)
      (+= found (call FileNameMatch entry (. rank score) named true))
      (else
        (+= found (call FileNameMatch entry (. rank score) (call (. pattern positions) (. entry path) (. prefix size)) false))
      )
    )
  )
  (return found)
)

(fn-expr _ file-name-rank-compare Comparison
  (param left FileNameRank)
  (param right FileNameRank)
  (case? (> (. left score) (. right score))
    (. Comparison lesser)
  )
  (case? (< (. left score) (. right score))
    (. Comparison greater)
  )
  (case? (< (. left length) (. right length))
    (. Comparison lesser)
  )
  (case? (> (. left length) (. right length))
    (. Comparison greater)
  )
  (case? (< (. left order) (. right order))
    (. Comparison lesser)
  )
  (case? (> (. left order) (. right order))
    (. Comparison greater)
  )
  (default
    (. Comparison equal)
  )
)

(fn-expr _ file-name-is-git Bool
  (param inner String)
  (or (== inner ".git") (call (. inner starts-with) ".git/"))
)

(fn-expr _ file-name-walk-hides Bool
  (param name String)
  (or (== name ".git") (== name ".DS_Store"))
)

(fn-expr _ file-name-changes-names Bool
  (param flags PathWatchFlags)
  (!= (/and/ flags names) 0)
  (where
    (lazy names (/or/ entries mounts))
    (lazy entries (/or/ (. PathWatchFlags created) (. PathWatchFlags removed) (. PathWatchFlags renamed)))
    (lazy mounts (/or/ (. PathWatchFlags mounted) (. PathWatchFlags unmounted)))
  )
)
