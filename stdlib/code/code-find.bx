(import /regex)
(blank)
(prop _ code-find-limit Size (= 20000))

(type + CodeFindQuery (is Tuple)
  (prop + text String)
  (prop + matches-case Bool)
  (prop + matches-word Bool)
  (prop + is-regex Bool)
)

(type + CodeHit (is Tuple)
  (prop + row Size)
  (prop + start Size)
  (prop + end Size)
)

(type + CodeFindPlace (is Tuple)
  (prop + row Size)
  (prop + column Size)
)

(type + CodeFindRow (is Tuple)
  (prop + content String)
  (prop + start Size)
  (prop + is-searched Bool)
)

(type + CodeRewrite (is Tuple)
  (prop + changed Size)
  (prop + held Size)
)

(type + CodeReplaced (is Tuple)
  (prop + count Size)
  (prop + rows Size)
  (prop + skipped Size)
  (prop + held Size)
)

(type _ CodeRowReplaced (is Tuple)
  (prop + text String)
  (prop + count Size)
)

(type + CodeFindTarget (is Interface)
  (fn-do + find-stamp U64)
  (fn-do + find-rows (list CodeFindRow)
    (param editing Bool)
  )
  (fn-do + find-caret CodeFindPlace)
  (fn-do + find-origin CodeFindPlace)
  (fn-do + find-selection (? CodeHit))
  (fn-do + find-seed (? String))
  (fn-do + find-reveal _
    (param hit CodeHit)
  )
  (fn-do + find-replace Bool
    (param hit CodeHit)
    (param text String)
  )
  (fn-do + find-can-edit Bool
    (param row Size)
  )
  (fn-do + find-rewrite CodeRewrite
    (param rows (list Size))
    (param texts (list String))
  )
  (fn-do + find-show _
    (param model (? CodeFind))
  )
  (fn-do + find-focus _)
)

(type + CodeFind
  (prop + query (? CodeFindQuery))
  (prop + found (list CodeHit))
  (prop + current (? Size))
  (prop + problem (? String))
  (prop + is-truncated Bool)
  (blank)
  (prop _ pattern (? Regex))
  (prop _ rows (list CodeFindRow))
  (prop _ searched U64)
  (fn-expr + is-active Bool :get
    (!= pattern null)
  )
  (fn-expr + current-found (? CodeHit) :get
    (if-expr (or (== index null) (>= index (. found length))) null ([] found index))
    (where
      (lazy index current)
    )
  )
  (fn-do + set-query _
    (param next (? CodeFindQuery))
    (= query next)
    (= pattern null)
    (= problem null)
    (= found (call (of List CodeHit)))
    (= current null)
    (= is-truncated false)
    (= searched 0)
    (return-if (if (or (== next null) (== (. next text length) 0))))
    (let compiled (catch (call Regex (call code-find-pattern next) (call code-find-ignores-case next))))
    (if (is compiled RegexError)
      (= problem (. (as compiled RegexError) message))
      (else
        (= pattern (as compiled Regex))
      )
    )
  )
  (fn-do + reset _
    (= rows (call (of List CodeFindRow)))
    (= found (call (of List CodeHit)))
    (= current null)
    (= searched 0)
  )
  (fn-expr + is-stale Bool
    (param target CodeFindTarget)
    (!= searched (call (. target find-stamp)))
  )
  (fn-do + search _
    (param target CodeFindTarget)
    (let held current-found)
    (= found (call (of List CodeHit)))
    (= current null)
    (= is-truncated false)
    (= searched (call (. target find-stamp)))
    (let active pattern)
    (return-if (if (not active)))
    (= problem null)
    (= rows (call (. target find-rows) false))
    (let made (list CodeHit))
    (for (in row (..< 0 (. rows length)))
      (let shown ([] rows row))
      (if (and (< (. made length) code-find-limit) (. shown is-searched))
        (for (in hit (call row-hits active shown row))
          (+= made hit)
        )
      )
    )
    (= is-truncated (>= (. made length) code-find-limit))
    (= found made)
    (if held
      (call pick (. held row) (. held start))
    )
  )
  (fn-do + pick _
    (param row Size)
    (param column Size)
    (= current null)
    (return-if (if (== (. found length) 0)))
    (let low Size 0)
    (let high (. found length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (let hit ([] found middle))
      (if (or (< (. hit row) row) (and (== (. hit row) row) (< (. hit start) column)))
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (= current (if-expr (< low (. found length)) low 0))
  )
  (fn-do + step _
    (param forward Bool)
    (return-if (if (== (. found length) 0)))
    (let index current)
    (if (== index null)
      (= current (if-expr forward 0 (- (. found length) 1)))
      (else-if forward
        (= current (if-expr (< (+ index 1) (. found length)) (+ index 1) 0))
      )
      (else
        (= current (if-expr (> index 0) (- index 1) (- (. found length) 1)))
      )
    )
  )
  (fn-do + first-at Size
    (param row Size)
    (let low Size 0)
    (let high (. found length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< (. ([] found middle) row) row)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
  (fn-expr + replacement String (?! RegexError)
    (param hit CodeHit)
    (param template String)
    (call expanded (. shown content) (- (. hit start) (. shown start)) template)
    (where
      (lazy shown ([] rows (. hit row)))
    )
  )
  (fn-do + replace-all CodeReplaced (?! RegexError)
    (param target CodeFindTarget)
    (param template String)
    (let active pattern)
    (return-if (call CodeReplaced 0 0 0 0) (if (not active)))
    (let lines (call (. target find-rows) true))
    (let targets (list Size))
    (let contents (list String))
    (let total Size 0)
    (let skipped Size 0)
    (for (in row (..< 0 (. lines length)))
      (let shown ([] lines row))
      (if (. shown is-searched)
        (let made (call row-replaced active (. shown content) template))
        (if made
          (if (call (. target find-can-edit) row)
            (+= targets row)
            (+= contents (. made text))
            (+= total (. made count))
            (else
              (+= skipped 1)
            )
          )
        )
      )
    )
    (let outcome (call (. target find-rewrite) targets contents))
    (return (call CodeReplaced total (. outcome changed) skipped (. outcome held)))
  )
  (fn-expr _ expanded String (?! RegexError)
    (param content String)
    (param offset Size)
    (param template String)
    (if-expr (not (?? (?. query is-regex) false)) template (call (. (!! pattern) expand) content template offset))
  )
  (fn-do _ row-replaced (? CodeRowReplaced) (?! RegexError)
    (param active Regex)
    (param content String)
    (param template String)
    (let parts (list String))
    (let last Size 0)
    (let count Size 0)
    (for (in hit (call (. active find-all) content))
      (if (> (. hit end) (. hit start))
        (+= parts ([] content (..< last (. hit start))))
        (+= parts (call expanded content (. hit start) template))
        (= last (. hit end))
        (+= count 1)
      )
    )
    (return-if null (if (== count 0)))
    (+= parts ([] content (..< last (. content length))))
    (return (call CodeRowReplaced (call (. "" join) parts) count))
  )
  (fn-do _ row-hits (list CodeHit)
    (param active Regex)
    (param shown CodeFindRow)
    (param row Size)
    (let hits (list CodeHit))
    (let matched (catch (call (. active find-all) (. shown content))))
    (if (is matched RegexError)
      (= problem (. (as matched RegexError) message))
      (return hits)
    )
    (for (in hit (as matched (list RegexMatch)))
      (if (> (. hit end) (. hit start))
        (+= hits (call CodeHit row (+ (. shown start) (. hit start)) (+ (. shown start) (. hit end))))
      )
    )
    (return hits)
  )
)

(fn-expr _ code-find-pattern String
  (param query CodeFindQuery)
  (if-expr (not (. query matches-word)) body (str "(?<![\\p{L}\\p{N}_-])(?:" body ")(?![\\p{L}\\p{N}_-])"))
  (where
    (lazy body (if-expr (. query is-regex) (. query text) (call regex-escape (. query text))))
  )
)

(fn-expr _ code-find-ignores-case Bool
  (param query CodeFindQuery)
  (and (not (. query matches-case)) (== (. query text) (. query text lowercased)))
)
