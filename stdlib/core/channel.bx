(import ./core)
(import ./error)
(import ./function)
(import ./io)
(import ./list)
(import ./number)
(import ./range)
(import ./stream)
(import ./task)

(type + (of SyncChannel Message)
  (implements (of Iterable Message))
  (implements (of Writable Message))
  (implements Closable)
  (implements Inspectable)
  (prop + is-closed _ (= false))
  (blank)
  (prop _ mutex Mutex)
  (prop _ readers _ (= (call (of IOQueue Message))))
  (prop _ writers _ (= (call (of IOQueue Message))))
  (fn-do + This _
    (probe-log channel.create (items: this))
  )
  (fn-do + close _
    (call (. mutex lock))
    (if (not is-closed)
      (probe-log (: this channel.close) (items: (call get-current-task-id)))
      (blank)
      (= is-closed true)
      (blank)
      (let waiting-readers (call (. readers take-all)))
      (call (. mutex unlock))
      (blank)
      (for (in reader waiting-readers)
        (call (. reader task resume-later))
      )
      (else
        (call (. mutex unlock))
      )
    )
  )
  (fn-do + inspectable-snapshot _
    (call (. mutex lock))
    (let reader-count (. readers length))
    (let writer-count (. writers length))
    (call (. mutex unlock))
    (blank)
    (probe-assign (: this channel.is.closed) is-closed)
    (probe-assign (: this channel.reader.count) reader-count)
    (probe-assign (: this channel.writer.count) writer-count)
  )
  (fn-do + (infix this <- (param message Message)) _
    (call (. mutex lock))
    (if is-closed
      (call (. mutex unlock))
      (throw (call Panic "Can't write to closed channel"))
    )
    (blank)
    (probe-log (: this channel.write) (items: (preview message) (call get-current-task-id)))
    (blank)
    (let reader (call pop-live-reader))
    (if reader
      (= (. reader message) message)
      (call (. mutex unlock))
      (call (. reader task resume-now))
      (else
        (let writer (call (of IOWaiter Message) (call Task) message))
        (call (. writers push) writer)
        (call (. mutex unlock))
        (blank)
        (let was-canceled (call (. writer task suspend)))
        (if was-canceled
          (call (. mutex lock))
          (call (. writers remove) writer)
          (call (. mutex unlock))
        )
        (call check-task-cancelation was-canceled)
      )
    )
  )
  (fn-do + (prefix <- this) (? Message)
    (call (. mutex lock))
    (let writer (call (. writers pop-first)))
    (if writer
      (call (. mutex unlock))
      (call (. writer task resume-later))
      (blank)
      (probe-log (: this channel.read) (items: (preview (!! (. writer message))) (call get-current-task-id)))
      (return (. writer message))
      (else-if (not is-closed)
        (let reader (call (of IOWaiter Message) (call Task)))
        (call (. readers push) reader)
        (call (. mutex unlock))
        (blank)
        (let was-canceled (call (. reader task suspend)))
        (if was-canceled
          (call (. mutex lock))
          (if (. reader is-queued)
            (call (. readers remove) reader)
            (else-if (!= (. reader message) null)
              (let next (call pop-live-reader))
              (if next
                (= (. next message) (. reader message))
                (call (. next task resume-later))
              )
            )
          )
          (call (. mutex unlock))
        )
        (call check-task-cancelation was-canceled)
        (blank)
        (if (. reader message)
          (probe-log (: this channel.read) (items: (preview (. reader message)) (call get-current-task-id)))
        )
        (return (. reader message))
      )
      (else
        (call (. mutex unlock))
      )
    )
  )
  (fn-do _ pop-live-reader (? (of IOWaiter Message))
    (let reader (call (. readers pop-first)))
    (while (and reader (. reader task is-cancel-in-force))
      (= reader (call (. readers pop-first)))
    )
    (return reader)
  )
)

(type + (of SyncBufferedChannel Message)
  (implements (of Iterable Message))
  (implements (of Writable Message))
  (implements Closable)
  (implements Inspectable)
  (prop + is-closed _ (= false))
  (blank)
  (prop _ mutex Mutex)
  (prop _ readers _ (= (call (of IOQueue Message))))
  (prop _ buffer _ (= (call (of IOBuffer Message))))
  (fn-do + This _
    (probe-log channel.create (items: this))
  )
  (fn-do + close _
    (probe-log (: this channel.close) (items: (call get-current-task-id)))
    (blank)
    (call (. mutex lock))
    (= is-closed true)
    (let waiting-readers (call (. readers take-all)))
    (call (. mutex unlock))
    (blank)
    (for (in reader waiting-readers)
      (call (. reader task resume-later))
    )
  )
  (fn-do + inspectable-snapshot _
    (probe-assign (: this channel.is.closed) is-closed)
    (probe-assign (: this channel.reader.count) (. readers length))
    (probe-assign (: this channel.buffer.length) (. buffer length))
  )
  (fn-expr + is-empty _ :get
    (and (not (. buffer length)) (not (. readers length)))
  )
  (fn-do + (infix this <- (param message Message)) _
    (call (. mutex lock))
    (blank)
    (if is-closed
      (call (. mutex unlock))
      (return)
    )
    (probe-log (: this channel.write) (items: (preview message) (call get-current-task-id)))
    (blank)
    (let reader (call (. readers pop-first)))
    (if reader
      (= (. reader message) message)
      (call (. mutex unlock))
      (call (. reader task resume-now))
      (else
        (call (. buffer push) message)
        (call (. mutex unlock))
      )
    )
  )
  (fn-do + (prefix <- this) (? Message)
    (call (. mutex lock))
    (if (. buffer length)
      (let message (call (. buffer pop-first)))
      (call (. mutex unlock))
      (blank)
      (probe-log (: this channel.read) (items: (preview message) (call get-current-task-id)))
      (return message)
      (else-if (not is-closed)
        (let reader (call (of IOWaiter Message) (call Task)))
        (call (. readers push) reader)
        (call (. mutex unlock))
        (blank)
        (let was-canceled (call (. reader task suspend)))
        (if was-canceled
          (call (. mutex lock))
          (if (. reader is-queued)
            (call (. readers remove) reader)
            (else-if (!= (. reader message) null)
              (let next (call (. readers pop-first)))
              (if next
                (= (. next message) (. reader message))
                (call (. next task resume-later))
                (else
                  (call (. buffer push-first) (!! (. reader message)))
                )
              )
            )
          )
          (call (. mutex unlock))
        )
        (call check-task-cancelation was-canceled)
        (blank)
        (if (. reader message)
          (probe-log (: this channel.read) (items: (preview (. reader message)) (call get-current-task-id)))
        )
        (return (. reader message))
      )
      (else
        (call (. mutex unlock))
      )
    )
  )
)

(type + (of AsyncChannel Message)
  (implements (of Broadcastable Message))
  (implements (of Writable Message))
  (implements Closable)
  (implements Inspectable)
  (prop + is-closed _ (= false))
  (prop + closed _ (:= (call OneShotChannel)))
  (blank)
  (prop _ subscriptions (list (of Subscribable Message)))
  (prop _ mutex _ (= (call Mutex)))
  (fn-do + This _
    (probe-log channel.create (items: this))
  )
  (fn-do + subscribe _
    (param subscriber (of Subscriber Message))
    (call subscribe (call Subscription subscriber))
  )
  (fn-do + unsubscribe _
    (param subscriber (of Subscriber Message))
    (probe-log (: this channel.unsubscribe) (items: (preview subscriber)))
    (blank)
    (call (. mutex lock))
    (let index Index 0)
    (while (< index (. subscriptions length))
      (if (== ([] subscriptions index) subscriber)
        (call remove-subscription index)
        (return)
      )
      (+= index 1)
    )
    (call (. mutex unlock))
  )
  (fn-do + subscribe _
    (param subscriber (of Subscribable Message))
    (throw (call Panic "Illegal to subscribe while closed") (if is-closed))
    (blank)
    (call (. mutex lock))
    (= subscriptions (++ subscriptions (list subscriber)))
    (call (. mutex unlock))
  )
  (fn-do + unsubscribe _
    (param subscriber (of Subscribable Message))
    (call (. mutex lock))
    (let index Index 0)
    (while (< index (. subscriptions length))
      (if (== (as ([] subscriptions index) Pointer) (as subscriber Pointer))
        (call remove-subscription index)
        (return)
      )
      (+= index 1)
    )
    (call (. mutex unlock))
  )
  (fn-do + close _
    (if (not is-closed)
      (= is-closed true)
      (call (. closed done))
      (call finish-subscriptions)
    )
  )
  (fn-do + inspectable-snapshot _
    (probe-assign (: this channel.is.closed) is-closed)
    (probe-assign (: this channel.subscription.count) (. subscriptions length))
  )
  (fn-do + (infix this <- (param message Message)) _
    (if is-closed
      (throw (call Panic "Can't write to closed broadcaster"))
    )
    (blank)
    (probe-log (: this channel.write) (items: (preview message) (call get-current-task-id)))
    (blank)
    (for (in sub subscriptions)
      (call sub message this)
    )
  )
  (fn-expr + (prefix ! this) _
    (not subscriptions)
  )
  (fn-do _ finish-subscriptions _
    (let finishing subscriptions)
    (let index (. finishing length))
    (while index
      (-= index 1)
      (call (. ([] finishing index) finish) this)
    )
  )
  (fn-do _ remove-subscription _
    (param index Index)
    (let sub ([] subscriptions index))
    (= subscriptions (++ ([] subscriptions (... _ index)) ([] subscriptions (... (+ index 1)))))
    (call (. mutex unlock))
    (call (. sub unsubscribe))
  )
)

(type + (of AsyncBufferedChannel Message)
  (implements (of Readable Message))
  (implements (of Writable Message))
  (implements (of Broadcastable Message))
  (implements Closable)
  (implements Inspectable)
  (prop + is-closed _ (= false))
  (blank)
  (prop _ subscriptions (list (of Subscribable Message)))
  (prop _ buffer _ (= (call (of IOBuffer Message))))
  (prop _ mutex _ (= (call Mutex)))
  (fn-do + (prefix <- this) (? Message)
    (if (. buffer length)
      (let message (call (. buffer pop-first)))
      (for (in sub subscriptions)
        (call sub message this)
      )
      (return message)
    )
  )
  (fn-do + subscribe _
    (param subscriber (of Subscriber Message))
    (call subscribe (call Subscription subscriber))
  )
  (fn-do + unsubscribe _
    (param subscriber (of Subscriber Message))
    (call (. mutex lock))
    (let index Index 0)
    (while (< index (. subscriptions length))
      (if (== ([] subscriptions index) subscriber)
        (call remove-subscription index)
        (return)
      )
      (+= index 1)
    )
    (call (. mutex unlock))
  )
  (fn-do + subscribe _
    (param subscriber (of Subscribable Message))
    (throw (call Panic "Illegal to subscribe while closed") (if is-closed))
    (blank)
    (call (. mutex lock))
    (= subscriptions (++ subscriptions (list subscriber)))
    (call (. mutex unlock))
    (if (. buffer length)
      (call flush)
    )
  )
  (fn-do + unsubscribe _
    (param subscriber (of Subscribable Message))
    (call (. mutex lock))
    (let index Index 0)
    (while (< index (. subscriptions length))
      (if (== (as ([] subscriptions index) Pointer) (as subscriber Pointer))
        (call remove-subscription index)
        (return)
      )
      (+= index 1)
    )
    (call (. mutex unlock))
  )
  (fn-do + close _
    (if (not is-closed)
      (= is-closed true)
      (call finish-subscriptions)
    )
  )
  (fn-do + inspectable-snapshot _
    (probe-assign (: this channel.is.closed) is-closed)
    (probe-assign (: this channel.subscription.count) (. subscriptions length))
    (probe-assign (: this channel.buffer.length) (. buffer length))
  )
  (fn-do + (infix this <- (param message Message)) _
    (if is-closed
      (return)
    )
    (blank)
    (if subscriptions
      (for (in sub subscriptions)
        (call sub message this)
      )
      (else
        (call (. buffer push) message)
      )
    )
  )
  (fn-expr + (prefix ! this) _
    (not subscriptions)
  )
  (fn-do _ finish-subscriptions _
    (let finishing subscriptions)
    (let index (. finishing length))
    (while index
      (-= index 1)
      (call (. ([] finishing index) finish) this)
    )
  )
  (fn-do _ remove-subscription _
    (param index Index)
    (let sub ([] subscriptions index))
    (= subscriptions (++ ([] subscriptions (... _ index)) ([] subscriptions (... (+ index 1)))))
    (call (. mutex unlock))
    (call (. sub unsubscribe))
  )
  (fn-do + flush _
    (while (. buffer length)
      (<- this)
    )
  )
)

(type + (of AsyncOnDemandChannel Message Used)
  (constraint = Used Void)
  (implements (of Broadcastable Message))
  (implements (of Writable Message))
  (implements Closable)
  (prop + is-closed _ (= false))
  (blank)
  (prop _ usable (of Usable Used))
  (prop _ subscriptions (list (of Subscribable Message)))
  (prop _ mutex _ (= (call Mutex)))
  (fn-do + This _
    (param usable (of Usable Used))
  )
  (fn-do + subscribe _
    (param subscriber (of Subscriber Message))
    (call subscribe (call Subscription subscriber))
  )
  (fn-do + unsubscribe _
    (param subscriber (of Subscriber Message))
    (call (. mutex lock))
    (let index Index 0)
    (while (< index (. subscriptions length))
      (if (== ([] subscriptions index) subscriber)
        (call remove-subscription index)
        (if (and (not subscriptions) (not is-closed))
          (call (. usable end-using))
        )
        (return)
      )
      (+= index 1)
    )
    (call (. mutex unlock))
  )
  (fn-do + subscribe _
    (param subscriber (of Subscribable Message))
    (throw (call Panic "Illegal to subscribe while closed") (if is-closed))
    (blank)
    (call (. mutex lock))
    (let needs-starting (not subscriptions))
    (= subscriptions (++ subscriptions (list subscriber)))
    (call (. mutex unlock))
    (blank)
    (if needs-starting
      (call (. usable begin-using))
    )
  )
  (fn-do + unsubscribe _
    (param subscriber (of Subscribable Message))
    (call (. mutex lock))
    (let index Index 0)
    (while (< index (. subscriptions length))
      (if (== (as ([] subscriptions index) Pointer) (as subscriber Pointer))
        (call remove-subscription index)
        (if (and (not subscriptions) (not is-closed))
          (call (. usable end-using))
        )
        (return)
      )
      (+= index 1)
    )
    (call (. mutex unlock))
  )
  (fn-do + close _
    (if (not is-closed)
      (= is-closed true)
      (blank)
      (if subscriptions
        (call finish-subscriptions)
        (call (. usable end-using))
      )
    )
  )
  (fn-do + (infix this <- (param message Message)) _
    (if is-closed
      (return)
    )
    (blank)
    (for (in sub subscriptions)
      (call sub message this)
    )
  )
  (fn-expr + (prefix ! this) _
    (not subscriptions)
  )
  (fn-do _ finish-subscriptions _
    (let finishing subscriptions)
    (let index (. finishing length))
    (while index
      (-= index 1)
      (call (. ([] finishing index) finish) this)
    )
  )
  (fn-do _ remove-subscription _
    (param index Index)
    (let sub ([] subscriptions index))
    (= subscriptions (++ ([] subscriptions (... _ index)) ([] subscriptions (... (+ index 1)))))
    (call (. mutex unlock))
    (call (. sub unsubscribe))
  )
)

(type + OneShotChannel
  (implements (of Iterable Bool))
  (prop _ readers _ (= (call (of IOQueue Bool))))
  (fn-do + (prefix <- this) _
    (let reader (call (of IOWaiter Bool) (call Task)))
    (call (. readers push) reader)
    (blank)
    (let was-canceled (call (. reader task suspend)))
    (if was-canceled
      (call (. readers remove) reader)
    )
    (call check-task-cancelation was-canceled)
  )
  (fn-do + done _
    (for (in reader (call (. readers take-all)))
      (call (. reader task resume-later))
    )
  )
)

(fn-expr + (of create-buffered-stream Message) _
  (param input (of Iterable Message))
  (call (of SyncBufferedChannel Message))
)

(fn-expr + (of create-buffered-stream Message) _
  (param input (of Broadcastable Message))
  (call (of AsyncBufferedChannel Message))
)

(fn-do + await _
  (param fn Doer)
  (let sem (call Semaphore))
  (do-new-thread
    (call fn
      (block
        (on-error (: error Error)
          (call unhandled-error error)
        )
      )
    )
    (call (. sem post))
  )
  (call (. sem wait))
)

(fn-do + (of await Result) (? Result)
  (param fn (of Getter Result))
  (let sem (call (of Semaphore Result)))
  (do-new-thread
    (let value (call fn))
    (call (. sem post) value)
  )
  (return (call (. sem await)))
)
