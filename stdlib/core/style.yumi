for position in 0 .. < style-theme-tags.length
    if style-theme-tags[position] == name
        = 1u64 /lshift/ position
?! StyleSheetPanic("A program names at most 64 theme tags")
    if style-theme-tags.length >= 64
style-theme-tags += name
= 1u64 /lshift/ (style-theme-tags.length - 1)

