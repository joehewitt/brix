recording = added
if added == site-template
    recording-base = 0
    =
if !extra-site-templates
    extra-site-templates = List'StyleSiteTemplate()
. extras = extra-site-templates!
. index Size = 0
while index < extras.length
    if extras[index] == added
        recording-base = block-base-at(index + 1)
        =
    index += 1
recording-base = block-count as I64
extras += added
=? if recording-base == 0
if !extra-block-bases
    extra-block-bases = List'I64()
. bases = extra-block-bases!
while bases.length + 1 < extras.length
    bases += 0
bases += recording-base

