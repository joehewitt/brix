+ do style-author-dynamic
    - object-pointer CPointer'Void
    - style StyleInfo
    - offset Size
    - layer U32
    - order U32
    - block I64
    - bits I64
    - is-none Bool

` Live write for one dynamic authored declaration. Unmounted subjects drop the write: authored
` state is contextual, and mounting re-runs the site's dynamic actions to re-derive it.

. attachment = style-live-attachment(object-pointer)
=? if !attachment

. live-record = style-ensure-node-record(attachment)
. store = style-attachment-store(attachment)
. existing = style-record-authored-at-site(live-record, style, offset, layer, order)
if existing && !existing.is-shared
    =? if existing.kind == StyleValueKind.dynamic && existing.block == block && same-value
    .. same-value = existing.is-none == is-none && existing.bits == bits
    style-authored-assign-dynamic(existing, bits, is-none)
else
    . declaration = AuthoredDeclaration(style)
    declaration.offset = offset
    declaration.layer = layer
    declaration.order = order
    declaration.block = block
    declaration.kind = StyleValueKind.dynamic
    declaration.bits = bits
    declaration.is-none = is-none
    if existing
        =? if style-record-has-identical-authored(live-record, declaration)
        style-record-upsert-authored(live-record, declaration, store)
    else
        live-record.authored += declaration

attachment.dirty-bits = attachment.dirty-bits /or/ style-dirty-bit
live-record.dirty-bits = live-record.dirty-bits /or/ style-dirty-bit
store.enqueue-dirty(attachment)

