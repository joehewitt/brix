. attachment = style-live-attachment(owner as Pointer)
=? false if !attachment
. live = attachment
. record = style-ensure-node-record(live)
. lane = record.presented ?? StylePresentation()
record.presented = lane
. property = info.property-at(offset)
. held = style-slot-holder(property, bits) if property && !none
lane.put(info.style-index, offset, bits, none, held, false)
. store = style-attachment-store(live)
