_ do style-apply-mount Bool
    - node MarkupElement
    - parent MarkupElement?
    - root MarkupRootElement?

` Single-node mount, unmount, or rehome event from the markup runtime (markup-adopt). Returns
` true when this node's own mount state changed, telling the runtime walk to continue into the
` node's children; same-root parent rehomes and no-ops return false and prune the walk. Mount
` panics fire before any caller link mutation, so host mutators stay atomic without a preflight.

. node-pointer = node as Pointer
. existing = style-live-attachment(node-pointer)
if node.markup-is-transparent-region
    if existing
        style-unmount(node-pointer)
    = root != null

if !root
    if existing
        style-unmount(node-pointer)
        = true
    = false

. batch = root
. root-pointer = batch as Pointer

if existing
    . store = style-attachment-store(existing)
    if store.batch-address != root-pointer.address
        ` Moving between roots is semantically unmount followed by mount; nothing styled survives
        style-unmount(node-pointer)
        style-apply-mount(node, parent, root)
        = true
    style-update-parent(existing, parent)
    = false

. store = style-root-store(batch, root-pointer, node-pointer)
if store
    . live-store = store
    . attachment = style-mount(node-pointer, live-store, parent)
    if root-pointer == node-pointer
        live-store.root-owner-address = node-pointer.address as Size
    = true

= false

