+ builder MarkupSlotBuilder'MarkupElement
+ enabled = true
+ node MarkupElement?

────────────────────
+ This
    - target
    - slot
    - order
    - builder

────────────────────
+ do detach

. existing = node
=? if !existing

node = null
markup-remove-shadow(existing)

────────────────────
+ do refresh
    - should-rebuild = false

if !enabled
    detach()
    =
if node
    =? if !should-rebuild
    detach()

. parent = style-content-parent(target, slot)
=? if !parent

. child = builder()
node = child
. anchor = style-content-anchor(target, slot, parent)
markup-insert-shadow(parent, child, target, slot, anchor)

