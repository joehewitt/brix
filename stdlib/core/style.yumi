    - target [Index]
    - source [Index]

target.clear()
for entry in source
    target += entry

━━━━━━━━━━━━━━━━━━━━
_ do style-raise-flipped-style-domains
    - store RootStyleStore
    - attachment MarkupAttachment
    - record StyleRecord
    - style-index Index

. found = style-info-at(style-index)
=? if !found
. info = found
. offsets = style-participating-offsets(store, attachment, record, info)
if offsets == 0
    style-raise-domain-masks(store, attachment, info.self-domain-mask, info.parent-domain-mask)
    =
. self-mask U32
. parent-mask U32
for property in info.properties
    if (offsets /and/ (1u64 /lshift/ property.offset)) != 0
        self-mask = self-mask /or/ property.self-domain-mask
        parent-mask = parent-mask /or/ property.parent-domain-mask
style-raise-domain-masks(store, attachment, self-mask, parent-mask)

━━━━━━━━━━━━━━━━━━━━
_ do style-participating-offsets U64
    - store RootStyleStore
    - attachment MarkupAttachment
    - record StyleRecord
    - info StyleInfo

. offsets U64
. assoc = style-live-site-association(attachment)
if assoc
    . live-assoc = assoc
    . template-index Size = 0
    while template-index < live-assoc.site-template-count()
        for declaration in live-assoc.site-template-at(template-index).declarations
            if declaration.style.style-index == info.style-index
                offsets = offsets /or/ (1u64 /lshift/ declaration.offset)
        template-index += 1

for declaration in record.authored
    if declaration.style.style-index == info.style-index
        offsets = offsets /or/ (1u64 /lshift/ declaration.offset)

for position in 0 .. < record.segments.length
    if style-segment-key-style(record.segment-keys[position]) == info.style-index
        . initial = store.initial-segment(info)
        offsets = offsets /or/ style-diff-segments(record.segments[position], initial, info)
= offsets

━━━━━━━━━━━━━━━━━━━━
_ do style-recompute-activation
    - store RootStyleStore
    - attachment MarkupAttachment
    - record StyleRecord

` The active style set is derived from settled state: a style activates when any enabled
` declaration authors one of its properties, or when inheritance/style-sheet settling leaves any
` computed property divergent from that style's initial segment. An active-set change raises the
` domains of the flipped style's properties that are declared on the node or divergent, so
` downstream phases re-run even when no additional computed property changed; a property that is
` neither reads its initial value whether or not its style is active. Style indexes are
` program-wide and can exceed one machine word, so the active set is stored as a small unique index
` list rather than a U64 mask.

. active = store.scratch-active-styles
active.clear()
. assoc = style-live-site-association(attachment)
if assoc
    . live-assoc = assoc
    . template-index Size = 0
    while template-index < live-assoc.site-template-count()
        . base = live-assoc.block-base-at(template-index)
        for declaration in live-assoc.site-template-at(template-index).declarations
            . declared = declaration.style
            if style-record-declaration-enabled(record, declaration, base)
                style-index-list-add(active, declared.style-index)
        template-index += 1

for declaration in record.authored
    . declared = declaration.style
    if style-record-declaration-enabled(record, declaration)
        style-index-list-add(active, declared.style-index)

for position in 0 .. < record.segments.length
    . style-index = style-segment-key-style(record.segment-keys[position])
    . info = style-info-at(style-index)
    if info
        if !style-segments-match(record.segments[position], store.initial-segment(info), info)
            style-index-list-add(active, style-index)

=? if style-index-lists-match(active, record.active-styles)

for active-index in active
    if !style-index-list-has(record.active-styles, active-index)
        style-raise-flipped-style-domains(store, attachment, record, active-index)

for previous-index in record.active-styles
    if !style-index-list-has(active, previous-index)
        style-raise-flipped-style-domains(store, attachment, record, previous-index)

style-copy-index-list(record.active-styles, active)

━━━━━━━━━━━━━━━━━━━━
_ do style-collect-candidate
    - candidates [Index]
    - style-index Index

style-index-list-add(candidates, style-index)

━━━━━━━━━━━━━━━━━━━━
_ do style-settle-record
    - store RootStyleStore
    - attachment MarkupAttachment
    - record StyleRecord

` Candidate styles: styles with authored declarations here, styles the record holds a segment for,
` and styles where the parent holds a segment with inheritable properties. Style indexes are
` program-wide, so the candidate set is a small reusable list.

. candidates = store.scratch-style-candidates
candidates.clear()
. assoc = style-live-site-association(attachment)
if assoc
    . live-assoc = assoc
    . template-index Size = 0
    while template-index < live-assoc.site-template-count()
        for declaration in live-assoc.site-template-at(template-index).declarations
            style-collect-candidate(candidates, declaration.style.style-index)
        template-index += 1

for declaration in record.authored
    style-collect-candidate(candidates, declaration.style.style-index)

for key in record.segment-keys
    style-collect-candidate(candidates, style-segment-key-style(key))

. parent-attachment = style-parent-attachment(attachment)
if parent-attachment
    . parent-record = style-node-record(parent-attachment)
    if parent-record
        for key in parent-record.segment-keys
            . parent-index = style-segment-key-style(key)
            . parent-info = style-info-at(parent-index)
            if parent-info && parent-info.inherited-mask != 0
                style-collect-candidate(candidates, parent-index)

. candidate-index Index = 0
while candidate-index < candidates.length
    . settle-index = candidates[candidate-index]
    . settle-info = style-info-at(settle-index)
    if settle-info
        style-settle-style(store, attachment, record, settle-info)
    candidate-index += 1

if store.motion-changes
    . changes = store.motion-changes
    store.motion-changes = List'StyleValueChange()
    style-motion-host?.style-values-changed(attachment.host, changes)

` Every candidate settled successfully, so no published segment still names a replaced holder.
for declaration in record.authored
    declaration.settled-held = null

━━━━━━━━━━━━━━━━━━━━
_ do style-record-drop-segment
    - record StyleRecord
    - style-index Index

. position = style-held-segment-position(record, style-index)
if position >= 0
    record.segments.remove(position)
    record.segment-keys.remove(position)
    record.segment-mask = record.segment-mask /and/ (style-segment-bit(style-index) /xor/ U64.max)

━━━━━━━━━━━━━━━━━━━━
_ style-segment-key Index
    - style-index Index
    - owned Bool

style-index * 2 + (if owned then 1 else 0)

━━━━━━━━━━━━━━━━━━━━
_ style-segment-key-owned Bool
    - key Index

key % 2 == 1

━━━━━━━━━━━━━━━━━━━━
_ style-held-segment-position I64 @inline
    - record StyleRecord
    - style-index Index

|? style-index >= 64
    style-wide-held-segment-position(record, style-index)
|? (record.segment-mask /and/ bit) == 0
    -1
??
    style-bit-count(record.segment-mask /and/ (bit - 1)) as I64

.. bit = 1u64 /lshift/ style-index

━━━━━━━━━━━━━━━━━━━━
_ style-segment-position Index
    - record StyleRecord
    - style-index Index

|? style-index < 64
    style-bit-count(record.segment-mask /and/ ((1u64 /lshift/ style-index) - 1))
??
    style-wide-segment-position(record, style-index)

━━━━━━━━━━━━━━━━━━━━
_ style-wide-held-segment-position I64
    - record StyleRecord
    - style-index Index

|? position < keys.length && style-segment-key-style(keys[position]) == style-index
    position as I64
??
    -1

.. keys = record.segment-keys
.. position = style-wide-segment-position(record, style-index)

━━━━━━━━━━━━━━━━━━━━
_ do style-wide-segment-position Index
    - record StyleRecord
    - style-index Index

. keys = record.segment-keys
. position = style-bit-count(record.segment-mask)
while position < keys.length && style-segment-key-style(keys[position]) < style-index
    position += 1
= position

━━━━━━━━━━━━━━━━━━━━
_ style-segment-bit U64
    - style-index Index

|? style-index < 64
    1u64 /lshift/ style-index
??
    0

━━━━━━━━━━━━━━━━━━━━
_ style-bit-count Index @inline
    - bits U64

((bytes * 0x0101010101010101) /zrshift/ 56) as Index

.. pairs = bits - ((bits /zrshift/ 1) /and/ 0x5555555555555555)
.. nibbles = (pairs /and/ 0x3333333333333333) + ((pairs /zrshift/ 2) /and/ 0x3333333333333333)
.. bytes = (nibbles + (nibbles /zrshift/ 4)) /and/ 0x0f0f0f0f0f0f0f0f

━━━━━━━━━━━━━━━━━━━━
_ do style-store-segment
    - store RootStyleStore
    - record StyleRecord
    - info StyleInfo
    - segment ComputedSegment
    - owned Bool

if segment == store.initial-segment(info)
    style-record-drop-segment(record, info.style-index)
else
    style-record-place-segment(record, info.style-index, segment, owned)

━━━━━━━━━━━━━━━━━━━━
_ style-outranks
    - declaration AuthoredDeclaration
    - other AuthoredDeclaration

|? declaration.layer > other.layer
    true
??
    declaration.layer == other.layer && declaration.order >= other.order

━━━━━━━━━━━━━━━━━━━━
_ do style-bucket-winner
    - store RootStyleStore
    - attachment MarkupAttachment
    - record StyleRecord
    - info StyleInfo
    - declaration AuthoredDeclaration
    - winner-slots [AuthoredDeclaration]
    - base I64 = 0

` One declaration into the per-offset winner table; style-no-winner marks an empty slot.

=? if declaration.style != info
=? if !style-record-declaration-enabled(record, declaration, base)
=? if declaration.family && !style-member-active(store, attachment, declaration.family, members)
.. members = declaration.members
. current = winner-slots[declaration.offset]
if current == style-no-winner || style-outranks(declaration, current)
    winner-slots[declaration.offset] = declaration

━━━━━━━━━━━━━━━━━━━━
_ do style-member-active Bool
    - store RootStyleStore
    - attachment MarkupAttachment
    - family StyleSheetInfo
    - members U64

. member = style-settle-sheet(store, attachment, family).member
= (members /and/ (1u64 /lshift/ (member as Size))) != 0

━━━━━━━━━━━━━━━━━━━━
_ do style-settle-sheet StyleSheetRecord
    - store RootStyleStore
    - attachment MarkupAttachment
    - info StyleSheetInfo

for position in 0 .. < store.scratch-families.length
    if store.scratch-families[position] == info
        = store.scratch-sheets[position]
. record = style-effective-style-sheet(attachment, info)
store.scratch-families += info
store.scratch-sheets += record
= record

━━━━━━━━━━━━━━━━━━━━
_ do style-settle-style
    - store RootStyleStore
    - attachment MarkupAttachment
    - record StyleRecord
    - info StyleInfo

. style-index = info.style-index
. initial = store.initial-segment(info)
. old = style-record-segment(record, style-index) ?? initial

. parent-segment ComputedSegment? = null
. parent-attachment = style-parent-attachment(attachment)
if parent-attachment
    . parent-record = style-node-record(parent-attachment)
    if parent-record
        parent-segment = style-record-segment(parent-record, style-index) ?? initial

` Compute the desired value of every property in the style. One pass over the shared template
` and authored declarations buckets the winner per offset; the property loop then resolves each
` offset without rescanning.
. inherit-source = parent-segment ?? initial
. inheriting U64
. new-values = store.scratch-values
. winner-slots = store.scratch-winners
do finally
    ` Winner declarations can own object holders. Keep list capacity for reuse, but never let the
    ` root store retain the last settled owner's declaration after the settle call returns.
    store.style-clear-declaration-list(winner-slots)
store.scratch-none-mask = 0
store.scratch-families.clear()
store.scratch-sheets.clear()
. has-declaration = false
new-values.clear()
store.style-clear-declaration-list(winner-slots)
while new-values.length < info.slot-count
    new-values += 0
    winner-slots += style-no-winner

. assoc = style-live-site-association(attachment)
if assoc
    . live-assoc = assoc
    . template-index Size = 0
    while template-index < live-assoc.site-template-count()
        . base = live-assoc.block-base-at(template-index)
        for declaration in live-assoc.site-template-at(template-index).declarations
            style-bucket-winner(store, attachment, record, info, declaration, winner-slots, base)
        template-index += 1

for declaration in record.authored
    style-bucket-winner(store, attachment, record, info, declaration, winner-slots)

for property in info.properties
    . offset = property.offset
    . bits I64
    . is-none Bool
    . winner = winner-slots[offset]
    if winner != style-no-winner
        has-declaration = true
        . declaration = winner
        if declaration.kind == StyleValueKind.inherit
            bits = inherit-source.value-bits(offset)
            is-none = inherit-source.value-none(offset)
        else if declaration.kind == StyleValueKind.style-sheet
            . sheet-record = style-settle-sheet(store, attachment, declaration.style-sheet!)
            bits = sheet-record.value-bits(declaration.sheet-offset)
            is-none = sheet-record.value-none(declaration.sheet-offset)
        else if declaration.kind == StyleValueKind.themed
            . made = style-themed-bits
                - declaration
                - style-settle-sheet(store, attachment, declaration.style-sheet!)
            bits = made.bits
            is-none = made.none
        else if declaration.kind == StyleValueKind.style-sheet-projected
            . sheet-record = style-settle-sheet(store, attachment, declaration.style-sheet!)
            . sheet-bits = sheet-record.value-bits(declaration.sheet-offset)
            . sheet-none = sheet-record.value-none(declaration.sheet-offset)
            if declaration.projection-preserves-none && sheet-none
                bits = 0
                is-none = true
            else
                bits = style-projected-declaration-bits(declaration, sheet-bits)
                is-none = false
        else
            bits = declaration.bits
            is-none = declaration.is-none
    else if property.is-inherited && parent-segment
        . live-parent-segment = parent-segment
        bits = live-parent-segment.value-bits(offset)
        is-none = live-parent-segment.value-none(offset)
        inheriting = inheriting /or/ (1u64 /lshift/ offset)
    else
        bits = initial.value-bits(offset)
        is-none = initial.value-none(offset)
    new-values[offset] = bits
    if is-none
        store.scratch-none-mask = store.scratch-none-mask /or/ (1u64 /lshift/ offset)

` Choose the cheapest correct representation: parent flow-through, initial alias, or owned copy
. new-none U64 = store.scratch-none-mask
. alias ComputedSegment? = null
if !has-declaration && info.all-inherited && parent-segment
    alias = parent-segment
else if style-values-match(new-values, new-none, initial)
    alias = initial

. was-owned = style-record-owns-segment(record, style-index)

if alias
    . target = alias
    if old == target
        ` Pointer equality is the unchanged fast path; in-place changes to a shared parent segment
        ` are propagated by the parent's own settle.
        =
    . changed = style-diff-segments(old, target, info)
    . rebound = style-rebound-slots(old, target, info, changed)
    . noted = if attachment.style-settled then changed /and/ style-watched-mask(info) else 0u64
    if noted != 0
        style-note-changes(store, info, noted, old, target)
    if was-owned
        store.release-segment(old)
    style-store-segment(store, record, info, target, false)
    if changed != 0
        style-record-changes(store, attachment, info, changed, rebound, target)
        style-follow-parent(store, attachment, record, info, changed, inheriting)
    =
` Owned write with copy-on-write: never mutate a shared segment
. target = old
if !was-owned
    target = store.allocate-segment(old)
    style-store-segment(store, record, info, target, true)

target.resize(info.slot-count)
. changed U64
. rebound U64
. reporting =
    |? attachment.style-settled
        style-watched-mask(info)
    |? style-motion-host
        info.mount-mask
    ??
        0u64
for property in info.properties
    . offset = property.offset
    . old-bits = old.value-bits(offset)
    . old-none = old.value-none(offset)
    . bits = new-values[offset]
    . none = (new-none /and/ (1u64 /lshift/ offset)) != 0
    if bits != old-bits || none != old-none
        changed = changed /or/ (1u64 /lshift/ offset)
        if (reporting /and/ (1u64 /lshift/ offset)) != 0
            store.motion-changes += StyleValueChange(info, offset, old-bits, old-none, bits, none)
        if none == old-none && style-slot-rebound(property, old-bits, bits)
            rebound = rebound /or/ (1u64 /lshift/ offset)
    target.values[offset] = bits
target.none-mask = new-none

if changed != 0
    target.changed-mask = changed
    target.generation += 1
    style-record-changes(store, attachment, info, changed, rebound, target)
    style-follow-parent(store, attachment, record, info, changed, inheriting)

━━━━━━━━━━━━━━━━━━━━
_ do style-follow-parent
    - store RootStyleStore
    - attachment MarkupAttachment
    - record StyleRecord
    - info StyleInfo
    - changed U64
    - inheriting U64

. own = record.presented
if own
    for entry in List'StylePresentedValue(own.entries)
        if entry.follows && entry.style-index == info.style-index && offset-changed
            own.remove(entry.style-index, entry.offset)
        .. offset-changed = (changed /and/ (1u64 /lshift/ entry.offset)) != 0
    if !own.entries
        record.presented = null
=? if (changed /and/ inheriting) == 0
. parent = style-parent-attachment(attachment)
=? if !parent
. source = style-node-record(parent)?.presented
=? if !source
for entry in source.entries
    if same-style && (changed /and/ inheriting /and/ (1u64 /lshift/ entry.offset)) != 0
        . lane = record.presented ?? StylePresentation()
        record.presented = lane
        if !lane.find(entry.style-index, entry.offset)
            lane.put(entry.style-index, entry.offset, entry.bits, entry.none, entry.held, true)
            style-drop-motion-change(store, info, entry.offset)
    .. same-style = entry.style-index == info.style-index

━━━━━━━━━━━━━━━━━━━━
_ do style-drop-motion-change
    - store RootStyleStore
    - info StyleInfo
    - offset Size

. changes = store.motion-changes
. index = changes.length
while index > 0
    index -= 1
    . change = changes[index]
    if change.info == info && change.offset == offset
        changes.remove(index)

━━━━━━━━━━━━━━━━━━━━
_ do style-present-followers
    - store RootStyleStore
    - attachment MarkupAttachment
    - record StyleRecord
    - info StyleInfo
    - offset Size
    - bits I64
    - none Bool
    - held StyleObjectHolder?

. segment = style-record-segment(record, info.style-index)
. child = style-first-child-attachment(attachment)
while child
    . live = child
    . child-record = style-node-record(live)
    if child-record
        . lane = child-record.presented
        . existing = lane?.find(info.style-index, offset)
        . aliases = !!segment && style-record-segment(child-record, info.style-index) == segment
        if (existing && existing.follows) || (!existing && aliases)
            . shown = lane ?? StylePresentation()
            child-record.presented = shown
            shown.put(info.style-index, offset, bits, none, held, true)
            style-raise-changed-domains(store, live, info, 1u64 /lshift/ offset)
            style-present-followers(store, live, child-record, info, offset, bits, none, held)
    child = style-next-child-attachment(attachment, live)

━━━━━━━━━━━━━━━━━━━━
_ do style-unpresent-followers
    - store RootStyleStore
    - attachment MarkupAttachment
    - info StyleInfo
    - offset Size

. child = style-first-child-attachment(attachment)
while child
    . live = child
    . child-record = style-node-record(live)
    . lane = child-record?.presented
    . existing = lane?.find(info.style-index, offset)
    if child-record && lane && existing && existing.follows
        lane.remove(info.style-index, offset)
        if !lane.entries
            child-record.presented = null
        style-raise-changed-domains(store, live, info, 1u64 /lshift/ offset)
        style-unpresent-followers(store, live, info, offset)
    child = style-next-child-attachment(attachment, live)

━━━━━━━━━━━━━━━━━━━━
_ do style-note-changes
    - store RootStyleStore
    - info StyleInfo
    - changed U64
    - old ComputedSegment
    - target ComputedSegment

for property in info.properties
    . offset = property.offset
    if (changed /and/ (1u64 /lshift/ offset)) != 0
        . old-bits = old.value-bits(offset)
        . old-none = old.value-none(offset)
        store.motion-changes += StyleValueChange
            - info
            - offset
            - old-bits
            - old-none
            - target.value-bits(offset)
            - target.value-none(offset)

━━━━━━━━━━━━━━━━━━━━
_ do style-values-match
    - values [I64]
    - none-mask U64
    - segment ComputedSegment

=? if segment.none-mask != none-mask
. offset Size = 0
while offset < values.length
    =? if segment.value-bits(offset) != values[offset]
    offset += 1
= true

━━━━━━━━━━━━━━━━━━━━
_ do style-segments-match
    - a ComputedSegment
    - b ComputedSegment
    - info StyleInfo

=? true if a == b
=? if a.none-mask != b.none-mask
for property in info.properties
    . offset = property.offset
    =? if a.value-bits(offset) != b.value-bits(offset)
= true

━━━━━━━━━━━━━━━━━━━━
_ do style-diff-segments
    - old ComputedSegment
    - target ComputedSegment
    - info StyleInfo

. changed U64
for property in info.properties
    . offset = property.offset
    if old.value-bits(offset) != target.value-bits(offset) || none-differs
        changed = changed /or/ (1u64 /lshift/ offset)
    .. none-differs = old.value-none(offset) != target.value-none(offset)
= changed

━━━━━━━━━━━━━━━━━━━━
_ do style-rebound-slots U64
    - old ComputedSegment
    - target ComputedSegment
    - info StyleInfo
    - changed-mask U64

. rebound U64
=? rebound if changed-mask == 0
for property in info.properties
    . offset = property.offset
    . bit U64 = 1u64 /lshift/ offset
    if (changed-mask /and/ bit) != 0 && old.value-none(offset) == target.value-none(offset)
        if style-slot-rebound(property, old.value-bits(offset), target.value-bits(offset))
            rebound = rebound /or/ bit
= rebound

━━━━━━━━━━━━━━━━━━━━
_ do style-record-changes
    - store RootStyleStore
    - attachment MarkupAttachment
    - info StyleInfo
    - changed-mask U64
    - rebound-mask U64
    - segment ComputedSegment

. raised-mask = changed-mask - rebound-mask
if raised-mask != 0
    style-raise-changed-domains(store, attachment, info, raised-mask)
. inherited-changed = changed-mask /and/ info.inherited-mask

if inherited-changed != 0
    style-propagate-inherited(store, attachment, info, inherited-changed, raised-mask, segment)

━━━━━━━━━━━━━━━━━━━━
_ do style-propagate-inherited
    - store RootStyleStore
    - attachment MarkupAttachment
    - info StyleInfo
    - changed-mask U64
    - raised-mask U64
    - segment ComputedSegment

` Children aliasing the changed segment changed by construction: record their invalidation now and
` keep walking, since their own children alias the same pointer. Everyone else re-derives values
` from authored state on the next settle pass.

. child = style-first-child-attachment(attachment)
while child
    . live = child
    . child-record = style-node-record(live)
    if child-record
        . entry = style-record-segment(child-record, info.style-index)
        if entry == segment
            . child-raised = changed-mask /and/ raised-mask
            if child-raised != 0
                style-raise-changed-domains(store, live, info, child-raised)
            style-recompute-activation(store, live, child-record)
            style-propagate-inherited(store, live, info, changed-mask, raised-mask, segment)
        else
            live.dirty-bits = live.dirty-bits /or/ inherited-dirty-bit
            store.enqueue-dirty(live)
    else
        live.dirty-bits = live.dirty-bits /or/ inherited-dirty-bit
        store.enqueue-dirty(live)
    child = style-next-child-attachment(attachment, live)
