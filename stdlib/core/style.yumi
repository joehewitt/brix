+ do style-set-theme-tag
    - node MarkupElement
    - tag String
    - active Bool?

. held = markup-attachment-for-write(node)
. bit = style-theme-tag(tag)
. turned-on = held.theme-tags-on - (held.theme-tags-on /and/ bit)
. turned-off = held.theme-tags-off - (held.theme-tags-off /and/ bit)
if active == true
    turned-on = turned-on /or/ bit
else if active == false
    turned-off = turned-off /or/ bit
=? if turned-on == held.theme-tags-on && turned-off == held.theme-tags-off
. attachment = style-live-attachment(node as Pointer)
if !attachment
    held.set-theme-tags(turned-on, turned-off)
    =
. live = attachment
. was-on = (style-effective-tags(live) /and/ bit) != 0
live.set-theme-tags(turned-on, turned-off)
=? if was-on == ((style-effective-tags(live) /and/ bit) != 0)
. infos = List'StyleSheetInfo()
for info in style-sheet-infos
    if (info.tags /and/ bit) != 0
        infos += info
. changes = style-tag-changes(live, infos, bit, was-on)
if changes
    style-mark-tag-change(style-attachment-store(live), live, changes, bit, was-on)

