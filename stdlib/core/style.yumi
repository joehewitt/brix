_ do style-tag-changes [StyleSheetChange]?
    - attachment MarkupAttachment
    - infos [StyleSheetInfo]
    - bit U64
    - was-on Bool

` The families whose active member at a node differs with a tag as it was and as it is.

. tags = style-effective-tags(attachment)
. old-tags = if was-on then tags /or/ bit else tags - (tags /and/ bit)
. changes [StyleSheetChange]? = null
for info in infos
    . base = style-effective-base(attachment, info)
    . before = style-sheet-variant(info, base, old-tags)
    . after = style-sheet-variant(info, base, tags)
    if before != after
        if !changes
            changes = List'StyleSheetChange()
        changes += StyleSheetChange(info, before, after)
= changes

━━━━━━━━━━━━━━━━━━━━
_ do style-mark-tag-change
    - store RootStyleStore
    - attachment MarkupAttachment
    - changes [StyleSheetChange]
    - bit U64
    - was-on Bool

` Marks a node and its mounted subtree where they read what a tag changes, as their declarations,
` the families that gate them, and their reads of slots say. A node that decides the tag itself
` ends the walk; one that turns other tags or provides a sheet of a changed family takes its own
` changes.

style-mark-sheet-dependent(store, attachment, changes)
. child = style-first-child-attachment(attachment)
while child
    . live = child
    . own = style-subtree-changes(live, changes, bit, was-on)
    if own
        style-mark-tag-change(store, live, own, bit, was-on)
    child = style-next-child-attachment(attachment, live)

━━━━━━━━━━━━━━━━━━━━
_ do style-subtree-changes [StyleSheetChange]?
    - attachment MarkupAttachment
    - changes [StyleSheetChange]
    - bit U64
    - was-on Bool

. decided = attachment.theme-tags-on /or/ attachment.theme-tags-off
=? null if (decided /and/ bit) != 0
. node-record = style-node-record(attachment)
. provides = false
if node-record && node-record.provided-style-sheets
    for provided in node-record.provided-style-sheets
        for change in changes
            provides = provides || provided.info == change.info
=? changes if decided == 0 && !provides
. infos = List'StyleSheetInfo()
for change in changes
    infos += change.info
= style-tag-changes(attachment, infos, bit, was-on)

━━━━━━━━━━━━━━━━━━━━
_ do style-mark-sheet-dependent
    - store RootStyleStore
    - attachment MarkupAttachment
    - changes [StyleSheetChange]

. node-record = style-node-record(attachment)
=? if !node-record
. record = node-record
if record.read-sheets
    . reads = false
    for read in record.read-sheets
        for change in changes
            reads = reads || (read.info == change.info && change.differs)
    if reads
        style-refresh-sheet-reads(store, attachment)
=? if !style-declares-changes(attachment, record, changes)
attachment.dirty-bits = attachment.dirty-bits /or/ style-dirty-bit
store.enqueue-dirty(attachment)

━━━━━━━━━━━━━━━━━━━━
_ do style-declares-changes Bool
    - attachment MarkupAttachment
    - record NodeStyleRecord
    - changes [StyleSheetChange]

. assoc = style-live-site-association(attachment)
if assoc
    . live-assoc = assoc
    . template-index Size = 0
    while template-index < live-assoc.site-template-count()
        for declaration in live-assoc.site-template-at(template-index).declarations
            =? true if style-declaration-reads-changes(declaration, changes)
        template-index += 1
for declaration in record.authored
    =? true if style-declaration-reads-changes(declaration, changes)
= false

━━━━━━━━━━━━━━━━━━━━
_ do style-declaration-reads-changes Bool
    - declaration AuthoredDeclaration
    - changes [StyleSheetChange]

for change in changes
    =? true if declaration.family == change.info && change.before.member != change.after.member
    if declaration.style-sheet == change.info
        =? true if declaration.kind == StyleValueKind.themed && change.differs
        =? true if declaration.kind != StyleValueKind.themed && slot-changed
        .. slot-changed = change.slots[declaration.sheet-offset]
= false

━━━━━━━━━━━━━━━━━━━━
_ do style-sheet-variant StyleSheetRecord
    - info StyleSheetInfo
    - base StyleSheetRecord
    - tags U64

=? base if base.member == 0 && base != style-sheet-default-record(info)
. best = base
. best-count = 0u32
. best-depth = 0u32
for record in style-sheet-members
    if record.info != info
        continue
    . required = 0u64
    . depth = 0u32
    . eligible = true
    . level = record
    while eligible && level.member != base.member && level.member != 0
        eligible = level.tags != 0
        required = required /or/ level.tags
        depth += 1
