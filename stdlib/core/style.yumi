for entry in entries
    =? entry if entry.style-index == style-index && entry.offset == offset
= null

────────────────────
+ do put
    - style-index Index
    - offset Size
    - bits I64
    - none Bool
    - held StyleObjectHolder?
    - follows Bool

. found = find(style-index, offset)
if found
    found.bits = bits
    found.none = none
    found.held = held
    found.follows = follows
    =
. entry = StylePresentedValue()
entry.style-index = style-index
entry.offset = offset
entry.bits = bits
entry.none = none
entry.held = held
entry.follows = follows
entries += entry

────────────────────
+ do remove Bool
    - style-index Index
    - offset Size

for index in 0 .. < entries.length
    . entry = entries[index]
    if entry.style-index == style-index && entry.offset == offset
        entries.remove(index)
        = true
= false

