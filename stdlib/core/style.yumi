=? if mask == 0

. ancestor = style-parent-attachment(attachment)
while ancestor
    . live = ancestor
    if (live.descendant-domains /and/ mask) == mask
        break
    live.descendant-domains = live.descendant-domains /or/ mask
    ancestor = style-parent-attachment(live)

