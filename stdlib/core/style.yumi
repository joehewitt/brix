+ do style-effective-style-sheet
    - attachment MarkupAttachment
    - info StyleSheetInfo

. selected StyleSheetRecord? = null
. tags = 0u64
. decided = 0u64
. cursor MarkupAttachment? = attachment
while cursor
    . live = cursor
    . node-record = style-node-record(live)
    if node-record
        . held = node-record
        . provided = held.provided-style-sheets
        if !selected && provided
            for record in provided
                if record.info == info
                    selected = record
    tags = tags /or/ (live.theme-tags-on - (live.theme-tags-on /and/ decided))
    decided = decided /or/ live.theme-tags-on /or/ live.theme-tags-off
    if selected && info.tags == 0
        = selected
    cursor = style-parent-attachment(live)

. base = selected ?? style-sheet-default-record(info)
=? base if info.tags == 0
= style-sheet-variant(info, base, tags)

