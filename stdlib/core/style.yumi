. has-domain = (attachment.pending-domains /and/ bit) != 0
=? if !has-domain

attachment.pending-domains -= bit
if domain < store.pending-domain-counts.length && store.pending-domain-counts[domain] > 0
    store.pending-domain-counts[domain] -= 1

