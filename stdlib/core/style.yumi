if root-pointer == object-pointer
    . existing = gc-object-side-payload'RootStyleStore
        - root-pointer
        - style-attachments-lane() as Size
    if existing
        = existing
    . created = RootStyleStore(batch)
    = gc-publish-object-side-payload(root-pointer, style-attachments-lane() as Size, created)

= gc-object-side-payload'RootStyleStore(root-pointer, style-attachments-lane() as Size)

