    if offset >= values.length

. old-bits = values[offset]
. old-none = value-none(offset)
=? if bits == old-bits && is-none == old-none

values[offset] = bits
nones[offset] = is-none

version += 1
slot-versions[offset] += 1
themed.clear()

for owner-address in providers
    . provider = style-live-attachment(owner-address as Pointer)
    if provider
        . live = provider
        style-mark-style-sheet-provider(style-attachment-store(live), live)

