────────────────────
_ do release-record-segments
    - record StyleRecord

for position in 0 .. < record.segments.length
    if style-segment-key-owned(record.segment-keys[position])
        release-segment(record.segments[position])

record.segments.clear()
record.segment-keys.clear()
record.segment-mask = 0
style-clear-declaration-list(record.authored)
record.active-styles.clear()
record.disabled-blocks = 0
record.dirty-bits = 0
record.presented = null

────────────────────
_ do reusable-segment

if free-segments
    = segment-pool[free-segments.pop()]

────────────────────
_ do fresh-segment

. segment = ComputedSegment()
segment.segment-id = segment-pool.length
segment-pool += segment
= segment

────────────────────
_ do style-clear-declaration-list
    - declarations [AuthoredDeclaration]

` List.clear preserves capacity and its backing GC buffer. Scrub traced declaration slots first so
` pooled records and settle scratch do not retain holder-backed values beyond their logical length.

. index Index = 0
while index < declarations.length
    declarations[index] = style-no-winner
    index += 1
declarations.clear()

