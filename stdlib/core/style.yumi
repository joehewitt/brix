=? if !lane
=? if !lane.remove(info.style-index, offset)
if !lane.entries
    record.presented = null
. store = style-attachment-store(live)
style-raise-changed-domains(store, live, info, 1u64 /lshift/ offset)
if (info.inherited-mask /and/ (1u64 /lshift/ offset)) != 0
    style-unpresent-followers(store, live, info, offset)

