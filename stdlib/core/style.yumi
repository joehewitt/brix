━━━━━━━━━━━━━━━━━━━━
_ do style-effective-tags U64
    - attachment MarkupAttachment

. tags = 0u64
. decided = 0u64
. cursor MarkupAttachment? = attachment
while cursor
    . live = cursor
    tags = tags /or/ (live.theme-tags-on - (live.theme-tags-on /and/ decided))
    decided = decided /or/ live.theme-tags-on /or/ live.theme-tags-off
    cursor = style-parent-attachment(live)
= tags

