        . entry = store.style-sheet-dirty-roots[provider-index]
        . attachment = style-live-attachment(entry.owner-address as Pointer)
        if attachment
            . live = attachment
            . same-store = live.style-store-address == (store as Pointer).address
            if same-store && live.generation == entry.generation
