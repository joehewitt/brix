(type + (of Node Content)
  (prop + object Content)
  (prop + first (? (of Node Content)))
  (prop + last (? (of Node Content)))
  (prop + next (? (of Node Content)))
  (prop + previous (? (of Node Content)))
  (prop + parent (? (of Node Content)))
  (prop + index Index)
  (prop + count Index)
  (fn-do + This _
    (param object _)
    (param parent _)
    (param index _ (= 0))
  )
  (fn-do + (infix this += (param child ''T)) _
    (let child-node (call (of Node T) child this (+ count 1)))
    (+= count 1)
    (if (not first)
      (= first (= last child-node))
      (else
        (= (. child-node previous) last)
        (= (?. last next) child-node)
        (= last child-node)
      )
    )
  )
  (fn-do + replace _
    (param object-replacement ''T)
    (let replacement (call (of Node T) object-replacement parent index))
    (= (. replacement parent) parent)
    (= (. replacement previous) previous)
    (= (. replacement next) next)
    (= (?. next previous) replacement)
    (= (?. previous next) replacement)
    (= parent null)
    (= next null)
    (= previous null)
    (blank)
    (return (call (. object replace) object-replacement))
    ; parent?.object.replace at index with object-replacement
  )
  (fn-do + merge _
    (let child first)
    (while child
      (call (?. child merge))
      (+= object (?. child object))
      (= child (?. child next))
    )
  )
)
