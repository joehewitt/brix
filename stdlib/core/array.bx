(import ./backing)
(import ./core)
(import ./error)
(import ./list)
(import ./number)
(import ./range)
(import ./stream)
(import ./string)
(import /BxCore/BxCore.h)
(import /BxCore/BxString.h)
(import /string.h)
(blank)
(type-line + (of Decodable Result) (is Interface))

(type + (of Array Value Backing) (is (of ReadableArray Value Backing))
  (constraint = Backing GCBacking)
  (constraint is Backing StorageBacking)
  (fn-do + This _
    (constraint = Backing GCBacking)
    (= storage (call (of (. Backing allocate) Value) (call Void) 0))
    (= storage-size 0)
  )
  (fn-do + This _
    (param text (exact String))
    (constraint = Backing GCBacking)
    (if (== Value Char)
      (return (as (. text codepoints) This))
      (else-if (== Value Byte)
        (let bytes (call (of Array Value) (. text size)))
        (call C:brixArrayCopySlice (. bytes data) (as text (of CPointer Value)) (. text size))
        (return (as bytes This))
      )
      (else
        (throw (call Panic "Array does not contain bytes or characters"))
      )
    )
  )
  (fn-do + This _
    (param items (exact (list Value)))
    (constraint = Backing GCBacking)
    (let self (call This (. items length)))
    (for (in i (..< 0 (. items length)))
      (= ([] (. self data) i) ([] items i))
    )
    (return self)
  )
  (fn-do + This _
    (param source (of ImmutableArray Value))
    (constraint = Backing GCBacking)
    (let self (call This (. source length)))
    (for (in i (..< 0 (. source length)))
      (= ([] (. self data) i) ([] source i))
    )
    (return self)
  )
  (fn-do + This _
    (param context (. Backing Context))
    (param items (exact (list Value)))
    (let self (call This context (. items length)))
    (for (in i (..< 0 (. items length)))
      (= ([] (. self data) i) ([] items i))
    )
    (return self)
  )
  (fn-do + (of This Provider) _
    (param provider Provider)
    (param items (exact (list Value)))
    (constraint is Provider ArrayStorageProvider)
    (constraint = Backing (. Provider (of Backing Value)))
    (let context (as provider (. Backing Context)))
    (= storage (call (of (. Backing allocate) Value) context (. items length)))
    (= storage-size (. items length))
    (for (in i (..< 0 (. items length)))
      (= ([] data i) ([] items i))
    )
  )
  (fn-do + This _
    (param data (of CPointer Value))
    (param size Size)
    (= storage (as data (. Backing (of Storage Value))))
    (= storage-size size)
  )
  (fn-do + This _
    (param size Size)
    (constraint = Backing GCBacking)
    (throw (call Panic "Array size overflow") (if (and (!= size 0) (> size (/ (. Size max) (. Value size))))))
    (blank)
    (= storage (call (of (. Backing allocate) Value) (call Void) size))
    (= storage-size size)
  )
  (fn-do + This _
    (param context (. Backing Context))
    (param size Size)
    (throw (call Panic "Array size overflow") (if (and (!= size 0) (> size (/ (. Size max) (. Value size))))))
    (blank)
    (= storage (call (of (. Backing allocate) Value) context size))
    (= storage-size size)
  )
  (fn-do + (of This Provider) _
    (param provider Provider)
    (param size Size)
    (constraint is Provider ArrayStorageProvider)
    (constraint = Backing (. Provider (of Backing Value)))
    (throw (call Panic "Array size overflow") (if (and (!= size 0) (> size (/ (. Size max) (. Value size))))))
    (blank)
    (let context (as provider (. Backing Context)))
    (= storage (call (of (. Backing allocate) Value) context size))
    (= storage-size size)
  )
  (fn-do + This _
    (param size Size)
    (constraint = Backing GCBacking)
    (param with (fn-type Value (param index Index)))
    (let self (call This size))
    (blank)
    (for (in i (..< 0 size))
      (= ([] (. self data) i) (call with i))
    )
    (blank)
    (return self)
  )
  (fn-do + This _
    (param context (. Backing Context))
    (param size Size)
    (param with (fn-type Value (param index Index)))
    (let self (call This context size))
    (blank)
    (for (in i (..< 0 size))
      (= ([] (. self data) i) (call with i))
    )
    (blank)
    (return self)
  )
  (fn-do + (of This Provider) _
    (param provider Provider)
    (param size Size)
    (constraint is Provider ArrayStorageProvider)
    (constraint = Backing (. Provider (of Backing Value)))
    (param with (fn-type Value (param index Index)))
    (throw (call Panic "Array size overflow") (if (and (!= size 0) (> size (/ (. Size max) (. Value size))))))
    (blank)
    (let context (as provider (. Backing Context)))
    (= storage (call (of (. Backing allocate) Value) context size))
    (= storage-size size)
    (for (in i (..< 0 size))
      (= ([] data i) (call with i))
    )
  )
  (fn-to-expr + (of CPointer Value)
    data
  )
  (fn-to-expr + (of CPointer ''T)
    (as data (of CPointer T))
  )
  (fn-to-expr + String
    (str (. Value name) "[" size "]")
  )
  (fn-to-expr + (of Array Byte Backing)
    (call (of Array Byte Backing) (as (. this data) (of CPointer Byte)) (. this byte-size))
  )
  (fn-to-expr + (of ImmutableArray Value Backing) @inline
    (call (of ImmutableArray Value Backing) data size)
  )
  (fn-expr + immutable (of ImmutableArray Value Backing) :get @inline
    (call (of ImmutableArray Value Backing) data size)
  )
  (fn-expr + data (of CPointer Value) :get @inline
    (as storage (of CPointer Value))
  )
  (fn-do + (infix this == (param other (list Value))) _
    (return-if (if (!= length (. other length))))
    (blank)
    (for (in i (..< 0 length))
      (return-if (if (!= ([] data i) ([] other i))))
    )
    (return true)
  )
  (fn-do + (infix this <- (param items (stream Value))) _
    (let index 0)
    (for (in item items)
      (= ([] this index) item)
      (+= index 1)
    )
  )
  (fn-expr + (infix this - (param item Value)) _
    (case? found
      (call replace (..< found (+ found 1)) (call This data 0))
    )
    (default
      this
    )
    (where
      (lazy found (call find item))
    )
  )
  (fn-do + (index-set this (param pos Position) (param item Value)) _
    (= ([] this (call (. pos normalize) this)) item)
  )
  (fn-do + (index-set this (param index Index) (param item Value)) _ @inline
    (throw (call OutOfBoundsError (str "Set out of bounds (" index " / " size ")")) (if (>= (as index UInt) (as size UInt))))
    (blank)
    (call (of (. Backing store) Value) storage item index)
  )
  (fn-do + (index-set this (param range (of Range Index)) (param item Value)) _
    (throw (call OutOfBoundsError (str "Set out of bounds (" out-index " / " size ")")) (if (or (> (as first UInt) (as size UInt)) (and (!= count 0) (>= (as last UInt) (as size UInt))))))
    (blank)
    (for (in index normal)
      (call (of (. Backing store) Value) storage item index)
    )
    (blank)
    (lazy normal (call (. range forward)))
    (lazy first (. normal start))
    (lazy count (. normal length))
    (lazy last (+ first (* (- count 1) (. normal increment))))
    (lazy out-index (if-expr (== count 0) first last))
  )
  (fn-do + (index-set this (param range (of Range Position)) (param other _)) _
    (= ([] this normal) other)
    (blank)
    (lazy normal (call (. range normalize) this))
  )
  (fn-do + (index-set this (param range (of Range Index)) (param other This)) _
    (throw (call Panic "Only increments of 1 are currently supported") (if (!= (. normal increment) 1)))
    (throw (call OutOfBoundsError (str "Range out of bounds (" out-index " / " size ")")) (if (or (> (as start UInt) (as size UInt)) (> end size) (< end start))))
    (throw (call Panic "Array size overflow") (if (and (!= len 0) (> len (/ (. Size max) item-size)))))
    (throw (call OutOfBoundsError (str "Source array too short (" (. other size) " / " len ")")) (if (< (. other size) len)))
    (blank)
    (call C:brixArrayCopySlice (+ data start) (. other data) (* len item-size))
    (blank)
    (lazy normal (call (. range forward)))
    (lazy start (. normal start))
    (lazy end (. normal end))
    (lazy out-index (if-expr (> end 0) (- end 1) end))
    (lazy len (- end start))
    (lazy item-size (. Value size))
  )
  (fn-do + (index-set this (param range (of Range Index)) (param other (of ImmutableArray Value ''OtherBacking))) _
    (constraint is OtherBacking StorageBacking)
    (throw (call Panic "Only increments of 1 are currently supported") (if (!= (. normal increment) 1)))
    (throw (call OutOfBoundsError (str "Range out of bounds (" out-index " / " size ")")) (if (or (> (as start UInt) (as size UInt)) (> end size) (< end start))))
    (throw (call Panic "Array size overflow") (if (and (!= len 0) (> len (/ (. Size max) item-size)))))
    (throw (call OutOfBoundsError (str "Source array too short (" (. other size) " / " len ")")) (if (< (. other size) len)))
    (blank)
    (call C:brixArrayCopySlice (+ data start) (as (. other storage) (of CPointer Value)) (* len item-size))
    (blank)
    (lazy normal (call (. range forward)))
    (lazy start (. normal start))
    (lazy end (. normal end))
    (lazy out-index (if-expr (> end 0) (- end 1) end))
    (lazy len (- end start))
    (lazy item-size (. Value size))
  )
  (fn-do + (index-set this (param range (of Range Index)) (param other (list Value))) _
    (throw (call Panic "Only increments of 1 are currently supported") (if (!= (. normal increment) 1)))
    (throw (call OutOfBoundsError (str "Range out of bounds (" out-index " / " size ")")) (if (or (> (as start UInt) (as size UInt)) (> end size) (< end start))))
    (throw (call OutOfBoundsError (str "Source array too short (" (. other length) " / " len ")")) (if (< (. other length) len)))
    (blank)
    (for (in i (..< 0 len))
      (= ([] data (+ start i)) ([] other i))
    )
    (blank)
    (lazy normal (call (. range forward)))
    (lazy start (. normal start))
    (lazy end (. normal end))
    (lazy out-index (if-expr (> end 0) (- end 1) end))
    (lazy len (- end start))
  )
  (fn-do + (index-set this (param range (of Range Index)) (param other String)) _
    (throw (call Panic "Only increments of 1 are currently supported") (if (!= (. normal increment) 1)))
    (throw (call OutOfBoundsError (str "Range out of bounds (" out-index " / " size ")")) (if (or (> (as start UInt) (as size UInt)) (> end size) (< end start))))
    (blank)
    (if (== Value Char)
      (let codepoints (. other codepoints))
      (throw (call OutOfBoundsError (str "String range length mismatch (" (. codepoints size) " / " len ")")) (if (!= (. codepoints size) len)))
      (blank)
      (= ([] this normal) codepoints)
      (else-if (== Value Byte)
        (let bytes (call byte-view other))
        (throw (call OutOfBoundsError (str "String range length mismatch (" (. bytes size) " / " len ")")) (if (!= (. bytes size) len)))
        (blank)
        (= ([] this normal) bytes)
      )
      (else
        (throw (call Panic "Array does not contain characters"))
      )
    )
    (blank)
    (lazy normal (call (. range forward)))
    (lazy start (. normal start))
    (lazy end (. normal end))
    (lazy out-index (if-expr (> end 0) (- end 1) end))
    (lazy len (- end start))
  )
  (fn-do + (index-set this (param range (of Range Position)) (param item Value)) _
    (= ([] this normal) item)
    (blank)
    (lazy normal (call (. range normalize) this))
  )
  (fn-expr + (index-delete this (param pos Position)) _
    (-= ([] this (call (. pos normalize) this)))
  )
  (fn-expr + (index-delete this (param index Index)) _
    (before
      (throw (call OutOfBoundsError (str "Delete out of bounds (" index " / " size ")")) (if (>= (as index UInt) (as size UInt))))
    )
    (call replace (..< index (+ index 1)) (call This data 0))
  )
  (fn-expr + (index-delete this (param range (of Range Position))) _
    (-= ([] this (call (. range normalize) this)))
  )
  (fn-expr + (index-delete this (param range (of Range Index))) _
    (call replace range (call This data 0))
  )
  (fn-do + zero _
    (param index Index)
    (throw (call OutOfBoundsError (str "Set out of bounds (" index " / " size ")")) (if (>= (as index UInt) (as size UInt))))
    (blank)
    (call C:memset (+ data index) 0 (. Value size))
  )
  (fn-do + map _
    (param using (fn-type Value (param byte Value) (param index Index)))
    (let copy (call This size))
    (blank)
    (for (in i (..< 0 size))
      (= ([] (. copy data) i) (call using ([] data i) i))
    )
    (blank)
    (return copy)
  )
  (fn-do + map _
    (param context (. Backing Context))
    (param using (fn-type Value (param byte Value) (param index Index)))
    (let copy (call This context size))
    (blank)
    (for (in i (..< 0 size))
      (= ([] (. copy data) i) (call using ([] data i) i))
    )
    (blank)
    (return copy)
  )
  (fn-do + fill _
    (param item Value)
    (for (in index (..< 0 size))
      (= ([] data index) item)
    )
    (return this)
  )
  (fn-do + find _
    (param item Value)
    (for (in i (..< 0 size))
      (if (== ([] data i) item)
        (return i)
      )
    )
  )
  (fn-do + find _
    (param pattern This)
    (if (not pattern)
      (return 0)
    )
    (return-if (if (> (. pattern size) size)))
    (blank)
    (for (in start (..< 0 (+ (- size (. pattern size)) 1)))
      (let matched true)
      (for (in offset (..< 0 (. pattern size)))
        (if (!= ([] data (+ start offset)) ([] (. pattern data) offset))
          (= matched false)
          (break)
        )
      )
      (if matched
        (return start)
      )
    )
  )
  (fn-do + find _
    (param pattern (list Value))
    (if (== (. pattern length) 0)
      (return 0)
    )
    (return-if (if (> (. pattern length) size)))
    (blank)
    (for (in start (..< 0 (+ (- size (. pattern length)) 1)))
      (let matched true)
      (for (in offset (..< 0 (. pattern length)))
        (if (!= ([] data (+ start offset)) ([] pattern offset))
          (= matched false)
          (break)
        )
      )
      (if matched
        (return start)
      )
    )
  )
  (fn-do + starts-with _
    (param pattern This)
    (return-if (if (> (. pattern size) size)))
    (blank)
    (for (in i (..< 0 (. pattern size)))
      (return-if (if (!= ([] data i) ([] (. pattern data) i))))
    )
    (return true)
  )
  (fn-do + starts-with _
    (param pattern (list Value))
    (return-if (if (> (. pattern length) size)))
    (blank)
    (for (in i (..< 0 (. pattern length)))
      (return-if (if (!= ([] data i) ([] pattern i))))
    )
    (return true)
  )
  (fn-do + ends-with _
    (param pattern This)
    (return-if (if (> (. pattern size) size)))
    (blank)
    (for (in i (..< 0 (. pattern size)))
      (return-if (if (!= ([] data (+ offset i)) ([] (. pattern data) i))))
    )
    (return true)
    (blank)
    (lazy offset (- size (. pattern size)))
  )
  (fn-do + ends-with _
    (param pattern (list Value))
    (return-if (if (> (. pattern length) size)))
    (blank)
    (for (in i (..< 0 (. pattern length)))
      (return-if (if (!= ([] data (+ offset i)) ([] pattern i))))
    )
    (return true)
    (blank)
    (lazy offset (- size (. pattern length)))
  )
  (fn-expr + replace _
    (param range (of Range Position))
    (param item Value)
    (call replace normal (call Void) item)
    (where
      (lazy normal (call (. range normalize) this))
    )
  )
  (fn-expr + replace _
    (param range (of Range Position))
    (param context (. Backing Context))
    (param item Value)
    (call replace normal context item)
    (where
      (lazy normal (call (. range normalize) this))
    )
  )
  (fn-expr + replace _
    (param range (of Range Index))
    (param item Value)
    (call replace range (call Void) item)
  )
  (fn-do + replace _
    (param range (of Range Index))
    (param context (. Backing Context))
    (param item Value)
    (throw (call Panic "Only increments of 1 are currently supported") (if (!= (. normal increment) 1)))
    (throw (call OutOfBoundsError (str "Range out of bounds (" out-index " / " size ")")) (if (or (> (as start UInt) (as size UInt)) (> end size) (< end start))))
    (throw (call Panic "Array size overflow") (if (and (== len 0) (== size (. Size max)))))
    (blank)
    (let result (call This context new-size))
    (do
      (inline (call C:brixArrayCopySlice (. result data) data (* start item-size)))
    )
    (= ([] (. result data) start) item)
    (do
      (inline (call C:brixArrayCopySlice (+ (. result data) start 1) (+ data end) (* (- size end) item-size)))
    )
    (return result)
    (blank)
    (lazy normal (call (. range forward)))
    (lazy start (. normal start))
    (lazy end (. normal end))
    (lazy out-index (if-expr (> end 0) (- end 1) end))
    (lazy len (- end start))
    (lazy new-size (+ (- size len) 1))
    (lazy item-size (. Value size))
  )
  (fn-expr + replace _
    (param range (of Range Position))
    (param other This)
    (call replace normal (call Void) other)
    (where
      (lazy normal (call (. range normalize) this))
    )
  )
  (fn-expr + replace _
    (param range (of Range Position))
    (param context (. Backing Context))
    (param other This)
    (call replace normal context other)
    (where
      (lazy normal (call (. range normalize) this))
    )
  )
  (fn-expr + replace _
    (param range (of Range Index))
    (param other This)
    (call replace range (call Void) other)
  )
  (fn-do + replace _
    (param range (of Range Index))
    (param context (. Backing Context))
    (param other This)
    (throw (call Panic "Only increments of 1 are currently supported") (if (!= (. normal increment) 1)))
    (throw (call OutOfBoundsError (str "Range out of bounds (" out-index " / " size ")")) (if (or (> (as start UInt) (as size UInt)) (> end size) (< end start))))
    (throw (call Panic "Array size overflow") (if (and (> (. other size) len) (> (- (. other size) len) (- (. Size max) size)))))
    (blank)
    (let result (call This context new-size))
    (do
      (inline (call C:brixArrayCopySlice (. result data) data (* start item-size)))
    )
    (do
      (inline (call C:brixArrayCopySlice (+ (. result data) start) (. other data) (* (. other size) item-size)))
    )
    (do
      (inline (call C:brixArrayCopySlice (+ (. result data) start (. other size)) (+ data end) (* (- size end) item-size)))
    )
    (return result)
    (blank)
    (lazy normal (call (. range forward)))
    (lazy start (. normal start))
    (lazy end (. normal end))
    (lazy out-index (if-expr (> end 0) (- end 1) end))
    (lazy len (- end start))
    (lazy new-size (+ (- size len) (. other size)))
    (lazy item-size (. Value size))
  )
  (fn-expr + replace _
    (param range (of Range Index))
    (param other (list Value))
    (call replace range (call Void) other)
  )
  (fn-do + replace _
    (param range (of Range Index))
    (param context (. Backing Context))
    (param other (list Value))
    (throw (call Panic "Only increments of 1 are currently supported") (if (!= (. normal increment) 1)))
    (throw (call OutOfBoundsError (str "Range out of bounds (" out-index " / " size ")")) (if (or (> (as start UInt) (as size UInt)) (> end size) (< end start))))
    (throw (call Panic "Array size overflow") (if (and (> other-size len) (> (- other-size len) (- (. Size max) size)))))
    (blank)
    (let result (call This context new-size))
    (do
      (inline (call C:brixArrayCopySlice (. result data) data (* start item-size)))
    )
    (for (in i (..< 0 other-size))
      (= ([] (. result data) (+ start i)) ([] other i))
    )
    (do
      (inline (call C:brixArrayCopySlice (+ (. result data) start other-size) (+ data end) (* (- size end) item-size)))
    )
    (return result)
    (blank)
    (lazy normal (call (. range forward)))
    (lazy start (. normal start))
    (lazy end (. normal end))
    (lazy out-index (if-expr (> end 0) (- end 1) end))
    (lazy len (- end start))
    (lazy other-size (. other length))
    (lazy new-size (+ (- size len) other-size))
    (lazy item-size (. Value size))
  )
  (fn-expr + replace _
    (param range (of Range Position))
    (param other (list Value))
    (call replace normal (call Void) other)
    (where
      (lazy normal (call (. range normalize) this))
    )
  )
  (fn-expr + replace _
    (param range (of Range Position))
    (param context (. Backing Context))
    (param other (list Value))
    (call replace normal context other)
    (where
      (lazy normal (call (. range normalize) this))
    )
  )
  (fn-do + grow This
    (param amount Size)
    (param context (. Backing Context) (= (call Void)))
    (throw (call Panic "Array size overflow") (if (> amount (- (. Size max) size))))
    (blank)
    (return (call resize (+ size amount) context))
  )
  (fn-do + resize This
    (param new-size Size)
    (param context (. Backing Context) (= (call Void)))
    (throw (call Panic "Array size overflow") (if (and (!= size 0) (> size (/ (. Size max) (. Value size))))))
    (throw (call Panic "Array size overflow") (if (and (!= new-size 0) (> new-size (/ (. Size max) (. Value size))))))
    (blank)
    (let replacement (call This context new-size))
    (let kept (if-expr (< new-size size) new-size size))
    (call C:brixArrayCopySlice (. replacement data) data (* kept (. Value size)))
    (call C:brixArrayViewsInvalidate data byte-size)
    (return replacement)
  )
  (fn-do + copy _
    (param context (. Backing Context) (= (call Void)))
    (let clone (call This context size))
    (call C:brixArrayCopySlice (. clone data) data byte-size)
    (return clone)
  )
)

(type + (of ImmutableArray Item Backing) (is (of ReadableArray Item Backing))
  (constraint = Backing GCBacking)
  (constraint is Backing StorageBacking)
  (fn-do + This _
    (constraint = Backing GCBacking)
    (= storage (call (of (. Backing allocate) Item) (call Void) 0))
    (= storage-size 0)
  )
  (fn-do _ This _ @inline
    (param data (of CPointer Item))
    (param size Size)
    (= storage (as data (. Backing (of Storage Item))))
    (= storage-size size)
  )
  (fn-to-expr + (of CPointer Item)
    (as storage (of CPointer Item))
  )
  (fn-to-expr + (of CPointer ''T)
    (as storage (of CPointer T))
  )
)

(type + ByteReadable (is Interface)
  (fn-expr + is-encoded _ :get
    true
  )
  (fn-expr + read Size (?! Error)
    (param size Size)
    (param buffer ([] Byte))
  )
)

(type + ByteWritable (is Interface)
  (fn-expr + write Size (?! Error)
    (param buffer (of ImmutableArray Byte))
    (param size Size)
  )
)

(type + ArrayReadAccess)

(type + ArrayWriteAccess)

(type + (of ArrayRowRange Item Access) (is Tuple)
  (constraint = Access ArrayReadAccess)
  (implements (of Indexable (of ArrayRow Item Access)))
  (prop _ bytes (of CPointer Byte))
  (prop _ byte-stride Size)
  (prop _ storage-size Size)
  (prop _ owner (of CPointer Byte))
  (fn-to-do + (of Iterable (of ArrayRow Item Access))
    (for (in index (..< 0 size))
      (yield ([] this index))
    )
  )
  (fn-expr + size Size :get
    (before
      (throw (call Panic "Stale array view") (if (not (call C:brixArrayViewValid owner))))
    )
    storage-size
  )
  (fn-expr + length Size :get
    size
  )
  (fn-expr + (index-get this (param index Index)) (tuple (of ArrayRow Item Access))
    ([] this index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) (of ArrayRowRange Item Access)
    ([] this range)
  )
  (fn-expr + (index-get this (param range (of Range Position))) (of ArrayRowRange Item Access)
    ([] this (call (. range normalize) this))
  )
  (fn-do + (index-set this (param index Index) (param value Item)) _
    (constraint = Access ArrayWriteAccess)
    (= ([] this index) value)
  )
  (fn-do + to-array _
    (let result (call (of Array Item) size))
    (for (in index (..< 0 size))
      (= ([] result index) (as ([] this index) Item))
    )
    (return result)
  )
  (fn-expr + to-immutable-array _
    (. (call to-array) immutable)
  )
)

(type + (of ArrayField Item Access) (is Tuple)
  (constraint = Access ArrayReadAccess)
  (implements (of Indexable Item))
  (prop _ bytes (of CPointer Byte))
  (prop _ byte-stride Size)
  (prop _ storage-size Size)
  (prop _ owner (of CPointer Byte))
  (fn-to-do + (of Iterable Item)
    (for (in index (..< 0 size))
      (yield ([] this index))
    )
  )
  (fn-expr + size Size :get
    (before
      (throw (call Panic "Stale array view") (if (not (call C:brixArrayViewValid owner))))
    )
    storage-size
  )
  (fn-expr + length Size :get
    size
  )
  (fn-expr + (index-get this (param index Index)) Item
    ([] this index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) This
    ([] this range)
  )
  (fn-expr + (index-get this (param range (of Range Position))) This
    ([] this (call (. range normalize) this))
  )
  (fn-do + (index-set this (param index Index) (param value Item)) _
    (constraint = Access ArrayWriteAccess)
    (= ([] this index) value)
  )
  (fn-do + to-array _
    (let result (call (of Array Item) size))
    (for (in index (..< 0 size))
      (= ([] result index) (as ([] this index) Item))
    )
    (return result)
  )
  (fn-expr + to-immutable-array _
    (. (call to-array) immutable)
  )
)

(type + (of ArrayRows Item Access) (is (of ArrayRowRange Item Access))
  (constraint = Access ArrayReadAccess)
)

(type + (of ArrayFields Item Access) (is Tuple)
  (constraint = Access ArrayReadAccess)
  (prop _ bytes (of CPointer Byte))
  (prop _ byte-stride Size)
  (prop _ storage-size Size)
  (prop _ owner (of CPointer Byte))
)

(type + (of ArrayRow Item Access) (is Tuple)
  (constraint = Access ArrayReadAccess)
  (prop _ bytes (of CPointer Byte))
  (prop _ byte-stride Size)
  (prop _ storage-size Size)
  (prop _ owner (of CPointer Byte))
)

(extend + (of Array Byte)
  (fn-to-do + Hex
    (throw (call Panic "Array size overflow") (if (> (. this size) (/ (. Size max) 2))))
    (blank)
    (let output ([] Byte (* (. this size) 2)))
    (for (in i (..< 0 (. this size)))
      (let byte ([] (. this data) i))
      (= ([] (. output data) (* i 2)) (call byte-array-hex-char (/rshift/ byte 4)))
      (= ([] (. output data) (+ (* i 2) 1)) (call byte-array-hex-char (/and/ byte 0x0f)))
    )
    (return (call (. output slice-string)))
  )
  (fn-to-do + Base64
    (throw (call Panic "Array size overflow") (if (> (. this size) (/ (- (. Size max) 2) 3))))
    (blank)
    (let output ([] Byte (* (/ (+ (. this size) 2) 3) 4)))
    (let read-index 0)
    (let write-index 0)
    (while (< read-index (. this size))
      (let b0 (as ([] (. this data) read-index) U32))
      (let b1 (if-expr (< (+ read-index 1) (. this size)) (as ([] (. this data) (+ read-index 1)) U32) 0))
      (let b2 (if-expr (< (+ read-index 2) (. this size)) (as ([] (. this data) (+ read-index 2)) U32) 0))
      (let b01 (/or/ (/lshift/ (/and/ b0 0x03) 4) (/and/ (/rshift/ b1 4) 0x0f)))
      (blank)
      (= ([] (. output data) write-index) (call byte-array-base64-char (/and/ (/rshift/ b0 2) 0x3f)))
      (= ([] (. output data) (+ write-index 1)) (call byte-array-base64-char b01))
      (= ([] (. output data) (+ write-index 2))
        (block
          (case? (< (+ read-index 1) (. this size))
            (call byte-array-base64-char (/or/ (/lshift/ (/and/ b1 0x0f) 2) (/and/ (/rshift/ b2 6) 0x03)))
          )
          (default
            61
          )
        )
      )
      (= ([] (. output data) (+ write-index 3))
        (block
          (case? (< (+ read-index 2) (. this size))
            (call byte-array-base64-char (/and/ b2 0x3f))
          )
          (default
            61
          )
        )
      )
      (blank)
      (+= read-index 3)
      (+= write-index 4)
    )
    (blank)
    (return (call (. output slice-string)))
  )
  (fn-do + (of read Num) (? Num)
    (param offset Index)
    (param endian _ (= .big))
    (constraint is Num Number)
    (return-if (if (> (as offset UInt) (as (. this size) UInt))))
    (return-if (if (> (. Num size) (- (. this size) offset))))
    (blank)
    (let source (as (+ (. this data) offset) (of CPointer Num)))
    (return-if ([] source 0) (if (or (== (. Num size) 1) (== endian (call host-endian)))))
    (blank)
    (let cell ([] Num 1))
    (let bytes (as cell ([] Byte)))
    (for (in i (..< 0 (. Num size)))
      (= ([] bytes i) ([] (. this data) (- (+ offset (- (. Num size) 1)) i)))
    )
    (return ([] cell 0))
  )
  (fn-do + (of write Num) _
    (param value Num)
    (param offset Index)
    (param endian _ (= .big))
    (constraint is Num Number)
    (throw (call OutOfBoundsError (str "Write out of bounds (" offset " / " (. this size) ")")) (if (or (> (as offset UInt) (as (. this size) UInt)) (> (. Num size) (- (. this size) offset)))))
    (blank)
    (let target (as (+ (. this data) offset) (of CPointer Num)))
    (= ([] target 0) value)
    (if (and (> (. Num size) 1) (!= endian (call host-endian)))
      (let bytes (+ (. this data) offset))
      (for (in i (..< 0 (/ (. Num size) 2)))
        (let swapped ([] bytes i))
        (= ([] bytes i) ([] bytes (- (. Num size) 1 i)))
        (= ([] bytes (- (. Num size) 1 i)) swapped)
      )
    )
    (return value)
  )
)

(type _ (of ReadableArray Item Backing) (is Tuple)
  (constraint = Backing GCBacking)
  (constraint is Backing StorageBacking)
  (implements (of Indexable Item))
  (implements Inspectable)
  (prop _ storage (. Backing (of Storage Item)))
  (prop _ storage-size Size)
  (fn-do _ This _
    (constraint = Backing GCBacking)
    (= storage (call (of (. Backing allocate) Item) (call Void) 0))
    (= storage-size 0)
  )
  (fn-do _ This _
    (param data (of CPointer Item))
    (param size Size)
    (= storage (as data (. Backing (of Storage Item))))
    (= storage-size size)
  )
  (fn-to-expr + String
    (call (. ", " join) (as this (stream Item)))
  )
  (fn-to-do + (list ''T)
    (constraint =~ T (as Item T))
    (let list (call (of List T)))
    (call (. list reserve) size)
    (for (in index (..< 0 size))
      (+= list (as (call (of (. Backing load) Item) storage index) T))
    )
    (return list)
  )
  (fn-to-do + (of Iterable Item)
    (for (in index (..< 0 size))
      (yield (call (of (. Backing load) Item) storage index))
    )
  )
  (fn-expr + size Size :get @inline
    storage-size
  )
  (fn-expr + length Size :get
    size
  )
  (fn-expr + byte-size _ :get
    (before
      (throw (call Panic "ImmutableArray size overflow") (if (and (!= size 0) (> size (/ (. Size max) item-size)))))
    )
    (* size item-size)
    (where
      (lazy item-size (. Item size))
    )
  )
  (fn-expr + item-size _ :get
    (. Item size)
  )
  (fn-do + (infix this == (param other (of ReadableArray Item ''OtherBacking))) _
    (constraint is OtherBacking StorageBacking)
    (return-if (if (!= length (. other length))))
    (blank)
    (for (in index (..< 0 length))
      (return-if (if (!= ([] this index) ([] other index))))
    )
    (return true)
  )
  (fn-do + (infix this has (param item Item)) _
    (for (in index (..< 0 size))
      (let candidate (call (of (. Backing load) Item) storage index))
      (return-if true (if (== candidate item)))
    )
    (return false)
  )
  (fn-expr + (infix this + (param other-size Size)) _
    (before
      (throw (call OutOfBoundsError (str "Out of bounds " other-size " / " size)) (if (> (as other-size UInt) (as size UInt))))
    )
    ([] this (..< other-size size))
  )
  (fn-expr + (index-get this (param index Index)) _ @inline
    (case? (< (as index UInt) (as size UInt))
      (call (of (. Backing load) Item) storage index)
    )
    (default
      (call absent index)
    )
  )
  (fn-expr + (index-get this (param position Position)) _
    ([] this (call (. position normalize) this))
  )
  (fn-expr + (index-get this (param range (of Range Position))) _
    ([] this (call (. range normalize) this))
  )
  (fn-expr + (index-get this (param range (of Range Index))) _
    (before
      (throw (call Panic "Only increments of 1 are currently supported") (if (!= (. normal increment) 1)))
      (throw (call OutOfBoundsError (str "Range out of bounds (" out-index " / " size ")")) (if (or (> (as start UInt) (as size UInt)) (> end size) (< end start))))
    )
    (call This (+ (as storage (of CPointer Item)) start) (- end start))
    (where
      (lazy normal (call (. range forward)))
      (lazy start (. normal start))
      (lazy end (. normal end))
      (lazy out-index (if-expr (> end 0) (- end 1) end))
    )
  )
  (fn-expr + (prefix ! this) _
    (== length 0)
  )
  (fn-do + reversed _
    (for (in offset (..< 0 length))
      (yield ([] this (- length 1 offset)))
    )
  )
  (fn-expr + slice-string _
    (call slice-string (..< 0 size))
  )
  (fn-expr + slice-string _
    (param range (of Range Position))
    (call slice-string (call (. range normalize) this))
  )
  (fn-do + slice-string String
    (param range (of Range Index))
    (throw (call Panic "Only increments of 1 are currently supported") (if (!= (. normal increment) 1)))
    (throw (call OutOfBoundsError (str "Range out of bounds (" out-index " / " size ")")) (if (or (> (as start UInt) (as size UInt)) (> end size) (< end start))))
    (blank)
    (if (== len 0)
      (return "")
      (else-if (== Item Char)
        (let made (call C:brixStringFromUtf8Codepoints data start end))
        (throw (call Panic "Array holds a Char that is not a Unicode character") (if (== (. (as made Pointer) address) 0)))
        (return (as made String))
      )
      (else-if (== Item Byte)
        (let made (call C:brixStringSliceUtf8 data start end))
        (throw (call Panic "Unable to read UTF8 content") (if (== (. (as made Pointer) address) 0)))
        (return (as made String))
      )
      (else
        (throw (call Panic "Array does not contain characters"))
      )
    )
    (blank)
    (lazy data (as storage (of CPointer Item)))
    (lazy normal (call (. range forward)))
    (lazy start (. normal start))
    (lazy end (. normal end))
    (lazy out-index (if-expr (> end 0) (- end 1) end))
    (lazy len (- end start))
  )
  (fn-do + (of slice-string Context) String (without gc)
    (param context Context)
    (constraint is Context ArrayStorageProvider)
    (throw (call Panic "Array does not contain characters") (if (!= Item Char)))
    (blank)
    (return (call (. context copy-span) (call (of Array Char) (as storage (of CPointer Char)) size) 0 size true))
  )
  (fn-do + inspectable-snapshot _
    (probe-assign (: this sequence.length) length)
    (for (in item this)
      (probe-log (: this sequence.item) (items: item))
    )
  )
  (fn-do _ absent Item
    (param index Index)
    (throw (call OutOfBoundsError (str "Index out of bounds (" index " / " size ")")))
  )
)

(fn-expr _ host-endian Endian
  (if-expr (call C:brixHostIsLittleEndian) .little .big)
)

(fn-expr _ byte-array-hex-char Byte
  (param value Byte)
  (case? (< value 10)
    (+ value 48)
  )
  (default
    (+ (- value 10) 97)
  )
)

(fn-expr _ byte-array-base64-char Byte
  (param value U32)
  (case? (< value 26)
    (as (+ value 65) Byte)
  )
  (case? (< value 52)
    (as (+ (- value 26) 97) Byte)
  )
  (case? (< value 62)
    (as (+ (- value 52) 48) Byte)
  )
  (case? (== value 62)
    43
  )
  (default
    47
  )
)
