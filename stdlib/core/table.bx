(import ./arena)
(import ./array)
(import ./array-builder)
(import ./backing)
(import ./core)
(import ./number)
(import ./range)
(import ./stream)

(type + (of IndexSpan Item) (is Tuple)
  (implements (of Indexable Item))
  (prop _ source (of CPointer Item))
  (prop _ builder-identity (of CPointer Byte))
  (prop _ offset Index)
  (prop _ storage-size Size)
  (prop _ element-width Size)
  (prop _ source-mutation-generation Size)
  (prop _ owner-handle (of CPointer Byte))
  (prop _ owner-incarnation Size)
  (prop _ owner-generation Size)
  (fn-to-do + (of Iterable Item)
    (for (in index (..< 0 storage-size))
      (yield ([] this index))
    )
  )
  (fn-expr + length Size :get
    storage-size
  )
  (fn-expr + (index-get this (param index Index)) Item
    ([] this index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) This
    ([] this range)
  )
)

(type + (of Table Row) (is Tuple)
  (implements (of Indexable (of TableRow Row)))
  (prop _ columns (of CPointer Pointer))
  (prop _ storage-size Size)
  (prop _ header Size)
  (prop _ owner-handle Size)
  (prop _ owner-incarnation Size)
  (prop _ owner-generation Size)
  (fn-to-do + (of Iterable (of TableRow Row))
    (for (in index (..< 0 length))
      (yield ([] this index))
    )
  )
  (fn-expr + length Size :get
    storage-size
  )
  (fn-expr + (index-get this (param index Index)) (of TableRow Row)
    ([] this index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) (of TableSpan Row)
    ([] this range)
  )
  (fn-expr + (index-get this (param indices (of IndexSpan ''Item))) (of TableSelection Row Item)
    (constraint is Item Number)
    ([] this indices)
  )
  (fn-expr + (index-get this (param indices (of ImmutableArray ''Item ''Backing))) (of TableSelection Row Item)
    (constraint is Item Number)
    (constraint is Backing StorageBacking)
    ([] this indices)
  )
  (fn-expr + (index-get this (param indices (of ArrayBuilder ''Item ArenaBacking))) (of TableSelection Row Item)
    (constraint is Item Number)
    ([] this indices)
  )
  (fn-expr + size Size :get
    storage-size
  )
  (fn-expr + capacity Size :get)
  (fn-do + finish (of ImmutableTable Row) (without gc)
    (return (call (of ImmutableTable Row) (call (of CPointer Pointer)) 0))
  )
  (fn-do + view (of ImmutableTable Row) (without gc)
    (return (call (of ImmutableTable Row) (call (of CPointer Pointer)) 0))
  )
  (fn-do + reserve _ (without gc)
    (param capacity Size)
  )
  (fn-do + append Index (without gc)
    (param row Row)
    (return 0)
  )
  (fn-do + extend _ (without gc)
    (param rows (of Array Row))
  )
  (fn-do + truncate _ (without gc)
    (param length Size)
  )
  (fn-do + clear _ (without gc))
  (fn-do + copy-from _ (without gc)
    (param source (of Table Row))
  )
  (fn-expr + mark TableMark :get)
  (fn-do + rewind _ (without gc)
    (param mark TableMark)
  )
  (fn-expr + storage-checkpoint TableStorageCheckpoint (without gc)
    (param arena Arena)
    (param mark ArenaMark)
    (call TableStorageCheckpoint)
  )
  (fn-do + validate-storage-restore _ (without gc)
    (param checkpoint TableStorageCheckpoint)
    (param arena Arena)
    (param mark ArenaMark)
  )
  (fn-do + restore-storage _ (without gc)
    (param checkpoint TableStorageCheckpoint)
    (param arena Arena)
    (param mark ArenaMark)
  )
  (fn-do + (index-set this (param index Index) (param row Row)) _
    (= ([] this index) row)
  )
  (fn-do + (index-set this (param range (of Range Index)) (param span (of TableSpan Row))) _
    (= ([] this range) span)
  )
  (fn-do + copy _
    (let clone (call This length))
    (= ([] clone (..< 0 length)) ([] this (..< 0 length)))
    (return clone)
  )
)

(type + (of TableRow Row) (is Tuple)
  (prop _ columns (of CPointer Pointer))
  (prop _ row-index Index)
  (prop _ header Size)
  (prop _ owner-handle Size)
  (prop _ owner-incarnation Size)
  (prop _ owner-generation Size)
  (prop _ shrink-generation Size)
)

(type + (of TableSpan Row) (is Tuple)
  (implements (of Indexable (of TableRow Row)))
  (prop _ columns (of CPointer Pointer))
  (prop _ offset Index)
  (prop _ storage-size Size)
  (prop _ header Size)
  (prop _ owner-handle Size)
  (prop _ owner-incarnation Size)
  (prop _ owner-generation Size)
  (prop _ shrink-generation Size)
  (fn-to-do + (of Iterable (of TableRow Row))
    (for (in index (..< 0 storage-size))
      (yield ([] this index))
    )
  )
  (fn-expr + length Size :get
    storage-size
  )
  (fn-expr + (index-get this (param index Index)) (of TableRow Row)
    ([] this index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) (of TableSpan Row)
    ([] this range)
  )
  (fn-expr + size Size :get
    storage-size
  )
  (fn-do + (index-set this (param index Index) (param row Row)) _
    (= ([] this index) row)
  )
  (fn-do + (index-set this (param range (of Range Index)) (param span This)) _
    (= ([] this range) span)
  )
)

(type + (of TableSelection Row Item) (is Tuple)
  (implements (of Indexable (of TableRow Row)))
  (prop _ table (of Table Row))
  (prop _ indices (of IndexSpan Item))
  (fn-to-do + (of Iterable (of TableRow Row))
    (for (in index (..< 0 length))
      (yield ([] this index))
    )
  )
  (fn-expr + length Size :get
    (. indices length)
  )
  (fn-expr + (index-get this (param index Index)) (of TableRow Row)
    ([] this index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) This
    ([] this range)
  )
)

(type + (of TableField Value) (is Tuple)
  (implements (of Indexable Value))
  (prop + data (of CPointer Value))
  (blank)
  (prop _ storage-size Size)
  (prop _ header Size)
  (prop _ columns (of CPointer Pointer))
  (prop _ column-index Size)
  (prop _ offset Index)
  (prop _ owner-handle Size)
  (prop _ owner-incarnation Size)
  (prop _ owner-generation Size)
  (prop _ shrink-generation Size)
  (fn-to-expr + (of CPointer Value)
    data
  )
  (fn-to-do + (of Iterable Value)
    (for (in index (..< 0 storage-size))
      (yield ([] data index))
    )
  )
  (fn-expr + length Size :get
    storage-size
  )
  (fn-expr + (index-get this (param index Index)) Value
    ([] data index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) This
    ([] this range)
  )
  (fn-expr + size Size :get
    storage-size
  )
  (fn-do + (index-set this (param index Index) (param value Value)) _
    (= ([] data index) value)
  )
  (fn-do + (index-set this (param range (of Range Index)) (param other This)) _
    (= ([] this range) other)
  )
  (fn-do + fill _
    (param value Value)
    (for (in index (..< 0 storage-size))
      (= ([] data index) value)
    )
    (return this)
  )
)

(type + (of ImmutableTable Row) (is Tuple)
  (implements (of Indexable (of ImmutableTableRow Row)))
  (prop _ columns (of CPointer Pointer))
  (prop _ storage-size Size)
  (fn-do _ This _
    (param input-columns (of CPointer Pointer))
    (param input-storage-size Size)
    (= columns input-columns)
    (= storage-size input-storage-size)
  )
  (fn-to-do + (of Iterable (of ImmutableTableRow Row))
    (for (in index (..< 0 storage-size))
      (yield ([] this index))
    )
  )
  (fn-expr + length Size :get
    storage-size
  )
  (fn-expr + (index-get this (param index Index)) (of ImmutableTableRow Row)
    ([] this index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) (of ImmutableTableSpan Row)
    ([] this range)
  )
  (fn-expr + (index-get this (param indices (of IndexSpan ''Item))) (of ImmutableTableSelection Row Item)
    (constraint is Item Number)
    ([] this indices)
  )
  (fn-expr + (index-get this (param indices (of ImmutableArray ''Item ''Backing))) (of ImmutableTableSelection Row Item)
    (constraint is Item Number)
    (constraint is Backing StorageBacking)
    ([] this indices)
  )
  (fn-expr + (index-get this (param indices (of ArrayBuilder ''Item ArenaBacking))) (of ImmutableTableSelection Row Item)
    (constraint is Item Number)
    ([] this indices)
  )
  (fn-expr + size Size :get
    storage-size
  )
)

(type + (of ImmutableTableRow Row) (is Tuple)
  (prop _ columns (of CPointer Pointer))
  (prop _ row-index Index)
  (fn-expr + index Index :get
    row-index
  )
)

(type + (of ImmutableTableSpan Row) (is Tuple)
  (implements (of Indexable (of ImmutableTableRow Row)))
  (prop _ columns (of CPointer Pointer))
  (prop _ offset Index)
  (prop _ storage-size Size)
  (fn-to-do + (of Iterable (of ImmutableTableRow Row))
    (for (in index (..< 0 storage-size))
      (yield ([] this index))
    )
  )
  (fn-expr + length Size :get
    storage-size
  )
  (fn-expr + (index-get this (param index Index)) (of ImmutableTableRow Row)
    ([] this index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) This
    ([] this range)
  )
  (fn-expr + size Size :get
    storage-size
  )
)

(type + (of ImmutableTableSelection Row Item) (is Tuple)
  (implements (of Indexable (of ImmutableTableRow Row)))
  (prop _ table (of ImmutableTable Row))
  (prop _ indices (of IndexSpan Item))
  (fn-to-do + (of Iterable (of ImmutableTableRow Row))
    (for (in index (..< 0 length))
      (yield ([] this index))
    )
  )
  (fn-expr + length Size :get
    (. indices length)
  )
  (fn-expr + (index-get this (param index Index)) (of ImmutableTableRow Row)
    ([] this index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) This
    ([] this range)
  )
)

(type + (of ImmutableTableField Value) (is Tuple)
  (implements (of Indexable Value))
  (prop _ data (of CPointer Value))
  (prop _ storage-size Size)
  (fn-to-do + (of Iterable Value)
    (for (in index (..< 0 storage-size))
      (yield ([] this index))
    )
  )
  (fn-expr + length Size :get
    storage-size
  )
  (fn-expr + (index-get this (param index Index)) Value
    ([] this index)
  )
  (fn-expr + (index-get this (param range (of Range Index))) This
    ([] this range)
  )
  (fn-expr + size Size :get
    storage-size
  )
)

(type + TableMark (is Tuple)
  (prop _ header Size)
  (prop _ owner-handle Size)
  (prop _ owner-incarnation Size)
  (prop _ owner-generation Size)
  (prop _ length Size)
  (prop _ append-mutation-generation Size)
  (prop _ spill-used Size)
)

(type + TableStorageCheckpoint (is Tuple)
  (prop _ header Size)
  (prop _ owner-handle Size)
  (prop _ owner-incarnation Size)
  (prop _ owner-generation Size)
  (prop _ arena-mark Size)
  (prop _ arena-active-bytes Size)
  (prop _ columns (of CPointer Pointer))
  (prop _ length Size)
  (prop _ capacity Size)
  (prop _ shrink-generation Size)
  (prop _ mutation-generation Size)
  (prop _ spill-base (of CPointer U8))
  (prop _ spill-used Size)
  (prop _ spill-capacity Size)
)
