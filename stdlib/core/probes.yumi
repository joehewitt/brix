━━━━━━━━━━━━━━━━━━━━
_ do probe-buffer-write'Num Size @no-probe-safepoints @no-suspend
    - data Num
    - Num is Number

. offset = probe-buffer-reserve(Num.size)
probe-buffer.write'Num(data, offset, .little)
= Num.size

━━━━━━━━━━━━━━━━━━━━
_ do probe-write-head Size @no-probe-safepoints @no-suspend
    - probe-type ProbeType
    - probe-id U16
    - object-id ProbeUID
    - class-type ProbeClassId
    - tail-size Size = 0

. now = C:yumiProbeNowNs()
probe-latest-time-ns = now
. offset = probe-buffer-reserve(probe-head-size + tail-size)
probe-buffer.write'U8(probe-type, offset, .little)
probe-buffer.write'U16(probe-id, offset + 1, .little)
probe-buffer.write'U32(object-id, offset + 3, .little)
probe-buffer.write'U16(class-type, offset + 7, .little)
probe-buffer.write'U64(now / 1000000000u64, offset + 9, .little)
probe-buffer.write'U64(now % 1000000000u64, offset + 17, .little)
= offset + probe-head-size

━━━━━━━━━━━━━━━━━━━━
_ do probe-write-group Size @no-probe-safepoints @no-suspend
    - probe-type ProbeType
    - probe-id U16
    - object-id ProbeUID
    - class-type ProbeClassId
    - group-id ProbeUID

. offset = probe-write-head(probe-type, probe-id, object-id, class-type, probe-group-tail-size)
probe-buffer.write'U32(group-id, offset, .little)
probe-buffer.write'U8(ProbeType.done, offset + 4, .little)
= probe-head-size + probe-group-tail-size

━━━━━━━━━━━━━━━━━━━━
_ do get-probes-path @no-probe-safepoints

. probes = C:getenv("PROBES_ENABLED")
if probes
    . text = probes as String
    if text.size > 0
        = C:getenv("PROBES_PATH")

━━━━━━━━━━━━━━━━━━━━
_ do probes-begin @no-probe-safepoints

C:yumiProbeCounterSetup(0)
probe-profile-metric-count = 0
. probes-path = get-probes-path()
if probes-path
    probes-open(probes-path)
    C:yumiRequestTerminationOnSignals()
    . control-path = C:getenv("PROBES_CONTROL_PATH")
    if control-path
        probe-inspecting = C:yumiProbeControlOpen(control-path, "")

━━━━━━━━━━━━━━━━━━━━
_ do probes-end @no-probe-safepoints

probe-profile-flush()
probe-counter-flush()
probe-control-close()
probes-close()

━━━━━━━━━━━━━━━━━━━━
_ do probes-open @no-probe-safepoints
    - probes-path String

probe-segment-size = probe-env-size("PROBES_SEGMENT_SIZE", probe-default-segment-size)
probe-task-buffer-size = probe-env-size("PROBES_TASK_BUFFER_SIZE", probe-default-task-buffer-size)
probe-flush-threshold = probe-env-size("PROBES_FLUSH_THRESHOLD", probe-default-flush-threshold)
if probe-flush-threshold > probe-task-buffer-size
    probe-flush-threshold = probe-task-buffer-size
probe-flush-interval-ns = (probe-env-size("PROBES_FLUSH_INTERVAL_MS", probe-default-flush-interval-ms) as U64) * 1000000u64
. segment-pool = probe-env-size("PROBES_SEGMENT_POOL", probe-default-segment-pool)
if segment-pool < 1
    segment-pool = 1
probe-segment-table-capacity = probe-env-size
    - "PROBES_SEGMENT_TABLE_CAPACITY"
    - probe-default-segment-table-capacity
if probe-segment-table-capacity < segment-pool
    probe-segment-table-capacity = segment-pool

. did-open = C:yumiProbeOpen
    - probes-path
    - probe-segment-size
    - segment-pool
    - probe-task-buffer-size
    - probe-flush-threshold
    - probe-flush-interval-ns
    - probe-segment-table-capacity
if !did-open
    ?! IOError("Unable to open probe log")

probe-task-buffer-size = C:yumiProbeTaskBufferSize() as I64
probe-flush-threshold = C:yumiProbeFlushThreshold() as I64
probe-flush-interval-ns = C:yumiProbeFlushIntervalNs()
probe-buffer-reset()

