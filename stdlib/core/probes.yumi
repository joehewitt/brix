    - id ProbeId
    - object T
    - class-type ProbeClassId
    - delta U64
    - T is Inspectable

C:yumiProbeObjectCounterAdd(id, probe-object-uid(object, class-type), class-type, delta)

━━━━━━━━━━━━━━━━━━━━
_ do probe-object-counter-add'T @no-probe-safepoints
    - id ProbeId
    - object T
    - class-type ProbeClassId
    - delta U64

C:yumiProbeObjectCounterAdd(id, probe-object-uid(object, class-type), class-type, delta)

━━━━━━━━━━━━━━━━━━━━
_ do probe-counter-flush @no-probe-safepoints

. counter-count = C:yumiProbeCounterCount()
if counter-count > 1
    for id in 1 .. < counter-count
        . counter-id = id as ProbeId
        . value = C:yumiProbeCounterValue(counter-id)
        if value || C:yumiProbeCounterTouched(counter-id)
            probe-buffer-write'U8(ProbeType.counter)
            probe-buffer-write'U16(counter-id)
            probe-buffer-write'U32(0)
            probe-buffer-write'U16(0)
            probe-buffer-write'U64(value)
            probe-buffer-write'U8(ProbeType.done)

. object-counter-count = C:yumiProbeObjectCounterCollect()
for index in 0 .. < object-counter-count
    . value = C:yumiProbeObjectCounterValue(index)
    if value
        probe-buffer-write'U8(ProbeType.counter)
        probe-buffer-write'U16(C:yumiProbeObjectCounterId(index))
        probe-buffer-write'U32(C:yumiProbeObjectCounterObjectId(index))
        probe-buffer-write'U16(C:yumiProbeObjectCounterClassType(index))
        probe-buffer-write'U64(value)
        probe-buffer-write'U8(ProbeType.done)

probe-flush()

━━━━━━━━━━━━━━━━━━━━
_ do probes-close @no-probe-safepoints

C:yumiProbeClose()

━━━━━━━━━━━━━━━━━━━━
_ do probe-control-close @no-probe-safepoints

probe-inspecting = false
C:yumiProbeControlClose()

━━━━━━━━━━━━━━━━━━━━
_ probe-control-read-u16 @no-probe-safepoints
    - data Byte[]
    - offset Size

data.read'U16(offset, .little)!

━━━━━━━━━━━━━━━━━━━━
_ probe-control-read-u32 @no-probe-safepoints
    - data Byte[]
    - offset Size

data.read'U32(offset, .little)!

━━━━━━━━━━━━━━━━━━━━
_ do probe-control-write-u16 @no-probe-safepoints
    - data Byte[]
    - offset Size
    - value U16

data.write'U16(value, offset, .little)

━━━━━━━━━━━━━━━━━━━━
_ do probe-control-write-u32 @no-probe-safepoints
    - data Byte[]
    - offset Size
    - value U32

data.write'U32(value, offset, .little)

━━━━━━━━━━━━━━━━━━━━
_ do probe-control-write-status @no-probe-safepoints
    - frame-type U16
    - request-id U32
    - status U32
    - message String = ""

. message-bytes = byte-view(message)
. payload-size U32 = (8 + message-bytes.size) as U32
. frame = Byte[probe-control-header-size + payload-size]

probe-control-write-u32(frame, 0, probe-control-magic)
probe-control-write-u16(frame, 4, probe-control-version)
probe-control-write-u16(frame, 6, frame-type)
probe-control-write-u32(frame, 8, request-id)
probe-control-write-u32(frame, 12, payload-size)
probe-control-write-u32(frame, 16, status)
probe-control-write-u32(frame, 20, message-bytes.size as U32)
if message-bytes.size
    frame[24 .. < 24 + message-bytes.size] = message-bytes

= C:yumiProbeControlWrite(frame.data, frame.size)

━━━━━━━━━━━━━━━━━━━━
_ do probe-control-inspection-log @no-probe-safepoints
    - phase String
    - request ProbeControlInspect
    - status String
    - message String = ""

probe-log("probe.inspect $phase requestId=${request.request-id} objectId=${request.object-id} typeId=${request.type-id} facet=${request.facet} status=$status$message-text")

.. message-text = if message.size > 0 then " message=$message" else ""

━━━━━━━━━━━━━━━━━━━━
_ do probe-live-register'T @no-probe-safepoints @no-suspend
    - uid ProbeUID
    - class-type ProbeClassId
    - object T
    - T is Inspectable

probe-live-lock()
do finally C:yumiProbeLiveUnlock()
=? if probe-live-objects has uid
probe-live-objects[uid] = ProbeLiveEntry(uid, class-type, ProbeLiveObject'T(object))
probe-live-object-ids.append(uid)
probe-live-prune()

━━━━━━━━━━━━━━━━━━━━
_ do probe-live-entry ProbeLiveEntry? @no-probe-safepoints @no-suspend
    - uid ProbeUID

probe-live-lock()
do finally C:yumiProbeLiveUnlock()
= probe-live-objects[uid]

━━━━━━━━━━━━━━━━━━━━
_ do probe-live-lock @no-probe-safepoints

if !C:yumiProbeLiveTryLock()
    C:yumiProbeLiveLock()

━━━━━━━━━━━━━━━━━━━━
_ do probe-live-prune @no-probe-safepoints @no-suspend

if (probe-live-arrays.length as Size) >= probe-live-array-limit
    . kept-keys = ArrayBuilder'ProbeArrayKey()
    for key in probe-live-array-keys
        . entry = probe-live-arrays[key]
        if entry && entry.live.is-kept()
            kept-keys.append(key)
        else
            -= probe-live-arrays[key]
    probe-live-array-keys = kept-keys
    probe-live-array-limit = if kept-keys.length * 2 < probe-live-floor then probe-live-floor else kept-keys.length * 2

if (probe-live-objects.length as Size) >= probe-live-object-limit
    . kept-ids = ArrayBuilder'ProbeUID()
    for uid in probe-live-object-ids
        . entry = probe-live-objects[uid]
        if entry && entry.live.is-kept()
            kept-ids.append(uid)
        else
            -= probe-live-objects[uid]
    probe-live-object-ids = kept-ids
    probe-live-object-limit = if kept-ids.length * 2 < probe-live-floor then probe-live-floor else kept-ids.length * 2

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

━━━━━━━━━━━━━━━━━━━━
_ do probe-control-handle-inspect @no-probe-safepoints
    - request ProbeControlInspect

if (request.flags /and/ 1) != 0
    probe-control-inspection-log("begin", request, "error")
    probe-control-inspection-log("end", request, "error", "subscribe-unsupported")
    probe-control-write-status
        - probe-control-type-error
        - request.request-id
        - probe-control-status-rejected
        - "subscribe-unsupported"
    =
. entry = probe-live-entry(request.object-id)
. target = entry.live.target() if entry
. actual-type = if entry then entry.class-type else request.type-id

if !target
    probe-control-inspection-log("begin", request, "unavailable")
    probe-control-inspection-log("end", request, "unavailable", "unknown-object")
    probe-control-write-status
        - probe-control-type-error
        - request.request-id
        - probe-control-status-unavailable
        - "unknown-object"
    =
if request.type-id && actual-type && request.type-id != actual-type
    probe-control-inspection-log("begin", request, "unavailable")
    probe-control-inspection-log("end", request, "unavailable", "wrong-type")
    probe-control-write-status
        - probe-control-type-error
        - request.request-id
        - probe-control-status-unavailable
        - "wrong-type"
    =
probe-control-write-status
    - probe-control-type-ack
    - request.request-id
    - probe-control-status-accepted
probe-control-inspection-log("begin", request, "running")

stack.append(ProbeFrame(request.object-id, actual-type))
. previous-object = top-object-uid
. previous-type = top-class-type
top-object-uid = request.object-id
top-class-type = actual-type

target.inspectable-inspect(request.facet, request.depth, request.offset, request.limit)

stack.rewind(stack.length - 1)
top-object-uid = previous-object
top-class-type = previous-type

probe-control-inspection-log("end", request, "done")
probe-control-write-status(probe-control-type-done, request.request-id, probe-control-status-done)
probe-flush()

━━━━━━━━━━━━━━━━━━━━
_ do probe-control-handle-frame @no-probe-safepoints
    - frame Byte[]
    - frame-size Size

=? if frame-size < probe-control-header-size

. magic = probe-control-read-u32(frame, 0)
. version = probe-control-read-u16(frame, 4)
. frame-type = probe-control-read-u16(frame, 6)
. request-id = probe-control-read-u32(frame, 8)
. payload-size = probe-control-read-u32(frame, 12)
. payload-offset Size = probe-control-header-size

if magic != probe-control-magic || version != probe-control-version
    probe-control-write-status
        - probe-control-type-error
        - request-id
        - probe-control-status-rejected
        - "bad-frame"
    =
if frame-type == probe-control-type-hello
    probe-control-write-status(probe-control-type-ack, request-id, probe-control-status-accepted)
    =
if frame-type == probe-control-type-cancel
    probe-control-write-status(probe-control-type-done, request-id, probe-control-status-canceled)
    =
if frame-type != probe-control-type-inspect
    probe-control-write-status
        - probe-control-type-error
        - request-id
        - probe-control-status-rejected
        - "unknown-command"
    =
if payload-size < 36 || frame-size < payload-offset + payload-size
    probe-control-write-status
        - probe-control-type-error
        - request-id
        - probe-control-status-rejected
        - "bad-inspect"
    =
. facet-length = probe-control-read-u16(frame, payload-offset + 6)
if payload-size < 36 + facet-length
    probe-control-write-status
        - probe-control-type-error
        - request-id
        - probe-control-status-rejected
        - "bad-facet"
    =
. facet-start = payload-offset + 36
. facet String
facet = frame[facet-start .. < facet-start + facet-length].slice-string()
. request = ProbeControlInspect(request-id, object-id, type-id, facet, depth, offset, limit, flags)
    .. object-id = probe-control-read-u32(frame, payload-offset)
    .. type-id = probe-control-read-u16(frame, payload-offset + 4)
    .. depth = probe-control-read-u32(frame, payload-offset + 8)
    .. offset = probe-control-read-u32(frame, payload-offset + 12)
    .. limit = probe-control-read-u32(frame, payload-offset + 16)
    .. flags = probe-control-read-u32(frame, payload-offset + 32)

probe-control-handle-inspect(request)

━━━━━━━━━━━━━━━━━━━━
_ do probe-control-poll @no-probe-safepoints @no-suspend

=? if probe-control-is-polling || probe-open-snapshots
=? if !C:yumiProbeControlAvailable()

probe-control-is-polling = true
if probe-control-buffer.size < probe-control-buffer-size
    probe-control-buffer = Byte[probe-control-buffer-size]
while true
    . frame-size = C:yumiProbeControlRead(probe-control-buffer.data, probe-control-buffer.size)
    if !frame-size
        break
    probe-control-handle-frame(probe-control-buffer, frame-size as Size)

probe-control-is-polling = false

━━━━━━━━━━━━━━━━━━━━
_ do probe-control-safepoint-poll @no-probe-safepoints

if probe-control-safepoint-countdown
    probe-control-safepoint-countdown -= 1
    =
probe-control-safepoint-countdown = probe-control-safepoint-period
probe-control-poll()

━━━━━━━━━━━━━━━━━━━━
_ do probe-flush @no-probe-safepoints @no-suspend

=? if !probe-buffer-length || probe-open-snapshots

. now-ns = C:yumiProbeNowNs()
C:yumiProbePublish(probe-buffer.data, probe-buffer-length, now-ns)
probe-buffer-length = 0
probe-next-flush-ns = now-ns + probe-flush-interval-ns

━━━━━━━━━━━━━━━━━━━━
_ do probe-flush-at-if-needed @no-probe-safepoints @no-suspend
    - buffer-length Size
    - now-ns U64

if buffer-length && !probe-open-snapshots
    if buffer-length >= probe-flush-threshold || (probe-next-flush-ns && is-due)
        C:yumiProbePublish(probe-buffer.data, buffer-length, now-ns)
        probe-buffer-length = 0
        probe-next-flush-ns = now-ns + probe-flush-interval-ns
    .. is-due = now-ns >= probe-next-flush-ns

━━━━━━━━━━━━━━━━━━━━
_ do probe-flush-if-needed @no-probe-safepoints @no-suspend

. buffer-length = probe-buffer-length
if buffer-length
    . now-ns = probe-latest-time-ns
    if !now-ns
        now-ns = C:yumiProbeNowNs()

    probe-flush-at-if-needed(buffer-length, now-ns)

━━━━━━━━━━━━━━━━━━━━
_ do probe-safepoint-flush-if-needed @no-probe-safepoints

probe-control-safepoint-poll()
. buffer-length = probe-buffer-length
if buffer-length
    probe-flush-at-if-needed(buffer-length, C:yumiProbeNowNs())

━━━━━━━━━━━━━━━━━━━━
_ do probe-group-push @no-probe-safepoints @no-suspend
    - probe-id U16

. group-id = C:yumiGenerateUID()
stack.append(ProbeFrame(group-id, ProbeDataType.group))
. object-id = top-object-uid
. class-type = top-class-type
top-object-uid = group-id
top-class-type = ProbeDataType.group

= probe-write-group(ProbeType.log, probe-id, object-id, class-type, group-id)

━━━━━━━━━━━━━━━━━━━━
_ do probe-group-push-event @no-probe-safepoints @no-suspend
    - probe-id U16

. group-id = C:yumiGenerateUID()
stack.append(ProbeFrame(group-id, ProbeDataType.group))
. object-id = top-object-uid
. class-type = top-class-type
top-object-uid = group-id
top-class-type = ProbeDataType.group

= probe-write-group(ProbeType.event, probe-id, object-id, class-type, group-id)

━━━━━━━━━━━━━━━━━━━━
_ do probe-group-push-object'T @no-probe-safepoints @no-suspend
    - probe-id U16
    - probe-type ProbeType
    - object T
    - class-type ProbeClassId
    - T is Inspectable

= probe-group-push-object-id(probe-id, probe-type, probe-object-uid(object, class-type), class-type)

━━━━━━━━━━━━━━━━━━━━
_ probe-group-push-object'T @no-probe-safepoints @no-suspend
    - probe-id U16
    - probe-type ProbeType
    - object T
    - class-type ProbeClassId

probe-group-push-object-id(probe-id, probe-type, probe-object-uid(object, class-type), class-type)

━━━━━━━━━━━━━━━━━━━━
_ do probe-group-push-object-id @no-probe-safepoints @no-suspend
    - probe-id U16
    - probe-type ProbeType
    - object-id ProbeUID
    - class-type ProbeClassId

. group-id = C:yumiGenerateUID()
stack.append(ProbeFrame(group-id, ProbeDataType.group))
top-object-uid = group-id
top-class-type = ProbeDataType.group

= probe-write-group(probe-type, probe-id, object-id, class-type, group-id)

━━━━━━━━━━━━━━━━━━━━
_ do probe-group-pop @no-probe-safepoints @no-suspend
    - probe-id U16

. group-id = top-object-uid
probe-stack-pop()

= probe-write-group(ProbeType.log, probe-id, top-object-uid, top-class-type, group-id)

━━━━━━━━━━━━━━━━━━━━
_ do probe-group-pop-event @no-probe-safepoints @no-suspend
    - probe-id U16

. group-id = top-object-uid
probe-stack-pop()

= probe-write-group(ProbeType.event, probe-id, top-object-uid, top-class-type, group-id)

━━━━━━━━━━━━━━━━━━━━
_ do probe-group-pop-object'T @no-probe-safepoints @no-suspend
    - probe-id U16
    - probe-type ProbeType
    - object T
    - class-type ProbeClassId
    - T is Inspectable

= probe-group-pop-object-id(probe-id, probe-type, probe-object-uid(object, class-type), class-type)

━━━━━━━━━━━━━━━━━━━━
_ probe-group-pop-object'T @no-probe-safepoints @no-suspend
    - probe-id U16
    - probe-type ProbeType
    - object T
    - class-type ProbeClassId

probe-group-pop-object-id(probe-id, probe-type, probe-object-uid(object, class-type), class-type)

━━━━━━━━━━━━━━━━━━━━
_ do probe-group-pop-object-id @no-probe-safepoints @no-suspend
    - probe-id U16
    - probe-type ProbeType
    - object-id ProbeUID
    - class-type ProbeClassId

. group-id = top-object-uid
probe-stack-pop()

= probe-write-group(probe-type, probe-id, object-id, class-type, group-id)

━━━━━━━━━━━━━━━━━━━━
_ do probe-stack-pop @no-probe-safepoints @no-suspend

stack.rewind(stack.length - 1)
if stack.length == 0
    top-object-uid = 0
    top-class-type = 0
else
    top-object-uid, top-class-type = stack[Position.last]

━━━━━━━━━━━━━━━━━━━━
_ do probe-write-snapshot @no-probe-safepoints @no-suspend
    - object-id ProbeUID
    - class-type ProbeClassId

probe-buffer-write'U8(ProbeType.snapshot)
probe-buffer-write'U32(object-id)
probe-buffer-write'U16(class-type)

━━━━━━━━━━━━━━━━━━━━
_ do probe-log-head @no-probe-safepoints @no-suspend
    - probe-id U16

= probe-write-head(ProbeType.log, probe-id, top-object-uid, top-class-type)

━━━━━━━━━━━━━━━━━━━━
