_ probe-flush-interval-ns U64 = 16000000u64
_ @task probe-latest-time-ns U64
_ probe-inspecting = false
_ probe-live-object-limit Size = 1024
_ probe-live-array-limit Size = 1024
_ probe-live-floor Size = 1024
