= probe-write-head(ProbeType.event, probe-id, probe-object-uid(object, class-type), class-type)

━━━━━━━━━━━━━━━━━━━━
_ do probe-object-event-head'T @no-probe-safepoints @no-suspend
    - probe-id U16
    - object T
    - class-type ProbeClassId

= probe-write-head(ProbeType.event, probe-id, probe-object-uid(object, class-type), class-type)

━━━━━━━━━━━━━━━━━━━━
_ do probe-write @no-probe-safepoints @no-suspend
    - value String

probe-buffer-write'U32(value.size as U32)
probe-buffer-write(value)

━━━━━━━━━━━━━━━━━━━━
_ do probe-write'Num @no-probe-safepoints @no-suspend
    - value Num
    - Num is Number

probe-buffer-write(value)

━━━━━━━━━━━━━━━━━━━━
_ do probe-write-object'T @no-probe-safepoints @no-suspend
    - value Array'T
    - class-type ProbeClassId
    - is-snapshot = false

. uid = probe-object-uid(value, class-type)

if is-snapshot
    probe-buffer-write'U32(value.byte-size as U32)
    probe-buffer-write'ProbeClassId(T.probe-data-type as ProbeClassId)
    probe-buffer-write(value)
else
    probe-buffer-write'U32(0)
    probe-buffer-write'ProbeClassId(T.probe-data-type as ProbeClassId)

probe-buffer-write'U32(uid)

if is-snapshot
    probe-write-snapshot(uid, class-type)

= probe-buffer-write'U8(ProbeType.done)

━━━━━━━━━━━━━━━━━━━━
_ do probe-write-object'T @no-probe-safepoints @no-suspend
    - value T
    - class-type ProbeClassId
    - is-snapshot = false
    - T is Inspectable

. ins Inspectable = value
. uid = probe-object-uid(value, class-type)

probe-buffer-write'U32(uid)

if is-snapshot
    stack.append(ProbeFrame(uid, class-type))
    top-object-uid = uid
    top-class-type = class-type

    probe-write-snapshot(uid, class-type)
    probe-open-snapshots += 1
    do finally probe-open-snapshots -= 1
    ins.inspectable-snapshot()

    probe-stack-pop()

= probe-buffer-write'U8(ProbeType.done)

━━━━━━━━━━━━━━━━━━━━
_ do probe-write-object'T @no-probe-safepoints @no-suspend
    - value T
    - class-type ProbeClassId
    - is-snapshot = false

probe-buffer-write'U32(value.uid)
probe-buffer-write'U8(ProbeType.done)
