| declare-property = 3
| declare-type = 4
| system-log = 5
| log = 6
| event = 7
| snapshot = 8
| declare-log2 = 9
| declare-key = 10
| declare-counter = 11
| counter = 12
| declare-profile-metric = 13
| profile-metric = 14

