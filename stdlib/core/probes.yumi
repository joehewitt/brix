╌╌╌╌╌╌╌╌╌╌ is ProbeLive ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ is-alive Bool

!token || pointer != null

.. pointer = C:yumiGCOwnerWeakLoad(token)

────────────────────
+ is-kept Bool

token != 0 && is-alive()

────────────────────
+ do target Inspectable?

=? if token && !C:yumiGCOwnerWeakLoad(token)
= Array'T(address as CPointer'T, length)

━━━━━━━━━━━━━━━━━━━━
_ do probe-env-size @no-probe-safepoints
    - name String
    - default-value Size

. value = C:getenv(name)
if value
    . parsed = C:strtoull(value, null, 10) as Size
    if parsed > 0
        = parsed

= default-value

━━━━━━━━━━━━━━━━━━━━
_ do probe-buffer-reset @no-probe-safepoints

probe-buffer-length = 0
probe-next-flush-ns = 0

━━━━━━━━━━━━━━━━━━━━
_ do probe-buffer-ensure @no-probe-safepoints @no-suspend
    - required Size

=? if required <= probe-buffer.size

. next-size = probe-buffer.size
if next-size < probe-task-buffer-size
    next-size = probe-task-buffer-size
if next-size < 1
    next-size = 1
while next-size < required
    next-size *= 2

probe-buffer = probe-buffer.resize(next-size)

━━━━━━━━━━━━━━━━━━━━
_ do probe-buffer-reserve Size @no-probe-safepoints @no-suspend
    - size Size

. offset = probe-buffer-length
. required = offset + size
probe-buffer-ensure(required)
probe-buffer-length = required
if !probe-next-flush-ns
    probe-next-flush-ns = C:yumiProbeNowNs() + probe-flush-interval-ns
= offset

━━━━━━━━━━━━━━━━━━━━
_ do probe-buffer-write Size @no-probe-safepoints @no-suspend
    - data CPointer'Byte
    - size Size

=? size
    if !size

. offset = probe-buffer-reserve(size)
C:memcpy(probe-buffer.data + offset, data, size)
= size

