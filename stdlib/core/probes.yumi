_ probe-control-version U16 = 1
_ probe-control-header-size Size = 16
_ probe-control-type-hello U16 = 1
_ probe-control-type-inspect U16 = 2
_ probe-control-type-cancel U16 = 3
_ probe-control-type-ack U16 = 4
_ probe-control-type-done U16 = 5
_ probe-control-type-error U16 = 6
_ probe-control-status-accepted U32 = 1
_ probe-control-status-rejected U32 = 2
