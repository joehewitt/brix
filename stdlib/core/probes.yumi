━━━━━━━━━━━━━━━━━━━━
_ probe-profile-now-ns U64 @no-probe-safepoints

C:yumiProbeMonotonicNowNs()

━━━━━━━━━━━━━━━━━━━━
_ do probe-profile-flush @no-probe-safepoints

=? if !probe-profile-metric-count

. now = probe-profile-now-ns()
. profile-limit = probe-profile-metric-count + 1

for id in 1 .. < profile-limit
    . value = C:yumiProbeProfileCounterValue(id as ProbeProfileMetricId)
    if value
        probe-buffer-write'U8(ProbeType.profile-metric)
        probe-buffer-write'U16(id as ProbeProfileMetricId)
        probe-buffer-write'U8(1)
        probe-buffer-write'U64(value)
        probe-buffer-write'U64(0u64)
        probe-buffer-write'U64(0u64)
        probe-buffer-write'U64(0u64)
        probe-buffer-write'U8(ProbeType.done)

. timer = U64[4]
for id in 1 .. < profile-limit
    . profile-id = id as ProbeProfileMetricId
    C:yumiProbeProfileTimerRead(profile-id, now, timer.data)
    if timer[0] || timer[2]
        probe-buffer-write'U8(ProbeType.profile-metric)
        probe-buffer-write'U16(profile-id)
        probe-buffer-write'U8(2)
        probe-buffer-write'U64(timer[0])
        probe-buffer-write'U64(timer[1])
        probe-buffer-write'U64(timer[2])
        probe-buffer-write'U64(timer[3])
        probe-buffer-write'U8(ProbeType.done)

probe-flush()

━━━━━━━━━━━━━━━━━━━━
_ do probe-object-uid'T ProbeUID @no-probe-safepoints @no-suspend
    - object Array'T
    - class-type ProbeClassId

. key = ProbeArrayKey(object.data.address, object.length, class-type)
probe-live-lock()
do finally C:yumiProbeLiveUnlock()
. found = probe-live-arrays[key]
=? found.uid if found && found.live.is-alive()
if !found
    probe-live-array-keys.append(key)
. entry = ProbeLiveEntry(C:yumiGenerateUID(), class-type, ProbeLiveArray'T(object))
probe-live-arrays[key] = entry
if probe-inspecting
    probe-live-objects[entry.uid] = entry
    probe-live-object-ids.append(entry.uid)
probe-live-prune()
= entry.uid

━━━━━━━━━━━━━━━━━━━━
_ do probe-object-uid'T ProbeUID @no-probe-safepoints @no-suspend
    - object T
    - class-type ProbeClassId
    - T is Inspectable

. uid = object.uid
if probe-inspecting
    probe-live-register(uid, class-type, object)
= uid

