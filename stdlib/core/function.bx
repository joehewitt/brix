(import ./core)
(import ./error)
(import ./number)

(type + Function)

(type + Doer (is (fn-type Void (?! Error))))

(type + (of Getter Result) (is (fn-type Result)))

(type + Closure)

(type + Capture)

(type + Binding)

(type + (of Statement Item) (is (fn-type Void (param item Item))))

(type + (of Selector Item Result) (is (fn-type Result (param item Item))))

(type + (of Mapper Item Result) (is (fn-type Result (param item Item))))

(type + (of Mapper2 Pos Item Result) (is (fn-type Result (param item Item) (param index Pos) (constraint is Result Item))))

(type + (of OptionalMapper Item Result) (is (fn-type (of Optional Result) (param item Item))))

(type + (of Predicate Item) (is (fn-type Bool (param item Item))))

(type + (of Comparer Item) (is (fn-type Comparison (param left Item) (param right Item))))

(type + Chainable
  (fn-expr + (of with Result) _
    (param func (fn-type Result (param _ This)))
    (call func this)
  )
)

(type + (of Lazy T) (is (of Getter T))
  (fn-to-expr + T
    (call this)
  )
)

(type + Comparison (is Union)
  (variant lesser)
  (variant equal)
  (variant greater)
)

(fn-expr + (of identity T) _
  (param object T)
  object
)
