━━━━━━━━━━━━━━━━━━━━
+ do hash-for'Num Hash
    - value Num
    - Num is Number

. bits = value as U64
. mixed = (bits /xor/ (bits /zrshift/ 33)) * hash-first-multiplier
mixed = (mixed /xor/ (mixed /zrshift/ 33)) * hash-second-multiplier
= (mixed /xor/ (mixed /zrshift/ 33)) as Hash
