/YuCore/YuCore.h

+ bucket-allocation-size = 8 as Size
+ map-maximum-capacity = 2147483648 as Size

+ Hash is U32
+ KeyValuePair'Key'Value is (key Key, value Value)

_ map-tombstone-hash = U32.max
_ hash-first-multiplier U64 = 0xff51afd7ed558ccd
_ hash-second-multiplier U64 = 0xc4ceb9fe1a85ec53
_ MapProbe is (found Index?, vacant Index)

` All three slot arrays have the same power-of-two capacity. A zero hash is empty, U32.max is a
` tombstone, and every other hash has a live key/value at the same index. Inserts keep live plus
` deleted slots at or below 75%; tombstone pressure rehashes in place, growth quadruples capacity,
` reserve rounds up to that policy, and deletion/clear deliberately never shrink retained storage.
` A map made for a count of pairs takes the least power of two that holds them.

━━━━━━━━━━━━━━━━━━━━
+ Map'Key'Value'Backing
    - Backing = GCBacking
    - Backing is StorageBacking
    is Inspectable

_ pair-count U32 = 0

_ context Backing.Context
_ hashes Array'Hash'Backing
_ key-slots Array'Key'Backing
_ value-slots Array'Value'Backing
_ buckets-allocated = bucket-allocation-size
_ tombstones = 0 as Size
_ mutation-version = 0u64

