+ do to Iterable'(KeyValuePair'Key'Value) @inline

. version = mutation-version
for index in 0 .. < buckets-allocated
    ensure-iteration-version(version)
    if is-occupied-hash(hashes[index])
        <= KeyValuePair(key-slots[index], value-slots[index])
ensure-iteration-version(version)

