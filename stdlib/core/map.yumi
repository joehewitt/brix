────────────────────
+ do clear

. new-hashes = Array'Hash'Backing(context, buckets-allocated)
. new-keys = Array'Key'Backing(context, buckets-allocated)
. new-values = Array'Value'Backing(context, buckets-allocated)
hashes = new-hashes
key-slots = new-keys
value-slots = new-values
pair-count = 0
tombstones = 0
