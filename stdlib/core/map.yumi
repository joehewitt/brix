for key, value in that
    this[key as Key] = value as Value
= this

────────────────────
+ do this += that (key Key, value Value)

this[that.key] = that.value
= this

────────────────────
+ do this - that This

. clone = This(pair-count as Size, context)
clone += this
= clone -= that

────────────────────
+ do this -= that This

for key in that.keys
    -= this[key]
= this

────────────────────
+ do this[key Key] Value?

. encoded = encoded-hash(hash-for(key))
. found = probe-for(key, encoded).found
if found
    = value-slots[found]

────────────────────
+ do this[key Key] = value Value

. encoded = encoded-hash(hash-for(key))
. probe = probe-for(key, encoded)
if probe.found
    value-slots[probe.found] = value
    mutation-version += 1
else
    if occupied-and-deleted-count() + 1 > buckets-allocated * 3 / 4
        if (pair-count as Size) + 1 <= buckets-allocated * 3 / 4
            rehash(buckets-allocated)
        else
            grow-buckets()
        probe = probe-for(key, encoded)

    . slot = probe.vacant
    if hashes[slot] == map-tombstone-hash
        tombstones -= 1
    key-slots[slot] = key
    value-slots[slot] = value
    hashes[slot] = encoded
    pair-count += 1
    mutation-version += 1

= value

────────────────────
+ do -= this[key Key]

. encoded = encoded-hash(hash-for(key))
. found = probe-for(key, encoded).found
if found
    . slot = found
    hashes[slot] = map-tombstone-hash
    key-slots.zero(slot)
    value-slots.zero(slot)
    pair-count -= 1
    tombstones += 1
    mutation-version += 1

────────────────────
+ !this

pair-count == 0

────────────────────
+ do get-or-init Value
    - key Key

. existing-value = this[key]
=? existing-value

. new-value = Value()
this[key] = new-value
= new-value

────────────────────
+ do find
    - that Value

for item in this.items
    if item.value == that
        <= item.key

────────────────────
_ do insert-fitted
    - key Key
    - value Value

` Puts a pair in a map made for a count of pairs it has not yet had more of, so no slot is a
` tombstone and one is free: a key it has already has its value replaced.
. encoded = encoded-hash(hash-for(key))
. index = bucket-for-hash(encoded)
for probes in 0 .. < buckets-allocated
    . candidate = hashes[index]
    if !candidate
        key-slots[index] = key
        value-slots[index] = value
        hashes[index] = encoded
        pair-count += 1
        =
    if candidate == encoded && key-slots[index] == key
        value-slots[index] = value
        =
    index = next-bucket(index)
?! Panic("Map probe exhausted")

────────────────────
_ do probe-for MapProbe
    - key Key
    - encoded Hash

. index = bucket-for-hash(encoded)
. first-tombstone Index?
. not-found Index?
for probes in 0 .. < buckets-allocated
    . candidate = hashes[index]
    if !candidate
        = MapProbe(not-found, first-tombstone ?? index)
    else if candidate == map-tombstone-hash
        if !first-tombstone
            first-tombstone = index
    else if candidate == encoded && key-slots[index] == key
        = MapProbe(index, index)
    index = next-bucket(index)

if first-tombstone
    = MapProbe(not-found, first-tombstone)
?! Panic("Map probe exhausted")

────────────────────
_ bucket-for-hash Index
    - hash Hash

(hash as Size) /and/ (buckets-allocated - 1)

────────────────────
_ next-bucket Index
    - index Index

(index + 1) /and/ (buckets-allocated - 1)

────────────────────
_ occupied-and-deleted-count Size

(pair-count as Size) + tombstones

────────────────────
_ do grow-buckets

if buckets-allocated >= map-maximum-capacity
    ?! Panic("Map capacity overflow")
. new-capacity = buckets-allocated * 4
if new-capacity > map-maximum-capacity
    new-capacity = map-maximum-capacity
rehash(new-capacity)

────────────────────
_ do rehash
    - new-capacity Size

. old-hashes = hashes
. old-keys = key-slots
. old-values = value-slots
. old-capacity = buckets-allocated

. new-hashes = Array'Hash'Backing(context, new-capacity)
. new-keys = Array'Key'Backing(context, new-capacity)
. new-values = Array'Value'Backing(context, new-capacity)
hashes = new-hashes
key-slots = new-keys
value-slots = new-values
buckets-allocated = new-capacity
tombstones = 0

for old-index in 0 .. < old-capacity
    . encoded = old-hashes[old-index]
    if is-occupied-hash(encoded)
        . probe = probe-for(old-keys[old-index], encoded)
        . new-index = probe.vacant
        key-slots[new-index] = old-keys[old-index]
        value-slots[new-index] = old-values[old-index]
        hashes[new-index] = encoded

────────────────────
_ do initialize-storage
    - capacity Size

hashes = Array'Hash'Backing(context, capacity)
key-slots = Array'Key'Backing(context, capacity)
value-slots = Array'Value'Backing(context, capacity)
buckets-allocated = capacity

────────────────────
_ do capacity-for-count Size
    - count Size

?! Panic("Map capacity overflow")
    if count > map-maximum-capacity * 3 / 4

. capacity = bucket-allocation-size
while count > capacity * 3 / 4
    capacity *= 4
    if capacity > map-maximum-capacity
        capacity = map-maximum-capacity
= capacity

────────────────────
_ do fitted-capacity Size
    - count Size

` The least power of two from the bucket allocation size that keeps a count at or below 75%.
?! Panic("Map capacity overflow")
    if count > map-maximum-capacity * 3 / 4

. capacity = bucket-allocation-size
while count > capacity * 3 / 4
    capacity *= 2
= capacity

────────────────────
_ do ensure-iteration-version
    - version U64

if mutation-version != version
    ?! Panic("Map mutated during iteration")

━━━━━━━━━━━━━━━━━━━━
_ encoded-hash Hash
    - hash Hash

|? hash >= U32.max - 1
    1u32
??
    hash + 1

━━━━━━━━━━━━━━━━━━━━
_ is-occupied-hash Bool
    - hash Hash

hash != 0 && hash != map-tombstone-hash

