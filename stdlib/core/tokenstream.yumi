────────────────────
+ do match-literal Bool
    - literal Token[]

. probe-end = (if cursor + literal.size < length then cursor + literal.size else length)
if probe-end > cursor-extent
    cursor-extent = probe-end
if probe-end - cursor < literal.size
    = false

for i in 0 .. < literal.size
    //grammar.literal-compared-tokens ++
    //grammar.literal-compared-bytes += Token.size
    if buffer[cursor + i] != literal[i]
        = false
cursor = probe-end
= true

────────────────────
+ do read String?
    - during Predicate'Token

. buf = Token[0]
. count = 0
. stopped = false

while 1
    . item = <- this
    if item
        if during(item)
            if count >= buf.size
                buf = buf.grow((if buf.size > 0x20 then buf.size else 0x20))
            buf[count] = item
            count += 1
        else
            cursor -= 1
            stopped = true
            break
    else
        break

if count > 0 || stopped
    = buf.slice-string(0 .. < count)

────────────────────
_ get last-location TokenLocation

|? cursor == 0
    (0, 0)
??
    location-at(cursor - 1)

────────────────────
_ do location-at TokenLocation
    - target Index

ensure-locations-through(target)
//grammar.location-computations ++

if target == cached-location-target
    //grammar.location-cache-hits ++
    = cached-location

. line = cached-location-line
if target > cached-location-target
    while line + 1 < line-start-count && line-starts[line + 1] <= target
        line += 1
        //grammar.location-forward-line-steps ++
else if target < line-starts[line]
    . low Index = 0
    . high Index = line-start-count
    while low + 1 < high
        . middle = (low + high) / 2
        //grammar.location-binary-search-comparisons ++
        if line-starts[middle] <= target
            low = middle
        else
            high = middle
    line = low
    //grammar.location-backward-searches ++

. column = target - line-starts[line]
if line == 0
    column += origin-column
. location = TokenLocation((origin-line + line) as U32, column as U32)
cached-location-target = target
cached-location-line = line
cached-location = location
= location

────────────────────
_ do ensure-locations-through
    - target Index

if line-start-count == 0
    line-starts = Index[8]
    line-starts[0] = 0
    line-start-count = 1

if target > location-scanned
    scan-locations-through(target)

────────────────────
_ do reset-location-index

line-starts = Index[0]
line-start-count = 0
location-scanned = 0
cached-location-target = 0
cached-location-line = 0
cached-location = TokenLocation(origin-line as U32, origin-column as U32)

────────────────────
_ do release-locations
    - count Index

. origin = location-at(count)
origin-line = origin.line
origin-column = origin.column
reset-location-index()

────────────────────
+ do scan-locations-through
    - target Index

. scan-start = location-scanned
. data = buffer
. end = length
for i in scan-start .. < target
    . item = data[i]
    if is-code(item, 10) || (is-code(item, 13) && (i + 1 >= end || !is-code(data[i + 1], 10)))
        append-line-start(i + 1)

//grammar.location-forward-tokens += target - scan-start
location-scanned = target

────────────────────
_ do append-line-start
    - start Index

if line-start-count >= line-starts.size
    line-starts = line-starts.resize(line-starts.size * 2)

line-starts[line-start-count] = start
line-start-count += 1

