    - mark StreamMark

null

────────────────────
+ do scan-span CaptureSpan'Char
    - during Predicate'Char

. text = read • during during
if text
    . source = Array'Char(text)
    = CaptureSpan'Char(source, 0, source.size)
= CaptureSpan'Char(Char[0], 0, 0)

────────────────────
+ do <- this

if cursor < length
    . item = char-at(cursor)
    cursor += char-size(cursor)
    if cursor > cursor-extent
        cursor-extent = cursor
    = item

────────────────────
+ do read Size
    - size Size
    - receiver Char[]
    - should-read-once = false

. count Size = 0
while count < size && cursor < length
    receiver[count] = char-at(cursor)
    cursor += char-size(cursor)
    count += 1
if cursor > cursor-extent
    cursor-extent = cursor
= count

────────────────────
+ do match-literal Bool
    - literal Char[]

. probe = cursor
. matched = true
for item in literal
    if probe >= length
        matched = false
        break
    if char-at(probe) != item
        matched = false
    probe += char-size(probe)
if probe > cursor-extent
    cursor-extent = probe
if matched
    cursor = probe
= matched

────────────────────
+ do read String?
    - during Predicate'Char

. start = cursor
. stopped = false
while cursor < length
    if !during(char-at(cursor))
        stopped = true
        break
    cursor += char-size(cursor)
if cursor > cursor-extent
    cursor-extent = cursor
if cursor > start || stopped
    = bytes.slice-string(start .. < cursor)

────────────────────
_ char-size Size
    - index Index

|? lead < 0x80
    1
|? lead < 0xE0
    2
|? lead < 0xF0
    3
??
    4

.. lead = bytes[index] as U32

────────────────────
_ do char-at Char
    - index Index

. lead = bytes[index] as U32
=? lead as Char if lead < 0x80
. width = char-size(index)
. value = lead /and/ (0x7F /rshift/ (width as U32))
for offset in 1 .. < width
    value = (value /lshift/ 6) /or/ ((bytes[index + offset] as U32) /and/ 0x3F)
= value as Char

────────────────────
_ do char-start Index
    - target Index

. start = target
while start > 0 && start < length && ((bytes[start] as U32) /and/ 0xC0) == 0x80
    start -= 1
= start

────────────────────
_ get last-location TokenLocation

|? cursor == 0
    (0, 0)
??
    location-at(char-start(cursor - 1))

────────────────────
_ do location-at TokenLocation
    - target Index

. end = if target < length then target else length
ensure-line-starts(end)
. low Index = 0
. high Index = line-start-count
while low + 1 < high
    . middle = (low + high) / 2
    if line-starts[middle] <= end
        low = middle
    else
        high = middle
. from = line-starts[low]
. column Size = 0
if low == cached-line && cached-target >= from && cached-target <= end
    from = cached-target
    column = cached-column
for index in from .. < end
    if ((bytes[index] as U32) /and/ 0xC0) != 0x80
        column += 1
cached-target = end
cached-line = low
cached-column = column
= TokenLocation(low as U32, (column + target - end) as U32)

────────────────────
_ do ensure-line-starts
    - target Index

if line-start-count == 0
    line-starts = Index[8]
    line-starts[0] = 0
    line-start-count = 1
if target <= location-scanned
    =
for index in location-scanned .. < target
    . item = bytes[index] as U32
    if item == 10 || (item == 13 && (index + 1 >= length || (bytes[index + 1] as U32) != 10))
        if line-start-count >= line-starts.size
            line-starts = line-starts.resize(line-starts.size * 2)
        line-starts[line-start-count] = index + 1
        line-start-count += 1
location-scanned = target

