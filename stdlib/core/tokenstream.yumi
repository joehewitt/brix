────────────────────
+ do capture-span CaptureSpan'Token?
    - mark StreamMark

validate-stream-mark(mark, this as Pointer)
if !stable-source || mark.cursor > cursor
    = null

//grammar.capture-spans-created ++
//grammar.captures-elided ++
if !reported-capture-source
    //grammar.capture-span-retained-source-bytes += array-buffer.size * Token.size
    reported-capture-source = true
= CaptureSpan'Token(array-buffer, mark.cursor, cursor)

────────────────────
+ do scan-span CaptureSpan'Token
    - during Predicate'Token

if !stable-source
    = super.scan-span(during)

. start = cursor
while cursor < length
    . item = array-buffer[cursor]
    cursor += 1
    if cursor > cursor-extent
        cursor-extent = cursor
    //grammar.reads ++
    //grammar.read-tokens ++
    //grammar.direct-buffer-reads ++
    if !during(item)
        cursor -= 1
        break

//grammar.capture-spans-created ++
//grammar.captures-elided ++
if !reported-capture-source
    //grammar.capture-span-retained-source-bytes += array-buffer.size * Token.size
    reported-capture-source = true
= CaptureSpan'Token(array-buffer, start, cursor)

────────────────────
+ do scan-locations-through
    - target Index

. scan-start = location-scanned
for i in scan-start .. < target
    . item = array-buffer[i]
    . is-line-feed = is-code(item, 10)
    . is-carriage-return = is-cr-code && (i + 1 >= length || !is-code(array-buffer[i + 1], 10))
        .. is-cr-code = is-code(item, 13)
    if is-line-feed || is-carriage-return
        append-line-start(i + 1)

//grammar.location-forward-tokens += target - scan-start
location-scanned = target

