────────────────────
+ do match-literal Bool
    - literal Token[]

//grammar.literal-direct-compares ++
. probe-end = (if cursor + literal.size < length then cursor + literal.size else length)
if probe-end > cursor-extent
    cursor-extent = probe-end

if probe-end - cursor < literal.size
    = false

for i in 0 .. < literal.size
    //grammar.literal-compared-tokens ++
