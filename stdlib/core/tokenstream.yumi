+ ChunkedTokenStream'Token is IndexableTokenStream'Token
    is Iterable'Token

+ failure Error?

_ iterable-source Iterable'Token?
_ generator-source Generator'Token?
_ byte-source ByteReadable?
_ source-complete Bool
_ fraction-buffer = Byte[32]
_ fraction-length Size
_ raw-buffer = Byte[0]
_ read-buffer = Token[0]
_ pinned Bool

────────────────────
+ This
    - source Iterable'Token

super(Token[0])
iterable-source = source

────────────────────
+ This
    - source Generator'Token

super(Token[0])
generator-source = source

────────────────────
+ This
    - source ByteReadable

super(Token[0])
byte-source = source

────────────────────
+ do pattern-extend Bool

. old-length = length
if !source-complete
    refill(pattern-refill-size)
= length > old-length

────────────────────
_ get pattern-refill-size Size

|? !byte-source
    1
|? pending > chunk-size
    pending
??
    chunk-size

.. pending = length - cursor

────────────────────
+ do pattern-release

pinned = false
release-consumed()

────────────────────
_ do release-unpinned

if !pinned
    release-consumed()

────────────────────
_ do release-consumed

. released = if cursor && is-code(buffer[cursor - 1], 13) then cursor - 1 else cursor
. pending = length - released
. is-full = buffer.size - length < chunk-size
if released && released >= pending && (is-full || buffer.size > release-capacity)
    release-locations(released)
    . capacity = token-buffer-capacity(pending + chunk-size)
    . ramp = if buffer.size < release-capacity then buffer.size * 2 else release-capacity
    . retained = Token[if capacity > ramp then capacity else ramp]
    if pending
        retained[0 .. < pending] = buffer[released .. < length]
    buffer = retained
    cursor-extent = if cursor-extent > released then cursor-extent - released else 0
    length = pending
    cursor -= released
    if raw-buffer.size > release-capacity
        raw-buffer = Byte[0]

────────────────────
+ do refill
    - amount Size

if iterable-source
    refill-from-iterable(amount, iterable-source)
else if generator-source
    refill-from-generator(amount, generator-source)
else if byte-source
    refill-from-bytes(amount, byte-source)
else
    source-complete = true

────────────────────
+ do append-buffer
    - data Token[]
    - amount Size

if amount
    reserve-tokens(amount)
    buffer[length .. < length + amount] = data[0 .. < amount]
    length += amount
    //grammar.refills ++

────────────────────
_ do reserve-tokens
    - amount Size

. required = length + amount
if required > buffer.size
    buffer = buffer.resize(token-buffer-capacity(required))

────────────────────
+ do append-buffer
    - data Token[]

append-buffer(data, data.length)

────────────────────
+ do get has-more

if cursor >= length && !source-complete
    release-unpinned()
    refill(1)
= cursor < length

────────────────────
+ do <- this Token?

if cursor >= length && !source-complete
    release-unpinned()
    refill(1)
if cursor < length
    . item = buffer[cursor]
    cursor += 1
    if cursor > cursor-extent
        cursor-extent = cursor
    //grammar.reads ++
    //grammar.read-tokens ++
    //grammar.direct-buffer-reads ++
    = item

────────────────────
+ do peek Token?

if has-more
    = buffer[cursor]

────────────────────
+ do read Size
    - size Size
    - receiver Token[]
    - should-read-once = false

if !(should-read-once && cursor < length)
    while cursor + size > length && !source-complete
        release-unpinned()
        . old-length = length
        refill(cursor + size - length)
        if should-read-once || length == old-length
            break

. actual = (if size < length - cursor then size else length - cursor)
if actual
    receiver[0 .. < actual] = buffer[cursor .. < cursor + actual]
cursor += actual
if cursor > cursor-extent
    cursor-extent = cursor
//grammar.reads ++
//grammar.read-tokens += actual
//grammar.direct-buffer-reads += actual
= actual

────────────────────
+ do match-literal Bool
    - literal Token[]

while cursor + literal.size > length && !source-complete
    . old-length = length
    refill(cursor + literal.size - length)
    if length == old-length
        break

. probe-end = (if cursor + literal.size < length then cursor + literal.size else length)
if probe-end > cursor-extent
    cursor-extent = probe-end
if probe-end - cursor < literal.size
    = false

for i in 0 .. < literal.size
    //grammar.literal-compared-tokens ++
    //grammar.literal-compared-bytes += Token.size
    if buffer[cursor + i] != literal[i]
        = false
cursor = probe-end
= true

────────────────────
+ do mark StreamMark

pinned = true
= super.mark()

────────────────────
+ do capture-span CaptureSpan'Token?
    - mark StreamMark

validate-stream-mark(mark, this as Pointer)
if mark.cursor > cursor
    = null
= CaptureSpan'Token(buffer, mark.cursor, cursor)

────────────────────
_ do refill-from-iterable
    - amount Size
    - source Iterable'Token

. count Size
while count < amount && !source-complete
    . item = <- source
    if !item
        source-complete = true
        break
    reserve-tokens(1)
    buffer[length] = item
    length += 1
    count += 1
if count
    //grammar.refills ++

────────────────────
_ do refill-from-generator
    - amount Size
    - source Generator'Token

. count Size
while count < amount && !source-complete
    . item = source()
    if !item
        source-complete = true
        break
    reserve-tokens(1)
    buffer[length] = item
    length += 1
    count += 1
if count
    //grammar.refills ++

────────────────────
_ do refill-from-bytes
    - amount Size
    - source ByteReadable

if !source-complete
    . refill-size = (if amount > chunk-size then amount else chunk-size)
    . encoded-chars = Token == Char && source.is-encoded
    . request = if encoded-chars then refill-size else refill-size * Token.size
    . decoded-count Size
    while decoded-count == 0 && !source-complete
        if raw-buffer.size < fraction-length + request
            raw-buffer = Byte[token-buffer-capacity(fraction-length + request)]
        if fraction-length
            raw-buffer[0 .. < fraction-length] = fraction-buffer[0 .. < fraction-length]
        . bytes-read = source.read(request, raw-buffer[fraction-length ...])
            catch err Error
                do
                    failure = err
                0
        . bytes-available = fraction-length + bytes-read
        fraction-length = 0
        if bytes-read == 0
            source-complete = true
        if bytes-available == 0
            break

        . bytes-decoded Size
        if encoded-chars
            . bytes-decodable = bytes-available
            if !source-complete
                bytes-decodable = utf8-decodable-prefix-size(raw-buffer, bytes-available)
            reserve-tokens(bytes-decodable)
            decoded-count, bytes-decoded = decode-utf8-buffer(raw-buffer, bytes-decodable, buffer[length ...])
        else
            bytes-decoded = bytes-available - bytes-available % Token.size
            decoded-count = bytes-decoded / Token.size
            if decoded-count
                reserve-tokens(decoded-count)
                decode-binary(raw-buffer, bytes-decoded, buffer[length ...])
        . bytes-left = bytes-available - bytes-decoded
        if bytes-left
            fraction-buffer[0 .. < bytes-left] = raw-buffer[bytes-decoded .. < bytes-available]
            fraction-length = bytes-left

    if decoded-count
        length += decoded-count
        //grammar.refills ++

────────────────────
+ do to Iterable''Item
    - Item = Token as Item

while true
    . next = read'Item()
    if next
        <= next as Item
    else
        break

────────────────────
+ to Iterable'String

this /split/ "\n"

────────────────────
+ do to Iterable'(Token[])

. buffer = Token[chunk-size]
while 1
    . actual = read(buffer.size, buffer)
    if actual > 0
        <= buffer[0 .. < actual]
    else
        break

────────────────────
+ do preload
    - size Size

while cursor + size > length && !source-complete
    . old-length = length
    refill(cursor + size - length)
    if old-length == length
        break

────────────────────
+ do require
    - receiver Token[]
    - size Size

. actual = read(receiver, size)
?! Panic("Unable to read $size bytes")
    if actual != size
= receiver

────────────────────
+ do require
    - size Size

= require(Token[size], size)

────────────────────
+ do require'Value Value

. value = read'Value()
?! Panic("Unable to read value")
    if !value
= value

────────────────────
+ do require'Value Value
    - endian Endian
    - Value is Number

. value = read'Value(endian)
?! Panic("Unable to read value")
    if !value
= value

────────────────────
+ do read
    - size Size

. buf = Token[size]
. actual = read(buf)
= buf[0 .. < actual]

────────────────────
+ do read Size
    - receiver Token[]

= read(receiver.size, receiver) • should read-once

────────────────────
+ do read'Num
    - endian = .big
    - Num is Number

ensure-buffer(Num.size)

. count = read(Num.size, read-buffer)
if count == Num.size
    if Token == Byte
        = (read-buffer as Byte[]).read'Num(0, endian)!

    . bytes = Byte[Num.size]
    for i in 0 .. < Num.size
        bytes[i] = read-buffer[i] as Byte
    = bytes.read'Num(0, endian)!

────────────────────
+ do read

. result = Token[0]
. head = result
. total = 0
. was-pinned = pinned
pinned = true

while has-more
    . old-size = result.size
    . new-size = old-size + (if old-size > chunk-size then old-size else chunk-size)
    result = result.resize(new-size)
    head = result[old-size .. < new-size]

    . actual = read(head.size, head)
    if actual == 0
        break

    total += actual

pinned = was-pinned

?! failure
    if failure
= result[0 .. < total]

────────────────────
+ do read String? ?! Error
    - terminal String
    - limit = Size.max

. expected = terminal.length
. multiple = (if grown > chunk-size then grown else chunk-size)
.. grown = token-buffer-capacity(expected) * 2
. buf = Token[0]
. cursor = 0
. read-count = 0

while 1
    ?! SizeLimitError()
        if cursor > limit

    if cursor + expected > read-count
        if read-count == buf.size
            buf = buf.grow(if buf.size > multiple then buf.size else multiple)
        . read-buf = buf[read-count .. < buf.size]
        . actual Size = read(read-buf)
        if actual == 0
            break
        read-count += actual
    else
        . found = true
        for i in 0 .. < expected
            if buf[cursor + i] != terminal[i]
                found = false
                break

        if found
            this.cursor -= read-count - cursor - expected
            = buf.slice-string(0 .. < cursor)

        cursor += 1

?! failure
    if failure
=? null if read-count == 0
= buf.slice-string(0 .. < read-count)

────────────────────
+ do read String?
    - during Predicate'Token

. multiple = chunk-size
. is-done = false
. buf = Token[0]
. cursor = 0
. read-count = 0

while 1
    if is-done
        cursor = read-count
        break
    else
        if read-count == buf.size
            buf = buf.grow(multiple)
        . read-buf = buf[read-count .. < buf.size]
        . actual =
            |? is-done
                0
            ??
                read(read-buf)
        read-count += actual
        is-done = actual == 0

    . found = false
    for i in cursor .. < read-count
        . c = buf[i]
        if !during(c)
            found = true
            break
        else
            cursor += 1

    if found
        if cursor < read-count
            . extras = buf[cursor .. < read-count]
            this.cursor -= extras.length

        = buf.slice-string(0 .. < cursor)

?! failure!
    if failure
if cursor > 0
    = buf.slice-string(0 .. < cursor)

────────────────────
+ do split
    - delimiter String

while 1
    . item = read(delimiter)
    if item
        <= item
    else
        break


────────────────────
_ do ensure-buffer
    - size Size

if read-buffer.size < size
    read-buffer = read-buffer.resize(size)

────────────────────
_ do decode-binary
    - data Byte[]
    - size Size
    - output Token[]

. count = size / Token.size
output[0 .. < count] = Array'Token(data.data as CPointer'Token, count)

────────────────────
_ utf8-sequence-size Size
    - byte Byte

|? (byte /and/ 128u8) == 0u8
    1
|? (byte /and/ 224u8) == 192u8 && byte >= 194u8
    2
|? (byte /and/ 240u8) == 224u8
    3
|? (byte /and/ 248u8) == 240u8 && byte <= 244u8
    4
??
    0

────────────────────
_ do utf8-trailing-partial-size Size
    - data Byte[]
    - size Size

if size == 0
    = 0

. start = size - 1
while start > 0 && utf8-is-continuation(data[start])
    start -= 1

. available = size - start
. expected = utf8-sequence-size(data[start])

if expected > available && expected > 0
    for i in start + 1 .. < size
        if !utf8-is-continuation(data[i])
            = 0
    = available

= 0

────────────────────
_ utf8-decodable-prefix-size Size
    - data Byte[]
    - size Size

size - trailing

.. trailing = utf8-trailing-partial-size(data, size)

━━━━━━━━━━━━━━━━━━━━
_ token-buffer-capacity'Num
    - n Num

if shift == bit-width then (0 as Num) else (1 as Num) /lshift/ shift

.. shift = bit-width - count-leading-zeros((n - 1) as Num)
.. bit-width = (type-of n).size * 8

━━━━━━━━━━━━━━━━━━━━
_ is-code Bool
    - item Char
    - code U32

(item as U32) == code

━━━━━━━━━━━━━━━━━━━━
_ is-code Bool
    - item Byte
    - code U32

item == code

━━━━━━━━━━━━━━━━━━━━
_ is-code'Item Bool
    - item Item
    - code U32

false
