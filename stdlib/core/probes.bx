(import ./array-builder)
(import ./intrinsics)
(import ./number)
(import ./string)
(import /BxCore/BxCore.h)
(import /BxCore/BxProbe.h)
(import /BxEvents/BxEvents.h)
(import /stdlib.h)
(import /string.h)
(blank)
(prop _ probe-segment-table-capacity Size)
(prop _ probe-default-segment-size _ (= 67108864))
(prop _ probe-default-segment-pool _ (= 2))
(prop _ probe-default-segment-table-capacity _ (= 65536))
(prop _ probe-default-task-buffer-size _ (= 65536))
(prop _ probe-default-flush-threshold _ (= 16384))
(prop _ probe-default-flush-interval-ms _ (= 16))
(prop _ probe-head-size Size (= 25))
(prop _ probe-group-tail-size Size (= 5))
(prop _ probe-task-buffer-size _ (= 65536))
(prop _ probe-flush-threshold _ (= 16384))
(prop _ probe-segment-size Size (= 67108864))
(prop _ probe-flush-interval-ns U64 (= 16000000u64))
(prop _ probe-latest-time-ns U64 @task)
(prop _ probe-inspecting _ (= false))
(prop _ probe-live-object-limit Size (= 1024))
(prop _ probe-live-array-limit Size (= 1024))
(prop _ probe-live-floor Size (= 1024))
(prop _ stack _ @task (= (call (of ArrayBuilder ProbeFrame))))
(prop _ top-object-uid U32 @task (= 0))
(prop _ top-class-type U16 @task (= 0))
(prop _ probe-profile-metric-count Size (= 0))
(prop _ probe-buffer _ @thread (= ([] Byte 65536)))
(prop _ probe-buffer-length Size @thread)
(prop _ probe-next-flush-ns U64 @thread)
(prop _ probe-control-is-polling _ @thread (= false))
(prop _ probe-control-buffer _ @thread (= ([] Byte 4096)))
(prop _ probe-control-safepoint-countdown Size @thread)
(prop _ probe-open-snapshots Size @thread)
(prop _ probe-control-buffer-size _ (= 4096))
(prop _ probe-control-safepoint-period Size (= 0x40))
(prop _ probe-control-magic U32 (= 0x49435059))
(prop _ probe-control-version U16 (= 1))
(prop _ probe-control-header-size Size (= 16))
(prop _ probe-control-type-hello U16 (= 1))
(prop _ probe-control-type-inspect U16 (= 2))
(prop _ probe-control-type-cancel U16 (= 3))
(prop _ probe-control-type-ack U16 (= 4))
(prop _ probe-control-type-done U16 (= 5))
(prop _ probe-control-type-error U16 (= 6))
(prop _ probe-control-status-accepted U32 (= 1))
(prop _ probe-control-status-rejected U32 (= 2))
(prop _ probe-control-status-done U32 (= 3))
(prop _ probe-control-status-unavailable U32 (= 4))
(prop _ probe-control-status-canceled U32 (= 5))
(prop _ probe-control-status-budgeted U32 (= 6))
(prop _ probe-control-status-error U32 (= 7))
(prop _ probe-live-objects _ (= (call (of Map ProbeUID ProbeLiveEntry))))
(prop _ probe-live-object-ids _ (= (call (of ArrayBuilder ProbeUID))))
(prop _ probe-live-arrays _ (= (call (of Map ProbeArrayKey ProbeLiveEntry))))
(prop _ probe-live-array-keys _ (= (call (of ArrayBuilder ProbeArrayKey))))
(blank)
(type-line + ProbeId (is U16))
(type-line + ProbeUID (is U32))
(type-line + ProbeClassId (is U16))
(type-line + ProbeProfileMetricId (is U16))
(type-line _ ProbeControlInspect (is (tuple (: request-id U32) (: object-id ProbeUID) (: type-id ProbeClassId) (: facet String) (: depth U32) (: offset U32) (: limit U32) (: flags U32))))
(type-line _ ProbeLiveEntry (is (tuple (: uid ProbeUID) (: class-type ProbeClassId) (: live ProbeLive))))
(type-line _ ProbeFrame (is (tuple (: uid U32) (: class-type U16))))

(fn-do + probe-log _ (without probe-safepoints)
  (param text String)
  (call probe-buffer-write (. ProbeType system-log))
  (call (of probe-buffer-write U32) (as (. text size) U32))
  (call probe-buffer-write text)
  (blank)
  (call probe-flush)
)

(fn-do + probe-task-flush _ (without probe-safepoints)
  (call probe-control-poll)
  (call probe-flush)
)

(type _ ProbeType (is U8)
  (variant done (= 0))
  (variant declare-log (= 1))
  (variant declare-event (= 2))
  (variant declare-property (= 3))
  (variant declare-type (= 4))
  (variant system-log (= 5))
  (variant log (= 6))
  (variant event (= 7))
  (variant snapshot (= 8))
  (variant declare-log2 (= 9))
  (variant declare-key (= 10))
  (variant declare-counter (= 11))
  (variant counter (= 12))
  (variant declare-profile-metric (= 13))
  (variant profile-metric (= 14))
)

(type _ ProbeDataType (is U8)
  (variant none (= 0))
  (variant bool (= 1))
  (variant char (= 2))
  (variant int8 (= 3))
  (variant uint8 (= 4))
  (variant int16 (= 5))
  (variant uint16 (= 6))
  (variant int32 (= 7))
  (variant uint32 (= 8))
  (variant int64 (= 9))
  (variant uint64 (= 10))
  (variant float32 (= 11))
  (variant float64 (= 12))
  (variant string (= 13))
  (variant array (= 14))
  (variant object (= 15))
  (variant group (= 16))
)

(type _ ProbeArrayKey (is Tuple)
  (implements Hashable)
  (prop + address U64)
  (prop + length Size)
  (prop + class-type ProbeClassId)
  (fn-expr + hash Hash :get
    (call hash-for (/xor/ address (/lshift/ (as length U64) 40) (/lshift/ (as class-type U64) 24)))
  )
  (fn-expr + (infix this == (param other This)) _
    (and (== address (. other address)) (== length (. other length)) (== class-type (. other class-type)))
  )
)

(type _ ProbeLive (is Interface)
  (fn-do + is-alive Bool)
  (fn-do + is-kept Bool)
  (fn-do + target (? Inspectable))
)

(type _ (of ProbeLiveObject T)
  (constraint is T Inspectable)
  (implements ProbeLive)
  (prop _ token U64 (= 0))
  (fn-do + This _
    (param object T)
    (= token (call C:brixGCRegisterOwnerWeak (as this Pointer) (as object Pointer)))
  )
  (fn-expr + is-alive Bool
    (!= pointer null)
    (where
      (lazy pointer (call C:brixGCOwnerWeakLoad token))
    )
  )
  (fn-expr + is-kept Bool
    (call is-alive)
  )
  (fn-do + target (? Inspectable)
    (let pointer (call C:brixGCOwnerWeakLoad token))
    (return-if (if (not pointer)))
    (return (call (of gc-object-from-pointer T) pointer))
  )
)

(type _ (of ProbeLiveArray T)
  (implements ProbeLive)
  (prop _ token U64 (= 0))
  (prop _ address U64)
  (prop _ length Size)
  (fn-do + This _
    (param array (of Array T))
    (= address (. array data address))
    (= length (. array length))
    (= token (call C:brixGCRegisterOwnerWeak (as this Pointer) (as (. array data) Pointer)))
  )
  (fn-expr + is-alive Bool
    (or (not token) (!= pointer null))
    (where
      (lazy pointer (call C:brixGCOwnerWeakLoad token))
    )
  )
  (fn-expr + is-kept Bool
    (and (!= token 0) (call is-alive))
  )
  (fn-do + target (? Inspectable)
    (return-if (if (and token (not (call C:brixGCOwnerWeakLoad token)))))
    (return (call (of Array T) (as address (of CPointer T)) length))
  )
)

(fn-do _ probe-env-size _ (without probe-safepoints)
  (param name String)
  (param default-value Size)
  (let value (call C:getenv name))
  (if value
    (let parsed (as (call C:strtoull value null 10) Size))
    (if (> parsed 0)
      (return parsed)
    )
  )
  (blank)
  (return default-value)
)

(fn-do _ probe-buffer-reset _ (without probe-safepoints)
  (= probe-buffer-length 0)
  (= probe-next-flush-ns 0)
)

(fn-do _ probe-buffer-ensure _ (without probe-safepoints suspend)
  (param required Size)
  (return-if (if (<= required (. probe-buffer size))))
  (blank)
  (let next-size (. probe-buffer size))
  (if (< next-size probe-task-buffer-size)
    (= next-size probe-task-buffer-size)
  )
  (if (< next-size 1)
    (= next-size 1)
  )
  (while (< next-size required)
    (*= next-size 2)
  )
  (blank)
  (= probe-buffer (call (. probe-buffer resize) next-size))
)

(fn-do _ probe-buffer-reserve Size (without probe-safepoints suspend)
  (param size Size)
  (let offset probe-buffer-length)
  (let required (+ offset size))
  (call probe-buffer-ensure required)
  (= probe-buffer-length required)
  (if (not probe-next-flush-ns)
    (= probe-next-flush-ns (+ (call C:brixProbeNowNs) probe-flush-interval-ns))
  )
  (return offset)
)

(fn-do _ probe-buffer-write Size (without probe-safepoints suspend)
  (param data (of CPointer Byte))
  (param size Size)
  (return-if size (if (not size)))
  (blank)
  (let offset (call probe-buffer-reserve size))
  (call C:memcpy (+ (. probe-buffer data) offset) data size)
  (return size)
)

(fn-expr _ probe-buffer-write _ (without probe-safepoints suspend)
  (param data ([] Byte))
  (call probe-buffer-write (. data data) (. data size))
)

(fn-expr _ (of probe-buffer-write T) _ (without probe-safepoints suspend)
  (param data (of Array T))
  (call probe-buffer-write (as (. data data) (of CPointer Byte)) (. data byte-size))
)

(fn-expr _ probe-buffer-write _ (without probe-safepoints suspend)
  (param data String)
  (call probe-buffer-write (as data (of CPointer Byte)) (. data size))
)

(fn-do _ (of probe-buffer-write Num) Size (without probe-safepoints suspend)
  (param data Num)
  (constraint is Num Number)
  (let offset (call probe-buffer-reserve (. Num size)))
  (call (of (. probe-buffer write) Num) data offset .little)
  (return (. Num size))
)

(fn-do _ probe-write-head Size (without probe-safepoints suspend)
  (param probe-type ProbeType)
  (param probe-id U16)
  (param object-id ProbeUID)
  (param class-type ProbeClassId)
  (param tail-size Size (= 0))
  (let now (call C:brixProbeNowNs))
  (= probe-latest-time-ns now)
  (let offset (call probe-buffer-reserve (+ probe-head-size tail-size)))
  (call (of (. probe-buffer write) U8) probe-type offset .little)
  (call (of (. probe-buffer write) U16) probe-id (+ offset 1) .little)
  (call (of (. probe-buffer write) U32) object-id (+ offset 3) .little)
  (call (of (. probe-buffer write) U16) class-type (+ offset 7) .little)
  (call (of (. probe-buffer write) U64) (/ now 1000000000u64) (+ offset 9) .little)
  (call (of (. probe-buffer write) U64) (% now 1000000000u64) (+ offset 17) .little)
  (return (+ offset probe-head-size))
)

(fn-do _ probe-write-group Size (without probe-safepoints suspend)
  (param probe-type ProbeType)
  (param probe-id U16)
  (param object-id ProbeUID)
  (param class-type ProbeClassId)
  (param group-id ProbeUID)
  (let offset (call probe-write-head probe-type probe-id object-id class-type probe-group-tail-size))
  (call (of (. probe-buffer write) U32) group-id offset .little)
  (call (of (. probe-buffer write) U8) (. ProbeType done) (+ offset 4) .little)
  (return (+ probe-head-size probe-group-tail-size))
)

(fn-do _ get-probes-path _ (without probe-safepoints)
  (let probes (call C:getenv "PROBES_ENABLED"))
  (if probes
    (let text (as probes String))
    (if (> (. text size) 0)
      (return (call C:getenv "PROBES_PATH"))
    )
  )
)

(fn-do _ probes-begin _ (without probe-safepoints)
  (call C:brixProbeCounterSetup 0)
  (= probe-profile-metric-count 0)
  (let probes-path (call get-probes-path))
  (if probes-path
    (call probes-open probes-path)
    (call C:brixRequestTerminationOnSignals)
    (let control-path (call C:getenv "PROBES_CONTROL_PATH"))
    (if control-path
      (= probe-inspecting (call C:brixProbeControlOpen control-path ""))
    )
  )
)

(fn-do _ probes-end _ (without probe-safepoints)
  (call probe-profile-flush)
  (call probe-counter-flush)
  (call probe-control-close)
  (call probes-close)
)

(fn-do _ probes-open _ (without probe-safepoints)
  (param probes-path String)
  (= probe-segment-size (call probe-env-size "PROBES_SEGMENT_SIZE" probe-default-segment-size))
  (= probe-task-buffer-size (call probe-env-size "PROBES_TASK_BUFFER_SIZE" probe-default-task-buffer-size))
  (= probe-flush-threshold (call probe-env-size "PROBES_FLUSH_THRESHOLD" probe-default-flush-threshold))
  (if (> probe-flush-threshold probe-task-buffer-size)
    (= probe-flush-threshold probe-task-buffer-size)
  )
  (= probe-flush-interval-ns (* (as (call probe-env-size "PROBES_FLUSH_INTERVAL_MS" probe-default-flush-interval-ms) U64) 1000000u64))
  (let segment-pool (call probe-env-size "PROBES_SEGMENT_POOL" probe-default-segment-pool))
  (if (< segment-pool 1)
    (= segment-pool 1)
  )
  (= probe-segment-table-capacity
    (call probe-env-size
      (block
        (arg "PROBES_SEGMENT_TABLE_CAPACITY")
        (arg probe-default-segment-table-capacity)
      )
    )
  )
  (if (< probe-segment-table-capacity segment-pool)
    (= probe-segment-table-capacity segment-pool)
  )
  (blank)
  (let did-open
    (call C:brixProbeOpen
      (block
        (arg probes-path)
        (arg probe-segment-size)
        (arg segment-pool)
        (arg probe-task-buffer-size)
        (arg probe-flush-threshold)
        (arg probe-flush-interval-ns)
        (arg probe-segment-table-capacity)
      )
    )
  )
  (if (not did-open)
    (throw (call IOError "Unable to open probe log"))
  )
  (blank)
  (= probe-task-buffer-size (as (call C:brixProbeTaskBufferSize) I64))
  (= probe-flush-threshold (as (call C:brixProbeFlushThreshold) I64))
  (= probe-flush-interval-ns (call C:brixProbeFlushIntervalNs))
  (call probe-buffer-reset)
)

(fn-do _ probe-declare-log _ (without probe-safepoints)
  (param id U16)
  (param name String)
  (param template String)
  (param type-count U32)
  (call (of probe-buffer-write U8) (. ProbeType declare-log))
  (call (of probe-buffer-write U16) id)
  (call (of probe-buffer-write U32) (as (. name size) U32))
  (if (. name size)
    (call probe-buffer-write name)
  )
  (call (of probe-buffer-write U32) (as (. template size) U32))
  (call probe-buffer-write template)
  (call (of probe-buffer-write U32) type-count)
)

(fn-do _ probe-declare-key _ (without probe-safepoints)
  (param key String)
  (call (of probe-buffer-write U8) (. ProbeType declare-key))
  (call (of probe-buffer-write U32) (as (. key size) U32))
  (call probe-buffer-write key)
)

(fn-do _ probe-declare-log2 _ (without probe-safepoints)
  (param id U16)
  (param key String)
  (param name String)
  (param template String)
  (param module-name String)
  (param source-path String)
  (param line U32)
  (param type-count U32)
  (call (of probe-buffer-write U8) (. ProbeType declare-log2))
  (call (of probe-buffer-write U16) id)
  (call (of probe-buffer-write U32) (as (. key size) U32))
  (call probe-buffer-write key)
  (call (of probe-buffer-write U32) (as (. name size) U32))
  (if (. name size)
    (call probe-buffer-write name)
  )
  (call (of probe-buffer-write U32) (as (. template size) U32))
  (call probe-buffer-write template)
  (call (of probe-buffer-write U32) (as (. module-name size) U32))
  (call probe-buffer-write module-name)
  (call (of probe-buffer-write U32) (as (. source-path size) U32))
  (call probe-buffer-write source-path)
  (call (of probe-buffer-write U32) line)
  (call (of probe-buffer-write U32) type-count)
)

(fn-do _ probe-declare-event _ (without probe-safepoints)
  (param id U16)
  (param key String)
  (param name String)
  (param module-name String)
  (param type-count U32)
  (call (of probe-buffer-write U8) (. ProbeType declare-event))
  (call (of probe-buffer-write U16) id)
  (call (of probe-buffer-write U32) (as (. key size) U32))
  (call probe-buffer-write key)
  (call (of probe-buffer-write U32) (as (. name size) U32))
  (call probe-buffer-write name)
  (call (of probe-buffer-write U32) (as (. module-name size) U32))
  (call probe-buffer-write module-name)
  (call (of probe-buffer-write U32) type-count)
)

(fn-do _ probe-declare-counter _ (without probe-safepoints)
  (param id U16)
  (param key String)
  (param module-name String)
  (param source-path String)
  (param line U32)
  (call C:brixProbeCounterEnsure (+ (as id Size) 1))
  (call (of probe-buffer-write U8) (. ProbeType declare-counter))
  (call (of probe-buffer-write U16) id)
  (call (of probe-buffer-write U32) (as (. key size) U32))
  (call probe-buffer-write key)
  (call (of probe-buffer-write U32) (as (. module-name size) U32))
  (call probe-buffer-write module-name)
  (call (of probe-buffer-write U32) (as (. source-path size) U32))
  (call probe-buffer-write source-path)
  (call (of probe-buffer-write U32) line)
)

(fn-do _ probe-declare-type _ (without probe-safepoints)
  (param id U16)
  (param name String)
  (call (of probe-buffer-write U8) (. ProbeType declare-type))
  (call (of probe-buffer-write U16) id)
  (call (of probe-buffer-write U32) (as (. name size) U32))
  (call probe-buffer-write name)
)

(fn-do _ probe-declare-argument _ (without probe-safepoints)
  (param type ProbeType)
  (param class-type ProbeClassId)
  (call (of probe-buffer-write U8) type)
  (call probe-buffer-write class-type)
)

(fn-do _ probes-ready _ (without probe-safepoints)
  (call (of probe-buffer-write U8) (. ProbeType done))
  (call probe-flush)
)

(fn-do _ probe-counter-setup _ (without probe-safepoints)
  (param max-id Size)
  (call C:brixProbeCounterSetup (+ max-id 1))
)

(fn-do _ probe-counter-add _ (without probe-safepoints)
  (param id ProbeId)
  (param delta U64)
  (call C:brixProbeCounterAdd id delta)
)

(fn-do _ probe-gc-counter-flush _ (without probe-safepoints)
  (param cycles-id ProbeId)
  (param pauses-id ProbeId)
  (param assist-nanos-id ProbeId)
  (if cycles-id
    (call probe-counter-add cycles-id (as (call C:brixGCCollectionCount) U64))
  )
  (if pauses-id
    (call probe-counter-add pauses-id (as (call C:brixGCPauseCount) U64))
  )
  (if assist-nanos-id
    (call probe-counter-add assist-nanos-id (as (call C:brixGCAssistTimeNanos) U64))
  )
)

(fn-do _ probe-profile-setup _ (without probe-safepoints)
  (param metric-count Size)
  (= probe-profile-metric-count metric-count)
  (call C:brixProbeProfileSetup metric-count)
)

(fn-do _ probe-declare-profile-metric _ (without probe-safepoints)
  (param id ProbeProfileMetricId)
  (param key String)
  (param kind U8)
  (param module-name String)
  (param source-path String)
  (param line U32)
  (param object-type ProbeClassId)
  (call (of probe-buffer-write U8) (. ProbeType declare-profile-metric))
  (call (of probe-buffer-write U16) id)
  (call (of probe-buffer-write U8) kind)
  (call (of probe-buffer-write U32) (as (. key size) U32))
  (call probe-buffer-write key)
  (call (of probe-buffer-write U32) (as (. module-name size) U32))
  (call probe-buffer-write module-name)
  (call (of probe-buffer-write U32) (as (. source-path size) U32))
  (call probe-buffer-write source-path)
  (call (of probe-buffer-write U32) line)
  (call (of probe-buffer-write U16) object-type)
)

(fn-expr _ probe-profile-now-ns U64 (without probe-safepoints)
  (call C:brixProbeMonotonicNowNs)
)

(fn-do _ probe-profile-flush _ (without probe-safepoints)
  (return-if (if (not probe-profile-metric-count)))
  (blank)
  (let now (call probe-profile-now-ns))
  (let profile-limit (+ probe-profile-metric-count 1))
  (blank)
  (for (in id (..< 1 profile-limit))
    (let value (call C:brixProbeProfileCounterValue (as id ProbeProfileMetricId)))
    (if value
      (call (of probe-buffer-write U8) (. ProbeType profile-metric))
      (call (of probe-buffer-write U16) (as id ProbeProfileMetricId))
      (call (of probe-buffer-write U8) 1)
      (call (of probe-buffer-write U64) value)
      (call (of probe-buffer-write U64) 0u64)
      (call (of probe-buffer-write U64) 0u64)
      (call (of probe-buffer-write U64) 0u64)
      (call (of probe-buffer-write U8) (. ProbeType done))
    )
  )
  (blank)
  (let timer ([] U64 4))
  (for (in id (..< 1 profile-limit))
    (let profile-id (as id ProbeProfileMetricId))
    (call C:brixProbeProfileTimerRead profile-id now (. timer data))
    (if (or ([] timer 0) ([] timer 2))
      (call (of probe-buffer-write U8) (. ProbeType profile-metric))
      (call (of probe-buffer-write U16) profile-id)
      (call (of probe-buffer-write U8) 2)
      (call (of probe-buffer-write U64) ([] timer 0))
      (call (of probe-buffer-write U64) ([] timer 1))
      (call (of probe-buffer-write U64) ([] timer 2))
      (call (of probe-buffer-write U64) ([] timer 3))
      (call (of probe-buffer-write U8) (. ProbeType done))
    )
  )
  (blank)
  (call probe-flush)
)

(fn-do _ (of probe-object-uid T) ProbeUID (without probe-safepoints suspend)
  (param object (of Array T))
  (param class-type ProbeClassId)
  (let key (call ProbeArrayKey (. object data address) (. object length) class-type))
  (call probe-live-lock)
  (finally
    (inline (call C:brixProbeLiveUnlock))
  )
  (let found ([] probe-live-arrays key))
  (return-if (. found uid) (if (and found (call (. found live is-alive)))))
  (blank)
  (if (not found)
    (call (. probe-live-array-keys append) key)
  )
  (let entry (call ProbeLiveEntry (call C:brixGenerateUID) class-type (call (of ProbeLiveArray T) object)))
  (= ([] probe-live-arrays key) entry)
  (if probe-inspecting
    (= ([] probe-live-objects (. entry uid)) entry)
    (call (. probe-live-object-ids append) (. entry uid))
  )
  (call probe-live-prune)
  (return (. entry uid))
)

(fn-do _ (of probe-object-uid T) ProbeUID (without probe-safepoints suspend)
  (param object T)
  (param class-type ProbeClassId)
  (constraint is T Inspectable)
  (let uid (. object uid))
  (if probe-inspecting
    (call probe-live-register uid class-type object)
  )
  (return uid)
)

(fn-expr _ (of probe-object-uid T) ProbeUID (without probe-safepoints suspend)
  (param object T)
  (param class-type ProbeClassId)
  (. object uid)
)

(fn-do _ (of probe-object-counter-add T) _ (without probe-safepoints)
  (param id ProbeId)
  (param object T)
  (param class-type ProbeClassId)
  (param delta U64)
  (constraint is T Inspectable)
  (call C:brixProbeObjectCounterAdd id (call probe-object-uid object class-type) class-type delta)
)

(fn-do _ (of probe-object-counter-add T) _ (without probe-safepoints)
  (param id ProbeId)
  (param object T)
  (param class-type ProbeClassId)
  (param delta U64)
  (call C:brixProbeObjectCounterAdd id (call probe-object-uid object class-type) class-type delta)
)

(fn-do _ probe-counter-flush _ (without probe-safepoints)
  (let counter-count (call C:brixProbeCounterCount))
  (if (> counter-count 1)
    (for (in id (..< 1 counter-count))
      (let counter-id (as id ProbeId))
      (let value (call C:brixProbeCounterValue counter-id))
      (if (or value (call C:brixProbeCounterTouched counter-id))
        (call (of probe-buffer-write U8) (. ProbeType counter))
        (call (of probe-buffer-write U16) counter-id)
        (call (of probe-buffer-write U32) 0)
        (call (of probe-buffer-write U16) 0)
        (call (of probe-buffer-write U64) value)
        (call (of probe-buffer-write U8) (. ProbeType done))
      )
    )
  )
  (blank)
  (let object-counter-count (call C:brixProbeObjectCounterCollect))
  (for (in index (..< 0 object-counter-count))
    (let value (call C:brixProbeObjectCounterValue index))
    (if value
      (call (of probe-buffer-write U8) (. ProbeType counter))
      (call (of probe-buffer-write U16) (call C:brixProbeObjectCounterId index))
      (call (of probe-buffer-write U32) (call C:brixProbeObjectCounterObjectId index))
      (call (of probe-buffer-write U16) (call C:brixProbeObjectCounterClassType index))
      (call (of probe-buffer-write U64) value)
      (call (of probe-buffer-write U8) (. ProbeType done))
    )
  )
  (blank)
  (call probe-flush)
)

(fn-do _ probes-close _ (without probe-safepoints)
  (call C:brixProbeClose)
)

(fn-do _ probe-control-close _ (without probe-safepoints)
  (= probe-inspecting false)
  (call C:brixProbeControlClose)
)

(fn-expr _ probe-control-read-u16 _ (without probe-safepoints)
  (param data ([] Byte))
  (param offset Size)
  (!! (call (of (. data read) U16) offset .little))
)

(fn-expr _ probe-control-read-u32 _ (without probe-safepoints)
  (param data ([] Byte))
  (param offset Size)
  (!! (call (of (. data read) U32) offset .little))
)

(fn-do _ probe-control-write-u16 _ (without probe-safepoints)
  (param data ([] Byte))
  (param offset Size)
  (param value U16)
  (call (of (. data write) U16) value offset .little)
)

(fn-do _ probe-control-write-u32 _ (without probe-safepoints)
  (param data ([] Byte))
  (param offset Size)
  (param value U32)
  (call (of (. data write) U32) value offset .little)
)

(fn-do _ probe-control-write-status _ (without probe-safepoints)
  (param frame-type U16)
  (param request-id U32)
  (param status U32)
  (param message String (= ""))
  (let message-bytes (call byte-view message))
  (let payload-size U32 (as (+ 8 (. message-bytes size)) U32))
  (let frame ([] Byte (+ probe-control-header-size payload-size)))
  (blank)
  (call probe-control-write-u32 frame 0 probe-control-magic)
  (call probe-control-write-u16 frame 4 probe-control-version)
  (call probe-control-write-u16 frame 6 frame-type)
  (call probe-control-write-u32 frame 8 request-id)
  (call probe-control-write-u32 frame 12 payload-size)
  (call probe-control-write-u32 frame 16 status)
  (call probe-control-write-u32 frame 20 (as (. message-bytes size) U32))
  (if (. message-bytes size)
    (= ([] frame (..< 24 (+ 24 (. message-bytes size)))) message-bytes)
  )
  (blank)
  (return (call C:brixProbeControlWrite (. frame data) (. frame size)))
)

(fn-do _ probe-control-inspection-log _ (without probe-safepoints)
  (param phase String)
  (param request ProbeControlInspect)
  (param status String)
  (param message String (= ""))
  (call probe-log
    (block
      (arg
        (paragraph
          (str "probe.inspect " phase " requestId=" (. request request-id) " objectId=" (. request object-id) " typeId=" (. request type-id) " facet=" (. request facet) " status=" status message-text)
        )
      )
    )
  )
  (blank)
  (lazy message-text (if-expr (> (. message size) 0) (str " message=" message) ""))
)

(fn-do _ (of probe-live-register T) _ (without probe-safepoints suspend)
  (param uid ProbeUID)
  (param class-type ProbeClassId)
  (param object T)
  (constraint is T Inspectable)
  (call probe-live-lock)
  (finally
    (inline (call C:brixProbeLiveUnlock))
  )
  (return-if (if (has probe-live-objects uid)))
  (blank)
  (= ([] probe-live-objects uid) (call ProbeLiveEntry uid class-type (call (of ProbeLiveObject T) object)))
  (call (. probe-live-object-ids append) uid)
  (call probe-live-prune)
)

(fn-do _ probe-live-entry (? ProbeLiveEntry) (without probe-safepoints suspend)
  (param uid ProbeUID)
  (call probe-live-lock)
  (finally
    (inline (call C:brixProbeLiveUnlock))
  )
  (return ([] probe-live-objects uid))
)

(fn-do _ probe-live-lock _ (without probe-safepoints)
  (if (not (call C:brixProbeLiveTryLock))
    (call C:brixProbeLiveLock)
  )
)

(fn-do _ probe-live-prune _ (without probe-safepoints suspend)
  (if (>= (as (. probe-live-arrays length) Size) probe-live-array-limit)
    (let kept-keys (call (of ArrayBuilder ProbeArrayKey)))
    (for (in key probe-live-array-keys)
      (let entry ([] probe-live-arrays key))
      (if (and entry (call (. entry live is-kept)))
        (call (. kept-keys append) key)
        (else
          (-= ([] probe-live-arrays key))
        )
      )
    )
    (= probe-live-array-keys kept-keys)
    (= probe-live-array-limit (if-expr (< (* (. kept-keys length) 2) probe-live-floor) probe-live-floor (* (. kept-keys length) 2)))
  )
  (blank)
  (if (>= (as (. probe-live-objects length) Size) probe-live-object-limit)
    (let kept-ids (call (of ArrayBuilder ProbeUID)))
    (for (in uid probe-live-object-ids)
      (let entry ([] probe-live-objects uid))
      (if (and entry (call (. entry live is-kept)))
        (call (. kept-ids append) uid)
        (else
          (-= ([] probe-live-objects uid))
        )
      )
    )
    (= probe-live-object-ids kept-ids)
    (= probe-live-object-limit (if-expr (< (* (. kept-ids length) 2) probe-live-floor) probe-live-floor (* (. kept-ids length) 2)))
  )
)

(fn-do _ probe-control-handle-inspect _ (without probe-safepoints)
  (param request ProbeControlInspect)
  (if (!= (/and/ (. request flags) 1) 0)
    (call probe-control-inspection-log "begin" request "error")
    (call probe-control-inspection-log "end" request "error" "subscribe-unsupported")
    (call probe-control-write-status
      (block
        (arg probe-control-type-error)
        (arg (. request request-id))
        (arg probe-control-status-rejected)
        (arg "subscribe-unsupported")
      )
    )
    (return)
  )
  (let entry (call probe-live-entry (. request object-id)))
  (let target (only-if (call (. entry live target)) (if entry)))
  (let actual-type (if-expr entry (. entry class-type) (. request type-id)))
  (blank)
  (if (not target)
    (call probe-control-inspection-log "begin" request "unavailable")
    (call probe-control-inspection-log "end" request "unavailable" "unknown-object")
    (call probe-control-write-status
      (block
        (arg probe-control-type-error)
        (arg (. request request-id))
        (arg probe-control-status-unavailable)
        (arg "unknown-object")
      )
    )
    (return)
  )
  (if (and (. request type-id) actual-type (!= (. request type-id) actual-type))
    (call probe-control-inspection-log "begin" request "unavailable")
    (call probe-control-inspection-log "end" request "unavailable" "wrong-type")
    (call probe-control-write-status
      (block
        (arg probe-control-type-error)
        (arg (. request request-id))
        (arg probe-control-status-unavailable)
        (arg "wrong-type")
      )
    )
    (return)
  )
  (call probe-control-write-status
    (block
      (arg probe-control-type-ack)
      (arg (. request request-id))
      (arg probe-control-status-accepted)
    )
  )
  (call probe-control-inspection-log "begin" request "running")
  (blank)
  (call (. stack append) (call ProbeFrame (. request object-id) actual-type))
  (let previous-object top-object-uid)
  (let previous-type top-class-type)
  (= top-object-uid (. request object-id))
  (= top-class-type actual-type)
  (blank)
  (call (. target inspectable-inspect) (. request facet) (. request depth) (. request offset) (. request limit))
  (blank)
  (call (. stack rewind) (- (. stack length) 1))
  (= top-object-uid previous-object)
  (= top-class-type previous-type)
  (blank)
  (call probe-control-inspection-log "end" request "done")
  (call probe-control-write-status probe-control-type-done (. request request-id) probe-control-status-done)
  (call probe-flush)
)

(fn-do _ probe-control-handle-frame _ (without probe-safepoints)
  (param frame ([] Byte))
  (param frame-size Size)
  (return-if (if (< frame-size probe-control-header-size)))
  (blank)
  (let magic (call probe-control-read-u32 frame 0))
  (let version (call probe-control-read-u16 frame 4))
  (let frame-type (call probe-control-read-u16 frame 6))
  (let request-id (call probe-control-read-u32 frame 8))
  (let payload-size (call probe-control-read-u32 frame 12))
  (let payload-offset Size probe-control-header-size)
  (blank)
  (if (or (!= magic probe-control-magic) (!= version probe-control-version))
    (call probe-control-write-status
      (block
        (arg probe-control-type-error)
        (arg request-id)
        (arg probe-control-status-rejected)
        (arg "bad-frame")
      )
    )
    (return)
  )
  (if (== frame-type probe-control-type-hello)
    (call probe-control-write-status probe-control-type-ack request-id probe-control-status-accepted)
    (return)
  )
  (if (== frame-type probe-control-type-cancel)
    (call probe-control-write-status probe-control-type-done request-id probe-control-status-canceled)
    (return)
  )
  (if (!= frame-type probe-control-type-inspect)
    (call probe-control-write-status
      (block
        (arg probe-control-type-error)
        (arg request-id)
        (arg probe-control-status-rejected)
        (arg "unknown-command")
      )
    )
    (return)
  )
  (if (or (< payload-size 36) (< frame-size (+ payload-offset payload-size)))
    (call probe-control-write-status
      (block
        (arg probe-control-type-error)
        (arg request-id)
        (arg probe-control-status-rejected)
        (arg "bad-inspect")
      )
    )
    (return)
  )
  (let facet-length (call probe-control-read-u16 frame (+ payload-offset 6)))
  (if (< payload-size (+ 36 facet-length))
    (call probe-control-write-status
      (block
        (arg probe-control-type-error)
        (arg request-id)
        (arg probe-control-status-rejected)
        (arg "bad-facet")
      )
    )
    (return)
  )
  (let facet-start (+ payload-offset 36))
  (let facet String)
  (= facet (call (. ([] frame (..< facet-start (+ facet-start facet-length))) slice-string)))
  (let request
    (call ProbeControlInspect request-id object-id type-id facet depth offset limit flags
      (block
        (lazy object-id (call probe-control-read-u32 frame payload-offset))
        (lazy type-id (call probe-control-read-u16 frame (+ payload-offset 4)))
        (lazy depth (call probe-control-read-u32 frame (+ payload-offset 8)))
        (lazy offset (call probe-control-read-u32 frame (+ payload-offset 12)))
        (lazy limit (call probe-control-read-u32 frame (+ payload-offset 16)))
        (lazy flags (call probe-control-read-u32 frame (+ payload-offset 32)))
      )
    )
  )
  (blank)
  (call probe-control-handle-inspect request)
)

(fn-do _ probe-control-poll _ (without probe-safepoints suspend)
  (return-if (if (or probe-control-is-polling probe-open-snapshots)))
  (return-if (if (not (call C:brixProbeControlAvailable))))
  (blank)
  (= probe-control-is-polling true)
  (if (< (. probe-control-buffer size) probe-control-buffer-size)
    (= probe-control-buffer ([] Byte probe-control-buffer-size))
  )
  (while true
    (let frame-size (call C:brixProbeControlRead (. probe-control-buffer data) (. probe-control-buffer size)))
    (if (not frame-size)
      (break)
    )
    (call probe-control-handle-frame probe-control-buffer (as frame-size Size))
  )
  (blank)
  (= probe-control-is-polling false)
)

(fn-do _ probe-control-safepoint-poll _ (without probe-safepoints)
  (if probe-control-safepoint-countdown
    (-= probe-control-safepoint-countdown 1)
    (return)
  )
  (= probe-control-safepoint-countdown probe-control-safepoint-period)
  (call probe-control-poll)
)

(fn-do _ probe-flush _ (without probe-safepoints suspend)
  (return-if (if (or (not probe-buffer-length) probe-open-snapshots)))
  (blank)
  (let now-ns (call C:brixProbeNowNs))
  (call C:brixProbePublish (. probe-buffer data) probe-buffer-length now-ns)
  (= probe-buffer-length 0)
  (= probe-next-flush-ns (+ now-ns probe-flush-interval-ns))
)

(fn-do _ probe-flush-at-if-needed _ (without probe-safepoints suspend)
  (param buffer-length Size)
  (param now-ns U64)
  (if (and buffer-length (not probe-open-snapshots))
    (if (or (>= buffer-length probe-flush-threshold) (and probe-next-flush-ns is-due))
      (call C:brixProbePublish (. probe-buffer data) buffer-length now-ns)
      (= probe-buffer-length 0)
      (= probe-next-flush-ns (+ now-ns probe-flush-interval-ns))
    )
    (lazy is-due (>= now-ns probe-next-flush-ns))
  )
)

(fn-do _ probe-flush-if-needed _ (without probe-safepoints suspend)
  (let buffer-length probe-buffer-length)
  (if buffer-length
    (let now-ns probe-latest-time-ns)
    (if (not now-ns)
      (= now-ns (call C:brixProbeNowNs))
    )
    (blank)
    (call probe-flush-at-if-needed buffer-length now-ns)
  )
)

(fn-do _ probe-safepoint-flush-if-needed _ (without probe-safepoints)
  (call probe-control-safepoint-poll)
  (let buffer-length probe-buffer-length)
  (if buffer-length
    (call probe-flush-at-if-needed buffer-length (call C:brixProbeNowNs))
  )
)

(fn-do _ probe-group-push _ (without probe-safepoints suspend)
  (param probe-id U16)
  (let group-id (call C:brixGenerateUID))
  (call (. stack append) (call ProbeFrame group-id (. ProbeDataType group)))
  (let object-id top-object-uid)
  (let class-type top-class-type)
  (= top-object-uid group-id)
  (= top-class-type (. ProbeDataType group))
  (blank)
  (return (call probe-write-group (. ProbeType log) probe-id object-id class-type group-id))
)

(fn-do _ probe-group-push-event _ (without probe-safepoints suspend)
  (param probe-id U16)
  (let group-id (call C:brixGenerateUID))
  (call (. stack append) (call ProbeFrame group-id (. ProbeDataType group)))
  (let object-id top-object-uid)
  (let class-type top-class-type)
  (= top-object-uid group-id)
  (= top-class-type (. ProbeDataType group))
  (blank)
  (return (call probe-write-group (. ProbeType event) probe-id object-id class-type group-id))
)

(fn-do _ (of probe-group-push-object T) _ (without probe-safepoints suspend)
  (param probe-id U16)
  (param probe-type ProbeType)
  (param object T)
  (param class-type ProbeClassId)
  (constraint is T Inspectable)
  (return (call probe-group-push-object-id probe-id probe-type (call probe-object-uid object class-type) class-type))
)

(fn-expr _ (of probe-group-push-object T) _ (without probe-safepoints suspend)
  (param probe-id U16)
  (param probe-type ProbeType)
  (param object T)
  (param class-type ProbeClassId)
  (call probe-group-push-object-id probe-id probe-type (call probe-object-uid object class-type) class-type)
)

(fn-do _ probe-group-push-object-id _ (without probe-safepoints suspend)
  (param probe-id U16)
  (param probe-type ProbeType)
  (param object-id ProbeUID)
  (param class-type ProbeClassId)
  (let group-id (call C:brixGenerateUID))
  (call (. stack append) (call ProbeFrame group-id (. ProbeDataType group)))
  (= top-object-uid group-id)
  (= top-class-type (. ProbeDataType group))
  (blank)
  (return (call probe-write-group probe-type probe-id object-id class-type group-id))
)

(fn-do _ probe-group-pop _ (without probe-safepoints suspend)
  (param probe-id U16)
  (let group-id top-object-uid)
  (call probe-stack-pop)
  (blank)
  (return (call probe-write-group (. ProbeType log) probe-id top-object-uid top-class-type group-id))
)

(fn-do _ probe-group-pop-event _ (without probe-safepoints suspend)
  (param probe-id U16)
  (let group-id top-object-uid)
  (call probe-stack-pop)
  (blank)
  (return (call probe-write-group (. ProbeType event) probe-id top-object-uid top-class-type group-id))
)

(fn-do _ (of probe-group-pop-object T) _ (without probe-safepoints suspend)
  (param probe-id U16)
  (param probe-type ProbeType)
  (param object T)
  (param class-type ProbeClassId)
  (constraint is T Inspectable)
  (return (call probe-group-pop-object-id probe-id probe-type (call probe-object-uid object class-type) class-type))
)

(fn-expr _ (of probe-group-pop-object T) _ (without probe-safepoints suspend)
  (param probe-id U16)
  (param probe-type ProbeType)
  (param object T)
  (param class-type ProbeClassId)
  (call probe-group-pop-object-id probe-id probe-type (call probe-object-uid object class-type) class-type)
)

(fn-do _ probe-group-pop-object-id _ (without probe-safepoints suspend)
  (param probe-id U16)
  (param probe-type ProbeType)
  (param object-id ProbeUID)
  (param class-type ProbeClassId)
  (let group-id top-object-uid)
  (call probe-stack-pop)
  (blank)
  (return (call probe-write-group probe-type probe-id object-id class-type group-id))
)

(fn-do _ probe-stack-pop _ (without probe-safepoints suspend)
  (call (. stack rewind) (- (. stack length) 1))
  (if (== (. stack length) 0)
    (= top-object-uid 0)
    (= top-class-type 0)
    (else
      (= (tuple top-object-uid top-class-type) ([] stack (. Position last)))
    )
  )
)

(fn-do _ probe-write-snapshot _ (without probe-safepoints suspend)
  (param object-id ProbeUID)
  (param class-type ProbeClassId)
  (call (of probe-buffer-write U8) (. ProbeType snapshot))
  (call (of probe-buffer-write U32) object-id)
  (call (of probe-buffer-write U16) class-type)
)

(fn-do _ probe-log-head _ (without probe-safepoints suspend)
  (param probe-id U16)
  (return (call probe-write-head (. ProbeType log) probe-id top-object-uid top-class-type))
)

(fn-do _ probe-event-head _ (without probe-safepoints suspend)
  (param probe-id U16)
  (return (call probe-write-head (. ProbeType event) probe-id top-object-uid top-class-type))
)

(fn-do _ (of probe-object-log-head T) _ (without probe-safepoints suspend)
  (param probe-id U16)
  (param object T)
  (param class-type ProbeClassId)
  (constraint is T Inspectable)
  (return (call probe-write-head (. ProbeType log) probe-id (call probe-object-uid object class-type) class-type))
)

(fn-do _ (of probe-object-log-head T) _ (without probe-safepoints suspend)
  (param probe-id U16)
  (param object T)
  (param class-type ProbeClassId)
  (return (call probe-write-head (. ProbeType log) probe-id (call probe-object-uid object class-type) class-type))
)

(fn-do _ (of probe-object-event-head T) _ (without probe-safepoints suspend)
  (param probe-id U16)
  (param object T)
  (param class-type ProbeClassId)
  (constraint is T Inspectable)
  (return (call probe-write-head (. ProbeType event) probe-id (call probe-object-uid object class-type) class-type))
)

(fn-do _ (of probe-object-event-head T) _ (without probe-safepoints suspend)
  (param probe-id U16)
  (param object T)
  (param class-type ProbeClassId)
  (return (call probe-write-head (. ProbeType event) probe-id (call probe-object-uid object class-type) class-type))
)

(fn-do _ probe-write _ (without probe-safepoints suspend)
  (param value String)
  (call (of probe-buffer-write U32) (as (. value size) U32))
  (call probe-buffer-write value)
)

(fn-do _ (of probe-write Num) _ (without probe-safepoints suspend)
  (param value Num)
  (constraint is Num Number)
  (call probe-buffer-write value)
)

(fn-do _ (of probe-write-object T) _ (without probe-safepoints suspend)
  (param value (of Array T))
  (param class-type ProbeClassId)
  (param is-snapshot _ (= false))
  (let uid (call probe-object-uid value class-type))
  (blank)
  (if is-snapshot
    (call (of probe-buffer-write U32) (as (. value byte-size) U32))
    (call (of probe-buffer-write ProbeClassId) (as (. T probe-data-type) ProbeClassId))
    (call probe-buffer-write value)
    (else
      (call (of probe-buffer-write U32) 0)
      (call (of probe-buffer-write ProbeClassId) (as (. T probe-data-type) ProbeClassId))
    )
  )
  (blank)
  (call (of probe-buffer-write U32) uid)
  (blank)
  (if is-snapshot
    (call probe-write-snapshot uid class-type)
  )
  (blank)
  (return (call (of probe-buffer-write U8) (. ProbeType done)))
)

(fn-do _ (of probe-write-object T) _ (without probe-safepoints suspend)
  (param value T)
  (param class-type ProbeClassId)
  (param is-snapshot _ (= false))
  (constraint is T Inspectable)
  (let ins Inspectable value)
  (let uid (call probe-object-uid value class-type))
  (blank)
  (call (of probe-buffer-write U32) uid)
  (blank)
  (if is-snapshot
    (call (. stack append) (call ProbeFrame uid class-type))
    (= top-object-uid uid)
    (= top-class-type class-type)
    (blank)
    (call probe-write-snapshot uid class-type)
    (+= probe-open-snapshots 1)
    (finally
      (inline (-= probe-open-snapshots 1))
    )
    (call (. ins inspectable-snapshot))
    (blank)
    (call probe-stack-pop)
  )
  (blank)
  (return (call (of probe-buffer-write U8) (. ProbeType done)))
)

(fn-do _ (of probe-write-object T) _ (without probe-safepoints suspend)
  (param value T)
  (param class-type ProbeClassId)
  (param is-snapshot _ (= false))
  (call (of probe-buffer-write U32) (. value uid))
  (call (of probe-buffer-write U8) (. ProbeType done))
)
