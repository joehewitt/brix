+ Inspectable is Interface

────────────────────
+ do inspectable-snapshot

────────────────────
+ do inspectable-inspect
    - facet String
    - depth U32 = 1
    - offset U32 = 0
    - limit U32 = 100

if facet == "snapshot"
    inspectable-snapshot()

