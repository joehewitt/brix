━━━━━━━━━━━━━━━━━━━━
+ do unobserve-collection-pointer
    - collection-pointer Pointer
    - observer CollectionObserver

. bucket = gc-object-side-payload'CollectionObserverBucket
    - collection-pointer
    - collection-observers-lane()
if bucket
    bucket.detach(observer)
    if !bucket.has-observers
        C:brixGCClearObjectSidePayload(collection-pointer, collection-observers-lane())

