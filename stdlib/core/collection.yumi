━━━━━━━━━━━━━━━━━━━━
_ CollectionObserverNode

+ observer CollectionObserver
+ next CollectionObserverNode?
+ active = true

────────────────────
+ This
    - observer CollectionObserver

━━━━━━━━━━━━━━━━━━━━
_ CollectionObserverBucket

_ first CollectionObserverNode?
_ last CollectionObserverNode?
_ observer-count Size = 0
_ dispatch-depth Size = 0
_ has-inactive-nodes = false
_ cleanup Size = 0

────────────────────
+ get has-observers

observer-count > 0

────────────────────
+ do attach
    - observer CollectionObserver
    - owner Pointer

. node = CollectionObserverNode(observer)

if !observer-count && !cleanup
    register-cleanup(owner)

. maybe-last = last
if maybe-last
    . tail = maybe-last
    tail.next = node
else
    first = node
last = node
observer-count += 1

────────────────────
+ do detach
    - observer CollectionObserver

. previous CollectionObserverNode?
. node = first
while true
    . maybe-current = node
    if !maybe-current
        break
    . current = maybe-current
    if current.active && current.observer == observer
        current.active = false
        observer-count -= 1
        if !observer-count
            . cleanup-handle = cleanup
            cleanup = 0
            ?! Panic("Unable to deactivate collection observer")
                if !C:brixCollectionObserverDeactivate(cleanup-handle)
        if dispatch-depth
            has-inactive-nodes = true
            =
        . maybe-previous = previous
        if maybe-previous
            . previous-node = maybe-previous
            previous-node.next = current.next
        else
            first = current.next
        if last == current
            last = previous
        =
    previous = current
    node = current.next

────────────────────
+ do compact-inactive

. previous CollectionObserverNode?
. node = first
while true
    . maybe-current = node
    if !maybe-current
        break
    . current = maybe-current
    node = current.next
    if current.active
        previous = current
    else
        . maybe-previous = previous
        if maybe-previous
            . previous-node = maybe-previous
            previous-node.next = current.next
        else
            first = current.next
        if last == current
            last = previous
has-inactive-nodes = false

────────────────────
+ do register-cleanup
    - owner Pointer

cleanup = C:brixCollectionObserverActivate(owner) as Size
?! Panic("Unable to register collection observer cleanup")
    if !cleanup

────────────────────
+ do notify
    - mutation CollectionMutation

. original-last = last
dispatch-depth += 1
. batch = live-batch-enter()
do finally
    dispatch-depth -= 1
    if !dispatch-depth && has-inactive-nodes
        compact-inactive()
    batch.leave()

. node = first
while true
    . maybe-current = node
    if !maybe-current
        break
    . current = maybe-current
    node = current.next
    if current.active
        . observer = current.observer
        observer(mutation)
            catch error Error
                unhandled-error(error)
    if original-last == current
        break

━━━━━━━━━━━━━━━━━━━━
_ do notify-observers
    - collection-pointer Pointer
    - kind CollectionMutationKind
    - index Index
    - from-index Index
    - to-index Index
    - count Size

. bucket = gc-object-side-payload'CollectionObserverBucket
    - collection-pointer
    - collection-observers-lane()
=? if !bucket
bucket.notify(CollectionMutation(kind, index, from-index, to-index, count))

