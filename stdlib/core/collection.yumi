━━━━━━━━━━━━━━━━━━━━
+ do collection-observer-bucket-for-pointer
    - collection-pointer Pointer

. lane = collection-observers-lane()
. bucket = gc-object-side-payload'CollectionObserverBucket(collection-pointer, lane)
if bucket
    = bucket
. created = CollectionObserverBucket()
. published = gc-publish-object-side-payload(collection-pointer, lane, created)
if published == created
    published.register-cleanup(collection-pointer)
= published

