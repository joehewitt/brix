/YuGC/YuGC.h
/core/error
/core/intrinsics

━━━━━━━━━━━━━━━━━━━━
+ GCManagedCleanupCallback is (*C) Size
    - context-pointer Pointer

━━━━━━━━━━━━━━━━━━━━
+ Weak'T

_ registry-token Size = 0

────────────────────
+ This
    - target T

registry-token = C:yumiGCRegisterOwnerWeak(this as Pointer, target as Pointer) as Size
if !registry-token
    ?! Error("Unable to register weak reference")

────────────────────
+ do get get T?

. pointer = C:yumiGCOwnerWeakLoad(registry-token)
=? if !pointer
= gc-object-from-pointer'T(pointer)

