━━━━━━━━━━━━━━━━━━━━
+ VirtualRecycler'Item
    is VirtualBindingOwner'Item

+ source VirtualSource'Item?
+ layout VirtualLayout?
+ owner VirtualRecyclerOwner?
+ window := VirtualWindow()
+ retention = VirtualInsets(0vcoord, 0vcoord, 0vcoord, 0vcoord)
+ slots [VirtualSlot'Item] = List'(VirtualSlot'Item)()
+ has-pending-changes Bool
+ is-revision-change Bool

_ targets [VirtualBindingRequestTarget'Item] = List'(VirtualBindingRequestTarget'Item)()
_ slot-is-placed [Bool] = List'Bool()
_ slot-placement-ids [VirtualCoord] = List'VirtualCoord()
_ slot-placement-indexes [Index] = List'Index()
_ placement-slot-indexes [Index] = List'Index()
_ placed-slots [Index] = List'Index()
_ next-placed-slots [Index] = List'Index()
_ free-slots [Index] = List'Index()
_ slot-identities [U64] = List'U64()
_ slot-has-identity [Bool] = List'Bool()
_ slot-retained [Bool] = List'Bool()
_ placement-retained [Bool] = List'Bool()
_ placement-required [Bool] = List'Bool()
_ has-cover Bool
_ cover-first Index
_ cover-last Index
_ cover-reaches-start Bool
_ cover-reaches-end Bool
_ identity-slots Map'U64'Index = Map'U64'Index()
_ bound-source VirtualSource'Item?
_ bound-source-pointer Pointer
_ has-source-revision Bool
_ source-revision U64

_ stat-pool-created Size
_ stat-pool-high-water Size
_ stat-window-refreshes Size
_ stat-placements-emitted Size
_ stat-layout-addresses-inspected Size
_ stat-rebinds Size
_ stat-source-binds Size
_ stat-departures Size
_ stat-placement-buffer-grows Size
_ stat-stale-commits Size

────────────────────
+ get stats VirtualRecyclerStats

VirtualRecyclerStats
    - stat-pool-created
    - stat-pool-high-water
    - stat-window-refreshes
    - stat-placements-emitted
    - stat-layout-addresses-inspected
    - stat-rebinds
    - stat-source-binds
    - stat-departures
    - stat-placement-buffer-grows
    - stat-stale-commits

────────────────────
+ get pool-size

slots.length

────────────────────
+ get has-pending-revision Bool

|? !live || !has-source-revision || live as Pointer != bound-source-pointer
    false
??
    live.revision.value != source-revision

.. live = source

────────────────────
+ slot-at VirtualSlot'Item?
    - index Index

slots[index] if index < slots.length

────────────────────
+ do placement-for-slot VirtualPlacement?
    - slot-index Index

=? if slot-index >= slots.length || !slot-is-placed[slot-index]
= window.placement-at(slot-placement-indexes[slot-index])

────────────────────
+ do rect-for-address VirtualRect?
    - address I64

=? if !source || !layout
= layout.rect-for-address(address, source.domain, window)

────────────────────
+ do refresh

=? if !source || !layout
. domain = source.domain
. known-before = domain.known-count
. made-progress = true
while made-progress
    refresh-window()
    . known-after = domain.known-count
    made-progress = known-after > known-before
    known-before = known-after

────────────────────
+ do refresh-window

=? if !source || !layout
. live-source = source
. live-layout = layout
. previous-capacity = window.placements.capacity
. required = VirtualInsets
    - window.overscan-top
    - window.overscan-right
    - window.overscan-bottom
    - window.overscan-left
. retains = retains-beyond(required)
if retains
    window.set-overscan(retained-insets(required))
live-layout.fill-window(window, live-source.domain)
window.set-overscan(required)
?! Panic("Virtual layout returned more placements than it supplied")
    if window.placement-count > window.placements.length
if window.placements.capacity > previous-capacity
    stat-placement-buffer-grows += 1
stat-window-refreshes += 1
stat-placements-emitted += window.placement-count
stat-layout-addresses-inspected += window.placement-count

. live-source-pointer = live-source as Pointer
. source-changed = live-source-pointer != bound-source-pointer
. revision-changed = !has-source-revision || live-source.revision.value != source-revision
. source-state-changed = source-changed || revision-changed
bound-source = live-source
bound-source-pointer = live-source-pointer
source-revision = live-source.revision.value
has-source-revision = true

. retains-identity = revision-changed && !source-changed
is-revision-change = retains-identity
. departed-count = match-previous-placements(source-state-changed, retains-identity)
collect-free-slots()
mark-required-placements(retains)
. rebound-count = bind-entering-placements(live-source)
record-placed-slots()
record-cover(live-source.domain)
if source-state-changed || departed-count > 0 || rebound-count > 0
    has-pending-changes = true

────────────────────
+ holds Bool
    - scroll-x VirtualCoord
    - scroll-y VirtualCoord
    - viewport-width VirtualCoord
    - viewport-height VirtualCoord

window.placement-count != 0 && has-cover && (spans-x || holds-x) && holds-y

.. spans-x = window.extent-x.is-final && window.extent-x.known <= window.frame-width
.. holds-x = axis-holds
    - true
    - scroll-x
    - viewport-width
    - VirtualSize(window.overscan-left, window.overscan-right)
    - VirtualSize(retention.left, retention.right)
    - window.extent-x
.. holds-y = axis-holds
    - false
    - scroll-y
    - viewport-height
    - VirtualSize(window.overscan-top, window.overscan-bottom)
    - VirtualSize(retention.top, retention.bottom)
    - window.extent-y

────────────────────
+ do release

for slot-index in placed-slots
    depart(slot-index)
for target in targets
    target.deactivate()
slots = List'(VirtualSlot'Item)()
targets = List'(VirtualBindingRequestTarget'Item)()
slot-is-placed = List'Bool()
slot-placement-ids = List'VirtualCoord()
slot-placement-indexes = List'Index()
placement-slot-indexes = List'Index()
placed-slots = List'Index()
next-placed-slots = List'Index()
free-slots = List'Index()
slot-identities = List'U64()
slot-has-identity = List'Bool()
slot-retained = List'Bool()
placement-retained = List'Bool()
placement-required = List'Bool()
has-cover = false
identity-slots.clear()
window.clear-placements()
source = null
bound-source = null
bound-source-pointer = Pointer()
has-source-revision = false
source-revision = 0
has-pending-changes = true

────────────────────
_ do match-previous-placements Size
    - source-state-changed Bool
    - retains-identity Bool

placement-slot-indexes.clear()
placement-retained.clear()
. fill-index Index
while fill-index < window.placement-count
    placement-slot-indexes += Index.max
    placement-retained += false
    fill-index += 1

=? retain-identified-placements(bound-source!) if retains-identity

. departed-count Size
. previous-index Index
. placement-index Index
while previous-index < placed-slots.length
    . slot-index = placed-slots[previous-index]
    . previous-id = slot-placement-ids[slot-index]
    if source-state-changed || placement-index >= window.placement-count
        depart(slot-index)
        departed-count += 1
        previous-index += 1
    else
        . next-id = window.placements[placement-index].placement-id
        if previous-id == next-id
            placement-slot-indexes[placement-index] = slot-index
            previous-index += 1
            placement-index += 1
        else if previous-id < next-id
            depart(slot-index)
            departed-count += 1
            previous-index += 1
        else
            placement-index += 1
= departed-count

────────────────────
_ do retain-identified-placements
    - live-source VirtualSource'Item

. identified Size
. placed-index Index
while placed-index < placed-slots.length
    . slot-index = placed-slots[placed-index]
    slot-retained[slot-index] = false
    if slot-has-identity[slot-index]
        if identified == 0
            identity-slots.clear()
        identity-slots[slot-identities[slot-index]] = slot-index
        identified += 1
    placed-index += 1

. placement-index Index
while identified > 0 && placement-index < window.placement-count
    . identity = live-source.identity-at(window.placements[placement-index].address)
    if identity != null
        . retained = identity-slots[identity]
        if retained != null
            placement-slot-indexes[placement-index] = retained
            placement-retained[placement-index] = true
            slot-retained[retained] = true
            -= identity-slots[identity]
    placement-index += 1

. departed-count Size
placed-index = 0
while placed-index < placed-slots.length
    . slot-index = placed-slots[placed-index]
    if !slot-retained[slot-index]
        depart(slot-index)
        departed-count += 1
    slot-retained[slot-index] = false
    placed-index += 1
= departed-count

────────────────────
_ do record-slot-identity
    - live-source VirtualSource'Item
    - slot-index Index
    - address I64

. identity = live-source.identity-at(address)
slot-has-identity[slot-index] = identity != null
slot-identities[slot-index] = identity ?? 0u64

────────────────────
_ do rebind-retained-slot
    - live-source VirtualSource'Item
    - slot-index Index
    - placement-index Index

. placement = window.placements[placement-index]
. slot = slots[slot-index]
. generation = slot.generation + 1
. target = targets[slot-index]
target.address = placement.address
target.prepare(generation)
live-source.bind(placement.address, generation, target)
target.finish()
=? false if !slot.is-bound || slot.generation != generation
place-slot(slot-index, placement-index)
record-slot-identity(live-source, slot-index, placement.address)
= true

────────────────────
_ do depart
    - slot-index Index

owner?.virtual-slot-departing(slot-index)
targets[slot-index].deactivate()
. slot = slots[slot-index]
slot.generation += 1
slot.is-bound = false
slot-is-placed[slot-index] = false
stat-departures += 1

────────────────────
_ do collect-free-slots

free-slots.clear()
. slot-index Index
while slot-index < slots.length
    if !slot-is-placed[slot-index]
        free-slots += slot-index
    slot-index += 1

────────────────────
_ do bind-entering-placements
    - live-source VirtualSource'Item

. rebound-count Size
. free-cursor Index
. placement-index Index
while placement-index < window.placement-count
    if placement-retained[placement-index]
        rebound-count += 1
        stat-source-binds += 1
        stat-rebinds += 1
        . retained = placement-slot-indexes[placement-index]
        if !rebind-retained-slot(live-source, retained, placement-index)
            depart(retained)
            placement-slot-indexes[placement-index] = Index.max
    else if is-entering(placement-index)
        rebound-count += 1
        stat-source-binds += 1
        stat-rebinds += 1
        . placement = window.placements[placement-index]
        if free-cursor < free-slots.length
            . slot-index = free-slots[free-cursor]
            . slot = slots[slot-index]
            . generation = slot.generation + 1
            . target = targets[slot-index]
            target.address = placement.address
            target.prepare(generation)
            live-source.bind(placement.address, generation, target)
            target.finish()
            if slot.is-bound && slot.generation == generation
                place-slot(slot-index, placement-index)
                record-slot-identity(live-source, slot-index, placement.address)
                owner?.virtual-slot-arriving(slot-index)
                free-cursor += 1
            else
                slot.generation = generation
        else
            . initial-generation U64 = 1
            . initial-target = VirtualInitialBindingTarget'Item(this, initial-generation)
            live-source.bind(placement.address, initial-generation, initial-target)
            initial-target.finish()
            if initial-target.did-commit
                . key = initial-target.key
                . item = initial-target.item
                . slot-index = grow-pool(placement.address, key, item, initial-generation)
                place-slot(slot-index, placement-index)
                record-slot-identity(live-source, slot-index, placement.address)
    placement-index += 1
= rebound-count

────────────────────
_ is-entering
    - placement-index Index

placement-slot-indexes[placement-index] == Index.max && placement-required[placement-index]

────────────────────
_ do place-slot
    - slot-index Index
    - placement-index Index

slot-is-placed[slot-index] = true
slot-placement-ids[slot-index] = window.placements[placement-index].placement-id
placement-slot-indexes[placement-index] = slot-index

────────────────────
_ do record-placed-slots

next-placed-slots.clear()
. slot-index Index
while slot-index < slot-placement-indexes.length
    slot-placement-indexes[slot-index] = Index.max
    slot-index += 1
. placement-index Index
while placement-index < window.placement-count
    . placed = placement-slot-indexes[placement-index]
    if placed != Index.max
        next-placed-slots += placed
        slot-placement-indexes[placed] = placement-index
    placement-index += 1
. previous = placed-slots
placed-slots = next-placed-slots
next-placed-slots = previous

────────────────────
_ retains-beyond
    - required VirtualInsets

beyond-top || beyond-right || beyond-bottom || beyond-left

.. beyond-top = retention.top > non-negative-virtual(required.top)
.. beyond-right = retention.right > non-negative-virtual(required.right)
.. beyond-bottom = retention.bottom > non-negative-virtual(required.bottom)
.. beyond-left = retention.left > non-negative-virtual(required.left)

────────────────────
_ retained-insets
    - required VirtualInsets

VirtualInsets
    - larger-virtual(required.top, retention.top)
    - larger-virtual(required.right, retention.right)
    - larger-virtual(required.bottom, retention.bottom)
    - larger-virtual(required.left, retention.left)

────────────────────
_ do mark-required-placements
    - retains Bool

placement-required.clear()
. lead-x = non-negative-virtual(window.overscan-left)
. trail-x = non-negative-virtual(window.overscan-right)
. lead-y = non-negative-virtual(window.overscan-top)
. trail-y = non-negative-virtual(window.overscan-bottom)
. left = non-negative-virtual(window.resolved-scroll-x - lead-x)
. right = window.resolved-scroll-x + non-negative-virtual(window.viewport-width) + trail-x
. top = non-negative-virtual(window.resolved-scroll-y - lead-y)
. bottom = window.resolved-scroll-y + non-negative-virtual(window.viewport-height) + trail-y
. checks-x = retains && (retention.left > lead-x || retention.right > trail-x)
. checks-y = retains && (retention.top > lead-y || retention.bottom > trail-y)
. index Index
while index < window.placement-count
    . placement = window.placements[index]
    . inside-x = !checks-x || (placement.x < right && placement.x + placement.width > left)
    . inside-y = !checks-y || (placement.y < bottom && placement.y + placement.height > top)
    placement-required += inside-x && inside-y
    index += 1

────────────────────
_ do record-cover
    - domain VirtualSequenceDomain

has-cover = false
cover-reaches-start = false
cover-reaches-end = false
. count = window.placement-count
. index Index
while index < count
    if placement-required[index]
        if !has-cover
            cover-first = index
        cover-last = index
        has-cover = true
    index += 1
=? if !has-cover

while cover-first > 0 && placement-slot-indexes[cover-first - 1] != Index.max
    cover-first -= 1
while cover-last + 1 < count && placement-slot-indexes[cover-last + 1] != Index.max
    cover-last += 1
. first = domain.index-of(window.placements[cover-first].address)
cover-reaches-start = first != null && first <= 0vcoord
. last = domain.index-of(window.placements[cover-last].address)
cover-reaches-end = domain.is-final && last != null && last + 1vcoord >= domain.known-count

────────────────────
_ do axis-holds Bool
    - is-horizontal Bool
    - scroll VirtualCoord
    - viewport VirtualCoord
    - overscan VirtualSize
    - retained VirtualSize
    - extent VirtualExtent

. lead = non-negative-virtual(overscan.width)
. trail = non-negative-virtual(overscan.height)
. window-start = non-negative-virtual(scroll - lead)
. window-end = scroll + viewport + trail
. band-start = non-negative-virtual(scroll - larger-virtual(lead, retained.width))
. band-end = scroll + viewport + larger-virtual(trail, retained.height)
. cover-start = VirtualCoord.max
. cover-end = 0vcoord
. min-end = VirtualCoord.max
. max-start = 0vcoord
. index Index
while index < window.placement-count
    . is-covered = index >= cover-first && index <= cover-last
    if is-covered || placement-slot-indexes[index] != Index.max
        . placement = window.placements[index]
        . start = if is-horizontal then placement.x else placement.y
        . end = start + (if is-horizontal then placement.width else placement.height)
        min-end = smaller-virtual(min-end, end)
        max-start = larger-virtual(max-start, start)
        if is-covered
            cover-start = smaller-virtual(cover-start, start)
            cover-end = larger-virtual(cover-end, end)
    index += 1
. leading = cover-start <= window-start || cover-start <= 0vcoord || cover-reaches-start
. reaches-extent = extent.is-final && cover-end >= extent.known
. trailing = cover-end >= window-end || reaches-extent || cover-reaches-end
= min-end > band-start && max-start < band-end && leading && trailing

────────────────────
_ do grow-pool Index
    - address I64
    - key VirtualKey
    - item Item
    - generation U64

. index = slots.length
slots += VirtualSlot'Item(address, key, item, generation)
targets += VirtualBindingRequestTarget'Item(this, index)
slot-is-placed += false
slot-placement-ids += 0vcoord
slot-placement-indexes += Index.max
slot-identities += 0u64
slot-has-identity += false
slot-retained += false
stat-pool-created += 1
if slots.length > stat-pool-high-water
    stat-pool-high-water = slots.length
= index

╌╌╌╌╌╌╌╌╌╌ is VirtualBindingOwner'Item ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do accept-binding
    - slot-index Index
    - address I64
    - key VirtualKey
    - item Item
    - generation U64

. slot = slots[slot-index]
slot.address = address
slot.key = key
slot.item = item
slot.is-bound = true
slot.generation = generation

────────────────────
+ do note-stale-commit

stat-stale-commits += 1

━━━━━━━━━━━━━━━━━━━━
_ VirtualInitialBindingTarget'Item
    is VirtualBindingTarget'Item

_ owner VirtualBindingOwner'Item
_ request-generation U64
_ is-accepting Bool = true
_ bound-key VirtualKey?
_ bound-item Item?
+ did-commit Bool

────────────────────
_ This
    - owner
    - request-generation

────────────────────
+ get key

bound-key!

────────────────────
+ get item Item

bound-item!

────────────────────
+ do finish

is-accepting = false

╌╌╌╌╌╌╌╌╌╌ is VirtualBindingTarget'Item ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do commit
    - key VirtualKey
    - item Item
    - generation U64

if is-accepting && generation == request-generation
    bound-key = key
    bound-item = item
    did-commit = true
else
    owner.note-stale-commit()

────────────────────
+ do fail
    - generation U64

if !is-accepting || generation != request-generation
    owner.note-stale-commit()

━━━━━━━━━━━━━━━━━━━━
_ VirtualBindingRequestTarget'Item
    is VirtualBindingTarget'Item

_ owner VirtualBindingOwner'Item
_ slot-index Index
+ address I64
_ request-generation U64
_ is-accepting Bool

────────────────────
_ This
    - owner
    - slot-index

────────────────────
+ do prepare
    - generation U64

request-generation = generation
is-accepting = true

────────────────────
+ do finish

is-accepting = false

────────────────────
+ do deactivate

is-accepting = false

────────────────────
+ accepts
    - generation U64

is-accepting && generation == request-generation

╌╌╌╌╌╌╌╌╌╌ is VirtualBindingTarget'Item ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do commit
    - key VirtualKey
    - item Item
    - generation U64

if accepts(generation)
    owner.accept-binding(slot-index, address, key, item, generation)
else
    owner.note-stale-commit()

────────────────────
+ do fail
    - generation U64

if !accepts(generation)
    owner.note-stale-commit()

━━━━━━━━━━━━━━━━━━━━
_ non-negative-virtual
    - value VirtualCoord

if value > 0vcoord then value else 0vcoord

━━━━━━━━━━━━━━━━━━━━
_ larger-virtual
    - left VirtualCoord
    - right VirtualCoord

if left > right then left else right

━━━━━━━━━━━━━━━━━━━━
_ smaller-virtual
    - left VirtualCoord
    - right VirtualCoord

if left < right then left else right
