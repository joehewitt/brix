
━━━━━━━━━━━━━━━━━━━━
+ Node'Content

+ object Content
+ first Node'Content?
+ last Node'Content?
+ next Node'Content?
+ previous Node'Content?
+ parent Node'Content?
+ index Index
+ count Index

────────────────────
+ This
    - object
    - parent
    - index = 0

────────────────────
+ do this += child ''T

. child-node = Node'T(child, this, count + 1)
count += 1
if !first
    first = last = child-node
else
    child-node.previous = last
    last?.next = child-node
    last = child-node

────────────────────
+ do replace
    - object-replacement ''T

. replacement = Node'T(object-replacement, parent, index)
replacement.parent = parent
replacement.previous = previous
replacement.next = next
next?.previous = replacement
previous?.next = replacement
parent = null
next = null
previous = null

= object.replace(object-replacement)
`parent?.object.replace at index with object-replacement

────────────────────
+ do merge

. child = first
while child
    child?.merge()
    object += child?.object
    child = child?.next
