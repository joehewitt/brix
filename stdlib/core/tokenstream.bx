(import ./array)
(import ./core)
(import ./error)
(import ./intrinsics)
(import ./list)
(import ./number)
(import ./range)
(import ./stream)
(import ./string)
(import ./task)
(import /string.h)
(blank)
(prop _ chunk-size Size (= 0x400))
(prop _ release-capacity Size (= 0x10000))

(fn-do _ validate-stream-mark _
  (param mark StreamMark)
  (param owner Pointer)
  (throw (call Panic "Stream mark belongs to another stream") (if (!= (. mark owner) owner)))
)

(type + (of IndexableTokenStream Token)
  (implements (of TokenStream Token))
  (prop + buffer ([] Token))
  (prop + length Size)
  (prop + cursor Index)
  (prop + cursor-extent Index)
  (blank)
  (prop _ line-starts _ (= ([] Index 0)))
  (prop _ line-start-count Size)
  (prop _ location-scanned Index)
  (prop _ cached-location-target Index)
  (prop _ cached-location-line Index)
  (prop _ cached-location TokenLocation (= (tuple 0 0)))
  (prop _ origin-line Index)
  (prop _ origin-column Index)
  (fn-expr + capture-span (? (of CaptureSpan Token))
    (param mark StreamMark)
    null
  )
  (fn-do + scan-span (of CaptureSpan Token)
    (param during (of Predicate Token))
    (let text (call read (:during during)))
    (if text
      (let source (call (of Array Token) (!! text)))
      (return (call (of CaptureSpan Token) source 0 (. source size)))
    )
    (return (call (of CaptureSpan Token) ([] Token 0) 0 0))
  )
  (fn-do + This _
    (param buffer ([] Token))
    (= length (. buffer size))
  )
  (fn-do + This _
    (param source (of Indexable Token))
    (lazy length (. source length))
    (lazy buffer ([] Token length))
    (for (in i (..< 0 length))
      (= ([] buffer i) ([] source i))
    )
  )
  (fn-do + This _
    (param source (of Indexable Token))
    (param source-length Size)
    (= length source-length)
    (= buffer ([] Token length))
    (for (in i (..< 0 length))
      (= ([] buffer i) ([] source i))
    )
  )
  (fn-expr + pattern-view (? (tuple ([] Token) Index Size Index)) :get
    (tuple buffer cursor length cursor-extent)
  )
  (fn-do + pattern-extend Bool
    (return false)
  )
  (fn-do + pattern-commit _
    (param new-cursor Index)
    (param probe-extent Index)
    (= cursor new-cursor)
    (if (> probe-extent cursor-extent)
      (= cursor-extent probe-extent)
    )
  )
  (fn-expr + pattern-location-at TokenLocation
    (param target Index)
    (call location-at target)
  )
  (fn-expr + has-more _ :get
    (< cursor length)
  )
  (fn-expr + location _ :get
    (call location-at cursor)
  )
  (fn-expr + error-location TokenLocation :get
    (call location-at cursor)
  )
  (fn-do + (prefix <- this) _
    (if (< cursor length)
      (let item ([] buffer cursor))
      (+= cursor 1)
      (if (> cursor cursor-extent)
        (= cursor-extent cursor)
      )
      (probe-count grammar.reads)
      (probe-count grammar.read-tokens)
      (probe-count grammar.generic-buffer-reads)
      (return item)
    )
  )
  (fn-expr + get-match-location _
    (param begin-loc TokenLocation)
    (call MatchLocation begin-loc last-location)
  )
  (fn-expr + get-error-location _
    (call location-at cursor-extent)
  )
  (fn-expr + mark StreamMark
    (before
      (probe-count grammar.marks)
    )
    (call StreamMark (as this Pointer) cursor)
  )
  (fn-do + rewind _
    (param mark StreamMark)
    (call validate-stream-mark mark (as this Pointer))
    (throw (call Panic "Stream mark is no longer valid") (if (> (. mark cursor) cursor)))
    (blank)
    (let distance (- cursor (. mark cursor)))
    (= cursor (. mark cursor))
    (probe-count grammar.rewinds)
    (probe-count grammar.rewind-tokens distance)
  )
  (fn-do + read Size
    (param size Size)
    (param receiver ([] Token))
    (param should-read-once _ (= false))
    (if (>= (+ cursor size) (. buffer length))
      (= size (- (. buffer length) cursor))
    )
    (blank)
    (for (in i (..< 0 size))
      (let item ([] buffer (+ cursor i)))
      (= ([] receiver i) item)
    )
    (+= cursor size)
    (if (> cursor cursor-extent)
      (= cursor-extent cursor)
    )
    (blank)
    (probe-count grammar.reads)
    (probe-count grammar.read-tokens size)
    (probe-count grammar.generic-buffer-reads size)
    (return size)
  )
  (fn-do + match-literal Bool
    (param literal ([] Token))
    (let probe-end (if-expr (< (+ cursor (. literal size)) length) (+ cursor (. literal size)) length))
    (if (> probe-end cursor-extent)
      (= cursor-extent probe-end)
    )
    (if (< (- probe-end cursor) (. literal size))
      (return false)
    )
    (blank)
    (for (in i (..< 0 (. literal size)))
      (probe-count grammar.literal-compared-tokens)
      (probe-count grammar.literal-compared-bytes (. Token size))
      (if (!= ([] buffer (+ cursor i)) ([] literal i))
        (return false)
      )
    )
    (= cursor probe-end)
    (return true)
  )
  (fn-do + read (? String)
    (param during (of Predicate Token))
    (let buf ([] Token 0))
    (let count 0)
    (let stopped false)
    (blank)
    (while 1
      (let item (<- this))
      (if item
        (if (call during item)
          (if (>= count (. buf size))
            (= buf (call (. buf grow) (if-expr (> (. buf size) 0x20) (. buf size) 0x20)))
          )
          (= ([] buf count) item)
          (+= count 1)
          (else
            (-= cursor 1)
            (= stopped true)
            (break)
          )
        )
        (else
          (break)
        )
      )
    )
    (blank)
    (if (or (> count 0) stopped)
      (return (call (. buf slice-string) (..< 0 count)))
    )
  )
  (fn-expr _ last-location TokenLocation :get
    (case? (== cursor 0)
      (tuple 0 0)
    )
    (default
      (call location-at (- cursor 1))
    )
  )
  (fn-do _ location-at TokenLocation
    (param target Index)
    (call ensure-locations-through target)
    (probe-count grammar.location-computations)
    (blank)
    (if (== target cached-location-target)
      (probe-count grammar.location-cache-hits)
      (return cached-location)
    )
    (blank)
    (let line cached-location-line)
    (if (> target cached-location-target)
      (while (and (< (+ line 1) line-start-count) (<= ([] line-starts (+ line 1)) target))
        (+= line 1)
        (probe-count grammar.location-forward-line-steps)
      )
      (else-if (< target ([] line-starts line))
        (let low Index 0)
        (let high Index line-start-count)
        (while (< (+ low 1) high)
          (let middle (/ (+ low high) 2))
          (probe-count grammar.location-binary-search-comparisons)
          (if (<= ([] line-starts middle) target)
            (= low middle)
            (else
              (= high middle)
            )
          )
        )
        (= line low)
        (probe-count grammar.location-backward-searches)
      )
    )
    (blank)
    (let column (- target ([] line-starts line)))
    (if (== line 0)
      (+= column origin-column)
    )
    (let location (call TokenLocation (as (+ origin-line line) U32) (as column U32)))
    (= cached-location-target target)
    (= cached-location-line line)
    (= cached-location location)
    (return location)
  )
  (fn-do _ ensure-locations-through _
    (param target Index)
    (if (== line-start-count 0)
      (= line-starts ([] Index 8))
      (= ([] line-starts 0) 0)
      (= line-start-count 1)
    )
    (blank)
    (if (> target location-scanned)
      (call scan-locations-through target)
    )
  )
  (fn-do _ reset-location-index _
    (= line-starts ([] Index 0))
    (= line-start-count 0)
    (= location-scanned 0)
    (= cached-location-target 0)
    (= cached-location-line 0)
    (= cached-location (call TokenLocation (as origin-line U32) (as origin-column U32)))
  )
  (fn-do _ release-locations _
    (param count Index)
    (if (<= count location-scanned)
      (let origin (call location-at count))
      (= origin-line (. origin line))
      (= origin-column (. origin column))
      (call reset-location-index)
      (return)
    )
    (blank)
    (let start location-scanned)
    (let origin
      (block
        (case? start
          (call location-at start)
        )
        (default
          (call TokenLocation (as origin-line U32) (as origin-column U32))
        )
      )
    )
    (let data buffer)
    (let end length)
    (let lines Index 0)
    (let line-start start)
    (if (== Token Byte)
      (let bytes (. data data))
      (let address (. (as bytes Pointer) address))
      (let next start)
      (while (< next count)
        (let found (call C:memchr (+ bytes next) 10 (- count next)))
        (if (not found)
          (break)
        )
        (= line-start (+ (as (- (. (as found Pointer) address) address) Index) 1))
        (+= lines 1)
        (= next line-start)
      )
      (= next start)
      (while (< next count)
        (let found (call C:memchr (+ bytes next) 13 (- count next)))
        (if (not found)
          (break)
        )
        (let after (+ (as (- (. (as found Pointer) address) address) Index) 1))
        (if (or (>= after end) (not (call is-code ([] data after) 10)))
          (+= lines 1)
          (if (> after line-start)
            (= line-start after)
          )
        )
        (= next after)
      )
      (else
        (= (tuple lines line-start) (call count-char-breaks data start count end))
      )
    )
    (= origin-line (+ (as (. origin line) Index) lines))
    (= origin-column (if-expr lines (- count line-start) (- (+ (as (. origin column) Index) count) start)))
    (call reset-location-index)
  )
  (fn-do + scan-locations-through _
    (param target Index)
    (let scan-start location-scanned)
    (let data buffer)
    (let end length)
    (for (in i (..< scan-start target))
      (let item ([] data i))
      (if (or (call is-code item 10) (and (call is-code item 13) (or (>= (+ i 1) end) (not (call is-code ([] data (+ i 1)) 10)))))
        (call append-line-start (+ i 1))
      )
    )
    (blank)
    (probe-count grammar.location-forward-tokens (- target scan-start))
    (= location-scanned target)
  )
  (fn-do _ append-line-start _
    (param start Index)
    (if (>= line-start-count (. line-starts size))
      (= line-starts (call (. line-starts resize) (* (. line-starts size) 2)))
    )
    (blank)
    (= ([] line-starts line-start-count) start)
    (+= line-start-count 1)
  )
)

(type + (of ArrayTokenStream Token) (is (of IndexableTokenStream Token))
  (prop _ array-buffer ([] Token))
  (prop _ stable-source Bool)
  (prop _ reported-capture-source Bool)
  (fn-do + This _
    (param buffer ([] Token))
    (param stable-source _ (= false))
    (call super buffer)
    (lazy array-buffer buffer)
  )
  (fn-do + (prefix <- this) _
    (if (< cursor length)
      (let item ([] array-buffer cursor))
      (+= cursor 1)
      (if (> cursor cursor-extent)
        (= cursor-extent cursor)
      )
      (probe-count grammar.reads)
      (probe-count grammar.read-tokens)
      (probe-count grammar.direct-buffer-reads)
      (return item)
    )
  )
  (fn-do + read Size
    (param size Size)
    (param receiver ([] Token))
    (param should-read-once _ (= false))
    (if (>= (+ cursor size) length)
      (= size (- length cursor))
    )
    (blank)
    (= ([] receiver (..< 0 size)) ([] array-buffer (..< cursor (+ cursor size))))
    (+= cursor size)
    (if (> cursor cursor-extent)
      (= cursor-extent cursor)
    )
    (blank)
    (probe-count grammar.reads)
    (probe-count grammar.read-tokens size)
    (probe-count grammar.direct-buffer-reads size)
    (return size)
  )
  (fn-do + match-literal Bool
    (param literal ([] Token))
    (probe-count grammar.literal-direct-compares)
    (let probe-end (if-expr (< (+ cursor (. literal size)) length) (+ cursor (. literal size)) length))
    (if (> probe-end cursor-extent)
      (= cursor-extent probe-end)
    )
    (blank)
    (if (< (- probe-end cursor) (. literal size))
      (return false)
    )
    (blank)
    (for (in i (..< 0 (. literal size)))
      (probe-count grammar.literal-compared-tokens)
      (probe-count grammar.literal-compared-bytes (. Token size))
      (if (!= ([] array-buffer (+ cursor i)) ([] literal i))
        (return false)
      )
    )
    (blank)
    (= cursor probe-end)
    (return true)
  )
  (fn-do + capture-span (? (of CaptureSpan Token))
    (param mark StreamMark)
    (call validate-stream-mark mark (as this Pointer))
    (if (or (not stable-source) (> (. mark cursor) cursor))
      (return null)
    )
    (blank)
    (probe-count grammar.capture-spans-created)
    (probe-count grammar.captures-elided)
    (if (not reported-capture-source)
      (probe-count grammar.capture-span-retained-source-bytes (* (. array-buffer size) (. Token size)))
      (= reported-capture-source true)
    )
    (return (call (of CaptureSpan Token) array-buffer (. mark cursor) cursor))
  )
  (fn-do + scan-span (of CaptureSpan Token)
    (param during (of Predicate Token))
    (if (not stable-source)
      (return (call (. super scan-span) during))
    )
    (blank)
    (let start cursor)
    (while (< cursor length)
      (let item ([] array-buffer cursor))
      (+= cursor 1)
      (if (> cursor cursor-extent)
        (= cursor-extent cursor)
      )
      (probe-count grammar.reads)
      (probe-count grammar.read-tokens)
      (probe-count grammar.direct-buffer-reads)
      (if (not (call during item))
        (-= cursor 1)
        (break)
      )
    )
    (blank)
    (probe-count grammar.capture-spans-created)
    (probe-count grammar.captures-elided)
    (if (not reported-capture-source)
      (probe-count grammar.capture-span-retained-source-bytes (* (. array-buffer size) (. Token size)))
      (= reported-capture-source true)
    )
    (return (call (of CaptureSpan Token) array-buffer start cursor))
  )
  (fn-do + scan-locations-through _
    (param target Index)
    (let scan-start location-scanned)
    (for (in i (..< scan-start target))
      (let item ([] array-buffer i))
      (let is-line-feed (call is-code item 10))
      (let is-carriage-return
        (scope (and is-cr-code (or (>= (+ i 1) length) (not (call is-code ([] array-buffer (+ i 1)) 10))))
          (lazy is-cr-code (call is-code item 13))
        )
      )
      (if (or is-line-feed is-carriage-return)
        (call append-line-start (+ i 1))
      )
    )
    (blank)
    (probe-count grammar.location-forward-tokens (- target scan-start))
    (= location-scanned target)
  )
)

(type + TextTokenStream
  (implements (of TokenStream Char))
  (prop + bytes ([] Byte))
  (prop + length Size)
  (prop + cursor Index)
  (prop + cursor-extent Index)
  (blank)
  (prop _ line-starts _ (= ([] Index 0)))
  (prop _ line-start-count Size)
  (prop _ location-scanned Index)
  (prop _ cached-target Index)
  (prop _ cached-line Index)
  (prop _ cached-column Size)
  (fn-do + This _
    (param text String)
    (lazy bytes (call (of Array Byte) text))
    (lazy length (. text size))
    (. text validated-length)
  )
  (fn-expr + pattern-text-view (? (tuple ([] Byte) Index Size Index)) :get
    (tuple bytes cursor length cursor-extent)
  )
  (fn-do + pattern-extend Bool
    (return false)
  )
  (fn-do + pattern-commit _
    (param new-cursor Index)
    (param probe-extent Index)
    (= cursor new-cursor)
    (if (> probe-extent cursor-extent)
      (= cursor-extent probe-extent)
    )
  )
  (fn-expr + pattern-location-at TokenLocation
    (param target Index)
    (call location-at (call char-start target))
  )
  (fn-expr + has-more _ :get
    (< cursor length)
  )
  (fn-expr + location _ :get
    (call location-at cursor)
  )
  (fn-expr + error-location TokenLocation :get
    (call location-at cursor)
  )
  (fn-expr + get-match-location _
    (param begin-loc TokenLocation)
    (call MatchLocation begin-loc last-location)
  )
  (fn-expr + mark StreamMark
    (call StreamMark (as this Pointer) cursor)
  )
  (fn-do + rewind _
    (param mark StreamMark)
    (call validate-stream-mark mark (as this Pointer))
    (throw (call Panic "Stream mark is no longer valid") (if (> (. mark cursor) cursor)))
    (blank)
    (= cursor (. mark cursor))
  )
  (fn-expr + capture-span (? (of CaptureSpan Char))
    (param mark StreamMark)
    null
  )
  (fn-do + scan-span (of CaptureSpan Char)
    (param during (of Predicate Char))
    (let text (call read (:during during)))
    (if text
      (let source (call (of Array Char) text))
      (return (call (of CaptureSpan Char) source 0 (. source size)))
    )
    (return (call (of CaptureSpan Char) ([] Char 0) 0 0))
  )
  (fn-do + (prefix <- this) _
    (if (< cursor length)
      (let item (call char-at cursor))
      (+= cursor (call char-size cursor))
      (if (> cursor cursor-extent)
        (= cursor-extent cursor)
      )
      (return item)
    )
  )
  (fn-do + read Size
    (param size Size)
    (param receiver ([] Char))
    (param should-read-once _ (= false))
    (let count Size 0)
    (while (and (< count size) (< cursor length))
      (= ([] receiver count) (call char-at cursor))
      (+= cursor (call char-size cursor))
      (+= count 1)
    )
    (if (> cursor cursor-extent)
      (= cursor-extent cursor)
    )
    (return count)
  )
  (fn-do + match-literal Bool
    (param literal ([] Char))
    (let probe cursor)
    (let matched true)
    (for (in item literal)
      (if (>= probe length)
        (= matched false)
        (break)
      )
      (if (!= (call char-at probe) item)
        (= matched false)
      )
      (+= probe (call char-size probe))
    )
    (if (> probe cursor-extent)
      (= cursor-extent probe)
    )
    (if matched
      (= cursor probe)
    )
    (return matched)
  )
  (fn-do + read (? String)
    (param during (of Predicate Char))
    (let start cursor)
    (let stopped false)
    (while (< cursor length)
      (if (not (call during (call char-at cursor)))
        (= stopped true)
        (break)
      )
      (+= cursor (call char-size cursor))
    )
    (if (> cursor cursor-extent)
      (= cursor-extent cursor)
    )
    (if (or (> cursor start) stopped)
      (return (call (. bytes slice-string) (..< start cursor)))
    )
  )
  (fn-expr _ char-size Size
    (param index Index)
    (case? (< lead 0x80)
      1
    )
    (case? (< lead 0xE0)
      2
    )
    (case? (< lead 0xF0)
      3
    )
    (default
      4
    )
    (where
      (lazy lead (as ([] bytes index) U32))
    )
  )
  (fn-do _ char-at Char
    (param index Index)
    (let lead (as ([] bytes index) U32))
    (return-if (as lead Char) (if (< lead 0x80)))
    (blank)
    (let width (call char-size index))
    (let value (/and/ lead (/rshift/ 0x7F (as width U32))))
    (for (in offset (..< 1 width))
      (= value (/or/ (/lshift/ value 6) (/and/ (as ([] bytes (+ index offset)) U32) 0x3F)))
    )
    (return (as value Char))
  )
  (fn-do _ char-start Index
    (param target Index)
    (let start target)
    (while (and (> start 0) (< start length) (== (/and/ (as ([] bytes start) U32) 0xC0) 0x80))
      (-= start 1)
    )
    (return start)
  )
  (fn-expr _ last-location TokenLocation :get
    (case? (== cursor 0)
      (tuple 0 0)
    )
    (default
      (call location-at (call char-start (- cursor 1)))
    )
  )
  (fn-do _ location-at TokenLocation
    (param target Index)
    (let end (if-expr (< target length) target length))
    (call ensure-line-starts end)
    (let low Index 0)
    (let high Index line-start-count)
    (while (< (+ low 1) high)
      (let middle (/ (+ low high) 2))
      (if (<= ([] line-starts middle) end)
        (= low middle)
        (else
          (= high middle)
        )
      )
    )
    (let from ([] line-starts low))
    (let column Size 0)
    (if (and (== low cached-line) (>= cached-target from) (<= cached-target end))
      (= from cached-target)
      (= column cached-column)
    )
    (for (in index (..< from end))
      (if (!= (/and/ (as ([] bytes index) U32) 0xC0) 0x80)
        (+= column 1)
      )
    )
    (= cached-target end)
    (= cached-line low)
    (= cached-column column)
    (return (call TokenLocation (as low U32) (as (- (+ column target) end) U32)))
  )
  (fn-do _ ensure-line-starts _
    (param target Index)
    (if (== line-start-count 0)
      (= line-starts ([] Index 8))
      (= ([] line-starts 0) 0)
      (= line-start-count 1)
    )
    (if (<= target location-scanned)
      (return)
    )
    (for (in index (..< location-scanned target))
      (let item (as ([] bytes index) U32))
      (if (or (== item 10) (and (== item 13) (or (>= (+ index 1) length) (!= (as ([] bytes (+ index 1)) U32) 10))))
        (if (>= line-start-count (. line-starts size))
          (= line-starts (call (. line-starts resize) (* (. line-starts size) 2)))
        )
        (= ([] line-starts line-start-count) (+ index 1))
        (+= line-start-count 1)
      )
    )
    (= location-scanned target)
  )
)

(type + (of ChunkedTokenStream Token) (is (of IndexableTokenStream Token))
  (implements (of Iterable Token))
  (prop + failure (? Error))
  (blank)
  (prop _ iterable-source (? (of Iterable Token)))
  (prop _ generator-source (? (of Generator Token)))
  (prop _ byte-source (? ByteReadable))
  (prop _ source-complete Bool)
  (prop _ fraction-buffer _ (= ([] Byte 32)))
  (prop _ fraction-length Size)
  (prop _ raw-buffer _ (= ([] Byte 0)))
  (prop _ read-buffer _ (= ([] Token 0)))
  (prop _ released-count Index)
  (prop _ pin _ (= (. Index max)))
  (prop _ holding Bool)
  (fn-do + This _
    (param source (of Iterable Token))
    (call super ([] Token 0))
    (= iterable-source source)
  )
  (fn-do + This _
    (param source (of Generator Token))
    (call super ([] Token 0))
    (= generator-source source)
  )
  (fn-do + This _
    (param source ByteReadable)
    (call super ([] Token 0))
    (= byte-source source)
  )
  (fn-do + pattern-extend Bool
    (let old-length length)
    (if (not source-complete)
      (= holding true)
      (call refill pattern-refill-size)
      (= holding false)
    )
    (return (> length old-length))
  )
  (fn-expr _ pattern-refill-size Size :get
    (case? (not byte-source)
      1
    )
    (case? (> pending chunk-size)
      pending
    )
    (default
      chunk-size
    )
    (where
      (lazy pending (- length cursor))
    )
  )
  (fn-do + pattern-release _
    (= pin (. Index max))
    (call pattern-release-unmarked)
  )
