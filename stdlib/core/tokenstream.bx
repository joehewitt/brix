(fn-expr _ (of token-buffer-capacity Num) _
  (param n Num)
  (if-expr (== shift bit-width) (as 0 Num) (/lshift/ (as 1 Num) shift))
  (where
    (lazy shift (- bit-width (call count-leading-zeros (as (- n 1) Num))))
    (lazy bit-width (* (. (type-of n) size) 8))
  )
)

(fn-expr _ is-code Bool
  (param item Char)
  (param code U32)
  (== (as item U32) code)
)

(fn-expr _ is-code Bool
  (param item Byte)
  (param code U32)
  (== item code)
)

(fn-expr _ (of is-code Item) Bool
  (param item Item)
  (param code U32)
  false
)

(fn-do _ count-char-breaks (tuple Index Index)
  (param data ([] Char))
  (param start Index)
  (param count Index)
  (param end Index)
  (let lines Index 0)
  (let line-start start)
  (for (in i (..< start count))
    (let code (as ([] data i) U32))
    (if (<= code 13)
      (if (or (== code 10) (and (== code 13) (or (>= (+ i 1) end) (!= (as ([] data (+ i 1)) U32) 10))))
        (+= lines 1)
        (= line-start (+ i 1))
      )
    )
  )
  (return (tuple lines line-start))
)

(fn-expr _ (of count-char-breaks Item) (tuple Index Index)
  (param data ([] Item))
  (param start Index)
  (param count Index)
  (param end Index)
  (tuple 0 start)
)
