(import ./core)
(import ./number)
(import ./range)

(fn-expr + (of count-leading-zeros Num) Size
  (param value Num)
)

(fn-expr + (of gc-object-side-payload Payload) (? Payload)
  (param owner Pointer)
  (param lane Size)
)

(fn-expr + (of gc-publish-object-side-payload Payload) Payload
  (param owner Pointer)
  (param lane Size)
  (param payload Payload)
)

(fn-expr + (of gc-object-from-pointer Obj) Obj
  (param pointer Pointer)
)

(fn-expr + (of interface-witness-pointer Obj) Pointer
  (param object Obj)
)

(fn-expr + (of gc-interface-from-pointer Obj) Obj
  (param pointer Pointer)
  (param witness Pointer)
)

(fn-expr + (of event-invoke-lowered Payload) _
  (param callback Pointer)
  (param owner Pointer)
  (param payload Payload)
)
