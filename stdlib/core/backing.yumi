━━━━━━━━━━━━━━━━━━━━
+ GCBacking
    is StorageBacking

+ Context = Void
+ Storage'Item = CPointer'Item

────────────────────
+ static do allocate'Item CPointer'Item
    - context Void
    - capacity Size

?! Panic("Array size overflow")
    if capacity != 0 && capacity > Size.max / Item.size
?! Panic("Array allocation failed")
    if capacity != 0 && storage.address == 0
= storage as CPointer'Item

.. storage = C:yumiAllocBuffer(Item.size, capacity)

────────────────────
+ static load'Item Item @inline
    - storage CPointer'Item
    - index Index

storage[index]

────────────────────
+ static do store'Item Void @inline
    - storage CPointer'Item
    - item Item
    - index Index

storage[index] = item

────────────────────
+ static resize'Item CPointer'Item
    - storage CPointer'Item
    - context Void
    - size Size
    - new-size Size

?! Panic("Array size overflow")
    if size != 0 && size > Size.max / Item.size
?! Panic("Array size overflow")
    if new-size != 0 && new-size > Size.max / Item.size
?! Panic("Array resize failed")
    if new-size != 0 && replacement.address == 0

replacement as CPointer'Item

.. old-byte-size = Item.size * size
.. new-byte-size = Item.size * new-size
.. replacement = C:yumiResizeBuffer(storage, old-byte-size, new-byte-size)
