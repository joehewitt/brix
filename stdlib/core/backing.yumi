/BxCore/BxCore.h

━━━━━━━━━━━━━━━━━━━━
+ ArrayStorageProvider is Interface

+ Backing'Item

━━━━━━━━━━━━━━━━━━━━
+ StorageBacking is Interface

+ Context
+ Storage'Item

────────────────────
+ static allocate'Item This.Storage'Item
    - context This.Context
    - capacity Size

────────────────────
+ static load'Item Item
    - storage This.Storage'Item
    - index Index

────────────────────
+ static store'Item Void
    - storage This.Storage'Item
    - item Item
    - index Index

━━━━━━━━━━━━━━━━━━━━
+ GCBacking
    is StorageBacking

+ Context = Void
+ Storage'Item = CPointer'Item

────────────────────
+ static do allocate'Item CPointer'Item
    - context Void
    - capacity Size

?! Panic("Array size overflow")
    if capacity != 0 && capacity > Size.max / Item.size
?! Panic("Array allocation failed")
    if capacity != 0 && storage.address == 0
= storage as CPointer'Item

.. storage = C:brixAllocBuffer(Item.size, capacity)

────────────────────
+ static load'Item Item @inline
    - storage CPointer'Item
    - index Index

storage[index]

────────────────────
+ static do store'Item Void @inline
    - storage CPointer'Item
    - item Item
    - index Index

storage[index] = item
