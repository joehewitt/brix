    - memo MemoAction

do memo
mark()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get is-dirty Bool

owner[flag-offset] != 0

────────────────────
+ do mark

=? if is-closed
. found = gc-object-side-payload'(List'PropertySubscriber)(owner, property-subscribers-lane)
. linked = linked-generation(found)
=? if is-dirty && linked-at == linked
owner[flag-offset] = 1
linked-at = linked
=? if !found
. subscribers = found
. batch = live-batch-enter()
do finally
    batch.leave()
property-notify(subscribers, name, this)

────────────────────
+ do settle

=? if !is-dirty
owner[flag-offset] = 0
=? if is-closed
refresh-trackers()

━━━━━━━━━━━━━━━━━━━━
_ linked-generation U64
    - subscribers [PropertySubscriber]?

if subscribers && subscribers.length != 0 then subscribers[0].handle else 0

━━━━━━━━━━━━━━━━━━━━
+ do memo-settle-at
    - owner Pointer
    - flag-offset Size

. found = gc-object-side-payload'(List'LiveAction)(owner, live-actions-lane)
if found
    . actions = found
    for action in actions
        if action is MemoAction
            . memo = action as MemoAction
            if memo.flag-offset == flag-offset
                memo.settle()
                =
owner[flag-offset] = 0

━━━━━━━━━━━━━━━━━━━━
+ LiveBatch

+ depth Size = 0
_ queue [LiveAction?]

────────────────────
+ do add
    - action LiveAction

queue += action

────────────────────
+ do leave

depth -= 1
if depth == 0 && queue.length != 0
    run()

────────────────────
_ do run

depth = 1
do finally
    depth = 0
    for slot in 0 .. < queue.length
        queue[slot] = null
    queue.clear()
. index Index = 0
while index < queue.length
    ?! Panic("Live actions kept changing what they read and never settled")
        if index >= live-batch-run-limit
    . action = queue[index]
    index += 1
    if action
        action.run-queued()

━━━━━━━━━━━━━━━━━━━━
+ do live-batch-enter LiveBatch @inline

. batch = task-live-batch()
batch.depth += 1
= batch

━━━━━━━━━━━━━━━━━━━━
_ do task-live-batch LiveBatch @inline

. found = live-batch
=? found if found
= first-live-batch()

━━━━━━━━━━━━━━━━━━━━
_ do first-live-batch LiveBatch

. made = LiveBatch()
live-batch = made
= made

━━━━━━━━━━━━━━━━━━━━
+ do property-dispatch
    - subscribers [PropertySubscriber]
    - name String

//markup.property.dispatches ++
//markup.property.snapshot-allocations += 0
=? if !subscribers
. batch = live-batch-enter()
do finally
    batch.leave()
property-notify(subscribers, name, null)

━━━━━━━━━━━━━━━━━━━━
_ do property-notify
    - subscribers [PropertySubscriber]
    - name String
    - memo MemoAction?

. sentinel = subscribers[0]
. boundary = sentinel.handle
subscribers[0] = ("", boundary, sentinel.slot + 1, sentinel.prev, sentinel.next, sentinel.free)

. slot = sentinel.next
while slot
    //markup.property.subscriber-scans ++
    . subscriber = subscribers[slot]
    if subscriber.handle
        if subscriber.free > boundary
            //markup.property.generation-skips ++
            break
        if subscriber.name == name
            . subscription = property-subscriber-load(subscriber.handle)
            if subscription
                if memo
                    subscription.notify-maybe(memo)
                else
                    subscription()
            else
                do property-subscriber-unlink(subscribers, subscriber.slot, subscriber.handle)
                do property-subscriber-release(subscriber.handle)
    slot = subscriber.next

sentinel = subscribers[0]
. exited = ("", sentinel.handle, sentinel.slot - 1, sentinel.prev, sentinel.next, sentinel.free)
subscribers[0] = exited

━━━━━━━━━━━━━━━━━━━━
+ do property-dependency-subscribe LiveAction
    - object
    - name String
    - callback Doer

. sub-trackers = List'Tracker()
. sub-callback SubscriberCallback = => do
    callback()
. sub = LiveAction(sub-trackers, sub-callback)

do link-property-dependency(object, name, sub)
= sub

━━━━━━━━━━━━━━━━━━━━
+ do link-property-dependency'Object
    - object Object
    - name String
    - action LiveAction

. subscription = property-subscriber-register(object as Pointer, action)
?! Panic("Unable to register weak property dependency subscription")
    if !subscription
do property-subscriber-link(object.property-subscribers, name, subscription)
