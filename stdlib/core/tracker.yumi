+ do attach
    - action LiveAction

//markup.action.tracker-attaches ++
. action-id = action.tracker-id
if action-id
    ?! Panic("Property tracker is already attached to this action")
        if subscription-action == action-id
    if additional-subscriptions
        for attached in additional-subscriptions
            ?! Panic("Property tracker is already attached to this action")
                if attached.action == action-id

. handle = property-subscriber-register(owner, action)
?! Panic("Unable to register property subscription")
    if !handle
if !action-id
    action-id = handle
    action.tracker-id = action-id
. slot = property-subscriber-link(subscribers, name, handle, action.dispatches-first)
if !subscription
    subscription = handle
    subscriber-slot = slot
    subscription-action = action-id
else
    if !additional-subscriptions
        additional-subscriptions = List'PropertyTrackerSubscription()
    additional-subscriptions! += (action-id, handle, slot)

────────────────────
+ do detach
    - action LiveAction

//markup.action.tracker-detaches ++
do action

. action-id = action.tracker-id
=? if !action-id
if subscription-action == action-id
    . handle = subscription
    . slot = subscriber-slot
    subscription = 0
    subscriber-slot = 0
    subscription-action = 0

    do property-subscriber-unlink(subscribers, slot, handle)
    do property-subscriber-release(handle)
    =

if additional-subscriptions
    . index Index = 0
    while index < additional-subscriptions!.length
        . attached = additional-subscriptions![index]
        if attached.action == action-id
            additional-subscriptions!.remove(index)
            do property-subscriber-unlink(subscribers, attached.slot, attached.handle)
            do property-subscriber-release(attached.handle)
            =
        index += 1

