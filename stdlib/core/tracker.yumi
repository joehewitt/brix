_ do track-property-key Tracker
    - previous [Tracker]
    - next [Tracker]
    - name String
    - property-id Size
    - subscribers [PropertySubscriber]
    - owner Pointer
    - is-dynamic-name Bool

` Repeated reads in one evaluation are one dependency membership. This also avoids attaching the
` same retained tracker twice when an authored expression reads one property more than once.
for tracker in next
    //markup.action.tracker-scans ++
    if property-dependency-matches(tracker, owner, property-id, name, is-dynamic-name)
        //markup.action.tracker-reused ++
        = tracker

` Stable dependency order is the common path, so try the corresponding old slot before the
` fallback scan. The fallback preserves reuse for reordered and conditionally inserted reads.
. expected = next.length
if expected < previous.length
    //markup.action.tracker-scans ++
    . tracker = previous[expected]
    if property-dependency-matches(tracker, owner, property-id, name, is-dynamic-name)
        next += tracker
        //markup.action.tracker-reused ++
        = tracker

for tracker in previous
    //markup.action.tracker-scans ++
    if property-dependency-matches(tracker, owner, property-id, name, is-dynamic-name)
        next += tracker
        //markup.action.tracker-reused ++
        = tracker

. property = PropertyTracker(name, property-id, subscribers)
property.owner = owner
property.is-dynamic-name = is-dynamic-name
next += property
//markup.action.tracker-added ++
= property

