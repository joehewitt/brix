is-definite = false
maybe-from = null

────────────────────
+ do run-now

=? if is-closed
refresh-trackers()
//markup.action.immediate-runs ++

────────────────────
+ do refresh-trackers

. buffer = next-trackers ?? List'Tracker()
next-trackers = buffer
refresh-trackers-into(buffer, true)

────────────────────
_ do refresh-trackers-into
    - new-trackers [Tracker]
    - recycle Bool

new-trackers.clear()
. completed = false
do finally
    if !completed
        new-trackers.clear()

. saved-previous = tracker-action-previous
. saved-next = tracker-action-next
tracker-action-previous = trackers
tracker-action-next = new-trackers
do finally
    tracker-action-previous = saved-previous
    tracker-action-next = saved-next

callback()
    catch error Error
        unhandled-error(error)
//markup.action.runs ++
//markup.action.tracker-old += trackers.length
//markup.action.tracker-new += new-trackers.length

if is-detached
    is-detached = false
    for tracker in new-trackers
        tracker.attach(this)
else if trackers.length > 16 || new-trackers.length > 16
    ` Large or shared dependency sets use pointer-keyed membership tables, avoiding quadratic
    ` removal and insertion scans. Small sets stay allocation-free and favor their linear cache.
    . old-members = Map'Pointer'Bool()
    . new-members = Map'Pointer'Bool()
    for tracker in trackers
        old-members[tracker as Pointer] = true
    for tracker in new-trackers
        new-members[tracker as Pointer] = true

    for tracker in trackers
        if !(new-members has (tracker as Pointer))
            tracker.detach(this)
            //markup.action.tracker-removed ++

    for tracker in new-trackers
        if !(old-members has (tracker as Pointer))
            tracker.attach(this)
else
    for tracker in trackers
        if !tracker-list-has(new-trackers, tracker)
            tracker.detach(this)
            //markup.action.tracker-removed ++

    for tracker in new-trackers
        if !tracker-list-has(trackers, tracker)
            tracker.attach(this)

. old-trackers = trackers
trackers = new-trackers
if recycle
    old-trackers.clear()
    next-trackers = old-trackers
completed = true

────────────────────
+ do detach-trackers

=? if is-detached
is-detached = true
for tracker in trackers
    tracker.detach(this)

────────────────────
+ do close

if !is-closed
    is-closed = true
    detach-trackers()
    trackers.clear()
    next-trackers?.clear()

