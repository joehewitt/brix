+ do live-state'State State?
    - State is Tracker

=? null if !tracker-action-previous || !tracker-action-next
. previous = tracker-action-previous!
. next = tracker-action-next!
for tracker in previous
    if tracker is State && !tracker-list-has(next, tracker)
        next += tracker
        = tracker as State
= null

