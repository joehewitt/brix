━━━━━━━━━━━━━━━━━━━━
_ do property-subscriber-link Index
    - subscribers [PropertySubscriber]
    - name String
    - subscription U64
    - leads = false

if !subscribers
    subscribers += ("", 0, 0, 0, 0, 0)

. sentinel = subscribers[0]
. head = sentinel.next
. tail = sentinel.prev
. next-free = sentinel.free
. generation = sentinel.handle + 1
?! Panic("Property subscriber generation overflow")
    if !generation
. slot Index = 0
if sentinel.free && !sentinel.slot
    slot = sentinel.free
    next-free = subscribers[slot].free
    //markup.property.slot-reuses ++
else
    slot = subscribers.length
    subscribers += ("", 0, slot, 0, 0, 0)

if leads
    subscribers[slot] = (name, subscription, slot, 0, head, generation as Index)
    if head
        . h = subscribers[head]
        subscribers[head] = (h.name, h.handle, h.slot, slot, h.next, h.free)
    else
        tail = slot
    subscribers[0] = ("", generation, sentinel.slot, tail, slot, next-free)
    = slot

subscribers[slot] = (name, subscription, slot, tail, 0, generation as Index)
if tail
    . tail-entry = subscribers[tail]
    . t = tail-entry
    . linked-tail = (t.name, t.handle, t.slot, t.prev, slot, t.free)
    subscribers[tail] = linked-tail
else
    head = slot
subscribers[0] = ("", generation, sentinel.slot, slot, head, next-free)
= slot

━━━━━━━━━━━━━━━━━━━━
+ do property-observed Bool
    - owner Pointer
    - name String

. found = gc-object-side-payload'(List'PropertySubscriber)(owner, property-subscribers-lane)
=? if !found
. subscribers = found
=? if !subscribers.length
. slot = subscribers[0].next
while slot
    . subscriber = subscribers[slot]
    =? true
        if subscriber.handle && subscriber.name == name
    slot = subscriber.next
= false

━━━━━━━━━━━━━━━━━━━━
_ do property-subscriber-unlink Bool
    - subscribers [PropertySubscriber]
    - slot Index
    - subscription U64

if !subscribers || !slot || slot >= subscribers.length
    = false

. subscriber = subscribers[slot]
if subscriber.handle != subscription
    = false

. sentinel = subscribers[0]
. head = sentinel.next
. tail = sentinel.prev
if subscriber.prev
    . prev-slot = subscriber.prev
    . prev-entry = subscribers[prev-slot]
    . prev-next = subscriber.next
    . p = prev-entry
    . linked-prev = (p.name, p.handle, p.slot, p.prev, prev-next, p.free)
    subscribers[prev-slot] = linked-prev
else
    head = subscriber.next

if subscriber.next
    . next-slot = subscriber.next
    . next-entry = subscribers[next-slot]
    . n = next-entry
    . linked-next = (n.name, n.handle, n.slot, subscriber.prev, n.next, n.free)
    subscribers[next-slot] = linked-next
else
    tail = subscriber.prev

subscribers[slot] = ("", 0, slot, subscriber.prev, subscriber.next, sentinel.free)
subscribers[0] = ("", sentinel.handle, sentinel.slot, tail, head, slot)
//markup.property.slot-unlinks ++
= true

