(import ./arena)
(import ./array)
(import ./backing)
(import ./collection)
(import ./core)
(import ./error)
(import ./list)
(import ./number)
(import ./range)
(import ./stream)
(import ./string)

(type + (of ArrayBuilder Item Backing) (is Tuple)
  (constraint = Backing GCBacking)
  (constraint is Backing StorageBacking)
  (implements (of Indexable Item))
  (implements Inspectable)
  (prop _ header (of CPointer Byte))
  (prop _ context (. Backing Context))
  (fn-do + This _
    (constraint = Backing GCBacking)
    (return (call This (as (call (of (. GCBacking allocate) ArrayBuilderHeader) (call Void) 1) (of CPointer Byte)) (call Void)))
  )
  (fn-do + (of This Storage) _
    (param storage Storage)
    (constraint is Storage ArrayStorageProvider)
    (constraint = Backing (. Storage (of Backing Item)))
    (constraint is Backing StorageBacking)
    (let context (as storage (. Backing Context)))
    (return (call This (as (call (of (. Backing allocate) ArrayBuilderHeader) context 1) (of CPointer Byte)) context))
  )
  (fn-to-expr + String
    (call (. ", " join) (as this (stream Item)))
  )
  (fn-expr + length Size :get
    current-size
  )
  (fn-expr + mark Size :get
    current-size
  )
  (fn-expr _ current-items (of Array Item Backing) :get
    (call (of Array Item Backing) ([] (as header (of CPointer (of CPointer Item))) 0) ([] (as (+ header 8) (of CPointer Size)) 0))
  )
  (fn-expr _ current-size Size :get
    ([] (as (+ header 16) (of CPointer Size)) 0)
  )
  (fn-expr _ current-mutation-generation Size :get
    ([] (as (+ header 24) (of CPointer Size)) 0)
  )
  (fn-expr _ storage-identity (of CPointer Byte) :get
    header
  )
  (fn-expr + (index-get this (param index Index)) _
    (before
      (throw (call OutOfBoundsError (str "ArrayBuilder index " index " out of range")) (if (>= (as index UInt) (as active-size UInt))))
    )
    ([] active-items index)
    (where
      (lazy active-size current-size)
      (lazy active-items current-items)
    )
  )
  (fn-expr + (index-get this (param position Position)) _
    ([] this (call (. position normalize) this))
  )
  (fn-do + (index-set this (param index Index) (param item Item)) _
    (let active-items current-items)
    (let active-size current-size)
    (throw (call OutOfBoundsError (str "ArrayBuilder index " index " out of range")) (if (>= (as index UInt) (as active-size UInt))))
    (blank)
    (= ([] active-items index) item)
  )
  (fn-do + append _
    (param item Item)
    (let active-items current-items)
    (let active-size current-size)
    (throw (call Panic "ArrayBuilder size overflow") (if (== active-size (. Size max))))
    (blank)
    (if (== active-size (. active-items length))
      (let next-capacity (call next-sequence-capacity (. active-items length) (+ active-size 1)))
      (= active-items (call (. active-items resize) next-capacity context))
      (call store-items active-items)
    )
    (= ([] active-items active-size) item)
    (call store-size (+ active-size 1))
  )
  (fn-do + append-all _
    (param appended (stream Item))
    (for (in item appended)
      (call append item)
    )
  )
  (fn-do + reserve _
    (param capacity Size)
    (let active-items current-items)
    (if (> capacity (. active-items length))
      (call store-items (call (. active-items resize) capacity context))
    )
  )
  (fn-do + rewind _
    (param mark Size)
    (let active-items current-items)
    (let active-size current-size)
    (let active-mutation-generation current-mutation-generation)
    (throw (call OutOfBoundsError (str "ArrayBuilder mark " mark " out of range")) (if (> mark active-size)))
    (blank)
    (for (in index (..< mark active-size))
      (call (. active-items zero) index)
    )
    (call replace-state active-items mark (+ active-mutation-generation 1))
  )
  (fn-do + clear _
    (call rewind 0)
  )
  (fn-do + finish-immutable (of ImmutableArray Item Backing)
    (return (. (call finish-mutable) immutable))
  )
  (fn-do + finish-immutable-compacted (of ImmutableArray Item Backing)
    (return (. (call finish-mutable-compacted) immutable))
  )
  (fn-do + finish-mutable (of Array Item Backing)
    (let result (of Array Item Backing))
    (let active-items current-items)
    (let active-size current-size)
    (let active-mutation-generation current-mutation-generation)
    (if (== active-size 0)
      (= result (call (of Array Item Backing) (as (call (of (. Backing allocate) Item) context 0) (of CPointer Item)) 0))
      (else
        (= result ([] active-items (..< 0 active-size)))
      )
    )
    (call replace-state (call (of Array Item Backing) (as 0 (of CPointer Item)) 0) 0 (+ active-mutation-generation 1))
    (return result)
  )
  (fn-do + finish-mutable-compacted (of Array Item Backing)
    (let result (of Array Item Backing))
    (let active-items current-items)
    (let active-size current-size)
    (let active-mutation-generation current-mutation-generation)
    (if (== active-size 0)
      (= result (call (of Array Item Backing) (as (call (of (. Backing allocate) Item) context 0) (of CPointer Item)) 0))
      (else-if (== (. active-items length) active-size)
        (= result active-items)
      )
      (else
        (= result (call (. ([] active-items (..< 0 active-size)) copy) context))
      )
    )
    (call replace-state (call (of Array Item Backing) (as 0 (of CPointer Item)) 0) 0 (+ active-mutation-generation 1))
    (return result)
  )
  (fn-do + storage-checkpoint (of ArrayBuilderStorageCheckpoint Item Backing) (without gc)
    (param arena Arena)
    (param mark ArenaMark)
    (throw (call Panic "ArrayBuilder storage checkpoints require Arena-backed storage") (if (!= Backing ArenaBacking)))
    (blank)
    (let saved-items current-items)
    (throw (call Panic "ArrayBuilder storage checkpoint mark is stale or belongs to another Arena") (if (not (call (. arena owns) storage-identity))))
    (throw (call Panic "ArrayBuilder storage checkpoint mark is stale or belongs to another Arena") (if (!= (. mark value) (. arena mark value))))
    (blank)
    (return
      (call (of ArrayBuilderStorageCheckpoint Item Backing)
        (block
          (arg saved-items)
          (arg current-size)
          (arg storage-identity)
          (arg current-mutation-generation)
          (arg (. arena generation))
          (arg (. mark value))
          (arg (. arena active-bytes))
        )
      )
    )
  )
  (fn-do + validate-storage-restore _ (without gc)
    (param checkpoint (of ArrayBuilderStorageCheckpoint Item Backing))
    (param arena Arena)
    (param mark ArenaMark)
    (throw (call Panic "ArrayBuilder storage checkpoint is stale or belongs to another builder") (if (!= Backing ArenaBacking)))
    (throw (call Panic "ArrayBuilder storage checkpoint is stale or belongs to another builder") (if (== (. checkpoint storage-identity address) 0)))
    (throw (call Panic "ArrayBuilder storage checkpoint is stale or belongs to another builder") (if (!= (. storage-identity address) (. checkpoint storage-identity address))))
    (throw (call Panic "ArrayBuilder storage checkpoint is stale or belongs to another builder") (if (!= (. checkpoint storage-mutation-generation) current-mutation-generation)))
    (throw (call Panic "ArrayBuilder storage checkpoint is stale or belongs to another builder") (if (> (. checkpoint size) current-size)))
    (throw (call Panic "ArrayBuilder storage checkpoint is stale or belongs to another builder") (if (!= (. checkpoint arena-generation) (. arena generation))))
    (throw (call Panic "ArrayBuilder storage checkpoint is stale or belongs to another builder") (if (!= (. checkpoint arena-mark) (. mark value))))
    (throw (call Panic "ArrayBuilder storage checkpoint is stale or belongs to another builder") (if (> (. checkpoint arena-active-bytes) (. arena active-bytes))))
    (throw (call Panic "ArrayBuilder storage checkpoint is stale or belongs to another builder") (if (not (call (. arena owns) (. checkpoint storage-identity)))))
  )
  (fn-do + restore-storage _ (without gc)
    (param checkpoint (of ArrayBuilderStorageCheckpoint Item Backing))
    (param arena Arena)
    (param mark ArenaMark)
    (throw (call Panic "ArrayBuilder storage checkpoint cannot be restored from the current Arena state") (if (!= Backing ArenaBacking)))
    (throw (call Panic "ArrayBuilder storage checkpoint cannot be restored from the current Arena state") (if (== (. checkpoint storage-identity address) 0)))
    (throw (call Panic "ArrayBuilder storage checkpoint cannot be restored from the current Arena state") (if (!= (. storage-identity address) (. checkpoint storage-identity address))))
    (throw (call Panic "ArrayBuilder storage checkpoint cannot be restored from the current Arena state") (if (!= (. checkpoint storage-mutation-generation) current-mutation-generation)))
    (throw (call Panic "ArrayBuilder storage checkpoint cannot be restored from the current Arena state") (if (> (. checkpoint size) current-size)))
    (throw (call Panic "ArrayBuilder storage checkpoint cannot be restored from the current Arena state") (if (!= (. checkpoint arena-generation) (. arena generation))))
    (throw (call Panic "ArrayBuilder storage checkpoint cannot be restored from the current Arena state") (if (!= (. checkpoint arena-mark) (. mark value))))
    (throw (call Panic "ArrayBuilder storage checkpoint cannot be restored from the current Arena state") (if (!= (. checkpoint arena-active-bytes) (. arena active-bytes))))
    (throw (call Panic "ArrayBuilder storage checkpoint cannot be restored from the current Arena state") (if (not (call (. arena owns) (. checkpoint storage-identity)))))
    (throw (call Panic "ArrayBuilder storage generation overflow") (if (== (. checkpoint storage-mutation-generation) (. Size max))))
    (blank)
    (call replace-state (. checkpoint items) (. checkpoint size) (+ (. checkpoint storage-mutation-generation) 1))
  )
  (fn-do + inspectable-snapshot _
    (probe-assign (: this array-builder.length) length)
    (for (in item this)
      (probe-log (: this array-builder.item) (items: item))
    )
  )
  (fn-do _ store-items _
    (param next-items (of Array Item Backing))
    (call (of (. Backing store) (of CPointer Byte))
      (block
        (arg (as header (of CPointer (of CPointer Byte))))
        (arg (as (. next-items data) (of CPointer Byte)))
        (arg 0)
      )
    )
    (= ([] (as (+ header 8) (of CPointer Size)) 0) (. next-items length))
  )
  (fn-do _ store-size _
    (param next-size Size)
    (= ([] (as (+ header 16) (of CPointer Size)) 0) next-size)
  )
  (fn-do _ replace-state _
    (param next-items (of Array Item Backing))
    (param next-size Size)
    (param next-mutation-generation Size)
    (call store-items next-items)
    (call store-size next-size)
    (= ([] (as (+ header 24) (of CPointer Size)) 0) next-mutation-generation)
  )
  (fn-expr _ initial-sequence-capacity Size
    (case? (<= (. Item size) 16)
      8
    )
    (case? (<= (. Item size) 1024)
      4
    )
    (default
      1
    )
  )
  (fn-do _ next-sequence-capacity Size
    (param current Size)
    (param needed Size)
    (let capacity Size)
    (if (== current 0)
      (= capacity (call initial-sequence-capacity))
      (else-if (< current 1024)
        (throw (call Panic "ArrayBuilder size overflow") (if (> current (/ (. Size max) 2))))
        (blank)
        (= capacity (* current 2))
      )
      (else
        (let half (/ current 2))
        (throw (call Panic "ArrayBuilder size overflow") (if (> current (- (. Size max) half))))
        (blank)
        (= capacity (+ current half))
      )
    )
    (if (< capacity needed)
      (= capacity needed)
    )
    (return capacity)
  )
)

(type + (of ArrayBuilderStorageCheckpoint Item Backing) (is Tuple)
  (constraint is Backing StorageBacking)
  (prop _ items (of Array Item Backing))
  (prop _ size Size)
  (prop _ storage-identity (of CPointer Byte))
  (prop _ storage-mutation-generation Size)
  (prop _ arena-generation Size)
  (prop _ arena-mark Size)
  (prop _ arena-active-bytes Size)
)

(extend + (of ImmutableArray ''Item ''Backing)
  (fn-do + This _ @inline
    (param items (stream Item))
    (param capacity Size (= 0))
    (constraint = Backing GCBacking)
    (let result (call (of Array Item) items capacity))
    (return (. result immutable))
  )
  (fn-do + (of This Provider) _ @inline
    (param provider Provider)
    (param items (stream Item))
    (param capacity Size (= 0))
    (constraint is Provider ArrayStorageProvider)
    (constraint = Backing (. Provider (of Backing Item)))
    (let result (call (of Array Item) provider items capacity))
    (return (. result immutable))
  )
)

(extend + (of Array ''Value ''Backing)
  (fn-do + This _ @inline
    (param items (stream Value))
    (param capacity Size (= 0))
    (constraint = Backing GCBacking)
    (let builder (? (of ArrayBuilder Value Backing)))
    (blank)
    (for (in item items)
      (if (not builder)
        (= builder (call (of ArrayBuilder Value Backing)))
        (call (. builder reserve) capacity)
      )
      (call (. builder append) item)
    )
    (blank)
    (case? builder
      (return (call (. builder finish-mutable)))
    )
    (default
      (return (call This (as 0 (of CPointer Value)) 0))
    )
  )
  (fn-do + (of This Provider) _ @inline
    (param provider Provider)
    (param items (stream Value))
    (param capacity Size (= 0))
    (constraint is Provider ArrayStorageProvider)
    (constraint = Backing (. Provider (of Backing Value)))
    (let builder (? (of ArrayBuilder Value Backing)))
    (blank)
    (for (in item items)
      (if builder
        (call (. builder append) item)
        (else
          (= builder (call (of ArrayBuilder Value) provider))
          (call (. builder reserve) capacity)
          (call (. builder append) item)
        )
      )
    )
    (blank)
    (case? builder
      (return (call (. builder finish-mutable)))
    )
    (default
      (return (call This (as 0 (of CPointer Value)) 0))
    )
  )
)

(type _ ArrayBuilderHeader (is Tuple)
  (prop _ data (of CPointer Byte))
  (prop _ capacity Size)
  (prop _ size Size)
  (prop _ mutation-generation Size)
)
