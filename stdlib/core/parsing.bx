(import ./array)
(import ./backing)
(import ./core)
(import ./error)
(import ./function)
(import ./number)
(import ./range)
(import ./stream)
(import ./string)
(import /string.h)
(blank)
(type-line + MatchLocation (is (tuple (: begin TokenLocation) (: end TokenLocation))))
(type-line + TokenLocation (is (tuple (: line U32) (: column U32))))
(type-line + StreamMark (is (tuple (: owner Pointer) (: cursor Index))))
(type-line + (of PatternMaterializationRoot Primary) (is Interface))
(type-line _ PatternCaptureRange (is (tuple (: start Index) (: end Index))))

(type + (of PatternRollback Mark) (is Interface)
  (fn-expr + mark Mark)
  (fn-do + rewind _
    (param mark Mark)
  )
)

(type + PatternLiteralObserver (is Interface)
  (fn-do + record-pattern-literal _
    (param start Index)
    (param end Index)
  )
  (fn-do + rewind-pattern-literals _
    (param cursor Index)
  )
)

(type + (of PatternCaptureMaterializer Item Value) (is Interface)
  (fn-expr + materialize-capture Value
    (param source ([] Item))
    (param start Index)
    (param end Index)
  )
)

(type + (of PatternValueMaterializer Input Value) (is Interface)
  (fn-expr + materialize-value Value
    (param input Input)
  )
)

(type + (of PatternCollectorStorage Backing) (is Interface)
  (constraint is Backing StorageBacking)
  (fn-expr + pattern-collector-context (. Backing Context) :get)
)

(type + PatternRecordBoundary (is Interface)
  (fn-do + begin-pattern-record _)
)

(type + (of CaptureSpan Token) (is Tuple)
  (prop + source ([] Token))
  (prop + start Index)
  (prop + end Index)
  (fn-to-do + String
    (probe-count grammar.capture-materializations)
    (probe-count grammar.capture-materializations.string)
    (probe-count grammar.capture-materializations.public-string)
    (probe-count grammar.capture-materialization-tokens length)
    (return (call (. source slice-string) (..< start end)))
  )
  (fn-to-do + Int
    (return-if (as (as this String) Int) (if (or (== length 0) (> length 18))))
    (let negative (== (as ([] source start) U32) (as '-' U32)))
    (let index (if-expr (or negative (== (as ([] source start) U32) (as '+' U32))) (+ start 1) start))
    (return-if (as (as this String) Int) (if (== index end)))
    (let value 0)
    (for (in offset (..< index end))
      (let digit (- (as ([] source offset) U32) (as '0' U32)))
      (return-if (as (as this String) Int) (if (> digit 9)))
      (= value (+ (* value 10) (as digit Int)))
    )
    (return (if-expr negative (- value) value))
  )
  (fn-to-do + Float
    (let index start)
    (let negative (and (< index end) (== (as ([] source index) U32) (as '-' U32))))
    (if (or negative (and (< index end) (== (as ([] source index) U32) (as '+' U32))))
      (+= index 1)
    )
    (let mantissa 0)
    (let significant 0)
    (let digits 0)
    (let scale 0)
    (let fraction false)
    (while (and (< index end) (!= (as ([] source index) U32) (as 'e' U32)) (!= (as ([] source index) U32) (as 'E' U32)))
      (let code (as ([] source index) U32))
      (if (and (== code (as '.' U32)) (not fraction))
        (= fraction true)
        (else
          (let digit (- code (as '0' U32)))
          (return-if (as (as this String) Float) (if (> digit 9)))
          (if (or (!= mantissa 0) (!= digit 0))
            (+= significant 1)
          )
          (return-if (as (as this String) Float) (if (> significant 15)))
          (= mantissa (+ (* mantissa 10) (as digit Int)))
          (+= digits 1)
          (if fraction
            (-= scale 1)
          )
        )
      )
      (+= index 1)
    )
    (return-if (as (as this String) Float) (if (== digits 0)))
    (if (< index end)
      (+= index 1)
      (let lowers (and (< index end) (== (as ([] source index) U32) (as '-' U32))))
      (if (or lowers (and (< index end) (== (as ([] source index) U32) (as '+' U32))))
        (+= index 1)
      )
      (return-if (as (as this String) Float) (if (or (== index end) (> (- end index) 4))))
      (let exponent 0)
      (while (< index end)
        (let digit (- (as ([] source index) U32) (as '0' U32)))
        (return-if (as (as this String) Float) (if (> digit 9)))
        (= exponent (+ (* exponent 10) (as digit Int)))
        (+= index 1)
      )
      (+= scale (if-expr lowers (- exponent) exponent))
    )
    (return-if (as (as this String) Float) (if (or (< scale -22) (> scale 22))))
    (let power 1.0)
    (for (in _ (..< 0 (if-expr (< scale 0) (- scale) scale)))
      (*= power 10.0)
    )
    (let value (if-expr (< scale 0) (/ (as mantissa Float) power) (* (as mantissa Float) power)))
    (return (if-expr negative (- value) value))
  )
  (fn-to-do + ([] Token)
    (probe-count grammar.capture-materializations)
    (probe-count grammar.capture-materializations.array)
    (probe-count grammar.capture-materializations.public-array)
    (probe-count grammar.capture-materialization-tokens length)
    (return (call (. ([] source (..< start end)) copy)))
  )
  (fn-expr + length Size :get
    (- end start)
  )
  (fn-expr + array ([] Token) :get
    (before
      (probe-count grammar.capture-materializations)
      (probe-count grammar.capture-materializations.rollback-buffer)
      (probe-count grammar.capture-materialization-tokens length)
    )
    ([] source (..< start end))
  )
  (fn-do + (infix this == (param other (of CaptureSpan Token))) _
    (if (!= length (. other length))
      (return false)
    )
    (blank)
    (for (in i (..< 0 length))
      (if (!= ([] source (+ start i)) ([] (. other source) (+ (. other start) i)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do + (infix this == (param other String)) _
    (if (== Token Byte)
      (return-if false (if (!= length (. other size))))
      (return (== (call C:memcmp (+ (. source data) start) (as other (of CPointer Byte)) length) 0))
    )
    (blank)
    (if (or (!= Token Char) (!= length (. other length)))
      (return false)
    )
    (blank)
    (if (== (. other size) length)
      (let bytes (as other (of CPointer Byte)))
      (for (in offset (..< 0 length))
        (if (!= (as (as ([] source (+ start offset)) Char) U32) (as ([] bytes offset) U32))
          (return false)
        )
      )
      (return true)
    )
    (blank)
    (let index Index)
    (for (in char other)
      (if (!= (as ([] source (+ start index)) Char) char)
        (return false)
      )
      (+= index 1)
    )
    (return true)
  )
)

(type + CaptureCount
  (prop + length Size)
  (fn-do + increment _
    (+= length 1)
  )
)

(type + (of TokenStream Token) (is Interface)
  (implements (of Readable Token))
  (fn-expr + has-more Bool :get)
  (fn-expr + pattern-view (? (tuple ([] Token) Index Size Index)) :get
    null
  )
  (fn-expr + pattern-text-view (? (tuple ([] Byte) Index Size Index)) :get
    null
  )
  (fn-expr + location TokenLocation :get)
  (fn-expr + error-location TokenLocation :get)
  (fn-do + pattern-extend Bool
    (return false)
  )
  (fn-do + pattern-commit _
    (param new-cursor Index)
    (param probe-extent Index)
  )
  (fn-expr + pattern-location-at TokenLocation
    (param target Index)
    (tuple 0 0)
  )
  (fn-expr + get-match-location MatchLocation
    (param begin-loc TokenLocation)
  )
  (fn-expr + mark StreamMark)
  (fn-expr + pattern-position StreamMark
    (call mark)
  )
  (fn-do + pattern-release-unmarked _
    (return)
  )
  (fn-expr + capture-span (? (of CaptureSpan Token))
    (param mark StreamMark)
  )
  (fn-expr + scan-span (of CaptureSpan Token)
    (param during (of Predicate Token))
  )
  (fn-expr + rewind _
    (param mark StreamMark)
  )
  (fn-expr + read Size
    (param size Size)
    (param receiver ([] Token))
    (param should-read-once _ (= false))
  )
  (fn-expr + match-literal Bool
    (param literal ([] Token))
  )
  (fn-expr + read (? String)
    (param during (of Predicate Token))
  )
)

(type + (of CaptureResult Token Result) (is Tuple)
  (prop + buffer ([] Token))
  (prop + result Result)
  (fn-to-expr + String
    (call (. buffer slice-string))
  )
)

(type + (of PatternFunc Token Result) (is (fn-type (? (of CaptureResult Token Result)) (param stream (of TokenStream Token)))))

(fn-do + probe-stream-capture-result _
  (probe-count grammar.capture-results)
)

(fn-do + probe-stream-string-materialization _
  (param length Size)
  (probe-count grammar.strings)
  (probe-count grammar.string-tokens length)
)

(type _ (of PatternCollector Item Backing) (is Tuple)
  (constraint is Backing StorageBacking)
  (prop + items (of Array Item Backing))
  (prop + size Size)
  (prop + context (. Backing Context))
  (fn-do + grow (of Array Item Backing)
    (throw (call Panic "Pattern collector size overflow") (if (== size (. Size max))))
    (let capacity Size)
    (if (== (. items length) 0)
      (= capacity initial-capacity)
      (else-if (< (. items length) 1024)
        (= capacity (* (. items length) 2))
      )
      (else
        (let half (/ (. items length) 2))
        (throw (call Panic "Pattern collector size overflow") (if (> (. items length) (- (. Size max) half))))
        (= capacity (+ (. items length) half))
      )
    )
    (if (< capacity (+ size 1))
      (= capacity (+ size 1))
    )
    (return (call (. items resize) capacity context))
    (blank)
    (lazy initial-capacity
      (block
        (case? (<= (. Item size) 16)
          (inline 8)
        )
        (case? (<= (. Item size) 1024)
          (inline 4)
        )
        (default
          (inline 1)
        )
      )
    )
  )
)
