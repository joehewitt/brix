+ Hex is String

────────────────────
+ to Char

C:strtol(this, null, 16) as Char

────────────────────
+ do to Byte[]

?! Panic("Hex byte arrays require an even digit count")
    if digit-size % 2 != 0

. output = Byte[digit-size / 2]
. read-index = prefix-size
. write-index = 0
while read-index < length
    . hi = hex-byte-value(this[read-index])
    . lo = hex-byte-value(this[read-index + 1])
    output[write-index] = (hi /lshift/ 4) /or/ lo
    read-index += 2
    write-index += 1
= output

.. prefix-size =
    |? length >= 2 && this[0] == '0' && (this[1] == 'x' || this[1] == 'X')
        2
    ??
        0
.. digit-size = length - prefix-size

