+ DisplayText is (text String, display-width Size, codepoint-count Size, widths U8[])

────────────────────
+ This
    - source String

. result ResultDisplayWidth
C:yumiStringMeasureDisplayWidth(source, &result)
    ?! Panic("Unable to read UTF8 content")
        if it

. widths = U8[0]
if result.flags != 0
    widths = Array'U8(result.widths, result.codepoints-decoded)

= This(source, result.display-width, result.codepoints-decoded, widths)

────────────────────
+ get is-single-cell @inline

widths.size == 0

────────────────────
+ this + other DisplayText

DisplayText(joined-text, joined-width, joined-count, combined-widths)

.. joined-text = text ++ other.text
.. joined-width = display-width + other.display-width
.. joined-count = codepoint-count + other.codepoint-count
.. combined-widths
    |? is-single-cell && other.is-single-cell
        U8[0]
    ??
        combine-display-widths(this, other)

────────────────────
+ width-at @inline
    - index Index

|? is-single-cell
    1
??
    widths[index] as Size

