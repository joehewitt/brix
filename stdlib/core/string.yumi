+ truncate
    - trunc-len Size

|? length > trunc-len
    this[0 .. < trunc-len] ++ "..."
??
    this

────────────────────
+ do split
    - delim String

?! Panic("String split delimiter must not be empty")
    if delim.size == 0

. start Index = 0
. dl = delim.size
. buf = byte-view(this)
while true
    . index I32
    . found = C:yumiStringFindBytes(this, delim, false, start, &index)

    if !found
        <= buf[start ...].slice-string()
        break
    else
        <= buf[start .. < index].slice-string()
        start = index + dl

────────────────────
+ do join'Item String
    - stream <Item>

. first String? = null
. buf Byte[]? = null
. cursor = 0
. delim-size = size

for item in stream
    . str = item as String
    . lead = first
    if !lead
        first = str
        continue

    . str-size = str.size
    . needed = cursor + delim-size + str-size
    . current = buf
    if !current
        . started = Byte[(lead.size + delim-size + str-size) * 2]
        started[0 .. < lead.size] = byte-view(lead)
        cursor = lead.size
        buf = started
    else if needed > current.size
        . grown = current.size * 2
        buf = current.resize(if grown < needed then needed else grown)

    . target = buf!
    target[cursor .. < cursor + delim-size] = byte-view(this)
    cursor += delim-size
    target[cursor .. < cursor + str-size] = byte-view(str)
    cursor += str-size

. lead = first
=? "" if !lead
. joined = buf
=? lead if !joined
= joined.slice-string(0 .. < cursor)

