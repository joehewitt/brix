────────────────────
+ do trim

if length == 0
    = ""

. i1 Index = 0
. i2 Index = length - 1
while i1 <= i2 && is-whitespace(this[i1])
    i1 += 1
if i1 > i2
    = ""

while i2 > i1 && is-whitespace(this[i2])
    i2 -= 1

= this[i1 .. i2]

