━━━━━━━━━━━━━━━━━━━━
_ do combine-display-widths
    - left DisplayText
    - right DisplayText

. result = U8[left.codepoint-count + right.codepoint-count]
copy-display-widths(result, 0, left)
copy-display-widths(result, left.codepoint-count, right)
= result

━━━━━━━━━━━━━━━━━━━━
_ do copy-display-widths
    - target U8[]
    - offset Size
    - text DisplayText

if text.is-single-cell
    target[offset .. < offset + text.codepoint-count] = 1
    =
target[offset .. < offset + text.codepoint-count] = text.widths

━━━━━━━━━━━━━━━━━━━━
_ hex-byte-value
    - char Char

|? char >= '0' && char <= '9'
    (char - '0') as Byte
|? char >= 'a' && char <= 'f'
    (char - 'a' + 10) as Byte
|? char >= 'A' && char <= 'F'
     (char - 'A' + 10) as Byte
?! Panic("Invalid hex digit")

━━━━━━━━━━━━━━━━━━━━
_ base64-byte-value U32 ?! SyntaxError
    - char Char

|? char >= 'A' && char <= 'Z'
    char - 'A'
|? char >= 'a' && char <= 'z'
    char - 'a' + 26
|? char >= '0' && char <= '9'
    char - '0' + 52
|? char == '+'
    62
|? char == '/'
    63
?! SyntaxError("Invalid Base64 digit")

━━━━━━━━━━━━━━━━━━━━
_ is-whitespace
    - c Char

c == ' ' || c == '\t' || c == '\r' || c == '\n'
