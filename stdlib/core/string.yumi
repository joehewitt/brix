+ do next-iterator (Size, Char?)
    - byte-offset Size

. none Char?
if byte-offset >= size
    //string-iteration.passes-completed ++
    = (byte-offset, none)

. result ResultCharIndex
. current = (this as CPointer'Char8) + byte-offset
//string-iteration.next-char-calls ++
. status = C:yumiStringGetNextChar(current, &result)
if status
    //string-iteration.invalid-results ++
    ?! Panic("Unable to read UTF8 content")

if result.byte-count <= 0
    //string-iteration.zero-width-results ++
    ?! Panic("UTF8 decoder did not advance")

//string-iteration.codepoints-yielded ++
//string-iteration.bytes-consumed += result.byte-count
= (byte-offset + result.byte-count as Size, result.char)

