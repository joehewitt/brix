━━━━━━━━━━━━━━━━━━━━
+ do decode-base64 Byte[] ?! SyntaxError
    - text String

?! SyntaxError("Invalid Base64 length")
    if text.length % 4 != 0

. padding Size = 0
if text.length
    if text[text.length - 1] == '='
        padding += 1
        if text[text.length - 2] == '='
            padding += 1

. output = Byte[(text.length / 4) * 3 - padding]
. read-index = 0
. write-index = 0
while read-index < text.length
    . final-block = read-index + 4 == text.length
    . c0 = text[read-index]
    . c1 = text[read-index + 1]
    . c2 = text[read-index + 2]
    . c3 = text[read-index + 3]
    ?! SyntaxError("Invalid Base64 padding")
        if c0 == '=' || c1 == '='

    . v0 = base64-byte-value(c0)
    . v1 = base64-byte-value(c1)
    if c2 == '='
        ?! SyntaxError("Invalid Base64 padding")
            if c3 != '=' || !final-block
        output[write-index] = ((v0 /lshift/ 2) /or/ (v1 /rshift/ 4)) as Byte
        write-index += 1
    else if c3 == '='
        ?! SyntaxError("Invalid Base64 padding")
            if !final-block
        . v2 = base64-byte-value(c2)
        output[write-index] = ((v0 /lshift/ 2) /or/ (v1 /rshift/ 4)) as Byte
        output[write-index + 1] = (((v1 /and/ 0x0f) /lshift/ 4) /or/ (v2 /rshift/ 2)) as Byte
        write-index += 2
    else
        . v2 = base64-byte-value(c2)
        . v3 = base64-byte-value(c3)
        . value = (v0 /lshift/ 18) /or/ (v1 /lshift/ 12) /or/ (v2 /lshift/ 6) /or/ v3
        output[write-index] = (value /rshift/ 16) as Byte
        output[write-index + 1] = (value /rshift/ 8) as Byte
        output[write-index + 2] = value as Byte
        write-index += 3

    read-index += 4
= output

━━━━━━━━━━━━━━━━━━━━
+ do decode-utf8 String ?! SyntaxError
    - data Byte[]

=? "" if data.size == 0
. made = C:yumiStringSliceUtf8(data, 0, data.size)
?! SyntaxError("Invalid UTF-8")
    if (made as Pointer).address == 0
= made as String

