━━━━━━━━━━━━━━━━━━━━
+ Subscription'Message
    is Subscribable'Message

_ queue = IOBuffer'Message()
_ broadcaster-queue = IOBuffer'(Broadcastable'Message)()
_ sub Subscriber'Message
_ is-dispatching = false
_ finishing Broadcastable'Message?
_ home = Worker.current()
_ mutex = Mutex()

────────────────────
+ This
    - sub Subscriber'Message

────────────────────
+ do this
    - message Message
    - broadcaster Broadcastable'Message

mutex.lock()
queue.push(message)
broadcaster-queue.push(broadcaster)
. starts = !is-dispatching
is-dispatching = true
mutex.unlock()

if starts
    do (home) new
        dispatch()

────────────────────
+ do unsubscribe

mutex.lock()
queue.clear()
broadcaster-queue.clear()
finishing = null
mutex.unlock()

────────────────────
+ do finish
    - broadcaster Broadcastable'Message

mutex.lock()
. waits = is-dispatching
if waits
    finishing = broadcaster
mutex.unlock()
if !waits
    broadcaster.unsubscribe(this)
        catch error Error
            unhandled-error(error)

────────────────────
+ this == other Subscriber'Message

sub == other

────────────────────
+ do dispatch

mutex.lock()
. count = queue.length
while count && queue.length
    . message = queue.pop-first()
    . broadcaster = broadcaster-queue.pop-first()
    mutex.unlock()
    sub(message, broadcaster)
        catch error Error
            unhandled-error(error)
    count -= 1
    mutex.lock()

if queue.length
    mutex.unlock()
    do (home) new
        dispatch()
    =
is-dispatching = false
. broadcaster = finishing
finishing = null
mutex.unlock()
if broadcaster
    broadcaster.unsubscribe(this)
        catch error Error
            unhandled-error(error)

