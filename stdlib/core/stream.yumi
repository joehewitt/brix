+ Subscription'Message
    is Subscribable'Message

_ queue [Message]
_ broadcaster-queue [Broadcastable'Message]
_ sub Subscriber'Message
_ is-dispatching = false
_ finishing Broadcastable'Message?

────────────────────
+ This
    - sub Subscriber'Message

╌╌╌╌╌╌╌╌╌╌ is Subscribable'Message ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do this
    - message Message
    - broadcaster Broadcastable'Message

`  // enqueue on ${get-current-task-id()}
queue += message
broadcaster-queue += broadcaster

if !is-dispatching
    is-dispatching = true
    do new
        dispatch()

────────────────────
+ do unsubscribe

queue.clear()
broadcaster-queue.clear()
is-dispatching = false
finishing = null

────────────────────
+ do finish
    - broadcaster Broadcastable'Message

if is-dispatching
    finishing = broadcaster
else
    broadcaster.unsubscribe(this)
        catch error Error
            unhandled-error(error)

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ this == other Subscriber'Message

sub == other

────────────────────
+ do dispatch

. count = queue.length
while count && queue
    `  // dispatch on ${get-current-task-id()}
    sub(queue.pop-first(), broadcaster-queue.pop-first())
        catch error Error
            unhandled-error(error)
    count -= 1

if queue
    do new
        dispatch()
else
    is-dispatching = false
    . broadcaster = finishing
    if broadcaster
        finishing = null
        broadcaster.unsubscribe(this)
            catch error Error
                unhandled-error(error)

