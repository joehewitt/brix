(type + I64 (alias Int64 Int Long i64 l i) (is Number)
  (fn-from-expr + (: str String)
    (call read-integer str (. This min) (. This max))
  )
  (fn-to-expr + String
    (call C:brixLonglongToString this 0)
  )
  (fn-to-expr + Hex
    (call C:brixToHex this 16)
  )
  (fn-expr + pad _
    (param n Int)
    (call C:brixLonglongToString this n)
  )
)

(type + U64 (alias UInt64 UInt ULong u64 ul u) (is Number)
  (fn-from-expr + (: str String)
    (call read-unsigned str)
  )
  (fn-to-expr + String
    (call C:brixUlonglongToString this 0)
  )
  (fn-to-expr + Hex
    (call C:brixToHex this 16)
  )
  (fn-expr + pad _
    (param n Int)
    (call C:brixUlonglongToString this n)
  )
)

(type + F32 (alias Float32 f32) (is Number)
  (fn-from-expr + (: str String)
    (as (call read-float str) F32)
  )
  (fn-to-expr + String
    (call C:brixFloatToString this)
  )
  (fn-expr + pad _
    (param n Int)
    (call C:brixDoubleToFixedString this n 0)
  )
  (fn-expr + places _
    (param n Int)
    (call C:brixDoubleToFixedString this n 1)
  )
)

(type + F64 (alias Float64 Float f64 f) (is Number)
  (fn-from-expr + (: str String)
    (call read-float str)
  )
  (fn-to-expr + String
    (call C:brixDoubleToString this)
  )
  (fn-expr + pad _
    (param n Int)
    (call C:brixDoubleToFixedString this n 0)
  )
  (fn-expr + places _
    (param n Int)
    (call C:brixDoubleToFixedString this n 1)
  )
)

(type + Bool (alias b) (is Number)
  (fn-to-expr + String
    (case? this
      "true"
    )
    (default
      "false"
    )
  )
)

(type + F128 (alias Float128 f128) (is (tuple (: a F64) (: b F64))))

(type + Char8 (alias c8) (is Number)
  (fn-from-expr + (: str String)
    ([] str 0)
  )
  (fn-to-expr + String
    (call C:brixCharToString this)
  )
  (fn-expr + lowercase Char :get
    (case? (and (>= this 65) (<= this 90))
      (+ 97 (- this 65))
    )
    (default
      this
    )
  )
  (fn-expr + uppercase Char :get
    (case? (and (>= this 97) (<= this 122))
      (+ 65 (- this 97))
    )
    (default
      this
    )
  )
)

(type + Char (alias c) (is Number)
  (fn-from-expr + (: str String)
    ([] str 0)
  )
  (fn-to-expr + String
    (before
      (throw (call Panic (str (as this U32) " is not a Unicode character")) (if (== (. (as made Pointer) address) 0)))
    )
    (as made String)
    (where
      (lazy made (call C:brixStringFromUtf8Codepoint this))
    )
  )
  (fn-expr + category UTF8Category :get
    (as (call C:brixCharGetCategory this) UTF8Category)
  )
  (fn-expr + display-width Size :get
    (call C:brixCharGetDisplayWidth this)
  )
  (fn-expr + lowercase Char :get
    (as (call C:brixCharToLowercase this) Char)
  )
  (fn-expr + uppercase Char :get
    (as (call C:brixCharToUppercase this) Char)
  )
)

(fn-expr + fnv-mix U64
  (param hash U64)
  (param value U64)
  (* (/xor/ hash value) fnv-prime)
)

(fn-do + fnv-hash U64
  (param data (of CPointer Byte))
  (param length Size)
  (param seed U64 (= fnv-offset-basis))
  (let hash seed)
  (for (in index (..< 0 length))
    (= hash (call fnv-mix hash ([] data index)))
  )
  (return hash)
)
