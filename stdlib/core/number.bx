(import ./core)
(import ./range)
(import ./string)
(import /BxCore/BxNumber.h)
(import /BxCore/BxString.h)
(import /math.h)
(import /unistd.h)
(blank)
(prop + fnv-offset-basis U64 (= 14695981039346656037))
(prop + fnv-prime U64 (= 1099511628211))

(fn-do _ read-integer I64
  (param text String)
  (param low I64)
  (param high I64)
  (let end Pointer null)
  (let value (call C:strtoll text &end 10))
  (throw (call Panic (str "\"" text "\" is not a whole number")) (if (not (call reads-all text end))))
  (return (if-expr (< value low) low (if-expr (> value high) high value)))
)

(fn-do _ read-unsigned U64
  (param text String)
  (let end Pointer null)
  (let value (call C:strtoull text &end 10))
  (throw (call Panic (str "\"" text "\" is not a whole number")) (if (not (call reads-all text end))))
  (return (if-expr (and (!= value 0) (call (. (call (. text trim)) starts-with) "-")) 0 value))
)

(fn-do _ read-float F64
  (param text String)
  (let end Pointer null)
  (let value (call C:strtod text &end))
  (throw (call Panic (str "\"" text "\" is not a number")) (if (not (call reads-all text end))))
  (return value)
)

(fn-do _ reads-all Bool
  (param text String)
  (param end Pointer)
  (let start (as text Pointer))
  (let read (as (- (. end address) (. start address)) Size))
  (if (or (== end null) (== read 0))
    (return false)
  )
  (let bytes (as start (of CPointer U8)))
  (for (in offset (..< read (. text size)))
    (let byte ([] bytes offset))
    (if (and (!= byte 32) (or (< byte 9) (> byte 13)))
      (return false)
    )
  )
  (return true)
)

(type + Number
  (fn-to-expr + UnitString
    (str this unit)
  )
  (fn-to-do + Binary
    (let output "")
    (let bit-size (* (. (type-of this) size) 8))
    (blank)
    (for (in i (.. (- bit-size 1) 0))
      (+= output (str (/and/ (/rshift/ this i) 1)))
      (if (and (> i 0) (== (% i 8) 0))
        (+= output " ")
      )
    )
    (blank)
    (return output)
  )
  (fn-expr + (infix this %% (param other _)) _
    (as (call C:pow this other) This)
    (blank)
    ;  ------------------------------------------------------------------------------------------------
    ;  + to Position
    (blank)
    ;  Position(this)
  )
)

(type + I1 (alias Int1 i1) (is Number)
  (fn-from-expr + (: str String)
    (as (call C:strtol str null 1) This)
  )
  (fn-to-expr + String
    (call C:brixIntToString this 0)
  )
  (fn-expr + pad _
    (param n Int)
    (call C:brixIntToString this n)
  )
)

(type + I8 (alias Int8 i8) (is Number)
  (fn-from-expr + (: str String)
    (as (call read-integer str (. This min) (. This max)) This)
  )
  (fn-to-expr + String
    (call C:brixIntToString this 0)
  )
  (fn-to-expr + Hex
    (call C:brixToHex this 2)
  )
  (fn-expr + pad _
    (param n Int)
    (call C:brixIntToString this n)
  )
)

(type + U8 (alias UInt8 Byte u8) (is Number)
  (fn-from-expr + (: str String)
    (as (call read-integer str (. This min) (. This max)) This)
  )
  (fn-to-expr + String
    (call C:brixUintToString this 0)
  )
  (fn-to-expr + Hex
    (call C:brixToHex this 2)
  )
  (fn-expr + pad _
    (param n Int)
    (call C:brixUintToString this n)
  )
)

(type + Endian (is U8)
  (variant big)
  (variant little)
)

