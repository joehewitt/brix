(import ./arena)
(import ./error)
(import ./number)
(import ./stream)
(import ./string)
(import /BxCore/BxString.h)

(type _ AtomStringChar (is (tuple (: byte-count I32) (: char Char))))

(type + AtomPool
  (prop _ arena Arena)
  (prop _ entries (of Array Atom ArenaBacking))
  (prop _ fingerprints (of Array U32 ArenaBacking))
  (prop _ buckets (of Array Size ArenaBacking))
  (prop _ count Size)
  (prop _ released Bool)
  (fn-do + This _
    (lazy entries (call (of Array Atom) arena 8))
    (lazy fingerprints (call (of Array U32) arena 8))
    (lazy buckets (call (of Array Size) arena 8))
  )
  (fn-expr + length Size :get
    (before
      (throw (call Panic "AtomPool Arena is stale or released") (if released))
    )
    count
  )
  (fn-expr + store Atom
    (param text String)
    (before
      (throw (call Panic "AtomPool Arena is stale or released") (if released))
    )
    (case? (!= entry-number 0)
      ([] (. entries data) (- entry-number 1))
    )
    (default
      (call insert text fingerprint)
    )
    (where
      (lazy fingerprint (call atom-fingerprint text))
      (lazy entry-number (call find text fingerprint))
    )
  )
  (fn-expr + store Atom
    (param source ([] Char))
    (param start Index)
    (param end Index)
    (before
      (throw (call Panic "AtomPool Arena is stale or released") (if released))
      (throw (call Panic "Atom codepoint span is invalid") (if (or (> start end) (> end (. source length)))))
    )
    (case? (!= entry-number 0)
      ([] (. entries data) (- entry-number 1))
    )
    (default
      (call insert source start end fingerprint)
    )
    (where
      (lazy fingerprint (call atom-fingerprint source start end))
      (lazy entry-number (call find source start end fingerprint))
    )
  )
  (fn-do + store Atom
    (param source (of ImmutableArray Byte))
    (param start Index)
    (param end Index)
    (throw (call Panic "AtomPool Arena is stale or released") (if released))
    (throw (call Panic "Atom byte span is invalid") (if (or (> start end) (> end (. source length)))))
    (blank)
    (let fingerprint (call atom-byte-fingerprint source start end))
    (let entry-number (call find-bytes source start end fingerprint))
    (return-if ([] (. entries data) (- entry-number 1)) (if (!= entry-number 0)))
    (return (call insert source start end fingerprint))
  )
  (fn-expr + (index-get this (param index Index)) Atom
    (before
      (throw (call Panic "AtomPool Arena is stale or released") (if released))
      (throw (call OutOfBoundsError "AtomPool index out of bounds") (if (>= (as index UInt) (as count UInt))))
    )
    ([] (. entries data) index)
  )
  (fn-expr + ordinal Index
    (param atom Atom)
    (before
      (throw (call Panic "AtomPool Arena is stale or released") (if released))
      (throw (call Panic "Atom belongs to another AtomPool or is not live") (if (or (== entry-number 0) (!= ([] (. entries data) (- entry-number 1)) atom))))
    )
    (as (- entry-number 1) Index)
    (where
      (lazy fingerprint (call atom-fingerprint (. atom text)))
      (lazy entry-number (call find (. atom text) fingerprint))
    )
  )
  (fn-expr + owns Bool
    (param atom Atom)
    (before
      (throw (call Panic "AtomPool Arena is stale or released") (if released))
    )
    (case? (!= entry-number 0)
      (== ([] (. entries data) (- entry-number 1)) atom)
    )
    (default
      false
    )
    (where
      (lazy fingerprint (call atom-fingerprint (. atom text)))
      (lazy entry-number (call find (. atom text) fingerprint))
    )
  )
  (fn-to-do + (of Iterable Atom)
    (throw (call Panic "AtomPool Arena is stale or released") (if released))
    (blank)
    (let data (. entries data))
    (for (in index (..< 0 count))
      (yield ([] data index))
    )
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _ (without gc)
    (if (not released)
      (call (. arena release))
      (= released true)
    )
  )
  (fn-do _ find Size (without heap safepoints)
    (param text String)
    (param fingerprint U32)
    (let entry-data (. entries data))
    (let fingerprint-data (. fingerprints data))
    (let bucket-data (. buckets data))
    (let bucket-count (. buckets length))
    (let bucket (as (/and/ (as fingerprint Size) (- bucket-count 1)) Index))
    (let entry-number ([] bucket-data bucket))
    (while (!= entry-number 0)
      (let index (- entry-number 1))
      (if (and (== ([] fingerprint-data index) fingerprint) (== (. ([] entry-data index) text) text))
        (return entry-number)
      )
      (= bucket (/and/ (+ bucket 1) (- bucket-count 1)))
      (= entry-number ([] bucket-data bucket))
    )
    (return 0)
  )
  (fn-do _ find Size (without heap safepoints)
    (param source ([] Char))
    (param start Index)
    (param end Index)
    (param fingerprint U32)
    (let entry-data (. entries data))
    (let fingerprint-data (. fingerprints data))
    (let bucket-data (. buckets data))
    (let bucket-count (. buckets length))
    (let bucket (as (/and/ (as fingerprint Size) (- bucket-count 1)) Index))
    (let entry-number ([] bucket-data bucket))
    (while (!= entry-number 0)
      (let index (- entry-number 1))
      (if (== ([] fingerprint-data index) fingerprint)
        (if (call atom-span-equals (. ([] entry-data index) text) source start end)
          (return entry-number)
        )
      )
      (= bucket (/and/ (+ bucket 1) (- bucket-count 1)))
      (= entry-number ([] bucket-data bucket))
    )
    (return 0)
  )
  (fn-do _ find-bytes Size
    (param source (of ImmutableArray Byte))
    (param start Index)
    (param end Index)
    (param fingerprint U32)
    (let entry-data (. entries data))
    (let fingerprint-data (. fingerprints data))
    (let bucket-data (. buckets data))
    (let bucket-count (. buckets length))
    (let bucket (as (/and/ (as fingerprint Size) (- bucket-count 1)) Index))
    (let entry-number ([] bucket-data bucket))
    (while (!= entry-number 0)
      (let index (- entry-number 1))
      (if (== ([] fingerprint-data index) fingerprint)
        (if (call atom-bytes-equal (. ([] entry-data index) text) source start end)
          (return entry-number)
        )
      )
      (= bucket (/and/ (+ bucket 1) (- bucket-count 1)))
      (= entry-number ([] bucket-data bucket))
    )
    (return 0)
  )
  (fn-do _ insert Atom (without gc)
    (param text String)
    (param fingerprint U32)
    (call prepare-insert)
    (let atom (as (call (. arena copy-string) text) Atom))
    (call append atom fingerprint)
    (return atom)
  )
  (fn-do _ insert Atom (without gc)
    (param source ([] Char))
    (param start Index)
    (param end Index)
    (param fingerprint U32)
    (call prepare-insert)
    (let atom (as (call (. arena copy-span) source start end) Atom))
    (call append atom fingerprint)
    (return atom)
  )
  (fn-do _ insert Atom (without gc)
    (param source (of ImmutableArray Byte))
    (param start Index)
    (param end Index)
    (param fingerprint U32)
    (call prepare-insert)
    (let atom (as (call (. arena copy-span) source start end) Atom))
    (call append atom fingerprint)
    (return atom)
  )
  (fn-do _ append _ (without gc)
    (param atom Atom)
    (param fingerprint U32)
    (let entry-data (. entries data))
    (let fingerprint-data (. fingerprints data))
    (let bucket-data (. buckets data))
    (let bucket-count (. buckets length))
    (let bucket (as (/and/ (as fingerprint Size) (- bucket-count 1)) Index))
    (while (!= ([] bucket-data bucket) 0)
      (= bucket (/and/ (+ bucket 1) (- bucket-count 1)))
    )
    (= ([] entry-data count) atom)
    (= ([] fingerprint-data count) fingerprint)
    (= ([] bucket-data bucket) (+ count 1))
    (+= count 1)
  )
  (fn-do _ prepare-insert _ (without gc)
    (throw (call Panic "AtomPool capacity overflow") (if (== count (. Size max))))
    (blank)
    (if (> (+ count 1) (. entries length))
      (call grow-entries)
    )
    (if (> (+ count 1) (/ (* (. buckets length) 3) 4))
      (call grow-buckets)
    )
  )
  (fn-do _ grow-entries _ (without gc)
    (throw (call Panic "AtomPool entry capacity overflow") (if (> (. entries length) (/ (. Size max) 2))))
    (blank)
    (let new-capacity (* (. entries length) 2))
    (let replacement-entries (call (of Array Atom) arena new-capacity))
    (let replacement-fingerprints (call (of Array U32) arena new-capacity))
    (let source-entries (. entries data))
    (let source-fingerprints (. fingerprints data))
    (let target-entries (. replacement-entries data))
    (let target-fingerprints (. replacement-fingerprints data))
    (for (in index (..< 0 count))
      (= ([] target-entries index) ([] source-entries index))
      (= ([] target-fingerprints index) ([] source-fingerprints index))
    )
    (= entries replacement-entries)
    (= fingerprints replacement-fingerprints)
  )
  (fn-do _ grow-buckets _ (without gc)
    (throw (call Panic "AtomPool bucket capacity overflow") (if (> (. buckets length) (/ (. Size max) 2))))
    (blank)
    (let replacement (call (of Array Size) arena (* (. buckets length) 2)))
    (let fingerprint-data (. fingerprints data))
    (let bucket-data (. replacement data))
    (let bucket-count (. replacement length))
    (for (in index (..< 0 count))
      (let bucket (as (/and/ (as ([] fingerprint-data index) Size) (- bucket-count 1)) Index))
      (while (!= ([] bucket-data bucket) 0)
        (= bucket (/and/ (+ bucket 1) (- bucket-count 1)))
      )
      (= ([] bucket-data bucket) (+ index 1))
    )
    (= buckets replacement)
  )
)

(fn-do _ atom-fingerprint U32 (without heap safepoints)
  (param text String)
  (let bytes (call byte-view text))
  (let data (as bytes (of CPointer Byte)))
  (let fingerprint 2166136261u32)
  (for (in index (..< 0 (. bytes length)))
    (= fingerprint (call atom-mix fingerprint ([] data index)))
  )
  (return fingerprint)
)

(fn-do _ atom-fingerprint U32 (without heap safepoints)
  (param source ([] Char))
  (param start Index)
  (param end Index)
  (let data (. source data))
  (let fingerprint 2166136261u32)
  (for (in index (..< start end))
    (let scalar (as ([] data index) U32))
    (if (< scalar 128)
      (= fingerprint (call atom-mix fingerprint scalar))
      (else-if (< scalar 2048)
        (= fingerprint (call atom-mix fingerprint (/or/ 192 (/rshift/ scalar 6))))
        (= fingerprint (call atom-mix fingerprint (/or/ 128 (/and/ scalar 63))))
      )
      (else-if (< scalar 65536)
        (= fingerprint (call atom-mix fingerprint (/or/ 224 (/rshift/ scalar 12))))
        (= fingerprint (call atom-mix fingerprint (/or/ 128 (/and/ (/rshift/ scalar 6) 63))))
        (= fingerprint (call atom-mix fingerprint (/or/ 128 (/and/ scalar 63))))
      )
      (else
        (= fingerprint (call atom-mix fingerprint (/or/ 240 (/rshift/ scalar 18))))
        (= fingerprint (call atom-mix fingerprint (/or/ 128 (/and/ (/rshift/ scalar 12) 63))))
        (= fingerprint (call atom-mix fingerprint (/or/ 128 (/and/ (/rshift/ scalar 6) 63))))
        (= fingerprint (call atom-mix fingerprint (/or/ 128 (/and/ scalar 63))))
      )
    )
  )
  (return fingerprint)
)

(fn-expr _ atom-mix U32 (without heap safepoints)
  (param fingerprint U32)
  (param byte U32)
  (* (/xor/ fingerprint byte) 16777619)
)

(fn-do _ atom-span-equals Bool (without heap safepoints)
  (param text String)
  (param source ([] Char))
  (param start Index)
  (param end Index)
  (return-if false (if (!= (. text length) (- end start))))
  (blank)
  (let bytes (call byte-view text))
  (let source-data (. source data))
  (let byte-data (as (as bytes (of CPointer Byte)) (of CPointer Char8)))
  (let byte-offset 0)
  (let result AtomStringChar)
  (blank)
  (for (in index (..< start end))
    (if (!= (call C:brixStringGetNextChar (+ byte-data byte-offset) &result) 0)
      (return false)
    )
    (if (!= (. result char) ([] source-data index))
      (return false)
    )
    (+= byte-offset (as (. result byte-count) Size))
  )
  (blank)
  (return (== byte-offset (. bytes length)))
)

(fn-do _ atom-byte-fingerprint U32 (without heap safepoints)
  (param source (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (let data (as source (of CPointer Byte)))
  (let fingerprint 2166136261u32)
  (for (in index (..< start end))
    (= fingerprint (call atom-mix fingerprint ([] data index)))
  )
  (return fingerprint)
)

(fn-do _ atom-bytes-equal Bool
  (param text String)
  (param source (of ImmutableArray Byte))
  (param start Index)
  (param end Index)
  (let bytes (call byte-view text))
  (return-if false (if (!= (. bytes length) (- end start))))
  (blank)
  (let held (as bytes (of CPointer Byte)))
  (let data (as source (of CPointer Byte)))
  (for (in offset (..< 0 (. bytes length)))
    (return-if false (if (!= ([] held offset) ([] data (+ start offset)))))
  )
  (return true)
)
