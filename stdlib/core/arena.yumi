/YuCore/YuCore.h

━━━━━━━━━━━━━━━━━━━━
+ Arena is Tuple
    is ArrayStorageProvider
    is Usable'Void

_ owner-handle CPointer'Byte
_ incarnation Size

+ Backing'Item = ArenaBacking

────────────────────
+ This
    - initial-byte-capacity Size = 0

. handle = C:yumiArenaCreate(initial-byte-capacity) as CPointer'Byte
?! Panic("Arena allocation failed")
    if handle.address == 0

owner-handle = handle
incarnation = (C:yumiArenaIncarnation(handle)) as Size

────────────────────
+ begin-using

this

────────────────────
+ do end-using without gc

release()

────────────────────
+ do allocate'Value CPointer'Value without gc
    - count Size

if count != 0 && count > Size.max / Value.size
    C:yumiArenaAllocationFailed(owner-handle, incarnation, 16)
. data = C:yumiArenaReserve(owner-handle, incarnation, count * Value.size, 16, true)
if data.address == 0
    C:yumiArenaAllocationFailed(owner-handle, incarnation, 16)
= data as CPointer'Value

────────────────────
+ do try-allocate'Value CPointer'Value? without gc
    - count Size

if count != 0 && count > Size.max / Value.size
    = null
. data = C:yumiArenaReserve(owner-handle, incarnation, count * Value.size, 16, true)
if data.address == 0
    = null
= data as CPointer'Value

────────────────────
+ do allocate-raw CPointer'Byte without gc
    - byte-count Size
    - alignment Size = 1

. data = C:yumiArenaReserve(owner-handle, incarnation, byte-count, alignment, false)
if data.address == 0
    C:yumiArenaAllocationFailed(owner-handle, incarnation, alignment)
= data

────────────────────
+ do copy-string String without gc
    - text String

. copy = C:yumiArenaCopyString(owner-handle, incarnation, text)
?! Panic("Arena String allocation failed")
    if (copy as Pointer).address == 0
= copy

────────────────────
+ do copy-span String without gc
    - source Char[]
    - start Index
    - end Index
    - stop-at-null Bool = false

. copy = C:yumiArenaCopyCodepointSpan
    - owner-handle
    - incarnation
    - source.data
    - source.length
    - start
    - end
    - stop-at-null
?! Panic("Arena codepoint span materialization failed")
    if (copy as Pointer).address == 0
= copy

────────────────────
+ do copy-span String without gc
    - source Byte[]
    - start Index
    - end Index

. copy = C:yumiArenaCopyByteSpan
    - owner-handle
    - incarnation
    - source.data
    - source.length
    - start
    - end
?! Panic("Arena byte span materialization failed")
    if (copy as Pointer).address == 0
= copy

────────────────────
+ do owns Bool without gc
    - value Pointer

= C:yumiArenaOwns(owner-handle, incarnation, value)

────────────────────
+ do try-allocate-raw CPointer'Byte? without gc
    - byte-count Size
    - alignment Size = 1

. data = C:yumiArenaReserve(owner-handle, incarnation, byte-count, alignment, false)
if data.address == 0
    = null
= data

────────────────────
+ get mark ArenaMark

?! Panic("Arena is already released")
    if mark == 0
ArenaMark(mark as Size)

.. mark = C:yumiArenaMark(owner-handle, incarnation)

────────────────────
+ do rewind without gc
    - mark ArenaMark

. result = mark.rewind-from(owner-handle, incarnation)
?! Panic("Arena mark is stale or belongs to another Arena")
    if result != 0

