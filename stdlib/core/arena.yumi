/BxCore/BxCore.h

━━━━━━━━━━━━━━━━━━━━
+ Arena is Tuple
    is ArrayStorageProvider
    is Usable'Void

_ owner-handle CPointer'Byte
_ incarnation Size

+ Backing'Item = ArenaBacking

────────────────────
+ This
    - initial-byte-capacity Size = 0

. handle = C:brixArenaCreate(initial-byte-capacity) as CPointer'Byte
?! Panic("Arena allocation failed")
    if handle.address == 0

owner-handle = handle
incarnation = (C:brixArenaIncarnation(handle)) as Size

────────────────────
+ begin-using

this

────────────────────
+ do end-using without gc

release()

────────────────────
+ do allocate'Value CPointer'Value without gc
    - count Size

if count != 0 && count > Size.max / Value.size
    C:brixArenaAllocationFailed(owner-handle, incarnation, 16)
. data = C:brixArenaReserve(owner-handle, incarnation, count * Value.size, 16, true)
if data.address == 0
    C:brixArenaAllocationFailed(owner-handle, incarnation, 16)
= data as CPointer'Value

────────────────────
+ do try-allocate'Value CPointer'Value? without gc
    - count Size

if count != 0 && count > Size.max / Value.size
    = null
. data = C:brixArenaReserve(owner-handle, incarnation, count * Value.size, 16, true)
if data.address == 0
    = null
= data as CPointer'Value

────────────────────
+ do allocate-raw CPointer'Byte without gc
    - byte-count Size
    - alignment Size = 1

. data = C:brixArenaReserve(owner-handle, incarnation, byte-count, alignment, false)
if data.address == 0
    C:brixArenaAllocationFailed(owner-handle, incarnation, alignment)
= data

────────────────────
+ do copy-string String without gc
    - text String

. copy = C:brixArenaCopyString(owner-handle, incarnation, text)
?! Panic("Arena String allocation failed")
    if (copy as Pointer).address == 0
= copy

────────────────────
+ do copy-span String without gc
    - source Char[]
    - start Index
    - end Index
    - stop-at-null Bool = false

. copy = C:brixArenaCopyCodepointSpan
    - owner-handle
    - incarnation
    - source.data
    - source.length
    - start
    - end
    - stop-at-null
?! Panic("Arena codepoint span materialization failed")
    if (copy as Pointer).address == 0
= copy

────────────────────
+ do copy-span String without gc
    - source ImmutableArray'Byte
    - start Index
    - end Index

. copy = C:brixArenaCopyByteSpan
    - owner-handle
    - incarnation
    - source as CPointer'Byte
    - source.length
    - start
    - end
?! Panic("Arena byte span materialization failed")
    if (copy as Pointer).address == 0
= copy

────────────────────
+ do owns Bool without gc
    - value Pointer

= C:brixArenaOwns(owner-handle, incarnation, value)

────────────────────
+ do try-allocate-raw CPointer'Byte? without gc
    - byte-count Size
    - alignment Size = 1

. data = C:brixArenaReserve(owner-handle, incarnation, byte-count, alignment, false)
if data.address == 0
    = null
= data

────────────────────
+ get mark ArenaMark

?! Panic("Arena is already released")
    if mark == 0
ArenaMark(mark as Size)

.. mark = C:brixArenaMark(owner-handle, incarnation)

────────────────────
+ do rewind without gc
    - mark ArenaMark

. result = mark.rewind-from(owner-handle, incarnation)
?! Panic("Arena mark is stale or belongs to another Arena")
    if result != 0

────────────────────
+ do reset without gc

C:brixArenaReset(owner-handle, incarnation)

────────────────────
+ do release without gc

C:brixArenaRelease(owner-handle, incarnation)

────────────────────
+ get state Size

C:brixArenaState(owner-handle, incarnation) as Size

────────────────────
+ get generation Size

C:brixArenaGeneration(owner-handle, incarnation) as Size

────────────────────
+ get active-block-count Size

C:brixArenaActiveBlockCount(owner-handle, incarnation) as Size

────────────────────
+ get retained-block-count Size

C:brixArenaRetainedBlockCount(owner-handle, incarnation) as Size

────────────────────
+ get active-bytes Size

C:brixArenaActiveBytes(owner-handle, incarnation) as Size

────────────────────
+ get reserved-bytes Size

C:brixArenaReservedBytes(owner-handle, incarnation) as Size

────────────────────
+ get retained-bytes Size

C:brixArenaRetainedBytes(owner-handle, incarnation) as Size

────────────────────
+ get peak-active-bytes Size

C:brixArenaPeakActiveBytes(owner-handle, incarnation) as Size

────────────────────
+ get system-block-allocation-count Size

C:brixArenaOwnerSystemBlockAllocationCount(owner-handle, incarnation) as Size

────────────────────
+ get reset-count Size

C:brixArenaOwnerResetCount(owner-handle, incarnation) as Size

────────────────────
+ get rewind-count Size

C:brixArenaOwnerRewindCount(owner-handle, incarnation) as Size

━━━━━━━━━━━━━━━━━━━━
+ extend CPointer''Item

────────────────────
+ do store-untraced without gc
    - item Item
    - index Index

━━━━━━━━━━━━━━━━━━━━
+ ArenaMark is Tuple

+ value Size

────────────────────
_ do rewind-from Size without gc
    - arena-handle CPointer'Byte
    - arena-incarnation Size

= (C:brixArenaRewind(arena-handle, arena-incarnation, value)) as Size

━━━━━━━━━━━━━━━━━━━━
+ ArenaBacking
    is StorageBacking

+ Context = Arena
+ Storage'Item = CPointer'Item

────────────────────
+ static allocate'Item CPointer'Item without gc
    - context Arena
    - capacity Size

context.allocate'Item(capacity)

────────────────────
+ static load'Item Item @inline without gc
    - storage CPointer'Item
    - index Index

storage[index]

────────────────────
+ static do store'Item Void @inline
    - storage CPointer'Item
    - item Item
    - index Index

storage.store-untraced(item, index)
