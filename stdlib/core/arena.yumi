= (C:yumiArenaRewind(arena-handle, arena-incarnation, value)) as Size

━━━━━━━━━━━━━━━━━━━━
+ ArenaBacking
    is StorageBacking

+ Context = Arena
+ Storage'Item = CPointer'Item

────────────────────
+ static allocate'Item CPointer'Item without gc
    - context Arena
    - capacity Size

context.allocate'Item(capacity)

────────────────────
+ static load'Item Item @inline without gc
    - storage CPointer'Item
    - index Index

storage[index]

────────────────────
+ static do store'Item Void @inline
    - storage CPointer'Item
    - item Item
    - index Index

storage.store-untraced(item, index)

────────────────────
+ static resize'Item CPointer'Item without gc
    - storage CPointer'Item
    - context Arena
    - size Size
    - new-size Size

context.resize-buffer'Item(storage, size, new-size)
