(import ./channel)
(import ./collection)
(import ./core)
(import ./error)
(import ./function)
(import ./intrinsics)
(import ./list)
(import ./map)
(import ./number)
(import ./range)
(import ./stream)
(import ./string)
(import /BxGC/BxGC.h)
(blank)
(prop _ property-subscribers-lane _ (= 0))
(prop _ live-actions-lane _ (= 1))
(prop _ live-batch-run-limit Size (= 1000000))
(prop _ tracker-action-previous (? (list Tracker)) @task)
(prop _ tracker-action-next (? (list Tracker)) @task)
(prop _ live-scopes (? (list LiveScope)) @task)
(prop _ change-comparison-depth U32 @task (= 0))
(prop _ live-batch (? LiveBatch) @task)
(blank)
; Slot zero is a sentinel: handle is the generation, slot is dispatch depth, prev/next are the
; active tail/head, and free starts the free list. Active slots store their generation in free;
; tombstones preserve prev/next for in-flight walkers and use free as their free-list link.
(type-line + PropertySubscriber (is (tuple (: name String) (: handle U64) (: slot Index) (: prev Index) (: next Index) (: free Index))))
(type-line + PropertyTrackerSubscription (is (tuple (: action U64) (: handle U64) (: slot Index))))
(type-line _ LiveScope (is (tuple (: previous (? (list Tracker))) (: next (? (list Tracker))))))

(type + Tracker (is Interface)
  (fn-expr + attach _
    (param action LiveAction)
  )
  (fn-expr + detach _
    (param action LiveAction)
  )
  (fn-do + matches-property-dependency Bool
    (param owner Pointer)
    (param property-id Size)
    (param name String)
    (param is-dynamic-name Bool)
    (do
      (inline owner)
    )
    (do
      (inline property-id)
    )
    (do
      (inline name)
    )
    (do
      (inline is-dynamic-name)
    )
    (return false)
  )
  (fn-do + matches-collection-dependency Bool
    (param collection Pointer)
    (do
      (inline collection)
    )
    (return false)
  )
  (fn-do + adopt-constructed-owner _
    (param constructed-subscribers Pointer)
    (param constructed-owner Pointer)
    (do
      (inline constructed-subscribers)
    )
    (do
      (inline constructed-owner)
    )
  )
)

(type + SubscriberCallback (is (fn-type Void (?! Error))))

(type + PropertyTracker
  (implements Tracker)
  (prop + name String)
  (prop + property-id Size)
  (prop + is-dynamic-name _ (= false))
  (prop + subscribers (list PropertySubscriber))
  (prop + owner Pointer (= (call Pointer)))
  (blank)
  (prop _ subscription U64)
  (prop _ subscriber-slot Index (= 0))
  (prop _ subscription-action U64)
  (prop _ additional-subscriptions (? (list PropertyTrackerSubscription)))
  (fn-do + This _
    (param name _)
    (param property-id _)
    (param subscribers _)
  )
  (fn-do + This _
    (param name _)
    (param subscribers _)
    (= is-dynamic-name true)
  )
  (fn-expr + matches-property-dependency Bool
    (param expected-owner Pointer)
    (param expected-property-id Size)
    (param expected-name String)
    (param expected-is-dynamic-name Bool)
    (case? (or (!= owner expected-owner) (!= is-dynamic-name expected-is-dynamic-name))
      false
    )
    (case? is-dynamic-name
      (== name expected-name)
    )
    (default
      (== property-id expected-property-id)
    )
  )
  (fn-do + adopt-constructed-owner _
    (param constructed-subscribers Pointer)
    (param constructed-owner Pointer)
    (return-if (if (or (!= owner constructed-subscribers) (!= (as subscribers Pointer) constructed-subscribers))))
    (blank)
    (= owner constructed-owner)
  )
  (fn-do + attach _
    (param action LiveAction)
    (probe-count markup.action.tracker-attaches)
    (let action-id (. action tracker-id))
    (if action-id
      (throw (call Panic "Property tracker is already attached to this action") (if (== subscription-action action-id)))
      (blank)
      (if additional-subscriptions
        (for (in attached additional-subscriptions)
          (throw (call Panic "Property tracker is already attached to this action") (if (== (. attached action) action-id)))
        )
      )
    )
    (blank)
    (let handle (call property-subscriber-register owner action))
    (throw (call Panic "Unable to register property subscription") (if (not handle)))
    (blank)
    (if (not action-id)
      (= action-id handle)
      (= (. action tracker-id) action-id)
    )
    (let slot (call property-subscriber-link subscribers name handle (. action dispatches-first)))
    (if (not subscription)
      (= subscription handle)
      (= subscriber-slot slot)
      (= subscription-action action-id)
      (else
        (if (not additional-subscriptions)
          (= additional-subscriptions (call (of List PropertyTrackerSubscription)))
        )
        (+= (!! additional-subscriptions) (tuple action-id handle slot))
      )
    )
  )
  (fn-do + detach _
    (param action LiveAction)
    (probe-count markup.action.tracker-detaches)
    (do
      (inline action)
    )
    (blank)
    (let action-id (. action tracker-id))
    (return-if (if (not action-id)))
    (blank)
    (if (== subscription-action action-id)
      (let handle subscription)
      (let slot subscriber-slot)
      (= subscription 0)
      (= subscriber-slot 0)
      (= subscription-action 0)
      (blank)
      (do
        (inline (call property-subscriber-unlink subscribers slot handle))
      )
      (do
        (inline (call property-subscriber-release handle))
      )
      (return)
    )
    (blank)
    (if additional-subscriptions
      (let index Index 0)
      (while (< index (. (!! additional-subscriptions) length))
        (let attached ([] (!! additional-subscriptions) index))
        (if (== (. attached action) action-id)
          (call (. (!! additional-subscriptions) remove) index)
          (do
            (inline (call property-subscriber-unlink subscribers (. attached slot) (. attached handle)))
          )
          (do
            (inline (call property-subscriber-release (. attached handle)))
          )
          (return)
        )
        (+= index 1)
      )
    )
  )
)

(type + CollectionTracker
  (implements Tracker)
  (prop + collection Pointer)
  (blank)
  (prop _ subscriptions (list CollectionSubscription))
  (fn-do + This _
    (param collection _)
  )
  (fn-expr + matches-collection-dependency Bool
    (param expected Pointer)
    (== collection expected)
  )
  (fn-do + attach _
    (param action LiveAction)
    (let handle (call property-subscriber-register collection action))
    (throw (call Panic "Unable to register collection subscription") (if (not handle)))
    (blank)
    (let action-id (. action tracker-id))
    (if (not action-id)
      (= action-id handle)
      (= (. action tracker-id) action-id)
    )
    (+= subscriptions (call CollectionSubscription collection action-id handle))
  )
  (fn-do + detach _
    (param action LiveAction)
    (let action-id (. action tracker-id))
    (return-if (if (not action-id)))
    (blank)
    (let index Index 0)
    (while (< index (. subscriptions length))
      (let subscription ([] subscriptions index))
      (if (== (. subscription action-id) action-id)
        (call (. subscriptions remove) index)
        (call (. subscription close))
        (return)
      )
      (+= index 1)
    )
  )
)

(type + (of BroadcasterTracker Item)
  (implements Tracker)
  (prop + broadcaster (of Broadcastable Item))
  (prop + latest Item)
  (prop + action (? LiveAction))
  (blank)
  (prop _ subscription (? (of Subscription Item)))
  (fn-do + This _
    (param broadcaster _)
    (param latest _)
  )
  (fn-do + attach _
    (param action LiveAction)
    (= (. this action) action)
    (= subscription (call (of Subscription Item) (. this dispatch)))
    (blank)
    (call (. broadcaster subscribe) (!! subscription)
      (block
        (on-error Error
          (throw (call Panic "Unable to attach broadcaster tracker"))
        )
      )
    )
  )
  (fn-do + detach _
    (param action LiveAction)
    (= (. this action) null)
    (blank)
    (if subscription
      (call (. broadcaster unsubscribe) subscription
        (block
          (on-error Error
            (throw (call Panic "Unable to detach broadcaster tracker"))
          )
        )
      )
      (= subscription null)
    )
  )
  (fn-do + dispatch _
    (param message Item)
    (param broadcaster (of Broadcastable Item))
    (= latest message)
    (blank)
    (if action
      (call action)
    )
  )
)

(type + (of SubscriptionTracker Item)
  (implements Tracker)
  (prop + broadcaster (of Broadcastable Item))
  (prop + subscription (of Subscribable Item))
  (fn-do + This _
    (param broadcaster _)
    (param subscription _)
  )
  (fn-do + attach _
    (param action LiveAction)
    (call (. broadcaster subscribe) subscription
      (block
        (on-error Error
          (throw (call Panic "Unable to attach subscription tracker"))
        )
      )
    )
  )
  (fn-do + detach _
    (param action LiveAction)
    (call (. broadcaster unsubscribe) subscription
      (block
        (on-error Error
          (throw (call Panic "Unable to detach subscription tracker"))
        )
      )
    )
  )
)

(type + ClosableTracker
  (implements Tracker)
  (prop + closable Closable)
  (fn-do + This _
    (param closable _)
  )
  (fn-do + attach _
    (param action LiveAction)
  )
  (fn-do + detach _
    (param action LiveAction)
    (call (. closable close)
      (block
        (on-error Error
          (throw (call Panic "Unable to detach closable tracker"))
        )
      )
    )
  )
)

(type + LiveAction
  (prop + trackers (list Tracker))
  (prop + callback SubscriberCallback)
  (prop + is-closed _ (= false))
  (blank)
  (prop _ tracker-id U64)
  (prop _ next-trackers (? (list Tracker)))
  (prop _ is-detached _ (= false))
  (prop _ dispatches-first _ (= false))
  (prop _ is-queued _ (= false))
  (prop _ is-definite _ (= false))
  (prop _ maybe-from (? (list MemoAction)))
  (fn-do + This _
    (param callback SubscriberCallback)
  )
  (fn-do + This _
    (param trackers (list Tracker))
    (param callback SubscriberCallback)
    (for (in tracker trackers)
      (call (. tracker attach) this)
    )
  )
  (fn-do + dispatch-first _
    (return-if (if dispatches-first))
    (blank)
    (= dispatches-first true)
    (return-if (if is-detached))
    (blank)
    (for (in tracker trackers)
      (if (is tracker PropertyTracker)
        (call (. tracker detach) this)
        (call (. tracker attach) this)
      )
    )
  )
  (fn-do + this _
    (return-if (if is-closed))
    (blank)
    (probe-count markup.action.dispatches)
    (= is-definite true)
    (call schedule)
  )
  (fn-do + notify-maybe _
    (param memo MemoAction)
    (return-if (if is-closed))
    (blank)
    (if (not maybe-from)
      (= maybe-from (call (of List MemoAction)))
    )
    (let memos (!! maybe-from))
    (let expected (as memo Pointer))
    (for (in held memos)
      (return-if (if (== (as held Pointer) expected)))
    )
    (+= memos memo)
    (call schedule)
  )
  (fn-do + schedule _
    (call schedule-live)
  )
  (fn-do + schedule-live _
    (let batch (call task-live-batch))
    (if (!= (. batch depth) 0)
      (if (not is-queued)
        (= is-queued true)
        (call (. batch add) this)
      )
      (return)
    )
    (= is-queued true)
    (= (. batch depth) 1)
    (finally
      (call (. batch leave))
    )
    (call run-queued)
  )
  (fn-do + run-queued _
    (let runs (call should-run))
    (= is-queued false)
    (call reset-notice)
    (if runs
      (call run-now)
    )
  )
  (fn-do + should-run Bool @inline
    (return-if false (if is-closed))
    (return-if true (if is-definite))
    (return (call settles-changed))
  )
  (fn-do + reset-notice _
    (= is-definite false)
    (= maybe-from null)
  )
  (fn-do + run-now _
    (return-if (if is-closed))
    (blank)
    (call refresh-trackers)
    (probe-count markup.action.immediate-runs)
  )
  (fn-do + refresh-trackers _
    (let buffer (?? next-trackers (call (of List Tracker))))
    (= next-trackers buffer)
    (call refresh-trackers-into buffer true)
  )
  (fn-do + detach-trackers _
    (return-if (if is-detached))
    (blank)
    (= is-detached true)
    (for (in tracker trackers)
      (call (. tracker detach) this)
    )
  )
  (fn-do + close _
    (if (not is-closed)
      (= is-closed true)
      (call detach-trackers)
      (call (. trackers clear))
      (call (?. next-trackers clear))
    )
  )
  (fn-do _ settles-changed Bool
    (let found maybe-from)
    (return-if false (if (not found)))
    (blank)
    (let memos found)
    (for (in memo memos)
      (call (. memo settle))
      (return-if true (if is-definite))
    )
    (return false)
  )
  (fn-do _ refresh-trackers-into _
    (param new-trackers (list Tracker))
    (param recycle Bool)
    (call (. new-trackers clear))
    (let completed false)
    (finally
      (if (not completed)
        (call (. new-trackers clear))
      )
    )
    (blank)
    (let saved-previous tracker-action-previous)
    (let saved-next tracker-action-next)
    (= tracker-action-previous trackers)
    (= tracker-action-next new-trackers)
    (finally
      (= tracker-action-previous saved-previous)
      (= tracker-action-next saved-next)
    )
    (blank)
    (call callback
      (block
        (on-error (: error Error)
          (call unhandled-error error)
        )
      )
    )
    (probe-count markup.action.runs)
    (probe-count markup.action.tracker-old (. trackers length))
    (probe-count markup.action.tracker-new (. new-trackers length))
    (blank)
    (if is-detached
      (= is-detached false)
      (for (in tracker new-trackers)
        (call (. tracker attach) this)
      )
      (else-if (or (> (. trackers length) 16) (> (. new-trackers length) 16))
        ; Large or shared dependency sets use pointer-keyed membership tables, avoiding quadratic
        ; removal and insertion scans. Small sets stay allocation-free and favor their linear cache.
        (let old-members (call (of Map Pointer Bool)))
        (let new-members (call (of Map Pointer Bool)))
        (for (in tracker trackers)
          (= ([] old-members (as tracker Pointer)) true)
        )
        (for (in tracker new-trackers)
          (= ([] new-members (as tracker Pointer)) true)
        )
        (blank)
        (for (in tracker trackers)
          (if (not (has new-members (as tracker Pointer)))
            (call (. tracker detach) this)
            (probe-count markup.action.tracker-removed)
          )
        )
        (blank)
        (for (in tracker new-trackers)
          (if (not (has old-members (as tracker Pointer)))
            (call (. tracker attach) this)
          )
        )
      )
      (else
        (for (in tracker trackers)
          (if (not (call tracker-list-has new-trackers tracker))
            (call (. tracker detach) this)
            (probe-count markup.action.tracker-removed)
          )
        )
        (blank)
        (for (in tracker new-trackers)
          (if (not (call tracker-list-has trackers tracker))
            (call (. tracker attach) this)
          )
        )
      )
    )
    (blank)
    (let old-trackers trackers)
    (= trackers new-trackers)
    (if recycle
      (call (. old-trackers clear))
      (= next-trackers old-trackers)
    )
    (= completed true)
  )
)

(type + MemoAction (is LiveAction)
  (prop + owner Pointer)
  (prop + flag-offset Size)
  (prop + name String)
  (blank)
  (prop _ linked-at U64)
  (fn-do + This _
    (param initial-trackers (list Tracker))
    (param action-callback SubscriberCallback)
    (param owner _)
    (param flag-offset _)
    (param name _)
    (lazy trackers initial-trackers)
    (= callback action-callback)
    (blank)
    (for (in tracker trackers)
      (call (. tracker attach) this)
    )
  )
  (fn-expr + is-dirty Bool :get
    (!= ([] owner flag-offset) 0)
  )
  (fn-do + this _
    (call mark)
  )
  (fn-do + notify-maybe _
    (param memo MemoAction)
    (do
      (inline memo)
    )
    (call mark)
  )
  (fn-do + mark _
    (return-if (if is-closed))
    (blank)
    (let found (call (of gc-object-side-payload (of List PropertySubscriber)) owner property-subscribers-lane))
    (let linked (call linked-generation found))
    (return-if (if (and is-dirty (== linked-at linked))))
    (blank)
    (= ([] owner flag-offset) 1)
    (= linked-at linked)
    (return-if (if (not found)))
    (blank)
    (let subscribers found)
    (let batch (call live-batch-enter))
    (finally
      (call (. batch leave))
    )
    (call property-notify subscribers name this)
  )
  (fn-do + settle _
    (return-if (if (not is-dirty)))
    (blank)
    (= ([] owner flag-offset) 0)
    (return-if (if is-closed))
    (blank)
    (call refresh-trackers)
  )
)

(type + LiveBatch
  (prop + depth Size (= 0))
  (blank)
  (prop _ queue (list (? LiveAction)))
  (fn-do + add _
    (param action LiveAction)
    (+= queue action)
  )
  (fn-do + leave _
    (-= depth 1)
    (if (and (== depth 0) (!= (. queue length) 0))
      (call run)
    )
  )
  (fn-do _ run _
    (= depth 1)
    (finally
      (= depth 0)
      (for (in slot (..< 0 (. queue length)))
        (= ([] queue slot) null)
      )
      (call (. queue clear))
    )
    (let index Index 0)
    (while (< index (. queue length))
      (throw (call Panic "Live actions kept changing what they read and never settled") (if (>= index live-batch-run-limit)))
      (blank)
      (let action ([] queue index))
      (+= index 1)
      (if action
        (call (. action run-queued))
      )
    )
  )
)

(fn-do + register-property-subscriber-cleanup _
  (param object _)
  (param subscribers (list PropertySubscriber))
  ; Compiler-generated property subscriber lists live in the owner's side-payload lane. Native lane
  ; teardown releases the list with the owner, so this hook intentionally registers no second cleanup.
  (blank)
  (do
    (inline object)
  )
  (do
    (inline (. subscribers length))
  )
)

(fn-do + property-observed Bool
  (param owner Pointer)
  (param name String)
  (let found (call (of gc-object-side-payload (of List PropertySubscriber)) owner property-subscribers-lane))
  (return-if (if (not found)))
  (blank)
  (let subscribers found)
  (return-if (if (not (. subscribers length))))
  (blank)
  (let slot (. ([] subscribers 0) next))
  (while slot
    (let subscriber ([] subscribers slot))
    (return-if true (if (and (. subscriber handle) (== (. subscriber name) name))))
    (blank)
    (= slot (. subscriber next))
  )
  (return false)
)

(fn-do + track-property-dependency Tracker
  (param previous (list Tracker))
  (param next (list Tracker))
  (param name String)
  (param property-id Size)
  (param subscribers (list PropertySubscriber))
  (param owner Pointer)
  (let tracker (call track-property-key previous next name property-id subscribers owner false))
  (return tracker)
)

(fn-do + track-property-dependency Tracker
  (param previous (list Tracker))
  (param next (list Tracker))
  (param name String)
  (param subscribers (list PropertySubscriber))
  (param owner Pointer)
  (let tracker (call track-property-key previous next name 0 subscribers owner true))
  (return tracker)
)

(fn-do + adopt-constructed-trackers _
  (param trackers (list Tracker))
  (param subscribers (list PropertySubscriber))
  (param owner Pointer)
  (let list (as subscribers Pointer))
  (for (in tracker trackers)
    (call (. tracker adopt-constructed-owner) list owner)
  )
)

(fn-do + track-collection-dependency _
  (param previous (list Tracker))
  (param next (list Tracker))
  (param collection Pointer)
  (for (in tracker next)
    (return-if (if (call (. tracker matches-collection-dependency) collection)))
  )
  (blank)
  (let expected (. next length))
  (if (< expected (. previous length))
    (let tracker ([] previous expected))
    (if (call (. tracker matches-collection-dependency) collection)
      (+= next tracker)
      (return)
    )
  )
  (blank)
  (for (in tracker previous)
    (if (call (. tracker matches-collection-dependency) collection)
      (+= next tracker)
      (return)
    )
  )
  (blank)
  (+= next (call CollectionTracker collection))
)

(fn-do + track-active-dependency _
  (param target Pointer)
  (return-if (if (not tracker-action-next)))
  (blank)
  (call track-collection-dependency (!! tracker-action-previous) (!! tracker-action-next) target)
)

(fn-do + track-active-property _
  (param name String)
  (param property-id Size)
  (param subscribers (list PropertySubscriber))
  (param owner Pointer)
  (return-if (if (not tracker-action-next)))
  (blank)
  (let previous (!! tracker-action-previous))
  (let next (!! tracker-action-next))
  (do
    (inline (call track-property-key previous next name property-id subscribers owner false))
  )
)

(fn-expr + (of watch-changes Value) (of Broadcastable Value)
  (param read (fn-type Value))
  (call (of ChangeSource Value) read)
)

(type + (of ChangeSource Value)
  (implements (of Usable Void))
  (prop _ read (fn-type Value))
  (prop _ action (? LiveAction))
  (prop _ held _ (= (call (of List Value))))
  (blank)
  (delegate (of Broadcastable Value))
  (prop _ channel _ (:= (call (of AsyncOnDemandChannel Value) this)))
  (fn-do + This _
    (param read (fn-type Value))
  )
  (fn-do + begin-using _
    (call (. held clear))
    (let callback SubscriberCallback
      (=> () :do
        (block
          (call changed)
        )
      )
    )
    (let made (call LiveAction (call (of List Tracker)) callback))
    (= action made)
    (call (. made run-now))
  )
  (fn-do + end-using _
    (call (?. action close))
    (= action null)
  )
  (fn-do _ changed _
    (let value (call read))
    (if (not held)
      (+= held value)
      (return)
    )
    (let prior ([] held 0))
    (= ([] held 0) value)
    (if (call value-changed prior value)
      (<- channel value)
    )
  )
)

(fn-do + live-enter _
  (param previous (list Tracker))
  (param next (list Tracker))
  (if (not live-scopes)
    (= live-scopes (call (of List LiveScope)))
  )
  (+= (!! live-scopes) (call LiveScope tracker-action-previous tracker-action-next))
  (= tracker-action-previous previous)
  (= tracker-action-next next)
)

(fn-do + live-enter-untracked _
  (if (not live-scopes)
    (= live-scopes (call (of List LiveScope)))
  )
  (+= (!! live-scopes) (call LiveScope tracker-action-previous tracker-action-next))
  (= tracker-action-previous null)
  (= tracker-action-next null)
)

(fn-do + live-leave _
  (let saved (call (. (!! live-scopes) pop)))
  (= tracker-action-previous (. saved previous))
  (= tracker-action-next (. saved next))
)

(fn-do + (of live-state State) (? State)
  (constraint is State Tracker)
  (return-if null (if (or (not tracker-action-previous) (not tracker-action-next))))
  (blank)
  (let previous (!! tracker-action-previous))
  (let next (!! tracker-action-next))
  (for (in tracker previous)
    (if (and (is tracker State) (not (call tracker-list-has next tracker)))
      (+= next tracker)
      (return (as tracker State))
    )
  )
  (return null)
)

(fn-do + keep-live-state _
  (param state Tracker)
  (throw (call Panic "Only a live function keeps a live state") (if (not tracker-action-next)))
  (blank)
  (+= (!! tracker-action-next) state)
)

(fn-expr + active-previous-trackers (list Tracker) :get
  (before
    (throw (call Panic "No active previous tracker buffer") (if (not tracker-action-previous)))
  )
  (!! tracker-action-previous)
)

(fn-expr + active-next-trackers (list Tracker) :get
  (before
    (throw (call Panic "No active next tracker buffer") (if (not tracker-action-next)))
  )
  (!! tracker-action-next)
)

(fn-expr + is-comparing-for-change _ :get
  (> change-comparison-depth 0)
)

(fn-do + (of value-changed Value) Bool
  (param prior Value)
  (param latest Value)
  (+= change-comparison-depth 1)
  (finally
    (-= change-comparison-depth 1)
  )
  (return (!= prior latest))
)

(fn-do + memo-settle-at _
  (param owner Pointer)
  (param flag-offset Size)
  (let found (call (of gc-object-side-payload (of List LiveAction)) owner live-actions-lane))
  (if found
    (let actions found)
    (for (in action actions)
      (if (is action MemoAction)
        (let memo (as action MemoAction))
        (if (== (. memo flag-offset) flag-offset)
          (call (. memo settle))
          (return)
        )
      )
    )
  )
  (= ([] owner flag-offset) 0)
)

(fn-do + live-batch-enter LiveBatch @inline
  (let batch (call task-live-batch))
  (+= (. batch depth) 1)
  (return batch)
)

(fn-do + property-dispatch _
  (param subscribers (list PropertySubscriber))
  (param name String)
  (probe-count markup.property.dispatches)
  (probe-count markup.property.snapshot-allocations 0)
  (return-if (if (not subscribers)))
  (blank)
  (let batch (call live-batch-enter))
  (finally
    (call (. batch leave))
  )
  (call property-notify subscribers name null)
)

(fn-do + property-dependency-subscribe LiveAction
  (param object _)
  (param name String)
  (param callback Doer)
  (let sub-trackers (call (of List Tracker)))
  (let sub-callback SubscriberCallback
    (=> () :do
      (block
        (call callback)
      )
    )
  )
  (let sub (call LiveAction sub-trackers sub-callback))
  (blank)
  (do
    (inline (call link-property-dependency object name sub))
  )
  (return sub)
)

(fn-do + (of link-property-dependency Object) _
  (param object Object)
  (param name String)
  (param action LiveAction)
  (let subscription (call property-subscriber-register (as object Pointer) action))
  (throw (call Panic "Unable to register weak property dependency subscription") (if (not subscription)))
  (blank)
  (do
    (inline (call property-subscriber-link (. object property-subscribers) name subscription))
  )
)

(type _ CollectionSubscription
  (prop + collection Pointer)
  (prop + action-id U64)
  (prop + handle U64)
  (blank)
  (prop _ observer (? CollectionObserver))
  (fn-do + This _
    (param collection _)
    (param action-id _)
    (param handle _)
    (let new-observer (as (. this notify) CollectionObserver))
    (= observer new-observer)
    (call observe-collection-pointer collection new-observer)
  )
  (fn-do + notify _
    (param mutation CollectionMutation)
    (do
      (inline mutation)
    )
    (let action (call property-subscriber-load handle))
    (if action
      (call action)
      (else
        (call close)
      )
    )
  )
  (fn-do + close _
    (return-if (if (not observer)))
    (blank)
    (call unobserve-collection-pointer collection observer)
    (= observer null)
    (do
      (inline (call property-subscriber-release handle))
    )
  )
)

(fn-do _ property-subscriber-register U64
  (param owner Pointer)
  (param action LiveAction)
  (return (call C:brixGCRegisterOwnerWeak owner (as action Pointer)))
)

(fn-do _ property-subscriber-load (? LiveAction)
  (param handle U64)
  (probe-count markup.property.weak-loads)
  (let pointer (call C:brixGCOwnerWeakLoad handle))
  (return-if (if (not pointer)))
  (return (call (of gc-object-from-pointer LiveAction) pointer))
)

(fn-do _ property-subscriber-release Bool
  (param handle U64)
  (return (call C:brixGCReleaseOwnerWeak handle))
)

(fn-do _ property-subscriber-link Index
  (param subscribers (list PropertySubscriber))
  (param name String)
  (param subscription U64)
  (param leads _ (= false))
  (if (not subscribers)
    (+= subscribers (tuple "" 0 0 0 0 0))
  )
  (blank)
  (let sentinel ([] subscribers 0))
  (let head (. sentinel next))
  (let tail (. sentinel prev))
  (let next-free (. sentinel free))
  (let generation (+ (. sentinel handle) 1))
  (throw (call Panic "Property subscriber generation overflow") (if (not generation)))
  (blank)
  (let slot Index 0)
  (if (and (. sentinel free) (not (. sentinel slot)))
    (= slot (. sentinel free))
    (= next-free (. ([] subscribers slot) free))
    (probe-count markup.property.slot-reuses)
    (else
      (= slot (. subscribers length))
      (+= subscribers (tuple "" 0 slot 0 0 0))
    )
  )
  (blank)
  (if leads
    (= ([] subscribers slot) (tuple name subscription slot 0 head (as generation Index)))
    (if head
      (let h ([] subscribers head))
      (= ([] subscribers head) (tuple (. h name) (. h handle) (. h slot) slot (. h next) (. h free)))
      (else
        (= tail slot)
      )
    )
    (= ([] subscribers 0) (tuple "" generation (. sentinel slot) tail slot next-free))
    (return slot)
  )
  (blank)
  (= ([] subscribers slot) (tuple name subscription slot tail 0 (as generation Index)))
  (if tail
    (let tail-entry ([] subscribers tail))
    (let t tail-entry)
    (let linked-tail (tuple (. t name) (. t handle) (. t slot) (. t prev) slot (. t free)))
    (= ([] subscribers tail) linked-tail)
    (else
      (= head slot)
    )
  )
  (= ([] subscribers 0) (tuple "" generation (. sentinel slot) slot head next-free))
  (return slot)
)

(fn-do _ property-subscriber-unlink Bool
  (param subscribers (list PropertySubscriber))
  (param slot Index)
  (param subscription U64)
  (if (or (not subscribers) (not slot) (>= slot (. subscribers length)))
    (return false)
  )
  (blank)
  (let subscriber ([] subscribers slot))
  (if (!= (. subscriber handle) subscription)
    (return false)
  )
  (blank)
  (let sentinel ([] subscribers 0))
  (let head (. sentinel next))
  (let tail (. sentinel prev))
  (if (. subscriber prev)
    (let prev-slot (. subscriber prev))
    (let prev-entry ([] subscribers prev-slot))
    (let prev-next (. subscriber next))
    (let p prev-entry)
    (let linked-prev (tuple (. p name) (. p handle) (. p slot) (. p prev) prev-next (. p free)))
    (= ([] subscribers prev-slot) linked-prev)
    (else
      (= head (. subscriber next))
    )
  )
  (blank)
  (if (. subscriber next)
    (let next-slot (. subscriber next))
    (let next-entry ([] subscribers next-slot))
    (let n next-entry)
    (let linked-next (tuple (. n name) (. n handle) (. n slot) (. subscriber prev) (. n next) (. n free)))
    (= ([] subscribers next-slot) linked-next)
    (else
      (= tail (. subscriber prev))
    )
  )
  (blank)
  (= ([] subscribers slot) (tuple "" 0 slot (. subscriber prev) (. subscriber next) (. sentinel free)))
  (= ([] subscribers 0) (tuple "" (. sentinel handle) (. sentinel slot) tail head slot))
  (probe-count markup.property.slot-unlinks)
  (return true)
)

(fn-expr _ property-dependency-matches Bool
  (param tracker Tracker)
  (param owner Pointer)
  (param property-id Size)
  (param name String)
  (param is-dynamic-name Bool)
  (call (. tracker matches-property-dependency) owner property-id name is-dynamic-name)
)

(fn-do _ track-property-key Tracker
  (param previous (list Tracker))
  (param next (list Tracker))
  (param name String)
  (param property-id Size)
  (param subscribers (list PropertySubscriber))
  (param owner Pointer)
  (param is-dynamic-name Bool)
  ; Repeated reads in one evaluation are one dependency membership. This also avoids attaching the
  ; same retained tracker twice when an authored expression reads one property more than once.
  (for (in tracker next)
    (probe-count markup.action.tracker-scans)
    (if (call property-dependency-matches tracker owner property-id name is-dynamic-name)
      (probe-count markup.action.tracker-reused)
      (return tracker)
    )
  )
  (blank)
  ; Stable dependency order is the common path, so try the corresponding old slot before the
  ; fallback scan. The fallback preserves reuse for reordered and conditionally inserted reads.
  (let expected (. next length))
  (if (< expected (. previous length))
    (probe-count markup.action.tracker-scans)
    (let tracker ([] previous expected))
    (if (call property-dependency-matches tracker owner property-id name is-dynamic-name)
      (+= next tracker)
      (probe-count markup.action.tracker-reused)
      (return tracker)
    )
  )
  (blank)
  (for (in tracker previous)
    (probe-count markup.action.tracker-scans)
    (if (call property-dependency-matches tracker owner property-id name is-dynamic-name)
      (+= next tracker)
      (probe-count markup.action.tracker-reused)
      (return tracker)
    )
  )
  (blank)
  (let property (call PropertyTracker name property-id subscribers))
  (= (. property owner) owner)
  (= (. property is-dynamic-name) is-dynamic-name)
  (+= next property)
  (probe-count markup.action.tracker-added)
  (return property)
)

(fn-do _ tracker-list-has Bool
  (param trackers (list Tracker))
  (param expected Tracker)
  (let expected-pointer (as expected Pointer))
  (for (in tracker trackers)
    (if (== (as tracker Pointer) expected-pointer)
      (return true)
    )
  )
  (return false)
)

(fn-expr _ linked-generation U64
  (param subscribers (? (list PropertySubscriber)))
  (if-expr (and subscribers (!= (. subscribers length) 0)) (. ([] subscribers 0) handle) 0)
)

(fn-do _ task-live-batch LiveBatch @inline
  (let found live-batch)
  (return-if found (if found))
  (return (call first-live-batch))
)

(fn-do _ first-live-batch LiveBatch
  (let made (call LiveBatch))
  (= live-batch made)
  (return made)
)

(fn-do _ property-notify _
  (param subscribers (list PropertySubscriber))
  (param name String)
  (param memo (? MemoAction))
  (let sentinel ([] subscribers 0))
  (let boundary (. sentinel handle))
  (= ([] subscribers 0) (tuple "" boundary (+ (. sentinel slot) 1) (. sentinel prev) (. sentinel next) (. sentinel free)))
  (blank)
  (let slot (. sentinel next))
  (while slot
    (probe-count markup.property.subscriber-scans)
    (let subscriber ([] subscribers slot))
    (if (. subscriber handle)
      (if (> (. subscriber free) boundary)
        (probe-count markup.property.generation-skips)
        (break)
      )
      (if (== (. subscriber name) name)
        (let subscription (call property-subscriber-load (. subscriber handle)))
        (if subscription
          (if memo
            (call (. subscription notify-maybe) memo)
            (else
              (call subscription)
            )
          )
          (else
            (do
              (inline (call property-subscriber-unlink subscribers (. subscriber slot) (. subscriber handle)))
            )
            (do
              (inline (call property-subscriber-release (. subscriber handle)))
            )
          )
        )
      )
    )
    (= slot (. subscriber next))
  )
  (blank)
  (= sentinel ([] subscribers 0))
  (let exited (tuple "" (. sentinel handle) (- (. sentinel slot) 1) (. sentinel prev) (. sentinel next) (. sentinel free)))
  (= ([] subscribers 0) exited)
)
