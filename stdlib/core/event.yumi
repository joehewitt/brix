━━━━━━━━━━━━━━━━━━━━
+ do event-publish'Payload
    - owner Pointer
    - event-id Size
    - payload Payload

event-machine-publishing += 1
if event-machine-is-draining
    . root = event-machine-hold(owner)
    . dispatch Doer = => do
        event-dispatch(owner, event-id, payload) • handlers false
        event-machine-release(root)
    event-machine-defer(dispatch)
    event-dispatch(owner, event-id, payload) • machines false
else
    event-dispatch(owner, event-id, payload)
event-machine-finish-publish()

