╌╌╌╌╌╌╌╌╌╌ is Subscribable'Payload ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do this
    - payload Payload
    - broadcaster Broadcastable'Payload

post(payload)

────────────────────
+ do unsubscribe

is-subscribed = false

────────────────────
+ do event-bind-address
    - raw-address Pointer
    - generation U64

. bound = gc-object-from-pointer'KeyedEventAddress(raw-address)
if address && (address as Pointer != bound as Pointer || address-generation != generation)
    drop-pending()
address = bound
address-generation = generation

────────────────────
_ do post
    - payload Payload

//event.handlers.machine-enqueued ++
payloads += payload
event-machine-schedule(this)

────────────────────
_ do drop-pending

=? if !payloads
stale += payloads.length - next
payloads.clear()
next = 0

────────────────────
_ do attach
    - source Broadcastable'Payload

detach()
broadcaster = source
source.subscribe(this as Subscribable'Payload)
    catch error Error
        unhandled-error(error)
        =
is-subscribed = true

────────────────────
_ do detach

if is-subscribed
    broadcaster.unsubscribe(this as Subscribable'Payload)
        catch error Error
            unhandled-error(error)
    is-subscribed = false
address = null
drop-pending()

