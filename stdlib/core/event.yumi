    - event-id

╌╌╌╌╌╌╌╌╌╌ is EventEntry ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do close

=? if is-closed
release-keyed-address()
is-closed = true

for entry in slots
    if entry.sub
        . subscription = entry.sub
        subscription.unsubscribe()
slots.clear()
active-slots.clear()
live-count = 0
event-bubbling-adjust(event-id, -bubbling-live-count)
bubbling-live-count = 0

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

╌╌╌╌╌╌╌╌╌╌ is Broadcastable'Payload ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do subscribe
    - subscriber Subscriber'Payload

link(EventSubscription'Payload(subscriber))

────────────────────
+ do unsubscribe
    - subscriber Subscriber'Payload

=? if !slots

if active-slots
    . active-slot = active-slots[active-slots.length - 1]
    . active-subscription = slots[active-slot].sub
    if active-subscription && active-subscription == subscriber
        unlink(active-slot, active-subscription)
        =

. slot = slots[0].next
while slot
    . entry = slots[slot]
    if entry.sub && entry.sub == subscriber
        unlink(slot, entry.sub)
        =
    slot = entry.next

────────────────────
+ do subscribe
    - subscriber Subscribable'Payload

link(subscriber)

────────────────────
+ do unsubscribe
    - subscriber Subscribable'Payload

=? if !slots

. slot = slots[0].next
while slot
    . entry = slots[slot]
    if entry.sub && entry.sub as Pointer == subscriber as Pointer
        unlink(slot, subscriber)
        =
    slot = entry.next

────────────────────
+ do dispatch
    - payload Payload
    - handlers = true
    - machines = true

=? if is-closed || !slots || !live-count

. boundary = slots[0].g
. address-boundary = event-address-generation()
. reaches-all = handlers && machines
. slot = slots[0].next
while slot
    if is-closed || (address-boundary && event-address-generation() != address-boundary)
        break

    . entry = slots[slot]
    if entry.sub
        if entry.g > boundary
            break
        . subscription = entry.sub
        if reaches-all || event-dispatch-reaches(subscription.event-is-machine, handlers, machines)
            active-slots += slot
            subscription(payload, this)
            if active-slots
                active-slots.pop()
    slot = entry.next

────────────────────
+ do dispatch-routed'Route
    - payload Payload
    - routed Route
    - is-target Bool
    - handlers = true
    - machines = true
    - Route is RoutedEvent

=? if is-closed || !slots || !live-count

. boundary = slots[0].g
. reaches-all = handlers && machines
. slot = slots[0].next
while slot
    if is-closed || (handlers && routed.is-canceled)
        break

    . entry = slots[slot]
    if entry.sub
        if entry.g > boundary
            break
        . subscription = entry.sub
        . reaches =
            reaches-all || event-dispatch-reaches(subscription.event-is-machine, handlers, machines)
        if reaches && (is-target || !subscription.event-arrival-only)
            active-slots += slot
            subscription(payload, this)
            if active-slots
                active-slots.pop()
    slot = entry.next

────────────────────
_ do bind-keyed-address
    - address KeyedEventAddress
    - generation U64

keyed-address = address
keyed-generation = generation

────────────────────
_ do update-keyed-generation
    - generation U64

keyed-generation = generation
if keyed-address
    for entry in slots
        if entry.sub
            . subscription = entry.sub
            subscription.event-bind-address(keyed-address! as Pointer, generation)

────────────────────
_ event-address-generation U64

|? !keyed-address
    0
|? !address.is-generation-live(keyed-generation)
    0
|? address.endpoint as Pointer != this as Pointer
    0
??
    keyed-generation

.. address = keyed-address

────────────────────
_ do release-keyed-address

=? if !keyed-address
. address = keyed-address
if address.is-generation-live(keyed-generation)
    address.index.release(address)

────────────────────
_ do link
    - subscription Subscribable'Payload

?! Panic("Illegal to subscribe to a closed event")
    if is-closed

if keyed-address
    subscription.event-bind-address(keyed-address as Pointer, keyed-generation)

if !slots
    slots += (null, 0, 0, 0, 0)

. sentinel = slots[0]
. head = sentinel.next
. tail = sentinel.prev
. next-free = sentinel.free
. generation = sentinel.g + 1
?! Panic("Event subscription generation overflow")
    if !generation

. slot Index = 0
if sentinel.free && !active-slots
    slot = sentinel.free
    next-free = slots[slot].free
else
    slot = slots.length
    slots += (null, 0, 0, 0, 0)

slots[slot] = (subscription, generation, tail, 0, 0)
if tail
    . tail-entry = slots[tail]
    slots[tail] =
        (tail-entry.sub, tail-entry.g, tail-entry.prev, slot, tail-entry.free)
else
    head = slot

slots[0] = (null, generation, slot, head, next-free)
live-count += 1
if !subscription.event-arrival-only
    bubbling-live-count += 1
    event-bubbling-adjust(event-id, 1)
//event.subscriptions.sidecar ++

────────────────────
_ do unlink
    - slot Index
    - subscription Subscribable'Payload

=? if !slots || !slot || slot >= slots.length

. entry = slots[slot]
=? if !entry.sub || entry.sub as Pointer != subscription as Pointer

. sentinel = slots[0]
. head = sentinel.next
. tail = sentinel.prev
if entry.prev
    . previous = slots[entry.prev]
    slots[entry.prev] =
        (previous.sub, previous.g, previous.prev, entry.next, previous.free)
else
    head = entry.next

if entry.next
    . next = slots[entry.next]
    slots[entry.next] =
        (next.sub, next.g, entry.prev, next.next, next.free)
else
    tail = entry.prev

slots[slot] = (null, 0, entry.prev, entry.next, sentinel.free)
slots[0] = (null, sentinel.g, tail, head, slot)
live-count -= 1
if !subscription.event-arrival-only
    bubbling-live-count -= 1
    event-bubbling-adjust(event-id, -1)
subscription.unsubscribe()

━━━━━━━━━━━━━━━━━━━━
_ EventSidecar

_ entries [EventEntry]
_ machine-stops List'EventMachineStop?
_ is-closed = false

────────────────────
_ do find EventEntry?
    - event-id Size

for entry in entries
    if entry.event-id == event-id
        = entry

────────────────────
_ do close

=? if is-closed
is-closed = true
for entry in entries
    entry.close()

━━━━━━━━━━━━━━━━━━━━
_ EventMachineStop is () Void

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-drain

event-machine-is-draining = true
. index Index = 0
while index < event-machine-lanes.length
    . lane = event-machine-lanes[index]
    index += 1
    lane.run-next()
        catch error Error
            unhandled-error(error)
event-machine-lanes.clear()
event-machine-is-draining = false

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-schedule
    - lane EventMachineLane

if event-machine-dispatches.is-resolving
    event-machine-dispatches.resolved += lane
else
    event-machine-lanes += lane
    if !event-machine-publishing && !event-machine-is-draining
        event-machine-drain()

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-defer
    - dispatch Doer

event-machine-dispatches.dispatches += dispatch
event-machine-schedule(event-machine-dispatches)

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-hold Pointer
    - owner Pointer

= C:yumiGCAddRoot(owner)

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-release
    - root Pointer

C:yumiGCRemoveRoot(root)

━━━━━━━━━━━━━━━━━━━━
_ event-dispatch-reaches Bool
    - is-machine Bool
    - handlers Bool
    - machines Bool

if is-machine then machines else handlers

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-enqueue'Payload
    - subscriber Subscriber'Payload
    - payload Payload
    - broadcaster Broadcastable'Payload

. transition Doer = => do
    subscriber(payload, broadcaster)
event-machine-deferrals.doers += transition
event-machine-schedule(event-machine-deferrals)

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-settle-route

=? if event-machine-publishing != 1 || event-machine-is-draining || !event-machine-lanes
event-machine-drain()

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-finish-publish

event-machine-publishing -= 1
if !event-machine-publishing && !event-machine-is-draining && event-machine-lanes
    event-machine-drain()

━━━━━━━━━━━━━━━━━━━━
_ event-subscription'Payload Subscribable'Payload
    - subscriber Subscriber'Payload
    - arrival-only = false

EventSubscription'Payload(subscriber, arrival-only)

━━━━━━━━━━━━━━━━━━━━
_ event-machine-port'Payload EventMachinePort'Payload
    - handler Subscriber'Payload
    - broadcaster Broadcastable'Payload

EventMachinePort'Payload(handler, broadcaster)

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-attach'Payload EventMachinePort'Payload
    - port EventMachinePort'Payload?
    - handler Subscriber'Payload
    - broadcaster Broadcastable'Payload

. attached = port ?? EventMachinePort'Payload(handler, broadcaster)
attached.attach(broadcaster)
= attached

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-detach'Payload
    - port EventMachinePort'Payload?

port?.detach()

━━━━━━━━━━━━━━━━━━━━
_ do event-machine-post'Payload
    - port EventMachinePort'Payload
    - payload Payload

port.post(payload)

━━━━━━━━━━━━━━━━━━━━
_ do event-register-lowered
    - event-id Size
    - matcher EventLoweredOwnerMatcher
    - callback Pointer
    - order Size
    - is-machine Bool

event-register-descriptor(event-id, matcher, callback, order, is-machine, false)

━━━━━━━━━━━━━━━━━━━━
_ do event-register-lowered-arrival
    - event-id Size
    - matcher EventLoweredOwnerMatcher
    - callback Pointer
    - order Size
    - is-machine Bool

event-register-descriptor(event-id, matcher, callback, order, is-machine, true)

━━━━━━━━━━━━━━━━━━━━
_ do event-register-descriptor
    - event-id Size
    - matcher EventLoweredOwnerMatcher
    - callback Pointer
    - order Size
    - is-machine Bool
    - arrival-only Bool

=? if !event-insert-descriptor(event-descriptor-heads, event-id, matcher, callback, order, is-machine)
if !arrival-only
    . ignored = event-insert-descriptor
        - event-bubbling-heads
        - event-id
        - matcher
        - callback
        - order
        - is-machine
    event-bubbling-adjust(event-id, 1)
//event.subscriptions.lowered ++

━━━━━━━━━━━━━━━━━━━━
_ do event-insert-descriptor Bool
    - heads [EventLoweredDescriptor?]
    - event-id Size
    - matcher EventLoweredOwnerMatcher
    - callback Pointer
    - order Size
    - is-machine Bool

while heads.length <= event-id
    heads += null
. current = heads[event-id]
. tail EventLoweredDescriptor?
while current
    . descriptor = current
    if descriptor.matcher as Pointer == matcher as Pointer
        if descriptor.order == order
            = false
    tail = descriptor
    current = descriptor.next

. descriptor = EventLoweredDescriptor(matcher, callback, order, is-machine)
if tail
    tail.next = descriptor
else
    heads[event-id] = descriptor
= true

━━━━━━━━━━━━━━━━━━━━
_ do event-bubbling-adjust
    - event-id Size
    - delta Size

=? if !delta
while event-bubbling-counts.length <= event-id
    event-bubbling-counts += 0
event-bubbling-counts[event-id] += delta

━━━━━━━━━━━━━━━━━━━━
_ event-has-bubbling-interest Bool @inline
    - event-id Size

event-id < event-bubbling-counts.length && event-bubbling-counts[event-id] > 0

━━━━━━━━━━━━━━━━━━━━
_ do event-has-lowered-owner Bool
    - owner Pointer

for head in event-descriptor-heads
    . current = head
    while current
        . descriptor = current
        . matcher = descriptor.matcher
        if matcher(owner)
            = true
        current = descriptor.next
= false

━━━━━━━━━━━━━━━━━━━━
_ do event-has-lowered-interest Bool
    - owner Pointer
    - event-id Size

if event-id >= event-descriptor-heads.length
    = false
. current = event-descriptor-heads[event-id]
while current
    . descriptor = current
    . matcher = descriptor.matcher
    if matcher(owner)
        = true
    current = descriptor.next
= false

━━━━━━━━━━━━━━━━━━━━
_ keyed-event-bucket Index
    - key-low U64
    - key-high U64
    - capacity Size

((low * 131 + high) % capacity) as Index

.. low = key-low % capacity
.. high = key-high % capacity

━━━━━━━━━━━━━━━━━━━━
_ events-lane Size

C:yumiGCEventsSidePayloadLane() as Size

━━━━━━━━━━━━━━━━━━━━
_ do event-sidecar EventSidecar
    - owner Pointer

. existing = gc-object-side-payload'EventSidecar(owner, events-lane())
if existing
    = existing

. created = EventSidecar()
//event.sidecars.created ++
gc-publish-object-side-payload(owner, events-lane(), created)
= created

━━━━━━━━━━━━━━━━━━━━
_ do event-keyed-index KeyedEventIndex
    - owner Pointer
    - event-id Size

. sidecar = event-sidecar(owner)
?! Panic("Illegal to access a closed event")
    if sidecar.is-closed
. existing = sidecar.find(event-id)
if existing
    = existing as KeyedEventIndex

. index = KeyedEventIndex(event-id)
sidecar.entries += index
//event.endpoint.entries ++
= index

━━━━━━━━━━━━━━━━━━━━
_ do event-dispatch-keyed'Payload
    - owner Pointer
    - event-id Size
    - key-low U64
    - key-high U64
    - expected-generation U64
    - payload Payload
    - handlers = true
    - machines = true

. sidecar = gc-object-side-payload'EventSidecar(owner, events-lane())
=? if !sidecar || sidecar.is-closed
. entry = sidecar.find(event-id)
=? if !entry
. index = entry as KeyedEventIndex
. address = index.find-live(key-low, key-high)
=? if !address || !address.is-generation-live(expected-generation)
. endpoint = address.endpoint as EventEndpoint'Payload
=? if endpoint.event-address-generation() != expected-generation
endpoint.dispatch(payload, handlers, machines)

━━━━━━━━━━━━━━━━━━━━
_ do event-publish-owner'Payload'Route Bool
    - owner Pointer
    - event-id Size
    - payload Payload
    - routed Route
    - is-target Bool
    - handlers Bool
    - machines Bool
    - Route is RoutedEvent

. sidecar = gc-object-side-payload'EventSidecar(owner, events-lane())
if sidecar?.is-closed ?? false
    = false

. interested = false
. heads = if is-target then event-descriptor-heads else event-bubbling-heads
if event-id < heads.length
    . current = heads[event-id]
    while current
        . descriptor = current
        //event.descriptor.visits ++
        . matcher = descriptor.matcher
        if matcher(owner)
            interested = true
            if event-dispatch-reaches(descriptor.is-machine, handlers, machines)
                if !descriptor.is-machine
                    //event.handlers.sync ++
                event-invoke-lowered(descriptor.callback, owner, payload)
                if handlers && routed.is-canceled
                    = true
                sidecar = gc-object-side-payload'EventSidecar(owner, events-lane())
                if sidecar?.is-closed ?? false
                    = true
        current = descriptor.next

if !sidecar
    = interested
. entry = sidecar.find(event-id)
if !entry || !entry.has-interest
    = interested
if !is-target && !entry.has-bubbling-interest
    = interested
interested = true
(entry as EventEndpoint'Payload).dispatch-routed(payload, routed, is-target, handlers, machines)
= interested

━━━━━━━━━━━━━━━━━━━━
_ do event-publish-routed'Payload Bool
    - event-id Size
    - target Pointer
    - payload Payload
    - Payload is RoutedEvent

= event-publish-along(event-id, target, null, payload, payload)

━━━━━━━━━━━━━━━━━━━━
_ do event-publish-routed-node'Payload Bool
    - event-id Size
    - target Pointer
    - node EventNode
    - payload Payload
    - Payload is RoutedEvent

. walk EventNode? = if payload.has-own-route then null else node
= event-publish-along(event-id, target, walk, payload, payload)

━━━━━━━━━━━━━━━━━━━━
_ do event-publish-node'Payload
    - target Pointer
    - event-id Size
    - node EventNode
    - payload Payload

event-publish-along(event-id, target, node, payload, event-no-route)

━━━━━━━━━━━━━━━━━━━━
_ do event-publish-along'Payload'Route Bool
    - event-id Size
    - target Pointer
    - node EventNode?
    - payload Payload
    - routed Route
    - Route is RoutedEvent

event-machine-publishing += 1
if event-machine-is-draining
    . reached = List'EventRouteFrame()
    . dispatch Doer = => do
        event-dispatch-routed-machines(event-id, payload, routed, reached)
    event-machine-defer(dispatch)
    event-dispatch-routed(event-id, target, node, payload, routed, reached)
else
    event-dispatch-routed(event-id, target, node, payload, routed, null)
event-machine-finish-publish()
= routed.is-canceled

━━━━━━━━━━━━━━━━━━━━
_ do event-dispatch-routed'Payload'Route
    - event-id Size
    - target Pointer
    - node EventNode?
    - payload Payload
    - routed Route
    - reached [EventRouteFrame]?
    - Route is RoutedEvent

//event.publish.attempts ++
=? if routed.is-canceled
. interested = false
. current Pointer? = target
. walker = node
. is-target = true
while current
    . owner = current
    //event.route.frames ++
    if reached != null
        reached += (owner, event-machine-hold(owner))
    if event-publish-owner(owner, event-id, payload, routed, is-target, true, reached == null)
        interested = true
        event-machine-settle-route()
        =? if routed.is-canceled
    if is-target && !event-has-bubbling-interest(event-id)
        break
    if walker
        walker = walker.event-parent
        current = null
        if walker
            current = walker as Pointer
    else
        current = routed.next-event-owner(owner)
    is-target = false

if !interested
    //event.publish.interest-misses ++

━━━━━━━━━━━━━━━━━━━━
_ do event-dispatch-routed-machines'Payload'Route
    - event-id Size
    - payload Payload
    - routed Route
    - reached [EventRouteFrame]
    - Route is RoutedEvent

. is-target = true
for frame in reached
    event-publish-owner(frame.owner, event-id, payload, routed, is-target, false, true)
    event-machine-release(frame.root)
    is-target = false

━━━━━━━━━━━━━━━━━━━━
_ do event-dispatch'Payload
    - owner Pointer
    - event-id Size
    - payload Payload
    - handlers = true
    - machines = true

. sidecar = gc-object-side-payload'EventSidecar(owner, events-lane())
=? if sidecar?.is-closed ?? false

if event-id < event-descriptor-heads.length
    . current = event-descriptor-heads[event-id]
    while current
        . descriptor = current
        //event.descriptor.visits ++
        . matcher = descriptor.matcher
        if event-dispatch-reaches(descriptor.is-machine, handlers, machines) && matcher(owner)
            if !descriptor.is-machine
                //event.handlers.sync ++
            event-invoke-lowered(descriptor.callback, owner, payload)
            sidecar = gc-object-side-payload'EventSidecar(owner, events-lane())
            if sidecar?.is-closed ?? false
                =
        current = descriptor.next

=? if !sidecar

. entry = sidecar.find(event-id)
=? if !entry || !entry.has-interest

(entry as EventEndpoint'Payload).dispatch(payload, handlers, machines)
