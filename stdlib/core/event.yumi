━━━━━━━━━━━━━━━━━━━━
+ event-keyed-interest-generation'Payload U64
    - owner Pointer
    - event-id Size
    - key-low U64
    - key-high U64

|? sidecar?.is-closed ?? false
    0
|? !sidecar
    0
|? !entry
    0
|? !address
    0
|? !endpoint.has-interest && !event-machine-is-draining
    0
??
    endpoint.event-address-generation()

.. sidecar = gc-object-side-payload'EventSidecar(owner, events-lane())
.. entry = sidecar.find(event-id)
.. index = entry as KeyedEventIndex
.. address = index.find-live(key-low, key-high)
.. endpoint = address.endpoint as EventEndpoint'Payload

━━━━━━━━━━━━━━━━━━━━
+ do event-keyed-rekey'Payload ?! Error
    - owner Pointer
    - event-id Size
    - old-key-low U64
    - old-key-high U64
    - new-key-low U64
    - new-key-high U64
    - receiver-identity U64

. sidecar = gc-object-side-payload'EventSidecar(owner, events-lane())
?! Error("Keyed event address is not claimed")
    if !sidecar || sidecar.is-closed
. entry = sidecar.find(event-id)
?! Error("Keyed event address is not claimed")
    if !entry
. index = entry as KeyedEventIndex
. address = index.find-live(old-key-low, old-key-high)
?! Error("Keyed event address is not claimed by this receiver")
    if !address || address.receiver-identity != receiver-identity
=? if old-key-low == new-key-low && old-key-high == new-key-high

. collision = index.find-live(new-key-low, new-key-high)
?! Error("Duplicate keyed event receiver for $new-key-low:$new-key-high")
    if collision

index.prepare-bucket-insert()
. generation = index.allocate-generation()
address.key-low = new-key-low
address.key-high = new-key-high
address.generation = generation
index.insert-bucket(address)
. endpoint = address.endpoint as EventEndpoint'Payload
endpoint.update-keyed-generation(generation)
//event.key-index.updates ++

━━━━━━━━━━━━━━━━━━━━
+ do event-keyed-release'Payload
    - owner Pointer
    - event-id Size
    - key-low U64
    - key-high U64
    - receiver-identity U64

. sidecar = gc-object-side-payload'EventSidecar(owner, events-lane())
=? if !sidecar || sidecar.is-closed
. entry = sidecar.find(event-id)
=? if !entry
. index = entry as KeyedEventIndex
. address = index.find-live(key-low, key-high)
=? if !address || address.receiver-identity != receiver-identity
address.endpoint.close()

━━━━━━━━━━━━━━━━━━━━
+ do event-publish-keyed'Payload
    - owner Pointer
    - event-id Size
    - key-low U64
    - key-high U64
    - expected-generation U64
    - payload Payload

event-machine-publishing += 1
if event-machine-is-draining
    . root = event-machine-hold(owner)
    . dispatch Doer = => do
        event-dispatch-keyed(owner, event-id, key-low, key-high, expected-generation, payload)
            • handlers false
        event-machine-release(root)
    event-machine-defer(dispatch)
    event-dispatch-keyed(owner, event-id, key-low, key-high, expected-generation, payload)
        • machines false
else
    event-dispatch-keyed(owner, event-id, key-low, key-high, expected-generation, payload)
event-machine-finish-publish()

