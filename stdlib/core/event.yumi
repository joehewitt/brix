━━━━━━━━━━━━━━━━━━━━
_ KeyedEventIndex is EventEntry

_ addresses [KeyedEventAddress]
_ buckets [KeyedEventAddress?]
_ bucket-entry-count Size
_ live-address-count Size
_ next-address-generation U64

────────────────────
_ This
    - event-id

────────────────────
_ do allocate-generation U64

next-address-generation += 1
?! Panic("Event address generation overflow")
    if !next-address-generation
= next-address-generation

────────────────────
_ do find-live KeyedEventAddress?
    - key-low U64
    - key-high U64

=? if !buckets
. capacity = buckets.length
. slot = keyed-event-bucket(key-low, key-high, capacity)
for attempt in 0 .. < capacity
    . address = buckets[slot]
    =? if !address
    if address.live && address.key-low == key-low && address.key-high == key-high
        = address
    slot = (slot + 1) % capacity

────────────────────
_ do prepare-bucket-insert

if !buckets
    rebuild-buckets(256)
else if (bucket-entry-count + 1) * 4 >= buckets.length * 3
    . capacity = buckets.length
    if (live-address-count + 1) * 4 >= capacity * 3
        capacity *= 2
    rebuild-buckets(capacity)

────────────────────
_ do insert-bucket
    - address KeyedEventAddress

. capacity = buckets.length
. slot = keyed-event-bucket(address.key-low, address.key-high, capacity)
for attempt in 0 .. < capacity
    if !buckets[slot]
        buckets[slot] = address
        bucket-entry-count += 1
        =
    slot = (slot + 1) % capacity
?! Panic("Keyed event index is full")

────────────────────
_ do rebuild-buckets
    - capacity Size

. next [KeyedEventAddress?]
next.reserve(capacity)
for index in 0 .. < capacity
    next += null
buckets = next
bucket-entry-count = 0
. live-addresses [KeyedEventAddress]
for address in addresses
    if address.live
        insert-bucket(address)
        live-addresses += address
addresses = live-addresses

────────────────────
_ do release
    - address KeyedEventAddress

=? if !address.live
address.live = false
address.generation = allocate-generation()
live-address-count -= 1
//event.key-index.updates ++

────────────────────
_ do close

=? if is-closed
is-closed = true
for address in addresses
    if address.live
        address.live = false
        address.generation = allocate-generation()
        address.endpoint.close()
addresses.clear()
if buckets
    buckets.clear()
live-count = 0
event-bubbling-adjust(event-id, -bubbling-live-count)
bubbling-live-count = 0
bucket-entry-count = 0
live-address-count = 0

