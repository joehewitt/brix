. endpoint = event-endpoint'Payload(owner, event-id)
if !endpoint.adapter-created
    endpoint.adapter-created = true
    //event.adapters.created ++
= endpoint

━━━━━━━━━━━━━━━━━━━━
+ do event-keyed-endpoint'Payload EventEndpoint'Payload ?! Error
    - owner Pointer
    - event-id Size
    - key-low U64
    - key-high U64
    - receiver-identity U64

. index = event-keyed-index(owner, event-id)
. existing = index.find-live(key-low, key-high)
if existing
    ?! Error("Duplicate keyed event receiver for $key-low:$key-high")
        if existing.receiver-identity != receiver-identity
    = existing.endpoint as EventEndpoint'Payload

. generation = index.allocate-generation()
. endpoint = EventEndpoint'Payload(event-id)
. address =
    KeyedEventAddress(key-low, key-high, receiver-identity, generation, endpoint, index)
index.prepare-bucket-insert()
index.addresses += address
index.insert-bucket(address)
index.live-address-count += 1
endpoint.bind-keyed-address(address, generation)
//event.key-index.updates ++
//event.endpoint.entries ++
= endpoint

