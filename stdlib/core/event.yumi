+ do event-endpoint'Payload EventEndpoint'Payload
    - owner Pointer
    - event-id Size

. sidecar = event-sidecar(owner)
?! Panic("Illegal to access a closed event")
    if sidecar.is-closed
. existing = sidecar.find(event-id)
if existing
    = existing as EventEndpoint'Payload

. endpoint = EventEndpoint'Payload(event-id)
sidecar.entries += endpoint
//event.endpoint.entries ++
= endpoint

