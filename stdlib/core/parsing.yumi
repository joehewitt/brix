━━━━━━━━━━━━━━━━━━━━
+ CaptureSpan'Token is Tuple

+ source Token[]
+ start Index
+ end Index

────────────────────
+ get length Size

end - start

────────────────────
+ get array Token[]

//stream-pattern.capture-materializations ++
//stream-pattern.capture-materializations.rollback-buffer ++
//stream-pattern.capture-materialization-tokens += length
source[start .. < end]

────────────────────
+ do this == other CaptureSpan'Token

if length != other.length
    = false

for i in 0 .. < length
    if source[start + i] != other.source[other.start + i]
        = false
= true

────────────────────
+ do this == other String

if Token == Byte
    =? false if length != other.size
    = C:memcmp(source.data + start, other as CPointer'Byte, length) == 0

if Token != Char || length != other.length
    = false

if other.size == length
    . bytes = other as CPointer'Byte
    for offset in 0 .. < length
        if ((source[start + offset] as Char) as U32) != (bytes[offset] as U32)
            = false
    = true

. index Index
for char in other
    if (source[start + index] as Char) != char
        = false
    index += 1
= true

────────────────────
+ do to String

//stream-pattern.capture-materializations ++
//stream-pattern.capture-materializations.string ++
//stream-pattern.capture-materializations.public-string ++
//stream-pattern.capture-materialization-tokens += length
= source.slice-string(start .. < end)

────────────────────
+ do to Int

=? (this as String) as Int if length == 0 || length > 18
. negative = (source[start] as U32) == ('-' as U32)
. index = if negative || (source[start] as U32) == ('+' as U32) then start + 1 else start
=? (this as String) as Int if index == end
. value = 0
for offset in index .. < end
    . digit = (source[offset] as U32) - ('0' as U32)
    =? (this as String) as Int if digit > 9
    value = value * 10 + (digit as Int)
= if negative then -value else value

────────────────────
+ do to Float

. index = start
. negative = index < end && (source[index] as U32) == ('-' as U32)
if negative || (index < end && (source[index] as U32) == ('+' as U32))
    index += 1
. mantissa = 0
. significant = 0
. digits = 0
. scale = 0
. fraction = false
while index < end && (source[index] as U32) != ('e' as U32) && (source[index] as U32) != ('E' as U32)
    . code = source[index] as U32
    if code == ('.' as U32) && !fraction
        fraction = true
    else
        . digit = code - ('0' as U32)
        =? (this as String) as Float if digit > 9
        if mantissa != 0 || digit != 0
            significant += 1
        =? (this as String) as Float if significant > 15
        mantissa = mantissa * 10 + (digit as Int)
        digits += 1
        if fraction
            scale -= 1
    index += 1
=? (this as String) as Float if digits == 0
if index < end
    index += 1
    . lowers = index < end && (source[index] as U32) == ('-' as U32)
    if lowers || (index < end && (source[index] as U32) == ('+' as U32))
        index += 1
    =? (this as String) as Float if index == end || end - index > 4
    . exponent = 0
    while index < end
        . digit = (source[index] as U32) - ('0' as U32)
        =? (this as String) as Float if digit > 9
        exponent = exponent * 10 + (digit as Int)
        index += 1
    scale += if lowers then -exponent else exponent
=? (this as String) as Float if scale < -22 || scale > 22
. power = 1.0
for _ in 0 .. < (if scale < 0 then -scale else scale)
    power *= 10.0
. value = if scale < 0 then (mantissa as Float) / power else (mantissa as Float) * power
= if negative then -value else value

────────────────────
+ do to Token[]

//stream-pattern.capture-materializations ++
//stream-pattern.capture-materializations.array ++
//stream-pattern.capture-materializations.public-array ++
//stream-pattern.capture-materialization-tokens += length
= source[start .. < end].copy()

