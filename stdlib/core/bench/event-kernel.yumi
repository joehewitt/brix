━━━━━━━━━━━━━━━━━━━━
+ do run-event-reified Size

initialize-event-benchmark-counters()
. source = EventBenchExternalSource()
. endpoint Broadcastable'Size = source.changed
. checksum Size = 0

for value on endpoint
    checksum += value

for index in 0 .. < 1000
    . escaped Broadcastable'Size = source.changed
    if escaped as Pointer == endpoint as Pointer
        checksum += 1

for value in 0 .. < 4000
    source.emit(value)
= checksum

━━━━━━━━━━━━━━━━━━━━
+ do run-event-machine-trigger Size

initialize-event-benchmark-counters()
. machine = EventBenchMachine()
. publish-count Size = 4096
for value in 0 .. < publish-count
    machine.emit(value)

. queued = Semaphore()
do new
    queued.post()
queued.wait()
= machine.activations

━━━━━━━━━━━━━━━━━━━━
+ EventBenchMachine

+ event tick Size
+ activations Size = 0

────────────────────
+ flow ~>

~> idle
~> fired on tick
    do
        activations += 1

────────────────────
+ do emit
    - value Size

tick <- value

━━━━━━━━━━━━━━━━━━━━
+ do run-event-bubble-path Size

initialize-event-benchmark-counters()
. depth Size = 32
. root = EventBenchRouteBox(0)
markup-mount-root(root, root)
root.bounds = Rect(0, 0, 16, 16)

. path [EventBenchRouteBox] = List'EventBenchRouteBox([root])
. cursor = root
for level in 1 .. depth
    . child = EventBenchRouteBox(level)
    child.bounds = Rect(0, 0, 16, 16)
    markup-append(cursor, child)
    path += child
    cursor = child

. mutation-child = Box()
mutation-child.bounds = Rect(24, 24, 1, 1)
markup-append(root, mutation-child)
root.mutation-child = mutation-child
root.markup-batch-queue.checkpoint()

. point = Point(1, 1)
. repeated-hit = root.hit-path(point)
for iteration in 0 .. < 128
    repeated-hit.publish-pointer(MouseUpEvent(point))

cursor.cancel-next = true
repeated-hit.publish-pointer(MouseUpEvent(point))

path[depth / 2].cancel-next = true
repeated-hit.publish-pointer(MouseUpEvent(point))

cursor.nest-next = true
repeated-hit.publish-pointer(MouseUpEvent(point))

cursor.mutate-root = root
cursor.mutate-next = true
repeated-hit.publish-pointer(MouseUpEvent(point))

. uninterested-root = EventBenchPlainRoot()
. uninterested-child = Box()
markup-mount-root(uninterested-root, uninterested-root)
uninterested-root.bounds = Rect(0, 0, 16, 16)
uninterested-child.bounds = Rect(0, 0, 16, 16)
markup-append(uninterested-root, uninterested-child)
uninterested-root.publish-pointer(MouseUpEvent(point))

. checksum Size = 0
for box in path
    checksum += box.checksum
= checksum + root.mutations

━━━━━━━━━━━━━━━━━━━━
+ EventBenchRouteBox is Box
    is MarkupRootElement

+ level Size
+ checksum Size = 0
+ cancel-next = false
+ nest-next = false
+ mutate-next = false
+ mutate-root EventBenchRouteBox?
+ mutation-child Box?
+ mutations Size = 0
+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────
+ This
    - level

╌╌╌╌╌╌╌╌╌╌ is MarkupRootElement ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

────────────────────
for event on mouse-up

checksum += level + 1
if cancel-next
    cancel-next = false
    event.cancel()
if nest-next
    nest-next = false
    publish-pointer(MouseUpEvent(event.point))
if mutate-next
    mutate-next = false
    mutate-root?.remove-mutation-child()

────────────────────
+ do remove-mutation-child

if mutation-child
    markup-remove(this, mutation-child)
    mutation-child = null
    mutations += 1

