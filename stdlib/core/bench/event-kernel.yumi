━━━━━━━━━━━━━━━━━━━━
+ do run-event-keyed-100k Size

initialize-event-benchmark-counters()
. entity-count Size = 100000
. source = EventBenchKeyedSource()
. entities [EventBenchKeyedEntity?]
entities[entity-count - 1] = null

. multi-key = EventBenchKey(0, 1)
entities[0] = EventBenchKeyedEntity(source, multi-key, true)
. machine-key = EventBenchKey(1, 1)
. machine = EventBenchKeyedMachineEntity(source, machine-key)
. reified-key = EventBenchKey(2, 1)
entities[2] = EventBenchKeyedEntity(source, reified-key)

for index in 3 .. < entity-count
    . key = EventBenchKey(index, 1)
    entities[index] = EventBenchKeyedEntity(source, key)

. checksum = entities.length
. multi = entities[0]!
. reified = entities[2]!
. hot-a-key = EventBenchKey(97, 1)
. hot-a = entities[97]!
. hot-b-key = EventBenchKey(9973, 1)
. hot-b = entities[9973]!
. hot-c-key = EventBenchKey(99991, 1)
. hot-c = entities[99991]!
. adapter = reified.address()
for value on adapter
    reified.checksum += value * 7 + 1

. duplicate = catch EventBenchKeyedEntity(source, EventBenchKey(3, 1))
if duplicate is Error
    checksum += 1

. hit-count Size = 0
for index in 0 .. < 4000
    . lane = index % 3
    if lane == 0
        source.changed[hot-a-key] <- index
    else if lane == 1
        source.changed[hot-b-key] <- index
    else
        source.changed[hot-c-key] <- index
    hit-count += 1

for index in 0 .. < 2000
    source.changed[EventBenchKey(entity-count + index, 1)] <- index

. moving = entities[4]!
. old-moving-key = moving.key
. next-moving-key = EventBenchKey(entity-count + 4000, 1)
moving.change-key(next-moving-key)
source.changed[old-moving-key] <- 4001
source.changed[next-moving-key] <- 4002
hit-count += 1

. previous = entities[5]!
. stale-key = previous.key
previous.close()
. replacement-key = EventBenchKey(stale-key.index, stale-key.generation + 1)
. replacement = EventBenchKeyedEntity(source, replacement-key)
entities[5] = replacement
source.changed[stale-key] <- 5001
source.changed[replacement-key] <- 5002
hit-count += 1

source.changed[multi-key] <- 6001
source.changed[machine-key] <- 6002
source.changed[reified-key] <- 6003
hit-count += 3

. queued = Semaphore()
do new
    queued.post()
queued.wait()
if machine.flow is .active
    checksum += 1

checksum += hit-count
checksum += multi.checksum
checksum += reified.checksum
checksum += hot-a.checksum
checksum += hot-b.checksum
checksum += hot-c.checksum
checksum += moving.checksum
checksum += replacement.checksum
= checksum

━━━━━━━━━━━━━━━━━━━━
+ EventBenchKey is (index Index, generation U64)

━━━━━━━━━━━━━━━━━━━━
+ EventBenchKeyedSource

+ event changed Size keyed by EventBenchKey

━━━━━━━━━━━━━━━━━━━━
+ EventBenchKeyedEntity

+ source EventBenchKeyedSource
+ key EventBenchKey
_ checksum Size = 0

────────────────────
+ This
    - source
    - key
    - has-extra-subscription Bool = false

if has-extra-subscription
    for value on source.changed[key]
        checksum += value * 3 + 1

────────────────────
+ do address Broadcastable'Size

= source.changed[key]

────────────────────
+ do change-key ?! Error
    - next EventBenchKey

source.changed[key].rekey(next)
key = next

────────────────────
+ do close

────────────────────
for value on source.changed[key]

checksum += value + 1

━━━━━━━━━━━━━━━━━━━━
+ EventBenchKeyedMachineEntity

+ source EventBenchKeyedSource
+ address-key EventBenchKey

────────────────────
+ This
    - source
    - address-key

────────────────────
+ flow ~>

~> idle
~> active(value) for value on source.changed[address-key]

────────────────────
+ do close
