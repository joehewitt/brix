+ do run-event-descriptor-scale Size

initialize-event-benchmark-counters()
. owner0 = EventBenchBucket0()
. owner1 = EventBenchBucket1()
. owner2 = EventBenchBucket2()
. owner3 = EventBenchBucket3()
. owner4 = EventBenchBucket4()
. owner5 = EventBenchBucket5()
. owner6 = EventBenchBucket6()
. owner7 = EventBenchBucket7()
. owner8 = EventBenchBucket8()
. owner9 = EventBenchBucket9()
. owner10 = EventBenchBucket10()
. owner11 = EventBenchBucket11()
. owner12 = EventBenchBucket12()
. owner13 = EventBenchBucket13()
. owner14 = EventBenchBucket14()
. owner15 = EventBenchBucket15()

owner0.emit(0)
owner1.emit(1)
owner2.emit(2)
owner3.emit(3)
owner4.emit(4)
owner5.emit(5)
owner6.emit(6)
owner7.emit(7)
owner8.emit(8)
owner9.emit(9)
owner10.emit(10)
owner11.emit(11)
owner12.emit(12)
owner13.emit(13)
owner14.emit(14)
owner15.emit(15)

for value in 0 .. < 4096
    owner0.emit(value)

. checksum = owner0.checksum
checksum += owner1.checksum
checksum += owner2.checksum
checksum += owner3.checksum
checksum += owner4.checksum
checksum += owner5.checksum
checksum += owner6.checksum
checksum += owner7.checksum
checksum += owner8.checksum
checksum += owner9.checksum
checksum += owner10.checksum
checksum += owner11.checksum
checksum += owner12.checksum
checksum += owner13.checksum
checksum += owner14.checksum
checksum += owner15.checksum
= checksum

