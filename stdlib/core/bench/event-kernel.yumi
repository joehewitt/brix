━━━━━━━━━━━━━━━━━━━━
_ do run-event-focus-route-count Size
    - occurrence-count Size

initialize-event-benchmark-counters()
. depth Size = 32
. root = EventBenchFocusBox(0)
. cursor = root
for level in 1 .. depth
    . child = EventBenchFocusBox(level)
    markup-append(cursor, child)
    cursor = child

. event = KeyInputEvent('x')
for iteration in 0 .. < occurrence-count
    publish-focused-input(root, cursor, event)

. checksum Size = 0
. box EventBenchFocusBox? = cursor
while box
    checksum += box.checksum
    box = box.%parent as EventBenchFocusBox?
= checksum

━━━━━━━━━━━━━━━━━━━━
+ do run-event-no-focus-paste Size

initialize-event-benchmark-counters()
. root = EventBenchPasteFocusBox(0)
. cursor = root
for level in 1 .. 4
    . child = EventBenchPasteFocusBox(level)
    markup-append(cursor, child)
    cursor = child

. focused = root.descendant'Box • where each.is-focused
if focused
    publish-focused-input(root, focused, PasteEvent("ignored"))
= root.checksum

━━━━━━━━━━━━━━━━━━━━
+ do run-event-focus-interest-miss Size

initialize-event-benchmark-counters()
. root = EventBenchPlainRoot()
. branch = Box()
. target = Box()
. outside = EventBenchFocusBox(99)
markup-mount-root(root, root)
markup-append(root, branch)
markup-append(branch, target)
markup-append(root, outside)

publish-focused-input(root, target, KeyInputEvent('x'))
= outside.checksum

