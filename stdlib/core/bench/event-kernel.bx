(import /core)
(import /core/markup)
(import /tui/box)
(import /tui/events)
(import /tui/primitives)

(fn-do _ initialize-event-benchmark-counters _
  ; Keep the full Task 1 counter vocabulary visible even when a case does no work at a site.
  (probe-count event.publish.attempts 0)
  (probe-count event.publish.sites-erased 0)
  (probe-count event.publish.interest-misses 0)
  (probe-count event.payload.builds 0)
  (probe-count event.sidecars.created 0)
  (probe-count event.endpoint.entries 0)
  (probe-count event.subscriptions.sidecar 0)
  (probe-count event.subscriptions.lowered 0)
  (probe-count event.adapters.created 0)
  (probe-count event.handlers.sync 0)
  (probe-count event.handlers.machine-enqueued 0)
  (probe-count event.descriptor.visits 0)
  (probe-count event.route.frames 0)
  (probe-count event.key-index.updates 0)
)

(fn-do + run-event-unused-surface Size
  (call initialize-event-benchmark-counters)
  (let source (call EventBenchUnusedSource))
  (let checksum Size 0)
  (for (in value (..< 0 10000))
    (call (. source emit) value)
    (+= checksum value)
  )
  (return checksum)
)

(type + EventBenchUnusedSource
  (event + changed Size)
  (event + selected Size)
  (event + activated Size)
  (fn-do + emit _
    (param value Size)
    (<- changed (+ value 1))
  )
)

(fn-do + run-event-plain-self Size
  (call initialize-event-benchmark-counters)
  (let checksum Size 0)
  (for (in index (..< 0 2000))
    (let owner (call EventBenchSelfOwner))
    (call (. owner emit) index)
    (+= checksum (. owner checksum))
  )
  (return checksum)
)

(fn-do + run-event-descriptor-scale Size
  (call initialize-event-benchmark-counters)
  (let owner0 (call EventBenchBucket0))
  (let owner1 (call EventBenchBucket1))
  (let owner2 (call EventBenchBucket2))
  (let owner3 (call EventBenchBucket3))
  (let owner4 (call EventBenchBucket4))
  (let owner5 (call EventBenchBucket5))
  (let owner6 (call EventBenchBucket6))
  (let owner7 (call EventBenchBucket7))
  (let owner8 (call EventBenchBucket8))
  (let owner9 (call EventBenchBucket9))
  (let owner10 (call EventBenchBucket10))
  (let owner11 (call EventBenchBucket11))
  (let owner12 (call EventBenchBucket12))
  (let owner13 (call EventBenchBucket13))
  (let owner14 (call EventBenchBucket14))
  (let owner15 (call EventBenchBucket15))
  (blank)
  (call (. owner0 emit) 0)
  (call (. owner1 emit) 1)
  (call (. owner2 emit) 2)
  (call (. owner3 emit) 3)
  (call (. owner4 emit) 4)
  (call (. owner5 emit) 5)
  (call (. owner6 emit) 6)
  (call (. owner7 emit) 7)
  (call (. owner8 emit) 8)
  (call (. owner9 emit) 9)
  (call (. owner10 emit) 10)
  (call (. owner11 emit) 11)
  (call (. owner12 emit) 12)
  (call (. owner13 emit) 13)
  (call (. owner14 emit) 14)
  (call (. owner15 emit) 15)
  (blank)
  (for (in value (..< 0 4096))
    (call (. owner0 emit) value)
  )
  (blank)
  (let checksum (. owner0 checksum))
  (+= checksum (. owner1 checksum))
  (+= checksum (. owner2 checksum))
  (+= checksum (. owner3 checksum))
  (+= checksum (. owner4 checksum))
  (+= checksum (. owner5 checksum))
  (+= checksum (. owner6 checksum))
  (+= checksum (. owner7 checksum))
  (+= checksum (. owner8 checksum))
  (+= checksum (. owner9 checksum))
  (+= checksum (. owner10 checksum))
  (+= checksum (. owner11 checksum))
  (+= checksum (. owner12 checksum))
  (+= checksum (. owner13 checksum))
  (+= checksum (. owner14 checksum))
  (+= checksum (. owner15 checksum))
  (return checksum)
)

(type + EventBenchBucketOwner
  (event + changed Size)
  (prop + checksum Size (= 0))
  (fn-do + emit _
    (param value Size)
    (<- changed value)
  )
)

(type + EventBenchBucket0 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket1 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket2 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket3 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket4 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket5 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket6 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket7 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket8 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
