(type + EventBenchSelfOwner
  (event + first Size)
  (event + second Size)
  (prop + checksum Size (= 0))
  (subscribe-for (on value first)
    (+= checksum (* value 3))
  )
  (subscribe-for (on value second)
    (+= checksum (* value 5))
  )
  (fn-do + emit _
    (param value Size)
    (<- first value)
    (<- second (+ value 1))
  )
)

(fn-do + run-event-attach-churn Size
  (call initialize-event-benchmark-counters)
  (let source (call EventBenchExternalSource))
  (let checksum Size 0)
  (for (in index (..< 0 4000))
    (let observer (call EventBenchObserver source))
    (call (. source emit) index)
    (+= checksum (. observer checksum))
    (call (. observer close))
  )
  (return checksum)
)

(type + EventBenchExternalSource
  (event + changed Size)
  (fn-do + emit _
    (param value Size)
    (<- changed value)
  )
)

(type + EventBenchObserver
  (prop + source EventBenchExternalSource)
  (prop + checksum Size (= 0))
  (fn-do + This _
    (param source _)
  )
  (subscribe-for (on value (. source changed))
    (+= checksum (+ value 1))
  )
  (fn-do + close _)
)

(fn-do + run-event-reified Size
  (call initialize-event-benchmark-counters)
  (let source (call EventBenchExternalSource))
  (let endpoint (of Broadcastable Size) (. source changed))
  (let checksum Size 0)
  (blank)
  (for (on value endpoint)
    (+= checksum value)
  )
  (blank)
  (for (in index (..< 0 1000))
    (let escaped (of Broadcastable Size) (. source changed))
    (if (== (as escaped Pointer) (as endpoint Pointer))
      (+= checksum 1)
    )
  )
  (blank)
  (for (in value (..< 0 4000))
    (call (. source emit) value)
  )
  (return checksum)
)

(fn-do + run-event-machine-trigger Size
  (call initialize-event-benchmark-counters)
  (let machine (call EventBenchMachine))
  (let publish-count Size 4096)
  (for (in value (..< 0 publish-count))
    (call (. machine emit) value)
  )
  (blank)
  (let queued (call Semaphore))
  (do-new
    (call (. queued post))
  )
  (call (. queued wait))
  (return (. machine activations))
)

(type + EventBenchMachine
  (event + tick Size)
  (prop + activations Size (= 0))
  (prop + flow _
    (machine
      (state idle)
      (state fired (trigger on tick)
        (+= activations 1)
      )
    )
  )
  (fn-do + emit _
    (param value Size)
    (<- tick value)
  )
)

(fn-do + run-event-bubble-path Size
  (call initialize-event-benchmark-counters)
  (let depth Size 32)
  (let root (call EventBenchRouteBox 0))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 16 16))
  (blank)
  (let path (list EventBenchRouteBox) (call (of List EventBenchRouteBox) (list root)))
  (let cursor root)
  (for (in level (.. 1 depth))
    (let child (call EventBenchRouteBox level))
    (= (. child bounds) (call Rect 0 0 16 16))
    (call markup-append cursor child)
    (+= path child)
    (= cursor child)
  )
  (blank)
  (let mutation-child (call Box))
  (= (. mutation-child bounds) (call Rect 24 24 1 1))
  (call markup-append root mutation-child)
  (= (. root mutation-child) mutation-child)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let point (call Point 1 1))
  (let repeated-hit (call (. root hit-path) point))
  (for (in iteration (..< 0 128))
    (call (. repeated-hit publish-pointer) (call MouseUpEvent point))
  )
  (blank)
  (= (. cursor cancel-next) true)
  (call (. repeated-hit publish-pointer) (call MouseUpEvent point))
  (blank)
  (= (. ([] path (/ depth 2)) cancel-next) true)
  (call (. repeated-hit publish-pointer) (call MouseUpEvent point))
  (blank)
  (= (. cursor nest-next) true)
  (call (. repeated-hit publish-pointer) (call MouseUpEvent point))
  (blank)
  (= (. cursor mutate-root) root)
  (= (. cursor mutate-next) true)
  (call (. repeated-hit publish-pointer) (call MouseUpEvent point))
  (blank)
  (let uninterested-root (call EventBenchPlainRoot))
  (let uninterested-child (call Box))
  (call markup-mount-root uninterested-root uninterested-root)
  (= (. uninterested-root bounds) (call Rect 0 0 16 16))
  (= (. uninterested-child bounds) (call Rect 0 0 16 16))
  (call markup-append uninterested-root uninterested-child)
  (call (. uninterested-root publish-pointer) (call MouseUpEvent point))
  (blank)
  (let checksum Size 0)
  (for (in box path)
    (+= checksum (. box checksum))
  )
  (return (+ checksum (. root mutations)))
)

(type + EventBenchRouteBox (is Box)
  (implements MarkupRootElement)
  (prop + level Size)
  (prop + checksum Size (= 0))
  (prop + cancel-next _ (= false))
  (prop + nest-next _ (= false))
  (prop + mutate-next _ (= false))
  (prop + mutate-root (? EventBenchRouteBox))
  (prop + mutation-child (? Box))
  (prop + mutations Size (= 0))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + This _
    (param level _)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (subscribe-for (on event mouse-up)
    (+= checksum (+ level 1))
    (if cancel-next
      (= cancel-next false)
      (call (. event cancel))
    )
    (if nest-next
      (= nest-next false)
      (call publish-pointer (call MouseUpEvent (. event point)))
    )
    (if mutate-next
      (= mutate-next false)
      (call (?. mutate-root remove-mutation-child))
    )
  )
  (fn-do + remove-mutation-child _
    (if mutation-child
      (call markup-remove this mutation-child)
      (= mutation-child null)
      (+= mutations 1)
    )
  )
)

(type + EventBenchPlainRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(fn-do + run-event-focus-route Size
  (return (call run-event-focus-route-count 128))
)

(fn-do + run-event-focus-route-repeated Size
  (return (call run-event-focus-route-count 4096))
)

(fn-do _ run-event-focus-route-count Size
  (param occurrence-count Size)
  (call initialize-event-benchmark-counters)
  (let depth Size 32)
  (let root (call EventBenchFocusBox 0))
  (let cursor root)
  (for (in level (.. 1 depth))
    (let child (call EventBenchFocusBox level))
    (call markup-append cursor child)
    (= cursor child)
  )
  (blank)
  (let event (call KeyInputEvent 'x'))
  (for (in iteration (..< 0 occurrence-count))
    (call publish-focused-input root cursor event)
  )
  (blank)
  (let checksum Size 0)
  (let box (? EventBenchFocusBox) cursor)
  (while box
    (+= checksum (. box checksum))
    (= box (as (. box %parent) (? EventBenchFocusBox)))
  )
  (return checksum)
)

(fn-do + run-event-no-focus-paste Size
  (call initialize-event-benchmark-counters)
  (let root (call EventBenchPasteFocusBox 0))
  (let cursor root)
  (for (in level (.. 1 4))
    (let child (call EventBenchPasteFocusBox level))
    (call markup-append cursor child)
    (= cursor child)
  )
  (blank)
  (let focused (call (of (. root descendant) Box) (:where (. each is-focused))))
  (if focused
    (call publish-focused-input root focused (call PasteEvent "ignored"))
  )
  (return (. root checksum))
)

(fn-do + run-event-focus-interest-miss Size
  (call initialize-event-benchmark-counters)
  (let root (call EventBenchPlainRoot))
  (let branch (call Box))
  (let target (call Box))
  (let outside (call EventBenchFocusBox 99))
  (call markup-mount-root root root)
  (call markup-append root branch)
  (call markup-append branch target)
  (call markup-append root outside)
  (blank)
  (call publish-focused-input root target (call KeyInputEvent 'x'))
  (return (. outside checksum))
)

(type + EventBenchFocusBox (is Box)
  (prop + level Size)
  (prop + checksum Size (= 0))
  (fn-do + This _
    (param level _)
  )
  (subscribe-for (on event key-input)
    (+= checksum (+ level 1))
  )
)

(type + EventBenchPasteFocusBox (is EventBenchFocusBox)
  (subscribe-for (on event paste)
    (+= checksum (. event text length))
  )
)

(fn-do + run-event-keyed-100k Size
  (call initialize-event-benchmark-counters)
  (let entity-count Size 100000)
  (let source (call EventBenchKeyedSource))
  (let entities (list (? EventBenchKeyedEntity)))
  (call (. entities reserve) entity-count)
  (for (in index (..< 0 entity-count))
    (+= entities null)
  )
  (blank)
  (let multi-key (call EventBenchKey 0 1))
  (= ([] entities 0) (call EventBenchKeyedEntity source multi-key true))
  (let machine-key (call EventBenchKey 1 1))
  (let machine (call EventBenchKeyedMachineEntity source machine-key))
  (let reified-key (call EventBenchKey 2 1))
  (= ([] entities 2) (call EventBenchKeyedEntity source reified-key))
  (blank)
  (for (in index (..< 3 entity-count))
    (let key (call EventBenchKey index 1))
    (= ([] entities index) (call EventBenchKeyedEntity source key))
  )
  (blank)
  (let checksum (. entities length))
  (let multi (!! ([] entities 0)))
  (let reified (!! ([] entities 2)))
  (let hot-a-key (call EventBenchKey 97 1))
  (let hot-a (!! ([] entities 97)))
  (let hot-b-key (call EventBenchKey 9973 1))
  (let hot-b (!! ([] entities 9973)))
  (let hot-c-key (call EventBenchKey 99991 1))
  (let hot-c (!! ([] entities 99991)))
  (let adapter (call (. reified address)))
  (for (on value adapter)
    (+= (. reified checksum) (+ (* value 7) 1))
  )
  (blank)
  (let duplicate (catch (call EventBenchKeyedEntity source (call EventBenchKey 3 1))))
  (if (is duplicate Error)
    (+= checksum 1)
  )
  (blank)
  (let hit-count Size 0)
  (for (in index (..< 0 4000))
    (let lane (% index 3))
    (if (== lane 0)
      (<- ([] (. source changed) hot-a-key) index)
      (else-if (== lane 1)
        (<- ([] (. source changed) hot-b-key) index)
      )
      (else
        (<- ([] (. source changed) hot-c-key) index)
      )
    )
    (+= hit-count 1)
  )
  (blank)
  (for (in index (..< 0 2000))
    (<- ([] (. source changed) (call EventBenchKey (+ entity-count index) 1)) index)
  )
  (blank)
  (let moving (!! ([] entities 4)))
  (let old-moving-key (. moving key))
  (let next-moving-key (call EventBenchKey (+ entity-count 4000) 1))
  (call (. moving change-key) next-moving-key)
  (<- ([] (. source changed) old-moving-key) 4001)
  (<- ([] (. source changed) next-moving-key) 4002)
  (+= hit-count 1)
  (blank)
  (let previous (!! ([] entities 5)))
  (let stale-key (. previous key))
  (call (. previous close))
  (let replacement-key (call EventBenchKey (. stale-key index) (+ (. stale-key generation) 1)))
  (let replacement (call EventBenchKeyedEntity source replacement-key))
  (= ([] entities 5) replacement)
  (<- ([] (. source changed) stale-key) 5001)
  (<- ([] (. source changed) replacement-key) 5002)
  (+= hit-count 1)
  (blank)
  (<- ([] (. source changed) multi-key) 6001)
  (<- ([] (. source changed) machine-key) 6002)
  (<- ([] (. source changed) reified-key) 6003)
  (+= hit-count 3)
  (blank)
  (let queued (call Semaphore))
  (do-new
    (call (. queued post))
  )
  (call (. queued wait))
  (if (is (. machine flow) .active)
    (+= checksum 1)
  )
  (blank)
  (+= checksum hit-count)
  (+= checksum (. multi checksum))
  (+= checksum (. reified checksum))
  (+= checksum (. hot-a checksum))
  (+= checksum (. hot-b checksum))
  (+= checksum (. hot-c checksum))
  (+= checksum (. moving checksum))
  (+= checksum (. replacement checksum))
  (return checksum)
)

(type + EventBenchKey (is (tuple (: index Index) (: generation U64))))

(type + EventBenchKeyedSource
  (event + changed Size EventBenchKey)
)

(type + EventBenchKeyedEntity
  (prop + source EventBenchKeyedSource)
  (prop + key EventBenchKey)
  (prop _ checksum Size (= 0))
  (fn-do + This _
    (param source _)
    (param key _)
    (param has-extra-subscription Bool (= false))
    (if has-extra-subscription
      (for (on value ([] (. source changed) key))
        (+= checksum (+ (* value 3) 1))
      )
    )
  )
  (fn-do + address (of Broadcastable Size)
    (return ([] (. source changed) key))
  )
  (fn-do + change-key _ (?! Error)
    (param next EventBenchKey)
    (call (. ([] (. source changed) key) rekey) next)
    (= key next)
  )
  (fn-do + close _)
  (subscribe-for (on value ([] (. source changed) key))
    (+= checksum (+ value 1))
  )
)

(type + EventBenchKeyedMachineEntity
  (prop + source EventBenchKeyedSource)
  (prop + address-key EventBenchKey)
  (fn-do + This _
    (param source _)
    (param address-key _)
  )
  (prop + flow _
    (machine
      (state idle)
      (state (call active value) (trigger for value ([] (. source changed) address-key)))
    )
  )
  (fn-do + close _)
)
