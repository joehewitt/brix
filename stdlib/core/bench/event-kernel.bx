(type + EventBenchBucket11 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket12 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket13 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket14 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
)

(type + EventBenchBucket15 (is EventBenchBucketOwner)
  (subscribe-for (on value changed)
    (+= checksum (+ value 1))
  )
