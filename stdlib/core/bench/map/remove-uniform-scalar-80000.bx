; benchmark.meta description: Repeated scalar Map deletion and reinsertion at 80,000 entries.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core)
(blank)

(main
  (let count (as 80000 Size))
  (let checksum 0u64)
  (for (in repetition (..< 0 5))
    (let map (call (of Map U64 U64)))
    (for (in index (..< 0 count))
      (= ([] map (as index U64)) (as index U64))
    )
    (for (in index (..< 0 count))
      (-= ([] map (as index U64)))
    )
    (+= checksum (as (. map length) U64))
  )
  (blank)
  (print (str "bench-result map/remove-uniform-scalar-80000 checksum=" checksum))
)
