; benchmark.meta description: Mixed Map put/get/remove/churn across 16, 1,024, 80,000, and 1,000,000 scalar entries.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core)
(blank)

(main
  (let checksum (call exercise 16 2000))
  (+= checksum (call exercise 1024 80))
  (+= checksum (call exercise 80000 2))
  (+= checksum (call exercise 1000000 1))
  (blank)
  (print (str "bench-result map/mixed-uniform-scalar-matrix checksum=" checksum))
)

(fn-do _ exercise U64
  (param count Size)
  (param repetitions Size)
  (let checksum 0u64)
  (for (in repetition (..< 0 repetitions))
    (let map (call (of Map U64 U64)))
    (for (in index (..< 0 count))
      (= ([] map (as index U64)) (as (+ index repetition) U64))
    )
    (for (in index (..< 0 count))
      (+= checksum (!! ([] map (as index U64))))
    )
    (for (in index (..< 0 count (by: 2)))
      (-= ([] map (as index U64)))
    )
    (for (in index (..< 0 count (by: 2)))
      (= ([] map (as index U64)) (as (+ index repetition 1) U64))
    )
    (+= checksum (as (. map length) U64))
  )
  (return checksum)
)
