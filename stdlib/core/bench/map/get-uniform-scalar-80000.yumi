`benchmark.meta description: Repeated successful scalar Map lookup at 80,000 entries.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core

. count = 80000 as Size
. map = Map'U64'U64()
for index in 0 .. < count
    map[index as U64] = index as U64

. checksum = 0u64
for repetition in 0 .. < 20
    for index in 0 .. < count
        checksum += map[index as U64]!

-- "bench-result map/get-uniform-scalar-80000 checksum=$checksum"
