`benchmark.meta description: Mixed Map put/get/remove/churn across 16, 1,024, 80,000, and 1,000,000 scalar entries.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core

. checksum = exercise(16, 2000)
checksum += exercise(1024, 80)
checksum += exercise(80000, 2)
checksum += exercise(1000000, 1)

-- "bench-result map/mixed-uniform-scalar-matrix checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do exercise U64
    - count Size
    - repetitions Size

. checksum = 0u64
for repetition in 0 .. < repetitions
    . map = Map'U64'U64()
    for index in 0 .. < count
        map[index as U64] = (index + repetition) as U64
    for index in 0 .. < count
        checksum += map[index as U64]!
    for index in 0 .. < count by 2
        -= map[index as U64]
    for index in 0 .. < count by 2
        map[index as U64] = (index + repetition + 1) as U64
    checksum += map.length as U64
= checksum
