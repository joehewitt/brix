; benchmark.meta description: Repeated successful scalar Map lookup at 80,000 entries.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core)
(blank)

(main
  (let count (as 80000 Size))
  (let map (call (of Map U64 U64)))
  (for (in index (..< 0 count))
    (= ([] map (as index U64)) (as index U64))
  )
  (blank)
  (let checksum 0u64)
  (for (in repetition (..< 0 20))
    (for (in index (..< 0 count))
      (+= checksum (!! ([] map (as index U64))))
    )
  )
  (blank)
  (print (str "bench-result map/get-uniform-scalar-80000 checksum=" checksum))
)
