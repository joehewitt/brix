; benchmark.meta description: Repeated reserved scalar Map insertion at 80,000 entries.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing,allocator
(blank)
(import /core)
(blank)

(main
  (let count (as 80000 Size))
  (let checksum 0u64)
  (for (in repetition (..< 0 5))
    (let map (call (of Map U64 U64) count))
    (for (in index (..< 0 count))
      (= ([] map (as index U64)) (as (+ index repetition) U64))
    )
    (+= checksum (+ (as (. map length) U64) (!! ([] map (as (- count 1) U64)))))
  )
  (blank)
  (print (str "bench-result map/put-uniform-scalar-80000-reserved checksum=" checksum))
)
