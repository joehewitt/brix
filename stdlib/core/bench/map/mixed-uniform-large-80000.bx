; benchmark.meta description: Mixed Map operations over 64-byte values at 80,000 entries.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core)
(blank)

(main
  (let count (as 80000 Size))
  (let map (call (of Map U64 WideValue)))
  (for (in index (..< 0 count))
    (let value (as index U64))
    (= ([] map value) (call WideValue value))
  )
  (blank)
  (let checksum 0u64)
  (for (in index (..< 0 count))
    (+= checksum (. (!! ([] map (as index U64))) a))
  )
  (for (in index (..< 0 count (by: 2)))
    (-= ([] map (as index U64)))
  )
  (+= checksum (as (. map length) U64))
  (blank)
  (print (str "bench-result map/mixed-uniform-large-80000 checksum=" checksum))
)

(type + WideValue (is Struct)
  (prop + a U64)
  (prop + b U64)
  (prop + c U64)
  (prop + d U64)
  (prop + e U64)
  (prop + f U64)
  (prop + g U64)
  (prop + h U64)
  (fn-do + This _
    (param value U64)
    (= a value)
    (= b (+ value 1))
    (= c (+ value 2))
    (= d (+ value 3))
    (= e (+ value 4))
    (= f (+ value 5))
    (= g (+ value 6))
    (= h (+ value 7))
  )
)
