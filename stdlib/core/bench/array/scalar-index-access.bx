; benchmark.meta description: Reads and writes canonical scalar Arrays across eligible widths with a noncanonical control.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/array)
(blank)

(main
  (let item-count (as 8192 Size))
  (let pass-count (as 512 Size))
  (let checksum (as 0 Size))
  (blank)
  (let bools (call (of Array Bool) item-count (:with (== (% each 2) 0))))
  (let u8s (call (of Array U8) item-count (:with (as (% each 251) U8))))
  (let u16s (call (of Array U16) item-count (:with (as (% each 65521) U16))))
  (let u32s (call (of Array U32) item-count (:with (as each U32))))
  (let u64s (call (of Array U64) item-count (:with (as each U64))))
  (let f64s (call (of Array F64) item-count (:with (as (% each 997) F64))))
  (let fallback (call ScalarArrayFallback u64s))
  (blank)
  (+= checksum (call read-bools bools pass-count))
  (+= checksum (call read-u8s u8s pass-count))
  (+= checksum (call read-u16s u16s pass-count))
  (+= checksum (call read-u32s u32s pass-count))
  (+= checksum (call read-u64s u64s pass-count))
  (+= checksum (call read-f64s f64s pass-count))
  (+= checksum (call write-bools bools pass-count))
  (+= checksum (call write-u8s u8s pass-count))
  (+= checksum (call write-u16s u16s pass-count))
  (+= checksum (call write-u32s u32s pass-count))
  (+= checksum (call write-u64s u64s pass-count))
  (+= checksum (call write-f64s f64s pass-count))
  (+= checksum (call read-fallback fallback (/ pass-count 8)))
  (+= checksum (call write-fallback fallback (/ pass-count 8)))
  (blank)
  (print (str "bench-result array/scalar-index-access checksum=" checksum))
)

(fn-do _ read-bools Size
  (param values (of Array Bool))
  (param passes Size)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (+= checksum (if-expr ([] values index) 1 0))
    )
  )
  (return checksum)
)

(fn-do _ read-u8s Size
  (param values (of Array U8))
  (param passes Size)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (+= checksum (as ([] values index) Size))
    )
  )
  (return checksum)
)

(fn-do _ read-u16s Size
  (param values (of Array U16))
  (param passes Size)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (+= checksum (as ([] values index) Size))
    )
  )
  (return checksum)
)

(fn-do _ read-u32s Size
  (param values (of Array U32))
  (param passes Size)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (+= checksum (as ([] values index) Size))
    )
  )
  (return checksum)
)

(fn-do _ read-u64s Size
  (param values (of Array U64))
  (param passes Size)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (+= checksum (as ([] values index) Size))
    )
  )
  (return checksum)
)

(fn-do _ read-f64s Size
  (param values (of Array F64))
  (param passes Size)
  (let checksum 0.0)
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (+= checksum ([] values index))
    )
  )
  (return (as checksum Size))
)

(fn-do _ write-bools Size
  (param values (of Array Bool))
  (param passes Size)
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (= ([] values index) (== (% (+ index pass) 2) 0))
    )
  )
  (return (+ (if-expr ([] values 0) 1 0) (if-expr ([] values (- (. values length) 1)) 1 0)))
)

(fn-do _ write-u8s Size
  (param values (of Array U8))
  (param passes Size)
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (= ([] values index) (as (% (+ index pass) 251) U8))
    )
  )
  (return (+ (as ([] values 0) Size) (as ([] values (- (. values length) 1)) Size)))
)

(fn-do _ write-u16s Size
  (param values (of Array U16))
  (param passes Size)
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (= ([] values index) (as (% (+ index pass) 65521) U16))
    )
  )
  (return (+ (as ([] values 0) Size) (as ([] values (- (. values length) 1)) Size)))
)

(fn-do _ write-u32s Size
  (param values (of Array U32))
  (param passes Size)
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (= ([] values index) (as (+ index pass) U32))
    )
  )
  (return (+ (as ([] values 0) Size) (as ([] values (- (. values length) 1)) Size)))
)

(fn-do _ write-u64s Size
  (param values (of Array U64))
  (param passes Size)
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (= ([] values index) (as (+ index pass) U64))
    )
  )
  (return (+ (as ([] values 0) Size) (as ([] values (- (. values length) 1)) Size)))
)

(fn-do _ write-f64s Size
  (param values (of Array F64))
  (param passes Size)
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (= ([] values index) (as (% (+ index pass) 997) F64))
    )
  )
  (return (as (+ ([] values 0) ([] values (- (. values length) 1))) Size))
)

(fn-do _ read-fallback Size
  (param values ScalarArrayFallback)
  (param passes Size)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (+= checksum (as ([] values index) Size))
    )
  )
  (return checksum)
)

(fn-do _ write-fallback Size
  (param values ScalarArrayFallback)
  (param passes Size)
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (= ([] values index) (as (+ index pass) U64))
    )
  )
  (return (+ (as ([] values 0) Size) (as ([] values (- (. values length) 1)) Size)))
)

(type _ ScalarArrayFallback
  (prop _ values (of Array U64))
  (fn-do + This _
    (param values _)
  )
  (fn-expr + length _ :get
    (. values length)
  )
  (fn-expr + (index-get this (param index Index)) _
    ([] (. values data) index)
  )
  (fn-do + (index-set this (param index Index) (param value U64)) _
    (= ([] (. values data) index) value)
  )
)
