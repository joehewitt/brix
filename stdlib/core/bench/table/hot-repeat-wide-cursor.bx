; benchmark.meta description: Repeatedly reads two hot fields in a wide Table-backed particle set with for-row cursor syntax.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/table)
(blank)

(main
  (let row-count (as 65536 Size))
  (let pass-count (as 2048 Size))
  (let particles (call (of Table Particle) row-count (:with (call particle-for-index each))))
  (blank)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 pass-count))
    (let pass-bias (+ (as pass Size) 1))
    (for (in row particles)
      (let hot-sum (+ (. row x) (. row x) (. row y) (. row y) (. row x)))
      (+= checksum (+ hot-sum pass-bias))
    )
  )
  (blank)
  (print (str "bench-result table/hot-repeat-wide-cursor checksum=" checksum))
)

(type + Particle (is Struct)
  (prop + id Size)
  (prop + cold-a0 Size)
  (prop + cold-a1 Size)
  (prop + cold-a2 Size)
  (prop + cold-a3 Size)
  (prop + cold-a4 Size)
  (prop + cold-a5 Size)
  (prop + cold-a6 Size)
  (prop + cold-a7 Size)
  (prop + x Size)
  (prop + cold-b0 Size)
  (prop + cold-b1 Size)
  (prop + cold-b2 Size)
  (prop + cold-b3 Size)
  (prop + cold-b4 Size)
  (prop + cold-b5 Size)
  (prop + cold-b6 Size)
  (prop + cold-b7 Size)
  (prop + cold-b8 Size)
  (prop + cold-b9 Size)
  (prop + cold-b10 Size)
  (prop + cold-b11 Size)
  (prop + cold-b12 Size)
  (prop + cold-b13 Size)
  (prop + cold-b14 Size)
  (prop + cold-b15 Size)
  (prop + y Size)
  (prop + cold-c0 Size)
  (prop + cold-c1 Size)
  (prop + cold-c2 Size)
  (prop + cold-c3 Size)
  (prop + cold-c4 Size)
  (prop + cold-c5 Size)
  (prop + cold-c6 Size)
  (prop + cold-c7 Size)
)

(fn-expr _ particle-for-index _
  (param index Index)
  (call Particle
    (block
      (arg index-size)
      (arg (+ index-size 101))
      (arg (+ index-size 103))
      (arg (+ index-size 107))
      (arg (+ index-size 109))
      (arg (+ index-size 113))
      (arg (+ index-size 127))
      (arg (+ index-size 131))
      (arg (+ index-size 137))
      (arg (+ index-size 3))
      (arg (+ index-size 139))
      (arg (+ index-size 149))
      (arg (+ index-size 151))
      (arg (+ index-size 157))
      (arg (+ index-size 163))
      (arg (+ index-size 167))
      (arg (+ index-size 173))
      (arg (+ index-size 179))
      (arg (+ index-size 181))
      (arg (+ index-size 191))
      (arg (+ index-size 193))
      (arg (+ index-size 197))
      (arg (+ index-size 199))
      (arg (+ index-size 211))
      (arg (+ index-size 223))
      (arg (+ index-size 227))
      (arg (+ index-size 7))
      (arg (+ index-size 229))
      (arg (+ index-size 233))
      (arg (+ index-size 239))
      (arg (+ index-size 241))
      (arg (+ index-size 251))
      (arg (+ index-size 257))
      (arg (+ index-size 263))
      (arg (+ index-size 269))
    )
  )
  (where
    (lazy index-size (as index Size))
  )
)
