`benchmark.meta description: Sums hot fields in a wide Table-backed particle set with minimal arithmetic.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/table

. row-count = 65536 as Size
. pass-count = 2048 as Size
. particles = Table'Particle(row-count) • with particle-for-index(each)

. checksum = 0 as Size
for pass in 0 .. < pass-count
    . pass-bias = (pass as Size) + 1
    for index in 0 .. < particles.length
        . hot-sum = particles[index].id + particles[index].x + particles[index].y + particles[index].vx + particles[index].vy + particles[index].mass + particles[index].kind + particles[index].group
        checksum += hot-sum + pass-bias

-- "bench-result table/hot-sum-wide checksum=$checksum"

