`benchmark.meta description: Grows an Arena-backed Table once, then recycles capacity with clear and mark/rewind.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

/core/arena
/core/table

. arena = use Arena(1048576)
. rows = Table'BenchRow(arena)
. checksum = 0u64

for round in 0 .. < 128
    rows.clear()
    for index in 0 .. < 2048
        rows.append(BenchRow(index as U64, (index * 3 + round) as U64))

    . phase = rows.mark
    for index in 2048 .. < 4096
        rows.append(BenchRow(index as U64, (index * 5 + round) as U64))

    for row in rows
        checksum += row.id + row.value

    rows.rewind(phase)
    for index in 2048 .. < 4096
        rows.append(BenchRow(index as U64, (index * 7 + round) as U64))

    checksum += rows[rows.length - 1].value

-- "bench-result table/grow-recycle checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ BenchRow is Struct

+ id U64
+ value U64
