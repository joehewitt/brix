`benchmark.meta description: Scans sparse Table union-row matches through bounded native dispatch.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/table

. row-count = 32768 as Size
. pass-count = 128 as Size
. rows = Table'Node(row-count) • with :: index =>
    match index % 6
        |= 0
            Node.tag0(index)
        |= 1
            Node.tag64(index)
        |= 2
            Node.tag133(index)
        |= 3
            Node.tag134(index)
        |= 4
            Node.tag65()
        ??
            Node.tag135()

. checksum = 0 as Size
for pass in 0 .. < pass-count
    for row in rows
        checksum += match row
            | .tag0(item)
                item.value + pass + 1
            | .tag4(item)
                item.value + pass + 5
            | .tag8(item)
                item.value + pass + 9
            | .tag12(item)
                item.value + pass + 13
            | .tag16(item)
                item.value + pass + 17
            | .tag20(item)
                item.value + pass + 21
            | .tag24(item)
                item.value + pass + 25
            | .tag28(item)
                item.value + pass + 29
            | .tag32(item)
                item.value + pass + 33
            | .tag36(item)
                item.value + pass + 37
            | .tag40(item)
                item.value + pass + 41
            | .tag44(item)
                item.value + pass + 45
            | .tag48(item)
                item.value + pass + 49
            | .tag52(item)
                item.value + pass + 53
            | .tag56(item)
                item.value + pass + 57
            | .tag60(item)
                item.value + pass + 61
            | .tag64(item)
                item.value + pass + 65
            | .tag68(item)
                item.value + pass + 69
            | .tag72(item)
                item.value + pass + 73
            | .tag76(item)
                item.value + pass + 77
            | .tag80(item)
                item.value + pass + 81
            | .tag84(item)
                item.value + pass + 85
            | .tag88(item)
                item.value + pass + 89
            | .tag92(item)
                item.value + pass + 93
            | .tag96(item)
                item.value + pass + 97
            | .tag100(item)
                item.value + pass + 101
            | .tag104(item)
                item.value + pass + 105
            | .tag108(item)
                item.value + pass + 109
            | .tag112(item)
                item.value + pass + 113
            | .tag116(item)
                item.value + pass + 117
            | .tag120(item)
                item.value + pass + 121
            | .tag124(item)
                item.value + pass + 125
            | .tag128(item)
                item.value + pass + 129
            | .tag132(item)
                item.value + pass + 133
            | .tag133(item)
                item.value + pass + 134
            | .tag134(item)
                item.value + pass + 135
            ??
                pass
        checksum += match row
            | .tag0(item)
                item.value
            | .tag4(item)
                item.value
            ??
                0

-- "bench-result table/union-row-sparse-switch checksum=$checksum"

