`benchmark.meta description: Scans inline-only Table union rows through tag-aware narrowing.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/table

. row-count = 32768 as Size
. pass-count = 256 as Size
. rows = Table'Value(row-count) • with :: index => do
    if index % 2 == 0
        = Value.even(index, index * 3 + 1)
    = Value.odd(index, index * 5 + 2)

. checksum = 0 as Size
for pass in 0 .. < pass-count
    for row in rows
        checksum += match row
            | .even(even)
                even.value + pass
            | .odd(odd)
                odd.value + pass

-- "bench-result table/union-row-basic checksum=$checksum"

