; benchmark.meta description: Scans an array-of-structs particle set whose hot fields are separated by cold fields.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/array)
(blank)

(main
  (let row-count (as 32768 Size))
  (let pass-count (as 2048 Size))
  (let particles (call (of Array Particle) row-count (:with (call particle-for-index each))))
  (blank)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 pass-count))
    (let pass-bias (+ (as pass Size) 1))
    (for (in index (..< 0 (. particles length)))
      (let score
        (scope (+ position-score velocity-score mass-score (. ([] particles index) kind))
          (lazy position-score (+ (* (. ([] particles index) x) 3) (* (. ([] particles index) y) 5)))
          (lazy velocity-score (+ (* (. ([] particles index) vx) 7) (* (. ([] particles index) vy) 11)))
          (lazy mass-score (* (. ([] particles index) mass) 13))
        )
      )
      (blank)
      (if (== (% (+ (. ([] particles index) group) pass-bias) 4) 0)
        (+= checksum (+ score (. ([] particles index) id) pass-bias))
        (else
          (+= checksum (+ (/ score (+ (% (. ([] particles index) group) 5) 1)) (. ([] particles index) kind)))
        )
      )
    )
  )
  (blank)
  (print (str "bench-result table/row-scan-scattered-array checksum=" checksum))
)

(type + Particle (is Struct)
  (prop + id Size)
  (prop + cold-a0 Size)
  (prop + cold-a1 Size)
  (prop + cold-a2 Size)
  (prop + cold-a3 Size)
  (prop + cold-a4 Size)
  (prop + cold-a5 Size)
  (prop + cold-a6 Size)
  (prop + x Size)
  (prop + cold-b0 Size)
  (prop + cold-b1 Size)
  (prop + cold-b2 Size)
  (prop + cold-b3 Size)
  (prop + cold-b4 Size)
  (prop + cold-b5 Size)
  (prop + cold-b6 Size)
  (prop + y Size)
  (prop + cold-c0 Size)
  (prop + cold-c1 Size)
  (prop + cold-c2 Size)
  (prop + cold-c3 Size)
  (prop + cold-c4 Size)
  (prop + cold-c5 Size)
  (prop + cold-c6 Size)
  (prop + vx Size)
  (prop + cold-d0 Size)
