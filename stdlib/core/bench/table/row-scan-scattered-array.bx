(fn-expr _ particle-for-index _
  (param index Index)
  (call Particle
    (block
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg (% (+ (* index-size 17) 3) 100003))
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg (% (+ (* index-size 31) 7) 100019))
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg index-size)
      (arg (% (+ (* index-size 13) 11) 9973))
      (arg index-size)
