  (prop + cold-e2 Size)
  (prop + cold-e3 Size)
  (prop + cold-e4 Size)
  (prop + cold-e5 Size)
  (prop + cold-e6 Size)
  (prop + mass Size)
  (prop + cold-f0 Size)
  (prop + cold-f1 Size)
  (prop + cold-f2 Size)
  (prop + cold-f3 Size)
  (prop + cold-f4 Size)
  (prop + cold-f5 Size)
  (prop + cold-f6 Size)
  (prop + kind Size)
  (prop + cold-g0 Size)
  (prop + cold-g1 Size)
  (prop + cold-g2 Size)
  (prop + cold-g3 Size)
  (prop + cold-g4 Size)
  (prop + cold-g5 Size)
  (prop + cold-g6 Size)
  (prop + group Size)
  (prop + cold-h0 Size)
