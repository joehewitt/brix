; benchmark.meta description: Scans a Table-backed particle set with for-row cursor syntax.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/table)
(blank)

(main
  (let row-count (as 32768 Size))
  (let pass-count (as 2048 Size))
  (let particles (call (of Table Particle) row-count (:with (call particle-for-index each))))
  (blank)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 pass-count))
    (let pass-bias (+ (as pass Size) 1))
    (for (in row particles)
      (let score
        (scope (+ position-score velocity-score (* (. row mass) 13) (. row kind))
          (lazy position-score (+ (* (. row x) 3) (* (. row y) 5)))
          (lazy velocity-score (+ (* (. row vx) 7) (* (. row vy) 11)))
        )
      )
      (blank)
      (if (== (% (+ (. row group) pass-bias) 4) 0)
        (+= checksum (+ score (. row id) pass-bias))
        (else
          (+= checksum (+ (/ score (+ (% (. row group) 5) 1)) (. row kind)))
        )
      )
    )
  )
  (blank)
  (print (str "bench-result table/row-scan-cursor checksum=" checksum))
)

(type + Particle (is Struct)
  (prop + id Size)
  (prop + x Size)
  (prop + y Size)
  (prop + vx Size)
  (prop + vy Size)
  (prop + mass Size)
  (prop + kind Size)
  (prop + group Size)
  (prop + cold-a Size)
  (prop + cold-b Size)
  (prop + cold-c Size)
  (prop + cold-d Size)
  (prop + cold-e Size)
  (prop + cold-f Size)
  (prop + cold-g Size)
  (prop + cold-h Size)
)

(fn-expr _ particle-for-index _
  (param index Index)
  (call Particle
    (block
      (arg index-size)
      (arg (% (+ (* index-size 17) 3) 100003))
      (arg (% (+ (* index-size 31) 7) 100019))
      (arg (% (+ (* index-size 13) 11) 9973))
      (arg (% (+ (* index-size 19) 5) 9967))
      (arg (+ (% index-size 23) 1))
      (arg (% (/ index-size 7) 19))
      (arg (% (/ index-size 11) 17))
      (arg (% (+ (* index-size 29) 101) 1009))
      (arg (% (+ (* index-size 37) 103) 1013))
      (arg (% (+ (* index-size 41) 107) 1019))
      (arg (% (+ (* index-size 43) 109) 1021))
      (arg (% (+ (* index-size 47) 113) 1031))
      (arg (% (+ (* index-size 53) 127) 1033))
      (arg (% (+ (* index-size 59) 131) 1039))
      (arg (% (+ (* index-size 61) 137) 1049))
    )
  )
  (where
    (lazy index-size (as index Size))
  )
)
