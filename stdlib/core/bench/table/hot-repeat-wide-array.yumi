`benchmark.meta description: Repeatedly reads two hot fields in a wide array-of-structs particle set.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/array

. row-count = 65536 as Size
. pass-count = 2048 as Size
. particles = Array'Particle(row-count) • with particle-for-index(each)

. checksum = 0 as Size
for pass in 0 .. < pass-count
    . pass-bias = (pass as Size) + 1
    for index in 0 .. < particles.length
        . hot-sum = doubled-x + particles[index].y + particles[index].y + particles[index].x
            .. doubled-x = particles[index].x + particles[index].x
        checksum += hot-sum + pass-bias

-- "bench-result table/hot-repeat-wide-array checksum=$checksum"

