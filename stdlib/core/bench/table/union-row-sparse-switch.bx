; benchmark.meta description: Scans sparse Table union-row matches through bounded native dispatch.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/table)
(blank)

(main
  (let row-count (as 32768 Size))
  (let pass-count (as 128 Size))
  (let rows
    (call (of Table Node) row-count
      (:with
        (=> (index)
          (block
            (match (% index 6)
              (case= 0
                (call (. Node tag0) index)
              )
              (case= 1
                (call (. Node tag64) index)
              )
              (case= 2
                (call (. Node tag133) index)
              )
              (case= 3
                (call (. Node tag134) index)
              )
              (case= 4
                (call (. Node tag65))
              )
              (default
                (call (. Node tag135))
              )
            )
          )
        )
      )
    )
  )
  (blank)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 pass-count))
    (for (in row rows)
      (+= checksum
        (match row
          (case (call .tag0 item)
            (+ (. item value) pass 1)
          )
          (case (call .tag4 item)
            (+ (. item value) pass 5)
          )
          (case (call .tag8 item)
            (+ (. item value) pass 9)
          )
          (case (call .tag12 item)
            (+ (. item value) pass 13)
          )
          (case (call .tag16 item)
            (+ (. item value) pass 17)
          )
          (case (call .tag20 item)
            (+ (. item value) pass 21)
          )
          (case (call .tag24 item)
            (+ (. item value) pass 25)
          )
          (case (call .tag28 item)
            (+ (. item value) pass 29)
          )
          (case (call .tag32 item)
            (+ (. item value) pass 33)
          )
          (case (call .tag36 item)
            (+ (. item value) pass 37)
          )
          (case (call .tag40 item)
            (+ (. item value) pass 41)
          )
          (case (call .tag44 item)
            (+ (. item value) pass 45)
          )
          (case (call .tag48 item)
            (+ (. item value) pass 49)
          )
          (case (call .tag52 item)
            (+ (. item value) pass 53)
          )
          (case (call .tag56 item)
            (+ (. item value) pass 57)
          )
          (case (call .tag60 item)
            (+ (. item value) pass 61)
          )
          (case (call .tag64 item)
            (+ (. item value) pass 65)
          )
          (case (call .tag68 item)
            (+ (. item value) pass 69)
          )
          (case (call .tag72 item)
            (+ (. item value) pass 73)
          )
          (case (call .tag76 item)
            (+ (. item value) pass 77)
          )
          (case (call .tag80 item)
            (+ (. item value) pass 81)
          )
          (case (call .tag84 item)
            (+ (. item value) pass 85)
          )
          (case (call .tag88 item)
            (+ (. item value) pass 89)
          )
          (case (call .tag92 item)
            (+ (. item value) pass 93)
          )
          (case (call .tag96 item)
            (+ (. item value) pass 97)
          )
          (case (call .tag100 item)
            (+ (. item value) pass 101)
          )
          (case (call .tag104 item)
            (+ (. item value) pass 105)
          )
          (case (call .tag108 item)
            (+ (. item value) pass 109)
          )
          (case (call .tag112 item)
            (+ (. item value) pass 113)
          )
          (case (call .tag116 item)
            (+ (. item value) pass 117)
          )
          (case (call .tag120 item)
            (+ (. item value) pass 121)
          )
          (case (call .tag124 item)
            (+ (. item value) pass 125)
          )
          (case (call .tag128 item)
            (+ (. item value) pass 129)
          )
          (case (call .tag132 item)
            (+ (. item value) pass 133)
          )
          (case (call .tag133 item)
            (+ (. item value) pass 134)
          )
          (case (call .tag134 item)
            (+ (. item value) pass 135)
          )
          (default
            pass
          )
        )
      )
      (+= checksum
        (match row
          (case (call .tag0 item)
            (. item value)
          )
          (case (call .tag4 item)
            (. item value)
          )
          (default
            0
          )
        )
      )
    )
  )
  (blank)
  (print (str "bench-result table/union-row-sparse-switch checksum=" checksum))
)

(type + Item (is Tuple)
  (prop + value Size @hot)
)

(type + Empty (is Tuple))

(type + Node (is Union)
  (variant tag0 Item)
  (variant tag1 Empty)
