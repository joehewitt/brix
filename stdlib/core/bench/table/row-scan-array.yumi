`benchmark.meta description: Scans an array-of-structs particle set through the same row-oriented loop.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/array

. row-count = 32768 as Size
. pass-count = 2048 as Size
. particles = Array'Particle(row-count) • with particle-for-index(each)

. checksum = 0 as Size
for pass in 0 .. < pass-count
    . pass-bias = (pass as Size) + 1
    for index in 0 .. < particles.length
        . score = position-score + velocity-score + mass-score + particles[index].kind
            .. position-score = particles[index].x * 3 + particles[index].y * 5
            .. velocity-score = particles[index].vx * 7 + particles[index].vy * 11
            .. mass-score = particles[index].mass * 13

        if (particles[index].group + pass-bias) % 4 == 0
            checksum += score + particles[index].id + pass-bias
        else
            checksum += score / ((particles[index].group % 5) + 1) + particles[index].kind

-- "bench-result table/row-scan-array checksum=$checksum"

