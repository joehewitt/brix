; benchmark.meta description: Grows an Arena-backed Table once, then recycles capacity with clear and mark/rewind.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing,allocator
(blank)
(import /core/arena)
(import /core/table)
(blank)

(main
  (let arena (use (call Arena 1048576)))
  (let rows (call (of Table BenchRow) arena))
  (let checksum 0u64)
  (blank)
  (for (in round (..< 0 128))
    (call (. rows clear))
    (for (in index (..< 0 2048))
      (call (. rows append) (call BenchRow (as index U64) (as (+ (* index 3) round) U64)))
    )
    (blank)
    (let phase (. rows mark))
    (for (in index (..< 2048 4096))
      (call (. rows append) (call BenchRow (as index U64) (as (+ (* index 5) round) U64)))
    )
    (blank)
    (for (in row rows)
      (+= checksum (+ (. row id) (. row value)))
    )
    (blank)
    (call (. rows rewind) phase)
    (for (in index (..< 2048 4096))
      (call (. rows append) (call BenchRow (as index U64) (as (+ (* index 7) round) U64)))
    )
    (blank)
    (+= checksum (. ([] rows (- (. rows length) 1)) value))
  )
  (blank)
  (print (str "bench-result table/grow-recycle checksum=" checksum))
)

(type + BenchRow (is Struct)
  (prop + id U64)
  (prop + value U64)
)
