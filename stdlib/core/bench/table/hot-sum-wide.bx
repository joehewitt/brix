; benchmark.meta description: Sums hot fields in a wide Table-backed particle set with minimal arithmetic.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/table)
(blank)

(main
  (let row-count (as 65536 Size))
  (let pass-count (as 2048 Size))
  (let particles (call (of Table Particle) row-count (:with (call particle-for-index each))))
  (blank)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 pass-count))
    (let pass-bias (+ (as pass Size) 1))
    (for (in index (..< 0 (. particles length)))
      (let hot-sum (+ (. ([] particles index) id) (. ([] particles index) x) (. ([] particles index) y) (. ([] particles index) vx) (. ([] particles index) vy) (. ([] particles index) mass) (. ([] particles index) kind) (. ([] particles index) group)))
      (+= checksum (+ hot-sum pass-bias))
    )
  )
  (blank)
  (print (str "bench-result table/hot-sum-wide checksum=" checksum))
)

(type + Particle (is Struct)
  (prop + id Size)
  (prop + cold-a0 Size)
  (prop + cold-a1 Size)
  (prop + cold-a2 Size)
  (prop + cold-a3 Size)
  (prop + cold-a4 Size)
  (prop + cold-a5 Size)
  (prop + cold-a6 Size)
  (prop + x Size)
  (prop + cold-b0 Size)
  (prop + cold-b1 Size)
  (prop + cold-b2 Size)
  (prop + cold-b3 Size)
  (prop + cold-b4 Size)
  (prop + cold-b5 Size)
  (prop + cold-b6 Size)
  (prop + y Size)
  (prop + cold-c0 Size)
  (prop + cold-c1 Size)
  (prop + cold-c2 Size)
  (prop + cold-c3 Size)
