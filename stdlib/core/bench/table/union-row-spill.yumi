`benchmark.meta description: Scans Table union rows with inline and fixed-slot external payload fields.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/table

. row-count = 32768 as Size
. pass-count = 256 as Size
. rows = Table'Node(row-count) • with :: index => do
    if index % 2 == 0
        = Node.small(index, index * 3 + 1)
    = Node.wide
        - index
        - index * 5 + 2
        - index * 7 + 3
        - index * 11 + 4
        - index * 13 + 5

. checksum = 0 as Size
for pass in 0 .. < pass-count
    for row in rows
        checksum += match row
            | .small(small)
                small.value + pass
            | .wide(wide)
                wide.inline-a + wide.external-b + pass

-- "bench-result table/union-row-spill checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ Syntax is Tuple

+ id Size

━━━━━━━━━━━━━━━━━━━━
+ Small is Syntax

+ @hot value Size

━━━━━━━━━━━━━━━━━━━━
+ Wide is Syntax

+ @hot inline-a Size
+ @hot inline-b Size
+ external-a Size
+ external-b Size

━━━━━━━━━━━━━━━━━━━━
+ Node is Union

| small Small
| wide Wide
