`benchmark.meta description: Tokenizes ASCII text with grammars.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. tokens = match ascii-tokenizer-source()
    ~ \ascii-tokenizer-document
    ?! Panic("ascii-tokenizer did not parse")

. checksum = 0 as Size
for token in tokens
    checksum += token

-- "bench-result stream/ascii-tokenizer checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ ascii-tokenizer-document ~ Char

~ tokens \ascii-token+
    tokens

.. ascii-token Size ~
    ~ id \ascii-identifier
        id.length * 2
    ~ number \ascii-number
        number.length * 3
    ~ \ascii-space
        1
    ~ "(" | ")" | "{" | "}" | "[" | "]" | ";" | "," | "." | ":" | "+" | "-" | "*" | "/" | "="
        5

.. ascii-identifier String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*

.. ascii-number String ~
    ~ [0-9]+

.. ascii-space ~
    ~ (" " | "\n" | "\t")+

━━━━━━━━━━━━━━━━━━━━
_ ascii-tokenizer-source

"".join("fn alpha_$each(x${each % 9}, y${each % 13}) { value = x + y * ${each + 1}; }\n" in 0 .. < 220)
