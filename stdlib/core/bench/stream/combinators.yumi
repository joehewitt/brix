`benchmark.meta description: Runs composed stream pattern helpers.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. checksum = 0 as Size
for source in expressions()
    checksum += expression-score(source)

-- "bench-result stream/combinators checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do expression-score
    - source String

. terms = match source
    ~ \combinator-expr
    ?! Panic("expression did not parse")

. total = 0 as Size
. index = 1 as Size
for term in terms
    total += term.length * index
    index += 1

= total

━━━━━━━━━━━━━━━━━━━━
+ combinator-expr ~ Char

~ \expr

.. expr ~
    ~ \s items \delimited(~ \s ("+" | "-" | "*") \s, ~ \term) \s
        items

.. term ~
    ~ left \identifier "(" args \delimited(~ \s "," \s, ~ \argument) ")" "." mid \identifier "." right \identifier
        left ++ ":" ++ "$args.length" ++ "." ++ mid ++ "." ++ right
    ~ left \identifier "(" args \delimited(~ \s "," \s, ~ \argument) ")" "." suffix \identifier
        left ++ ":" ++ "$args.length" ++ "." ++ suffix
    ~ left \identifier "(" args \delimited(~ \s "," \s, ~ \argument) ")"
        left ++ ":" ++ "$args.length"
    ~ left \identifier "." mid \identifier "." right \identifier
        left ++ "." ++ mid ++ "." ++ right
    ~ left \identifier "." right \identifier
        left ++ "." ++ right
    ~ \identifier

.. argument ~
    ~ \number
    ~ \identifier
    ~ "\"" text (!"\"" .)* "\""
        text

.. identifier ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*

.. number ~
    ~ [0-9]+

.. s ~
    ~ (" " | "\n" | "\t")*

━━━━━━━━━━━━━━━━━━━━
_ do expressions

. expressions [String]
expressions += "alpha(1, beta, \"two\").tail + gamma_3 - delta(99)"
expressions += "root.child.leaf * parse(item_42, 7) + fold(left, right)"
expressions += "call(one,two,three).again.final - x + y + zed(12345)"

= expressions
