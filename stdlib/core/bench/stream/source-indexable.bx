; benchmark.meta description: Parses through an indexable stream source.
; benchmark.meta timing: recommended
; benchmark.meta profiles: stream,compile-timing
(blank)
(import /core/tokenstream)
(blank)

(main
  (let stream (call (of IndexableTokenStream Char) (call source-adapter-source)))
  (let rows
    (match stream
      (~ \source-adapter-document)
      (throw (call Panic "source-indexable did not parse"))
    )
  )
  (blank)
  (let checksum (as 0 Size))
  (for (in row rows)
    (+= checksum row)
  )
  (blank)
  (print (str "bench-result stream/source-indexable checksum=" checksum))
)

(fn-expr + source-adapter-document _ (over: Char)
  (~ (: rows (+ \source-adapter-row))
    rows
  )
  (where
    (lazy source-adapter-row Size
      (pattern
        (~ (seq "src:" (: name \source-adapter-word) ":" (: value \source-adapter-digits) "\n")
          (+ (* (. name length) 31) (. value length))
        )
      )
    )
    (blank)
    (lazy source-adapter-word String
      (pattern
        (~ (seq (chars "a-zA-Z_") (* (chars "a-zA-Z0-9_"))))
      )
    )
    (blank)
    (lazy source-adapter-digits String
      (pattern
        (~ (+ (chars "0-9")))
      )
    )
  )
)

(fn-expr _ source-adapter-source _
  (call (. "" join) (in (str "src:name_" each ":" (* each 43) "\n") (..< 0 180)))
)
