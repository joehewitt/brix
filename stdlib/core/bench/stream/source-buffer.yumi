`benchmark.meta description: Parses through a buffered stream source.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

/data/stream

. stream = DataStream'Char(source-buffer-source().codepoints)
. rows = match stream
    ~ \source-buffer-document
    ?! Panic("source-buffer did not parse")

. checksum = 0 as Size
for row in rows
    checksum += row

-- "bench-result stream/source-buffer checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ source-buffer-document ~ Char

~ rows \source-buffer-row+
    rows

.. source-buffer-row Size ~
    ~ "src:" name \source-buffer-word ":" value \source-buffer-digits "\n"
        name.length * 41 + value.length

.. source-buffer-word String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*

.. source-buffer-digits String ~
    ~ [0-9]+

━━━━━━━━━━━━━━━━━━━━
_ source-buffer-source

"".join("src:name_$each:${each * 53}\n" in 0 .. < 50)
