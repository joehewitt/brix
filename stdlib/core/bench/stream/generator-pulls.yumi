`benchmark.meta description: Pulls 1 MB of bytes one at a time from a generator source.
`benchmark.meta timing: recommended
`benchmark.meta profiles: allocator,compile-timing

/core/tokenstream

. stream = ChunkedTokenStream'Byte(generator-pulls-source(1048576))
. checksum = 0 as Size
while stream.has-more
    checksum += (<- stream)! as Size

-- "bench-result stream/generator-pulls checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do generator-pulls-source Generator'Byte
    - count Size

for index in 0 .. < count
    <= if index % 64 == 63 then 10u8 else (97 + index % 26) as U8
