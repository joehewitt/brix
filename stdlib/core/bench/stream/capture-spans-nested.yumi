`benchmark.meta description: Exercises nested stream captures and capture result construction.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. groups = match capture-spans-nested-source()
    ~ \capture-spans-nested-document
    ?! Panic("capture-spans-nested did not parse")

. checksum = 0 as Size
for group in groups
    checksum += group

-- "bench-result stream/capture-spans-nested checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ capture-spans-nested-document ~ Char

~ groups \capture-spans-group+
    groups

.. capture-spans-group Size ~
    ~ "group(" first \capture-word rest ("," item \capture-word)* ")" "\n"
        first.length * 13 + rest.length * 17 + item.length

.. capture-word String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*

━━━━━━━━━━━━━━━━━━━━
_ capture-spans-nested-source

"".join(capture-spans-group(each) in 0 .. < 90)

━━━━━━━━━━━━━━━━━━━━
_ capture-spans-group String
    - group Int

"group(root_$group$children)\n"

.. children = "".join(",child_${group}_$each" in 0 .. < 12)
