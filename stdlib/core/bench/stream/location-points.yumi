`benchmark.meta description: Tracks source locations through stream matches.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. points = match location-points-source()
    ~ \location-points-document
    ?! Panic("location-points did not parse")

. checksum = 0 as Size
for point in points
    checksum += point

-- "bench-result stream/location-points checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ location-points-document ~ Char

~ points \location-point+
    points

.. location-point Size ~
    ~ "row:" name \location-word "\n"
        name.length + "$location".length

.. location-word String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*

━━━━━━━━━━━━━━━━━━━━
_ location-points-source

"".join("row:name_$each\n" in 0 .. < 130)
