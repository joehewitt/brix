`benchmark.meta description: Repeats buffered iterable parsing with growing retained windows.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. source = window-small-refills-source()
. checksum = 0 as Size

for iteration in 0 .. < 1300
    . stream = ChunkedTokenStream'Char(source.codepoints)
    . rows = match stream
        ~ \window-small-refills-document
        ?! Panic("window-small-refills-repeated did not parse")

    for row in rows
        checksum += row

-- "bench-result stream/window-small-refills-repeated checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ window-small-refills-document ~ Char

~ rows \window-small-row+
    rows

.. window-small-row Size ~
    ~ &("rec:" (!"\n" .)* "\n") "rec:" name \window-small-word ":" value \window-small-digits "\n"
        name.length * 29 + value.length

.. window-small-word String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*

.. window-small-digits String ~
    ~ [0-9]+

━━━━━━━━━━━━━━━━━━━━
_ do window-small-refills-source

. source = ""
. large-name = "x" * 32
for index in 0 .. < 260
    . name = "n${index % 10}"
    if index % 43 == 42
        name = large-name
        large-name += large-name
    source += "rec:$name:${index * 41}\n"

= source
