`benchmark.meta description: Exercises short lookahead over the canonical Array-backed stream.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. rows = match window-short-lookahead-source()
    ~ \window-short-lookahead-document
    ?! Panic("window-short-lookahead did not parse")

. checksum = 0 as Size
for row in rows
    checksum += row

-- "bench-result stream/window-short-lookahead checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ window-short-lookahead-document ~ Char

~ rows \window-short-row+
    rows

.. window-short-row Size ~
    ~ &"rec:" "rec:" name \window-short-word ":" value \window-short-digits "\n"
        name.length * 29 + value.length

.. window-short-word String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*

.. window-short-digits String ~
    ~ [0-9]+

━━━━━━━━━━━━━━━━━━━━
_ window-short-lookahead-source

"".join("rec:n$each:${each * 41}\n" in 0 .. < 260)
