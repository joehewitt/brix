`benchmark.meta description: Tokenizes UTF-8 text with grammars.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. tokens = match utf8-tokenizer-source()
    ~ \utf8-tokenizer-document
    ?! Panic("utf8-tokenizer did not parse")

. checksum = 0 as Size
for token in tokens
    checksum += token

-- "bench-result stream/utf8-tokenizer checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ utf8-tokenizer-document ~ Char

~ tokens \utf8-token+
    tokens

.. utf8-token Size ~
    ~ "café:" value (!"\n" .)* "\n"
        value.length * 3
    ~ "mañana:" value (!"\n" .)* "\n"
        value.length * 5
    ~ "東京:" value (!"\n" .)* "\n"
        value.length * 7
    ~ "emoji:" value (!"\n" .)* "\n"
        value.length * 11

━━━━━━━━━━━━━━━━━━━━
_ utf8-tokenizer-source

"".join(utf8-tokenizer-block(each) in 0 .. < 80)

━━━━━━━━━━━━━━━━━━━━
_ " utf8-tokenizer-block
    - index Int

café: crème brûlée numéro $index
mañana: jalapeño piñata año $index
東京: 日本語の見出し $index
emoji: snowman ☃ music ♫ heart ♥ $index${"\n"}
