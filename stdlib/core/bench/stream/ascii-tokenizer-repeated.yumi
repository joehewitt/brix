`benchmark.meta description: Repeats ASCII tokenization to dominate process startup.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. source = ascii-tokenizer-source()
. checksum = 0 as Size

for iteration in 0 .. < 160
    . tokens = match source
        ~ \ascii-tokenizer-document
        ?! Panic("ascii-tokenizer-repeated did not parse")

    for token in tokens
        checksum += token

-- "bench-result stream/ascii-tokenizer-repeated checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ ascii-tokenizer-document ~ Char

~ tokens \ascii-token+
    tokens

.. ascii-token Size ~
    ~ id \ascii-identifier
        id.length * 2
    ~ number \ascii-number
        number.length * 3
    ~ \ascii-space
        1
    ~ "(" | ")" | "{" | "}" | "[" | "]" | ";" | "," | "." | ":" | "+" | "-" | "*" | "/" | "="
        5

.. ascii-identifier String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*

.. ascii-number String ~
    ~ [0-9]+

.. ascii-space ~
    ~ (" " | "\n" | "\t")+

━━━━━━━━━━━━━━━━━━━━
_ ascii-tokenizer-source

"".join("fn alpha_$each(x${each % 9}, y${each % 13}) { value = x + y * ${each + 1}; }\n" in 0 .. < 220)
