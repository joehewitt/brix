; benchmark.meta description: Exercises local pattern calls through a call chain.
; benchmark.meta timing: recommended
; benchmark.meta profiles: stream,compile-timing
(blank)

(main
  (let entries
    (match (call local-call-chain-source)
      (~ \local-call-chain-document)
      (throw (call Panic "local-call-chain did not parse"))
    )
  )
  (blank)
  (let checksum (as 0 Size))
  (for (in entry entries)
    (+= checksum entry)
  )
  (blank)
  (print (str "bench-result stream/local-call-chain checksum=" checksum))
)

(fn-expr + local-call-chain-document _ (over: Char)
  (~ (: entries (+ \local-message))
    entries
  )
  (where
    (lazy local-message Size
      (pattern
        (~ (seq (: head \local-header) (: body \local-body) "\n")
          (+ head body)
        )
      )
    )
    (blank)
    (lazy local-header Size
      (pattern
        (~ (seq "msg:" (: name \local-word) "#" (: serial \local-digits) ";")
          (+ (* (. name length) 5) (. serial length))
        )
      )
    )
    (blank)
    (lazy local-body Size
      (pattern
        (~ (seq "body(" (: first \local-word) "," (: second \local-word) "," (: third \local-word) ")")
          (+ (. first length) (* (. second length) 2) (* (. third length) 3))
        )
      )
    )
    (blank)
    (lazy local-word String
      (pattern
        (~ (seq (chars "a-zA-Z_") (* (chars "a-zA-Z0-9_"))))
      )
    )
    (blank)
    (lazy local-digits String
      (pattern
        (~ (+ (chars "0-9")))
      )
    )
  )
)

(fn-expr _ local-call-chain-source _
  (call (. "" join) (in (str "msg:name_" each "#" (* each 7) ";body(alpha_" (% each 5) ",beta_" (% each 7) ",gamma_" (% each 11) ")\n") (..< 0 140)))
)
