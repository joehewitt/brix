`benchmark.meta description: Tokenizes the ascii-tokenizer-heavy workload with a hand-written cursor loop.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

. source = ascii-tokenizer-cursor-source()
. checksum = 0 as Size

for iteration in 0 .. < 1600
    for token in ascii-tokenizer-cursor-tokens(source)
        checksum += token

-- "bench-result stream/ascii-tokenizer-cursor-heavy checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do ascii-tokenizer-cursor-tokens [Size]
    - source String

. chars = source.codepoints
. count = chars.length
. tokens [Size]
. index Index = 0
while index < count
    . c = chars[index]
    . start = index
    index += 1
    if ascii-cursor-is-word-start(c)
        while index < count && ascii-cursor-is-word-part(chars[index])
            index += 1
        tokens += (index - start) * 2
    else if ascii-cursor-is-digit(c)
        while index < count && ascii-cursor-is-digit(chars[index])
            index += 1
        tokens += (index - start) * 3
    else if ascii-cursor-is-space(c)
        while index < count && ascii-cursor-is-space(chars[index])
            index += 1
        tokens += 1
    else
        tokens += 5
= tokens

━━━━━━━━━━━━━━━━━━━━
_ ascii-cursor-is-word-start Bool
    - c Char

(c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'

━━━━━━━━━━━━━━━━━━━━
_ ascii-cursor-is-word-part Bool
    - c Char

ascii-cursor-is-word-start(c) || ascii-cursor-is-digit(c)

━━━━━━━━━━━━━━━━━━━━
_ ascii-cursor-is-digit Bool
    - c Char

c >= '0' && c <= '9'

━━━━━━━━━━━━━━━━━━━━
_ ascii-cursor-is-space Bool
    - c Char

c == ' ' || c == '\n' || c == '\t'

━━━━━━━━━━━━━━━━━━━━
_ ascii-tokenizer-cursor-source

"".join("fn alpha_$each(x${each % 9}, y${each % 13}) { value = x + y * ${each + 1}; }\n" in 0 .. < 220)
