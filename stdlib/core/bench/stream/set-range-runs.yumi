`benchmark.meta description: Matches repeated set and range classes.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. tokens = match set-range-runs-source()
    ~ \set-range-runs-document
    ?! Panic("set-range-runs did not parse")

. checksum = 0 as Size
for token in tokens
    checksum += token

-- "bench-result stream/set-range-runs checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ set-range-runs-document ~ Char

~ tokens \set-range-token+
    tokens

.. set-range-token Size ~
    ~ id \set-range-identifier \set-range-space
        id.length * 3
    ~ number \set-range-number \set-range-space
        number.length * 5
    ~ symbol [;:=,()] \set-range-space
        7

.. set-range-identifier String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_-]*

.. set-range-number String ~
    ~ [0-9]+ ("." [0-9]+)?

.. set-range-space ~
    ~ (" " | "\n" | "\t")*

━━━━━━━━━━━━━━━━━━━━
_ set-range-runs-source

"".join("alpha_$each = ${each * 17}; beta-name_${each % 11} = ${each}.125, gamma($each)\n" in 0 .. < 180)
