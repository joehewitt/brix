; benchmark.meta description: Runs a trivial stream match over many short strings, one match each, to expose the fixed cost of starting a match.
; benchmark.meta timing: recommended
; benchmark.meta profiles: stream,compile-timing,allocator
(blank)
(prop _ short-input-rows List
  (block
    (item ". chars = text.codepoints")
    (item "if c == '\\\\' && index + 1 < chars.length")
    (item "spans += SourceSpan(kind, text[start .. < index])")
    (item "else if brix-is-word-start(c) || brix-is-digit(c)")
    (item ". made = brix-parse-one(\"\${brix-thick-rule}\\n+ \\\" x\\n\\n\${text}\", store)")
    (item "= store.appended(store.trimmed(node, count - 1), next)")
    (item ".. is-arithmetic = c == '+' || c == '-' || c == '*' || c == '/' || c == '%'")
    (item "=? null if !root || store.count(root) != count + 1")
    (item "| .assign-partial(op, is-optional, right)")
    (item "for index in 0 .. < colors.length")
    (item "-- \"bench-result total=\$checksum of \${rows.length}\"")
    (item "` XXXjoe This is a crappy heuristic")
    (item ". limit = origin + 12 if origin + 12 < chars.length ?? chars.length")
    (item "~ status HTTPStatus \\nl heads \\headers \\nl body \\http-body(heads)")
    (item "//gui.scene.native-peer-marker -> marker.peer, x, y, width, height")
    (item ". pairs ImmutableArray'(KeyValuePair'Key'Value) = table.pairs")
    (item "canvas.fill-color = \$selection-color if is-focused ?? \$idle-selection-color")
    (item ". p4 = (address /and/ 0xff000000) /zrshift/ 24")
    (item "total = total + square(index) * 1'000.5")
    (item "while index < count && brix-is-symbol(chars[index])")
  )
)
(blank)
(prop _ short-input-heads List
  (block
    (item "+ do brix-highlight [SourceSpan]")
    (item "_ do brix-word-end Index")
    (item "+ SourceSpanKind is Union")
    (item "+ do get content-start Size")
    (item "+ @inherited plain-color RGBA = RGBA(\"#e6edf3\")")
    (item "+ do this + other Point @inline")
  )
)
(blank)
(prop _ short-input-lines List
  (block
    (item "Dispatches \$message on \${get-current-task-id()} and waits.")
    (item "The quick brown fox jumps over the lazy dog.")
    (item "Index out of bounds (\$index / \$size) for \\\$name")
    (item "linked \${program.modules.length} modules in \${elapsed}ms")
  )
)
(blank)

(main
  (let checksum Size 0)
  (for (in pass (..< 0 3000))
    (for (in row short-input-rows)
      (+= checksum (call short-input-size row))
    )
    (for (in head short-input-heads)
      (+= checksum (call short-input-size head))
    )
    (for (in line short-input-lines)
      (+= checksum (call short-input-size line))
    )
  )
  (blank)
  (print (str "bench-result stream/short-input-matches checksum=" checksum))
)

(fn-expr _ short-input-size Size
  (param text String)
  (match text
    (~ \short-input-any
      1
    )
    (default
      (inline 0)
    )
  )
)

(fn-expr _ short-input-any _ (over: Char)
  (~ (* .))
)
