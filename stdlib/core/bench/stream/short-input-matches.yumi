`benchmark.meta description: Runs a trivial stream match over many short strings, one match each, to expose the fixed cost of starting a match.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing,allocator

_ short-input-rows List
    * ". chars = text.codepoints"
    * "if c == '\\\\' && index + 1 < chars.length"
    * "spans += SourceSpan(kind, text[start .. < index])"
    * "else if brix-is-word-start(c) || brix-is-digit(c)"
    * ". made = brix-parse-one(\"\${brix-thick-rule}\\n+ \\\" x\\n\\n\${text}\", store)"
    * "= store.appended(store.trimmed(node, count - 1), next)"
    * ".. is-arithmetic = c == '+' || c == '-' || c == '*' || c == '/' || c == '%'"
    * "=? null if !root || store.count(root) != count + 1"
    * "| .assign-partial(op, is-optional, right)"
    * "for index in 0 .. < colors.length"
    * "-- \"bench-result total=\$checksum of \${rows.length}\""
    * "` XXXjoe This is a crappy heuristic"
    * ". limit = origin + 12 if origin + 12 < chars.length ?? chars.length"
    * "~ status HTTPStatus \\nl heads \\headers \\nl body \\http-body(heads)"
    * "//gui.scene.native-peer-marker -> marker.peer, x, y, width, height"
    * ". pairs ImmutableArray'(KeyValuePair'Key'Value) = table.pairs"
    * "canvas.fill-color = \$selection-color if is-focused ?? \$idle-selection-color"
    * ". p4 = (address /and/ 0xff000000) /zrshift/ 24"
    * "total = total + square(index) * 1'000.5"
    * "while index < count && brix-is-symbol(chars[index])"

_ short-input-heads List
    * "+ do brix-highlight [SourceSpan]"
    * "_ do brix-word-end Index"
    * "+ SourceSpanKind is Union"
    * "+ do get content-start Size"
    * "+ @inherited plain-color RGBA = RGBA(\"#e6edf3\")"
    * "+ do this + other Point @inline"

_ short-input-lines List
    * "Dispatches \$message on \${get-current-task-id()} and waits."
    * "The quick brown fox jumps over the lazy dog."
    * "Index out of bounds (\$index / \$size) for \\\$name"
    * "linked \${program.modules.length} modules in \${elapsed}ms"

. checksum Size = 0
for pass in 0 .. < 3000
    for row in short-input-rows
        checksum += short-input-size(row)
    for head in short-input-heads
        checksum += short-input-size(head)
    for line in short-input-lines
        checksum += short-input-size(line)

-- "bench-result stream/short-input-matches checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ short-input-size Size
    - text String

match text
    ~ \short-input-any
        1
    ?? 0

━━━━━━━━━━━━━━━━━━━━
_ short-input-any ~ Char

~ .*
