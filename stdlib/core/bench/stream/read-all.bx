; benchmark.meta description: Reads buffered character streams through EOF at exact and partial growth boundaries.
; benchmark.meta timing: recommended
; benchmark.meta profiles: allocator,compile-timing
(blank)
(import /core/tokenstream)
(blank)

(main
  (let source (* "x" 2097152))
  (let checksum (as 0 Size))
  (for (in size (list 0 1024 1500 1048576 1500000 2097152))
    (let stream (call (of ChunkedTokenStream Char) (. ([] source (..< 0 size)) codepoints)))
    (let result (call (. stream read)))
    (if (or (!= (. result size) size) (. stream has-more))
      (call Panic "read-all length mismatch")
    )
    (+= checksum (. result size))
  )
  (blank)
  (print (str "bench-result stream/read-all checksum=" checksum))
)
