`benchmark.meta description: Twin of ascii-tokenizer-heavy with each character class written inline instead of as a named rule.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing,allocator

. source = ascii-tokenizer-source()
. checksum = 0 as Size

for iteration in 0 .. < 1600
    . tokens = match source
        ~ \ascii-tokenizer-document
        ?! Panic("ascii-tokenizer-heavy-inline did not parse")

    for token in tokens
        checksum += token

-- "bench-result stream/ascii-tokenizer-heavy-inline checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ ascii-tokenizer-document ~ Char

~ tokens \ascii-token+
    tokens

.. ascii-token Size ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*
        2
    ~ [0-9]+
        3
    ~ (" " | "\n" | "\t")+
        1
    ~ "(" | ")" | "{" | "}" | "[" | "]" | ";" | "," | "." | ":" | "+" | "-" | "*" | "/" | "="
        5

.. ascii-identifier String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_]*

.. ascii-number String ~
    ~ [0-9]+

.. ascii-space ~
    ~ (" " | "\n" | "\t")+

━━━━━━━━━━━━━━━━━━━━
_ ascii-tokenizer-source

"".join("fn alpha_$each(x${each % 9}, y${each % 13}) { value = x + y * ${each + 1}; }\n" in 0 .. < 220)
