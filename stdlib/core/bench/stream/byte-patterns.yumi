`benchmark.meta description: Matches byte-oriented stream patterns.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

/core/tokenstream
/data/stream

. stream = byte-patterns-stream()
. rows = match stream
    ~ \byte-patterns-document
    ?! Panic("byte-patterns did not parse")

. checksum = 0 as Size
for row in rows
    checksum += row

-- "bench-result stream/byte-patterns checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ byte-patterns-document ~ Byte

~ rows \byte-pattern-row+
    rows

.. byte-pattern-row Size ~
    ~ magic U8 length U8 payload Byte{length}
        (magic as Size) * 17 + payload.size

━━━━━━━━━━━━━━━━━━━━
_ do byte-patterns-stream

. bytes = DataStream'Byte(60000)
bytes.reset()
for row in 0 .. < 220
    . length = ((row % 17) + 3) as U8
    bytes <- ((160 + row % 7) as Byte)
    bytes <- length
    for offset in 0 .. < length
        bytes <- (((row * 13 + offset * 7) % 256) as Byte)

bytes.rewind()
= ChunkedTokenStream'Byte(bytes)
