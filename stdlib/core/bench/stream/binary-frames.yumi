`benchmark.meta description: Parses deterministic binary-style frame records.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

/core/tokenstream
/data/stream

. bytes = DataStream'Byte(140000)
for index in 0 .. < 12
    write-bench-frame(bytes, index)

. stream = ChunkedTokenStream'Byte(DataStream(bytes.data, bytes.length))
. checksum = 0 as Size
for index in 0 .. < 12
    checksum += read-bench-frame(stream, index)

-- "bench-result stream/binary-frames checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do write-bench-frame
    - bytes DataStream'Byte
    - frame-index Int

. payload-length = frame-length(frame-index)
. op = if frame-index % 3 == 0 then 2u8 else 1u8
. mask = frame-mask(frame-index)

bytes <- (128 /or/ op)
if payload-length < 126
    bytes <- ((payload-length as U8) /or/ 128)
else if payload-length < 65536
    bytes <- (126u8 /or/ 128u8)
    bytes <- payload-length
else
    bytes <- (127u8 /or/ 128u8)
    bytes <- payload-length

bytes <- mask
for i in 0 .. < payload-length
    bytes <- (payload-byte(frame-index, i) /xor/ mask[i % 4])

━━━━━━━━━━━━━━━━━━━━
+ do read-bench-frame Size
    - stream ChunkedTokenStream'Byte
    - frame-index Int

. b1 = stream.require'U8()
. b2 = stream.require'U8()
. length8 = b2 /and/ 127
. length =
    |? length8 == 127
        stream.require'U64()
    |? length8 == 126
        stream.require'U16() as U64
    ??
        length8 as U64
. mask = Byte[4]
for i in 0 .. < 4
    mask[i] = stream.require'Byte()

. total = ((b1 as Size) * 3) + ((b2 as Size) * 5) + (length as Size) + (frame-index as Size)
for i in 0 .. < (length as Size)
    . value = stream.require'Byte() /xor/ mask[i % 4]
    total += (value as Size) * ((i % 17) + 1)

= total

━━━━━━━━━━━━━━━━━━━━
_ frame-length
    - frame-index Int

match frame-index % 6
    |= 0
        0
    |= 1
        12
    |= 2
        125
    |= 3
        126
    |= 4
        260
    ??
        66000

━━━━━━━━━━━━━━━━━━━━
_ do frame-mask
    - frame-index Int

. mask = Byte[4]
for i in 0 .. < 4
    mask[i] = ((frame-index * 31 + i * 17 + 9) % 256) as U8

= mask

━━━━━━━━━━━━━━━━━━━━
_ payload-byte Byte
    - frame-index Int
    - offset Int

((frame-index * 13 + offset * 7 + offset / 3) % 256) as U8
