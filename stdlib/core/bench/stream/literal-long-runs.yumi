`benchmark.meta description: Matches long literal runs in grammars.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. rows = match literal-long-runs-source()
    ~ \literal-long-runs-document
    ?! Panic("literal-long-runs did not parse")

. checksum = 0 as Size
for row in rows
    checksum += row

-- "bench-result stream/literal-long-runs checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ literal-long-runs-document ~ Char

~ rows \literal-long-runs-row+
    rows

.. literal-long-runs-row Size ~
    ~ "BEGIN|record|" key [a-z0-9_-]+ "|payload:" text (!"|END|" .)* "|END|\n"
        key.length * 17 + text.length

━━━━━━━━━━━━━━━━━━━━
_ literal-long-runs-source

"".join("BEGIN|record|item-$each|payload:${literal-long-runs-payload(each)}|END|\n" in 0 .. < 96)

━━━━━━━━━━━━━━━━━━━━
_ literal-long-runs-payload
    - index Int

"alpha beta gamma delta epsilon zeta eta theta ${index % 17} " * 3
