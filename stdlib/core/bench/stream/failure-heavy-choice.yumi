`benchmark.meta description: Stresses choices with frequent failed alternatives.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. rows = match failure-heavy-choice-source()
    ~ \failure-heavy-choice-document
    ?! Panic("failure-heavy-choice did not parse")

. checksum = 0 as Size
for row in rows
    checksum += row

-- "bench-result stream/failure-heavy-choice checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ failure-heavy-choice-document ~ Char

~ rows \failure-heavy-row+
    rows

.. failure-heavy-row Size ~
    ~ "record:" name \failure-heavy-name ":payload:" body (!":missing" .)* ":missing\n"
        name.length + body.length
    ~ "record:" name \failure-heavy-name ":payload:" body (!":value=" .)* ":value=" value \failure-heavy-digits "\n"
        name.length * 11 + body.length + value.length

.. failure-heavy-name String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_-]*

.. failure-heavy-digits String ~
    ~ [0-9]+

━━━━━━━━━━━━━━━━━━━━
_ failure-heavy-choice-source

"".join("record:item-$each:payload:${"abcdef-" * 8}:value=${each * 19}\n" in 0 .. < 120)
