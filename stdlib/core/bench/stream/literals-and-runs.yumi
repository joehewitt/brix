`benchmark.meta description: Combines literal matches with repeated character runs.
`benchmark.meta timing: recommended
`benchmark.meta profiles: stream,compile-timing

. checksum = stream-literals-checksum(corpus-tokens())
-- "bench-result stream/literals-and-runs checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do stream-literals-checksum
    - tokens [String]

. total = 0 as Size
for i in 0 .. < 24
    for token in tokens
        . matched = match token
            ~ \bench-token
            ?! Panic("literal token did not parse")
        total += matched.length

= total

━━━━━━━━━━━━━━━━━━━━
+ bench-token ~ Char

~ text \quoted-string
    text
~ text \identifier
    text
~ text \number
    text
~ text \whitespace
    text
~ c .
    c as String

.. quoted-string String ~
    ~ "\"" chars (!"\"" .)* "\""
        chars

.. identifier String ~
    ~ [a-zA-Z_] [a-zA-Z0-9_-]*

.. number String ~
    ~ [0-9]+ ("." [0-9]+)?

.. whitespace String ~
    ~ (" " | "\n" | "\t")+

━━━━━━━━━━━━━━━━━━━━
_ do corpus-tokens

. tokens [String]
tokens += "let"
tokens += "   "
tokens += "alpha"
tokens += " "
tokens += "="
tokens += " "
tokens += "\"plain literal\""
tokens += "12345"
tokens += "\n\t"
tokens += "beta_name"
tokens += "\"café mañana 東京\""
tokens += "67890"
tokens += "identifier-one"
tokens += "identifier_two"
tokens += "314159"
tokens += "2.71828"
tokens += "\"quoted string with spaces\""
tokens += "\n    "

= tokens
