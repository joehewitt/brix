`benchmark.meta description: Queues thousands of readers on one channel, then feeds each of them a message.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/channel

. readers = 5000
. channel SyncChannel'Int
. tally = Tally()
for i in 0 .. < readers
    do new
        tally.sum += (<- channel)!

for i in 0 .. < readers
    channel <- i

-- "bench-result tasks/channel-waiters checksum=${tally.sum}"

━━━━━━━━━━━━━━━━━━━━
_ Tally

+ sum Int
