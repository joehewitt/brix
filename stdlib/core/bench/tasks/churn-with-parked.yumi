`benchmark.meta description: Spawns and finishes short tasks one at a time while thousands of other tasks stay parked.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/channel

. parked = 2000
. cycles = 20000
. gate SyncChannel'Int
. done SyncChannel'Int
for i in 0 .. < parked
    do new
        <- gate

. checksum = 0
for i in 0 .. < cycles
    do new
        done <- i
    checksum += (<- done)!
gate.close()

-- "bench-result tasks/churn-with-parked checksum=$checksum"
