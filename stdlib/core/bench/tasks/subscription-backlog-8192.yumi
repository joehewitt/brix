`benchmark.meta description: Drains 4 subscription backlogs of 8192 messages each.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/channel

. depth = 8192
. channel = AsyncChannel'Int()
. checksum = 0
for n on channel
    checksum = (checksum * 31 + n) % 1000000007

for batch in 0 .. < 4
    for i in 0 .. < depth
        channel <- batch * depth + i
    drain()

-- "bench-result tasks/subscription-backlog-8192 checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do drain

. done = Semaphore()
do new
    done.post()
done.wait()
