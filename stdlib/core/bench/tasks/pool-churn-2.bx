; benchmark.meta description: Producers in a 2-thread worker pool each spawn thousands of short computing tasks and gather their results over a channel.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/channel)
(blank)

(main
  (let threads 2)
  (let producers 8)
  (let children 4000)
  (let pool (call Worker threads))
  (let done (of SyncBufferedChannel Int))
  (blank)
  (for (in producer (..< 0 producers))
    (do-new (worker: pool)
      (let results (of SyncBufferedChannel Int))
      (for (in child (..< 0 children))
        (do-new
          (let x (+ child producer))
          (for (in step (..< 0 200))
            (= x (% (+ (* x 75) 74) 65537))
          )
          (<- results (% x 1000))
        )
      )
      (let total 0)
      (for (in child (..< 0 children))
        (+= total (!! (<- results)))
      )
      (<- done total)
    )
  )
  (blank)
  (let checksum 0)
  (for (in producer (..< 0 producers))
    (+= checksum (!! (<- done)))
  )
  (call (. pool stop))
  (blank)
  (print (str "bench-result tasks/pool-churn-2 checksum=" checksum))
)
