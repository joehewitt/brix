; benchmark.meta description: Fills a buffered channel with a backlog, then drains it.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/channel)
(blank)

(main
  (let count 30000)
  (let channel (of SyncBufferedChannel Int))
  (for (in i (..< 0 count))
    (<- channel i)
  )
  (blank)
  (let checksum 0)
  (for (in i (..< 0 count))
    (+= checksum (!! (<- channel)))
  )
  (blank)
  (print (str "bench-result tasks/buffered-drain checksum=" checksum))
)
