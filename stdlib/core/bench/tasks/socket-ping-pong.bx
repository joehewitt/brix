; benchmark.meta description: Bounces a small message over loopback sockets between pairs of tasks so every read waits on the poller.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/channel)
(import /net/socket)
(blank)

(main
  (let pairs 8)
  (let rounds 2000)
  (let listener (call TCPListener))
  (let done (of SyncBufferedChannel Int))
  (blank)
  (do-new
    (for (in pair (..< 0 pairs))
      (let server (!! (call (. listener accept))))
      (do-new
        (let buffer ([] Byte 1))
        (for (in round (..< 0 rounds))
          (call (. server read) 1 buffer)
          (call (. server write) buffer 1)
        )
        (call (. server close))
      )
    )
  )
  (blank)
  (for (in pair (..< 0 pairs))
    (do-new
      (let client (call (of TCP Byte) "127.0.0.1" (. listener port)))
      (let buffer ([] Byte 1))
      (= ([] buffer 0) 7)
      (let total 0)
      (for (in round (..< 0 rounds))
        (call (. client write) buffer 1)
        (+= total (call (. client read) 1 buffer))
      )
      (call (. client close))
      (<- done total)
    )
  )
  (blank)
  (let checksum 0)
  (for (in pair (..< 0 pairs))
    (+= checksum (!! (<- done)))
  )
  (call (. listener close))
  (blank)
  (print (str "bench-result tasks/socket-ping-pong checksum=" checksum))
)
