`benchmark.meta description: Producers in a 2-thread worker pool each spawn thousands of short computing tasks and gather their results over a channel.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/channel

. threads = 2
. producers = 8
. children = 4000
. pool = Worker(threads)
. done SyncBufferedChannel'Int

for producer in 0 .. < producers
    do (pool) new
        . results SyncBufferedChannel'Int
        for child in 0 .. < children
            do new
                . x = child + producer
                for step in 0 .. < 200
                    x = (x * 75 + 74) % 65537
                results <- x % 1000
        . total = 0
        for child in 0 .. < children
            total += (<- results)!
        done <- total

. checksum = 0
for producer in 0 .. < producers
    checksum += (<- done)!
pool.stop()

-- "bench-result tasks/pool-churn-2 checksum=$checksum"
