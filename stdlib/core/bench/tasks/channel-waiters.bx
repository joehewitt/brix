; benchmark.meta description: Queues thousands of readers on one channel, then feeds each of them a message.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/channel)
(blank)

(main
  (let readers 5000)
  (let channel (of SyncChannel Int))
  (let tally (call Tally))
  (for (in i (..< 0 readers))
    (do-new
      (+= (. tally sum) (!! (<- channel)))
    )
  )
  (blank)
  (for (in i (..< 0 readers))
    (<- channel i)
  )
  (blank)
  (print (str "bench-result tasks/channel-waiters checksum=" (. tally sum)))
)

(type _ Tally
  (prop + sum Int)
)
