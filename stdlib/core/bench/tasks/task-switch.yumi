`benchmark.meta description: Passes a message back and forth between two tasks on the default queue, so every step is a task switch.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/channel

. rounds = 200000
. ping SyncChannel'Int
. pong SyncChannel'Int

do new
    for round in 0 .. < rounds
        pong <- (<- ping)! % 1000 + 1

. checksum = 0
for round in 0 .. < rounds
    ping <- round
    checksum += (<- pong)!

-- "bench-result tasks/task-switch checksum=$checksum"
