; benchmark.meta description: Runs many short tasks in a two-thread worker pool that two long CPU-bound tasks also occupy, and ends once the short tasks finish.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/channel)
(blank)

(main
  (let hogs 2)
  (let shorts 200)
  (let pool (call Worker 2))
  (let results (of SyncBufferedChannel Int))
  (let spent (of SyncBufferedChannel Int))
  (blank)
  (for (in hog (..< 0 hogs))
    (do-new (worker: pool)
      (let x hog)
      (for (in step (..< 0 600000000))
        (= x (% (+ (* x 75) 74) 65537))
      )
      (<- spent x)
    )
  )
  (blank)
  (for (in short (..< 0 shorts))
    (do-new (worker: pool)
      (let x short)
      (for (in step (..< 0 40000))
        (= x (% (+ (* x 75) 74) 65537))
      )
      (<- results (% x 1000))
    )
  )
  (blank)
  (let checksum 0)
  (for (in short (..< 0 shorts))
    (+= checksum (!! (<- results)))
  )
  (blank)
  (print (str "bench-result tasks/pool-fairness checksum=" checksum))
  (call request-process-termination 0)
)
