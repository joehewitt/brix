`benchmark.meta description: Bounces a small message over loopback sockets between pairs of tasks so every read waits on the poller.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/channel
/net/socket

. pairs = 8
. rounds = 2000
. listener = TCPListener()
. done SyncBufferedChannel'Int

do new
    for pair in 0 .. < pairs
        . server = listener.accept()!
        do new
            . buffer = Byte[1]
            for round in 0 .. < rounds
                server.read(1, buffer)
                server.write(buffer, 1)
            server.close()

for pair in 0 .. < pairs
    do new
        . client = TCP'Byte("127.0.0.1", listener.port)
        . buffer = Byte[1]
        buffer[0] = 7
        . total = 0
        for round in 0 .. < rounds
            client.write(buffer, 1)
            total += client.read(1, buffer)
        client.close()
        done <- total

. checksum = 0
for pair in 0 .. < pairs
    checksum += (<- done)!
listener.close()

-- "bench-result tasks/socket-ping-pong checksum=$checksum"
