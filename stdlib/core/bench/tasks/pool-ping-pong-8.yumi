`benchmark.meta description: Bounces small messages over loopback sockets between pairs of tasks that all run in a 8-thread worker pool.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/channel
/net/socket

. threads = 8
. pairs = 16
. rounds = 1000
. pool = Worker(threads)
. listener = TCPListener()
. done SyncBufferedChannel'Int

do (pool) new
    for pair in 0 .. < pairs
        . server = listener.accept()!
        do new
            . buffer = Byte[1]
            for round in 0 .. < rounds
                server.read(1, buffer)
                server.write(buffer, 1)
            server.close()

for pair in 0 .. < pairs
    do (pool) new
        . client = TCP'Byte("127.0.0.1", listener.port)
        . buffer = Byte[1]
        buffer[0] = 7
        . total = 0
        for round in 0 .. < rounds
            client.write(buffer, 1)
            total += client.read(1, buffer)
        client.close()
        done <- total

. checksum = 0
for pair in 0 .. < pairs
    checksum += (<- done)!
listener.close()
pool.stop()

-- "bench-result tasks/pool-ping-pong-8 checksum=$checksum"
