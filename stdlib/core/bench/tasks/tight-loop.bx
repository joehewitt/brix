; benchmark.meta description: Runs one long arithmetic loop on the default queue, so the cost of loop polls dominates.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)

(main
  (let x 1)
  (for (in step (..< 0 200000000))
    (= x (% (+ (* x 75) 74) 65537))
  )
  (blank)
  (print (str "bench-result tasks/tight-loop checksum=" x))
)
