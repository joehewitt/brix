; benchmark.meta description: Reads a @stack global that a do with binds elsewhere in a hot loop: each read loads the slot in the task's memory and checks it is bound.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/array)
(blank)
(prop + scale _ @stack (= 3))
(blank)

(main
  (let item-count (as 4096 Size))
  (let pass-count (as 16384 Size))
  (let checksum (as 0 Size))
  (let values (call (of Array Size) item-count (:with (% each 251))))
  (blank)
  (+= checksum (call sum-scaled values pass-count))
  (do-with scale 3
    (+= checksum (call sum-scaled values 1))
  )
  (blank)
  (print (str "bench-result globals/stack-bound-read checksum=" checksum))
)

(fn-do _ sum-scaled Size
  (param values (of Array Size))
  (param passes Size)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 (. values length)))
      (= ([] values index) (+ ([] values index) (as scale Size)))
      (+= checksum ([] values index))
    )
  )
  (return checksum)
)
