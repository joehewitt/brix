`benchmark.meta description: Reads a @stack global that a do with binds elsewhere in a hot loop: each read loads the slot in the task's memory and checks it is bound.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/array

+ @stack scale = 3

. item-count = 4096 as Size
. pass-count = 16384 as Size
. checksum = 0 as Size
. values = Array'Size(item-count) • with each % 251

checksum += sum-scaled(values, pass-count)
do with scale = 3
    checksum += sum-scaled(values, 1)

-- "bench-result globals/stack-bound-read checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do sum-scaled Size
    - values Array'Size
    - passes Size

. checksum = 0 as Size
for pass in 0 .. < passes
    for index in 0 .. < values.length
        values[index] = values[index] + (scale as Size)
        checksum += values[index]
= checksum
