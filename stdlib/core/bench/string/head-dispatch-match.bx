; benchmark.meta description: Dispatches on a String head through a 40-arm match table.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)

(main
  (let checksum (as 0 Size))
  (for (in iteration (..< 0 400000))
    (for (in head head-dispatch-match-heads)
      (+= checksum (call head-dispatch-match head))
    )
  )
  (blank)
  (print (str "bench-result string/head-dispatch-match checksum=" checksum))
)

(blank)
(prop _ head-dispatch-match-heads List
  (block
    (item "import")
    (item "export")
    (item "let")
    (item "set")
    (item "return")
    (item "yield")
    (item "if")
    (item "else-if")
    (item "else")
    (item "while")
    (item "for")
    (item "break")
    (item "continue")
    (item "match")
    (item "case")
    (item "default")
    (item "block")
    (item "inline")
    (item "call")
    (item "index")
    (item "member")
    (item "lambda")
    (item "tuple")
    (item "list")
    (item "map")
    (item "range")
    (item "cast")
    (item "is")
    (item "not")
    (item "and")
    (item "or")
    (item "pattern")
    (item "catch")
    (item "throw")
    (item "finally")
    (item "use")
    (item "fn")
    (item "type")
    (item "style")
    (item "content")
    (item "missing")
    (item "absent")
    (item "unknown-head")
    (item "x")
  )
)

(fn-expr _ head-dispatch-match Size
  (param head String)
  (match head
    (case= "import"
      1
    )
    (case= "export"
      2
    )
    (case= "let"
      3
    )
    (case= "set"
      4
    )
    (case= "return"
      5
    )
    (case= "yield"
      6
    )
    (case= "if"
      7
    )
    (case= "else-if"
      8
    )
    (case= "else"
      9
    )
    (case= "while"
      10
    )
    (case= "for"
      11
    )
    (case= "break"
      12
    )
    (case= "continue"
      13
    )
    (case= "match"
      14
    )
    (case= "case"
      15
    )
    (case= "default"
      16
    )
    (case= "block"
      17
    )
    (case= "inline"
      18
    )
    (case= "call"
      19
    )
    (case= "index"
      20
    )
    (case= "member"
      21
    )
    (case= "lambda"
      22
    )
    (case= "tuple"
      23
    )
    (case= "list"
      24
    )
    (case= "map"
      25
    )
    (case= "range"
      26
    )
    (case= "cast"
      27
    )
    (case= "is"
      28
    )
    (case= "not"
      29
    )
    (case= "and"
      30
    )
    (case= "or"
      31
    )
    (case= "pattern"
      32
    )
    (case= "catch"
      33
    )
    (case= "throw"
      34
    )
    (case= "finally"
      35
    )
    (case= "use"
      36
    )
    (case= "fn"
      37
    )
    (case= "type"
      38
    )
    (case= "style"
      39
    )
    (case= "content"
      40
    )
    (default
      0
    )
  )
)
