`benchmark.meta description: Iterates 4096 ASCII codepoints with fixed total work.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator,string-iteration

. block = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
. source = block * 64
. passes = 256
. codepoints = 0 as Size
. checksum = 0 as Size

for pass in 0 .. < passes
    for char in source
        codepoints += 1
        checksum += char as Size

if codepoints != 1048576 || checksum != 73531392
    ?! Panic("ASCII-4096 benchmark produced the wrong work")

//string-iteration.benchmark-passes += passes
//string-iteration.benchmark-codepoints += codepoints
//string-iteration.benchmark-checksum += checksum
-- "bench-result string/iterate-ascii-4096 checksum=$checksum"
