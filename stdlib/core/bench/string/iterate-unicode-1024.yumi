`benchmark.meta description: Iterates fixed mixed-width Unicode with combining and non-BMP codepoints.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator,string-iteration

. unit = "Aé漢😀é"
. source = (unit * 170) ++ "Aé漢😀"
. passes = 1024
. codepoints = 0 as Size
. checksum = 0 as Size

for pass in 0 .. < passes
    for char in source
        codepoints += 1
        checksum += char as Size

if codepoints != 1048576 || checksum != 27688304640
    ?! Panic("Unicode-1024 benchmark produced the wrong work")

//string-iteration.benchmark-passes += passes
//string-iteration.benchmark-codepoints += codepoints
//string-iteration.benchmark-checksum += checksum
-- "bench-result string/iterate-unicode-1024 checksum=$checksum"
