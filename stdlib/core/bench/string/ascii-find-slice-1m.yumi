`benchmark.meta description: Finds and slices near the end of a resident 1 MiB ASCII String.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

. block = "0123456789abcdef"
. source = block * 65536
. passes = 4096
. checksum = 0 as Size

for pass in 0 .. < passes
    . found = (source.find("abcdef", 1048560) ?? 0) as Size
    . tail = source[1048560 .. < 1048576]
    checksum += found + tail.length

if checksum != 4295008256
    ?! Panic("ascii-find-slice-1m benchmark produced the wrong checksum")

-- "bench-result string/ascii-find-slice-1m checksum=$checksum"
