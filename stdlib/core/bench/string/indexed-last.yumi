`benchmark.meta description: Repeatedly reads the last codepoint of a resident 1024-codepoint String.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator,string-iteration

. block = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
. source = block * 16
. repetitions = 1000000
. checksum = 0 as Size

for iteration in 0 .. < repetitions
    checksum += source[1023] as Size

if checksum != 102000000
    ?! Panic("indexed-last benchmark produced the wrong checksum")

//string-iteration.benchmark-passes += repetitions
//string-iteration.benchmark-codepoints += repetitions
//string-iteration.benchmark-checksum += checksum
-- "bench-result string/indexed-last checksum=$checksum"
