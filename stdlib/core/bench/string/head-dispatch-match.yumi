`benchmark.meta description: Dispatches on a String head through a 40-arm match table.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

. checksum = 0 as Size
for iteration in 0 .. < 400000
    for head in head-dispatch-match-heads
        checksum += head-dispatch-match(head)

-- "bench-result string/head-dispatch-match checksum=$checksum"

_ head-dispatch-match-heads List
    * "import"
    * "export"
    * "let"
    * "set"
    * "return"
    * "yield"
    * "if"
    * "else-if"
    * "else"
    * "while"
    * "for"
    * "break"
    * "continue"
    * "match"
    * "case"
    * "default"
    * "block"
    * "inline"
    * "call"
    * "index"
    * "member"
    * "lambda"
    * "tuple"
    * "list"
    * "map"
    * "range"
    * "cast"
    * "is"
    * "not"
    * "and"
    * "or"
    * "pattern"
    * "catch"
    * "throw"
    * "finally"
    * "use"
    * "fn"
    * "type"
    * "style"
    * "content"
    * "missing"
    * "absent"
    * "unknown-head"
    * "x"

━━━━━━━━━━━━━━━━━━━━
_ head-dispatch-match Size
    - head String

match head
    |= "import"
        1
    |= "export"
        2
    |= "let"
        3
    |= "set"
        4
    |= "return"
        5
    |= "yield"
        6
    |= "if"
        7
    |= "else-if"
        8
    |= "else"
