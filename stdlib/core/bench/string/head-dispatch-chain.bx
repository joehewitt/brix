; benchmark.meta description: Dispatches on a String head through a 40-arm if/else-if chain.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)

(main
  (let checksum (as 0 Size))
  (for (in iteration (..< 0 400000))
    (for (in head head-dispatch-chain-heads)
      (+= checksum (call head-dispatch-chain head))
    )
  )
  (blank)
  (print (str "bench-result string/head-dispatch-chain checksum=" checksum))
)

(blank)
(prop _ head-dispatch-chain-heads List
  (block
    (item "import")
    (item "export")
    (item "let")
    (item "set")
    (item "return")
    (item "yield")
    (item "if")
    (item "else-if")
    (item "else")
    (item "while")
    (item "for")
    (item "break")
    (item "continue")
    (item "match")
    (item "case")
    (item "default")
    (item "block")
    (item "inline")
    (item "call")
    (item "index")
    (item "member")
    (item "lambda")
    (item "tuple")
    (item "list")
    (item "map")
    (item "range")
    (item "cast")
    (item "is")
    (item "not")
    (item "and")
    (item "or")
    (item "pattern")
    (item "catch")
    (item "throw")
    (item "finally")
    (item "use")
    (item "fn")
    (item "type")
    (item "style")
    (item "content")
    (item "missing")
    (item "absent")
    (item "unknown-head")
    (item "x")
  )
)

(fn-do _ head-dispatch-chain Size
  (param head String)
  (let code Size 0)
  (if (== head "import")
    (= code 1)
    (else-if (== head "export")
      (= code 2)
    )
    (else-if (== head "let")
      (= code 3)
    )
    (else-if (== head "set")
      (= code 4)
    )
    (else-if (== head "return")
      (= code 5)
    )
    (else-if (== head "yield")
      (= code 6)
    )
    (else-if (== head "if")
      (= code 7)
    )
    (else-if (== head "else-if")
      (= code 8)
    )
    (else-if (== head "else")
      (= code 9)
    )
    (else-if (== head "while")
      (= code 10)
    )
    (else-if (== head "for")
      (= code 11)
    )
    (else-if (== head "break")
      (= code 12)
    )
    (else-if (== head "continue")
      (= code 13)
    )
    (else-if (== head "match")
      (= code 14)
    )
    (else-if (== head "case")
      (= code 15)
    )
    (else-if (== head "default")
      (= code 16)
    )
    (else-if (== head "block")
      (= code 17)
    )
    (else-if (== head "inline")
      (= code 18)
    )
    (else-if (== head "call")
      (= code 19)
    )
    (else-if (== head "index")
      (= code 20)
    )
    (else-if (== head "member")
      (= code 21)
    )
    (else-if (== head "lambda")
      (= code 22)
    )
    (else-if (== head "tuple")
      (= code 23)
    )
    (else-if (== head "list")
      (= code 24)
    )
    (else-if (== head "map")
      (= code 25)
    )
    (else-if (== head "range")
      (= code 26)
    )
    (else-if (== head "cast")
      (= code 27)
    )
    (else-if (== head "is")
      (= code 28)
    )
    (else-if (== head "not")
      (= code 29)
    )
    (else-if (== head "and")
      (= code 30)
    )
    (else-if (== head "or")
      (= code 31)
    )
    (else-if (== head "pattern")
      (= code 32)
    )
    (else-if (== head "catch")
      (= code 33)
    )
    (else-if (== head "throw")
      (= code 34)
    )
    (else-if (== head "finally")
      (= code 35)
    )
    (else-if (== head "use")
      (= code 36)
    )
    (else-if (== head "fn")
      (= code 37)
    )
    (else-if (== head "type")
      (= code 38)
    )
    (else-if (== head "style")
      (= code 39)
    )
    (else-if (== head "content")
      (= code 40)
    )
  )
  (return code)
)
