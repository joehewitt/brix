`benchmark.meta description: Builds short Strings from bytes: Byte[] slices, C bytes checked then copied, and formatted numbers.
`benchmark.meta timing: recommended
`benchmark.meta profiles: timing

/BxCore/BxString.h

. record = "person 1234,p1234@example.com,café 42,"
. bytes = byte-view(record)
. total = 0
for i in 0 .. < 200000
    total += bytes.slice-string(0 .. < 11).length
    total += bytes.slice-string(30 .. < 38).length
    if C:brixStringValidateUtf8(record, 29) == 0
        total += C:brixStringCreate(record, 29).length
    total += "$i".length

-- "bench-result string/from-bytes checksum=$total"
