`benchmark.meta description: Dispatches on a String head through a 40-arm if/else-if chain.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

. checksum = 0 as Size
for iteration in 0 .. < 400000
    for head in head-dispatch-chain-heads
        checksum += head-dispatch-chain(head)

-- "bench-result string/head-dispatch-chain checksum=$checksum"

_ head-dispatch-chain-heads List
    * "import"
    * "export"
    * "let"
    * "set"
    * "return"
    * "yield"
    * "if"
    * "else-if"
    * "else"
    * "while"
    * "for"
    * "break"
    * "continue"
    * "match"
    * "case"
    * "default"
    * "block"
    * "inline"
    * "call"
    * "index"
    * "member"
    * "lambda"
    * "tuple"
    * "list"
    * "map"
    * "range"
    * "cast"
    * "is"
    * "not"
    * "and"
    * "or"
    * "pattern"
    * "catch"
    * "throw"
    * "finally"
    * "use"
    * "fn"
    * "type"
    * "style"
    * "content"
    * "missing"
    * "absent"
    * "unknown-head"
    * "x"

━━━━━━━━━━━━━━━━━━━━
_ do head-dispatch-chain Size
    - head String

. code Size = 0
if head == "import"
    code = 1
else if head == "export"
    code = 2
else if head == "let"
    code = 3
else if head == "set"
    code = 4
else if head == "return"
    code = 5
else if head == "yield"
    code = 6
else if head == "if"
    code = 7
else if head == "else-if"
    code = 8
else if head == "else"
    code = 9
else if head == "while"
    code = 10
else if head == "for"
    code = 11
else if head == "break"
    code = 12
else if head == "continue"
    code = 13
else if head == "match"
    code = 14
else if head == "case"
    code = 15
else if head == "default"
    code = 16
else if head == "block"
    code = 17
else if head == "inline"
    code = 18
else if head == "call"
    code = 19
else if head == "index"
    code = 20
else if head == "member"
    code = 21
else if head == "lambda"
    code = 22
else if head == "tuple"
    code = 23
else if head == "list"
    code = 24
else if head == "map"
    code = 25
else if head == "range"
    code = 26
else if head == "cast"
    code = 27
else if head == "is"
    code = 28
else if head == "not"
    code = 29
else if head == "and"
    code = 30
else if head == "or"
    code = 31
else if head == "pattern"
    code = 32
else if head == "catch"
    code = 33
else if head == "throw"
    code = 34
else if head == "finally"
    code = 35
else if head == "use"
    code = 36
else if head == "fn"
    code = 37
else if head == "type"
    code = 38
else if head == "style"
    code = 39
else if head == "content"
    code = 40
= code
