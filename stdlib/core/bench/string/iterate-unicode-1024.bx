; benchmark.meta description: Iterates fixed mixed-width Unicode with combining and non-BMP codepoints.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing,allocator,string-iteration
(blank)

(main
  (let unit "Aé漢😀é")
  (let source (++ (* unit 170) "Aé漢😀"))
  (let passes 1024)
  (let codepoints (as 0 Size))
  (let checksum (as 0 Size))
  (blank)
  (for (in pass (..< 0 passes))
    (for (in char source)
      (+= codepoints 1)
      (+= checksum (as char Size))
    )
  )
  (blank)
  (if (or (!= codepoints 1048576) (!= checksum 27688304640))
    (throw (call Panic "Unicode-1024 benchmark produced the wrong work"))
  )
  (blank)
  (probe-count string-iteration.benchmark-passes passes)
  (probe-count string-iteration.benchmark-codepoints codepoints)
  (probe-count string-iteration.benchmark-checksum checksum)
  (print (str "bench-result string/iterate-unicode-1024 checksum=" checksum))
)
