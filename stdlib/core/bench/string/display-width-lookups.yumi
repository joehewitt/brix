`benchmark.meta description: Repeats ASCII and mixed Unicode display-width lookups.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core

. ascii = DisplayText("terminal")
. mixed = DisplayText("a界é📁")
. checksum Size = 0
for index in 0 .. < 10000000
    checksum += ascii.width-at(index % ascii.codepoint-count)
    checksum += mixed.width-at(index % mixed.codepoint-count)
    if ascii.is-single-cell
        checksum += 1
    if mixed.is-single-cell
        checksum += 1

-- "bench-result string/display-width-lookups checksum=$checksum"
