`benchmark.meta description: Calls a door that wraps a C function in a hot loop, in a program that binds the door's effect elsewhere: each call outside the binding reads the effect's slot in the task's memory first.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/stdlib.h

. pass-count = 200000000 as I64
. checksum = 0 as I64

checksum += sum-magnitudes(pass-count)
do with bench-world = Fixed()
    checksum += sum-magnitudes(1)

-- "bench-result effects/door-bound-elsewhere checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ effect bench-world
    - C:labs

━━━━━━━━━━━━━━━━━━━━
_ do magnitude I64 @door(bench-world)
    - n I64

= C:labs(n)

━━━━━━━━━━━━━━━━━━━━
_ Fixed

────────────────────
+ do magnitude I64
    - n I64

= 1

━━━━━━━━━━━━━━━━━━━━
_ do sum-magnitudes I64
    - passes I64

. checksum = 0 as I64
. half = passes / 2
for index in 0 .. < passes
    checksum += magnitude(index - half)
= checksum
