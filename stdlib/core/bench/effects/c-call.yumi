`benchmark.meta description: Calls a C function directly in a hot loop, against which a call of a door that wraps it is measured.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/stdlib.h

. pass-count = 200000000 as I64
. checksum = 0 as I64

checksum += sum-magnitudes(pass-count)

-- "bench-result effects/c-call checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do sum-magnitudes I64
    - passes I64

. checksum = 0 as I64
. half = passes / 2
for index in 0 .. < passes
    checksum += C:labs(index - half)
= checksum
