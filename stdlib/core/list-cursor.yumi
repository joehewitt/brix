━━━━━━━━━━━━━━━━━━━━
+ ListCursor is Tuple

+ count Index
+ current Index?

────────────────────
+ stepped Index?
    - offset Int

|? count == 0
    null
|? current == null
    edge
|? target < 0 || target >= count as Int
    null
??
    target as Index

.. edge = if offset < 0 then count - 1 else 0
.. target = (current as Int) + offset

────────────────────
+ wrapped Index?
    - offset Int

|? count == 0
    null
|? current == null
    edge
??
    ((((current as Int) + offset) % total + total) % total) as Index

.. edge = if offset < 0 then count - 1 else 0
.. total = count as Int

────────────────────
+ clamped Index?
    - offset Int

|? count == 0
    null
|? current == null
    edge
|? target < 0
    0
|? target >= count as Int
    count - 1
??
    target as Index

.. edge = if offset < 0 then count - 1 else 0
.. target = (current as Int) + offset
