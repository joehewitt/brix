_ do markup-ensure-attachment
    - object MarkupElement

. object-pointer = object as Pointer

. existing = markup-attachment(object-pointer)
if existing
    = existing

. attachment = MarkupAttachment()
attachment.object-address = object-pointer.address as Size
attachment.host-witness-address = interface-witness-pointer(object).address as Size
attachment.retained-host = object
. published = gc-publish-object-side-payload
    - object-pointer
    - markup-attachment-lane() as Size
    - attachment
?! Panic("Unable to publish ordinary markup attachment")
    if published != attachment
object.markup-attachment-cache = attachment
= attachment

━━━━━━━━━━━━━━━━━━━━
_ do markup-use-cleanup-payload
    - attachment MarkupAttachment

=? if attachment.is-cleanup-payload

. object-pointer = attachment.object-pointer
. overflow = attachment.overflow
if overflow
    attachment.overflow = null
    . published-overflow = gc-publish-object-side-payload
        - object-pointer
        - markup-detached-overflow-lane() as Size
        - overflow
    ?! Panic("Unable to detach markup attachment overflow")
        if published-overflow != overflow
C:yumiGCClearObjectSidePayload(object-pointer, markup-attachment-lane())
attachment.retained-host = null
attachment.retained-store = null
. callback = markup-reclaim-attachment as GCManagedCleanupCallback
. payload = attachment as Pointer
. published = C:yumiGCPublishCleanupObjectSidePayload
    - object-pointer
    - markup-attachment-lane()
    - payload
    - callback
?! Panic("Unable to publish markup attachment cleanup")
    if published != payload
attachment.is-cleanup-payload = true

━━━━━━━━━━━━━━━━━━━━
_ do markup-use-ordinary-payload
    - attachment MarkupAttachment
    - owner MarkupElement

if attachment.is-cleanup-payload
    . cleanup-cleared = C:yumiGCClearCleanupObjectSidePayload
        - attachment.object-pointer
        - markup-attachment-lane()
    ?! Panic("Unable to clear markup attachment cleanup")
        if !cleanup-cleared
    attachment.is-cleanup-payload = false
    . overflow = gc-object-side-payload'MarkupAttachmentOverflow
        - attachment.object-pointer
        - markup-detached-overflow-lane() as Size
    if overflow
        C:yumiGCClearObjectSidePayload(attachment.object-pointer, markup-detached-overflow-lane())
        attachment.overflow = overflow
    if attachment.store-address != 0
        attachment.retained-store = gc-interface-from-pointer'MarkupRootElement
            - attachment.store-address as Pointer
            - attachment.store-witness-address as Pointer
    attachment.retained-host = owner
    . published = gc-publish-object-side-payload
        - attachment.object-pointer
        - markup-attachment-lane() as Size
        - attachment
    ?! Panic("Unable to publish ordinary markup attachment")
        if published != attachment
    =

attachment.retained-host = owner

