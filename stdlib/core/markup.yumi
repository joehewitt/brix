╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do enqueue-markup-batch-action

=? if is-closed
=? if state == 3
cause = markup-cause-current

if state == 2
    //markup.action.reenqueues ++
    state = 1
    queued-root = batch-root
    //markup.action.enqueues ++
    batch-root!.markup-batch-queue.enqueue(this)
    =
if state == 1
    if markup-batch-roots-match(queued-root, batch-root)
        //markup.action.dedupes ++
        =
    . old-root = queued-root
    if old-root
        old-root.markup-batch-queue.actions -= this

state = 1
queued-root = batch-root
//markup.action.enqueues ++
batch-root!.markup-batch-queue.enqueue(this)

────────────────────
+ do refresh-markup-batch-action

cause = markup-cause-current
state = 1
run-markup-batch-action(null)

────────────────────
_ do run-markup-batch-action
    - queued-for MarkupRootElement?

if queued-for
    =? if !markup-batch-roots-match(queued-root, queued-for)
    //markup.action.batch-runs ++
else
    //markup.action.immediate-runs ++

= run-markup-batch-action-now(queued-for != null)

────────────────────
_ do run-markup-batch-action-now
    - gated Bool

=? if is-closed
=? if state == 3

=? if state != 1

. outer = swap-markup-cause(cause)
do finally
    swap-markup-cause(outer)
    if state == 2
        state = 0
        queued-root = null

. runs = accepts-run && !markup-hold-action(this) && (!gated || should-run())
reset-notice()
if !runs
    state = 0
    queued-root = null
=? if !runs

state = 2
refresh-trackers()

if state == 2
    state = 0
    queued-root = null

= true

