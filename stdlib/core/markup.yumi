────────────────────
+ This
    - region
    - arm-builders
    - active-arm Index?

select-markup-branch(active-arm)

────────────────────
+ get selected-arm

active-arm

────────────────────
+ do select-markup-branch
    - arm Index?

live-enter-untracked()
do finally live-leave()
if arm != active-arm
    region.markup-branch-changing()
. leaving = List'Content()
for child in markup-region-children(region)
    leaving += child
. revived = arm != null && departed-arm == arm && revive-departed()
. departing = List'Content()
. is-whole = true
for child in leaving
    if markup-depart-child(region, child)
        departing += child
    else
        is-whole = false
departed = if is-whole then departing else List'Content()
departed-arm = active-arm if departed
active-arm = arm
if arm && !revived
    . index = arm
    arm-builders[index](region)

────────────────────
_ do revive-departed Bool

=? if !departed
for child in departed
    =? if !markup-is-departing(child)
. revived = true
for child in departed
    if !markup-revive-child(child)
        revived = false
= revived

