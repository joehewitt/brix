    - root MarkupRootElement

. settled = false
. pending-domain-mask U32
for settle in markup-batch-settle-hooks
    //+tui.frame.markup.settle
    . result = settle(root)
    //-tui.frame.markup.settle
    settled = settled || result.settled
    pending-domain-mask = pending-domain-mask /or/ result.pending-domain-mask

= MarkupBatchSettleResult(settled, pending-domain-mask)

━━━━━━━━━━━━━━━━━━━━
_ do markup-query-publish-target-id
    - target MarkupAttachment
    - target-id Size
    - is-added Bool

. target-host = target.host
=? if !markup-descendants-query-active

. cursor = target.mounted-parent
while cursor
    . ancestor = cursor
    //markup.query.target-adjusts ++
    . overflow = ancestor.overflow
    if overflow && overflow.descendants-queries
        . bindings = List'MarkupDescendantsQueryBinding(overflow.descendants-queries)
        //markup.query.binding-copies ++
        //markup.query.binding-copy-items += bindings.length
        for binding in bindings when binding.target-id == target-id
            if is-added
                . add = binding.add
                add(target-host)
            else
                . remove = binding.remove
                remove(target-host)
    . ancestor-host = ancestor.host
    if ancestor-host.markup-query-boundary
        break
    cursor = ancestor.mounted-parent

━━━━━━━━━━━━━━━━━━━━
_ do markup-query-publish-subtree
    - node MarkupElement
    - is-added Bool

. attachment = markup-attachment(node)
=? if !markup-descendants-query-active

=? if !attachment
=? if !attachment.store

//markup.query.publish-visits ++
markup-query-apply-subtree-targets(node, is-added)

━━━━━━━━━━━━━━━━━━━━
_ do markup-query-apply-subtree-targets
    - node MarkupElement
    - is-added Bool
    - binding MarkupDescendantsQueryBinding? = null

. attachment = markup-attachment(node)
=? if !attachment
=? if !attachment.store

//markup.query.publish-visits ++
if binding
    . live-binding = binding
    . target-id = live-binding.target-id
    . target-ids [Size]?
    if attachment.overflow
        . overflow = attachment.overflow
        target-ids = overflow.descendant-target-ids
    if target-ids && target-ids has target-id
        if is-added
            . add = live-binding.add
            add(node)
        else
            . remove = live-binding.remove
            remove(node)
    if node.markup-query-boundary
        =? if live-binding.owner as Pointer != node as Pointer
    . child = markup-structural-first-child-host(node)
    while child
        markup-query-apply-subtree-targets(child, is-added, live-binding)
        child = markup-structural-next-sibling-host(child)
    =
. overflow = attachment.overflow
if overflow && overflow.descendant-target-ids
    . ids = List'Size(overflow.descendant-target-ids)
    for target-id in ids
        markup-query-publish-target-id(attachment, target-id, is-added)

. child = markup-structural-first-child-host(node)
while child
    markup-query-apply-subtree-targets(child, is-added)
    child = markup-structural-next-sibling-host(child)

━━━━━━━━━━━━━━━━━━━━
_ do markup-query-seed-descendants-binding
    - owner MarkupAttachment
    - binding MarkupDescendantsQueryBinding

. owner-host = owner.host

. child = markup-structural-first-child-host(owner-host)
while child
    markup-query-apply-subtree-targets(child, true, binding)
    child = markup-structural-next-sibling-host(child)

━━━━━━━━━━━━━━━━━━━━
_ do markup-query-host-precedes
    - owner MarkupElement
    - left MarkupElement
    - right MarkupElement

. owner-attachment = markup-attachment(owner)
. left-attachment = markup-attachment(left)
. right-attachment = markup-attachment(right)
=? if !owner-attachment || !left-attachment || !right-attachment

. left-depth = markup-query-depth-from-owner(left-attachment, owner-attachment)
. right-depth = markup-query-depth-from-owner(right-attachment, owner-attachment)
=? if !left-depth || !right-depth

. original-left-depth = left-depth
. original-right-depth = right-depth
. left-live-depth = original-left-depth
. right-live-depth = original-right-depth
. left-cursor = left-attachment
. right-cursor = right-attachment

while left-live-depth > right-live-depth
    =? if !left-cursor.mounted-parent
    left-cursor = left-cursor.mounted-parent
    left-live-depth -= 1

while right-live-depth > left-live-depth
    =? if !right-cursor.mounted-parent
    right-cursor = right-cursor.mounted-parent
    right-live-depth -= 1

if left-cursor == right-cursor
    = original-left-depth < original-right-depth

while left-cursor.mounted-parent && right-cursor.mounted-parent && left-cursor.mounted-parent != right-cursor.mounted-parent
    left-cursor = left-cursor.mounted-parent
    right-cursor = right-cursor.mounted-parent

=? if !left-cursor.mounted-parent
=? if left-cursor.mounted-parent != right-cursor.mounted-parent

. sibling MarkupAttachment? = left-cursor
while sibling
    =? true
        if sibling == right-cursor
    sibling = sibling.next-sibling

= false

━━━━━━━━━━━━━━━━━━━━
_ do markup-query-depth-from-owner
    - attachment MarkupAttachment
    - owner MarkupAttachment

. depth Size = 0
. cursor MarkupAttachment? = attachment
while cursor
    . live = cursor
    if live == owner
        = depth
    depth += 1
    cursor = live.mounted-parent

━━━━━━━━━━━━━━━━━━━━
_ do markup-adopt-core
    - node MarkupElement
    - commit MarkupMountCommit
    - should-record-mounted Bool
    - parent MarkupElement?
    - root MarkupRootElement?

. should-walk = markup-apply-mount(node, commit, should-record-mounted, parent, root)
for hook in markup-mount-hooks
    if hook(node, parent, root)
        should-walk = true

if should-walk
    . child = markup-structural-first-child-host(node)
    while child
        markup-adopt-core(child, commit, should-record-mounted, node, root)
        child = markup-structural-next-sibling-host(child)

if !root && should-walk
    . attachment = markup-attachment(node)
    if attachment && !attachment.store
        markup-finish-unmount-attachment(attachment)

━━━━━━━━━━━━━━━━━━━━
_ do ensure-markup-root
    - node MarkupElement
    - root MarkupRootElement?

` Install root context for generated builders before child links are committed.

=? if !root

. batch = root
. attachment = markup-attachment(node)
if attachment && attachment.store
    . live = attachment
    . store = live.store!
    . root-pointer = batch as Pointer
    . store-pointer = store as Pointer
    =? if store-pointer == root-pointer

. commit = MarkupMountCommit()
markup-adopt-core(node, commit, false, null, root)

━━━━━━━━━━━━━━━━━━━━
_ do markup-attach-new-child'Host'Child
    - parent Host
    - child Child
    - anchor Child?
    - Host is MarkupParent
    - Child is MarkupElement

. parent-host = parent as MarkupElement
. root = markup-root-of(parent-host)
. commit = MarkupMountCommit()
. linked = false
. committed = false

markup-assert-structural-child-linkable(parent-host, child, anchor)
do finally
    if !committed
        catch markup-release(child)
        if linked
            markup-unlink-structural-child(parent-host, child)

markup-link-structural-child(parent-host, child, anchor)
linked = true
parent.markup-attach-child(child, anchor)
markup-adopt-core(child, commit, true, parent, root)
markup-query-publish-subtree(child, true)
committed = true
= commit

━━━━━━━━━━━━━━━━━━━━
_ do markup-batch-roots-match
    - left MarkupRootElement?
    - right MarkupRootElement?

if !left
    =? if right
    = true

=? if !right

. left-queue = left.markup-batch-queue as Pointer
. right-queue = right.markup-batch-queue as Pointer
= left-queue == right-queue

━━━━━━━━━━━━━━━━━━━━
_ do markup-region-children'Content [Content]
    - region Content
    - Content is MarkupParent'Content

. skips = (markup-attachment(region)?.departing-within ?? 1) > 0
. maybe-child = region.%first-child
if maybe-child
    . child = maybe-child
    while true
        if !skips || !markup-is-departing(child)
            <= child
        if !child.%next-sibling
            break
        child = child.%next-sibling!

━━━━━━━━━━━━━━━━━━━━
_ do markup-region-child-at'Content Content?
    - region Content
    - index Index
    - Content is MarkupParent'Content

. skips = (markup-attachment(region)?.departing-within ?? 1) > 0
. cursor = region.%first-child
. current Index = 0
while cursor
    if !skips || !markup-is-departing(cursor)
        if current == index
            = cursor
        current += 1
    cursor = cursor.%next-sibling

━━━━━━━━━━━━━━━━━━━━
_ do markup-region-follows'Content Bool
    - child Content
    - anchor Content?
    - Content is MarkupParent'Content

. cursor = child.%next-sibling
while cursor && markup-is-departing(cursor)
    cursor = cursor.%next-sibling
=? !cursor
    if !anchor
=? if !cursor
= cursor as Pointer == anchor as Pointer

━━━━━━━━━━━━━━━━━━━━
_ do markup-region-clear-children'Content
    - region Content
    - Content is MarkupParent'Content

` Departs each child a region shows. A child closes its events when it closes, so that what
` subscribes to an element a region no longer shows hears nothing more of it, whether or not the
` element's own class declares the events.
. children = List'Content()
for child in markup-region-children(region)
    children += child
for child in children
    markup-depart-child(region, child)

━━━━━━━━━━━━━━━━━━━━
_ do markup-depart-child'Host'Child Bool
    - parent Host
    - child Child
    - finished Doer? = null
    - Host is MarkupParent
    - Child is MarkupElement

. leaves = child.markup-depart()
. attachment = markup-attachment(child)
if attachment && (leaves || attachment.departing-within)
    . finish Doer = => do
        if markup-links(parent, child)
            markup-finish-child(parent, child)
        if finished
            finished()
    attachment.overflow-for-write().departure = MarkupDeparture(finish, leaves)
    markup-departures += 1
    markup-shift-departing(attachment.structural-parent, 1, true)
    = true
markup-finish-child(parent, child)
= false

━━━━━━━━━━━━━━━━━━━━
_ do markup-revive-child Bool
    - child MarkupElement

. attachment = markup-attachment(child)
=? if !attachment || !attachment.departure
. ancestor = attachment.structural-parent
while ancestor
    =? if ancestor.departure
    ancestor = ancestor.structural-parent
attachment.overflow-for-write().departure = null
markup-departures -= 1
markup-shift-departing(attachment.structural-parent, 1, false)
child.markup-revive()
markup-resume-actions(attachment)
= true

━━━━━━━━━━━━━━━━━━━━
_ do markup-hold-action Bool
    - action MarkupBatchAction

. owner = action.structural-owner ?? action.batch-owner
=? false if !owner
. attachment = markup-attachment(owner)
=? false if !attachment
. holder = if attachment.is-released then attachment else markup-departing-attachment(attachment)
=? false if !holder
=? true if action.is-held
action.is-held = true
. overflow = holder.overflow-for-write()
if !overflow.held-actions
    overflow.held-actions = List'MarkupBatchAction()
overflow.held-actions! += action
= true

━━━━━━━━━━━━━━━━━━━━
_ do markup-departing-attachment MarkupAttachment?
    - attachment MarkupAttachment

=? null if markup-departures == 0
. cursor MarkupAttachment? = attachment
while cursor
    =? cursor if cursor.departure
    cursor = cursor.structural-parent
= null

━━━━━━━━━━━━━━━━━━━━
_ do markup-resume-actions
    - attachment MarkupAttachment

. overflow = attachment.overflow
=? if !overflow
. held = overflow.held-actions
=? if !held
overflow.held-actions = null
for action in held
    action.is-held = false
    if !action.is-closed
        action()

━━━━━━━━━━━━━━━━━━━━
_ do markup-finish-child'Host'Child
    - parent Host
    - child Child
    - Host is MarkupParent
    - Child is MarkupElement

. weight = markup-departure-weight(child)
markup-unlink-structural-child(parent, child)
parent.markup-detach-child(child)
markup-release(child)
markup-close-child(child)
event-close-owner(child as Pointer)
if weight
    markup-settle-departures(markup-attachment(parent as MarkupElement))

━━━━━━━━━━━━━━━━━━━━
_ do markup-close-child'Child
    - child Child
    - Child is MarkupElement

. attachment = markup-attachment(child)
if attachment
    attachment.is-closed = true
child.close()

━━━━━━━━━━━━━━━━━━━━
_ do markup-links Bool
    - parent MarkupElement
    - child MarkupElement

. parent-attachment = markup-attachment(parent)
. child-attachment = markup-attachment(child)
=? if !parent-attachment || !child-attachment
= child-attachment.structural-parent == parent-attachment

━━━━━━━━━━━━━━━━━━━━
_ do markup-end-departure
    - attachment MarkupAttachment

. departure = attachment.departure
=? if !departure
departure.finish()
    catch error Error
        unhandled-error(error)
attachment.overflow-for-write().departure = null
markup-departures -= 1
markup-resume-actions(attachment)

━━━━━━━━━━━━━━━━━━━━
_ do markup-departure-weight Size
    - host MarkupElement

. attachment = markup-attachment(host)
=? 0
    if !attachment
. weight = attachment.departing-within
if attachment.departure
    weight += 1
= weight

━━━━━━━━━━━━━━━━━━━━
_ do markup-shift-departing
    - start MarkupAttachment?
    - count Size
    - adds Bool

=? if !count
. cursor = start
while cursor
    . overflow = cursor.overflow-for-write()
    if adds
        overflow.departing-within += count
    else
        overflow.departing-within -= count
    cursor = cursor.structural-parent

━━━━━━━━━━━━━━━━━━━━
_ do markup-settle-departures
    - start MarkupAttachment?

. cursor = start
while cursor
    =? if cursor.departing-within
    . departure = cursor.departure
    if departure
        if !departure.is-host-leaving
            markup-end-departure(cursor)
        =
    cursor = cursor.structural-parent
