overflow-for-write().region-controller = controller

────────────────────
+ do set-theme-tags
    - on U64
    - off U64

=? if !overflow && on == 0 && off == 0
. held = overflow-for-write()
held.theme-tags-on = on
held.theme-tags-off = off

────────────────────
_ do set-store
    - store MarkupRootElement

if is-cleanup-payload
    retained-store = null
else
    retained-store = store
store-address = (store as Pointer).address as Size
store-witness-address = interface-witness-pointer(store).address as Size

────────────────────
_ do clear-store

retained-store = null
store-address = 0
store-witness-address = 0

────────────────────
_ do overflow-for-write

if !overflow
    overflow = MarkupAttachmentOverflow()
= overflow!

