    - node MarkupElement
    - attachment MarkupAttachment
    - commit MarkupMountCommit
    - should-record-mounted Bool

=? if !should-record-mounted
=? if attachment.mounted-callback-fired

attachment.mounted-callback-fired = true
commit.record-mounted(node)

━━━━━━━━━━━━━━━━━━━━
_ do markup-update-parent
    - attachment MarkupAttachment
    - commit MarkupMountCommit
    - should-record-mounted Bool
    - parent MarkupElement?

. store = attachment.store!
. previous-parent = attachment.mounted-parent
. next-parent = markup-parent-attachment(store, parent)

if previous-parent == next-parent
    . host = attachment.host
    markup-record-mounted-callback(host, attachment, commit, should-record-mounted)
    =
if previous-parent
    attachment.mounted-parent = null

if next-parent
    attachment.mounted-parent = next-parent

if markup-ancestor-query-active
    markup-refresh-ancestor-queries-in-subtree(attachment.host)

. host = attachment.host
markup-record-mounted-callback(host, attachment, commit, should-record-mounted)

━━━━━━━━━━━━━━━━━━━━
_ do markup-unmount-attachment
    - attachment MarkupAttachment

. store = attachment.store
=? if !store

. host = attachment.host
markup-use-ordinary-payload(attachment, host)

attachment.clear-store()
attachment.mounted-parent = null
attachment.mounted-callback-fired = false
markup-refresh-ancestor-queries(attachment)

host.unmounted()
attachment.is-released = true

━━━━━━━━━━━━━━━━━━━━
_ do markup-finish-unmount-attachment
    - attachment MarkupAttachment

=? if attachment.store

attachment.mounted-parent = null

━━━━━━━━━━━━━━━━━━━━
_ do markup-apply-mount
    - node MarkupElement
    - commit MarkupMountCommit
    - should-record-mounted Bool
    - parent MarkupElement?
    - root MarkupRootElement?

. node-pointer = node as Pointer
. existing = markup-attachment(node-pointer)

if !root
    if existing && existing.store
        markup-unmount-attachment(existing)
        = true
    = false

. batch = root
. root-pointer = batch as Pointer
if existing && existing.store
    . live = existing
    . live-store = live.store!
    . live-root-pointer = live-store as Pointer
    if live-root-pointer != root-pointer
        markup-unmount-attachment(live)
        = markup-mount-attachment(node, commit, should-record-mounted, batch, parent)
    markup-update-parent(live, commit, should-record-mounted, parent)
    = false

= markup-mount-attachment(node, commit, should-record-mounted, batch, parent)

