────────────────────
+ do rebuild-keyed

=? if !is-keyed

. count = items.item-count
. old-keys = keys
. old-rows = rows
. old-children = List'Content()
for child in markup-region-children(region)
    old-children += child
. old-count Index = old-children.length

if !old-count
    mount-all(count)
    =
if markup-keyed-linear-scan-limit > old-count
    . has-reuse = false
    for item-index in 0 .. < count
        //keyed.collection.key-builds ++
        . key = items.item-key(item-index)
        for old-key in old-keys
            //keyed.collection.equality-comparisons ++
            if old-key == key
                has-reuse = true
                break
        if has-reuse
            break

    if !has-reuse
        depart-rows(old-children, old-keys, old-rows)
        mount-all(count)
        =
    keys = List'String()
    rows = List'MarkupRow()
    . old-used = List'Bool()
    for old-child in old-children
        old-used += false

    . next-children = List'Content()
    . next-reused = List'Bool()
    for item-index in 0 .. < count
        //keyed.collection.key-builds ++
        . key = items.item-key(item-index)
        . found Index?
        . candidate-index Index = 0
        for old-key in old-keys
            //markup.collection.keyed-small-scans ++
            //keyed.collection.equality-comparisons ++
            if old-key == key && !old-used[candidate-index]
                found = candidate-index
                break
            candidate-index += 1
        if found
            . found-index = found
            . row = old-rows[found-index]
            items.rebind-row(row, item-index)
            rows += row
            next-children += old-children[found-index]
            next-reused += true
            old-used[found-index] = true
        else
            build-or-reclaim(key, item-index, next-children, next-reused)
        keys += key

    . index Index = 0
    for old-child in old-children
        if !old-used[index]
            depart-row(old-child, old-keys[index], old-rows[index])
        index += 1
    place(next-children, next-reused)
    =
. no-index = old-count
. old-next = List'Index()
for old-child in old-children
    old-next += no-index

. old-heads = Map'String'MarkupKeyedRowHead()
. old-index = old-count
while old-index > 0
    old-index -= 1
    . key = old-keys[old-index]
    //keyed.collection.map-probes ++
    . old-head = old-heads[key]
    if old-head
        old-next[old-index] = old-head.index
        old-head.index = old-index
    else
        old-next[old-index] = no-index
        old-heads[key] = MarkupKeyedRowHead(old-index)

. has-reuse = false
for item-index in 0 .. < count
    //keyed.collection.key-builds ++
    . key = items.item-key(item-index)
    //keyed.collection.map-probes ++
    . old-head = old-heads[key]
    if old-head && old-head.index < no-index
        has-reuse = true
        break

if !has-reuse
    depart-rows(old-children, old-keys, old-rows)
    mount-all(count)
    =
keys = List'String()
rows = List'MarkupRow()
. next-children = List'Content()
. next-reused = List'Bool()
for item-index in 0 .. < count
    //keyed.collection.key-builds ++
    . key = items.item-key(item-index)
    //keyed.collection.map-probes ++
    . old-head = old-heads[key]
    if old-head && old-head.index < no-index
        . reuse-index = old-head.index
        . row = old-rows[reuse-index]
        items.rebind-row(row, item-index)
        rows += row
        next-children += old-children[reuse-index]
        next-reused += true
        old-head.index = old-next[reuse-index]
    else
        build-or-reclaim(key, item-index, next-children, next-reused)
    keys += key

for old-head in old-heads.values
    . unused-index = old-head.index
    while unused-index < no-index
        depart-row(old-children[unused-index], old-keys[unused-index], old-rows[unused-index])
        unused-index = old-next[unused-index]
place(next-children, next-reused)

