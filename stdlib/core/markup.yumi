    if candidate && candidate.store == store
        = candidate

━━━━━━━━━━━━━━━━━━━━
_ do markup-assert-structural-child-linkable
    - parent MarkupElement
    - child MarkupElement
    - anchor MarkupElement?

. child-attachment = markup-attachment(child)
?! Panic("Markup child was closed by the markup that embedded it and cannot be embedded again")
    if child-attachment && markup-was-closed(child-attachment)
?! Panic("Markup child is already linked")
    if child-attachment && (child-attachment.structural-parent || child-attachment.previous-sibling || child-attachment.next-sibling)

if anchor
    . parent-attachment = markup-attachment(parent)
    . anchor-attachment = markup-attachment(anchor)
    ?! Panic("Markup anchor is not linked under parent")
        if !parent-attachment || !anchor-attachment || anchor-attachment.structural-parent != parent-attachment

━━━━━━━━━━━━━━━━━━━━
_ do markup-was-closed Bool
    - attachment MarkupAttachment

. cursor MarkupAttachment? = attachment
while cursor
    =? true if cursor.is-closed
    cursor = cursor.structural-parent
= false

━━━━━━━━━━━━━━━━━━━━
_ do markup-link-structural-child
    - parent MarkupElement
    - child MarkupElement
    - anchor MarkupElement?

. parent-attachment = markup-ensure-attachment(parent)
markup-use-ordinary-payload(parent-attachment, parent)

. child-attachment = markup-ensure-attachment(child)
markup-use-ordinary-payload(child-attachment, child)

?! Panic("Markup child is already linked")
    if child-attachment.structural-parent || child-attachment.previous-sibling || child-attachment.next-sibling

if anchor
    . anchor-attachment = markup-attachment(anchor)
    ?! Panic("Markup anchor is not linked under parent")
        if !anchor-attachment || anchor-attachment.structural-parent != parent-attachment

    . previous = anchor-attachment.previous-sibling
    child-attachment.structural-parent = parent-attachment
    child-attachment.previous-sibling = previous
    child-attachment.next-sibling = anchor-attachment
    anchor-attachment.previous-sibling = child-attachment
    if previous
        previous.next-sibling = child-attachment
    else
        parent-attachment.first-child = child-attachment
else
    . previous = parent-attachment.last-child
    child-attachment.structural-parent = parent-attachment
    child-attachment.previous-sibling = previous
    if previous
        previous.next-sibling = child-attachment
    else
        parent-attachment.first-child = child-attachment
    parent-attachment.last-child = child-attachment

markup-shift-departing(parent-attachment, markup-departure-weight(child), true)

━━━━━━━━━━━━━━━━━━━━
_ do markup-unlink-structural-child
    - parent MarkupElement
    - child MarkupElement

. parent-attachment = markup-attachment(parent)
. child-attachment = markup-attachment(child)
=? if !parent-attachment
=? if !child-attachment
=? if child-attachment.structural-parent != parent-attachment

. previous = child-attachment.previous-sibling
. next = child-attachment.next-sibling

if previous
    previous.next-sibling = next
else
    parent-attachment.first-child = next

if next
    next.previous-sibling = previous
else
    parent-attachment.last-child = previous

child-attachment.structural-parent = null
child-attachment.previous-sibling = null
child-attachment.next-sibling = null
markup-shift-departing(parent-attachment, markup-departure-weight(child), false)

if !parent-attachment.first-child && !parent-attachment.mounted-parent
    if parent-attachment.mounted-callback-fired && parent-attachment.store
        . store-pointer = parent-attachment.store! as Pointer
        if parent as Pointer != store-pointer
            markup-use-cleanup-payload(parent-attachment)

