    rows += mount-keyed-row(key, item-index, null)
    keys += key

────────────────────
_ do mount-keyed-row MarkupRow
    - key String
    - item-index Index
    - anchor Content?

. departed-row = reclaim(key, item-index)
if departed-row
    markup-move(region, departed-row.child, anchor)
    = departed-row.row
. row = items.item-row(item-index)
markup-insert(region, items.build-row(row), anchor)
//keyed.collection.mounts ++
= row

────────────────────
_ do depart-row
    - child Content
    - key String
    - row MarkupRow

. forget Doer = => do
    forget-departed(child)
if markup-depart-child(region, child, forget)
