+ do insert-range
    - index Index
    - count Size

. offset Index = 0
while offset < count
    . row-index = index + offset
    if is-keyed
        . key = items.item-key(row-index)
        rows.insert
            - mount-keyed-row(key, row-index, markup-region-child-at(region, row-index))
            - row-index
        keys.insert(key, row-index)
    else
        . anchor Content?
        if row-index < unkeyed-row-hosts.length
            anchor = unkeyed-row-hosts[row-index]
        . child = items.build-item(row-index)
        unkeyed-row-hosts.insert(child, row-index)
        markup-insert(region, child, anchor)
    offset += 1

────────────────────
+ do append-range
    - index Index
    - count Size

. offset Index = 0
while offset < count
    . row-index = index + offset
    if is-keyed
        . key = items.item-key(row-index)
        rows += mount-keyed-row(key, row-index, null)
        keys += key
