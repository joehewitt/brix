_ do markup-mount-attachment
    - node MarkupElement
    - commit MarkupMountCommit
    - should-record-mounted Bool
    - root MarkupRootElement
    - parent MarkupElement?

. node-pointer = node as Pointer
. attachment = markup-ensure-attachment(node)
. store = markup-root-store(root, node-pointer)
=? if !store

. live-store = store
. root-pointer = root as Pointer
if node-pointer != root-pointer && !parent && should-record-mounted && !attachment.first-child
    markup-use-cleanup-payload(attachment)
else
    markup-use-ordinary-payload(attachment, node)
attachment.set-store(live-store)

attachment.mounted-parent = null
. parent-attachment = markup-parent-attachment(live-store, parent)
if parent-attachment
    attachment.mounted-parent = parent-attachment

markup-refresh-ancestor-queries(attachment)
markup-record-mounted-callback(node, attachment, commit, should-record-mounted)
attachment.is-released = false
markup-resume-actions(attachment)
= true

