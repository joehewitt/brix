    markup-close-child(child)
    offset += 1

. anchor Content?
if index + count < unkeyed-row-hosts.length
    anchor = unkeyed-row-hosts[index + count]

offset = 0
while offset < count
    . row-index = index + offset
    . child = items.build-item(row-index)
    unkeyed-row-hosts[row-index] = child
    markup-insert(region, child, anchor)
