_ do markup-refresh-ancestor-queries
    - attachment MarkupAttachment

. changed = false
if !markup-ancestor-query-active
    = changed

. overflow = attachment.overflow
if overflow && overflow.ancestor-queries
    for refresh in overflow.ancestor-queries
        if refresh()
            changed = true
= changed

━━━━━━━━━━━━━━━━━━━━
_ do markup-refresh-ancestor-queries-in-subtree Bool
    - node MarkupElement

. changed = false
if !markup-ancestor-query-active
    = changed

. attachment = markup-attachment(node)
if attachment && attachment.store
    changed = markup-refresh-ancestor-queries(attachment) || changed

. child = markup-structural-first-child-host(node)
while child
    changed = markup-refresh-ancestor-queries-in-subtree(child) || changed
    child = markup-structural-next-sibling-host(child)

= changed

