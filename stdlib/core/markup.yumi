────────────────────
_ do reclaim MarkupDepartedRow'Content?
    - key String
    - item-index Index

. index Index = 0
while index < departed.length
    . entry = departed[index]
    if entry.key == key || !markup-is-departing(entry.child)
        departed.remove(index, 1)
        if entry.key == key && markup-revive-child(entry.child)
            items.rebind-row(entry.row, item-index)
            = entry
    else
        index += 1

────────────────────
_ do place
    - children [Content]
    - reused [Bool]

. anchor Content?
. cursor = children.length
while cursor > 0
    cursor -= 1
    . child = children[cursor]
    if reused[cursor]
        if !markup-region-follows(child, anchor)
            markup-move(region, child, anchor)
            //keyed.collection.moves ++
    else
        markup-insert(region, child, anchor)
    anchor = child

────────────────────
_ do build-or-reclaim
    - key String
    - item-index Index
    - next-children [Content]
    - next-reused [Bool]

. departed-row = reclaim(key, item-index)
if departed-row
    rows += departed-row.row
    next-children += departed-row.child
    next-reused += true
    =
. row = items.item-row(item-index)
rows += row
next-children += items.build-row(row)
next-reused += false
//keyed.collection.mounts ++

