+ MarkupBatchQueue

+ root MarkupRootElement?
+ actions [MarkupBatchAction]
+ max-actions-per-checkpoint Size = 4096
+ max-passes-per-checkpoint Size = 16

_ is-scheduled = false
_ is-flushing = false
_ should-settle-on-flush = false
_ max-depth Size = 0
_ probed-max-depth Size = 0

────────────────────
+ This
    - root

────────────────────
+ get is-active

is-flushing

────────────────────
+ do enqueue
    - action MarkupBatchAction

actions += action
//markup.batch.enqueues ++
if actions.length > max-depth
    max-depth = actions.length
    //markup.batch.max-depth += max-depth - probed-max-depth
    probed-max-depth = max-depth
schedule(false)

────────────────────
+ do schedule
    - should-settle Bool = true

if should-settle
    should-settle-on-flush = true

=? if is-scheduled
=? if is-flushing

is-scheduled = true
do new @priority
    is-scheduled = false
    ` Scheduled flushes have no caller to receive action errors.
    catch flush()

────────────────────
+ do checkpoint

flush()

────────────────────
_ do flush

=? if is-flushing

//+tui.frame.markup.flush
is-flushing = true
do finally
    is-flushing = false

. applied Size = 0
. passes Size = 0
. settled = false
. pending-domain-mask U32
. should-settle = should-settle-on-flush && root != null
should-settle-on-flush = false
while (actions || should-settle) && applied < max-actions-per-checkpoint && passes < max-passes-per-checkpoint
    //+tui.frame.markup.actions
    . pass-applied Size = 0
    if actions
        passes += 1
        order-structural-actions-first()
        . pass-count = actions.length
        . processed Size = 0
        . scanned = pass-count
        . reshaped = List'MarkupAttachment()
        . deferred = List'MarkupBatchAction()
        while processed < pass-count && processed < actions.length && applied < max-actions-per-checkpoint
            . action = actions[processed]
            processed += 1
            if reshaped && markup-action-is-reshaped(action, reshaped)
                deferred += action
                continue
            if action.run-markup-batch-action(root)
                applied += 1
                pass-applied += 1
            while scanned < actions.length
                . queued = actions[scanned]
                scanned += 1
                if queued.is-structural && queued.structural-owner
                    . attachment = markup-attachment(queued.structural-owner)
                    if attachment
                        reshaped += attachment
        if processed
            actions.slide(-processed)
        if deferred
            for action in actions
                deferred += action
            actions = deferred
    //-tui.frame.markup.actions

    . should-run-settle = should-settle || pass-applied != 0
    should-settle = false
    if root && should-run-settle
        . external-result = markup-settle-external-hooks(root)
        settled = settled || external-result.settled
        pending-domain-mask = pending-domain-mask /or/ external-result.pending-domain-mask
        should-settle = actions.length > 0
//tui.frame.markup.actions-applied += applied
//tui.frame.markup.passes += passes
//markup.batch.actions-applied += applied
//markup.batch.passes += passes

if root && (applied != 0 || settled)
    . flush = MarkupBatchFlush(applied, pending-domain-mask)
    //+tui.frame.markup.did-flush
    root!.markup-batch-did-flush(flush)
    //-tui.frame.markup.did-flush

is-flushing = false

if actions
    if applied >= max-actions-per-checkpoint || passes >= max-passes-per-checkpoint
        //markup.batch.cap-hits ++
    schedule()
//-tui.frame.markup.flush

────────────────────
_ do order-structural-actions-first

. index Size = 0
. structural-count Size = 0
. seen-other = false
. needs-order = false
while index < actions.length
    if !actions[index].is-structural
        seen-other = true
    else
        structural-count += 1
        if seen-other
            needs-order = true
    index += 1
=? if !needs-order && structural-count < 2

. structural = List'MarkupBatchAction()
. depths = List'Size()
for action in actions
    if action.is-structural
        . depth = markup-host-depth(action.structural-owner)
        . slot = structural.length
        while slot > 0 && depths[slot - 1] > depth
            slot -= 1
        if slot != structural.length
            needs-order = true
        structural.insert(action, slot)
        depths.insert(depth, slot)
=? if !needs-order

for action in actions
    if !action.is-structural
        structural += action
actions = structural

