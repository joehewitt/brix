# A function may end on a match that must match: no arm matching is a panic, so the end is not in reach.

-- pick(Item.left(1))
-- pick(Item.right(2))

━━━━━━━━━━━━━━━━━━━━
+ Left is Tuple

+ value I32

━━━━━━━━━━━━━━━━━━━━
+ Right is Tuple

+ value I32

━━━━━━━━━━━━━━━━━━━━
+ Item is Union

| left Left
| right Right

━━━━━━━━━━━━━━━━━━━━
+ do pick Int
    - item Item

do match item
    | .left(row)
        if row.value == 1
            = 10
        = 11
    | .right(row)
        = 20

