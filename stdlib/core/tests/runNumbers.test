;====
:====
# Minimum and maximum numbers

-- get-min'I8() == I8.min
-- get-min'U8() == U8.min
-- get-max'I8() == I8.max
-- get-max'U8() == U8.max
-- ""
-- get-min'I16() == I16.min
-- get-min'U16() == U16.min
-- get-max'I16() == I16.max
-- get-max'U16() == U16.max
-- ""
-- get-min'I32() == I32.min
-- get-min'U32() == U32.min
-- get-max'I32() == I32.max
-- get-max'U32() == U32.max
-- ""
-- get-min'I64() == I64.min
-- get-min'U64() == U64.min
-- get-max'I64() == I64.max
-- get-max'U64() == U64.max
-- ""
-- -3.402823466e+38 == F32.min
-- 3.402823466e+38 == F32.max
-- ""
-- -1.7976931348623157e+308 == F64.min
-- 1.7976931348623157e+308 == F64.max
-- ""
-- false == Bool.min
-- true == Bool.max
-- ""
-- get-min'U32() == Char.min
-- get-max'U32() == Char.max

━━━━━━━━━━━━━━━━━━━━
_ do get-min'T

. min = T()
if T.is-signed
    min = min /or/ (T(1) /lshift/ (T.size * 8) - 1)
= min

━━━━━━━━━━━━━━━━━━━━
_ do get-max'T

. max = T()
. bits = (T.size * 8) - (if T.is-signed then 1 else 0)
for i in 0 .. < bits
    max = max /or/ (T(1) /lshift/ i)
= max

