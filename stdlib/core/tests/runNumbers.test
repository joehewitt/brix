:====
# F32 + F64 infers F64, so a global typed by inference before its initializer compiles keeps F64 precision.

-- describe(total)
-- total - 3.6

+ early = total-or-zero(false)
+ small F32 = 1.5
+ large F64 = 2.1
+ total = small + large

━━━━━━━━━━━━━━━━━━━━
+ do total-or-zero F64
    - wanted Bool

if wanted
    = total
= 0.0

━━━━━━━━━━━━━━━━━━━━
+ describe String
    - x F32

"F32 $x"

━━━━━━━━━━━━━━━━━━━━
+ describe String
    - x F64

"F64 $x"

