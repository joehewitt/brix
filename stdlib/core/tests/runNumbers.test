# A signed number compares with an unsigned one by its sign first, so a negative literal need not fit.

-- -1 < 4000000000u32
-- -1 == 4294967295u32
-- -1 != 4294967295u32
-- -1 < 18446744073709551615
-- 4000000000u32 > -1
-- -1 <= 0u8
-- 0u64 >= -5

