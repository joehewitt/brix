━━━━━━━━━━━━━━━━━━━━
+ do check-order'L'R
    - left L
    - right R
    - order I32

. valid = (left == right) == (order == 0) && (right == left) == (order == 0)
valid = valid && (left != right) == (order != 0) && (right != left) == (order != 0)
valid = valid && (left < right) == (order < 0) && (right > left) == (order < 0)
valid = valid && (left <= right) == (order <= 0) && (right >= left) == (order <= 0)
valid = valid && (left > right) == (order > 0) && (right < left) == (order > 0)
valid = valid && (left >= right) == (order >= 0) && (right <= left) == (order >= 0)
if !valid
    -- "comparison failed: $left $right $order"

