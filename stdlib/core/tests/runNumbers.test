:====
# Unsuffixed integer literals retain their exact written values across default and annotated types.

. annotated-negative I64 = -2147483649
. large-negative = -5000000000
. minimum-i64 I64 = -9223372036854775808
. annotated-u32 U32 = 3000000000

-- annotated-negative
-- large-negative
-- 3000000000
-- minimum-i64
-- -2147483648
-- -2147483649
-- 2147483647
-- 2147483648
-- 4294967295
-- 4294967296
-- annotated-u32

:----

-2147483649
-5000000000
3000000000
