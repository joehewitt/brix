# A narrow number read from memory, chosen from constants or computed keeps the value its type holds.

. bytes = Array'U8([0u8, 1u8, 127u8, 128u8, 200u8, 255u8])
. signed = Array'I8([-128i8, -1i8, 0i8, 127i8])
. shorts = Array'U16([0u16, 255u16, 256u16, 65535u16])
. signed-shorts = Array'I16([-32768i16, -1i16, 0i16, 32767i16])
. flags = Array'Bool([true, false])
for index in 0 .. < 6
    loaded-byte(bytes, index)
for index in 0 .. < 4
    loaded-signed-byte(signed, index)
for index in 0 .. < 4
    loaded-short(shorts, signed-shorts, index)
for index in 0 .. < 2
    loaded-flag(flags, index)
for index in 0 .. < 6
    chosen-byte(bytes, index)
summed-bytes(bytes)
. record = Narrow(200u8, -56i8, 65535u16, -2i16, true)
record-fields(record)

━━━━━━━━━━━━━━━━━━━━
+ Narrow is Struct

+ byte U8
+ signed I8
+ short U16
+ signed-short I16
+ flag Bool

━━━━━━━━━━━━━━━━━━━━
+ wrapped U8
    - x U8
    - y U8

x + y

━━━━━━━━━━━━━━━━━━━━
+ do loaded-byte
    - bytes Array'U8
    - index I64

. byte = bytes[index]
. wide = byte as I64
. sum = (byte + 100u8) as U8
. called = wrapped(byte, 100u8)
. narrowed = (wide * 3) as U8
. reinterpreted = byte as I8
-- "$byte: $wide ${sum as I64} ${called as I64} ${narrowed as I64} ${reinterpreted as I64} ${wide * 256 + (sum as I64)}"

━━━━━━━━━━━━━━━━━━━━
+ do loaded-signed-byte
    - signed Array'I8
    - index I64

. byte = signed[index]
. wide = byte as I64
. sum = (byte + 100i8) as I8
. unsigned = byte as U8
-- "$byte: $wide ${sum as I64} ${unsigned as I64} ${wide * 256}"

━━━━━━━━━━━━━━━━━━━━
+ do loaded-short
    - shorts Array'U16
    - signed-shorts Array'I16
    - index I64

. short = shorts[index]
. signed-short = signed-shorts[index]
. sum = (short + 1u16) as U16
. low = short as U8
. signed-low = signed-short as I8
-- "$short $signed-short: ${short as I64} ${signed-short as I64} ${sum as I64} ${low as I64} ${signed-low as I64}"

━━━━━━━━━━━━━━━━━━━━
+ do loaded-flag
    - flags Array'Bool
    - index I64

. flag = flags[index]
. taken = ""
if flag
    taken = "$taken flag"
if !flag
    taken = "$taken !flag"
if flag == flags[0]
    taken = "$taken ==first"
-- "$flag:$taken"

━━━━━━━━━━━━━━━━━━━━
+ do chosen-byte
    - bytes Array'U8
    - index I64

. constant = 100u8
. signed-constant = 100i8
. mixed = 7u8
. loaded = 3u8
if index > 2
    constant = 200u8
    signed-constant = -56i8
    mixed = (bytes[index] + 250u8) as U8
    loaded = bytes[index]
-- "$index: ${constant as I64} ${signed-constant as I64} ${mixed as I64} ${loaded as I64}"

━━━━━━━━━━━━━━━━━━━━
+ do summed-bytes
    - bytes Array'U8

. total = 0u8
. largest = 0u8
for byte in bytes
    total = (total + byte) as U8
    if byte > largest
        largest = byte
-- "${total as I64} ${largest as I64}"

━━━━━━━━━━━━━━━━━━━━
+ do record-fields
    - record Narrow

. taken = ""
if record.flag
    taken = " flag"
-- "${record.byte as I64} ${record.signed as I64} ${record.short as I64} ${record.signed-short as I64}$taken"
-- "${((record.byte + 100u8) as U8) as I64} ${((record.signed - 100i8) as I8) as I64} ${((record.short + 1u16) as U16) as I64}"

