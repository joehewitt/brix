+ do arithmetic'L'R
    - left L
    - right R

-- "${left + right} ${(type-of (left + right)).name}"
-- "${left - right} ${(type-of (left - right)).name}"
-- "${left * right} ${(type-of (left * right)).name}"
-- "${left / right} ${(type-of (left / right)).name}"
-- "${left % right} ${(type-of (left % right)).name}"

