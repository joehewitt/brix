_ Shape is Union

| String
| [String]

━━━━━━━━━━━━━━━━━━━━
_ chosen Shape
    - flag Bool

if flag then ["a", "b"] else "c"

━━━━━━━━━━━━━━━━━━━━
_ describe String
    - shape Shape

match shape
    | text String
        "text $text"
    | items [String]
        "items ${items.length}"

