;====
:====
# `else if` is tried where the branches before it are not taken, and `else` where none is.

. x = 5
if x == 1
    -- 1
else if x == 2
    -- 2
else if x == 5
    -- 5
else
    -- 0
if x > 9
    -- "big"
else
    -- "small"
-- "end"

:----

5
small
end
;====
:====
# A condition is a Bool, a number that is not zero, or a text that is not empty.

. n = 3
. z = 0.0
. s = "a"
. e = ""
if n
    -- "number"
if z
    -- "zero"
else
    -- "no zero"
if 5u8
    -- "byte"
if s
    -- "text"
if e
    -- "empty"
else if !e
    -- "no text"
if s && !e
    -- "both"
if e || z
    -- "either"
else
    -- "neither"

:----

number
no zero
byte
text
no text
both
neither
;====
:====
# A local assigned in a branch keeps what the branch gave it.

. x = 3
if x > 1
    x = 10
    if x > 5
        x += 1
else
    x = 20
-- x

:----

11
