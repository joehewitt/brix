━━━━━━━━━━━━━━━━━━━━
+ do leave Int
    - way Int

. count = 0
while count < 3
    count += 1
    do finally
        -- "cleanup $count"
        if count == way
            ?! Panic("pass $count")
    if count == 1
        continue
    if count == 2
        break
if way == 4
    do finally
        ?! Panic("at the return")
    = 4
do
    do finally
        if way == 3
            ?! Panic("at the end of a block")
    -- "block"
= count

