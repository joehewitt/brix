# Ranges written as values: their ends, step and length, with a step written and counted down.

. len = 5
. span = 0 .. < len
-- span.start
-- span.end
-- span.increment
-- span.is-through
-- span.length
show(1 .. 3)
show(note(4) .. < note(9))
. wide = 2u64 .. 10u64
-- wide.length
. real = 0.5 .. 2.5
-- real.start
-- real.increment
. back = 9 .. 3
-- back.length
-- back[1]
. stepped = 0 .. 10 by 5
-- stepped.increment
-- stepped.length

