# Constructor where clauses that first read another property inside a branch still initialize
# that property on every path, evaluating its expression once.

. b = Labeled("width", "stroke")
-- "${b.label}|${b.key}"
. c = Labeled("width", "")
-- "${c.label}|${c.key}"
. d = Flagged("width", "stroke", true)
-- "${d.label}|${d.key}|${d.tag}|${d.note}|${d.wide}"
. e = Flagged("width", "", false)
-- "${e.label}|${e.key}|${e.tag}|${e.note}|${e.wide}"
. f = Computed("abc", "")
-- "${f.key}|${f.label}|${f.shout()}"
. g = Computed("abc", "zz")
-- "${g.key}|${g.label}|${g.shout()}"

━━━━━━━━━━━━━━━━━━━━
+ Labeled

+ key String
+ label String

────────────────────
+ This
    - label
    - name String

.. key = if name.length then name else label

━━━━━━━━━━━━━━━━━━━━
+ Flagged

+ key String
+ tag String
+ note String
+ wide Bool
+ label String

────────────────────
+ This
    - label
    - name String
    - flag Bool

.. key = if name.length then name else label
.. tag = if flag then label else "none"
.. note = if flag && label.length > 2 then "yes" else label
.. wide = !flag || label.length > 3

━━━━━━━━━━━━━━━━━━━━
+ Shouter is () String

━━━━━━━━━━━━━━━━━━━━
+ Computed

+ key String
+ label String
+ shouter Shouter

────────────────────
+ This
    - base String
    - name String

.. key = if name.length then name else label
.. label = compute(base)
.. shouter = =>
    "${label}!"

────────────────────
+ shout String

shouter()

━━━━━━━━━━━━━━━━━━━━
+ do compute String
    - value String

-- "compute $value"
= value + "-x"

:----

width|stroke
width|width
width|stroke|width|yes|true
width|width|none|width|true
compute abc
abc-x|abc-x|abc-x!
compute abc
zz|abc-x|abc-x!
