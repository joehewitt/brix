# A task that waits on a lazy property reads the value assigned while another task evaluated it, though that evaluation fails.

. box = Box()
. values = SyncBufferedChannel'Int()
do new
    . failed = catch? box.value
    if !failed
        values <- -1
do new
    . got = catch? box.value
    if got
        values <- got
do new
    box.value = 9
    box.gate.close()
-- <- values
-- <- values

━━━━━━━━━━━━━━━━━━━━
