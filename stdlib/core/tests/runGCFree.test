-- controlled-union-cycle()

━━━━━━━━━━━━━━━━━━━━
+ do controlled-union-cycle U64 @no-gc

. arena = Arena(8192)
do finally
    arena.release()
. rows = Table'Node(arena, 1)
rows.append(Node.small(1u32, 1u64, 2u32))
rows.reserve(8)
rows.append(Node.wide(2u32, 3u64, 4u32, 5u32))
rows.append(Node.small(3u32, 6u64, 7u32))

rows[0].lower(2u64)
rows[1].lower(3u64)
. extension-checksum = (rows[0].source-plus as U64) + rows[0].score() + rows[1].score()

match rows[1]
    | .small(small)
        small.value += 1u64
    | .wide(wide)
        wide.hot += 1u64
match rows[1]
    | .small(small)
        small.cold += 1u32
    | .wide(wide)
        wide.cold += 1u32

. live = rows[1]
rows[0] = live
. span = rows[0 .. < 2]
rows[1 .. < 3] = span

. snapshot Node = rows[1] as Node
. checksum = match snapshot
    | .small(small)
        small.value + (small.cold as U64)
    | .wide(wide)
        wide.hot + (wide.cold as U64) + (wide.other as U64)
rows.clear()
= checksum + extension-checksum

━━━━━━━━━━━━━━━━━━━━
+ Syntax is Tuple

+ source U32

━━━━━━━━━━━━━━━━━━━━
+ Small is Syntax

+ @hot value U64
+ cold U32

━━━━━━━━━━━━━━━━━━━━
+ Wide is Syntax

+ @hot hot U64
+ cold U32
+ other U32

━━━━━━━━━━━━━━━━━━━━
+ Node is Union

| small Small
| wide Wide

━━━━━━━━━━━━━━━━━━━━
+ extend Node

────────────────────
+ do lower
    - delta U64

match this
    | .small(small)
        small.lower(delta)
    | .wide(wide)
        wide.lower(delta)

────────────────────
+ score U64

match this
    | .small(small)
        small.value + (small.cold as U64)
    | .wide(wide)
        wide.hot + (wide.cold as U64) + (wide.other as U64)

━━━━━━━━━━━━━━━━━━━━
+ extend Small

────────────────────
+ do lower
    - delta U64

this.value += delta
this.cold += delta as U32
this.source += delta as U32

━━━━━━━━━━━━━━━━━━━━
+ extend Wide

────────────────────
+ do lower
    - delta U64

this.hot += delta
this.cold += delta as U32
this.source += delta as U32

━━━━━━━━━━━━━━━━━━━━
+ extend Syntax

────────────────────
+ get source-plus U64

this.source as U64

