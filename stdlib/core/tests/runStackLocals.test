# A spawned task reads the stack-local it captured, binds its own, and calls a reader inside
# and outside that binding.

+ @stack depth = 1

. done = Semaphore()
do new
    -- "task", depth
    do with depth = 7
        -- "inner", depth, peek()
    -- "after", depth, peek()
    done.post()
done.wait()

━━━━━━━━━━━━━━━━━━━━
+ do peek Int

= depth

:----

(task, 1)
(inner, 7, 7)
(after, 1, 1)
