# Lambdas made under different bindings hold the state each was made under, read directly
# and through a function, inside and outside a later binding.

+ @stack current = 5

. a Getter'Int?
. b Getter'Int?
do with current = 1
    a = => current
do with current = 2
    b = => read()
-- (a)()
-- (b)()
do with current = 3
    -- (a)()
    -- (b)()
-- current

