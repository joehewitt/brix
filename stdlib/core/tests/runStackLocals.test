# A binding in a loop is put back at each turn, and where the turn continues.

+ @stack depth = 0

for i in 0 .. < 3
    do with depth = i * 10
        if i == 1
            continue
        -- "in", depth, peek()
    -- "out", depth, peek()

━━━━━━━━━━━━━━━━━━━━
+ do peek Int

= depth

:----

(in, 0, 0)
(out, 0, 0)
(in, 20, 20)
(out, 0, 0)
