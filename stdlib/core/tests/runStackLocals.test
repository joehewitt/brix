# A spawned task's slot set for a call that panics is put back as it was before the call.

+ @stack depth = 1

. results SyncChannel'String
. o Base = Derived()
do with depth = 7
    do new
        do finally
            . p = recover()
            results <- "after ${p != null} ${o.read()}"
        boom()
-- <- results

━━━━━━━━━━━━━━━━━━━━
+ do boom

-- "boom sees ${depth}"
?! Panic("x")

━━━━━━━━━━━━━━━━━━━━
+ Base

────────────────────
+ do read String

= "base ${depth}"

━━━━━━━━━━━━━━━━━━━━
+ Derived is Base

────────────────────
+ do read String

= "derived ${depth}"

:----
boom sees 7
after true derived 1
