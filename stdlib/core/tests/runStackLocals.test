# A lambda called from a lambda made inside a do with is given nothing: it reads what it holds.
+ @stack depth = 1

. inner = => do
    for v in gen()
        -- "gen $v"
inner()
. outer Doer?
do with depth = 3
    outer = => do
        -- "outer $depth"
        inner()
(outer)()

