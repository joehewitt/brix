# A stack-local struct is bound and read inside and outside the binding, and by a function.

+ @stack where = Spot(1, "home")

-- where.x, where.label
do with where = Spot(2, "away")
    -- where.x, where.label
    show()
show()

━━━━━━━━━━━━━━━━━━━━
+ Spot is Struct

+ x Int
+ label String

━━━━━━━━━━━━━━━━━━━━
+ do show

-- "show", where.x, where.label

:----

(1, home)
(2, away)
(show, 2, away)
(show, 1, home)
