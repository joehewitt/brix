    -- "${0xD800 as Char}"
catch failure
    -- failure
do new
    -- "${0x110000 as Char}"
catch failure
    -- failure
do new
    -- Array'Char(["a"[0], 0xDC00 as Char, "b"[0]]).slice-string()
catch failure
    -- failure

