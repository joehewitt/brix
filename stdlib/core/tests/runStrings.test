# Arena String copies preserve the 16-byte String ABI, UTF-8 metadata, NUL termination, and
# ordinary String behavior while allocating only from the selected Arena.

/core/arena
/YuCore/YuCore.h
/YuCore/YuString.h
/string.h

. empty-arena = Arena(64)
. ascii-arena = Arena(64)
. scalar-arena = Arena(64)
. managed-before = C:yumiArenaManagedAllocationCount()
. empty = empty-arena.copy-string("")
. ascii = ascii-arena.copy-string("hello")
. scalars = scalar-arena.copy-string("Aé漢😀")
. managed-after = C:yumiArenaManagedAllocationCount()

-- empty == ""
-- empty.size
-- empty.length
-- C:yumiStringGetFlags(empty)
-- C:strlen(empty)
-- empty-arena.active-bytes
-- empty-arena.owns(empty as Pointer)
-- C:yumiStringHash(empty, empty.size) == C:yumiStringHash("", 0)
-- ascii == "hello"
-- ascii.size
-- ascii.length
-- C:yumiStringGetFlags(ascii)
-- C:strlen(ascii)
-- ascii-arena.active-bytes
-- ascii-arena.owns(ascii as Pointer)
-- C:yumiStringHash(ascii, ascii.size) == C:yumiStringHash("hello", 5)
-- scalars == "Aé漢😀"
-- scalars.size
-- scalars.length
-- C:yumiStringGetFlags(scalars)
-- C:strlen(scalars)
-- scalar-arena.active-bytes
-- scalar-arena.owns(scalars as Pointer)
-- C:yumiStringHash(scalars, scalars.size) == C:yumiStringHash("Aé漢😀", 10)
-- scalars[1 .. 2]
-- "copy=$scalars"
-- managed-after == managed-before

. checksum = 0 as Size
for char in scalars
    checksum += char as Size
-- checksum

empty-arena.release()
ascii-arena.release()
scalar-arena.release()

