# Arena codepoint-span materialization writes ordinary Strings directly from scalar arrays without
# creating a managed String.

/core/arena
/YuCore/YuCore.h
/YuCore/YuString.h
/string.h

. source = "zAé漢😀q".codepoints
. arena = Arena(64)
. managed-before = C:yumiArenaManagedAllocationCount()
. empty = source[0 .. < 0].slice-string(arena)
. scalars = source[1 .. < 5].slice-string(arena)
. managed-after = C:yumiArenaManagedAllocationCount()

-- empty == ""
-- empty.size
-- empty.length
-- C:yumiStringGetFlags(empty)
-- C:strlen(empty)
-- arena.owns(empty as Pointer)
-- scalars == "Aé漢😀"
-- scalars.size
-- scalars.length
-- C:yumiStringGetFlags(scalars)
-- C:strlen(scalars)
-- arena.owns(scalars as Pointer)
-- C:yumiStringHash(scalars, scalars.size) == C:yumiStringHash("Aé漢😀", 10)
-- scalars[1 .. 2]
-- "direct=$scalars"
-- managed-after == managed-before
-- arena.copy-span(source, 1, 5) == scalars
-- source[1 .. < 5].slice-string() == scalars
-- ("zAé漢😀q" as Byte[])[1 .. < 11].slice-string() == scalars
-- source[0 .. < 6].slice-string(1 .. < 5) == scalars
source[2] = 0 as Char
. truncated = source[1 .. < 5].slice-string(arena)
-- truncated == "A"
-- truncated.length == 1
-- C:yumiStringGetFlags(truncated) == 3
source[1] = 0 as Char
-- source[1 .. < 5].slice-string(arena) == ""
-- scalars == "Aé漢😀"

arena.release()

