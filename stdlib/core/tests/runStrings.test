# Arena codepoint-span materialization rejects reversed bounds.

/core/arena

. arena = Arena(64)
do finally
    arena.release()
. attempt = do new
    . source = "abc".codepoints
    . invalid = arena.copy-span(source, 2, 1)
catch failure
    -- "error: $failure"
attempt.wait()

