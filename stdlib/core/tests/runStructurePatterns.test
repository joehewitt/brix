# Nested sequence patterns narrow union-valued fields before typed element captures.

. choice [String = Payload]
choice["content"] = "hello"
. root [String = Payload]
root["choices"] = [choice as Payload]

. found = match? root
    | ["choices" = [first [String = Payload], ...], ...]
        first["content"]

-- found! as String

━━━━━━━━━━━━━━━━━━━━
+ Payload is Union

| String
| [Payload]
| [String = Payload]

