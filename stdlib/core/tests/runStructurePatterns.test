# match?, is, and declaration contexts use the same sequence profile.

. maybe = match? [1, 2, 3]
    | [1, ...tail]
        tail.length

-- type-of maybe
-- maybe ?? 0

-- [1, 2, 3] is [1, _, 3]
-- [1, 2] is [1, _, 3]

. [head, _, ...tail] = [10, 20, 30, 40]
-- head
-- tail

if | [_, second, ...rest] = [5, 6, 7, 8]
    -- second
    -- rest
else
    -- "no"

