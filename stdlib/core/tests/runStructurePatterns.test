;====
:====
# Map keys support string, numeric, and existing-key equality lookup forms.

. key = "b"
. settings = Map'String'Int()
settings["a"] = 1
settings["b"] = 2

. numeric = Map'Int'String()
numeric[7] = "seven"

-- match settings
    | [$key = two]
        "b=$two"
    ??
        "no"

-- match numeric
    | [7 = word]
        word
    ??
        "no"

-- settings is ["a" = 1, ...]
-- settings is ["a" = 9, ...]

if | ["b" = two, ...rest] = settings
    -- two
    -- rest["a"]
else
    -- "no"

:----
