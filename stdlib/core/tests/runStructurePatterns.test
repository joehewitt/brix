====================================================================================================
JOE-32 Map Patterns
====================================================================================================
:====
# Map patterns match required keys, allow extra entries, and reject missing or mismatched values.

. settings = Map'String'Int()
settings["a"] = 1
settings["b"] = 2
settings["c"] = 3

-- match settings
    | ["a" = one]
        "a=$one"
    ??
        "no"

-- match settings
    | ["missing" = value]
        "bad"
    ??
        "missing"

-- match settings
    | ["a" = 9]
        "bad"
    ??
        "mismatch"

-- match settings
    | ["a" = _, ...]
        "open"
    ??
        "closed"

:----
a=1
missing
mismatch
open
;====
:====
# Map remainder capture returns unmatched entries with the same key/value types.

. settings = Map'String'Int()
settings["a"] = 1
settings["b"] = 2
settings["c"] = 3

. rest = match settings
    | ["a" = _, ...tail]
        tail

-- type-of rest
-- rest.length
-- rest["a"]
-- rest["b"]
-- rest["c"]

:----
