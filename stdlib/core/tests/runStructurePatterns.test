====================================================================================================
JOE-32 Text Patterns
====================================================================================================
:====
# Text patterns match whole strings with anchored literals and optional captured gaps.

-- match "foobar"
    | "foo" ...middle "bar"
        middle.length
    ??
        99

-- match "fooxbar"
    | f "foo" ...middle b "bar"
        "$f|$middle|$b"
    ??
        "no"

-- match "foobaz"
    | "foo" ... "bar"
        "bad"
    ??
        "no"

:----
0
foo|x|bar
no
;====
:====
# Text matching is left-to-right and non-greedy while preserving later anchors.

-- match "fooafooend"
    | "foo" ...middle "fooend"
        middle
    ??
        "no"

-- match "foofooend"
    | "foo" ...middle "fooend"
        middle
    ??
        "no"

:----
a

;====
:====
# Text patterns participate in match?, is, and declaration contexts.

. maybe = match? "fooxbar"
    | "foo" ...middle "bar"
        middle

-- type-of maybe
-- maybe ?? "missing"

-- "fooxbar" is "foo" ... "bar"
-- "foobaz" is "foo" ... "bar"

. "foo" ...decl-middle "bar" = "foozbar"
-- decl-middle

if | "foo" ...if-middle "bar" = "fooybar"
    -- if-middle
else
    -- "no"

:----
[TypeInfo Optional'String]
x
true
false
z
y
