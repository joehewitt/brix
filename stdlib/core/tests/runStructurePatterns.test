# Table-backed Indexable objects use their concrete slice types too.

. table = Table'Point(3) • with Point((each + 1) as I32, (each + 10) as I32)
. rows = match table
    | [first, ...rest]
        rest

. xs = match table.x
    | [_, ...tail]
        tail

-- type-of rows
-- rows.length
-- rows[0] as Point
-- type-of xs
-- xs.length
-- ", ".join(xs)

