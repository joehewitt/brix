====================================================================================================
JOE-32 ImmutableArray Patterns
====================================================================================================
:====
# List patterns cover empty, exact slots, wildcard slots, bare rest, and captured rest.

. empty = List'Int()
. numbers = [1, 2, 3, 4]

-- match empty
    | []
        "empty"
    ??
        "not empty"

-- match numbers
    | [first, _, third, ...]
        "$first/$third"
    ??
        "no"

. middle = match numbers
    | [first, ...rest, last]
        rest

-- type-of middle
-- middle

-- match [1, 2]
    | [_, _, _]
        "bad"
    ??
        "short"

:----
empty
1/3
[TypeInfo List'I64'GCBacking]
2, 3
short
;====
:====
# Array patterns keep concrete slice types for captured remainders.

. values = Array'Int([10, 20, 30, 40])
. tail = match values
    | [head, ...rest]
        rest

-- type-of tail
-- tail.length
-- ", ".join(tail)

-- match values
    | [10, ..., 40]
        "edge"
    ??
        "miss"

-- match values
    | [10, 99, ...]
        "bad"
    ??
        "mismatch"

:----
[TypeInfo Array'I64]
3
20, 30, 40
edge
mismatch
