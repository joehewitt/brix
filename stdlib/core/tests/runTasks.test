# Cleanup in a cancelled task runs to completion

. gate = SyncBufferedChannel'Bool()
. ready = Semaphore()
. done = Semaphore()
. box = TaskBox()
do new
    box.task = Task()
    do finally
        . panic = Task().failure
        if panic
            -- "recovered $panic"
        done.post()
    do finally
        -- "cleanup: begin"
        . total = busy(2000)
        -- "cleanup: computed $total"
    ready.post()
    <- gate
    -- "unexpected resume"
ready.wait()
box.task!.cancel()
done.wait()
-- "done"

