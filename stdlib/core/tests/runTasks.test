+ do close
:----

left its own case
left by its own task: true
still running: true
cancelled by the next exit: true
left its own case
cancelled by close: true
closed its own object
closer cancelled by the next close: true
;====
:====
# A task terminated while it awaits a completion leaves it abandoned, and its cleanup runs to its
# end: the termination is raised once.

/time/duration

do new
    . completion = Completion'Int()
    do finally
        -- "abandoned: ${completion.is-abandoned}"
        . failure = Task().failure
        if failure
            -- "cleanup saw $failure.message"
        -- "cleanup done"
    completion.await()
    -- "unexpected resume"

50ms.wait()
request-process-termination(130)

:----
%crash

abandoned: true
cleanup saw Task terminated
cleanup done
;====
:====
# `cancel-later` cancels a task without yielding to it: the active task goes on, and the task ends
# at its wait once its turn comes.

. ready = Semaphore()
. task = do new
    do finally
        -- "worker cleanup"
    ready.post()
    Semaphore().wait()
    -- "unexpected resume"

ready.wait()
task.cancel-later()
-- "main goes on"
task.wait()
-- "cancelled: ${task.end == .cancelled}"

:----

main goes on
worker cleanup
cancelled: true
;====
:====
# A task that `cancel-later` cancels before it runs runs up to its first wait, and ends there.

. task = do new
    -- "runs up to its first wait"
    Semaphore().wait()
    -- "unexpected resume"

task.cancel-later()
task.wait()
-- "cancelled: ${task.end == .cancelled}"

:----

runs up to its first wait
cancelled: true
;====
