# A cancelled task ends at its wait, and a wait in one of its cleanups ends that cleanup; the next
# cleanup still runs, and the task's catch does not.

. ready = Semaphore()
. parked = do new
    do finally
        -- "outer cleanup saw ${Task().failure?.message ?? "nothing"}"
    do finally
        -- "inner cleanup begins"
        Semaphore().wait()
        -- "inner cleanup goes on"
    ready.post()
    Semaphore().wait()
    -- "parked goes on"
catch failure
    -- "catch ran: $failure.message"
