# A task a method starts is its object's. The object's close cancels it as close leaves, so the
# body of close may still use it, and close does not wait for it. A task marked @detached outlives
# the close.

. relay = Relay()
relay.start()
relay.close()
relay.worker!.wait()
-- "worker cancelled: ${relay.worker!.end == .cancelled}"
relay.gate.post()
relay.keeper!.wait()
-- "keeper finished: ${relay.keeper!.end == .finished}"

