.. z = y * 3
. done = Semaphore()

do new
    y = 2
    -- "first y=$y z=$z"
    done.post()
done.wait()
-- "main y=$y"

do new
    -- "second y=$y z=$z"
    done.post()
done.wait()
-- "end y=$y z=$z"

