# A task cancelled while it runs on a worker's threads still waits in full inside a later block
# without cancel.

. pool = Worker(2)
. entered = Semaphore()
. release = Semaphore()
. worker = do (pool) new
    . busy = spin(400000)
    do without cancel
        entered.post()
        release.wait()
        -- "worker got release ${busy > 0}"
    Semaphore().wait()
    -- "never"
worker.cancel()
entered.wait()
-- "main posts"
release.post()
worker.wait()
-- "cancelled: ${worker.end == .cancelled}"
pool.stop()

