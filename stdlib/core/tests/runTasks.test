# Shutdown ends a busy loop at its poll, once: the task's cleanup runs its own loop to the end and
# reads the termination.

. ready = Semaphore()
do new thread
    do finally
        -- "cleanup counted ${spin(1000)}"
        -- "cleanup saw ${Task().failure?.message ?? "nothing"}"
    ready.post()
    . count = 0
    while true
        count += 1
    -- "unexpected end"
ready.wait()
