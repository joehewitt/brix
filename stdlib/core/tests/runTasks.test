:====
# The catch after each task keeps its panic, and wait raises the first kept once every task has
# ended. settle waits the same way and leaves the panic for wait.

. pool = Worker(2)
. outer = do new
    . group = TaskGroup()
    . finished = [false, false, false]
    for index in 0 .. < 3
        . task = do (pool) new
            if index == 1
                ?! Panic("worker $index broke")
            finished[index] = true
        catch failed
            group.keep(failed)
        group.add(task)
    group.settle()
    -- "settled: ${", ".join("$each" in finished)}"
    group.wait()
    -- "not reached"
catch failure
    -- "caught: $failure.message"
outer.wait()
pool.stop()

