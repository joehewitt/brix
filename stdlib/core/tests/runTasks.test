# A task cancelled inside a do without cancel block runs the block to its end, waits included, and
# the cancellation ends it at its next wait after the block. Its handle shows the request at once.

. ready = Semaphore()
. release = Semaphore()
. worker = do new
    do finally
        -- "cleanup saw ${Task().failure?.message ?? "nothing"}"
    do without cancel
        ready.post()
        release.wait()
        -- "shielded wait finished"
    -- "after the block"
    Semaphore().wait()
    -- "never"
ready.wait()
worker.cancel()
-- "requested: ${worker.is-canceled}, in force: ${worker.is-cancel-in-force}"
release.post()
worker.wait()
-- "cancelled: ${worker.end == .cancelled}"

