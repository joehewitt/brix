# A task terminated while it takes a lock and gives it back does not end holding it, so its
# cleanup can take it.

. pool = Worker(1)
. ready = Semaphore()
. mutex = Mutex()
. count = 0

do (pool) new
    do finally
        mutex.lock()
        -- "cleanup took the lock"
        mutex.unlock()
    ready.post()
    while true
        do
            use mutex
            count += 1

ready.wait()
