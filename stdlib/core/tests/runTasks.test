# A wait inside a cancelled task's cleanup reports the cancellation, and the cleanups of
# the callers still run

. gate = SyncBufferedChannel'Bool()
. ready = Semaphore()
. done = Semaphore()
. box = TaskBox()
do new
    box.task = Task()
    do finally
        . panic = recover()
        if panic
            -- "outer: recovered $panic"
        done.post()
    middle(ready, gate)
ready.wait()
box.task!.cancel()
done.wait()
-- "done"

━━━━━━━━━━━━━━━━━━━━
