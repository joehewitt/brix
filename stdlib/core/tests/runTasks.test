────────────────────
+ flow ~>

~> idle
~> active on enter
    do
        worker = do new
            do finally
                -- "worker cleanup"
            entered.post()
            while true
                asked.wait()
                answered.post()
        do new @detached
            nested = do new
                entered.post()
                Semaphore().wait()
        . start = => do
            closure = do new
                entered.post()
                Semaphore().wait()
            = true
        . started = start()
        loose = do new @detached
            gate.wait()
            -- "detached ran after exit"
    for tick on ticks
        handler = do new
            entered.post()
            Semaphore().wait()
    ~> waiting
    ~> busy on inner
        do
            inner-task = do new
                entered.post()
                Semaphore().wait()
        then waiting on outer
    do finally
        asked.post()
        answered.wait()
        -- "exit rows used the worker"
        after = do new
            Semaphore().wait()
    then idle on leave

