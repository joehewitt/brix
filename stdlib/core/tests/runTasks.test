. ready = Semaphore()
. box = TaskBox()

do new @priority
    -- "priority start"
    box.parked = Task()
    ready.post()
    . parked = box.parked!
    if parked.suspend()
        ?! TaskCancelationError()
    -- "priority resumed"

ready.wait()

do new
    -- "normal pending"

. parked = box.parked!
parked.resume-later()
-- "main after resume"

