# A cancelled writer's message is withdrawn from an unbuffered channel

. numbers = SyncChannel'Int()
. ready = Semaphore()
. done = Semaphore()
. box = TaskBox()
do new
    box.task = Task()
    do finally
        . panic = recover()
        if panic
            -- "canceled writer"
        done.post()
    ready.post()
    numbers <- 1
    -- "unexpected write"
ready.wait()
box.task!.cancel()
done.wait()
do new
    numbers <- 2
. number = <- numbers
-- "read $number"

