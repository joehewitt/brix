# Blocks without cancel nest, and the inner block's end leaves the outer one's in place. A return
# from inside such a block leaves it too.

. gate = Semaphore()
. nested = do new
    do without cancel
        do without cancel
            gate.wait()
        -- "inner block ended"
        gate.wait()
        -- "outer block ended"
    gate.wait()
    -- "never"
nested.cancel()
gate.post()
gate.post()
nested.wait()
-- "nested cancelled: ${nested.end == .cancelled}"
. returner = do new
    -- "returned ${returns-early()}"
    Semaphore().wait()
    -- "never"
returner.cancel()
returner.wait()
-- "returner cancelled: ${returner.end == .cancelled}"

