# A task that leaves its own case, by sending what moves the machine, is not cancelled as it leaves:
# the case's next exit cancels it, or its object's close. A case's task that closes its own object
# goes on running, and the object's next close cancels it.

. runner = Runner()
runner.enter <- true
runner.entered.wait()
-- "left by its own task: ${runner.flow is .idle}"
-- "still running: ${runner.first!.end == .running}"
runner.enter <- true
runner.entered.wait()
runner.leave <- true
runner.first!.wait()
-- "cancelled by the next exit: ${runner.first!.end == .cancelled}"
runner.enter <- true
runner.entered.wait()
runner.close()
runner.third!.wait()
-- "cancelled by close: ${runner.third!.end == .cancelled}"
. closer = Closer()
closer.enter <- true
closer.entered.wait()
closer.close()
closer.worker!.wait()
-- "closer cancelled by the next close: ${closer.worker!.end == .cancelled}"

