# A TaskGroup waits for every task added to it.

. pool = Worker(2)
. group = TaskGroup()
. results = [0, 0, 0, 0]
for index in 0 .. < 4
    . task = do (pool) new
        results[index] = index * index
    catch failed
        group.keep(failed)
    group.add(task)
group.wait()
-- ", ".join("$each" in results)
pool.stop()

