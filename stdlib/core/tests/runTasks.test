# A panic a handler takes tells where it was raised, on what stack, and when.

. before = Panic("never raised")
-- "unraised: ${before.stack == null} ${before.raised-at == null}"
. task = do new
    fails()
catch failure
    . stack = failure.stack ?? ""
    -- "stack: ${stack.find("Stack trace:") != null} ${stack.find("__source__:fails") != null}"
    . at = failure.raised-at ?? 0
    -- "recent: ${at > 1700000000.0}"
task.wait()

