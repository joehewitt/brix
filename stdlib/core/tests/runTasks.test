    scratch-pool <- Arena()
for value in 0 .. < 128
    do (worker) new
        . scratch = (<- scratch-pool)!
        do finally
            scratch-pool <- scratch
        . buffer = scratch.allocate'Int(1)
        buffer[0] = value
        . resume SyncBufferedChannel'Bool
        do new
            resume <- true
        <- resume
        . copied = buffer[0]
        scratch.reset()
        output <- copied

. total = 0
for _ in 0 .. < 128
    total += (<- output)!
worker.stop()
scratch-pool.close()
for scratch in scratch-pool
    scratch.release()
-- total == 8128
-- C:yumiArenaRuntimeReservedBytes() == reserved-before

