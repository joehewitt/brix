# In a cleanup, a break, an error and a panic that leave a do without cancel block let go of its
# hold too.

. ready = Semaphore()
. looper = do new
    do finally
        for index in 0 .. < 3
            do without cancel
                if index == 1
                    break
        -- "after the break, in force: ${Task().is-cancel-in-force}"
        . failure = catch flush()
        -- "after the error ${failure is Error}, in force: ${Task().is-cancel-in-force}"
    do finally
        do without cancel
            ?! Panic("inside the block")
    ready.post()
    Semaphore().wait()
catch failed
    -- "caught: $failed.message"
ready.wait()
looper.cancel()
looper.wait()

