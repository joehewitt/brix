# A channel delivers to the next reader after a waiting reader is cancelled

. numbers = SyncBufferedChannel'Int()
. ready = Semaphore()
. done = Semaphore()
. box = TaskBox()
do new
    box.task = Task()
    do finally
        . panic = recover()
        if panic
            -- "canceled reader"
        done.post()
    ready.post()
    . number = <- numbers
    -- "unexpected read $number"
ready.wait()
box.task!.cancel()
done.wait()
numbers <- 7
. number = <- numbers
-- "read $number"

