# A cancelled task waiting for a process ends there, and takes its wait off the event loop, so the
# process exiting later resumes nothing.

/os/process

. ready = Semaphore()
. process = Process("sleep", ["5"])
. waiter = do new
    do finally
        -- "waiter cleanup saw ${Task().failure?.message ?? "nothing"}"
    ready.post()
    . status = process.wait(null)
    -- "waiter goes on with ${status ?? -1}"
ready.wait()
waiter.cancel()
waiter.wait()
-- "cancelled: ${waiter.end == .cancelled}"
process.kill()
-- "reaped: ${process.wait(null) != null}"

