;====
:====
# A task a state case starts in its entry rows, in a handler, or in a nested body of either belongs
# to the case's activation: its exit rows still use it, and it is cancelled as they end. An inner
# case's exit leaves the outer case's tasks. A task marked @detached is no one's, and one the exit
# rows start is the object's. Entering the case again makes a new activation, and an object's
# close leaves its machines, which cancels theirs.

. runner = Runner()
runner.enter <- true
for _ in 0 .. < 3
    runner.entered.wait()
runner.ticks <- 1
runner.entered.wait()
runner.inner <- true
runner.entered.wait()
runner.outer <- true
runner.inner-task!.wait()
-- "inner case's task cancelled: ${runner.inner-task!.end == .cancelled}"
-- "outer case's task running: ${runner.worker!.end == .running}"
runner.leave <- true
for task in [runner.worker!, runner.nested!, runner.closure!, runner.handler!]
    task.wait()
    -- "cancelled: ${task.end == .cancelled}"
runner.gate.post()
runner.loose!.wait()
-- "detached finished: ${runner.loose!.end == .finished}"
. lingering = runner.after!
-- "exit rows' task running: ${lingering.end == .running}"
runner.enter <- true
for _ in 0 .. < 3
    runner.entered.wait()
runner.close()
runner.worker!.wait()
-- "second worker cancelled by close: ${runner.worker!.end == .cancelled}"
lingering.wait()
-- "exit rows' task cancelled by close: ${lingering.end == .cancelled}"
runner.gate.post()
runner.loose!.wait()

━━━━━━━━━━━━━━━━━━━━
