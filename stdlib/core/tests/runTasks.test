# Posts that find no task waiting wait in turn, and so do waits that find no post: each wait takes one post, the first first, and lets that poster go on before it does.

. posts = Semaphore'Int()
do new
    posts.post(1)
    -- "first posted"
do new
    posts.post(2)
    -- "second posted"
. gate SyncBufferedChannel'Bool
do new
    gate <- true
<- gate
-- posts.await()
-- posts.await()

. waits = Semaphore'Int()
do new
    -- "first waiter got ${waits.await()}"
do new
    -- "second waiter got ${waits.await()}"
do new
    gate <- true
<- gate
waits.post(3)
waits.post(4)

