# A task started in a nested body of a method, a task's or a function value's, is the object's too.
# A task that closes its own object is not cancelled by that close, and a task started after a
# close is the object's until the next one.

. done = Semaphore()
. holder = Holder(done)
holder.start-nested()
holder.close()
done.wait()
done.wait()
-- "nested tasks cancelled"
holder.start-self-closing()
holder.task!.wait()
-- "self closer cancelled by the next close: ${holder.task!.end == .cancelled}"

