+ Runner

+ event enter Bool
+ event leave Bool
+ entered = Semaphore()
+ entries = 0
+ first Task?
+ third Task?

────────────────────
+ flow ~>

~> idle
~> active on enter
    do
        entries += 1
        . leaves = entries != 2
        . task = do new
            if leaves
                leave <- true
                -- "left its own case"
            entered.post()
            Semaphore().wait()
        if entries == 1
            first = task
        else if entries == 3
            third = task
    then idle on leave

