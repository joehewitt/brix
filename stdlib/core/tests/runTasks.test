# A subclass's refinement that adds entry rows or a handler to a case the base writes owns the tasks
# they start for the case's activation, cancelled as the case exits, its own exit rows first.

. sub = Sub()
sub.entered.wait()
sub.entered.wait()
sub.leaves <- true
sub.base-task!.wait()
sub.sub-task!.wait()
-- "base task cancelled: ${sub.base-task!.end == .cancelled}"
-- "sub entry task cancelled: ${sub.sub-task!.end == .cancelled}"
sub.busies <- true
sub.ticks <- 1
sub.entered.wait()
sub.leaves <- true
sub.handler!.wait()
-- "sub handler task cancelled: ${sub.handler!.end == .cancelled}"

