# A handle kept after its task finished is inert: it reports finished, and cancelling or
# resuming it leaves other tasks alone

. box = TaskBox()
. finished = Semaphore()
do new
    box.task = Task()
    -- "running finished ${box.task!.is-finished}"
    finished.post()
finished.wait()
. stale = box.task!

. started = SyncBufferedChannel'Int()
. gate = SyncBufferedChannel'Bool()
. done = SyncBufferedChannel'Int()
for index in 0 .. < 4
    do new
        do finally
            . panic = Task().failure
            if panic
                -- "bystander $index: $panic"
            done <- index
        started <- index
        <- gate
        -- "bystander $index: released"
for index in 0 .. < 4
    <- started

-- "stale finished ${stale.is-finished}"
stale.cancel()
stale.resume-later()
stale.resume-now()
-- "stale canceled ${stale.is-canceled}"
gate.close()
for index in 0 .. < 4
    <- done
-- "done"

━━━━━━━━━━━━━━━━━━━━
