# An object held only by the stack of a task that is still running survives a collection.

/YuGC/YuGC.h

+ stop-worker = false

. addresses SyncChannel'U64
. results SyncChannel'String

do new
    . node = GCNode(616)
    addresses <- (node as Pointer).address
    while !stop-worker
        node.value += 0
    if C:yumiGCVerifyObject(node as Pointer)
        results <- "alive $node.value"
    else
        results <- "missing"

. address = <- addresses
C:yumiCollect()
-- C:yumiGCVerifyObject(address as Pointer)
stop-worker = true
-- <- results

