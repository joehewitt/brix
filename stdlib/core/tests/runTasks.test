# A `do new` used as a value gives its `Task`, which tells how the task ended and can be
# waited for.

. go = Semaphore()
. task = do new
    go.wait()
    -- "task ran"
-- "running: ${task.end == .running}"
do new
    go.post()
task.wait()
-- "finished: ${task.end == .finished}"

. one = do new -- "one step"
one.wait()
-- "one: ${one.end == .finished}"

. failing = do new
    ?! Panic("broke")
catch failure
    -- "caught $failure.message"
failing.wait()
-- "panicked: ${failing.end == .panicked}"

. blocked = do new
    . ch Int<>
    . value = <- ch
    -- "never $value"
do new
    blocked.cancel()
blocked.wait()
-- "cancelled: ${blocked.end == .cancelled}"

. worker = Worker(2)
. pooled = do (worker) new
    -- "in worker"
pooled.wait()
-- "worker: ${pooled.end == .finished}"

. threaded = do new thread @large-stack
    -- "on a thread"
threaded.wait()
-- "thread: ${threaded.end == .finished}"

:----

running: true
task ran
finished: true
one step
one: true
caught broke
panicked: true
cancelled: true
in worker
worker: true
on a thread
thread: true
;===
:====
# A task waits for another through the `Task` that other task gave itself, and a task that
# waits for itself panics.

. box = TaskBox()
. ready = Semaphore()
. go = Semaphore()
do new
    box.task = Task()
    ready.post()
    go.wait()
    -- "task done"
ready.wait()
. task = box.task!
-- "running: ${task.end == .running}"
do new
    go.post()
task.wait()
-- "finished: ${task.end == .finished}"
task.wait()
-- "waited again"

do new
    Task().wait()
catch failure
    -- "self: $failure.message"

