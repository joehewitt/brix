. branch = demo.%first-child!
. mid = branch.%first-child!
. leaf = mid.%first-child!
. sibling = branch.%next-sibling!

` Clear the bits and rollups Box raised imperatively while children were appended
demo.$is-layout-invalid = false
demo.$is-layout-invalid-below = false
branch.$is-layout-invalid = false
branch.$is-layout-invalid-below = false
mid.$is-layout-invalid = false
mid.$is-layout-invalid-below = false
leaf.$is-layout-invalid = false
sibling.$is-layout-invalid = false

leaf.$is-layout-invalid = true

. raised-demo = demo.$is-layout-invalid-below
. raised-mid = mid.$is-layout-invalid-below
. raised-sibling = sibling.$is-layout-invalid-below
-- "raised demo=$raised-demo mid=$raised-mid sibling=$raised-sibling"

leaf.$is-layout-invalid = false

. cleared-own = leaf.$is-layout-invalid
. sticky-demo = demo.$is-layout-invalid-below
-- "cleared own=$cleared-own demo-below=$sticky-demo"

demo.$is-layout-invalid-below = false
mid.$is-layout-invalid-below = false

. final-demo = demo.$is-layout-invalid-below
. final-mid = mid.$is-layout-invalid-below
-- "walked demo=$final-demo mid=$final-mid"

