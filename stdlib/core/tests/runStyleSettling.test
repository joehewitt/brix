demo.markup-batch-queue.checkpoint()
widget.$is-paint-invalid = false
gauge.$is-paint-invalid = false
-- "start shade=${rgba-label(widget.$shade)} fill=${paint-label(widget.$fill)}"

widget.is-hot = true
-- "hot ${settled-label(demo, widget)}"
widget.is-cold = true
-- "cold ${settled-label(demo, widget)}"
widget.is-cold = false
-- "hot again ${settled-label(demo, widget)}"
widget.is-hot = false
-- "plain ${settled-label(demo, widget)}"

. raised = 0
for next in 1 .. < 65
    level = next as U8
    demo.markup-batch-queue.checkpoint()
    if gauge.$is-paint-invalid
        raised += 1
    gauge.$is-paint-invalid = false
-- "level changes raised=$raised"

