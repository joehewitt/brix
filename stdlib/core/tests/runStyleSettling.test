label.$is-paint-invalid = false
demo.$is-paint-invalid = false
demo.$is-layout-invalid = false
base = 13

do new
    -- "equal " + style-pending-snapshot(demo)
    -- style-computed-snapshot(label)
    done.post()
done.wait()

label.$is-paint-invalid = false
base = 40

do new
    -- "changed " + style-pending-snapshot(demo)
    -- style-computed-snapshot(label)
    done.post()
done.wait()

