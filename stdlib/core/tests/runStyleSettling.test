:====
# Markup batch flush summaries expose ordinary domain booleans backed by the same domain indexes
# as node pending bits. Dynamic style changes report the domains still pending after settling.

/core/style
/core/markup
/core/task
/core/tests/support/markup-fixtures

.. ink-base = 1
.. gap-base = 1
. done = Semaphore()

<BatchDemo demo
    <Label
        ink = #ink-base
        gap = #gap-base

demo.markup-batch-queue.checkpoint()

. label = demo.%first-child!
label.$is-paint-invalid = false
label.$is-layout-invalid = false
demo.$is-paint-invalid = false
demo.$is-layout-invalid = false

ink-base = 2
do new
    done.post()
done.wait()

label.$is-paint-invalid = false
label.$is-layout-invalid = false
demo.$is-paint-invalid = false
demo.$is-layout-invalid = false

gap-base = 3
do new
    done.post()
done.wait()

label.$is-paint-invalid = false
label.$is-layout-invalid = false
demo.$is-paint-invalid = false
demo.$is-layout-invalid = false

ink-base = 4
gap-base = 5
do new
    done.post()
done.wait()

