/core/tests/support/markup-fixtures

<BatchDemo demo
    <Box
        <Box leaf

demo.markup-batch-queue.checkpoint()

. branch = demo.%first-child!

demo.$is-layout-invalid = false
demo.$is-layout-invalid-below = false
branch.$is-layout-invalid = false
branch.$is-layout-invalid-below = false
leaf.$is-layout-invalid = false

leaf.$is-layout-invalid = true
-- "raised branch-own=${branch.$is-layout-invalid} branch-below=${branch.$is-layout-invalid-below} leaf-own=${leaf.$is-layout-invalid} leaf-below=${leaf.$is-layout-invalid-below}"

leaf.$is-layout-invalid = false
. pending-after-own = style-domain-pending-count(demo, "layout")
-- "cleared-own leaf-own=${leaf.$is-layout-invalid} leaf-below=${leaf.$is-layout-invalid-below} branch-own=${branch.$is-layout-invalid} branch-below=${branch.$is-layout-invalid-below} pending=$pending-after-own"

branch.$is-layout-invalid-below = false
-- "cleared-below branch-own=${branch.$is-layout-invalid} branch-below=${branch.$is-layout-invalid-below}"

