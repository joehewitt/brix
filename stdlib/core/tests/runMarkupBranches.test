# A departing parent waits for its leaving child, then closes with it.

/core/markup
/core/tests/support/markup-fixtures

+ log = List'String()

<Demo demo
    if #shown
        <Box
            for name in #names keyed by name
                <Leaver
                    name = name

demo.names.remove(0)
-- dump(demo)
demo.shown = false
-- dump(demo)
markup-departed(demo.%first-child!.%first-child!.%first-child!.%first-child!)
-- dump(demo)
-- " ".join(log)

━━━━━━━━━━━━━━━━━━━━
+ do dump String
    - demo Demo

. branch = demo.%first-child!
=? "empty"
    if !branch.%first-child
. parts = List'String()
for child in branch.%first-child!.%first-child!.children
    . leaver = child as Leaver
    if leaver.is-leaving
        parts += "${leaver.name}*"
    else
        parts += leaver.name
. text = " ".join(parts)
=? "($text)"
    if markup-is-departing(branch.%first-child!)
= text

━━━━━━━━━━━━━━━━━━━━
+ Demo is Box

+ shown = true
+ names = List'String(["a", "b"])

━━━━━━━━━━━━━━━━━━━━
+ Leaver is Box

+ name = ""
+ is-leaving = false

────────────────────
+ do markup-depart Bool

is-leaving = true
= true

────────────────────
+ do markup-revive

is-leaving = false

────────────────────
+ do close

log += "close:$name"
super.close()

:----

a* b
(a* b)
empty
close:a close:b
