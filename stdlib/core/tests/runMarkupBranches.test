. original = region.%first-child!
. original-rows = demo.row-pointers()
demo.state = DemoState(true, 2)
-- region.%first-child! as Pointer == original as Pointer
-- demo.row-pointers() == original-rows
demo.state = DemoState(true, 3)
-- region.%first-child! as Pointer == original as Pointer

