# A side of a conditional or of `??` is no block of its own: a use read there ends where the block around it does.
. o Int? = null
. v = (if o == null then t.n else 0)
-- "v $v"
. w = o ?? u.n
-- "w $w"
-- "end"
.. t = use Thing(5)
.. u = use Thing(6)

