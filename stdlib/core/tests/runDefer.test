# Cleanup that allocates runs to completion while a panic unwinds

. attempt = do new
    do finally
        . parts = List'String()
        for index in 0 .. < 3
            parts += "part $index"
        -- "cleanup ${parts.length} ${parts[2]}"

    ?! Panic("original")
catch failure
    -- "caught $failure"
attempt.wait()

