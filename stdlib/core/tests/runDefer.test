# Cleanup panic replaces the active panic

. attempt = do new
    do finally
        -- "first cleanup sees ${Task().failure}"

    do finally
        -- "cleanup panic"
        ?! Panic("cleanup")
        -- "after cleanup panic"

    ?! Panic("original")
catch
    --
attempt.wait()

