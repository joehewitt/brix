# Objects and atoms held in tuples, structs and unions compare by identity


. box = Box()
. other = Box()
. a = (1, box)
. b = (1, box)
. c = (1, other)
-- a == b
-- a == c
-- a != c
. k = ("x" as Atom, 2)
. l = ("x" as Atom, 2)
. m = ("y" as Atom, 2)
-- k == l
-- k == m
. p Holder = box
. q Holder = box
. r Holder = other
. s Holder = Holder.none
-- p == q
-- p == r
-- p != r
-- p == s
-- s == Holder.none
-- s != p
. w = Wrap(box, 1)
. x = Wrap(box, 1)
. y = Wrap(other, 1)
-- w == x
-- w == y
. deep = (1, (box, "t"), p)
. same = (1, (box, "t"), q)
. apart = (1, (box, "t"), r)
-- deep == same
-- deep == apart
. opt (Int, Box)? = (1, box)
. none (Int, Box)? = null
-- opt == a
-- a == opt
-- opt == c
-- none == a
-- none == none

