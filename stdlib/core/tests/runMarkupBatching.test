━━━━━━━━━━━━━━━━━━━━
+ MarkNode

+ parent MarkNode?
+ first-child MarkNode?
+ last-child MarkNode?
+ previous MarkNode?
+ next MarkNode?

────────────────────
+ do this += child MarkNode

child.parent = this
if !first-child
    first-child = last-child = child
else
    last-child?.next = child
    child.previous = last-child
    last-child = child
= child

────────────────────
+ do this -= child MarkNode

if child.parent == this
    child.parent = null
    if first-child == child
        first-child = child.next
    if last-child == child
        last-child = child.previous
    child.previous?.next = child.next
    child.next?.previous = child.previous
    child.next = null
    child.previous = null

────────────────────
+ do clear-children

while first-child
    . child = first-child!
    this -= child
    child.close()

────────────────────
+ do close

clear-children()

