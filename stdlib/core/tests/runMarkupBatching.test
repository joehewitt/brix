# Mount/unmount callbacks retain their batching order across a live remount. Owner reclamation
# clears the attachment lane only after the final mounted owner is dropped and emits no synthetic
# unmounted callback.

/core/markup
/core/tests/support/markup-fixtures
/YuGC/YuGC.h

. lane = C:yumiGCMarkupAttachmentsSidePayloadLane()
. root = CleanupBatchRoot()
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.events.clear()
. opening = C:yumiGCObjectSidePayloadCount(lane)

do exercise-cleanup-batch-order(root, lane, opening)
C:yumiCollect()
do C:yumiGCDrainCleanups()

-- "events=${"|".join(root.events)}"
-- "reclaimed=${C:yumiGCObjectSidePayloadCount(lane) - opening}"

━━━━━━━━━━━━━━━━━━━━
+ do exercise-cleanup-batch-order
    - root CleanupBatchRoot
    - lane U64
    - opening U64

.. child CleanupBatchChild? = CleanupBatchChild(root)

markup-adopt(child!, null, root)
root.markup-batch-queue.checkpoint()
root.events += "lane:${C:yumiGCObjectSidePayloadCount(lane) - opening}"

markup-release(child!)
root.markup-batch-queue.checkpoint()

markup-adopt(child!, null, root)
root.markup-batch-queue.checkpoint()
child = null

━━━━━━━━━━━━━━━━━━━━
