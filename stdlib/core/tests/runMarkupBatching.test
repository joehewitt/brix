    is MarkupRootElement

+ markup-batch-queue := MarkupBatchQueue(this)
+ events [String] = List'String()

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

events += "flush"

━━━━━━━━━━━━━━━━━━━━
+ CleanupBatchChild is Box

+ sink CleanupBatchRoot

────────────────────
+ This
    - sink

────────────────────
+ do mounted

sink.events += "mounted"

────────────────────
+ do unmounted

sink.events += "unmounted"

