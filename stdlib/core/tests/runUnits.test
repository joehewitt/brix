:====
# An assigning operator between units converts by their ratio, as its operator does.

. x = 3foo
x += 2bar
-- x as UnitString
x += 1
-- x as UnitString
x *= 2foo
-- x as UnitString
. f = 1.5
f += 2bar
-- f
. y = 2bar
y += 6foo
-- y as UnitString
. i = 3.0
i += 2bar
-- i

+ Foo (foo) is F64
+ Bar (bar) is F64

+ 1bar = 3foo

