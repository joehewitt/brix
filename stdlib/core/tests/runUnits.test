# Arithmetic on units as the operand of another operator.

-- (1foo + 2bar + 3foo) as UnitString
-- (1foo + 2bar) * 2foo
-- 1foo + 2bar < 3foo
-- 1foo + 2bar == 2foo
-- (2bar + 1foo + 2bar) as UnitString
-- (1foo + 2bar) as Bar
-- 3foo - (1foo + 2bar)
-- 5km + 500m + 1km
-- (5km + 500m + 1km) as M
-- 2km + 500m < 3km

