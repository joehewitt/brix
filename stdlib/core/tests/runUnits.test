:====
# Divide operator in unit

-- 24.0foo as Bar as UnitString
-- 72bar as Foo as UnitString

+ Foo (foo) is F64
+ Bar (bar) is I32

+ 1bar = 1 / 3foo

:----

72bar
24foo

;===
:====
# Pow operator in unit

-- 24.0foo as Bar as UnitString
-- 72bar as Foo as UnitString

+ Foo (foo) is F64
+ Bar (bar) is I32

+ 1bar = 2 %% 3foo

:----

3bar
576foo

