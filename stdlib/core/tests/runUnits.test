# A default written with a unit whose class declares a constructor is evaluated once, as its module starts.

-- "start"
-- big(3foo)
-- twice(1bar)

━━━━━━━━━━━━━━━━━━━━
+ Foo (foo) is Int

────────────────────
+ This
    - n

-- "foo $n"
= n + 100

━━━━━━━━━━━━━━━━━━━━
+ Bar (bar) is Float

────────────────────
+ This
    - n

-- "bar $n"
= n * 2

━━━━━━━━━━━━━━━━━━━━
+ big Foo
    - f Foo = 9foo

f

━━━━━━━━━━━━━━━━━━━━
+ twice
    - f = 9bar

f * 2

:----

foo 9
bar 9
