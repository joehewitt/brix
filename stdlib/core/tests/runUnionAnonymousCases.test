# Anonymous case named again by its symbol, bare and called


. result = match true
    |? true
        ..ok
    ??
        ..failed(1)

. other = .ok
-- other.name
-- other.case
-- other is .ok
-- result is .ok
. again = .failed(7)
-- again.name
-- again.case
-- match again
    | .failed(code)
        code + 1
    | .ok
        0
-- other == result
-- again == result
-- again != result

