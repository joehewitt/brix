:====
# Anonymous case of a function holds a name a later arm's pattern captures


-- label(true) is .loaded
-- label(false) is .failed

━━━━━━━━━━━━━━━━━━━━
+ label
    - works Bool

match catch risky(works)
    | error Error
        ..failed("no")
    | found [Int]
        ..loaded(found)

━━━━━━━━━━━━━━━━━━━━
+ do risky [Int] ?! Error
    - works Bool

?! Error("no") if !works
= [1, 2]

:----

true
true
