# Anonymous cases with converted values and matched fields


. shape = match 2
    |? false
        ..circle(1.5)
    ??
        ..rect(2, 3.5)
-- area(shape)
shape = .circle(2)
-- area(shape)
. label = match shape
    | .circle(r)
        ..round("circle", 2)
    | .rect(w, h)
        ..flat("rect")
-- label.name
-- match label
    | .round(text, size)
        "$text $size"
    | .flat(text)
        text
. nested = match true
    |? true
        ..wrapped(1, Box(2))
    ??
        ..bare
-- match nested
    | .wrapped(first, box)
        first + box.x
    | .bare
        0

━━━━━━━━━━━━━━━━━━━━
+ Box

+ x Int

────────────────────
+ This
    - x

━━━━━━━━━━━━━━━━━━━━
+ area Float
    - shape

match shape
    | .circle(r)
        r * r * 3.0
    | .rect(w, h)
        w * h

