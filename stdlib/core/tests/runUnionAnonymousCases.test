# Anonymous cases of a function with several values and an object


. box = Box(4)
-- describe(pick(0, box))
-- describe(pick(1, box))
-- describe(pick(2, box))
-- describe(pick(3, box))
-- pick(1, box).name
-- pick(3, box).case

━━━━━━━━━━━━━━━━━━━━
+ Box

+ x Int

────────────────────
+ This
    - x

━━━━━━━━━━━━━━━━━━━━
+ pick
    - which Int
    - box Box

|? which == 0
    ..empty
|? which == 1
    ..triple(1, 2.5, "three")
|? which == 2
    ..triple(4, 5, "six")
??
    ..boxed(box)

━━━━━━━━━━━━━━━━━━━━
+ describe String
    - value

match value
    | .empty
        "empty"
    | .triple(a, b, c)
        "triple $a $b $c"
    | .boxed(held)
        "boxed ${held.x}"

:----

empty
triple 1 2.5 three
triple 4 5 six
boxed 4
triple
2
