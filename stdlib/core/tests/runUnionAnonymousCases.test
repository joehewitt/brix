# Anonymous cases assigned again and by symbol


. count = 0
. result = match count
    |? count > 0
        ..many(count)
    ??
        ..none
-- result.name
count = 3
result = match count
    |? count > 0
        ..many(count)
    ??
        ..none
-- result.name
-- match result
    | .many(n)
        n * 2
    | .none
        0
result = .none
-- result.name
result = .many(9)
-- match result
    | .many(n)
        n
    | .none
        0
-- step(result)
result = .none
-- step(result)

━━━━━━━━━━━━━━━━━━━━
+ do step String
    - value

if value is .none
    = "none"
= "many"

