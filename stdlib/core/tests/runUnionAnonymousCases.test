# Anonymous case of a function holds its value as known where the case is written


-- match pick(null)
    | .some(n)
        n + 1
    | .other(n)
        n ?? -1

━━━━━━━━━━━━━━━━━━━━
+ do pick
    - value Int?

if value
    = ..some(value)
= ..other(value)

