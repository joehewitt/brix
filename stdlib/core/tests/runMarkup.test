# A live owner keeps one markup attachment across ordinary unmount/remount. Dropping the mounted,
# parentless owner lets reclamation clear lane 3, and deterministic cleanup drain completes the
# detached cleanup token without firing a visible unmounted callback.

/core/markup
/core/tests/support/markup-fixtures
/YuGC/YuGC.h

. lane = C:yumiGCMarkupAttachmentsSidePayloadLane()
. root = MarkupCleanupRoot()
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
. opening = C:yumiGCObjectSidePayloadCount(lane)

do exercise-markup-owner-lifetime(root, lane, opening)
C:yumiCollect()
do C:yumiGCDrainCleanups()

-- "reclaimed=${C:yumiGCObjectSidePayloadCount(lane) - opening}"

━━━━━━━━━━━━━━━━━━━━
+ do exercise-markup-owner-lifetime
    - root MarkupCleanupRoot
    - lane U64
    - opening U64

.. child MarkupCleanupChild? = MarkupCleanupChild()

markup-adopt(child!, null, root)
root.markup-batch-queue.checkpoint()
-- "mounted=${child!.events} lane=${C:yumiGCObjectSidePayloadCount(lane) - opening}"

markup-release(child!)
root.markup-batch-queue.checkpoint()
-- "unmounted=${child!.events} lane=${C:yumiGCObjectSidePayloadCount(lane) - opening}"

markup-adopt(child!, null, root)
root.markup-batch-queue.checkpoint()
-- "remounted=${child!.events} lane=${C:yumiGCObjectSidePayloadCount(lane) - opening}"

child = null

━━━━━━━━━━━━━━━━━━━━
