# Structural % reads are sidecar-backed and infer concrete MarkupParent child types.

/core/markup

. root = Node("root")
. a = Node("a")
. b = Node("b")
. c = Node("c")

markup-append(root, a)
markup-append(root, b)
markup-append(a, c)

-- root.describe()
-- a.describe()
-- b.describe()
-- c.describe()

markup-release(root)

-- c.describe()

markup-remove(root, a)

-- root.describe()
-- a.describe()
-- c.describe()

