# A binding of a nested function that holds text, called after many allocations.

. greet = :: greeting, name, mark => "$greeting $name$mark"
. hello = greet("hello", "ann")
. junk = [0]
. i = 0
while i < 20000
    junk = [i, i + 1]
    i += 1
-- hello("!")
-- greet("bye")("bob", "?")
-- junk.length

