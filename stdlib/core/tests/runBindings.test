# Bound constructor that raises made a value of a function type that raises

. make Foopy = Foo(1, ...)
-- make(2).sum
. failed = catch make(20)
-- failed is TooBig

━━━━━━━━━━━━━━━━━━━━
+ TooBig is Error

━━━━━━━━━━━━━━━━━━━━
+ Foopy is () Foo ?! TooBig
    - b Int

━━━━━━━━━━━━━━━━━━━━
+ Foo

+ sum Int

────────────────────
+ This ?! TooBig
    - a Int
    - b Int

?! TooBig("too big")
    if b > 10
.. sum = a + b

