. first = Cell(1)
stage = 1
while stage != 2
    C:usleep(2000)
. made = Cell(2)
stage = 3
while stage != 4
    C:usleep(100)
outcome = if C:yumiGCVerifyObject(made as Pointer) && made.held == 2 && first.held == 1 then "alive" else "lost"
= n

