# An object a callback makes after a C call of its own waited out the start of a mark survives the
# collection.

/JaCore/tests.h
/unistd.h
/YuGC/YuGC.h
/YuGC/YuGCTest.h

+ stage = 0
+ outcome = ""

C:yumiCollect()
. results SyncChannel'String
. pool = Worker(1)
do (pool) new
    C:ctestCallback(nested as TestCallback)
    results <- outcome
while stage != 1
    C:usleep(100)
C:yumiGCStartConcurrentMark()
stage = 2
while stage != 3
    C:usleep(100)
C:yumiCollect()
stage = 4
-- <- results
pool.stop()

