# A function written where a list is declared adds to it and takes from it, and a loop over the
# list follows.

/core/tests/support/markup-fixtures

. items = ["a", "b"]
<Box box
    for item in #items
        <TextBox = item
. add = => do items += "c"
. take = => do items -= "a"
add()
-- texts(box)
take()
-- texts(box)

