# A `when` clause on a loop that follows state is tested in each row on its own, as the item changes.
/core/markup

. todos = List'Todo([Todo("a", false), Todo("b", true), Todo("c", false)])
<Board board
    for todo in #todos when !todo.#done
        <Text = todo.name
board.show()
todos[1].done = false
board.show()
todos[0].done = true
board.show()
todos += Todo("d", true)
board.show()
todos[3].done = false
board.show()

