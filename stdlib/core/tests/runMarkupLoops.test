# A row may hold a match, and a live match selects its arm again in each row.

/core/markup

. items = List'Int([1, 2])
. mode = "a"
<Board board
    for n in #items
        match n
            | 1
                <Text = "one"
            | _
                <Text = "many"
        match #mode
            | "a"
                <Text = "$n:a"
            | _
                <Text = "$n:other"
board.show()
mode = "b"
board.show()

