# Supplied slot content in a static markup loop row reads the row's slot host by the host's
# markup id. Each row binds its own host, so a tracked read follows only that row's host, and a
# closure in the content reads its row's host when it runs.

/core/tests/support/markup-fixtures

. titles = List'String(["a", "b"])

<Box root
    for title in titles
        <Holder columns
            title = title

            <Pane (detail)
                tracked = columns.#title
                untracked = columns.title
                action = => do columns.title = "hit"

-- pane-labels(root)
(root.%first-child! as Holder).title = "z"
-- pane-labels(root)
. action = (root.%last-child!.%first-child! as Pane).action
if action
    action()
-- pane-labels(root)

