━━━━━━━━━━━━━━━━━━━━
+ MarkNode
    is MarkupParent'MarkNode

+ parent MarkNode?
+ first-child MarkNode?
+ last-child MarkNode?
+ previous MarkNode?
+ next MarkNode?

────────────────────
+ do get children

. maybe-child = first-child
if maybe-child
    . child = maybe-child
    while true
        <= child
        if !child.next
            break
        child = child.next

────────────────────
+ markup-content MarkNode
    - child MarkNode

child

────────────────────
+ do markup-attach-child
    - child MarkNode
    - anchor MarkNode?

child.parent = this
if !anchor
    if !first-child
        first-child = last-child = child
    else
        last-child?.next = child
        child.previous = last-child
        last-child = child
else
    . target = anchor
    child.previous = target.previous
    child.next = target
    if target.previous
        target.previous.next = child
    else
        first-child = child
    target.previous = child

────────────────────
+ do markup-detach-child
    - child MarkNode

if child.parent == this
    child.parent = null
    if first-child == child
        first-child = child.next
    if last-child == child
        last-child = child.previous
    child.previous?.next = child.next
    child.next?.previous = child.previous
    child.next = null
    child.previous = null

────────────────────
+ do clear-children Void

while true
    . maybe-child = first-child
    if !maybe-child
        break
    . child = maybe-child
    markup-remove(this, child)
    child.close()

────────────────────
+ do close Void

markup-close-region(this)
clear-children()

────────────────────
