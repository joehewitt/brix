# An if or a match that is a line of a keyed row reads the row's item tracked, so it selects its
# arm again when the key comes to hold another item.

/core/tests/support/markup-fixtures

. places = List'Place([Place("a", true), Place("b", false)])

<Box root
    for place in #places keyed by place.name
        if place.flag
            <TextBox = "${place.name} on"
        else
            <TextBox = "${place.name} off"
<Box kinds
    for place in #places keyed by place.name
        match place.flag
            |= true
                <TextBox = "yes"
            |= false
                <TextBox = "no"

-- "${dump(root)} | ${dump(kinds)}"
places = List'Place([Place("a", false), Place("b", true)])
-- "${dump(root)} | ${dump(kinds)}"
places += Place("c", true)
-- "${dump(root)} | ${dump(kinds)}"

━━━━━━━━━━━━━━━━━━━━
+ do dump String
    - box Box

. parts = List'String()
for child in box.children
    if child is TextBox
        parts += (child as TextBox).text
    else
        parts += "[${dump(child)}]"
= ",".join(parts)

