# A closure an attribute of a row of a keyed loop gives takes the row's item from the list the loop
# reads, and the loop follows.

/core/tests/support/markup-fixtures

. items = ["a", "b", "c"]
<Box box
    for item in #items keyed by item
        <Item
            text = item
            run = => do items -= item
(box.%first-child!.%first-child!.%next-sibling! as Item).fire()
-- texts(box)

