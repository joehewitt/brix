# An id on the root element of a static markup loop row is a local of that row, so the row's own
# content reads it and each row sees its own element. Ids nested in the row are row locals too.

/core/tests/support/markup-fixtures

. titles = List'String(["a", "b"])

<Box root
    for title in titles
        <Holder columns
            title = title

            <Pane pane
                label = columns.title
            <Pane
                label = "${pane.label}+${columns.title}"

<Box listed
    in titles
        <Holder columns
            title = each

            <Pane
                label = columns.title

-- row-labels(root)
-- row-labels(listed)

