# A handler in the row of a keyed loop reads the row's item in the value of an assignment written
# with an operator other than `=` when it runs, the item the row holds then, and the assignment
# does not run again as the item changes.

/core/tests/support/markup-fixtures

. items = [Entry("a", "A"), Entry("b", "B")]
. seen [String]
<Box box
    for item in #items keyed by item.id
        <Pinger
            for n on pings
                seen += item.text
. first = box.%first-child!.%first-child! as Pinger
first.pings <- 1
items[0] = Entry("a", "Z")
. again = box.%first-child!.%first-child! as Pinger
-- if again == first then "kept" else "replaced"
-- ", ".join(seen)
again.pings <- 1
-- ", ".join(seen)

