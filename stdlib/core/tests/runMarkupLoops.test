# A handler in the row of a keyed loop stores to the list the loop reads, declared where the loop
# is written, with the row's item in what it stores, and the loop follows.

/core/tests/support/markup-fixtures

. items = ["a", "b", "c"]
<Box box
    for item in #items keyed by item
        <Pinger
            text = item
            for n on pings
                items = [item, "${item}${n}"]
(box.%first-child!.%last-child! as Pinger).pings <- 2
-- texts(box)

