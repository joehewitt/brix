# A keyed row that is a region keeps its live `if` following the item its key holds now.

/core/markup

. todos = List'Todo([Todo("a", false), Todo("b", true)])
<Board board
    for todo in #todos keyed by todo.name
        <Text = todo.name
        if todo.#done
            <Text = "done"
board.show()
todos[0].done = true
board.show()
todos = List'Todo([Todo("a", false), Todo("b", true)])
board.show()
todos[1].done = false
board.show()

