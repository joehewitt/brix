7
;====
:====
# Styles register at the head of their defining module's init: module-level code in an
# importing module can mount, settle, and read styled nodes during its own initialization,
# before main runs, and sees authored values and unauthored defaults.

/core/style
/core/markup
/core/tests/support/markup-fixtures
./theme

<InitDemo demo
    <Label
        ink = 12

demo.markup-batch-queue.checkpoint()

. label = demo.%first-child! as Label
. ink = label.$ink
. tone = label.$tone
-- "init-read ink=$ink tone=$tone"

━━━━━━━━━━━━━━━━━━━━
+ InitDemo is Box
    is MarkupRootElement
    using TextStyle

+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
+ Label is Box
    using TextStyle

