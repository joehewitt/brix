:====
# $property reads resolve statically against the visible style vocabulary and compile to the
# declared value type: bare $name reads the current node and object.$name reads an explicit
# subject. Reads never settle: values read before settling are the style's initial values.

/core/style
/core/markup
/core/tests/support/markup-fixtures

<BatchDemo demo
    <Label
        ink = 9
        bold = true
        scale = 2.5
        margin = 3

. label = demo.%first-child!
-- demo.read-styles(label)
demo.markup-batch-queue.checkpoint()
-- demo.read-styles(label)

━━━━━━━━━━━━━━━━━━━━
+ BatchDemo is Box
    is MarkupRootElement
    using TextStyle

+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

────────────────────
+ do read-styles String
    - label Box

. own = $ink
. child-ink = label.$ink
. child-bold = label.$bold
. child-scale = label.$scale
. child-margin = label.$margin
= "own=$own ink=$child-ink bold=$child-bold scale=$child-scale margin=$child-margin"

━━━━━━━━━━━━━━━━━━━━
+ TextStyle is Style

+ @inherited ink I64 = 7
+ bold Bool = false
+ scale F64 = 1.5
+ margin I64 = 0

. ink -> paint
. bold -> paint
. scale -> layout
. margin -> layout

━━━━━━━━━━━━━━━━━━━━
+ Label is Box
    using TextStyle

:----
own=7 ink=7 bold=false scale=1.5 margin=0
own=7 ink=9 bold=true scale=2.5 margin=3
