# Style reads are total: authored values are contextual to the mounted tree, so an object that
# leaves it reads the property's registered initial value instead of its settled value.

/core/style
/core/markup
/core/tests/support/markup-fixtures

<BatchDemo demo
    <Label
        ink = 42

demo.markup-batch-queue.checkpoint()

. label = demo.%first-child! as Label
-- label.$ink

markup-remove(demo, label)
-- label.$ink

