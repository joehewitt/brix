# An interface can declare the style vocabularies its values expose. Style reads and imperative
# writes on interface values resolve through the interface's usings.

/core/style
/core/markup
/core/tests/support/markup-fixtures

. items [Tinted] = List'Tinted()
items += Swatch()
items += Chip()
. level = 5
for item in items
    item.tint = level
    level += 1
for item in items
    -- "tint=${item.$tint} authored=${style-has-authored-property(item, "TintStyle", "tint")}"
-- "fresh=${tint-of(Chip())}"

━━━━━━━━━━━━━━━━━━━━
+ tint-of I64
    - item Tinted

item.$tint

━━━━━━━━━━━━━━━━━━━━
+ TintStyle is Style

+ tint I64 = 1

. tint -> paint

━━━━━━━━━━━━━━━━━━━━
+ Tinted is Interface
    is MarkupElement
    using TintStyle

━━━━━━━━━━━━━━━━━━━━
+ Swatch is Box
    is Tinted
    using TintStyle

━━━━━━━━━━━━━━━━━━━━
+ Chip is Box
    is Tinted
    using TintStyle

