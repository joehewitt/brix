/core/virtual
/core/virtual-layout

. source = VirtualRangeSource(100vcoord)
. layout = VerticalMeasuredLayout(10vcoord)
. window = VirtualWindow()
window.viewport-width = 80vcoord
window.frame-width = 80vcoord
window.viewport-height = 35vcoord
window.frame-height = 35vcoord
-- "measures rows ${layout.measures-rows} ${VerticalFixedLayout(4vcoord).measures-rows}"
layout.fill-window(window, source)
-- "estimated ${window.placement-count} ${window.extent-y} ${layout.is-row-measured(1)}"

-- "record ${layout.record-row-height(window.placements[1], 25vcoord)} ${layout.is-row-measured(1)}"
layout.fill-window(window, source)
-- "repeat ${layout.record-row-height(window.placements[1], 25vcoord)}"
-- "measured ${window.placement-count} ${window.placements[1].rect} ${window.known-height}"
-- "address 50 ${layout.rect-for-address(50, source, window)}"
-- "address 100 ${layout.rect-for-address(100, source, window)}"

window.scroll-y = 5000vcoord
layout.fill-window(window, source)
-- "clamped ${window.resolved-scroll-y} ${window.placements[window.placement-count - 1].placement-id}"

window.scroll-y = 0vcoord
window.set-overscan(VirtualInsets(0vcoord, 0vcoord, 20vcoord, 0vcoord))
layout.fill-window(window, source)
-- "overscan ${window.placement-count}"

window.set-overscan(VirtualInsets(0vcoord, 0vcoord, 0vcoord, 0vcoord))
window.viewport-width = 60vcoord
window.frame-width = 60vcoord
layout.fill-window(window, source)
-- "narrower ${layout.is-row-measured(1)} ${window.known-height} ${window.placements[0].width}"

source.count = 1vcoord
layout.fill-window(window, source)
-- "shrunk ${layout.row-count} ${window.known-height}"
source.count = 3vcoord
layout.fill-window(window, source)
-- "regrown ${window.known-height}"

layout.reset()
-- "reset ${layout.row-count}"

:----
measures rows true false
estimated 4 (1000, 1000, true) false
record true true
repeat false
measured 2 (0, 10, 80, 25) 1015
address 50 (0, 515, 80, 10)
address 100 unknown
clamped 980 99
overscan 4
narrower false 1015 60
shrunk 1 10
regrown 30
reset 0
