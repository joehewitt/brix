. recycler = fixed-recycler()
. source = recycler.source! as VirtualRangeSource
request(recycler, 4001vcoord, 24vcoord)
. first-slot = recycler.slot-at(0)!
. first-generation = first-slot.generation

. prior = recycler.stats
source.bump-revision()
request(recycler, 4001vcoord, 24vcoord)
. current = recycler.stats
-- "revision binds ${current.source-binds - prior.source-binds}"
-- "revision pool ${recycler.pool-size}"
-- "revision key ${recycler.slot-at(0)!.key.revision}"
-- "revision generation advanced ${first-slot.generation > first-generation}"

prior = recycler.stats
recycler.source = VirtualRangeSource(1000000000vcoord)
request(recycler, 4001vcoord, 24vcoord)
current = recycler.stats
-- "replaced binds ${current.source-binds - prior.source-binds}"
-- "replaced created ${current.pool-created - prior.pool-created}"
-- "replaced key ${recycler.slot-at(0)!.key.revision}"

. replay = VirtualReplaySource(100vcoord)
recycler.source = replay
request(recycler, 0vcoord, 24vcoord)
. address = recycler.slot-at(0)!.address
. stale = recycler.stats.stale-commits
replay.replay()
-- "stale commits ${recycler.stats.stale-commits - stale}"
-- "stale address kept ${recycler.slot-at(0)!.address == address}"

:----
revision binds 13
revision pool 13
revision key 1
revision generation advanced true
replaced binds 13
replaced created 0
replaced key 0
stale commits 1
stale address kept true
