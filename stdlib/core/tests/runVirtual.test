. recycler = fixed-recycler()
. log = recycler.owner! as VirtualDepartureLog
request(recycler, 4001vcoord, 24vcoord)

. prior = recycler.stats
for step in 0 .. < 64
    request(recycler, if step % 2 == 0 then 4001vcoord else 4002vcoord, 24vcoord)
. current = recycler.stats
-- "stable binds ${current.source-binds - prior.source-binds}"
-- "stable departures ${current.departures - prior.departures}"

prior = recycler.stats
. y = 4001vcoord
for _ in 0 .. < 100
    y += 4vcoord
    request(recycler, y, 24vcoord)
current = recycler.stats
-- "adjacent binds ${current.source-binds - prior.source-binds}"
-- "adjacent departures ${current.departures - prior.departures}"
-- "adjacent pool ${recycler.pool-size}"
-- "adjacent matched ${slots-match-placements(recycler)}"
-- "departed ${log.count} bound ${log.bound-count}"

prior = recycler.stats
request(recycler, 2000000001vcoord, 24vcoord)
current = recycler.stats
-- "jump binds ${current.source-binds - prior.source-binds}"
-- "jump pool ${recycler.pool-size}"
-- "jump matched ${slots-match-placements(recycler)}"
-- "jump first address ${recycler.window.placements[0].address}"

