/core/virtual
/core/virtual-layout
/core/virtual-recycler

. source = VirtualListSource'String()
source.identity = :: name => hash-for(name) as U64
source.replace(list-names(100, ""))
. recycler = VirtualRecycler'String()
recycler.source = source
recycler.layout = VerticalFixedLayout(4vcoord)
request-list(recycler)
-- "pool ${recycler.pool-size}"
-- "first ${recycler.slot-at(0)!.item}"
-- "extent ${recycler.window.extent-y.known}"

. inserted = list-names(100, "")
inserted.insert("new-b", 0)
inserted.insert("new-a", 0)
. prior = recycler.stats
source.replace(inserted)
request-list(recycler)
. current = recycler.stats
-- "insert departures ${current.departures - prior.departures}"
-- "insert binds ${current.source-binds - prior.source-binds}"
-- "insert pool ${recycler.pool-size}"
-- "insert slot ${recycler.slot-at(0)!.item} ${recycler.slot-at(0)!.address}"
-- "insert matched ${list-slots-match(recycler)}"

. removed = list-names(100, "")
removed.insert("new-b", 0)
removed.insert("new-a", 0)
removed.remove(5)
prior = recycler.stats
source.replace(removed)
request-list(recycler)
current = recycler.stats
-- "remove departures ${current.departures - prior.departures}"
-- "remove matched ${list-slots-match(recycler)}"

source.identity = null
prior = recycler.stats
source.replace(list-names(100, "x"))
request-list(recycler)
current = recycler.stats
-- "plain departures ${current.departures - prior.departures}"
-- "plain matched ${list-slots-match(recycler)}"

━━━━━━━━━━━━━━━━━━━━
_ list-names [String]
    - count Size
    - prefix String

** "${prefix}row-$each" in 0 .. < count

━━━━━━━━━━━━━━━━━━━━
_ do request-list
    - recycler VirtualRecycler'String

. window = recycler.window
window.scroll-y = 0vcoord
window.viewport-width = 80vcoord
window.frame-width = 80vcoord
window.viewport-height = 24vcoord
window.frame-height = 24vcoord
window.overscan-top = 12vcoord
window.overscan-bottom = 12vcoord
recycler.refresh()

━━━━━━━━━━━━━━━━━━━━
_ do list-slots-match
    - recycler VirtualRecycler'String

. list = recycler.source! as VirtualListSource'String
. placed Size
for index in 0 .. < recycler.pool-size
    . slot = recycler.slot-at(index)!
    . placement = recycler.placement-for-slot(index)
    if placement
        =? false if !slot.is-bound || slot.address != placement.address
        =? false if slot.item != list.items[placement.address]
        placed += 1
    else
        =? false if slot.is-bound
= placed == recycler.window.placement-count

:----
pool 9
first row-0
extent 400
insert departures 2
insert binds 9
insert pool 9
insert slot row-0 2
insert matched true
remove departures 1
remove matched true
plain departures 9
plain matched true
;====

