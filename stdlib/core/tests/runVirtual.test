-- "far pool ${recycler.pool-size} departures ${log.count}"
-- "far row 0 bound ${slot-for-address(recycler, 0) != null}"

recycler.retention = VirtualInsets(0vcoord, 0vcoord, 0vcoord, 0vcoord)
request-retained(recycler, 440vcoord)
-- "unretained placements ${recycler.window.placement-count} departures ${log.count}"

