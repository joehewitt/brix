# A local that holds a tuple is copied where it is assigned, in a loop and under a condition.

. a = (1, "one")
. b = a
b = (2, "two")
-- a[0], a[1]
-- b[0], b[1]
. sum = 0
. i = 0
while i < 3
    . step = (i, i * 2)
    if step[1] > 1
        a = (step[0] + step[1], "more")
    sum += step[0] + step[1]
    i += 1
-- sum
-- a

