+ @task logical = 0
+ @thread physical = 0
+ Result is (label String, logical Int, physical Int)

. worker = Worker(1)
. results SyncChannel'Result

do (worker) new
    logical += 1
    physical += 1
    results <- ("task 1", logical, physical)

-- <- results

do (worker) new
    logical += 1
    physical += 1
    results <- ("task 2", logical, physical)

-- <- results

:------------------------------------------------------------------------------------------------

(task 1, 1, 1)
(task 2, 1, 2)
