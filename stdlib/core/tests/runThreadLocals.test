+ @thread scratch = 10

. worker = Worker(1)
. results SyncChannel'String

do (worker) new
    scratch += 1
    results <- "first $scratch"

-- <- results

do (worker) new
    scratch += 1
    results <- "second $scratch"

-- <- results

