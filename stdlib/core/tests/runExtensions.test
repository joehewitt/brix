/core/table
# Imported and re-exported union, shared-base, and narrowed-case extensions operate on live
# Table row views.

./lib/model
./lib/reexport

. rows = Table'Node(2)
rows[0] = Node.literal(10, 2)
rows[1] = Node.call(20, 3)

-- rows[0].describe()
-- rows[1].describe()
-- rows[0].source-plus

for row in rows
    -- row.describe()

do match rows[0]
    | .literal(literal)
        -- literal.case-label
        literal.bump()
        -- "bumped"
    | .call
        -- "unexpected"

-- rows[0] as Node

