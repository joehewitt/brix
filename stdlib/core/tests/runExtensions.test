:====
# A setter that an extension adds takes the value assigned to its name, and an assigning operator reads the extension's getter and stores through its setter.

. box = Box()
box.label = "abcde"
-- box.size
-- box.label
box.label += "xy"
-- box.size

━━━━━━━━━━━━━━━━━━━━
+ Box

+ size = 4

━━━━━━━━━━━━━━━━━━━━
+ extend Box

────────────────────
+ get label String

"size $size"

────────────────────
+ do label = value String

size = value.length

