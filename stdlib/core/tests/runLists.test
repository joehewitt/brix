# A list of pointers keeps its storage across a collection: the collector follows the storage of
# an array on the collected heap whatever its items are, so lists made after the collection do not
# take the storage over.

/YuGC/YuGC.h

. registry = Registry()
. kept [Thing]
for index in 0 .. < 64
    . thing = Thing(index)
    kept += thing
    registry.register(thing)
C:yumiGCCollect()
. fillers [[U64]]
for round in 0 .. < 200
    . filler [U64]
    for index in 0 .. < 64
        filler += 7
    fillers += filler
-- registry.matching(kept)

