+ do count String
    - values [Index]

. items [Item] = List'Item()
for value in values
    items += Item(value)
. counts [Size] = List'Size()
for item in items
    while counts.length <= item.crossing
        counts += 0
    counts[item.crossing] += 1
= "$counts"

