━━━━━━━━━━━━━━━━━━━━
+ Registry

_ identities [Pointer] = List'Pointer()

────────────────────
+ do register
    - thing Thing

identities += thing as Pointer

────────────────────
+ do matching Size
    - kept [Thing]

. found Size = 0
for identity in identities
    for thing in kept
        if thing as Pointer == identity
            found += 1
= found

