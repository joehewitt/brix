# Arena-backed Lists retain one algorithm and preserve their backing through results and copies.

/core/arena

. arena = Arena()
do finally
    arena.release()

. list = List'U32(arena)
for index in 0 .. < 10
    list += index as U32

. alias = list
alias[0] = 100u32
alias += 10u32

. slice = list[2 .. < 5]
slice[0] = 22u32
. plus = list + 11u32
. joined = list ++ [11u32, 12u32]

. copy = List(list)
copy[0] = 200u32
. from-items = List'U32(arena, [7u32, 8u32])

-- type-of List'U32()
-- type-of list
-- type-of slice
-- type-of plus
-- type-of joined
-- type-of copy
-- type-of from-items
-- list.length, list[0], list[2], list.tail
-- plus.length, plus.tail
-- joined.length, joined.tail
-- copy[0], list[0]
-- from-items[0], from-items[1]

list.remove(0, list.length)
list += 42u32
. sum = 0u32
for item in list
    sum += item
-- sum

list.release()
-- list.length, list.capacity
list += 5u32
-- list[0]
-- GCBacking.Context.size, ArenaBacking.Context.size

:------------------------------------------------------------------------------------------------

