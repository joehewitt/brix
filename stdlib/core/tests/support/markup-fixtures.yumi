╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get root Box

%parent?.root ?? this

────────────────────
+ do get ancestors

. maybe-ancestor = %parent
if maybe-ancestor
    . ancestor = maybe-ancestor
    while true
        <= ancestor
        if !ancestor.%parent
            break
        ancestor = ancestor.%parent!

────────────────────
+ do get children

. maybe-child = %first-child
if maybe-child
    . child = maybe-child
    while true
        <= child
        if !child.%next-sibling
            break
        child = child.%next-sibling!

────────────────────
+ do get boxes-before

. other = %previous-sibling
while other
    <= other!
    other = other!.%previous-sibling

────────────────────
+ do get boxes-after

. other = %next-sibling
while other
    <= other!
    other = other!.%next-sibling

────────────────────
+ markup-content
    - child Box

child

────────────────────
+ markup-content Box
    - content String

TextBox(content)

────────────────────
+ do markup-attach-child
    - child Box
    - anchor Box?

invalidate-layout()

────────────────────
+ do markup-detach-child
    - child Box

invalidate-layout()

────────────────────
+ do child-at
    - index Index

. cursor = %first-child
. current Index = 0
while cursor
    if current == index
        = cursor
    cursor = cursor.%next-sibling
    current += 1

────────────────────
+ do clear-children

while true
    . maybe-child = %first-child
    if !maybe-child
        break
    . child = maybe-child
    markup-remove(this, child)
    child.close()
    event-close-owner(child as Pointer)

────────────────────
+ do close-box

for child in children
    child.close()

────────────────────
+ do invalidate-layout

if !$is-layout-invalid
    $is-layout-invalid = true
invalidate-paint()

────────────────────
+ do invalidate-paint

. paint-root = root
. already-scheduled = paint-root.$is-paint-invalid
$is-paint-invalid = true
paint-root.$is-paint-invalid = true

────────────────────
+ do descendant'Target Target?
    - where Predicate'Target = type-identity'Target()

if this is Target
    . target = this as Target
    if where(target)
        = target
for child in children
    =? child.descendant'Target • where where

────────────────────
+ do ancestor'Target Target?
    - where Predicate'Target = type-identity'Target()

for ancestor in ancestors
    if ancestor is Target
        . target = ancestor as Target
        if where(target)
            = target
    = ancestor.ancestor'Target • where where

────────────────────
+ ancestor-or-self'Target Target?
    - where Predicate'Target = type-identity'Target()

|? this is Target && where(this as Target)
    this as Target
??
    ancestor'Target • where where

────────────────────
+ do before'Target Target?
    - where Predicate'Target = type-identity'Target()

for box in boxes-before when box is Target
    . target = box as Target
    if where(target)
        = target

────────────────────
+ do after'Target Target?
    - where Predicate'Target = type-identity'Target()

for box in boxes-after when box is Target
    . target = box as Target
    if where(target)
        = target

