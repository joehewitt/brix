+ black = AnsiColor(0)
+ navy = AnsiColor(4)
+ silver = AnsiColor(7)
+ grey = AnsiColor(8)
+ red = AnsiColor(9)
+ yellow = AnsiColor(11)
+ blue = AnsiColor(12)
+ aqua = AnsiColor(14)
+ white = AnsiColor(255)

+ AnsiColor is U8
+ Coord is I16
+ Flex is U8
+ PSize is (width Coord, height Coord)
+ Point is (x Coord, y Coord)
+ Label is TextBox
+ Form is Box

━━━━━━━━━━━━━━━━━━━━
+ Rect is (x Coord, y Coord, width Coord, height Coord)

+ point => Point(x, y)
+ size => PSize(width, height)

