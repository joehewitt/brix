+ RebindRowScope'Item
    is MarkupRebindableScope

+ address I64
+ key I64
+ item Item
+ generation U64 = 0

────────────────────
+ This
    - address
    - key
    - item

━━━━━━━━━━━━━━━━━━━━
+ RebindPanel'Item is Box
    is MarkupBatch

+ markup-batch-queue := MarkupBatchQueue(this as MarkupBatch)
+ flush-count Size = 0
_ scopes [RebindRowScope'Item] = List'(RebindRowScope'Item)()

────────────────────
+ do items = items [Item]

scopes.clear()
. index I64 = 0
for item in items
    scopes += RebindRowScope'Item(index, index, item)
    index += 1

────────────────────
+ get row-scopes [RebindRowScope'Item]

scopes

────────────────────
+ do rebind
    - index Index
    - address I64
    - key I64
    - item Item

. scope = scopes[index]
scope.address = address
scope.key = key
scope.item = item
scope.generation += 1

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

flush-count += 1

────────────────────

<This
    for scope in #scopes
        + <Box row - scope RebindRowScope'Item

