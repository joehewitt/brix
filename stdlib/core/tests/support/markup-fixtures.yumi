+ RGBA is Tuple

+ red = 0.0
+ green = 0.0
+ blue = 0.0
+ alpha = 1.0

━━━━━━━━━━━━━━━━━━━━
+ HSVA is Tuple

+ hue = 0.0
+ saturation = 0.0
+ value = 0.0
+ alpha = 1.0

