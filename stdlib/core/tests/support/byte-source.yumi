/YuCore/YuCore.h
/core/array
/core/tokenstream

━━━━━━━━━━━━━━━━━━━━
+ TestByteSource'Value
    is ByteReadable
    is Decodable'Value

+ data Value[]
+ cursor Size = 0
+ is-encoded Bool = false
+ chunk-limit Size = Size.max

────────────────────
+ This
    - data Value[]

────────────────────
+ do rewind

cursor = 0

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

. available = data.byte-size - cursor
. requested = if size < chunk-limit then size else chunk-limit
. count = if requested < available then requested else available
. bytes = data.data as CPointer'Byte
if count
    do C:yumiArrayCopySlice(buffer, bytes + cursor, count)
cursor += count
= count
