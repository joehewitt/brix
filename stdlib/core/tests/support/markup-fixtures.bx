(import /core)
(import /core/collection)
(import /core/markup)
(import /core/style)
(import /core/tracker)
(blank)
(prop + black _ (= (call AnsiColor 0)))
(prop + navy _ (= (call AnsiColor 4)))
(prop + silver _ (= (call AnsiColor 7)))
(prop + grey _ (= (call AnsiColor 8)))
(prop + red _ (= (call AnsiColor 9)))
(prop + yellow _ (= (call AnsiColor 11)))
(prop + blue _ (= (call AnsiColor 12)))
(prop + aqua _ (= (call AnsiColor 14)))
(prop + white _ (= (call AnsiColor 255)))
(blank)
(type-line + AnsiColor (is U8))
(type-line + Coord (is I16))
(type-line + Flex (is U8))
(type-line + PSize (is (tuple (: width Coord) (: height Coord))))
(type-line + Point (is (tuple (: x Coord) (: y Coord))))
(type-line + Label (is TextBox))
(type-line + Form (is Box))

(type + Rect (is (tuple (: x Coord) (: y Coord) (: width Coord) (: height Coord)))
  (prop + point _ (=> (call Point x y)))
  (prop + size _ (=> (call PSize width height)))
)

(type + RGBA (is Tuple)
  (prop + red _ (= 0.0))
  (prop + green _ (= 0.0))
  (prop + blue _ (= 0.0))
  (prop + alpha _ (= 1.0))
)

(type + HSVA (is Tuple)
  (prop + hue _ (= 0.0))
  (prop + saturation _ (= 0.0))
  (prop + value _ (= 0.0))
  (prop + alpha _ (= 1.0))
)

(type + Painter
  (fn-expr + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
  )
)

(type + BackgroundColor (is Union)
  (variant ansi (tuple (: color AnsiColor)))
  (variant rgba (tuple (: color RGBA)))
  (variant hsva (tuple (: color HSVA)))
)

(type + Canvas)

(type + BoxPaint (is Style)
  (prop + background-color (? BackgroundColor) (= null))
  (prop + background (? Painter) (= null))
  (blank)
  (style-domains background-color (domain paint))
  (style-domains background (domain paint))
)

(type + TextPaint (is Style)
  (prop + color AnsiColor @inherited (= (call AnsiColor 255)))
  (blank)
  (style-domains color (domain paint))
)

(type + BoxPlacement (is Style)
  (prop + flex Flex (= 0))
  (blank)
  (style-domains flex (domain layout parent))
)

(type + Box
  (implements (of MarkupParent Box))
  (using BoxPaint)
  (using TextPaint)
  (using BoxPlacement)
  (prop + markup-attachment-cache (? MarkupAttachment))
  (blank)
  (rule bg
    (param value (? BackgroundColor))
    (= background-color value)
  )
  (blank)
  (rule flex
    (param amount Flex)
    (= flex amount)
  )
  (fn-expr + markup-batch-root (? MarkupRootElement) :get
    (call markup-root-of this)
  )
  (fn-expr + markup-first-child (? MarkupElement) :get
    (call markup-structural-first-child-host this)
  )
  (fn-expr + markup-next-sibling (? MarkupElement) :get
    (call markup-structural-next-sibling-host this)
  )
  (fn-do + close _
    (call close-box)
  )
  (fn-expr + markup-make-region (? Box)
    (call BoxRegion)
  )
  (fn-expr + root Box :get
    (?? (?. %parent root) this)
  )
  (fn-do + ancestors _ :get
    (let maybe-ancestor %parent)
    (if maybe-ancestor
      (let ancestor maybe-ancestor)
      (while true
        (yield ancestor)
        (blank)
        (if (not (. ancestor %parent))
          (break)
        )
        (= ancestor (!! (. ancestor %parent)))
      )
    )
  )
  (fn-do + children _ :get
    (let maybe-child %first-child)
    (if maybe-child
      (let child maybe-child)
      (while true
        (yield child)
        (blank)
        (if (not (. child %next-sibling))
          (break)
        )
        (= child (!! (. child %next-sibling)))
      )
    )
  )
  (fn-do + boxes-before _ :get
    (let other %previous-sibling)
    (while other
      (yield (!! other))
      (blank)
      (= other (. (!! other) %previous-sibling))
    )
  )
  (fn-do + boxes-after _ :get
    (let other %next-sibling)
    (while other
      (yield (!! other))
      (blank)
      (= other (. (!! other) %next-sibling))
    )
  )
  (fn-expr + markup-content _
    (param child Box)
    child
  )
  (fn-expr + markup-content Box
    (param content String)
    (call TextBox content)
  )
  (fn-do + markup-attach-child _
    (param child Box)
    (param anchor (? Box))
    (call invalidate-layout)
  )
  (fn-do + markup-detach-child _
    (param child Box)
    (call invalidate-layout)
  )
  (fn-do + child-at _
    (param index Index)
    (let cursor %first-child)
    (let current Index 0)
    (while cursor
      (if (== current index)
        (return cursor)
      )
      (= cursor (. cursor %next-sibling))
      (+= current 1)
    )
  )
  (fn-do + clear-children _
    (while true
      (let maybe-child %first-child)
      (if (not maybe-child)
        (break)
      )
      (let child maybe-child)
      (call markup-remove this child)
      (call (. child close))
      (call event-close-owner (as child Pointer))
    )
  )
  (fn-do + close-box _
    (for (in child children)
      (call (. child close))
    )
  )
  (fn-do + invalidate-layout _
    (if (not $is-layout-invalid)
      (= $is-layout-invalid true)
    )
    (call invalidate-paint)
  )
  (fn-do + invalidate-paint _
    (let paint-root root)
    (let already-scheduled (. paint-root $is-paint-invalid))
    (= $is-paint-invalid true)
    (= (. paint-root $is-paint-invalid) true)
  )
  (fn-do + (of descendant Target) (? Target)
    (param where (of Predicate Target) (= (call (of type-identity Target))))
    (if (is this Target)
      (let target (as this Target))
      (if (call where target)
        (return target)
      )
    )
    (for (in child children)
      (return? (call (of (. child descendant) Target) (:where where)))
    )
  )
  (fn-do + (of ancestor Target) (? Target)
    (param where (of Predicate Target) (= (call (of type-identity Target))))
    (for (in ancestor ancestors)
      (if (is ancestor Target)
        (let target (as ancestor Target))
        (if (call where target)
          (return target)
        )
      )
      (return (call (of (. ancestor ancestor) Target) (:where where)))
    )
  )
  (fn-expr + (of ancestor-or-self Target) (? Target)
    (param where (of Predicate Target) (= (call (of type-identity Target))))
    (case? (and (is this Target) (call where (as this Target)))
      (as this Target)
    )
    (default
      (call (of ancestor Target) (:where where))
    )
  )
  (fn-do + (of before Target) (? Target)
    (param where (of Predicate Target) (= (call (of type-identity Target))))
    (for (in box boxes-before (when (is box Target)))
      (let target (as box Target))
      (if (call where target)
        (return target)
      )
    )
  )
  (fn-do + (of after Target) (? Target)
    (param where (of Predicate Target) (= (call (of type-identity Target))))
    (for (in box boxes-after (when (is box Target)))
      (let target (as box Target))
      (if (call where target)
        (return target)
      )
    )
  )
)

(type + TextBox (is Box)
  (prop + text String)
  (fn-do + This _
    (param text String)
  )
  (fn-do + markup-absorb _
    (param content String)
    (= text content)
  )
)

(type + (of RebindRowScope Item)
  (implements MarkupRebindableScope)
  (prop + address I64)
  (prop + key I64)
  (prop + item Item)
  (prop + generation U64 (= 0))
  (fn-do + This _
    (param address _)
    (param key _)
    (param item _)
  )
)

(type + (of RebindPanel Item) (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (prop + flush-count Size (= 0))
  (prop _ scopes (list (of RebindRowScope Item)) (= (call (of List (of RebindRowScope Item)))))
  (fn-do + items _ :set (param items (list Item))
    (call (. scopes clear))
    (let index I64 0)
    (for (in item items)
      (+= scopes (call (of RebindRowScope Item) index index item))
      (+= index 1)
    )
  )
  (fn-expr + row-scopes (list (of RebindRowScope Item)) :get
    scopes
  )
  (fn-do + rebind _
    (param index Index)
    (param address I64)
    (param key I64)
    (param item Item)
    (let scope ([] scopes index))
    (= (. scope address) address)
    (= (. scope key) key)
    (= (. scope item) item)
    (+= (. scope generation) 1)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (+= flush-count 1)
  )
  (content
    (<> This
      (for (in scope #scopes)
        (+<> Box (id: row) (param: scope (of RebindRowScope Item)))
      )
    )
  )
)

(type + BoxRegion (is Box)
  (fn-do + close _
    (call markup-close-region this)
    (call (. super close))
  )
)
