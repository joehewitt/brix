;====
:====
# A function that the expression of a rule's arm makes reads the arm's `location`.

/stream/aggregate

for text in ["a,b,c", "a"]
    -- match text
        ~ found \words
            found
        ?? "none"

━━━━━━━━━━━━━━━━━━━━
+ words ~ Char String

~ head \word tail ("," \word)*
    reduce • seed head • stream tail • using :: left, right =>
        "($left $right ${location.end.column})"

.. word String ~
    ~ w [a-z]+
        "<$w>"

:----

((<a> <b> 4) <c> 4)
<a>
