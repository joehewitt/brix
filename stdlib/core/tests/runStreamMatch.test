/core/array-builder
# A static pattern argument crosses a recursive module combinator with one active frame. Failure
# restores that frame, and a retained result remains stable across a later match.

/core/patterns

. retained = parse-words("alpha, beta!")
. failed = match "alpha,beta?"
    ~ items \delimited(",", ~ [a-z]+) "!"
        items
    ?? failed-words()
. trailing = parse-words-before-trailing("alpha,beta,!")
. later = parse-words("gamma!")

-- retained
-- failed
-- trailing
-- later
-- retained

