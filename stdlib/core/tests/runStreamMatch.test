# Discarded and length-only named text results never reach the participant materializer, and
# retained text outlives its source.

/core/arena
/core/tokenstream
/YuGC/YuGC.h

. scratch = Arena()
. arena = Arena()
. owner = CountingOwner(arena)
. input = "héllo 42!".codepoints
. source = Array'Char(scratch.allocate'Char(input.length), input.length)
for i in 0 .. < input.length
    source[i] = input[i]
. stream = ArrayTokenStream'Char(source)

-- discarded(stream, owner)
-- owner.materialized
stream.cursor = 0
-- measured(stream, owner)
-- owner.materialized
stream.cursor = 0
-- deferred(stream, owner)
-- owner.materialized
stream.cursor = 0
-- retried(stream, owner)
-- owner.materialized
stream.cursor = 0
. kept = kept(stream, owner)
-- owner.materialized
stream.cursor = 0
. forwarded = forwarded(stream, owner)
-- owner.materialized
stream.cursor = 0
. unowned = unowned(stream)
-- owner.materialized

scratch.reset()
for i in 0 .. < 20
    . later = match "later 7!"
        with owner
        ~ word \counted-word \counted-space number \counted-number "!"
            "$word/${number.length}"
        ?! Panic("later match failed")
    C:yumiGCCollect()

-- kept
-- forwarded
-- unowned
-- arena.owns((kept as Atom).address as Pointer)
-- arena.owns((forwarded as Atom).address as Pointer)
scratch.release()
arena.release()

