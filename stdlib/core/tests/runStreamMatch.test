# A local rule of several arms marked to roll back rewinds each arm's effect when its caller's
# arm fails, as a module rule does.

. journal = Journal()
. found = match "go!"
    with journal
    ~ \word "?"
        1
    ~ \word "!"
        2
    ?? 0

    .. word I32 ~ @rollback
        ~ "x"
            journal.increment()
        ~ "go"
            journal.increment()
-- "${found} count ${journal.count}"

