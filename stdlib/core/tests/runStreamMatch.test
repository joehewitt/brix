;====
:====
# In a rule that states text, an arm with no expression that is a sequence of parts gives the text
# it matched, whatever its last part gives.

for text in ["•12", "12!", "#7", "x", "12"]
    -- match text
        ~ parsed \grammar
            "got $parsed"
        ?? "no match"

━━━━━━━━━━━━━━━━━━━━
+ grammar ~ Char String

~ s \single
    "single <$s>"
~ s \several
    "several <$s>"

.. single String ~
    ~ "•" \number

.. several String ~
    ~ \number "!"
    ~ "#" n \number
    ~ "x"

.. number U32 ~
    ~ digits [0-9]+
        digits.length as U32

