;====
:====
# Under a helper, an arm with no expression that is a sequence of parts gives the text it matched,
# made as the type its rule gives, though its last part calls a rule that gives a value of that
# type.

/core/atom-pool
/core/arena
/core/patterns

. helper = AtomPatternHelper(Arena())
for text in ["•ab", "•xab", "?ab", "! xab", "ab"]
    -- match text
        with helper
        ~ parsed \grammar(helper)
            helper.notes[parsed - 1]
        ?? "no match"
    -- "counts ${helper.string-capture-count} ${helper.string-value-count} ${helper.atom-capture-count} ${helper.atom-value-count}"

━━━━━━━━━━━━━━━━━━━━
+ grammar ~ Char NodeId
    - tree AtomPatternHelper

~ s \stated
    tree.note("stated ${s.text}")
~ s \unstated
    tree.note("unstated ${s.text}")
~ s \texted
    tree.note("texted $s")

.. stated Atom ~
    ~ "•" \name

.. unstated ~
    ~ "?" \name

.. texted String ~
    ~ "!" // \name

.. name Atom ~
    ~ "x" rest [a-z]+
        tree.pool.store(rest)
    ~ [a-z]+

