# Alternatives that each call a rule that gives a value of one type give the name that captures them the value of the one that passed: alone, in a repeat and in an optional part.

for text in ["'a", "'b", "'c", "'d", "x"]
    -- one(text)
for text in ["ab", "cab", "", "abd"]
    -- many(text)
for text in ["a.", ".", "c.", "d."]
    -- maybe(text)

━━━━━━━━━━━━━━━━━━━━
+ do one String
    - text String

= match text
    ~ "'" tt (\first | \second | \third)
        "got ${tt + 1}"
    ?? "no match"

    .. first U32 ~
        ~ "a"
            10

    .. second U32 ~
        ~ "b"
            20

    .. third U32 ~
        ~ "c"
            30

━━━━━━━━━━━━━━━━━━━━
+ do many String
    - text String

= match text
    ~ items (\m-first | \m-second | \m-third)*
        "got ${items.length} ${items}"
    ?? "no match"

    .. m-first U32 ~
        ~ "a"
            10

    .. m-second U32 ~
        ~ "b"
            20

    .. m-third U32 ~
        ~ "c"
            30

━━━━━━━━━━━━━━━━━━━━
+ do maybe String
    - text String

= match text
    ~ tt (\o-first | \o-second)? "."
        "got ${tt ?? 0}"
    ?? "no match"

    .. o-first U32 ~
        ~ "a"
            10

    .. o-second U32 ~
        ~ "c"
            30

