# Alternatives of one arm capture a name as text and as what a rule gave.

for input in ["alpha!", "42!", "beta42!", "!"]
    -- match input
        ~ (text \changed | text [0-9]+ | text "") "!"
            "<${text}>"
        ~ text \changed tail [0-9]+ "!"
            "$text+$tail"
        ?? "none"

