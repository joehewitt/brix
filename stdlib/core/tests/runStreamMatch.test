+ CountingSource
    is ByteReadable

+ data Byte[]
+ limit Size
+ cursor Index
+ requests = List'Size()

────────────────────
+ This
    - data
    - limit

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

requests += size
. remaining = data.size - cursor
. wanted = if size < limit then size else limit
. amount = if remaining < wanted then remaining else wanted
if amount
    buffer[0 .. < amount] = data[cursor .. < cursor + amount]
    cursor += amount
= amount

