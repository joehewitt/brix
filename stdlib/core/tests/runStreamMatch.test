+ parse-words ImmutableArray'String
    - source String

match source
    ~ items \delimited(",", ~ \word) "!"
        items
    ?! Panic("word list did not parse")

    .. word String ~
        ~ [a-z]+

━━━━━━━━━━━━━━━━━━━━
_ do failed-words ImmutableArray'String

. builder = ArrayBuilder'String()
builder.append("failed")
= builder.finish-immutable()

