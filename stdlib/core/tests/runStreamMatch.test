+ do counted String
    - text String

= match text
    ~ items \c-line{2} rest .*
        "got ${items.length}: ${show(items)} then $rest"
    ?? "no match"

    .. c-line U32? ~
        ~ [0-9]
            null
        ~ "a"
            10

