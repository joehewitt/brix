:====
# A rule's value of a declared union type is read as it is under a helper whose value
# materializers take text: a union is made again only by a materializer that takes that union.

/core/atom-pool
/core/arena
/core/patterns

. helper = AtomPatternHelper(Arena())
for text in ["ab", "42", "ab42x", "?"]
    -- match text
        with helper
        ~ parsed \grammar(helper)
            helper.notes[parsed - 1]
        ?? "no match"
    -- "counts ${helper.string-capture-count} ${helper.string-value-count} ${helper.atom-capture-count} ${helper.atom-value-count}"

━━━━━━━━━━━━━━━━━━━━
+ grammar ~ Char NodeId
    - tree AtomPatternHelper

~ pieces \piece+
    tree.note(describe(pieces))

.. piece Piece ~
    ~ digits [0-9]+
        Piece.number(digits.length)
    ~ word [a-z]+
        Piece.word(word)

━━━━━━━━━━━━━━━━━━━━
+ Piece is Union

| number(count Size)
| word(text String)

━━━━━━━━━━━━━━━━━━━━
+ do describe String
    - pieces ImmutableArray'Piece

. shown = ""
for piece in pieces
    do match piece
        | .number(count)
            shown = "$shown#$count"
        | .word(text)
            shown = "$shown<$text>"
= shown

