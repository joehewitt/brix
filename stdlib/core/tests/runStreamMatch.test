    - text String

= match text
    ~ v \local-entry
        v
    ?? "no match"

    .. local-entry String ~
        ~ "#" rules \local-letters? "." body \local-word
            "first ${if rules then rules.length else 0} $body"
        ~ "@" rules \local-letters "." body \local-word?
            "second ${rules.length} ${body ?? "nothing"}"

    .. local-letters ImmutableArray'String ~
        ~ (letter [a-z])+
            letter

    .. local-word String ~
        ~ [a-z]+

