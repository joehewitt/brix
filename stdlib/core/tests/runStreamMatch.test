+ StagedSource
    is ByteReadable

+ first String
+ second String
+ read-count Size

────────────────────
+ This
    - first
    - second

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

. stage = ""
if read-count == 0
    stage = first
else if read-count == 1
    stage = second
read-count += 1
. bytes = stage as Byte[]
if bytes.size
    buffer[0 .. < bytes.size] = bytes
= bytes.size

