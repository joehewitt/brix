# A record that arrives one byte at a time continues where it stopped as each read arrives: every
# part of a pattern reads only the input it needs, an action runs once, and a record is given
# before any input after it is read.

/core/tokenstream

-- match trickle("hello world")
    ~ "hello" " " word [a-z]+
        word
    ?? "no literal"
-- match trickle("12345;")
    ~ digits [0-9]{3} rest [0-9]* ";"
        "$digits $rest"
    ?? "no count"
-- match trickle("abc")
    ~ &"ab" word [a-z]+
        "ahead $word"
    ?? "no lookahead"
-- match trickle("acd")
    ~ !"ab" word [a-z]+
        "not ahead $word"
    ?? "no negative lookahead"
-- match trickle("x")
    ~ "x" !.
        "ended"
    ?? "not ended"
-- match trickle("xy")
    ~ "x" !.
        "ended"
    ?? "not ended"
-- match trickle("abce")
    ~ word ("abcd" | "abce")
        "chose $word"
    ?? "no choice"
-- match trickle("key=value")
    ~ key \word "=" value \word
        "$key $value"
    ?? "no call"
-- match trickle("a" * 3000 ++ ";")
    ~ run [a]+ ";"
        "${run.length}"
    ?? "no run"
-- match ChunkedTokenStream'Byte(Trickle(Array'Byte(3000)))
    ~ data Byte{3000}
        "${data.size}"
    ?? "no bytes"
-- match ChunkedTokenStream'Byte(Trickle(Array'Byte([1u8, 0u8, 2u8])))
    ~ small U8 wide U16
        "$small $wide"
    ?? "no numbers"
. tally = Tally()
for word in trickle("one two three ") ~> \counted(tally)
    -- word
-- tally.count
. names = Trickle("ab;cd;" as Byte[])
for name in ChunkedTokenStream'Char(names) ~> \named
    -- "$name after ${names.cursor} bytes"
. frames = Trickle(Array'Byte([5u8, 0u8, 7u8]))
for frame in ~ Frame in ChunkedTokenStream'Byte(frames)
    -- "frame ${frame.size} after ${frames.cursor} bytes"
. failure = catch entries-of("ab;\ncd")
if failure is EntryError
    -- "error at ${(failure as EntryError).line}:${(failure as EntryError).column}"

