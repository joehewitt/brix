# An action whose pattern is an optional part reads `it` as the text the part matched, or nothing where its operand did not pass.

-- match "!"
    ~ "!"?
        it ?? "none"
    ?? "no match"
-- match ""
    ~ "!"?
        it ?? "none"
    ?? "no match"
-- match "abc"
    ~ ([a-z]*)?
        "<${it ?? "none"}>"
    ?? "no match"
-- match ""
    ~ ([a-z]*)?
        "<${it ?? "none"}>"
    ?? "no match"
-- match "abc"
    ~ ([a-z]+)?
        "<${it ?? "none"}>"
    ?? "no match"
-- match ""
    ~ ([a-z]+)?
        "<${it ?? "none"}>"
    ?? "no match"
-- match "!"
    ~ flag \bang
        if flag then "yes" else "no"
    ?? "no match"
    .. bang Bool ~
        ~ "!"?
            !!it
-- match ""
    ~ flag \bang
        if flag then "yes" else "no"
    ?? "no match"
    .. bang Bool ~
        ~ "!"?
            !!it

