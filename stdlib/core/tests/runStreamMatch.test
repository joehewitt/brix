~ name (!"\n" .)+ "\n"
    name

━━━━━━━━━━━━━━━━━━━━
+ field ~ Char String

~ name [a-z]+ ";"
    name

━━━━━━━━━━━━━━━━━━━━
+ TextSource
    is ByteReadable

+ data Byte[]
+ cursor Index

────────────────────
+ This
    - data

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

. remaining = data.size - cursor
. amount = if remaining < size then remaining else size
if amount
    buffer[0 .. < amount] = data[cursor .. < cursor + amount]
    cursor += amount
= amount

