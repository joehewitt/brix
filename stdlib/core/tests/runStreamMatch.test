+ grammar ~ Char
    - tree AtomPatternHelper

~ names \left
    tree.note(show(names))

.. left ImmutableArray'Atom ~
    ~ names \delimited(".", ~ \name)
        names

.. name Atom ~
    ~ [a-z] [-a-z0-9]*

