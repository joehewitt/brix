# A text-valued repeat yields the matched source, whether its item is an inline group, a rule
# call, a rule with an inner capture, or a counted or empty run

-- "1 [${capture-group("héllo 😀 wörld\nrest")}]"
-- "2 [${result-repeat("a\\|b `c|d` e|f")}]"
-- "3 [${wrapped("<one><two><three>!")}]"
-- "4 [${counted("aaaaab")}]"
-- "5 [${nested("ab cd  ef!")}]"
-- "6 [${empty-run("!!")}]"

━━━━━━━━━━━━━━━━━━━━
+ do capture-group String
    - text String

= match text
    ~ line (!"\n" .)* "\n" .*
        "$line|"
    ?? "<none>"

━━━━━━━━━━━━━━━━━━━━
+ do result-repeat String
    - text String

= match text
    ~ first \cell "|" rest .*
        "$first|$rest"
    ?? "<none>"

    .. cell String ~
        ~ \cell-part*

    .. cell-part ~
        ~ "\\|"
        ~ "`" (!"`" !"\n" .)* "`"
        ~ !("|" | "\n") .

━━━━━━━━━━━━━━━━━━━━
+ do wrapped String
    - text String

= match text
    ~ all \tags "!"
        all
    ?? "<none>"

    .. tags ~
        ~ \tag+

    .. tag ~
        ~ "<" inner \word ">"

    .. word ~
        ~ [a-z]+

