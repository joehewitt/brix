# A lazy local declared under an action's value may share its name with a name another arm
# captures.

for text in ["•a", "(b", "?"]
    -- match text
        ~ "•" expr [a-z]
            "got $expr"
        ~ "(" key [a-z]
            "made $expr"
                .. expr = "<$key>"
        ?? "none"

