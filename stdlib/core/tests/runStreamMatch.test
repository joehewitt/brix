# Over items of a union, a case named by its symbol matches one item that holds the case and
# gives what the case holds, or the item where it holds nothing, and a type the union has as a
# case matches one item that holds it and gives what it holds.

. events List'Event = [.press, Event.move(40), Event.move(95), .release, .press, .release, .typed("hi"), Spot(3, 4), .release]
for gesture in events ~> \gesture
    -- gesture

