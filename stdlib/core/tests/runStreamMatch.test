/core/arena
/core/tokenstream
/YuGC/YuGC.h

. scratch = Arena()
. arena = Arena()
. helper = SourceOwner(arena)
. source = Array'Char(scratch.allocate'Char(6), 6)
. input = "éabc😀!".codepoints
for i in 0 .. < input.length
    source[i] = input[i]
. stream = ArrayTokenStream'Char(source)
. text = match stream
    with helper
    ~ . [a-z]+ . "!"
        it
    ?! Panic("source it failed")
stream.cursor = 0
. atom = match stream
    with helper
    ~ \atom-word
    ?! Panic("atom it failed")

    .. atom-word Atom ~
        ~ . [a-z]+ . "!"
            it
stream.cursor = 0
. optional = match stream
    with helper
    ~ \optional-word
    ?! Panic("optional source failed")

    .. optional-word Atom? ~
        ~ . [a-z]+ . "!"
            it
stream.cursor = 0
. nested = match stream
    with helper
    ~ !("x" | "y") \nested-word
    ?! Panic("nested source failed")

    .. nested-word Atom ~
        ~ \source-word "?"
        ~ \source-word

    .. source-word Atom ~
        ~ . [a-z]+ . "!"

. empty = match ""
    with helper
    ~ [a-z]*
        it
    ?! Panic("empty source failed")
. transformed = match "ab!"
    with helper
    ~ [a-z]+ "!"
        it + "-changed"
    ?! Panic("transformed source failed")

scratch.reset()
for i in 0 .. < 20
    . later = match "later!"
        with helper
        ~ [a-z]+ "!"
            it
    C:yumiGCCollect()

-- text
-- atom.text
-- optional!.text
-- nested.text
-- empty.length
-- transformed
-- arena.owns((text as Atom).address as Pointer)
-- arena.owns(atom.address as Pointer)
-- arena.owns(optional!.address as Pointer)
-- arena.owns(nested.address as Pointer)
scratch.release()
arena.release()

