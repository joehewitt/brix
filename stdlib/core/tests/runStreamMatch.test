# A name the arms of a rule capture holds in each arm the type its part there gives it.

-- describe("#123")
-- describe("@abc")
-- describe("?")
-- describe("?x")
-- describe("%")
-- match "@abc"
    ~ v \entry
        v
    ?? "no match"
-- match "?"
    ~ v \entry
        v
    ?? "no match"

━━━━━━━━━━━━━━━━━━━━
+ do describe String
    - text String

= match text
    ~ v \local-entry
        v
    ?? "no match"

    .. local-entry String ~
        ~ "#" value \local-number
            "number ${value + 1}"
        ~ "@" value [a-z]+
            "word $value"
        ~ "?" value ([a-z]+)?
            "maybe ${value ?? "nothing"}"

    .. local-number I32 ~
        ~ digits [0-9]+
            digits.length as I32

━━━━━━━━━━━━━━━━━━━━
+ entry ~ Char String

~ "#" value \number
    "number ${value + 1}"
~ "@" value [a-z]+
    "word $value"
~ "?" value ([a-z]+)?
    "maybe ${value ?? "nothing"}"

.. number I32 ~
    ~ digits [0-9]+
        digits.length as I32

