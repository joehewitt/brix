# A guard, a lookahead of a test that reads no item, needs no input of its own: a record that
# ends in a part that takes nothing is given as soon as its last item is read, a guard passes at
# the end of the input, a negative guard passes where its condition does not hold, and a
# lookahead of a test that reads `it` still needs the item.

/core/tokenstream

for size in ChunkedTokenStream'Byte(Trickle(Array'Byte([0u8, 0u8, 2u8, 7u8, 8u8]))) ~> \guarded(4)
    -- "record $size"
-- match Array'Byte([0u8])
    ~ size U8 &\{ size <= 4 } data Byte{size}
        "kept ${data.size}"
    ?? "refused"
-- match Array'Byte([9u8])
    ~ size U8 !\{ size <= 4 }
        "too big"
    ?? "fits"
-- match Array'Byte([3u8])
    ~ size U8 &\{ it == 5 }
        "next is 5"
    ?? "no next"

