_ current Int = 1

-- eager()
current = 1
-- deferred()

━━━━━━━━━━━━━━━━━━━━
+ do eager Int

. snapshot = current
?! Panic("unexpected")
    if advance()
= snapshot

━━━━━━━━━━━━━━━━━━━━
+ deferred Int

?! Panic("unexpected")
    if advance()
snapshot
    .. snapshot = current

━━━━━━━━━━━━━━━━━━━━
+ do advance Bool

current = 2
= false

