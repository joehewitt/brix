# A tracked read of a list follows changes made to the list in place.

/core/tests/support/markup-fixtures

. demo = Demo()
-- demo.label()
demo.items += "a"
-- demo.label()
demo.items += "b"
-- demo.label()
demo.items[0] = "z"
-- demo.label()
demo.items.remove(0)
-- demo.label()
. old = demo.items
demo.items = List'String()
-- demo.label()
old += "stale"
-- demo.label()
demo.items += "c"
-- demo.label()

━━━━━━━━━━━━━━━━━━━━
+ Demo is Box

+ items [String] = List'String()

────────────────────

<This
    <TextBox = "${#items.length} ${",".join(#items)}"
    if #items.length > 1
        <TextBox = "many"

────────────────────
+ do label String

. texts [String]
collect(this, texts)
= "${texts.length}:${"|".join(texts)}"

────────────────────
+ do collect
    - node Box
    - texts [String]

for child in node.children
    if child is TextBox
        texts += (child as TextBox).text
    collect(child, texts)
