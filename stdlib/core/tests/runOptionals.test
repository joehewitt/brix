    -- "chain"
. same = a == c
. differ = a != c
-- same
-- differ
-- check(a, c)
-- check(a, b)
-- check(b, b)
-- (if a == c then 1 else 2)
while a != c
    -- "never"
. box = Box()
-- box.value == a
-- box.value != box.other
-- box.other == box.other
box.other = 3
-- box.other == a
-- box.missing() == box.value
-- box.missing() == box.missing()

