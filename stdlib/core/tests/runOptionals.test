# Conditional structure matches flatten optional transform results

-- type-of maybe(true, false)
if maybe(true, false)
    -- "inner false passed"
else
    -- "inner false failed"
if maybe(false, false)
    -- "outer false passed"
else
    -- "outer false failed"
if maybe(true, true)
    -- maybe(true, true)!
