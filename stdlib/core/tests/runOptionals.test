/core/atom-pool

# An optional atom field of a tuple, once a test finds it holds a value, is read as the atom it
# holds, and still is after it is compared with an optional atom.

. pool = AtomPool()
. box Atom? = pool.store("box")
. lid Atom? = pool.store("lid")
. a = check(Square(pool.store("box")), box, lid)
. b = check(Square(null), box, lid)
. c = check(Square(pool.store("lid")), box, lid)
. d = check(Square(pool.store("cap")), box, lid)
-- "$a $b $c $d"

━━━━━━━━━━━━━━━━━━━━
+ check Bool
    - row Square
    - first Atom?
    - second Atom?

|? !row.name
    false
??
    row.name == first || row.name == second

