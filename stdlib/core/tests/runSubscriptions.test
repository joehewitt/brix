;====
:====
# An event assigned to a property of the event's Broadcastable is the event's endpoint, as a
# declaration of that type takes it.

. first = Source()
. second = Source()
. listener = Listener(first.changed)
listener.swap(second)
listener.start()
<- listener.ready
first.changed <- 4
second.changed <- 6
second.changed <- 7

━━━━━━━━━━━━━━━━━━━━
+ Source

+ event changed Int

━━━━━━━━━━━━━━━━━━━━
+ Listener

+ source Broadcastable'Int
+ ready SyncChannel'Bool

────────────────────
+ This
    - source

────────────────────
+ do swap
    - other Source

source = other.changed

────────────────────
+ do start

do new
    for value on source
        -- "got $value"
    ready <- true

:----

got 6
got 7
