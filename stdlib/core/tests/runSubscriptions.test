# A subscriber runs on the queue of the task that subscribed, whichever thread publishes.

. worker = Worker(1)
. numbers AsyncChannel'Int
. done Int<>
place = "main"
for n on numbers
    -- "$n on $place"
    done <- n
do (worker) new
    place = "worker"
    numbers <- 1
-- "read ${<- done}"
numbers <- 2
-- "read ${<- done}"
worker.stop()

+ @thread place = "unset"

