-- even-warning(2)

━━━━━━━━━━━━━━━━━━━━
+ do even-warning Bool @inline
    - value Int

if value == 0
    = true
= odd-warning(value - 1)

━━━━━━━━━━━━━━━━━━━━
+ do odd-warning Bool @inline
    - value Int

if value == 0
    = false
= even-warning(value - 1)

