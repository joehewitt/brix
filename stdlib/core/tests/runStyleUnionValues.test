━━━━━━━━━━━━━━━━━━━━
+ BatchDemo is Box
    is MarkupBatch

+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
+ Stamp

+ tag I64

────────────────────
+ This
    - tag

━━━━━━━━━━━━━━━━━━━━
+ Paint is Union

| level(n U8)
| stamped(stamp Stamp)

━━━━━━━━━━━━━━━━━━━━
+ PaintStyle is Style

+ fill Paint = Paint.level(1)

━━━━━━━━━━━━━━━━━━━━
+ Swatch is Box
    using PaintStyle

+ stamp = Stamp(1)

• This
    fill = Paint.stamped(#stamp)

────────────────────
+ label String

match $fill
    | .level(n)
        "level($n)"
    | .stamped(stamp)
        "stamped(${stamp.tag})"

:----

stamped(1)
stamped(2)
