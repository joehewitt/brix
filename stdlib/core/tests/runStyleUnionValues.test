;====
:====
# Dynamic declarations switch among inline, wide, and descriptor union cases. Forced collection
# reclaims replaced weak handles without disturbing mounted reads; ordinary unmount preserves the
# owner template for remount, and owner reclaim clears the last holder.

/core/style
/core/style-debug
/core/markup
/core/task
/core/tests/support/markup-fixtures
/YuGC/YuGC.h

. done = Semaphore()

<BatchDemo demo

. base = churn-paints(demo, done)
C:yumiCollect()
do C:yumiGCDrainCleanups()
-- "reclaimed=${style-object-live-count() - base}"

━━━━━━━━━━━━━━━━━━━━
+ do churn-paints Size
    - demo BatchDemo
    - done Semaphore

.. mode = 0

<Swatch swatch
    fill = paint-for(#mode)
markup-append(demo, swatch)

demo.markup-batch-queue.checkpoint()
. base = style-object-live-count()
-- demo.paint-of(swatch)
-- "live=${style-object-live-count() - base}"

mode = 1
do new
    demo.markup-batch-queue.checkpoint()
    -- demo.paint-of(swatch)
    C:yumiCollect()
    do C:yumiGCDrainCleanups()
    -- "live=${style-object-live-count() - base}"
    done.post()
done.wait()

mode = 2
do new
    demo.markup-batch-queue.checkpoint()
    -- demo.paint-of(swatch)
    C:yumiCollect()
    do C:yumiGCDrainCleanups()
    -- "live=${style-object-live-count() - base}"
    done.post()
done.wait()

mode = 3
do new
    demo.markup-batch-queue.checkpoint()
    -- demo.paint-of(swatch)
    C:yumiCollect()
    do C:yumiGCDrainCleanups()
    -- "live=${style-object-live-count() - base}"
    markup-remove(demo, swatch)
    demo.markup-batch-queue.checkpoint()
    -- "unmounted=${style-object-live-count() - base}"
    markup-append(demo, swatch)
    demo.markup-batch-queue.checkpoint()
    C:yumiCollect()
    do C:yumiGCDrainCleanups()
    -- "remounted=${demo.paint-of(swatch)} live=${style-object-live-count() - base}"
    markup-remove(demo, swatch)
    demo.markup-batch-queue.checkpoint()
    done.post()
done.wait()
= base

