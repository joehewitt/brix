.. has-accent = false
. done = Semaphore()

<BatchDemo demo
    <Swatch plain
    <Swatch fancy
        accent = TestPaint.tint(0.5, 0.25, 0.75, 1)
    <Swatch toggly
        accent = accent-for(#has-accent)
    <Swatch veiled
        veil = RGBA(0.25, 0.25, 0.5)

demo.markup-batch-queue.checkpoint()

-- demo.accent-of(plain)
-- demo.accent-of(fancy)
-- demo.accent-of(toggly)
-- demo.veil-of(veiled)
-- demo.veil-of(plain)

has-accent = true
do new
    demo.markup-batch-queue.checkpoint()
    -- demo.accent-of(toggly)
    done.post()
done.wait()

has-accent = false
do new
    demo.markup-batch-queue.checkpoint()
    -- demo.accent-of(toggly)
    done.post()
done.wait()

