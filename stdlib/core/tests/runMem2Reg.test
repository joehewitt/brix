:====
# mem2reg: a loop-carried single local should converge to the final value

. a = 3
while a > 0
    a -= 1
-- a

:----

0
;====
:====
# mem2reg: multiple loop-carried locals should keep their own values

. a = 2
. b = 20
while a > 0
    a -= 1
    b -= 10
-- a
-- b

:----

0
0
