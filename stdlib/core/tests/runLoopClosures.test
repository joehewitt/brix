# Closures in turns of a loop with a clause, left by `continue` and by `break`, in a loop that takes its item apart, and in one that names no item.

. getters = List'(Getter'Int)()
for index in 1 .. 6 when index % 2 == 0
    if index == 4
        continue
    getters += => index
for a, b in [(1, 2), (3, 4)]
    getters += => a * 10 + b
for in 1 .. 2
    getters += => each + it
for n in 1 .. 10
    . squared = n * n
    getters += => squared
    if n == 2
        break
for getter in getters
    -- getter()

