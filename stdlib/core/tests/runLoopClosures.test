:====
# A closure in a while condition can read a variable the loop body changes.

. number = 1
. taken = ["a-1", "a-2"]
while holds(taken) • where each == "a-$number"
    number += 1
-- number

━━━━━━━━━━━━━━━━━━━━
+ do holds'Item
    - stream <Item>
    - where Predicate'Item

for item in stream
    if where(item)
        = true
= false

