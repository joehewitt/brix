# A lazy local of a turn is evaluated once for the turn, by whichever closure or statement reads it first

. readers = List'(Getter'Int)()
for index in 1 .. 3
    .. heavy = noisy(index)
    . one Getter'Int = => heavy
    . two Getter'Int = => heavy + 1
    if index == 2
        -- "early $heavy"
    readers += one
    readers += two
    if index == 3
        readers += => index
-- "made"
for reader in readers
    -- reader()
-- unread(3)
for text in stepped()
    -- text

