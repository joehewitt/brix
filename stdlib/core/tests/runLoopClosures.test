# A lazy local that closures capture reads a local of its function and one of its turn

-- lazily(3)
-- twice(4)

━━━━━━━━━━━━━━━━━━━━
+ do lazily Int
    - limit Int

. base = limit * 2
.. heavy = base * 1000
. first Getter'Int = => heavy
= first()

━━━━━━━━━━━━━━━━━━━━
+ do twice Int
    - limit Int

. total = 0
for index in 1 .. limit
    . scale = index * 10
    .. heavy = scale + 1
    . read Getter'Int = => heavy
    total += read() + heavy
= total

