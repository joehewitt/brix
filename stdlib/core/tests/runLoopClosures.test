+ do run Int
    - base Int

. total = 0
. getters = List'(Getter'Int)()
. plain = List'(Getter'Int)()
for index in 1 .. 3
    . local = index * base
    getters += => local + base
    plain += => base
    . add = => do total += local
    add()
. sum = total
for getter in getters
    sum += getter()
for getter in plain
    sum += getter()
= sum

