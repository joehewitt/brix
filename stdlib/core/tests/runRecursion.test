# A panic from a recursive call stops the caller, directly and through mutual recursion.

+ count = 0

-- sum(4)
guard(=> do countdown(2))
guard(=> do ping(3))

━━━━━━━━━━━━━━━━━━━━
+ do guard
    - body

do finally
    . panic = recover()
    -- "count $count, $panic"
    count = 0
body()

━━━━━━━━━━━━━━━━━━━━
+ do sum Int
    - n Int

=? 0 if n == 0
= n + sum(n - 1)

━━━━━━━━━━━━━━━━━━━━
+ do countdown
    - n Int

if n > 0
    countdown(n - 1)
    count += 1
?! Panic("countdown $n")

━━━━━━━━━━━━━━━━━━━━
+ do ping
    - n Int

if n > 0
    pong(n - 1)
    count += 1
?! Panic("ping $n")

━━━━━━━━━━━━━━━━━━━━
+ do pong
    - n Int

ping(n)
count += 10

:----

10
count 0, countdown 0
count 0, ping 0
;====
