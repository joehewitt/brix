# A module imported by two paths that name one file, one through `..`, is one module, whose types are the same type.

/core/arena
/core/../core/arena

. arena = use Arena()
-- "ok ${make(arena)}"

━━━━━━━━━━━━━━━━━━━━
_ make Int
    - arena Arena

3

