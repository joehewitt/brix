# A branch on a comparison of integers that are only known when the program runs, and a branch on
# each negated comparison, takes the path the comparison's value names, signed or unsigned.

. values = [3, 5, 7]
for x in values
    signed-paths(x, values[1])
. large = [3u64, 18446744073709551615u64]
unsigned-paths(large[0], large[1])
unsigned-paths(large[1], large[0])
unsigned-paths(large[1], large[1])

━━━━━━━━━━━━━━━━━━━━
+ do signed-paths
    - x I64
    - y I64

. taken = ""
if x < y
    taken = "$taken <"
if !(x < y)
    taken = "$taken !<"
if !(x <= y)
    taken = "$taken !<="
if !(x > y)
    taken = "$taken !>"
if !(x >= y)
    taken = "$taken !>="
if x == y
    taken = "$taken =="
if !(x == y)
    taken = "$taken !=="
if !(x != y)
    taken = "$taken !!="
-- "$x ? $y:$taken"

━━━━━━━━━━━━━━━━━━━━
+ do unsigned-paths
    - x U64
    - y U64

. taken = ""
if x < y
    taken = "$taken <"
if !(x < y)
    taken = "$taken !<"
if !(x <= y)
    taken = "$taken !<="
if !(x > y)
    taken = "$taken !>"
if !(x >= y)
    taken = "$taken !>="
-- "$x ? $y:$taken"

:----

3 ? 5: < !> !>= !==
5 ? 5: !< !> == !!=
7 ? 5: !< !<= !==
3 ? 18446744073709551615: < !> !>=
18446744073709551615 ? 3: !< !<=
18446744073709551615 ? 18446744073709551615: !< !>
