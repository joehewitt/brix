# A negated ordering of floats holds when either is not a number, where the opposite ordering
# would not. A negated equality is the opposite equality.

. zero = 0.0f64
. values = [1.0f64, 2.0f64, zero / zero]
for x in values
    float-paths(x, values[1])
float-paths(values[1], values[2])

━━━━━━━━━━━━━━━━━━━━
+ do float-paths
    - x F64
    - y F64

. taken = ""
if x < y
    taken = "$taken <"
if !(x < y)
    taken = "$taken !<"
if !(x <= y)
    taken = "$taken !<="
if !(x > y)
    taken = "$taken !>"
if !(x >= y)
    taken = "$taken !>="
if x == y
    taken = "$taken =="
if !(x == y)
    taken = "$taken !=="
if !(x != y)
    taken = "$taken !!="
-- "paths:$taken"

:----

paths: < !> !>= !==
paths: !< !> == !!=
paths: !< !<= !> !>= !==
paths: !< !<= !> !>= !==
