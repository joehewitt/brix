0: ==0 <3 !>=255
3: !>=255
255: ==255
-128: ==-128 <0 !>-1
-1: ==-1 <0 !>-1
0:
127: ==127
4095: ==4095
4096: ==4096
65535: ==65535 >4096
-32768: ==-32768 <0
-1: ==-1 <0
4095: ==4095
-1: ==-1 <0
0: ==0
4096: ==4096
-1: ==-1 !>=4097
4095: ==4095 !>=4097
4096: ==4096 !>=4097
4097: ==4097 >4096
16773120: ==16773120 >4096
true: flag !=other !==other
false: !flag !=other !==other
