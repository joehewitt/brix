# A branch on a comparison with a literal takes the same path at the edges of each integer width,
# and a branch on a Bool or its negation follows the Bool.

for x in [0u8, 3u8, 255u8]
    byte-edges(x)
for x in [-128i8, -1i8, 0i8, 127i8]
    signed-byte-edges(x)
for x in [4095u16, 4096u16, 65535u16]
    short-edges(x)
for x in [-32768i16, -1i16, 4095i16]
    signed-short-edges(x)
for x in [-1i32, 0i32, 4096i32]
    word-edges(x)
for x in [-1i64, 4095i64, 4096i64, 4097i64, 16773120i64]
    wide-edges(x)
for flag in [true, false]
    flag-paths(flag, !flag)

━━━━━━━━━━━━━━━━━━━━
+ do byte-edges
    - x U8

. taken = ""
if x == 0u8
    taken = "$taken ==0"
if x == 255u8
    taken = "$taken ==255"
if x < 3u8
    taken = "$taken <3"
if !(x >= 255u8)
    taken = "$taken !>=255"
-- "$x:$taken"

━━━━━━━━━━━━━━━━━━━━
+ do signed-byte-edges
    - x I8

. taken = ""
if x == -128i8
    taken = "$taken ==-128"
if x == -1i8
    taken = "$taken ==-1"
if x == 127i8
    taken = "$taken ==127"
if x < 0i8
    taken = "$taken <0"
if !(x > -1i8)
    taken = "$taken !>-1"
-- "$x:$taken"

