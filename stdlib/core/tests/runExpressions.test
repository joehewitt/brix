━━━━━━━━━━━━━━━━━━━━
+ do flag-paths
    - flag Bool
    - other Bool

. taken = ""
if flag
    taken = "$taken flag"
if !flag
    taken = "$taken !flag"
if flag == other
    taken = "$taken ==other"
if flag != other
    taken = "$taken !=other"
if !(flag == other)
    taken = "$taken !==other"
-- "$flag:$taken"

