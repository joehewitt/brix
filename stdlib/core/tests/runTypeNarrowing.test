;====
:====
# Assignment to a narrowed optional name updates the original.

. value Int? = 41
if value
    value = 10
    -- value + 1

-- value ?? 0
. total Int? = 1
. other Int? = 2
if other && total
    total = total + other
-- total ?? 0
. missing Int?
if missing
    missing = 0
else if total
    total = total * 10
else
    total = null
-- total ?? 0
. cleared Int? = 5
if cleared
    cleared = null
-- cleared ?? 0

:----
