;====
:====
# Narrowing carries into a loop when every back edge keeps it, and re-checks see the current value.

. value Int? = 1
if value
    for step in [1, 2]
        -- value + step
        value = value + 10
. count Int? = 3
if count
    while count && count > 0
        -- count
        count = count - 1 if count > 1
. choice Choice = "hi"
if choice is String
    for step in [1, 2]
        if choice is String
            -- choice.length
        else
            -- "int"
        choice = 4
-- guarded(3)
-- guarded(null)

━━━━━━━━━━━━━━━━━━━━
+ Choice is Union

| Int
| String

