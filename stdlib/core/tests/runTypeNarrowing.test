:====
# Optional-chain receivers keep their optional wrapper after path narrowing.

. anchor Node? = Node()
. previous = Node()
anchor!.previous = previous
. child = Node()

if anchor
    . target = anchor
    child.previous = target.previous
    child.next = target
    if target.previous
        target.previous.next = child
    target.previous = child

if previous.next
    -- "linked"

