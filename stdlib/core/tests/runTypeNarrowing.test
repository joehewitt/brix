10
3
30
0
;====
:====
# Branch assignments to narrowed locals carry across loop iterations.

. values [Int?]
values += 5
values += null
values += 7
. total Int?
for value in values
    if value && total
        total = total + value
    else if value
        total = value
-- total ?? 0
. items [Pair?]
items += Pair(1, 2)
items += Pair(3, 4)
. merged Pair?
for item in items
    if item && merged
        merged = Pair(merged.x + item.x, merged.y + item.y)
    else
        merged = item
-- merged!.x
-- merged!.y

