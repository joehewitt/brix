tree.is-focused = true
demo.markup-batch-queue.checkpoint()
-- inks(tree)
tree.item.is-selected = true
demo.markup-batch-queue.checkpoint()
-- inks(tree)
((tree.rows.%first-child!.child-at(1))!.%first-child! as Item).is-selected = true
demo.markup-batch-queue.checkpoint()
-- inks(tree)
tree.is-focused = false
demo.markup-batch-queue.checkpoint()
-- inks(tree)

