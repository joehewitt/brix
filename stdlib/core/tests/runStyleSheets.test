. names = ["a", "b"]

<BatchDemo demo
    <Tree tree
        names = names
        <Leaf (row) - name
            name = name

demo.markup-batch-queue.checkpoint()
-- leaf-inks(tree)
item-at(tree, 1).is-selected = true
demo.markup-batch-queue.checkpoint()
-- leaf-inks(tree)
tree.region.is-keyed = true
demo.markup-batch-queue.checkpoint()
-- leaf-inks(tree)
tree.region.is-keyed = false
((tree.region.%first-child!.child-at(0))! as Cell).is-marked = true
demo.markup-batch-queue.checkpoint()
-- leaf-inks(tree)

