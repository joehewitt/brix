# Reads drain what an AsyncBufferedChannel buffered before it closed, and later writes are dropped

. numbers = AsyncBufferedChannel'Int()
numbers <- 1
numbers <- 2
numbers.close()
numbers <- 3
-- <- numbers
-- <- numbers
. rest = <- numbers
-- if !rest then "drained" else "left $rest"

:------------------------------------------------------------------------------------------------

1
2
drained
