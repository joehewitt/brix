. worker = Worker(1)
. to-worker SyncChannel'Int
. from-worker SyncChannel'Int

do (worker) new
    for i in 0 .. < 200
        . n = <- to-worker
        if n != i
            ?! Panic("worker received $n instead of $i")
        from-worker <- i

for i in 0 .. < 200
    to-worker <- i
    . n = <- from-worker
    if n != i
        ?! Panic("main received $n instead of $i")

-- "done"

:----

done
