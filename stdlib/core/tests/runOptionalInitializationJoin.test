:====
# A table of conditions run as a statement, with arms that return, beside if and else arms that print

-- classify(5)
-- classify(-5)
-- classify(0)
show(1)
show(2)
show(3)

━━━━━━━━━━━━━━━━━━━━
+ do classify String
    - n Int

|? n > 0
    = "plus"
|? n < 0
    = "minus"
= "zero"

━━━━━━━━━━━━━━━━━━━━
+ do show
    - n Int

if n == 1
    -- "one"
else if n == 2
    -- "two"
else
    -- "many"
-- "done $n"

:----

plus
minus
zero
one
done 1
two
done 2
many
done 3
;====
:====
# A table of conditions over optionals narrows each in its arm

-- first(3, null)
-- first(null, 4)
-- first(null, null)
-- first(0, 9)

━━━━━━━━━━━━━━━━━━━━
+ do first Int
    - a Int?
    - b Int?

|? a
    = a + 1
|? b
    = b + 2
= 0

:----

4
6
0
1
;====
