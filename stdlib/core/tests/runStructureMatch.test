        -- "int"
    ??
        -- "other"

:----

int
list
other
int
list
;====
:====
# The arm of a match that takes whatever is left may itself hold a match.

-- pick(1, 1)
-- pick(2, 1)
-- pick(2, 2)

━━━━━━━━━━━━━━━━━━━━
+ pick String
    - a Int
    - b Int

match a
    |= 1
        "first"
    ??
        match b
            |= 1
                "second"
            ??
                "neither"

:----

first
second
neither
;====
:====
# A case named over an optional union binds what the case holds.

-- show(.optional("q"))
-- show(.buffer("b"))
-- show(null)

━━━━━━━━━━━━━━━━━━━━
+ Suffix is Union

| optional(name String)
| buffer(name String)

━━━━━━━━━━━━━━━━━━━━
+ show String
    - suffix Suffix?

match suffix
    | .optional(name)
        "optional $name"
    | .buffer(name)
        "buffer $name"
    ??
        "none"

:----

optional q
buffer b
none
;====
:====
# A match whose every arm returns or raises ends a `do` function that gives a value.

-- size-of(3)
-- (catch? size-of(-3)) ?? 99

━━━━━━━━━━━━━━━━━━━━
+ do size-of Int ?! Error
    - value Int

match value
    | number Int {it >= 0}
        = number
    ?! Error("negative")

:----

3
99
;====
:====
# A comprehension over a pattern naming a case of a union keeps the items holding that case, as the union.

. items [Pick] = [.first, .third(4), .second, .third(5)]
for pick in <* .third in items
    -- pick is .third
    -- match pick
        | .third(n)
            n
        ??
            0

━━━━━━━━━━━━━━━━━━━━
+ Pick is Union

| first
| second
| third(Int)

