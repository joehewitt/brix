# Break and continue in a pattern loop inside another loop


. outer = 0
while outer < 3
    . inner = 0
    while | step {it < 5} = inner
        inner += 1
        if step == 1
            continue
        if step == 3
            break
        -- "outer $outer step $step"
    -- "left inner at $inner"
    outer += 1
-- "end"

:----

outer 0 step 0
outer 0 step 2
left inner at 4
outer 1 step 0
outer 1 step 2
left inner at 4
outer 2 step 0
outer 2 step 2
left inner at 4
end
