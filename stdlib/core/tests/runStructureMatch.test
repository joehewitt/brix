:====
# A match statement's arm may hold a value chosen by conditions, written as a statement.

-- fill(2)
-- fill(5)

━━━━━━━━━━━━━━━━━━━━
+ do fill String
    - size Int

. out = Int[3]
do match size
    |= 2
        for index in 0 .. < 3
            out[index] =
                |? index == 1
                    10
                ??
                    20
    ??
        out[0] = 1
= "${out[0]} ${out[1]} ${out[2]}"

:----

20 10 20
1 0 0
;====
:====
# A pattern that names a generic class without its arguments, with a guard, gives the guard's `it` the class the case it matches holds.

. pair Item = ["a", "b"] as [Item]
. single Item = "c"
-- describe(pair)
-- describe(single)

━━━━━━━━━━━━━━━━━━━━
+ Item is Union

| String
| [Item]

━━━━━━━━━━━━━━━━━━━━
_ describe String
    - value Item

match value
    | items List~ {it.length == 2}
        "pair ${items.length}"
    ??
        "other"

:----

pair 2
other
;====

:====
# A generic class written bare matches the case of a union that is of the class, not one that only converts to it.

. items [Value]
items += 1 as Value
-- after-data(items as Value)
-- after-data(Byte[2] as Value)
-- alone(items as Value)
-- alone(Byte[2] as Value)

━━━━━━━━━━━━━━━━━━━━
+ Value is Union

| Int
| Byte[]
| [Value]

━━━━━━━━━━━━━━━━━━━━
_ do after-data String
    - value Value

do match value
    | number Int
        = "$number"
    | data Byte[]
        = "data ${data.size}"
    | list List~
        = "list ${list.length}"

━━━━━━━━━━━━━━━━━━━━
_ do alone String
    - value Value

do match value
    | number Int
        = "$number"
    | list List
        = "list ${list.length}"
    ??
        = "other"

:----

list 1
data 2
list 1
other
;====

:====
# Arms after a null arm read the subject, named or as it, as what it holds, and so does what
# follows a match statement whose null arm leaves.

-- by-it(null)
-- by-it(Holder())
-- by-name(null)
-- by-name(Holder())
-- after-tests(Holder())
-- after-statement(null)
-- after-statement(Holder())

━━━━━━━━━━━━━━━━━━━━
+ Holder

+ count = 3

━━━━━━━━━━━━━━━━━━━━
+ by-it Int
    - held Holder?

match held
    |= null
        0
    |? it.count > 5
        1
    ??
        it.count

━━━━━━━━━━━━━━━━━━━━
+ by-name Int
    - held Holder?

match held
    |= null
        0
    ??
        held.count

━━━━━━━━━━━━━━━━━━━━
+ after-tests Int
    - held Holder?

match held
    |? it == null
        0
    |= null
        1
    |? held.count > 1
        held.count + 10
    ??
        held.count

━━━━━━━━━━━━━━━━━━━━
+ do after-statement Int
    - held Holder?

do match held
    |= null
        = 0
    ??
        -- held.count
= held.count + 100

