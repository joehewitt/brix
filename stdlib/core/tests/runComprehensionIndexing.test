:====

. bag = Bag()
bag.items += "a"
bag.items += "b"
bag.items += "c"
-- " ".join((each in bag.upto(2)))

━━━━━━━━━━━━━━━━━━━━
+ Bag

+ items [String] = List'String()

────────────────────
+ do upto [String]
    - index Index

= List'String(items[each] in 0 .. < index)

:----

a b
;===
:====

. bag = Bag()
bag.items += "a"
bag.items += "b"
bag.items += "c"
-- " ".join((each in bag.upto(2)))

━━━━━━━━━━━━━━━━━━━━
+ Bag

+ items [String] = List'String()

────────────────────
+ do upto [String]
    - count Index

for item in items
    if item.length > 0
        = List'String(items[each] in 0 .. < count)
= List'String()

