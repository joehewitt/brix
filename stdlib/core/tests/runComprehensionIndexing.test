:====

. bag = Bag()
bag.items += "a"
bag.items += "b"
bag.items += "c"
bag.ranges += Stretch(1, 3)
-- " ".join((each in bag.stretch(0)))

━━━━━━━━━━━━━━━━━━━━
+ Stretch is Tuple

+ start Index
+ end Index

━━━━━━━━━━━━━━━━━━━━
+ Bag

+ items [String] = List'String()
+ ranges [Stretch] = List'Stretch()

────────────────────
+ do stretch [String]
    - index Index

for range in ranges
    if range.end > 0
        . picked = List'String(items[each] in ranges[index].start .. < ranges[index].end)
        picked += "!"
        = picked
= List'String()

