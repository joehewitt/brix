. bag = Bag()
bag.items += "a"
bag.items += "b"
bag.items += "c"
-- " ".join((each in bag.middle(0, 2)))

━━━━━━━━━━━━━━━━━━━━
+ Bag

+ items [String] = List'String()

────────────────────
+ do middle [String]
    - start Index
    - end Index

= List'String(items[each] in start .. < end)

