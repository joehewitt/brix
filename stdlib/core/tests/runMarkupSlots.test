:====
# Demonstrates named slots, default slot routing, declaration order, and slot overlay updates.

. title = "Settings"

<Panel panel
    <MarkText (header) = #title
    <MarkText = "body one"
    <MarkText = "body two"

-- text-at(panel, 0)
-- text-at(panel, 1)
-- text-at(panel, 2)
-- text-at(panel, 3)
-- count-children(panel)
title = "Account"
panel.footer-label = "Done"
-- text-at(panel, 0)
-- text-at(panel, 1)

<OrderedPanel ordered
    <MarkText (beta) = "B"
    <MarkText (alpha) = "A"
-- text-at(ordered, 0)
-- text-at(ordered, 1)

<OverlayPanel overlay
    <MarkText (header) = "caller"
-- text-at(overlay, 0)
overlay.header-title = "Updated"
-- text-at(overlay, 0)

━━━━━━━━━━━━━━━━━━━━
+ text-at String
    - node MarkNode
    - index Index

((node.child-at(index))! as MarkText).text

━━━━━━━━━━━━━━━━━━━━
+ do count-children
    - node MarkNode

. count = 0
for child in node.children
    count += 1
= count

━━━━━━━━━━━━━━━━━━━━
+ MarkNode
    is MarkupParent'MarkNode

+ parent MarkNode?
+ first-child MarkNode?
+ last-child MarkNode?
+ previous MarkNode?
+ next MarkNode?

────────────────────
+ do get children

. maybe-child = first-child
if maybe-child
    . child = maybe-child
    while true
        <= child
        if !child.next
            break
        child = child.next

────────────────────
+ do child-at MarkNode?
    - index Index

. cursor Index = 0
for child in children
    if cursor == index
        = child
    cursor += 1

────────────────────
+ markup-content MarkNode
    - child MarkNode

child

────────────────────
+ do markup-attach-child
    - child MarkNode
    - anchor MarkNode?

child.parent = this
if !first-child
    first-child = last-child = child
else
    last-child?.next = child
    child.previous = last-child
    last-child = child

━━━━━━━━━━━━━━━━━━━━
+ MarkText is MarkNode

+ text String

────────────────────
+ This
    - text String

━━━━━━━━━━━━━━━━━━━━
+ Panel is MarkNode

+ footer-label = "Foot"

────────────────────
+ <MarkText header
+ <MarkText footer
    <MarkText = #footer-label

━━━━━━━━━━━━━━━━━━━━
+ OrderedPanel is MarkNode

────────────────────
+ <MarkText alpha
+ <MarkText beta

━━━━━━━━━━━━━━━━━━━━
+ OverlayPanel is MarkNode

+ header-title = "Overlay"

────────────────────
+ <MarkText header
    text = #header-title

