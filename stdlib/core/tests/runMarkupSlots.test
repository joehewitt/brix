# A repeated slot outlet inside a keyed row rebuilds its caller content when the row item is
# replaced by a new object under the same key, while the physical row is preserved. Arguments
# passed through a derived local follow the replacement too.

/core/tests/support/markup-fixtures

. items = List'RowData([RowData("a", "A"), RowData("b", "B")])
<KeyedSlotPanel panel
    items = items
    <TextBox (row) - item = item.text
    <TextBox (label) - item = "${item.text}~"

. region = panel.%first-child!
. first = region.%first-child!
-- slot-texts(panel)
items[0] = RowData("a", "Z")
-- slot-texts(panel)
-- if first == region.%first-child! then "preserved" else "lost"
items[1] = RowData("b", "B")
-- slot-texts(panel)

