+ do describe String
    - node Box

. text = ""
if node is TextBox
    text = (node as TextBox).text
. child = node.%first-child
if child
    text = text ++ "["
    while child
        text = text ++ describe(child) ++ " "
        child = child.%next-sibling
    text = text ++ "]"
= text

