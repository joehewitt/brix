# A shift to the right of a 64-bit integer narrowed by `as` keeps the bits the shift brings down from the high word.

-- top-byte(0x9e3779b97f4a7c15)
-- top-bit(0x9e3779b97f4a7c15)
-- top-word(0x9e3779b97f4a7c15)

━━━━━━━━━━━━━━━━━━━━
+ top-byte U8
    - state U64

(state /zrshift/ 56) as U8

━━━━━━━━━━━━━━━━━━━━
+ top-bit U8
    - state U64

(state /zrshift/ 63) as U8

━━━━━━━━━━━━━━━━━━━━
+ top-word U32
    - state U64

(state /zrshift/ 40) as U32

