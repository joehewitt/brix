# A shift to the right of an integer narrower than a register shifts the value with its own sign, whatever a cast left above it.

. x U16 = 200
. y = I8(x)
-- y /rshift/ 1
-- y /zrshift/ 1
. a U16 = 40000
. b = I16(a)
-- b /rshift/ 1
-- b /zrshift/ 1
. d I16 = -2
. e = U16(d)
-- e /rshift/ 1
-- e /zrshift/ 1
. n I8 = -16
-- n /rshift/ 2
-- n /zrshift/ 2
-- half(n)

━━━━━━━━━━━━━━━━━━━━
+ do half I8
    - n I8

= n /rshift/ 1

