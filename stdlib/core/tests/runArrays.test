Array size overflow
;====
:====
# Oversized buffer resize panics before byte-size arithmetic overflows.

do new
    . buffer = I64[1]
    buffer = buffer.resize((Size.max / I64.size) + 1)
    -- buffer.size
catch failure
    -- failure

:----

Array size overflow
;====
:====
# Oversized buffer growth panics before size arithmetic overflows.

do new
    . buffer = Byte[1]
    buffer = buffer.grow(Size.max)
    -- buffer.size
catch failure
    -- failure

