values[0] = 10u32
values[1] = 21u32
. grown = values.resize(4, arena)
grown[3] = 5u32
-- grown[0], grown[1], grown[2], grown[3], grown.size
. less = grown.resize(1, arena)
-- less[0], less.size
. texts = Array'String(arena, 1)
texts[0] = "kept"
. more = texts.resize(3, arena)
more[2] = "new"
-- more[0], more[2]
arena.release()

