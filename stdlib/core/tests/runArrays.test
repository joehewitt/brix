# An array tested as a condition, alone or beside another, is true where it is not empty.

. empty = Array'U32(0).immutable
. full = Array'U32(2).immutable
-- check(empty)
-- check(full)
-- both(empty, true)
-- both(full, true)
-- either(empty, false)
-- either(full, false)
. mutable = Array'U32(0)
-- if mutable then "mutable" else "none"

━━━━━━━━━━━━━━━━━━━━
+ do check String
    - params

=? "truthy" if params
= "falsy"

━━━━━━━━━━━━━━━━━━━━
+ do both String
    - params
    - flag Bool

=? "both" if params && flag
= "not both"

━━━━━━━━━━━━━━━━━━━━
+ do either String
    - params
    - flag Bool

=? "either" if params || flag
= "neither"

