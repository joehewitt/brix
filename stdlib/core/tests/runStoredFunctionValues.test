# Two function values are equal when they run one code with one captured data, so removing one
# subscriber leaves another that captures nothing.

. a Hook = => 1
. b Hook = => 2
. h Hook = three
. i Hook = four
. j Hook = three
. e = make(1)
. f = make(1)
-- "${a == b} ${h == i} ${h == j} ${h != i} ${e == e} ${e == f} ${a() + b() + e() + f()}"
. source = Source()
. endpoint Broadcastable'Int = source.changed
endpoint.subscribe(log-first)
endpoint.subscribe(log-second)
catch endpoint.unsubscribe(log-second)
source.emit(1)

