# Same again, but the hook callee can panic and is recursive, like style-apply-mount. The
# recursion forces the callee's ABI to be fixed before its body finishes compiling, which is
# the case that once silently dropped Bool returns through stored function values.

./lib/ptrhooklib

. node = Probe()
set-ptr-hook(my-panicky-hook)
-- "with-root=${call-ptr-hook(node as Pointer, null, node as Rootish)}"
-- "no-root=${call-ptr-hook(node as Pointer, null, null)}"

━━━━━━━━━━━━━━━━━━━━
+ HookPanic is Panic

━━━━━━━━━━━━━━━━━━━━
+ do my-panicky-hook Bool
    - node-pointer Pointer
    - parent-pointer Pointer?
    - root Rootish?

if parent-pointer
    ?! HookPanic("unexpected parent")
if root
    if parent-pointer
        = my-panicky-hook(node-pointer, null, root)
    = true
= false

━━━━━━━━━━━━━━━━━━━━
