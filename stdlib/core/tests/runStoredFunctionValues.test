+ do run String
    - on Bool
    - limit U64

. check Predicate'U64? = (:: node => node < limit) if on
. plain Predicate'U64? = (:: node => node < limit) if on
=? "none" if !check || !plain
= "${check(3)} ${check(9)} ${plain(9)}"

