;====

:====
# float copies: a loop that rewrites the float fields of each list element keeps them in float
# registers and leaves its receiver and argument intact

. holder = Holder()
holder.items += Item(1.5, 2.5, 3.5, 4.5, 5.5)
holder.items += Item(10.5, 20.5, 30.5, 40.5, 50.5)
. shifter = Shifter()
shifter.shift(holder, 1.0)
-- holder.label
-- shifter.shifts
for item in holder.items
    -- "${item.a} ${item.b} ${item.c} ${item.d} ${item.e}"

━━━━━━━━━━━━━━━━━━━━
+ Item is Tuple

+ a F32
+ b F32
+ c F32
+ d F32
+ e F32

━━━━━━━━━━━━━━━━━━━━
+ Holder

+ items [Item] = List'Item()
+ label String = "holder"

━━━━━━━━━━━━━━━━━━━━
+ Shifter

+ shifts Index = 0

────────────────────
+ do shift
    - holder Holder
    - wide Float

. delta = wide as F32
. index Size
while index < holder.items.length
    . item = holder.items[index]
    holder.items[index] = Item(item.a + delta, item.b, item.c, item.d, item.e)
    index += 1
shifts += 1

