;====
:====
# regalloc: a recursive call that swaps or rotates its own arguments

-- swap(10, 3, 0)
-- swap(10, 3, 1)
-- swap(10, 3, 2)
-- swap-float(10.0, 3.5, 1)
-- swap-float(10.0, 3.5, 2)
-- rotate(1, 2, 3, 0)
-- rotate(1, 2, 3, 1)
-- rotate(1, 2, 3, 2)
-- rotate(1, 2, 3, 3)

━━━━━━━━━━━━━━━━━━━━
+ do swap I64
    - x I64
    - y I64
    - depth I64

=? x - y if depth == 0
= 1000 + swap(y, x, depth - 1)

━━━━━━━━━━━━━━━━━━━━
+ do swap-float F64
    - x F64
    - y F64
    - depth I64

=? x - y if depth == 0
= 1000.0 + swap-float(y, x, depth - 1)

━━━━━━━━━━━━━━━━━━━━
+ do rotate I64
    - x I64
    - y I64
    - z I64
    - depth I64

=? x * 100 + y * 10 + z if depth == 0
= 1000 + rotate(z, x, y, depth - 1)

