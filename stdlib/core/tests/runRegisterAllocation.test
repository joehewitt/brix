;====
:====
# frame coloring: large tuple locals in exclusive, sequential and overlapping scopes

-- single()
-- single-managed()
-- exclusive(true)
-- exclusive(false)
-- sequential()
-- managed(true)
-- managed(false)
-- overlapping(4)

+ Big is (a U64, b U64, c U64, d U64, e U64, f U64, g U64, h U64)
+ Text is (a String, b String, c String, d String, e String, f String, g String, h String)

━━━━━━━━━━━━━━━━━━━━
_ do exclusive U64
    - flag Bool

if flag
    . local = Big(1, 2, 3, 4, 5, 6, 7, 8)
    = local.a
else
    . local = Big(8, 7, 6, 5, 4, 3, 2, 1)
    = local.a

━━━━━━━━━━━━━━━━━━━━
_ do sequential U64

. a = Big(1, 2, 3, 4, 5, 6, 7, 8)
. result = a.a
. b = Big(2, 3, 4, 5, 6, 7, 8, 9)
result += b.b
. c = Big(3, 4, 5, 6, 7, 8, 9, 10)
= result + c.c

━━━━━━━━━━━━━━━━━━━━
_ do managed String
    - flag Bool

if flag
    . local = Text("a", "b", "c", "d", "e", "f", "g", "h")
    = local.a
else
    . local = Text("h", "g", "f", "e", "d", "c", "b", "a")
    = local.b

━━━━━━━━━━━━━━━━━━━━
_ do single U64

. local = Big(1, 2, 3, 4, 5, 6, 7, 8)
= local.a

━━━━━━━━━━━━━━━━━━━━
_ do single-managed String

. local = Text("a", "b", "c", "d", "e", "f", "g", "h")
= local.a

━━━━━━━━━━━━━━━━━━━━
_ do overlapping U64
    - count U64

. total = 0u64
. i = 0u64
while i < count
    . first = Big(i, 2, 3, 4, 5, 6, 7, 8)
    . second = Big(10, i, 30, 40, 50, 60, 70, 80)
    total += first.a + second.b + first.h + second.h
    i += 1
= total

