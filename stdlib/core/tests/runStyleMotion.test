╌╌╌╌╌╌╌╌╌╌ is StyleMotionHost ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do style-values-changed
    - owner MarkupElement
    - changes [StyleValueChange]

for change in changes
    . property = change.info.properties[change.offset]
    . from = style-motion-vector(property, change.old-bits, change.old-none) ?? style-motion-none-vector(property, change.bits)
    . to = style-motion-vector(property, change.bits, change.none)
    -- "${property.name}: float ${property.is-float} object ${property.is-object} from ${describe(from)} to ${describe(to)}"
    if property.is-object
        helper-info = change.info
        helper-offset = change.offset
    if from && to
        . middle = List'F64()
        for index in 0 .. < to.length
            middle += (from[index] + to[index]) / 2
        . presenter = StylePresenter(property, change.bits)
        style-present(owner, change.info, change.offset, presenter.bits(middle), false)
        shown += change
    else if property.name == "ink"
        style-present(owner, change.info, change.offset, 5, false)
        shown += change

━━━━━━━━━━━━━━━━━━━━
_ do describe String
    - vector [F64]?

=? "none" if !vector
. text = ""
for value in vector
    text = text + " $value"
= text
:----
mounted: fade 1 spot (0, 0) ink 0 inner ink 0
fade: float true object false from  1 to  0.25
spot: float false object false from  0 0 to  4 8
helper: float false object true from none to none
ink: float false object false from none to none
presented: fade 0.625 spot (2, 4) ink 5 inner ink 5
helper 3
settled: fade 0.25 spot (4, 8) ink 9 inner ink 9 presenting false false
;====
:====
# A presented value is built from its vector by the value it moves to, so what the vector leaves
# out comes from there. Two values mix only when the first `moves-to` the second.

/core/animatable
