+ do reveal
    - id U64

if revealed
    revealed.is-revealed = false
revealed = null
for step in steps
    if step.id == id
        step.is-revealed = true
        revealed = step

────────────────────
+ describe String

"${steps[0].#is-revealed} ${steps[1].#is-revealed}"

