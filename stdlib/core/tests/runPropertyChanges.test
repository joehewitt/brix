    -- "cleared"

C:yumiCollect()
do C:yumiGCDrainCleanups()
. payloads-before = C:yumiGCObjectSidePayloadCount(0)

-- exercise-weak-property-subscription()

for cycle in 0 .. < 3
    C:yumiCollect()
    do C:yumiGCDrainCleanups()

-- C:yumiGCObjectSidePayloadCount(0) - payloads-before

