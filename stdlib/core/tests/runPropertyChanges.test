    later-tracker.attach(later-action)

────────────────────
+ do run-existing

order += "e"

────────────────────
+ do run-added

order += "l"

────────────────────
+ do remove-self

self-runs += 1
if self-tracker && self-action
    self-tracker.detach(self-action)

────────────────────
+ do run-nested-first

order += "f"
if !is-nested && nested-subscribers
    is-nested = true
    property-dispatch(nested-subscribers, "value")

────────────────────
+ do run-nested-second

order += "s"

