# A narrowed read stored after a store to a watched property stores what the narrowed read holds.

. doc = Doc()
. watcher = Watcher(doc)
. closed [Closed]
closed += Closed(1, Jump(4, "x"))
closed += Closed(2, null)
reopen(closed, doc)
-- doc.jump?.text ?? "none"
reopen(closed, doc)
-- doc.jump?.text ?? "none"
-- watcher.seen

