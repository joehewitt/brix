+ do report String

. text = ""
. node = %first-child
while node
    text = text ++ "[box"
    . inner = node.%first-child
    while inner
        text = text ++ " ${(inner as Thing).x}"
        inner = inner.%next-sibling
    text = text ++ "]"
    node = node.%next-sibling
= text

