────────────────────
+ do get nodes [Named]

for item in items
    if item.leaf
        <= item.leaf
    else if item.group
        <= item.group

────────────────────
+ do get descendants [Named]

for item in items
    if item.leaf
        <= item.leaf
    else if item.group
        . group = item.group
        <= group
        for node in group.descendants
            <= node

