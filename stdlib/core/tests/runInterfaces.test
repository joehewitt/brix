# Boxed values of an interface survive collection while a list alone holds them.

. kept [Shape]
. i = 0
while i < 200
    kept += Pair(i, 0.5)
    kept += Label("label $i")
    kept += Count(i)
    churn(i)
    i += 1
. sum = 0
i = 0
while i < kept.length
    sum += kept[i].weight()
    i += 1
-- sum
-- kept[4].weight(), kept[301].weight(), kept[599].weight()

