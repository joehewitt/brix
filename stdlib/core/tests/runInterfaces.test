# Bullet pipelines over interface-typed lists map, filter, test, and pick items.

. nodes [Named] = List'Named()
nodes += Leaf("a")
nodes += Twig("b")
nodes += Leaf("c")
. found =
    ** ["a", "x", "c"]
    ?*> find(nodes, each)
    |> List
-- found.length
. labels =
    ** nodes
    *> each.label
    |> List
-- labels[2]
. twigs =
    ** nodes
    ?> each is Twig
    *> each as Twig
    |> List
-- twigs[0].label
. matches =
    ** nodes
    ?> each.label == "c"
    |> List
-- matches[0].label
. twig-list =
    ** nodes
    ?> each is Twig
    |> List
-- twig-list.length

