+ do lost-below Int
    - depth Int
    - limit Int

. node = Wide(depth)
. lost = if depth + 1 < limit then lost-below(depth + 1, limit) else collected()
if C:yumiGCVerifyObject(node as Pointer) && node.a == depth
    = lost
= lost + 1

