-- loaded-during-mark(weak)
C:yumiCollect()
-- weak.get == null

━━━━━━━━━━━━━━━━━━━━
+ do loaded-during-mark String
    - weak Weak'GCNode

C:yumiGCStartConcurrentMark()
. loaded = weak.get
C:yumiGCFinishConcurrentMark()
if !loaded
    = "empty"
C:yumiCollect()
if !C:yumiGCVerifyObject(loaded as Pointer)
    = "lost"
= "alive ${loaded.value}"

