# What is indented under a probe belongs to the probe: none of it runs where probes are not asked for.

. count = 0
//demo.calls ++
    count += 1
//demo.state = count
    -- "under a probe"
//demo.value -> shown
    .. shown = noisy()
-- count
-- f(1)

━━━━━━━━━━━━━━━━━━━━
+ do f Int
    - n Int

//demo.calls ++
    = 99
= n

━━━━━━━━━━━━━━━━━━━━
+ do noisy Int

-- "noisy"
= 1

