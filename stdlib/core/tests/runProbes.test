# A counter adds a count of any integer type, such as a `Size`, with no `as`.

_ calls Size = 0

for index in 0 .. < 3
    calls += 1
//demo.calls += calls
. pairs Size = calls * 2
//demo.pairs += pairs
-- calls

:----
%probes: demo

3
;====
:====
# Where probes are asked for, what is indented under a probe runs with it, in order.

. count = 0
//demo.calls ++
    count += 1
//demo.state = count
    -- "under a probe"
//demo.value -> shown
    .. shown = noisy()
-- count
-- f(1)

