# A probe emits nothing where probes are not asked for: nothing of it is evaluated.

. count = 0

//demo.calls ++
//demo.total += noisy()
//demo.value -> noisy()
//demo.state = noisy()
// said ${noisy()}
count += 1
-- count
-- quiet(3)

━━━━━━━━━━━━━━━━━━━━
+ do noisy Int

-- "noisy"
= 1

━━━━━━━━━━━━━━━━━━━━
+ do quiet Int
    - n Int

//demo.quiet ++
//demo.quiet-value -> noisy()
= n + 1

