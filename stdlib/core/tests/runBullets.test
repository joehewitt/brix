# Pipes a method returns, whose functions read the receiver and an argument, and pipes that map to a float, a truth and a pair.

. box = Box(3)
for item in box.scaled()
    -- item
for item in box.above(1)
    -- item
-- ", ".join(evens(6))
. halves =
    * 1
    * 2
    * 3
    *> each / 2.0
for h in halves
    -- h
. flags =
    ** 1 .. 3
    *> each > 1
for f in flags
    -- f
. pairs =
    ** 1 .. 2
    *> (each, each * each)
for a, b in pairs
    -- a + b

━━━━━━━━━━━━━━━━━━━━
+ do evens <Int>
    - limit Int

=
    ** 1 .. limit
    ?> each % 2 == 0

