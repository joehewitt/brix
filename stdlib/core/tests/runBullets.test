:====
# A List given bullets builds its items where it is written, as one given them as arguments does:
# the value of a property reads the object's members and what they track, and runs again as they
# change, as does an assignment that reads something tracked.

.. meter = Meter()
.. shown = Shown()

shown.flags = List'Int
    * meter.#value
    * meter.#other * 10
-- "${meter.flags} | ${meter.plain} | ${shown.flags}"
meter.value = 3
-- "${meter.flags} | ${meter.plain} | ${shown.flags}"
meter.other = 5
-- "${meter.flags} | ${meter.plain} | ${shown.flags}"

━━━━━━━━━━━━━━━━━━━━
+ Meter

+ value = 1
+ other = 2
+ flags = List'Int
    * #value
    * #other * 10
    * #value + #other
+ maybe Int? = 4
+ plain =
    * value
    *? maybe
    * #other
    |> List

━━━━━━━━━━━━━━━━━━━━
+ Shown

+ flags = List'Int()

