# A pipe whose function reads a local as it is when the items are read, a tap, a filter in a function that reads an argument, a value piped whole as `it`, and a pipe never read.

. k = 10
. scaled =
    ** 1 .. 3
    *> each * k
k = 100
for item in scaled
    -- item
. taps =
    ** 1 .. 3
    *|> bump(each)
for item in taps
    -- item
-- count
-- pick(3)
--
    5
    |=> it * 5
. unused =
    ** 1 .. 3
    *|> bump(each)
-- count
_ count = 0

━━━━━━━━━━━━━━━━━━━━
+ do bump
    - n Int

count += n

━━━━━━━━━━━━━━━━━━━━
+ do pick
    - limit Int

. kept = 0
. source =
    ** 1 .. 10
    ?> each <= limit
for item in source
    kept += item
= kept

