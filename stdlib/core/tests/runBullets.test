    ** 1 .. 100
    *> each * 3
for item in early
    if item > 9
        break
    -- item
. nested =
    ** 1 .. 2
    *> each * 10
    *> each + 1
    *> each * 2
-- <-nested
-- <-nested
-- <-nested
. picked =
    ** 1 .. 6
    ?*> each * 10 if each % 3 == 0
-- ", ".join(picked)
. none =
    ** 1 .. < 1
    *> each * 2
for item in none
    -- item
-- "end"

