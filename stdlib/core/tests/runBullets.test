# A list of bullets left by `break` has finished, one never read runs nothing, and one read by `<-` past its end gives nothing.

. source =
    * 1
    * 2
    * 3
for item in source
    if item == 2
        break
    -- item
for item in source
    -- item
. unused =
    * 1
    ** 1 .. 3
. gen =
    ** 1 .. 2
-- <-gen
-- <-gen
-- <-gen
-- count-of(source)
. fresh =
    * 4
    * 5
-- count-of(fresh)

━━━━━━━━━━━━━━━━━━━━
+ do count-of Int
    - items <Int>

. n = 0
for item in items
    n += 1
= n

