# A List given bullets whose items raise: an error leaves the function, and a catch holds it. A
# global made so takes its items as its module starts.

+ labels [String] = List
    * label("a")
    * label("b")

-- totals(1)
. failed = catch totals(-1)
-- match failed
    | [Int]
        "list $it"
    | IOError
        "io ${it.message}"
. held = catch? totals(-3)
-- held ?? [0]
-- labels

━━━━━━━━━━━━━━━━━━━━
+ do totals [Int]
    - start Int

= List
    * check(start)
    * check(start + 1)

━━━━━━━━━━━━━━━━━━━━
+ do check Int
    - value Int

?! IOError("negative")
    if value < 0
= value + 1

━━━━━━━━━━━━━━━━━━━━
+ do label String
    - text String

?! IOError("empty")
    if text.length == 0
= "<$text>"

