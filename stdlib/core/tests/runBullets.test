:====
# A List given bullets in the value of a property gives every item of what a multi bullet writes:
# as the constructor gives the value, as the value runs again on a change it tracks, and once for
# a lazy property, which keeps it.

. meter = Meter()
-- "${meter.first} | ${meter.live} | ${meter.later}"
meter.others = List'Int(7, 8)
meter.value = 5
-- "${meter.first} | ${meter.live} | ${meter.later}"

━━━━━━━━━━━━━━━━━━━━
+ Meter

+ value = 1
+ others = List'Int(2, 3)
+ first = List'Int
    * value
    ** others
+ live = List'Int
    * #value
    ** #others
    ** 10 .. 11
+ later := List'Int
    ** others
    * value

:----

1, 2, 3 | 1, 2, 3, 10, 11 | 2, 3, 1
1, 2, 3 | 5, 7, 8, 10, 11 | 2, 3, 1
;====
