+ size I64 = 0

. size -> a01, a02, a03, a04, a05, a06, a07, a08, a09, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20

━━━━━━━━━━━━━━━━━━━━
+ Second is Style

+ size I64 = 0

. size -> b02, b01, b03, b04, b05, b06, b07, b08, b09, b11, b10, b12, b13, b14, b15, b16, b17, b18, b19, b20

