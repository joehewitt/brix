:====
# A style activates on a node when any of its properties is authored there by an enabled
# declaration; nodes with no authored declarations activate nothing. Dynamically authoring a
# property of a previously inactive style flips it active and raises the changed property's
# declared domain.

/core/style
/core/style-debug
/core/markup
/core/tests/support/markup-fixtures

<BatchDemo demo
    <Label
        ink = 9
    <Label
        gap = 4
    <Label

demo.markup-batch-queue.checkpoint()

` Clear the container bits Box raised imperatively while children were appended, so the
` snapshots below show only style-driven pending state.
demo.$is-paint-invalid = false
demo.$is-layout-invalid = false

. inked = demo.%first-child!
. gapped = inked.%next-sibling!
. plain = gapped.%next-sibling!

-- style-activation-snapshot(inked)
-- style-activation-snapshot(gapped)
-- style-activation-snapshot(plain)
-- style-pending-snapshot(demo)

inked.$is-paint-invalid = false
gapped.$is-layout-invalid = false
-- style-pending-snapshot(demo)

style-author-dynamic(inked, style-info-named("Spacing")!, 0, StyleLayer.inline, 99, -1, 4, false)
demo.markup-batch-queue.checkpoint()

-- style-activation-snapshot(inked)
-- style-pending-snapshot(demo)

━━━━━━━━━━━━━━━━━━━━
+ BatchDemo is Box
    is MarkupBatch
    using TextStyle
    using Spacing

+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
+ TextStyle is Style

+ ink I64 = 7

. ink -> paint

━━━━━━━━━━━━━━━━━━━━
+ Spacing is Style

+ gap I64 = 0

. gap -> layout

━━━━━━━━━━━━━━━━━━━━
+ Label is Box
    using TextStyle
    using Spacing

━━━━━━━━━━━━━━━━━━━━
+ Plain is Box

:----
node=TextStyle
node=Spacing
unrecorded
paint=1 layout=1
paint=0 layout=0
node=TextStyle,Spacing
paint=0 layout=1
;====
:====
# An activation flip alone invalidates the flipped style's declared domains: authoring the
# property's initial value leaves computed state unchanged, but the activation change still raises
# the style's property domains on the node.

/core/style
/core/style-debug
/core/markup
/core/tests/support/markup-fixtures

<BatchDemo demo
    <Label
        ink = 9
    <Label

demo.markup-batch-queue.checkpoint()

` Clear the container bits Box raised imperatively while children were appended.
demo.$is-paint-invalid = false
demo.$is-layout-invalid = false

. colored = demo.%first-child!
. plain = colored.%next-sibling!

-- style-activation-snapshot(plain)

colored.$is-paint-invalid = false
-- style-pending-snapshot(demo)

style-author-dynamic(plain, style-info-named("TextStyle")!, 0, StyleLayer.inline, 0, -1, 7, false)
demo.markup-batch-queue.checkpoint()

-- style-activation-snapshot(plain)
-- style-pending-snapshot(demo)
-- "plain-paint=${plain.$is-paint-invalid} colored-paint=${colored.$is-paint-invalid}"

plain.$is-paint-invalid = false
style-author-dynamic(plain, style-info-named("TextStyle")!, 0, StyleLayer.inline, 0, -1, 7, false)
-- "identical ${style-drain-dirty-queue(demo)}"
demo.markup-batch-queue.checkpoint()
-- style-pending-snapshot(demo)
-- style-computed-snapshot(plain)

style-author-dynamic(plain, style-info-named("TextStyle")!, 0, StyleLayer.inline, 0, -1, 9, false)
demo.markup-batch-queue.checkpoint()
-- "changed " + style-pending-snapshot(demo)
-- style-computed-snapshot(plain)

━━━━━━━━━━━━━━━━━━━━
+ BatchDemo is Box
    is MarkupBatch
    using TextStyle

+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
+ TextStyle is Style

+ ink I64 = 7

. ink -> paint

━━━━━━━━━━━━━━━━━━━━
+ Label is Box
    using TextStyle

:----
unrecorded
paint=0 layout=0
node=TextStyle
paint=1 layout=0
plain-paint=true colored-paint=false
identical applied=0 stale=0
paint=0 layout=0
initial
changed paint=1 layout=0
node TextStyle seg=owned gen=1 mask=1 ink=9
;====
:====
# A node whose settle changes several styles reports its domains to the host once, with every
# raised self domain in one mask and every raised parent domain in another.

/core/style
/core/style-debug
/core/markup
/core/tests/support/markup-fixtures

<BatchDemo demo
    <Probe
        ink = 9
        gap = 4
        flex = 2

demo.markup-batch-queue.checkpoint()

. probe = demo.%first-child! as Probe
-- probe.report

probe.reset()
style-author-dynamic(probe, style-info-named("TextStyle")!, 0, StyleLayer.inline, 99, -1, 5, false)
style-author-dynamic(probe, style-info-named("Spacing")!, 0, StyleLayer.inline, 99, -1, 6, false)
demo.markup-batch-queue.checkpoint()
-- probe.report

probe.reset()
demo.markup-batch-queue.checkpoint()
-- probe.report

━━━━━━━━━━━━━━━━━━━━
+ BatchDemo is Box
    is MarkupBatch

+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
+ TextStyle is Style

+ ink I64 = 7

. ink -> paint

━━━━━━━━━━━━━━━━━━━━
+ Spacing is Style

+ gap I64 = 0

. gap -> layout

━━━━━━━━━━━━━━━━━━━━
+ Probe is Box
    using TextStyle
    using Spacing

+ self-calls Size
+ self-mask U32
+ parent-calls Size
+ parent-mask U32

────────────────────
+ do reset

self-calls = 0
self-mask = 0
parent-calls = 0
parent-mask = 0

────────────────────
+ do get report

. paint U32 = 1u32 /lshift/ (style-domain-named("paint") as Size)
. layout U32 = 1u32 /lshift/ (style-domain-named("layout") as Size)
. self-paint = (self-mask /and/ paint) != 0
. self-layout = (self-mask /and/ layout) != 0
. parent-layout = (parent-mask /and/ layout) != 0
= "self calls=$self-calls paint=$self-paint layout=$self-layout parent calls=$parent-calls layout=$parent-layout"

╌╌╌╌╌╌╌╌╌╌ is MarkupHost ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do markup-style-domains-changed
    - mask U32

self-calls += 1
self-mask = self-mask /or/ mask

────────────────────
+ do markup-parent-style-domains-changed
    - mask U32

parent-calls += 1
parent-mask = parent-mask /or/ mask

:----
self calls=1 paint=true layout=true parent calls=1 layout=true
self calls=1 paint=true layout=true parent calls=0 layout=false
self calls=0 paint=false layout=false parent calls=0 layout=false
;====
:====
# `inherit` is an authored-layer keyword reserved for @inherited properties: assigning it to a
# non-inherited style property is a compile error at the authoring site.

/core/style
/core/markup
/core/tests/support/markup-fixtures

<BatchDemo demo
    <Label
        ink = inherit

