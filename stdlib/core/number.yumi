+ fnv-prime U64 = 1099511628211

━━━━━━━━━━━━━━━━━━━━
_ do read-integer I64
    - text String
    - low I64
    - high I64

. end Pointer = null
. value = C:strtoll(text, &end, 10)
?! Panic("\"$text\" is not a whole number") if !reads-all(text, end)
= if value < low then low else if value > high then high else value

━━━━━━━━━━━━━━━━━━━━
_ do read-unsigned U64
    - text String

. end Pointer = null
. value = C:strtoull(text, &end, 10)
?! Panic("\"$text\" is not a whole number") if !reads-all(text, end)
= if value != 0 && text.trim().starts-with("-") then 0 else value

━━━━━━━━━━━━━━━━━━━━
_ do read-float F64
    - text String

. end Pointer = null
. value = C:strtod(text, &end)
?! Panic("\"$text\" is not a number") if !reads-all(text, end)
= value

━━━━━━━━━━━━━━━━━━━━
_ do reads-all Bool
    - text String
    - end Pointer

. start = text as Pointer
. read = (end.address - start.address) as Size
if end == null || read == 0
    = false
. bytes = start as CPointer'U8
for offset in read .. < text.size
    . byte = bytes[offset]
    if byte != 32 && (byte < 9 || byte > 13)
        = false
= true

