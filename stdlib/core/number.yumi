+ Number

────────────────────
+ to UnitString

"$this$unit"

────────────────────
+ do to Binary

. output = ""
. bit-size = (type-of this).size * 8

for i in bit-size - 1 .. 0
    output += "${(this /rshift/ i) /and/ 1}"
    if i > 0 && i % 8 == 0
        output += " "

= output

