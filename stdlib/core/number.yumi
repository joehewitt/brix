━━━━━━━━━━━━━━━━━━━━
+ fnv-mix U64
    - hash U64
    - value U64

(hash /xor/ value) * fnv-prime

━━━━━━━━━━━━━━━━━━━━
+ do fnv-hash U64
    - data CPointer'Byte
    - length Size
    - seed U64 = fnv-offset-basis

. hash = seed
for index in 0 .. < length
    hash = fnv-mix(hash, data[index])
= hash
