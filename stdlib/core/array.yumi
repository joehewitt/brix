=? if length != other.length
for index in 0 .. < length
    =? if this[index] != other[index]
= true

────────────────────
+ do this has item Item

for index in 0 .. < size
    . candidate = Backing.load'Item(storage, index)
    =? true if candidate == item
= false

────────────────────
+ this + other-size Size

?! OutOfBoundsError("Out of bounds $other-size / $size")
    if (other-size as UInt) > (size as UInt)

this[other-size .. < size]

────────────────────
+ this[index Index] @inline

|? (index as UInt) < (size as UInt)
    Backing.load'Item(storage, index)
??
    absent(index)

────────────────────
+ this[position Position]

this[position.normalize(this)]

────────────────────
+ this[range Range'Position]

this[range.normalize(this)]

────────────────────
+ this[range Range'Index]

?! Panic("Only increments of 1 are currently supported")
    if normal.increment != 1
?! OutOfBoundsError("Range out of bounds ($out-index / $size)")
    if (start as UInt) > (size as UInt) || end > size || end < start

This((storage as CPointer'Item) + start, end - start)

.. normal = range.forward()
.. start = normal.start
.. end = normal.end
.. out-index = if end > 0 then end - 1 else end

────────────────────
+ !this

length == 0

────────────────────
+ do reversed

for offset in 0 .. < length
    <= this[length - 1 - offset]

────────────────────
+ slice-string

slice-string(0 .. < size)

────────────────────
+ slice-string
    - range Range'Position

slice-string(range.normalize(this))

────────────────────
+ do slice-string String
    - range Range'Index

?! Panic("Only increments of 1 are currently supported")
    if normal.increment != 1
?! OutOfBoundsError("Range out of bounds ($out-index / $size)")
    if (start as UInt) > (size as UInt) || end > size || end < start

if len == 0
    = ""
else if Item == Char
    . made = C:yumiStringFromUtf8Codepoints(data, start, end)
    ?! Panic("Array holds a Char that is not a Unicode character")
        if (made as Pointer).address == 0
    = made as String
else if Item == Byte
    . made = C:yumiStringSliceUtf8(data, start, end)
    ?! Panic("Unable to read UTF8 content")
        if (made as Pointer).address == 0
    = made as String
else
    ?! Panic("Array does not contain characters")

.. data = storage as CPointer'Item
.. normal = range.forward()
.. start = normal.start
.. end = normal.end
.. out-index = if end > 0 then end - 1 else end
.. len = end - start

────────────────────
+ do slice-string'Context String @no-gc
    - context Context
    - Context is ArrayStorageProvider

?! Panic("Array does not contain characters")
    if Item != Char

= context.copy-span(Array'Char(storage as CPointer'Char, size), 0, size, true)

