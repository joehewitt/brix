────────────────────
_ do absent Item
    - index Index

?! OutOfBoundsError("Index out of bounds ($index / $size)")

━━━━━━━━━━━━━━━━━━━━
_ host-endian Endian

if C:yumiHostIsLittleEndian() then .little else .big

━━━━━━━━━━━━━━━━━━━━
_ byte-array-hex-char Byte
    - value Byte

|? value < 10
     value + 48
??
    value - 10 + 97

━━━━━━━━━━━━━━━━━━━━
_ byte-array-base64-char Byte
    - value U32

|? value < 26
    (value + 65) as Byte
|? value < 52
    (value - 26 + 97) as Byte
|? value < 62
    (value - 52 + 48) as Byte
|? value == 62
    43
??
    47
