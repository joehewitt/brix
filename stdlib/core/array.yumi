=? if (offset as UInt) > (this.size as UInt)
=? if Num.size > this.size - offset

. source = (this.data + offset) as CPointer'Num
=? source[0] if Num.size == 1 || endian == host-endian()
. cell = Num[1]
. bytes = cell as Byte[]
for i in 0 .. < Num.size
    bytes[i] = this.data[offset + (Num.size - 1) - i]
= cell[0]

────────────────────
+ do write'Num
    - value Num
    - offset Index
    - endian = .big
    - Num is Number

?! OutOfBoundsError("Write out of bounds ($offset / $this.size)")
    if (offset as UInt) > (this.size as UInt) || Num.size > this.size - offset

. target = (this.data + offset) as CPointer'Num
target[0] = value
if Num.size > 1 && endian != host-endian()
    . bytes = this.data + offset
    for i in 0 .. < Num.size / 2
        . swapped = bytes[i]
        bytes[i] = bytes[Num.size - 1 - i]
        bytes[Num.size - 1 - i] = swapped
= value

