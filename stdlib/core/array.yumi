────────────────────
+ do to Hex

?! Panic("Array size overflow")
    if this.size > Size.max / 2

. output = Byte[this.size * 2]
for i in 0 .. < this.size
    . byte = this.data[i]
    output.data[i * 2] = byte-array-hex-char(byte /rshift/ 4)
    output.data[i * 2 + 1] = byte-array-hex-char(byte /and/ 0x0f)
= output.slice-string()

────────────────────
+ do to Base64

?! Panic("Array size overflow")
    if this.size > (Size.max - 2) / 3

. output = Byte[((this.size + 2) / 3) * 4]
. read-index = 0
. write-index = 0
while read-index < this.size
    . b0 = this.data[read-index] as U32
    . b1 = if read-index + 1 < this.size then this.data[read-index + 1] as U32 else 0
    . b2 = if read-index + 2 < this.size then this.data[read-index + 2] as U32 else 0
    . b01 = ((b0 /and/ 0x03) /lshift/ 4) /or/ ((b1 /rshift/ 4) /and/ 0x0f)

    output.data[write-index] = byte-array-base64-char((b0 /rshift/ 2) /and/ 0x3f)
    output.data[write-index + 1] = byte-array-base64-char(b01)
    output.data[write-index + 2] =
        |? read-index + 1 < this.size
            byte-array-base64-char(((b1 /and/ 0x0f) /lshift/ 2) /or/ ((b2 /rshift/ 6) /and/ 0x03))
        ??
            61
    output.data[write-index + 3] =
        |? read-index + 2 < this.size
            byte-array-base64-char(b2 /and/ 0x3f)
        ??
            61

    read-index += 3
    write-index += 4

= output.slice-string()

