────────────────────
+ do insert
    - insert-items <Item>
    - index Index

check-insert-index(index)
. to-insert = This(context, 0)
for item in insert-items
    to-insert.append-raw(item)
. count = to-insert.length
=? if !count
if size + count > items.size
    grow(size + count)
shift-right-raw(count, index)
. offset Index = 0
for item in to-insert
    items[index + offset] = item
    offset += 1
size += count

do @feature-collection-observers
    notify-collection-insert(this, index, count)

