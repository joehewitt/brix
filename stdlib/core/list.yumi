    - item Item

this += item
= this

────────────────────
_ do absent Item
    - index Index

?! OutOfBoundsError("List index $index out of range")

────────────────────
_ do check-insert-index
    - index Index

?! OutOfBoundsError("List index $index out of range")
    if (index as UInt) > (size as UInt)

────────────────────
_ do check-range
    - index Index
    - count Size

?! OutOfBoundsError("List range at index $index with count $count out of range")
    if (index as UInt) > (size as UInt)
?! OutOfBoundsError("List range at index $index with count $count out of range")
    if (count as UInt) > ((size - index) as UInt)

────────────────────
_ do slice-raw This @inline
    - normal Range'Index

?! OutOfBoundsError("Range out of bounds ($out-index / $size)")
    if normal.increment == 1 && normal.end > size
. list = This(context, 0)
list.items = items[normal]
list.size = normal.length
list.shares-storage = true
shares-storage = true
= list

.. out-index = if normal.end > 0 then normal.end - 1 else normal.end

────────────────────
_ do append-raw @inline
    - item Item

?! Panic("List size overflow")
    if size == Size.max
if size == items.size
    grow(size + 1)

items[size] = item
size += 1

────────────────────
_ do remove-at-raw
    - index Index

. cursor = index + 1
while cursor < size
    items[cursor - 1] = items[cursor]
    cursor += 1
size -= 1
vacate-raw(size, 1)

────────────────────
_ do remove-range-raw
    - index Index
    - count Size

. cursor = index + count
while cursor < size
    items[cursor - count] = items[cursor]
    cursor += 1
size -= count
vacate-raw(size, count)

────────────────────
_ do vacate-raw @inline
    - index Index
    - count Size

if shares-storage
    clamp-shared-raw(index)
=? if Item.is-number || Item.size < 8 || shares-storage || count <= 0
if Item.size == 8 && count == 1
    ((items.data + index) as CPointer'U64)[0] = 0
else
    zero-raw(index, count)

────────────────────
_ do clamp-shared-raw
    - count Size

items = items[0 .. < count]

────────────────────
_ do zero-raw
    - index Index
    - count Size

. words = count * (Item.size / 8)
if Item.size % 8 == 0 && words <= 32
    . slots = (items.data + index) as CPointer'U64
    . offset = 0
    while offset + 4 <= words
        slots[offset] = 0
        slots[offset + 1] = 0
        slots[offset + 2] = 0
        slots[offset + 3] = 0
        offset += 4
    while offset < words
        slots[offset] = 0
        offset += 1
else
    C:memset(items.data + index, 0, Item.size * count)

────────────────────
_ do shift-right-raw
    - count Size
    - index Index

. cursor = size
while cursor > index
    cursor -= 1
    items[cursor + count] = items[cursor]

────────────────────
_ do grow
    - min-size Size

if min-size > items.size
    replace-storage(items.resize(next-list-capacity(items.size, min-size), context))

────────────────────
_ do replace-storage
    - storage Array'Item'Backing

if storage.size == 0 || (storage.data as Pointer).address != (items.data as Pointer).address
    shares-storage = false
items = storage

────────────────────
_ This
    - context Backing.Context
    - capacity Size

this.context = context
items = Array'Item'Backing(context, capacity)

────────────────────
_ initial-list-capacity Size

|? Item.size == 1
    8
|? Item.size <= 1024
    4
??
    1

────────────────────
_ do next-list-capacity Size
    - current Size
    - needed Size

. new-size = grown-list-capacity(current)
if current == 0
    new-size = initial-list-capacity()
else if current < 1024
    new-size = doubled-list-capacity(current)
if new-size < needed
    new-size = needed
= new-size

────────────────────
_ doubled-list-capacity Size
    - current Size

?! Panic("List size overflow")
    if current > Size.max / 2

current * 2

────────────────────
_ grown-list-capacity Size
    - current Size

?! Panic("List size overflow")
    if current > Size.max - half

current + half

.. half = current / 2

────────────────────
_ normalize-index
    - index Index

|? index < 0
    size + index
??
    index

