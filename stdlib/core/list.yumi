        notify-collection-append(this, old-size, size - old-size)

────────────────────
+ do this -= item Item

. found = find(item)
if found
    . index = found + 1
    while index < size
        items[index - 1] = items[index]
        index += 1
    size -= 1
    vacate-raw(size, 1)

    do @feature-collection-observers
        notify-collection-remove(this, found)
= found

