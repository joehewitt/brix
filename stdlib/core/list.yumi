────────────────────
+ do -= this[range Range'Index]

?! Panic("Only increments of 1 are currently supported")
    if range.increment != 1 && range.increment != -1
. low = if range.start > range.end then range.end else range.start
. high = if range.start > range.end then range.start else range.end
. count = if range.is-through then high - low + 1 else high - low
. start = if range.start > range.end && !range.is-through then low + 1 else low
check-range(start, count)
if count
    remove-range-raw(start, count)

    do @feature-collection-observers
        notify-collection-remove(this, start, count)

