────────────────────
+ do move
    - from-index Index
    - to-index Index
    - count Size = 1

check-range(from-index, count)
check-insert-index(to-index)

=? if !count

=? if from-index == to-index
=? if to-index > from-index && to-index < from-index + count

. moved = This(context, count)
for offset in 0 .. < count
    moved.append-raw(items[from-index + offset])
remove-range-raw(from-index, count)

. insert-index = to-index
if insert-index > from-index
    insert-index -= count

if size + count > items.size
    grow(size + count)
shift-right-raw(count, insert-index)

. offset Index = 0
for item in moved
    items[insert-index + offset] = item
    offset += 1
size += count

do @feature-collection-observers
    notify-collection-move(this, from-index, to-index, count)

