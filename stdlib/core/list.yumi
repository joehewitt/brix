────────────────────
+ do slide
    - increment Increment = 1
    - start-index Index = 0

=? if increment == 0
if increment < 0
    . index = start-index - increment
    while index < size
        items[index + increment] = items[index]
        index += 1
    size += increment
else
    . index = size - start-index
    if index >= increment
        . shifted-size = size
        if index >= size
            shifted-size = index + 1
            if shifted-size > items.size
                grow(shifted-size)
        while index >= increment
            items[index] = items[index - increment]
            index -= 1
        size = shifted-size

do @feature-collection-observers
    if increment < 0
        notify-collection-reset(this)
    else if size - start-index >= increment
        notify-collection-reset(this)

────────────────────
+ do with'Item
    - item Item

this += item
= this

────────────────────
_ do absent Item
    - index Index

?! OutOfBoundsError("List index $index out of range")

────────────────────
_ do check-insert-index
    - index Index

?! OutOfBoundsError("List index $index out of range")
    if (index as UInt) > (size as UInt)

────────────────────
_ do check-range
    - index Index
    - count Size

?! OutOfBoundsError("List range at index $index with count $count out of range")
    if (index as UInt) > (size as UInt)
?! OutOfBoundsError("List range at index $index with count $count out of range")
    if count > size - index

────────────────────
_ do append-raw @inline
    - item Item

?! Panic("List size overflow")
    if size == Size.max
if size == items.size
    grow(size + 1)

items[size] = item
size += 1

────────────────────
_ do remove-at-raw
    - index Index

. cursor = index + 1
while cursor < size
    items[cursor - 1] = items[cursor]
    cursor += 1
size -= 1

────────────────────
_ do remove-range-raw
    - index Index
    - count Size

. cursor = index + count
while cursor < size
    items[cursor - count] = items[cursor]
    cursor += 1
size -= count

────────────────────
_ do shift-right-raw
    - count Size
    - index Index

. cursor = size
while cursor > index
    cursor -= 1
    items[cursor + count] = items[cursor]

────────────────────
_ do grow
    - min-size Size

if min-size > items.size
    items = items.resize(next-list-capacity(items.size, min-size), context)

────────────────────
_ This
    - context Backing.Context
    - capacity Size

this.context = context
items = Array'Item'Backing(context, capacity)

────────────────────
_ initial-list-capacity Size

|? Item.size == 1
    8
|? Item.size <= 1024
    4
??
    1

────────────────────
_ do next-list-capacity Size
    - current Size
    - needed Size

. new-size = grown-list-capacity(current)
if current == 0
    new-size = initial-list-capacity()
else if current < 1024
    new-size = doubled-list-capacity(current)
if new-size < needed
    new-size = needed
= new-size

────────────────────
_ doubled-list-capacity Size
    - current Size

?! Panic("List size overflow")
    if current > Size.max / 2

current * 2

────────────────────
_ grown-list-capacity Size
    - current Size

?! Panic("List size overflow")
    if current > Size.max - half

current + half

.. half = current / 2

────────────────────
_ normalize-index
    - index Index

|? index < 0
    size + index
??
    index

