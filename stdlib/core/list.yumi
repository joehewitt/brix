────────────────────
+ do slide
    - increment Increment = 1
    - start-index Index = 0

=? if increment == 0
if increment < 0
    . index = start-index - increment
    . old-size = size
    while index < size
        items[index + increment] = items[index]
        index += 1
    size += increment
    if size >= 0 && size < old-size
        vacate-raw(size, old-size - size)
else
    . index = size - start-index
    if index >= increment
        . shifted-size = size
        if index >= size
            shifted-size = index + 1
            if shifted-size > items.size
                grow(shifted-size)
        while index >= increment
            items[index] = items[index - increment]
            index -= 1
        size = shifted-size

do @feature-collection-observers
    if increment < 0
        notify-collection-reset(this)
    else if size - start-index >= increment
        notify-collection-reset(this)

