╌╌╌╌╌╌╌╌╌╌ is MutableCollection'Item ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do this[index Index] = item Item @inline

. old-size = size
if (index as UInt) >= (size as UInt)
    ?! OutOfBoundsError("List index $index out of range")
        if index < 0
    grow(index + 1)
    size = index + 1

items[index] = item

do @feature-collection-observers
    if size > old-size
        notify-collection-insert(this, old-size, size - old-size)
    else
        notify-collection-set(this, index)

────────────────────
+ do replace
    - index Index
    - item Item

check-range(index, 1)
items[index] = item

do @feature-collection-observers
    notify-collection-replace(this, index)

────────────────────
+ do append
    - item Item

this += item

────────────────────
+ do append-all
    - items <Item>

this ++= items

────────────────────
+ do insert
    - item Item
    - index Index

check-insert-index(index)
if size == items.size
    grow(size + 1)

shift-right-raw(1, index)
items[index] = item
size += 1

do @feature-collection-observers
    notify-collection-insert(this, index)

────────────────────
+ do remove
    - index Index
    - count Size = 1

check-range(index, count)
if count
    remove-range-raw(index, count)

    do @feature-collection-observers
        notify-collection-remove(this, index, count)

────────────────────
+ do remove
    - range Range'Index

-= this[range]

────────────────────
+ do move
    - from-index Index
    - to-index Index
    - count Size = 1

check-range(from-index, count)
check-insert-index(to-index)

=? if !count

=? if from-index == to-index
=? if to-index > from-index && to-index < from-index + count

. moved = This(this[from-index .. < from-index + count])
remove-range-raw(from-index, count)

. insert-index = to-index
if insert-index > from-index
    insert-index -= count

if size + count > items.size
    grow(size + count)
shift-right-raw(count, insert-index)

. offset Index = 0
for item in moved
    items[insert-index + offset] = item
    offset += 1
size += count

do @feature-collection-observers
    notify-collection-move(this, from-index, to-index, count)

────────────────────
+ do clear

. old-size = size
size = 0

do @feature-collection-observers
    if old-size
        notify-collection-remove(this, 0, old-size)

