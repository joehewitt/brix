(import ./array)
(import ./core)
(import ./error)
(import ./list)
(import ./number)
(import ./range)
(import ./stream)
(import ./task)

(type + (of IOWaiter Message)
  (prop + task Task)
  (prop + message (? Message))
  (prop + previous (? This))
  (prop + next (? This))
  (prop + is-queued _ (= false))
  (fn-do + This _
    (param task Task)
    (param message (? Message) (= null))
  )
)

(type + (of IOQueue Message)
  (prop + length Size)
  (blank)
  (prop _ head (? (of IOWaiter Message)))
  (prop _ tail (? (of IOWaiter Message)))
  (fn-do + push _
    (param waiter (of IOWaiter Message))
    (= (. waiter previous) tail)
    (= (. waiter next) null)
    (= (. waiter is-queued) true)
    (if tail
      (= (. tail next) waiter)
      (else
        (= head waiter)
      )
    )
    (= tail waiter)
    (+= length 1)
  )
  (fn-do + pop-first (? (of IOWaiter Message))
    (let waiter head)
    (if waiter
      (call remove waiter)
    )
    (return waiter)
  )
  (fn-do + remove _
    (param waiter (of IOWaiter Message))
    (return-if (if (not (. waiter is-queued))))
    (blank)
    (if (. waiter previous)
      (= (. waiter previous next) (. waiter next))
      (else
        (= head (. waiter next))
      )
    )
    (if (. waiter next)
      (= (. waiter next previous) (. waiter previous))
      (else
        (= tail (. waiter previous))
      )
    )
    (= (. waiter previous) null)
    (= (. waiter next) null)
    (= (. waiter is-queued) false)
    (-= length 1)
  )
  (fn-do + take-all (list (of IOWaiter Message))
    (let waiters (list (of IOWaiter Message)))
    (while true
      (let waiter (call pop-first))
      (return-if waiters (if (not waiter)))
      (+= waiters waiter)
    )
  )
)

(type + (of IOBuffer Message)
  (prop + length Size)
  (blank)
  (prop _ items _ (= ([] Message 0)))
  (prop _ head Index)
  (fn-do + push _
    (param message Message)
    (if (== length (. items size))
      (call grow)
    )
    (= ([] items (% (+ head length) (. items size))) message)
    (+= length 1)
  )
  (fn-do + push-first _
    (param message Message)
    (if (== length (. items size))
      (call grow)
    )
    (= head (% (- (+ head (. items size)) 1) (. items size)))
    (= ([] items head) message)
    (+= length 1)
  )
  (fn-do + pop-first Message
    (let message ([] items head))
    (if (and (not (. Message is-number)) (>= (. Message size) 8))
      (let slots (as (+ (. items data) head) (of CPointer U64)))
      (if (== (. Message size) 8)
        (= ([] slots 0) 0)
        (else-if (== (. Message size) 16)
          (= ([] slots 0) 0)
          (= ([] slots 1) 0)
        )
        (else-if (== (% (. Message size) 8) 0)
          (for (in word (..< 0 (/ (. Message size) 8)))
            (= ([] slots word) 0)
          )
        )
        (else
          (call (. items zero) head)
        )
      )
    )
    (= head (% (+ head 1) (. items size)))
    (-= length 1)
    (return message)
  )
  (fn-do + clear _
    (= items ([] Message 0))
    (= head 0)
    (= length 0)
  )
  (fn-do _ grow _
    (let capacity (if-expr (. items size) (* (. items size) 2) 16))
    (let grown ([] Message capacity))
    (for (in i (..< 0 length))
      (= ([] grown i) ([] items (% (+ head i) (. items size))))
    )
    (= items grown)
    (= head 0)
  )
)

(type + (of BroadcasterReader Message)
  (implements (of Readable Message))
  (implements (of Subscribable Message))
  (prop _ readers _ (= (call (of IOQueue Message))))
  (prop _ writers _ (= (call (of IOQueue Message))))
  (fn-do + (prefix <- this) (? Message)
    (let writer (call (. writers pop-first)))
    (if writer
      (call (. writer task resume-later))
      (blank)
      ;  //this:channel.read -> writer!.message, get-current-task-id()
      (return (. writer message))
    )
    (blank)
    (let reader (call (of IOWaiter Message) (call Task)))
    (call (. readers push) reader)
    (blank)
    (let was-canceled (call (. reader task suspend)))
    (if was-canceled
      (call (. readers remove) reader)
    )
    (call check-task-cancelation was-canceled)
    (blank)
    ;  //this:channel.read -> reader.message, get-current-task-id()
    (return (. reader message))
  )
  (fn-do + this _
    (param message Message)
    (param broadcaster (of Broadcastable Message))
    ;  // dispatch $message on ${get-current-task-id()}
    (blank)
    (let reader (call (. readers pop-first)))
    (if reader
      (= (. reader message) message)
      (call check-task-cancelation (call (. reader task resume-now)))
      (return)
    )
    (blank)
    (let writer (call (of IOWaiter Message) (call Task) message))
    (call (. writers push) writer)
    (blank)
    (let was-canceled (call (. writer task suspend)))
    (if was-canceled
      (call (. writers remove) writer)
    )
    (call check-task-cancelation was-canceled)
  )
  (fn-do + unsubscribe _
    (for (in reader (call (. readers take-all)))
      (call (. reader task resume-later))
    )
    (for (in writer (call (. writers take-all)))
      (call (. writer task resume-later))
    )
  )
)

(type + (of BroadcasterIterator Message)
  (implements (of Iterable Message))
  (implements (of Subscribable Message))
  (prop _ broadcastable (of Broadcastable Message))
  (prop _ readers _ (= (call (of IOQueue Message))))
  (prop _ buffer _ (= (call (of IOBuffer Message))))
  (fn-do + This _
    (param broadcastable (of Broadcastable Message))
  )
  (fn-do + begin-iterating _
    (call (. broadcastable subscribe) this)
  )
  (fn-do + end-iterating _
    (call (. broadcastable unsubscribe) this)
    (call (. buffer clear))
  )
  (fn-do + this _
    (param message Message)
    (param broadcaster (of Broadcastable Message))
    (probe-log io.dispatch (text: "dispatch " message " on " (call get-current-task-id)))
    (blank)
    (let reader (call (. readers pop-first)))
    (if reader
      (= (. reader message) message)
      (call (. reader task resume-later))
      (else
        (call (. buffer push) message)
      )
    )
  )
  (fn-do + unsubscribe _
    (for (in reader (call (. readers take-all)))
      (call (. reader task resume-later))
    )
  )
  (fn-do + (prefix <- this) (? Message)
    (if (. buffer length)
      (let message (call (. buffer pop-first)))
      ;  //this:channel.read -> message, get-current-task-id()
      (return message)
      (else-if (not (. broadcastable is-closed))
        (let reader (call (of IOWaiter Message) (call Task)))
        (call (. readers push) reader)
        (blank)
        (let was-canceled (call (. reader task suspend)))
        (if was-canceled
          (call (. readers remove) reader)
        )
        (call check-task-cancelation was-canceled)
        (blank)
        ;  //this:channel.read -> reader.message, get-current-task-id()
        (return (. reader message))
      )
    )
  )
)
