+ do <- this Message?

mutex.lock()
if buffer.length
    . message = buffer.pop-first()
    mutex.unlock()

    //this:channel.read -> $?{message}, get-current-task-id()
    = message
else if !is-closed
    . reader = IOWaiter'Message(Task())
    readers.push(reader)
    mutex.unlock()

    . was-canceled = reader.task.suspend()
    if was-canceled
