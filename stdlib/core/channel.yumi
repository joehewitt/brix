+ do await
    - fn Doer

. sem = Semaphore()
do new thread
    fn()
        catch error Error
            unhandled-error(error)
    sem.post()
sem.wait()

━━━━━━━━━━━━━━━━━━━━
+ do await'Result Result?
    - fn Getter'Result

. sem = Semaphore'Result()
do new thread
    . value = fn()
    sem.post(value)
= sem.await()
