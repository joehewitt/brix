+ AsyncChannel'Message
    is Broadcastable'Message
    is Writable'Message
    is Closable
    is Inspectable

+ is-closed = false
+ closed := OneShotChannel()

_ subscriptions [Subscribable'Message]
_ mutex = Mutex()

────────────────────
+ This

//channel.create -> this

────────────────────
+ do subscribe
    - subscriber Subscriber'Message

subscribe(Subscription(subscriber))

────────────────────
+ do unsubscribe
    - subscriber Subscriber'Message

//this:channel.unsubscribe -> $?subscriber

mutex.lock()
. index Index = 0
while index < subscriptions.length
    if subscriptions[index] == subscriber
        remove-subscription(index)
        =
    index += 1
mutex.unlock()

────────────────────
+ do subscribe
    - subscriber Subscribable'Message

?! Panic("Illegal to subscribe while closed")
    if is-closed

mutex.lock()
subscriptions = subscriptions ++ [subscriber]
mutex.unlock()

────────────────────
+ do unsubscribe
    - subscriber Subscribable'Message

mutex.lock()
. index Index = 0
while index < subscriptions.length
    if subscriptions[index] as Pointer == subscriber as Pointer
        remove-subscription(index)
        =
    index += 1
mutex.unlock()

────────────────────
+ do close

if !is-closed
    is-closed = true
    closed.done()
    finish-subscriptions()

────────────────────
+ do inspectable-snapshot

//this:channel.is.closed = is-closed
//this:channel.subscription.count = subscriptions.length

────────────────────
+ do this <- message Message

if is-closed
    ?! Panic("Can't write to closed broadcaster")

//this:channel.write -> $?{message}, get-current-task-id()

for sub in subscriptions
    sub(message, this)

────────────────────
+ !this

!subscriptions

────────────────────
_ do finish-subscriptions

. finishing = subscriptions
. index = finishing.length
while index
    index -= 1
    finishing[index].finish(this)

────────────────────
_ do remove-subscription
    - index Index

. sub = subscriptions[index]
subscriptions = subscriptions[... index] ++ subscriptions[index + 1 ...]
mutex.unlock()
sub.unsubscribe()

