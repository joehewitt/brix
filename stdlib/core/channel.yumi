━━━━━━━━━━━━━━━━━━━━
+ SyncChannel'Message
    is Iterable'Message
    is Writable'Message
    is Closable
    is Inspectable

+ is-closed = false

_ mutex Mutex
_ readers = IOQueue'Message()
_ writers = IOQueue'Message()

────────────────────
+ This

//channel.create -> this

────────────────────
+ do close

mutex.lock()
if !is-closed
    //this:channel.close -> get-current-task-id()

    is-closed = true

    . waiting-readers = readers.take-all()
    mutex.unlock()

    for reader in waiting-readers
        reader.task.resume-later()
else
    mutex.unlock()

────────────────────
+ do inspectable-snapshot

mutex.lock()
. reader-count = readers.length
. writer-count = writers.length
mutex.unlock()

//this:channel.is.closed = is-closed
//this:channel.reader.count = reader-count
//this:channel.writer.count = writer-count

────────────────────
+ do this <- message Message

mutex.lock()
if is-closed
    mutex.unlock()
    ?! Panic("Can't write to closed channel")

//this:channel.write -> $?{message}, get-current-task-id()

. reader = readers.pop-first()
if reader
    reader.message = message
    mutex.unlock()
    reader.task.resume-now()
else
    . writer = IOWaiter'Message(Task(), message)
    writers.push(writer)
    mutex.unlock()

    . was-canceled = writer.task.suspend()
    if was-canceled
        mutex.lock()
        writers.remove(writer)
        mutex.unlock()
    check-task-cancelation(was-canceled)

────────────────────
+ do <- this Message?

mutex.lock()
. writer = writers.pop-first()
if writer
    mutex.unlock()
    writer.task.resume-later()

    //this:channel.read -> $?{writer.message!}, get-current-task-id()
    = writer.message
else if !is-closed
    . reader = IOWaiter'Message(Task())
    readers.push(reader)
    mutex.unlock()

    . was-canceled = reader.task.suspend()
    if was-canceled
        mutex.lock()
        readers.remove(reader)
        mutex.unlock()
    check-task-cancelation(was-canceled)

    if reader.message
        //this:channel.read -> $?{reader.message}, get-current-task-id()
    = reader.message
else
    mutex.unlock()

