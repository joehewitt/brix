+ AsyncOnDemandChannel'Message'Used
    - Used = Void
    is Broadcastable'Message
    is Writable'Message
    is Closable

+ is-closed = false

_ usable Usable'Used
_ subscriptions [Subscribable'Message]
_ mutex = Mutex()

