(type _ MarkupRowRegion
  (implements MarkupRegionController)
  (fn-do + close _
    (return)
  )
)

(type _ (of MarkupRegionRow Item Content Host)
  (constraint is Content (of MarkupParent Content))
  (constraint is Host (of MarkupParent Content))
  (prop + parent Host)
  (prop + builder (of MarkupRegionRowBuilder Item Content))
  (prop + filter (? (of MarkupRowFilter Item)))
  (fn-do + This _
    (param parent _)
    (param builder _)
    (param filter (? (of MarkupRowFilter Item)) (= null))
  )
  (fn-do + build Content (?! Error)
    (param item Item)
    (let region (!! (call (. parent markup-make-region))))
    (let tested filter)
    (if tested
      (let row (call (of MarkupFilteredRow Item Content) region item builder tested))
      (call markup-set-region-controller region row)
      (call (. row start))
      (return region)
    )
    (call markup-set-region-controller region (call MarkupRowRegion))
    (call builder item region)
    (return region)
  )
)

(type _ (of MarkupFilteredRow Item Content)
  (implements MarkupRegionController)
  (constraint is Content (of MarkupParent Content))
  (prop + region Content)
  (prop + item Item)
  (prop + builder (of MarkupRegionRowBuilder Item Content))
  (prop + filter (of MarkupRowFilter Item))
  (blank)
  (prop _ branch (? (of MarkupBranchController Content)))
  (prop _ action (? LiveAction))
  (fn-do + This _
    (param region _)
    (param item _)
    (param builder _)
    (param filter _)
  )
  (fn-do + start _ (?! Error)
    (let arms (call (of List (of MarkupBranchBuilder Content))))
    (+= arms (. this build-arm))
    (= branch (call (of MarkupBranchController Content) region arms null))
    (let made (call make-owner-markup-action (call (of List Tracker)) (. this select) region))
    (= action made)
    (call (. made run-now))
    (call mark-structural-markup-action made region)
  )
  (fn-do + build-arm _ (?! Error)
    (param into Content)
    (call builder item into)
  )
  (fn-do + select _ (?! Error)
    (let arm (? Index) (only-if 0 (if (call filter item))))
    (let held (!! branch))
    (if (!= (. held selected-arm) arm)
      (call (. held select-markup-branch) arm)
    )
  )
  (fn-do + close _
    (call (?. action close))
    (= action null)
  )
)

(fn-do _ (of markup-region-row Item Content Host) (of MarkupRowBuilder Item Content)
  (param parent Host)
  (param builder (of MarkupRegionRowBuilder Item Content))
  (constraint is Content (of MarkupParent Content))
  (constraint is Host (of MarkupParent Content))
  (return (. (call (of MarkupRegionRow Item Content Host) parent builder) build))
)

(fn-do _ (of markup-region-keyed-row Item Content Host) (of MarkupCollectionRowBuilder Item Content)
  (param parent Host)
  (param builder (of MarkupRegionRowBuilder (of MarkupRowItem Item) Content))
  (constraint is Content (of MarkupParent Content))
  (constraint is Host (of MarkupParent Content))
  (return (. (call (of MarkupRegionRow (of MarkupRowItem Item) Content Host) parent builder) build))
)

(fn-do _ (of markup-region-filtered-row Item Content Host) (of MarkupRowBuilder Item Content)
  (param parent Host)
  (param builder (of MarkupRegionRowBuilder Item Content))
  (param filter (of MarkupRowFilter Item))
  (constraint is Content (of MarkupParent Content))
  (constraint is Host (of MarkupParent Content))
  (return (. (call (of MarkupRegionRow Item Content Host) parent builder filter) build))
)

(fn-do _ (of markup-region-keyed-filtered-row Item Content Host) (of MarkupCollectionRowBuilder Item Content)
  (param parent Host)
  (param builder (of MarkupRegionRowBuilder (of MarkupRowItem Item) Content))
  (param filter (of MarkupRowFilter (of MarkupRowItem Item)))
  (constraint is Content (of MarkupParent Content))
  (constraint is Host (of MarkupParent Content))
  (return (. (call (of MarkupRegionRow (of MarkupRowItem Item) Content Host) parent builder filter) build))
)

(fn-do _ (of markup-create-branch-region Content Host) Content
  (param parent Host)
  (param arm-builders (list (of MarkupBranchBuilder Content)))
  (param active-arm (? Index))
  (constraint is Content (of MarkupParent Content))
  (constraint is Host (of MarkupParent Content))
  (let region (!! (call (. parent markup-make-region))))
  (call markup-set-region-controller
    (block
      (arg region)
      (arg (call (of MarkupBranchController Content) region arm-builders active-arm))
    )
  )
  (return region)
)

(fn-expr _ (of markup-branch-region-keeps-arm Content) Bool
  (param region Content)
  (param arm (? Index))
  (constraint is Content (of MarkupParent Content))
  (== (. (as (!! (call markup-region-controller region)) (of MarkupBranchController Content)) selected-arm) arm)
)

(type _ MarkupSlotSelector (is (fn-type (? Index) (?! Error))))

(type _ (of MarkupSlotChoice Slot)
  (prop + select MarkupSlotSelector)
  (prop + builders (list (? (of MarkupSlotBuilder Slot))))
  (prop + chosen (? (of MarkupSlotBuilder Slot)))
  (fn-do + This _
    (param select _)
    (param builders _)
  )
)

(fn-do _ (of markup-slot-choice Slot) (of MarkupSlotChoice Slot)
  (param select MarkupSlotSelector)
  (param arms Index)
  (let builders (call (of List (? (of MarkupSlotBuilder Slot)))))
  (for (in _ (..< 0 arms))
    (+= builders null)
  )
  (return (call (of MarkupSlotChoice Slot) select builders))
)

(fn-do _ (of markup-slot-arm Slot) _
  (param choice (of MarkupSlotChoice Slot))
  (param arm Index)
  (param builder (of MarkupSlotBuilder Slot))
  (= ([] (. choice builders) arm) builder)
)

(type _ (of MarkupChosenSlot Slot Content)
  (implements MarkupRegionController)
  (constraint is Content (of MarkupParent Content))
  (prop + region Content)
  (prop + choice (of MarkupSlotChoice Slot))
  (prop + arm (? (of MarkupBranchBuilder Content)))
  (prop + falls-back Bool)
  (blank)
  (prop _ branch (? (of MarkupBranchController Content)))
  (prop _ action (? LiveAction))
  (fn-do + This _
    (param region _)
    (param choice _)
    (param arm _)
    (param falls-back _)
  )
  (fn-do + start _ (?! Error)
    (let arms (call (of List (of MarkupBranchBuilder Content))))
    (for (in _ (..< 0 (+ (. choice builders length) 1)))
      (+= arms (. this build-arm))
    )
    (= branch (call (of MarkupBranchController Content) region arms null))
    (let made (call make-owner-markup-action (call (of List Tracker)) (. this select) region))
    (= action made)
    (call (. made run-now))
    (call mark-structural-markup-action made region)
  )
  (fn-do + select _ (?! Error)
    (let count (. choice builders length))
    (let index count)
    (let taken (call (. choice select)))
    (if (and taken (< taken count) ([] (. choice builders) taken))
      (= index taken)
    )
    (let held (!! branch))
    (if (!= (. held selected-arm) index)
      (= (. choice chosen) (only-if ([] (. choice builders) index) (if (< index count))))
      (call (. held select-markup-branch) index)
    )
  )
  (fn-do + build-arm _ (?! Error)
    (param into Content)
    (let builder (. choice chosen))
    (let outlet arm)
    (if outlet
      (if (or builder falls-back)
        (call outlet into)
      )
      (else-if builder
        (call markup-append into (call (. into markup-content) (call builder)))
      )
    )
  )
  (fn-do + close _
    (call (?. action close))
    (= action null)
  )
)

(fn-do _ (of markup-chosen-slot Slot Content Host) Content (?! Error)
  (param parent Host)
  (param choice (of MarkupSlotChoice Slot))
  (constraint is Content (of MarkupParent Content))
  (constraint is Host (of MarkupParent Content))
  (return (call markup-start-chosen-slot (!! (call (. parent markup-make-region))) choice null false))
)

(fn-do _ (of markup-chosen-arm Slot Content Host) Content (?! Error)
  (param parent Host)
  (param choice (of MarkupSlotChoice Slot))
  (param arm (of MarkupBranchBuilder Content))
  (param falls-back Bool)
  (constraint is Content (of MarkupParent Content))
  (constraint is Host (of MarkupParent Content))
  (return (call markup-start-chosen-slot (!! (call (. parent markup-make-region))) choice arm falls-back))
)

(fn-do _ (of markup-start-chosen-slot Slot Content) Content (?! Error)
  (param region Content)
  (param choice (of MarkupSlotChoice Slot))
  (param arm (? (of MarkupBranchBuilder Content)))
  (param falls-back Bool)
  (constraint is Content (of MarkupParent Content))
  (let chosen (call (of MarkupChosenSlot Slot Content) region choice arm falls-back))
  (call markup-set-region-controller region chosen)
  (call (. chosen start))
  (return region)
)

(fn-expr _ markup-attachment-lane _
  (call C:brixGCMarkupAttachmentsSidePayloadLane)
)

(fn-expr _ markup-detached-overflow-lane _
  ; Style attachments no longer occupy their historical non-root lane. A parentless cleanup token
  ; borrows that slot for its rare overflow so callbacks and query closures cannot trace back from
  ; the cleanup payload to its owner. Root stores still own the lane only on batch-root objects.
  (blank)
  (call C:brixGCStyleAttachmentsSidePayloadLane)
)

(fn-expr _ (of markup-region-controller Node) (? MarkupRegionController)
  (param node Node)
  (constraint is Node MarkupElement)
  (?. (. node markup-attachment-cache) region-controller)
)

(fn-do _ (of markup-set-region-controller Node) _
  (param node Node)
  (param controller MarkupRegionController)
  (constraint is Node MarkupElement)
  (= (. (call markup-ensure-attachment node) region-controller) controller)
)

(fn-do _ markup-ensure-attachment _
  (param object MarkupElement)
  (let object-pointer (as object Pointer))
  (blank)
  (let existing (call markup-attachment object-pointer))
  (if existing
    (return existing)
  )
  (blank)
  (let attachment (call MarkupAttachment))
  (= (. attachment object-address) (as (. object-pointer address) Size))
  (= (. attachment host-witness-address) (as (. (call interface-witness-pointer object) address) Size))
  (= (. attachment retained-host) object)
  (let published
    (call gc-publish-object-side-payload
      (block
        (arg object-pointer)
        (arg (as (call markup-attachment-lane) Size))
        (arg attachment)
      )
    )
  )
  (throw (call Panic "Unable to publish ordinary markup attachment") (if (!= published attachment)))
  (= (. object markup-attachment-cache) attachment)
  (return attachment)
)

(fn-do _ markup-use-cleanup-payload _
  (param attachment MarkupAttachment)
  (return-if (if (. attachment is-cleanup-payload)))
  (blank)
  (let object-pointer (. attachment object-pointer))
  (let overflow (. attachment overflow))
  (if overflow
    (= (. attachment overflow) null)
    (let published-overflow
      (call gc-publish-object-side-payload
        (block
          (arg object-pointer)
          (arg (as (call markup-detached-overflow-lane) Size))
          (arg overflow)
        )
      )
    )
    (throw (call Panic "Unable to detach markup attachment overflow") (if (!= published-overflow overflow)))
  )
  (call C:brixGCClearObjectSidePayload object-pointer (call markup-attachment-lane))
  (= (. attachment retained-host) null)
  (= (. attachment retained-store) null)
  (let callback (as markup-reclaim-attachment GCManagedCleanupCallback))
  (let payload (as attachment Pointer))
  (let published
    (call C:brixGCPublishCleanupObjectSidePayload
      (block
        (arg object-pointer)
        (arg (call markup-attachment-lane))
        (arg payload)
        (arg callback)
      )
    )
  )
  (throw (call Panic "Unable to publish markup attachment cleanup") (if (!= published payload)))
  (= (. attachment is-cleanup-payload) true)
)

(fn-do _ markup-use-ordinary-payload _
  (param attachment MarkupAttachment)
  (param owner MarkupElement)
  (if (. attachment is-cleanup-payload)
    (let cleanup-cleared
      (call C:brixGCClearCleanupObjectSidePayload
        (block
          (arg (. attachment object-pointer))
          (arg (call markup-attachment-lane))
        )
      )
    )
    (throw (call Panic "Unable to clear markup attachment cleanup") (if (not cleanup-cleared)))
    (= (. attachment is-cleanup-payload) false)
    (let overflow
      (call (of gc-object-side-payload MarkupAttachmentOverflow)
        (block
          (arg (. attachment object-pointer))
          (arg (as (call markup-detached-overflow-lane) Size))
        )
      )
    )
    (if overflow
      (call C:brixGCClearObjectSidePayload (. attachment object-pointer) (call markup-detached-overflow-lane))
      (= (. attachment overflow) overflow)
    )
    (if (!= (. attachment store-address) 0)
      (= (. attachment retained-store)
        (call (of gc-interface-from-pointer MarkupRootElement)
          (block
            (arg (as (. attachment store-address) Pointer))
            (arg (as (. attachment store-witness-address) Pointer))
          )
        )
      )
    )
    (= (. attachment retained-host) owner)
    (let published
      (call gc-publish-object-side-payload
        (block
          (arg (. attachment object-pointer))
          (arg (as (call markup-attachment-lane) Size))
          (arg attachment)
        )
      )
    )
    (throw (call Panic "Unable to publish ordinary markup attachment") (if (!= published attachment)))
    (return)
  )
  (blank)
  (= (. attachment retained-host) owner)
)

(fn-do _ markup-reclaim-attachment Size
  (param context-pointer Pointer)
  (let attachment (call (of gc-object-from-pointer MarkupAttachment) context-pointer))
  (for (in hook markup-attachment-reclaim-hooks)
    (call hook attachment)
  )
  (return 1)
)

(fn-expr _ markup-root-store _
  (param root MarkupRootElement)
  (param object-pointer Pointer)
  (case? (== root-pointer object-pointer)
    root
  )
  (default
    (?. (call markup-attachment root) store)
  )
  (where
    (lazy root-pointer (as root Pointer))
  )
)

(fn-do _ markup-parent-attachment _
  (param store MarkupRootElement)
  (param parent (? MarkupElement))
  (if parent
    (let candidate (call markup-attachment parent))
    (if (and candidate (== (. candidate store) store))
      (return candidate)
    )
  )
)

(fn-do _ markup-assert-structural-child-linkable _
  (param parent MarkupElement)
  (param child MarkupElement)
  (param anchor (? MarkupElement))
  (let child-attachment (call markup-attachment child))
  (throw (call Panic "Markup child was closed by the markup that embedded it and cannot be embedded again") (if (and child-attachment (call markup-was-closed child-attachment))))
  (throw (call Panic "Markup child is already linked") (if (and child-attachment (or (. child-attachment structural-parent) (. child-attachment previous-sibling) (. child-attachment next-sibling)))))
  (blank)
  (if anchor
    (let parent-attachment (call markup-attachment parent))
    (let anchor-attachment (call markup-attachment anchor))
    (throw (call Panic "Markup anchor is not linked under parent") (if (or (not parent-attachment) (not anchor-attachment) (!= (. anchor-attachment structural-parent) parent-attachment))))
  )
)

(fn-do _ markup-was-closed Bool
  (param attachment MarkupAttachment)
  (let cursor (? MarkupAttachment) attachment)
  (while cursor
    (return-if true (if (. cursor is-closed)))
    (= cursor (. cursor structural-parent))
  )
  (return false)
)

(fn-do _ markup-link-structural-child _
  (param parent MarkupElement)
  (param child MarkupElement)
  (param anchor (? MarkupElement))
  (let parent-attachment (call markup-ensure-attachment parent))
  (call markup-use-ordinary-payload parent-attachment parent)
  (blank)
  (let child-attachment (call markup-ensure-attachment child))
  (call markup-use-ordinary-payload child-attachment child)
  (blank)
  (throw (call Panic "Markup child is already linked") (if (or (. child-attachment structural-parent) (. child-attachment previous-sibling) (. child-attachment next-sibling))))
  (blank)
  (if anchor
    (let anchor-attachment (call markup-attachment anchor))
    (throw (call Panic "Markup anchor is not linked under parent") (if (or (not anchor-attachment) (!= (. anchor-attachment structural-parent) parent-attachment))))
    (blank)
    (let previous (. anchor-attachment previous-sibling))
    (= (. child-attachment structural-parent) parent-attachment)
    (= (. child-attachment previous-sibling) previous)
    (= (. child-attachment next-sibling) anchor-attachment)
    (= (. anchor-attachment previous-sibling) child-attachment)
    (if previous
      (= (. previous next-sibling) child-attachment)
      (else
        (= (. parent-attachment first-child) child-attachment)
      )
    )
    (else
      (let previous (. parent-attachment last-child))
      (= (. child-attachment structural-parent) parent-attachment)
      (= (. child-attachment previous-sibling) previous)
      (if previous
        (= (. previous next-sibling) child-attachment)
        (else
          (= (. parent-attachment first-child) child-attachment)
        )
      )
      (= (. parent-attachment last-child) child-attachment)
    )
  )
  (blank)
  (call markup-shift-departing parent-attachment (call markup-departure-weight child) true)
)

(fn-do _ markup-unlink-structural-child _
  (param parent MarkupElement)
  (param child MarkupElement)
  (let parent-attachment (call markup-attachment parent))
  (let child-attachment (call markup-attachment child))
  (return-if (if (not parent-attachment)))
  (return-if (if (not child-attachment)))
  (return-if (if (!= (. child-attachment structural-parent) parent-attachment)))
  (blank)
  (let previous (. child-attachment previous-sibling))
  (let next (. child-attachment next-sibling))
  (blank)
  (if previous
    (= (. previous next-sibling) next)
    (else
      (= (. parent-attachment first-child) next)
    )
  )
  (blank)
  (if next
    (= (. next previous-sibling) previous)
    (else
      (= (. parent-attachment last-child) previous)
    )
  )
  (blank)
  (= (. child-attachment structural-parent) null)
  (= (. child-attachment previous-sibling) null)
  (= (. child-attachment next-sibling) null)
  (call markup-shift-departing parent-attachment (call markup-departure-weight child) false)
  (blank)
  (if (and (not (. parent-attachment first-child)) (not (. parent-attachment mounted-parent)))
    (if (and (. parent-attachment mounted-callback-fired) (. parent-attachment store))
      (let store-pointer (as (!! (. parent-attachment store)) Pointer))
      (if (!= (as parent Pointer) store-pointer)
        (call markup-use-cleanup-payload parent-attachment)
      )
    )
  )
)

(fn-do _ markup-mount-attachment _
  (param node MarkupElement)
  (param commit MarkupMountCommit)
  (param should-record-mounted Bool)
  (param root MarkupRootElement)
  (param parent (? MarkupElement))
  (let node-pointer (as node Pointer))
  (let attachment (call markup-ensure-attachment node))
  (let store (call markup-root-store root node-pointer))
  (return-if (if (not store)))
  (blank)
  (let live-store store)
  (let root-pointer (as root Pointer))
  (if (and (!= node-pointer root-pointer) (not parent) should-record-mounted (not (. attachment first-child)))
    (call markup-use-cleanup-payload attachment)
    (else
      (call markup-use-ordinary-payload attachment node)
    )
  )
  (call (. attachment set-store) live-store)
  (blank)
  (= (. attachment mounted-parent) null)
  (let parent-attachment (call markup-parent-attachment live-store parent))
  (if parent-attachment
    (= (. attachment mounted-parent) parent-attachment)
  )
  (blank)
  (call markup-refresh-ancestor-queries attachment)
  (call markup-record-mounted-callback node attachment commit should-record-mounted)
  (= (. attachment is-released) false)
  (call markup-resume-actions attachment)
  (return true)
)

(fn-do _ markup-record-mounted-callback _
  (param node MarkupElement)
  (param attachment MarkupAttachment)
  (param commit MarkupMountCommit)
  (param should-record-mounted Bool)
  (return-if (if (not should-record-mounted)))
  (return-if (if (. attachment mounted-callback-fired)))
  (blank)
  (= (. attachment mounted-callback-fired) true)
  (call (. commit record-mounted) node)
)

(fn-do _ markup-update-parent _
  (param attachment MarkupAttachment)
  (param commit MarkupMountCommit)
  (param should-record-mounted Bool)
  (param parent (? MarkupElement))
  (let store (!! (. attachment store)))
  (let previous-parent (. attachment mounted-parent))
  (let next-parent (call markup-parent-attachment store parent))
  (blank)
  (if (== previous-parent next-parent)
    (let host (. attachment host))
    (call markup-record-mounted-callback host attachment commit should-record-mounted)
    (return)
  )
  (if previous-parent
    (= (. attachment mounted-parent) null)
  )
  (blank)
  (if next-parent
    (= (. attachment mounted-parent) next-parent)
  )
  (blank)
  (if markup-ancestor-query-active
    (call markup-refresh-ancestor-queries-in-subtree (. attachment host))
  )
  (blank)
  (let host (. attachment host))
  (call markup-record-mounted-callback host attachment commit should-record-mounted)
)

(fn-do _ markup-unmount-attachment _
  (param attachment MarkupAttachment)
  (let store (. attachment store))
  (return-if (if (not store)))
  (blank)
  (let host (. attachment host))
  (call markup-use-ordinary-payload attachment host)
  (blank)
  (call (. attachment clear-store))
  (= (. attachment mounted-parent) null)
  (= (. attachment mounted-callback-fired) false)
  (call markup-refresh-ancestor-queries attachment)
  (blank)
  (call (. host unmounted))
  (= (. attachment is-released) true)
)

(fn-do _ markup-finish-unmount-attachment _
  (param attachment MarkupAttachment)
  (return-if (if (. attachment store)))
  (blank)
  (= (. attachment mounted-parent) null)
)

(fn-do _ markup-apply-mount _
  (param node MarkupElement)
  (param commit MarkupMountCommit)
  (param should-record-mounted Bool)
  (param parent (? MarkupElement))
  (param root (? MarkupRootElement))
  (let node-pointer (as node Pointer))
  (let existing (call markup-attachment node-pointer))
  (blank)
  (if (not root)
    (if (and existing (. existing store))
      (call markup-unmount-attachment existing)
      (return true)
    )
    (return false)
  )
  (blank)
  (let batch root)
  (let root-pointer (as batch Pointer))
  (if (and existing (. existing store))
    (let live existing)
    (let live-store (!! (. live store)))
    (let live-root-pointer (as live-store Pointer))
    (if (!= live-root-pointer root-pointer)
      (call markup-unmount-attachment live)
      (return (call markup-mount-attachment node commit should-record-mounted batch parent))
    )
    (call markup-update-parent live commit should-record-mounted parent)
    (return false)
  )
  (blank)
  (return (call markup-mount-attachment node commit should-record-mounted batch parent))
)

(fn-do _ markup-refresh-ancestor-queries _
  (param attachment MarkupAttachment)
  (let changed false)
  (if (not markup-ancestor-query-active)
    (return changed)
  )
  (blank)
  (let overflow (. attachment overflow))
  (if (and overflow (. overflow ancestor-queries))
    (for (in refresh (. overflow ancestor-queries))
      (if (call refresh)
        (= changed true)
      )
    )
  )
  (return changed)
)

(fn-do _ markup-refresh-ancestor-queries-in-subtree Bool
  (param node MarkupElement)
  (let changed false)
  (if (not markup-ancestor-query-active)
    (return changed)
  )
  (blank)
  (let attachment (call markup-attachment node))
  (if (and attachment (. attachment store))
    (= changed (or (call markup-refresh-ancestor-queries attachment) changed))
  )
  (blank)
  (let child (call markup-structural-first-child-host node))
  (while child
    (= changed (or (call markup-refresh-ancestor-queries-in-subtree child) changed))
    (= child (call markup-structural-next-sibling-host child))
  )
  (blank)
  (return changed)
)

(fn-do _ markup-settle-external-hooks _
  (param root MarkupRootElement)
  (let settled false)
  (let pending-domain-mask U32)
  (for (in settle markup-batch-settle-hooks)
    (probe-group + tui.frame.markup.settle)
    (let result (call settle root))
    (probe-group - tui.frame.markup.settle)
    (= settled (or settled (. result settled)))
    (= pending-domain-mask (/or/ pending-domain-mask (. result pending-domain-mask)))
  )
  (blank)
  (return (call MarkupBatchSettleResult settled pending-domain-mask))
)

(fn-do _ markup-query-publish-target-id _
  (param target MarkupAttachment)
  (param target-id Size)
  (param is-added Bool)
  (let target-host (. target host))
  (return-if (if (not markup-descendants-query-active)))
  (blank)
  (let cursor (. target mounted-parent))
  (while cursor
    (let ancestor cursor)
    (probe-count markup.query.target-adjusts)
    (let overflow (. ancestor overflow))
    (if (and overflow (. overflow descendants-queries))
      (let bindings (call (of List MarkupDescendantsQueryBinding) (. overflow descendants-queries)))
      (probe-count markup.query.binding-copies)
      (probe-count markup.query.binding-copy-items (. bindings length))
      (for (in binding bindings (when (== (. binding target-id) target-id)))
        (if is-added
          (let add (. binding add))
          (call add target-host)
          (else
            (let remove (. binding remove))
            (call remove target-host)
          )
        )
      )
    )
    (let ancestor-host (. ancestor host))
    (if (. ancestor-host markup-query-boundary)
      (break)
    )
    (= cursor (. ancestor mounted-parent))
  )
)

(fn-do _ markup-query-publish-subtree _
  (param node MarkupElement)
  (param is-added Bool)
  (let attachment (call markup-attachment node))
  (return-if (if (not markup-descendants-query-active)))
  (blank)
  (return-if (if (not attachment)))
  (return-if (if (not (. attachment store))))
  (blank)
  (probe-count markup.query.publish-visits)
  (call markup-query-apply-subtree-targets node is-added)
)

(fn-do _ markup-query-apply-subtree-targets _
  (param node MarkupElement)
  (param is-added Bool)
  (param binding (? MarkupDescendantsQueryBinding) (= null))
  (let attachment (call markup-attachment node))
  (return-if (if (not attachment)))
  (return-if (if (not (. attachment store))))
  (blank)
  (probe-count markup.query.publish-visits)
  (if binding
    (let live-binding binding)
    (let target-id (. live-binding target-id))
    (let target-ids (? (list Size)))
    (if (. attachment overflow)
      (let overflow (. attachment overflow))
      (= target-ids (. overflow descendant-target-ids))
    )
    (if (and target-ids (has target-ids target-id))
      (if is-added
        (let add (. live-binding add))
        (call add node)
        (else
          (let remove (. live-binding remove))
          (call remove node)
        )
      )
    )
    (if (. node markup-query-boundary)
      (return-if (if (!= (as (. live-binding owner) Pointer) (as node Pointer))))
    )
    (let child (call markup-structural-first-child-host node))
    (while child
      (call markup-query-apply-subtree-targets child is-added live-binding)
      (= child (call markup-structural-next-sibling-host child))
    )
    (return)
  )
  (let overflow (. attachment overflow))
  (if (and overflow (. overflow descendant-target-ids))
    (let ids (call (of List Size) (. overflow descendant-target-ids)))
    (for (in target-id ids)
      (call markup-query-publish-target-id attachment target-id is-added)
    )
  )
  (blank)
  (let child (call markup-structural-first-child-host node))
  (while child
    (call markup-query-apply-subtree-targets child is-added)
    (= child (call markup-structural-next-sibling-host child))
  )
)

(fn-do _ markup-query-seed-descendants-binding _
  (param owner MarkupAttachment)
  (param binding MarkupDescendantsQueryBinding)
  (let owner-host (. owner host))
  (blank)
  (let child (call markup-structural-first-child-host owner-host))
  (while child
    (call markup-query-apply-subtree-targets child true binding)
    (= child (call markup-structural-next-sibling-host child))
  )
)

(fn-do _ markup-query-host-precedes _
  (param owner MarkupElement)
  (param left MarkupElement)
  (param right MarkupElement)
  (let owner-attachment (call markup-attachment owner))
  (let left-attachment (call markup-attachment left))
  (let right-attachment (call markup-attachment right))
  (return-if (if (or (not owner-attachment) (not left-attachment) (not right-attachment))))
  (blank)
  (let left-depth (call markup-query-depth-from-owner left-attachment owner-attachment))
  (let right-depth (call markup-query-depth-from-owner right-attachment owner-attachment))
  (return-if (if (or (not left-depth) (not right-depth))))
  (blank)
  (let original-left-depth left-depth)
  (let original-right-depth right-depth)
  (let left-live-depth original-left-depth)
  (let right-live-depth original-right-depth)
  (let left-cursor left-attachment)
  (let right-cursor right-attachment)
  (blank)
  (while (> left-live-depth right-live-depth)
    (return-if (if (not (. left-cursor mounted-parent))))
    (= left-cursor (. left-cursor mounted-parent))
    (-= left-live-depth 1)
  )
  (blank)
  (while (> right-live-depth left-live-depth)
    (return-if (if (not (. right-cursor mounted-parent))))
    (= right-cursor (. right-cursor mounted-parent))
    (-= right-live-depth 1)
  )
  (blank)
  (if (== left-cursor right-cursor)
    (return (< original-left-depth original-right-depth))
  )
  (blank)
  (while (and (. left-cursor mounted-parent) (. right-cursor mounted-parent) (!= (. left-cursor mounted-parent) (. right-cursor mounted-parent)))
    (= left-cursor (. left-cursor mounted-parent))
    (= right-cursor (. right-cursor mounted-parent))
  )
  (blank)
  (return-if (if (not (. left-cursor mounted-parent))))
  (return-if (if (!= (. left-cursor mounted-parent) (. right-cursor mounted-parent))))
  (blank)
  (let sibling (? MarkupAttachment) left-cursor)
  (while sibling
    (return-if true (if (== sibling right-cursor)))
    (= sibling (. sibling next-sibling))
  )
  (blank)
  (return false)
)

(fn-do _ markup-query-depth-from-owner _
  (param attachment MarkupAttachment)
  (param owner MarkupAttachment)
  (let depth Size 0)
  (let cursor (? MarkupAttachment) attachment)
  (while cursor
    (let live cursor)
    (if (== live owner)
      (return depth)
    )
    (+= depth 1)
    (= cursor (. live mounted-parent))
  )
)

(fn-do _ markup-adopt-core _
  (param node MarkupElement)
  (param commit MarkupMountCommit)
  (param should-record-mounted Bool)
  (param parent (? MarkupElement))
  (param root (? MarkupRootElement))
  (let should-walk (call markup-apply-mount node commit should-record-mounted parent root))
  (for (in hook markup-mount-hooks)
    (if (call hook node parent root)
      (= should-walk true)
    )
  )
  (blank)
  (if should-walk
    (let child (call markup-structural-first-child-host node))
    (while child
      (call markup-adopt-core child commit should-record-mounted node root)
      (= child (call markup-structural-next-sibling-host child))
    )
  )
  (blank)
  (if (and (not root) should-walk)
    (let attachment (call markup-attachment node))
    (if (and attachment (not (. attachment store)))
      (call markup-finish-unmount-attachment attachment)
    )
  )
)

(fn-do _ ensure-markup-root _
  (param node MarkupElement)
  (param root (? MarkupRootElement))
  ; Install root context for generated builders before child links are committed.
  (blank)
  (return-if (if (not root)))
  (blank)
  (let batch root)
  (let attachment (call markup-attachment node))
  (if (and attachment (. attachment store))
    (let live attachment)
    (let store (!! (. live store)))
    (let root-pointer (as batch Pointer))
    (let store-pointer (as store Pointer))
    (return-if (if (== store-pointer root-pointer)))
  )
  (blank)
  (let commit (call MarkupMountCommit))
  (call markup-adopt-core node commit false null root)
)

(fn-do _ (of markup-attach-new-child Host Child) _
  (param parent Host)
  (param child Child)
  (param anchor (? Child))
  (constraint is Host MarkupParent)
  (constraint is Child MarkupElement)
  (let parent-host (as parent MarkupElement))
  (let root (call markup-root-of parent-host))
  (let commit (call MarkupMountCommit))
  (let linked false)
  (let committed false)
  (blank)
  (call markup-assert-structural-child-linkable parent-host child anchor)
  (finally
    (if (not committed)
      (catch (call markup-release child))
      (if linked
        (call markup-unlink-structural-child parent-host child)
      )
    )
  )
  (blank)
  (call markup-link-structural-child parent-host child anchor)
  (= linked true)
  (call (. parent markup-attach-child) child anchor)
  (call markup-adopt-core child commit true parent root)
  (call markup-query-publish-subtree child true)
  (= committed true)
  (return commit)
)

(fn-do _ markup-batch-roots-match _
  (param left (? MarkupRootElement))
  (param right (? MarkupRootElement))
  (if (not left)
    (return-if (if right))
    (return true)
  )
  (blank)
  (return-if (if (not right)))
  (blank)
  (let left-queue (as (. left markup-batch-queue) Pointer))
  (let right-queue (as (. right markup-batch-queue) Pointer))
  (return (== left-queue right-queue))
)

(fn-do _ (of markup-region-children Content) (list Content)
  (param region Content)
  (constraint is Content (of MarkupParent Content))
  (let skips (> (?? (?. (call markup-attachment region) departing-within) 1) 0))
  (let maybe-child (. region %first-child))
  (if maybe-child
    (let child maybe-child)
    (while true
      (if (or (not skips) (not (call markup-is-departing child)))
        (yield child)
      )
      (if (not (. child %next-sibling))
        (break)
      )
      (= child (!! (. child %next-sibling)))
    )
  )
)

(fn-do _ (of markup-region-child-at Content) (? Content)
  (param region Content)
  (param index Index)
  (constraint is Content (of MarkupParent Content))
  (let skips (> (?? (?. (call markup-attachment region) departing-within) 1) 0))
  (let cursor (. region %first-child))
  (let current Index 0)
  (while cursor
    (if (or (not skips) (not (call markup-is-departing cursor)))
      (if (== current index)
        (return cursor)
      )
      (+= current 1)
    )
    (= cursor (. cursor %next-sibling))
  )
)

(fn-do _ (of markup-region-follows Content) Bool
  (param child Content)
  (param anchor (? Content))
  (constraint is Content (of MarkupParent Content))
  (let cursor (. child %next-sibling))
  (while (and cursor (call markup-is-departing cursor))
    (= cursor (. cursor %next-sibling))
  )
  (return-if (not cursor) (if (not anchor)))
  (return-if (if (not cursor)))
  (return (== (as cursor Pointer) (as anchor Pointer)))
)

(fn-do _ (of markup-region-clear-children Content) _
  (param region Content)
  (constraint is Content (of MarkupParent Content))
  ; Departs each child a region shows. A child closes its events when it closes, so that what
  ; subscribes to an element a region no longer shows hears nothing more of it, whether or not the
  ; element's own class declares the events.
  (let children (call (of List Content)))
  (for (in child (call markup-region-children region))
    (+= children child)
  )
  (for (in child children)
    (call markup-depart-child region child)
  )
)

(fn-do _ (of markup-depart-child Host Child) Bool
  (param parent Host)
  (param child Child)
  (param finished (? Doer) (= null))
  (constraint is Host MarkupParent)
  (constraint is Child MarkupElement)
  (let leaves (call (. child markup-depart)))
  (let attachment (call markup-attachment child))
  (if (and attachment (or leaves (. attachment departing-within)))
    (let finish Doer
      (=> () :do
        (block
          (if (call markup-links parent child)
            (call markup-finish-child parent child)
          )
          (if finished
            (call finished)
          )
        )
      )
    )
    (= (. (call (. attachment overflow-for-write)) departure) (call MarkupDeparture finish leaves))
    (+= markup-departures 1)
    (call markup-shift-departing (. attachment structural-parent) 1 true)
    (return true)
  )
  (call markup-finish-child parent child)
  (return false)
)

(fn-do _ markup-revive-child Bool
  (param child MarkupElement)
  (let attachment (call markup-attachment child))
  (return-if (if (or (not attachment) (not (. attachment departure)))))
  (let ancestor (. attachment structural-parent))
  (while ancestor
    (return-if (if (. ancestor departure)))
    (= ancestor (. ancestor structural-parent))
  )
  (= (. (call (. attachment overflow-for-write)) departure) null)
  (-= markup-departures 1)
  (call markup-shift-departing (. attachment structural-parent) 1 false)
  (call (. child markup-revive))
  (call markup-resume-actions attachment)
  (return true)
)

(fn-do _ markup-hold-action Bool
  (param action MarkupBatchAction)
  (let owner (?? (. action structural-owner) (. action batch-owner)))
  (return-if false (if (not owner)))
  (let attachment (call markup-attachment owner))
  (return-if false (if (not attachment)))
  (let holder (if-expr (. attachment is-released) attachment (call markup-departing-attachment attachment)))
  (return-if false (if (not holder)))
  (return-if true (if (. action is-held)))
  (= (. action is-held) true)
  (let overflow (call (. holder overflow-for-write)))
  (if (not (. overflow held-actions))
    (= (. overflow held-actions) (call (of List MarkupBatchAction)))
  )
  (+= (!! (. overflow held-actions)) action)
  (return true)
)

(fn-do _ markup-departing-attachment (? MarkupAttachment)
  (param attachment MarkupAttachment)
  (return-if null (if (== markup-departures 0)))
  (let cursor (? MarkupAttachment) attachment)
  (while cursor
    (return-if cursor (if (. cursor departure)))
    (= cursor (. cursor structural-parent))
  )
  (return null)
)

(fn-do _ markup-resume-actions _
  (param attachment MarkupAttachment)
  (let overflow (. attachment overflow))
  (return-if (if (not overflow)))
  (let held (. overflow held-actions))
  (return-if (if (not held)))
  (= (. overflow held-actions) null)
  (for (in action held)
    (= (. action is-held) false)
    (if (not (. action is-closed))
      (call action)
    )
  )
)

(fn-do _ (of markup-finish-child Host Child) _
  (param parent Host)
  (param child Child)
  (constraint is Host MarkupParent)
  (constraint is Child MarkupElement)
  (let weight (call markup-departure-weight child))
  (call markup-unlink-structural-child parent child)
  (call (. parent markup-detach-child) child)
  (call markup-release child)
  (call markup-close-child child)
  (call event-close-owner (as child Pointer))
  (if weight
    (call markup-settle-departures (call markup-attachment (as parent MarkupElement)))
  )
)

(fn-do _ (of markup-close-child Child) _
  (param child Child)
  (constraint is Child MarkupElement)
  (let attachment (call markup-attachment child))
  (if attachment
    (= (. attachment is-closed) true)
  )
  (call (. child close))
)

(fn-do _ markup-links Bool
  (param parent MarkupElement)
  (param child MarkupElement)
  (let parent-attachment (call markup-attachment parent))
  (let child-attachment (call markup-attachment child))
  (return-if (if (or (not parent-attachment) (not child-attachment))))
  (return (== (. child-attachment structural-parent) parent-attachment))
)

(fn-do _ markup-end-departure _
  (param attachment MarkupAttachment)
  (let departure (. attachment departure))
  (return-if (if (not departure)))
  (call (. departure finish)
    (block
      (on-error (: error Error)
        (call unhandled-error error)
      )
    )
  )
  (= (. (call (. attachment overflow-for-write)) departure) null)
  (-= markup-departures 1)
  (call markup-resume-actions attachment)
)

(fn-do _ markup-departure-weight Size
  (param host MarkupElement)
  (let attachment (call markup-attachment host))
  (return-if 0 (if (not attachment)))
  (let weight (. attachment departing-within))
  (if (. attachment departure)
    (+= weight 1)
  )
  (return weight)
)

(fn-do _ markup-shift-departing _
  (param start (? MarkupAttachment))
  (param count Size)
  (param adds Bool)
  (return-if (if (not count)))
  (let cursor start)
  (while cursor
    (let overflow (call (. cursor overflow-for-write)))
    (if adds
      (+= (. overflow departing-within) count)
      (else
        (-= (. overflow departing-within) count)
      )
    )
    (= cursor (. cursor structural-parent))
  )
)

(fn-do _ markup-settle-departures _
  (param start (? MarkupAttachment))
  (let cursor start)
  (while cursor
    (return-if (if (. cursor departing-within)))
    (let departure (. cursor departure))
    (if departure
      (if (not (. departure is-host-leaving))
        (call markup-end-departure cursor)
      )
      (return)
    )
    (= cursor (. cursor structural-parent))
  )
)
