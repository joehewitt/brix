(blank)
(prop + markup-cause-none _ (= (call MarkupCause)))
(prop + markup-cause-write _ (= (call MarkupCause)))
(blank)
(prop _ markup-keyed-linear-scan-limit Size (= 32))
(prop _ markup-batch-settle-hooks (list MarkupBatchSettleHook))
(prop _ markup-mount-hooks (list MarkupMountHook))
(prop _ markup-attachment-reclaim-hooks (list MarkupAttachmentReclaimHook))
(prop _ markup-theme-tag-hook (? MarkupThemeTagHook))
(prop _ markup-theme-hook (? MarkupThemeHook))
(prop _ markup-ancestor-query-active _ (= false))
(prop _ markup-descendants-query-active _ (= false))
(prop _ markup-departures Size (= 0))
(prop _ markup-cause-current _ (= markup-cause-write))

(type + MarkupStyleSlot (is U32)
  (variant before)
  (variant after)
  (variant first-child)
  (variant last-child)
)

(type + MarkupCause)

(type + (of MarkupSlotBuilder Content) (is (fn-type Content (?! Error))))

(type + (of Ancestor Target)
  ; Compiler hint for generated containment queries.
)

(type + (of Descendants Target)
  ; Compiler hint for generated containment queries.
)

(type + (of MarkupChangeSet Target)
  (prop + added (list Target) (= (call (of List Target))))
  (prop + removed (list Target) (= (call (of List Target))))
  (fn-do + clear _
    (call (. added clear))
