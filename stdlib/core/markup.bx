(type + MarkupBatchSettleResult (is Tuple)
  (prop + settled Bool)
  (blank)
  (prop _ pending-domain-mask U32)
)

(type + MarkupBatchFlush (is Tuple)
  (prop + applied Size)
  (blank)
  (prop _ pending-domain-mask U32)
)

(type + ThemeTag (is Tuple)
  (prop + name String)
  (prop + active (? Bool))
)

(type + MarkupRootElement (is Interface)
  (fn-expr + markup-batch-queue MarkupBatchQueue :get)
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + MarkupBatchQueue
  (prop + root (? MarkupRootElement))
  (prop + actions (list MarkupBatchAction))
  (prop + max-actions-per-checkpoint Size (= 4096))
  (prop + max-passes-per-checkpoint Size (= 16))
  (blank)
  (prop _ is-scheduled _ (= false))
  (prop _ is-flushing _ (= false))
  (prop _ should-settle-on-flush _ (= false))
  (prop _ max-depth Size (= 0))
  (prop _ probed-max-depth Size (= 0))
  (fn-do + This _
    (param root _)
  )
  (fn-expr + is-active _ :get
    is-flushing
  )
  (fn-do + enqueue _
    (param action MarkupBatchAction)
    (+= actions action)
    (probe-count markup.batch.enqueues)
    (if (> (. actions length) max-depth)
      (= max-depth (. actions length))
      (probe-count markup.batch.max-depth (- max-depth probed-max-depth))
      (= probed-max-depth max-depth)
    )
    (call schedule false)
  )
  (fn-do + schedule _
    (param should-settle Bool (= true))
    (if should-settle
      (= should-settle-on-flush true)
    )
    (blank)
    (return-if (if is-scheduled))
    (return-if (if is-flushing))
    (blank)
    (= is-scheduled true)
    (do-new @priority
      (= is-scheduled false)
      ; Scheduled flushes have no caller to receive action errors.
      (catch (call flush))
    )
  )
  (fn-do + checkpoint _
    (call flush)
  )
  (fn-do _ flush _
    (return-if (if is-flushing))
    (blank)
    (probe-group + tui.frame.markup.flush)
    (= is-flushing true)
    (finally
      (= is-flushing false)
    )
    (blank)
    (let applied Size 0)
    (let passes Size 0)
    (let settled false)
    (let pending-domain-mask U32)
    (let should-settle (and should-settle-on-flush (!= root null)))
    (= should-settle-on-flush false)
    (while (and (or actions should-settle) (< applied max-actions-per-checkpoint) (< passes max-passes-per-checkpoint))
      (probe-group + tui.frame.markup.actions)
      (let pass-applied Size 0)
      (if actions
        (+= passes 1)
        (call order-structural-actions-first)
        (let pass-count (. actions length))
        (let processed Size 0)
        (let scanned pass-count)
        (let reshaped (call (of List MarkupAttachment)))
        (let deferred (call (of List MarkupBatchAction)))
        (while (and (< processed pass-count) (< processed (. actions length)) (< applied max-actions-per-checkpoint))
          (let action ([] actions processed))
          (+= processed 1)
          (if (and reshaped (call markup-action-is-reshaped action reshaped))
            (+= deferred action)
            (continue)
          )
          (if (call (. action run-markup-batch-action) root)
            (+= applied 1)
            (+= pass-applied 1)
          )
          (while (< scanned (. actions length))
            (let queued ([] actions scanned))
            (+= scanned 1)
            (if (and (. queued is-structural) (. queued structural-owner))
              (let attachment (call markup-attachment (. queued structural-owner)))
              (if attachment
                (+= reshaped attachment)
              )
            )
          )
        )
        (if processed
          (call (. actions slide) (- processed))
        )
        (if deferred
          (for (in action actions)
            (+= deferred action)
          )
          (= actions deferred)
        )
      )
      (probe-group - tui.frame.markup.actions)
      (blank)
      (let should-run-settle (or should-settle (!= pass-applied 0)))
      (= should-settle false)
      (if (and root should-run-settle)
        (let external-result (call markup-settle-external-hooks root))
        (= settled (or settled (. external-result settled)))
        (= pending-domain-mask (/or/ pending-domain-mask (. external-result pending-domain-mask)))
        (= should-settle (> (. actions length) 0))
      )
    )
    (probe-count tui.frame.markup.actions-applied applied)
    (probe-count tui.frame.markup.passes passes)
    (probe-count markup.batch.actions-applied applied)
    (probe-count markup.batch.passes passes)
    (blank)
    (if (and root (or (!= applied 0) settled))
      (let flush (call MarkupBatchFlush applied pending-domain-mask))
      (probe-group + tui.frame.markup.did-flush)
      (call (. (!! root) markup-batch-did-flush) flush)
      (probe-group - tui.frame.markup.did-flush)
    )
    (blank)
    (= is-flushing false)
    (blank)
    (if actions
      (if (or (>= applied max-actions-per-checkpoint) (>= passes max-passes-per-checkpoint))
        (probe-count markup.batch.cap-hits)
      )
      (call schedule)
    )
    (probe-group - tui.frame.markup.flush)
  )
  (fn-do _ order-structural-actions-first _
    (let index Size 0)
    (let structural-count Size 0)
    (let seen-other false)
    (let needs-order false)
    (while (< index (. actions length))
      (if (not (. ([] actions index) is-structural))
        (= seen-other true)
        (else
          (+= structural-count 1)
          (if seen-other
            (= needs-order true)
          )
        )
      )
      (+= index 1)
    )
    (return-if (if (and (not needs-order) (< structural-count 2))))
    (blank)
    (let structural (call (of List MarkupBatchAction)))
    (let depths (call (of List Size)))
    (for (in action actions)
      (if (. action is-structural)
        (let depth (call markup-host-depth (. action structural-owner)))
        (let slot (. structural length))
        (while (and (> slot 0) (> ([] depths (- slot 1)) depth))
          (-= slot 1)
        )
        (if (!= slot (. structural length))
          (= needs-order true)
        )
        (call (. structural insert) action slot)
        (call (. depths insert) depth slot)
      )
    )
    (return-if (if (not needs-order)))
    (blank)
    (for (in action actions)
      (if (not (. action is-structural))
        (+= structural action)
      )
    )
    (= actions structural)
  )
)

(type + MarkupBatchAction (is LiveAction)
  (prop + batch-root (? MarkupRootElement))
  (prop + batch-owner (? MarkupElement))
  (prop + is-structural _ (= false))
  (prop + structural-owner (? MarkupElement))
  (prop + cause _ (= markup-cause-write))
  (prop + accepts-run _ (=> true))
  (blank)
  ; 0 idle, 1 enqueued, 2 running, 3 closed
  (prop _ state _ (= 0))
  (prop _ queued-root (? MarkupRootElement))
  (prop _ is-held _ (= false))
  (fn-do + This _
    (param root MarkupRootElement)
    (param initial-trackers (list Tracker))
    (param action-callback SubscriberCallback)
    (= batch-root root)
    (lazy trackers initial-trackers)
    (= callback action-callback)
    (blank)
    (for (in tracker trackers)
      (call (. tracker attach) this)
    )
  )
  (fn-do + This _
    (param owner MarkupElement)
    (param initial-trackers (list Tracker))
    (param action-callback SubscriberCallback)
    (= batch-owner owner)
    (lazy trackers initial-trackers)
    (= callback action-callback)
    (blank)
    (for (in tracker trackers)
      (call (. tracker attach) this)
    )
  )
  (fn-do + schedule _
    (let owner batch-owner)
    (if owner
      (= batch-root (. owner markup-batch-root))
    )
    (blank)
    (if batch-root
      (call enqueue-markup-batch-action)
      (else
        (call schedule-live)
      )
    )
  )
  (fn-do + run-now _
    (call refresh-markup-batch-action)
  )
  (fn-do + close _
    (= state 3)
    (= queued-root null)
    (call (. super close))
  )
  (fn-do + enqueue-markup-batch-action _
    (return-if (if is-closed))
    (return-if (if (== state 3)))
    (= cause markup-cause-current)
    (blank)
    (if (== state 2)
      (probe-count markup.action.reenqueues)
      (= state 1)
      (= queued-root batch-root)
      (probe-count markup.action.enqueues)
      (call (. (!! batch-root) markup-batch-queue enqueue) this)
      (return)
    )
    (if (== state 1)
      (if (call markup-batch-roots-match queued-root batch-root)
        (probe-count markup.action.dedupes)
        (return)
      )
      (let old-root queued-root)
      (if old-root
        (-= (. old-root markup-batch-queue actions) this)
      )
    )
    (blank)
    (= state 1)
    (= queued-root batch-root)
    (probe-count markup.action.enqueues)
    (call (. (!! batch-root) markup-batch-queue enqueue) this)
  )
  (fn-do + refresh-markup-batch-action _
    (= cause markup-cause-current)
    (= state 1)
    (call run-markup-batch-action null)
  )
  (fn-do _ run-markup-batch-action _
    (param queued-for (? MarkupRootElement))
    (if queued-for
      (return-if (if (not (call markup-batch-roots-match queued-root queued-for))))
      (probe-count markup.action.batch-runs)
      (else
        (probe-count markup.action.immediate-runs)
      )
    )
    (blank)
    (return (call run-markup-batch-action-now (!= queued-for null)))
  )
  (fn-do _ run-markup-batch-action-now _
    (param gated Bool)
    (return-if (if is-closed))
    (return-if (if (== state 3)))
    (blank)
    (return-if (if (!= state 1)))
    (blank)
    (let outer (call swap-markup-cause cause))
    (finally
      (call swap-markup-cause outer)
      (if (== state 2)
        (= state 0)
        (= queued-root null)
      )
    )
    (blank)
    (let runs (and accepts-run (not (call markup-hold-action this)) (or (not gated) (call should-run))))
    (call reset-notice)
    (if (not runs)
      (= state 0)
      (= queued-root null)
    )
    (return-if (if (not runs)))
    (blank)
    (= state 2)
    (call refresh-trackers)
    (blank)
    (if (== state 2)
      (= state 0)
      (= queued-root null)
    )
    (blank)
    (return true)
  )
)

(type + (of MarkupRowItem Item) (is MarkupRow)
  (prop + item Item)
  (fn-do + This _
    (param item _)
  )
)

(type + MarkupRebindableScope (is Interface)
  (fn-expr + generation U64 :get)
)

(type + (of MarkupCollectionRowBuilder Item Content) (is (fn-type Content (?! Error) (param row-item (of MarkupRowItem Item)))))

(type + (of MarkupRegionRowBuilder Item Content) (is (fn-type Void (?! Error) (param item Item) (param region Content))))

(type + (of MarkupRowFilter Item) (is (fn-type Bool (param item Item))))

(type + (of MarkupKeyBuilder Item) (is (fn-type String (param item Item))))

(type + (of MarkupCollectionController Item Content)
  (implements (of MarkupCollectionItems Content))
  (implements MarkupRegionController)
  (constraint is Content (of MarkupParent Content))
  (prop _ indexable-source (? (of Indexable Item)))
  (prop _ row-builder (? (of MarkupCollectionRowBuilder Item Content)))
  (prop _ unkeyed-row-builder (? (of MarkupRowBuilder Item Content)))
  (prop _ key-builder (? (of MarkupKeyBuilder Item)))
  (prop _ reconciler (? (of MarkupCollectionReconciler Content)))
  (fn-do + This _
    (param region Content)
    (param source (of Collection Item))
    (param builder (of MarkupRowBuilder Item Content))
    (= unkeyed-row-builder builder)
    (= indexable-source (as source (of Indexable Item)))
    (= reconciler (call (of MarkupCollectionReconciler Content) region this false))
    (call (. (!! reconciler) observe-source) (as source Pointer))
  )
  (fn-do + This _
    (param region Content)
    (param source (of Collection Item))
    (param builder (of MarkupCollectionRowBuilder Item Content))
    (param key-builder (of MarkupKeyBuilder Item))
    (= row-builder builder)
    (= indexable-source (as source (of Indexable Item)))
    (= reconciler (call (of MarkupCollectionReconciler Content) region this true))
    (call (. (!! reconciler) observe-source) (as source Pointer))
  )
  (fn-expr + item-count Size :get
    (. (!! indexable-source) length)
  )
  (fn-expr + item-key String
    (param index Index)
    (call (!! key-builder) ([] (!! indexable-source) index))
  )
  (fn-expr + item-row MarkupRow
    (param index Index)
    (call (of MarkupRowItem Item) ([] (!! indexable-source) index))
  )
  (fn-do + rebind-row _
    (param row MarkupRow)
    (param index Index)
    (let row-item (as row (of MarkupRowItem Item)))
    (= (. row-item item) ([] (!! indexable-source) index))
  )
  (fn-do + build-row Content
    (param row MarkupRow)
    (call live-enter-untracked)
    (finally
      (inline (call live-leave))
    )
    (return (call (!! row-builder) (as row (of MarkupRowItem Item))))
  )
  (fn-do + build-item Content
    (param index Index)
    (call live-enter-untracked)
    (finally
      (inline (call live-leave))
    )
    (return (call (!! unkeyed-row-builder) ([] (!! indexable-source) index)))
  )
  (fn-do + close _
    (call (. (!! reconciler) close))
  )
  (fn-do + replace-source _
    (param new-source (of Collection Item))
    (= indexable-source (as new-source (of Indexable Item)))
    (call (. (!! reconciler) replace-source) (as new-source Pointer))
  )
)

(type + (of MarkupBranchController Content)
  (implements MarkupRegionController)
  (constraint is Content (of MarkupParent Content))
  (prop + region Content)
  (prop + arm-builders (list (of MarkupBranchBuilder Content)))
  (blank)
  (prop _ active-arm (? Index))
  (prop _ departed-arm (? Index))
  (prop _ departed (list Content) (= (call (of List Content))))
  (fn-do + This _
    (param region _)
    (param arm-builders _)
    (param active-arm (? Index))
    (call select-markup-branch active-arm)
  )
  (fn-expr + selected-arm _ :get
    active-arm
  )
  (fn-do + select-markup-branch _
    (param arm (? Index))
    (call live-enter-untracked)
    (finally
      (inline (call live-leave))
    )
    (if (!= arm active-arm)
      (call (. region markup-branch-changing))
    )
    (let leaving (call (of List Content)))
    (for (in child (call markup-region-children region))
      (+= leaving child)
    )
    (let revived (and (!= arm null) (== departed-arm arm) (call revive-departed)))
    (let departing (call (of List Content)))
    (let is-whole true)
    (for (in child leaving)
      (if (call markup-depart-child region child)
        (+= departing child)
        (else
          (= is-whole false)
        )
      )
    )
    (= departed (if-expr is-whole departing (call (of List Content))))
    (= departed-arm (only-if active-arm (if departed)))
    (= active-arm arm)
    (if (and arm (not revived))
      (let index arm)
      (call ([] arm-builders index) region)
    )
  )
  (fn-do _ revive-departed Bool
    (return-if (if (not departed)))
    (for (in child departed)
      (return-if (if (not (call markup-is-departing child))))
    )
    (let revived true)
    (for (in child departed)
      (if (not (call markup-revive-child child))
        (= revived false)
      )
    )
    (return revived)
  )
)

(type + MarkupElement (is Interface)
  (fn-expr + markup-batch-root _ :get
    (call markup-root-of this)
  )
  (fn-expr + markup-first-child (? MarkupElement) :get
    (call markup-structural-first-child-host this)
  )
  (fn-expr + markup-next-sibling (? MarkupElement) :get
    (call markup-structural-next-sibling-host this)
  )
  (fn-expr + markup-is-transparent-region _ :get
    false
  )
  (fn-expr + markup-query-boundary _ :get
    false
  )
  (fn-expr + markup-attachment-cache (? MarkupAttachment) :get
    (call markup-attachment this)
  )
  (fn-expr + theme-tag (? ThemeTag) :get
    null
  )
  (fn-do + markup-attachment-cache _ :set (param attachment (? MarkupAttachment)))
  (fn-do + theme-tag _ :set (param binding ThemeTag)
    (call set-theme-tag (. binding name) (. binding active))
  )
  (fn-do + markup-parent-style-domains-changed _
    (param mask U32)
  )
  (fn-do + markup-style-domains-changed _
    (param mask U32)
  )
  (fn-do + mounted _)
  (fn-do + unmounted _)
  (fn-do + markup-depart Bool
    (return false)
  )
  (fn-do + markup-revive _)
  (fn-do + markup-branch-changing _)
  (fn-expr + close _)
  (fn-do + markup-attach-shadow-child _
    (param child MarkupElement)
    (param anchor (? MarkupElement))
  )
  (fn-do + markup-detach-shadow-child _
    (param child MarkupElement)
  )
  (fn-do + (of use-theme Theme) _
    (param theme (of TypeInfo Theme))
    (let hook markup-theme-hook)
    (if hook
      (call hook this (. theme key))
    )
  )
  (fn-do + set-theme-tag _
    (param tag String)
    (param active (? Bool))
    (let hook markup-theme-tag-hook)
    (if hook
      (call hook this tag active)
    )
  )
)

(type + (of MarkupParent Child) (is Interface)
  (implements MarkupElement)
  (fn-do + children _ :get
    (let next %first-child)
    (while next
      (let child next)
      (= next (. child %next-sibling))
      (if (call markup-region-controller child)
        (yield-all (call (of markup-region-rows Child) child))
        (else
          (yield child)
        )
      )
    )
  )
  (fn-expr + markup-content _
    (param child Child)
    child
  )
  (fn-expr + markup-make-region (? Child)
    null
  )
  (fn-do + markup-attach-child _
    (param child Child)
    (param anchor (? Child))
  )
  (fn-do + markup-detach-child _
    (param child Child)
  )
)

(type + MarkupNode
  (implements (of MarkupParent MarkupNode))
  (prop + markup-attachment-cache (? MarkupAttachment))
  (fn-expr + markup-make-region (? MarkupNode)
    (call MarkupNodeRegion)
  )
  (fn-do + (of children-of Kind) _
    (constraint is Kind MarkupNode)
    (for (in child children)
      (if (is child Kind)
        (yield (as child Kind))
      )
    )
  )
  (fn-do + close _
    (let child %first-child)
    (while child
      (let current child)
      (call (. current close))
      (= child (. current %next-sibling))
    )
  )
)

(type + MarkupRoot (is MarkupNode)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + settle _
    (call (. markup-batch-queue checkpoint))
  )
  (fn-do + mounted _
    (call settle)
  )
)

(type + MarkupAttachment
  ; Linked nodes retain their owner through retained-host so the attachment tree is the structural
  ; ownership tree. A publicly adopted parentless non-root leaf instead uses the same attachment as
  ; a cleanup payload: retained-host is cleared, and the scalar object/witness pair reconstructs the
  ; interface only while client code still holds the owner. Adding its first structural child moves
  ; it back to ordinary ownership. Generated regions mount parentless only transiently and remain
  ; ordinary payloads until their builder links them.
  (blank)
  (prop + object-address Size (= 0))
  (prop + host-witness-address Size (= 0))
  (prop + retained-host (? MarkupElement))
  (prop + is-cleanup-payload _ (= false))
  (prop + store-address Size (= 0))
  (prop + store-witness-address Size (= 0))
  (prop + retained-store (? MarkupRootElement))
  (prop + mounted-parent (? MarkupAttachment))
  (prop + mounted-callback-fired _ (= false))
  (prop + is-released _ (= false))
  (prop + is-closed _ (= false))
  (prop + structural-parent (? MarkupAttachment))
  (prop + first-child (? MarkupAttachment))
  (prop + last-child (? MarkupAttachment))
  (prop + previous-sibling (? MarkupAttachment))
  (prop + next-sibling (? MarkupAttachment))
  (prop + is-style-shadow _ (= false))
  (prop + attachment-id Index (= 0))
  (prop + style-store-address Size (= 0))
  (prop + style-node-record-address Size (= 0))
  (prop + dirty-bits U32)
  (prop + pending-domains U32)
  (prop + descendant-domains U32)
  (prop + generation U32)
  (prop + style-settled _ (= false))
  (prop + style-reports-settle _ (= false))
  (prop + cause _ (= markup-cause-none))
  (prop + object-pointer _ (=> (as object-address Pointer)))
  (prop + is-live _ (=> (!= style-store-address 0)))
  (prop + owner-address _ (=> object-address))
  (blank)
  (prop _ overflow (? MarkupAttachmentOverflow))
  (fn-expr + host _ :get
    (case? retained-host
      retained-host
    )
    (default
      (call (of gc-interface-from-pointer MarkupElement) object-pointer (as host-witness-address Pointer))
    )
  )
  (fn-do + store (? MarkupRootElement) :get
    (if retained-store
      (return retained-store)
    )
    (return-if (if (== store-address 0)))
    (return
      (call (of gc-interface-from-pointer MarkupRootElement)
        (block
          (arg (as store-address Pointer))
          (arg (as store-witness-address Pointer))
        )
      )
    )
  )
  (fn-expr + theme-tags-on U64 :get
    (?? (?. overflow theme-tags-on) 0)
  )
  (fn-expr + theme-tags-off U64 :get
    (?? (?. overflow theme-tags-off) 0)
  )
  (fn-expr _ departure (? MarkupDeparture) :get
    (?. overflow departure)
  )
  (fn-expr _ departing-within Size :get
    (?? (?. overflow departing-within) 0)
  )
  (fn-expr _ region-controller (? MarkupRegionController) :get
    (?. overflow region-controller)
  )
  (fn-do _ region-controller _ :set (param controller (? MarkupRegionController))
    (return-if (if (and (not overflow) (not controller))))
    (= (. (call overflow-for-write) region-controller) controller)
  )
  (fn-do + set-theme-tags _
    (param on U64)
    (param off U64)
    (return-if (if (and (not overflow) (== on 0) (== off 0))))
    (let held (call overflow-for-write))
    (= (. held theme-tags-on) on)
    (= (. held theme-tags-off) off)
  )
  (fn-do _ set-store _
    (param store MarkupRootElement)
    (if is-cleanup-payload
      (= retained-store null)
      (else
        (= retained-store store)
      )
    )
    (= store-address (as (. (as store Pointer) address) Size))
    (= store-witness-address (as (. (call interface-witness-pointer store) address) Size))
  )
  (fn-do _ clear-store _
    (= retained-store null)
    (= store-address 0)
    (= store-witness-address 0)
  )
  (fn-do _ overflow-for-write _
    (if (not overflow)
      (= overflow (call MarkupAttachmentOverflow))
    )
    (return (!! overflow))
  )
)

(fn-expr + current-markup-cause MarkupCause
  markup-cause-current
)

(fn-do + swap-markup-cause MarkupCause
  (param cause MarkupCause)
  (let previous markup-cause-current)
  (= markup-cause-current cause)
  (return previous)
)

(fn-do + set-markup-batch-settle-hook _
  (param hook MarkupBatchSettleHook)
  (+= markup-batch-settle-hooks hook)
)

(fn-do + set-markup-mount-hook _
  (param hook MarkupMountHook)
  (+= markup-mount-hooks hook)
)

(fn-do + set-markup-attachment-reclaim-hook _
  (param hook MarkupAttachmentReclaimHook)
  (+= markup-attachment-reclaim-hooks hook)
)

(fn-do + set-markup-theme-hooks _
  (param tag-hook MarkupThemeTagHook)
  (param theme-hook MarkupThemeHook)
  (= markup-theme-tag-hook tag-hook)
  (= markup-theme-hook theme-hook)
)

(fn-do + markup-structural-parent-host _
  (param node MarkupElement)
  (let attachment (call markup-attachment node))
  (return-if (?. (. attachment structural-parent) host) (if attachment))
)

(fn-do + markup-structural-first-child-host _
  (param node MarkupElement)
  (let attachment (call markup-attachment node))
  (return-if (?. (. attachment first-child) host) (if attachment))
)

(fn-do + markup-structural-next-sibling-host _
  (param node MarkupElement)
  (let attachment (call markup-attachment node))
  (return-if (?. (. attachment next-sibling) host) (if attachment))
)

(fn-expr + markup-is-style-shadow _
  (param node MarkupElement)
  (case? attachment
    (. attachment is-style-shadow)
  )
  (default
    false
  )
  (where
    (lazy attachment (call markup-attachment node))
  )
)

(fn-do + markup-style-parent-host _
  (param node MarkupElement)
  (let attachment (call markup-attachment node))
  (if (and attachment (. attachment overflow))
    (let overflow (. attachment overflow))
    (return (. overflow style-parent))
  )
)

(fn-do + markup-style-slot _
  (param node MarkupElement)
  (let attachment (call markup-attachment node))
  (if (and attachment (. attachment overflow))
    (let overflow (. attachment overflow))
    (return (. overflow style-slot))
  )
)

(fn-expr + markup-query-first-descendant-host _
  (param owner MarkupElement)
  (call markup-structural-first-child-host owner)
)

(fn-do + markup-query-next-descendant-host _
  (param owner MarkupElement)
  (param current MarkupElement)
  (return? (call markup-structural-first-child-host current))
  (blank)
  (let cursor (? MarkupElement) current)
  (while cursor
    (let live cursor)
    (return-if (if (== (as live Pointer) (as owner Pointer))))
    (blank)
    (let next (call markup-structural-next-sibling-host live))
    (if next
      (return next)
    )
    (blank)
    (= cursor (call markup-structural-parent-host live))
  )
)

(fn-do + markup-root-of _
  (param node MarkupElement)
  (let attachment (call markup-attachment node))
  (if attachment
    (let live attachment)
    (let store (. live store))
    (if store
      (return store)
    )
  )
)

(fn-do + markup-adopt _
  (param node MarkupElement)
  (param parent (? MarkupElement))
  (param root (? MarkupRootElement))
  ; For out-of-tree hosts; linked children use the core mutation entry points.
  (blank)
  (let commit (call MarkupMountCommit))
  (call markup-query-publish-subtree node false)
  (call markup-adopt-core node commit true parent root)
  (if root
    (call markup-query-publish-subtree node true)
  )
  (call (. commit publish-mounted))
)

(fn-do + markup-release _
  (param node MarkupElement)
  (let commit (call MarkupMountCommit))
  (call markup-query-publish-subtree node false)
  (call markup-adopt-core node commit true null null)
)

(fn-do + markup-mount-root _
  (param node MarkupElement)
  (param root (? MarkupRootElement))
  (let commit (call MarkupMountCommit))
  (call markup-adopt-core node commit true null root)
  (if root
    (call markup-query-publish-subtree node true)
  )
  (call (. commit publish-mounted))
)

(fn-do + (of markup-append Host Child) _
  (param parent Host)
  (param child Child)
  (constraint is Host MarkupParent)
  (constraint is Child MarkupElement)
  (let commit (call markup-attach-new-child parent child null))
  (call (. commit publish-mounted))
)

(fn-do + (of markup-insert Host Child Anchor) _
  (param parent Host)
  (param child Child)
  (param anchor (? Anchor))
  (constraint is Host MarkupParent)
  (constraint is Child MarkupElement)
  (constraint is Anchor MarkupElement)
  (let commit (call markup-attach-new-child parent child anchor))
  (call (. commit publish-mounted))
)

(fn-do + (of markup-remove Host Child) _
  (param parent Host)
  (param child Child)
  (constraint is Host MarkupParent)
  (constraint is Child MarkupElement)
  (let weight (call markup-departure-weight child))
  (call markup-unlink-structural-child parent child)
  (call (. parent markup-detach-child) child)
  (call markup-release child)
  (if weight
    (call markup-settle-departures (call markup-attachment (as parent MarkupElement)))
  )
)

(fn-do + markup-insert-shadow _
  (param parent MarkupElement)
  (param child MarkupElement)
  (param style-parent MarkupElement)
  (param slot U32)
  (param anchor (? MarkupElement))
  (let root (call markup-root-of parent))
  (let commit (call MarkupMountCommit))
  (let linked false)
  (let committed false)
  (blank)
  (call markup-assert-structural-child-linkable parent child anchor)
  (finally
    (if (not committed)
      (catch (call markup-release child))
      (if linked
        (call markup-unlink-structural-child parent child)
      )
      (call markup-clear-style-shadow child)
    )
  )
  (blank)
  (call markup-mark-style-shadow child style-parent slot)
  (call markup-link-structural-child parent child anchor)
  (= linked true)
  (call (. parent markup-attach-shadow-child) child anchor)
  (call markup-adopt-core child commit true parent root)
  (= committed true)
  (call (. commit publish-mounted))
)

(fn-do + markup-remove-shadow _
  (param child MarkupElement)
  (let attachment (call markup-attachment child))
  (return-if (if (not attachment)))
  (return-if (if (not (. attachment is-style-shadow))))
  (blank)
  (let weight (call markup-departure-weight child))
  (let parent-attachment (. attachment structural-parent))
  (if parent-attachment
    (let parent (. parent-attachment host))
    (call (. parent markup-detach-shadow-child) child)
    (call markup-unlink-structural-child parent child)
  )
  (blank)
  (call markup-release child)
  (call markup-clear-style-shadow child)
  (if weight
    (call markup-settle-departures parent-attachment)
  )
)

(fn-do + (of markup-replace Host Child Replacement) _
  (param parent Host)
  (param child Child)
  (param replacement Replacement)
  (constraint is Host MarkupParent)
  (constraint is Child MarkupElement)
  (constraint is Replacement MarkupElement)
  (let parent-host (as parent MarkupElement))
  (let commit (call markup-attach-new-child parent replacement child))
  (call markup-unlink-structural-child parent-host child)
  (call (. parent markup-detach-child) child)
  (call markup-release child)
  (call (. commit publish-mounted))
)

(fn-do + ensure-markup-batch-action _
  (param root MarkupRootElement)
  (param callback SubscriberCallback)
  (param action (? MarkupBatchAction))
  (if action
    (let live action)
    (let action-root (. live batch-root))
    (if action-root
      (let action-queue (as (. action-root markup-batch-queue) Pointer))
      (let root-queue (as (. root markup-batch-queue) Pointer))
      (if (== action-queue root-queue)
        (return live)
      )
    )
    (call (. live close))
  )
  (blank)
  (return (call MarkupBatchAction root (call (of List Tracker)) callback))
)

(fn-do + (of markup-select-branch-region Content) _
  (param region Content)
  (param active-arm (? Index))
  (constraint is Content (of MarkupParent Content))
  (call (. (as (!! (call markup-region-controller region)) (of MarkupBranchController Content)) select-markup-branch)
    (block
      (arg active-arm)
    )
  )
)

(fn-expr + markup-attachment _
  (param object-pointer (of CPointer Void))
  (call (of gc-object-side-payload MarkupAttachment) object-pointer (as (call markup-attachment-lane) Size))
)

(fn-do + markup-attachment-for-write MarkupAttachment
  (param object MarkupElement)
  (return (call markup-ensure-attachment object))
)

(fn-do + (of markup-close-region Node) _
  (param node Node)
  (constraint is Node MarkupElement)
  (let attachment (. node markup-attachment-cache))
  (let controller (?. attachment region-controller))
  (if controller
    (= (. (!! attachment) region-controller) null)
    (call (. controller close))
  )
)

(fn-do + markup-departed _
  (param host MarkupElement)
  (let attachment (call markup-attachment host))
  (return-if (if (not attachment)))
  (let departure (. attachment departure))
  (return-if (if (not departure)))
  (= (. departure is-host-leaving) false)
  (return-if (if (. attachment departing-within)))
  (call markup-end-departure attachment)
)

(fn-do + markup-holds-departures Bool
  (param host MarkupElement)
  (let attachment (call markup-attachment host))
  (return-if (if (not attachment)))
  (return (> (. attachment departing-within) 0))
)

(fn-do + markup-is-departing Bool
  (param host MarkupElement)
  (let attachment (call markup-attachment host))
  (return-if (if (not attachment)))
  (return (!= (. attachment departure) null))
)

(type _ MarkupAncestorQueryRefresher (is (fn-type Bool)))

(type _ (of MarkupIdBinder Host) (is (fn-type Void (param host Host))))

(type _ MarkupDescendantsQueryApplier (is (fn-type Bool (param candidate MarkupElement))))

(type _ MarkupBatchSettleHook (is (fn-type MarkupBatchSettleResult (param root MarkupRootElement))))

(type _ MarkupMountHook (is (fn-type Bool (param node MarkupElement) (param parent (? MarkupElement)) (param root (? MarkupRootElement))))
  ; True continues the adopt walk into children.
)

(type _ MarkupAttachmentReclaimHook (is (fn-type Void (param attachment MarkupAttachment))))

(type _ MarkupThemeTagHook (is (fn-type Void (param node MarkupElement) (param tag String) (param active (? Bool)))))

(type _ MarkupThemeHook (is (fn-type Void (param node MarkupElement) (param key String))))

(type _ MarkupRegionController (is Interface)
  (fn-do + close _)
)

(type _ MarkupPropertyDependencyAction (is MarkupBatchAction)
  (fn-do + This _
    (param owner MarkupElement)
    (param initial-trackers (list Tracker))
    (param action-callback SubscriberCallback)
    (= batch-owner owner)
    (lazy trackers initial-trackers)
    (= callback action-callback)
    (blank)
    (for (in tracker trackers)
      (call (. tracker attach) this)
    )
  )
  (fn-do + schedule _
    (let owner batch-owner)
    (if owner
      (= batch-root (. owner markup-batch-root))
    )
    (blank)
    (if batch-root
      (if (. batch-root markup-batch-queue is-active)
        (call enqueue-markup-batch-action)
        (return)
      )
    )
    (call schedule-live)
  )
)

(type _ (of MarkupRowBuilder Item Content) (is (fn-type Content (?! Error) (param item Item))))

(type _ MarkupRow)

(type _ (of MarkupBranchBuilder Content) (is (fn-type Void (?! Error) (param parent Content))))

(type _ (of MarkupItemAppender Item) (is (fn-type Void (?! Error) (param item Item))))

(type _ (of MarkupPendingItems Item)
  (prop + appender (of MarkupItemAppender Item))
  (blank)
  (prop _ items (list Item) (= (call (of List Item))))
  (prop _ action (? MarkupBatchAction))
  (fn-do + This _
    (param appender _)
  )
  (fn-do + queue _
    (param item Item)
    (param root MarkupRootElement)
    (+= items item)
    (let next-action (call ensure-markup-batch-action root (. this flush-action) action))
    (= action next-action)
    (call next-action)
  )
  (fn-do + flush-action (list Tracker)
    (call flush)
    (return (call (of List Tracker)))
  )
  (fn-do + flush _
    (let pending items)
    (= items (call (of List Item)))
    (for (in item pending)
      (call appender item)
    )
  )
  (fn-do + clear _
    (call (. items clear))
    (if action
      (call (. action close))
      (= action null)
    )
  )
)

(type _ (of MarkupCollectionItems Content) (is Interface)
  (fn-expr + item-count Size :get)
  (fn-do + item-key String
    (param index Index)
  )
  (fn-do + item-row MarkupRow
    (param index Index)
  )
  (fn-do + rebind-row _
    (param row MarkupRow)
    (param index Index)
  )
  (fn-do + build-row Content (?! Error)
    (param row MarkupRow)
  )
  (fn-do + build-item Content (?! Error)
    (param index Index)
  )
)

(type _ (of MarkupDepartedRow Content)
  (constraint is Content MarkupElement)
  (prop + key String)
  (prop + row MarkupRow)
  (prop + child Content)
  (fn-do + This _
    (param key _)
    (param row _)
    (param child _)
  )
)

(type _ (of MarkupCollectionReconciler Content)
  (constraint is Content (of MarkupParent Content))
  (prop + region Content)
  (prop + items (of MarkupCollectionItems Content))
  (prop + is-keyed Bool)
  (blank)
  (prop _ source-pointer Pointer (= (call Pointer)))
  (prop _ keys (list String) (= (call (of List String))))
  (prop _ rows (list MarkupRow) (= (call (of List MarkupRow))))
  (prop _ unkeyed-row-hosts (list Content) (= (call (of List Content))))
  (prop _ observer (? CollectionObserver))
  (prop _ pending-mutations (list CollectionMutation) (= (call (of List CollectionMutation))))
  (prop _ mutation-action (? MarkupBatchAction))
  (prop _ departed (list (of MarkupDepartedRow Content)) (= (call (of List (of MarkupDepartedRow Content)))))
  (fn-do + This _
    (param region _)
    (param items _)
    (param is-keyed _)
  )
  (fn-do + observe-source _
    (param source Pointer)
    (= source-pointer source)
    (let new-observer (as (. this notify) CollectionObserver))
    (= observer new-observer)
    (call observe-collection-pointer source-pointer new-observer)
    (call rebuild)
  )
  (fn-do + replace-source _
    (param source Pointer)
    (if observer
      (call unobserve-collection-pointer source-pointer observer)
    )
    (call clear-pending-mutations)
    (call observe-source source)
  )
  (fn-do + rebuild _
    (if is-keyed
      (call rebuild-keyed)
      (return)
    )
    (call markup-region-clear-children region)
    (call (. keys clear))
    (call (. rows clear))
    (call (. unkeyed-row-hosts clear))
    (for (in item-index (..< 0 (. items item-count)))
      (let child (call (. items build-item) item-index))
      (+= unkeyed-row-hosts child)
      (call markup-append region child)
    )
  )
  (fn-do + rebuild-keyed _
    (return-if (if (not is-keyed)))
    (blank)
    (let count (. items item-count))
    (let old-keys keys)
    (let old-rows rows)
    (let old-children (call (of List Content)))
    (for (in child (call markup-region-children region))
      (+= old-children child)
    )
    (let old-count Index (. old-children length))
    (blank)
    (if (not old-count)
      (call mount-all count)
      (return)
    )
    (if (> markup-keyed-linear-scan-limit old-count)
      (let has-reuse false)
      (for (in item-index (..< 0 count))
        (probe-count keyed.collection.key-builds)
        (let key (call (. items item-key) item-index))
        (for (in old-key old-keys)
          (probe-count keyed.collection.equality-comparisons)
          (if (== old-key key)
            (= has-reuse true)
            (break)
          )
        )
        (if has-reuse
          (break)
        )
      )
      (blank)
      (if (not has-reuse)
        (call depart-rows old-children old-keys old-rows)
        (call mount-all count)
        (return)
      )
      (= keys (call (of List String)))
      (= rows (call (of List MarkupRow)))
      (let old-used (call (of List Bool)))
      (for (in old-child old-children)
        (+= old-used false)
      )
      (blank)
      (let next-children (call (of List Content)))
      (let next-reused (call (of List Bool)))
      (for (in item-index (..< 0 count))
        (probe-count keyed.collection.key-builds)
        (let key (call (. items item-key) item-index))
        (let found (? Index))
        (let candidate-index Index 0)
        (for (in old-key old-keys)
          (probe-count markup.collection.keyed-small-scans)
          (probe-count keyed.collection.equality-comparisons)
          (if (and (== old-key key) (not ([] old-used candidate-index)))
            (= found candidate-index)
            (break)
          )
          (+= candidate-index 1)
        )
        (if found
          (let found-index found)
          (let row ([] old-rows found-index))
          (call (. items rebind-row) row item-index)
          (+= rows row)
          (+= next-children ([] old-children found-index))
          (+= next-reused true)
          (= ([] old-used found-index) true)
          (else
            (call build-or-reclaim key item-index next-children next-reused)
          )
        )
        (+= keys key)
      )
      (blank)
      (let index Index 0)
      (for (in old-child old-children)
        (if (not ([] old-used index))
          (call depart-row old-child ([] old-keys index) ([] old-rows index))
        )
        (+= index 1)
      )
      (call place next-children next-reused)
      (return)
    )
    (let no-index old-count)
    (let old-next (call (of List Index)))
    (for (in old-child old-children)
      (+= old-next no-index)
    )
    (blank)
    (let old-heads (call (of Map String MarkupKeyedRowHead)))
    (let old-index old-count)
    (while (> old-index 0)
      (-= old-index 1)
      (let key ([] old-keys old-index))
      (probe-count keyed.collection.map-probes)
      (let old-head ([] old-heads key))
      (if old-head
        (= ([] old-next old-index) (. old-head index))
        (= (. old-head index) old-index)
        (else
          (= ([] old-next old-index) no-index)
          (= ([] old-heads key) (call MarkupKeyedRowHead old-index))
        )
      )
    )
    (blank)
    (let has-reuse false)
    (for (in item-index (..< 0 count))
      (probe-count keyed.collection.key-builds)
      (let key (call (. items item-key) item-index))
      (probe-count keyed.collection.map-probes)
      (let old-head ([] old-heads key))
      (if (and old-head (< (. old-head index) no-index))
        (= has-reuse true)
        (break)
      )
    )
    (blank)
    (if (not has-reuse)
      (call depart-rows old-children old-keys old-rows)
      (call mount-all count)
      (return)
    )
    (= keys (call (of List String)))
    (= rows (call (of List MarkupRow)))
    (let next-children (call (of List Content)))
    (let next-reused (call (of List Bool)))
    (for (in item-index (..< 0 count))
      (probe-count keyed.collection.key-builds)
      (let key (call (. items item-key) item-index))
      (probe-count keyed.collection.map-probes)
      (let old-head ([] old-heads key))
      (if (and old-head (< (. old-head index) no-index))
        (let reuse-index (. old-head index))
        (let row ([] old-rows reuse-index))
        (call (. items rebind-row) row item-index)
        (+= rows row)
        (+= next-children ([] old-children reuse-index))
        (+= next-reused true)
        (= (. old-head index) ([] old-next reuse-index))
        (else
          (call build-or-reclaim key item-index next-children next-reused)
        )
      )
      (+= keys key)
    )
    (blank)
    (for (in old-head (. old-heads values))
      (let unused-index (. old-head index))
      (while (< unused-index no-index)
        (call depart-row ([] old-children unused-index) ([] old-keys unused-index) ([] old-rows unused-index))
        (= unused-index ([] old-next unused-index))
      )
    )
    (call place next-children next-reused)
  )
  (fn-do + insert-range _
    (param index Index)
    (param count Size)
    (let offset Index 0)
    (while (< offset count)
      (let row-index (+ index offset))
      (if is-keyed
        (let key (call (. items item-key) row-index))
        (call (. rows insert)
          (block
            (arg (call mount-keyed-row key row-index (call markup-region-child-at region row-index)))
            (arg row-index)
          )
        )
        (call (. keys insert) key row-index)
        (else
          (let anchor (? Content))
          (if (< row-index (. unkeyed-row-hosts length))
            (= anchor ([] unkeyed-row-hosts row-index))
          )
          (let child (call (. items build-item) row-index))
          (call (. unkeyed-row-hosts insert) child row-index)
          (call markup-insert region child anchor)
        )
      )
      (+= offset 1)
    )
  )
  (fn-do + append-range _
    (param index Index)
    (param count Size)
    (let offset Index 0)
    (while (< offset count)
      (let row-index (+ index offset))
      (if is-keyed
        (let key (call (. items item-key) row-index))
        (+= rows (call mount-keyed-row key row-index null))
        (+= keys key)
        (else
          (let child (call (. items build-item) row-index))
          (+= unkeyed-row-hosts child)
          (call markup-append region child)
        )
      )
      (+= offset 1)
    )
  )
  (fn-do + remove-range _
    (param index Index)
    (param count Size)
    (let removed Size 0)
    (while (< removed count)
      (if is-keyed
        (let child (call markup-region-child-at region index))
        (return-if (if (not child)))
        (let key ([] keys index))
        (let row ([] rows index))
        (call (. rows remove) index 1)
        (call (. keys remove) index 1)
        (call depart-row child key row)
        (else
          (let child ([] unkeyed-row-hosts index))
          (call (. unkeyed-row-hosts remove) index 1)
          (call markup-remove region child)
          (call markup-close-child child)
        )
      )
      (+= removed 1)
    )
  )
  (fn-do + remount-from _
    (param index Index)
    (while (> (. unkeyed-row-hosts length) index)
      (let child ([] unkeyed-row-hosts index))
      (call (. unkeyed-row-hosts remove) index 1)
      (call markup-remove region child)
      (call markup-close-child child)
      (probe-count markup.collection.remounted-children)
    )
    (blank)
    (let cursor index)
    (while (< cursor (. items item-count))
      (let child (call (. items build-item) cursor))
      (+= unkeyed-row-hosts child)
      (call markup-append region child)
      (probe-count markup.collection.remounted-children)
      (+= cursor 1)
    )
  )
  (fn-do + set-range _
    (param index Index)
    (param count Size)
    (return-if (if (not is-keyed)))
    (blank)
    (let offset Index 0)
    (while (< offset count)
      (let row-index (+ index offset))
      (let key (call (. items item-key) row-index))
      (if (== ([] keys row-index) key)
        (call (. items rebind-row) ([] rows row-index) row-index)
        (probe-count markup.collection.same-key-refreshes)
        (else
          (let child (call markup-region-child-at region row-index))
          (if child
            (call depart-row child ([] keys row-index) ([] rows row-index))
          )
          (= ([] rows row-index) (call mount-keyed-row key row-index (call markup-region-child-at region row-index)))
          (= ([] keys row-index) key)
          (probe-count markup.collection.remounted-children)
        )
      )
      (+= offset 1)
    )
  )
  (fn-do + replace-range-unkeyed _
    (param index Index)
    (param count Size)
    (let offset Index 0)
    (while (< offset count)
      (let child ([] unkeyed-row-hosts (+ index offset)))
      (call markup-remove region child)
      (call markup-close-child child)
      (+= offset 1)
    )
    (blank)
    (let anchor (? Content))
    (if (< (+ index count) (. unkeyed-row-hosts length))
      (= anchor ([] unkeyed-row-hosts (+ index count)))
    )
    (blank)
    (= offset 0)
    (while (< offset count)
      (let row-index (+ index offset))
      (let child (call (. items build-item) row-index))
      (= ([] unkeyed-row-hosts row-index) child)
      (call markup-insert region child anchor)
      (+= offset 1)
    )
  )
  (fn-do + notify _
    (param mutation CollectionMutation)
    (let root (. region markup-batch-root))
    (if root
      (call queue-mutation mutation root)
      (return)
    )
    (call apply-mutation mutation)
  )
  (fn-do + queue-mutation _
    (param mutation CollectionMutation)
    (param root MarkupRootElement)
    (probe-count markup.collection.queued)
    (if (== (. mutation kind) (. CollectionMutationKind set))
      (probe-count markup.collection.set.queued)
    )
    (call coalesce-mutation mutation)
    (let action (call ensure-markup-batch-action root (. this flush-pending-mutations-action) mutation-action))
    (= mutation-action action)
    (call action)
  )
  (fn-do + coalesce-mutation _
    (param mutation CollectionMutation)
    (if (or (== (. mutation kind) (. CollectionMutationKind reset)) (== (. mutation kind) (. CollectionMutationKind move)))
      (call (. pending-mutations clear))
      (+= pending-mutations mutation)
      (probe-count markup.collection.coalesced)
      (return)
    )
    (if (not pending-mutations)
      (+= pending-mutations mutation)
      (return)
    )
    (let tail (. pending-mutations tail))
    (blank)
    (if (== (. tail kind) (. CollectionMutationKind append))
      (if (== (. mutation kind) (. CollectionMutationKind append))
        (if (== (. mutation index) (+ (. tail index) (. tail count)))
          (+= (. tail count) (. mutation count))
          (probe-count markup.collection.coalesced)
          (return)
        )
      )
    )
    (if (== (. tail kind) (. CollectionMutationKind set))
      (if (== (. mutation kind) (. CollectionMutationKind set))
        (let tail-end (+ (. tail index) (. tail count)))
        (let mutation-end (+ (. mutation index) (. mutation count)))
        (if (and (<= (. mutation index) tail-end) (<= (. tail index) mutation-end))
          (if (< (. mutation index) (. tail index))
            (= (. tail index) (. mutation index))
          )
          (if (> mutation-end tail-end)
            (= tail-end mutation-end)
          )
          (= (. tail count) (- tail-end (. tail index)))
          (probe-count markup.collection.coalesced)
          (probe-count markup.collection.set.coalesced)
          (return)
        )
      )
    )
    (if (== (. tail kind) (. CollectionMutationKind replace))
      (if (== (. mutation kind) (. CollectionMutationKind replace))
        (if (== (. mutation index) (. tail index))
          (= (. tail count) (. mutation count))
          (probe-count markup.collection.coalesced)
          (return)
        )
      )
    )
    (if (or (== (. tail kind) (. CollectionMutationKind insert)) (== (. tail kind) (. CollectionMutationKind append)))
      (if (== (. mutation kind) (. CollectionMutationKind remove))
        (if (and (== (. mutation index) (. tail index)) (== (. mutation count) (. tail count)))
          (call (. pending-mutations pop))
          (probe-count markup.collection.coalesced)
          (return)
        )
      )
    )
    (if (== (. tail kind) (. CollectionMutationKind append))
      (if (== (. mutation kind) (. CollectionMutationKind remove))
        (if (>= (. mutation index) (. tail index))
          (let removed-offset (- (. mutation index) (. tail index)))
          (if (== (+ removed-offset (. mutation count)) (. tail count))
            (= (. tail count) removed-offset)
            (if (not (. tail count))
              (call (. pending-mutations pop))
            )
            (probe-count markup.collection.coalesced)
            (return)
          )
        )
        (return)
      )
    )
    (let insert-kind (. CollectionMutationKind insert))
    (let remove-kind (. CollectionMutationKind remove))
    (let set-kind (. CollectionMutationKind set))
    (let replace-kind (. CollectionMutationKind replace))
    (let tail-is-edit (or (== (. tail kind) insert-kind) (== (. tail kind) remove-kind)))
    (= tail-is-edit (or tail-is-edit (== (. tail kind) set-kind) (== (. tail kind) replace-kind)))
    (let mutation-is-edit (or (== (. mutation kind) insert-kind) (== (. mutation kind) remove-kind)))
    (= mutation-is-edit (or mutation-is-edit (== (. mutation kind) set-kind) (== (. mutation kind) replace-kind)))
    (let tail-is-shifting (or (== (. tail kind) insert-kind) (== (. tail kind) remove-kind)))
    (let mutation-is-shifting (or (== (. mutation kind) insert-kind) (== (. mutation kind) remove-kind)))
    (if (not is-keyed)
      (if (== (. tail kind) (. CollectionMutationKind reset))
        (if (or mutation-is-edit (== (. mutation kind) (. CollectionMutationKind append)))
          (if (< (. mutation index) (. tail index))
            (= (. tail index) (. mutation index))
          )
          (probe-count markup.collection.coalesced)
          (return)
        )
      )
    )
    (if (not is-keyed)
      (if tail-is-edit
        (if (or tail-is-shifting mutation-is-shifting)
          (if (< (. mutation index) (. tail index))
            (= (. tail index) (. mutation index))
          )
          (= (. tail kind) (. CollectionMutationKind reset))
          (= (. tail count) 0)
          (probe-count markup.collection.coalesced)
          (return)
        )
      )
    )
    (if (not is-keyed)
      (if (== (. tail kind) (. CollectionMutationKind append))
        (if mutation-is-shifting
          (if (< (. mutation index) (. tail index))
            (= (. tail index) (. mutation index))
          )
          (= (. tail kind) (. CollectionMutationKind reset))
          (= (. tail count) 0)
          (probe-count markup.collection.coalesced)
          (return)
        )
      )
    )
    (+= pending-mutations mutation)
  )
  (fn-do + flush-pending-mutations-action _
    (call flush-pending-mutations)
    (return (call (of List Tracker)))
  )
  (fn-do + flush-pending-mutations _
    (let mutations pending-mutations)
    (= pending-mutations (call (of List CollectionMutation)))
    (for (in mutation mutations)
      (call apply-mutation mutation)
    )
  )
  (fn-do + clear-pending-mutations _
    (call (. pending-mutations clear))
    (if mutation-action
      (call (. mutation-action close))
      (= mutation-action null)
    )
  )
  (fn-do + apply-mutation _
    (param mutation CollectionMutation)
    (probe-count markup.collection.applied)
    (if (== (. mutation kind) (. CollectionMutationKind set))
      (probe-count markup.collection.set.applied)
      (else-if (== (. mutation kind) (. CollectionMutationKind insert))
        (probe-count markup.collection.insert.applied)
      )
      (else-if (== (. mutation kind) (. CollectionMutationKind remove))
        (probe-count markup.collection.remove.applied)
      )
      (else-if (== (. mutation kind) (. CollectionMutationKind replace))
        (probe-count markup.collection.replace.applied)
      )
      (else-if (== (. mutation kind) (. CollectionMutationKind reset))
        (probe-count markup.collection.reset.applied)
      )
    )
    (if (== (. mutation kind) (. CollectionMutationKind append))
      (call append-range (. mutation index) (. mutation count))
      (return)
    )
    (if (not is-keyed)
      (if (== (. mutation kind) (. CollectionMutationKind insert))
        (probe-count markup.collection.insert.remounted-children (- (. items item-count) (. mutation index)))
        (call remount-from (. mutation index))
        (return)
      )
      (if (== (. mutation kind) (. CollectionMutationKind remove))
        (probe-count markup.collection.remove.remounted-children (- (. items item-count) (. mutation index)))
        (call remount-from (. mutation index))
        (return)
      )
      (if (== (. mutation kind) (. CollectionMutationKind set))
        (call replace-range-unkeyed (. mutation index) (. mutation count))
        (probe-count markup.collection.remounted-children (. mutation count))
        (probe-count markup.collection.set.remounted-children (. mutation count))
        (return)
      )
      (if (== (. mutation kind) (. CollectionMutationKind replace))
        (probe-count markup.collection.replace.remounted-children (- (. items item-count) (. mutation index)))
        (call remount-from (. mutation index))
        (return)
      )
      (if (== (. mutation kind) (. CollectionMutationKind reset))
        (probe-count markup.collection.reset.remounted-children (- (. items item-count) (. mutation index)))
        (call remount-from (. mutation index))
        (return)
      )
    )
    (if (== (. mutation kind) (. CollectionMutationKind insert))
      (call insert-range (. mutation index) (. mutation count))
      (else-if (== (. mutation kind) (. CollectionMutationKind remove))
        (call remove-range (. mutation index) (. mutation count))
      )
      (else-if (== (. mutation kind) (. CollectionMutationKind set))
        (call set-range (. mutation index) (. mutation count))
      )
      (else-if (== (. mutation kind) (. CollectionMutationKind replace))
        (call remove-range (. mutation index) (. mutation count))
        (call insert-range (. mutation index) (. mutation count))
      )
      (else
        (call rebuild)
      )
    )
  )
  (fn-do + close _
    (call clear-pending-mutations)
    (call (. departed clear))
    (if observer
      (call unobserve-collection-pointer source-pointer observer)
      (= observer null)
    )
  )
  (fn-do _ mount-all _
    (param count Size)
    (= keys (call (of List String)))
    (= rows (call (of List MarkupRow)))
    (for (in item-index (..< 0 count))
      (probe-count keyed.collection.key-builds)
      (let key (call (. items item-key) item-index))
      (+= rows (call mount-keyed-row key item-index null))
      (+= keys key)
    )
  )
  (fn-do _ mount-keyed-row MarkupRow
    (param key String)
    (param item-index Index)
    (param anchor (? Content))
    (let departed-row (call reclaim key item-index))
    (if departed-row
      (call markup-move region (. departed-row child) anchor)
      (return (. departed-row row))
    )
    (let row (call (. items item-row) item-index))
    (call markup-insert region (call (. items build-row) row) anchor)
    (probe-count keyed.collection.mounts)
    (return row)
  )
  (fn-do _ depart-row _
    (param child Content)
    (param key String)
    (param row MarkupRow)
    (let forget Doer
      (=> () :do
        (block
          (call forget-departed child)
        )
      )
    )
    (if (call markup-depart-child region child forget)
      (+= departed (call (of MarkupDepartedRow Content) key row child))
    )
    (probe-count keyed.collection.unmounts)
  )
  (fn-do _ forget-departed _
    (param child Content)
    (let index Index 0)
    (while (< index (. departed length))
      (if (== (as (. ([] departed index) child) Pointer) (as child Pointer))
        (call (. departed remove) index)
        (return)
      )
      (+= index 1)
    )
  )
  (fn-do _ depart-rows _
    (param children (list Content))
    (param row-keys (list String))
    (param row-list (list MarkupRow))
    (let index Index 0)
    (for (in child children)
      (call depart-row child ([] row-keys index) ([] row-list index))
      (+= index 1)
    )
  )
  (fn-do _ reclaim (? (of MarkupDepartedRow Content))
    (param key String)
    (param item-index Index)
    (let index Index 0)
    (while (< index (. departed length))
      (let entry ([] departed index))
      (if (or (== (. entry key) key) (not (call markup-is-departing (. entry child))))
        (call (. departed remove) index 1)
        (if (and (== (. entry key) key) (call markup-revive-child (. entry child)))
          (call (. items rebind-row) (. entry row) item-index)
          (return entry)
        )
        (else
          (+= index 1)
        )
      )
    )
  )
  (fn-do _ place _
    (param children (list Content))
    (param reused (list Bool))
    (let anchor (? Content))
    (let cursor (. children length))
    (while (> cursor 0)
      (-= cursor 1)
      (let child ([] children cursor))
      (if ([] reused cursor)
        (if (not (call markup-region-follows child anchor))
          (call markup-move region child anchor)
          (probe-count keyed.collection.moves)
        )
        (else
          (call markup-insert region child anchor)
        )
      )
      (= anchor child)
    )
  )
  (fn-do _ build-or-reclaim _
    (param key String)
    (param item-index Index)
    (param next-children (list Content))
    (param next-reused (list Bool))
    (let departed-row (call reclaim key item-index))
    (if departed-row
      (+= rows (. departed-row row))
      (+= next-children (. departed-row child))
      (+= next-reused true)
      (return)
    )
    (let row (call (. items item-row) item-index))
    (+= rows row)
    (+= next-children (call (. items build-row) row))
    (+= next-reused false)
    (probe-count keyed.collection.mounts)
  )
)

(type _ (of MarkupBroadcastCollectionController Item Content)
  (implements MarkupRegionController)
  (constraint is Content (of MarkupParent Content))
  (prop + region Content)
  (prop + row-builder (of MarkupRowBuilder Item Content))
  (blank)
  (prop _ subscription (? (of Subscribable Item)))
  (prop _ unsubscribe-action (? Doer))
  (prop _ pending-items (of MarkupPendingItems Item))
  (fn-do + This _
    (param region _)
    (param source (of Broadcastable Item))
    (param row-builder _)
    (param key-builder (? (of MarkupKeyBuilder Item)))
    (= pending-items (call (of MarkupPendingItems Item) (. this append-item)))
    (call start-source source)
  )
  (fn-do + close _
    (call clear-pending-items)
    (call unsubscribe-source)
  )
  (fn-do + (of replace-source Source) _
    (param new-source Source)
    (constraint is Source (of Broadcastable Item))
    (call clear-pending-items)
    (call unsubscribe-source)
    (call markup-region-clear-children region)
    (call start-source (as new-source (of Broadcastable Item)))
  )
  (fn-do + start-source _
    (param new-source (of Broadcastable Item))
    (call unsubscribe-source)
    (let new-subscription (call (of Subscription Item) (. this handle-item)))
    (blank)
    (call (. new-source subscribe) new-subscription
      (block
        (on-error Error
          (throw (call Panic "Unable to subscribe markup loop source"))
        )
      )
    )
    (blank)
    (= subscription new-subscription)
    (= unsubscribe-action
      (=> () :do
        (block
          (call (. new-source unsubscribe) new-subscription
            (block
              (on-error Error
                (throw (call Panic "Unable to unsubscribe markup loop source"))
              )
            )
          )
        )
      )
    )
  )
  (fn-do + unsubscribe-source _
    (let action unsubscribe-action)
    (if action
      (call action
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
    )
    (= subscription null)
    (= unsubscribe-action null)
  )
  (fn-do + handle-item _
    (param item Item)
    (param broadcaster (of Broadcastable Item))
    (let root (. region markup-batch-root))
    (if root
      (call (. pending-items queue) item root)
      (return)
    )
    (call append-item item)
  )
  (fn-do + clear-pending-items _
    (call (. pending-items clear))
  )
  (fn-do + append-item _
    (param item Item)
    (call live-enter-untracked)
    (finally
      (inline (call live-leave))
    )
    (call markup-append region (call row-builder item))
  )
)

(type _ (of MarkupIterableCollectionController Item Content)
  (implements MarkupRegionController)
  (constraint is Content (of MarkupParent Content))
  (prop + region Content)
  (prop + row-builder (of MarkupRowBuilder Item Content))
  (blank)
  (prop _ generation Size (= 0))
  (prop _ producer-task (? Task))
  (prop _ close-source-actions (list Doer) (= (call (of List Doer))))
  (prop _ is-closed _ (= false))
  (prop _ pending-items (of MarkupPendingItems Item))
  (fn-do + This _
    (param region _)
    (param source (of Iterable Item))
    (param row-builder _)
    (param key-builder (? (of MarkupKeyBuilder Item)))
    (= pending-items (call (of MarkupPendingItems Item) (. this append-item)))
    (call start-source source)
  )
  (fn-do + close _
    (= is-closed true)
    (+= generation 1)
    (call cancel-producer)
    (call clear-pending-items)
  )
  (fn-do + replace-source _
    (param new-source _)
    (call cancel-producer)
    (call clear-pending-items)
    (call markup-region-clear-children region)
    (call start-source (as new-source (of Iterable Item)))
  )
  (fn-do + start-source _
    (param source (of Iterable Item))
    (+= generation 1)
    (let new-generation generation)
    (= producer-task
      (do-new
        (catch (call iterate-source source new-generation))
      )
    )
  )
  (fn-do + set-close-source _
    (param action Doer)
    (call (. close-source-actions clear))
    (+= close-source-actions action)
  )
  (fn-do + cancel-producer _
    (call clear-pending-items)
    (if close-source-actions
      (call ([] close-source-actions 0)
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
      (call (. close-source-actions clear))
    )
    (blank)
    (if producer-task
      (let task producer-task)
      (call (. task cancel))
      (call (. task resume-later))
      (= producer-task null)
    )
  )
  (fn-do + iterate-source _ (?! Error)
    (param source (of Iterable Item))
    (param source-generation Size)
    (return-if (if is-closed))
    (return-if (if (!= source-generation generation)))
    (blank)
    (for (in item source)
      (if (or is-closed (!= source-generation generation))
        (break)
      )
      (let root (. region markup-batch-root))
      (if root
        (call (. pending-items queue) item root)
        (else
          (call append-item item)
        )
      )
    )
    (blank)
    (if (== source-generation generation)
      (= producer-task null)
    )
  )
  (fn-do + clear-pending-items _
    (call (. pending-items clear))
  )
  (fn-do + append-item _
    (param item Item)
    (call live-enter-untracked)
    (finally
      (inline (call live-leave))
    )
    (call markup-append region (call row-builder item))
  )
)

(type _ MarkupNodeRegion (is MarkupNode)
  (fn-do + close _
    (call markup-close-region this)
    (call (. super close))
  )
  (fn-expr + markup-is-transparent-region _ :get
    true
  )
)

(type _ MarkupDescendantsQueryBinding
  (prop + owner MarkupElement)
  (prop + target-id Size)
  (prop + add MarkupDescendantsQueryApplier)
  (prop + remove MarkupDescendantsQueryApplier)
  (fn-do + This _
    (param owner _)
    (param target-id _)
    (param add _)
    (param remove _)
  )
)

(type _ MarkupAttachmentOverflow
  (prop _ style-parent (? MarkupElement))
  (prop _ style-slot (? U32))
  (prop _ ancestor-queries (? (list MarkupAncestorQueryRefresher)))
  (prop _ descendants-queries (? (list MarkupDescendantsQueryBinding)))
  (prop _ descendant-target-ids (? (list Size)))
  (prop _ departure (? MarkupDeparture))
  (prop _ departing-within Size (= 0))
  (prop _ held-actions (? (list MarkupBatchAction)))
  (prop _ region-controller (? MarkupRegionController))
  (prop _ theme-tags-on U64)
  (prop _ theme-tags-off U64)
)

(type _ MarkupMountCommit
  (prop _ mounted-hosts (list MarkupElement))
  (fn-do + record-mounted _
    (param host MarkupElement)
    (+= mounted-hosts host)
  )
  (fn-do + publish-mounted _
    (let hosts mounted-hosts)
    (= mounted-hosts (call (of List MarkupElement)))
    (blank)
    (for (in host hosts)
      (call (. host mounted))
    )
  )
)

(type _ MarkupKeyedRowHead
  (prop + index Index)
  (fn-do + This _
    (param index Index)
  )
)

(type _ MarkupDeparture
  (prop + finish Doer)
  (prop + is-host-leaving Bool)
  (fn-do + This _
    (param finish _)
    (param is-host-leaving _)
  )
)

(fn-do _ (of markup-region-rows Child) (list Child)
  (param region MarkupElement)
  (let next (call markup-structural-first-child-host region))
  (while next
    (let child next)
    (= next (call markup-structural-next-sibling-host child))
    (if (call markup-region-controller child)
      (yield-all (call (of markup-region-rows Child) child))
      (else
        (yield (as child Child))
      )
    )
  )
)

(fn-do _ markup-structural-last-child-host _
  (param node MarkupElement)
  (let attachment (call markup-attachment node))
  (return-if (?. (. attachment last-child) host) (if attachment))
)

(fn-do _ markup-structural-previous-sibling-host _
  (param node MarkupElement)
  (let attachment (call markup-attachment node))
  (return-if (?. (. attachment previous-sibling) host) (if attachment))
)

(fn-do _ markup-mark-style-shadow _
  (param node MarkupElement)
  (param style-parent MarkupElement)
  (param slot U32)
  (let attachment (call markup-ensure-attachment node))
  (= (. attachment is-style-shadow) true)
  (let overflow (call (. attachment overflow-for-write)))
  (= (. overflow style-parent) style-parent)
  (= (. overflow style-slot) slot)
)

(fn-do _ markup-clear-style-shadow _
  (param node MarkupElement)
  (let attachment (call markup-attachment node))
  (return-if (if (not attachment)))
  (blank)
  (= (. attachment is-style-shadow) false)
  (if (. attachment overflow)
    (let overflow (. attachment overflow))
    (= (. overflow style-parent) null)
    (= (. overflow style-slot) null)
  )
)

(fn-do _ register-markup-ancestor-query _
  (param owner MarkupElement)
  (param refresh MarkupAncestorQueryRefresher)
  (let attachment (call markup-ensure-attachment owner))
  (= markup-ancestor-query-active true)
  (let overflow (call (. attachment overflow-for-write)))
  (blank)
  (if (not (. overflow ancestor-queries))
    (= (. overflow ancestor-queries) (call (of List MarkupAncestorQueryRefresher)))
  )
  (+= (!! (. overflow ancestor-queries)) refresh)
  (blank)
  (if (. attachment store)
    (call refresh)
  )
)

(fn-do _ register-markup-descendants-query _
  (param owner MarkupElement)
  (param target-id Size)
  (param add MarkupDescendantsQueryApplier)
  (param remove MarkupDescendantsQueryApplier)
  (let attachment (call markup-ensure-attachment owner))
  (= markup-descendants-query-active true)
  (let overflow (call (. attachment overflow-for-write)))
  (blank)
  (let binding (call MarkupDescendantsQueryBinding owner target-id add remove))
  (if (not (. overflow descendants-queries))
    (= (. overflow descendants-queries) (call (of List MarkupDescendantsQueryBinding)))
  )
  (+= (!! (. overflow descendants-queries)) binding)
  (blank)
  (if (. attachment store)
    (call markup-query-seed-descendants-binding attachment binding)
  )
)

(fn-do _ register-markup-descendant-target _
  (param target MarkupElement)
  (param target-id Size)
  (let attachment (call markup-ensure-attachment target))
  (let overflow (call (. attachment overflow-for-write)))
  (blank)
  (if (not (. overflow descendant-target-ids))
    (= (. overflow descendant-target-ids) (call (of List Size)))
  )
  (blank)
  (let ids (!! (. overflow descendant-target-ids)))
  (return-if (if (has ids target-id)))
  (blank)
  (+= ids target-id)
  (blank)
  (if (and (. attachment store) (. attachment mounted-parent))
    (call markup-query-publish-target-id attachment target-id true)
  )
)

(fn-do _ (of markup-query-add-descendant Target) Bool
  (param list (list Target))
  (param owner MarkupElement)
  (param item Target)
  (constraint is Target MarkupElement)
  (let item-host (as item MarkupElement))
  (if (not (. list length))
    (+= list item)
    (return true)
  )
  (blank)
  (let last-item ([] list (. Position last)))
  (return-if (if (== last-item item)))
  (blank)
  (let last-host (as last-item MarkupElement))
  (if (call markup-query-host-precedes owner last-host item-host)
    (+= list item)
    (return true)
  )
  (blank)
  (return-if (if (has list item)))
  (blank)
  (let index Index 0)
  (while (< index (. list length))
    (probe-count markup.query.ordered-insert-scans)
    (let existing-host (as ([] list index) MarkupElement))
    (if (call markup-query-host-precedes owner item-host existing-host)
      (call (. list insert) item index)
      (return true)
    )
    (+= index 1)
  )
  (blank)
  (+= list item)
  (return true)
)

(fn-do _ (of markup-query-remove-descendant Target) Bool
  (param list (list Target))
  (param owner MarkupElement)
  (param item Target)
  (constraint is Target MarkupElement)
  (let found (-= list item))
  (return-if true (if found))
  (return false)
)

(fn-do _ markup-query-parent-host _
  (param owner MarkupElement)
  (let parent (?. (?. (call markup-attachment owner) mounted-parent) host))
  (while (and parent (or (. parent markup-is-transparent-region) (!= (call markup-region-controller parent) null)))
    (= parent (?. (?. (call markup-attachment parent) mounted-parent) host))
  )
  (return parent)
)

(fn-do _ (of markup-query-lists-match Item) Bool
  (param left (list Item))
  (param right (list Item))
  (return-if (if (!= (. left length) (. right length))))
  (blank)
  (let index Index 0)
  (while (< index (. left length))
    (return-if (if (!= ([] left index) ([] right index))))
    (+= index 1)
  )
  (blank)
  (return true)
)

(fn-do _ (of markup-move Host Child Anchor) _
  (param parent Host)
  (param child Child)
  (param anchor (? Anchor))
  (constraint is Host MarkupParent)
  (constraint is Child MarkupElement)
  (constraint is Anchor MarkupElement)
  (let parent-host (as parent MarkupElement))
  (let parent-attachment (call markup-attachment parent-host))
  (let child-attachment (call markup-attachment child))
  (throw (call Panic "Markup child is not linked under parent") (if (or (not parent-attachment) (not child-attachment) (!= (. child-attachment structural-parent) parent-attachment))))
  (blank)
  (if anchor
    (let anchor-attachment (call markup-attachment anchor))
    (throw (call Panic "Markup anchor is not linked under parent") (if (or (not anchor-attachment) (!= (. anchor-attachment structural-parent) parent-attachment))))
    (return-if (if (== anchor-attachment child-attachment)))
    (return-if (if (== (. child-attachment next-sibling) anchor-attachment)))
    (else
      (return-if (if (== (. parent-attachment last-child) child-attachment)))
    )
  )
  (blank)
  (call markup-query-publish-subtree child false)
  (call markup-unlink-structural-child parent-host child)
  (call (. parent markup-detach-child) child)
  (call markup-link-structural-child parent-host child anchor)
  (call (. parent markup-attach-child) child anchor)
  (call markup-query-publish-subtree child true)
)

(fn-do _ mark-structural-markup-action _
  (param action LiveAction)
  (param owner (? MarkupElement) (= null))
  (if (is action MarkupBatchAction)
    (let batch-action (as action MarkupBatchAction))
    (= (. batch-action is-structural) true)
    (= (. batch-action structural-owner) owner)
  )
  (call (. action dispatch-first))
)

(fn-do _ markup-host-depth Size
  (param host (? MarkupElement))
  (let depth Size 0)
  (let attachment (only-if (call markup-attachment host) (if host)))
  (while attachment
    (+= depth 1)
    (= attachment (. attachment structural-parent))
  )
  (return depth)
)

(fn-do _ markup-action-is-reshaped Bool
  (param action MarkupBatchAction)
  (param reshaped (list MarkupAttachment))
  (let host
    (scope (if-expr (. action is-structural) structural-host (. action batch-owner))
      (lazy structural-host (?? (. action structural-owner) (. action batch-owner)))
    )
  )
  (if (not host)
    (return false)
  )
  (let owned (call markup-attachment host))
  (if (not owned)
    (return false)
  )
  (let attachment (. owned structural-parent))
  (while attachment
    (if (has reshaped attachment)
      (return true)
    )
    (= attachment (. attachment structural-parent))
  )
  (return false)
)

(fn-expr _ make-markup-action LiveAction
  (param trackers (list Tracker))
  (param callback SubscriberCallback)
  (param root MarkupRootElement)
  (call MarkupBatchAction root trackers callback)
)

(fn-expr _ make-owner-markup-action LiveAction
  (param trackers (list Tracker))
  (param callback SubscriberCallback)
  (param owner MarkupElement)
  (call MarkupBatchAction owner trackers callback)
)

(fn-do _ (of markup-property-dependency-subscribe Object) LiveAction
  (param object Object)
  (param owner MarkupElement)
  (param name String)
  (param callback Doer)
  (let action (call MarkupPropertyDependencyAction owner (call (of List Tracker)) callback))
  (do
    (inline (call link-property-dependency object name action))
  )
  (return action)
)

