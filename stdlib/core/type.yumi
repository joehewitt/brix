━━━━━━━━━━━━━━━━━━━━
+ TypeInfo'Subject

────────────────────
+ to String

"[TypeInfo $name]"

────────────────────
+ this == other

false

────────────────────
+ this > other

false

────────────────────
+ this < other

false

────────────────────
+ compare
    - other

false

────────────────────
+ compare-unified
    - other

false

━━━━━━━━━━━━━━━━━━━━
+ PropertyList is Tuple

+ table Pointer

────────────────────
+ get length Size

if table == null then 0 else (table as CPointer'U64)[0] as Size

────────────────────
+ this[index Index] PropertyInfo

?! OutOfBoundsError("Property index $index out of range")
    if index < 0 || index >= length

PropertyInfo(table + (8 + index * 40))

────────────────────
+ do to Iterable'PropertyInfo

for index in 0 .. < length
    <= this[index]

────────────────────
+ do named PropertyInfo?
    - name String

for index in 0 .. < length
    . property = this[index]
    =? property if property.name == name
= null

━━━━━━━━━━━━━━━━━━━━
+ PropertyInfo is Tuple

+ entry Pointer

────────────────────
+ get name String

(entry as CPointer'String)[0]

────────────────────
+ get type-name String

(descriptor as CPointer'String)[0]

────────────────────
+ get type-key String

(descriptor as CPointer'String)[1]

────────────────────
+ get offset Size

(entry as CPointer'U64)[2] as Size

────────────────────
+ get size Size

(entry as CPointer'U64)[3] as Size

────────────────────
+ get is-aggregate Bool

kind == 0

────────────────────
+ get is-float Bool

kind == 1

────────────────────
+ get is-signed Bool

kind == 2

────────────────────
+ get is-unsigned Bool

kind == 3

────────────────────
+ get is-boolean Bool

kind == 4

────────────────────
+ get is-reference Bool

kind == 5

────────────────────
+ get properties PropertyList

PropertyList((descriptor as CPointer'Pointer)[2])

────────────────────
_ get kind U64

(entry as CPointer'U64)[4]

────────────────────
_ get descriptor Pointer

(entry as CPointer'Pointer)[1]

