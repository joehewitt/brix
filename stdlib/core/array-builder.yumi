+ extend Array''Value''Backing

────────────────────
+ This @inline
    - items <Value>
    - capacity Size = 0
    - Backing = GCBacking

. builder ArrayBuilder'Value'Backing?

for item in items
    if !builder
        builder = ArrayBuilder'Value'Backing()
        builder.reserve(capacity)
    builder.append(item)

|? builder
    = builder.finish-mutable()
??
    = This(0 as CPointer'Value, 0)

────────────────────
+ This'Provider @inline
    - provider Provider
    - items <Value>
    - capacity Size = 0
    - Provider is ArrayStorageProvider
    - Backing = Provider.Backing'Value

. builder ArrayBuilder'Value'Backing?

for item in items
    if builder
        builder.append(item)
    else
        builder = ArrayBuilder'Value(provider)
        builder.reserve(capacity)
        builder.append(item)

|? builder
    = builder.finish-mutable()
??
    = This(0 as CPointer'Value, 0)

