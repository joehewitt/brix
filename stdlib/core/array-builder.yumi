+ do inspectable-snapshot

//this:array-builder.length = length
for item in this
    //this:array-builder.item -> item

────────────────────
_ do store-items
    - next-items Array'Item'Backing

Backing.store'(CPointer'Byte)
    - header as CPointer'(CPointer'Byte)
    - next-items.data as CPointer'Byte
    - 0
((header + 8) as CPointer'Size)[0] = next-items.length

────────────────────
_ do store-size
    - next-size Size

((header + 16) as CPointer'Size)[0] = next-size

────────────────────
_ do replace-state
    - next-items Array'Item'Backing
    - next-size Size
    - next-mutation-generation Size

store-items(next-items)
store-size(next-size)
((header + 24) as CPointer'Size)[0] = next-mutation-generation

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ initial-sequence-capacity Size

|? Item.size <= 16
    8
|? Item.size <= 1024
    4
??
    1

────────────────────
_ do next-sequence-capacity Size
    - current Size
    - needed Size

. capacity Size
if current == 0
    capacity = initial-sequence-capacity()
else if current < 1024
    ?! Panic("ArrayBuilder size overflow")
        if current > Size.max / 2
    capacity = current * 2
else
    . half = current / 2
    ?! Panic("ArrayBuilder size overflow")
        if current > Size.max - half
    capacity = current + half
if capacity < needed
    capacity = needed
= capacity

