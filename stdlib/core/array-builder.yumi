header

────────────────────
+ this[index Index]

?! OutOfBoundsError("ArrayBuilder index $index out of range")
    if (index as UInt) >= (active-size as UInt)

active-items[index]

.. active-size = current-size
.. active-items = current-items

────────────────────
+ this[position Position]

this[position.normalize(this)]

────────────────────
+ do this[index Index] = item Item

. active-items = current-items
. active-size = current-size
?! OutOfBoundsError("ArrayBuilder index $index out of range")
    if (index as UInt) >= (active-size as UInt)
active-items[index] = item

────────────────────
+ do append
    - item Item

. active-items = current-items
. active-size = current-size
?! Panic("ArrayBuilder size overflow")
    if active-size == Size.max
if active-size == active-items.length
    . next-capacity = next-sequence-capacity(active-items.length, active-size + 1)
    active-items = active-items.resize(next-capacity, context)
    store-items(active-items)
active-items[active-size] = item
store-size(active-size + 1)

────────────────────
+ do append-all
    - appended <Item>

for item in appended
    append(item)

────────────────────
+ do reserve
    - capacity Size

. active-items = current-items
if capacity > active-items.length
    store-items(active-items.resize(capacity, context))

────────────────────
+ do rewind
    - mark Size

. active-items = current-items
. active-size = current-size
. active-mutation-generation = current-mutation-generation
?! OutOfBoundsError("ArrayBuilder mark $mark out of range")
    if mark > active-size

for index in mark .. < active-size
    active-items.zero(index)
replace-state(active-items, mark, active-mutation-generation + 1)

────────────────────
+ do clear

rewind(0)

────────────────────
+ do finish-immutable ImmutableArray'Item'Backing

= finish-mutable().immutable

────────────────────
+ do finish-immutable-compacted ImmutableArray'Item'Backing

= finish-mutable-compacted().immutable

────────────────────
+ do finish-mutable Array'Item'Backing

. result Array'Item'Backing
. active-items = current-items
. active-size = current-size
. active-mutation-generation = current-mutation-generation
if active-size == 0
    result = Array'Item'Backing(Backing.allocate'Item(context, 0) as CPointer'Item, 0)
else
    result = active-items[0 .. < active-size]
replace-state(Array'Item'Backing(0 as CPointer'Item, 0), 0, active-mutation-generation + 1)
= result

────────────────────
+ do finish-mutable-compacted Array'Item'Backing

. result Array'Item'Backing
. active-items = current-items
. active-size = current-size
. active-mutation-generation = current-mutation-generation
if active-size == 0
    result = Array'Item'Backing(Backing.allocate'Item(context, 0) as CPointer'Item, 0)
else
    if active-items.length != active-size
        active-items = active-items.resize(active-size, context)
    result = active-items[0 .. < active-size]
replace-state(Array'Item'Backing(0 as CPointer'Item, 0), 0, active-mutation-generation + 1)
= result

────────────────────
+ do storage-checkpoint ArrayBuilderStorageCheckpoint'Item'Backing @no-gc
    - arena Arena
    - mark ArenaMark

?! Panic("ArrayBuilder storage checkpoints require Arena-backed storage")
    if Backing != ArenaBacking

. saved-items = current-items
?! Panic("ArrayBuilder storage checkpoint mark is stale or belongs to another Arena")
    if !arena.owns(storage-identity)
?! Panic("ArrayBuilder storage checkpoint mark is stale or belongs to another Arena")
    if mark.value != arena.mark.value

= ArrayBuilderStorageCheckpoint'Item'Backing
    - saved-items
    - current-size
    - storage-identity
    - current-mutation-generation
    - arena.generation
    - mark.value
    - arena.active-bytes

────────────────────
+ do validate-storage-restore @no-gc
    - checkpoint ArrayBuilderStorageCheckpoint'Item'Backing
    - arena Arena
    - mark ArenaMark

?! Panic("ArrayBuilder storage checkpoint is stale or belongs to another builder")
    if Backing != ArenaBacking
?! Panic("ArrayBuilder storage checkpoint is stale or belongs to another builder")
    if checkpoint.storage-identity.address == 0
?! Panic("ArrayBuilder storage checkpoint is stale or belongs to another builder")
    if storage-identity.address != checkpoint.storage-identity.address
?! Panic("ArrayBuilder storage checkpoint is stale or belongs to another builder")
    if checkpoint.storage-mutation-generation != current-mutation-generation
?! Panic("ArrayBuilder storage checkpoint is stale or belongs to another builder")
    if checkpoint.size > current-size
?! Panic("ArrayBuilder storage checkpoint is stale or belongs to another builder")
    if checkpoint.arena-generation != arena.generation
?! Panic("ArrayBuilder storage checkpoint is stale or belongs to another builder")
    if checkpoint.arena-mark != mark.value
?! Panic("ArrayBuilder storage checkpoint is stale or belongs to another builder")
    if checkpoint.arena-active-bytes > arena.active-bytes
?! Panic("ArrayBuilder storage checkpoint is stale or belongs to another builder")
    if !arena.owns(checkpoint.storage-identity)

────────────────────
+ do restore-storage @no-gc
    - checkpoint ArrayBuilderStorageCheckpoint'Item'Backing
    - arena Arena
    - mark ArenaMark

?! Panic("ArrayBuilder storage checkpoint cannot be restored from the current Arena state")
    if Backing != ArenaBacking
?! Panic("ArrayBuilder storage checkpoint cannot be restored from the current Arena state")
    if checkpoint.storage-identity.address == 0
?! Panic("ArrayBuilder storage checkpoint cannot be restored from the current Arena state")
    if storage-identity.address != checkpoint.storage-identity.address
?! Panic("ArrayBuilder storage checkpoint cannot be restored from the current Arena state")
    if checkpoint.storage-mutation-generation != current-mutation-generation
?! Panic("ArrayBuilder storage checkpoint cannot be restored from the current Arena state")
    if checkpoint.size > current-size
?! Panic("ArrayBuilder storage checkpoint cannot be restored from the current Arena state")
    if checkpoint.arena-generation != arena.generation
?! Panic("ArrayBuilder storage checkpoint cannot be restored from the current Arena state")
    if checkpoint.arena-mark != mark.value
?! Panic("ArrayBuilder storage checkpoint cannot be restored from the current Arena state")
    if checkpoint.arena-active-bytes != arena.active-bytes
?! Panic("ArrayBuilder storage checkpoint cannot be restored from the current Arena state")
    if !arena.owns(checkpoint.storage-identity)
?! Panic("ArrayBuilder storage generation overflow")
    if checkpoint.storage-mutation-generation == Size.max

replace-state(checkpoint.items, checkpoint.size, checkpoint.storage-mutation-generation + 1)

