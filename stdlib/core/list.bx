(import ./array)
(import ./backing)
(import ./collection)
(import ./core)
(import ./error)
(import ./number)
(import ./range)
(import ./stream)
(import ./string)
(import /BxCore/BxCore.h)

(type + (of List Item Backing)
  (constraint = Backing GCBacking)
  (constraint is Backing StorageBacking)
  (implements (of Indexable Item))
  (implements (of MutableCollection Item))
  (implements Inspectable)
  (prop + size Size (= 0))
  (blank)
  (prop _ items (of Array Item Backing))
  (prop _ context (. Backing Context))
  (prop _ shares-storage _ (= false))
  (blank)
  ; Borrows the contiguous element store for the duration of one native bulk operation. Callers must
  ; not retain the pointer or mutate/grow the List until that native operation returns.
  (prop + buffer-pointer _ (=> (. items data)))
  (fn-do + This _
    (constraint = Backing GCBacking)
    (lazy context (call Void))
    (lazy items (call (of Array Item Backing) context 0))
  )
  (fn-do + This _
    (param ... list (of List Item Backing))
    (constraint = Backing GCBacking)
    (return list)
  )
  (fn-do + (of This SourceBacking) _
    (param list (of List Item SourceBacking))
    (constraint is SourceBacking StorageBacking)
    (constraint = Backing SourceBacking)
    (lazy context (. list context))
    (lazy items (call (of Array Item Backing) context 0))
    (call reserve (. list length))
    (for (in item list)
      (call append-raw item)
    )
  )
  (fn-do + This _ @inline
    (param stream (stream Item))
    (constraint = Backing GCBacking)
    (lazy context (call Void))
    (lazy items (call (of Array Item Backing) context 0))
    (for (in item stream)
      (call append-raw item)
    )
  )
  (fn-do + (of This Storage) _
    (param storage Storage)
    (constraint is Storage ArrayStorageProvider)
    (constraint = Backing (. Storage (of Backing Item)))
    (lazy context (as storage (. Backing Context)))
    (lazy items (call (of Array Item Backing) context 0))
  )
  (fn-do + (of This Storage) _
    (param storage Storage)
    (param stream (stream Item))
    (constraint is Storage ArrayStorageProvider)
    (constraint = Backing (. Storage (of Backing Item)))
    (= context (as storage (. Backing Context)))
    (= items (call (of Array Item Backing) context 0))
    (for (in item stream)
      (call append-raw item)
    )
  )
  (fn-to-do + (list ''T)
    (constraint =~ T (as Item T))
    (let copy (call (of List T)))
    (for (in item this)
      (+= copy (as item T))
    )
    (return copy)
  )
  (fn-to-do + (of Indexable ''T)
    (constraint =~ T (as Item T))
    (let copy (call (of List T)))
    (for (in item this)
      (+= copy (as item T))
    )
    (return copy)
  )
  (fn-to-expr + String
    (call (. ", " join) (as this (stream Item)))
  )
  (fn-expr + length _ :get @inline
    size
  )
  (fn-expr + (index-get this (param index Index)) _ @inline
    (case? (< (as index UInt) (as size UInt))
      ([] (. items data) index)
    )
    (default
      (call absent index)
    )
  )
  (fn-do + (index-get this (param range (of Range Position))) _
    (return (call slice-raw (call (. (call (. range normalize) this) forward))))
  )
  (fn-do + (index-get this (param range (of Range Index))) _
    (return (call slice-raw (call (. range forward))))
  )
  (fn-do + reversed _
    (for (in offset (..< 0 size))
      (yield ([] this (- size 1 offset)))
    )
  )
  (fn-do + (index-set this (param index Index) (param item Item)) _ @inline
    (throw (call OutOfBoundsError (str "List index " index " out of range")) (if (>= (as index UInt) (as size UInt))))
    (blank)
    (= ([] items index) item)
    (blank)
    (do @feature-collection-observers
      (call notify-collection-set this index)
    )
  )
  (fn-do + replace _
    (param index Index)
    (param item Item)
    (call check-range index 1)
    (= ([] items index) item)
    (blank)
    (do @feature-collection-observers
      (call notify-collection-replace this index)
    )
  )
  (fn-do + append _
    (param item Item)
    (+= this item)
  )
  (fn-do + append-all _
    (param items (stream Item))
    (++= this items)
  )
  (fn-do + insert _
    (param item Item)
    (param index Index)
    (call check-insert-index index)
    (if (== size (. items size))
      (call grow (+ size 1))
    )
    (blank)
    (call shift-right-raw 1 index)
    (= ([] items index) item)
    (+= size 1)
    (blank)
    (do @feature-collection-observers
      (call notify-collection-insert this index)
    )
  )
  (fn-do + remove _
    (param index Index)
    (param count Size (= 1))
    (call check-range index count)
    (if count
      (call remove-range-raw index count)
      (blank)
      (do @feature-collection-observers
        (call notify-collection-remove this index count)
      )
    )
  )
  (fn-do + remove _
    (param range (of Range Index))
    (-= ([] this range))
  )
  (fn-do + move _
    (param from-index Index)
    (param to-index Index)
    (param count Size (= 1))
    (call check-range from-index count)
    (call check-insert-index to-index)
    (blank)
    (return-if (if (not count)))
    (blank)
    (return-if (if (== from-index to-index)))
    (return-if (if (and (> to-index from-index) (< to-index (+ from-index count)))))
    (blank)
    (let moved (call This context count))
    (for (in offset (..< 0 count))
      (call (. moved append-raw) ([] items (+ from-index offset)))
    )
    (call remove-range-raw from-index count)
    (blank)
    (let insert-index to-index)
    (if (> insert-index from-index)
      (-= insert-index count)
    )
    (blank)
    (if (> (+ size count) (. items size))
      (call grow (+ size count))
    )
    (call shift-right-raw count insert-index)
    (blank)
    (let offset Index 0)
    (for (in item moved)
      (= ([] items (+ insert-index offset)) item)
      (+= offset 1)
    )
    (+= size count)
    (blank)
    (do @feature-collection-observers
      (call notify-collection-move this from-index to-index count)
    )
  )
  (fn-do + clear _
    (let old-size size)
    (= size 0)
    (call vacate-raw 0 old-size)
    (blank)
    (do @feature-collection-observers
      (if old-size
        (call notify-collection-remove this 0 old-size)
      )
    )
  )
  (fn-do + inspectable-snapshot _
    (probe-assign (: this list.length) size)
    (for (in item this)
      (probe-log (: this list.item) (items: item))
    )
  )
  (fn-expr + capacity Size :get
    (. items size)
  )
  (fn-expr + head Item :get
    ([] this 0)
  )
  (fn-expr + tail Item :get
    ([] this (- size 1))
  )
  (fn-do + (infix this <- (param item Item)) _
    (+= this item)
    (return this)
  )
  (fn-do + (infix this + (param item Item)) _
    (let clone (call This this))
    (call (. clone add) item)
    (return clone)
  )
  (fn-do + (infix this ++ (param other (stream Item))) _
    (let clone (call This this))
    (for (in item other)
      (call (. clone add) item)
    )
    (return clone)
  )
  (fn-expr + (infix this == (param other (list Item))) _
    (== ([] items (..< 0 size)) other)
  )
  (fn-do + (infix this += (param item Item)) _ @inline
    (call append-raw item)
    (blank)
    (do @feature-collection-observers
      (call notify-collection-append this (- size 1))
    )
  )
  (fn-do + (infix this ++= (param items (stream Item))) _
    (let old-size size)
    (for (in item items)
      (call append-raw item)
    )
    (blank)
    (do @feature-collection-observers
      (if (> size old-size)
        (call notify-collection-append this old-size (- size old-size))
      )
    )
  )
  (fn-do + (infix this -= (param item Item)) _
    (let found (call find item))
    (if found
      (let index (+ found 1))
      (while (< index size)
        (= ([] items (- index 1)) ([] items index))
        (+= index 1)
      )
      (-= size 1)
      (call vacate-raw size 1)
      (blank)
      (do @feature-collection-observers
        (call notify-collection-remove this found)
      )
    )
    (return found)
  )
  (fn-do + (infix this has (param item Item)) _
    (let data (. items data))
    (for (in index (..< 0 size))
      (return-if true (if (== ([] data index) item)))
    )
    (return false)
  )
  (fn-expr + (index-get this (param pos Position)) _
    ([] this (call (. pos normalize) this))
  )
  (fn-do + (index-set this (param pos Position) (param item Item)) _
    (= ([] this (call (. pos normalize) this)) item)
  )
  (fn-do + (index-set this (param index (of NTuple2 Index)) (param item Item)) _
    (= ([] this ([] index 0)) item)
    (= ([] this ([] index 1)) item)
  )
  (fn-do + (index-set this (param index (of NTuple3 Index)) (param item Item)) _
    (= ([] this ([] index 0)) item)
    (= ([] this ([] index 1)) item)
    (= ([] this ([] index 2)) item)
  )
  (fn-do + (index-set this (param index (of NTuple4 Index)) (param item Item)) _
    (= ([] this ([] index 0)) item)
    (= ([] this ([] index 1)) item)
    (= ([] this ([] index 2)) item)
    (= ([] this ([] index 3)) item)
  )
  (fn-do + (index-set this (param index (of NTuple5 Index)) (param item Item)) _
    (= ([] this ([] index 0)) item)
    (= ([] this ([] index 1)) item)
    (= ([] this ([] index 2)) item)
    (= ([] this ([] index 3)) item)
    (= ([] this ([] index 4)) item)
  )
  (fn-do + (index-set this (param index (of NTuple6 Index)) (param item Item)) _
    (= ([] this ([] index 0)) item)
    (= ([] this ([] index 1)) item)
    (= ([] this ([] index 2)) item)
    (= ([] this ([] index 3)) item)
    (= ([] this ([] index 4)) item)
    (= ([] this ([] index 5)) item)
  )
  (fn-do + (index-set this (param index Tuple) (param item Item)) _
    (= ([] this ([] index 0)) item)
  )
  (fn-do + (index-delete this (param index Index)) _
    (call check-range index 1)
    (call remove-at-raw index)
    (blank)
    (do @feature-collection-observers
      (call notify-collection-remove this index)
    )
  )
  (fn-expr + (index-delete this (param range (of Range Position))) _
    (-= ([] this (call (. range normalize) this)))
  )
  (fn-do + (index-delete this (param range (of Range Index))) _
    (throw (call Panic "Only increments of 1 are currently supported") (if (and (!= (. range increment) 1) (!= (. range increment) -1))))
    (blank)
    (let low (if-expr (> (. range start) (. range end)) (. range end) (. range start)))
    (let high (if-expr (> (. range start) (. range end)) (. range start) (. range end)))
    (let count (if-expr (. range is-through) (+ (- high low) 1) (- high low)))
    (let start (if-expr (and (> (. range start) (. range end)) (not (. range is-through))) (+ low 1) low))
    (call check-range start count)
    (if count
      (call remove-range-raw start count)
      (blank)
      (do @feature-collection-observers
        (call notify-collection-remove this start count)
      )
    )
  )
  (fn-expr + (prefix ! this) _
    (== size 0)
  )
  (fn-do + reserve _
    (param capacity Size)
    (if (> capacity (. items size))
      (call replace-storage (call (. items resize) capacity context))
    )
  )
  (fn-do + trim _
    (if (< size (. items size))
      (call replace-storage (call (. items resize) size context))
    )
  )
  (fn-do + release _
    (call clear)
    (call replace-storage (call (. items resize) 0 context))
  )
  (fn-do + add _
    (param item Item)
    (call append-raw item)
    (blank)
    (do @feature-collection-observers
      (call notify-collection-append this (- size 1))
    )
  )
  (fn-do + insert _
    (param insert-items (stream Item))
    (param index Index)
    (call check-insert-index index)
    (let to-insert (call This context 0))
    (for (in item insert-items)
      (call (. to-insert append-raw) item)
    )
    (let count (. to-insert length))
    (return-if (if (not count)))
    (blank)
    (if (> (+ size count) (. items size))
      (call grow (+ size count))
    )
    (call shift-right-raw count index)
    (let offset Index 0)
    (for (in item to-insert)
      (= ([] items (+ index offset)) item)
      (+= offset 1)
    )
    (+= size count)
    (blank)
    (do @feature-collection-observers
      (call notify-collection-insert this index count)
    )
  )
  (fn-do + fill _
    (param count Size)
    (for (in index (..< 0 count))
      (if (< index size)
        (= ([] this index) (call Item))
        (else
          (+= this (call Item))
        )
      )
    )
  )
  (fn-do + pop _
    (throw (call OutOfBoundsError "Can't pop the last item of an empty list") (if (== size 0)))
    (blank)
    (-= size 1)
    (let item ([] (. items data) size))
    (call vacate-raw size 1)
    (blank)
    (do @feature-collection-observers
      (call notify-collection-remove this size)
    )
    (return item)
  )
  (fn-do + pop-first _
    (let item ([] this 0))
    (call remove-at-raw 0)
    (blank)
    (do @feature-collection-observers
      (call notify-collection-remove this 0)
    )
    (return item)
    (blank)
    ; ?! OutOfBoundsError("Can't pop the first item of an empty list")
    ;     if size == 0
  )
  (fn-expr + find _
    (param item Item)
    (call (. ([] items (..< 0 size)) find) item)
  )
  (fn-do + this _
    (param item Item)
    (+= this item)
    (return this)
  )
  (fn-do + this _
    (param item (of Optional Item))
    (+=? this item)
    (return this)
  )
  (fn-do + this _
    (param items (stream Item))
    (++= this items)
    (return this)
  )
  (fn-do + slide _
    (param increment Increment (= 1))
    (param start-index Index (= 0))
    (return-if (if (== increment 0)))
    (blank)
    (if (< increment 0)
      (let index (- start-index increment))
      (let old-size size)
      (while (< index size)
        (= ([] items (+ index increment)) ([] items index))
        (+= index 1)
      )
      (+= size increment)
      (if (and (>= size 0) (< size old-size))
        (call vacate-raw size (- old-size size))
      )
      (else
        (let index (- size start-index))
        (if (>= index increment)
          (let shifted-size size)
          (if (>= index size)
            (= shifted-size (+ index 1))
            (if (> shifted-size (. items size))
              (call grow shifted-size)
            )
          )
          (while (>= index increment)
            (= ([] items index) ([] items (- index increment)))
            (-= index 1)
          )
          (= size shifted-size)
        )
      )
    )
    (blank)
    (do @feature-collection-observers
      (if (< increment 0)
        (call notify-collection-reset this)
        (else-if (>= (- size start-index) increment)
          (call notify-collection-reset this)
        )
      )
    )
  )
  (fn-do + (of with Item) _
    (param item Item)
    (+= this item)
    (return this)
  )
  (fn-do _ absent Item
    (param index Index)
    (throw (call OutOfBoundsError (str "List index " index " out of range")))
  )
  (fn-do _ check-insert-index _
    (param index Index)
    (throw (call OutOfBoundsError (str "List index " index " out of range")) (if (> (as index UInt) (as size UInt))))
  )
  (fn-do _ check-range _
    (param index Index)
    (param count Size)
    (throw (call OutOfBoundsError (str "List range at index " index " with count " count " out of range")) (if (> (as index UInt) (as size UInt))))
    (throw (call OutOfBoundsError (str "List range at index " index " with count " count " out of range")) (if (> (as count UInt) (as (- size index) UInt))))
  )
  (fn-do _ slice-raw This @inline
    (param normal (of Range Index))
    (throw (call OutOfBoundsError (str "Range out of bounds (" out-index " / " size ")")) (if (and (== (. normal increment) 1) (> (. normal end) size))))
    (blank)
    (let list (call This context 0))
    (= (. list items) ([] items normal))
    (= (. list size) (. normal length))
    (= (. list shares-storage) true)
    (= shares-storage true)
    (return list)
    (blank)
    (lazy out-index (if-expr (> (. normal end) 0) (- (. normal end) 1) (. normal end)))
  )
  (fn-do _ append-raw _ @inline
    (param item Item)
    (throw (call Panic "List size overflow") (if (== size (. Size max))))
    (blank)
    (if (== size (. items size))
      (call grow (+ size 1))
    )
    (blank)
    (= ([] items size) item)
    (+= size 1)
  )
  (fn-do _ remove-at-raw _
    (param index Index)
    (let cursor (+ index 1))
    (while (< cursor size)
      (= ([] items (- cursor 1)) ([] items cursor))
      (+= cursor 1)
    )
    (-= size 1)
    (call vacate-raw size 1)
  )
  (fn-do _ remove-range-raw _
    (param index Index)
    (param count Size)
    (let cursor (+ index count))
    (while (< cursor size)
      (= ([] items (- cursor count)) ([] items cursor))
      (+= cursor 1)
    )
    (-= size count)
    (call vacate-raw size count)
  )
  (fn-do _ vacate-raw _ @inline
    (param index Index)
    (param count Size)
    (if shares-storage
      (call clamp-shared-raw index)
    )
    (return-if (if (or (. Item is-number) (< (. Item size) 8) shares-storage (<= count 0))))
    (blank)
    (call C:brixZeroManagedSlots (+ (. items data) index) (* (. Item size) count))
  )
  (fn-do _ clamp-shared-raw _
    (param count Size)
    (= items ([] items (..< 0 count)))
  )
  (fn-do _ shift-right-raw _
    (param count Size)
    (param index Index)
    (let cursor size)
    (while (> cursor index)
      (-= cursor 1)
      (= ([] items (+ cursor count)) ([] items cursor))
    )
  )
  (fn-do _ grow _
    (param min-size Size)
    (if (> min-size (. items size))
      (call replace-storage (call (. items resize) (call next-list-capacity (. items size) min-size) context))
    )
  )
  (fn-do _ replace-storage _
    (param storage (of Array Item Backing))
    (if (or (== (. storage size) 0) (!= (. (as (. storage data) Pointer) address) (. (as (. items data) Pointer) address)))
      (= shares-storage false)
    )
    (= items storage)
  )
  (fn-do _ This _
    (param context (. Backing Context))
    (param capacity Size)
    (= (. this context) context)
    (= items (call (of Array Item Backing) context capacity))
  )
  (fn-expr _ initial-list-capacity Size
    (case? (== (. Item size) 1)
      8
    )
    (case? (<= (. Item size) 1024)
      4
    )
    (default
      1
    )
  )
  (fn-do _ next-list-capacity Size
    (param current Size)
    (param needed Size)
    (let new-size (call grown-list-capacity current))
    (if (== current 0)
      (= new-size (call initial-list-capacity))
      (else-if (< current 1024)
        (= new-size (call doubled-list-capacity current))
      )
    )
    (if (< new-size needed)
      (= new-size needed)
    )
    (return new-size)
  )
  (fn-expr _ doubled-list-capacity Size
    (param current Size)
    (before
      (throw (call Panic "List size overflow") (if (> current (/ (. Size max) 2))))
    )
    (* current 2)
  )
  (fn-expr _ grown-list-capacity Size
    (param current Size)
    (before
      (throw (call Panic "List size overflow") (if (> current (- (. Size max) half))))
    )
    (+ current half)
    (where
      (lazy half (/ current 2))
    )
  )
  (fn-expr _ normalize-index _
    (param index Index)
    (case? (< index 0)
      (+ size index)
    )
    (default
      index
    )
  )
)

(fn-expr _ (of first Item) (? Item)
  (param stream (of Indexable Item))
  ([] stream 0)
)

(fn-expr _ (of first Item) _
  (param stream (of Iterable Item))
  (<- stream)
)
