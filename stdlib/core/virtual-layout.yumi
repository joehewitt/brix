╌╌╌╌╌╌╌╌╌╌ is VirtualLayout ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do fill-window
    - window VirtualWindow
    - domain VirtualSequenceDomain

window.clear-placements()

. known-count = larger-virtual(0vcoord, domain.known-count)
. available-count = known-count
if !domain.is-final
    ?! Panic("Virtual sequence size overflow")
        if known-count == VirtualCoord.max
    available-count += 1vcoord

. width = larger-virtual(0vcoord, window.frame-width)
. columns = column-count(width)
. cell = cell-extent(width)
. pitch = cell + spacing
. inset = leading-inset(width)
. viewport-height = larger-virtual(0vcoord, window.viewport-height)
. leading = larger-virtual(0vcoord, window.overscan-top)
. trailing = larger-virtual(0vcoord, window.overscan-bottom)

. available-length = grid-length(available-count, columns, pitch, spacing)
. max-main = larger-virtual(0vcoord, available-length - viewport-height)
. resolved-main = smaller-virtual(max-main, larger-virtual(0vcoord, window.scroll-y))
. window-start = larger-virtual(0vcoord, resolved-main - leading)
. window-end = checked-virtual-sum(checked-virtual-sum(resolved-main, viewport-height), trailing)
. rows = grid-rows(available-count, columns)
. row = window-start / pitch
. last-row = window-end / pitch
if window-end % pitch != 0vcoord
    last-row += 1vcoord
last-row = smaller-virtual(last-row, rows)

while row < last-row
    . index = checked-virtual-product(row, columns)
    . end = smaller-virtual(available-count, index + columns)
    . y = checked-virtual-product(row, pitch)
    while index < end
        . x = inset + (index - row * columns) * pitch
        window.place(index, domain.address-at(index), x, y, cell, cell)
        index += 1vcoord
    row += 1vcoord

. estimated-length VirtualCoord?
if domain.estimated-count
    . estimated-count = larger-virtual(0vcoord, domain.estimated-count!)
    estimated-length = grid-length(estimated-count, columns, pitch, spacing)

window.resolved-scroll-x = 0vcoord
window.resolved-scroll-y = resolved-main
window.known-width = width
window.estimated-width = width
window.is-width-final = true
window.known-height = grid-length(known-count, columns, pitch, spacing)
window.estimated-height = estimated-length
window.is-height-final = domain.is-final

────────────────────
+ do rect-for-address VirtualRect?
    - address I64
    - domain VirtualSequenceDomain
    - window VirtualWindow

. index = domain.index-of(address)
=? if !index
. width = larger-virtual(0vcoord, window.frame-width)
. columns = column-count(width)
. cell = cell-extent(width)
. pitch = cell + spacing
= VirtualRect
    - leading-inset(width) + (index % columns) * pitch
    - (index / columns) * pitch
    - cell
    - cell

