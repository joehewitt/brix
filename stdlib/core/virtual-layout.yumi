────────────────────
+ do set-overscan
    - overscan VirtualInsets

overscan-top = overscan.top
overscan-right = overscan.right
overscan-bottom = overscan.bottom
overscan-left = overscan.left

────────────────────
+ do clear-placements

placement-count = 0

────────────────────
+ do place
    - placement-id VirtualCoord
    - address I64
    - x VirtualCoord
    - y VirtualCoord
    - width VirtualCoord
    - height VirtualCoord

?! Panic("Virtual placements must have increasing placement ids")
    if placement-count > 0 && placements[placement-count - 1].placement-id >= placement-id
if placement-count == placements.length
    placements += VirtualPlacement()
. placement = placements[placement-count]
placement.placement-id = placement-id
placement.address = address
placement.x = x
placement.y = y
placement.width = width
placement.height = height
placement.is-sticky = false
placement.is-pinned = false
placement.sticky-depth = 0
placement-count += 1

────────────────────
+ do insert-placement
    - position Index
    - placement-id VirtualCoord
    - address I64
    - x VirtualCoord
    - y VirtualCoord
    - width VirtualCoord
    - height VirtualCoord

?! Panic("Virtual placements must have increasing placement ids")
    if position > placement-count
?! Panic("Virtual placements must have increasing placement ids")
    if position > 0 && placements[position - 1].placement-id >= placement-id
?! Panic("Virtual placements must have increasing placement ids")
    if position < placement-count && placements[position].placement-id <= placement-id
if placement-count == placements.length
    placements += VirtualPlacement()
. spare = placements[placement-count]
. index = placement-count
while index > position
    placements[index] = placements[index - 1]
    index -= 1
placements[position] = spare
spare.placement-id = placement-id
spare.address = address
spare.x = x
spare.y = y
spare.width = width
spare.height = height
spare.is-sticky = false
spare.is-pinned = false
spare.sticky-depth = 0
placement-count += 1

────────────────────
+ placement-at
    - index Index

placements[index] if index < placement-count

