────────────────────
+ cell-extent VirtualCoord
    - width VirtualCoord

larger-virtual(1vcoord, smaller-virtual(cell-length, width))

────────────────────
+ leading-inset VirtualCoord
    - width VirtualCoord

larger-virtual
    - 0vcoord
    - (width - column-count(width) * (cell-extent(width) + spacing) + spacing) / 2vcoord

