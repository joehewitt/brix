────────────────────
+ do fill-window
    - window VirtualWindow
    - domain VirtualSequenceDomain

window.clear-placements()
. count = larger-virtual(0vcoord, domain.known-count)
. total = larger-virtual(0vcoord, offsets.total-height)
. viewport-height = larger-virtual(0vcoord, window.viewport-height)
. viewport-width = larger-virtual(0vcoord, window.viewport-width)
. max-y = larger-virtual(0vcoord, total - viewport-height)
. resolved-y = smaller-virtual(max-y, larger-virtual(0vcoord, window.scroll-y))
. width = offset-row-width(window)
. max-x = larger-virtual(0vcoord, width - viewport-width)
. resolved-x = smaller-virtual(max-x, larger-virtual(0vcoord, window.scroll-x))
. window-start = larger-virtual(0vcoord, resolved-y - larger-virtual(0vcoord, window.overscan-top))
. window-end = resolved-y + viewport-height + larger-virtual(0vcoord, window.overscan-bottom)
. index = offsets.index-at(window-start)
while index < count
    . top = offsets.offset-at(index)
    if top >= window-end
        break
    window.place
        - index
        - domain.address-at(index)
        - 0vcoord
        - top
        - width
        - offsets.offset-at(index + 1vcoord) - top
    index += 1vcoord
window.resolved-scroll-x = resolved-x
window.resolved-scroll-y = resolved-y
window.known-width = width
window.estimated-width = width
window.is-width-final = true
window.known-height = total
window.estimated-height = total
window.is-height-final = domain.is-final

