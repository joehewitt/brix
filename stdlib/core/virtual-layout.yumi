━━━━━━━━━━━━━━━━━━━━
+ VerticalMeasuredLayout
    is VirtualLayout

+ estimated-height VirtualCoord
+ estimate VirtualHeightEstimate?
+ leading VirtualCoord
+ trailing VirtualCoord
+ revision := VirtualRevision()

. parameters-changed < estimated-height, estimate, leading, trailing

_ heights [VirtualCoord]
_ measured-at [VirtualCoord]
_ sums [VirtualCoord]
_ leaf-count Index
_ row-width VirtualCoord

────────────────────
+ This
    - estimated-height
    - estimate VirtualHeightEstimate? = null
    - leading VirtualCoord = 0vcoord
    - trailing VirtualCoord = 0vcoord

?! Panic("Virtual estimated height must be positive")
    if estimated-height <= 0vcoord
?! Panic("Virtual padding must not be negative")
    if leading < 0vcoord || trailing < 0vcoord
rebuild-sums()

────────────────────
+ get row-count

heights.length

────────────────────
+ is-row-measured
    - index Index

index < measured-at.length && measured-at[index] == row-width

────────────────────
+ do reset

heights.clear()
measured-at.clear()
rebuild-sums()
revision.touch()

────────────────────
+ do splice
    - domain VirtualSequenceDomain
    - index Index
    - removed Size
    - added Size

=? if index > heights.length
. available = heights.length - index
. count = if removed < available then removed else available
if count > 0
    heights.remove(index, count)
    measured-at.remove(index, count)
. estimates [VirtualCoord]
. unmeasured [VirtualCoord]
. offset Index
while offset < added
    estimates += estimated-row-height(domain.address-at(index + offset), row-width)
    unmeasured += -1vcoord
    offset += 1
if added > 0
    heights.insert(estimates, index)
    measured-at.insert(unmeasured, index)
rebuild-sums()
revision.touch()

────────────────────
_ do parameters-changed

revision.touch()

────────────────────
_ do rebuild-sums

. capacity Index = 1
while capacity < heights.length
    capacity *= 2
leaf-count = capacity
sums.clear()
sums.reserve(capacity * 2)
. index Index
while index < capacity * 2
    sums += 0vcoord
    index += 1
index = 0
while index < heights.length
    sums[capacity + index] = heights[index]
    index += 1
. node = capacity - 1
while node > 0
    sums[node] = checked-virtual-sum(sums[node * 2], sums[node * 2 + 1])
    node -= 1

────────────────────
_ do set-sum
    - index Index
    - height VirtualCoord

if index >= leaf-count
    rebuild-sums()
    =
. node = leaf-count + index
sums[node] = height
node /= 2
while node > 0
    sums[node] = checked-virtual-sum(sums[node * 2], sums[node * 2 + 1])
    node /= 2

────────────────────
_ get total-height VirtualCoord

sums[1]

────────────────────
_ do offset-at VirtualCoord
    - index Index

. total = 0vcoord
. low = leaf-count
. high = leaf-count + index
while low < high
    if low % 2 == 1
        total += sums[low]
        low += 1
    if high % 2 == 1
        high -= 1
        total += sums[high]
    low /= 2
    high /= 2
= total

────────────────────
_ do index-at Index
    - position VirtualCoord

=? 0 if position < 0vcoord
=? heights.length if position >= total-height
. node Index = 1
. remaining = position
while node < leaf-count
    . left = node * 2
    if sums[left] > remaining
        node = left
    else
        remaining -= sums[left]
        node = left + 1
. found = node - leaf-count
= if found < heights.length then found else heights.length

────────────────────
_ estimated-row-height VirtualCoord
    - address I64
    - width VirtualCoord

if custom then larger-virtual(1vcoord, custom(address, width)) else estimated-height

.. custom = estimate

────────────────────
_ do sync
    - domain VirtualSequenceDomain
    - width VirtualCoord

. count Size = larger-virtual(0vcoord, domain.known-count)
while heights.length > count
    heights.pop()
    measured-at.pop()
    set-sum(heights.length, 0vcoord)
if width != row-width
    row-width = width
    . index Index
    while index < heights.length
        if measured-at[index] < 0vcoord
            . next = estimated-row-height(domain.address-at(index), width)
            if next != heights[index]
                heights[index] = next
                set-sum(index, next)
        index += 1
while heights.length < count
    . next = estimated-row-height(domain.address-at(heights.length), width)
    heights += next
    measured-at += -1vcoord
    set-sum(heights.length - 1, next)

╌╌╌╌╌╌╌╌╌╌ is VirtualLayout ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get measures-rows Bool

true

────────────────────
+ do record-row-height Bool
    - placement VirtualPlacement
    - height VirtualCoord

=? false if placement.placement-id < 0vcoord
. index Index = placement.placement-id
=? false if index >= heights.length
. next = larger-virtual(0vcoord, height)
. changed = heights[index] != next
measured-at[index] = row-width
if changed
    heights[index] = next
    set-sum(index, next)
= changed

────────────────────
+ do fill-window
    - window VirtualWindow
    - domain VirtualSequenceDomain

window.clear-placements()
. width = larger-virtual(0vcoord, window.frame-width)
. viewport = larger-virtual(0vcoord, window.viewport-height)
sync(domain, width)

. count = heights.length
. padded = checked-virtual-sum(leading, total-height)
. total = checked-virtual-sum(padded, trailing)
. max-scroll = larger-virtual(0vcoord, total - viewport)
. resolved = smaller-virtual(max-scroll, larger-virtual(0vcoord, window.scroll-y))
. lead = larger-virtual(0vcoord, window.overscan-top)
. trail = larger-virtual(0vcoord, window.overscan-bottom)
. window-start = larger-virtual(0vcoord, resolved - lead)
. window-end = checked-virtual-sum(checked-virtual-sum(resolved, viewport), trail)

. index = index-at(window-start - leading)
. top = leading + offset-at(index)
while index < count && top < window-end
    window.place(index, domain.address-at(index), 0vcoord, top, width, heights[index])
    top += heights[index]
    index += 1

window.resolved-scroll-x = 0vcoord
window.resolved-scroll-y = resolved
window.known-width = width
window.estimated-width = width
window.is-width-final = true
window.known-height = total
window.estimated-height = total
window.is-height-final = domain.is-final

────────────────────
+ do rect-for-address VirtualRect?
    - address I64
    - domain VirtualSequenceDomain
    - window VirtualWindow

. width = larger-virtual(0vcoord, window.frame-width)
sync(domain, width)
. found = domain.index-of(address)
=? if found == null
. index Index = found
=? if index >= heights.length
= VirtualRect(0vcoord, leading + offset-at(index), width, heights[index])

━━━━━━━━━━━━━━━━━━━━
_ hosted-row-height
    - window VirtualWindow

larger-virtual(1vcoord, window.row-height)

━━━━━━━━━━━━━━━━━━━━
_ do check-fixed-lengths
    - item-length VirtualCoord
    - cross-length VirtualCoord?

?! Panic("Virtual item length must be positive")
    if item-length <= 0vcoord
?! Panic("Virtual cross length must not be negative")
    if cross-length && cross-length < 0vcoord

━━━━━━━━━━━━━━━━━━━━
_ do fill-fixed-window
    - window VirtualWindow
    - domain VirtualSequenceDomain
    - is-vertical Bool
    - item-length VirtualCoord
    - fixed-cross-length VirtualCoord?
    - gap VirtualCoord? = null

window.clear-placements()

. known-count = larger-virtual(0vcoord, domain.known-count)
. available-count = known-count
if !domain.is-final
    ?! Panic("Virtual sequence size overflow")
        if known-count == VirtualCoord.max
    available-count += 1vcoord

. scroll-main = if is-vertical then window.scroll-y else window.scroll-x
. scroll-cross = if is-vertical then window.scroll-x else window.scroll-y
. raw-viewport-main = if is-vertical then window.viewport-height else window.viewport-width
. raw-viewport-cross = if is-vertical then window.viewport-width else window.viewport-height
. raw-frame-cross = if is-vertical then window.frame-width else window.frame-height
. raw-leading = if is-vertical then window.overscan-top else window.overscan-left
. raw-trailing = if is-vertical then window.overscan-bottom else window.overscan-right
. viewport-main = larger-virtual(0vcoord, raw-viewport-main)
. viewport-cross = larger-virtual(0vcoord, raw-viewport-cross)
. leading = larger-virtual(0vcoord, raw-leading)
. trailing = larger-virtual(0vcoord, raw-trailing)

. spare = if gap != null then 1vcoord else 0vcoord
. known-length = checked-virtual-product(checked-virtual-sum(known-count, spare), item-length)
. available-slots = checked-virtual-sum(available-count, spare)
. available-length = checked-virtual-product(available-slots, item-length)
. max-main = larger-virtual(0vcoord, available-length - viewport-main)
. resolved-main = smaller-virtual(max-main, larger-virtual(0vcoord, scroll-main))

. frame-cross = larger-virtual(0vcoord, raw-frame-cross)
. cross-length = larger-virtual(fixed-cross-length ?? frame-cross, frame-cross)
. max-cross = larger-virtual(0vcoord, cross-length - viewport-cross)
. resolved-cross = smaller-virtual(max-cross, larger-virtual(0vcoord, scroll-cross))

. window-start = larger-virtual(0vcoord, resolved-main - leading)
. window-end = checked-virtual-sum(checked-virtual-sum(resolved-main, viewport-main), trailing)
. first-index = window-start / item-length
. last-index = window-end / item-length
if window-end % item-length != 0vcoord
    last-index += 1vcoord
last-index = smaller-virtual(last-index, available-slots)

. slot = first-index
while slot < last-index
    if gap == null || slot != gap
        . index = if gap != null && slot > gap then slot - 1vcoord else slot
        . main = checked-virtual-product(slot, item-length)
        . address = domain.address-at(index)
        if is-vertical
            window.place(index, address, 0vcoord, main, cross-length, item-length)
        else
            window.place(index, address, main, 0vcoord, item-length, cross-length)
    slot += 1vcoord

. estimated-length VirtualCoord?
if domain.estimated-count
    . estimated-count = larger-virtual(0vcoord, domain.estimated-count!)
    . estimated-slots = checked-virtual-sum(estimated-count, spare)
    estimated-length = checked-virtual-product(estimated-slots, item-length)

if is-vertical
    window.resolved-scroll-x = resolved-cross
    window.resolved-scroll-y = resolved-main
    window.known-width = cross-length
    window.estimated-width = cross-length
    window.is-width-final = true
    window.known-height = known-length
    window.estimated-height = estimated-length
    window.is-height-final = domain.is-final
else
    window.resolved-scroll-x = resolved-main
    window.resolved-scroll-y = resolved-cross
    window.known-width = known-length
    window.estimated-width = estimated-length
    window.is-width-final = domain.is-final
    window.known-height = cross-length
    window.estimated-height = cross-length
    window.is-height-final = true

━━━━━━━━━━━━━━━━━━━━
_ do fixed-rect-for-address VirtualRect?
    - address I64
    - domain VirtualSequenceDomain
    - frame VirtualSize
    - is-vertical Bool
    - item-length VirtualCoord
    - fixed-cross-length VirtualCoord?
    - gap VirtualCoord? = null

. index = domain.index-of(address)
=? if !index
. slot = if gap != null && index >= gap then index + 1vcoord else index
. main = checked-virtual-product(slot, item-length)
. raw-frame-cross = if is-vertical then frame.width else frame.height
. frame-cross = larger-virtual(0vcoord, raw-frame-cross)
. cross-length = larger-virtual(fixed-cross-length ?? frame-cross, frame-cross)
=? VirtualRect(0vcoord, main, cross-length, item-length) if is-vertical
= VirtualRect(main, 0vcoord, item-length, cross-length)

━━━━━━━━━━━━━━━━━━━━
_ checked-virtual-product VirtualCoord
    - left VirtualCoord
    - right VirtualCoord

?! Panic("Virtual extent overflow")
    if left < 0vcoord || right < 0vcoord || (right != 0vcoord && left > VirtualCoord.max / right)

left * right

━━━━━━━━━━━━━━━━━━━━
_ checked-virtual-sum VirtualCoord
    - left VirtualCoord
    - right VirtualCoord

?! Panic("Virtual extent overflow")
    if left < 0vcoord || right < 0vcoord || left > VirtualCoord.max - right

left + right

━━━━━━━━━━━━━━━━━━━━
_ larger-virtual
    - left VirtualCoord
    - right VirtualCoord

if left > right then left else right

━━━━━━━━━━━━━━━━━━━━
_ smaller-virtual
    - left VirtualCoord
    - right VirtualCoord

if left < right then left else right
