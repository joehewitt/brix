────────────────────
+ do sticky-margin
    - address I64
    - domain VirtualSequenceDomain
    - window VirtualWindow

headers.clear()
rows.sticky-headers(address, headers)
. margin = 0vcoord
for header in headers
    if header != address
        . rect = inner.rect-for-address(header, domain, window)
        if rect
            margin += rect.height
= margin

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ do collect-stuck
    - window VirtualWindow
    - domain VirtualSequenceDomain
    - line VirtualCoord

stuck.clear()
stuck-rects.clear()
stuck-pins.clear()
. bottom = line
. reach = line
. carries = true
while true
    . probe = virtual-window-address-at(window, reach)
    =? if probe == null
    headers.clear()
    rows.sticky-headers(probe, headers)
    =? if headers.length <= stuck.length || !extends-stuck()
    . header = headers[stuck.length]
    . rect = inner.rect-for-address(header, domain, window)
    =? if !rect
    . limit = window.known-height
    . last = inner.rect-for-address(rows.sticky-section-last(header), domain, window)
    if last
        limit = last.y + last.height
    . pushed = limit - rect.height
    . y = larger-virtual(rect.y, smaller-virtual(bottom, pushed))
    carries = carries && bottom < pushed && rect.y <= bottom
    stuck += header
    stuck-rects += VirtualRect(rect.x, y, rect.width, rect.height)
    stuck-pins += carries
    bottom = y + rect.height
    reach += rect.height

────────────────────
_ do extends-stuck

for index in 0 .. < stuck.length
    =? false if headers[index] != stuck[index]
= true

────────────────────
_ do stick
    - window VirtualWindow
    - domain VirtualSequenceDomain
    - depth Index
    - header I64
    - rect VirtualRect
    - is-pinned Bool

. index = domain.index-of(header)
=? if index == null
. position Index = 0
while position < window.placement-count && window.placements[position].placement-id < index
    position += 1
if position == window.placement-count || window.placements[position].placement-id != index
    window.insert-placement(position, index, header, rect.x, rect.y, rect.width, rect.height)
. placement = window.placements[position]
placement.y = rect.y
placement.is-sticky = true
placement.is-pinned = is-pinned
placement.sticky-depth = depth

━━━━━━━━━━━━━━━━━━━━
_ do virtual-window-address-at
    - window VirtualWindow
    - y VirtualCoord

for index in 0 .. < window.placement-count
    . placement = window.placements[index]
    =? placement.address if placement.y <= y && y < placement.y + placement.height
= null

