━━━━━━━━━━━━━━━━━━━━
+ Completion'Value

+ value Value?
+ is-finished = false
+ is-abandoned = false

_ task = Task()

────────────────────
+ do await Value?

if !is-finished
    . was-canceled = task.suspend()
    is-abandoned = was-canceled
    check-task-cancelation(was-canceled)
= value

────────────────────
+ do finish
    - result Value?

=? if is-abandoned
value = result
is-finished = true
task.resume-later()

