native

────────────────────
+ do await Payload?
    - mutex Mutex? = null

. task = Task()
. buf = Payload[1]
. did-post Bool
if mutex
    did-post = C:brixWaitForSemaphore(native, buf, Payload.size, mutex)
else
    did-post = C:brixWaitForSemaphore(native, buf, Payload.size, null)
check-task-cancelation(task.is-cancel-in-force)
if did-post
    = buf[0]

────────────────────
+ do post
    - value Payload

. task = Task()
C:brixPostSemaphore(native, &value, Payload.size)
check-task-cancelation(task.is-cancel-in-force)

