+ get native-pointer

native

────────────────────
+ do await Payload?
    - mutex Mutex? = null

. task = Task()
. buf = Payload[1]
. did-post Bool
if mutex
    did-post = C:yumiWaitForSemaphore(native, buf, Payload.size, mutex)
else
    did-post = C:yumiWaitForSemaphore(native, buf, Payload.size, null)
check-task-cancelation(task.is-canceled)
if did-post
    = buf[0]

────────────────────
+ do post
    - value Payload

. task = Task()
C:yumiPostSemaphore(native, &value, Payload.size)
check-task-cancelation(task.is-canceled)

