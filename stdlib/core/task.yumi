━━━━━━━━━━━━━━━━━━━━
+ Completion'Value

+ value Value?
+ is-finished = false
+ is-abandoned = false

_ waiters = List'U64()

────────────────────
+ do await Value?

=? value if is-finished
. task = Task()
waiters += task.handle
while !is-finished
    if task.suspend()
        if !is-finished && waiters.length == 1
            is-abandoned = true
        waiters -= task.handle
        check-task-cancelation(true)
= value

────────────────────
+ do finish
    - result Value?

value = result
is-finished = true
for waiter in waiters
    C:brixResumeTaskLater(waiter)
waiters.clear()

