────────────────────
_ do insert Atom @no-gc
    - source Byte[]
    - start Index
    - end Index
    - fingerprint U32

prepare-insert()
. atom = arena.copy-span(source, start, end) as Atom
append(atom, fingerprint)
= atom

────────────────────
_ do append @no-gc
    - atom Atom
    - fingerprint U32

. entry-data = entries.data
. fingerprint-data = fingerprints.data
. bucket-data = buckets.data
. bucket-count = buckets.length
. bucket = ((fingerprint as Size) /and/ (bucket-count - 1)) as Index
while bucket-data[bucket] != 0
    bucket = (bucket + 1) /and/ (bucket-count - 1)
entry-data[count] = atom
fingerprint-data[count] = fingerprint
bucket-data[bucket] = count + 1
count += 1

────────────────────
_ do prepare-insert @no-gc

?! Panic("AtomPool capacity overflow")
    if count == Size.max

if count + 1 > entries.length
    grow-entries()
if count + 1 > buckets.length * 3 / 4
    grow-buckets()

────────────────────
_ do grow-entries @no-gc

?! Panic("AtomPool entry capacity overflow")
    if entries.length > Size.max / 2

. new-capacity = entries.length * 2
. replacement-entries = Array'Atom(arena, new-capacity)
. replacement-fingerprints = Array'U32(arena, new-capacity)
. source-entries = entries.data
. source-fingerprints = fingerprints.data
. target-entries = replacement-entries.data
. target-fingerprints = replacement-fingerprints.data
for index in 0 .. < count
    target-entries[index] = source-entries[index]
    target-fingerprints[index] = source-fingerprints[index]
entries = replacement-entries
fingerprints = replacement-fingerprints

────────────────────
_ do grow-buckets @no-gc

?! Panic("AtomPool bucket capacity overflow")
    if buckets.length > Size.max / 2

. replacement = Array'Size(arena, buckets.length * 2)
. fingerprint-data = fingerprints.data
. bucket-data = replacement.data
. bucket-count = replacement.length
for index in 0 .. < count
    . bucket = ((fingerprint-data[index] as Size) /and/ (bucket-count - 1)) as Index
    while bucket-data[bucket] != 0
        bucket = (bucket + 1) /and/ (bucket-count - 1)
    bucket-data[bucket] = index + 1
buckets = replacement

━━━━━━━━━━━━━━━━━━━━
_ do atom-fingerprint U32 @no-heap @no-safepoint
    - text String

. bytes = text as Byte[]
. data = bytes.data
. fingerprint = 2166136261u32
for index in 0 .. < bytes.length
    fingerprint = atom-mix(fingerprint, data[index])
= fingerprint

━━━━━━━━━━━━━━━━━━━━
_ do atom-fingerprint U32 @no-heap @no-safepoint
    - source Char[]
    - start Index
    - end Index

. data = source.data
. fingerprint = 2166136261u32
for index in start .. < end
    . scalar = data[index] as U32
    if scalar < 128
        fingerprint = atom-mix(fingerprint, scalar)
    else if scalar < 2048
        fingerprint = atom-mix(fingerprint, 192 /or/ (scalar /rshift/ 6))
        fingerprint = atom-mix(fingerprint, 128 /or/ (scalar /and/ 63))
    else if scalar < 65536
        fingerprint = atom-mix(fingerprint, 224 /or/ (scalar /rshift/ 12))
        fingerprint = atom-mix(fingerprint, 128 /or/ ((scalar /rshift/ 6) /and/ 63))
        fingerprint = atom-mix(fingerprint, 128 /or/ (scalar /and/ 63))
    else
        fingerprint = atom-mix(fingerprint, 240 /or/ (scalar /rshift/ 18))
        fingerprint = atom-mix(fingerprint, 128 /or/ ((scalar /rshift/ 12) /and/ 63))
        fingerprint = atom-mix(fingerprint, 128 /or/ ((scalar /rshift/ 6) /and/ 63))
        fingerprint = atom-mix(fingerprint, 128 /or/ (scalar /and/ 63))
= fingerprint

━━━━━━━━━━━━━━━━━━━━
_ atom-mix U32 @no-heap @no-safepoint
    - fingerprint U32
    - byte U32

(fingerprint /xor/ byte) * 16777619

━━━━━━━━━━━━━━━━━━━━
_ do atom-span-equals Bool @no-heap @no-safepoint
    - text String
    - source Char[]
    - start Index
    - end Index

=? false if text.length != end - start

. bytes = text as Byte[]
. source-data = source.data
. byte-data = bytes.data as CPointer'Char8
. byte-offset = 0
. result AtomStringChar

for index in start .. < end
    if C:yumiStringGetNextChar(byte-data + byte-offset, &result) != 0
        = false
    if result.char != source-data[index]
        = false
    byte-offset += result.byte-count as Size

= byte-offset == bytes.length

━━━━━━━━━━━━━━━━━━━━
_ do atom-byte-fingerprint U32 @no-heap @no-safepoint
    - source Byte[]
    - start Index
    - end Index

. data = source.data
. fingerprint = 2166136261u32
for index in start .. < end
    fingerprint = atom-mix(fingerprint, data[index])
= fingerprint

━━━━━━━━━━━━━━━━━━━━
_ do atom-bytes-equal Bool
    - text String
    - source Byte[]
    - start Index
    - end Index

. bytes = text as Byte[]
=? false if bytes.length != end - start
. held = bytes.data
. data = source.data
for offset in 0 .. < bytes.length
    =? false if held[offset] != data[start + offset]
= true
