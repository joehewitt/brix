────────────────────
+ do release @no-gc

if !released
    arena.release()
    released = true

────────────────────
_ do find Size @no-heap @no-safepoint
    - text String
    - fingerprint U32

. entry-data = entries.data
. fingerprint-data = fingerprints.data
. bucket-data = buckets.data
. bucket-count = buckets.length
. bucket = ((fingerprint as Size) /and/ (bucket-count - 1)) as Index
. entry-number = bucket-data[bucket]
while entry-number != 0
    . index = entry-number - 1
    if fingerprint-data[index] == fingerprint && entry-data[index].text == text
        = entry-number
    bucket = (bucket + 1) /and/ (bucket-count - 1)
    entry-number = bucket-data[bucket]
= 0

────────────────────
_ do find Size @no-heap @no-safepoint
    - source Char[]
    - start Index
    - end Index
    - fingerprint U32

. entry-data = entries.data
. fingerprint-data = fingerprints.data
. bucket-data = buckets.data
. bucket-count = buckets.length
. bucket = ((fingerprint as Size) /and/ (bucket-count - 1)) as Index
. entry-number = bucket-data[bucket]
while entry-number != 0
    . index = entry-number - 1
    if fingerprint-data[index] == fingerprint
        if atom-span-equals(entry-data[index].text, source, start, end)
            = entry-number
    bucket = (bucket + 1) /and/ (bucket-count - 1)
    entry-number = bucket-data[bucket]
= 0

────────────────────
_ do find-bytes Size
    - source Byte[]
    - start Index
    - end Index
    - fingerprint U32

. entry-data = entries.data
. fingerprint-data = fingerprints.data
. bucket-data = buckets.data
. bucket-count = buckets.length
. bucket = ((fingerprint as Size) /and/ (bucket-count - 1)) as Index
. entry-number = bucket-data[bucket]
while entry-number != 0
    . index = entry-number - 1
    if fingerprint-data[index] == fingerprint
        if atom-bytes-equal(entry-data[index].text, source, start, end)
            = entry-number
    bucket = (bucket + 1) /and/ (bucket-count - 1)
    entry-number = bucket-data[bucket]
= 0

────────────────────
_ do insert Atom @no-gc
    - text String
    - fingerprint U32

prepare-insert()
. atom = arena.copy-string(text) as Atom
append(atom, fingerprint)
= atom

