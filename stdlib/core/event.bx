(import ./core)
(import ./error)
(import ./function)
(import ./intrinsics)
(import ./list)
(import ./number)
(import ./range)
(import ./stream)
(import /BxGC/BxGC.h)
(blank)
(prop _ event-machine-publishing Size @task (= 0))
(prop _ event-machine-is-draining _ (= false))
(prop _ event-descriptor-heads _ (:= (call (of List (? EventLoweredDescriptor)))))
(prop _ event-bubbling-heads _ (:= (call (of List (? EventLoweredDescriptor)))))
(prop _ event-bubbling-counts _ (:= (call (of List Size))))
(prop _ event-machine-lanes _ (:= (call (of List EventMachineLane))))
(prop _ event-machine-deferrals _ (:= (call EventMachineDeferrals)))
(prop _ event-machine-dispatches _ (:= (call EventMachineDispatches)))
(prop _ event-no-route _ (:= (call EventNoRoute)))
(blank)
(type-line + EventGenerationKey (is (tuple (: index Index) (: generation U64))))
(type-line _ (of EventSlot Payload) (is (tuple (: sub (? (of Subscribable Payload))) (: g U64) (: prev Index) (: next Index) (: free Index))))
(type-line _ EventRouteFrame (is (tuple (: owner Pointer) (: root Pointer))))

(type + RoutedEvent (is Interface)
  (fn-expr + is-canceled Bool :get)
  (fn-expr + has-own-route Bool :get
    true
  )
  (fn-do + next-event-owner (? Pointer)
    (param current Pointer)
  )
)

(type + EventNode (is Interface)
  (fn-expr + event-parent (? EventNode) :get)
)

(fn-do + (of event-endpoint Payload) (of EventEndpoint Payload)
  (param owner Pointer)
  (param event-id Size)
  (let sidecar (call event-sidecar owner))
  (throw (call Panic "Illegal to access a closed event") (if (. sidecar is-closed)))
  (let existing (call (. sidecar find) event-id))
  (if existing
    (return (as existing (of EventEndpoint Payload)))
  )
  (blank)
  (let endpoint (call (of EventEndpoint Payload) event-id))
  (+= (. sidecar entries) endpoint)
  (probe-count event.endpoint.entries)
  (return endpoint)
)

(fn-do + (of event-adapter Payload) (of EventEndpoint Payload)
  (param owner Pointer)
  (param event-id Size)
  (let endpoint (call (of event-endpoint Payload) owner event-id))
  (if (not (. endpoint adapter-created))
    (= (. endpoint adapter-created) true)
    (probe-count event.adapters.created)
  )
  (return endpoint)
)

(fn-do + (of event-keyed-endpoint Payload) (of EventEndpoint Payload) (?! Error)
  (param owner Pointer)
  (param event-id Size)
  (param key-low U64)
  (param key-high U64)
  (param receiver-identity U64)
  (let index (call event-keyed-index owner event-id))
  (let existing (call (. index find-live) key-low key-high))
  (if existing
    (throw (call Error (str "Duplicate keyed event receiver for " key-low ":" key-high)) (if (!= (. existing receiver-identity) receiver-identity)))
    (return (as (. existing endpoint) (of EventEndpoint Payload)))
  )
  (blank)
  (let generation (call (. index allocate-generation)))
  (let endpoint (call (of EventEndpoint Payload) event-id))
  (let address
    (block
      (call KeyedEventAddress key-low key-high receiver-identity generation endpoint index)
    )
  )
  (call (. index prepare-bucket-insert))
  (+= (. index addresses) address)
  (call (. index insert-bucket) address)
  (+= (. index live-address-count) 1)
  (call (. endpoint bind-keyed-address) address generation)
  (probe-count event.key-index.updates)
  (probe-count event.endpoint.entries)
  (return endpoint)
)

(fn-do + (of event-keyed-adapter Payload) (of EventEndpoint Payload) (?! Error)
  (param owner Pointer)
  (param event-id Size)
  (param key-low U64)
  (param key-high U64)
  (param receiver-identity U64)
  (let endpoint
    (block
      (call (of event-keyed-endpoint Payload) owner event-id key-low key-high receiver-identity)
    )
  )
  (if (not (. endpoint adapter-created))
    (= (. endpoint adapter-created) true)
    (probe-count event.adapters.created)
  )
  (return endpoint)
)

(fn-expr + (of event-keyed-interest-generation Payload) U64
  (param owner Pointer)
  (param event-id Size)
  (param key-low U64)
  (param key-high U64)
  (case? (?? (?. sidecar is-closed) false)
    0
  )
  (case? (not sidecar)
    0
  )
  (case? (not entry)
    0
  )
  (case? (not address)
    0
  )
  (case? (and (not (. endpoint has-interest)) (not event-machine-is-draining))
    0
  )
  (default
    (call (. endpoint event-address-generation))
  )
  (where
    (lazy sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
    (lazy entry (call (. sidecar find) event-id))
    (lazy index (as entry KeyedEventIndex))
    (lazy address (call (. index find-live) key-low key-high))
    (lazy endpoint (as (. address endpoint) (of EventEndpoint Payload)))
  )
)

(fn-do + (of event-keyed-rekey Payload) _ (?! Error)
  (param owner Pointer)
  (param event-id Size)
  (param old-key-low U64)
  (param old-key-high U64)
  (param new-key-low U64)
  (param new-key-high U64)
  (param receiver-identity U64)
  (let sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
  (throw (call Error "Keyed event address is not claimed") (if (or (not sidecar) (. sidecar is-closed))))
  (let entry (call (. sidecar find) event-id))
  (throw (call Error "Keyed event address is not claimed") (if (not entry)))
  (let index (as entry KeyedEventIndex))
  (let address (call (. index find-live) old-key-low old-key-high))
  (throw (call Error "Keyed event address is not claimed by this receiver") (if (or (not address) (!= (. address receiver-identity) receiver-identity))))
  (return-if (if (and (== old-key-low new-key-low) (== old-key-high new-key-high))))
  (blank)
  (let collision (call (. index find-live) new-key-low new-key-high))
  (throw (call Error (str "Duplicate keyed event receiver for " new-key-low ":" new-key-high)) (if collision))
  (blank)
  (call (. index prepare-bucket-insert))
  (let generation (call (. index allocate-generation)))
  (= (. address key-low) new-key-low)
  (= (. address key-high) new-key-high)
  (= (. address generation) generation)
  (call (. index insert-bucket) address)
  (let endpoint (as (. address endpoint) (of EventEndpoint Payload)))
  (call (. endpoint update-keyed-generation) generation)
  (probe-count event.key-index.updates)
)

(fn-do + (of event-keyed-release Payload) _
  (param owner Pointer)
  (param event-id Size)
  (param key-low U64)
  (param key-high U64)
  (param receiver-identity U64)
  (let sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
  (return-if (if (or (not sidecar) (. sidecar is-closed))))
  (let entry (call (. sidecar find) event-id))
  (return-if (if (not entry)))
  (let index (as entry KeyedEventIndex))
  (let address (call (. index find-live) key-low key-high))
  (return-if (if (or (not address) (!= (. address receiver-identity) receiver-identity))))
  (call (. address endpoint close))
)

(fn-do + (of event-publish-keyed Payload) _
  (param owner Pointer)
  (param event-id Size)
  (param key-low U64)
  (param key-high U64)
  (param expected-generation U64)
  (param payload Payload)
  (+= event-machine-publishing 1)
  (if event-machine-is-draining
    (let root (call event-machine-hold owner))
    (let dispatch Doer
      (=> () :do
        (block
          (call event-dispatch-keyed owner event-id key-low key-high expected-generation payload
            (block
              (:handlers false)
            )
          )
          (call event-machine-release root)
        )
      )
    )
    (call event-machine-defer dispatch)
    (call event-dispatch-keyed owner event-id key-low key-high expected-generation payload
      (block
        (:machines false)
      )
    )
    (else
      (call event-dispatch-keyed owner event-id key-low key-high expected-generation payload)
    )
  )
  (call event-machine-finish-publish)
)

(fn-expr + event-has-interest Bool
  (param owner Pointer)
  (param event-id Size)
  (case? (?? (?. sidecar is-closed) false)
    false
  )
  (case? event-machine-is-draining
    true
  )
  (case? (call event-has-lowered-interest owner event-id)
    true
  )
  (default
    (?? (?. entry has-interest) false)
  )
  (where
    (lazy sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
    (lazy entry (call (?. sidecar find) event-id))
  )
)

(fn-expr + event-has-route-interest Bool
  (param owner Pointer)
  (param event-id Size)
  (case? (?? (?. sidecar is-closed) false)
    false
  )
  (case? (call event-has-bubbling-interest event-id)
    true
  )
  (default
    (call event-has-interest owner event-id)
  )
  (where
    (lazy sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
  )
)

(fn-do + (of event-publish Payload) _
  (param owner Pointer)
  (param event-id Size)
  (param payload Payload)
  (+= event-machine-publishing 1)
  (if event-machine-is-draining
    (let root (call event-machine-hold owner))
    (let dispatch Doer
      (=> () :do
        (block
          (call event-dispatch owner event-id payload (:handlers false))
          (call event-machine-release root)
        )
      )
    )
    (call event-machine-defer dispatch)
    (call event-dispatch owner event-id payload (:machines false))
    (else
      (call event-dispatch owner event-id payload)
    )
  )
  (call event-machine-finish-publish)
)

(fn-do + event-close-owner _
  (param owner Pointer)
  (let sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
  (if sidecar
    (call (. sidecar close))
    (else-if (call event-has-lowered-owner owner)
      (call (. (call event-sidecar owner) close))
    )
  )
)

(fn-do + event-own-machine _
  (param owner Pointer)
  (param stop EventMachineStop)
  ; Keeps what stops a machine a property of an object holds, which the object's `close` runs
  ; (`event-stop-machines`).
  (let sidecar (call event-sidecar owner))
  (if (not (. sidecar machine-stops))
    (= (. sidecar machine-stops) (call (of List EventMachineStop)))
  )
  (+= (!! (. sidecar machine-stops)) stop)
)

(fn-do + event-stop-machines _
  (param owner Pointer)
  ; Stops each machine the properties of an object hold, the last started first, and once: each
  ; exits its active cases, running their `do finally`, and drops what it subscribed. Then no
  ; transition on the object's events, which the class's table may run, fires again, while the
  ; events stay open for the body of `close` to publish (`event-close-stopped`).
  (let sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
  (return-if (if (not sidecar)))
  (let stops (. sidecar machine-stops))
  (return-if (if (not stops)))
  (= (. sidecar machine-stops) null)
  (while (!= (. stops length) 0)
    (let stop (call (. stops pop)))
    (call stop)
  )
  (= (. sidecar machines-stopped) true)
)

(fn-do + event-close-stopped _
  (param owner Pointer)
  (let sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
  (return-if (if (or (not sidecar) (not (. sidecar machines-stopped)))))
  (call (. sidecar close))
)

(type _ EventMachineLane (is Interface)
  (fn-do + run-next _ (?! Error))
)

(type _ EventMachineDeferrals
  (implements EventMachineLane)
  (prop + doers (list Doer))
  (blank)
  (prop _ next Index (= 0))
  (fn-do + run-next _ (?! Error)
    (let transition ([] doers next))
    (+= next 1)
    (if (== next (. doers length))
      (call (. doers clear))
      (= next 0)
    )
    (call transition)
  )
)

(type _ EventMachineDispatches
  (implements EventMachineLane)
  (prop + dispatches (list Doer))
  (prop + resolved (list EventMachineLane))
  (prop + is-resolving _ (= false))
  (blank)
  (prop _ next Index (= 0))
  (fn-do + run-next _ (?! Error)
    (let dispatch ([] dispatches next))
    (+= next 1)
    (if (== next (. dispatches length))
      (call (. dispatches clear))
      (= next 0)
    )
    (= is-resolving true)
    (call dispatch
      (block
        (on-error (: error Error)
          (call unhandled-error error)
        )
      )
    )
    (= is-resolving false)
    (let index Index 0)
    (finally
      (if index
        (call (. resolved remove) 0 index)
      )
    )
    (while (< index (. resolved length))
      (let lane ([] resolved index))
      (+= index 1)
      (call (. lane run-next)
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
    )
    (call (. resolved clear))
    (= index 0)
  )
)

(type _ (of EventSubscription Payload)
  (implements (of Subscribable Payload))
  (prop _ subscriber (of Subscriber Payload))
  (prop _ arrival-only Bool)
  (fn-do _ This _
    (param subscriber _)
    (param arrival-only _ (= false))
  )
  (fn-expr + event-arrival-only Bool :get
    arrival-only
  )
  (fn-expr + (infix this == (param other (of Subscriber Payload))) _
    (== subscriber other)
  )
  (fn-do + this _
    (param payload Payload)
    (param broadcaster (of Broadcastable Payload))
    (probe-count event.handlers.sync)
    (call subscriber payload broadcaster
      (block
        (on-error (: error Error)
          (call unhandled-error error)
        )
      )
    )
  )
  (fn-do + unsubscribe _)
)

(type _ (of EventMachinePort Payload)
  (implements (of Subscribable Payload))
  (implements EventMachineLane)
  (prop _ handler (of Subscriber Payload))
  (prop _ broadcaster (of Broadcastable Payload))
  (prop _ payloads (list Payload))
  (prop _ next Index (= 0))
  (prop _ stale Size (= 0))
  (prop _ is-subscribed _ (= false))
  (prop _ address (? KeyedEventAddress))
  (prop _ address-generation U64)
  (fn-do _ This _
    (param handler _)
    (param broadcaster _)
  )
  (fn-do + run-next _ (?! Error)
    (if stale
      (-= stale 1)
      (return)
    )
    (let payload ([] payloads next))
    (+= next 1)
    (if (== next (. payloads length))
      (call (. payloads clear))
      (= next 0)
    )
    (return-if (if (and address (not (call (. address is-generation-live) address-generation)))))
    (call handler payload broadcaster)
  )
  (fn-expr + event-is-machine Bool :get
    true
  )
  (fn-do + this _
    (param payload Payload)
    (param broadcaster (of Broadcastable Payload))
    (call post payload)
  )
  (fn-do + unsubscribe _
    (= is-subscribed false)
  )
  (fn-do + event-bind-address _
    (param raw-address Pointer)
    (param generation U64)
    (let bound (call (of gc-object-from-pointer KeyedEventAddress) raw-address))
    (if (and address (or (!= (as address Pointer) (as bound Pointer)) (!= address-generation generation)))
      (call drop-pending)
    )
    (= address bound)
    (= address-generation generation)
  )
  (fn-do _ post _
    (param payload Payload)
    (probe-count event.handlers.machine-enqueued)
    (+= payloads payload)
    (call event-machine-schedule this)
  )
  (fn-do _ drop-pending _
    (return-if (if (not payloads)))
    (+= stale (- (. payloads length) next))
    (call (. payloads clear))
    (= next 0)
  )
  (fn-do _ attach _
    (param source (of Broadcastable Payload))
    (call detach)
    (= broadcaster source)
    (call (. source subscribe) (as this (of Subscribable Payload))
      (block
        (on-error (: error Error)
          (call unhandled-error error)
          (return)
        )
      )
    )
    (= is-subscribed true)
  )
  (fn-do _ detach _
    (if is-subscribed
      (call (. broadcaster unsubscribe) (as this (of Subscribable Payload))
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
      (= is-subscribed false)
    )
    (= address null)
    (call drop-pending)
  )
)

(type _ EventLoweredOwnerMatcher (is (c-fn-type Bool (param owner Pointer))))

(type _ EventLoweredDescriptor
  (prop + matcher EventLoweredOwnerMatcher)
  (prop + callback Pointer)
  (prop + order Size)
  (prop + is-machine Bool)
  (prop + next (? EventLoweredDescriptor))
  (fn-do _ This _
    (param matcher _)
    (param callback _)
    (param order _)
    (param is-machine _)
    (param next _ (= null))
  )
)

(type _ EventNoRoute
  (implements RoutedEvent)
  (fn-expr + is-canceled Bool :get
    false
  )
  (fn-do + next-event-owner (? Pointer)
    (param current Pointer)
    (return null)
  )
)

(type _ EventEntry
  (prop + event-id Size)
  (prop + live-count Size (= 0))
  (prop + bubbling-live-count Size (= 0))
  (prop + is-closed _ (= false))
  (blank)
  (prop _ adapter-created _ (= false))
  (fn-do _ This _
    (param event-id _)
  )
  (fn-expr + has-interest Bool :get
    (and (> live-count 0) (not is-closed))
  )
  (fn-expr + has-bubbling-interest Bool :get
    (and (> bubbling-live-count 0) (not is-closed))
  )
  (fn-do + close _
    (= is-closed true)
    (= live-count 0)
    (call event-bubbling-adjust event-id (- bubbling-live-count))
    (= bubbling-live-count 0)
  )
)

(type _ KeyedEventAddress
  (prop + key-low U64)
  (prop + key-high U64)
  (prop + receiver-identity U64)
  (prop + generation U64)
  (prop + live Bool (= true))
  (prop + endpoint EventEntry)
  (prop + index KeyedEventIndex)
  (fn-do _ This _
    (param key-low _)
    (param key-high _)
    (param receiver-identity _)
    (param generation _)
    (param endpoint _)
    (param index _)
  )
  (fn-expr _ is-generation-live Bool
    (param expected U64)
    (and live (== generation expected))
  )
)

(type _ KeyedEventIndex (is EventEntry)
  (prop _ addresses (list KeyedEventAddress))
  (prop _ buckets (list (? KeyedEventAddress)))
  (prop _ bucket-entry-count Size)
  (prop _ live-address-count Size)
  (prop _ next-address-generation U64)
  (fn-do _ This _
    (param event-id _)
  )
  (fn-do _ allocate-generation U64
    (+= next-address-generation 1)
    (throw (call Panic "Event address generation overflow") (if (not next-address-generation)))
    (return next-address-generation)
  )
  (fn-do _ find-live (? KeyedEventAddress)
    (param key-low U64)
    (param key-high U64)
    (return-if (if (not buckets)))
    (let capacity (. buckets length))
    (let slot (call keyed-event-bucket key-low key-high capacity))
    (for (in attempt (..< 0 capacity))
      (let address ([] buckets slot))
      (return-if (if (not address)))
      (if (and (. address live) (== (. address key-low) key-low) (== (. address key-high) key-high))
        (return address)
      )
      (= slot (% (+ slot 1) capacity))
    )
  )
  (fn-do _ prepare-bucket-insert _
    (if (not buckets)
      (call rebuild-buckets 256)
      (else-if (>= (* (+ bucket-entry-count 1) 4) (* (. buckets length) 3))
        (let capacity (. buckets length))
        (if (>= (* (+ live-address-count 1) 4) (* capacity 3))
          (*= capacity 2)
        )
        (call rebuild-buckets capacity)
      )
    )
  )
  (fn-do _ insert-bucket _
    (param address KeyedEventAddress)
    (let capacity (. buckets length))
    (let slot (call keyed-event-bucket (. address key-low) (. address key-high) capacity))
    (for (in attempt (..< 0 capacity))
      (if (not ([] buckets slot))
        (= ([] buckets slot) address)
        (+= bucket-entry-count 1)
        (return)
      )
      (= slot (% (+ slot 1) capacity))
    )
    (throw (call Panic "Keyed event index is full"))
  )
  (fn-do _ rebuild-buckets _
    (param capacity Size)
    (let next (list (? KeyedEventAddress)))
    (call (. next reserve) capacity)
    (for (in index (..< 0 capacity))
      (+= next null)
    )
    (= buckets next)
    (= bucket-entry-count 0)
    (let live-addresses (list KeyedEventAddress))
    (for (in address addresses)
      (if (. address live)
        (call insert-bucket address)
        (+= live-addresses address)
      )
    )
    (= addresses live-addresses)
  )
  (fn-do _ release _
    (param address KeyedEventAddress)
    (return-if (if (not (. address live))))
    (= (. address live) false)
    (= (. address generation) (call allocate-generation))
    (-= live-address-count 1)
    (probe-count event.key-index.updates)
  )
  (fn-do _ close _
    (return-if (if is-closed))
    (= is-closed true)
    (for (in address addresses)
      (if (. address live)
        (= (. address live) false)
        (= (. address generation) (call allocate-generation))
        (call (. address endpoint close))
      )
    )
    (call (. addresses clear))
    (if buckets
      (call (. buckets clear))
    )
    (= live-count 0)
    (call event-bubbling-adjust event-id (- bubbling-live-count))
    (= bubbling-live-count 0)
    (= bucket-entry-count 0)
    (= live-address-count 0)
  )
)

(type _ (of EventEndpoint Payload) (is EventEntry)
  (implements (of Broadcastable Payload))
  (implements Closable)
  (prop _ slots (list (of EventSlot Payload)))
  (prop _ active-slots (list Index))
  (prop _ keyed-address (? KeyedEventAddress))
  (prop _ keyed-generation U64)
  (fn-do _ This _
    (param event-id _)
  )
  (fn-do + close _
    (return-if (if is-closed))
    (call release-keyed-address)
    (= is-closed true)
    (blank)
    (for (in entry slots)
      (if (. entry sub)
        (let subscription (. entry sub))
        (call (. subscription unsubscribe))
      )
    )
    (call (. slots clear))
    (call (. active-slots clear))
    (= live-count 0)
    (call event-bubbling-adjust event-id (- bubbling-live-count))
    (= bubbling-live-count 0)
  )
  (fn-do + subscribe _
    (param subscriber (of Subscriber Payload))
    (call link (call (of EventSubscription Payload) subscriber))
  )
  (fn-do + unsubscribe _
    (param subscriber (of Subscriber Payload))
    (return-if (if (not slots)))
    (blank)
    (if active-slots
      (let active-slot ([] active-slots (- (. active-slots length) 1)))
      (let active-subscription (. ([] slots active-slot) sub))
      (if (and active-subscription (== active-subscription subscriber))
        (call unlink active-slot active-subscription)
        (return)
      )
    )
    (blank)
    (let slot (. ([] slots 0) next))
    (while slot
      (let entry ([] slots slot))
      (if (and (. entry sub) (== (. entry sub) subscriber))
        (call unlink slot (. entry sub))
        (return)
      )
      (= slot (. entry next))
    )
  )
  (fn-do + subscribe _
    (param subscriber (of Subscribable Payload))
    (call link subscriber)
  )
  (fn-do + unsubscribe _
    (param subscriber (of Subscribable Payload))
    (return-if (if (not slots)))
    (blank)
    (let slot (. ([] slots 0) next))
    (while slot
      (let entry ([] slots slot))
      (if (and (. entry sub) (== (as (. entry sub) Pointer) (as subscriber Pointer)))
        (call unlink slot subscriber)
        (return)
      )
      (= slot (. entry next))
    )
  )
  (fn-do + dispatch _
    (param payload Payload)
    (param handlers _ (= true))
    (param machines _ (= true))
    (return-if (if (or is-closed (not slots) (not live-count))))
    (blank)
    (let boundary (. ([] slots 0) g))
    (let address-boundary (call event-address-generation))
    (let reaches-all (and handlers machines))
    (let slot (. ([] slots 0) next))
    (while slot
      (if (or is-closed (and address-boundary (!= (call event-address-generation) address-boundary)))
        (break)
      )
      (blank)
      (let entry ([] slots slot))
      (if (. entry sub)
        (if (> (. entry g) boundary)
          (break)
        )
        (let subscription (. entry sub))
        (if (or reaches-all (call event-dispatch-reaches (. subscription event-is-machine) handlers machines))
          (+= active-slots slot)
          (call subscription payload this)
          (if active-slots
            (call (. active-slots pop))
          )
        )
      )
      (= slot (. entry next))
    )
  )
  (fn-do + (of dispatch-routed Route) _
    (param payload Payload)
    (param routed Route)
    (param is-target Bool)
    (param handlers _ (= true))
    (param machines _ (= true))
    (constraint is Route RoutedEvent)
    (return-if (if (or is-closed (not slots) (not live-count))))
    (blank)
    (let boundary (. ([] slots 0) g))
    (let reaches-all (and handlers machines))
    (let slot (. ([] slots 0) next))
    (while slot
      (if (or is-closed (and handlers (. routed is-canceled)))
        (break)
      )
      (blank)
      (let entry ([] slots slot))
      (if (. entry sub)
        (if (> (. entry g) boundary)
          (break)
        )
        (let subscription (. entry sub))
        (let reaches
          (block
            (or reaches-all (call event-dispatch-reaches (. subscription event-is-machine) handlers machines))
          )
        )
        (if (and reaches (or is-target (not (. subscription event-arrival-only))))
          (+= active-slots slot)
          (call subscription payload this)
          (if active-slots
            (call (. active-slots pop))
          )
        )
      )
      (= slot (. entry next))
    )
  )
  (fn-do _ bind-keyed-address _
    (param address KeyedEventAddress)
    (param generation U64)
    (= keyed-address address)
    (= keyed-generation generation)
  )
  (fn-do _ update-keyed-generation _
    (param generation U64)
    (= keyed-generation generation)
    (if keyed-address
      (for (in entry slots)
        (if (. entry sub)
          (let subscription (. entry sub))
          (call (. subscription event-bind-address) (as (!! keyed-address) Pointer) generation)
        )
      )
    )
  )
  (fn-expr _ event-address-generation U64
    (case? (not keyed-address)
      0
    )
    (case? (not (call (. address is-generation-live) keyed-generation))
      0
    )
    (case? (!= (as (. address endpoint) Pointer) (as this Pointer))
      0
    )
    (default
      keyed-generation
    )
    (where
      (lazy address keyed-address)
    )
  )
  (fn-do _ release-keyed-address _
    (return-if (if (not keyed-address)))
    (let address keyed-address)
    (if (call (. address is-generation-live) keyed-generation)
      (call (. address index release) address)
    )
  )
  (fn-do _ link _
    (param subscription (of Subscribable Payload))
    (throw (call Panic "Illegal to subscribe to a closed event") (if is-closed))
    (blank)
    (if keyed-address
      (call (. subscription event-bind-address) (as keyed-address Pointer) keyed-generation)
    )
    (blank)
    (if (not slots)
      (+= slots (tuple null 0 0 0 0))
    )
    (blank)
    (let sentinel ([] slots 0))
    (let head (. sentinel next))
    (let tail (. sentinel prev))
    (let next-free (. sentinel free))
    (let generation (+ (. sentinel g) 1))
    (throw (call Panic "Event subscription generation overflow") (if (not generation)))
    (blank)
    (let slot Index 0)
    (if (and (. sentinel free) (not active-slots))
      (= slot (. sentinel free))
      (= next-free (. ([] slots slot) free))
      (else
        (= slot (. slots length))
        (+= slots (tuple null 0 0 0 0))
      )
    )
    (blank)
    (= ([] slots slot) (tuple subscription generation tail 0 0))
    (if tail
      (let tail-entry ([] slots tail))
      (= ([] slots tail)
        (block
          (tuple (. tail-entry sub) (. tail-entry g) (. tail-entry prev) slot (. tail-entry free))
        )
      )
      (else
        (= head slot)
      )
    )
    (blank)
    (= ([] slots 0) (tuple null generation slot head next-free))
    (+= live-count 1)
    (if (not (. subscription event-arrival-only))
      (+= bubbling-live-count 1)
      (call event-bubbling-adjust event-id 1)
    )
    (probe-count event.subscriptions.sidecar)
  )
  (fn-do _ unlink _
    (param slot Index)
    (param subscription (of Subscribable Payload))
    (return-if (if (or (not slots) (not slot) (>= slot (. slots length)))))
    (blank)
    (let entry ([] slots slot))
    (return-if (if (or (not (. entry sub)) (!= (as (. entry sub) Pointer) (as subscription Pointer)))))
    (blank)
    (let sentinel ([] slots 0))
    (let head (. sentinel next))
    (let tail (. sentinel prev))
    (if (. entry prev)
      (let previous ([] slots (. entry prev)))
      (= ([] slots (. entry prev))
        (block
          (tuple (. previous sub) (. previous g) (. previous prev) (. entry next) (. previous free))
        )
      )
      (else
        (= head (. entry next))
      )
    )
    (blank)
    (if (. entry next)
      (let next ([] slots (. entry next)))
      (= ([] slots (. entry next))
        (block
          (tuple (. next sub) (. next g) (. entry prev) (. next next) (. next free))
        )
      )
      (else
        (= tail (. entry prev))
      )
    )
    (blank)
    (= ([] slots slot) (tuple null 0 (. entry prev) (. entry next) (. sentinel free)))
    (= ([] slots 0) (tuple null (. sentinel g) tail head slot))
    (-= live-count 1)
    (if (not (. subscription event-arrival-only))
      (-= bubbling-live-count 1)
      (call event-bubbling-adjust event-id -1)
    )
    (call (. subscription unsubscribe))
  )
)

(type _ EventSidecar
  (prop _ entries (list EventEntry))
  (prop _ machine-stops (? (of List EventMachineStop)))
  (prop _ machines-stopped _ (= false))
  (prop _ is-closed _ (= false))
  (fn-do _ find (? EventEntry)
    (param event-id Size)
    (for (in entry entries)
      (if (== (. entry event-id) event-id)
        (return entry)
      )
    )
  )
  (fn-do _ close _
    (return-if (if is-closed))
    (= is-closed true)
    (for (in entry entries)
      (call (. entry close))
    )
  )
)

(type _ EventMachineStop (is (fn-type Void)))

(fn-do _ event-machine-drain _
  (= event-machine-is-draining true)
  (let index Index 0)
  (finally
    (if event-machine-is-draining
      (= event-machine-is-draining false)
      (call (. event-machine-lanes remove) 0 index)
    )
  )
  (while (< index (. event-machine-lanes length))
    (let lane ([] event-machine-lanes index))
    (+= index 1)
    (call (. lane run-next)
      (block
        (on-error (: error Error)
          (call unhandled-error error)
        )
      )
    )
  )
  (call (. event-machine-lanes clear))
  (= event-machine-is-draining false)
)

(fn-do _ event-machine-schedule _
  (param lane EventMachineLane)
  (if (. event-machine-dispatches is-resolving)
    (+= (. event-machine-dispatches resolved) lane)
    (else
      (+= event-machine-lanes lane)
      (if (and (not event-machine-publishing) (not event-machine-is-draining))
        (call event-machine-drain)
      )
    )
  )
)

(fn-do _ event-machine-defer _
  (param dispatch Doer)
  (+= (. event-machine-dispatches dispatches) dispatch)
  (call event-machine-schedule event-machine-dispatches)
)

(fn-do _ event-machine-hold Pointer
  (param owner Pointer)
  (return (call C:brixGCAddRoot owner))
)

(fn-do _ event-machine-release _
  (param root Pointer)
  (call C:brixGCRemoveRoot root)
)

(fn-expr _ event-dispatch-reaches Bool
  (param is-machine Bool)
  (param handlers Bool)
  (param machines Bool)
  (if-expr is-machine machines handlers)
)

(fn-do _ (of event-machine-enqueue Payload) _
  (param subscriber (of Subscriber Payload))
  (param payload Payload)
  (param broadcaster (of Broadcastable Payload))
  (let transition Doer
    (=> () :do
      (block
        (call subscriber payload broadcaster)
      )
    )
  )
  (+= (. event-machine-deferrals doers) transition)
  (call event-machine-schedule event-machine-deferrals)
)

(fn-do _ event-machine-settle-route _
  (return-if (if (or (!= event-machine-publishing 1) event-machine-is-draining (not event-machine-lanes))))
  (call event-machine-drain)
)

(fn-do _ event-machine-finish-publish _
  (-= event-machine-publishing 1)
  (if (and (not event-machine-publishing) (not event-machine-is-draining) event-machine-lanes)
    (call event-machine-drain)
  )
)

(fn-expr _ (of event-subscription Payload) (of Subscribable Payload)
  (param subscriber (of Subscriber Payload))
  (param arrival-only _ (= false))
  (call (of EventSubscription Payload) subscriber arrival-only)
)

(fn-expr _ (of event-machine-port Payload) (of EventMachinePort Payload)
  (param handler (of Subscriber Payload))
  (param broadcaster (of Broadcastable Payload))
  (call (of EventMachinePort Payload) handler broadcaster)
)

(fn-do _ (of event-machine-attach Payload) (of EventMachinePort Payload)
  (param port (? (of EventMachinePort Payload)))
  (param handler (of Subscriber Payload))
  (param broadcaster (of Broadcastable Payload))
  (let attached (?? port (call (of EventMachinePort Payload) handler broadcaster)))
  (call (. attached attach) broadcaster)
  (return attached)
)

(fn-do _ (of event-machine-detach Payload) _
  (param port (? (of EventMachinePort Payload)))
  (call (?. port detach))
)

(fn-do _ (of event-machine-post Payload) _
  (param port (of EventMachinePort Payload))
  (param payload Payload)
  (call (. port post) payload)
)

(fn-do _ event-register-lowered _
  (param event-id Size)
  (param matcher EventLoweredOwnerMatcher)
  (param callback Pointer)
  (param order Size)
  (param is-machine Bool)
  (call event-register-descriptor event-id matcher callback order is-machine false)
)

(fn-do _ event-register-lowered-arrival _
  (param event-id Size)
  (param matcher EventLoweredOwnerMatcher)
  (param callback Pointer)
  (param order Size)
  (param is-machine Bool)
  (call event-register-descriptor event-id matcher callback order is-machine true)
)

(fn-do _ event-register-descriptor _
  (param event-id Size)
  (param matcher EventLoweredOwnerMatcher)
  (param callback Pointer)
  (param order Size)
  (param is-machine Bool)
  (param arrival-only Bool)
  (if (not (call event-insert-descriptor event-descriptor-heads event-id matcher callback order is-machine))
    (return)
  )
  (if (not arrival-only)
    (let ignored
      (call event-insert-descriptor
        (block
          (arg event-bubbling-heads)
          (arg event-id)
          (arg matcher)
          (arg callback)
          (arg order)
          (arg is-machine)
        )
      )
    )
    (call event-bubbling-adjust event-id 1)
  )
  (probe-count event.subscriptions.lowered)
)

(fn-do _ event-insert-descriptor Bool
  (param heads (list (? EventLoweredDescriptor)))
  (param event-id Size)
  (param matcher EventLoweredOwnerMatcher)
  (param callback Pointer)
  (param order Size)
  (param is-machine Bool)
  (while (<= (. heads length) event-id)
    (+= heads null)
  )
  (let current ([] heads event-id))
  (let tail (? EventLoweredDescriptor))
  (while current
    (let descriptor current)
    (if (== (as (. descriptor matcher) Pointer) (as matcher Pointer))
      (if (== (. descriptor order) order)
        (return false)
      )
    )
    (= tail descriptor)
    (= current (. descriptor next))
  )
  (blank)
  (let descriptor (call EventLoweredDescriptor matcher callback order is-machine))
  (if tail
    (= (. tail next) descriptor)
    (else
      (= ([] heads event-id) descriptor)
    )
  )
  (return true)
)

(fn-do _ event-bubbling-adjust _
  (param event-id Size)
  (param delta Size)
  (return-if (if (not delta)))
  (while (<= (. event-bubbling-counts length) event-id)
    (+= event-bubbling-counts 0)
  )
  (+= ([] event-bubbling-counts event-id) delta)
)

(fn-expr _ event-has-bubbling-interest Bool @inline
  (param event-id Size)
  (and (< event-id (. event-bubbling-counts length)) (> ([] event-bubbling-counts event-id) 0))
)

(fn-do _ event-has-lowered-owner Bool
  (param owner Pointer)
  (for (in head event-descriptor-heads)
    (let current head)
    (while current
      (let descriptor current)
      (let matcher (. descriptor matcher))
      (if (call matcher owner)
        (return true)
      )
      (= current (. descriptor next))
    )
  )
  (return false)
)

(fn-do _ event-has-lowered-interest Bool
  (param owner Pointer)
  (param event-id Size)
  (if (>= event-id (. event-descriptor-heads length))
    (return false)
  )
  (let current ([] event-descriptor-heads event-id))
  (while current
    (let descriptor current)
    (let matcher (. descriptor matcher))
    (if (call matcher owner)
      (return true)
    )
    (= current (. descriptor next))
  )
  (return false)
)

(fn-expr _ keyed-event-bucket Index
  (param key-low U64)
  (param key-high U64)
  (param capacity Size)
  (as (% (+ (* low 131) high) capacity) Index)
  (where
    (lazy low (% key-low capacity))
    (lazy high (% key-high capacity))
  )
)

(fn-expr _ events-lane Size
  (as (call C:brixGCEventsSidePayloadLane) Size)
)

(fn-do _ event-sidecar EventSidecar
  (param owner Pointer)
  (let existing (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
  (if existing
    (return existing)
  )
  (blank)
  (let created (call EventSidecar))
  (probe-count event.sidecars.created)
  (call gc-publish-object-side-payload owner (call events-lane) created)
  (return created)
)

(fn-do _ event-keyed-index KeyedEventIndex
  (param owner Pointer)
  (param event-id Size)
  (let sidecar (call event-sidecar owner))
  (throw (call Panic "Illegal to access a closed event") (if (. sidecar is-closed)))
  (let existing (call (. sidecar find) event-id))
  (if existing
    (return (as existing KeyedEventIndex))
  )
  (blank)
  (let index (call KeyedEventIndex event-id))
  (+= (. sidecar entries) index)
  (probe-count event.endpoint.entries)
  (return index)
)

(fn-do _ (of event-dispatch-keyed Payload) _
  (param owner Pointer)
  (param event-id Size)
  (param key-low U64)
  (param key-high U64)
  (param expected-generation U64)
  (param payload Payload)
  (param handlers _ (= true))
  (param machines _ (= true))
  (let sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
  (return-if (if (or (not sidecar) (. sidecar is-closed))))
  (let entry (call (. sidecar find) event-id))
  (return-if (if (not entry)))
  (let index (as entry KeyedEventIndex))
  (let address (call (. index find-live) key-low key-high))
  (return-if (if (or (not address) (not (call (. address is-generation-live) expected-generation)))))
  (let endpoint (as (. address endpoint) (of EventEndpoint Payload)))
  (return-if (if (!= (call (. endpoint event-address-generation)) expected-generation)))
  (call (. endpoint dispatch) payload handlers (and machines (not (. sidecar machines-stopped))))
)

(fn-do _ (of event-publish-owner Payload Route) Bool
  (param owner Pointer)
  (param event-id Size)
  (param payload Payload)
  (param routed Route)
  (param is-target Bool)
  (param handlers Bool)
  (param machines Bool)
  (constraint is Route RoutedEvent)
  (let sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
  (if (?? (?. sidecar is-closed) false)
    (return false)
  )
  (blank)
  (let interested false)
  (let heads (if-expr is-target event-descriptor-heads event-bubbling-heads))
  (if (< event-id (. heads length))
    (let current ([] heads event-id))
    (while current
      (let descriptor current)
      (probe-count event.descriptor.visits)
      (let matcher (. descriptor matcher))
      (if (call matcher owner)
        (= interested true)
        (let reaches-machines (and machines (not (?? (?. sidecar machines-stopped) false))))
        (if (call event-dispatch-reaches (. descriptor is-machine) handlers reaches-machines)
          (if (not (. descriptor is-machine))
            (probe-count event.handlers.sync)
          )
          (call event-invoke-lowered (. descriptor callback) owner payload)
          (if (and handlers (. routed is-canceled))
            (return true)
          )
          (= sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
          (if (?? (?. sidecar is-closed) false)
            (return true)
          )
        )
      )
      (= current (. descriptor next))
    )
  )
  (blank)
  (if (not sidecar)
    (return interested)
  )
  (let entry (call (. sidecar find) event-id))
  (if (or (not entry) (not (. entry has-interest)))
    (return interested)
  )
  (if (and (not is-target) (not (. entry has-bubbling-interest)))
    (return interested)
  )
  (= interested true)
  (call (. (as entry (of EventEndpoint Payload)) dispatch-routed)
    (block
      (arg payload)
      (arg routed)
      (arg is-target)
      (arg handlers)
      (arg (and machines (not (. sidecar machines-stopped))))
    )
  )
  (return interested)
)

(fn-do _ (of event-publish-routed Payload) Bool
  (param event-id Size)
  (param target Pointer)
  (param payload Payload)
  (constraint is Payload RoutedEvent)
  (return (call event-publish-along event-id target null payload payload))
)

(fn-do _ (of event-publish-routed-node Payload) Bool
  (param event-id Size)
  (param target Pointer)
  (param node EventNode)
  (param payload Payload)
  (constraint is Payload RoutedEvent)
  (let walk (? EventNode) (if-expr (. payload has-own-route) null node))
  (return (call event-publish-along event-id target walk payload payload))
)

(fn-do _ (of event-publish-node Payload) _
  (param target Pointer)
  (param event-id Size)
  (param node EventNode)
  (param payload Payload)
  (call event-publish-along event-id target node payload event-no-route)
)

(fn-do _ (of event-publish-along Payload Route) Bool
  (param event-id Size)
  (param target Pointer)
  (param node (? EventNode))
  (param payload Payload)
  (param routed Route)
  (constraint is Route RoutedEvent)
  (+= event-machine-publishing 1)
  (if event-machine-is-draining
    (let reached (call (of List EventRouteFrame)))
    (let dispatch Doer
      (=> () :do
        (block
          (call event-dispatch-routed-machines event-id payload routed reached)
        )
      )
    )
    (call event-machine-defer dispatch)
    (call event-dispatch-routed event-id target node payload routed reached)
    (else
      (call event-dispatch-routed event-id target node payload routed null)
    )
  )
  (call event-machine-finish-publish)
  (return (. routed is-canceled))
)

(fn-do _ (of event-dispatch-routed Payload Route) _
  (param event-id Size)
  (param target Pointer)
  (param node (? EventNode))
  (param payload Payload)
  (param routed Route)
  (param reached (? (list EventRouteFrame)))
  (constraint is Route RoutedEvent)
  (probe-count event.publish.attempts)
  (return-if (if (. routed is-canceled)))
  (let interested false)
  (let current (? Pointer) target)
  (let walker node)
  (let is-target true)
  (while current
    (let owner current)
    (probe-count event.route.frames)
    (if (!= reached null)
      (+= reached (tuple owner (call event-machine-hold owner)))
    )
    (if (call event-publish-owner owner event-id payload routed is-target true (== reached null))
      (= interested true)
      (call event-machine-settle-route)
      (return-if (if (. routed is-canceled)))
    )
    (if (and is-target (not (call event-has-bubbling-interest event-id)))
      (break)
    )
    (if walker
      (= walker (. walker event-parent))
      (= current null)
      (if walker
        (= current (as walker Pointer))
      )
      (else
        (= current (call (. routed next-event-owner) owner))
      )
    )
    (= is-target false)
  )
  (blank)
  (if (not interested)
    (probe-count event.publish.interest-misses)
  )
)

(fn-do _ (of event-dispatch-routed-machines Payload Route) _
  (param event-id Size)
  (param payload Payload)
  (param routed Route)
  (param reached (list EventRouteFrame))
  (constraint is Route RoutedEvent)
  (let is-target true)
  (for (in frame reached)
    (call event-publish-owner (. frame owner) event-id payload routed is-target false true)
    (call event-machine-release (. frame root))
    (= is-target false)
  )
)

(fn-do _ (of event-dispatch Payload) _
  (param owner Pointer)
  (param event-id Size)
  (param payload Payload)
  (param handlers _ (= true))
  (param machines _ (= true))
  (let sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
  (return-if (if (?? (?. sidecar is-closed) false)))
  (blank)
  (if (< event-id (. event-descriptor-heads length))
    (let current ([] event-descriptor-heads event-id))
    (while current
      (let descriptor current)
      (probe-count event.descriptor.visits)
      (let matcher (. descriptor matcher))
      (let reaches-machines (and machines (not (?? (?. sidecar machines-stopped) false))))
      (if (and (call event-dispatch-reaches (. descriptor is-machine) handlers reaches-machines) (call matcher owner))
        (if (not (. descriptor is-machine))
          (probe-count event.handlers.sync)
        )
        (call event-invoke-lowered (. descriptor callback) owner payload)
        (= sidecar (call (of gc-object-side-payload EventSidecar) owner (call events-lane)))
        (if (?? (?. sidecar is-closed) false)
          (return)
        )
      )
      (= current (. descriptor next))
    )
  )
  (blank)
  (return-if (if (not sidecar)))
  (blank)
  (let entry (call (. sidecar find) event-id))
  (return-if (if (or (not entry) (not (. entry has-interest)))))
  (blank)
  (call (. (as entry (of EventEndpoint Payload)) dispatch) payload handlers (and machines (not (. sidecar machines-stopped))))
)
