(import ./array)
(import ./backing)
(import ./core)
(import ./error)
(import ./list)
(import ./number)
(import ./range)
(import ./stream)
(import ./string)
(import /BxCore/BxCore.h)
(import /string.h)
(blank)
(prop + bucket-allocation-size _ (= (as 8 Size)))
(prop + map-maximum-capacity _ (= (as 2147483648 Size)))
(blank)
(type-line + Hash (is U32))
(type-line + (of KeyValuePair Key Value) (is (tuple (: key Key) (: value Value))))
(blank)
(prop _ map-tombstone-hash _ (= (. U32 max)))
(prop _ hash-first-multiplier U64 (= 0xff51afd7ed558ccd))
(prop _ hash-second-multiplier U64 (= 0xc4ceb9fe1a85ec53))
(type-line _ MapProbe (is (tuple (: found (? Index)) (: vacant Index))))
(blank)
; All three slot arrays have the same power-of-two capacity. A zero hash is empty, U32.max is a
; tombstone, and every other hash has a live key/value at the same index. Inserts keep live plus
; deleted slots at or below 75%; tombstone pressure rehashes in place, growth quadruples capacity,
; reserve rounds up to that policy, and deletion/clear deliberately never shrink retained storage.
; A map made for a count of pairs takes the least power of two that holds them.
(type + (of Map Key Value Backing)
  (constraint = Backing GCBacking)
  (constraint is Backing StorageBacking)
  (implements Inspectable)
  (prop _ pair-count U32 (= 0))
  (blank)
  (prop _ context (. Backing Context))
  (prop _ hashes (of Array Hash Backing))
  (prop _ key-slots (of Array Key Backing))
  (prop _ value-slots (of Array Value Backing))
  (prop _ buckets-allocated _ (= bucket-allocation-size))
  (prop _ tombstones _ (= (as 0 Size)))
  (prop _ mutation-version _ (= 0u64))
  (fn-do + This _
    (constraint = Backing GCBacking)
    (= context (call Void))
    (call initialize-storage bucket-allocation-size)
  )
  (fn-do + This _
    (param ... pairs (list (of KeyValuePair Key Value)))
    (constraint = Backing GCBacking)
    (= context (call Void))
    (call initialize-storage (call fitted-capacity (. pairs length)))
    (for (in (tuple key value) pairs)
      (call insert-fitted key value)
    )
  )
  (fn-do + This _ @inline
    (param pairs (stream (of KeyValuePair Key Value)))
    (param capacity Size (= 0))
    (constraint = Backing GCBacking)
    (= context (call Void))
    (call initialize-storage (call fitted-capacity capacity))
    (for (in (tuple key value) pairs)
      (= ([] this key) value)
    )
  )
  (fn-do + This _
    (param capacity Size)
    (constraint = Backing GCBacking)
    (= context (call Void))
    (call initialize-storage (call fitted-capacity capacity))
  )
  (fn-do + (of This Storage) _
    (param storage Storage)
    (constraint is Storage ArrayStorageProvider)
    (constraint = Backing (. Storage (of Backing Key)))
    (lazy context (as storage (. Backing Context)))
    (call initialize-storage bucket-allocation-size)
  )
  (fn-do + (of This Storage) _
    (param storage Storage)
    (param ... pairs (list (of KeyValuePair Key Value)))
    (constraint is Storage ArrayStorageProvider)
    (constraint = Backing (. Storage (of Backing Key)))
    (= context (as storage (. Backing Context)))
    (call initialize-storage (call fitted-capacity (. pairs length)))
    (for (in (tuple key value) pairs)
      (call insert-fitted key value)
    )
  )
  (fn-do + (of This Storage) _ @inline
    (param storage Storage)
    (param pairs (stream (of KeyValuePair Key Value)))
    (param capacity Size (= 0))
    (constraint is Storage ArrayStorageProvider)
    (constraint = Backing (. Storage (of Backing Key)))
    (= context (as storage (. Backing Context)))
    (call initialize-storage (call fitted-capacity capacity))
    (for (in (tuple key value) pairs)
      (= ([] this key) value)
    )
  )
  (fn-do + (of This Storage) _
    (param storage Storage)
    (param capacity Size)
    (constraint is Storage ArrayStorageProvider)
    (constraint = Backing (. Storage (of Backing Key)))
    (lazy context (as storage (. Backing Context)))
    (call initialize-storage (call fitted-capacity capacity))
  )
  (fn-do _ This _
    (param capacity Size)
    (param context (. Backing Context))
    (= (. this context) context)
    (call initialize-storage (call fitted-capacity capacity))
  )
  (fn-from-do + (: pairs (list (of KeyValuePair Key Value)))
    (let map (call This (. pairs length)))
    (for (in (tuple key value) pairs)
      (call (. map insert-fitted) key value)
    )
    (return map)
  )
  (fn-from-do + (: pairs (of ImmutableArray (of KeyValuePair Key Value)))
    (let map (call This (. pairs length)))
    (for (in (tuple key value) pairs)
      (call (. map insert-fitted) key value)
    )
    (return map)
  )
  (fn-to-do + (of Map Key ''T Backing)
    (constraint =~ T (as Value T))
    (let map (call (of Map Key T Backing) pair-count context))
    (for (in (tuple key value) this)
      (= ([] map key) (as value T))
    )
    (return map)
  )
  (fn-to-do + (of Iterable (of KeyValuePair Key Value)) @inline
    (let version mutation-version)
    (for (in index (..< 0 buckets-allocated))
      (call ensure-iteration-version version)
      (if (call is-occupied-hash ([] hashes index))
        (yield (call KeyValuePair ([] key-slots index) ([] value-slots index)))
      )
    )
    (call ensure-iteration-version version)
  )
  (fn-to-expr + String
    (str "[" joined "]")
    (where
      (lazy joined (call (. ", " join) (in (str each " = " ([] this each)) keys)))
    )
  )
  (fn-do + inspectable-snapshot _
    (probe-assign (: this map.length) pair-count)
    (for (in (tuple key value) this)
      (probe-log (: this map.item) (items: key value))
    )
  )
  (fn-expr + length U32 :get @inline
    pair-count
  )
  (fn-do + keys _ :get @inline
    (let version mutation-version)
    (for (in index (..< 0 buckets-allocated))
      (call ensure-iteration-version version)
      (if (call is-occupied-hash ([] hashes index))
        (yield ([] key-slots index))
      )
    )
    (call ensure-iteration-version version)
  )
  (fn-do + values _ :get @inline
    (let version mutation-version)
    (for (in index (..< 0 buckets-allocated))
      (call ensure-iteration-version version)
      (if (call is-occupied-hash ([] hashes index))
        (yield ([] value-slots index))
      )
    )
    (call ensure-iteration-version version)
  )
  (fn-do + items _ :get @inline
    (let version mutation-version)
    (for (in index (..< 0 buckets-allocated))
      (call ensure-iteration-version version)
      (if (call is-occupied-hash ([] hashes index))
        (yield (call KeyValuePair ([] key-slots index) ([] value-slots index)))
      )
    )
    (call ensure-iteration-version version)
  )
  (fn-expr + capacity Size :get
    buckets-allocated
  )
  (fn-do + reserve _
    (param capacity Size)
    (if (> (call fitted-capacity capacity) buckets-allocated)
      (call rehash (call capacity-for-count capacity))
      (+= mutation-version 1)
    )
  )
  (fn-do + clear _
    (if (!= pair-count 0)
      (if (not (. Key is-number))
        (call C:brixZeroManagedSlots (. key-slots data) (* buckets-allocated (. Key size)))
      )
      (if (not (. Value is-number))
        (call C:brixZeroManagedSlots (. value-slots data) (* buckets-allocated (. Value size)))
      )
    )
    (if (or (!= pair-count 0) (!= tombstones 0))
      (call C:memset (. hashes data) 0 (* buckets-allocated (. Hash size)))
    )
    (= pair-count 0)
    (= tombstones 0)
    (+= mutation-version 1)
  )
  (fn-expr + (infix this has (param key Key)) _
    (!= found null)
    (where
      (lazy encoded (call encoded-hash (call hash-for key)))
      (lazy found (. (call probe-for key encoded) found))
    )
  )
  (fn-do + (infix this + (param that This)) _
    (let clone (call This (+ (as pair-count Size) (as (. that length) Size)) context))
    (+= clone this)
    (+= clone that)
    (return clone)
  )
  (fn-do + (infix this += (param that (of Map ''K2 ''V2 ''OtherBacking))) _
    (constraint is OtherBacking StorageBacking)
    (return-if this (if (== (as that Pointer) (as this Pointer))))
    (blank)
    (call reserve (+ (as pair-count Size) (as (. that length) Size)))
    (for (in (tuple key value) that)
      (= ([] this (as key Key)) (as value Value))
    )
    (return this)
  )
  (fn-do + (infix this += (param that (tuple (: key Key) (: value Value)))) _
    (= ([] this (. that key)) (. that value))
    (return this)
  )
  (fn-do + (infix this - (param that This)) _
    (let clone (call This (as pair-count Size) context))
    (+= clone this)
    (return (-= clone that))
  )
  (fn-do + (infix this -= (param that This)) _
    (if (== (as that Pointer) (as this Pointer))
      (call clear)
      (return this)
    )
    (for (in key (. that keys))
      (-= ([] this key))
    )
    (return this)
  )
  (fn-do + (index-get this (param key Key)) (? Value)
    (let encoded (call encoded-hash (call hash-for key)))
    (let found (. (call probe-for key encoded) found))
    (if found
      (return ([] value-slots found))
    )
  )
  (fn-do + (index-set this (param key Key) (param value Value)) _
    (let encoded (call encoded-hash (call hash-for key)))
    (let probe (call probe-for key encoded))
    (if (. probe found)
      (= ([] value-slots (. probe found)) value)
      (+= mutation-version 1)
      (else
        (if (and (> (+ (call occupied-and-deleted-count) 1) (/ (* buckets-allocated 3) 4)) (!= ([] hashes (. probe vacant)) map-tombstone-hash))
          (if (<= (+ (as pair-count Size) 1) (/ (* buckets-allocated 3) 4))
            (call rehash buckets-allocated)
            (else
              (call grow-buckets)
            )
          )
          (= probe (call probe-for key encoded))
        )
        (blank)
        (let slot (. probe vacant))
        (if (== ([] hashes slot) map-tombstone-hash)
          (-= tombstones 1)
        )
        (= ([] key-slots slot) key)
        (= ([] value-slots slot) value)
        (= ([] hashes slot) encoded)
        (+= pair-count 1)
        (+= mutation-version 1)
      )
    )
    (blank)
    (return value)
  )
  (fn-do + (index-delete this (param key Key)) _
    (let encoded (call encoded-hash (call hash-for key)))
    (let found (. (call probe-for key encoded) found))
    (if found
      (let slot found)
      (= ([] hashes slot) map-tombstone-hash)
      (call (. key-slots zero) slot)
      (call (. value-slots zero) slot)
      (-= pair-count 1)
      (+= tombstones 1)
      (+= mutation-version 1)
    )
  )
  (fn-expr + (prefix ! this) _
    (== pair-count 0)
  )
  (fn-do + get-or-init Value
    (param key Key)
    (let existing-value ([] this key))
    (return? existing-value)
    (blank)
    (let new-value (call Value))
    (= ([] this key) new-value)
    (return new-value)
  )
  (fn-do + find _
    (param that Value)
    (for (in item (. this items))
      (if (== (. item value) that)
        (yield (. item key))
      )
    )
  )
  (fn-do _ insert-fitted _
    (param key Key)
    (param value Value)
    ; Puts a pair in a map made for a count of pairs it has not yet had more of, so no slot is a
    ; tombstone and one is free: a key it has already has its value replaced.
    (let encoded (call encoded-hash (call hash-for key)))
    (let index (call bucket-for-hash encoded))
    (for (in probes (..< 0 buckets-allocated))
      (let candidate ([] hashes index))
      (if (not candidate)
        (= ([] key-slots index) key)
        (= ([] value-slots index) value)
        (= ([] hashes index) encoded)
        (+= pair-count 1)
        (return)
      )
      (if (and (== candidate encoded) (== ([] key-slots index) key))
        (= ([] value-slots index) value)
        (return)
      )
      (= index (call next-bucket index))
    )
    (throw (call Panic "Map probe exhausted"))
  )
  (fn-do _ probe-for MapProbe
    (param key Key)
    (param encoded Hash)
    (let index (call bucket-for-hash encoded))
    (let first-tombstone (? Index))
    (let not-found (? Index))
    (for (in probes (..< 0 buckets-allocated))
      (let candidate ([] hashes index))
      (if (not candidate)
        (return (call MapProbe not-found (?? first-tombstone index)))
        (else-if (== candidate map-tombstone-hash)
          (if (not first-tombstone)
            (= first-tombstone index)
          )
        )
        (else-if (and (== candidate encoded) (== ([] key-slots index) key))
          (return (call MapProbe index index))
        )
      )
      (= index (call next-bucket index))
    )
    (blank)
    (if first-tombstone
      (return (call MapProbe not-found first-tombstone))
    )
    (throw (call Panic "Map probe exhausted"))
  )
  (fn-expr _ bucket-for-hash Index
    (param hash Hash)
    (/and/ (as hash Size) (- buckets-allocated 1))
  )
  (fn-expr _ next-bucket Index
    (param index Index)
    (/and/ (+ index 1) (- buckets-allocated 1))
  )
  (fn-expr _ occupied-and-deleted-count Size
    (+ (as pair-count Size) tombstones)
  )
  (fn-do _ grow-buckets _
    (if (>= buckets-allocated map-maximum-capacity)
      (throw (call Panic "Map capacity overflow"))
    )
    (let new-capacity (* buckets-allocated 4))
    (if (> new-capacity map-maximum-capacity)
      (= new-capacity map-maximum-capacity)
    )
    (call rehash new-capacity)
  )
  (fn-do _ rehash _
    (param new-capacity Size)
    (let old-hashes hashes)
    (let old-keys key-slots)
    (let old-values value-slots)
    (let old-capacity buckets-allocated)
    (blank)
    (let new-hashes (call (of Array Hash Backing) context new-capacity))
    (let new-keys (call (of Array Key Backing) context new-capacity))
    (let new-values (call (of Array Value Backing) context new-capacity))
    (= hashes new-hashes)
    (= key-slots new-keys)
    (= value-slots new-values)
    (= buckets-allocated new-capacity)
    (= tombstones 0)
    (blank)
    (for (in old-index (..< 0 old-capacity))
      (let encoded ([] old-hashes old-index))
      (if (call is-occupied-hash encoded)
        (let probe (call probe-for ([] old-keys old-index) encoded))
        (let new-index (. probe vacant))
        (= ([] key-slots new-index) ([] old-keys old-index))
        (= ([] value-slots new-index) ([] old-values old-index))
        (= ([] hashes new-index) encoded)
      )
    )
  )
  (fn-do _ initialize-storage _
    (param capacity Size)
    (= hashes (call (of Array Hash Backing) context capacity))
    (= key-slots (call (of Array Key Backing) context capacity))
    (= value-slots (call (of Array Value Backing) context capacity))
    (= buckets-allocated capacity)
  )
  (fn-do _ capacity-for-count Size
    (param count Size)
    (throw (call Panic "Map capacity overflow") (if (> count (/ (* map-maximum-capacity 3) 4))))
    (blank)
    (let capacity bucket-allocation-size)
    (while (> count (/ (* capacity 3) 4))
      (*= capacity 4)
      (if (> capacity map-maximum-capacity)
        (= capacity map-maximum-capacity)
      )
    )
    (return capacity)
  )
  (fn-do _ fitted-capacity Size
    (param count Size)
    ; The least power of two from the bucket allocation size that keeps a count at or below 75%.
    (throw (call Panic "Map capacity overflow") (if (> count (/ (* map-maximum-capacity 3) 4))))
    (blank)
    (let capacity bucket-allocation-size)
    (while (> count (/ (* capacity 3) 4))
      (*= capacity 2)
    )
    (return capacity)
  )
  (fn-do _ ensure-iteration-version _
    (param version U64)
    (if (!= mutation-version version)
      (throw (call Panic "Map mutated during iteration"))
    )
  )
)

(fn-expr _ encoded-hash Hash
  (param hash Hash)
  (case? (>= hash (- (. U32 max) 1))
    1u32
  )
  (default
    (+ hash 1)
  )
)

(fn-expr _ is-occupied-hash Bool
  (param hash Hash)
  (and (!= hash 0) (!= hash map-tombstone-hash))
)

(type + Hashable (is Interface)
  (fn-expr + hash Hash :get)
)

(fn-expr + (of hash-for Key) Hash
  (param value Key)
  (constraint is Key Hashable)
  (. value hash)
)

(fn-expr + hash-for Hash
  (param value String)
  (call C:brixStringHash value (. value size))
)

(fn-expr + hash-for Hash
  (param value Atom)
  (call hash-for (. value address))
)

(fn-expr + hash-for Hash
  (param value (of CPointer Void))
  (call hash-for (as value U64))
)

(fn-do + hash-for Hash
  (param value F64)
  (let normalized (if-expr (== value 0.0) 0.0 value))
  (return (call hash-for ([] (as &normalized (of CPointer U64)) 0)))
)

(fn-do + hash-for Hash
  (param value F32)
  (return (call hash-for (as value F64)))
)

(fn-do + (of hash-for Num) Hash
  (param value Num)
  (constraint is Num Number)
  (let bits (as value U64))
  (let mixed (* (/xor/ bits (/zrshift/ bits 33)) hash-first-multiplier))
  (= mixed (* (/xor/ mixed (/zrshift/ mixed 33)) hash-second-multiplier))
  (return (as (/xor/ mixed (/zrshift/ mixed 33)) Hash))
)
