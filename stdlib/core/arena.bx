(import ./array)
(import ./backing)
(import ./core)
(import ./error)
(import ./number)
(import ./range)
(import ./string)
(import /BxCore/BxCore.h)

(type + Arena (is Tuple)
  (implements ArrayStorageProvider)
  (implements (of Usable Void))
  (prop _ owner-handle (of CPointer Byte))
  (prop _ incarnation Size)
  (blank)
  (prop + _ (of Backing Item) (= ArenaBacking))
  (fn-do + This _
    (param initial-byte-capacity Size (= 0))
    (let handle (as (call C:brixArenaCreate initial-byte-capacity) (of CPointer Byte)))
    (throw (call Panic "Arena allocation failed") (if (== (. handle address) 0)))
    (blank)
    (= owner-handle handle)
    (= incarnation (as (call C:brixArenaIncarnation handle) Size))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _ (without gc)
    (call release)
  )
  (fn-do + (of allocate Value) (of CPointer Value) (without gc)
    (param count Size)
    (if (and (!= count 0) (> count (/ (. Size max) (. Value size))))
      (call C:brixArenaAllocationFailed owner-handle incarnation 16)
    )
    (let data (call C:brixArenaReserve owner-handle incarnation (* count (. Value size)) 16 true))
    (if (== (. data address) 0)
      (call C:brixArenaAllocationFailed owner-handle incarnation 16)
    )
    (return (as data (of CPointer Value)))
  )
  (fn-do + (of try-allocate Value) (? (of CPointer Value)) (without gc)
    (param count Size)
    (if (and (!= count 0) (> count (/ (. Size max) (. Value size))))
      (return null)
    )
    (let data (call C:brixArenaReserve owner-handle incarnation (* count (. Value size)) 16 true))
    (if (== (. data address) 0)
      (return null)
    )
    (return (as data (of CPointer Value)))
  )
  (fn-do + allocate-raw (of CPointer Byte) (without gc)
    (param byte-count Size)
    (param alignment Size (= 1))
    (let data (call C:brixArenaReserve owner-handle incarnation byte-count alignment false))
    (if (== (. data address) 0)
      (call C:brixArenaAllocationFailed owner-handle incarnation alignment)
    )
    (return data)
  )
  (fn-do + copy-string String (without gc)
    (param text String)
    (let copy (call C:brixArenaCopyString owner-handle incarnation text))
    (throw (call Panic "Arena String allocation failed") (if (== (. (as copy Pointer) address) 0)))
    (return copy)
  )
  (fn-do + copy-span String (without gc)
    (param source ([] Char))
    (param start Index)
    (param end Index)
    (param stop-at-null Bool (= false))
    (let copy
      (call C:brixArenaCopyCodepointSpan
        (block
          (arg owner-handle)
          (arg incarnation)
          (arg (. source data))
          (arg (. source length))
          (arg start)
          (arg end)
          (arg stop-at-null)
        )
      )
    )
    (throw (call Panic "Arena codepoint span materialization failed") (if (== (. (as copy Pointer) address) 0)))
    (return copy)
  )
  (fn-do + copy-span String (without gc)
    (param source (of ImmutableArray Byte))
    (param start Index)
    (param end Index)
    (let copy
      (call C:brixArenaCopyByteSpan
        (block
          (arg owner-handle)
          (arg incarnation)
          (arg (as source (of CPointer Byte)))
          (arg (. source length))
          (arg start)
          (arg end)
        )
      )
    )
    (throw (call Panic "Arena byte span materialization failed") (if (== (. (as copy Pointer) address) 0)))
    (return copy)
  )
  (fn-do + owns Bool (without gc)
    (param value Pointer)
    (return (call C:brixArenaOwns owner-handle incarnation value))
  )
  (fn-do + try-allocate-raw (? (of CPointer Byte)) (without gc)
    (param byte-count Size)
    (param alignment Size (= 1))
    (let data (call C:brixArenaReserve owner-handle incarnation byte-count alignment false))
    (if (== (. data address) 0)
      (return null)
    )
    (return data)
  )
  (fn-expr + mark ArenaMark :get
    (before
      (throw (call Panic "Arena is already released") (if (== mark 0)))
    )
    (call ArenaMark (as mark Size))
    (where
      (lazy mark (call C:brixArenaMark owner-handle incarnation))
    )
  )
  (fn-do + rewind _ (without gc)
    (param mark ArenaMark)
    (let result (call (. mark rewind-from) owner-handle incarnation))
    (throw (call Panic "Arena mark is stale or belongs to another Arena") (if (!= result 0)))
  )
  (fn-do + reset _ (without gc)
    (call C:brixArenaReset owner-handle incarnation)
  )
  (fn-do + release _ (without gc)
    (call C:brixArenaRelease owner-handle incarnation)
  )
  (fn-expr + state Size :get
    (as (call C:brixArenaState owner-handle incarnation) Size)
  )
  (fn-expr + generation Size :get
    (as (call C:brixArenaGeneration owner-handle incarnation) Size)
  )
  (fn-expr + active-block-count Size :get
    (as (call C:brixArenaActiveBlockCount owner-handle incarnation) Size)
  )
  (fn-expr + retained-block-count Size :get
    (as (call C:brixArenaRetainedBlockCount owner-handle incarnation) Size)
  )
  (fn-expr + active-bytes Size :get
    (as (call C:brixArenaActiveBytes owner-handle incarnation) Size)
  )
  (fn-expr + reserved-bytes Size :get
    (as (call C:brixArenaReservedBytes owner-handle incarnation) Size)
  )
  (fn-expr + retained-bytes Size :get
    (as (call C:brixArenaRetainedBytes owner-handle incarnation) Size)
  )
  (fn-expr + peak-active-bytes Size :get
    (as (call C:brixArenaPeakActiveBytes owner-handle incarnation) Size)
  )
  (fn-expr + system-block-allocation-count Size :get
    (as (call C:brixArenaOwnerSystemBlockAllocationCount owner-handle incarnation) Size)
  )
  (fn-expr + reset-count Size :get
    (as (call C:brixArenaOwnerResetCount owner-handle incarnation) Size)
  )
  (fn-expr + rewind-count Size :get
    (as (call C:brixArenaOwnerRewindCount owner-handle incarnation) Size)
  )
)

(extend + (of CPointer ''Item)
  (fn-do + store-untraced _ (without gc)
    (param item Item)
    (param index Index)
  )
)

(type + ArenaMark (is Tuple)
  (prop + value Size)
  (fn-do _ rewind-from Size (without gc)
    (param arena-handle (of CPointer Byte))
    (param arena-incarnation Size)
    (return (as (call C:brixArenaRewind arena-handle arena-incarnation value) Size))
  )
)

(type + ArenaBacking
  (implements StorageBacking)
  (prop + _ Context (= Arena))
  (prop + _ (of Storage Item) (= (of CPointer Item)))
  (fn-expr + (of allocate Item) (of CPointer Item) :static (without gc)
    (param context Arena)
    (param capacity Size)
    (call (of (. context allocate) Item) capacity)
  )
  (fn-expr + (of load Item) Item :static @inline (without gc)
    (param storage (of CPointer Item))
    (param index Index)
    ([] storage index)
  )
  (fn-do + (of store Item) Void :static @inline
    (param storage (of CPointer Item))
    (param item Item)
    (param index Index)
    (call (. storage store-untraced) item index)
  )
)
