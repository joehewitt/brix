
━━━━━━━━━━━━━━━━━━━━
+ TestFuncPair'Expecting'Actual is Tuple

+ expecting Expecting
+ actual Getter'Actual

━━━━━━━━━━━━━━━━━━━━
+ TestPair'Expecting'Actual is Tuple

+ expecting Expecting
+ actual Actual

━━━━━━━━━━━━━━━━━━━━
+ TestCase

+ description = ""
+ passed = 0
+ failed = 0
+ caught = 0
+ previous TestCase?

────────────────────
+ This
    - description

────────────────────
+ do run
    - body

` Runs the body in a task of its own, with the main task's stack, and waits for it. An error the
` body raises, or a panic that ends its task, counts as caught.
. running = do new @large-stack
    . result = catch body(this)
    if result is Error
        -- "$description caught: ${(result as Error).message}"
        caught += 1
    else if result is TestCase
        passed = result.passed
        failed = result.failed
        caught = result.caught
catch failure
    -- "$description panicked: ${failure as String}"
    caught += 1
running.wait()

────────────────────
+ do with
    - next-case TestCase

next-case.previous = this
= next-case

────────────────────
+ do then
    - description String
    - body

. next-case = TestCase(description)
next-case.previous = this
next-case.run(body)
= next-case

────────────────────
+ do with
    - pass Bool

if pass
    passed += 1
else
    failed += 1

= this

────────────────────
+ check
    - pass Bool

with(pass)

────────────────────
+ do check
    - label String
    - pass Bool

if pass
    passed += 1
else
    -- "Assertion $label"
    failed += 1

= this

────────────────────
+ do with'Expecting'Actual
    - pair TestPair'Expecting'Actual

. actual = catch? (pair.actual as Expecting)
if actual
    if actual == pair.expecting
        passed += 1
    else
        -- "Expecting $pair.expecting"
        -- "Got ${actual}"
        failed += 1
else
    caught += 1

= this

────────────────────
+ expect'Expecting'Actual
    - expected Expecting
    - actual Actual

with((expected, actual))

────────────────────
+ do expect'Expecting'Actual
    - label String
    - expected Expecting
    - actual Actual

. actual-result = catch? (actual as Expecting)
if actual-result
    if actual-result == expected
        passed += 1
    else
        -- "Assertion $label"
        -- "Expecting $expected"
        -- "Got ${actual-result}"
        failed += 1
else
    -- "Assertion $label caught"
    caught += 1

= this

────────────────────
+ do with'Expecting'Actual
    - pair TestFuncPair'Expecting'Actual

. fn = pair.actual
. actual = catch? (fn() as Expecting)
if actual
    . pass = actual == pair.expecting
    if pass
        passed += 1
    else
        -- "Expecting $pair.expecting"
        -- "Got ${actual}"
        failed += 1
else
    caught += 1

= this

────────────────────
+ expect'Expecting'Actual
    - expected Expecting
    - actual Getter'Actual

with((expected, actual))

────────────────────
+ do expect'Expecting'Actual
    - label String
    - expected Expecting
    - actual Getter'Actual

. fn = actual
. actual-result = catch? (fn() as Expecting)
if actual-result
    if actual-result == expected
        passed += 1
    else
        -- "Assertion $label"
        -- "Expecting $expected"
        -- "Got ${actual-result}"
        failed += 1
else
    -- "Assertion $label caught"
    caught += 1

= this

────────────────────
+ do show-results

if previous
    previous.show-results()

if !failed && !caught
    -- "$description GREEN ($passed passed)"
else
    -- "$description RED ($passed passed, $failed failed, $caught caught)"

────────────────────
+ has-failures Bool

|? failed > 0 || caught > 0
    true
|? previous
    previous.has-failures()
??
    false

━━━━━━━━━━━━━━━━━━━━
+ TestRender

────────────────────
+ do from test TestCase

test.show-results()
if test.has-failures()
    ?! Panic("TestCase failed: ${test.description}")
= TestRender()

━━━━━━━━━━━━━━━━━━━━
+ test
    - description String

TestCase(description)
