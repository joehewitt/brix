(import /BxRegex/BxRegex.h)

(type + RegexErrorKind (is Union)
  (variant pattern)
  (variant template)
  (variant limit)
  (variant match)
)

(type + RegexError (is Error)
  (prop + kind RegexErrorKind)
  (prop + offset (? Size))
  (fn-do + This _
    (param kind _)
    (param reason String)
    (param offset (? Size))
    (= message reason)
  )
)

(type + RegexSpan (is Tuple)
  (prop + start Size)
  (prop + end Size)
)

(type + Regex
  (prop + pattern String)
  (prop + ignores-case Bool)
  (prop + is-multiline Bool)
  (prop + dot-matches-newline Bool)
  (prop + group-count Size)
  (blank)
  (prop _ flags U32)
  (fn-do + This _ (?! RegexError)
    (param pattern _)
    (param ignores-case _ (= false))
    (param is-multiline _ (= false))
    (param dot-matches-newline _ (= false))
    (= flags (call regex-flags ignores-case is-multiline dot-matches-newline))
    (let error I32)
    (let offset U32)
    (let count (call C:brixRegexCompile pattern (. pattern size) flags &error &offset))
    (throw (call RegexError (. RegexErrorKind pattern) (call regex-message error) (as offset Size)) (if (< count 0)))
    (= group-count (as count Size))
  )
  (fn-do + matches Bool (?! RegexError)
    (param text String)
    (let none ([] U32 0))
    (let count (call C:brixRegexFind pattern (. pattern size) flags text (. text size) 0 1 none 0))
    (call regex-check count)
    (return (> count 0))
  )
  (fn-do + find (? RegexMatch) (?! RegexError)
    (param text String)
    (param from _ (= 0))
    (let bounds ([] U32 stride))
    (let count
      (call C:brixRegexFind
        (block
          (arg pattern)
          (arg (. pattern size))
          (arg flags)
          (arg text)
          (arg (. text size))
          (arg from)
          (arg 1)
          (arg bounds)
          (arg (. bounds size))
        )
      )
    )
    (call regex-check count)
    (return-if null (if (== count 0)))
    (return (call RegexMatch this text bounds 0))
  )
  (fn-do + find-all (list RegexMatch) (?! RegexError)
    (param text String)
    (let bounds ([] U32 (* stride 16)))
    (let count (call C:brixRegexFind pattern (. pattern size) flags text (. text size) 0 0 bounds (. bounds size)))
    (call regex-check count)
    (if (> (* (as count Size) stride) (. bounds size))
      (= bounds ([] U32 (* (as count Size) stride)))
      (= count
        (call C:brixRegexFind
          (block
            (arg pattern)
            (arg (. pattern size))
            (arg flags)
            (arg text)
            (arg (. text size))
            (arg 0)
            (arg 0)
            (arg bounds)
            (arg (. bounds size))
          )
        )
      )
      (call regex-check count)
    )
    (let total (as count Size))
    (let found (list RegexMatch))
    (for (in index (..< 0 total))
      (+= found (call RegexMatch this text bounds (* index stride)))
    )
    (return found)
  )
  (fn-expr + replace String (?! RegexError)
    (param text String)
    (param template String)
    (param is-global _ (= true))
    (call substitute text template 0 (if-expr is-global 1 0))
  )
  (fn-expr + expand String (?! RegexError)
    (param text String)
    (param template String)
    (param from _ (= 0))
    (call substitute text template from 2)
  )
  (fn-do + split (list String) (?! RegexError)
    (param text String)
    (let pieces (list String))
    (let last Size 0)
    (for (in found (call find-all text))
      (+= pieces ([] text (..< last (. found start))))
      (= last (. found end))
    )
    (+= pieces ([] text (..< last (. text length))))
    (return pieces)
  )
  (fn-expr + group-number (? Size)
    (param name String)
    (if-expr (< number 0) null (as number Size))
    (where
      (lazy number (call C:brixRegexGroupNumber pattern (. pattern size) flags name (. name size)))
    )
  )
  (fn-expr _ stride Size :get
    (* (+ group-count 1) 2)
  )
  (fn-do _ substitute String (?! RegexError)
    (param text String)
    (param template String)
    (param from Size)
    (param mode U32)
    (let output ([] Byte (+ (. text size) (. template size) 16)))
    (let length U32)
    (let offset I32)
    (let status
      (call C:brixRegexReplace
        (block
          (arg pattern)
          (arg (. pattern size))
          (arg flags)
          (arg text)
          (arg (. text size))
          (arg from)
          (arg template)
          (arg (. template size))
          (arg mode)
          (arg output)
          (arg (. output size))
          (arg &length)
          (arg &offset)
        )
      )
    )
    (if (and (>= status 0) (> length (. output size)))
      (= output ([] Byte length))
      (= status
        (call C:brixRegexReplace
          (block
            (arg pattern)
            (arg (. pattern size))
            (arg flags)
            (arg text)
            (arg (. text size))
            (arg from)
            (arg template)
            (arg (. template size))
            (arg mode)
            (arg output)
            (arg (. output size))
            (arg &length)
            (arg &offset)
          )
        )
      )
    )
    (throw (call regex-failure status offset) (if (< status 0)))
    (return (call (. output slice-string) (..< 0 length)))
  )
)

(type + RegexMatch
  (prop + regex Regex)
  (prop + text String)
  (blank)
  (prop _ bounds ([] U32))
  (prop _ base Size)
  (fn-do + This _
    (param regex _)
    (param text _)
    (param bounds _)
    (param base _)
  )
  (fn-expr + start Size :get
    ([] bounds base)
  )
  (fn-expr + end Size :get
    ([] bounds (+ base 1))
  )
  (fn-expr + value String :get
    ([] text (..< start end))
  )
  (fn-expr + span (? RegexSpan)
    (param index Size)
    (case? (or (> index (. regex group-count)) (== first (. U32 max)))
      null
    )
    (default
      (call RegexSpan (as first Size) (as ([] bounds (+ base (* index 2) 1)) Size))
    )
    (where
      (lazy first ([] bounds (+ base (* index 2))))
    )
  )
  (fn-expr + group (? String)
    (param index Size)
    (only-if ([] text (..< (. found start) (. found end))) (if found))
    (where
      (lazy found (call span index))
    )
  )
  (fn-expr + named (? String)
    (param name String)
    (only-if (call group index) (if (!= index null)))
    (where
      (lazy index (call (. regex group-number) name))
    )
  )
)

(fn-do + regex-escape String
  (param text String)
  (let source (call byte-view text))
  (let output ([] Byte (* (. source size) 2)))
  (let cursor Size 0)
  (for (in byte source)
    (if (call is-regex-special byte)
      (= ([] output cursor) 92)
      (+= cursor 1)
    )
    (= ([] output cursor) byte)
    (+= cursor 1)
  )
  (return (call (. output slice-string) (..< 0 cursor)))
)

(fn-expr _ is-regex-special Bool
  (param byte Byte)
  (or is-operator (and (>= byte 91) (<= byte 94)) (and (>= byte 123) (<= byte 125)))
  (where
    (lazy is-operator (or (== byte 36) (== byte 46) (== byte 63) (and (>= byte 40) (<= byte 43))))
  )
)

(fn-expr _ regex-flags U32
  (param ignores-case Bool)
  (param is-multiline Bool)
  (param dot-matches-newline Bool)
  (as (+ (if-expr ignores-case 1 0) (if-expr is-multiline 2 0) (if-expr dot-matches-newline 4 0)) U32)
)

(fn-do _ regex-check _ (?! RegexError)
  (param status I32)
  (throw (call regex-failure status -1) (if (< status 0)))
)

(fn-expr _ regex-failure RegexError
  (param status I32)
  (param offset I32)
  (case? (>= offset 0)
    (call RegexError (. RegexErrorKind template) reason (as offset Size))
  )
  (case? (call C:brixRegexIsLimitError status)
    (call RegexError (. RegexErrorKind limit) reason null)
  )
  (default
    (call RegexError (. RegexErrorKind match) reason null)
  )
  (where
    (lazy reason (call regex-message status))
  )
)

(fn-do _ regex-message String
  (param status I32)
  (let buffer ([] Byte 256))
  (let length (call C:brixRegexErrorMessage status buffer (. buffer size)))
  (return (call (. buffer slice-string) (..< 0 length)))
)
