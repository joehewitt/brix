; benchmark.meta description: Finds exactly 16 word matches in a short text many times.
; benchmark.meta timing: recommended
; benchmark.meta profiles: timing
(blank)
(import /regex)
(blank)

(main
  (let regex (call Regex "\\w+"))
  (let text "alpha béta gamma délta epsilon zeta eta théta iota kappa lambda mu nu xi omicron pi")
  (let checksum Size 0)
  (for (in _ (..< 0 20000))
    (for (in found (call (. regex find-all) text))
      (+= checksum (. found end))
    )
  )
  (print (str "bench-result regex/find-all-sixteen checksum=" checksum))
)
