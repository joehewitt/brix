; benchmark.meta description: Finds no matches in one short text and five in another, many times.
; benchmark.meta timing: recommended
; benchmark.meta profiles: timing
(blank)
(import /regex)
(blank)

(main
  (let regex (call Regex "\\d+"))
  (let empty "alpha béta gamma délta epsilon")
  (let text "a1 b22 c333 d4444 é55555")
  (let checksum Size 0)
  (for (in _ (..< 0 100000))
    (+= checksum (. (call (. regex find-all) empty) length))
    (for (in found (call (. regex find-all) text))
      (+= checksum (. found end))
    )
  )
  (print (str "bench-result regex/find-all-small checksum=" checksum))
)
