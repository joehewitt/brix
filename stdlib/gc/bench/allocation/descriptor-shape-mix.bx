; benchmark.meta description: Allocates a mix of fixed object shapes and descriptor identities.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gc-runtime,allocator
(blank)

(main
  (let iterations 50000)
  (let checksum (as 0 Size))
  (for (in i (..< 0 iterations))
    (let choice (% i 8))
    (if (== choice 0)
      (let item (call Shape0 i))
      (+= checksum (. item a))
      (else-if (== choice 1)
        (let item (call Shape1 i))
        (+= checksum (+ (. item a) (. item b)))
      )
      (else-if (== choice 2)
        (let item (call Shape2 i))
        (+= checksum (+ (. item a) (. item c)))
      )
      (else-if (== choice 3)
        (let item (call Shape3 i))
        (+= checksum (+ (. item a) (. item d)))
      )
      (else-if (== choice 4)
        (let item (call Shape4 i))
        (+= checksum (+ (. item a) (. item e)))
      )
      (else-if (== choice 5)
        (let item (call Shape5 i))
        (+= checksum (+ (. item a) (. item f)))
      )
      (else-if (== choice 6)
        (let item (call Shape6 i))
        (+= checksum (+ (. item a) (. item g)))
      )
      (else
        (let item (call Shape7 i))
        (+= checksum (+ (. item a) (. item h)))
      )
    )
  )
  (blank)
  (print (str "bench-result allocation/descriptor-shape-mix checksum=" checksum))
)

(type + Shape0
  (prop + a _ (= 0))
  (fn-do + This _
    (param seed _)
    (= a seed)
  )
)

(type + Shape1
  (prop + a _ (= 0))
  (prop + b _ (= 0))
  (fn-do + This _
    (param seed _)
    (= a seed)
    (= b (+ seed 1))
  )
)

(type + Shape2
  (prop + a _ (= 0))
  (prop + c _ (= 0))
  (fn-do + This _
    (param seed _)
    (= a seed)
    (= c (+ seed 2))
  )
)

(type + Shape3
  (prop + a _ (= 0))
  (prop + d _ (= 0))
  (fn-do + This _
    (param seed _)
    (= a seed)
    (= d (+ seed 3))
  )
)

(type + Shape4
  (prop + a _ (= 0))
  (prop + e _ (= 0))
  (fn-do + This _
    (param seed _)
    (= a seed)
    (= e (+ seed 4))
  )
)

(type + Shape5
  (prop + a _ (= 0))
  (prop + f _ (= 0))
  (fn-do + This _
    (param seed _)
    (= a seed)
    (= f (+ seed 5))
  )
)

(type + Shape6
  (prop + a _ (= 0))
  (prop + g _ (= 0))
  (fn-do + This _
    (param seed _)
    (= a seed)
    (= g (+ seed 6))
  )
)

(type + Shape7
  (prop + a _ (= 0))
  (prop + h _ (= 0))
  (fn-do + This _
    (param seed _)
    (= a seed)
    (= h (+ seed 7))
  )
)
