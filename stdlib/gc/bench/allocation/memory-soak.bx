; benchmark.meta description: Repeats growth and drop cycles around a stable live set to measure residency and fragmentation.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gc-runtime,allocator
(blank)
(import /BxGC/BxGC.h)
(blank)

(main
  (call C:brixGCSetHeapGoal 1073741824)
  (blank)
  (let live (list ([] Byte)))
  (let checksum (as 0 Size))
  (for (in index (..< 0 64))
    (let bytes ([] Byte 1048576))
    (= ([] bytes 0) (as (+ index 3) U8))
    (= ([] bytes 1048575) (as (+ index 7) U8))
    (+= live bytes)
    (+= checksum (+ (as ([] bytes 0) Size) (as ([] bytes 1048575) Size)))
  )
  (blank)
  (for (in round (..< 0 8))
    (+= checksum (call growth-drop round))
    (call C:brixGCCollect)
    (call C:brixGCScavenge)
    (let probe ([] live (% round (. live length))))
    (+= checksum (+ (as ([] probe 0) Size) (as ([] probe 1048575) Size)))
  )
  (blank)
  (print (str "bench-result allocation/memory-soak checksum=" checksum))
)

(fn-do + growth-drop Size
  (param round Size)
  (let transient (list ([] Byte)))
  (let checksum (as 0 Size))
  (for (in index (..< 0 32))
    (let bytes ([] Byte 1048576))
    (= ([] bytes 0) (as (+ round index) U8))
    (= ([] bytes 1048575) (as (+ (* round 3) index) U8))
    (+= transient bytes)
    (+= checksum (+ (as ([] bytes 0) Size) (as ([] bytes 1048575) Size)))
  )
  (blank)
  (return checksum)
)
