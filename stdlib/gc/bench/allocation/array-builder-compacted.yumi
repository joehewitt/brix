`benchmark.meta description: Keeps compacted ArrayBuilder results of four items from builders that reserved about 4 MB each, collects, and reports what stays live.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: memory,allocator

/BxGC/BxGC.h
/core
/core/array-builder

C:brixGCSetHeapGoal(1073741824)

. scalars [ImmutableArray'Int]
. names [ImmutableArray'String]
. checksum = 0 as Size
for round in 0 .. < 32
    . scalar-builder = ArrayBuilder'Int()
    scalar-builder.reserve(524288)
    . name-builder = ArrayBuilder'String()
    name-builder.reserve(524288)
    for index in 0 .. < 4
        scalar-builder.append(round * 4 + index)
        name-builder.append("name $round $index")
    scalars += scalar-builder.finish-immutable-compacted()
    names += name-builder.finish-immutable-compacted()

C:brixGCCollect()
C:brixGCScavenge()

for items in scalars
    for item in items
        checksum += item as Size
for items in names
    for item in items
        checksum += item.length

-- "bench-result allocation/array-builder-compacted checksum=$checksum"
