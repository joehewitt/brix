; benchmark.meta description: Consumes streams into mutable and immutable arena arrays with four capacity hints.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: allocator
(blank)
(import /core)
(import /core/arena)
(import /core/array-builder)
(blank)

(main
  (let arena (use (call Arena)))
  (blank)
  (let checksum 0i64)
  (for (in round (..< 0 100))
    (for (in capacity (list 0 1 65 256))
      (let mutable (call collect-mutable arena (?> (..< 0 32) (< each 0)) capacity))
      (let immutable (call collect-immutable arena (?> (..< 0 32) (< each 0)) capacity))
      (+= checksum (+ (. mutable length) (. immutable length)))
      (for (in item mutable)
        (+= checksum item)
      )
      (for (in item immutable)
        (+= checksum item)
      )
    )
    (call (. arena reset))
  )
  (blank)
  (print (str "bench-result allocation/array-stream-arena-empty checksum=" checksum))
)

(fn-do + collect-mutable (of Array Int ArenaBacking) @inline
  (param arena Arena)
  (param items (stream Int))
  (param capacity Size)
  (return (call Array arena items capacity))
)

(fn-do + collect-immutable (of ImmutableArray Int ArenaBacking) @inline
  (param arena Arena)
  (param items (stream Int))
  (param capacity Size)
  (return (call ImmutableArray arena items capacity))
)
