; benchmark.meta description: Keeps compacted ArrayBuilder results of four items from builders that reserved about 4 MB each, collects, and reports what stays live.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: memory,allocator
(blank)
(import /BxGC/BxGC.h)
(import /core)
(import /core/array-builder)
(blank)

(main
  (call C:brixGCSetHeapGoal 1073741824)
  (blank)
  (let scalars (list (of ImmutableArray Int)))
  (let names (list (of ImmutableArray String)))
  (let checksum (as 0 Size))
  (for (in round (..< 0 32))
    (let scalar-builder (call (of ArrayBuilder Int)))
    (call (. scalar-builder reserve) 524288)
    (let name-builder (call (of ArrayBuilder String)))
    (call (. name-builder reserve) 524288)
    (for (in index (..< 0 4))
      (call (. scalar-builder append) (+ (* round 4) index))
      (call (. name-builder append) (str "name " round " " index))
    )
    (+= scalars (call (. scalar-builder finish-immutable-compacted)))
    (+= names (call (. name-builder finish-immutable-compacted)))
  )
  (blank)
  (call C:brixGCCollect)
  (call C:brixGCScavenge)
  (blank)
  (for (in items scalars)
    (for (in item items)
      (+= checksum (as item Size))
    )
  )
  (for (in items names)
    (for (in item items)
      (+= checksum (. item length))
    )
  )
  (blank)
  (print (str "bench-result allocation/array-builder-compacted checksum=" checksum))
)
