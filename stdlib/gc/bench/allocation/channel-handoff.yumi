`benchmark.meta description: Passes values between two tasks over unbuffered channels on one scheduler queue.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/channel
/core/task

. rounds = 1000000
. requests SyncChannel'Int
. replies SyncChannel'Int

do new
    for value in requests
        replies <- value + 1

. checksum = 0
for round in 0 .. < rounds
    requests <- round
    checksum = (checksum + (<- replies)!) % 1000003
requests.close()

-- "bench-result allocation/channel-handoff checksum=$checksum"
