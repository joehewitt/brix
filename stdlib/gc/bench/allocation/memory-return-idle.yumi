`benchmark.meta description: Grows the heap with about 400 MB of live 64 KB arrays, drops them, collects once so the goal falls, then idles in the event loop for one second so the automatic scavenger can return the surplus before exit.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: memory,gc-runtime

/BxGC/BxGC.h
/time/duration

. checksum = allocate-and-drop(6000, 65536)
C:brixGCCollect()
1s.wait()
-- "bench-result allocation/memory-return-idle checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do allocate-and-drop Size
    - chunk-count Size
    - chunk-size Size

. held [Byte[]]
. checksum = 0 as Size
for index in 0 .. < chunk-count
    . bytes = Byte[chunk-size]
    bytes[0] = (index % 251) as U8
    bytes[chunk-size - 1] = ((index * 3) % 251) as U8
    checksum += (bytes[0] as Size) + (bytes[chunk-size - 1] as Size) + index
    held += bytes

checksum += held.length * chunk-size
= checksum
