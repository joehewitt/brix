`benchmark.meta description: Consumes streams into mutable and immutable arena arrays with four capacity hints.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: allocator

/core
/core/arena
/core/array-builder

. arena = use Arena()

. checksum = 0i64
for round in 0 .. < 100
    for capacity in [0, 1, 65, 256]
        . mutable = collect-mutable(arena, ((0 .. < 32) ?> (each < 0)), capacity)
        . immutable = collect-immutable(arena, ((0 .. < 32) ?> (each < 0)), capacity)
        checksum += mutable.length + immutable.length
        for item in mutable
            checksum += item
        for item in immutable
            checksum += item
    arena.reset()

-- "bench-result allocation/array-stream-arena-empty checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do collect-mutable Array'Int'ArenaBacking @inline
    - arena Arena
    - items <Int>
    - capacity Size

= Array(arena, items, capacity)

━━━━━━━━━━━━━━━━━━━━
+ do collect-immutable ImmutableArray'Int'ArenaBacking @inline
    - arena Arena
    - items <Int>
    - capacity Size

= ImmutableArray(arena, items, capacity)
