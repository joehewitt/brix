`benchmark.meta description: Consumes streams into mutable and immutable gc arrays with four capacity hints.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: allocator

/core
/core/arena
/core/array-builder

. checksum = 0i64
for round in 0 .. < 100
    for capacity in [0, 1, 65, 256]
        . mutable = collect-mutable(((0 .. < 65) ?> (each >= 0)), capacity)
        . immutable = collect-immutable(((0 .. < 65) ?> (each >= 0)), capacity)
        checksum += mutable.length + immutable.length
        for item in mutable
            checksum += item
        for item in immutable
            checksum += item

-- "bench-result allocation/array-stream-gc-growth checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do collect-mutable Array'Int @inline
    - items <Int>
    - capacity Size

= Array(items, capacity)

━━━━━━━━━━━━━━━━━━━━
+ do collect-immutable ImmutableArray'Int @inline
    - items <Int>
    - capacity Size

= ImmutableArray(items, capacity)
