`benchmark.meta description: Builds and collects repeated pointerful object graphs for end-to-end GC tax measurement.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gc-runtime,allocator,compile-timing

/BxCore/BxCore.h

. rounds = 12
. width = 6000
. checksum = 0 as Size
. survivors [GCIntensiveNode]

for round in 0 .. < rounds
    . wave [GCIntensiveNode]
    for index in 0 .. < width
        . node = GCIntensiveNode(round * width + index)
        node.payload = Byte[(index % 29) + 24]
        if index > 0
            node.left = wave[index / 2]
        if survivors.length > 0
            node.prior = survivors[index % survivors.length]
        wave += node

    survivors.clear()
    for index in 0 .. < 64
        . node = wave[(index * 89) % width]
        survivors += node
        checksum += node.score + round + index

    C:brixCollect()

for node in survivors
    checksum += node.score

-- "bench-result allocation/gc-intensive checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ GCIntensiveNode

+ id Int
+ left GCIntensiveNode?
+ prior GCIntensiveNode?
+ payload Byte[]
+ score => id + payload.length + (left?.id ?? 0) + (prior?.id ?? 0)

────────────────────
+ This
    - id

