; benchmark.meta description: Raw integer bit writes and reads for the Bitmap allocation baseline.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: allocator
(blank)
(import /core)
(blank)

(main
  (let checksum U64)
  (for (in round (..< 0 10000))
    (let bits U64)
    (for (in index (..< 0 64))
      (= bits (/or/ bits (/lshift/ 1ul index)))
    )
    (for (in index (..< 0 64))
      (+= checksum (/and/ (/rshift/ bits index) 1))
    )
    (= bits 0)
    (+= checksum bits)
  )
  (blank)
  (print (str "bench-result allocation/bitmap-raw checksum=" checksum))
)
