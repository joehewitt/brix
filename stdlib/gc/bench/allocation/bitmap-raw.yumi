`benchmark.meta description: Raw integer bit writes and reads for the Bitmap allocation baseline.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: allocator

/core

. checksum U64
for round in 0 .. < 10000
    . bits U64
    for index in 0 .. < 64
        bits = bits /or/ (1ul /lshift/ index)
    for index in 0 .. < 64
        checksum += (bits /rshift/ index) /and/ 1
    bits = 0
    checksum += bits

-- "bench-result allocation/bitmap-raw checksum=$checksum"
