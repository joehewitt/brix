`benchmark.meta description: Allocates fixed-size objects containing a managed pointer.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gc-runtime,allocator

. iterations = 50000
. checksum = 0 as Size
for i in 0 .. < iterations
    . node = PointerBox(i, Pointer())
    checksum += node.value

-- "bench-result allocation/fixed-object-pointerful checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ PointerBox

+ value = 0
+ reference Pointer

────────────────────
+ This
    - v
    - r Pointer

value = v
reference = r
