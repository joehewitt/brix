; benchmark.meta description: Allocates and mutates fixed-size buffers.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gc-runtime,allocator
(blank)

(main
  (let iterations 50000)
  (let checksum (as 0 Size))
  (for (in i (..< 0 iterations))
    (let buffer ([] Int 8))
    (= ([] buffer 0) i)
    (= ([] buffer 7) (+ i 7))
    (+= checksum (+ ([] buffer 0) ([] buffer 7)))
  )
  (blank)
  (print (str "bench-result allocation/fixed-buffer checksum=" checksum))
)
