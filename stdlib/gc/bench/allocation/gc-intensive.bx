; benchmark.meta description: Builds and collects repeated pointerful object graphs for end-to-end GC tax measurement.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gc-runtime,allocator,compile-timing
(blank)
(import /BxCore/BxCore.h)
(blank)

(main
  (let rounds 12)
  (let width 6000)
  (let checksum (as 0 Size))
  (let survivors (list GCIntensiveNode))
  (blank)
  (for (in round (..< 0 rounds))
    (let wave (list GCIntensiveNode))
    (for (in index (..< 0 width))
      (let node (call GCIntensiveNode (+ (* round width) index)))
      (= (. node payload) ([] Byte (+ (% index 29) 24)))
      (if (> index 0)
        (= (. node left) ([] wave (/ index 2)))
      )
      (if (> (. survivors length) 0)
        (= (. node prior) ([] survivors (% index (. survivors length))))
      )
      (+= wave node)
    )
    (blank)
    (call (. survivors clear))
    (for (in index (..< 0 64))
      (let node ([] wave (% (* index 89) width)))
      (+= survivors node)
      (+= checksum (+ (. node score) round index))
    )
    (blank)
    (call C:brixCollect)
  )
  (blank)
  (for (in node survivors)
    (+= checksum (. node score))
  )
  (blank)
  (print (str "bench-result allocation/gc-intensive checksum=" checksum))
)

(type + GCIntensiveNode
  (prop + id Int)
  (prop + left (? GCIntensiveNode))
  (prop + prior (? GCIntensiveNode))
  (prop + payload ([] Byte))
  (prop + score _ (=> (+ id (. payload length) (?? (?. left id) 0) (?? (?. prior id) 0))))
  (fn-do + This _
    (param id _)
  )
)
