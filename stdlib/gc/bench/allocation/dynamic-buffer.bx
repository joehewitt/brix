; benchmark.meta description: Allocates and mutates buffers whose sizes vary at runtime.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gc-runtime,allocator
(blank)

(main
  (let iterations 35000)
  (let checksum (as 0 Size))
  (for (in i (..< 0 iterations))
    (let count (+ (% i 16) 1))
    (let buffer ([] Int count))
    (= ([] buffer 0) i)
    (= ([] buffer (- count 1)) count)
    (+= checksum (+ ([] buffer 0) ([] buffer (- count 1))))
  )
  (blank)
  (print (str "bench-result allocation/dynamic-buffer checksum=" checksum))
)
