; benchmark.meta description: Mutates a stable pointer graph before and during a concurrent mark window.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gc-runtime,allocator,compile-timing
(blank)
(import /BxGC/BxGCTest.h)
(blank)

(main
  (let count 4096)
  (let passes 32)
  (let nodes (list StoreNode))
  (blank)
  (call C:brixGCSetHeapGoal 1073741824)
  (blank)
  (for (in index (..< 0 count))
    (+= nodes (call StoreNode index))
  )
  (blank)
  (for (in index (..< 0 count))
    (= (. ([] nodes index) left) ([] nodes (% (+ index 1) count)))
    (= (. ([] nodes index) right) ([] nodes (% (- (+ index count) 1) count)))
  )
  (blank)
  (call C:brixBenchMutatorPhaseStart "idle")
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 count))
      (let node ([] nodes index))
      (= (. node left) ([] nodes (% (+ index pass 3) count)))
      (= (. node right) ([] nodes (% (+ (* index 5) pass 1) count)))
    )
  )
  (call C:brixBenchMutatorPhaseEnd "idle")
  (blank)
  (call C:brixGCStartConcurrentMark)
  (blank)
  (call C:brixBenchMutatorPhaseStart "mark-window")
  (for (in pass (..< 0 passes))
    (for (in index (..< 0 count))
      (let node ([] nodes index))
      (= (. node left) ([] nodes (% (+ (* index 7) pass 11) count)))
      (= (. node right) ([] nodes (% (- (+ index count) pass 1) count)))
    )
  )
  (call C:brixBenchMutatorPhaseEnd "mark-window")
  (blank)
  (call C:brixGCFinishConcurrentMark)
  (call C:brixGCCollect)
  (blank)
  (let checksum (as (. nodes length) Size))
  (for (in node nodes)
    (+= checksum (+ (. node id) (?? (?. (. node left) id) 0) (?? (?. (. node right) id) 0)))
  )
  (blank)
  (print (str "bench-result allocation/store-intensive checksum=" checksum))
)

(type + StoreNode
  (prop + id Int)
  (prop + left (? StoreNode))
  (prop + right (? StoreNode))
  (fn-do + This _
    (param id _)
  )
)
