`benchmark.meta description: Inserts and retrieves 80,000 mixed-width keys to expose Map growth.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: allocator

/core

. count = 80000
. map = Map'U64'U64()

for i in 0 .. < count
    . key = (i as U64) + ((i % 17) as U64) * 4294967296
    map[key] = i as U64

. checksum = map.length as U64
for i in 0 .. < count
    . key = (i as U64) + ((i % 17) as U64) * 4294967296
    checksum += map[key]!

-- "bench-result allocation/map-growth checksum=$checksum"
