`benchmark.meta description: Allocates and mutates fixed-size buffers.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gc-runtime,allocator

. iterations = 50000
. checksum = 0 as Size
for i in 0 .. < iterations
    . buffer = Int[8]
    buffer[0] = i
    buffer[7] = i + 7
    checksum += buffer[0] + buffer[7]

-- "bench-result allocation/fixed-buffer checksum=$checksum"
