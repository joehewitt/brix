`benchmark.meta description: Mutates a stable pointer graph before and during a concurrent mark window.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gc-runtime,allocator,compile-timing

/YuGC/YuGCTest.h

. count = 4096
. passes = 32
. nodes [StoreNode]

C:yumiGCSetHeapGoal(1073741824)

for index in 0 .. < count
    nodes += StoreNode(index)

for index in 0 .. < count
    nodes[index].left = nodes[(index + 1) % count]
    nodes[index].right = nodes[(index + count - 1) % count]

C:yumiBenchMutatorPhaseStart("idle")
for pass in 0 .. < passes
    for index in 0 .. < count
        . node = nodes[index]
        node.left = nodes[(index + pass + 3) % count]
        node.right = nodes[(index * 5 + pass + 1) % count]
C:yumiBenchMutatorPhaseEnd("idle")

C:yumiGCStartConcurrentMark()

C:yumiBenchMutatorPhaseStart("mark-window")
for pass in 0 .. < passes
    for index in 0 .. < count
        . node = nodes[index]
        node.left = nodes[(index * 7 + pass + 11) % count]
        node.right = nodes[(index + count - pass - 1) % count]
C:yumiBenchMutatorPhaseEnd("mark-window")

C:yumiGCFinishConcurrentMark()
C:yumiGCCollect()

. checksum = nodes.length as Size
for node in nodes
    checksum += node.id + (node.left?.id ?? 0) + (node.right?.id ?? 0)

-- "bench-result allocation/store-intensive checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ StoreNode

+ id Int
+ left StoreNode?
+ right StoreNode?

────────────────────
+ This
    - id
