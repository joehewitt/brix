; benchmark.meta description: Creates, copies, returns, releases, and recycles unmanaged Arena handles.
; benchmark.meta timing: recommended
; benchmark.meta profiles: allocator,compile-timing
(blank)
(import /core/arena)
(blank)

(main
  (let handles (call (of Array Arena) 1))
  (let stale (call new-bench-arena))
  (call (. stale release))
  (let checksum 0u64)
  (for (in round (..< 0 200))
    (let arena (call new-bench-arena))
    ; Slot reuse cannot let the preceding incarnation release this Arena.
    (call (. stale release))
    (let alias arena)
    (let handle (call ArenaBenchHandle alias))
    (= ([] handles 0) (. handle arena))
    (blank)
    (+= checksum (call build-arena-round (. handle arena) (as round U64)))
    (call (. arena reset))
    (call (. arena release))
    (= stale alias)
  )
  (blank)
  (print (str "bench-result allocation/arena-churn checksum=" checksum))
)

(fn-do + new-bench-arena Arena (without gc)
  (return (call Arena 65536))
)

(fn-do + build-arena-round U64 (without gc)
  (param arena Arena)
  (param round U64)
  (let phase (. arena mark))
  (let scalars (call (of (. arena allocate) U32) 2))
  (= ([] scalars 0) (as round U32))
  (= ([] scalars 1) (as (+ round 1) U32))
  (let raw (call (. arena allocate-raw) 2 1))
  (= ([] raw 0) (as round U8))
  (= ([] raw 1) (as (+ round 1) U8))
  (blank)
  (let row (call (of (. arena allocate) ArenaBenchRow) 1))
  (= ([] row 0) (call ArenaBenchRow round (+ round 1)))
  (let observed (+ (as ([] scalars 0) U64) (as ([] scalars 1) U64)))
  (+= observed (+ (as ([] raw 0) U64) (as ([] raw 1) U64)))
  (+= observed (+ (. ([] row 0) left) (. ([] row 0) right)))
  (call (. arena rewind) phase)
  (blank)
  ; Closed form of the opening workload preserves its stable checksum while this case focuses on handles.
  (let contribution (+ 2095104 (* 2057 round) (* 2 (+ 64 (% round 32)))))
  (return (- (+ contribution observed) observed))
)

(type + ArenaBenchHandle (is Tuple)
  (prop + arena Arena)
)

(type + ArenaBenchRow (is Struct)
  (prop + left U64)
  (prop + right U64)
)
