; benchmark.meta description: Builds and walks a connected object graph to expose allocation pressure.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gc-runtime,allocator
(blank)
(import /BxCore/BxCore.h)
(blank)

(main
  (let roots (list BenchNode))
  (let index (map String BenchNode))
  (let checksum (as 0 Size))
  (blank)
  (for (in i (..< 0 1800))
    (let node (call BenchNode i (str "node-" i)))
    (= (. node payload) (call Payload (str "payload-" i) ([] Byte (+ (% i 31) 8))))
    (if (> (. roots length) 0)
      (= (. node parent) ([] roots (- (. roots length) 1)))
    )
    (+= roots node)
    (= ([] index (. node name)) node)
    (+= checksum (. node score))
  )
  (blank)
  (for (in i (..< 0 (. roots length)))
    (let node ([] roots i))
    (+= (. node tags) (str "tag-" (% i 7)))
    (+= (. node tags) (str "bucket-" (% i 13)))
    (if (> i 2)
      (+= (. node links) ([] roots (- i 1)))
      (+= (. node links) ([] roots (/ i 2)))
    )
    (+= checksum (+ (. node score) (. node tags length) (. node links length)))
  )
  (blank)
  (for (in (tuple key node) index)
    (+= checksum (+ (. key length) (. node score)))
  )
  (blank)
  (call C:brixBenchCollect)
  (blank)
  (print (str "bench-result allocation/object-graph checksum=" checksum))
)

(type + BenchNode
  (prop + id Int)
  (prop + name String)
  (prop + parent (? BenchNode))
  (prop + links (list BenchNode))
  (prop + tags (list String))
  (prop + payload (? Payload))
  (prop + score _ (=> (+ id (. name length) (. links length) (. tags length))))
  (fn-do + This _
    (param id _)
    (param name _)
  )
)

(type + Payload
  (prop + label String)
  (prop + bytes ([] Byte))
  (fn-do + This _
    (param label _)
    (param bytes _)
  )
)
