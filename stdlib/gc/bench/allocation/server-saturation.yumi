`benchmark.meta description: Keeps four scheduler workers runnable while they allocate request graphs.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gc-runtime,allocator,compile-timing

/YuCore/YuCore.h
/core/channel
/core/task

. lane-count = 4
. requests-per-lane = 8000
. worker = Worker(lane-count)
. results SyncChannel'ServerResult
. checksums = Array'Size(lane-count)

for lane in 0 .. < lane-count
    do (worker) new run-server-task(lane, requests-per-lane, results)

for lane in 0 .. < lane-count
    . result-lane, result-checksum = <- results
    checksums[result-lane] = result-checksum

worker.stop()

. checksum = 0 as Size
for lane in 0 .. < lane-count
    checksum += checksums[lane] * (lane + 1)

C:yumiBenchCollect()

-- "bench-result allocation/server-saturation checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do run-server-task
    - lane Int
    - request-count Int
    - results SyncChannel'ServerResult

results <- ServerResult(lane, run-server-lane(lane, request-count))

━━━━━━━━━━━━━━━━━━━━
_ do run-server-lane Size
    - lane Int
    - request-count Int

. checksum = 0 as Size
. retained [ServerPacket]

for request in 0 .. < request-count
    . packet = ServerPacket(lane, request, "lane-${lane}-request-${request}")
    if retained.length > 0
        packet.prior = retained[retained.length - 1]
    retained += packet
    if retained.length == 64
        checksum += packet.score + retained[0].score
        retained.clear()

= checksum + retained.length

━━━━━━━━━━━━━━━━━━━━
+ ServerResult is (lane Index, checksum Size)

━━━━━━━━━━━━━━━━━━━━
+ ServerPacket

+ lane Int
+ request Int
+ label String
+ prior ServerPacket?
+ score => lane + request + label.length + (prior?.request ?? 0)

────────────────────
+ This
    - lane
    - request
    - label
