`benchmark.meta description: Builds the collect-accumulator lists and text with pipelines and comprehensions.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

. rows = collect-pipeline-rows()
. checksum = 0 as Size
for iteration in 0 .. < 4000
    . labels = collect-pipeline-labels(rows)
    . depths = collect-pipeline-depths(rows)
    checksum += labels.length + depths.length + collect-pipeline-text(rows).length

-- "bench-result allocation/collect-pipeline checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ CollectPipelineRow is Tuple

+ name String
+ depth Size
+ is-live Bool

━━━━━━━━━━━━━━━━━━━━
_ collect-pipeline-labels [String]
    - rows [CollectPipelineRow]

** rows
?> each.is-live
*> "${each.name}:${each.depth}"
|> List

━━━━━━━━━━━━━━━━━━━━
_ collect-pipeline-depths [Size]
    - rows [CollectPipelineRow]

** rows
?> each.depth > 2
*> each.depth * 2
|> List

━━━━━━━━━━━━━━━━━━━━
_ collect-pipeline-text String
    - rows [CollectPipelineRow]

" ".join(each.name in rows when each.is-live)

━━━━━━━━━━━━━━━━━━━━
_ collect-pipeline-rows [CollectPipelineRow]

** 0 .. < 400
*> CollectPipelineRow("row-$each", each % 7, each % 3 != 0)
|> List
