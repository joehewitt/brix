`benchmark.meta description: Allocates a mix of fixed object shapes and descriptor identities.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gc-runtime,allocator

. iterations = 50000
. checksum = 0 as Size
for i in 0 .. < iterations
    . choice = i % 8
    if choice == 0
        . item = Shape0(i)
        checksum += item.a
    else if choice == 1
        . item = Shape1(i)
        checksum += item.a + item.b
    else if choice == 2
        . item = Shape2(i)
        checksum += item.a + item.c
    else if choice == 3
        . item = Shape3(i)
        checksum += item.a + item.d
    else if choice == 4
        . item = Shape4(i)
        checksum += item.a + item.e
    else if choice == 5
        . item = Shape5(i)
        checksum += item.a + item.f
    else if choice == 6
        . item = Shape6(i)
        checksum += item.a + item.g
    else
        . item = Shape7(i)
        checksum += item.a + item.h

-- "bench-result allocation/descriptor-shape-mix checksum=$checksum"

