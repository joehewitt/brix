; benchmark.meta description: Keeps four scheduler workers runnable while they allocate request graphs.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gc-runtime,allocator,compile-timing
(blank)
(import /BxCore/BxCore.h)
(import /core/channel)
(import /core/task)
(blank)

(main
  (let lane-count 4)
  (let requests-per-lane 8000)
  (let worker (call Worker lane-count))
  (let results (of SyncChannel ServerResult))
  (let checksums (call (of Array Size) lane-count))
  (blank)
  (for (in lane (..< 0 lane-count))
    (do-new (worker: worker)
      (inline (call run-server-task lane requests-per-lane results))
    )
  )
  (blank)
  (for (in lane (..< 0 lane-count))
    (let (tuple result-lane result-checksum) (<- results))
    (= ([] checksums result-lane) result-checksum)
  )
  (blank)
  (call (. worker stop))
  (blank)
  (let checksum (as 0 Size))
  (for (in lane (..< 0 lane-count))
    (+= checksum (* ([] checksums lane) (+ lane 1)))
  )
  (blank)
  (call C:brixBenchCollect)
  (blank)
  (print (str "bench-result allocation/server-saturation checksum=" checksum))
)

(fn-do _ run-server-task _
  (param lane Int)
  (param request-count Int)
  (param results (of SyncChannel ServerResult))
  (<- results (call ServerResult lane (call run-server-lane lane request-count)))
)

(fn-do _ run-server-lane Size
  (param lane Int)
  (param request-count Int)
  (let checksum (as 0 Size))
  (let retained (list ServerPacket))
  (blank)
  (for (in request (..< 0 request-count))
    (let packet (call ServerPacket lane request (str "lane-" lane "-request-" request)))
    (if (> (. retained length) 0)
      (= (. packet prior) ([] retained (- (. retained length) 1)))
    )
    (+= retained packet)
    (if (== (. retained length) 64)
      (+= checksum (+ (. packet score) (. ([] retained 0) score)))
      (call (. retained clear))
    )
  )
  (blank)
  (return (+ checksum (. retained length)))
)

(type + ServerResult (is (tuple (: lane Index) (: checksum Size))))

(type + ServerPacket
  (prop + lane Int)
  (prop + request Int)
  (prop + label String)
  (prop + prior (? ServerPacket))
  (prop + score _ (=> (+ lane request (. label length) (?? (?. prior request) 0))))
  (fn-do + This _
    (param lane _)
    (param request _)
    (param label _)
  )
)
