`benchmark.meta description: Publishes one task-owned temporary root per shim iteration.
`benchmark.meta timing: recommended
`benchmark.meta profiles: temporary-roots

/BxCore/BxCore.h

. pointer = "temporary-root-shim-one"
. root-count = 1
. iterations = 4000000

C:brixBenchTemporaryRootShim(pointer, root-count, 1)
C:brixBenchResetTemporaryRootMetrics()
. checksum = C:brixBenchTemporaryRootShim(pointer, root-count, iterations)

-- "bench-result gc/temporary-root-shim checksum=$checksum"
