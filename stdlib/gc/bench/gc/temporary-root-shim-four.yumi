`benchmark.meta description: Publishes four nested task-owned temporary roots per shim iteration.
`benchmark.meta timing: recommended
`benchmark.meta profiles: temporary-roots

/BxCore/BxCore.h

. pointer = "temporary-root-shim-four"
. root-count = 4
. iterations = 1000000

C:brixBenchTemporaryRootShim(pointer, root-count, 1)
C:brixBenchResetTemporaryRootMetrics()
. checksum = C:brixBenchTemporaryRootShim(pointer, root-count, iterations)

-- "bench-result gc/temporary-root-shim-four checksum=$checksum"
