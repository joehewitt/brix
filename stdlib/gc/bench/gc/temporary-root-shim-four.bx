; benchmark.meta description: Publishes four nested task-owned temporary roots per shim iteration.
; benchmark.meta timing: recommended
; benchmark.meta profiles: temporary-roots
(blank)
(import /BxCore/BxCore.h)
(blank)

(main
  (let pointer "temporary-root-shim-four")
  (let root-count 4)
  (let iterations 1000000)
  (blank)
  (call C:brixBenchTemporaryRootShim pointer root-count 1)
  (call C:brixBenchResetTemporaryRootMetrics)
  (let checksum (call C:brixBenchTemporaryRootShim pointer root-count iterations))
  (blank)
  (print (str "bench-result gc/temporary-root-shim-four checksum=" checksum))
)
