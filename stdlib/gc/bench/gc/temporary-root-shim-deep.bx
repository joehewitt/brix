; benchmark.meta description: Publishes 32 nested roots to exercise temporary-root overflow storage.
; benchmark.meta timing: recommended
; benchmark.meta profiles: temporary-roots
(blank)
(import /BxCore/BxCore.h)
(blank)

(main
  (let pointer "temporary-root-shim-deep")
  (let root-count 32)
  (let iterations 125000)
  (blank)
  (call C:brixBenchTemporaryRootShim pointer root-count 1)
  (call C:brixBenchResetTemporaryRootMetrics)
  (let checksum (call C:brixBenchTemporaryRootShim pointer root-count iterations))
  (blank)
  (print (str "bench-result gc/temporary-root-shim-deep checksum=" checksum))
)
