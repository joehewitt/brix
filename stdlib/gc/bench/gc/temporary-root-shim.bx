; benchmark.meta description: Publishes one task-owned temporary root per shim iteration.
; benchmark.meta timing: recommended
; benchmark.meta profiles: temporary-roots
(blank)
(import /BxCore/BxCore.h)
(blank)

(main
  (let pointer "temporary-root-shim-one")
  (let root-count 1)
  (let iterations 4000000)
  (blank)
  (call C:brixBenchTemporaryRootShim pointer root-count 1)
  (call C:brixBenchResetTemporaryRootMetrics)
  (let checksum (call C:brixBenchTemporaryRootShim pointer root-count iterations))
  (blank)
  (print (str "bench-result gc/temporary-root-shim checksum=" checksum))
)
