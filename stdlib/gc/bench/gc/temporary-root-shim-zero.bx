; benchmark.meta description: Measures temporary-root shim call overhead with zero roots.
; benchmark.meta timing: recommended
; benchmark.meta profiles: temporary-roots
(blank)
(import /BxCore/BxCore.h)
(blank)

(main
  (let pointer "temporary-root-shim-zero")
  (let root-count 0)
  (let iterations 4000000)
  (blank)
  (call C:brixBenchTemporaryRootShim pointer root-count 1)
  (call C:brixBenchResetTemporaryRootMetrics)
  (let checksum (call C:brixBenchTemporaryRootShim pointer root-count iterations))
  (blank)
  (print (str "bench-result gc/temporary-root-shim-zero checksum=" checksum))
)
