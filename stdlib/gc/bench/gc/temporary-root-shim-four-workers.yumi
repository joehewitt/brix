`benchmark.meta description: Publishes four nested temporary roots across four scheduler workers.
`benchmark.meta timing: recommended
`benchmark.meta profiles: temporary-roots

/BxCore/BxCore.h
/core/channel
/core/task

. worker-count = 4
. root-count = 4
. iterations = 250000
. worker = Worker(worker-count)
. ready SyncChannel'Int
. start SyncChannel'Int
. results SyncChannel'Size

for lane in 0 .. < worker-count
    do (worker) new run-temporary-root-worker(lane, root-count, iterations, ready, start, results)
for lane in 0 .. < worker-count
    <- ready

C:brixBenchResetTemporaryRootMetrics()
for lane in 0 .. < worker-count
    start <- lane

. checksum = 0 as Size
for lane in 0 .. < worker-count
    checksum += (<- results)!
worker.stop()

-- "bench-result gc/temporary-root-shim-four-workers checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do run-temporary-root-worker
    - lane Int
    - root-count Int
    - iterations Int
    - ready SyncChannel'Int
    - start SyncChannel'Int
    - results SyncChannel'Size

. pointer = "temporary-root-worker-$lane"
C:brixBenchTemporaryRootShim(pointer, root-count, 1)
ready <- lane
<- start
C:brixBenchResetActiveTemporaryRootMetrics()
results <- (C:brixBenchTemporaryRootShim(pointer, root-count, iterations) as Size)
