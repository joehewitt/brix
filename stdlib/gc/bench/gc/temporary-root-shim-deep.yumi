`benchmark.meta description: Publishes 32 nested roots to exercise temporary-root overflow storage.
`benchmark.meta timing: recommended
`benchmark.meta profiles: temporary-roots

/YuCore/YuCore.h

. pointer = "temporary-root-shim-deep"
. root-count = 32
. iterations = 125000

C:yumiBenchTemporaryRootShim(pointer, root-count, 1)
C:yumiBenchResetTemporaryRootMetrics()
. checksum = C:yumiBenchTemporaryRootShim(pointer, root-count, iterations)

-- "bench-result gc/temporary-root-shim-deep checksum=$checksum"
