; benchmark.meta description: Measures zero-root shim overhead across four scheduler workers.
; benchmark.meta timing: recommended
; benchmark.meta profiles: temporary-roots
(blank)
(import /BxCore/BxCore.h)
(import /core/channel)
(import /core/task)
(blank)

(main
  (let worker-count 4)
  (let root-count 0)
  (let iterations 1000000)
  (let worker (call Worker worker-count))
  (let ready (of SyncChannel Int))
  (let start (of SyncChannel Int))
  (let results (of SyncChannel Size))
  (blank)
  (for (in lane (..< 0 worker-count))
    (do-new (worker: worker)
      (inline (call run-temporary-root-worker lane root-count iterations ready start results))
    )
  )
  (for (in lane (..< 0 worker-count))
    (<- ready)
  )
  (blank)
  (call C:brixBenchResetTemporaryRootMetrics)
  (for (in lane (..< 0 worker-count))
    (<- start lane)
  )
  (blank)
  (let checksum (as 0 Size))
  (for (in lane (..< 0 worker-count))
    (+= checksum (!! (<- results)))
  )
  (call (. worker stop))
  (blank)
  (print (str "bench-result gc/temporary-root-shim-zero-workers checksum=" checksum))
)

(fn-do _ run-temporary-root-worker _
  (param lane Int)
  (param root-count Int)
  (param iterations Int)
  (param ready (of SyncChannel Int))
  (param start (of SyncChannel Int))
  (param results (of SyncChannel Size))
  (let pointer (str "temporary-root-worker-" lane))
  (call C:brixBenchTemporaryRootShim pointer root-count 1)
  (<- ready lane)
  (<- start)
  (call C:brixBenchResetActiveTemporaryRootMetrics)
  (<- results (as (call C:brixBenchTemporaryRootShim pointer root-count iterations) Size))
)
