/BxGC/BxGC.h
/core/core
/core/error
/core/function
+ /core/gc
/core/intrinsics
/core/number
/core/range

━━━━━━━━━━━━━━━━━━━━
+ CleanupFunction'State is () Void
    - state State

━━━━━━━━━━━━━━━━━━━━
+ CleanupHandle

_ native Size

────────────────────
_ This

────────────────────
+ get is-valid

native != 0

────────────────────
+ do cancel Bool

=? if !native
. canceled = C:brixGCCancelCleanup(native)
if canceled
    native = 0
= canceled

────────────────────
_ do activate
    - value Size

native = value

────────────────────
_ do retire

native = 0

━━━━━━━━━━━━━━━━━━━━
+ do on-reclaim'Target'State CleanupHandle
    - target Target
    - state State
    - cleanup

. handle = CleanupHandle()
. context = CleanupContext(=> gc-cleanup-succeeded(cleanup, state), handle)
. target-pointer = target as Pointer
. context-pointer = context as Pointer
. callback = gc-cleanup-invoke as GCManagedCleanupCallback
. native = C:brixGCRegisterCleanup(target-pointer, context-pointer, callback)
if !native
    ?! Error("Cleanup state must not retain its target")
handle.activate(native as Size)
= handle

━━━━━━━━━━━━━━━━━━━━
+ do gc-register-managed-context-cleanup'Context Size
    - target-pointer Pointer
    - context Context
    - callback GCManagedCleanupCallback

` Internal zero-managed-allocation registration path for stdlib owners that already have a safe
` managed context object. The runtime roots context and rejects any path from it back to target.

= C:brixGCRegisterCleanup(target-pointer, context as Pointer, callback)

━━━━━━━━━━━━━━━━━━━━
+ do cancel Bool
    - handle CleanupHandle

= handle.cancel()

━━━━━━━━━━━━━━━━━━━━
+ do collect-garbage

C:brixGCCollect()

━━━━━━━━━━━━━━━━━━━━
+ do return-free-memory

C:brixGCScavenge()

━━━━━━━━━━━━━━━━━━━━
+ do set-minimum-heap-goal
    - bytes Size

C:brixGCSetMinimumHeapGoal(bytes)

━━━━━━━━━━━━━━━━━━━━
+ do drain-reclaim-cleanups Size

= C:brixGCDrainCleanups() as Size

━━━━━━━━━━━━━━━━━━━━
+ GCMemory is Tuple

+ live UInt
+ goal UInt
+ committed UInt
+ in-spans UInt
+ free UInt
+ free-runs UInt
+ largest-free-run UInt
+ peak-demand UInt
+ retention UInt
+ debt UInt
+ footprint UInt
+ collections UInt

━━━━━━━━━━━━━━━━━━━━
+ gc-memory GCMemory

GCMemory
    - live
    - goal
    - committed
    - in-spans
    - free
    - free-runs
    - largest-free-run
    - peak-demand
    - retention
    - debt
    - footprint
    - collections
.. live = C:brixGCLiveByteCount()
.. goal = C:brixGCHeapGoal()
.. committed = C:brixGCCommittedBytes()
.. in-spans = C:brixGCAllocatedPageBytes()
.. free = C:brixGCFreeCommittedBytes()
.. free-runs = C:brixGCFreeCommittedRunCount()
.. largest-free-run = C:brixGCLargestFreeCommittedRunBytes()
.. peak-demand = C:brixGCPeakDemandBytes()
.. retention = C:brixGCRetentionTargetBytes()
.. debt = C:brixGCScavengeDebtBytes()
.. footprint = C:brixGCRssBytes()
.. collections = C:brixGCCollectionCount()

━━━━━━━━━━━━━━━━━━━━
_ CleanupContext

_ callback Getter'Size
_ handle CleanupHandle

────────────────────
_ This
    - callback
    - handle

━━━━━━━━━━━━━━━━━━━━
_ CleanupSuccess

_ marker Size = 1

━━━━━━━━━━━━━━━━━━━━
_ do gc-cleanup-invoke Size
    - context-pointer Pointer

. context = gc-object-from-pointer'CleanupContext(context-pointer)
. callback = context.callback
context.handle.retire()
= callback()

━━━━━━━━━━━━━━━━━━━━
_ do gc-cleanup-succeeded'State Size
    - cleanup
    - state State

. result = catch? gc-run-cleanup(cleanup, state)
if !result
    C:brixGCReportCleanupException()
= 1

━━━━━━━━━━━━━━━━━━━━
_ do gc-run-cleanup'State CleanupSuccess
    - cleanup
    - state State

cleanup(state)
= CleanupSuccess()
