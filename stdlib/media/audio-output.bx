(import ./mixer)
(import ./ring)
(import /BxMedia/BxMedia.h)
(import /time/duration)
(blank)
(prop _ audio-pause Duration (= 2ms))

(type + AudioOutputError (is Error))

(type + AudioOutput
  (implements Closable)
  (prop + mixer Mixer)
  (prop + latency I64)
  (prop + is-running _ (= true))
  (prop _ ring MediaRing)
  (prop _ native (? Pointer))
  (prop _ closed-frames-played I64)
  (prop _ closed-underrun-frames I64)
  (prop _ closed-frames-heard I64)
  (prop _ worker Worker)
  (prop _ stopped (of SyncBufferedChannel Bool))
  (fn-do + This _ (?! Error)
    (param mixer Mixer)
    (param latency I64 (= 1024))
    (= (. this mixer) mixer)
    (= (. this latency) latency)
    (= ring (call MediaRing (* latency 2) 2))
    (call fill)
    (let output (call C:brixAudioOutputOpen (. ring native-pointer) (. mixer rate)))
    (let problem String (call C:brixAudioOutputGetError output))
    (if (> (. problem length) 0)
      (= is-running false)
      (call C:brixAudioOutputRelease output)
      (call (. ring close))
      (throw (call AudioOutputError problem))
    )
    (= native output)
    (= worker (call Worker))
    (do-new (worker: worker)
      (call pump)
    )
  )
  (fn-expr + frames-played I64 :get
    (if-expr output (call C:brixAudioOutputGetFramesPlayed output) closed-frames-played)
    (where
      (lazy output native)
    )
  )
  (fn-expr + underrun-frames I64 :get
    (if-expr output (call C:brixAudioOutputGetUnderrunFrames output) closed-underrun-frames)
    (where
      (lazy output native)
    )
  )
  (fn-expr + slice-frames I64 :get
    (if-expr output (call C:brixAudioOutputGetSliceFrames output) 0)
    (where
      (lazy output native)
    )
  )
  (fn-expr + frames-heard I64 :get
    (if-expr native (. ring consumed) closed-frames-heard)
  )
  (fn-do + listen _
    (param samples ([] F64))
    (let count (as (. samples length) I64))
    (let reach (if-expr (< count latency) count latency))
    (let last frames-heard)
    (let open (!= native null))
    (for (in index (..< 0 (. samples length)))
      (let at (+ (- last count) (as index I64)))
      (= ([] samples index) (if-expr (and open (>= at 0) (>= at (- last reach))) (call heard at) 0.0))
    )
  )
  (fn-expr _ heard F64
    (param at I64)
    (* (+ ([] frame 0) ([] frame 1)) 0.5)
    (where
      (lazy frame (call (. ring slot) at))
    )
  )
  (fn-do _ pump _
    (while is-running
      (call fill)
      (call (. audio-pause wait))
    )
    (<- stopped true)
  )
  (fn-do _ fill _
    (while (< (. ring filled) latency)
      (let start (. ring written))
      (let wanted (- latency (. ring filled)))
      (let count (if-expr (< wanted (. ring run)) wanted (. ring run)))
      (call (. mixer render) (call (. ring slot) start) count)
      (call (. ring publish) (+ start count))
    )
  )
  (fn-do + close _
    (let output native)
    (return-if (if (not output)))
    (= is-running false)
    (<- stopped)
    (call (. worker stop))
    (= closed-frames-played (call C:brixAudioOutputGetFramesPlayed output))
    (= closed-underrun-frames (call C:brixAudioOutputGetUnderrunFrames output))
    (= native null)
    (call C:brixAudioOutputRelease output)
    (= closed-frames-heard (. ring consumed))
    (call (. ring close))
  )
)
