(import /BxMedia/BxMedia.h)

(type + MediaRing
  (implements Closable)
  (prop + capacity I64)
  (prop + width I64)
  (prop _ native Pointer)
  (prop _ data (of CPointer F32))
  (prop _ is-closed _ (= false))
  (fn-do + This _
    (param capacity I64)
    (param width I64)
    (= (. this capacity) capacity)
    (= (. this width) width)
    (= native (call C:brixMediaRingCreate capacity width))
    (= data (call C:brixMediaRingGetData native))
  )
  (fn-expr + native-pointer Pointer :get
    native
  )
  (fn-expr + written I64 :get (without gc)
    (call C:brixMediaRingGetWritten native)
  )
  (fn-expr + consumed I64 :get (without gc)
    (call C:brixMediaRingGetConsumed native)
  )
  (fn-expr + filled I64 :get (without gc)
    (- written consumed)
  )
  (fn-expr + space I64 :get (without gc)
    (- capacity filled)
  )
  (fn-expr + run I64 :get (without gc)
    (- capacity (% written capacity))
  )
  (fn-expr + slot (of CPointer F32) (without gc)
    (param count I64)
    (+ data (* (% count capacity) width))
  )
  (fn-do + publish _ (without gc)
    (param count I64)
    (call C:brixMediaRingPublish native count)
  )
  (fn-do + consume _ (without gc)
    (param count I64)
    (call C:brixMediaRingConsume native count)
  )
  (fn-do + close _
    (if (not is-closed)
      (= is-closed true)
      (let released native)
      (= native (call Pointer))
      (= data (call (of CPointer F32)))
      (call C:brixMediaRingRelease released)
    )
  )
)
