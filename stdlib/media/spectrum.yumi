/math

━━━━━━━━━━━━━━━━━━━━
+ SoundSpectrum

+ size Size
_ real F64[]
_ imaginary F64[]
_ window F64[]
_ cosines F64[]
_ sines F64[]

────────────────────
+ This
    - size Size = 1024

this.size = size
real = F64[size]
imaginary = F64[size]
window = F64[size]
cosines = F64[size / 2]
sines = F64[size / 2]
for index in 0 .. < size
    window[index] = 0.5 - 0.5 * cos(2 * π * (index as F64) / ((size - 1) as F64))
for index in 0 .. < size / 2
    cosines[index] = cos(-2 * π * (index as F64) / (size as F64))
    sines[index] = sin(-2 * π * (index as F64) / (size as F64))

────────────────────
+ do magnitudes F64[]
    - samples F64[]
    - start Size

for index in 0 .. < size
    . at-sample = start + index
    real[index] = if at-sample < samples.length then samples[at-sample] * window[index] else 0.0
    imaginary[index] = 0
transform()
. result = F64[size / 2]
for index in 0 .. < size / 2
    result[index] = sqrt(real-square + imaginary[index] * imaginary[index]) * 4 / (size as F64)
        .. real-square = real[index] * real[index]
= result

────────────────────
_ do transform

. swap Size = 0
for index in 0 .. < size - 1
    if index < swap
        . keep-real = real[index]
        . keep-imaginary = imaginary[index]
        real[index] = real[swap]
        imaginary[index] = imaginary[swap]
        real[swap] = keep-real
        imaginary[swap] = keep-imaginary
    . bit = size / 2
    while bit <= swap
        swap -= bit
        bit /= 2
    swap += bit
. span Size = 2
while span <= size
    . half = span / 2
    . stride = size / span
    . first Size = 0
    while first < size
        for offset in 0 .. < half
            . twiddle = offset * stride
            . a = first + offset
            . b = a + half
            . turned-real = cosines[twiddle] * real[b] - sines[twiddle] * imaginary[b]
            . turned-imaginary = cosines[twiddle] * imaginary[b] + sines[twiddle] * real[b]
            real[b] = real[a] - turned-real
            imaginary[b] = imaginary[a] - turned-imaginary
            real[a] += turned-real
            imaginary[a] += turned-imaginary
        first += span
    span *= 2
