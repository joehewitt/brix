(import ./ring)
(import ./synth)
(import /core/array-builder)
(import /math)
(import /math.h)
(blank)
(prop _ mixer-block I64 (= 256))
(prop _ mixer-control-frames Size (= 32))
(prop _ mixer-voice-count Size (= 40))
(prop _ mixer-control-count Size (= 16))
(prop _ mixer-trigger-width I64 (= 8))
(prop _ mixer-silence F64 (= 0.0004))
(prop _ mixer-tau _ (= (* 2 π)))
(prop _ cue-frame-split I64 (= 16777216))
(blank)
(prop _ cue-play _ (= 1))
(prop _ cue-control _ (= 2))
(prop _ cue-stop _ (= 3))
(prop _ cue-volume _ (= 4))
(prop _ cue-hush _ (= 5))

(type _ VoiceState (is I64)
  (variant idle)
  (variant waiting)
  (variant attack)
  (variant hold)
  (variant decay)
  (variant sustain)
  (variant release)
  (variant gap)
)

(type + SoundVoice
  (prop + stage I64 (= (. VoiceState idle)))
  (prop + layer Size (= 0))
  (prop + patch Size (= 0))
  (prop + handle F64)
  (prop + left I64)
  (prop + age I64)
  (prop + envelope F64)
  (prop + attack-step F64)
  (prop + decay-factor F64 (= 1))
  (prop + level F64)
  (prop + pan-left F64 (= 0.7))
  (prop + pan-right F64 (= 0.7))
  (prop + space F64)
  (prop + pitch F64 (= 440))
  (prop + pitch-end F64 (= 440))
  (prop + pitch-step F64)
  (prop + phase F64)
  (prop + fm-phase F64)
  (prop + fm-depth F64)
  (prop + fm-depth-end F64)
  (prop + cutoff F64 (= 1000))
  (prop + cutoff-end F64 (= 1000))
  (prop + sweep-step F64)
  (prop + filter-one F64)
  (prop + filter-two F64)
  (prop + seed U32 (= 1))
  (prop + pink-a F64)
  (prop + pink-b F64)
  (prop + pink-c F64)
  (prop + brown F64)
  (prop + vibrato-phase F64)
  (prop + tremolo-phase F64)
  (prop + control-level F64 (= 1))
  (prop + control-cutoff F64)
  (prop + echoes Size (= 0))
  (prop + echo-level F64 (= 1))
  (prop + gain F64)
  (fn-expr + is-active Bool :get (without gc)
    (!= stage (. VoiceState idle))
  )
  (fn-expr + loudness F64 :get (without gc)
    (* envelope level)
  )
  (fn-do + noise F64 (without gc)
    (= seed (+ (* seed 1664525) 1013904223))
    (return (- (/ (as seed F64) 2147483648.0) 1))
  )
)

(type + SoundSpace
  (prop + lines ([] F64))
  (prop + starts ([] Size))
  (prop + lengths ([] Size))
  (prop + cursors ([] Size))
  (prop + stores ([] F64))
  (prop + feedback F64 (= 0.8))
  (prop + damping F64 (= 0.3))
  (prop + wet F64 (= 1))
  (fn-do + This _
    (param rate F64)
    (let scale (/ rate 44100))
    (let sizes (list Size))
    (for (in size (list 1116 1188 1277 1356 1422 1491 1557 1617 556 441 341 225))
      (+= sizes (as (* (as size F64) scale) Size))
    )
    (for (in size (list 1116 1188 1277 1356 1422 1491 1557 1617 556 441 341 225))
      (+= sizes (as (* (as (+ size 23) F64) scale) Size))
    )
    (let offsets (list Size))
    (let total Size 0)
    (for (in size sizes)
      (+= offsets total)
      (+= total size)
    )
    (= lines ([] F64 total))
    (= starts (call Array offsets))
    (= lengths (call Array sizes))
    (= cursors ([] Size (. sizes length)))
    (= stores ([] F64 (. sizes length)))
  )
  (fn-do + comb F64 (without gc)
    (param line Size)
    (param input F64)
    (let cursor ([] cursors line))
    (let index (+ ([] starts line) cursor))
    (let output ([] lines index))
    (= ([] stores line) (+ (* output (- 1 damping)) (* ([] stores line) damping)))
    (= ([] lines index) (+ input (* ([] stores line) feedback)))
    (= ([] cursors line) (if-expr (>= (+ cursor 1) ([] lengths line)) 0 (+ cursor 1)))
    (return output)
  )
  (fn-do + pass F64 (without gc)
    (param line Size)
    (param input F64)
    (let cursor ([] cursors line))
    (let index (+ ([] starts line) cursor))
    (let delayed ([] lines index))
    (= ([] lines index) (+ input (* delayed 0.5)))
    (= ([] cursors line) (if-expr (>= (+ cursor 1) ([] lengths line)) 0 (+ cursor 1)))
    (return (- delayed input))
  )
  (fn-do + side F64 (without gc)
    (param first Size)
    (param input F64)
    (let total F64)
    (for (in line (..< first (+ first 8)))
      (+= total (call comb line input))
    )
    (for (in line (..< (+ first 8) (+ first 12)))
      (= total (call pass line total))
    )
    (return total)
  )
)

(type + Mixer
  (prop + bank SoundBank)
  (prop + rate F64)
  (prop + voices ([] SoundVoice))
  (prop + controls ([] F64))
  (prop + cues MediaRing)
  (prop + space SoundSpace)
  (prop + volume F64 (= 1))
  (prop + threshold F64 (= 0.6))
  (prop + peak F64)
  (prop + energy F64)
  (prop + frames I64)
  (prop + limited I64)
  (prop + broken I64)
  (prop + steals I64)
  (prop + dropped I64)
  (prop + busiest Size (= 0))
  (prop _ dry-left ([] F64))
  (prop _ dry-right ([] F64))
  (prop _ wet-left ([] F64))
  (prop _ wet-right ([] F64))
  (prop _ limit-envelope F64)
  (prop _ limit-release F64 (= 0.9998))
  (prop _ seed U32 (= 7))
  (prop _ next-handle F64 (= 1))
  (fn-do + This _
    (param bank SoundBank)
    (= (. this bank) bank)
    (call (. bank seal))
    (= rate (. bank rate))
    (let made (list SoundVoice))
    (for (in _ (..< 0 mixer-voice-count))
      (+= made (call SoundVoice))
    )
    (= voices (call Array made))
    (= controls ([] F64 mixer-control-count))
    (= cues (call MediaRing 512 mixer-trigger-width))
    (= space (call SoundSpace rate))
    (= dry-left ([] F64 mixer-block))
    (= dry-right ([] F64 mixer-block))
    (= wet-left ([] F64 mixer-block))
    (= wet-right ([] F64 mixer-block))
    (= limit-release (call C:exp (/ -1 (* 0.25 rate))))
  )
  (fn-do + play F64
    (param patch Size)
    (param level F64 (= 1))
    (param pan F64 (= 0))
    (param pitch F64 (= 1))
    (param at I64 (= 0))
    (let handle next-handle)
    (+= next-handle 1)
    (call send
      (block
        (arg cue-play)
        (arg (as patch F64))
        (arg level)
        (arg pan)
        (arg pitch)
        (arg handle)
        (arg (as (/ at cue-frame-split) F64))
        (arg (as (% at cue-frame-split) F64))
      )
    )
    (return handle)
  )
  (fn-do + control _
    (param index Size)
    (param value F64)
    (call send cue-control (as index F64) value 0 0 0)
  )
  (fn-do + stop _
    (param handle F64)
    (call send cue-stop handle 0 0 0 0)
  )
  (fn-do + set-volume _
    (param value F64)
    (call send cue-volume value 0 0 0 0)
  )
  (fn-do + hush _
    (call send cue-hush 0 0 0 0 0)
  )
  (fn-do _ send _
    (param kind I64)
    (param a F64)
    (param b F64)
    (param c F64)
    (param d F64)
    (param e F64)
    (param f F64 (= 0))
    (param g F64 (= 0))
    (if (< (. cues space) 1)
      (+= dropped 1)
      (return)
    )
    (let next (. cues written))
    (let record (call (. cues slot) next))
    (= ([] record 0) (as kind F32))
    (= ([] record 1) (as a F32))
    (= ([] record 2) (as b F32))
    (= ([] record 3) (as c F32))
    (= ([] record 4) (as d F32))
    (= ([] record 5) (as e F32))
    (= ([] record 6) (as f F32))
    (= ([] record 7) (as g F32))
    (call (. cues publish) (+ next 1))
  )
  (fn-do + active Size :get
    (let count Size 0)
    (for (in voice voices)
      (if (. voice is-active)
        (+= count 1)
      )
    )
    (return count)
  )
  (fn-expr + loudness F64 :get
    (if-expr (> frames 0) (call C:sqrt (/ energy (as frames F64))) 0.0)
  )
  (fn-do + render _ (without gc)
    (param out (of CPointer F32))
    (param count I64)
    (let done I64)
    (while (< done count)
      (let part (if-expr (< (- count done) mixer-block) (- count done) mixer-block))
      (call render-block (+ out (* done 2)) part)
      (+= done part)
    )
  )
  (fn-do _ render-block _ (without gc)
    (param out (of CPointer F32))
    (param count Size)
    (call take-cues)
    (for (in index (..< 0 count))
      (= ([] dry-left index) 0)
      (= ([] dry-right index) 0)
      (= ([] wet-left index) 0)
      (= ([] wet-right index) 0)
    )
    (let sounding Size 0)
    (for (in slot (..< 0 (. voices length)))
      (let voice ([] voices slot))
      (if (. voice is-active)
        (+= sounding 1)
        (call render-voice voice ([] (. bank layer-table) (. voice layer)) count)
      )
    )
    (= busiest (if-expr (> sounding busiest) sounding busiest))
    (for (in index (..< 0 count))
      (let send (* (+ ([] wet-left index) ([] wet-right index)) 0.015))
      (+= ([] dry-left index) (* (call (. space side) 0 send) (. space wet)))
      (+= ([] dry-right index) (* (call (. space side) 12 send) (. space wet)))
    )
    (call finish out count)
  )
  (fn-do _ finish _ (without gc)
    (param out (of CPointer F32))
    (param count Size)
    (for (in index (..< 0 count))
      (let left (* ([] dry-left index) volume))
      (let right (* ([] dry-right index) volume))
      (let level (call greater (call C:fabs left) (call C:fabs right)))
      (if (not (< level 1000))
        (+= broken 1)
        (call hush-now)
        (= ([] out (* index 2)) 0)
        (= ([] out (+ (* index 2) 1)) 0)
        (else
          (if (> level limit-envelope)
            (= limit-envelope level)
            (else
              (= limit-envelope (+ (* limit-envelope limit-release) (* level (- 1 limit-release))))
            )
          )
          (let gain (if-expr (> limit-envelope threshold) (/ threshold limit-envelope) 1.0))
          (if (< gain 0.99)
            (+= limited 1)
          )
          (let shaped-left (call clamp (* left gain) -1 1))
          (let shaped-right (call clamp (* right gain) -1 1))
          (= peak (call greater peak (call greater (call C:fabs shaped-left) (call C:fabs shaped-right))))
          (+= energy (* (+ (* shaped-left shaped-left) (* shaped-right shaped-right)) 0.5))
          (= ([] out (* index 2)) (as shaped-left F32))
          (= ([] out (+ (* index 2) 1)) (as shaped-right F32))
        )
      )
    )
    (+= frames (as count I64))
  )
  (fn-do _ take-cues _ (without gc)
    (let read (. cues consumed))
    (let written (. cues written))
    (while (< read written)
      (let record (call (. cues slot) read))
      (let kind (as ([] record 0) I64))
      (if (== kind cue-play)
        (let at (+ (* (as ([] record 6) I64) cue-frame-split) (as ([] record 7) I64)))
        (call start-patch (as ([] record 1) Size) ([] record 2) ([] record 3) ([] record 4) ([] record 5) at)
        (else-if (== kind cue-control)
          (let index (as ([] record 1) Size))
          (if (< index (. controls length))
            (= ([] controls index) ([] record 2))
          )
        )
        (else-if (== kind cue-stop)
          (call release-handle ([] record 1))
        )
        (else-if (== kind cue-volume)
          (= volume (as ([] record 1) F64))
        )
        (else-if (== kind cue-hush)
          (call hush-now)
        )
      )
      (+= read 1)
    )
    (call (. cues consume) read)
  )
  (fn-do _ hush-now _ (without gc)
    (for (in slot (..< 0 (. voices length)))
      (= (. ([] voices slot) stage) (. VoiceState idle))
      (= (. ([] voices slot) filter-one) 0)
      (= (. ([] voices slot) filter-two) 0)
    )
    (= limit-envelope 0)
  )
  (fn-do _ release-handle _ (without gc)
    (param handle F64)
    (for (in slot (..< 0 (. voices length)))
      (let voice ([] voices slot))
      (if (and (. voice is-active) (== (. voice handle) handle))
        (call release-voice voice (. ([] (. bank layer-table) (. voice layer)) release))
      )
    )
  )
  (fn-do _ release-voice _ (without gc)
    (param voice SoundVoice)
    (param seconds F64)
    (return-if (if (== (. voice stage) (. VoiceState release))))
    (if (or (== (. voice stage) (. VoiceState waiting)) (== (. voice stage) (. VoiceState gap)))
      (= (. voice stage) (. VoiceState idle))
      (return)
    )
    (= (. voice stage) (. VoiceState release))
    (= (. voice left) (call frames-of seconds))
    (= (. voice decay-factor) (call C:exp (/ -6.9 (as (. voice left) F64))))
    (= (. voice echoes) 0)
  )
  (fn-expr _ frames-of I64 (without gc)
    (param seconds F64)
    (as (call greater 1 (* seconds rate)) I64)
  )
  (fn-do _ random F64 (without gc)
    (= seed (+ (* seed 1664525) 1013904223))
    (return (/ (as seed F64) 4294967296.0))
  )
  (fn-do _ start-patch _ (without gc)
    (param index Size)
    (param level F64)
    (param pan F64)
    (param pitch F64)
    (param handle F64)
    (param at I64)
    (return-if (if (>= index (. bank patch-table length))))
    (let patch ([] (. bank patch-table) index))
    (let playing Size 0)
    (let oldest (? SoundVoice) null)
    (for (in slot (..< 0 (. voices length)))
      (let voice ([] voices slot))
      (if (and (. voice is-active) (== (. voice patch) index) same-layer (!= (. voice stage) (. VoiceState release)))
        (+= playing 1)
        (if (or (not oldest) (> (. voice age) (. oldest age)))
          (= oldest voice)
        )
      )
      (lazy same-layer (== (. voice layer) (. patch first)))
    )
    (if (and (>= playing (. patch polyphony)) oldest)
      (call release-handle-fast (. oldest handle))
    )
    (let bend (* pitch (call C:pow 2.0 (/ (* (- (* (call random) 2) 1) (. patch pitch-spread)) 12))))
    (let loud (* level (+ 1 (* (- (* (call random) 2) 1) (. patch level-spread)))))
    (let wait (if-expr (> at frames) (- at frames) 0))
    (for (in layer-index (..< (. patch first) (+ (. patch first) (. patch count))))
      (let voice (call take-voice))
      (call begin-voice voice layer-index index loud pan bend handle wait)
    )
  )
  (fn-do _ release-handle-fast _ (without gc)
    (param handle F64)
    (for (in slot (..< 0 (. voices length)))
      (let voice ([] voices slot))
      (if (and (. voice is-active) (== (. voice handle) handle))
        (call release-voice voice 0.03)
      )
    )
  )
  (fn-do _ take-voice SoundVoice (without gc)
    (let quietest ([] voices 0))
    (let quietest-level F64 1000000)
    (for (in slot (..< 0 (. voices length)))
      (let voice ([] voices slot))
      (return-if voice (if (not (. voice is-active))))
      (let level
        (block
          (case? (and (!= (. voice stage) (. VoiceState sustain)) (!= (. voice stage) (. VoiceState waiting)))
            (. voice loudness)
          )
          (default
            1000
          )
        )
      )
      (if (< level quietest-level)
        (= quietest voice)
        (= quietest-level level)
      )
    )
    (+= steals 1)
    (return quietest)
  )
  (fn-do _ begin-voice _ (without gc)
    (param voice SoundVoice)
    (param layer-index Size)
    (param patch Size)
    (param level F64)
    (param pan F64)
    (param pitch F64)
    (param handle F64)
    (param wait I64)
    (let layer ([] (. bank layer-table) layer-index))
    (= (. voice layer) layer-index)
    (= (. voice patch) patch)
    (= (. voice handle) handle)
    (= (. voice age) 0)
    (= (. voice level) (* (. layer level) level))
    (let place (call clamp (+ pan (. layer pan)) -1 1))
    (let angle (/ (* (+ place 1) π) 4))
    (= (. voice pan-left) (call C:cos angle))
    (= (. voice pan-right) (call C:sin angle))
    (= (. voice space) (. layer reverb))
    (= (. voice pitch) (* (. layer pitch) pitch))
    (= (. voice pitch-end) (* (if-expr (> (. layer pitch-end) 0) (. layer pitch-end) (. layer pitch)) pitch))
    (= (. voice pitch-step) (- 1 (call C:exp (/ -1 (* (call greater 0.001 (. layer glide)) rate)))))
    (= (. voice phase) (call random))
    (= (. voice fm-phase) 0)
    (= (. voice fm-depth) (. layer fm-depth))
    (= (. voice fm-depth-end) (if-expr (>= (. layer fm-depth-end) 0) (. layer fm-depth-end) (. layer fm-depth)))
    (= (. voice cutoff) (. layer cutoff))
    (= (. voice cutoff-end) (if-expr (> (. layer cutoff-end) 0) (. layer cutoff-end) (. layer cutoff)))
    (= (. voice filter-one) 0)
    (= (. voice filter-two) 0)
    (= (. voice seed) (as (* (call random) 4294967295.0) U32))
    (= (. voice pink-a) 0)
    (= (. voice pink-b) 0)
    (= (. voice pink-c) 0)
    (= (. voice brown) 0)
    (= (. voice vibrato-phase) 0)
    (= (. voice tremolo-phase) 0)
    (= (. voice control-level) (call control-value (. layer level-control) 1))
    (= (. voice control-cutoff) (call control-value (. layer cutoff-control) 0))
    (= (. voice echoes) (. layer echoes))
    (= (. voice echo-level) 1)
    (= (. voice gain) 0)
    (= (. voice envelope) 0)
    (let delay (+ wait (if-expr (> (. layer delay) 0) (call frames-of (. layer delay)) 0)))
    (if (> delay 0)
      (= (. voice stage) (. VoiceState waiting))
      (= (. voice left) delay)
      (else
        (call enter-attack voice layer)
      )
    )
  )
  (fn-expr _ control-value F64 (without gc)
    (param index I64)
    (param otherwise F64)
    (if-expr (and (>= index 0) (< (as index Size) (. controls length))) ([] controls (as index Size)) otherwise)
  )
  (fn-do _ enter-attack _ (without gc)
    (param voice SoundVoice)
    (param layer SoundLayer)
    (= (. voice stage) (. VoiceState attack))
    (= (. voice left) (call frames-of (. layer attack)))
    (= (. voice attack-step) (/ (- 1 (. voice envelope)) (as (. voice left) F64)))
    (= (. voice sweep-step)
      (scope (- 1 (call C:exp (/ (- (as mixer-control-frames F64)) (* sweep-time rate))))
        (lazy sweep-time (call greater 0.001 (. layer sweep-time)))
      )
    )
  )
  (fn-do _ advance-stage _ (without gc)
    (param voice SoundVoice)
    (param layer SoundLayer)
    (match? (. voice stage)
      (case= (. VoiceState waiting)
        (call enter-attack voice layer)
      )
      (case= (. VoiceState attack)
        (= (. voice envelope) 1)
        (if (> (. layer hold) 0)
          (= (. voice stage) (. VoiceState hold))
          (= (. voice left) (as (* (. layer hold) rate) I64))
          (else
            (call enter-decay voice layer)
          )
        )
      )
      (case= (. VoiceState hold)
        (call enter-decay voice layer)
      )
      (case= (. VoiceState decay)
        (call end-voice voice layer)
      )
      (case= (. VoiceState release)
        (= (. voice stage) (. VoiceState idle))
      )
      (case= (. VoiceState gap)
        (let step (call C:pow 2.0 (/ (. layer echo-step) 12)))
        (*= (. voice echo-level) (. layer echo-level))
        (*= (. voice pitch) step)
        (*= (. voice pitch-end) step)
        (= (. voice cutoff) (. layer cutoff))
        (= (. voice fm-depth) (. layer fm-depth))
        (call enter-attack voice layer)
      )
    )
  )
  (fn-do _ enter-decay _ (without gc)
    (param voice SoundVoice)
    (param layer SoundLayer)
    (if (. layer is-sustained)
      (= (. voice stage) (. VoiceState sustain))
      (= (. voice left) 9223372036854775807i64)
      (return)
    )
    (= (. voice stage) (. VoiceState decay))
    (= (. voice left) (call frames-of (. layer decay)))
    (= (. voice decay-factor) (call C:exp (/ -7.6 (as (. voice left) F64))))
  )
  (fn-do _ end-voice _ (without gc)
    (param voice SoundVoice)
    (param layer SoundLayer)
    (if (> (. voice echoes) 0)
      (-= (. voice echoes) 1)
      (= (. voice envelope) 0)
      (= (. voice stage) (. VoiceState gap))
      (= (. voice left) (call frames-of (. layer echo-gap)))
      (else
        (= (. voice stage) (. VoiceState idle))
      )
    )
  )
  (fn-do _ render-voice _ (without gc)
    (param voice SoundVoice)
    (param layer SoundLayer)
    (param count Size)
    (let index Size 0)
    (while (and (< index count) (. voice is-active))
      (let run (if-expr (< (- count index) mixer-control-frames) (- count index) mixer-control-frames))
      (let speed (. voice pitch-step))
      (+= (. voice cutoff) (* (- (. voice cutoff-end) (. voice cutoff)) (. voice sweep-step)))
      (+= (. voice fm-depth) (* (- (. voice fm-depth-end) (. voice fm-depth)) (. voice sweep-step)))
      (+= (. voice control-level) (* (- (call control-value (. layer level-control) 1) (. voice control-level)) 0.05))
      (+= (. voice control-cutoff) (* (- (call control-value (. layer cutoff-control) 0) (. voice control-cutoff)) 0.05))
      (let frequency (* (. voice cutoff) (call C:pow 2.0 (* (. voice control-cutoff) (. layer cutoff-range)))))
      (let g (call C:tan (/ (* π (call clamp frequency 10 (* rate 0.45))) rate)))
      (let k (/ 1 (call greater 0.1 (. layer resonance))))
      (let a1 (/ 1 (+ 1 (* g (+ g k)))))
      (let a2 (* g a1))
      (let a3 (* g a2))
      (let vibrato 1.0)
      (if (> (. layer vibrato-rate) 0)
        (+= (. voice vibrato-phase) (/ (* (. layer vibrato-rate) (as run F64)) rate))
        (-= (. voice vibrato-phase) (call C:floor (. voice vibrato-phase)))
        (= vibrato (call C:pow 2.0 (* (/ (. layer vibrato-depth) 12) (call C:sin (* (. voice vibrato-phase) mixer-tau)))))
      )
      (let tremolo 1.0)
      (if (> (. layer tremolo-rate) 0)
        (+= (. voice tremolo-phase) (/ (* (. layer tremolo-rate) (as run F64)) rate))
        (-= (. voice tremolo-phase) (call C:floor (. voice tremolo-phase)))
        (= tremolo (- 1 (* (. layer tremolo-depth) (+ 0.5 (* 0.5 (call C:sin (* (. voice tremolo-phase) mixer-tau)))))))
      )
      (let target (* (. voice level) (. voice echo-level) (. voice control-level) tremolo))
      (let gain-step (/ (- target (. voice gain)) (as run F64)))
      (for (in offset (..< 0 run))
        (if (<= (. voice left) 0)
          (call advance-stage voice layer)
          (return-if (if (not (. voice is-active))))
        )
        (-= (. voice left) 1)
        (+= (. voice age) 1)
        (match? (. voice stage)
          (case= (. VoiceState attack)
            (+= (. voice envelope) (. voice attack-step))
          )
          (case= (. VoiceState decay)
            (*= (. voice envelope) (. voice decay-factor))
          )
          (case= (. VoiceState release)
            (*= (. voice envelope) (. voice decay-factor))
          )
        )
        (+= (. voice gain) gain-step)
        (+= (. voice pitch) (* (- (. voice pitch-end) (. voice pitch)) speed))
        (let sounding (and (!= (. voice stage) (. VoiceState waiting)) (!= (. voice stage) (. VoiceState gap))))
        (let raw
          (block
            (case? sounding
              (call oscillate voice (. layer wave) (* (. voice pitch) vibrato) (. layer fm-ratio))
            )
            (default
              0.0
            )
          )
        )
        (let shaped (call filter voice (. layer filter) raw a1 a2 a3 k))
        (let sample (* shaped (. voice envelope) (. voice gain)))
        (let frame (+ index offset))
        (+= ([] dry-left frame) (* sample (. voice pan-left)))
        (+= ([] dry-right frame) (* sample (. voice pan-right)))
        (+= ([] wet-left frame) (* sample (. voice pan-left) (. voice space)))
        (+= ([] wet-right frame) (* sample (. voice pan-right) (. voice space)))
      )
      (+= index run)
      (if (and (== (. voice stage) (. VoiceState decay)) (< (. voice envelope) mixer-silence))
        (call end-voice voice layer)
      )
      (if (and (== (. voice stage) (. VoiceState release)) (< (. voice envelope) mixer-silence))
        (= (. voice stage) (. VoiceState idle))
      )
    )
  )
  (fn-do _ oscillate F64 (without gc)
    (param voice SoundVoice)
    (param wave SoundWave)
    (param frequency F64)
    (param fm-ratio F64)
    (let step (/ frequency rate))
    (+= (. voice phase) step)
    (-= (. voice phase) (call C:floor (. voice phase)))
    (let turn (. voice phase))
    (if (> (. voice fm-depth) 0)
      (+= (. voice fm-phase) (* step fm-ratio))
      (-= (. voice fm-phase) (call C:floor (. voice fm-phase)))
      (+= turn (/ (* (. voice fm-depth) (call C:sin (* (. voice fm-phase) mixer-tau))) mixer-tau))
      (-= turn (call C:floor turn))
    )
    (match? wave
      (case= (. SoundWave sine)
        (return (call C:sin (* turn mixer-tau)))
      )
      (case= (. SoundWave triangle)
        (return (- 1 (* 4 (call C:fabs (- turn 0.5)))))
      )
      (case= (. SoundWave saw)
        (return (- (* 2 turn) 1 (call blep turn step)))
      )
      (case= (. SoundWave square)
        (let flipped (- (+ turn 0.5) (call C:floor (+ turn 0.5))))
        (return (- (+ (if-expr (< turn 0.5) 1.0 -1.0) (call blep turn step)) (call blep flipped step)))
      )
      (case= (. SoundWave white)
        (return (call (. voice noise)))
      )
      (case= (. SoundWave pink)
        (let white (call (. voice noise)))
        (= (. voice pink-a) (+ (* 0.99765 (. voice pink-a)) (* white 0.099046)))
        (= (. voice pink-b) (+ (* 0.963 (. voice pink-b)) (* white 0.2965164)))
        (= (. voice pink-c) (+ (* 0.57 (. voice pink-c)) (* white 1.0526913)))
        (return (* (+ (. voice pink-a) (. voice pink-b) (. voice pink-c) (* white 0.1848)) 0.22))
      )
      (case= (. SoundWave brown)
        (= (. voice brown) (/ (+ (. voice brown) (* 0.02 (call (. voice noise)))) 1.02))
        (return (* (. voice brown) 3.5))
      )
    )
    (return 0)
  )
  (fn-expr _ blep F64 (without gc)
    (param turn F64)
    (param step F64)
    (if-expr (< turn step) leading-edge (if-expr (> turn (- 1 step)) trailing-edge 0.0))
    (where
      (lazy leading-edge (- (* (/ turn step) 2) (* (/ turn step) (/ turn step)) 1))
      (lazy trailing-edge (+ (* (/ (- turn 1) step) (/ (- turn 1) step)) (* (/ (- turn 1) step) 2) 1))
    )
  )
  (fn-do _ filter F64 (without gc)
    (param voice SoundVoice)
    (param kind SoundFilter)
    (param input F64)
    (param a1 F64)
    (param a2 F64)
    (param a3 F64)
    (param k F64)
    (return-if input (if (== kind (. SoundFilter open))))
    (let v3 (- input (. voice filter-two)))
    (let v1 (+ (* a1 (. voice filter-one)) (* a2 v3)))
    (let v2 (+ (. voice filter-two) (* a2 (. voice filter-one)) (* a3 v3)))
    (= (. voice filter-one) (- (* 2 v1) (. voice filter-one)))
    (= (. voice filter-two) (- (* 2 v2) (. voice filter-two)))
    (match? kind
      (case= (. SoundFilter low)
        (return v2)
      )
      (case= (. SoundFilter band)
        (return v1)
      )
      (case= (. SoundFilter high)
        (return (- input (* k v1) v2))
      )
    )
    (return input)
  )
)

(fn-expr _ greater F64 (without gc)
  (param left F64)
  (param right F64)
  (if-expr (> left right) left right)
)
