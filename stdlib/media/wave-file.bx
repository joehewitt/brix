(import /os/file)
(blank)
(prop _ wave-chunk-bytes Size (= 196608))

(type + WaveWriter
  (implements Closable)
  (prop + path String)
  (prop + rate F64)
  (prop + frames Size (= 0))
  (prop _ file File)
  (prop _ chunk ([] Byte))
  (prop _ used Size (= 0))
  (prop _ scratch _ (= ([] F32 4096)))
  (prop _ is-closed _ (= false))
  (fn-do + This _ (?! Error)
    (param path String)
    (param rate F64)
    (= (. this path) path)
    (= (. this rate) rate)
    (= file
      (call File
        (block
          (arg path)
          (arg (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
          (arg (/or/ user-read-perm user-write-perm))
        )
      )
    )
    (= chunk ([] Byte wave-chunk-bytes))
    (call (. file write) ([] Byte 44) 44)
  )
  (fn-expr + seconds F64 :get
    (/ (as frames F64) rate)
  )
  (fn-expr + buffer (of CPointer F32) :get
    (. scratch data)
  )
  (fn-do + add-frames _
    (param count Size)
    (let source (. scratch data))
    (for (in index (..< 0 (* count 2)))
      (if (> (+ used 2) (. chunk size))
        (call flush)
      )
      (let value (as ([] source index) F64))
      (let clipped (if-expr (< value -1) -1.0 (if-expr (> value 1) 1.0 value)))
      (= ([] (as (. chunk data) (of CPointer I16)) (/ used 2)) (as (* clipped 32767) I16))
      (+= used 2)
    )
    (+= frames count)
  )
  (fn-do _ flush _
    (if (> used 0)
      (call (. file write) chunk used
        (block
          (on-error (: problem Error)
            (throw (call Panic (str "Unable to write " path ": " (. problem message))))
          )
        )
      )
      (= used 0)
    )
  )
  (fn-do _ header ([] Byte)
    (let data-size (* frames 4))
    (let bytes ([] Byte 44))
    (let half (as (. bytes data) (of CPointer U16)))
    (call put-word half 0 1179011410)
    (call put-word half 4 (as (+ 36 data-size) U64))
    (call put-word half 8 1163280727)
    (call put-word half 12 544501094)
    (call put-word half 16 16)
    (= ([] half 10) 1u16)
    (= ([] half 11) 2u16)
    (call put-word half 24 (as rate U64))
    (call put-word half 28 (as (* rate 4) U64))
    (= ([] half 16) 4u16)
    (= ([] half 17) 16u16)
    (call put-word half 36 1635017060)
    (call put-word half 40 (as data-size U64))
    (return bytes)
  )
  (fn-do _ put-word _
    (param half (of CPointer U16))
    (param offset Size)
    (param value U64)
    (= ([] half (/ offset 2)) (as (% value 65536) U16))
    (= ([] half (+ (/ offset 2) 1)) (as (/ value 65536) U16))
  )
  (fn-do + close _
    (return-if (if is-closed))
    (= is-closed true)
    (call flush)
    (call (. file write) (call header) 44 0
      (block
        (on-error (: problem Error)
          (throw (call Panic (str "Unable to write " path ": " (. problem message))))
        )
      )
    )
    (call (. file close))
  )
)
