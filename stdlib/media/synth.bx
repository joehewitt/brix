(import /core/array-builder)
(import /math)
(import /time/duration)
(import /units)

(type + Frequency (is F64))

(type-line + Hertz (alias hz) (is Frequency))
(type-line + Kilohertz (alias khz) (is 1000hz))

(type + Interval (is F64))

(type-line + Semitones (alias st) (is Interval))
(type-line + Octaves (alias oct) (is 12st))

(fn-expr + pitch-ratio F64
  (param interval Semitones)
  (call exp (/ (* (call log 2.0) interval) 12))
)

(type + SoundWave (is Union)
  (variant sine)
  (variant triangle)
  (variant saw)
  (variant square)
  (variant white)
  (variant pink)
  (variant brown)
)

(type + SoundFilter (is Union)
  (variant open)
  (variant low)
  (variant high)
  (variant band)
)

(type + SoundLayer
  (prop + wave _ (= (. SoundWave sine)))
  (prop + pitch Hertz (= 440hz))
  (prop + pitch-end Hertz (= 0hz))
  (prop + glide Seconds (= 80ms))
  (prop + vibrato-rate Hertz (= 0hz))
  (prop + vibrato-depth Semitones (= 0st))
  (prop + fm-ratio F64)
  (prop + fm-depth F64)
  (prop + fm-depth-end F64 (= -1))
  (prop + filter _ (= (. SoundFilter open)))
  (prop + cutoff Hertz (= 2khz))
  (prop + cutoff-end Hertz (= 0hz))
  (prop + sweep-time Seconds (= 100ms))
  (prop + resonance F64 (= 0.7))
  (prop + attack Seconds (= 5ms))
  (prop + hold Seconds (= 0s))
  (prop + decay Seconds (= 300ms))
  (prop + is-sustained _ (= false))
  (prop + release Seconds (= 400ms))
  (prop + level Ratio (= 50%))
  (prop + pan Ratio (= 0%))
  (prop + reverb Ratio (= 15%))
  (prop + delay Seconds (= 0s))
  (prop + echoes Size (= 0))
  (prop + echo-gap Seconds (= 100ms))
  (prop + echo-level Ratio (= 100%))
  (prop + echo-step Semitones (= 0st))
  (prop + tremolo-rate Hertz (= 0hz))
  (prop + tremolo-depth Ratio (= 0%))
  (prop + level-control I64 (= -1))
  (prop + cutoff-control I64 (= -1))
  (prop + cutoff-range Octaves (= 2oct))
  (blank)
  (rule sine
    (= wave (. SoundWave sine))
  )
  (blank)
  (rule triangle
    (= wave (. SoundWave triangle))
  )
  (blank)
  (rule saw
    (= wave (. SoundWave saw))
  )
  (blank)
  (rule square
    (= wave (. SoundWave square))
  )
  (blank)
  (rule white-noise
    (= wave (. SoundWave white))
  )
  (blank)
  (rule pink-noise
    (= wave (. SoundWave pink))
  )
  (blank)
  (rule brown-noise
    (= wave (. SoundWave brown))
  )
  (blank)
  (rule low-pass
    (= filter (. SoundFilter low))
  )
  (blank)
  (rule high-pass
    (= filter (. SoundFilter high))
  )
  (blank)
  (rule band-pass
    (= filter (. SoundFilter band))
    (= resonance 1.2)
  )
  (blank)
  (rule sustained
    (= is-sustained true)
  )
  (fn-expr + length Seconds :get
    (if-expr (not is-sustained) (+ delay (* (+ attack hold decay echo-gap) (+ echoes 1))) held-length)
    (where
      (lazy held-length (+ delay attack release))
    )
  )
)

(type + SoundPatch
  (prop + name String)
  (prop + layers (list SoundLayer))
  (prop + pitch-spread Semitones (= 0st))
  (prop + level-spread Ratio (= 0%))
  (prop + min-gap Seconds (= 60ms))
  (prop + polyphony Size (= 3))
  (prop + first Size (= 0))
  (prop + count Size (= 0))
  (fn-do + This _
    (param name String)
    (= (. this name) name)
  )
  (fn-do + (infix this += (param layer SoundLayer)) _
    (+= layers layer)
  )
  (fn-expr + is-sustained Bool :get
    (and (> (. layers length) 0) (. ([] layers 0) is-sustained))
  )
  (fn-do + length Seconds :get
    (let longest Seconds 0s)
    (for (in layer layers)
      (= longest (call max longest (. layer length)))
    )
    (return longest)
  )
)

(type + SoundBank
  (prop + rate F64 (= 48000))
  (prop + patches (list SoundPatch))
  (prop + patch-table ([] SoundPatch))
  (prop + layer-table ([] SoundLayer))
  (prop _ names _ (= (call (of Map String Size))))
  (fn-do + add Size
    (param patch SoundPatch)
    (let index (. patches length))
    (+= patches patch)
    (= ([] names (. patch name)) index)
    (return index)
  )
  (fn-do + (infix this += (param patch SoundPatch)) _
    (call add patch)
  )
  (fn-expr + find (? Size)
    (param name String)
    ([] names name)
  )
  (fn-do + seal _
    (return-if (if (== (. patch-table length) (. patches length))))
    (blank)
    (let layers (list SoundLayer))
    (for (in patch patches)
      (= (. patch first) (. layers length))
      (= (. patch count) (. patch layers length))
      (++= layers (. patch layers))
    )
    (= patch-table (call Array patches))
    (= layer-table (call Array layers))
  )
)
