./ring
./synth
/core/array-builder
/math
/math.h

_ mixer-block I64 = 256
_ mixer-control-frames Size = 32
_ mixer-voice-count Size = 40
_ mixer-control-count Size = 16
_ mixer-trigger-width I64 = 8
_ mixer-silence F64 = 0.0004
_ mixer-tau = 2 * π
_ cue-frame-split I64 = 16777216

_ cue-play = 1
_ cue-control = 2
_ cue-stop = 3
_ cue-volume = 4
_ cue-hush = 5

━━━━━━━━━━━━━━━━━━━━
_ VoiceState is I64

| idle
| waiting
| attack
| hold
| decay
| sustain
| release
| gap

━━━━━━━━━━━━━━━━━━━━
+ SoundVoice

+ stage I64 = VoiceState.idle
+ layer Size = 0
+ patch Size = 0
+ handle F64
+ left I64
+ age I64
+ envelope F64
+ attack-step F64
+ decay-factor F64 = 1
+ level F64
+ pan-left F64 = 0.7
+ pan-right F64 = 0.7
+ space F64
+ pitch F64 = 440
+ pitch-end F64 = 440
+ pitch-step F64
+ phase F64
+ fm-phase F64
+ fm-depth F64
+ fm-depth-end F64
+ cutoff F64 = 1000
+ cutoff-end F64 = 1000
+ sweep-step F64
+ filter-one F64
+ filter-two F64
+ seed U32 = 1
+ pink-a F64
+ pink-b F64
+ pink-c F64
+ brown F64
+ vibrato-phase F64
+ tremolo-phase F64
+ control-level F64 = 1
+ control-cutoff F64
+ echoes Size = 0
+ echo-level F64 = 1
+ gain F64

────────────────────
+ get is-active Bool without gc

stage != VoiceState.idle

────────────────────
+ get loudness F64 without gc

envelope * level

────────────────────
+ do noise F64 without gc

seed = seed * 1664525 + 1013904223
= (seed as F64) / 2147483648.0 - 1

━━━━━━━━━━━━━━━━━━━━
+ SoundSpace

+ lines F64[]
+ starts Size[]
+ lengths Size[]
+ cursors Size[]
+ stores F64[]
+ feedback F64 = 0.8
+ damping F64 = 0.3
+ wet F64 = 1

────────────────────
+ This
    - rate F64

. scale = rate / 44100
. sizes [Size]
for size in [1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617, 556, 441, 341, 225]
    sizes += ((size as F64) * scale) as Size
for size in [1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617, 556, 441, 341, 225]
    sizes += (((size + 23) as F64) * scale) as Size
. offsets [Size]
. total Size = 0
for size in sizes
    offsets += total
    total += size
lines = F64[total]
starts = Array(offsets)
lengths = Array(sizes)
cursors = Size[sizes.length]
stores = F64[sizes.length]

────────────────────
+ do comb F64 without gc
    - line Size
    - input F64

. cursor = cursors[line]
. index = starts[line] + cursor
. output = lines[index]
stores[line] = output * (1 - damping) + stores[line] * damping
lines[index] = input + stores[line] * feedback
cursors[line] = if cursor + 1 >= lengths[line] then 0 else cursor + 1
= output

────────────────────
+ do pass F64 without gc
    - line Size
    - input F64

. cursor = cursors[line]
. index = starts[line] + cursor
. delayed = lines[index]
lines[index] = input + delayed * 0.5
cursors[line] = if cursor + 1 >= lengths[line] then 0 else cursor + 1
= delayed - input

────────────────────
+ do side F64 without gc
    - first Size
    - input F64

. total F64
for line in first .. < first + 8
    total += comb(line, input)
for line in first + 8 .. < first + 12
    total = pass(line, total)
= total

━━━━━━━━━━━━━━━━━━━━
+ Mixer

+ bank SoundBank
+ rate F64
+ voices SoundVoice[]
+ controls F64[]
+ cues MediaRing
+ space SoundSpace
+ volume F64 = 1
+ threshold F64 = 0.6
+ peak F64
+ energy F64
+ frames I64
+ limited I64
+ broken I64
+ steals I64
+ dropped I64
+ busiest Size = 0
_ dry-left F64[]
_ dry-right F64[]
_ wet-left F64[]
_ wet-right F64[]
_ limit-envelope F64
_ limit-release F64 = 0.9998
_ seed U32 = 7
_ next-handle F64 = 1

────────────────────
+ This
    - bank SoundBank

this.bank = bank
bank.seal()
rate = bank.rate
. made [SoundVoice]
for _ in 0 .. < mixer-voice-count
    made += SoundVoice()
voices = Array(made)
controls = F64[mixer-control-count]
cues = MediaRing(512, mixer-trigger-width)
space = SoundSpace(rate)
dry-left = F64[mixer-block]
dry-right = F64[mixer-block]
wet-left = F64[mixer-block]
wet-right = F64[mixer-block]
limit-release = C:exp(-1 / (0.25 * rate))

────────────────────
+ do play F64
    - patch Size
    - level F64 = 1
    - pan F64 = 0
    - pitch F64 = 1
    - at I64 = 0

. handle = next-handle
next-handle += 1
send(cue-play, patch as F64, level, pan, pitch, handle, (at / cue-frame-split) as F64, (at % cue-frame-split) as F64)
= handle

────────────────────
+ do control
    - index Size
    - value F64

send(cue-control, index as F64, value, 0, 0, 0)

────────────────────
+ do stop
    - handle F64

send(cue-stop, handle, 0, 0, 0, 0)

────────────────────
+ do set-volume
    - value F64

send(cue-volume, value, 0, 0, 0, 0)

────────────────────
+ do hush

send(cue-hush, 0, 0, 0, 0, 0)

────────────────────
_ do send
    - kind I64
    - a F64
    - b F64
    - c F64
    - d F64
    - e F64
    - f F64 = 0
    - g F64 = 0

if cues.space < 1
    dropped += 1
    =
. next = cues.written
. record = cues.slot(next)
record[0] = kind as F32
record[1] = a as F32
record[2] = b as F32
record[3] = c as F32
record[4] = d as F32
record[5] = e as F32
record[6] = f as F32
record[7] = g as F32
cues.publish(next + 1)

────────────────────
+ do get active Size

. count Size = 0
for voice in voices
    if voice.is-active
        count += 1
= count

────────────────────
+ get loudness F64

if frames > 0 then C:sqrt(energy / (frames as F64)) else 0.0

────────────────────
+ do render without gc
    - out CPointer'F32
    - count I64

. done I64
while done < count
    . part = if count - done < mixer-block then count - done else mixer-block
    render-block(out + done * 2, part)
    done += part

────────────────────
_ do render-block without gc
    - out CPointer'F32
    - count Size

take-cues()
for index in 0 .. < count
    dry-left[index] = 0
    dry-right[index] = 0
    wet-left[index] = 0
    wet-right[index] = 0
. sounding Size = 0
for slot in 0 .. < voices.length
    . voice = voices[slot]
    if voice.is-active
        sounding += 1
        render-voice(voice, bank.layer-table[voice.layer], count)
busiest = if sounding > busiest then sounding else busiest
for index in 0 .. < count
    . send = (wet-left[index] + wet-right[index]) * 0.015
    dry-left[index] += space.side(0, send) * space.wet
    dry-right[index] += space.side(12, send) * space.wet
finish(out, count)

────────────────────
_ do finish without gc
    - out CPointer'F32
    - count Size

for index in 0 .. < count
    . left = dry-left[index] * volume
    . right = dry-right[index] * volume
    . level = greater(C:fabs(left), C:fabs(right))
    if !(level < 1000)
        broken += 1
        hush-now()
        out[index * 2] = 0
        out[index * 2 + 1] = 0
    else
        if level > limit-envelope
            limit-envelope = level
        else
            limit-envelope = limit-envelope * limit-release + level * (1 - limit-release)
        . gain = if limit-envelope > threshold then threshold / limit-envelope else 1.0
        if gain < 0.99
            limited += 1
        . shaped-left = clamp(left * gain, -1, 1)
        . shaped-right = clamp(right * gain, -1, 1)
        peak = greater(peak, greater(C:fabs(shaped-left), C:fabs(shaped-right)))
        energy += (shaped-left * shaped-left + shaped-right * shaped-right) * 0.5
        out[index * 2] = shaped-left as F32
        out[index * 2 + 1] = shaped-right as F32
frames += count as I64

────────────────────
_ do take-cues without gc

. read = cues.consumed
. written = cues.written
while read < written
    . record = cues.slot(read)
    . kind = record[0] as I64
    if kind == cue-play
        . at = (record[6] as I64) * cue-frame-split + (record[7] as I64)
        start-patch(record[1] as Size, record[2], record[3], record[4], record[5], at)
    else if kind == cue-control
        . index = record[1] as Size
        if index < controls.length
            controls[index] = record[2]
    else if kind == cue-stop
        release-handle(record[1])
    else if kind == cue-volume
        volume = record[1] as F64
    else if kind == cue-hush
        hush-now()
    read += 1
cues.consume(read)

────────────────────
_ do hush-now without gc

for slot in 0 .. < voices.length
    voices[slot].stage = VoiceState.idle
    voices[slot].filter-one = 0
    voices[slot].filter-two = 0
limit-envelope = 0

────────────────────
_ do release-handle without gc
    - handle F64

for slot in 0 .. < voices.length
    . voice = voices[slot]
    if voice.is-active && voice.handle == handle
        release-voice(voice, bank.layer-table[voice.layer].release)

────────────────────
_ do release-voice without gc
    - voice SoundVoice
    - seconds F64

=? if voice.stage == VoiceState.release
if voice.stage == VoiceState.waiting || voice.stage == VoiceState.gap
    voice.stage = VoiceState.idle
    =
voice.stage = VoiceState.release
voice.left = frames-of(seconds)
voice.decay-factor = C:exp(-6.9 / (voice.left as F64))
voice.echoes = 0

────────────────────
_ frames-of I64 without gc
    - seconds F64

greater(1, seconds * rate) as I64

────────────────────
_ do random F64 without gc

seed = seed * 1664525 + 1013904223
= (seed as F64) / 4294967296.0

────────────────────
_ do start-patch without gc
    - index Size
    - level F64
    - pan F64
    - pitch F64
    - handle F64
    - at I64

=? if index >= bank.patch-table.length
. patch = bank.patch-table[index]
. playing Size = 0
. oldest SoundVoice? = null
for slot in 0 .. < voices.length
    . voice = voices[slot]
    if voice.is-active && voice.patch == index && same-layer && voice.stage != VoiceState.release
        playing += 1
        if !oldest || voice.age > oldest.age
            oldest = voice
    .. same-layer = voice.layer == patch.first
if playing >= patch.polyphony && oldest
    release-handle-fast(oldest.handle)
. bend = pitch * C:pow(2.0, (random() * 2 - 1) * patch.pitch-spread / 12)
. loud = level * (1 + (random() * 2 - 1) * patch.level-spread)
. wait = if at > frames then at - frames else 0
for layer-index in patch.first .. < patch.first + patch.count
    . voice = take-voice()
    begin-voice(voice, layer-index, index, loud, pan, bend, handle, wait)

────────────────────
_ do release-handle-fast without gc
    - handle F64

for slot in 0 .. < voices.length
    . voice = voices[slot]
    if voice.is-active && voice.handle == handle
        release-voice(voice, 0.03)

────────────────────
_ do take-voice SoundVoice without gc

. quietest = voices[0]
. quietest-level F64 = 1000000
for slot in 0 .. < voices.length
    . voice = voices[slot]
    =? voice if !voice.is-active
    . level = if voice.stage != VoiceState.sustain && voice.stage != VoiceState.waiting then voice.loudness else 1000
    if level < quietest-level
        quietest = voice
        quietest-level = level
steals += 1
= quietest

────────────────────
_ do begin-voice without gc
    - voice SoundVoice
    - layer-index Size
    - patch Size
    - level F64
    - pan F64
    - pitch F64
    - handle F64
    - wait I64

. layer = bank.layer-table[layer-index]
voice.layer = layer-index
voice.patch = patch
voice.handle = handle
voice.age = 0
voice.level = layer.level * level
. place = clamp(pan + layer.pan, -1, 1)
. angle = (place + 1) * π / 4
voice.pan-left = C:cos(angle)
voice.pan-right = C:sin(angle)
voice.space = layer.reverb
voice.pitch = layer.pitch * pitch
voice.pitch-end = (if layer.pitch-end > 0 then layer.pitch-end else layer.pitch) * pitch
voice.pitch-step = 1 - C:exp(-1 / (greater(0.001, layer.glide) * rate))
voice.phase = random()
voice.fm-phase = 0
voice.fm-depth = layer.fm-depth
voice.fm-depth-end = if layer.fm-depth-end >= 0 then layer.fm-depth-end else layer.fm-depth
voice.cutoff = layer.cutoff
voice.cutoff-end = if layer.cutoff-end > 0 then layer.cutoff-end else layer.cutoff
voice.filter-one = 0
voice.filter-two = 0
voice.seed = (random() * 4294967295.0) as U32
voice.pink-a = 0
voice.pink-b = 0
voice.pink-c = 0
voice.brown = 0
voice.vibrato-phase = 0
voice.tremolo-phase = 0
voice.control-level = control-value(layer.level-control, 1)
voice.control-cutoff = control-value(layer.cutoff-control, 0)
voice.echoes = layer.echoes
voice.echo-level = 1
voice.gain = 0
voice.envelope = 0
. delay = wait + (if layer.delay > 0 then frames-of(layer.delay) else 0)
if delay > 0
    voice.stage = VoiceState.waiting
    voice.left = delay
else
    enter-attack(voice, layer)

────────────────────
_ control-value F64 without gc
    - index I64
    - otherwise F64

if index >= 0 && (index as Size) < controls.length then controls[index as Size] else otherwise

────────────────────
_ do enter-attack without gc
    - voice SoundVoice
    - layer SoundLayer

voice.stage = VoiceState.attack
voice.left = frames-of(layer.attack)
voice.attack-step = (1 - voice.envelope) / (voice.left as F64)
voice.sweep-step = 1 - C:exp(-(mixer-control-frames as F64) / (sweep-time * rate))
    .. sweep-time = greater(0.001, layer.sweep-time)

────────────────────
_ do advance-stage without gc
    - voice SoundVoice
    - layer SoundLayer

match? voice.stage
    |= VoiceState.waiting
        enter-attack(voice, layer)
    |= VoiceState.attack
        voice.envelope = 1
        if layer.hold > 0
            voice.stage = VoiceState.hold
            voice.left = (layer.hold * rate) as I64
        else
            enter-decay(voice, layer)
    |= VoiceState.hold
        enter-decay(voice, layer)
    |= VoiceState.decay
        end-voice(voice, layer)
    |= VoiceState.release
        voice.stage = VoiceState.idle
    |= VoiceState.gap
        . step = C:pow(2.0, layer.echo-step / 12)
        voice.echo-level *= layer.echo-level
        voice.pitch *= step
        voice.pitch-end *= step
        voice.cutoff = layer.cutoff
        voice.fm-depth = layer.fm-depth
        enter-attack(voice, layer)

────────────────────
_ do enter-decay without gc
    - voice SoundVoice
    - layer SoundLayer

if layer.is-sustained
    voice.stage = VoiceState.sustain
    voice.left = 9223372036854775807i64
    =
voice.stage = VoiceState.decay
voice.left = frames-of(layer.decay)
voice.decay-factor = C:exp(-7.6 / (voice.left as F64))

────────────────────
_ do end-voice without gc
    - voice SoundVoice
    - layer SoundLayer

if voice.echoes > 0
    voice.echoes -= 1
    voice.envelope = 0
    voice.stage = VoiceState.gap
    voice.left = frames-of(layer.echo-gap)
else
    voice.stage = VoiceState.idle

────────────────────
_ do render-voice without gc
    - voice SoundVoice
    - layer SoundLayer
    - count Size

. index Size = 0
while index < count && voice.is-active
    . run = if count - index < mixer-control-frames then count - index else mixer-control-frames
    . speed = voice.pitch-step
    voice.cutoff += (voice.cutoff-end - voice.cutoff) * voice.sweep-step
    voice.fm-depth += (voice.fm-depth-end - voice.fm-depth) * voice.sweep-step
    voice.control-level += (control-value(layer.level-control, 1) - voice.control-level) * 0.05
    voice.control-cutoff += (control-value(layer.cutoff-control, 0) - voice.control-cutoff) * 0.05
    . frequency = voice.cutoff * C:pow(2.0, voice.control-cutoff * layer.cutoff-range)
    . g = C:tan(π * clamp(frequency, 10, rate * 0.45) / rate)
    . k = 1 / greater(0.1, layer.resonance)
    . a1 = 1 / (1 + g * (g + k))
    . a2 = g * a1
    . a3 = g * a2
    . vibrato = 1.0
    if layer.vibrato-rate > 0
        voice.vibrato-phase += layer.vibrato-rate * (run as F64) / rate
        voice.vibrato-phase -= C:floor(voice.vibrato-phase)
        vibrato = C:pow(2.0, layer.vibrato-depth / 12 * C:sin(voice.vibrato-phase * mixer-tau))
    . tremolo = 1.0
    if layer.tremolo-rate > 0
        voice.tremolo-phase += layer.tremolo-rate * (run as F64) / rate
        voice.tremolo-phase -= C:floor(voice.tremolo-phase)
        tremolo = 1 - layer.tremolo-depth * (0.5 + 0.5 * C:sin(voice.tremolo-phase * mixer-tau))
    . target = voice.level * voice.echo-level * voice.control-level * tremolo
    . gain-step = (target - voice.gain) / (run as F64)
    for offset in 0 .. < run
        if voice.left <= 0
            advance-stage(voice, layer)
            =? if !voice.is-active
        voice.left -= 1
        voice.age += 1
        match? voice.stage
            |= VoiceState.attack
                voice.envelope += voice.attack-step
            |= VoiceState.decay
                voice.envelope *= voice.decay-factor
            |= VoiceState.release
                voice.envelope *= voice.decay-factor
        voice.gain += gain-step
        voice.pitch += (voice.pitch-end - voice.pitch) * speed
        . sounding = voice.stage != VoiceState.waiting && voice.stage != VoiceState.gap
        . raw = if sounding then oscillate(voice, layer.wave, voice.pitch * vibrato, layer.fm-ratio) else 0.0
        . shaped = filter(voice, layer.filter, raw, a1, a2, a3, k)
        . sample = shaped * voice.envelope * voice.gain
        . frame = index + offset
        dry-left[frame] += sample * voice.pan-left
        dry-right[frame] += sample * voice.pan-right
        wet-left[frame] += sample * voice.pan-left * voice.space
        wet-right[frame] += sample * voice.pan-right * voice.space
    index += run
    if voice.stage == VoiceState.decay && voice.envelope < mixer-silence
        end-voice(voice, layer)
    if voice.stage == VoiceState.release && voice.envelope < mixer-silence
        voice.stage = VoiceState.idle

────────────────────
_ do oscillate F64 without gc
    - voice SoundVoice
    - wave SoundWave
    - frequency F64
    - fm-ratio F64

. step = frequency / rate
voice.phase += step
voice.phase -= C:floor(voice.phase)
. turn = voice.phase
if voice.fm-depth > 0
    voice.fm-phase += step * fm-ratio
    voice.fm-phase -= C:floor(voice.fm-phase)
    turn += voice.fm-depth * C:sin(voice.fm-phase * mixer-tau) / mixer-tau
    turn -= C:floor(turn)
match? wave
    |= SoundWave.sine
        = C:sin(turn * mixer-tau)
    |= SoundWave.triangle
        = 1 - 4 * C:fabs(turn - 0.5)
    |= SoundWave.saw
        = 2 * turn - 1 - blep(turn, step)
    |= SoundWave.square
        . flipped = turn + 0.5 - C:floor(turn + 0.5)
        = (if turn < 0.5 then 1.0 else -1.0) + blep(turn, step) - blep(flipped, step)
    |= SoundWave.white
        = voice.noise()
    |= SoundWave.pink
        . white = voice.noise()
        voice.pink-a = 0.99765 * voice.pink-a + white * 0.099046
        voice.pink-b = 0.963 * voice.pink-b + white * 0.2965164
        voice.pink-c = 0.57 * voice.pink-c + white * 1.0526913
        = (voice.pink-a + voice.pink-b + voice.pink-c + white * 0.1848) * 0.22
    |= SoundWave.brown
        voice.brown = (voice.brown + 0.02 * voice.noise()) / 1.02
        = voice.brown * 3.5
= 0

────────────────────
_ blep F64 without gc
    - turn F64
    - step F64

if turn < step then leading-edge else if turn > 1 - step then trailing-edge else 0.0

.. leading-edge = (turn / step) * 2 - (turn / step) * (turn / step) - 1
.. trailing-edge = ((turn - 1) / step) * ((turn - 1) / step) + ((turn - 1) / step) * 2 + 1

────────────────────
_ do filter F64 without gc
    - voice SoundVoice
    - kind SoundFilter
    - input F64
    - a1 F64
    - a2 F64
    - a3 F64
    - k F64

=? input if kind == SoundFilter.open
. v3 = input - voice.filter-two
. v1 = a1 * voice.filter-one + a2 * v3
. v2 = voice.filter-two + a2 * voice.filter-one + a3 * v3
voice.filter-one = 2 * v1 - voice.filter-one
voice.filter-two = 2 * v2 - voice.filter-two
match? kind
    |= SoundFilter.low
        = v2
    |= SoundFilter.band
        = v1
    |= SoundFilter.high
        = input - k * v1 - v2
= input

━━━━━━━━━━━━━━━━━━━━
_ greater F64 without gc
    - left F64
    - right F64

if left > right then left else right
