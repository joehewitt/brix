./mixer
./ring
/YuMedia/YuMedia.h
/time/duration

_ audio-pause Duration = 2ms

━━━━━━━━━━━━━━━━━━━━
+ AudioOutputError is Error

━━━━━━━━━━━━━━━━━━━━
+ AudioOutput
    is Closable

+ mixer Mixer
+ ring MediaRing
+ latency I64
+ is-running = true
_ native Pointer
_ worker Worker
_ stopped SyncBufferedChannel'Bool

────────────────────
+ This ?! Error
    - mixer Mixer
    - latency I64 = 1024

this.mixer = mixer
this.latency = latency
ring = MediaRing(latency * 2, 2)
fill()
native = C:yumiAudioOutputOpen(ring.native-pointer, mixer.rate)
. problem String = C:yumiAudioOutputGetError(native)
if problem.length > 0
    C:yumiAudioOutputRelease(native)
    ring.close()
    ?! AudioOutputError(problem)
worker = Worker()
do (worker) new
    pump()

────────────────────
+ get frames-played I64

C:yumiAudioOutputGetFramesPlayed(native)

────────────────────
+ get underrun-frames I64

C:yumiAudioOutputGetUnderrunFrames(native)

────────────────────
+ get slice-frames I64

C:yumiAudioOutputGetSliceFrames(native)

────────────────────
+ get frames-heard I64

ring.consumed

────────────────────
+ do listen
    - samples F64[]

. count = samples.length as I64
. reach = if count < latency then count else latency
. last = frames-heard
for index in 0 .. < samples.length
    . at = last - count + (index as I64)
    samples[index] = if at >= 0 && at >= last - reach then heard(at) else 0.0

────────────────────
_ heard F64
    - at I64

(frame[0] + frame[1]) * 0.5

.. frame = ring.slot(at)

────────────────────
_ do pump

while is-running
    fill()
    audio-pause.wait()
stopped <- true

────────────────────
_ do fill

while ring.filled < latency
    . start = ring.written
    . wanted = latency - ring.filled
    . count = if wanted < ring.run then wanted else ring.run
    mixer.render(ring.slot(start), count)
    ring.publish(start + count)

────────────────────
+ do close

=? if !is-running
is-running = false
<- stopped
worker.stop()
C:yumiAudioOutputRelease(native)
ring.close()
