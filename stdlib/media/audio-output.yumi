./mixer
./ring
/BxMedia/BxMedia.h
/time/duration

_ audio-pause Duration = 2ms

━━━━━━━━━━━━━━━━━━━━
+ AudioOutputError is Error

━━━━━━━━━━━━━━━━━━━━
+ AudioOutput
    is Closable

+ mixer Mixer
+ latency I64
+ is-running = true
_ ring MediaRing
_ native Pointer?
_ closed-frames-played I64 = 0
_ closed-underrun-frames I64 = 0
_ closed-frames-heard I64 = 0
_ worker Worker
_ stopped SyncBufferedChannel'Bool

────────────────────
+ This ?! Error
    - mixer Mixer
    - latency I64 = 1024

this.mixer = mixer
this.latency = latency
ring = MediaRing(latency * 2, 2)
fill()
. output = C:brixAudioOutputOpen(ring.native-pointer, mixer.rate)
. problem String = C:brixAudioOutputGetError(output)
if problem.length > 0
    is-running = false
    C:brixAudioOutputRelease(output)
    ring.close()
    ?! AudioOutputError(problem)
native = output
worker = Worker()
do (worker) new
    pump()

────────────────────
+ get frames-played I64

if output then C:brixAudioOutputGetFramesPlayed(output) else closed-frames-played

.. output = native

────────────────────
+ get underrun-frames I64

if output then C:brixAudioOutputGetUnderrunFrames(output) else closed-underrun-frames

.. output = native

────────────────────
+ get slice-frames I64

if output then C:brixAudioOutputGetSliceFrames(output) else 0

.. output = native

────────────────────
+ get frames-heard I64

if native then ring.consumed else closed-frames-heard

────────────────────
+ do listen
    - samples F64[]

. count = samples.length as I64
. reach = if count < latency then count else latency
. last = frames-heard
. open = native != null
for index in 0 .. < samples.length
    . at = last - count + (index as I64)
    samples[index] = if open && at >= 0 && at >= last - reach then heard(at) else 0.0

────────────────────
_ heard F64
    - at I64

(frame[0] + frame[1]) * 0.5

.. frame = ring.slot(at)

────────────────────
_ do pump

while is-running
    fill()
    audio-pause.wait()
stopped <- true

────────────────────
_ do fill

while ring.filled < latency
    . start = ring.written
    . wanted = latency - ring.filled
    . count = if wanted < ring.run then wanted else ring.run
    mixer.render(ring.slot(start), count)
    ring.publish(start + count)

────────────────────
+ do close

. output = native
=? if !output
is-running = false
<- stopped
worker.stop()
closed-frames-played = C:brixAudioOutputGetFramesPlayed(output)
closed-underrun-frames = C:brixAudioOutputGetUnderrunFrames(output)
native = null
C:brixAudioOutputRelease(output)
closed-frames-heard = ring.consumed
ring.close()
