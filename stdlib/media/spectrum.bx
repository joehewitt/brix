(import /math)

(type + SoundSpectrum
  (prop + size Size)
  (prop _ real ([] F64))
  (prop _ imaginary ([] F64))
  (prop _ window ([] F64))
  (prop _ cosines ([] F64))
  (prop _ sines ([] F64))
  (fn-do + This _
    (param size Size (= 1024))
    (= (. this size) size)
    (= real ([] F64 size))
    (= imaginary ([] F64 size))
    (= window ([] F64 size))
    (= cosines ([] F64 (/ size 2)))
    (= sines ([] F64 (/ size 2)))
    (for (in index (..< 0 size))
      (= ([] window index) (- 0.5 (* 0.5 (call cos (/ (* 2 π (as index F64)) (as (- size 1) F64))))))
    )
    (for (in index (..< 0 (/ size 2)))
      (= ([] cosines index) (call cos (/ (* -2 π (as index F64)) (as size F64))))
      (= ([] sines index) (call sin (/ (* -2 π (as index F64)) (as size F64))))
    )
  )
  (fn-do + magnitudes ([] F64)
    (param samples ([] F64))
    (param start Size)
    (for (in index (..< 0 size))
      (let at-sample (+ start index))
      (= ([] real index) (if-expr (< at-sample (. samples length)) (* ([] samples at-sample) ([] window index)) 0.0))
      (= ([] imaginary index) 0)
    )
    (call transform)
    (let result ([] F64 (/ size 2)))
    (for (in index (..< 0 (/ size 2)))
      (= ([] result index)
        (scope (/ (* (call sqrt (+ real-square (* ([] imaginary index) ([] imaginary index)))) 4) (as size F64))
          (lazy real-square (* ([] real index) ([] real index)))
        )
      )
    )
    (return result)
  )
  (fn-do _ transform _
    (let swap Size 0)
    (for (in index (..< 0 (- size 1)))
      (if (< index swap)
        (let keep-real ([] real index))
        (let keep-imaginary ([] imaginary index))
        (= ([] real index) ([] real swap))
        (= ([] imaginary index) ([] imaginary swap))
        (= ([] real swap) keep-real)
        (= ([] imaginary swap) keep-imaginary)
      )
      (let bit (/ size 2))
      (while (<= bit swap)
        (-= swap bit)
        (/= bit 2)
      )
      (+= swap bit)
    )
    (let span Size 2)
    (while (<= span size)
      (let half (/ span 2))
      (let stride (/ size span))
      (let first Size 0)
      (while (< first size)
        (for (in offset (..< 0 half))
          (let twiddle (* offset stride))
          (let a (+ first offset))
          (let b (+ a half))
          (let turned-real (- (* ([] cosines twiddle) ([] real b)) (* ([] sines twiddle) ([] imaginary b))))
          (let turned-imaginary (+ (* ([] cosines twiddle) ([] imaginary b)) (* ([] sines twiddle) ([] real b))))
          (= ([] real b) (- ([] real a) turned-real))
          (= ([] imaginary b) (- ([] imaginary a) turned-imaginary))
          (+= ([] real a) turned-real)
          (+= ([] imaginary a) turned-imaginary)
        )
        (+= first span)
      )
      (*= span 2)
    )
  )
)
