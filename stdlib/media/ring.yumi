/YuMedia/YuMedia.h

━━━━━━━━━━━━━━━━━━━━
+ MediaRing
    is Closable

+ capacity I64
+ width I64
_ native Pointer
_ data CPointer'F32
_ is-closed = false

────────────────────
+ This
    - capacity I64
    - width I64

this.capacity = capacity
this.width = width
native = C:yumiMediaRingCreate(capacity, width)
data = C:yumiMediaRingGetData(native)

────────────────────
+ get native-pointer Pointer

native

────────────────────
+ get written I64 without gc

C:yumiMediaRingGetWritten(native)

────────────────────
+ get consumed I64 without gc

C:yumiMediaRingGetConsumed(native)

────────────────────
+ get filled I64 without gc

written - consumed

────────────────────
+ get space I64 without gc

capacity - filled

────────────────────
+ get run I64 without gc

capacity - written % capacity

────────────────────
+ slot CPointer'F32 without gc
    - count I64

data + (count % capacity) * width

────────────────────
+ do publish without gc
    - count I64

C:yumiMediaRingPublish(native, count)

────────────────────
+ do consume without gc
    - count I64

C:yumiMediaRingConsume(native, count)

────────────────────
+ do close

if !is-closed
    is-closed = true
    C:yumiMediaRingRelease(native)
