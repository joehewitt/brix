(import /BxCore/BxString.h)
(import /BxSQLite/BxSQLite.h)
(import /sqlite/sqlite3.h)
(import /string.h)
(import /time/duration)

(type + SQLiteValue (is Union)
  (variant Null)
  (variant Bool)
  (variant I64)
  (variant F64)
  (variant String)
  (variant ([] Byte))
)

(type + SQLiteError (is Error)
  (prop + code I32)
  (prop + offset (? Size))
  (fn-do + This _
    (param code _)
    (param reason String)
    (param offset (? Size) (= null))
    (= message reason)
  )
  (fn-expr + primary-code I32 :get
    (/and/ code 0xff)
  )
)

(type + SQLite
  (implements Closable)
  (implements (of Usable SQLite))
  (prop + path String)
  (prop + is-shared-across-threads Bool)
  (blank)
  (prop _ handle (of CPointer I8))
  (fn-do + This _ (?! SQLiteError)
    (param path _)
    (param is-read-only _ (= false))
    (param is-shared-across-threads _ (= false))
    (param busy-timeout Milliseconds (= 5000ms))
    (let access
      (block
        (case? is-read-only
          C:SQLITE_OPEN_READONLY
        )
        (default
          (/or/ C:SQLITE_OPEN_READWRITE C:SQLITE_OPEN_CREATE)
        )
      )
    )
    (let locking (if-expr is-shared-across-threads C:SQLITE_OPEN_FULLMUTEX C:SQLITE_OPEN_NOMUTEX))
    (let opened (of CPointer I8))
    (let status (call C:sqlite3_open_v2 path &opened (/or/ access locking) null))
    (if (!= status C:SQLITE_OK)
      (let failure
        (scope (if-expr (== opened null) (call SQLiteError status (str "Unable to open " path)) last-error)
          (lazy last-error (call connection-error opened (str "Unable to open " path)))
        )
      )
      (call C:sqlite3_close_v2 opened)
      (throw failure)
    )
    (= handle opened)
    (call C:sqlite3_busy_timeout handle busy-timeout)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (do
      (inline (call close))
    )
  )
  (fn-expr + last-insert-id I64 :get
    (call C:sqlite3_last_insert_rowid handle)
  )
  (fn-expr + changes I64 :get
    (call C:sqlite3_changes64 handle)
  )
  (fn-do + close _ (?! SQLiteError)
    (return-if (if (== handle null)))
    (blank)
    (let closing handle)
    (= handle null)
    (let status (call C:sqlite3_close_v2 closing))
    (throw (call SQLiteError status (str "Unable to close " path)) (if (!= status C:SQLITE_OK)))
  )
  (fn-do + prepare SQLiteStatement (?! SQLiteError)
    (param sql String)
    (throw (call SQLiteError C:SQLITE_MISUSE (str path " is closed")) (if (== handle null)))
    (blank)
    (let prepared (of CPointer I8))
    (let has-more I32)
    (let status (call C:brixSQLitePrepare handle sql (. sql size) &prepared &has-more))
    (throw (call failure (str "Unable to prepare \"" sql "\"")) (if (!= status C:SQLITE_OK)))
    (throw (call SQLiteError C:SQLITE_MISUSE (str "\"" sql "\" holds no statement")) (if (== prepared null)))
    (blank)
    (if (!= has-more 0)
      (call C:sqlite3_finalize prepared)
      (throw
        (call SQLiteError
          (block
            (arg C:SQLITE_MISUSE)
            (arg (str "\"" sql "\" holds more than one statement; run it with execute-script"))
          )
        )
      )
    )
    (return (call SQLiteStatement this sql prepared))
  )
  (fn-do + execute I64 (?! SQLiteError)
    (param sql String)
    (param ... params (list SQLiteValue) (= (call (of List SQLiteValue))))
    (let statement (use (call prepare sql)))
    (call (. statement bind-values) params)
    (call (. statement finish))
    (return changes)
  )
  (fn-do + execute-script _ (?! SQLiteError)
    (param sql String)
    (throw (call SQLiteError C:SQLITE_MISUSE (str path " is closed")) (if (== handle null)))
    (blank)
    (let status (call C:sqlite3_exec handle sql null null null))
    (throw (call failure "Unable to run script") (if (!= status C:SQLITE_OK)))
  )
  (fn-do + (of query Item) (stream Item) (?! SQLiteError) @inline
    (param sql String)
    (param decode (fn-type Item (?! SQLiteError) (param row SQLiteRow)))
    (param ... params (list SQLiteValue) (= (call (of List SQLiteValue))))
    (let statement (use (call prepare sql)))
    (call (. statement bind-values) params)
    (while (call (. statement step))
      (yield (call decode (. statement row)))
    )
  )
  (fn-do + (of query-first Item) (? Item) (?! SQLiteError)
    (param sql String)
    (param decode (fn-type Item (?! SQLiteError) (param row SQLiteRow)))
    (param ... params (list SQLiteValue) (= (call (of List SQLiteValue))))
    (let statement (use (call prepare sql)))
    (call (. statement bind-values) params)
    (return-if null (if (not (call (. statement step)))))
    (return (call decode (. statement row)))
  )
  (fn-do + transaction _ (?! Error)
    (param body Doer)
    (param is-immediate _ (= false))
    (call execute (if-expr is-immediate "begin immediate" "begin"))
    (let committed false)
    (finally
      (if (not committed)
        (call execute "rollback"
          (block
            (on-error SQLiteError
              0
            )
          )
        )
      )
    )
    (call body)
    (call execute "commit")
    (= committed true)
  )
  (fn-expr _ failure SQLiteError
    (param context String)
    (call connection-error handle context)
  )
)

(type + SQLiteStatement
  (implements Closable)
  (implements (of Usable SQLiteStatement))
  (prop + database SQLite)
  (prop + sql String)
  (blank)
  (prop _ handle (of CPointer I8))
  (fn-do + This _
    (param database _)
    (param sql _)
    (param handle _)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (do
      (inline (call close))
    )
  )
  (fn-expr + row SQLiteRow :get
    (call SQLiteRow this)
  )
  (fn-do + bind _ (?! SQLiteError)
    (param ... params (list SQLiteValue) (= (call (of List SQLiteValue))))
    (call bind-values params)
  )
  (fn-do + step Bool (?! SQLiteError)
    (throw (call SQLiteError C:SQLITE_MISUSE (str "\"" sql "\" is closed")) (if (== handle null)))
    (blank)
    (let status (call C:sqlite3_step handle))
    (return-if true (if (== status C:SQLITE_ROW)))
    (return-if false (if (== status C:SQLITE_DONE)))
    (throw (call (. database failure) (str "Unable to run \"" sql "\"")))
  )
  (fn-do + reset _
    (return-if (if (== handle null)))
    (blank)
    (call C:sqlite3_reset handle)
  )
  (fn-do + close _
    (return-if (if (== handle null)))
    (blank)
    (call C:sqlite3_finalize handle)
    (= handle null)
  )
  (fn-do _ bind-values _ (?! SQLiteError)
    (param params (list SQLiteValue))
    (throw (call SQLiteError C:SQLITE_MISUSE (str "\"" sql "\" is closed")) (if (== handle null)))
    (blank)
    (call C:sqlite3_reset handle)
    (call C:sqlite3_clear_bindings handle)
    (let expected (as (call C:sqlite3_bind_parameter_count handle) Size))
    (throw (call SQLiteError C:SQLITE_RANGE (str "\"" sql "\" takes " expected " parameters, not " (. params length))) (if (!= (. params length) expected)))
    (blank)
    (for (in index (..< 0 (. params length)))
      (let position (as (+ index 1) I32))
      (call lock)
      (let status
        (match ([] params index)
          (case (exact Null)
            (call C:brixSQLiteBindNull handle position)
          )
          (case (: flag Bool)
            (call C:brixSQLiteBindInt64 handle position (if-expr flag 1 0))
          )
          (case (: number I64)
            (call C:brixSQLiteBindInt64 handle position number)
          )
          (case (: number F64)
            (call C:brixSQLiteBindDouble handle position number)
          )
          (case (: text String)
            (call C:brixSQLiteBindText handle position text (. text size))
          )
          (case (: bytes ([] Byte))
            (call C:brixSQLiteBindBlob handle position bytes (. bytes size))
          )
        )
      )
      (call unlock)
      (throw (call (. database failure) (str "Unable to bind parameter " (+ index 1) " of \"" sql "\"")) (if (!= status C:SQLITE_OK)))
    )
  )
  (fn-do _ lock _ @inline
    (return-if (if (not (. database is-shared-across-threads))))
    (blank)
    (call C:brixSQLiteLock (. database handle))
  )
  (fn-do _ unlock _ @inline
    (return-if (if (not (. database is-shared-across-threads))))
    (blank)
    (call C:brixSQLiteUnlock (. database handle))
  )
  (fn-do _ finish _ (?! SQLiteError)
    (let stepping true)
    (while stepping
      (= stepping (call step))
    )
  )
)

(type + SQLiteRow (is Tuple)
  (prop + statement SQLiteStatement)
  (fn-expr + length Size :get
    (call C:brixSQLiteColumnCount (. statement handle))
  )
  (fn-do + name String (?! SQLiteError)
    (param index Size)
    (call kind index)
    (return (as (call C:sqlite3_column_name (. statement handle) index) (of CPointer Char8)))
  )
  (fn-expr + is-null Bool (?! SQLiteError)
    (param index Size)
    (== (call kind index) C:SQLITE_NULL)
  )
  (fn-expr + value SQLiteValue (?! SQLiteError)
    (param index Size)
    (match? (call kind index)
      (case= C:SQLITE_INTEGER
        (call int index)
      )
      (case= C:SQLITE_FLOAT
        (call real index)
      )
      (case= C:SQLITE_TEXT
        (call string index)
      )
      (case= C:SQLITE_BLOB
        (call blob index)
      )
    )
  )
  (fn-expr + int I64 (?! SQLiteError) @inline
    (param index Size)
    (before
      (throw (call column-error index C:SQLITE_NULL "an integer") (if (== number null)))
    )
    number
    (where
      (lazy number (call optional-int index))
    )
  )
  (fn-expr + real F64 (?! SQLiteError) @inline
    (param index Size)
    (before
      (throw (call column-error index C:SQLITE_NULL "a number") (if (== number null)))
    )
    number
    (where
      (lazy number (call optional-real index))
    )
  )
  (fn-expr + bool Bool (?! SQLiteError) @inline
    (param index Size)
    (call truth index (call int index))
  )
  (fn-expr + string String (?! SQLiteError) @inline
    (param index Size)
    (before
      (throw (call column-error index C:SQLITE_NULL "text") (if (== text null)))
    )
    text
    (where
      (lazy text (call optional-string index))
    )
  )
  (fn-expr + blob ([] Byte) (?! SQLiteError) @inline
    (param index Size)
    (before
      (throw (call column-error index C:SQLITE_NULL "a blob") (if (== bytes null)))
    )
    bytes
    (where
      (lazy bytes (call optional-blob index))
    )
  )
  (fn-do + optional-int (? I64) (?! SQLiteError) @inline
    (param index Size)
    (let found I32)
    (call (. statement lock))
    (let number (call C:brixSQLiteReadInt64 (. statement handle) index &found))
    (call (. statement unlock))
    (return-if null (if (== found C:SQLITE_NULL)))
    (throw (call column-error index found "an integer") (if (!= found C:SQLITE_INTEGER)))
    (return number)
  )
  (fn-do + optional-real (? F64) (?! SQLiteError) @inline
    (param index Size)
    (let found I32)
    (call (. statement lock))
    (let number (call C:brixSQLiteReadDouble (. statement handle) index &found))
    (call (. statement unlock))
    (return-if null (if (== found C:SQLITE_NULL)))
    (throw (call column-error index found "a number") (if (and (!= found C:SQLITE_FLOAT) (!= found C:SQLITE_INTEGER))))
    (return number)
  )
  (fn-expr + optional-bool (? Bool) (?! SQLiteError) @inline
    (param index Size)
    (if-expr (== number null) null (call truth index number))
    (where
      (lazy number (call optional-int index))
    )
  )
  (fn-do + optional-string (? String) (?! SQLiteError) @inline
    (param index Size)
    (let found I32)
    (let size I64)
    (call (. statement lock))
    (let text (call C:brixSQLiteReadText (. statement handle) index &found &size))
    (call (. statement unlock))
    (return-if null (if (== found C:SQLITE_NULL)))
    (throw (call column-error index found "text") (if (!= found C:SQLITE_TEXT)))
    (return-if "" (if (== size 0)))
    (throw (call SQLiteError C:SQLITE_MISMATCH (str "Column " index " (" (call name index) ") holds text that is not UTF-8")) (if (!= (call C:brixStringValidateUtf8 text (as size Size)) 0)))
    (return (call C:brixStringCreate text (as size Size)))
  )
  (fn-do + optional-blob (? ([] Byte)) (?! SQLiteError) @inline
    (param index Size)
    (let found I32)
    (let size I64)
    (call (. statement lock))
    (let bytes (call C:brixSQLiteReadBlob (. statement handle) (as index I64) &found &size))
    (call (. statement unlock))
    (return-if null (if (== found C:SQLITE_NULL)))
    (throw (call column-error index found "a blob") (if (!= found C:SQLITE_BLOB)))
    (blank)
    (let copy ([] Byte (as size Size)))
    (if (> size 0)
      (call C:memcpy copy bytes (as size Size))
    )
    (return copy)
  )
  (fn-do _ kind I32 (?! SQLiteError)
    (param index Size)
    (call (. statement lock))
    (let found (call C:brixSQLiteReadType (. statement handle) index))
    (call (. statement unlock))
    (throw (call range-error index) (if (== found 0)))
    (return found)
  )
  (fn-expr _ truth Bool (?! SQLiteError) @inline
    (param index Size)
    (param number I64)
    (before
      (throw (call SQLiteError C:SQLITE_MISMATCH (str "Column " index " (" (call name index) ") holds " number ", not 0 or 1")) (if (and (!= number 0) (!= number 1))))
    )
    (== number 1)
  )
  (fn-expr _ column-error SQLiteError (?! SQLiteError)
    (param index Size)
    (param found I32)
    (param wanted String)
    (case? (== found 0)
      (call range-error index)
    )
    (default
      (call SQLiteError
        (block
          (arg C:SQLITE_MISMATCH)
          (arg (str "Column " index " (" (call name index) ") holds " (call sqlite-type-name found) ", not " wanted))
        )
      )
    )
  )
  (fn-expr _ range-error SQLiteError
    (param index Size)
    (call SQLiteError C:SQLITE_RANGE (str "Column " index " is out of range; the row has " length " columns"))
  )
)

(fn-expr _ connection-error SQLiteError
  (param handle (of CPointer I8))
  (param context String)
  (call SQLiteError code (str context ": " reason) (only-if (as offset Size) (if (>= offset 0))))
  (where
    (lazy code (call C:sqlite3_extended_errcode handle))
    (lazy reason (as (as (call C:sqlite3_errmsg handle) (of CPointer Char8)) String))
    (lazy offset (call C:sqlite3_error_offset handle))
  )
)

(fn-expr _ sqlite-type-name String
  (param type I32)
  (case? (only-if "an integer" (if (== type C:SQLITE_INTEGER))))
  (case? (only-if "a real" (if (== type C:SQLITE_FLOAT))))
  (case? (only-if "text" (if (== type C:SQLITE_TEXT))))
  (case? (only-if "a blob" (if (== type C:SQLITE_BLOB))))
  (default
    (inline "NULL")
  )
)
