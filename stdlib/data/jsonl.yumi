
./json

━━━━━━━━━━━━━━━━━━━━
+ JSONLineError is Error

+ line Size
+ column Size

────────────────────
+ This
    - line
    - column

message = "Line $line is not valid JSON"

━━━━━━━━━━━━━━━━━━━━
+ json-line ~ Char JSON ?! JSONLineError

~ / value JSON / \line-end
    value
?! JSONLineError(location.line + 1, location.column + 1)

.. line-end ~
    ~ "\r"? "\n"
    ~ !.
