(import /data/fuzzy)
(import /test)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Fuzzy Rank"))
  (tuple true (> (call score "ft" "file-tree") (call score "ft" "profit")))
  (tuple true (> (call score "ft" "FileTree") (call score "ft" "shift")))
  (tuple true (> (call score "file" "file.txt") (call score "file" "profile.txt")))
  (tuple true (> (call score "tree" "tree") (call score "tree" "tree-box")))
  (tuple true (> (call score "md" "notes.md") (call score "md" "medium")))
  (tuple true (> (call score "src" "lib/src") (call score "src" "resource")))
  (tuple "tree, tree-box, street" (call ranked (list "street" "tree-box" "tree") "tree"))
  (tuple "ab, a-b" (call ranked (list "a-b" "ab") "ab"))
)

(fn-expr _ score Int
  (param query String)
  (param text String)
  (?? (call (. (call FuzzyQuery query) score) text) -1)
)

(fn-expr _ ranked String
  (param names (list String))
  (param query String)
  (call (. ", " join) (call fuzzy-ranked names query (=> (name) name)))
)
