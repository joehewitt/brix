tests()

━━━━━━━━━━━━━━━━━━━━
+ tests TestRender

════════════════════
test("Fuzzy Rank")

true, score("ft", "file-tree") > score("ft", "profit")
true, score("ft", "FileTree") > score("ft", "shift")
true, score("file", "file.txt") > score("file", "profile.txt")
true, score("tree", "tree") > score("tree", "tree-box")
true, score("md", "notes.md") > score("md", "medium")
true, score("src", "lib/src") > score("src", "resource")
"tree, tree-box, street", ranked(["street", "tree-box", "tree"], "tree")
"ab, a-b", ranked(["a-b", "ab"], "ab")

━━━━━━━━━━━━━━━━━━━━
_ score Int
    - query String
    - text String

FuzzyQuery(query).score(text) ?? -1

━━━━━━━━━━━━━━━━━━━━
_ ranked String
    - names [String]
    - query String

", ".join(fuzzy-ranked(names, query, :: name => name))
