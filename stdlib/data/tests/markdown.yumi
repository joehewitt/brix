════════════════════
test("Markdown Blocks")

blocks-expected(), => html(blocks-source())
"<p>#No</p>", => html("#No")

════════════════════
test("Markdown Block Quotes")

"<blockquote><p>quoted wrapped</p></blockquote>", => html(blockquote-wrapped-source())
blockquote-paragraphs-expected(), => html(blockquote-paragraphs-source())

════════════════════
test("Markdown Fenced Code")

fence-expected(), => html(fence-source())
wide-fence-expected(), => html(wide-fence-source())
"<pre><code>open</code></pre>", => html(open-fence-source())
fenced-code-data-expected(), => fenced-code-data()

════════════════════
test("Markdown Lists")

list-expected(), => html(list-source())
list-markers-expected(), => html(list-markers-source())
"<ul><li>outer<ol start=\"3\"><li>inner</li></ol></li></ul>", => html(nested-list-source())

════════════════════
test("Markdown Tables")

table-expected(), => html(table-source())
"<p>A | B -- | ---</p>", => html(invalid-table-source())
aligned-table-expected(), => html(aligned-table-source())
short-row-table-expected(), => html(short-row-table-source())

════════════════════
test("Markdown Inline HTML")

"<p>hello<i>world</i></p>", => html("hello*world*")
"<p>hello_world</p>", => html("hello_world")
inline-expected(), => html("**bold** \\*literal\\* [link](/go)")
"<p><img src=\"/image?a=1&amp;b=2\" alt=\"&lt;alt&gt;\"></p>", => html("![<alt>](/image?a=1&b=2)")

════════════════════
test("Markdown Safe HTML")

safe-expected(), => html(safe-source())

════════════════════
test("Markdown Incomplete Markup Falls Back Locally")

"<p>before **strong after <i>ok</i></p>", => html("before **strong after *ok*")

