━━━━━━━━━━━━━━━━━━━━
_ do fenced-code-data

. parsed = Markdown(structured-fence-source())
if | doc MDDocument = parsed
    if doc.content.length == 1
        if | code MDFencedCode = doc.content[0]
            . ranges = "${code.range}|${code.body-range}|${code.first-body-line}"
            = "${code.language}|${code.body}|$ranges"
= "missing"
