(import /data/diff)
(import /test)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Diff Alignment"))
  (tuple "=5 -4 =3" (=> () (call runs (call dividers) (call dividers-without-b))))
  (tuple "=2 -2 =1" (=> () (call runs (list "a" "    x" "" "    y" "b") (list "a" "    x" "b"))))
  (tuple "=4 +4 =4" (=> () (call runs (call blocks) (call blocks-with-z))))
  (tuple "=3 +3 =2" (=> () (call runs (call functions) (call functions-with-b))))
  (tuple "=1 -1 +3 =2" (=> () (call runs (call load) (call load-with-blanks))))
  (tuple "=1 -1 +3 =1" (=> () (call runs (call assignment) (call assignment-after-calls))))
  (header (call test "Diff Line Changes"))
  (tuple "" (=> () (call changes (list "a" "b") (list "a" "b"))))
  (tuple "inserted 1" (=> () (call changes (list "a" "c") (list "a" "b" "c"))))
  (tuple "deleted before 1" (=> () (call changes (list "a" "b" "c") (list "a" "c"))))
  (tuple "modified 1" (=> () (call changes (list "a" "foo()" "z") (list "a" "bar = 3" "z"))))
  (tuple "inserted 0-1" (=> () (call changes (call (of List String)) (list "a" "b"))))
  (tuple "deleted before 0" (=> () (call changes (list "a" "b") (call (of List String)))))
  (tuple "deleted before 5" (=> () (call changes (call dividers) (call dividers-without-b))))
  (tuple "inserted 3-5" (=> () (call changes (call functions) (call functions-with-b))))
  (tuple "modified 1, inserted 2-3" (=> () (call changes (call load) (call load-with-blanks))))
  (tuple "inserted 1-2, modified 3" (=> () (call changes (call assignment) (call assignment-after-calls))))
  (tuple "modified 1, deleted before 2" (=> () (call changes (call assignment-with-extra) (list "a" "value = 2" "z"))))
  (header (call test "Diff Word Changes"))
  (tuple "2" (=> () (call words (list "a" "value = 1" "z") (list "a" "first()" "value = 2" "z") false 2)))
  (tuple "1" (=> () (call words (list "a" "value = 1" "z") (list "a" "first()" "value = 2" "z") true 1)))
  (tuple "" (=> () (call words (list "a" "value = 1" "z") (list "a" "first()" "value = 2" "z") false 1)))
  (header (call test "Diff Line Change Shifting"))
  (tuple "modified 2, deleted before 7" (=> () (call shifted 3 2)))
  (tuple "modified 2, deleted before 4" (=> () (call shifted 3 -1)))
  (tuple "modified 2, deleted before 5" (=> () (call shifted 5 2)))
  (tuple "modified 4, deleted before 7" (=> () (call shifted 1 2)))
)

(fn-expr _ runs _
  (param old (list String))
  (param new (list String))
  (call (. " " join) (in (str (call run-symbol (. each kind)) (. each count)) (. (call document old new) runs)))
)

(fn-expr _ changes _
  (param old (list String))
  (param new (list String))
  (call described (call (. (call document old new) line-changes)))
)

(fn-expr _ words _
  (param old (list String))
  (param new (list String))
  (param is-old Bool)
  (param line Index)
  (call (. ", " join) (in (call (. bytes slice-string) each) (call (. found word-changes) is-old line)))
  (where
    (lazy found (call document old new))
    (lazy bytes (if-expr is-old (. found old-text bytes) (. found new-text bytes)))
  )
)

(fn-expr _ shifted _
  (param last-line Size)
  (param delta I64)
  (call described (call diff-shifted-changes changes last-line delta))
  (where
    (lazy changes (list (call DiffLineChange .modified 2 1) (call DiffLineChange .deleted 5 0)))
  )
)

(fn-expr _ described _
  (param changes (list DiffLineChange))
  (call (. ", " join) (in (call describe each) changes))
)

(fn-expr _ describe _
  (param change DiffLineChange)
  (case? (== (. change kind) (. DiffLineChangeKind deleted))
    (str "deleted before " (. change line))
  )
  (case? (== (. change count) 1)
    (str (. change kind) " " (. change line))
  )
  (default
    (str (. change kind) " " (. change line) "-" (- (+ (. change line) (. change count)) 1))
  )
)

(fn-expr _ run-symbol _
  (param kind DiffKind)
  (case? (== kind (. DiffKind equal))
    "="
  )
  (case? (== kind (. DiffKind inserted))
    "+"
  )
  (case? (== kind (. DiffKind deleted))
    "-"
  )
  (default
    "?"
  )
)

(fn-expr _ document _
  (param old (list String))
  (param new (list String))
  (call diff-document (call text old) (call text new))
)

(fn-expr _ text _
  (param lines (list String))
  (case? (== (. lines length) 0)
    ""
  )
  (default
    (str joined "\n")
  )
  (where
    (lazy joined (call (. "\n" join) lines))
  )
)

(fn-expr _ dividers _
  (list "────" "+ a" "" "x" "────" "+ b" "" "y" "────" "+ c" "" "z")
)

(fn-expr _ dividers-without-b _
  (list "────" "+ a" "" "x" "────" "+ c" "" "z")
)

(fn-expr _ blocks _
  (list "if x" "    a()" "    b()" "end" "if y" "    a()" "    b()" "end")
)

(fn-expr _ blocks-with-z _
  (call (of List String)
    (block
      (spread (list "if x" "    a()" "    b()" "end"))
      (spread (list "if z" "    a()" "    b()" "end"))
      (spread (list "if y" "    a()" "    b()" "end"))
    )
  )
)

(fn-expr _ assignment _
  (list "a" "value = 1" "z")
)

(fn-expr _ assignment-after-calls _
  (list "a" "first()" "second()" "value = 2" "z")
)

(fn-expr _ assignment-with-extra _
  (list "a" "value = 1" "extra()" "z")
)

(fn-expr _ functions _
  (list "def a" "    1" "" "def c" "    3")
)

(fn-expr _ functions-with-b _
  (list "def a" "    1" "" "def b" "    2" "" "def c" "    3")
)

(fn-expr _ load _
  (list "load" "    = decode(read(path))" "" "title")
)

(fn-expr _ load-with-blanks _
  (list "load" "    = decode(read-text(path))" "" "" "" "title")
)
