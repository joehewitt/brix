(import /data/markdown)
(import /test)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Markdown Blocks"))
  (tuple (call blocks-expected) (=> () (call html (call blocks-source))))
  (tuple "<p>#No</p>" (=> () (call html "#No")))
  (header (call test "Markdown Block Quotes"))
  (tuple "<blockquote><p>quoted wrapped</p></blockquote>" (=> () (call html (call blockquote-wrapped-source))))
  (tuple (call blockquote-paragraphs-expected) (=> () (call html (call blockquote-paragraphs-source))))
  (header (call test "Markdown Fenced Code"))
  (tuple (call fence-expected) (=> () (call html (call fence-source))))
  (tuple (call wide-fence-expected) (=> () (call html (call wide-fence-source))))
  (tuple "<pre><code>open</code></pre>" (=> () (call html (call open-fence-source))))
  (tuple (call fenced-code-data-expected) (=> () (call fenced-code-data)))
  (header (call test "Markdown Lists"))
  (tuple (call list-expected) (=> () (call html (call list-source))))
  (tuple (call list-markers-expected) (=> () (call html (call list-markers-source))))
  (tuple "<ul><li>outer<ol start=\"3\"><li>inner</li></ol></li></ul>" (=> () (call html (call nested-list-source))))
  (header (call test "Markdown Tables"))
  (tuple (call table-expected) (=> () (call html (call table-source))))
  (tuple "<p>A | B -- | ---</p>" (=> () (call html (call invalid-table-source))))
  (tuple (call aligned-table-expected) (=> () (call html (call aligned-table-source))))
  (tuple (call short-row-table-expected) (=> () (call html (call short-row-table-source))))
  (header (call test "Markdown Inline HTML"))
  (tuple "<p>hello<i>world</i></p>" (=> () (call html "hello*world*")))
  (tuple "<p>hello_world</p>" (=> () (call html "hello_world")))
  (tuple (call inline-expected) (=> () (call html "**bold** \\*literal\\* [link](/go)")))
  (tuple "<p><img src=\"/image?a=1&amp;b=2\" alt=\"&lt;alt&gt;\"></p>" (=> () (call html "![<alt>](/image?a=1&b=2)")))
  (header (call test "Markdown Safe HTML"))
  (tuple (call safe-expected) (=> () (call html (call safe-source))))
  (header (call test "Markdown Incomplete Markup Falls Back Locally"))
  (tuple "<p>before **strong after <i>ok</i></p>" (=> () (call html "before **strong after *ok*")))
)

(fn-expr _ html _
  (param source String)
  (call markdown-to-html source)
)

(fn-expr _ inline-expected _
  "<p><b>bold</b> *literal* <a href=\"/go\">link</a></p>"
)

(fn-expr _ blocks-source _
  (paragraph
    "# Title"
    (blank)
    "first line"
    "second line"
    (blank)
    "---"
    (blank)
    "last"
  )
)

(fn-expr _ blocks-expected _
  (paragraph
    "<h1 id=\"title\">Title</h1>"
    "<p>first line second line</p>"
    "<hr>"
    "<p>last</p>"
  )
)

(fn-expr _ blockquote-wrapped-source _
  (paragraph
    "> quoted"
    "> wrapped"
  )
)

(fn-expr _ blockquote-paragraphs-source _
  (paragraph
    "> one"
    ">"
    "> two"
  )
)

(fn-expr _ blockquote-paragraphs-expected _
  (paragraph
    "<blockquote><p>one</p>"
    "<p>two</p></blockquote>"
  )
)

(fn-expr _ fence-source _
  (paragraph
    "```yumi extra"
    "<Int>&"
    "```"
  )
)

(fn-expr _ fence-expected _
  (paragraph
    "<pre><code class=\"language-yumi\">&lt;Int&gt;&amp;"
    "</code></pre>"
  )
)

(fn-expr _ wide-fence-source _
  (paragraph
    "````lang"
    "body"
    "```"
    "still"
    "````"
  )
)

(fn-expr _ wide-fence-expected _
  (paragraph
    "<pre><code class=\"language-lang\">body"
    "```"
    "still"
    "</code></pre>"
  )
)

(fn-expr _ open-fence-source _
  (paragraph
    "```"
    "open"
  )
)

(fn-expr _ structured-fence-source _
  (paragraph
    "```yumi"
    "<Int>&"
    "```"
  )
)

(fn-expr _ fenced-code-data-expected _
  (paragraph
    "yumi|<Int>&"
    "|(0, 18)|(8, 15)|2"
  )
)

(fn-expr _ list-source _
  (paragraph
    "* a"
    "    * b"
    "        * c"
    "* d"
  )
)

(fn-expr _ list-expected _
  (paragraph
    "<ul><li>a<ul><li>b<ul><li>c</li></ul></li></ul></li>"
    "<li>d</li></ul>"
  )
)

(fn-expr _ list-markers-source _
  (paragraph
    "- minus"
    "+ plus"
  )
)

(fn-expr _ list-markers-expected _
  (paragraph
    "<ul><li>minus</li>"
    "<li>plus</li></ul>"
  )
)

(fn-expr _ nested-list-source _
  (paragraph
    "* outer"
    "    3. inner"
  )
)

(fn-expr _ table-source _
  (paragraph
    "| Name | Value |"
    "| --- | --- |"
    "| a\\|b | `x|y` |"
  )
)

(fn-expr _ table-expected _
  (str (call table-head-expected) (call table-body-expected))
)

(fn-expr _ table-head-expected _
  (paragraph
    "<table><thead><tr><th>Name</th><th>Value</th></tr></thead>"
  )
)

(fn-expr _ table-body-expected _
  (paragraph
    "<tbody><tr><td>a|b</td><td><code>x|y</code></td></tr></tbody></table>"
  )
)

(fn-expr _ aligned-table-source _
  (paragraph
    "| Left | Middle | Right | Plain |"
    "|:-----|:------:|------:|-------|"
    "| a | b | c | d |"
  )
)

(fn-expr _ aligned-table-expected _
  (paragraph
    "<table><thead><tr><th align=\"left\">Left</th><th align=\"center\">Middle</th><th align=\"right\">Right</th><th>Plain</th></tr></thead><tbody><tr><td align=\"left\">a</td><td align=\"center\">b</td><td align=\"right\">c</td><td>d</td></tr></tbody></table>"
  )
)

(fn-expr _ short-row-table-source _
  (paragraph
    "Before"
    (blank)
    "| A | B |"
    "| --- | --- |"
    "| 1 | 2 |"
    "| x |"
    (blank)
    "After"
  )
)

(fn-expr _ short-row-table-expected _
  (paragraph
    "<p>Before</p>"
    "<table><thead><tr><th>A</th><th>B</th></tr></thead><tbody><tr><td>1</td><td>2</td></tr>"
    "<tr><td>x</td></tr></tbody></table>"
    "<p>After</p>"
  )
)

(fn-expr _ invalid-table-source _
  (paragraph
    "A | B"
    "-- | ---"
  )
)

(fn-expr _ safe-source _
  (paragraph
    "## <Mint> & Salt"
    "## <Mint> & Salt"
    (blank)
    "[<go>](https://example.com/?q=\"x\"&y=1)"
  )
)

(fn-expr _ safe-expected _
  (paragraph
    "<h2 id=\"mint-salt\">&lt;Mint&gt; &amp; Salt</h2>"
    "<h2 id=\"mint-salt-2\">&lt;Mint&gt; &amp; Salt</h2>"
    "<p><a href=\"https://example.com/?q=&quot;x&quot;&amp;y=1\">&lt;go&gt;</a></p>"
  )
)

(fn-do _ fenced-code-data _
  (let parsed (call Markdown (call structured-fence-source)))
  (if (= (| (: doc MDDocument)) parsed)
    (if (== (. doc content length) 1)
      (if (= (| (: code MDFencedCode)) ([] (. doc content) 0))
        (let ranges (str (. code range) "|" (. code body-range) "|" (. code first-body-line)))
        (return (str (. code language) "|" (. code body) "|" ranges))
      )
    )
  )
  (return "missing")
)
