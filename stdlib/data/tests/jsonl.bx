(import /core/arena)
(import /data/json)
(import /data/jsonl)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "JSON Lines Values"))
  (call (. cases run) value-tests)
  (= cases (call (. cases then) "JSON Lines Terminators" terminator-tests))
  (= cases (call (. cases then) "JSON Lines Invalid Lines" invalid-tests))
  (return cases)
)

(fn-do _ value-tests TestCase
  (param t TestCase)
  (let text "{\"a\": 1}\n[1, 2]\n\"text\"\n42\nnull\ntrue\n")
  (let expected "{\"a\": 1} [1, 2] \"text\" 42 null true")
  (call (. t expect) "every kind of JSON value is read" expected (call values-of text))
  (call (. t expect) "an empty source has no lines" "" (call values-of ""))
  (return t)
)

(fn-do _ terminator-tests TestCase
  (param t TestCase)
  (call (. t expect) "a final terminator is optional" "1 2" (call values-of "1\n2"))
  (call (. t expect) "carriage returns are ignored" "1 2" (call values-of "1\r\n2\r\n"))
  (call (. t expect) "surrounding spaces are ignored" "[1] 7" (call values-of "  [1] \t\n7\n"))
  (return t)
)

(fn-do _ invalid-tests TestCase
  (param t TestCase)
  (let seen (call (of List String)))
  (let malformed (catch (call read-into "{\"a\": 1}\nnot json\n[3]\n" seen)))
  (call (. t check) "malformed JSON is rejected" (is malformed JSONLineError))
  (if (is malformed JSONLineError)
    (call (. t expect) "the error counts the line" 2 (. (as malformed JSONLineError) line))
  )
  (call (. t expect) "lines before the failure are read" "{\"a\": 1}" (call (. " " join) seen))
  (blank)
  (let blank (catch (call read-into "1\n\n2\n" (call (of List String)))))
  (call (. t check) "a blank line is rejected" (is blank JSONLineError))
  (if (is blank JSONLineError)
    (call (. t expect) "the blank line is counted" 2 (. (as blank JSONLineError) line))
  )
  (blank)
  (let trailing (catch (call read-into "1\n2\n{\"b\": 2} trailing\n" (call (of List String)))))
  (call (. t check) "text after a value is rejected" (is trailing JSONLineError))
  (if (is trailing JSONLineError)
    (call (. t expect) "the trailing text is located" 3 (. (as trailing JSONLineError) line))
    (call (. t expect) "the trailing text is located in its line" 10 (. (as trailing JSONLineError) column))
  )
  (blank)
  (let truncated (catch (call read-into "1\n{\"b\": " (call (of List String)))))
  (call (. t check) "a truncated value is rejected" (is truncated JSONLineError))
  (blank)
  (let mark (catch (call read-into "﻿1\n" (call (of List String)))))
  (call (. t check) "a byte order mark is rejected" (is mark JSONLineError))
  (return t)
)

(fn-do _ values-of String (?! JSONLineError)
  (param text String)
  (let seen (call (of List String)))
  (call read-into text seen)
  (return (call (. " " join) seen))
)

(fn-do _ read-into Size (?! JSONLineError)
  (param text String)
  (param seen (list String))
  (let scratch (use (call Arena)))
  (for (in value (~> text \json-line (with (call JSONParser scratch))))
    (+= seen (call to-json value))
  )
  (return (. seen length))
)
