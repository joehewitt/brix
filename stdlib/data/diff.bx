(import /BxCore/BxString.h)
(import /core/array-builder)
(import /math)
(import /stream/aggregate)
(blank)
(prop _ diff-word-limit Size (= 65536))
(prop _ diff-indent-limit I64 (= 200))
(prop _ diff-blank-limit I64 (= 20))
(prop _ diff-slide-limit I64 (= 100))
(prop _ diff-pair-limit Size (= 4096))

(type + DiffKind (is Union)
  (variant equal)
  (variant inserted)
  (variant deleted)
  (variant notice)
  (variant gap)
  (variant file)
)

(type + DiffLine (is Struct)
  (prop + start Index)
  (prop + end Index)
  (prop + hash U32)
)

(type + DiffText
  (prop + bytes ([] Byte))
  (prop + lines (of ImmutableArray DiffLine))
  (prop + maximum-line-bytes Size)
  (prop + is-binary Bool)
  (fn-do + This _
    (param bytes _)
    (let indexed (call (of ArrayBuilder DiffLine)))
    (let start Index 0)
    (let hash 2166136261u32)
    (for (in index (..< 0 (. bytes length)))
      (let byte ([] bytes index))
      (if (== byte 0)
        (= is-binary true)
      )
      (= hash (* (/xor/ hash (as byte U32)) 16777619))
      (if (== byte 10)
        (call (. indexed append) (call DiffLine start (+ index 1) hash))
        (if (> (- (+ index 1) start) maximum-line-bytes)
          (= maximum-line-bytes (- (+ index 1) start))
        )
        (= start (+ index 1))
        (= hash 2166136261)
      )
    )
    (if (< start (. bytes length))
      (call (. indexed append) (call DiffLine start (. bytes length) hash))
      (if (> (- (. bytes length) start) maximum-line-bytes)
        (= maximum-line-bytes (- (. bytes length) start))
      )
    )
    (= lines (call (. indexed finish-immutable)))
    (if (and (not is-binary) (> (. bytes length) 0))
      (= is-binary (!= (call C:brixStringValidateUtf8 (. bytes data) (. bytes length)) 0))
    )
  )
  (fn-expr + line-text _
    (param index Index)
    (if-expr (call is-terminated index) text (str text "  ⟪no newline⟫"))
    (where
      (lazy text (call (. bytes slice-string) (..< (. ([] lines index) start) (call content-end index))))
    )
  )
  (fn-expr + is-terminated _
    (param index Index)
    (and (> (. ([] lines index) end) (. ([] lines index) start)) (== ([] bytes (- (. ([] lines index) end) 1)) 10))
  )
  (fn-do + content-end _
    (param index Index)
    (let line ([] lines index))
    (let end (. line end))
    (if (and (> end (. line start)) (== ([] bytes (- end 1)) 10))
      (-= end 1)
      (if (and (> end (. line start)) (== ([] bytes (- end 1)) 13))
        (-= end 1)
      )
    )
    (return end)
  )
)

(type + DiffRun (is Struct)
  (prop + kind DiffKind)
  (prop + old-start I64)
  (prop + new-start I64)
  (prop + count I64)
  (prop + row-end I64)
)

(type + DiffRow (is Tuple)
  (prop + kind DiffKind)
  (prop + old-line I64)
  (prop + new-line I64)
  (prop + text String)
  (prop + is-collapsed Bool)
  (prop + additions (? I64) (= null))
  (prop + deletions (? I64) (= null))
)

(type + DiffHunk (is Struct)
  (prop + start I64)
  (prop + end I64)
  (prop + row-end I64)
)

(type + DiffLineChangeKind (is Union)
  (variant inserted)
  (variant modified)
  (variant deleted)
)

(type + DiffLineChange (is Tuple)
  (prop + kind DiffLineChangeKind)
  (prop + line Size)
  (prop + count Size)
)

(type + DiffDocument (is Tuple)
  (prop + old-text DiffText)
  (prop + new-text DiffText)
  (prop + runs (of ImmutableArray DiffRun))
  (prop + row-count I64)
  (prop + additions I64)
  (prop + deletions I64)
  (prop + first-change I64)
  (prop + hunks (of ImmutableArray DiffHunk))
  (prop + old-pairs (of ImmutableArray I64))
  (prop + new-pairs (of ImmutableArray I64))
  (prop + is-identical _ (= false))
  (blank)
  (prop + maximum-line-bytes _ (=> (call max (. old-text maximum-line-bytes) (. new-text maximum-line-bytes))))
  (prop + display-row-count _ (=> (if-expr (> (. hunks length) 0) (. ([] hunks (- (. hunks length) 1)) row-end) 1)))
  (fn-do + display-row-at _
    (param address I64)
    (throw (call OutOfBoundsError "Diff display row out of bounds") (if (or (< address 0) (>= address display-row-count))))
    (blank)
    (if (== (. hunks length) 0)
      (return-if (call row-at 0) (if (== (. ([] runs 0) kind) (. DiffKind notice))))
      (return (call DiffRow .notice 0 0 "No textual changes"))
    )
    (let low Index 0)
    (let high (. hunks length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< address (. ([] hunks middle) row-end))
        (= high middle)
        (else
          (= low (+ middle 1))
        )
      )
    )
    (let hunk ([] hunks low))
    (let leading I64 (if-expr (> low 0) 1 0))
    (let offset (- address (- (. hunk row-end) (+ (- (. hunk end) (. hunk start)) leading))))
    (return-if (call row-at (- (+ (. hunk start) offset) leading)) (if (>= offset leading)))
    (blank)
    (let hidden (- (. hunk start) (. ([] hunks (- low 1)) end)))
    (return (call DiffRow .gap 0 0 (if-expr (== hidden 1) "1 unchanged line" (str hidden " unchanged lines"))))
  )
  (fn-do + gaps-before I64
    (param address I64)
    (return-if 0 (if (or (< (. hunks length) 2) (<= address 0))))
    (return-if (- (. hunks length) 1) (if (>= address display-row-count)))
    (blank)
    (let low Index 0)
    (let high (. hunks length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< address (. ([] hunks middle) row-end))
        (= high middle)
        (else
          (= low (+ middle 1))
        )
      )
    )
    (return-if 0 (if (== low 0)))
    (blank)
    (let hunk ([] hunks low))
    (let start (- (. hunk row-end) (+ (- (. hunk end) (. hunk start)) 1)))
    (return (if-expr (> address start) (as low I64) (- (as low I64) 1)))
  )
  (fn-expr + last-shown-line _
    (case? (== (. hunks length) 0)
      0
    )
    (default
      (call max (. end old-index) (. end new-index))
    )
    (where
      (lazy end (call position-at (. ([] hunks (- (. hunks length) 1)) end)))
    )
  )
  (fn-expr + shown-ranges _
    (param is-old Bool)
    (call (of List (of Range Index))
      (block
        (spread hunks)
        (pipe ?*>
          (scope (only-if (..< (. ([] (. text lines) first) start) (. ([] (. text lines) (- last 1)) end)) (if (> last first)))
            (lazy start (call position-at (. each start)))
            (lazy end (call position-at (. each end)))
            (lazy first (as (if-expr is-old (. start old-index) (. start new-index)) Index))
            (lazy last (as (if-expr is-old (. end old-index) (. end new-index)) Index))
          )
        )
      )
    )
    (where
      (lazy text (if-expr is-old old-text new-text))
    )
  )
  (fn-do + word-changes _
    (param is-old Bool)
    (param line Index)
    (let none (list (of Range Index)))
    (let pair (call paired-line is-old line))
    (return-if none (if (== pair null)))
    (blank)
    (let old-line (if-expr is-old line pair))
    (let new-line (if-expr is-old pair line))
    (return (?? (call diff-words old-text old-line new-text new-line is-old) none))
  )
  (fn-do + line-changes _
    (let changes (list DiffLineChange))
    (return-if changes (if (or (. old-text is-binary) (. new-text is-binary))))
    (blank)
    (let index Index 0)
    (while (< index (. runs length))
      (let first ([] runs index))
      (if (not (call diff-is-change (. first kind)))
        (+= index 1)
        (continue)
      )
      (let old-line (. first old-start))
      (let old-end (. first old-start))
      (let new-end (. first new-start))
      (while (and (< index (. runs length)) (call diff-is-change (. ([] runs index) kind)))
        (let run ([] runs index))
        (if (== (. run kind) (. DiffKind inserted))
          (= new-end (+ (. run new-start) (. run count)))
          (else
            (= old-end (+ (. run old-start) (. run count)))
          )
        )
        (+= index 1)
      )
      (for (in line (..< (. first new-start) new-end))
        (let pair (call paired-line false line))
        (if (and (!= pair null) (> (as pair I64) old-line))
          (+= changes (call DiffLineChange .deleted line 0))
        )
        (if (!= pair null)
          (= old-line (+ (as pair I64) 1))
        )
        (let kind (if-expr (!= pair null) (. DiffLineChangeKind modified) (. DiffLineChangeKind inserted)))
        (if (and (> (. changes length) 0) (call diff-change-extends ([] changes (- (. changes length) 1)) kind line))
          (let last ([] changes (- (. changes length) 1)))
          (= ([] changes (- (. changes length) 1)) (call DiffLineChange kind (. last line) (+ (. last count) 1)))
          (else
            (+= changes (call DiffLineChange kind line 1))
          )
        )
      )
      (if (< old-line old-end)
        (+= changes (call DiffLineChange .deleted new-end 0))
      )
    )
    (return changes)
  )
  (fn-expr + paired-line _
    (param is-old Bool)
    (param line Index)
    (if-expr (< pair 0) null (as pair Index))
    (where
      (lazy pair (if-expr is-old ([] old-pairs line) ([] new-pairs line)))
    )
  )
  (fn-expr + matching-line Index
    (param is-old Bool)
    (param line Index)
    (case? (== found null)
      (. (if-expr is-old new-text old-text) lines length)
    )
    (case? (== (. run kind) (. DiffKind equal))
      (- (+ across (as line I64)) start)
    )
    (default
      (?? (call paired-line is-old line) (as across Index))
    )
    (where
      (lazy found (call run-holding is-old line))
      (lazy run ([] runs found))
      (lazy start (if-expr is-old (. run old-start) (. run new-start)))
      (lazy across (if-expr is-old (. run new-start) (. run old-start)))
    )
  )
  (fn-do + display-address _
    (param is-old Bool)
    (param line Index)
    (return-if 0 (if (== (. hunks length) 0)))
    (blank)
    (let found (call run-holding is-old line))
    (let row row-count)
    (if (!= found null)
      (let run ([] runs found))
      (= row
        (scope (- (+ (- (. run row-end) (. run count)) (as line I64)) side-start)
          (lazy side-start (if-expr is-old (. run old-start) (. run new-start)))
        )
      )
    )
    (let low Index 0)
    (let high (. hunks length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< row (. ([] hunks middle) end))
        (= high middle)
        (else
          (= low (+ middle 1))
        )
      )
    )
    (return-if (- display-row-count 1) (if (>= low (. hunks length))))
    (blank)
    (let hunk ([] hunks low))
    (let first (- (. hunk row-end) (- (. hunk end) (. hunk start))))
    (return-if (- (+ first row) (. hunk start)) (if (>= row (. hunk start))))
    (return (if-expr (> low 0) (- first 1) first))
  )
  (fn-do _ run-holding (? Index)
    (param is-old Bool)
    (param line Index)
    (let target (as line I64))
    (let changed (if-expr is-old (. DiffKind deleted) (. DiffKind inserted)))
    (for (in index (..< 0 (. runs length)))
      (let run ([] runs index))
      (let start (if-expr is-old (. run old-start) (. run new-start)))
      (let is-on-side (or (== (. run kind) (. DiffKind equal)) (== (. run kind) changed)))
      (if (and is-on-side (>= target start) (< target (+ start (. run count))))
        (return index)
      )
    )
    (return null)
  )
  (fn-do _ position-at _
    (param address I64)
    (let low Index 0)
    (let high (. runs length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< address (. ([] runs middle) row-end))
        (= high middle)
        (else
          (= low (+ middle 1))
        )
      )
    )
    (let index (if-expr (< low (. runs length)) low (- low 1)))
    (let run ([] runs index))
    (let offset (- address (- (. run row-end) (. run count))))
    (let old-index (if-expr (!= (. run kind) (. DiffKind inserted)) (+ (. run old-start) offset) (. run old-start)))
    (let new-index (if-expr (!= (. run kind) (. DiffKind deleted)) (+ (. run new-start) offset) (. run new-start)))
    (return (call DiffSplit old-index new-index))
  )
  (fn-do + row-at _
    (param address I64)
    (throw (call OutOfBoundsError "Diff row out of bounds") (if (or (< address 0) (>= address row-count))))
    (blank)
    (let low Index 0)
    (let high (. runs length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< address (. ([] runs middle) row-end))
        (= high middle)
        (else
          (= low (+ middle 1))
        )
      )
    )
    (let run ([] runs low))
    (let offset (- address (- (. run row-end) (. run count))))
    (let old-index (+ (. run old-start) offset))
    (let new-index (+ (. run new-start) offset))
    (match (. run kind)
      (case .equal
        (return (call DiffRow (. run kind) (+ old-index 1) (+ new-index 1) (call (. new-text line-text) new-index)))
      )
      (case .inserted
        (return (call DiffRow (. run kind) 0 (+ new-index 1) (call (. new-text line-text) new-index)))
      )
      (case .deleted
        (return (call DiffRow (. run kind) (+ old-index 1) 0 (call (. old-text line-text) old-index)))
      )
      (case .notice
        (let is-binary (or (. old-text is-binary) (. new-text is-binary)))
        (return (call DiffRow (. run kind) 0 0 (call diff-notice is-binary is-identical)))
      )
      (case .gap
        (throw (call Panic "Hunk gap cannot be a diff run"))
      )
      (case .file
        (throw (call Panic "File header cannot be a diff run"))
      )
    )
  )
)

(type + DiffEntry
  (prop + path String)
  (prop + old-path (? String))
  (prop + document (? DiffDocument))
  (prop + problem (? String))
  (fn-do + This _
    (param path _)
    (param old-path (? String) (= null))
  )
  (fn-expr + title _ :get
    (if-expr old-path (str old-path " → " path) path)
  )
)

(type + DiffOutline
  (prop + entries (list DiffEntry))
  (prop + display-row-count I64)
  (prop + additions I64)
  (prop + deletions I64)
  (prop + loaded-count Size)
  (blank)
  (prop _ expanded ([] Bool))
  (prop _ ends ([] I64))
  (prop _ gap-ends ([] I64))
  (fn-do + This _
    (param entries _)
    (param is-expanded _ (= false))
    (lazy expanded ([] Bool (. entries length)))
    (lazy ends ([] I64 (. entries length)))
    (lazy gap-ends ([] I64 (. entries length)))
    (for (in index (..< 0 (. entries length)))
      (if (call is-loaded index)
        (call count ([] entries index))
      )
    )
    (call set-all is-expanded)
  )
  (fn-expr + is-expanded _
    (param file Index)
    ([] expanded file)
  )
  (fn-expr + is-loaded _
    (param file Index)
    (or (!= (. ([] entries file) document) null) (!= (. ([] entries file) problem) null))
  )
  (fn-do + toggle _
    (param file Index)
    (= ([] expanded file) (not ([] expanded file)))
    (call reindex)
  )
  (fn-do + set-expanded _
    (param file Index)
    (param is-expanded Bool)
    (return-if (if (== ([] expanded file) is-expanded)))
    (blank)
    (= ([] expanded file) is-expanded)
    (call reindex)
  )
  (fn-do + set-all _
    (param is-expanded Bool)
    (for (in index (..< 0 (. expanded length)))
      (= ([] expanded index) is-expanded)
    )
    (call reindex)
  )
  (fn-do + resolve _
    (param file Index)
    (param document DiffDocument)
    (return-if (if (call is-loaded file)))
    (blank)
    (= (. ([] entries file) document) document)
    (call count ([] entries file))
  )
  (fn-do + fail _
    (param file Index)
    (param problem String)
    (return-if (if (call is-loaded file)))
    (blank)
    (= (. ([] entries file) problem) problem)
    (call count ([] entries file))
  )
  (fn-do + reindex _
    (= display-row-count 0)
    (let gaps I64)
    (for (in index (..< 0 (. expanded length)))
      (+= display-row-count (+ 1 (call body-count index)))
      (= ([] ends index) display-row-count)
      (let document (. ([] entries index) document))
      (if (and ([] expanded index) (!= document null))
        (+= gaps (call (. document gaps-before) (. document display-row-count)))
      )
      (= ([] gap-ends index) gaps)
    )
  )
  (fn-do + widest-expanded-line _
    (let widest Size 0)
    (for (in index (..< 0 (. expanded length)))
      (let document (. ([] entries index) document))
      (if (and ([] expanded index) (!= document null) (> (. document maximum-line-bytes) widest))
        (= widest (. document maximum-line-bytes))
      )
    )
    (return widest)
  )
  (fn-expr + file-at _
    (param address I64)
    (case? (or (< address 0) (>= address display-row-count))
      null
    )
    (case? (== address (call start-of index))
      index
    )
    (default
      null
    )
    (where
      (lazy index (call entry-index address))
    )
  )
  (fn-expr + display-row-at _
    (param address I64)
    (before
      (throw (call OutOfBoundsError "Diff outline row out of bounds") (if (or (< address 0) (>= address display-row-count))))
    )
    (case? (== offset 0)
      (call DiffRow .file 0 0 (. entry title) (not ([] expanded index)) (?. document additions) (?. document deletions))
    )
    (case? (!= document null)
      (call (. document display-row-at) (- offset 1))
    )
    (default
      (call DiffRow .notice 0 0 (?? (. entry problem) "Loading…"))
    )
    (where
      (lazy index (call entry-index address))
      (lazy entry ([] entries index))
      (lazy offset (- address (call start-of index)))
      (lazy document (. entry document))
    )
  )
  (fn-expr + headers-before I64
    (param address I64)
    (case? (or (<= address 0) (== (. expanded length) 0))
      0
    )
    (case? (>= address display-row-count)
      (. expanded length)
    )
    (case? (> address (call start-of index))
      (+ (as index I64) 1)
    )
    (default
      (as index I64)
    )
    (where
      (lazy index (call entry-index address))
    )
  )
  (fn-expr + gaps-before _
    (param address I64)
    (case? (or (<= address 0) (== (. expanded length) 0))
      0
    )
    (case? (>= address display-row-count)
      ([] gap-ends (- (. expanded length) 1))
    )
    (case? (or (not ([] expanded index)) (== document null) (<= offset 0))
      prior
    )
    (default
      (+ prior (call (. document gaps-before) offset))
    )
    (where
      (lazy index (call entry-index address))
      (lazy prior (if-expr (> index 0) ([] gap-ends (- index 1)) 0))
      (lazy document (. ([] entries index) document))
      (lazy offset (- address (call start-of index) 1))
    )
  )
  (fn-expr + line-address _
    (param file Index)
    (param line Index)
    (case? (or (not ([] expanded file)) (== document null))
      start
    )
    (default
      (+ start 1 (call (. document display-address) false line))
    )
    (where
      (lazy start (call start-of file))
      (lazy document (. ([] entries file) document))
    )
  )
  (fn-do _ count _
    (param entry DiffEntry)
    (+= loaded-count 1)
    (let document (. entry document))
    (if (!= document null)
      (+= additions (. document additions))
      (+= deletions (. document deletions))
    )
  )
  (fn-expr _ body-count _
    (param index Index)
    (case? (not ([] expanded index))
      0
    )
    (default
      (?? (?. (. ([] entries index) document) display-row-count) 1)
    )
  )
  (fn-expr + start-of _
    (param index Index)
    (- ([] ends index) (call body-count index) 1)
  )
  (fn-do + entry-index _
    (param address I64)
    (let low Index 0)
    (let high (. ends length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< address ([] ends middle))
        (= high middle)
        (else
          (= low (+ middle 1))
        )
      )
    )
    (return low)
  )
)

(fn-expr + diff-document _
  (param old-bytes ([] Byte))
  (param new-bytes ([] Byte))
  (call (. (call DiffBuilder (call DiffText old-bytes) (call DiffText new-bytes)) build))
)

(fn-expr + diff-matching-line _
  (param old-bytes ([] Byte))
  (param new-bytes ([] Byte))
  (param line Index)
  (case? (call diff-same-bytes old-bytes new-bytes)
    line
  )
  (default
    (call (. (call diff-document old-bytes new-bytes) matching-line) true line)
  )
)

(fn-expr + diff-shifted-changes _
  (param changes (list DiffLineChange))
  (param last-line Size)
  (param delta I64)
  (case? (== delta 0)
    changes
  )
  (default
    (call (of List DiffLineChange)
      (block
        (spread changes)
        (pipe *>
          (scope (if-expr (> (. each line) last-line) shifted each)
            (lazy shifted (call DiffLineChange (. each kind) (+ (as (. each line) I64) delta) (. each count)))
          )
        )
      )
    )
  )
)

(fn-expr _ diff-is-change _
  (param kind DiffKind)
  (or (== kind (. DiffKind inserted)) (== kind (. DiffKind deleted)))
)

(fn-expr _ diff-change-extends _
  (param change DiffLineChange)
  (param kind DiffLineChangeKind)
  (param line Size)
  (and (== (. change kind) kind) (== (+ (. change line) (. change count)) line))
)

(fn-do _ diff-hunks _
  (param runs (of ImmutableArray DiffRun))
  (param row-count I64)
  (let result (call (of ArrayBuilder DiffHunk)))
  (let start I64 -1)
  (let end I64)
  (let display-end I64)
  (for (in run runs)
    (if (not (call diff-is-change (. run kind)))
      (continue)
    )
    (let next-start (- (. run row-end) (. run count) 3))
    (if (< next-start 0)
      (= next-start 0)
    )
    (let next-end (+ (. run row-end) 3))
    (if (> next-end row-count)
      (= next-end row-count)
    )
    (if (< start 0)
      (= start next-start)
      (else-if (> next-start (+ end 1))
        (+= display-end (+ (- end start) (if-expr (> (. result length) 0) 1 0)))
        (call (. result append) (call DiffHunk start end display-end))
        (= start next-start)
      )
    )
    (= end next-end)
  )
  (if (>= start 0)
    (+= display-end (+ (- end start) (if-expr (> (. result length) 0) 1 0)))
    (call (. result append) (call DiffHunk start end display-end))
  )
  (return (call (. result finish-immutable)))
)

(fn-expr _ diff-notice _
  (param is-binary Bool)
  (param is-identical Bool)
  (case? (and is-binary is-identical)
    "Binary contents unchanged"
  )
  (case? is-binary
    "Binary contents changed"
  )
  (default
    "No textual changes (empty file or metadata only)"
  )
)

(fn-expr _ diff-same-bytes _
  (param left ([] Byte))
  (param right ([] Byte))
  (== left right)
)

(type _ DiffToken (is Struct)
  (prop + start Index)
  (prop + end Index)
  (prop + is-space Bool)
)

(type _ DiffByteClass (is Union)
  (variant space)
  (variant word)
  (variant mark)
)

(fn-expr _ diff-words _
  (param old-text DiffText)
  (param old-line Index)
  (param new-text DiffText)
  (param new-line Index)
  (param is-old Bool)
  (case? (== changes null)
    null
  )
  (case? is-old
    (call diff-word-ranges (. old-text bytes) left (. changes old-changed))
  )
  (default
    (call diff-word-ranges (. new-text bytes) right (. changes new-changed))
  )
  (where
    (lazy left (call diff-line-tokens old-text old-line))
    (lazy right (call diff-line-tokens new-text new-line))
    (lazy changes (call diff-token-changes (. old-text bytes) left (. new-text bytes) right))
  )
)

(type _ DiffTokenChanges (is (tuple (: old-changed ([] Bool)) (: new-changed ([] Bool)))))

(fn-do _ diff-token-changes _
  (param old-bytes ([] Byte))
  (param left (list DiffToken))
  (param new-bytes ([] Byte))
  (param right (list DiffToken))
  (let shared (call min (. left length) (. right length)))
  (let head Index 0)
  (while (and (< head shared) (call diff-token-same old-bytes ([] left head) new-bytes ([] right head)))
    (+= head 1)
  )
  (let tail Index 0)
  (while (< tail (- shared head))
    (let old-token ([] left (- (. left length) tail 1)))
    (let new-token ([] right (- (. right length) tail 1)))
    (if (not (call diff-token-same old-bytes old-token new-bytes new-token))
      (break)
    )
    (+= tail 1)
  )
  (let rows (- (. left length) head tail))
  (let columns (- (. right length) head tail))
  (return-if null (if (> (* rows columns) diff-word-limit)))
  (blank)
  (let width (+ columns 1))
  (let best ([] I64 (* (+ rows 1) width)))
  (for (in row (..< 1 (+ rows 1)))
    (for (in column (..< 1 (+ columns 1)))
      (let token ([] left (- (+ head row) 1)))
      (let cell (+ (* row width) column))
      (if (call diff-token-same old-bytes token new-bytes ([] right (- (+ head column) 1)))
        (= ([] best cell) (+ ([] best (- cell width 1)) (as (- (. token end) (. token start)) I64)))
        (else
          (= ([] best cell) (call max ([] best (- cell width)) ([] best (- cell 1))))
        )
      )
    )
  )
  (let old-changed ([] Bool (. left length)))
  (let new-changed ([] Bool (. right length)))
  (let row rows)
  (let column columns)
  (while (or (> row 0) (> column 0))
    (if (and (> row 0) (> column 0))
      (let old-token ([] left (- (+ head row) 1)))
      (let new-token ([] right (- (+ head column) 1)))
      (if (call diff-token-same old-bytes old-token new-bytes new-token)
        (-= row 1)
        (-= column 1)
        (continue)
      )
    )
    (let cell (+ (* row width) column))
    (if (or (== column 0) (and (> row 0) (>= ([] best (- cell width)) ([] best (- cell 1)))))
      (= ([] old-changed (- (+ head row) 1)) true)
      (-= row 1)
      (else
        (= ([] new-changed (- (+ head column) 1)) true)
        (-= column 1)
      )
    )
  )
  (let same (+ (call diff-unchanged-bytes left old-changed) (call diff-unchanged-bytes right new-changed)))
  (let total (+ (call diff-text-bytes left) (call diff-text-bytes right)))
  (return-if null (if (< (* 4 same) total)))
  (return (call DiffTokenChanges old-changed new-changed))
)

(fn-expr _ diff-line-tokens _
  (param text DiffText)
  (param line Index)
  (call diff-tokens (. text bytes) (. ([] (. text lines) line) start) (call (. text content-end) line))
)

(fn-do _ diff-tokens _
  (param bytes ([] Byte))
  (param start Index)
  (param end Index)
  (let tokens (list DiffToken))
  (let position start)
  (while (< position end)
    (let kind (call diff-byte-class ([] bytes position)))
    (let next (+ position 1))
    (if (!= kind (. DiffByteClass mark))
      (while (and (< next end) (== (call diff-byte-class ([] bytes next)) kind))
        (+= next 1)
      )
    )
    (+= tokens (call DiffToken position next (== kind (. DiffByteClass space))))
    (= position next)
  )
  (return tokens)
)

(fn-expr _ diff-byte-class _
  (param byte Byte)
  (case? (or (== byte 32) (== byte 9) (== byte 13))
    (. DiffByteClass space)
  )
  (case? (or (>= byte 128) (== byte 95) (and (>= byte 48) (<= byte 57)))
    (. DiffByteClass word)
  )
  (case? (or (and (>= byte 65) (<= byte 90)) (and (>= byte 97) (<= byte 122)))
    (. DiffByteClass word)
  )
  (default
    (. DiffByteClass mark)
  )
)

(fn-do _ diff-token-same _
  (param left-bytes ([] Byte))
  (param left DiffToken)
  (param right-bytes ([] Byte))
  (param right DiffToken)
  (let count (- (. left end) (. left start)))
  (return-if false (if (!= count (- (. right end) (. right start)))))
  (blank)
  (for (in offset (..< 0 count))
    (return-if false (if (!= ([] left-bytes (+ (. left start) offset)) ([] right-bytes (+ (. right start) offset)))))
  )
  (return true)
)

(fn-do _ diff-text-bytes _
  (param tokens (list DiffToken))
  (let total Size 0)
  (for (in token tokens)
    (if (not (. token is-space))
      (+= total (- (. token end) (. token start)))
    )
  )
  (return total)
)

(fn-do _ diff-unchanged-bytes _
  (param tokens (list DiffToken))
  (param changed ([] Bool))
  (let total Size 0)
  (for (in index (..< 0 (. tokens length)))
    (if (and (not (. ([] tokens index) is-space)) (not ([] changed index)))
      (+= total (- (. ([] tokens index) end) (. ([] tokens index) start)))
    )
  )
  (return total)
)

(fn-do _ diff-word-ranges _
  (param bytes ([] Byte))
  (param tokens (list DiffToken))
  (param changed ([] Bool))
  (let ranges (list (of Range Index)))
  (let low Index 0)
  (let high Index 0)
  (let is-open false)
  (for (in index (..< 0 (. tokens length)))
    (if (not ([] changed index))
      (continue)
    )
    (let token ([] tokens index))
    (if (and is-open (call diff-all-space bytes high (. token start)))
      (= high (. token end))
      (else
        (if is-open
          (+= ranges (..< low high))
        )
        (= low (. token start))
        (= high (. token end))
        (= is-open true)
      )
    )
  )
  (if is-open
    (+= ranges (..< low high))
  )
  (return ranges)
)

(fn-expr _ diff-all-space _
  (param bytes ([] Byte))
  (param start Index)
  (param end Index)
  (call all (..< start end) (:where (== (call diff-byte-class ([] bytes each)) (. DiffByteClass space))))
)

(fn-do _ diff-mark _
  (param changed ([] Bool))
  (param start I64)
  (param end I64)
  (for (in index (..< start end))
    (= ([] changed index) true)
  )
)

(type _ DiffGroup
  (prop + changed ([] Bool))
  (prop + count I64)
  (prop + start I64)
  (prop + end I64)
  (fn-do + This _
    (param changed _)
    (= count (. changed length))
    (while (and (< end count) ([] changed end))
      (+= end 1)
    )
  )
  (fn-expr + is-empty _ :get
    (== end start)
  )
  (fn-do + next _
    (return-if false (if (>= end count)))
    (blank)
    (= start (+ end 1))
    (= end start)
    (while (and (< end count) ([] changed end))
      (+= end 1)
    )
    (return true)
  )
  (fn-do + previous _
    (return-if false (if (== start 0)))
    (blank)
    (= end (- start 1))
    (= start end)
    (while (and (> start 0) ([] changed (- start 1)))
      (-= start 1)
    )
    (return true)
  )
  (fn-do + slide-down _
    (param text DiffText)
    (return-if false (if (or (>= end count) (not (call diff-lines-same text start end)))))
    (blank)
    (= ([] changed start) false)
    (+= start 1)
    (= ([] changed end) true)
    (+= end 1)
    (while (and (< end count) ([] changed end))
      (+= end 1)
    )
    (return true)
  )
  (fn-do + slide-up _
    (param text DiffText)
    (return-if false (if (or (== start 0) (not (call diff-lines-same text (- start 1) (- end 1))))))
    (blank)
    (-= start 1)
    (= ([] changed start) true)
    (-= end 1)
    (= ([] changed end) false)
    (while (and (> start 0) ([] changed (- start 1)))
      (-= start 1)
    )
    (return true)
  )
)

(fn-do _ diff-compact _
  (param text DiffText)
  (param changed ([] Bool))
  (param other ([] Bool))
  (let group (call DiffGroup changed))
  (let paired (call DiffGroup other))
  (while true
    (if (not (. group is-empty))
      (let size I64)
      (let earliest-end I64)
      (let matching I64 -1)
      (let is-growing true)
      (while is-growing
        (= size (- (. group end) (. group start)))
        (= matching -1)
        (while (call (. group slide-up) text)
          (call diff-step (call (. paired previous)))
        )
        (= earliest-end (. group end))
        (if (not (. paired is-empty))
          (= matching (. group end))
        )
        (while (call (. group slide-down) text)
          (call diff-step (call (. paired next)))
          (if (not (. paired is-empty))
            (= matching (. group end))
          )
        )
        (= is-growing (!= size (- (. group end) (. group start))))
      )
      (if (!= (. group end) earliest-end)
        (let target matching)
        (if (< matching 0)
          (= target (call diff-best-shift text (. group end) earliest-end size))
        )
        (while (> (. group end) target)
          (call diff-step (call (. group slide-up) text))
          (call diff-step (call (. paired previous)))
        )
      )
    )
    (if (not (call (. group next)))
      (break)
    )
    (call diff-step (call (. paired next)))
  )
)

(fn-do _ diff-step _
  (param moved Bool)
  (throw (call Panic "Diff groups out of sync") (if (not moved)))
)

(type _ DiffSplitScore (is (tuple (: indent I64) (: penalty I64))))

(fn-do _ diff-best-shift _
  (param text DiffText)
  (param end I64)
  (param earliest-end I64)
  (param size I64)
  (let shift (call max earliest-end (call max (- end size 1) (- end diff-slide-limit))))
  (let best I64 -1)
  (let best-score (call DiffSplitScore 0 0))
  (while (<= shift end)
    (let upper (call diff-split-score text (- shift size)))
    (let lower (call diff-split-score text shift))
    (let score (call DiffSplitScore (+ (. upper indent) (. lower indent)) (+ (. upper penalty) (. lower penalty))))
    (if (or (< best 0) (<= (call diff-score-compare score best-score) 0))
      (= best shift)
      (= best-score score)
    )
    (+= shift 1)
  )
  (return best)
)

(fn-expr _ diff-score-compare _
  (param left DiffSplitScore)
  (param right DiffSplitScore)
  (- (+ (* 60 sign) (. left penalty)) (. right penalty))
  (where
    (lazy sign I64 (if-expr (> (. left indent) (. right indent)) 1 (if-expr (< (. left indent) (. right indent)) -1 0)))
  )
)

(fn-do _ diff-split-score _
  (param text DiffText)
  (param split I64)
  (let count (as (. text lines length) I64))
  (let is-end (>= split count))
  (let indent (if-expr is-end -1 (call diff-line-indent text split)))
  (let pre-blank I64)
  (let pre-indent I64 -1)
  (let line (- split 1))
  (while (>= line 0)
    (= pre-indent (call diff-line-indent text line))
    (if (!= pre-indent -1)
      (break)
    )
    (+= pre-blank 1)
    (if (== pre-blank diff-blank-limit)
      (= pre-indent 0)
      (break)
    )
    (-= line 1)
  )
  (let post-blank I64)
  (let post-indent I64 -1)
  (= line (+ split 1))
  (while (< line count)
    (= post-indent (call diff-line-indent text line))
    (if (!= post-indent -1)
      (break)
    )
    (+= post-blank 1)
    (if (== post-blank diff-blank-limit)
      (= post-indent 0)
      (break)
    )
    (+= line 1)
  )
  (let penalty I64)
  (if (and (== pre-indent -1) (== pre-blank 0))
    (+= penalty 1)
  )
  (if is-end
    (+= penalty 21)
  )
  (let trailing (if-expr (== indent -1) (+ 1 post-blank) 0))
  (let blanks (+ pre-blank trailing))
  (+= penalty (+ (* -30 blanks) (* 6 trailing)))
  (let effective (if-expr (!= indent -1) indent post-indent))
  (let any-blanks (!= blanks 0))
  (if (and (!= effective -1) (!= pre-indent -1))
    (if (> effective pre-indent)
      (+= penalty (if-expr any-blanks 10 -4))
      (else-if (< effective pre-indent)
        (if (and (!= post-indent -1) (> post-indent effective))
          (+= penalty (if-expr any-blanks 17 24))
          (else
            (+= penalty (if-expr any-blanks 17 23))
          )
        )
      )
    )
  )
  (return (call DiffSplitScore effective penalty))
)

(fn-do _ diff-line-indent _
  (param text DiffText)
  (param line I64)
  (let bounds ([] (. text lines) line))
  (let indent I64)
  (for (in index (..< (. bounds start) (. bounds end)))
    (let byte ([] (. text bytes) index))
    (if (== byte 32)
      (+= indent 1)
      (else-if (== byte 9)
        (+= indent (- 8 (% indent 8)))
      )
      (else-if (and (!= byte 10) (!= byte 13) (!= byte 11) (!= byte 12))
        (return indent)
      )
    )
    (if (>= indent diff-indent-limit)
      (return diff-indent-limit)
    )
  )
  (return -1)
)

(fn-do _ diff-lines-same _
  (param text DiffText)
  (param left I64)
  (param right I64)
  (let first ([] (. text lines) left))
  (let second ([] (. text lines) right))
  (let count (- (. first end) (. first start)))
  (return-if false (if (or (!= (. first hash) (. second hash)) (!= count (- (. second end) (. second start))))))
  (blank)
  (for (in offset (..< 0 count))
    (return-if false (if (!= ([] (. text bytes) (+ (. first start) offset)) ([] (. text bytes) (+ (. second start) offset)))))
  )
  (return true)
)

(type _ DiffWork (is Struct)
  (prop + old-start I64)
  (prop + old-end I64)
  (prop + new-start I64)
  (prop + new-end I64)
)

(type _ DiffSplit (is (tuple (: old-index I64) (: new-index I64))))

(type _ DiffBuilder
  (prop + old-text DiffText)
  (prop + new-text DiffText)
  (blank)
  (prop _ runs _ (:= (call (of ArrayBuilder DiffRun))))
  (prop _ old-changed ([] Bool))
  (prop _ new-changed ([] Bool))
  (prop _ old-pairs ([] I64))
  (prop _ new-pairs ([] I64))
  (prop _ forward ([] I64))
  (prop _ reverse ([] I64))
  (prop _ row-count I64)
  (prop _ additions I64)
  (prop _ deletions I64)
  (prop _ first-change I64 (= -1))
  (fn-do + This _
    (param old-text _)
    (param new-text _)
    (lazy capacity (+ (. old-text lines length) (. new-text lines length) 5))
    (lazy forward ([] I64 capacity))
    (lazy reverse ([] I64 capacity))
    (lazy old-changed ([] Bool (. old-text lines length)))
    (lazy new-changed ([] Bool (. new-text lines length)))
    (lazy old-pairs ([] I64 (. old-text lines length)))
    (lazy new-pairs ([] I64 (. new-text lines length)))
    (call (. ([] old-pairs (..< 0 (. old-pairs length))) fill) -1)
    (call (. ([] new-pairs (..< 0 (. new-pairs length))) fill) -1)
  )
  (fn-do + build _
    (let is-binary (or (. old-text is-binary) (. new-text is-binary)))
    (if is-binary
      (call emit .notice 0 0 1)
      (else
        (call mark-changes)
        (call diff-compact old-text old-changed new-changed)
        (call diff-compact new-text new-changed old-changed)
        (call emit-changes)
      )
    )
    (if (== row-count 0)
      (call emit .notice 0 0 1)
    )
    (let completed (call (. runs finish-immutable)))
    (let is-identical (and is-binary (call diff-same-bytes (. old-text bytes) (. new-text bytes))))
    (return
      (call DiffDocument
        (block
          (arg old-text)
          (arg new-text)
          (arg completed)
          (arg row-count)
          (arg additions)
          (arg deletions)
          (arg first-change)
          (arg (call diff-hunks completed row-count))
          (arg (. old-pairs immutable))
          (arg (. new-pairs immutable))
          (arg is-identical)
        )
      )
    )
  )
  (fn-do _ mark-changes _
    (let pending (call (of List DiffWork)))
    (+= pending (call DiffWork 0 (. old-text lines length) 0 (. new-text lines length)))
    (while (> (. pending length) 0)
      (let last (- (. pending length) 1))
      (let work ([] pending last))
      (call (. pending remove) last)
      (let a (. work old-start))
      (let b (. work new-start))
      (while (and (< a (. work old-end)) (< b (. work new-end)) (call same-line a b))
        (+= a 1)
        (+= b 1)
      )
      (let a-end (. work old-end))
      (let b-end (. work new-end))
      (while (and (< a a-end) (< b b-end) (call same-line (- a-end 1) (- b-end 1)))
        (-= a-end 1)
        (-= b-end 1)
      )
      (if (== a a-end)
        (call diff-mark new-changed b b-end)
        (else-if (== b b-end)
          (call diff-mark old-changed a a-end)
        )
        (else
          (let split (call bisect a a-end b b-end))
          (if (and split (!= split (call DiffSplit a b)) (!= split (call DiffSplit a-end b-end)))
            (+= pending (call DiffWork (. split old-index) a-end (. split new-index) b-end))
            (+= pending (call DiffWork a (. split old-index) b (. split new-index)))
            (else
              (call diff-mark old-changed a a-end)
              (call diff-mark new-changed b b-end)
            )
          )
        )
      )
    )
  )
  (fn-do _ emit-changes _
    (let old-count (as (. old-text lines length) I64))
    (let new-count (as (. new-text lines length) I64))
    (let a I64)
    (let b I64)
    (while (or (< a old-count) (< b new-count))
      (let old-start a)
      (let new-start b)
      (while (and (< a old-count) ([] old-changed a))
        (+= a 1)
      )
      (call emit .deleted old-start b (- a old-start))
      (while (and (< b new-count) ([] new-changed b))
        (+= b 1)
      )
      (call emit .inserted a new-start (- b new-start))
      (if (and (> a old-start) (> b new-start))
        (call pair-lines old-start a new-start b)
      )
      (let equal-old a)
      (let equal-new b)
      (while (and (< a old-count) (< b new-count) (not ([] old-changed a)) (not ([] new-changed b)))
        (+= a 1)
        (+= b 1)
      )
      (call emit .equal equal-old equal-new (- a equal-old))
      (throw (call Panic "Diff sides lost alignment") (if (and (== a old-start) (== b new-start))))
    )
  )
  (fn-do _ pair-lines _
    (param old-start Index)
    (param old-end Index)
    (param new-start Index)
    (param new-end Index)
    (if (<= (* (- old-end old-start) (- new-end new-start)) diff-pair-limit)
      (call pair-similar old-start (- old-end old-start) new-start (- new-end new-start))
    )
    (let a old-start)
    (let b new-start)
    (while (or (< a old-end) (< b new-end))
      (while (and (< a old-end) (< b new-end) (< ([] old-pairs a) 0) (< ([] new-pairs b) 0))
        (call pair a b)
        (+= a 1)
        (+= b 1)
      )
      (while (and (< a old-end) (< ([] old-pairs a) 0))
        (+= a 1)
      )
      (while (and (< b new-end) (< ([] new-pairs b) 0))
        (+= b 1)
      )
      (if (< a old-end)
        (+= a 1)
        (+= b 1)
      )
    )
  )
  (fn-do _ pair-similar _
    (param old-start Index)
    (param rows Index)
    (param new-start Index)
    (param columns Index)
    (let left (list (list DiffToken)))
    (for (in row (..< 0 rows))
      (+= left (call diff-line-tokens old-text (+ old-start row)))
    )
    (let right (list (list DiffToken)))
    (for (in column (..< 0 columns))
      (+= right (call diff-line-tokens new-text (+ new-start column)))
    )
    (let width (+ columns 1))
    (let similar ([] Bool (* rows columns)))
    (let best ([] I64 (* (+ rows 1) width)))
    (let row rows)
    (while (> row 0)
      (-= row 1)
      (let column columns)
      (while (> column 0)
        (-= column 1)
        (let cell (+ (* row width) column))
        (let changes (call diff-token-changes (. old-text bytes) ([] left row) (. new-text bytes) ([] right column)))
        (let is-similar (!= changes null))
        (= ([] similar (+ (* row columns) column)) is-similar)
        (= ([] best cell) (call max ([] best (+ cell width)) ([] best (+ cell 1))))
        (if (and is-similar (> (+ ([] best (+ cell width 1)) 1) ([] best cell)))
          (= ([] best cell) (+ ([] best (+ cell width 1)) 1))
        )
      )
    )
    (let a Index 0)
    (let b Index 0)
    (while (and (< a rows) (< b columns))
      (let cell (+ (* a width) b))
      (if (and ([] similar (+ (* a columns) b)) (== ([] best cell) (+ ([] best (+ cell width 1)) 1)))
        (call pair (+ old-start a) (+ new-start b))
        (+= a 1)
        (+= b 1)
        (else-if (>= ([] best (+ cell width)) ([] best (+ cell 1)))
          (+= a 1)
        )
        (else
          (+= b 1)
        )
      )
    )
  )
  (fn-do _ pair _
    (param old-line Index)
    (param new-line Index)
    (= ([] old-pairs old-line) new-line)
    (= ([] new-pairs new-line) old-line)
  )
  (fn-do _ emit _
    (param kind DiffKind)
    (param old-start I64)
    (param new-start I64)
    (param count I64)
    (return-if (if (== count 0)))
    (blank)
    (if (and (!= kind (. DiffKind equal)) (< first-change 0))
      (= first-change row-count)
    )
    (+= row-count count)
    (if (== kind (. DiffKind inserted))
      (+= additions count)
    )
    (if (== kind (. DiffKind deleted))
      (+= deletions count)
    )
    (if (> (. runs length) 0)
      (let index (- (. runs length) 1))
      (let previous ([] runs index))
      (if (== (. previous kind) kind)
        (= ([] runs index)
          (call DiffRun
            (block
              (arg kind)
              (arg (. previous old-start))
              (arg (. previous new-start))
              (arg (+ (. previous count) count))
              (arg row-count)
            )
          )
        )
        (return)
      )
    )
    (call (. runs append) (call DiffRun kind old-start new-start count row-count))
  )
  (fn-do _ same-line _
    (param a I64)
    (param b I64)
    (let old ([] (. old-text lines) a))
    (let new ([] (. new-text lines) b))
    (let count (- (. old end) (. old start)))
    (return-if false (if (or (!= (. old hash) (. new hash)) (!= count (- (. new end) (. new start))))))
    (blank)
    (for (in offset (..< 0 count))
      (return-if false (if (!= ([] (. old-text bytes) (+ (. old start) offset)) ([] (. new-text bytes) (+ (. new start) offset)))))
    )
    (return true)
  )
  (fn-do _ bisect _
    (param a I64)
    (param a-end I64)
    (param b I64)
    (param b-end I64)
    (let n (- a-end a))
    (let m (- b-end b))
    (let maximum-depth (/ (+ n m 1) 2))
    (let origin (+ maximum-depth 1))
    (let length (as (+ (* 2 maximum-depth) 3) Size))
    (call (. ([] forward (..< 0 length)) fill) -1)
    (call (. ([] reverse (..< 0 length)) fill) -1)
    (= ([] forward (+ origin 1)) 0)
    (= ([] reverse (+ origin 1)) 0)
    (let delta (- n m))
    (let odd (!= (% delta 2) 0))
    (let forward-start I64)
    (let forward-end I64)
    (let reverse-start I64)
    (let reverse-end I64)
    (let task (call get-active-task))
    (for (in depth (.. 0 maximum-depth))
      (call check-task-cancelation (. task is-cancel-in-force))
      (let diagonal (+ (- depth) forward-start))
      (while (<= diagonal (- depth forward-end))
        (let index (as (+ origin diagonal) Index))
        (let x I64)
        (if (or (== diagonal (- depth)) (and (!= diagonal depth) (< ([] forward (- index 1)) ([] forward (+ index 1)))))
          (= x ([] forward (+ index 1)))
          (else
            (= x (+ ([] forward (- index 1)) 1))
          )
        )
        (let y (- x diagonal))
        (while (and (< x n) (< y m) (call same-line (+ a x) (+ b y)))
          (+= x 1)
          (+= y 1)
        )
        (= ([] forward index) x)
        (if (> x n)
          (+= forward-end 2)
          (else-if (> y m)
            (+= forward-start 2)
          )
          (else-if odd
            (let other (- (+ origin delta) diagonal))
            (if (and (>= other 0) (< other (as length I64)) (>= ([] reverse other) 0))
              (return-if (call DiffSplit (+ a x) (+ b y)) (if (>= x (- n ([] reverse other)))))
            )
          )
        )
        (+= diagonal 2)
      )
      (= diagonal (+ (- depth) reverse-start))
      (while (<= diagonal (- depth reverse-end))
        (let index (as (+ origin diagonal) Index))
        (let x I64)
        (if (or (== diagonal (- depth)) (and (!= diagonal depth) (< ([] reverse (- index 1)) ([] reverse (+ index 1)))))
          (= x ([] reverse (+ index 1)))
          (else
            (= x (+ ([] reverse (- index 1)) 1))
          )
        )
        (let y (- x diagonal))
        (while (and (< x n) (< y m) (call same-line (- a-end x 1) (- b-end y 1)))
          (+= x 1)
          (+= y 1)
        )
        (= ([] reverse index) x)
        (if (> x n)
          (+= reverse-end 2)
          (else-if (> y m)
            (+= reverse-start 2)
          )
          (else-if (not odd)
            (let other (- (+ origin delta) diagonal))
            (if (and (>= other 0) (< other (as length I64)) (>= ([] forward other) 0))
              (let front ([] forward other))
              (return-if (call DiffSplit (+ a front) (+ (- (+ b front) delta) diagonal)) (if (>= front (- n x))))
            )
          )
        )
        (+= diagonal 2)
      )
    )
    (return null)
  )
)
