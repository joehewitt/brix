(import /core/arena)
(import /core/array-builder)
(blank)
(prop _ sexp-classes _ (= (call (of Array U8) 256 (:with (call sexp-byte-class each)))))
(prop _ sexp-text-classes _ (= (call (of Array U8) 256 (:with (call sexp-text-class each)))))

(type + Sexp (is Union)
  (variant atom String)
  (variant text String)
  (variant list (list Sexp))
)

(type + SexpKind (is U8)
  (variant open (= 0))
  (variant close (= 1))
  (variant atom (= 2))
  (variant text (= 3))
  (variant escaped-text (= 4))
  (variant comment (= 5))
)

(type + SexpError (is Error)
  (prop + offset Index)
  (prop + hint (? String))
  (fn-do + This _
    (param offset _)
    (param text String)
    (param hint (? String) (= null))
    (= message text)
  )
)

(type + SexpTape
  (prop + source String)
  (prop + bytes (of ImmutableArray Byte))
  (prop + length Size)
  (prop + line-count Size (= 1))
  (prop + keeps-comments Bool)
  (prop + first-dollar (? Index))
  (blank)
  (prop _ arena Arena)
  (prop _ kinds (of Array U8 ArenaBacking))
  (prop _ starts (of Array U32 ArenaBacking))
  (prop _ ends (of Array U32 ArenaBacking))
  (prop _ token-lines (of Array U32 ArenaBacking))
  (prop _ opens (of Array U32 ArenaBacking))
  (prop _ line-starts (of Array U32 ArenaBacking))
  (prop _ wide-lines (of Array U8 ArenaBacking))
  (prop _ located-line Size)
  (fn-do + This _
    (param source _)
    (param arena _)
    (param keeps-comments _)
    (lazy bytes (call byte-view source))
    (lazy kinds (call (of Array U8) arena token-capacity))
    (lazy starts (call (of Array U32) arena token-capacity))
    (lazy ends (call (of Array U32) arena token-capacity))
    (lazy token-lines (call (of Array U32) arena token-capacity))
    (lazy opens (call (of Array U32) arena 64))
    (lazy line-starts (call (of Array U32) arena line-capacity))
    (lazy wide-lines (call (of Array U8) arena line-capacity))
    (blank)
    (lazy token-capacity (+ (/ (. source size) 4) 16))
    (lazy line-capacity (+ (/ (. source size) 24) 16))
  )
  (fn-do + scan _ (?! SexpError)
    (throw (call Panic "SexpTape source is larger than 4 GB") (if (>= (. bytes length) (. U32 max))))
    (throw (call Panic "SexpTape is already scanned") (if (!= length 0)))
    (blank)
    (let data bytes)
    (let end (. data length))
    (let classes (. sexp-classes data))
    (let text-classes (. sexp-text-classes data))
    (let kind-data (. kinds data))
    (let start-data (. starts data))
    (let end-data (. ends data))
    (let token-line-data (. token-lines data))
    (let open-data (. opens data))
    (let line-data (. line-starts data))
    (let wide-data (. wide-lines data))
    (let capacity (. kinds length))
    (let line-capacity (. line-starts length))
    (let count Size 0)
    (let depth Size 0)
    (let line Size 0)
    (let cursor Index 0)
    (= ([] line-data 0) 0)
    (= ([] wide-data 0) 0)
    (blank)
    (while (< cursor end)
      (let byte ([] data cursor))
      (let class ([] classes (as byte Index)))
      (if (== count capacity)
        (call grow-tokens count)
        (= kind-data (. kinds data))
        (= start-data (. starts data))
        (= end-data (. ends data))
        (= token-line-data (. token-lines data))
        (= capacity (. kinds length))
      )
      (if (<= class (. SexpClass wide))
        (let first cursor)
        (if (== class (. SexpClass wide))
          (= ([] wide-data line) 1)
        )
        (+= cursor 1)
        (while (< cursor end)
          (let next ([] classes (as ([] data cursor) Index)))
          (if (== next (. SexpClass atom))
            (+= cursor 1)
            (else-if (== next (. SexpClass wide))
              (= ([] wide-data line) 1)
              (+= cursor 1)
            )
            (else
              (break)
            )
          )
        )
        (= ([] kind-data count) 2)
        (= ([] start-data count) (as first U32))
        (= ([] end-data count) (as cursor U32))
        (= ([] token-line-data count) (as line U32))
        (+= count 1)
        (else-if (== class (. SexpClass space))
          (+= cursor 1)
        )
        (else-if (== class (. SexpClass newline))
          (+= cursor 1)
          (+= line 1)
          (if (== line line-capacity)
            (call grow-lines line)
            (= line-data (. line-starts data))
            (= wide-data (. wide-lines data))
            (= line-capacity (. line-starts length))
          )
          (= ([] line-data line) (as cursor U32))
          (= ([] wide-data line) 0)
        )
        (else-if (== class (. SexpClass open))
          (if (== depth (. opens length))
            (call grow-opens depth)
            (= open-data (. opens data))
          )
          (= ([] open-data depth) (as count U32))
          (+= depth 1)
          (= ([] kind-data count) 0)
          (= ([] start-data count) (as cursor U32))
          (= ([] end-data count) 0)
          (= ([] token-line-data count) (as line U32))
          (+= count 1)
          (+= cursor 1)
        )
        (else-if (== class (. SexpClass close))
          (throw (call SexpError cursor (str "Unexpected “)” at " (call sexp-place data cursor)) (call sexp-paren-hint data)) (if (== depth 0)))
          (-= depth 1)
          (let open ([] open-data depth))
          (= ([] end-data (as open Index)) (as count U32))
          (= ([] kind-data count) 1)
          (= ([] start-data count) (as cursor U32))
          (= ([] end-data count) open)
          (= ([] token-line-data count) (as line U32))
          (+= count 1)
          (+= cursor 1)
        )
        (else-if (== class (. SexpClass quote))
          (let first cursor)
          (let first-line line)
          (let escaped false)
          (+= cursor 1)
          (while true
            (throw (call SexpError first (str "Missing closing quote for the text opened at " (call sexp-place data first))) (if (>= cursor end)))
            (let text-class ([] text-classes (as ([] data cursor) Index)))
            (if (== text-class (. SexpText plain))
              (+= cursor 1)
              (else-if (== text-class (. SexpText quote))
                (+= cursor 1)
                (break)
              )
              (else-if (== text-class (. SexpText escape))
                (throw (call SexpError cursor (str "“" (call (. ([] data (..< cursor (+ cursor 6))) slice-string)) "” at " (call sexp-place data cursor) " is half of a surrogate pair, which is no character by itself") "Write the character itself in the text") (if (call sexp-surrogate-escape data cursor end)))
                (= escaped true)
                (if (and (< (+ cursor 1) end) (== ([] data (+ cursor 1)) 10))
                  (+= line 1)
                  (if (== line line-capacity)
                    (call grow-lines line)
                    (= line-data (. line-starts data))
                    (= wide-data (. wide-lines data))
                    (= line-capacity (. line-starts length))
                  )
                  (= ([] line-data line) (as (+ cursor 2) U32))
                  (= ([] wide-data line) 0)
                )
                (+= cursor 2)
              )
              (else-if (== text-class (. SexpText newline))
                (+= cursor 1)
                (+= line 1)
                (if (== line line-capacity)
                  (call grow-lines line)
                  (= line-data (. line-starts data))
                  (= wide-data (. wide-lines data))
                  (= line-capacity (. line-starts length))
                )
                (= ([] line-data line) (as cursor U32))
                (= ([] wide-data line) 0)
              )
              (else-if (== text-class (. SexpText wide))
                (= ([] wide-data line) 1)
                (+= cursor 1)
              )
              (else
                (if (not first-dollar)
                  (= first-dollar cursor)
                )
                (+= cursor 1)
              )
            )
          )
          (= ([] kind-data count) (if-expr escaped 4 3))
          (= ([] start-data count) (as first U32))
          (= ([] end-data count) (as cursor U32))
          (= ([] token-line-data count) (as first-line U32))
          (+= count 1)
        )
        (else
          (let first cursor)
          (while (and (< cursor end) (!= ([] data cursor) 10))
            (+= cursor 1)
          )
          (if keeps-comments
            (let last cursor)
            (if (and (> last first) (== ([] data (- last 1)) 13))
              (-= last 1)
            )
            (= ([] kind-data count) 5)
            (= ([] start-data count) (as first U32))
            (= ([] end-data count) (as last U32))
            (= ([] token-line-data count) (as line U32))
            (+= count 1)
          )
        )
      )
    )
    (blank)
    (if (> depth 0)
      (let outer (as ([] open-data 0) Index))
      (let opened (as ([] start-data outer) Index))
      (throw (call SexpError opened (str "Missing “)” for the form opened at " (call sexp-place data opened)) (call sexp-paren-hint data)))
    )
    (blank)
    (= length count)
    (= line-count (+ line 1))
  )
  (fn-expr + kind SexpKind @inline
    (param index Index)
    (as ([] kinds index) SexpKind)
  )
  (fn-expr + is-open Bool @inline
    (param index Index)
    (== ([] kinds index) 0)
  )
  (fn-expr + is-close Bool @inline
    (param index Index)
    (== ([] kinds index) 1)
  )
  (fn-expr + is-atom Bool @inline
    (param index Index)
    (== ([] kinds index) 2)
  )
  (fn-expr + is-text Bool @inline
    (param index Index)
    (or (== ([] kinds index) 3) (== ([] kinds index) 4))
  )
  (fn-expr + is-comment Bool @inline
    (param index Index)
    (== ([] kinds index) 5)
  )
  (fn-expr + start Index @inline
    (param index Index)
    ([] starts index)
  )
  (fn-expr + end Index
    (param index Index)
    (if-expr (== ([] kinds index) 0) (+ (as ([] starts ([] ends index)) Index) 1) (as ([] ends index) Index))
  )
  (fn-expr + close-of Index @inline
    (param index Index)
    ([] ends index)
  )
  (fn-expr + after Index @inline
    (param index Index)
    (if-expr (== ([] kinds index) 0) (+ (as ([] ends index) Index) 1) (+ index 1))
  )
  (fn-do + forms _
    (let index Index 0)
    (while (< index length)
      (yield index)
      (= index (call after index))
    )
  )
  (fn-do + children _
    (param index Index)
    (let item (+ index 1))
    (let close (as ([] ends index) Index))
    (while (< item close)
      (yield item)
      (= item (call after item))
    )
  )
  (fn-expr + atom-text String
    (param index Index)
    (call (. bytes slice-string) (..< (as ([] starts index) Index) (as ([] ends index) Index)))
  )
  (fn-expr + atom-is Bool
    (param index Index)
    (param text String)
    (call atom-matches index (call byte-view text))
  )
  (fn-do + atom-matches Bool
    (param index Index)
    (param expected (of ImmutableArray Byte))
    (let first (as ([] starts index) Index))
    (return-if false (if (!= (- (as ([] ends index) Index) first) (. expected length))))
    (for (in offset (..< 0 (. expected length)))
      (return-if false (if (!= ([] bytes (+ first offset)) ([] expected offset))))
    )
    (return true)
  )
  (fn-expr + text-value String
    (param index Index)
    (case? (== ([] kinds index) 3)
      (call (. bytes slice-string) (..< first last))
    )
    (default
      (call sexp-unescaped-text bytes first last)
    )
    (where
      (lazy first (+ (as ([] starts index) Index) 1))
      (lazy last (- (as ([] ends index) Index) 1))
    )
  )
  (fn-expr + comment-text String
    (param index Index)
    (call (. bytes slice-string) (..< (+ (as ([] starts index) Index) 1) (as ([] ends index) Index)))
  )
  (fn-do + location TokenLocation
    (param offset Index)
    (= located-line (call line-at offset located-line))
    (return (call column-location offset located-line))
  )
  (fn-expr + token-location TokenLocation
    (param index Index)
    (call column-location ([] starts index) ([] token-lines index))
  )
  (fn-expr + token-end-location TokenLocation
    (param index Index)
    (case? (== kind 0)
      (call column-location (+ (as ([] starts last) Index) 1) ([] token-lines last))
    )
    (case? (and (!= kind 3) (!= kind 4))
      (call column-location last line)
    )
    (default
      (call column-location last (call line-at last line))
    )
    (where
      (lazy kind ([] kinds index))
      (lazy line (as ([] token-lines index) Size))
      (lazy last (as ([] ends index) Index))
    )
  )
  (fn-do _ grow-tokens _
    (param count Size)
    (let capacity (* (. kinds length) 2))
    (let next-kinds (call (of Array U8) arena capacity))
    (let next-starts (call (of Array U32) arena capacity))
    (let next-ends (call (of Array U32) arena capacity))
    (let next-lines (call (of Array U32) arena capacity))
    (let kind-data (. kinds data))
    (let start-data (. starts data))
    (let end-data (. ends data))
    (let line-data (. token-lines data))
    (let next-kind-data (. next-kinds data))
    (let next-start-data (. next-starts data))
    (let next-end-data (. next-ends data))
    (let next-line-data (. next-lines data))
    (for (in index (..< 0 count))
      (= ([] next-kind-data index) ([] kind-data index))
      (= ([] next-start-data index) ([] start-data index))
      (= ([] next-end-data index) ([] end-data index))
      (= ([] next-line-data index) ([] line-data index))
    )
    (= kinds next-kinds)
    (= starts next-starts)
    (= ends next-ends)
    (= token-lines next-lines)
  )
  (fn-do _ grow-lines _
    (param count Size)
    (let capacity (* (. line-starts length) 2))
    (let next-starts (call (of Array U32) arena capacity))
    (let next-wide (call (of Array U8) arena capacity))
    (let start-data (. line-starts data))
    (let wide-data (. wide-lines data))
    (let next-start-data (. next-starts data))
    (let next-wide-data (. next-wide data))
    (for (in index (..< 0 count))
      (= ([] next-start-data index) ([] start-data index))
      (= ([] next-wide-data index) ([] wide-data index))
    )
    (= line-starts next-starts)
    (= wide-lines next-wide)
  )
  (fn-do _ grow-opens _
    (param count Size)
    (let next-opens (call (of Array U32) arena (* (. opens length) 2)))
    (let open-data (. opens data))
    (let next-open-data (. next-opens data))
    (for (in index (..< 0 count))
      (= ([] next-open-data index) ([] open-data index))
    )
    (= opens next-opens)
  )
  (fn-do _ line-at Size
    (param offset Index)
    (param hint Size)
    (let data (. line-starts data))
    (return-if (call line-before offset) (if (< offset (as ([] data hint) Index))))
    (let line hint)
    (while (and (< (+ line 1) line-count) (<= (as ([] data (+ line 1)) Index) offset))
      (+= line 1)
    )
    (return line)
  )
  (fn-do _ column-location TokenLocation
    (param offset Index)
    (param line Size)
    (let line-start (as ([] (. line-starts data) line) Index))
    (return-if (call TokenLocation (as line U32) (as (- offset line-start) U32)) (if (== ([] (. wide-lines data) line) 0)))
    (let column U32)
    (for (in position (..< line-start offset))
      (let byte ([] bytes position))
      (if (or (< byte 128) (>= byte 192))
        (+= column 1)
      )
    )
    (return (call TokenLocation (as line U32) column))
  )
  (fn-do _ line-before Size
    (param offset Index)
    (let data (. line-starts data))
    (let low Size 0)
    (let high line-count)
    (while (> (- high low) 1)
      (let middle (/ (+ low high) 2))
      (if (<= (as ([] data middle) Index) offset)
        (= low middle)
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
)

(fn-do + sexp-tape SexpTape (?! SexpError)
  (param source String)
  (param arena Arena)
  (param keeps-comments _ (= true))
  (let tape (call SexpTape source arena keeps-comments))
  (call (. tape scan))
  (return tape)
)

(fn-expr + sexp-parse (list Sexp) (?! SexpError)
  (param source String)
  (call List (in (call sexp-tree tape each) (call (. tape forms))))
  (where
    (lazy scratch (use (call Arena)))
    (lazy tape (call sexp-tape source scratch false))
  )
)

(fn-do + sexp-tree Sexp
  (param tape SexpTape)
  (param index Index)
  (match (call (. tape kind) index)
    (case= .open
      (return (call (. Sexp list) (call List (in (call sexp-tree tape each) (call (. tape children) index) (when (not (call (. tape is-comment) each)))))))
    )
    (case= .atom
      (return (call (. Sexp atom) (call (. tape atom-text) index)))
    )
    (default
      (return (call (. Sexp text) (call (. tape text-value) index)))
    )
  )
)

(fn-expr + sexp-written String
  (param sexp Sexp)
  (match sexp
    (case (call .atom name)
      name
    )
    (case (call .text value)
      (call sexp-quoted value)
    )
    (case (call .list items)
      (str "(" (call (. " " join) (in (call sexp-written each) items)) ")")
    )
  )
)

(fn-expr + sexp-quoted String
  (param value String)
  (str "\"" (call (. "" join) (in (call sexp-escaped each) value)) "\"")
)

(fn-do + sexp-unescaped-text String
  (param bytes (of ImmutableArray Byte))
  (param first Index)
  (param last Index)
  (let decoded (call (of ArrayBuilder Byte)))
  (let run first)
  (let index first)
  (while (< index last)
    (if (and (== ([] bytes index) 92) (< (+ index 1) last))
      (call (. decoded append-all) ([] bytes (..< run index)))
      (let width (call sexp-hex-width bytes (+ index 1) last))
      (if (> width 0)
        (let code U32)
        (for (in offset (..< 0 width))
          (= code (+ (* code 16) (as (call sexp-hex-value ([] bytes (+ index 2 offset))) U32)))
        )
        (call (. decoded append-all) (call byte-view (as (as code Char) String)))
        (+= index (+ 2 width))
        (else
          (call (. decoded append) (call sexp-unescaped-byte ([] bytes (+ index 1))))
          (+= index 2)
        )
      )
      (= run index)
      (else
        (+= index 1)
      )
    )
  )
  (call (. decoded append-all) ([] bytes (..< run last)))
  (return (call (. (call (. decoded finish-mutable)) slice-string)))
)

(fn-expr + sexp-place String
  (param bytes (of ImmutableArray Byte))
  (param offset Index)
  (str "line " (+ (. place line) 1) ", column " (+ (. place column) 1))
  (where
    (lazy place (call sexp-location bytes offset))
  )
)

(fn-do + sexp-location TokenLocation
  (param bytes (of ImmutableArray Byte))
  (param offset Index)
  (let line U32)
  (let column U32)
  (for (in index (..< 0 offset))
    (let byte ([] bytes index))
    (if (== byte 10)
      (+= line 1)
      (= column 0)
      (else-if (or (< byte 128) (>= byte 192))
        (+= column 1)
      )
    )
  )
  (return (call TokenLocation line column))
)

(fn-do + sexp-paren-hint (? String)
  (param bytes (of ImmutableArray Byte))
  (let open (list SexpOpen))
  (let line Size 1)
  (let indent Size 0)
  (let is-leading true)
  (let index Index 0)
  (while (< index (. bytes length))
    (let byte ([] bytes index))
    (if (== byte 10)
      (+= line 1)
      (= indent 0)
      (= is-leading true)
      (+= index 1)
      (continue)
    )
    (if (or (== byte 32) (== byte 9) (== byte 13))
      (if is-leading
        (+= indent 1)
      )
      (+= index 1)
      (continue)
    )
    (if (== byte 59)
      (while (and (< index (. bytes length)) (!= ([] bytes index) 10))
        (+= index 1)
      )
      (continue)
    )
    (if (and is-leading (!= byte 41))
      (let late (call sexp-stale-open open line indent))
      (if (!= late null)
        (return (str "The " (call sexp-open-name bytes late) " opened on line " (. late line) " is still open on line " line ", which is indented no deeper. It probably needs its “)” before line " line "."))
      )
    )
    (if (== byte 34)
      (+= index 1)
      (while (and (< index (. bytes length)) (!= ([] bytes index) 34))
        (if (== ([] bytes index) 10)
          (+= line 1)
        )
        (+= index (if-expr (== ([] bytes index) 92) 2 1))
      )
      (else-if (== byte 40)
        (+= open (call SexpOpen line indent index))
      )
      (else-if (== byte 41)
        (return-if (str "The “)” on line " line " closes nothing.") (if (== (. open length) 0)))
        (let held ([] open (- (. open length) 1)))
        (if (and is-leading (!= (. held line) line) (> (. held indent) indent))
          (return (str "The " (call sexp-open-name bytes held) " opened on line " (. held line) " is still open where line " line " closes a form that began further left. It probably needs its “)” before line " line "."))
        )
        (if (and is-leading (!= (. held line) line) (< (. held indent) indent))
          (return (str "The “)” on line " line " closes the " (call sexp-open-name bytes held) " opened on line " (. held line) ", which began further left. A line before it probably has one “)” too many."))
        )
        (-= ([] open (- (. open length) 1)))
      )
    )
    (= is-leading false)
    (+= index 1)
  )
  (return-if null (if (== (. open length) 0)))
  (let last ([] open (- (. open length) 1)))
  (return (str "At the end of the file " (. open length) " forms are still open. The innermost is the " (call sexp-open-name bytes last) " opened on line " (. last line) "."))
)

(type _ SexpClass (is U8)
  (variant atom)
  (variant wide)
  (variant space)
  (variant newline)
  (variant open)
  (variant close)
  (variant quote)
  (variant semicolon)
)

(type _ SexpText (is U8)
  (variant plain)
  (variant wide)
  (variant escape)
  (variant dollar)
  (variant newline)
  (variant quote)
)

(type _ SexpOpen (is Tuple)
  (prop + line Size)
  (prop + indent Size)
  (prop + offset Index)
)

(fn-expr _ sexp-escaped String
  (param c Char)
  (case? (or (== c (char "\"")) (== c (char "\\")) (== c '$'))
    (str "\\" c)
  )
  (case? (== c (char "\n"))
    "\\n"
  )
  (case? (== c (char "\t"))
    "\\t"
  )
  (case? (== c (char "\r"))
    "\\r"
  )
  (case? (call sexp-is-control (as c U32))
    (call sexp-hex-escape (as c U32))
  )
  (default
    (as c String)
  )
)

(fn-expr _ sexp-is-control Bool
  (param code U32)
  (or (< code 32) (and (>= code 127) (< code 160)) (== code 8232) (== code 8233) (== code 64976))
)

(fn-expr _ sexp-hex-escape String
  (param code U32)
  (if-expr (>= code 256) (str "\\u" high low) (str "\\x" low))
  (where
    (lazy digits (. "0123456789abcdef" codepoints))
    (lazy high (str ([] digits (% (/ code 4096) 16)) ([] digits (% (/ code 256) 16))))
    (lazy low (str ([] digits (% (/ code 16) 16)) ([] digits (% code 16))))
  )
)

(fn-expr _ sexp-byte-class U8
  (param code Size)
  (case? (or (== code 32) (== code 9) (== code 13))
    (. SexpClass space)
  )
  (case? (== code 10)
    (. SexpClass newline)
  )
  (case? (== code 40)
    (. SexpClass open)
  )
  (case? (== code 41)
    (. SexpClass close)
  )
  (case? (== code 34)
    (. SexpClass quote)
  )
  (case? (== code 59)
    (. SexpClass semicolon)
  )
  (case? (>= code 128)
    (. SexpClass wide)
  )
  (default
    (. SexpClass atom)
  )
)

(fn-expr _ sexp-text-class U8
  (param code Size)
  (case? (== code 34)
    (. SexpText quote)
  )
  (case? (== code 92)
    (. SexpText escape)
  )
  (case? (== code 36)
    (. SexpText dollar)
  )
  (case? (== code 10)
    (. SexpText newline)
  )
  (case? (>= code 128)
    (. SexpText wide)
  )
  (default
    (. SexpText plain)
  )
)

(fn-expr _ sexp-unescaped-byte Byte
  (param byte Byte)
  (match byte
    (case= 110
      10
    )
    (case= 116
      9
    )
    (case= 114
      13
    )
    (default
      byte
    )
  )
)

(fn-do _ sexp-hex-width Size
  (param bytes (of ImmutableArray Byte))
  (param index Index)
  (param last Index)
  (let width Size 0)
  (if (== ([] bytes index) 120)
    (= width 2)
    (else-if (== ([] bytes index) 117)
      (= width 4)
    )
  )
  (return-if 0 (if (or (== width 0) (>= (+ index width) last))))
  (for (in offset (.. 1 width))
    (return-if 0 (if (< (call sexp-hex-value ([] bytes (+ index offset))) 0)))
  )
  (return width)
)

(fn-expr _ sexp-surrogate-escape Bool
  (param bytes (of ImmutableArray Byte))
  (param index Index)
  (param last Index)
  ; Whether the escape at a backslash writes half of a surrogate pair, from "\uD800" to "\uDFFF".
  (case? (or (>= (+ index 5) last) (!= ([] bytes (+ index 1)) 117))
    false
  )
  (default
    (and (== (call sexp-hex-width bytes (+ index 1) last) 4) high)
    (lazy high (and (or (== ([] bytes (+ index 2)) 68) (== ([] bytes (+ index 2)) 100)) (>= (call sexp-hex-value ([] bytes (+ index 3))) 8)))
  )
)

(fn-expr _ sexp-hex-value Int
  (param byte Byte)
  (case? (and (>= byte 48) (<= byte 57))
    (- (as byte Int) 48)
  )
  (case? (and (>= byte 97) (<= byte 102))
    (- (as byte Int) 87)
  )
  (case? (and (>= byte 65) (<= byte 70))
    (- (as byte Int) 55)
  )
  (default
    -1
  )
)

(fn-do _ sexp-stale-open (? SexpOpen)
  (param open (list SexpOpen))
  (param line Size)
  (param indent Size)
  (for (in held open)
    (return-if held (if (and (< (. held line) line) (>= (. held indent) indent))))
  )
  (return null)
)

(fn-do _ sexp-open-name String
  (param bytes (of ImmutableArray Byte))
  (param held SexpOpen)
  (let start (+ (. held offset) 1))
  (let end start)
  (while (and (< end (. bytes length)) (not (or (== ([] bytes end) 32) (== ([] bytes end) 10) (== ([] bytes end) 40) (== ([] bytes end) 41) (== ([] bytes end) 34))))
    (+= end 1)
  )
  (return-if "list" (if (== end start)))
  (return (str "(" (call (. bytes slice-string) (..< start end)) " …)"))
)
