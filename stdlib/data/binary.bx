(import /BxCore/BxString.h)

(fn-expr + utf8-string String (?! SyntaxError)
  (param bytes ([] Byte))
  (before
    (throw (call SyntaxError "The bytes are not UTF-8 text") (if (!= (call C:brixStringValidateUtf8 bytes (. bytes size)) 0)))
  )
  (call (. bytes slice-string))
)

(type + ByteWriter
  (prop + size Size (= 0))
  (blank)
  (prop _ buffer _ (= ([] Byte 64)))
  (fn-do + u8 _
    (param value Byte)
    (call reserve 1)
    (= ([] buffer size) value)
    (+= size 1)
  )
  (fn-do + u16-be _
    (param value U16)
    (call unsigned value 2 false)
  )
  (fn-do + u16-le _
    (param value U16)
    (call unsigned value 2 true)
  )
  (fn-do + u32-be _
    (param value U32)
    (call unsigned value 4 false)
  )
  (fn-do + u32-le _
    (param value U32)
    (call unsigned value 4 true)
  )
  (fn-do + u64-be _
    (param value U64)
    (call unsigned value 8 false)
  )
  (fn-do + u64-le _
    (param value U64)
    (call unsigned value 8 true)
  )
  (fn-do + f32-be _
    (param value F32)
    (let cell value)
    (call unsigned ([] (as &cell (of CPointer U32)) 0) 4 false)
  )
  (fn-do + f32-le _
    (param value F32)
    (let cell value)
    (call unsigned ([] (as &cell (of CPointer U32)) 0) 4 true)
  )
  (fn-do + f64-be _
    (param value F64)
    (let cell value)
    (call unsigned ([] (as &cell (of CPointer U64)) 0) 8 false)
  )
  (fn-do + f64-le _
    (param value F64)
    (let cell value)
    (call unsigned ([] (as &cell (of CPointer U64)) 0) 8 true)
  )
  (fn-do + varint _
    (param value U64)
    (let rest value)
    (while (>= rest 0x80)
      (call u8 (as (/or/ (/and/ rest 0x7f) 0x80) Byte))
      (= rest (/zrshift/ rest 7))
    )
    (call u8 (as rest Byte))
  )
  (fn-do + bytes _
    (param value (of ImmutableArray Byte))
    (call reserve (. value size))
    (= ([] buffer (..< size (+ size (. value size)))) value)
    (+= size (. value size))
  )
  (fn-do + finish ([] Byte)
    (let result ([] Byte size))
    (= ([] result (..< 0 size)) ([] buffer (..< 0 size)))
    (return result)
  )
  (fn-do _ unsigned _
    (param value U64)
    (param count Size)
    (param little Bool)
    (call reserve count)
    (for (in index (..< 0 count))
      (let shift (if-expr little index (- count 1 index)))
      (= ([] buffer (+ size index)) (as (/and/ (/zrshift/ value (as (* shift 8) U64)) 0xff) U8))
    )
    (+= size count)
  )
  (fn-do _ reserve _
    (param count Size)
    (return-if (if (<= (+ size count) (. buffer size))))
    (blank)
    (let capacity (* (. buffer size) 2))
    (while (< capacity (+ size count))
      (*= capacity 2)
    )
    (let grown ([] Byte capacity))
    (= ([] grown (..< 0 size)) ([] buffer (..< 0 size)))
    (= buffer grown)
  )
)

(type + ByteReader
  (prop + data ([] Byte))
  (prop + offset Size (= 0))
  (fn-do + This _
    (param data _)
  )
  (fn-expr + remaining Size :get
    (- (. data size) offset)
  )
  (fn-expr + is-done Bool :get
    (>= offset (. data size))
  )
  (fn-do + u8 Byte (?! SyntaxError)
    (call need 1)
    (+= offset 1)
    (return ([] data (- offset 1)))
  )
  (fn-expr + u16-be U16 (?! SyntaxError)
    (as (call unsigned 2 false) U16)
  )
  (fn-expr + u16-le U16 (?! SyntaxError)
    (as (call unsigned 2 true) U16)
  )
  (fn-expr + u32-be U32 (?! SyntaxError)
    (as (call unsigned 4 false) U32)
  )
  (fn-expr + u32-le U32 (?! SyntaxError)
    (as (call unsigned 4 true) U32)
  )
  (fn-expr + u64-be U64 (?! SyntaxError)
    (call unsigned 8 false)
  )
  (fn-expr + u64-le U64 (?! SyntaxError)
    (call unsigned 8 true)
  )
  (fn-do + f32-be F32 (?! SyntaxError)
    (let cell (as (call unsigned 4 false) U32))
    (return ([] (as &cell (of CPointer F32)) 0))
  )
  (fn-do + f32-le F32 (?! SyntaxError)
    (let cell (as (call unsigned 4 true) U32))
    (return ([] (as &cell (of CPointer F32)) 0))
  )
  (fn-do + f64-be F64 (?! SyntaxError)
    (let cell (call unsigned 8 false))
    (return ([] (as &cell (of CPointer F64)) 0))
  )
  (fn-do + f64-le F64 (?! SyntaxError)
    (let cell (call unsigned 8 true))
    (return ([] (as &cell (of CPointer F64)) 0))
  )
  (fn-do + varint U64 (?! SyntaxError)
    (let value U64)
    (let shift U64)
    (while true
      (throw (call SyntaxError (str "A varint at offset " offset " runs past 64 bits")) (if (>= shift 64)))
      (blank)
      (let byte (call u8))
      (= value (/or/ value (/lshift/ (as (/and/ byte 0x7f) U64) shift)))
      (return-if value (if (< byte 0x80)))
      (blank)
      (+= shift 7)
    )
  )
  (fn-do + bytes ([] Byte) (?! SyntaxError)
    (param count Size)
    (call need count)
    (let result ([] Byte count))
    (= ([] result (..< 0 count)) ([] data (..< offset (+ offset count))))
    (+= offset count)
    (return result)
  )
  (fn-do + unsigned U64 (?! SyntaxError)
    (param count Size)
    (param little Bool)
    (call need count)
    (let value U64)
    (for (in index (..< 0 count))
      (let shift (if-expr little index (- count 1 index)))
      (= value (/or/ value (/lshift/ (as ([] data (+ offset index)) U64) (as (* shift 8) U64))))
    )
    (+= offset count)
    (return value)
  )
  (fn-do _ need _ (?! SyntaxError)
    (param count Size)
    (throw (call SyntaxError shortfall) (if (> count remaining)))
    (blank)
    (lazy shortfall
      (paragraph
        (str "The data ends at " (. data size) " bytes, before the " count " bytes wanted at offset " offset)
      )
    )
  )
)
