━━━━━━━━━━━━━━━━━━━━
+ do sexp-read [U32] ?! SexpError
    - text String
    - store SourceStore
    - marks SexpMarks? = null

. scratch = use Arena()
= SexpReader(sexp-tape(text, scratch), store, marks).read()

━━━━━━━━━━━━━━━━━━━━
+ sexp-top-level-ranges [SexpRange] ?! SexpError
    - text String

List(SexpRange(tape.start(each), tape.end(each)) in tape.forms())

.. scratch = use Arena()
.. tape = sexp-tape(text, scratch)

━━━━━━━━━━━━━━━━━━━━
+ SexpWritten is Tuple

+ text String
+ ids [U32]
+ starts-apart Bool
+ ends-apart Bool
+ ends-comment Bool

━━━━━━━━━━━━━━━━━━━━
+ sexp-text String
    - store SourceStore
    - nodes [ImmutableTableRow'SourceNode]
    - layout SexpLayout

sexp-written(store, nodes, layout, null).text

━━━━━━━━━━━━━━━━━━━━
+ do sexp-written SexpWritten
    - store SourceStore
    - nodes [ImmutableTableRow'SourceNode]
    - layout SexpLayout
    - swap ImmutableTableRow'SourceNode?

. writer = SexpWriter(store, layout, swap)
. index Index = 0
. starts-apart = false
. follows-apart = false
while index < nodes.length
    . node = nodes[index]
    . wrap = layout.wrapper(node)
    . is-apart = wrap != null || layout.is-apart(node)
    if index == 0
        starts-apart = is-apart
    else if (is-apart || follows-apart) && !store.is-comment(nodes[index - 1])
        writer.ids += 0
        writer.parts += "\n"
    follows-apart = is-apart
    if wrap == null
        writer.write(node, 0)
        writer.parts += "\n"
        index += 1
        continue
    . last = index
    . cursor = index + 1
    while cursor < nodes.length
        . next = nodes[cursor]
        if layout.wrapper(next) == wrap
            last = cursor
        else if !store.is-comment(next) && !store.is-blank(next)
            break
        cursor += 1
    writer.ids += 0
    writer.parts += "($wrap"
    for position in index .. last
        writer.parts += "\n  "
        writer.write(nodes[position], 1)
    writer.ids += 0
    writer.parts += "\n)\n"
    index = last + 1
. ends-comment = nodes.length > 0 && store.is-comment(nodes[nodes.length - 1])
= SexpWritten("".join(writer.parts), writer.ids, starts-apart, follows-apart, ends-comment)

━━━━━━━━━━━━━━━━━━━━
+ do sexp-nested-text String
    - store SourceStore
    - node ImmutableTableRow'SourceNode
    - layout SexpLayout
    - depth Int

. writer = SexpWriter(store, layout, null)
writer.write(node, depth)
= "".join(writer.parts)

━━━━━━━━━━━━━━━━━━━━
+ do sexp-inline-text String
    - store SourceStore
    - node ImmutableTableRow'SourceNode

. writer = SexpWriter(store, null, null)
writer.write-inline(node)
= "".join(writer.parts)

━━━━━━━━━━━━━━━━━━━━
_ SexpWriter

+ parts [String]
+ ids [U32]

_ store SourceStore
_ layout SexpLayout?
_ swap ImmutableTableRow'SourceNode?

────────────────────
+ This
    - store
    - layout
    - swap

────────────────────
+ do write
    - item ImmutableTableRow'SourceNode
    - depth Int

. node = shown(item)
ids += node.id
do match node
    | .list(_, start, count)
        write-list(node, store.nodes[start .. < start + count], depth)
    ??
        write-inline(node)

────────────────────
_ do write-list
    - node ImmutableTableRow'SourceNode
    - items ImmutableTableSpan'SourceNode
    - depth Int

. count = items.length
. inline = header-count(node) ?? count
if inline > count
    inline = count
for index in 0 .. < inline
    if breaks(items[index])
        inline = if index > 0 then index else 1
        break
parts += "("
for index in 0 .. < inline
    if index > 0
        parts += " "
    write-inline(items[index])
if inline >= count
    parts += ")"
    =
for index in inline .. < count
    parts += "\n"
    parts += "  " * (depth + 1)
    write(items[index], depth + 1)
parts += "\n"
parts += "  " * depth
ids += node.id
parts += ")"

────────────────────
+ do write-inline
    - item ImmutableTableRow'SourceNode

. node = shown(item)
do match node
    | .atom(_, text)
        parts += text
    | .string(_, text)
        parts += sexp-quoted(text)
    | .comment(_, text)
        parts += if text.length > 0 then "; $text" else ";"
    | .list(_, start, count)
        parts += "("
        . first = true
        for item in store.nodes[start .. < start + count]
            if !first
                parts += " "
            first = false
            write-inline(item)
        parts += ")"

────────────────────
_ do breaks Bool
    - item ImmutableTableRow'SourceNode

. node = shown(item)
do match node
    | .comment(_, _)
        = true
    | .list(_, start, count)
        . header = header-count(node)
        =? true if header != null && header < count
        = some(store.nodes[start .. < start + count]) • where breaks(each)
    ??
        = false

────────────────────
_ header-count Int?
    - node ImmutableTableRow'SourceNode

layout?.header-count(node)

────────────────────
_ shown ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode

if held != null && held.id == node.id then held else node

.. held = swap

━━━━━━━━━━━━━━━━━━━━
_ SexpReader

_ tape SexpTape
_ bytes Byte[]
_ store SourceStore
_ marks SexpMarks?

────────────────────
+ This
    - tape
    - store
    - marks

.. bytes = tape.bytes

────────────────────
+ do read [U32] ?! SexpError

. dollar = tape.first-dollar
if dollar
    ?! SexpError(dollar, "Unescaped “\$” in the text at ${sexp-place(bytes, dollar)}. Write “\\\$” for a dollar sign, or build the text from its parts with (str …)")
store.sync()
store.reserve(bytes.length / 5 + 16)
. forms = List(store.root(node(each)) in tape.forms())
store.sync()
= forms

────────────────────
_ do node SourceNode
    - index Index

if tape.is-open(index)
    . base = store.held-count
    for child in tape.children(index)
        store.hold(node(child))
    mark(index)
    = store.close(base, store.next-id())
mark(index)
match tape.kind(index)
    |= .atom
        = SourceNode.atom(store.next-id(), store.name-of(bytes, tape.start(index), tape.end(index)))
    |= .text
        = SourceNode.string
            - store.next-id()
            - store.name-of(bytes, tape.start(index) + 1, tape.end(index) - 1)
    |= .escaped-text
        = SourceNode.string(store.next-id(), store.name(tape.text-value(index)))
    ??
        = comment(index)

────────────────────
_ do mark
    - index Index

. held = marks
if held
    held.starts += tape.start(index)
    held.ends += tape.end(index)

────────────────────
_ do comment SourceNode
    - index Index

. first = tape.start(index)
. last = tape.end(index)
while first < last && bytes[first] == 59
    first += 1
if first < last && bytes[first] == 32
    first += 1
= SourceNode.comment(store.next-id(), store.name-of(bytes, first, last))
