./sexp
./source-tree
/core/arena
/core/table
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ SexpRange is Tuple

+ start Index
+ end Index

━━━━━━━━━━━━━━━━━━━━
+ SexpMarks

+ base U32
+ starts [Index]
+ ends [Index]

────────────────────
+ This
    - base

────────────────────
+ start Index
    - id U32

if id > base && slot < starts.length then starts[slot] else 0

.. slot = (id - base - 1) as Index

────────────────────
+ end Index
    - id U32

if id > base && slot < ends.length then ends[slot] else 0

.. slot = (id - base - 1) as Index

────────────────────
+ do line-ids [U32]
    - text String
    - store SourceStore
    - roots [U32]

. bytes = text as Byte[]
. starts [Index]
starts += 0
for index in 0 .. < bytes.length
    if bytes[index] == 10
        starts += index + 1
. ids = List(0u32 in starts)
for root in roots
    mark-lines(store, store.node(root), starts, ids)
= ids

────────────────────
_ do mark-lines
    - store SourceStore
    - node ImmutableTableRow'SourceNode
    - starts [Index]
    - ids [U32]

. first = line-at(starts, start(node.id))
if ids[first] == 0
    ids[first] = node.id
for item in store.items(node)
    mark-lines(store, item, starts, ids)
for line in first + 1 .. < line-at(starts, end(node.id) - 1) + 1
    if ids[line] == 0
        ids[line] = node.id

────────────────────
_ do line-at Index
    - starts [Index]
    - offset Index

. low Index = 0
. high = starts.length
while low + 1 < high
    . middle = low + (high - low) / 2
    if starts[middle] <= offset
        low = middle
    else
        high = middle
= low

