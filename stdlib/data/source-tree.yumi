/core/arena
/core/atom-pool
/core/table
/stream/aggregate

+ source-raw-head = "raw"
+ source-blank-head = "blank"
+ source-compact-slack Size = 4096

_ source-block-flag U32 = 0x80000000

━━━━━━━━━━━━━━━━━━━━
+ SourceBase is Tuple

+ id U32

━━━━━━━━━━━━━━━━━━━━
+ SourceWord is SourceBase

+ text String

━━━━━━━━━━━━━━━━━━━━
+ SourceQuote is SourceBase

+ text String

━━━━━━━━━━━━━━━━━━━━
