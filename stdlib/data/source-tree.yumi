+ start U32
+ count U32

━━━━━━━━━━━━━━━━━━━━
+ SourceNode is Union

| atom SourceWord
| string SourceQuote
| comment SourceNote
| list SourceGroup

━━━━━━━━━━━━━━━━━━━━
+ SourceMoves

_ places U32[]

────────────────────
+ This
    - places

────────────────────
+ place U32
    - position U32

?! Panic("Source position $position did not survive compaction")
    if next == 0
if next >= source-block-flag then next - source-block-flag - 1 else next - 1

.. next = places[position]

────────────────────
+ place-at U32?
    - position U32?

if position == null then null else place(position)

━━━━━━━━━━━━━━━━━━━━
+ SourceStore

+ nodes ImmutableTable'SourceNode

_ arena Arena
_ names AtomPool
_ table Table'SourceNode
_ held Table'SourceNode
_ young Table'SourceNode
_ last-id U32
_ is-released Bool

────────────────────
+ This
    - capacity Size = 1024

.. names = AtomPool()
.. table = Table'SourceNode(arena, capacity)
.. held = Table'SourceNode(arena, 64)
.. young = Table'SourceNode(arena, 64)
.. nodes = table.view()

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

=? if is-released
is-released = true
names.release()
arena.release()

────────────────────
+ get length Size

nodes.length

────────────────────
+ get latest-id U32

last-id

────────────────────
+ node ImmutableTableRow'SourceNode
    - position U32

nodes[position as Index]

────────────────────
+ node-at ImmutableTableRow'SourceNode?
    - position U32?

if position == null then null else nodes[position as Index]

────────────────────
+ id-at U32
    - position U32?

if position != null then nodes[position as Index].id else 0

────────────────────
+ is-atom Bool
    - node ImmutableTableRow'SourceNode

match node
    | .atom(_, _)
        true
    ??
        false

────────────────────
+ is-text Bool
    - node ImmutableTableRow'SourceNode

match node
    | .string(_, _)
        true
    ??
        false

────────────────────
+ is-comment Bool
    - node ImmutableTableRow'SourceNode

match node
    | .comment(_, _)
        true
    ??
        false

────────────────────
+ is-list Bool
    - node ImmutableTableRow'SourceNode

match node
    | .list(_, _, _)
        true
    ??
        false

────────────────────
+ text String
    - node ImmutableTableRow'SourceNode

match node
    | .atom(_, text)
        text
    | .string(_, text)
        text
    | .comment(_, text)
        text
    | .list(_, _, _)
        ""

────────────────────
+ comment-text String?
    - node ImmutableTableRow'SourceNode

match? node
    | .comment(_, text)
        text

────────────────────
+ items ImmutableTableSpan'SourceNode
    - node ImmutableTableRow'SourceNode

match node
    | .list(_, start, count)
        nodes[start .. < start + count]
    ??
        nodes[0 .. < 0]

────────────────────
+ count Size
    - node ImmutableTableRow'SourceNode

match node
    | .list(_, _, count)
        count as Size
    ??
        0

────────────────────
+ item ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - index Index

items(node)[index]

────────────────────
+ do listed [ImmutableTableRow'SourceNode]
    - node ImmutableTableRow'SourceNode
    - first Index = 0

. made [ImmutableTableRow'SourceNode]
. held = items(node)
for index in first .. < held.length
    made += held[index]
= made

────────────────────
+ head String?
    - node ImmutableTableRow'SourceNode

match? items(node)
    | [.atom(_, name), ...]
        name

────────────────────
+ is-form Bool
    - node ImmutableTableRow'SourceNode
    - name String

head(node) == name

────────────────────
+ raw-text String?
    - node ImmutableTableRow'SourceNode

match? items(node)
    | [.atom(_, {it == source-raw-head}), .string(_, text), ...]
        text

────────────────────
+ is-blank Bool
    - node ImmutableTableRow'SourceNode

match items(node)
    | [.atom(_, {it == source-blank-head})]
        true
    ??
        false

────────────────────
+ do same Bool
    - left ImmutableTableRow'SourceNode
    - right ImmutableTableRow'SourceNode

do match left
    | .list(_, start, count)
        do match right
            | .list(_, other, size)
                =? false if count != size
                = all(0 .. < count) • where same(nodes[start + each], nodes[other + each])
            ??
                = false
    | .atom(_, held)
        = is-atom(right) && text(right) == held
    | .string(_, held)
        = is-text(right) && text(right) == held
    | .comment(_, held)
        = is-comment(right) && text(right) == held

────────────────────
+ do find ImmutableTableRow'SourceNode?
    - root ImmutableTableRow'SourceNode
    - id U32

=? root if root.id == id
for child in items(root)
    . found = find(child, id)
    =? found if found
= null

────────────────────
+ do next-id U32

last-id += 1
= last-id

────────────────────
+ name String
    - text String

names.store(text).text

────────────────────
+ do name-of String
    - bytes Byte[]
    - start Index
    - end Index

= names.store(bytes, start, end).text

────────────────────
+ do place ImmutableTableRow'SourceNode
    - cell SourceNode

. position = table.append(cell)
nodes = table.view()
= nodes[position]

────────────────────
+ do atom ImmutableTableRow'SourceNode
    - text String

= place(SourceNode.atom(next-id(), name(text)))

────────────────────
+ do string ImmutableTableRow'SourceNode
    - text String

= place(SourceNode.string(next-id(), name(text)))

────────────────────
+ do comment ImmutableTableRow'SourceNode
    - text String

= place(SourceNode.comment(next-id(), name(text)))

────────────────────
+ do list ImmutableTableRow'SourceNode
    - items [ImmutableTableRow'SourceNode]

= group(next-id(), items)

────────────────────
+ do group ImmutableTableRow'SourceNode
    - id U32
    - items [ImmutableTableRow'SourceNode]

. start = table.length
for item in items
    table.append(item)
= place(SourceNode.list(id, start as U32, items.length as U32))

────────────────────
+ do raw ImmutableTableRow'SourceNode
    - text String
    - body [ImmutableTableRow'SourceNode]

. items = List'(ImmutableTableRow'SourceNode)(atom(source-raw-head), string(text))
items ++= body
= list(items)

────────────────────
+ do blank ImmutableTableRow'SourceNode

= list(List'(ImmutableTableRow'SourceNode)(atom(source-blank-head)))

────────────────────
+ do with-id ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - id U32

do match node
    | .atom(_, text)
        = place(SourceNode.atom(id, text))
    | .string(_, text)
        = place(SourceNode.string(id, text))
    | .comment(_, text)
        = place(SourceNode.comment(id, text))
    | .list(_, start, count)
        = place(SourceNode.list(id, start, count))

────────────────────
+ do with-items ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - items [ImmutableTableRow'SourceNode]

= group(node.id, items)

────────────────────
+ do replaced ImmutableTableRow'SourceNode?
    - root ImmutableTableRow'SourceNode
    - id U32
    - replacement ImmutableTableRow'SourceNode

=? replacement if root.id == id
do match root
    | .list(_, start, count)
        for offset in 0 .. < count
            . swapped = replaced(nodes[start + offset], id, replacement)
            if swapped
                = rebuilt(root.id, start, count, offset, swapped)
        = null
    ??
        = null

────────────────────
+ do removed ImmutableTableRow'SourceNode?
    - root ImmutableTableRow'SourceNode
    - id U32

do match root
    | .list(_, start, count)
        for offset in 0 .. < count
            . child = nodes[start + offset]
            if child.id == id
                = rebuilt(root.id, start, count, offset, null)
            . pruned = removed(child, id)
            if pruned
                = rebuilt(root.id, start, count, offset, pruned)
        = null
    ??
        = null

────────────────────
+ do shares Bool
    - left ImmutableTableRow'SourceNode
    - right ImmutableTableRow'SourceNode

do match left
    | .list(id, start, count)
        do match right
            | .list(other, other-start, other-count)
                = id == other && start == other-start && count == other-count
            ??
                = false
    ??
        = false

────────────────────
+ do swapped ImmutableTableRow'SourceNode?
    - root ImmutableTableRow'SourceNode
    - target ImmutableTableRow'SourceNode
    - replacement ImmutableTableRow'SourceNode

=? replacement if root.index == target.index
do match root
    | .list(_, start, count)
        for offset in 0 .. < count
            . made = swapped(nodes[start + offset], target, replacement)
            if made
                = rebuilt(root.id, start, count, offset, made)
        = null
    ??
        = null

────────────────────
+ do appended ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - child ImmutableTableRow'SourceNode

. start = table.length
. count Size = 0
for item in items(node)
    table.append(item)
    count += 1
table.append(child)
= place(SourceNode.list(node.id, start as U32, (count + 1) as U32))

────────────────────
+ do extended ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - children [ImmutableTableRow'SourceNode]

. start = table.length
. count Size = 0
for item in items(node)
    table.append(item)
    count += 1
for child in children
    table.append(child)
= place(SourceNode.list(node.id, start as U32, (count + children.length) as U32))

────────────────────
+ do inserted ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - slot Index
    - child ImmutableTableRow'SourceNode

. start = table.length
. held = items(node)
. spot = if slot < held.length then slot else held.length
for index in 0 .. < spot
    table.append(held[index])
table.append(child)
for index in spot .. < held.length
    table.append(held[index])
= place(SourceNode.list(node.id, start as U32, (held.length + 1) as U32))

────────────────────
+ do without ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - slot Index

. start = table.length
. held = items(node)
. count Size = 0
for index in 0 .. < held.length
    if index != slot
        table.append(held[index])
        count += 1
= place(SourceNode.list(node.id, start as U32, count as U32))

────────────────────
+ do trimmed ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - count Size

. start = table.length
. held = items(node)
. kept = if count < held.length then count else held.length
for index in 0 .. < kept
    table.append(held[index])
= place(SourceNode.list(node.id, start as U32, kept as U32))

────────────────────
_ do rebuilt ImmutableTableRow'SourceNode
    - id U32
    - start U32
    - count U32
    - offset U32
    - swapped ImmutableTableRow'SourceNode?

. block = table.length
. made U32
for position in 0 .. < count
    if position != offset
        table.append(nodes[start + position])
        made += 1
    else if swapped
        table.append(swapped)
        made += 1
= place(SourceNode.list(id, block as U32, made))

────────────────────
+ get mark U32

table.length as U32

────────────────────
+ do rewind
    - mark U32

=? if (mark as Size) >= table.length
table.truncate(mark)
nodes = table.view()

────────────────────
+ do settle [U32]
    - mark U32
    - roots [ImmutableTableRow'SourceNode]

. cells [SourceNode]
for root in roots
    if root.index >= (mark as Size)
        cells += tenured(mark, root)
if (mark as Size) < table.length
    table.truncate(mark)
for index in 0 .. < young.length
    table.append(young[index])
young.truncate(0)
. places [U32]
. next Index = 0
for root in roots
    if root.index < (mark as Size)
        places += root.index as U32
    else
        places += table.append(cells[next]) as U32
        next += 1
nodes = table.view()
= places

────────────────────
_ do tenured SourceNode
    - mark U32
    - node ImmutableTableRow'SourceNode

do match node
    | .list(id, start, count)
        =? SourceNode.list(id, start, count) if start < mark || count == 0
        . base = held.length
        for offset in 0 .. < count
            held.append(tenured(mark, nodes[start + offset]))
        . block = mark + (young.length as U32)
        for index in base .. < base + count
            young.append(held[index])
        held.truncate(base)
        = SourceNode.list(id, block, count)
    ??
        = node

────────────────────
+ do compact SourceMoves
    - roots [U32]

. seen = U32[table.length]
. live Size = 0
for root in roots
    if seen[root] % 2 == 0
        seen[root] = seen[root] + 1
        live += 1
    live += weighed(seen, nodes[root])
. places = U32[table.length]
. old = arena
arena = Arena()
table = Table'SourceNode(arena, live * 2 + source-compact-slack * 2)
held = Table'SourceNode(arena, 64)
young = Table'SourceNode(arena, 64)
for root in roots
    . cell = carried(places, nodes[root])
    if places[root] == 0
        places[root] = (table.append(cell) as U32) + 1
old.release()
nodes = table.view()
= SourceMoves(places)

────────────────────
_ do weighed Size
    - seen U32[]
    - node ImmutableTableRow'SourceNode

do match node
    | .list(_, start, count)
        =? 0 if count == 0 || seen[start] >= 2
        seen[start] = seen[start] + 2
        . total = count as Size
        for offset in 0 .. < count
            total += weighed(seen, nodes[start + offset])
        = total
    ??
        = 0

────────────────────
_ do carried SourceNode
    - places U32[]
    - node ImmutableTableRow'SourceNode

do match node
    | .list(id, start, count)
        =? SourceNode.list(id, 0, 0) if count == 0
        . known = places[start]
        =? SourceNode.list(id, known - source-block-flag - 1, count) if known >= source-block-flag
        . base = held.length
        for offset in 0 .. < count
            held.append(carried(places, nodes[start + offset]))
        . block = table.length as U32
        for index in base .. < base + count
            table.append(held[index])
        held.truncate(base)
        for offset in 0 .. < count
            places[start + offset] = source-block-flag + block + offset + 1
        = SourceNode.list(id, block, count)
    ??
        = node

────────────────────
+ do reserve
    - count Size

table.reserve(table.length + count)

────────────────────
+ get held-count Size

held.length

────────────────────
+ do hold
    - cell SourceNode

held.append(cell)

────────────────────
+ do close SourceNode
    - base Size
    - id U32

. start = table.length
. count = held.length - base
for index in base .. < base + count
    table.append(held[index])
held.truncate(base)
= SourceNode.list(id, start as U32, count as U32)

────────────────────
+ do root U32
    - cell SourceNode

= table.append(cell) as U32

────────────────────
+ do sync

held.truncate(0)
nodes = table.view()
