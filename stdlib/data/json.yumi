/core/arena
/core/pattern-helpers

━━━━━━━━━━━━━━━━━━━━
+ JSON is Union

| Null
| Bool
| Int
| Float
| String
| [JSON]
| [String = JSON]

────────────────────
+ This
    - text String

. scratch = use Arena()
= match text
    with JSONParser(scratch, text.length)
    ~ \json-text
    ?! Panic("Invalid JSON")

────────────────────
+ This ~ Char

~ \value

.. nul ~
    ~ "null"
        null
.. bool ~
    ~ "true"
        true
    ~ "false"
        false
.. float Float ~
    ~ "-"? "." [0-9]+ ([eE] [+-]? [0-9]+)?
        json-float(it)
    ~ "-"? [0-9]+ ("." [0-9]+) ([eE] [+-]? [0-9]+)?
        json-float(it)
    ~ "-"? [0-9]+ [eE] [+-]? [0-9]+
        json-float(it)
.. int JSON ~
    ~ "-"? "0" !\number-tail
        0
    ~ "-"? [1-9] [0-9]* !\number-tail
        json-integer(it)
.. number-tail ~
    ~ [0-9] | "." | [eE]
.. string String ~
    ~ "\"" head \plain tail \escaped? "\""
        head ++ (tail ?? "")
.. array ~
    ~ "[" \s items \delimited(~ \s "," \s, ~ \value)? \s "]"
        items ?? empty
            .. empty [JSON]

.. object ~
    ~ "{" \s pairs \delimited(~ \s "," \s, ~ \pair)? \s "}"
        if pairs then (pairs as [String = JSON]) else empty
            .. empty [String = JSON]

.. value JSON ~
    ~ \string | \int | \float | \object | \array | \bool | \nul

.. pair ~
    ~ left \string \s ":" \s right \value
        KeyValuePair(left, right)

.. plain String ~
    ~ (!"\"" !"\\" .)*

.. escaped String ~
    ~ parts \escaped-part+
        "".join(parts)

.. escaped-part String ~
    ~ escape \escape text \plain
        escape ++ text

.. escape String ~
    ~ "\\u" high \high-surrogate "\\u" low \low-surrogate
        ((0x10000 + (high - 0xD800) * 0x400 + (low - 0xDC00)) as Char) as String
    ~ "\\u" (\high-surrogate | \low-surrogate)
        "\uFFFD"
    ~ "\\u" unit \code-unit
        (unit as Char) as String
    ~ "\\" c \json-escape-character
        unescape(c)

.. high-surrogate U32 ~
    ~ digits ([dD] [89abAB] [0-9a-fA-F]{2})
        Hex(digits) as U32

.. low-surrogate U32 ~
    ~ digits ([dD] [c-fC-F] [0-9a-fA-F]{2})
        Hex(digits) as U32

.. code-unit U32 ~
    ~ [0-9a-fA-F]{4}
        Hex(it) as U32

.. json-escape-character ~
    ~ [bfnrt"]
    ~ "/"
    ~ "\\"

.. s ~
    ~ \wsnl*

────────────────────
+ to String

to-json(this)

━━━━━━━━━━━━━━━━━━━━
+ json-text ~ Char JSON

~ \wsnl* value JSON \wsnl*
    value

━━━━━━━━━━━━━━━━━━━━
+ to-json String
    - value

match value
    | Null!
        "null"
    | Int~
        "$value"
    | Float~
        "$value"

    | text String
        json-quote(text)
    | list List
        "[$joined]"
        .. joined = ", ".join(items)
        .. items = to-json(each) in list
    | map Map
        "{$joined}"
        .. joined = ", ".join(pairs)
        .. pairs  = <* key, val in map
            "${json-quote(key)}: ${to-json(val)}"
    | Bool {it}
        "true"
    | Bool {it == false}
        "false"
    ??
        "null"

━━━━━━━━━━━━━━━━━━━━
+ ¶ json-quote
    - value String

"${"".join(json-escaped(each) in value)}"

━━━━━━━━━━━━━━━━━━━━
+ json-escaped
    - c Char

match c
    |= '"'
        "\\\""
    |= '\\'
        "\\\\"
    |= '\n'
        "\\n"
    |= '\r'
        "\\r"
    |= '\t'
        "\\t"
    |= '\b'
        "\\b"
    |= '\f'
        "\\f"
    |? c < ' '
        "\\u00${(c as U8 as Hex)[2 .. < 4]}"
    ??
        c as String

━━━━━━━━━━━━━━━━━━━━
_ unescape
    - c

match c
    | "t"
        "\t"
    | "n"
        "\n"
    | "r"
        "\r"
    | "b"
        "\b"
    | "f"
        "\f"
    | "/"
        "/"
    | "\\"
        "\\"
    | "\""
        "\""
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ json-integer'Token JSON
    - digits CaptureSpan'Token

` The Int that `digits` spell, or the nearest Float when they are past the range of an Int.
|? digits.length < 19 || "$value" == digits as String
    value as JSON
??
    (digits as Float) as JSON

.. value = digits as Int

━━━━━━━━━━━━━━━━━━━━
_ json-float'Token Float
    - number CaptureSpan'Token

number as Float

━━━━━━━━━━━━━━━━━━━━
_ json-integer JSON
    - digits String

` The Int that `digits` spell, or the nearest Float when they are past the range of an Int.
|? digits.length < 19 || "$value" == digits
    value as JSON
??
    (digits as Float) as JSON

.. value = digits as Int

━━━━━━━━━━━━━━━━━━━━
_ json-float Float
    - number String

number as Float

━━━━━━━━━━━━━━━━━━━━
+ do parse-json JSON ?! Error
    - text String

. scratch = use Arena()
= match text
    with JSONParser(scratch, text.length)
    ~ \json-text
    ?! Error("Invalid JSON")

━━━━━━━━━━━━━━━━━━━━
+ JSONParser
    is PatternMaterializationRoot'String
    is PatternRollback'Size

as PatternCollectorStorage'ArenaBacking, PatternRecordBoundary for
_ scratch PatternScratch
as PatternCaptureMaterializer'Char'String, PatternCaptureMaterializer'Byte'String for
_ texts PatternTextMemo

────────────────────
+ This
    - source Arena

.. scratch = PatternScratch(source)
.. texts = PatternTextMemo()

────────────────────
+ This
    - source Arena
    - length Size

.. scratch = PatternScratch(source)
.. texts = PatternTextMemo(length)

────────────────────
+ mark Size

0

────────────────────
+ do rewind
    - mark Size

━━━━━━━━━━━━━━━━━━━━
+ JSONReader is Tuple

+ label String
+ value JSON?

────────────────────
+ get is-present

value != null && !(value is Null)

────────────────────
+ object ?! Error

match value
    | fields [String = JSON]
        JSONObjectReader(label, fields)
    ?! Error("$label must be an object")

────────────────────
+ items ?! Error

** array()
*> JSONReader("$label item", each)
|> List

────────────────────
+ array ?! Error

match value
    | values [JSON]
        values
    ?! Error("$label must be an array")

────────────────────
+ string ?! Error

match value
    | text String
        text
    ?! Error("$label must be a string")

────────────────────
+ number ?! Error

match value
    | number Float
        number
    | number Int
        number as F64
    ?! Error("$label must be a number")

────────────────────
+ int ?! Error

match value
    | number Int
        number
    ?! Error("$label must be an integer")

────────────────────
+ bool ?! Error

match value
    | result Bool
        result
    ?! Error("$label must be true or false")

━━━━━━━━━━━━━━━━━━━━
+ JSONObjectReader is Tuple

+ label String
+ fields [String = JSON]

────────────────────
+ this[key String]

JSONReader("$label.$key", fields[key])

────────────────────
+ has
    - key String

fields[key] != null
