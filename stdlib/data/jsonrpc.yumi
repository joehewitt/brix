to-json(json)

━━━━━━━━━━━━━━━━━━━━
+ JSONRPCOutcome is Union

| result(value JSON)
| error(error JSONRPCError)

━━━━━━━━━━━━━━━━━━━━
+ JSONRPCResponse is Tuple

+ id JSONRPCID?
+ outcome JSONRPCOutcome

────────────────────
+ get json [String = JSON]

match outcome
    | .result(value)
        Map'String'JSON
            • jsonrpc "2.0"
            •? id json-rpc-id-json(id) if id
            • result value
    | .error(error)
        Map'String'JSON
            • jsonrpc "2.0"
            •? id json-rpc-id-json(id) if id
            • error error.json

────────────────────
+ to String

to-json(json)

━━━━━━━━━━━━━━━━━━━━
+ JSONRPCMessage is Union

| JSONRPCRequest
| JSONRPCNotification
| JSONRPCResponse

━━━━━━━━━━━━━━━━━━━━
+ parse-json-rpc JSONRPCMessage ?! JSONRPCError
    - text String

json-rpc-message(json)

.. json = parse-json(text)
    catch Error
        ?! JSONRPCError(.parse-error, "Parse error")

━━━━━━━━━━━━━━━━━━━━
+ do json-rpc-message JSONRPCMessage ?! JSONRPCError
    - json JSON
    - requires-version = true

. fields = match json
    | object [String = JSON]
        object
    ?! invalid-json-rpc("A JSON-RPC message must be an object")
?! invalid-json-rpc("A JSON-RPC message must have \"jsonrpc\": \"2.0\"")
    if requires-version && !(fields is ["jsonrpc" = "2.0", ...])
=? json-rpc-response(fields) if !(fields has "method")

. method = match fields["method"]
    | name String
        name
    ?! invalid-json-rpc("\"method\" must be a string")
. params = fields["params"] ?? (null as JSON)
?! invalid-json-rpc("\"params\" must be an array or an object")
    if !(params is Null || params is [JSON] || params is [String = JSON])
=? JSONRPCNotification(method, params) if !(fields has "id")

. id = match fields["id"]
    | number Int
        number as JSONRPCID
    | text String
        text as JSONRPCID
    ?! invalid-json-rpc("A request \"id\" must be a string or an integer")
= JSONRPCRequest(id, method, params)

━━━━━━━━━━━━━━━━━━━━
_ do json-rpc-response JSONRPCResponse ?! JSONRPCError
    - fields [String = JSON]

. has-result = fields has "result"
. has-error = fields has "error"
?! invalid-json-rpc("A JSON-RPC message must have a \"method\", a \"result\" or an \"error\"")
    if !has-result && !has-error
?! invalid-json-rpc("A response must not have both \"result\" and \"error\"")
    if has-result && has-error

. id JSONRPCID?
if fields has "id"
    id = match fields["id"]!
        | number Int
            number as JSONRPCID
        | text String
            text as JSONRPCID
        | Null
            null
        ?! invalid-json-rpc("A response \"id\" must be a string, an integer or null")
=? JSONRPCResponse(id, .result(fields["result"]!)) if has-result
= JSONRPCResponse(id, .error(json-rpc-error(fields["error"]!)))

━━━━━━━━━━━━━━━━━━━━
_ json-rpc-error JSONRPCError ?! JSONRPCError
    - json JSON

JSONRPCError(code as JSONRPCErrorCode, text, fields["data"] ?? (null as JSON))

.. fields = match json
    | object [String = JSON]
        object
    ?! invalid-json-rpc("\"error\" must be an object")
.. code = match fields["code"]
    | number Int
        number
    ?! invalid-json-rpc("\"error.code\" must be an integer")
.. text = match fields["message"]
    | value String
        value
    ?! invalid-json-rpc("\"error.message\" must be a string")

━━━━━━━━━━━━━━━━━━━━
_ invalid-json-rpc JSONRPCError
    - text String

JSONRPCError(.invalid-request, text)

━━━━━━━━━━━━━━━━━━━━
_ json-rpc-id-json JSON
    - id JSONRPCID?

match id
    | number Int
        number
    | text String
        text
    ??
        null as JSON
