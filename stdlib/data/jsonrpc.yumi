/data/json

━━━━━━━━━━━━━━━━━━━━
+ JSONRPCID is Union

| Int
| String

━━━━━━━━━━━━━━━━━━━━
+ JSONRPCErrorCode is Int

| parse-error = -32700
| invalid-request = -32600
| method-not-found = -32601
| invalid-params = -32602
| internal-error = -32603

━━━━━━━━━━━━━━━━━━━━
+ JSONRPCError is Error

+ code JSONRPCErrorCode
+ data JSON

────────────────────
+ This
    - code JSONRPCErrorCode
    - text String
    - data JSON = null

message = text

────────────────────
+ get json [String = JSON]

Map'String'JSON
    • code code as Int
    • message message
    •? data data if !(data is Null)

━━━━━━━━━━━━━━━━━━━━
+ JSONRPCRequest is Tuple

+ id JSONRPCID
+ method String
+ params JSON

────────────────────
+ response JSONRPCResponse
    - result JSON

JSONRPCResponse(id, .result(result))

────────────────────
+ error-response JSONRPCResponse
    - error JSONRPCError

JSONRPCResponse(id, .error(error))

────────────────────
+ get json [String = JSON]

Map'String'JSON
    • jsonrpc "2.0"
    • id json-rpc-id-json(id)
    • method method
    •? params params if !(params is Null)

────────────────────
+ to String

to-json(json)

