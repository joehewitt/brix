/BxCore/BxString.h

━━━━━━━━━━━━━━━━━━━━
+ utf8-string String ?! SyntaxError
    - bytes Byte[]

?! SyntaxError("The bytes are not UTF-8 text")
    if C:brixStringValidateUtf8(bytes, bytes.size) != 0
bytes.slice-string()

━━━━━━━━━━━━━━━━━━━━
+ ByteWriter

+ size Size = 0

_ buffer = Byte[64]

────────────────────
+ do u8
    - value Byte

reserve(1)
buffer[size] = value
size += 1

────────────────────
+ do u16-be
    - value U16

unsigned(value, 2, false)

────────────────────
+ do u16-le
    - value U16

unsigned(value, 2, true)

────────────────────
+ do u32-be
    - value U32

unsigned(value, 4, false)

────────────────────
+ do u32-le
    - value U32

unsigned(value, 4, true)

────────────────────
+ do u64-be
    - value U64

unsigned(value, 8, false)

────────────────────
+ do u64-le
    - value U64

unsigned(value, 8, true)

────────────────────
+ do f32-be
    - value F32

. cell = value
unsigned((&cell as CPointer'U32)[0], 4, false)

────────────────────
+ do f32-le
    - value F32

. cell = value
unsigned((&cell as CPointer'U32)[0], 4, true)

────────────────────
+ do f64-be
    - value F64

. cell = value
unsigned((&cell as CPointer'U64)[0], 8, false)

────────────────────
+ do f64-le
    - value F64

. cell = value
unsigned((&cell as CPointer'U64)[0], 8, true)

────────────────────
+ do varint
    - value U64

. rest = value
while rest >= 0x80
    u8(((rest /and/ 0x7f) /or/ 0x80) as Byte)
    rest = rest /zrshift/ 7
u8(rest as Byte)

────────────────────
+ do bytes
    - value Byte[]

reserve(value.size)
buffer[size .. < size + value.size] = value
size += value.size

────────────────────
+ do finish Byte[]

. result = Byte[size]
result[0 .. < size] = buffer[0 .. < size]
= result

────────────────────
_ do unsigned
    - value U64
    - count Size
    - little Bool

reserve(count)
for index in 0 .. < count
    . shift = if little then index else count - 1 - index
    buffer[size + index] = ((value /zrshift/ ((shift * 8) as U64)) /and/ 0xff) as U8
size += count

────────────────────
_ do reserve
    - count Size

=? if size + count <= buffer.size
. capacity = buffer.size * 2
while capacity < size + count
    capacity *= 2
. grown = Byte[capacity]
grown[0 .. < size] = buffer[0 .. < size]
buffer = grown

━━━━━━━━━━━━━━━━━━━━
+ ByteReader

+ data Byte[]
+ offset Size = 0

────────────────────
+ This
    - data

────────────────────
+ get remaining Size

data.size - offset

────────────────────
+ get is-done Bool

offset >= data.size

────────────────────
+ do u8 Byte ?! SyntaxError

need(1)
offset += 1
= data[offset - 1]

────────────────────
+ u16-be U16 ?! SyntaxError

unsigned(2, false) as U16

────────────────────
+ u16-le U16 ?! SyntaxError

unsigned(2, true) as U16

────────────────────
+ u32-be U32 ?! SyntaxError

unsigned(4, false) as U32

────────────────────
+ u32-le U32 ?! SyntaxError

unsigned(4, true) as U32

────────────────────
+ u64-be U64 ?! SyntaxError

unsigned(8, false)

────────────────────
+ u64-le U64 ?! SyntaxError

unsigned(8, true)

────────────────────
+ do f32-be F32 ?! SyntaxError

. cell = unsigned(4, false) as U32
= (&cell as CPointer'F32)[0]

────────────────────
+ do f32-le F32 ?! SyntaxError

. cell = unsigned(4, true) as U32
= (&cell as CPointer'F32)[0]

────────────────────
+ do f64-be F64 ?! SyntaxError

. cell = unsigned(8, false)
= (&cell as CPointer'F64)[0]

────────────────────
+ do f64-le F64 ?! SyntaxError

. cell = unsigned(8, true)
= (&cell as CPointer'F64)[0]

────────────────────
+ do varint U64 ?! SyntaxError

. value U64
. shift U64
while true
    ?! SyntaxError("A varint at offset $offset runs past 64 bits")
        if shift >= 64
    . byte = u8()
    value = value /or/ (((byte /and/ 0x7f) as U64) /lshift/ shift)
    =? value if byte < 0x80
    shift += 7

────────────────────
+ do bytes Byte[] ?! SyntaxError
    - count Size

need(count)
. result = Byte[count]
result[0 .. < count] = data[offset .. < offset + count]
offset += count
= result

────────────────────
+ do unsigned U64 ?! SyntaxError
    - count Size
    - little Bool

need(count)
. value U64
for index in 0 .. < count
    . shift = if little then index else count - 1 - index
    value = value /or/ ((data[offset + index] as U64) /lshift/ ((shift * 8) as U64))
offset += count
= value

────────────────────
_ do need ?! SyntaxError
    - count Size

?! SyntaxError(shortfall)
    if count > remaining

.. shortfall = "The data ends at $data.size bytes, before the $count bytes wanted at offset $offset"
