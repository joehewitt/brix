/math
/stream/sort

_ fuzzy-consecutive = 1000
_ fuzzy-after-slash = 900
_ fuzzy-after-word = 800
_ fuzzy-capital = 700
_ fuzzy-after-dot = 600
_ fuzzy-leading-gap = -5
_ fuzzy-trailing-gap = -5
_ fuzzy-inner-gap = -10
_ fuzzy-floor = -1000000000
_ fuzzy-invalid = -500000000
_ fuzzy-rank-limit Size = 1024

━━━━━━━━━━━━━━━━━━━━
+ FuzzyQuery

+ text String
+ length Size = 0

_ needle Byte[] = Byte[0]
_ matched Int[] = Int[0]
_ best Int[] = Int[0]
_ next-matched Int[] = Int[0]
_ next-best Int[] = Int[0]

────────────────────
+ This
    - text

. raw = text as Byte[]
needle = Byte[raw.size]
. count Size = 0
for index in 0 .. < raw.size
    . byte = raw[index]
    if byte != 32
        needle[count] = fuzzy-folded(byte)
        count += 1
length = count

────────────────────
+ get is-empty

length == 0

────────────────────
+ do score Int?
    - candidate String
    - start Index = 0

=? 0 if length == 0
. bytes = candidate as Byte[]
=? if start > bytes.size
. span = bytes.size - start
=? if span < length
=? if !holds(bytes, start)
=? 0 if span > fuzzy-rank-limit
reserve(span)

for row in 0 .. < length
    . wanted = needle[row]
    . gap = if row + 1 == length then fuzzy-trailing-gap else fuzzy-inner-gap
    . running = fuzzy-floor
    . previous Byte = 47
    for column in 0 .. < span
        . raw = bytes[start + column]
        . score = fuzzy-floor
        if fuzzy-folded(raw) == wanted
            . bonus = fuzzy-bonus(previous, raw)
            if row == 0
                score = (column as Int) * fuzzy-leading-gap + bonus
            else if column > 0
                . carried = best[column - 1]
                . chained = matched[column - 1]
                if carried > fuzzy-invalid
                    score = carried + bonus
                if chained > fuzzy-invalid && chained + fuzzy-consecutive > score
                    score = chained + fuzzy-consecutive
        next-matched[column] = score
        if running > fuzzy-invalid
            running += gap
        if score > running
            running = score
        next-best[column] = running
        previous = raw
    . held-matched = matched
    matched = next-matched
    next-matched = held-matched
    . held-best = best
    best = next-best
    next-best = held-best

= best[span - 1]

────────────────────
+ do positions [Index]
    - candidate String
    - start Index = 0

. found [Index]
=? found if length == 0
. bytes = candidate as Byte[]
=? found if start > bytes.size
. span = bytes.size - start
=? found if span < length || span > fuzzy-rank-limit || !holds(bytes, start)
. table-matched = Int[length * span]
. table-best = Int[length * span]

for row in 0 .. < length
    . wanted = needle[row]
    . gap = if row + 1 == length then fuzzy-trailing-gap else fuzzy-inner-gap
    . running = fuzzy-floor
    . previous Byte = 47
    . here = row * span
    . above = if row > 0 then here - span else 0
    for column in 0 .. < span
        . raw = bytes[start + column]
        . score = fuzzy-floor
        if fuzzy-folded(raw) == wanted
            . bonus = fuzzy-bonus(previous, raw)
            if row == 0
                score = (column as Int) * fuzzy-leading-gap + bonus
            else if column > 0
                . carried = table-best[above + column - 1]
                . chained = table-matched[above + column - 1]
                if carried > fuzzy-invalid
                    score = carried + bonus
                if chained > fuzzy-invalid && chained + fuzzy-consecutive > score
                    score = chained + fuzzy-consecutive
        table-matched[here + column] = score
        if running > fuzzy-invalid
            running += gap
        if score > running
            running = score
        table-best[here + column] = running
        previous = raw

. reversed [Index]
. row = length - 1
. column = span - 1
. is-exact = false
while true
    . here = row * span
    if !is-exact
        while column > 0 && table-matched[here + column] != table-best[here + column]
            column -= 1
    reversed += start + column
    if row == 0 || column == 0
        break
    . chained = table-matched[here - span + column - 1]
    is-exact = chain-valid && chained + fuzzy-consecutive == table-matched[here + column]
        .. chain-valid = chained > fuzzy-invalid
    row -= 1
    column -= 1
for index in 0 .. < reversed.length
    found += reversed[reversed.length - 1 - index]
= found

────────────────────
_ do holds Bool
    - bytes Byte[]
    - start Index

. want Index = 0
. cursor Index = start
while cursor < bytes.size && want < length
    if fuzzy-folded(bytes[cursor]) == needle[want]
        want += 1
    cursor += 1
= want == length

────────────────────
_ do reserve
    - span Size

=? if matched.size >= span
. room = span + 64
matched = Int[room]
best = Int[room]
next-matched = Int[room]
next-best = Int[room]

━━━━━━━━━━━━━━━━━━━━
_ FuzzyRank is Tuple

+ score Int
+ order Size

━━━━━━━━━━━━━━━━━━━━
+ FuzzyText'Item is () String
    - item Item

━━━━━━━━━━━━━━━━━━━━
+ do fuzzy-ranked'Item [Item]
    - items [Item]
    - query String
    - text-of FuzzyText'Item

. pattern = FuzzyQuery(query)
=? items if pattern.is-empty
. ranks [FuzzyRank]
for index in 0 .. < items.length
    . score = pattern.score(text-of(items[index]))
    if score != null
        ranks += FuzzyRank(score, index)
. ordered = sort(ranks) • using fuzzy-rank-compare
. found [Item]
for rank in ordered
    found += items[rank.order]
= found

━━━━━━━━━━━━━━━━━━━━
_ fuzzy-rank-compare Comparison
    - left FuzzyRank
    - right FuzzyRank

|? left.score > right.score
    Comparison.lesser
|? left.score < right.score
    Comparison.greater
|? left.order < right.order
    Comparison.lesser
|? left.order > right.order
    Comparison.greater
??
    Comparison.equal

━━━━━━━━━━━━━━━━━━━━
_ fuzzy-folded Byte @inline
    - byte Byte

|? byte >= 65 && byte <= 90
    byte + 32
??
    byte

━━━━━━━━━━━━━━━━━━━━
_ fuzzy-bonus Int
    - previous Byte
    - raw Byte

|? previous == 47
    fuzzy-after-slash
|? previous == 45 || previous == 95 || previous == 32
    fuzzy-after-word
|? previous == 46
    fuzzy-after-dot
|? raw >= 65 && raw <= 90 && previous >= 97 && previous <= 122
    fuzzy-capital
??
    0

━━━━━━━━━━━━━━━━━━━━
+ do edit-distance Index
    - first String
    - second String

=? second.length if first.length == 0
=? first.length if second.length == 0
. row = List'Index(each in 0 .. second.length)
for i in 1 .. first.length
    . next = List'Index(i)
    for j in 1 .. second.length
        . cost Index = if first[i - 1] == second[j - 1] then 0 else 1
        next += min(min(row[j] + 1, next[j - 1] + 1), row[j - 1] + cost)
    row = next
= row[second.length]

━━━━━━━━━━━━━━━━━━━━
+ do nearest-names [String]
    - name String
    - candidates [String]
    - count Size = 3

. limit = max(2, name.length / 3)
. found [String]
. distances [Index]
for candidate in candidates
    . distance = edit-distance(name.lowercased, candidate.lowercased)
    if distance <= limit
        . position = 0
        while position < found.length && distances[position] <= distance
            position += 1
        found.insert(candidate, position)
        distances.insert(distance, position)
. nearest [String]
for index in 0 .. < min(count, found.length)
    nearest += found[index]
= nearest
