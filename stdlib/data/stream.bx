(import ./data)
(import /BxCore/BxCore.h)
(import /core/tokenstream)

(type + (of DataStream Value)
  (implements (of ReadableData Value))
  (implements WritableData)
  (prop + data ([] Value))
  (prop + length Size)
  (prop + cursor Index)
  (fn-do + This _
    (param data ([] Value))
    (param length Size)
  )
  (fn-do + This _
    (param length Size)
    (lazy data ([] Value length))
  )
  (fn-do + This _
    (param data ([] Value))
    (return (call This data (. data size)))
  )
  (fn-to-expr + ([] Value)
    ([] data (..< 0 cursor))
  )
  (fn-to-do + (of Iterable Value)
    (for (in i (..< 0 length))
      (yield ([] data i))
    )
  )
  (fn-expr + (of read Num) Num
    (param endian _ (= .big))
    (constraint is Num Number)
    (call (of (. (call (of ChunkedTokenStream Byte) this) read) Num) endian)
  )
  (fn-expr + is-encoded _ :get
    false
  )
  (fn-do + reset _
    (= cursor 0)
    (= length 0)
  )
  (fn-do + rewind _
    (= cursor 0)
  )
  (fn-expr + (of skip Skipped) _
    (param count U32 (= 1))
    (call skip-bytes (* (. Skipped size) count))
  )
  (fn-expr + read Size
    (param size Size)
    (param buffer ([] Byte))
    (call read-bytes size buffer)
  )
  (fn-do + write Size
    (param bytes (of ImmutableArray Byte))
    (param size Size)
    (let limit (+ cursor size))
    (blank)
    (throw (call Panic "Data stream size exceeded") (if (< limit cursor)))
    (blank)
    (if (> limit (. this data size))
      (let doubled (* (. this data size) 2))
      (= (. this data) (call (. this data resize) (if-expr (> doubled limit) doubled limit)))
    )
    (blank)
    (if (> limit length)
      (= length limit)
    )
    (blank)
    (= ([] (. this data) (..< cursor (+ cursor size))) bytes)
    (+= cursor size)
    (blank)
    (return size)
  )
  (fn-do _ read-bytes Size
    (param size Size)
    (param receiver ([] Byte))
    (let token-size (/ size (. Value size)))
    (let byte-data (as (. this data) (of CPointer Byte)))
    (if (>= cursor length)
      (return 0)
      (else-if (> (+ cursor token-size) length)
        (let amt (* (- length cursor) (. Value size)))
        (let byte-cursor (* cursor (. Value size)))
        (do
          (inline (call C:brixArrayCopySlice receiver (+ byte-data byte-cursor) amt))
        )
        (= cursor length)
        (return amt)
      )
      (else
        (let byte-cursor (* cursor (. Value size)))
        (do
          (inline (call C:brixArrayCopySlice receiver (+ byte-data byte-cursor) size))
        )
        (+= cursor token-size)
        (return size)
      )
    )
  )
  (fn-do _ skip-bytes Size
    (param size Size)
    (let token-size (/ size (. Value size)))
    (if (>= cursor length)
      (return 0)
      (else-if (> (+ cursor token-size) length)
        (let amt (* (- length cursor) (. Value size)))
        (= cursor length)
        (return (* amt (. Value size)))
      )
      (else
        (+= cursor token-size)
        (return size)
      )
    )
  )
)
