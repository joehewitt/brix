━━━━━━━━━━━━━━━━━━━━
+ csv-file ~ Char

~ header \record \nl recs \records \nl?
    (header, recs)

.. records ~
    ~ recs \delimited(~ \nl, ~ \record)
        recs
.. record ~
    ~ fields \delimited(",", ~ \field)
        fields
.. field ~
    ~ "\"" c \parts "\""
        c
    ~ (!("," | "\n") .)+
.. parts String ~
    ~ head \character tail \parts
        head + tail
    ~ \character
.. character ~
    ~ "\\\""
        "\""
    ~ (!"\"") .
