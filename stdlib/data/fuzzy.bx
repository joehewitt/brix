(import /math)
(import /stream/sort)
(blank)
(prop _ fuzzy-consecutive _ (= 1000))
(prop _ fuzzy-after-slash _ (= 900))
(prop _ fuzzy-after-word _ (= 800))
(prop _ fuzzy-capital _ (= 700))
(prop _ fuzzy-after-dot _ (= 600))
(prop _ fuzzy-leading-gap _ (= -5))
(prop _ fuzzy-trailing-gap _ (= -5))
(prop _ fuzzy-inner-gap _ (= -10))
(prop _ fuzzy-floor _ (= -1000000000))
(prop _ fuzzy-invalid _ (= -500000000))
(prop _ fuzzy-rank-limit Size (= 1024))

(type + FuzzyQuery
  (prop + text String)
  (prop + length Size (= 0))
  (blank)
  (prop _ needle ([] Byte) (= ([] Byte 0)))
  (prop _ matched ([] Int) (= ([] Int 0)))
  (prop _ best ([] Int) (= ([] Int 0)))
  (prop _ next-matched ([] Int) (= ([] Int 0)))
  (prop _ next-best ([] Int) (= ([] Int 0)))
  (fn-do + This _
    (param text _)
    (let raw (call byte-view text))
    (= needle ([] Byte (. raw size)))
    (let count Size 0)
    (for (in index (..< 0 (. raw size)))
      (let byte ([] raw index))
      (if (!= byte 32)
        (= ([] needle count) (call fuzzy-folded byte))
        (+= count 1)
      )
    )
    (= length count)
  )
  (fn-expr + is-empty _ :get
    (== length 0)
  )
  (fn-do + score (? Int)
    (param candidate String)
    (param start Index (= 0))
    (return-if 0 (if (== length 0)))
    (blank)
    (let bytes (call byte-view candidate))
    (return-if (if (> start (. bytes size))))
    (blank)
    (let span (- (. bytes size) start))
    (return-if (if (< span length)))
    (return-if (if (not (call holds bytes start))))
    (return-if 0 (if (> span fuzzy-rank-limit)))
    (blank)
    (call reserve span)
    (blank)
    (for (in row (..< 0 length))
      (let wanted ([] needle row))
      (let gap (if-expr (== (+ row 1) length) fuzzy-trailing-gap fuzzy-inner-gap))
      (let running fuzzy-floor)
      (let previous Byte 47)
      (for (in column (..< 0 span))
        (let raw ([] bytes (+ start column)))
        (let score fuzzy-floor)
        (if (== (call fuzzy-folded raw) wanted)
          (let bonus (call fuzzy-bonus previous raw))
          (if (== row 0)
            (= score (+ (* (as column Int) fuzzy-leading-gap) bonus))
            (else-if (> column 0)
              (let carried ([] best (- column 1)))
              (let chained ([] matched (- column 1)))
              (if (> carried fuzzy-invalid)
                (= score (+ carried bonus))
              )
              (if (and (> chained fuzzy-invalid) (> (+ chained fuzzy-consecutive) score))
                (= score (+ chained fuzzy-consecutive))
              )
            )
          )
        )
        (= ([] next-matched column) score)
        (if (> running fuzzy-invalid)
          (+= running gap)
        )
        (if (> score running)
          (= running score)
        )
        (= ([] next-best column) running)
        (= previous raw)
      )
      (let held-matched matched)
      (= matched next-matched)
      (= next-matched held-matched)
      (let held-best best)
      (= best next-best)
      (= next-best held-best)
    )
    (blank)
    (return ([] best (- span 1)))
  )
  (fn-do + positions (list Index)
    (param candidate String)
    (param start Index (= 0))
    (let found (list Index))
    (return-if found (if (== length 0)))
    (blank)
    (let bytes (call byte-view candidate))
    (return-if found (if (> start (. bytes size))))
    (blank)
    (let span (- (. bytes size) start))
    (return-if found (if (or (< span length) (> span fuzzy-rank-limit) (not (call holds bytes start)))))
    (blank)
    (let table-matched ([] Int (* length span)))
    (let table-best ([] Int (* length span)))
    (blank)
    (for (in row (..< 0 length))
      (let wanted ([] needle row))
      (let gap (if-expr (== (+ row 1) length) fuzzy-trailing-gap fuzzy-inner-gap))
      (let running fuzzy-floor)
      (let previous Byte 47)
      (let here (* row span))
      (let above (if-expr (> row 0) (- here span) 0))
      (for (in column (..< 0 span))
        (let raw ([] bytes (+ start column)))
        (let score fuzzy-floor)
        (if (== (call fuzzy-folded raw) wanted)
          (let bonus (call fuzzy-bonus previous raw))
          (if (== row 0)
            (= score (+ (* (as column Int) fuzzy-leading-gap) bonus))
            (else-if (> column 0)
              (let carried ([] table-best (- (+ above column) 1)))
              (let chained ([] table-matched (- (+ above column) 1)))
              (if (> carried fuzzy-invalid)
                (= score (+ carried bonus))
              )
              (if (and (> chained fuzzy-invalid) (> (+ chained fuzzy-consecutive) score))
                (= score (+ chained fuzzy-consecutive))
              )
            )
          )
        )
        (= ([] table-matched (+ here column)) score)
        (if (> running fuzzy-invalid)
          (+= running gap)
        )
        (if (> score running)
          (= running score)
        )
        (= ([] table-best (+ here column)) running)
        (= previous raw)
      )
    )
    (blank)
    (let reversed (list Index))
    (let row (- length 1))
    (let column (- span 1))
    (let is-exact false)
    (while true
      (let here (* row span))
      (if (not is-exact)
        (while (and (> column 0) (!= ([] table-matched (+ here column)) ([] table-best (+ here column))))
          (-= column 1)
        )
      )
      (+= reversed (+ start column))
      (if (or (== row 0) (== column 0))
        (break)
      )
      (let chained ([] table-matched (- (+ (- here span) column) 1)))
      (= is-exact
        (scope (and chain-valid (== (+ chained fuzzy-consecutive) ([] table-matched (+ here column))))
          (lazy chain-valid (> chained fuzzy-invalid))
        )
      )
      (-= row 1)
      (-= column 1)
    )
    (for (in index (..< 0 (. reversed length)))
      (+= found ([] reversed (- (. reversed length) 1 index)))
    )
    (return found)
  )
  (fn-do _ holds Bool
    (param bytes (of ImmutableArray Byte))
    (param start Index)
    (let want Index 0)
    (let cursor Index start)
    (while (and (< cursor (. bytes size)) (< want length))
      (if (== (call fuzzy-folded ([] bytes cursor)) ([] needle want))
        (+= want 1)
      )
      (+= cursor 1)
    )
    (return (== want length))
  )
  (fn-do _ reserve _
    (param span Size)
    (return-if (if (>= (. matched size) span)))
    (blank)
    (let room (+ span 64))
    (= matched ([] Int room))
    (= best ([] Int room))
    (= next-matched ([] Int room))
    (= next-best ([] Int room))
  )
)

(type + (of FuzzyText Item) (is (fn-type String (param item Item))))

(fn-do + (of fuzzy-ranked Item) (list Item)
  (param items (list Item))
  (param query String)
  (param text-of (of FuzzyText Item))
  (let pattern (call FuzzyQuery query))
  (return-if items (if (. pattern is-empty)))
  (blank)
  (let ranks (list FuzzyRank))
  (for (in index (..< 0 (. items length)))
    (let score (call (. pattern score) (call text-of ([] items index))))
    (if (!= score null)
      (+= ranks (call FuzzyRank score index))
    )
  )
  (let ordered (call sort ranks (:using fuzzy-rank-compare)))
  (let found (list Item))
  (for (in rank ordered)
    (+= found ([] items (. rank order)))
  )
  (return found)
)

(fn-do + edit-distance Index
  (param first String)
  (param second String)
  (return-if (. second length) (if (== (. first length) 0)))
  (return-if (. first length) (if (== (. second length) 0)))
  (blank)
  (let row (call (of List Index) (in each (.. 0 (. second length)))))
  (for (in i (.. 1 (. first length)))
    (let next (call (of List Index) i))
    (for (in j (.. 1 (. second length)))
      (let cost Index (if-expr (== ([] first (- i 1)) ([] second (- j 1))) 0 1))
      (+= next (call min (call min (+ ([] row j) 1) (+ ([] next (- j 1)) 1)) (+ ([] row (- j 1)) cost)))
    )
    (= row next)
  )
  (return ([] row (. second length)))
)

(fn-do + nearest-names (list String)
  (param name String)
  (param candidates (list String))
  (param count Size (= 3))
  (let limit (call max 2 (/ (. name length) 3)))
  (let found (list String))
  (let distances (list Index))
  (for (in candidate candidates)
    (let distance (call edit-distance (. name lowercased) (. candidate lowercased)))
    (if (<= distance limit)
      (let position 0)
      (while (and (< position (. found length)) (<= ([] distances position) distance))
        (+= position 1)
      )
      (call (. found insert) candidate position)
      (call (. distances insert) distance position)
    )
  )
  (let nearest (list String))
  (for (in index (..< 0 (call min count (. found length))))
    (+= nearest ([] found index))
  )
  (return nearest)
)

(type _ FuzzyRank (is Tuple)
  (prop + score Int)
  (prop + order Size)
)

(fn-expr _ fuzzy-rank-compare Comparison
  (param left FuzzyRank)
  (param right FuzzyRank)
  (case? (> (. left score) (. right score))
    (. Comparison lesser)
  )
  (case? (< (. left score) (. right score))
    (. Comparison greater)
  )
  (case? (< (. left order) (. right order))
    (. Comparison lesser)
  )
  (case? (> (. left order) (. right order))
    (. Comparison greater)
  )
  (default
    (. Comparison equal)
  )
)

(fn-expr _ fuzzy-folded Byte @inline
  (param byte Byte)
  (case? (and (>= byte 65) (<= byte 90))
    (+ byte 32)
  )
  (default
    byte
  )
)

(fn-expr _ fuzzy-bonus Int
  (param previous Byte)
  (param raw Byte)
  (case? (== previous 47)
    fuzzy-after-slash
  )
  (case? (or (== previous 45) (== previous 95) (== previous 32))
    fuzzy-after-word
  )
  (case? (== previous 46)
    fuzzy-after-dot
  )
  (case? (and (>= raw 65) (<= raw 90) (>= previous 97) (<= previous 122))
    fuzzy-capital
  )
  (default
    0
  )
)
