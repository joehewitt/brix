./binary
/core/_bytes
/stream/aggregate

_ binary-plist-magic = "bplist00"
_ binary-plist-trailer-size Size = 32
_ binary-plist-depth-limit = 512

━━━━━━━━━━━━━━━━━━━━
+ Plist is Union

| Null
| Bool
| I64
| Float
| String
| Byte[]
| [Plist]
| [String = Plist]

━━━━━━━━━━━━━━━━━━━━
+ do to-binary-plist Byte[]
    - value Plist

. objects = List'PlistObject()
flatten(value, objects)
. reference-size = byte-count(objects.length as U64)
. writer = ByteWriter()
writer.bytes(byte-view(binary-plist-magic))
. offsets [Size]
for object in objects
    offsets += writer.size
    write-object(writer, object, reference-size)
. table-offset = writer.size
. offset-size = byte-count(table-offset as U64)
for offset in offsets
    write-sized(writer, offset as U64, offset-size)
for _ in 0 .. < 6
    writer.u8(0)
writer.u8(offset-size as Byte)
writer.u8(reference-size as Byte)
writer.u64-be(objects.length as U64)
writer.u64-be(0)
writer.u64-be(table-offset as U64)
= writer.finish()

━━━━━━━━━━━━━━━━━━━━
+ do parse-binary-plist Plist ?! SyntaxError
    - data Byte[]

?! SyntaxError("The data is too short to be a binary plist")
    if data.size < binary-plist-magic.size + binary-plist-trailer-size
?! SyntaxError("The data does not start with $binary-plist-magic")
    if data[0 .. < binary-plist-magic.size] != byte-view(binary-plist-magic)
. reader = ByteReader(data)
reader.offset = data.size - binary-plist-trailer-size + 6
. offset-size = reader.u8() as Size
. reference-size = reader.u8() as Size
. count = reader.u64-be()
. top = reader.u64-be()
. table-offset = reader.u64-be()
?! SyntaxError("A binary plist's offsets and references are 1 to 8 bytes")
    if offset-size < 1 || offset-size > 8 || reference-size < 1 || reference-size > 8
?! SyntaxError("A binary plist's offset table lies outside it")
    if table-offset >= data.size || count > (data.size - table-offset) / offset-size
?! SyntaxError("A binary plist's top object is not one of its objects")
    if top >= count
reader.offset = table-offset as Size
. offsets [Size]
for _ in 0 .. < count
    . offset = reader.unsigned(offset-size, false)
    ?! SyntaxError("A binary plist object lies outside it")
        if offset >= table-offset
    offsets += offset as Size
. parser = BinaryPlistParser(reader, offsets, reference-size)
= parser.object(top as Size, 0)

━━━━━━━━━━━━━━━━━━━━
_ PlistObject is Tuple

+ value Plist
+ references [Size]

━━━━━━━━━━━━━━━━━━━━
_ do flatten Size
    - value Plist
    - objects List'PlistObject

. index = objects.length
objects += PlistObject(value, List'Size())
. references [Size]
do match? value
    | list List
        for item in list
            references += flatten(item, objects)
    | map Map
        . values [Plist]
        for key, item in map
            references += flatten(key, objects)
            values += item
        for item in values
            references += flatten(item, objects)
objects[index] = PlistObject(value, references)
= index

━━━━━━━━━━━━━━━━━━━━
_ do write-object
    - writer ByteWriter
    - object PlistObject
    - reference-size Size

do match object.value
    | Null!
        writer.u8(0x00)
    | flag Bool
        writer.u8(if flag then 0x09 else 0x08)
    | number I64
        write-int(writer, number)
    | real Float
        writer.u8(0x23)
        writer.f64-be(real)
    | text String
        write-string(writer, text)
    | data Byte[]
        write-marker(writer, 0x40, data.size)
        writer.bytes(data)
    | list List
        write-marker(writer, 0xA0, list.length)
        write-references(writer, object.references, reference-size)
    | map Map
        write-marker(writer, 0xD0, map.length)
        write-references(writer, object.references, reference-size)

━━━━━━━━━━━━━━━━━━━━
_ do write-references
    - writer ByteWriter
    - references [Size]
    - reference-size Size

for reference in references
    write-sized(writer, reference as U64, reference-size)

━━━━━━━━━━━━━━━━━━━━
_ do write-string
    - writer ByteWriter
    - text String

. codepoints = text.codepoints
if all(codepoints) • where each as U32 < 0x80
    write-marker(writer, 0x50, codepoints.size)
    writer.bytes(byte-view(text))
    =
write-marker(writer, 0x60, sum((if each as U32 >= 0x10000 then 2 else 1) in codepoints))
for codepoint in codepoints
    . value = codepoint as U32
    if value >= 0x10000
        . offset = value - 0x10000
        writer.u16-be((0xD800 + (offset /zrshift/ 10)) as U16)
        writer.u16-be((0xDC00 + (offset /and/ 0x3ff)) as U16)
    else
        writer.u16-be(value as U16)

━━━━━━━━━━━━━━━━━━━━
_ do write-marker
    - writer ByteWriter
    - kind Byte
    - count Size

if count < 15
    writer.u8(kind /or/ (count as Byte))
else
    writer.u8(kind /or/ 0x0F)
    write-int(writer, count)

━━━━━━━━━━━━━━━━━━━━
_ do write-int
    - writer ByteWriter
    - value I64

do match value
    |? it < 0
        writer.u8(0x13)
        writer.u64-be(value as U64)
    |? it < 0x100
        writer.u8(0x10)
        writer.u8(value as Byte)
    |? it < 0x10000
        writer.u8(0x11)
        writer.u16-be(value as U16)
    |? it < 0x100000000
        writer.u8(0x12)
        writer.u32-be(value as U32)
    ??
        writer.u8(0x13)
        writer.u64-be(value as U64)

━━━━━━━━━━━━━━━━━━━━
_ do write-sized
    - writer ByteWriter
    - value U64
    - size Size

for index in 0 .. < size
    writer.u8(((value /zrshift/ (((size - 1 - index) * 8) as U64)) /and/ 0xff) as Byte)

━━━━━━━━━━━━━━━━━━━━
_ do byte-count Size
    - value U64

. count Size = 1
. rest = value /zrshift/ 8
while rest != 0
    count += 1
    rest = rest /zrshift/ 8
= count

━━━━━━━━━━━━━━━━━━━━
_ BinaryPlistParser

_ reader ByteReader
_ offsets [Size]
_ reference-size Size

────────────────────
+ This
    - reader
    - offsets
    - reference-size

────────────────────
+ do object Plist ?! SyntaxError
    - index Size
    - depth Int

?! SyntaxError("A binary plist nests deeper than $binary-plist-depth-limit")
    if depth > binary-plist-depth-limit
?! SyntaxError("A binary plist refers to object $index of ${offsets.length}")
    if index >= offsets.length
reader.offset = offsets[index]
. marker = reader.u8()
. kind = marker /rshift/ 4
. low = marker /and/ 0x0F
= match marker
    |? it == 0x00 || it == 0x0F
        null
    |= 0x08
        false
    |= 0x09
        true
    |? kind == 0x1
        integer(low)
    |= 0x22
        reader.f32-be() as Float
    |? it == 0x23 || it == 0x33
        reader.f64-be() as Float
    |? kind == 0x4
        reader.bytes(count(low))
    |? kind == 0x5
        utf8-string(reader.bytes(count(low)))
    |? kind == 0x6
        utf16-string(count(low))
    |? kind == 0x8
        reader.unsigned(low + 1, false) as I64
    |? kind == 0xA
        array(count(low), depth)
    |? kind == 0xD
        dictionary(count(low), depth)
    ?! SyntaxError("A binary plist has an object with marker $marker, which is not supported")

────────────────────
_ do array [Plist] ?! SyntaxError
    - size Size
    - depth Int

. references = references(size)
. items [Plist]
for reference in references
    items += object(reference, depth + 1)
= items

────────────────────
_ do dictionary [String = Plist] ?! SyntaxError
    - size Size
    - depth Int

. keys = references(size)
. values = references(size)
. map [String = Plist]
for position in 0 .. < size
    . key = object(keys[position], depth + 1)
    do match key
        | text String
            map[text] = object(values[position], depth + 1)
        ?! SyntaxError("A binary plist dictionary has a key that is not a string")
= map

────────────────────
_ do integer I64 ?! SyntaxError
    - low Byte

. size = (1 /lshift/ (low as Size)) as Size
?! SyntaxError("A binary plist integer is $size bytes")
    if size > 16
if size == 16
    ?! SyntaxError("A binary plist integer does not fit in 64 bits")
        if reader.unsigned(8, false) != 0
    = reader.unsigned(8, false) as I64
= reader.unsigned(size, false) as I64

────────────────────
_ do count Size ?! SyntaxError
    - low Byte

=? low if low != 0x0F
. marker = reader.u8()
?! SyntaxError("A binary plist length is not an integer")
    if marker /rshift/ 4 != 0x1
. length = integer(marker /and/ 0x0F)
?! SyntaxError("A binary plist length is negative")
    if length < 0
= length

────────────────────
_ do references [Size] ?! SyntaxError
    - size Size

. result [Size]
for _ in 0 .. < size
    result += reader.unsigned(reference-size, false) as Size
= result

────────────────────
_ do utf16-string String ?! SyntaxError
    - units Size

. codepoints = Char[units]
. written Size = 0
. index Size = 0
while index < units
    . unit = reader.u16-be() as U32
    index += 1
    if unit >= 0xD800 && unit < 0xDC00 && index < units
        . low = reader.u16-be() as U32
        index += 1
        if low >= 0xDC00 && low < 0xE000
            codepoints[written] = (0x10000 + ((unit - 0xD800) /lshift/ 10) + (low - 0xDC00)) as Char
        else
            codepoints[written] = 0xFFFD as Char
            written += 1
            codepoints[written] = (if low >= 0xD800 && low < 0xE000 then 0xFFFD else low) as Char
    else if unit >= 0xD800 && unit < 0xE000
        codepoints[written] = 0xFFFD as Char
    else
        codepoints[written] = unit as Char
    written += 1
= codepoints[0 .. < written].slice-string()
