/core/arena
/core/array-builder

_ sexp-classes = Array'U8(256) • with sexp-byte-class(each)
_ sexp-text-classes = Array'U8(256) • with sexp-text-class(each)

━━━━━━━━━━━━━━━━━━━━
_ SexpClass is U8

| atom
| wide
| space
| newline
| open
| close
| quote
| semicolon

━━━━━━━━━━━━━━━━━━━━
_ SexpText is U8

| plain
| wide
| escape
| dollar
| newline
| quote

━━━━━━━━━━━━━━━━━━━━
+ SexpKind is U8

| open = 0
| close = 1
| atom = 2
| text = 3
| escaped-text = 4
| comment = 5

━━━━━━━━━━━━━━━━━━━━
+ Sexp is Union

| atom String
| text String
| list [Sexp]

━━━━━━━━━━━━━━━━━━━━
+ SexpError is Error

+ offset Index
+ hint String?

────────────────────
+ This
    - offset
    - text String
    - hint String? = null

message = text

━━━━━━━━━━━━━━━━━━━━
+ do sexp-tape SexpTape ?! SexpError
    - source String
    - arena Arena
    - keeps-comments = true

. tape = SexpTape(source, arena, keeps-comments)
tape.scan()
= tape

━━━━━━━━━━━━━━━━━━━━
+ sexp-parse [Sexp] ?! SexpError
    - source String

List(sexp-tree(tape, each) in tape.forms())

.. scratch = use Arena()
.. tape = sexp-tape(source, scratch, false)

━━━━━━━━━━━━━━━━━━━━
+ do sexp-tree Sexp
    - tape SexpTape
    - index Index

match tape.kind(index)
    |= .open
        = Sexp.list(List(sexp-tree(tape, each) in tape.children(index) when !tape.is-comment(each)))
    |= .atom
        = Sexp.atom(tape.atom-text(index))
    ??
        = Sexp.text(tape.text-value(index))

━━━━━━━━━━━━━━━━━━━━
+ sexp-written String
    - sexp Sexp

match sexp
    | .atom(name)
        name
    | .text(value)
        sexp-quoted(value)
    | .list(items)
        "(${" ".join(sexp-written(each) in items)})"

━━━━━━━━━━━━━━━━━━━━
+ sexp-quoted String
    - value String

"\"${"".join(sexp-escaped(each) in value)}\""

━━━━━━━━━━━━━━━━━━━━
_ sexp-escaped String
    - c Char

|? c == '"' || c == '\\' || c == '$'
    "\\$c"
|? c == '\n'
    "\\n"
|? c == '\t'
    "\\t"
|? c == '\r'
    "\\r"
|? sexp-is-control(c as U32)
    sexp-hex-escape(c as U32)
??
    c as String

━━━━━━━━━━━━━━━━━━━━
_ sexp-is-control Bool
    - code U32

code < 32 || (code >= 127 && code < 160) || code == 8232 || code == 8233 || code == 64976

━━━━━━━━━━━━━━━━━━━━
_ sexp-hex-escape String
    - code U32

if code >= 256 then "\\u$high$low" else "\\x$low"

.. digits = "0123456789abcdef".codepoints
.. high = "${digits[(code / 4096) % 16]}${digits[(code / 256) % 16]}"
.. low = "${digits[(code / 16) % 16]}${digits[code % 16]}"

━━━━━━━━━━━━━━━━━━━━
+ SexpTape

+ source String
+ bytes Byte[]
+ length Size
+ line-count Size = 1
+ keeps-comments Bool
+ first-dollar Index?

_ arena Arena
_ kinds Array'U8'ArenaBacking
_ starts Array'U32'ArenaBacking
_ ends Array'U32'ArenaBacking
_ token-lines Array'U32'ArenaBacking
_ opens Array'U32'ArenaBacking
_ line-starts Array'U32'ArenaBacking
_ wide-lines Array'U8'ArenaBacking
_ located-line Size

────────────────────
+ This
    - source
    - arena
    - keeps-comments

.. bytes = source as Byte[]
.. kinds = Array'U8(arena, token-capacity)
.. starts = Array'U32(arena, token-capacity)
.. ends = Array'U32(arena, token-capacity)
.. token-lines = Array'U32(arena, token-capacity)
.. opens = Array'U32(arena, 64)
.. line-starts = Array'U32(arena, line-capacity)
.. wide-lines = Array'U8(arena, line-capacity)

.. token-capacity = (source as Byte[]).length / 4 + 16
.. line-capacity = (source as Byte[]).length / 24 + 16

────────────────────
+ do scan ?! SexpError

?! Panic("SexpTape source is larger than 4 GB")
    if bytes.length >= U32.max
?! Panic("SexpTape is already scanned")
    if length != 0

. data = bytes
. end = data.length
. classes = sexp-classes.data
. text-classes = sexp-text-classes.data
. kind-data = kinds.data
. start-data = starts.data
. end-data = ends.data
. token-line-data = token-lines.data
. open-data = opens.data
. line-data = line-starts.data
. wide-data = wide-lines.data
. capacity = kinds.length
. line-capacity = line-starts.length
. count Size = 0
. depth Size = 0
. line Size = 0
. cursor Index = 0
line-data[0] = 0
wide-data[0] = 0

while cursor < end
    . byte = data[cursor]
    . class = classes[byte as Index]
    if count == capacity
        grow-tokens(count)
        kind-data = kinds.data
        start-data = starts.data
        end-data = ends.data
        token-line-data = token-lines.data
        capacity = kinds.length
    if class <= SexpClass.wide
        . first = cursor
        if class == SexpClass.wide
            wide-data[line] = 1
        cursor += 1
        while cursor < end
            . next = classes[data[cursor] as Index]
            if next == SexpClass.atom
                cursor += 1
            else if next == SexpClass.wide
                wide-data[line] = 1
                cursor += 1
            else
                break
        kind-data[count] = 2
        start-data[count] = first as U32
        end-data[count] = cursor as U32
        token-line-data[count] = line as U32
        count += 1
    else if class == SexpClass.space
        cursor += 1
    else if class == SexpClass.newline
        cursor += 1
        line += 1
        if line == line-capacity
            grow-lines(line)
            line-data = line-starts.data
            wide-data = wide-lines.data
            line-capacity = line-starts.length
        line-data[line] = cursor as U32
        wide-data[line] = 0
    else if class == SexpClass.open
        if depth == opens.length
            grow-opens(depth)
            open-data = opens.data
        open-data[depth] = count as U32
        depth += 1
        kind-data[count] = 0
        start-data[count] = cursor as U32
        end-data[count] = 0
        token-line-data[count] = line as U32
        count += 1
        cursor += 1
    else if class == SexpClass.close
        ?! SexpError(cursor, "Unexpected “)” at ${sexp-place(data, cursor)}", sexp-paren-hint(data))
            if depth == 0
        depth -= 1
        . open = open-data[depth]
        end-data[open as Index] = count as U32
        kind-data[count] = 1
        start-data[count] = cursor as U32
        end-data[count] = open
        token-line-data[count] = line as U32
        count += 1
        cursor += 1
    else if class == SexpClass.quote
        . first = cursor
        . first-line = line
        . escaped = false
        cursor += 1
        while true
            ?! SexpError(first, "Missing closing quote for the text opened at ${sexp-place(data, first)}")
                if cursor >= end
            . text-class = text-classes[data[cursor] as Index]
            if text-class == SexpText.plain
                cursor += 1
            else if text-class == SexpText.quote
                cursor += 1
                break
            else if text-class == SexpText.escape
                escaped = true
                if cursor + 1 < end && data[cursor + 1] == 10
                    line += 1
                    if line == line-capacity
                        grow-lines(line)
                        line-data = line-starts.data
                        wide-data = wide-lines.data
                        line-capacity = line-starts.length
                    line-data[line] = (cursor + 2) as U32
                    wide-data[line] = 0
                cursor += 2
            else if text-class == SexpText.newline
                cursor += 1
                line += 1
                if line == line-capacity
                    grow-lines(line)
                    line-data = line-starts.data
                    wide-data = wide-lines.data
                    line-capacity = line-starts.length
                line-data[line] = cursor as U32
                wide-data[line] = 0
            else if text-class == SexpText.wide
                wide-data[line] = 1
                cursor += 1
            else
                if !first-dollar
                    first-dollar = cursor
                cursor += 1
        kind-data[count] = if escaped then 4 else 3
        start-data[count] = first as U32
        end-data[count] = cursor as U32
        token-line-data[count] = first-line as U32
        count += 1
    else
        . first = cursor
        while cursor < end && data[cursor] != 10
            cursor += 1
        if keeps-comments
            . last = cursor
            if last > first && data[last - 1] == 13
                last -= 1
            kind-data[count] = 5
            start-data[count] = first as U32
            end-data[count] = last as U32
            token-line-data[count] = line as U32
            count += 1

if depth > 0
    . outer = open-data[0] as Index
    . opened = start-data[outer] as Index
    ?! SexpError(opened, "Missing “)” for the form opened at ${sexp-place(data, opened)}", sexp-paren-hint(data))

length = count
line-count = line + 1

────────────────────
_ do grow-tokens
    - count Size

. capacity = kinds.length * 2
. next-kinds = Array'U8(arena, capacity)
. next-starts = Array'U32(arena, capacity)
. next-ends = Array'U32(arena, capacity)
. next-lines = Array'U32(arena, capacity)
. kind-data = kinds.data
. start-data = starts.data
. end-data = ends.data
. line-data = token-lines.data
. next-kind-data = next-kinds.data
. next-start-data = next-starts.data
. next-end-data = next-ends.data
. next-line-data = next-lines.data
for index in 0 .. < count
    next-kind-data[index] = kind-data[index]
    next-start-data[index] = start-data[index]
    next-end-data[index] = end-data[index]
    next-line-data[index] = line-data[index]
kinds = next-kinds
starts = next-starts
ends = next-ends
token-lines = next-lines

────────────────────
_ do grow-lines
    - count Size

. capacity = line-starts.length * 2
. next-starts = Array'U32(arena, capacity)
. next-wide = Array'U8(arena, capacity)
. start-data = line-starts.data
. wide-data = wide-lines.data
. next-start-data = next-starts.data
. next-wide-data = next-wide.data
for index in 0 .. < count
    next-start-data[index] = start-data[index]
    next-wide-data[index] = wide-data[index]
line-starts = next-starts
wide-lines = next-wide

────────────────────
_ do grow-opens
    - count Size

. next-opens = Array'U32(arena, opens.length * 2)
. open-data = opens.data
. next-open-data = next-opens.data
for index in 0 .. < count
    next-open-data[index] = open-data[index]
opens = next-opens

────────────────────
+ kind SexpKind @inline
    - index Index

kinds[index] as SexpKind

────────────────────
+ is-open Bool @inline
    - index Index

kinds[index] == 0

────────────────────
+ is-close Bool @inline
    - index Index

kinds[index] == 1

────────────────────
+ is-atom Bool @inline
    - index Index

kinds[index] == 2

────────────────────
+ is-text Bool @inline
    - index Index

kinds[index] == 3 || kinds[index] == 4

────────────────────
+ is-comment Bool @inline
    - index Index

kinds[index] == 5

────────────────────
+ start Index @inline
    - index Index

starts[index]

────────────────────
+ end Index
    - index Index

if kinds[index] == 0 then (starts[ends[index]] as Index) + 1 else (ends[index] as Index)

────────────────────
+ close-of Index @inline
    - index Index

ends[index]

────────────────────
+ after Index @inline
    - index Index

if kinds[index] == 0 then (ends[index] as Index) + 1 else index + 1

────────────────────
+ do forms

. index Index = 0
while index < length
    <= index
    index = after(index)

────────────────────
+ do children
    - index Index

. item = index + 1
. close = ends[index] as Index
while item < close
    <= item
    item = after(item)

────────────────────
+ atom-text String
    - index Index

bytes.slice-string((starts[index] as Index) .. < (ends[index] as Index))

────────────────────
+ atom-is Bool
    - index Index
    - text String

atom-matches(index, text)

────────────────────
+ do atom-matches Bool
    - index Index
    - expected Byte[]

. first = starts[index] as Index
=? false if (ends[index] as Index) - first != expected.length
for offset in 0 .. < expected.length
    =? false if bytes[first + offset] != expected[offset]
= true

────────────────────
+ text-value String
    - index Index

|? kinds[index] == 3
    bytes.slice-string(first .. < last)
??
    sexp-unescaped-text(bytes, first, last)

.. first = (starts[index] as Index) + 1
.. last = (ends[index] as Index) - 1

────────────────────
+ comment-text String
    - index Index

bytes.slice-string((starts[index] as Index) + 1 .. < (ends[index] as Index))

────────────────────
+ do location TokenLocation
    - offset Index

located-line = line-at(offset, located-line)
= column-location(offset, located-line)

────────────────────
+ token-location TokenLocation
    - index Index

column-location(starts[index], token-lines[index])

────────────────────
+ token-end-location TokenLocation
    - index Index

|? kind == 0
    column-location((starts[last] as Index) + 1, token-lines[last])
|? kind != 3 && kind != 4
    column-location(last, line)
??
    column-location(last, line-at(last, line))

.. kind = kinds[index]
.. line = token-lines[index] as Size
.. last = ends[index] as Index

────────────────────
_ do line-at Size
    - offset Index
    - hint Size

. data = line-starts.data
=? line-before(offset) if offset < (data[hint] as Index)
. line = hint
while line + 1 < line-count && (data[line + 1] as Index) <= offset
    line += 1
= line

────────────────────
_ do column-location TokenLocation
    - offset Index
    - line Size

. line-start = line-starts.data[line] as Index
=? TokenLocation(line as U32, (offset - line-start) as U32) if wide-lines.data[line] == 0
. column U32
for position in line-start .. < offset
    . byte = bytes[position]
    if byte < 128 || byte >= 192
        column += 1
= TokenLocation(line as U32, column)

────────────────────
_ do line-before Size
    - offset Index

. data = line-starts.data
. low Size = 0
. high = line-count
while high - low > 1
    . middle = (low + high) / 2
    if (data[middle] as Index) <= offset
        low = middle
    else
        high = middle
= low

━━━━━━━━━━━━━━━━━━━━
_ sexp-byte-class U8
    - code Size

|? code == 32 || code == 9 || code == 13
    SexpClass.space
|? code == 10
    SexpClass.newline
|? code == 40
    SexpClass.open
|? code == 41
    SexpClass.close
|? code == 34
    SexpClass.quote
|? code == 59
    SexpClass.semicolon
|? code >= 128
    SexpClass.wide
??
    SexpClass.atom

━━━━━━━━━━━━━━━━━━━━
_ sexp-text-class U8
    - code Size

|? code == 34
    SexpText.quote
|? code == 92
    SexpText.escape
|? code == 36
    SexpText.dollar
|? code == 10
    SexpText.newline
|? code >= 128
    SexpText.wide
??
    SexpText.plain

━━━━━━━━━━━━━━━━━━━━
+ do sexp-unescaped-text String
    - bytes Byte[]
    - first Index
    - last Index

. decoded = ArrayBuilder'Byte()
. run = first
. index = first
while index < last
    if bytes[index] == 92 && index + 1 < last
        decoded.append-all(bytes[run .. < index])
        . width = sexp-hex-width(bytes, index + 1, last)
        if width > 0
            . code U32
            for offset in 0 .. < width
                code = code * 16 + (sexp-hex-value(bytes[index + 2 + offset]) as U32)
            decoded.append-all(((code as Char) as String) as Byte[])
            index += 2 + width
        else
            decoded.append(sexp-unescaped-byte(bytes[index + 1]))
            index += 2
        run = index
    else
        index += 1
decoded.append-all(bytes[run .. < last])
= decoded.finish-mutable().slice-string()

━━━━━━━━━━━━━━━━━━━━
_ sexp-unescaped-byte Byte
    - byte Byte

match byte
    |= 110
        10
    |= 116
        9
    |= 114
        13
    ??
        byte

━━━━━━━━━━━━━━━━━━━━
_ do sexp-hex-width Size
    - bytes Byte[]
    - index Index
    - last Index

. width Size = 0
if bytes[index] == 120
    width = 2
else if bytes[index] == 117
    width = 4
=? 0 if width == 0 || index + width >= last
for offset in 1 .. width
    =? 0 if sexp-hex-value(bytes[index + offset]) < 0
= width

━━━━━━━━━━━━━━━━━━━━
_ sexp-hex-value Int
    - byte Byte

|? byte >= 48 && byte <= 57
    (byte as Int) - 48
|? byte >= 97 && byte <= 102
    (byte as Int) - 87
|? byte >= 65 && byte <= 70
    (byte as Int) - 55
??
    -1

━━━━━━━━━━━━━━━━━━━━
+ sexp-place String
    - bytes Byte[]
    - offset Index

"line ${place.line + 1}, column ${place.column + 1}"

.. place = sexp-location(bytes, offset)

━━━━━━━━━━━━━━━━━━━━
+ do sexp-location TokenLocation
    - bytes Byte[]
    - offset Index

. line U32
. column U32
for index in 0 .. < offset
    . byte = bytes[index]
    if byte == 10
        line += 1
        column = 0
    else if byte < 128 || byte >= 192
        column += 1
= TokenLocation(line, column)

━━━━━━━━━━━━━━━━━━━━
_ SexpOpen is Tuple

+ line Size
+ indent Size
+ offset Index

━━━━━━━━━━━━━━━━━━━━
+ do sexp-paren-hint String?
    - bytes Byte[]

. open [SexpOpen]
. line Size = 1
. indent Size = 0
. is-leading = true
. index Index = 0
while index < bytes.length
    . byte = bytes[index]
    if byte == 10
        line += 1
        indent = 0
        is-leading = true
        index += 1
        continue
    if byte == 32 || byte == 9 || byte == 13
        if is-leading
            indent += 1
        index += 1
        continue
    if byte == 59
        while index < bytes.length && bytes[index] != 10
            index += 1
        continue
    if is-leading && byte != 41
        . late = sexp-stale-open(open, line, indent)
        if late != null
            = "The ${sexp-open-name(bytes, late)} opened on line ${late.line} is still open on line $line, which is indented no deeper. It probably needs its “)” before line $line."
    if byte == 34
        index += 1
        while index < bytes.length && bytes[index] != 34
            if bytes[index] == 10
                line += 1
            index += if bytes[index] == 92 then 2 else 1
    else if byte == 40
        open += SexpOpen(line, indent, index)
    else if byte == 41
        =? "The “)” on line $line closes nothing." if open.length == 0
        . held = open[open.length - 1]
        if is-leading && held.line != line && held.indent > indent
            = "The ${sexp-open-name(bytes, held)} opened on line ${held.line} is still open where line $line closes a form that began further left. It probably needs its “)” before line $line."
        if is-leading && held.line != line && held.indent < indent
            = "The “)” on line $line closes the ${sexp-open-name(bytes, held)} opened on line ${held.line}, which began further left. A line before it probably has one “)” too many."
        -= open[open.length - 1]
    is-leading = false
    index += 1
=? null if open.length == 0
. last = open[open.length - 1]
= "At the end of the file ${open.length} forms are still open. The innermost is the ${sexp-open-name(bytes, last)} opened on line ${last.line}."

━━━━━━━━━━━━━━━━━━━━
_ do sexp-stale-open SexpOpen?
    - open [SexpOpen]
    - line Size
    - indent Size

for held in open
    =? held if held.line < line && held.indent >= indent
= null

━━━━━━━━━━━━━━━━━━━━
_ do sexp-open-name String
    - bytes Byte[]
    - held SexpOpen

. start = held.offset + 1
. end = start
while end < bytes.length && !(bytes[end] == 32 || bytes[end] == 10 || bytes[end] == 40 || bytes[end] == 41 || bytes[end] == 34)
    end += 1
=? "list" if end == start
= "(${bytes.slice-string(start .. < end)} …)"
