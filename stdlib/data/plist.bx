(import ./binary)
(import /stream/aggregate)
(blank)
(prop _ binary-plist-magic _ (= "bplist00"))
(prop _ binary-plist-trailer-size Size (= 32))
(prop _ binary-plist-depth-limit _ (= 512))

(type + Plist (is Union)
  (variant Null)
  (variant Bool)
  (variant I64)
  (variant Float)
  (variant String)
  (variant ([] Byte))
  (variant (list Plist))
  (variant (map String Plist))
)

(fn-do + to-binary-plist ([] Byte)
  (param value Plist)
  (let objects (call (of List PlistObject)))
  (call flatten value objects)
  (let reference-size (call byte-count (as (. objects length) U64)))
  (let writer (call ByteWriter))
  (call (. writer bytes) (call byte-view binary-plist-magic))
  (let offsets (list Size))
  (for (in object objects)
    (+= offsets (. writer size))
    (call write-object writer object reference-size)
  )
  (let table-offset (. writer size))
  (let offset-size (call byte-count (as table-offset U64)))
  (for (in offset offsets)
    (call write-sized writer (as offset U64) offset-size)
  )
  (for (in _ (..< 0 6))
    (call (. writer u8) 0)
  )
  (call (. writer u8) (as offset-size Byte))
  (call (. writer u8) (as reference-size Byte))
  (call (. writer u64-be) (as (. objects length) U64))
  (call (. writer u64-be) 0)
  (call (. writer u64-be) (as table-offset U64))
  (return (call (. writer finish)))
)

(fn-do + parse-binary-plist Plist (?! SyntaxError)
  (param data ([] Byte))
  (throw (call SyntaxError "The data is too short to be a binary plist") (if (< (. data size) (+ (. binary-plist-magic size) binary-plist-trailer-size))))
  (throw (call SyntaxError (str "The data does not start with " binary-plist-magic)) (if (!= ([] data (..< 0 (. binary-plist-magic size))) (call byte-view binary-plist-magic))))
  (let reader (call ByteReader data))
  (= (. reader offset) (+ (- (. data size) binary-plist-trailer-size) 6))
  (let offset-size (as (call (. reader u8)) Size))
  (let reference-size (as (call (. reader u8)) Size))
  (let count (call (. reader u64-be)))
  (let top (call (. reader u64-be)))
  (let table-offset (call (. reader u64-be)))
  (throw (call SyntaxError "A binary plist's offsets and references are 1 to 8 bytes") (if (or (< offset-size 1) (> offset-size 8) (< reference-size 1) (> reference-size 8))))
  (throw (call SyntaxError "A binary plist's offset table lies outside it") (if (or (>= table-offset (. data size)) (> count (/ (- (. data size) table-offset) offset-size)))))
  (throw (call SyntaxError "A binary plist's top object is not one of its objects") (if (>= top count)))
  (= (. reader offset) (as table-offset Size))
  (let offsets (list Size))
  (for (in _ (..< 0 count))
    (let offset (call (. reader unsigned) offset-size false))
    (throw (call SyntaxError "A binary plist object lies outside it") (if (>= offset table-offset)))
    (+= offsets (as offset Size))
  )
  (let parser (call BinaryPlistParser reader offsets reference-size))
  (return (call (. parser object) (as top Size) 0))
)

(type _ PlistObject (is Tuple)
  (prop + value Plist)
  (prop + references (list Size))
)

(fn-do _ flatten Size
  (param value Plist)
  (param objects (of List PlistObject))
  (let index (. objects length))
  (+= objects (call PlistObject value (call (of List Size))))
  (let references (list Size))
  (match? value
    (case (: list List)
      (for (in item list)
        (+= references (call flatten item objects))
      )
    )
    (case (: map Map)
      (let values (list Plist))
      (for (in (tuple key item) map)
        (+= references (call flatten key objects))
        (+= values item)
      )
      (for (in item values)
        (+= references (call flatten item objects))
      )
    )
  )
  (= ([] objects index) (call PlistObject value references))
  (return index)
)

(fn-do _ write-object _
  (param writer ByteWriter)
  (param object PlistObject)
  (param reference-size Size)
  (match (. object value)
    (case (exact Null)
      (call (. writer u8) 0x00)
    )
    (case (: flag Bool)
      (call (. writer u8) (if-expr flag 0x09 0x08))
    )
    (case (: number I64)
      (call write-int writer number)
    )
    (case (: real Float)
      (call (. writer u8) 0x23)
      (call (. writer f64-be) real)
    )
    (case (: text String)
      (call write-string writer text)
    )
    (case (: data ([] Byte))
      (call write-marker writer 0x40 (. data size))
      (call (. writer bytes) data)
    )
    (case (: list List)
      (call write-marker writer 0xA0 (. list length))
      (call write-references writer (. object references) reference-size)
    )
    (case (: map Map)
      (call write-marker writer 0xD0 (. map length))
      (call write-references writer (. object references) reference-size)
    )
  )
)

(fn-do _ write-references _
  (param writer ByteWriter)
  (param references (list Size))
  (param reference-size Size)
  (for (in reference references)
    (call write-sized writer (as reference U64) reference-size)
  )
)

(fn-do _ write-string _
  (param writer ByteWriter)
  (param text String)
  (let codepoints (. text codepoints))
  (if (call all codepoints (:where (< (as each U32) 0x80)))
    (call write-marker writer 0x50 (. codepoints size))
    (call (. writer bytes) (call byte-view text))
    (return)
  )
  (call write-marker writer 0x60 (call sum (in (if-expr (>= (as each U32) 0x10000) 2 1) codepoints)))
  (for (in codepoint codepoints)
    (let value (as codepoint U32))
    (if (>= value 0x10000)
      (let offset (- value 0x10000))
      (call (. writer u16-be) (as (+ 0xD800 (/zrshift/ offset 10)) U16))
      (call (. writer u16-be) (as (+ 0xDC00 (/and/ offset 0x3ff)) U16))
      (else
        (call (. writer u16-be) (as value U16))
      )
    )
  )
)

(fn-do _ write-marker _
  (param writer ByteWriter)
  (param kind Byte)
  (param count Size)
  (if (< count 15)
    (call (. writer u8) (/or/ kind (as count Byte)))
    (else
      (call (. writer u8) (/or/ kind 0x0F))
      (call write-int writer count)
    )
  )
)

(fn-do _ write-int _
  (param writer ByteWriter)
  (param value I64)
  (match value
    (case? (< it 0)
      (call (. writer u8) 0x13)
      (call (. writer u64-be) (as value U64))
    )
    (case? (< it 0x100)
      (call (. writer u8) 0x10)
      (call (. writer u8) (as value Byte))
    )
    (case? (< it 0x10000)
      (call (. writer u8) 0x11)
      (call (. writer u16-be) (as value U16))
    )
    (case? (< it 0x100000000)
      (call (. writer u8) 0x12)
      (call (. writer u32-be) (as value U32))
    )
    (default
      (call (. writer u8) 0x13)
      (call (. writer u64-be) (as value U64))
    )
  )
)

(fn-do _ write-sized _
  (param writer ByteWriter)
  (param value U64)
  (param size Size)
  (for (in index (..< 0 size))
    (call (. writer u8) (as (/and/ (/zrshift/ value (as (* (- size 1 index) 8) U64)) 0xff) Byte))
  )
)

(fn-do _ byte-count Size
  (param value U64)
  (let count Size 1)
  (let rest (/zrshift/ value 8))
  (while (!= rest 0)
    (+= count 1)
    (= rest (/zrshift/ rest 8))
  )
  (return count)
)

(type _ BinaryPlistParser
  (prop _ reader ByteReader)
  (prop _ offsets (list Size))
  (prop _ reference-size Size)
  (fn-do + This _
    (param reader _)
    (param offsets _)
    (param reference-size _)
  )
  (fn-do + object Plist (?! SyntaxError)
    (param index Size)
    (param depth Int)
    (throw (call SyntaxError (str "A binary plist nests deeper than " binary-plist-depth-limit)) (if (> depth binary-plist-depth-limit)))
    (throw (call SyntaxError (str "A binary plist refers to object " index " of " (. offsets length))) (if (>= index (. offsets length))))
    (= (. reader offset) ([] offsets index))
    (let marker (call (. reader u8)))
    (let kind (/rshift/ marker 4))
    (let low (/and/ marker 0x0F))
    (return
      (match marker
        (case? (or (== it 0x00) (== it 0x0F))
          null
        )
        (case= 0x08
          false
        )
        (case= 0x09
          true
        )
        (case? (== kind 0x1)
          (call integer low)
        )
        (case= 0x22
          (as (call (. reader f32-be)) Float)
        )
        (case? (or (== it 0x23) (== it 0x33))
          (as (call (. reader f64-be)) Float)
        )
        (case? (== kind 0x4)
          (call (. reader bytes) (call count low))
        )
        (case? (== kind 0x5)
          (call utf8-string (call (. reader bytes) (call count low)))
        )
        (case? (== kind 0x6)
          (call utf16-string (call count low))
        )
        (case? (== kind 0x8)
          (as (call (. reader unsigned) (+ low 1) false) I64)
        )
        (case? (== kind 0xA)
          (call array (call count low) depth)
        )
        (case? (== kind 0xD)
          (call dictionary (call count low) depth)
        )
        (throw (call SyntaxError (str "A binary plist has an object with marker " marker ", which is not supported")))
      )
    )
  )
  (fn-do _ array (list Plist) (?! SyntaxError)
    (param size Size)
    (param depth Int)
    (let references (call references size))
    (let items (list Plist))
    (for (in reference references)
      (+= items (call object reference (+ depth 1)))
    )
    (return items)
  )
  (fn-do _ dictionary (map String Plist) (?! SyntaxError)
    (param size Size)
    (param depth Int)
    (let keys (call references size))
    (let values (call references size))
    (let map (map String Plist))
    (for (in position (..< 0 size))
      (let key (call object ([] keys position) (+ depth 1)))
      (match key
        (case (: text String)
          (= ([] map text) (call object ([] values position) (+ depth 1)))
        )
        (throw (call SyntaxError "A binary plist dictionary has a key that is not a string"))
      )
    )
    (return map)
  )
  (fn-do _ integer I64 (?! SyntaxError)
    (param low Byte)
    (let size (as (/lshift/ 1 (as low Size)) Size))
    (throw (call SyntaxError (str "A binary plist integer is " size " bytes")) (if (> size 16)))
    (if (== size 16)
      (throw (call SyntaxError "A binary plist integer does not fit in 64 bits") (if (!= (call (. reader unsigned) 8 false) 0)))
      (return (as (call (. reader unsigned) 8 false) I64))
    )
    (return (as (call (. reader unsigned) size false) I64))
  )
  (fn-do _ count Size (?! SyntaxError)
    (param low Byte)
    (return-if low (if (!= low 0x0F)))
    (let marker (call (. reader u8)))
    (throw (call SyntaxError "A binary plist length is not an integer") (if (!= (/rshift/ marker 4) 0x1)))
    (let length (call integer (/and/ marker 0x0F)))
    (throw (call SyntaxError "A binary plist length is negative") (if (< length 0)))
    (return length)
  )
  (fn-do _ references (list Size) (?! SyntaxError)
    (param size Size)
    (let result (list Size))
    (for (in _ (..< 0 size))
      (+= result (as (call (. reader unsigned) reference-size false) Size))
    )
    (return result)
  )
  (fn-do _ utf16-string String (?! SyntaxError)
    (param units Size)
    (let codepoints ([] Char units))
    (let written Size 0)
    (let index Size 0)
    (while (< index units)
      (let unit (as (call (. reader u16-be)) U32))
      (+= index 1)
      (if (and (>= unit 0xD800) (< unit 0xDC00) (< index units))
        (let low (as (call (. reader u16-be)) U32))
        (+= index 1)
        (if (and (>= low 0xDC00) (< low 0xE000))
          (= ([] codepoints written) (as (+ 0x10000 (/lshift/ (- unit 0xD800) 10) (- low 0xDC00)) Char))
          (else
            (= ([] codepoints written) (as 0xFFFD Char))
            (+= written 1)
            (= ([] codepoints written) (as (if-expr (and (>= low 0xD800) (< low 0xE000)) 0xFFFD low) Char))
          )
        )
        (else-if (and (>= unit 0xD800) (< unit 0xE000))
          (= ([] codepoints written) (as 0xFFFD Char))
        )
        (else
          (= ([] codepoints written) (as unit Char))
        )
      )
      (+= written 1)
    )
    (return (call (. ([] codepoints (..< 0 written)) slice-string)))
  )
)
