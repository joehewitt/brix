────────────────────
+ do display-row-at
    - address I64

?! OutOfBoundsError("Diff display row out of bounds")
    if address < 0 || address >= display-row-count
if hunks.length == 0
    =? row-at(0) if runs[0].kind == DiffKind.notice
    = DiffRow(.notice, 0, 0, "No textual changes")
. low Index = 0
. high = hunks.length
while low < high
    . middle = low + (high - low) / 2
    if address < hunks[middle].row-end
        high = middle
    else
        low = middle + 1
. hunk = hunks[low]
. leading I64 = if low > 0 then 1 else 0
. offset = address - (hunk.row-end - (hunk.end - hunk.start + leading))
=? row-at(hunk.start + offset - leading) if offset >= leading
. hidden = hunk.start - hunks[low - 1].end
= DiffRow(.gap, 0, 0, if hidden == 1 then "1 unchanged line" else "$hidden unchanged lines")

────────────────────
+ do gaps-before I64
    - address I64

=? 0 if hunks.length < 2 || address <= 0
=? hunks.length - 1 if address >= display-row-count
. low Index = 0
. high = hunks.length
while low < high
    . middle = low + (high - low) / 2
    if address < hunks[middle].row-end
        high = middle
    else
        low = middle + 1
=? 0 if low == 0
. hunk = hunks[low]
. start = hunk.row-end - (hunk.end - hunk.start + 1)
= if address > start then (low as I64) else (low as I64) - 1

