.. found = run-holding(is-old, line)
.. run = runs[found]
.. start = if is-old then run.old-start else run.new-start
.. across = if is-old then run.new-start else run.old-start

────────────────────
+ do display-address
    - is-old Bool
    - line Index

=? 0 if hunks.length == 0
. found = run-holding(is-old, line)
. row = row-count
if found != null
    . run = runs[found]
    row = run.row-end - run.count + (line as I64) - side-start
        .. side-start = if is-old then run.old-start else run.new-start
. low Index = 0
. high = hunks.length
while low < high
    . middle = low + (high - low) / 2
    if row < hunks[middle].end
        high = middle
    else
        low = middle + 1
=? display-row-count - 1 if low >= hunks.length
. hunk = hunks[low]
. first = hunk.row-end - (hunk.end - hunk.start)
=? first + row - hunk.start if row >= hunk.start
= if low > 0 then first - 1 else first

────────────────────
_ do run-holding Index?
    - is-old Bool
    - line Index

. target = line as I64
. changed = if is-old then DiffKind.deleted else DiffKind.inserted
for index in 0 .. < runs.length
    . run = runs[index]
    . start = if is-old then run.old-start else run.new-start
    . is-on-side = run.kind == DiffKind.equal || run.kind == changed
    if is-on-side && target >= start && target < start + run.count
        = index
= null

────────────────────
_ do position-at
    - address I64

. low Index = 0
. high = runs.length
while low < high
    . middle = low + (high - low) / 2
    if address < runs[middle].row-end
        high = middle
    else
        low = middle + 1
. index = if low < runs.length then low else low - 1
. run = runs[index]
. offset = address - (run.row-end - run.count)
. old-index = if run.kind != DiffKind.inserted then run.old-start + offset else run.old-start
. new-index = if run.kind != DiffKind.deleted then run.new-start + offset else run.new-start
= DiffSplit(old-index, new-index)

────────────────────
+ do row-at
    - address I64

?! OutOfBoundsError("Diff row out of bounds")
    if address < 0 || address >= row-count
. low Index = 0
. high = runs.length
while low < high
    . middle = low + (high - low) / 2
    if address < runs[middle].row-end
        high = middle
    else
        low = middle + 1
. run = runs[low]
. offset = address - (run.row-end - run.count)
. old-index = run.old-start + offset
. new-index = run.new-start + offset
match run.kind
    | .equal
        = DiffRow(run.kind, old-index + 1, new-index + 1, new-text.line-text(new-index))
    | .inserted
        = DiffRow(run.kind, 0, new-index + 1, new-text.line-text(new-index))
    | .deleted
        = DiffRow(run.kind, old-index + 1, 0, old-text.line-text(old-index))
    | .notice
        . is-binary = old-text.is-binary || new-text.is-binary
        = DiffRow(run.kind, 0, 0, diff-notice(is-binary, is-identical))
    | .gap
        ?! Panic("Hunk gap cannot be a diff run")
    | .file
        ?! Panic("File header cannot be a diff run")

