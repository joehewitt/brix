    - text DiffText
    - line Index

diff-tokens(text.bytes, text.lines[line].start, text.content-end(line))

━━━━━━━━━━━━━━━━━━━━
_ do diff-tokens
    - bytes Byte[]
    - start Index
    - end Index

. tokens [DiffToken]
. position = start
while position < end
    . kind = diff-byte-class(bytes[position])
    . next = position + 1
    if kind != DiffByteClass.mark
        while next < end && diff-byte-class(bytes[next]) == kind
            next += 1
    tokens += DiffToken(position, next, kind == DiffByteClass.space)
    position = next
= tokens

━━━━━━━━━━━━━━━━━━━━
_ diff-byte-class
    - byte Byte

|? byte == 32 || byte == 9 || byte == 13
    DiffByteClass.space
|? byte >= 128 || byte == 95 || (byte >= 48 && byte <= 57)
    DiffByteClass.word
|? (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
    DiffByteClass.word
??
    DiffByteClass.mark

━━━━━━━━━━━━━━━━━━━━
_ do diff-token-same
    - left-bytes Byte[]
    - left DiffToken
    - right-bytes Byte[]
    - right DiffToken

. count = left.end - left.start
=? false if count != right.end - right.start
for offset in 0 .. < count
    =? false if left-bytes[left.start + offset] != right-bytes[right.start + offset]
= true

━━━━━━━━━━━━━━━━━━━━
_ do diff-text-bytes
    - tokens [DiffToken]

. total Size = 0
for token in tokens
    if !token.is-space
        total += token.end - token.start
= total

━━━━━━━━━━━━━━━━━━━━
_ do diff-unchanged-bytes
    - tokens [DiffToken]
    - changed Bool[]

. total Size = 0
for index in 0 .. < tokens.length
    if !tokens[index].is-space && !changed[index]
        total += tokens[index].end - tokens[index].start
= total

━━━━━━━━━━━━━━━━━━━━
_ do diff-word-ranges
    - bytes Byte[]
    - tokens [DiffToken]
    - changed Bool[]

. ranges [Range'Index]
. low Index = 0
. high Index = 0
. is-open = false
for index in 0 .. < tokens.length
    if !changed[index]
        continue
    . token = tokens[index]
    if is-open && diff-all-space(bytes, high, token.start)
        high = token.end
    else
        if is-open
            ranges += low .. < high
        low = token.start
        high = token.end
        is-open = true
if is-open
    ranges += low .. < high
= ranges

━━━━━━━━━━━━━━━━━━━━
_ diff-all-space
    - bytes Byte[]
    - start Index
    - end Index

all(start .. < end) • where diff-byte-class(bytes[each]) == DiffByteClass.space

━━━━━━━━━━━━━━━━━━━━
_ do diff-mark
    - changed Bool[]
    - start I64
    - end I64

for index in start .. < end
    changed[index] = true

━━━━━━━━━━━━━━━━━━━━
_ DiffGroup

+ changed Bool[]
+ count I64
+ start I64
+ end I64

────────────────────
+ This
    - changed

count = changed.length
while end < count && changed[end]
    end += 1

────────────────────
+ get is-empty

end == start

────────────────────
+ do next

=? false if end >= count
start = end + 1
end = start
while end < count && changed[end]
    end += 1
= true

────────────────────
+ do previous

=? false if start == 0
end = start - 1
start = end
while start > 0 && changed[start - 1]
    start -= 1
= true

────────────────────
+ do slide-down
    - text DiffText

=? false if end >= count || !diff-lines-same(text, start, end)
changed[start] = false
start += 1
changed[end] = true
end += 1
while end < count && changed[end]
    end += 1
= true

────────────────────
+ do slide-up
    - text DiffText

=? false if start == 0 || !diff-lines-same(text, start - 1, end - 1)
start -= 1
changed[start] = true
end -= 1
changed[end] = false
while start > 0 && changed[start - 1]
    start -= 1
= true

━━━━━━━━━━━━━━━━━━━━
_ do diff-compact
    - text DiffText
    - changed Bool[]
    - other Bool[]

. group = DiffGroup(changed)
. paired = DiffGroup(other)
while true
    if !group.is-empty
        . size I64
        . earliest-end I64
        . matching I64 = -1
        . is-growing = true
        while is-growing
            size = group.end - group.start
            matching = -1
            while group.slide-up(text)
                diff-step(paired.previous())
            earliest-end = group.end
            if !paired.is-empty
                matching = group.end
            while group.slide-down(text)
                diff-step(paired.next())
                if !paired.is-empty
                    matching = group.end
            is-growing = size != group.end - group.start
        if group.end != earliest-end
            . target = matching
            if matching < 0
                target = diff-best-shift(text, group.end, earliest-end, size)
            while group.end > target
                diff-step(group.slide-up(text))
                diff-step(paired.previous())
    if !group.next()
        break
    diff-step(paired.next())

━━━━━━━━━━━━━━━━━━━━
_ do diff-step
    - moved Bool

?! Panic("Diff groups out of sync")
    if !moved

━━━━━━━━━━━━━━━━━━━━
_ DiffSplitScore is (indent I64, penalty I64)

━━━━━━━━━━━━━━━━━━━━
_ do diff-best-shift
    - text DiffText
    - end I64
    - earliest-end I64
    - size I64

. shift = max(earliest-end, max(end - size - 1, end - diff-slide-limit))
. best I64 = -1
. best-score = DiffSplitScore(0, 0)
while shift <= end
    . upper = diff-split-score(text, shift - size)
    . lower = diff-split-score(text, shift)
    . score = DiffSplitScore(upper.indent + lower.indent, upper.penalty + lower.penalty)
    if best < 0 || diff-score-compare(score, best-score) <= 0
        best = shift
        best-score = score
    shift += 1
= best

━━━━━━━━━━━━━━━━━━━━
_ diff-score-compare
    - left DiffSplitScore
    - right DiffSplitScore

60 * sign + left.penalty - right.penalty

.. sign I64 = if left.indent > right.indent then 1 else if left.indent < right.indent then -1 else 0

━━━━━━━━━━━━━━━━━━━━
_ do diff-split-score
    - text DiffText
    - split I64

. count = text.lines.length as I64
. is-end = split >= count
. indent = if is-end then -1 else diff-line-indent(text, split)
. pre-blank I64
. pre-indent I64 = -1
. line = split - 1
while line >= 0
    pre-indent = diff-line-indent(text, line)
    if pre-indent != -1
        break
    pre-blank += 1
    if pre-blank == diff-blank-limit
        pre-indent = 0
        break
    line -= 1
. post-blank I64
. post-indent I64 = -1
line = split + 1
while line < count
    post-indent = diff-line-indent(text, line)
    if post-indent != -1
        break
    post-blank += 1
    if post-blank == diff-blank-limit
        post-indent = 0
        break
    line += 1
. penalty I64
if pre-indent == -1 && pre-blank == 0
    penalty += 1
if is-end
    penalty += 21
. trailing = if indent == -1 then 1 + post-blank else 0
. blanks = pre-blank + trailing
penalty += -30 * blanks + 6 * trailing
. effective = if indent != -1 then indent else post-indent
. any-blanks = blanks != 0
if effective != -1 && pre-indent != -1
    if effective > pre-indent
        penalty += if any-blanks then 10 else -4
    else if effective < pre-indent
        if post-indent != -1 && post-indent > effective
            penalty += if any-blanks then 17 else 24
        else
            penalty += if any-blanks then 17 else 23
= DiffSplitScore(effective, penalty)

━━━━━━━━━━━━━━━━━━━━
_ do diff-line-indent
    - text DiffText
    - line I64

. bounds = text.lines[line]
. indent I64
for index in bounds.start .. < bounds.end
    . byte = text.bytes[index]
    if byte == 32
        indent += 1
    else if byte == 9
        indent += 8 - indent % 8
    else if byte != 10 && byte != 13 && byte != 11 && byte != 12
        = indent
    if indent >= diff-indent-limit
        = diff-indent-limit
= -1

━━━━━━━━━━━━━━━━━━━━
_ do diff-lines-same
    - text DiffText
    - left I64
    - right I64

. first = text.lines[left]
. second = text.lines[right]
. count = first.end - first.start
=? false if first.hash != second.hash || count != second.end - second.start
for offset in 0 .. < count
    =? false if text.bytes[first.start + offset] != text.bytes[second.start + offset]
= true

━━━━━━━━━━━━━━━━━━━━
_ DiffWork is Struct

+ old-start I64
+ old-end I64
+ new-start I64
+ new-end I64

━━━━━━━━━━━━━━━━━━━━
_ DiffSplit is (old-index I64, new-index I64)

━━━━━━━━━━━━━━━━━━━━
_ DiffBuilder

+ old-text DiffText
+ new-text DiffText

_ runs := ArrayBuilder'DiffRun()
_ old-changed Bool[]
_ new-changed Bool[]
_ old-pairs I64[]
_ new-pairs I64[]
_ forward I64[]
_ reverse I64[]
_ row-count I64
_ additions I64
_ deletions I64
_ first-change I64 = -1

────────────────────
+ This
    - old-text
    - new-text

.. capacity = old-text.lines.length + new-text.lines.length + 5
.. forward = I64[capacity]
.. reverse = I64[capacity]
.. old-changed = Bool[old-text.lines.length]
.. new-changed = Bool[new-text.lines.length]
.. old-pairs = I64[old-text.lines.length]
.. new-pairs = I64[new-text.lines.length]
old-pairs[0 .. < old-pairs.length].fill(-1)
new-pairs[0 .. < new-pairs.length].fill(-1)

────────────────────
+ do build

. is-binary = old-text.is-binary || new-text.is-binary
if is-binary
    emit(.notice, 0, 0, 1)
else
    mark-changes()
    diff-compact(old-text, old-changed, new-changed)
    diff-compact(new-text, new-changed, old-changed)
    emit-changes()
if row-count == 0
    emit(.notice, 0, 0, 1)
. completed = runs.finish-immutable()
. is-identical = is-binary && diff-same-bytes(old-text.bytes, new-text.bytes)
= DiffDocument
    - old-text
    - new-text
    - completed
    - row-count
    - additions
    - deletions
    - first-change
    - diff-hunks(completed, row-count)
    - old-pairs.immutable
    - new-pairs.immutable
    - is-identical

────────────────────
_ do mark-changes

. pending = List'DiffWork()
pending += DiffWork(0, old-text.lines.length, 0, new-text.lines.length)
while pending.length > 0
    . last = pending.length - 1
    . work = pending[last]
    pending.remove(last)
    . a = work.old-start
    . b = work.new-start
    while a < work.old-end && b < work.new-end && same-line(a, b)
        a += 1
        b += 1
    . a-end = work.old-end
    . b-end = work.new-end
    while a < a-end && b < b-end && same-line(a-end - 1, b-end - 1)
        a-end -= 1
        b-end -= 1
    if a == a-end
        diff-mark(new-changed, b, b-end)
    else if b == b-end
        diff-mark(old-changed, a, a-end)
    else
        . split = bisect(a, a-end, b, b-end)
        if split && split != DiffSplit(a, b) && split != DiffSplit(a-end, b-end)
            pending += DiffWork(split.old-index, a-end, split.new-index, b-end)
            pending += DiffWork(a, split.old-index, b, split.new-index)
        else
            diff-mark(old-changed, a, a-end)
            diff-mark(new-changed, b, b-end)

────────────────────
_ do emit-changes

. old-count = old-text.lines.length as I64
. new-count = new-text.lines.length as I64
. a I64
. b I64
while a < old-count || b < new-count
    . old-start = a
    . new-start = b
    while a < old-count && old-changed[a]
        a += 1
    emit(.deleted, old-start, b, a - old-start)
    while b < new-count && new-changed[b]
        b += 1
    emit(.inserted, a, new-start, b - new-start)
    if a > old-start && b > new-start
        pair-lines(old-start, a, new-start, b)
    . equal-old = a
    . equal-new = b
    while a < old-count && b < new-count && !old-changed[a] && !new-changed[b]
        a += 1
        b += 1
    emit(.equal, equal-old, equal-new, a - equal-old)
    ?! Panic("Diff sides lost alignment")
        if a == old-start && b == new-start

────────────────────
_ do pair-lines
    - old-start Index
    - old-end Index
    - new-start Index
    - new-end Index

if (old-end - old-start) * (new-end - new-start) <= diff-pair-limit
    pair-similar(old-start, old-end - old-start, new-start, new-end - new-start)
. a = old-start
. b = new-start
while a < old-end || b < new-end
    while a < old-end && b < new-end && old-pairs[a] < 0 && new-pairs[b] < 0
        pair(a, b)
        a += 1
        b += 1
    while a < old-end && old-pairs[a] < 0
        a += 1
    while b < new-end && new-pairs[b] < 0
        b += 1
    if a < old-end
        a += 1
        b += 1

────────────────────
_ do pair-similar
    - old-start Index
    - rows Index
    - new-start Index
    - columns Index

. left [[DiffToken]]
for row in 0 .. < rows
    left += diff-line-tokens(old-text, old-start + row)
. right [[DiffToken]]
for column in 0 .. < columns
    right += diff-line-tokens(new-text, new-start + column)
. width = columns + 1
. similar = Bool[rows * columns]
. best = I64[(rows + 1) * width]
. row = rows
while row > 0
    row -= 1
    . column = columns
    while column > 0
        column -= 1
        . cell = row * width + column
        . changes = diff-token-changes(old-text.bytes, left[row], new-text.bytes, right[column])
        . is-similar = changes != null
        similar[row * columns + column] = is-similar
        best[cell] = max(best[cell + width], best[cell + 1])
        if is-similar && best[cell + width + 1] + 1 > best[cell]
            best[cell] = best[cell + width + 1] + 1
. a Index = 0
. b Index = 0
while a < rows && b < columns
    . cell = a * width + b
    if similar[a * columns + b] && best[cell] == best[cell + width + 1] + 1
        pair(old-start + a, new-start + b)
        a += 1
        b += 1
    else if best[cell + width] >= best[cell + 1]
        a += 1
    else
        b += 1

────────────────────
_ do pair
    - old-line Index
    - new-line Index

old-pairs[old-line] = new-line
new-pairs[new-line] = old-line

────────────────────
_ do emit
    - kind DiffKind
    - old-start I64
    - new-start I64
    - count I64

=? if count == 0
if kind != DiffKind.equal && first-change < 0
    first-change = row-count
row-count += count
if kind == DiffKind.inserted
    additions += count
if kind == DiffKind.deleted
    deletions += count
if runs.length > 0
    . index = runs.length - 1
    . previous = runs[index]
    if previous.kind == kind
        runs[index] = DiffRun
            - kind
            - previous.old-start
            - previous.new-start
            - previous.count + count
            - row-count
        =
runs.append(DiffRun(kind, old-start, new-start, count, row-count))

────────────────────
_ do same-line
    - a I64
    - b I64

. old = old-text.lines[a]
. new = new-text.lines[b]
. count = old.end - old.start
=? false if old.hash != new.hash || count != new.end - new.start
for offset in 0 .. < count
    =? false if old-text.bytes[old.start + offset] != new-text.bytes[new.start + offset]
= true

────────────────────
_ do bisect
    - a I64
    - a-end I64
    - b I64
    - b-end I64

. n = a-end - a
. m = b-end - b
. maximum-depth = (n + m + 1) / 2
. origin = maximum-depth + 1
. length = (2 * maximum-depth + 3) as Size
forward[0 .. < length].fill(-1)
reverse[0 .. < length].fill(-1)
forward[origin + 1] = 0
reverse[origin + 1] = 0
. delta = n - m
. odd = delta % 2 != 0
. forward-start I64
. forward-end I64
. reverse-start I64
. reverse-end I64
. task = get-active-task()
for depth in 0 .. maximum-depth
    check-task-cancelation(task.is-cancel-in-force)
    . diagonal = -depth + forward-start
    while diagonal <= depth - forward-end
        . index = (origin + diagonal) as Index
        . x I64
        if diagonal == -depth || (diagonal != depth && forward[index - 1] < forward[index + 1])
            x = forward[index + 1]
        else
            x = forward[index - 1] + 1
        . y = x - diagonal
        while x < n && y < m && same-line(a + x, b + y)
            x += 1
            y += 1
        forward[index] = x
        if x > n
            forward-end += 2
        else if y > m
            forward-start += 2
        else if odd
            . other = origin + delta - diagonal
            if other >= 0 && other < length as I64 && reverse[other] >= 0
                =? DiffSplit(a + x, b + y) if x >= n - reverse[other]
        diagonal += 2
    diagonal = -depth + reverse-start
    while diagonal <= depth - reverse-end
        . index = (origin + diagonal) as Index
        . x I64
        if diagonal == -depth || (diagonal != depth && reverse[index - 1] < reverse[index + 1])
            x = reverse[index + 1]
        else
            x = reverse[index - 1] + 1
        . y = x - diagonal
        while x < n && y < m && same-line(a-end - x - 1, b-end - y - 1)
            x += 1
            y += 1
        reverse[index] = x
        if x > n
            reverse-end += 2
        else if y > m
            reverse-start += 2
        else if !odd
            . other = origin + delta - diagonal
            if other >= 0 && other < length as I64 && forward[other] >= 0
                . front = forward[other]
                =? DiffSplit(a + front, b + front - delta + diagonal) if front >= n - x
        diagonal += 2
= null
