_ DiffToken is Struct

+ start Index
+ end Index
+ is-space Bool

━━━━━━━━━━━━━━━━━━━━
_ DiffByteClass is Union

| space
| word
| mark

━━━━━━━━━━━━━━━━━━━━
_ diff-words
    - old-text DiffText
    - old-line Index
    - new-text DiffText
    - new-line Index
    - is-old Bool

|? changes == null
    null
|? is-old
    diff-word-ranges(old-text.bytes, left, changes.old-changed)
??
    diff-word-ranges(new-text.bytes, right, changes.new-changed)

.. left = diff-line-tokens(old-text, old-line)
.. right = diff-line-tokens(new-text, new-line)
.. changes = diff-token-changes(old-text.bytes, left, new-text.bytes, right)

━━━━━━━━━━━━━━━━━━━━
_ DiffTokenChanges is (old-changed Bool[], new-changed Bool[])

━━━━━━━━━━━━━━━━━━━━
_ do diff-token-changes
    - old-bytes Byte[]
    - left [DiffToken]
    - new-bytes Byte[]
    - right [DiffToken]

. shared = min(left.length, right.length)
. head Index = 0
while head < shared && diff-token-same(old-bytes, left[head], new-bytes, right[head])
    head += 1
. tail Index = 0
while tail < shared - head
    . old-token = left[left.length - tail - 1]
    . new-token = right[right.length - tail - 1]
    if !diff-token-same(old-bytes, old-token, new-bytes, new-token)
        break
    tail += 1
. rows = left.length - head - tail
. columns = right.length - head - tail
=? null if rows * columns > diff-word-limit
. width = columns + 1
. best = I64[(rows + 1) * width]
for row in 1 .. < rows + 1
    for column in 1 .. < columns + 1
        . token = left[head + row - 1]
        . cell = row * width + column
        if diff-token-same(old-bytes, token, new-bytes, right[head + column - 1])
            best[cell] = best[cell - width - 1] + ((token.end - token.start) as I64)
        else
            best[cell] = max(best[cell - width], best[cell - 1])
. old-changed = Bool[left.length]
. new-changed = Bool[right.length]
. row = rows
. column = columns
while row > 0 || column > 0
    if row > 0 && column > 0
        . old-token = left[head + row - 1]
        . new-token = right[head + column - 1]
        if diff-token-same(old-bytes, old-token, new-bytes, new-token)
            row -= 1
            column -= 1
            continue
    . cell = row * width + column
    if column == 0 || (row > 0 && best[cell - width] >= best[cell - 1])
        old-changed[head + row - 1] = true
        row -= 1
    else
        new-changed[head + column - 1] = true
        column -= 1
. same = diff-unchanged-bytes(left, old-changed) + diff-unchanged-bytes(right, new-changed)
. total = diff-text-bytes(left) + diff-text-bytes(right)
=? null if 4 * same < total
= DiffTokenChanges(old-changed, new-changed)

━━━━━━━━━━━━━━━━━━━━
