━━━━━━━━━━━━━━━━━━━━
_ do diff-hunks
    - runs ImmutableArray'DiffRun
    - row-count I64

. result = ArrayBuilder'DiffHunk()
. start I64 = -1
. end I64
. display-end I64
for run in runs
    if !diff-is-change(run.kind)
        continue
    . next-start = run.row-end - run.count - 3
    if next-start < 0
        next-start = 0
    . next-end = run.row-end + 3
    if next-end > row-count
        next-end = row-count
    if start < 0
        start = next-start
    else if next-start > end + 1
        display-end += end - start + (if result.length > 0 then 1 else 0)
        result.append(DiffHunk(start, end, display-end))
        start = next-start
    end = next-end
if start >= 0
    display-end += end - start + (if result.length > 0 then 1 else 0)
    result.append(DiffHunk(start, end, display-end))
= result.finish-immutable()

