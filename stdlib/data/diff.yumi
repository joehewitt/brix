━━━━━━━━━━━━━━━━━━━━
+ DiffText

+ bytes Byte[]
+ lines ImmutableArray'DiffLine
+ maximum-line-bytes Size
+ is-binary Bool

────────────────────
+ This
    - bytes

. indexed = ArrayBuilder'DiffLine()
. start Index = 0
. hash = 2166136261u32
for index in 0 .. < bytes.length
    . byte = bytes[index]
    if byte == 0
        is-binary = true
    hash = (hash /xor/ (byte as U32)) * 16777619
    if byte == 10
        indexed.append(DiffLine(start, index + 1, hash))
        if index + 1 - start > maximum-line-bytes
            maximum-line-bytes = index + 1 - start
        start = index + 1
        hash = 2166136261
if start < bytes.length
    indexed.append(DiffLine(start, bytes.length, hash))
    if bytes.length - start > maximum-line-bytes
        maximum-line-bytes = bytes.length - start
lines = indexed.finish-immutable()
if !is-binary && bytes.length > 0
    is-binary = C:brixStringValidateUtf8(bytes.data, bytes.length) != 0

────────────────────
+ line-text
    - index Index

if is-terminated(index) then text else "$text  ⟪no newline⟫"

.. text = bytes.slice-string(lines[index].start .. < content-end(index))

────────────────────
+ is-terminated
    - index Index

lines[index].end > lines[index].start && bytes[lines[index].end - 1] == 10

────────────────────
+ do content-end
    - index Index

. line = lines[index]
. end = line.end
if end > line.start && bytes[end - 1] == 10
    end -= 1
    if end > line.start && bytes[end - 1] == 13
        end -= 1
= end

