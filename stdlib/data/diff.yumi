. none [Range'Index]
. pair = paired-line(is-old, line)
=? none if pair == null
. old-line = if is-old then line else pair
. new-line = if is-old then pair else line
= diff-words(old-text, old-line, new-text, new-line, is-old) ?? none

────────────────────
+ do line-changes

. changes [DiffLineChange]
=? changes if old-text.is-binary || new-text.is-binary
. index Index = 0
while index < runs.length
    . first = runs[index]
    if !diff-is-change(first.kind)
        index += 1
        continue
    . old-line = first.old-start
    . old-end = first.old-start
    . new-end = first.new-start
    while index < runs.length && diff-is-change(runs[index].kind)
        . run = runs[index]
        if run.kind == DiffKind.inserted
            new-end = run.new-start + run.count
        else
            old-end = run.old-start + run.count
        index += 1
    for line in first.new-start .. < new-end
        . pair = paired-line(false, line)
        if pair != null && (pair as I64) > old-line
            changes += DiffLineChange(.deleted, line, 0)
        if pair != null
            old-line = (pair as I64) + 1
        . kind = if pair != null then DiffLineChangeKind.modified else DiffLineChangeKind.inserted
        if changes.length > 0 && diff-change-extends(changes[changes.length - 1], kind, line)
            . last = changes[changes.length - 1]
            changes[changes.length - 1] = DiffLineChange(kind, last.line, last.count + 1)
        else
            changes += DiffLineChange(kind, line, 1)
    if old-line < old-end
        changes += DiffLineChange(.deleted, new-end, 0)
= changes

