(import ./sexp)
(import ./source-tree)
(import /core/arena)
(import /core/table)
(import /stream/aggregate)

(type + SexpRange (is Tuple)
  (prop + start Index)
  (prop + end Index)
)

(type + SexpMarks
  (prop + base U32)
  (prop + starts (list Index))
  (prop + ends (list Index))
  (fn-do + This _
    (param base _)
  )
  (fn-expr + start Index
    (param id U32)
    (if-expr (and (> id base) (< slot (. starts length))) ([] starts slot) 0)
    (where
      (lazy slot (as (- id base 1) Index))
    )
  )
  (fn-expr + end Index
    (param id U32)
    (if-expr (and (> id base) (< slot (. ends length))) ([] ends slot) 0)
    (where
      (lazy slot (as (- id base 1) Index))
    )
  )
  (fn-do + line-ids (list U32)
    (param text String)
    (param store SourceStore)
    (param roots (list U32))
    (let bytes (call byte-view text))
    (let starts (list Index))
    (+= starts 0)
    (for (in index (..< 0 (. bytes length)))
      (if (== ([] bytes index) 10)
        (+= starts (+ index 1))
      )
    )
    (let ids (call List (in 0u32 starts)))
    (for (in root roots)
      (call mark-lines store (call (. store node) root) starts ids)
    )
    (return ids)
  )
  (fn-do _ mark-lines _
    (param store SourceStore)
    (param node (of ImmutableTableRow SourceNode))
    (param starts (list Index))
    (param ids (list U32))
    (let first (call line-at starts (call start (. node id))))
    (if (== ([] ids first) 0)
      (= ([] ids first) (. node id))
    )
    (for (in item (call (. store items) node))
      (call mark-lines store item starts ids)
    )
    (for (in line (..< (+ first 1) (+ (call line-at starts (- (call end (. node id)) 1)) 1)))
      (if (== ([] ids line) 0)
        (= ([] ids line) (. node id))
      )
    )
  )
  (fn-do _ line-at Index
    (param starts (list Index))
    (param offset Index)
    (let low Index 0)
    (let high (. starts length))
    (while (< (+ low 1) high)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= ([] starts middle) offset)
        (= low middle)
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
)

(type + SexpLayout (is Interface)
  (fn-expr + header-count (? Int)
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-expr + wrapper (? String)
    (param node (of ImmutableTableRow SourceNode))
  )
  (fn-expr + is-apart Bool
    (param node (of ImmutableTableRow SourceNode))
  )
)

(fn-do + sexp-read (list U32) (?! SexpError)
  (param text String)
  (param store SourceStore)
  (param marks (? SexpMarks) (= null))
  (let scratch (use (call Arena)))
  (return (call (. (call SexpReader (call sexp-tape text scratch) store marks) read)))
)

(fn-expr + sexp-top-level-ranges (list SexpRange) (?! SexpError)
  (param text String)
  (call List (in (call SexpRange (call (. tape start) each) (call (. tape end) each)) (call (. tape forms))))
  (where
    (lazy scratch (use (call Arena)))
    (lazy tape (call sexp-tape text scratch))
  )
)

(type + SexpWritten (is Tuple)
  (prop + text String)
  (prop + ids (list U32))
  (prop + starts-apart Bool)
  (prop + ends-apart Bool)
  (prop + ends-comment Bool)
)

(fn-expr + sexp-text String
  (param store SourceStore)
  (param nodes (list (of ImmutableTableRow SourceNode)))
  (param layout SexpLayout)
  (. (call sexp-written store nodes layout null) text)
)

(fn-do + sexp-written SexpWritten
  (param store SourceStore)
  (param nodes (list (of ImmutableTableRow SourceNode)))
  (param layout SexpLayout)
  (param swap (? (of ImmutableTableRow SourceNode)))
  (let writer (call SexpWriter store layout swap))
  (let index Index 0)
  (let starts-apart false)
  (let follows-apart false)
  (while (< index (. nodes length))
    (let node ([] nodes index))
    (let wrap (call (. layout wrapper) node))
    (let is-apart (or (!= wrap null) (call (. layout is-apart) node)))
    (if (== index 0)
      (= starts-apart is-apart)
      (else-if (and (or is-apart follows-apart) (not (call (. store is-comment) ([] nodes (- index 1)))))
        (+= (. writer ids) 0)
        (+= (. writer parts) "\n")
      )
    )
    (= follows-apart is-apart)
    (if (== wrap null)
      (call (. writer write) node 0)
      (+= (. writer parts) "\n")
      (+= index 1)
      (continue)
    )
    (let last index)
    (let cursor (+ index 1))
    (while (< cursor (. nodes length))
      (let next ([] nodes cursor))
      (if (== (call (. layout wrapper) next) wrap)
        (= last cursor)
        (else-if (and (not (call (. store is-comment) next)) (not (call (. store is-blank) next)))
          (break)
        )
      )
      (+= cursor 1)
    )
    (+= (. writer ids) 0)
    (+= (. writer parts) (str "(" wrap))
    (for (in position (.. index last))
      (+= (. writer parts) "\n  ")
      (call (. writer write) ([] nodes position) 1)
    )
    (+= (. writer ids) 0)
    (+= (. writer parts) "\n)\n")
    (= index (+ last 1))
  )
  (let ends-comment (and (> (. nodes length) 0) (call (. store is-comment) ([] nodes (- (. nodes length) 1)))))
  (return (call SexpWritten (call (. "" join) (. writer parts)) (. writer ids) starts-apart follows-apart ends-comment))
)

(fn-do + sexp-nested-text String
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (param layout SexpLayout)
  (param depth Int)
  (let writer (call SexpWriter store layout null))
  (call (. writer write) node depth)
  (return (call (. "" join) (. writer parts)))
)

(fn-do + sexp-inline-text String
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (let writer (call SexpWriter store null null))
  (call (. writer write-inline) node)
  (return (call (. "" join) (. writer parts)))
)

(type _ SexpWriter
  (prop + parts (list String))
  (prop + ids (list U32))
  (blank)
  (prop _ store SourceStore)
  (prop _ layout (? SexpLayout))
  (prop _ swap (? (of ImmutableTableRow SourceNode)))
  (fn-do + This _
    (param store _)
    (param layout _)
    (param swap _)
  )
  (fn-do + write _
    (param item (of ImmutableTableRow SourceNode))
    (param depth Int)
    (let node (call shown item))
    (+= ids (. node id))
    (match node
      (case (call .list _ start count)
        (call write-list node ([] (. store nodes) (..< start (+ start count))) depth)
      )
      (default
        (call write-inline node)
      )
    )
  )
  (fn-do _ write-list _
    (param node (of ImmutableTableRow SourceNode))
    (param items (of ImmutableTableSpan SourceNode))
    (param depth Int)
    (let count (. items length))
    (let inline (?? (call header-count node) count))
    (if (> inline count)
      (= inline count)
    )
    (for (in index (..< 0 inline))
      (if (call breaks ([] items index))
        (= inline (if-expr (> index 0) index 1))
        (break)
      )
    )
    (+= parts "(")
    (for (in index (..< 0 inline))
      (if (> index 0)
        (+= parts " ")
      )
      (call write-inline ([] items index))
    )
    (if (>= inline count)
      (+= parts ")")
      (return)
    )
    (for (in index (..< inline count))
      (+= parts "\n")
      (+= parts (* "  " (+ depth 1)))
      (call write ([] items index) (+ depth 1))
    )
    (+= parts "\n")
    (+= parts (* "  " depth))
    (+= ids (. node id))
    (+= parts ")")
  )
  (fn-do + write-inline _
    (param item (of ImmutableTableRow SourceNode))
    (let node (call shown item))
    (match node
      (case (call .atom _ text)
        (+= parts text)
      )
      (case (call .string _ text)
        (+= parts (call sexp-quoted text))
      )
      (case (call .comment _ text)
        (+= parts (if-expr (> (. text length) 0) (str "; " text) ";"))
      )
      (case (call .list _ start count)
        (+= parts "(")
        (let first true)
        (for (in item ([] (. store nodes) (..< start (+ start count))))
          (if (not first)
            (+= parts " ")
          )
          (= first false)
          (call write-inline item)
        )
        (+= parts ")")
      )
    )
  )
  (fn-do _ breaks Bool
    (param item (of ImmutableTableRow SourceNode))
    (let node (call shown item))
    (match node
      (case (call .comment _ _)
        (return true)
      )
      (case (call .list _ start count)
        (let header (call header-count node))
        (return-if true (if (and (!= header null) (< header count))))
        (return (call some ([] (. store nodes) (..< start (+ start count))) (:where (call breaks each))))
      )
      (default
        (return false)
      )
    )
  )
  (fn-expr _ header-count (? Int)
    (param node (of ImmutableTableRow SourceNode))
    (call (?. layout header-count) node)
  )
  (fn-expr _ shown (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (if-expr (and (!= held null) (== (. held id) (. node id))) held node)
    (where
      (lazy held swap)
    )
  )
)

(type _ SexpReader
  (prop _ tape SexpTape)
  (prop _ bytes (of ImmutableArray Byte))
  (prop _ store SourceStore)
  (prop _ marks (? SexpMarks))
  (fn-do + This _
    (param tape _)
    (param store _)
    (param marks _)
    (lazy bytes (. tape bytes))
  )
  (fn-do + read (list U32) (?! SexpError)
    (let dollar (. tape first-dollar))
    (if dollar
      (throw
        (call SexpError
          (block
            (arg dollar)
            (arg
              (paragraph
                (str "Unescaped “\$” in the text at " (call sexp-place bytes dollar) ". Write “\\\$” for a dollar sign, or build the text from its parts with (str …)")
              )
            )
          )
        )
      )
    )
    (call (. store sync))
    (call (. store reserve) (+ (/ (. bytes length) 5) 16))
    (let forms (call List (in (call (. store root) (call node each)) (call (. tape forms)))))
    (call (. store sync))
    (return forms)
  )
  (fn-do _ node SourceNode
    (param index Index)
    (if (call (. tape is-open) index)
      (let base (. store held-count))
      (for (in child (call (. tape children) index))
        (call (. store hold) (call node child))
      )
      (call mark index)
      (return (call (. store close) base (call (. store next-id))))
    )
    (call mark index)
    (match (call (. tape kind) index)
      (case= .atom
        (return (call (. SourceNode atom) (call (. store next-id)) (call (. store name-of) bytes (call (. tape start) index) (call (. tape end) index))))
      )
      (case= .text
        (return
          (call (. SourceNode string)
            (block
              (arg (call (. store next-id)))
              (arg (call (. store name-of) bytes (+ (call (. tape start) index) 1) (- (call (. tape end) index) 1)))
            )
          )
        )
      )
      (case= .escaped-text
        (return (call (. SourceNode string) (call (. store next-id)) (call (. store name) (call (. tape text-value) index))))
      )
      (default
        (return (call comment index))
      )
    )
  )
  (fn-do _ mark _
    (param index Index)
    (let held marks)
    (if held
      (+= (. held starts) (call (. tape start) index))
      (+= (. held ends) (call (. tape end) index))
    )
  )
  (fn-do _ comment SourceNode
    (param index Index)
    (let first (call (. tape start) index))
    (let last (call (. tape end) index))
    (while (and (< first last) (== ([] bytes first) 59))
      (+= first 1)
    )
    (if (and (< first last) (== ([] bytes first) 32))
      (+= first 1)
    )
    (return (call (. SourceNode comment) (call (. store next-id)) (call (. store name-of) bytes first last)))
  )
)
