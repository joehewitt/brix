────────────────────
+ do write Size
    - bytes Byte[]
    - size Size

. limit = cursor + size

?! Panic("Data stream size exceeded")
    if limit < cursor

if limit > this.data.size
    . doubled = this.data.size * 2
    this.data = this.data.resize(if doubled > limit then doubled else limit)

if limit > length
    length = limit

this.data[cursor .. < cursor + size] = bytes
cursor += size

= size

────────────────────
_ do read-bytes Size
    - size Size
    - receiver Byte[]

. token-size = size / Value.size
. byte-data = this.data as CPointer'Byte
if cursor >= length
    = 0
else if cursor + token-size > length
    . amt = (length - cursor) * Value.size
    . byte-cursor = cursor * Value.size
    do C:yumiArrayCopySlice(receiver, byte-data + byte-cursor, amt)
    cursor = length
    = amt
 else
    . byte-cursor = cursor * Value.size
    do C:yumiArrayCopySlice(receiver, byte-data + byte-cursor, size)
    cursor += token-size
    = size

────────────────────
_ do skip-bytes Size
    - size Size

. token-size = size / Value.size
if cursor >= length
    = 0
else if cursor + token-size > length
    . amt = (length - cursor) * Value.size
    cursor = length
    = amt * Value.size
 else
    cursor += token-size
    = size
