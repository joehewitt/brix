`benchmark.meta description: Builds deterministic HTTP requests, parses their JSON bodies, and echoes JSON responses.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gc-runtime,allocator,compile-timing

/BxCore/BxCore.h
/data/json
/data/stream
/net/http
/net/url

. request-count = 4000
. endpoint = URL("http://bench.local/v1/items")
. checksum = 0 as Size

for index in 0 .. < request-count
    . body = request-body(index)
    . request = HTTPRequest(HTTPMethod.post, endpoint)
        • headers
            * "Content-Type", "application/json"
            * "X-Bench-Lane", "${index % 17}"
        • body body
    . wire = DataStream'Byte()
    write-http-message(wire, request.start-line, request.headers, request.body)
    . root = JSON(request.text) as [String = JSON]
    . values = root["values"]! as [JSON]
    . echoed = to-json(root)
    . request-id = root["request"]! as Int
    . name = root["name"]! as String

    checksum += wire.length * ((index % 5) + 1)
    checksum += echoed.length + request-id + name.length + values.length

C:brixBenchCollect()

-- "bench-result data/http-json-churn checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ " request-body
    - index Int

{
    "request": $index,
    "route": "/v1/items/${index % 17}",
    "name": "item-$index",
    "values": [$index, ${index + 1}, ${index + 2}, ${index + 3}],
    "flags": {"active": true, "retry": false}
}
