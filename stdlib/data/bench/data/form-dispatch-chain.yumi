`benchmark.meta description: Dispatches union list forms by head and arity through a 40-branch if/else-if chain.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

. nodes = form-dispatch-chain-nodes()
. checksum = 0 as Size
for iteration in 0 .. < 300000
    for node in nodes
        checksum += form-dispatch-chain(node)

-- "bench-result data/form-dispatch-chain checksum=$checksum"

_ form-dispatch-chain-heads List
    * "import"
    * "export"
    * "let"
    * "set"
    * "return"
    * "yield"
    * "if"
    * "else-if"
    * "else"
    * "while"
    * "for"
    * "break"
    * "continue"
    * "match"
    * "case"
    * "default"
    * "block"
    * "inline"
    * "call"
    * "index"
    * "member"
    * "lambda"
    * "tuple"
    * "list"
    * "map"
    * "range"
    * "cast"
    * "is"
    * "not"
    * "and"
    * "or"
    * "pattern"
    * "catch"
    * "throw"
    * "finally"
    * "use"
    * "fn"
    * "type"
    * "style"
    * "content"
    * "missing"
    * "absent"
    * "unknown-head"
    * "x"

━━━━━━━━━━━━━━━━━━━━
_ FormChainNode is Union

| atom(id U64, text String)
| string(id U64, text String)
| comment(id U64, text String)
| list(id U64, items [FormChainNode])

────────────────────
+ get text String

match this
    | .atom(_, text)
        text
    | .string(_, text)
        text
    | .comment(_, text)
        text
    | .list(_, _)
        ""

────────────────────
+ get items [FormChainNode]

match this
    | .list(_, items)
        items
    ??
        List'FormChainNode()

────────────────────
+ get is-list Bool

this is .list

────────────────────
+ get is-comment Bool

this is .comment

────────────────────
+ get head String?

match? this
    | .list(_, [.atom(_, name), ...])
        name

━━━━━━━━━━━━━━━━━━━━
_ do form-dispatch-chain-nodes [FormChainNode]

. nodes [FormChainNode]
. sizes = [2, 3, 3, 1]
for index in 0 .. < form-dispatch-chain-heads.length
    . items [FormChainNode]
    items += FormChainNode.atom(0, form-dispatch-chain-heads[index])
    for slot in 1 .. < sizes[index % 4]
        items += FormChainNode.atom(0, "arg")
    nodes += FormChainNode.list(0, items)
nodes += FormChainNode.comment(0, "note")
nodes += FormChainNode.atom(0, "word")
= nodes

━━━━━━━━━━━━━━━━━━━━
_ do form-dispatch-chain Size
    - node FormChainNode

=? 1000 if node.is-comment
=? 2000 if !node.is-list
. items = node.items
. count = items.length
. head = node.head ?? ""
if head == "import" && count == 2
    = 1 + items[1].text.length
else if head == "export" && count >= 2
    = 2 + items[1].text.length
else if head == "let" && count == 3
    = 3 + items[1].text.length + items[2].text.length
else if head == "set"
    = 4
else if head == "return" && count == 2
    = 5 + items[1].text.length
else if head == "yield" && count >= 2
    = 6 + items[1].text.length
else if head == "if" && count == 3
    = 7 + items[1].text.length + items[2].text.length
else if head == "else-if"
    = 8
else if head == "else" && count == 2
    = 9 + items[1].text.length
else if head == "while" && count >= 2
    = 10 + items[1].text.length
else if head == "for" && count == 3
    = 11 + items[1].text.length + items[2].text.length
else if head == "break"
    = 12
else if head == "continue" && count == 2
    = 13 + items[1].text.length
else if head == "match" && count >= 2
    = 14 + items[1].text.length
else if head == "case" && count == 3
    = 15 + items[1].text.length + items[2].text.length
else if head == "default"
    = 16
else if head == "block" && count == 2
    = 17 + items[1].text.length
else if head == "inline" && count >= 2
    = 18 + items[1].text.length
else if head == "call" && count == 3
    = 19 + items[1].text.length + items[2].text.length
else if head == "index"
    = 20
else if head == "member" && count == 2
    = 21 + items[1].text.length
else if head == "lambda" && count >= 2
    = 22 + items[1].text.length
else if head == "tuple" && count == 3
    = 23 + items[1].text.length + items[2].text.length
else if head == "list"
    = 24
else if head == "map" && count == 2
    = 25 + items[1].text.length
else if head == "range" && count >= 2
    = 26 + items[1].text.length
else if head == "cast" && count == 3
    = 27 + items[1].text.length + items[2].text.length
else if head == "is"
    = 28
else if head == "not" && count == 2
    = 29 + items[1].text.length
else if head == "and" && count >= 2
    = 30 + items[1].text.length
else if head == "or" && count == 3
    = 31 + items[1].text.length + items[2].text.length
else if head == "pattern"
    = 32
else if head == "catch" && count == 2
    = 33 + items[1].text.length
else if head == "throw" && count >= 2
    = 34 + items[1].text.length
else if head == "finally" && count == 3
    = 35 + items[1].text.length + items[2].text.length
else if head == "use"
    = 36
else if head == "fn" && count == 2
    = 37 + items[1].text.length
else if head == "type" && count >= 2
    = 38 + items[1].text.length
else if head == "style" && count == 3
    = 39 + items[1].text.length + items[2].text.length
else if head == "content"
    = 40
= 0
