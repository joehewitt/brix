`benchmark.meta description: Writes one JSON document of 5,000 nested records with strings, escapes, ints, floats and nulls.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

/data/json

. records [JSON] = <* index in 0 .. < 5000
    record(index) as JSON
. document = Map'String'JSON
    • "version" 3 as JSON
    • "records" records as JSON
. text = to-json(document)
-- "bench-result data/json-write checksum=${text.size}"

━━━━━━━━━━━━━━━━━━━━
_ record [String = JSON]
    - index Size

Map'String'JSON
    • "id" index as JSON
    • "name" "user-$index" as JSON
    • "path" "stdlib/core/tests/runRecords${index}.test" as JSON
    • "active" (index % 3 == 0) as JSON
    • "score" ((index as Float) + 0.25) as JSON
    • "tags" ["alpha" as JSON, "beta" as JSON, "g$index" as JSON] as JSON
    • "address" address(index) as JSON
    • "bio" "Line one\nLine \"two\" été 😀\t$index" as JSON
    • "parent" null as JSON

━━━━━━━━━━━━━━━━━━━━
_ address [String = JSON]
    - index Size

Map'String'JSON
    • "street" "$index Main St" as JSON
    • "city" "Springfield" as JSON
    • "geo" [(index % 180) as JSON, (index % 90) as JSON] as JSON
