`benchmark.meta description: Reads a long stream of short JSON Lines from a source that never holds the whole input.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gc-runtime,allocator,compile-timing

/YuCore/YuCore.h
/core/_bytes
/core/arena
/data
/data/json
/data/jsonl

_ pipe-capacity Size = 65536

. source = LineSource(100000)
. checksum = 0 as Size

. scratch = use Arena()
for value in source ~> \json-line with JSONParser(scratch)
    checksum += (value as [String = JSON]).length

C:yumiBenchCollect()

-- "bench-result data/json-lines-long-stream checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ LineSource
    is ReadableData'Char

+ remaining Size
+ pending = Byte[0]
+ pending-cursor Index

────────────────────
_ This
    - remaining

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

. wanted = if size < pipe-capacity then size else pipe-capacity
. written Size = 0
while written < wanted
    if pending-cursor == pending.size
        if remaining == 0
            break
        remaining -= 1
        pending = byte-view("{\"type\": \"delta\", \"index\": $remaining, \"text\": \"chunk alpha beta\"}\n")
        pending-cursor = 0
    . available = pending.size - pending-cursor
    . room = wanted - written
    . amount = if available < room then available else room
    buffer[written .. < written + amount] = pending[pending-cursor .. < pending-cursor + amount]
    written += amount
    pending-cursor += amount
= written
