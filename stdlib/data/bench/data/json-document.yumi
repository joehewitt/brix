`benchmark.meta description: Parses one 1.7 MB JSON document of 5,000 nested records with strings, escapes, ints and floats.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

/data/json

. text = json-document(5000)
. value = JSON(text)
-- "bench-result data/json-document checksum=${json-weight(value)}"

━━━━━━━━━━━━━━━━━━━━
_ json-document String
    - count Size

"{\"version\": 3, \"generated\": \"2026-11-11T00:00:00Z\", \"records\": [\n${",\n".join(record(each) in 0 .. < count)}\n]}"

━━━━━━━━━━━━━━━━━━━━
_ record String
    - index Size

"  {\"id\": $index, \"name\": \"user-$index\", \"email\": \"user$index@example.com\", \"active\": ${if index % 3 == 0 then "true" else "false"}, \"score\": $index.25, \"ratio\": -0.${index % 97}e-3, \"tags\": [\"alpha\", \"beta\", \"g$index\"], \"address\": {\"street\": \"${index} Main St\", \"city\": \"Springfield\", \"zip\": \"0${index % 9999}\", \"geo\": [${index % 180}.5, -${index % 90}.25]}, \"bio\": \"Line one\\nLine \\\"two\\\" \\u00e9t\\u00e9 \\ud83d\\ude00\", \"parent\": null}"

━━━━━━━━━━━━━━━━━━━━
_ do json-weight Size
    - value JSON

match value
    | text String
        = text.length
    | list [JSON]
        . sum = 1 as Size
        for item in list
            sum += json-weight(item)
        = sum
    | map [String = JSON]
        . sum = 1 as Size
        for key, item in map
            sum += key.length + json-weight(item)
        = sum
    | number Int
        = (number as Size) % 1000
    | number Float
        = if number < 0.0 then 2 else 3
    | flag Bool
        = if flag then 5 else 7
    ??
        = 1
