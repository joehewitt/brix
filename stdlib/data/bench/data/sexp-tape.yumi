`benchmark.meta description: Scans a generated Brix-shaped S-expression document into a token tape and reads locations along it.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core/arena
/data/sexp

. checksum = catch sexp-tape-run()
match checksum
    | error Error
        -- "data/sexp-tape failed: ${error.message}"
    | value Size
        -- "bench-result data/sexp-tape checksum=$value"

━━━━━━━━━━━━━━━━━━━━
_ do sexp-tape-run Size ?! Error

. source = sexp-tape-source(4000)
. arena = Arena()
. checksum Size = 0
for iteration in 0 .. < 40
    . tape = sexp-tape(source, arena, iteration % 2 == 0)
    checksum += tape.length + tape.line-count
    . index Index = 0
    while index < tape.length
        checksum += tape.location(tape.start(index)).column as Size
        index = tape.after(index)
    arena.reset()
arena.release()
= checksum

━━━━━━━━━━━━━━━━━━━━
_ sexp-tape-source String
    - count Size

"".join(sexp-tape-unit(each) in 0 .. < count)

━━━━━━━━━━━━━━━━━━━━
_ ¶ sexp-tape-unit
    - index Size

(fn + work-$index Int :do
  (param first Int)
  (param second Int (= $index))
  (let total (+ first (* second $index)))
  ; keep the total under $index
  (while (< total $index)
    (+= total 1)
    (if (> total 10)
      (return total)
    )
  )
  (call (. names append) (str "work " total " µs") (:at 0))
  (blank)
  (return (?? (only-if total (if (!= total 0))) "none\\n"))
)${"\n"}
