`benchmark.meta description: Reads a field shared by every union case through a getter written as a match.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing,allocator

. nodes = union-field-match-nodes()
. checksum U64
for iteration in 0 .. < 400000
    for node in nodes
        checksum += node.key

-- "bench-result data/union-field-match checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ UnionFieldMatchNode is Union

| atom(id U64, text String)
| string(id U64, text String)
| comment(id U64, text String)
| list(id U64, items [UnionFieldMatchNode])

────────────────────
+ get key U64

match this
    | .atom(id, _)
        id
    | .string(id, _)
        id
    | .comment(id, _)
        id
    | .list(id, _)
        id

━━━━━━━━━━━━━━━━━━━━
_ do union-field-match-nodes [UnionFieldMatchNode]

. nodes [UnionFieldMatchNode]
for index in 0 .. < 1000
    . id = index as U64
    if index % 4 == 0
        nodes += UnionFieldMatchNode.atom(id, "atom")
    else if index % 4 == 1
        nodes += UnionFieldMatchNode.string(id, "string")
    else if index % 4 == 2
        nodes += UnionFieldMatchNode.comment(id, "comment")
    else
        nodes += UnionFieldMatchNode.list(id, List'UnionFieldMatchNode())
= nodes
