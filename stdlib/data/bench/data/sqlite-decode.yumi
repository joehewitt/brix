`benchmark.meta description: Decodes 2,000 rows of five typed columns from an in-memory SQLite table into tuples, 200 times.
`benchmark.meta timing: recommended
`benchmark.meta profiles: timing

/data/sqlite

. db = use SQLite(":memory:")
db.execute-script("create table people (name text not null, age integer not null, email text, score real not null, active integer not null)")
db.execute-script("insert into people with recursive n(i) as (select 1 union all select i + 1 from n where i < 2000) select 'person ' || i, i % 90, case when i % 3 = 0 then null else 'p' || i || '@example.com' end, i * 0.5, i % 2 from n")

. checksum = 0 as I64
for _ in 0 .. < 200
    for person in db.query("select name, age, email, score, active from people", :: row => Person(row.string(0), row.int(1), row.optional-string(2), row.real(3), row.bool(4)))
        checksum += person.age + (person.name.length as I64) + (person.score as I64)
        if person.email != null
            checksum += 1
        if person.is-active
            checksum += 1

-- "bench-result data/sqlite-decode checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ Person is Tuple

+ name String
+ age I64
+ email String?
+ score F64
+ is-active Bool
