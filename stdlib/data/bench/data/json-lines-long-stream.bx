; benchmark.meta description: Reads a long stream of short JSON Lines from a source that never holds the whole input.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gc-runtime,allocator,compile-timing
(blank)
(import /BxCore/BxCore.h)
(import /core/arena)
(import /data)
(import /data/json)
(import /data/jsonl)
(blank)
(prop _ pipe-capacity Size (= 65536))
(blank)

(main
  (let source (call LineSource 100000))
  (let checksum (as 0 Size))
  (blank)
  (let scratch (use (call Arena)))
  (for (in value (~> source \json-line (with (call JSONParser scratch))))
    (+= checksum (. (as value (map String JSON)) length))
  )
  (blank)
  (call C:brixBenchCollect)
  (blank)
  (print (str "bench-result data/json-lines-long-stream checksum=" checksum))
)

(type _ LineSource
  (implements (of ReadableData Char))
  (prop + remaining Size)
  (prop + pending _ (= (call (of ImmutableArray Byte))))
  (prop + pending-cursor Index)
  (fn-do _ This _
    (param remaining _)
  )
  (fn-do + read Size
    (param size Size)
    (param buffer ([] Byte))
    (let wanted (if-expr (< size pipe-capacity) size pipe-capacity))
    (let written Size 0)
    (while (< written wanted)
      (if (== pending-cursor (. pending size))
        (if (== remaining 0)
          (break)
        )
        (-= remaining 1)
        (= pending
          (call byte-view
            (block
              (arg (str "{\"type\": \"delta\", \"index\": " remaining ", \"text\": \"chunk alpha beta\"}\n"))
            )
          )
        )
        (= pending-cursor 0)
      )
      (let available (- (. pending size) pending-cursor))
      (let room (- wanted written))
      (let amount (if-expr (< available room) available room))
      (= ([] buffer (..< written (+ written amount))) ([] pending (..< pending-cursor (+ pending-cursor amount))))
      (+= written amount)
      (+= pending-cursor amount)
    )
    (return written)
  )
)
