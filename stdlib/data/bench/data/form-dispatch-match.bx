; benchmark.meta description: Dispatches union list forms by head and arity through a 40-arm structural match table.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)

(main
  (let nodes (call form-dispatch-match-nodes))
  (let checksum (as 0 Size))
  (for (in iteration (..< 0 300000))
    (for (in node nodes)
      (+= checksum (call form-dispatch-match node))
    )
  )
  (blank)
  (print (str "bench-result data/form-dispatch-match checksum=" checksum))
)

(blank)
(prop _ form-dispatch-match-heads List
  (block
    (item "import")
    (item "export")
    (item "let")
    (item "set")
    (item "return")
    (item "yield")
    (item "if")
    (item "else-if")
    (item "else")
    (item "while")
    (item "for")
    (item "break")
    (item "continue")
    (item "match")
    (item "case")
    (item "default")
    (item "block")
    (item "inline")
    (item "call")
    (item "index")
    (item "member")
    (item "lambda")
    (item "tuple")
    (item "list")
    (item "map")
    (item "range")
    (item "cast")
    (item "is")
    (item "not")
    (item "and")
    (item "or")
    (item "pattern")
    (item "catch")
    (item "throw")
    (item "finally")
    (item "use")
    (item "fn")
    (item "type")
    (item "style")
    (item "content")
    (item "missing")
    (item "absent")
    (item "unknown-head")
    (item "x")
  )
)

(type _ FormMatchNode (is Union)
  (variant atom (tuple (: id U64) (: text String)))
  (variant string (tuple (: id U64) (: text String)))
  (variant comment (tuple (: id U64) (: text String)))
  (variant list (tuple (: id U64) (: items (list FormMatchNode))))
  (fn-expr + text String :get
    (match this
      (case (call .atom _ text)
        text
      )
      (case (call .string _ text)
        text
      )
      (case (call .comment _ text)
        text
      )
      (case (call .list _ _)
        ""
      )
    )
  )
)

(fn-do _ form-dispatch-match-nodes (list FormMatchNode)
  (let nodes (list FormMatchNode))
  (let sizes (list 2 3 3 1))
  (for (in index (..< 0 (. form-dispatch-match-heads length)))
    (let items (list FormMatchNode))
    (+= items (call (. FormMatchNode atom) 0 ([] form-dispatch-match-heads index)))
    (for (in slot (..< 1 ([] sizes (% index 4))))
      (+= items (call (. FormMatchNode atom) 0 "arg"))
    )
    (+= nodes (call (. FormMatchNode list) 0 items))
  )
  (+= nodes (call (. FormMatchNode comment) 0 "note"))
  (+= nodes (call (. FormMatchNode atom) 0 "word"))
  (return nodes)
)

(fn-expr _ form-dispatch-match Size
  (param node FormMatchNode)
  (match node
    (case (call .comment _ _)
      1000
    )
    (case (call .list _ (list (call .atom _ "import") a))
      (+ 1 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "export") a ...))
      (+ 2 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "let") a b))
      (+ 3 (. a text length) (. b text length))
    )
    (case (call .list _ (list (call .atom _ "set") ...))
      4
    )
    (case (call .list _ (list (call .atom _ "return") a))
      (+ 5 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "yield") a ...))
      (+ 6 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "if") a b))
      (+ 7 (. a text length) (. b text length))
    )
    (case (call .list _ (list (call .atom _ "else-if") ...))
      8
    )
    (case (call .list _ (list (call .atom _ "else") a))
      (+ 9 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "while") a ...))
      (+ 10 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "for") a b))
      (+ 11 (. a text length) (. b text length))
    )
    (case (call .list _ (list (call .atom _ "break") ...))
      12
    )
    (case (call .list _ (list (call .atom _ "continue") a))
      (+ 13 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "match") a ...))
      (+ 14 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "case") a b))
      (+ 15 (. a text length) (. b text length))
    )
    (case (call .list _ (list (call .atom _ "default") ...))
      16
    )
    (case (call .list _ (list (call .atom _ "block") a))
      (+ 17 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "inline") a ...))
      (+ 18 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "call") a b))
      (+ 19 (. a text length) (. b text length))
    )
    (case (call .list _ (list (call .atom _ "index") ...))
      20
    )
    (case (call .list _ (list (call .atom _ "member") a))
      (+ 21 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "lambda") a ...))
      (+ 22 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "tuple") a b))
      (+ 23 (. a text length) (. b text length))
    )
    (case (call .list _ (list (call .atom _ "list") ...))
      24
    )
    (case (call .list _ (list (call .atom _ "map") a))
      (+ 25 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "range") a ...))
      (+ 26 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "cast") a b))
      (+ 27 (. a text length) (. b text length))
    )
    (case (call .list _ (list (call .atom _ "is") ...))
      28
    )
    (case (call .list _ (list (call .atom _ "not") a))
      (+ 29 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "and") a ...))
      (+ 30 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "or") a b))
      (+ 31 (. a text length) (. b text length))
    )
    (case (call .list _ (list (call .atom _ "pattern") ...))
      32
    )
    (case (call .list _ (list (call .atom _ "catch") a))
      (+ 33 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "throw") a ...))
      (+ 34 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "finally") a b))
      (+ 35 (. a text length) (. b text length))
    )
    (case (call .list _ (list (call .atom _ "use") ...))
      36
    )
    (case (call .list _ (list (call .atom _ "fn") a))
      (+ 37 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "type") a ...))
      (+ 38 (. a text length))
    )
    (case (call .list _ (list (call .atom _ "style") a b))
      (+ 39 (. a text length) (. b text length))
    )
    (case (call .list _ (list (call .atom _ "content") ...))
      40
    )
    (case (call .list _ _)
      0
    )
    (default
      2000
    )
  )
)
