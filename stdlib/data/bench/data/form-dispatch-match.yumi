`benchmark.meta description: Dispatches union list forms by head and arity through a 40-arm structural match table.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

. nodes = form-dispatch-match-nodes()
. checksum = 0 as Size
for iteration in 0 .. < 300000
    for node in nodes
        checksum += form-dispatch-match(node)

-- "bench-result data/form-dispatch-match checksum=$checksum"

_ form-dispatch-match-heads List
    * "import"
    * "export"
    * "let"
    * "set"
    * "return"
    * "yield"
    * "if"
    * "else-if"
    * "else"
    * "while"
    * "for"
    * "break"
    * "continue"
    * "match"
    * "case"
    * "default"
    * "block"
    * "inline"
    * "call"
    * "index"
    * "member"
    * "lambda"
    * "tuple"
    * "list"
    * "map"
    * "range"
    * "cast"
    * "is"
    * "not"
    * "and"
    * "or"
    * "pattern"
    * "catch"
    * "throw"
    * "finally"
    * "use"
    * "fn"
    * "type"
    * "style"
    * "content"
    * "missing"
    * "absent"
    * "unknown-head"
    * "x"

━━━━━━━━━━━━━━━━━━━━
_ FormMatchNode is Union

| atom(id U64, text String)
| string(id U64, text String)
| comment(id U64, text String)
| list(id U64, items [FormMatchNode])

────────────────────
+ get text String

match this
    | .atom(_, text)
        text
    | .string(_, text)
        text
    | .comment(_, text)
        text
    | .list(_, _)
        ""

━━━━━━━━━━━━━━━━━━━━
_ do form-dispatch-match-nodes [FormMatchNode]

. nodes [FormMatchNode]
. sizes = [2, 3, 3, 1]
for index in 0 .. < form-dispatch-match-heads.length
    . items [FormMatchNode]
    items += FormMatchNode.atom(0, form-dispatch-match-heads[index])
    for slot in 1 .. < sizes[index % 4]
        items += FormMatchNode.atom(0, "arg")
    nodes += FormMatchNode.list(0, items)
nodes += FormMatchNode.comment(0, "note")
nodes += FormMatchNode.atom(0, "word")
= nodes

━━━━━━━━━━━━━━━━━━━━
_ form-dispatch-match Size
    - node FormMatchNode

match node
    | .comment(_, _)
        1000
    | .list(_, [.atom(_, "import"), a])
        1 + a.text.length
    | .list(_, [.atom(_, "export"), a, ...])
        2 + a.text.length
    | .list(_, [.atom(_, "let"), a, b])
        3 + a.text.length + b.text.length
    | .list(_, [.atom(_, "set"), ...])
        4
    | .list(_, [.atom(_, "return"), a])
        5 + a.text.length
    | .list(_, [.atom(_, "yield"), a, ...])
        6 + a.text.length
    | .list(_, [.atom(_, "if"), a, b])
        7 + a.text.length + b.text.length
    | .list(_, [.atom(_, "else-if"), ...])
        8
    | .list(_, [.atom(_, "else"), a])
        9 + a.text.length
    | .list(_, [.atom(_, "while"), a, ...])
        10 + a.text.length
    | .list(_, [.atom(_, "for"), a, b])
        11 + a.text.length + b.text.length
    | .list(_, [.atom(_, "break"), ...])
        12
    | .list(_, [.atom(_, "continue"), a])
        13 + a.text.length
    | .list(_, [.atom(_, "match"), a, ...])
        14 + a.text.length
    | .list(_, [.atom(_, "case"), a, b])
        15 + a.text.length + b.text.length
    | .list(_, [.atom(_, "default"), ...])
        16
    | .list(_, [.atom(_, "block"), a])
        17 + a.text.length
    | .list(_, [.atom(_, "inline"), a, ...])
        18 + a.text.length
    | .list(_, [.atom(_, "call"), a, b])
        19 + a.text.length + b.text.length
    | .list(_, [.atom(_, "index"), ...])
        20
    | .list(_, [.atom(_, "member"), a])
        21 + a.text.length
    | .list(_, [.atom(_, "lambda"), a, ...])
        22 + a.text.length
    | .list(_, [.atom(_, "tuple"), a, b])
        23 + a.text.length + b.text.length
    | .list(_, [.atom(_, "list"), ...])
        24
    | .list(_, [.atom(_, "map"), a])
        25 + a.text.length
    | .list(_, [.atom(_, "range"), a, ...])
        26 + a.text.length
    | .list(_, [.atom(_, "cast"), a, b])
        27 + a.text.length + b.text.length
    | .list(_, [.atom(_, "is"), ...])
        28
    | .list(_, [.atom(_, "not"), a])
        29 + a.text.length
    | .list(_, [.atom(_, "and"), a, ...])
        30 + a.text.length
    | .list(_, [.atom(_, "or"), a, b])
        31 + a.text.length + b.text.length
    | .list(_, [.atom(_, "pattern"), ...])
        32
    | .list(_, [.atom(_, "catch"), a])
        33 + a.text.length
    | .list(_, [.atom(_, "throw"), a, ...])
        34 + a.text.length
    | .list(_, [.atom(_, "finally"), a, b])
        35 + a.text.length + b.text.length
    | .list(_, [.atom(_, "use"), ...])
        36
    | .list(_, [.atom(_, "fn"), a])
        37 + a.text.length
    | .list(_, [.atom(_, "type"), a, ...])
        38 + a.text.length
    | .list(_, [.atom(_, "style"), a, b])
        39 + a.text.length + b.text.length
    | .list(_, [.atom(_, "content"), ...])
        40
    | .list(_, _)
        0
    ??
        2000
