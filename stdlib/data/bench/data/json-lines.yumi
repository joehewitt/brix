`benchmark.meta description: Reads JSON Lines through a pipe-sized byte source: short lines, one long string, and one large array.
`benchmark.meta timing: recommended
`benchmark.meta profiles: allocator,stream,compile-timing

/core/arena
/data
/data/json
/data/jsonl

_ pipe-capacity Size = 65536

. source = PipeSource(byte-view(json-lines-source()))
. checksum = 0 as Size
. index = 1 as Size

. scratch = use Arena()
for value in source ~> \json-line with JSONParser(scratch)
    checksum += json-weight(value) * index
    index += 1

-- "bench-result data/json-lines checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do json-lines-source String

. lines = List'String()
for index in 0 .. < 4000
    lines += short-line(index)
lines += "\"${"x" * 100000}\""
for index in 4000 .. < 6000
    lines += short-line(index)
. items = List'String()
for index in 0 .. < 2000
    items += "{\"id\": $index, \"name\": \"item\", \"ok\": true}"
lines += "[${", ".join(items)}]"
for index in 6000 .. < 8000
    lines += short-line(index)
. text = "\n".join(lines)
= text ++ "\n"

━━━━━━━━━━━━━━━━━━━━
_ short-line
    - index Size

"{\"type\": \"delta\", \"index\": $index, \"text\": \"chunk-$index alpha\\nbeta\"}"

━━━━━━━━━━━━━━━━━━━━
_ json-weight Size
    - value JSON

match value
    | text String
        text.length
    | list List
        list.length
    | map Map
        map.length
    ??
        1

━━━━━━━━━━━━━━━━━━━━
_ PipeSource
    is ReadableData'Char

+ data ImmutableArray'Byte
+ cursor Index

────────────────────
_ This
    - data

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

. remaining = data.size - cursor
. wanted = if size < pipe-capacity then size else pipe-capacity
. amount = if remaining < wanted then remaining else wanted
if amount
    buffer[0 .. < amount] = data[cursor .. < cursor + amount]
    cursor += amount
= amount
