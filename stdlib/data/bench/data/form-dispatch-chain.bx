; benchmark.meta description: Dispatches union list forms by head and arity through a 40-branch if/else-if chain.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)

(main
  (let nodes (call form-dispatch-chain-nodes))
  (let checksum (as 0 Size))
  (for (in iteration (..< 0 300000))
    (for (in node nodes)
      (+= checksum (call form-dispatch-chain node))
    )
  )
  (blank)
  (print (str "bench-result data/form-dispatch-chain checksum=" checksum))
)

(blank)
(prop _ form-dispatch-chain-heads List
  (block
    (item "import")
    (item "export")
    (item "let")
    (item "set")
    (item "return")
    (item "yield")
    (item "if")
    (item "else-if")
    (item "else")
    (item "while")
    (item "for")
    (item "break")
    (item "continue")
    (item "match")
    (item "case")
    (item "default")
    (item "block")
    (item "inline")
    (item "call")
    (item "index")
    (item "member")
    (item "lambda")
    (item "tuple")
    (item "list")
    (item "map")
    (item "range")
    (item "cast")
    (item "is")
    (item "not")
    (item "and")
    (item "or")
    (item "pattern")
    (item "catch")
    (item "throw")
    (item "finally")
    (item "use")
    (item "fn")
    (item "type")
    (item "style")
    (item "content")
    (item "missing")
    (item "absent")
    (item "unknown-head")
    (item "x")
  )
)

(type _ FormChainNode (is Union)
  (variant atom (tuple (: id U64) (: text String)))
  (variant string (tuple (: id U64) (: text String)))
  (variant comment (tuple (: id U64) (: text String)))
  (variant list (tuple (: id U64) (: items (list FormChainNode))))
  (fn-expr + text String :get
    (match this
      (case (call .atom _ text)
        text
      )
      (case (call .string _ text)
        text
      )
      (case (call .comment _ text)
        text
      )
      (case (call .list _ _)
        ""
      )
    )
  )
  (fn-expr + items (list FormChainNode) :get
    (match this
      (case (call .list _ items)
        items
      )
      (default
        (call (of List FormChainNode))
      )
    )
  )
  (fn-expr + is-list Bool :get
    (is this .list)
  )
  (fn-expr + is-comment Bool :get
    (is this .comment)
  )
  (fn-expr + head (? String) :get
    (match? this
      (case (call .list _ (list (call .atom _ name) ...))
        name
      )
    )
  )
)

(fn-do _ form-dispatch-chain-nodes (list FormChainNode)
  (let nodes (list FormChainNode))
  (let sizes (list 2 3 3 1))
  (for (in index (..< 0 (. form-dispatch-chain-heads length)))
    (let items (list FormChainNode))
    (+= items (call (. FormChainNode atom) 0 ([] form-dispatch-chain-heads index)))
    (for (in slot (..< 1 ([] sizes (% index 4))))
      (+= items (call (. FormChainNode atom) 0 "arg"))
    )
    (+= nodes (call (. FormChainNode list) 0 items))
  )
  (+= nodes (call (. FormChainNode comment) 0 "note"))
  (+= nodes (call (. FormChainNode atom) 0 "word"))
  (return nodes)
)

(fn-do _ form-dispatch-chain Size
  (param node FormChainNode)
  (return-if 1000 (if (. node is-comment)))
  (return-if 2000 (if (not (. node is-list))))
  (let items (. node items))
  (let count (. items length))
  (let head (?? (. node head) ""))
  (if (and (== head "import") (== count 2))
    (return (+ 1 (. ([] items 1) text length)))
    (else-if (and (== head "export") (>= count 2))
      (return (+ 2 (. ([] items 1) text length)))
    )
    (else-if (and (== head "let") (== count 3))
      (return (+ 3 (. ([] items 1) text length) (. ([] items 2) text length)))
    )
    (else-if (== head "set")
      (return 4)
    )
    (else-if (and (== head "return") (== count 2))
      (return (+ 5 (. ([] items 1) text length)))
    )
    (else-if (and (== head "yield") (>= count 2))
      (return (+ 6 (. ([] items 1) text length)))
    )
    (else-if (and (== head "if") (== count 3))
      (return (+ 7 (. ([] items 1) text length) (. ([] items 2) text length)))
    )
    (else-if (== head "else-if")
      (return 8)
    )
    (else-if (and (== head "else") (== count 2))
      (return (+ 9 (. ([] items 1) text length)))
    )
    (else-if (and (== head "while") (>= count 2))
      (return (+ 10 (. ([] items 1) text length)))
    )
    (else-if (and (== head "for") (== count 3))
      (return (+ 11 (. ([] items 1) text length) (. ([] items 2) text length)))
    )
    (else-if (== head "break")
      (return 12)
    )
    (else-if (and (== head "continue") (== count 2))
      (return (+ 13 (. ([] items 1) text length)))
    )
    (else-if (and (== head "match") (>= count 2))
      (return (+ 14 (. ([] items 1) text length)))
    )
    (else-if (and (== head "case") (== count 3))
      (return (+ 15 (. ([] items 1) text length) (. ([] items 2) text length)))
    )
    (else-if (== head "default")
      (return 16)
    )
    (else-if (and (== head "block") (== count 2))
      (return (+ 17 (. ([] items 1) text length)))
    )
    (else-if (and (== head "inline") (>= count 2))
      (return (+ 18 (. ([] items 1) text length)))
    )
    (else-if (and (== head "call") (== count 3))
      (return (+ 19 (. ([] items 1) text length) (. ([] items 2) text length)))
    )
    (else-if (== head "index")
      (return 20)
    )
    (else-if (and (== head "member") (== count 2))
      (return (+ 21 (. ([] items 1) text length)))
    )
    (else-if (and (== head "lambda") (>= count 2))
      (return (+ 22 (. ([] items 1) text length)))
    )
    (else-if (and (== head "tuple") (== count 3))
      (return (+ 23 (. ([] items 1) text length) (. ([] items 2) text length)))
    )
    (else-if (== head "list")
      (return 24)
    )
    (else-if (and (== head "map") (== count 2))
      (return (+ 25 (. ([] items 1) text length)))
    )
    (else-if (and (== head "range") (>= count 2))
      (return (+ 26 (. ([] items 1) text length)))
    )
    (else-if (and (== head "cast") (== count 3))
      (return (+ 27 (. ([] items 1) text length) (. ([] items 2) text length)))
    )
    (else-if (== head "is")
      (return 28)
    )
    (else-if (and (== head "not") (== count 2))
      (return (+ 29 (. ([] items 1) text length)))
    )
    (else-if (and (== head "and") (>= count 2))
      (return (+ 30 (. ([] items 1) text length)))
    )
    (else-if (and (== head "or") (== count 3))
      (return (+ 31 (. ([] items 1) text length) (. ([] items 2) text length)))
    )
    (else-if (== head "pattern")
      (return 32)
    )
    (else-if (and (== head "catch") (== count 2))
      (return (+ 33 (. ([] items 1) text length)))
    )
    (else-if (and (== head "throw") (>= count 2))
      (return (+ 34 (. ([] items 1) text length)))
    )
    (else-if (and (== head "finally") (== count 3))
      (return (+ 35 (. ([] items 1) text length) (. ([] items 2) text length)))
    )
    (else-if (== head "use")
      (return 36)
    )
    (else-if (and (== head "fn") (== count 2))
      (return (+ 37 (. ([] items 1) text length)))
    )
    (else-if (and (== head "type") (>= count 2))
      (return (+ 38 (. ([] items 1) text length)))
    )
    (else-if (and (== head "style") (== count 3))
      (return (+ 39 (. ([] items 1) text length) (. ([] items 2) text length)))
    )
    (else-if (== head "content")
      (return 40)
    )
  )
  (return 0)
)
