━━━━━━━━━━━━━━━━━━━━
_ MarkdownHTMLRenderer

_ fenced-code-renderer MarkdownFencedCodeRenderer?
_ heading-id-renderer MarkdownHeadingIdRenderer?
_ link-renderer MarkdownLinkRenderer?
_ heading-counts Map'String'U32

────────────────────
+ This
    - fenced-code-renderer MarkdownFencedCodeRenderer?
    - heading-id-renderer MarkdownHeadingIdRenderer?
    - link-renderer MarkdownLinkRenderer?

────────────────────
+ render String ?! Error
    - node Markdown

match node
    | [Markdown]
        render-blocks(it)
    | MDDocument
        render-blocks(it.content)
    | MDParagraph
        html-paragraph(render-inlines(it.content))
    | MDDivider
        "<hr>"
    | MDHeader
        render-heading(it)
    | MDStrong
        html-strong(render-inlines(it.content))
    | MDEm
        html-emphasis(render-inlines(it.content))
    | MDLink
        render-link(it)
    | MDImage
        html-image(html-escape(it.url), html-escape(markdown-visible-text(it.content)))
    | MDText
        html-escape(it.text)
    | MDBlockQuote
        html-blockquote(render-blocks(it.content))
    | MDInlineCode
        html-inline-code(html-escape(it.code))
    | MDFencedCode
        render-fenced-code(it)
    | MDList
        render-list(it)
    | MDListItem
        html-list-item(render-inlines(it.content), render-blocks(it.child))
    | MDTable
        render-table(it)
    | MDTableRow
        render-table-row(it, "td", List'MDTableAlignment())
    | MDTableCell
        render-inlines(it.content)
    ??
        ""

────────────────────
_ render-blocks
    - nodes [Markdown]

"\n".join(render(each) in nodes)

────────────────────
_ render-inlines
    - nodes [Markdown]

"".join(render(each) in nodes)

────────────────────
_ do render-heading
    - heading MDHeader

. text = markdown-visible-text(heading.content)
. base = markdown-heading-slug(text)
. count = (heading-counts[base] ?? 0) + 1
heading-counts[base] = count
. default-id = if count == 1 then base else numbered-heading-slug(base, count)
. slug = if heading-id-renderer then heading-id-renderer(heading, default-id) else default-id
= html-heading(heading.level, html-escape(slug), render-inlines(heading.content))

────────────────────
_ render-link String
    - link MDLink

html-link(html-escape(rendered.target), rendered.attributes, render-inlines(link.content))

.. rendered = if link-renderer then link-renderer(link) else MarkdownHTMLLink(link.url, "")

────────────────────
_ render-fenced-code
    - code MDFencedCode

|? fenced-code-renderer
    fenced-code-renderer(code)
|? code.language
    html-language-fenced-code(html-escape(code.language), html-escape(code.body))
??
    html-fenced-code(html-escape(code.body))

────────────────────
_ render-list
    - list MDList

|? !list.ordered
    html-unordered-list(contents)
|? list.start == 1
    html-ordered-list(contents)
??
    html-starting-ordered-list(list.start, contents)

.. contents = render-blocks(list.children)

────────────────────
_ render-table
    - table MDTable

html-table
    - html-table-head(render-table-row(table.header, "th", table.alignments))
    - html-table-body("\n".join(render-table-row(each, "td", table.alignments) in table.rows))

────────────────────
_ render-table-row
    - row MDTableRow
    - tag String
    - alignments [MDTableAlignment]

html-table-row("".join(render-table-cell(row, each, tag, alignments) in 0 .. < row.cells.length))

────────────────────
_ render-table-cell
    - row MDTableRow
    - column Index
    - tag String
    - alignments [MDTableAlignment]

html-table-cell
    - tag
    - html-table-align(column, alignments)
    - render-inlines(row.cells[column].content)

────────────────────
_ html-table-align
    - column Index
    - alignments [MDTableAlignment]

match alignment
    | .left
        " align=\"left\""
    | .center
        " align=\"center\""
    | .right
        " align=\"right\""
    | .none
        ""

.. alignment = if column < alignments.length then alignments[column] else MDTableAlignment.none

━━━━━━━━━━━━━━━━━━━━
_ MarkdownLines

_ source String
_ starts [Index]
_ length Index
_ is-indexed = false

────────────────────
+ This
    - source

────────────────────
+ do offset Index
    - target TokenLocation

. start = line-offset(target.line)
=? length if target.line >= starts.length
. next = target.line + 1
. line-end = if next < starts.length then starts[next] - 1 else length
=? length if start + target.column > line-end
= start + target.column

────────────────────
+ do line-offset Index
    - line U32

index-lines()
=? length if line >= starts.length
= starts[line]

────────────────────
_ do index-lines

=? if is-indexed
is-indexed = true
starts += 0
. position Index = 0
for c in source
    position += 1
    if c == '\n'
        starts += position
length = position

