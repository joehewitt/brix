_ IndentedItem is (indent I32, ordered Bool, start U32, contents [Markdown], line U32)
_ MarkdownSourceRange is (start Index, end Index)

━━━━━━━━━━━━━━━━━━━━
+ Markdown is Union

| MDDocument
| MDHeader
| MDParagraph
| MDDivider
| MDLink
| MDImage
| MDStrong
| MDEm
| MDText
| MDList
| MDListItem
| MDBlockQuote
| MDInlineCode
| MDFencedCode
| MDTable
| MDTableRow
| MDTableCell

────────────────────
+ This ~ Char

~ source (\nl* (...values \top-value \nl*)* !.)
    finish-markdown-document(source, values)

.. top-value Markdown ~
    ~ \fenced-code
    ~ \table
    ~ \header
    ~ \list
    ~ \divider
    ~ \blockquote
    ~ \paragraph

.. header Markdown ~
    ~ level "#"{1, 6} // contents \inline*
        MDHeader(level.length as U8, contents, location.begin.line)

.. paragraph Markdown ~
    ~ first \paragraph-line rest \paragraph-continuation*
        MDParagraph(join-paragraph-lines(first, rest), location.begin.line)

.. paragraph-line [Markdown] ~
    ~ values \inline+
        values

.. paragraph-continuation [Markdown] ~
    ~ \nl !\block-start values \paragraph-line
        values

.. block-start ~
    ~ &\fence-start
    ~ &\table-start
    ~ &\header-start
    ~ &\list-start
    ~ &\divider-start
    ~ &\blockquote-start

.. header-start ~
    ~ "#"{1, 6} //

.. fence-start ~
    ~ "`"{3} "`"*

.. table-start ~
    ~ \table-row-source \nl \table-delimiter-row

.. list-start ~
    ~ / [*+-] //
    ~ / [0-9]+ "." //

.. divider-start ~
    ~ ("-" /){3} ("-" /)* &(\nl | !.)

.. blockquote-start ~
    ~ ">"

.. list Markdown ~
    ~ items \list-item+
        group-items(items)

.. list-item IndentedItem ~
    ~ \nl* item \list-item-line
        item

.. list-item-line IndentedItem ~
    ~ indent / [*+-] // contents \inline*
        IndentedItem(indent.length as I32, false, 1, contents, location.begin.line)
    ~ indent / start \num'U32 "." // contents \inline*
        IndentedItem(indent.length as I32, true, start, contents, location.begin.line)

.. divider Markdown ~
    ~ ("-" /){3} ("-" /)* &(\nl | !.)
        MDDivider("", location.begin.line)

.. blockquote Markdown ~
    ~ lines \blockquote-line+
        make-blockquote(lines, location.begin.line)

.. blockquote-line String ~
    ~ \nl* ">" / text (!\nl .)*
        text

.. fenced-code Markdown ~
    ~ fence \fence-mark language \fence-opening body \markdown-closed-fence-body(fence.length)
        make-fenced-code(language, body, location)
    ~ fence \fence-mark language \fence-opening body \markdown-open-fence-body(fence.length)
        make-fenced-code(language, body, location)
    ~ fence \fence-mark / language \fence-language? (!\nl .)* !.
        make-fenced-code(language ?? "", "", location)

.. fence-mark String ~
    ~ "`"{3} "`"*

.. fence-language String ~
    ~ (!\ws !\nl .)+

.. fence-opening String ~
    ~ / language \fence-language? (!\nl .)* \nl
        language ?? ""

.. table Markdown ~
    ~ header \table-row-source \nl alignments \table-delimiter-row rows \table-body-row*
        MDTable
            - markdown-table-row(header)
            - markdown-table-rows(rows)
            - alignments
            - location.begin.line

.. table-body-row [String] ~
    ~ \nl \table-row-source

.. table-row-source [String] ~
    ~ "|"? ...cells \table-cell-source ("|" ...cells \table-cell-source)+ "|"?
        normalized-table-cells(cells)

.. table-cell-source String ~
    ~ \table-cell-part*

.. table-cell-part ~
    ~ "\\|"
    ~ "`" (!"`" !\nl .)* "`"
    ~ !("|" | \nl) .

.. table-delimiter-row [MDTableAlignment] ~
    ~ "|"? ...cells \table-delimiter-cell ("|" ...cells \table-delimiter-cell)+ "|"? &(\nl | !.)
        cells

.. table-delimiter-cell MDTableAlignment ~
    ~ / ":" "-"+ ":" /
        MDTableAlignment.center
    ~ / ":" "-"+ /
        MDTableAlignment.left
    ~ / "-"+ ":" /
        MDTableAlignment.right
    ~ / "-"{3} "-"* /
        MDTableAlignment.none

.. inline Markdown ~
    ~ \markdown-inline

────────────────────
+ from text String

match text
    ~ This
    ??
        MDDocument([MDParagraph([MDText(text)])])

