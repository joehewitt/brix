    - doc Markdown
    - fenced-code-renderer MarkdownFencedCodeRenderer? = null
    - heading-id-renderer MarkdownHeadingIdRenderer? = null
    - link-renderer MarkdownLinkRenderer? = null

MarkdownHTMLRenderer(fenced-code-renderer, heading-id-renderer, link-renderer).render(doc)

