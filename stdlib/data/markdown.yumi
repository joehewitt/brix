━━━━━━━━━━━━━━━━━━━━
_ do group-items Markdown
    - items [IndentedItem]

. first = items[0]
. indent = first.indent
. stack = [MDList(first.ordered, first.start)]
. indents = [indent]

for item in items
    if item.indent == indent
        stack.tail.children += MDListItem(item.contents, List'MDList(), item.line)
    else if item.indent > indent
        if | [..., last-item MDListItem] = stack.tail.children
            . new-list = MDList(item.ordered, item.start)
            new-list.children += MDListItem(item.contents, List'MDList(), item.line)
            last-item.child += new-list
            indent = item.indent
            stack += new-list
            indents += indent
    else
        while item.indent < indent && stack.length > 1
            stack.pop()
            indents.pop()
            indent = indents.tail
        stack.tail.children += MDListItem(item.contents, List'MDList(), item.line)

= stack[0]

━━━━━━━━━━━━━━━━━━━━
_ join-paragraph-lines
    - first [Markdown]
    - rest [[Markdown]]

** first
**
    rest
    *> paragraph-line-with-separator(each)
    |> flat-map
|> List

━━━━━━━━━━━━━━━━━━━━
_ paragraph-line-with-separator
    - line [Markdown]

* MDText(" ", true)
** line

━━━━━━━━━━━━━━━━━━━━
_ make-fenced-code
    - language String
    - body String
    - location MatchLocation

MDFencedCode(language, body, (0, 0), (0, body.length), location.begin.line + 2, location)

━━━━━━━━━━━━━━━━━━━━
_ do finalize-markdown [Markdown]
    - lines MarkdownLines
    - nodes [Markdown]

. result List'Markdown
for node in nodes
    if | code MDFencedCode = node
        . start = lines.offset(code.source-location.begin)
        . end = lines.offset(code.source-location.end) + 1
        . body-start = lines.line-offset(code.source-location.begin.line + 1)
        . finished = MDFencedCode
            - code.language
            - code.body
            - (start, end)
            - (body-start, body-start + code.body.length)
            - code.first-body-line
            - code.source-location
        result += finished
    else if | quote MDBlockQuote = node
        result += MDBlockQuote(finalize-markdown(lines, quote.content), quote.line)
    else
        result += node
= result

━━━━━━━━━━━━━━━━━━━━
_ finish-markdown-document
    - source String
    - nodes [Markdown]

MDDocument(finalize-markdown(MarkdownLines(source), nodes))

━━━━━━━━━━━━━━━━━━━━
_ normalized-table-cells
    - cells [String]

cells[start .. < end]

.. start = if cells && !cells[0].trim() then 1 else 0
.. end = if cells && !cells.tail.trim() then cells.length - 1 else cells.length

━━━━━━━━━━━━━━━━━━━━
_ markdown-table-row
    - cells [String]

MDTableRow(MDTableCell(markdown-inlines(table-cell-text(each))) in cells)

━━━━━━━━━━━━━━━━━━━━
_ table-cell-text String
    - cell String

"|".join(cell.trim().split("\\|"))

━━━━━━━━━━━━━━━━━━━━
_ markdown-table-rows
    - rows [[String]]

markdown-table-row(each) in rows

━━━━━━━━━━━━━━━━━━━━
_ do make-blockquote
    - lines [String]
    - line U32

. blocks List'Markdown
. paragraph List'String
. first = line
for index in 0 .. < lines.length
    if lines[index].trim()
        if !paragraph
            first = line + (index as U32)
        paragraph += lines[index]
    else if paragraph
        blocks += MDParagraph(quote-paragraph-content(paragraph), first)
        paragraph.clear()
if paragraph
    blocks += MDParagraph(quote-paragraph-content(paragraph), first)
= MDBlockQuote(blocks, line)

━━━━━━━━━━━━━━━━━━━━
_ do quote-paragraph-content [Markdown]
    - lines [String]

. result List'Markdown
for index in 0 .. < lines.length
    if index > 0
        result += MDText(" ", true)
    for node in markdown-inlines(lines[index])
        result += node
= result

━━━━━━━━━━━━━━━━━━━━
_ do markdown-inlines [Markdown]
    - source String

=? match? source
    ~ values \markdown-inline* !.
        values

= [MDText(source)]

━━━━━━━━━━━━━━━━━━━━
_ markdown-visible-node-text String
    - node Markdown

match node
    | MDText
        it.text
    | MDInlineCode
        it.code
    | MDStrong
        markdown-visible-text(it.content)
    | MDEm
        markdown-visible-text(it.content)
    | MDLink
        markdown-visible-text(it.content)
    | MDImage
        markdown-visible-text(it.content)
    | MDParagraph
        markdown-visible-text(it.content)
    | MDHeader
        markdown-visible-text(it.content)
    | MDTableCell
        markdown-visible-text(it.content)
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ html-escape
    - text String

"".join(html-escaped(each) in text)

━━━━━━━━━━━━━━━━━━━━
_ html-escaped
    - c Char

match c
    |= '&'
        "&amp;"
    |= '<'
        "&lt;"
    |= '>'
        "&gt;"
    |= '"'
        "&quot;"
    |= '\''
        "&#39;"
    ??
        "$c"

━━━━━━━━━━━━━━━━━━━━
_ is-markdown-slug-character Bool
    - c Char

match c.category
    |= .letter-uppercase
        true
    |= .letter-lowercase
        true
    |= .letter-titlecase
        true
    |= .letter-modifier
        true
    |= .letter-other
        true
    |= .number-decimal
        true
    |= .number-letter
        true
    |= .number-other
        true
    ??
        false
