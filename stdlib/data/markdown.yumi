+ markdown-inline ~ Char Markdown

~ \strong
~ "**"
    MDText("**")
~ \em
~ \image
~ \link
~ \inline-code
~ \escaped-text
~ \text
~ \special-text

.. strong Markdown ~
    ~ "**" (!"**" ...contents \markdown-inline)+ "**"
        MDStrong(contents)

.. em Markdown ~
    ~ "*" (!"*" ...contents \markdown-inline)+ "*"
        MDEm(contents)

.. link Markdown ~
    ~ "[" (!"]" ...contents \markdown-inline)+ "](" url \url-text ")"
        MDLink(url, contents)

.. image Markdown ~
    ~ "![" (!"]" ...contents \markdown-inline)+ "](" url \url-text ")"
        MDImage(url, contents)

.. inline-code Markdown ~
    ~ "`" code (!"`" !\nl .)* "`"
        MDInlineCode(code)

.. escaped-text Markdown ~
    ~ "\\" text \escaped-char
        MDText(text)

.. special-text Markdown ~
    ~ text \reserved-char
        MDText(text)

.. text Markdown ~
    ~ text \chars
        MDText(text)

.. chars String ~
    ~ chars \char+
        chars

.. char ~
    ~ !(\reserved-char | \nl) .

.. reserved-char ~
    ~ "\\" | "*" | "[" | "]" | "!" | "`"

.. escaped-char ~
    ~ \reserved-char | "|" | "#" | ">" | "-" | "+" | "." | "_" | "(" | ")" | "~" | "<"

.. url-text String ~
    ~ chars \url-char+
        Array(chars).slice-string()

.. url-char Char ~
    ~ "\\)"
        ')'
    ~ !(")" | \nl) .

