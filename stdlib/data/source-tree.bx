(import /core/arena)
(import /core/atom-pool)
(import /core/table)
(import /stream/aggregate)
(blank)
(prop + source-raw-head _ (= "raw"))
(prop + source-blank-head _ (= "blank"))
(prop + source-compact-slack Size (= 4096))
(blank)
(prop _ source-block-flag U32 (= 0x80000000))

(type + SourceBase (is Tuple)
  (prop + id U32)
)

(type + SourceWord (is SourceBase)
  (prop + text String)
)

(type + SourceQuote (is SourceBase)
  (prop + text String)
)

(type + SourceNote (is SourceBase)
  (prop + text String)
)

(type + SourceGroup (is SourceBase)
  (prop + start U32)
  (prop + count U32)
)

(type + SourceNode (is Union)
  (variant atom SourceWord)
  (variant string SourceQuote)
  (variant comment SourceNote)
  (variant list SourceGroup)
)

(type + SourceMoves
  (prop _ places ([] U32))
  (fn-do + This _
    (param places _)
  )
  (fn-expr + place U32
    (param position U32)
    (before
      (throw (call Panic (str "Source position " position " did not survive compaction")) (if (== next 0)))
    )
    (if-expr (>= next source-block-flag) (- next source-block-flag 1) (- next 1))
    (where
      (lazy next ([] places position))
    )
  )
  (fn-expr + place-at (? U32)
    (param position (? U32))
    (if-expr (== position null) null (call place position))
  )
)

(type + SourceStore
  (prop + nodes (of ImmutableTable SourceNode))
  (blank)
  (prop _ arena Arena)
  (prop _ names AtomPool)
  (prop _ table (of Table SourceNode))
  (prop _ held (of Table SourceNode))
  (prop _ young (of Table SourceNode))
  (prop _ last-id U32)
  (prop _ is-released Bool)
  (fn-do + This _
    (param capacity Size (= 1024))
    (lazy names (call AtomPool))
    (lazy table (call (of Table SourceNode) arena capacity))
    (lazy held (call (of Table SourceNode) arena 64))
    (lazy young (call (of Table SourceNode) arena 64))
    (lazy nodes (call (. table view)))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (return-if (if is-released))
    (= is-released true)
    (call (. names release))
    (call (. arena release))
  )
  (fn-expr + length Size :get
    (. nodes length)
  )
  (fn-expr + latest-id U32 :get
    last-id
  )
  (fn-expr + node (of ImmutableTableRow SourceNode)
    (param position U32)
    ([] nodes (as position Index))
  )
  (fn-expr + node-at (? (of ImmutableTableRow SourceNode))
    (param position (? U32))
    (if-expr (== position null) null ([] nodes (as position Index)))
  )
  (fn-expr + id-at U32
    (param position (? U32))
    (if-expr (!= position null) (. ([] nodes (as position Index)) id) 0)
  )
  (fn-expr + is-atom Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .atom _ _)
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-text Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .string _ _)
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-comment Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .comment _ _)
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-list Bool
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .list _ _ _)
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + text String
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .atom _ text)
        text
      )
      (case (call .string _ text)
        text
      )
      (case (call .comment _ text)
        text
      )
      (case (call .list _ _ _)
        ""
      )
    )
  )
  (fn-expr + comment-text (? String)
    (param node (of ImmutableTableRow SourceNode))
    (match? node
      (case (call .comment _ text)
        text
      )
    )
  )
  (fn-expr + items (of ImmutableTableSpan SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .list _ start count)
        ([] nodes (..< start (+ start count)))
      )
      (default
        ([] nodes (..< 0 0))
      )
    )
  )
  (fn-expr + count Size
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .list _ _ count)
        (as count Size)
      )
      (default
        0
      )
    )
  )
  (fn-expr + item (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param index Index)
    ([] (call items node) index)
  )
  (fn-do + listed (list (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (param first Index (= 0))
    (let made (list (of ImmutableTableRow SourceNode)))
    (let held (call items node))
    (for (in index (..< first (. held length)))
      (+= made ([] held index))
    )
    (return made)
  )
  (fn-expr + head (? String)
    (param node (of ImmutableTableRow SourceNode))
    (match? (call items node)
      (case (list (call .atom _ name) ...)
        name
      )
    )
  )
  (fn-expr + is-form Bool
    (param node (of ImmutableTableRow SourceNode))
    (param name String)
    (== (call head node) name)
  )
  (fn-expr + raw-text (? String)
    (param node (of ImmutableTableRow SourceNode))
    (match? (call items node)
      (case (list (call .atom _ ({} (== it source-raw-head))) (call .string _ text) ...)
        text
      )
    )
  )
  (fn-expr + is-blank Bool
    (param node (of ImmutableTableRow SourceNode))
    (match (call items node)
      (case (list (call .atom _ ({} (== it source-blank-head))))
        true
      )
      (default
        false
      )
    )
  )
  (fn-do + same Bool
    (param left (of ImmutableTableRow SourceNode))
    (param right (of ImmutableTableRow SourceNode))
    (match left
      (case (call .list _ start count)
        (match right
          (case (call .list _ other size)
            (return-if false (if (!= count size)))
            (return (call all (..< 0 count) (:where (call same ([] nodes (+ start each)) ([] nodes (+ other each))))))
          )
          (default
            (return false)
          )
        )
      )
      (case (call .atom _ held)
        (return (and (call is-atom right) (== (call text right) held)))
      )
      (case (call .string _ held)
        (return (and (call is-text right) (== (call text right) held)))
      )
      (case (call .comment _ held)
        (return (and (call is-comment right) (== (call text right) held)))
      )
    )
  )
  (fn-do + find (? (of ImmutableTableRow SourceNode))
    (param root (of ImmutableTableRow SourceNode))
    (param id U32)
    (return-if root (if (== (. root id) id)))
    (for (in child (call items root))
      (let found (call find child id))
      (return-if found (if found))
    )
    (return null)
  )
  (fn-do + next-id U32
    (+= last-id 1)
    (return last-id)
  )
  (fn-expr + name String
    (param text String)
    (. (call (. names store) text) text)
  )
  (fn-do + name-of String
    (param bytes (of ImmutableArray Byte))
    (param start Index)
    (param end Index)
    (return (. (call (. names store) bytes start end) text))
  )
  (fn-do + place (of ImmutableTableRow SourceNode)
    (param cell SourceNode)
    (let position (call (. table append) cell))
    (= nodes (call (. table view)))
    (return ([] nodes position))
  )
  (fn-do + atom (of ImmutableTableRow SourceNode)
    (param text String)
    (return (call place (call (. SourceNode atom) (call next-id) (call name text))))
  )
  (fn-do + string (of ImmutableTableRow SourceNode)
    (param text String)
    (return (call place (call (. SourceNode string) (call next-id) (call name text))))
  )
  (fn-do + comment (of ImmutableTableRow SourceNode)
    (param text String)
    (return (call place (call (. SourceNode comment) (call next-id) (call name text))))
  )
  (fn-do + list (of ImmutableTableRow SourceNode)
    (param items (list (of ImmutableTableRow SourceNode)))
    (return (call group (call next-id) items))
  )
  (fn-do + group (of ImmutableTableRow SourceNode)
    (param id U32)
    (param items (list (of ImmutableTableRow SourceNode)))
    (let start (. table length))
    (for (in item items)
      (call (. table append) item)
    )
    (return (call place (call (. SourceNode list) id (as start U32) (as (. items length) U32))))
  )
  (fn-do + raw (of ImmutableTableRow SourceNode)
    (param text String)
    (param body (list (of ImmutableTableRow SourceNode)))
    (let items (call (of List (of ImmutableTableRow SourceNode)) (call atom source-raw-head) (call string text)))
    (++= items body)
    (return (call list items))
  )
  (fn-do + blank (of ImmutableTableRow SourceNode)
    (return (call list (call (of List (of ImmutableTableRow SourceNode)) (call atom source-blank-head))))
  )
  (fn-do + with-id (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param id U32)
    (match node
      (case (call .atom _ text)
        (return (call place (call (. SourceNode atom) id text)))
      )
      (case (call .string _ text)
        (return (call place (call (. SourceNode string) id text)))
      )
      (case (call .comment _ text)
        (return (call place (call (. SourceNode comment) id text)))
      )
      (case (call .list _ start count)
        (return (call place (call (. SourceNode list) id start count)))
      )
    )
  )
  (fn-do + with-items (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param items (list (of ImmutableTableRow SourceNode)))
    (return (call group (. node id) items))
  )
  (fn-do + replaced (? (of ImmutableTableRow SourceNode))
    (param root (of ImmutableTableRow SourceNode))
    (param id U32)
    (param replacement (of ImmutableTableRow SourceNode))
    (return-if replacement (if (== (. root id) id)))
    (match root
      (case (call .list _ start count)
        (for (in offset (..< 0 count))
          (let swapped (call replaced ([] nodes (+ start offset)) id replacement))
          (if swapped
            (return (call rebuilt (. root id) start count offset swapped))
          )
        )
        (return null)
      )
      (default
        (return null)
      )
    )
  )
  (fn-do + removed (? (of ImmutableTableRow SourceNode))
    (param root (of ImmutableTableRow SourceNode))
    (param id U32)
    (match root
      (case (call .list _ start count)
        (for (in offset (..< 0 count))
          (let child ([] nodes (+ start offset)))
          (if (== (. child id) id)
            (return (call rebuilt (. root id) start count offset null))
          )
          (let pruned (call removed child id))
          (if pruned
            (return (call rebuilt (. root id) start count offset pruned))
          )
        )
        (return null)
      )
      (default
        (return null)
      )
    )
  )
  (fn-do + shares Bool
    (param left (of ImmutableTableRow SourceNode))
    (param right (of ImmutableTableRow SourceNode))
    (match left
      (case (call .list id start count)
        (match right
          (case (call .list other other-start other-count)
            (return (and (== id other) (== start other-start) (== count other-count)))
          )
          (default
            (return false)
          )
        )
      )
      (default
        (return false)
      )
    )
  )
  (fn-do + swapped (? (of ImmutableTableRow SourceNode))
    (param root (of ImmutableTableRow SourceNode))
    (param target (of ImmutableTableRow SourceNode))
    (param replacement (of ImmutableTableRow SourceNode))
    (return-if replacement (if (== (. root index) (. target index))))
    (match root
      (case (call .list _ start count)
        (for (in offset (..< 0 count))
          (let made (call swapped ([] nodes (+ start offset)) target replacement))
          (if made
            (return (call rebuilt (. root id) start count offset made))
          )
        )
        (return null)
      )
      (default
        (return null)
      )
    )
  )
  (fn-do + appended (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param child (of ImmutableTableRow SourceNode))
    (let start (. table length))
    (let count Size 0)
    (for (in item (call items node))
      (call (. table append) item)
      (+= count 1)
    )
    (call (. table append) child)
    (return (call place (call (. SourceNode list) (. node id) (as start U32) (as (+ count 1) U32))))
  )
  (fn-do + extended (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param children (list (of ImmutableTableRow SourceNode)))
    (let start (. table length))
    (let count Size 0)
    (for (in item (call items node))
      (call (. table append) item)
      (+= count 1)
    )
    (for (in child children)
      (call (. table append) child)
    )
    (return (call place (call (. SourceNode list) (. node id) (as start U32) (as (+ count (. children length)) U32))))
  )
  (fn-do + inserted (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param slot Index)
    (param child (of ImmutableTableRow SourceNode))
    (let start (. table length))
    (let held (call items node))
    (let spot (if-expr (< slot (. held length)) slot (. held length)))
    (for (in index (..< 0 spot))
      (call (. table append) ([] held index))
    )
    (call (. table append) child)
    (for (in index (..< spot (. held length)))
      (call (. table append) ([] held index))
    )
    (return (call place (call (. SourceNode list) (. node id) (as start U32) (as (+ (. held length) 1) U32))))
  )
  (fn-do + without (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param slot Index)
    (let start (. table length))
    (let held (call items node))
    (let count Size 0)
    (for (in index (..< 0 (. held length)))
      (if (!= index slot)
        (call (. table append) ([] held index))
        (+= count 1)
      )
    )
    (return (call place (call (. SourceNode list) (. node id) (as start U32) (as count U32))))
  )
  (fn-do + trimmed (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param count Size)
    (let start (. table length))
    (let held (call items node))
    (let kept (if-expr (< count (. held length)) count (. held length)))
    (for (in index (..< 0 kept))
      (call (. table append) ([] held index))
    )
    (return (call place (call (. SourceNode list) (. node id) (as start U32) (as kept U32))))
  )
  (fn-do _ rebuilt (of ImmutableTableRow SourceNode)
    (param id U32)
    (param start U32)
    (param count U32)
    (param offset U32)
    (param swapped (? (of ImmutableTableRow SourceNode)))
    (let block (. table length))
    (let made U32)
    (for (in position (..< 0 count))
      (if (!= position offset)
        (call (. table append) ([] nodes (+ start position)))
        (+= made 1)
        (else-if swapped
          (call (. table append) swapped)
          (+= made 1)
        )
      )
    )
    (return (call place (call (. SourceNode list) id (as block U32) made)))
  )
  (fn-expr + mark U32 :get
    (as (. table length) U32)
  )
  (fn-do + rewind _
    (param mark U32)
    (return-if (if (>= (as mark Size) (. table length))))
    (call (. table truncate) mark)
    (= nodes (call (. table view)))
  )
  (fn-do + settle (list U32)
    (param mark U32)
    (param roots (list (of ImmutableTableRow SourceNode)))
    (let cells (list SourceNode))
    (for (in root roots)
      (if (>= (. root index) (as mark Size))
        (+= cells (call tenured mark root))
      )
    )
    (if (< (as mark Size) (. table length))
      (call (. table truncate) mark)
    )
    (for (in index (..< 0 (. young length)))
      (call (. table append) ([] young index))
    )
    (call (. young truncate) 0)
    (let places (list U32))
    (let next Index 0)
    (for (in root roots)
      (if (< (. root index) (as mark Size))
        (+= places (as (. root index) U32))
        (else
          (+= places (as (call (. table append) ([] cells next)) U32))
          (+= next 1)
        )
      )
    )
    (= nodes (call (. table view)))
    (return places)
  )
  (fn-do _ tenured SourceNode
    (param mark U32)
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .list id start count)
        (return-if (call (. SourceNode list) id start count) (if (or (< start mark) (== count 0))))
        (let base (. held length))
        (for (in offset (..< 0 count))
          (call (. held append) (call tenured mark ([] nodes (+ start offset))))
        )
        (let block (+ mark (as (. young length) U32)))
        (for (in index (..< base (+ base count)))
          (call (. young append) ([] held index))
        )
        (call (. held truncate) base)
        (return (call (. SourceNode list) id block count))
      )
      (default
        (return node)
      )
    )
  )
  (fn-do + compact SourceMoves
    (param roots (list U32))
    (let seen ([] U32 (. table length)))
    (let live Size 0)
    (for (in root roots)
      (if (== (% ([] seen root) 2) 0)
        (= ([] seen root) (+ ([] seen root) 1))
        (+= live 1)
      )
      (+= live (call weighed seen ([] nodes root)))
    )
    (let places ([] U32 (. table length)))
    (let old arena)
    (= arena (call Arena))
    (= table (call (of Table SourceNode) arena (+ (* live 2) (* source-compact-slack 2))))
    (= held (call (of Table SourceNode) arena 64))
    (= young (call (of Table SourceNode) arena 64))
    (for (in root roots)
      (let cell (call carried places ([] nodes root)))
      (if (== ([] places root) 0)
        (= ([] places root) (+ (as (call (. table append) cell) U32) 1))
      )
    )
    (call (. old release))
    (= nodes (call (. table view)))
    (return (call SourceMoves places))
  )
  (fn-do _ weighed Size
    (param seen ([] U32))
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .list _ start count)
        (return-if 0 (if (or (== count 0) (>= ([] seen start) 2))))
        (= ([] seen start) (+ ([] seen start) 2))
        (let total (as count Size))
        (for (in offset (..< 0 count))
          (+= total (call weighed seen ([] nodes (+ start offset))))
        )
        (return total)
      )
      (default
        (return 0)
      )
    )
  )
  (fn-do _ carried SourceNode
    (param places ([] U32))
    (param node (of ImmutableTableRow SourceNode))
    (match node
      (case (call .list id start count)
        (return-if (call (. SourceNode list) id 0 0) (if (== count 0)))
        (let known ([] places start))
        (return-if (call (. SourceNode list) id (- known source-block-flag 1) count) (if (>= known source-block-flag)))
        (let base (. held length))
        (for (in offset (..< 0 count))
          (call (. held append) (call carried places ([] nodes (+ start offset))))
        )
        (let block (as (. table length) U32))
        (for (in index (..< base (+ base count)))
          (call (. table append) ([] held index))
        )
        (call (. held truncate) base)
        (for (in offset (..< 0 count))
          (= ([] places (+ start offset)) (+ source-block-flag block offset 1))
        )
        (return (call (. SourceNode list) id block count))
      )
      (default
        (return node)
      )
    )
  )
  (fn-do + reserve _
    (param count Size)
    (call (. table reserve) (+ (. table length) count))
  )
  (fn-expr + held-count Size :get
    (. held length)
  )
  (fn-do + hold _
    (param cell SourceNode)
    (call (. held append) cell)
  )
  (fn-do + close SourceNode
    (param base Size)
    (param id U32)
    (let start (. table length))
    (let count (- (. held length) base))
    (for (in index (..< base (+ base count)))
      (call (. table append) ([] held index))
    )
    (call (. held truncate) base)
    (return (call (. SourceNode list) id (as start U32) (as count U32)))
  )
  (fn-do + root U32
    (param cell SourceNode)
    (return (as (call (. table append) cell) U32))
  )
  (fn-do + sync _
    (call (. held truncate) 0)
    (= nodes (call (. table view)))
  )
)
