./canvas
./color
./primitives
/math
/units

━━━━━━━━━━━━━━━━━━━━
+ do fill-checkerboard
    - canvas Canvas
    - rect Rect
    - cell Length
    - light RGBA
    - dark RGBA

=? if rect.width <= 0 || rect.height <= 0 || !is-finite(cell) || cell <= 0
do use canvas.saved-state
    canvas.stroke-color = null
    canvas.fill-color = light
    canvas.rect(rect)
    canvas.fill-color = dark
    . columns = ceil(rect.width / cell) as Size
    . rows = ceil(rect.height / cell) as Size
    for row in 0 .. < rows
        . y = rect.y + (row as F64) * cell
        . height = min(cell, rect.bottom - y)
        for column in 0 .. < columns
            if (row + column) % 2 == 1
                . x = rect.x + (column as F64) * cell
                canvas.rect(Rect(x, y, min(cell, rect.right - x), height))
