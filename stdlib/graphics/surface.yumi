./canvas
/BxGraphics/BxGraphics.h

━━━━━━━━━━━━━━━━━━━━
+ SharedSurface
    is Closable

+ native Pointer

────────────────────
+ This ?! IOError
    - pixel-width I32
    - pixel-height I32

. created = C:brixGraphicsSurfaceCreate(pixel-width, pixel-height)
?! IOError("Unable to create a $pixel-width by $pixel-height surface")
    if !created
= This(created)

────────────────────
+ This
    - native

────────────────────
+ get pixel-width I32

C:brixGraphicsSurfaceGetPixelWidth(native)

────────────────────
+ get pixel-height I32

C:brixGraphicsSurfaceGetPixelHeight(native)

────────────────────
+ do make-port U32

=? 0 if !native
= C:brixGraphicsSurfaceCreateMachPort(native)

────────────────────
+ do canvas RasterCanvas?
    - scale F64

. graphics = C:brixGraphicsCanvasCreateWithSurface(native, scale)
=? null if !graphics
= RasterCanvas(graphics)

────────────────────
+ do close

=? if !native
C:brixGraphicsSurfaceRelease(native)
native = Pointer()

━━━━━━━━━━━━━━━━━━━━
+ do shared-surface-from-port SharedSurface?
    - port U32

. found = C:brixGraphicsSurfaceLookUpMachPort(port)
=? null if !found
= SharedSurface(found)
