
./point
/core/animatable
/math

+ Coord (px) is Float
+ Length is Float
+ PointOnCurve is Float

━━━━━━━━━━━━━━━━━━━━
+ LineCap is Union

| butt
| round
| square

────────────────────
+ to String

|? "round" if this == LineCap.round
|? "square" if this == LineCap.square
?? "butt"

━━━━━━━━━━━━━━━━━━━━
+ LineJoin is Union

| miter
| round
| bevel

────────────────────
+ to String

|? "round" if this == LineJoin.round
|? "bevel" if this == LineJoin.bevel
?? "miter"

━━━━━━━━━━━━━━━━━━━━
+ StrokeAlignment is Union

| center
| inside
| outside

────────────────────
+ to String

|? "inside" if this == StrokeAlignment.inside
|? "outside" if this == StrokeAlignment.outside
?? "center"

━━━━━━━━━━━━━━━━━━━━
+ BlendMode is I32

| normal = 0
| multiply = 1
| screen = 2
| overlay = 3
| darken = 4
| lighten = 5
| color-dodge = 6
| color-burn = 7
| soft-light = 8
| hard-light = 9
| difference = 10
| exclusion = 11
| hue = 12
| saturation = 13
| color = 14
| luminosity = 15
| clear = 16
| copy = 17
| source-in = 18
| source-out = 19
| source-atop = 20
| destination-over = 21
| destination-in = 22
| destination-out = 23
| destination-atop = 24
| xor = 25
| plus-darker = 26
| plus-lighter = 27

━━━━━━━━━━━━━━━━━━━━
+ ImageSampling is I32

| smooth = 0
| pixelated = 1

━━━━━━━━━━━━━━━━━━━━
+ ColorSpace is I32

| srgb = 0
| display-p3 = 1
| linear-srgb = 2
| linear-display-p3 = 3
| linear-rec2020 = 4

━━━━━━━━━━━━━━━━━━━━
+ PixelFormat is I32

| rgba8 = 0
| rgba16-float = 1

━━━━━━━━━━━━━━━━━━━━
+ FillRule is Union

| nonzero
| even-odd

━━━━━━━━━━━━━━━━━━━━
+ Side is Union

| top
| bottom
| left
| right

────────────────────
+ get opposite

match this
    | Side.top
        Side.bottom
    | Side.bottom
        Side.top
    | Side.left
        Side.right
    ??
        Side.left

────────────────────
+ get is-vertical

this == Side.top || this == Side.bottom

━━━━━━━━━━━━━━━━━━━━
+ SegmentType

| segment-type-move
| segment-type-line
| segment-type-cubic

────────────────────
+ to String

|? "move" if this == .segment-type-move
|? "line" if this == .segment-type-line
?? "cubic"

━━━━━━━━━━━━━━━━━━━━
+ Dimensions is (width Length, height Length)
    is Animatable

────────────────────
+ This
    - vector [F64]

= This(vector[0], vector[1])

────────────────────
+ this / div Float

This(width / div, height / div)

╌╌╌╌╌╌╌╌╌╌ is Animatable ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get motion-vector [F64]

[width as F64, height as F64]

━━━━━━━━━━━━━━━━━━━━
+ Rect is (x Coord, y Coord, width Coord, height Coord)

+ left => x
+ right => x + width
+ top => y
+ bottom => y + height
+ longest => if width > height then width else height
+ distance => top-left.distance(bottom-right)
+ size => Dimensions(width, height)
+ top-left => Point(x, y)
+ bottom-right => Point(x + width, y + height)
+ center => Point(x + width / 2, y + height / 2)
+ top-center => Point(x + width / 2, top)
+ bottom-center => Point(x + width / 2, bottom)
+ left-center => Point(left, y + height / 2)
+ right-center => Point(right, y + height / 2)
+ corners => [x, y, right, y, right, bottom, x, bottom]

────────────────────
+ This
    - size Dimensions

= This(0, 0, size.width, size.height)

────────────────────
+ This
    - width Coord
    - height Coord
    - point Point

= This(point.x, point.y, width, height)

────────────────────
+ This
    - point Point
    - size Dimensions

= This(point.x, point.y, size.width, size.height)

────────────────────
+ This
    - pt1 Point
    - pt2 Point

= This
    - pt1.x
    - pt1.y
    - pt2.x - pt1.x
    - pt2.y - pt1.y

────────────────────
+ this + other Point

This
    - x + other.x
    - y + other.y
    - width
    - height

────────────────────
+ this + other Rect

This
    - x1
    - y1
    - x2 - x1
    - y2 - y1

.. x1 = min(x, other.x)
.. y1 = min(y, other.y)
.. x2 = max(right, other.right)
.. y2 = max(bottom, other.bottom)

────────────────────
+ this / factor Length

This
    - x
    - y
    - width / factor
    - height / factor

────────────────────
+ pad
    - w Length

pad(w, w)

────────────────────
+ pad
    - w Length
    - h Length

This
    - x + w
    - y + h
    - width - w * 2
    - height - h * 2

────────────────────
+ inflate
    - w Length

inflate(w, w)

────────────────────
+ inflate
    - w Length
    - h Length

This
    - x - w / 2
    - y - h / 2
    - width + w
    - height + h

────────────────────
+ contains
    - point Point

point.x >= x && point.y >= y && point.x <= x + width && point.y <= y + height

────────────────────
+ contains
    - other Rect
    - tolerance Length = 0

horizontal && vertical

.. horizontal = other.left >= left - tolerance && other.right <= right + tolerance
.. vertical = other.top >= top - tolerance && other.bottom <= bottom + tolerance

────────────────────
+ get is-empty

width <= 0 || height <= 0

────────────────────
+ intersection
    - other Rect

This(x1, y1, max(0, x2 - x1), max(0, y2 - y1))

.. x1 = max(left, other.left)
.. y1 = max(top, other.top)
.. x2 = min(right, other.right)
.. y2 = min(bottom, other.bottom)

────────────────────
+ inset
    - edges Insets

This
    - x + edges.left
    - y + edges.top
    - max(0, width - edges.horizontal)
    - max(0, height - edges.vertical)

────────────────────
+ outset
    - edges Insets

This(x - edges.left, y - edges.top, width + edges.horizontal, height + edges.vertical)

────────────────────
+ overlaps
    - other Rect

left <= other.right && right >= other.left && top <= other.bottom && bottom >= other.top

────────────────────
+ get normalized

This
    - min(x, right)
    - min(y, bottom)
    - abs(width)
    - abs(height)

━━━━━━━━━━━━━━━━━━━━
+ Insets is (top Length, right Length, bottom Length, left Length)

+ horizontal => left + right
+ vertical => top + bottom

────────────────────
+ get clamped

Insets
    - nonnegative-span(top)
    - nonnegative-span(right)
    - nonnegative-span(bottom)
    - nonnegative-span(left)

━━━━━━━━━━━━━━━━━━━━
_ nonnegative-span
    - value Length

if is-finite(value) then max(0, value) else 0

━━━━━━━━━━━━━━━━━━━━
+ PathVerb is U8

| path-verb-move
| path-verb-line
| path-verb-cubic
| path-verb-close

────────────────────
+ to String

match this
    |= .path-verb-move
        "move"
    |= .path-verb-line
        "line"
    |= .path-verb-cubic
        "cubic"
    |= .path-verb-close
        "close"
