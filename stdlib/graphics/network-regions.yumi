./curve
./intersection
./network
./path
./point
./primitives
/math

_ network-cut-reach Float = 0.01

━━━━━━━━━━━━━━━━━━━━
+ NetworkBoundary is Tuple

+ segment Index
+ source Index
+ start Float
+ end Float
+ reversed Bool

────────────────────
+ get along

(start <= end) != reversed

━━━━━━━━━━━━━━━━━━━━
+ NetworkRegion

+ id Index
+ path = Path()
+ boundaries [NetworkBoundary]
+ predecessors [Index]
+ sample Point
+ area Float

────────────────────
+ contains
    - point Point

path.contains(point)

────────────────────
+ do copy NetworkRegion

. result = NetworkRegion()
result.id = id
result.path = Path(path)
for boundary in boundaries
    result.boundaries += boundary
for predecessor in predecessors
    result.predecessors += predecessor
result.sample = sample
result.area = area
= result

━━━━━━━━━━━━━━━━━━━━
+ NetworkRegions

+ revision Size
+ regions [NetworkRegion]
+ retired [Index]

────────────────────
+ do pick NetworkRegion?
    - point Point

for region in regions
    =? region if region.contains(point)
= null

────────────────────
+ do copy NetworkRegions

. result = NetworkRegions()
result.revision = revision
for region in regions
    result.regions += region.copy()
for id in retired
    result.retired += id
= result

━━━━━━━━━━━━━━━━━━━━
+ NetworkCrossing is Tuple

+ segment Index
+ parameter Float
+ crossing Index
+ position Point

━━━━━━━━━━━━━━━━━━━━
_ NetworkCuts

+ segment NetworkSegment
+ curve Curve
+ parameters [Float]
+ left Float
+ top Float
+ right Float
+ bottom Float

────────────────────
+ This
    - segment
    - curve

parameters += 0
parameters += 1
left = min(min(curve.anchor1.x, curve.handle-out.x), min(curve.handle-in.x, curve.anchor2.x))
top = min(min(curve.anchor1.y, curve.handle-out.y), min(curve.handle-in.y, curve.anchor2.y))
right = max(max(curve.anchor1.x, curve.handle-out.x), max(curve.handle-in.x, curve.anchor2.x))
bottom = max(max(curve.anchor1.y, curve.handle-out.y), max(curve.handle-in.y, curve.anchor2.y))

────────────────────
+ near Bool
    - other NetworkCuts

overlaps-x && top <= other.bottom + reach && other.top <= bottom + reach

.. reach = network-cut-reach
.. overlaps-x = left <= other.right + reach && other.left <= right + reach

────────────────────
+ do add
    - value Float

=? if !is-finite(value) || value <= 0.000000001 || value >= 0.999999999
for i in 0 .. < parameters.length
    =? if abs(parameters[i] - value) < 0.000000001
    if parameters[i] > value
        parameters.insert(value, i)
        =
parameters += value

━━━━━━━━━━━━━━━━━━━━
_ NetworkArc

+ start Index
+ end Index
+ twin Index
+ curve Curve
+ boundary NetworkBoundary
+ visited Bool

────────────────────
+ This
    - start
    - end
    - twin
    - curve
    - boundary

━━━━━━━━━━━━━━━━━━━━
_ NetworkCycle

+ path = Path()
+ boundaries [NetworkBoundary]
+ area Float
+ sample Point

━━━━━━━━━━━━━━━━━━━━
+ NetworkRegionWorkspace

_ owner VectorNetwork?
_ cached NetworkRegions?
_ cached-revision Size
_ next-id Index = 1
_ tolerance Length = 0.00001
_ nodes [Point]
_ arcs [NetworkArc]
_ cuts [NetworkCuts]
_ hits [CurveIntersection]
_ intersections = IntersectionWorkspace()

────────────────────
+ This
    - tolerance Length = 0.00001

if !is-finite(tolerance) || tolerance <= 0
    ?! Panic("Region tolerance must be positive and finite")
this.tolerance = tolerance

────────────────────
+ do resolve NetworkRegions
    - network VectorNetwork

if owner && owner as Pointer == network as Pointer && cached && cached-revision == network.revision
    = cached
. previous = cached if owner && owner as Pointer == network as Pointer
. result = build(network, previous)
owner = network
cached = result
cached-revision = network.revision
= result

────────────────────
+ resolve-after
    - network VectorNetwork
    - previous NetworkRegions

build(network, previous)

────────────────────
_ do build
    - network VectorNetwork
    - previous NetworkRegions?

nodes.clear()
arcs.clear()
gather-cuts(network)
for cut in cuts
    for i in 1 .. < cut.parameters.length
        add-fragment(cut, cut.parameters[i - 1], cut.parameters[i])
. cycles [NetworkCycle]
for i in 0 .. < arcs.length
    if !arcs[i].visited
        . cycle = walk(i)
        if abs(cycle.area) > tolerance * tolerance
            cycles += cycle
. result = NetworkRegions()
result.revision = network.revision
for cycle in cycles
    if cycle.area > 0
        . region = NetworkRegion()
        region.path = Path(cycle.path)
        region.area = cycle.area
        region.sample = cycle.sample
        for boundary in cycle.boundaries
            region.boundaries += boundary
        result.regions += region
for cycle in cycles
    if cycle.area < 0
        . container NetworkRegion?
        for region in result.regions
            if !network-shared-boundary(region.boundaries, cycle.boundaries)
                if region.path.contains(cycle.sample)
                    if !container || region.area < container.area
                        container = region
        if container
            container.path.add-path(cycle.path)
            for boundary in cycle.boundaries
                container.boundaries += boundary
if previous
    correspond(previous, result)
for region in result.regions
    if !region.id
        region.id = next-id
        next-id += 1
= result

────────────────────
+ do crossings [NetworkCrossing]
    - network VectorNetwork

nodes.clear()
gather-cuts(network)
. result [NetworkCrossing]
for cut in cuts
    for i in 1 .. < cut.parameters.length - 1
        . parameter = cut.parameters[i]
        . position = network-curve-point(cut.curve, parameter)
        if position.distance(cut.curve.anchor1) > tolerance && clears-anchor2
            result += NetworkCrossing(cut.segment.id, parameter, node(position), position)
        .. clears-anchor2 = position.distance(cut.curve.anchor2) > tolerance
nodes.clear()
cuts.clear()
= result

────────────────────
_ do gather-cuts
    - network VectorNetwork

cuts.clear()
for edge in network.segments
    cuts += NetworkCuts(edge, network.curve(edge.id))
for i in 0 .. < cuts.length
    self-cuts(cuts[i])
    for j in i + 1 .. < cuts.length
        if cuts[i].near(cuts[j])
            intersect-cuts(cuts[i], cuts[j])

────────────────────
+ do copy-for NetworkRegionWorkspace
    - network VectorNetwork

. result = NetworkRegionWorkspace(tolerance)
result.owner = network
result.cached = cached.copy() if cached
result.cached-revision = cached-revision
result.next-id = next-id
= result

────────────────────
+ do clear

owner = null
cached = null
nodes.clear()
arcs.clear()
cuts.clear()
hits.clear()
intersections.clear()

────────────────────
_ do intersect-cuts
    - first NetworkCuts
    - second NetworkCuts

. a = first.curve
. b = second.curve
for parameter in [0.0, 1.0]
    . point = network-curve-point(a, parameter)
    . parameter-on-curve = b.get-parameter(point)
    if parameter-on-curve >= 0
        second.add(parameter-on-curve)
    point = network-curve-point(b, parameter)
    parameter-on-curve = a.get-parameter(point)
    if parameter-on-curve >= 0
        first.add(parameter-on-curve)
=? if a == b || a.equals-reverse(b)
hits.clear()
if a.is-line-like && b.is-line-like
    intersect-line-line-scalars
        - hits
        - a.anchor1.x
        - a.anchor1.y
        - a.anchor2.x
        - a.anchor2.y
        - b.anchor1.x
        - b.anchor1.y
        - b.anchor2.x
        - b.anchor2.y
        - 0
        - 0
        - null
        - null
else if a.is-line-like
    intersect-line-curve-scalars
        - hits
        - a.anchor1.x
        - a.anchor1.y
        - a.anchor2.x
        - a.anchor2.y
        - b.anchor1.x
        - b.anchor1.y
        - b.handle-out.x
        - b.handle-out.y
        - b.handle-in.x
        - b.handle-in.y
        - b.anchor2.x
        - b.anchor2.y
        - 0
        - 0
        - null
        - null
else if b.is-line-like
    intersect-curve-line-scalars
        - hits
        - a.anchor1.x
        - a.anchor1.y
        - a.handle-out.x
        - a.handle-out.y
        - a.handle-in.x
        - a.handle-in.y
        - a.anchor2.x
        - a.anchor2.y
        - b.anchor1.x
        - b.anchor1.y
        - b.anchor2.x
        - b.anchor2.y
        - 0
        - 0
        - null
        - null
else
    intersect-curves-reusing(hits, intersections, a, b)
for hit in hits
    . ta = hit.t1
    . tb = hit.t2
    if a.is-line-like
        ta = a.get-parameter(a.anchor1 + (a.anchor2 - a.anchor1) * hit.t1)
    if b.is-line-like
        tb = b.get-parameter(b.anchor1 + (b.anchor2 - b.anchor1) * hit.t2)
    first.add(ta)
    second.add(tb)

────────────────────
_ do self-cuts
    - cut NetworkCuts

. curve = cut.curve
. a = curve.anchor2 - curve.handle-in * 3 + curve.handle-out * 3 - curve.anchor1
. b = curve.anchor1 * 3 - curve.handle-out * 6 + curve.handle-in * 3
. c = (curve.handle-out - curve.anchor1) * 3
. divisor = network-cross(a, b)
=? if abs(divisor) < 0.000000000001
. sum = -network-cross(a, c) / divisor
. product = sum * sum + quotient
    .. quotient = if abs(a.x) >= abs(a.y) then (b.x * sum + c.x) / a.x else (b.y * sum + c.y) / a.y
. discriminant = sum * sum - 4 * product
=? if discriminant <= 0
. first = (sum - sqrt(discriminant)) / 2
. second = (sum + sqrt(discriminant)) / 2
if first >= 0 && second <= 1
    cut.add(first)
    cut.add(second)

────────────────────
_ do node Index
    - point Point

for i in 0 .. < nodes.length
    =? i if nodes[i].distance(point) <= tolerance
nodes += point
= nodes.length - 1

────────────────────
_ do add-fragment
    - cut NetworkCuts
    - start Float
    - end Float

. curve = cut.curve.split-at-range(start, end)
. chord = curve.anchor1.distance(curve.anchor2)
. outgoing = curve.anchor1.distance(curve.handle-out)
. incoming = curve.anchor1.distance(curve.handle-in)
=? if max(chord, max(outgoing, incoming)) <= tolerance
. a = node(curve.anchor1)
. b = node(curve.anchor2)
for arc in arcs
    if arc.start == a && arc.end == b
        if arc.curve.is-line-like && curve.is-line-like
            =
        . quarter = network-curve-point(arc.curve, 0.25)
        . other-quarter = network-curve-point(curve, 0.25)
        if quarter.distance(other-quarter) <= tolerance
            . half = network-curve-point(arc.curve, 0.5)
            . other-half = network-curve-point(curve, 0.5)
            if half.distance(other-half) <= tolerance
                . three-quarter = network-curve-point(arc.curve, 0.75)
                . other-three-quarter = network-curve-point(curve, 0.75)
                if three-quarter.distance(other-three-quarter) <= tolerance
                    =
. edge = cut.segment
. lo = edge.source-start + (edge.source-end - edge.source-start) * start
. hi = edge.source-start + (edge.source-end - edge.source-start) * end
. forward = arcs.length
arcs += NetworkArc(a, b, forward + 1, curve, NetworkBoundary(edge.id, edge.source, lo, hi, false))
arcs += NetworkArc
    - b
    - a
    - forward
    - Curve(curve.anchor2, curve.handle-in, curve.handle-out, curve.anchor1)
    - NetworkBoundary(edge.id, edge.source, lo, hi, true)

────────────────────
_ do walk NetworkCycle
    - start Index

. result = NetworkCycle()
. cycle [Index]
. current = start
while !arcs[current].visited
    . arc = arcs[current]
    arc.visited = true
    cycle += current
    current = successor(current)
. changed = true
while changed && cycle.length > 1
    changed = false
    for i in 0 .. < cycle.length
        . next = if i == cycle.length - 1 then 0 else i + 1
        if arcs[cycle[i]].twin == cycle[next]
            if next == 0
                cycle.remove(i)
                cycle.remove(0)
            else
                cycle.remove(next)
                cycle.remove(i)
            changed = true
            break
=? result if !cycle.length
. first = arcs[cycle[0]].curve
result.path.move-to(first.anchor1)
for id in cycle
    . arc = arcs[id]
    result.path.cubic-curve-to(arc.curve.handle-out, arc.curve.handle-in, arc.curve.anchor2)
    result.boundaries += arc.boundary
    result.area += network-curve-area(arc.curve)
result.path.close()
. point = network-curve-point(first, 0.5)
. delta = network-curve-point(first, 0.501) - network-curve-point(first, 0.499)
if delta.length > 0
    result.sample = point + Point(-delta.y, delta.x) * (tolerance * 4 / delta.length)
else
    result.sample = point
= result

────────────────────
_ do successor Index
    - id Index

. arc = arcs[id]
. reverse-angle = network-arc-angle(arcs[arc.twin].curve)
. best = arc.twin
. best-turn = 2 * π
for i in 0 .. < arcs.length
    if arcs[i].start == arc.end && i != arc.twin
        . angle = network-arc-angle(arcs[i].curve)
        . turn = reverse-angle - angle
        if turn < 0
            turn += 2 * π
        if turn < best-turn
            best = i
            best-turn = turn
= best

────────────────────
_ do correspond
    - previous NetworkRegions
    - result NetworkRegions

for region in result.regions
    for old in previous.regions
        . shared = false
        for a in region.boundaries
            for b in old.boundaries
                if a.source == b.source && a.along == b.along && network-overlaps(a, b)
                    shared = true
        if shared
            region.predecessors += old.id
    if !region.predecessors.length
        for old in previous.regions
            if old.contains(region.sample)
                region.predecessors += old.id
for old in previous.regions
    . count Size = 0
    . successor NetworkRegion?
    for region in result.regions
        if network-has-id(region.predecessors, old.id)
            count += 1
            successor = region
    if count == 1 && successor!.predecessors.length == 1
        successor!.id = old.id
    else
        result.retired += old.id

━━━━━━━━━━━━━━━━━━━━
+ network-cross
    - a Point
    - b Point

a.x * b.y - a.y * b.x

━━━━━━━━━━━━━━━━━━━━
_ network-arc-angle Float
    - curve Curve

atan2(delta.y, delta.x)

.. delta = network-curve-point(curve, 0.0001) - curve.anchor1

━━━━━━━━━━━━━━━━━━━━
+ do network-curve-area
    - curve Curve

. coefficients [Point]
coefficients += curve.anchor1
coefficients += (curve.handle-out - curve.anchor1) * 3
coefficients += (curve.anchor1 - curve.handle-out * 2 + curve.handle-in) * 3
coefficients += curve.anchor2 - curve.handle-in * 3 + curve.handle-out * 3 - curve.anchor1
. result Float
for i in 0 .. < 4
    for j in 1 .. < 4
        result += network-cross(coefficients[i], coefficients[j]) * j / (i + j)
= result / 2

━━━━━━━━━━━━━━━━━━━━
_ do network-shared-boundary Bool
    - first [NetworkBoundary]
    - second [NetworkBoundary]

for a in first
    for b in second
        if a.source == b.source && network-overlaps(a, b)
            = true
= false

━━━━━━━━━━━━━━━━━━━━
_ network-overlaps Bool
    - a NetworkBoundary
    - b NetworkBoundary

overlap-end > max(min(a.start, a.end), min(b.start, b.end)) + 0.000000001

.. overlap-end = min(max(a.start, a.end), max(b.start, b.end))
