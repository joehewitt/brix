━━━━━━━━━━━━━━━━━━━━
+ do vector-path Path?
    - ops [PathOp]

=? if !ops

//gui.vector.geometry-parses ++
. path = Path()
. has-current = false
. current = Point(0, 0)
. subpath-start = Point(0, 0)
for op in ops
    if op is PathMoveTo
        . move = op as PathMoveTo
        current = Point(move.x, move.y)
        subpath-start = current
        has-current = true
        path.move-to(current)
    else if op is PathLineTo
        . segment = op as PathLineTo
        vector-require-current(has-current)
        current = Point(segment.x, segment.y)
        path.line-to(current)
    else if op is PathCubicTo
        . curve = op as PathCubicTo
        vector-require-current(has-current)
        current = Point(curve.x, curve.y)
        path.cubic-curve-to((curve.c1x, curve.c1y), (curve.c2x, curve.c2y), current)
    else if op is PathQuadraticTo
        . curve = op as PathQuadraticTo
        vector-require-current(has-current)
        current = Point(curve.x, curve.y)
        path.quadratic-curve-to(curve.cx, curve.cy, current.x, current.y)
    else if op is PathArcTo
        . arc = op as PathArcTo
        vector-require-current(has-current)
        vector-append-arc(path, current, arc)
        current = Point(arc.x, arc.y)
    else
        vector-require-current(has-current)
        path.close()
        current = subpath-start
= path

━━━━━━━━━━━━━━━━━━━━
_ do vector-require-current
    - has-current Bool

?! Panic("Vector path operation requires a current point")
    if !has-current

━━━━━━━━━━━━━━━━━━━━
_ do vector-append-arc
    - path Path
    - start Point
    - arc PathArcTo

. end = Point(arc.x, arc.y)
=? if start == end

. rx = abs(arc.rx)
. ry = abs(arc.ry)
if rx == 0 || ry == 0
    path.line-to(end)
    =

. phi = arc.rotation as Radians
. cos-phi = cos(phi)
. sin-phi = sin(phi)
. half-dx = (start.x - end.x) / 2
. half-dy = (start.y - end.y) / 2
. x1p = cos-phi * half-dx + sin-phi * half-dy
. y1p = -sin-phi * half-dx + cos-phi * half-dy

. radius-scale = x1p * x1p / (rx * rx) + y1p * y1p / (ry * ry)
if radius-scale > 1
    . correction = sqrt(radius-scale)
    rx *= correction
    ry *= correction

. rx2 = rx * rx
. ry2 = ry * ry
. x1p2 = x1p * x1p
. y1p2 = y1p * y1p
. denominator = rx2 * y1p2 + ry2 * x1p2
. numerator = rx2 * ry2 - denominator
. sign Float = 1
if arc.large == arc.sweep
    sign = -1
. coefficient = sign * sqrt(max(0, numerator / denominator))
. cxp = coefficient * (rx * y1p / ry)
. cyp = coefficient * (-ry * x1p / rx)
. cx = cos-phi * cxp - sin-phi * cyp + (start.x + end.x) / 2
. cy = sin-phi * cxp + cos-phi * cyp + (start.y + end.y) / 2

. ux = (x1p - cxp) / rx
. uy = (y1p - cyp) / ry
. vx = (-x1p - cxp) / rx
. vy = (-y1p - cyp) / ry
. theta = atan2(uy, ux)
. delta = vector-angle(ux, uy, vx, vy)
if !arc.sweep && delta > 0
    delta -= 2 * π
else if arc.sweep && delta < 0
    delta += 2 * π

. segment-count = ceil(abs(delta) / (π / 2)) as Size
. segment-delta = delta / segment-count
. segment Index = 0
while segment < segment-count
    . a1 = theta + segment-delta * segment
    . a2 = a1 + segment-delta
    . alpha = 4.0 / 3.0 * tan((a2 - a1) / 4.0)
    . p1 = vector-ellipse-point(cx, cy, rx, ry, cos-phi, sin-phi, a1)
    . p2 = vector-ellipse-point(cx, cy, rx, ry, cos-phi, sin-phi, a2)
    if segment + 1 == segment-count
        p2 = end
    . d1 = vector-ellipse-derivative(rx, ry, cos-phi, sin-phi, a1)
    . d2 = vector-ellipse-derivative(rx, ry, cos-phi, sin-phi, a2)
    path.cubic-curve-to(p1 + d1 * alpha, p2 - d2 * alpha, p2)
    segment += 1

━━━━━━━━━━━━━━━━━━━━
_ vector-angle Radians
    - ux Coord
    - uy Coord
    - vx Coord
    - vy Coord

atan2(ux * vy - uy * vx, ux * vx + uy * vy)

━━━━━━━━━━━━━━━━━━━━
_ vector-ellipse-point Point
    - cx Coord
    - cy Coord
    - rx Length
    - ry Length
    - cos-phi Float
    - sin-phi Float
    - angle Radians

Point(cx + cos-phi * x - sin-phi * y, cy + sin-phi * x + cos-phi * y)

.. x = rx * cos(angle)
.. y = ry * sin(angle)

━━━━━━━━━━━━━━━━━━━━
_ vector-ellipse-derivative Point
    - rx Length
    - ry Length
    - cos-phi Float
    - sin-phi Float
    - angle Radians

Point(cos-phi * x - sin-phi * y, sin-phi * x + cos-phi * y)

.. x = -rx * sin(angle)
.. y = ry * cos(angle)
