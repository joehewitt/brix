━━━━━━━━━━━━━━━━━━━━
+ PathMoveTo (M) is (x Coord, y Coord)

━━━━━━━━━━━━━━━━━━━━
+ PathLineTo (L) is (x Coord, y Coord)

━━━━━━━━━━━━━━━━━━━━
+ PathCubicTo (C) is (c1x Coord, c1y Coord, c2x Coord, c2y Coord, x Coord, y Coord)

━━━━━━━━━━━━━━━━━━━━
+ PathQuadraticTo (Q) is (cx Coord, cy Coord, x Coord, y Coord)

━━━━━━━━━━━━━━━━━━━━
+ PathArcTo (A) is (rx Coord, ry Coord, rotation Degrees, large Bool, sweep Bool, x Coord, y Coord)

━━━━━━━━━━━━━━━━━━━━
+ PathClose (Z) is Tuple

━━━━━━━━━━━━━━━━━━━━
+ PathOp is Union

| PathMoveTo
| PathLineTo
| PathCubicTo
| PathQuadraticTo
| PathArcTo
| PathClose

━━━━━━━━━━━━━━━━━━━━
+ VectorPath is GraphicNode

_ vector-path-ops [PathOp]

────────────────────
+ This

────────────────────
+ This
    - d

vector-path-ops = d

────────────────────
+ do get d [PathOp]

for op in vector-path-ops
    <= op

────────────────────
+ do d = value [PathOp]

. next [PathOp]
for op in value
    next += op
vector-path-ops = next
changed(graphic-change-source /or/ graphic-change-geometry)

────────────────────
+ do get operations <PathOp>

for op in vector-path-ops
    <= op

────────────────────
+ vector-path-geometry Path?

vector-path(vector-path-ops)

────────────────────
+ do this += op PathOp

vector-path-ops += op
changed(graphic-change-source /or/ graphic-change-geometry)

────────────────────
+ do clear

=? if !vector-path-ops
vector-path-ops.clear()
changed(graphic-change-source /or/ graphic-change-geometry)

────────────────────
+ do draw <Path>

. path = vector-path-geometry()
if path
    <= path

