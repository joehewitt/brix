+ SineWave is GraphicNode

_ sine-start Radians
_ sine-waves Float = 2
_ sine-origin Point
_ sine-size Dimensions

────────────────────
+ get start Radians

sine-start

────────────────────
+ do start = value Radians

=? if sine-start == value
sine-start = value
changed(graphic-change-source /or/ graphic-change-geometry)

────────────────────
+ get waves Float

sine-waves

────────────────────
+ do waves = value Float

=? if sine-waves == value
sine-waves = value
changed(graphic-change-source /or/ graphic-change-geometry)

────────────────────
+ get origin Point

sine-origin

────────────────────
+ do origin = value Point

=? if sine-origin == value
sine-origin = value
changed(graphic-change-source /or/ graphic-change-geometry)

────────────────────
+ get size Dimensions

sine-size

────────────────────
+ do size = value Dimensions

=? if sine-size == value
sine-size = value
changed(graphic-change-source /or/ graphic-change-geometry)

────────────────────
+ do draw <Path>

. path = Path()
. period = (π * 2) * sine-waves
. amplitude Coord = sine-size.height
. resolution Length = 5.0
. steps = sine-size.width / resolution
. increment = period / steps
. angle Radians = sine-start
for x in sine-origin.x .. < sine-origin.x + sine-size.width by resolution
    . y = sine-origin.y + sin(angle) * amplitude
    angle += increment
    path.line-to(x, y)
<= path

