+ Circle is GraphicNode

_ circle-center Point
_ circle-radius Length

────────────────────
+ This
    - center Point
    - radius Length

circle-center = center
circle-radius = radius

────────────────────
+ get center Point

circle-center

────────────────────
+ do center = value Point

=? if circle-center == value
circle-center = value
changed(graphic-change-source /or/ graphic-change-geometry)

────────────────────
+ get radius Length

circle-radius

────────────────────
+ do radius = value Length

=? if circle-radius == value
circle-radius = value
changed(graphic-change-source /or/ graphic-change-geometry)

────────────────────
+ do draw <Path>

<= circle(circle-center, abs(circle-radius))

