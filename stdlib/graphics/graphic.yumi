. result = graphic-node-id-sequence
graphic-node-id-sequence += 1
= result

━━━━━━━━━━━━━━━━━━━━
+ do reserve-graphic-node-id
    - id Size

if graphic-node-id-sequence <= id
    graphic-node-id-sequence = id + 1

━━━━━━━━━━━━━━━━━━━━
+ vector-appearance-over VectorAppearance
    - node VectorNode
    - inherited VectorAppearance

inherited.over
    - node.$fill
    - node.$stroke
    - node.$stroke-width
    - node.$stroke-alignment
    - node.$stroke-cap
    - node.$stroke-join
    - node.$fill-rule

━━━━━━━━━━━━━━━━━━━━
+ do vector-assign-stroke-layers
    - node VectorNode
    - layers [StrokeLayer]

if layers.length != 1 || !layers[0].visible
    node.stroke = layers as Stroke
    =
. layer = layers[0]
node.stroke = layer.color
if layer.width
    node.stroke-width = layer.width
if layer.alignment
    node.stroke-alignment = layer.alignment
if layer.join
    node.stroke-join = layer.join
if layer.cap
    node.stroke-cap = layer.cap
