━━━━━━━━━━━━━━━━━━━━
+ GraphicNode
    is VectorNode
    is VectorGeometrySource
    using VectorPaintStyle
    using VectorCompositeStyle

+ id Size = next-graphic-node-id()
+ name String
+ parent GraphicContainer?
+ previous GraphicNode?
+ next GraphicNode?
+ locked Bool
+ cache-policy GraphicsCachePolicy = GraphicsCachePolicy.retained-cache

_ geometry-version Size = 1
_ source-version Size = 1
_ appearance-version Size = 1
_ structure-version Size = 1
_ composite-version Size = 1
_ metadata-version Size = 1
_ output-version Size = 1
_ pending-kinds U8
_ source-paths [Path]?
_ source-geometry-version Size
_ source-frame Size
_ source-bounds Rect
_ has-source-bounds Bool
_ evaluation-bounds Rect
_ preparation GraphicPreparation?
_ computed-paths [Path]?
_ computed-output-version Size
_ computed-frame Size
_ computed-bounds Rect
_ has-computed-bounds Bool

────────────────────
+ get geometry-revision

geometry-version

────────────────────
+ get appearance-revision

appearance-version

────────────────────
+ get structure-revision

structure-version

────────────────────
+ get composite-revision

composite-version

────────────────────
+ get metadata-revision

metadata-version

────────────────────
+ get revision

output-version

────────────────────
+ get has-pending-change Bool

pending-kinds != 0

────────────────────
+ do merge-pending-change
    - kinds U8

pending-kinds = pending-kinds /or/ kinds

────────────────────
+ get paths [Path]

computed-paths ?? List'Path()

────────────────────
+ get effective-cache-policy GraphicsCachePolicy

graphic-effective-cache-policy(this)

────────────────────
+ do get bounding-box

update(last-evaluation-bounds())
. found = false
. result Rect
for path in paths
    if path.count
        result = if !found then path.bounding-box else result + path.bounding-box
        found = true
= result

────────────────────
+ do copy-state-to
    - target GraphicNode
    - preserve-id Bool = true

if preserve-id
    target.id = id
target.name = name
target.locked = locked
target.cache-policy = cache-policy
style-copy-authored-state(this, target)
if style-has-authored-property(this, "VectorCompositeStyle", "effects")
    target.effects = $effects.copy()

────────────────────
+ do begin-update

. root = graphic-root
if root
    root.graphic-begin-update()

────────────────────
+ do checkpoint

. root = graphic-root
if root
    root.graphic-checkpoint()

────────────────────
+ do end-update

. root = graphic-root
=? if !root
root.graphic-end-update()

────────────────────
+ do changed
    - kinds U8

. root = graphic-root
if !root
    pending-kinds = pending-kinds /or/ kinds
    apply-pending-change()
    =
root.graphic-queue-change(this, kinds)

────────────────────
+ do get graphic-root GraphicContainer?

. result GraphicContainer?
result = parent
while result && result.graphic-container-parent
    result = result.graphic-container-parent
= result

────────────────────
+ do apply-pending-change U8

. kinds = pending-kinds
pending-kinds = 0
if graphic-change-includes(kinds, graphic-change-source)
    source-version += 1
    source-paths = null
    has-source-bounds = false
if graphic-change-includes(kinds, graphic-change-geometry)
    geometry-version += 1
    computed-paths = null
    has-computed-bounds = false
if graphic-change-includes(kinds, graphic-change-appearance)
    appearance-version += 1
if graphic-change-includes(kinds, graphic-change-structure)
    structure-version += 1
    geometry-version += 1
    source-version += 1
    source-paths = null
    has-source-bounds = false
    computed-paths = null
    has-computed-bounds = false
if graphic-change-includes(kinds, graphic-change-composite)
    composite-version += 1
if graphic-change-includes(kinds, graphic-change-metadata)
    metadata-version += 1
if graphic-change-includes(kinds, graphic-change-intrinsic)
    metadata-version += 1
if graphic-change-includes(kinds, graphic-change-effects)
    computed-paths = null
if kinds /and/ (output-kinds /or/ graphic-change-effects)
    output-version += 1
.. output-kinds = content-kinds /or/ graphic-change-structure /or/ graphic-change-composite
.. content-kinds = graphic-change-source /or/ graphic-change-geometry /or/ graphic-change-appearance
= kinds

────────────────────
+ do update
    - bounds Rect

if preparation
    preparation(bounds)
. root = graphic-root
if root && root.graphic-update-depth
    root.graphic-checkpoint()
. frame Size
if root
    frame = root.graphic-frame-version
. policy = effective-cache-policy
. reusable = computed-paths != null
reusable = reusable && computed-output-version == output-version
reusable = reusable && has-computed-bounds && computed-bounds == bounds
if policy == .frame-cache
    reusable = reusable && computed-frame == frame
else if policy == .no-cache
    reusable = false
=? if reusable

. source-reusable = source-paths != null
source-reusable = source-reusable && source-geometry-version == source-version
source-reusable = source-reusable && has-source-bounds && source-bounds == bounds
if policy == .frame-cache
    source-reusable = source-reusable && source-frame == frame
else if policy == .no-cache
    source-reusable = false
if !source-reusable
    . result [Path]
    evaluation-bounds = bounds
    for path in draw(bounds)
        result += Path(path)
    source-paths = result
    source-geometry-version = source-version
    source-frame = frame
    source-bounds = bounds
    has-source-bounds = true
computed-paths = apply-path-effects(source-paths ?? List'Path(), geometry-version, frame)
computed-output-version = output-version
computed-frame = frame
computed-bounds = bounds
has-computed-bounds = true

────────────────────
+ do draw <Path>

. empty [Path]
<<= empty

────────────────────
+ draw <Path>
    - bounds Rect

draw()

────────────────────
+ apply-path-effects [Path]
    - source [Path]
    - input-version Size
    - frame Size

$effects.apply(source)

────────────────────
+ do paint
    - canvas Canvas
    - inherited VectorAppearance
    - outer-effects VectorEffects? = null

=? if !$visible || $opacity <= 0%%
do use canvas.saved-state
    if $opacity < 1%%
        canvas.begin-opacity($opacity)
    if $transform
        canvas.transform($transform!)
    paint-content(canvas, vector-appearance-over(this, inherited), outer-effects)
    if $opacity < 1%%
        canvas.end-opacity()

────────────────────
+ do markup-style-domains-changed
    - mask U32

. kinds = vector-style-change-kinds(mask)
if kinds
    changed(kinds)

────────────────────
+ do paint-content
    - canvas Canvas
    - appearance VectorAppearance
    - outer-effects VectorEffects?

. bounds = Rect(0, 0, canvas.width, canvas.height)
update(bounds)
. painted = if outer-effects then outer-effects.apply(paths) else paths
paint-appearance(canvas, painted, appearance)

────────────────────
+ do reset

computed-paths = null
has-computed-bounds = false
source-paths = null
has-source-bounds = false

────────────────────
+ do transform-paths
    - matrix Matrix

update(last-evaluation-bounds())
for path in paths
    path.transform(matrix)

────────────────────
+ do apply-transform
    - matrix Matrix

transform-paths(matrix)

────────────────────
+ do translate
    - offset Point

transform-paths(matrix-from-translation(offset))

────────────────────
+ do scale
    - bbox-start Rect
    - bbox-end Rect

update(last-evaluation-bounds())
for path in paths
    path.scale(bbox-start, bbox-end)

────────────────────
+ do mirror-x
    - cx Coord

update(last-evaluation-bounds())
for path in paths
    path.mirror-x(cx)

────────────────────
+ do mirror-y
    - cy Coord

update(last-evaluation-bounds())
for path in paths
    path.mirror-y(cy)

────────────────────
+ do mirror
    - center Point

update(last-evaluation-bounds())
for path in paths
    path.mirror(center)

────────────────────
_ last-evaluation-bounds Rect

if has-computed-bounds then computed-bounds else Rect()

────────────────────
+ do replace
    - child GraphicNode
    - replacement GraphicNode

child.replace(replacement)

────────────────────
+ do replace
    - replacement GraphicNode

. owner = parent
=? if !owner
owner.graphic-insert(replacement, this)
owner.graphic-remove(this)

