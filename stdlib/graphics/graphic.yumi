+ graphic-change-geometry U8 = 1
+ graphic-change-appearance U8 = 2
+ graphic-change-structure U8 = 4
+ graphic-change-composite U8 = 8
+ graphic-change-metadata U8 = 16
+ graphic-change-intrinsic U8 = 32
+ graphic-change-effects U8 = 64
+ graphic-change-source U8 = 128

_ graphic-node-id-sequence Size = 1

━━━━━━━━━━━━━━━━━━━━
+ GraphicsCachePolicy is U8

| retained-cache
| frame-cache
| no-cache

━━━━━━━━━━━━━━━━━━━━
+ GraphicsCacheStamp is Tuple

+ version Size
+ bounds Rect
+ frame Size

────────────────────
+ reuses Bool
    - policy GraphicsCachePolicy
    - cached GraphicsCacheStamp?

|? !cached || policy == GraphicsCachePolicy.no-cache
    false
??
    cached.version == version && cached.bounds == bounds && (is-retained || cached.frame == frame)

.. is-retained = policy == GraphicsCachePolicy.retained-cache

━━━━━━━━━━━━━━━━━━━━
+ do vector-style-change-kinds U8
    - mask U32

= geometry /or/ appearance /or/ composite /or/ effects

.. geometry = vector-style-domain-kinds(mask, "vector-geometry", graphic-change-geometry)
.. appearance = vector-style-domain-kinds(mask, "vector-appearance", graphic-change-appearance)
.. composite = vector-style-domain-kinds(mask, "vector-composite", graphic-change-composite)
.. effects = vector-style-domain-kinds(mask, "vector-effects", graphic-change-effects)

━━━━━━━━━━━━━━━━━━━━
_ vector-style-domain-kinds U8
    - mask U32
    - name String
    - change U8

if domain >= 0 && (mask /and/ (1u32 /lshift/ (domain as Size))) != 0 then change else 0

.. domain = style-domain-named(name)

