
./curve
./curve-kernels
./path
./point
./primitives
./utils
/math
/stream/aggregate

_ hull-epsilon = 1e-9
_ clip-call-limit = 4096
_ clip-recursion-limit = 40
_ three-fourths = 3.0 / 4.0
_ four-ninths = 4.0 / 9.0

━━━━━━━━━━━━━━━━━━━━
+ PathIntersection is Tuple

+ path1 Path?
+ path2 Path?
+ intersections [CurveIntersection]
+ equivalent Bool

━━━━━━━━━━━━━━━━━━━━
+ CurveIntersection is Tuple

+ t1 PointOnCurve
+ t2 PointOnCurve
+ path1 Path?
+ path2 Path?

────────────────────
+ do normalize

. nt1 = t1
if path1
    if t1 >= path1.curve-count
        nt1 = 0

. nt2 = t2
if path2
    if t2 >= path2.curve-count
        nt2 = 0

= CurveIntersection
    - nt1
    - nt2
    - path1
    - path2

━━━━━━━━━━━━━━━━━━━━
+ IntersectionWorkspace
    is Usable'Void

` Caller-owned storage for repeated intersection queries. Returned lists and pooled subpaths are
` valid until this workspace is cleared, released, or used again. A workspace must not be shared
` by overlapping calls; use a distinct workspace for nested or concurrent queries.
+ growth-count Size
+ clear-count Size
+ fallback-allocation-count Size

_ in-use = false
_ intersection-index Size
_ path-index Size
_ intersection-lists [[CurveIntersection]]
_ paths [Path]
_ subpaths1 [PathSubpathSpan]
_ subpaths2 [PathSubpathSpan]
_ empty-path = Path()
_ counter = Counter()
_ empty-intersections [CurveIntersection]

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do get retained-capacity Size

. capacity = intersection-lists.capacity + paths.capacity
capacity += subpaths1.capacity + subpaths2.capacity + empty-intersections.capacity
for intersections in intersection-lists
    capacity += intersections.capacity
for path in paths
    capacity += path.command-capacity + path.coord-capacity
= capacity

────────────────────
+ get retained-bytes Size

retained-capacity * 8

────────────────────
+ do clear

for intersections in intersection-lists
    clear-curve-intersection-list(intersections)
for path in paths
    path.clear()
clear-subpath-span-list(subpaths1, empty-path.commands)
clear-subpath-span-list(subpaths2, empty-path.commands)
intersection-index = 0
path-index = 0
counter.count = 0
clear-count += 1
//graphics.geometry.scratch.clears ++

────────────────────
+ do trim

?! Panic("Cannot trim an intersection workspace while it is in use")
    if in-use
clear()
for intersections in intersection-lists
    intersections.trim()
for path in paths
    path.trim()
intersection-lists.trim()
paths.trim()
subpaths1.trim()
subpaths2.trim()
empty-intersections.trim()

────────────────────
+ do release

?! Panic("Cannot release an intersection workspace while it is in use")
    if in-use
clear()
for intersections in intersection-lists
    intersections.release()
for path in paths
    path.release()
intersection-lists.release()
paths.release()
subpaths1.release()
subpaths2.release()
empty-intersections.release()

━━━━━━━━━━━━━━━━━━━━
+ do intersect-paths
    - path1 Path
    - path2 Path

    ` Doesn't currently work!
    - should-test-closer = false
    - should-ignore-lines = false

. results [PathIntersection]
. workspace = IntersectionWorkspace()
= intersect-paths-reusing(results, workspace, path1, path2, should-test-closer, should-ignore-lines)

━━━━━━━━━━━━━━━━━━━━
+ do intersect-paths-reusing
    - results [PathIntersection]
    - workspace IntersectionWorkspace
    - path1 Path
    - path2 Path

    ` Doesn't currently work!
    - should-test-closer = false
    - should-ignore-lines = false

?! Panic("Intersection workspace is already in use")
    if workspace.in-use

. capacity-before = workspace.retained-capacity
workspace.in-use = true
. completed = false
do finally
    if !completed
        clear-path-intersection-list(results, workspace.empty-intersections)
        workspace.clear()
    . capacity-after = workspace.retained-capacity
    if capacity-after > capacity-before
        workspace.growth-count += 1
        //graphics.geometry.scratch.growth ++
    //graphics.geometry.scratch.retained-capacity += capacity-after
    workspace.in-use = false

clear-path-intersection-list(results, workspace.empty-intersections)
workspace.clear()
path1.append-subpath-spans(workspace.subpaths1)
path2.append-subpath-spans(workspace.subpaths2)

//+graphics.intersect.paths.total
//graphics.intersect.paths.calls ++

for subpath1 in workspace.subpaths1
    . l1 = subpath1.curve-count

    for subpath2 in workspace.subpaths2
        . l2 = subpath2.curve-count

        . all-closed = !should-test-closer || (subpath1.is-closed && subpath2.is-closed)
        . equal-count = 0
        . intersections = acquire-intersection-list(workspace)

        if all-closed && (!should-ignore-lines || (l1 > 1 && l2 > 1))
            . pathref1 = path1
            if subpath1.command-start != 0 || subpath1.command-end != path1.count
                pathref1 = subpath1.materialize(acquire-intersection-path(workspace))

            . pathref2 = path2
            if subpath2.command-start != 0 || subpath2.command-end != path2.count
                pathref2 = subpath2.materialize(acquire-intersection-path(workspace))

            if !should-test-closer && l1 == 1
                . line1 = first-subpath-curve(subpath1)
                if line1.found && line-like-scalars(line1.x1, line1.y1, line1.hox, line1.hoy, line1.hix, line1.hiy, line1.x2, line1.y2)
                    //+graphics.intersect.line-path
                    intersect-line-path-scalars()
                        - intersections
                        - pathref2
                        - line1.x1
                        - line1.y1
                        - line1.x2
                        - line1.y2
                        - 0
                        - pathref1
                        • line-is-first true
                    //-graphics.intersect.line-path
                    append-line-path-intersection(results, intersections, pathref1, pathref2)
                    continue

            if !should-test-closer && l2 == 1
                . line2 = first-subpath-curve(subpath2)
                if line2.found && line-like-scalars(line2.x1, line2.y1, line2.hox, line2.hoy, line2.hix, line2.hiy, line2.x2, line2.y2)
                    //+graphics.intersect.line-path
                    intersect-line-path-scalars()
                        - intersections
                        - pathref1
                        - line2.x1
                        - line2.y1
                        - line2.x2
                        - line2.y2
                        - 0
                        - pathref2
                        - false
                    //-graphics.intersect.line-path
                    append-line-path-intersection(results, intersections, pathref1, pathref2)
                    continue

            //+graphics.intersect.curve-pairs
            . span1 = subpath1.span
            . span2 = subpath2.span
            . i Index
            for command1 in subpath1.command-start .. < subpath1.command-end
                . curve1 = span-curve-at(span1, command1)
                if !curve1.found
                    continue

                . j Index
                for command2 in subpath2.command-start .. < subpath2.command-end
                    . curve2 = span-curve-at(span2, command2)
                    if !curve2.found
                        continue

                    //graphics.intersect.curve-pairs-tested ++
                    if curves-equal-scalars(curve1.x1, curve1.y1, curve1.hox, curve1.hoy, curve1.hix, curve1.hiy, curve1.x2, curve1.y2, curve2.x1, curve2.y1, curve2.hox, curve2.hoy, curve2.hix, curve2.hiy, curve2.x2, curve2.y2) || curves-equal-reverse-scalars(curve1.x1, curve1.y1, curve1.hox, curve1.hoy, curve1.hix, curve1.hiy, curve1.x2, curve1.y2, curve2.x1, curve2.y1, curve2.hox, curve2.hoy, curve2.hix, curve2.hiy, curve2.x2, curve2.y2)
                        equal-count += 1
                        j += 1
                        continue

                    . is-line1 = line-like-scalars()
                        - curve1.x1
                        - curve1.y1
                        - curve1.hox
                        - curve1.hoy
                        - curve1.hix
                        - curve1.hiy
                        - curve1.x2
                        - curve1.y2
                    . is-line2 = line-like-scalars()
                        - curve2.x1
                        - curve2.y1
                        - curve2.hox
                        - curve2.hoy
                        - curve2.hix
                        - curve2.hiy
                        - curve2.x2
                        - curve2.y2
                    .. boxes-overlap = control-boxes-overlap-scalars()
                        - curve1.x1
                        - curve1.y1
                        - curve1.hox
                        - curve1.hoy
                        - curve1.hix
                        - curve1.hiy
                        - curve1.x2
                        - curve1.y2
                        - curve2.x1
                        - curve2.y1
                        - curve2.hox
                        - curve2.hoy
                        - curve2.hix
                        - curve2.hiy
                        - curve2.x2
                        - curve2.y2

                    if is-line1 && is-line2
                        //graphics.intersect.line-line-branches ++
                        //+graphics.intersect.line-line
                        intersect-line-line-scalars()
                            - intersections
                            - curve1.x1
                            - curve1.y1
                            - curve1.x2
                            - curve1.y2
                            - curve2.x1
                            - curve2.y1
                            - curve2.x2
                            - curve2.y2
                            - i
                            - j
                            - pathref1
                            - pathref2
                        //-graphics.intersect.line-line
                    else if is-line1
                        //graphics.intersect.curve-line-branches ++
                        //+graphics.intersect.curve-line
                        intersect-line-curve-scalars()
                            - intersections
                            - curve1.x1
                            - curve1.y1
                            - curve1.x2
                            - curve1.y2
                            - curve2.x1
                            - curve2.y1
                            - curve2.hox
                            - curve2.hoy
                            - curve2.hix
                            - curve2.hiy
                            - curve2.x2
                            - curve2.y2
                            - i
                            - j
                            - pathref1
                            - pathref2
                        //-graphics.intersect.curve-line
                    else if is-line2
                        //graphics.intersect.curve-line-branches ++
                        //+graphics.intersect.curve-line
                        intersect-curve-line-scalars()
                            - intersections
                            - curve1.x1
                            - curve1.y1
                            - curve1.hox
                            - curve1.hoy
                            - curve1.hix
                            - curve1.hiy
                            - curve1.x2
                            - curve1.y2
                            - curve2.x1
                            - curve2.y1
                            - curve2.x2
                            - curve2.y2
                            - i
                            - j
                            - pathref1
                            - pathref2
                        //-graphics.intersect.curve-line
                    else if boxes-overlap
                        . c1-anchor1 = Point(curve1.x1, curve1.y1)
                        . c1-handle-out = Point(curve1.hox, curve1.hoy)
                        . c1-handle-in = Point(curve1.hix, curve1.hiy)
                        . c1-anchor2 = Point(curve1.x2, curve1.y2)
                        . c1 = Curve()
                            - c1-anchor1
                            - c1-handle-out
                            - c1-handle-in
                            - c1-anchor2
                            - curve1.type

                        . c2-anchor1 = Point(curve2.x1, curve2.y1)
                        . c2-handle-out = Point(curve2.hox, curve2.hoy)
                        . c2-handle-in = Point(curve2.hix, curve2.hiy)
                        . c2-anchor2 = Point(curve2.x2, curve2.y2)
                        . c2 = Curve()
                            - c2-anchor1
                            - c2-handle-out
                            - c2-handle-in
                            - c2-anchor2
                            - curve2.type
                        //graphics.intersect.curve-curve-branches ++
                        //+graphics.intersect.curve-curve
                        . hit-start = intersections.length
                        refine-curve-curve()
                            - intersections
                            - reset-intersection-counter(workspace)
                            - c1
                            - c2
                            - i
                            - j
                            - pathref1
                            - pathref2
                        polish-curve-intersections(intersections, hit-start, c1, c2, i, j)
                        //-graphics.intersect.curve-curve
                    j += 1
                i += 1
            //-graphics.intersect.curve-pairs
            append-path-intersection
                - results
                - intersections
                - pathref1
                - pathref2
                - l1 == l2 && equal-count == l1

//-graphics.intersect.paths.total
completed = true
= results

━━━━━━━━━━━━━━━━━━━━
