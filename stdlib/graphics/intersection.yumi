━━━━━━━━━━━━━━━━━━━━
+ do intersect-line-line
    - out [CurveIntersection]
    - c1 Curve
    - c2 Curve
    - i1 Index
    - i2 Index
    - p1 Path?
    - p2 Path?

. intr = line-line-intersection-scalars
    - c1.anchor1.x
    - c1.anchor1.y
    - c1.anchor2.x
    - c1.anchor2.y
    - c2.anchor1.x
    - c2.anchor1.y
