//-graphics.intersect.post.sort

//+graphics.intersect.post.distinct
. has-last = false
. last-t1 PointOnCurve
. last-t2 PointOnCurve
. write Index

for intr in intersections
    if has-last && abs(intr.t1 - last-t1) < tolerance && abs(intr.t2 - last-t2) < tolerance
        //graphics.intersect.post.numeric-duplicates ++
        continue

    intersections[write] = intr
    write += 1
    last-t1 = intr.t1
    last-t2 = intr.t2
    has-last = true

if write < intersections.length
    -= intersections[write ...]
//-graphics.intersect.post.distinct
= intersections

