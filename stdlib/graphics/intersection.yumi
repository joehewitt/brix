_ do first-subpath-curve
    - subpath PathSubpathSpan

for command-index in subpath.command-start .. < subpath.command-end
    . curve = span-curve-at(subpath.span, command-index)
    if curve.found
        = curve

= (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0)

━━━━━━━━━━━━━━━━━━━━
_ do span-curve-at (found Bool, type SegmentType, x1 Coord, y1 Coord, hox Coord, hoy Coord, hix Coord, hiy Coord, x2 Coord, y2 Coord)
    - span PathCommandSpan
    - command-index Index

if command-index >= span.command-count
    = (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0)

. verb PathVerb = span.verbs[command-index]
if verb == .path-verb-move
    = (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0)

. prev-x Coord
. prev-y Coord
. has-prev = false
if command-index > 0
    . prev-index = command-index - 1
    . prev-verb PathVerb = span.verbs[prev-index]
    . prev-start Index = span.coord-offsets[prev-index]
    if prev-verb == .path-verb-move || prev-verb == .path-verb-line
        prev-x = span.coords[prev-start]
        prev-y = span.coords[prev-start + 1]
        has-prev = true
    else if prev-verb == .path-verb-cubic
        prev-x = span.coords[prev-start + 4]
        prev-y = span.coords[prev-start + 5]
        has-prev = true
    else if prev-verb == .path-verb-close
        . close = span-close-start(span, prev-index)
        if close.found
            prev-x = close.x
            prev-y = close.y
            has-prev = true

if !has-prev
    = (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0)

. start Index = span.coord-offsets[command-index]
if verb == .path-verb-line
    . end-x Coord = span.coords[start]
    . end-y Coord = span.coords[start + 1]
    = (true, .segment-type-line, prev-x, prev-y, prev-x, prev-y, end-x, end-y, end-x, end-y)
else if verb == .path-verb-cubic
    . hox Coord = span.coords[start]
    . hoy Coord = span.coords[start + 1]
    . hix Coord = span.coords[start + 2]
    . hiy Coord = span.coords[start + 3]
    . end-x Coord = span.coords[start + 4]
    . end-y Coord = span.coords[start + 5]
    = (true, .segment-type-cubic, prev-x, prev-y, hox, hoy, hix, hiy, end-x, end-y)
else if verb == .path-verb-close
    . close = span-close-start(span, command-index)
    if !close.found
        = (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0)
    if prev-x == close.x && prev-y == close.y
        = (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0)
    = (true, .segment-type-line, prev-x, prev-y, prev-x, prev-y, close.x, close.y, close.x, close.y)

= (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0)

━━━━━━━━━━━━━━━━━━━━
_ do span-close-start (found Bool, x Coord, y Coord)
    - span PathCommandSpan
    - command-index Index

. seek = command-index
while seek > 0
    seek -= 1
    if span.verbs[seek] == .path-verb-move
        . start Index = span.coord-offsets[seek]
        = (true, span.coords[start], span.coords[start + 1])

= (false, 0, 0)

━━━━━━━━━━━━━━━━━━━━
_ path-line-bounds-rejected
    - path Path
    - lx1 Coord
    - ly1 Coord
    - linelength Length
    - lux
    - luy

|? !path.count
    true
|? min-side > tolerance || max-side < -tolerance
    true
??
    max-proj < -tolerance || min-proj > linelength + tolerance

.. bounds = path.get-control-projection-bounds(lux, luy)
.. anchor-side = lx1 * luy - ly1 * lux
.. anchor-proj = lx1 * lux + ly1 * luy
.. min-side = bounds.min-side - anchor-side
.. max-side = bounds.max-side - anchor-side
.. min-proj = bounds.min-proj - anchor-proj
.. max-proj = bounds.max-proj - anchor-proj

