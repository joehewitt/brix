append-cubic-line-hits(out, hits, curve-index, line-index, curve-path, line-path)
//-graphics.intersect.curve-line.solve-cubic
//-graphics.intersect.curve-line.total

━━━━━━━━━━━━━━━━━━━━
_ do refine-curve-curve
    - out [CurveIntersection]
    - counter Counter
    - c1 Curve
    - c2 Curve
    - i1 Index
    - i2 Index
    - p1 Path?
    - p2 Path?
    - t-min PointOnCurve = 0
    - t-max PointOnCurve = 1
    - u-min PointOnCurve = 0
    - u-max PointOnCurve = 1
    - is-reverse Bool = false
    - recursion Int = 0

counter.count += 1
=? if counter.count >= clip-call-limit || recursion >= clip-recursion-limit

. line = signed-distance-line(c2.anchor1, c2.anchor2)
. d1 = line.distance(c2.handle-out)
. d2 = line.distance(c2.handle-in)
. factor = if d1 * d2 > 0 then three-fourths else four-ninths
. d-min = factor * min(min(0, d1), d2)
. d-max = factor * max(max(0, d1), d2)
. dp0 = line.distance(c1.anchor1)
. dp1 = line.distance(c1.handle-out)
. dp2 = line.distance(c1.handle-in)
. dp3 = line.distance(c1.anchor2)
=? if d1 == 0 && d2 == 0 && dp0 == 0 && dp1 == 0 && dp2 == 0 && dp3 == 0

. clips = clip-convex-hull-scalars(dp0, dp1, dp2, dp3, d-min, d-max)
=? if !clips.t-min
=? if !clips.t-max

. t-min-clip = clips.t-min
. t-max-clip = clips.t-max
. t-min-new = t-min + (t-max - t-min) * t-min-clip
. t-max-new = t-min + (t-max - t-min) * t-max-clip
. u-diff = u-max - u-min
if max(u-diff, t-max-new - t-min-new) < hull-epsilon
    . t1 = (t-min-new + t-max-new) / 2
    . t2 = (u-min + u-max) / 2
    if is-reverse
        out += (i2 + t2, i1 + t1, p2, p1)
    else
        out += (i1 + t1, i2 + t2, p1, p2)
    //graphics.intersect.curve-curve.emitted-intersections ++
    =

. clipped = c1.split-at-range(t-min-clip, t-max-clip)
if t-max-clip - t-min-clip > 0.8
    if t-max-new - t-min-new > u-diff
        . left, right = clipped.subdivide(0.5)
        . t = (t-min-new + t-max-new) / 2
        refine-curve-curve()
            - out
            - counter
            - c2
            - left
            - i2
            - i1
            - p2
            - p1
            - u-min
            - u-max
            - t-min-new
            - t
            - !is-reverse
            - recursion + 1
        refine-curve-curve()
            - out
            - counter
            - c2
            - right
            - i2
            - i1
            - p2
            - p1
            - u-min
            - u-max
            - t
            - t-max-new
            - !is-reverse
            - recursion + 1
    else
        . left, right = c2.subdivide(0.5)
        . u = (u-min + u-max) / 2
        refine-curve-curve()
            - out
            - counter
            - left
            - clipped
            - i2
            - i1
            - p2
            - p1
            - u-min
            - u
            - t-min-new
            - t-max-new
            - !is-reverse
            - recursion + 1
        refine-curve-curve()
            - out
            - counter
            - right
            - clipped
            - i2
            - i1
            - p2
            - p1
            - u
            - u-max
            - t-min-new
            - t-max-new
            - !is-reverse
            - recursion + 1
else if u-diff == 0 || u-diff >= hull-epsilon
    refine-curve-curve()
        - out
        - counter
        - c2
        - clipped
        - i2
        - i1
        - p2
        - p1
        - u-min
        - u-max
        - t-min-new
        - t-max-new
        - !is-reverse
        - recursion + 1
else
    refine-curve-curve()
        - out
        - counter
        - clipped
        - c2
        - i1
        - i2
        - p1
        - p2
        - t-min-new
        - t-max-new
        - u-min
        - u-max
        - is-reverse
        - recursion + 1

━━━━━━━━━━━━━━━━━━━━
_ do clip-convex-hull-scalars
    - dq0 Coord
    - dq1 Coord
    - dq2 Coord
    - dq3 Coord
    - d-min Coord
    - d-max Coord

//graphics.numeric.hulls ++
. b-x Coord = 1.0 / 3.0
. c-x Coord = 2.0 / 3.0
. dist1 = dq1 - (2.0 * dq0 + dq3) / 3.0
. dist2 = dq2 - (dq0 + 2.0 * dq3) / 3.0
. top FixedHullChain
. bottom FixedHullChain
if dist1 * dist2 < 0
    top = FixedHullChain(3, 0, dq0, b-x, dq1, 1, dq3, 0, 0)
    bottom = FixedHullChain(3, 0, dq0, c-x, dq2, 1, dq3, 0, 0)
else
    if dist2 != 0 && dist1 / dist2 >= 2
        top = FixedHullChain(3, 0, dq0, b-x, dq1, 1, dq3, 0, 0)
    else if dist2 == 0 || dist1 / dist2 <= 0.5
        top = FixedHullChain(3, 0, dq0, c-x, dq2, 1, dq3, 0, 0)
    else
        top = FixedHullChain(4, 0, dq0, b-x, dq1, c-x, dq2, 1, dq3)
    bottom = FixedHullChain(2, 0, dq0, 1, dq3, 0, 0, 0, 0)

. flip = dist1 < 0 || (dist1 == 0 && dist2 < 0)
if flip
    = HullClips()
        - clip-fixed-convex-hull(false, bottom, top, d-min, d-max)
        - clip-fixed-convex-hull(true, bottom, top, d-min, d-max)

= HullClips()
    - clip-fixed-convex-hull(false, top, bottom, d-min, d-max)
    - clip-fixed-convex-hull(true, top, bottom, d-min, d-max)

━━━━━━━━━━━━━━━━━━━━
_ do clip-fixed-convex-hull
    - reverse Bool
    - top FixedHullChain
    - bottom FixedHullChain
    - d-min Coord
    - d-max Coord

//graphics.numeric.hull-clips ++
. top-first Index = if reverse then top.count - 1 else 0
. bottom-first Index = if reverse then bottom.count - 1 else 0
if fixed-chain-y(top, top-first) < d-min
    = clip-fixed-hull-part(top, reverse, true, d-min)
if fixed-chain-y(bottom, bottom-first) > d-max
    = clip-fixed-hull-part(bottom, reverse, false, d-max)

= fixed-chain-x(top, top-first)

━━━━━━━━━━━━━━━━━━━━
_ do clip-fixed-hull-part PointOnCurve?
    - chain FixedHullChain
    - reverse Bool
    - is-top Bool
    - threshold Coord

. first Index = if reverse then chain.count - 1 else 0
. px = fixed-chain-x(chain, first)
. py = fixed-chain-y(chain, first)
for step in 1 .. < chain.count
    . index Index = if reverse then chain.count - 1 - step else step
    . qx = fixed-chain-x(chain, index)
    . qy = fixed-chain-y(chain, index)
    if (is-top && qy >= threshold) || (!is-top && qy <= threshold)
        if qy == threshold
            = qx
        = px + (threshold - py) * (qx - px) / (qy - py)

    px = qx
    py = qy

= null

━━━━━━━━━━━━━━━━━━━━
_ fixed-chain-x
    - chain FixedHullChain
    - index Index

|? index == 0
    chain.a-x
|? index == 1
    chain.b-x
|? index == 2
    chain.c-x
??
    chain.d-x

━━━━━━━━━━━━━━━━━━━━
_ fixed-chain-y
    - chain FixedHullChain
    - index Index

|? index == 0
    chain.a-y
|? index == 1
    chain.b-y
|? index == 2
    chain.c-y
??
    chain.d-y

━━━━━━━━━━━━━━━━━━━━
_ do polish-curve-intersections
    - hits [CurveIntersection]
    - start Index
    - first Curve
    - second Curve
    - first-index Index
    - second-index Index

for i in start .. < hits.length
    . hit = hits[i]
    . t = hit.t1 - first-index
    . u = hit.t2 - second-index
    for iteration in 0 .. < 24
        . delta = intersection-point(first, t) - intersection-point(second, u)
        . a = intersection-tangent(first, t)
        . b = intersection-tangent(second, u)
        . determinant = a.cross(b)
        if delta.length <= 0.000000000001 || abs(determinant) <= 0.000000000000001
            break
        . next-t = max(0, min(1, t - delta.cross(b) / determinant))
        . next-u = max(0, min(1, u - delta.cross(a) / determinant))
        . next-first = intersection-point(first, next-t)
        . next-second = intersection-point(second, next-u)
        if next-first.distance(next-second) >= delta.length
            break
        t = next-t
        u = next-u
    for endpoint in [0.0, 1.0]
        for other in [0.0, 1.0]
            if abs(t - endpoint) <= tolerance && abs(u - other) <= tolerance
                . endpoint-first = intersection-point(first, endpoint)
                . endpoint-second = intersection-point(second, other)
                if endpoint-first.distance(endpoint-second) <= 0.000000001
                    t = endpoint
                    u = other
    hits[i] = CurveIntersection(first-index + t, second-index + u, hit.path1, hit.path2)

. write = start
for read in start .. < hits.length
    . hit = hits[read]
    . duplicate = false
    for seen in start .. < write
        if abs(hits[seen].t1 - hit.t1) <= tolerance && abs(hits[seen].t2 - hit.t2) <= tolerance
            duplicate = true
            break
    if !duplicate
        hits[write] = hit
        write += 1
if write < hits.length
    -= hits[write ...]

━━━━━━━━━━━━━━━━━━━━
_ intersection-point Point
    - curve Curve
    - t Float

anchor + handle-out + handle-in + end

.. u = 1 - t
.. anchor = curve.anchor1 * (u * u * u)
.. handle-out = curve.handle-out * (3 * u * u * t)
.. handle-in = curve.handle-in * (3 * u * t * t)
.. end = curve.anchor2 * (t * t * t)

━━━━━━━━━━━━━━━━━━━━
_ intersection-tangent Point
    - curve Curve
    - t Float

first + second + third

.. u = 1 - t
.. first = (curve.handle-out - curve.anchor1) * (3 * u * u)
.. second = (curve.handle-in - curve.handle-out) * (6 * u * t)
.. third = (curve.anchor2 - curve.handle-in) * (3 * t * t)
