━━━━━━━━━━━━━━━━━━━━
+ do intersect-line-path-scalars
    - out [CurveIntersection]
    - path Path
    - lx1 Coord
    - ly1 Coord
    - lx2 Coord
    - ly2 Coord
    - line-index
    - line-path Path?
    - line-is-first = false

//graphics.intersect.line-path.calls ++
//+graphics.intersect.line-path.prepare
. linelength = line-length-scalars(lx1, ly1, lx2, ly2)
=? if linelength <= tolerance

. lux = (lx2 - lx1) / linelength
. luy = (ly2 - ly1) / linelength
//-graphics.intersect.line-path.prepare

//+graphics.intersect.line-path.bounds
if path-line-bounds-rejected(path, lx1, ly1, linelength, lux, luy)
    //graphics.intersect.line-path.bounds-rejected ++
    //-graphics.intersect.line-path.bounds
    =
//-graphics.intersect.line-path.bounds

//+graphics.intersect.curve-pairs
. span = path.commands
. curve-index Index
for command-index in 0 .. < span.command-count
    . verb PathVerb = span.verbs[command-index]
    if verb == .path-verb-move
        continue

    . curve = span-curve-at(span, command-index)
    if !curve.found
        continue

    //graphics.intersect.curve-pairs-tested ++
    if curves-equal-scalars(curve.x1, curve.y1, curve.hox, curve.hoy, curve.hix, curve.hiy, curve.x2, curve.y2, lx1, ly1, lx1, ly1, lx2, ly2, lx2, ly2) || curves-equal-reverse-scalars(curve.x1, curve.y1, curve.hox, curve.hoy, curve.hix, curve.hiy, curve.x2, curve.y2, lx1, ly1, lx1, ly1, lx2, ly2, lx2, ly2)
        curve-index += 1
        continue

    if line-like-scalars(curve.x1, curve.y1, curve.hox, curve.hoy, curve.hix, curve.hiy, curve.x2, curve.y2)
        //graphics.intersect.line-line-branches ++
        //+graphics.intersect.line-line
        if line-is-first
            intersect-line-line-scalars()
                - out
                - lx1
                - ly1
                - lx2
                - ly2
                - curve.x1
                - curve.y1
                - curve.x2
                - curve.y2
                - line-index
                - curve-index
                - line-path
                - path
        else
            intersect-line-line-scalars()
                - out
                - curve.x1
                - curve.y1
                - curve.x2
                - curve.y2
                - lx1
                - ly1
                - lx2
                - ly2
                - curve-index
                - line-index
                - path
                - line-path
        //-graphics.intersect.line-line
    else
        //graphics.intersect.curve-line-branches ++
        //+graphics.intersect.curve-line
        . hits = cubic-line-intersections-prepared-scalars()
            - curve.x1
            - curve.y1
            - curve.hox
            - curve.hoy
            - curve.hix
            - curve.hiy
            - curve.x2
            - curve.y2
            - lx1
            - ly1
            - linelength
            - lux
            - luy
            - tolerance
        if line-is-first
            append-cubic-line-hits-reverse(out, hits, line-index, curve-index, line-path, path)
        else
            append-cubic-line-hits(out, hits, curve-index, line-index, path, line-path)
        //-graphics.intersect.curve-line

    curve-index += 1
//-graphics.intersect.curve-pairs

