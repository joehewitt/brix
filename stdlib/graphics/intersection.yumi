_ do sort-curve-intersections
    - intersections [CurveIntersection]

for index in 1 .. < intersections.length
    . item = intersections[index]
    . insert = index
    while insert > 0 && item.t1 < intersections[insert - 1].t1
        intersections[insert] = intersections[insert - 1]
        insert -= 1
    intersections[insert] = item

