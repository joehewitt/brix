_ do post-process-intersections
    - intersections [CurveIntersection]

if !intersections
    = intersections

//+graphics.intersect.post.normalize
for index in 0 .. < intersections.length
    intersections[index] = intersections[index].normalize()
//-graphics.intersect.post.normalize
//+graphics.intersect.post.distinct
. write Index
for read in 0 .. < intersections.length
    . intr = intersections[read]
    . duplicate = false
    for seen in 0 .. < write
        . previous = intersections[seen]
        if previous.t1 == intr.t1 && previous.t2 == intr.t2
            duplicate = true
            break
    if !duplicate
        intersections[write] = intr
        write += 1
if write < intersections.length
    -= intersections[write ...]
//-graphics.intersect.post.distinct
//+graphics.intersect.post.sort
sort-curve-intersections(intersections)
//-graphics.intersect.post.sort
= intersections

