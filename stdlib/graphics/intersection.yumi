    - curve.anchor1.x
    - curve.anchor1.y
    - curve.handle-out.x
    - curve.handle-out.y
    - curve.handle-in.x
    - curve.handle-in.y
    - curve.anchor2.x
    - curve.anchor2.y
    - line.anchor1.x
    - line.anchor1.y
