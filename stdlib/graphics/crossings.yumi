./curve
./intersection
./network
./path
./point
./primitives
/math

━━━━━━━━━━━━━━━━━━━━
+ PathLocation is Tuple

+ parameter PointOnCurve
+ point Point
+ distance Length

━━━━━━━━━━━━━━━━━━━━
+ PathCrossing is Tuple

+ point Point
+ along Length
+ across Length

━━━━━━━━━━━━━━━━━━━━
+ do path-nearest
    - path Path
    - point Point
    - limit Length? = null

. best PathLocation? = null
. index Index = 0
for curve in path.curves
    . hit = network-curve-pick(curve, point, index, limit)
    . reaches = limit == null || hit.distance <= limit
    if reaches && (best == null || hit.distance < best.distance)
        best = PathLocation()
            - (index as Float) + path-curve-parameter(curve, hit)
            - hit.position
            - hit.distance
    index += 1
= best

━━━━━━━━━━━━━━━━━━━━
_ path-curve-parameter
    - curve Curve
    - hit NetworkHit

|? curve.type != .segment-type-line
    hit.parameter
|? squared <= 0
    0.0
??
    max(0.0, min(1.0, (hit.position - curve.anchor1).dot(delta) / squared))

.. delta = curve.anchor2 - curve.anchor1
.. squared = delta.dot(delta)

━━━━━━━━━━━━━━━━━━━━
+ do path-crossings
    - a Path
    - b Path
    - merge Length = 0.0001

. found [PathCrossing]
for pair in intersect-paths(a, b)
    for crossing in pair.intersections
        . source = crossing.path1
        if source
            . point = source.get-point-at(crossing.t1)
            . fresh = true
            for other in found
                if other.point.distance(point) <= merge
                    fresh = false
            . first = path-nearest(a, point) if fresh
            . second = path-nearest(b, point) if fresh
            if first != null && second != null
                found += PathCrossing()
                    - point
                    - a.get-length-at-parameter(first.parameter)
                    - b.get-length-at-parameter(second.parameter)
. ordered [PathCrossing]
. taken [Bool]
for each in found
    taken += false
for round in 0 .. < found.length
    . next Index? = null
    for index in 0 .. < found.length
        if !taken[index] && (next == null || path-crossing-before(found[index], found[next]))
            next = index
    taken[next!] = true
    ordered += found[next!]
= ordered

━━━━━━━━━━━━━━━━━━━━
_ path-crossing-before
    - first PathCrossing
    - second PathCrossing

first.along < second.along || (first.along == second.along && first.across < second.across)
