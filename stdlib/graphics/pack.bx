(import ./canvas)
(import ./graphic)
(import ./intersection)
(import ./path)
(import ./point)
(import ./primitives)
(import ./shapes)
(import /math)

(type + Circ (is (tuple (: pt Point) (: radius Length)))
  (fn-to-expr + Path
    (call circle pt radius)
  )
)

(fn-do + pack-circles _
  (param size Dimensions)
  (param bounds Path)
  (param min-radius Coord (= 10))
  (param max-radius Coord (= 20))
  (param incr-radius Coord (= 1))
  (param inverted _ (= false))
  (probe-count graphics.pack.runs)
  (let packed (list Circ))
  (let failures 0)
  (blank)
  (let bbox (. bounds bounding-box))
  (blank)
  (let looping true)
  (while looping
    (let radius min-radius)
    (let x
      (block
        (case? inverted
          (call random 0 (. size width))
        )
        (default
          (call random (. bbox left) (- (. bbox right) (* radius 2)))
        )
      )
    )
    (let y
      (block
        (case? inverted
          (call random 0 (. size height))
        )
        (default
          (call random (. bbox top) (- (. bbox bottom) (* radius 2)))
        )
      )
    )
    (let pt (call Point x y))
    (let last-radius Coord 0)
    (while true
      (let did-fit
        (scope (and fits-bounds (not (call intersect-paths bounds (call circle pt radius))) misses-packed)
          (lazy fits-bounds (and (< radius max-radius) (!= (call (. bounds contains) pt) inverted)))
          (lazy misses-packed (not (call circles-intersect packed (tuple pt radius))))
        )
      )
      (if did-fit
        (= last-radius radius)
        (+= radius incr-radius)
        (else-if last-radius
          (+= packed (tuple pt last-radius))
          (if (> (. packed length) 1000)
            (= looping false)
          )
          (break)
        )
        (else
          (+= failures 1)
          (break)
        )
      )
    )
    (blank)
    (if (> failures 30000)
      (break)
    )
  )
  (blank)
  (return packed)
)

(fn-do + connect-circles _
  (param circles _)
  (for (in circ1 circles)
    (for (in circ2 circles (when (!= circ1 circ2)))
      (let hit true)
      (for (in circ3 circles (when (and (!= circ3 circ1) (!= circ3 circ2))))
        (if (call circle-line-intersect (. circ1 pt) (. circ2 pt) (. circ3 pt) (. circ3 radius))
          (= hit false)
          (break)
        )
      )
      (if hit
        (yield (call line (. circ1 pt) (. circ2 pt)))
      )
    )
  )
)

(fn-do + circle-line-intersect _
  (param a Point)
  (param b Point)
  (param c Point)
  (param r Coord)
  (probe-count graphics.pack.line-tests)
  (= a (-= (. a x) (. c x)))
  (= a (-= (. a y) (. c y)))
  (= b (-= (. b x) (. c x)))
  (= b (-= (. b y) (. c y)))
  (blank)
  (let dx (- (. b x) (. a x)))
  (let dy (- (. b y) (. a y)))
  (let aa (+ (* dx dx) (* dy dy)))
  (let bb (* 2 (+ (* (. a x) (- (. b x) (. a x))) (* (. a y) (- (. b y) (. a y))))))
  (let cc (- (+ (* (. a x) (. a x)) (* (. a y) (. a y))) (* r r)))
  (let disc (- (* bb bb) (* 4 aa cc)))
  (return-if (if (<= disc 0)))
  (blank)
  (let sqrtdisc (call sqrt disc))
  (let t1 (/ (+ (- bb) sqrtdisc) (* 2 aa)))
  (let t2 (/ (- (- bb) sqrtdisc) (* 2 aa)))
  (blank)
  (return (or (and (< 0 t1) (< t1 1)) (and (< 0 t2) (< t2 1))))
)

(fn-do + circles-intersect _
  (param packed (list Circ))
  (param a Circ)
  (probe-count graphics.pack.circle-scans)
  (for (in b packed (when (call intersect-circles a b)))
    (return true)
  )
  (blank)
  (return false)
)

(fn-do + intersect-circles _
  (param a Circ)
  (param b Circ)
  (probe-count graphics.pack.circle-tests)
  (return (< (call abs (call (. a pt distance) (. b pt))) min-radius))
  (blank)
  (lazy min-radius (+ (. a radius) (. b radius)))
)
