. should-skip-first-curve = is-closed && found-last-curve && has-close-edge
. remaining-curves = total-curves
. did-start = false

path.reserve(command-count, coord-count)
path.begin-mutation()
command-index = command-count
while command-index > 0
    command-index -= 1
    . curve = get-command-curve-scalars(command-index)
    if !curve.found
        continue

    remaining-curves -= 1
    if should-skip-first-curve && remaining-curves == 0
        continue

    path.append-curve-scalars-reverse()
        - curve.type
        - curve.x1
        - curve.y1
        - curve.hox
        - curve.hoy
        - curve.hix
        - curve.hiy
        - curve.x2
        - curve.y2
    did-start = true
path.end-mutation()

if is-closed && did-start
    path.close()

