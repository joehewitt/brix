if has-subpath
    <= PathSubpathSpan(span, subpath-start, command-count, subpath-curves, subpath-closed)

────────────────────
+ do append-subpath-spans
    - out [PathSubpathSpan]

. span = commands
. subpath-start Index
. subpath-curves Size
. subpath-closed = false
. has-subpath = false
. current-x Coord
. current-y Coord
. subpath-x Coord
. subpath-y Coord
. has-current = false

for i in 0 .. < command-count
    . verb = verbs[i]
    . start = coord-offsets[i]

    if verb == .path-verb-move
        if has-subpath
            out += PathSubpathSpan(span, subpath-start, i, subpath-curves, subpath-closed)

        subpath-start = i
        subpath-curves = 0
        subpath-closed = false
        current-x = coords[start]
        current-y = coords[start + 1]
        subpath-x = current-x
        subpath-y = current-y
        has-current = true
        has-subpath = true
    else if verb == .path-verb-line && has-current
        current-x = coords[start]
        current-y = coords[start + 1]
        subpath-curves += 1
    else if verb == .path-verb-cubic && has-current
        current-x = coords[start + 4]
        current-y = coords[start + 5]
        subpath-curves += 1
    else if verb == .path-verb-close && has-current
        if current-x != subpath-x || current-y != subpath-y
            subpath-curves += 1
        current-x = subpath-x
        current-y = subpath-y
        subpath-closed = true

if has-subpath
    out += PathSubpathSpan(span, subpath-start, command-count, subpath-curves, subpath-closed)

