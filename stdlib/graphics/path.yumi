_ has-current = false

────────────────────
+ This
    - span PathCommandSpan

────────────────────
+ get curve

Curve((x1, y1), (handle-out-x, handle-out-y), (handle-in-x, handle-in-y), (x2, y2), type)

────────────────────
+ do next

while command-index < span.command-count
    . verb = span.verbs[command-index]
    . start = span.coord-offsets[command-index]

    if verb == .path-verb-move
        current-x = span.coords[start]
        current-y = span.coords[start + 1]
        subpath-x = current-x
        subpath-y = current-y
        has-current = true
        command-index += 1
    else if verb == .path-verb-line
        if !has-current
            current-x = span.coords[start]
            current-y = span.coords[start + 1]
            subpath-x = current-x
            subpath-y = current-y
            has-current = true
            command-index += 1
            continue

        curve-index = next-curve-index
        next-curve-index += 1
        type = .segment-type-line
        is-close = false
        x1 = current-x
        y1 = current-y
        x2 = span.coords[start]
        y2 = span.coords[start + 1]
        handle-out-x = x1
        handle-out-y = y1
        handle-in-x = x2
        handle-in-y = y2
        current-x = x2
        current-y = y2
        command-index += 1
        = true
    else if verb == .path-verb-cubic
        if !has-current
            current-x = span.coords[start + 4]
            current-y = span.coords[start + 5]
            subpath-x = current-x
            subpath-y = current-y
            has-current = true
            command-index += 1
            continue

        curve-index = next-curve-index
        next-curve-index += 1
        type = .segment-type-cubic
        is-close = false
        x1 = current-x
        y1 = current-y
        handle-out-x = span.coords[start]
        handle-out-y = span.coords[start + 1]
        handle-in-x = span.coords[start + 2]
        handle-in-y = span.coords[start + 3]
        x2 = span.coords[start + 4]
        y2 = span.coords[start + 5]
        current-x = x2
        current-y = y2
        command-index += 1
        = true
    else if verb == .path-verb-close
        command-index += 1
        if !has-current
            continue

        if current-x == subpath-x && current-y == subpath-y
            continue

        curve-index = next-curve-index
        next-curve-index += 1
        type = .segment-type-line
        is-close = true
        x1 = current-x
        y1 = current-y
        x2 = subpath-x
        y2 = subpath-y
        handle-out-x = x1
        handle-out-y = y1
        handle-in-x = x2
        handle-in-y = y2
        current-x = subpath-x
        current-y = subpath-y
        = true

= false

