        if may-wrap
            . max I64 = curve-count
            for i in i1 + 1 .. < max
                appended-curves += path.append-indexed-curve(this, i)
            for i in 0 .. < i2
                appended-curves += path.append-indexed-curve(this, i)
        else
            for i in i1 + 1 .. < i2
                appended-curves += path.append-indexed-curve(this, i)

        if tt2
            appended-curves += path.append-indexed-curve-range(this, i2, 0, tt2)

path.end-mutation()
//graphics.path.split-range.curves += appended-curves
= path

────────────────────
+ do get-point-at-distance
    - distance Length
    - be-precise = false

//graphics.path.distance-queries ++
. t = get-parameter-at-distance(distance, be-precise)
if t <= 0
    = first-point
else if t >= curve-count
    = last-point

= get-point-at(t)

────────────────────
+ do get-parameter-at-distance PointOnCurve
    - distance Length
    - be-precise = false

//graphics.path.parameter-queries ++
` XXXjoe This should be a parameter based on zoomed resolution
. max-overshoot = 0.2
. min-overshoot = -max-overshoot

. ptable = compute-point-table()
for index, (pt1, pt2) in indexed(pairwise(ptable))
    . length-at-point = pt2.length
    . overshoot = pt2.length - distance
    if overshoot > 0
        . t = pt2.t
        . x1 = pt2.x
        . y1 = pt2.y
        . t1 = pt1.t

        if be-precise && overshoot > max-overshoot
            . step = -0.001
            while abs(step) > tolerance
                if step > 0
                    t += step
                    while t < t1
                        t += step
                        . point = get-point-at(t)

                        . dx = point.x - x1
                        . dy = point.y - y1

                        length-at-point += sqrt(dx * dx + dy * dy)
                        overshoot = length-at-point - distance
                        x1 = point.x
                        y1 = point.y

                        if overshoot > 0
                            if overshoot > max-overshoot
                                break
                            else
                                = t1

                        x1 = point.x
                        y1 = point.y
                else
                    t += step
                    while t > t1
                        t += step
                        . point = get-point-at(t)

                        . dx = x1 - point.x
                        . dy = y1 - point.y

                        length-at-point -= sqrt(dx * dx + dy * dy)
                        overshoot = length-at-point - distance
                        x1 = point.x
                        y1 = point.y

                        if overshoot < 0
                            if overshoot < min-overshoot
                                break
                            else
                                = t

                t1 = t - step
                step = -step / 2

        . span-length = pt2.length - pt1.length
        if span-length <= tolerance
            = max(0, t)

        . ratio = (distance - pt1.length) / span-length
        = max(0, pt1.t + (pt2.t - pt1.t) * ratio)
    else if overshoot == 0
        = point-table![index + 1].t

= curve-count as PointOnCurve

────────────────────
+ do get-length-at-parameter
    - t PointOnCurve
    - be-precise = false

//graphics.path.length-parameter-queries ++
. max-overshoot = 0.01
. min-overshoot = -max-overshoot

. ptable = compute-point-table()
for index, (pt1, pt2) in indexed(pairwise(ptable))
    . overshoot = pt2.t - t
    if overshoot > 0
        . span-t = pt2.t - pt1.t
        if span-t <= tolerance
            = pt1.length

        . ratio = (t - pt1.t) / span-t
        = pt1.length + (pt2.length - pt1.length) * ratio
    else if overshoot == 0
        = pt2.length

= -1

────────────────────
+ do compute-point-table

if point-table
    //graphics.path.point-table.cache-hits ++
    = point-table

//graphics.path.point-table.builds ++
. ptable [PointDistance]
. total Length = 0

. lastx = coords[0]
. lasty = coords[1]
ptable += (0.0, total, lastx, lasty)

. point-table-resolution = 250
. t-min = tolerance
. t-max = if point-table-resolution > 1 then 1.0 - tolerance else -1.0

. curveindex Index

for i in 0 .. < command-count
    . verb PathVerb = verbs[i]
    . start Index = coord-offsets[i]
    if verb == .path-verb-move
        continue

    . prevx Coord
    . prevy Coord
    . hasprev = false
    if i > 0
        . previndex = i - 1
        . prevverb PathVerb = verbs[previndex]
        . prevstart Index = coord-offsets[previndex]
        if prevverb == .path-verb-move || prevverb == .path-verb-line
            prevx = coords[prevstart]
            prevy = coords[prevstart + 1]
            hasprev = true
        else if prevverb == .path-verb-cubic
            prevx = coords[prevstart + 4]
            prevy = coords[prevstart + 5]
            hasprev = true
        else if prevverb == .path-verb-close
            . close = get-command-subpath-start(previndex)
            if close.found
                prevx = close.x
                prevy = close.y
                hasprev = true

    if !hasprev
        continue

    if verb == .path-verb-line
        . endx Coord = coords[start]
        . endy Coord = coords[start + 1]
        . distance Length = line-length-scalars(prevx, prevy, endx, endy)
        total = total + distance
        lastx = endx
        lasty = endy
        if distance > 0.0000001
            //graphics.path.point-table.samples ++
            ptable += (curveindex + 1.0, total, lastx, lasty)
        curveindex += 1
        continue

    if verb == .path-verb-close
        . close = get-command-subpath-start(i)
        if close.found
            . closx Coord = close.x
            . closy Coord = close.y
            if prevx == closx && prevy == closy
                continue
            . distance Length = line-length-scalars(prevx, prevy, closx, closy)
            total = total + distance
            lastx = closx
            lasty = closy
            if distance > 0.0000001
                //graphics.path.point-table.samples ++
                ptable += (curveindex + 1.0, total, lastx, lasty)
            curveindex += 1
        continue

    if verb != .path-verb-cubic
        continue

    . step-min Coord = t-min
    . step Coord = (t-max - step-min) / point-table-resolution

    . sx Coord = prevx
    . sy Coord = prevy
    . ox Coord = coords[start]
    . oy Coord = coords[start + 1]
    . ix Coord = coords[start + 2]
    . iy Coord = coords[start + 3]
    . ex Coord = coords[start + 4]
    . ey Coord = coords[start + 5]

    . coeffx = cubic-coefficients-1d(sx, ox, ix, ex)
    . coeffy = cubic-coefficients-1d(sy, oy, iy, ey)

    for t in step-min .. t-max by step
        //graphics.path.point-table.samples ++
        . x Coord = cubic-evaluate-1d(coeffx.a, coeffx.b, coeffx.c, sx, t)
        . y Coord = cubic-evaluate-1d(coeffy.a, coeffy.b, coeffy.c, sy, t)

        . distance Length = line-length-scalars(lastx, lasty, x, y)

        total = total + distance
        lastx = x
        lasty = y
        ptable += (curveindex + t, total, lastx, lasty)

    . distance Length = line-length-scalars(lastx, lasty, ex, ey)
    total = total + distance
    lastx = ex
    lasty = ey
    if distance > 0.0000001
        //graphics.path.point-table.samples ++
        ptable += (curveindex + 1.0, total, lastx, lasty)

    curveindex += 1

computed-length = total
point-table = ptable
= ptable

────────────────────
_ get-curve-coord-bounds (min Coord, max Coord)
    - a1 Coord
    - ho Coord
    - hi Coord
    - a2 Coord

(bounds.min, bounds.max)
    .. bounds = cubic-bounds-1d(a1, ho, hi, a2, tolerance)

────────────────────
_ get-line-coord-bounds (min Coord, max Coord)
    - a1 Coord
    - a2 Coord

(bounds.min, bounds.max)
    .. bounds = line-bounds-1d(a1, a2)

────────────────────
_ do get-curve-scalars (found Bool, type SegmentType, x1 Coord, y1 Coord, hox Coord, hoy Coord, hix Coord, hiy Coord, x2 Coord, y2 Coord, is-close Bool)
    - target Index

. curve-index Index
. current-x Coord
. current-y Coord
. subpath-x Coord
. subpath-y Coord
. has-current = false

for i in 0 .. < command-count
    . verb = verbs[i]
    . start = coord-offsets[i]
    if verb == .path-verb-move
        current-x = coords[start]
        current-y = coords[start + 1]
        subpath-x = current-x
        subpath-y = current-y
        has-current = true
    else if verb == .path-verb-line && has-current
        . x2 = coords[start]
        . y2 = coords[start + 1]
        if curve-index == target
            = (true, .segment-type-line, current-x, current-y, current-x, current-y, x2, y2, x2, y2, false)
        current-x = x2
        current-y = y2
        curve-index += 1
    else if verb == .path-verb-cubic && has-current
        . hox = coords[start]
        . hoy = coords[start + 1]
        . hix = coords[start + 2]
        . hiy = coords[start + 3]
        . x2 = coords[start + 4]
        . y2 = coords[start + 5]
        if curve-index == target
            = (true, .segment-type-cubic, current-x, current-y, hox, hoy, hix, hiy, x2, y2, false)
        current-x = x2
        current-y = y2
        curve-index += 1
    else if verb == .path-verb-close && has-current
        if current-x != subpath-x || current-y != subpath-y
            if curve-index == target
                = (true, .segment-type-line, current-x, current-y, current-x, current-y, subpath-x, subpath-y, subpath-x, subpath-y, true)
            curve-index += 1
        current-x = subpath-x
        current-y = subpath-y

= (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0, false)

────────────────────
_ do get-indexed-curve-scalars (found Bool, type SegmentType, x1 Coord, y1 Coord, hox Coord, hoy Coord, hix Coord, hiy Coord, x2 Coord, y2 Coord, is-close Bool)
    - target Index

. found = curve-command(target)
if found && found > 0
    . command-index = found
    . verb = verbs[command-index]
    . prev-index = command-index - 1
    . prev-verb = verbs[prev-index]
    . prev-start = coord-offsets[prev-index]
    . x1 Coord
    . y1 Coord
    . has-prev = false

    if prev-verb == .path-verb-move || prev-verb == .path-verb-line
        x1 = coords[prev-start]
        y1 = coords[prev-start + 1]
        has-prev = true
    else if prev-verb == .path-verb-cubic
        x1 = coords[prev-start + 4]
        y1 = coords[prev-start + 5]
        has-prev = true

    if has-prev
        . start = coord-offsets[command-index]
        if verb == .path-verb-line
            . x2 = coords[start]
            . y2 = coords[start + 1]
            = (true, .segment-type-line, x1, y1, x1, y1, x2, y2, x2, y2, false)
        else if verb == .path-verb-cubic
            . hox = coords[start]
            . hoy = coords[start + 1]
            . hix = coords[start + 2]
            . hiy = coords[start + 3]
            . x2 = coords[start + 4]
            . y2 = coords[start + 5]
            = (true, .segment-type-cubic, x1, y1, hox, hoy, hix, hiy, x2, y2, false)

= get-curve-scalars(target)

────────────────────
_ curve-command Index?
    - target Index

|? target < leading-curve-count()
    target + 1
??
    table[target] if target < table.length

.. table = curve-command-table()

────────────────────
_ do curve-command-table [Index]

. known = curve-commands
=? known if known
. table [Index]
. current-x Coord
. current-y Coord
. subpath-x Coord
. subpath-y Coord
. has-current = false
for i in 0 .. < command-count
    . verb = verbs[i]
    . start = coord-offsets[i]
    if verb == .path-verb-move
        current-x = coords[start]
        current-y = coords[start + 1]
        subpath-x = current-x
        subpath-y = current-y
        has-current = true
    else if verb == .path-verb-line && has-current
        table += i
        current-x = coords[start]
        current-y = coords[start + 1]
    else if verb == .path-verb-cubic && has-current
        table += i
        current-x = coords[start + 4]
        current-y = coords[start + 5]
    else if verb == .path-verb-close && has-current
        if current-x != subpath-x || current-y != subpath-y
            table += i
        current-x = subpath-x
        current-y = subpath-y
curve-commands = table
= table

────────────────────
_ do leading-curve-count Size

. known = leading-curves
=? known if known
. count Size
if command-count && verbs[0] == .path-verb-move
    while count + 1 < command-count && (verbs[count + 1] == .path-verb-line || verbs[count + 1] == .path-verb-cubic)
        count += 1
leading-curves = count
= count

────────────────────
_ do get-command-curve-scalars (found Bool, type SegmentType, x1 Coord, y1 Coord, hox Coord, hoy Coord, hix Coord, hiy Coord, x2 Coord, y2 Coord, is-close Bool)
    - command-index Index

if command-index >= command-count
    = (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0, false)

. verb = verbs[command-index]
if verb == .path-verb-move
    = (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0, false)

. previous = get-previous-command-point(command-index)
if !previous.found
    = (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0, false)

. start = coord-offsets[command-index]
if verb == .path-verb-line
    . end-x = coords[start]
    . end-y = coords[start + 1]
    = (true, .segment-type-line, previous.x, previous.y, previous.x, previous.y, end-x, end-y, end-x, end-y, false)
else if verb == .path-verb-cubic
    . hox = coords[start]
    . hoy = coords[start + 1]
    . hix = coords[start + 2]
    . hiy = coords[start + 3]
    . end-x = coords[start + 4]
    . end-y = coords[start + 5]
    = (true, .segment-type-cubic, previous.x, previous.y, hox, hoy, hix, hiy, end-x, end-y, false)
else if verb == .path-verb-close
    . close = get-command-subpath-start(command-index)
    if !close.found
        = (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0, false)
    if previous.x == close.x && previous.y == close.y
        = (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0, false)
    = (true, .segment-type-line, previous.x, previous.y, previous.x, previous.y, close.x, close.y, close.x, close.y, true)

= (false, .segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0, false)

────────────────────
_ get-previous-command-point (found Bool, x Coord, y Coord)
    - command-index Index

|? command-index <= 0
    (false, 0, 0)
|? verb == .path-verb-move || verb == .path-verb-line
    (true, coords[start], coords[start + 1])
|? verb == .path-verb-cubic
    (true, coords[start + 4], coords[start + 5])
|? verb == .path-verb-close
    get-command-subpath-start(previous-index)
??
    (false, 0, 0)

.. previous-index = command-index - 1
.. verb = verbs[previous-index]
.. start = coord-offsets[previous-index]

────────────────────
_ do get-command-subpath-start (found Bool, x Coord, y Coord)
    - command-index Index

. seek = command-index + 1
while seek > 0
    seek -= 1
    if verbs[seek] == .path-verb-move
        . start = coord-offsets[seek]
        = (true, coords[start], coords[start + 1])

= (false, 0, 0)

────────────────────
_ do get-control-bounding-box

. cached = control-bounding-box-cache
=? cached if cached
. min-x Coord = coords[0]
. min-y Coord = coords[1]
. max-x Coord = min-x
. max-y Coord = min-y

for i in 2 .. < coord-count by 2
    . x = coords[i]
    . y = coords[i + 1]
    if x < min-x
        min-x = x
    if y < min-y
        min-y = y
    if x > max-x
        max-x = x
    if y > max-y
        max-y = y

. bounds = Rect(min-x, min-y, max-x - min-x, max-y - min-y)
control-bounding-box-cache = bounds
= bounds

────────────────────
_ do invalidate

leading-curves = null
curve-commands = null
if point-table || control-projection-bounds-cache.length || control-bounding-box-cache
    //graphics.path.invalidations ++
    point-table = null
    control-bounding-box-cache = null
    if control-projection-bounds-cache.length
        control-projection-bounds-cache.clear()

────────────────────
_ do mark-mutated

if mutation-depth
    has-pending-mutation = true
else
    path-revision += 1
    invalidate()

────────────────────
_ do begin-mutation

mutation-depth += 1

────────────────────
_ do end-mutation

mutation-depth -= 1
if !mutation-depth && has-pending-mutation
    has-pending-mutation = false
    path-revision += 1
    invalidate()

────────────────────
_ do large-arc
    - point Point
    - radius Length
    - start-angle Radians
    - end-angle Radians
    - ccw = false
    - is-continued = false

. remaining =
    |? ccw
        start-angle - end-angle
    ??
        end-angle - start-angle
if remaining < 0
    remaining = normalize-angle(remaining)

. a1 = start-angle
. sign Float = if ccw then -1 else 1
while remaining > 0
    . amount Float = sign * min(remaining, π / 2)
    . a2 = a1 + amount
    small-arc(point, radius, a1, a2, if is-continued then true else a1 != start-angle)
    remaining -= abs(amount)
    a1 = a2

────────────────────
_ do small-arc
    - point Point
    - radius Length
    - start-angle Radians
    - end-angle Radians
    - ccw = false
    - is-continued = false

. a = (end-angle - start-angle) / 2.0

. x4 = radius * cos(a)
. y4 = radius * sin(a)
. x1 = x4
. y1 = -y4

. f = (4.0 / 3.0) * tan(a / 2.0)

. x2 = x1 + f * y4
. y2 = y1 + f * x4
. x3 = x2
. y3 = -y2

. ar = a + start-angle
. cos-ar = cos(ar)
. sin-ar = sin(ar)

if !is-continued
    . ax1 = point.x + (radius * cos(start-angle))
    . ay1 = point.y + (radius * sin(start-angle))
    line-to(ax1, ay1)

. hox = point.x + (x2 * cos-ar - y2 * sin-ar)
. hoy = point.y + (x2 * sin-ar + y2 * cos-ar)
. hix = point.x + (x3 * cos-ar - y3 * sin-ar)
. hiy = point.y + (x3 * sin-ar + y3 * cos-ar)
. ax4 = point.x + (radius * cos(end-angle))
. ay4 = point.y + (radius * sin(end-angle))
cubic-curve-to(hox, hoy, hix, hiy, ax4, ay4)

────────────────────
_ do contains-line-polygon
    - point Point

. inside-x = false
. inside-y = false
. first-x Coord
. first-y Coord
. prev-x Coord
. prev-y Coord
. has-prev = false

for i in 0 .. < command-count
    . verb = verbs[i]
    if verb == .path-verb-close
        continue

    . start = coord-offsets[i]
    . x = coords[start]
    . y = coords[start + 1]
    if has-prev
        =? true
            if point-on-segment(point, prev-x, prev-y, x, y)
        if segment-crosses-ray(point, prev-x, prev-y, x, y)
            inside-x = !inside-x
        if segment-crosses-vertical-ray(point, prev-x, prev-y, x, y)
            inside-y = !inside-y
    else
        first-x = x
        first-y = y
        has-prev = true

    prev-x = x
    prev-y = y

if has-prev
    =? true
        if point-on-segment(point, prev-x, prev-y, first-x, first-y)
    if segment-crosses-ray(point, prev-x, prev-y, first-x, first-y)
        inside-x = !inside-x
    if segment-crosses-vertical-ray(point, prev-x, prev-y, first-x, first-y)
        inside-y = !inside-y

= inside-x || inside-y

────────────────────
_ do segment-crosses-ray
    - point Point
    - x1 Coord
    - y1 Coord
    - x2 Coord
    - y2 Coord

. above1 = y1 > point.y
. above2 = y2 > point.y
=? if above1 == above2

. x = x1 + (point.y - y1) * (x2 - x1) / (y2 - y1)
= x > point.x

────────────────────
_ do segment-crosses-vertical-ray
    - point Point
    - x1 Coord
    - y1 Coord
    - x2 Coord
    - y2 Coord

. right1 = x1 > point.x
. right2 = x2 > point.x
=? if right1 == right2

. y = y1 + (point.x - x1) * (y2 - y1) / (x2 - x1)
= y > point.y

────────────────────
_ do point-on-segment
    - point Point
    - x1 Coord
    - y1 Coord
    - x2 Coord
    - y2 Coord

. dx = x2 - x1
. dy = y2 - y1
. px = point.x - x1
. py = point.y - y1
. cross = dx * py - dy * px
=? if abs(cross) > tolerance

. min-x = min(x1, x2) - tolerance
. max-x = max(x1, x2) + tolerance
. min-y = min(y1, y2) - tolerance
. max-y = max(y1, y2) + tolerance

= point.x >= min-x && point.x <= max-x && point.y >= min-y && point.y <= max-y

────────────────────
_ point-on-cubic
    - point Point
    - a1-x Coord
    - a1-y Coord
    - ho-x Coord
    - ho-y Coord
    - hi-x Coord
    - hi-y Coord
    - a2-x Coord
    - a2-y Coord

point-on-cubic-scalars(point.x, point.y, a1-x, a1-y, ho-x, ho-y, hi-x, hi-y, a2-x, a2-y, tolerance)

────────────────────
_ do get-point-at-scalars
    - a1-x Coord
    - a1-y Coord
    - ho-x Coord
    - ho-y Coord
    - hi-x Coord
    - hi-y Coord
    - a2-x Coord
    - a2-y Coord
    - t PointOnCurve
    - which PointType
    - distance Length?

. point = cubic-evaluate-xy(a1-x, a1-y, ho-x, ho-y, hi-x, hi-y, a2-x, a2-y, t)

if which == .point-type-point
    = Point(point.x, point.y)
else
    . tangent = cubic-derivative-xy(a1-x, a1-y, ho-x, ho-y, hi-x, hi-y, a2-x, a2-y, t)
    . point-x = tangent.x
    . point-y = tangent.y

    ` normal is just rotated tangent
    if which == .point-type-normal
        . old-x = point-x
        point-x = point-y
        point-y = -old-x

    if distance
        . length = sqrt(point-x * point-x + point-y * point-y)
        . scale = if !length then 1.0 else distance / length
        = Point
            - point.x + point-x * scale
            - point.y + point-y * scale
    else
        = Point(point-x, point-y)

────────────────────
_ do get-line-point-at-scalars
    - a1-x Coord
    - a1-y Coord
    - a2-x Coord
    - a2-y Coord
    - t PointOnCurve
    - which PointType
    - distance Length?

. x = a1-x + (a2-x - a1-x) * t
. y = a1-y + (a2-y - a1-y) * t
if which == .point-type-point
    = Point(x, y)
. point-x = a2-x - a1-x
. point-y = a2-y - a1-y
if which == .point-type-normal
    . old-x = point-x
    point-x = point-y
    point-y = -old-x
if distance
    . length = sqrt(point-x * point-x + point-y * point-y)
    . scale = if !length then 1.0 else distance / length
    = Point(x + point-x * scale, y + point-y * scale)
= Point(point-x, point-y)

