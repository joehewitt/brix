────────────────────
_ do get-crossings-at
    - crossings [Int]
    - curve-index Index
    - point Point
    - a1-x Coord
    - a1-y Coord
    - ho-x Coord
    - ho-y Coord
    - hi-x Coord
    - hi-y Coord
    - a2-x Coord
    - a2-y Coord

. t1 = tolerance
. t2 = 1.0 - tolerance

. coeffx = cubic-coefficients-1d(a1-x, ho-x, hi-x, a2-x)
. coeffy = cubic-coefficients-1d(a1-y, ho-y, hi-y, a2-y)

. xroots = cubic-roots-for-y(point.y, a1-y, ho-y, hi-y, a2-y, tolerance-tight)
for j in 0 .. < xroots.count
    . t = xroots[j]
    if t >= 0 && t < 1
        . xp = cubic-evaluate-1d(coeffx.a, coeffx.b, coeffx.c, a1-x, t)
        if xp > point.x
            if t < tolerance && curve-index > 0
                . tangent1 = cubic-derivative-1d(coeffy.a, coeffy.b, coeffy.c, t1)
                . tangent2 = cubic-derivative-1d(coeffy.a, coeffy.b, coeffy.c, t2)
                if tangent1 * tangent2 >= tolerance
                    continue
            crossings[0] += 1

. yroots = cubic-roots-for-x(point.x, a1-x, ho-x, hi-x, a2-x, tolerance-tight)
for j in 0 .. < yroots.count
    . t = yroots[j]
    if t >= 0 && t < 1
        . yp = cubic-evaluate-1d(coeffy.a, coeffy.b, coeffy.c, a1-y, t)
        if yp > point.y
            if t < tolerance && curve-index > 0
                . tangent1 = cubic-derivative-1d(coeffx.a, coeffx.b, coeffx.c, t1)
                . tangent2 = cubic-derivative-1d(coeffx.a, coeffx.b, coeffx.c, t2)
                if tangent1 * tangent2 >= tolerance
                    continue
            crossings[1] += 1

