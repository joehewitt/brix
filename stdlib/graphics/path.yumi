for i in 0 .. < span.command-count
    . verb = span.verbs[i]
    . start = span.coord-offsets[i]
    if verb == .path-verb-move
        move-to(span.coords[start], span.coords[start + 1])
    else if verb == .path-verb-line
        line-to(span.coords[start], span.coords[start + 1])
    else if verb == .path-verb-cubic
        cubic-curve-to()
            - span.coords[start]
            - span.coords[start + 1]
            - span.coords[start + 2]
            - span.coords[start + 3]
            - span.coords[start + 4]
            - span.coords[start + 5]
    else if verb == .path-verb-close
        close()
end-mutation()

