+ do mirror-x
    - cx Coord?

. cxx = cx ?? bounding-box.center.x
for i in 0 .. < coord-count by 2
    . x = coords[i]
    coords[i] = if x < cxx then cxx - (x - cxx) else cxx + (cxx - x)
mark-mutated()

────────────────────
+ do mirror-y
    - cy Coord?

. cyy = cy ?? bounding-box.center.y
for i in 1 .. < coord-count by 2
    . y = coords[i]
    coords[i] = if y < cyy then cyy - (y - cyy) else cyy + (cyy - y)
mark-mutated()

────────────────────
+ do mirror
    - center Point?

. c = center ?? bounding-box.center
for i in 0 .. < coord-count by 2
    . x = coords[i]
    . y = coords[i + 1]
    coords[i] = if x < c.x then c.x - (x - c.x) else c.x + (c.x - x)
    coords[i + 1] = if y < c.y then c.y - (y - c.y) else c.y + (c.y - y)
mark-mutated()

────────────────────
+ do translate
    - distance Point

for i in 0 .. < coord-count by 2
    coords[i] += distance.x
    coords[i + 1] += distance.y
mark-mutated()

────────────────────
+ do rotate
    - angle Radians
    - center = Point(0, 0)

. s = sin(angle)
. c = cos(angle)
for i in 0 .. < coord-count by 2
    . x1 = coords[i] - center.x
    . y1 = coords[i + 1] - center.y
    coords[i] = (x1 * c - y1 * s) + center.x
    coords[i + 1] = (y1 * c + x1 * s) + center.y
mark-mutated()

