━━━━━━━━━━━━━━━━━━━━
_ path-hull-reaches Bool
    - curve Curve
    - point Point

within-x && point.y >= top - reach && point.y <= bottom + reach

.. left = min(min(curve.anchor1.x, curve.handle-out.x), min(curve.handle-in.x, curve.anchor2.x))
.. right = max(max(curve.anchor1.x, curve.handle-out.x), max(curve.handle-in.x, curve.anchor2.x))
.. top = min(min(curve.anchor1.y, curve.handle-out.y), min(curve.handle-in.y, curve.anchor2.y))
.. bottom = max(max(curve.anchor1.y, curve.handle-out.y), max(curve.handle-in.y, curve.anchor2.y))
.. reach = 0.01 + (right - left + bottom - top) * 0.001
.. within-x = point.x >= left - reach && point.x <= right + reach

━━━━━━━━━━━━━━━━━━━━
+ do path-curves-contain Bool
    - curves [Curve]
    - point Point
    - fill-rule FillRule

. winding Int
for curve in curves
    =? true if path-hull-reaches(curve, point) && curve.get-parameter(point) >= 0
    if curve.is-line-like
        . a = curve.anchor1
        . b = curve.anchor2
        if (a.y > point.y) != (b.y > point.y)
            . x = a.x + (point.y - a.y) * (b.x - a.x) / (b.y - a.y)
            if x > point.x
                winding += if b.y > a.y then 1 else -1
    else
        . roots = cubic-roots-for-y
            - point.y
            - curve.anchor1.y
            - curve.handle-out.y
            - curve.handle-in.y
            - curve.anchor2.y
            - tolerance-tight
        . x = cubic-coefficients-1d
            - curve.anchor1.x
            - curve.handle-out.x
            - curve.handle-in.x
            - curve.anchor2.x
        . y = cubic-coefficients-1d
            - curve.anchor1.y
            - curve.handle-out.y
            - curve.handle-in.y
            - curve.anchor2.y
        for i in 0 .. < roots.count
            . t = roots[i]
            if t < -tolerance-tight || t > 1 + tolerance-tight
                continue
            t = max(0.0, min(1.0, t))
            . direction = cubic-derivative-1d(y.a, y.b, y.c, t)
            if t < tolerance-tight
                direction = cubic-derivative-1d(y.a, y.b, y.c, 0.000001)
                if direction <= 0
                    continue
            else if t > 1 - tolerance-tight
                direction = cubic-derivative-1d(y.a, y.b, y.c, 0.999999)
                if direction >= 0
                    continue
            if abs(direction) > tolerance-tight
                . intersection-x = cubic-evaluate-1d(x.a, x.b, x.c, curve.anchor1.x, t)
                if intersection-x > point.x
                    winding += if direction > 0 then 1 else -1
= if fill-rule == FillRule.even-odd then (winding /and/ 1) != 0 else winding != 0
