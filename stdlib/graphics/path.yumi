────────────────────
+ do get is-clockwise

. area Length
. current-x Coord
. current-y Coord
. subpath-x Coord
. subpath-y Coord
. has-current = false
for i in 0 .. < command-count
    . verb = verbs[i]
    . start = coord-offsets[i]
    if verb == .path-verb-move
        current-x = coords[start]
        current-y = coords[start + 1]
        subpath-x = current-x
        subpath-y = current-y
        has-current = true
    else if verb == .path-verb-line && has-current
        . x2 = coords[start]
        . y2 = coords[start + 1]
        area += x2 * current-y - current-x * y2
        current-x = x2
        current-y = y2
    else if verb == .path-verb-cubic && has-current
        . hox = coords[start]
        . hoy = coords[start + 1]
        . hix = coords[start + 2]
        . hiy = coords[start + 3]
        . x2 = coords[start + 4]
        . y2 = coords[start + 5]
        . out-cross = current-x * hoy - hox * current-y
        area -= 0.6 * out-cross + 0.3 * (current-x * hiy - hix * current-y)
        area -= 0.1 * (current-x * y2 - x2 * current-y) + 0.3 * (hox * hiy - hix * hoy)
        area -= 0.3 * (hox * y2 - x2 * hoy) + 0.6 * (hix * y2 - x2 * hiy)
        current-x = x2
        current-y = y2
    else if verb == .path-verb-close && has-current
        if current-x != subpath-x || current-y != subpath-y
            area += subpath-x * current-y - current-x * subpath-y
        current-x = subpath-x
        current-y = subpath-y

= area < 0

────────────────────
+ get bounding-box

bounding-box-under(null)

────────────────────
+ do bounding-box-under
    - transform Matrix?

//graphics.path.bounding-box.paths ++
. min-x Coord = 0
. min-y Coord = 0
. max-x Coord = 0
. max-y Coord = 0
. waiting-for-first = true

. current-x Coord
. current-y Coord
. subpath-x Coord
. subpath-y Coord
. has-current = false

for i in 0 .. < command-count
    . verb = verbs[i]
    . start = coord-offsets[i]

    if verb == .path-verb-move
        . point = bounds-point(start, transform)
        current-x = point.x
        current-y = point.y
        subpath-x = current-x
        subpath-y = current-y
        has-current = true
    else if verb == .path-verb-line && has-current
        . point = bounds-point(start, transform)
        . x2 = point.x
        . y2 = point.y
        . bounds-x = get-line-coord-bounds(current-x, x2)
        . bounds-y = get-line-coord-bounds(current-y, y2)
        if waiting-for-first
            min-x = bounds-x.min
            min-y = bounds-y.min
            max-x = bounds-x.max
            max-y = bounds-y.max
            waiting-for-first = false
        else
            if bounds-x.min < min-x
                min-x = bounds-x.min
            if bounds-y.min < min-y
                min-y = bounds-y.min
            if bounds-x.max > max-x
                max-x = bounds-x.max
            if bounds-y.max > max-y
                max-y = bounds-y.max

        current-x = x2
        current-y = y2
    else if verb == .path-verb-cubic && has-current
        . outgoing = bounds-point(start, transform)
        . incoming = bounds-point(start + 2, transform)
        . end = bounds-point(start + 4, transform)
        . hox = outgoing.x
        . hoy = outgoing.y
        . hix = incoming.x
        . hiy = incoming.y
        . x2 = end.x
        . y2 = end.y
        . bounds-x = get-curve-coord-bounds(current-x, hox, hix, x2)
        . bounds-y = get-curve-coord-bounds(current-y, hoy, hiy, y2)
        if waiting-for-first
            min-x = bounds-x.min
            min-y = bounds-y.min
            max-x = bounds-x.max
            max-y = bounds-y.max
            waiting-for-first = false
        else
            if bounds-x.min < min-x
                min-x = bounds-x.min
            if bounds-y.min < min-y
                min-y = bounds-y.min
            if bounds-x.max > max-x
                max-x = bounds-x.max
            if bounds-y.max > max-y
                max-y = bounds-y.max

        current-x = x2
        current-y = y2
    else if verb == .path-verb-close && has-current
        if current-x != subpath-x || current-y != subpath-y
            . bounds-x = get-line-coord-bounds(current-x, subpath-x)
            . bounds-y = get-line-coord-bounds(current-y, subpath-y)
            if waiting-for-first
                min-x = bounds-x.min
                min-y = bounds-y.min
                max-x = bounds-x.max
                max-y = bounds-y.max
                waiting-for-first = false
            else
                if bounds-x.min < min-x
                    min-x = bounds-x.min
                if bounds-y.min < min-y
                    min-y = bounds-y.min
                if bounds-x.max > max-x
                    max-x = bounds-x.max
                if bounds-y.max > max-y
                    max-y = bounds-y.max

            current-x = subpath-x
            current-y = subpath-y

= Rect(min-x, min-y, max-x - min-x, max-y - min-y)

────────────────────
_ bounds-point
    - start Index
    - transform Matrix?

if transform then transform.transform(point) else point

.. point = Point(coords[start], coords[start + 1])

────────────────────
_ do get is-line-polygon

=? if !is-closed
=? if command-count < 4

for i in 0 .. < command-count
    . verb = verbs[i]
    =? if verb == .path-verb-cubic
    =? if verb == .path-verb-move && i != 0

= true

────────────────────
+ do this + other Path

. clone = Path(this)
clone.add-path(other)
= clone

────────────────────
+ do reserve
    - command-capacity Size
    - coord-capacity Size

if command-capacity > verbs.size
    verbs = verbs.resize(command-capacity)

if command-capacity + 1 > coord-offsets.size
    coord-offsets = coord-offsets.resize(command-capacity + 1)

if coord-capacity > coords.size
    coords = coords.resize(coord-capacity)

coord-offsets[command-count] = coord-count

────────────────────
+ do clear

command-count = 0
coord-count = 0
coord-offsets[0] = 0
is-closed = false
matrix = null
point-table = null
control-projection-bounds-cache.clear()
control-bounding-box-cache = null
mark-mutated()

────────────────────
+ do trim

if command-count < verbs.size
    verbs = verbs.resize(command-count)
if command-count + 1 < coord-offsets.size
    coord-offsets = coord-offsets.resize(command-count + 1)
if coord-count < coords.size
    coords = coords.resize(coord-count)
control-projection-bounds-cache.trim()

────────────────────
+ do release

clear()
verbs = verbs.resize(0)
coord-offsets = coord-offsets.resize(1)
coords = coords.resize(0)
control-projection-bounds-cache.release()

────────────────────
+ do get-curves
    - with-closer = false

. reader = curve-reader
while reader.next()
    <= reader.curve

if with-closer && !is-closed && command-count > 1
    . first = first-point
    . last = last-point
    <= Curve(last, last, first, first, .segment-type-line)

────────────────────
+ materialize-curves [Curve]

each in get-curves()

────────────────────
+ do materialize-segments

. segments [PathSegment]
. current-x Coord
. current-y Coord
. subpath-x Coord
. subpath-y Coord
. has-current = false

for i in 0 .. < command-count
    . verb = verbs[i]
    . start = coord-offsets[i]

    if verb == .path-verb-move
        current-x = coords[start]
        current-y = coords[start + 1]
        subpath-x = current-x
        subpath-y = current-y
        segments += (.segment-type-move, (current-x, current-y), (current-x, current-y), (current-x, current-y))
        has-current = true
    else if verb == .path-verb-line
        current-x = coords[start]
        current-y = coords[start + 1]
        segments += (.segment-type-line, (current-x, current-y), (current-x, current-y), (current-x, current-y))
    else if verb == .path-verb-cubic
        . hox = coords[start]
        . hoy = coords[start + 1]
        . hix = coords[start + 2]
        . hiy = coords[start + 3]
        current-x = coords[start + 4]
        current-y = coords[start + 5]
        if segments
            segments[Position.last] = segments[Position.last].handle-out = (hox, hoy)
        segments += (.segment-type-cubic, (current-x, current-y), (hix, hiy), (current-x, current-y))
    else if verb == .path-verb-close && has-current
        if current-x != subpath-x || current-y != subpath-y
            segments += (.segment-type-line, (subpath-x, subpath-y), (subpath-x, subpath-y), (subpath-x, subpath-y))
        current-x = subpath-x
        current-y = subpath-y

= segments

────────────────────
+ do trace
    - sink PathTraceSink

. reader = command-reader
while reader.next()
    if reader.verb == .path-verb-move
        sink.move(reader.coord(0), reader.coord(1))
    else if reader.verb == .path-verb-line
        sink.line(reader.coord(0), reader.coord(1))
    else if reader.verb == .path-verb-cubic
        sink.cubic()
            - reader.coord(0)
            - reader.coord(1)
            - reader.coord(2)
            - reader.coord(3)
            - reader.coord(4)
            - reader.coord(5)
    else if reader.verb == .path-verb-close
        sink.close()

────────────────────
+ do get-curve-bounding-box
    - index Index

//graphics.path.bounding-box.curves ++
. command-index = index + 1
if command-index < command-count
    . verb = verbs[command-index]
    . prev-index = command-index - 1
    . prev-verb = verbs[prev-index]
    . prev-start = coord-offsets[prev-index]
    . x1 Coord
    . y1 Coord
    . has-prev = false

    if prev-verb == .path-verb-move || prev-verb == .path-verb-line
        x1 = coords[prev-start]
        y1 = coords[prev-start + 1]
        has-prev = true
    else if prev-verb == .path-verb-cubic
        x1 = coords[prev-start + 4]
        y1 = coords[prev-start + 5]
        has-prev = true

    if has-prev
        . start = coord-offsets[command-index]
        if verb == .path-verb-line
            . x2 = coords[start]
            . y2 = coords[start + 1]
            . bounds-x = get-line-coord-bounds(x1, x2)
            . bounds-y = get-line-coord-bounds(y1, y2)
            = Rect()
                - bounds-x.min
                - bounds-y.min
                - bounds-x.max - bounds-x.min
                - bounds-y.max - bounds-y.min
        else if verb == .path-verb-cubic
            . hox = coords[start]
            . hoy = coords[start + 1]
            . hix = coords[start + 2]
            . hiy = coords[start + 3]
            . x2 = coords[start + 4]
            . y2 = coords[start + 5]
            . bounds-x = get-curve-coord-bounds(x1, hox, hix, x2)
            . bounds-y = get-curve-coord-bounds(y1, hoy, hiy, y2)
            = Rect()
                - bounds-x.min
                - bounds-y.min
                - bounds-x.max - bounds-x.min
                - bounds-y.max - bounds-y.min

. curve = get-curve-scalars(index)
if curve.found
    . bounds-x =
        |? curve.type == .segment-type-line
            get-line-coord-bounds(curve.x1, curve.x2)
        ??
            get-curve-coord-bounds(curve.x1, curve.hox, curve.hix, curve.x2)
    . bounds-y =
        |? curve.type == .segment-type-line
            get-line-coord-bounds(curve.y1, curve.y2)
        ??
            get-curve-coord-bounds(curve.y1, curve.hoy, curve.hiy, curve.y2)
    = Rect(bounds-x.min, bounds-y.min, bounds-x.max - bounds-x.min, bounds-y.max - bounds-y.min)

?! OutOfBoundsError("Curve out of bounds")

────────────────────
+ do get-control-projection-bounds
    - line-ux Coord
    - line-uy Coord

for bounds in control-projection-bounds-cache
    if abs(bounds.line-ux - line-ux) < tolerance-tight && uy-matches
        = bounds
    .. uy-matches = abs(bounds.line-uy - line-uy) < tolerance-tight

. min-side Coord
. max-side Coord
. min-proj Coord
. max-proj Coord
. waiting-for-first = true

. current-x Coord
. current-y Coord
. subpath-x Coord
. subpath-y Coord
. has-current = false

for i in 0 .. < command-count
    . verb = verbs[i]
    . start = coord-offsets[i]
    . x1 Coord
    . y1 Coord
    . hox Coord
    . hoy Coord
    . hix Coord
    . hiy Coord
    . x2 Coord
    . y2 Coord
    . has-curve = false

    if verb == .path-verb-move
        current-x = coords[start]
        current-y = coords[start + 1]
        subpath-x = current-x
        subpath-y = current-y
        has-current = true
    else if verb == .path-verb-line && has-current
        x1 = current-x
        y1 = current-y
        x2 = coords[start]
        y2 = coords[start + 1]
        hox = x1
        hoy = y1
        hix = x2
        hiy = y2
        current-x = x2
        current-y = y2
        has-curve = true
    else if verb == .path-verb-cubic && has-current
        x1 = current-x
        y1 = current-y
        hox = coords[start]
        hoy = coords[start + 1]
        hix = coords[start + 2]
        hiy = coords[start + 3]
        x2 = coords[start + 4]
        y2 = coords[start + 5]
        current-x = x2
        current-y = y2
        has-curve = true
    else if verb == .path-verb-close && has-current
        if current-x != subpath-x || current-y != subpath-y
            x1 = current-x
            y1 = current-y
            x2 = subpath-x
            y2 = subpath-y
            hox = x1
            hoy = y1
            hix = x2
            hiy = y2
            has-curve = true
        current-x = subpath-x
        current-y = subpath-y

    if has-curve
        for point-index in 0 .. < 4
            . x =
                |? point-index == 0
                    x1
                |? point-index == 1
                    hox
                |? point-index == 2
                    hix
                ??
                    x2
            . y =
                |? point-index == 0
                    y1
                |? point-index == 1
                    hoy
                |? point-index == 2
                    hiy
                ??
                    y2
            . side = x * line-uy - y * line-ux
            . proj = x * line-ux + y * line-uy

            if waiting-for-first
                min-side = side
                max-side = side
                min-proj = proj
                max-proj = proj
                waiting-for-first = false
            else
                if side < min-side
                    min-side = side
                if side > max-side
                    max-side = side
                if proj < min-proj
                    min-proj = proj
                if proj > max-proj
                    max-proj = proj

. bounds = ControlProjectionBounds(line-ux, line-uy, min-side, max-side, min-proj, max-proj)
control-projection-bounds-cache += bounds
= bounds

────────────────────
+ do close

//graphics.path.close.calls ++
if command-count > 1 && verbs[command-count - 1] != .path-verb-close
    is-closed = true
    append-command(.path-verb-close, 0)

────────────────────
+ do reopen

if is-closed
    is-closed = false
    if command-count && verbs[command-count - 1] == .path-verb-close
        command-count -= 1
        coord-count = coord-offsets[command-count]
        coord-offsets[command-count] = coord-count
        mark-mutated()

