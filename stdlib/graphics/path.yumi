────────────────────
+ do quadratic-curve-to
    - hx Coord
    - hy Coord
    - x Coord
    - y Coord

. start = last-point
. j = 2.0 / 3.0
. hox = start.x + (j * (hx - start.x))
. hoy = start.y + (j * (hy - start.y))
. hix = x + (j * (hx - x))
. hiy = y + (j * (hy - y))

cubic-curve-to(hox, hoy, hix, hiy, x, y)

