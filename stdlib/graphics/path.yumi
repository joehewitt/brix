────────────────────
+ do materialize
    - path Path

path.clear()
path.reserve(command-count, span.coord-offsets[command-end] - span.coord-offsets[command-start])

for i in command-start .. < command-end
    . verb = span.verbs[i]
    . start = span.coord-offsets[i]
    if verb == .path-verb-move
        path.move-to(span.coords[start], span.coords[start + 1])
    else if verb == .path-verb-line
        path.line-to(span.coords[start], span.coords[start + 1])
    else if verb == .path-verb-cubic
        path.cubic-curve-to()
            - span.coords[start]
            - span.coords[start + 1]
            - span.coords[start + 2]
            - span.coords[start + 3]
            - span.coords[start + 4]
            - span.coords[start + 5]
    else if verb == .path-verb-close
        path.close()

= path

────────────────────
+ do get-control-projection-bounds
    - line-ux Coord
    - line-uy Coord

. min-side Coord
. max-side Coord
. min-proj Coord
. max-proj Coord
. waiting-for-first = true

. current-x Coord
. current-y Coord
. subpath-x Coord
. subpath-y Coord
. has-current = false

for i in command-start .. < command-end
    . verb = span.verbs[i]
    . start = span.coord-offsets[i]
    . x1 Coord
    . y1 Coord
    . hox Coord
    . hoy Coord
    . hix Coord
    . hiy Coord
    . x2 Coord
    . y2 Coord
    . has-curve = false

    if verb == .path-verb-move
        current-x = span.coords[start]
        current-y = span.coords[start + 1]
        subpath-x = current-x
        subpath-y = current-y
        has-current = true
    else if verb == .path-verb-line && has-current
        x1 = current-x
        y1 = current-y
        x2 = span.coords[start]
        y2 = span.coords[start + 1]
        hox = x1
        hoy = y1
        hix = x2
        hiy = y2
        current-x = x2
        current-y = y2
        has-curve = true
    else if verb == .path-verb-cubic && has-current
        x1 = current-x
        y1 = current-y
        hox = span.coords[start]
        hoy = span.coords[start + 1]
        hix = span.coords[start + 2]
        hiy = span.coords[start + 3]
        x2 = span.coords[start + 4]
        y2 = span.coords[start + 5]
        current-x = x2
        current-y = y2
        has-curve = true
    else if verb == .path-verb-close && has-current
        if current-x != subpath-x || current-y != subpath-y
            x1 = current-x
            y1 = current-y
            x2 = subpath-x
            y2 = subpath-y
            hox = x1
            hoy = y1
            hix = x2
            hiy = y2
            has-curve = true
        current-x = subpath-x
        current-y = subpath-y

    if has-curve
        for point-index in 0 .. < 4
            . x =
                |? point-index == 0
                    x1
                |? point-index == 1
                    hox
                |? point-index == 2
                    hix
                ??
                    x2
            . y =
                |? point-index == 0
                    y1
                |? point-index == 1
                    hoy
                |? point-index == 2
                    hiy
                ??
                    y2
            . side = x * line-uy - y * line-ux
            . proj = x * line-ux + y * line-uy

            if waiting-for-first
                min-side = side
                max-side = side
                min-proj = proj
                max-proj = proj
                waiting-for-first = false
            else
                if side < min-side
                    min-side = side
                if side > max-side
                    max-side = side
                if proj < min-proj
                    min-proj = proj
                if proj > max-proj
                    max-proj = proj

= ControlProjectionBounds(line-ux, line-uy, min-side, max-side, min-proj, max-proj)

