────────────────────
+ This
    - path Path

reserve(path.command-count, path.coord-count)
command-count = path.command-count
coord-count = path.coord-count
path-revision = path.path-revision
is-closed = path.is-closed
matrix = path.matrix

for i in 0 .. < command-count
    verbs[i] = path.verbs[i]

for i in 0 .. < command-count + 1
    coord-offsets[i] = path.coord-offsets[i]

for i in 0 .. < coord-count
    coords[i] = path.coords[i]

────────────────────
+ This
    - points [Point]

reserve(points.length, points.length * 2)
move-to(points[0])
for i in 1 .. < points.length
    line-to(points[i])

