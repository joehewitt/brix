+ do add-path-reverse
    - source Path

. total-curves = source.curve-count
=? if !total-curves

. has-close-edge = false
. found-last-curve = false
. command-index = source.command-count
while command-index > 0
    command-index -= 1
    . curve = source.get-command-curve-scalars(command-index)
    if curve.found
        has-close-edge = curve.is-close
        found-last-curve = true
        break

. should-skip-first-curve = source.is-closed && found-last-curve && has-close-edge
. remaining-curves = total-curves
. did-start = false
reserve(count + source.count, coord-size + source.coord-size)
begin-mutation()
command-index = source.command-count
while command-index > 0
    command-index -= 1
    . curve = source.get-command-curve-scalars(command-index)
    if !curve.found
        continue

    remaining-curves -= 1
    if should-skip-first-curve && remaining-curves == 0
        continue
    if !did-start
        move-to(curve.x2, curve.y2)
    if curve.type == .segment-type-line
        line-to(curve.x1, curve.y1)
    else
        cubic-curve-to(curve.hix, curve.hiy, curve.hox, curve.hoy, curve.x1, curve.y1)
    did-start = true

if source.is-closed && did-start
    close()
end-mutation()

