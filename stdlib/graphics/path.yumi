_ normalize-parameter
    - t PointOnCurve

match t
    |= max
        max - tolerance
    |= 0
        tolerance
    ??
        t

.. max = curve-count

────────────────────
_ constrain-parameter
    - t PointOnCurve

|? t < 0
    cc + abs(t % curve-count)
|? t > cc
    t % curve-count
??
    t

.. cc = curve-count

────────────────────
_ do append-command Index
    - verb PathVerb
    - coord-size Size

ensure-command-capacity(command-count + 1)
ensure-coord-capacity(coord-count + coord-size)

verbs[command-count] = verb
coord-offsets[command-count] = coord-count
. start = coord-count
coord-count += coord-size
command-count += 1
coord-offsets[command-count] = coord-count

//graphics.path.segments.appended ++
mark-mutated()
= start

────────────────────
_ do ensure-command-capacity
    - needed Size

if needed > verbs.size
    verbs = verbs.resize(next-command-capacity(verbs.size, needed))

if needed + 1 > coord-offsets.size
    coord-offsets = coord-offsets.resize(next-offset-capacity(coord-offsets.size, needed + 1))

────────────────────
_ do ensure-coord-capacity
    - needed Size

if needed > coords.size
    coords = coords.resize(next-coord-capacity(coords.size, needed))

────────────────────
_ do next-command-capacity Size
    - current Size
    - needed Size

. new-size = if current < 16 then 16 else current * 2
if new-size < needed
    new-size = needed
= new-size

────────────────────
_ do next-offset-capacity Size
    - current Size
    - needed Size

. current-commands Size
if current > 0
    current-commands = current - 1

. needed-commands Size
if needed > 0
    needed-commands = needed - 1

= next-command-capacity(current-commands, needed-commands) + 1

────────────────────
_ do next-coord-capacity Size
    - current Size
    - needed Size

. new-size = if current < 32 then 32 else current * 2
if new-size < needed
    new-size = needed
= new-size

────────────────────
_ do last-anchor

. x Coord
. y Coord
. subpath-x Coord
. subpath-y Coord
. has-current = false

for i in 0 .. < command-count
    . verb = verbs[i]
    . start = coord-offsets[i]
    if verb == .path-verb-move
        x = coords[start]
        y = coords[start + 1]
        subpath-x = x
        subpath-y = y
        has-current = true
    else if verb == .path-verb-line
        x = coords[start]
        y = coords[start + 1]
    else if verb == .path-verb-cubic
        x = coords[start + 4]
        y = coords[start + 5]
    else if verb == .path-verb-close && has-current
        x = subpath-x
        y = subpath-y

= Point(x, y)

