    - bbox-end Rect

begin-mutation()
. origin = bbox-start.center
. scaler = Dimensions
    - bbox-end.width / bbox-start.width
    - bbox-end.height / bbox-start.height
. offset = Point
    - (bbox-end.x - bbox-start.x) / scaler.width
    - (bbox-end.y - bbox-start.y) / scaler.height

if matrix
    . inverse-matrix = matrix.create-inverse()
    if inverse-matrix
        transform(inverse-matrix)

. mx = matrix-from-translation
    - Point
        - origin.x - bbox-start.width / 2
        - origin.y - bbox-start.height / 2
mx = mx.scale(scaler)
mx = mx.translate
    - Point
        - offset.x - origin.x + bbox-start.width / 2
        - offset.y - origin.y + bbox-start.height / 2

if matrix
    mx.pre-concatenate(matrix)

transform(mx)
end-mutation()

