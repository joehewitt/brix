────────────────────
+ do cubic-curve-to
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x Coord
    - y Coord

//graphics.path.build.cubics ++
. start = append-command(.path-verb-cubic, 6)
coords[start] = hox
coords[start + 1] = hoy
coords[start + 2] = hix
