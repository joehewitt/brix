for i in 0 .. < coord-count by 2
    . x = coords[i]
    . y = coords[i + 1]
    coords[i] = x * matrix.a + y * matrix.b + matrix.tx
    coords[i + 1] = x * matrix.c + y * matrix.d + matrix.ty
mark-mutated()

