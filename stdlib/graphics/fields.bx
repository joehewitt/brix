(import ./color)
(import ./primitives)
(import /math)
(import /units)

(type + (of Streamer Source Result) (is (fn-type (of Iterable Result) (param layer Source)))
  (fn-from-expr + (: value Float)
    (=> (self) :do
      (block
        (while true
          (yield value)
        )
      )
    )
  )
  (fn-from-expr + (: value Int)
    (=> (self) :do
      (block
        (while true
          (yield (as value Result))
        )
      )
    )
  )
  (fn-from-expr + (: value HSVA)
    (=> (self) :do
      (block
        (while true
          (yield value)
        )
      )
    )
  )
  (fn-from-expr + (: value Result)
    (=> (self) :do
      (block
        (while true
          (yield value)
        )
      )
    )
  )
)

(fn-do + (of sin-grad T) _
  (param increment Radians)
  (param max-value T)
  (param min-value T (= 0))
  (let a Radians 0)
  (while true
    (yield (+ min-value (* (call sin a) (- max-value min-value))))
    (blank)
    (+= a increment)
  )
)

(fn-expr + (of sin T) _
  (param increment Radians)
  (param max-value T)
  (param min-value T (= 0))
  (=> (self)
    (block
      (call sin-grad increment max-value min-value)
    )
  )
)

(fn-do + (of grad T) _
  (param amount T)
  (param decrement Percent)
  (while true
    (yield amount)
    (blank)
    (*= amount (/ (- 100% decrement) 100))
  )
)

(fn-do + (of linear-grad T) _
  (param increment T)
  (param min-value T)
  (param max-value T)
  (let amount min-value)
  (while true
    (yield amount)
    (blank)
    (+= amount increment)
    (if (> amount max-value)
      (= amount min-value)
    )
  )
)

(fn-do + (of random-grad T) _
  (param min-value T)
  (param max-value T)
  (while true
    (yield (call random min-value max-value))
  )
)

(fn-expr + (of random-field T) _
  (param min-value T)
  (param max-value T)
  (=> (self)
    (block
      (call random-grad min-value max-value)
    )
  )
)
