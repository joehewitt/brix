(import ./color)
(import ./point)
(import ./primitives)
(import /core/animatable)
(import /math)
(blank)
(prop _ outline-arrow-inset-ratio _ (= 0.41421356237309515))

(type + OutlineArrow (is (tuple (: side Side) (: offset Length) (: size Length))))

(type + Outline (is Tuple)
  (prop + bounds Rect)
  (prop + radius Length (= 0))
  (prop + arrow (? OutlineArrow) (= null))
  (fn-expr + effective-radius Length :get
    (call max 0 (call min radius (/ (call min (. bounds width) (. bounds height)) 2)))
  )
  (fn-expr + is-rectangular _ :get
    (and (<= effective-radius 0) (not arrow))
  )
  (fn-expr + extent Rect :get
    (match (?. arrow side)
      (case= (. Side top)
        (call Rect (. bounds x) (- (. bounds y) size) (. bounds width) (+ (. bounds height) size))
      )
      (case= (. Side bottom)
        (call Rect (. bounds x) (. bounds y) (. bounds width) (+ (. bounds height) size))
      )
      (case= (. Side left)
        (call Rect (- (. bounds x) size) (. bounds y) (+ (. bounds width) size) (. bounds height))
      )
      (case= (. Side right)
        (call Rect (. bounds x) (. bounds y) (+ (. bounds width) size) (. bounds height))
      )
      (default
        bounds
      )
    )
    (where
      (lazy size (?? (?. arrow size) 0))
    )
  )
  (fn-expr + grow Outline
    (param amount Length)
    (call Outline
      (block
        (arg (call (. bounds pad) (- amount)))
        (arg (if-expr (> radius 0) (call max 0 (+ radius amount)) 0))
        (arg (only-if (call OutlineArrow (. arrow side) (+ (. arrow offset) amount) grown-size) (if arrow)))
      )
    )
    (where
      (lazy grown-size (call max 0 (+ (. arrow size) (* amount outline-arrow-inset-ratio))))
    )
  )
  (fn-expr + arrow-span Length :get
    (if-expr (or (== (?. arrow side) (. Side left)) (== (?. arrow side) (. Side right))) (. bounds height) (. bounds width))
  )
  (fn-expr + arrow-fits _ :get
    (>= (- arrow-span (* effective-radius 2)) (* (?? (?. arrow size) 0) 2))
  )
  (fn-expr + arrow-tip Length :get
    (if-expr arrow-fits (call min (call max (?? (?. arrow offset) 0) low) high) (/ arrow-span 2))
    (where
      (lazy low (+ effective-radius (?? (?. arrow size) 0)))
      (lazy high (- arrow-span effective-radius (?? (?. arrow size) 0)))
    )
  )
  (fn-expr + arrow-half _ :get
    (if-expr arrow-fits (?? (?. arrow size) 0) (call max 0 (- (/ arrow-span 2) effective-radius)))
  )
  (fn-expr + contains _
    (param point Point)
    (case? (call (. bounds contains) point)
      (or (<= radius 0) (<= (+ (* dx dx) (* dy dy)) (* radius radius)))
    )
    (case? (or (<= size 0) (< depth 0) (> depth size))
      false
    )
    (default
      (<= (call abs (- along arrow-tip)) (* arrow-half (- 1 (/ depth size))))
    )
    (where
      (lazy radius effective-radius)
      (lazy dx (- (. point x) (call min (call max (. point x) (+ (. bounds x) radius)) (- (. bounds right) radius))))
      (lazy dy (- (. point y) (call min (call max (. point y) (+ (. bounds y) radius)) (- (. bounds bottom) radius))))
      (lazy size (?? (?. arrow size) 0))
      (lazy side (. (!! arrow) side))
      (lazy depth
        (match side
          (case= (. Side top)
            (- (. bounds y) (. point y))
          )
          (case= (. Side bottom)
            (- (. point y) (. bounds bottom))
          )
          (case= (. Side left)
            (- (. bounds x) (. point x))
          )
          (default
            (- (. point x) (. bounds right))
          )
        )
      )
      (lazy along (if-expr vertical-side (- (. point y) (. bounds y)) (- (. point x) (. bounds x))))
      (lazy vertical-side (or (== side (. Side left)) (== side (. Side right))))
    )
  )
)

(type + Shadow (is Tuple)
  (implements Animatable)
  (prop + color RGBA)
  (prop + blur Length (= 0))
  (prop + x Coord (= 0))
  (prop + y Coord (= 0))
  (prop + spread Length (= 0))
  (fn-do + This _
    (param vector (list F64))
    (return
      (call This
        (block
          (arg (call RGBA (list ([] vector 0) ([] vector 1) ([] vector 2) ([] vector 3))))
          (arg (call max 0.0 ([] vector 4)))
          (arg ([] vector 5))
          (arg ([] vector 6))
          (arg ([] vector 7))
        )
      )
    )
  )
  (fn-expr + reach Length :get
    (+ (* (call max 0 blur) 1.5) (call max 0 spread))
  )
  (fn-expr + extent Rect
    (param rect Rect)
    (call (. (call Rect (+ (. rect x) x) (+ (. rect y) y) (. rect width) (. rect height)) pad) (- reach))
  )
  (fn-expr + motion-vector (list F64) :get
    (list ([] paint 0) ([] paint 1) ([] paint 2) ([] paint 3) (as blur F64) (as x F64) (as y F64) (as spread F64))
    (where
      (lazy paint (. color motion-vector))
    )
  )
  (fn-expr + motion-none-vector (list F64) :get
    (list 0.0 0.0 0.0 0.0 (as blur F64) (as x F64) (as y F64) (as spread F64))
  )
)

(fn-expr + outline-side-code _
  (param arrow (? OutlineArrow))
  (match (?. arrow side)
    (case= (. Side top)
      0
    )
    (case= (. Side bottom)
      1
    )
    (case= (. Side left)
      2
    )
    (case= (. Side right)
      3
    )
    (default
      -1
    )
  )
)
