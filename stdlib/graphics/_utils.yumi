+ do clip-convex-hull PointOnCurve?
    - top [Point]
    - bottom [Point]
    - d-min
    - d-max

` CREDIT: Paper.js
//graphics.numeric.hull-clips ++
. t-proxy PointOnCurve?
. t-val PointOnCurve?
. px Coord
. py Coord
. qx Coord
. qy Coord
for i in 0 .. < bottom.length - 1
    py = bottom[i].y
    qy = bottom[i + 1].y
     if py < qy
        t-proxy = null
     else if qy <= d-max
         px = bottom[i].x
         qx = bottom[i + 1].x
         t-proxy = px + (d-max  - py) * (qx - px) / (qy - py)
    else
        ` Try the next chain
        continue

    `We got a proxy-t
    break

if top[0].y <= d-max
    t-proxy = top[0].x

for i in 0 .. < top.length - 1
    py = top[i].y
    qy = top[i + 1].y
    if py >= d-min
        t-val = t-proxy
    else if py > qy
        t-val = null
    else if qy >= d-min
        px = top[i].x
        qx = top[i + 1].x
        t-val = px + (d-min  - py) * (qx - px) / (qy - py)
    else
        continue
    break

= t-val

━━━━━━━━━━━━━━━━━━━━
+ do solve-quadratic
    - a
    - b
    - c
    - tolerance

//graphics.numeric.quadratic-roots ++
` Code ported over and adapted from Uintah library (MIT license).
` If problem is actually linear, return 0 or 1 easy roots

if abs(a) < tolerance
    if abs(b) >= tolerance
        = CurveRoots
            - -c / b
    else if abs(c) < tolerance
        = CurveRoots(0, 0, 0, -1)
    else
        = CurveRoots()

. q = b * b - 4.0 * a * c
if q < 0
    = CurveRoots()

q = sqrt(q)
a *= 2

if q > 0
    = CurveRoots
        - (-b - q) / a
        - (-b + q) / a
else
    = CurveRoots
        - (-b - q) / a

━━━━━━━━━━━━━━━━━━━━
+ do solve-cubic CurveRoots
    - a
    - b
    - c
    - d
    - tolerance

//graphics.numeric.cubic-roots ++
` Code ported over and adapted from Uintah library (MIT license).

if abs(a) < tolerance
    = solve-quadratic(b, c, d, tolerance)

` Normalize to form: x^3 + b x^2 + c x + d = 0:
b /= a
c /= a
d /= a

` Compute discriminants
. bb = b * b
. p = 1.0 / 3.0 * (-1.0 / 3.0 * bb + c)
. q = 1.0 / 2.0 * (2.0 / 27.0 * b * bb - 1.0 / 3.0 * b * c + d)

` Use Cardano's formula
. ppp = p * p * p
. dd = q * q + ppp

` Substitute x = y - b/3 to eliminate quadric term: x^3 +px + q = 0
b /= 3

if abs(dd) < tolerance
    if abs(q) < tolerance
        ` One triple solution
        = CurveRoots
            - -b
    else
        ` One single and one double solution
        . u = cbrt(-q)
        = CurveRoots
            - 2.0 * u - b
            - -u - b
else if dd < 0
    ` Casus irreducibilis: three real solutions
    . phi = 1.0 / 3.0 * acos(-q / sqrt(-ppp))
    . t = 2.0 * sqrt(-p)
    = CurveRoots
        - t * cos(phi) - b
        - -t * cos(phi + π / 3.0) - b
        - -t * cos(phi - π / 3.0) - b
else
    ` One real solution
    . sdd = sqrt(dd)
    = CurveRoots
        - cbrt(sdd - q) - cbrt(sdd + q) - b
