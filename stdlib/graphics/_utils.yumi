+ origin-x Coord
+ is-vertical Bool
+ is-ascending Bool
+ slope Coord
+ intercept Coord
+ norm Coord

────────────────────
+ distance Coord
    - a Point

//graphics.numeric.signed-distances ++
|? is-vertical && is-ascending
    a.x - origin-x
|? is-vertical
    origin-x - a.x
??
    (a.y - (slope * a.x) - intercept) / norm

