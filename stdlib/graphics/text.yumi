━━━━━━━━━━━━━━━━━━━━
_ do narrowest-text-layout
    - build TextLayoutBuilder
    - cap Length
    - precision Length

. winner = build(cap)
=? winner if cap == 0 || winner.width > cap || winner.line-count == 1
. lower = 0.0
. upper = cap
while upper - lower > precision
    . midpoint = (lower + upper) / 2
    if midpoint == lower || midpoint == upper
        break
    . candidate = build(midpoint)
    if same-text-lines(candidate, winner)
        winner.close()
        winner = candidate
        upper = midpoint
    else
        candidate.close()
        lower = midpoint

. derived-width = winner.width
if derived-width > 0 && derived-width < (winner.request.maximum-width ?? cap)
    . derived = build(derived-width)
    if same-text-lines(derived, winner)
        winner.close()
        winner = derived
    else
        derived.close()
= winner

━━━━━━━━━━━━━━━━━━━━
_ same-text-lines
    - candidate TextLayout
    - target TextLayout

candidate.line-count == target.line-count && candidate.height == target.height

━━━━━━━━━━━━━━━━━━━━
_ text-safe-span
    - value Length

if is-finite(value) then max(0, value) else 0

━━━━━━━━━━━━━━━━━━━━
_ do native-text-layout-head TextLayoutSnapshot
    - native Pointer

. width = C:yumiGraphicsTextLayoutGetWidth(native)
. height = C:yumiGraphicsTextLayoutGetHeight(native)
. line-count = C:yumiGraphicsTextLayoutGetLineCount(native)
. lines [TextLineSnapshot]
= TextLayoutSnapshot
    - Dimensions(width, height)
    - C:yumiGraphicsTextLayoutGetNaturalWidth(native)
    - C:yumiGraphicsTextLayoutGetConstrainedWidth(native)
    - line-count
    - C:yumiGraphicsTextLayoutGetBaseline(native)
    - C:yumiGraphicsTextLayoutGetLastBaseline(native)
    - C:yumiGraphicsTextLayoutIsTruncated(native)
    - lines

━━━━━━━━━━━━━━━━━━━━
_ do append-native-segment
    - builder Pointer
    - segment TextSegment

do match segment.object
    | TextObjectMetrics
        C:yumiGraphicsStyledTextAppendObject
            - builder
            - it.width
            - it.ascent
            - it.descent
            - segment.tag
            - segment.join-before
            - segment.join-after
    ??
        . color = segment.color ?? transparent
        C:yumiGraphicsStyledTextAppendText
            - builder
            - segment.text
            - segment.font.family
            - segment.font.size
            - segment.font.weight.trait
            - segment.font.slant == FontSlant.italic
            - segment.color != null
            - color.red
            - color.green
            - color.blue
            - color.alpha
            - segment.tag

━━━━━━━━━━━━━━━━━━━━
_ native-text-layout-fragments
    - native Pointer

** 0 .. < C:yumiGraphicsTextLayoutGetFragmentCount(native)
*> TextFragment
    - C:yumiGraphicsTextLayoutGetFragmentTag(native, each)
    - C:yumiGraphicsTextLayoutGetFragmentLine(native, each)
    - C:yumiGraphicsTextLayoutGetFragmentX(native, each)
    - C:yumiGraphicsTextLayoutGetFragmentWidth(native, each)
    - C:yumiGraphicsTextLayoutGetFragmentAscent(native, each)
    - C:yumiGraphicsTextLayoutGetFragmentDescent(native, each)
|> List

━━━━━━━━━━━━━━━━━━━━
_ native-text-layout-lines
    - native Pointer
    - line-count Int

** 0 .. < line-count
*> TextLineSnapshot
    - typographic
    - ink
    - C:yumiGraphicsTextLayoutGetLineBaseline(native, index)
    - C:yumiGraphicsTextLayoutGetLineAscent(native, index)
    - C:yumiGraphicsTextLayoutGetLineDescent(native, index)
    - C:yumiGraphicsTextLayoutGetLineLeading(native, index)
    .. index = each
    .. typographic = Rect
        - C:yumiGraphicsTextLayoutGetLineTypographicX(native, index)
        - C:yumiGraphicsTextLayoutGetLineTypographicY(native, index)
        - C:yumiGraphicsTextLayoutGetLineWidth(native, index)
        - C:yumiGraphicsTextLayoutGetLineHeight(native, index)
    .. ink = Rect
        - C:yumiGraphicsTextLayoutGetLineInkX(native, index)
        - C:yumiGraphicsTextLayoutGetLineInkY(native, index)
        - C:yumiGraphicsTextLayoutGetLineInkWidth(native, index)
        - C:yumiGraphicsTextLayoutGetLineInkHeight(native, index)
|> List

━━━━━━━━━━━━━━━━━━━━
_ normalized-text-line String
    - line TextLineSnapshot

"".join
    * "typographic-bounds=(${text-rect(line.typographic-bounds)}),"
    * "ink-bounds=(${text-rect(line.ink-bounds)}),"
    * "baseline=${text-scalar(line.baseline)},"
    * "ascent=${text-scalar(line.ascent)},"
    * "descent=${text-scalar(line.descent)},"
    * "leading=${text-scalar(line.leading)}"

━━━━━━━━━━━━━━━━━━━━
_ text-rect String
    - rect Rect

"".join
    * "${text-scalar(rect.x)},${text-scalar(rect.y)},"
    * "${text-scalar(rect.width)},${text-scalar(rect.height)}"

━━━━━━━━━━━━━━━━━━━━
_ do text-scalar String
    - value Float

. scaled = round(value * 1000) as I64
. sign = if scaled < 0 then "-" else ""
. magnitude = if scaled < 0 then -scaled else scaled
. whole = magnitude / 1000
. fraction = magnitude % 1000
. fraction-text = "$fraction"
while fraction-text.length < 3
    fraction-text = "0$fraction-text"
= "$sign$whole.$fraction-text"
