────────────────────
_ do shape

. maximum-width = request.maximum-width ?? 0
. created = C:yumiGraphicsTextLayoutCreate
    - request.text
    - request.font.family
    - request.font.size
    - request.font.weight.trait
    - request.font.slant == FontSlant.italic
    - request.maximum-width != null
    - maximum-width
    - request.maximum-height != null
    - request.maximum-height ?? 0
    - text-truncation(request.overflow)
    - request.wrap == TextWrap.word
    - request.line-spacing
//graphics.text.fonts-created += C:yumiGraphicsTextLayoutGetLastFontCreateMissCount() as U64
?! TextLayoutRequestPanic("Unable to create text layout")
    if !created
native-value = created
adopt-native()

────────────────────
_ do adopt-native

. head = native-text-layout-head(native-value!)
snapshot-value = head
text-layout-live += 1
text-layout-created += 1
//graphics.text.layouts-created ++
if head.is-truncated
    //graphics.text.truncated-layouts ++
else
    //graphics.text.natural-layouts ++
if text-layout-live > text-layout-high-water
    //graphics.text.layouts-high-water += (text-layout-live - text-layout-high-water) as U64
    text-layout-high-water = text-layout-live

────────────────────
_ do native-index I64
    - offset Size

. bytes = byte-view(request.text)
. end = min(offset, bytes.size)
. units Size = 0
. index Size = 0
. next Index = 0
while true
    if next < objects.length && objects[next].offset <= index && counts-object
        units += objects[next].units
        next += 1
    else if index < end
        . width = text-utf8-width(bytes[index])
        units += if width == 4 then 2 else 1
        index += width
    else
        break
    .. counts-object = index < end || objects[next].is-trailing
= units

────────────────────
_ do text-offset Size
    - units Size

. bytes = byte-view(request.text)
. seen Size = 0
. index Size = 0
. next Index = 0
while seen < units
    if next < objects.length && objects[next].offset <= index
        seen += objects[next].units
        next += 1
    else if index < bytes.size
        . width = text-utf8-width(bytes[index])
        seen += if width == 4 then 2 else 1
        index += width
    else
        break
= index

────────────────────
_ do release-native

. handle = native-value
=? if !handle
C:yumiGraphicsTextLayoutRelease(handle)
native-value = null
text-layout-live -= 1
text-layout-released += 1
//graphics.text.layouts-released ++

