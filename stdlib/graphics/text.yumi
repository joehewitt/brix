────────────────────
_ get may-truncate Bool

bounded-overflow && request.wrap == TextWrap.no-wrap

.. bounded-overflow = request.maximum-width != null && request.overflow != TextOverflow.clip

────────────────────
_ do get shaped TextLayoutSnapshot

. head = snapshot-value
=? head if head
shape()
if is-closed
    release-native()
= snapshot-value!

────────────────────
+ do to-path Path

?! TextLayoutRequestPanic("Cannot extract a path from a closed text layout") if is-closed

. handle = native
. count = C:yumiGraphicsTextLayoutGetPathCommandCount(handle)
. path = Path()
=? path if count == 0

. verbs = U8[count]
. coordinates = F64[count * 6]
C:yumiGraphicsTextLayoutGetPathCommands(handle, verbs, coordinates, count)
path.reserve(count, count * 6)
for index in 0 .. < count
    . offset = index * 6
    do match verbs[index]
        |= C:YuGraphicsTextPathMove
            path.move-to(coordinates[offset], coordinates[offset + 1])
        |= C:YuGraphicsTextPathLine
            path.line-to(coordinates[offset], coordinates[offset + 1])
        |= C:YuGraphicsTextPathQuadratic
            path.quadratic-curve-to
                - coordinates[offset]
                - coordinates[offset + 1]
                - coordinates[offset + 2]
                - coordinates[offset + 3]
        |= C:YuGraphicsTextPathCubic
            path.cubic-curve-to
                - Point(coordinates[offset], coordinates[offset + 1])
                - Point(coordinates[offset + 2], coordinates[offset + 3])
                - Point(coordinates[offset + 4], coordinates[offset + 5])
        |= C:YuGraphicsTextPathClose
            path.close()
= path

