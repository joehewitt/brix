+ do get snapshot TextLayoutSnapshot

//graphics.text.metric-queries ++
. head = shaped
=? head if head.lines.length > 0 || head.line-count == 0
. loaded = TextLayoutSnapshot
    - head.size
    - head.natural-width
    - head.constrained-width
    - head.line-count
