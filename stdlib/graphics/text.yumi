+ TextLayout
    is Closable

+ request TextLayoutRequest
+ line-spacing => request.line-spacing
+ width => shaped.size.width
+ height => simple-line?.height ?? shaped.size.height
+ natural-width => shaped.natural-width
+ constrained-width => shaped.constrained-width
+ line-count => if simple-line then 1 else shaped.line-count
+ ascent => simple-line?.ascent ?? snapshot.lines[0].ascent
+ descent => simple-line?.descent ?? snapshot.lines[0].descent
+ leading => simple-line?.leading ?? snapshot.lines[0].leading
+ baseline => simple-line?.ascent ?? shaped.first-baseline
+ is-truncated => if simple-line && !may-truncate then false else shaped.is-truncated
+ is-simple => simple-line != null
+ is-shaped => snapshot-value != null

_ native-value Pointer?
_ simple-line TextSimpleLine?
_ is-closed = false
_ snapshot-value TextLayoutSnapshot?
_ fragments-value [TextFragment]?
_ objects [TextLayoutObject]

────────────────────
+ This
    - source TextLayoutRequest

?! TextLayoutRequestPanic("Text maximum width and height must be finite and nonnegative")
    if !text-layout-request-is-valid(source)

request = source
. metrics = F64[4]
. simple = C:yumiGraphicsTextLayoutSimpleMetrics
    - source.text
    - source.font.family
    - source.font.size
    - source.font.weight.trait
    - source.font.slant == FontSlant.italic
    - source.maximum-width != null
    - text-truncation(source.overflow)
    - source.wrap == TextWrap.word
    - metrics
//graphics.text.fonts-created += C:yumiGraphicsTextLayoutGetLastFontCreateMissCount() as U64
if simple
    simple-line = TextSimpleLine(metrics[0], metrics[1], metrics[2], metrics[3])
    //graphics.text.simple-layouts ++
else
    shape()

────────────────────
+ This
    - segments [TextSegment]
    - font Font
    - maximum-width Length? = null
    - overflow TextOverflow = TextOverflow.clip
    - wrap TextWrap = TextWrap.word
    - spacing Length = 0
    - maximum-height Length? = null

request = TextLayoutRequest
    - "".join(each.text in segments)
    - font
    - maximum-width
    - overflow
    - wrap
    - spacing
    - maximum-height
?! TextLayoutRequestPanic("Text maximum width and height must be finite and nonnegative")
    if !text-layout-request-is-valid(request)

. builder = C:yumiGraphicsStyledTextCreate
    - font.family
    - font.size
    - font.weight.trait
    - font.slant == FontSlant.italic
?! TextLayoutRequestPanic("Unable to create styled text")
    if !builder
. offset Size = 0
for segment in segments
    append-native-segment(builder, segment)
    if segment.object != null
        objects += TextLayoutObject(offset, text-object-units(segment), segment.join-before)
    offset += segment.text.size
. created = C:yumiGraphicsStyledTextLayoutCreate
    - builder
    - maximum-width != null
    - maximum-width ?? 0
    - maximum-height != null
    - maximum-height ?? 0
    - text-truncation(overflow)
    - wrap == TextWrap.word
    - line-spacing
C:yumiGraphicsStyledTextRelease(builder)
//graphics.text.fonts-created += C:yumiGraphicsTextLayoutGetLastFontCreateMissCount() as U64
?! TextLayoutRequestPanic("Unable to create text layout")
    if !created
native-value = created
adopt-native()

