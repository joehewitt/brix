━━━━━━━━━━━━━━━━━━━━
+ do tight-text-layout TightTextLayout
    - build TextLayoutBuilder
    - precision Length
    - snap Mapper'Length'Length
    - maximum-width Length?

if maximum-width == null
    . unbounded = build(null)
    = TightTextLayout(unbounded, snap(unbounded.natural-width), null)

. cap = text-safe-span(maximum-width)
. winner = narrowest-text-layout(build, cap, precision)
. width = if cap == 0 || winner.width > cap then cap else winner.width
. stable-width = snap(width)
if stable-width <= cap && stable-width != width
    . stable = build(stable-width)
    if same-text-lines(stable, winner)
        winner.close()
        winner = stable
        width = stable-width
    else
        stable.close()
= TightTextLayout(winner, width, cap)

