(import ./color)
(import ./image)
(import ./point)
(import ./primitives)
(import /BxGraphics/BxGraphics.h)
(import /core/animatable)
(import /math)

(type + Shader
  (prop + source String)
  (prop + id U32)
  (fn-do + This _
    (param source String)
    (= (. this source) source)
    (= (. this id) (call C:brixGraphicsShaderRegister source))
  )
  (fn-do _ This _
    (param source _)
    (param id _)
  )
)

(fn-do + compiled-shader (? Shader)
  (param source String)
  (let id (call C:brixGraphicsShaderRegister source))
  (let error String (call C:brixGraphicsShaderError id))
  (return-if null (if (> (. error length) 0)))
  (return (call Shader source id))
)

(type + ShaderFilter (is Tuple)
  (implements Animatable)
  (prop + shader Shader)
  (prop + args (list F64) (= (call (of List F64))))
  (prop + images (list Image) (= (call (of List Image))))
  (prop + is-live _ (= false))
  (prop + frame-rate (? F64) (= null))
  (prop + time F64)
  (prop + arg-kinds (list ShaderArgKind))
  (prop + resolution _ (= (call Point 1 1)))
  (prop + keeps (list Rect))
  (fn-expr + image-natives (list Pointer) :get
    (in (. each canvas native) images)
  )
  (fn-do + image-scales (list F64) :get
    (let scales (call (of List F64)))
    (for (in image images)
      (+= scales (. image scale))
    )
    (return scales)
  )
  (fn-expr + motion-vector (list F64) :get
    (call shader-motion-vector args arg-kinds)
  )
  (fn-expr + motion-none-vector (list F64) :get
    (call (of List F64))
  )
  (fn-expr + with-motion-vector This
    (param vector (list F64))
    (call ShaderFilter
      (block
        (arg shader)
        (arg (call shader-moved-args args arg-kinds vector))
        (arg images)
        (arg is-live)
        (arg frame-rate)
        (arg time)
        (arg arg-kinds)
        (arg resolution)
        (arg keeps)
      )
    )
  )
  (fn-expr + moves-to Bool
    (param other This)
    (and (call shader-moves-to shader args arg-kinds (. other shader) (. other args) (. other arg-kinds)) same-images)
    (where
      (lazy same-images (== images (. other images)))
    )
  )
)

(type + ShaderMask (is Tuple)
  (implements Animatable)
  (prop + filter ShaderFilter)
  (fn-expr + motion-vector (list F64) :get
    (. filter motion-vector)
  )
  (fn-expr + motion-none-vector (list F64) :get
    (call (of List F64))
  )
  (fn-expr + with-motion-vector This
    (param vector (list F64))
    (call ShaderMask (call (. filter with-motion-vector) vector))
  )
  (fn-expr + moves-to Bool
    (param other This)
    (call (. filter moves-to) (. other filter))
  )
)

(type + ShaderBackdrop (is Tuple)
  (implements Animatable)
  (prop + filter ShaderFilter)
  (fn-expr + motion-vector (list F64) :get
    (. filter motion-vector)
  )
  (fn-expr + motion-none-vector (list F64) :get
    (call (of List F64))
  )
  (fn-expr + with-motion-vector This
    (param vector (list F64))
    (call ShaderBackdrop (call (. filter with-motion-vector) vector))
  )
  (fn-expr + moves-to Bool
    (param other This)
    (call (. filter moves-to) (. other filter))
  )
)

(type + ShaderTransition (is Tuple)
  (prop + filter ShaderFilter)
)

(type + ShaderArgKind (is U8)
  (variant number)
  (variant color)
  (variant fixed)
  (variant cycle)
)

(type + FrameCycle (is Tuple)
  (prop + active F64)
  (prop + rest F64)
  (prop + active-per-width F64)
  (fn-expr + at-width This
    (param width F64)
    (call FrameCycle (call max (+ active (* active-per-width width)) 0.000001) rest)
  )
  (fn-expr + is-resting Bool
    (param time F64)
    (>= (call fmod (call max time 0) (+ active rest)) active)
  )
  (fn-expr + next-start F64
    (param time F64)
    (* (+ (call floor (/ (call max time 0) (+ active rest))) 1) (+ active rest))
  )
)

(fn-do + shader-cycle (? FrameCycle)
  (param args (list F64))
  (param kinds (list ShaderArgKind))
  (let found (? FrameCycle) null)
  (let index 0)
  (while (<= (+ index 3) (. args length))
    (if (== (call shader-arg-kind kinds index) .cycle)
      (let cycle (call FrameCycle ([] args index) ([] args (+ index 1)) ([] args (+ index 2))))
      (return-if null (if (and found (!= found cycle))))
      (blank)
      (= found cycle)
      (+= index 3)
      (else
        (+= index 1)
      )
    )
  )
  (return found)
)

(type + ShaderFill (is Tuple)
  (implements Animatable)
  (prop + shader Shader)
  (prop + args (list F64) (= (call (of List F64))))
  (prop + is-live _ (= false))
  (prop + frame-rate (? F64) (= null))
  (prop + time F64)
  (prop + arg-kinds (list ShaderArgKind))
  (fn-expr + motion-vector (list F64) :get
    (call shader-motion-vector args arg-kinds)
  )
  (fn-expr + motion-none-vector (list F64) :get
    (call (of List F64))
  )
  (fn-expr + with-motion-vector This
    (param vector (list F64))
    (call ShaderFill shader (call shader-moved-args args arg-kinds vector) is-live frame-rate time arg-kinds)
  )
  (fn-expr + moves-to Bool
    (param other This)
    (call shader-moves-to shader args arg-kinds (. other shader) (. other args) (. other arg-kinds))
  )
)

(fn-expr _ shader-arg-kind ShaderArgKind
  (param kinds (list ShaderArgKind))
  (param index Index)
  (if-expr (< index (. kinds length)) ([] kinds index) (. ShaderArgKind number))
)

(fn-expr _ shader-color-at Bool
  (param args (list F64))
  (param kinds (list ShaderArgKind))
  (param index Index)
  (and (== (call shader-arg-kind kinds index) .color) (<= (+ index 4) (. args length)))
)

(fn-do _ shader-motion-vector (list F64)
  (param args (list F64))
  (param kinds (list ShaderArgKind))
  (let vector (call (of List F64)))
  (let index 0)
  (while (< index (. args length))
    (if (call shader-color-at args kinds index)
      (++= vector
        (scope (. (call RGBA ([] args index) ([] args (+ index 1)) ([] args (+ index 2)) alpha) motion-vector)
          (lazy alpha ([] args (+ index 3)))
        )
      )
      (+= index 4)
      (else
        (if (== (call shader-arg-kind kinds index) .number)
          (+= vector ([] args index))
        )
        (+= index 1)
      )
    )
  )
  (return vector)
)

(fn-do _ shader-moved-args (list F64)
  (param args (list F64))
  (param kinds (list ShaderArgKind))
  (param vector (list F64))
  (let moved (call (of List F64) args))
  (let index 0)
  (let cursor 0)
  (while (< index (. args length))
    (if (call shader-color-at args kinds index)
      (let color (call RGBA (list ([] vector cursor) ([] vector (+ cursor 1)) ([] vector (+ cursor 2)) ([] vector (+ cursor 3)))))
      (= ([] moved index) (. color red))
      (= ([] moved (+ index 1)) (. color green))
      (= ([] moved (+ index 2)) (. color blue))
      (= ([] moved (+ index 3)) (. color alpha))
      (+= index 4)
      (+= cursor 4)
      (else
        (if (== (call shader-arg-kind kinds index) .number)
          (= ([] moved index) ([] vector cursor))
          (+= cursor 1)
        )
        (+= index 1)
      )
    )
  )
  (return moved)
)

(fn-expr _ shader-moves-to Bool
  (param shader Shader)
  (param args (list F64))
  (param kinds (list ShaderArgKind))
  (param other-shader Shader)
  (param other-args (list F64))
  (param other-kinds (list ShaderArgKind))
  (and (== (. shader id) (. other-shader id)) (== (. args length) (. other-args length)) (== kinds other-kinds))
)

(type + Paint (is Tuple)
  (prop + shader Shader)
  (prop + args (list F64) (= (call (of List F64))))
)

(type + Brush (is Tuple)
  (prop + shader Shader)
  (prop + args (list F64) (= (call (of List F64))))
  (prop + spacing F64 (= 0.2))
  (prop + scatter F64 (= 0))
  (prop + size-jitter F64 (= 0))
  (prop + angle-jitter F64 (= 0))
  (prop + roundness F64 (= 1))
  (prop + angle (? F64) (= null))
  (prop + flow F64 (= 1))
  (prop + taper-start F64 (= 0))
  (prop + taper-end F64 (= 0))
  (prop + reveal F64 (= 1))
  (prop + seed F64 (= 0))
)

(fn-do + append-brush-arguments _
  (param brush Brush)
  (param values (list F64))
  (+= values (. brush spacing))
  (+= values (. brush scatter))
  (+= values (. brush size-jitter))
  (+= values (. brush angle-jitter))
  (+= values (. brush roundness))
  (+= values (?? (. brush angle) 0))
  (+= values (if-expr (!= (. brush angle) null) 1.0 0.0))
  (+= values (. brush flow))
  (+= values (. brush taper-start))
  (+= values (. brush taper-end))
  (+= values (. brush reveal))
  (+= values (. brush seed))
  (for (in arg (. brush args))
    (+= values arg)
  )
)
