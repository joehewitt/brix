
/core/animatable
/core/patterns
/math
/unistd.h
/units

+ transparent = RGB(0, 0, 0, 0)
+ black = RGB(0, 0, 0)
+ white = RGB(100%, 100%, 100%)
+ red = RGB(100%, 0, 0)
+ blue = RGB(0, 0, 100%)
+ green = RGB(0, 100%, 0)
+ yellow = RGB(100%, 100%, 0)
+ cyan = RGB(0, 100%, 100%)

━━━━━━━━━━━━━━━━━━━━
+ pack-rgba8 U32
    - color RGBA

red /or/ (green /lshift/ 8) /or/ (blue /lshift/ 16) /or/ (alpha /lshift/ 24)

.. red = color-channel-byte(color.red) as U32
.. green = color-channel-byte(color.green) as U32
.. blue = color-channel-byte(color.blue) as U32
.. alpha = color-channel-byte(color.alpha) as U32

━━━━━━━━━━━━━━━━━━━━
+ rgba8 RGBA
    - packed U32

RGBA(red, green, blue, alpha)

.. red = ((packed /and/ 255) as F64) / 255
.. green = (((packed /rshift/ 8) /and/ 255) as F64) / 255
.. blue = (((packed /rshift/ 16) /and/ 255) as F64) / 255
.. alpha = (((packed /rshift/ 24) /and/ 255) as F64) / 255

━━━━━━━━━━━━━━━━━━━━
+ color-channel-byte U8
    - channel F64

round(max(0, min(1, channel)) * 255) as U8

━━━━━━━━━━━━━━━━━━━━
_ hex-byte ~ Char

~ [0-9a-fA-F]{2}
    (Hex(it) as U8) / 255.0

━━━━━━━━━━━━━━━━━━━━
_ hex-nibble ~ Char

~ [0-9a-fA-F]
    (Hex(it * 2) as U8) / 255.0

━━━━━━━━━━━━━━━━━━━━
+ rgb-channel ~ Char

~ value \dec'F64 "%"
    max(0, min(1, value / 100))
~ value \dec'F64
    max(0, min(1, value / 255))

━━━━━━━━━━━━━━━━━━━━
+ alpha-channel ~ Char

~ value \dec'F64 "%"
    max(0, min(1, value / 100))
~ value \dec'F64
    max(0, min(1, value))

━━━━━━━━━━━━━━━━━━━━
_ channel-separator ~ Char

~ \ws* "," \ws*
~ \ws+

━━━━━━━━━━━━━━━━━━━━
_ alpha-separator ~ Char

~ \ws* ("," | "/") \ws*

━━━━━━━━━━━━━━━━━━━━
+ rgb-function ~ Char

~ "rgb" "a"? "(" \ws* r \rgb-channel \channel-separator g \rgb-channel \channel-separator b \rgb-channel (\alpha-separator a \alpha-channel)? \ws* ")"
    RGBAInput(RGBA(r, g, b, a ?? 1), a != null)

━━━━━━━━━━━━━━━━━━━━
+ RGBAInput is Tuple

+ color RGBA
+ has-alpha Bool

━━━━━━━━━━━━━━━━━━━━
+ RGBA (RGB) is Tuple
    is Animatable

+ red = 0%%
+ green = 0%%
+ blue = 0%%
+ alpha = 1%%

────────────────────
+ with-alpha RGBA
    - value Ratio

RGBA(red, green, blue, value)

────────────────────
+ over RGBA
    - base RGBA

|? coverage == 0
    RGBA(0, 0, 0, 0)
??
    RGBA
        - (red * alpha + base.red * beneath) / coverage
        - (green * alpha + base.green * beneath) / coverage
        - (blue * alpha + base.blue * beneath) / coverage
        - coverage

.. beneath = base.alpha * (1 - alpha)
.. coverage = alpha + beneath

────────────────────
+ This
    - vector [F64]

. weight = clamp(vector[3], 0.0, 1.0)
=? This(0, 0, 0, 0) if weight <= 0
. lightness = vector[0] / weight
. green-red = vector[1] / weight
. blue-yellow = vector[2] / weight
. long = oklab-cone(lightness + 0.3963377774 * green-red + 0.2158037573 * blue-yellow)
. middle = oklab-cone(lightness - 0.1055613458 * green-red - 0.0638541728 * blue-yellow)
. short = oklab-cone(lightness - 0.0894841775 * green-red - 1.2914855480 * blue-yellow)
= This
    - linear-to-srgb(4.0767416621 * long - 3.3077115913 * middle + 0.2309699292 * short)
    - linear-to-srgb(-1.2684380046 * long + 2.6097574011 * middle - 0.3413193965 * short)
    - linear-to-srgb(-0.0041960863 * long - 0.7034186147 * middle + 1.7076147010 * short)
    - weight

────────────────────
+ This ~ Char

~ "#" r \hex-byte g \hex-byte b \hex-byte a \hex-byte? ![0-9a-zA-Z]
    This(r, g, b, a ?? 1)
~ "#" r \hex-nibble g \hex-nibble b \hex-nibble a \hex-nibble? ![0-9a-zA-Z]
    This(r, g, b, a ?? 1)
~ input \rgb-function
    input.color

────────────────────
+ from value String

match value
    ~ \ws* color This \ws* !.
        color
    ?! SyntaxError("Invalid color")

────────────────────
+ to HSVA

HSVA(h, s, v, alpha)

.. h = h1 / 6
.. s =
    |? color-max == 0
        0
    ??
        d / color-max
.. v = color-max

.. color-max = max(max(red, green), blue)
.. color-min = min(min(red, green), blue)
.. d = color-max - color-min
.. gb
    |? green < blue
        6
    ??
        0
.. h1
    |? d == 0
        0
    |? color-max == red
        (green - blue) / d + gb
    |? color-max == green
        (blue - red) / d + 2
    |? color-max == blue
        (red - green) / d + 4
    ??
        0

────────────────────
+ to String

"rgba($r, $g, $b, $a)"

.. r = red as Percent as UnitString
.. g = green as Percent as UnitString
.. b = blue as Percent as UnitString
.. a = alpha as Percent as UnitString

────────────────────
+ to Hex

"#$r$g$b"

.. r = (color-channel-byte(red) as Hex)[2 .. < 4]
.. g = (color-channel-byte(green) as Hex)[2 .. < 4]
.. b = (color-channel-byte(blue) as Hex)[2 .. < 4]

────────────────────
+ !this

alpha == 0

╌╌╌╌╌╌╌╌╌╌ is Animatable ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get motion-vector [F64]

[weight * lightness, weight * green-red, weight * blue-yellow, weight]

.. r = srgb-to-linear(red)
.. g = srgb-to-linear(green)
.. b = srgb-to-linear(blue)
.. long = cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
.. middle = cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
.. short = cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
.. weight = alpha as F64
.. lightness = 0.2104542553 * long + 0.7936177850 * middle - 0.0040720468 * short
.. green-red = 1.9779984951 * long - 2.4285922050 * middle + 0.4505937099 * short
.. blue-yellow = 0.0259040371 * long + 0.7827717662 * middle - 0.8086757660 * short

━━━━━━━━━━━━━━━━━━━━
_ srgb-to-linear F64
    - channel F64

|? channel <= 0.04045
    max(channel, 0.0) / 12.92
??
    ((channel + 0.055) / 1.055) %% 2.4

━━━━━━━━━━━━━━━━━━━━
_ linear-to-srgb F64
    - channel F64

|? channel <= 0.0031308
    max(channel, 0.0) * 12.92
??
    min(1.055 * (channel %% (1 / 2.4)) - 0.055, 1.0)

━━━━━━━━━━━━━━━━━━━━
_ oklab-cone F64
    - root F64

root * root * root

━━━━━━━━━━━━━━━━━━━━
+ HSVA (HSV) is Tuple

+ hue = 0%%
+ saturation = 0%%
+ value = 0%%
+ alpha = 1%%

────────────────────
+ to RGBA

RGBA(r, g, b, alpha)

.. r = [value, q, p, p, t, value][mod]
.. g = [t, value, value, q, p, p][mod]
.. b = [p, p, t, value, value, q][mod]

.. pair = modf(hue * 6)
.. i = pair[0]
.. f = pair[1]
.. p = value * (1 - saturation)
.. q = value * (1 - f * saturation)
.. t = value * (1 - (1 - f) * saturation)
.. mod = (i as Index) % 6

────────────────────
+ to String

"hsva($h, $s, $v, $a)"

.. h = hue as Percent as UnitString
.. s = saturation as Percent as UnitString
.. v = value as Percent as UnitString
.. a = alpha as Percent as UnitString

────────────────────
+ !this

alpha == 0
