./path
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ VectorEffect

+ enabled Bool = true

────────────────────
+ this == other VectorEffect

equals(other)

────────────────────
+ equals Bool
    - other VectorEffect

this as Pointer == other as Pointer

────────────────────
+ get combines-geometry Bool

false

────────────────────
+ apply [Path]
    - source [Path]

source

────────────────────
+ copy VectorEffect

VectorEffect()

────────────────────
+ do with-enabled VectorEffect
    - value Bool

. result = copy()
result.enabled = value
= result

━━━━━━━━━━━━━━━━━━━━
+ VectorEffects

_ vector-effects [VectorEffect]

────────────────────
+ This

────────────────────
+ This
    - effects [VectorEffect]

for effect in effects
    vector-effects += effect

────────────────────
+ do get items [VectorEffect]

for effect in vector-effects
    <= effect

────────────────────
+ get length

vector-effects.length

────────────────────
+ this == other VectorEffects

vector-effects == other.vector-effects

────────────────────
+ get combines-geometry Bool

some(vector-effects) • where each.enabled && each.combines-geometry

────────────────────
+ get has-enabled Bool

some(vector-effects) • where each.enabled

────────────────────
+ do apply [Path]
    - source [Path]

. result = source
for effect in vector-effects
    if effect.enabled
        result = effect.apply(result)
= result

────────────────────
+ do copy VectorEffects

. result [VectorEffect]
for effect in vector-effects
    result += effect.with-enabled(effect.enabled)
= VectorEffects(result)

────────────────────
+ do followed-by VectorEffects
    - outer VectorEffects

. result [VectorEffect]
for effect in vector-effects
    result += effect
for effect in outer.items
    result += effect
= VectorEffects(result)
