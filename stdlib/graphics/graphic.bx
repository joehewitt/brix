(import ./appearance)
(import ./canvas)
(import ./color)
(import ./effect)
(import ./matrix)
(import ./path)
(import ./point)
(import ./primitives)
(import ./shapes)
(import ./style)
(import ./vector-source)
(import /core/markup)
(import /core/style)
(import /stream/aggregate)
(import /units)
(blank)
(prop + graphic-change-geometry U8 (= 1))
(prop + graphic-change-appearance U8 (= 2))
(prop + graphic-change-structure U8 (= 4))
(prop + graphic-change-composite U8 (= 8))
(prop + graphic-change-metadata U8 (= 16))
(prop + graphic-change-intrinsic U8 (= 32))
(prop + graphic-change-effects U8 (= 64))
(prop + graphic-change-source U8 (= 128))
(blank)
(prop _ graphic-node-id-sequence Size (= 1))

(type + GraphicsCachePolicy (is U8)
  (variant retained-cache)
  (variant frame-cache)
  (variant no-cache)
)

(type + GraphicsCacheStamp (is Tuple)
  (prop + version Size)
  (prop + bounds Rect)
  (prop + frame Size)
  (fn-expr + reuses Bool
    (param policy GraphicsCachePolicy)
    (param cached (? GraphicsCacheStamp))
    (case? (or (not cached) (== policy (. GraphicsCachePolicy no-cache)))
      false
    )
    (default
      (and (== (. cached version) version) (== (. cached bounds) bounds) (or is-retained (== (. cached frame) frame)))
    )
    (where
      (lazy is-retained (== policy (. GraphicsCachePolicy retained-cache)))
    )
  )
)

(fn-do + vector-style-change-kinds U8
  (param mask U32)
  (return (/or/ geometry appearance composite effects))
  (blank)
  (lazy geometry (call vector-style-domain-kinds mask "vector-geometry" graphic-change-geometry))
  (lazy appearance (call vector-style-domain-kinds mask "vector-appearance" graphic-change-appearance))
  (lazy composite (call vector-style-domain-kinds mask "vector-composite" graphic-change-composite))
  (lazy effects (call vector-style-domain-kinds mask "vector-effects" graphic-change-effects))
)

(fn-expr _ vector-style-domain-kinds U8
  (param mask U32)
  (param name String)
  (param change U8)
  (if-expr (and (>= domain 0) (!= (/and/ mask (/lshift/ 1u32 (as domain Size))) 0)) change 0)
  (where
    (lazy domain (call style-domain-named name))
  )
)

(type + GraphicInvalidationListener (is (fn-type Void (param kinds U8))))

(type + GraphicPreparation (is (fn-type Void (param bounds Rect))))

(type + GraphicContainer (is Interface)
  (fn-expr + graphic-container-parent (? GraphicContainer) :get)
  (fn-expr + graphic-update-depth Size :get)
  (fn-expr + graphic-frame-version Size :get)
  (fn-expr + graphic-container-node (? GraphicNode) :get)
  (fn-expr + graphic-container-pointer Pointer :get)
  (fn-do + graphic-begin-update _)
  (fn-do + graphic-checkpoint _)
  (fn-do + graphic-end-update _)
  (fn-do + graphic-queue-change _
    (param node GraphicNode)
    (param kinds U8)
  )
  (fn-do + graphic-insert _
    (param child GraphicNode)
    (param anchor (? GraphicNode))
  )
  (fn-do + graphic-remove _
    (param child GraphicNode)
  )
  (fn-do + graphic-next-frame _)
  (fn-do + graphic-invalidate _
    (param kinds U8)
  )
)

(type + VectorNode (is Interface)
  (implements MarkupElement)
  (implements VectorGeometrySource)
  (using VectorPaintStyle)
  (using VectorCompositeStyle)
  (fn-expr + id Size :get)
  (fn-do + id _ :set (param value Size))
  (fn-expr + name String :get)
  (fn-do + name _ :set (param value String))
  (fn-expr + parent (? GraphicContainer) :get)
  (fn-expr + paths (list Path) :get)
  (fn-do + effective-cache-policy GraphicsCachePolicy :get)
  (fn-do + update _
    (param bounds Rect)
  )
)

(type + VectorElement
  (implements (of MarkupParent VectorElement))
  (prop + markup-attachment-cache (? MarkupAttachment))
  (fn-do + close _)
)

(type + GraphicNode (is VectorElement)
  (implements VectorNode)
  (implements VectorGeometrySource)
  (using VectorPaintStyle)
  (using VectorCompositeStyle)
  (prop + id Size (= (call next-graphic-node-id)))
  (prop + name String)
  (prop + parent (? GraphicContainer))
  (prop + previous (? GraphicNode))
  (prop + next (? GraphicNode))
  (prop + locked Bool)
  (prop + cache-policy GraphicsCachePolicy (= (. GraphicsCachePolicy retained-cache)))
  (blank)
  (prop _ geometry-version Size (= 1))
  (prop _ source-version Size (= 1))
  (prop _ appearance-version Size (= 1))
  (prop _ structure-version Size (= 1))
  (prop _ composite-version Size (= 1))
  (prop _ metadata-version Size (= 1))
  (prop _ output-version Size (= 1))
  (prop _ pending-kinds U8)
  (prop _ source-paths (? (list Path)))
  (prop _ source-geometry-version Size)
  (prop _ source-frame Size)
  (prop _ source-bounds Rect)
  (prop _ has-source-bounds Bool)
  (prop _ evaluation-bounds Rect)
  (prop _ preparation (? GraphicPreparation))
  (prop _ computed-paths (? (list Path)))
  (prop _ computed-output-version Size)
  (prop _ computed-frame Size)
  (prop _ computed-bounds Rect)
  (prop _ has-computed-bounds Bool)
  (fn-expr + geometry-revision _ :get
    geometry-version
  )
  (fn-expr + appearance-revision _ :get
    appearance-version
  )
  (fn-expr + structure-revision _ :get
    structure-version
  )
  (fn-expr + composite-revision _ :get
    composite-version
  )
  (fn-expr + metadata-revision _ :get
    metadata-version
  )
  (fn-expr + revision _ :get
    output-version
  )
  (fn-expr + has-pending-change Bool :get
    (!= pending-kinds 0)
  )
  (fn-do + merge-pending-change _
    (param kinds U8)
    (= pending-kinds (/or/ pending-kinds kinds))
  )
  (fn-expr + paths (list Path) :get
    (?? computed-paths (call (of List Path)))
  )
  (fn-expr + effective-cache-policy GraphicsCachePolicy :get
    (call graphic-effective-cache-policy this)
  )
  (fn-do + bounding-box _ :get
    (call update (call last-evaluation-bounds))
    (let found false)
    (let result Rect)
    (for (in path paths)
      (if (. path count)
        (= result (if-expr (not found) (. path bounding-box) (+ result (. path bounding-box))))
        (= found true)
      )
    )
    (return result)
  )
  (fn-do + copy-state-to _
    (param target GraphicNode)
    (param preserve-id Bool (= true))
    (if preserve-id
      (= (. target id) id)
    )
    (= (. target name) name)
    (= (. target locked) locked)
    (= (. target cache-policy) cache-policy)
    (call style-copy-authored-state this target)
    (if (call style-has-authored-property this "VectorCompositeStyle" "effects")
      (= (. target effects) (call (. $effects copy)))
    )
  )
  (fn-do + begin-update _
    (let root graphic-root)
    (if root
      (call (. root graphic-begin-update))
    )
  )
  (fn-do + checkpoint _
    (let root graphic-root)
    (if root
      (call (. root graphic-checkpoint))
    )
  )
  (fn-do + end-update _
    (let root graphic-root)
    (return-if (if (not root)))
    (blank)
    (call (. root graphic-end-update))
  )
  (fn-do + changed _
    (param kinds U8)
    (let root graphic-root)
    (if (not root)
      (= pending-kinds (/or/ pending-kinds kinds))
      (call apply-pending-change)
      (return)
    )
    (call (. root graphic-queue-change) this kinds)
  )
  (fn-do + graphic-root (? GraphicContainer) :get
    (let result (? GraphicContainer))
    (= result parent)
    (while (and result (. result graphic-container-parent))
      (= result (. result graphic-container-parent))
    )
    (return result)
  )
  (fn-do + apply-pending-change U8
    (let kinds pending-kinds)
    (= pending-kinds 0)
    (if (call graphic-change-includes kinds graphic-change-source)
      (+= source-version 1)
      (= source-paths null)
      (= has-source-bounds false)
    )
    (if (call graphic-change-includes kinds graphic-change-geometry)
      (+= geometry-version 1)
      (= computed-paths null)
      (= has-computed-bounds false)
    )
    (if (call graphic-change-includes kinds graphic-change-appearance)
      (+= appearance-version 1)
    )
    (if (call graphic-change-includes kinds graphic-change-structure)
      (+= structure-version 1)
      (+= geometry-version 1)
      (+= source-version 1)
      (= source-paths null)
      (= has-source-bounds false)
      (= computed-paths null)
      (= has-computed-bounds false)
    )
    (if (call graphic-change-includes kinds graphic-change-composite)
      (+= composite-version 1)
    )
    (if (call graphic-change-includes kinds graphic-change-metadata)
      (+= metadata-version 1)
    )
    (if (call graphic-change-includes kinds graphic-change-intrinsic)
      (+= metadata-version 1)
    )
    (if (call graphic-change-includes kinds graphic-change-effects)
      (= computed-paths null)
    )
    (if (/and/ kinds (/or/ output-kinds graphic-change-effects))
      (+= output-version 1)
    )
    (lazy output-kinds (/or/ content-kinds graphic-change-structure graphic-change-composite))
    (lazy content-kinds (/or/ graphic-change-source graphic-change-geometry graphic-change-appearance))
    (return kinds)
  )
  (fn-do + update _
    (param bounds Rect)
    (if preparation
      (call preparation bounds)
    )
    (let root graphic-root)
    (if (and root (. root graphic-update-depth))
      (call (. root graphic-checkpoint))
    )
    (let frame Size)
    (if root
      (= frame (. root graphic-frame-version))
    )
    (let policy effective-cache-policy)
    (let reusable (!= computed-paths null))
    (= reusable (and reusable (== computed-output-version output-version)))
    (= reusable (and reusable has-computed-bounds (== computed-bounds bounds)))
    (if (== policy .frame-cache)
      (= reusable (and reusable (== computed-frame frame)))
      (else-if (== policy .no-cache)
        (= reusable false)
      )
    )
    (return-if (if reusable))
    (blank)
    (let source-reusable (!= source-paths null))
    (= source-reusable (and source-reusable (== source-geometry-version source-version)))
    (= source-reusable (and source-reusable has-source-bounds (== source-bounds bounds)))
    (if (== policy .frame-cache)
      (= source-reusable (and source-reusable (== source-frame frame)))
      (else-if (== policy .no-cache)
        (= source-reusable false)
      )
    )
    (if (not source-reusable)
      (let result (list Path))
      (= evaluation-bounds bounds)
      (for (in path (call draw bounds))
        (+= result (call Path path))
      )
      (= source-paths result)
      (= source-geometry-version source-version)
      (= source-frame frame)
      (= source-bounds bounds)
      (= has-source-bounds true)
    )
    (= computed-paths (call apply-path-effects (?? source-paths (call (of List Path))) geometry-version frame))
    (= computed-output-version output-version)
    (= computed-frame frame)
    (= computed-bounds bounds)
    (= has-computed-bounds true)
  )
  (fn-do + draw (stream Path)
    (let empty (list Path))
    (yield-all empty)
  )
  (fn-expr + draw (stream Path)
    (param bounds Rect)
    (call draw)
  )
  (fn-expr + apply-path-effects (list Path)
    (param source (list Path))
    (param input-version Size)
    (param frame Size)
    (call (. $effects apply) source)
  )
  (fn-do + paint _
    (param canvas Canvas)
    (param inherited VectorAppearance)
    (param outer-effects (? VectorEffects) (= null))
    (return-if (if (or (not $visible) (<= $opacity 0%%))))
    (blank)
    (do-use (. canvas saved-state)
      (if (< $opacity 1%%)
        (call (. canvas begin-opacity) $opacity)
      )
      (if $transform
        (call (. canvas transform) (!! $transform))
      )
      (call paint-content canvas (call vector-appearance-over this inherited) outer-effects)
      (if (< $opacity 1%%)
        (call (. canvas end-opacity))
      )
    )
  )
  (fn-do + markup-style-domains-changed _
    (param mask U32)
    (let kinds (call vector-style-change-kinds mask))
    (if kinds
      (call changed kinds)
    )
  )
  (fn-do + paint-content _
    (param canvas Canvas)
    (param appearance VectorAppearance)
    (param outer-effects (? VectorEffects))
    (let bounds (call Rect 0 0 (. canvas width) (. canvas height)))
    (call update bounds)
    (let painted (if-expr outer-effects (call (. outer-effects apply) paths) paths))
    (call paint-appearance canvas painted appearance)
  )
  (fn-do + reset _
    (= computed-paths null)
    (= has-computed-bounds false)
    (= source-paths null)
    (= has-source-bounds false)
  )
  (fn-do + transform-paths _
    (param matrix Matrix)
    (call update (call last-evaluation-bounds))
    (for (in path paths)
      (call (. path transform) matrix)
    )
  )
  (fn-do + apply-transform _
    (param matrix Matrix)
    (call transform-paths matrix)
  )
  (fn-do + translate _
    (param offset Point)
    (call transform-paths (call matrix-from-translation offset))
  )
  (fn-do + scale _
    (param bbox-start Rect)
    (param bbox-end Rect)
    (call update (call last-evaluation-bounds))
    (for (in path paths)
      (call (. path scale) bbox-start bbox-end)
    )
  )
  (fn-do + mirror-x _
    (param cx Coord)
    (call update (call last-evaluation-bounds))
    (for (in path paths)
      (call (. path mirror-x) cx)
    )
  )
  (fn-do + mirror-y _
    (param cy Coord)
    (call update (call last-evaluation-bounds))
    (for (in path paths)
      (call (. path mirror-y) cy)
    )
  )
  (fn-do + mirror _
    (param center Point)
    (call update (call last-evaluation-bounds))
    (for (in path paths)
      (call (. path mirror) center)
    )
  )
  (fn-expr _ last-evaluation-bounds Rect
    (if-expr has-computed-bounds computed-bounds (call Rect))
  )
  (fn-do + replace _
    (param child GraphicNode)
    (param replacement GraphicNode)
    (call (. child replace) replacement)
  )
  (fn-do + replace _
    (param replacement GraphicNode)
    (let owner parent)
    (return-if (if (not owner)))
    (blank)
    (call (. owner graphic-insert) replacement this)
    (call (. owner graphic-remove) this)
  )
  (fn-do + prepare-vector-geometry-source _)
  (fn-expr + vector-geometry-source-pointer Pointer :get
    (as this Pointer)
  )
  (fn-expr + vector-geometry-source-kind U8 :get
    vector-geometry-source-graphic
  )
  (fn-expr + vector-geometry-source-fill Fill :get
    $fill
  )
  (fn-expr + vector-geometry-source-stroke Stroke :get
    $stroke
  )
  (fn-expr + vector-geometry-source-stroke-width (? Length) :get
    $stroke-width
  )
  (fn-expr + vector-geometry-source-stroke-cap (? LineCap) :get
    $stroke-cap
  )
  (fn-expr + vector-geometry-source-stroke-join (? LineJoin) :get
    $stroke-join
  )
  (fn-expr + vector-geometry-source-fill-rule (? FillRule) :get
    $fill-rule
  )
  (fn-expr + vector-geometry-source-transform (? Matrix) :get
    $transform
  )
  (fn-expr + vector-geometry-source-compact Bool :get
    (and is-plain (call vector-paint-is-compact $fill $stroke $stroke-alignment))
    (where
      (lazy is-plain (and $visible (>= $opacity 1%%) (not (. $effects length))))
    )
  )
  (fn-expr + vector-geometry-source-child-count Size :get
    0
  )
  (fn-do + vector-geometry-source-child VectorGeometrySource
    (param index Index)
    (let ignored index)
    (throw (call Panic "Graphic node has no vector geometry children"))
  )
)

(type + PathGraphic (is GraphicNode)
  (prop _ graphic-path Path)
  (fn-expr + path _ :get
    graphic-path
  )
  (fn-do + path _ :set (param value Path)
    (= graphic-path value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + This _)
  (fn-do + This _
    (param source Path)
    (= path source)
  )
  (fn-do + draw (stream Path)
    (yield path)
  )
)

(fn-expr _ graphic-change-includes Bool
  (param kinds U8)
  (param kind U8)
  (!= (/and/ kinds kind) 0)
)

(fn-expr _ graphic-effective-cache-policy GraphicsCachePolicy
  (param node GraphicNode)
  (. node cache-policy)
)

(fn-do + next-graphic-node-id Size
  (let result graphic-node-id-sequence)
  (+= graphic-node-id-sequence 1)
  (return result)
)

(fn-do + reserve-graphic-node-id _
  (param id Size)
  (if (<= graphic-node-id-sequence id)
    (= graphic-node-id-sequence (+ id 1))
  )
)

(fn-expr + vector-appearance-over VectorAppearance
  (param node VectorNode)
  (param inherited VectorAppearance)
  (call (. inherited over)
    (block
      (arg (. node $fill))
      (arg (. node $stroke))
      (arg (. node $stroke-width))
      (arg (. node $stroke-alignment))
      (arg (. node $stroke-cap))
      (arg (. node $stroke-join))
      (arg (. node $fill-rule))
    )
  )
)

(fn-do + vector-assign-stroke-layers _
  (param node VectorNode)
  (param layers (list StrokeLayer))
  (if (or (!= (. layers length) 1) (not (. ([] layers 0) visible)))
    (= (. node stroke) (as layers Stroke))
    (return)
  )
  (let layer ([] layers 0))
  (= (. node stroke) (. layer color))
  (if (. layer width)
    (= (. node stroke-width) (. layer width))
  )
  (if (. layer alignment)
    (= (. node stroke-alignment) (. layer alignment))
  )
  (if (. layer join)
    (= (. node stroke-join) (. layer join))
  )
  (if (. layer cap)
    (= (. node stroke-cap) (. layer cap))
  )
)
