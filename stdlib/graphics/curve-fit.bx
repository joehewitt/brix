(import ./point)
(import ./primitives)
(import ./vector)
(import /math)
(import /stream/sort)
(blank)
(prop _ curve-fit-depth Index (= 12))
(prop _ curve-fit-corner-angle _ (= 0.7))
(prop _ curve-fit-corner-sharpness _ (= 0.7))

(type + CurveFitter (is Tuple)
  (prop + tolerance Length)
  (prop + reach Index)
  (fn-do + fit (list PathOp)
    (param points (list Point))
    (param known (list Index))
    (param closed Bool)
    (let count (. points length))
    (let ops (call (of List PathOp)))
    (let corners (call corner-marks points known closed))
    (if (not closed)
      (let marks (call (of List Index)))
      (+= marks 0)
      (for (in corner corners)
        (if (and (> corner 0) (< corner (- count 1)))
          (+= marks corner)
        )
      )
      (+= marks (- count 1))
      (+= ops (call M (. ([] points 0) x) (. ([] points 0) y)))
      (for (in index (..< 1 (. marks length)))
        (call fit-piece points ([] marks (- index 1)) ([] marks index) false ops)
      )
      (return ops)
    )
    (let shift (if-expr corners ([] corners 0) 0))
    (let ring (call (of List Point)))
    (for (in index (..< 0 count))
      (+= ring ([] points (% (+ index shift) count)))
    )
    (+= ring ([] ring 0))
    (let marks (call (of List Index)))
    (+= marks 0)
    (if corners
      (for (in index (..< 1 (. corners length)))
        (+= marks (- ([] corners index) shift))
      )
      (else
        (+= marks (/ count 2))
      )
    )
    (+= marks count)
    (+= ops (call M (. ([] ring 0) x) (. ([] ring 0) y)))
    (for (in index (..< 1 (. marks length)))
      (call fit-piece ring ([] marks (- index 1)) ([] marks index) (not corners) ops)
    )
    (+= ops (call Z))
    (return ops)
  )
  (fn-do _ corner-marks (list Index)
    (param points (list Point))
    (param known (list Index))
    (param closed Bool)
    (let count (. points length))
    (let found (call (of List Index) known))
    (if (>= count (+ (* reach 2) 1))
      (let angles ([] F64 count))
      (for (in index (..< 0 count))
        (if (or closed (and (>= index reach) (< (+ index reach) count)))
          (= ([] angles index) (call fit-bend points index reach closed))
        )
      )
      (for (in index (..< 0 count))
        (let angle ([] angles index))
        (if (and (> angle curve-fit-corner-angle) (call is-peak angles index closed))
          (let wide-ok (or closed (and (>= index (* reach 2)) (< (+ index (* reach 2)) count))))
          (let wide
            (scope (if-expr (and wide-ok (> count (* reach 4))) wide-bend angle)
              (lazy wide-bend (call fit-bend points index (* reach 2) closed))
            )
          )
          (if (>= angle (* wide curve-fit-corner-sharpness))
            (+= found index)
          )
        )
      )
    )
    (let ordered (call sort found))
    (let marks (call (of List Index)))
    (for (in mark ordered)
      (if (or (not marks) (> mark (+ ([] marks (- (. marks length) 1)) 1)))
        (+= marks mark)
      )
    )
    (return marks)
  )
  (fn-do _ is-peak Bool
    (param angles ([] F64))
    (param index Index)
    (param closed Bool)
    (let count (. angles size))
    (let angle ([] angles index))
    (for (in offset (..< 1 (+ reach 1)))
      (let before (call polyline-index index (- (as offset Int)) count closed))
      (let after (call polyline-index index offset count closed))
      (if (or (>= ([] angles before) angle) (> ([] angles after) angle))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ fit-piece _
    (param points (list Point))
    (param first Index)
    (param last Index)
    (param smooth Bool)
    (param ops (list PathOp))
    (if (< (- last first) 2)
      (+= ops (call L (. ([] points last) x) (. ([] points last) y)))
      (return)
    )
    (if (call fit-is-straight points first last (* tolerance 0.5))
      (+= ops (call L (. ([] points last) x) (. ([] points last) y)))
      (return)
    )
    (let span (call min reach (- last first)))
    (let left
      (scope (if-expr smooth (call through points first span) first-direction)
        (lazy first-direction (call fit-direction ([] points first) ([] points (+ first span))))
      )
    )
    (let right
      (scope (if-expr smooth (* (call through points last span) -1.0) last-direction)
        (lazy last-direction (call fit-direction ([] points last) ([] points (- last span))))
      )
    )
    (call fit-span points first last left right ops 0)
  )
  (fn-expr _ through Point
    (param ring (list Point))
    (param index Index)
    (param span Index)
    (call fit-direction ([] ring (% (- (+ index count) span) count)) ([] ring (% (+ index span) count)))
    (where
      (lazy count (- (. ring length) 1))
    )
  )
  (fn-do _ fit-span _
    (param points (list Point))
    (param first Index)
    (param last Index)
    (param left Point)
    (param right Point)
    (param ops (list PathOp))
    (param level Index)
    (let start ([] points first))
    (let finish ([] points last))
    (if (< (- last first) 2)
      (let gap (/ (call (. start distance) finish) 3))
      (+= ops (call fit-segment (call FitCubic start (+ start (* left gap)) (+ finish (* right gap)) finish) tolerance))
      (return)
    )
    (let params (call fit-chord-params points first last))
    (let curve (call fit-bezier points first last params left right))
    (let worst (call fit-worst points first last curve params))
    (let limit (* tolerance tolerance))
    (if (and (> (. worst error) limit) (< (. worst error) (* limit 16)))
      (for (in attempt (..< 0 4))
        (= params (call fit-newton points first curve params))
        (= curve (call fit-bezier points first last params left right))
        (= worst (call fit-worst points first last curve params))
        (if (<= (. worst error) limit)
          (break)
        )
      )
    )
    (if (or (<= (. worst error) limit) (>= level curve-fit-depth))
      (+= ops (call fit-segment curve tolerance))
      (return)
    )
    (let split (. worst index))
    (let center (call fit-direction ([] points (+ split 1)) ([] points (- split 1))))
    (call fit-span points first split left center ops (+ level 1))
    (call fit-span points split last (* center -1.0) right ops (+ level 1))
  )
)

(fn-expr + polyline-index Index
  (param index Index)
  (param delta Int)
  (param count Size)
  (param closed Bool)
  (if-expr closed (as wrapped Index) (as clamped Index))
  (where
    (lazy moved (+ (as index Int) delta))
    (lazy total (as count Int))
    (lazy wrapped (% (+ (% moved total) total) total))
    (lazy clamped (call clamp moved 0 (- total 1)))
  )
)

(fn-expr + turn-angle F64
  (param incoming Point)
  (param outgoing Point)
  (if-expr (<= lengths 0) 0.0 (call acos (call clamp (/ (call (. incoming dot) outgoing) lengths) -1.0 1.0)))
  (where
    (lazy lengths (* (. incoming length) (. outgoing length)))
  )
)

(type _ FitMiss (is Tuple)
  (prop + error F64)
  (prop + index Index)
)

(type _ FitCubic (is Tuple)
  (prop + a Point)
  (prop + b Point)
  (prop + c Point)
  (prop + d Point)
  (fn-expr + at Point
    (param t F64)
    (+ (* a (* s s s)) (* b (* 3 s s t)) (* c (* 3 s t t)) (* d (* t t t)))
    (where
      (lazy s (- 1 t))
    )
  )
  (fn-expr + slope Point
    (param t F64)
    (+ (* (- b a) (* 3 s s)) (* (- c b) (* 6 s t)) (* (- d c) (* 3 t t)))
    (where
      (lazy s (- 1 t))
    )
  )
  (fn-expr + bend Point
    (param t F64)
    (+ (* (+ (- c (* b 2)) a) (* 6 (- 1 t))) (* (+ (- d (* c 2)) b) (* 6 t)))
  )
)

(fn-expr _ fit-bend F64
  (param points (list Point))
  (param index Index)
  (param reach Index)
  (param closed Bool)
  (call turn-angle (- point back) (- ahead point))
  (where
    (lazy count (. points length))
    (lazy point ([] points index))
    (lazy back ([] points (call polyline-index index (- (as reach Int)) count closed)))
    (lazy ahead ([] points (call polyline-index index reach count closed)))
  )
)

(fn-expr _ fit-direction Point
  (param from Point)
  (param to Point)
  (if-expr (<= length 0) (call Point 1 0) (/ along length))
  (where
    (lazy along (- to from))
    (lazy length (. along length))
  )
)

(fn-expr _ fit-off-line F64
  (param point Point)
  (param from Point)
  (param to Point)
  (if-expr (<= span 0) (call (. point distance) from) (call (. point distance) (+ from (* along t))))
  (where
    (lazy along (- to from))
    (lazy span (call (. along dot) along))
    (lazy t (call clamp (/ (call (. (- point from) dot) along) span) 0.0 1.0))
  )
)

(fn-do _ fit-is-straight Bool
  (param points (list Point))
  (param first Index)
  (param last Index)
  (param limit Length)
  (for (in index (..< (+ first 1) last))
    (if (> (call fit-off-line ([] points index) ([] points first) ([] points last)) limit)
      (return false)
    )
  )
  (return true)
)

(fn-expr _ fit-segment PathOp
  (param curve FitCubic)
  (param tolerance Length)
  (if-expr straight (call L (. curve d x) (. curve d y)) cubic)
  (where
    (lazy limit (* tolerance 0.25))
    (lazy straight (and b-on-line (< (call fit-off-line (. curve c) (. curve a) (. curve d)) limit)))
    (lazy b-on-line (< (call fit-off-line (. curve b) (. curve a) (. curve d)) limit))
    (lazy cubic (call C (. curve b x) (. curve b y) (. curve c x) (. curve c y) (. curve d x) (. curve d y)))
  )
)

(fn-do _ fit-chord-params ([] F64)
  (param points (list Point))
  (param first Index)
  (param last Index)
  (let params ([] F64 (+ (- last first) 1)))
  (for (in index (..< (+ first 1) (+ last 1)))
    (= ([] params (- index first)) (+ ([] params (- index first 1)) (call (. ([] points index) distance) ([] points (- index 1)))))
  )
  (let total ([] params (- last first)))
  (if (> total 0)
    (for (in index (..< 0 (. params size)))
      (= ([] params index) (/ ([] params index) total))
    )
  )
  (return params)
)

(fn-do _ fit-bezier FitCubic
  (param points (list Point))
  (param first Index)
  (param last Index)
  (param params ([] F64))
  (param left Point)
  (param right Point)
  (let start ([] points first))
  (let finish ([] points last))
  (let c00 0.0)
  (let c01 0.0)
  (let c11 0.0)
  (let x0 0.0)
  (let x1 0.0)
  (for (in index (..< 0 (. params size)))
    (let t ([] params index))
    (let s (- 1 t))
    (let b0 (* s s s))
    (let b1 (* 3 t s s))
    (let b2 (* 3 t t s))
    (let b3 (* t t t))
    (let a0 (* left b1))
    (let a1 (* right b2))
    (+= c00 (call (. a0 dot) a0))
    (+= c01 (call (. a0 dot) a1))
    (+= c11 (call (. a1 dot) a1))
    (let rest (- ([] points (+ first index)) (+ (* start (+ b0 b1)) (* finish (+ b2 b3)))))
    (+= x0 (call (. a0 dot) rest))
    (+= x1 (call (. a1 dot) rest))
  )
  (let det (- (* c00 c11) (* c01 c01)))
  (let gap (call (. start distance) finish))
  (let lead (if-expr (> (call abs det) 0.000000000001) (/ (- (* x0 c11) (* x1 c01)) det) 0.0))
  (let trail (if-expr (> (call abs det) 0.000000000001) (/ (- (* c00 x1) (* c01 x0)) det) 0.0))
  (if (or (< lead (* gap 0.000001)) (< trail (* gap 0.000001)) (> lead (* gap 2)) (> trail (* gap 2)))
    (= lead (/ gap 3))
    (= trail (/ gap 3))
  )
  (return (call FitCubic start (+ start (* left lead)) (+ finish (* right trail)) finish))
)

(fn-do _ fit-worst FitMiss
  (param points (list Point))
  (param first Index)
  (param last Index)
  (param curve FitCubic)
  (param params ([] F64))
  (let error 0.0)
  (let index (/ (+ first last) 2))
  (for (in offset (..< 1 (- last first)))
    (let miss (- (call (. curve at) ([] params offset)) ([] points (+ first offset))))
    (let distance (call (. miss dot) miss))
    (if (>= distance error)
      (= error distance)
      (= index (+ first offset))
    )
  )
  (return (call FitMiss error index))
)

(fn-do _ fit-newton ([] F64)
  (param points (list Point))
  (param first Index)
  (param curve FitCubic)
  (param params ([] F64))
  (let next ([] F64 (. params size)))
  (for (in index (..< 0 (. params size)))
    (let t ([] params index))
    (let miss (- (call (. curve at) t) ([] points (+ first index))))
    (let slope (call (. curve slope) t))
    (let denominator (+ (call (. slope dot) slope) (call (. miss dot) (call (. curve bend) t))))
    (= ([] next index)
      (scope (if-expr (> (call abs denominator) 0.000000000001) stepped t)
        (lazy stepped (call clamp (- t (/ (call (. miss dot) slope) denominator)) 0.0 1.0))
      )
    )
  )
  (return next)
)
