./canvas
./point
./primitives
/math

━━━━━━━━━━━━━━━━━━━━
+ SmoothRect is Tuple

+ bounds Rect
+ radius Length
+ smoothing F64 = 0.6

────────────────────
+ do outline
    - canvas Canvas

. budget = min(bounds.width, bounds.height) / 2
. r = clamp(radius, 0.0, budget)
if r <= 0
    canvas.move(bounds.left, bounds.top)
    canvas.line(bounds.right, bounds.top)
    canvas.line(bounds.right, bounds.bottom)
    canvas.line(bounds.left, bounds.bottom)
    canvas.enclose()
    =
. s = clamp(smoothing, 0.0, budget / r - 1)
. reach = (1 + s) * r
. profile = smooth-corner-profile(r, s)
canvas.move(bounds.left + reach, bounds.top)
trace-smooth-corner
    - canvas
    - Point(bounds.right, bounds.top)
    - Point(1, 0)
    - Point(0, 1)
    - reach
    - profile
trace-smooth-corner
    - canvas
    - Point(bounds.right, bounds.bottom)
    - Point(0, 1)
    - Point(-1, 0)
    - reach
    - profile
trace-smooth-corner
    - canvas
    - Point(bounds.left, bounds.bottom)
    - Point(-1, 0)
    - Point(0, -1)
    - reach
    - profile
trace-smooth-corner
    - canvas
    - Point(bounds.left, bounds.top)
    - Point(0, -1)
    - Point(1, 0)
    - reach
    - profile
canvas.enclose()

────────────────────
+ do clip
    - canvas Canvas

canvas.begin()
outline(canvas)
canvas.clip-path()

━━━━━━━━━━━━━━━━━━━━
_ smooth-corner-profile [Point]
    - r Length
    - s F64

List'Point
    * Point(a, 0)
    * Point(a + b, 0)
    * start
    * Point(start.x + handle * cos(beta), start.y + handle * sin(beta))
    * Point(finish.x - handle * sin(beta), finish.y - handle * cos(beta))
    * finish
    * Point(finish.x + d, finish.y + c)
    * Point(finish.x + d, finish.y + b + c)
    * Point(reach, reach)

.. reach = (1 + s) * r
.. arc = π / 2 * (1 - s)
.. chord = sin(arc / 2) * r * sqrt(2)
.. beta = π / 4 * s
.. c = r * tan(beta / 2) * cos(beta)
.. d = c * tan(beta)
.. b = (reach - chord - c - d) / 3
.. a = 2 * b
.. start = Point(a + b + c, d)
.. finish = Point(start.x + chord, start.y + chord)
.. handle = 4.0 / 3.0 * tan(arc / 4) * r

━━━━━━━━━━━━━━━━━━━━
_ do trace-smooth-corner
    - canvas Canvas
    - corner Point
    - along Point
    - across Point
    - reach Length
    - profile [Point]

. origin = Point(corner.x - along.x * reach, corner.y - along.y * reach)
. placed = List'Point(Point(origin.x + along.x * each.x + across.x * each.y, origin.y + along.y * each.x + across.y * each.y) in profile)
canvas.line(origin.x, origin.y)
canvas.curve(placed[0].x, placed[0].y, placed[1].x, placed[1].y, placed[2].x, placed[2].y)
canvas.curve(placed[3].x, placed[3].y, placed[4].x, placed[4].y, placed[5].x, placed[5].y)
canvas.curve(placed[6].x, placed[6].y, placed[7].x, placed[7].y, placed[8].x, placed[8].y)
