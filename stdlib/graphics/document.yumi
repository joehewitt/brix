store.nodes[row].stroke-layers = extent
. authored = store.nodes[row].paint-authored /or/ vector-document-authored-stroke
store.nodes[row].paint-authored = authored
refresh-paint(row)
maybe-compact()

────────────────────
+ do set-stroke-layers
