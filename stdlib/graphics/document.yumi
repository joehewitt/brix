    - items.length
    - VectorDocumentEffect()
for index in 0 .. < items.length
    store.effects[(extent.start as Index) + index] = effect-row(items[index])
store.nodes[row].effects = extent
. authored = store.nodes[row].composite-authored /or/ vector-document-authored-effects
store.nodes[row].composite-authored = authored
refresh-effects(row)
maybe-compact()

────────────────────
+ do edit-network VectorNetwork
    - id U64

. row = row-of(id)
?! Panic("Only network nodes hold network geometry")
    if store.nodes[row].kind != .network-node
=? network(id) if painted-regions(row)
. live = if store.nodes[row].network-pending then networks[id]!.network else network(id)
adopt-network(id, row, live)
= live

────────────────────
+ do set-network
    - id U64
    - value VectorNetwork

. row = row-of(id)
?! Panic("Only network nodes hold network geometry")
    if store.nodes[row].kind != .network-node
. fills = region-fills(id)
if fills.length
    write-region-fills(row, remapped-region-fills(id, fills, value))
    store.nodes[row].paint-stamp = paint-hash(row)
adopt-network(id, row, value)
if fills.length
    maybe-compact()

────────────────────
_ do adopt-network
    - id U64
    - row Index
    - value VectorNetwork

if !store.nodes[row].network-pending
    store.nodes[row].network-pending = true
    pending += id
network-clock += 1
keep-network
    - id
    - VectorDocumentNetwork
        - vector-document-mix(vector-document-revision-seed, network-clock)
        - value

────────────────────
_ do painted-regions Bool
    - row Index

. extent = store.nodes[row].regions
for index in 0 .. < extent.count
    . fill = store.regions[(extent.start + index) as Index]
    =? true if fill.has-fill || fill.conflict
= false

────────────────────
+ do settle

=? if !pending.length
. ids = pending
pending = List'U64()
for id in ids
    . row = vector-document-find-row(store, id)
    if row != 0 && store.nodes[row].network-pending
        write-pending(id, row)

────────────────────
_ do settle-node
    - id U64

=? if !pending.length
. row = row-of(id)
if store.nodes[row].network-pending
    write-pending(id, row)

────────────────────
_ do write-pending
    - id U64
    - row Index

. network = networks[id]!.network
write-network(row, network)
store.nodes[row].network-pending = false
refresh-geometry(row)
networks[id] = VectorDocumentNetwork(store.nodes[row].geometry-stamp, network)

────────────────────
+ do set-region-fills
    - id U64
    - value [NetworkRegionAppearance]

. row = row-of(id)
write-region-fills(row, value)
refresh-paint(row)
maybe-compact()

────────────────────
+ do set-value
    - id U64
    - key String
    - value VectorDocumentValue?

. row = row-of(id)
. index = value-index(store.nodes[row].variables, key)
if value && index && value-span(store.values[index]) == value-row-count(value)
    write-value(index, VectorDocumentKeyedValue(key, value))
    refresh-values(row)
else
    set-values(id, keyed-values(values(id), key, value))

────────────────────
_ do value-index Index?
    - extent VectorDocumentExtent
    - key String

. found Index?
. index = extent.start as Index
. last = index + (extent.count as Index)
while index < last
    . row = store.values[index] as VectorDocumentValueRow
    if row.key.text == key
        =? null if found
        found = index
    index += value-span(row)
= found

────────────────────
+ do set-values
    - id U64
    - entries [VectorDocumentKeyedValue]

. row = row-of(id)
store.nodes[row].variables = stored-values(store.nodes[row].variables, entries)
refresh-values(row)
maybe-compact()

────────────────────
+ do set-setting
    - id U64
    - key String
    - value VectorDocumentValue?

set-settings(id, keyed-values(settings(id), key, value))

────────────────────
+ do set-settings
    - id U64
    - entries [VectorDocumentKeyedValue]

. row = row-of(id)
store.nodes[row].settings = stored-values(store.nodes[row].settings, entries)
refresh-values(row)
maybe-compact()

────────────────────
_ do keyed-values
    - current [VectorDocumentKeyedValue]
    - key String
    - value VectorDocumentValue?

. entries [VectorDocumentKeyedValue]
. placed = false
for entry in current
    if entry.key != key
        entries += entry
    else if value && !placed
        entries += VectorDocumentKeyedValue(key, value)
        placed = true
if value && !placed
    entries += VectorDocumentKeyedValue(key, value)
= entries

────────────────────
_ do stored-values
    - previous VectorDocumentExtent
    - entries [VectorDocumentKeyedValue]

. count Size = 0
for entry in entries
    count += value-row-count(entry.value)
. extent = reserve-extent
    - store.values
    - previous
    - count
    - VectorDocumentValueRow()
. index = extent.start as Index
for entry in entries
    index = write-value(index, entry)
= extent

────────────────────
+ do store-effect-output
    - id U64
    - input-key U64
    - paths [Path]

. row = row-of(id)
drop-effect-output(row)
. path-start = store.output-paths.length as U32
for path in paths
    . verb-start = store.output-verbs.length as U32
    . coord-start = store.output-coords.length as U32
    . commands = path.commands
    for index in 0 .. < commands.command-count
        store.output-verbs.append(VectorDocumentPathVerb(commands.verbs[index]))
    for index in 0 .. < commands.coord-count
        store.output-coords.append(VectorDocumentPathCoord(commands.coords[index]))
    . verb-count = commands.command-count as U32
    . coord-count = commands.coord-count as U32
    store.output-paths.append
        VectorDocumentOutputPath
            - VectorDocumentExtent(verb-start, verb-count, verb-count)
            - VectorDocumentExtent(coord-start, coord-count, coord-count)
            - path.is-closed
. path-count = paths.length as U32
. output-row = store.outputs.append
    VectorDocumentEffectOutput
        - row
        - input-key
        - VectorDocumentExtent(path-start, path-count, path-count)
store.nodes[row].effect-output = output-row as U32
. garbage = store.output-garbage
if garbage > vector-document-compaction-floor && garbage * 2 > store.output-coords.length
    drop-effect-outputs()

────────────────────
+ get byte-count Size

store.byte-count + scratch.byte-count + work.active-bytes

────────────────────
+ get reclaim-limit

max(reclaim-floor, store.live-bytes * vector-document-reclaim-factor)

────────────────────
+ do reclaim-memory

. limit = reclaim-limit
=? false if store.byte-count <= limit && scratch.byte-count <= limit && work.active-bytes <= limit
compact()
. fresh = VectorDocumentStore()
fresh.copy-from(store)
store.release()
store = fresh
scratch.release()
scratch = VectorDocumentStore()
work.release()
work = Arena()
bits = work.allocate'F64(1)
remap = Table'VectorDocumentRowMap(work, 16)
reclaims += 1
= true

────────────────────
+ get chunk-count Size

store.chunks.length

────────────────────
+ do chunk-summary
    - chunk Index

settle()
= store.chunks[chunk].summary

────────────────────
+ get row-capacity Size

store.nodes.length

────────────────────
+ row-id
    - row Index

if store.nodes[row].kind != .free-node then store.nodes[row].id else 0u64

────────────────────
+ do row-stamp
    - row Index

settle()
= store.nodes[row].stamp

────────────────────
+ do compact

compact-nodes()
compact-extents()
drop-effect-outputs()

────────────────────
_ do initialize
    - root-id U64

store.nodes.append(VectorDocumentNode())
store.vertices.append(VectorDocumentVertex())
store.segments.append(VectorDocumentSegment())
store.pairs.append(VectorDocumentPair())
store.regions.append(VectorDocumentRegionFill())
store.fill-layers.append(VectorDocumentFillLayer())
store.stroke-layers.append(VectorDocumentStrokeLayer())
store.effects.append(VectorDocumentEffect())
store.values.append(VectorDocumentValueRow())
store.outputs.append(VectorDocumentEffectOutput())
store.output-paths.append(VectorDocumentOutputPath())
store.output-verbs.append(VectorDocumentPathVerb())
store.output-coords.append(VectorDocumentPathCoord())
store.nodes[0].name = blank-name
store.nodes[0].image = blank-name
store.chunks.append(VectorDocumentChunk())
reset-id-slots(16)
. root = append-node(allocate-id(root-id), VectorDocumentNodeKind.group-node, "")
store.root = root as U32
refresh-all(root)

────────────────────
_ row-of
    - id U64

vector-document-row(this, id)

────────────────────
_ find-row
    - id U64

vector-document-find-row(store, id)

────────────────────
_ do collect-store-ids
    - source VectorDocumentStore
    - row Index
    - result [U64]

result += source.nodes[row].id
. child = source.nodes[row].first-child
while child != 0
    collect-store-ids(source, child, result)
    child = source.nodes[child as Index].next-sibling

────────────────────
_ before-row
    - anchor U64

if anchor == 0 then 0 else row-of(anchor)

────────────────────
_ do allocate-id
    - requested U64

if requested == 0
    . id = store.next-id
    store.next-id += 1
    = id
?! Panic("Vector document id $requested is already in use")
    if find-row(requested) != 0
if (requested /and/ vector-document-script-id-bit) == 0 && requested >= store.next-id
    store.next-id = requested + 1
= requested

────────────────────
_ do append-node
    - id U64
    - kind VectorDocumentNodeKind
    - name String

. node = VectorDocumentNode()
node.id = id
node.kind = kind
node.name = names.store(name)
node.image = blank-name
node.opacity = 1%%
node.transform = Matrix()
. row = store.nodes.append(node)
store.live-nodes += 1
while store.chunks.length * vector-document-chunk-rows <= row
    store.chunks.append(VectorDocumentChunk())
insert-id(id, row as U32)
= row

────────────────────
_ do insert-id
    - id U64
    - row U32

if (store.live-nodes + 1) * 2 > store.id-slots.length
    reset-id-slots(store.id-slots.length * 2)
    =
place-id(id, row)

────────────────────
_ do place-id
    - id U64
    - row U32

. mask = store.id-slots.length - 1
. slot = (vector-document-mix(vector-document-seed, id) as Index) /and/ mask
while store.id-slots[slot].id != 0
    slot = (slot + 1) /and/ mask
store.id-slots[slot] = VectorDocumentIdSlot(id, row)

────────────────────
_ do remove-id
    - id U64

. mask = store.id-slots.length - 1
. slot = (vector-document-mix(vector-document-seed, id) as Index) /and/ mask
while store.id-slots[slot].id != id
    =? if store.id-slots[slot].id == 0
    slot = (slot + 1) /and/ mask
. hole = slot
. next = (slot + 1) /and/ mask
while store.id-slots[next].id != 0
    . hash = vector-document-mix(vector-document-seed, store.id-slots[next].id)
    . home = (hash as Index) /and/ mask
    . distance-next = (next - home) /and/ mask
    . distance-hole = (hole - home) /and/ mask
    if distance-hole < distance-next
        store.id-slots[hole] = store.id-slots[next] as VectorDocumentIdSlot
        hole = next
    next = (next + 1) /and/ mask
store.id-slots[hole] = VectorDocumentIdSlot()

────────────────────
_ do reset-id-slots
    - capacity Size

store.id-slots.clear()
store.id-slots.reserve(capacity)
for index in 0 .. < capacity
    store.id-slots.append(VectorDocumentIdSlot())
for row in 1 .. < store.nodes.length
    if store.nodes[row].kind != .free-node
        place-id(store.nodes[row].id, row as U32)

────────────────────
_ do link
    - row Index
    - parent-row Index
    - before-index Index

attach(row, parent-row, before-index)
refresh-stamp(parent-row)

────────────────────
_ do attach
    - row Index
    - parent-row Index
    - before-index Index

?! Panic("Only groups can hold children")
    if store.nodes[parent-row].kind != .group-node
. anchor = before-index as U32
?! Panic("The insertion anchor is not a child of the parent")
    if anchor != 0 && (store.nodes[before-index].parent as Index) != parent-row
structure-revision += 1
store.nodes[row].parent = parent-row as U32
if anchor == 0
    . last = store.nodes[parent-row].last-child
    store.nodes[row].prev-sibling = last
    store.nodes[row].next-sibling = 0
    if last != 0
        store.nodes[last as Index].next-sibling = row as U32
    else
        store.nodes[parent-row].first-child = row as U32
    store.nodes[parent-row].last-child = row as U32
else
    . previous = store.nodes[before-index].prev-sibling
    store.nodes[row].prev-sibling = previous
    store.nodes[row].next-sibling = anchor
    store.nodes[before-index].prev-sibling = row as U32
    if previous != 0
        store.nodes[previous as Index].next-sibling = row as U32
    else
        store.nodes[parent-row].first-child = row as U32

────────────────────
_ do unlink
    - row Index

. parent-row = store.nodes[row].parent as Index
=? if parent-row == 0
structure-revision += 1
. previous = store.nodes[row].prev-sibling
. next = store.nodes[row].next-sibling
if previous != 0
    store.nodes[previous as Index].next-sibling = next
else
    store.nodes[parent-row].first-child = next
if next != 0
    store.nodes[next as Index].prev-sibling = previous
else
    store.nodes[parent-row].last-child = previous
store.nodes[row].parent = 0
store.nodes[row].prev-sibling = 0
store.nodes[row].next-sibling = 0
refresh-stamp(parent-row)

────────────────────
_ do is-ancestor
    - ancestor Index
    - row Index

. cursor = row
while cursor != 0
    =? true if cursor == ancestor
    cursor = store.nodes[cursor].parent
= false

────────────────────
_ do subtree-hash U64
    - row Index

. result = store.nodes[row].stamp
. child = store.nodes[row].first-child
while child != 0
    result = vector-document-mix(result, subtree-hash(child))
    child = store.nodes[child as Index].next-sibling
= result

────────────────────
_ do free-subtree
    - row Index

. child = store.nodes[row].first-child
while child != 0
    . next = store.nodes[child as Index].next-sibling
    free-subtree(child)
    child = next
. node = store.nodes[row]
release-extent(node.vertices)
release-extent(node.segments)
release-extent(node.pairs)
release-extent(node.regions)
release-extent(node.fill-layers)
release-extent(node.stroke-layers)
release-extent(node.effects)
release-extent(node.settings)
release-extent(node.variables)
drop-effect-output(row)
if node.network-pending
    -= networks[node.id]
remove-id(node.id)
set-chunk-entry(row, node.id, node.stamp, 0, 0)
. blank = VectorDocumentNode()
blank.name = blank-name
blank.image = blank-name
store.nodes[row] = blank
store.live-nodes -= 1
store.node-garbage += 1

────────────────────
_ do set-flag
    - id U64
    - flag U8
    - value Bool

. row = row-of(id)
. flags = store.nodes[row].flags
store.nodes[row].flags = if value then flags /or/ flag else flags /and/ (flag /xor/ 255)
refresh-stamp(row)

────────────────────
_ do reserve-extent'Row VectorDocumentExtent
    - table Table'Row
    - current VectorDocumentExtent
    - count Size
    - blank Row

if count <= current.capacity
    = VectorDocumentExtent(current.start, count as U32, current.capacity)
release-extent(current)
. capacity = vector-document-minimum-capacity
while capacity < count
    capacity *= 2
. start = table.length as U32
for index in 0 .. < capacity
    table.append(blank)
= VectorDocumentExtent(start, count as U32, capacity)

────────────────────
_ do release-extent
    - extent VectorDocumentExtent

store.extent-garbage += extent.capacity as Size

────────────────────
_ do write-network
    - row Index
    - network VectorNetwork

. vertex-count = network.vertex-count
. segment-count = network.segment-count
. pair-count = network.pair-count
. vertices = reserve-extent
    - store.vertices
    - store.nodes[row].vertices
    - vertex-count
    - VectorDocumentVertex()
for index in 0 .. < vertex-count
    . vertex = network.vertex-at(index)
    store.vertices[(vertices.start as Index) + index] = VectorDocumentVertex
        - vertex.id as U64
        - vertex.position
. segments = reserve-extent
    - store.segments
    - store.nodes[row].segments
    - segment-count
    - VectorDocumentSegment()
for index in 0 .. < segment-count
    . segment = network.segment-at(index)
    store.segments[(segments.start as Index) + index] = VectorDocumentSegment
        - segment.id as U64
        - segment.start as U64
        - segment.end as U64
        - segment.tangent-start
        - segment.tangent-end
        - segment.source as U64
        - segment.source-start
        - segment.source-end
. pairs = reserve-extent
    - store.pairs
    - store.nodes[row].pairs
    - pair-count
    - VectorDocumentPair()
for index in 0 .. < pair-count
    . pair = network.pair-at(index)
    store.pairs[(pairs.start as Index) + index] = VectorDocumentPair
        - pair.first.segment as U64
        - pair.first.at-end
        - pair.second.segment as U64
        - pair.second.at-end
        - pair.mirror-length
store.nodes[row].vertices = vertices
store.nodes[row].segments = segments
store.nodes[row].pairs = pairs
store.nodes[row].next-vertex = network.next-vertex-id as U64
store.nodes[row].next-segment = network.next-segment-id as U64
store.nodes[row].geometry-bounds = Rect()
store.nodes[row].bounds-stale = vertex-count > 0

────────────────────
_ do write-region-fills
    - row Index
    - value [NetworkRegionAppearance]

. extent = reserve-extent
    - store.regions
    - store.nodes[row].regions
    - value.length
    - VectorDocumentRegionFill()
for index in 0 .. < value.length
    . fill = value[index]
    store.regions[(extent.start as Index) + index] = VectorDocumentRegionFill
        - fill.region as U64
        - fill.fill != null
        - fill.fill ?? RGBA()
        - fill.conflict
store.nodes[row].regions = extent

────────────────────
_ do remapped-region-fills
    - id U64
    - fills [NetworkRegionAppearance]
    - value VectorNetwork

. result [NetworkRegionAppearance]
. painted = false
for fill in fills
    if fill.fill || fill.conflict
        painted = true
=? result if !painted
. previous = NetworkRegionWorkspace().resolve(network(id))
. regions = NetworkRegionWorkspace().resolve-after(value, previous)
for index in 0 .. < regions.regions.length
    . region = regions.regions[index]
    . fill RGBA?
    . seen = false
    . conflict = false
    for predecessor in region.predecessors
        . prior = region-fill-for(fills, predecessor)
        if !seen
            fill = prior.fill
            seen = true
        else if fill != prior.fill
            conflict = true
        conflict = conflict || prior.conflict
    if conflict
        fill = null
    result += NetworkRegionAppearance(index + 1, fill, conflict)
= result

────────────────────
_ do copy-row Index
    - source VectorDocumentStore
    - source-row Index
    - ids [U64]

vector-document-settle-bounds(source, source-row)
. original = source.nodes[source-row] as VectorDocumentNode
. requested = if copy-cursor < ids.length then ids[copy-cursor] else 0u64
copy-cursor += 1
. row = append-node(allocate-id(requested), original.kind, original.name.text)
store.nodes[row].group-kind = original.group-kind
store.nodes[row].image = names.store(original.image.text)
store.nodes[row].flags = original.flags
store.nodes[row].composite-authored = original.composite-authored
store.nodes[row].opacity = original.opacity
store.nodes[row].transform = original.transform
store.nodes[row].rotation = original.rotation
store.nodes[row].pivot = original.pivot
store.nodes[row].view-box = original.view-box
store.nodes[row].geometry-bounds = original.geometry-bounds
store.nodes[row].paint-authored = original.paint-authored
store.nodes[row].fill-kind = original.fill-kind
store.nodes[row].stroke-kind = original.stroke-kind
store.nodes[row].fill-color = original.fill-color
store.nodes[row].stroke-color = original.stroke-color
store.nodes[row].stroke-width = original.stroke-width
store.nodes[row].has-stroke-width = original.has-stroke-width
store.nodes[row].stroke-alignment = original.stroke-alignment
store.nodes[row].stroke-cap = original.stroke-cap
store.nodes[row].stroke-join = original.stroke-join
store.nodes[row].fill-rule = original.fill-rule
store.nodes[row].next-vertex = original.next-vertex
store.nodes[row].next-segment = original.next-segment
store.nodes[row].effects = copy-extent
    - store.effects
    - source.effects
    - original.effects
    - VectorDocumentEffect()
store.nodes[row].fill-layers = copy-extent
    - store.fill-layers
    - source.fill-layers
    - original.fill-layers
    - VectorDocumentFillLayer()
store.nodes[row].stroke-layers = copy-extent
    - store.stroke-layers
    - source.stroke-layers
    - original.stroke-layers
    - VectorDocumentStrokeLayer()
store.nodes[row].vertices = copy-extent
    - store.vertices
    - source.vertices
    - original.vertices
    - VectorDocumentVertex()
store.nodes[row].segments = copy-extent
    - store.segments
    - source.segments
    - original.segments
    - VectorDocumentSegment()
store.nodes[row].pairs = copy-extent
    - store.pairs
    - source.pairs
    - original.pairs
    - VectorDocumentPair()
store.nodes[row].regions = copy-extent
    - store.regions
    - source.regions
    - original.regions
    - VectorDocumentRegionFill()
store.nodes[row].settings = copy-values(source, original.settings)
store.nodes[row].variables = copy-values(source, original.variables)
store.nodes[row].geometry-stamp = original.geometry-stamp
store.nodes[row].paint-stamp = original.paint-stamp
store.nodes[row].effects-stamp = original.effects-stamp
store.nodes[row].values-stamp = original.values-stamp
. child = original.first-child
while child != 0
    attach(copy-row(source, child, ids), row, 0)
    child = source.nodes[child as Index].next-sibling
refresh-stamp(row)
= row

────────────────────
_ do copy-extent'Row VectorDocumentExtent
    - target Table'Row
    - source Table'Row
    - extent VectorDocumentExtent
    - blank Row

=? VectorDocumentExtent() if extent.count == 0
. copied = reserve-extent(target, VectorDocumentExtent(), extent.count, blank)
for index in 0 .. < extent.count
    target[(copied.start + index) as Index] = source[(extent.start + index) as Index] as Row
= copied

────────────────────
_ do copy-values VectorDocumentExtent
    - source VectorDocumentStore
    - extent VectorDocumentExtent

=? VectorDocumentExtent() if extent.count == 0
. copied = reserve-extent
    - store.values
    - VectorDocumentExtent()
    - extent.count
    - VectorDocumentValueRow()
for index in 0 .. < extent.count
    . value = source.values[(extent.start + index) as Index] as VectorDocumentValueRow
    value.key = names.store(value.key.text)
    value.text = names.store(value.text.text)
    store.values[(copied.start + index) as Index] = value
= copied

────────────────────
_ do read-values [VectorDocumentKeyedValue]
    - extent VectorDocumentExtent

. result [VectorDocumentKeyedValue]
. index = extent.start as Index
. last = index + (extent.count as Index)
while index < last
    . row = store.values[index] as VectorDocumentValueRow
    result += VectorDocumentKeyedValue(row.key.text, row-value(row, index + 1))
    index += value-span(row)
= result

────────────────────
_ do row-value VectorDocumentValue
    - row VectorDocumentValueRow
    - items Index

. count = row.count as Index
do match row.kind
    |= .number-value
        = VectorDocumentValue.number(row.x)
    |= .point-value
        = VectorDocumentValue.point(Point(row.x, row.y))
    |= .color-value
        = VectorDocumentValue.color(row.color)
    |= .text-value
        = VectorDocumentValue.text(row.text.text)
    |= .node-value
        = VectorDocumentValue.node(row.id)
    |= .values-value
        . values [VectorDocumentValue]
        for offset in 0 .. < count
            values += scalar-value(store.values[items + offset])
        = VectorDocumentValue.values(values)
    ??
        . ids [U64]
        for offset in 0 .. < count
            ids += store.values[items + offset].id
        = VectorDocumentValue.nodes(ids)

────────────────────
_ value-span Index
    - row VectorDocumentValueRow

match row.kind
    |? it == .values-value || it == .nodes-value
        1 + row.count
    ??
        1

────────────────────
_ scalar-value VectorDocumentValue
    - row VectorDocumentValueRow

match row.kind
    |= .number-value
        VectorDocumentValue.number(row.x)
    |= .point-value
        VectorDocumentValue.point(Point(row.x, row.y))
    |= .color-value
        VectorDocumentValue.color(row.color)
    |= .node-value
        VectorDocumentValue.node(row.id)
    ??
        VectorDocumentValue.text(row.text.text)

────────────────────
_ do value-row-count Size
    - value VectorDocumentValue

do match value
    | .nodes(ids)
        = ids.length + 1
    | .values(items)
        = items.length + 1
    ??
        = 1

────────────────────
_ do write-value Index
    - index Index
    - entry VectorDocumentKeyedValue

. row = scalar-row(entry.value)
row.key = names.store(entry.key)
. items [U64]
. values [VectorDocumentValue]
do match? entry.value
    | .nodes(ids)
        row.kind = .nodes-value
        row.count = ids.length as U32
        items = ids
    | .values(list)
        row.kind = .values-value
        row.count = list.length as U32
        values = list
store.values[index] = row
. next = index + 1
for id in items
    . item = VectorDocumentValueRow()
    item.key = blank-name
    item.text = blank-name
    item.kind = .node-item
    item.id = id
    store.values[next] = item
    next += 1
for value in values
    store.values[next] = scalar-row(value)
    next += 1
= next

────────────────────
_ do scalar-row VectorDocumentValueRow
    - value VectorDocumentValue

. row = VectorDocumentValueRow()
row.key = blank-name
row.text = blank-name
row.kind = .text-value
do match? value
    | .number(number)
        row.kind = .number-value
        row.x = number
    | .point(point)
        row.kind = .point-value
        row.x = point.x
        row.y = point.y
    | .color(color)
        row.kind = .color-value
        row.color = color
    | .text(text)
        row.text = names.store(text)
    | .node(id)
        row.kind = .node-value
        row.id = id
= row

────────────────────
_ do effect-row
    - effect VectorEffect

. row = VectorDocumentEffect()
row.enabled = effect.enabled
do match effect
    | BooleanEffect
        row.kind = .boolean-effect
        row.mode = it.mode
    | OffsetEffect
        row.kind = .offset-effect
        row.distance = it.distance
        row.join-type = vector-document-join-type-code(it.join-type)
        row.miter-limit = it.miter-limit
    | StrokeEffect
        row.kind = .stroke-effect
        row.distance = it.width
        row.join-type = vector-document-join-type-code(it.join-type)
        row.miter-limit = it.miter-limit
        row.cap = vector-document-optional-cap(it.cap)
    ?! Panic("Vector documents store boolean, offset, and stroke effects only")
= row

────────────────────
_ do output-path
    - index Index

. stored = store.output-paths[index]
. result = Path()
. coord = stored.coords.start as Index
for offset in 0 .. < stored.verbs.count
    . verb = store.output-verbs[(stored.verbs.start as Index) + offset].verb
    do match verb
        |= .path-verb-move
            result.move-to
                Point
                    - store.output-coords[coord].value
                    - store.output-coords[coord + 1].value
            coord += 2
        |= .path-verb-line
            result.line-to
                Point
                    - store.output-coords[coord].value
                    - store.output-coords[coord + 1].value
            coord += 2
        |= .path-verb-cubic
            result.cubic-curve-to
                - store.output-coords[coord].value
                - store.output-coords[coord + 1].value
                - store.output-coords[coord + 2].value
                - store.output-coords[coord + 3].value
                - store.output-coords[coord + 4].value
                - store.output-coords[coord + 5].value
            coord += 6
        |= .path-verb-close
            result.close()
result.is-closed = stored.closed
= result

────────────────────
_ do drop-effect-output
    - row Index

. output-row = store.nodes[row].effect-output
=? if output-row == 0
. output = store.outputs[output-row as Index]
store.output-garbage += 1 + output.paths.count as Size
for index in 0 .. < output.paths.count
    . path = store.output-paths[(output.paths.start + index) as Index]
    store.output-garbage += (path.verbs.count as Size) + path.coords.count as Size
store.nodes[row].effect-output = 0

────────────────────
_ do drop-effect-outputs

for row in 1 .. < store.nodes.length
    store.nodes[row].effect-output = 0
store.outputs.truncate(1)
store.output-paths.truncate(1)
store.output-verbs.truncate(1)
store.output-coords.truncate(1)
store.output-garbage = 0

────────────────────
_ do maybe-compact

. node-total = store.nodes.length
if store.node-garbage > vector-document-compaction-floor && store.node-garbage * 2 > node-total
    compact-nodes()
. geometry-rows = store.vertices.length + store.segments.length + store.pairs.length
. paint-rows = store.regions.length + store.fill-layers.length + store.stroke-layers.length
. extent-total = geometry-rows + paint-rows + store.effects.length + store.values.length
. extent-garbage = store.extent-garbage
if extent-garbage > vector-document-compaction-floor && extent-garbage * 2 > extent-total
    compact-extents()

────────────────────
_ do compact-nodes

drop-effect-outputs()
scratch.nodes.copy-from(store.nodes)
remap.clear()
store.nodes.truncate(1)
remap.append(VectorDocumentRowMap())
for old in 1 .. < scratch.nodes.length
    if scratch.nodes[old].kind != .free-node
        . fresh = store.nodes.append(scratch.nodes[old])
        remap.append(VectorDocumentRowMap(fresh as U32))
    else
        remap.append(VectorDocumentRowMap())
for row in 1 .. < store.nodes.length
    . node = store.nodes[row]
    store.nodes[row].parent = remap[node.parent as Index].row
    store.nodes[row].first-child = remap[node.first-child as Index].row
    store.nodes[row].last-child = remap[node.last-child as Index].row
    store.nodes[row].prev-sibling = remap[node.prev-sibling as Index].row
    store.nodes[row].next-sibling = remap[node.next-sibling as Index].row
store.root = remap[store.root as Index].row
store.node-garbage = 0
reset-id-slots(store.id-slots.length)
rebuild-chunks()

────────────────────
_ do compact-extents

scratch.vertices.copy-from(store.vertices)
scratch.segments.copy-from(store.segments)
scratch.pairs.copy-from(store.pairs)
scratch.regions.copy-from(store.regions)
scratch.fill-layers.copy-from(store.fill-layers)
scratch.stroke-layers.copy-from(store.stroke-layers)
scratch.effects.copy-from(store.effects)
scratch.values.copy-from(store.values)
store.vertices.truncate(1)
store.segments.truncate(1)
store.pairs.truncate(1)
store.regions.truncate(1)
store.fill-layers.truncate(1)
store.stroke-layers.truncate(1)
store.effects.truncate(1)
store.values.truncate(1)
for row in 1 .. < store.nodes.length
    . node = store.nodes[row]
    if node.kind != .free-node
        store.nodes[row].vertices = move-extent(store.vertices, scratch.vertices, node.vertices)
        store.nodes[row].segments = move-extent(store.segments, scratch.segments, node.segments)
        store.nodes[row].pairs = move-extent(store.pairs, scratch.pairs, node.pairs)
        store.nodes[row].regions = move-extent(store.regions, scratch.regions, node.regions)
        store.nodes[row].fill-layers = move-extent
            - store.fill-layers
            - scratch.fill-layers
            - node.fill-layers
        store.nodes[row].stroke-layers = move-extent
            - store.stroke-layers
            - scratch.stroke-layers
            - node.stroke-layers
        store.nodes[row].effects = move-extent(store.effects, scratch.effects, node.effects)
        store.nodes[row].settings = move-extent(store.values, scratch.values, node.settings)
        store.nodes[row].variables = move-extent(store.values, scratch.values, node.variables)
store.extent-garbage = 0

────────────────────
_ do move-extent'Row VectorDocumentExtent
    - target Table'Row
    - source Table'Row
    - extent VectorDocumentExtent

=? VectorDocumentExtent() if extent.count == 0
. start = target.length as U32
for index in 0 .. < extent.count
    target.append(source[(extent.start + index) as Index] as Row)
= VectorDocumentExtent(start, extent.count, extent.count)

────────────────────
_ do rebuild-chunks

store.chunks.clear()
while store.chunks.length * vector-document-chunk-rows < store.nodes.length
    store.chunks.append(VectorDocumentChunk())
for row in 1 .. < store.nodes.length
    . node = store.nodes[row]
    if node.kind != .free-node
        . chunk = row / vector-document-chunk-rows
        . summary = store.chunks[chunk].summary /xor/ vector-document-mix(node.id, node.stamp)
        store.chunks[chunk].summary = summary

────────────────────
_ do set-chunk-entry
    - row Index
    - old-id U64
    - old-stamp U64
    - id U64
    - stamp U64

. chunk = row / vector-document-chunk-rows
. summary = store.chunks[chunk].summary
if old-id != 0
    summary = summary /xor/ vector-document-mix(old-id, old-stamp)
if id != 0
    summary = summary /xor/ vector-document-mix(id, stamp)
store.chunks[chunk].summary = summary

────────────────────
_ do refresh-all
    - row Index

store.nodes[row].geometry-stamp = geometry-hash(row)
store.nodes[row].paint-stamp = paint-hash(row)
store.nodes[row].effects-stamp = effects-hash(row)
store.nodes[row].values-stamp = node-values-hash(row)
refresh-stamp(row)

────────────────────
_ do refresh-values
    - row Index

store.nodes[row].values-stamp = node-values-hash(row)
refresh-stamp(row)

────────────────────
_ do refresh-geometry
    - row Index

store.nodes[row].geometry-stamp = geometry-hash(row)
refresh-stamp(row)

────────────────────
_ do refresh-paint
    - row Index

store.nodes[row].paint-stamp = paint-hash(row)
refresh-stamp(row)

────────────────────
_ do refresh-effects
    - row Index

store.nodes[row].effects-stamp = effects-hash(row)
refresh-stamp(row)

────────────────────
_ do refresh-stamp
    - row Index

. node = store.nodes[row]
. stamp = node-hash(row)
=? if stamp == node.stamp
set-chunk-entry(row, node.id, node.stamp, node.id, stamp)
store.nodes[row].stamp = stamp

────────────────────
+ do mix-number
    - hash U64
    - value F64

bits[0] = value
= vector-document-mix(hash, (bits as CPointer'U64)[0])

────────────────────
_ mix-point
    - hash U64
    - value Point

mix-number(mix-number(hash, value.x), value.y)

────────────────────
_ do mix-rect
    - hash U64
    - value Rect

. result = mix-number(hash, value.x)
result = mix-number(result, value.y)
result = mix-number(result, value.width)
= mix-number(result, value.height)

────────────────────
_ do mix-color
    - hash U64
    - value RGBA

. result = mix-number(hash, value.red)
result = mix-number(result, value.green)
result = mix-number(result, value.blue)
= mix-number(result, value.alpha)

────────────────────
_ mix-bool
    - hash U64
    - value Bool

vector-document-mix(hash, if value then 1u64 else 2u64)

────────────────────
_ do geometry-hash
    - row Index

. node = store.nodes[row]
. result = vector-document-mix(vector-document-seed, node.kind)
result = vector-document-mix(result, hash-for(node.image.text))
. vertices = node.vertices
result = vector-document-mix(result, vertices.count)
for index in vertices.start .. < vertices.start + vertices.count
    . vertex = store.vertices[index as Index]
    result = mix-point(vector-document-mix(result, vertex.id), vertex.position)
. segments = node.segments
result = vector-document-mix(result, segments.count)
for index in segments.start .. < segments.start + segments.count
    . segment = store.segments[index as Index]
    result = vector-document-mix(result, segment.id)
    result = vector-document-mix(result, segment.start)
    result = vector-document-mix(result, segment.end)
    result = mix-point(result, segment.tangent-start)
    result = mix-point(result, segment.tangent-end)
    result = vector-document-mix(result, segment.source)
    result = mix-number(result, segment.source-start)
    result = mix-number(result, segment.source-end)
. pairs = node.pairs
result = vector-document-mix(result, pairs.count)
for index in pairs.start .. < pairs.start + pairs.count
    . pair = store.pairs[index as Index]
    result = vector-document-mix(result, pair.first-segment)
    result = mix-bool(result, pair.first-at-end)
    result = vector-document-mix(result, pair.second-segment)
    result = mix-bool(result, pair.second-at-end)
    result = mix-bool(result, pair.mirror-length)
result = vector-document-mix(result, node.next-vertex)
= vector-document-mix(result, node.next-segment)

────────────────────
_ do paint-hash
    - row Index

. node = store.nodes[row]
. result = vector-document-mix(vector-document-seed, node.paint-authored)
result = vector-document-mix(result, node.fill-kind)
result = vector-document-mix(result, node.stroke-kind)
result = mix-color(result, node.fill-color)
result = mix-color(result, node.stroke-color)
. fill-layers = node.fill-layers
result = vector-document-mix(result, fill-layers.count)
for index in fill-layers.start .. < fill-layers.start + fill-layers.count
    . layer = store.fill-layers[index as Index]
    result = mix-bool(mix-color(result, layer.color), layer.visible)
. stroke-layers = node.stroke-layers
result = vector-document-mix(result, stroke-layers.count)
for index in stroke-layers.start .. < stroke-layers.start + stroke-layers.count
    . layer = store.stroke-layers[index as Index]
    result = mix-bool(mix-color(result, layer.color), layer.visible)
    result = mix-bool(mix-number(result, layer.width), layer.has-width)
    result = vector-document-mix(result, layer.alignment)
    result = vector-document-mix(result, layer.join)
    result = vector-document-mix(result, layer.cap)
result = mix-bool(mix-number(result, node.stroke-width), node.has-stroke-width)
result = vector-document-mix(result, node.stroke-alignment)
result = vector-document-mix(result, node.stroke-cap)
result = vector-document-mix(result, node.stroke-join)
result = vector-document-mix(result, node.fill-rule)
. regions = node.regions
result = vector-document-mix(result, regions.count)
for index in regions.start .. < regions.start + regions.count
    . fill = store.regions[index as Index]
    result = vector-document-mix(result, fill.region)
    result = mix-bool(mix-color(result, fill.fill), fill.has-fill)
    result = mix-bool(result, fill.conflict)
= result

────────────────────
_ do effects-hash
    - row Index

. node = store.nodes[row]
. authored = node.composite-authored /and/ vector-document-authored-effects
. result = vector-document-mix(vector-document-seed, authored)
. effects = node.effects
result = vector-document-mix(result, effects.count)
for index in effects.start .. < effects.start + effects.count
    . effect = store.effects[index as Index]
    result = vector-document-mix(result, effect.kind)
    result = mix-bool(result, effect.enabled)
    result = vector-document-mix(result, effect.mode)
    result = mix-number(result, effect.distance)
    result = vector-document-mix(result, effect.join-type)
    result = mix-number(result, effect.miter-limit)
    result = vector-document-mix(result, effect.cap)
= result

────────────────────
_ do values-hash
    - extent VectorDocumentExtent

. result = vector-document-mix(vector-document-seed, extent.count)
for index in extent.start .. < extent.start + extent.count
    . row = store.values[index as Index] as VectorDocumentValueRow
    result = vector-document-mix(result, hash-for(row.key.text))
    result = vector-document-mix(result, row.kind)
    result = mix-number(mix-number(result, row.x), row.y)
    result = mix-color(result, row.color)
    result = vector-document-mix(result, hash-for(row.text.text))
    result = vector-document-mix(vector-document-mix(result, row.id), row.count)
= result

────────────────────
_ node-values-hash
    - row Index

vector-document-mix(values-hash(node.settings), values-hash(node.variables))

.. node = store.nodes[row]

────────────────────
_ do node-hash
    - row Index

. node = store.nodes[row]
. result = vector-document-mix(vector-document-seed, node.id)
result = vector-document-mix(result, node.kind)
result = vector-document-mix(result, node.group-kind)
result = vector-document-mix(result, node.flags)
result = vector-document-mix(result, node.composite-authored)
result = vector-document-mix(result, hash-for(node.name.text))
result = mix-number(result, node.opacity)
. matrix = node.transform
result = mix-number(mix-number(mix-number(result, matrix.a), matrix.b), matrix.c)
result = mix-number(mix-number(mix-number(result, matrix.d), matrix.tx), matrix.ty)
result = mix-number(result, node.rotation)
result = mix-point(result, node.pivot)
result = mix-rect(result, node.view-box)
result = vector-document-mix(result, node.geometry-stamp)
result = vector-document-mix(result, node.paint-stamp)
result = vector-document-mix(result, node.effects-stamp)
result = vector-document-mix(result, node.values-stamp)
. child = node.first-child
while child != 0
    result = vector-document-mix(result, store.nodes[child as Index].id)
    child = store.nodes[child as Index].next-sibling
= result /or/ 1

╌╌╌╌╌╌╌╌╌╌ is Snapshottable'VectorDocumentSnapshot ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do snapshot

settle()
. result = VectorDocumentSnapshot()
result.store.copy-from(store)
= result

────────────────────
+ do snapshot-into
    - target VectorDocumentSnapshot

settle()
if target.store.byte-count > reclaim-limit
    target.store.release()
    target.store = VectorDocumentStore()
target.store.copy-from(store)

────────────────────
+ do restore
    - source VectorDocumentSnapshot

for id in pending
    -= networks[id]
pending = List'U64()
. issued = store.next-id
store.copy-from(source.store)
reserve-id(issued)
structure-revision += 1

━━━━━━━━━━━━━━━━━━━━
_ do region-fill-for
    - fills [NetworkRegionAppearance]
    - region Index

for fill in fills
    =? fill if fill.region == region
= NetworkRegionAppearance(region, null)

━━━━━━━━━━━━━━━━━━━━
_ table-bytes'Row Size
    - table Table'Row

table.length * Row.size

━━━━━━━━━━━━━━━━━━━━
_ is-identity
    - matrix Matrix

matrix.a == 1 && matrix.b == 0 && matrix.c == 0 && matrix.d == 1 && matrix.tx == 0 && matrix.ty == 0

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentChanges

+ changed [U64]
+ removed [U64]
+ scanned-chunks Size
+ scanned-rows Size

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentChangeTracker

_ summaries [U64]
_ row-ids [U64]
_ row-stamps [U64]
_ stamps Map'U64'U64

────────────────────
+ stamp-of U64?
    - id U64

stamps[id]

────────────────────
+ do scan
    - document VectorDocument

document.settle()
. result = VectorDocumentChanges()
. chunk-count = document.chunk-count
. row-capacity = document.row-capacity
. departed [U64]
for chunk in 0 .. < chunk-count
    . summary = document.chunk-summary(chunk)
    . first = chunk * vector-document-chunk-rows
    . last = min(first + vector-document-chunk-rows, row-capacity)
    if chunk < summaries.length && summaries[chunk] == summary && row-ids.length >= last
        continue
    result.scanned-chunks += 1
    for row in first .. < last
        result.scanned-rows += 1
        . id = document.row-id(row)
        . stamp = if id != 0 then document.row-stamp(row) else 0u64
        while row-ids.length <= row
            row-ids += 0
            row-stamps += 0
        . previous-id = row-ids[row]
        if previous-id != 0 && previous-id != id
            departed += previous-id
        if id != 0 && stamps[id] != stamp
            stamps[id] = stamp
            result.changed += id
        row-ids[row] = id
        row-stamps[row] = stamp
    while summaries.length <= chunk
        summaries += 0
    summaries[chunk] = summary
if row-ids.length > row-capacity
    for row in row-capacity .. < row-ids.length
        if row-ids[row] != 0
            departed += row-ids[row]
    -= row-ids[row-capacity .. < row-ids.length]
    -= row-stamps[row-capacity .. < row-stamps.length]
if summaries.length > chunk-count
    -= summaries[chunk-count .. < summaries.length]
for id in departed
    if !document.contains(id) && stamps[id] != null
        -= stamps[id]
        result.removed += id
= result

━━━━━━━━━━━━━━━━━━━━
_ vector-document-row
    - document VectorDocument
    - id U64

?! Panic("The vector document was released")
    if document.released
?! Panic("Unknown vector document id $id")
    if row == 0
row

.. row = vector-document-find-row(document.store, id)

━━━━━━━━━━━━━━━━━━━━
_ do vector-document-find-row
    - source VectorDocumentStore
    - id U64

=? 0 if id == 0
. mask = source.id-slots.length - 1
. slot = (vector-document-mix(vector-document-seed, id) as Index) /and/ mask
while true
    . entry-id = source.id-slots[slot].id
    =? 0 if entry-id == 0
    =? source.id-slots[slot].row if entry-id == id
    slot = (slot + 1) /and/ mask
= 0

━━━━━━━━━━━━━━━━━━━━
_ VectorDocumentNetwork is Tuple

+ revision U64
+ network VectorNetwork

━━━━━━━━━━━━━━━━━━━━
_ do vector-document-network VectorNetwork
    - source VectorDocumentStore
    - row Index

. node = source.nodes[row]
. vertex-list [NetworkVertex]
for index in 0 .. < node.vertices.count
    . vertex = source.vertices[(node.vertices.start + index) as Index]
    vertex-list += NetworkVertex(vertex.id as Index, vertex.position)
. segment-list [NetworkSegment]
for index in 0 .. < node.segments.count
    . segment = source.segments[(node.segments.start + index) as Index]
    segment-list += NetworkSegment
        - segment.id as Index
        - segment.start as Index
        - segment.end as Index
        - segment.tangent-start
        - segment.tangent-end
        - segment.source as Index
        - segment.source-start
        - segment.source-end
. pair-list [NetworkPair]
for index in 0 .. < node.pairs.count
    . pair = source.pairs[(node.pairs.start + index) as Index]
    pair-list += NetworkPair
        - NetworkEnd(pair.first-segment as Index, pair.first-at-end)
        - NetworkEnd(pair.second-segment as Index, pair.second-at-end)
        - pair.mirror-length
. result = VectorNetwork(vertex-list, segment-list, pair-list)
result.reserve-ids(node.next-vertex as Index, node.next-segment as Index)
= result

━━━━━━━━━━━━━━━━━━━━
_ do vector-document-settle-bounds
    - source VectorDocumentStore
    - row Index

if source.nodes[row].bounds-stale
    source.nodes[row].geometry-bounds = vector-document-network(source, row).geometry-bounds()
    source.nodes[row].bounds-stale = false

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentTraversal is Tuple
    is CursorIterable'U64'(Index, Index)

_ document VectorDocument
_ parent U64
_ recursive Bool

────────────────────
+ This
    - document
    - parent
    - recursive

╌╌╌╌╌╌╌╌╌╌ is CursorIterable ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get initial-iterator-state (Index, Index)

(document.store.nodes[row].first-child as Index, row)

.. row = vector-document-row(document, parent)

────────────────────
+ do next-iterator ((Index, Index), U64?)
    - state (Index, Index)

. row = state[0]
=? (state, null) if row == 0
. nodes = document.store.nodes
. next = if recursive then nodes[row].first-child else 0u32
if next == 0
    . ancestor = row
    while ancestor != state[1]
        next = nodes[ancestor].next-sibling
        if next != 0 || !recursive
            break
        ancestor = nodes[ancestor].parent
= ((next as Index, state[1]), nodes[row].id)
