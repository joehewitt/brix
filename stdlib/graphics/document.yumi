────────────────────
+ do row-fill
    - row Index

. node = store.nodes[row]
=? null if (node.paint-authored /and/ vector-document-authored-fill) == 0
=? Fill.inherit if node.fill-kind == .fill-inherit
=? Fill.none if node.fill-kind == .fill-none
=? Fill.stroke if node.fill-kind == .fill-from-stroke
=? node.fill-color if node.fill-kind == .fill-color
. layers [FillLayer]
. extent = node.fill-layers
for index in 0 .. < extent.count
    . layer = store.fill-layers[(extent.start + index) as Index]
    layers += FillLayer(layer.color, layer.visible)
= FillStack(layers)

────────────────────
