    - id U64

row-stroke(row-of(id))

────────────────────
+ do row-stroke
    - row Index

. node = store.nodes[row]
=? null if (node.paint-authored /and/ vector-document-authored-stroke) == 0
=? Stroke.inherit if node.stroke-kind == .stroke-inherit
=? Stroke.none if node.stroke-kind == .stroke-none
=? node.stroke-color if node.stroke-kind == .stroke-color
. layers [StrokeLayer]
. extent = node.stroke-layers
for index in 0 .. < extent.count
    . layer = store.stroke-layers[(extent.start + index) as Index]
    . width Length? = layer.width if layer.has-width
    layers += StrokeLayer
        - layer.color
        - width
        - vector-document-alignment(layer.alignment)
        - vector-document-join(layer.join)
        - vector-document-cap(layer.cap)
        - layer.visible
= StrokeStack(layers)

