+ values [VectorDocumentKeyedValue]
    - id U64

read-values(store.nodes[row-of(id)].variables)

────────────────────
+ do value VectorDocumentValue?
    - id U64
    - key String

. extent = store.nodes[row-of(id)].variables
. index = extent.start as Index
. last = index + (extent.count as Index)
while index < last
    . row = store.values[index] as VectorDocumentValueRow
    =? row-value(row, index + 1) if row.key.text == key
    index += value-span(row)
= null

