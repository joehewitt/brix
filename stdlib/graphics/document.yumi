|? (node.composite-authored /and/ vector-document-authored-transform) == 0
    null
|? is-identity(node.transform)
    null
??
    node.transform

.. node = store.nodes[row]

────────────────────
+ do world-transform
    - id U64

. result Matrix?
. row = row-of(id)
while row != 0
    . node = store.nodes[row]
    . authored = (node.composite-authored /and/ vector-document-authored-transform) != 0
    if authored && !is-identity(node.transform)
        result = if result then node.transform.concatenate(result) else node.transform
    row = node.parent
= result

