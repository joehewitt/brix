────────────────────
+ do unset-composite
    - id U64
    - mask U8

. row = row-of(id)
. node = store.nodes[row]
store.nodes[row].composite-authored = node.composite-authored /and/ (mask /xor/ 255u8)
if (mask /and/ vector-document-authored-opacity) != 0
    store.nodes[row].opacity = 1%%
if (mask /and/ vector-document-authored-visible) != 0
    store.nodes[row].flags = node.flags /and/ (vector-document-hidden /xor/ 255u8)
