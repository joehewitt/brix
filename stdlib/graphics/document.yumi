────────────────────
+ do row-effects
    - row Index

. extent = store.nodes[row].effects
. result [VectorEffect]
for index in 0 .. < extent.count
    . effect = store.effects[(extent.start + index) as Index]
    . value VectorEffect = match effect.kind
        |= .boolean-effect
            BooleanEffect(effect.mode)
        |= .stroke-effect
            StrokeEffect
                - effect.distance
                - vector-document-join-type(effect.join-type)
                - vector-document-cap(effect.cap) ?? LineCap.round
                - effect.miter-limit
        ??
            OffsetEffect
                - effect.distance
                - vector-document-join-type(effect.join-type)
                - effect.miter-limit
    value.enabled = effect.enabled
    result += value
= VectorEffects(result)

────────────────────
+ do region-fills
    - id U64

. extent = store.nodes[row-of(id)].regions
. result [NetworkRegionAppearance]
for index in 0 .. < extent.count
    . fill = store.regions[(extent.start + index) as Index]
    . color RGBA? = fill.fill if fill.has-fill
    result += NetworkRegionAppearance(fill.region as Index, color, fill.conflict)
= result

