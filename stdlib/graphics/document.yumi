if store.nodes[row].network-pending then networks[id]!.revision else store.nodes[row].geometry-stamp

.. row = row-of(id)

────────────────────
_ do network-entry VectorDocumentNetwork
    - id U64

. row = row-of(id)
. cached = networks[id]
=? cached! if store.nodes[row].network-pending
. stamp = store.nodes[row].geometry-stamp
=? cached if cached && cached.revision == stamp
. created = VectorDocumentNetwork(stamp, vector-document-network(store, row))
keep-network(id, created)
= created

────────────────────
_ do keep-network
    - id U64
    - entry VectorDocumentNetwork

if networks.length > store.live-nodes * 2 + 64
    . kept = Map'U64'VectorDocumentNetwork()
    for item in networks.items
        . row = vector-document-find-row(store, item.key)
        if row != 0
            . node = store.nodes[row]
            if node.network-pending || node.geometry-stamp == item.value.revision
                kept[item.key] = item.value
    networks = kept
networks[id] = entry

────────────────────
+ vertex-count Index
    - id U64

if is-network-pending then networks[id]!.network.vertex-count else store.nodes[row].vertices.count

.. row = row-of(id)
.. is-network-pending = store.nodes[row].network-pending

────────────────────
+ segment-count Index
    - id U64

if is-network-pending then networks[id]!.network.segment-count else store.nodes[row].segments.count

.. row = row-of(id)
.. is-network-pending = store.nodes[row].network-pending

────────────────────
+ do resolved-appearance
    - id U64
    - base VectorAppearance = VectorAppearance()

. chain [U64]
. cursor = id
while cursor != 0
    chain += cursor
    cursor = parent(cursor)
. result = base
. index = chain.length
while index > 0
    index -= 1
    . node = chain[index]
    result = result.over
        - fill(node) ?? Fill.inherit
        - stroke(node) ?? Stroke.inherit
        - stroke-width(node)
        - stroke-alignment(node)
        - stroke-cap(node)
        - stroke-join(node)
        - fill-rule(node)
= result

────────────────────
+ do effect-output
    - id U64
    - input-key U64

. output-row = store.nodes[row-of(id)].effect-output
=? null if output-row == 0
. output = store.outputs[output-row as Index]
=? null if output.input-key != input-key
. result [Path]
for index in 0 .. < output.paths.count
    result += output-path(output.paths.start + index)
= result

