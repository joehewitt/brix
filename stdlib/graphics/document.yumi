. row = row-of(id)
. layers [FillLayer]
do match value
    |= Fill.inherit
        store.nodes[row].fill-kind = .fill-inherit
    |= Fill.none
        store.nodes[row].fill-kind = .fill-none
    |= Fill.stroke
        store.nodes[row].fill-kind = .fill-from-stroke
    | color RGBA
        store.nodes[row].fill-kind = .fill-color
        store.nodes[row].fill-color = color
    | stack FillStack
