= create-network(parent, network-from-path(path), name, id)

────────────────────
+ do copy-node
    - source VectorDocument
    - id U64
    - parent U64
    - ids [U64] = List'U64()
    - anchor U64 = 0

source.settle()
. parent-row = row-of(parent)
. before-index = before-row(anchor)
copy-cursor = 0
. row = copy-row(source.store, source.row-of(id), ids)
link(row, parent-row, before-index)
maybe-compact()
= store.nodes[row].id

────────────────────
+ do restore-contents
    - source VectorDocumentSnapshot
    - id U64

. row = row-of(id)
. existing = store.nodes[row].first-child
while existing != 0
    . next = store.nodes[existing as Index].next-sibling
    free-subtree(existing)
    existing = next
store.nodes[row].first-child = 0
store.nodes[row].last-child = 0
. source-row = vector-document-find-row(source.store, id)
. variables = VectorDocumentExtent()
if source-row != 0
    . child = source.store.nodes[source-row].first-child
    while child != 0
        . ids [U64]
        collect-store-ids(source.store, child, ids)
        copy-cursor = 0
        attach(copy-row(source.store, child, ids), row, 0)
        child = source.store.nodes[child as Index].next-sibling
    variables = source.store.nodes[source-row].variables
structure-revision += 1
release-extent(store.nodes[row].variables)
store.nodes[row].variables = copy-values(source.store, variables)
refresh-values(row)
maybe-compact()

────────────────────
+ do delete
    - id U64

. row = row-of(id)
?! Panic("The document root cannot be deleted")
    if row == store.root as Index
unlink(row)
free-subtree(row)
maybe-compact()

────────────────────
+ do move
    - id U64
    - parent U64
    - anchor U64 = 0

. row = row-of(id)
. parent-row = row-of(parent)
. before-index = before-row(anchor)
?! Panic("A node cannot move into its own subtree")
    if is-ancestor(row, parent-row)
. node = store.nodes[row]
=? if (node.parent as Index) == parent-row && (node.next-sibling as Index) == before-index
=? if before-index == row
unlink(row)
link(row, parent-row, before-index)

