━━━━━━━━━━━━━━━━━━━━
+ do vector-document-mix
    - hash U64
    - value U64

. mixed = (hash /xor/ value) * 11400714819323198485
mixed = mixed /xor/ (mixed /rshift/ 32)
mixed = mixed * 15444337377436638099
= mixed /xor/ (mixed /rshift/ 29)

━━━━━━━━━━━━━━━━━━━━
+ do vector-document-loop-id U64
    - id U64
    - passes [Index]

. hash = vector-document-mix(vector-document-seed, id)
hash = vector-document-mix(hash, passes.length as U64)
for pass in passes
    hash = vector-document-mix(hash, pass as U64)
= hash /or/ vector-document-script-id-bit

