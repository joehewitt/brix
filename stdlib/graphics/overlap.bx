(import ./point)
(import ./primitives)
(import /math)
(import /stream/sort)
(blank)
(prop _ overlap-parameter-floor _ (= 0.000000001))
(prop _ overlap-side-step _ (= 0.001))

(fn-do + remove-overlap (list (list Point))
  (param rings (list (list Point)))
  (let nodes (call (of List Point)))
  (let starts (call (of List Index)))
  (let ends (call (of List Index)))
  (for (in ring rings)
    (if (>= (. ring length) 3)
      (let first (. nodes length))
      (for (in point ring)
        (+= nodes point)
      )
      (for (in index (..< 0 (. ring length)))
        (let from (+ first index))
        (let to (+ first (% (+ index 1) (. ring length))))
        (if (!= ([] nodes from) ([] nodes to))
          (+= starts from)
          (+= ends to)
        )
      )
    )
  )
  (let count (. starts length))
  (let splits (call (of List (list OverlapSplit))))
  (for (in index (..< 0 count))
    (+= splits (call (of List OverlapSplit)))
  )
  (for (in i (..< 0 count))
    (let a ([] nodes ([] starts i)))
    (let b ([] nodes ([] ends i)))
    (for (in j (..< (+ i 1) count))
      (if (and (!= ([] starts j) ([] ends i)) (!= ([] ends j) ([] starts i)) distinct-ends)
        (let c ([] nodes ([] starts j)))
        (let d ([] nodes ([] ends j)))
        (if (call overlap-boxes-meet a b c d)
          (let along (- b a))
          (let other (- d c))
          (let denominator (call (. along cross) other))
          (if (> (call abs denominator) 0)
            (let offset (- c a))
            (let t (/ (call (. offset cross) other) denominator))
            (let u (/ (call (. offset cross) along) denominator))
            (if (and (> t overlap-parameter-floor) (< t (- 1 overlap-parameter-floor)) u-inside)
              (let node (. nodes length))
              (+= nodes (+ a (* along t)))
              (+= ([] splits i) (call OverlapSplit t node))
              (+= ([] splits j) (call OverlapSplit u node))
            )
            (lazy u-inside (and (> u overlap-parameter-floor) (< u (- 1 overlap-parameter-floor))))
          )
        )
      )
      (lazy distinct-ends (and (!= ([] starts j) ([] starts i)) (!= ([] ends j) ([] ends i))))
    )
  )
  (let pieces (call (of List OverlapPiece)))
  (for (in index (..< 0 count))
    (let ordered (call sort ([] splits index) (:using (=> (a b) (if-expr (< (. a t) (. b t)) .lesser .greater)))))
    (let from ([] starts index))
    (for (in split ordered)
      (call overlap-keep pieces nodes starts ends from (. split node))
      (= from (. split node))
    )
    (call overlap-keep pieces nodes starts ends from ([] ends index))
  )
  (return (call overlap-rings pieces nodes))
)

(type _ OverlapSplit (is Tuple)
  (prop + t F64)
  (prop + node Index)
)

(type _ OverlapPiece (is Tuple)
  (prop + from Index)
  (prop + to Index)
)

(fn-do _ overlap-keep _
  (param pieces (list OverlapPiece))
  (param nodes (list Point))
  (param starts (list Index))
  (param ends (list Index))
  (param from Index)
  (param to Index)
  (let a ([] nodes from))
  (let b ([] nodes to))
  (let along (- b a))
  (let length (. along length))
  (return-if (if (<= length 0)))
  (let step (call min (* length 0.25) overlap-side-step))
  (let side (+ (call (. a midpoint) b) (* (call Point (- (. along y)) (. along x)) (/ step length))))
  (let winding (call overlap-winding nodes starts ends side))
  (if (== winding 1)
    (+= pieces (call OverlapPiece from to))
    (else-if (== winding 0)
      (+= pieces (call OverlapPiece to from))
    )
  )
)

(fn-do _ overlap-winding Int
  (param nodes (list Point))
  (param starts (list Index))
  (param ends (list Index))
  (param point Point)
  (let winding Int)
  (for (in index (..< 0 (. starts length)))
    (let a ([] nodes ([] starts index)))
    (let b ([] nodes ([] ends index)))
    (let side (call (. (- b a) cross) (- point a)))
    (if (<= (. a y) (. point y))
      (if (and (> (. b y) (. point y)) (> side 0))
        (+= winding 1)
      )
      (else-if (and (<= (. b y) (. point y)) (< side 0))
        (-= winding 1)
      )
    )
  )
  (return winding)
)

(fn-do _ overlap-rings (list (list Point))
  (param pieces (list OverlapPiece))
  (param nodes (list Point))
  (let leaving (call (of List (list Index))))
  (for (in index (..< 0 (. nodes length)))
    (+= leaving (call (of List Index)))
  )
  (for (in index (..< 0 (. pieces length)))
    (+= ([] leaving (. ([] pieces index) from)) index)
  )
  (let used ([] U8 (. pieces length)))
  (let rings (call (of List (list Point))))
  (for (in first (..< 0 (. pieces length)))
    (if (== ([] used first) 0)
      (let ring (call (of List Point)))
      (let current first)
      (let closed false)
      (while true
        (= ([] used current) 1)
        (let piece ([] pieces current))
        (+= ring ([] nodes (. piece from)))
        (let next (call overlap-next pieces nodes ([] leaving (. piece to)) used piece first))
        (if (== next (as first Int))
          (= closed true)
          (break)
        )
        (if (< next 0)
          (break)
        )
        (= current (as next Index))
      )
      (if (and closed (>= (. ring length) 3))
        (+= rings ring)
      )
    )
  )
  (return rings)
)

(fn-do _ overlap-next Int
  (param pieces (list OverlapPiece))
  (param nodes (list Point))
  (param choices (list Index))
  (param used ([] U8))
  (param arriving OverlapPiece)
  (param first Index)
  (let heading (- ([] nodes (. arriving to)) ([] nodes (. arriving from))))
  (let best -1)
  (let best-turn 0.0)
  (for (in choice choices)
    (let piece ([] pieces choice))
    (if (or (== ([] used choice) 0) (== choice first))
      (let leaving (- ([] nodes (. piece to)) ([] nodes (. piece from))))
      (let turn (call atan2 (call (. heading cross) leaving) (call (. heading dot) leaving)))
      (if (or (< best 0) (< turn best-turn))
        (= best choice)
        (= best-turn turn)
      )
    )
  )
  (return best)
)

(fn-expr _ overlap-boxes-meet Bool
  (param a Point)
  (param b Point)
  (param c Point)
  (param d Point)
  (and meets-x (>= (call max (. a y) (. b y)) (call min (. c y) (. d y))) (>= (call max (. c y) (. d y)) (call min (. a y) (. b y))))
  (where
    (lazy meets-x (and (>= (call max (. a x) (. b x)) (call min (. c x) (. d x))) (>= (call max (. c x) (. d x)) (call min (. a x) (. b x)))))
  )
)
