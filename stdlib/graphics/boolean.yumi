╌╌╌╌╌╌╌╌╌╌ is VectorEffect ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get combines-geometry

true

────────────────────
+ equals Bool
    - other VectorEffect

other is BooleanEffect && enabled == other.enabled && mode == (other as BooleanEffect).mode

────────────────────
+ do apply [Path]
    - source [Path]

. output [Path]
=? output if !source.length
. result = Path(source[0])
if source.length == 1
    if result.count
        output += result
    = output
. out = Path()
. workspace = use BooleanWorkspace()
for i in 1 .. < source.length
    . combined Path?
    if mode == .union-effect
        combined = boolean-union-reusing(out, workspace, result, source[i])
    else if mode == .subtract-effect
        combined = boolean-subtract-reusing(out, workspace, result, source[i])
    else
        combined = boolean-intersect-reusing(out, workspace, result, source[i])
    if !combined
        out.clear()
    . previous = result
    result = out
    out = previous
if result.count
    output += result
= output

