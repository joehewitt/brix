    - workspace BooleanWorkspace
    - spans [BooleanOutputSpan]
    - operation BooleanOperation
    - source
    - interior-left Bool

for span in spans
    . direction = boolean-fragment-direction(workspace, span, operation, source, interior-left)
    if direction != 0
        append-curve-span-edge-reusing(workspace, span, source, direction < 0)
        //graphics.boolean.output-spans ++

━━━━━━━━━━━━━━━━━━━━
_ do boolean-fragment-direction
    - workspace BooleanWorkspace
    - span BooleanOutputSpan
    - operation BooleanOperation
    - source
    - interior-left Bool

. curve = span.source
. t = (span.t1 + span.t2) * 0.5
. dx = boolean-class-span-dx(curve, t)
. dy = boolean-class-span-dy(curve, t)
. speed = sqrt(dx * dx + dy * dy)
if speed <= tolerance-tight
    dx = boolean-class-span-x(curve, span.t2) - boolean-class-span-x(curve, span.t1)
    dy = boolean-class-span-y(curve, span.t2) - boolean-class-span-y(curve, span.t1)
    speed = sqrt(dx * dx + dy * dy)
    =? 0 if speed <= tolerance-tight
. rx = -dy / speed
. ry = dx / speed
. own-spans = if source == 1 then workspace.class-spans1 else workspace.class-spans2
. other-spans = if source == 1 then workspace.class-spans2 else workspace.class-spans1
. other = boolean-ray-winding(other-spans, false, 0, span.sample-x, span.sample-y, rx, ry)
. other-left = other.left != 0
. other-right = other.right != 0
if other-left == other-right
    if operation == .boolean-union-operation
        =? 0 if other-left
    else if operation == .boolean-subtract-operation
        =? 0 if other-left == (source == 1)
    else
        =? 0 if !other-left
. own = boolean-ray-winding(own-spans, true, span.index, span.sample-x, span.sample-y, rx, ry)
. own-left = own.left != 0
. own-right = own.right != 0
. left = boolean-operation-contains()
    - operation
    - if source == 1 then own-left else other-left
    - if source == 1 then other-left else own-left
. right = boolean-operation-contains()
    - operation
    - if source == 1 then own-right else other-right
    - if source == 1 then other-right else own-right
=? 0 if left == right
if source == 2 && other.touches
    =? 0 if boolean-span-coincides(workspace.class-spans1, curve, span.t1, span.t2)
= if left == interior-left then 1 else -1

━━━━━━━━━━━━━━━━━━━━
_ boolean-operation-contains
    - operation BooleanOperation
    - inside1 Bool
    - inside2 Bool

|? operation == .boolean-union-operation
    inside1 || inside2
|? operation == .boolean-subtract-operation
    inside1 && !inside2
??
    inside1 && inside2

━━━━━━━━━━━━━━━━━━━━
_ do boolean-ray-winding
    - spans [BooleanClassSpan]
    - has-own Bool
    - own Index
    - px Coord
    - py Coord
    - rx Coord
    - ry Coord

. winding = BooleanRayWinding(0, 0, false)
for index in 0 .. < spans.length
    . span = spans[index]
    . is-own = has-own && index == own
    . d0 = rx * (span.y1 - py) - ry * (span.x1 - px)
    . d3 = rx * (span.y2 - py) - ry * (span.x2 - px)
    if span.type == .segment-type-line
        if (d0 > 0) != (d3 > 0)
            . s = d0 / (d0 - d3)
            . x = span.x1 + (span.x2 - span.x1) * s
            . y = span.y1 + (span.y2 - span.y1) * s
            . a = rx * (x - px) + ry * (y - py)
            winding = boolean-ray-crossing(winding, a, if d3 > d0 then 1 else -1, is-own)
        continue
    . d1 = rx * (span.hoy - py) - ry * (span.hox - px)
    . d2 = rx * (span.hiy - py) - ry * (span.hix - px)
    if d0 > 0 && d1 > 0 && d2 > 0 && d3 > 0
        continue
    if d0 <= 0 && d1 <= 0 && d2 <= 0 && d3 <= 0
        continue
    . a0 = rx * (span.x1 - px) + ry * (span.y1 - py)
    . a1 = rx * (span.hox - px) + ry * (span.hoy - py)
    . a2 = rx * (span.hix - px) + ry * (span.hiy - py)
    . a3 = rx * (span.x2 - px) + ry * (span.y2 - py)
    if max(max(a0, a1), max(a2, a3)) < -boolean-touch-distance
        continue
    . nearest = min(min(a0, a1), min(a2, a3))
    if nearest > boolean-touch-distance
        if (d0 > 0) != (d3 > 0)
            winding = boolean-ray-crossing(winding, nearest, if d3 > 0 then 1 else -1, is-own)
        continue
    . coefficients = cubic-coefficients-1d(d0, d1, d2, d3)
    . roots = cubic-roots-for-y(0, d0, d1, d2, d3, tolerance-tight)
    . first = 2.0
    . second = 2.0
    . third = 2.0
    for j in 0 .. < roots.count
        . t = polish-boolean-root(coefficients, d0, roots[j])
        if t <= boolean-endpoint-parameter || t >= 1 - boolean-endpoint-parameter
            continue
        if abs(t - first) <= boolean-endpoint-parameter
            continue
        if abs(t - second) <= boolean-endpoint-parameter
            continue
        if t < first
            third = second
            second = first
            first = t
        else if t < second
            third = second
            second = t
        else if t < third
            third = t
    . above = d0 > 0
    . boundary = 0.0
    for k in 0 .. < 4
        . next = if k == 0 then first else if k == 1 then second else if k == 2 then third else 2.0
        if next > 1
            next = 1.0
        . middle = (boundary + next) * 0.5
        . inside = cubic-evaluate-1d(coefficients.a, coefficients.b, coefficients.c, d0, middle) > 0
        if inside != above
            . a = a0
            if boundary != 0
                . x = boolean-class-span-x(span, boundary)
                . y = boolean-class-span-y(span, boundary)
                a = rx * (x - px) + ry * (y - py)
            winding = boolean-ray-crossing(winding, a, if inside then 1 else -1, is-own)
            above = inside
        boundary = next
        if next >= 1
            break
    if above != (d3 > 0)
        winding = boolean-ray-crossing(winding, a3, if d3 > 0 then 1 else -1, is-own)
if has-own
    = BooleanRayWinding(winding.left, winding.right - 1, winding.touches)
= winding

━━━━━━━━━━━━━━━━━━━━
_ boolean-ray-crossing
    - winding BooleanRayWinding
    - a Coord
    - sign Int
    - is-own Bool

|? a > boolean-touch-distance
    BooleanRayWinding(winding.left + sign, winding.right + sign, winding.touches)
|? a >= -boolean-touch-distance && !is-own
    BooleanRayWinding(winding.left, winding.right + sign, true)
??
    winding

━━━━━━━━━━━━━━━━━━━━
_ do polish-boolean-root
    - coefficients CubicCoefficients1D
    - d0 Coord
    - t PointOnCurve

. root = t
for iteration in 0 .. < 3
    . value = cubic-evaluate-1d(coefficients.a, coefficients.b, coefficients.c, d0, root)
    . slope = cubic-derivative-1d(coefficients.a, coefficients.b, coefficients.c, root)
    if abs(slope) <= tolerance-tight
        break
    . next = root - value / slope
    if abs(next - root) > 0.001
        break
    root = next
= root

━━━━━━━━━━━━━━━━━━━━
_ do boolean-span-coincides
    - spans [BooleanClassSpan]
    - curve BooleanClassSpan
    - t1 PointOnCurve
    - t2 PointOnCurve

for step in 1 .. < 4
    . t = t1 + (t2 - t1) * (step as Float) * 0.25
    . x = boolean-class-span-x(curve, t)
    . y = boolean-class-span-y(curve, t)
    =? false if !boolean-spans-touch(spans, x, y)
= true

━━━━━━━━━━━━━━━━━━━━
_ boolean-spans-touch
    - spans [BooleanClassSpan]
    - x Coord
    - y Coord

some(spans) • where boolean-span-parameter(each, x, y) >= 0

━━━━━━━━━━━━━━━━━━━━
_ do append-curve-span-edge-reusing
    - workspace BooleanWorkspace
    - span BooleanOutputSpan
    - path-number Index
    - reverse Bool

if workspace.edge-count == workspace.edges.length
    workspace.edges += BooleanSpanEdge(0, 0, 0, 0, empty-boolean-class-span(), 0, 0)
. edge = workspace.edges[workspace.edge-count]
workspace.edge-count += 1
. source = span.source
edge.source = source
edge.t1 = span.t1
edge.t2 = span.t2
edge.path-number = path-number
edge.curve-index = span.index
edge.reverse = reverse
edge.used = false
edge.closes = false
if reverse
    edge.start-x = boolean-class-span-x(source, span.t2)
    edge.start-y = boolean-class-span-y(source, span.t2)
    edge.end-x = boolean-class-span-x(source, span.t1)
    edge.end-y = boolean-class-span-y(source, span.t1)
else
    edge.start-x = boolean-class-span-x(source, span.t1)
    edge.start-y = boolean-class-span-y(source, span.t1)
    edge.end-x = boolean-class-span-x(source, span.t2)
    edge.end-y = boolean-class-span-y(source, span.t2)

━━━━━━━━━━━━━━━━━━━━
_ do build-boolean-span-path-reusing Bool
    - out Path
    - workspace BooleanWorkspace
    - strict Bool

for edge-index in 0 .. < workspace.edge-count
    . edge = workspace.edges[edge-index]
    if edge.used
        continue

    edge.used = true
    workspace.contour-edges.clear()
    workspace.contour-edges += edge
    . first-x = edge.start-x
    . first-y = edge.start-y
    . current-x = edge.end-x
    . current-y = edge.end-y
    . guard = 0
    while guard <= workspace.edge-count
        if near-span-coords(current-x, current-y, first-x, first-y)
            break
        . next = next-boolean-span-edge-reusing(workspace, current-x, current-y)
        if !next
            if strict
                workspace.contour-edges.clear()
                out.clear()
                = false
            break
        next.used = true
        workspace.contour-edges += next
        current-x = next.end-x
        current-y = next.end-y
        guard += 1
    append-boolean-contour(out, workspace.contour-edges)

workspace.contour-edges.clear()
= true

━━━━━━━━━━━━━━━━━━━━
_ do append-boolean-contour
    - out Path
    - edges [BooleanSpanEdge]

. count = edges.length
. start Index
for index in 0 .. < count
    if !boolean-edges-continue(edges[(index + count - 1) % count], edges[index])
        start = index
        break
. first = edges[start]
out.move-to(first.start-x, first.start-y)
. pending = first
for step in 1 .. < count
    . next = edges[(start + step) % count]
    if boolean-edges-continue(pending, next)
        if pending.reverse
            pending.t1 = next.t1
        else
            pending.t2 = next.t2
        pending.end-x = next.end-x
        pending.end-y = next.end-y
    else
        append-span-edge(out, pending)
        pending = next
if near-span-coords(pending.end-x, pending.end-y, first.start-x, first.start-y)
    pending.end-x = first.start-x
    pending.end-y = first.start-y
    pending.closes = true
append-span-edge(out, pending)
out.close()

━━━━━━━━━━━━━━━━━━━━
_ boolean-edges-continue
    - previous BooleanSpanEdge
    - next BooleanSpanEdge

|? previous.path-number != next.path-number
    false
|? previous.curve-index != next.curve-index
    false
|? previous.reverse != next.reverse
    false
|? previous.reverse
    next.t2 == previous.t1
??
    next.t1 == previous.t2

━━━━━━━━━━━━━━━━━━━━
_ do reset-boolean-span-edges
    - workspace BooleanWorkspace

for index in 0 .. < workspace.edge-count
    . edge = workspace.edges[index]
    edge.source = empty-boolean-class-span()
    edge.used = false
workspace.edge-count = 0

━━━━━━━━━━━━━━━━━━━━
_ do next-boolean-span-edge-reusing
    - workspace BooleanWorkspace
    - x Coord
    - y Coord

for index in 0 .. < workspace.edge-count
    . edge = workspace.edges[index]
    if !edge.used && near-span-coords(edge.start-x, edge.start-y, x, y)
        = edge

━━━━━━━━━━━━━━━━━━━━
_ do flattened-boolean-reusing
    - out Path
    - workspace BooleanWorkspace
    - path1 Path
    - path2 Path
    - operation BooleanOperation

flatten-path-reusing(workspace, workspace.flat1, path1)
flatten-path-reusing(workspace, workspace.flat2, path2)
if is-single-contour(path1) && is-single-contour(path2)
    =? if line-polygon-boolean-reusing(out, workspace, workspace.flat1, workspace.flat2, operation)
append-boolean-classifier-spans(workspace, workspace.class-spans1, workspace.flat1)
append-boolean-classifier-spans(workspace, workspace.class-spans2, workspace.flat2)
collect-curve-arrangement-intersections-reusing(workspace, workspace.flat1, workspace.flat2)
collect-contour-crossings-reusing()
    - workspace
    - workspace.self-intersections1
    - workspace.class-spans1
    - workspace.flat1
collect-contour-crossings-reusing()
    - workspace
    - workspace.self-intersections2
    - workspace.class-spans2
    - workspace.flat2
arrange-boolean-reusing(out, workspace, path1.is-clockwise, operation, false)

━━━━━━━━━━━━━━━━━━━━
_ do line-polygon-boolean-reusing
    - out Path
    - workspace BooleanWorkspace
    - path1 Path
    - path2 Path
    - operation BooleanOperation

=? false if !append-line-polygon-points-reusing(workspace.points1, path1)
=? false if !append-line-polygon-points-reusing(workspace.points2, path2)
if !polygons-have-crossings(workspace.points1, workspace.points2)
    line-polygon-no-crossing-reusing(out, workspace.points1, workspace.points2, operation)
    = true

workspace.line-edge-count = 0
append-boolean-fragments-reusing(workspace, workspace.points1, workspace.points2, operation, 1)
append-boolean-fragments-reusing(workspace, workspace.points2, workspace.points1, operation, 2)
=? true if !workspace.line-edge-count
if !build-boolean-fragment-path-reusing(out, workspace)
    out.clear()
    = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do line-polygon-no-crossing-reusing
    - out Path
    - points1 [Point]
    - points2 [Point]
    - operation BooleanOperation

. points1-inside-points2 = polygon-contains-point()
    - points2
    - boolean-polygon-boundary-sample(points1, points2)
. points2-inside-points1 = polygon-contains-point()
    - points1
    - boolean-polygon-boundary-sample(points2, points1)

if operation == .boolean-union-operation
    if points1-inside-points2
        append-boolean-points-path(out, points2)
    else if points2-inside-points1
        append-boolean-points-path(out, points1)
    else
        append-boolean-points-path(out, points1)
        append-boolean-points-path(out, points2)
else if operation == .boolean-intersect-operation || operation == .boolean-clip-operation
    if points1-inside-points2
        append-boolean-points-path(out, points1)
    else if points2-inside-points1
        append-boolean-points-path(out, points2)
else if !points1-inside-points2
    append-boolean-points-path(out, points1)
    if points2-inside-points1
        append-boolean-points-path-reverse(out, points2)

━━━━━━━━━━━━━━━━━━━━
_ do boolean-polygon-boundary-sample
    - points [Point]
    - other [Point]

for i in 0 .. < points.length
    . sample = points[i].midpoint(points[(i + 1) % points.length])
    =? sample if !polygon-boundary-contains-point(other, sample)
= points[0]

━━━━━━━━━━━━━━━━━━━━
_ do axis-rect-list-boolean-reusing
    - out Path
    - workspace BooleanWorkspace
    - path1 Path
    - path2 Path
    - operation BooleanOperation

if !append-axis-rect-subpaths-reusing(workspace.bounds1, workspace, workspace.flat1, path1)
    = false
if !append-axis-rect-subpaths-reusing(workspace.bounds2, workspace, workspace.flat2, path2)
    = false
if workspace.bounds1.length <= 1 && workspace.bounds2.length <= 1
    = false

if operation == .boolean-union-operation
    append-rects-to-path(out, workspace.bounds1)
    append-rects-to-path(out, workspace.bounds2)
else if operation == .boolean-intersect-operation || operation == .boolean-clip-operation
    for rect1 in workspace.bounds1
        for rect2 in workspace.bounds2
            . overlap = rect-intersection(rect1, rect2)
            if overlap
                append-rect-to-path(out, overlap)
else
    . pieces = workspace.rect-pieces
    . next = workspace.rect-next
    for rect in workspace.bounds1
        pieces.clear()
        pieces += rect
        for cutter in workspace.bounds2
            next.clear()
            for piece in pieces
                append-rect-subtract(next, piece, cutter)
            . swap = pieces
            pieces = next
            next = swap
        append-rects-to-path(out, pieces)

= true

━━━━━━━━━━━━━━━━━━━━
_ do append-axis-rect-subpaths-reusing Bool
    - rects [Rect]
    - workspace BooleanWorkspace
    - scratch Path
    - path Path

rects.clear()
for index in 0 .. < workspace.rect-subpaths.length
    workspace.rect-subpaths[index] = PathSubpathSpan(scratch.commands, 0, 0, 0, false)
workspace.rect-subpaths.clear()
if !path.is-closed
    = false

path.append-subpath-spans(workspace.rect-subpaths)
for span in workspace.rect-subpaths
    span.materialize(scratch)
    if !scratch.count
        continue
    . rect = axis-rect(scratch)
    if !rect
        rects.clear()
        = false
    rects += rect

= true

━━━━━━━━━━━━━━━━━━━━
_ do append-boolean-points-path
    - out Path
    - points [Point]

=? if !points
out.move-to(points[0])
for i in 1 .. < points.length
    out.line-to(points[i])
out.close()

━━━━━━━━━━━━━━━━━━━━
_ do append-boolean-points-path-reverse
    - out Path
    - points [Point]

=? if !points
out.move-to(points[0])
for i in points.length - 1 .. 1
    out.line-to(points[i])
out.close()

━━━━━━━━━━━━━━━━━━━━
_ do flatten-path-reusing
    - workspace BooleanWorkspace
    - out Path
    - path Path

out.clear()
clear-boolean-subpath-spans(workspace)
path.append-subpath-spans(workspace.subpath-spans)
. reader = path.curve-reader
for subpath in workspace.subpath-spans
    if !subpath.curve-count
        continue
    for k in 0 .. < subpath.curve-count
        if !reader.next()
            break
        if k == 0
            out.move-to(reader.x1, reader.y1)
        if reader.type == .segment-type-line
            out.line-to(reader.x2, reader.y2)
        else
            for step in 1 .. < 19
                . t = (step as Float) / 18.0
                out.line-to()
                    - cubic-point(reader.x1, reader.handle-out-x, reader.handle-in-x, reader.x2, t)
                    - cubic-point(reader.y1, reader.handle-out-y, reader.handle-in-y, reader.y2, t)
    out.close()
clear-boolean-subpath-spans(workspace)

━━━━━━━━━━━━━━━━━━━━
_ do append-line-polygon-points-reusing Bool
    - points [Point]
    - path Path

points.clear()
if !path.is-closed || path.count < 4
    = false

. span = path.commands
for i in 0 .. < span.command-count
    . verb = span.verbs[i]
    if verb == .path-verb-cubic
        points.clear()
        = false
    if verb == .path-verb-close
        continue
    if i > 0 && verb == .path-verb-move
        points.clear()
        = false
    . start = span.coord-offsets[i]
    . point = Point(span.coords[start], span.coords[start + 1])
    if points.length && near-corner(point, points[points.length - 1])
        continue
    points += point

while points.length > 1 && near-corner(points[points.length - 1], points[0])
    points.remove(points.length - 1)
if points.length < 3
    points.clear()
    = false
if !path.is-clockwise
    reverse-boolean-points(points)
= true

━━━━━━━━━━━━━━━━━━━━
_ do reverse-boolean-points
    - points [Point]

. left Index
. right = points.length - 1
while left < right
    . swap = points[left]
    points[left] = points[right]
    points[right] = swap
    left += 1
    right -= 1

━━━━━━━━━━━━━━━━━━━━
_ do append-boolean-fragments-reusing
    - workspace BooleanWorkspace
    - points [Point]
    - other-points [Point]
    - operation BooleanOperation
    - source

for i in 0 .. < points.length
    . start = points[i]
    . end = points[(i + 1) % points.length]
    prepare-edge-split-parameters(workspace.line-splits, start, end, other-points)

    for j in 1 .. < workspace.line-splits.length
        . t1 = workspace.line-splits[j - 1]
        . t2 = workspace.line-splits[j]
        if t2 - t1 < 0.00001
            continue

        . p1 = point-at-parameter(start, end, t1)
        . p2 = point-at-parameter(start, end, t2)
        if should-include-line-fragment(operation, source, points, other-points, p1, p2)
            if should-reverse-fragment(operation, source)
                append-boolean-line-edge(workspace, p2, p1)
            else
                append-boolean-line-edge(workspace, p1, p2)

━━━━━━━━━━━━━━━━━━━━
_ do prepare-edge-split-parameters
    - splits [Float]
    - start Point
    - end Point
    - other-points [Point]

splits.clear()
splits += 0.0
splits += 1.0
for i in 0 .. < other-points.length
    . other-start = other-points[i]
    . other-end = other-points[(i + 1) % other-points.length]
    . intr = segment-crossing(start, end, other-start, other-end)
    if intr
        . t = segment-parameter(intr, start, end)
        if t > 0.00001 && t < 0.99999
            splits += t
    if point-on-segment(other-start, start, end)
        . t = segment-parameter(other-start, start, end)
        if t > 0.00001 && t < 0.99999
            splits += t

for index in 1 .. < splits.length
    . item = splits[index]
    . insert = index
    while insert > 0 && item < splits[insert - 1]
        splits[insert] = splits[insert - 1]
        insert -= 1
    splits[insert] = item

. write Index
. has-last = false
. last Float
for split in splits
    if has-last && abs(split - last) < 0.00001
        continue
    splits[write] = split
    write += 1
    last = split
    has-last = true
if write < splits.length
    -= splits[write ...]

━━━━━━━━━━━━━━━━━━━━
_ do append-boolean-line-edge
    - workspace BooleanWorkspace
    - start Point
    - end Point

if workspace.line-edge-count == workspace.line-edges.length
    workspace.line-edges += BooleanEdge(Point(0, 0), Point(0, 0))
. edge = workspace.line-edges[workspace.line-edge-count]
workspace.line-edge-count += 1
edge.start = start
edge.end = end
edge.used = false

━━━━━━━━━━━━━━━━━━━━
_ do build-boolean-fragment-path-reusing Bool
    - out Path
    - workspace BooleanWorkspace

if !workspace.line-edge-count
    = false

for edge-index in 0 .. < workspace.line-edge-count
    . edge = workspace.line-edges[edge-index]
    if edge.used
        continue

    edge.used = true
    out.move-to(edge.start)
    out.line-to(edge.end)
    . first = edge.start
    . current = edge.end
    . guard = 0
    while guard <= workspace.line-edge-count
        if near-corner(current, first)
            break
        . next = next-boolean-line-edge-reusing(workspace, current)
        if !next
            out.clear()
            = false
        next.used = true
        current = if near-corner(next.end, first) then first else next.end
        out.line-to(current)
        guard += 1
    out.close()

= out.count > 0

━━━━━━━━━━━━━━━━━━━━
_ do next-boolean-line-edge-reusing
    - workspace BooleanWorkspace
    - point Point

for index in 0 .. < workspace.line-edge-count
    . edge = workspace.line-edges[index]
    if !edge.used && near-corner(edge.start, point)
        = edge

━━━━━━━━━━━━━━━━━━━━
_ do is-single-contour
    - path Path

. move-count = 0
. span = path.commands
for i in 0 .. < span.command-count
    if span.verbs[i] == .path-verb-move
        move-count += 1

= move-count == 1

━━━━━━━━━━━━━━━━━━━━
_ curve-is-line
    - curve Curve

curve.type == .segment-type-line || curve.is-line-like

━━━━━━━━━━━━━━━━━━━━
_ rects-overlap
    - a Rect
    - b Rect

!(apart-x || a.bottom < b.top - tolerance || b.bottom < a.top - tolerance)

.. apart-x = a.right < b.left - tolerance || b.right < a.left - tolerance

━━━━━━━━━━━━━━━━━━━━
_ rects-have-area-overlap
    - a Rect
    - b Rect

!(apart-x || a.bottom <= b.top + tolerance || b.bottom <= a.top + tolerance)

.. apart-x = a.right <= b.left + tolerance || b.right <= a.left + tolerance

━━━━━━━━━━━━━━━━━━━━
_ bounds-are-apart
    - a Rect
    - b Rect
    - operation BooleanOperation

|? operation == .boolean-union-operation
    !rects-overlap(a, b)
??
    !rects-have-area-overlap(a, b)

━━━━━━━━━━━━━━━━━━━━
_ has-arrangement-intersection
    - intersections [CurveIntersection]
    - t1 PointOnCurve
    - t2 PointOnCurve

some(intersections) • where abs(each.t1 - t1) < tolerance && abs(each.t2 - t2) < tolerance

━━━━━━━━━━━━━━━━━━━━
_ boolean-class-span-x Coord
    - span BooleanClassSpan
    - t PointOnCurve

|? span.type == .segment-type-line
    span.x1 + (span.x2 - span.x1) * t
??
    cubic-evaluate-control-1d(span.x1, span.hox, span.hix, span.x2, t)

━━━━━━━━━━━━━━━━━━━━
_ boolean-class-span-y Coord
    - span BooleanClassSpan
    - t PointOnCurve

|? span.type == .segment-type-line
    span.y1 + (span.y2 - span.y1) * t
??
    cubic-evaluate-control-1d(span.y1, span.hoy, span.hiy, span.y2, t)

━━━━━━━━━━━━━━━━━━━━
_ boolean-class-span-dx
    - span BooleanClassSpan
    - t PointOnCurve

|? span.type == .segment-type-line
    span.x2 - span.x1
??
    cubic-derivative-1d(coeffs.a, coeffs.b, coeffs.c, t)
        .. coeffs = cubic-coefficients-1d(span.x1, span.hox, span.hix, span.x2)

━━━━━━━━━━━━━━━━━━━━
_ boolean-class-span-dy
    - span BooleanClassSpan
    - t PointOnCurve

|? span.type == .segment-type-line
    span.y2 - span.y1
??
    cubic-derivative-1d(coeffs.a, coeffs.b, coeffs.c, t)
        .. coeffs = cubic-coefficients-1d(span.y1, span.hoy, span.hiy, span.y2)

━━━━━━━━━━━━━━━━━━━━
_ boolean-scalars-bounds
    - scalars CurveRangeScalars

|? scalars.type == .segment-type-line
    Rect(left, top, right - left, bottom - top)
        .. left = min(scalars.x1, scalars.x2)
        .. top = min(scalars.y1, scalars.y2)
        .. right = max(scalars.x1, scalars.x2)
        .. bottom = max(scalars.y1, scalars.y2)
??
    Rect(bounds.min-x, bounds.min-y, bounds.max-x - bounds.min-x, bounds.max-y - bounds.min-y)
        .. bounds = cubic-bounds-xy()
            - scalars.x1
            - scalars.y1
            - scalars.hox
            - scalars.hoy
            - scalars.hix
            - scalars.hiy
            - scalars.x2
            - scalars.y2

━━━━━━━━━━━━━━━━━━━━
_ rect-covers-point
    - rect Rect
    - x Coord
    - y Coord

within-x && y >= rect.top - tolerance && y <= rect.bottom + tolerance

.. within-x = x >= rect.left - tolerance && x <= rect.right + tolerance

━━━━━━━━━━━━━━━━━━━━
_ do cubic-parameter-near PointOnCurve
    - x Coord
    - y Coord
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord

. cx = cubic-coefficients-1d(x1, hox, hix, x2)
. cy = cubic-coefficients-1d(y1, hoy, hiy, y2)
. t = 0.0
. best = (x1 - x) * (x1 - x) + (y1 - y) * (y1 - y)
for step in 1 .. < 17
    . sample = (step as Float) / 16.0
    . distance = cubic-distance-squared(cx, cy, x1, y1, x, y, sample)
    if distance < best
        best = distance
        t = sample
. hull = abs(hox - x1) + abs(hoy - y1) + abs(hix - hox) + abs(hiy - hoy)
hull = hull + abs(x2 - hix) + abs(y2 - hiy)
. reach = 3.0 * hull / 16.0 + tolerance
=? -1 if best > reach * reach
. low = max(t - 0.0625, 0.0)
. high = min(t + 0.0625, 1.0)
. guess = t
for iteration in 0 .. < 8
    . dx = cubic-evaluate-1d(cx.a, cx.b, cx.c, x1, guess) - x
    . dy = cubic-evaluate-1d(cy.a, cy.b, cy.c, y1, guess) - y
    . vx = cubic-derivative-1d(cx.a, cx.b, cx.c, guess)
    . vy = cubic-derivative-1d(cy.a, cy.b, cy.c, guess)
    . ax = 6.0 * cx.a * guess + 2.0 * cx.b
    . ay = 6.0 * cy.a * guess + 2.0 * cy.b
    . slope = vx * vx + vy * vy + dx * ax + dy * ay
    if slope <= 0
        break
    . next = min(max(guess - (dx * vx + dy * vy) / slope, low), high)
    . moved = abs(next - guess)
    guess = next
    if moved < tolerance-tight
        break
=? guess if cubic-distance-squared(cx, cy, x1, y1, x, y, guess) < tolerance * tolerance
. a = high - golden-ratio * (high - low)
. b = low + golden-ratio * (high - low)
. fa = cubic-distance-squared(cx, cy, x1, y1, x, y, a)
. fb = cubic-distance-squared(cx, cy, x1, y1, x, y, b)
for iteration in 0 .. < 48
    if high - low < tolerance-tight
        break
    if fa < fb
        high = b
        b = a
        fb = fa
        a = high - golden-ratio * (high - low)
        fa = cubic-distance-squared(cx, cy, x1, y1, x, y, a)
    else
        low = a
        a = b
        fa = fb
        b = low + golden-ratio * (high - low)
        fb = cubic-distance-squared(cx, cy, x1, y1, x, y, b)
t = (low + high) * 0.5
=? t if cubic-distance-squared(cx, cy, x1, y1, x, y, t) < tolerance * tolerance
= -1

━━━━━━━━━━━━━━━━━━━━
_ cubic-distance-squared Coord
    - cx CubicCoefficients1D
    - cy CubicCoefficients1D
    - x1 Coord
    - y1 Coord
    - x Coord
    - y Coord
    - t PointOnCurve

dx * dx + dy * dy

.. dx = cubic-evaluate-1d(cx.a, cx.b, cx.c, x1, t) - x
.. dy = cubic-evaluate-1d(cy.a, cy.b, cy.c, y1, t) - y

━━━━━━━━━━━━━━━━━━━━
_ do append-span-edge
    - path Path
    - edge BooleanSpanEdge

if !path.count
    path.move-to(edge.start-x, edge.start-y)

if edge.source.type == .segment-type-line
    path.line-to(edge.end-x, edge.end-y)
else
    append-cubic-span-scalars(path, edge)

━━━━━━━━━━━━━━━━━━━━
_ do append-cubic-span-scalars
    - path Path
    - edge BooleanSpanEdge

. source = edge.source
. t1 = edge.t1
. t2 = edge.t2
. x1 = source.x1
. y1 = source.y1
. hox = source.hox
. hoy = source.hoy
. hix = source.hix
. hiy = source.hiy
. x2 = source.x2
. y2 = source.y2

if t1 > 0
    . u = 1 - t1
    . p3x = u * x1 + t1 * hox
    . p3y = u * y1 + t1 * hoy
    . p4x = u * hox + t1 * hix
    . p4y = u * hoy + t1 * hiy
    . p5x = u * hix + t1 * x2
    . p5y = u * hiy + t1 * y2
    . p6x = u * p3x + t1 * p4x
    . p6y = u * p3y + t1 * p4y
    . p7x = u * p4x + t1 * p5x
    . p7y = u * p4y + t1 * p5y
    . p8x = u * p6x + t1 * p7x
    . p8y = u * p6y + t1 * p7y

    x1 = p8x
    y1 = p8y
    hox = p7x
    hoy = p7y
    hix = p5x
    hiy = p5y

if t2 < 1
    . t = (t2 - t1) / (1 - t1)
    . u = 1 - t
    . p3x = u * x1 + t * hox
    . p3y = u * y1 + t * hoy
    . p4x = u * hox + t * hix
    . p4y = u * hoy + t * hiy
    . p5x = u * hix + t * x2
    . p5y = u * hiy + t * y2
    . p6x = u * p3x + t * p4x
    . p6y = u * p3y + t * p4y
    . p7x = u * p4x + t * p5x
    . p7y = u * p4y + t * p5y
    . p8x = u * p6x + t * p7x
    . p8y = u * p6y + t * p7y

    hox = p3x
    hoy = p3y
    hix = p6x
    hiy = p6y
    x2 = p8x
    y2 = p8y

if edge.reverse
    if edge.closes
        x1 = edge.end-x
        y1 = edge.end-y
    path.cubic-curve-to(hix, hiy, hox, hoy, x1, y1)
else
    if edge.closes
        x2 = edge.end-x
        y2 = edge.end-y
    path.cubic-curve-to(hox, hoy, hix, hiy, x2, y2)

━━━━━━━━━━━━━━━━━━━━
_ near-span-coords
    - ax Coord
    - ay Coord
    - bx Coord
    - by Coord

dx * dx + dy * dy < 0.000001

.. dx = ax - bx
.. dy = ay - by

━━━━━━━━━━━━━━━━━━━━
_ do has-cubics
    - path Path

. span = path.commands
= some(0 .. < span.command-count) • where span.verbs[each] == .path-verb-cubic

━━━━━━━━━━━━━━━━━━━━
_ cubic-point Coord
    - a Coord
    - ho Coord
    - hi Coord
    - b Coord
    - t Float

u * u * u * a + 3.0 * u * u * t * ho + 3.0 * u * t * t * hi + t * t * t * b

.. u = 1.0 - t

━━━━━━━━━━━━━━━━━━━━
_ do polygons-have-crossings
    - points1 [Point]
    - points2 [Point]

for i in 0 .. < points1.length
    . start1 = points1[i]
    . end1 = points1[(i + 1) % points1.length]

    for j in 0 .. < points2.length
        . start2 = points2[j]
        . end2 = points2[(j + 1) % points2.length]
        . intr = segment-crossing(start1, end1, start2, end2)
        if intr
            . t1 = segment-parameter(intr, start1, end1)
            . t2 = segment-parameter(intr, start2, end2)
            . middle1 = t1 > 0.00001 && t1 < 0.99999
            . middle2 = t2 > 0.00001 && t2 < 0.99999
            =? true
                if middle1 || middle2
        =? true
            if segments-share-length(start1, end1, start2, end2)

= false

━━━━━━━━━━━━━━━━━━━━
_ segment-crossing
    - start1 Point
    - end1 Point
    - start2 Point
    - end2 Point

if parallel then null else intersect-lines(start1, end1, start2, end2)

.. parallel = lines-are-parallel
    - start1.x
    - start1.y
    - end1.x
    - end1.y
    - start2.x
    - start2.y
    - end2.x
    - end2.y

━━━━━━━━━━━━━━━━━━━━
_ lines-are-parallel
    - ax1 Coord
    - ay1 Coord
    - ax2 Coord
    - ay2 Coord
    - bx1 Coord
    - by1 Coord
    - bx2 Coord
    - by2 Coord

cross * cross <= 0.000000000000000001 * (adx * adx + ady * ady) * (bdx * bdx + bdy * bdy)

.. cross = adx * bdy - ady * bdx
.. adx = ax2 - ax1
.. ady = ay2 - ay1
.. bdx = bx2 - bx1
.. bdy = by2 - by1

━━━━━━━━━━━━━━━━━━━━
_ segments-share-length
    - start1 Point
    - end1 Point
    - start2 Point
    - end2 Point

|? denom < 0.00001
    false
|? abs(dx * (start2.y - start1.y) - dy * (start2.x - start1.x)) >= 0.00001
    false
|? abs(dx * (end2.y - start1.y) - dy * (end2.x - start1.x)) >= 0.00001
    false
??
    min(max(t1, t2), 1.0) - max(min(t1, t2), 0.0) > 0.00001

.. dx = end1.x - start1.x
.. dy = end1.y - start1.y
.. denom = dx * dx + dy * dy
.. t1 = (dx * (start2.x - start1.x) + dy * (start2.y - start1.y)) / denom
.. t2 = (dx * (end2.x - start1.x) + dy * (end2.y - start1.y)) / denom

━━━━━━━━━━━━━━━━━━━━
_ segment-parameter
    - point Point
    - start Point
    - end Point

|? denom < 0.00001
    0
??
    dot / denom

.. dot = px * dx + py * dy
.. denom = dx * dx + dy * dy
.. px = point.x - start.x
.. py = point.y - start.y
.. dx = end.x - start.x
.. dy = end.y - start.y

━━━━━━━━━━━━━━━━━━━━
_ point-at-parameter
    - start Point
    - end Point
    - t Float

Point
    - start.x + (end.x - start.x) * t
    - start.y + (end.y - start.y) * t

━━━━━━━━━━━━━━━━━━━━
_ should-include-fragment
    - operation BooleanOperation
    - source
    - inside-other Bool

|? operation == .boolean-union-operation
    !inside-other
|? operation == .boolean-intersect-operation
    inside-other
|? operation == .boolean-clip-operation
    inside-other
|? source == 1
    !inside-other
??
    inside-other

━━━━━━━━━━━━━━━━━━━━
_ should-include-line-fragment Bool
    - operation BooleanOperation
    - source
    - points [Point]
    - other-points [Point]
    - start Point
    - end Point

|? !polygon-boundary-contains-point(other-points, sample)
    should-include-fragment(operation, source, polygon-contains-point(other-points, sample))
|? operation == .boolean-subtract-operation
    source == 1 && !same-side
??
    source == 1 && same-side

.. sample = point-at-parameter(start, end, 0.5)
.. normal = Point(start.y - end.y, end.x - start.x) * 0.001
.. inward = if forward-inside then sample + normal else sample - normal
.. forward-inside = polygon-contains-point(points, sample + normal)
.. same-side = polygon-contains-point(other-points, inward)

━━━━━━━━━━━━━━━━━━━━
_ do polygon-boundary-contains-point
    - points [Point]
    - point Point

. j = points.length - 1
for i in 0 .. < points.length
    =? true if point-on-segment(point, points[i], points[j])
    j = i
= false

━━━━━━━━━━━━━━━━━━━━
_ should-reverse-fragment
    - operation BooleanOperation
    - source

operation == .boolean-subtract-operation && source == 2

━━━━━━━━━━━━━━━━━━━━
_ do polygon-contains-point
    - points [Point]
    - point Point

. inside = false
. j = points.length - 1

for i in 0 .. < points.length
    . a = points[i]
    . b = points[j]
    =? true
        if point-on-segment(point, a, b)

    . crosses-y = (a.y > point.y) != (b.y > point.y)
    if crosses-y
        . x-at-y = (b.x - a.x) * (point.y - a.y) / (b.y - a.y) + a.x
        if point.x < x-at-y
            inside = !inside

    j = i

= inside

━━━━━━━━━━━━━━━━━━━━
_ point-on-segment
    - point Point
    - start Point
    - end Point

near-line && within-x && within-y

.. near-line = abs(cross) < 0.00001
.. cross = dx * py - dy * px
.. dx = end.x - start.x
.. dy = end.y - start.y
.. px = point.x - start.x
.. py = point.y - start.y
.. within-x = point.x >= min-x && point.x <= max-x
.. min-x = min(start.x, end.x) - 0.00001
.. max-x = max(start.x, end.x) + 0.00001
.. within-y = point.y >= min-y && point.y <= max-y
.. min-y = min(start.y, end.y) - 0.00001
.. max-y = max(start.y, end.y) + 0.00001

