    - workspace BooleanWorkspace

for index in 0 .. < workspace.subpath-spans.length
    workspace.subpath-spans[index] = PathSubpathSpan(workspace.empty-path.commands, 0, 0, 0, false)
workspace.subpath-spans.clear()

━━━━━━━━━━━━━━━━━━━━
_ do append-boolean-arrangement-spans
    - out [BooleanOutputSpan]
    - splits [PointOnCurve]
    - class-spans [BooleanClassSpan]
    - intersections [CurveIntersection]
    - self-intersections [CurveIntersection]
    - source

out.clear()
for i in 0 .. < class-spans.length
    . class-span = class-spans[i]
    if class-span.bounds.width <= tolerance && class-span.bounds.height <= tolerance
        continue
    prepare-curve-span-splits(splits, intersections, self-intersections, source, i)
    for j in 1 .. < splits.length
        . t1 = splits[j - 1]
        . t2 = splits[j]
        if t2 - t1 < tolerance
            continue
        . sample-t = (t1 + t2) * 0.5
        out += BooleanOutputSpan()
            - class-span
            - i
            - t1
            - t2
            - boolean-class-span-x(class-span, sample-t)
            - boolean-class-span-y(class-span, sample-t)

━━━━━━━━━━━━━━━━━━━━
_ do prepare-curve-span-splits
    - splits [PointOnCurve]
    - intersections [CurveIntersection]
    - self-intersections [CurveIntersection]
    - source
    - curve-index Index

splits.clear()
splits += 0
splits += 1
for intr in intersections
    append-curve-span-split(splits, if source == 1 then intr.t1 else intr.t2, curve-index)
for intr in self-intersections
    append-curve-span-split(splits, intr.t1, curve-index)
    append-curve-span-split(splits, intr.t2, curve-index)

for index in 1 .. < splits.length
    . item = splits[index]
    . insert = index
    while insert > 0 && item < splits[insert - 1]
        splits[insert] = splits[insert - 1]
        insert -= 1
    splits[insert] = item

. write Index
. has-last = false
. last PointOnCurve
for split in splits
    if has-last && abs(split - last) < 0.00001
        continue
    splits[write] = split
    write += 1
    last = split
    has-last = true
if write < splits.length
    -= splits[write ...]

