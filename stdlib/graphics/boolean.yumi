_ do collect-curve-pair-intersections-reusing
    - workspace BooleanWorkspace
    - c1 Curve
    - c2 Curve
    - i Index
    - j Index

clear-boolean-intersections(workspace.hits)
if curve-is-line(c1) && curve-is-line(c2)
    . parallel = lines-are-parallel
        - c1.anchor1.x
        - c1.anchor1.y
        - c1.anchor2.x
        - c1.anchor2.y
        - c2.anchor1.x
        - c2.anchor1.y
        - c2.anchor2.x
        - c2.anchor2.y
    if !parallel
        intersect-line-line-scalars()
            - workspace.hits
            - c1.anchor1.x
            - c1.anchor1.y
            - c1.anchor2.x
            - c1.anchor2.y
            - c2.anchor1.x
            - c2.anchor1.y
            - c2.anchor2.x
            - c2.anchor2.y
            - i
            - j
            - null
            - null
else if curve-is-line(c1)
    intersect-line-curve-scalars()
        - workspace.hits
        - c1.anchor1.x
        - c1.anchor1.y
        - c1.anchor2.x
        - c1.anchor2.y
        - c2.anchor1.x
        - c2.anchor1.y
        - c2.handle-out.x
        - c2.handle-out.y
        - c2.handle-in.x
        - c2.handle-in.y
        - c2.anchor2.x
        - c2.anchor2.y
        - i
        - j
        - null
        - null
else if curve-is-line(c2)
    intersect-curve-line-scalars()
        - workspace.hits
        - c1.anchor1.x
        - c1.anchor1.y
        - c1.handle-out.x
        - c1.handle-out.y
        - c1.handle-in.x
        - c1.handle-in.y
        - c1.anchor2.x
        - c1.anchor2.y
        - c2.anchor1.x
        - c2.anchor1.y
        - c2.anchor2.x
        - c2.anchor2.y
        - i
        - j
        - null
        - null
else
    intersect-curves-reusing()
        - workspace.hits
        - workspace.intersection-workspace
        - c1
        - c2
        - 0
        - i
        - j
        - null
        - null

