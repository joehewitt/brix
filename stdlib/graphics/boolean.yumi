_ do append-boolean-classifier-spans
    - workspace BooleanWorkspace
    - spans [BooleanClassSpan]
    - path Path

spans.clear()
clear-boolean-subpath-spans(workspace)
path.append-subpath-spans(workspace.subpath-spans)
. reader = path.curve-reader
. contour Index
for subpath in workspace.subpath-spans
    if !subpath.curve-count
        continue
    for k in 0 .. < subpath.curve-count
        if !reader.next()
            break
        . scalars = CurveRangeScalars()
            - reader.type
            - reader.x1
            - reader.y1
            - reader.handle-out-x
            - reader.handle-out-y
            - reader.handle-in-x
            - reader.handle-in-y
            - reader.x2
            - reader.y2
        spans += BooleanClassSpan()
            - scalars.type
            - scalars.x1
            - scalars.y1
            - scalars.hox
            - scalars.hoy
            - scalars.hix
            - scalars.hiy
            - scalars.x2
            - scalars.y2
            - boolean-scalars-bounds(scalars)
            - contour
    contour += 1
clear-boolean-subpath-spans(workspace)

