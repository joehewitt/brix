────────────────────
+ do get retained-capacity Size

. capacity = intersection-workspace.retained-capacity
capacity += intersections.capacity + hits.capacity + bounds1.capacity + bounds2.capacity
capacity += self-intersections1.capacity + self-intersections2.capacity
capacity += class-spans1.capacity + class-spans2.capacity
capacity += contour-bounds1.capacity * 4 + contour-bounds2.capacity * 4 + subpath-spans.capacity
capacity += spans1.capacity + spans2.capacity + splits.capacity
capacity += edges.capacity + edges.length * 12 + contour-edges.capacity
capacity += flat1.command-capacity + flat1.coord-capacity
capacity += flat2.command-capacity + flat2.coord-capacity
capacity += points1.capacity * 2 + points2.capacity * 2
capacity += line-splits.capacity + line-edges.capacity + line-edges.length * 4
capacity += rect-subpaths.capacity + rect-pieces.capacity * 4 + rect-next.capacity * 4
= capacity

────────────────────
+ get retained-bytes Size

retained-capacity * 8

────────────────────
+ do clear

clear-boolean-intersections(intersections)
clear-boolean-intersections(self-intersections1)
clear-boolean-intersections(self-intersections2)
clear-boolean-intersections(hits)
bounds1.clear()
bounds2.clear()
class-spans1.clear()
class-spans2.clear()
contour-bounds1.clear()
contour-bounds2.clear()
clear-boolean-subpath-spans(this)
spans1.clear()
spans2.clear()
splits.clear()
for index in 0 .. < edge-count
    . edge = edges[index]
    edge.source = empty-boolean-class-span()
    edge.used = false
edge-count = 0
contour-edges.clear()
flat1.clear()
flat2.clear()
points1.clear()
points2.clear()
line-splits.clear()
for index in 0 .. < line-edge-count
    . edge = line-edges[index]
    edge.start = Point(0, 0)
    edge.end = Point(0, 0)
    edge.used = false
line-edge-count = 0
for index in 0 .. < rect-subpaths.length
    rect-subpaths[index] = PathSubpathSpan(flat1.commands, 0, 0, 0, false)
rect-subpaths.clear()
rect-pieces.clear()
rect-next.clear()
intersection-workspace.clear()
clear-count += 1
//graphics.geometry.scratch.clears ++

