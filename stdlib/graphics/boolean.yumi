━━━━━━━━━━━━━━━━━━━━
_ do boolean-operation-reusing Path?
    - out Path
    - workspace BooleanWorkspace
    - path1 Path
    - path2 Path
    - operation BooleanOperation

?! Panic("Boolean workspace is already in use")
    if workspace.in-use

. capacity-before = workspace.retained-capacity
workspace.in-use = true
. completed = false
do finally
    if !completed
        out.clear()
        workspace.clear()
    . capacity-after = workspace.retained-capacity
    if capacity-after > capacity-before
        workspace.growth-count += 1
        //graphics.geometry.scratch.growth ++
    //graphics.geometry.scratch.retained-capacity += capacity-after
    workspace.in-use = false

out.clear()
workspace.clear()
curve-arrangement-boolean-reusing()
    - out
    - workspace
    - filled-outline(path1)
    - filled-outline(path2)
    - operation
workspace.clear()
completed = true
= out

━━━━━━━━━━━━━━━━━━━━
_ do filled-outline
    - path Path

=? path if path.is-closed
=? path if path.curve-count < 2 && !has-cubics(path)
. outline = Path()
for subpath in path.subpaths
    . contour = subpath.materialize()
    if contour.count > 1
        contour.close()
        outline.add-path(contour)
= outline

━━━━━━━━━━━━━━━━━━━━
_ empty-boolean-class-span

BooleanClassSpan(.segment-type-line, 0, 0, 0, 0, 0, 0, 0, 0, Rect(0, 0, 0, 0), 0)

━━━━━━━━━━━━━━━━━━━━
_ do clear-boolean-intersections
    - intersections [CurveIntersection]

for index in 0 .. < intersections.length
    intersections[index] = CurveIntersection(0, 0, null, null)
intersections.clear()

━━━━━━━━━━━━━━━━━━━━
_ do append-rect-subtract
    - result [Rect]
    - rect Rect
    - cutter Rect

. overlap = rect-intersection(rect, cutter)
if !overlap
    result += rect
    =
. o = overlap
append-nonempty-rect(result, Rect(rect.left, rect.top, rect.width, o.top - rect.top))
append-nonempty-rect(result, Rect(rect.left, o.bottom, rect.width, rect.bottom - o.bottom))
append-nonempty-rect(result, Rect(rect.left, o.top, o.left - rect.left, o.height))
append-nonempty-rect(result, Rect(o.right, o.top, rect.right - o.right, o.height))

━━━━━━━━━━━━━━━━━━━━
_ do append-nonempty-rect
    - result [Rect]
    - rect Rect

if rect.width > tolerance && rect.height > tolerance
    result += rect

━━━━━━━━━━━━━━━━━━━━
_ do append-rects-to-path
    - path Path
    - rects [Rect]

for rect in rects
    append-rect-to-path(path, rect)

━━━━━━━━━━━━━━━━━━━━
_ do append-rect-to-path
    - path Path
    - rect Rect

=? if rect.width <= tolerance
=? if rect.height <= tolerance

path.move-to(rect.left, rect.top)
path.line-to(rect.right, rect.top)
path.line-to(rect.right, rect.bottom)
path.line-to(rect.left, rect.bottom)
path.close()

━━━━━━━━━━━━━━━━━━━━
_ do curve-arrangement-boolean-reusing
    - out Path
    - workspace BooleanWorkspace
    - path1 Path
    - path2 Path
    - operation BooleanOperation

. area1 = path1.is-closed && path1.curve-count > 0
. area2 = path2.is-closed && path2.curve-count > 0
if !area1 || !area2
    if area1 && operation != .boolean-intersect-operation && operation != .boolean-clip-operation
        out.add-path(path1)
    if area2 && operation == .boolean-union-operation
        out.add-path(path2)
    =
if !has-cubics(path1) && !has-cubics(path2)
    if operation == .boolean-intersect-operation || operation == .boolean-clip-operation
        . rect1 = axis-rect(path1)
        . rect2 = axis-rect(path2)
        if rect1 && rect2
            . overlap = rect-intersection(rect1, rect2)
            if overlap
                out.append-rectangle(overlap)
            =
    =? if line-polygon-boolean-reusing(out, workspace, path1, path2, operation)
    =? if axis-rect-list-boolean-reusing(out, workspace, path1, path2, operation)

. path-bounds1 = path1.bounding-box
. path-bounds2 = path2.bounding-box
if bounds-are-apart(path-bounds1, path-bounds2, operation)
    append-disjoint-boolean(out, path1, path2, operation)
    =

//graphics.boolean.segments += path1.curve-count + path2.curve-count
append-boolean-classifier-spans(workspace, workspace.class-spans1, path1)
append-boolean-classifier-spans(workspace, workspace.class-spans2, path2)
. single-contour = is-single-contour(path1) && is-single-contour(path2)
if !single-contour && boolean-contours-apart(workspace, operation)
    append-disjoint-boolean(out, path1, path2, operation)
    =

collect-curve-arrangement-intersections-reusing(workspace, path1, path2)
if single-contour
    if !workspace.intersections
        curve-no-crossing-boolean-reusing(out, workspace, path1, path2, operation)
        =
else
    collect-contour-crossings-reusing()
        - workspace
        - workspace.self-intersections1
        - workspace.class-spans1
        - path1
    collect-contour-crossings-reusing()
        - workspace
        - workspace.self-intersections2
        - workspace.class-spans2
        - path2

=? if arrange-boolean-reusing(out, workspace, path1.is-clockwise, operation, true)
out.clear()
flattened-boolean-reusing(out, workspace, path1, path2, operation)

━━━━━━━━━━━━━━━━━━━━
_ do arrange-boolean-reusing
    - out Path
    - workspace BooleanWorkspace
    - interior-left Bool
    - operation BooleanOperation
    - strict Bool

append-boolean-arrangement-spans()
    - workspace.spans1
    - workspace.splits
    - workspace.class-spans1
    - workspace.intersections
    - workspace.self-intersections1
    - 1
append-boolean-arrangement-spans()
    - workspace.spans2
    - workspace.splits
    - workspace.class-spans2
    - workspace.intersections
    - workspace.self-intersections2
    - 2
reset-boolean-span-edges(workspace)
append-curve-span-fragments-reusing(workspace, workspace.spans1, operation, 1, interior-left)
append-curve-span-fragments-reusing(workspace, workspace.spans2, operation, 2, interior-left)
= build-boolean-span-path-reusing(out, workspace, strict)

━━━━━━━━━━━━━━━━━━━━
_ do append-disjoint-boolean
    - out Path
    - path1 Path
    - path2 Path
    - operation BooleanOperation

if operation == .boolean-union-operation
    out.add-path(path1)
    out.add-path(path2)
else if operation == .boolean-subtract-operation
    out.add-path(path1)

━━━━━━━━━━━━━━━━━━━━
_ do boolean-contours-apart
    - workspace BooleanWorkspace
    - operation BooleanOperation

append-boolean-contour-bounds(workspace.contour-bounds1, workspace.class-spans1)
append-boolean-contour-bounds(workspace.contour-bounds2, workspace.class-spans2)
for bounds1 in workspace.contour-bounds1
    for bounds2 in workspace.contour-bounds2
        =? false if !bounds-are-apart(bounds1, bounds2, operation)
= true

━━━━━━━━━━━━━━━━━━━━
_ do append-boolean-contour-bounds
    - out [Rect]
    - spans [BooleanClassSpan]

out.clear()
for span in spans
    if span.contour < out.length
        out[span.contour] = rect-union(out[span.contour], span.bounds)
    else
        out += span.bounds

━━━━━━━━━━━━━━━━━━━━
_ rect-union
    - a Rect
    - b Rect

Rect(left, top, max(a.right, b.right) - left, max(a.bottom, b.bottom) - top)

.. left = min(a.left, b.left)
.. top = min(a.top, b.top)

━━━━━━━━━━━━━━━━━━━━
_ do curve-no-crossing-boolean-reusing
    - out Path
    - workspace BooleanWorkspace
    - path1 Path
    - path2 Path
    - operation BooleanOperation

. bounds1 = path1.bounding-box
. bounds2 = path2.bounding-box
. spans1 = workspace.class-spans1
. spans2 = workspace.class-spans2
. path1-inside-path2 = bounds2.contains(bounds1, tolerance) && boolean-spans-enclose(spans2, spans1)
. path2-inside-path1 = bounds1.contains(bounds2, tolerance) && boolean-spans-enclose(spans1, spans2)

if operation == .boolean-union-operation
    if path1-inside-path2
        out.add-path(path2)
    else if path2-inside-path1
        out.add-path(path1)
    else
        out.add-path(path1)
        out.add-path(path2)
else if operation == .boolean-intersect-operation || operation == .boolean-clip-operation
    if path1-inside-path2
        out.add-path(path1)
    else if path2-inside-path1
        out.add-path(path2)
else if !path1-inside-path2
    out.add-path(path1)
    if path2-inside-path1
        if path1.is-clockwise == path2.is-clockwise
            out.add-path-reverse(path2)
        else
            out.add-path(path2)

━━━━━━━━━━━━━━━━━━━━
_ do boolean-spans-enclose
    - outer [BooleanClassSpan]
    - inner [BooleanClassSpan]

for span in inner
    . x = boolean-class-span-x(span, 0.5)
    . y = boolean-class-span-y(span, 0.5)
    if !boolean-spans-touch(outer, x, y)
        = boolean-ray-winding(outer, false, 0, x, y, 1, 0).left != 0
= true

━━━━━━━━━━━━━━━━━━━━
_ do collect-curve-arrangement-intersections-reusing
    - workspace BooleanWorkspace
    - path1 Path
    - path2 Path

clear-boolean-intersections(workspace.intersections)
. spans1 = workspace.class-spans1
. spans2 = workspace.class-spans2
for i in 0 .. < spans1.length
    . a = spans1[i]
    for j in 0 .. < spans2.length
        //graphics.boolean.active-tests ++
        . b = spans2[j]
        if rects-overlap(a.bounds, b.bounds)
            collect-boolean-pair-crossings()
                - workspace
                - workspace.intersections
                - a
                - b
                - i
                - j
                - path1
                - path2

━━━━━━━━━━━━━━━━━━━━
_ do collect-contour-crossings-reusing
    - workspace BooleanWorkspace
    - out [CurveIntersection]
    - spans [BooleanClassSpan]
    - path Path

clear-boolean-intersections(out)
for i in 0 .. < spans.length
    . a = spans[i]
    for j in i + 1 .. < spans.length
        . b = spans[j]
        if a.contour != b.contour && rects-overlap(a.bounds, b.bounds)
            collect-boolean-pair-crossings(workspace, out, a, b, i, j, path, path)

━━━━━━━━━━━━━━━━━━━━
_ do collect-boolean-pair-crossings
    - workspace BooleanWorkspace
    - out [CurveIntersection]
    - a BooleanClassSpan
    - b BooleanClassSpan
    - i Index
    - j Index
    - path1 Path
    - path2 Path

. start-on-a = boolean-span-parameter(a, b.x1, b.y1)
. end-on-a = boolean-span-parameter(a, b.x2, b.y2)
. start-on-b = boolean-span-parameter(b, a.x1, a.y1)
. end-on-b = boolean-span-parameter(b, a.x2, a.y2)
if !boolean-spans-overlap(a, b, start-on-a, end-on-a, start-on-b, end-on-b)
    collect-curve-pair-intersections-reusing()
        - workspace
        - boolean-span-curve(a)
        - boolean-span-curve(b)
        - i
        - j
    for hit in workspace.hits
        append-curve-contact(out, path1, path2, hit.t1, hit.t2)
if start-on-a >= 0
    append-curve-contact(out, path1, path2, i + start-on-a, j + 0.0)
if end-on-a >= 0
    append-curve-contact(out, path1, path2, i + end-on-a, j + 1.0)
if start-on-b >= 0
    append-curve-contact(out, path1, path2, i + 0.0, j + start-on-b)
if end-on-b >= 0
    append-curve-contact(out, path1, path2, i + 1.0, j + end-on-b)

━━━━━━━━━━━━━━━━━━━━
_ do boolean-spans-overlap
    - a BooleanClassSpan
    - b BooleanClassSpan
    - start-on-a PointOnCurve
    - end-on-a PointOnCurve
    - start-on-b PointOnCurve
    - end-on-b PointOnCurve

=? false if a.type == .segment-type-line || b.type == .segment-type-line
. low = 1.0
. high = 0.0
if start-on-a >= 0
    low = min(low, start-on-a)
    high = max(high, start-on-a)
if end-on-a >= 0
    low = min(low, end-on-a)
    high = max(high, end-on-a)
if start-on-b >= 0
    low = 0.0
if end-on-b >= 0
    high = 1.0
=? false if high - low <= tolerance
for step in 1 .. < 4
    . t = low + (high - low) * (step as Float) * 0.25
    . x = boolean-class-span-x(a, t)
    . y = boolean-class-span-y(a, t)
    =? false if boolean-span-parameter(b, x, y) < 0
= true

━━━━━━━━━━━━━━━━━━━━
_ boolean-span-curve
    - span BooleanClassSpan

Curve((span.x1, span.y1), (span.hox, span.hoy), (span.hix, span.hiy), (span.x2, span.y2), span.type)

━━━━━━━━━━━━━━━━━━━━
_ boolean-span-parameter
    - span BooleanClassSpan
    - x Coord
    - y Coord

|? !rect-covers-point(span.bounds, x, y)
    -1
|? span.type == .segment-type-line
    boolean-segment-parameter(x, y, span.x1, span.y1, span.x2, span.y2)
??
    cubic-parameter-near()
        - x
        - y
        - span.x1
        - span.y1
        - span.hox
        - span.hoy
        - span.hix
        - span.hiy
        - span.x2
        - span.y2

━━━━━━━━━━━━━━━━━━━━
_ boolean-segment-parameter PointOnCurve
    - x Coord
    - y Coord
    - x1 Coord
    - y1 Coord
    - x2 Coord
    - y2 Coord

|? length-squared <= tolerance * tolerance
    if px * px + py * py < tolerance * tolerance then 0 else -1
|? cross * cross > tolerance * tolerance * length-squared
    -1
|? t < -slack || t > 1 + slack
    -1
??
    min(max(t, 0.0), 1.0)

.. dx = x2 - x1
.. dy = y2 - y1
.. px = x - x1
.. py = y - y1
.. length-squared = dx * dx + dy * dy
.. cross = dx * py - dy * px
.. t = (px * dx + py * dy) / length-squared
.. slack = tolerance / sqrt(length-squared)

