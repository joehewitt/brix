.. overlap = rect-intersection(a, b)

━━━━━━━━━━━━━━━━━━━━
+ do subtract-overlap-rect
    - a Rect
    - overlap Rect

. path = Path()
path.move-to(a.left, a.top)
path.line-to(a.right, a.top)
path.line-to(a.right, overlap.top)
path.line-to(overlap.left, overlap.top)
path.line-to(overlap.left, a.bottom)
path.line-to(a.left, a.bottom)
path.close()
= path

