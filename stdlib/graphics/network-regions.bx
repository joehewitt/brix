(import ./curve)
(import ./intersection)
(import ./network)
(import ./path)
(import ./point)
(import ./primitives)
(import /math)
(blank)
(prop _ network-cut-reach Float (= 0.01))

(type + NetworkRegion
  (prop + id Index)
  (prop + path _ (= (call Path)))
  (prop + boundaries (list NetworkBoundary))
  (prop + predecessors (list Index))
  (prop + sample Point)
  (prop + area Float)
  (fn-expr + contains _
    (param point Point)
    (call (. path contains) point)
  )
  (fn-do + copy NetworkRegion
    (let result (call NetworkRegion))
    (= (. result id) id)
    (= (. result path) (call Path path))
    (for (in boundary boundaries)
      (+= (. result boundaries) boundary)
    )
    (for (in predecessor predecessors)
      (+= (. result predecessors) predecessor)
    )
    (= (. result sample) sample)
    (= (. result area) area)
    (return result)
  )
)

(type + NetworkRegions
  (prop + revision Size)
  (prop + regions (list NetworkRegion))
  (prop + retired (list Index))
  (fn-do + pick (? NetworkRegion)
    (param point Point)
    (for (in region regions)
      (return-if region (if (call (. region contains) point)))
    )
    (return null)
  )
  (fn-do + copy NetworkRegions
    (let result (call NetworkRegions))
    (= (. result revision) revision)
    (for (in region regions)
      (+= (. result regions) (call (. region copy)))
    )
    (for (in id retired)
      (+= (. result retired) id)
    )
    (return result)
  )
)

(type + NetworkBoundary (is Tuple)
  (prop + segment Index)
  (prop + source Index)
  (prop + start Float)
  (prop + end Float)
  (prop + reversed Bool)
  (fn-expr + along _ :get
    (!= (<= start end) reversed)
  )
)

(type + NetworkCrossing (is Tuple)
  (prop + segment Index)
  (prop + parameter Float)
  (prop + crossing Index)
  (prop + position Point)
)

(type + NetworkRegionWorkspace
  (prop _ owner (? VectorNetwork))
  (prop _ cached (? NetworkRegions))
  (prop _ cached-revision Size)
  (prop _ next-id Index (= 1))
  (prop _ tolerance Length (= 0.00001))
  (prop _ nodes (list Point))
  (prop _ arcs (list NetworkArc))
  (prop _ cuts (list NetworkCuts))
  (prop _ hits (list CurveIntersection))
  (prop _ intersections _ (= (call IntersectionWorkspace)))
  (fn-do + This _
    (param tolerance Length (= 0.00001))
    (if (or (not (call is-finite tolerance)) (<= tolerance 0))
      (throw (call Panic "Region tolerance must be positive and finite"))
    )
    (= (. this tolerance) tolerance)
  )
  (fn-do + resolve NetworkRegions
    (param network VectorNetwork)
    (if (and owner (== (as owner Pointer) (as network Pointer)) cached (== cached-revision (. network revision)))
      (return cached)
    )
    (let previous (only-if cached (if (and owner (== (as owner Pointer) (as network Pointer))))))
    (let result (call build network previous))
    (= owner network)
    (= cached result)
    (= cached-revision (. network revision))
    (return result)
  )
  (fn-expr + resolve-after _
    (param network VectorNetwork)
    (param previous NetworkRegions)
    (call build network previous)
  )
  (fn-do + crossings (list NetworkCrossing)
    (param network VectorNetwork)
    (call (. nodes clear))
    (call gather-cuts network)
    (let result (list NetworkCrossing))
    (for (in cut cuts)
      (for (in i (..< 1 (- (. cut parameters length) 1)))
        (let parameter ([] (. cut parameters) i))
        (let position (call network-curve-point (. cut curve) parameter))
        (if (and (> (call (. position distance) (. cut curve anchor1)) tolerance) clears-anchor2)
          (+= result (call NetworkCrossing (. cut segment id) parameter (call node position) position))
        )
        (lazy clears-anchor2 (> (call (. position distance) (. cut curve anchor2)) tolerance))
      )
    )
    (call (. nodes clear))
    (call (. cuts clear))
    (return result)
  )
  (fn-do + copy-for NetworkRegionWorkspace
    (param network VectorNetwork)
    (let result (call NetworkRegionWorkspace tolerance))
    (= (. result owner) network)
    (= (. result cached) (only-if (call (. cached copy)) (if cached)))
    (= (. result cached-revision) cached-revision)
    (= (. result next-id) next-id)
    (return result)
  )
  (fn-do + clear _
    (= owner null)
    (= cached null)
    (call (. nodes clear))
    (call (. arcs clear))
    (call (. cuts clear))
    (call (. hits clear))
    (call (. intersections clear))
  )
  (fn-do _ build _
    (param network VectorNetwork)
    (param previous (? NetworkRegions))
    (call (. nodes clear))
    (call (. arcs clear))
    (call gather-cuts network)
    (for (in cut cuts)
      (for (in i (..< 1 (. cut parameters length)))
        (call add-fragment cut ([] (. cut parameters) (- i 1)) ([] (. cut parameters) i))
      )
    )
    (let cycles (list NetworkCycle))
    (for (in i (..< 0 (. arcs length)))
      (if (not (. ([] arcs i) visited))
        (let cycle (call walk i))
        (if (> (call abs (. cycle area)) (* tolerance tolerance))
          (+= cycles cycle)
        )
      )
    )
    (let result (call NetworkRegions))
    (= (. result revision) (. network revision))
    (for (in cycle cycles)
      (if (> (. cycle area) 0)
        (let region (call NetworkRegion))
        (= (. region path) (call Path (. cycle path)))
        (= (. region area) (. cycle area))
        (= (. region sample) (. cycle sample))
        (for (in boundary (. cycle boundaries))
          (+= (. region boundaries) boundary)
        )
        (+= (. result regions) region)
      )
    )
    (for (in cycle cycles)
      (if (< (. cycle area) 0)
        (let container (? NetworkRegion))
        (for (in region (. result regions))
          (if (not (call network-shared-boundary (. region boundaries) (. cycle boundaries)))
            (if (call (. region path contains) (. cycle sample))
              (if (or (not container) (< (. region area) (. container area)))
                (= container region)
              )
            )
          )
        )
        (if container
          (call (. container path add-path) (. cycle path))
          (for (in boundary (. cycle boundaries))
            (+= (. container boundaries) boundary)
          )
        )
      )
    )
    (if previous
      (call correspond previous result)
    )
    (for (in region (. result regions))
      (if (not (. region id))
        (= (. region id) next-id)
        (+= next-id 1)
      )
    )
    (return result)
  )
  (fn-do _ gather-cuts _
    (param network VectorNetwork)
    (call (. cuts clear))
    (for (in edge (. network segments))
      (+= cuts (call NetworkCuts edge (call (. network curve) (. edge id))))
    )
    (for (in i (..< 0 (. cuts length)))
      (call self-cuts ([] cuts i))
      (for (in j (..< (+ i 1) (. cuts length)))
        (if (call (. ([] cuts i) near) ([] cuts j))
          (call intersect-cuts ([] cuts i) ([] cuts j))
        )
      )
    )
  )
  (fn-do _ intersect-cuts _
    (param first NetworkCuts)
    (param second NetworkCuts)
    (let a (. first curve))
    (let b (. second curve))
    (for (in parameter (list 0.0 1.0))
      (let point (call network-curve-point a parameter))
      (let parameter-on-curve (call (. b get-parameter) point))
      (if (>= parameter-on-curve 0)
        (call (. second add) parameter-on-curve)
      )
      (= point (call network-curve-point b parameter))
      (= parameter-on-curve (call (. a get-parameter) point))
      (if (>= parameter-on-curve 0)
        (call (. first add) parameter-on-curve)
      )
    )
    (return-if (if (or (== a b) (call (. a equals-reverse) b))))
    (blank)
    (call (. hits clear))
    (if (and (. a is-line-like) (. b is-line-like))
      (call intersect-line-line-scalars
        (block
          (arg hits)
          (arg (. a anchor1 x))
          (arg (. a anchor1 y))
          (arg (. a anchor2 x))
          (arg (. a anchor2 y))
          (arg (. b anchor1 x))
          (arg (. b anchor1 y))
          (arg (. b anchor2 x))
          (arg (. b anchor2 y))
          (arg 0)
          (arg 0)
          (arg null)
          (arg null)
        )
      )
      (else-if (. a is-line-like)
        (call intersect-line-curve-scalars
          (block
            (arg hits)
            (arg (. a anchor1 x))
            (arg (. a anchor1 y))
            (arg (. a anchor2 x))
            (arg (. a anchor2 y))
            (arg (. b anchor1 x))
            (arg (. b anchor1 y))
            (arg (. b handle-out x))
            (arg (. b handle-out y))
            (arg (. b handle-in x))
            (arg (. b handle-in y))
            (arg (. b anchor2 x))
            (arg (. b anchor2 y))
            (arg 0)
            (arg 0)
            (arg null)
            (arg null)
          )
        )
      )
      (else-if (. b is-line-like)
        (call intersect-curve-line-scalars
          (block
            (arg hits)
            (arg (. a anchor1 x))
            (arg (. a anchor1 y))
            (arg (. a handle-out x))
            (arg (. a handle-out y))
            (arg (. a handle-in x))
            (arg (. a handle-in y))
            (arg (. a anchor2 x))
            (arg (. a anchor2 y))
            (arg (. b anchor1 x))
            (arg (. b anchor1 y))
            (arg (. b anchor2 x))
            (arg (. b anchor2 y))
            (arg 0)
            (arg 0)
            (arg null)
            (arg null)
          )
        )
      )
      (else
        (call intersect-curves-reusing hits intersections a b)
      )
    )
    (for (in hit hits)
      (let ta (. hit t1))
      (let tb (. hit t2))
      (if (. a is-line-like)
        (= ta (call (. a get-parameter) (+ (. a anchor1) (* (- (. a anchor2) (. a anchor1)) (. hit t1)))))
      )
      (if (. b is-line-like)
        (= tb (call (. b get-parameter) (+ (. b anchor1) (* (- (. b anchor2) (. b anchor1)) (. hit t2)))))
      )
      (call (. first add) ta)
      (call (. second add) tb)
    )
  )
  (fn-do _ self-cuts _
    (param cut NetworkCuts)
    (let curve (. cut curve))
    (let a (- (+ (- (. curve anchor2) (* (. curve handle-in) 3)) (* (. curve handle-out) 3)) (. curve anchor1)))
    (let b (+ (- (* (. curve anchor1) 3) (* (. curve handle-out) 6)) (* (. curve handle-in) 3)))
    (let c (* (- (. curve handle-out) (. curve anchor1)) 3))
    (let divisor (call network-cross a b))
    (return-if (if (< (call abs divisor) 0.000000000001)))
    (blank)
    (let sum (/ (- (call network-cross a c)) divisor))
    (let product
      (scope (+ (* sum sum) quotient)
        (lazy quotient (if-expr (>= (call abs (. a x)) (call abs (. a y))) (/ (+ (* (. b x) sum) (. c x)) (. a x)) (/ (+ (* (. b y) sum) (. c y)) (. a y))))
      )
    )
    (let discriminant (- (* sum sum) (* 4 product)))
    (return-if (if (<= discriminant 0)))
    (blank)
    (let first (/ (- sum (call sqrt discriminant)) 2))
    (let second (/ (+ sum (call sqrt discriminant)) 2))
    (if (and (>= first 0) (<= second 1))
      (call (. cut add) first)
      (call (. cut add) second)
    )
  )
  (fn-do _ node Index
    (param point Point)
    (for (in i (..< 0 (. nodes length)))
      (return-if i (if (<= (call (. ([] nodes i) distance) point) tolerance)))
    )
    (+= nodes point)
    (return (- (. nodes length) 1))
  )
  (fn-do _ add-fragment _
    (param cut NetworkCuts)
    (param start Float)
    (param end Float)
    (let curve (call (. cut curve split-at-range) start end))
    (let chord (call (. curve anchor1 distance) (. curve anchor2)))
    (let outgoing (call (. curve anchor1 distance) (. curve handle-out)))
    (let incoming (call (. curve anchor1 distance) (. curve handle-in)))
    (return-if (if (<= (call max chord (call max outgoing incoming)) tolerance)))
    (blank)
    (let a (call node (. curve anchor1)))
    (let b (call node (. curve anchor2)))
    (for (in arc arcs)
      (if (and (== (. arc start) a) (== (. arc end) b))
        (if (and (. arc curve is-line-like) (. curve is-line-like))
          (return)
        )
        (let quarter (call network-curve-point (. arc curve) 0.25))
        (let other-quarter (call network-curve-point curve 0.25))
        (if (<= (call (. quarter distance) other-quarter) tolerance)
          (let half (call network-curve-point (. arc curve) 0.5))
          (let other-half (call network-curve-point curve 0.5))
          (if (<= (call (. half distance) other-half) tolerance)
            (let three-quarter (call network-curve-point (. arc curve) 0.75))
            (let other-three-quarter (call network-curve-point curve 0.75))
            (if (<= (call (. three-quarter distance) other-three-quarter) tolerance)
              (return)
            )
          )
        )
      )
    )
    (let edge (. cut segment))
    (let lo (+ (. edge source-start) (* (- (. edge source-end) (. edge source-start)) start)))
    (let hi (+ (. edge source-start) (* (- (. edge source-end) (. edge source-start)) end)))
    (let forward (. arcs length))
    (+= arcs (call NetworkArc a b (+ forward 1) curve (call NetworkBoundary (. edge id) (. edge source) lo hi false)))
    (+= arcs
      (call NetworkArc
        (block
          (arg b)
          (arg a)
          (arg forward)
          (arg (call Curve (. curve anchor2) (. curve handle-in) (. curve handle-out) (. curve anchor1)))
          (arg (call NetworkBoundary (. edge id) (. edge source) lo hi true))
        )
      )
    )
  )
  (fn-do _ walk NetworkCycle
    (param start Index)
    (let result (call NetworkCycle))
    (let cycle (list Index))
    (let current start)
    (while (not (. ([] arcs current) visited))
      (let arc ([] arcs current))
      (= (. arc visited) true)
      (+= cycle current)
      (= current (call successor current))
    )
    (let changed true)
    (while (and changed (> (. cycle length) 1))
      (= changed false)
      (for (in i (..< 0 (. cycle length)))
        (let next (if-expr (== i (- (. cycle length) 1)) 0 (+ i 1)))
        (if (== (. ([] arcs ([] cycle i)) twin) ([] cycle next))
          (if (== next 0)
            (call (. cycle remove) i)
            (call (. cycle remove) 0)
            (else
              (call (. cycle remove) next)
              (call (. cycle remove) i)
            )
          )
          (= changed true)
          (break)
        )
      )
    )
    (return-if result (if (not (. cycle length))))
    (blank)
    (let first (. ([] arcs ([] cycle 0)) curve))
    (call (. result path move-to) (. first anchor1))
    (for (in id cycle)
      (let arc ([] arcs id))
      (call (. result path cubic-curve-to) (. arc curve handle-out) (. arc curve handle-in) (. arc curve anchor2))
      (+= (. result boundaries) (. arc boundary))
      (+= (. result area) (call network-curve-area (. arc curve)))
    )
    (call (. result path close))
    (let point (call network-curve-point first 0.5))
    (let delta (- (call network-curve-point first 0.501) (call network-curve-point first 0.499)))
    (if (> (. delta length) 0)
      (= (. result sample) (+ point (* (call Point (- (. delta y)) (. delta x)) (/ (* tolerance 4) (. delta length)))))
      (else
        (= (. result sample) point)
      )
    )
    (return result)
  )
  (fn-do _ successor Index
    (param id Index)
    (let arc ([] arcs id))
    (let reverse-angle (call network-arc-angle (. ([] arcs (. arc twin)) curve)))
    (let best (. arc twin))
    (let best-turn (* 2 π))
    (for (in i (..< 0 (. arcs length)))
      (if (and (== (. ([] arcs i) start) (. arc end)) (!= i (. arc twin)))
        (let angle (call network-arc-angle (. ([] arcs i) curve)))
        (let turn (- reverse-angle angle))
        (if (< turn 0)
          (+= turn (* 2 π))
        )
        (if (< turn best-turn)
          (= best i)
          (= best-turn turn)
        )
      )
    )
    (return best)
  )
  (fn-do _ correspond _
    (param previous NetworkRegions)
    (param result NetworkRegions)
    (for (in region (. result regions))
      (for (in old (. previous regions))
        (let shared false)
        (for (in a (. region boundaries))
          (for (in b (. old boundaries))
            (if (and (== (. a source) (. b source)) (== (. a along) (. b along)) (call network-overlaps a b))
              (= shared true)
            )
          )
        )
        (if shared
          (+= (. region predecessors) (. old id))
        )
      )
      (if (not (. region predecessors length))
        (for (in old (. previous regions))
          (if (call (. old contains) (. region sample))
            (+= (. region predecessors) (. old id))
          )
        )
      )
    )
    (let twins (list Index))
    (for (in region (. result regions))
      (let count Size 0)
      (let twin Index)
      (for (in old (. previous regions))
        (if (and (call network-has-id (. region predecessors) (. old id)) (call network-same-sources (. region boundaries) (. old boundaries)))
          (+= count 1)
          (= twin (. old id))
        )
      )
      (+= twins (if-expr (== count 1) twin 0))
    )
    (let kept (list Index))
    (for (in old (. previous regions))
      (let count Size 0)
      (let successor (? NetworkRegion))
      (for (in i (..< 0 (. result regions length)))
        (if (== ([] twins i) (. old id))
          (+= count 1)
          (= successor ([] (. result regions) i))
        )
      )
      (if (== count 1)
        (call network-continue (!! successor) (. old id))
        (+= kept (. old id))
      )
    )
    (for (in old (. previous regions))
      (if (call network-has-id kept (. old id))
        (continue)
      )
      (let count Size 0)
      (let successor (? NetworkRegion))
      (for (in region (. result regions))
        (if (and (not (. region id)) (call network-has-id (. region predecessors) (. old id)))
          (+= count 1)
          (= successor region)
        )
      )
      (if (and (== count 1) (== (call network-count-missing (. (!! successor) predecessors) kept) 1))
        (call network-continue (!! successor) (. old id))
        (else
          (+= (. result retired) (. old id))
        )
      )
    )
  )
)

(fn-do _ network-continue _
  (param region NetworkRegion)
  (param id Index)
  (= (. region id) id)
  (call (. region predecessors clear))
  (+= (. region predecessors) id)
)

(fn-do _ network-count-missing Size
  (param ids (list Index))
  (param excluded (list Index))
  (let count Size 0)
  (for (in id ids)
    (if (not (call network-has-id excluded id))
      (+= count 1)
    )
  )
  (return count)
)

(fn-do _ network-same-sources Bool
  (param a (list NetworkBoundary))
  (param b (list NetworkBoundary))
  (return (and (call network-sources-within a b) (call network-sources-within b a)))
)

(fn-do _ network-sources-within Bool
  (param inner (list NetworkBoundary))
  (param outer (list NetworkBoundary))
  (for (in x inner)
    (let found false)
    (for (in y outer)
      (if (and (== (. x source) (. y source)) (== (. x along) (. y along)))
        (= found true)
        (break)
      )
    )
    (return-if false (if (not found)))
  )
  (return true)
)

(fn-expr + network-cross _
  (param a Point)
  (param b Point)
  (- (* (. a x) (. b y)) (* (. a y) (. b x)))
)

(fn-do + network-curve-area _
  (param curve Curve)
  (let coefficients (list Point))
  (+= coefficients (. curve anchor1))
  (+= coefficients (* (- (. curve handle-out) (. curve anchor1)) 3))
  (+= coefficients (* (+ (- (. curve anchor1) (* (. curve handle-out) 2)) (. curve handle-in)) 3))
  (+= coefficients (- (+ (- (. curve anchor2) (* (. curve handle-in) 3)) (* (. curve handle-out) 3)) (. curve anchor1)))
  (let result Float)
  (for (in i (..< 0 4))
    (for (in j (..< 1 4))
      (+= result (/ (* (call network-cross ([] coefficients i) ([] coefficients j)) j) (+ i j)))
    )
  )
  (return (/ result 2))
)

(type _ NetworkCuts
  (prop + segment NetworkSegment)
  (prop + curve Curve)
  (prop + parameters (list Float))
  (prop + left Float)
  (prop + top Float)
  (prop + right Float)
  (prop + bottom Float)
  (fn-do + This _
    (param segment _)
    (param curve _)
    (+= parameters 0)
    (+= parameters 1)
    (= left (call min (call min (. curve anchor1 x) (. curve handle-out x)) (call min (. curve handle-in x) (. curve anchor2 x))))
    (= top (call min (call min (. curve anchor1 y) (. curve handle-out y)) (call min (. curve handle-in y) (. curve anchor2 y))))
    (= right (call max (call max (. curve anchor1 x) (. curve handle-out x)) (call max (. curve handle-in x) (. curve anchor2 x))))
    (= bottom (call max (call max (. curve anchor1 y) (. curve handle-out y)) (call max (. curve handle-in y) (. curve anchor2 y))))
  )
  (fn-expr + near Bool
    (param other NetworkCuts)
    (and overlaps-x (<= top (+ (. other bottom) reach)) (<= (. other top) (+ bottom reach)))
    (where
      (lazy reach network-cut-reach)
      (lazy overlaps-x (and (<= left (+ (. other right) reach)) (<= (. other left) (+ right reach))))
    )
  )
  (fn-do + add _
    (param value Float)
    (return-if (if (or (not (call is-finite value)) (<= value 0.000000001) (>= value 0.999999999))))
    (blank)
    (for (in i (..< 0 (. parameters length)))
      (return-if (if (< (call abs (- ([] parameters i) value)) 0.000000001)))
      (blank)
      (if (> ([] parameters i) value)
        (call (. parameters insert) value i)
        (return)
      )
    )
    (+= parameters value)
  )
)

(type _ NetworkArc
  (prop + start Index)
  (prop + end Index)
  (prop + twin Index)
  (prop + curve Curve)
  (prop + boundary NetworkBoundary)
  (prop + visited Bool)
  (fn-do + This _
    (param start _)
    (param end _)
    (param twin _)
    (param curve _)
    (param boundary _)
  )
)

(type _ NetworkCycle
  (prop + path _ (= (call Path)))
  (prop + boundaries (list NetworkBoundary))
  (prop + area Float)
  (prop + sample Point)
)

(fn-expr _ network-arc-angle Float
  (param curve Curve)
  (call atan2 (. delta y) (. delta x))
  (where
    (lazy delta (- (call network-curve-point curve 0.0001) (. curve anchor1)))
  )
)

(fn-do _ network-shared-boundary Bool
  (param first (list NetworkBoundary))
  (param second (list NetworkBoundary))
  (for (in a first)
    (for (in b second)
      (if (and (== (. a source) (. b source)) (call network-overlaps a b))
        (return true)
      )
    )
  )
  (return false)
)

(fn-expr _ network-overlaps Bool
  (param a NetworkBoundary)
  (param b NetworkBoundary)
  (> overlap-end (+ (call max (call min (. a start) (. a end)) (call min (. b start) (. b end))) 0.000000001))
  (where
    (lazy overlap-end (call min (call max (. a start) (. a end)) (call max (. b start) (. b end))))
  )
)
