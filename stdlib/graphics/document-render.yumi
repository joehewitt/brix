────────────────────
+ do sync

. changes = tracker.scan(document)
=? false if synced && !changes.changed.length && !changes.removed.length
synced = true
syncs += 1
clock += 1
last-built = 0
last-reused = 0
render-items.clear()
walk
    - document.store.root
    - base-appearance
    - appearance-hash(base-appearance)
    - vector-document-render-seed
    - Matrix()
if changes.removed.length || entry-count > entry-budget
    trim()
if changes.removed.length
    paths.trim()
= true

