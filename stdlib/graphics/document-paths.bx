(import ./_utils)
(import ./curve)
(import ./document)
(import ./effect)
(import ./matrix)
(import ./network)
(import ./network-regions)
(import ./path)
(import ./point)
(import ./primitives)
(import /core/map)
(blank)
(prop _ vector-document-paths-seed U64 (= 1469598103934665603u64))

(type _ VectorDocumentGeometry
  (prop + revision U64)
  (prop + network VectorNetwork)
  (prop + path (? Path))
  (prop + regions (? NetworkRegions))
  (prop + world-matrix (? Matrix))
  (prop + world (? VectorNetwork))
  (prop + world-path (? Path))
  (fn-do + This _
    (param revision _)
    (param network _)
  )
)

(type _ VectorDocumentEffects
  (prop + stamp U64)
  (prop + effects VectorEffects)
  (fn-do + This _
    (param stamp _)
    (param effects _)
  )
)

(type + VectorDocumentPaths
  (prop + document VectorDocument)
  (prop + effect-computations Size)
  (prop + geometry-builds Size)
  (blank)
  (prop _ geometry (of Map U64 VectorDocumentGeometry))
  (prop _ effect-lists (of Map U64 VectorDocumentEffects))
  (fn-do + This _
    (param document _)
  )
  (fn-expr + network _
    (param id U64)
    (. (call entry-for id) network)
  )
  (fn-do + effects _
    (param id U64)
    (let stamp (call (. document effects-stamp) id))
    (let cached ([] effect-lists id))
    (return-if (. cached effects) (if (and cached (== (. cached stamp) stamp))))
    (let created (call (. document effects) id))
    (= ([] effect-lists id) (call VectorDocumentEffects stamp created))
    (return created)
  )
  (fn-do + geometry-path _
    (param id U64)
    (let entry (call entry-for id))
    (let existing (. entry path))
    (return-if existing (if existing))
    (let created (call (. entry network geometry)))
    (= (. entry path) created)
    (return created)
  )
  (fn-do + world-network _
    (param id U64)
    (let matrix (call (. document world-transform) id))
    (return-if (call network id) (if (not matrix)))
    (let entry (call entry-for id))
    (let existing (. entry world))
    (return-if existing (if (and existing (== (!! (. entry world-matrix)) matrix))))
    (+= geometry-builds 1)
    (let created (call (. document network) id))
    (call (. created transform) matrix)
    (= (. entry world) created)
    (= (. entry world-matrix) matrix)
    (= (. entry world-path) null)
    (return created)
  )
  (fn-expr + world-end-point (? Point)
    (param id U64)
    (param mapping (? Matrix))
    (case? (not ends)
      null
    )
    (case? mapping
      (call (. mapping transform) world)
    )
    (default
      world
    )
    (where
      (lazy network (. (call entry-for id) network))
      (lazy ends (call (. network outline-ends)))
      (lazy position (. (call (. network vertex) (. ends last vertex)) position))
      (lazy matrix (call (. document world-transform) id))
      (lazy world (if-expr matrix (call (. matrix transform) position) position))
    )
  )
  (fn-do + world-end-direction (? Point)
    (param id U64)
    (param at-end Bool)
    (param normal Bool)
    (param mapping (? Matrix))
    (let network (. (call entry-for id) network))
    (let ends (call (. network outline-ends)))
    (return-if null (if (not ends)))
    (let step (if-expr at-end (. ends last) (. ends first)))
    (let curve (call world-segment-curve id (. step segment)))
    (let path (call Path))
    (call (. path move-to) (if-expr (. step reversed) (. curve anchor2) (. curve anchor1)))
    (if (call network-is-monotone-line curve)
      (call (. path line-to) (if-expr (. step reversed) (. curve anchor1) (. curve anchor2)))
      (else
        (call (. path cubic-curve-to)
          (block
            (arg (if-expr (. step reversed) (. curve handle-in) (. curve handle-out)))
            (arg (if-expr (. step reversed) (. curve handle-out) (. curve handle-in)))
            (arg (if-expr (. step reversed) (. curve anchor1) (. curve anchor2)))
          )
        )
      )
    )
    (if mapping
      (call (. path transform) mapping)
    )
    (let count (. network segment-count))
    (let t PointOnCurve (if-expr at-end (- count tolerance) tolerance))
    (let i (as t I32))
    (return (if-expr normal (call (. path get-normal-at) (- t i) null) (call (. path get-tangent-at) (- t i) null)))
  )
  (fn-expr + world-segment-curve Curve
    (param id U64)
    (param index Index)
    (case? (not matrix)
      (call (. network curve) (. edge id))
    )
    (default
      (call Curve
        (block
          (arg head)
          (arg (+ head (call (. linear transform) (. edge tangent-start))))
          (arg (+ tail (call (. linear transform) (. edge tangent-end))))
          (arg tail)
        )
      )
    )
    (where
      (lazy network (. (call entry-for id) network))
      (lazy edge (call (. network segment-at) index))
      (lazy matrix (call (. document world-transform) id))
      (lazy linear (call (. matrix create-shiftless)))
      (lazy head (call (. matrix transform) (. (call (. network vertex) (. edge start)) position)))
      (lazy tail (call (. matrix transform) (. (call (. network vertex) (. edge end)) position)))
    )
  )
  (fn-do + world-path _
    (param id U64)
    (return-if (call geometry-path id) (if (not (call (. document world-transform) id))))
    (let network (call world-network id))
    (let entry (call entry-for id))
    (let existing (. entry world-path))
    (return-if existing (if existing))
    (let created (call (. network geometry)))
    (= (. entry world-path) created)
    (return created)
  )
  (fn-do + regions _
    (param id U64)
    (let entry (call entry-for id))
    (let existing (. entry regions))
    (return-if existing (if existing))
    (let created (call (. (call NetworkRegionWorkspace) resolve) (. entry network)))
    (= (. entry regions) created)
    (return created)
  )
  (fn-expr + paths _
    (param id U64)
    (if-expr (call (. document is-network) id) (call network-paths id) (call group-paths id))
  )
  (fn-do + network-paths _
    (param id U64)
    (let path (call geometry-path id))
    (let effects (call effects id))
    (return-if (list path) (if (not (. effects has-enabled))))
    (let key (call vector-document-mix (call (. document geometry-stamp) id) (call (. document effects-stamp) id)))
    (let stored (call (. document effect-output) id key))
    (return-if stored (if stored))
    (+= effect-computations 1)
    (let result (call (. effects apply) (list path)))
    (call (. document store-effect-output) id key result)
    (return result)
  )
  (fn-do + group-paths (list Path)
    (param id U64)
    (let effects (call effects id))
    (let key (call combined-key id))
    (if (. effects has-enabled)
      (let stored (call (. document effect-output) id key))
      (return-if stored (if stored))
    )
    (let source (list Path))
    (for (in child (call (. document children) id))
      (if (not (call (. document renders) child))
        (continue)
      )
      (let child-paths (if-expr (call (. document is-network) child) (call network-paths child) (call group-paths child)))
      (let child-transform (call (. document transform) child))
      (for (in path child-paths)
        (if child-transform
          (let moved (call Path path))
          (call (. moved transform) child-transform)
          (+= source moved)
          (else
            (+= source path)
          )
        )
      )
    )
    (return-if source (if (not (. effects has-enabled))))
    (+= effect-computations 1)
    (let result (call (. effects apply) source))
    (call (. document store-effect-output) id key result)
    (return result)
  )
  (fn-do + combined-key U64
    (param id U64)
    (let result (call vector-document-mix vector-document-paths-seed (call (. document effects-stamp) id)))
    (for (in child (call (. document children) id))
      (if (call (. document renders) child)
        (= result (call vector-document-mix result (call (. document stamp) child)))
        (if (call (. document is-group) child)
          (= result (call vector-document-mix result (call combined-key child)))
        )
      )
    )
    (return result)
  )
  (fn-do + trim _
    (for (in id (call (of List U64) (. geometry keys)))
      (if (not (call (. document contains) id))
        (-= ([] geometry id))
      )
    )
    (for (in id (call (of List U64) (. effect-lists keys)))
      (if (not (call (. document contains) id))
        (-= ([] effect-lists id))
      )
    )
  )
  (fn-do _ entry-for _
    (param id U64)
    (let revision (call (. document network-revision) id))
    (let cached ([] geometry id))
    (return-if cached (if (and cached (== (. cached revision) revision))))
    (+= geometry-builds 1)
    (let entry (call VectorDocumentGeometry revision (call (. document shared-network) id)))
    (= ([] geometry id) entry)
    (return entry)
  )
)
