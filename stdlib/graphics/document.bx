  )
  (fn-do _ keyed-values _
    (param current (list VectorDocumentKeyedValue))
    (param key String)
    (param value (? VectorDocumentValue))
    (let entries (list VectorDocumentKeyedValue))
    (let placed false)
    (for (in entry current)
      (if (!= (. entry key) key)
        (+= entries entry)
        (else-if (and value (not placed))
          (+= entries (call VectorDocumentKeyedValue key value))
          (= placed true)
        )
      )
    )
    (if (and value (not placed))
      (+= entries (call VectorDocumentKeyedValue key value))
    )
    (return entries)
  )
  (fn-do _ stored-values _
    (param previous VectorDocumentExtent)
    (param entries (list VectorDocumentKeyedValue))
    (let count Size 0)
    (for (in entry entries)
      (+= count (call value-row-count (. entry value)))
    )
    (let extent
      (call reserve-extent
        (block
          (arg (. store values))
          (arg previous)
          (arg count)
          (arg (call VectorDocumentValueRow))
        )
      )
    )
    (let index (as (. extent start) Index))
    (for (in entry entries)
      (= index (call write-value index entry))
    )
    (return extent)
  )
  (fn-do + store-effect-output _
    (param id U64)
    (param input-key U64)
    (param paths (list Path))
    (let row (call row-of id))
    (call drop-effect-output row)
    (let path-start (as (. store output-paths length) U32))
    (for (in path paths)
      (let verb-start (as (. store output-verbs length) U32))
      (let coord-start (as (. store output-coords length) U32))
      (let commands (. path commands))
      (for (in index (..< 0 (. commands command-count)))
        (call (. store output-verbs append) (call VectorDocumentPathVerb ([] (. commands verbs) index)))
      )
      (for (in index (..< 0 (. commands coord-count)))
        (call (. store output-coords append) (call VectorDocumentPathCoord ([] (. commands coords) index)))
      )
      (let verb-count (as (. commands command-count) U32))
      (let coord-count (as (. commands coord-count) U32))
      (call (. store output-paths append)
        (block
          (call VectorDocumentOutputPath
            (block
              (arg (call VectorDocumentExtent verb-start verb-count verb-count))
              (arg (call VectorDocumentExtent coord-start coord-count coord-count))
              (arg (. path is-closed))
            )
          )
        )
      )
    )
    (let path-count (as (. paths length) U32))
    (let output-row
      (call (. store outputs append)
        (block
          (call VectorDocumentEffectOutput
            (block
              (arg row)
              (arg input-key)
              (arg (call VectorDocumentExtent path-start path-count path-count))
            )
          )
        )
      )
    )
    (= (. ([] (. store nodes) row) effect-output) (as output-row U32))
    (let garbage (. store output-garbage))
    (if (and (> garbage vector-document-compaction-floor) (> (* garbage 2) (. store output-coords length)))
      (call drop-effect-outputs)
    )
  )
  (fn-expr + byte-count Size :get
    (+ (. store byte-count) (. scratch byte-count) (. work active-bytes))
  )
  (fn-expr + reclaim-limit _ :get
    (call max reclaim-floor (* (. store live-bytes) vector-document-reclaim-factor))
  )
  (fn-do + reclaim-memory _
    (let limit reclaim-limit)
    (return-if false (if (and (<= (. store byte-count) limit) (<= (. scratch byte-count) limit) (<= (. work active-bytes) limit))))
    (blank)
    (call compact)
    (let fresh (call VectorDocumentStore))
    (call (. fresh copy-from) store)
    (call (. store release))
    (= store fresh)
    (call (. scratch release))
    (= scratch (call VectorDocumentStore))
    (call (. work release))
    (= work (call Arena))
    (= bits (call (of (. work allocate) F64) 1))
    (= remap (call (of Table VectorDocumentRowMap) work 16))
    (+= reclaims 1)
    (return true)
  )
  (fn-expr + chunk-count Size :get
    (. store chunks length)
  )
  (fn-do + chunk-summary _
    (param chunk Index)
    (call settle)
    (return (. ([] (. store chunks) chunk) summary))
  )
  (fn-expr + row-capacity Size :get
    (. store nodes length)
  )
  (fn-expr + row-id _
    (param row Index)
    (if-expr (!= (. ([] (. store nodes) row) kind) .free-node) (. ([] (. store nodes) row) id) 0u64)
  )
  (fn-do + row-stamp _
    (param row Index)
    (call settle)
    (return (. ([] (. store nodes) row) stamp))
  )
  (fn-do + compact _
    (call compact-nodes)
    (call compact-extents)
    (call drop-effect-outputs)
  )
  (fn-do _ initialize _
    (param root-id U64)
    (call (. store nodes append) (call VectorDocumentNode))
    (call (. store vertices append) (call VectorDocumentVertex))
    (call (. store segments append) (call VectorDocumentSegment))
    (call (. store pairs append) (call VectorDocumentPair))
    (call (. store regions append) (call VectorDocumentRegionFill))
    (call (. store fill-layers append) (call VectorDocumentFillLayer))
    (call (. store stroke-layers append) (call VectorDocumentStrokeLayer))
    (call (. store effects append) (call VectorDocumentEffect))
    (call (. store values append) (call VectorDocumentValueRow))
    (call (. store outputs append) (call VectorDocumentEffectOutput))
    (call (. store output-paths append) (call VectorDocumentOutputPath))
    (call (. store output-verbs append) (call VectorDocumentPathVerb))
    (call (. store output-coords append) (call VectorDocumentPathCoord))
    (= (. ([] (. store nodes) 0) name) blank-name)
    (= (. ([] (. store nodes) 0) image) blank-name)
    (call (. store chunks append) (call VectorDocumentChunk))
    (call reset-id-slots 16)
    (let root (call append-node (call allocate-id root-id) (. VectorDocumentNodeKind group-node) ""))
    (= (. store root) (as root U32))
    (call refresh-all root)
  )
  (fn-expr _ row-of _
    (param id U64)
    (call vector-document-row this id)
  )
  (fn-expr _ find-row _
    (param id U64)
    (call vector-document-find-row store id)
  )
  (fn-do _ collect-store-ids _
    (param source VectorDocumentStore)
    (param row Index)
    (param result (list U64))
    (+= result (. ([] (. source nodes) row) id))
    (let child (. ([] (. source nodes) row) first-child))
    (while (!= child 0)
      (call collect-store-ids source child result)
      (= child (. ([] (. source nodes) (as child Index)) next-sibling))
    )
  )
  (fn-expr _ before-row _
    (param anchor U64)
    (if-expr (== anchor 0) 0 (call row-of anchor))
  )
  (fn-do _ allocate-id _
    (param requested U64)
    (if (== requested 0)
      (let id (. store next-id))
      (+= (. store next-id) 1)
      (return id)
    )
    (throw (call Panic (str "Vector document id " requested " is already in use")) (if (!= (call find-row requested) 0)))
    (blank)
    (if (and (== (/and/ requested vector-document-script-id-bit) 0) (>= requested (. store next-id)))
      (= (. store next-id) (+ requested 1))
    )
    (return requested)
  )
  (fn-do _ append-node _
    (param id U64)
    (param kind VectorDocumentNodeKind)
    (param name String)
    (let node (call VectorDocumentNode))
    (= (. node id) id)
    (= (. node kind) kind)
    (= (. node name) (call (. names store) name))
    (= (. node image) blank-name)
    (= (. node opacity) 1%%)
    (= (. node transform) (call Matrix))
    (let row (call (. store nodes append) node))
    (+= (. store live-nodes) 1)
    (while (<= (* (. store chunks length) vector-document-chunk-rows) row)
      (call (. store chunks append) (call VectorDocumentChunk))
    )
    (call insert-id id (as row U32))
    (return row)
  )
  (fn-do _ insert-id _
    (param id U64)
    (param row U32)
    (if (> (* (+ (. store live-nodes) 1) 2) (. store id-slots length))
      (call reset-id-slots (* (. store id-slots length) 2))
      (return)
    )
    (call place-id id row)
  )
  (fn-do _ place-id _
    (param id U64)
    (param row U32)
    (let mask (- (. store id-slots length) 1))
    (let slot (/and/ (as (call vector-document-mix vector-document-seed id) Index) mask))
    (while (!= (. ([] (. store id-slots) slot) id) 0)
      (= slot (/and/ (+ slot 1) mask))
    )
    (= ([] (. store id-slots) slot) (call VectorDocumentIdSlot id row))
  )
  (fn-do _ remove-id _
    (param id U64)
    (let mask (- (. store id-slots length) 1))
    (let slot (/and/ (as (call vector-document-mix vector-document-seed id) Index) mask))
    (while (!= (. ([] (. store id-slots) slot) id) id)
      (return-if (if (== (. ([] (. store id-slots) slot) id) 0)))
      (blank)
      (= slot (/and/ (+ slot 1) mask))
    )
    (let hole slot)
    (let next (/and/ (+ slot 1) mask))
    (while (!= (. ([] (. store id-slots) next) id) 0)
      (let hash (call vector-document-mix vector-document-seed (. ([] (. store id-slots) next) id)))
      (let home (/and/ (as hash Index) mask))
      (let distance-next (/and/ (- next home) mask))
      (let distance-hole (/and/ (- hole home) mask))
      (if (< distance-hole distance-next)
        (= ([] (. store id-slots) hole) (as ([] (. store id-slots) next) VectorDocumentIdSlot))
        (= hole next)
      )
      (= next (/and/ (+ next 1) mask))
    )
    (= ([] (. store id-slots) hole) (call VectorDocumentIdSlot))
  )
  (fn-do _ reset-id-slots _
    (param capacity Size)
    (call (. store id-slots clear))
    (call (. store id-slots reserve) capacity)
    (for (in index (..< 0 capacity))
      (call (. store id-slots append) (call VectorDocumentIdSlot))
    )
    (for (in row (..< 1 (. store nodes length)))
      (if (!= (. ([] (. store nodes) row) kind) .free-node)
        (call place-id (. ([] (. store nodes) row) id) (as row U32))
      )
    )
  )
  (fn-do _ link _
    (param row Index)
    (param parent-row Index)
    (param before-index Index)
    (call attach row parent-row before-index)
    (call refresh-stamp parent-row)
  )
  (fn-do _ attach _
    (param row Index)
    (param parent-row Index)
    (param before-index Index)
    (throw (call Panic "Only groups can hold children") (if (!= (. ([] (. store nodes) parent-row) kind) .group-node)))
    (blank)
    (let anchor (as before-index U32))
    (throw (call Panic "The insertion anchor is not a child of the parent") (if (and (!= anchor 0) (!= (as (. ([] (. store nodes) before-index) parent) Index) parent-row))))
    (blank)
    (+= structure-revision 1)
    (= (. ([] (. store nodes) row) parent) (as parent-row U32))
    (if (== anchor 0)
      (let last (. ([] (. store nodes) parent-row) last-child))
      (= (. ([] (. store nodes) row) prev-sibling) last)
      (= (. ([] (. store nodes) row) next-sibling) 0)
      (if (!= last 0)
        (= (. ([] (. store nodes) (as last Index)) next-sibling) (as row U32))
        (else
          (= (. ([] (. store nodes) parent-row) first-child) (as row U32))
        )
      )
      (= (. ([] (. store nodes) parent-row) last-child) (as row U32))
      (else
        (let previous (. ([] (. store nodes) before-index) prev-sibling))
        (= (. ([] (. store nodes) row) prev-sibling) previous)
        (= (. ([] (. store nodes) row) next-sibling) anchor)
        (= (. ([] (. store nodes) before-index) prev-sibling) (as row U32))
        (if (!= previous 0)
          (= (. ([] (. store nodes) (as previous Index)) next-sibling) (as row U32))
          (else
            (= (. ([] (. store nodes) parent-row) first-child) (as row U32))
          )
        )
      )
    )
  )
  (fn-do _ unlink _
    (param row Index)
    (let parent-row (as (. ([] (. store nodes) row) parent) Index))
    (return-if (if (== parent-row 0)))
    (blank)
    (+= structure-revision 1)
    (let previous (. ([] (. store nodes) row) prev-sibling))
    (let next (. ([] (. store nodes) row) next-sibling))
    (if (!= previous 0)
      (= (. ([] (. store nodes) (as previous Index)) next-sibling) next)
      (else
        (= (. ([] (. store nodes) parent-row) first-child) next)
      )
    )
    (if (!= next 0)
      (= (. ([] (. store nodes) (as next Index)) prev-sibling) previous)
      (else
        (= (. ([] (. store nodes) parent-row) last-child) previous)
      )
    )
    (= (. ([] (. store nodes) row) parent) 0)
    (= (. ([] (. store nodes) row) prev-sibling) 0)
    (= (. ([] (. store nodes) row) next-sibling) 0)
    (call refresh-stamp parent-row)
  )
  (fn-do _ is-ancestor _
    (param ancestor Index)
    (param row Index)
    (let cursor row)
    (while (!= cursor 0)
      (return-if true (if (== cursor ancestor)))
      (blank)
      (= cursor (. ([] (. store nodes) cursor) parent))
    )
    (return false)
  )
  (fn-do _ subtree-hash U64
    (param row Index)
    (let result (. ([] (. store nodes) row) stamp))
    (let child (. ([] (. store nodes) row) first-child))
    (while (!= child 0)
      (= result (call vector-document-mix result (call subtree-hash child)))
      (= child (. ([] (. store nodes) (as child Index)) next-sibling))
    )
    (return result)
  )
  (fn-do _ free-subtree _
    (param row Index)
    (let child (. ([] (. store nodes) row) first-child))
    (while (!= child 0)
      (let next (. ([] (. store nodes) (as child Index)) next-sibling))
      (call free-subtree child)
      (= child next)
    )
    (let node ([] (. store nodes) row))
    (call release-extent (. node vertices))
    (call release-extent (. node segments))
    (call release-extent (. node pairs))
    (call release-extent (. node regions))
    (call release-extent (. node fill-layers))
    (call release-extent (. node stroke-layers))
    (call release-extent (. node effects))
    (call release-extent (. node settings))
    (call release-extent (. node variables))
    (call drop-effect-output row)
    (if (. node network-pending)
      (-= ([] networks (. node id)))
    )
    (call remove-id (. node id))
    (call set-chunk-entry row (. node id) (. node stamp) 0 0)
    (let blank (call VectorDocumentNode))
    (= (. blank name) blank-name)
    (= (. blank image) blank-name)
    (= ([] (. store nodes) row) blank)
    (-= (. store live-nodes) 1)
    (+= (. store node-garbage) 1)
  )
  (fn-do _ set-flag _
    (param id U64)
    (param flag U8)
    (param value Bool)
    (let row (call row-of id))
    (let flags (. ([] (. store nodes) row) flags))
    (= (. ([] (. store nodes) row) flags) (if-expr value (/or/ flags flag) (/and/ flags (/xor/ flag 255))))
    (call refresh-stamp row)
  )
  (fn-do _ (of reserve-extent Row) VectorDocumentExtent
    (param table (of Table Row))
    (param current VectorDocumentExtent)
    (param count Size)
    (param blank Row)
    (if (<= count (. current capacity))
      (return (call VectorDocumentExtent (. current start) (as count U32) (. current capacity)))
    )
    (call release-extent current)
    (let capacity vector-document-minimum-capacity)
    (while (< capacity count)
      (*= capacity 2)
    )
    (let start (as (. table length) U32))
    (for (in index (..< 0 capacity))
      (call (. table append) blank)
    )
    (return (call VectorDocumentExtent start (as count U32) capacity))
  )
  (fn-do _ release-extent _
    (param extent VectorDocumentExtent)
    (+= (. store extent-garbage) (as (. extent capacity) Size))
  )
  (fn-do _ write-network _
    (param row Index)
    (param network VectorNetwork)
    (let vertex-count (. network vertex-count))
    (let segment-count (. network segment-count))
    (let pair-count (. network pair-count))
    (let vertices
      (call reserve-extent
        (block
          (arg (. store vertices))
          (arg (. ([] (. store nodes) row) vertices))
          (arg vertex-count)
          (arg (call VectorDocumentVertex))
        )
      )
    )
    (for (in index (..< 0 vertex-count))
      (let vertex (call (. network vertex-at) index))
      (= ([] (. store vertices) (+ (as (. vertices start) Index) index))
        (call VectorDocumentVertex
          (block
            (arg (as (. vertex id) U64))
            (arg (. vertex position))
          )
        )
      )
    )
    (let segments
      (call reserve-extent
        (block
          (arg (. store segments))
          (arg (. ([] (. store nodes) row) segments))
          (arg segment-count)
          (arg (call VectorDocumentSegment))
        )
      )
    )
    (for (in index (..< 0 segment-count))
      (let segment (call (. network segment-at) index))
      (= ([] (. store segments) (+ (as (. segments start) Index) index))
        (call VectorDocumentSegment
          (block
            (arg (as (. segment id) U64))
            (arg (as (. segment start) U64))
            (arg (as (. segment end) U64))
            (arg (. segment tangent-start))
            (arg (. segment tangent-end))
            (arg (as (. segment source) U64))
            (arg (. segment source-start))
            (arg (. segment source-end))
          )
        )
      )
    )
    (let pairs
      (call reserve-extent
        (block
          (arg (. store pairs))
          (arg (. ([] (. store nodes) row) pairs))
          (arg pair-count)
          (arg (call VectorDocumentPair))
        )
      )
    )
    (for (in index (..< 0 pair-count))
      (let pair (call (. network pair-at) index))
      (= ([] (. store pairs) (+ (as (. pairs start) Index) index))
        (call VectorDocumentPair
          (block
            (arg (as (. pair first segment) U64))
            (arg (. pair first at-end))
            (arg (as (. pair second segment) U64))
            (arg (. pair second at-end))
            (arg (. pair mirror-length))
          )
        )
      )
    )
    (= (. ([] (. store nodes) row) vertices) vertices)
    (= (. ([] (. store nodes) row) segments) segments)
    (= (. ([] (. store nodes) row) pairs) pairs)
    (= (. ([] (. store nodes) row) next-vertex) (as (. network next-vertex-id) U64))
    (= (. ([] (. store nodes) row) next-segment) (as (. network next-segment-id) U64))
    (= (. ([] (. store nodes) row) geometry-bounds) (call Rect))
    (= (. ([] (. store nodes) row) bounds-stale) (> vertex-count 0))
  )
  (fn-do _ write-region-fills _
    (param row Index)
    (param value (list NetworkRegionAppearance))
    (let extent
      (call reserve-extent
        (block
          (arg (. store regions))
          (arg (. ([] (. store nodes) row) regions))
          (arg (. value length))
          (arg (call VectorDocumentRegionFill))
        )
      )
    )
    (for (in index (..< 0 (. value length)))
      (let fill ([] value index))
      (= ([] (. store regions) (+ (as (. extent start) Index) index))
        (call VectorDocumentRegionFill
          (block
            (arg (as (. fill region) U64))
            (arg (!= (. fill fill) null))
            (arg (?? (. fill fill) (call RGBA)))
            (arg (. fill conflict))
          )
        )
      )
    )
    (= (. ([] (. store nodes) row) regions) extent)
  )
  (fn-do _ remapped-region-fills _
    (param id U64)
    (param fills (list NetworkRegionAppearance))
    (param value VectorNetwork)
    (let result (list NetworkRegionAppearance))
    (let painted false)
    (for (in fill fills)
      (if (or (. fill fill) (. fill conflict))
        (= painted true)
      )
    )
    (return-if result (if (not painted)))
    (blank)
    (let previous (call (. (call NetworkRegionWorkspace) resolve) (call network id)))
    (let regions (call (. (call NetworkRegionWorkspace) resolve-after) value previous))
    (for (in index (..< 0 (. regions regions length)))
      (let region ([] (. regions regions) index))
      (let fill (? RGBA))
      (let seen false)
      (let conflict false)
      (for (in predecessor (. region predecessors))
        (let prior (call region-fill-for fills predecessor))
        (if (not seen)
          (= fill (. prior fill))
          (= seen true)
          (else-if (!= fill (. prior fill))
            (= conflict true)
          )
        )
        (= conflict (or conflict (. prior conflict)))
      )
      (if conflict
        (= fill null)
      )
      (+= result (call NetworkRegionAppearance (+ index 1) fill conflict))
    )
    (return result)
  )
  (fn-do _ copy-row Index
    (param source VectorDocumentStore)
    (param source-row Index)
    (param ids (list U64))
    (call vector-document-settle-bounds source source-row)
    (let original (as ([] (. source nodes) source-row) VectorDocumentNode))
    (let requested (if-expr (< copy-cursor (. ids length)) ([] ids copy-cursor) 0u64))
    (+= copy-cursor 1)
    (let row (call append-node (call allocate-id requested) (. original kind) (. original name text)))
    (= (. ([] (. store nodes) row) group-kind) (. original group-kind))
    (= (. ([] (. store nodes) row) image) (call (. names store) (. original image text)))
    (= (. ([] (. store nodes) row) flags) (. original flags))
    (= (. ([] (. store nodes) row) composite-authored) (. original composite-authored))
    (= (. ([] (. store nodes) row) opacity) (. original opacity))
    (= (. ([] (. store nodes) row) transform) (. original transform))
    (= (. ([] (. store nodes) row) rotation) (. original rotation))
    (= (. ([] (. store nodes) row) pivot) (. original pivot))
    (= (. ([] (. store nodes) row) view-box) (. original view-box))
    (= (. ([] (. store nodes) row) geometry-bounds) (. original geometry-bounds))
    (= (. ([] (. store nodes) row) paint-authored) (. original paint-authored))
    (= (. ([] (. store nodes) row) fill-kind) (. original fill-kind))
    (= (. ([] (. store nodes) row) stroke-kind) (. original stroke-kind))
    (= (. ([] (. store nodes) row) fill-color) (. original fill-color))
    (= (. ([] (. store nodes) row) stroke-color) (. original stroke-color))
    (= (. ([] (. store nodes) row) stroke-width) (. original stroke-width))
    (= (. ([] (. store nodes) row) has-stroke-width) (. original has-stroke-width))
    (= (. ([] (. store nodes) row) stroke-alignment) (. original stroke-alignment))
    (= (. ([] (. store nodes) row) stroke-cap) (. original stroke-cap))
    (= (. ([] (. store nodes) row) stroke-join) (. original stroke-join))
    (= (. ([] (. store nodes) row) fill-rule) (. original fill-rule))
    (= (. ([] (. store nodes) row) next-vertex) (. original next-vertex))
    (= (. ([] (. store nodes) row) next-segment) (. original next-segment))
    (= (. ([] (. store nodes) row) effects)
      (call copy-extent
        (block
          (arg (. store effects))
          (arg (. source effects))
          (arg (. original effects))
          (arg (call VectorDocumentEffect))
        )
      )
    )
    (= (. ([] (. store nodes) row) fill-layers)
      (call copy-extent
        (block
          (arg (. store fill-layers))
          (arg (. source fill-layers))
          (arg (. original fill-layers))
          (arg (call VectorDocumentFillLayer))
        )
      )
    )
    (= (. ([] (. store nodes) row) stroke-layers)
      (call copy-extent
        (block
          (arg (. store stroke-layers))
          (arg (. source stroke-layers))
          (arg (. original stroke-layers))
          (arg (call VectorDocumentStrokeLayer))
        )
      )
    )
    (= (. ([] (. store nodes) row) vertices)
      (call copy-extent
        (block
          (arg (. store vertices))
          (arg (. source vertices))
          (arg (. original vertices))
          (arg (call VectorDocumentVertex))
        )
      )
    )
    (= (. ([] (. store nodes) row) segments)
      (call copy-extent
        (block
          (arg (. store segments))
          (arg (. source segments))
          (arg (. original segments))
          (arg (call VectorDocumentSegment))
        )
      )
    )
    (= (. ([] (. store nodes) row) pairs)
      (call copy-extent
        (block
          (arg (. store pairs))
          (arg (. source pairs))
          (arg (. original pairs))
          (arg (call VectorDocumentPair))
        )
      )
    )
    (= (. ([] (. store nodes) row) regions)
      (call copy-extent
        (block
          (arg (. store regions))
          (arg (. source regions))
          (arg (. original regions))
          (arg (call VectorDocumentRegionFill))
        )
      )
    )
    (= (. ([] (. store nodes) row) settings) (call copy-values source (. original settings)))
    (= (. ([] (. store nodes) row) variables) (call copy-values source (. original variables)))
    (= (. ([] (. store nodes) row) geometry-stamp) (. original geometry-stamp))
    (= (. ([] (. store nodes) row) paint-stamp) (. original paint-stamp))
    (= (. ([] (. store nodes) row) effects-stamp) (. original effects-stamp))
    (= (. ([] (. store nodes) row) values-stamp) (. original values-stamp))
    (let child (. original first-child))
    (while (!= child 0)
      (call attach (call copy-row source child ids) row 0)
      (= child (. ([] (. source nodes) (as child Index)) next-sibling))
    )
    (call refresh-stamp row)
    (return row)
  )
  (fn-do _ (of copy-extent Row) VectorDocumentExtent
    (param target (of Table Row))
    (param source (of Table Row))
    (param extent VectorDocumentExtent)
    (param blank Row)
    (return-if (call VectorDocumentExtent) (if (== (. extent count) 0)))
    (blank)
    (let copied (call reserve-extent target (call VectorDocumentExtent) (. extent count) blank))
    (for (in index (..< 0 (. extent count)))
      (= ([] target (as (+ (. copied start) index) Index)) (as ([] source (as (+ (. extent start) index) Index)) Row))
    )
    (return copied)
  )
  (fn-do _ copy-values VectorDocumentExtent
    (param source VectorDocumentStore)
    (param extent VectorDocumentExtent)
    (return-if (call VectorDocumentExtent) (if (== (. extent count) 0)))
    (blank)
    (let copied
      (call reserve-extent
        (block
          (arg (. store values))
          (arg (call VectorDocumentExtent))
          (arg (. extent count))
          (arg (call VectorDocumentValueRow))
        )
      )
    )
    (for (in index (..< 0 (. extent count)))
      (let value (as ([] (. source values) (as (+ (. extent start) index) Index)) VectorDocumentValueRow))
      (= (. value key) (call (. names store) (. value key text)))
      (= (. value text) (call (. names store) (. value text text)))
      (= ([] (. store values) (as (+ (. copied start) index) Index)) value)
    )
    (return copied)
  )
  (fn-do _ read-values (list VectorDocumentKeyedValue)
    (param extent VectorDocumentExtent)
    (let result (list VectorDocumentKeyedValue))
    (let index (as (. extent start) Index))
    (let last (+ index (as (. extent count) Index)))
    (while (< index last)
      (let row (as ([] (. store values) index) VectorDocumentValueRow))
      (+= result (call VectorDocumentKeyedValue (. row key text) (call row-value row (+ index 1))))
      (+= index (call value-span row))
    )
    (return result)
  )
  (fn-do _ row-value VectorDocumentValue
    (param row VectorDocumentValueRow)
    (param items Index)
    (let count (as (. row count) Index))
    (match (. row kind)
      (case= .number-value
        (return (call (. VectorDocumentValue number) (. row x)))
      )
      (case= .point-value
        (return (call (. VectorDocumentValue point) (call Point (. row x) (. row y))))
      )
      (case= .color-value
        (return (call (. VectorDocumentValue color) (. row color)))
      )
      (case= .text-value
        (return (call (. VectorDocumentValue text) (. row text text)))
      )
      (case= .node-value
        (return (call (. VectorDocumentValue node) (. row id)))
      )
      (case= .values-value
        (let values (list VectorDocumentValue))
        (for (in offset (..< 0 count))
          (+= values (call scalar-value ([] (. store values) (+ items offset))))
        )
        (return (call (. VectorDocumentValue values) values))
      )
      (default
        (let ids (list U64))
        (for (in offset (..< 0 count))
          (+= ids (. ([] (. store values) (+ items offset)) id))
        )
        (return (call (. VectorDocumentValue nodes) ids))
      )
    )
  )
  (fn-expr _ value-span Index
    (param row VectorDocumentValueRow)
    (match (. row kind)
      (case? (or (== it .values-value) (== it .nodes-value))
        (+ 1 (. row count))
      )
      (default
        1
      )
    )
  )
  (fn-expr _ scalar-value VectorDocumentValue
    (param row VectorDocumentValueRow)
    (match (. row kind)
      (case= .number-value
        (call (. VectorDocumentValue number) (. row x))
      )
      (case= .point-value
        (call (. VectorDocumentValue point) (call Point (. row x) (. row y)))
      )
      (case= .color-value
        (call (. VectorDocumentValue color) (. row color))
      )
      (case= .node-value
        (call (. VectorDocumentValue node) (. row id))
      )
      (default
        (call (. VectorDocumentValue text) (. row text text))
      )
    )
  )
  (fn-do _ value-row-count Size
    (param value VectorDocumentValue)
    (match value
      (case (call .nodes ids)
        (return (+ (. ids length) 1))
      )
      (case (call .values items)
        (return (+ (. items length) 1))
      )
      (default
        (return 1)
      )
    )
  )
  (fn-do _ write-value Index
    (param index Index)
    (param entry VectorDocumentKeyedValue)
    (let row (call scalar-row (. entry value)))
    (= (. row key) (call (. names store) (. entry key)))
    (let items (list U64))
    (let values (list VectorDocumentValue))
    (match? (. entry value)
      (case (call .nodes ids)
        (= (. row kind) .nodes-value)
        (= (. row count) (as (. ids length) U32))
        (= items ids)
      )
      (case (call .values list)
        (= (. row kind) .values-value)
        (= (. row count) (as (. list length) U32))
        (= values list)
      )
    )
    (= ([] (. store values) index) row)
    (let next (+ index 1))
    (for (in id items)
      (let item (call VectorDocumentValueRow))
      (= (. item key) blank-name)
      (= (. item text) blank-name)
      (= (. item kind) .node-item)
      (= (. item id) id)
      (= ([] (. store values) next) item)
      (+= next 1)
    )
    (for (in value values)
      (= ([] (. store values) next) (call scalar-row value))
      (+= next 1)
    )
    (return next)
  )
  (fn-do _ scalar-row VectorDocumentValueRow
    (param value VectorDocumentValue)
    (let row (call VectorDocumentValueRow))
    (= (. row key) blank-name)
    (= (. row text) blank-name)
    (= (. row kind) .text-value)
    (match? value
      (case (call .number number)
        (= (. row kind) .number-value)
        (= (. row x) number)
      )
      (case (call .point point)
        (= (. row kind) .point-value)
        (= (. row x) (. point x))
        (= (. row y) (. point y))
      )
      (case (call .color color)
        (= (. row kind) .color-value)
        (= (. row color) color)
      )
      (case (call .text text)
        (= (. row text) (call (. names store) text))
      )
      (case (call .node id)
        (= (. row kind) .node-value)
        (= (. row id) id)
      )
    )
    (return row)
  )
  (fn-do _ effect-row _
    (param effect VectorEffect)
    (let row (call VectorDocumentEffect))
    (= (. row enabled) (. effect enabled))
    (match effect
      (case BooleanEffect
        (= (. row kind) .boolean-effect)
        (= (. row mode) (. it mode))
      )
      (case OffsetEffect
        (= (. row kind) .offset-effect)
        (= (. row distance) (. it distance))
        (= (. row join-type) (call vector-document-join-type-code (. it join-type)))
        (= (. row miter-limit) (. it miter-limit))
      )
      (case StrokeEffect
        (= (. row kind) .stroke-effect)
        (= (. row distance) (. it width))
        (= (. row join-type) (call vector-document-join-type-code (. it join-type)))
        (= (. row miter-limit) (. it miter-limit))
        (= (. row cap) (call vector-document-optional-cap (. it cap)))
      )
      (throw (call Panic "Vector documents store boolean, offset, and stroke effects only"))
    )
    (return row)
  )
  (fn-do _ output-path _
    (param index Index)
    (let stored ([] (. store output-paths) index))
    (let result (call Path))
    (let coord (as (. stored coords start) Index))
    (for (in offset (..< 0 (. stored verbs count)))
      (let verb (. ([] (. store output-verbs) (+ (as (. stored verbs start) Index) offset)) verb))
      (match verb
        (case= .path-verb-move
          (call (. result move-to)
            (block
              (call Point
                (block
                  (arg (. ([] (. store output-coords) coord) value))
                  (arg (. ([] (. store output-coords) (+ coord 1)) value))
                )
              )
            )
          )
          (+= coord 2)
        )
        (case= .path-verb-line
          (call (. result line-to)
            (block
              (call Point
                (block
                  (arg (. ([] (. store output-coords) coord) value))
                  (arg (. ([] (. store output-coords) (+ coord 1)) value))
                )
              )
            )
          )
          (+= coord 2)
        )
        (case= .path-verb-cubic
          (call (. result cubic-curve-to)
            (block
              (arg (. ([] (. store output-coords) coord) value))
              (arg (. ([] (. store output-coords) (+ coord 1)) value))
              (arg (. ([] (. store output-coords) (+ coord 2)) value))
              (arg (. ([] (. store output-coords) (+ coord 3)) value))
              (arg (. ([] (. store output-coords) (+ coord 4)) value))
              (arg (. ([] (. store output-coords) (+ coord 5)) value))
            )
          )
          (+= coord 6)
        )
        (case= .path-verb-close
          (call (. result close))
        )
      )
    )
    (= (. result is-closed) (. stored closed))
    (return result)
  )
  (fn-do _ drop-effect-output _
    (param row Index)
    (let output-row (. ([] (. store nodes) row) effect-output))
    (return-if (if (== output-row 0)))
    (blank)
    (let output ([] (. store outputs) (as output-row Index)))
    (+= (. store output-garbage) (as (+ 1 (. output paths count)) Size))
    (for (in index (..< 0 (. output paths count)))
      (let path ([] (. store output-paths) (as (+ (. output paths start) index) Index)))
      (+= (. store output-garbage) (as (+ (as (. path verbs count) Size) (. path coords count)) Size))
    )
    (= (. ([] (. store nodes) row) effect-output) 0)
  )
  (fn-do _ drop-effect-outputs _
    (for (in row (..< 1 (. store nodes length)))
      (= (. ([] (. store nodes) row) effect-output) 0)
    )
    (call (. store outputs truncate) 1)
    (call (. store output-paths truncate) 1)
    (call (. store output-verbs truncate) 1)
    (call (. store output-coords truncate) 1)
    (= (. store output-garbage) 0)
  )
  (fn-do _ maybe-compact _
    (let node-total (. store nodes length))
    (if (and (> (. store node-garbage) vector-document-compaction-floor) (> (* (. store node-garbage) 2) node-total))
      (call compact-nodes)
    )
    (let geometry-rows (+ (. store vertices length) (. store segments length) (. store pairs length)))
    (let paint-rows (+ (. store regions length) (. store fill-layers length) (. store stroke-layers length)))
    (let extent-total (+ geometry-rows paint-rows (. store effects length) (. store values length)))
    (let extent-garbage (. store extent-garbage))
    (if (and (> extent-garbage vector-document-compaction-floor) (> (* extent-garbage 2) extent-total))
      (call compact-extents)
    )
  )
  (fn-do _ compact-nodes _
    (call drop-effect-outputs)
    (call (. scratch nodes copy-from) (. store nodes))
    (call (. remap clear))
    (call (. store nodes truncate) 1)
    (call (. remap append) (call VectorDocumentRowMap))
    (for (in old (..< 1 (. scratch nodes length)))
      (if (!= (. ([] (. scratch nodes) old) kind) .free-node)
        (let fresh (call (. store nodes append) ([] (. scratch nodes) old)))
        (call (. remap append) (call VectorDocumentRowMap (as fresh U32)))
        (else
          (call (. remap append) (call VectorDocumentRowMap))
        )
      )
    )
    (for (in row (..< 1 (. store nodes length)))
      (let node ([] (. store nodes) row))
      (= (. ([] (. store nodes) row) parent) (. ([] remap (as (. node parent) Index)) row))
      (= (. ([] (. store nodes) row) first-child) (. ([] remap (as (. node first-child) Index)) row))
      (= (. ([] (. store nodes) row) last-child) (. ([] remap (as (. node last-child) Index)) row))
      (= (. ([] (. store nodes) row) prev-sibling) (. ([] remap (as (. node prev-sibling) Index)) row))
      (= (. ([] (. store nodes) row) next-sibling) (. ([] remap (as (. node next-sibling) Index)) row))
    )
    (= (. store root) (. ([] remap (as (. store root) Index)) row))
    (= (. store node-garbage) 0)
    (call reset-id-slots (. store id-slots length))
    (call rebuild-chunks)
  )
  (fn-do _ compact-extents _
    (call (. scratch vertices copy-from) (. store vertices))
    (call (. scratch segments copy-from) (. store segments))
    (call (. scratch pairs copy-from) (. store pairs))
    (call (. scratch regions copy-from) (. store regions))
    (call (. scratch fill-layers copy-from) (. store fill-layers))
    (call (. scratch stroke-layers copy-from) (. store stroke-layers))
    (call (. scratch effects copy-from) (. store effects))
    (call (. scratch values copy-from) (. store values))
    (call (. store vertices truncate) 1)
    (call (. store segments truncate) 1)
    (call (. store pairs truncate) 1)
    (call (. store regions truncate) 1)
    (call (. store fill-layers truncate) 1)
    (call (. store stroke-layers truncate) 1)
    (call (. store effects truncate) 1)
    (call (. store values truncate) 1)
    (for (in row (..< 1 (. store nodes length)))
      (let node ([] (. store nodes) row))
      (if (!= (. node kind) .free-node)
        (= (. ([] (. store nodes) row) vertices) (call move-extent (. store vertices) (. scratch vertices) (. node vertices)))
        (= (. ([] (. store nodes) row) segments) (call move-extent (. store segments) (. scratch segments) (. node segments)))
        (= (. ([] (. store nodes) row) pairs) (call move-extent (. store pairs) (. scratch pairs) (. node pairs)))
        (= (. ([] (. store nodes) row) regions) (call move-extent (. store regions) (. scratch regions) (. node regions)))
        (= (. ([] (. store nodes) row) fill-layers)
          (call move-extent
            (block
              (arg (. store fill-layers))
              (arg (. scratch fill-layers))
              (arg (. node fill-layers))
            )
          )
        )
        (= (. ([] (. store nodes) row) stroke-layers)
          (call move-extent
            (block
              (arg (. store stroke-layers))
              (arg (. scratch stroke-layers))
              (arg (. node stroke-layers))
            )
          )
        )
        (= (. ([] (. store nodes) row) effects) (call move-extent (. store effects) (. scratch effects) (. node effects)))
        (= (. ([] (. store nodes) row) settings) (call move-extent (. store values) (. scratch values) (. node settings)))
        (= (. ([] (. store nodes) row) variables) (call move-extent (. store values) (. scratch values) (. node variables)))
      )
    )
    (= (. store extent-garbage) 0)
  )
  (fn-do _ (of move-extent Row) VectorDocumentExtent
    (param target (of Table Row))
    (param source (of Table Row))
    (param extent VectorDocumentExtent)
    (return-if (call VectorDocumentExtent) (if (== (. extent count) 0)))
    (blank)
    (let start (as (. target length) U32))
    (for (in index (..< 0 (. extent count)))
      (call (. target append) (as ([] source (as (+ (. extent start) index) Index)) Row))
    )
    (return (call VectorDocumentExtent start (. extent count) (. extent count)))
  )
  (fn-do _ rebuild-chunks _
    (call (. store chunks clear))
    (while (< (* (. store chunks length) vector-document-chunk-rows) (. store nodes length))
      (call (. store chunks append) (call VectorDocumentChunk))
    )
    (for (in row (..< 1 (. store nodes length)))
      (let node ([] (. store nodes) row))
      (if (!= (. node kind) .free-node)
        (let chunk (/ row vector-document-chunk-rows))
        (let summary (/xor/ (. ([] (. store chunks) chunk) summary) (call vector-document-mix (. node id) (. node stamp))))
        (= (. ([] (. store chunks) chunk) summary) summary)
      )
    )
  )
  (fn-do _ set-chunk-entry _
    (param row Index)
    (param old-id U64)
    (param old-stamp U64)
    (param id U64)
    (param stamp U64)
    (let chunk (/ row vector-document-chunk-rows))
    (let summary (. ([] (. store chunks) chunk) summary))
    (if (!= old-id 0)
      (= summary (/xor/ summary (call vector-document-mix old-id old-stamp)))
    )
    (if (!= id 0)
      (= summary (/xor/ summary (call vector-document-mix id stamp)))
    )
    (= (. ([] (. store chunks) chunk) summary) summary)
  )
  (fn-do _ refresh-all _
    (param row Index)
    (= (. ([] (. store nodes) row) geometry-stamp) (call geometry-hash row))
    (= (. ([] (. store nodes) row) paint-stamp) (call paint-hash row))
    (= (. ([] (. store nodes) row) effects-stamp) (call effects-hash row))
    (= (. ([] (. store nodes) row) values-stamp) (call node-values-hash row))
    (call refresh-stamp row)
  )
  (fn-do _ refresh-values _
    (param row Index)
    (= (. ([] (. store nodes) row) values-stamp) (call node-values-hash row))
    (call refresh-stamp row)
  )
  (fn-do _ refresh-geometry _
    (param row Index)
    (= (. ([] (. store nodes) row) geometry-stamp) (call geometry-hash row))
    (call refresh-stamp row)
  )
  (fn-do _ refresh-paint _
    (param row Index)
    (= (. ([] (. store nodes) row) paint-stamp) (call paint-hash row))
    (call refresh-stamp row)
  )
  (fn-do _ refresh-effects _
    (param row Index)
    (= (. ([] (. store nodes) row) effects-stamp) (call effects-hash row))
    (call refresh-stamp row)
  )
  (fn-do _ refresh-stamp _
    (param row Index)
    (let node ([] (. store nodes) row))
    (let stamp (call node-hash row))
    (return-if (if (== stamp (. node stamp))))
    (blank)
    (call set-chunk-entry row (. node id) (. node stamp) (. node id) stamp)
    (= (. ([] (. store nodes) row) stamp) stamp)
  )
  (fn-do + mix-number _
    (param hash U64)
    (param value F64)
    (= ([] bits 0) value)
    (return (call vector-document-mix hash ([] (as bits (of CPointer U64)) 0)))
  )
  (fn-expr _ mix-point _
    (param hash U64)
    (param value Point)
    (call mix-number (call mix-number hash (. value x)) (. value y))
  )
  (fn-do _ mix-rect _
    (param hash U64)
    (param value Rect)
    (let result (call mix-number hash (. value x)))
    (= result (call mix-number result (. value y)))
    (= result (call mix-number result (. value width)))
    (return (call mix-number result (. value height)))
  )
  (fn-do _ mix-color _
    (param hash U64)
    (param value RGBA)
    (let result (call mix-number hash (. value red)))
    (= result (call mix-number result (. value green)))
    (= result (call mix-number result (. value blue)))
    (return (call mix-number result (. value alpha)))
  )
  (fn-expr _ mix-bool _
    (param hash U64)
    (param value Bool)
    (call vector-document-mix hash (if-expr value 1u64 2u64))
  )
  (fn-do _ geometry-hash _
    (param row Index)
    (let node ([] (. store nodes) row))
    (let result (call vector-document-mix vector-document-seed (. node kind)))
    (= result (call vector-document-mix result (call hash-for (. node image text))))
    (let vertices (. node vertices))
    (= result (call vector-document-mix result (. vertices count)))
    (for (in index (..< (. vertices start) (+ (. vertices start) (. vertices count))))
      (let vertex ([] (. store vertices) (as index Index)))
      (= result (call mix-point (call vector-document-mix result (. vertex id)) (. vertex position)))
    )
    (let segments (. node segments))
    (= result (call vector-document-mix result (. segments count)))
    (for (in index (..< (. segments start) (+ (. segments start) (. segments count))))
      (let segment ([] (. store segments) (as index Index)))
      (= result (call vector-document-mix result (. segment id)))
      (= result (call vector-document-mix result (. segment start)))
      (= result (call vector-document-mix result (. segment end)))
      (= result (call mix-point result (. segment tangent-start)))
      (= result (call mix-point result (. segment tangent-end)))
      (= result (call vector-document-mix result (. segment source)))
      (= result (call mix-number result (. segment source-start)))
      (= result (call mix-number result (. segment source-end)))
    )
    (let pairs (. node pairs))
    (= result (call vector-document-mix result (. pairs count)))
    (for (in index (..< (. pairs start) (+ (. pairs start) (. pairs count))))
      (let pair ([] (. store pairs) (as index Index)))
      (= result (call vector-document-mix result (. pair first-segment)))
      (= result (call mix-bool result (. pair first-at-end)))
      (= result (call vector-document-mix result (. pair second-segment)))
      (= result (call mix-bool result (. pair second-at-end)))
      (= result (call mix-bool result (. pair mirror-length)))
    )
    (= result (call vector-document-mix result (. node next-vertex)))
    (return (call vector-document-mix result (. node next-segment)))
  )
  (fn-do _ paint-hash _
    (param row Index)
    (let node ([] (. store nodes) row))
    (let result (call vector-document-mix vector-document-seed (. node paint-authored)))
    (= result (call vector-document-mix result (. node fill-kind)))
    (= result (call vector-document-mix result (. node stroke-kind)))
    (= result (call mix-color result (. node fill-color)))
    (= result (call mix-color result (. node stroke-color)))
    (let fill-layers (. node fill-layers))
    (= result (call vector-document-mix result (. fill-layers count)))
    (for (in index (..< (. fill-layers start) (+ (. fill-layers start) (. fill-layers count))))
      (let layer ([] (. store fill-layers) (as index Index)))
      (= result (call mix-bool (call mix-color result (. layer color)) (. layer visible)))
    )
    (let stroke-layers (. node stroke-layers))
    (= result (call vector-document-mix result (. stroke-layers count)))
    (for (in index (..< (. stroke-layers start) (+ (. stroke-layers start) (. stroke-layers count))))
      (let layer ([] (. store stroke-layers) (as index Index)))
      (= result (call mix-bool (call mix-color result (. layer color)) (. layer visible)))
      (= result (call mix-bool (call mix-number result (. layer width)) (. layer has-width)))
      (= result (call vector-document-mix result (. layer alignment)))
      (= result (call vector-document-mix result (. layer join)))
      (= result (call vector-document-mix result (. layer cap)))
    )
    (= result (call mix-bool (call mix-number result (. node stroke-width)) (. node has-stroke-width)))
    (= result (call vector-document-mix result (. node stroke-alignment)))
    (= result (call vector-document-mix result (. node stroke-cap)))
    (= result (call vector-document-mix result (. node stroke-join)))
    (= result (call vector-document-mix result (. node fill-rule)))
    (let regions (. node regions))
    (= result (call vector-document-mix result (. regions count)))
    (for (in index (..< (. regions start) (+ (. regions start) (. regions count))))
      (let fill ([] (. store regions) (as index Index)))
      (= result (call vector-document-mix result (. fill region)))
      (= result (call mix-bool (call mix-color result (. fill fill)) (. fill has-fill)))
      (= result (call mix-bool result (. fill conflict)))
    )
