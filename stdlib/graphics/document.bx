  (fn-do _ effects-hash _
    (param row Index)
    (let node ([] (. store nodes) row))
    (let authored (/and/ (. node composite-authored) vector-document-authored-effects))
    (let result (call vector-document-mix vector-document-seed authored))
    (let effects (. node effects))
    (= result (call vector-document-mix result (. effects count)))
    (for (in index (..< (. effects start) (+ (. effects start) (. effects count))))
      (let effect ([] (. store effects) (as index Index)))
      (= result (call vector-document-mix result (. effect kind)))
      (= result (call mix-bool result (. effect enabled)))
      (= result (call vector-document-mix result (. effect mode)))
      (= result (call mix-number result (. effect distance)))
      (= result (call vector-document-mix result (. effect join-type)))
      (= result (call mix-number result (. effect miter-limit)))
      (= result (call vector-document-mix result (. effect cap)))
    )
    (return result)
  )
  (fn-do _ values-hash _
    (param extent VectorDocumentExtent)
    (let result (call vector-document-mix vector-document-seed (. extent count)))
    (for (in index (..< (. extent start) (+ (. extent start) (. extent count))))
      (let row (as ([] (. store values) (as index Index)) VectorDocumentValueRow))
      (= result (call vector-document-mix result (call hash-for (. row key text))))
      (= result (call vector-document-mix result (. row kind)))
      (= result (call mix-number (call mix-number result (. row x)) (. row y)))
      (= result (call mix-color result (. row color)))
      (= result (call vector-document-mix result (call hash-for (. row text text))))
      (= result (call vector-document-mix (call vector-document-mix result (. row id)) (. row count)))
    )
    (return result)
  )
  (fn-expr _ node-values-hash _
    (param row Index)
    (call vector-document-mix (call values-hash (. node settings)) (call values-hash (. node variables)))
    (where
      (lazy node ([] (. store nodes) row))
    )
  )
  (fn-do _ node-hash _
    (param row Index)
    (let node ([] (. store nodes) row))
    (let result (call vector-document-mix vector-document-seed (. node id)))
    (= result (call vector-document-mix result (. node kind)))
    (= result (call vector-document-mix result (. node group-kind)))
    (= result (call vector-document-mix result (. node flags)))
    (= result (call vector-document-mix result (. node composite-authored)))
    (= result (call vector-document-mix result (call hash-for (. node name text))))
    (= result (call mix-number result (. node opacity)))
    (let matrix (. node transform))
    (= result (call mix-number (call mix-number (call mix-number result (. matrix a)) (. matrix b)) (. matrix c)))
    (= result (call mix-number (call mix-number (call mix-number result (. matrix d)) (. matrix tx)) (. matrix ty)))
    (= result (call mix-number result (. node rotation)))
    (= result (call mix-point result (. node pivot)))
    (= result (call mix-rect result (. node view-box)))
    (= result (call vector-document-mix result (. node geometry-stamp)))
    (= result (call vector-document-mix result (. node paint-stamp)))
    (= result (call vector-document-mix result (. node effects-stamp)))
    (= result (call vector-document-mix result (. node values-stamp)))
    (let child (. node first-child))
    (while (!= child 0)
      (= result (call vector-document-mix result (. ([] (. store nodes) (as child Index)) id)))
      (= child (. ([] (. store nodes) (as child Index)) next-sibling))
    )
    (return (/or/ result 1))
  )
  (fn-do + snapshot _
    (call settle)
    (let result (call VectorDocumentSnapshot))
    (call (. result store copy-from) store)
    (return result)
  )
  (fn-do + snapshot-into _
    (param target VectorDocumentSnapshot)
    (call settle)
    (if (> (. target store byte-count) reclaim-limit)
      (call (. target store release))
      (= (. target store) (call VectorDocumentStore))
    )
    (call (. target store copy-from) store)
  )
  (fn-do + restore _
    (param source VectorDocumentSnapshot)
    (for (in id pending)
      (-= ([] networks id))
    )
    (= pending (call (of List U64)))
    (let issued (. store next-id))
    (call (. store copy-from) (. source store))
    (call reserve-id issued)
    (+= structure-revision 1)
  )
)

(fn-do _ region-fill-for _
  (param fills (list NetworkRegionAppearance))
  (param region Index)
  (for (in fill fills)
    (return-if fill (if (== (. fill region) region)))
  )
  (return (call NetworkRegionAppearance region null))
)

(fn-expr _ (of table-bytes Row) Size
  (param table (of Table Row))
  (* (. table length) (. Row size))
)

(fn-expr _ is-identity _
  (param matrix Matrix)
  (and (== (. matrix a) 1) (== (. matrix b) 0) (== (. matrix c) 0) (== (. matrix d) 1) (== (. matrix tx) 0) (== (. matrix ty) 0))
)

(type + VectorDocumentChanges
  (prop + changed (list U64))
  (prop + removed (list U64))
  (prop + scanned-chunks Size)
  (prop + scanned-rows Size)
)

(type + VectorDocumentChangeTracker
  (prop _ summaries (list U64))
  (prop _ row-ids (list U64))
  (prop _ row-stamps (list U64))
  (prop _ stamps (of Map U64 U64))
  (fn-expr + stamp-of (? U64)
    (param id U64)
    ([] stamps id)
  )
  (fn-do + scan _
    (param document VectorDocument)
    (call (. document settle))
    (let result (call VectorDocumentChanges))
    (let chunk-count (. document chunk-count))
    (let row-capacity (. document row-capacity))
    (let departed (list U64))
    (for (in chunk (..< 0 chunk-count))
      (let summary (call (. document chunk-summary) chunk))
      (let first (* chunk vector-document-chunk-rows))
      (let last (call min (+ first vector-document-chunk-rows) row-capacity))
      (if (and (< chunk (. summaries length)) (== ([] summaries chunk) summary) (>= (. row-ids length) last))
        (continue)
      )
      (+= (. result scanned-chunks) 1)
      (for (in row (..< first last))
        (+= (. result scanned-rows) 1)
        (let id (call (. document row-id) row))
        (let stamp (if-expr (!= id 0) (call (. document row-stamp) row) 0u64))
        (while (<= (. row-ids length) row)
          (+= row-ids 0)
          (+= row-stamps 0)
        )
        (let previous-id ([] row-ids row))
        (if (and (!= previous-id 0) (!= previous-id id))
          (+= departed previous-id)
        )
        (if (and (!= id 0) (!= ([] stamps id) stamp))
          (= ([] stamps id) stamp)
          (+= (. result changed) id)
        )
        (= ([] row-ids row) id)
        (= ([] row-stamps row) stamp)
      )
      (while (<= (. summaries length) chunk)
        (+= summaries 0)
      )
      (= ([] summaries chunk) summary)
    )
    (if (> (. row-ids length) row-capacity)
      (for (in row (..< row-capacity (. row-ids length)))
        (if (!= ([] row-ids row) 0)
          (+= departed ([] row-ids row))
        )
      )
      (-= ([] row-ids (..< row-capacity (. row-ids length))))
      (-= ([] row-stamps (..< row-capacity (. row-stamps length))))
    )
    (if (> (. summaries length) chunk-count)
      (-= ([] summaries (..< chunk-count (. summaries length))))
    )
    (for (in id departed)
      (if (and (not (call (. document contains) id)) (!= ([] stamps id) null))
        (-= ([] stamps id))
        (+= (. result removed) id)
      )
    )
    (return result)
  )
)

(fn-expr _ vector-document-row _
  (param document VectorDocument)
  (param id U64)
  (before
    (throw (call Panic "The vector document was released") (if (. document released)))
    (throw (call Panic (str "Unknown vector document id " id)) (if (== row 0)))
  )
  row
  (where
    (lazy row (call vector-document-find-row (. document store) id))
  )
)

(fn-do _ vector-document-find-row _
  (param source VectorDocumentStore)
  (param id U64)
  (return-if 0 (if (== id 0)))
  (blank)
  (let mask (- (. source id-slots length) 1))
  (let slot (/and/ (as (call vector-document-mix vector-document-seed id) Index) mask))
  (while true
    (let entry-id (. ([] (. source id-slots) slot) id))
    (return-if 0 (if (== entry-id 0)))
    (return-if (. ([] (. source id-slots) slot) row) (if (== entry-id id)))
    (blank)
    (= slot (/and/ (+ slot 1) mask))
  )
  (return 0)
)

(type _ VectorDocumentNetwork (is Tuple)
  (prop + revision U64)
  (prop + network VectorNetwork)
)

(fn-do _ vector-document-network VectorNetwork
  (param source VectorDocumentStore)
  (param row Index)
  (let node ([] (. source nodes) row))
  (let vertex-list (list NetworkVertex))
  (for (in index (..< 0 (. node vertices count)))
    (let vertex ([] (. source vertices) (as (+ (. node vertices start) index) Index)))
    (+= vertex-list (call NetworkVertex (as (. vertex id) Index) (. vertex position)))
  )
  (let segment-list (list NetworkSegment))
  (for (in index (..< 0 (. node segments count)))
    (let segment ([] (. source segments) (as (+ (. node segments start) index) Index)))
    (+= segment-list
      (call NetworkSegment
        (block
          (arg (as (. segment id) Index))
          (arg (as (. segment start) Index))
          (arg (as (. segment end) Index))
          (arg (. segment tangent-start))
          (arg (. segment tangent-end))
          (arg (as (. segment source) Index))
          (arg (. segment source-start))
          (arg (. segment source-end))
        )
      )
    )
  )
  (let pair-list (list NetworkPair))
  (for (in index (..< 0 (. node pairs count)))
    (let pair ([] (. source pairs) (as (+ (. node pairs start) index) Index)))
    (+= pair-list
      (call NetworkPair
        (block
          (arg (call NetworkEnd (as (. pair first-segment) Index) (. pair first-at-end)))
          (arg (call NetworkEnd (as (. pair second-segment) Index) (. pair second-at-end)))
          (arg (. pair mirror-length))
        )
      )
    )
  )
  (let result (call VectorNetwork vertex-list segment-list pair-list))
  (call (. result reserve-ids) (as (. node next-vertex) Index) (as (. node next-segment) Index))
  (return result)
)

(fn-do _ vector-document-settle-bounds _
  (param source VectorDocumentStore)
  (param row Index)
  (if (. ([] (. source nodes) row) bounds-stale)
    (= (. ([] (. source nodes) row) geometry-bounds) (call (. (call vector-document-network source row) geometry-bounds)))
    (= (. ([] (. source nodes) row) bounds-stale) false)
  )
)

(type + VectorDocumentTraversal (is Tuple)
  (implements (of CursorIterable U64 (tuple Index Index)))
  (prop _ document VectorDocument)
  (prop _ parent U64)
  (prop _ recursive Bool)
  (fn-do + This _
    (param document _)
    (param parent _)
    (param recursive _)
  )
  (fn-expr + initial-iterator-state (tuple Index Index) :get
    (tuple (as (. ([] (. document store nodes) row) first-child) Index) row)
    (where
      (lazy row (call vector-document-row document parent))
    )
  )
  (fn-do + next-iterator (tuple (tuple Index Index) (? U64))
    (param state (tuple Index Index))
    (let row ([] state 0))
    (return-if (tuple state null) (if (== row 0)))
    (blank)
    (let nodes (. document store nodes))
    (let next (if-expr recursive (. ([] nodes row) first-child) 0u32))
    (if (== next 0)
      (let ancestor row)
      (while (!= ancestor ([] state 1))
        (= next (. ([] nodes ancestor) next-sibling))
        (if (or (!= next 0) (not recursive))
          (break)
        )
        (= ancestor (. ([] nodes ancestor) parent))
      )
    )
    (return (tuple (tuple (as next Index) ([] state 1)) (. ([] nodes row) id)))
  )
)
