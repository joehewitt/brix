(import ./appearance)
(import ./boolean)
(import ./color)
(import ./document-rows)
(import ./effect)
(import ./matrix)
(import ./network)
(import ./network-graphic)
(import ./network-regions)
(import ./offset)
(import ./path)
(import ./point)
(import ./primitives)
(import ./snapshottable)
(import ./stroke)
(import ./style)
(import /core/arena)
(import /core/atom-pool)
(import /core/map)
(import /core/table)
(import /math)
(import /units)
(blank)
(prop + vector-document-chunk-rows Size (= 64))
(prop + vector-document-script-id-bit U64 (= 9223372036854775808u64))
(prop _ vector-document-seed U64 (= 7640891576956012809u64))
(prop _ vector-document-revision-seed U64 (= 11400714819323198485u64))
(prop _ vector-document-minimum-capacity U32 (= 4))
(prop _ vector-document-compaction-floor Size (= 256))
(prop + vector-document-reclaim-floor Size (= 1048576))
(prop + vector-document-reclaim-factor Size (= 4))

(fn-do + vector-document-mix _
  (param hash U64)
  (param value U64)
  (let mixed (* (/xor/ hash value) 11400714819323198485))
  (= mixed (/xor/ mixed (/rshift/ mixed 32)))
  (= mixed (* mixed 15444337377436638099))
  (return (/xor/ mixed (/rshift/ mixed 29)))
)

(fn-do + vector-document-loop-id U64
  (param id U64)
  (param passes (list Index))
  (let hash (call vector-document-mix vector-document-seed id))
  (= hash (call vector-document-mix hash (as (. passes length) U64)))
  (for (in pass passes)
    (= hash (call vector-document-mix hash (as pass U64)))
  )
  (return (/or/ hash vector-document-script-id-bit))
)

(type + VectorDocumentValue (is Union)
  (variant number F64)
  (variant point Point)
  (variant color RGBA)
  (variant text String)
  (variant node U64)
  (variant nodes (list U64))
  (variant values (list VectorDocumentValue))
)

(type + VectorDocumentKeyedValue (is Tuple)
  (prop + key String)
  (prop + value VectorDocumentValue)
)

(type + VectorDocumentRowMap (is Struct)
  (prop + row U32)
)

(type + VectorDocumentStore
  (implements (of Usable Void))
  (prop _ arena Arena)
  (prop + nodes (of Table VectorDocumentNode))
  (prop + vertices (of Table VectorDocumentVertex))
  (prop + segments (of Table VectorDocumentSegment))
  (prop + pairs (of Table VectorDocumentPair))
  (prop + regions (of Table VectorDocumentRegionFill))
  (prop + fill-layers (of Table VectorDocumentFillLayer))
  (prop + stroke-layers (of Table VectorDocumentStrokeLayer))
  (prop + effects (of Table VectorDocumentEffect))
  (prop + values (of Table VectorDocumentValueRow))
  (prop + outputs (of Table VectorDocumentEffectOutput))
  (prop + output-paths (of Table VectorDocumentOutputPath))
  (prop + output-verbs (of Table VectorDocumentPathVerb))
  (prop + output-coords (of Table VectorDocumentPathCoord))
  (prop + id-slots (of Table VectorDocumentIdSlot))
  (prop + chunks (of Table VectorDocumentChunk))
  (prop + next-id U64 (= 1))
  (prop + root U32)
  (prop + live-nodes Size)
  (prop + node-garbage Size)
  (prop + extent-garbage Size)
  (prop + output-garbage Size)
  (fn-do + This _
    (lazy nodes (call (of Table VectorDocumentNode) arena 16))
    (lazy vertices (call (of Table VectorDocumentVertex) arena 64))
    (lazy segments (call (of Table VectorDocumentSegment) arena 64))
    (lazy pairs (call (of Table VectorDocumentPair) arena 16))
    (lazy regions (call (of Table VectorDocumentRegionFill) arena 16))
    (lazy fill-layers (call (of Table VectorDocumentFillLayer) arena 16))
    (lazy stroke-layers (call (of Table VectorDocumentStrokeLayer) arena 16))
    (lazy effects (call (of Table VectorDocumentEffect) arena 16))
    (lazy values (call (of Table VectorDocumentValueRow) arena 4))
    (lazy outputs (call (of Table VectorDocumentEffectOutput) arena 16))
    (lazy output-paths (call (of Table VectorDocumentOutputPath) arena 16))
    (lazy output-verbs (call (of Table VectorDocumentPathVerb) arena 64))
    (lazy output-coords (call (of Table VectorDocumentPathCoord) arena 64))
    (lazy id-slots (call (of Table VectorDocumentIdSlot) arena 16))
    (lazy chunks (call (of Table VectorDocumentChunk) arena 4))
  )
  (fn-expr + byte-count _ :get
    (. arena active-bytes)
  )
  (fn-expr + live-bytes Size :get
    (+ (call table-bytes nodes) network-bytes paint-bytes effect-bytes output-bytes index-bytes)
    (where
      (lazy network-bytes (+ (call table-bytes vertices) (call table-bytes segments) (call table-bytes pairs)))
      (lazy paint-bytes (+ (call table-bytes regions) (call table-bytes fill-layers) (call table-bytes stroke-layers)))
      (lazy effect-bytes (+ (call table-bytes effects) (call table-bytes values) (call table-bytes outputs)))
      (lazy output-bytes (+ (call table-bytes output-paths) (call table-bytes output-verbs) (call table-bytes output-coords)))
      (lazy index-bytes (+ (call table-bytes id-slots) (call table-bytes chunks)))
    )
  )
  (fn-expr + row-count Size :get
    (+ (. nodes length) network-rows paint-rows effect-rows output-rows index-rows)
    (where
      (lazy network-rows (+ (. vertices length) (. segments length) (. pairs length)))
      (lazy paint-rows (+ (. regions length) (. fill-layers length) (. stroke-layers length)))
      (lazy effect-rows (+ (. effects length) (. values length) (. outputs length)))
      (lazy output-rows (+ (. output-paths length) (. output-verbs length) (. output-coords length)))
      (lazy index-rows (+ (. id-slots length) (. chunks length)))
    )
  )
  (fn-do + copy-from _
    (param source VectorDocumentStore)
    (call (. nodes copy-from) (. source nodes))
    (call (. vertices copy-from) (. source vertices))
    (call (. segments copy-from) (. source segments))
    (call (. pairs copy-from) (. source pairs))
    (call (. regions copy-from) (. source regions))
    (call (. fill-layers copy-from) (. source fill-layers))
    (call (. stroke-layers copy-from) (. source stroke-layers))
    (call (. effects copy-from) (. source effects))
    (call (. values copy-from) (. source values))
    (call (. outputs copy-from) (. source outputs))
    (call (. output-paths copy-from) (. source output-paths))
    (call (. output-verbs copy-from) (. source output-verbs))
    (call (. output-coords copy-from) (. source output-coords))
    (call (. id-slots copy-from) (. source id-slots))
    (call (. chunks copy-from) (. source chunks))
    (= next-id (. source next-id))
    (= root (. source root))
    (= live-nodes (. source live-nodes))
    (= node-garbage (. source node-garbage))
    (= extent-garbage (. source extent-garbage))
    (= output-garbage (. source output-garbage))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (call (. arena release))
  )
)

(type + VectorDocumentSnapshot
  (implements (of Usable Void))
  (prop + store _ (= (call VectorDocumentStore)))
  (fn-expr + byte-count _ :get
    (. store byte-count)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (call (. store release))
  )
)

(type + VectorDocument
  (implements (of Usable Void))
  (implements (of Snapshottable VectorDocumentSnapshot))
  (prop + store _ (= (call VectorDocumentStore)))
  (prop _ scratch _ (= (call VectorDocumentStore)))
  (prop _ names _ (= (call AtomPool)))
  (prop + reclaim-floor Size (= vector-document-reclaim-floor))
  (prop + reclaims Size)
  (prop + structure-revision U64)
  (prop + released _ (= false))
  (prop _ work Arena)
  (prop _ bits (of CPointer F64) (= (call (of (. work allocate) F64) 1)))
  (prop _ remap _ (= (call (of Table VectorDocumentRowMap) work 16)))
  (prop _ blank-name Atom (= (call (. names store) "")))
  (prop _ copy-cursor Size)
  (prop _ networks (of Map U64 VectorDocumentNetwork))
  (prop _ pending (list U64))
  (prop _ network-clock U64)
  (fn-do + This _
    (param root-id U64 (= 0))
    (call initialize root-id)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (return-if (if released))
    (blank)
    (= released true)
    (call (. store release))
    (call (. scratch release))
    (call (. names release))
    (call (. work release))
  )
  (fn-expr + root _ :get
    (before
      (throw (call Panic "The vector document was released") (if released))
    )
    (. ([] (. store nodes) (as (. store root) Index)) id)
  )
  (fn-expr + next-id _ :get
    (. store next-id)
  )
  (fn-do + reserve-id _
    (param next U64)
    (if (and (== (/and/ next vector-document-script-id-bit) 0) (> next (. store next-id)))
      (= (. store next-id) next)
    )
  )
  (fn-expr + node-count _ :get
    (. store live-nodes)
  )
  (fn-expr + contains _
    (param id U64)
    (!= (call find-row id) 0)
  )
  (fn-expr + kind _
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) kind)
  )
  (fn-expr + is-group _
    (param id U64)
    (== (call kind id) .group-node)
  )
  (fn-expr + is-network _
    (param id U64)
    (== (call kind id) .network-node)
  )
  (fn-expr + is-image _
    (param id U64)
    (== (call kind id) .image-node)
  )
  (fn-expr + image String
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) image text)
  )
  (fn-do + stamp _
    (param id U64)
    (call settle-node id)
    (return (. ([] (. store nodes) (call row-of id)) stamp))
  )
  (fn-do + subtree-stamp _
    (param id U64)
    (call settle)
    (return (call subtree-hash (call row-of id)))
  )
  (fn-do + geometry-stamp _
    (param id U64)
    (call settle-node id)
    (return (. ([] (. store nodes) (call row-of id)) geometry-stamp))
  )
  (fn-expr + paint-stamp _
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) paint-stamp)
  )
  (fn-expr + effects-stamp _
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) effects-stamp)
  )
  (fn-expr + parent _
    (param id U64)
    (if-expr (== parent-row 0) 0u64 (. ([] (. store nodes) (as parent-row Index)) id))
    (where
      (lazy parent-row (. ([] (. store nodes) (call row-of id)) parent))
    )
  )
  (fn-expr + children _
    (param id U64)
    (call VectorDocumentTraversal this id false)
  )
  (fn-do + child-count _
    (param id U64)
    (let count Size)
    (let child (. ([] (. store nodes) (call row-of id)) first-child))
    (while (!= child 0)
      (+= count 1)
      (= child (. ([] (. store nodes) (as child Index)) next-sibling))
    )
    (return count)
  )
  (fn-expr + descendants _
    (param id U64)
    (call VectorDocumentTraversal this id true)
  )
  (fn-expr + name _
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) name text)
  )
  (fn-expr + locked _
    (param id U64)
    (!= (/and/ (. ([] (. store nodes) (call row-of id)) flags) vector-document-locked) 0)
  )
  (fn-expr + visible _
    (param id U64)
    (== (/and/ (. ([] (. store nodes) (call row-of id)) flags) vector-document-hidden) 0)
  )
  (fn-expr + guide _
    (param id U64)
    (!= (/and/ (. ([] (. store nodes) (call row-of id)) flags) vector-document-guide) 0)
  )
  (fn-expr + renders _
    (param id U64)
    (== (/and/ (. ([] (. store nodes) (call row-of id)) flags) (/or/ vector-document-hidden vector-document-guide)) 0)
  )
  (fn-expr + composite-authored _
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) composite-authored)
  )
  (fn-expr + paint-authored _
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) paint-authored)
  )
  (fn-expr + opacity Ratio
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) opacity)
  )
  (fn-expr + transform _
    (param id U64)
    (call row-transform (call row-of id))
  )
  (fn-expr + row-transform _
    (param row Index)
    (case? (== (/and/ (. node composite-authored) vector-document-authored-transform) 0)
      null
    )
    (case? (call is-identity (. node transform))
      null
    )
    (default
      (. node transform)
    )
    (where
      (lazy node ([] (. store nodes) row))
    )
  )
  (fn-do + world-transform _
    (param id U64)
    (let result (? Matrix))
    (let row (call row-of id))
    (while (!= row 0)
      (let node ([] (. store nodes) row))
      (let authored (!= (/and/ (. node composite-authored) vector-document-authored-transform) 0))
      (if (and authored (not (call is-identity (. node transform))))
        (= result (if-expr result (call (. node transform concatenate) result) (. node transform)))
      )
      (= row (. node parent))
    )
    (return result)
  )
  (fn-expr + parent-transform _
    (param id U64)
    (if-expr (== owner 0) null (call world-transform owner))
    (where
      (lazy owner (call parent id))
    )
  )
  (fn-expr + rotation _
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) rotation)
  )
  (fn-expr + pivot (? Point)
    (param id U64)
    (if-expr (== (/and/ (. node flags) vector-document-has-pivot) 0) null (. node pivot))
    (where
      (lazy node ([] (. store nodes) (call row-of id)))
    )
  )
  (fn-expr + view-box _
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) view-box)
  )
  (fn-expr + group-kind _
    (param id U64)
    (. ([] (. store nodes) (call row-of id)) group-kind)
  )
  (fn-do + geometry-bounds _
    (param id U64)
    (call settle-node id)
    (let row (call row-of id))
    (call vector-document-settle-bounds store row)
    (return (. ([] (. store nodes) row) geometry-bounds))
  )
  (fn-expr + fill _
    (param id U64)
    (call row-fill (call row-of id))
  )
  (fn-do + row-fill _
    (param row Index)
    (let node ([] (. store nodes) row))
    (return-if null (if (== (/and/ (. node paint-authored) vector-document-authored-fill) 0)))
    (return-if (. Fill inherit) (if (== (. node fill-kind) .fill-inherit)))
    (return-if (. Fill none) (if (== (. node fill-kind) .fill-none)))
    (return-if (. Fill stroke) (if (== (. node fill-kind) .fill-from-stroke)))
    (return-if (. node fill-color) (if (== (. node fill-kind) .fill-color)))
    (blank)
    (let layers (list FillLayer))
    (let extent (. node fill-layers))
    (for (in index (..< 0 (. extent count)))
      (let layer ([] (. store fill-layers) (as (+ (. extent start) index) Index)))
      (+= layers (call FillLayer (. layer color) (. layer visible)))
    )
    (return (call FillStack layers))
  )
  (fn-expr + stroke _
    (param id U64)
    (call row-stroke (call row-of id))
  )
  (fn-do + row-stroke _
    (param row Index)
    (let node ([] (. store nodes) row))
    (return-if null (if (== (/and/ (. node paint-authored) vector-document-authored-stroke) 0)))
    (return-if (. Stroke inherit) (if (== (. node stroke-kind) .stroke-inherit)))
    (return-if (. Stroke none) (if (== (. node stroke-kind) .stroke-none)))
    (return-if (. node stroke-color) (if (== (. node stroke-kind) .stroke-color)))
    (blank)
    (let layers (list StrokeLayer))
    (let extent (. node stroke-layers))
    (for (in index (..< 0 (. extent count)))
      (let layer ([] (. store stroke-layers) (as (+ (. extent start) index) Index)))
      (let width (? Length) (only-if (. layer width) (if (. layer has-width))))
      (+= layers
        (call StrokeLayer
          (block
            (arg (. layer color))
            (arg width)
            (arg (call vector-document-alignment (. layer alignment)))
            (arg (call vector-document-join (. layer join)))
            (arg (call vector-document-cap (. layer cap)))
            (arg (. layer visible))
          )
        )
      )
    )
    (return (call StrokeStack layers))
  )
  (fn-expr + stroke-width (? Length)
    (param id U64)
    (if-expr (not (. node has-stroke-width)) null (. node stroke-width))
    (where
      (lazy node ([] (. store nodes) (call row-of id)))
    )
  )
  (fn-expr + stroke-alignment _
    (param id U64)
    (call vector-document-alignment (. ([] (. store nodes) (call row-of id)) stroke-alignment))
  )
  (fn-expr + stroke-cap _
    (param id U64)
    (call vector-document-cap (. ([] (. store nodes) (call row-of id)) stroke-cap))
  )
  (fn-expr + stroke-join _
    (param id U64)
    (call vector-document-join (. ([] (. store nodes) (call row-of id)) stroke-join))
  )
  (fn-expr + fill-rule _
    (param id U64)
    (call vector-document-fill-rule (. ([] (. store nodes) (call row-of id)) fill-rule))
  )
  (fn-expr + effects _
    (param id U64)
    (call row-effects (call row-of id))
  )
  (fn-do + row-effects _
    (param row Index)
    (let extent (. ([] (. store nodes) row) effects))
    (let result (list VectorEffect))
    (for (in index (..< 0 (. extent count)))
      (let effect ([] (. store effects) (as (+ (. extent start) index) Index)))
      (let value VectorEffect
        (match (. effect kind)
          (case= .boolean-effect
            (call BooleanEffect (. effect mode))
          )
          (case= .stroke-effect
            (call StrokeEffect
              (block
                (arg (. effect distance))
                (arg (call vector-document-join-type (. effect join-type)))
                (arg (?? (call vector-document-cap (. effect cap)) (. LineCap round)))
                (arg (. effect miter-limit))
              )
            )
          )
          (default
            (call OffsetEffect
              (block
                (arg (. effect distance))
                (arg (call vector-document-join-type (. effect join-type)))
                (arg (. effect miter-limit))
              )
            )
          )
        )
      )
      (= (. value enabled) (. effect enabled))
      (+= result value)
    )
    (return (call VectorEffects result))
  )
  (fn-do + region-fills _
    (param id U64)
    (let extent (. ([] (. store nodes) (call row-of id)) regions))
    (let result (list NetworkRegionAppearance))
    (for (in index (..< 0 (. extent count)))
      (let fill ([] (. store regions) (as (+ (. extent start) index) Index)))
      (let color (? RGBA) (only-if (. fill fill) (if (. fill has-fill))))
      (+= result (call NetworkRegionAppearance (as (. fill region) Index) color (. fill conflict)))
    )
    (return result)
  )
  (fn-do + vertex-rows _
    (param id U64)
    (call settle-node id)
    (let extent (. ([] (. store nodes) (call row-of id)) vertices))
    (let start (as (. extent start) Index))
    (return ([] (. store vertices) (..< start (+ start (as (. extent count) Index)))))
  )
  (fn-do + segment-rows _
    (param id U64)
    (call settle-node id)
    (let extent (. ([] (. store nodes) (call row-of id)) segments))
    (let start (as (. extent start) Index))
    (return ([] (. store segments) (..< start (+ start (as (. extent count) Index)))))
  )
  (fn-do + pair-rows _
    (param id U64)
    (call settle-node id)
    (let extent (. ([] (. store nodes) (call row-of id)) pairs))
    (let start (as (. extent start) Index))
    (return ([] (. store pairs) (..< start (+ start (as (. extent count) Index)))))
  )
  (fn-expr + network _
    (param id U64)
    (call (. (call shared-network id) copy))
  )
  (fn-expr + shared-network _
    (param id U64)
    (. (call network-entry id) network)
  )
  (fn-expr + network-revision _
    (param id U64)
    (if-expr (. ([] (. store nodes) row) network-pending) (. (!! ([] networks id)) revision) (. ([] (. store nodes) row) geometry-stamp))
    (where
      (lazy row (call row-of id))
    )
  )
  (fn-do _ network-entry VectorDocumentNetwork
    (param id U64)
    (let row (call row-of id))
    (let cached ([] networks id))
    (return-if (!! cached) (if (. ([] (. store nodes) row) network-pending)))
    (blank)
    (let stamp (. ([] (. store nodes) row) geometry-stamp))
    (return-if cached (if (and cached (== (. cached revision) stamp))))
    (blank)
    (let created (call VectorDocumentNetwork stamp (call vector-document-network store row)))
    (call keep-network id created)
    (return created)
  )
  (fn-do _ keep-network _
    (param id U64)
    (param entry VectorDocumentNetwork)
    (if (> (. networks length) (+ (* (. store live-nodes) 2) 64))
      (let kept (call (of Map U64 VectorDocumentNetwork)))
      (for (in item (. networks items))
        (let row (call vector-document-find-row store (. item key)))
        (if (!= row 0)
          (let node ([] (. store nodes) row))
          (if (or (. node network-pending) (== (. node geometry-stamp) (. item value revision)))
            (= ([] kept (. item key)) (. item value))
          )
        )
      )
      (= networks kept)
    )
    (= ([] networks id) entry)
  )
  (fn-expr + vertex-count Index
    (param id U64)
    (if-expr is-network-pending (. (!! ([] networks id)) network vertex-count) (. ([] (. store nodes) row) vertices count))
    (where
      (lazy row (call row-of id))
      (lazy is-network-pending (. ([] (. store nodes) row) network-pending))
    )
  )
  (fn-expr + segment-count Index
    (param id U64)
    (if-expr is-network-pending (. (!! ([] networks id)) network segment-count) (. ([] (. store nodes) row) segments count))
    (where
      (lazy row (call row-of id))
      (lazy is-network-pending (. ([] (. store nodes) row) network-pending))
    )
  )
  (fn-do + resolved-appearance _
    (param id U64)
    (param base VectorAppearance (= (call VectorAppearance)))
    (let chain (list U64))
    (let cursor id)
    (while (!= cursor 0)
      (+= chain cursor)
      (= cursor (call parent cursor))
    )
    (let result base)
    (let index (. chain length))
    (while (> index 0)
      (-= index 1)
      (let node ([] chain index))
      (= result
        (call (. result over)
          (block
            (arg (?? (call fill node) (. Fill inherit)))
            (arg (?? (call stroke node) (. Stroke inherit)))
            (arg (call stroke-width node))
            (arg (call stroke-alignment node))
            (arg (call stroke-cap node))
            (arg (call stroke-join node))
            (arg (call fill-rule node))
          )
        )
      )
    )
    (return result)
  )
  (fn-do + effect-output _
    (param id U64)
    (param input-key U64)
    (let output-row (. ([] (. store nodes) (call row-of id)) effect-output))
    (return-if null (if (== output-row 0)))
    (blank)
    (let output ([] (. store outputs) (as output-row Index)))
    (return-if null (if (!= (. output input-key) input-key)))
    (blank)
    (let result (list Path))
    (for (in index (..< 0 (. output paths count)))
      (+= result (call output-path (+ (. output paths start) index)))
    )
    (return result)
  )
  (fn-expr + values (list VectorDocumentKeyedValue)
    (param id U64)
    (call read-values (. ([] (. store nodes) (call row-of id)) variables))
  )
  (fn-do + value (? VectorDocumentValue)
    (param id U64)
    (param key String)
    (let extent (. ([] (. store nodes) (call row-of id)) variables))
    (let index (as (. extent start) Index))
    (let last (+ index (as (. extent count) Index)))
    (while (< index last)
      (let row (as ([] (. store values) index) VectorDocumentValueRow))
      (return-if (call row-value row (+ index 1)) (if (== (. row key text) key)))
      (blank)
      (+= index (call value-span row))
    )
