(import ./color)
(import ./effect)
(import ./matrix)
(import ./primitives)
(import /core/style)
(import /units)

(type + FillLayer (is Tuple)
  (prop + color RGBA)
  (prop + visible Bool (= true))
  (fn-expr + is-plain _ :get
    visible
  )
  (fn-expr + painted-color (? RGBA) :get
    (only-if color (if (and visible (> (. color alpha) 0%%))))
  )
)

(type + StrokeLayer (is Tuple)
  (prop + color RGBA)
  (prop + width (? Length))
  (prop + alignment (? StrokeAlignment))
  (prop + join (? LineJoin))
  (prop + cap (? LineCap))
  (prop + visible Bool (= true))
  (fn-expr + is-plain _ :get
    (and visible (not width) (not alignment) (not join) (not cap))
  )
  (fn-expr + painted-color (? RGBA) :get
    (only-if color (if (and visible (> (. color alpha) 0%%))))
  )
)

(type + FillStack
  (prop _ stack-layers (list FillLayer))
  (fn-do + This _
    (param layers (list FillLayer))
    (for (in layer layers)
      (+= stack-layers layer)
    )
  )
  (fn-do + layers (list FillLayer) :get
    (for (in layer stack-layers)
      (yield layer)
    )
  )
  (fn-expr + length _ :get
    (. stack-layers length)
  )
  (fn-expr + (infix this == (param other FillStack)) _
    (== stack-layers (. other stack-layers))
  )
)

(type + StrokeStack
  (prop _ stack-layers (list StrokeLayer))
  (fn-do + This _
    (param layers (list StrokeLayer))
    (for (in layer layers)
      (+= stack-layers layer)
    )
  )
  (fn-do + layers (list StrokeLayer) :get
    (for (in layer stack-layers)
      (yield layer)
    )
  )
  (fn-expr + length _ :get
    (. stack-layers length)
  )
  (fn-expr + (infix this == (param other StrokeStack)) _
    (== stack-layers (. other stack-layers))
  )
)

(type + Fill (is Union)
  (variant inherit)
  (variant none)
  (variant stroke)
  (variant RGBA)
  (variant FillStack)
  (fn-from-expr + (: value String)
    (as value RGBA)
  )
  (fn-from-expr + (: layers (list FillLayer))
    (case? (not (. layers length))
      (. Fill none)
    )
    (case? (and (== (. layers length) 1) (. ([] layers 0) is-plain))
      (. ([] layers 0) color)
    )
    (default
      (call FillStack layers)
    )
  )
  (fn-expr + layers (list FillLayer) :get
    (match this
      (case (: stack FillStack)
        (. stack layers)
      )
      (case (: color RGBA)
        (list (call FillLayer color))
      )
      (default
        (call (of List FillLayer))
      )
    )
  )
)

(type + Stroke (is Union)
  (variant inherit)
  (variant none)
  (variant RGBA)
  (variant StrokeStack)
  (fn-from-expr + (: value String)
    (as value RGBA)
  )
  (fn-from-expr + (: layers (list StrokeLayer))
    (case? (not (. layers length))
      (. Stroke none)
    )
    (case? (and (== (. layers length) 1) (. ([] layers 0) is-plain))
      (. ([] layers 0) color)
    )
    (default
      (call StrokeStack layers)
    )
  )
  (fn-expr + layers (list StrokeLayer) :get
    (match this
      (case (: stack StrokeStack)
        (. stack layers)
      )
      (case (: color RGBA)
        (list (call StrokeLayer color))
      )
      (default
        (call (of List StrokeLayer))
      )
    )
  )
  (fn-do + top-color (? RGBA) :get
    (match this
      (case (: color RGBA)
        (return color)
      )
      (case (: stack StrokeStack)
        (let result (? RGBA))
        (for (in layer (. stack layers))
          (if (. layer visible)
            (= result (. layer color))
          )
        )
        (return result)
      )
      (default
        (return null)
      )
    )
  )
)

(type + VectorPaintStyle (is Style)
  (prop + fill Fill @inherited (= (. Fill inherit)))
  (prop + stroke Stroke @inherited (= (. Stroke inherit)))
  (prop + stroke-width (? Length) @inherited (= null))
  (prop + stroke-alignment (? StrokeAlignment) @inherited (= null))
  (prop + stroke-cap (? LineCap) @inherited (= null))
  (prop + stroke-join (? LineJoin) @inherited (= null))
  (prop + fill-rule (? FillRule) @inherited (= null))
  (blank)
  (style-domains fill (domain vector-appearance) (domain paint))
  (style-domains stroke (domain vector-appearance) (domain paint))
  (style-domains stroke-width (domain vector-appearance) (domain paint))
  (style-domains stroke-alignment (domain vector-appearance) (domain paint))
  (style-domains stroke-cap (domain vector-appearance) (domain paint))
  (style-domains stroke-join (domain vector-appearance) (domain paint))
  (style-domains fill-rule (domain vector-appearance) (domain paint))
)

(type + VectorCompositeStyle (is Style)
  (prop + opacity Ratio (= 1%%))
  (prop + visible Bool (= true))
  (prop + transform (? Matrix))
  (prop + effects VectorEffects)
  (blank)
  (style-domains opacity (domain vector-composite) (domain paint))
  (style-domains visible (domain vector-geometry) (domain vector-composite) (domain layout) (domain layout parent) (domain paint))
  (style-domains transform (domain vector-geometry) (domain vector-composite) (domain layout) (domain layout parent) (domain paint))
  (style-domains effects (domain vector-effects) (domain vector-composite) (domain layout) (domain layout parent) (domain paint))
)
