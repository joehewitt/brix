+ do update
    - bounds Rect

ensure-vector-style-root()
if update-depth
    graphic-checkpoint()
. frame = vector-root().frame-version
=? if computed-paths && current-stamp.reuses(effective-cache-policy, computed-stamp)
.. current-stamp = GraphicsCacheStamp(output-version, bounds, frame)
. source [Path]
for path in draw(bounds)
    source += Path(path)
for item in vector-items
    if !item.$visible
        continue
    do match? item
        | child GraphicNode
            child.update(bounds)
            for path in child.paths
                . result = Path(path)
                if child.$transform
                    result.transform(child.$transform!)
                source += result
        | child VectorGroup
            child.update(child.vector-evaluation-bounds(bounds))
            for path in child.paths
                . result = Path(path)
                . transform = child.vector-transform-to-parent()
                if transform
                    result.transform(transform)
                source += result
computed-paths = $effects.apply(source)
computed-stamp = GraphicsCacheStamp(output-version, bounds, frame)

