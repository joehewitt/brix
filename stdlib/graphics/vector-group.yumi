────────────────────
+ do graphic-queue-change
    - node GraphicNode
    - kinds U8

. root = vector-root()
if !node.has-pending-change
    root.pending-nodes += node
node.merge-pending-change(kinds)
. owner = node.parent
while owner
    . container = owner
    . container-node = container.graphic-container-node
    if container-node
        if !container-node.has-pending-change
            root.pending-nodes += container-node
        container-node.merge-pending-change(kinds)
    else
        . group = gc-object-from-pointer'VectorGroup(container.graphic-container-pointer)
        group.queue-vector-geometry-node(node)
        root.queue-vector-invalidation(group, kinds)
    owner = container.graphic-container-parent
if !root.update-depth
    root.flush-graphic-changes(true)

