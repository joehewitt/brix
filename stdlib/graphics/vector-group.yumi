vector-geometry-chunks.length

────────────────────
+ do paint-vector-geometry Bool
    - canvas Canvas
    - viewport Rect
    - transform Matrix
    - content Rect
    - color RGBA?

=? false if !can-paint-vector-geometry(viewport)
canvas.fill-color = color
canvas.stroke-color = color
. table = vector-geometry-table!
if vector-geometry-chunks.length == 1
    . chunk = vector-geometry-chunks[0]
    =? true if table.paint-vector-raster(chunk.handle, canvas, chunk.palette, transform, content)
for chunk in vector-geometry-chunks
    table.paint-vector(chunk.handle, canvas, chunk.palette, transform, content)
= true

────────────────────
_ member-effects-within VectorEffects?
    - outer-effects VectorEffects?

|? !own.has-enabled
    outer-effects
|? !outer-effects
    own
??
    own.followed-by(outer-effects)

.. own = $effects

