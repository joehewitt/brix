────────────────────
+ do paint-vector
    - canvas Canvas
    - inherited VectorAppearance? = null
    - apply-opacity = true
    - outer-effects VectorEffects? = null
    - area Rect? = null

ensure-vector-style-root()
=? if !$visible
. appearance = vector-appearance-over
    - this
    - hosted-appearance(inherited ?? canvas-vector-appearance(canvas))
do use canvas.saved-state
    . opacity = $opacity
    if apply-opacity && opacity < 1%%
        canvas.begin-opacity(opacity)
    if $transform
        canvas.transform($transform!)
    . bounds = area ?? Rect(0, 0, canvas.width, canvas.height)
    if $effects.combines-geometry || paints-generated-result
        update(bounds)
        . combined = if outer-effects then outer-effects.apply(paths) else paths
        paint-appearance(canvas, combined, appearance)
    else
        prepare-paint(bounds)
        . member-effects = member-effects-within(outer-effects)
        . own [Path]
        for path in draw(bounds)
            own += path
        if own.length
            . painted = if member-effects then member-effects.apply(own) else own
            paint-appearance(canvas, painted, appearance)
        for item in vector-items
            do match? item
                | child GraphicNode
                    child.paint(canvas, appearance, member-effects)
                | child VectorGroup
                    child.paint-vector-in-parent(canvas, appearance, bounds, member-effects)
    if apply-opacity && opacity < 1%%
        canvas.end-opacity()

