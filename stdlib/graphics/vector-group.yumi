+ do get effective-cache-policy GraphicsCachePolicy

. policy = cache-policy
=? .no-cache if policy == .no-cache
for item in vector-items
    . child-policy = item.effective-cache-policy
    =? .no-cache if child-policy == .no-cache
    if child-policy == .frame-cache
        policy = .frame-cache
= policy

