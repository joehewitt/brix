────────────────────
_ do vector-content-changed
    - kinds U8

. root = vector-root()
. group VectorGroup? = this
while group
    group.vector-geometry-full-dirty = true
    group.vector-geometry-support-checked = false
    group.vector-geometry-item-indices = null
    group.vector-geometry-dirty-chunks.clear()
    root.queue-vector-invalidation(group, kinds)
    group = group.vector-parent-node
if !root.update-depth
    root.flush-graphic-changes(true)

────────────────────
_ do queue-vector-invalidation
    - group VectorGroup
    - kinds U8

if !group.pending-vector-kinds
    pending-groups += group
group.pending-vector-kinds = group.pending-vector-kinds /or/ kinds

────────────────────
_ do invalidate-vector-cache
    - kinds U8

computed-paths = null
computed-stamp = null
output-version += 1
if host
    host.vector-host-changed(kinds)

────────────────────
_ do flush-graphic-changes
    - publish Bool

. kinds U8
for node in pending-nodes
    kinds = kinds /or/ node.apply-pending-change()
pending-nodes.clear()
for group in pending-groups
    . group-kinds = group.pending-vector-kinds
    group.pending-vector-kinds = 0
    group.invalidate-vector-cache(group-kinds)
    kinds = kinds /or/ group-kinds
pending-groups.clear()
pending-published-kinds = pending-published-kinds /or/ kinds
if publish && !update-depth
    publish-graphic-changes()

────────────────────
_ do publish-graphic-changes

. kinds = pending-published-kinds
pending-published-kinds = 0
=? if !kinds
if invalidation-listener
    invalidation-listener(kinds)

────────────────────
_ do vector-root VectorGroup

. result = this
while result.vector-parent-node
    result = result.vector-parent-node
= result

────────────────────
_ do vector-item-index Size
    - node VectorNode

for i in 0 .. < vector-items.length
    =? i if vector-items[i] as Pointer == node as Pointer
= vector-items.length

────────────────────
_ vector-item-source VectorGeometrySource
    - index Index

if item is VectorGroup then (item as VectorGroup).geometry-source() else item

.. item = vector-items[index]

────────────────────
_ do geometry-source VectorGeometrySource

. owner = host
=? this if !owner
. existing = hosted-source
=? existing if existing
. source = VectorHostedSource(this, owner, this)
hosted-source = source
= source

────────────────────
_ hosted-appearance VectorAppearance
    - inherited VectorAppearance

if !owner then inherited else vector-host-appearance-over(owner, inherited)

.. owner = host

────────────────────
_ vector-evaluation-bounds Rect
    - inherited Rect

host?.vector-host-viewport ?? inherited

────────────────────
_ vector-viewport-transform Matrix?

if !vector-parent-node || !owner then null else owner.vector-host-transform

.. owner = host

────────────────────
_ vector-transform-to-parent Matrix?

|? viewport
    if style then viewport.concatenate(style) else viewport
??
    style

.. viewport = vector-viewport-transform()
.. style = $transform

────────────────────
_ do paint-vector-in-parent
    - canvas Canvas
    - inherited VectorAppearance
    - area Rect
    - outer-effects VectorEffects?

. bounds = vector-evaluation-bounds(area)
. transform = vector-viewport-transform()
if !transform
    paint-vector(canvas, inherited, true, outer-effects, bounds)
    =
do use canvas.saved-state
    canvas.transform(transform)
    paint-vector(canvas, inherited, true, outer-effects, bounds)

────────────────────
_ last-evaluation-bounds Rect

if computed-stamp then computed-stamp.bounds else Rect()

────────────────────
_ do release-node
    - child MarkupElement

if child.markup-batch-root
    markup-release(child)

────────────────────
_ do attach-item
    - child VectorNode
    - anchor VectorNode?

. index = if anchor then vector-item-index(anchor) else vector-items.length
do match? child
    | graphic GraphicNode
        graphic.parent = this
    | group VectorGroup
        group.vector-parent-node = this
vector-items.insert(child, index)
vector-content-changed(graphic-change-structure /or/ graphic-change-geometry)

────────────────────
_ do detach-item
    - child VectorNode

. index = vector-item-index(child)
=? if index == vector-items.length
vector-items.remove(index)
do match? child
    | graphic GraphicNode
        graphic.parent = null
        graphic.previous = null
        graphic.next = null
    | group VectorGroup
        group.vector-parent-node = null
vector-content-changed(graphic-change-structure /or/ graphic-change-geometry)

────────────────────
_ do resolve-vector-geometry
    - viewport Rect

. root = markup-batch-root
=? if !root
. table = vector-geometry-table-for(root)
if vector-geometry-table != table
    release-vector-geometry()
    vector-geometry-table = table
    vector-geometry-full-dirty = true
if vector-geometry-full-dirty
    release-vector-geometry-chunks(table)
    build-vector-geometry-chunks(table, viewport)
else
    for chunk-index in vector-geometry-dirty-chunks
        rebuild-vector-geometry-chunk(table, viewport, chunk-index)
vector-geometry-dirty-chunks.clear()
vector-geometry-full-dirty = false
vector-geometry-source-revision = revision

────────────────────
_ do release-vector-geometry

=? if !vector-geometry-table
release-vector-geometry-chunks(vector-geometry-table)
vector-geometry-table = null
vector-geometry-item-indices = null
vector-geometry-dirty-chunks.clear()
vector-geometry-full-dirty = true
vector-geometry-source-revision = 0

────────────────────
_ do release-vector-geometry-chunks
    - table VectorGeometryTable

for chunk in vector-geometry-chunks
    table.release(chunk.handle)
vector-geometry-chunks.clear()

────────────────────
_ do build-vector-geometry-chunks
    - table VectorGeometryTable
    - viewport Rect

. item-count = vector-items.length
if item-count > vector-geometry-chunk-capacity
    . indices = Map'Pointer'Size()
    for index in 0 .. < item-count
        indices[vector-items[index] as Pointer] = index
    vector-geometry-item-indices = indices
else
    vector-geometry-item-indices = null
. start Size
while start < item-count
    . end = start + vector-geometry-chunk-capacity
    if end > item-count
        end = item-count
    . source = chunk-source(VectorGroupSlice(this, start, end))
    . acquisition = table.intern(source, viewport)
    vector-geometry-chunks += VectorGeometryChunk(source, acquisition.handle, acquisition.palette)
    start = end

────────────────────
_ chunk-source VectorGeometrySource
    - slice VectorGroupSlice

if !owner then slice else VectorHostedSource(this, owner, slice)

.. owner = host

────────────────────
_ do rebuild-vector-geometry-chunk
    - table VectorGeometryTable
    - viewport Rect
    - index Size

=? if index >= vector-geometry-chunks.length
. chunk = vector-geometry-chunks[index]
table.release(chunk.handle)
. acquisition = table.intern(chunk.source, viewport)
chunk.handle = acquisition.handle
chunk.palette = acquisition.palette

────────────────────
_ do queue-vector-geometry-node
    - node GraphicNode

=? if vector-geometry-full-dirty
. indices = vector-geometry-item-indices
if !indices
    vector-geometry-full-dirty = true
    =
. item-index = indices[node as Pointer]
if !item-index
    vector-geometry-full-dirty = true
    vector-geometry-dirty-chunks.clear()
    =
. chunk-index = item-index / vector-geometry-chunk-capacity
for existing in vector-geometry-dirty-chunks
    =? if existing == chunk-index
vector-geometry-dirty-chunks += chunk-index

────────────────────
_ do release-and-reject-vector-geometry Bool

release-vector-geometry()
= false

────────────────────
_ do can-paint-vector-geometry Bool
    - viewport Rect

=? release-and-reject-vector-geometry() if $effects.length || paints-generated-result
if !vector-geometry-support-checked
    vector-geometry-supported = vector-geometry-supports-source(geometry-source())
    vector-geometry-support-checked = true
=? release-and-reject-vector-geometry() if !vector-geometry-supported
if vector-geometry-source-revision != revision
    resolve-vector-geometry(viewport)
= vector-geometry-table != null

────────────────────
_ do ensure-vector-style-root

. owner = host
if owner && !owner.markup-batch-root
    markup-adopt(owner, null, owner)
if !markup-batch-root
    markup-adopt(this, null, this)
. root = markup-batch-root
if root
    root.markup-batch-queue.checkpoint()

━━━━━━━━━━━━━━━━━━━━
_ vector-host-appearance-over VectorAppearance
    - host VectorGroupHost
    - inherited VectorAppearance

inherited.over
    - host.$fill
    - host.$stroke
    - host.$stroke-width
    - host.$stroke-alignment
    - host.$stroke-cap
    - host.$stroke-join
    - host.$fill-rule
