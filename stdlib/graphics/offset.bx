(import ./curve)
(import ./curve-kernels)
(import ./effect)
(import ./graphic)
(import ./intersection)
(import ./offset-kernels)
(import ./path)
(import ./path-set)
(import ./point)
(import ./primitives)
(import ./shapes)
(import ./stroke)
(import /math)
(import /stream/sort)
(import /units)
(blank)
(prop _ offset-path-teeny _ (= 0.000001))
(prop _ offset-cleanup-tolerance _ (= 0.001))
(prop _ offset-trim-epsilon _ (= 0.000000001))
(prop _ offset-trim-snap _ (= 0.5))
(prop _ offset-trim-flatness _ (= 0.01))

(type + OffsetEffect (is VectorEffect)
  (prop + distance _ (=> effect-distance))
  (prop + join-type _ (=> effect-join-type))
  (prop + miter-limit _ (=> effect-miter-limit))
  (blank)
  (prop _ effect-distance Length)
  (prop _ effect-join-type JoinType (= .square-join-type))
  (prop _ effect-miter-limit Length (= 1))
  (fn-do + This _
    (param value Length)
    (param join JoinType (= .square-join-type))
    (param limit Length (= 1))
    (= effect-distance value)
    (= effect-join-type join)
    (= effect-miter-limit limit)
  )
  (fn-expr + equals Bool
    (param other VectorEffect)
    (case? (not (is other OffsetEffect))
      false
    )
    (default
      (and same-distance (== join-type (. offset join-type)) (== miter-limit (. offset miter-limit)))
    )
    (where
      (lazy offset (as other OffsetEffect))
      (lazy same-distance (and (== enabled (. offset enabled)) (== distance (. offset distance))))
    )
  )
  (fn-do + apply (list Path)
    (param source (list Path))
    (if (== distance 0)
      (return source)
    )
    (blank)
    (let result Path)
    (for (in path source)
      (if (call offset-path-is-single-subpath path)
        (let offset (call offset-subpath-plan (call OffsetPlan path) distance join-type miter-limit))
        (if (. offset count)
          (if (. result count)
            (call (. result add-path) offset)
            (else
              (= result offset)
            )
          )
        )
        (else
          (for (in span (. path subpaths))
            (let subpath (call (. span materialize)))
            (let offset (call offset-subpath-plan (call OffsetPlan subpath) distance join-type miter-limit))
            (if (. offset count)
              (if (. result count)
                (call (. result add-path) offset)
                (else
                  (= result offset)
                )
              )
            )
          )
        )
      )
    )
    (blank)
    (let output (list Path))
    (if (. result count)
      (+= output result)
    )
    (return output)
  )
  (fn-expr + copy _
    (call OffsetEffect effect-distance effect-join-type effect-miter-limit)
  )
)

(type + OffsetPlanSpan (is Tuple)
  (prop + type SegmentType)
  (prop + x1 Coord)
  (prop + y1 Coord)
  (prop + hox Coord)
  (prop + hoy Coord)
  (prop + hix Coord)
  (prop + hiy Coord)
  (prop + x2 Coord)
  (prop + y2 Coord)
  (prop + min-x Coord)
  (prop + min-y Coord)
  (prop + max-x Coord)
  (prop + max-y Coord)
  (prop + is-line-like Bool)
)

(type + OffsetRawPath (is Tuple)
  (prop + path Path)
  (prop + spans (list CurveRangeScalars))
  (prop + origins (list CurveRangeScalars))
  (prop + sources (list OffsetPlanSpan))
)

(type + OffsetPlan
  (prop + path Path)
  (prop + spans (list OffsetPlanSpan))
  (prop + is-closed _ (= false))
  (prop + is-clockwise _ (= true))
  (prop + is-all-lines _ (= true))
  (prop + is-convex _ (= false))
  (prop + is-single-subpath _ (= false))
  (prop + has-self-intersections _ (= false))
  (prop + bounds Rect)
  (fn-do + This _
    (param source Path)
    (lazy path source)
    (= is-closed (. source is-closed))
    (= is-clockwise (. source is-clockwise))
    (= is-single-subpath (call offset-path-is-single-subpath source))
    (call build-spans)
    (= is-convex (call offset-plan-is-convex this))
    (= has-self-intersections (call offset-plan-has-self-intersections this))
  )
  (fn-do _ build-spans _
    (let reader (. path curve-reader))
    (let waiting-for-bounds true)
    (while (call (. reader next))
      (let x1 (. reader x1))
      (let y1 (. reader y1))
      (let hox (. reader handle-out-x))
      (let hoy (. reader handle-out-y))
      (let hix (. reader handle-in-x))
      (let hiy (. reader handle-in-y))
      (let x2 (. reader x2))
      (let y2 (. reader y2))
      (let is-line-like
        (scope (or (== (. reader type) .segment-type-line) scalars-line-like)
          (lazy scalars-line-like (call line-like-scalars x1 y1 hox hoy hix hiy x2 y2))
        )
      )
      (if (not is-line-like)
        (= is-all-lines false)
      )
      (blank)
      (let min-x Coord)
      (let min-y Coord)
      (let max-x Coord)
      (let max-y Coord)
      (if (or (== (. reader type) .segment-type-line) is-line-like)
        (= min-x (call min x1 x2))
        (= min-y (call min y1 y2))
        (= max-x (call max x1 x2))
        (= max-y (call max y1 y2))
        (else
          (= min-x (call min (call min x1 hox) (call min hix x2)))
          (= min-y (call min (call min y1 hoy) (call min hiy y2)))
          (= max-x (call max (call max x1 hox) (call max hix x2)))
          (= max-y (call max (call max y1 hoy) (call max hiy y2)))
        )
      )
      (blank)
      (if waiting-for-bounds
        (= bounds (call Rect min-x min-y (- max-x min-x) (- max-y min-y)))
        (= waiting-for-bounds false)
        (else
          (+= bounds (call Rect min-x min-y (- max-x min-x) (- max-y min-y)))
        )
      )
      (blank)
      (+= spans
        (call OffsetPlanSpan
          (block
            (arg (. reader type))
            (arg x1)
            (arg y1)
            (arg hox)
            (arg hoy)
            (arg hix)
            (arg hiy)
            (arg x2)
            (arg y2)
            (arg min-x)
            (arg min-y)
            (arg max-x)
            (arg max-y)
            (arg is-line-like)
          )
        )
      )
    )
  )
)

(fn-expr + offset-plan _
  (param path Path)
  (call OffsetPlan path)
)

(fn-expr + offset-plan-path _
  (param plan OffsetPlan)
  (param distance Length)
  (param join-type JoinType (= .square-join-type))
  (param miter-limit Length (= 1))
  (call offset-subpath-plan plan distance join-type miter-limit)
)

(fn-expr + offset-plan-layer _
  (param plan OffsetPlan)
  (param distance Length)
  (param join-type JoinType (= .square-join-type))
  (param miter-limit Length (= 1))
  (if-expr (. path count) (call PathSet path) (call PathSet))
  (where
    (lazy path (call offset-plan-path plan distance join-type miter-limit))
  )
)

(fn-do + offset-path _
  (param layer PathSet)
  (param distance Length)
  (param join-type JoinType (= .square-join-type))
  (param miter-limit Length (= 1))
  (if (== distance 0)
    (return layer)
  )
  (blank)
  (let result Path)
  (for (in source (. layer paths))
    (if (call offset-path-is-single-subpath source)
      (let offset (call offset-subpath-plan (call OffsetPlan source) distance join-type miter-limit))
      (if (. offset count)
        (if (. result count)
          (call (. result add-path) offset)
          (else
            (= result offset)
          )
        )
      )
      (else
        (for (in span (. source subpaths))
          (let subpath (call (. span materialize)))
          (let offset (call offset-subpath-plan (call OffsetPlan subpath) distance join-type miter-limit))
          (if (. offset count)
            (if (. result count)
              (call (. result add-path) offset)
              (else
                (= result offset)
              )
            )
          )
        )
      )
    )
  )
  (blank)
  (if (. result count)
    (return (call PathSet result))
  )
  (blank)
  (return (call PathSet))
)

(fn-do + offset-path-is-single-subpath _
  (param path Path)
  (let moves Size)
  (let span (. path commands))
  (for (in i (..< 0 (. span command-count)))
    (if (== ([] (. span verbs) i) .path-verb-move)
      (+= moves 1)
      (return-if (if (> moves 1)))
    )
  )
  (blank)
  (return (== moves 1))
)

(fn-do + offset-special-path _
  (param path Path)
  (param distance Float)
  (if (. path is-closed)
    (let rect (call axis-rect path))
    (if rect
      (let expanded (call (. rect inflate) (* distance 2) (* distance 2)))
      (if (or (<= (. expanded width) 0) (<= (. expanded height) 0))
        (return (call Path))
      )
      (return (call rectangle expanded))
    )
    (else
      (return (call straight-line-offset path distance))
    )
  )
)

(fn-do + straight-line-offset _
  (param path Path)
  (param distance Float)
  (return-if (if (. path is-closed)))
  (return-if (if (< (. path count) 2)))
  (blank)
  (let span (. path commands))
  (for (in i (..< 0 (. span command-count)))
    (return-if (if (== ([] (. span verbs) i) .path-verb-cubic)))
  )
  (blank)
  (let first-x ([] (. span coords) 0))
  (let first-y ([] (. span coords) 1))
  (let last-x first-x)
  (let last-y first-y)
  (for (in i (..< 0 (. span command-count)))
    (let verb ([] (. span verbs) i))
    (if (or (== verb .path-verb-line) (== verb .path-verb-move))
      (let start ([] (. span coord-offsets) i))
      (= last-x ([] (. span coords) start))
      (= last-y ([] (. span coords) (+ start 1)))
    )
  )
  (blank)
  (let line-dx (- last-x first-x))
  (let line-dy (- last-y first-y))
  (let line-length2 (+ (* line-dx line-dx) (* line-dy line-dy)))
  (return-if (if (< line-length2 0.0000000001)))
  (blank)
  (for (in i (..< 0 (. span command-count)))
    (let verb ([] (. span verbs) i))
    (if (== verb .path-verb-close)
      (continue)
    )
    (let start ([] (. span coord-offsets) i))
    (let x ([] (. span coords) start))
    (let y ([] (. span coords) (+ start 1)))
    (return-if (if (not (call point-on-line-xy x y first-x first-y last-x last-y))))
  )
  (blank)
  (let normal (call line-normal-xy first-x first-y last-x last-y))
  (let normal-x (. normal x))
  (let normal-y (. normal y))
  (let offset-x (* normal-x distance))
  (let offset-y (* normal-y distance))
  (let result (call Path))
  (call (. result move-to) (+ first-x offset-x) (+ first-y offset-y))
  (call (. result line-to) (+ last-x offset-x) (+ last-y offset-y))
  (return result)
)

(fn-expr + point-on-line _
  (param point Point)
  (param first Point)
  (param last Point)
  (and near-line within-x within-y)
  (where
    (lazy near-line (< (call abs cross) 0.00001))
    (lazy cross (- (* dx py) (* dy px)))
    (lazy dx (- (. last x) (. first x)))
    (lazy dy (- (. last y) (. first y)))
    (lazy px (- (. point x) (. first x)))
    (lazy py (- (. point y) (. first y)))
    (lazy within-x (and (>= (. point x) min-x) (<= (. point x) max-x)))
    (lazy min-x (- (call min (. first x) (. last x)) 0.00001))
    (lazy max-x (+ (call max (. first x) (. last x)) 0.00001))
    (lazy within-y (and (>= (. point y) min-y) (<= (. point y) max-y)))
    (lazy min-y (- (call min (. first y) (. last y)) 0.00001))
    (lazy max-y (+ (call max (. first y) (. last y)) 0.00001))
  )
)

(fn-expr + point-on-line-xy _
  (param x Coord)
  (param y Coord)
  (param first-x Coord)
  (param first-y Coord)
  (param last-x Coord)
  (param last-y Coord)
  (and near-line within-x within-y)
  (where
    (lazy near-line (< (call abs cross) 0.00001))
    (lazy cross (- (* dx py) (* dy px)))
    (lazy dx (- last-x first-x))
    (lazy dy (- last-y first-y))
    (lazy px (- x first-x))
    (lazy py (- y first-y))
    (lazy within-x (and (>= x min-x) (<= x max-x)))
    (lazy min-x (- (call min first-x last-x) 0.00001))
    (lazy max-x (+ (call max first-x last-x) 0.00001))
    (lazy within-y (and (>= y min-y) (<= y max-y)))
    (lazy min-y (- (call min first-y last-y) 0.00001))
    (lazy max-y (+ (call max first-y last-y) 0.00001))
  )
)

(type _ OffsetCrossing
  (prop + i Index)
  (prop + t PointOnCurve)
  (prop + pt Point)
  (prop + next (? OffsetCrossing))
  (prop + previous (? OffsetCrossing))
  (prop + counter (? OffsetCrossing))
  (prop + visited _ (= false))
  (fn-do + This _
    (param crossing-i Index)
    (param crossing-t PointOnCurve)
    (param crossing-pt Point)
    (= i crossing-i)
    (= t crossing-t)
    (= pt crossing-pt)
  )
)

(type _ OffsetContour
  (prop + distance Length)
  (prop + join-type JoinType)
  (prop + miter-limit Length)
  (prop + normal-sign Float)
  (prop + out _ (= (call OffsetPathWriter)))
  (prop + first-point Point)
  (prop + prev-point Point)
  (prop + first-unit-normal Point)
  (prop + prev-unit-normal Point)
  (prop + first-tangent Point)
  (prop + prev-tangent Point)
  (prop + segment-count Size)
  (prop + has-current _ (= false))
  (prop + first-is-line _ (= false))
  (fn-do + This _
    (param point Point)
    (param distance Length)
    (param join-type JoinType)
    (param miter-limit Length)
    (param normal-sign Float)
    (= (. out collect-spans) true)
    (= (. out is-exact) true)
    (call move-to point)
  )
  (fn-do + move-to _
    (param point Point)
    (= first-point point)
    (= prev-point point)
    (= has-current true)
    (= segment-count 0)
    (call (. out reset))
  )
  (fn-do + line-to _
    (param point Point)
    (call line-to point (:is-line true))
  )
  (fn-do + line-to _
    (param point Point)
    (param is-line Bool)
    (if (not has-current)
      (call move-to point)
      (return)
    )
    (let delta (- point prev-point))
    (let len (. delta length))
    (return-if (if (<= len offset-path-teeny)))
    (blank)
    (let tangent (/ delta len))
    (let unit-normal (call offset-unit-normal tangent normal-sign))
    (call pre-join-to unit-normal tangent (:is-line))
    (call (. out originate) (call offset-origin-line prev-point point))
    (call append-line-to-offset point unit-normal)
    (call post-join-to point unit-normal tangent)
  )
  (fn-do + cubic-to _
    (param handle-out Point)
    (param handle-in Point)
    (param point Point)
    (if (not has-current)
      (call move-to point)
      (return)
    )
    (return-if (if (call cubic-is-point-like prev-point handle-out handle-in point)))
    (blank)
    (if (call cubic-is-chord-like prev-point handle-out handle-in point)
      (call line-to point (:is-line false))
      (return)
    )
    (let start-tangent (call cubic-tangent-at prev-point handle-out handle-in point 0))
    (let end-tangent (call cubic-tangent-at prev-point handle-out handle-in point 1))
    (let start-normal (call offset-unit-normal start-tangent normal-sign))
    (let end-normal (call offset-unit-normal end-tangent normal-sign))
    (blank)
    (call pre-join-to start-normal start-tangent (:is-line false))
    (call append-offset-cubic-split-inflections
      (block
        (arg out)
        (arg prev-point)
        (arg handle-out)
        (arg handle-in)
        (arg point)
        (arg distance)
        (arg normal-sign)
      )
    )
    (call post-join-to point end-normal end-tangent)
  )
  (fn-do + finish-raw _
    (param close Bool)
    (if (<= segment-count 0)
      (return (call OffsetRawPath (call Path) (. out spans) (. out origins) (call offset-source-spans (. out sources))))
    )
    (blank)
    (if close
      (= (. out origin) (call offset-origin-line prev-point prev-point))
      (call add-contour-join
        (block
          (arg prev-point)
          (arg prev-unit-normal)
          (arg first-unit-normal)
          (arg prev-tangent)
          (arg first-tangent)
          (:is-line first-is-line)
        )
      )
      (call (. out close))
    )
    (blank)
    (return (call OffsetRawPath (. out path) (. out spans) (. out origins) (call offset-source-spans (. out sources))))
  )
  (fn-do _ pre-join-to _
    (param unit-normal Point)
    (param tangent Point)
    (param is-line Bool)
    (if (== segment-count 0)
      (= first-unit-normal unit-normal)
      (= prev-unit-normal unit-normal)
      (= first-tangent tangent)
      (= prev-tangent tangent)
      (= first-is-line is-line)
      (call (. out line-to) (+ prev-point (* unit-normal distance)))
      (else
        (= (. out origin) (call offset-origin-line prev-point prev-point))
        (call add-contour-join
          (block
            (arg prev-point)
            (arg prev-unit-normal)
            (arg unit-normal)
            (arg prev-tangent)
            (arg tangent)
            (:is-line)
          )
        )
      )
    )
  )
  (fn-do _ append-line-to-offset _
    (param point Point)
    (param unit-normal Point)
    (call (. out line-to) (+ point (* unit-normal distance)))
  )
  (fn-do _ post-join-to _
    (param point Point)
    (param unit-normal Point)
    (param tangent Point)
    (= prev-point point)
    (= prev-unit-normal unit-normal)
    (= prev-tangent tangent)
    (+= segment-count 1)
  )
  (fn-do _ add-contour-join _
    (param pivot Point)
    (param before-normal Point)
    (param after-normal Point)
    (param before-tangent Point)
    (param after-tangent Point)
    (param is-line Bool)
    (probe-count graphics.offset.joins)
    (call add-side-join
      (block
        (arg out)
        (arg pivot)
        (arg before-normal)
        (arg after-normal)
        (arg before-tangent)
        (arg after-tangent)
        (:is-line)
      )
    )
  )
  (fn-do _ add-side-join _
    (param writer OffsetPathWriter)
    (param pivot Point)
    (param before-normal Point)
    (param after-normal Point)
    (param before-tangent Point)
    (param after-tangent Point)
    (param is-line Bool)
    (let before-offset (+ pivot (* before-normal distance)))
    (let after-offset (+ pivot (* after-normal distance)))
    (let turn (call (. before-tangent cross) after-tangent))
    (blank)
    (if (<= (call abs distance) offset-path-teeny)
      (call (. writer line-to) pivot)
      (return)
    )
    (if (<= (call abs turn) offset-path-teeny)
      (if (>= (call (. before-tangent dot) after-tangent) -0.999)
        (call (. writer line-to) after-offset)
        (else-if (== join-type .round-join-type)
          (call add-round-offset-join writer pivot before-offset after-offset)
        )
        (else-if (== join-type .square-join-type)
          (call append-square-join
            (block
              (arg writer)
              (arg pivot)
              (arg before-normal)
              (arg after-normal)
              (arg before-tangent)
              (arg after-tangent)
              (arg distance)
              (:is-line)
            )
          )
        )
        (else
          (call (. writer line-to) before-offset)
          (call (. writer line-to) after-offset)
        )
      )
      (return)
    )
    (if (< (* turn distance normal-sign) 0)
      (call (. writer line-to) after-offset)
      (return)
    )
    (if (== join-type .miter-join-type)
      (call add-miter-side-join writer pivot before-normal after-normal (:is-line))
      (else-if (== join-type .round-join-type)
        (call add-round-offset-join writer pivot before-offset after-offset)
      )
      (else-if (== join-type .square-join-type)
        (call append-square-join
          (block
            (arg writer)
            (arg pivot)
            (arg before-normal)
            (arg after-normal)
            (arg before-tangent)
            (arg after-tangent)
            (arg distance)
            (:is-line)
          )
        )
      )
      (else
        (call (. writer line-to) after-offset)
      )
    )
  )
  (fn-do _ add-miter-side-join _
    (param writer OffsetPathWriter)
    (param pivot Point)
    (param before-normal Point)
    (param after-normal Point)
    (param is-line Bool)
    (let dot (call (. before-normal dot) after-normal))
    (if (or (> dot 0.999) (<= miter-limit 1))
      (call (. writer line-to) (+ pivot (* after-normal distance)))
      (return)
    )
    (if (< dot -0.999)
      (call (. writer line-to) (+ pivot (* before-normal distance)))
      (call (. writer line-to) (+ pivot (* after-normal distance)))
      (return)
    )
    (let sin-half (call sqrt (call max 0.0 (/ (+ 1.0 dot) 2.0))))
    (if (or (<= sin-half 0) (< sin-half (/ 1.0 miter-limit)))
      (call (. writer line-to) (+ pivot (* after-normal distance)))
      (return)
    )
    (let mid Point)
    (if (and (<= (call abs dot) offset-path-teeny) (>= miter-limit 1.41421356237))
      (= mid (* (+ before-normal after-normal) distance))
      (else
        (let sum (+ before-normal after-normal))
        (let sum-length (. sum length))
        (if (<= sum-length offset-path-teeny)
          (call (. writer line-to) (+ pivot (* after-normal distance)))
          (return)
        )
        (= mid (* (/ sum sum-length) (/ (call abs distance) sin-half)))
        (if (< distance 0)
          (= mid (- mid))
        )
      )
    )
    (blank)
    (call (. writer line-to) (+ pivot mid))
    (if (not is-line)
      (call (. writer line-to) (+ pivot (* after-normal distance)))
    )
  )
  (fn-do _ add-round-offset-join _
    (param writer OffsetPathWriter)
    (param center Point)
    (param from Point)
    (param to Point)
    (let radius (call abs distance))
    (if (or (< radius offset-path-teeny) (< (call (. from distance) to) offset-path-teeny))
      (call (. writer line-to) to)
      (else
        (call (. writer line-to) from)
        (call (. writer arc) center radius (call (. from angle) center) (call (. to angle) center) (< (* distance normal-sign) 0))
      )
    )
  )
)

(type _ OffsetCut (is Tuple)
  (prop + t PointOnCurve)
  (prop + point Point)
  (prop + is-crossing Bool)
)

(type _ OffsetSample (is Tuple)
  (prop + t PointOnCurve)
  (prop + is-valid Bool)
  (prop + cut Index)
)

(type _ OffsetRun
  (prop + start OffsetCut)
  (prop + end OffsetCut)
  (prop + next (? OffsetRun))
  (prop + has-previous _ (= false))
  (prop + visited _ (= false))
  (fn-do + This _
    (param run-start OffsetCut)
    (param run-end OffsetCut)
    (= start run-start)
    (= end run-end)
  )
)

(fn-do _ offset-plan-is-convex _
  (param plan OffsetPlan)
  (return-if (if (not (. plan is-closed))))
  (return-if (if (not (. plan is-all-lines))))
  (return-if (if (< (. plan spans length) 3)))
  (blank)
  (let sign Coord)
  (let has-sign false)
  (for (in i (..< 0 (. plan spans length)))
    (let a ([] (. plan spans) i))
    (let b ([] (. plan spans) (% (+ i 1) (. plan spans length))))
    (let ax (- (. a x2) (. a x1)))
    (let ay (- (. a y2) (. a y1)))
    (let bx (- (. b x2) (. b x1)))
    (let bdy (- (. b y2) (. b y1)))
    (let cross (- (* ax bdy) (* ay bx)))
    (if (<= (call abs cross) offset-path-teeny)
      (continue)
    )
    (if (not has-sign)
      (= sign cross)
      (= has-sign true)
      (else
        (return-if (if (< (* sign cross) 0)))
      )
    )
  )
  (blank)
  (return has-sign)
)

(fn-do _ offset-plan-has-self-intersections _
  (param plan OffsetPlan)
  (let count (. plan spans length))
  (for (in i (..< 0 count))
    (let c1 ([] (. plan spans) i))
    (for (in j (..< (+ i 1) count))
      (let c2 ([] (. plan spans) j))
      (let both-lines (and (. c1 is-line-like) (. c2 is-line-like)))
      (if (and both-lines (call offset-curves-are-adjacent i j count (. plan is-closed)))
        (continue)
      )
      (if (not (call offset-plan-span-bounds-overlap c1 c2))
        (continue)
      )
      (blank)
      (let hits (list CurveIntersection))
      (call append-offset-span-intersections
        (block
          (arg hits)
          (arg (call offset-plan-span-curve c1))
          (arg (call offset-plan-span-curve c2))
          (arg i)
          (arg j)
        )
      )
      (for (in hit hits)
        (if (or (call offset-is-endpoint-hit (. hit t1) i) (call offset-is-endpoint-hit (. hit t2) j))
          (continue)
        )
        (return true)
      )
    )
  )
  (blank)
  (return false)
)

(fn-expr _ offset-plan-span-bounds-overlap _
  (param a OffsetPlanSpan)
  (param b OffsetPlanSpan)
  (not (or a-left-of-b b-left-of-a a-above-b (< (. b max-y) (- (. a min-y) offset-cleanup-tolerance))))
  (where
    (lazy a-left-of-b (< (. a max-x) (- (. b min-x) offset-cleanup-tolerance)))
    (lazy b-left-of-a (< (. b max-x) (- (. a min-x) offset-cleanup-tolerance)))
    (lazy a-above-b (< (. a max-y) (- (. b min-y) offset-cleanup-tolerance)))
  )
)

(fn-expr _ offset-plan-span-curve _
  (param span OffsetPlanSpan)
  (call CurveRangeScalars
    (block
      (arg (. span type))
      (arg (. span x1))
      (arg (. span y1))
      (arg (. span hox))
      (arg (. span hoy))
      (arg (. span hix))
      (arg (. span hiy))
      (arg (. span x2))
      (arg (. span y2))
    )
  )
)

(fn-expr _ offset-subpath-plan Path
  (param plan OffsetPlan)
  (param distance Length)
  (param join-type JoinType)
  (param miter-limit Length)
  (case? (< (. plan spans length) 1)
    (call Path)
  )
  (case? self-crossing
    self-crossing
  )
  (default
    (call offset-simple-plan plan distance join-type miter-limit)
  )
  (where
    (lazy self-crossing (call offset-self-crossing-plan plan distance join-type miter-limit))
  )
)

(fn-expr _ offset-simple-plan _
  (param plan OffsetPlan)
  (param distance Length)
  (param join-type JoinType)
  (param miter-limit Length)
  (case? special
    special
  )
  (case? convex
    convex
  )
  (case? (not (. raw path count))
    (. raw path)
  )
  (case? (and (. plan is-convex) (>= distance 0))
    (. raw path)
  )
  (default
    (call trim-offset-plan raw plan distance)
  )
  (where
    (lazy special (call offset-special-plan plan distance join-type miter-limit))
    (lazy convex (call offset-convex-polygon-plan plan distance join-type miter-limit))
    (lazy raw (call raw-offset-plan plan distance join-type miter-limit))
  )
)

(fn-do _ offset-convex-polygon-plan _
  (param plan OffsetPlan)
  (param distance Length)
  (param join-type JoinType)
  (param miter-limit Length)
  (return-if (if (not (. plan is-closed))))
  (return-if (if (not (. plan is-convex))))
  (return-if (if (not (. plan is-all-lines))))
  (blank)
  (return-if (if (< distance 0)))
  (return-if (if (== join-type .round-join-type)))
  (blank)
  (let miter (call offset-convex-polygon-miter-path plan distance))
  (return-if (if (not miter)))
  (blank)
  (if (not (. miter count))
    (return (call Path))
  )
  (blank)
  (if (and (== join-type .miter-join-type) (call offset-convex-polygon-miter-limit-ok plan miter-limit))
    (return miter)
  )
  (blank)
  (return (call offset-convex-polygon-corner-path plan distance join-type))
)

(fn-do _ offset-convex-polygon-miter-path _
  (param plan OffsetPlan)
  (param distance Length)
  (let result (call Path))
  (let count (. plan spans length))
  (let normal-sign (call offset-plan-normal-sign plan))
  (for (in i (..< 0 count))
    (let prev ([] (. plan spans) (% (- (+ i count) 1) count)))
    (let span ([] (. plan spans) i))
    (let point (call offset-plan-shifted-line-intersection prev span distance normal-sign))
    (return-if (if (not point)))
    (blank)
    (if (== i 0)
      (call (. result move-to) point)
      (else
        (call (. result line-to) point)
      )
    )
  )
  (blank)
  (call (. result close))
  (if (!= (. result is-clockwise) (. plan is-clockwise))
    (return (call Path))
  )
  (blank)
  (return result)
)

(fn-do _ offset-convex-polygon-corner-path _
  (param plan OffsetPlan)
  (param distance Length)
  (param join-type JoinType)
  (let result (call Path))
  (let count (. plan spans length))
  (let normal-sign (call offset-plan-normal-sign plan))
  (for (in i (..< 0 count))
    (let previous-span ([] (. plan spans) (% (- (+ i count) 1) count)))
    (let span ([] (. plan spans) i))
    (let pivot (call Point (. span x1) (. span y1)))
    (let before-normal (call offset-plan-span-unit-normal previous-span normal-sign))
    (let after-normal (call offset-plan-span-unit-normal span normal-sign))
    (let extent
      (block
        (case? (== join-type .square-join-type)
          (call square-join-extent before-normal after-normal distance)
        )
        (default
          0.0
        )
      )
    )
    (let before-point
      (scope (+ pivot (* before-normal distance) (* before-tangent extent))
        (lazy before-tangent (call offset-plan-span-unit-tangent previous-span))
      )
    )
    (let after-point (- (+ pivot (* after-normal distance)) (* (call offset-plan-span-unit-tangent span) extent)))
    (if (== i 0)
      (call (. result move-to) before-point)
      (else
        (call (. result line-to) before-point)
      )
    )
    (call (. result line-to) after-point)
  )
  (blank)
  (call (. result close))
  (return (if-expr (== (. result is-clockwise) (. plan is-clockwise)) result (call Path)))
)

(fn-do _ offset-convex-polygon-miter-limit-ok _
  (param plan OffsetPlan)
  (param miter-limit Length)
  (return-if (if (<= miter-limit 1)))
  (blank)
  (let count (. plan spans length))
  (let normal-sign (call offset-plan-normal-sign plan))
  (for (in i (..< 0 count))
    (let previous-span ([] (. plan spans) (% (- (+ i count) 1) count)))
    (let previous-normal (call offset-plan-span-unit-normal previous-span normal-sign))
    (let next-normal (call offset-plan-span-unit-normal ([] (. plan spans) i) normal-sign))
    (let dot (call (. previous-normal dot) next-normal))
    (if (> dot 0.999)
      (continue)
    )
    (return-if (if (< dot -0.999)))
    (blank)
    (let sin-half (call sqrt (call max 0.0 (/ (+ 1.0 dot) 2.0))))
    (return-if (if (<= sin-half 0)))
    (return-if (if (< sin-half (/ 1.0 miter-limit))))
  )
  (blank)
  (return true)
)

(fn-expr _ offset-plan-shifted-line-intersection _
  (param previous-span OffsetPlanSpan)
  (param next-span OffsetPlanSpan)
  (param distance Length)
  (param normal-sign Float)
  (call intersect-lines
    (block
      (arg (+ (call Point (. previous-span x1) (. previous-span y1)) before-offset))
      (arg (+ (call Point (. previous-span x2) (. previous-span y2)) before-offset))
      (arg (+ (call Point (. next-span x1) (. next-span y1)) after-offset))
      (arg (+ (call Point (. next-span x2) (. next-span y2)) after-offset))
      (arg true)
    )
  )
  (where
    (lazy before-normal (call offset-plan-span-unit-normal previous-span normal-sign))
    (lazy after-normal (call offset-plan-span-unit-normal next-span normal-sign))
    (lazy before-offset (* before-normal distance))
    (lazy after-offset (* after-normal distance))
  )
)

(fn-expr _ offset-plan-span-unit-normal _
  (param span OffsetPlanSpan)
  (param normal-sign Float)
  (call offset-unit-normal (call offset-plan-span-unit-tangent span) normal-sign)
)

(fn-expr _ offset-plan-span-unit-tangent _
  (param span OffsetPlanSpan)
  (call unit-vector (call Point (- (. span x2) (. span x1)) (- (. span y2) (. span y1))))
)

(fn-do _ offset-self-crossing-plan _
  (param plan OffsetPlan)
  (param distance Length)
  (param join-type JoinType)
  (param miter-limit Length)
  (return-if (if (not (. plan is-closed))))
  (return-if (if (not (. plan has-self-intersections))))
  (blank)
  (let spans (call offset-plan-span-ranges plan))
  (let first (call first-offset-crossing spans (:is-closed true)))
  (return-if (if (not first)))
  (blank)
  (let result Path)
  (let saw-contour false)
  (let crossing first)
  (while true
    (let contour (call offset-crossed-contour (. plan path) crossing (. spans length)))
    (if (. contour count)
      (= saw-contour true)
      (let offset (call offset-simple-plan (call OffsetPlan contour) distance join-type miter-limit))
      (if (. offset count)
        (let oriented (if-expr (. offset is-clockwise) offset (call (. offset reverse))))
        (if (. result count)
          (call (. result add-path) oriented)
          (else
            (= result oriented)
          )
        )
      )
    )
    (blank)
    (let next (call next-offset-crossing crossing))
    (if next
      (= crossing next)
      (else
        (break)
      )
    )
  )
  (blank)
  (if saw-contour
    (return (if-expr (. result count) result (call Path)))
  )
)

(fn-expr _ offset-plan-span-ranges (list CurveRangeScalars)
  (param plan OffsetPlan)
  (in (call offset-plan-span-curve each) (. plan spans))
)

(fn-do _ raw-offset-plan _
  (param plan OffsetPlan)
  (param distance Length)
  (param join-type JoinType)
  (param miter-limit Length)
  (let first ([] (. plan spans) 0))
  (let contour
    (call OffsetContour
      (block
        (arg
          (call Point
            (block
              (arg (. first x1))
              (arg (. first y1))
            )
          )
        )
        (arg distance)
        (arg join-type)
        (arg miter-limit)
        (arg (call offset-plan-normal-sign plan))
      )
    )
  )
  (for (in span (. plan spans))
    (if (or (== (. span type) .segment-type-line) (. span is-line-like))
      (call (. contour line-to) (call Point (. span x2) (. span y2)))
      (else
        (call (. contour cubic-to)
          (block
            (arg (call Point (. span hox) (. span hoy)))
            (arg (call Point (. span hix) (. span hiy)))
            (arg (call Point (. span x2) (. span y2)))
          )
        )
      )
    )
  )
  (blank)
  (return (call (. contour finish-raw) (. plan is-closed)))
)

(fn-expr _ offset-plan-normal-sign Float
  (param plan OffsetPlan)
  (case? (and (. plan is-closed) (not (. plan is-clockwise)))
    -1
  )
  (default
    1
  )
)

(fn-expr _ offset-origin-line _
  (param start Point)
  (param end Point)
  (call CurveRangeScalars
    (block
      (arg .segment-type-line)
      (arg (. start x))
      (arg (. start y))
      (arg (. start x))
      (arg (. start y))
      (arg (. end x))
      (arg (. end y))
      (arg (. end x))
      (arg (. end y))
    )
  )
)

(fn-do _ offset-source-spans _
  (param curves (list CurveRangeScalars))
  (let spans (list OffsetPlanSpan))
  (for (in curve curves)
    (+= spans
      (call OffsetPlanSpan
        (block
          (arg (. curve type))
          (arg (. curve x1))
          (arg (. curve y1))
          (arg (. curve hox))
          (arg (. curve hoy))
          (arg (. curve hix))
          (arg (. curve hiy))
          (arg (. curve x2))
          (arg (. curve y2))
          (arg (call offset-span-min-x curve))
          (arg (call offset-span-min-y curve))
          (arg (call offset-span-max-x curve))
          (arg (call offset-span-max-y curve))
          (arg (== (. curve type) .segment-type-line))
        )
      )
    )
  )
  (blank)
  (return spans)
)

(fn-do _ trim-offset-plan _
  (param raw OffsetRawPath)
  (param plan OffsetPlan)
  (param distance Length)
  (if (or (< (. raw spans length) 1) (<= (call abs distance) offset-path-teeny))
    (return (. raw path))
  )
  (blank)
  (let normal-sign (call offset-plan-normal-sign plan))
  (let cuts (call offset-trim-cuts raw plan distance))
  (let samples (call offset-trim-samples raw cuts distance normal-sign))
  (let valid-count Size)
  (for (in sample samples)
    (if (. sample is-valid)
      (+= valid-count 1)
    )
  )
  (blank)
  (if (== valid-count (. samples length))
    (return (. raw path))
  )
  (if (not valid-count)
    (return (call Path))
  )
  (blank)
  (let runs (call offset-trim-runs raw cuts samples distance normal-sign (. plan is-closed)))
  (call link-offset-runs runs offset-path-teeny)
  (call link-offset-runs runs offset-trim-snap)
  (blank)
  (let result (call Path))
  (for (in run runs)
    (if (not (. run has-previous))
      (call append-offset-chain result (. raw spans) run (. plan is-closed))
    )
  )
  (for (in run runs)
    (if (not (. run visited))
      (call append-offset-chain result (. raw spans) run (. plan is-closed))
    )
  )
  (return result)
)

(fn-do _ offset-trim-cuts _
  (param raw OffsetRawPath)
  (param plan OffsetPlan)
  (param distance Length)
  (let spans (. raw spans))
  (let count (. spans length))
  (let bounds (call offset-span-bounds spans))
  (let cuts (list OffsetCut))
  (for (in i (..< 0 (+ count 1)))
    (+= cuts (call OffsetCut (as i Float) (call offset-spans-point-at spans (as i Float)) false))
  )
  (blank)
  (for (in i (..< 0 count))
    (let c1 ([] spans i))
    (for (in j (..< (+ i 1) count))
      (if (call offset-curves-are-adjacent i j count (:is-closed (. plan is-closed)))
        (continue)
      )
      (if (not (call offset-bounds-overlap ([] bounds i) ([] bounds j)))
        (continue)
      )
      (blank)
      (let hits (list CurveIntersection))
      (call append-offset-span-intersections hits c1 ([] spans j) i j)
      (for (in hit hits)
        (let t1 (call offset-clamped-span-parameter (. hit t1) i))
        (let point (call offset-span-point c1 (- t1 i)))
        (+= cuts (call OffsetCut t1 point true))
        (+= cuts (call OffsetCut (call offset-clamped-span-parameter (. hit t2) j) point true))
      )
    )
  )
  (blank)
  (if (not (. plan is-closed))
    (let envelope (call offset-trim-envelope raw plan distance))
    (let envelope-bounds (call offset-span-bounds envelope))
    (for (in i (..< 0 count))
      (let c1 ([] spans i))
      (for (in j (..< 0 (. envelope length)))
        (if (not (call offset-bounds-overlap ([] bounds i) ([] envelope-bounds j)))
          (continue)
        )
        (blank)
        (let hits (list CurveIntersection))
        (call append-offset-span-intersections hits c1 ([] envelope j) i j)
        (for (in hit hits)
          (let t1 (call offset-clamped-span-parameter (. hit t1) i))
          (+= cuts (call OffsetCut t1 (call offset-span-point c1 (- t1 i)) true))
        )
      )
    )
  )
  (blank)
  (return (call sort cuts (:using (=> (a b) (if-expr (< (. a t) (. b t)) .lesser .greater)))))
)

(fn-expr _ offset-clamped-span-parameter PointOnCurve
  (param t PointOnCurve)
  (param curve-index Index)
  (call min (call max t (as curve-index Float)) (as (+ curve-index 1) Float))
)

(fn-do _ offset-trim-envelope _
  (param raw OffsetRawPath)
  (param plan OffsetPlan)
  (param distance Length)
  (let spans (list CurveRangeScalars))
  (for (in span (. (call raw-offset-plan plan (- distance) .round-join-type 1) spans))
    (+= spans span)
  )
  (blank)
  (if (. raw sources length)
    (let first ([] (. raw sources) 0))
    (let last ([] (. raw sources) (- (. raw sources length) 1)))
    (call append-offset-cap-spans spans (call Point (. first x1) (. first y1)) (call abs distance))
    (call append-offset-cap-spans spans (call Point (. last x2) (. last y2)) (call abs distance))
  )
  (blank)
  (return spans)
)

(fn-do _ append-offset-cap-spans _
  (param spans (list CurveRangeScalars))
  (param center Point)
  (param radius Length)
  (let writer (call OffsetPathWriter))
  (= (. writer collect-spans) true)
  (call (. writer line-to) (+ center (call Point radius 0)))
  (call (. writer arc) center radius 0 (* π 2) false)
  (for (in span (. writer spans))
    (+= spans span)
  )
)

(fn-do _ offset-span-bounds _
  (param spans (list CurveRangeScalars))
  (let bounds (list RectScalars))
  (for (in span spans)
    (+= bounds
      (call RectScalars
        (block
          (arg (call offset-span-min-x span))
          (arg (call offset-span-min-y span))
          (arg (call offset-span-max-x span))
          (arg (call offset-span-max-y span))
        )
      )
    )
  )
  (blank)
  (return bounds)
)

(fn-expr _ offset-bounds-overlap _
  (param a RectScalars)
  (param b RectScalars)
  (case? (< (. a max-x) (- (. b min-x) offset-cleanup-tolerance))
    false
  )
  (case? (< (. b max-x) (- (. a min-x) offset-cleanup-tolerance))
    false
  )
  (case? (< (. a max-y) (- (. b min-y) offset-cleanup-tolerance))
    false
  )
  (case? (< (. b max-y) (- (. a min-y) offset-cleanup-tolerance))
    false
  )
  (default
    true
  )
)

(fn-do _ offset-trim-samples _
  (param raw OffsetRawPath)
  (param cuts (list OffsetCut))
  (param distance Length)
  (param normal-sign Float)
  (let samples (list OffsetSample))
  (for (in index (..< 0 (- (. cuts length) 1)))
    (let a (. ([] cuts index) t))
    (let b (. ([] cuts (+ index 1)) t))
    (if (<= (- b a) offset-trim-epsilon)
      (continue)
    )
    (blank)
    (let t (* (+ a b) 0.5))
    (+= samples (call OffsetSample t (call offset-raw-point-is-valid raw t distance normal-sign) index))
  )
  (blank)
  (return samples)
)

(fn-do _ offset-raw-point-is-valid _
  (param raw OffsetRawPath)
  (param t PointOnCurve)
  (param distance Length)
  (param normal-sign Float)
  (let count (. raw spans length))
  (let i (as (call floor t) Index))
  (if (>= i count)
    (= i (- count 1))
  )
  (blank)
  (let local (- t i))
  (let origin ([] (. raw origins) i))
  (let radius (call abs distance))
  (let reach Length radius)
  (let point Point)
  (if (== (. origin type) .segment-type-cubic)
    (= point
      (call offset-cubic-point
        (block
          (arg (call Point (. origin x1) (. origin y1)))
          (arg (call Point (. origin hox) (. origin hoy)))
          (arg (call Point (. origin hix) (. origin hiy)))
          (arg (call Point (. origin x2) (. origin y2)))
          (arg local)
          (arg distance)
          (arg normal-sign)
        )
      )
    )
    (else
      (= point (call offset-span-point ([] (. raw spans) i) local))
      (let foot (call segment-foot point (call Point (. origin x1) (. origin y1)) (call Point (. origin x2) (. origin y2))))
      (let extent (call (. point distance) foot))
      (if (and (> extent (+ radius (call offset-trim-slack radius))) (call offset-sources-cross (. raw sources) foot point))
        (return false)
      )
      (= reach (call min radius extent))
    )
  )
  (blank)
  (return (not (call offset-sources-reach (. raw sources) point (- reach (call offset-trim-slack radius)))))
)

(fn-expr _ offset-trim-slack Length
  (param radius Length)
  (call max 0.0000001 (* radius 0.0000001))
)

(fn-do _ offset-sources-reach _
  (param sources (list OffsetPlanSpan))
  (param point Point)
  (param reach Length)
  (return-if false (if (<= reach 0)))
  (blank)
  (for (in span sources)
    (let dx (call max (call max (- (. span min-x) (. point x)) (- (. point x) (. span max-x))) 0.0))
    (let dy (call max (call max (- (. span min-y) (. point y)) (- (. point y) (. span max-y))) 0.0))
    (if (>= (+ (* dx dx) (* dy dy)) (* reach reach))
      (continue)
    )
    (blank)
    (if (. span is-line-like)
      (let start (call Point (. span x1) (. span y1)))
      (let end (call Point (. span x2) (. span y2)))
      (return-if true (if (< (call point-segment-distance point start end) reach)))
      (else
        (return-if true (if (call offset-cubic-reaches point (call offset-plan-span-curve span) reach 0)))
      )
    )
  )
  (blank)
  (return false)
)

(fn-do _ offset-sources-cross _
  (param sources (list OffsetPlanSpan))
  (param from Point)
  (param to Point)
  (for (in span sources)
    (if (or (< (. span max-x) (call min (. from x) (. to x))) (> (. span min-x) (call max (. from x) (. to x))))
      (continue)
    )
    (if (or (< (. span max-y) (call min (. from y) (. to y))) (> (. span min-y) (call max (. from y) (. to y))))
      (continue)
    )
    (blank)
    (if (. span is-line-like)
      (return-if true (if (call offset-segments-cross from to (call Point (. span x1) (. span y1)) (call Point (. span x2) (. span y2)))))
      (else
        (return-if true (if (call offset-cubic-crosses from to (call offset-plan-span-curve span) 0)))
      )
    )
  )
  (blank)
  (return false)
)

(fn-expr _ offset-segments-cross _
  (param from Point)
  (param to Point)
  (param start Point)
  (param end Point)
  (and (. hit hit) (> (. hit t1) offset-trim-epsilon))
  (where
    (lazy hit (call line-line-intersection-scalars (. from x) (. from y) (. to x) (. to y) (. start x) (. start y) (. end x) (. end y)))
  )
)

(fn-expr _ offset-cubic-crosses Bool
  (param from Point)
  (param to Point)
  (param curve CurveRangeScalars)
  (param depth Int)
  (case? (< (call offset-span-max-x curve) (call min (. from x) (. to x)))
    false
  )
  (case? (> (call offset-span-min-x curve) (call max (. from x) (. to x)))
    false
  )
  (case? (< (call offset-span-max-y curve) (call min (. from y) (. to y)))
    false
  )
  (case? (> (call offset-span-min-y curve) (call max (. from y) (. to y)))
    false
  )
  (case? (or (<= bulge offset-cleanup-tolerance) (>= depth 16))
    (call offset-segments-cross from to p0 p3)
  )
  (default
    (or (call offset-cubic-crosses from to (. split left) (+ depth 1)) right-crosses)
  )
  (where
    (lazy p0 (call Point (. curve x1) (. curve y1)))
    (lazy right-crosses (call offset-cubic-crosses from to (. split right) (+ depth 1)))
    (lazy p3 (call Point (. curve x2) (. curve y2)))
    (lazy p1 (call Point (. curve hox) (. curve hoy)))
    (lazy p2 (call Point (. curve hix) (. curve hiy)))
    (lazy bulge (call max (call point-segment-distance p1 p0 p3) (call point-segment-distance p2 p0 p3)))
    (lazy split
      (call cubic-subdivide-scalars
        (block
          (arg (. curve x1))
          (arg (. curve y1))
          (arg (. curve hox))
          (arg (. curve hoy))
          (arg (. curve hix))
          (arg (. curve hiy))
          (arg (. curve x2))
          (arg (. curve y2))
          (arg 0.5)
        )
      )
    )
  )
)

(fn-expr _ offset-cubic-reaches Bool
  (param point Point)
  (param curve CurveRangeScalars)
  (param reach Length)
  (param depth Int)
  (case? (or (< (call (. point distance) p0) reach) (< (call (. point distance) p3) reach))
    true
  )
  (case? (>= (- chord bulge) reach)
    false
  )
  (case? (or (<= bulge offset-trim-flatness) (>= depth 12))
    (or (< (+ chord bulge) reach) (< (call offset-flat-cubic-distance point curve) reach))
  )
  (default
    (or (call offset-cubic-reaches point (. split left) reach (+ depth 1)) right-reaches)
  )
  (where
    (lazy p0 (call Point (. curve x1) (. curve y1)))
    (lazy right-reaches (call offset-cubic-reaches point (. split right) reach (+ depth 1)))
    (lazy p1 (call Point (. curve hox) (. curve hoy)))
    (lazy p2 (call Point (. curve hix) (. curve hiy)))
    (lazy p3 (call Point (. curve x2) (. curve y2)))
    (lazy chord (call point-segment-distance point p0 p3))
    (lazy bulge (call max (call point-segment-distance p1 p0 p3) (call point-segment-distance p2 p0 p3)))
    (lazy split
      (call cubic-subdivide-scalars
        (block
          (arg (. curve x1))
          (arg (. curve y1))
          (arg (. curve hox))
          (arg (. curve hoy))
          (arg (. curve hix))
          (arg (. curve hiy))
          (arg (. curve x2))
          (arg (. curve y2))
          (arg 0.5)
        )
      )
    )
  )
)

(fn-do _ offset-flat-cubic-distance Length
  (param point Point)
  (param curve CurveRangeScalars)
  (let cx (call cubic-coefficients-1d (. curve x1) (. curve hox) (. curve hix) (. curve x2)))
  (let cy (call cubic-coefficients-1d (. curve y1) (. curve hoy) (. curve hiy) (. curve y2)))
  (let span-x (- (. curve x2) (. curve x1)))
  (let span-y (- (. curve y2) (. curve y1)))
  (let length2 (+ (* span-x span-x) (* span-y span-y)))
  (let t PointOnCurve 0.5)
  (if (> length2 offset-path-teeny)
    (let along (+ (* (- (. point x) (. curve x1)) span-x) (* (- (. point y) (. curve y1)) span-y)))
    (= t (call max 0.0 (call min 1.0 (/ along length2))))
  )
  (blank)
  (let first-x (call cubic-evaluate-1d (. cx a) (. cx b) (. cx c) (. curve x1) t))
  (let first-y (call cubic-evaluate-1d (. cy a) (. cy b) (. cy c) (. curve y1) t))
  (let first (call (. point distance) (call Point first-x first-y)))
  (for (in step (..< 0 8))
    (let dx (- (call cubic-evaluate-1d (. cx a) (. cx b) (. cx c) (. curve x1) t) (. point x)))
    (let dy (- (call cubic-evaluate-1d (. cy a) (. cy b) (. cy c) (. curve y1) t) (. point y)))
    (let vx (call cubic-derivative-1d (. cx a) (. cx b) (. cx c) t))
    (let vy (call cubic-derivative-1d (. cy a) (. cy b) (. cy c) t))
    (let ax (+ (* 6.0 (. cx a) t) (* 2.0 (. cx b))))
    (let ay (+ (* 6.0 (. cy a) t) (* 2.0 (. cy b))))
    (let slope (+ (* vx vx) (* vy vy) (* dx ax) (* dy ay)))
    (if (<= (call abs slope) offset-path-teeny)
      (break)
    )
    (blank)
    (let next (call max 0.0 (call min 1.0 (- t (/ (+ (* dx vx) (* dy vy)) slope)))))
    (let settled (<= (call abs (- next t)) offset-trim-epsilon))
    (= t next)
    (if settled
      (break)
    )
  )
  (blank)
  (let x (call cubic-evaluate-1d (. cx a) (. cx b) (. cx c) (. curve x1) t))
  (let y (call cubic-evaluate-1d (. cy a) (. cy b) (. cy c) (. curve y1) t))
  (return (call min first (call (. point distance) (call Point x y))))
)

(fn-do _ offset-trim-runs _
  (param raw OffsetRawPath)
  (param cuts (list OffsetCut))
  (param samples (list OffsetSample))
  (param distance Length)
  (param normal-sign Float)
  (param is-closed Bool)
  (let runs (list OffsetRun))
  (let count (. samples length))
  (let first Index 0)
  (if is-closed
    (while (. ([] samples first) is-valid)
      (+= first 1)
    )
  )
  (blank)
  (let was-valid false)
  (let run-start ([] cuts 0))
  (for (in step (..< 0 count))
    (let index (% (+ first step) count))
    (let sample ([] samples index))
    (if (== (. sample is-valid) was-valid)
      (continue)
    )
    (blank)
    (let edge ([] cuts 0))
    (if (> step 0)
      (= edge
        (call offset-trim-transition
          (block
            (arg raw)
            (arg cuts)
            (arg ([] samples (% (- (+ index count) 1) count)))
            (arg sample)
            (arg distance)
            (arg normal-sign)
          )
        )
      )
    )
    (if (. sample is-valid)
      (= run-start edge)
      (else
        (call append-offset-run runs run-start edge)
      )
    )
    (= was-valid (. sample is-valid))
  )
  (blank)
  (if (and was-valid is-closed)
    (call append-offset-run
      (block
        (arg runs)
        (arg run-start)
        (arg
          (call offset-trim-transition
            (block
              (arg raw)
              (arg cuts)
              (arg ([] samples (% (- (+ first count) 1) count)))
              (arg ([] samples first))
              (arg distance)
              (arg normal-sign)
            )
          )
        )
      )
    )
    (else-if was-valid
      (call append-offset-run runs run-start ([] cuts (- (. cuts length) 1)))
    )
  )
  (blank)
  (return runs)
)

(fn-do _ append-offset-run _
  (param runs (list OffsetRun))
  (param start OffsetCut)
  (param end OffsetCut)
  (if (> (call abs (- (. end t) (. start t))) offset-trim-epsilon)
    (+= runs (call OffsetRun start end))
  )
)

(fn-do _ offset-trim-transition _
  (param raw OffsetRawPath)
  (param cuts (list OffsetCut))
  (param before OffsetSample)
  (param after OffsetSample)
  (param distance Length)
  (param normal-sign Float)
  (let index (+ (. before cut) 1))
  (while true
    (let cut ([] cuts index))
    (return-if cut (if (. cut is-crossing)))
    (blank)
    (if (== index (. after cut))
      (break)
    )
    (+= index 1)
    (if (>= index (. cuts length))
      (= index 0)
    )
  )
  (blank)
  (let count (as (. raw spans length) Float))
  (let low (. before t))
  (let high (if-expr (> (. after t) (. before t)) (. after t) (+ (. after t) count)))
  (for (in step (..< 0 48))
    (let middle (* (+ low high) 0.5))
    (let t (if-expr (< middle count) middle (- middle count)))
    (if (== (call offset-raw-point-is-valid raw t distance normal-sign) (. before is-valid))
      (= low middle)
      (else
        (= high middle)
      )
    )
  )
  (blank)
  (let edge (if-expr (. before is-valid) low high))
  (if (and (>= edge count) (< (. after t) (. before t)))
    (-= edge count)
  )
  (blank)
  (let point (call offset-spans-point-at (. raw spans) edge))
  (let lower ([] cuts (. before cut)))
  (let upper ([] cuts (+ (. after cut) 1)))
  (case? (and (. lower is-crossing) (< (call (. lower point distance) point) offset-trim-snap))
    (return lower)
  )
  (case? (and (. upper is-crossing) (< (call (. upper point distance) point) offset-trim-snap))
    (return upper)
  )
  (default
    (return (call OffsetCut edge point false))
  )
)

(fn-do _ link-offset-runs _
  (param runs (list OffsetRun))
  (param tolerance Length)
  (for (in run runs)
    (if (. run next)
      (continue)
    )
    (blank)
    (let best (? OffsetRun))
    (let best-gap tolerance)
    (for (in candidate runs)
      (if (. candidate has-previous)
        (continue)
      )
      (let gap (call (. run end point distance) (. candidate start point)))
      (if (<= gap best-gap)
        (= best candidate)
        (= best-gap gap)
      )
    )
    (blank)
    (if best
      (= (. run next) best)
      (= (. best has-previous) true)
    )
  )
)

(fn-do _ append-offset-chain _
  (param target Path)
  (param spans (list CurveRangeScalars))
  (param first OffsetRun)
  (param is-closed Bool)
  (call (. target move-to) (. first start point))
  (let run first)
  (let loops false)
  (while true
    (= (. run visited) true)
    (let next (. run next))
    (= loops (== next first))
    (call append-offset-run-spans target spans run loops)
    (if (or (not next) loops (. next visited))
      (break)
    )
    (blank)
    (if (> (call (. run end point distance) (. next start point)) offset-path-teeny)
      (call (. target line-to) (. next start point))
    )
    (= run next)
  )
  (blank)
  (if (or loops is-closed)
    (call (. target close))
  )
)

(fn-do _ append-offset-run-spans _
  (param target Path)
  (param spans (list CurveRangeScalars))
  (param run OffsetRun)
  (param closes Bool)
  (let count (as (. spans length) Float))
  (if (> (. run end t) (. run start t))
    (call append-offset-span-range target spans (. run start t) (. run end t) (. run end point) closes)
    (else
      (call append-offset-span-range
        (block
          (arg target)
          (arg spans)
          (arg (. run start t))
          (arg count)
          (arg (call offset-spans-point-at spans count))
          (arg false)
        )
      )
      (call append-offset-span-range target spans 0 (. run end t) (. run end point) closes)
    )
  )
)

(fn-do _ append-offset-span-range _
  (param target Path)
  (param spans (list CurveRangeScalars))
  (param t1 PointOnCurve)
  (param t2 PointOnCurve)
  (param end Point)
  (param closes Bool)
  (return-if (if (<= t2 (+ t1 offset-trim-epsilon))))
  (blank)
  (let count (. spans length))
  (let start-curve (as (call floor t1) Index))
  (let end-curve (as (call floor t2) Index))
  (let local1 (- t1 start-curve))
  (let local2 (- t2 end-curve))
  (if (>= end-curve count)
    (= end-curve (- count 1))
    (= local2 1)
    (else-if (<= local2 offset-trim-epsilon)
      (-= end-curve 1)
      (= local2 1)
    )
  )
  (blank)
  (for (in i (..< start-curve (+ end-curve 1)))
    (let a (if-expr (== i start-curve) local1 0))
    (let b (if-expr (== i end-curve) local2 1))
    (if (<= b (+ a offset-trim-epsilon))
      (continue)
    )
    (blank)
    (let span ([] spans i))
    (if (== (. span type) .segment-type-line)
      (if (!= i end-curve)
        (call (. target line-to) (+ (. span x1) (* (- (. span x2) (. span x1)) b)) (+ (. span y1) (* (- (. span y2) (. span y1)) b)))
        (else-if (not closes)
          (call (. target line-to) end)
        )
      )
      (else
        (let piece
          (call cubic-range-scalars
            (block
              (arg (. span x1))
              (arg (. span y1))
              (arg (. span hox))
              (arg (. span hoy))
              (arg (. span hix))
              (arg (. span hiy))
              (arg (. span x2))
              (arg (. span y2))
              (arg a)
              (arg b)
            )
          )
        )
        (if (!= i end-curve)
          (call (. target cubic-curve-to) (. piece hox) (. piece hoy) (. piece hix) (. piece hiy) (. piece x2) (. piece y2))
          (else
            (call (. target cubic-curve-to) (. piece hox) (. piece hoy) (. piece hix) (. piece hiy) (. end x) (. end y))
          )
        )
      )
    )
  )
)

(fn-do _ offset-crossed-contour _
  (param raw Path)
  (param crossing OffsetCrossing)
  (param span-count Size)
  (let contour Path)
  (let start crossing)
  (if (not (. crossing visited))
    (while true
      (= (. crossing visited) true)
      (let next (. crossing next))
      (if (not next)
        (break)
      )
      (blank)
      (call append-offset-raw-range contour raw (+ (. crossing i) (. crossing t)) (+ (. next i) (. next t)) span-count)
      (= crossing (!! (. next counter)))
      (if (== crossing start)
        (break)
      )
    )
  )
  (blank)
  (if (. contour count)
    (call (. contour close))
  )
  (blank)
  (return contour)
)

(fn-do _ append-offset-raw-range _
  (param target Path)
  (param raw Path)
  (param t1 PointOnCurve)
  (param t2 PointOnCurve)
  (param span-count Size)
  (return-if (if (== t1 t2)))
  (blank)
  (if (> t1 t2)
    (call append-offset-raw-range-forward target raw t1 (as span-count Float) span-count)
    (call append-offset-raw-range-forward target raw 0 t2 span-count)
    (else
      (call append-offset-raw-range-forward target raw t1 t2 span-count)
    )
  )
)

(fn-do _ append-offset-raw-range-forward _
  (param target Path)
  (param raw Path)
  (param t1 PointOnCurve)
  (param t2 PointOnCurve)
  (param span-count Size)
  (return-if (if (<= t2 (+ t1 offset-path-teeny))))
  (blank)
  (let start-curve (as (call floor t1) Index))
  (let end-curve (as (call floor t2) Index))
  (let local1 (- t1 start-curve))
  (let local2 (- t2 end-curve))
  (if (>= end-curve span-count)
    (= end-curve (- span-count 1))
    (= local2 1)
    (else-if (and (<= local2 offset-path-teeny) (> t2 t1))
      (-= end-curve 1)
      (= local2 1)
    )
  )
  (blank)
  (for (in i (..< start-curve (+ end-curve 1)))
    (let a (if-expr (== i start-curve) local1 0))
    (let b (if-expr (== i end-curve) local2 1))
    (if (<= b (+ a offset-path-teeny))
      (continue)
    )
    (call (. target add-curve-range) raw i a b)
  )
)

(fn-do _ first-offset-crossing _
  (param spans (list CurveRangeScalars))
  (param is-closed Bool)
  (let crossings (list OffsetCrossing))
  (let count (. spans length))
  (for (in i (..< 0 count))
    (let c1 ([] spans i))
    (for (in j (..< (+ i 1) count))
      (let c2 ([] spans j))
      (let both-lines (and (call offset-span-is-line c1) (call offset-span-is-line c2)))
      (if (and both-lines (call offset-curves-are-adjacent i j count is-closed))
        (continue)
      )
      (if (not (call offset-raw-span-bounds-overlap c1 c2))
        (continue)
      )
      (blank)
      (let hits (list CurveIntersection))
      (call append-offset-span-intersections hits c1 c2 i j)
      (for (in hit hits)
        (if (or (call offset-is-endpoint-hit (. hit t1) i) (call offset-is-endpoint-hit (. hit t2) j))
          (continue)
        )
        (blank)
        (let local1 (- (. hit t1) i))
        (let local2 (- (. hit t2) j))
        (let pt (call offset-span-point c1 local1))
        (let a (call OffsetCrossing i local1 pt))
        (let b (call OffsetCrossing j local2 pt))
        (= (. a counter) b)
        (= (. b counter) a)
        (+= crossings a)
        (+= crossings b)
      )
    )
  )
  (blank)
  (return-if (if (not crossings)))
  (blank)
  (= crossings (call sort crossings (:using (=> (a b) (if-expr (< (+ (. a i) (. a t)) (+ (. b i) (. b t))) .lesser .greater)))))
  (blank)
  (let prev (? OffsetCrossing))
  (for (in crossing crossings)
    (= (?. prev next) crossing)
    (= (. crossing previous) prev)
    (= prev crossing)
  )
  (blank)
  (let first ([] crossings 0))
  (= (. first previous) prev)
  (= (?. prev next) first)
  (return first)
)

(fn-do _ next-offset-crossing _
  (param first OffsetCrossing)
  (let crossing first)
  (while true
    (if (not (. crossing visited))
      (return crossing)
    )
    (= crossing (!! (. crossing next)))
    (if (== crossing first)
      (break)
    )
  )
)

(fn-expr _ offset-span-point _
  (param span CurveRangeScalars)
  (param t PointOnCurve)
  (case? (== (. span type) .segment-type-line)
    (call Point (+ (. span x1) (* (- (. span x2) (. span x1)) t)) (+ (. span y1) (* (- (. span y2) (. span y1)) t)))
  )
  (default
    (call cubic-point
      (block
        (arg
          (call Point
            (block
              (arg (. span x1))
              (arg (. span y1))
            )
          )
        )
        (arg
          (call Point
            (block
              (arg (. span hox))
              (arg (. span hoy))
            )
          )
        )
        (arg
          (call Point
            (block
              (arg (. span hix))
              (arg (. span hiy))
            )
          )
        )
        (arg
          (call Point
            (block
              (arg (. span x2))
              (arg (. span y2))
            )
          )
        )
        (arg t)
      )
    )
  )
)

(fn-expr _ offset-raw-span-bounds-overlap _
  (param a CurveRangeScalars)
  (param b CurveRangeScalars)
  (not (or a-left-of-b b-left-of-a a-above-b b-above-a))
  (where
    (lazy a-left-of-b (< (call offset-span-max-x a) (- (call offset-span-min-x b) offset-cleanup-tolerance)))
    (lazy b-left-of-a (< (call offset-span-max-x b) (- (call offset-span-min-x a) offset-cleanup-tolerance)))
    (lazy a-above-b (< (call offset-span-max-y a) (- (call offset-span-min-y b) offset-cleanup-tolerance)))
    (lazy b-above-a (< (call offset-span-max-y b) (- (call offset-span-min-y a) offset-cleanup-tolerance)))
  )
)

(fn-expr _ offset-span-min-x _
  (param span CurveRangeScalars)
  (call min (call min (. span x1) (. span hox)) (call min (. span hix) (. span x2)))
)

(fn-expr _ offset-span-max-x _
  (param span CurveRangeScalars)
  (call max (call max (. span x1) (. span hox)) (call max (. span hix) (. span x2)))
)

(fn-expr _ offset-span-min-y _
  (param span CurveRangeScalars)
  (call min (call min (. span y1) (. span hoy)) (call min (. span hiy) (. span y2)))
)

(fn-expr _ offset-span-max-y _
  (param span CurveRangeScalars)
  (call max (call max (. span y1) (. span hoy)) (call max (. span hiy) (. span y2)))
)

(fn-expr _ offset-span-is-line _
  (param span CurveRangeScalars)
  (case? (== (. span type) .segment-type-line)
    true
  )
  (default
    (call line-like-scalars
      (block
        (arg (. span x1))
        (arg (. span y1))
        (arg (. span hox))
        (arg (. span hoy))
        (arg (. span hix))
        (arg (. span hiy))
        (arg (. span x2))
        (arg (. span y2))
      )
    )
  )
)

(fn-do _ append-offset-span-intersections _
  (param hits (list CurveIntersection))
  (param c1 CurveRangeScalars)
  (param c2 CurveRangeScalars)
  (param i Index)
  (param j Index)
  (let line1 (call offset-span-is-line c1))
  (let line2 (call offset-span-is-line c2))
  (if (and line1 line2)
    (call intersect-line-line-scalars
      (block
        (arg hits)
        (arg (. c1 x1))
        (arg (. c1 y1))
        (arg (. c1 x2))
        (arg (. c1 y2))
        (arg (. c2 x1))
        (arg (. c2 y1))
        (arg (. c2 x2))
        (arg (. c2 y2))
        (arg i)
        (arg j)
        (arg null)
        (arg null)
      )
    )
    (else-if line1
      (call intersect-line-curve-scalars
        (block
          (arg hits)
          (arg (. c1 x1))
          (arg (. c1 y1))
          (arg (. c1 x2))
          (arg (. c1 y2))
          (arg (. c2 x1))
          (arg (. c2 y1))
          (arg (. c2 hox))
          (arg (. c2 hoy))
          (arg (. c2 hix))
          (arg (. c2 hiy))
          (arg (. c2 x2))
          (arg (. c2 y2))
          (arg i)
          (arg j)
          (arg null)
          (arg null)
        )
      )
    )
    (else-if line2
      (call intersect-curve-line-scalars
        (block
          (arg hits)
          (arg (. c1 x1))
          (arg (. c1 y1))
          (arg (. c1 hox))
          (arg (. c1 hoy))
          (arg (. c1 hix))
          (arg (. c1 hiy))
          (arg (. c1 x2))
          (arg (. c1 y2))
          (arg (. c2 x1))
          (arg (. c2 y1))
          (arg (. c2 x2))
          (arg (. c2 y2))
          (arg i)
          (arg j)
          (arg null)
          (arg null)
        )
      )
    )
    (else
      (let curve1 (call Curve (tuple (. c1 x1) (. c1 y1)) (tuple (. c1 hox) (. c1 hoy)) (tuple (. c1 hix) (. c1 hiy)) (tuple (. c1 x2) (. c1 y2)) (. c1 type)))
      (let curve2 (call Curve (tuple (. c2 x1) (. c2 y1)) (tuple (. c2 hox) (. c2 hoy)) (tuple (. c2 hix) (. c2 hiy)) (tuple (. c2 x2) (. c2 y2)) (. c2 type)))
      (call intersect-curves hits curve1 curve2 0 i j null null)
    )
  )
)

(fn-expr _ offset-spans-point-at _
  (param spans (list CurveRangeScalars))
  (param t PointOnCurve)
  (case? (<= t 0)
    (call offset-span-point ([] spans 0) 0)
  )
  (case? (>= t count)
    (call offset-span-point ([] spans (- count 1)) 1)
  )
  (default
    (call offset-span-point ([] spans i) (- t i))
  )
  (where
    (lazy count (. spans length))
    (lazy i (as (call floor t) Index))
  )
)

(fn-expr _ offset-curves-are-adjacent _
  (param i Index)
  (param j Index)
  (param count Size)
  (param is-closed Bool)
  (case? (== j (+ i 1))
    true
  )
  (default
    (and is-closed (== i 0) (== j (- count 1)))
  )
)

(fn-expr _ offset-is-endpoint-hit _
  (param t PointOnCurve)
  (param curve-index Index)
  (or (<= local offset-cleanup-tolerance) (>= local (- 1 offset-cleanup-tolerance)))
  (where
    (lazy local (- t curve-index))
  )
)

(fn-do _ offset-special-plan _
  (param plan OffsetPlan)
  (param distance Float)
  (param join-type JoinType)
  (param miter-limit Length)
  (if (. plan is-closed)
    (let rect (call axis-rect-plan plan))
    (if (and rect (or (< distance 0) (and (== join-type .miter-join-type) miter-ok)))
      (let expanded (call (. rect inflate) (* distance 2) (* distance 2)))
      (if (or (<= (. expanded width) 0) (<= (. expanded height) 0))
        (return (call Path))
      )
      (return (call rectangle expanded))
    )
    (lazy miter-ok (call offset-convex-polygon-miter-limit-ok plan miter-limit))
    (else
      (return (call straight-line-offset (. plan path) distance))
    )
  )
)

(fn-do _ axis-rect-plan _
  (param plan OffsetPlan)
  (return-if (if (not (. plan is-closed))))
  (return-if (if (not (. plan is-all-lines))))
  (return-if (if (!= (. plan spans length) 4)))
  (blank)
  (let bbox (. plan bounds))
  (let has-top-left false)
  (let has-top-right false)
  (let has-bottom-right false)
  (let has-bottom-left false)
  (blank)
  (for (in span (. plan spans))
    (return-if (if (not (call axis-rect-segment-xy (. span x1) (. span y1) (. span x2) (. span y2)))))
    (blank)
    (if (call near-corner-xy (. span x1) (. span y1) (. bbox left) (. bbox top))
      (= has-top-left true)
      (else-if (call near-corner-xy (. span x1) (. span y1) (. bbox right) (. bbox top))
        (= has-top-right true)
      )
      (else-if (call near-corner-xy (. span x1) (. span y1) (. bbox right) (. bbox bottom))
        (= has-bottom-right true)
      )
      (else-if (call near-corner-xy (. span x1) (. span y1) (. bbox left) (. bbox bottom))
        (= has-bottom-left true)
      )
      (else
        (return)
      )
    )
  )
  (return-if (if (not has-top-left)))
  (return-if (if (not has-top-right)))
  (return-if (if (not has-bottom-right)))
  (return-if (if (not has-bottom-left)))
  (blank)
  (return bbox)
)
