(import /graphics/canvas)
(import /graphics/color)
(import /graphics/fields)
(import /graphics/graphic)
(import /graphics/matrix)
(import /graphics/offset)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/vector)
(import /graphics/vector-group)
(import /math)
(import /stream/aggregate)
(import /stream/coincidence)
(import /stream/combine)
(import /units)

(type + LatticeType (is U8)
  (variant triangle-lattice)
  (variant diamond-lattice)
  (variant hexagon-lattice)
  (variant custom-lattice)
)

(type + LatticeImage (is VectorGroup)
  (prop + type LatticeType (= .custom-lattice))
  (prop + offset-x Coord (= 0))
  (prop + offset-y Coord (= 0))
  (prop + margin-x Coord (= 0))
  (prop + margin-y Coord (= 0))
  (prop + spacing-x Coord (= 0))
  (prop + spacing-y Coord (= 0))
  (prop + mirrored _ (= false))
  (blank)
  (depends lattice-image-changed type offset-x offset-y margin-x margin-y spacing-x spacing-y mirrored)
  (fn-do + This _
    (= paints-generated-result true)
  )
  (fn-do + lattice-image-changed _
    (call graphic-invalidate graphic-change-geometry)
  )
  (fn-do + draw _
    (param bounds Rect)
    (let drawing-bounds (call (. bounds pad) margin-x margin-y))
    (blank)
    (let stamp ([] graphics 0))
    (let bbox (. stamp bounding-box))
    (let grid (call get-grid drawing-bounds bbox))
    ; stamp.translate(bounds.center)
    ; <<= stamp.paths
    (blank)
    (for (in (tuple i row) (call indexed grid))
      (for (in (tuple j cell) (call indexed row))
        ; if random(0, 10) % 2 == 0
        ; if (j == 0 || j == row.length - 1 || i == 0 || i == grid.length - 1) && random(0, 2) % 2 == 1
        ; continue
        (blank)
        (call (. stamp reset))
        ; -- stamp.bounding-box
        (call (. stamp scale) (. stamp bounding-box) bbox)
        (call (. stamp translate) (- (. bbox top-left)))
        (call (. stamp apply-transform) cell)
        (yield-all (. stamp paths))
      )
    )
  )
  (fn-expr + get-grid _
    (param bounds Rect)
    (param bbox Rect)
    (case? (== type .triangle-lattice)
      (call get-offset-grid bounds bbox 2 0 (:is-mirrored true))
    )
    (case? (== type .diamond-lattice)
      (call get-offset-grid bounds bbox 2 2)
    )
    (case? (== type .hexagon-lattice)
      (call get-offset-grid bounds bbox 2 4)
    )
    (default
      (call get-offset-grid bounds bbox offset-x offset-y mirrored)
    )
  )
  (fn-do + get-offset-grid _
    (param bounds Rect)
    (param bbox Rect)
    (param x-offset Coord)
    (param y-offset Coord)
    (param is-mirrored _ (= false))
    (let rows (list (of List Matrix)))
    (blank)
    (let real-spacing-x
      (block
        (case? (not is-mirrored)
          spacing-x
        )
        (default
          (* spacing-x 2.5)
        )
      )
    )
    (blank)
    (let pidge-x Coord 0)
    (if x-offset
      (= pidge-x (/ (. bbox width) x-offset))
    )
    (blank)
    (let pidge-y Coord 0)
    (if y-offset
      (= pidge-y (/ (. bbox height) y-offset))
    )
    (blank)
    (let x-incr (+ (. bbox width) real-spacing-x))
    (let y-overflow (+ pidge-y (/ (. bbox height) 2)))
    (let y-start (- (. bounds y) y-overflow))
    (let y-incr (+ (- (. bbox height) pidge-y) spacing-y))
    (blank)
    (let alt-y false)
    (for (in y (..< y-start (+ (. bounds bottom) y-overflow) (by: y-incr)))
      (let x-start
        (block
          (case? alt-y
            (+ (- (. bounds x) pidge-x) (/ real-spacing-x 2))
          )
          (default
            (+ (. bounds x) (if-expr is-mirrored (/ real-spacing-x 2) real-spacing-x))
          )
        )
      )
      (blank)
      (let row (list Matrix))
      (blank)
      (for (in x (..< x-start (+ (. bounds right) pidge-x) (by: x-incr)))
        (let matrix (call matrix-from-translation (call Point x y)))
        (+= row matrix)
      )
      (blank)
      (if is-mirrored
        (let x-start2
          (block
            (case? alt-y
              (+ (. bounds x) real-spacing-x)
            )
            (default
              (- (. bounds x) pidge-x)
            )
          )
        )
        (blank)
        (for (in x (..< x-start2 (+ (. bounds right) pidge-x) (by: x-incr)))
          (let matrix (call Matrix))
          (= matrix (call (. matrix scale) (tuple 1 -1)))
          (= matrix (call (. matrix translate) (call Point x (+ (- (. bbox height)) (- y)))))
          (+= row matrix)
        )
      )
      (blank)
      (+= rows row)
      (= alt-y (not alt-y))
    )
    (blank)
    (return rows)
  )
)

(type + CutImage (is VectorGroup)
  (prop + cut-spacing (of Streamer This Percent) (= 0%))
  (prop + cut-count (of Getter Coord) (= (=> () 1px)))
  (blank)
  (depends cut-image-changed cut-spacing cut-count)
  (fn-do + This _
    (= paints-generated-result true)
  )
  (fn-do + cut-image-changed _
    (call graphic-invalidate graphic-change-geometry)
  )
  (fn-do + draw _
    (for (in path child-paths)
      (for (in (tuple t1 t2) (call get-split-ranges path))
        (yield (call (. path split-at-range) t1 t2))
      )
    )
  )
  (fn-do + get-split-ranges _
    (param shape Path)
    (for (in (tuple d1 d2) (call get-split-distances shape))
      (yield
        (call Tuple
          (block
            (arg (call (. shape get-parameter-at-distance) d1))
            (arg (call (. shape get-parameter-at-distance) d2))
          )
        )
      )
    )
  )
  (fn-do + get-split-distances _
    (param shape Path)
    (lazy cuts (call cut-count))
    (lazy incr (/ (. shape length) cuts))
    (lazy cut-space (call cut-spacing this))
    (blank)
    (let tolerance 1)
    (let limit (- (. shape length) tolerance))
    (let d 0px)
    (let f1 0px)
    (while (< d limit)
      (let shift1 (/ (* (/ (as (call abs (?? (<- cut-space) 0)) Float) 50.0) incr) 2))
      (let d1 (+ d shift1))
      (if (>= d1 limit)
        (break)
      )
      (blank)
      (if (not f1)
        (= f1 d1)
      )
      (let shift2 (/ (* (/ (as (call abs (?? (<- cut-space) 0)) Float) 50.0) incr) 2))
      (let d2 (+ d1 (- incr shift2)))
      (if (>= d2 limit)
        (= d2 (if-expr (not (. shape is-closed)) limit (- f1 shift2)))
        (if (== d2 0)
          (= d2 limit)
        )
        (yield (tuple d1 d2))
        (break)
        (else
          (yield (tuple d1 d2))
          (= d d2)
        )
      )
    )
  )
)

(type + VectorGroupStamp (is Tuple)
  (prop + layer VectorGroup)
  (prop + bounding-box Rect)
)

(type + ConcentricImage (is VectorGroup)
  (prop + center Point)
  (prop + min-radius _ (= 1px))
  (prop + max-radius _ (= 2px))
  (prop + spacing _ (= 1px))
  (prop + shaking (of Streamer This Coord) (= 1px))
  (prop + is-cumulative _ (= false))
  (blank)
  (depends concentric-image-changed center min-radius max-radius spacing shaking is-cumulative)
  (fn-do + This _
    (= paints-generated-result true)
  )
  (fn-do + concentric-image-changed _
    (call graphic-invalidate graphic-change-geometry)
  )
  (fn-do + draw _
    (for (in midpoint shaker)
      (and-for (in rad (..< min-radius max-radius (by: spacing))))
      (and-for (in (tuple stamp origin-bbox) (call redrawn-templates center))
        (let ratio (/ (. origin-bbox size height) (. origin-bbox size width)))
        (let size (call Dimensions (* rad 2) (* rad 2 ratio)))
        (let xbbox (call Rect center size))
        (call (. stamp scale) origin-bbox xbbox)
        ; -- xbbox.size, stamp.bounding-box.size
        (call (. stamp translate) midpoint)
        ; <= rectangle(xbbox + midpoint)
        (yield-all (. stamp paths))
      )
    )
  )
  (fn-expr + shaker _ :get
    (if-expr is-cumulative shake-cumulative shake-concentric)
  )
  (fn-expr + shake-concentric _ :get
    (call shaking this)
    (pipe |> pairwise)
    (pipe *> (call Point (. each a) (. each b)))
  )
  (fn-expr + shake-cumulative _ :get
    (call shaking this)
    (pipe |> pairwise)
    (pipe *> (call Point (. each a) (. each b)))
    (pipe |> (call scan (call Point) (:using sum-reduce)))
  )
  (fn-do + cloned-templates (stream VectorGroupStamp)
    (param offset _ (= (call Point)))
    (for (in stamp layers)
      (let bbox (. stamp bounding-box))
      (let origin-bbox (call Rect center (. bbox size)))
      (call (. stamp translate) (+ (- (- (. bbox top-left)) (call Point (/ (. bbox size width) 2) (/ (. bbox size height) 2))) offset))
      (blank)
      (while true
        (yield (tuple (call VectorGroup (. stamp paths)) origin-bbox))
      )
    )
  )
  (fn-do + redrawn-templates (stream VectorGroupStamp)
    (param offset _ (= (call Point)))
    (for (in stamp layers)
      (call (. stamp reset))
      (let bbox (. stamp bounding-box))
      (let origin-bbox (call Rect center (. bbox size)))
      (blank)
      (while true
        (call (. stamp translate) (+ (- (- (. bbox top-left)) (call Point (/ (. bbox size width) 2) (/ (. bbox size height) 2))) offset))
        ; -- origin-bbox.size
        ; -- stamp.bounding-box.size
        ; -- " "
        (yield (tuple stamp origin-bbox))
        (call (. stamp reset))
      )
    )
  )
)
