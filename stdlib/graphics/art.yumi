╌╌╌╌╌╌╌╌╌╌ is VectorGroup ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do draw

for midpoint in shaker
and rad in min-radius .. < max-radius by spacing
and stamp, origin-bbox in redrawn-templates(center)
    . ratio = origin-bbox.size.height / origin-bbox.size.width
    . size = Dimensions(rad * 2, rad * 2 * ratio)
    . xbbox = Rect(center, size)
    stamp.scale(origin-bbox, xbbox)
    ` -- xbbox.size, stamp.bounding-box.size
    stamp.translate(midpoint)
    ` <= rectangle(xbbox + midpoint)
    <<= stamp.paths

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get shaker

if is-cumulative then shake-cumulative else shake-concentric

────────────────────
+ get shake-concentric

shaking(this)
|> pairwise
*> Point(each.a, each.b)

────────────────────
+ get shake-cumulative

shaking(this)
|> pairwise
*> Point(each.a, each.b)
|> scan(Point()) • using sum-reduce

────────────────────
+ do cloned-templates <VectorGroupStamp>
    - offset = Point()

for stamp in layers
    . bbox = stamp.bounding-box
    . origin-bbox = Rect(center, bbox.size)
    stamp.translate(-bbox.top-left - Point(bbox.size.width / 2, bbox.size.height / 2) + offset)

    while true
        <= VectorGroup(stamp.paths), origin-bbox

────────────────────
+ do redrawn-templates <VectorGroupStamp>
    - offset = Point()

for stamp in layers
    stamp.reset()
    . bbox = stamp.bounding-box
    . origin-bbox = Rect(center, bbox.size)

    while true
        stamp.translate(-bbox.top-left - Point(bbox.size.width / 2, bbox.size.height / 2) + offset)
        ` -- origin-bbox.size
        ` -- stamp.bounding-box.size
        ` -- " "
        <= stamp, origin-bbox
        stamp.reset()
