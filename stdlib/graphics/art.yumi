╌╌╌╌╌╌╌╌╌╌ is VectorGroup ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do draw
    - bounds Rect

. drawing-bounds = bounds.pad(margin-x, margin-y)

. stamp = graphics[0]
. bbox = stamp.bounding-box
. grid = get-grid(drawing-bounds, bbox)
` stamp.translate(bounds.center)
` <<= stamp.paths

for i, row in indexed(grid)
    for j, cell in indexed(row)
        ` if random(0, 10) % 2 == 0
        ` if (j == 0 || j == row.length - 1 || i == 0 || i == grid.length - 1) && random(0, 2) % 2 == 1
            ` continue

        stamp.reset()
        ` -- stamp.bounding-box
        stamp.scale(stamp.bounding-box, bbox)
        stamp.translate(-bbox.top-left)
        stamp.apply-transform(cell)
        <<= stamp.paths

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get-grid
    - bounds Rect
    - bbox Rect

|? type == .triangle-lattice
    get-offset-grid(bounds, bbox, 2, 0) • is mirrored
|? type == .diamond-lattice
    get-offset-grid(bounds, bbox, 2, 2)
|? type == .hexagon-lattice
    get-offset-grid(bounds, bbox, 2, 4)
??
    get-offset-grid(bounds, bbox, offset-x, offset-y, mirrored)

────────────────────
+ do get-offset-grid
    - bounds Rect
    - bbox Rect
    - x-offset Coord
    - y-offset Coord
    - is-mirrored = false

. rows [List'Matrix]

. real-spacing-x =
    |? !is-mirrored
        spacing-x
    ??
        spacing-x * 2.5

. pidge-x Coord = 0
if x-offset
    pidge-x = bbox.width / x-offset

. pidge-y Coord = 0
if y-offset
    pidge-y = bbox.height / y-offset

. x-incr = bbox.width + real-spacing-x
. y-overflow = pidge-y + bbox.height / 2
. y-start = bounds.y - y-overflow
. y-incr = bbox.height - pidge-y + spacing-y

. alt-y = false
for y in y-start .. < bounds.bottom + y-overflow by y-incr
    . x-start =
        |? alt-y
            bounds.x - pidge-x + real-spacing-x / 2
        ??
            bounds.x + (if is-mirrored then real-spacing-x / 2 else real-spacing-x)

    . row [Matrix]

    for x in x-start .. < bounds.right + pidge-x by x-incr
        . matrix = matrix-from-translation(Point(x, y))
        row += matrix

    if is-mirrored
        . x-start2 =
            |? alt-y
                bounds.x + real-spacing-x
            ??
                bounds.x - pidge-x

        for x in x-start2 .. < bounds.right + pidge-x by x-incr
            . matrix = Matrix()
            matrix = matrix.scale((1, -1))
            matrix = matrix.translate(Point(x, -bbox.height + -y))
            row += matrix

    rows += row
    alt-y = !alt-y

= rows

