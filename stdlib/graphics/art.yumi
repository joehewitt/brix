╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do get-split-ranges
    - shape Path

for d1, d2 in get-split-distances(shape)
    <= Tuple
        - shape.get-parameter-at-distance(d1)
        - shape.get-parameter-at-distance(d2)

────────────────────
+ do get-split-distances
    - shape Path

.. cuts = cut-count()
.. incr = shape.length / cuts
.. cut-space = cut-spacing(this)

. tolerance = 1
. limit = shape.length - tolerance
. d = 0px
. f1 = 0px
while d < limit
    . shift1 = ((abs((<- cut-space) ?? 0) as Float) / 50.0) * incr / 2
    . d1 = d + shift1
    if d1 >= limit
        break

    if !f1
        f1 = d1
    . shift2 = ((abs((<- cut-space) ?? 0) as Float) / 50.0) * incr / 2
    . d2 = d1 + (incr - shift2)
    if d2 >= limit
        d2 = if !shape.is-closed then limit else f1 - shift2
        if d2 == 0
            d2 = limit
        <= d1, d2
        break
    else
        <= d1, d2
        d = d2

