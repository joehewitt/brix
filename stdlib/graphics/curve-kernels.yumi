    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - t PointOnCurve

XYScalars(tangent.y, -tangent.x)
    .. tangent = cubic-derivative-xy(x1, y1, hox, hoy, hix, hiy, x2, y2, t)

━━━━━━━━━━━━━━━━━━━━
+ do cubic-offset-point-xy @no-gc
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - t PointOnCurve
    - distance Length

. point = cubic-evaluate-xy(x1, y1, hox, hoy, hix, hiy, x2, y2, t)
. normal = cubic-normal-xy(x1, y1, hox, hoy, hix, hiy, x2, y2, t)
. normal-length = sqrt(normal.x * normal.x + normal.y * normal.y)
. scale = if !normal-length then 1.0 else distance / normal-length
= XYScalars(point.x + normal.x * scale, point.y + normal.y * scale)

