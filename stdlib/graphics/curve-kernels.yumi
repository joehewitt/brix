━━━━━━━━━━━━━━━━━━━━
+ do cubic-parameter-at-point PointOnCurve
    - point-x Coord
    - point-y Coord
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - epsilon = kernel-tolerance

if abs(x1 - point-x) < epsilon && abs(y1 - point-y) < epsilon
    = 0

if abs(x2 - point-x) < epsilon && abs(y2 - point-y) < epsilon
    = 1

. txs = cubic-roots-for-x(point-x, x1, hox, hix, x2, epsilon)
. tys = cubic-roots-for-y(point-y, y1, hoy, hiy, y2, epsilon)
. sx = txs.count
. sy = tys.count
. tx PointOnCurve
. ty PointOnCurve
. cx Index = 0
while sx == -1 || cx < sx
    if (sx == -1 || (tx = txs[cx]) >= 0) && tx <= 1
        . cy Index = 0
        while sy == -1 || cy < sy
            if (sy == -1 || (ty = tys[cy]) >= 0) && ty <= 1
                if sx == -1
                    tx = ty
                else if sy == -1
                    ty = tx

                if abs(tx - ty) < epsilon
                    = (tx + ty) * 0.5

            cy += 1

        if sx == -1
            break

    cx += 1

= -1

━━━━━━━━━━━━━━━━━━━━
