━━━━━━━━━━━━━━━━━━━━
+ cubic-roots-for-y CubicRootsScalars
    - value Coord
    - y1 Coord
    - hoy Coord
    - hiy Coord
    - y2 Coord
    - epsilon = kernel-tolerance

solve-cubic-scalars(c.a, c.b, c.c, y1 - value, epsilon)

