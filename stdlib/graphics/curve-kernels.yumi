    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - epsilon = kernel-tolerance

cubic-parameter-at-point(point-x, point-y, x1, y1, hox, hoy, hix, hiy, x2, y2, epsilon) >= 0

━━━━━━━━━━━━━━━━━━━━
+ line-range-scalars
    - x1 Coord
    - y1 Coord
    - x2 Coord
    - y2 Coord
    - t1 PointOnCurve
    - t2 PointOnCurve

CurveRangeScalars(.segment-type-line, sx, sy, sx, sy, ex, ey, ex, ey)

.. sx = x1 + (x2 - x1) * t1
.. sy = y1 + (y2 - y1) * t1
.. ex = x1 + (x2 - x1) * t2
.. ey = y1 + (y2 - y1) * t2

━━━━━━━━━━━━━━━━━━━━
+ cubic-subdivide-scalars
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - t PointOnCurve

CurveSplitScalars
    - CurveRangeScalars(.segment-type-cubic, x1, y1, p3x, p3y, p6x, p6y, p8x, p8y)
    - CurveRangeScalars(.segment-type-cubic, p8x, p8y, p7x, p7y, p5x, p5y, x2, y2)

.. u = 1 - t
.. p3x = u * x1 + t * hox
.. p3y = u * y1 + t * hoy
.. p4x = u * hox + t * hix
.. p4y = u * hoy + t * hiy
.. p5x = u * hix + t * x2
.. p5y = u * hiy + t * y2
.. p6x = u * p3x + t * p4x
.. p6y = u * p3y + t * p4y
.. p7x = u * p4x + t * p5x
.. p7y = u * p4y + t * p5y
.. p8x = u * p6x + t * p7x
.. p8y = u * p6y + t * p7y

━━━━━━━━━━━━━━━━━━━━
+ do cubic-range-scalars
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - t1 PointOnCurve
    - t2 PointOnCurve

. out = CurveRangeScalars(.segment-type-cubic, x1, y1, hox, hoy, hix, hiy, x2, y2)
if t1 > 0
    . split = cubic-subdivide-scalars()
        - out.x1
        - out.y1
        - out.hox
        - out.hoy
        - out.hix
        - out.hiy
        - out.x2
        - out.y2
        - t1
    out = split.right

if t2 < 1
    . split = cubic-subdivide-scalars()
        - out.x1
        - out.y1
        - out.hox
        - out.hoy
        - out.hix
        - out.hiy
        - out.x2
        - out.y2
        - (t2 - t1) / (1.0 - t1)
    out = split.left

= out

━━━━━━━━━━━━━━━━━━━━
+ curve-range-scalars
    - type SegmentType
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - t1 PointOnCurve
    - t2 PointOnCurve

|? type == .segment-type-line
    line-range-scalars(x1, y1, x2, y2, t1, t2)
??
    cubic-range-scalars(x1, y1, hox, hoy, hix, hiy, x2, y2, t1, t2)

━━━━━━━━━━━━━━━━━━━━
+ do cubic-sample-length @no-gc
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - prev-x Coord
    - prev-y Coord
    - t PointOnCurve

. point = cubic-evaluate-xy(x1, y1, hox, hoy, hix, hiy, x2, y2, t)
. dx = point.x - prev-x
. dy = point.y - prev-y
= CubicSampleScalars(point.x, point.y, sqrt(dx * dx + dy * dy))

━━━━━━━━━━━━━━━━━━━━
+ line-line-intersection-scalars LineIntersectionScalars
    - x1 Coord
    - y1 Coord
    - x2 Coord
    - y2 Coord
    - x3 Coord
    - y3 Coord
    - x4 Coord
    - y4 Coord
    - as-infinity = false

|? den == 0
    LineIntersectionScalars(false, 0, 0, 0, 0)
|? !as-infinity && (t1 < 0 || t2 < 0 || t1 > 1 || t2 > 1)
    LineIntersectionScalars(false, t1, t2, 0, 0)
??
    LineIntersectionScalars(true, t1, t2, x1 + t1 * (x2 - x1), y1 + t1 * (y2 - y1))

.. den = (y4 - y3) * (x2 - x1) - (x4 - x3) * (y2 - y1)
.. t1 = ((x4 - x3) * (y1 - y3) - (y4 - y3) * (x1 - x3)) / den
.. t2 = ((x2 - x1) * (y1 - y3) - (y2 - y1) * (x1 - x3)) / den

━━━━━━━━━━━━━━━━━━━━
+ do cubic-line-intersections-prepared-scalars CubicLineIntersectionsScalars
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - lx1 Coord
    - ly1 Coord
    - linelength Length
    - lux Coord
    - luy Coord
    - epsilon = kernel-tolerance

` Translate and align the curve so the line points along the negative x axis.
. dx = x1 - lx1
. dy = y1 - ly1
. sx = -(dx * lux + dy * luy)
. sy = dx * luy - dy * lux

dx = hox - lx1
dy = hoy - ly1
. ox = -(dx * lux + dy * luy)
. oy = dx * luy - dy * lux

dx = hix - lx1
dy = hiy - ly1
. ix = -(dx * lux + dy * luy)
. iy = dx * luy - dy * lux

dx = x2 - lx1
dy = y2 - ly1
. ex = -(dx * lux + dy * luy)
. ey = dx * luy - dy * lux

if min(min(sy, oy), min(iy, ey)) > epsilon || max(max(sy, oy), max(iy, ey)) < -epsilon
    = CubicLineIntersectionsScalars(0, 0, 0, 0, 0, 0, 0)

. candidates = cubic-roots-for-y(0.0, sy, oy, iy, ey, epsilon)
. count I8
. curvefirst PointOnCurve
. linefirst PointOnCurve
. curvesecond PointOnCurve
. linesecond PointOnCurve
. curvethird PointOnCurve
. linethird PointOnCurve

if candidates.count < 0
    . endpoint = 0
    while endpoint < 2
        . curveparam = if endpoint == 0 then 0.0 else 1.0
        . root = round(curveparam / epsilon) * epsilon
        if !has-root-scalar(count, curvefirst, curvesecond, curvethird, root, epsilon)
            . x = cubic-evaluate-control-1d(sx, ox, ix, ex, curveparam)
            . lineparam = -x / linelength
            if lineparam >= -epsilon && lineparam <= 1.0 + epsilon
                lineparam = if lineparam < 0 then 0.0 else lineparam
                lineparam = if lineparam > 1 then 1.0 else lineparam
                if count == 0
                    curvefirst = curveparam
                    linefirst = lineparam
                else if count == 1
                    curvesecond = curveparam
                    linesecond = lineparam
                else
                    curvethird = curveparam
                    linethird = lineparam
                count += 1
        endpoint += 1
else
    for candidateindex in 0 .. < candidates.count
        . candidate = candidates[candidateindex]
        if candidate < -epsilon || candidate > 1.0 + epsilon
            continue
        . curveparam = if candidate < 0 then 0.0 else candidate
        curveparam = if curveparam > 1 then 1.0 else curveparam
        . root = round(curveparam / epsilon) * epsilon
        if has-root-scalar(count, curvefirst, curvesecond, curvethird, root, epsilon)
            continue

        . x = cubic-evaluate-control-1d(sx, ox, ix, ex, curveparam)
        . lineparam = -x / linelength
        if lineparam >= -epsilon && lineparam <= 1.0 + epsilon
            lineparam = if lineparam < 0 then 0.0 else lineparam
            lineparam = if lineparam > 1 then 1.0 else lineparam
            if count == 0
                curvefirst = curveparam
                linefirst = lineparam
            else if count == 1
                curvesecond = curveparam
                linesecond = lineparam
            else
                curvethird = curveparam
                linethird = lineparam
            count += 1

= CubicLineIntersectionsScalars()
    - count
    - curvefirst
    - linefirst
    - curvesecond
    - linesecond
    - curvethird
    - linethird

━━━━━━━━━━━━━━━━━━━━
+ cubic-line-intersections-scalars CubicLineIntersectionsScalars
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - lx1 Coord
    - ly1 Coord
    - lx2 Coord
    - ly2 Coord
    - epsilon = kernel-tolerance

|? linelength <= epsilon
    CubicLineIntersectionsScalars(0, 0, 0, 0, 0, 0, 0)
??
    cubic-line-intersections-prepared-scalars()
        - x1
        - y1
        - hox
        - hoy
        - hix
        - hiy
        - x2
        - y2
        - lx1
        - ly1
        - linelength
        - lux
        - luy
        - epsilon

.. linelength = line-length-scalars(lx1, ly1, lx2, ly2)
.. lux = (lx2 - lx1) / linelength
.. luy = (ly2 - ly1) / linelength

━━━━━━━━━━━━━━━━━━━━
_ has-root-scalar
    - count I8
    - first PointOnCurve
    - second PointOnCurve
    - third PointOnCurve
    - root PointOnCurve
    - epsilon Coord

|? count > 0 && abs(first - root) < epsilon
    true
|? count > 1 && abs(second - root) < epsilon
    true
|? count > 2 && abs(third - root) < epsilon
    true
??
    false

━━━━━━━━━━━━━━━━━━━━
_ solve-quadratic-scalars CubicRootsScalars
    - a
    - b
    - c
    - epsilon

|? abs(a) < epsilon
    |? abs(b) >= epsilon
        CubicRootsScalars(-c / b)
    |? abs(c) < epsilon
        CubicRootsScalars(0, 0, 0, -1)
    ??
        CubicRootsScalars()
|? q < 0
    CubicRootsScalars()
|? sqrt-q > 0
    CubicRootsScalars(x1, x2)
??
    CubicRootsScalars(x1)

.. q = b * b - 4.0 * a * c
.. sqrt-q = sqrt(q)
.. x1 = (-b + sqrt-q) / (2.0 * a)
.. x2 = (-b - sqrt-q) / (2.0 * a)

━━━━━━━━━━━━━━━━━━━━
_ do solve-cubic-scalars CubicRootsScalars
    - a
    - b
    - c
    - d
    - epsilon

if abs(a) < epsilon
    = solve-quadratic-scalars(b, c, d, epsilon)

` Normalize to form: x^3 + b x^2 + c x + d = 0:
b /= a
c /= a
d /= a

. bb = b * b
if abs(b) > 1 / sqrt(epsilon) && abs(c) < bb / 64 && abs(d) < abs(b) * bb / 64
    . root = -b
    for ignored in 0 .. < 4
        . value = ((root + b) * root + c) * root + d
        . slope = (3 * root + 2 * b) * root + c
        root -= value / slope
    . constant = -d / root
    . linear = (constant - c) / root
    . remaining = solve-quadratic-scalars(1.0, linear, constant, epsilon)
    if remaining.count == 2
        = CubicRootsScalars(root, remaining.root1, remaining.root2)
    else if remaining.count == 1
        = CubicRootsScalars(root, remaining.root1)
    = CubicRootsScalars(root)

. p = 1.0 / 3.0 * (-1.0 / 3.0 * bb + c)
. q = 1.0 / 2.0 * (2.0 / 27.0 * b * bb - 1.0 / 3.0 * b * c + d)
. ppp = p * p * p
. dd = q * q + ppp

b /= 3

if abs(dd) < epsilon
    if abs(q) < epsilon
        = CubicRootsScalars(-b)
    else
        . u = cbrt(-q)
        = CubicRootsScalars(2.0 * u - b, -u - b)
else if dd < 0
    . phi = 1.0 / 3.0 * acos(-q / sqrt(-ppp))
    . t = 2.0 * sqrt(-p)
    = CubicRootsScalars(t * cos(phi) - b, -t * cos(phi + π / 3.0) - b, -t * cos(phi - π / 3.0) - b)
else
    . sdd = sqrt(dd)
    = CubicRootsScalars(cbrt(sdd - q) - cbrt(sdd + q) - b)
