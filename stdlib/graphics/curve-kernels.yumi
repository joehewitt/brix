━━━━━━━━━━━━━━━━━━━━
+ do cubic-bounds-1d CoordBounds
    - a1 Coord
    - ho Coord
    - hi Coord
    - a2 Coord
    - epsilon = kernel-tolerance

. a = 3.0 * (ho - hi) - a1 + a2
. b = 2.0 * (a1 + hi) - 4.0 * ho
. c = ho - a1
. min = min(a1, a2)
. max = max(a1, a2)
. t-min = epsilon
. t-max = 1.0 - epsilon
. roots = solve-quadratic-scalars(a, b, c, epsilon)
if roots.count >= 0
    for i in 0 .. < roots.count
        . t = if i == 0 then roots.root1 else roots.root2
        if t > t-min && t < t-max
            . pt = cubic-evaluate-control-1d(a1, ho, hi, a2, t)
            if pt < min
                min = pt
            if pt > max
                max = pt

= CoordBounds(min, max)

━━━━━━━━━━━━━━━━━━━━
