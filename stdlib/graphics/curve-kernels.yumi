━━━━━━━━━━━━━━━━━━━━
+ cubic-coefficients-1d @inline
    - a1 Coord
    - ho Coord
    - hi Coord
    - a2 Coord

CubicCoefficients1D(a, b, c)

.. c = 3.0 * (ho - a1)
.. b = 3.0 * (hi - ho) - c
.. a = a2 - a1 - c - b

━━━━━━━━━━━━━━━━━━━━
+ cubic-evaluate-1d Coord @inline
    - a Coord
    - b Coord
    - c Coord
    - a1 Coord
    - t PointOnCurve

((a * t + b) * t + c) * t + a1

━━━━━━━━━━━━━━━━━━━━
+ cubic-evaluate-control-1d @inline
    - a1 Coord
    - ho Coord
    - hi Coord
    - a2 Coord
    - t PointOnCurve

cubic-evaluate-1d(coeffs.a, coeffs.b, coeffs.c, a1, t)
    .. coeffs = cubic-coefficients-1d(a1, ho, hi, a2)

━━━━━━━━━━━━━━━━━━━━
+ cubic-derivative-1d Coord @inline
    - a Coord
    - b Coord
    - c Coord
    - t PointOnCurve

(3.0 * a * t + 2.0 * b) * t + c

━━━━━━━━━━━━━━━━━━━━
+ cubic-evaluate-xy
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - t PointOnCurve

XYScalars
    - cubic-evaluate-1d(cx.a, cx.b, cx.c, x1, t)
    - cubic-evaluate-1d(cy.a, cy.b, cy.c, y1, t)

.. cx = cubic-coefficients-1d(x1, hox, hix, x2)
.. cy = cubic-coefficients-1d(y1, hoy, hiy, y2)

━━━━━━━━━━━━━━━━━━━━
+ do cubic-derivative-xy
    - x1 Coord
    - y1 Coord
    - hox Coord
    - hoy Coord
    - hix Coord
    - hiy Coord
    - x2 Coord
    - y2 Coord
    - t PointOnCurve

. cx = cubic-coefficients-1d(x1, hox, hix, x2)
. cy = cubic-coefficients-1d(y1, hoy, hiy, y2)
. dx Coord
. dy Coord
. degenerate-start = t < kernel-tolerance && hox == x1 && hoy == y1
. degenerate-end = t > 1 - kernel-tolerance && hix == x2 && hiy == y2
if degenerate-start && (hix != x1 || hiy != y1)
    dx = hix - x1
    dy = hiy - y1
else if degenerate-end && (hox != x2 || hoy != y2)
    dx = x2 - hox
    dy = y2 - hoy
else if degenerate-start || degenerate-end
    dx = x2 - x1
    dy = y2 - y1
else if t < kernel-tolerance
    dx = cx.c
    dy = cy.c
else if t > 1.0 - kernel-tolerance
    dx = 3.0 * (x2 - hix)
    dy = 3.0 * (y2 - hiy)
else
    dx = cubic-derivative-1d(cx.a, cx.b, cx.c, t)
    dy = cubic-derivative-1d(cy.a, cy.b, cy.c, t)

= XYScalars(dx, dy)

━━━━━━━━━━━━━━━━━━━━
+ cubic-normal-xy
    - x1 Coord
