    .. dy = y2 - y1

━━━━━━━━━━━━━━━━━━━━
+ line-normal-xy
    - x1 Coord
    - y1 Coord
    - x2 Coord
    - y2 Coord

|? length <= kernel-tolerance
    XYScalars(0, 0)
??
    XYScalars(dy / length, -dx / length)

.. dx = x2 - x1
.. dy = y2 - y1
.. length = sqrt(dx * dx + dy * dy)

━━━━━━━━━━━━━━━━━━━━
+ line-bounds-1d
    - a1 Coord
    - a2 Coord

