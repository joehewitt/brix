━━━━━━━━━━━━━━━━━━━━
+ VectorNetwork

_ vertex-list [NetworkVertex]
_ segment-list [NetworkSegment]
_ pair-list [NetworkPair]
_ next-vertex Index = 1
_ next-segment Index = 1
_ version Size = 0
_ mutation-depth Size
_ mutation-pending = false
_ mutation-observers [Weak'NetworkMutationObserver]
_ vertex-slots Map'Index'Index?
_ segment-slots Map'Index'Index?
_ trace-scratch NetworkTraceLookup?
_ known-outline NetworkOutline?

────────────────────
+ This

────────────────────
+ This
    - vertices [NetworkVertex]
    - segments [NetworkSegment]
    - pairs [NetworkPair]

vertex-list.reserve(vertices.length)
segment-list.reserve(segments.length)
pair-list.reserve(pairs.length)
for item in vertices
    network-valid-point(item.position)
    if vertex-slot(item.id) != null
        ?! Panic("Duplicate network vertex id")
    append-vertex-item(item)
    next-vertex = max(next-vertex, item.id + 1)
for item in segments
    vertex(item.start)
    vertex(item.end)
    network-valid-point(item.tangent-start)
    network-valid-point(item.tangent-end)
    if !is-finite(item.source-start) || !is-finite(item.source-end)
        ?! Panic("Invalid network segment source range")
    if segment-slot(item.id) != null
        ?! Panic("Duplicate network segment id")
    append-segment-item(item)
    next-segment = max(next-segment, item.id + 1)
. paired = Map'Index'Bool()
for pair in pairs
    . first = network-end-key(pair.first)
    . second = network-end-key(pair.second)
    if paired has first || paired has second
        pair-handles(pair.first, pair.second, pair.mirror-length)
    else
        validate-pair(pair.first, pair.second)
        pair-list += pair
    paired[first] = true
    paired[second] = true
version = 0
mutation-pending = false

────────────────────
+ get revision

version

────────────────────
+ do subscribe
    - observer NetworkMutationObserver

. index = mutation-observers.length
while index > 0
    index -= 1
    . existing = mutation-observers[index].get
    if !existing
        mutation-observers.remove(index)
    else if existing as Pointer == observer as Pointer
        =
. weak = catch? Weak(observer)
?! Panic("Unable to subscribe to vector network mutations")
    if !weak
mutation-observers += weak

────────────────────
+ do unsubscribe
    - observer NetworkMutationObserver

. index = mutation-observers.length
while index > 0
    index -= 1
    . existing = mutation-observers[index].get
    if !existing || existing as Pointer == observer as Pointer
        mutation-observers.remove(index)

────────────────────
+ get updating

NetworkUpdateScope(this)

────────────────────
+ do begin-update

mutation-depth += 1

────────────────────
+ do checkpoint

if !mutation-depth
    publish-mutation()

────────────────────
+ do end-update

if mutation-depth
    mutation-depth -= 1
if !mutation-depth
    publish-mutation()

