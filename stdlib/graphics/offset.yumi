━━━━━━━━━━━━━━━━━━━━
+ do offset-path-is-single-subpath
    - path Path

. moves Size
. span = path.commands
for i in 0 .. < span.command-count
    if span.verbs[i] == .path-verb-move
        moves += 1
        =? if moves > 1

= moves == 1

━━━━━━━━━━━━━━━━━━━━
+ do offset-special-path
    - path Path
    - distance Float

if path.is-closed
    . rect = axis-rect(path)
    if rect
        . expanded = rect.inflate(distance * 2, distance * 2)
        if expanded.width <= 0 || expanded.height <= 0
            = Path()
        = rectangle(expanded)
else
    = straight-line-offset(path, distance)

━━━━━━━━━━━━━━━━━━━━
+ do straight-line-offset
    - path Path
    - distance Float

=? if path.is-closed
=? if path.count < 2

. span = path.commands
for i in 0 .. < span.command-count
    =? if span.verbs[i] == .path-verb-cubic

. first-x = span.coords[0]
. first-y = span.coords[1]
. last-x = first-x
. last-y = first-y
for i in 0 .. < span.command-count
    . verb = span.verbs[i]
    if verb == .path-verb-line || verb == .path-verb-move
        . start = span.coord-offsets[i]
        last-x = span.coords[start]
        last-y = span.coords[start + 1]

. line-dx = last-x - first-x
. line-dy = last-y - first-y
. line-length2 = line-dx * line-dx + line-dy * line-dy
=? if line-length2 < 0.0000000001

for i in 0 .. < span.command-count
    . verb = span.verbs[i]
    if verb == .path-verb-close
        continue
    . start = span.coord-offsets[i]
    . x = span.coords[start]
    . y = span.coords[start + 1]
    =? if !point-on-line-xy(x, y, first-x, first-y, last-x, last-y)

. normal = line-normal-xy(first-x, first-y, last-x, last-y)
. normal-x = normal.x
. normal-y = normal.y
. offset-x = normal-x * distance
. offset-y = normal-y * distance
. result = Path()
result.move-to(first-x + offset-x, first-y + offset-y)
result.line-to(last-x + offset-x, last-y + offset-y)
= result

━━━━━━━━━━━━━━━━━━━━
+ point-on-line
    - point Point
    - first Point
    - last Point

near-line && within-x && within-y

.. near-line = abs(cross) < 0.00001
.. cross = dx * py - dy * px
.. dx = last.x - first.x
.. dy = last.y - first.y
.. px = point.x - first.x
.. py = point.y - first.y
.. within-x = point.x >= min-x && point.x <= max-x
.. min-x = min(first.x, last.x) - 0.00001
.. max-x = max(first.x, last.x) + 0.00001
.. within-y = point.y >= min-y && point.y <= max-y
.. min-y = min(first.y, last.y) - 0.00001
.. max-y = max(first.y, last.y) + 0.00001

━━━━━━━━━━━━━━━━━━━━
