_ offset-path-teeny = 0.000001
_ offset-cleanup-tolerance = 0.001
_ offset-trim-epsilon = 0.000000001
_ offset-trim-snap = 0.5
_ offset-trim-flatness = 0.01

━━━━━━━━━━━━━━━━━━━━
+ OffsetEffect is VectorEffect

+ distance => effect-distance
+ join-type => effect-join-type
+ miter-limit => effect-miter-limit

_ effect-distance Length
_ effect-join-type JoinType = .square-join-type
_ effect-miter-limit Length = 1

────────────────────
+ This
    - value Length
    - join JoinType = .square-join-type
    - limit Length = 1

effect-distance = value
effect-join-type = join
effect-miter-limit = limit

────────────────────
+ equals Bool
    - other VectorEffect

|? !(other is OffsetEffect)
    false
??
    same-distance && join-type == offset.join-type && miter-limit == offset.miter-limit

.. offset = other as OffsetEffect
.. same-distance = enabled == offset.enabled && distance == offset.distance

────────────────────
+ do apply [Path]
    - source [Path]

if distance == 0
    = source

. result Path
for path in source
    if offset-path-is-single-subpath(path)
        . offset = offset-subpath-plan(OffsetPlan(path), distance, join-type, miter-limit)
        if offset.count
            if result.count
                result.add-path(offset)
            else
                result = offset
    else
        for span in path.subpaths
            . subpath = span.materialize()
            . offset = offset-subpath-plan(OffsetPlan(subpath), distance, join-type, miter-limit)
            if offset.count
                if result.count
                    result.add-path(offset)
                else
                    result = offset

. output [Path]
if result.count
    output += result
= output

