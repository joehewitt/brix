────────────────────
+ do move-to
    - point Point

first-point = point
prev-point = point
has-current = true
segment-count = 0
out.reset()

────────────────────
+ do line-to
    - point Point

line-to(point) • is line

────────────────────
+ do line-to
    - point Point
    - is-line Bool

if !has-current
    move-to(point)
    =
. delta = point - prev-point
. len = delta.length
=? if len <= offset-path-teeny

. tangent = delta / len
. unit-normal = offset-unit-normal(tangent, normal-sign)
pre-join-to(unit-normal, tangent) • is-line
out.originate(offset-origin-line(prev-point, point))
append-line-to-offset(point, unit-normal)
post-join-to(point, unit-normal, tangent)

────────────────────
+ do cubic-to
    - handle-out Point
    - handle-in Point
    - point Point

if !has-current
    move-to(point)
    =
=? if cubic-is-point-like(prev-point, handle-out, handle-in, point)

if cubic-is-chord-like(prev-point, handle-out, handle-in, point)
    line-to(point) • is !line
    =
. start-tangent = cubic-tangent-at(prev-point, handle-out, handle-in, point, 0)
. end-tangent = cubic-tangent-at(prev-point, handle-out, handle-in, point, 1)
. start-normal = offset-unit-normal(start-tangent, normal-sign)
. end-normal = offset-unit-normal(end-tangent, normal-sign)

pre-join-to(start-normal, start-tangent) • is !line
append-offset-cubic-split-inflections()
    - out
    - prev-point
    - handle-out
    - handle-in
    - point
    - distance
    - normal-sign
post-join-to(point, end-normal, end-tangent)

────────────────────
+ do finish-raw
    - close Bool

if segment-count <= 0
    = OffsetRawPath(Path(), out.spans, out.origins, offset-source-spans(out.sources))

if close
    out.origin = offset-origin-line(prev-point, prev-point)
    add-contour-join()
        - prev-point
        - prev-unit-normal
        - first-unit-normal
        - prev-tangent
        - first-tangent
        • is-line first-is-line
    out.close()

= OffsetRawPath(out.path, out.spans, out.origins, offset-source-spans(out.sources))

────────────────────
_ do pre-join-to
    - unit-normal Point
    - tangent Point
    - is-line Bool

if segment-count == 0
    first-unit-normal = unit-normal
    prev-unit-normal = unit-normal
    first-tangent = tangent
    prev-tangent = tangent
    first-is-line = is-line
    out.line-to(prev-point + unit-normal * distance)
else
    out.origin = offset-origin-line(prev-point, prev-point)
    add-contour-join()
        - prev-point
        - prev-unit-normal
        - unit-normal
        - prev-tangent
        - tangent
        • is-line

────────────────────
_ do append-line-to-offset
    - point Point
    - unit-normal Point

out.line-to(point + unit-normal * distance)

────────────────────
_ do post-join-to
    - point Point
    - unit-normal Point
    - tangent Point

prev-point = point
prev-unit-normal = unit-normal
prev-tangent = tangent
segment-count += 1

────────────────────
_ do add-contour-join
    - pivot Point
    - before-normal Point
    - after-normal Point
    - before-tangent Point
    - after-tangent Point
    - is-line Bool

//graphics.offset.joins ++
add-side-join()
    - out
    - pivot
    - before-normal
    - after-normal
    - before-tangent
    - after-tangent
    • is-line

────────────────────
_ do add-side-join
    - writer OffsetPathWriter
    - pivot Point
    - before-normal Point
    - after-normal Point
    - before-tangent Point
    - after-tangent Point
    - is-line Bool

. before-offset = pivot + before-normal * distance
. after-offset = pivot + after-normal * distance
. turn = before-tangent.cross(after-tangent)

if abs(distance) <= offset-path-teeny
    writer.line-to(pivot)
    =
if abs(turn) <= offset-path-teeny
    if before-tangent.dot(after-tangent) >= -0.999
        writer.line-to(after-offset)
    else if join-type == .round-join-type
        add-round-offset-join(writer, pivot, before-offset, after-offset)
    else if join-type == .square-join-type
        append-square-join(writer, pivot, before-normal, after-normal, before-tangent, after-tangent, distance) • is-line
    else
        writer.line-to(before-offset)
        writer.line-to(after-offset)
    =
if turn * distance * normal-sign < 0
    writer.line-to(after-offset)
    =
if join-type == .miter-join-type
    add-miter-side-join(writer, pivot, before-normal, after-normal) • is-line
else if join-type == .round-join-type
    add-round-offset-join(writer, pivot, before-offset, after-offset)
else if join-type == .square-join-type
    append-square-join(writer, pivot, before-normal, after-normal, before-tangent, after-tangent, distance) • is-line
else
    writer.line-to(after-offset)

────────────────────
_ do add-miter-side-join
    - writer OffsetPathWriter
    - pivot Point
    - before-normal Point
    - after-normal Point
    - is-line Bool

. dot = before-normal.dot(after-normal)
if dot > 0.999 || miter-limit <= 1
    writer.line-to(pivot + after-normal * distance)
    =
if dot < -0.999
    writer.line-to(pivot + before-normal * distance)
    writer.line-to(pivot + after-normal * distance)
    =
. sin-half = sqrt(max(0.0, (1.0 + dot) / 2.0))
if sin-half <= 0 || sin-half < 1.0 / miter-limit
    writer.line-to(pivot + after-normal * distance)
    =
. mid Point
if abs(dot) <= offset-path-teeny && miter-limit >= 1.41421356237
    mid = (before-normal + after-normal) * distance
else
    . sum = before-normal + after-normal
    . sum-length = sum.length
    if sum-length <= offset-path-teeny
        writer.line-to(pivot + after-normal * distance)
        =
    mid = (sum / sum-length) * (abs(distance) / sin-half)
    if distance < 0
        mid = -mid

writer.line-to(pivot + mid)
if !is-line
    writer.line-to(pivot + after-normal * distance)

────────────────────
_ do add-round-offset-join
    - writer OffsetPathWriter
    - center Point
    - from Point
    - to Point

. radius = abs(distance)
if radius < offset-path-teeny || from.distance(to) < offset-path-teeny
    writer.line-to(to)
else
    writer.line-to(from)
    writer.arc(center, radius, from.angle(center), to.angle(center), distance * normal-sign < 0)

