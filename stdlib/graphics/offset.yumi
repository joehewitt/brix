━━━━━━━━━━━━━━━━━━━━
+ OffsetPlan

+ path Path
+ spans [OffsetPlanSpan]
+ is-closed = false
+ is-clockwise = true
+ is-all-lines = true
+ is-convex = false
+ is-single-subpath = false
+ has-self-intersections = false
+ bounds Rect

────────────────────
+ This
    - source Path

.. path = source
is-closed = source.is-closed
is-clockwise = source.is-clockwise
is-single-subpath = offset-path-is-single-subpath(source)
build-spans()
is-convex = offset-plan-is-convex(this)
has-self-intersections = offset-plan-has-self-intersections(this)

────────────────────
_ do build-spans

. reader = path.curve-reader
. waiting-for-bounds = true
while reader.next()
    . x1 = reader.x1
    . y1 = reader.y1
    . hox = reader.handle-out-x
    . hoy = reader.handle-out-y
    . hix = reader.handle-in-x
    . hiy = reader.handle-in-y
    . x2 = reader.x2
    . y2 = reader.y2
    . is-line-like = reader.type == .segment-type-line || scalars-line-like
        .. scalars-line-like = line-like-scalars(x1, y1, hox, hoy, hix, hiy, x2, y2)
    if !is-line-like
        is-all-lines = false

    . min-x Coord
    . min-y Coord
    . max-x Coord
    . max-y Coord
    if reader.type == .segment-type-line || is-line-like
        min-x = min(x1, x2)
        min-y = min(y1, y2)
        max-x = max(x1, x2)
        max-y = max(y1, y2)
    else
        min-x = min(min(x1, hox), min(hix, x2))
        min-y = min(min(y1, hoy), min(hiy, y2))
        max-x = max(max(x1, hox), max(hix, x2))
        max-y = max(max(y1, hoy), max(hiy, y2))

    if waiting-for-bounds
        bounds = Rect(min-x, min-y, max-x - min-x, max-y - min-y)
        waiting-for-bounds = false
    else
        bounds += Rect(min-x, min-y, max-x - min-x, max-y - min-y)

    spans += OffsetPlanSpan()
        - reader.type
        - x1
        - y1
        - hox
        - hoy
        - hix
        - hiy
        - x2
        - y2
        - min-x
        - min-y
        - max-x
        - max-y
        - is-line-like

