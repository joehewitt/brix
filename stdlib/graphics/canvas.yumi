────────────────────
+ This
    - width I32
    - height I32
    - scale F64 = 1
    - clear-color RGBA? = null
    - output-color-space Pointer? = null
    - alpha-only Bool = false

//gui.canvas.surface-creates ++
if alpha-only
    graphics = C:yumiGraphicsCanvasCreateAlphaOnly(width, height, scale)
else if output-color-space
    graphics = C:yumiGraphicsCanvasCreateScaledWithColorSpace
        - width
        - height
        - scale
        - output-color-space
else
    graphics = C:yumiGraphicsCanvasCreateScaled(width, height, scale)
if clear-color
    . color = clear-color
    C:yumiGraphicsClear(graphics, color.red, color.green, color.blue, color.alpha)

