────────────────────
+ do oval-path
    - rect Rect

. rx = rect.width / 2
. ry = rect.height / 2
. cx = rect.x + rx
. cy = rect.y + ry
. kx = rx * 0.5522847498307936
. ky = ry * 0.5522847498307936
move(cx + rx, cy)
curve(cx + rx, cy + ky, cx + kx, cy + ry, cx, cy + ry)
curve(cx - kx, cy + ry, cx - rx, cy + ky, cx - rx, cy)
curve(cx - rx, cy - ky, cx - kx, cy - ry, cx, cy - ry)
curve(cx + kx, cy - ry, cx + rx, cy - ky, cx + rx, cy)
enclose()

────────────────────
+ do outline-path
    - shape Outline

. b = shape.bounds
=? if b.width <= 0 || b.height <= 0
. r = shape.effective-radius
. k = r * 0.4477152501692064
. side = shape.arrow?.side
. size = shape.arrow?.size ?? 0
. tip = shape.arrow-tip
. half = shape.arrow-half
. arrowed = side != null && half > 0 && size > 0
move(b.x + r, b.y)
if arrowed && side == Side.top
    line(b.x + tip - half, b.y)
    line(b.x + tip, b.y - size)
    line(b.x + tip + half, b.y)
line(b.right - r, b.y)
if r > 0
    curve(b.right - k, b.y, b.right, b.y + k, b.right, b.y + r)
if arrowed && side == Side.right
    line(b.right, b.y + tip - half)
    line(b.right + size, b.y + tip)
    line(b.right, b.y + tip + half)
line(b.right, b.bottom - r)
if r > 0
    curve(b.right, b.bottom - k, b.right - k, b.bottom, b.right - r, b.bottom)
if arrowed && side == Side.bottom
    line(b.x + tip + half, b.bottom)
    line(b.x + tip, b.bottom + size)
    line(b.x + tip - half, b.bottom)
line(b.x + r, b.bottom)
if r > 0
    curve(b.x + k, b.bottom, b.x, b.bottom - k, b.x, b.bottom - r)
if arrowed && side == Side.left
    line(b.x, b.y + tip + half)
    line(b.x - size, b.y + tip)
    line(b.x, b.y + tip - half)
line(b.x, b.y + r)
if r > 0
    curve(b.x, b.y + k, b.x + k, b.y, b.x + r, b.y)
enclose()

