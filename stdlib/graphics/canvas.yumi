────────────────────
+ do end
    - closed Bool = false
    - fill-rule FillRule = FillRule.nonzero

if closed
    enclose()

. paint = current-fill-paint
. brush = current-stroke-brush
. fill = fill-color
. stroke = stroke-color
. brushed = brush != null && stroke != null
. shading = current-shape-fill
if shading
    C:yumiGraphicsFillPathShader
        - graphics
        - shading.shader.id
        - shading.args.buffer-pointer
        - shading.args.length
        - shading.time
        - fill-rule-code(fill-rule)
    if brushed
        stroke-path-brush(brush!, stroke!, false, fill-rule)
    else
        C:yumiGraphicsDrawPath(graphics, false, stroke != null, fill-rule-code(fill-rule))
else if paint && fill
    . color = fill
    C:yumiGraphicsFillPathPaint
        - graphics
        - paint.shader.id
        - paint.args.buffer-pointer
        - paint.args.length
        - color.red
        - color.green
        - color.blue
        - color.alpha
        - fill-rule-code(fill-rule)
    if brushed
        stroke-path-brush(brush!, stroke!, false, fill-rule)
    else
        C:yumiGraphicsDrawPath(graphics, false, stroke != null, fill-rule-code(fill-rule))
else if brushed
    stroke-path-brush(brush!, stroke!, fill != null, fill-rule)
else
    C:yumiGraphicsDrawPath(graphics, fill != null, stroke != null, fill-rule-code(fill-rule))
//graphics.canvas.paths ++
//-graphics.canvas.path

