────────────────────
+ do fill-color = color RGBA?

current-fill = color
=? if !color
. value = color
=? if (native-known /and/ native-fill-known) != 0 && native-fill == value
native-fill = value
native-known = native-known /or/ native-fill-known
C:yumiGraphicsSetFillColor(graphics, value.red, value.green, value.blue, value.alpha)

────────────────────
+ do stroke-color = color RGBA?

current-stroke = color
=? if !color
. value = color
=? if (native-known /and/ native-stroke-known) != 0 && native-stroke == value
native-stroke = value
native-known = native-known /or/ native-stroke-known
C:yumiGraphicsSetStrokeColor(graphics, value.red, value.green, value.blue, value.alpha)

────────────────────
+ do stroke-width = width Length

