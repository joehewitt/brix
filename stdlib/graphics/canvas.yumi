+ stroke-brush Brush?
+ text-fill ShaderFill?
+ shape-fill ShaderFill?

━━━━━━━━━━━━━━━━━━━━
_ CanvasState

+ text-color = default-text-color
+ font = system-font()
+ fill-color RGBA?
+ stroke-color RGBA?
+ stroke-width Length
+ stroke-cap LineCap = LineCap.butt
+ stroke-join LineJoin = LineJoin.miter
+ stroke-dash Length
+ current-transform Matrix = Matrix()
+ blend-mode = BlendMode.normal
+ fill-paint Paint?
+ stroke-brush Brush?
+ text-fill ShaderFill?
+ shape-fill ShaderFill?
+ previous CanvasState?

────────────────────
+ do copy-from
    - source CanvasState

text-color = source.text-color
font = source.font
fill-color = source.fill-color
stroke-color = source.stroke-color
stroke-width = source.stroke-width
stroke-cap = source.stroke-cap
stroke-join = source.stroke-join
stroke-dash = source.stroke-dash
current-transform = source.current-transform
blend-mode = source.blend-mode
fill-paint = source.fill-paint
stroke-brush = source.stroke-brush
text-fill = source.text-fill
shape-fill = source.shape-fill

────────────────────
+ do set-fill-color
    - color RGBA?

fill-color = color

────────────────────
+ do set-fill-paint
    - paint Paint?

fill-paint = paint

────────────────────
+ do set-stroke-brush
    - brush Brush?

stroke-brush = brush

────────────────────
+ do set-text-fill
    - fill ShaderFill?

text-fill = fill

────────────────────
+ do set-shape-fill
    - fill ShaderFill?

shape-fill = fill

────────────────────
+ do set-stroke-color
    - color RGBA?

stroke-color = color

────────────────────
+ do set-stroke-width
    - width Length

stroke-width = width

────────────────────
+ do set-stroke-cap
    - cap LineCap

stroke-cap = cap

────────────────────
+ do set-stroke-join
    - join LineJoin

stroke-join = join

────────────────────
+ do set-stroke-dash
    - length Length

stroke-dash = length

────────────────────
+ do concatenate-transform
    - matrix Matrix

current-transform = current-transform.concatenate(matrix)

────────────────────
+ do set-font
    - value Font

font = value

────────────────────
+ do set-text-color
    - color RGBA

text-color = color

────────────────────
+ do set-blend-mode
    - mode BlendMode

blend-mode = mode

━━━━━━━━━━━━━━━━━━━━
