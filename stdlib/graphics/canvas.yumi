━━━━━━━━━━━━━━━━━━━━
_ fill-rule-code I32
    - fill-rule FillRule

if fill-rule == FillRule.even-odd then 1 else 0

━━━━━━━━━━━━━━━━━━━━
_ text-alignment-code I32
    - alignment TextAlignment

|? alignment == TextAlignment.center
    1i32
|? alignment == TextAlignment.right
    2i32
??
    0i32
