────────────────────
+ do fill-gradient
    - rect Rect
    - gradient Gradient

gradient.validate()
. stops = gradient.stops
. components [F64]
. locations [F64]
for stop in stops
    components += stop.color.red
    components += stop.color.green
    components += stop.color.blue
    components += stop.color.alpha
    locations += stop.offset
. kind I32
. geometry [F64]
do match gradient
    | linear LinearGradient
        kind = 1
        geometry = [linear.start.x, linear.start.y, 0, linear.end.x, linear.end.y, 0]
    | radial RadialGradient
        kind = 2
        . start = radial.start-center
        . end = radial.end-center
        geometry = [start.x, start.y, radial.start-radius, end.x, end.y, radial.end-radius]
    | conic ConicGradient
        kind = 3
        geometry = [conic.center.x, conic.center.y, conic.angle, 0, 0, 0]
C:yumiGraphicsFillGradient
    - graphics
    - rect.x
    - rect.y
    - rect.width
    - rect.height
    - kind
    - geometry.buffer-pointer
    - components.buffer-pointer
    - locations.buffer-pointer
    - stops.length

