────────────────────
+ do close

if !is-closed
    saved-states.clear()
    while group-targets.length > 0
        . target = group-targets.pop()
        . kind = group-kinds.pop()
        . opacity = group-opacities.pop()
        do match kind
            |= canvas-group-blur
                C:yumiGraphicsEndBlur(target, graphics, current-blend-mode)
            |= canvas-group-filter
                . filter = group-filters.pop()
                . natives = filter.image-natives
                . scales = filter.image-scales
                C:yumiGraphicsEndFilter
                    - target
                    - graphics
                    - filter.shader.id
                    - filter.args.buffer-pointer
                    - filter.args.length
                    - natives.buffer-pointer
                    - scales.buffer-pointer
                    - natives.length
                    - filter.time
                    - 1
                    - current-blend-mode
            |= canvas-group-opacity
                C:yumiGraphicsEndOpacity(target, graphics, opacity, current-blend-mode)
            ??
                C:yumiGraphicsEndMask(target, graphics)
        graphics = target
    C:yumiGraphicsCanvasRelease(graphics)
    is-closed = true

