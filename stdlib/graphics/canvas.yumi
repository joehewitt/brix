────────────────────
_ do reset-current-state

current-fill = null
current-stroke = null
current-stroke-width = 0
current-stroke-cap = LineCap.butt
current-stroke-join = LineJoin.miter
current-stroke-dash = 0
current-text-color = default-text-color
current-font = system-font()
current-transform = Matrix()
current-blend-mode = BlendMode.normal
current-fill-paint = null
current-stroke-brush = null
current-text-fill = null
current-shape-fill = null
native-known = 0

────────────────────
_ do enter-group
    - kind U8
    - opacity Ratio

push()
current-blend-mode = BlendMode.normal
group-targets += graphics
group-kinds += kind
group-opacities += opacity

────────────────────
_ is-in-group
    - kind U8

group-kinds.length > 0 && group-kinds[group-kinds.length - 1] == kind

────────────────────
_ do leave-group

graphics = group-targets.pop()
group-kinds.pop()
group-opacities.pop()
pop()

────────────────────
_ do apply-native-state

if (native-known /and/ native-fill-known) != 0
    C:yumiGraphicsSetFillColor
        - graphics
        - native-fill.red
        - native-fill.green
        - native-fill.blue
        - native-fill.alpha
if (native-known /and/ native-stroke-known) != 0
    C:yumiGraphicsSetStrokeColor
        - graphics
        - native-stroke.red
        - native-stroke.green
        - native-stroke.blue
        - native-stroke.alpha
if (native-known /and/ native-width-known) != 0
    C:yumiGraphicsSetStrokeWidth(graphics, native-stroke-width)
if (native-known /and/ native-cap-known) != 0
    C:yumiGraphicsSetStrokeCap(graphics, line-cap-code(native-stroke-cap))
if (native-known /and/ native-join-known) != 0
    C:yumiGraphicsSetStrokeJoin(graphics, line-join-code(native-stroke-join))
if (native-known /and/ native-dash-known) != 0
    C:yumiGraphicsSetStrokeDash(graphics, native-stroke-dash)

────────────────────
_ do stroke-path-brush
    - brush Brush
    - color RGBA
    - fill Bool
    - fill-rule FillRule

. values [F64]
append-brush-arguments(brush, values)
C:yumiGraphicsStrokePathBrush
    - graphics
    - brush.shader.id
    - values.buffer-pointer
    - values.length
    - color.red
    - color.green
    - color.blue
    - color.alpha
    - stroke-width
    - fill
    - fill-rule-code(fill-rule)

━━━━━━━━━━━━━━━━━━━━
+ SVGCanvas is Canvas

_ strings [String]
_ path-points [String]
_ gradient-count Size = 0

────────────────────
+ This
    - width I32
    - height I32

state = create-state()

────────────────────
+ do write
    - path Path

` . head = "<svg width=\"8.5in\" height=\"11in\" xmlns=\"http://www.w3.org/2000/svg\">"
. head = "<svg width=\"$width\" height=\"$height\" viewBox=\"0 0 $width $height\""
head += " xmlns=\"http://www.w3.org/2000/svg\">"
. tail = "</svg>"

. content = "\n".join(strings)
. buf = head + content + tail

. f = File(path, FileFlags.create-mode + FileFlags.write-mode + FileFlags.truncate-mode)
f.write(buf)
f.close()

────────────────────
+ do erase
    - color RGBA?

strings = List'String()
gradient-count = 0

────────────────────
+ do fill-gradient
    - rect Rect
    - gradient Gradient

gradient.validate()
gradient-count += 1
. id = "gradient-$gradient-count"
. element String
. definition String
do match gradient
    | linear LinearGradient
        element = "linearGradient"
        definition = "<defs><linearGradient id=\"$id\" gradientUnits=\"userSpaceOnUse\""
        definition += " x1=\"${linear.start.x}\" y1=\"${linear.start.y}\""
        definition += " x2=\"${linear.end.x}\" y2=\"${linear.end.y}\">"
    | radial RadialGradient
        element = "radialGradient"
        definition = "<defs><radialGradient id=\"$id\" gradientUnits=\"userSpaceOnUse\""
        definition += " fx=\"${radial.start-center.x}\" fy=\"${radial.start-center.y}\""
        definition += " fr=\"${radial.start-radius}\""
        definition += " cx=\"${radial.end-center.x}\" cy=\"${radial.end-center.y}\""
        definition += " r=\"${radial.end-radius}\">"
    | ConicGradient
        =
for stop in gradient.stops
    . offset = stop.offset as Percent as UnitString
    . opacity = stop.color.alpha as Percent as UnitString
    definition += "<stop offset=\"$offset\" stop-color=\"${stop.color as Hex}\""
    definition += " stop-opacity=\"$opacity\"/>"
definition += "</$element></defs>"
strings += definition
. geometry = " x=\"${rect.x}\" y=\"${rect.y}\""
geometry += " width=\"${rect.width}\" height=\"${rect.height}\""
. transform-style = svg-transform-style(state?.current-transform ?? Matrix())
strings += "<rect$geometry fill=\"url(#$id)\" stroke=\"none\"$transform-style/>"

────────────────────
+ do rect
    - rect Rect

if fill-color || stroke-color
    . geometry = " x=\"${rect.x}\" y=\"${rect.y}\""
    geometry += " width=\"${rect.width}\" height=\"${rect.height}\""
    strings += "<rect$geometry${svg-style(FillRule.nonzero)}/>"

────────────────────
+ do square
    - x Coord
    - y Coord
    - width Length

rect(Rect(x, y, width, width))

────────────────────
+ do oval
    - rect Rect

if fill-color || stroke-color
    . cx = rect.x + rect.width / 2
    . cy = rect.y + rect.height / 2
    . geometry = " cx=\"$cx\" cy=\"$cy\""
    geometry += " rx=\"${rect.width / 2}\" ry=\"${rect.height / 2}\""
    strings += "<ellipse$geometry${svg-style(FillRule.nonzero)}/>"

────────────────────
+ do circle
    - cx Coord
    - cy Coord
    - radius Length

if fill-color || stroke-color
    strings += "<circle cx=\"$cx\" cy=\"$cy\" r=\"$radius\"${svg-style(FillRule.nonzero)}/>"

────────────────────
+ do move
    - x Coord
    - y Coord

path-points += "M $x $y"

────────────────────
+ do line
    - x Coord
    - y Coord

path-points += "L $x $y"

────────────────────
+ do curve
    - x1 Coord
    - y1 Coord
    - x2 Coord
    - y2 Coord
    - x3 Coord
    - y3 Coord

path-points += "C $x1,$y1 $x2,$y2 $x3,$y3"

────────────────────
+ do translate
    - x Coord
    - y Coord

transform(matrix-from-translation(Point(x, y)))

────────────────────
+ do begin-opacity
    - opacity Ratio

. value = opacity as Percent as UnitString
strings += "<g opacity=\"$value\">"

────────────────────
+ do end-opacity

strings += "</g>"

────────────────────
+ do begin

//+graphics.canvas.path
path-points = List'String()

────────────────────
+ do enclose

path-points += "Z"

────────────────────
+ do end
    - closed Bool = false
    - fill-rule FillRule = FillRule.nonzero

. points = " ".join(path-points)
. style = if stroke-color || fill-color then svg-style(fill-rule) else ""

if fill-color || stroke-color
    strings += "<path d=\"$points\"$style/>"
    //graphics.canvas.paths ++
//-graphics.canvas.path

────────────────────
+ do close

────────────────────
_ color-to-svg
    - color RGBA?

|? color
    color as Hex
??
    "none"

────────────────────
_ ¶ svg-style
    - fill-rule FillRule

 fill="$fill"$fill-opacity stroke="$stroke"$stroke-opacity stroke-width="$stroke-width"$stroke-style$fill-rule-style$transform-style

════════════════════
.. fill = color-to-svg(state?.fill-color)
.. fill-opacity = svg-opacity-style("fill", state?.fill-color)
.. stroke-opacity = svg-opacity-style("stroke", state?.stroke-color)
.. stroke = color-to-svg(state?.stroke-color)
.. stroke-style = if stroke-color then stroke-attributes else ""
.. stroke-attributes = " stroke-linecap=\"$stroke-cap\" stroke-linejoin=\"$stroke-join\"$dash-style"
.. dash-style = if stroke-dash > 0 then " stroke-dasharray=\"$stroke-dash\"" else ""
.. fill-rule-style = if fill-rule == FillRule.even-odd then " fill-rule=\"evenodd\"" else ""
.. transform-style = svg-transform-style(state?.current-transform ?? Matrix())

────────────────────
_ svg-opacity-style String
    - attribute String
    - color RGBA?

|? alpha < 1
    " ${attribute}-opacity=\"$alpha\""
??
    ""

.. alpha = color?.alpha ?? 1

────────────────────
_ svg-transform-style String
    - matrix Matrix

|? matrix.is-identity
    ""
??
    " transform=\"matrix(${matrix.a} ${matrix.c} ${matrix.b} ${matrix.d} ${matrix.tx} ${matrix.ty})\""

━━━━━━━━━━━━━━━━━━━━
+ CanvasStateScope is Tuple
    is Usable'Void

_ canvas Canvas

────────────────────
+ This
    - canvas

────────────────────
+ do begin-using

canvas.push()

────────────────────
+ do end-using

canvas.pop()

━━━━━━━━━━━━━━━━━━━━
+ do trace-canvas-path
    - canvas Canvas
    - verbs Array'PathVerb
    - coords Array'Coord
    - count Size

. coord Index
. current-x Coord
. current-y Coord
. subpath-x Coord
. subpath-y Coord
. has-current = false
for index in 0 .. < count
    do match? verbs[index]
        |= .path-verb-move
            current-x = coords[coord]
            current-y = coords[coord + 1]
            coord += 2
            subpath-x = current-x
            subpath-y = current-y
            has-current = true
            canvas.move(current-x, current-y)
        |= .path-verb-line
            current-x = coords[coord]
            current-y = coords[coord + 1]
            coord += 2
            canvas.line(current-x, current-y)
        |= .path-verb-cubic
            current-x = coords[coord + 4]
            current-y = coords[coord + 5]
            canvas.curve
                - coords[coord]
                - coords[coord + 1]
                - coords[coord + 2]
                - coords[coord + 3]
                - current-x
                - current-y
            coord += 6
        |= .path-verb-close
            if has-current && (current-x != subpath-x || current-y != subpath-y)
                canvas.line(subpath-x, subpath-y)
                current-x = subpath-x
                current-y = subpath-y
            canvas.enclose()

━━━━━━━━━━━━━━━━━━━━
+ line-cap-code
    - cap LineCap

|? 1i32 if cap == LineCap.round
|? 2i32 if cap == LineCap.square
?? 0i32

━━━━━━━━━━━━━━━━━━━━
+ line-join-code
    - join LineJoin

|? 1i32 if join == LineJoin.round
|? 2i32 if join == LineJoin.bevel
?? 0i32

━━━━━━━━━━━━━━━━━━━━
_ RasterSavedState is Tuple

+ fill RGBA?
+ stroke RGBA?
+ stroke-width Length
+ stroke-cap LineCap
+ stroke-join LineJoin
+ stroke-dash Length
+ text-color RGBA
+ font Font
+ transform Matrix
+ native-fill RGBA
+ native-stroke RGBA
+ native-stroke-width Length
+ native-stroke-cap LineCap
+ native-stroke-join LineJoin
+ native-stroke-dash Length
