────────────────────
+ do push

//gui.canvas.state-pushes ++
. current = state!
. next = spare-state ?? create-state()
spare-state = next.previous
next.copy-from(current)
next.previous = current
state = next

────────────────────
+ do pop

. current = state
. previous = current?.previous
if current && previous
    current.previous = spare-state
    spare-state = current
    state = previous
else
    state = create-state()

