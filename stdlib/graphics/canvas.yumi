────────────────────
+ do fill-gradient
    - rect Rect
    - gradient Gradient

gradient.validate()
//graphics.canvas.primitives ++
gradient-count += 1
primitive-command-count += 1
do match gradient
    | linear LinearGradient
        tally(24, rect.x, rect.y, rect.width, rect.height, linear.start.x, linear.start.y)
        checksum += coordinate-key(linear.end.x) * 17 + coordinate-key(linear.end.y) * 19
    | radial RadialGradient
        . start = radial.start-center
        . end = radial.end-center
        tally(25, rect.x, rect.y, rect.width, rect.height, start.x, start.y)
        checksum += coordinate-key(end.x) * 17 + coordinate-key(end.y) * 19
        checksum += coordinate-key(radial.start-radius) * 47
        checksum += coordinate-key(radial.end-radius) * 53
    | conic ConicGradient
        tally(26, rect.x, rect.y, rect.width, rect.height, conic.center.x, conic.center.y)
        checksum += coordinate-key(conic.angle) * 17
. stops = gradient.stops
for index in 0 .. < stops.length
    . stop = stops[index]
    . order = index + 1
    checksum += order * 23 + coordinate-key(stop.offset) * 29
    checksum += coordinate-key(stop.color.red) * 31 + coordinate-key(stop.color.green) * 37
    checksum += coordinate-key(stop.color.blue) * 41 + coordinate-key(stop.color.alpha) * 43

────────────────────
+ do fill-shader
    - rect Rect
    - shader Shader
    - args [F64] = List'F64()

//graphics.canvas.primitives ++
shader-count += 1
primitive-command-count += 1
tally(27, rect.x, rect.y, rect.width, rect.height, shader.id, args.length as Coord)
for index in 0 .. < args.length
    checksum += (index + 1) * 59 + coordinate-key(args[index]) * 61

