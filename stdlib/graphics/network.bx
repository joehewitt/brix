(import ./_utils)
(import ./curve)
(import ./curve-kernels)
(import ./matrix)
(import ./path)
(import ./point)
(import ./primitives)
(import /core/gc)
(import /math)
(import /stream/aggregate)
(blank)
(prop _ network-pick-depth Size (= 8))
(prop _ network-slot-threshold Size (= 16))

(type + NetworkVertex (is Tuple)
  (prop + id Index)
  (prop + position Point)
)

(type + NetworkSegment (is Tuple)
  (prop + id Index)
  (prop + start Index)
  (prop + end Index)
  (prop + tangent-start Point)
  (prop + tangent-end Point)
  (prop + source Index)
  (prop + source-start Float)
  (prop + source-end Float (= 1))
)

(type + NetworkEnd (is Tuple)
  (prop + segment Index)
  (prop + at-end Bool)
)

(type + NetworkPair (is Tuple)
  (prop + first NetworkEnd)
  (prop + second NetworkEnd)
  (prop + mirror-length Bool (= false))
)

(type + NetworkHit (is Tuple)
  (prop + segment Index)
  (prop + parameter Float)
  (prop + position Point)
  (prop + distance Length)
)

(type + NetworkTrace
  (prop + path _ (= (call Path)))
  (prop + segments (list Index))
  (prop + reversed (list Bool))
  (prop + closed _ (= false))
)

(type + NetworkTraceStep (is Tuple)
  (prop + segment Index)
  (prop + reversed Bool)
  (prop + vertex Index)
)

(type + NetworkOutlineEnds (is Tuple)
  (prop + first NetworkTraceStep)
  (prop + last NetworkTraceStep)
)

(type + NetworkMutationObserver
  (fn-do + network-mutated _
    (param network VectorNetwork)
    (param revision Size)
    (let ignored-network network)
    (let ignored-revision revision)
  )
)

(type + VectorNetwork
  (prop _ vertex-list (list NetworkVertex))
  (prop _ segment-list (list NetworkSegment))
  (prop _ pair-list (list NetworkPair))
  (prop _ next-vertex Index (= 1))
  (prop _ next-segment Index (= 1))
  (prop _ version Size (= 0))
  (prop _ mutation-depth Size)
  (prop _ mutation-pending _ (= false))
  (prop _ mutation-observers (list (of Weak NetworkMutationObserver)))
  (prop _ vertex-slots (? (of Map Index Index)))
  (prop _ segment-slots (? (of Map Index Index)))
  (prop _ trace-scratch (? NetworkTraceLookup))
  (prop _ known-outline (? NetworkOutline))
  (fn-do + This _)
  (fn-do + This _
    (param vertices (list NetworkVertex))
    (param segments (list NetworkSegment))
    (param pairs (list NetworkPair))
    (call (. vertex-list reserve) (. vertices length))
    (call (. segment-list reserve) (. segments length))
    (call (. pair-list reserve) (. pairs length))
    (for (in item vertices)
      (call network-valid-point (. item position))
      (if (!= (call vertex-slot (. item id)) null)
        (throw (call Panic "Duplicate network vertex id"))
      )
      (call append-vertex-item item)
      (= next-vertex (call max next-vertex (+ (. item id) 1)))
    )
    (for (in item segments)
      (call vertex (. item start))
      (call vertex (. item end))
      (call network-valid-point (. item tangent-start))
      (call network-valid-point (. item tangent-end))
      (if (or (not (call is-finite (. item source-start))) (not (call is-finite (. item source-end))))
        (throw (call Panic "Invalid network segment source range"))
      )
      (if (!= (call segment-slot (. item id)) null)
        (throw (call Panic "Duplicate network segment id"))
      )
      (call append-segment-item item)
      (= next-segment (call max next-segment (+ (. item id) 1)))
    )
    (let paired (call (of Map Index Bool)))
    (for (in pair pairs)
      (let first (call network-end-key (. pair first)))
      (let second (call network-end-key (. pair second)))
      (if (or (has paired first) (has paired second))
        (call pair-handles (. pair first) (. pair second) (. pair mirror-length))
        (else
          (call validate-pair (. pair first) (. pair second))
          (+= pair-list pair)
        )
      )
      (= ([] paired first) true)
      (= ([] paired second) true)
    )
    (= version 0)
    (= mutation-pending false)
  )
  (fn-expr + revision _ :get
    version
  )
  (fn-expr + updating _ :get
    (call NetworkUpdateScope this)
  )
  (fn-expr + next-vertex-id _ :get
    next-vertex
  )
  (fn-expr + next-segment-id _ :get
    next-segment
  )
  (fn-expr + vertex-count _ :get
    (. vertex-list length)
  )
  (fn-expr + segment-count _ :get
    (. segment-list length)
  )
  (fn-expr + pair-count _ :get
    (. pair-list length)
  )
  (fn-do + vertices _ :get
    (for (in item vertex-list)
      (yield item)
    )
  )
  (fn-do + segments _ :get
    (for (in item segment-list)
      (yield item)
    )
  )
  (fn-do + pairs _ :get
    (for (in item pair-list)
      (yield item)
    )
  )
  (fn-do + subscribe _
    (param observer NetworkMutationObserver)
    (let index (. mutation-observers length))
    (while (> index 0)
      (-= index 1)
      (let existing (. ([] mutation-observers index) get))
      (if (not existing)
        (call (. mutation-observers remove) index)
        (else-if (== (as existing Pointer) (as observer Pointer))
          (return)
        )
      )
    )
    (let weak (catch? (call Weak observer)))
    (throw (call Panic "Unable to subscribe to vector network mutations") (if (not weak)))
    (+= mutation-observers weak)
  )
  (fn-do + unsubscribe _
    (param observer NetworkMutationObserver)
    (let index (. mutation-observers length))
    (while (> index 0)
      (-= index 1)
      (let existing (. ([] mutation-observers index) get))
      (if (or (not existing) (== (as existing Pointer) (as observer Pointer)))
        (call (. mutation-observers remove) index)
      )
    )
  )
  (fn-do + begin-update _
    (+= mutation-depth 1)
  )
  (fn-do + checkpoint _
    (if (not mutation-depth)
      (call publish-mutation)
    )
  )
  (fn-do + end-update _
    (if mutation-depth
      (-= mutation-depth 1)
    )
    (if (not mutation-depth)
      (call publish-mutation)
    )
  )
  (fn-do + reserve-ids _
    (param vertex Index)
    (param segment Index)
    (= next-vertex (call max next-vertex vertex))
    (= next-segment (call max next-segment segment))
  )
  (fn-expr + vertex _
    (param id Index)
    ([] vertex-list (call require-vertex-slot id))
  )
  (fn-expr + has-vertex _
    (param id Index)
    (!= (call vertex-slot id) null)
  )
  (fn-expr + vertex-index _
    (param id Index)
    (call require-vertex-slot id)
  )
  (fn-expr + segment _
    (param id Index)
    ([] segment-list (call require-segment-slot id))
  )
  (fn-expr + has-segment _
    (param id Index)
    (!= (call segment-slot id) null)
  )
  (fn-expr + segment-index _
    (param id Index)
    (call require-segment-slot id)
  )
  (fn-expr + vertex-at _
    (param index Index)
    ([] vertex-list index)
  )
  (fn-expr + segment-at _
    (param index Index)
    ([] segment-list index)
  )
  (fn-expr + pair-at _
    (param index Index)
    ([] pair-list index)
  )
  (fn-do + degree _
    (param id Index)
    (call vertex id)
    (let count Size 0)
    (for (in item segment-list)
      (if (== (. item start) id)
        (+= count 1)
      )
      (if (== (. item end) id)
        (+= count 1)
      )
    )
    (return count)
  )
  (fn-do + vertex-ends (list NetworkEnd)
    (param id Index)
    (call vertex id)
    (let result (list NetworkEnd))
    (for (in item segment-list)
      (if (== (. item start) id)
        (+= result (call NetworkEnd (. item id)))
      )
      (if (== (. item end) id)
        (+= result (call NetworkEnd (. item id) true))
      )
    )
    (return result)
  )
  (fn-do + add-vertex _
    (param position Point)
    (use updating)
    (call network-valid-point position)
    (let id next-vertex)
    (+= next-vertex 1)
    (call append-vertex-item (call NetworkVertex id position))
    (call record-mutation)
    (return id)
  )
  (fn-do + connect _
    (param start Index)
    (param end Index)
    (param tangent-start Point (= (tuple 0 0)))
    (param tangent-end Point (= (tuple 0 0)))
    (use updating)
    (call vertex start)
    (call vertex end)
    (call network-valid-point tangent-start)
    (call network-valid-point tangent-end)
    (let id next-segment)
    (+= next-segment 1)
    (call append-segment-item (call NetworkSegment id start end tangent-start tangent-end id))
    (call record-mutation)
    (return id)
  )
  (fn-expr + curve _
    (param id Index)
    (call edge-curve (call segment id))
  )
  (fn-do + move-vertex _
    (param id Index)
    (param position Point)
    (use updating)
    (let slot (call require-vertex-slot id))
    (call network-valid-point position)
    (= ([] vertex-list slot) (call NetworkVertex id position))
    (call record-mutation)
  )
  (fn-do + set-tangents _
    (param id Index)
    (param start Point)
    (param end Point)
    (use updating)
    (let slot (call require-segment-slot id))
    (call network-valid-point start)
    (call network-valid-point end)
    (let edge ([] segment-list slot))
    (= edge (= (. edge tangent-start) start))
    (= edge (= (. edge tangent-end) end))
    (= ([] segment-list slot) edge)
    (call record-mutation)
  )
  (fn-expr + end-vertex _
    (param endpoint NetworkEnd)
    (if-expr (. endpoint at-end) (. edge end) (. edge start))
    (where
      (lazy edge (call segment (. endpoint segment)))
    )
  )
  (fn-expr + tangent _
    (param endpoint NetworkEnd)
    (if-expr (. endpoint at-end) (. edge tangent-end) (. edge tangent-start))
    (where
      (lazy edge (call segment (. endpoint segment)))
    )
  )
  (fn-do + pair-handles _
    (param first NetworkEnd)
    (param second NetworkEnd)
    (param mirror-length Bool (= false))
    (use updating)
    (call validate-pair first second)
    (call unpair first)
    (call unpair second)
    (+= pair-list (call NetworkPair first second mirror-length))
    (call record-mutation)
  )
  (fn-do + unpair _
    (param endpoint NetworkEnd)
    (use updating)
    (call segment (. endpoint segment))
    (let i (. pair-list length))
    (while (> i 0)
      (-= i 1)
      (if (or (== (. ([] pair-list i) first) endpoint) (== (. ([] pair-list i) second) endpoint))
        (call (. pair-list remove) i)
        (call record-mutation)
      )
    )
  )
  (fn-do + set-handle _
    (param endpoint NetworkEnd)
    (param value Point)
    (param independent Bool (= false))
    (use updating)
    (call segment (. endpoint segment))
    (call network-valid-point value)
    (call validate-handle endpoint value independent)
    (call set-end-tangent endpoint value)
    (if (not independent)
      (for (in pair pair-list)
        (if (or (== (. pair first) endpoint) (== (. pair second) endpoint))
          (let other (if-expr (== (. pair first) endpoint) (. pair second) (. pair first)))
          (let length (. value length))
          (let opposite (call Point 0 0))
          (if (> length 0)
            (= opposite
              (scope (* value (if-expr (. pair mirror-length) -1 ratio))
                (lazy ratio (/ (- (. (call tangent other) length)) length))
              )
            )
          )
          (call set-end-tangent other opposite)
        )
      )
    )
  )
  (fn-do + remove-segment _
    (param id Index)
    (use updating)
    (call segment id)
    (call unpair (call NetworkEnd id false))
    (call unpair (call NetworkEnd id true))
    (call (. segment-list remove) (call require-segment-slot id))
    (= segment-slots null)
    (= known-outline null)
    (call record-mutation)
  )
  (fn-do + remove-vertex _
    (param id Index)
    (use updating)
    (call vertex id)
    (let i (. segment-list length))
    (while (> i 0)
      (-= i 1)
      (let edge ([] segment-list i))
      (if (or (== (. edge start) id) (== (. edge end) id))
        (call remove-segment (. edge id))
      )
    )
    (call (. vertex-list remove) (call require-vertex-slot id))
    (= vertex-slots null)
    (= known-outline null)
    (call record-mutation)
  )
  (fn-do + merge-vertices _
    (param source Index)
    (param destination Index)
    (param position Point)
    (use updating)
    (call vertex source)
    (call vertex destination)
    (call network-valid-point position)
    (return-if (if (== source destination)))
    (for (in i (..< 0 (. segment-list length)))
      (let edge ([] segment-list i))
      (if (== (. edge start) source)
        (= edge (= (. edge start) destination))
      )
      (if (== (. edge end) source)
        (= edge (= (. edge end) destination))
      )
      (= ([] segment-list i) edge)
    )
    (call remove-vertex source)
    (call move-vertex destination position)
  )
  (fn-do + disconnect Index
    (param endpoint NetworkEnd)
    (use updating)
    (let old (call end-vertex endpoint))
    (let position (. (call vertex old) position))
    (call unpair endpoint)
    (let id (call add-vertex position))
    (for (in i (..< 0 (. segment-list length)))
      (let edge ([] segment-list i))
      (if (== (. edge id) (. endpoint segment))
        (if (. endpoint at-end)
          (= edge (= (. edge end) id))
          (else
            (= edge (= (. edge start) id))
          )
        )
        (= ([] segment-list i) edge)
      )
    )
    (= known-outline null)
    (call record-mutation)
    (return id)
  )
  (fn-do + split Index
    (param id Index)
    (param parameter Float)
    (use updating)
    (let edge (call segment id))
    (let known known-outline)
    (if (or (not (call is-finite parameter)) (<= parameter 0) (>= parameter 1))
      (throw (call Panic "Split parameter must lie inside a segment"))
    )
    (let left Curve)
    (let right Curve)
    (= (tuple left right) (call (. (call curve id) subdivide) parameter))
    (let middle-position (. left anchor2))
    (call network-valid-point middle-position)
    (call network-valid-point (- (. left handle-out) (. left anchor1)))
    (call network-valid-point (- (. left handle-in) (. left anchor2)))
    (call network-valid-point (- (. right handle-out) (. right anchor1)))
    (call network-valid-point (- (. right handle-in) (. right anchor2)))
    (let middle (call add-vertex middle-position))
    (let second
      (call connect
        (block
          (arg middle)
          (arg (. edge end))
          (arg (- (. right handle-out) (. right anchor1)))
          (arg (- (. right handle-in) (. right anchor2)))
        )
      )
    )
    (let boundary (+ (. edge source-start) (* (- (. edge source-end) (. edge source-start)) parameter)))
    (let slot (call require-segment-slot id))
    (let second-slot (call require-segment-slot second))
    (let item ([] segment-list slot))
    (= item (= (. item end) middle))
    (= item (= (. item tangent-start) (- (. left handle-out) (. left anchor1))))
    (= item (= (. item tangent-end) (- (. left handle-in) (. left anchor2))))
    (= item (= (. item source-end) boundary))
    (= ([] segment-list slot) item)
    (let added ([] segment-list second-slot))
    (= added (= (. added source) (. edge source)))
    (= added (= (. added source-start) boundary))
    (= added (= (. added source-end) (. edge source-end)))
    (= ([] segment-list second-slot) added)
    (for (in i (..< 0 (. pair-list length)))
      (let pair ([] pair-list i))
      (if (== (. pair first) (call NetworkEnd id true))
        (= pair (= (. pair first) (call NetworkEnd second true)))
      )
      (if (== (. pair second) (call NetworkEnd id true))
        (= pair (= (. pair second) (call NetworkEnd second true)))
      )
      (= ([] pair-list i) pair)
    )
    (call pair-handles (call NetworkEnd id true) (call NetworkEnd second false))
    (= known-outline (call split-outline slot second-slot middle known))
    (call record-mutation)
    (return middle)
  )
  (fn-do + reverse _
    (use updating)
    (let vertices (call (of List NetworkVertex) (in each (call (. vertex-list reversed)))))
    (let segments
      (call (of List NetworkSegment)
        (block
          (spread (call (. segment-list reversed)))
          (pipe *> (call NetworkSegment (. each id) (. each end) (. each start) (. each tangent-end) (. each tangent-start) (. each source) (. each source-end) (. each source-start)))
        )
      )
    )
    (let pairs
      (call (of List NetworkPair)
        (block
          (spread pair-list)
          (pipe *> (call NetworkPair (call NetworkEnd (. each first segment) (not (. each first at-end))) (call NetworkEnd (. each second segment) (not (. each second at-end))) (. each mirror-length)))
        )
      )
    )
    (= vertex-list vertices)
    (= segment-list segments)
    (= pair-list pairs)
    (= vertex-slots null)
    (= segment-slots null)
    (= known-outline null)
    (call record-mutation)
  )
  (fn-do + add-network _
    (param other VectorNetwork)
    (use updating)
    (let vertex-sources (list Index))
    (let vertex-targets (list Index))
    (for (in item (. other vertex-list))
      (+= vertex-sources (. item id))
      (+= vertex-targets next-vertex)
      (+= next-vertex 1)
    )
    (let segment-sources (list Index))
    (let segment-targets (list Index))
    (for (in item (. other segment-list))
      (+= segment-sources (. item id))
      (+= segment-targets next-segment)
      (+= next-segment 1)
    )
    (for (in item (. other segment-list))
      (if (not (call network-has-id segment-sources (. item source)))
        (+= segment-sources (. item source))
        (+= segment-targets next-segment)
        (+= next-segment 1)
      )
    )
    (for (in item (. other vertex-list))
      (let id (call network-mapped-id vertex-sources vertex-targets (. item id)))
      (call append-vertex-item (call NetworkVertex id (. item position)))
    )
    (for (in item (. other segment-list))
      (let mapped
        (call NetworkSegment
          (block
            (arg (call network-mapped-id segment-sources segment-targets (. item id)))
            (arg (call network-mapped-id vertex-sources vertex-targets (. item start)))
            (arg (call network-mapped-id vertex-sources vertex-targets (. item end)))
            (arg (. item tangent-start))
            (arg (. item tangent-end))
            (arg (call network-mapped-id segment-sources segment-targets (. item source)))
            (arg (. item source-start))
            (arg (. item source-end))
          )
        )
      )
      (call append-segment-item mapped)
    )
    (for (in pair (. other pair-list))
      (let first
        (call NetworkEnd
          (block
            (arg (call network-mapped-id segment-sources segment-targets (. pair first segment)))
            (arg (. pair first at-end))
          )
        )
      )
      (let second
        (call NetworkEnd
          (block
            (arg (call network-mapped-id segment-sources segment-targets (. pair second segment)))
            (arg (. pair second at-end))
          )
        )
      )
      (+= pair-list (call NetworkPair first second (. pair mirror-length)))
    )
    (= known-outline null)
    (call record-mutation)
  )
  (fn-do + cut (list Index)
    (param id Index)
    (param parameters (list Float))
    (use updating)
    (call segment id)
    (let upper 1.0)
    (for (in parameter (call (. parameters reversed)))
      (if (or (not (call is-finite parameter)) (<= parameter 0) (>= parameter upper))
        (throw (call Panic "Cut parameters must increase inside a segment"))
      )
      (= upper parameter)
    )
    (let pieces (list Index))
    (= upper 1.0)
    (for (in parameter (call (. parameters reversed)))
      (call split id (/ parameter upper))
      (let second (- next-segment 1))
      (call disconnect (call NetworkEnd second false))
      (call (. pieces insert) second 0)
      (= upper parameter)
    )
    (call (. pieces insert) id 0)
    (return pieces)
  )
  (fn-do + order-vertices _
    (param ids (list Index))
    (use updating)
    (let placed (list Index))
    (let ordered (list NetworkVertex))
    (for (in id ids)
      (if (not (call network-has-id placed id))
        (+= ordered (call vertex id))
        (+= placed id)
      )
    )
    (for (in item vertex-list)
      (if (not (call network-has-id placed (. item id)))
        (+= ordered item)
      )
    )
    (= vertex-list ordered)
    (= vertex-slots null)
    (= known-outline null)
    (call record-mutation)
  )
  (fn-expr + trace-ends (list Index)
    (param trace NetworkTrace)
    (call (of List Index) start end)
    (where
      (lazy first (call segment ([] (. trace segments) 0)))
      (lazy last (call segment ([] (. trace segments) (- (. trace segments length) 1))))
      (lazy start (if-expr ([] (. trace reversed) 0) (. first end) (. first start)))
      (lazy end (if-expr ([] (. trace reversed) (- (. trace reversed length) 1)) (. last start) (. last end)))
    )
  )
  (fn-do + extract VectorNetwork
    (param trace NetworkTrace)
    (let result (call VectorNetwork))
    (let current ([] (call trace-ends trace) 0))
    (call (. result append-vertex-item) (call vertex current))
    (for (in index (..< 0 (. trace segments length)))
      (let edge (call segment ([] (. trace segments) index)))
      (= current (if-expr ([] (. trace reversed) index) (. edge start) (. edge end)))
      (if (not (call (. result has-vertex) current))
        (call (. result append-vertex-item) (call vertex current))
      )
      (call (. result append-segment-item) edge)
    )
    (for (in pair pair-list)
      (if (and (call network-has-id (. trace segments) (. pair first segment)) has-second)
        (+= (. result pair-list) pair)
      )
      (lazy has-second (call network-has-id (. trace segments) (. pair second segment)))
    )
    (= (. result next-vertex) next-vertex)
    (= (. result next-segment) next-segment)
    (return result)
  )
  (fn-do + copy VectorNetwork
    (let result (call VectorNetwork))
    (call (. result vertex-list reserve) (. vertex-list length))
    (call (. result segment-list reserve) (. segment-list length))
    (call (. result pair-list reserve) (. pair-list length))
    (for (in item vertex-list)
      (call (. result append-vertex-item) item)
    )
    (for (in item segment-list)
      (call (. result append-segment-item) item)
    )
    (for (in item pair-list)
      (+= (. result pair-list) item)
    )
    (= (. result next-vertex) next-vertex)
    (= (. result next-segment) next-segment)
    (= (. result version) version)
    (= (. result known-outline) known-outline)
    (return result)
  )
  (fn-do + duplicate-vertices (list Index)
    (param ids (list Index))
    (use updating)
    (let sources (list Index))
    (let duplicates (list Index))
    (for (in id ids)
      (call vertex id)
      (if (not (call network-has-id sources id))
        (+= sources id)
        (+= duplicates (call add-vertex (. (call vertex id) position)))
      )
    )
    (blank)
    (let prior-segments (list NetworkSegment))
    (for (in edge segment-list)
      (+= prior-segments edge)
    )
    (let source-segments (list Index))
    (let duplicate-segments (list Index))
    (for (in edge prior-segments)
      (let start (call network-mapped-id sources duplicates (. edge start)))
      (let end (call network-mapped-id sources duplicates (. edge end)))
      (if (or (!= start (. edge start)) (!= end (. edge end)))
        (+= source-segments (. edge id))
        (+= duplicate-segments (call connect start end (. edge tangent-start) (. edge tangent-end)))
      )
    )
    (blank)
    (let prior-pairs (list NetworkPair))
    (for (in pair pair-list)
      (+= prior-pairs pair)
    )
    (for (in pair prior-pairs)
      (let first (call network-mapped-id source-segments duplicate-segments (. pair first segment)))
      (let second (call network-mapped-id source-segments duplicate-segments (. pair second segment)))
      (if (and (!= first (. pair first segment)) (!= second (. pair second segment)))
        (call pair-handles
          (block
            (arg (call NetworkEnd first (. pair first at-end)))
            (arg (call NetworkEnd second (. pair second at-end)))
            (arg (. pair mirror-length))
          )
        )
      )
    )
    (return duplicates)
  )
  (fn-do + transform _
    (param matrix Matrix)
    (use updating)
    (let linear (call (. matrix create-shiftless)))
    (for (in item vertex-list)
      (call network-valid-point (call (. matrix transform) (. item position)))
    )
    (for (in item segment-list)
      (call network-valid-point (call (. linear transform) (. item tangent-start)))
      (call network-valid-point (call (. linear transform) (. item tangent-end)))
    )
    (for (in i (..< 0 (. vertex-list length)))
      (let item ([] vertex-list i))
      (= ([] vertex-list i) (call NetworkVertex (. item id) (call (. matrix transform) (. item position))))
    )
    (for (in i (..< 0 (. segment-list length)))
      (let item ([] segment-list i))
      (= item (= (. item tangent-start) (call (. linear transform) (. item tangent-start))))
      (= item (= (. item tangent-end) (call (. linear transform) (. item tangent-end))))
      (= ([] segment-list i) item)
    )
    (call record-mutation)
  )
  (fn-do + pick (? NetworkHit)
    (param position Point)
    (param tolerance Length (= 7))
    (call network-valid-point position)
    (let best (? NetworkHit))
    (for (in edge segment-list)
      (let limit (if-expr best (. best distance) tolerance))
      (let hit (call network-curve-pick (call edge-curve edge) position (. edge id) limit))
      (if (and (<= (. hit distance) tolerance) (or (not best) (< (. hit distance) (. best distance))))
        (= best hit)
      )
    )
    (return best)
  )
  (fn-do + bend _
    (param id Index)
    (param parameter Float)
    (param displacement Point)
    (param lock-start Bool (= false))
    (param lock-end Bool (= false))
    (param preserve-pairs Bool (= true))
    (use updating)
    (let edge (call segment id))
    (call network-valid-point displacement)
    (if (or (not (call is-finite parameter)) (<= parameter 0) (>= parameter 1))
      (throw (call Panic "Bend parameter must lie inside a segment"))
    )
    (let u (- 1 parameter))
    (let a (if-expr lock-start 0.0 (* 3 u u parameter)))
    (let b (if-expr lock-end 0.0 (* 3 u parameter parameter)))
    (let divisor (+ (* a a) (* b b)))
    (if (<= divisor 0)
      (throw (call Panic "Both bend handles are locked"))
    )
    (let start (+ (. edge tangent-start) (* displacement (/ a divisor))))
    (let end (+ (. edge tangent-end) (* displacement (/ b divisor))))
    (call network-valid-point start)
    (call network-valid-point end)
    (if preserve-pairs
      (for (in pair pair-list)
        (if (and (== (. pair first segment) id) (== (. pair second segment) id))
          (throw (call Panic "Bending paired ends of a self-loop requires independent handles"))
        )
      )
    )
    (call validate-handle (call NetworkEnd id false) start (not preserve-pairs))
    (call validate-handle (call NetworkEnd id true) end (not preserve-pairs))
    (call set-handle (call NetworkEnd id false) start (not preserve-pairs))
    (call set-handle (call NetworkEnd id true) end (not preserve-pairs))
  )
  (fn-expr + traces _
    (param paths _ (= true))
    (call collect-traces paths null)
  )
  (fn-do + outline-ends (? NetworkOutlineEnds)
    (return-if (. known-outline ends) (if known-outline))
    (let found (call trace-outline))
    (= known-outline found)
    (return (. found ends))
  )
  (fn-do + geometry Path
    (let result (call Path))
    (call collect-traces false result)
    (return result)
  )
  (fn-do + geometry-bounds Rect
    (let left 0.0)
    (let top 0.0)
    (let right 0.0)
    (let bottom 0.0)
    (let found false)
    (for (in trace (call traces false))
      (for (in index (..< 0 (. trace segments length)))
        (let c (call edge-curve (call segment ([] (. trace segments) index))))
        (let reversed ([] (. trace reversed) index))
        (let head (if-expr reversed (. c anchor2) (. c anchor1)))
        (let tail (if-expr reversed (. c anchor1) (. c anchor2)))
        (let outgoing (if-expr reversed (. c handle-in) (. c handle-out)))
        (let incoming (if-expr reversed (. c handle-out) (. c handle-in)))
        (let line (call network-is-monotone-line c))
        (let xs
          (scope (if-expr line (call line-bounds-1d (. head x) (. tail x)) cubic-xs)
            (lazy cubic-xs (call cubic-bounds-1d (. head x) (. outgoing x) (. incoming x) (. tail x) tolerance))
          )
        )
        (let ys
          (scope (if-expr line (call line-bounds-1d (. head y) (. tail y)) cubic-ys)
            (lazy cubic-ys (call cubic-bounds-1d (. head y) (. outgoing y) (. incoming y) (. tail y) tolerance))
          )
        )
        (if (not found)
          (= left (. xs min))
          (= top (. ys min))
          (= right (. xs max))
          (= bottom (. ys max))
          (= found true)
          (else
            (= left (call min left (. xs min)))
            (= top (call min top (. ys min)))
            (= right (call max right (. xs max)))
            (= bottom (call max bottom (. ys max)))
          )
        )
      )
    )
    (return (call Rect left top (- right left) (- bottom top)))
  )
  (fn-do _ validate-pair _
    (param first NetworkEnd)
    (param second NetworkEnd)
    (if (!= (call end-vertex first) (call end-vertex second))
      (throw (call Panic "Handles must share a vertex"))
    )
    (if (== first second)
      (throw (call Panic "Cannot pair a handle with itself"))
    )
  )
  (fn-do _ validate-handle _
    (param endpoint NetworkEnd)
    (param value Point)
    (param independent Bool)
    (call network-valid-point value)
    (if (not independent)
      (for (in pair pair-list)
        (if (or (== (. pair first) endpoint) (== (. pair second) endpoint))
          (let other (if-expr (== (. pair first) endpoint) (. pair second) (. pair first)))
          (let length (. value length))
          (if (> length 0)
            (call network-valid-point
              (block
                (arg (* value (if-expr (. pair mirror-length) -1 (/ (- (. (call tangent other) length)) length))))
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ set-end-tangent _
    (param endpoint NetworkEnd)
    (param value Point)
    (let edge (call segment (. endpoint segment)))
    (if (. endpoint at-end)
      (call set-tangents (. edge id) (. edge tangent-start) value)
      (else
        (call set-tangents (. edge id) value (. edge tangent-end))
      )
    )
  )
  (fn-do _ record-mutation _
    (+= version 1)
    (= mutation-pending true)
    (if (not mutation-depth)
      (call publish-mutation)
    )
  )
  (fn-do _ publish-mutation _
    (return-if (if (not mutation-pending)))
    (= mutation-pending false)
    (let index (. mutation-observers length))
    (while (> index 0)
      (-= index 1)
      (let observer (. ([] mutation-observers index) get))
      (if observer
        (call (. observer network-mutated) this version)
        (else
          (call (. mutation-observers remove) index)
        )
      )
    )
  )
  (fn-do _ trace-outline NetworkOutline
    (return-if (call NetworkOutline null true (. vertex-list length)) (if (not (. segment-list length))))
    (let lookup (call outline-lookup))
    (let first (? NetworkTraceStep))
    (let last (? NetworkTraceStep))
    (let chains Size 0)
    (let cycles Size 0)
    (for (in slot (..< 0 (. vertex-list length)))
      (if (!= ([] (. lookup degrees) slot) 2)
        (for (in position (..< 0 (call incident-count lookup slot)))
          (let edge (call incident-at lookup slot position))
          (if (not ([] (. lookup used) edge))
            (let walked (call walk-trace lookup slot edge))
            (= first (?? first (. walked first)))
            (= last (. walked last))
            (+= chains 1)
          )
        )
      )
    )
    (for (in edge (..< 0 (. segment-list length)))
      (if (not ([] (. lookup used) edge))
        (let walked (call walk-trace lookup ([] (. lookup starts) edge) edge))
        (= first (?? first (. walked first)))
        (= last (. walked last))
        (+= cycles 1)
      )
    )
    (return (call NetworkOutline (call NetworkOutlineEnds (!! first) (!! last)) (and (== chains 1) (not cycles)) (. vertex-list length)))
  )
  (fn-do _ extend-outline (? NetworkOutline)
    (param item NetworkSegment)
    (let known known-outline)
    (return-if null (if (or (not known) (not (. known chain)) (== (. item start) (. item end)))))
    (let slot (. segment-list length))
    (if (not (. known ends))
      (let reversed (> (call require-vertex-slot (. item start)) (call require-vertex-slot (. item end))))
      (let step (call NetworkTraceStep slot reversed (if-expr reversed (. item start) (. item end))))
      (return (call NetworkOutline (call NetworkOutlineEnds step step) true (. vertex-list length)))
    )
    (let tail (. known ends last vertex))
    (let reversed (== (. item end) tail))
    (return-if null (if (and (!= (. item start) tail) (not reversed))))
    (let other (if-expr reversed (. item start) (. item end)))
    (return-if null (if (< (call require-vertex-slot other) (. known fresh))))
    (return
      (call NetworkOutline
        (block
          (arg (call NetworkOutlineEnds (. known ends first) (call NetworkTraceStep slot reversed other)))
          (arg true)
          (arg (. vertex-list length))
        )
      )
    )
  )
  (fn-do _ split-outline (? NetworkOutline)
    (param slot Index)
    (param second-slot Index)
    (param middle Index)
    (param known (? NetworkOutline))
    (return-if null (if (or (not known) (not (. known chain)) (not (. known ends)))))
    (let first (. known ends first))
    (let last (. known ends last))
    (if (== (. first segment) slot)
      (= first
        (scope (if-expr (. first reversed) reversed-first (call NetworkTraceStep slot false middle))
          (lazy reversed-first (call NetworkTraceStep second-slot true middle))
        )
      )
    )
    (if (== (. last segment) slot)
      (= last
        (scope (if-expr (. last reversed) (call NetworkTraceStep slot true (. last vertex)) forward-last)
          (lazy forward-last (call NetworkTraceStep second-slot false (. last vertex)))
        )
      )
    )
    (return (call NetworkOutline (call NetworkOutlineEnds first last) true (. vertex-list length)))
  )
  (fn-do _ walk-trace NetworkOutlineEnds
    (param lookup NetworkTraceLookup)
    (param start Index)
    (param first Index)
    (let current start)
    (let next first)
    (let opening (? NetworkTraceStep))
    (let step (? NetworkTraceStep))
    (let has-next true)
    (while has-next
      (let edge-start ([] (. lookup starts) next))
      (let edge-end ([] (. lookup ends) next))
      (let reversed (and (== edge-end current) (!= edge-start current)))
      (= ([] (. lookup used) next) true)
      (= current (if-expr reversed edge-start edge-end))
      (= step (call NetworkTraceStep next reversed (. ([] vertex-list current) id)))
      (= opening (?? opening step))
      (= has-next false)
      (if (and (!= current start) (== ([] (. lookup degrees) current) 2))
        (for (in position (..< 0 (call incident-count lookup current)))
          (let candidate (call incident-at lookup current position))
          (if (not ([] (. lookup used) candidate))
            (= next candidate)
            (= has-next true)
            (break)
          )
        )
      )
    )
    (return (call NetworkOutlineEnds (!! opening) (!! step)))
  )
  (fn-expr _ incident-count Index
    (param lookup NetworkTraceLookup)
    (param slot Index)
    (case? (not (. lookup paired))
      (- ([] (. lookup offsets) (+ slot 1)) ([] (. lookup offsets) slot))
    )
    (case? (== ([] (. lookup first-edges) slot) (. segment-list length))
      0
    )
    (case? (== ([] (. lookup second-edges) slot) (. segment-list length))
      1
    )
    (default
      2
    )
  )
  (fn-expr _ incident-at Index
    (param lookup NetworkTraceLookup)
    (param slot Index)
    (param position Index)
    (case? (not (. lookup paired))
      ([] (. lookup incident) (+ ([] (. lookup offsets) slot) position))
    )
    (case? (== position 0)
      ([] (. lookup first-edges) slot)
    )
    (default
      ([] (. lookup second-edges) slot)
    )
  )
  (fn-do _ outline-lookup NetworkTraceLookup
    (let lookup (?? trace-scratch (call NetworkTraceLookup)))
    (= trace-scratch lookup)
    (let none (. segment-list length))
    (call (. lookup starts clear))
    (call (. lookup ends clear))
    (call (. lookup degrees clear))
    (call (. lookup used clear))
    (call (. lookup first-edges clear))
    (call (. lookup second-edges clear))
    (call (. lookup degrees reserve) (. vertex-list length))
    (call (. lookup first-edges reserve) (. vertex-list length))
    (call (. lookup second-edges reserve) (. vertex-list length))
    (call (. lookup starts reserve) none)
    (call (. lookup ends reserve) none)
    (call (. lookup used reserve) none)
    (for (in slot (..< 0 (. vertex-list length)))
      (+= (. lookup degrees) 0)
      (+= (. lookup first-edges) none)
      (+= (. lookup second-edges) none)
    )
    (for (in edge (..< 0 none))
      (let segment ([] segment-list edge))
      (let start (call require-vertex-slot (. segment start)))
      (let end (call require-vertex-slot (. segment end)))
      (+= (. lookup starts) start)
      (+= (. lookup ends) end)
      (+= (. lookup used) false)
      (+= ([] (. lookup degrees) start) 1)
      (+= ([] (. lookup degrees) end) 1)
      (return-if (call trace-lookup) (if (not (call pair-edge lookup start edge none))))
      (if (!= end start)
        (return-if (call trace-lookup) (if (not (call pair-edge lookup end edge none))))
      )
    )
    (= (. lookup paired) true)
    (return lookup)
  )
  (fn-do _ pair-edge Bool
    (param lookup NetworkTraceLookup)
    (param slot Index)
    (param edge Index)
    (param none Index)
    (if (== ([] (. lookup first-edges) slot) none)
      (= ([] (. lookup first-edges) slot) edge)
      (else-if (== ([] (. lookup second-edges) slot) none)
        (= ([] (. lookup second-edges) slot) edge)
      )
      (else
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ collect-traces (list NetworkTrace)
    (param paths Bool)
    (param target (? Path))
    (let lookup (call trace-lookup))
    (let result (list NetworkTrace))
    (for (in slot (..< 0 (. vertex-list length)))
      (if (!= ([] (. lookup degrees) slot) 2)
        (for (in position (..< ([] (. lookup offsets) slot) ([] (. lookup offsets) (+ slot 1))))
          (let edge ([] (. lookup incident) position))
          (if (not ([] (. lookup used) edge))
            (+= result (call trace-chain lookup slot edge paths target))
          )
        )
      )
    )
    (for (in edge (..< 0 (. segment-list length)))
      (if (not ([] (. lookup used) edge))
        (+= result (call trace-chain lookup ([] (. lookup starts) edge) edge paths target))
      )
    )
    (return result)
  )
  (fn-do _ trace-lookup _
    (let lookup (?? trace-scratch (call NetworkTraceLookup)))
    (= trace-scratch lookup)
    (= (. lookup paired) false)
    (let counts (. lookup counts))
    (call (. lookup starts clear))
    (call (. lookup ends clear))
    (call (. lookup degrees clear))
    (call (. lookup offsets clear))
    (call (. lookup incident clear))
    (call (. lookup used clear))
    (call (. counts clear))
    (call (. lookup degrees reserve) (. vertex-list length))
    (call (. counts reserve) (. vertex-list length))
    (call (. lookup offsets reserve) (+ (. vertex-list length) 1))
    (call (. lookup starts reserve) (. segment-list length))
    (call (. lookup ends reserve) (. segment-list length))
    (call (. lookup used reserve) (. segment-list length))
    (for (in slot (..< 0 (. vertex-list length)))
      (+= (. lookup degrees) 0)
      (+= counts 0)
    )
    (for (in edge segment-list)
      (let start (call require-vertex-slot (. edge start)))
      (let end (call require-vertex-slot (. edge end)))
      (+= (. lookup starts) start)
      (+= (. lookup ends) end)
      (+= ([] (. lookup degrees) start) 1)
      (+= ([] (. lookup degrees) end) 1)
      (+= ([] counts start) 1)
      (if (!= end start)
        (+= ([] counts end) 1)
      )
      (+= (. lookup used) false)
    )
    (let total Index)
    (for (in slot (..< 0 (. vertex-list length)))
      (+= (. lookup offsets) total)
      (+= total ([] counts slot))
      (= ([] counts slot) ([] (. lookup offsets) slot))
    )
    (+= (. lookup offsets) total)
    (call (. lookup incident reserve) total)
    (for (in position (..< 0 total))
      (+= (. lookup incident) 0)
    )
    (for (in edge (..< 0 (. segment-list length)))
      (let start ([] (. lookup starts) edge))
      (= ([] (. lookup incident) ([] counts start)) edge)
      (+= ([] counts start) 1)
      (let end ([] (. lookup ends) edge))
      (if (!= end start)
        (= ([] (. lookup incident) ([] counts end)) edge)
        (+= ([] counts end) 1)
      )
    )
    (return lookup)
  )
  (fn-do _ trace-chain _
    (param lookup NetworkTraceLookup)
    (param start Index)
    (param first Index)
    (param paths Bool)
    (param target (? Path))
    (let result (call NetworkTrace))
    (let path (?? target (. result path)))
    (let drawn (or paths (!= target null)))
    (if drawn
      (call (. path move-to) (. ([] vertex-list start) position))
    )
    (let current start)
    (let next first)
    (let has-next true)
    (while has-next
      (let edge ([] segment-list next))
      (let edge-start ([] (. lookup starts) next))
      (let edge-end ([] (. lookup ends) next))
      (let reversed (and (== edge-end current) (!= edge-start current)))
      (if drawn
        (let c
          (call network-edge-curve
            (block
              (arg edge)
              (arg (. ([] vertex-list edge-start) position))
              (arg (. ([] vertex-list edge-end) position))
            )
          )
        )
        (if (call network-is-monotone-line c)
          (call (. path line-to) (if-expr reversed (. c anchor1) (. c anchor2)))
          (else
            (call (. path cubic-curve-to)
              (block
                (arg (if-expr reversed (. c handle-in) (. c handle-out)))
                (arg (if-expr reversed (. c handle-out) (. c handle-in)))
                (arg (if-expr reversed (. c anchor1) (. c anchor2)))
              )
            )
          )
        )
      )
      (+= (. result segments) (. edge id))
      (+= (. result reversed) reversed)
      (= ([] (. lookup used) next) true)
      (= current (if-expr reversed edge-start edge-end))
      (if (== current start)
        (= (. result closed) true)
        (if drawn
          (call (. path close))
        )
        (break)
      )
      (= has-next false)
      (if (== ([] (. lookup degrees) current) 2)
        (for (in position (..< ([] (. lookup offsets) current) ([] (. lookup offsets) (+ current 1))))
          (let candidate ([] (. lookup incident) position))
          (if (not ([] (. lookup used) candidate))
            (= next candidate)
            (= has-next true)
            (break)
          )
        )
      )
    )
    (return result)
  )
  (fn-expr _ edge-curve _
    (param edge NetworkSegment)
    (call network-edge-curve edge (. (call vertex (. edge start)) position) (. (call vertex (. edge end)) position))
  )
  (fn-do _ vertex-slot (? Index)
    (param id Index)
    (let count (. vertex-list length))
    (return-if (- id 1) (if (and (> id 0) (<= id count) (== (. ([] vertex-list (- id 1)) id) id))))
    (if (<= count network-slot-threshold)
      (for (in slot (..< 0 count))
        (return-if slot (if (== (. ([] vertex-list slot) id) id)))
      )
      (return null)
    )
    (if (not vertex-slots)
      (let slots (call (of Map Index Index)))
      (for (in slot (..< 0 count))
        (= ([] slots (. ([] vertex-list slot) id)) slot)
      )
      (= vertex-slots slots)
    )
    (return ([] (!! vertex-slots) id))
  )
  (fn-do _ segment-slot (? Index)
    (param id Index)
    (let count (. segment-list length))
    (return-if (- id 1) (if (and (> id 0) (<= id count) (== (. ([] segment-list (- id 1)) id) id))))
    (if (<= count network-slot-threshold)
      (for (in slot (..< 0 count))
        (return-if slot (if (== (. ([] segment-list slot) id) id)))
      )
      (return null)
    )
    (if (not segment-slots)
      (let slots (call (of Map Index Index)))
      (for (in slot (..< 0 count))
        (= ([] slots (. ([] segment-list slot) id)) slot)
      )
      (= segment-slots slots)
    )
    (return ([] (!! segment-slots) id))
  )
  (fn-expr _ require-vertex-slot Index
    (param id Index)
    (before
      (throw (call Panic "Unknown network vertex") (if (== slot null)))
    )
    slot
    (where
      (lazy slot (call vertex-slot id))
    )
  )
  (fn-expr _ require-segment-slot Index
    (param id Index)
    (before
      (throw (call Panic "Unknown network segment") (if (== slot null)))
    )
    slot
    (where
      (lazy slot (call segment-slot id))
    )
  )
  (fn-do _ append-vertex-item _
    (param item NetworkVertex)
    (if vertex-slots
      (= ([] (!! vertex-slots) (. item id)) (. vertex-list length))
    )
    (+= vertex-list item)
  )
  (fn-do _ append-segment-item _
    (param item NetworkSegment)
    (= known-outline (call extend-outline item))
    (if segment-slots
      (= ([] (!! segment-slots) (. item id)) (. segment-list length))
    )
    (+= segment-list item)
  )
)

(type + NetworkUpdateScope (is Tuple)
  (implements (of Usable Void))
  (prop _ network VectorNetwork)
  (fn-do + This _
    (param network _)
  )
  (fn-do + begin-using _
    (call (. network begin-update))
  )
  (fn-do + end-using _
    (call (. network end-update))
  )
)

(fn-do + network-from-path _
  (param path Path)
  (let network (call VectorNetwork))
  (for (in subpath (. path subpaths))
    (let material (call (. subpath materialize)))
    (if (not (. material count))
      (continue)
    )
    (let first (call (. network add-vertex) (. material first-point)))
    (let previous first)
    (let count (. material curve-count))
    (for (in i (..< 0 count))
      (let curve (call (. material get-curve) i))
      (let next
        (scope (if-expr closes first (call (. network add-vertex) (. curve anchor2)))
          (lazy closes (and (. subpath is-closed) (== i (- count 1))))
        )
      )
      (call (. network connect)
        (block
          (arg previous)
          (arg next)
          (arg (- (. curve handle-out) (. curve anchor1)))
          (arg (- (. curve handle-in) (. curve anchor2)))
        )
      )
      (= previous next)
    )
  )
  (return network)
)

(fn-expr + network-has-id _
  (param ids (list Index))
  (param id Index)
  (call some ids (:where (== each id)))
)

(fn-do + network-valid-point _
  (param point Point)
  (if (or (not (call is-finite (. point x))) (not (call is-finite (. point y))))
    (throw (call Panic "Network coordinates must be finite"))
  )
)

(fn-expr + network-curve-point Point
  (param curve Curve)
  (param t Float)
  (+ anchor handle-out handle-in end)
  (where
    (lazy u (- 1 t))
    (lazy anchor (* (. curve anchor1) (* u u u)))
    (lazy handle-out (* (. curve handle-out) (* 3 u u t)))
    (lazy handle-in (* (. curve handle-in) (* 3 u t t)))
    (lazy end (* (. curve anchor2) (* t t t)))
  )
)

(fn-expr + network-is-monotone-line _
  (param curve Curve)
  (case? (not (. curve is-line-like))
    false
  )
  (default
    (and (>= first 0) (>= second first) (<= second length))
  )
  (where
    (lazy delta (- (. curve anchor2) (. curve anchor1)))
    (lazy length (call (. delta dot) delta))
    (lazy first (call (. (- (. curve handle-out) (. curve anchor1)) dot) delta))
    (lazy second (call (. (- (. curve handle-in) (. curve anchor1)) dot) delta))
  )
)

(fn-do + network-curve-pick NetworkHit
  (param curve Curve)
  (param point Point)
  (param id Index (= 0))
  (param limit (? Length) (= null))
  (if (and (== (. curve handle-out) (. curve anchor1)) (== (. curve handle-in) (. curve anchor2)))
    (let delta (- (. curve anchor2) (. curve anchor1)))
    (let squared (call (. delta dot) delta))
    (let fraction 0.0)
    (if (> squared 0)
      (let projected (/ (call (. (- point (. curve anchor1)) dot) delta) squared))
      (= fraction (call max 0.0 (call min 1.0 projected)))
    )
    (let closest (+ (. curve anchor1) (* delta fraction)))
    (let parameter (if-expr (> squared 0) (call (. curve get-parameter) closest) 0.0))
    (return (call NetworkHit id parameter closest (call (. point distance) closest)))
  )
  (let best (call NetworkHit id 0 (. curve anchor1) (call (. point distance) (. curve anchor1))))
  (let last-distance (call (. point distance) (. curve anchor2)))
  (if (< last-distance (. best distance))
    (= best (call NetworkHit id 1 (. curve anchor2) last-distance))
  )
  (return (call network-pick-range curve curve point 0 1 best 0 limit))
)

(type _ NetworkOutline (is Tuple)
  (prop + ends (? NetworkOutlineEnds))
  (prop + chain Bool)
  (prop + fresh Index)
)

(type _ NetworkTraceLookup
  (prop + starts (list Index))
  (prop + ends (list Index))
  (prop + degrees (list Index))
  (prop + offsets (list Index))
  (prop + incident (list Index))
  (prop + used (list Bool))
  (prop + counts (list Index))
  (prop + first-edges (list Index))
  (prop + second-edges (list Index))
  (prop + paired _ (= false))
)

(fn-do _ network-mapped-id Index
  (param sources (list Index))
  (param destinations (list Index))
  (param id Index)
  (for (in i (..< 0 (. sources length)))
    (return-if ([] destinations i) (if (== ([] sources i) id)))
  )
  (return id)
)

(fn-expr _ network-end-key Index
  (param endpoint NetworkEnd)
  (+ (* (. endpoint segment) 2) (if-expr (. endpoint at-end) 1 0))
)

(fn-expr _ network-edge-curve _
  (param edge NetworkSegment)
  (param start Point)
  (param end Point)
  (call Curve start (+ start (. edge tangent-start)) (+ end (. edge tangent-end)) end)
)

(fn-do _ network-pick-range NetworkHit
  (param original Curve)
  (param curve Curve)
  (param point Point)
  (param lo Float)
  (param hi Float)
  (param best NetworkHit)
  (param depth Size)
  (param limit (? Length))
  (let min-x (call min (call min (. curve anchor1 x) (. curve anchor2 x)) (call min (. curve handle-out x) (. curve handle-in x))))
  (let max-x (call max (call max (. curve anchor1 x) (. curve anchor2 x)) (call max (. curve handle-out x) (. curve handle-in x))))
  (let min-y (call min (call min (. curve anchor1 y) (. curve anchor2 y)) (call min (. curve handle-out y) (. curve handle-in y))))
  (let max-y (call max (call max (. curve anchor1 y) (. curve anchor2 y)) (call max (. curve handle-out y) (. curve handle-in y))))
  (let nearest (call Point (call max min-x (call min max-x (. point x))) (call max min-y (call min max-y (. point y)))))
  (let bound (if-expr limit (call min (. best distance) limit) (. best distance)))
  (return-if best (if (> (call (. nearest distance) point) bound)))
  (let mid (/ (+ lo hi) 2))
  (let candidate (call network-curve-point original mid))
  (let distance (call (. candidate distance) point))
  (let result best)
  (if (< distance (. result distance))
    (= result (call NetworkHit (. best segment) mid candidate distance))
  )
  (return-if result (if (< (call max (- max-x min-x) (- max-y min-y)) 0.00001)))
  (return-if (call network-pick-refined original point lo hi result) (if (>= depth network-pick-depth)))
  (let left Curve)
  (let right Curve)
  (= (tuple left right) (call (. curve subdivide) 0.5))
  (= result (call network-pick-range original left point lo mid result (+ depth 1) limit))
  (return (call network-pick-range original right point mid hi result (+ depth 1) limit))
)

(fn-do _ network-pick-refined _
  (param curve Curve)
  (param point Point)
  (param lo Float)
  (param hi Float)
  (param best NetworkHit)
  (return-if best (if (or (>= (call network-pick-slope curve point lo) 0) (<= (call network-pick-slope curve point hi) 0))))
  (let low lo)
  (let high hi)
  (let t (/ (+ lo hi) 2))
  (let settled (* (- hi lo) 0.00002))
  (for (in pass (..< 0 32))
    (let slope (call network-pick-slope curve point t))
    (if (== slope 0)
      (break)
    )
    (if (< slope 0)
      (= low t)
      (else
        (= high t)
      )
    )
    (let bend (call network-pick-bend curve point t))
    (let next (if-expr (> bend 0) (- t (/ slope bend)) (/ (+ low high) 2)))
    (if (or (<= next low) (>= next high))
      (= next (/ (+ low high) 2))
    )
    (let moved (call abs (- next t)))
    (= t next)
    (if (<= moved settled)
      (break)
    )
  )
  (let candidate (call network-curve-point curve t))
  (let distance (call (. candidate distance) point))
  (return (if-expr (< distance (. best distance)) (call NetworkHit (. best segment) t candidate distance) best))
)

(fn-expr _ network-pick-slope _
  (param curve Curve)
  (param point Point)
  (param t Float)
  (call (. (- (call network-curve-point curve t) point) dot) (call network-curve-velocity curve t))
)

(fn-expr _ network-pick-bend _
  (param curve Curve)
  (param point Point)
  (param t Float)
  (+ (call (. velocity dot) velocity) (call (. (- (call network-curve-point curve t) point) dot) turn))
  (where
    (lazy velocity (call network-curve-velocity curve t))
    (lazy u (- 1 t))
    (lazy first (+ (- (. curve handle-in) (* (. curve handle-out) 2)) (. curve anchor1)))
    (lazy second (+ (- (. curve anchor2) (* (. curve handle-in) 2)) (. curve handle-out)))
    (lazy turn (+ (* first (* 6 u)) (* second (* 6 t))))
  )
)

(fn-expr _ network-curve-velocity _
  (param curve Curve)
  (param t Float)
  (+ start middle end)
  (where
    (lazy u (- 1 t))
    (lazy start (* (- (. curve handle-out) (. curve anchor1)) (* 3 u u)))
    (lazy middle (* (- (. curve handle-in) (. curve handle-out)) (* 6 u t)))
    (lazy end (* (- (. curve anchor2) (. curve handle-in)) (* 3 t t)))
  )
)
