
./curve-kernels
./point
./primitives
./utils
/math

━━━━━━━━━━━━━━━━━━━━
+ Curve is Tuple

+ anchor1 Point
+ handle-out Point
+ handle-in Point
+ anchor2 Point
+ type SegmentType = .segment-type-cubic

────────────────────
+ get is-line-like

line-like-scalars()
    - anchor1.x
    - anchor1.y
    - handle-out.x
    - handle-out.y
    - handle-in.x
    - handle-in.y
    - anchor2.x
    - anchor2.y

────────────────────
+ this == other Curve

a && b && c && d

.. a = anchor1 == other.anchor1
.. b = handle-out == other.handle-out
.. c = handle-in == other.handle-in
.. d = anchor2 == other.anchor2

────────────────────
+ equals-reverse
    - other Curve

a && b && c && d

.. a = anchor1 == other.anchor2
.. b = handle-out == other.handle-in
.. c = handle-in == other.handle-out
.. d = anchor2 == other.anchor1

────────────────────
+ get-parameter
    - point Point

cubic-parameter-at-point()
    - point.x
    - point.y
    - anchor1.x
    - anchor1.y
    - handle-out.x
    - handle-out.y
    - handle-in.x
    - handle-in.y
    - anchor2.x
    - anchor2.y
    - tolerance

────────────────────
+ split-at-range Curve
    - t1 PointOnCurve
    - t2 PointOnCurve

curve-from-scalars(range)

.. range = curve-range-scalars()
    - type
    - anchor1.x
    - anchor1.y
    - handle-out.x
    - handle-out.y
    - handle-in.x
    - handle-in.y
    - anchor2.x
    - anchor2.y
    - t1
    - t2

` CREDIT: Paper.js

────────────────────
+ subdivide
    - t

curve-from-scalars(split.left), curve-from-scalars(split.right)
    .. split = cubic-subdivide-scalars()
        - anchor1.x
        - anchor1.y
        - handle-out.x
        - handle-out.y
        - handle-in.x
        - handle-in.y
        - anchor2.x
        - anchor2.y
        - t

────────────────────
_ curve-from-scalars Curve
    - scalars CurveRangeScalars

Curve(anchor1, handle-out, handle-in, anchor2, scalars.type)

.. anchor1 = Point(scalars.x1, scalars.y1)
.. handle-out = Point(scalars.hox, scalars.hoy)
.. handle-in = Point(scalars.hix, scalars.hiy)
.. anchor2 = Point(scalars.x2, scalars.y2)
