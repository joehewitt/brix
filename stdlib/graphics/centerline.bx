(import ./canvas)
(import ./curve-fit)
(import ./point)
(import ./primitives)
(import ./vector)
(import /math)
(import /stream/sort)
(blank)
(prop _ centerline-ink-floor _ (= 0.04))
(prop _ centerline-dot-floor _ (= 0.02))
(prop _ centerline-bend-angle _ (= 0.6))
(prop _ centerline-pair-score _ (= 0.7))
(prop _ centerline-straight-score _ (= 0.94))
(prop _ centerline-spur-reach _ (= 1.25))
(prop _ centerline-cut-reach _ (= 1.25))
(prop _ centerline-tip-depth _ (= 0.8))
(prop _ centerline-dot-extent _ (= 2.0))
(prop _ centerline-dot-span _ (= 4.0))
(prop _ centerline-shift-limit _ (= 1.2))
(prop _ centerline-prune-rounds Index (= 4))
(prop _ centerline-circle-handle _ (= 0.5522847498))

(type + TracedStroke (is Tuple)
  (prop + ops (list PathOp))
  (prop + is-filled Bool)
)

(type + CenterlineTrace (is Tuple)
  (prop + strokes (list TracedStroke))
  (prop + stroke-width Length)
)

(fn-do + canvas-ink ([] Byte)
  (param canvas RasterCanvas)
  (let pixels (call (. canvas premultiplied-pixels)))
  (let count (/ (. pixels size) 4))
  (let ink ([] Byte count))
  (for (in index (..< 0 count))
    (let base (* index 4))
    (let red (as ([] pixels base) F64))
    (let green (as ([] pixels (+ base 1)) F64))
    (let blue (as ([] pixels (+ base 2)) F64))
    (let alpha (as ([] pixels (+ base 3)) F64))
    (let light (- (+ (* 0.2126 red) (* 0.7152 green) (* 0.0722 blue) 255) alpha))
    (= ([] ink index) (as (- 255 (call clamp (call round light) 0.0 255.0)) Byte))
  )
  (return ink)
)

(fn-expr + trace-centerlines CenterlineTrace
  (param ink ([] Byte))
  (param width Size)
  (param height Size)
  (param tolerance Length (= 1.0))
  (param origin _ (= (call Point 0 0)))
  (param scale _ (= 1.0))
  (call CenterlineTrace strokes (* (. traced stroke-width) scale))
  (where
    (lazy traced (call (. (call CenterlineTracer ink width height tolerance) trace)))
    (lazy strokes
      (call (of List TracedStroke)
        (block
          (arg (in (call TracedStroke (call centerline-map-ops (. each ops) origin scale) (. each is-filled)) (. traced strokes)))
        )
      )
    )
  )
)

(type _ CenterlineNode
  (prop + pixels (list Index))
  (prop + center Point)
  (prop + depth Length)
  (prop + is-junction Bool)
  (prop + cross Point)
  (fn-do + This _
    (param pixels _)
    (param center _)
    (param depth _)
    (param is-junction _)
    (= cross center)
  )
)

(type _ CenterlineLink (is Tuple)
  (prop + edge Index)
  (prop + at-start Bool)
  (prop + bridge Point)
  (prop + is-corner Bool)
)

(type _ CenterlineEnd (is Tuple)
  (prop + edge Index)
  (prop + at-start Bool)
  (prop + tip Point)
  (prop + direction Point)
)

(type _ CenterlineEdge
  (prop + chain (list Index))
  (prop + start (? Index))
  (prop + finish (? Index))
  (prop + points (list Point))
  (prop + start-link (? CenterlineLink))
  (prop + finish-link (? CenterlineLink))
  (prop + is-dot _ (= false))
  (prop + is-used _ (= false))
  (fn-do + This _
    (param chain _)
    (param start _)
    (param finish _)
  )
)

(type _ CenterlineChain (is Tuple)
  (prop + points (list Point))
  (prop + corners (list Index))
  (prop + is-closed Bool)
)

(type _ CenterlineTracer
  (prop + width Size)
  (prop + height Size)
  (prop + tolerance Length)
  (prop + stride Size)
  (prop + rows Size)
  (prop + cover ([] F64))
  (prop + depth ([] F64))
  (prop + skeleton ([] U8))
  (prop + owner ([] U32))
  (prop + visited ([] U8))
  (prop + radius Length)
  (prop + widths (list F64))
  (prop + nodes (list CenterlineNode))
  (prop + edges (list CenterlineEdge))
  (fn-do + This _
    (param ink ([] Byte))
    (param width _)
    (param height _)
    (param tolerance _)
    (= stride (+ width 2))
    (= rows (+ height 2))
    (let cells (* stride rows))
    (= cover ([] F64 cells))
    (= skeleton ([] U8 cells))
    (= owner ([] U32 cells))
    (= visited ([] U8 cells))
    (for (in y (..< 0 height))
      (for (in x (..< 0 width))
        (let value (/ (as ([] ink (+ (* y width) x)) F64) 255))
        (let index (+ (* (+ y 1) stride) x 1))
        (= ([] cover index) value)
        (if (>= value 0.5)
          (= ([] skeleton index) 1)
        )
      )
    )
    (= depth (call centerline-distances skeleton stride rows))
  )
  (fn-do + trace CenterlineTrace
    (call thin)
    (call clean)
    (= radius (call typical-radius))
    (call build-graph)
    (for (in pass (..< 0 centerline-prune-rounds))
      (if (not (call prune))
        (break)
      )
      (call clean)
      (call build-graph)
    )
    (let dots (call mark-dots))
    (call shape-edges)
    (let stroke-width (if-expr widths (call centerline-median widths) (* radius 2)))
    (call connect-junctions)
    (let strokes (call (of List TracedStroke)))
    (for (in chain (call chains))
      (+= strokes (call fit-chain chain))
    )
    (for (in dot dots)
      (+= strokes (call dot-stroke dot stroke-width))
    )
    (return (call CenterlineTrace strokes stroke-width))
  )
  (fn-expr _ around Index
    (param index Index)
    (param k Index)
    (case? (== k 0)
      (+ index 1)
    )
    (case? (== k 1)
      (- (+ index 1) stride)
    )
    (case? (== k 2)
      (- index stride)
    )
    (case? (== k 3)
      (- index stride 1)
    )
    (case? (== k 4)
      (- index 1)
    )
    (case? (== k 5)
      (- (+ index stride) 1)
    )
    (case? (== k 6)
      (+ index stride)
    )
    (default
      (+ index stride 1)
    )
  )
  (fn-expr _ is-on Int
    (param index Index)
    (if-expr (!= ([] skeleton index) 0) 1 0)
  )
  (fn-do _ neighbors Int
    (param index Index)
    (let count 0)
    (for (in k (..< 0 8))
      (+= count (call is-on (call around index k)))
    )
    (return count)
  )
  (fn-do _ connectivity Int
    (param index Index)
    (let total 0)
    (for (in k (..< 0 4))
      (let side (- 1 (call is-on (call around index (* k 2)))))
      (let corner (- 1 (call is-on (call around index (+ (* k 2) 1)))))
      (let next (- 1 (call is-on (call around index (% (+ (* k 2) 2) 8)))))
      (+= total (- side (* side corner next)))
    )
    (return total)
  )
  (fn-expr _ pixel-point Point
    (param index Index)
    (call Point (- (as (% index stride) F64) 0.5) (- (as (/ index stride) F64) 0.5))
  )
  (fn-do _ thin _
    (let changed true)
    (let doomed (call (of List Index)))
    (while changed
      (= changed false)
      (for (in pass (..< 0 2))
        (call (. doomed clear))
        (for (in y (..< 1 (- rows 1)))
          (for (in x (..< 1 (- stride 1)))
            (let index (+ (* y stride) x))
            (if (and (!= ([] skeleton index) 0) (call thins index pass))
              (+= doomed index)
            )
          )
        )
        (for (in index doomed)
          (if (call thins index pass)
            (= ([] skeleton index) 0)
            (= changed true)
          )
        )
      )
    )
  )
  (fn-expr _ thins Bool
    (param index Index)
    (param pass Index)
    (case? (!= crossings 1)
      false
    )
    (case? (or (< fewest 2) (> fewest 3))
      false
    )
    (case? (== pass 0)
      (or (== (- (+ south southwest 1) northwest) 0) (== west 0))
    )
    (default
      (or (== (- (+ north northeast 1) southeast) 0) (== east 0))
    )
    (where
      (lazy north (call is-on (- index stride)))
      (lazy northeast (call is-on (+ (- index stride) 1)))
      (lazy east (call is-on (+ index 1)))
      (lazy southeast (call is-on (+ index stride 1)))
      (lazy south (call is-on (+ index stride)))
      (lazy southwest (call is-on (- (+ index stride) 1)))
      (lazy west (call is-on (- index 1)))
      (lazy northwest (call is-on (- index stride 1)))
      (lazy crossings (+ half-crossings (call centerline-gap south southwest west) west-gap))
      (lazy half-crossings (+ (call centerline-gap north northeast east) (call centerline-gap east southeast south)))
      (lazy west-gap (call centerline-gap west northwest north))
      (lazy first (+ first-half (call centerline-either southeast south) (call centerline-either southwest west)))
      (lazy first-half (+ (call centerline-either northwest north) (call centerline-either northeast east)))
      (lazy second (+ second-half (call centerline-either south southwest) (call centerline-either west northwest)))
      (lazy second-half (+ (call centerline-either north northeast) (call centerline-either east southeast)))
      (lazy fewest (call min first second))
    )
  )
  (fn-do _ clean _
    (for (in y (..< 1 (- rows 1)))
      (for (in x (..< 1 (- stride 1)))
        (let index (+ (* y stride) x))
        (if (and (!= ([] skeleton index) 0) (>= (call neighbors index) 2) (== (call connectivity index) 1))
          (= ([] skeleton index) 0)
        )
      )
    )
  )
  (fn-do _ typical-radius Length
    (let found (call (of List F64)))
    (for (in y (..< 1 (- rows 1)))
      (for (in x (..< 1 (- stride 1)))
        (let index (+ (* y stride) x))
        (if (and (!= ([] skeleton index) 0) (== (call neighbors index) 2))
          (+= found ([] depth index))
        )
      )
    )
    (return-if 1.0 (if (not found)))
    (return (call max (call centerline-median found) 1.0))
  )
  (fn-do _ build-graph _
    (call (. nodes clear))
    (call (. edges clear))
    (let cells (* stride rows))
    (= owner ([] U32 cells))
    (= visited ([] U8 cells))
    (for (in y (..< 1 (- rows 1)))
      (for (in x (..< 1 (- stride 1)))
        (let index (+ (* y stride) x))
        (if (and (!= ([] skeleton index) 0) (== ([] owner index) 0))
          (let count (call neighbors index))
          (if (>= count 3)
            (call add-junction index)
            (else-if (!= count 2)
              (call add-node (list index) false)
            )
          )
        )
      )
    )
    (for (in node-index (..< 0 (. nodes length)))
      (for (in pixel (. ([] nodes node-index) pixels))
        (for (in k (..< 0 8))
          (let next (call around pixel k))
          (if (!= ([] skeleton next) 0)
            (let other (as ([] owner next) Index))
            (if (== other 0)
              (if (== ([] visited next) 0)
                (call walk node-index pixel next)
              )
              (else-if (> other (+ node-index 1))
                (+= edges (call CenterlineEdge (list pixel next) node-index (- other 1)))
              )
            )
          )
        )
      )
    )
    (for (in y (..< 1 (- rows 1)))
      (for (in x (..< 1 (- stride 1)))
        (let index (+ (* y stride) x))
        (if (and (!= ([] skeleton index) 0) (== ([] owner index) 0) (== ([] visited index) 0))
          (call walk-loop index)
        )
      )
    )
  )
  (fn-do _ add-node _
    (param pixels (list Index))
    (param is-junction Bool)
    (let mark (as (+ (. nodes length) 1) U32))
    (let sum (call Point 0 0))
    (let deepest 0.0)
    (for (in pixel pixels)
      (= ([] owner pixel) mark)
      (= sum (+ sum (call pixel-point pixel)))
      (= deepest (call max deepest ([] depth pixel)))
    )
    (+= nodes (call CenterlineNode pixels (/ sum (as (. pixels length) F64)) deepest is-junction))
  )
  (fn-do _ add-junction _
    (param seed Index)
    (let pixels (call (of List Index)))
    (let pending (call (of List Index)))
    (let mark (as (+ (. nodes length) 1) U32))
    (+= pending seed)
    (= ([] owner seed) mark)
    (while pending
      (let index (call (. pending pop)))
      (+= pixels index)
      (for (in k (..< 0 8))
        (let next (call around index k))
        (if (and (!= ([] skeleton next) 0) (== ([] owner next) 0) (>= (call neighbors next) 3))
          (= ([] owner next) mark)
          (+= pending next)
        )
      )
    )
    (call add-node pixels true)
  )
  (fn-do _ following (? Index)
    (param current Index)
    (param previous Index)
    (for (in k (..< 0 8))
      (let next (call around current k))
      (if (and (!= ([] skeleton next) 0) (!= next previous))
        (return next)
      )
    )
    (return null)
  )
  (fn-do _ walk _
    (param node-index Index)
    (param from Index)
    (param first Index)
    (let chain (call (of List Index)))
    (+= chain from)
    (+= chain first)
    (let previous from)
    (let current first)
    (while (== ([] owner current) 0)
      (= ([] visited current) 1)
      (let next (call following current previous))
      (if (or (== next null) (and (== ([] owner next) 0) (!= ([] visited next) 0)))
        (+= edges (call CenterlineEdge chain node-index null))
        (return)
      )
      (+= chain next)
      (= previous current)
      (= current next)
    )
    (+= edges (call CenterlineEdge chain node-index (- (as ([] owner current) Index) 1)))
  )
  (fn-do _ walk-loop _
    (param start Index)
    (let chain (call (of List Index)))
    (+= chain start)
    (= ([] visited start) 1)
    (let previous start)
    (let current (call following start start))
    (while (and (!= current null) (!= current start))
      (let here current)
      (return-if (if (!= ([] visited here) 0)))
      (blank)
      (= ([] visited here) 1)
      (+= chain here)
      (= current (call following here previous))
      (= previous here)
    )
    (+= edges (call CenterlineEdge chain null null))
  )
  (fn-do _ prune Bool
    (let pruned false)
    (for (in edge edges)
      (let start (. edge start))
      (let finish (. edge finish))
      (if (and (!= start null) (!= finish null))
        (let head ([] nodes start))
        (let tail ([] nodes finish))
        (let length (call centerline-chain-length this (. edge chain)))
        (if (== start finish)
          (if (< length 3)
            (for (in index (..< 1 (- (. edge chain length) 1)))
              (= ([] skeleton ([] (. edge chain) index)) 0)
            )
            (= pruned true)
          )
          (else-if (and (!= (. head is-junction) (. tail is-junction)) (< length (* radius centerline-spur-reach)))
            (let junction (if-expr (. head is-junction) start finish))
            (for (in pixel (. edge chain))
              (if (!= (as ([] owner pixel) Index) (+ junction 1))
                (= ([] skeleton pixel) 0)
              )
            )
            (= pruned true)
          )
        )
      )
    )
    (return pruned)
  )
  (fn-do _ mark-dots (list Index)
    (let seen ([] U8 (* stride rows)))
    (let dotted ([] U8 (* stride rows)))
    (let seeds (call (of List Index)))
    (for (in y (..< 1 (- rows 1)))
      (for (in x (..< 1 (- stride 1)))
        (let index (+ (* y stride) x))
        (if (and (!= ([] skeleton index) 0) (== ([] seen index) 0))
          (let members (call skeleton-piece index seen))
          (let deepest ([] members 0))
          (let low (call pixel-point index))
          (let high low)
          (for (in pixel members)
            (let point (call pixel-point pixel))
            (= low (call Point (call min (. low x) (. point x)) (call min (. low y) (. point y))))
            (= high (call Point (call max (. high x) (. point x)) (call max (. high y) (. point y))))
            (if (> ([] depth pixel) ([] depth deepest))
              (= deepest pixel)
            )
          )
          (if (< (call (. low distance) high) (* ([] depth deepest) centerline-dot-extent))
            (+= seeds deepest)
            (for (in pixel members)
              (= ([] dotted pixel) 1)
            )
          )
        )
      )
    )
    (for (in edge edges)
      (if (!= ([] dotted ([] (. edge chain) 0)) 0)
        (= (. edge is-dot) true)
      )
    )
    (return seeds)
  )
  (fn-do _ skeleton-piece (list Index)
    (param seed Index)
    (param seen ([] U8))
    (let members (call (of List Index)))
    (let pending (call (of List Index)))
    (+= pending seed)
    (= ([] seen seed) 1)
    (while pending
      (let index (call (. pending pop)))
      (+= members index)
      (for (in k (..< 0 8))
        (let next (call around index k))
        (if (and (!= ([] skeleton next) 0) (== ([] seen next) 0))
          (= ([] seen next) 1)
          (+= pending next)
        )
      )
    )
    (return members)
  )
  (fn-do _ shape-edges _
    (for (in edge edges)
      (if (not (. edge is-dot))
        (call shape-edge edge)
      )
    )
  )
  (fn-do _ shape-edge _
    (param edge CenterlineEdge)
    (let raw (call (of List Point) (in (call pixel-point each) (. edge chain))))
    (let closed (and (== (. edge start) null) (== (. edge finish) null)))
    (let first Index 0)
    (let last (- (. raw length) 1))
    (let start (. edge start))
    (let finish (. edge finish))
    (if (!= start null)
      (let node ([] nodes start))
      (if (. node is-junction)
        (let reach (* (call max (. node depth) radius) centerline-cut-reach))
        (while (and (< first last) (< (call (. ([] raw first) distance) (. node center)) reach))
          (+= first 1)
        )
        (else
          (while (and (< first last) (< ([] depth ([] (. edge chain) first)) (* radius centerline-tip-depth)))
            (+= first 1)
          )
        )
      )
    )
    (if (!= finish null)
      (let node ([] nodes finish))
      (if (. node is-junction)
        (let reach (* (call max (. node depth) radius) centerline-cut-reach))
        (while (and (> last first) (< (call (. ([] raw last) distance) (. node center)) reach))
          (-= last 1)
        )
        (else
          (while (and (> last first) (< ([] depth ([] (. edge chain) last)) (* radius centerline-tip-depth)))
            (-= last 1)
          )
        )
      )
    )
    (for (in index (..< first (+ last 1)))
      (+= (. edge points) (call refine raw index closed))
    )
  )
  (fn-do _ refine Point
    (param raw (list Point))
    (param index Index)
    (param closed Bool)
    (let count (. raw length))
    (let point ([] raw index))
    (let back ([] raw (call polyline-index index -3 count closed)))
    (let ahead ([] raw (call polyline-index index 3 count closed)))
    (let along (- ahead back))
    (let span (. along length))
    (return-if point (if (< span 0.5)))
    (return-if point (if (> (call turn-angle (- point back) (- ahead point)) centerline-bend-angle)))
    (blank)
    (let normal (call Point (/ (- (. along y)) span) (/ (. along x) span)))
    (let step 0.25)
    (let reach (as (/ (* radius 2) step) Int))
    (let center (call coverage-at point))
    (return-if point (if (< center centerline-ink-floor)))
    (blank)
    (let total center)
    (let moment 0.0)
    (let ahead-open true)
    (for (in offset (..< 1 (+ reach 1)))
      (let along-normal (* (as offset F64) step))
      (let value (call coverage-at (+ point (* normal along-normal))))
      (if (< value centerline-ink-floor)
        (= ahead-open false)
        (break)
      )
      (+= total value)
      (+= moment (* value along-normal))
    )
    (let back-open true)
    (for (in offset (..< 1 (+ reach 1)))
      (let along-normal (* (- (as offset F64)) step))
      (let value (call coverage-at (+ point (* normal along-normal))))
      (if (< value centerline-ink-floor)
        (= back-open false)
        (break)
      )
      (+= total value)
      (+= moment (* value along-normal))
    )
    (return-if point (if (or ahead-open back-open)))
    (blank)
    (+= widths (* total step))
    (let shift (call clamp (/ moment total) (- centerline-shift-limit) centerline-shift-limit))
    (return (+ point (* normal shift)))
  )
  (fn-expr _ coverage-at F64
    (param point Point)
    (case? (or (< u 0) (< v 0) (>= u (as (- stride 1) F64)) (>= v (as (- rows 1) F64)))
      0.0
    )
    (default
      (+ (* top (- 1 fy)) (* bottom fy))
    )
    (where
      (lazy u (+ (. point x) 0.5))
      (lazy v (+ (. point y) 0.5))
      (lazy column (call floor u))
      (lazy row (call floor v))
      (lazy fx (- u column))
      (lazy fy (- v row))
      (lazy index (+ (* (as row Index) stride) (as column Index)))
      (lazy top (+ (* ([] cover index) (- 1 fx)) (* ([] cover (+ index 1)) fx)))
      (lazy bottom (+ (* ([] cover (+ index stride)) (- 1 fx)) (* ([] cover (+ index stride 1)) fx)))
    )
  )
  (fn-do _ connect-junctions _
    (for (in node-index (..< 0 (. nodes length)))
      (let node ([] nodes node-index))
      (if (. node is-junction)
        (call connect-junction node-index node)
      )
    )
  )
  (fn-do _ connect-junction _
    (param node-index Index)
    (param node CenterlineNode)
    (let ends (call (of List CenterlineEnd)))
    (for (in edge-index (..< 0 (. edges length)))
      (let edge ([] edges edge-index))
      (if (and (not (. edge is-dot)) (. edge points))
        (if (== (. edge start) node-index)
          (+= ends (call edge-end edge-index true node))
        )
        (if (== (. edge finish) node-index)
          (+= ends (call edge-end edge-index false node))
        )
      )
    )
    (return-if (if (not ends)))
    (blank)
    (= (. node cross) (call crossing node ends))
    (let paired ([] U8 (. ends length)))
    (while true
      (let best -2.0)
      (let best-a Index 0)
      (let best-b Index 0)
      (for (in a (..< 0 (. ends length)))
        (for (in b (..< (+ a 1) (. ends length)))
          (if (and (== ([] paired a) 0) (== ([] paired b) 0))
            (let score (- (call (. ([] ends a) direction dot) (. ([] ends b) direction))))
            (if (> score best)
              (= best score)
              (= best-a a)
              (= best-b b)
            )
          )
        )
      )
      (if (and (< best centerline-pair-score) (not (and (== (. ends length) 2) (> best -2.0))))
        (break)
      )
      (= ([] paired best-a) 1)
      (= ([] paired best-b) 1)
      (let is-corner (< best centerline-straight-score))
      (call link ([] ends best-a) ([] ends best-b) (. node cross) is-corner)
      (call link ([] ends best-b) ([] ends best-a) (. node cross) is-corner)
    )
    (for (in index (..< 0 (. ends length)))
      (if (== ([] paired index) 0)
        (let end ([] ends index))
        (let points (. ([] edges (. end edge)) points))
        (if (. end at-start)
          (call (. points insert) (. node cross) 0)
          (else
            (+= points (. node cross))
          )
        )
      )
    )
  )
  (fn-do _ link _
    (param from CenterlineEnd)
    (param to CenterlineEnd)
    (param bridge Point)
    (param is-corner Bool)
    (let edge ([] edges (. from edge)))
    (let joined (call CenterlineLink (. to edge) (. to at-start) bridge is-corner))
    (if (. from at-start)
      (= (. edge start-link) joined)
      (else
        (= (. edge finish-link) joined)
      )
    )
  )
  (fn-expr _ edge-end CenterlineEnd
    (param edge-index Index)
    (param at-start Bool)
    (param node CenterlineNode)
    (case? (> length 0.5)
      (call CenterlineEnd edge-index at-start tip (/ outward length))
    )
    (default
      (call CenterlineEnd edge-index at-start tip (if-expr (> gap 0) (/ toward gap) (call Point 1 0)))
    )
    (where
      (lazy points (. ([] edges edge-index) points))
      (lazy count (. points length))
      (lazy reach (call min (- count 1) (call max 2 (as (call round (* radius 1.5)) Index))))
      (lazy tip (if-expr at-start ([] points 0) ([] points (- count 1))))
      (lazy inner (if-expr at-start ([] points reach) ([] points (- count 1 reach))))
      (lazy outward (- tip inner))
      (lazy length (. outward length))
      (lazy toward (- (. node center) tip))
      (lazy gap (. toward length))
    )
  )
  (fn-do _ crossing Point
    (param node CenterlineNode)
    (param ends (list CenterlineEnd))
    (let xx 0.0)
    (let xy 0.0)
    (let yy 0.0)
    (let bx 0.0)
    (let by 0.0)
    (for (in end ends)
      (let d (. end direction))
      (let mxx (- 1 (* (. d x) (. d x))))
      (let mxy (* (- (. d x)) (. d y)))
      (let myy (- 1 (* (. d y) (. d y))))
      (+= xx mxx)
      (+= xy mxy)
      (+= yy myy)
      (+= bx (+ (* mxx (. end tip x)) (* mxy (. end tip y))))
      (+= by (+ (* mxy (. end tip x)) (* myy (. end tip y))))
    )
    (let det (- (* xx yy) (* xy xy)))
    (return-if (. node center) (if (< (call abs det) 0.05)))
    (blank)
    (let found (call Point (/ (- (* yy bx) (* xy by)) det) (/ (- (* xx by) (* xy bx)) det)))
    (return-if (. node center) (if (> (call (. found distance) (. node center)) (* radius 2))))
    (return found)
  )
  (fn-do _ chains (list CenterlineChain)
    (let found (call (of List CenterlineChain)))
    (for (in index (..< 0 (. edges length)))
      (let edge ([] edges index))
      (if (and (not (. edge is-dot)) (. edge points) (not (. edge is-used)) (or (!= (. edge start) null) (!= (. edge finish) null)))
        (if (or (== (. edge start-link) null) (== (. edge finish-link) null))
          (+= found (call follow index (== (. edge start-link) null)))
        )
      )
    )
    (for (in index (..< 0 (. edges length)))
      (let edge ([] edges index))
      (if (and (not (. edge is-dot)) (. edge points) (not (. edge is-used)))
        (+= found (call follow index true))
      )
    )
    (return found)
  )
  (fn-do _ follow CenterlineChain
    (param first Index)
    (param from-start Bool)
    (let points (call (of List Point)))
    (let corners (call (of List Index)))
    (let current first)
    (let forward from-start)
    (let closed (and (== (. ([] edges first) start) null) (== (. ([] edges first) finish) null)))
    (while true
      (let edge ([] edges current))
      (= (. edge is-used) true)
      (let count (. edge points length))
      (for (in offset (..< 0 count))
        (let point ([] (. edge points) (if-expr forward offset (- count 1 offset))))
        (if (or (not points) (> (call (. ([] points (- (. points length) 1)) distance) point) 0.01))
          (+= points point)
        )
      )
      (let exit (if-expr forward (. edge finish-link) (. edge start-link)))
      (if (== exit null)
        (break)
      )
      (let step exit)
      (if (. step is-corner)
        (+= corners (. points length))
      )
      (+= points (. step bridge))
      (if (. ([] edges (. step edge)) is-used)
        (= closed true)
        (break)
      )
      (= current (. step edge))
      (= forward (. step at-start))
    )
    (return (call CenterlineChain points corners closed))
  )
  (fn-expr _ fit-chain TracedStroke
    (param chain CenterlineChain)
    (case? (== (. chain points length) 1)
      (call centerline-dot ([] (. chain points) 0))
    )
    (default
      (call TracedStroke (call (. fitter fit) (. chain points) (. chain corners) (. chain is-closed)) false)
    )
    (where
      (lazy fitter (call CurveFitter tolerance (call max 2 (as (call round radius) Index))))
    )
  )
  (fn-do _ dot-stroke TracedStroke
    (param seed Index)
    (param stroke-width Length)
    (let seen ([] U8 (* stride rows)))
    (let pending (call (of List Index)))
    (let origin (call pixel-point seed))
    (let limit (* radius centerline-dot-span))
    (let area 0.0)
    (let sum (call Point 0 0))
    (+= pending seed)
    (= ([] seen seed) 1)
    (while pending
      (let index (call (. pending pop)))
      (let value ([] cover index))
      (+= area value)
      (= sum (+ sum (* (call pixel-point index) value)))
      (if (>= value 0.5)
        (for (in k (..< 0 8))
          (let next (call around index k))
          (if (and (== ([] seen next) 0) (> ([] cover next) centerline-dot-floor) near-origin)
            (= ([] seen next) 1)
            (+= pending next)
          )
          (lazy near-origin (< (call (. (call pixel-point next) distance) origin) limit))
        )
      )
    )
    (return-if (call centerline-dot origin) (if (<= area 0)))
    (blank)
    (let center (/ sum area))
    (let inner (- (call sqrt (/ area π)) (/ stroke-width 2)))
    (return-if (call centerline-dot center) (if (< inner (* stroke-width 0.25))))
    (return (call centerline-circle center inner))
  )
)

(fn-expr _ centerline-either Int
  (param a Int)
  (param b Int)
  (if-expr (> (+ a b) 0) 1 0)
)

(fn-expr _ centerline-gap Int
  (param side Int)
  (param corner Int)
  (param next Int)
  (if-expr (and (== side 0) (> (+ corner next) 0)) 1 0)
)

(fn-expr _ centerline-median F64
  (param values (list F64))
  ([] ordered (/ (. ordered length) 2))
  (where
    (lazy ordered (call sort values))
  )
)

(fn-do _ centerline-chain-length F64
  (param tracer CenterlineTracer)
  (param chain (list Index))
  (let total 0.0)
  (for (in index (..< 1 (. chain length)))
    (+= total (call (. (call (. tracer pixel-point) ([] chain index)) distance) (call (. tracer pixel-point) ([] chain (- index 1)))))
  )
  (return total)
)

(fn-do _ centerline-dot TracedStroke
  (param center Point)
  (let ops (call (of List PathOp)))
  (+= ops (call M (. center x) (. center y)))
  (+= ops (call L (+ (. center x) 0.1) (. center y)))
  (return (call TracedStroke ops false))
)

(fn-do _ centerline-circle TracedStroke
  (param center Point)
  (param radius Length)
  (let handle (* radius centerline-circle-handle))
  (let x (. center x))
  (let y (. center y))
  (let ops (call (of List PathOp)))
  (+= ops (call M (+ x radius) y))
  (+= ops (call C (+ x radius) (+ y handle) (+ x handle) (+ y radius) x (+ y radius)))
  (+= ops (call C (- x handle) (+ y radius) (- x radius) (+ y handle) (- x radius) y))
  (+= ops (call C (- x radius) (- y handle) (- x handle) (- y radius) x (- y radius)))
  (+= ops (call C (+ x handle) (- y radius) (+ x radius) (- y handle) (+ x radius) y))
  (+= ops (call Z))
  (return (call TracedStroke ops true))
)

(fn-do _ centerline-distances ([] F64)
  (param solid ([] U8))
  (param stride Size)
  (param rows Size)
  (let cells (* stride rows))
  (let far (as (* (+ stride rows) (+ stride rows)) F64))
  (let field ([] F64 cells))
  (for (in index (..< 0 cells))
    (= ([] field index) (if-expr (!= ([] solid index) 0) far 0.0))
  )
  (let longest (call max stride rows))
  (let line ([] F64 longest))
  (let out ([] F64 longest))
  (let hull ([] U32 longest))
  (let bounds ([] F64 (+ longest 1)))
  (for (in x (..< 0 stride))
    (for (in y (..< 0 rows))
      (= ([] line y) ([] field (+ (* y stride) x)))
    )
    (call centerline-envelope line out hull bounds rows)
    (for (in y (..< 0 rows))
      (= ([] field (+ (* y stride) x)) ([] out y))
    )
  )
  (for (in y (..< 0 rows))
    (for (in x (..< 0 stride))
      (= ([] line x) ([] field (+ (* y stride) x)))
    )
    (call centerline-envelope line out hull bounds stride)
    (for (in x (..< 0 stride))
      (= ([] field (+ (* y stride) x)) (call sqrt ([] out x)))
    )
  )
  (return field)
)

(fn-do _ centerline-envelope _
  (param line ([] F64))
  (param out ([] F64))
  (param hull ([] U32))
  (param bounds ([] F64))
  (param count Size)
  (let far 100000000000000000000.0)
  (let k Index 0)
  (= ([] hull 0) 0)
  (= ([] bounds 0) (- far))
  (= ([] bounds 1) far)
  (for (in q (..< 1 count))
    (let s (call centerline-meet line q ([] hull k)))
    (while (<= s ([] bounds k))
      (-= k 1)
      (= s (call centerline-meet line q ([] hull k)))
    )
    (+= k 1)
    (= ([] hull k) (as q U32))
    (= ([] bounds k) s)
    (= ([] bounds (+ k 1)) far)
  )
  (= k 0)
  (for (in q (..< 0 count))
    (while (< ([] bounds (+ k 1)) (as q F64))
      (+= k 1)
    )
    (let v (as ([] hull k) Index))
    (let gap (- (as q F64) (as v F64)))
    (= ([] out q) (+ (* gap gap) ([] line v)))
  )
)

(fn-expr _ centerline-meet F64
  (param line ([] F64))
  (param q Index)
  (param v Index)
  (/ (- (+ ([] line q) (* a a)) (+ ([] line v) (* b b))) (- (* 2 a) (* 2 b)))
  (where
    (lazy a (as q F64))
    (lazy b (as v F64))
  )
)

(fn-do _ centerline-map-ops (list PathOp)
  (param ops (list PathOp))
  (param origin Point)
  (param scale F64)
  (let mapped (call (of List PathOp)))
  (for (in op ops)
    (if (is op PathMoveTo)
      (let move (as op PathMoveTo))
      (+= mapped (call M (* (- (. move x) (. origin x)) scale) (* (- (. move y) (. origin y)) scale)))
      (else-if (is op PathLineTo)
        (let line (as op PathLineTo))
        (+= mapped (call L (* (- (. line x) (. origin x)) scale) (* (- (. line y) (. origin y)) scale)))
      )
      (else-if (is op PathCubicTo)
        (let cubic (as op PathCubicTo))
        (+= mapped
          (call C
            (block
              (arg (* (- (. cubic c1x) (. origin x)) scale))
              (arg (* (- (. cubic c1y) (. origin y)) scale))
              (arg (* (- (. cubic c2x) (. origin x)) scale))
              (arg (* (- (. cubic c2y) (. origin y)) scale))
              (arg (* (- (. cubic x) (. origin x)) scale))
              (arg (* (- (. cubic y) (. origin y)) scale))
            )
          )
        )
      )
      (else
        (+= mapped op)
      )
    )
  )
  (return mapped)
)
