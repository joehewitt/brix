━━━━━━━━━━━━━━━━━━━━
_ CenterlineTracer

+ width Size
+ height Size
+ tolerance Length
+ stride Size
+ rows Size
+ cover F64[]
+ depth F64[]
+ skeleton U8[]
+ owner U32[]
+ visited U8[]
+ radius Length
+ widths [F64]
+ nodes [CenterlineNode]
+ edges [CenterlineEdge]

────────────────────
+ This
    - ink Byte[]
    - width
    - height
    - tolerance

stride = width + 2
rows = height + 2
. cells = stride * rows
cover = F64[cells]
skeleton = U8[cells]
owner = U32[cells]
visited = U8[cells]
for y in 0 .. < height
    for x in 0 .. < width
        . value = (ink[y * width + x] as F64) / 255
        . index = (y + 1) * stride + x + 1
        cover[index] = value
        if value >= 0.5
            skeleton[index] = 1
depth = centerline-distances(skeleton, stride, rows)

────────────────────
+ do trace CenterlineTrace

thin()
clean()
radius = typical-radius()
build-graph()
for pass in 0 .. < centerline-prune-rounds
    if !prune()
        break
    clean()
    build-graph()
. dots = mark-dots()
shape-edges()
. stroke-width = if widths then centerline-median(widths) else radius * 2
connect-junctions()
. strokes = List'TracedStroke()
for chain in chains()
    strokes += fit-chain(chain)
for dot in dots
    strokes += dot-stroke(dot, stroke-width)
= CenterlineTrace(strokes, stroke-width)

────────────────────
_ around Index
    - index Index
    - k Index

|? k == 0
    index + 1
|? k == 1
    index + 1 - stride
|? k == 2
    index - stride
|? k == 3
    index - stride - 1
|? k == 4
    index - 1
|? k == 5
    index + stride - 1
|? k == 6
    index + stride
??
    index + stride + 1

────────────────────
_ is-on Int
    - index Index

if skeleton[index] != 0 then 1 else 0

────────────────────
_ do neighbors Int
    - index Index

. count = 0
for k in 0 .. < 8
    count += is-on(around(index, k))
= count

────────────────────
_ do connectivity Int
    - index Index

. total = 0
for k in 0 .. < 4
    . side = 1 - is-on(around(index, k * 2))
    . corner = 1 - is-on(around(index, k * 2 + 1))
    . next = 1 - is-on(around(index, (k * 2 + 2) % 8))
    total += side - side * corner * next
= total

────────────────────
_ pixel-point Point
    - index Index

Point(((index % stride) as F64) - 0.5, ((index / stride) as F64) - 0.5)

────────────────────
_ do thin

. changed = true
. doomed = List'Index()
while changed
    changed = false
    for pass in 0 .. < 2
        doomed.clear()
        for y in 1 .. < rows - 1
            for x in 1 .. < stride - 1
                . index = y * stride + x
                if skeleton[index] != 0 && thins(index, pass)
                    doomed += index
        for index in doomed
            if thins(index, pass)
                skeleton[index] = 0
                changed = true

────────────────────
_ thins Bool
    - index Index
    - pass Index

|? crossings != 1
    false
|? fewest < 2 || fewest > 3
    false
|? pass == 0
    (south + southwest + 1 - northwest == 0) || west == 0
??
    (north + northeast + 1 - southeast == 0) || east == 0

.. north = is-on(index - stride)
.. northeast = is-on(index - stride + 1)
.. east = is-on(index + 1)
.. southeast = is-on(index + stride + 1)
.. south = is-on(index + stride)
.. southwest = is-on(index + stride - 1)
.. west = is-on(index - 1)
.. northwest = is-on(index - stride - 1)
.. crossings = half-crossings + centerline-gap(south, southwest, west) + west-gap
.. half-crossings = centerline-gap(north, northeast, east) + centerline-gap(east, southeast, south)
.. west-gap = centerline-gap(west, northwest, north)
.. first = first-half + centerline-either(southeast, south) + centerline-either(southwest, west)
.. first-half = centerline-either(northwest, north) + centerline-either(northeast, east)
.. second = second-half + centerline-either(south, southwest) + centerline-either(west, northwest)
.. second-half = centerline-either(north, northeast) + centerline-either(east, southeast)
.. fewest = min(first, second)

────────────────────
_ do clean

for y in 1 .. < rows - 1
    for x in 1 .. < stride - 1
        . index = y * stride + x
        if skeleton[index] != 0 && neighbors(index) >= 2 && connectivity(index) == 1
            skeleton[index] = 0

────────────────────
_ do typical-radius Length

. found = List'F64()
for y in 1 .. < rows - 1
    for x in 1 .. < stride - 1
        . index = y * stride + x
        if skeleton[index] != 0 && neighbors(index) == 2
            found += depth[index]
=? 1.0 if !found
= max(centerline-median(found), 1.0)

────────────────────
_ do build-graph

nodes.clear()
edges.clear()
. cells = stride * rows
owner = U32[cells]
visited = U8[cells]
for y in 1 .. < rows - 1
    for x in 1 .. < stride - 1
        . index = y * stride + x
        if skeleton[index] != 0 && owner[index] == 0
            . count = neighbors(index)
            if count >= 3
                add-junction(index)
            else if count != 2
                add-node([index], false)
for node-index in 0 .. < nodes.length
    for pixel in nodes[node-index].pixels
        for k in 0 .. < 8
            . next = around(pixel, k)
            if skeleton[next] != 0
                . other = owner[next] as Index
                if other == 0
                    if visited[next] == 0
                        walk(node-index, pixel, next)
                else if other > node-index + 1
                    edges += CenterlineEdge([pixel, next], node-index, other - 1)
for y in 1 .. < rows - 1
    for x in 1 .. < stride - 1
        . index = y * stride + x
        if skeleton[index] != 0 && owner[index] == 0 && visited[index] == 0
            walk-loop(index)

────────────────────
_ do add-node
    - pixels [Index]
    - is-junction Bool

. mark = (nodes.length + 1) as U32
. sum = Point(0, 0)
. deepest = 0.0
for pixel in pixels
    owner[pixel] = mark
    sum = sum + pixel-point(pixel)
    deepest = max(deepest, depth[pixel])
nodes += CenterlineNode(pixels, sum / (pixels.length as F64), deepest, is-junction)

────────────────────
_ do add-junction
    - seed Index

. pixels = List'Index()
. pending = List'Index()
. mark = (nodes.length + 1) as U32
pending += seed
owner[seed] = mark
while pending
    . index = pending.pop()
    pixels += index
    for k in 0 .. < 8
        . next = around(index, k)
        if skeleton[next] != 0 && owner[next] == 0 && neighbors(next) >= 3
            owner[next] = mark
            pending += next
add-node(pixels, true)

────────────────────
_ do following Index?
    - current Index
    - previous Index

for k in 0 .. < 8
    . next = around(current, k)
    if skeleton[next] != 0 && next != previous
        = next
= null

────────────────────
_ do walk
    - node-index Index
    - from Index
    - first Index

. chain = List'Index()
chain += from
chain += first
. previous = from
. current = first
while owner[current] == 0
    visited[current] = 1
    . next = following(current, previous)
    if next == null || (owner[next] == 0 && visited[next] != 0)
        edges += CenterlineEdge(chain, node-index, null)
        =
    chain += next
    previous = current
    current = next
edges += CenterlineEdge(chain, node-index, (owner[current] as Index) - 1)

────────────────────
_ do walk-loop
    - start Index

. chain = List'Index()
chain += start
visited[start] = 1
. previous = start
. current = following(start, start)
while current != null && current != start
    . here = current
    =? if visited[here] != 0
    visited[here] = 1
    chain += here
    current = following(here, previous)
    previous = here
edges += CenterlineEdge(chain, null, null)

────────────────────
_ do prune Bool

. pruned = false
for edge in edges
    . start = edge.start
    . finish = edge.finish
    if start != null && finish != null
        . head = nodes[start]
        . tail = nodes[finish]
        . length = centerline-chain-length(this, edge.chain)
        if start == finish
            if length < 3
                for index in 1 .. < edge.chain.length - 1
                    skeleton[edge.chain[index]] = 0
                pruned = true
        else if head.is-junction != tail.is-junction && length < radius * centerline-spur-reach
            . junction = if head.is-junction then start else finish
            for pixel in edge.chain
                if (owner[pixel] as Index) != junction + 1
                    skeleton[pixel] = 0
            pruned = true
= pruned

────────────────────
_ do mark-dots [Index]

. seen = U8[stride * rows]
. dotted = U8[stride * rows]
. seeds = List'Index()
for y in 1 .. < rows - 1
    for x in 1 .. < stride - 1
        . index = y * stride + x
        if skeleton[index] != 0 && seen[index] == 0
            . members = skeleton-piece(index, seen)
            . deepest = members[0]
            . low = pixel-point(index)
            . high = low
            for pixel in members
                . point = pixel-point(pixel)
                low = Point(min(low.x, point.x), min(low.y, point.y))
                high = Point(max(high.x, point.x), max(high.y, point.y))
                if depth[pixel] > depth[deepest]
                    deepest = pixel
            if low.distance(high) < depth[deepest] * centerline-dot-extent
                seeds += deepest
                for pixel in members
                    dotted[pixel] = 1
for edge in edges
    if dotted[edge.chain[0]] != 0
        edge.is-dot = true
= seeds

────────────────────
_ do skeleton-piece [Index]
    - seed Index
    - seen U8[]

. members = List'Index()
. pending = List'Index()
pending += seed
seen[seed] = 1
while pending
    . index = pending.pop()
    members += index
    for k in 0 .. < 8
        . next = around(index, k)
        if skeleton[next] != 0 && seen[next] == 0
            seen[next] = 1
            pending += next
= members

────────────────────
_ do shape-edges

for edge in edges
    if !edge.is-dot
        shape-edge(edge)

────────────────────
_ do shape-edge
    - edge CenterlineEdge

. raw = List'Point(pixel-point(each) in edge.chain)
. closed = edge.start == null && edge.finish == null
. first Index = 0
. last = raw.length - 1
. start = edge.start
. finish = edge.finish
if start != null
    . node = nodes[start]
    if node.is-junction
        . reach = max(node.depth, radius) * centerline-cut-reach
        while first < last && raw[first].distance(node.center) < reach
            first += 1
    else
        while first < last && depth[edge.chain[first]] < radius * centerline-tip-depth
            first += 1
if finish != null
    . node = nodes[finish]
    if node.is-junction
        . reach = max(node.depth, radius) * centerline-cut-reach
        while last > first && raw[last].distance(node.center) < reach
            last -= 1
    else
        while last > first && depth[edge.chain[last]] < radius * centerline-tip-depth
            last -= 1
for index in first .. < last + 1
    edge.points += refine(raw, index, closed)

────────────────────
_ do refine Point
    - raw [Point]
    - index Index
    - closed Bool

. count = raw.length
. point = raw[index]
. back = raw[polyline-index(index, -3, count, closed)]
. ahead = raw[polyline-index(index, 3, count, closed)]
. along = ahead - back
. span = along.length
=? point if span < 0.5
=? point if turn-angle(point - back, ahead - point) > centerline-bend-angle
. normal = Point(-along.y / span, along.x / span)
. step = 0.25
. reach = ((radius * 2) / step) as Int
. center = coverage-at(point)
=? point if center < centerline-ink-floor
. total = center
. moment = 0.0
. ahead-open = true
for offset in 1 .. < reach + 1
    . along-normal = (offset as F64) * step
    . value = coverage-at(point + normal * along-normal)
    if value < centerline-ink-floor
        ahead-open = false
        break
    total += value
    moment += value * along-normal
. back-open = true
for offset in 1 .. < reach + 1
    . along-normal = -(offset as F64) * step
    . value = coverage-at(point + normal * along-normal)
    if value < centerline-ink-floor
        back-open = false
        break
    total += value
    moment += value * along-normal
=? point if ahead-open || back-open
widths += total * step
. shift = clamp(moment / total, -centerline-shift-limit, centerline-shift-limit)
= point + normal * shift

────────────────────
_ coverage-at F64
    - point Point

|? u < 0 || v < 0 || u >= ((stride - 1) as F64) || v >= ((rows - 1) as F64)
    0.0
??
    top * (1 - fy) + bottom * fy

.. u = point.x + 0.5
.. v = point.y + 0.5
.. column = floor(u)
.. row = floor(v)
.. fx = u - column
.. fy = v - row
.. index = (row as Index) * stride + (column as Index)
.. top = cover[index] * (1 - fx) + cover[index + 1] * fx
.. bottom = cover[index + stride] * (1 - fx) + cover[index + stride + 1] * fx

────────────────────
_ do connect-junctions

for node-index in 0 .. < nodes.length
    . node = nodes[node-index]
    if node.is-junction
        connect-junction(node-index, node)

────────────────────
_ do connect-junction
    - node-index Index
    - node CenterlineNode

. ends = List'CenterlineEnd()
for edge-index in 0 .. < edges.length
    . edge = edges[edge-index]
    if !edge.is-dot && edge.points
        if edge.start == node-index
            ends += edge-end(edge-index, true, node)
        if edge.finish == node-index
            ends += edge-end(edge-index, false, node)
=? if !ends
node.cross = crossing(node, ends)
. paired = U8[ends.length]
while true
    . best = -2.0
    . best-a Index = 0
    . best-b Index = 0
    for a in 0 .. < ends.length
        for b in a + 1 .. < ends.length
            if paired[a] == 0 && paired[b] == 0
                . score = -ends[a].direction.dot(ends[b].direction)
                if score > best
                    best = score
                    best-a = a
                    best-b = b
    if best < centerline-pair-score && !(ends.length == 2 && best > -2.0)
        break
    paired[best-a] = 1
    paired[best-b] = 1
    . is-corner = best < centerline-straight-score
    link(ends[best-a], ends[best-b], node.cross, is-corner)
    link(ends[best-b], ends[best-a], node.cross, is-corner)
for index in 0 .. < ends.length
    if paired[index] == 0
        . end = ends[index]
        . points = edges[end.edge].points
        if end.at-start
            points.insert(node.cross, 0)
        else
            points += node.cross

────────────────────
_ do link
    - from CenterlineEnd
    - to CenterlineEnd
    - bridge Point
    - is-corner Bool

. edge = edges[from.edge]
. joined = CenterlineLink(to.edge, to.at-start, bridge, is-corner)
if from.at-start
    edge.start-link = joined
else
    edge.finish-link = joined

────────────────────
_ edge-end CenterlineEnd
    - edge-index Index
    - at-start Bool
    - node CenterlineNode

|? length > 0.5
    CenterlineEnd(edge-index, at-start, tip, outward / length)
??
    CenterlineEnd(edge-index, at-start, tip, if gap > 0 then toward / gap else Point(1, 0))

.. points = edges[edge-index].points
.. count = points.length
.. reach = min(count - 1, max(2, round(radius * 1.5) as Index))
.. tip = if at-start then points[0] else points[count - 1]
.. inner = if at-start then points[reach] else points[count - 1 - reach]
.. outward = tip - inner
.. length = outward.length
.. toward = node.center - tip
.. gap = toward.length

────────────────────
_ do crossing Point
    - node CenterlineNode
    - ends [CenterlineEnd]

. xx = 0.0
. xy = 0.0
. yy = 0.0
. bx = 0.0
. by = 0.0
for end in ends
    . d = end.direction
    . mxx = 1 - d.x * d.x
    . mxy = -d.x * d.y
    . myy = 1 - d.y * d.y
    xx += mxx
    xy += mxy
    yy += myy
    bx += mxx * end.tip.x + mxy * end.tip.y
    by += mxy * end.tip.x + myy * end.tip.y
. det = xx * yy - xy * xy
=? node.center if abs(det) < 0.05
. found = Point((yy * bx - xy * by) / det, (xx * by - xy * bx) / det)
=? node.center if found.distance(node.center) > radius * 2
= found

────────────────────
_ do chains [CenterlineChain]

. found = List'CenterlineChain()
for index in 0 .. < edges.length
    . edge = edges[index]
    if !edge.is-dot && edge.points && !edge.is-used && (edge.start != null || edge.finish != null)
        if edge.start-link == null || edge.finish-link == null
            found += follow(index, edge.start-link == null)
for index in 0 .. < edges.length
    . edge = edges[index]
    if !edge.is-dot && edge.points && !edge.is-used
        found += follow(index, true)
= found

────────────────────
_ do follow CenterlineChain
    - first Index
    - from-start Bool

. points = List'Point()
. corners = List'Index()
. current = first
. forward = from-start
. closed = edges[first].start == null && edges[first].finish == null
while true
    . edge = edges[current]
    edge.is-used = true
    . count = edge.points.length
    for offset in 0 .. < count
        . point = edge.points[if forward then offset else count - 1 - offset]
        if !points || points[points.length - 1].distance(point) > 0.01
            points += point
    . exit = if forward then edge.finish-link else edge.start-link
    if exit == null
        break
    . step = exit
    if step.is-corner
        corners += points.length
    points += step.bridge
    if edges[step.edge].is-used
        closed = true
        break
    current = step.edge
    forward = step.at-start
= CenterlineChain(points, corners, closed)

────────────────────
_ fit-chain TracedStroke
    - chain CenterlineChain

|? chain.points.length == 1
    centerline-dot(chain.points[0])
??
    TracedStroke(fitter.fit(chain.points, chain.corners, chain.is-closed), false)

.. fitter = CurveFitter(tolerance, max(2, round(radius) as Index))

────────────────────
_ do dot-stroke TracedStroke
    - seed Index
    - stroke-width Length

. seen = U8[stride * rows]
. pending = List'Index()
. origin = pixel-point(seed)
. limit = radius * centerline-dot-span
. area = 0.0
. sum = Point(0, 0)
pending += seed
seen[seed] = 1
while pending
    . index = pending.pop()
    . value = cover[index]
    area += value
    sum = sum + pixel-point(index) * value
    if value >= 0.5
        for k in 0 .. < 8
            . next = around(index, k)
            if seen[next] == 0 && cover[next] > centerline-dot-floor && near-origin
                seen[next] = 1
                pending += next
            .. near-origin = pixel-point(next).distance(origin) < limit
=? centerline-dot(origin) if area <= 0
. center = sum / area
. inner = sqrt(area / π) - stroke-width / 2
=? centerline-dot(center) if inner < stroke-width * 0.25
= centerline-circle(center, inner)

━━━━━━━━━━━━━━━━━━━━
_ centerline-either Int
    - a Int
    - b Int

if a + b > 0 then 1 else 0

━━━━━━━━━━━━━━━━━━━━
_ centerline-gap Int
    - side Int
    - corner Int
    - next Int

if side == 0 && corner + next > 0 then 1 else 0

━━━━━━━━━━━━━━━━━━━━
_ centerline-median F64
    - values [F64]

ordered[ordered.length / 2]

.. ordered = sort(values)

━━━━━━━━━━━━━━━━━━━━
_ do centerline-chain-length F64
    - tracer CenterlineTracer
    - chain [Index]

. total = 0.0
for index in 1 .. < chain.length
    total += tracer.pixel-point(chain[index]).distance(tracer.pixel-point(chain[index - 1]))
= total

━━━━━━━━━━━━━━━━━━━━
_ do centerline-dot TracedStroke
    - center Point

. ops = List'PathOp()
ops += M(center.x, center.y)
ops += L(center.x + 0.1, center.y)
= TracedStroke(ops, false)

━━━━━━━━━━━━━━━━━━━━
_ do centerline-circle TracedStroke
    - center Point
    - radius Length

. handle = radius * centerline-circle-handle
. x = center.x
. y = center.y
. ops = List'PathOp()
ops += M(x + radius, y)
ops += C(x + radius, y + handle, x + handle, y + radius, x, y + radius)
ops += C(x - handle, y + radius, x - radius, y + handle, x - radius, y)
ops += C(x - radius, y - handle, x - handle, y - radius, x, y - radius)
ops += C(x + handle, y - radius, x + radius, y - handle, x + radius, y)
ops += Z()
= TracedStroke(ops, true)

━━━━━━━━━━━━━━━━━━━━
_ do centerline-distances F64[]
    - solid U8[]
    - stride Size
    - rows Size

. cells = stride * rows
. far = ((stride + rows) * (stride + rows)) as F64
. field = F64[cells]
for index in 0 .. < cells
    field[index] = if solid[index] != 0 then far else 0.0
. longest = max(stride, rows)
. line = F64[longest]
. out = F64[longest]
. hull = U32[longest]
. bounds = F64[longest + 1]
for x in 0 .. < stride
    for y in 0 .. < rows
        line[y] = field[y * stride + x]
    centerline-envelope(line, out, hull, bounds, rows)
    for y in 0 .. < rows
        field[y * stride + x] = out[y]
for y in 0 .. < rows
    for x in 0 .. < stride
        line[x] = field[y * stride + x]
    centerline-envelope(line, out, hull, bounds, stride)
    for x in 0 .. < stride
        field[y * stride + x] = sqrt(out[x])
= field

━━━━━━━━━━━━━━━━━━━━
_ do centerline-envelope
    - line F64[]
    - out F64[]
    - hull U32[]
    - bounds F64[]
    - count Size

. far = 100000000000000000000.0
. k Index = 0
hull[0] = 0
bounds[0] = -far
bounds[1] = far
for q in 1 .. < count
    . s = centerline-meet(line, q, hull[k])
    while s <= bounds[k]
        k -= 1
        s = centerline-meet(line, q, hull[k])
    k += 1
    hull[k] = q as U32
    bounds[k] = s
    bounds[k + 1] = far
k = 0
for q in 0 .. < count
    while bounds[k + 1] < (q as F64)
        k += 1
    . v = hull[k] as Index
    . gap = (q as F64) - (v as F64)
    out[q] = gap * gap + line[v]

━━━━━━━━━━━━━━━━━━━━
_ centerline-meet F64
    - line F64[]
    - q Index
    - v Index

((line[q] + a * a) - (line[v] + b * b)) / (2 * a - 2 * b)

.. a = q as F64
.. b = v as F64

━━━━━━━━━━━━━━━━━━━━
_ do centerline-map-ops [PathOp]
    - ops [PathOp]
    - origin Point
    - scale F64

. mapped = List'PathOp()
for op in ops
    if op is PathMoveTo
        . move = op as PathMoveTo
        mapped += M((move.x - origin.x) * scale, (move.y - origin.y) * scale)
    else if op is PathLineTo
        . line = op as PathLineTo
        mapped += L((line.x - origin.x) * scale, (line.y - origin.y) * scale)
    else if op is PathCubicTo
        . cubic = op as PathCubicTo
        mapped += C
            - (cubic.c1x - origin.x) * scale
            - (cubic.c1y - origin.y) * scale
            - (cubic.c2x - origin.x) * scale
            - (cubic.c2y - origin.y) * scale
            - (cubic.x - origin.x) * scale
            - (cubic.y - origin.y) * scale
    else
        mapped += op
= mapped
