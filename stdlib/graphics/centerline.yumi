./canvas
./curve-fit
./point
./primitives
./vector
/math
/stream/sort

_ centerline-ink-floor = 0.04
_ centerline-dot-floor = 0.02
_ centerline-bend-angle = 0.6
_ centerline-pair-score = 0.7
_ centerline-straight-score = 0.94
_ centerline-spur-reach = 1.25
_ centerline-cut-reach = 1.25
_ centerline-tip-depth = 0.8
_ centerline-dot-extent = 2.0
_ centerline-dot-span = 4.0
_ centerline-shift-limit = 1.2
_ centerline-prune-rounds Index = 4
_ centerline-circle-handle = 0.5522847498

━━━━━━━━━━━━━━━━━━━━
+ TracedStroke is Tuple

+ ops [PathOp]
+ is-filled Bool

━━━━━━━━━━━━━━━━━━━━
+ CenterlineTrace is Tuple

+ strokes [TracedStroke]
+ stroke-width Length

━━━━━━━━━━━━━━━━━━━━
+ do canvas-ink Byte[]
    - canvas RasterCanvas

. pixels = canvas.premultiplied-pixels()
. count = pixels.size / 4
. ink = Byte[count]
for index in 0 .. < count
    . base = index * 4
    . red = pixels[base] as F64
    . green = pixels[base + 1] as F64
    . blue = pixels[base + 2] as F64
    . alpha = pixels[base + 3] as F64
    . light = 0.2126 * red + 0.7152 * green + 0.0722 * blue + 255 - alpha
    ink[index] = (255 - clamp(round(light), 0.0, 255.0)) as Byte
= ink

━━━━━━━━━━━━━━━━━━━━
+ trace-centerlines CenterlineTrace
    - ink Byte[]
    - width Size
    - height Size
    - tolerance Length = 1.0
    - origin = Point(0, 0)
    - scale = 1.0

CenterlineTrace(strokes, traced.stroke-width * scale)

.. traced = CenterlineTracer(ink, width, height, tolerance).trace()
.. strokes = List'TracedStroke
    - TracedStroke(centerline-map-ops(each.ops, origin, scale), each.is-filled) in traced.strokes

━━━━━━━━━━━━━━━━━━━━
_ CenterlineNode

+ pixels [Index]
+ center Point
+ depth Length
+ is-junction Bool
+ cross Point

────────────────────
+ This
    - pixels
    - center
    - depth
    - is-junction

cross = center

━━━━━━━━━━━━━━━━━━━━
