(import ./color)
(import ./point)
(import ./primitives)
(import /math)
(import /units)

(type + GradientStop (is Tuple)
  (prop + offset Ratio)
  (prop + color RGBA)
)

(type + LinearGradient (is Tuple)
  (prop + start Point)
  (prop + end Point)
  (prop + stops (list GradientStop))
  (fn-do + validate _
    (throw (call Panic "Linear gradient coordinates must be finite") (if (or (not (call gradient-point-is-finite start)) (not (call gradient-point-is-finite end)))))
    (throw (call Panic "Linear gradient endpoints must be distinct") (if (== start end)))
    (blank)
    (call validate-gradient-stops stops)
  )
)

(type + RadialGradient (is Tuple)
  (prop + start-center Point)
  (prop + start-radius Length)
  (prop + end-center Point)
  (prop + end-radius Length)
  (prop + stops (list GradientStop))
  (fn-do + validate _
    (throw (call Panic "Radial gradient coordinates must be finite") (if (or (not (call gradient-point-is-finite start-center)) (not (call gradient-point-is-finite end-center)))))
    (throw (call Panic "Radial gradient radii must be finite and not negative") (if (or (not (call is-finite start-radius)) (not (call is-finite end-radius)) (< start-radius 0) (< end-radius 0))))
    (throw (call Panic "Radial gradient circles must be distinct") (if (and (== start-center end-center) (== start-radius end-radius))))
    (blank)
    (call validate-gradient-stops stops)
  )
)

(type + ConicGradient (is Tuple)
  (prop + center Point)
  (prop + angle Radians)
  (prop + stops (list GradientStop))
  (fn-do + validate _
    (throw (call Panic "Conic gradient center and angle must be finite") (if (or (not (call gradient-point-is-finite center)) (not (call is-finite angle)))))
    (blank)
    (call validate-gradient-stops stops)
  )
)

(type + Gradient (is Union)
  (variant LinearGradient)
  (variant RadialGradient)
  (variant ConicGradient)
  (fn-do + validate _
    (match this
      (case (: linear LinearGradient)
        (call (. linear validate))
      )
      (case (: radial RadialGradient)
        (call (. radial validate))
      )
      (case (: conic ConicGradient)
        (call (. conic validate))
      )
    )
  )
  (fn-expr + stops _ :get
    (match this
      (case (: linear LinearGradient)
        (. linear stops)
      )
      (case (: radial RadialGradient)
        (. radial stops)
      )
      (case (: conic ConicGradient)
        (. conic stops)
      )
    )
  )
)

(fn-expr + linear-gradient _
  (param start Point)
  (param end Point)
  (param start-color RGBA)
  (param end-color RGBA)
  (call LinearGradient start end (list (call GradientStop 0%% start-color) (call GradientStop 1%% end-color)))
)

(fn-expr + radial-gradient _
  (param center Point)
  (param radius Length)
  (param start-color RGBA)
  (param end-color RGBA)
  (call RadialGradient
    (block
      (arg center)
      (arg 0)
      (arg center)
      (arg radius)
      (arg (list (call GradientStop 0%% start-color) (call GradientStop 1%% end-color)))
    )
  )
)

(fn-do _ validate-gradient-stops _
  (param stops (list GradientStop))
  (let count (. stops length))
  (throw (call Panic "Gradients require at least two stops") (if (< count 2)))
  (blank)
  (if (== count 2)
    (let s0 ([] stops 0))
    (let s1 ([] stops 1))
    (let o0 (. s0 offset))
    (let o1 (. s1 offset))
    (throw (call Panic "Gradient stop offsets must be finite and between zero and one") (if (or (!= (- o0 o0) 0.0) (< o0 0%%) (> o0 1%%) (!= (- o1 o1) 0.0) (< o1 0%%) (> o1 1%%))))
    (throw (call Panic "Gradient stop offsets must be ordered") (if (< o1 o0)))
    (throw (call Panic "Gradient stop colors must be finite") (if (or (not (call gradient-color-is-finite (. s0 color))) (not (call gradient-color-is-finite (. s1 color))))))
    (return)
  )
  (let previous 0%%)
  (for (in index (..< 0 count))
    (let stop ([] stops index))
    (let off (. stop offset))
    (throw (call Panic "Gradient stop offsets must be finite and between zero and one") (if (or (!= (- off off) 0.0) (< off 0%%) (> off 1%%))))
    (throw (call Panic "Gradient stop offsets must be ordered") (if (and (> index 0) (< off previous))))
    (throw (call Panic "Gradient stop colors must be finite") (if (not (call gradient-color-is-finite (. stop color)))))
    (blank)
    (= previous off)
  )
)

(fn-expr _ gradient-point-is-finite _ @inline
  (param point Point)
  (and (== (- (. point x) (. point x)) 0.0) (== (- (. point y) (. point y)) 0.0))
)

(fn-expr _ gradient-color-is-finite Bool @inline
  (param color RGBA)
  (and (== (- (. color red) (. color red)) 0.0) (== (- (. color green) (. color green)) 0.0) (== (- (. color blue) (. color blue)) 0.0) (== (- (. color alpha) (. color alpha)) 0.0))
)

(fn-expr + hue-spectrum-stops _
  (call List
    (block
      (spread (.. 0 6))
      (pipe *>
        (call GradientStop ratio (call HSVA ratio 1 1)
          (block
            (lazy ratio (/ (as each F64) 6))
          )
        )
      )
    )
  )
)
