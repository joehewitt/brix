(import ./shader)
(import /math)
(blank)
(prop _ crayon-paint-shader _ (:= (call Shader (call media-source (call crayon-paint-source)))))
(prop _ hatch-paint-shader _ (:= (call Shader (call media-source (call hatch-paint-source)))))
(prop _ stipple-paint-shader _ (:= (call Shader (call media-source (call stipple-paint-source)))))
(prop _ watercolor-paint-shader _ (:= (call Shader (call media-source (call watercolor-paint-source)))))
(prop _ gouache-paint-shader _ (:= (call Shader (call media-source (call gouache-paint-source)))))
(prop _ grain-paint-shader _ (:= (call Shader (call media-source (call grain-paint-source)))))
(prop _ pencil-brush-shader _ (:= (call Shader (call media-source (call pencil-brush-source)))))
(prop _ charcoal-brush-shader _ (:= (call Shader (call media-source (call charcoal-brush-source)))))
(prop _ ink-brush-shader _ (:= (call Shader (call media-source (call ink-brush-source)))))
(prop _ marker-brush-shader _ (:= (call Shader (call media-source (call marker-brush-source)))))
(prop _ crayon-brush-shader _ (:= (call Shader (call media-source (call crayon-brush-source)))))

(fn-expr + crayon-paint Paint
  (param pressure F64 (= 0.6))
  (param grain F64 (= 1.2))
  (param angle F64 (= 0.6))
  (param streak F64 (= 0.5))
  (param seed F64 (= 0))
  (call Paint crayon-paint-shader (list pressure grain angle streak seed))
)

(fn-expr + hatch-paint Paint
  (param tone F64 (= 0.3))
  (param angle F64 (= 0.8))
  (param spacing F64 (= 4))
  (param weight F64 (= 0.9))
  (param wobble F64 (= 0.6))
  (param seed F64 (= 0))
  (call Paint hatch-paint-shader (list angle spacing weight tone wobble seed))
)

(fn-expr + stipple-paint Paint
  (param tone F64 (= 0.5))
  (param size F64 (= 2))
  (param seed F64 (= 0))
  (call Paint stipple-paint-shader (list size tone seed))
)

(fn-expr + watercolor-paint Paint
  (param granulation F64 (= 0.6))
  (param variation F64 (= 0.7))
  (param scale F64 (= 1))
  (param seed F64 (= 0))
  (call Paint watercolor-paint-shader (list granulation variation scale seed))
)

(fn-expr + gouache-paint Paint
  (param angle F64 (= 0.3))
  (param scale F64 (= 1))
  (param streak F64 (= 0.6))
  (param seed F64 (= 0))
  (call Paint gouache-paint-shader (list angle scale streak seed))
)

(fn-expr + grain-paint Paint
  (param amount F64 (= 0.5))
  (param grain F64 (= 1))
  (call Paint grain-paint-shader (list grain amount))
)

(fn-expr + pencil-brush Brush
  (param grain F64 (= 1))
  (param seed F64 (= 0))
  (call Brush
    (block
      (arg pencil-brush-shader)
      (arg (list grain))
      (arg 0.15)
      (arg 0.04)
      (arg 0.1)
      (arg 0)
      (arg 1)
      (arg null)
      (arg 0.8)
      (arg 0.08)
      (arg 0.12)
      (arg 1)
      (arg seed)
    )
  )
)

(fn-expr + charcoal-brush Brush
  (param grain F64 (= 1.4))
  (param roughness F64 (= 0.35))
  (param seed F64 (= 0))
  (call Brush
    (block
      (arg charcoal-brush-shader)
      (arg (list grain roughness))
      (arg 0.12)
      (arg 0.08)
      (arg 0.2)
      (arg π)
      (arg 1)
      (arg null)
      (arg 0.7)
      (arg 0.04)
      (arg 0.08)
      (arg 1)
      (arg seed)
    )
  )
)

(fn-expr + ink-brush Brush
  (param seed F64 (= 0))
  (call Brush
    (block
      (arg ink-brush-shader)
      (arg (call (of List F64)))
      (arg 0.06)
      (arg 0)
      (arg 0)
      (arg 0)
      (arg 1)
      (arg null)
      (arg 1)
      (arg 0.2)
      (arg 0.35)
      (arg 1)
      (arg seed)
    )
  )
)

(fn-expr + marker-brush Brush
  (param angle F64 (= 0.7))
  (param seed F64 (= 0))
  (call Brush
    (block
      (arg marker-brush-shader)
      (arg (call (of List F64)))
      (arg 0.05)
      (arg 0)
      (arg 0)
      (arg 0)
      (arg 0.35)
      (arg angle)
      (arg 0.35)
      (arg 0)
      (arg 0)
      (arg 1)
      (arg seed)
    )
  )
)

(fn-expr + crayon-brush Brush
  (param grain F64 (= 1.2))
  (param seed F64 (= 0))
  (call Brush
    (block
      (arg crayon-brush-shader)
      (arg (list grain))
      (arg 0.12)
      (arg 0.06)
      (arg 0.15)
      (arg π)
      (arg 1)
      (arg null)
      (arg 0.9)
      (arg 0.05)
      (arg 0.1)
      (arg 1)
      (arg seed)
    )
  )
)

(fn-expr _ media-source String
  (param body String)
  (str (call media-noise-source) "\n" body)
)

(fn-expr _ media-noise-source _
  (paragraph
    "uint mediaMix(uint x) {"
    "    x ^= x >> 16;"
    "    x *= 0x7feb352du;"
    "    x ^= x >> 15;"
    "    x *= 0x846ca68bu;"
    "    x ^= x >> 16;"
    "    return x;"
    "}"
    (blank)
    "float mediaHash(float2 cell, float seed) {"
    "    int2 c = int2(floor(cell));"
    "    uint s = uint(int(floor(seed * 7.0 + 0.5)));"
    "    uint h = mediaMix(uint(c.x) * 0x8da6b343u ^ uint(c.y) * 0xd8163841u ^ s * 0xcb1ab31fu);"
    "    return float(h >> 8) * (1.0 / 16777216.0);"
    "}"
    (blank)
    "float mediaNoise(float2 p, float seed) {"
    "    float2 i = floor(p);"
    "    float2 f = p - i;"
    "    float2 u = f * f * (3.0 - 2.0 * f);"
    "    float a = mediaHash(i, seed);"
    "    float b = mediaHash(i + float2(1.0, 0.0), seed);"
    "    float c = mediaHash(i + float2(0.0, 1.0), seed);"
    "    float d = mediaHash(i + float2(1.0, 1.0), seed);"
    "    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);"
    "}"
    (blank)
    "float mediaFbm(float2 p, float seed, int octaves) {"
    "    float sum = 0.0;"
    "    float amplitude = 0.5;"
    "    float total = 0.0;"
    "    for (int octave = 0; octave < octaves; ++octave) {"
    "        sum += amplitude * mediaNoise(p, seed + float(octave) * 13.0);"
    "        total += amplitude;"
    "        p = float2(p.x * 1.6 - p.y * 1.2, p.x * 1.2 + p.y * 1.6);"
    "        amplitude *= 0.5;"
    "    }"
    "    return sum / total;"
    "}"
    (blank)
    "float2 mediaRotate(float2 p, float angle) {"
    "    float c = cos(angle);"
    "    float s = sin(angle);"
    "    return float2(c * p.x - s * p.y, s * p.x + c * p.y);"
    "}"
    (blank)
    "float mediaTooth(float2 paper, float grain) {"
    "    float2 p = paper / max(grain, 0.05);"
    "    float fine = mediaNoise(p, 101.0) * 0.55 + mediaNoise(p * 2.31 + 17.0, 103.0) * 0.3;"
    "    float fiber = mediaNoise(float2(p.x * 0.3 + p.y * 0.1, p.y * 1.7), 107.0) * 0.15;"
    "    return saturate((fine + fiber - 0.5) * 2.2 + 0.5);"
    "}"
  )
)

(fn-expr _ crayon-paint-source _
  (paragraph
    "float4 paint(PaintInput input, ShaderArgs args) {"
    "    float pressure = saturate(args[0]);"
    "    float grain = max(args[1], 0.2);"
    "    float seed = args[4];"
    "    float tooth = mediaTooth(input.paper, grain);"
    "    float2 along = mediaRotate(input.paper, -args[2]);"
    "    float streak = mediaNoise(float2(along.x / (grain * 22.0), along.y / (grain * 1.6)), seed + 3.0);"
    "    float level = tooth + (streak - 0.5) * args[3] * 0.8;"
    "    float threshold = 1.0 - pressure;"
    "    float deposit = smoothstep(threshold - 0.12, threshold + 0.12, level);"
    "    float mottle = mediaFbm(input.paper / (grain * 45.0), seed + 9.0, 3);"
    "    float alpha = input.color.a * deposit * (0.8 + 0.4 * (mottle - 0.5));"
    "    return float4(input.color.rgb, saturate(alpha));"
    "}"
  )
)

(fn-expr _ hatch-paint-source _
  (paragraph
    "float mediaHatchLines(float2 p, float angle, float spacing, float weight, float wobble, float seed, float pixel) {"
    "    float2 q = mediaRotate(p, -angle);"
    "    float row = floor(q.y / spacing);"
    "    float best = 0.0;"
    "    float edge = max(pixel, 0.0001);"
    "    for (int k = -1; k <= 1; ++k) {"
    "        float r = row + float(k);"
    "        float shift = (mediaHash(float2(r, 3.0), seed) - 0.5) * spacing * 0.3;"
    "        float bend = (mediaNoise(float2(q.x / (spacing * 10.0), r * 1.37), seed + 5.0) - 0.5) * wobble * spacing;"
    "        float center = (r + 0.5) * spacing + shift + bend;"
    "        float width = weight * (0.55 + 0.9 * mediaNoise(float2(q.x / (spacing * 4.0), r * 2.71), seed + 9.0));"
    "        float line = 1.0 - smoothstep(width * 0.5 - edge * 0.5, width * 0.5 + edge * 0.5, abs(q.y - center));"
    "        float start = mediaHash(float2(r, 11.0), seed) * spacing * 40.0;"
    "        float gap = smoothstep(0.12, 0.28, mediaNoise(float2((q.x + start) / (spacing * 7.0), r * 3.17), seed + 13.0));"
    "        best = max(best, line * gap);"
    "    }"
    "    return best;"
    "}"
    (blank)
    "float4 paint(PaintInput input, ShaderArgs args) {"
    "    float angle = args[0];"
    "    float spacing = max(args[1], 0.5);"
    "    float weight = max(args[2], 0.05);"
    "    float tone = saturate(args[3]);"
    "    float wobble = args[4];"
    "    float seed = args[5];"
    "    float first = mediaHatchLines(input.position, angle, spacing, weight, wobble, seed, input.pixel);"
    "    float second = mediaHatchLines(input.position, angle + 1.1, spacing, weight, wobble, seed + 21.0, input.pixel);"
    "    float third = mediaHatchLines(input.position, angle - 0.75, spacing * 0.8, weight, wobble, seed + 43.0, input.pixel);"
    "    float layers = 1.0 - (1.0 - first) * (1.0 - second * saturate(tone * 3.0 - 1.0)) *"
    "        (1.0 - third * saturate(tone * 3.0 - 2.0));"
    "    float density = mix(0.55, 1.0, saturate(tone * 3.0));"
    "    float graphite = layers * smoothstep(0.1, 0.5, mediaTooth(input.paper, 1.0) + 0.15);"
    "    return float4(input.color.rgb, input.color.a * graphite * density);"
    "}"
  )
)

(fn-expr _ stipple-paint-source _
  (paragraph
    "float4 paint(PaintInput input, ShaderArgs args) {"
    "    float size = max(args[0], 0.3);"
    "    float tone = saturate(args[1]);"
    "    float seed = args[2];"
    "    float cell = size * 1.6;"
    "    float2 p = input.position / cell;"
    "    float2 base = floor(p);"
    "    float edge = max(input.pixel / cell, 0.0001);"
    "    float presence = min(1.0, tone * 1.5);"
    "    float growth = 0.6 + 0.6 * tone;"
    "    float coverage = 0.0;"
    "    for (int y = -1; y <= 1; ++y) {"
    "        for (int x = -1; x <= 1; ++x) {"
    "            float2 c = base + float2(float(x), float(y));"
    "            if (mediaHash(c, seed + 2.0) > presence) {"
    "                continue;"
    "            }"
    "            float2 center = c + 0.2 + 0.6 * float2(mediaHash(c, seed), mediaHash(c, seed + 1.0));"
    "            float radius = (size * 0.5 / cell) * growth * (0.75 + 0.5 * mediaHash(c, seed + 3.0));"
    "            float d = length(p - center);"
    "            coverage = max(coverage, 1.0 - smoothstep(radius - edge * 0.5, radius + edge * 0.5, d));"
    "        }"
    "    }"
    "    return float4(input.color.rgb, input.color.a * coverage);"
    "}"
  )
)

(fn-expr _ watercolor-paint-source _
  (paragraph
    "float4 paint(PaintInput input, ShaderArgs args) {"
    "    float granulation = saturate(args[0]);"
    "    float variation = saturate(args[1]);"
    "    float scale = max(args[2], 0.1);"
    "    float seed = args[3];"
    "    float wash = mediaFbm(input.paper / (scale * 70.0), seed, 4);"
    "    float blotch = mediaFbm(input.paper / (scale * 18.0) + 7.0, seed + 5.0, 3);"
    "    float tooth = mediaTooth(input.paper, 0.9);"
    "    float pigment = 0.62 + variation * (wash - 0.5) * 0.9 + variation * (blotch - 0.5) * 0.35;"
    "    pigment += granulation * (0.5 - tooth) * 0.5;"
    "    float3 tint = input.color.rgb * (1.0 + (wash - 0.5) * variation * float3(0.10, -0.04, 0.08));"
    "    return float4(saturate(tint), input.color.a * saturate(pigment));"
    "}"
  )
)

(fn-expr _ gouache-paint-source _
  (paragraph
    "float4 paint(PaintInput input, ShaderArgs args) {"
    "    float scale = max(args[1], 0.1);"
    "    float streak = args[2];"
    "    float seed = args[3];"
    "    float2 q = mediaRotate(input.position, -args[0]);"
    "    float bristles = mediaNoise(float2(q.x / (scale * 26.0), q.y / (scale * 0.9)), seed);"
    "    float strokes = mediaNoise(float2(q.x / (scale * 60.0), q.y / (scale * 9.0)), seed + 4.0);"
    "    float body = mediaFbm(input.position / (scale * 30.0), seed + 8.0, 3);"
    "    float shade = 1.0 + streak * ((bristles - 0.5) * 0.35 + (strokes - 0.5) * 0.25) + (body - 0.5) * 0.12;"
    "    float dry = smoothstep(0.08, 0.3, mediaTooth(input.paper, 1.0) + strokes * 0.5 - 0.2 * streak);"
    "    return float4(saturate(input.color.rgb * shade), input.color.a * mix(1.0, dry, 0.35 * streak));"
    "}"
  )
)

(fn-expr _ grain-paint-source _
  (paragraph
    "float4 paint(PaintInput input, ShaderArgs args) {"
    "    float tooth = mediaTooth(input.paper, max(args[0], 0.2));"
    "    return float4(input.color.rgb, input.color.a * mix(1.0, tooth, saturate(args[1])));"
    "}"
  )
)

(fn-expr _ pencil-brush-source _
  (paragraph
    "float4 dab(DabInput input, ShaderArgs args) {"
    "    float tip = 1.0 - smoothstep(0.35, 1.0, length(input.offset));"
    "    float tooth = mediaTooth(input.paper, max(args[0], 0.2));"
    "    float threshold = 1.0 - input.pressure * 0.9;"
    "    float graphite = smoothstep(threshold - 0.1, threshold + 0.15, tooth);"
    "    return float4(input.color.rgb, input.color.a * tip * graphite);"
    "}"
  )
)

(fn-expr _ charcoal-brush-source _
  (paragraph
    "float4 dab(DabInput input, ShaderArgs args) {"
    "    float rough = mediaNoise(input.offset * 2.5 + input.random * 37.0, 31.0) - 0.5;"
    "    float tip = 1.0 - smoothstep(0.55, 1.0, length(input.offset) + rough * args[1]);"
    "    float tooth = mediaTooth(input.paper, max(args[0], 0.2));"
    "    float dust = smoothstep(0.75 - input.pressure * 0.6, 1.0 - input.pressure * 0.5, tooth);"
    "    return float4(input.color.rgb, input.color.a * tip * dust);"
    "}"
  )
)

(fn-expr _ ink-brush-source _
  (paragraph
    "float4 dab(DabInput input, ShaderArgs args) {"
    "    float edge = max(input.pixel, 0.01);"
    "    float tip = 1.0 - smoothstep(1.0 - edge, 1.0, length(input.offset));"
    "    return float4(input.color.rgb, input.color.a * tip);"
    "}"
  )
)

(fn-expr _ marker-brush-source _
  (paragraph
    "float4 dab(DabInput input, ShaderArgs args) {"
    "    float2 o = abs(input.offset);"
    "    float edge = max(input.pixel, 0.01);"
    "    float tip = (1.0 - smoothstep(1.0 - edge, 1.0, o.x)) * (1.0 - smoothstep(1.0 - edge, 1.0, o.y));"
    "    float streak = 0.9 + 0.1 * mediaNoise(float2(input.distance * 0.05, input.offset.x * 6.0), 41.0);"
    "    return float4(input.color.rgb, input.color.a * tip * streak);"
    "}"
  )
)

(fn-expr _ crayon-brush-source _
  (paragraph
    "float4 dab(DabInput input, ShaderArgs args) {"
    "    float rough = mediaNoise(input.offset * 3.0 + input.random * 19.0, 61.0) - 0.5;"
    "    float tip = 1.0 - smoothstep(0.7, 1.0, length(input.offset) + rough * 0.25);"
    "    float tooth = mediaTooth(input.paper, max(args[0], 0.2));"
    "    float wax = smoothstep(0.55 - input.pressure * 0.45, 0.7 - input.pressure * 0.4, tooth);"
    "    return float4(input.color.rgb, input.color.a * tip * wax);"
    "}"
  )
)
