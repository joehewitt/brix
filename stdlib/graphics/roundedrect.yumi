./canvas
./primitives

━━━━━━━━━━━━━━━━━━━━
+ RoundedRect is Tuple

+ bounds Rect
+ left Length
+ top Length
+ right Length
+ bottom Length

────────────────────
+ get is-rounded Bool

(left > 0 || right > 0) && (top > 0 || bottom > 0)

────────────────────
+ do outline
    - canvas Canvas

. k = 0.5522847498307936
. x = bounds.left
. y = bounds.top
. r = bounds.right
. b = bounds.bottom
canvas.move(x + left, y)
canvas.line(r - right, y)
canvas.curve(r - right + right * k, y, r, y + top - top * k, r, y + top)
canvas.line(r, b - bottom)
canvas.curve(r, b - bottom + bottom * k, r - right + right * k, b, r - right, b)
canvas.line(x + left, b)
canvas.curve(x + left - left * k, b, x, b - bottom + bottom * k, x, b - bottom)
canvas.line(x, y + top)
canvas.curve(x, y + top - top * k, x + left - left * k, y, x + left, y)
canvas.enclose()

────────────────────
+ do clip
    - canvas Canvas

if is-rounded && bounds.width > 0 && bounds.height > 0
    canvas.begin()
    outline(canvas)
    canvas.clip-path()
else
    canvas.clip(bounds)
