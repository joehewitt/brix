./curve-fit
./overlap
./path
./point
./primitives
./vector
/math

_ ink-speed-scale = 120.0
_ ink-radius-follow = 0.35
_ ink-taper-floor = 0.12
_ ink-hold-widths = 3.0
_ ink-freeze-widths = 6.0
_ ink-spacing-widths = 0.04
_ ink-fit-reach Index = 3
_ ink-fit-density = 16.0
_ ink-arc-limit = π / 4

━━━━━━━━━━━━━━━━━━━━
_ InkDisc is Tuple

+ center Point
+ radius Length
+ travel Length

━━━━━━━━━━━━━━━━━━━━
+ InkPen is Tuple

+ size Length
+ thinning = 0.5
+ smoothing = 0.5
+ taper-start Length = 0
+ taper-end Length = 0
+ tolerance Length = 0.5

────────────────────
_ get spacing Length

max(tolerance, size * ink-spacing-widths)

────────────────────
_ get least-radius Length

max(tolerance * 0.25, 0.01)

━━━━━━━━━━━━━━━━━━━━
+ InkStroke

+ pen InkPen

_ kept [InkDisc]
_ tail [InkDisc]
_ smoothed Point
_ last-time F64
_ travelled Length
_ radius Length
_ is-started = false

────────────────────
+ This
    - pen

────────────────────
+ do add
    - point Point
    - at F64

if !is-started
    is-started = true
    smoothed = point
    last-time = at
    radius = pen.size / 2
    tail += InkDisc(point, radius, 0)
    =
smoothed = smoothed + (point - smoothed) * (1 - clamp(pen.smoothing, 0.0, 0.9))
. latest = if tail then tail[tail.length - 1] else kept[kept.length - 1]
. step = smoothed.distance(latest.center)
=? if step < pen.spacing
. elapsed = max(at - last-time, 0.001)
last-time = at
travelled += step
. speed = step / elapsed / pen.size
. thin = clamp(pen.thinning, 0.0, 1.0) * clamp(speed / ink-speed-scale, 0.0, 1.0)
radius += (pen.size / 2 * (1 - thin) - radius) * ink-radius-follow
tail += InkDisc(smoothed, radius, travelled)
freeze-old()

────────────────────
+ do preview Path

. discs = List'InkDisc(kept)
discs ++= tail
= ink-ring-path(ink-outline(ink-clean(shaped(discs, pen.taper-start, 0)), pen.tolerance))

────────────────────
+ do finish Path

=? Path() if !kept && !tail
. discs = List'InkDisc(kept)
discs ++= tail
. tapers = pen.taper-start + pen.taper-end
. scale = if tapers > travelled then travelled / tapers else 1.0
. final = shaped(discs, pen.taper-start * scale, pen.taper-end * scale)
. rings = List'([Point])()
rings += ink-outline
    - ink-clean(ink-pick(final, ink-prune(final, pen.tolerance * 0.5)))
    - pen.tolerance
= ink-fitted(remove-overlap(rings), pen)

────────────────────
_ do shaped [InkDisc]
    - discs [InkDisc]
    - start Length
    - end Length

. result = List'InkDisc()
for disc in discs
    . factor = ink-taper(disc.travel, start) * ink-taper(travelled - disc.travel, end)
    result += InkDisc(disc.center, max(disc.radius * factor, pen.least-radius), disc.travel)
= result

────────────────────
_ do freeze-old

. hold = pen.size * ink-hold-widths + pen.taper-end
=? if ink-length(tail) < hold + pen.size * ink-freeze-widths
. reach = 0.0
. index = tail.length - 1
while index > 0 && reach < hold
    reach += tail[index].center.distance(tail[index - 1].center)
    index -= 1
. chunk = List'InkDisc()
if kept
    chunk += kept[kept.length - 1]
for each in 0 .. < index
    chunk += tail[each]
. flags = ink-prune(shaped(chunk, pen.taper-start, 0), pen.tolerance * 0.5)
for each in (if kept then 1 else 0) .. < chunk.length
    if flags[each] == 1
        kept += chunk[each]
. rest = List'InkDisc()
for each in index .. < tail.length
    rest += tail[each]
tail = rest

━━━━━━━━━━━━━━━━━━━━
_ ink-taper F64
    - distance Length
    - length Length

if length <= 0 then 1.0 else ink-taper-floor + (1 - ink-taper-floor) * eased

.. clamped = clamp(distance / length, 0.0, 1.0)
.. eased = clamped * (2 - clamped)

━━━━━━━━━━━━━━━━━━━━
_ do ink-length Length
    - discs [InkDisc]

=? 0.0 if discs.length < 2
. total = 0.0
for index in 1 .. < discs.length
    total += discs[index].center.distance(discs[index - 1].center)
= total

━━━━━━━━━━━━━━━━━━━━
_ do ink-clean [InkDisc]
    - discs [InkDisc]

. clean = List'InkDisc()
for disc in discs
    . adding = true
    while adding && clean
        . previous = clean[clean.length - 1]
        . gap = disc.center.distance(previous.center)
        if gap + disc.radius <= previous.radius
            adding = false
        else if gap + previous.radius <= disc.radius
            clean.pop()
        else
            break
    if adding
        clean += disc
= clean

━━━━━━━━━━━━━━━━━━━━
_ do ink-prune U8[]
    - discs [InkDisc]
    - tolerance Length

. keep = U8[discs.length]
=? keep if !discs
keep[0] = 1
keep[discs.length - 1] = 1
=? keep if discs.length <= 2
. firsts = List'Index()
. lasts = List'Index()
firsts += 0
lasts += discs.length - 1
while firsts
    . first = firsts.pop()
    . last = lasts.pop()
    . worst = 0.0
    . split = first
    for index in first + 1 .. < last
        . miss = ink-deviation(discs[index], discs[first], discs[last])
        if miss > worst
            worst = miss
            split = index
    if worst > tolerance
        keep[split] = 1
        firsts += first
        lasts += split
        firsts += split
        lasts += last
= keep

━━━━━━━━━━━━━━━━━━━━
_ ink-pick [InkDisc]
    - discs [InkDisc]
    - flags U8[]

discs[each] in 0 .. < discs.length when flags[each] == 1

━━━━━━━━━━━━━━━━━━━━
_ ink-deviation Length
    - disc InkDisc
    - from InkDisc
    - to InkDisc

sqrt(place * place + size * size)

.. along = to.center - from.center
.. span = along.dot(along)
.. t = if span > 0 then clamp((disc.center - from.center).dot(along) / span, 0.0, 1.0) else 0.0
.. place = disc.center.distance(from.center + along * t)
.. size = disc.radius - (from.radius + (to.radius - from.radius) * t)

━━━━━━━━━━━━━━━━━━━━
_ do ink-outline [Point]
    - discs [InkDisc]
    - tolerance Length

. count = discs.length
. ring = List'Point()
=? ring if count == 0
if count == 1
    . only = discs[0]
    ring += only.center + Point(only.radius, 0)
    ink-arc(ring, only, Point(1, 0), Point(1, 0), tolerance)
    = ring
. lefts = List'Point()
. rights = List'Point()
for index in 0 .. < count - 1
    . a = discs[index]
    . b = discs[index + 1]
    . along = b.center - a.center
    . unit = along / along.length
    . normal = Point(-unit.y, unit.x)
    . lean = clamp((a.radius - b.radius) / along.length, -1.0, 1.0)
    . upright = sqrt(1 - lean * lean)
    lefts += normal * upright + unit * lean
    rights += normal * -upright + unit * lean
for index in 0 .. < count - 1
    . a = discs[index]
    . b = discs[index + 1]
    if index > 0
        ink-join(ring, a, rights[index - 1], rights[index], tolerance)
    ring += a.center + rights[index] * a.radius
    ring += b.center + rights[index] * b.radius
ink-arc(ring, discs[count - 1], rights[count - 2], lefts[count - 2], tolerance)
for step in 0 .. < count - 1
    . index = count - 2 - step
    . a = discs[index]
    . b = discs[index + 1]
    if index < count - 2
        ink-join(ring, b, lefts[index + 1], lefts[index], tolerance)
    ring += b.center + lefts[index] * b.radius
    ring += a.center + lefts[index] * a.radius
ink-arc(ring, discs[0], lefts[0], rights[0], tolerance)
= ring

━━━━━━━━━━━━━━━━━━━━
_ do ink-join
    - ring [Point]
    - disc InkDisc
    - from Point
    - to Point
    - tolerance Length

if from.cross(to) > 0
    ink-arc(ring, disc, from, to, tolerance)
else
    ring += disc.center

━━━━━━━━━━━━━━━━━━━━
_ do ink-arc
    - ring [Point]
    - disc InkDisc
    - from Point
    - to Point
    - tolerance Length

. sweep = atan2(from.cross(to), from.dot(to)) as F64
if sweep <= 0
    sweep += 2 * (π as F64)
. ratio = clamp(1 - tolerance / disc.radius, -1.0, 1.0)
. limit = clamp((2 * acos(ratio)) as F64, 0.05, ink-arc-limit)
. steps = max(ceil(sweep / limit) as Index, 1)
. start = atan2(from.y, from.x) as F64
for index in 1 .. < steps
    . angle = start + sweep * (index as F64) / (steps as F64)
    ring += disc.center + Point(cos(angle), sin(angle)) * disc.radius

━━━━━━━━━━━━━━━━━━━━
_ do ink-ring-path Path
    - ring [Point]

. path = Path()
=? path if ring.length < 3
path.move-to(ring[0])
for index in 1 .. < ring.length
    path.line-to(ring[index])
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do ink-fitted Path
    - rings [[Point]]
    - pen InkPen

. spacing = max(pen.tolerance, pen.size / ink-fit-density)
. fitter = CurveFitter(pen.tolerance, ink-fit-reach)
. ops = List'PathOp()
for ring in rings
    ops ++= fitter.fit(ink-subdivide(ring, spacing), List'Index(), true)
= vector-path(ops) ?? Path()

━━━━━━━━━━━━━━━━━━━━
_ do ink-subdivide [Point]
    - ring [Point]
    - spacing Length

. points = List'Point()
for index in 0 .. < ring.length
    . a = ring[index]
    . b = ring[(index + 1) % ring.length]
    . pieces = max(ceil(a.distance(b) / spacing) as Index, 1)
    for piece in 0 .. < pieces
        points += a + (b - a) * ((piece as F64) / (pieces as F64))
= points
