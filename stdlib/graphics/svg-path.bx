(import ./point)
(import ./vector)

(fn-expr + svg-path-ops (list PathOp) (?! Error)
  (param data String)
  (call (. (call SVGPathReader data) read))
)

(type _ SVGPathReader
  (prop + data String)
  (blank)
  (prop _ chars ([] Char))
  (prop _ position Index (= 0))
  (prop _ ops (list PathOp))
  (prop _ current _ (= (call Point 0 0)))
  (prop _ start _ (= (call Point 0 0)))
  (prop _ cubic-control (? Point))
  (prop _ quadratic-control (? Point))
  (prop _ needs-move _ (= false))
  (fn-do + This _
    (param data _)
    (lazy chars (as data ([] Char)))
  )
  (fn-do + read (list PathOp) (?! Error)
    (call skip)
    (return-if ops (if (>= position (. chars length))))
    (throw (call fail "Path data must start with M" position) (if (and (!= ([] chars position) 'M') (!= ([] chars position) 'm'))))
    (blank)
    (while (< position (. chars length))
      (let command ([] chars position))
      (+= position 1)
      (if (or (== command 'Z') (== command 'z'))
        (call close)
        (else
          (throw (call fail (str "“" command "” is not a path command") (- position 1)) (if (not (call svg-path-command command))))
          (blank)
          (let count Size 0)
          (while (or (== count 0) (call starts-number))
            (call step command count)
            (+= count 1)
          )
        )
      )
      (call skip)
    )
    (return ops)
  )
  (fn-do _ step _ (?! Error)
    (param command Char)
    (param count Size)
    (let relative (and (>= command 'a') (<= command 'z')))
    (let base (if-expr relative current (call Point 0 0)))
    (if (or (== command 'M') (== command 'm'))
      (let point (+ base (call read-point)))
      (if (== count 0)
        (call move point)
        (else
          (call line point)
        )
      )
      (else-if (or (== command 'L') (== command 'l'))
        (call line (+ base (call read-point)))
      )
      (else-if (or (== command 'H') (== command 'h'))
        (let x (call read-number))
        (call line (call Point (if-expr relative (+ (. current x) x) x) (. current y)))
      )
      (else-if (or (== command 'V') (== command 'v'))
        (let y (call read-number))
        (call line (call Point (. current x) (if-expr relative (+ (. current y) y) y)))
      )
      (else-if (or (== command 'C') (== command 'c'))
        (let first (+ base (call read-point)))
        (let second (+ base (call read-point)))
        (call cubic first second (+ base (call read-point)))
      )
      (else-if (or (== command 'S') (== command 's'))
        (let first (call svg-path-reflected current cubic-control))
        (let second (+ base (call read-point)))
        (call cubic first second (+ base (call read-point)))
      )
      (else-if (or (== command 'Q') (== command 'q'))
        (let control (+ base (call read-point)))
        (call quadratic control (+ base (call read-point)))
      )
      (else-if (or (== command 'T') (== command 't'))
        (call quadratic (call svg-path-reflected current quadratic-control) (+ base (call read-point)))
      )
      (else
        (let rx (call read-number))
        (let ry (call read-number))
        (let rotation (call read-number))
        (let large (call read-flag))
        (let sweep (call read-flag))
        (let end (+ base (call read-point)))
        (call resume)
        (+= ops (call A rx ry rotation large sweep (. end x) (. end y)))
        (= current end)
        (= cubic-control null)
        (= quadratic-control null)
      )
    )
  )
  (fn-do _ move _
    (param point Point)
    (+= ops (call M (. point x) (. point y)))
    (= current point)
    (= start point)
    (= needs-move false)
    (= cubic-control null)
    (= quadratic-control null)
  )
  (fn-do _ line _
    (param point Point)
    (call resume)
    (+= ops (call L (. point x) (. point y)))
    (= current point)
    (= cubic-control null)
    (= quadratic-control null)
  )
  (fn-do _ cubic _
    (param first Point)
    (param second Point)
    (param end Point)
    (call resume)
    (+= ops (call C (. first x) (. first y) (. second x) (. second y) (. end x) (. end y)))
    (= current end)
    (= cubic-control second)
    (= quadratic-control null)
  )
  (fn-do _ quadratic _
    (param control Point)
    (param end Point)
    (call resume)
    (+= ops (call Q (. control x) (. control y) (. end x) (. end y)))
    (= current end)
    (= cubic-control null)
    (= quadratic-control control)
  )
  (fn-do _ close _
    (+= ops (call Z))
    (= current start)
    (= needs-move true)
    (= cubic-control null)
    (= quadratic-control null)
  )
  (fn-do _ resume _
    (return-if (if (not needs-move)))
    (blank)
    (+= ops (call M (. start x) (. start y)))
    (= needs-move false)
  )
  (fn-do _ read-point Point (?! Error)
    (let x (call read-number))
    (let y (call read-number))
    (return (call Point x y))
  )
  (fn-do _ read-number F64 (?! Error)
    (call skip)
    (let begin position)
    (if (and (< position (. chars length)) (or (== ([] chars position) '-') (== ([] chars position) '+')))
      (+= position 1)
    )
    (let whole (call digits))
    (let fraction Size 0)
    (if (and (< position (. chars length)) (== ([] chars position) '.'))
      (+= position 1)
      (= fraction (call digits))
    )
    (throw (call fail "A number is missing" begin) (if (== (+ whole fraction) 0)))
    (blank)
    (if (and (< position (. chars length)) (or (== ([] chars position) 'e') (== ([] chars position) 'E')))
      (let mark position)
      (+= position 1)
      (if (and (< position (. chars length)) (or (== ([] chars position) '-') (== ([] chars position) '+')))
        (+= position 1)
      )
      (if (== (call digits) 0)
        (= position mark)
      )
    )
    (return (as ([] data (..< begin position)) F64))
  )
  (fn-do _ read-flag Bool (?! Error)
    (call skip)
    (throw (call fail "An arc flag must be 0 or 1" position) (if (or (>= position (. chars length)) (and (!= ([] chars position) '0') (!= ([] chars position) '1')))))
    (blank)
    (+= position 1)
    (return (== ([] chars (- position 1)) '1'))
  )
  (fn-do _ digits Size
    (let begin position)
    (while (and (< position (. chars length)) (call svg-path-digit ([] chars position)))
      (+= position 1)
    )
    (return (- position begin))
  )
  (fn-do _ starts-number Bool
    (call skip)
    (return-if false (if (>= position (. chars length))))
    (blank)
    (let c ([] chars position))
    (return (or (call svg-path-digit c) (== c '.') (== c '-') (== c '+')))
  )
  (fn-do _ skip _
    (while (and (< position (. chars length)) (or (call svg-path-space ([] chars position)) (== ([] chars position) ',')))
      (+= position 1)
    )
  )
  (fn-expr _ fail Error
    (param problem String)
    (param index Index)
    (call Error (str problem " at character " (+ index 1) " of the path data"))
  )
)

(fn-expr _ svg-path-reflected Point
  (param point Point)
  (param control (? Point))
  (case? control
    (+ point (- point control))
  )
  (default
    point
  )
)

(fn-expr _ svg-path-command _
  (param c Char)
  (or cubic-or-straight (== c 'Q') (== c 'q') (== c 'T') (== c 't') (== c 'A') (== c 'a'))
  (where
    (lazy move-or-line (or (== c 'M') (== c 'm') (== c 'L') (== c 'l')))
    (lazy straight (or move-or-line (== c 'H') (== c 'h') (== c 'V') (== c 'v')))
    (lazy cubic-or-straight (or straight (== c 'C') (== c 'c') (== c 'S') (== c 's')))
  )
)

(fn-expr _ svg-path-digit _
  (param c Char)
  (and (>= c '0') (<= c '9'))
)

(fn-expr _ svg-path-space _
  (param c Char)
  (or (== c (char " ")) (== c (char "\t")) (== c (char "\r")) (== c (char "\n")))
)
