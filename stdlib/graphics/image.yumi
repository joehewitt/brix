━━━━━━━━━━━━━━━━━━━━
+ Image

+ scale F64
+ pixel-width I32
+ pixel-height I32
+ revision U64

_ surface RasterCanvas
_ references U32 = 1

────────────────────
+ This
    - surface RasterCanvas
    - scale = 1

pixel-width = surface.pixel-width
pixel-height = surface.pixel-height

────────────────────
+ get canvas RasterCanvas

?! Panic("Image canvas used after its final release")
    if references == 0
surface

────────────────────
+ do invalidate

revision += 1

────────────────────
+ do render
    - shader Shader
    - args [F64] = List'F64()
    - images [Image] = List'Image()
    - rect Rect? = null

?! Panic("Image rendered after its final release")
    if references == 0
. region = rect ?? Rect(0, 0, size.width, size.height)
. natives = List'Pointer()
. scales = List'F64()
for image in images
    natives += image.canvas.native
    scales += image.scale
. did-render = C:yumiGraphicsCanvasRender
    - surface.native
    - scale
    - region.x
    - region.y
    - region.width
    - region.height
    - shader.id
    - args.buffer-pointer
    - args.length
    - natives.buffer-pointer
    - scales.buffer-pointer
    - natives.length
?! Panic("Shader could not render into image")
    if !did-render
invalidate()

────────────────────
+ get size

Dimensions(pixel-width / scale, pixel-height / scale)

────────────────────
+ get byte-count Size

(pixel-width as Size) * (pixel-height as Size) * (surface.bytes-per-pixel as Size)

────────────────────
+ get color-space

surface.color-space

────────────────────
+ get pixel-format

surface.pixel-format

────────────────────
+ get is-released

references == 0

────────────────────
+ do retain

?! Panic("Image retained after its final release")
    if references == 0
references += 1

╌╌╌╌╌╌╌╌╌╌ is Usable'Void ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do release

?! Panic("Image released more often than retained")
    if references == 0
references -= 1
if references == 0
    surface.close()

────────────────────
+ do draw
    - destination Canvas
    - rect Rect
    - sampling = ImageSampling.smooth

=? if references == 0
destination.draw-image(surface, rect, false, sampling)

────────────────────
+ do fill
    - destination Canvas
    - rect Rect
    - tile Rect
    - sampling = ImageSampling.smooth

=? if references == 0
destination.fill-image(surface, rect, tile, sampling)

────────────────────
+ opaque-bounds Rect?
    - minimum-alpha I32 = 0

|? references == 0
    null
|? !found
    null
??
    Rect(found.x / scale, found.y / scale, found.width / scale, found.height / scale)

.. found = surface.opaque-pixel-bounds(minimum-alpha)

────────────────────
+ pixel-color RGBA
    - x I32
    - y I32

surface.pixel-color(Point(x + 0.5, y + 0.5))

━━━━━━━━━━━━━━━━━━━━
+ do load-image Image ?! IOError
    - path Path
    - max-pixel-size I32 = 0
    - color-space ColorSpace? = null
    - pixel-format = PixelFormat.rgba8

. location = "$path"
. space = if color-space then color-space as I32 else -1
. done = Semaphore'Pointer()
do new thread
    done.post(C:yumiGraphicsImageDecodeFile(location, max-pixel-size, space, pixel-format, false))
. native = done.await() ?? Pointer()
?! IOError("Unable to decode image $path")
    if native == Pointer()
= Image(RasterCanvas(native), image-scale-for-name(path.base-name))

━━━━━━━━━━━━━━━━━━━━
+ do load-thumbnail Image ?! IOError
    - path Path
    - max-pixel-size I32

. location = "$path"
. done = Semaphore'Pointer()
do new thread
    done.post(C:yumiGraphicsImageDecodeFile(location, max-pixel-size, -1, 0, true))
. native = done.await() ?? Pointer()
?! IOError("Unable to decode thumbnail $path")
    if native == Pointer()
= Image(RasterCanvas(native), 1)

━━━━━━━━━━━━━━━━━━━━
+ do decode-image Image ?! IOError
    - bytes Byte[]
    - scale F64 = 1
    - max-pixel-size I32 = 0
    - color-space ColorSpace? = null
    - pixel-format = PixelFormat.rgba8

. space = if color-space then color-space as I32 else -1
. done = Semaphore'Pointer()
do new thread
    done.post
        - C:yumiGraphicsImageDecodeData
            - bytes.data
            - bytes.size
            - max-pixel-size
            - space
            - pixel-format
            - false
. native = done.await() ?? Pointer()
?! IOError("Unable to decode image")
    if native == Pointer()
= Image(RasterCanvas(native), scale)

