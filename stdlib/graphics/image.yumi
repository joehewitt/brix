+ dpi-y F64

────────────────────
+ get size

Dimensions(pixel-width * 72 / dpi-x, pixel-height * 72 / dpi-y)

━━━━━━━━━━━━━━━━━━━━
+ do measure-image ImageMeasure ?! IOError
    - bytes Byte[]

. measures = F64[4]
. found = C:yumiGraphicsImageMeasureData(bytes.data, bytes.size, measures)
?! IOError("Unable to read the size of an image")
    if !found
= ImageMeasure(measures[0], measures[1], measures[2], measures[3])

━━━━━━━━━━━━━━━━━━━━
+ image-scale-for-name F64
    - base-name String

|? base-name.ends-with("@3x")
    3
|? base-name.ends-with("@2x")
    2
??
    1
