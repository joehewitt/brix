./color
./primitives
./shader
./shader-declarations

━━━━━━━━━━━━━━━━━━━━
+ Shimmer is FillShader

+ color RGBA
+ highlight RGBA
+ band Length
+ sweep FrameCycle

────────────────────
+ This
    - color
    - highlight
    - band = 60
    - speed F64 = 240
    - rest F64 = 2

sweep = FrameCycle(band * 2 / speed, rest, 1 / speed)

────────────────────
+ " metal

float4 fill(float2 position, float2 size, ShimmerArgs args) {
    float band = max(args.band, 1.0);
    float travel = size.x + band * 2.0;
    float center = args.sweep * args.sweep * args.sweep * travel - band;
    float glow = 1.0 - smoothstep(0.0, band, abs(position.x - center));
    return mix(args.color, args.highlight, glow * glow);
}
