(import ./curve-kernels)
(import ./path)
(import ./point)
(import ./primitives)
(import /math)
(blank)
(prop _ offset-teeny _ (= 0.000001))
(prop _ offset-curve-tolerance _ (= 0.25))
(prop _ offset-recursive-limit _ (= 24))
(prop _ offset-turn-cosine _ (= 0.5))

(type + OffsetPathWriter
  (prop + path Path)
  (prop + has-last _ (= false))
  (prop + first Point)
  (prop + last Point)
  (prop + collect-spans _ (= false))
  (prop + is-exact _ (= false))
  (prop + spans (list CurveRangeScalars))
  (prop + origins (list CurveRangeScalars))
  (prop + origin CurveRangeScalars)
  (prop + sources (list CurveRangeScalars))
  (fn-do + This _
    (lazy path (call Path))
  )
  (fn-do + reset _
    (= path (call Path))
    (= has-last false)
    (call (. spans clear))
    (call (. origins clear))
    (call (. sources clear))
  )
  (fn-do + originate _
    (param source CurveRangeScalars)
    (= origin source)
    (if collect-spans
      (+= sources source)
    )
  )
  (fn-do + line-to _
    (param point Point)
    (if (not has-last)
      (call (. path move-to) point)
      (= first point)
      (= last point)
      (= has-last true)
      (else-if (> (call (. last distance) point) offset-teeny)
        (if collect-spans
          (let segment-type SegmentType .segment-type-line)
          (+= spans
            (call CurveRangeScalars
              (block
                (arg segment-type)
                (arg (. last x))
                (arg (. last y))
                (arg (. last x))
                (arg (. last y))
                (arg (. point x))
                (arg (. point y))
                (arg (. point x))
                (arg (. point y))
              )
            )
          )
          (+= origins origin)
        )
        (call (. path line-to) point)
        (= last point)
      )
    )
  )
  (fn-do + cubic-curve-to _
    (param h1 Point)
    (param h2 Point)
    (param point Point)
    (if (not has-last)
      (call line-to point)
      (return)
    )
    (if collect-spans
      (let segment-type SegmentType .segment-type-cubic)
      (+= spans
        (call CurveRangeScalars
          (block
            (arg segment-type)
            (arg (. last x))
            (arg (. last y))
            (arg (. h1 x))
            (arg (. h1 y))
            (arg (. h2 x))
            (arg (. h2 y))
            (arg (. point x))
            (arg (. point y))
          )
        )
      )
      (+= origins origin)
    )
    (call (. path cubic-curve-to) h1 h2 point)
    (= last point)
  )
  (fn-do + arc _
    (param center Point)
    (param radius Length)
    (param start-angle Radians)
    (param end-angle Radians)
    (param ccw Bool)
    (if collect-spans
      (call append-arc-cubics center radius start-angle end-angle ccw)
      (else
        (call (. path arc) center radius start-angle end-angle ccw true)
        (= last (call Point (+ (. center x) (* radius (call cos end-angle))) (+ (. center y) (* radius (call sin end-angle)))))
      )
    )
  )
  (fn-do + close _
    (call (. path close))
    (if (and collect-spans has-last (> (call (. last distance) first) offset-teeny))
      (let segment-type SegmentType .segment-type-line)
      (+= spans
        (call CurveRangeScalars
          (block
            (arg segment-type)
            (arg (. last x))
            (arg (. last y))
            (arg (. last x))
            (arg (. last y))
            (arg (. first x))
            (arg (. first y))
            (arg (. first x))
            (arg (. first y))
          )
        )
      )
      (+= origins origin)
    )
    (= last (if-expr has-last first last))
  )
  (fn-do _ append-arc-cubics _
    (param center Point)
    (param radius Length)
    (param start-angle Radians)
    (param end-angle Radians)
    (param ccw Bool)
    (let remaining
      (block
        (case? ccw
          (- start-angle end-angle)
        )
        (default
          (- end-angle start-angle)
        )
      )
    )
    (if (< remaining 0)
      (= remaining (call normalize-offset-angle remaining))
    )
    (blank)
    (let a1 start-angle)
    (let sign Float (if-expr ccw -1 1))
    (while (> remaining 0)
      (let amount Float (* sign (call min remaining (/ π 2))))
      (let a2 (+ a1 amount))
      (call append-small-arc-cubic center radius a1 a2)
      (-= remaining (call abs amount))
      (= a1 a2)
    )
  )
  (fn-do _ append-small-arc-cubic _
    (param center Point)
    (param radius Length)
    (param start-angle Radians)
    (param end-angle Radians)
    (let a (/ (- end-angle start-angle) 2.0))
    (blank)
    (let x4 (* radius (call cos a)))
    (let y4 (* radius (call sin a)))
    (let x1 x4)
    (let y1 (- y4))
    (blank)
    (let f (* (/ 4.0 3.0) (call tan (/ a 2.0))))
    (blank)
    (let x2 (+ x1 (* f y4)))
    (let y2 (+ y1 (* f x4)))
    (let x3 x2)
    (let y3 (- y2))
    (blank)
    (let ar (+ a start-angle))
    (let cos-ar (call cos ar))
    (let sin-ar (call sin ar))
    (blank)
    (let hox (+ (. center x) (- (* x2 cos-ar) (* y2 sin-ar))))
    (let hoy (+ (. center y) (+ (* x2 sin-ar) (* y2 cos-ar))))
    (let hix (+ (. center x) (- (* x3 cos-ar) (* y3 sin-ar))))
    (let hiy (+ (. center y) (+ (* x3 sin-ar) (* y3 cos-ar))))
    (let ax4 (+ (. center x) (* radius (call cos end-angle))))
    (let ay4 (+ (. center y) (* radius (call sin end-angle))))
    (call cubic-curve-to (call Point hox hoy) (call Point hix hiy) (call Point ax4 ay4))
  )
)

(fn-do + append-offset-cubic-split-inflections _
  (param writer OffsetPathWriter)
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (param distance Length)
  (param normal-sign Float)
  (let roots (call cubic-inflection-roots p0 p1 p2 p3))
  (let cusp (call cubic-cusp-parameter p0 p1 p2 p3))
  (if (and (> cusp offset-teeny) (< cusp (- 1 offset-teeny)))
    (+= roots cusp)
    (= roots (call sorted-unit-roots roots))
  )
  (let last-t PointOnCurve 0)
  (for (in root roots)
    (if (and (> root (+ last-t offset-teeny)) (< root (- 1 offset-teeny)))
      (let piece (call cubic-range-scalars (. p0 x) (. p0 y) (. p1 x) (. p1 y) (. p2 x) (. p2 y) (. p3 x) (. p3 y) last-t root))
      (call append-offset-cubic-recursive writer piece distance normal-sign 0)
      (= last-t root)
    )
  )
  (blank)
  (if (< last-t 1)
    (let piece (call cubic-range-scalars (. p0 x) (. p0 y) (. p1 x) (. p1 y) (. p2 x) (. p2 y) (. p3 x) (. p3 y) last-t 1))
    (call append-offset-cubic-recursive writer piece distance normal-sign 0)
  )
)

(fn-do + append-quadratic-as-cubic _
  (param writer OffsetPathWriter)
  (param p0 Point)
  (param control Point)
  (param p2 Point)
  (if (and (. writer has-last) (> (call (. writer last distance) p0) offset-teeny))
    (call (. writer line-to) p0)
    (else-if (not (. writer has-last))
      (call (. writer line-to) p0)
    )
  )
  (blank)
  (if (<= (call (. p0 distance) p2) offset-teeny)
    (call (. writer line-to) p2)
    (return)
  )
  (let c1 (+ p0 (* (- control p0) (/ 2.0 3.0))))
  (let c2 (+ p2 (* (- control p2) (/ 2.0 3.0))))
  (call (. writer cubic-curve-to) c1 c2 p2)
)

(fn-do + append-square-join _
  (param writer OffsetPathWriter)
  (param pivot Point)
  (param before-normal Point)
  (param after-normal Point)
  (param before-tangent Point)
  (param after-tangent Point)
  (param distance Length)
  (param is-line Bool)
  (let extent (call square-join-extent before-normal after-normal distance))
  (call (. writer line-to) (+ pivot (* before-normal distance) (* before-tangent extent)))
  (call (. writer line-to) (- (+ pivot (* after-normal distance)) (* after-tangent extent)))
  (if (not is-line)
    (call (. writer line-to) (+ pivot (* after-normal distance)))
  )
)

(fn-expr + square-join-extent Length
  (param before-normal Point)
  (param after-normal Point)
  (param distance Length)
  (* (call abs distance) (call tan (/ turn 4)))
  (where
    (lazy turn (call atan2 (call abs (call (. before-normal cross) after-normal)) (call (. before-normal dot) after-normal)))
  )
)

(fn-expr + offset-cubic-point _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (param t PointOnCurve)
  (param distance Length)
  (param normal-sign Float)
  (+ point (* normal distance))
  (where
    (lazy point (call cubic-point p0 p1 p2 p3 t))
    (lazy tangent (call cubic-tangent-at p0 p1 p2 p3 t))
    (lazy normal (call offset-unit-normal tangent normal-sign))
  )
)

(fn-expr + cubic-point _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (param t PointOnCurve)
  (call Point (. p x) (. p y))
  (where
    (lazy p (call cubic-evaluate-xy (. p0 x) (. p0 y) (. p1 x) (. p1 y) (. p2 x) (. p2 y) (. p3 x) (. p3 y) t))
  )
)

(fn-expr + cubic-tangent-at _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (param t PointOnCurve)
  (case? (> (. tangent length) offset-teeny)
    (call unit-vector tangent)
  )
  (case? (< t 0.5)
    (call first-nonzero-unit (- p1 p0) (- p2 p0) (- p3 p0))
  )
  (default
    (call first-nonzero-unit (- p3 p2) (- p3 p1) (- p3 p0))
  )
  (where
    (lazy d (call cubic-derivative-xy (. p0 x) (. p0 y) (. p1 x) (. p1 y) (. p2 x) (. p2 y) (. p3 x) (. p3 y) t))
    (lazy tangent (call Point (. d x) (. d y)))
  )
)

(fn-expr + unit-vector _
  (param point Point)
  (case? (<= length offset-teeny)
    (call Point 1 0)
  )
  (default
    (/ point length)
  )
  (where
    (lazy length (. point length))
  )
)

(fn-expr + offset-unit-normal _
  (param tangent Point)
  (param normal-sign Float)
  (call Point (* (. tangent y) normal-sign) (* (- (. tangent x)) normal-sign))
)

(fn-expr + stroke-unit-normal _
  (param tangent Point)
  (param normal-sign Float)
  (call offset-unit-normal tangent normal-sign)
)

(fn-expr + cubic-is-point-like _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (and handles-near (<= (call (. p0 distance) p3) offset-teeny))
  (where
    (lazy handles-near (and (<= (call (. p0 distance) p1) offset-teeny) (<= (call (. p0 distance) p2) offset-teeny)))
  )
)

(fn-expr + cubic-is-line-like _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (case? (<= (call (. p0 distance) p3) offset-teeny)
    (call cubic-is-point-like p0 p1 p2 p3)
  )
  (default
    (and p1-on-chord (<= (call point-line-distance p2 p0 p3) offset-curve-tolerance))
  )
  (where
    (lazy p1-on-chord (<= (call point-line-distance p1 p0 p3) offset-curve-tolerance))
  )
)

(fn-expr + cubic-is-chord-like _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (case? (<= (call (. p0 distance) p3) offset-teeny)
    (call cubic-is-point-like p0 p1 p2 p3)
  )
  (case? (<= (call point-segment-distance p1 p0 p3) offset-curve-tolerance)
    (<= (call point-segment-distance p2 p0 p3) offset-curve-tolerance)
  )
  (default
    false
  )
)

(fn-expr + cubic-inflection-roots _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (call sorted-unit-roots roots)
  (where
    (lazy cx (call cubic-coefficients-1d (. p0 x) (. p1 x) (. p2 x) (. p3 x)))
    (lazy cy (call cubic-coefficients-1d (. p0 y) (. p1 y) (. p2 y) (. p3 y)))
    (lazy a (call Point (. cx a) (. cy a)))
    (lazy b (call Point (. cx b) (. cy b)))
    (lazy c (call Point (. cx c) (. cy c)))
    (lazy roots (call quadratic-roots (* -3.0 (call (. a cross) b)) (* 3.0 (call (. c cross) a)) (call (. c cross) b) 0.000001))
  )
)

(fn-do + cubic-cusp-parameter _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (let cx (call cubic-coefficients-1d (. p0 x) (. p1 x) (. p2 x) (. p3 x)))
  (let cy (call cubic-coefficients-1d (. p0 y) (. p1 y) (. p2 y) (. p3 y)))
  (let xroots (call quadratic-roots (* 3.0 (. cx a)) (* 2.0 (. cx b)) (. cx c) 0.000001))
  (for (in root xroots)
    (if (and (> root offset-teeny) (< root (- 1 offset-teeny)))
      (let dy (+ (* (+ (* 3.0 (. cy a) root) (* 2.0 (. cy b))) root) (. cy c)))
      (if (<= (call abs dy) 0.0001)
        (return root)
      )
    )
  )
  (blank)
  (let yroots (call quadratic-roots (* 3.0 (. cy a)) (* 2.0 (. cy b)) (. cy c) 0.000001))
  (for (in root yroots)
    (if (and (> root offset-teeny) (< root (- 1 offset-teeny)))
      (let dx (+ (* (+ (* 3.0 (. cx a) root) (* 2.0 (. cx b))) root) (. cx c)))
      (if (<= (call abs dx) 0.0001)
        (return root)
      )
    )
  )
  (blank)
  (return -1)
)

(fn-expr + point-line-distance Length
  (param point Point)
  (param line-start Point)
  (param line-end Point)
  (case? (<= length offset-teeny)
    (call (. point distance) line-start)
  )
  (default
    (/ (call abs (call (. (- point line-start) cross) line)) length)
  )
  (where
    (lazy line (- line-end line-start))
    (lazy length (. line length))
  )
)

(fn-expr + point-segment-distance Length
  (param point Point)
  (param start Point)
  (param end Point)
  (call (. point distance) (call segment-foot point start end))
)

(fn-expr + segment-foot _
  (param point Point)
  (param start Point)
  (param end Point)
  (case? (<= length2 offset-teeny)
    start
  )
  (case? (< t 0)
    start
  )
  (case? (> t 1)
    end
  )
  (default
    (+ start (* segment t))
  )
  (where
    (lazy segment (- end start))
    (lazy length2 (+ (* (. segment x) (. segment x)) (* (. segment y) (. segment y))))
    (lazy t (/ (call (. (- point start) dot) segment) length2))
  )
)

(fn-do _ append-offset-cubic-recursive _
  (param writer OffsetPathWriter)
  (param curve CurveRangeScalars)
  (param distance Length)
  (param normal-sign Float)
  (param depth Int)
  (let p0 (call Point (. curve x1) (. curve y1)))
  (let p1 (call Point (. curve hox) (. curve hoy)))
  (let p2 (call Point (. curve hix) (. curve hiy)))
  (let p3 (call Point (. curve x2) (. curve y2)))
  (blank)
  (let q0 (call offset-cubic-point p0 p1 p2 p3 0 distance normal-sign))
  (let q2 (call offset-cubic-point p0 p1 p2 p3 1 distance normal-sign))
  (let mid (call offset-cubic-point p0 p1 p2 p3 0.5 distance normal-sign))
  (let q1 (- (* mid 2) (* (+ q0 q2) 0.5)))
  (let q25 (call quadratic-point q0 q1 q2 0.25))
  (let q75 (call quadratic-point q0 q1 q2 0.75))
  (let o25 (call offset-cubic-point p0 p1 p2 p3 0.25 distance normal-sign))
  (let o75 (call offset-cubic-point p0 p1 p2 p3 0.75 distance normal-sign))
  (let error (call max (call (. q25 distance) o25) (call (. q75 distance) o75)))
  (let fits (<= error offset-curve-tolerance))
  (let settled (and fits (not (and (. writer is-exact) (call cubic-turns-sharply p0 p1 p2 p3)))))
  (blank)
  (if (or settled (>= depth offset-recursive-limit) (call cubic-is-point-like p0 p1 p2 p3))
    (probe-count graphics.offset.curve-pieces)
    (if (. writer is-exact)
      (call append-offset-swing writer p0 q0 distance normal-sign)
    )
    (call (. writer originate) curve)
    (call append-quadratic-as-cubic writer q0 q1 q2)
    (return)
  )
  (probe-count graphics.offset.curve-splits)
  (let split (call cubic-subdivide-scalars (. p0 x) (. p0 y) (. p1 x) (. p1 y) (. p2 x) (. p2 y) (. p3 x) (. p3 y) 0.5))
  (call append-offset-cubic-recursive writer (. split left) distance normal-sign (+ depth 1))
  (call append-offset-cubic-recursive writer (. split right) distance normal-sign (+ depth 1))
)

(fn-do _ append-offset-swing _
  (param writer OffsetPathWriter)
  (param pivot Point)
  (param target Point)
  (param distance Length)
  (param normal-sign Float)
  (return-if (if (not (. writer has-last))))
  (blank)
  (let last (. writer last))
  (return-if (if (<= (call (. last distance) target) offset-curve-tolerance)))
  (return-if (if (> (call abs (- (call (. last distance) pivot) (call abs distance))) offset-curve-tolerance)))
  (blank)
  (let start (call (. last angle) pivot))
  (let end (call (. target angle) pivot))
  (let sweep (call normalize-offset-angle (- end start)))
  (let ccw (> sweep π))
  (if (<= (call abs (- sweep π)) (/ offset-curve-tolerance (call abs distance)))
    (= ccw (< (* distance normal-sign) 0))
  )
  (blank)
  (= (. writer origin)
    (call CurveRangeScalars
      (block
        (arg .segment-type-line)
        (arg (. pivot x))
        (arg (. pivot y))
        (arg (. pivot x))
        (arg (. pivot y))
        (arg (. pivot x))
        (arg (. pivot y))
        (arg (. pivot x))
        (arg (. pivot y))
      )
    )
  )
  (call (. writer arc) pivot (call abs distance) start end ccw)
)

(fn-expr _ cubic-turns-sharply _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (< (call (. start dot) end) offset-turn-cosine)
  (where
    (lazy start (call cubic-tangent-at p0 p1 p2 p3 0))
    (lazy end (call cubic-tangent-at p0 p1 p2 p3 1))
  )
)

(fn-expr _ first-nonzero-unit _
  (param a Point)
  (param b Point)
  (param c Point)
  (case? (> (. a length) offset-teeny)
    (call unit-vector a)
  )
  (case? (> (. b length) offset-teeny)
    (call unit-vector b)
  )
  (case? (> (. c length) offset-teeny)
    (call unit-vector c)
  )
  (default
    (call Point 1 0)
  )
)

(fn-expr _ quadratic-point _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param t PointOnCurve)
  (+ (* p0 (* u u)) (* p1 (* 2 u t)) (* p2 (* t t)))
  (where
    (lazy u (- 1 t))
  )
)

(fn-do _ quadratic-roots _
  (param a Float)
  (param b Float)
  (param c Float)
  (param epsilon Float)
  (let roots (list PointOnCurve))
  (if (< (call abs a) epsilon)
    (if (>= (call abs b) epsilon)
      (+= roots (/ (- c) b))
    )
    (return roots)
  )
  (blank)
  (let q (- (* b b) (* 4.0 a c)))
  (if (< q 0)
    (return roots)
  )
  (blank)
  (let sqrt-q (call sqrt q))
  (+= roots (/ (+ (- b) sqrt-q) (* 2.0 a)))
  (if (> sqrt-q epsilon)
    (+= roots (/ (- (- b) sqrt-q) (* 2.0 a)))
  )
  (return roots)
)

(fn-do _ sorted-unit-roots _
  (param roots (list PointOnCurve))
  (let out (list PointOnCurve))
  (for (in root roots)
    (if (and (> root offset-teeny) (< root (- 1 offset-teeny)))
      (if (not (. out length))
        (+= out root)
        (else-if (< root (- ([] out 0) offset-teeny))
          (call (. out insert) root 0)
        )
        (else-if (> root (+ ([] out (- (. out length) 1)) offset-teeny))
          (+= out root)
        )
      )
    )
  )
  (return out)
)

(fn-do _ normalize-offset-angle _
  (param angle Radians)
  (while (< angle 0)
    (+= angle (* π 2))
  )
  (while (>= angle (* π 2))
    (-= angle (* π 2))
  )
  (blank)
  (return angle)
)
