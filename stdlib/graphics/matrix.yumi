
` Based on Matrix from Paper.js. Gracias, amigos!

./point
./primitives
./utils
/core/animatable
/math

━━━━━━━━━━━━━━━━━━━━
+ Matrix is Tuple
    is Animatable

+ a Coord
+ c Coord
+ b Coord
+ d Coord
+ tx Coord
+ ty Coord

────────────────────
+ This

= matrix-from-identity()

────────────────────
+ This
    - vector [F64]

. turn = vector[2] as Radians
. width = vector[3]
. height = vector[4]
. shear = vector[5] * height
. cosa = cos(turn)
. sina = sin(turn)
= This
    - cosa * width
    - sina * width
    - cosa * shear - sina * height
    - sina * shear + cosa * height
    - vector[0]
    - vector[1]

────────────────────
+ get is-translation

a == 1 && b == 0 && c == 0 && d == 1

────────────────────
+ to String

"[[$a, $b, $tx], [$c, $d, $ty]]"

────────────────────
+ get translation

Point(tx, ty)

────────────────────
+ get scaling

Dimensions(x, y)

.. x = if a < 0 then -hor else hor
.. y = if b < 0 then -ver else ver
.. hor = sqrt(a * a + c * c)
.. ver = sqrt(b * b + d * d)

────────────────────
+ get rotation Radians?

|? abs(angle1 - angle2) < tolerance
    angle1

.. angle1 = -atan2(b, d)
.. angle2 = atan2(c, a)

────────────────────
+ get determinant

|? is-finite(det) && abs(det) > epsilon && is-finite(tx) && is-finite(ty)
    det

.. det = a * d - b * c

────────────────────
+ get is-identity

a == 1 && c == 0 && b == 0 && d == 1 && tx == 0 && ty == 0

────────────────────
+ get is-invertible

!!determinant

────────────────────
+ get is-singular

!determinant

────────────────────
+ this == other Matrix

a == other.a && b == other.b && c == other.c && d == other.d && tx == other.tx && ty == other.ty

────────────────────
+ do scale @inline
    - size Dimensions

//graphics.matrix.transforms ++
= Matrix
    - a * size.width
    - c * size.width
    - b * size.height
    - d * size.height
    - tx
    - ty

────────────────────
+ do translate @inline
    - pt Point

//graphics.matrix.transforms ++
= Matrix
    - a
    - c
    - b
    - d
    - tx + pt.x * a + pt.y * b
    - ty + pt.x * c + pt.y * d

────────────────────
+ do rotate
    - angle Radians
    - center Point

//graphics.matrix.transforms ++
= concatenate(matrix-from-rotation(angle, center))

────────────────────
+ do shear
    - size Dimensions

//graphics.matrix.transforms ++
= Matrix
    - a + size.height * b
    - c + size.height * d
    - b + size.width * a
    - d + size.width * c
    - tx
    - ty

────────────────────
+ do concatenate @inline
    - other Matrix

//graphics.matrix.compositions ++
= Matrix
    - other.a * a + other.c * b
    - other.a * c + other.c * d
    - other.b * a + other.d * b
    - other.b * c + other.d * d
    - tx + other.tx * a + other.ty * b
    - ty + other.tx * c + other.ty * d

────────────────────
+ do pre-concatenate
    - other Matrix

//graphics.matrix.compositions ++
= Matrix
    - other.a * a + other.b * c
    - other.c * a + other.d * c
    - other.a * b + other.b * d
    - other.c * b + other.d * d
    - other.a * tx + other.b * ty + other.tx
    - other.c * tx + other.d * ty + other.ty

────────────────────
+ do invert
    - det Coord

//graphics.matrix.inversions ++
= Matrix
    - d / det
    - -c / det
    - -b / det
    - a / det
    - (b * ty - d * tx) / det
    - (c * tx - a * ty) / det

────────────────────
+ do transform @inline
    - pt Point

//graphics.matrix.point-transforms ++
= Point
    - pt.x * a + pt.y * b + tx
    - pt.x * c + pt.y * d + ty

────────────────────
+ inverse-transform
    - pt Point

//graphics.matrix.point-transforms ++
|? det
    inverted

.. inverted = Point
    - (x * d - y * b) / det
    - (y * a - x * c) / det
.. det = determinant
.. x = pt.x - tx
.. y = pt.y - ty

────────────────────
+ do transform
    - bounds Rect

//graphics.matrix.rect-transforms ++
. left = bounds.x
. top = bounds.y
. right = bounds.right
. bottom = bounds.bottom
. x0 = left * a + top * b + tx
. y0 = left * c + top * d + ty
. x1 = right * a + top * b + tx
. y1 = right * c + top * d + ty
. x2 = right * a + bottom * b + tx
. y2 = right * c + bottom * d + ty
. x3 = left * a + bottom * b + tx
. y3 = left * c + bottom * d + ty
. min-x = min(min(x0, x1), min(x2, x3))
. min-y = min(min(y0, y1), min(y2, y3))
. max-x = max(max(x0, x1), max(x2, x3))
. max-y = max(max(y0, y1), max(y2, y3))
= Rect(min-x, min-y, max-x - min-x, max-y - min-y)

────────────────────
+ do transform-coordinates
    - src
    - src-off Int
    - dst
    - dst-off Int
    - num-pts Int

//graphics.matrix.bulk-transforms ++
//graphics.matrix.bulk-points += num-pts
. i = src-off
. j = dst-off
. src-end = src-off + 2 * num-pts
while i < src-end
    . x = src[i]
    i += 1
    . y = src[i]
    i += 1
    dst[j] = x * a + y * b + tx
    j += 1
    dst[j] = x * c + y * d + ty
    j += 1

= dst

────────────────────
+ transform-corners
    - rect Rect

transform-coordinates(coords, 0, coords, 0, 4)

.. coords = rect.corners

────────────────────
+ inverse-transform
    - bounds Rect

|? pt1 && pt2
    Rect(pt1.x, pt1.y, pt2.x - pt1.x, pt2.y - pt1.y)

.. pt1 = inverse-transform(bounds.top-left)
.. pt2 = inverse-transform(bounds.bottom-right)

────────────────────
+ create-inverse

//graphics.matrix.inversions ++
|? det
    invert(det)

.. det = determinant

────────────────────
+ create-shiftless

Matrix(a, c, b, d, 0, 0)

╌╌╌╌╌╌╌╌╌╌ is Animatable ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get motion-vector [F64]

|? width == 0
    [tx as F64, ty as F64, 0, 0, d as F64, if d == 0 then 0 else b / d]
??
    [tx as F64, ty as F64, angle, width as F64, height as F64, if height == 0 then 0 else slant]

.. angle = atan2(c, a) as F64
.. width = sqrt(a * a + c * c)
.. height = (a * d - b * c) / width
.. shear = (a * b + c * d) / width
.. slant = shear / height

━━━━━━━━━━━━━━━━━━━━
+ matrix-from-identity

Matrix(1, 0, 0, 1, 0, 0)

━━━━━━━━━━━━━━━━━━━━
+ matrix-from-scale
    - size Dimensions

Matrix(size.width, 0, 0, size.height, 0, 0)

━━━━━━━━━━━━━━━━━━━━
+ matrix-from-translation
    - point Point

Matrix(1, 0, 0, 1, point.x, point.y)

━━━━━━━━━━━━━━━━━━━━
+ matrix-from-shear
    - size Dimensions

Matrix(1, size.height, size.width, 1, 0, 0)

━━━━━━━━━━━━━━━━━━━━
+ matrix-from-rotation
    - angle Radians
    - center Point

Matrix
    - cosa
    - sina
    - -sina
    - cosa
    - center.x - center.x * cosa + center.y * sina
    - center.y - center.x * sina - center.y * cosa

.. cosa = cos(angle)
.. sina = sin(angle)
