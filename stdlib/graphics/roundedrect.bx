(import ./canvas)
(import ./primitives)

(type + RoundedRect (is Tuple)
  (prop + bounds Rect)
  (prop + left Length)
  (prop + top Length)
  (prop + right Length)
  (prop + bottom Length)
  (fn-expr + is-rounded Bool :get
    (and (or (> left 0) (> right 0)) (or (> top 0) (> bottom 0)))
  )
  (fn-do + outline _
    (param canvas Canvas)
    (let k 0.5522847498307936)
    (let x (. bounds left))
    (let y (. bounds top))
    (let r (. bounds right))
    (let b (. bounds bottom))
    (call (. canvas move) (+ x left) y)
    (call (. canvas line) (- r right) y)
    (call (. canvas curve) (+ (- r right) (* right k)) y r (- (+ y top) (* top k)) r (+ y top))
    (call (. canvas line) r (- b bottom))
    (call (. canvas curve) r (+ (- b bottom) (* bottom k)) (+ (- r right) (* right k)) b (- r right) b)
    (call (. canvas line) (+ x left) b)
    (call (. canvas curve) (- (+ x left) (* left k)) b x (+ (- b bottom) (* bottom k)) x (- b bottom))
    (call (. canvas line) x (+ y top))
    (call (. canvas curve) x (- (+ y top) (* top k)) (- (+ x left) (* left k)) y (+ x left) y)
    (call (. canvas enclose))
  )
  (fn-do + clip _
    (param canvas Canvas)
    (if (and is-rounded (> (. bounds width) 0) (> (. bounds height) 0))
      (call (. canvas begin))
      (call outline canvas)
      (call (. canvas clip-path))
      (else
        (call (. canvas clip) bounds)
      )
    )
  )
)
