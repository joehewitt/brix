+ region Index
+ fill RGBA?
+ conflict Bool

━━━━━━━━━━━━━━━━━━━━
_ NetworkGraphicMutationObserver is NetworkMutationObserver

+ owner NetworkGraphic

────────────────────
+ This
    - owner

────────────────────
+ do network-mutated
    - network VectorNetwork
    - revision Size

owner.network-mutated(network, revision)

━━━━━━━━━━━━━━━━━━━━
+ NetworkGraphic is GraphicNode

_ drawing-network VectorNetwork
_ network-observer NetworkGraphicMutationObserver?
_ region-workspace = NetworkRegionWorkspace()
_ region-appearances [NetworkRegionAppearance]
_ geometry-network VectorNetwork?
_ network-geometry-revision Size
_ geometry-path Path?
_ region-revision Size

────────────────────
+ This

network-observer = NetworkGraphicMutationObserver(this)
drawing-network.subscribe(network-observer!)

────────────────────
+ This
    - network VectorNetwork

network-observer = NetworkGraphicMutationObserver(this)
drawing-network = network
drawing-network.subscribe(network-observer!)

────────────────────
+ get network

drawing-network

────────────────────
+ do network = value VectorNetwork

=? if drawing-network as Pointer == value as Pointer
drawing-network.unsubscribe(network-observer!)
drawing-network = value
drawing-network.subscribe(network-observer!)
region-workspace.clear()
region-appearances.clear()
region-revision = 0
geometry-network = null
geometry-path = null
changed(graphic-change-source /or/ graphic-change-geometry)

────────────────────
+ do get appearances [NetworkRegionAppearance]

for appearance in region-appearances
    <= appearance

────────────────────
+ do appearances = values [NetworkRegionAppearance]

region-appearances.clear()
for appearance in values
    region-appearances += appearance
region-revision = drawing-network.revision
changed(graphic-change-appearance)

────────────────────
+ do copy NetworkGraphic
    - preserve-id Bool = false

sync-regions()
. result = NetworkGraphic(network.copy())
copy-state-to(result, preserve-id)
result.region-workspace = region-workspace.copy-for(result.network)
result.region-revision = region-revision
for appearance in region-appearances
    result.region-appearances += appearance
= result

────────────────────
+ do network-mutated
    - network VectorNetwork
    - revision Size

. ignored = revision
=? if network as Pointer != drawing-network as Pointer
changed(graphic-change-source /or/ graphic-change-geometry)

╌╌╌╌╌╌╌╌╌╌ is GraphicNode ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do draw <Path>

<= geometry()

────────────────────
+ get vector-geometry-source-compact

super.vector-geometry-source-compact && !has-region-appearances

────────────────────
+ do paint-content
    - canvas Canvas
    - appearance VectorAppearance
    - outer-effects VectorEffects?

if has-region-appearances
    do use canvas.saved-state
        for region in sync-regions().regions
            . appearance = appearance-for(region.id)
            canvas.fill-color = appearance.fill
            canvas.stroke-color = null
            if appearance.fill
                region.path.outline(canvas)
super.paint-content(canvas, appearance, outer-effects)

────────────────────
+ do geometry Path

if geometry-network && geometry-network as Pointer == drawing-network as Pointer
    if network-geometry-revision == drawing-network.revision && geometry-path
        = geometry-path
geometry-path = drawing-network.geometry()
geometry-network = drawing-network
network-geometry-revision = drawing-network.revision
= geometry-path!

────────────────────
+ get has-region-appearances Bool

some(region-appearances) • where each.fill || each.conflict

────────────────────
+ do sync-regions NetworkRegions

. regions = region-workspace.resolve(drawing-network)
=? regions if region-revision == drawing-network.revision
. updated [NetworkRegionAppearance]
for region in regions.regions
    . fill RGBA?
    . seen = false
    . conflict = false
    for id in region.predecessors
        . prior = appearance-for(id)
        if !seen
            fill = prior.fill
            seen = true
        else if fill != prior.fill
            conflict = true
        conflict = conflict || prior.conflict
    if !region.predecessors.length
        . prior = appearance-for(region.id)
        fill = prior.fill
        conflict = prior.conflict
    if conflict
        fill = null
    updated += NetworkRegionAppearance(region.id, fill, conflict)
region-appearances = updated
region-revision = drawing-network.revision
= regions

────────────────────
+ do appearance-for NetworkRegionAppearance
    - id Index

for appearance in region-appearances
    =? appearance if appearance.region == id
= NetworkRegionAppearance(id, null)

────────────────────
+ do paint-region Bool
    - point Point
    - color RGBA

. region = sync-regions().pick(point)
=? false if !region
. previous = appearance-for(region.id)
. next RGBA? = color
if previous.fill == color && !previous.conflict
    next = null
for i in 0 .. < region-appearances.length
    if region-appearances[i].region == region.id
        region-appearances[i] = NetworkRegionAppearance(region.id, next)
        changed(graphic-change-appearance)
        = true
region-appearances += NetworkRegionAppearance(region.id, next)
changed(graphic-change-appearance)
= true

────────────────────
+ do hit Bool
    - position Point
    - tolerance Coord = 7

for vertex in drawing-network.vertices
    =? true if vertex.position.distance(position) <= tolerance
. stroke-reach = max
    - ($stroke-width ?? 2) / 2
    - vector-appearance-over(this, VectorAppearance()).stroke-extent
= drawing-network.pick(position, tolerance + stroke-reach) != null

────────────────────
+ fill-hit Bool
    - position Point
    - appearance VectorAppearance

appearance.paints-fill && geometry().contains(position, appearance.fill-rule)

────────────────────
+ painted-hit Bool
    - position Point

region != null && appearance-for(region.id).fill != null

.. region = sync-regions().pick(position)
