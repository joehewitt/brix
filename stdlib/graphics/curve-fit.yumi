./point
./primitives
./vector
/math
/stream/sort

_ curve-fit-depth Index = 12
_ curve-fit-corner-angle = 0.7
_ curve-fit-corner-sharpness = 0.7

━━━━━━━━━━━━━━━━━━━━
+ CurveFitter is Tuple

+ tolerance Length
+ reach Index

────────────────────
+ do fit [PathOp]
    - points [Point]
    - known [Index]
    - closed Bool

. count = points.length
. ops = List'PathOp()
. corners = corner-marks(points, known, closed)
if !closed
    . marks = List'Index()
    marks += 0
    for corner in corners
        if corner > 0 && corner < count - 1
            marks += corner
    marks += count - 1
    ops += M(points[0].x, points[0].y)
    for index in 1 .. < marks.length
        fit-piece(points, marks[index - 1], marks[index], false, ops)
    = ops
. shift = if corners then corners[0] else 0
. ring = List'Point()
for index in 0 .. < count
    ring += points[(index + shift) % count]
ring += ring[0]
. marks = List'Index()
marks += 0
if corners
    for index in 1 .. < corners.length
        marks += corners[index] - shift
else
    marks += count / 2
marks += count
ops += M(ring[0].x, ring[0].y)
for index in 1 .. < marks.length
    fit-piece(ring, marks[index - 1], marks[index], !corners, ops)
ops += Z()
= ops

────────────────────
_ do corner-marks [Index]
    - points [Point]
    - known [Index]
    - closed Bool

. count = points.length
. found = List'Index(known)
if count >= reach * 2 + 1
    . angles = F64[count]
    for index in 0 .. < count
        if closed || (index >= reach && index + reach < count)
            angles[index] = fit-bend(points, index, reach, closed)
    for index in 0 .. < count
        . angle = angles[index]
        if angle > curve-fit-corner-angle && is-peak(angles, index, closed)
            . wide-ok = closed || (index >= reach * 2 && index + reach * 2 < count)
            . wide = if wide-ok && count > reach * 4 then wide-bend else angle
                .. wide-bend = fit-bend(points, index, reach * 2, closed)
            if angle >= wide * curve-fit-corner-sharpness
                found += index
. ordered = sort(found)
. marks = List'Index()
for mark in ordered
    if !marks || mark > marks[marks.length - 1] + 1
        marks += mark
= marks

────────────────────
_ do is-peak Bool
    - angles F64[]
    - index Index
    - closed Bool

. count = angles.size
. angle = angles[index]
for offset in 1 .. < reach + 1
    . before = polyline-index(index, -(offset as Int), count, closed)
    . after = polyline-index(index, offset, count, closed)
    if angles[before] >= angle || angles[after] > angle
        = false
= true

────────────────────
_ do fit-piece
    - points [Point]
    - first Index
    - last Index
    - smooth Bool
    - ops [PathOp]

if last - first < 2
    ops += L(points[last].x, points[last].y)
    =
if fit-is-straight(points, first, last, tolerance * 0.5)
    ops += L(points[last].x, points[last].y)
    =
. span = min(reach, last - first)
. left = if smooth then through(points, first, span) else first-direction
    .. first-direction = fit-direction(points[first], points[first + span])
. right = if smooth then through(points, last, span) * -1.0 else last-direction
    .. last-direction = fit-direction(points[last], points[last - span])
fit-span(points, first, last, left, right, ops, 0)

────────────────────
_ through Point
    - ring [Point]
    - index Index
    - span Index

fit-direction(ring[(index + count - span) % count], ring[(index + span) % count])

.. count = ring.length - 1

────────────────────
_ do fit-span
    - points [Point]
    - first Index
    - last Index
    - left Point
    - right Point
    - ops [PathOp]
    - level Index

. start = points[first]
. finish = points[last]
if last - first < 2
    . gap = start.distance(finish) / 3
    ops += fit-segment(FitCubic(start, start + left * gap, finish + right * gap, finish), tolerance)
    =
. params = fit-chord-params(points, first, last)
. curve = fit-bezier(points, first, last, params, left, right)
. worst = fit-worst(points, first, last, curve, params)
. limit = tolerance * tolerance
if worst.error > limit && worst.error < limit * 16
    for attempt in 0 .. < 4
        params = fit-newton(points, first, curve, params)
        curve = fit-bezier(points, first, last, params, left, right)
        worst = fit-worst(points, first, last, curve, params)
        if worst.error <= limit
            break
if worst.error <= limit || level >= curve-fit-depth
    ops += fit-segment(curve, tolerance)
    =
. split = worst.index
. center = fit-direction(points[split + 1], points[split - 1])
fit-span(points, first, split, left, center, ops, level + 1)
fit-span(points, split, last, center * -1.0, right, ops, level + 1)

━━━━━━━━━━━━━━━━━━━━
+ polyline-index Index
    - index Index
    - delta Int
    - count Size
    - closed Bool

if closed then wrapped as Index else clamped as Index

.. moved = (index as Int) + delta
.. total = count as Int
.. wrapped = ((moved % total) + total) % total
.. clamped = clamp(moved, 0, total - 1)

━━━━━━━━━━━━━━━━━━━━
+ turn-angle F64
    - incoming Point
    - outgoing Point

if lengths <= 0 then 0.0 else acos(clamp(incoming.dot(outgoing) / lengths, -1.0, 1.0))

.. lengths = incoming.length * outgoing.length

━━━━━━━━━━━━━━━━━━━━
_ FitMiss is Tuple

+ error F64
+ index Index

━━━━━━━━━━━━━━━━━━━━
_ FitCubic is Tuple

+ a Point
+ b Point
+ c Point
+ d Point

────────────────────
+ at Point
    - t F64

a * (s * s * s) + b * (3 * s * s * t) + c * (3 * s * t * t) + d * (t * t * t)

.. s = 1 - t

────────────────────
+ slope Point
    - t F64

(b - a) * (3 * s * s) + (c - b) * (6 * s * t) + (d - c) * (3 * t * t)

.. s = 1 - t

────────────────────
+ bend Point
    - t F64

(c - b * 2 + a) * (6 * (1 - t)) + (d - c * 2 + b) * (6 * t)

━━━━━━━━━━━━━━━━━━━━
_ fit-bend F64
    - points [Point]
    - index Index
    - reach Index
    - closed Bool

turn-angle(point - back, ahead - point)

.. count = points.length
.. point = points[index]
.. back = points[polyline-index(index, -(reach as Int), count, closed)]
.. ahead = points[polyline-index(index, reach, count, closed)]

━━━━━━━━━━━━━━━━━━━━
_ fit-direction Point
    - from Point
    - to Point

if length <= 0 then Point(1, 0) else along / length

.. along = to - from
.. length = along.length

━━━━━━━━━━━━━━━━━━━━
_ fit-off-line F64
    - point Point
    - from Point
    - to Point

if span <= 0 then point.distance(from) else point.distance(from + along * t)

.. along = to - from
.. span = along.dot(along)
.. t = clamp((point - from).dot(along) / span, 0.0, 1.0)

━━━━━━━━━━━━━━━━━━━━
_ do fit-is-straight Bool
    - points [Point]
    - first Index
    - last Index
    - limit Length

for index in first + 1 .. < last
    if fit-off-line(points[index], points[first], points[last]) > limit
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ fit-segment PathOp
    - curve FitCubic
    - tolerance Length

if straight then L(curve.d.x, curve.d.y) else cubic

.. limit = tolerance * 0.25
.. straight = b-on-line && fit-off-line(curve.c, curve.a, curve.d) < limit
.. b-on-line = fit-off-line(curve.b, curve.a, curve.d) < limit
.. cubic = C(curve.b.x, curve.b.y, curve.c.x, curve.c.y, curve.d.x, curve.d.y)

━━━━━━━━━━━━━━━━━━━━
_ do fit-chord-params F64[]
    - points [Point]
    - first Index
    - last Index

. params = F64[last - first + 1]
for index in first + 1 .. < last + 1
    params[index - first] = params[index - first - 1] + points[index].distance(points[index - 1])
. total = params[last - first]
if total > 0
    for index in 0 .. < params.size
        params[index] = params[index] / total
= params

━━━━━━━━━━━━━━━━━━━━
_ do fit-bezier FitCubic
    - points [Point]
    - first Index
    - last Index
    - params F64[]
    - left Point
    - right Point

. start = points[first]
. finish = points[last]
. c00 = 0.0
. c01 = 0.0
. c11 = 0.0
. x0 = 0.0
. x1 = 0.0
for index in 0 .. < params.size
    . t = params[index]
    . s = 1 - t
    . b0 = s * s * s
    . b1 = 3 * t * s * s
    . b2 = 3 * t * t * s
    . b3 = t * t * t
    . a0 = left * b1
    . a1 = right * b2
    c00 += a0.dot(a0)
    c01 += a0.dot(a1)
    c11 += a1.dot(a1)
    . rest = points[first + index] - (start * (b0 + b1) + finish * (b2 + b3))
    x0 += a0.dot(rest)
    x1 += a1.dot(rest)
. det = c00 * c11 - c01 * c01
. gap = start.distance(finish)
. lead = if abs(det) > 0.000000000001 then (x0 * c11 - x1 * c01) / det else 0.0
. trail = if abs(det) > 0.000000000001 then (c00 * x1 - c01 * x0) / det else 0.0
if lead < gap * 0.000001 || trail < gap * 0.000001 || lead > gap * 2 || trail > gap * 2
    lead = gap / 3
    trail = gap / 3
= FitCubic(start, start + left * lead, finish + right * trail, finish)

━━━━━━━━━━━━━━━━━━━━
_ do fit-worst FitMiss
    - points [Point]
    - first Index
    - last Index
    - curve FitCubic
    - params F64[]

. error = 0.0
. index = (first + last) / 2
for offset in 1 .. < last - first
    . miss = curve.at(params[offset]) - points[first + offset]
    . distance = miss.dot(miss)
    if distance >= error
        error = distance
        index = first + offset
= FitMiss(error, index)

━━━━━━━━━━━━━━━━━━━━
_ do fit-newton F64[]
    - points [Point]
    - first Index
    - curve FitCubic
    - params F64[]

. next = F64[params.size]
for index in 0 .. < params.size
    . t = params[index]
    . miss = curve.at(t) - points[first + index]
    . slope = curve.slope(t)
    . denominator = slope.dot(slope) + miss.dot(curve.bend(t))
    next[index] = if abs(denominator) > 0.000000000001 then stepped else t
        .. stepped = clamp(t - miss.dot(slope) / denominator, 0.0, 1.0)
= next
