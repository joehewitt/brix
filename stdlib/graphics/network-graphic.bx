(import ./appearance)
(import ./canvas)
(import ./color)
(import ./effect)
(import ./graphic)
(import ./network)
(import ./network-regions)
(import ./path)
(import ./point)
(import ./primitives)
(import ./style)
(import /math)
(import /stream/aggregate)
(import /units)

(type + NetworkRegionAppearance (is Tuple)
  (prop + region Index)
  (prop + fill (? RGBA))
  (prop + conflict Bool)
)

(type _ NetworkGraphicMutationObserver (is NetworkMutationObserver)
  (prop + owner NetworkGraphic)
  (fn-do + This _
    (param owner _)
  )
  (fn-do + network-mutated _
    (param network VectorNetwork)
    (param revision Size)
    (call (. owner network-mutated) network revision)
  )
)

(type + NetworkGraphic (is GraphicNode)
  (prop _ drawing-network VectorNetwork)
  (prop _ network-observer (? NetworkGraphicMutationObserver))
  (prop _ region-workspace _ (= (call NetworkRegionWorkspace)))
  (prop _ region-appearances (list NetworkRegionAppearance))
  (prop _ geometry-network (? VectorNetwork))
  (prop _ network-geometry-revision Size)
  (prop _ geometry-path (? Path))
  (prop _ region-revision Size)
  (fn-do + This _
    (= network-observer (call NetworkGraphicMutationObserver this))
    (call (. drawing-network subscribe) (!! network-observer))
  )
  (fn-do + This _
    (param network VectorNetwork)
    (= network-observer (call NetworkGraphicMutationObserver this))
    (= drawing-network network)
    (call (. drawing-network subscribe) (!! network-observer))
  )
  (fn-expr + network _ :get
    drawing-network
  )
  (fn-do + network _ :set (param value VectorNetwork)
    (return-if (if (== (as drawing-network Pointer) (as value Pointer))))
    (call (. drawing-network unsubscribe) (!! network-observer))
    (= drawing-network value)
    (call (. drawing-network subscribe) (!! network-observer))
    (call (. region-workspace clear))
    (call (. region-appearances clear))
    (= region-revision 0)
    (= geometry-network null)
    (= geometry-path null)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + appearances (list NetworkRegionAppearance) :get
    (for (in appearance region-appearances)
      (yield appearance)
    )
  )
  (fn-do + appearances _ :set (param values (list NetworkRegionAppearance))
    (call (. region-appearances clear))
    (for (in appearance values)
      (+= region-appearances appearance)
    )
    (= region-revision (. drawing-network revision))
    (call changed graphic-change-appearance)
  )
  (fn-do + copy NetworkGraphic
    (param preserve-id Bool (= false))
    (call sync-regions)
    (let result (call NetworkGraphic (call (. network copy))))
    (call copy-state-to result preserve-id)
    (= (. result region-workspace) (call (. region-workspace copy-for) (. result network)))
    (= (. result region-revision) region-revision)
    (for (in appearance region-appearances)
      (+= (. result region-appearances) appearance)
    )
    (return result)
  )
  (fn-do + network-mutated _
    (param network VectorNetwork)
    (param revision Size)
    (let ignored revision)
    (return-if (if (!= (as network Pointer) (as drawing-network Pointer))))
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (yield (call geometry))
  )
  (fn-expr + vector-geometry-source-compact _ :get
    (and (. super vector-geometry-source-compact) (not has-region-appearances))
  )
  (fn-do + paint-content _
    (param canvas Canvas)
    (param appearance VectorAppearance)
    (param outer-effects (? VectorEffects))
    (if has-region-appearances
      (do-use (. canvas saved-state)
        (for (in region (. (call sync-regions) regions))
          (let appearance (call appearance-for (. region id)))
          (= (. canvas fill-color) (. appearance fill))
          (= (. canvas stroke-color) null)
          (if (. appearance fill)
            (call (. region path outline) canvas)
          )
        )
      )
    )
    (call (. super paint-content) canvas appearance outer-effects)
  )
  (fn-do + geometry Path
    (if (and geometry-network (== (as geometry-network Pointer) (as drawing-network Pointer)))
      (if (and (== network-geometry-revision (. drawing-network revision)) geometry-path)
        (return geometry-path)
      )
    )
    (= geometry-path (call (. drawing-network geometry)))
    (= geometry-network drawing-network)
    (= network-geometry-revision (. drawing-network revision))
    (return (!! geometry-path))
  )
  (fn-expr + has-region-appearances Bool :get
    (call some region-appearances (:where (or (. each fill) (. each conflict))))
  )
  (fn-do + sync-regions NetworkRegions
    (let regions (call (. region-workspace resolve) drawing-network))
    (return-if regions (if (== region-revision (. drawing-network revision))))
    (let updated (list NetworkRegionAppearance))
    (for (in region (. regions regions))
      (let fill (? RGBA))
      (let seen false)
      (let conflict false)
      (for (in id (. region predecessors))
        (let prior (call appearance-for id))
        (if (not seen)
          (= fill (. prior fill))
          (= seen true)
          (else-if (!= fill (. prior fill))
            (= conflict true)
          )
        )
        (= conflict (or conflict (. prior conflict)))
      )
      (if (not (. region predecessors length))
        (let prior (call appearance-for (. region id)))
        (= fill (. prior fill))
        (= conflict (. prior conflict))
      )
      (if conflict
        (= fill null)
      )
      (+= updated (call NetworkRegionAppearance (. region id) fill conflict))
    )
    (= region-appearances updated)
    (= region-revision (. drawing-network revision))
    (return regions)
  )
  (fn-do + appearance-for NetworkRegionAppearance
    (param id Index)
    (for (in appearance region-appearances)
      (return-if appearance (if (== (. appearance region) id)))
    )
    (return (call NetworkRegionAppearance id null))
  )
  (fn-do + paint-region Bool
    (param point Point)
    (param color RGBA)
    (let region (call (. (call sync-regions) pick) point))
    (return-if false (if (not region)))
    (let previous (call appearance-for (. region id)))
    (let next (? RGBA) color)
    (if (and (== (. previous fill) color) (not (. previous conflict)))
      (= next null)
    )
    (for (in i (..< 0 (. region-appearances length)))
      (if (== (. ([] region-appearances i) region) (. region id))
        (= ([] region-appearances i) (call NetworkRegionAppearance (. region id) next))
        (call changed graphic-change-appearance)
        (return true)
      )
    )
    (+= region-appearances (call NetworkRegionAppearance (. region id) next))
    (call changed graphic-change-appearance)
    (return true)
  )
  (fn-do + hit Bool
    (param position Point)
    (param tolerance Coord (= 7))
    (for (in vertex (. drawing-network vertices))
      (return-if true (if (<= (call (. vertex position distance) position) tolerance)))
    )
    (let stroke-reach
      (call max
        (block
          (arg (/ (?? $stroke-width 2) 2))
          (arg (. (call vector-appearance-over this (call VectorAppearance)) stroke-extent))
        )
      )
    )
    (return (!= (call (. drawing-network pick) position (+ tolerance stroke-reach)) null))
  )
  (fn-expr + fill-hit Bool
    (param position Point)
    (param appearance VectorAppearance)
    (and (. appearance paints-fill) (call (. (call geometry) contains) position (. appearance fill-rule)))
  )
  (fn-expr + painted-hit Bool
    (param position Point)
    (and (!= region null) (!= (. (call appearance-for (. region id)) fill) null))
    (where
      (lazy region (call (. (call sync-regions) pick) position))
    )
  )
)
