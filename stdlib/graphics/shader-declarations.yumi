./color
./image
./shader

_ shader-layouts := Map'String'ShaderLayout()

━━━━━━━━━━━━━━━━━━━━
+ FrameTime is Tuple

━━━━━━━━━━━━━━━━━━━━
+ ShaderDeclaration

+ frame-rate F64? = 30

────────────────────
+ ¶ metal

────────────────────
+ get entry-input String

""

────────────────────
+ get entry-result String

""

────────────────────
+ get leading-args Size

0

────────────────────
+ get entry-size String

"layer.size"

━━━━━━━━━━━━━━━━━━━━
+ FillShader is ShaderDeclaration

────────────────────
+ get entry-input

"float2 size"

────────────────────
+ get entry-size

"size"

────────────────────
+ get entry-result

"return fill(position, size, values);"

────────────────────
+ do to ShaderFill

. layout = shader-layout(this)
= ShaderFill
    - layout.shader
    - packed-args(this, layout)
    - layout.is-live
    - frame-rate
    - 0
    - layout.arg-kinds

