(import ./canvas)
(import ./color)
(import ./graphic)
(import ./matrix)
(import ./path)
(import ./point)
(import ./primitives)
(import ./shapes)
(import /math)

(type + PathMoveTo (alias M) (is (tuple (: x Coord) (: y Coord))))

(type + PathLineTo (alias L) (is (tuple (: x Coord) (: y Coord))))

(type + PathCubicTo (alias C) (is (tuple (: c1x Coord) (: c1y Coord) (: c2x Coord) (: c2y Coord) (: x Coord) (: y Coord))))

(type + PathQuadraticTo (alias Q) (is (tuple (: cx Coord) (: cy Coord) (: x Coord) (: y Coord))))

(type + PathArcTo (alias A) (is (tuple (: rx Coord) (: ry Coord) (: rotation Degrees) (: large Bool) (: sweep Bool) (: x Coord) (: y Coord))))

(type + PathClose (alias Z) (is Tuple))

(type + PathOp (is Union)
  (variant PathMoveTo)
  (variant PathLineTo)
  (variant PathCubicTo)
  (variant PathQuadraticTo)
  (variant PathArcTo)
  (variant PathClose)
)

(type + VectorPath (is GraphicNode)
  (prop _ vector-path-ops (list PathOp))
  (fn-do + This _)
  (fn-do + This _
    (param d _)
    (= vector-path-ops d)
  )
  (fn-do + d (list PathOp) :get
    (for (in op vector-path-ops)
      (yield op)
    )
  )
  (fn-do + d _ :set (param value (list PathOp))
    (let next (list PathOp))
    (for (in op value)
      (+= next op)
    )
    (= vector-path-ops next)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + operations (stream PathOp) :get
    (for (in op vector-path-ops)
      (yield op)
    )
  )
  (fn-expr + vector-path-geometry (? Path)
    (call vector-path vector-path-ops)
  )
  (fn-do + (infix this += (param op PathOp)) _
    (+= vector-path-ops op)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + clear _
    (return-if (if (not vector-path-ops)))
    (call (. vector-path-ops clear))
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (let path (call vector-path-geometry))
    (if path
      (yield path)
    )
  )
)

(type + Circle (is GraphicNode)
  (prop _ circle-center Point)
  (prop _ circle-radius Length)
  (fn-do + This _
    (param center Point)
    (param radius Length)
    (= circle-center center)
    (= circle-radius radius)
  )
  (fn-expr + center Point :get
    circle-center
  )
  (fn-do + center _ :set (param value Point)
    (return-if (if (== circle-center value)))
    (= circle-center value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + radius Length :get
    circle-radius
  )
  (fn-do + radius _ :set (param value Length)
    (return-if (if (== circle-radius value)))
    (= circle-radius value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (yield (call circle circle-center (call abs circle-radius)))
  )
)

(type + Ellipse (is GraphicNode)
  (prop _ ellipse-center Point)
  (prop _ ellipse-radius Dimensions)
  (fn-do + This _
    (param center _)
    (param radius _)
    (= ellipse-center center)
    (= ellipse-radius radius)
  )
  (fn-expr + center Point :get
    ellipse-center
  )
  (fn-do + center _ :set (param value Point)
    (return-if (if (== ellipse-center value)))
    (= ellipse-center value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + radius Dimensions :get
    ellipse-radius
  )
  (fn-do + radius _ :set (param value Dimensions)
    (return-if (if (== ellipse-radius value)))
    (= ellipse-radius value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (let shape (call ellipse ellipse-center (call Dimensions (call abs (. ellipse-radius width)) (call abs (. ellipse-radius height)))))
    (yield shape)
  )
)

(type + Rectangle (is GraphicNode)
  (prop _ rectangle-rect Rect)
  (fn-do + This _
    (param rect _)
    (= rectangle-rect rect)
  )
  (fn-expr + rect Rect :get
    rectangle-rect
  )
  (fn-do + rect _ :set (param value Rect)
    (return-if (if (== rectangle-rect value)))
    (= rectangle-rect value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (yield (call rectangle rectangle-rect))
  )
)

(type + Line (is GraphicNode)
  (prop _ line-start Point)
  (prop _ line-end Point)
  (fn-do + This _
    (param start _)
    (param end _)
    (= line-start start)
    (= line-end end)
  )
  (fn-expr + start Point :get
    line-start
  )
  (fn-do + start _ :set (param value Point)
    (return-if (if (== line-start value)))
    (= line-start value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + end Point :get
    line-end
  )
  (fn-do + end _ :set (param value Point)
    (return-if (if (== line-end value)))
    (= line-end value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (yield (call line line-start line-end))
  )
)

(type + Square (is GraphicNode)
  (prop _ square-center Point)
  (prop _ square-radius _ (= 1px))
  (fn-do + This _
    (param center _)
    (param radius _)
    (= square-center center)
    (= square-radius radius)
  )
  (fn-expr + center Point :get
    square-center
  )
  (fn-do + center _ :set (param value Point)
    (return-if (if (== square-center value)))
    (= square-center value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + radius Length :get
    square-radius
  )
  (fn-do + radius _ :set (param value Length)
    (return-if (if (== square-radius value)))
    (= square-radius value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (yield
      (call square corner (* square-radius 2)
        (block
          (lazy corner (call Point (- (. square-center x) square-radius) (- (. square-center y) square-radius)))
        )
      )
    )
  )
)

(type + Polygon (is GraphicNode)
  (prop _ polygon-sides U32)
  (prop _ polygon-center Point)
  (prop _ polygon-radius _ (= 1px))
  (fn-do + This _
    (param sides U32)
    (param center Point)
    (param radius Length)
    (= polygon-sides sides)
    (= polygon-center center)
    (= polygon-radius radius)
  )
  (fn-expr + sides U32 :get
    polygon-sides
  )
  (fn-do + sides _ :set (param value U32)
    (return-if (if (== polygon-sides value)))
    (= polygon-sides value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + center Point :get
    polygon-center
  )
  (fn-do + center _ :set (param value Point)
    (return-if (if (== polygon-center value)))
    (= polygon-center value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + radius Length :get
    polygon-radius
  )
  (fn-do + radius _ :set (param value Length)
    (return-if (if (== polygon-radius value)))
    (= polygon-radius value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (yield (call polygon polygon-sides (* polygon-radius 2) polygon-center))
  )
)

(type + Spiral (is GraphicNode)
  (prop _ spiral-center Point)
  (prop _ spiral-radius _ (= 10px))
  (prop _ spiral-coils Float (= 10))
  (prop _ spiral-chord _ (= 1px))
  (prop _ spiral-rotation Radians (= 0))
  (fn-expr + center Point :get
    spiral-center
  )
  (fn-do + center _ :set (param value Point)
    (return-if (if (== spiral-center value)))
    (= spiral-center value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + radius Length :get
    spiral-radius
  )
  (fn-do + radius _ :set (param value Length)
    (return-if (if (== spiral-radius value)))
    (= spiral-radius value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + coils Float :get
    spiral-coils
  )
  (fn-do + coils _ :set (param value Float)
    (return-if (if (== spiral-coils value)))
    (= spiral-coils value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + chord Length :get
    spiral-chord
  )
  (fn-do + chord _ :set (param value Length)
    (return-if (if (== spiral-chord value)))
    (= spiral-chord value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + rotation Radians :get
    spiral-rotation
  )
  (fn-do + rotation _ :set (param value Radians)
    (return-if (if (== spiral-rotation value)))
    (= spiral-rotation value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (yield (call spiral spiral-center spiral-radius spiral-coils spiral-chord spiral-rotation))
  )
)

(type + SineWave (is GraphicNode)
  (prop _ sine-start Radians)
  (prop _ sine-waves Float (= 2))
  (prop _ sine-origin Point)
  (prop _ sine-size Dimensions)
  (fn-expr + start Radians :get
    sine-start
  )
  (fn-do + start _ :set (param value Radians)
    (return-if (if (== sine-start value)))
    (= sine-start value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + waves Float :get
    sine-waves
  )
  (fn-do + waves _ :set (param value Float)
    (return-if (if (== sine-waves value)))
    (= sine-waves value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + origin Point :get
    sine-origin
  )
  (fn-do + origin _ :set (param value Point)
    (return-if (if (== sine-origin value)))
    (= sine-origin value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + size Dimensions :get
    sine-size
  )
  (fn-do + size _ :set (param value Dimensions)
    (return-if (if (== sine-size value)))
    (= sine-size value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (let path (call Path))
    (let period (* (* π 2) sine-waves))
    (let amplitude Coord (. sine-size height))
    (let resolution Length 5.0)
    (let steps (/ (. sine-size width) resolution))
    (let increment (/ period steps))
    (let angle Radians sine-start)
    (for (in x (..< (. sine-origin x) (+ (. sine-origin x) (. sine-size width)) (by: resolution)))
      (let y (+ (. sine-origin y) (* (call sin angle) amplitude)))
      (+= angle increment)
      (call (. path line-to) x y)
    )
    (yield path)
  )
)

(type + Leaf (is GraphicNode)
  (prop _ leaf-center Point)
  (prop _ leaf-radius _ (= (call Dimensions 1 1)))
  (fn-expr + center Point :get
    leaf-center
  )
  (fn-do + center _ :set (param value Point)
    (return-if (if (== leaf-center value)))
    (= leaf-center value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-expr + radius Dimensions :get
    leaf-radius
  )
  (fn-do + radius _ :set (param value Dimensions)
    (return-if (if (== leaf-radius value)))
    (= leaf-radius value)
    (call changed (/or/ graphic-change-source graphic-change-geometry))
  )
  (fn-do + draw (stream Path)
    (yield (call leaf leaf-center leaf-radius))
  )
)

(fn-do + vector-path (? Path)
  (param ops (list PathOp))
  (return-if (if (not ops)))
  (blank)
  (probe-count gui.vector.geometry-parses)
  (let path (call Path))
  (let has-current false)
  (let current (call Point 0 0))
  (let subpath-start (call Point 0 0))
  (for (in op ops)
    (if (is op PathMoveTo)
      (let move (as op PathMoveTo))
      (= current (call Point (. move x) (. move y)))
      (= subpath-start current)
      (= has-current true)
      (call (. path move-to) current)
      (else-if (is op PathLineTo)
        (let segment (as op PathLineTo))
        (call vector-require-current has-current)
        (= current (call Point (. segment x) (. segment y)))
        (call (. path line-to) current)
      )
      (else-if (is op PathCubicTo)
        (let curve (as op PathCubicTo))
        (call vector-require-current has-current)
        (= current (call Point (. curve x) (. curve y)))
        (call (. path cubic-curve-to) (tuple (. curve c1x) (. curve c1y)) (tuple (. curve c2x) (. curve c2y)) current)
      )
      (else-if (is op PathQuadraticTo)
        (let curve (as op PathQuadraticTo))
        (call vector-require-current has-current)
        (= current (call Point (. curve x) (. curve y)))
        (call (. path quadratic-curve-to) (. curve cx) (. curve cy) (. current x) (. current y))
      )
      (else-if (is op PathArcTo)
        (let arc (as op PathArcTo))
        (call vector-require-current has-current)
        (call vector-append-arc path current arc)
        (= current (call Point (. arc x) (. arc y)))
      )
      (else
        (call vector-require-current has-current)
        (call (. path close))
        (= current subpath-start)
      )
    )
  )
  (return path)
)

(fn-do _ vector-require-current _
  (param has-current Bool)
  (throw (call Panic "Vector path operation requires a current point") (if (not has-current)))
)

(fn-do _ vector-append-arc _
  (param path Path)
  (param start Point)
  (param arc PathArcTo)
  (let end (call Point (. arc x) (. arc y)))
  (return-if (if (== start end)))
  (blank)
  (let rx (call abs (. arc rx)))
  (let ry (call abs (. arc ry)))
  (if (or (== rx 0) (== ry 0))
    (call (. path line-to) end)
    (return)
  )
  (blank)
  (let phi (as (. arc rotation) Radians))
  (let cos-phi (call cos phi))
  (let sin-phi (call sin phi))
  (let half-dx (/ (- (. start x) (. end x)) 2))
  (let half-dy (/ (- (. start y) (. end y)) 2))
  (let x1p (+ (* cos-phi half-dx) (* sin-phi half-dy)))
  (let y1p (+ (* (- sin-phi) half-dx) (* cos-phi half-dy)))
  (blank)
  (let radius-scale (+ (/ (* x1p x1p) (* rx rx)) (/ (* y1p y1p) (* ry ry))))
  (if (> radius-scale 1)
    (let correction (call sqrt radius-scale))
    (*= rx correction)
    (*= ry correction)
  )
  (blank)
  (let rx2 (* rx rx))
  (let ry2 (* ry ry))
  (let x1p2 (* x1p x1p))
  (let y1p2 (* y1p y1p))
  (let denominator (+ (* rx2 y1p2) (* ry2 x1p2)))
  (let numerator (- (* rx2 ry2) denominator))
  (let sign Float 1)
  (if (== (. arc large) (. arc sweep))
    (= sign -1)
  )
  (let coefficient (* sign (call sqrt (call max 0 (/ numerator denominator)))))
  (let cxp (* coefficient (/ (* rx y1p) ry)))
  (let cyp (* coefficient (/ (* (- ry) x1p) rx)))
  (let cx (+ (- (* cos-phi cxp) (* sin-phi cyp)) (/ (+ (. start x) (. end x)) 2)))
  (let cy (+ (* sin-phi cxp) (* cos-phi cyp) (/ (+ (. start y) (. end y)) 2)))
  (blank)
  (let ux (/ (- x1p cxp) rx))
  (let uy (/ (- y1p cyp) ry))
  (let vx (/ (- (- x1p) cxp) rx))
  (let vy (/ (- (- y1p) cyp) ry))
  (let theta (call atan2 uy ux))
  (let delta (call vector-angle ux uy vx vy))
  (if (and (not (. arc sweep)) (> delta 0))
    (-= delta (* 2 π))
    (else-if (and (. arc sweep) (< delta 0))
      (+= delta (* 2 π))
    )
  )
  (blank)
  (let segment-count (as (call ceil (/ (call abs delta) (/ π 2))) Size))
  (let segment-delta (/ delta segment-count))
  (let segment Index 0)
  (while (< segment segment-count)
    (let a1 (+ theta (* segment-delta segment)))
    (let a2 (+ a1 segment-delta))
    (let alpha (* (/ 4.0 3.0) (call tan (/ (- a2 a1) 4.0))))
    (let p1 (call vector-ellipse-point cx cy rx ry cos-phi sin-phi a1))
    (let p2 (call vector-ellipse-point cx cy rx ry cos-phi sin-phi a2))
    (if (== (+ segment 1) segment-count)
      (= p2 end)
    )
    (let d1 (call vector-ellipse-derivative rx ry cos-phi sin-phi a1))
    (let d2 (call vector-ellipse-derivative rx ry cos-phi sin-phi a2))
    (call (. path cubic-curve-to) (+ p1 (* d1 alpha)) (- p2 (* d2 alpha)) p2)
    (+= segment 1)
  )
)

(fn-expr _ vector-angle Radians
  (param ux Coord)
  (param uy Coord)
  (param vx Coord)
  (param vy Coord)
  (call atan2 (- (* ux vy) (* uy vx)) (+ (* ux vx) (* uy vy)))
)

(fn-expr _ vector-ellipse-point Point
  (param cx Coord)
  (param cy Coord)
  (param rx Length)
  (param ry Length)
  (param cos-phi Float)
  (param sin-phi Float)
  (param angle Radians)
  (call Point (- (+ cx (* cos-phi x)) (* sin-phi y)) (+ cy (* sin-phi x) (* cos-phi y)))
  (where
    (lazy x (* rx (call cos angle)))
    (lazy y (* ry (call sin angle)))
  )
)

(fn-expr _ vector-ellipse-derivative Point
  (param rx Length)
  (param ry Length)
  (param cos-phi Float)
  (param sin-phi Float)
  (param angle Radians)
  (call Point (- (* cos-phi x) (* sin-phi y)) (+ (* sin-phi x) (* cos-phi y)))
  (where
    (lazy x (* (- rx) (call sin angle)))
    (lazy y (* ry (call cos angle)))
  )
)
