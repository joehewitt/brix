(import ./curve)
(import ./curve-kernels)
(import ./effect)
(import ./intersection)
(import ./path)
(import ./point)
(import ./primitives)
(import ./shapes)
(import ./utils)
(import /math)
(import /stream/aggregate)
(import /units)
(blank)
(prop _ boolean-touch-distance _ (= 0.00000001))
(prop _ boolean-endpoint-parameter _ (= 0.000000001))
(prop _ golden-ratio _ (= 0.6180339887498949))

(type + BooleanEffectMode (is U8)
  (variant union-effect)
  (variant subtract-effect)
  (variant intersect-effect)
)

(type + BooleanEffect (is VectorEffect)
  (prop + mode _ (=> effect-mode))
  (blank)
  (prop _ effect-mode BooleanEffectMode (= .union-effect))
  (fn-do + This _)
  (fn-do + This _
    (param value BooleanEffectMode)
    (= effect-mode value)
  )
  (fn-expr + combines-geometry _ :get
    true
  )
  (fn-expr + equals Bool
    (param other VectorEffect)
    (and (is other BooleanEffect) (== enabled (. other enabled)) (== mode (. (as other BooleanEffect) mode)))
  )
  (fn-do + apply (list Path)
    (param source (list Path))
    (let output (list Path))
    (return-if output (if (not (. source length))))
    (blank)
    (let result (call Path ([] source 0)))
    (if (== (. source length) 1)
      (if (. result count)
        (+= output result)
      )
      (return output)
    )
    (let out (call Path))
    (let workspace (use (call BooleanWorkspace)))
    (for (in i (..< 1 (. source length)))
      (let combined (? Path))
      (if (== mode .union-effect)
        (= combined (call boolean-union-reusing out workspace result ([] source i)))
        (else-if (== mode .subtract-effect)
          (= combined (call boolean-subtract-reusing out workspace result ([] source i)))
        )
        (else
          (= combined (call boolean-intersect-reusing out workspace result ([] source i)))
        )
      )
      (if (not combined)
        (call (. out clear))
      )
      (let previous result)
      (= result out)
      (= out previous)
    )
    (if (. result count)
      (+= output result)
    )
    (return output)
  )
  (fn-expr + copy _
    (call BooleanEffect effect-mode)
  )
)

(type + BooleanWorkspace
  (implements (of Usable Void))
  ; Caller-owned storage for repeated boolean queries. Output is written into a caller-owned Path.
  ; A workspace is single-call-owned: nested or concurrent operations must use distinct instances.
  (prop + growth-count Size)
  (prop + clear-count Size)
  (blank)
  (prop _ in-use _ (= false))
  (prop _ intersection-workspace _ (= (call IntersectionWorkspace)))
  (prop _ intersections (list CurveIntersection))
  (prop _ self-intersections1 (list CurveIntersection))
  (prop _ self-intersections2 (list CurveIntersection))
  (prop _ hits (list CurveIntersection))
  (prop _ bounds1 (list Rect))
  (prop _ bounds2 (list Rect))
  (prop _ class-spans1 (list BooleanClassSpan))
  (prop _ class-spans2 (list BooleanClassSpan))
  (prop _ contour-bounds1 (list Rect))
  (prop _ contour-bounds2 (list Rect))
  (prop _ subpath-spans (list PathSubpathSpan))
  (prop _ empty-path _ (= (call Path)))
  (prop _ spans1 (list BooleanOutputSpan))
  (prop _ spans2 (list BooleanOutputSpan))
  (prop _ splits (list PointOnCurve))
  (prop _ edges (list BooleanSpanEdge))
  (prop _ edge-count Size)
  (prop _ contour-edges (list BooleanSpanEdge))
  (prop _ flat1 _ (= (call Path)))
  (prop _ flat2 _ (= (call Path)))
  (prop _ points1 (list Point))
  (prop _ points2 (list Point))
  (prop _ line-splits (list Float))
  (prop _ line-edges (list BooleanEdge))
  (prop _ line-edge-count Size)
  (prop _ rect-subpaths (list PathSubpathSpan))
  (prop _ rect-pieces (list Rect))
  (prop _ rect-next (list Rect))
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + retained-capacity Size :get
    (let capacity (. intersection-workspace retained-capacity))
    (+= capacity (+ (. intersections capacity) (. hits capacity) (. bounds1 capacity) (. bounds2 capacity)))
    (+= capacity (+ (. self-intersections1 capacity) (. self-intersections2 capacity)))
    (+= capacity (+ (. class-spans1 capacity) (. class-spans2 capacity)))
    (+= capacity (+ (* (. contour-bounds1 capacity) 4) (* (. contour-bounds2 capacity) 4) (. subpath-spans capacity)))
    (+= capacity (+ (. spans1 capacity) (. spans2 capacity) (. splits capacity)))
    (+= capacity (+ (. edges capacity) (* (. edges length) 12) (. contour-edges capacity)))
    (+= capacity (+ (. flat1 command-capacity) (. flat1 coord-capacity)))
    (+= capacity (+ (. flat2 command-capacity) (. flat2 coord-capacity)))
    (+= capacity (+ (* (. points1 capacity) 2) (* (. points2 capacity) 2)))
    (+= capacity (+ (. line-splits capacity) (. line-edges capacity) (* (. line-edges length) 4)))
    (+= capacity (+ (. rect-subpaths capacity) (* (. rect-pieces capacity) 4) (* (. rect-next capacity) 4)))
    (return capacity)
  )
  (fn-expr + retained-bytes Size :get
    (* retained-capacity 8)
  )
  (fn-do + clear _
    (call clear-boolean-intersections intersections)
    (call clear-boolean-intersections self-intersections1)
    (call clear-boolean-intersections self-intersections2)
    (call clear-boolean-intersections hits)
    (call (. bounds1 clear))
    (call (. bounds2 clear))
    (call (. class-spans1 clear))
    (call (. class-spans2 clear))
    (call (. contour-bounds1 clear))
    (call (. contour-bounds2 clear))
    (call clear-boolean-subpath-spans this)
    (call (. spans1 clear))
    (call (. spans2 clear))
    (call (. splits clear))
    (for (in index (..< 0 edge-count))
      (let edge ([] edges index))
      (= (. edge source) (call empty-boolean-class-span))
      (= (. edge used) false)
    )
    (= edge-count 0)
    (call (. contour-edges clear))
    (call (. flat1 clear))
    (call (. flat2 clear))
    (call (. points1 clear))
    (call (. points2 clear))
    (call (. line-splits clear))
    (for (in index (..< 0 line-edge-count))
      (let edge ([] line-edges index))
      (= (. edge start) (call Point 0 0))
      (= (. edge end) (call Point 0 0))
      (= (. edge used) false)
    )
    (= line-edge-count 0)
    (for (in index (..< 0 (. rect-subpaths length)))
      (= ([] rect-subpaths index) (call PathSubpathSpan (. flat1 commands) 0 0 0 false))
    )
    (call (. rect-subpaths clear))
    (call (. rect-pieces clear))
    (call (. rect-next clear))
    (call (. intersection-workspace clear))
    (+= clear-count 1)
    (probe-count graphics.geometry.scratch.clears)
  )
  (fn-do + trim _
    (throw (call Panic "Cannot trim a boolean workspace while it is in use") (if in-use))
    (blank)
    (call clear)
    (call (. intersection-workspace trim))
    (call (. intersections trim))
    (call (. self-intersections1 trim))
    (call (. self-intersections2 trim))
    (call (. hits trim))
    (call (. bounds1 trim))
    (call (. bounds2 trim))
    (call (. class-spans1 trim))
    (call (. class-spans2 trim))
    (call (. contour-bounds1 trim))
    (call (. contour-bounds2 trim))
    (call (. subpath-spans trim))
    (call (. spans1 trim))
    (call (. spans2 trim))
    (call (. splits trim))
    (call (. edges trim))
    (call (. contour-edges trim))
    (call (. flat1 trim))
    (call (. flat2 trim))
    (call (. points1 trim))
    (call (. points2 trim))
    (call (. line-splits trim))
    (call (. line-edges trim))
    (call (. rect-subpaths trim))
    (call (. rect-pieces trim))
    (call (. rect-next trim))
  )
  (fn-do + release _
    (throw (call Panic "Cannot release a boolean workspace while it is in use") (if in-use))
    (blank)
    (call clear)
    (call (. intersection-workspace release))
    (call (. intersections release))
    (call (. self-intersections1 release))
    (call (. self-intersections2 release))
    (call (. hits release))
    (call (. bounds1 release))
    (call (. bounds2 release))
    (call (. class-spans1 release))
    (call (. class-spans2 release))
    (call (. contour-bounds1 release))
    (call (. contour-bounds2 release))
    (call (. subpath-spans release))
    (call (. spans1 release))
    (call (. spans2 release))
    (call (. splits release))
    (call (. edges release))
    (call (. contour-edges release))
    (call (. flat1 release))
    (call (. flat2 release))
    (call (. points1 release))
    (call (. points2 release))
    (call (. line-splits release))
    (call (. line-edges release))
    (call (. rect-subpaths release))
    (call (. rect-pieces release))
    (call (. rect-next release))
  )
)

(fn-do + boolean-union-reusing (? Path)
  (param out Path)
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (return (call boolean-operation-reusing out workspace path1 path2 .boolean-union-operation))
)

(fn-do + boolean-subtract-reusing (? Path)
  (param out Path)
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (return (call boolean-operation-reusing out workspace path1 path2 .boolean-subtract-operation))
)

(fn-do + boolean-intersect-reusing (? Path)
  (param out Path)
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (return (call boolean-operation-reusing out workspace path1 path2 .boolean-intersect-operation))
)

(fn-do + boolean-clip-reusing (? Path)
  (param out Path)
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (return (call boolean-operation-reusing out workspace path1 path2 .boolean-clip-operation))
)

(fn-expr + union _
  (param path1 Path)
  (param path2 Path)
  (call boolean-union-reusing out workspace path1 path2)
  (where
    (lazy out (call Path))
    (lazy workspace (use (call BooleanWorkspace)))
  )
)

(fn-expr + subtract _
  (param path1 Path)
  (param path2 Path)
  (call boolean-subtract-reusing out workspace path1 path2)
  (where
    (lazy out (call Path))
    (lazy workspace (use (call BooleanWorkspace)))
  )
)

(fn-expr + intersect _
  (param path1 Path)
  (param path2 Path)
  (call boolean-intersect-reusing out workspace path1 path2)
  (where
    (lazy out (call Path))
    (lazy workspace (use (call BooleanWorkspace)))
  )
)

(fn-expr + clip _
  (param path1 Path)
  (param path2 Path)
  (call boolean-clip-reusing out workspace path1 path2)
  (where
    (lazy out (call Path))
    (lazy workspace (use (call BooleanWorkspace)))
  )
)

(fn-do + rect-intersection _
  (param a Rect)
  (param b Rect)
  (return-if (if (<= right left)))
  (return-if (if (<= bottom top)))
  (blank)
  (return (call Rect left top (- right left) (- bottom top)))
  (blank)
  (lazy left (call max (. a left) (. b left)))
  (lazy top (call max (. a top) (. b top)))
  (lazy right (call min (. a right) (. b right)))
  (lazy bottom (call min (. a bottom) (. b bottom)))
)

(fn-expr + subtract-rect _
  (param a Rect)
  (param b Rect)
  (if-expr overlap (call subtract-overlap-rect a overlap) (call rectangle a))
  (where
    (lazy overlap (call rect-intersection a b))
  )
)

(fn-do + subtract-overlap-rect _
  (param a Rect)
  (param overlap Rect)
  (let path (call Path))
  (call (. path move-to) (. a left) (. a top))
  (call (. path line-to) (. a right) (. a top))
  (call (. path line-to) (. a right) (. overlap top))
  (call (. path line-to) (. overlap left) (. overlap top))
  (call (. path line-to) (. overlap left) (. a bottom))
  (call (. path line-to) (. a left) (. a bottom))
  (call (. path close))
  (return path)
)

(type _ BooleanOperation
  (variant boolean-union-operation)
  (variant boolean-subtract-operation)
  (variant boolean-intersect-operation)
  (variant boolean-clip-operation)
)

(type _ BooleanEdge
  (prop + start Point)
  (prop + end Point)
  (prop + used _ (= false))
  (fn-do + This _
    (param start Point)
    (param end Point)
  )
)

(type _ BooleanSpanEdge
  (prop + start-x Coord)
  (prop + start-y Coord)
  (prop + end-x Coord)
  (prop + end-y Coord)
  (prop + source BooleanClassSpan)
  (prop + t1 PointOnCurve)
  (prop + t2 PointOnCurve)
  (prop + path-number Index)
  (prop + curve-index Index)
  (prop + reverse _ (= false))
  (prop + used _ (= false))
  (prop + closes _ (= false))
  (fn-do + This _
    (param start-x Coord)
    (param start-y Coord)
    (param end-x Coord)
    (param end-y Coord)
    (param source BooleanClassSpan)
    (param t1 PointOnCurve)
    (param t2 PointOnCurve)
    (param is-reverse _ (= false))
    (= reverse is-reverse)
  )
)

(type _ BooleanOutputSpan (is Tuple)
  (prop + source BooleanClassSpan)
  (prop + index Index)
  (prop + t1 PointOnCurve)
  (prop + t2 PointOnCurve)
  (prop + sample-x Coord)
  (prop + sample-y Coord)
)

(type _ BooleanRayWinding (is Tuple)
  (prop + left Int)
  (prop + right Int)
  (prop + touches Bool)
)

(type _ BooleanClassSpan (is Tuple)
  (prop + type SegmentType)
  (prop + x1 Coord)
  (prop + y1 Coord)
  (prop + hox Coord)
  (prop + hoy Coord)
  (prop + hix Coord)
  (prop + hiy Coord)
  (prop + x2 Coord)
  (prop + y2 Coord)
  (prop + bounds Rect)
  (prop + contour Index)
)

(fn-do _ boolean-operation-reusing (? Path)
  (param out Path)
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (param operation BooleanOperation)
  (throw (call Panic "Boolean workspace is already in use") (if (. workspace in-use)))
  (blank)
  (let capacity-before (. workspace retained-capacity))
  (= (. workspace in-use) true)
  (let completed false)
  (finally
    (if (not completed)
      (call (. out clear))
      (call (. workspace clear))
    )
    (let capacity-after (. workspace retained-capacity))
    (if (> capacity-after capacity-before)
      (+= (. workspace growth-count) 1)
      (probe-count graphics.geometry.scratch.growth)
    )
    (probe-count graphics.geometry.scratch.retained-capacity capacity-after)
    (= (. workspace in-use) false)
  )
  (blank)
  (call (. out clear))
  (call (. workspace clear))
  (call curve-arrangement-boolean-reusing
    (block
      (arg out)
      (arg workspace)
      (arg (call filled-outline path1))
      (arg (call filled-outline path2))
      (arg operation)
    )
  )
  (call (. workspace clear))
  (= completed true)
  (return out)
)

(fn-do _ filled-outline _
  (param path Path)
  (return-if path (if (. path is-closed)))
  (return-if path (if (and (< (. path curve-count) 2) (not (call has-cubics path)))))
  (blank)
  (let outline (call Path))
  (for (in subpath (. path subpaths))
    (let contour (call (. subpath materialize)))
    (if (> (. contour count) 1)
      (call (. contour close))
      (call (. outline add-path) contour)
    )
  )
  (return outline)
)

(fn-expr _ empty-boolean-class-span _
  (call BooleanClassSpan .segment-type-line 0 0 0 0 0 0 0 0 (call Rect 0 0 0 0) 0)
)

(fn-do _ clear-boolean-intersections _
  (param intersections (list CurveIntersection))
  (for (in index (..< 0 (. intersections length)))
    (= ([] intersections index) (call CurveIntersection 0 0 null null))
  )
  (call (. intersections clear))
)

(fn-do _ append-rect-subtract _
  (param result (list Rect))
  (param rect Rect)
  (param cutter Rect)
  (let overlap (call rect-intersection rect cutter))
  (if (not overlap)
    (+= result rect)
    (return)
  )
  (let o overlap)
  (call append-nonempty-rect result (call Rect (. rect left) (. rect top) (. rect width) (- (. o top) (. rect top))))
  (call append-nonempty-rect result (call Rect (. rect left) (. o bottom) (. rect width) (- (. rect bottom) (. o bottom))))
  (call append-nonempty-rect result (call Rect (. rect left) (. o top) (- (. o left) (. rect left)) (. o height)))
  (call append-nonempty-rect result (call Rect (. o right) (. o top) (- (. rect right) (. o right)) (. o height)))
)

(fn-do _ append-nonempty-rect _
  (param result (list Rect))
  (param rect Rect)
  (if (and (> (. rect width) tolerance) (> (. rect height) tolerance))
    (+= result rect)
  )
)

(fn-do _ append-rects-to-path _
  (param path Path)
  (param rects (list Rect))
  (for (in rect rects)
    (call append-rect-to-path path rect)
  )
)

(fn-do _ append-rect-to-path _
  (param path Path)
  (param rect Rect)
  (return-if (if (<= (. rect width) tolerance)))
  (return-if (if (<= (. rect height) tolerance)))
  (blank)
  (call (. path move-to) (. rect left) (. rect top))
  (call (. path line-to) (. rect right) (. rect top))
  (call (. path line-to) (. rect right) (. rect bottom))
  (call (. path line-to) (. rect left) (. rect bottom))
  (call (. path close))
)

(fn-do _ curve-arrangement-boolean-reusing _
  (param out Path)
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (param operation BooleanOperation)
  (let area1 (and (. path1 is-closed) (> (. path1 curve-count) 0)))
  (let area2 (and (. path2 is-closed) (> (. path2 curve-count) 0)))
  (if (or (not area1) (not area2))
    (if (and area1 (!= operation .boolean-intersect-operation) (!= operation .boolean-clip-operation))
      (call (. out add-path) path1)
    )
    (if (and area2 (== operation .boolean-union-operation))
      (call (. out add-path) path2)
    )
    (return)
  )
  (if (and (not (call has-cubics path1)) (not (call has-cubics path2)))
    (if (or (== operation .boolean-intersect-operation) (== operation .boolean-clip-operation))
      (let rect1 (call axis-rect path1))
      (let rect2 (call axis-rect path2))
      (if (and rect1 rect2)
        (let overlap (call rect-intersection rect1 rect2))
        (if overlap
          (call (. out append-rectangle) overlap)
        )
        (return)
      )
    )
    (return-if (if (call line-polygon-boolean-reusing out workspace path1 path2 operation)))
    (return-if (if (call axis-rect-list-boolean-reusing out workspace path1 path2 operation)))
  )
  (blank)
  (let path-bounds1 (. path1 bounding-box))
  (let path-bounds2 (. path2 bounding-box))
  (if (call bounds-are-apart path-bounds1 path-bounds2 operation)
    (call append-disjoint-boolean out path1 path2 operation)
    (return)
  )
  (blank)
  (probe-count graphics.boolean.segments (+ (. path1 curve-count) (. path2 curve-count)))
  (call append-boolean-classifier-spans workspace (. workspace class-spans1) path1)
  (call append-boolean-classifier-spans workspace (. workspace class-spans2) path2)
  (let single-contour (and (call is-single-contour path1) (call is-single-contour path2)))
  (if (and (not single-contour) (call boolean-contours-apart workspace operation))
    (call append-disjoint-boolean out path1 path2 operation)
    (return)
  )
  (blank)
  (call collect-curve-arrangement-intersections-reusing workspace path1 path2)
  (if single-contour
    (if (not (. workspace intersections))
      (call curve-no-crossing-boolean-reusing out workspace path1 path2 operation)
      (return)
    )
    (else
      (call collect-contour-crossings-reusing
        (block
          (arg workspace)
          (arg (. workspace self-intersections1))
          (arg (. workspace class-spans1))
          (arg path1)
        )
      )
      (call collect-contour-crossings-reusing
        (block
          (arg workspace)
          (arg (. workspace self-intersections2))
          (arg (. workspace class-spans2))
          (arg path2)
        )
      )
    )
  )
  (blank)
  (return-if (if (call arrange-boolean-reusing out workspace (. path1 is-clockwise) operation true)))
  (blank)
  (call (. out clear))
  (call flattened-boolean-reusing out workspace path1 path2 operation)
)

(fn-do _ arrange-boolean-reusing _
  (param out Path)
  (param workspace BooleanWorkspace)
  (param interior-left Bool)
  (param operation BooleanOperation)
  (param strict Bool)
  (call append-boolean-arrangement-spans
    (block
      (arg (. workspace spans1))
      (arg (. workspace splits))
      (arg (. workspace class-spans1))
      (arg (. workspace intersections))
      (arg (. workspace self-intersections1))
      (arg 1)
    )
  )
  (call append-boolean-arrangement-spans
    (block
      (arg (. workspace spans2))
      (arg (. workspace splits))
      (arg (. workspace class-spans2))
      (arg (. workspace intersections))
      (arg (. workspace self-intersections2))
      (arg 2)
    )
  )
  (call reset-boolean-span-edges workspace)
  (call append-curve-span-fragments-reusing workspace (. workspace spans1) operation 1 interior-left)
  (call append-curve-span-fragments-reusing workspace (. workspace spans2) operation 2 interior-left)
  (return (call build-boolean-span-path-reusing out workspace strict))
)

(fn-do _ append-disjoint-boolean _
  (param out Path)
  (param path1 Path)
  (param path2 Path)
  (param operation BooleanOperation)
  (if (== operation .boolean-union-operation)
    (call (. out add-path) path1)
    (call (. out add-path) path2)
    (else-if (== operation .boolean-subtract-operation)
      (call (. out add-path) path1)
    )
  )
)

(fn-do _ boolean-contours-apart _
  (param workspace BooleanWorkspace)
  (param operation BooleanOperation)
  (call append-boolean-contour-bounds (. workspace contour-bounds1) (. workspace class-spans1))
  (call append-boolean-contour-bounds (. workspace contour-bounds2) (. workspace class-spans2))
  (for (in bounds1 (. workspace contour-bounds1))
    (for (in bounds2 (. workspace contour-bounds2))
      (return-if false (if (not (call bounds-are-apart bounds1 bounds2 operation))))
    )
  )
  (return true)
)

(fn-do _ append-boolean-contour-bounds _
  (param out (list Rect))
  (param spans (list BooleanClassSpan))
  (call (. out clear))
  (for (in span spans)
    (if (< (. span contour) (. out length))
      (= ([] out (. span contour)) (call rect-union ([] out (. span contour)) (. span bounds)))
      (else
        (+= out (. span bounds))
      )
    )
  )
)

(fn-expr _ rect-union _
  (param a Rect)
  (param b Rect)
  (call Rect left top (- (call max (. a right) (. b right)) left) (- (call max (. a bottom) (. b bottom)) top))
  (where
    (lazy left (call min (. a left) (. b left)))
    (lazy top (call min (. a top) (. b top)))
  )
)

(fn-do _ curve-no-crossing-boolean-reusing _
  (param out Path)
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (param operation BooleanOperation)
  (let bounds1 (. path1 bounding-box))
  (let bounds2 (. path2 bounding-box))
  (let spans1 (. workspace class-spans1))
  (let spans2 (. workspace class-spans2))
  (let path1-inside-path2 (and (call (. bounds2 contains) bounds1 tolerance) (call boolean-spans-enclose spans2 spans1)))
  (let path2-inside-path1 (and (call (. bounds1 contains) bounds2 tolerance) (call boolean-spans-enclose spans1 spans2)))
  (blank)
  (if (== operation .boolean-union-operation)
    (if path1-inside-path2
      (call (. out add-path) path2)
      (else-if path2-inside-path1
        (call (. out add-path) path1)
      )
      (else
        (call (. out add-path) path1)
        (call (. out add-path) path2)
      )
    )
    (else-if (or (== operation .boolean-intersect-operation) (== operation .boolean-clip-operation))
      (if path1-inside-path2
        (call (. out add-path) path1)
        (else-if path2-inside-path1
          (call (. out add-path) path2)
        )
      )
    )
    (else-if (not path1-inside-path2)
      (call (. out add-path) path1)
      (if path2-inside-path1
        (if (== (. path1 is-clockwise) (. path2 is-clockwise))
          (call (. out add-path-reverse) path2)
          (else
            (call (. out add-path) path2)
          )
        )
      )
    )
  )
)

(fn-do _ boolean-spans-enclose _
  (param outer (list BooleanClassSpan))
  (param inner (list BooleanClassSpan))
  (for (in span inner)
    (let x (call boolean-class-span-x span 0.5))
    (let y (call boolean-class-span-y span 0.5))
    (if (not (call boolean-spans-touch outer x y))
      (return (!= (. (call boolean-ray-winding outer false 0 x y 1 0) left) 0))
    )
  )
  (return true)
)

(fn-do _ collect-curve-arrangement-intersections-reusing _
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (call clear-boolean-intersections (. workspace intersections))
  (let spans1 (. workspace class-spans1))
  (let spans2 (. workspace class-spans2))
  (for (in i (..< 0 (. spans1 length)))
    (let a ([] spans1 i))
    (for (in j (..< 0 (. spans2 length)))
      (probe-count graphics.boolean.active-tests)
      (let b ([] spans2 j))
      (if (call rects-overlap (. a bounds) (. b bounds))
        (call collect-boolean-pair-crossings
          (block
            (arg workspace)
            (arg (. workspace intersections))
            (arg a)
            (arg b)
            (arg i)
            (arg j)
            (arg path1)
            (arg path2)
          )
        )
      )
    )
  )
)

(fn-do _ collect-contour-crossings-reusing _
  (param workspace BooleanWorkspace)
  (param out (list CurveIntersection))
  (param spans (list BooleanClassSpan))
  (param path Path)
  (call clear-boolean-intersections out)
  (for (in i (..< 0 (. spans length)))
    (let a ([] spans i))
    (for (in j (..< (+ i 1) (. spans length)))
      (let b ([] spans j))
      (if (and (!= (. a contour) (. b contour)) (call rects-overlap (. a bounds) (. b bounds)))
        (call collect-boolean-pair-crossings workspace out a b i j path path)
      )
    )
  )
)

(fn-do _ collect-boolean-pair-crossings _
  (param workspace BooleanWorkspace)
  (param out (list CurveIntersection))
  (param a BooleanClassSpan)
  (param b BooleanClassSpan)
  (param i Index)
  (param j Index)
  (param path1 Path)
  (param path2 Path)
  (let start-on-a (call boolean-span-parameter a (. b x1) (. b y1)))
  (let end-on-a (call boolean-span-parameter a (. b x2) (. b y2)))
  (let start-on-b (call boolean-span-parameter b (. a x1) (. a y1)))
  (let end-on-b (call boolean-span-parameter b (. a x2) (. a y2)))
  (if (not (call boolean-spans-overlap a b start-on-a end-on-a start-on-b end-on-b))
    (call collect-curve-pair-intersections-reusing
      (block
        (arg workspace)
        (arg (call boolean-span-curve a))
        (arg (call boolean-span-curve b))
        (arg i)
        (arg j)
      )
    )
    (for (in hit (. workspace hits))
      (call append-curve-contact out path1 path2 (. hit t1) (. hit t2))
    )
  )
  (if (>= start-on-a 0)
    (call append-curve-contact out path1 path2 (+ i start-on-a) (+ j 0.0))
  )
  (if (>= end-on-a 0)
    (call append-curve-contact out path1 path2 (+ i end-on-a) (+ j 1.0))
  )
  (if (>= start-on-b 0)
    (call append-curve-contact out path1 path2 (+ i 0.0) (+ j start-on-b))
  )
  (if (>= end-on-b 0)
    (call append-curve-contact out path1 path2 (+ i 1.0) (+ j end-on-b))
  )
)

(fn-do _ boolean-spans-overlap _
  (param a BooleanClassSpan)
  (param b BooleanClassSpan)
  (param start-on-a PointOnCurve)
  (param end-on-a PointOnCurve)
  (param start-on-b PointOnCurve)
  (param end-on-b PointOnCurve)
  (return-if false (if (or (== (. a type) .segment-type-line) (== (. b type) .segment-type-line))))
  (blank)
  (let low 1.0)
  (let high 0.0)
  (if (>= start-on-a 0)
    (= low (call min low start-on-a))
    (= high (call max high start-on-a))
  )
  (if (>= end-on-a 0)
    (= low (call min low end-on-a))
    (= high (call max high end-on-a))
  )
  (if (>= start-on-b 0)
    (= low 0.0)
  )
  (if (>= end-on-b 0)
    (= high 1.0)
  )
  (return-if false (if (<= (- high low) tolerance)))
  (blank)
  (for (in step (..< 1 4))
    (let t (+ low (* (- high low) (as step Float) 0.25)))
    (let x (call boolean-class-span-x a t))
    (let y (call boolean-class-span-y a t))
    (return-if false (if (< (call boolean-span-parameter b x y) 0)))
  )
  (return true)
)

(fn-expr _ boolean-span-curve _
  (param span BooleanClassSpan)
  (call Curve (tuple (. span x1) (. span y1)) (tuple (. span hox) (. span hoy)) (tuple (. span hix) (. span hiy)) (tuple (. span x2) (. span y2)) (. span type))
)

(fn-expr _ boolean-span-parameter _
  (param span BooleanClassSpan)
  (param x Coord)
  (param y Coord)
  (case? (not (call rect-covers-point (. span bounds) x y))
    -1
  )
  (case? (== (. span type) .segment-type-line)
    (call boolean-segment-parameter x y (. span x1) (. span y1) (. span x2) (. span y2))
  )
  (default
    (call cubic-parameter-near
      (block
        (arg x)
        (arg y)
        (arg (. span x1))
        (arg (. span y1))
        (arg (. span hox))
        (arg (. span hoy))
        (arg (. span hix))
        (arg (. span hiy))
        (arg (. span x2))
        (arg (. span y2))
      )
    )
  )
)

(fn-expr _ boolean-segment-parameter PointOnCurve
  (param x Coord)
  (param y Coord)
  (param x1 Coord)
  (param y1 Coord)
  (param x2 Coord)
  (param y2 Coord)
  (case? (<= length-squared (* tolerance tolerance))
    (if-expr (< (+ (* px px) (* py py)) (* tolerance tolerance)) 0 -1)
  )
  (case? (> (* cross cross) (* tolerance tolerance length-squared))
    -1
  )
  (case? (or (< t (- slack)) (> t (+ 1 slack)))
    -1
  )
  (default
    (call min (call max t 0.0) 1.0)
  )
  (where
    (lazy dx (- x2 x1))
    (lazy dy (- y2 y1))
    (lazy px (- x x1))
    (lazy py (- y y1))
    (lazy length-squared (+ (* dx dx) (* dy dy)))
    (lazy cross (- (* dx py) (* dy px)))
    (lazy t (/ (+ (* px dx) (* py dy)) length-squared))
    (lazy slack (/ tolerance (call sqrt length-squared)))
  )
)

(fn-do _ collect-curve-pair-intersections-reusing _
  (param workspace BooleanWorkspace)
  (param c1 Curve)
  (param c2 Curve)
  (param i Index)
  (param j Index)
  (call clear-boolean-intersections (. workspace hits))
  (if (and (call curve-is-line c1) (call curve-is-line c2))
    (let parallel
      (call lines-are-parallel
        (block
          (arg (. c1 anchor1 x))
          (arg (. c1 anchor1 y))
          (arg (. c1 anchor2 x))
          (arg (. c1 anchor2 y))
          (arg (. c2 anchor1 x))
          (arg (. c2 anchor1 y))
          (arg (. c2 anchor2 x))
          (arg (. c2 anchor2 y))
        )
      )
    )
    (if (not parallel)
      (call intersect-line-line-scalars
        (block
          (arg (. workspace hits))
          (arg (. c1 anchor1 x))
          (arg (. c1 anchor1 y))
          (arg (. c1 anchor2 x))
          (arg (. c1 anchor2 y))
          (arg (. c2 anchor1 x))
          (arg (. c2 anchor1 y))
          (arg (. c2 anchor2 x))
          (arg (. c2 anchor2 y))
          (arg i)
          (arg j)
          (arg null)
          (arg null)
        )
      )
    )
    (else-if (call curve-is-line c1)
      (call intersect-line-curve-scalars
        (block
          (arg (. workspace hits))
          (arg (. c1 anchor1 x))
          (arg (. c1 anchor1 y))
          (arg (. c1 anchor2 x))
          (arg (. c1 anchor2 y))
          (arg (. c2 anchor1 x))
          (arg (. c2 anchor1 y))
          (arg (. c2 handle-out x))
          (arg (. c2 handle-out y))
          (arg (. c2 handle-in x))
          (arg (. c2 handle-in y))
          (arg (. c2 anchor2 x))
          (arg (. c2 anchor2 y))
          (arg i)
          (arg j)
          (arg null)
          (arg null)
        )
      )
    )
    (else-if (call curve-is-line c2)
      (call intersect-curve-line-scalars
        (block
          (arg (. workspace hits))
          (arg (. c1 anchor1 x))
          (arg (. c1 anchor1 y))
          (arg (. c1 handle-out x))
          (arg (. c1 handle-out y))
          (arg (. c1 handle-in x))
          (arg (. c1 handle-in y))
          (arg (. c1 anchor2 x))
          (arg (. c1 anchor2 y))
          (arg (. c2 anchor1 x))
          (arg (. c2 anchor1 y))
          (arg (. c2 anchor2 x))
          (arg (. c2 anchor2 y))
          (arg i)
          (arg j)
          (arg null)
          (arg null)
        )
      )
    )
    (else
      (call intersect-curves-reusing
        (block
          (arg (. workspace hits))
          (arg (. workspace intersection-workspace))
          (arg c1)
          (arg c2)
          (arg 0)
          (arg i)
          (arg j)
          (arg null)
          (arg null)
        )
      )
    )
  )
)

(fn-do _ append-curve-contact _
  (param intersections (list CurveIntersection))
  (param path1 Path)
  (param path2 Path)
  (param t1 PointOnCurve)
  (param t2 PointOnCurve)
  (return-if (if (call has-arrangement-intersection intersections t1 t2)))
  (blank)
  (+= intersections (tuple t1 t2 path1 path2))
  (probe-count graphics.boolean.intersections)
)

(fn-do _ append-boolean-classifier-spans _
  (param workspace BooleanWorkspace)
  (param spans (list BooleanClassSpan))
  (param path Path)
  (call (. spans clear))
  (call clear-boolean-subpath-spans workspace)
  (call (. path append-subpath-spans) (. workspace subpath-spans))
  (let reader (. path curve-reader))
  (let contour Index)
  (for (in subpath (. workspace subpath-spans))
    (if (not (. subpath curve-count))
      (continue)
    )
    (for (in k (..< 0 (. subpath curve-count)))
      (if (not (call (. reader next)))
        (break)
      )
      (let scalars
        (call CurveRangeScalars
          (block
            (arg (. reader type))
            (arg (. reader x1))
            (arg (. reader y1))
            (arg (. reader handle-out-x))
            (arg (. reader handle-out-y))
            (arg (. reader handle-in-x))
            (arg (. reader handle-in-y))
            (arg (. reader x2))
            (arg (. reader y2))
          )
        )
      )
      (+= spans
        (call BooleanClassSpan
          (block
            (arg (. scalars type))
            (arg (. scalars x1))
            (arg (. scalars y1))
            (arg (. scalars hox))
            (arg (. scalars hoy))
            (arg (. scalars hix))
            (arg (. scalars hiy))
            (arg (. scalars x2))
            (arg (. scalars y2))
            (arg (call boolean-scalars-bounds scalars))
            (arg contour)
          )
        )
      )
    )
    (+= contour 1)
  )
  (call clear-boolean-subpath-spans workspace)
)

(fn-do _ clear-boolean-subpath-spans _
  (param workspace BooleanWorkspace)
  (for (in index (..< 0 (. workspace subpath-spans length)))
    (= ([] (. workspace subpath-spans) index) (call PathSubpathSpan (. workspace empty-path commands) 0 0 0 false))
  )
  (call (. workspace subpath-spans clear))
)

(fn-do _ append-boolean-arrangement-spans _
  (param out (list BooleanOutputSpan))
  (param splits (list PointOnCurve))
  (param class-spans (list BooleanClassSpan))
  (param intersections (list CurveIntersection))
  (param self-intersections (list CurveIntersection))
  (param source _)
  (call (. out clear))
  (for (in i (..< 0 (. class-spans length)))
    (let class-span ([] class-spans i))
    (if (and (<= (. class-span bounds width) tolerance) (<= (. class-span bounds height) tolerance))
      (continue)
    )
    (call prepare-curve-span-splits splits intersections self-intersections source i)
    (for (in j (..< 1 (. splits length)))
      (let t1 ([] splits (- j 1)))
      (let t2 ([] splits j))
      (if (< (- t2 t1) tolerance)
        (continue)
      )
      (let sample-t (* (+ t1 t2) 0.5))
      (+= out
        (call BooleanOutputSpan
          (block
            (arg class-span)
            (arg i)
            (arg t1)
            (arg t2)
            (arg (call boolean-class-span-x class-span sample-t))
            (arg (call boolean-class-span-y class-span sample-t))
          )
        )
      )
    )
  )
)

(fn-do _ prepare-curve-span-splits _
  (param splits (list PointOnCurve))
  (param intersections (list CurveIntersection))
  (param self-intersections (list CurveIntersection))
  (param source _)
  (param curve-index Index)
  (call (. splits clear))
  (+= splits 0)
  (+= splits 1)
  (for (in intr intersections)
    (call append-curve-span-split splits (if-expr (== source 1) (. intr t1) (. intr t2)) curve-index)
  )
  (for (in intr self-intersections)
    (call append-curve-span-split splits (. intr t1) curve-index)
    (call append-curve-span-split splits (. intr t2) curve-index)
  )
  (blank)
  (for (in index (..< 1 (. splits length)))
    (let item ([] splits index))
    (let insert index)
    (while (and (> insert 0) (< item ([] splits (- insert 1))))
      (= ([] splits insert) ([] splits (- insert 1)))
      (-= insert 1)
    )
    (= ([] splits insert) item)
  )
  (blank)
  (let write Index)
  (let has-last false)
  (let last PointOnCurve)
  (for (in split splits)
    (if (and has-last (< (call abs (- split last)) 0.00001))
      (continue)
    )
    (= ([] splits write) split)
    (+= write 1)
    (= last split)
    (= has-last true)
  )
  (if (< write (. splits length))
    (-= ([] splits (... write)))
  )
)

(fn-do _ append-curve-span-split _
  (param splits (list PointOnCurve))
  (param t PointOnCurve)
  (param curve-index Index)
  (let i (as t Index))
  (return-if (if (!= i curve-index)))
  (blank)
  (let local (- t i))
  (if (and (> local tolerance) (< local (- 1 tolerance)))
    (+= splits local)
    (probe-count graphics.boolean.curve-splits)
  )
)

(fn-do _ append-curve-span-fragments-reusing _
  (param workspace BooleanWorkspace)
  (param spans (list BooleanOutputSpan))
  (param operation BooleanOperation)
  (param source _)
  (param interior-left Bool)
  (for (in span spans)
    (let direction (call boolean-fragment-direction workspace span operation source interior-left))
    (if (!= direction 0)
      (call append-curve-span-edge-reusing workspace span source (< direction 0))
      (probe-count graphics.boolean.output-spans)
    )
  )
)

(fn-do _ boolean-fragment-direction _
  (param workspace BooleanWorkspace)
  (param span BooleanOutputSpan)
  (param operation BooleanOperation)
  (param source _)
  (param interior-left Bool)
  (let curve (. span source))
  (let t (* (+ (. span t1) (. span t2)) 0.5))
  (let dx (call boolean-class-span-dx curve t))
  (let dy (call boolean-class-span-dy curve t))
  (let speed (call sqrt (+ (* dx dx) (* dy dy))))
  (if (<= speed tolerance-tight)
    (= dx (- (call boolean-class-span-x curve (. span t2)) (call boolean-class-span-x curve (. span t1))))
    (= dy (- (call boolean-class-span-y curve (. span t2)) (call boolean-class-span-y curve (. span t1))))
    (= speed (call sqrt (+ (* dx dx) (* dy dy))))
    (return-if 0 (if (<= speed tolerance-tight)))
  )
  (let rx (/ (- dy) speed))
  (let ry (/ dx speed))
  (let own-spans (if-expr (== source 1) (. workspace class-spans1) (. workspace class-spans2)))
  (let other-spans (if-expr (== source 1) (. workspace class-spans2) (. workspace class-spans1)))
  (let other (call boolean-ray-winding other-spans false 0 (. span sample-x) (. span sample-y) rx ry))
  (let other-left (!= (. other left) 0))
  (let other-right (!= (. other right) 0))
  (if (== other-left other-right)
    (if (== operation .boolean-union-operation)
      (return-if 0 (if other-left))
      (else-if (== operation .boolean-subtract-operation)
        (return-if 0 (if (== other-left (== source 1))))
      )
      (else
        (return-if 0 (if (not other-left)))
      )
    )
  )
  (let own (call boolean-ray-winding own-spans true (. span index) (. span sample-x) (. span sample-y) rx ry))
  (let own-left (!= (. own left) 0))
  (let own-right (!= (. own right) 0))
  (let left
    (call boolean-operation-contains
      (block
        (arg operation)
        (arg (if-expr (== source 1) own-left other-left))
        (arg (if-expr (== source 1) other-left own-left))
      )
    )
  )
  (let right
    (call boolean-operation-contains
      (block
        (arg operation)
        (arg (if-expr (== source 1) own-right other-right))
        (arg (if-expr (== source 1) other-right own-right))
      )
    )
  )
  (return-if 0 (if (== left right)))
  (blank)
  (if (and (== source 2) (. other touches))
    (return-if 0 (if (call boolean-span-coincides (. workspace class-spans1) curve (. span t1) (. span t2))))
  )
  (return (if-expr (== left interior-left) 1 -1))
)

(fn-expr _ boolean-operation-contains _
  (param operation BooleanOperation)
  (param inside1 Bool)
  (param inside2 Bool)
  (case? (== operation .boolean-union-operation)
    (or inside1 inside2)
  )
  (case? (== operation .boolean-subtract-operation)
    (and inside1 (not inside2))
  )
  (default
    (and inside1 inside2)
  )
)

(fn-do _ boolean-ray-winding _
  (param spans (list BooleanClassSpan))
  (param has-own Bool)
  (param own Index)
  (param px Coord)
  (param py Coord)
  (param rx Coord)
  (param ry Coord)
  (let winding (call BooleanRayWinding 0 0 false))
  (for (in index (..< 0 (. spans length)))
    (let span ([] spans index))
    (let is-own (and has-own (== index own)))
    (let d0 (- (* rx (- (. span y1) py)) (* ry (- (. span x1) px))))
    (let d3 (- (* rx (- (. span y2) py)) (* ry (- (. span x2) px))))
    (if (== (. span type) .segment-type-line)
      (if (!= (> d0 0) (> d3 0))
        (let s (/ d0 (- d0 d3)))
        (let x (+ (. span x1) (* (- (. span x2) (. span x1)) s)))
        (let y (+ (. span y1) (* (- (. span y2) (. span y1)) s)))
        (let a (+ (* rx (- x px)) (* ry (- y py))))
        (= winding (call boolean-ray-crossing winding a (if-expr (> d3 d0) 1 -1) is-own))
      )
      (continue)
    )
    (let d1 (- (* rx (- (. span hoy) py)) (* ry (- (. span hox) px))))
    (let d2 (- (* rx (- (. span hiy) py)) (* ry (- (. span hix) px))))
    (if (and (> d0 0) (> d1 0) (> d2 0) (> d3 0))
      (continue)
    )
    (if (and (<= d0 0) (<= d1 0) (<= d2 0) (<= d3 0))
      (continue)
    )
    (let a0 (+ (* rx (- (. span x1) px)) (* ry (- (. span y1) py))))
    (let a1 (+ (* rx (- (. span hox) px)) (* ry (- (. span hoy) py))))
    (let a2 (+ (* rx (- (. span hix) px)) (* ry (- (. span hiy) py))))
    (let a3 (+ (* rx (- (. span x2) px)) (* ry (- (. span y2) py))))
    (if (< (call max (call max a0 a1) (call max a2 a3)) (- boolean-touch-distance))
      (continue)
    )
    (let nearest (call min (call min a0 a1) (call min a2 a3)))
    (if (> nearest boolean-touch-distance)
      (if (!= (> d0 0) (> d3 0))
        (= winding (call boolean-ray-crossing winding nearest (if-expr (> d3 0) 1 -1) is-own))
      )
      (continue)
    )
    (let coefficients (call cubic-coefficients-1d d0 d1 d2 d3))
    (let roots (call cubic-roots-for-y 0 d0 d1 d2 d3 tolerance-tight))
    (let first 2.0)
    (let second 2.0)
    (let third 2.0)
    (for (in j (..< 0 (. roots count)))
      (let t (call polish-boolean-root coefficients d0 ([] roots j)))
      (if (or (<= t boolean-endpoint-parameter) (>= t (- 1 boolean-endpoint-parameter)))
        (continue)
      )
      (if (<= (call abs (- t first)) boolean-endpoint-parameter)
        (continue)
      )
      (if (<= (call abs (- t second)) boolean-endpoint-parameter)
        (continue)
      )
      (if (< t first)
        (= third second)
        (= second first)
        (= first t)
        (else-if (< t second)
          (= third second)
          (= second t)
        )
        (else-if (< t third)
          (= third t)
        )
      )
    )
    (let above (> d0 0))
    (let boundary 0.0)
    (for (in k (..< 0 4))
      (let next (if-expr (== k 0) first (if-expr (== k 1) second (if-expr (== k 2) third 2.0))))
      (if (> next 1)
        (= next 1.0)
      )
      (let middle (* (+ boundary next) 0.5))
      (let inside (> (call cubic-evaluate-1d (. coefficients a) (. coefficients b) (. coefficients c) d0 middle) 0))
      (if (!= inside above)
        (let a a0)
        (if (!= boundary 0)
          (let x (call boolean-class-span-x span boundary))
          (let y (call boolean-class-span-y span boundary))
          (= a (+ (* rx (- x px)) (* ry (- y py))))
        )
        (= winding (call boolean-ray-crossing winding a (if-expr inside 1 -1) is-own))
        (= above inside)
      )
      (= boundary next)
      (if (>= next 1)
        (break)
      )
    )
    (if (!= above (> d3 0))
      (= winding (call boolean-ray-crossing winding a3 (if-expr (> d3 0) 1 -1) is-own))
    )
  )
  (if has-own
    (return (call BooleanRayWinding (. winding left) (- (. winding right) 1) (. winding touches)))
  )
  (return winding)
)

(fn-expr _ boolean-ray-crossing _
  (param winding BooleanRayWinding)
  (param a Coord)
  (param sign Int)
  (param is-own Bool)
  (case? (> a boolean-touch-distance)
    (call BooleanRayWinding (+ (. winding left) sign) (+ (. winding right) sign) (. winding touches))
  )
  (case? (and (>= a (- boolean-touch-distance)) (not is-own))
    (call BooleanRayWinding (. winding left) (+ (. winding right) sign) true)
  )
  (default
    winding
  )
)

(fn-do _ polish-boolean-root _
  (param coefficients CubicCoefficients1D)
  (param d0 Coord)
  (param t PointOnCurve)
  (let root t)
  (for (in iteration (..< 0 3))
    (let value (call cubic-evaluate-1d (. coefficients a) (. coefficients b) (. coefficients c) d0 root))
    (let slope (call cubic-derivative-1d (. coefficients a) (. coefficients b) (. coefficients c) root))
    (if (<= (call abs slope) tolerance-tight)
      (break)
    )
    (let next (- root (/ value slope)))
    (if (> (call abs (- next root)) 0.001)
      (break)
    )
    (= root next)
  )
  (return root)
)

(fn-do _ boolean-span-coincides _
  (param spans (list BooleanClassSpan))
  (param curve BooleanClassSpan)
  (param t1 PointOnCurve)
  (param t2 PointOnCurve)
  (for (in step (..< 1 4))
    (let t (+ t1 (* (- t2 t1) (as step Float) 0.25)))
    (let x (call boolean-class-span-x curve t))
    (let y (call boolean-class-span-y curve t))
    (return-if false (if (not (call boolean-spans-touch spans x y))))
  )
  (return true)
)

(fn-expr _ boolean-spans-touch _
  (param spans (list BooleanClassSpan))
  (param x Coord)
  (param y Coord)
  (call some spans (:where (>= (call boolean-span-parameter each x y) 0)))
)

(fn-do _ append-curve-span-edge-reusing _
  (param workspace BooleanWorkspace)
  (param span BooleanOutputSpan)
  (param path-number Index)
  (param reverse Bool)
  (if (== (. workspace edge-count) (. workspace edges length))
    (+= (. workspace edges) (call BooleanSpanEdge 0 0 0 0 (call empty-boolean-class-span) 0 0))
  )
  (let edge ([] (. workspace edges) (. workspace edge-count)))
  (+= (. workspace edge-count) 1)
  (let source (. span source))
  (= (. edge source) source)
  (= (. edge t1) (. span t1))
  (= (. edge t2) (. span t2))
  (= (. edge path-number) path-number)
  (= (. edge curve-index) (. span index))
  (= (. edge reverse) reverse)
  (= (. edge used) false)
  (= (. edge closes) false)
  (if reverse
    (= (. edge start-x) (call boolean-class-span-x source (. span t2)))
    (= (. edge start-y) (call boolean-class-span-y source (. span t2)))
    (= (. edge end-x) (call boolean-class-span-x source (. span t1)))
    (= (. edge end-y) (call boolean-class-span-y source (. span t1)))
    (else
      (= (. edge start-x) (call boolean-class-span-x source (. span t1)))
      (= (. edge start-y) (call boolean-class-span-y source (. span t1)))
      (= (. edge end-x) (call boolean-class-span-x source (. span t2)))
      (= (. edge end-y) (call boolean-class-span-y source (. span t2)))
    )
  )
)

(fn-do _ build-boolean-span-path-reusing Bool
  (param out Path)
  (param workspace BooleanWorkspace)
  (param strict Bool)
  (for (in edge-index (..< 0 (. workspace edge-count)))
    (let edge ([] (. workspace edges) edge-index))
    (if (. edge used)
      (continue)
    )
    (blank)
    (= (. edge used) true)
    (call (. workspace contour-edges clear))
    (+= (. workspace contour-edges) edge)
    (let first-x (. edge start-x))
    (let first-y (. edge start-y))
    (let current-x (. edge end-x))
    (let current-y (. edge end-y))
    (let guard 0)
    (while (<= guard (. workspace edge-count))
      (if (call near-span-coords current-x current-y first-x first-y)
        (break)
      )
      (let next (call next-boolean-span-edge-reusing workspace current-x current-y))
      (if (not next)
        (if strict
          (call (. workspace contour-edges clear))
          (call (. out clear))
          (return false)
        )
        (break)
      )
      (= (. next used) true)
      (+= (. workspace contour-edges) next)
      (= current-x (. next end-x))
      (= current-y (. next end-y))
      (+= guard 1)
    )
    (call append-boolean-contour out (. workspace contour-edges))
  )
  (blank)
  (call (. workspace contour-edges clear))
  (return true)
)

(fn-do _ append-boolean-contour _
  (param out Path)
  (param edges (list BooleanSpanEdge))
  (let count (. edges length))
  (let start Index)
  (for (in index (..< 0 count))
    (if (not (call boolean-edges-continue ([] edges (% (- (+ index count) 1) count)) ([] edges index)))
      (= start index)
      (break)
    )
  )
  (let first ([] edges start))
  (call (. out move-to) (. first start-x) (. first start-y))
  (let pending first)
  (for (in step (..< 1 count))
    (let next ([] edges (% (+ start step) count)))
    (if (call boolean-edges-continue pending next)
      (if (. pending reverse)
        (= (. pending t1) (. next t1))
        (else
          (= (. pending t2) (. next t2))
        )
      )
      (= (. pending end-x) (. next end-x))
      (= (. pending end-y) (. next end-y))
      (else
        (call append-span-edge out pending)
        (= pending next)
      )
    )
  )
  (if (call near-span-coords (. pending end-x) (. pending end-y) (. first start-x) (. first start-y))
    (= (. pending end-x) (. first start-x))
    (= (. pending end-y) (. first start-y))
    (= (. pending closes) true)
  )
  (call append-span-edge out pending)
  (call (. out close))
)

(fn-expr _ boolean-edges-continue _
  (param previous BooleanSpanEdge)
  (param next BooleanSpanEdge)
  (case? (!= (. previous path-number) (. next path-number))
    false
  )
  (case? (!= (. previous curve-index) (. next curve-index))
    false
  )
  (case? (!= (. previous reverse) (. next reverse))
    false
  )
  (case? (. previous reverse)
    (== (. next t2) (. previous t1))
  )
  (default
    (== (. next t1) (. previous t2))
  )
)

(fn-do _ reset-boolean-span-edges _
  (param workspace BooleanWorkspace)
  (for (in index (..< 0 (. workspace edge-count)))
    (let edge ([] (. workspace edges) index))
    (= (. edge source) (call empty-boolean-class-span))
    (= (. edge used) false)
  )
  (= (. workspace edge-count) 0)
)

(fn-do _ next-boolean-span-edge-reusing _
  (param workspace BooleanWorkspace)
  (param x Coord)
  (param y Coord)
  (for (in index (..< 0 (. workspace edge-count)))
    (let edge ([] (. workspace edges) index))
    (if (and (not (. edge used)) (call near-span-coords (. edge start-x) (. edge start-y) x y))
      (return edge)
    )
  )
)

(fn-do _ flattened-boolean-reusing _
  (param out Path)
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (param operation BooleanOperation)
  (call flatten-path-reusing workspace (. workspace flat1) path1)
  (call flatten-path-reusing workspace (. workspace flat2) path2)
  (if (and (call is-single-contour path1) (call is-single-contour path2))
    (return-if (if (call line-polygon-boolean-reusing out workspace (. workspace flat1) (. workspace flat2) operation)))
  )
  (call append-boolean-classifier-spans workspace (. workspace class-spans1) (. workspace flat1))
  (call append-boolean-classifier-spans workspace (. workspace class-spans2) (. workspace flat2))
  (call collect-curve-arrangement-intersections-reusing workspace (. workspace flat1) (. workspace flat2))
  (call collect-contour-crossings-reusing
    (block
      (arg workspace)
      (arg (. workspace self-intersections1))
      (arg (. workspace class-spans1))
      (arg (. workspace flat1))
    )
  )
  (call collect-contour-crossings-reusing
    (block
      (arg workspace)
      (arg (. workspace self-intersections2))
      (arg (. workspace class-spans2))
      (arg (. workspace flat2))
    )
  )
  (call arrange-boolean-reusing out workspace (. path1 is-clockwise) operation false)
)

(fn-do _ line-polygon-boolean-reusing _
  (param out Path)
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (param operation BooleanOperation)
  (return-if false (if (not (call append-line-polygon-points-reusing (. workspace points1) path1))))
  (return-if false (if (not (call append-line-polygon-points-reusing (. workspace points2) path2))))
  (blank)
  (if (not (call polygons-have-crossings (. workspace points1) (. workspace points2)))
    (call line-polygon-no-crossing-reusing out (. workspace points1) (. workspace points2) operation)
    (return true)
  )
  (blank)
  (= (. workspace line-edge-count) 0)
  (call append-boolean-fragments-reusing workspace (. workspace points1) (. workspace points2) operation 1)
  (call append-boolean-fragments-reusing workspace (. workspace points2) (. workspace points1) operation 2)
  (return-if true (if (not (. workspace line-edge-count))))
  (blank)
  (if (not (call build-boolean-fragment-path-reusing out workspace))
    (call (. out clear))
    (return false)
  )
  (return true)
)

(fn-do _ line-polygon-no-crossing-reusing _
  (param out Path)
  (param points1 (list Point))
  (param points2 (list Point))
  (param operation BooleanOperation)
  (let points1-inside-points2
    (call polygon-contains-point
      (block
        (arg points2)
        (arg (call boolean-polygon-boundary-sample points1 points2))
      )
    )
  )
  (let points2-inside-points1
    (call polygon-contains-point
      (block
        (arg points1)
        (arg (call boolean-polygon-boundary-sample points2 points1))
      )
    )
  )
  (blank)
  (if (== operation .boolean-union-operation)
    (if points1-inside-points2
      (call append-boolean-points-path out points2)
      (else-if points2-inside-points1
        (call append-boolean-points-path out points1)
      )
      (else
        (call append-boolean-points-path out points1)
        (call append-boolean-points-path out points2)
      )
    )
    (else-if (or (== operation .boolean-intersect-operation) (== operation .boolean-clip-operation))
      (if points1-inside-points2
        (call append-boolean-points-path out points1)
        (else-if points2-inside-points1
          (call append-boolean-points-path out points2)
        )
      )
    )
    (else-if (not points1-inside-points2)
      (call append-boolean-points-path out points1)
      (if points2-inside-points1
        (call append-boolean-points-path-reverse out points2)
      )
    )
  )
)

(fn-do _ boolean-polygon-boundary-sample _
  (param points (list Point))
  (param other (list Point))
  (for (in i (..< 0 (. points length)))
    (let sample (call (. ([] points i) midpoint) ([] points (% (+ i 1) (. points length)))))
    (return-if sample (if (not (call polygon-boundary-contains-point other sample))))
  )
  (return ([] points 0))
)

(fn-do _ axis-rect-list-boolean-reusing _
  (param out Path)
  (param workspace BooleanWorkspace)
  (param path1 Path)
  (param path2 Path)
  (param operation BooleanOperation)
  (if (not (call append-axis-rect-subpaths-reusing (. workspace bounds1) workspace (. workspace flat1) path1))
    (return false)
  )
  (if (not (call append-axis-rect-subpaths-reusing (. workspace bounds2) workspace (. workspace flat2) path2))
    (return false)
  )
  (if (and (<= (. workspace bounds1 length) 1) (<= (. workspace bounds2 length) 1))
    (return false)
  )
  (blank)
  (if (== operation .boolean-union-operation)
    (call append-rects-to-path out (. workspace bounds1))
    (call append-rects-to-path out (. workspace bounds2))
    (else-if (or (== operation .boolean-intersect-operation) (== operation .boolean-clip-operation))
      (for (in rect1 (. workspace bounds1))
        (for (in rect2 (. workspace bounds2))
          (let overlap (call rect-intersection rect1 rect2))
          (if overlap
            (call append-rect-to-path out overlap)
          )
        )
      )
    )
    (else
      (let pieces (. workspace rect-pieces))
      (let next (. workspace rect-next))
      (for (in rect (. workspace bounds1))
        (call (. pieces clear))
        (+= pieces rect)
        (for (in cutter (. workspace bounds2))
          (call (. next clear))
          (for (in piece pieces)
            (call append-rect-subtract next piece cutter)
          )
          (let swap pieces)
          (= pieces next)
          (= next swap)
        )
        (call append-rects-to-path out pieces)
      )
    )
  )
  (blank)
  (return true)
)

(fn-do _ append-axis-rect-subpaths-reusing Bool
  (param rects (list Rect))
  (param workspace BooleanWorkspace)
  (param scratch Path)
  (param path Path)
  (call (. rects clear))
  (for (in index (..< 0 (. workspace rect-subpaths length)))
    (= ([] (. workspace rect-subpaths) index) (call PathSubpathSpan (. scratch commands) 0 0 0 false))
  )
  (call (. workspace rect-subpaths clear))
  (if (not (. path is-closed))
    (return false)
  )
  (blank)
  (call (. path append-subpath-spans) (. workspace rect-subpaths))
  (for (in span (. workspace rect-subpaths))
    (call (. span materialize) scratch)
    (if (not (. scratch count))
      (continue)
    )
    (let rect (call axis-rect scratch))
    (if (not rect)
      (call (. rects clear))
      (return false)
    )
    (+= rects rect)
  )
  (blank)
  (return true)
)

(fn-do _ append-boolean-points-path _
  (param out Path)
  (param points (list Point))
  (return-if (if (not points)))
  (blank)
  (call (. out move-to) ([] points 0))
  (for (in i (..< 1 (. points length)))
    (call (. out line-to) ([] points i))
  )
  (call (. out close))
)

(fn-do _ append-boolean-points-path-reverse _
  (param out Path)
  (param points (list Point))
  (return-if (if (not points)))
  (blank)
  (call (. out move-to) ([] points 0))
  (for (in i (.. (- (. points length) 1) 1))
    (call (. out line-to) ([] points i))
  )
  (call (. out close))
)

(fn-do _ flatten-path-reusing _
  (param workspace BooleanWorkspace)
  (param out Path)
  (param path Path)
  (call (. out clear))
  (call clear-boolean-subpath-spans workspace)
  (call (. path append-subpath-spans) (. workspace subpath-spans))
  (let reader (. path curve-reader))
  (for (in subpath (. workspace subpath-spans))
    (if (not (. subpath curve-count))
      (continue)
    )
    (for (in k (..< 0 (. subpath curve-count)))
      (if (not (call (. reader next)))
        (break)
      )
      (if (== k 0)
        (call (. out move-to) (. reader x1) (. reader y1))
      )
      (if (== (. reader type) .segment-type-line)
        (call (. out line-to) (. reader x2) (. reader y2))
        (else
          (for (in step (..< 1 19))
            (let t (/ (as step Float) 18.0))
            (call (. out line-to)
              (block
                (arg (call cubic-point (. reader x1) (. reader handle-out-x) (. reader handle-in-x) (. reader x2) t))
                (arg (call cubic-point (. reader y1) (. reader handle-out-y) (. reader handle-in-y) (. reader y2) t))
              )
            )
          )
        )
      )
    )
    (call (. out close))
  )
  (call clear-boolean-subpath-spans workspace)
)

(fn-do _ append-line-polygon-points-reusing Bool
  (param points (list Point))
  (param path Path)
  (call (. points clear))
  (if (or (not (. path is-closed)) (< (. path count) 4))
    (return false)
  )
  (blank)
  (let span (. path commands))
  (for (in i (..< 0 (. span command-count)))
    (let verb ([] (. span verbs) i))
    (if (== verb .path-verb-cubic)
      (call (. points clear))
      (return false)
    )
    (if (== verb .path-verb-close)
      (continue)
    )
    (if (and (> i 0) (== verb .path-verb-move))
      (call (. points clear))
      (return false)
    )
    (let start ([] (. span coord-offsets) i))
    (let point (call Point ([] (. span coords) start) ([] (. span coords) (+ start 1))))
    (if (and (. points length) (call near-corner point ([] points (- (. points length) 1))))
      (continue)
    )
    (+= points point)
  )
  (blank)
  (while (and (> (. points length) 1) (call near-corner ([] points (- (. points length) 1)) ([] points 0)))
    (call (. points remove) (- (. points length) 1))
  )
  (if (< (. points length) 3)
    (call (. points clear))
    (return false)
  )
  (if (not (. path is-clockwise))
    (call reverse-boolean-points points)
  )
  (return true)
)

(fn-do _ reverse-boolean-points _
  (param points (list Point))
  (let left Index)
  (let right (- (. points length) 1))
  (while (< left right)
    (let swap ([] points left))
    (= ([] points left) ([] points right))
    (= ([] points right) swap)
    (+= left 1)
    (-= right 1)
  )
)

(fn-do _ append-boolean-fragments-reusing _
  (param workspace BooleanWorkspace)
  (param points (list Point))
  (param other-points (list Point))
  (param operation BooleanOperation)
  (param source _)
  (for (in i (..< 0 (. points length)))
    (let start ([] points i))
    (let end ([] points (% (+ i 1) (. points length))))
    (call prepare-edge-split-parameters (. workspace line-splits) start end other-points)
    (blank)
    (for (in j (..< 1 (. workspace line-splits length)))
      (let t1 ([] (. workspace line-splits) (- j 1)))
      (let t2 ([] (. workspace line-splits) j))
      (if (< (- t2 t1) 0.00001)
        (continue)
      )
      (blank)
      (let p1 (call point-at-parameter start end t1))
      (let p2 (call point-at-parameter start end t2))
      (if (call should-include-line-fragment operation source points other-points p1 p2)
        (if (call should-reverse-fragment operation source)
          (call append-boolean-line-edge workspace p2 p1)
          (else
            (call append-boolean-line-edge workspace p1 p2)
          )
        )
      )
    )
  )
)

(fn-do _ prepare-edge-split-parameters _
  (param splits (list Float))
  (param start Point)
  (param end Point)
  (param other-points (list Point))
  (call (. splits clear))
  (+= splits 0.0)
  (+= splits 1.0)
  (for (in i (..< 0 (. other-points length)))
    (let other-start ([] other-points i))
    (let other-end ([] other-points (% (+ i 1) (. other-points length))))
    (let intr (call segment-crossing start end other-start other-end))
    (if intr
      (let t (call segment-parameter intr start end))
      (if (and (> t 0.00001) (< t 0.99999))
        (+= splits t)
      )
    )
    (if (call point-on-segment other-start start end)
      (let t (call segment-parameter other-start start end))
      (if (and (> t 0.00001) (< t 0.99999))
        (+= splits t)
      )
    )
  )
  (blank)
  (for (in index (..< 1 (. splits length)))
    (let item ([] splits index))
    (let insert index)
    (while (and (> insert 0) (< item ([] splits (- insert 1))))
      (= ([] splits insert) ([] splits (- insert 1)))
      (-= insert 1)
    )
    (= ([] splits insert) item)
  )
  (blank)
  (let write Index)
  (let has-last false)
  (let last Float)
  (for (in split splits)
    (if (and has-last (< (call abs (- split last)) 0.00001))
      (continue)
    )
    (= ([] splits write) split)
    (+= write 1)
    (= last split)
    (= has-last true)
  )
  (if (< write (. splits length))
    (-= ([] splits (... write)))
  )
)

(fn-do _ append-boolean-line-edge _
  (param workspace BooleanWorkspace)
  (param start Point)
  (param end Point)
  (if (== (. workspace line-edge-count) (. workspace line-edges length))
    (+= (. workspace line-edges) (call BooleanEdge (call Point 0 0) (call Point 0 0)))
  )
  (let edge ([] (. workspace line-edges) (. workspace line-edge-count)))
  (+= (. workspace line-edge-count) 1)
  (= (. edge start) start)
  (= (. edge end) end)
  (= (. edge used) false)
)

(fn-do _ build-boolean-fragment-path-reusing Bool
  (param out Path)
  (param workspace BooleanWorkspace)
  (if (not (. workspace line-edge-count))
    (return false)
  )
  (blank)
  (for (in edge-index (..< 0 (. workspace line-edge-count)))
    (let edge ([] (. workspace line-edges) edge-index))
    (if (. edge used)
      (continue)
    )
    (blank)
    (= (. edge used) true)
    (call (. out move-to) (. edge start))
    (call (. out line-to) (. edge end))
    (let first (. edge start))
    (let current (. edge end))
    (let guard 0)
    (while (<= guard (. workspace line-edge-count))
      (if (call near-corner current first)
        (break)
      )
      (let next (call next-boolean-line-edge-reusing workspace current))
      (if (not next)
        (call (. out clear))
        (return false)
      )
      (= (. next used) true)
      (= current (if-expr (call near-corner (. next end) first) first (. next end)))
      (call (. out line-to) current)
      (+= guard 1)
    )
    (call (. out close))
  )
  (blank)
  (return (> (. out count) 0))
)

(fn-do _ next-boolean-line-edge-reusing _
  (param workspace BooleanWorkspace)
  (param point Point)
  (for (in index (..< 0 (. workspace line-edge-count)))
    (let edge ([] (. workspace line-edges) index))
    (if (and (not (. edge used)) (call near-corner (. edge start) point))
      (return edge)
    )
  )
)

(fn-do _ is-single-contour _
  (param path Path)
  (let move-count 0)
  (let span (. path commands))
  (for (in i (..< 0 (. span command-count)))
    (if (== ([] (. span verbs) i) .path-verb-move)
      (+= move-count 1)
    )
  )
  (blank)
  (return (== move-count 1))
)

(fn-expr _ curve-is-line _
  (param curve Curve)
  (or (== (. curve type) .segment-type-line) (. curve is-line-like))
)

(fn-expr _ rects-overlap _
  (param a Rect)
  (param b Rect)
  (not (or apart-x (< (. a bottom) (- (. b top) tolerance)) (< (. b bottom) (- (. a top) tolerance))))
  (where
    (lazy apart-x (or (< (. a right) (- (. b left) tolerance)) (< (. b right) (- (. a left) tolerance))))
  )
)

(fn-expr _ rects-have-area-overlap _
  (param a Rect)
  (param b Rect)
  (not (or apart-x (<= (. a bottom) (+ (. b top) tolerance)) (<= (. b bottom) (+ (. a top) tolerance))))
  (where
    (lazy apart-x (or (<= (. a right) (+ (. b left) tolerance)) (<= (. b right) (+ (. a left) tolerance))))
  )
)

(fn-expr _ bounds-are-apart _
  (param a Rect)
  (param b Rect)
  (param operation BooleanOperation)
  (case? (== operation .boolean-union-operation)
    (not (call rects-overlap a b))
  )
  (default
    (not (call rects-have-area-overlap a b))
  )
)

(fn-expr _ has-arrangement-intersection _
  (param intersections (list CurveIntersection))
  (param t1 PointOnCurve)
  (param t2 PointOnCurve)
  (call some intersections (:where (and (< (call abs (- (. each t1) t1)) tolerance) (< (call abs (- (. each t2) t2)) tolerance))))
)

(fn-expr _ boolean-class-span-x Coord
  (param span BooleanClassSpan)
  (param t PointOnCurve)
  (case? (== (. span type) .segment-type-line)
    (+ (. span x1) (* (- (. span x2) (. span x1)) t))
  )
  (default
    (call cubic-evaluate-control-1d (. span x1) (. span hox) (. span hix) (. span x2) t)
  )
)

(fn-expr _ boolean-class-span-y Coord
  (param span BooleanClassSpan)
  (param t PointOnCurve)
  (case? (== (. span type) .segment-type-line)
    (+ (. span y1) (* (- (. span y2) (. span y1)) t))
  )
  (default
    (call cubic-evaluate-control-1d (. span y1) (. span hoy) (. span hiy) (. span y2) t)
  )
)

(fn-expr _ boolean-class-span-dx _
  (param span BooleanClassSpan)
  (param t PointOnCurve)
  (case? (== (. span type) .segment-type-line)
    (- (. span x2) (. span x1))
  )
  (default
    (call cubic-derivative-1d (. coeffs a) (. coeffs b) (. coeffs c) t
      (block
        (lazy coeffs (call cubic-coefficients-1d (. span x1) (. span hox) (. span hix) (. span x2)))
      )
    )
  )
)

(fn-expr _ boolean-class-span-dy _
  (param span BooleanClassSpan)
  (param t PointOnCurve)
  (case? (== (. span type) .segment-type-line)
    (- (. span y2) (. span y1))
  )
  (default
    (call cubic-derivative-1d (. coeffs a) (. coeffs b) (. coeffs c) t
      (block
        (lazy coeffs (call cubic-coefficients-1d (. span y1) (. span hoy) (. span hiy) (. span y2)))
      )
    )
  )
)

(fn-expr _ boolean-scalars-bounds _
  (param scalars CurveRangeScalars)
  (case? (== (. scalars type) .segment-type-line)
    (call Rect left top (- right left) (- bottom top)
      (block
        (lazy left (call min (. scalars x1) (. scalars x2)))
        (lazy top (call min (. scalars y1) (. scalars y2)))
        (lazy right (call max (. scalars x1) (. scalars x2)))
        (lazy bottom (call max (. scalars y1) (. scalars y2)))
      )
    )
  )
  (default
    (call Rect (. bounds min-x) (. bounds min-y) (- (. bounds max-x) (. bounds min-x)) (- (. bounds max-y) (. bounds min-y))
      (block
        (lazy bounds
          (call cubic-bounds-xy
            (block
              (arg (. scalars x1))
              (arg (. scalars y1))
              (arg (. scalars hox))
              (arg (. scalars hoy))
              (arg (. scalars hix))
              (arg (. scalars hiy))
              (arg (. scalars x2))
              (arg (. scalars y2))
            )
          )
        )
      )
    )
  )
)

(fn-expr _ rect-covers-point _
  (param rect Rect)
  (param x Coord)
  (param y Coord)
  (and within-x (>= y (- (. rect top) tolerance)) (<= y (+ (. rect bottom) tolerance)))
  (where
    (lazy within-x (and (>= x (- (. rect left) tolerance)) (<= x (+ (. rect right) tolerance))))
  )
)

(fn-do _ cubic-parameter-near PointOnCurve
  (param x Coord)
  (param y Coord)
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (let cx (call cubic-coefficients-1d x1 hox hix x2))
  (let cy (call cubic-coefficients-1d y1 hoy hiy y2))
  (let t 0.0)
  (let best (+ (* (- x1 x) (- x1 x)) (* (- y1 y) (- y1 y))))
  (for (in step (..< 1 17))
    (let sample (/ (as step Float) 16.0))
    (let distance (call cubic-distance-squared cx cy x1 y1 x y sample))
    (if (< distance best)
      (= best distance)
      (= t sample)
    )
  )
  (let hull (+ (call abs (- hox x1)) (call abs (- hoy y1)) (call abs (- hix hox)) (call abs (- hiy hoy))))
  (= hull (+ hull (call abs (- x2 hix)) (call abs (- y2 hiy))))
  (let reach (+ (/ (* 3.0 hull) 16.0) tolerance))
  (return-if -1 (if (> best (* reach reach))))
  (blank)
  (let low (call max (- t 0.0625) 0.0))
  (let high (call min (+ t 0.0625) 1.0))
  (let guess t)
  (for (in iteration (..< 0 8))
    (let dx (- (call cubic-evaluate-1d (. cx a) (. cx b) (. cx c) x1 guess) x))
    (let dy (- (call cubic-evaluate-1d (. cy a) (. cy b) (. cy c) y1 guess) y))
    (let vx (call cubic-derivative-1d (. cx a) (. cx b) (. cx c) guess))
    (let vy (call cubic-derivative-1d (. cy a) (. cy b) (. cy c) guess))
    (let ax (+ (* 6.0 (. cx a) guess) (* 2.0 (. cx b))))
    (let ay (+ (* 6.0 (. cy a) guess) (* 2.0 (. cy b))))
    (let slope (+ (* vx vx) (* vy vy) (* dx ax) (* dy ay)))
    (if (<= slope 0)
      (break)
    )
    (let next (call min (call max (- guess (/ (+ (* dx vx) (* dy vy)) slope)) low) high))
    (let moved (call abs (- next guess)))
    (= guess next)
    (if (< moved tolerance-tight)
      (break)
    )
  )
  (return-if guess (if (< (call cubic-distance-squared cx cy x1 y1 x y guess) (* tolerance tolerance))))
  (blank)
  (let a (- high (* golden-ratio (- high low))))
  (let b (+ low (* golden-ratio (- high low))))
  (let fa (call cubic-distance-squared cx cy x1 y1 x y a))
  (let fb (call cubic-distance-squared cx cy x1 y1 x y b))
  (for (in iteration (..< 0 48))
    (if (< (- high low) tolerance-tight)
      (break)
    )
    (if (< fa fb)
      (= high b)
      (= b a)
      (= fb fa)
      (= a (- high (* golden-ratio (- high low))))
      (= fa (call cubic-distance-squared cx cy x1 y1 x y a))
      (else
        (= low a)
        (= a b)
        (= fa fb)
        (= b (+ low (* golden-ratio (- high low))))
        (= fb (call cubic-distance-squared cx cy x1 y1 x y b))
      )
    )
  )
  (= t (* (+ low high) 0.5))
  (return-if t (if (< (call cubic-distance-squared cx cy x1 y1 x y t) (* tolerance tolerance))))
  (return -1)
)

(fn-expr _ cubic-distance-squared Coord
  (param cx CubicCoefficients1D)
  (param cy CubicCoefficients1D)
  (param x1 Coord)
  (param y1 Coord)
  (param x Coord)
  (param y Coord)
  (param t PointOnCurve)
  (+ (* dx dx) (* dy dy))
  (where
    (lazy dx (- (call cubic-evaluate-1d (. cx a) (. cx b) (. cx c) x1 t) x))
    (lazy dy (- (call cubic-evaluate-1d (. cy a) (. cy b) (. cy c) y1 t) y))
  )
)

(fn-do _ append-span-edge _
  (param path Path)
  (param edge BooleanSpanEdge)
  (if (not (. path count))
    (call (. path move-to) (. edge start-x) (. edge start-y))
  )
  (blank)
  (if (== (. edge source type) .segment-type-line)
    (call (. path line-to) (. edge end-x) (. edge end-y))
    (else
      (call append-cubic-span-scalars path edge)
    )
  )
)

(fn-do _ append-cubic-span-scalars _
  (param path Path)
  (param edge BooleanSpanEdge)
  (let source (. edge source))
  (let t1 (. edge t1))
  (let t2 (. edge t2))
  (let x1 (. source x1))
  (let y1 (. source y1))
  (let hox (. source hox))
  (let hoy (. source hoy))
  (let hix (. source hix))
  (let hiy (. source hiy))
  (let x2 (. source x2))
  (let y2 (. source y2))
  (blank)
  (if (> t1 0)
    (let u (- 1 t1))
    (let p3x (+ (* u x1) (* t1 hox)))
    (let p3y (+ (* u y1) (* t1 hoy)))
    (let p4x (+ (* u hox) (* t1 hix)))
    (let p4y (+ (* u hoy) (* t1 hiy)))
    (let p5x (+ (* u hix) (* t1 x2)))
    (let p5y (+ (* u hiy) (* t1 y2)))
    (let p6x (+ (* u p3x) (* t1 p4x)))
    (let p6y (+ (* u p3y) (* t1 p4y)))
    (let p7x (+ (* u p4x) (* t1 p5x)))
    (let p7y (+ (* u p4y) (* t1 p5y)))
    (let p8x (+ (* u p6x) (* t1 p7x)))
    (let p8y (+ (* u p6y) (* t1 p7y)))
    (blank)
    (= x1 p8x)
    (= y1 p8y)
    (= hox p7x)
    (= hoy p7y)
    (= hix p5x)
    (= hiy p5y)
  )
  (blank)
  (if (< t2 1)
    (let t (/ (- t2 t1) (- 1 t1)))
    (let u (- 1 t))
    (let p3x (+ (* u x1) (* t hox)))
    (let p3y (+ (* u y1) (* t hoy)))
    (let p4x (+ (* u hox) (* t hix)))
    (let p4y (+ (* u hoy) (* t hiy)))
    (let p5x (+ (* u hix) (* t x2)))
    (let p5y (+ (* u hiy) (* t y2)))
    (let p6x (+ (* u p3x) (* t p4x)))
    (let p6y (+ (* u p3y) (* t p4y)))
    (let p7x (+ (* u p4x) (* t p5x)))
    (let p7y (+ (* u p4y) (* t p5y)))
    (let p8x (+ (* u p6x) (* t p7x)))
    (let p8y (+ (* u p6y) (* t p7y)))
    (blank)
    (= hox p3x)
    (= hoy p3y)
    (= hix p6x)
    (= hiy p6y)
    (= x2 p8x)
    (= y2 p8y)
  )
  (blank)
  (if (. edge reverse)
    (if (. edge closes)
      (= x1 (. edge end-x))
      (= y1 (. edge end-y))
    )
    (call (. path cubic-curve-to) hix hiy hox hoy x1 y1)
    (else
      (if (. edge closes)
        (= x2 (. edge end-x))
        (= y2 (. edge end-y))
      )
      (call (. path cubic-curve-to) hox hoy hix hiy x2 y2)
    )
  )
)

(fn-expr _ near-span-coords _
  (param ax Coord)
  (param ay Coord)
  (param bx Coord)
  (param by Coord)
  (< (+ (* dx dx) (* dy dy)) 0.000001)
  (where
    (lazy dx (- ax bx))
    (lazy dy (- ay by))
  )
)

(fn-do _ has-cubics _
  (param path Path)
  (let span (. path commands))
  (return (call some (..< 0 (. span command-count)) (:where (== ([] (. span verbs) each) .path-verb-cubic))))
)

(fn-expr _ cubic-point Coord
  (param a Coord)
  (param ho Coord)
  (param hi Coord)
  (param b Coord)
  (param t Float)
  (+ (* u u u a) (* 3.0 u u t ho) (* 3.0 u t t hi) (* t t t b))
  (where
    (lazy u (- 1.0 t))
  )
)

(fn-do _ polygons-have-crossings _
  (param points1 (list Point))
  (param points2 (list Point))
  (for (in i (..< 0 (. points1 length)))
    (let start1 ([] points1 i))
    (let end1 ([] points1 (% (+ i 1) (. points1 length))))
    (blank)
    (for (in j (..< 0 (. points2 length)))
      (let start2 ([] points2 j))
      (let end2 ([] points2 (% (+ j 1) (. points2 length))))
      (let intr (call segment-crossing start1 end1 start2 end2))
      (if intr
        (let t1 (call segment-parameter intr start1 end1))
        (let t2 (call segment-parameter intr start2 end2))
        (let middle1 (and (> t1 0.00001) (< t1 0.99999)))
        (let middle2 (and (> t2 0.00001) (< t2 0.99999)))
        (return-if true (if (or middle1 middle2)))
      )
      (return-if true (if (call segments-share-length start1 end1 start2 end2)))
    )
  )
  (blank)
  (return false)
)

(fn-expr _ segment-crossing _
  (param start1 Point)
  (param end1 Point)
  (param start2 Point)
  (param end2 Point)
  (if-expr parallel null (call intersect-lines start1 end1 start2 end2))
  (where
    (lazy parallel
      (call lines-are-parallel
        (block
          (arg (. start1 x))
          (arg (. start1 y))
          (arg (. end1 x))
          (arg (. end1 y))
          (arg (. start2 x))
          (arg (. start2 y))
          (arg (. end2 x))
          (arg (. end2 y))
        )
      )
    )
  )
)

(fn-expr _ lines-are-parallel _
  (param ax1 Coord)
  (param ay1 Coord)
  (param ax2 Coord)
  (param ay2 Coord)
  (param bx1 Coord)
  (param by1 Coord)
  (param bx2 Coord)
  (param by2 Coord)
  (<= (* cross cross) (* 0.000000000000000001 (+ (* adx adx) (* ady ady)) (+ (* bdx bdx) (* bdy bdy))))
  (where
    (lazy cross (- (* adx bdy) (* ady bdx)))
    (lazy adx (- ax2 ax1))
    (lazy ady (- ay2 ay1))
    (lazy bdx (- bx2 bx1))
    (lazy bdy (- by2 by1))
  )
)

(fn-expr _ segments-share-length _
  (param start1 Point)
  (param end1 Point)
  (param start2 Point)
  (param end2 Point)
  (case? (< denom 0.00001)
    false
  )
  (case? (>= (call abs (- (* dx (- (. start2 y) (. start1 y))) (* dy (- (. start2 x) (. start1 x))))) 0.00001)
    false
  )
  (case? (>= (call abs (- (* dx (- (. end2 y) (. start1 y))) (* dy (- (. end2 x) (. start1 x))))) 0.00001)
    false
  )
  (default
    (> (- (call min (call max t1 t2) 1.0) (call max (call min t1 t2) 0.0)) 0.00001)
  )
  (where
    (lazy dx (- (. end1 x) (. start1 x)))
    (lazy dy (- (. end1 y) (. start1 y)))
    (lazy denom (+ (* dx dx) (* dy dy)))
    (lazy t1 (/ (+ (* dx (- (. start2 x) (. start1 x))) (* dy (- (. start2 y) (. start1 y)))) denom))
    (lazy t2 (/ (+ (* dx (- (. end2 x) (. start1 x))) (* dy (- (. end2 y) (. start1 y)))) denom))
  )
)

(fn-expr _ segment-parameter _
  (param point Point)
  (param start Point)
  (param end Point)
  (case? (< denom 0.00001)
    0
  )
  (default
    (/ dot denom)
  )
  (where
    (lazy dot (+ (* px dx) (* py dy)))
    (lazy denom (+ (* dx dx) (* dy dy)))
    (lazy px (- (. point x) (. start x)))
    (lazy py (- (. point y) (. start y)))
    (lazy dx (- (. end x) (. start x)))
    (lazy dy (- (. end y) (. start y)))
  )
)

(fn-expr _ point-at-parameter _
  (param start Point)
  (param end Point)
  (param t Float)
  (call Point
    (block
      (arg (+ (. start x) (* (- (. end x) (. start x)) t)))
      (arg (+ (. start y) (* (- (. end y) (. start y)) t)))
    )
  )
)

(fn-expr _ should-include-fragment _
  (param operation BooleanOperation)
  (param source _)
  (param inside-other Bool)
  (case? (== operation .boolean-union-operation)
    (not inside-other)
  )
  (case? (== operation .boolean-intersect-operation)
    inside-other
  )
  (case? (== operation .boolean-clip-operation)
    inside-other
  )
  (case? (== source 1)
    (not inside-other)
  )
  (default
    inside-other
  )
)

(fn-expr _ should-include-line-fragment Bool
  (param operation BooleanOperation)
  (param source _)
  (param points (list Point))
  (param other-points (list Point))
  (param start Point)
  (param end Point)
  (case? (not (call polygon-boundary-contains-point other-points sample))
    (call should-include-fragment operation source (call polygon-contains-point other-points sample))
  )
  (case? (== operation .boolean-subtract-operation)
    (and (== source 1) (not same-side))
  )
  (default
    (and (== source 1) same-side)
  )
  (where
    (lazy sample (call point-at-parameter start end 0.5))
    (lazy normal (* (call Point (- (. start y) (. end y)) (- (. end x) (. start x))) 0.001))
    (lazy inward (if-expr forward-inside (+ sample normal) (- sample normal)))
    (lazy forward-inside (call polygon-contains-point points (+ sample normal)))
    (lazy same-side (call polygon-contains-point other-points inward))
  )
)

(fn-do _ polygon-boundary-contains-point _
  (param points (list Point))
  (param point Point)
  (let j (- (. points length) 1))
  (for (in i (..< 0 (. points length)))
    (return-if true (if (call point-on-segment point ([] points i) ([] points j))))
    (blank)
    (= j i)
  )
  (return false)
)

(fn-expr _ should-reverse-fragment _
  (param operation BooleanOperation)
  (param source _)
  (and (== operation .boolean-subtract-operation) (== source 2))
)

(fn-do _ polygon-contains-point _
  (param points (list Point))
  (param point Point)
  (let inside false)
  (let j (- (. points length) 1))
  (blank)
  (for (in i (..< 0 (. points length)))
    (let a ([] points i))
    (let b ([] points j))
    (return-if true (if (call point-on-segment point a b)))
    (blank)
    (let crosses-y (!= (> (. a y) (. point y)) (> (. b y) (. point y))))
    (if crosses-y
      (let x-at-y (+ (/ (* (- (. b x) (. a x)) (- (. point y) (. a y))) (- (. b y) (. a y))) (. a x)))
      (if (< (. point x) x-at-y)
        (= inside (not inside))
      )
    )
    (blank)
    (= j i)
  )
  (blank)
  (return inside)
)

(fn-expr _ point-on-segment _
  (param point Point)
  (param start Point)
  (param end Point)
  (and near-line within-x within-y)
  (where
    (lazy near-line (< (call abs cross) 0.00001))
    (lazy cross (- (* dx py) (* dy px)))
    (lazy dx (- (. end x) (. start x)))
    (lazy dy (- (. end y) (. start y)))
    (lazy px (- (. point x) (. start x)))
    (lazy py (- (. point y) (. start y)))
    (lazy within-x (and (>= (. point x) min-x) (<= (. point x) max-x)))
    (lazy min-x (- (call min (. start x) (. end x)) 0.00001))
    (lazy max-x (+ (call max (. start x) (. end x)) 0.00001))
    (lazy within-y (and (>= (. point y) min-y) (<= (. point y) max-y)))
    (lazy min-y (- (call min (. start y) (. end y)) 0.00001))
    (lazy max-y (+ (call max (. start y) (. end y)) 0.00001))
  )
)
