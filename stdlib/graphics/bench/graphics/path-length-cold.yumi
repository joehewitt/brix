`benchmark.meta description: Computes path length on fresh paths to measure point-table construction.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/path
/graphics/primitives
/math

. checksum = 0 as Size

for pass in 0 .. < 36
    . path = line-path(pass)
    checksum += numeric-check(path.length)

-- "bench-result graphics/path-length-cold checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do line-path
    - seed Int

. path = Path()
. base = seed as Float
path.move-to(base % 31, base % 23)
for i in 0 .. < 80
    . f = i as Float
    path.line-to(base + f * 2, f * 5 + (base % 13))
= path

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
