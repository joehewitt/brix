; benchmark.meta description: Builds, retains, compiles, and incrementally recompiles VectorGroup scenes containing 10k and 100k lightweight path nodes.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/vector)
(import /graphics/vector-group)
(import /graphics/vectorgeometry)
(import /time/timer)
(blank)

(main
  (let checksum Size)
  (+= checksum (call run-vector-image-scale 10000))
  (+= checksum (call run-vector-image-scale 100000))
  (print (str "bench-result graphics/vector-image-scale checksum=" checksum))
)

(fn-do _ run-vector-image-scale Size
  (param count Size)
  (let viewport (call Rect 0 0 1000 1000))
  (let live-before (call vector-scene-live-bytes))
  (let build-start (call monotonic-time-nanoseconds))
  (let scene (call build-vector-scene count))
  (let build-us (/ (- (call monotonic-time-nanoseconds) build-start) 1000))
  (let live-after (call vector-scene-live-bytes))
  (let live-bytes-per-path (/ (- live-after live-before) count))
  (blank)
  (let compile-start (call monotonic-time-nanoseconds))
  (call (. scene group compile-vector-geometry) viewport)
  (let compile-us (/ (- (call monotonic-time-nanoseconds) compile-start) 1000))
  (blank)
  (let update-start (call monotonic-time-nanoseconds))
  (= (. scene target rect) (call Rect 7 9 3 4))
  (call (. scene group checkpoint))
  (call (. scene group compile-vector-geometry) viewport)
  (let update-us (/ (- (call monotonic-time-nanoseconds) update-start) 1000))
  (blank)
  (if (== count 10000)
    (probe-count graphics.bench.vector-scene.build-us-10k build-us)
    (probe-count graphics.bench.vector-scene.live-bytes-per-path-10k live-bytes-per-path)
    (probe-count graphics.bench.vector-scene.compile-us-10k compile-us)
    (probe-count graphics.bench.vector-scene.leaf-recompile-us-10k update-us)
    (else
      (probe-count graphics.bench.vector-scene.build-us-100k build-us)
      (probe-count graphics.bench.vector-scene.live-bytes-per-path-100k live-bytes-per-path)
      (probe-count graphics.bench.vector-scene.compile-us-100k compile-us)
      (probe-count graphics.bench.vector-scene.leaf-recompile-us-100k update-us)
    )
  )
  (blank)
  (let result (+ (. scene group vector-geometry-chunk-count) (. scene group items length)))
  (call (. scene group close))
  (call markup-release (. scene group))
  (return result)
)

(fn-do _ build-vector-scene VectorScaleScene
  (param count Size)
  (let group (call VectorGroup))
  (= (. group fill) "#2563eb")
  (= (. group stroke) (. Stroke none))
  (call (. group begin-update))
  (let target (? Rectangle))
  (for (in index (..< 0 count))
    (let x (as (% index 1000) F64))
    (let y (as (/ index 1000) F64))
    (let rectangle (call Rectangle (call Rect x y 1 1)))
    (+= group rectangle)
    (if (== index (/ count 2))
      (= target rectangle)
    )
  )
  (call (. group end-update))
  (return (call VectorScaleScene group (!! target)))
)

(fn-do _ vector-scene-live-bytes Size
  (call C:brixCollect)
  (call C:brixCollect)
  (return (as (call C:brixGCLiveByteCount) Size))
)

(type _ VectorScaleScene (is Tuple)
  (prop + group VectorGroup)
  (prop + target Rectangle)
)
