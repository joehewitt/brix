; benchmark.meta description: Exercises point arithmetic, matrix composition, inversion, and transforms.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)

(main
  (let checksum (as 0 Size))
  (let matrix (call matrix-from-identity))
  (let source (list Coord))
  (let dest (list Coord))
  (blank)
  (for (in i (..< 0 256))
    (let f (as i Float))
    (+= source (* f 1.5))
    (+= source (+ (* f 0.75) 3))
    (+= dest 0)
    (+= dest 0)
  )
  (blank)
  (for (in pass (..< 0 240))
    (let f (as pass Float))
    (= matrix (call (. matrix translate) (tuple (% f 17) (- (% f 11) 5))))
    (= matrix (call (. matrix scale) (call Dimensions 1.001 0.999)))
    (= matrix (call (. matrix rotate) (/ (% f 31) 1000.0) (tuple 30.0 40.0)))
    (blank)
    (let point (call Point (% f 101) (% (* f 3) 97)))
    (let transformed (call (. matrix transform) point))
    (+= checksum (+ (call numeric-check (. transformed x)) (call numeric-check (. transformed y))))
    (blank)
    (call (. matrix transform-coordinates) source 0 dest 0 128)
    (+= checksum (call numeric-check ([] dest (% pass (. dest length)))))
  )
  (blank)
  (print (str "bench-result graphics/point-matrix-transform checksum=" checksum))
)

(fn-expr _ numeric-check Size
  (param value Coord)
  (% (as (call abs (* value 1000)) Size) 1000003)
)
