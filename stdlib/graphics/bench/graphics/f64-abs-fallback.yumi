`benchmark.meta description: Measures the ordinary F64 absolute-value call seam for intrinsic comparison.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core
/math.h

. checksum = 0.0
. operations = 4000000

for i in 0 .. < operations
    . value = ((i % 1009) - 504) as F64
    checksum += fallback-abs(value)

. checksum-result = (checksum * 1000.0) as Size
-- "bench-result graphics/f64-abs-fallback checksum=$checksum-result"

━━━━━━━━━━━━━━━━━━━━
_ fallback-abs F64
    - value F64

C:fabs(value)
