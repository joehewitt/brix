; benchmark.meta description: Times VectorDocumentRenderer full builds, single-edit syncs, restore syncs, and direct CoreGraphics paints for 1000 square networks in 10 layers.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: vector-document,compile-timing
(blank)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/document)
(import /graphics/document-render)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /time/timer)
(blank)

(main
  (let doc (use (call VectorDocument)))
  (call (. doc set-stroke) (. doc root) (call RGBA "#222222"))
  (call (. doc set-stroke-width) (. doc root) 1)
  (let shapes (list U64))
  (let layer (. doc root))
  (for (in index (..< 0 1000))
    (if (== (% index 100) 0)
      (= layer (call (. doc create-group) (. doc root) (str "Layer " (/ index 100))))
      (call (. doc set-fill) layer (call RGBA (/ (as (/ index 100) F64) 10) 0.4 0.8 1))
    )
    (let x (* (% index 40) 20.0))
    (let y (* (/ index 40) 20.0))
    (+= shapes (call (. doc add-path) layer (call rectangle (call Rect x y 12 12)) (str "Square " index)))
  )
  (blank)
  (let renderer (use (call VectorDocumentRenderer doc)))
  (let build-start (call monotonic-time-nanoseconds))
  (call (. renderer sync))
  (let build-us (/ (- (call monotonic-time-nanoseconds) build-start) 1000))
  (let checksum (. renderer last-built))
  (blank)
  (let original (use (call (. doc snapshot))))
  (let repeats Size 50)
  (let edit-ns U64)
  (let restore-ns U64)
  (let restore-built Size 0)
  (for (in repeat (..< 0 repeats))
    (call (. doc set-opacity) ([] shapes (% (* repeat 37) 1000)) 0.5)
    (call (. doc set-fill) ([] shapes (% (* repeat 53) 1000)) (call RGBA 1 (/ (as repeat F64) 50) 0 1))
    (let edit-start (call monotonic-time-nanoseconds))
    (call (. renderer sync))
    (+= edit-ns (- (call monotonic-time-nanoseconds) edit-start))
    (+= checksum (. renderer last-built))
    (call (. doc restore) original)
    (let restore-start (call monotonic-time-nanoseconds))
    (call (. renderer sync))
    (+= restore-ns (- (call monotonic-time-nanoseconds) restore-start))
    (+= restore-built (. renderer last-built))
  )
  (blank)
  (let canvas (call RasterCanvas 800 520 1))
  (let paint-ns U64)
  (do-use canvas
    (for (in repeat (..< 0 20))
      (call (. canvas erase) (call RGBA 1 1 1 1))
      (let paint-start (call monotonic-time-nanoseconds))
      (call (. renderer paint) canvas)
      (+= paint-ns (- (call monotonic-time-nanoseconds) paint-start))
    )
  )
  (blank)
  (probe-count graphics.bench.document.render-build-us build-us)
  (probe-count graphics.bench.document.render-edit-sync-us (/ edit-ns 1000 repeats))
  (probe-count graphics.bench.document.render-restore-sync-us (/ restore-ns 1000 repeats))
  (probe-count graphics.bench.document.render-restore-built restore-built)
  (probe-count graphics.bench.document.render-paint-us (/ paint-ns 1000 20))
  (print (str "bench-result graphics/vector-document-render checksum=" checksum))
)
