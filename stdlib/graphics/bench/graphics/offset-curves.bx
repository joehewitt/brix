; benchmark.meta description: Offsets cubic and arc-heavy paths through the public offset API.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/graphic)
(import /graphics/offset)
(import /graphics/path)
(import /graphics/path-set)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/stroke)
(import /math)
(blank)

(main
  (let checksum (as 0 Size))
  (blank)
  (for (in pass (..< 0 140))
    (let source (call curve-path pass))
    (let layer (call offset-path (call PathSet (list source)) (+ 5.0 (% pass 5)) .round-join-type 5))
    (+= checksum (+ (. source count) (call layer-score layer)))
  )
  (blank)
  (print (str "bench-result graphics/offset-curves checksum=" checksum))
)

(fn-do _ curve-path _
  (param seed Int)
  (let base (as seed Float))
  (let kind (% seed 4))
  (if (== kind 0)
    (return (call circle (tuple (+ 80 (% base 9)) (+ 80 (% base 7))) (+ 32 (% base 11))))
    (else-if (== kind 1)
      (let path (call ellipse (tuple 84 82) (call Dimensions (+ 48 (% base 5)) (+ 30 (% base 7)))))
      (call (. path rotate) (+ -18deg (* (% base 12) 0.4deg)) (call Point 84 82))
      (return path)
    )
    (else-if (== kind 2)
      (return (call cubic-snake base))
    )
  )
  (blank)
  (return (call petal-loop (call Point (+ 90 (% base 13)) (+ 84 (% base 9))) (+ 46 (% base 7))))
)

(fn-do _ cubic-snake _
  (param base Float)
  (let center (call Point (+ 80 (% base 11)) (+ 82 (% base 5))))
  (let radius (+ 62 (% base 9)))
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.86) (* radius 0.34))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 0.65) (* (- radius) 0.85))))
      (arg (+ center (tuple (* (- radius) 0.18) (* radius 0.82))))
      (arg (+ center (tuple (* radius 0.06) (* (- radius) 0.08))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 0.34) (* (- radius) 1.04))))
      (arg (+ center (tuple (* radius 0.76) (* radius 0.74))))
      (arg (+ center (tuple (* radius 0.88) (* (- radius) 0.24))))
    )
  )
  (return path)
)

(fn-do _ petal-loop _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple 0 (* (- radius) 0.9))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 1.25) (* (- radius) 0.72))))
      (arg (+ center (tuple (* radius 0.35) (* radius 0.28))))
      (arg (+ center (tuple (* radius 0.78) (* radius 0.72))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 0.18) (* radius 1.08))))
      (arg (+ center (tuple (* (- radius) 0.4) (* radius 0.34))))
      (arg (+ center (tuple (* (- radius) 0.82) (* radius 0.66))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 1.22) (* radius 0.08))))
      (arg (+ center (tuple (* (- radius) 0.55) (* (- radius) 0.72))))
      (arg (+ center (tuple 0 (* (- radius) 0.9))))
    )
  )
  (call (. path close))
  (return path)
)

(fn-do _ layer-score _
  (param layer PathSet)
  (let score Size)
  (for (in path (. layer paths))
    (+= score (call path-score path))
  )
  (return score)
)

(fn-expr _ path-score Size
  (param path Path)
  (case? (not (. path count))
    0
  )
  (default
    (+ (. path count) (call numeric-check (. path last-point x)) (call numeric-check (. path last-point y)))
  )
)

(fn-expr _ numeric-check Size
  (param value Coord)
  (% (as (call abs (* value 1000)) Size) 1000003)
)
