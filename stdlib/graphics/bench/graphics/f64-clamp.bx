; benchmark.meta description: Measures canonical F64 min/max clamp lowering in a hot loop.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /math)
(blank)

(main
  (let checksum 0.0)
  (let operations 4000000)
  (blank)
  (for (in i (..< 0 operations))
    (let value (as (- (% i 1009) 504) F64))
    (+= checksum (call min (call max value -125.0) 125.0))
  )
  (blank)
  (let checksum-result (as (* (+ checksum (* operations 1000.0)) 1000.0) Size))
  (print (str "bench-result graphics/f64-clamp checksum=" checksum-result))
)
