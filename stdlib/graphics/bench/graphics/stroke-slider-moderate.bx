; benchmark.meta description: Recomputes strokes for a moderate fixed graphics scene across a slider-width sweep.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,graphics-fps,compile-timing
(blank)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/stroke)
(import /math)
(blank)

(main
  (let sources (call moderate-slider-sources))
  (let checksum (as (. sources length) Size))
  (blank)
  (for (in frame (..< 0 32))
    (probe-count graphics.frame.frames)
    (let width (call slider-width frame 2 30))
    (for (in i (..< 0 (. sources length)))
      (probe-count graphics.frame.items)
      (let source ([] sources i))
      (let stroked (call stroke source width .center (call slider-join i) (call slider-cap i) 5 0))
      (+= checksum (+ (. source count) (call path-score stroked)))
    )
  )
  (blank)
  (print (str "bench-result graphics/stroke-slider-moderate checksum=" checksum))
)

(fn-do _ moderate-slider-sources _
  (let center (call Point 120 100))
  (let radius 72.0)
  (let paths (list Path))
  (+= paths (call line (+ center (tuple (* (- radius) 0.82) (* (- radius) 0.22))) (+ center (tuple (* radius 0.82) (* radius 0.22)))))
  (blank)
  (let rect (call rectangle (call Rect (- (. center x) (* radius 0.72)) (- (. center y) (* radius 0.5)) (* radius 1.44) radius)))
  (call (. rect rotate) -9deg center)
  (+= paths rect)
  (blank)
  (let tri (call polygon 3 (* radius 1.82) center))
  (call (. tri rotate) 18deg center)
  (+= paths tri)
  (blank)
  (+= paths (call circle center (* radius 0.7)))
  (blank)
  (let pent (call polygon 5 (* radius 1.78) center))
  (call (. pent rotate) -12deg center)
  (+= paths pent)
  (blank)
  (+= paths (call moderate-zigzag center radius))
  (+= paths (call bounded-spiral center (* radius 0.95) 3.4 72 -45deg))
  (+= paths (call cubic-snake center radius))
  (+= paths (call rosette center (* radius 0.92) (* radius 0.28) 9 -18deg))
  (+= paths (call lissajous-loop center (* radius 0.9)))
  (+= paths (call petal-loop center radius))
  (+= paths (call comet-loop center radius))
  (return paths)
)

(fn-expr _ slider-width Length
  (param frame Int)
  (param min-width Length)
  (param max-width Length)
  (+ min-width (* (- max-width min-width) (/ (as frame Float) 31)))
)

(fn-expr _ slider-join _
  (param seed _)
  (case? (== kind 0)
    .bevel-join-type
  )
  (case? (== kind 1)
    .miter-join-type
  )
  (default
    .round-join-type
  )
  (where
    (lazy kind (% seed 3))
  )
)

(fn-expr _ slider-cap LineCap
  (param seed _)
  (if-expr (== (% seed 2) 0) .round .square)
)

(fn-do _ moderate-zigzag _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.82) (* (- radius) 0.45))))
  (call (. path line-to) (+ center (tuple (* (- radius) 0.42) (* radius 0.36))))
  (call (. path line-to) (+ center (tuple (* (- radius) 0.05) (* (- radius) 0.24))))
  (call (. path line-to) (+ center (tuple (* radius 0.34) (* radius 0.48))))
  (call (. path line-to) (+ center (tuple (* radius 0.82) (* (- radius) 0.34))))
  (return path)
)

(fn-do _ cubic-snake _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.86) (* radius 0.34))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 0.65) (* (- radius) 0.85))))
      (arg (+ center (tuple (* (- radius) 0.18) (* radius 0.82))))
      (arg (+ center (tuple (* radius 0.06) (* (- radius) 0.08))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 0.34) (* (- radius) 1.04))))
      (arg (+ center (tuple (* radius 0.76) (* radius 0.74))))
      (arg (+ center (tuple (* radius 0.88) (* (- radius) 0.24))))
    )
  )
  (return path)
)

(fn-do _ bounded-spiral _
  (param center Point)
  (param radius Length)
  (param coils Float)
  (param steps Int)
  (param rotation Radians)
  (let path (call Path))
  (for (in i (..< 0 steps))
    (let t (/ (as i Float) (as (- steps 1) Float)))
    (let angle (+ rotation (* t coils π 2)))
    (let point (call (. center translate-at-angle) angle (* radius t)))
    (if (== i 0)
      (call (. path move-to) point)
      (else
        (call (. path line-to) point)
      )
    )
  )
  (blank)
  (return path)
)

(fn-do _ rosette _
  (param center Point)
  (param outer-radius Length)
  (param inner-radius Length)
  (param lobes Int)
  (param rotation Radians)
  (let path (call Path))
  (let count (* lobes 2))
  (let step (/ (* π 2) count))
  (blank)
  (for (in i (..< 0 count))
    (let a1 (+ rotation (* step i)))
    (let a2 (+ rotation (* step (+ i 1))))
    (let r1 (if-expr (== (% i 2) 0) outer-radius inner-radius))
    (let r2 (if-expr (== (% (+ i 1) 2) 0) outer-radius inner-radius))
    (let bulge (* outer-radius (+ 0.52 (* (as (% i 3) Float) 0.08))))
    (let p1 (call (. center translate-at-angle) a1 r1))
    (let p2 (call (. center translate-at-angle) a2 r2))
    (let h1 (call (. center translate-at-angle) (+ a1 (* step 0.42)) (+ r1 bulge)))
    (let h2 (call (. center translate-at-angle) (- a2 (* step 0.42)) (+ r2 bulge)))
    (blank)
    (if (== i 0)
      (call (. path move-to) p1)
    )
    (blank)
    (call (. path cubic-curve-to) h1 h2 p2)
  )
  (blank)
  (call (. path close))
  (return path)
)

(fn-do _ lissajous-loop _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (let first true)
  (for (in t (..< 0.0 (* π 2.0) (by: 0.11)))
    (let point
      (call Point
        (block
          (arg (+ (. center x) (* (call sin (+ (* t 3.0) 0.35)) radius)))
          (arg (+ (. center y) (* (call sin (* t 4.0)) radius 0.72)))
        )
      )
    )
    (if first
      (call (. path move-to) point)
      (= first false)
      (else
        (call (. path line-to) point)
      )
    )
  )
  (blank)
  (call (. path close))
  (return path)
)

(fn-do _ petal-loop _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple 0 (* (- radius) 0.9))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 1.25) (* (- radius) 0.72))))
      (arg (+ center (tuple (* radius 0.35) (* radius 0.28))))
      (arg (+ center (tuple (* radius 0.78) (* radius 0.72))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 0.18) (* radius 1.08))))
      (arg (+ center (tuple (* (- radius) 0.4) (* radius 0.34))))
      (arg (+ center (tuple (* (- radius) 0.82) (* radius 0.66))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 1.22) (* radius 0.08))))
      (arg (+ center (tuple (* (- radius) 0.55) (* (- radius) 0.72))))
      (arg (+ center (tuple 0 (* (- radius) 0.9))))
    )
  )
  (call (. path close))
  (return path)
)

(fn-do _ comet-loop _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.9) 0)))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 0.5) (* (- radius) 1.05))))
      (arg (+ center (tuple (* radius 0.32) (* (- radius) 0.62))))
      (arg (+ center (tuple (* radius 0.68) (* (- radius) 0.18))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 1.24) (* radius 0.5))))
      (arg (+ center (tuple (* (- radius) 0.18) (* radius 0.95))))
      (arg (+ center (tuple (* (- radius) 0.05) (* radius 0.04))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 0.34) (* (- radius) 0.32))))
      (arg (+ center (tuple (* (- radius) 0.54) (* radius 0.38))))
      (arg (+ center (tuple (* (- radius) 0.9) 0)))
    )
  )
  (call (. path close))
  (return path)
)

(fn-expr _ path-score Size
  (param path Path)
  (case? (not (. path count))
    0
  )
  (default
    (+ (. path count) (call numeric-check (. path last-point x)) (call numeric-check (. path last-point y)))
  )
)

(fn-expr _ numeric-check Size
  (param value Coord)
  (% (as (call abs (* value 1000)) Size) 1000003)
)
