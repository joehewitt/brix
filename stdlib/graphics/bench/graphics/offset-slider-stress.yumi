`benchmark.meta description: Recomputes offsets for self-overlapping and curve-heavy paths across a slider-distance sweep.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,graphics-fps,compile-timing

/graphics/graphic
/graphics/offset
/graphics/path
/graphics/path-set
/graphics/point
/graphics/primitives
/graphics/stroke
/math

. sources = stress-slider-sources()
. plans = offset-slider-plans(sources)
. checksum = sources.length as Size

for frame in 0 .. < 32
    //graphics.frame.frames ++
    . distance = slider-distance(frame, 8, 34)
    for i in 0 .. < sources.length
        //graphics.frame.items ++
        . source = sources[i]
        . layer = offset-plan-layer(plans[i], distance, .round-join-type, 5)
        checksum += source.count + layer-score(layer)

-- "bench-result graphics/offset-slider-stress checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do stress-slider-sources

. center = Point(120, 100)
. paths [Path]
paths += rosette(center, 66, 20, 10, -18deg)
paths += lissajous-loop(center, 68)
paths += petal-loop(center, 76)
paths += bowtie-loop(center, 76)
= paths

━━━━━━━━━━━━━━━━━━━━
_ offset-slider-plans [OffsetPlan]
    - sources [Path]

offset-plan(each) in sources

━━━━━━━━━━━━━━━━━━━━
_ slider-distance Length
    - frame Int
    - min-distance Length
    - max-distance Length

min-distance + (max-distance - min-distance) * ((frame as Float) / 31)

━━━━━━━━━━━━━━━━━━━━
_ do rosette
    - center Point
    - outer-radius Length
    - inner-radius Length
    - lobes Int
    - rotation Radians

. path = Path()
. count = lobes * 2
. step = (π * 2) / count

for i in 0 .. < count
    . a1 = rotation + step * i
    . a2 = rotation + step * (i + 1)
    . r1 = if i % 2 == 0 then outer-radius else inner-radius
    . r2 = if (i + 1) % 2 == 0 then outer-radius else inner-radius
    . bulge = outer-radius * (0.62 + ((i % 4) as Float) * 0.07)
    . p1 = center.translate-at-angle(a1, r1)
    . p2 = center.translate-at-angle(a2, r2)
    . h1 = center.translate-at-angle(a1 + step * 0.45, r1 + bulge)
    . h2 = center.translate-at-angle(a2 - step * 0.45, r2 + bulge)

    if i == 0
        path.move-to(p1)

    path.cubic-curve-to(h1, h2, p2)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do lissajous-loop
    - center Point
    - radius Length

. path = Path()
. first = true
for t in 0.0 .. < π * 2.0 by 0.07
    . point = Point(center.x + sin(t * 5.0 + 0.6) * radius, center.y + sin(t * 7.0) * radius * 0.74)
    if first
        path.move-to(point)
        first = false
    else
        path.line-to(point)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do petal-loop
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (0, -radius * 0.9))
path.cubic-curve-to()
    - center + (radius * 1.25, -radius * 0.72)
    - center + (radius * 0.35, radius * 0.28)
    - center + (radius * 0.78, radius * 0.72)
path.cubic-curve-to()
    - center + (radius * 0.18, radius * 1.08)
    - center + (-radius * 0.4, radius * 0.34)
    - center + (-radius * 0.82, radius * 0.66)
path.cubic-curve-to()
    - center + (-radius * 1.22, radius * 0.08)
    - center + (-radius * 0.55, -radius * 0.72)
    - center + (0, -radius * 0.9)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do bowtie-loop
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.76, -radius * 0.58))
path.line-to(center + (radius * 0.76, radius * 0.58))
path.line-to(center + (-radius * 0.76, radius * 0.58))
path.line-to(center + (radius * 0.76, -radius * 0.58))
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do layer-score
    - layer PathSet

. score Size
for path in layer.paths
    score += path-score(path)
= score

━━━━━━━━━━━━━━━━━━━━
_ path-score Size
    - path Path

|? !path.count
    0
??
    path.count + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
