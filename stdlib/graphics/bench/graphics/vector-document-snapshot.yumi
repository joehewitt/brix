`benchmark.meta description: Times VectorDocument snapshot, restore, and changed-node scans for documents of 10, 100, and 1000 square networks.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: vector-document,compile-timing

/graphics/document
/graphics/point
/graphics/primitives
/graphics/shapes
/time/timer

. checksum Size = 0
checksum += run-document-snapshot(10, 2000, 0)
checksum += run-document-snapshot(100, 400, 1)
checksum += run-document-snapshot(1000, 40, 2)
-- "bench-result graphics/vector-document-snapshot checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do run-document-snapshot
    - count Size
    - repeats Size
    - scale Size

. doc = use VectorDocument()
. layer = doc.root
. shapes [U64]
for index in 0 .. < count
    if index % 100 == 0
        layer = doc.create-group(doc.root, "Layer ${index / 100}")
    . x = index % 40 * 20.0
    . y = index / 40 * 20.0
    shapes += doc.add-path(layer, rectangle(Rect(x, y, 12, 12)), "Square $index")

. original = use doc.snapshot()
doc.set-opacity(shapes[count / 2], 0.5)
. edited = use doc.snapshot()
. pooled = use doc.snapshot()

. checksum Size = 0
. snapshot-start = monotonic-time-nanoseconds()
for repeat in 0 .. < repeats
    doc.snapshot-into(pooled)
    checksum += pooled.byte-count
. snapshot-us = (monotonic-time-nanoseconds() - snapshot-start) / 1000 / repeats

. restore-start = monotonic-time-nanoseconds()
for repeat in 0 .. < repeats
    doc.restore(if repeat % 2 == 0 then original else edited)
    checksum += doc.node-count
. restore-us = (monotonic-time-nanoseconds() - restore-start) / 1000 / repeats

. tracker = VectorDocumentChangeTracker()
checksum += tracker.scan(doc).changed.length
. diff-ns U64
for repeat in 0 .. < repeats
    doc.restore(if repeat % 2 == 0 then original else edited)
    . diff-start = monotonic-time-nanoseconds()
    . changes = tracker.scan(doc)
    diff-ns += monotonic-time-nanoseconds() - diff-start
    checksum += changes.changed.length
. diff-us = diff-ns / 1000 / repeats

match scale
    |= 0
        //graphics.bench.document.snapshot-us-small += snapshot-us
        //graphics.bench.document.restore-us-small += restore-us
        //graphics.bench.document.stamp-diff-us-small += diff-us
        //graphics.bench.document.snapshot-bytes-small += pooled.byte-count
    |= 1
        //graphics.bench.document.snapshot-us-medium += snapshot-us
        //graphics.bench.document.restore-us-medium += restore-us
        //graphics.bench.document.stamp-diff-us-medium += diff-us
        //graphics.bench.document.snapshot-bytes-medium += pooled.byte-count
    ??
        //graphics.bench.document.snapshot-us-large += snapshot-us
        //graphics.bench.document.restore-us-large += restore-us
        //graphics.bench.document.stamp-diff-us-large += diff-us
        //graphics.bench.document.snapshot-bytes-large += pooled.byte-count
= checksum
