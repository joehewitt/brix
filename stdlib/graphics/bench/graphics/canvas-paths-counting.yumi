`benchmark.meta description: Dispatches many multi-segment paths into CountingCanvas without rasterization.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/canvas
/graphics/color

. canvas = CountingCanvas(640, 480)
canvas.fill-color = red
canvas.stroke-color = blue
canvas.stroke-width = 1

for pass in 0 .. < 1200
    . f = pass as Float
    canvas.begin()
    canvas.move(f % 200, (f * 3) % 180)
    for i in 0 .. < 8
        . step = i as Float
        canvas.line((f + step * 11) % 240, (f * 2 + step * 7) % 220)
    canvas.curve(f + 3, f + 5, f + 9, f + 13, f + 17, f + 19)
    if pass % 3 == 0
        canvas.enclose()
    canvas.end()

. checksum = canvas.checksum + canvas.path-count + canvas.path-segment-count + canvas.command-count
-- "bench-result graphics/canvas-paths-counting checksum=$checksum"
