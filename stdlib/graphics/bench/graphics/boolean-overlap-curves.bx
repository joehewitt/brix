; benchmark.meta description: Combines overlapping curved closed paths with boolean operations.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/boolean)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /math)
(blank)

(main
  (let checksum (as 0 Size))
  (let a (call Path))
  (let b (call Path))
  (let result (call Path))
  (let workspace (call BooleanWorkspace))
  (blank)
  ; Exercise every shape/operation combination once so the repeated-query loop stays within capacity.
  (for (in warmup (..< 0 4))
    (call reset-curve-source-a a warmup)
    (call reset-curve-source-b b warmup)
    (for (in operation (..< 0 4))
      (call run-boolean-operation operation result workspace a b)
    )
  )
  (blank)
  (for (in pass (..< 0 120))
    (call reset-curve-source-a a pass)
    (call reset-curve-source-b b pass)
    (for (in operation (..< 0 4))
      (let maybe-result (call run-boolean-operation operation result workspace a b))
      (+= checksum (+ (call path-score maybe-result) pass operation))
    )
  )
  (blank)
  (print (str "bench-result graphics/boolean-overlap-curves checksum=" checksum))
)

(fn-do _ reset-curve-source-a _
  (param path Path)
  (param pass Int)
  (let f (as pass Float))
  (let kind (% pass 4))
  (call (. path clear))
  (if (== kind 0)
    (call (. path append-circle) (tuple (+ 82 (% f 5)) 82) 54)
    (else-if (== kind 1)
      (call (. path append-ellipse) (tuple 84 82) (call Dimensions 58 38))
      (call (. path rotate) (+ 12deg (* f 0.05deg)) (call Point 84 82))
    )
    (else-if (== kind 2)
      (call (. path append-circle) (tuple 86 82) 52)
    )
    (else
      (call (. path append-ellipse) (tuple 86 82) (call Dimensions 60 36))
      (call (. path rotate) (+ -10deg (* f 0.04deg)) (call Point 86 82))
    )
  )
)

(fn-do _ reset-curve-source-b _
  (param path Path)
  (param pass Int)
  (let f (as pass Float))
  (let kind (% pass 4))
  (call (. path clear))
  (if (== kind 0)
    (call (. path append-circle) (tuple 112 (+ 82 (% f 7))) 46)
    (else-if (== kind 1)
      (call (. path append-circle) (tuple (+ 112 (* (call sin (* f 0.14)) 4)) 82) 42)
    )
    (else-if (== kind 2)
      (call (. path append-ellipse) (tuple 106 (+ 80 (* (call cos (* f 0.11)) 4))) (call Dimensions 48 34))
      (call (. path rotate) 18deg (call Point 106 80))
    )
    (else
      (call (. path append-ellipse) (tuple 106 82) (call Dimensions 54 32))
      (call (. path rotate) (+ -22deg (* f 0.05deg)) (call Point 106 82))
    )
  )
)

(fn-do _ run-boolean-operation _
  (param operation _)
  (param out Path)
  (param workspace BooleanWorkspace)
  (param a Path)
  (param b Path)
  (if (== operation 0)
    (return (call boolean-union-reusing out workspace a b))
    (else-if (== operation 1)
      (return (call boolean-intersect-reusing out workspace a b))
    )
    (else-if (== operation 2)
      (return (call boolean-subtract-reusing out workspace a b))
    )
  )
  (blank)
  (return (call boolean-clip-reusing out workspace a b))
)

(fn-expr _ path-score _
  (param path (? Path))
  (case? path
    (call solid-path-score path)
  )
  (default
    0
  )
)

(fn-expr _ solid-path-score Size
  (param path Path)
  (case? (not (. path count))
    0
  )
  (default
    (+ box-score (call numeric-check (. path last-point x)) (call numeric-check (. path last-point y)))
  )
  (where
    (lazy bounds (. path bounding-box))
    (lazy box-score (+ origin-score (call numeric-check (. bounds width)) (call numeric-check (. bounds height))))
    (lazy origin-score (+ (. path count) (call numeric-check (. bounds x)) (call numeric-check (. bounds y))))
  )
)

(fn-expr _ numeric-check Size
  (param value Coord)
  (% (as (call abs (* value 1000)) Size) 1000003)
)
