; benchmark.meta description: Runs deterministic circle packing and circle intersection helpers.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/pack)
(import /graphics/point)
(blank)

(main
  (let points (list Point))
  (let radii (list Float))
  (for (in i (..< 0 54))
    (let f (as i Float))
    (+= points (call Point (+ 20 (* (% f 9) 9)) (+ 20 (* (/ f 9) 9))))
    (+= radii (+ 3 (% f 7)))
  )
  (blank)
  (let checksum (as 0 Size))
  (for (in pass (..< 0 260))
    (for (in i (..< 1 (- (. points length) 1)))
      (let a ([] points (- i 1)))
      (let b ([] points i))
      (let c ([] points (+ i 1)))
      (let ar ([] radii (- i 1)))
      (let br ([] radii i))
      (let cr ([] radii (+ i 1)))
      (blank)
      (probe-count graphics.pack.circle-tests)
      (if (< (call (. a distance) b) (+ ar br))
        (+= checksum (+ i pass))
      )
      (blank)
      (if (call circle-line-intersect a b c cr)
        (+= checksum (+ (* i 3) pass))
      )
    )
  )
  (blank)
  (print (str "bench-result graphics/pack-circles checksum=" checksum))
)
