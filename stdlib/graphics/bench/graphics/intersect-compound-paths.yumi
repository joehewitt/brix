`benchmark.meta description: Intersects multi-subpath paths and aggregates intersection results.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/intersection
/graphics/path
/graphics/point
/graphics/shapes

. checksum = 0 as Size
. a = Path()
. b = Path()
. results [PathIntersection]
. workspace = IntersectionWorkspace()

` Grow every caller-owned buffer before the measured repeated-query shape.
reset-sources(a, b, 259)
intersect-paths-reusing(results, workspace, a, b, false)

for pass in 0 .. < 260
    reset-sources(a, b, pass)
    intersect-paths-reusing(results, workspace, a, b, false)
    checksum += results.length
    for result in results
        checksum += result.intersections.length + pass

-- "bench-result graphics/intersect-compound-paths checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do reset-sources
    - a Path
    - b Path
    - pass Int

. f = pass as Float
a.clear()
a.append-circle(Point(80 + (f % 11), 80), 40)
a.append-rectangle((40, 40, 80, 80))
b.clear()
b.append-circle(Point(95, 80 + (f % 13)), 38)
b.append-rectangle((70, 30, 70, 90))
