; benchmark.meta description: Paints precomputed paths through VectorGroup and Path.outline into CountingCanvas.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/graphic)
(import /graphics/path)
(import /graphics/point)
(import /graphics/shapes)
(import /graphics/style)
(import /graphics/vector-group)
(blank)

(main
  (let paths (list Path))
  (for (in i (..< 0 160))
    (let f (as i Float))
    (+= paths (call circle (tuple (+ 40 (* (% f 20) 8)) (+ 50 (* (/ f 20) 8))) (+ 6 (% f 5))))
    (+= paths (call rectangle (tuple (+ 20 (* (% f 16) 9)) (+ 120 (* (/ f 16) 6)) 12 8)))
  )
  (blank)
  (let group (call VectorGroup paths))
  (= (. group fill) red)
  (= (. group stroke) blue)
  (= (. group stroke-width) 2)
  (call (. group checkpoint))
  (blank)
  (let canvas (call CountingCanvas 400 300))
  (for (in frame (..< 0 80))
    (call (. group paint-vector) canvas)
  )
  (blank)
  (let checksum (+ (. canvas checksum) (. canvas command-count) (. canvas path-count) (. canvas path-segment-count)))
  (print (str "bench-result graphics/layer-paint-counting checksum=" checksum))
)
