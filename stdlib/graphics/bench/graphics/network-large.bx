; benchmark.meta description: Traces geometry and picks curves on a 1,200-segment network while moving one vertex through 8 edits.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/network)
(import /graphics/point)
(blank)

(main
  (let network (call VectorNetwork))
  (let ids (list Index))
  (let column 0)
  (let row 0)
  (for (in i (..< 0 1200))
    (let x (if-expr (== (% row 2) 0) column (- 39 column)))
    (+= ids (call (. network add-vertex) (call Point (as (* x 10) Float) (as (* row 10) Float))))
    (+= column 1)
    (if (== column 40)
      (= column 0)
      (+= row 1)
    )
  )
  (for (in i (..< 0 (. ids length)))
    (let next ([] ids (% (+ i 1) (. ids length))))
    (if (== (% i 3) 0)
      (call (. network connect) ([] ids i) next (tuple 3 -4) (tuple -3 4))
      (else
        (call (. network connect) ([] ids i) next)
      )
    )
  )
  (let hub (call (. network add-vertex) (tuple -50 -50)))
  (for (in i (..< 0 (. ids length) (by: 150)))
    (call (. network connect) hub ([] ids i))
  )
  (blank)
  (let checksum Size)
  (for (in frame (..< 0 8))
    (call (. network move-vertex) ([] ids (* frame 7)) (call Point (as (* frame 7 10) Float) -3.0))
    (+= checksum (. (call (. network geometry)) count))
    (for (in sample (..< 0 4))
      (let hit
        (call (. network pick)
          (block
            (arg (call Point (as (+ 13 (* sample 97) frame) Float) (as (+ 7 (* sample 71)) Float)))
            (arg 6)
          )
        )
      )
      (if hit
        (+= checksum (. hit segment))
      )
    )
  )
  (print (str "bench-result graphics/network-large checksum=" checksum))
)
