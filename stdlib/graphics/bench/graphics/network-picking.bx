; benchmark.meta description: Measures picking while moving an eight-segment network through 24 edits.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/network)
(import /graphics/network-regions)
(import /graphics/network-stroke)
(import /graphics/point)
(blank)

(main
  (let network (call VectorNetwork))
  (let a (call (. network add-vertex) (tuple 20 20)))
  (let b (call (. network add-vertex) (tuple 180 20)))
  (let c (call (. network add-vertex) (tuple 180 180)))
  (let d (call (. network add-vertex) (tuple 20 180)))
  (let center (call (. network add-vertex) (tuple 100 100)))
  (call (. network connect) a b)
  (call (. network connect) b c)
  (call (. network connect) c d)
  (call (. network connect) d a)
  (call (. network connect) a center (tuple 40 0) (tuple -20 -20))
  (call (. network connect) b center)
  (call (. network connect) c center)
  (call (. network connect) d center)
  (let regions (call NetworkRegionWorkspace))
  (let strokes (call NetworkStrokeWorkspace))
  (let checksum Size 0)
  (for (in frame (..< 0 24))
    (call (. network move-vertex) center (call Point (+ 80.0 frame) (+ 95.0 (% frame 7))))
    (for (in sample (..< 0 16))
      (let hit (call (. network pick) (call Point (+ 20.0 (* sample 10)) 80) 200))
      (if hit
        (+= checksum (. hit segment))
      )
    )
  )
  (print (str "bench-result graphics/network-picking checksum=" checksum))
)
