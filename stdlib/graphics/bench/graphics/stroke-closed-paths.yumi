`benchmark.meta description: Strokes ordinary closed shapes with bevel, miter, and round joins.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/path
/graphics/point
/graphics/primitives
/graphics/shapes
/graphics/stroke
/math

. checksum = 0 as Size

for pass in 0 .. < 180
    . source = closed-stroke-source(pass)
    . stroked = stroke()
        - source
        - 4.0 + (pass % 8)
        - .center
        - stroke-join(pass)
        - .butt
        - 5
        - 0
    checksum += source.count + path-score(stroked)

-- "bench-result graphics/stroke-closed-paths checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do closed-stroke-source
    - seed Int

. base = seed as Float
. center = Point(90 + (base % 11), 80 + (base % 7))
. kind = seed % 4
if kind == 0
    = circle(center, 34 + (base % 13))
else if kind == 1
    = rectangle(Rect(center.x - 34, center.y - 26, 68 + (base % 9), 52 + (base % 7)))
else if kind == 2
    . path = polygon(5, 82 + (base % 11), center)
    path.rotate(11deg, center)
    = path

. path = Path()
path.move-to(center + (-44, -8))
path.cubic-curve-to(center + (-28, -58), center + (40, -48), center + (46, -4))
path.cubic-curve-to(center + (54, 44), center + (-32, 56), center + (-46, 8))
path.cubic-curve-to(center + (-60, -12), center + (-52, -26), center + (-44, -8))
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ stroke-join
    - seed Int

|? kind == 0
    .bevel-join-type
|? kind == 1
    .miter-join-type
??
    .round-join-type

.. kind = seed % 3

━━━━━━━━━━━━━━━━━━━━
_ path-score Size
    - path Path

|? !path.count
    0
??
    path.count + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
