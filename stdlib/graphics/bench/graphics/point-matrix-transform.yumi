`benchmark.meta description: Exercises point arithmetic, matrix composition, inversion, and transforms.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/matrix
/graphics/point
/graphics/primitives
/math

. checksum = 0 as Size
. matrix = matrix-from-identity()
. source [Coord]
. dest [Coord]

for i in 0 .. < 256
    . f = i as Float
    source += f * 1.5
    source += f * 0.75 + 3
    dest += 0
    dest += 0

for pass in 0 .. < 240
    . f = pass as Float
    matrix = matrix.translate((f % 17, (f % 11) - 5))
    matrix = matrix.scale(Dimensions(1.001, 0.999))
    matrix = matrix.rotate((f % 31) / 1000.0, (30.0, 40.0))

    . point = Point(f % 101, (f * 3) % 97)
    . transformed = matrix.transform(point)
    checksum += numeric-check(transformed.x) + numeric-check(transformed.y)

    matrix.transform-coordinates(source, 0, dest, 0, 128)
    checksum += numeric-check(dest[pass % dest.length])

-- "bench-result graphics/point-matrix-transform checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
