; benchmark.meta description: Dispatches primitive canvas drawing commands into CountingCanvas.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(blank)

(main
  (let canvas (call CountingCanvas 640 480))
  (= (. canvas fill-color) red)
  (= (. canvas stroke-color) blue)
  (= (. canvas stroke-width) 2)
  (blank)
  (for (in pass (..< 0 5000))
    (let f (as pass Float))
    (call (. canvas rect) (tuple (% f 300) (% (* f 3) 220) (+ 10 (% f 17)) (+ 8 (% f 13))))
    (call (. canvas square) (% (* f 5) 300) (% (* f 7) 220) (+ 5 (% f 11)))
    (call (. canvas oval) (tuple (% (* f 11) 300) (% (* f 13) 220) (+ 12 (% f 9)) (+ 14 (% f 7))))
    (call (. canvas circle) (% (* f 17) 300) (% (* f 19) 220) (+ 4 (% f 5)))
  )
  (blank)
  (let checksum (+ (. canvas checksum) (. canvas primitive-command-count) (. canvas command-count)))
  (print (str "bench-result graphics/canvas-primitives-counting checksum=" checksum))
)
