`benchmark.meta description: Paints precomputed paths through VectorGroup and Path.outline into CountingCanvas.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/canvas
/graphics/color
/graphics/graphic
/graphics/path
/graphics/point
/graphics/shapes
/graphics/style
/graphics/vector-group

. paths [Path]
for i in 0 .. < 160
    . f = i as Float
    paths += circle((40 + (f % 20) * 8, 50 + (f / 20) * 8), 6 + (f % 5))
    paths += rectangle((20 + (f % 16) * 9, 120 + (f / 16) * 6, 12, 8))

. group = VectorGroup(paths)
group.fill = red
group.stroke = blue
group.stroke-width = 2
group.checkpoint()

. canvas = CountingCanvas(400, 300)
for frame in 0 .. < 80
    group.paint-vector(canvas)

. checksum = canvas.checksum + canvas.command-count + canvas.path-count + canvas.path-segment-count
-- "bench-result graphics/layer-paint-counting checksum=$checksum"
