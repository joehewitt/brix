`benchmark.meta description: Intersects line-heavy path grids to isolate pairwise line-line work.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/intersection
/graphics/path
/graphics/point
/math

. checksum = 0 as Size

for pass in 0 .. < 240
    . a = polyline-a(pass)
    . b = polyline-b(pass)
    . results = intersect-paths(a, b, false)
    checksum += results.length
    for result in results
        checksum += result.intersections.length + pass

-- "bench-result graphics/intersect-line-line-grid checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do polyline-a
    - seed Int

. path = Path()
. base = seed as Float
path.move-to(0, base % 31)
for i in 0 .. < 24
    . f = i as Float
    path.line-to(f * 8, (base + f * 13) % 180)
= path

━━━━━━━━━━━━━━━━━━━━
_ do polyline-b
    - seed Int

. path = Path()
. base = seed as Float
path.move-to(base % 29, 0)
for i in 0 .. < 24
    . f = i as Float
    path.line-to((base + f * 17) % 180, f * 8)
= path
