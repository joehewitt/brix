; benchmark.meta description: Exercises graphics numeric primitives such as roots, distances, and hull clipping.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/_utils)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)

(main
  (let checksum (as 0 Size))
  (blank)
  (for (in i (..< 0 900))
    (let f (as i Float))
    (let q (call solve-quadratic 1.0 (- (+ (% f 17) 3)) (- (% f 11) 5) tolerance))
    (+= checksum (+ (. q count) (call numeric-check (. q root1)) (call numeric-check (. q root2))))
    (blank)
    (let c (call solve-cubic 1.0 (- (+ (% f 9) 1)) (- (% f 13) 4) (- (% f 7) 2) tolerance))
    (+= checksum (+ (. c count) (call numeric-check (. c root1)) (call numeric-check (. c root2)) (call numeric-check (. c root3))))
    (blank)
    (let dist (call get-signed-distance (tuple 0.0 0.0) (tuple (+ 10.0 (% f 5)) 6.0) (tuple (% f 13) (- (% f 19) 9))))
    (+= checksum (call numeric-check dist))
    (blank)
    (let hull (call get-convex-hull (- (% f 3) 1) (- (% f 5) 2) (- (% f 7) 3) (- (% f 11) 5)))
    (+= checksum (+ (. hull top length) (. hull bottom length)))
  )
  (blank)
  (print (str "bench-result graphics/numeric-roots checksum=" checksum))
)

(fn-expr _ numeric-check Size
  (param value Coord)
  (% (as (call abs (* value 1000)) Size) 1000003)
)
