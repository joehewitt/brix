`benchmark.meta description: Measures finding the nearest point on a circle and on an ellipse from 16 points near them and far from them, most of them nearest to the inside of a curve, 20 times over.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/crossings
/graphics/path
/graphics/point
/graphics/primitives
/graphics/shapes
/math

. ring = circle((120, 115), 20)
. oval = ellipse((120, 315), Dimensions(20, 15))
. checksum Size = 0
for pass in 0 .. < 20
    for sample in 0 .. < 16
        . spot = Point(143.0 + sample * 60 + pass, 122.0 + sample * 45)
        . round-hit = path-nearest(ring, spot)
        . oval-hit = path-nearest(oval, spot)
        if round-hit && oval-hit
            checksum += round(round-hit.distance + oval-hit.distance) as Size
-- "bench-result graphics/curve-nearest checksum=$checksum"
