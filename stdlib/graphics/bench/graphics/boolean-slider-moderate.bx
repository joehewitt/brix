; benchmark.meta description: Recomputes boolean operations for common closed-shape pairs across a slider sweep.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gc-runtime,graphics,graphics-fps,compile-timing
(blank)
(import /graphics/boolean)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /math)
(blank)

(main
  (let checksum (as 0 Size))
  (let a (call Path))
  (let b (call Path))
  (let result (call Path))
  (let workspace (call BooleanWorkspace))
  (blank)
  (for (in item (..< 0 8))
    (call reset-moderate-source-a a item item)
    (call reset-moderate-source-b b item item)
    (for (in operation (..< 0 4))
      (call boolean-operation-reusing operation result workspace a b)
    )
  )
  (blank)
  (for (in frame (..< 0 32))
    (probe-count graphics.frame.frames)
    (for (in item (..< 0 8))
      (call reset-moderate-source-a a item frame)
      (call reset-moderate-source-b b item frame)
      (for (in operation (..< 0 4))
        (probe-count graphics.frame.items)
        (let maybe-result (call boolean-operation-reusing operation result workspace a b))
        (+= checksum (+ (call path-score maybe-result) item operation frame))
      )
    )
  )
  (blank)
  (print (str "bench-result graphics/boolean-slider-moderate checksum=" checksum))
)

(fn-do _ reset-moderate-source-a _
  (param path Path)
  (param item _)
  (param frame Int)
  (let f (as frame Float))
  (call (. path clear))
  (if (== item 0)
    (call (. path append-rectangle) (call Rect (+ 18 (% f 9)) 26 92 72))
    (else-if (== item 1)
      (call append-diamond path (tuple (+ 82 (% f 5)) 76) 58)
    )
    (else-if (== item 2)
      (call (. path append-circle) (tuple (+ 78 (* (call sin (* f 0.18)) 4)) 78) 48)
    )
    (else-if (== item 3)
      (call (. path append-circle) (tuple 84 78) 58)
    )
    (else-if (== item 4)
      (call append-shared-edge-step path (tuple 22 24) 132 98)
    )
    (else-if (== item 5)
      (call (. path append-rectangle) (call Rect 30 30 106 72))
      (call (. path rotate) (+ -10deg (* f 0.2deg)) (call Point 83 66))
    )
    (else-if (== item 6)
      (call (. path append-circle) (tuple 75 78) 46)
    )
    (else
      (call append-compound-boxes path f)
    )
  )
)

(fn-do _ reset-moderate-source-b _
  (param path Path)
  (param item _)
  (param frame Int)
  (let f (as frame Float))
  (call (. path clear))
  (if (== item 0)
    (call (. path append-rectangle) (call Rect (+ 72 (% f 7)) 48 90 70))
    (else-if (== item 1)
      (call append-diamond path (tuple (+ 112 (% f 6)) 76) 58)
    )
    (else-if (== item 2)
      (call (. path append-ellipse) (tuple 104 (+ 82 (* (call cos (* f 0.2)) 5))) (call Dimensions 46 32))
      (call (. path rotate) (+ -16deg (* f 0.15deg)) (call Point 104 82))
    )
    (else-if (== item 3)
      (call (. path append-circle) (tuple (+ 92 (* (call sin (* f 0.11)) 3)) 74) 24)
    )
    (else-if (== item 4)
      (call (. path append-rectangle) (call Rect 98 42 48 66))
    )
    (else-if (== item 5)
      (call append-polygon path 5 98 (call Point 104 74))
      (call (. path rotate) (- 13deg (* f 0.18deg)) (call Point 104 74))
    )
    (else-if (== item 6)
      (call (. path append-circle) (tuple (+ 166 (* (call sin (* f 0.17)) 2)) 78) 45)
    )
    (else
      (call (. path append-rectangle) (call Rect 68 (+ 42 (% f 5)) 94 54))
    )
  )
)

(fn-do _ boolean-operation-reusing _
  (param operation _)
  (param out Path)
  (param workspace BooleanWorkspace)
  (param a Path)
  (param b Path)
  (if (== operation 0)
    (return (call boolean-union-reusing out workspace a b))
    (else-if (== operation 1)
      (return (call boolean-intersect-reusing out workspace a b))
    )
    (else-if (== operation 2)
      (return (call boolean-subtract-reusing out workspace a b))
    )
  )
  (blank)
  (return (call boolean-clip-reusing out workspace a b))
)

(fn-do _ append-diamond _
  (param path Path)
  (param center Point)
  (param radius Length)
  (call (. path move-to) (+ center (tuple 0 (- radius))))
  (call (. path line-to) (+ center (tuple radius 0)))
  (call (. path line-to) (+ center (tuple 0 radius)))
  (call (. path line-to) (+ center (tuple (- radius) 0)))
  (call (. path close))
)

(fn-do _ append-shared-edge-step _
  (param path Path)
  (param origin Point)
  (param width Length)
  (param height Length)
  (let step-x (+ (. origin x) (* width 0.58)))
  (let step-y (+ (. origin y) (* height 0.42)))
  (call (. path move-to) origin)
  (call (. path line-to) step-x (. origin y))
  (call (. path line-to) step-x step-y)
  (call (. path line-to) (+ (. origin x) width) step-y)
  (call (. path line-to) (+ (. origin x) width) (+ (. origin y) height))
  (call (. path line-to) (. origin x) (+ (. origin y) height))
  (call (. path close))
)

(fn-do _ append-compound-boxes _
  (param path Path)
  (param frame Float)
  (call (. path append-rectangle) (call Rect (+ 26 (% frame 4)) 30 42 42))
  (call (. path append-rectangle) (call Rect 102 70 42 42))
)

(fn-do _ append-polygon _
  (param path Path)
  (param sides U32)
  (param width Length)
  (param center Point)
  (let rx Coord (/ width 2.0))
  (let ry Coord (/ width 2.0))
  (let step (/ (* π 2.0) sides))
  (let a1 (/ (- π) 2.0))
  (call (. path reserve) (+ (. path count) (as sides Size) 1) (+ (. path coord-size) (* (as sides Size) 2)))
  (for (in i (..< 0.0 sides))
    (let angle (+ a1 (* step (+ (- i) 1.0))))
    (let point (call Point (+ (. center x) (* (call cos angle) rx)) (+ (. center y) (* (call sin angle) ry))))
    (if (== i 0)
      (call (. path move-to) point)
      (else
        (call (. path line-to) point)
      )
    )
  )
  (call (. path close))
)

(fn-expr _ path-score _
  (param path (? Path))
  (case? path
    (call solid-path-score path)
  )
  (default
    0
  )
)

(fn-expr _ solid-path-score Size
  (param path Path)
  (case? (not (. path count))
    0
  )
  (default
    (+ box-score (call numeric-check (. path last-point x)) (call numeric-check (. path last-point y)))
  )
  (where
    (lazy bounds (. path bounding-box))
    (lazy box-score (+ origin-score (call numeric-check (. bounds width)) (call numeric-check (. bounds height))))
    (lazy origin-score (+ (. path count) (call numeric-check (. bounds x)) (call numeric-check (. bounds y))))
  )
)

(fn-expr _ numeric-check Size
  (param value Coord)
  (% (as (call abs (* value 1000)) Size) 1000003)
)
