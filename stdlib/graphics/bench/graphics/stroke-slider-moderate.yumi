`benchmark.meta description: Recomputes strokes for a moderate fixed graphics scene across a slider-width sweep.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,graphics-fps,compile-timing

/graphics/path
/graphics/point
/graphics/primitives
/graphics/shapes
/graphics/stroke
/math

. sources = moderate-slider-sources()
. checksum = sources.length as Size

for frame in 0 .. < 32
    //graphics.frame.frames ++
    . width = slider-width(frame, 2, 30)
    for i in 0 .. < sources.length
        //graphics.frame.items ++
        . source = sources[i]
        . stroked = stroke(source, width, .center, slider-join(i), slider-cap(i), 5, 0)
        checksum += source.count + path-score(stroked)

-- "bench-result graphics/stroke-slider-moderate checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do moderate-slider-sources

. center = Point(120, 100)
. radius = 72.0
. paths [Path]
paths += line(center + (-radius * 0.82, -radius * 0.22), center + (radius * 0.82, radius * 0.22))

. rect = rectangle(Rect(center.x - radius * 0.72, center.y - radius * 0.5, radius * 1.44, radius))
rect.rotate(-9deg, center)
paths += rect

. tri = polygon(3, radius * 1.82, center)
tri.rotate(18deg, center)
paths += tri

paths += circle(center, radius * 0.7)

. pent = polygon(5, radius * 1.78, center)
pent.rotate(-12deg, center)
paths += pent

paths += moderate-zigzag(center, radius)
paths += bounded-spiral(center, radius * 0.95, 3.4, 72, -45deg)
paths += cubic-snake(center, radius)
paths += rosette(center, radius * 0.92, radius * 0.28, 9, -18deg)
paths += lissajous-loop(center, radius * 0.9)
paths += petal-loop(center, radius)
paths += comet-loop(center, radius)
= paths

━━━━━━━━━━━━━━━━━━━━
_ slider-width Length
    - frame Int
    - min-width Length
    - max-width Length

min-width + (max-width - min-width) * ((frame as Float) / 31)

━━━━━━━━━━━━━━━━━━━━
_ slider-join
    - seed

|? kind == 0
    .bevel-join-type
|? kind == 1
    .miter-join-type
??
    .round-join-type

.. kind = seed % 3

━━━━━━━━━━━━━━━━━━━━
_ slider-cap LineCap
    - seed

if seed % 2 == 0 then .round else .square

━━━━━━━━━━━━━━━━━━━━
_ do moderate-zigzag
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.82, -radius * 0.45))
path.line-to(center + (-radius * 0.42, radius * 0.36))
path.line-to(center + (-radius * 0.05, -radius * 0.24))
path.line-to(center + (radius * 0.34, radius * 0.48))
path.line-to(center + (radius * 0.82, -radius * 0.34))
= path

━━━━━━━━━━━━━━━━━━━━
_ do cubic-snake
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.86, radius * 0.34))
path.cubic-curve-to()
    - center + (-radius * 0.65, -radius * 0.85)
    - center + (-radius * 0.18, radius * 0.82)
    - center + (radius * 0.06, -radius * 0.08)
path.cubic-curve-to()
    - center + (radius * 0.34, -radius * 1.04)
    - center + (radius * 0.76, radius * 0.74)
    - center + (radius * 0.88, -radius * 0.24)
= path

━━━━━━━━━━━━━━━━━━━━
_ do bounded-spiral
    - center Point
    - radius Length
    - coils Float
    - steps Int
    - rotation Radians

. path = Path()
for i in 0 .. < steps
    . t = (i as Float) / ((steps - 1) as Float)
    . angle = rotation + t * coils * π * 2
    . point = center.translate-at-angle(angle, radius * t)
    if i == 0
        path.move-to(point)
    else
        path.line-to(point)

= path

━━━━━━━━━━━━━━━━━━━━
_ do rosette
    - center Point
    - outer-radius Length
    - inner-radius Length
    - lobes Int
    - rotation Radians

. path = Path()
. count = lobes * 2
. step = (π * 2) / count

for i in 0 .. < count
    . a1 = rotation + step * i
    . a2 = rotation + step * (i + 1)
    . r1 = if i % 2 == 0 then outer-radius else inner-radius
    . r2 = if (i + 1) % 2 == 0 then outer-radius else inner-radius
    . bulge = outer-radius * (0.52 + ((i % 3) as Float) * 0.08)
    . p1 = center.translate-at-angle(a1, r1)
    . p2 = center.translate-at-angle(a2, r2)
    . h1 = center.translate-at-angle(a1 + step * 0.42, r1 + bulge)
    . h2 = center.translate-at-angle(a2 - step * 0.42, r2 + bulge)

    if i == 0
        path.move-to(p1)

    path.cubic-curve-to(h1, h2, p2)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do lissajous-loop
    - center Point
    - radius Length

. path = Path()
. first = true
for t in 0.0 .. < π * 2.0 by 0.11
    . point = Point()
        - center.x + sin(t * 3.0 + 0.35) * radius
        - center.y + sin(t * 4.0) * radius * 0.72
    if first
        path.move-to(point)
        first = false
    else
        path.line-to(point)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do petal-loop
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (0, -radius * 0.9))
path.cubic-curve-to()
    - center + (radius * 1.25, -radius * 0.72)
    - center + (radius * 0.35, radius * 0.28)
    - center + (radius * 0.78, radius * 0.72)
path.cubic-curve-to()
    - center + (radius * 0.18, radius * 1.08)
    - center + (-radius * 0.4, radius * 0.34)
    - center + (-radius * 0.82, radius * 0.66)
path.cubic-curve-to()
    - center + (-radius * 1.22, radius * 0.08)
    - center + (-radius * 0.55, -radius * 0.72)
    - center + (0, -radius * 0.9)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do comet-loop
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.9, 0))
path.cubic-curve-to()
    - center + (-radius * 0.5, -radius * 1.05)
    - center + (radius * 0.32, -radius * 0.62)
    - center + (radius * 0.68, -radius * 0.18)
path.cubic-curve-to()
    - center + (radius * 1.24, radius * 0.5)
    - center + (-radius * 0.18, radius * 0.95)
    - center + (-radius * 0.05, radius * 0.04)
path.cubic-curve-to()
    - center + (-radius * 0.34, -radius * 0.32)
    - center + (-radius * 0.54, radius * 0.38)
    - center + (-radius * 0.9, 0)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ path-score Size
    - path Path

|? !path.count
    0
??
    path.count + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
