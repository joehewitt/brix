`benchmark.meta description: Shapes, snapshots, and draws a fixed hard-break and word-wrapped paragraph corpus.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/core/markup
/graphics/canvas
/graphics/color
/graphics/primitives
/graphics/text
/gui
/math

. texts [String]
texts += "Short paragraph text."
texts += "A longer paragraph with enough ordinary words to wrap at narrow and wide constraints."
texts += "first hard line\nsecond hard line\r\nthird hard line"
texts += "longtokenwithoutabreakopportunitylongtokenwithoutabreakopportunity"
texts += "e\u0301 · 👩🏽‍💻 · 日本語 · العربية · עברית · ABC אבג العربية 123"
. widths = [72.5, 260.0]
. wraps = [TextWrap.no-wrap, TextWrap.word]
. one-x = RasterCanvas(420, 260, 1)
. two-x = RasterCanvas(420, 260, 2)
. checksum = 0 as Size

do use one-x
    do use two-x
        one-x.text-color = black
        two-x.text-color = black
        for pass in 0 .. < 30
            . font = Font("", 13.0 + ((pass % 2) * 0.5), FontWeight.regular)
            one-x.font = font
            two-x.font = font
            for text in texts
                for wrap in wraps
                    for width in widths
                        . one-layout = one-x.text-layout(text, width, TextOverflow.clip, wrap)
                        . two-layout = two-x.text-layout(text, width, TextOverflow.clip, wrap)
                        do use one-layout
                            do use two-layout
                                checksum += paragraph-layout-score(one-layout.snapshot)
                                checksum += paragraph-layout-score(two-layout.snapshot)
                                one-x.draw-text
                                    - one-layout
                                    - Rect(0, 0, width, 220)
                                    - TextAlignment.left
                                two-x.draw-text
                                    - two-layout
                                    - Rect(0, 0, width, 220)
                                    - TextAlignment.right

. tight-texts [String]
tight-texts += "Short tight text."
tight-texts += "A longer tight paragraph with a conspicuously short final line."
tight-texts += "longtokenwithoutabreakopportunitylongtoken"
tight-texts += "e\u0301 · 👩🏽‍💻 · 日本語 · العربية · עברית"
. tight-widths = [72.5, 260.0]
. root = ParagraphBenchmarkRoot()
. available-label = ParagraphAvailableBenchmarkLabel()
. tight-label = ParagraphTightBenchmarkLabel()
markup-append(root, available-label)
markup-append(root, tight-label)
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
. candidate-layout-count = 0 as Size
. retained-layout-count = 0 as Size
. tight-case-count = 0 as Size
. available-canvas = RasterCanvas(420, 260, 1)
. tight-canvas = RasterCanvas(420, 260, 2)

do use available-canvas
    do use tight-canvas
        for pass in 0 .. < 6
            . ignored = pass
            for text in tight-texts
                available-label.text = text
                tight-label.text = text
                for width in tight-widths
                    . available-measure = available-label.measure(measure-fit-query(width))
                    . available-result = available-measure.content-size
                    available-label.arrange-bounds
                        - Rect(0, 0, available-result.width, available-result.height)
                    available-label.paint(available-canvas)
                    checksum += paragraph-layout-score(available-label.text-layout-snapshot!)

                    . created-before-tight = text-layout-created-count()
                    . tight-result = tight-label.measure(measure-fit-query(width)).content-size
                    candidate-layout-count += text-layout-created-count() - created-before-tight
                    retained-layout-count += if has-snapshot then 1 else 0
                        .. has-snapshot = tight-label.text-layout-snapshot != null
                    tight-label.arrange-bounds(Rect(0, 0, width, tight-result.height))
                    tight-label.paint(tight-canvas)
                    checksum += paragraph-layout-score(tight-label.text-layout-snapshot!)
                    checksum += abs((width - tight-result.width) * 1000) as Size
                    tight-case-count += 1

available-label.close()
tight-label.close()

//graphics.text.layouts-live += text-layout-live-count()

-- "tight-characterization candidates=$candidate-layout-count retained=$retained-layout-count tight-cases=$tight-case-count"
-- "bench-result graphics/text-paragraph-layout checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ ParagraphBenchmarkRoot is Box
    is MarkupBatch

+ markup-batch-queue := MarkupBatchQueue(this as MarkupBatch)

╌╌╌╌╌╌╌╌╌╌ is MarkupBatch ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

. ignored = flush.applied

━━━━━━━━━━━━━━━━━━━━
+ ParagraphAvailableBenchmarkLabel is Label

• This
    text-wrap = TextWrap.word
    text-overflow = TextOverflow.clip

━━━━━━━━━━━━━━━━━━━━
+ ParagraphTightBenchmarkLabel is ParagraphAvailableBenchmarkLabel

• This
    text-wrap-sizing = TextWrapSizing.tight

━━━━━━━━━━━━━━━━━━━━
_ do paragraph-layout-score Size
    - snapshot TextLayoutSnapshot

. score = abs(snapshot.size.width * 1000) as Size
score += abs(snapshot.size.height * 1000) as Size
score += abs(snapshot.natural-width * 1000) as Size
score += abs(snapshot.constrained-width * 1000) as Size
score += snapshot.line-count as Size
score += abs(snapshot.first-baseline * 1000) as Size
score += abs(snapshot.last-baseline * 1000) as Size
for line in snapshot.lines
    score += abs(line.typographic-bounds.x * 1000) as Size
    score += abs(line.typographic-bounds.y * 1000) as Size
    score += abs(line.typographic-bounds.width * 1000) as Size
    score += abs(line.typographic-bounds.height * 1000) as Size
    score += abs(line.ink-bounds.x * 1000) as Size
    score += abs(line.ink-bounds.y * 1000) as Size
    score += abs(line.ink-bounds.width * 1000) as Size
    score += abs(line.ink-bounds.height * 1000) as Size
    score += abs(line.baseline * 1000) as Size
    score += abs(line.ascent * 1000) as Size
    score += abs(line.descent * 1000) as Size
    score += abs(line.leading * 1000) as Size
score += if snapshot.is-truncated then 1 else 0
= score
