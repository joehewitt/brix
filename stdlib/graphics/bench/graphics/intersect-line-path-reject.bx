; benchmark.meta description: Runs line-path intersections where bounds reject most work.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/intersection)
(import /graphics/path)
(import /graphics/point)
(import /graphics/shapes)
(blank)

(main
  (let path (call circle (tuple 120 120) 45))
  (let checksum (as 0 Size))
  (blank)
  (for (in pass (..< 0 1200))
    (let f (as pass Float))
    (let hits (call intersect-path-line path (tuple (+ 300 f) 20) (tuple (+ 320 f) 260)))
    (+= checksum (+ (. hits length) pass))
  )
  (blank)
  (print (str "bench-result graphics/intersect-line-path-reject checksum=" checksum))
)
