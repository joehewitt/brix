`benchmark.meta description: Blurs canvas layers on a CoreGraphics canvas at the small, medium and large radii of an app icon's edge rims and drop shadows.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/canvas
/graphics/color
/graphics/primitives

. checksum = blur-passes(2, 20) + blur-passes(22, 6) + blur-passes(120, 2)
-- "bench-result graphics/canvas-layer-blur checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do blur-passes Size
    - radius F64
    - passes Size

. sum Size = 0
for pass in 0 .. < passes
    . canvas = RasterCanvas(914, 914)
    canvas.begin-opacity(1)
    canvas.begin-blur(radius)
    canvas.fill-color = null
    canvas.stroke-color = RGBA(0.2, 0.4, 0.9, 0.8)
    canvas.stroke-width = 10
    canvas.oval(Rect(60, 60, 794, 794))
    canvas.stroke-color = null
    canvas.fill-color = RGBA(0.9, 0.3, 0.1)
    canvas.rect(Rect(300 + (pass as F64), 280, 260, 360))
    canvas.end-blur()
    canvas.end-opacity()
    . bytes = canvas.premultiplied-pixels()
    for index in 0 .. < bytes.size / 97
        sum += bytes[index * 97] as Size
    canvas.close()
= sum
