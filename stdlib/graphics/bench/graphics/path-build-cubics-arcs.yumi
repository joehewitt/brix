`benchmark.meta description: Builds cubic and arc-heavy paths to expose segment construction overhead.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/path
/graphics/point
/graphics/primitives
/math

. checksum = 0 as Size

for pass in 0 .. < 220
    . path = Path()
    . base = pass as Float
    path.move-to(base % 50, base % 40)
    for i in 0 .. < 18
        . f = i as Float
        path.cubic-curve-to()
            - 20 + base + f * 2
            - 30 + f * 3
            - 40 + base / 2 + f * 4
            - 10 + f * 5
            - 60 + base + f * 6
            - 70 + f * 2
        path.arc((80 + f * 3, 80 + f * 2), 8 + (f % 5), 0, π / 2)
    checksum += path.count + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

-- "bench-result graphics/path-build-cubics-arcs checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
