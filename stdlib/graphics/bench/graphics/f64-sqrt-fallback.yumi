`benchmark.meta description: Measures the ordinary F64 square-root call seam for intrinsic comparison.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core
/math.h

. checksum = 0.0
. operations = 4000000

for i in 0 .. < operations
    . value = ((i % 1009) + 1) as F64
    checksum += fallback-sqrt(value)

. checksum-result = (checksum * 1000.0) as Size
-- "bench-result graphics/f64-sqrt-fallback checksum=$checksum-result"

━━━━━━━━━━━━━━━━━━━━
_ fallback-sqrt F64
    - value F64

C:sqrt(value)
