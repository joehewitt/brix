`benchmark.meta description: Tessellates self-crossing polygons such as stars and bowties.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/point
/graphics/polygon
/math

. checksum = 0 as Size

for pass in 0 .. < 260
    . poly = star-polygon(pass)
    . pieces = poly.tessellate()
    checksum += pieces.length + numeric-check(poly.area)
    for piece in pieces
        checksum += piece.points.length + numeric-check(piece.area)

-- "bench-result graphics/polygon-tessellate-self-crossing checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do star-polygon
    - seed Int

. points [Point]
. base = seed as Float
for i in 0 .. < 10
    . f = i as Float
    . radius = if i % 2 == 0 then 70 else 24
    . angle = f * π * 2 / 10 + base / 100
    points += Point(100 + cos(angle) * radius, 100 + sin(angle) * radius)
points += points[0]
= Polygon(points, true)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Float

(abs(value * 1000) as Size) % 1000003
