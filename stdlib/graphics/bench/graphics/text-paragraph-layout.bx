; benchmark.meta description: Shapes, snapshots, and draws a fixed hard-break and word-wrapped paragraph corpus.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)
(blank)

(main
  (let texts (list String))
  (+= texts "Short paragraph text.")
  (+= texts "A longer paragraph with enough ordinary words to wrap at narrow and wide constraints.")
  (+= texts "first hard line\nsecond hard line\r\nthird hard line")
  (+= texts "longtokenwithoutabreakopportunitylongtokenwithoutabreakopportunity")
  (+= texts "é · 👩🏽‍💻 · 日本語 · العربية · עברית · ABC אבג العربية 123")
  (let widths (list 72.5 260.0))
  (let wraps (list (. TextWrap no-wrap) (. TextWrap word)))
  (let one-x (call RasterCanvas 420 260 1))
  (let two-x (call RasterCanvas 420 260 2))
  (let checksum (as 0 Size))
  (blank)
  (do-use one-x
    (do-use two-x
      (= (. one-x text-color) black)
      (= (. two-x text-color) black)
      (for (in pass (..< 0 30))
        (let font (call Font "" (+ 13.0 (* (% pass 2) 0.5)) (. FontWeight regular)))
        (= (. one-x font) font)
        (= (. two-x font) font)
        (for (in text texts)
          (for (in wrap wraps)
            (for (in width widths)
              (let one-layout (call (. one-x text-layout) text width (. TextOverflow clip) wrap))
              (let two-layout (call (. two-x text-layout) text width (. TextOverflow clip) wrap))
              (do-use one-layout
                (do-use two-layout
                  (+= checksum (call paragraph-layout-score (. one-layout snapshot)))
                  (+= checksum (call paragraph-layout-score (. two-layout snapshot)))
                  (call (. one-x draw-text)
                    (block
                      (arg one-layout)
                      (arg (call Rect 0 0 width 220))
                      (arg (. TextAlignment left))
                    )
                  )
                  (call (. two-x draw-text)
                    (block
                      (arg two-layout)
                      (arg (call Rect 0 0 width 220))
                      (arg (. TextAlignment right))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (blank)
  (let tight-texts (list String))
  (+= tight-texts "Short tight text.")
  (+= tight-texts "A longer tight paragraph with a conspicuously short final line.")
  (+= tight-texts "longtokenwithoutabreakopportunitylongtoken")
  (+= tight-texts "é · 👩🏽‍💻 · 日本語 · العربية · עברית")
  (let tight-widths (list 72.5 260.0))
  (let root (call ParagraphBenchmarkRoot))
  (let available-label (call ParagraphAvailableBenchmarkLabel))
  (let tight-label (call ParagraphTightBenchmarkLabel))
  (call markup-append root available-label)
  (call markup-append root tight-label)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (let candidate-layout-count (as 0 Size))
  (let retained-layout-count (as 0 Size))
  (let tight-case-count (as 0 Size))
  (let available-canvas (call RasterCanvas 420 260 1))
  (let tight-canvas (call RasterCanvas 420 260 2))
  (blank)
  (do-use available-canvas
    (do-use tight-canvas
      (for (in pass (..< 0 6))
        (let ignored pass)
        (for (in text tight-texts)
          (= (. available-label text) text)
          (= (. tight-label text) text)
          (for (in width tight-widths)
            (let available-measure (call (. available-label measure) (call measure-fit-query width)))
            (let available-result (. available-measure content-size))
            (call (. available-label arrange-bounds)
              (block
                (arg (call Rect 0 0 (. available-result width) (. available-result height)))
              )
            )
            (call (. available-label paint) available-canvas)
            (+= checksum (call paragraph-layout-score (!! (. available-label text-layout-snapshot))))
            (blank)
            (let created-before-tight (call text-layout-created-count))
            (let tight-result (. (call (. tight-label measure) (call measure-fit-query width)) content-size))
            (+= candidate-layout-count (- (call text-layout-created-count) created-before-tight))
            (+= retained-layout-count
              (scope (if-expr has-snapshot 1 0)
                (lazy has-snapshot (!= (. tight-label text-layout-snapshot) null))
              )
            )
            (call (. tight-label arrange-bounds) (call Rect 0 0 width (. tight-result height)))
            (call (. tight-label paint) tight-canvas)
            (+= checksum (call paragraph-layout-score (!! (. tight-label text-layout-snapshot))))
            (+= checksum (as (call abs (* (- width (. tight-result width)) 1000)) Size))
            (+= tight-case-count 1)
          )
        )
      )
    )
  )
  (blank)
  (call (. available-label close))
  (call (. tight-label close))
  (blank)
  (probe-count graphics.text.layouts-live (call text-layout-live-count))
  (blank)
  (print (str "tight-characterization candidates=" candidate-layout-count " retained=" retained-layout-count " tight-cases=" tight-case-count))
  (print (str "bench-result graphics/text-paragraph-layout checksum=" checksum))
)

(type + ParagraphBenchmarkRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + ParagraphAvailableBenchmarkLabel (is Label)
  (rule This
    (= text-wrap (. TextWrap word))
    (= text-overflow (. TextOverflow clip))
  )
)

(type + ParagraphTightBenchmarkLabel (is ParagraphAvailableBenchmarkLabel)
  (rule This
    (= text-wrap-sizing (. TextWrapSizing tight))
  )
)

(fn-do _ paragraph-layout-score Size
  (param snapshot TextLayoutSnapshot)
  (let score (as (call abs (* (. snapshot size width) 1000)) Size))
  (+= score (as (call abs (* (. snapshot size height) 1000)) Size))
  (+= score (as (call abs (* (. snapshot natural-width) 1000)) Size))
  (+= score (as (call abs (* (. snapshot constrained-width) 1000)) Size))
  (+= score (as (. snapshot line-count) Size))
  (+= score (as (call abs (* (. snapshot first-baseline) 1000)) Size))
  (+= score (as (call abs (* (. snapshot last-baseline) 1000)) Size))
  (for (in line (. snapshot lines))
    (+= score (as (call abs (* (. line typographic-bounds x) 1000)) Size))
    (+= score (as (call abs (* (. line typographic-bounds y) 1000)) Size))
    (+= score (as (call abs (* (. line typographic-bounds width) 1000)) Size))
    (+= score (as (call abs (* (. line typographic-bounds height) 1000)) Size))
    (+= score (as (call abs (* (. line ink-bounds x) 1000)) Size))
    (+= score (as (call abs (* (. line ink-bounds y) 1000)) Size))
    (+= score (as (call abs (* (. line ink-bounds width) 1000)) Size))
    (+= score (as (call abs (* (. line ink-bounds height) 1000)) Size))
    (+= score (as (call abs (* (. line baseline) 1000)) Size))
    (+= score (as (call abs (* (. line ascent) 1000)) Size))
    (+= score (as (call abs (* (. line descent) 1000)) Size))
    (+= score (as (call abs (* (. line leading) 1000)) Size))
  )
  (+= score (if-expr (. snapshot is-truncated) 1 0))
  (return score)
)
