`benchmark.meta description: Splits paths at points and ranges, including wrapped and reverse ranges.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/path
/graphics/primitives
/math

. path = cubic-path()
. checksum = 0 as Size

for pass in 0 .. < 900
    . f = pass as Float
    . max-t = path.curve-count as Float
    . i = pass % (path.curve-count - 2)
    . t1 = (i as Float) + 0.2
    . t2 = t1 + 0.6
    . a, b = path.split-at-point(t1)
    if a
        checksum += numeric-check(a.anchor2.x) + numeric-check(a.anchor2.y)
    if b
        checksum += numeric-check(b.anchor1.x) + numeric-check(b.anchor1.y)

    . subpath = path.split-at-range(t1, t2)
    checksum += subpath.count + numeric-check(subpath.last-point.x)

-- "bench-result graphics/path-split-range checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do cubic-path

. path = Path()
path.move-to(0, 0)
for i in 0 .. < 12
    . f = i as Float
    path.cubic-curve-to(f * 7 + 3, 30 + f * 2, f * 7 + 5, -10 + f, f * 7 + 9, 20 + f * 3)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
