; benchmark.meta description: Recomputes boolean operations for tangent, compound, and cubic-heavy closed paths across a slider sweep.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,graphics-fps,compile-timing
(blank)
(import /graphics/boolean)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /math)
(blank)

(main
  (let checksum (as 0 Size))
  (let a (call Path))
  (let b (call Path))
  (let result (call Path))
  (let workspace (call BooleanWorkspace))
  (blank)
  (for (in item (..< 0 5))
    (call reset-stress-source-a a item item)
    (call reset-stress-source-b b item item)
    (for (in operation (..< 0 4))
      (call boolean-operation-reusing operation result workspace a b)
    )
  )
  (blank)
  (for (in frame (..< 0 32))
    (probe-count graphics.frame.frames)
    (for (in item (..< 0 5))
      (call reset-stress-source-a a item frame)
      (call reset-stress-source-b b item frame)
      (for (in operation (..< 0 4))
        (probe-count graphics.frame.items)
        (let maybe-result (call boolean-operation-reusing operation result workspace a b))
        (+= checksum (+ (call path-score maybe-result) item operation frame))
      )
    )
  )
  (blank)
  (throw (call Panic "boolean slider stress scratch grew too often") (if (> (. workspace growth-count) 16)))
  (blank)
  (print (str "bench-result graphics/boolean-slider-stress checksum=" checksum))
)

(fn-do _ reset-stress-source-a _
  (param path Path)
  (param item _)
  (param frame Int)
  (let f (as frame Float))
  (call (. path clear))
  (if (== item 0)
    (call (. path append-circle) (tuple 82 82) 48)
    (else-if (== item 1)
      (call (. path append-ellipse) (tuple 86 82) (call Dimensions 60 38))
      (call (. path rotate) (+ -12deg (* f 0.12deg)) (call Point 86 82))
    )
    (else-if (== item 2)
      (call (. path append-circle) (tuple 86 82) 56)
    )
    (else-if (== item 3)
      (call append-shared-edge-step path (tuple 22 24) 132 98)
    )
    (else
      (call append-compound-boxes path f)
    )
  )
)

(fn-do _ reset-stress-source-b _
  (param path Path)
  (param item _)
  (param frame Int)
  (let f (as frame Float))
  (call (. path clear))
  (if (== item 0)
    (call (. path append-circle) (tuple (- 177 (* (% f 5) 0.55)) 82) 47)
    (else-if (== item 1)
      (call (. path append-ellipse) (tuple (+ 104 (* (call sin (* f 0.16)) 3)) 83) (call Dimensions 52 34))
      (call (. path rotate) (+ -24deg (* f 0.2deg)) (call Point 104 83))
    )
    (else-if (== item 2)
      (call (. path append-ellipse) (tuple (+ 102 (* (call cos (* f 0.13)) 4)) 80) (call Dimensions 48 36))
      (call (. path rotate) 18deg (call Point 102 80))
    )
    (else-if (== item 3)
      (call (. path append-rectangle) (call Rect 98 42 48 66))
    )
    (else
      (call (. path append-rectangle) (call Rect 66 (+ 42 (% f 5)) 94 54))
    )
  )
)

(fn-do _ boolean-operation-reusing _
  (param operation _)
  (param out Path)
  (param workspace BooleanWorkspace)
  (param a Path)
  (param b Path)
  (if (== operation 0)
    (return (call boolean-union-reusing out workspace a b))
    (else-if (== operation 1)
      (return (call boolean-intersect-reusing out workspace a b))
    )
    (else-if (== operation 2)
      (return (call boolean-subtract-reusing out workspace a b))
    )
  )
  (blank)
  (return (call boolean-clip-reusing out workspace a b))
)

(fn-do _ append-shared-edge-step _
  (param path Path)
  (param origin Point)
  (param width Length)
  (param height Length)
  (let step-x (+ (. origin x) (* width 0.58)))
  (let step-y (+ (. origin y) (* height 0.42)))
  (call (. path move-to) origin)
  (call (. path line-to) step-x (. origin y))
  (call (. path line-to) step-x step-y)
  (call (. path line-to) (+ (. origin x) width) step-y)
  (call (. path line-to) (+ (. origin x) width) (+ (. origin y) height))
  (call (. path line-to) (. origin x) (+ (. origin y) height))
  (call (. path close))
)

(fn-do _ append-compound-boxes _
  (param path Path)
  (param frame Float)
  (call (. path append-rectangle) (call Rect (+ 24 (% frame 4)) 30 42 42))
  (call (. path append-rectangle) (call Rect 102 70 42 42))
)

(fn-expr _ path-score _
  (param path (? Path))
  (case? path
    (call solid-path-score path)
  )
  (default
    0
  )
)

(fn-expr _ solid-path-score Size
  (param path Path)
  (case? (not (. path count))
    0
  )
  (default
    (+ box-score (call numeric-check (. path last-point x)) (call numeric-check (. path last-point y)))
  )
  (where
    (lazy bounds (. path bounding-box))
    (lazy box-score (+ origin-score (call numeric-check (. bounds width)) (call numeric-check (. bounds height))))
    (lazy origin-score (+ (. path count) (call numeric-check (. bounds x)) (call numeric-check (. bounds y))))
  )
)

(fn-expr _ numeric-check Size
  (param value Coord)
  (% (as (call abs (* value 1000)) Size) 1000003)
)
