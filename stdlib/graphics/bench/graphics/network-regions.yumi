`benchmark.meta description: Measures regions while moving an eight-segment network through 24 edits.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/network
/graphics/network-regions
/graphics/network-stroke
/graphics/point

. network = VectorNetwork()
. a = network.add-vertex((20, 20))
. b = network.add-vertex((180, 20))
. c = network.add-vertex((180, 180))
. d = network.add-vertex((20, 180))
. center = network.add-vertex((100, 100))
network.connect(a, b)
network.connect(b, c)
network.connect(c, d)
network.connect(d, a)
network.connect(a, center, (40, 0), (-20, -20))
network.connect(b, center)
network.connect(c, center)
network.connect(d, center)
. regions = NetworkRegionWorkspace()
. strokes = NetworkStrokeWorkspace()
. checksum Size = 0
for frame in 0 .. < 24
    network.move-vertex(center, Point(80.0 + frame, 95.0 + frame % 7))
    checksum += regions.resolve(network).regions.length
-- "bench-result graphics/network-regions checksum=$checksum"
