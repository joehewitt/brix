`benchmark.meta description: Offsets cubic and arc-heavy paths through the public offset API.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/graphic
/graphics/offset
/graphics/path
/graphics/path-set
/graphics/point
/graphics/primitives
/graphics/shapes
/graphics/stroke
/math

. checksum = 0 as Size

for pass in 0 .. < 140
    . source = curve-path(pass)
    . layer = offset-path(PathSet([source]), 5.0 + (pass % 5), .round-join-type, 5)
    checksum += source.count + layer-score(layer)

-- "bench-result graphics/offset-curves checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do curve-path
    - seed Int

. base = seed as Float
. kind = seed % 4
if kind == 0
    = circle((80 + (base % 9), 80 + (base % 7)), 32 + (base % 11))
else if kind == 1
    . path = ellipse((84, 82), Dimensions(48 + (base % 5), 30 + (base % 7)))
    path.rotate(-18deg + (base % 12) * 0.4deg, Point(84, 82))
    = path
else if kind == 2
    = cubic-snake(base)

= petal-loop(Point(90 + (base % 13), 84 + (base % 9)), 46 + (base % 7))

━━━━━━━━━━━━━━━━━━━━
_ do cubic-snake
    - base Float

. center = Point(80 + (base % 11), 82 + (base % 5))
. radius = 62 + (base % 9)
. path = Path()
path.move-to(center + (-radius * 0.86, radius * 0.34))
path.cubic-curve-to()
    - center + (-radius * 0.65, -radius * 0.85)
    - center + (-radius * 0.18, radius * 0.82)
    - center + (radius * 0.06, -radius * 0.08)
path.cubic-curve-to()
    - center + (radius * 0.34, -radius * 1.04)
    - center + (radius * 0.76, radius * 0.74)
    - center + (radius * 0.88, -radius * 0.24)
= path

━━━━━━━━━━━━━━━━━━━━
_ do petal-loop
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (0, -radius * 0.9))
path.cubic-curve-to()
    - center + (radius * 1.25, -radius * 0.72)
    - center + (radius * 0.35, radius * 0.28)
    - center + (radius * 0.78, radius * 0.72)
path.cubic-curve-to()
    - center + (radius * 0.18, radius * 1.08)
    - center + (-radius * 0.4, radius * 0.34)
    - center + (-radius * 0.82, radius * 0.66)
path.cubic-curve-to()
    - center + (-radius * 1.22, radius * 0.08)
    - center + (-radius * 0.55, -radius * 0.72)
    - center + (0, -radius * 0.9)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do layer-score
    - layer PathSet

. score Size
for path in layer.paths
    score += path-score(path)
= score

━━━━━━━━━━━━━━━━━━━━
_ path-score Size
    - path Path

|? !path.count
    0
??
    path.count + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
