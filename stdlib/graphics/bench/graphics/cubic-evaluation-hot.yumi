`benchmark.meta description: Repeats cubic coefficients, control-point evaluation and derivative kernels.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/core
/graphics/curve-kernels

. checksum = 0.0
for index in 0 .. < 5000000
    . control = (index % 17) as F64
    . t = ((index % 1024) as F64) / 1024
    . coeffs = cubic-coefficients-1d(0, control, control + 4, 20)
    checksum += cubic-evaluate-1d(coeffs.a, coeffs.b, coeffs.c, 0, t)
    checksum += cubic-evaluate-control-1d(0, control, control + 4, 20, t)
    checksum += cubic-derivative-1d(coeffs.a, coeffs.b, coeffs.c, t)

-- "bench-result graphics/cubic-evaluation-hot checksum=${checksum as Size}"
