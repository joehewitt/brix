; benchmark.meta description: Runs higher-level lattice drawing through a no-raster counting canvas.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/graphic)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/style)
(import /graphics/vector-group)
(blank)

(main
  (let checksum (as 0 Size))
  (blank)
  (for (in pass (..< 0 420))
    (let grid
      (call lattice-grid
        (block
          (arg (call Rect 0 0 180 140))
          (arg (call Rect 0 0 (+ 12.0 (% pass 5)) (+ 10.0 (% pass 7))))
          (arg 5)
          (arg 7)
        )
      )
    )
    (+= checksum (+ (. grid length) pass))
    (for (in row grid)
      (+= checksum (. row length))
    )
  )
  (blank)
  (let group (call VectorGroup))
  (for (in i (..< 0 80))
    (let f (as i Float))
    (+= group (call VectorGroup (list (call circle (tuple (+ 20 (* (% f 16) 8)) (+ 30 (* (/ f 16) 10))) (+ 4 (% f 5))))))
  )
  (blank)
  (= (. group fill) red)
  (call (. group checkpoint))
  (call (. group update) (call Rect 0 0 240 160))
  (let canvas (call CountingCanvas 240 160))
  (call (. group paint-vector) canvas)
  (blank)
  (+= checksum (+ (. canvas checksum) (. canvas path-count) (. canvas path-segment-count)))
  (print (str "bench-result graphics/art-lattice-counting checksum=" checksum))
)

(fn-do _ lattice-grid _
  (param bounds Rect)
  (param stamp Rect)
  (param spacing-x Float)
  (param spacing-y Float)
  (let rows (list (list Point)))
  (let y (. bounds y))
  (while (< y (. bounds bottom))
    (let row (list Point))
    (let x (. bounds x))
    (while (< x (. bounds right))
      (+= row (call Point (+ x (/ (. stamp width) 2)) (+ y (/ (. stamp height) 2))))
      (+= x (+ (. stamp width) spacing-x))
    )
    (+= rows row)
    (+= y (+ (. stamp height) spacing-y))
  )
  (return rows)
)
