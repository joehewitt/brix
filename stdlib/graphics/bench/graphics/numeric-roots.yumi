`benchmark.meta description: Exercises graphics numeric primitives such as roots, distances, and hull clipping.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/_utils
/graphics/point
/graphics/primitives
/math

. checksum = 0 as Size

for i in 0 .. < 900
    . f = i as Float
    . q = solve-quadratic(1.0, -((f % 17) + 3), (f % 11) - 5, tolerance)
    checksum += q.count + numeric-check(q.root1) + numeric-check(q.root2)

    . c = solve-cubic(1.0, -((f % 9) + 1), (f % 13) - 4, (f % 7) - 2, tolerance)
    checksum += c.count + numeric-check(c.root1) + numeric-check(c.root2) + numeric-check(c.root3)

    . dist = get-signed-distance((0.0, 0.0), (10.0 + (f % 5), 6.0), (f % 13, (f % 19) - 9))
    checksum += numeric-check(dist)

    . hull = get-convex-hull((f % 3) - 1, (f % 5) - 2, (f % 7) - 3, (f % 11) - 5)
    checksum += hull.top.length + hull.bottom.length

-- "bench-result graphics/numeric-roots checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
