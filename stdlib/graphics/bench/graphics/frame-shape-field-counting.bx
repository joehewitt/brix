; benchmark.meta description: Updates and paints a modest multi-frame shape field into CountingCanvas.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/graphic)
(import /graphics/path)
(import /graphics/point)
(import /graphics/shapes)
(import /graphics/style)
(import /graphics/vector-group)
(blank)

(main
  (let canvas (call CountingCanvas 480 360))
  (= (. canvas fill-color) red)
  (= (. canvas stroke-color) blue)
  (= (. canvas stroke-width) 1)
  (blank)
  (let checksum (as 0 Size))
  (for (in frame (..< 0 120))
    (let paths (list Path))
    (for (in i (..< 0 72))
      (let f (as i Float))
      (let x (+ 20 (% (+ (* f 11) frame) 260)))
      (let y (+ 20 (% (+ (* f 7) (* frame 2)) 180)))
      (+= paths (call circle (tuple x y) (+ 5 (% f 8))))
      (+= paths (call rectangle (tuple (+ x 8) (+ y 4) (+ 8 (% f 5)) (+ 6 (% f 7)))))
    )
    (blank)
    (let group (call VectorGroup paths))
    (= (. group fill) red)
    (= (. group stroke) blue)
    (call (. group checkpoint))
    (call (. group paint-vector) canvas)
    (+= checksum (+ (. canvas path-count) (. paths length) frame))
  )
  (blank)
  (+= checksum (+ (. canvas checksum) (. canvas path-segment-count)))
  (print (str "bench-result graphics/frame-shape-field-counting checksum=" checksum))
)
