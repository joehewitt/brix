`benchmark.meta description: Recomputes boolean operations for common closed-shape pairs across a slider sweep.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gc-runtime,graphics,graphics-fps,compile-timing

/graphics/boolean
/graphics/path
/graphics/point
/graphics/primitives
/graphics/shapes
/math

. checksum = 0 as Size
. a = Path()
. b = Path()
. result = Path()
. workspace = BooleanWorkspace()

for item in 0 .. < 8
    reset-moderate-source-a(a, item, item)
    reset-moderate-source-b(b, item, item)
    for operation in 0 .. < 4
        boolean-operation-reusing(operation, result, workspace, a, b)

for frame in 0 .. < 32
    //graphics.frame.frames ++
    for item in 0 .. < 8
        reset-moderate-source-a(a, item, frame)
        reset-moderate-source-b(b, item, frame)
        for operation in 0 .. < 4
            //graphics.frame.items ++
            . maybe-result = boolean-operation-reusing(operation, result, workspace, a, b)
            checksum += path-score(maybe-result) + item + operation + frame

-- "bench-result graphics/boolean-slider-moderate checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do reset-moderate-source-a
    - path Path
    - item
    - frame Int

. f = frame as Float
path.clear()
if item == 0
    path.append-rectangle(Rect(18 + (f % 9), 26, 92, 72))
else if item == 1
    append-diamond(path, (82 + (f % 5), 76), 58)
else if item == 2
    path.append-circle((78 + sin(f * 0.18) * 4, 78), 48)
else if item == 3
    path.append-circle((84, 78), 58)
else if item == 4
    append-shared-edge-step(path, (22, 24), 132, 98)
else if item == 5
    path.append-rectangle(Rect(30, 30, 106, 72))
    path.rotate((-10deg) + f * 0.2deg, Point(83, 66))
else if item == 6
    path.append-circle((75, 78), 46)
else
    append-compound-boxes(path, f)

━━━━━━━━━━━━━━━━━━━━
_ do reset-moderate-source-b
    - path Path
    - item
    - frame Int

. f = frame as Float
path.clear()
if item == 0
    path.append-rectangle(Rect(72 + (f % 7), 48, 90, 70))
else if item == 1
    append-diamond(path, (112 + (f % 6), 76), 58)
else if item == 2
    path.append-ellipse((104, 82 + cos(f * 0.2) * 5), Dimensions(46, 32))
    path.rotate(-16deg + f * 0.15deg, Point(104, 82))
else if item == 3
    path.append-circle((92 + sin(f * 0.11) * 3, 74), 24)
else if item == 4
    path.append-rectangle(Rect(98, 42, 48, 66))
else if item == 5
    append-polygon(path, 5, 98, Point(104, 74))
    path.rotate(13deg - f * 0.18deg, Point(104, 74))
else if item == 6
    path.append-circle((166 + sin(f * 0.17) * 2, 78), 45)
else
    path.append-rectangle(Rect(68, 42 + (f % 5), 94, 54))

━━━━━━━━━━━━━━━━━━━━
_ do boolean-operation-reusing
    - operation
    - out Path
    - workspace BooleanWorkspace
    - a Path
    - b Path

if operation == 0
    = boolean-union-reusing(out, workspace, a, b)
else if operation == 1
    = boolean-intersect-reusing(out, workspace, a, b)
else if operation == 2
    = boolean-subtract-reusing(out, workspace, a, b)

= boolean-clip-reusing(out, workspace, a, b)

━━━━━━━━━━━━━━━━━━━━
_ do append-diamond
    - path Path
    - center Point
    - radius Length

path.move-to(center + (0, -radius))
path.line-to(center + (radius, 0))
path.line-to(center + (0, radius))
path.line-to(center + (-radius, 0))
path.close()

━━━━━━━━━━━━━━━━━━━━
_ do append-shared-edge-step
    - path Path
    - origin Point
    - width Length
    - height Length

. step-x = origin.x + width * 0.58
. step-y = origin.y + height * 0.42
path.move-to(origin)
path.line-to(step-x, origin.y)
path.line-to(step-x, step-y)
path.line-to(origin.x + width, step-y)
path.line-to(origin.x + width, origin.y + height)
path.line-to(origin.x, origin.y + height)
path.close()

━━━━━━━━━━━━━━━━━━━━
_ do append-compound-boxes
    - path Path
    - frame Float

path.append-rectangle(Rect(26 + (frame % 4), 30, 42, 42))
path.append-rectangle(Rect(102, 70, 42, 42))

━━━━━━━━━━━━━━━━━━━━
_ do append-polygon
    - path Path
    - sides U32
    - width Length
    - center Point

. rx Coord = width / 2.0
. ry Coord = width / 2.0
. step = (π * 2.0) / sides
. a1 = -π / 2.0
path.reserve(path.count + (sides as Size) + 1, path.coord-size + (sides as Size) * 2)
for i in 0rad .. < sides
    . angle = a1 + step * (-i + 1.0)
    . point = Point(center.x + cos(angle) * rx, center.y + sin(angle) * ry)
    if i == 0
        path.move-to(point)
    else
        path.line-to(point)
path.close()

━━━━━━━━━━━━━━━━━━━━
_ path-score
    - path Path?

|? path
    solid-path-score(path)
??
    0

━━━━━━━━━━━━━━━━━━━━
_ solid-path-score Size
    - path Path

|? !path.count
    0
??
    box-score + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

.. bounds = path.bounding-box
.. box-score = origin-score + numeric-check(bounds.width) + numeric-check(bounds.height)
.. origin-score = path.count + numeric-check(bounds.x) + numeric-check(bounds.y)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
