; benchmark.meta description: Updates a deterministic layer tree that generates many paths.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/graphic)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/vector)
(import /graphics/vector-group)
(blank)

(main
  (let root (call build-layer-tree))
  (let bounds (call Rect 0 0 320 240))
  (let checksum (as 0 Size))
  (blank)
  (for (in frame (..< 0 160))
    (call (. root update) bounds)
    (let child-count 0)
    (for (in child-path (. root child-paths))
      (+= child-count (. child-path count))
    )
    (+= checksum (+ (. root paths length) child-count))
    (for (in path (. root paths))
      (+= checksum (+ (. path count) frame))
    )
  )
  (blank)
  (print (str "bench-result graphics/layer-update-tree checksum=" checksum))
)

(fn-do _ build-layer-tree _
  (let root (call VectorGroup))
  (= (. root cache-policy) (. GraphicsCachePolicy no-cache))
  (for (in i (..< 0 48))
    (let f (as i Float))
    (let child GraphicNode)
    (if (== (% i 3) 0)
      (let drawing (call Circle (call Point) 1))
      (= (. drawing center) (tuple (+ 20 (* f 5)) (+ 30 (% f 17))))
      (= (. drawing radius) (+ 8 (% f 7)))
      (= child drawing)
      (else-if (== (% i 3) 1)
        (let drawing (call Rectangle (call Rect)))
        (= (. drawing rect) (call Rect (+ 10 (* f 3)) (+ 20 f) (+ 14 (% f 9)) (+ 18 (% f 11))))
        (= child drawing)
      )
      (else
        (let drawing (call Polygon 3 (call Point) 1))
        (= (. drawing sides) (as (+ 5 (% i 5)) U32))
        (= (. drawing center) (tuple (+ 30 (* f 4)) (+ 40 (% f 13))))
        (= (. drawing radius) (+ 10 (% f 6)))
        (= child drawing)
      )
    )
    (+= root child)
  )
  (return root)
)
