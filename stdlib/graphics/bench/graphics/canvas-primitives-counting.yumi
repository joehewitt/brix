`benchmark.meta description: Dispatches primitive canvas drawing commands into CountingCanvas.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/canvas
/graphics/color
/graphics/primitives

. canvas = CountingCanvas(640, 480)
canvas.fill-color = red
canvas.stroke-color = blue
canvas.stroke-width = 2

for pass in 0 .. < 5000
    . f = pass as Float
    canvas.rect((f % 300, (f * 3) % 220, 10 + (f % 17), 8 + (f % 13)))
    canvas.square((f * 5) % 300, (f * 7) % 220, 5 + (f % 11))
    canvas.oval(((f * 11) % 300, (f * 13) % 220, 12 + (f % 9), 14 + (f % 7)))
    canvas.circle((f * 17) % 300, (f * 19) % 220, 4 + (f % 5))

. checksum = canvas.checksum + canvas.primitive-command-count + canvas.command-count
-- "bench-result graphics/canvas-primitives-counting checksum=$checksum"
