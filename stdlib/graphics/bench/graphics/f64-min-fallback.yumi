`benchmark.meta description: Measures the ordinary ordered F64 minimum call seam for intrinsic comparison.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/core

. checksum = 0.0
. operations = 4000000

for i in 0 .. < operations
    . left = ((i % 1009) - 504) as F64
    . right = ((i % 997) - 498) as F64
    checksum += fallback-min(left, right)

. checksum-result = ((checksum + operations * 1000.0) * 1000.0) as Size
-- "bench-result graphics/f64-min-fallback checksum=$checksum-result"

━━━━━━━━━━━━━━━━━━━━
_ fallback-min F64
    - left F64
    - right F64

|? right < left
    right
??
    left
