`benchmark.meta description: Recomputes strokes for tight and self-overlapping paths across a slider-width sweep.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,graphics-fps,compile-timing

/graphics/path
/graphics/point
/graphics/primitives
/graphics/stroke
/math

. sources = stress-slider-sources()
. checksum = sources.length as Size

for frame in 0 .. < 32
    //graphics.frame.frames ++
    . width = slider-width(frame, 8, 36)
    for i in 0 .. < sources.length
        //graphics.frame.items ++
        . source = sources[i]
        . stroked = stroke(source, width, .center, .round-join-type, .butt, 5, 0)
        checksum += source.count + path-score(stroked)

-- "bench-result graphics/stroke-slider-stress checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do stress-slider-sources

. center = Point(120, 100)
. paths [Path]
paths += pretzel-loop(center, 64)
paths += rosette(center, 66, 20, 10, -18deg)
paths += comet-loop(center, 74)
paths += lissajous-loop(center, 68)
= paths

━━━━━━━━━━━━━━━━━━━━
_ slider-width Length
    - frame Int
    - min-width Length
    - max-width Length

min-width + (max-width - min-width) * ((frame as Float) / 31)

━━━━━━━━━━━━━━━━━━━━
_ do pretzel-loop
    - center Point
    - radius Length

. path = Path()
. first = true
for t in 0.0 .. < π * 2.0 by 0.08
    . point = Point()
        - center.x + sin(t * 3.0 + 0.35) * radius
        - center.y + sin(t * 4.0) * radius * 0.72
    if first
        path.move-to(point)
        first = false
    else
        path.line-to(point)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do rosette
    - center Point
    - outer-radius Length
    - inner-radius Length
    - lobes Int
    - rotation Radians

. path = Path()
. count = lobes * 2
. step = (π * 2) / count

for i in 0 .. < count
    . a1 = rotation + step * i
    . a2 = rotation + step * (i + 1)
    . r1 = if i % 2 == 0 then outer-radius else inner-radius
    . r2 = if (i + 1) % 2 == 0 then outer-radius else inner-radius
    . bulge = outer-radius * (0.62 + ((i % 4) as Float) * 0.07)
    . p1 = center.translate-at-angle(a1, r1)
    . p2 = center.translate-at-angle(a2, r2)
    . h1 = center.translate-at-angle(a1 + step * 0.45, r1 + bulge)
    . h2 = center.translate-at-angle(a2 - step * 0.45, r2 + bulge)

    if i == 0
        path.move-to(p1)

    path.cubic-curve-to(h1, h2, p2)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do comet-loop
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.9, 0))
path.cubic-curve-to()
    - center + (-radius * 0.5, -radius * 1.05)
    - center + (radius * 0.32, -radius * 0.62)
    - center + (radius * 0.68, -radius * 0.18)
path.cubic-curve-to()
    - center + (radius * 1.24, radius * 0.5)
    - center + (-radius * 0.18, radius * 0.95)
    - center + (-radius * 0.05, radius * 0.04)
path.cubic-curve-to()
    - center + (-radius * 0.34, -radius * 0.32)
    - center + (-radius * 0.54, radius * 0.38)
    - center + (-radius * 0.9, 0)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do lissajous-loop
    - center Point
    - radius Length

. path = Path()
. first = true
for t in 0.0 .. < π * 2.0 by 0.07
    . point = Point(center.x + sin(t * 5.0 + 0.6) * radius, center.y + sin(t * 7.0) * radius * 0.74)
    if first
        path.move-to(point)
        first = false
    else
        path.line-to(point)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ path-score Size
    - path Path

|? !path.count
    0
??
    path.count + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
