; benchmark.meta description: Builds many line-heavy paths to expose segment append and invalidation overhead.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)

(main
  (let checksum (as 0 Size))
  (blank)
  (for (in pass (..< 0 420))
    (let path (call Path))
    (let base (as pass Float))
    (call (. path move-to) (% base 37) (% base 19))
    (for (in i (..< 0 48))
      (let f (as i Float))
      (call (. path line-to) (% (+ base (* f 7)) 200) (% (+ (* base 3) (* f 11)) 180))
    )
    (if (== (% pass 2) 0)
      (call (. path close))
    )
    (+= checksum (+ (. path count) (call numeric-check (. path last-point x)) (call numeric-check (. path last-point y))))
  )
  (blank)
  (print (str "bench-result graphics/path-build-lines checksum=" checksum))
)

(fn-expr _ numeric-check Size
  (param value Coord)
  (% (as (call abs (* value 1000)) Size) 1000003)
)
