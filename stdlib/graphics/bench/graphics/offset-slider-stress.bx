; benchmark.meta description: Recomputes offsets for self-overlapping and curve-heavy paths across a slider-distance sweep.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,graphics-fps,compile-timing
(blank)
(import /graphics/graphic)
(import /graphics/offset)
(import /graphics/path)
(import /graphics/path-set)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/stroke)
(import /math)
(blank)

(main
  (let sources (call stress-slider-sources))
  (let plans (call offset-slider-plans sources))
  (let checksum (as (. sources length) Size))
  (blank)
  (for (in frame (..< 0 32))
    (probe-count graphics.frame.frames)
    (let distance (call slider-distance frame 8 34))
    (for (in i (..< 0 (. sources length)))
      (probe-count graphics.frame.items)
      (let source ([] sources i))
      (let layer (call offset-plan-layer ([] plans i) distance .round-join-type 5))
      (+= checksum (+ (. source count) (call layer-score layer)))
    )
  )
  (blank)
  (print (str "bench-result graphics/offset-slider-stress checksum=" checksum))
)

(fn-do _ stress-slider-sources _
  (let center (call Point 120 100))
  (let paths (list Path))
  (+= paths (call rosette center 66 20 10 -18deg))
  (+= paths (call lissajous-loop center 68))
  (+= paths (call petal-loop center 76))
  (+= paths (call bowtie-loop center 76))
  (return paths)
)

(fn-expr _ offset-slider-plans (list OffsetPlan)
  (param sources (list Path))
  (in (call offset-plan each) sources)
)

(fn-expr _ slider-distance Length
  (param frame Int)
  (param min-distance Length)
  (param max-distance Length)
  (+ min-distance (* (- max-distance min-distance) (/ (as frame Float) 31)))
)

(fn-do _ rosette _
  (param center Point)
  (param outer-radius Length)
  (param inner-radius Length)
  (param lobes Int)
  (param rotation Radians)
  (let path (call Path))
  (let count (* lobes 2))
  (let step (/ (* π 2) count))
  (blank)
  (for (in i (..< 0 count))
    (let a1 (+ rotation (* step i)))
    (let a2 (+ rotation (* step (+ i 1))))
    (let r1 (if-expr (== (% i 2) 0) outer-radius inner-radius))
    (let r2 (if-expr (== (% (+ i 1) 2) 0) outer-radius inner-radius))
    (let bulge (* outer-radius (+ 0.62 (* (as (% i 4) Float) 0.07))))
    (let p1 (call (. center translate-at-angle) a1 r1))
    (let p2 (call (. center translate-at-angle) a2 r2))
    (let h1 (call (. center translate-at-angle) (+ a1 (* step 0.45)) (+ r1 bulge)))
    (let h2 (call (. center translate-at-angle) (- a2 (* step 0.45)) (+ r2 bulge)))
    (blank)
    (if (== i 0)
      (call (. path move-to) p1)
    )
    (blank)
    (call (. path cubic-curve-to) h1 h2 p2)
  )
  (blank)
  (call (. path close))
  (return path)
)

(fn-do _ lissajous-loop _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (let first true)
  (for (in t (..< 0.0 (* π 2.0) (by: 0.07)))
    (let point (call Point (+ (. center x) (* (call sin (+ (* t 5.0) 0.6)) radius)) (+ (. center y) (* (call sin (* t 7.0)) radius 0.74))))
    (if first
      (call (. path move-to) point)
      (= first false)
      (else
        (call (. path line-to) point)
      )
    )
  )
  (blank)
  (call (. path close))
  (return path)
)

(fn-do _ petal-loop _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple 0 (* (- radius) 0.9))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 1.25) (* (- radius) 0.72))))
      (arg (+ center (tuple (* radius 0.35) (* radius 0.28))))
      (arg (+ center (tuple (* radius 0.78) (* radius 0.72))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 0.18) (* radius 1.08))))
      (arg (+ center (tuple (* (- radius) 0.4) (* radius 0.34))))
      (arg (+ center (tuple (* (- radius) 0.82) (* radius 0.66))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 1.22) (* radius 0.08))))
      (arg (+ center (tuple (* (- radius) 0.55) (* (- radius) 0.72))))
      (arg (+ center (tuple 0 (* (- radius) 0.9))))
    )
  )
  (call (. path close))
  (return path)
)

(fn-do _ bowtie-loop _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.76) (* (- radius) 0.58))))
  (call (. path line-to) (+ center (tuple (* radius 0.76) (* radius 0.58))))
  (call (. path line-to) (+ center (tuple (* (- radius) 0.76) (* radius 0.58))))
  (call (. path line-to) (+ center (tuple (* radius 0.76) (* (- radius) 0.58))))
  (call (. path close))
  (return path)
)

(fn-do _ layer-score _
  (param layer PathSet)
  (let score Size)
  (for (in path (. layer paths))
    (+= score (call path-score path))
  )
  (return score)
)

(fn-expr _ path-score Size
  (param path Path)
  (case? (not (. path count))
    0
  )
  (default
    (+ (. path count) (call numeric-check (. path last-point x)) (call numeric-check (. path last-point y)))
  )
)

(fn-expr _ numeric-check Size
  (param value Coord)
  (% (as (call abs (* value 1000)) Size) 1000003)
)
