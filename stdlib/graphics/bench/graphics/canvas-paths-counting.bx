; benchmark.meta description: Dispatches many multi-segment paths into CountingCanvas without rasterization.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/canvas)
(import /graphics/color)
(blank)

(main
  (let canvas (call CountingCanvas 640 480))
  (= (. canvas fill-color) red)
  (= (. canvas stroke-color) blue)
  (= (. canvas stroke-width) 1)
  (blank)
  (for (in pass (..< 0 1200))
    (let f (as pass Float))
    (call (. canvas begin))
    (call (. canvas move) (% f 200) (% (* f 3) 180))
    (for (in i (..< 0 8))
      (let step (as i Float))
      (call (. canvas line) (% (+ f (* step 11)) 240) (% (+ (* f 2) (* step 7)) 220))
    )
    (call (. canvas curve) (+ f 3) (+ f 5) (+ f 9) (+ f 13) (+ f 17) (+ f 19))
    (if (== (% pass 3) 0)
      (call (. canvas enclose))
    )
    (call (. canvas end))
  )
  (blank)
  (let checksum (+ (. canvas checksum) (. canvas path-count) (. canvas path-segment-count) (. canvas command-count)))
  (print (str "bench-result graphics/canvas-paths-counting checksum=" checksum))
)
