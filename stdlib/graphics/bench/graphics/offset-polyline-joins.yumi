`benchmark.meta description: Offsets line-heavy paths with square, miter, and round joins through the public API.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/graphic
/graphics/offset
/graphics/path
/graphics/path-set
/graphics/point
/graphics/primitives
/graphics/stroke
/math

. checksum = 0 as Size

for pass in 0 .. < 240
    . source = offset-join-source(pass)
    . layer = offset-path(PathSet([source]), 4.0 + (pass % 7), offset-join(pass), 5)
    checksum += source.count + layer-score(layer)

-- "bench-result graphics/offset-polyline-joins checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do offset-join-source
    - seed Int

. base = seed as Float
. path = Path()
path.move-to(0, 50 + (base % 23))
for i in 1 .. < 18
    . f = i as Float
    path.line-to(f * 12, 50 + ((base + f * 17) % 80))

if seed % 5 == 0
    path.close()

= path

━━━━━━━━━━━━━━━━━━━━
_ offset-join
    - seed Int

|? kind == 0
    .square-join-type
|? kind == 1
    .miter-join-type
??
    .round-join-type

.. kind = seed % 3

━━━━━━━━━━━━━━━━━━━━
_ do layer-score
    - layer PathSet

. score Size
for path in layer.paths
    score += path-score(path)
= score

━━━━━━━━━━━━━━━━━━━━
_ path-score Size
    - path Path

|? !path.count
    0
??
    path.count + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
