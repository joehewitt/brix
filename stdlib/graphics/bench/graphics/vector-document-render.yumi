`benchmark.meta description: Times VectorDocumentRenderer full builds, single-edit syncs, restore syncs, and direct CoreGraphics paints for 1000 square networks in 10 layers.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: vector-document,compile-timing

/graphics/canvas
/graphics/color
/graphics/document
/graphics/document-render
/graphics/point
/graphics/primitives
/graphics/shapes
/time/timer

. doc = use VectorDocument()
doc.set-stroke(doc.root, RGBA("#222222"))
doc.set-stroke-width(doc.root, 1)
. shapes [U64]
. layer = doc.root
for index in 0 .. < 1000
    if index % 100 == 0
        layer = doc.create-group(doc.root, "Layer ${index / 100}")
        doc.set-fill(layer, RGBA(((index / 100) as F64) / 10, 0.4, 0.8, 1))
    . x = index % 40 * 20.0
    . y = index / 40 * 20.0
    shapes += doc.add-path(layer, rectangle(Rect(x, y, 12, 12)), "Square $index")

. renderer = use VectorDocumentRenderer(doc)
. build-start = monotonic-time-nanoseconds()
renderer.sync()
. build-us = (monotonic-time-nanoseconds() - build-start) / 1000
. checksum = renderer.last-built

. original = use doc.snapshot()
. repeats Size = 50
. edit-ns U64
. restore-ns U64
. restore-built Size = 0
for repeat in 0 .. < repeats
    doc.set-opacity(shapes[(repeat * 37) % 1000], 0.5)
    doc.set-fill(shapes[(repeat * 53) % 1000], RGBA(1, (repeat as F64) / 50, 0, 1))
    . edit-start = monotonic-time-nanoseconds()
    renderer.sync()
    edit-ns += monotonic-time-nanoseconds() - edit-start
    checksum += renderer.last-built
    doc.restore(original)
    . restore-start = monotonic-time-nanoseconds()
    renderer.sync()
    restore-ns += monotonic-time-nanoseconds() - restore-start
    restore-built += renderer.last-built

. canvas = RasterCanvas(800, 520, 1)
. paint-ns U64
do use canvas
    for repeat in 0 .. < 20
        canvas.erase(RGBA(1, 1, 1, 1))
        . paint-start = monotonic-time-nanoseconds()
        renderer.paint(canvas)
        paint-ns += monotonic-time-nanoseconds() - paint-start

//graphics.bench.document.render-build-us += build-us
//graphics.bench.document.render-edit-sync-us += edit-ns / 1000 / repeats
//graphics.bench.document.render-restore-sync-us += restore-ns / 1000 / repeats
//graphics.bench.document.render-restore-built += restore-built
//graphics.bench.document.render-paint-us += paint-ns / 1000 / 20
-- "bench-result graphics/vector-document-render checksum=$checksum"
