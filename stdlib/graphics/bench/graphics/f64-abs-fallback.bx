; benchmark.meta description: Measures the ordinary F64 absolute-value call seam for intrinsic comparison.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core)
(import /math.h)
(blank)

(main
  (let checksum 0.0)
  (let operations 4000000)
  (blank)
  (for (in i (..< 0 operations))
    (let value (as (- (% i 1009) 504) F64))
    (+= checksum (call fallback-abs value))
  )
  (blank)
  (let checksum-result (as (* checksum 1000.0) Size))
  (print (str "bench-result graphics/f64-abs-fallback checksum=" checksum-result))
)

(fn-expr _ fallback-abs F64
  (param value F64)
  (call C:fabs value)
)
