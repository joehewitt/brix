`benchmark.meta description: Shapes, snapshots, and draws the Phase 0 single-line text corpus.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/canvas
/graphics/color
/graphics/primitives
/graphics/text
/math

. texts [String]
texts += ""
texts += "Brix text layout"
texts += "spaces   tabs\tcombining e\u0301"
texts += "Emoji 👩🏽‍💻 CJK 日本語 Arabic العربية Hebrew עברית"
texts += "A deliberately long line for deterministic tail truncation"
. one-x = RasterCanvas(420, 120, 1)
. two-x = RasterCanvas(420, 120, 2)
. checksum = 0 as Size

do use one-x
    do use two-x
        one-x.text-color = black
        two-x.text-color = black
        for pass in 0 .. < 40
            for weight in [FontWeight.regular, FontWeight.bold]
                . font = Font("", 13.0 + ((pass % 2) * 0.5), weight)
                one-x.font = font
                two-x.font = font
                . ellipsis = TextLayout("…", font)
                do use ellipsis
                    . widths = [0.0, ellipsis.natural-width - 0.01, 24.0, 72.5, 160.0, 400.0]
                    for text in texts
                        . natural = one-x.text-layout(text, null, TextOverflow.clip)
                        do use natural
                            checksum += text-layout-score(natural.snapshot)
                        for width in widths
                            . layout = one-x.text-layout(text, width)
                            do use layout
                                checksum += text-layout-score(layout.snapshot)
                                if width >= 72
                                    one-x.draw-text
                                        - layout
                                        - Rect(0, 0, width, 28)
                                        - TextAlignment.left
                                    two-x.draw-text
                                        - layout
                                        - Rect(0, 0, width, 28)
                                        - TextAlignment.left

//graphics.text.layouts-live += text-layout-live-count()

-- "bench-result graphics/text-line-layout checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do text-layout-score Size
    - snapshot TextLayoutSnapshot

. line = snapshot.lines[0]
. score = abs(snapshot.size.width * 1000) as Size
score += abs(snapshot.size.height * 1000) as Size
score += abs(snapshot.natural-width * 1000) as Size
score += abs(snapshot.constrained-width * 1000) as Size
score += snapshot.line-count as Size
score += abs(snapshot.first-baseline * 1000) as Size
score += abs(snapshot.last-baseline * 1000) as Size
score += abs(line.typographic-bounds.x * 1000) as Size
score += abs(line.typographic-bounds.y * 1000) as Size
score += abs(line.typographic-bounds.width * 1000) as Size
score += abs(line.typographic-bounds.height * 1000) as Size
score += abs(line.ink-bounds.x * 1000) as Size
score += abs(line.ink-bounds.y * 1000) as Size
score += abs(line.ink-bounds.width * 1000) as Size
score += abs(line.ink-bounds.height * 1000) as Size
score += abs(line.baseline * 1000) as Size
score += abs(line.ascent * 1000) as Size
score += abs(line.descent * 1000) as Size
score += abs(line.leading * 1000) as Size
score += if snapshot.is-truncated then 1 else 0
= score
