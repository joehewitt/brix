`benchmark.meta description: Measures canonical F64 square-root lowering in a hot loop.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/math

. checksum = 0.0
. operations = 4000000

for i in 0 .. < operations
    . value = ((i % 1009) + 1) as F64
    checksum += sqrt(value)

. checksum-result = (checksum * 1000.0) as Size
-- "bench-result graphics/f64-sqrt checksum=$checksum-result"
