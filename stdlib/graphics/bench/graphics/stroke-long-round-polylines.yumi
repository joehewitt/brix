`benchmark.meta description: Strokes long closed round polylines to expose overlap-scan cost.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/path
/graphics/point
/graphics/primitives
/graphics/stroke
/math

. checksum = 0 as Size

for pass in 0 .. < 40
    . source = round-ring-polyline(pass, 180 + (pass % 17))
    . stroked = stroke()
        - source
        - 6.0 + (pass % 5)
        - .center
        - .round-join-type
        - .butt
        - 5
        - 0
    checksum += source.count + path-score(stroked)

-- "bench-result graphics/stroke-long-round-polylines checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do round-ring-polyline
    - seed Int
    - count Int

. center = Point(120, 100)
. radius = 68 + ((seed % 9) as Float)
. path = Path()
for i in 0 .. < count
    . t = ((i as Float) / (count as Float)) * π * 2
    . wobble = 1 + sin(t * 5 + (seed as Float) * 0.07) * 0.06
    . point = Point(center.x + cos(t) * radius * wobble, center.y + sin(t) * radius * 0.72 * wobble)
    if i == 0
        path.move-to(point)
    else
        path.line-to(point)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ path-score Size
    - path Path

|? !path.count
    0
??
    path.count + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
