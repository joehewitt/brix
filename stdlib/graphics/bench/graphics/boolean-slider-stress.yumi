`benchmark.meta description: Recomputes boolean operations for tangent, compound, and cubic-heavy closed paths across a slider sweep.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,graphics-fps,compile-timing

/graphics/boolean
/graphics/path
/graphics/point
/graphics/primitives
/graphics/shapes
/math

. checksum = 0 as Size
. a = Path()
. b = Path()
. result = Path()
. workspace = BooleanWorkspace()

for item in 0 .. < 5
    reset-stress-source-a(a, item, item)
    reset-stress-source-b(b, item, item)
    for operation in 0 .. < 4
        boolean-operation-reusing(operation, result, workspace, a, b)

for frame in 0 .. < 32
    //graphics.frame.frames ++
    for item in 0 .. < 5
        reset-stress-source-a(a, item, frame)
        reset-stress-source-b(b, item, frame)
        for operation in 0 .. < 4
            //graphics.frame.items ++
            . maybe-result = boolean-operation-reusing(operation, result, workspace, a, b)
            checksum += path-score(maybe-result) + item + operation + frame

?! Panic("boolean slider stress scratch grew too often")
    if workspace.growth-count > 16

-- "bench-result graphics/boolean-slider-stress checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do reset-stress-source-a
    - path Path
    - item
    - frame Int

. f = frame as Float
path.clear()
if item == 0
    path.append-circle((82, 82), 48)
else if item == 1
    path.append-ellipse((86, 82), Dimensions(60, 38))
    path.rotate(-12deg + f * 0.12deg, Point(86, 82))
else if item == 2
    path.append-circle((86, 82), 56)
else if item == 3
    append-shared-edge-step(path, (22, 24), 132, 98)
else
    append-compound-boxes(path, f)

━━━━━━━━━━━━━━━━━━━━
_ do reset-stress-source-b
    - path Path
    - item
    - frame Int

. f = frame as Float
path.clear()
if item == 0
    path.append-circle((177 - (f % 5) * 0.55, 82), 47)
else if item == 1
    path.append-ellipse((104 + sin(f * 0.16) * 3, 83), Dimensions(52, 34))
    path.rotate(-24deg + f * 0.2deg, Point(104, 83))
else if item == 2
    path.append-ellipse((102 + cos(f * 0.13) * 4, 80), Dimensions(48, 36))
    path.rotate(18deg, Point(102, 80))
else if item == 3
    path.append-rectangle(Rect(98, 42, 48, 66))
else
    path.append-rectangle(Rect(66, 42 + (f % 5), 94, 54))

━━━━━━━━━━━━━━━━━━━━
_ do boolean-operation-reusing
    - operation
    - out Path
    - workspace BooleanWorkspace
    - a Path
    - b Path

if operation == 0
    = boolean-union-reusing(out, workspace, a, b)
else if operation == 1
    = boolean-intersect-reusing(out, workspace, a, b)
else if operation == 2
    = boolean-subtract-reusing(out, workspace, a, b)

= boolean-clip-reusing(out, workspace, a, b)

━━━━━━━━━━━━━━━━━━━━
_ do append-shared-edge-step
    - path Path
    - origin Point
    - width Length
    - height Length

. step-x = origin.x + width * 0.58
. step-y = origin.y + height * 0.42
path.move-to(origin)
path.line-to(step-x, origin.y)
path.line-to(step-x, step-y)
path.line-to(origin.x + width, step-y)
path.line-to(origin.x + width, origin.y + height)
path.line-to(origin.x, origin.y + height)
path.close()

━━━━━━━━━━━━━━━━━━━━
_ do append-compound-boxes
    - path Path
    - frame Float

path.append-rectangle(Rect(24 + (frame % 4), 30, 42, 42))
path.append-rectangle(Rect(102, 70, 42, 42))

━━━━━━━━━━━━━━━━━━━━
_ path-score
    - path Path?

|? path
    solid-path-score(path)
??
    0

━━━━━━━━━━━━━━━━━━━━
_ solid-path-score Size
    - path Path

|? !path.count
    0
??
    box-score + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

.. bounds = path.bounding-box
.. box-score = origin-score + numeric-check(bounds.width) + numeric-check(bounds.height)
.. origin-score = path.count + numeric-check(bounds.x) + numeric-check(bounds.y)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
