`benchmark.meta description: Measures canonical F64 minimum lowering in a hot loop.
`benchmark.meta timing: recommended
`benchmark.meta profiles: compile-timing

/math

. checksum = 0.0
. operations = 4000000

for i in 0 .. < operations
    . left = ((i % 1009) - 504) as F64
    . right = ((i % 997) - 498) as F64
    checksum += min(left, right)

. checksum-result = ((checksum + operations * 1000.0) * 1000.0) as Size
-- "bench-result graphics/f64-min checksum=$checksum-result"
