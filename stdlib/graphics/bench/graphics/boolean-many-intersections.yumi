`benchmark.meta description: Boolean operations over high-intersection polygon pairs to track arrangement scaling.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/boolean
/graphics/path
/graphics/point
/graphics/primitives
/graphics/shapes
/math

. checksum = 0 as Size

for pass in 0 .. < 90
    . a = many-intersection-source-a(pass)
    . b = many-intersection-source-b(pass)
    for operation in 0 .. < 4
        . result = boolean-operation(operation, a, b)
        checksum += path-score(result) + pass + operation

-- "bench-result graphics/boolean-many-intersections checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do many-intersection-source-a
    - pass Int

. path = polygon(28, 118, Point(90, 90))
path.rotate((pass as Float) * 0.11deg, Point(90, 90))
= path

━━━━━━━━━━━━━━━━━━━━
_ do many-intersection-source-b
    - pass Int

. path = polygon(28, 116, Point(98, 90))
path.rotate(6deg + (pass as Float) * -0.09deg, Point(98, 90))
= path

━━━━━━━━━━━━━━━━━━━━
_ boolean-operation
    - operation
    - a Path
    - b Path

|? operation == 0
    union(a, b)
|? operation == 1
    intersect(a, b)
|? operation == 2
    subtract(a, b)
??
    clip(a, b)

━━━━━━━━━━━━━━━━━━━━
_ path-score
    - path Path?

|? path
    solid-path-score(path)
??
    0

━━━━━━━━━━━━━━━━━━━━
_ solid-path-score Size
    - path Path

|? !path.count
    0
??
    box-score + numeric-check(path.last-point.x) + numeric-check(path.last-point.y)

.. bounds = path.bounding-box
.. box-score = origin-score + numeric-check(bounds.width) + numeric-check(bounds.height)
.. origin-score = path.count + numeric-check(bounds.x) + numeric-check(bounds.y)

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Coord

(abs(value * 1000) as Size) % 1000003
