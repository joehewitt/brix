; benchmark.meta description: Times VectorDocument snapshot, restore, and changed-node scans for documents of 10, 100, and 1000 square networks.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: vector-document,compile-timing
(blank)
(import /graphics/document)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /time/timer)
(blank)

(main
  (let checksum Size 0)
  (+= checksum (call run-document-snapshot 10 2000 0))
  (+= checksum (call run-document-snapshot 100 400 1))
  (+= checksum (call run-document-snapshot 1000 40 2))
  (print (str "bench-result graphics/vector-document-snapshot checksum=" checksum))
)

(fn-do _ run-document-snapshot _
  (param count Size)
  (param repeats Size)
  (param scale Size)
  (let doc (use (call VectorDocument)))
  (let layer (. doc root))
  (let shapes (list U64))
  (for (in index (..< 0 count))
    (if (== (% index 100) 0)
      (= layer (call (. doc create-group) (. doc root) (str "Layer " (/ index 100))))
    )
    (let x (* (% index 40) 20.0))
    (let y (* (/ index 40) 20.0))
    (+= shapes (call (. doc add-path) layer (call rectangle (call Rect x y 12 12)) (str "Square " index)))
  )
  (blank)
  (let original (use (call (. doc snapshot))))
  (call (. doc set-opacity) ([] shapes (/ count 2)) 0.5)
  (let edited (use (call (. doc snapshot))))
  (let pooled (use (call (. doc snapshot))))
  (blank)
  (let checksum Size 0)
  (let snapshot-start (call monotonic-time-nanoseconds))
  (for (in repeat (..< 0 repeats))
    (call (. doc snapshot-into) pooled)
    (+= checksum (. pooled byte-count))
  )
  (let snapshot-us (/ (- (call monotonic-time-nanoseconds) snapshot-start) 1000 repeats))
  (blank)
  (let restore-start (call monotonic-time-nanoseconds))
  (for (in repeat (..< 0 repeats))
    (call (. doc restore) (if-expr (== (% repeat 2) 0) original edited))
    (+= checksum (. doc node-count))
  )
  (let restore-us (/ (- (call monotonic-time-nanoseconds) restore-start) 1000 repeats))
  (blank)
  (let tracker (call VectorDocumentChangeTracker))
  (+= checksum (. (call (. tracker scan) doc) changed length))
  (let diff-ns U64)
  (for (in repeat (..< 0 repeats))
    (call (. doc restore) (if-expr (== (% repeat 2) 0) original edited))
    (let diff-start (call monotonic-time-nanoseconds))
    (let changes (call (. tracker scan) doc))
    (+= diff-ns (- (call monotonic-time-nanoseconds) diff-start))
    (+= checksum (. changes changed length))
  )
  (let diff-us (/ diff-ns 1000 repeats))
  (blank)
  (match scale
    (case= 0
      (probe-count graphics.bench.document.snapshot-us-small snapshot-us)
      (probe-count graphics.bench.document.restore-us-small restore-us)
      (probe-count graphics.bench.document.stamp-diff-us-small diff-us)
      (probe-count graphics.bench.document.snapshot-bytes-small (. pooled byte-count))
    )
    (case= 1
      (probe-count graphics.bench.document.snapshot-us-medium snapshot-us)
      (probe-count graphics.bench.document.restore-us-medium restore-us)
      (probe-count graphics.bench.document.stamp-diff-us-medium diff-us)
      (probe-count graphics.bench.document.snapshot-bytes-medium (. pooled byte-count))
    )
    (default
      (probe-count graphics.bench.document.snapshot-us-large snapshot-us)
      (probe-count graphics.bench.document.restore-us-large restore-us)
      (probe-count graphics.bench.document.stamp-diff-us-large diff-us)
      (probe-count graphics.bench.document.snapshot-bytes-large (. pooled byte-count))
    )
  )
  (return checksum)
)
