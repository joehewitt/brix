`benchmark.meta description: Runs line-path intersections with many emitted intersections.
`benchmark.meta timing: recommended
`benchmark.meta profiles: graphics,compile-timing

/graphics/intersection
/graphics/path
/graphics/point
/graphics/shapes
/math

. path = circle((120, 120), 55)
. checksum = 0 as Size

for pass in 0 .. < 900
    . f = pass as Float
    . y = 70 + (f % 100)
    . hits = intersect-path-line(path, (20, y), (220, y))
    checksum += hits.length
    for hit in hits
        checksum += numeric-check(hit.t1) + numeric-check(hit.t2)

-- "bench-result graphics/intersect-line-path-hit checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ numeric-check Size
    - value Float

(abs(value * 1000) as Size) % 1000003
