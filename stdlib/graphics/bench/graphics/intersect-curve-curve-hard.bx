; benchmark.meta description: Stresses curve-curve fat-line refinement with near-tangent cubic pairs.
; benchmark.meta timing: recommended
; benchmark.meta profiles: graphics,compile-timing
(blank)
(import /graphics/intersection)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)

(main
  (let checksum (as 0 Size))
  (blank)
  (for (in pass (..< 0 160))
    (let f (as pass Float))
    (let a (call hard-curve 0 (% f 9)))
    (let b (call hard-curve 8 (- (% f 11) 5)))
    (let results (call intersect-paths a b false))
    (+= checksum (+ (. results length) pass))
    (for (in result results)
      (for (in hit (. result intersections))
        (+= checksum (+ (call numeric-check (. hit t1)) (call numeric-check (. hit t2))))
      )
    )
  )
  (blank)
  (print (str "bench-result graphics/intersect-curve-curve-hard checksum=" checksum))
)

(fn-do _ hard-curve _
  (param x-offset Coord)
  (param y-offset Coord)
  (let path (call Path))
  (call (. path move-to) (+ 0 x-offset) (+ 80 y-offset))
  (for (in i (..< 0 5))
    (let f (as i Float))
    (call (. path cubic-curve-to)
      (block
        (arg (+ 30 x-offset (* f 30)))
        (arg (+ 10 y-offset f))
        (arg (+ 55 x-offset (* f 30)))
        (arg (- (+ 150 y-offset) f))
        (arg (+ 80 x-offset (* f 30)))
        (arg (+ 80 y-offset))
      )
    )
  )
  (return path)
)

(fn-expr _ numeric-check Size
  (param value Float)
  (% (as (call abs (* value 1000)) Size) 1000003)
)
