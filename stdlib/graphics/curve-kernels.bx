(import ./primitives)
(import /math)
(blank)
(prop _ kernel-tolerance _ (= 10e-6))

(type + CubicCoefficients1D (is Tuple)
  (prop + a Coord)
  (prop + b Coord)
  (prop + c Coord)
)

(type + XYScalars (is Tuple)
  (prop + x Coord)
  (prop + y Coord)
)

(type + CoordBounds (is Tuple)
  (prop + min Coord)
  (prop + max Coord)
)

(type + RectScalars (is Tuple)
  (prop + min-x Coord)
  (prop + min-y Coord)
  (prop + max-x Coord)
  (prop + max-y Coord)
)

(type + CurveRangeScalars (is Tuple)
  (prop + type SegmentType)
  (prop + x1 Coord)
  (prop + y1 Coord)
  (prop + hox Coord)
  (prop + hoy Coord)
  (prop + hix Coord)
  (prop + hiy Coord)
  (prop + x2 Coord)
  (prop + y2 Coord)
)

(type + CurveSplitScalars (is Tuple)
  (prop + left CurveRangeScalars)
  (prop + right CurveRangeScalars)
)

(type + CubicRootsScalars (is Tuple)
  (prop + root1 Coord)
  (prop + root2 Coord)
  (prop + root3 Coord)
  (prop + count I8)
  (fn-do + This _
    (param r1 Coord)
    (return (call CubicRootsScalars r1 0 0 1))
  )
  (fn-do + This _
    (param r1 Coord)
    (param r2 Coord)
    (return (call CubicRootsScalars r1 r2 0 2))
  )
  (fn-do + This _
    (param r1 Coord)
    (param r2 Coord)
    (param r3 Coord)
    (return (call CubicRootsScalars r1 r2 r3 3))
  )
  (fn-expr + (index-get this (param index Index)) _
    (case? (== index 0)
      root1
    )
    (case? (== index 1)
      root2
    )
    (case? (== index 2)
      root3
    )
    (default
      -1
    )
  )
)

(type + LineIntersectionScalars (is Tuple)
  (prop + hit Bool)
  (prop + t1 PointOnCurve)
  (prop + t2 PointOnCurve)
  (prop + x Coord)
  (prop + y Coord)
)

(type + CubicLineIntersectionsScalars (is Tuple)
  (prop + count I8)
  (prop + curve-first PointOnCurve)
  (prop + line-first PointOnCurve)
  (prop + curve-second PointOnCurve)
  (prop + line-second PointOnCurve)
  (prop + curve-third PointOnCurve)
  (prop + line-third PointOnCurve)
)

(type + CubicSampleScalars (is Tuple)
  (prop + x Coord)
  (prop + y Coord)
  (prop + distance Length)
)

(fn-expr + cubic-coefficients-1d _ @inline
  (param a1 Coord)
  (param ho Coord)
  (param hi Coord)
  (param a2 Coord)
  (call CubicCoefficients1D a b c)
  (where
    (lazy c (* 3.0 (- ho a1)))
    (lazy b (- (* 3.0 (- hi ho)) c))
    (lazy a (- a2 a1 c b))
  )
)

(fn-expr + cubic-evaluate-1d Coord @inline
  (param a Coord)
  (param b Coord)
  (param c Coord)
  (param a1 Coord)
  (param t PointOnCurve)
  (+ (* (+ (* (+ (* a t) b) t) c) t) a1)
)

(fn-expr + cubic-evaluate-control-1d _ @inline
  (param a1 Coord)
  (param ho Coord)
  (param hi Coord)
  (param a2 Coord)
  (param t PointOnCurve)
  (call cubic-evaluate-1d (. coeffs a) (. coeffs b) (. coeffs c) a1 t
    (block
      (lazy coeffs (call cubic-coefficients-1d a1 ho hi a2))
    )
  )
)

(fn-expr + cubic-derivative-1d Coord @inline
  (param a Coord)
  (param b Coord)
  (param c Coord)
  (param t PointOnCurve)
  (+ (* (+ (* 3.0 a t) (* 2.0 b)) t) c)
)

(fn-expr + cubic-evaluate-xy _
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param t PointOnCurve)
  (call XYScalars
    (block
      (arg (call cubic-evaluate-1d (. cx a) (. cx b) (. cx c) x1 t))
      (arg (call cubic-evaluate-1d (. cy a) (. cy b) (. cy c) y1 t))
    )
  )
  (where
    (lazy cx (call cubic-coefficients-1d x1 hox hix x2))
    (lazy cy (call cubic-coefficients-1d y1 hoy hiy y2))
  )
)

(fn-do + cubic-derivative-xy _
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param t PointOnCurve)
  (let cx (call cubic-coefficients-1d x1 hox hix x2))
  (let cy (call cubic-coefficients-1d y1 hoy hiy y2))
  (let dx Coord)
  (let dy Coord)
  (let degenerate-start (and (< t kernel-tolerance) (== hox x1) (== hoy y1)))
  (let degenerate-end (and (> t (- 1 kernel-tolerance)) (== hix x2) (== hiy y2)))
  (if (and degenerate-start (or (!= hix x1) (!= hiy y1)))
    (= dx (- hix x1))
    (= dy (- hiy y1))
    (else-if (and degenerate-end (or (!= hox x2) (!= hoy y2)))
      (= dx (- x2 hox))
      (= dy (- y2 hoy))
    )
    (else-if (or degenerate-start degenerate-end)
      (= dx (- x2 x1))
      (= dy (- y2 y1))
    )
    (else-if (< t kernel-tolerance)
      (= dx (. cx c))
      (= dy (. cy c))
    )
    (else-if (> t (- 1.0 kernel-tolerance))
      (= dx (* 3.0 (- x2 hix)))
      (= dy (* 3.0 (- y2 hiy)))
    )
    (else
      (= dx (call cubic-derivative-1d (. cx a) (. cx b) (. cx c) t))
      (= dy (call cubic-derivative-1d (. cy a) (. cy b) (. cy c) t))
    )
  )
  (blank)
  (return (call XYScalars dx dy))
)

(fn-expr + cubic-normal-xy _
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param t PointOnCurve)
  (call XYScalars (. tangent y) (- (. tangent x))
    (block
      (lazy tangent (call cubic-derivative-xy x1 y1 hox hoy hix hiy x2 y2 t))
    )
  )
)

(fn-do + cubic-offset-point-xy _ (without gc)
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param t PointOnCurve)
  (param distance Length)
  (let point (call cubic-evaluate-xy x1 y1 hox hoy hix hiy x2 y2 t))
  (let normal (call cubic-normal-xy x1 y1 hox hoy hix hiy x2 y2 t))
  (let normal-length (call sqrt (+ (* (. normal x) (. normal x)) (* (. normal y) (. normal y)))))
  (let scale (if-expr (not normal-length) 1.0 (/ distance normal-length)))
  (return (call XYScalars (+ (. point x) (* (. normal x) scale)) (+ (. point y) (* (. normal y) scale))))
)

(fn-expr + line-like-scalars _
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (and (< (call abs (- x1 hox)) 0.01) (< (call abs (- y1 hoy)) 0.01) (< (call abs (- hix x2)) 0.01) (< (call abs (- hiy y2)) 0.01))
)

(fn-expr + line-length-scalars Length
  (param x1 Coord)
  (param y1 Coord)
  (param x2 Coord)
  (param y2 Coord)
  (call sqrt (+ (* dx dx) (* dy dy))
    (block
      (lazy dx (- x2 x1))
      (lazy dy (- y2 y1))
    )
  )
)

(fn-expr + line-normal-xy _
  (param x1 Coord)
  (param y1 Coord)
  (param x2 Coord)
  (param y2 Coord)
  (case? (<= length kernel-tolerance)
    (call XYScalars 0 0)
  )
  (default
    (call XYScalars (/ dy length) (/ (- dx) length))
  )
  (where
    (lazy dx (- x2 x1))
    (lazy dy (- y2 y1))
    (lazy length (call sqrt (+ (* dx dx) (* dy dy))))
  )
)

(fn-expr + line-bounds-1d _
  (param a1 Coord)
  (param a2 Coord)
  (call CoordBounds (call min a1 a2) (call max a1 a2))
)

(fn-do + cubic-bounds-1d CoordBounds
  (param a1 Coord)
  (param ho Coord)
  (param hi Coord)
  (param a2 Coord)
  (param epsilon _ (= kernel-tolerance))
  (let a (+ (- (* 3.0 (- ho hi)) a1) a2))
  (let b (- (* 2.0 (+ a1 hi)) (* 4.0 ho)))
  (let c (- ho a1))
  (let min (call min a1 a2))
  (let max (call max a1 a2))
  (let t-min epsilon)
  (let t-max (- 1.0 epsilon))
  (let roots (call solve-quadratic-scalars a b c epsilon))
  (if (>= (. roots count) 0)
    (for (in i (..< 0 (. roots count)))
      (let t (if-expr (== i 0) (. roots root1) (. roots root2)))
      (if (and (> t t-min) (< t t-max))
        (let pt (call cubic-evaluate-control-1d a1 ho hi a2 t))
        (if (< pt min)
          (= min pt)
        )
        (if (> pt max)
          (= max pt)
        )
      )
    )
  )
  (blank)
  (return (call CoordBounds min max))
)

(fn-expr + cubic-bounds-xy RectScalars
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param epsilon _ (= kernel-tolerance))
  (call RectScalars (. bx min) (. bounds-y min) (. bx max) (. bounds-y max))
  (where
    (lazy bx (call cubic-bounds-1d x1 hox hix x2 epsilon))
    (lazy bounds-y (call cubic-bounds-1d y1 hoy hiy y2 epsilon))
  )
)

(fn-expr + cubic-roots-for-x CubicRootsScalars
  (param value Coord)
  (param x1 Coord)
  (param hox Coord)
  (param hix Coord)
  (param x2 Coord)
  (param epsilon _ (= kernel-tolerance))
  (call solve-cubic-scalars (. c a) (. c b) (. c c) (- x1 value) epsilon)
  (where
    (lazy c (call cubic-coefficients-1d x1 hox hix x2))
  )
)

(fn-expr + cubic-roots-for-y CubicRootsScalars
  (param value Coord)
  (param y1 Coord)
  (param hoy Coord)
  (param hiy Coord)
  (param y2 Coord)
  (param epsilon _ (= kernel-tolerance))
  (call solve-cubic-scalars (. c a) (. c b) (. c c) (- y1 value) epsilon)
  (where
    (lazy c (call cubic-coefficients-1d y1 hoy hiy y2))
  )
)

(fn-do + cubic-parameter-at-point PointOnCurve
  (param point-x Coord)
  (param point-y Coord)
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param epsilon _ (= kernel-tolerance))
  (if (and (< (call abs (- x1 point-x)) epsilon) (< (call abs (- y1 point-y)) epsilon))
    (return 0)
  )
  (blank)
  (if (and (< (call abs (- x2 point-x)) epsilon) (< (call abs (- y2 point-y)) epsilon))
    (return 1)
  )
  (blank)
  (let txs (call cubic-roots-for-x point-x x1 hox hix x2 epsilon))
  (let tys (call cubic-roots-for-y point-y y1 hoy hiy y2 epsilon))
  (let sx (. txs count))
  (let sy (. tys count))
  (let tx PointOnCurve)
  (let ty PointOnCurve)
  (let cx Index 0)
  (while (or (== sx -1) (< cx sx))
    (if (and (or (== sx -1) (>= (= tx ([] txs cx)) 0)) (<= tx 1))
      (let cy Index 0)
      (while (or (== sy -1) (< cy sy))
        (if (and (or (== sy -1) (>= (= ty ([] tys cy)) 0)) (<= ty 1))
          (if (== sx -1)
            (= tx ty)
            (else-if (== sy -1)
              (= ty tx)
            )
          )
          (blank)
          (if (< (call abs (- tx ty)) epsilon)
            (return (* (+ tx ty) 0.5))
          )
        )
        (blank)
        (+= cy 1)
      )
      (blank)
      (if (== sx -1)
        (break)
      )
    )
    (blank)
    (+= cx 1)
  )
  (blank)
  (return -1)
)

(fn-expr + point-on-cubic-scalars Bool
  (param point-x Coord)
  (param point-y Coord)
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param epsilon _ (= kernel-tolerance))
  (>= (call cubic-parameter-at-point point-x point-y x1 y1 hox hoy hix hiy x2 y2 epsilon) 0)
)

(fn-expr + line-range-scalars _
  (param x1 Coord)
  (param y1 Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param t1 PointOnCurve)
  (param t2 PointOnCurve)
  (call CurveRangeScalars .segment-type-line sx sy sx sy ex ey ex ey)
  (where
    (lazy sx (+ x1 (* (- x2 x1) t1)))
    (lazy sy (+ y1 (* (- y2 y1) t1)))
    (lazy ex (+ x1 (* (- x2 x1) t2)))
    (lazy ey (+ y1 (* (- y2 y1) t2)))
  )
)

(fn-expr + cubic-subdivide-scalars _
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param t PointOnCurve)
  (call CurveSplitScalars
    (block
      (arg (call CurveRangeScalars .segment-type-cubic x1 y1 p3x p3y p6x p6y p8x p8y))
      (arg (call CurveRangeScalars .segment-type-cubic p8x p8y p7x p7y p5x p5y x2 y2))
    )
  )
  (where
    (lazy u (- 1 t))
    (lazy p3x (+ (* u x1) (* t hox)))
    (lazy p3y (+ (* u y1) (* t hoy)))
    (lazy p4x (+ (* u hox) (* t hix)))
    (lazy p4y (+ (* u hoy) (* t hiy)))
    (lazy p5x (+ (* u hix) (* t x2)))
    (lazy p5y (+ (* u hiy) (* t y2)))
    (lazy p6x (+ (* u p3x) (* t p4x)))
    (lazy p6y (+ (* u p3y) (* t p4y)))
    (lazy p7x (+ (* u p4x) (* t p5x)))
    (lazy p7y (+ (* u p4y) (* t p5y)))
    (lazy p8x (+ (* u p6x) (* t p7x)))
    (lazy p8y (+ (* u p6y) (* t p7y)))
  )
)

(fn-do + cubic-range-scalars _
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param t1 PointOnCurve)
  (param t2 PointOnCurve)
  (let out (call CurveRangeScalars .segment-type-cubic x1 y1 hox hoy hix hiy x2 y2))
  (if (> t1 0)
    (let split
      (call cubic-subdivide-scalars
        (block
          (arg (. out x1))
          (arg (. out y1))
          (arg (. out hox))
          (arg (. out hoy))
          (arg (. out hix))
          (arg (. out hiy))
          (arg (. out x2))
          (arg (. out y2))
          (arg t1)
        )
      )
    )
    (= out (. split right))
  )
  (blank)
  (if (< t2 1)
    (let split
      (call cubic-subdivide-scalars
        (block
          (arg (. out x1))
          (arg (. out y1))
          (arg (. out hox))
          (arg (. out hoy))
          (arg (. out hix))
          (arg (. out hiy))
          (arg (. out x2))
          (arg (. out y2))
          (arg (/ (- t2 t1) (- 1.0 t1)))
        )
      )
    )
    (= out (. split left))
  )
  (blank)
  (return out)
)

(fn-expr + curve-range-scalars _
  (param type SegmentType)
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param t1 PointOnCurve)
  (param t2 PointOnCurve)
  (case? (== type .segment-type-line)
    (call line-range-scalars x1 y1 x2 y2 t1 t2)
  )
  (default
    (call cubic-range-scalars x1 y1 hox hoy hix hiy x2 y2 t1 t2)
  )
)

(fn-do + cubic-sample-length _ (without gc)
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param prev-x Coord)
  (param prev-y Coord)
  (param t PointOnCurve)
  (let point (call cubic-evaluate-xy x1 y1 hox hoy hix hiy x2 y2 t))
  (let dx (- (. point x) prev-x))
  (let dy (- (. point y) prev-y))
  (return (call CubicSampleScalars (. point x) (. point y) (call sqrt (+ (* dx dx) (* dy dy)))))
)

(fn-expr + line-line-intersection-scalars LineIntersectionScalars
  (param x1 Coord)
  (param y1 Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param x3 Coord)
  (param y3 Coord)
  (param x4 Coord)
  (param y4 Coord)
  (param as-infinity _ (= false))
  (case? (== den 0)
    (call LineIntersectionScalars false 0 0 0 0)
  )
  (case? (and (not as-infinity) (or (< t1 0) (< t2 0) (> t1 1) (> t2 1)))
    (call LineIntersectionScalars false t1 t2 0 0)
  )
  (default
    (call LineIntersectionScalars true t1 t2 (+ x1 (* t1 (- x2 x1))) (+ y1 (* t1 (- y2 y1))))
  )
  (where
    (lazy den (- (* (- y4 y3) (- x2 x1)) (* (- x4 x3) (- y2 y1))))
    (lazy t1 (/ (- (* (- x4 x3) (- y1 y3)) (* (- y4 y3) (- x1 x3))) den))
    (lazy t2 (/ (- (* (- x2 x1) (- y1 y3)) (* (- y2 y1) (- x1 x3))) den))
  )
)

(fn-do + cubic-line-intersections-prepared-scalars CubicLineIntersectionsScalars
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param lx1 Coord)
  (param ly1 Coord)
  (param linelength Length)
  (param lux Coord)
  (param luy Coord)
  (param epsilon _ (= kernel-tolerance))
  ; Translate and align the curve so the line points along the negative x axis.
  (let dx (- x1 lx1))
  (let dy (- y1 ly1))
  (let sx (- (+ (* dx lux) (* dy luy))))
  (let sy (- (* dx luy) (* dy lux)))
  (blank)
  (= dx (- hox lx1))
  (= dy (- hoy ly1))
  (let ox (- (+ (* dx lux) (* dy luy))))
  (let oy (- (* dx luy) (* dy lux)))
  (blank)
  (= dx (- hix lx1))
  (= dy (- hiy ly1))
  (let ix (- (+ (* dx lux) (* dy luy))))
  (let iy (- (* dx luy) (* dy lux)))
  (blank)
  (= dx (- x2 lx1))
  (= dy (- y2 ly1))
  (let ex (- (+ (* dx lux) (* dy luy))))
  (let ey (- (* dx luy) (* dy lux)))
  (blank)
  (if (or (> (call min (call min sy oy) (call min iy ey)) epsilon) (< (call max (call max sy oy) (call max iy ey)) (- epsilon)))
    (return (call CubicLineIntersectionsScalars 0 0 0 0 0 0 0))
  )
  (blank)
  (let candidates (call cubic-roots-for-y 0.0 sy oy iy ey epsilon))
  (let count I8)
  (let curvefirst PointOnCurve)
  (let linefirst PointOnCurve)
  (let curvesecond PointOnCurve)
  (let linesecond PointOnCurve)
  (let curvethird PointOnCurve)
  (let linethird PointOnCurve)
  (blank)
  (if (< (. candidates count) 0)
    (let endpoint 0)
    (while (< endpoint 2)
      (let curveparam (if-expr (== endpoint 0) 0.0 1.0))
      (let root (* (call round (/ curveparam epsilon)) epsilon))
      (if (not (call has-root-scalar count curvefirst curvesecond curvethird root epsilon))
        (let x (call cubic-evaluate-control-1d sx ox ix ex curveparam))
        (let lineparam (/ (- x) linelength))
        (if (and (>= lineparam (- epsilon)) (<= lineparam (+ 1.0 epsilon)))
          (= lineparam (if-expr (< lineparam 0) 0.0 lineparam))
          (= lineparam (if-expr (> lineparam 1) 1.0 lineparam))
          (if (== count 0)
            (= curvefirst curveparam)
            (= linefirst lineparam)
            (else-if (== count 1)
              (= curvesecond curveparam)
              (= linesecond lineparam)
            )
            (else
              (= curvethird curveparam)
              (= linethird lineparam)
            )
          )
          (+= count 1)
        )
      )
      (+= endpoint 1)
    )
    (else
      (for (in candidateindex (..< 0 (. candidates count)))
        (let candidate ([] candidates candidateindex))
        (if (or (< candidate (- epsilon)) (> candidate (+ 1.0 epsilon)))
          (continue)
        )
        (let curveparam (if-expr (< candidate 0) 0.0 candidate))
        (= curveparam (if-expr (> curveparam 1) 1.0 curveparam))
        (let root (* (call round (/ curveparam epsilon)) epsilon))
        (if (call has-root-scalar count curvefirst curvesecond curvethird root epsilon)
          (continue)
        )
        (blank)
        (let x (call cubic-evaluate-control-1d sx ox ix ex curveparam))
        (let lineparam (/ (- x) linelength))
        (if (and (>= lineparam (- epsilon)) (<= lineparam (+ 1.0 epsilon)))
          (= lineparam (if-expr (< lineparam 0) 0.0 lineparam))
          (= lineparam (if-expr (> lineparam 1) 1.0 lineparam))
          (if (== count 0)
            (= curvefirst curveparam)
            (= linefirst lineparam)
            (else-if (== count 1)
              (= curvesecond curveparam)
              (= linesecond lineparam)
            )
            (else
              (= curvethird curveparam)
              (= linethird lineparam)
            )
          )
          (+= count 1)
        )
      )
    )
  )
  (blank)
  (return
    (call CubicLineIntersectionsScalars
      (block
        (arg count)
        (arg curvefirst)
        (arg linefirst)
        (arg curvesecond)
        (arg linesecond)
        (arg curvethird)
        (arg linethird)
      )
    )
  )
)

(fn-expr + cubic-line-intersections-scalars CubicLineIntersectionsScalars
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param lx1 Coord)
  (param ly1 Coord)
  (param lx2 Coord)
  (param ly2 Coord)
  (param epsilon _ (= kernel-tolerance))
  (case? (<= linelength epsilon)
    (call CubicLineIntersectionsScalars 0 0 0 0 0 0 0)
  )
  (default
    (call cubic-line-intersections-prepared-scalars
      (block
        (arg x1)
        (arg y1)
        (arg hox)
        (arg hoy)
        (arg hix)
        (arg hiy)
        (arg x2)
        (arg y2)
        (arg lx1)
        (arg ly1)
        (arg linelength)
        (arg lux)
        (arg luy)
        (arg epsilon)
      )
    )
  )
  (where
    (lazy linelength (call line-length-scalars lx1 ly1 lx2 ly2))
    (lazy lux (/ (- lx2 lx1) linelength))
    (lazy luy (/ (- ly2 ly1) linelength))
  )
)

(fn-expr _ has-root-scalar _
  (param count I8)
  (param first PointOnCurve)
  (param second PointOnCurve)
  (param third PointOnCurve)
  (param root PointOnCurve)
  (param epsilon Coord)
  (case? (and (> count 0) (< (call abs (- first root)) epsilon))
    true
  )
  (case? (and (> count 1) (< (call abs (- second root)) epsilon))
    true
  )
  (case? (and (> count 2) (< (call abs (- third root)) epsilon))
    true
  )
  (default
    false
  )
)

(fn-expr _ solve-quadratic-scalars CubicRootsScalars
  (param a _)
  (param b _)
  (param c _)
  (param epsilon _)
  (case? (< (call abs a) epsilon)
    (case? (>= (call abs b) epsilon)
      (call CubicRootsScalars (/ (- c) b))
    )
    (case? (< (call abs c) epsilon)
      (call CubicRootsScalars 0 0 0 -1)
    )
    (default
      (call CubicRootsScalars)
    )
  )
  (case? (< q 0)
    (call CubicRootsScalars)
  )
  (case? (> sqrt-q 0)
    (call CubicRootsScalars x1 x2)
  )
  (default
    (call CubicRootsScalars x1)
  )
  (where
    (lazy q (- (* b b) (* 4.0 a c)))
    (lazy sqrt-q (call sqrt q))
    (lazy x1 (/ (+ (- b) sqrt-q) (* 2.0 a)))
    (lazy x2 (/ (- (- b) sqrt-q) (* 2.0 a)))
  )
)

(fn-do _ solve-cubic-scalars CubicRootsScalars
  (param a _)
  (param b _)
  (param c _)
  (param d _)
  (param epsilon _)
  (if (< (call abs a) epsilon)
    (return (call solve-quadratic-scalars b c d epsilon))
  )
  (blank)
  ; Normalize to form: x^3 + b x^2 + c x + d = 0:
  (/= b a)
  (/= c a)
  (/= d a)
  (blank)
  (let bb (* b b))
  (if (and (> (call abs b) (/ 1 (call sqrt epsilon))) (< (call abs c) (/ bb 64)) (< (call abs d) (/ (* (call abs b) bb) 64)))
    (let root (- b))
    (for (in ignored (..< 0 4))
      (let value (+ (* (+ (* (+ root b) root) c) root) d))
      (let slope (+ (* (+ (* 3 root) (* 2 b)) root) c))
      (-= root (/ value slope))
    )
    (let constant (/ (- d) root))
    (let linear (/ (- constant c) root))
    (let remaining (call solve-quadratic-scalars 1.0 linear constant epsilon))
    (if (== (. remaining count) 2)
      (return (call CubicRootsScalars root (. remaining root1) (. remaining root2)))
      (else-if (== (. remaining count) 1)
        (return (call CubicRootsScalars root (. remaining root1)))
      )
    )
    (return (call CubicRootsScalars root))
  )
  (blank)
  (let p (* (/ 1.0 3.0) (+ (* (/ -1.0 3.0) bb) c)))
  (let q (* (/ 1.0 2.0) (+ (- (* (/ 2.0 27.0) b bb) (* (/ 1.0 3.0) b c)) d)))
  (let ppp (* p p p))
  (let dd (+ (* q q) ppp))
  (blank)
  (/= b 3)
  (blank)
  (if (< (call abs dd) epsilon)
    (if (< (call abs q) epsilon)
      (return (call CubicRootsScalars (- b)))
      (else
        (let u (call cbrt (- q)))
        (return (call CubicRootsScalars (- (* 2.0 u) b) (- (- u) b)))
      )
    )
    (else-if (< dd 0)
      (let phi (* (/ 1.0 3.0) (call acos (/ (- q) (call sqrt (- ppp))))))
      (let t (* 2.0 (call sqrt (- p))))
      (return (call CubicRootsScalars (- (* t (call cos phi)) b) (- (* (- t) (call cos (+ phi (/ π 3.0)))) b) (- (* (- t) (call cos (- phi (/ π 3.0)))) b)))
    )
    (else
      (let sdd (call sqrt dd))
      (return (call CubicRootsScalars (- (call cbrt (- sdd q)) (call cbrt (+ sdd q)) b)))
    )
  )
)
