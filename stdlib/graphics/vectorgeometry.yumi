    - inherits-stroke

────────────────────
+ get supports-raster-cache Bool

!inherits-fill && !inherits-stroke

────────────────────
+ do paint
    - canvas Canvas
    - palette [RGBA]

paint-offset(canvas, palette, 0)

────────────────────
+ do paint-offset
    - canvas Canvas
    - palette [RGBA]
    - offset U32

. inherited-fill RGBA?
if inherits-fill
    inherited-fill = canvas.fill-color
. inherited-stroke RGBA?
if inherits-stroke
    inherited-stroke = canvas.stroke-color
. inherited-stroke-width = canvas.stroke-width
. inherited-stroke-cap = canvas.stroke-cap
. inherited-stroke-join = canvas.stroke-join

for span in spans
    if span.fill.role == VectorGeometryPaintRole.none
        canvas.fill-color = null
    else if span.fill.role == VectorGeometryPaintRole.inherit
        canvas.fill-color = inherited-fill
    else if span.fill.role == VectorGeometryPaintRole.inherited-stroke
        canvas.fill-color = inherited-stroke
    else
        canvas.fill-color = palette[offset + span.fill.index]
    . stroke-color = match span.stroke.role
        |= VectorGeometryPaintRole.inherit
            inherited-stroke
        |= VectorGeometryPaintRole.none
            null
        ??
            palette[offset + span.stroke.index]
    . stroke-width = span.stroke-width ?? inherited-stroke-width
    canvas.stroke-width = stroke-width
    canvas.stroke-cap = span.stroke-cap ?? inherited-stroke-cap
    canvas.stroke-join = span.stroke-join ?? inherited-stroke-join
    if span.stroke-alignment == StrokeAlignment.center || !stroke-color
        canvas.stroke-color = stroke-color
        span.path.outline(canvas, span.fill-rule)
    else
        canvas.stroke-color = null
        if canvas.fill-color
            span.path.outline(canvas, span.fill-rule)
        canvas.stroke-color = stroke-color
        paint-aligned-stroke(canvas, span.path, span.fill-rule, span.stroke-alignment, stroke-width)

────────────────────
+ do template-tint (compatible Bool, tint RGBA)
    - palette [RGBA]
    - offset U32
    - inherited-fill RGBA?
    - inherited-stroke RGBA?

. found = false
. has-inherited = false
. tint = transparent
for span in spans
    . fill RGBA?
    if span.fill.role == VectorGeometryPaintRole.inherit
        fill = inherited-fill
        has-inherited = true
    else if span.fill.role == VectorGeometryPaintRole.inherited-stroke
        fill = inherited-stroke
        has-inherited = true
    else if span.fill.role == VectorGeometryPaintRole.color
        fill = palette[offset + span.fill.index]
    if fill
        if found && tint != fill
            = (false, transparent)
        tint = fill
        found = true

    . stroke RGBA?
    if span.stroke.role == VectorGeometryPaintRole.inherit
        stroke = inherited-stroke
        has-inherited = true
    else if span.stroke.role == VectorGeometryPaintRole.color
        stroke = palette[offset + span.stroke.index]
    if stroke
        if found && tint != stroke
            = (false, transparent)
        tint = stroke
        found = true
= (found && has-inherited, tint)

