=? existing if existing
= store(fingerprint, build())

────────────────────
+ do insert-image ImageHandle
    - resource ImageResource

. index U32
. entry ImageResourceEntry
if image-free-indices
    index = image-free-indices[image-free-indices.length - 1]
    image-free-indices.remove(image-free-indices.length - 1)
    entry = image-entries[index]
    entry.resource = resource
    entry.references = 1
else
    index = image-entries.length as U32
    entry = ImageResourceEntry(resource, 1)
    image-entries += entry
= ImageHandle(index, entry.generation)

────────────────────
+ do resolve-image ImageResource?
    - handle ImageHandle

=? if handle.index >= image-entries.length
. entry = image-entries[handle.index]
=? if entry.generation != handle.generation
= entry.resource

────────────────────
+ do paint-image-resource Bool
