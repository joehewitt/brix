────────────────────
_ do retain-fingerprint VectorGeometryHandle?
    - fingerprint U64

. existing-index = lookup[fingerprint]
=? if !existing-index
. entry = entries[existing-index]
=? if !entry.geometry
entry.references += 1
remove-from-grace(existing-index)
= VectorGeometryHandle(existing-index, entry.generation)

────────────────────
_ do store VectorGeometryHandle
    - fingerprint U64
    - geometry VectorGeometry

. index U32
. entry VectorGeometryEntry
if free-indices
    index = free-indices[free-indices.length - 1]
    free-indices.remove(free-indices.length - 1)
    entry = entries[index]
    entry.fingerprint = fingerprint
    entry.geometry = geometry
    entry.references = 1
else
    index = entries.length as U32
    entry = VectorGeometryEntry(fingerprint, geometry, 1)
    entries += entry

lookup[fingerprint] = index
= VectorGeometryHandle(index, entry.generation)

────────────────────
_ do paint-cached-vector-raster
    - handle VectorGeometryHandle
    - geometry VectorGeometry
    - canvas Canvas
    - palette [RGBA]
    - palette-offset U32
    - palette-count U32
    - current Matrix
    - device Matrix

. scale = canvas.scale
. view = geometry.view-box
. scale-x = device.a * scale
. scale-y = device.d * scale
. left = (view.x * device.a + device.tx) * scale
. top = (view.y * device.d + device.ty) * scale
. origin-x = floor(left)
. origin-y = floor(top)
. phase-x = round((left - origin-x) * (vector-raster-phase-steps as F64)) as I32
. phase-y = round((top - origin-y) * (vector-raster-phase-steps as F64)) as I32
if phase-x == vector-raster-phase-steps
    origin-x += 1
    phase-x = 0
if phase-y == vector-raster-phase-steps
    origin-y += 1
    phase-y = 0
. pixel-width = vector-raster-pixel-extent(phase-x, view.width * scale-x)
. pixel-height = vector-raster-pixel-extent(phase-y, view.height * scale-y)
=? false if pixel-width <= 0 || pixel-height <= 0
. image-bytes = (pixel-width as Size) * (pixel-height as Size) * 4
=? false if image-bytes > vector-raster-max-entry-bytes

. template = geometry.template-tint(palette, palette-offset, canvas.fill-color, canvas.stroke-color)
. template-alpha = template.compatible
=? false if !template-alpha && !geometry.supports-raster-cache
. palette-key U64
if !template-alpha
    palette-key = vector-geometry-palette-key(palette, palette-offset, palette-count)
. request = VectorRasterEntry
    - handle
    - pixel-width
    - pixel-height
    - scale-x
    - scale-y
    - phase-x
    - phase-y
    - canvas.stroke-width
    - canvas.stroke-cap
    - canvas.stroke-join
    - canvas.stroke-dash
    - template-alpha
    - palette-key
    - 0
request.key = vector-raster-key(request)
. tint = template.tint if template-alpha
raster-clock += 1

. found = raster-lookup[request.key]
if found
    . entry = found
    if entry.matches(request)
        . image = resolve-image(entry.image-handle)
        if image
            entry.last-use = raster-clock
            draw-vector-raster(image, canvas, current, origin-x, origin-y, entry, scale, tint)
            = true
        evict-raster-entry(entry)
    = false

. slot = (request.key % (vector-raster-sighting-count as U64)) as Index
if raster-sighting-keys[slot] != request.key
    raster-sighting-keys[slot] = request.key
    raster-sighting-draws[slot] = 1
    = false
raster-sighting-draws[slot] += 1
=? false if raster-sighting-draws[slot] < vector-raster-promotion-draws
raster-sighting-draws[slot] = 0
=? false if !can-reclaim-raster-bytes(image-bytes)
raster-sighting-keys[slot] = 0

request.last-use = raster-clock
request.image-handle = create-vector-raster-image
    - request
    - geometry
    - palette
    - palette-offset
    - palette-count
    - scale
request.image-bytes = image-bytes
request.slot = raster-entries.length
raster-entries += request
raster-lookup[request.key] = request
raster-byte-count += image-bytes
enforce-raster-budget(request)
. promoted = resolve-image(request.image-handle)
=? false if !promoted
draw-vector-raster(promoted, canvas, current, origin-x, origin-y, request, scale, tint)
= true

────────────────────
_ do draw-vector-raster
    - image ImageResource
    - canvas Canvas
    - current Matrix
    - origin-x F64
    - origin-y F64
    - entry VectorRasterEntry
    - scale F64
    - tint RGBA?

. rect = Rect
    - (origin-x / scale - current.tx) / current.a
    - (origin-y / scale - current.ty) / current.d
    - ((entry.pixel-width as F64) / scale) / current.a
    - ((entry.pixel-height as F64) / scale) / current.d
image.draw • destination canvas
    - rect
    - tint

────────────────────
_ do remove-from-grace
    - index U32

for position in 0 .. < grace.length
    if grace[position] == index
        grace.remove(position)
        break

────────────────────
_ do evict
    - index U32

remove-from-grace(index)
=? if index >= entries.length
. entry = entries[index]
=? if entry.references || !entry.geometry
. handle = VectorGeometryHandle(index, entry.generation)
evict-raster-entries(handle)
-= lookup[entry.fingerprint]
entry.geometry = null
entry.fingerprint = 0
entry.generation += 1
if !entry.generation
    entry.generation = 1
free-indices += index

────────────────────
_ do create-vector-raster-image ImageHandle
    - entry VectorRasterEntry
    - geometry VectorGeometry
    - palette [RGBA]
    - palette-offset U32
    - palette-count U32
    - scale F64

. raster = RasterCanvas(entry.pixel-width, entry.pixel-height)
raster.fill-color = white
raster.stroke-color = white
raster.stroke-width = entry.stroke-width
raster.stroke-cap = entry.stroke-cap
raster.stroke-join = entry.stroke-join
raster.stroke-dash = entry.stroke-dash
raster.push()
raster.translate
    - vector-raster-phase-offset(entry.phase-x)
    - vector-raster-phase-offset(entry.phase-y)
raster.transform(matrix-from-scale(Dimensions(entry.scale-x, entry.scale-y)))
raster.translate(-geometry.view-box.x, -geometry.view-box.y)
if entry.template-alpha
    . white-palette = List'RGBA
        ** 0 .. < palette-count
        *> white
    geometry.paint-offset(raster, white-palette, 0)
else
    geometry.paint-offset(raster, palette, palette-offset)
raster.pop()
= insert-image(ImageResource(raster, scale, entry.template-alpha))

────────────────────
_ do vector-raster-key
    - entry VectorRasterEntry

. result = fnv-mix(fnv-offset-basis, entry.geometry-handle.index)
result = fnv-mix(result, entry.geometry-handle.generation)
result = fnv-mix(result, entry.pixel-width as U64)
result = fnv-mix(result, entry.pixel-height as U64)
result = vector-geometry-mix-number(result, entry.scale-x)
result = vector-geometry-mix-number(result, entry.scale-y)
result = fnv-mix(result, entry.phase-x as U64)
result = fnv-mix(result, entry.phase-y as U64)
result = vector-geometry-mix-number(result, entry.stroke-width)
result = vector-geometry-mix-optional-cap(result, entry.stroke-cap)
result = vector-geometry-mix-optional-join(result, entry.stroke-join)
result = vector-geometry-mix-number(result, entry.stroke-dash)
result = fnv-mix(result, if entry.template-alpha then 1u64 else 2u64)
= fnv-mix(result, entry.palette-key)

────────────────────
_ do vector-geometry-palette-key U64
    - palette [RGBA]
    - offset U32
    - count U32

. result = fnv-mix(fnv-offset-basis, count)
for index in 0 .. < count
    . color = palette[offset + index]
    result = vector-geometry-mix-number(result, color.red)
    result = vector-geometry-mix-number(result, color.green)
    result = vector-geometry-mix-number(result, color.blue)
    result = vector-geometry-mix-number(result, color.alpha)
= result

────────────────────
_ do can-reclaim-raster-bytes
    - image-bytes Size

. needed = raster-byte-count + image-bytes
=? true if needed <= vector-raster-cache-budget
. reclaimable Size
for entry in raster-entries
    if entry.last-use + vector-raster-hot-draws <= raster-clock
        reclaimable += entry.image-bytes
= needed <= vector-raster-cache-budget + reclaimable

────────────────────
_ do enforce-raster-budget
    - protected VectorRasterEntry

while raster-byte-count > vector-raster-cache-budget
    . victim = least-recent-raster-entry(protected)
    =? if !victim
    evict-raster-entry(victim)

────────────────────
_ do least-recent-raster-entry
    - protected VectorRasterEntry

. oldest VectorRasterEntry?
for entry in raster-entries
    if entry as Pointer != protected as Pointer
        if !oldest || entry.last-use < oldest.last-use
            oldest = entry
= oldest

────────────────────
_ do evict-raster-entry
    - entry VectorRasterEntry

if is-image-valid(entry.image-handle)
    release-image(entry.image-handle)
if entry.image-bytes <= raster-byte-count
    raster-byte-count -= entry.image-bytes
entry.image-bytes = 0
-= raster-lookup[entry.key]
. slot = entry.slot
. last = raster-entries.length - 1
if slot != last
    . moved = raster-entries[last]
    raster-entries[slot] = moved
    moved.slot = slot
raster-entries.pop()

────────────────────
_ do evict-raster-entries
    - handle VectorGeometryHandle

. index Size
while index < raster-entries.length
    . entry = raster-entries[index]
    if entry.geometry-handle == handle
        evict-raster-entry(entry)
    else
        index += 1

━━━━━━━━━━━━━━━━━━━━
