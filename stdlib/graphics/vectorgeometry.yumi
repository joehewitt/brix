────────────────────
+ do release-image
    - handle ImageHandle

=? if handle.index >= image-entries.length
. entry = image-entries[handle.index]
=? if entry.generation != handle.generation || !entry.resource || !entry.references
entry.references -= 1
=? if entry.references
. resource = entry.resource!
resource.close()
entry.resource = null
entry.generation += 1
if !entry.generation
    entry.generation = 1
image-free-indices += handle.index

