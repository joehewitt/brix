+ vector-geometry-grace-capacity Size = 64
+ vector-raster-sighting-count Size = 1024
+ vector-raster-promotion-draws U32 = 4
+ vector-raster-phase-steps I32 = 256
+ vector-raster-hot-draws U64 = 8192
+ vector-raster-cache-budget Size = 8 * 1024 * 1024
+ vector-raster-max-entry-bytes Size = 1024 * 1024

_ vector-raster-epsilon = 1e-6
_ vector-geometry-keyed-seed U64 = 7640891576956012809u64
_ fallback-vector-geometry-table := VectorGeometryTable()
_ vector-geometry-renderer-tables := Map'Pointer'VectorGeometryTable()

