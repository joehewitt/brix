━━━━━━━━━━━━━━━━━━━━
+ vector-view-transform Matrix
    - view Rect
    - destination Rect

matrix-from-translation(destination.top-left).scale(size).translate(Point(-view.x, -view.y))

.. size = Dimensions(destination.width / view.width, destination.height / view.height)

━━━━━━━━━━━━━━━━━━━━
+ vector-matrix-is-axis-aligned
    - matrix Matrix

matrix.b == 0 && matrix.c == 0 && matrix.a > 0 && matrix.d > 0

━━━━━━━━━━━━━━━━━━━━
+ do vector-geometry-fingerprint U64
    - source VectorGeometrySource
    - view-box Rect

. fingerprint = fnv-offset-basis
fingerprint = vector-geometry-mix-rect(fingerprint, view-box)
= vector-geometry-mix-source(fingerprint, source)

━━━━━━━━━━━━━━━━━━━━
+ do build-vector-geometry VectorGeometry
    - source VectorGeometrySource
    - view-box Rect

. spans [VectorGeometrySpan]
. cursor = VectorGeometryRoleCursor()
. style = VectorGeometryStyle
    - VectorGeometryPaint(VectorGeometryPaintRole.inherit, 0)
    - VectorGeometryPaint(VectorGeometryPaintRole.inherit, 0)
    - null
    - null
    - null
    - FillRule.nonzero
    - Matrix()
. has-ink = false
. ink-bounds = Rect(0, 0, 0, 0)
. result = append-vector-geometry(source, style, cursor, spans, has-ink, ink-bounds)
. inherits-fill = false
. inherits-stroke = false
for span in spans
    if span.fill.role == VectorGeometryPaintRole.inherit
        inherits-fill = true
    if span.stroke.role == VectorGeometryPaintRole.inherit
        inherits-stroke = true
    if span.fill.role == VectorGeometryPaintRole.inherited-stroke
        inherits-stroke = true
= VectorGeometry(view-box, result.ink-bounds, spans, inherits-fill, inherits-stroke)

━━━━━━━━━━━━━━━━━━━━
+ do vector-geometry-supports-source Bool
    - source VectorGeometrySource

=? false if !source.vector-geometry-source-compact
if source.vector-geometry-source-kind == vector-geometry-source-graphic
    . node = gc-object-from-pointer'GraphicNode(source.vector-geometry-source-pointer)
    = node is VectorPath || node is PathGraphic || node is Circle || node is Ellipse || node is Rectangle || node is Line || node is Square || node is Polygon || node is Spiral || node is SineWave || node is Leaf
= all(0 .. < source.vector-geometry-source-child-count) • where vector-geometry-supports-source(source.vector-geometry-source-child(each))

━━━━━━━━━━━━━━━━━━━━
+ do vector-geometry-palette [RGBA]
    - source VectorGeometrySource

. palette [RGBA]
append-vector-geometry-palette(source, palette)
= palette

━━━━━━━━━━━━━━━━━━━━
_ VectorGeometryEntry

+ fingerprint U64
+ generation U32 = 1
+ references U32
+ geometry VectorGeometry?

────────────────────
_ This
    - fingerprint
    - geometry
    - references

━━━━━━━━━━━━━━━━━━━━
_ ImageResourceEntry

+ generation U32 = 1
+ references U32
+ resource ImageResource?

────────────────────
_ This
    - resource
    - references

━━━━━━━━━━━━━━━━━━━━
_ VectorRasterEntry

+ geometry-handle VectorGeometryHandle
+ pixel-width I32
+ pixel-height I32
+ scale-x F64
+ scale-y F64
+ phase-x I32
+ phase-y I32
+ stroke-width Length
+ stroke-cap LineCap
+ stroke-join LineJoin
+ stroke-dash Length
+ template-alpha Bool
+ palette-key U64
+ key U64
+ last-use U64
+ image-handle = ImageHandle(0, 0)
+ image-bytes Size
+ slot Size

────────────────────
_ This
    - geometry-handle
    - pixel-width
    - pixel-height
    - scale-x
    - scale-y
    - phase-x
    - phase-y
    - stroke-width
    - stroke-cap
    - stroke-join
    - stroke-dash
    - template-alpha
    - palette-key
    - key

────────────────────
+ matches
    - other VectorRasterEntry

|? geometry-handle != other.geometry-handle
    false
|? pixel-width != other.pixel-width || pixel-height != other.pixel-height
    false
|? scale-x != other.scale-x || scale-y != other.scale-y
    false
|? phase-x != other.phase-x || phase-y != other.phase-y
    false
|? stroke-width != other.stroke-width || stroke-cap != other.stroke-cap
    false
|? stroke-join != other.stroke-join || stroke-dash != other.stroke-dash
    false
??
    template-alpha == other.template-alpha && palette-key == other.palette-key

━━━━━━━━━━━━━━━━━━━━
_ VectorGeometryStyle

+ fill VectorGeometryPaint
+ stroke VectorGeometryPaint
+ stroke-width Length?
+ stroke-cap LineCap?
+ stroke-join LineJoin?
+ fill-rule FillRule
+ transform Matrix

────────────────────
_ This
    - fill
    - stroke
    - stroke-width
    - stroke-cap
    - stroke-join
    - fill-rule
    - transform

━━━━━━━━━━━━━━━━━━━━
_ VectorGeometryRoleCursor

+ next U32

━━━━━━━━━━━━━━━━━━━━
_ vector-raster-phase-offset
    - phase I32

(phase as F64) / (vector-raster-phase-steps as F64)

━━━━━━━━━━━━━━━━━━━━
_ vector-raster-pixel-extent
    - phase I32
    - extent F64

ceil(vector-raster-phase-offset(phase) + extent - vector-raster-epsilon) as I32

━━━━━━━━━━━━━━━━━━━━
_ do append-vector-geometry (has-ink Bool, ink-bounds Rect)
    - source VectorGeometrySource
    - inherited VectorGeometryStyle
    - cursor VectorGeometryRoleCursor
    - spans [VectorGeometrySpan]
    - has-ink Bool
    - ink-bounds Rect

. style = vector-geometry-source-style(source, inherited, cursor)
. path Path?
if source.vector-geometry-source-kind == vector-geometry-source-graphic
    path = vector-geometry-node-path(source.vector-geometry-source-pointer)
if path
    if !style.transform.is-identity
        path.transform(style.transform)
    path.trim()
    spans += VectorGeometrySpan
        - path
        - style.fill
        - style.stroke
        - style.stroke-width
        - style.stroke-cap
        - style.stroke-join
        - style.fill-rule

    . bounds = path.bounding-box
    if style.stroke.role != VectorGeometryPaintRole.none && style.stroke-width
        bounds = bounds.inflate(style.stroke-width, style.stroke-width)
    ink-bounds = if !has-ink then bounds else ink-bounds + bounds
    has-ink = true

for index in 0 .. < source.vector-geometry-source-child-count
    . child = source.vector-geometry-source-child(index)
    . result = append-vector-geometry(child, style, cursor, spans, has-ink, ink-bounds)
    has-ink = result.has-ink
    ink-bounds = result.ink-bounds
= (has-ink, ink-bounds)

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-source-style VectorGeometryStyle
    - source VectorGeometrySource
    - inherited VectorGeometryStyle
    - cursor VectorGeometryRoleCursor

. fill = vector-geometry-paint-role(source.vector-geometry-source-fill, inherited.fill, cursor)
. stroke = vector-geometry-paint-role
    - source.vector-geometry-source-stroke
    - inherited.stroke
    - cursor
if source.vector-geometry-source-fill == Fill.stroke
    fill = vector-geometry-stroke-fill(stroke)
. width = source.vector-geometry-source-stroke-width ?? inherited.stroke-width
. cap = source.vector-geometry-source-stroke-cap ?? inherited.stroke-cap
. join = source.vector-geometry-source-stroke-join ?? inherited.stroke-join
. rule = source.vector-geometry-source-fill-rule ?? inherited.fill-rule
. transform = inherited.transform
if source.vector-geometry-source-transform
    transform = transform.concatenate(source.vector-geometry-source-transform!)
= VectorGeometryStyle(fill, stroke, width, cap, join, rule, transform)

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-paint-role VectorGeometryPaint
    - paint Fill
    - inherited VectorGeometryPaint
    - cursor VectorGeometryRoleCursor

=? inherited if paint == Fill.inherit || paint == Fill.stroke
=? VectorGeometryPaint(VectorGeometryPaintRole.none, 0) if paint == Fill.none
. role = VectorGeometryPaint(VectorGeometryPaintRole.color, cursor.next)
cursor.next += 1
= role

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-paint-role VectorGeometryPaint
    - paint Stroke
    - inherited VectorGeometryPaint
    - cursor VectorGeometryRoleCursor

=? inherited if paint == Stroke.inherit
=? VectorGeometryPaint(VectorGeometryPaintRole.none, 0) if paint == Stroke.none
. role = VectorGeometryPaint(VectorGeometryPaintRole.color, cursor.next)
cursor.next += 1
= role

━━━━━━━━━━━━━━━━━━━━
_ vector-geometry-stroke-fill
    - stroke VectorGeometryPaint

|? stroke.role == VectorGeometryPaintRole.inherit
    VectorGeometryPaint(VectorGeometryPaintRole.inherited-stroke, 0)
??
    stroke

━━━━━━━━━━━━━━━━━━━━
_ vector-geometry-node-path Path?
    - node-pointer Pointer

|? node is VectorPath
    (node as VectorPath).vector-path-geometry()
|? node is PathGraphic
    Path((node as PathGraphic).path)
|? node is Circle
    circle(circle-node.center, abs(circle-node.radius))

    .. circle-node = node as Circle
|? node is Ellipse
    ellipse
        - ellipse-node.center
        - Dimensions(abs(ellipse-node.radius.width), abs(ellipse-node.radius.height))

    .. ellipse-node = node as Ellipse
|? node is Rectangle
    rectangle((node as Rectangle).rect)
|? node is Line
    line(line-node.start, line-node.end)

    .. line-node = node as Line
|? node is Square
    square
        - Point
            - square-node.center.x - square-node.radius
            - square-node.center.y - square-node.radius
        - square-node.radius * 2

    .. square-node = node as Square
|? node is Polygon
    polygon(polygon-node.sides, polygon-node.radius * 2, polygon-node.center)

    .. polygon-node = node as Polygon
|? node is Spiral
    spiral
        - spiral-node.center
        - spiral-node.radius
        - spiral-node.coils
        - spiral-node.chord
        - spiral-node.rotation

    .. spiral-node = node as Spiral
|? node is SineWave
    first-vector-geometry-node-path(node)
|? node is Leaf
    leaf(leaf-node.center, leaf-node.radius)

    .. leaf-node = node as Leaf
??
    first-vector-geometry-node-path(node)

.. node = gc-object-from-pointer'GraphicNode(node-pointer)

━━━━━━━━━━━━━━━━━━━━
_ do append-vector-geometry-palette
    - source VectorGeometrySource
    - palette [RGBA]

if source.vector-geometry-source-fill is RGBA
    palette += source.vector-geometry-source-fill as RGBA
if source.vector-geometry-source-stroke is RGBA
    palette += source.vector-geometry-source-stroke as RGBA
for index in 0 .. < source.vector-geometry-source-child-count
    . child = source.vector-geometry-source-child(index)
    append-vector-geometry-palette(child, palette)

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-mix-source U64
    - fingerprint U64
    - source VectorGeometrySource

. result = fnv-mix(fingerprint, 1)
result = vector-geometry-mix-paint(result, source.vector-geometry-source-fill)
result = vector-geometry-mix-paint(result, source.vector-geometry-source-stroke)
result = vector-geometry-mix-optional-number(result, source.vector-geometry-source-stroke-width)
result = vector-geometry-mix-optional-cap(result, source.vector-geometry-source-stroke-cap)
result = vector-geometry-mix-optional-join(result, source.vector-geometry-source-stroke-join)
result = vector-geometry-mix-optional-rule(result, source.vector-geometry-source-fill-rule)
result = vector-geometry-mix-optional-matrix(result, source.vector-geometry-source-transform)

if source.vector-geometry-source-kind == vector-geometry-source-container
    result = fnv-mix(result, 10)
else
    . node = gc-object-from-pointer'GraphicNode(source.vector-geometry-source-pointer)
    if node is VectorPath
        result = fnv-mix(result, 12)
        for op in (node as VectorPath).operations
            result = vector-geometry-mix-path-op(result, op)
    else if node is PathGraphic
        result = fnv-mix(result, 17)
        result = vector-geometry-mix-path(result, (node as PathGraphic).path)
    else if node is Circle
        . circle-node = node as Circle
        result = fnv-mix(result, 13)
        result = vector-geometry-mix-point(result, circle-node.center)
        result = vector-geometry-mix-number(result, circle-node.radius)
    else if node is Ellipse
        . ellipse-node = node as Ellipse
        result = fnv-mix(result, 14)
        result = vector-geometry-mix-point(result, ellipse-node.center)
        result = vector-geometry-mix-number(result, ellipse-node.radius.width)
        result = vector-geometry-mix-number(result, ellipse-node.radius.height)
    else if node is Rectangle
        result = fnv-mix(result, 15)
        result = vector-geometry-mix-rect(result, (node as Rectangle).rect)
    else if node is Line
        . line-node = node as Line
        result = fnv-mix(result, 16)
        result = vector-geometry-mix-point(result, line-node.start)
        result = vector-geometry-mix-point(result, line-node.end)
    else if node is Square
        . square-node = node as Square
        result = fnv-mix(result, 18)
        result = vector-geometry-mix-point(result, square-node.center)
        result = vector-geometry-mix-number(result, square-node.radius)
    else if node is Polygon
        . polygon-node = node as Polygon
        result = fnv-mix(result, 19)
        result = fnv-mix(result, polygon-node.sides)
        result = vector-geometry-mix-point(result, polygon-node.center)
        result = vector-geometry-mix-number(result, polygon-node.radius)
    else if node is Spiral
        . spiral-node = node as Spiral
        result = fnv-mix(result, 26)
        result = vector-geometry-mix-point(result, spiral-node.center)
        result = vector-geometry-mix-number(result, spiral-node.radius)
        result = vector-geometry-mix-number(result, spiral-node.coils)
        result = vector-geometry-mix-number(result, spiral-node.chord)
        result = vector-geometry-mix-number(result, spiral-node.rotation)
    else if node is SineWave || node is Leaf
        result = fnv-mix(result, 27)
        . path = vector-geometry-node-path(node as Pointer)
        if path
            result = vector-geometry-mix-path(result, path)
    else
        result = fnv-mix(result, node.revision as U64)

for index in 0 .. < source.vector-geometry-source-child-count
    . child = source.vector-geometry-source-child(index)
    result = vector-geometry-mix-source(result, child)
= fnv-mix(result, 2)

━━━━━━━━━━━━━━━━━━━━
_ do first-vector-geometry-node-path Path?
    - node GraphicNode

for path in node.draw()
    = Path(path)
= null

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-mix-path U64
    - fingerprint U64
    - path Path

. result = fnv-mix(fingerprint, path.count as U64)
. commands = path.commands
for index in 0 .. < commands.command-count
    result = fnv-mix(result, commands.verbs[index])
for index in 0 .. < commands.coord-count
    result = vector-geometry-mix-number(result, commands.coords[index])
= result

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-mix-path-op U64
    - fingerprint U64
    - op PathOp

. result = fingerprint
if op is PathMoveTo
    . move = op as PathMoveTo
    result = fnv-mix(result, 20)
    result = vector-geometry-mix-number(result, move.x)
    result = vector-geometry-mix-number(result, move.y)
else if op is PathLineTo
    . line-op = op as PathLineTo
    result = fnv-mix(result, 21)
    result = vector-geometry-mix-number(result, line-op.x)
    result = vector-geometry-mix-number(result, line-op.y)
else if op is PathCubicTo
    . cubic = op as PathCubicTo
    result = fnv-mix(result, 22)
    result = vector-geometry-mix-number(result, cubic.c1x)
    result = vector-geometry-mix-number(result, cubic.c1y)
    result = vector-geometry-mix-number(result, cubic.c2x)
    result = vector-geometry-mix-number(result, cubic.c2y)
    result = vector-geometry-mix-number(result, cubic.x)
    result = vector-geometry-mix-number(result, cubic.y)
else if op is PathQuadraticTo
    . quadratic = op as PathQuadraticTo
    result = fnv-mix(result, 23)
    result = vector-geometry-mix-number(result, quadratic.cx)
    result = vector-geometry-mix-number(result, quadratic.cy)
    result = vector-geometry-mix-number(result, quadratic.x)
    result = vector-geometry-mix-number(result, quadratic.y)
else if op is PathArcTo
    . arc = op as PathArcTo
    result = fnv-mix(result, 24)
    result = vector-geometry-mix-number(result, arc.rx)
    result = vector-geometry-mix-number(result, arc.ry)
    result = vector-geometry-mix-number(result, arc.rotation as Radians)
    result = fnv-mix(result, if arc.large then 1 else 0)
    result = fnv-mix(result, if arc.sweep then 1 else 0)
    result = vector-geometry-mix-number(result, arc.x)
    result = vector-geometry-mix-number(result, arc.y)
else
    result = fnv-mix(result, 25)
= result

━━━━━━━━━━━━━━━━━━━━
_ vector-geometry-mix-paint U64
    - fingerprint U64
    - paint Fill

match paint
    |= Fill.inherit
        fnv-mix(fingerprint, 30)
    |= Fill.none
        fnv-mix(fingerprint, 31)
    |= Fill.stroke
        fnv-mix(fingerprint, 33)
    ??
        fnv-mix(fingerprint, 32)

━━━━━━━━━━━━━━━━━━━━
_ vector-geometry-mix-paint U64
    - fingerprint U64
    - paint Stroke

match paint
    |= Stroke.inherit
        fnv-mix(fingerprint, 30)
    |= Stroke.none
        fnv-mix(fingerprint, 31)
    ??
        fnv-mix(fingerprint, 32)

━━━━━━━━━━━━━━━━━━━━
_ vector-geometry-mix-optional-number U64
    - fingerprint U64
    - value Float?

|? !value
    fnv-mix(fingerprint, 0)
??
    vector-geometry-mix-number(fnv-mix(fingerprint, 1), value)

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-mix-optional-cap U64
    - fingerprint U64
    - value LineCap?

=? fnv-mix(fingerprint, 0) if !value
. tag U64 = 1
if value == LineCap.round
    tag = 2
else if value == LineCap.square
    tag = 3
= fnv-mix(fingerprint, tag)

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-mix-optional-join U64
    - fingerprint U64
    - value LineJoin?

=? fnv-mix(fingerprint, 0) if !value
. tag U64 = 1
if value == LineJoin.round
    tag = 2
else if value == LineJoin.bevel
    tag = 3
= fnv-mix(fingerprint, tag)

━━━━━━━━━━━━━━━━━━━━
_ vector-geometry-mix-optional-rule U64
    - fingerprint U64
    - value FillRule?

|? !value
    fnv-mix(fingerprint, 0)
??
    fnv-mix(fingerprint, if value == FillRule.even-odd then 2 else 1)

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-mix-optional-matrix U64
    - fingerprint U64
    - value Matrix?

=? fnv-mix(fingerprint, 0) if !value
. result = fnv-mix(fingerprint, 1)
result = vector-geometry-mix-number(result, value.a)
result = vector-geometry-mix-number(result, value.c)
result = vector-geometry-mix-number(result, value.b)
result = vector-geometry-mix-number(result, value.d)
result = vector-geometry-mix-number(result, value.tx)
= vector-geometry-mix-number(result, value.ty)

━━━━━━━━━━━━━━━━━━━━
_ vector-geometry-mix-point U64
    - fingerprint U64
    - point Point

vector-geometry-mix-number(vector-geometry-mix-number(fingerprint, point.x), point.y)

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-mix-rect U64
    - fingerprint U64
    - rect Rect

. result = vector-geometry-mix-number(fingerprint, rect.x)
result = vector-geometry-mix-number(result, rect.y)
result = vector-geometry-mix-number(result, rect.width)
= vector-geometry-mix-number(result, rect.height)

━━━━━━━━━━━━━━━━━━━━
_ do vector-geometry-mix-number U64
    - fingerprint U64
    - value Float

. magnitude = (abs(value) * 1000000000) as U64
if value < 0
    magnitude = magnitude /xor/ U64.max
= fnv-mix(fingerprint, magnitude)

