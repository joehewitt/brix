────────────────────
+ do intern VectorGeometryAcquisition
    - source VectorGeometrySource
    - view-box Rect

source.prepare-vector-geometry-source()
. fingerprint = vector-geometry-fingerprint(source, view-box)
. palette = vector-geometry-palette(source)
. existing = retain-fingerprint(fingerprint)
=? VectorGeometryAcquisition(existing, palette) if existing
= VectorGeometryAcquisition(store(fingerprint, build-vector-geometry(source, view-box)), palette)

