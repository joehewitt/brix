(import ./appearance)
(import ./canvas)
(import ./color)
(import ./graphic)
(import ./matrix)
(import ./path)
(import ./point)
(import ./primitives)
(import ./shapes)
(import ./style)
(import ./vector)
(import ./vector-source)
(import /core/intrinsics)
(import /core/map)
(import /core/markup)
(import /math)
(import /stream/aggregate)
(blank)
(prop + vector-geometry-grace-capacity Size (= 64))
(prop + vector-raster-sighting-count Size (= 1024))
(prop + vector-raster-promotion-draws U32 (= 4))
(prop + vector-raster-phase-steps I32 (= 256))
(prop + vector-raster-hot-draws U64 (= 8192))
(prop + vector-raster-cache-budget Size (= (* 8 1024 1024)))
(prop + vector-raster-max-entry-bytes Size (= (* 1024 1024)))
(blank)
(prop _ vector-raster-epsilon _ (= 1e-6))
(prop _ vector-geometry-keyed-seed U64 (= 7640891576956012809u64))
(prop _ fallback-vector-geometry-table _ (:= (call VectorGeometryTable)))
(prop _ vector-geometry-renderer-tables _ (:= (call (of Map Pointer VectorGeometryTable))))
(blank)
(type-line + VectorGeometryHandle (is (tuple (: index U32) (: generation U32))))
(type-line + ImageHandle (is (tuple (: index U32) (: generation U32))))
(type-line + VectorGeometryAcquisition (is (tuple (: handle VectorGeometryHandle) (: palette (list RGBA)))))
(type-line + VectorGeometryPaint (is (tuple (: role VectorGeometryPaintRole) (: index U32))))

(type + VectorGeometry
  (prop + view-box Rect)
  (prop + ink-bounds Rect)
  (prop + spans (list VectorGeometrySpan))
  (blank)
  (prop _ inherits-fill Bool)
  (prop _ inherits-stroke Bool)
  (fn-do + This _
    (param view-box _)
    (param ink-bounds _)
    (param spans _)
    (param inherits-fill _)
    (param inherits-stroke _)
  )
  (fn-expr + supports-raster-cache Bool :get
    (and (not inherits-fill) (not inherits-stroke))
  )
  (fn-do + paint _
    (param canvas Canvas)
    (param palette (list RGBA))
    (call paint-offset canvas palette 0)
  )
  (fn-do + paint-offset _
    (param canvas Canvas)
    (param palette (list RGBA))
    (param offset U32)
    (let inherited-fill (? RGBA))
    (if inherits-fill
      (= inherited-fill (. canvas fill-color))
    )
    (let inherited-stroke (? RGBA))
    (if inherits-stroke
      (= inherited-stroke (. canvas stroke-color))
    )
    (let inherited-stroke-width (. canvas stroke-width))
    (let inherited-stroke-cap (. canvas stroke-cap))
    (let inherited-stroke-join (. canvas stroke-join))
    (blank)
    (for (in span spans)
      (if (== (. span fill role) (. VectorGeometryPaintRole none))
        (= (. canvas fill-color) null)
        (else-if (== (. span fill role) (. VectorGeometryPaintRole inherit))
          (= (. canvas fill-color) inherited-fill)
        )
        (else-if (== (. span fill role) (. VectorGeometryPaintRole inherited-stroke))
          (= (. canvas fill-color) inherited-stroke)
        )
        (else
          (= (. canvas fill-color) ([] palette (+ offset (. span fill index))))
        )
      )
      (let stroke-color
        (match (. span stroke role)
          (case= (. VectorGeometryPaintRole inherit)
            inherited-stroke
          )
          (case= (. VectorGeometryPaintRole none)
            null
          )
          (default
            ([] palette (+ offset (. span stroke index)))
          )
        )
      )
      (let stroke-width (?? (. span stroke-width) inherited-stroke-width))
      (= (. canvas stroke-width) stroke-width)
      (= (. canvas stroke-cap) (?? (. span stroke-cap) inherited-stroke-cap))
      (= (. canvas stroke-join) (?? (. span stroke-join) inherited-stroke-join))
      (if (or (== (. span stroke-alignment) (. StrokeAlignment center)) (not stroke-color))
        (= (. canvas stroke-color) stroke-color)
        (call (. span path outline) canvas (. span fill-rule))
        (else
          (= (. canvas stroke-color) null)
          (if (. canvas fill-color)
            (call (. span path outline) canvas (. span fill-rule))
          )
          (= (. canvas stroke-color) stroke-color)
          (call paint-aligned-stroke canvas (. span path) (. span fill-rule) (. span stroke-alignment) stroke-width)
        )
      )
    )
  )
  (fn-do + template-tint (tuple (: compatible Bool) (: tint RGBA))
    (param palette (list RGBA))
    (param offset U32)
    (param inherited-fill (? RGBA))
    (param inherited-stroke (? RGBA))
    (let found false)
    (let has-inherited false)
    (let tint transparent)
    (for (in span spans)
      (let fill (? RGBA))
      (if (== (. span fill role) (. VectorGeometryPaintRole inherit))
        (= fill inherited-fill)
        (= has-inherited true)
        (else-if (== (. span fill role) (. VectorGeometryPaintRole inherited-stroke))
          (= fill inherited-stroke)
          (= has-inherited true)
        )
        (else-if (== (. span fill role) (. VectorGeometryPaintRole color))
          (= fill ([] palette (+ offset (. span fill index))))
        )
      )
      (if fill
        (if (and found (!= tint fill))
          (return (tuple false transparent))
        )
        (= tint fill)
        (= found true)
      )
      (blank)
      (let stroke (? RGBA))
      (if (== (. span stroke role) (. VectorGeometryPaintRole inherit))
        (= stroke inherited-stroke)
        (= has-inherited true)
        (else-if (== (. span stroke role) (. VectorGeometryPaintRole color))
          (= stroke ([] palette (+ offset (. span stroke index))))
        )
      )
      (if stroke
        (if (and found (!= tint stroke))
          (return (tuple false transparent))
        )
        (= tint stroke)
        (= found true)
      )
    )
    (return (tuple (and found has-inherited) tint))
  )
)

(type + VectorGeometryBuilder (is (fn-type VectorGeometry)))

(type + ImageResource
  (prop + pixel-width I32)
  (prop + pixel-height I32)
  (prop + intended-scale F64)
  (prop + template-alpha Bool)
  (blank)
  (prop _ canvas RasterCanvas)
  (fn-do + This _
    (param canvas _)
    (param intended-scale _)
    (param template-alpha Bool (= false))
    (= pixel-width (. canvas pixel-width))
    (= pixel-height (. canvas pixel-height))
  )
  (fn-expr + byte-count Size :get
    (* (as pixel-width Size) (as pixel-height Size) 4)
  )
  (fn-expr + native _ :get
    (. canvas native)
  )
  (fn-do + draw _
    (param destination Canvas)
    (param rect Rect)
    (param tint (? RGBA))
    (if template-alpha
      (= (. destination fill-color) tint)
    )
    (call (. destination draw-image) canvas rect template-alpha)
  )
  (fn-do _ close _
    (call (. canvas close))
  )
)

(type + VectorGeometryPaintRole (is Union)
  (variant inherit)
  (variant inherited-stroke)
  (variant none)
  (variant color)
)

(type + VectorGeometrySpan
  (prop + path Path)
  (prop + fill VectorGeometryPaint)
  (prop + stroke VectorGeometryPaint)
  (prop + stroke-width (? Length))
  (prop + stroke-cap (? LineCap))
  (prop + stroke-join (? LineJoin))
  (prop + fill-rule FillRule)
  (prop + stroke-alignment StrokeAlignment)
  (fn-do + This _
    (param path _)
    (param fill _)
    (param stroke _)
    (param stroke-width _)
    (param stroke-cap _)
    (param stroke-join _)
    (param fill-rule _)
    (param stroke-alignment _ (= (. StrokeAlignment center)))
  )
)

(type + VectorGeometryTable
  (prop _ entries (list VectorGeometryEntry))
  (prop _ lookup (of Map U64 U32))
  (prop _ grace (list U32))
  (prop _ free-indices (list U32))
  (prop _ image-entries (list ImageResourceEntry))
  (prop _ image-free-indices (list U32))
  (prop _ raster-entries (list VectorRasterEntry))
  (prop _ raster-lookup (of Map U64 VectorRasterEntry))
  (prop _ raster-sighting-keys _ (= ([] U64 vector-raster-sighting-count)))
  (prop _ raster-sighting-draws _ (= ([] U32 vector-raster-sighting-count)))
  (prop _ raster-clock U64)
  (prop _ raster-byte-count Size)
  (fn-do + image-live-count Size :get
    (let count Size)
    (for (in entry image-entries)
      (if (. entry resource)
        (+= count 1)
      )
    )
    (return count)
  )
  (fn-do + atlas-entry-count Size :get
    (let count Size)
    (for (in entry raster-entries)
      (if (call is-image-valid (. entry image-handle))
        (+= count 1)
      )
    )
    (return count)
  )
  (fn-expr + atlas-bytes Size :get
    raster-byte-count
  )
  (fn-do + live-count Size :get
    (let count Size)
    (for (in entry entries)
      (if (. entry geometry)
        (+= count 1)
      )
    )
    (return count)
  )
  (fn-do + intern VectorGeometryAcquisition
    (param source VectorGeometrySource)
    (param view-box Rect)
    (call (. source prepare-vector-geometry-source))
    (let fingerprint (call vector-geometry-fingerprint source view-box))
    (let palette (call vector-geometry-palette source))
    (let existing (call retain-fingerprint fingerprint))
    (return-if (call VectorGeometryAcquisition existing palette) (if existing))
    (return (call VectorGeometryAcquisition (call store fingerprint (call build-vector-geometry source view-box)) palette))
  )
  (fn-do + intern-geometry VectorGeometryHandle
    (param key U64)
    (param build VectorGeometryBuilder)
    (let fingerprint (call fnv-mix vector-geometry-keyed-seed key))
    (let existing (call retain-fingerprint fingerprint))
    (return-if existing (if existing))
    (return (call store fingerprint (call build)))
  )
  (fn-do + insert-image ImageHandle
    (param resource ImageResource)
    (let index U32)
    (let entry ImageResourceEntry)
    (if image-free-indices
      (= index ([] image-free-indices (- (. image-free-indices length) 1)))
      (call (. image-free-indices remove) (- (. image-free-indices length) 1))
      (= entry ([] image-entries index))
      (= (. entry resource) resource)
      (= (. entry references) 1)
      (else
        (= index (as (. image-entries length) U32))
        (= entry (call ImageResourceEntry resource 1))
        (+= image-entries entry)
      )
    )
    (return (call ImageHandle index (. entry generation)))
  )
  (fn-do + resolve-image (? ImageResource)
    (param handle ImageHandle)
    (return-if (if (>= (. handle index) (. image-entries length))))
    (let entry ([] image-entries (. handle index)))
    (return-if (if (!= (. entry generation) (. handle generation))))
    (return (. entry resource))
  )
  (fn-do + paint-image-resource Bool
    (param handle ImageHandle)
    (param canvas Canvas)
    (param destination Rect)
    (param tint (? RGBA) (= null))
    (let resource (call resolve-image handle))
    (return-if false (if (not resource)))
    (return-if true (if (call (. canvas record-image-resource) (. handle index) (. handle generation) destination tint)))
    (call (. resource draw) (:destination canvas)
      (block
        (arg destination)
        (arg tint)
      )
    )
    (return true)
  )
  (fn-do + retain-image Bool
    (param handle ImageHandle)
    (return-if false (if (>= (. handle index) (. image-entries length))))
    (let entry ([] image-entries (as (. handle index) Index)))
    (return-if false (if (or (!= (. entry generation) (. handle generation)) (not (. entry resource)))))
    (+= (. entry references) 1)
    (return true)
  )
  (fn-do + release-image _
    (param handle ImageHandle)
    (return-if (if (>= (. handle index) (. image-entries length))))
    (let entry ([] image-entries (. handle index)))
    (return-if (if (or (!= (. entry generation) (. handle generation)) (not (. entry resource)) (not (. entry references)))))
    (-= (. entry references) 1)
    (return-if (if (. entry references)))
    (let resource (!! (. entry resource)))
    (call (. resource close))
    (= (. entry resource) null)
    (+= (. entry generation) 1)
    (if (not (. entry generation))
      (= (. entry generation) 1)
    )
    (+= image-free-indices (. handle index))
  )
  (fn-expr + is-image-valid Bool
    (param handle ImageHandle)
    (case? (>= (. handle index) (. image-entries length))
      false
    )
    (default
      (and (== (. entry generation) (. handle generation)) (!= (. entry resource) null))
    )
    (where
      (lazy entry ([] image-entries (. handle index)))
    )
  )
  (fn-expr + image-reference-count U32
    (param handle ImageHandle)
    (case? (>= (. handle index) (. image-entries length))
      0
    )
    (case? (or (!= (. entry generation) (. handle generation)) (not (. entry resource)))
      0
    )
    (default
      (. entry references)
    )
    (where
      (lazy entry ([] image-entries (as (. handle index) Index)))
    )
  )
  (fn-do + paint-vector _
    (param handle VectorGeometryHandle)
    (param canvas Canvas)
    (param palette (list RGBA))
    (param transform Matrix)
    (param clip (? Rect) (= null))
    (return-if true (if (call (. canvas record-vector-geometry) (. handle index) (. handle generation) palette transform clip)))
    (let geometry (call resolve handle))
    (return-if false (if (not geometry)))
    (do-use (. canvas saved-state)
      (if clip
        (call (. canvas clip) clip)
      )
      (call (. canvas transform) transform)
      (call (. geometry paint) canvas palette)
    )
    (return true)
  )
  (fn-do + paint-vector-raster Bool
    (param handle VectorGeometryHandle)
    (param canvas Canvas)
    (param palette (list RGBA))
    (param transform Matrix)
    (param clip (? Rect) (= null))
    (return-if true (if (call (. canvas record-vector-geometry) (. handle index) (. handle generation) palette transform clip)))
    (return (call paint-vector-cached handle canvas palette 0 (as (. palette length) U32) transform))
  )
  (fn-do + paint-vector-cached _
    (param handle VectorGeometryHandle)
    (param canvas Canvas)
    (param palette (list RGBA))
    (param palette-offset U32)
    (param palette-count U32)
    (param transform Matrix)
    (let current (. canvas current-matrix))
    (return-if false (if (or (not (call vector-matrix-is-axis-aligned current)) (not (call vector-matrix-is-axis-aligned transform)))))
    (let geometry (call resolve handle))
    (return-if false (if (not geometry)))
    (probe-group + graphics.vector.raster-cache)
    (let painted
      (call paint-cached-vector-raster
        (block
          (arg handle)
          (arg geometry)
          (arg canvas)
          (arg palette)
          (arg palette-offset)
          (arg palette-count)
          (arg current)
          (arg (call (. current concatenate) transform))
        )
      )
    )
    (probe-group - graphics.vector.raster-cache)
    (return painted)
  )
  (fn-do + resolve (? VectorGeometry)
    (param handle VectorGeometryHandle)
    (return-if (if (>= (. handle index) (. entries length))))
    (let entry ([] entries (. handle index)))
    (return-if (if (!= (. entry generation) (. handle generation))))
    (return (. entry geometry))
  )
  (fn-expr + require VectorGeometry
    (param handle VectorGeometryHandle)
    (before
      (throw (call Panic "Stale VectorGeometry handle") (if (>= (. handle index) (. entries length))))
      (blank)
      (throw (call Panic "Stale VectorGeometry handle") (if (or (!= (. entry generation) (. handle generation)) (not (. entry geometry)))))
    )
    (. entry geometry)
    (where
      (lazy entry ([] entries (. handle index)))
    )
  )
  (fn-do + retain Bool
    (param handle VectorGeometryHandle)
    (return-if false (if (>= (. handle index) (. entries length))))
    (let entry ([] entries (as (. handle index) Index)))
    (return-if false (if (or (!= (. entry generation) (. handle generation)) (not (. entry geometry)))))
    (+= (. entry references) 1)
    (call remove-from-grace (. handle index))
    (return true)
  )
  (fn-do + release _
    (param handle VectorGeometryHandle)
    (return-if (if (>= (. handle index) (. entries length))))
    (let entry ([] entries (. handle index)))
    (return-if (if (or (!= (. entry generation) (. handle generation)) (not (. entry geometry)) (not (. entry references)))))
    (-= (. entry references) 1)
    (return-if (if (. entry references)))
    (blank)
    (+= grace (. handle index))
    (while (> (. grace length) vector-geometry-grace-capacity)
      (call evict ([] grace 0))
    )
  )
  (fn-do + evict-unused _
    (while grace
      (call evict ([] grace 0))
    )
  )
  (fn-expr + is-valid Bool
    (param handle VectorGeometryHandle)
    (case? (>= (. handle index) (. entries length))
      false
    )
    (default
      (and (== (. entry generation) (. handle generation)) (!= (. entry geometry) null))
    )
    (where
      (lazy entry ([] entries (as (. handle index) Index)))
    )
  )
  (fn-expr + reference-count U32
    (param handle VectorGeometryHandle)
    (case? (>= (. handle index) (. entries length))
      0
    )
    (case? (or (!= (. entry generation) (. handle generation)) (not (. entry geometry)))
      0
    )
    (default
      (. entry references)
    )
    (where
      (lazy entry ([] entries (as (. handle index) Index)))
    )
  )
  (fn-do _ retain-fingerprint (? VectorGeometryHandle)
    (param fingerprint U64)
    (let existing-index ([] lookup fingerprint))
    (return-if (if (not existing-index)))
    (let entry ([] entries existing-index))
    (return-if (if (not (. entry geometry))))
    (+= (. entry references) 1)
    (call remove-from-grace existing-index)
    (return (call VectorGeometryHandle existing-index (. entry generation)))
  )
  (fn-do _ store VectorGeometryHandle
    (param fingerprint U64)
    (param geometry VectorGeometry)
    (let index U32)
    (let entry VectorGeometryEntry)
    (if free-indices
      (= index ([] free-indices (- (. free-indices length) 1)))
      (call (. free-indices remove) (- (. free-indices length) 1))
      (= entry ([] entries index))
      (= (. entry fingerprint) fingerprint)
      (= (. entry geometry) geometry)
      (= (. entry references) 1)
      (else
        (= index (as (. entries length) U32))
        (= entry (call VectorGeometryEntry fingerprint geometry 1))
        (+= entries entry)
      )
    )
    (blank)
    (= ([] lookup fingerprint) index)
    (return (call VectorGeometryHandle index (. entry generation)))
  )
  (fn-do _ paint-cached-vector-raster _
    (param handle VectorGeometryHandle)
    (param geometry VectorGeometry)
    (param canvas Canvas)
    (param palette (list RGBA))
    (param palette-offset U32)
    (param palette-count U32)
    (param current Matrix)
    (param device Matrix)
    (let scale (. canvas scale))
    (let view (. geometry view-box))
    (let scale-x (* (. device a) scale))
    (let scale-y (* (. device d) scale))
    (let left (* (+ (* (. view x) (. device a)) (. device tx)) scale))
    (let top (* (+ (* (. view y) (. device d)) (. device ty)) scale))
    (let origin-x (call floor left))
    (let origin-y (call floor top))
    (let phase-x (as (call round (* (- left origin-x) (as vector-raster-phase-steps F64))) I32))
    (let phase-y (as (call round (* (- top origin-y) (as vector-raster-phase-steps F64))) I32))
    (if (== phase-x vector-raster-phase-steps)
      (+= origin-x 1)
      (= phase-x 0)
    )
    (if (== phase-y vector-raster-phase-steps)
      (+= origin-y 1)
      (= phase-y 0)
    )
    (let pixel-width (call vector-raster-pixel-extent phase-x (* (. view width) scale-x)))
    (let pixel-height (call vector-raster-pixel-extent phase-y (* (. view height) scale-y)))
    (return-if false (if (or (<= pixel-width 0) (<= pixel-height 0))))
    (let image-bytes (* (as pixel-width Size) (as pixel-height Size) 4))
    (return-if false (if (> image-bytes vector-raster-max-entry-bytes)))
    (blank)
    (let template (call (. geometry template-tint) palette palette-offset (. canvas fill-color) (. canvas stroke-color)))
    (let template-alpha (. template compatible))
    (return-if false (if (and (not template-alpha) (not (. geometry supports-raster-cache)))))
    (let palette-key U64)
    (if (not template-alpha)
      (= palette-key (call vector-geometry-palette-key palette palette-offset palette-count))
    )
    (let request
      (call VectorRasterEntry
        (block
          (arg handle)
          (arg pixel-width)
          (arg pixel-height)
          (arg scale-x)
          (arg scale-y)
          (arg phase-x)
          (arg phase-y)
          (arg (. canvas stroke-width))
          (arg (. canvas stroke-cap))
          (arg (. canvas stroke-join))
          (arg (. canvas stroke-dash))
          (arg template-alpha)
          (arg palette-key)
          (arg 0)
        )
      )
    )
    (= (. request key) (call vector-raster-key request))
    (let tint (only-if (. template tint) (if template-alpha)))
    (+= raster-clock 1)
    (blank)
    (let found ([] raster-lookup (. request key)))
    (if found
      (let entry found)
      (if (call (. entry matches) request)
        (let image (call resolve-image (. entry image-handle)))
        (if image
          (= (. entry last-use) raster-clock)
          (call draw-vector-raster image canvas current origin-x origin-y entry scale tint)
          (return true)
        )
        (call evict-raster-entry entry)
      )
      (return false)
    )
    (blank)
    (let slot (as (% (. request key) (as vector-raster-sighting-count U64)) Index))
    (if (!= ([] raster-sighting-keys slot) (. request key))
      (= ([] raster-sighting-keys slot) (. request key))
      (= ([] raster-sighting-draws slot) 1)
      (return false)
    )
    (+= ([] raster-sighting-draws slot) 1)
    (return-if false (if (< ([] raster-sighting-draws slot) vector-raster-promotion-draws)))
    (= ([] raster-sighting-draws slot) 0)
    (return-if false (if (not (call can-reclaim-raster-bytes image-bytes))))
    (= ([] raster-sighting-keys slot) 0)
    (blank)
    (= (. request last-use) raster-clock)
    (= (. request image-handle)
      (call create-vector-raster-image
        (block
          (arg request)
          (arg geometry)
          (arg palette)
          (arg palette-offset)
          (arg palette-count)
          (arg scale)
        )
      )
    )
    (= (. request image-bytes) image-bytes)
    (= (. request slot) (. raster-entries length))
    (+= raster-entries request)
    (= ([] raster-lookup (. request key)) request)
    (+= raster-byte-count image-bytes)
    (call enforce-raster-budget request)
    (let promoted (call resolve-image (. request image-handle)))
    (return-if false (if (not promoted)))
    (call draw-vector-raster promoted canvas current origin-x origin-y request scale tint)
    (return true)
  )
  (fn-do _ draw-vector-raster _
    (param image ImageResource)
    (param canvas Canvas)
    (param current Matrix)
    (param origin-x F64)
    (param origin-y F64)
    (param entry VectorRasterEntry)
    (param scale F64)
    (param tint (? RGBA))
    (let rect
      (call Rect
        (block
          (arg (/ (- (/ origin-x scale) (. current tx)) (. current a)))
          (arg (/ (- (/ origin-y scale) (. current ty)) (. current d)))
          (arg (/ (/ (as (. entry pixel-width) F64) scale) (. current a)))
          (arg (/ (/ (as (. entry pixel-height) F64) scale) (. current d)))
        )
      )
    )
    (call (. image draw) (:destination canvas)
      (block
        (arg rect)
        (arg tint)
      )
    )
  )
  (fn-do _ remove-from-grace _
    (param index U32)
    (for (in position (..< 0 (. grace length)))
      (if (== ([] grace position) index)
        (call (. grace remove) position)
        (break)
      )
    )
  )
  (fn-do _ evict _
    (param index U32)
    (call remove-from-grace index)
    (return-if (if (>= index (. entries length))))
    (let entry ([] entries index))
    (return-if (if (or (. entry references) (not (. entry geometry)))))
    (let handle (call VectorGeometryHandle index (. entry generation)))
    (call evict-raster-entries handle)
    (-= ([] lookup (. entry fingerprint)))
    (= (. entry geometry) null)
    (= (. entry fingerprint) 0)
    (+= (. entry generation) 1)
    (if (not (. entry generation))
      (= (. entry generation) 1)
    )
    (+= free-indices index)
  )
  (fn-do _ create-vector-raster-image ImageHandle
    (param entry VectorRasterEntry)
    (param geometry VectorGeometry)
    (param palette (list RGBA))
    (param palette-offset U32)
    (param palette-count U32)
    (param scale F64)
    (let raster (call RasterCanvas (. entry pixel-width) (. entry pixel-height)))
    (= (. raster fill-color) white)
    (= (. raster stroke-color) white)
    (= (. raster stroke-width) (. entry stroke-width))
    (= (. raster stroke-cap) (. entry stroke-cap))
    (= (. raster stroke-join) (. entry stroke-join))
    (= (. raster stroke-dash) (. entry stroke-dash))
    (call (. raster push))
    (call (. raster translate)
      (block
        (arg (call vector-raster-phase-offset (. entry phase-x)))
        (arg (call vector-raster-phase-offset (. entry phase-y)))
      )
    )
    (call (. raster transform) (call matrix-from-scale (call Dimensions (. entry scale-x) (. entry scale-y))))
    (call (. raster translate) (- (. geometry view-box x)) (- (. geometry view-box y)))
    (if (. entry template-alpha)
      (let white-palette
        (call (of List RGBA)
          (block
            (spread (..< 0 palette-count))
            (pipe *> white)
          )
        )
      )
      (call (. geometry paint-offset) raster white-palette 0)
      (else
        (call (. geometry paint-offset) raster palette palette-offset)
      )
    )
    (call (. raster pop))
    (return (call insert-image (call ImageResource raster scale (. entry template-alpha))))
  )
  (fn-do _ vector-raster-key _
    (param entry VectorRasterEntry)
    (let result (call fnv-mix fnv-offset-basis (. entry geometry-handle index)))
    (= result (call fnv-mix result (. entry geometry-handle generation)))
    (= result (call fnv-mix result (as (. entry pixel-width) U64)))
    (= result (call fnv-mix result (as (. entry pixel-height) U64)))
    (= result (call vector-geometry-mix-number result (. entry scale-x)))
    (= result (call vector-geometry-mix-number result (. entry scale-y)))
    (= result (call fnv-mix result (as (. entry phase-x) U64)))
    (= result (call fnv-mix result (as (. entry phase-y) U64)))
    (= result (call vector-geometry-mix-number result (. entry stroke-width)))
    (= result (call vector-geometry-mix-optional-cap result (. entry stroke-cap)))
    (= result (call vector-geometry-mix-optional-join result (. entry stroke-join)))
    (= result (call vector-geometry-mix-number result (. entry stroke-dash)))
    (= result (call fnv-mix result (if-expr (. entry template-alpha) 1u64 2u64)))
    (return (call fnv-mix result (. entry palette-key)))
  )
  (fn-do _ vector-geometry-palette-key U64
    (param palette (list RGBA))
    (param offset U32)
    (param count U32)
    (let result (call fnv-mix fnv-offset-basis count))
    (for (in index (..< 0 count))
      (let color ([] palette (+ offset index)))
      (= result (call vector-geometry-mix-number result (. color red)))
      (= result (call vector-geometry-mix-number result (. color green)))
      (= result (call vector-geometry-mix-number result (. color blue)))
      (= result (call vector-geometry-mix-number result (. color alpha)))
    )
    (return result)
  )
  (fn-do _ can-reclaim-raster-bytes _
    (param image-bytes Size)
    (let needed (+ raster-byte-count image-bytes))
    (return-if true (if (<= needed vector-raster-cache-budget)))
    (let reclaimable Size)
    (for (in entry raster-entries)
      (if (<= (+ (. entry last-use) vector-raster-hot-draws) raster-clock)
        (+= reclaimable (. entry image-bytes))
      )
    )
    (return (<= needed (+ vector-raster-cache-budget reclaimable)))
  )
  (fn-do _ enforce-raster-budget _
    (param protected VectorRasterEntry)
    (while (> raster-byte-count vector-raster-cache-budget)
      (let victim (call least-recent-raster-entry protected))
      (return-if (if (not victim)))
      (call evict-raster-entry victim)
    )
  )
  (fn-do _ least-recent-raster-entry _
    (param protected VectorRasterEntry)
    (let oldest (? VectorRasterEntry))
    (for (in entry raster-entries)
      (if (!= (as entry Pointer) (as protected Pointer))
        (if (or (not oldest) (< (. entry last-use) (. oldest last-use)))
          (= oldest entry)
        )
      )
    )
    (return oldest)
  )
  (fn-do _ evict-raster-entry _
    (param entry VectorRasterEntry)
    (if (call is-image-valid (. entry image-handle))
      (call release-image (. entry image-handle))
    )
    (if (<= (. entry image-bytes) raster-byte-count)
      (-= raster-byte-count (. entry image-bytes))
    )
    (= (. entry image-bytes) 0)
    (-= ([] raster-lookup (. entry key)))
    (let slot (. entry slot))
    (let last (- (. raster-entries length) 1))
    (if (!= slot last)
      (let moved ([] raster-entries last))
      (= ([] raster-entries slot) moved)
      (= (. moved slot) slot)
    )
    (call (. raster-entries pop))
  )
  (fn-do _ evict-raster-entries _
    (param handle VectorGeometryHandle)
    (let index Size)
    (while (< index (. raster-entries length))
      (let entry ([] raster-entries index))
      (if (== (. entry geometry-handle) handle)
        (call evict-raster-entry entry)
        (else
          (+= index 1)
        )
      )
    )
  )
)

(fn-expr + default-vector-geometry-table VectorGeometryTable
  fallback-vector-geometry-table
)

(fn-expr + vector-geometry-table-for VectorGeometryTable
  (param root (? MarkupRootElement))
  (case? (not root)
    fallback-vector-geometry-table
  )
  (case? existing
    existing
  )
  (default
    fallback-vector-geometry-table
  )
  (where
    (lazy key (as root Pointer))
    (lazy existing ([] vector-geometry-renderer-tables key))
  )
)

(fn-do + register-vector-geometry-renderer _
  (param root MarkupRootElement)
  (param table VectorGeometryTable)
  (= ([] vector-geometry-renderer-tables (as root Pointer)) table)
)

(fn-do + unregister-vector-geometry-renderer _
  (param root MarkupRootElement)
  (-= ([] vector-geometry-renderer-tables (as root Pointer)))
)

(fn-expr + vector-view-transform Matrix
  (param view Rect)
  (param destination Rect)
  (call (. (call (. (call matrix-from-translation (. destination top-left)) scale) size) translate) (call Point (- (. view x)) (- (. view y))))
  (where
    (lazy size (call Dimensions (/ (. destination width) (. view width)) (/ (. destination height) (. view height))))
  )
)

(fn-expr + vector-matrix-is-axis-aligned _
  (param matrix Matrix)
  (and (== (. matrix b) 0) (== (. matrix c) 0) (> (. matrix a) 0) (> (. matrix d) 0))
)

(fn-do + vector-geometry-fingerprint U64
  (param source VectorGeometrySource)
  (param view-box Rect)
  (let fingerprint fnv-offset-basis)
  (= fingerprint (call vector-geometry-mix-rect fingerprint view-box))
  (return (call vector-geometry-mix-source fingerprint source))
)

(fn-do + build-vector-geometry VectorGeometry
  (param source VectorGeometrySource)
  (param view-box Rect)
  (let spans (list VectorGeometrySpan))
  (let cursor (call VectorGeometryRoleCursor))
  (let style
    (call VectorGeometryStyle
      (block
        (arg (call VectorGeometryPaint (. VectorGeometryPaintRole inherit) 0))
        (arg (call VectorGeometryPaint (. VectorGeometryPaintRole inherit) 0))
        (arg null)
        (arg null)
        (arg null)
        (arg (. FillRule nonzero))
        (arg (call Matrix))
      )
    )
  )
  (let has-ink false)
  (let ink-bounds (call Rect 0 0 0 0))
  (let result (call append-vector-geometry source style cursor spans has-ink ink-bounds))
  (let inherits-fill false)
  (let inherits-stroke false)
  (for (in span spans)
    (if (== (. span fill role) (. VectorGeometryPaintRole inherit))
      (= inherits-fill true)
    )
    (if (== (. span stroke role) (. VectorGeometryPaintRole inherit))
      (= inherits-stroke true)
    )
    (if (== (. span fill role) (. VectorGeometryPaintRole inherited-stroke))
      (= inherits-stroke true)
    )
  )
  (return (call VectorGeometry view-box (. result ink-bounds) spans inherits-fill inherits-stroke))
)

(fn-do + vector-geometry-supports-source Bool
  (param source VectorGeometrySource)
  (return-if false (if (not (. source vector-geometry-source-compact))))
  (if (== (. source vector-geometry-source-kind) vector-geometry-source-graphic)
    (let node (call (of gc-object-from-pointer GraphicNode) (. source vector-geometry-source-pointer)))
    (return (or (is node VectorPath) (is node PathGraphic) (is node Circle) (is node Ellipse) (is node Rectangle) (is node Line) (is node Square) (is node Polygon) (is node Spiral) (is node SineWave) (is node Leaf)))
  )
  (return (call all (..< 0 (. source vector-geometry-source-child-count)) (:where (call vector-geometry-supports-source (call (. source vector-geometry-source-child) each)))))
)

(fn-do + vector-geometry-palette (list RGBA)
  (param source VectorGeometrySource)
  (let palette (list RGBA))
  (call append-vector-geometry-palette source palette)
  (return palette)
)

(type _ VectorGeometryEntry
  (prop + fingerprint U64)
  (prop + generation U32 (= 1))
  (prop + references U32)
  (prop + geometry (? VectorGeometry))
  (fn-do _ This _
    (param fingerprint _)
    (param geometry _)
    (param references _)
  )
)

(type _ ImageResourceEntry
  (prop + generation U32 (= 1))
  (prop + references U32)
  (prop + resource (? ImageResource))
  (fn-do _ This _
    (param resource _)
    (param references _)
  )
)

(type _ VectorRasterEntry
  (prop + geometry-handle VectorGeometryHandle)
  (prop + pixel-width I32)
  (prop + pixel-height I32)
  (prop + scale-x F64)
  (prop + scale-y F64)
  (prop + phase-x I32)
  (prop + phase-y I32)
  (prop + stroke-width Length)
  (prop + stroke-cap LineCap)
  (prop + stroke-join LineJoin)
  (prop + stroke-dash Length)
  (prop + template-alpha Bool)
  (prop + palette-key U64)
  (prop + key U64)
  (prop + last-use U64)
  (prop + image-handle _ (= (call ImageHandle 0 0)))
  (prop + image-bytes Size)
  (prop + slot Size)
  (fn-do _ This _
    (param geometry-handle _)
    (param pixel-width _)
    (param pixel-height _)
    (param scale-x _)
    (param scale-y _)
    (param phase-x _)
    (param phase-y _)
    (param stroke-width _)
    (param stroke-cap _)
    (param stroke-join _)
    (param stroke-dash _)
    (param template-alpha _)
    (param palette-key _)
    (param key _)
  )
  (fn-expr + matches _
    (param other VectorRasterEntry)
    (case? (!= geometry-handle (. other geometry-handle))
      false
    )
    (case? (or (!= pixel-width (. other pixel-width)) (!= pixel-height (. other pixel-height)))
      false
    )
    (case? (or (!= scale-x (. other scale-x)) (!= scale-y (. other scale-y)))
      false
    )
    (case? (or (!= phase-x (. other phase-x)) (!= phase-y (. other phase-y)))
      false
    )
    (case? (or (!= stroke-width (. other stroke-width)) (!= stroke-cap (. other stroke-cap)))
      false
    )
    (case? (or (!= stroke-join (. other stroke-join)) (!= stroke-dash (. other stroke-dash)))
      false
    )
    (default
      (and (== template-alpha (. other template-alpha)) (== palette-key (. other palette-key)))
    )
  )
)

(type _ VectorGeometryStyle
  (prop + fill VectorGeometryPaint)
  (prop + stroke VectorGeometryPaint)
  (prop + stroke-width (? Length))
  (prop + stroke-cap (? LineCap))
  (prop + stroke-join (? LineJoin))
  (prop + fill-rule FillRule)
  (prop + transform Matrix)
  (fn-do _ This _
    (param fill _)
    (param stroke _)
    (param stroke-width _)
    (param stroke-cap _)
    (param stroke-join _)
    (param fill-rule _)
    (param transform _)
  )
)

(type _ VectorGeometryRoleCursor
  (prop + next U32)
)

(fn-expr _ vector-raster-phase-offset _
  (param phase I32)
  (/ (as phase F64) (as vector-raster-phase-steps F64))
)

(fn-expr _ vector-raster-pixel-extent _
  (param phase I32)
  (param extent F64)
  (as (call ceil (- (+ (call vector-raster-phase-offset phase) extent) vector-raster-epsilon)) I32)
)

(fn-do _ append-vector-geometry (tuple (: has-ink Bool) (: ink-bounds Rect))
  (param source VectorGeometrySource)
  (param inherited VectorGeometryStyle)
  (param cursor VectorGeometryRoleCursor)
  (param spans (list VectorGeometrySpan))
  (param has-ink Bool)
  (param ink-bounds Rect)
  (let style (call vector-geometry-source-style source inherited cursor))
  (let path (? Path))
  (if (== (. source vector-geometry-source-kind) vector-geometry-source-graphic)
    (= path (call vector-geometry-node-path (. source vector-geometry-source-pointer)))
  )
  (if path
    (if (not (. style transform is-identity))
      (call (. path transform) (. style transform))
    )
    (call (. path trim))
    (+= spans
      (call VectorGeometrySpan
        (block
          (arg path)
          (arg (. style fill))
          (arg (. style stroke))
          (arg (. style stroke-width))
          (arg (. style stroke-cap))
          (arg (. style stroke-join))
          (arg (. style fill-rule))
        )
      )
    )
    (blank)
    (let bounds (. path bounding-box))
    (if (and (!= (. style stroke role) (. VectorGeometryPaintRole none)) (. style stroke-width))
      (= bounds (call (. bounds inflate) (. style stroke-width) (. style stroke-width)))
    )
    (= ink-bounds (if-expr (not has-ink) bounds (+ ink-bounds bounds)))
    (= has-ink true)
  )
  (blank)
  (for (in index (..< 0 (. source vector-geometry-source-child-count)))
    (let child (call (. source vector-geometry-source-child) index))
    (let result (call append-vector-geometry child style cursor spans has-ink ink-bounds))
    (= has-ink (. result has-ink))
    (= ink-bounds (. result ink-bounds))
  )
  (return (tuple has-ink ink-bounds))
)

(fn-do _ vector-geometry-source-style VectorGeometryStyle
  (param source VectorGeometrySource)
  (param inherited VectorGeometryStyle)
  (param cursor VectorGeometryRoleCursor)
  (let fill (call vector-geometry-paint-role (. source vector-geometry-source-fill) (. inherited fill) cursor))
  (let stroke
    (call vector-geometry-paint-role
      (block
        (arg (. source vector-geometry-source-stroke))
        (arg (. inherited stroke))
        (arg cursor)
      )
    )
  )
  (if (== (. source vector-geometry-source-fill) (. Fill stroke))
    (= fill (call vector-geometry-stroke-fill stroke))
  )
  (let width (?? (. source vector-geometry-source-stroke-width) (. inherited stroke-width)))
  (let cap (?? (. source vector-geometry-source-stroke-cap) (. inherited stroke-cap)))
  (let join (?? (. source vector-geometry-source-stroke-join) (. inherited stroke-join)))
  (let rule (?? (. source vector-geometry-source-fill-rule) (. inherited fill-rule)))
  (let transform (. inherited transform))
  (if (. source vector-geometry-source-transform)
    (= transform (call (. transform concatenate) (!! (. source vector-geometry-source-transform))))
  )
  (return (call VectorGeometryStyle fill stroke width cap join rule transform))
)

(fn-do _ vector-geometry-paint-role VectorGeometryPaint
  (param paint Fill)
  (param inherited VectorGeometryPaint)
  (param cursor VectorGeometryRoleCursor)
  (return-if inherited (if (or (== paint (. Fill inherit)) (== paint (. Fill stroke)))))
  (return-if (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0) (if (== paint (. Fill none))))
  (let role (call VectorGeometryPaint (. VectorGeometryPaintRole color) (. cursor next)))
  (+= (. cursor next) 1)
  (return role)
)

(fn-do _ vector-geometry-paint-role VectorGeometryPaint
  (param paint Stroke)
  (param inherited VectorGeometryPaint)
  (param cursor VectorGeometryRoleCursor)
  (return-if inherited (if (== paint (. Stroke inherit))))
  (return-if (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0) (if (== paint (. Stroke none))))
  (let role (call VectorGeometryPaint (. VectorGeometryPaintRole color) (. cursor next)))
  (+= (. cursor next) 1)
  (return role)
)

(fn-expr _ vector-geometry-stroke-fill _
  (param stroke VectorGeometryPaint)
  (case? (== (. stroke role) (. VectorGeometryPaintRole inherit))
    (call VectorGeometryPaint (. VectorGeometryPaintRole inherited-stroke) 0)
  )
  (default
    stroke
  )
)

(fn-expr _ vector-geometry-node-path (? Path)
  (param node-pointer Pointer)
  (case? (is node VectorPath)
    (call (. (as node VectorPath) vector-path-geometry))
  )
  (case? (is node PathGraphic)
    (call Path (. (as node PathGraphic) path))
  )
  (case? (is node Circle)
    (call circle (. circle-node center) (call abs (. circle-node radius)))
    (blank)
    (lazy circle-node (as node Circle))
  )
  (case? (is node Ellipse)
    (call ellipse
      (block
        (arg (. ellipse-node center))
        (arg (call Dimensions (call abs (. ellipse-node radius width)) (call abs (. ellipse-node radius height))))
      )
    )
    (blank)
    (lazy ellipse-node (as node Ellipse))
  )
  (case? (is node Rectangle)
    (call rectangle (. (as node Rectangle) rect))
  )
  (case? (is node Line)
    (call line (. line-node start) (. line-node end))
    (blank)
    (lazy line-node (as node Line))
  )
  (case? (is node Square)
    (call square
      (block
        (arg
          (call Point
            (block
              (arg (- (. square-node center x) (. square-node radius)))
              (arg (- (. square-node center y) (. square-node radius)))
            )
          )
        )
        (arg (* (. square-node radius) 2))
      )
    )
    (blank)
    (lazy square-node (as node Square))
  )
  (case? (is node Polygon)
    (call polygon (. polygon-node sides) (* (. polygon-node radius) 2) (. polygon-node center))
    (blank)
    (lazy polygon-node (as node Polygon))
  )
  (case? (is node Spiral)
    (call spiral
      (block
        (arg (. spiral-node center))
        (arg (. spiral-node radius))
        (arg (. spiral-node coils))
        (arg (. spiral-node chord))
        (arg (. spiral-node rotation))
      )
    )
    (blank)
    (lazy spiral-node (as node Spiral))
  )
  (case? (is node SineWave)
    (call first-vector-geometry-node-path node)
  )
  (case? (is node Leaf)
    (call leaf (. leaf-node center) (. leaf-node radius))
    (blank)
    (lazy leaf-node (as node Leaf))
  )
  (default
    (call first-vector-geometry-node-path node)
  )
  (where
    (lazy node (call (of gc-object-from-pointer GraphicNode) node-pointer))
  )
)

(fn-do _ append-vector-geometry-palette _
  (param source VectorGeometrySource)
  (param palette (list RGBA))
  (if (is (. source vector-geometry-source-fill) RGBA)
    (+= palette (as (. source vector-geometry-source-fill) RGBA))
  )
  (if (is (. source vector-geometry-source-stroke) RGBA)
    (+= palette (as (. source vector-geometry-source-stroke) RGBA))
  )
  (for (in index (..< 0 (. source vector-geometry-source-child-count)))
    (let child (call (. source vector-geometry-source-child) index))
    (call append-vector-geometry-palette child palette)
  )
)

(fn-do _ vector-geometry-mix-source U64
  (param fingerprint U64)
  (param source VectorGeometrySource)
  (let result (call fnv-mix fingerprint 1))
  (= result (call vector-geometry-mix-paint result (. source vector-geometry-source-fill)))
  (= result (call vector-geometry-mix-paint result (. source vector-geometry-source-stroke)))
  (= result (call vector-geometry-mix-optional-number result (. source vector-geometry-source-stroke-width)))
  (= result (call vector-geometry-mix-optional-cap result (. source vector-geometry-source-stroke-cap)))
  (= result (call vector-geometry-mix-optional-join result (. source vector-geometry-source-stroke-join)))
  (= result (call vector-geometry-mix-optional-rule result (. source vector-geometry-source-fill-rule)))
  (= result (call vector-geometry-mix-optional-matrix result (. source vector-geometry-source-transform)))
  (blank)
  (if (== (. source vector-geometry-source-kind) vector-geometry-source-container)
    (= result (call fnv-mix result 10))
    (else
      (let node (call (of gc-object-from-pointer GraphicNode) (. source vector-geometry-source-pointer)))
      (if (is node VectorPath)
        (= result (call fnv-mix result 12))
        (for (in op (. (as node VectorPath) operations))
          (= result (call vector-geometry-mix-path-op result op))
        )
        (else-if (is node PathGraphic)
          (= result (call fnv-mix result 17))
          (= result (call vector-geometry-mix-path result (. (as node PathGraphic) path)))
        )
        (else-if (is node Circle)
          (let circle-node (as node Circle))
          (= result (call fnv-mix result 13))
          (= result (call vector-geometry-mix-point result (. circle-node center)))
          (= result (call vector-geometry-mix-number result (. circle-node radius)))
        )
        (else-if (is node Ellipse)
          (let ellipse-node (as node Ellipse))
          (= result (call fnv-mix result 14))
          (= result (call vector-geometry-mix-point result (. ellipse-node center)))
          (= result (call vector-geometry-mix-number result (. ellipse-node radius width)))
          (= result (call vector-geometry-mix-number result (. ellipse-node radius height)))
        )
        (else-if (is node Rectangle)
          (= result (call fnv-mix result 15))
          (= result (call vector-geometry-mix-rect result (. (as node Rectangle) rect)))
        )
        (else-if (is node Line)
          (let line-node (as node Line))
          (= result (call fnv-mix result 16))
          (= result (call vector-geometry-mix-point result (. line-node start)))
          (= result (call vector-geometry-mix-point result (. line-node end)))
        )
        (else-if (is node Square)
          (let square-node (as node Square))
          (= result (call fnv-mix result 18))
          (= result (call vector-geometry-mix-point result (. square-node center)))
          (= result (call vector-geometry-mix-number result (. square-node radius)))
        )
        (else-if (is node Polygon)
          (let polygon-node (as node Polygon))
          (= result (call fnv-mix result 19))
          (= result (call fnv-mix result (. polygon-node sides)))
          (= result (call vector-geometry-mix-point result (. polygon-node center)))
          (= result (call vector-geometry-mix-number result (. polygon-node radius)))
        )
        (else-if (is node Spiral)
          (let spiral-node (as node Spiral))
          (= result (call fnv-mix result 26))
          (= result (call vector-geometry-mix-point result (. spiral-node center)))
          (= result (call vector-geometry-mix-number result (. spiral-node radius)))
          (= result (call vector-geometry-mix-number result (. spiral-node coils)))
          (= result (call vector-geometry-mix-number result (. spiral-node chord)))
          (= result (call vector-geometry-mix-number result (. spiral-node rotation)))
        )
        (else-if (or (is node SineWave) (is node Leaf))
          (= result (call fnv-mix result 27))
          (let path (call vector-geometry-node-path (as node Pointer)))
          (if path
            (= result (call vector-geometry-mix-path result path))
          )
        )
        (else
          (= result (call fnv-mix result (as (. node revision) U64)))
        )
      )
    )
  )
  (blank)
  (for (in index (..< 0 (. source vector-geometry-source-child-count)))
    (let child (call (. source vector-geometry-source-child) index))
    (= result (call vector-geometry-mix-source result child))
  )
  (return (call fnv-mix result 2))
)

(fn-do _ first-vector-geometry-node-path (? Path)
  (param node GraphicNode)
  (for (in path (call (. node draw)))
    (return (call Path path))
  )
  (return null)
)

(fn-do _ vector-geometry-mix-path U64
  (param fingerprint U64)
  (param path Path)
  (let result (call fnv-mix fingerprint (as (. path count) U64)))
  (let commands (. path commands))
  (for (in index (..< 0 (. commands command-count)))
    (= result (call fnv-mix result ([] (. commands verbs) index)))
  )
  (for (in index (..< 0 (. commands coord-count)))
    (= result (call vector-geometry-mix-number result ([] (. commands coords) index)))
  )
  (return result)
)

(fn-do _ vector-geometry-mix-path-op U64
  (param fingerprint U64)
  (param op PathOp)
  (let result fingerprint)
  (if (is op PathMoveTo)
    (let move (as op PathMoveTo))
    (= result (call fnv-mix result 20))
    (= result (call vector-geometry-mix-number result (. move x)))
    (= result (call vector-geometry-mix-number result (. move y)))
    (else-if (is op PathLineTo)
      (let line-op (as op PathLineTo))
      (= result (call fnv-mix result 21))
      (= result (call vector-geometry-mix-number result (. line-op x)))
      (= result (call vector-geometry-mix-number result (. line-op y)))
    )
    (else-if (is op PathCubicTo)
      (let cubic (as op PathCubicTo))
      (= result (call fnv-mix result 22))
      (= result (call vector-geometry-mix-number result (. cubic c1x)))
      (= result (call vector-geometry-mix-number result (. cubic c1y)))
      (= result (call vector-geometry-mix-number result (. cubic c2x)))
      (= result (call vector-geometry-mix-number result (. cubic c2y)))
      (= result (call vector-geometry-mix-number result (. cubic x)))
      (= result (call vector-geometry-mix-number result (. cubic y)))
    )
    (else-if (is op PathQuadraticTo)
      (let quadratic (as op PathQuadraticTo))
      (= result (call fnv-mix result 23))
      (= result (call vector-geometry-mix-number result (. quadratic cx)))
      (= result (call vector-geometry-mix-number result (. quadratic cy)))
      (= result (call vector-geometry-mix-number result (. quadratic x)))
      (= result (call vector-geometry-mix-number result (. quadratic y)))
    )
    (else-if (is op PathArcTo)
      (let arc (as op PathArcTo))
      (= result (call fnv-mix result 24))
      (= result (call vector-geometry-mix-number result (. arc rx)))
      (= result (call vector-geometry-mix-number result (. arc ry)))
      (= result (call vector-geometry-mix-number result (as (. arc rotation) Radians)))
      (= result (call fnv-mix result (if-expr (. arc large) 1 0)))
      (= result (call fnv-mix result (if-expr (. arc sweep) 1 0)))
      (= result (call vector-geometry-mix-number result (. arc x)))
      (= result (call vector-geometry-mix-number result (. arc y)))
    )
    (else
      (= result (call fnv-mix result 25))
    )
  )
  (return result)
)

(fn-expr _ vector-geometry-mix-paint U64
  (param fingerprint U64)
  (param paint Fill)
  (match paint
    (case= (. Fill inherit)
      (call fnv-mix fingerprint 30)
    )
    (case= (. Fill none)
      (call fnv-mix fingerprint 31)
    )
    (case= (. Fill stroke)
      (call fnv-mix fingerprint 33)
    )
    (default
      (call fnv-mix fingerprint 32)
    )
  )
)

(fn-expr _ vector-geometry-mix-paint U64
  (param fingerprint U64)
  (param paint Stroke)
  (match paint
    (case= (. Stroke inherit)
      (call fnv-mix fingerprint 30)
    )
    (case= (. Stroke none)
      (call fnv-mix fingerprint 31)
    )
    (default
      (call fnv-mix fingerprint 32)
    )
  )
)

(fn-expr _ vector-geometry-mix-optional-number U64
  (param fingerprint U64)
  (param value (? Float))
  (case? (not value)
    (call fnv-mix fingerprint 0)
  )
  (default
    (call vector-geometry-mix-number (call fnv-mix fingerprint 1) value)
  )
)

(fn-do _ vector-geometry-mix-optional-cap U64
  (param fingerprint U64)
  (param value (? LineCap))
  (return-if (call fnv-mix fingerprint 0) (if (not value)))
  (let tag U64 1)
  (if (== value (. LineCap round))
    (= tag 2)
    (else-if (== value (. LineCap square))
      (= tag 3)
    )
  )
  (return (call fnv-mix fingerprint tag))
)

(fn-do _ vector-geometry-mix-optional-join U64
  (param fingerprint U64)
  (param value (? LineJoin))
  (return-if (call fnv-mix fingerprint 0) (if (not value)))
  (let tag U64 1)
  (if (== value (. LineJoin round))
    (= tag 2)
    (else-if (== value (. LineJoin bevel))
      (= tag 3)
    )
  )
  (return (call fnv-mix fingerprint tag))
)

(fn-expr _ vector-geometry-mix-optional-rule U64
  (param fingerprint U64)
  (param value (? FillRule))
  (case? (not value)
    (call fnv-mix fingerprint 0)
  )
  (default
    (call fnv-mix fingerprint (if-expr (== value (. FillRule even-odd)) 2 1))
  )
)

(fn-do _ vector-geometry-mix-optional-matrix U64
  (param fingerprint U64)
  (param value (? Matrix))
  (return-if (call fnv-mix fingerprint 0) (if (not value)))
  (let result (call fnv-mix fingerprint 1))
  (= result (call vector-geometry-mix-number result (. value a)))
  (= result (call vector-geometry-mix-number result (. value c)))
  (= result (call vector-geometry-mix-number result (. value b)))
  (= result (call vector-geometry-mix-number result (. value d)))
  (= result (call vector-geometry-mix-number result (. value tx)))
  (return (call vector-geometry-mix-number result (. value ty)))
)

(fn-expr _ vector-geometry-mix-point U64
  (param fingerprint U64)
  (param point Point)
  (call vector-geometry-mix-number (call vector-geometry-mix-number fingerprint (. point x)) (. point y))
)

(fn-do _ vector-geometry-mix-rect U64
  (param fingerprint U64)
  (param rect Rect)
  (let result (call vector-geometry-mix-number fingerprint (. rect x)))
  (= result (call vector-geometry-mix-number result (. rect y)))
  (= result (call vector-geometry-mix-number result (. rect width)))
  (return (call vector-geometry-mix-number result (. rect height)))
)

(fn-do _ vector-geometry-mix-number U64
  (param fingerprint U64)
  (param value Float)
  (let magnitude (as (* (call abs value) 1000000000) U64))
  (if (< value 0)
    (= magnitude (/xor/ magnitude (. U64 max)))
  )
  (return (call fnv-mix fingerprint magnitude))
)
