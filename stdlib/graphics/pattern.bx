(import ./canvas)
(import ./color)
(import ./primitives)
(import /math)
(import /units)

(fn-do + fill-checkerboard _
  (param canvas Canvas)
  (param rect Rect)
  (param cell Length)
  (param light RGBA)
  (param dark RGBA)
  (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0) (not (call is-finite cell)) (<= cell 0))))
  (blank)
  (do-use (. canvas saved-state)
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) light)
    (call (. canvas rect) rect)
    (= (. canvas fill-color) dark)
    (let columns (as (call ceil (/ (. rect width) cell)) Size))
    (let rows (as (call ceil (/ (. rect height) cell)) Size))
    (for (in row (..< 0 rows))
      (let y (+ (. rect y) (* (as row F64) cell)))
      (let height (call min cell (- (. rect bottom) y)))
      (for (in column (..< 0 columns))
        (if (== (% (+ row column) 2) 1)
          (let x (+ (. rect x) (* (as column F64) cell)))
          (call (. canvas rect) (call Rect x y (call min cell (- (. rect right) x)) height))
        )
      )
    )
  )
)
