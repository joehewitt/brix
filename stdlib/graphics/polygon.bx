(import ./curve-kernels)
(import ./path)
(import ./point)
(import ./primitives)
(import ./utils)
(import /math)
(import /stream/aggregate)
(import /stream/coincidence)
(import /stream/filter)
(import /stream/sort)
(blank)
(prop _ default-resolution _ (= 40))
(prop _ default-size _ (= 5000))

(type + Polygon
  (prop + points (list Point))
  (prop + is-closed _ (= false))
  (prop + start-point (? Index))
  (blank)
  (prop _ computed-area (? Length))
  (fn-do + This _
    (param points (list Point))
    (param is-closed _ (= false))
  )
  (fn-do + This _
    (param path Path)
    (param resolution _ (= default-resolution))
    (probe-count graphics.polygon.path-conversions)
    (let t-min tolerance)
    (let t-max (if-expr (> resolution 1) (- 1 tolerance) -1))
    (blank)
    (let pc -1)
    (blank)
    (let poly-points (list Point))
    (let span (. path commands))
    (let first-x Coord ([] (. span coords) 0))
    (let first-y Coord ([] (. span coords) 1))
    (+= poly-points
      (call Point
        (block
          (arg first-x)
          (arg first-y)
        )
      )
    )
    (blank)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (for (in i (..< 0 (. span command-count)))
      (let verb ([] (. span verbs) i))
      (let start Index ([] (. span coord-offsets) i))
      (let prev-x Coord)
      (let prev-y Coord)
      (let has-prev false)
      (if (> i 0)
        (let prev-index (- i 1))
        (let prev-verb ([] (. span verbs) prev-index))
        (let prev-start Index ([] (. span coord-offsets) prev-index))
        (if (or (== prev-verb .path-verb-move) (== prev-verb .path-verb-line))
          (= prev-x ([] (. span coords) prev-start))
          (= prev-y ([] (. span coords) (+ prev-start 1)))
          (= has-prev true)
          (else-if (== prev-verb .path-verb-cubic)
            (= prev-x ([] (. span coords) (+ prev-start 4)))
            (= prev-y ([] (. span coords) (+ prev-start 5)))
            (= has-prev true)
          )
          (else-if (== prev-verb .path-verb-close)
            (= prev-x first-x)
            (= prev-y first-y)
            (= has-prev true)
          )
        )
      )
      (blank)
      (if (== verb .path-verb-move)
        (= subpath-x ([] (. span coords) start))
        (= subpath-y ([] (. span coords) (+ start 1)))
        (= has-current true)
        (else-if (and (== verb .path-verb-line) has-current has-prev)
          (let next-x Coord ([] (. span coords) start))
          (let next-y Coord ([] (. span coords) (+ start 1)))
          (let dx Coord (- next-x prev-x))
          (let dy Coord (- next-y prev-y))
          (if (>= (+ (* dx dx) (* dy dy)) (* tolerance tolerance))
            (+= poly-points
              (call Point
                (block
                  (arg next-x)
                  (arg next-y)
                )
              )
            )
          )
        )
        (else-if (and (== verb .path-verb-cubic) has-current has-prev)
          (let a1-x Coord prev-x)
          (let a1-y Coord prev-y)
          (let ho-x Coord ([] (. span coords) start))
          (let ho-y Coord ([] (. span coords) (+ start 1)))
          (let hi-x Coord ([] (. span coords) (+ start 2)))
          (let hi-y Coord ([] (. span coords) (+ start 3)))
          (let a2-x Coord ([] (. span coords) (+ start 4)))
          (let a2-y Coord ([] (. span coords) (+ start 5)))
          (let coeffx (call cubic-coefficients-1d a1-x ho-x hi-x a2-x))
          (let coeffy (call cubic-coefficients-1d a1-y ho-y hi-y a2-y))
          (let prev-x Coord a1-x)
          (let prev-y Coord a1-y)
          (let step Coord (/ (- t-max t-min) resolution))
          (for (in t (.. t-min t-max (by: step)))
            (probe-count graphics.polygon.path-samples)
            (let sample-x Coord (call cubic-evaluate-1d (. coeffx a) (. coeffx b) (. coeffx c) a1-x t))
            (let sample-y Coord (call cubic-evaluate-1d (. coeffy a) (. coeffy b) (. coeffy c) a1-y t))
            (let dx Coord (- sample-x prev-x))
            (let dy Coord (- sample-y prev-y))
            (if (< (+ (* dx dx) (* dy dy)) (* tolerance tolerance))
              (continue)
            )
            (blank)
            (+= poly-points
              (call Point
                (block
                  (arg sample-x)
                  (arg sample-y)
                )
              )
            )
            (= prev-x sample-x)
            (= prev-y sample-y)
          )
          (blank)
          (let dx Coord (- a2-x prev-x))
          (let dy Coord (- a2-y prev-y))
          (if (>= (+ (* dx dx) (* dy dy)) (* tolerance tolerance))
            (+= poly-points
              (call Point
                (block
                  (arg a2-x)
                  (arg a2-y)
                )
              )
            )
          )
        )
        (else-if (and (== verb .path-verb-close) has-current has-prev)
          (let close-x Coord)
          (let close-y Coord)
          (let found-close-start false)
          (let seek i)
          (while (> seek 0)
            (-= seek 1)
            (if (== ([] (. span verbs) seek) .path-verb-move)
              (let move-start Index ([] (. span coord-offsets) seek))
              (= close-x ([] (. span coords) move-start))
              (= close-y ([] (. span coords) (+ move-start 1)))
              (= found-close-start true)
              (break)
            )
          )
          (if (not found-close-start)
            (continue)
          )
          (if (or (!= prev-x close-x) (!= prev-y close-y))
            (let dx Coord (- close-x prev-x))
            (let dy Coord (- close-y prev-y))
            (if (>= (+ (* dx dx) (* dy dy)) (* tolerance tolerance))
              (+= poly-points
                (call Point
                  (block
                    (arg close-x)
                    (arg close-y)
                  )
                )
              )
            )
          )
        )
      )
    )
    (blank)
    (if (and (. path is-closed) poly-points)
      (let last ([] poly-points (. Position last)))
      (let dx Coord (- (. last x) first-x))
      (let dy Coord (- (. last y) first-y))
      (if (>= (+ (* dx dx) (* dy dy)) (* tolerance tolerance))
        (+= poly-points
          (call Point
            (block
              (arg first-x)
              (arg first-y)
            )
          )
        )
      )
    )
    (blank)
    (return (call Polygon poly-points (. path is-closed)))
  )
  (fn-to-do + Path
    (let path Path)
    (if (not points)
      (return path)
    )
    (blank)
    (call (. path move-to) ([] points 0))
    (for (in i (..< 1 (. points length)))
      (call (. path line-to) ([] points i))
    )
    (blank)
    (if is-closed
      (call (. path close))
    )
    (blank)
    (return path)
  )
  (fn-expr + area Length :get
    (before
      (probe-count graphics.polygon.area.calls)
    )
    (/ total 2)
    (where
      (lazy total
        (block
          (spread (call pairwise points (and is-closed (> (. points length) 1))))
          (pipe *> (- (* (. each a x) (. each b y)) (* (. each b x) (. each a y))))
          (pipe |> sum)
        )
      )
    )
  )
  (fn-expr + is-clockwise _ :get
    (>= area 0)
  )
  (fn-do + (infix this += (param point Point)) _
    (if (or (not points) (!= ([] points (. Position last)) point))
      (+= points point)
    )
  )
  (fn-do + close _
    (= is-closed true)
  )
  (fn-do + reset _
    (call (. points clear))
    (= is-closed false)
    (= computed-area null)
  )
  (fn-expr + get-point-at _
    (param i Index)
    ([] points i)
  )
  (fn-expr + get-concave-at _
    (param i Index)
    (call is-concave angle-in angle-out)
    (where
      (lazy i0 (if-expr (== i 0) (- (. points length) 2) (- i 1)))
      (lazy p0 ([] points i0))
      (lazy p1 ([] points i))
      (lazy i2 (if-expr (== (+ i 1) (- (. points length) 1)) 0 (+ i 1)))
      (lazy p2 ([] points i2))
      (lazy angle-in (call (. p0 angle) p1))
      (lazy angle-out (call (. p1 angle) p2))
    )
  )
  (fn-do + get-winding-at _
    (param pt Point)
    (param is-clockwise _ (= true))
    (let winding 0)
    (let up (if-expr is-clockwise 1 -1))
    (blank)
    (for (in i (..< 1 (. points length)))
      (let p1 ([] points (- i 1)))
      (let p2 ([] points i))
      (if (call point-on-segment pt p1 p2)
        (return up)
      )
      (blank)
      (if (<= (. p1 y) (. pt y))
        (if (> (. p2 y) (. pt y))
          (let is-left (- (* (- (. p2 x) (. p1 x)) (- (. pt y) (. p1 y))) (* (- (. pt x) (. p1 x)) (- (. p2 y) (. p1 y)))))
          (if (> is-left 0)
            (+= winding up)
          )
        )
        (else-if (<= (. p2 y) (. pt y))
          (let is-left (- (* (- (. p2 x) (. p1 x)) (- (. pt y) (. p1 y))) (* (- (. pt x) (. p1 x)) (- (. p2 y) (. p1 y)))))
          (if (< is-left 0)
            (-= winding up)
          )
        )
      )
    )
    (blank)
    (if is-closed
      (let p1 ([] points (. Position last)))
      (let p2 ([] points 0))
      (if (call point-on-segment pt p1 p2)
        (return up)
      )
      (blank)
      (if (<= (. p1 y) (. pt y))
        (if (> (. p2 y) (. pt y))
          (let is-left (- (* (- (. p2 x) (. p1 x)) (- (. pt y) (. p1 y))) (* (- (. pt x) (. p1 x)) (- (. p2 y) (. p1 y)))))
          (if (> is-left 0)
            (+= winding up)
          )
        )
        (else-if (<= (. p2 y) (. pt y))
          (let is-left (- (* (- (. p2 x) (. p1 x)) (- (. pt y) (. p1 y))) (* (- (. pt x) (. p1 x)) (- (. p2 y) (. p1 y)))))
          (if (< is-left 0)
            (-= winding up)
          )
        )
      )
    )
    (blank)
    (return winding)
  )
  (fn-expr + point-on-segment _
    (param pt Point)
    (param p1 Point)
    (param p2 Point)
    (and cross-ok x-ok y-ok)
    (where
      (lazy cross-ok (< (call abs cross) tolerance))
      (lazy cross (- (* (- (. p2 x) (. p1 x)) (- (. pt y) (. p1 y))) (* (- (. pt x) (. p1 x)) (- (. p2 y) (. p1 y)))))
      (lazy x-ok (and (>= (. pt x) (- min-x tolerance)) (<= (. pt x) (+ max-x tolerance))))
      (lazy min-x (call min (. p1 x) (. p2 x)))
      (lazy max-x (call max (. p1 x) (. p2 x)))
      (lazy y-ok (and (>= (. pt y) (- min-y tolerance)) (<= (. pt y) (+ max-y tolerance))))
      (lazy min-y (call min (. p1 y) (. p2 y)))
      (lazy max-y (call max (. p1 y) (. p2 y)))
    )
  )
  (fn-do + get-point-inside _
    (param out Point)
    (let l (- (. points length) 1))
    (blank)
    (if (< l 4)
      (let p1 ([] points 0))
      (let p2 ([] points 1))
      (let p3 ([] points 2))
      (let mid1 (call (. p1 midpoint) p2))
      (let mid2 (call (. mid1 midpoint) p3))
      (return mid2)
    )
    (blank)
    (let clockwise is-clockwise)
    (blank)
    (let has-min false)
    (let pmin Point)
    (let dmin Length)
    (blank)
    (let ib (- (. points length) 2))
    (let a ([] points (. Position last)))
    (let v ([] points 0))
    (let b Point)
    (blank)
    (for (in i (..< 1 l))
      (= b ([] points i))
      (blank)
      (let angle-in (call (. a angle) v))
      (let angle-out (call (. v angle) b))
      (blank)
      ; Don't use lines that are too close to being parallel
      ; XXXjoe This is a crappy heuristic
      ; var den = abs((by - vy) * (vx - ax) - (bx - vx) * (vy - ay));
      (if (> (call abs (- angle-out angle-in)) 0.0001)
        (let concave (call is-concave angle-in angle-out))
        (if (not clockwise)
          (= concave (not concave))
        )
        (if (not concave)
          (let d1 (call (. v distance) b))
          (if (< d1 tolerance)
            (continue)
          )
          (let d2 (call (. v distance) a))
          (if (< d2 tolerance)
            (continue)
          )
          (break)
        )
      )
      (blank)
      (= a v)
      (= v b)
    )
    (blank)
    (let i-min (call step ib -2 (- l 1)))
    (let i-mid (call step ib -1 (- l 1)))
    (let i-max ib)
    (blank)
    (for (in i (..< 0 l))
      (if (and (!= i i-min) (!= i i-mid) (!= i i-max))
        (let q ([] points i))
        (if (call point-in-triangle q a v b)
          (let d (call (. q distance) v))
          (if (and d (or (not has-min) (< d dmin)))
            (= has-min true)
            (= dmin d)
            (= pmin q)
          )
        )
      )
    )
    (blank)
    (return
      (block
        (case? (not has-min)
          (call (. a midpoint) b)
        )
        (default
          (call (. pmin midpoint) v)
        )
      )
    )
  )
  ; Based on Chen-McMains algorithm
  ; http://www.me.berkeley.edu/~mcmains/pubs/DAC05OffsetPolygon.pdf
  (fn-do + tessellate (list Polygon)
    (param is-forward _ (= true))
    (param is-clockwise _ (= true))
    (probe-count graphics.polygon.tessellations)
    (let repeated (call split-repeated-point))
    (if repeated
      (return repeated)
    )
    (blank)
    (let crossing (call get-self-intersections))
    (if crossing
      (probe-count graphics.polygon.self-crossing-tessellations)
      (let polygons (call cross-polygons crossing is-forward))
      (return (call reduce-polygons polygons is-forward is-clockwise))
      (else
        (return (list this))
      )
    )
  )
  (fn-do + split-repeated-point _
    (for (in i (..< 0 (. points length)))
      (for (in j (..< (+ i 2) (. points length)))
        (if (>= j (. points length))
          (continue)
        )
        (if (and (== i 0) (== j (- (. points length) 1)))
          (continue)
        )
        (blank)
        (if (== ([] points i) ([] points j))
          (let first (list Point))
          (for (in k (..< i (+ j 1)))
            (if (< k (. points length))
              (+= first ([] points k))
            )
          )
          (blank)
          (let second (list Point))
          (for (in k (..< j (. points length)))
            (if (< k (. points length))
              (+= second ([] points k))
            )
          )
          (for (in k (..< 0 (+ i 1)))
            (if (< k (. points length))
              (+= second ([] points k))
            )
          )
          (blank)
          (if (and (>= (. first length) 3) (>= (. second length) 3))
            (return (list (call Polygon first (:is-closed true)) (call Polygon second (:is-closed true))))
          )
        )
      )
    )
  )
  (fn-do _ cross-polygons _
    (param crossing Crossing)
    (param is-forward _ (= false))
    (probe-count graphics.polygon.cross-polygons)
    (let polygons (list Polygon))
    (let i-max (- (. points length) 1))
    (let reusable-polygon (? Polygon))
    (blank)
    ;  XXXjoe The backwards traversal is no longer necessary - I will get rid of it
    ; unless I find another use for it
    (= is-forward true)
    ; ` XXXjoe If so, Convert step to only work in positive direction
    (blank)
    (while true
      (let poly (if-expr reusable-polygon reusable-polygon (call Polygon)))
      (blank)
      (let start crossing)
      (if (not (. crossing visited))
        ; poly += crossing.pt
        (while true
          (= (. crossing visited) true)
          (blank)
          (let next (. crossing next))
          (if (not next)
            (break)
          )
          (blank)
          (let i-next (. next i))
          (let i (. crossing i))
          (while (!= i i-next)
            (let pt (call get-point-at i))
            (+= poly pt)
            (if (== i i-max)
              (= (. poly start-point) (. poly points length))
            )
            (blank)
            (= i (call step i 1 i-max))
          )
          (blank)
          (+= poly (. next pt))
          (blank)
          (= crossing (!! (. next counter)))
          (if (== crossing start)
            (break)
          )
        )
      )
      (blank)
      (if is-closed
        (call (. poly close))
      )
      (blank)
      (if (>= (call abs (. poly area)) 1)
        (+= polygons poly)
        (= reusable-polygon null)
        (else
          (call (. poly reset))
          (= reusable-polygon poly)
        )
      )
      (blank)
      (let next-crossing (call find-next-crossing crossing))
      (if next-crossing
        (= crossing next-crossing)
        (else
          (break)
        )
      )
    )
    (blank)
    (return polygons)
  )
  (fn-do _ reduce-polygons _
    (param polygons (list Polygon))
    (param is-forward _ (= false))
    (param is-clockwise _ (= true))
    (probe-count graphics.polygon.reductions)
    (let results (list (tuple (: pt Point) (: poly Polygon))))
    (let last-point Point)
    (for (in polygon polygons)
      (let pt (call (. polygon get-point-inside) last-point))
      (let wn (call get-winding-at pt is-clockwise))
      (if (>= wn 1)
        (+= results (tuple pt polygon))
      )
      (= last-point pt)
    )
    (blank)
    (if (not is-clockwise)
      (= is-forward (not is-forward))
    )
    (blank)
    (= results
      (call filter (:stream results)
        (:where
          (=> (a) :do
            (block
              (for (in b results)
                (if (!= a b)
                  (if (and (not is-forward) (call (. b poly get-winding-at) (. a pt) is-clockwise))
                    (return-if (if (< (call abs (. a poly area)) (call abs (. b poly area)))))
                    (else-if (and is-forward (call (. a poly get-winding-at) (. b pt) is-clockwise))
                      (return-if (if (> (call abs (. a poly area)) (call abs (. b poly area)))))
                    )
                  )
                )
              )
              (return true)
            )
          )
        )
      )
    )
    (blank)
    (return (in (*> (. result poly) result) results))
  )
  (fn-do _ get-self-intersections _
    (probe-count graphics.polygon.self-intersection-scans)
    (let intersections (list Crossing))
    (let map (map PointOnCurve Int))
    (blank)
    (for (in i (..< 1 (. points length)))
      (let p1a ([] points (- i 1)))
      (let p2a ([] points i))
      (for (in j (..< (+ i 1) (. points length)))
        (if (== j (+ i 1))
          (continue)
        )
        (blank)
        (let p1b ([] points (- j 1)))
        (let p2b ([] points j))
        (blank)
        (if (or (== p1b p2a) (== p1a p2b))
          (continue)
        )
        (blank)
        (if (not (call polygon-segment-bounds-overlap p1a p2a p1b p2b))
          (continue)
        )
        (blank)
        (probe-count graphics.polygon.self-intersection-tests)
        (let pt (call intersect-lines p1a p2a p1b p2b))
        (if pt
          (probe-count graphics.polygon.self-intersection-hits)
          (let dd1 (call (. p1a distance) p2a))
          (let d1 (call (. p1a distance) pt))
          (let raw-t1 (/ d1 dd1))
          (if (or (== raw-t1 0) (== raw-t1 1))
            (continue)
          )
          (let t1 raw-t1)
          (blank)
          (let dd2 (call (. p1b distance) p2b))
          (let d2 (call (. p1b distance) pt))
          (let raw-t2 (/ d2 dd2))
          (if (or (== raw-t2 0) (== raw-t2 1))
            (continue)
          )
          (let t2 raw-t2)
          (blank)
          (let key1 (+ i t1))
          (let key2 (+ j t2))
          (let key (call min key1 key2))
          (if (not ([] map key))
            (= ([] map key) 1)
            (blank)
            (let a (call Crossing i t1 pt))
            (let b (call Crossing j t2 pt))
            (= (. a counter) b)
            (= (. b counter) a)
            (+= intersections a)
            (+= intersections b)
          )
        )
      )
    )
    (blank)
    (= intersections
      (block
        (call sort intersections (:using (=> (a b) (if-expr (< (+ (. a i) (. a t)) (+ (. b i) (. b t))) .lesser .greater))))
      )
    )
    (blank)
    (let prev (? Crossing))
    (for (in intr intersections)
      (= (?. prev next) intr)
      (= (. intr previous) prev)
      (= prev intr)
    )
    (blank)
    (if intersections
      (let first ([] intersections 0))
      (= (. first previous) prev)
      (= (?. prev next) first)
      (return first)
    )
  )
)

(fn-expr + polygon-segment-bounds-overlap _
  (param a1 Point)
  (param a2 Point)
  (param b1 Point)
  (param b2 Point)
  (not (or a-left-of-b b-left-of-a a-above-b (< (call max (. b1 y) (. b2 y)) (- (call min (. a1 y) (. a2 y)) tolerance))))
  (where
    (lazy a-left-of-b (< (call max (. a1 x) (. a2 x)) (- (call min (. b1 x) (. b2 x)) tolerance)))
    (lazy b-left-of-a (< (call max (. b1 x) (. b2 x)) (- (call min (. a1 x) (. a2 x)) tolerance)))
    (lazy a-above-b (< (call max (. a1 y) (. a2 y)) (- (call min (. b1 y) (. b2 y)) tolerance)))
  )
)

(type _ Crossing
  (prop + i Index)
  (prop + t PointOnCurve)
  (prop + pt Point)
  (prop + next (? Crossing))
  (prop + previous (? Crossing))
  (prop + counter (? Crossing))
  (prop + visited _ (= false))
  (fn-do + This _
    (param crossing-i Index)
    (param crossing-t PointOnCurve)
    (param crossing-pt Point)
    (= i crossing-i)
    (= t crossing-t)
    (= pt crossing-pt)
  )
)

(fn-do _ find-next-crossing _
  (param first-crossing Crossing)
  (let crossing first-crossing)
  (while true
    (if (not (. crossing visited))
      (return crossing)
      (else
        (= crossing (!! (. crossing next)))
      )
    )
    (if (== crossing first-crossing)
      (break)
    )
  )
)

(fn-do _ step _
  (param i Index)
  (param incr Index)
  (param i-max Index)
  (let result (+ i incr))
  (if (< result 0)
    (= result (+ i-max result 1))
    (else-if (> result i-max)
      (= result 0)
    )
  )
  (blank)
  (return result)
)

; Credit: http://stackoverflow.com/questions/2049582/how-to-determine-a-point-in-a-triangle
(fn-expr _ point-in-triangle _
  (param p Point)
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  ; XXXjoe This was originally 0 instead of TOLERANCE, but that often failed me
  (blank)
  (and (> s tolerance) (> t tolerance) (< (+ s t) (* 2 a sign)))
  (where
    (lazy a (+ (* (/ 1 2) (+ (* (- (. p1 y)) (. p2 x)) (. p0 y)) (+ (- (. p1 x)) (. p2 x))) (* (. p0 x) (- (. p1 y) (. p2 y))) (* (. p1 x) (. p2 y))))
    (lazy sign (if-expr (< a 0) -1 1))
    (lazy s (* (+ (- (* (. p0 y) (. p2 x)) (* (. p0 x) (. p2 y))) (* (- (. p2 y) (. p0 y)) (. p x)) (* (- (. p0 x) (. p2 x)) (. p y))) sign))
    (lazy t (* (+ (- (* (. p0 x) (. p1 y)) (* (. p0 y) (. p1 x))) (* (- (. p0 y) (. p1 y)) (. p x)) (* (- (. p1 x) (. p0 x)) (. p y))) sign))
  )
)
