+ summary U64

━━━━━━━━━━━━━━━━━━━━
+ vector-document-optional-alignment
    - value StrokeAlignment?

match value
    |= null
        0u8
    |= StrokeAlignment.center
        1u8
    |= StrokeAlignment.inside
        2u8
    ??
        3u8

━━━━━━━━━━━━━━━━━━━━
+ vector-document-alignment
    - value U8

match? value
    |= 1
        StrokeAlignment.center
    |= 2
        StrokeAlignment.inside
    |= 3
        StrokeAlignment.outside

━━━━━━━━━━━━━━━━━━━━
+ vector-document-optional-cap
    - value LineCap?

match value
    |= null
        0u8
    |= LineCap.butt
        1u8
    |= LineCap.round
        2u8
    ??
        3u8

━━━━━━━━━━━━━━━━━━━━
+ vector-document-cap
    - value U8

match? value
    |= 1
        LineCap.butt
    |= 2
        LineCap.round
    |= 3
        LineCap.square

━━━━━━━━━━━━━━━━━━━━
+ vector-document-optional-join
    - value LineJoin?

match value
    |= null
        0u8
    |= LineJoin.miter
        1u8
    |= LineJoin.round
        2u8
    ??
        3u8

━━━━━━━━━━━━━━━━━━━━
+ vector-document-join
    - value U8

match? value
    |= 1
        LineJoin.miter
    |= 2
        LineJoin.round
    |= 3
        LineJoin.bevel

━━━━━━━━━━━━━━━━━━━━
+ vector-document-optional-fill-rule
    - value FillRule?

match value
    |= null
        0u8
    |= FillRule.nonzero
        1u8
    ??
        2u8

━━━━━━━━━━━━━━━━━━━━
+ vector-document-fill-rule
    - value U8

match? value
    |= 1
        FillRule.nonzero
    |= 2
        FillRule.even-odd

━━━━━━━━━━━━━━━━━━━━
+ vector-document-join-type-code
    - value JoinType

match value
    |= JoinType.bevel-join-type
        0u8
    |= JoinType.square-join-type
        1u8
    |= JoinType.miter-join-type
        2u8
    ??
        3u8

━━━━━━━━━━━━━━━━━━━━
+ vector-document-join-type
    - value U8

match value
    |= 0
        JoinType.bevel-join-type
    |= 1
        JoinType.square-join-type
    |= 2
        JoinType.miter-join-type
    ??
        JoinType.round-join-type
