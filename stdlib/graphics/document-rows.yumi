./boolean
./color
./matrix
./path
./point
./primitives
./stroke

+ vector-document-locked U8 = 1
+ vector-document-hidden U8 = 2
+ vector-document-guide U8 = 4
+ vector-document-has-pivot U8 = 8

+ vector-document-authored-opacity U8 = 1
+ vector-document-authored-visible U8 = 2
+ vector-document-authored-transform U8 = 4
+ vector-document-authored-effects U8 = 8

+ vector-document-authored-fill U8 = 1
+ vector-document-authored-stroke U8 = 2
+ vector-document-authored-stroke-width U8 = 4
+ vector-document-authored-stroke-alignment U8 = 8
+ vector-document-authored-stroke-cap U8 = 16
+ vector-document-authored-stroke-join U8 = 32
+ vector-document-authored-fill-rule U8 = 64

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentNodeKind is U8

| free-node = 0
| group-node = 1
| network-node = 2
| image-node = 3

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentGroupKind is U8

| plain-group = 0
| script-group = 1
| embed-group = 2

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentFillKind is U8

| fill-inherit = 0
| fill-none = 1
| fill-from-stroke = 2
| fill-color = 3
| fill-stack = 4

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentStrokeKind is U8

| stroke-inherit = 0
| stroke-none = 1
| stroke-color = 2
| stroke-stack = 3

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentEffectKind is U8

| boolean-effect = 0
| offset-effect = 1
| stroke-effect = 2

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentValueKind is U8

| number-value = 0
| point-value = 1
| color-value = 2
| text-value = 3
| node-value = 4
| nodes-value = 5
| node-item = 6
| values-value = 7

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentExtent is Struct

+ start U32
+ count U32
+ capacity U32

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentNode is Struct

+ id U64
+ stamp U64
+ geometry-stamp U64
+ paint-stamp U64
+ effects-stamp U64
+ kind VectorDocumentNodeKind
+ group-kind VectorDocumentGroupKind
+ flags U8
+ composite-authored U8
+ parent U32
+ first-child U32
+ last-child U32
+ prev-sibling U32
+ next-sibling U32
+ name Atom
+ image Atom
+ opacity F64
+ transform Matrix
+ rotation F64
+ pivot Point
+ view-box Rect
+ geometry-bounds Rect
+ bounds-stale Bool
+ network-pending Bool
+ effects VectorDocumentExtent
+ effect-output U32
+ paint-authored U8
+ fill-kind VectorDocumentFillKind
+ stroke-kind VectorDocumentStrokeKind
+ fill-color RGBA
+ stroke-color RGBA
+ fill-layers VectorDocumentExtent
+ stroke-layers VectorDocumentExtent
+ stroke-width F64
+ has-stroke-width Bool
+ stroke-alignment U8
+ stroke-cap U8
+ stroke-join U8
+ fill-rule U8
+ vertices VectorDocumentExtent
+ segments VectorDocumentExtent
+ pairs VectorDocumentExtent
+ regions VectorDocumentExtent
+ next-vertex U64
+ next-segment U64
+ settings VectorDocumentExtent
+ variables VectorDocumentExtent
+ values-stamp U64

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentVertex is Struct

+ id U64
+ position Point

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentSegment is Struct

+ id U64
+ start U64
+ end U64
+ tangent-start Point
+ tangent-end Point
+ source U64
+ source-start F64
+ source-end F64

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentPair is Struct

+ first-segment U64
+ first-at-end Bool
+ second-segment U64
+ second-at-end Bool
+ mirror-length Bool

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentRegionFill is Struct

+ region U64
+ has-fill Bool
