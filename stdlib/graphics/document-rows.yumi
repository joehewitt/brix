+ color RGBA
+ visible Bool
+ width F64
+ has-width Bool
+ alignment U8
+ join U8
+ cap U8

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentEffect is Struct

+ kind VectorDocumentEffectKind
+ enabled Bool
+ mode BooleanEffectMode
+ distance F64
+ join-type U8
+ miter-limit F64
+ cap U8

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentValueRow is Struct

+ key Atom
+ kind VectorDocumentValueKind
+ x F64
+ y F64
+ color RGBA
+ text Atom
+ id U64
+ count U32

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentEffectOutput is Struct

+ owner U32
+ input-key U64
+ paths VectorDocumentExtent

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentOutputPath is Struct

+ verbs VectorDocumentExtent
+ coords VectorDocumentExtent
+ closed Bool

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentPathVerb is Struct

+ verb PathVerb

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentPathCoord is Struct

+ value F64

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentIdSlot is Struct

+ id U64
+ row U32

━━━━━━━━━━━━━━━━━━━━
