  (fn-do + get-control-projection-bounds _
    (param line-ux Coord)
    (param line-uy Coord)
    (for (in bounds control-projection-bounds-cache)
      (if (and (< (call abs (- (. bounds line-ux) line-ux)) tolerance-tight) uy-matches)
        (return bounds)
      )
      (lazy uy-matches (< (call abs (- (. bounds line-uy) line-uy)) tolerance-tight))
    )
    (blank)
    (let min-side Coord)
    (let max-side Coord)
    (let min-proj Coord)
    (let max-proj Coord)
    (let waiting-for-first true)
    (blank)
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (blank)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (let x1 Coord)
      (let y1 Coord)
      (let hox Coord)
      (let hoy Coord)
      (let hix Coord)
      (let hiy Coord)
      (let x2 Coord)
      (let y2 Coord)
      (let has-curve false)
      (blank)
      (if (== verb .path-verb-move)
        (= current-x ([] coords start))
        (= current-y ([] coords (+ start 1)))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (else-if (and (== verb .path-verb-line) has-current)
          (= x1 current-x)
          (= y1 current-y)
          (= x2 ([] coords start))
          (= y2 ([] coords (+ start 1)))
          (= hox x1)
          (= hoy y1)
          (= hix x2)
          (= hiy y2)
          (= current-x x2)
          (= current-y y2)
          (= has-curve true)
        )
        (else-if (and (== verb .path-verb-cubic) has-current)
          (= x1 current-x)
          (= y1 current-y)
          (= hox ([] coords start))
          (= hoy ([] coords (+ start 1)))
          (= hix ([] coords (+ start 2)))
          (= hiy ([] coords (+ start 3)))
          (= x2 ([] coords (+ start 4)))
          (= y2 ([] coords (+ start 5)))
          (= current-x x2)
          (= current-y y2)
          (= has-curve true)
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (= x1 current-x)
            (= y1 current-y)
            (= x2 subpath-x)
            (= y2 subpath-y)
            (= hox x1)
            (= hoy y1)
            (= hix x2)
            (= hiy y2)
            (= has-curve true)
          )
          (= current-x subpath-x)
          (= current-y subpath-y)
        )
      )
      (blank)
      (if has-curve
        (for (in point-index (..< 0 4))
          (let x
            (block
              (case? (== point-index 0)
                x1
              )
              (case? (== point-index 1)
                hox
              )
              (case? (== point-index 2)
                hix
              )
              (default
                x2
              )
            )
          )
          (let y
            (block
              (case? (== point-index 0)
                y1
              )
              (case? (== point-index 1)
                hoy
              )
              (case? (== point-index 2)
                hiy
              )
              (default
                y2
              )
            )
          )
          (let side (- (* x line-uy) (* y line-ux)))
          (let proj (+ (* x line-ux) (* y line-uy)))
          (blank)
          (if waiting-for-first
            (= min-side side)
            (= max-side side)
            (= min-proj proj)
            (= max-proj proj)
            (= waiting-for-first false)
            (else
              (if (< side min-side)
                (= min-side side)
              )
              (if (> side max-side)
                (= max-side side)
              )
              (if (< proj min-proj)
                (= min-proj proj)
              )
              (if (> proj max-proj)
                (= max-proj proj)
              )
            )
          )
        )
      )
    )
    (blank)
    (let bounds (call ControlProjectionBounds line-ux line-uy min-side max-side min-proj max-proj))
    (+= control-projection-bounds-cache bounds)
    (return bounds)
  )
  (fn-do + close _
    (probe-count graphics.path.close.calls)
    (if (and (> command-count 1) (!= ([] verbs (- command-count 1)) .path-verb-close))
      (= is-closed true)
      (call append-command .path-verb-close 0)
    )
  )
  (fn-do + reopen _
    (if is-closed
      (= is-closed false)
      (if (and command-count (== ([] verbs (- command-count 1)) .path-verb-close))
        (-= command-count 1)
        (= coord-count ([] coord-offsets command-count))
        (= ([] coord-offsets command-count) coord-count)
        (call mark-mutated)
      )
    )
  )
  (fn-do + move-to _
    (param point Point)
    (call move-to (. point x) (. point y))
