(import ./canvas)
(import ./curve)
(import ./curve-kernels)
(import ./intersection)
(import ./matrix)
(import ./point)
(import ./primitives)
(import ./utils)
(import /math)
(import /stream/coincidence)
(import /stream/combine)

(type + Path
  (prop + is-closed _ (= false))
  (prop + matrix (? Matrix))
  (blank)
  (prop _ verbs _ (= ([] PathVerb 0)))
  (prop _ coord-offsets _ (= ([] Index 1)))
  (prop _ coords _ (= ([] Coord 0)))
  (prop _ command-count Size)
  (prop _ coord-count Size)
  (prop _ path-revision Size)
  (prop _ mutation-depth Size)
  (prop _ has-pending-mutation _ (= false))
  (prop _ point-table (? (list PointDistance)))
  (prop _ computed-length Length)
  (prop _ control-projection-bounds-cache (list ControlProjectionBounds))
  (prop _ control-bounding-box-cache (? Rect))
  (prop _ leading-curves (? Size))
  (prop _ curve-commands (? (list Index)))
  (fn-do + This _
    (param path Path)
    (call reserve (. path command-count) (. path coord-count))
    (= command-count (. path command-count))
    (= coord-count (. path coord-count))
    (= path-revision (. path path-revision))
    (= is-closed (. path is-closed))
    (= matrix (. path matrix))
    (blank)
    (for (in i (..< 0 command-count))
      (= ([] verbs i) ([] (. path verbs) i))
    )
    (blank)
    (for (in i (..< 0 (+ command-count 1)))
      (= ([] coord-offsets i) ([] (. path coord-offsets) i))
    )
    (blank)
    (for (in i (..< 0 coord-count))
      (= ([] coords i) ([] (. path coords) i))
    )
  )
  (fn-do + This _
    (param points (list Point))
    (call reserve (. points length) (* (. points length) 2))
    (call move-to ([] points 0))
    (for (in i (..< 1 (. points length)))
      (call line-to ([] points i))
    )
  )
  (fn-expr + revision Size :get
    path-revision
  )
  (fn-expr + count Size :get
    command-count
  )
  (fn-expr + coord-size Size :get
    coord-count
  )
  (fn-expr + command-capacity Size :get
    (. verbs size)
  )
  (fn-expr + coord-capacity Size :get
    (. coords size)
  )
  (fn-do + curve-count _ :get
    (let count Size)
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (if (== verb .path-verb-move)
        (= current-x ([] coords start))
        (= current-y ([] coords (+ start 1)))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (else-if (and (== verb .path-verb-line) has-current)
          (= current-x ([] coords start))
          (= current-y ([] coords (+ start 1)))
          (+= count 1)
        )
        (else-if (and (== verb .path-verb-cubic) has-current)
          (= current-x ([] coords (+ start 4)))
          (= current-y ([] coords (+ start 5)))
          (+= count 1)
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (+= count 1)
          )
          (= current-x subpath-x)
          (= current-y subpath-y)
        )
      )
    )
    (return count)
  )
  (fn-expr + commands _ :get
    (call PathCommandSpan verbs coord-offsets coords command-count coord-count path-revision)
  )
  (fn-expr + command-reader _ :get
    (call PathCommandReader commands)
  )
  (fn-expr + curve-reader _ :get
    (call PathCurveReader commands)
  )
  (fn-do + length _ :get
    (probe-count graphics.path.length.calls)
    (if (not point-table)
      (call compute-point-table)
    )
    (blank)
    (return (. ([] (!! point-table) (. Position last)) length))
  )
  (fn-expr + first-point _ :get
    (call Point ([] coords 0) ([] coords 1))
  )
  (fn-expr + last-point _ :get
    (call last-anchor)
  )
  (fn-do + paths _ :get
    (for (in subpath subpaths)
      (yield (call (. subpath materialize)))
    )
  )
  (fn-do + subpaths _ :get
    (let span commands)
    (let subpath-start Index)
    (let subpath-curves Size)
    (let subpath-closed false)
    (let has-subpath false)
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (blank)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (blank)
      (if (== verb .path-verb-move)
        (if has-subpath
          (yield (call PathSubpathSpan span subpath-start i subpath-curves subpath-closed))
        )
        (blank)
        (= subpath-start i)
        (= subpath-curves 0)
        (= subpath-closed false)
        (= current-x ([] coords start))
        (= current-y ([] coords (+ start 1)))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (= has-subpath true)
        (else-if (and (== verb .path-verb-line) has-current)
          (= current-x ([] coords start))
          (= current-y ([] coords (+ start 1)))
          (+= subpath-curves 1)
        )
        (else-if (and (== verb .path-verb-cubic) has-current)
          (= current-x ([] coords (+ start 4)))
          (= current-y ([] coords (+ start 5)))
          (+= subpath-curves 1)
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (+= subpath-curves 1)
          )
          (= current-x subpath-x)
          (= current-y subpath-y)
          (= subpath-closed true)
        )
      )
    )
    (blank)
    (if has-subpath
      (yield (call PathSubpathSpan span subpath-start command-count subpath-curves subpath-closed))
    )
  )
  (fn-expr + curves _ :get
    (call get-curves false)
  )
  (fn-do + is-clockwise _ :get
    (let area Length)
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (if (== verb .path-verb-move)
        (= current-x ([] coords start))
        (= current-y ([] coords (+ start 1)))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (else-if (and (== verb .path-verb-line) has-current)
          (let x2 ([] coords start))
          (let y2 ([] coords (+ start 1)))
          (+= area (- (* x2 current-y) (* current-x y2)))
          (= current-x x2)
          (= current-y y2)
        )
        (else-if (and (== verb .path-verb-cubic) has-current)
          (let hox ([] coords start))
          (let hoy ([] coords (+ start 1)))
          (let hix ([] coords (+ start 2)))
          (let hiy ([] coords (+ start 3)))
          (let x2 ([] coords (+ start 4)))
          (let y2 ([] coords (+ start 5)))
          (let out-cross (- (* current-x hoy) (* hox current-y)))
          (-= area (+ (* 0.6 out-cross) (* 0.3 (- (* current-x hiy) (* hix current-y)))))
          (-= area (+ (* 0.1 (- (* current-x y2) (* x2 current-y))) (* 0.3 (- (* hox hiy) (* hix hoy)))))
          (-= area (+ (* 0.3 (- (* hox y2) (* x2 hoy))) (* 0.6 (- (* hix y2) (* x2 hiy)))))
          (= current-x x2)
          (= current-y y2)
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (+= area (- (* subpath-x current-y) (* current-x subpath-y)))
          )
          (= current-x subpath-x)
          (= current-y subpath-y)
        )
      )
    )
    (blank)
    (return (< area 0))
  )
  (fn-expr + bounding-box _ :get
    (call bounding-box-under null)
  )
  (fn-do + closed-curves (list Curve) :get
    (let result (list Curve))
    (for (in subpath subpaths)
      (let material (call (. subpath materialize)))
      (if (not (. material is-closed))
        (call (. material close))
      )
      (for (in curve (. material curves))
        (+= result curve)
      )
    )
    (return result)
  )
  (fn-do _ is-line-polygon _ :get
    (return-if (if (not is-closed)))
    (return-if (if (< command-count 4)))
    (blank)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (return-if (if (== verb .path-verb-cubic)))
      (return-if (if (and (== verb .path-verb-move) (!= i 0))))
    )
    (blank)
    (return true)
  )
  (fn-do + (infix this + (param other Path)) _
    (let clone (call Path this))
    (call (. clone add-path) other)
    (return clone)
  )
  (fn-do + append-subpath-spans _
    (param out (list PathSubpathSpan))
    (let span commands)
    (let subpath-start Index)
    (let subpath-curves Size)
    (let subpath-closed false)
    (let has-subpath false)
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (blank)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (blank)
      (if (== verb .path-verb-move)
        (if has-subpath
          (+= out (call PathSubpathSpan span subpath-start i subpath-curves subpath-closed))
        )
        (blank)
        (= subpath-start i)
        (= subpath-curves 0)
        (= subpath-closed false)
        (= current-x ([] coords start))
        (= current-y ([] coords (+ start 1)))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (= has-subpath true)
        (else-if (and (== verb .path-verb-line) has-current)
          (= current-x ([] coords start))
          (= current-y ([] coords (+ start 1)))
          (+= subpath-curves 1)
        )
        (else-if (and (== verb .path-verb-cubic) has-current)
          (= current-x ([] coords (+ start 4)))
          (= current-y ([] coords (+ start 5)))
          (+= subpath-curves 1)
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (+= subpath-curves 1)
          )
          (= current-x subpath-x)
          (= current-y subpath-y)
          (= subpath-closed true)
        )
      )
    )
    (blank)
    (if has-subpath
      (+= out (call PathSubpathSpan span subpath-start command-count subpath-curves subpath-closed))
    )
  )
  (fn-do + bounding-box-under _
    (param transform (? Matrix))
    (probe-count graphics.path.bounding-box.paths)
    (let min-x Coord 0)
    (let min-y Coord 0)
    (let max-x Coord 0)
    (let max-y Coord 0)
    (let waiting-for-first true)
    (blank)
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (blank)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (blank)
      (if (== verb .path-verb-move)
        (let point (call bounds-point start transform))
        (= current-x (. point x))
        (= current-y (. point y))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (else-if (and (== verb .path-verb-line) has-current)
          (let point (call bounds-point start transform))
          (let x2 (. point x))
          (let y2 (. point y))
          (let bounds-x (call get-line-coord-bounds current-x x2))
          (let bounds-y (call get-line-coord-bounds current-y y2))
          (if waiting-for-first
            (= min-x (. bounds-x min))
            (= min-y (. bounds-y min))
            (= max-x (. bounds-x max))
            (= max-y (. bounds-y max))
            (= waiting-for-first false)
            (else
              (if (< (. bounds-x min) min-x)
                (= min-x (. bounds-x min))
              )
              (if (< (. bounds-y min) min-y)
                (= min-y (. bounds-y min))
              )
              (if (> (. bounds-x max) max-x)
                (= max-x (. bounds-x max))
              )
              (if (> (. bounds-y max) max-y)
                (= max-y (. bounds-y max))
              )
            )
          )
          (blank)
          (= current-x x2)
          (= current-y y2)
        )
        (else-if (and (== verb .path-verb-cubic) has-current)
          (let outgoing (call bounds-point start transform))
          (let incoming (call bounds-point (+ start 2) transform))
          (let end (call bounds-point (+ start 4) transform))
          (let hox (. outgoing x))
          (let hoy (. outgoing y))
          (let hix (. incoming x))
          (let hiy (. incoming y))
          (let x2 (. end x))
          (let y2 (. end y))
          (let bounds-x (call get-curve-coord-bounds current-x hox hix x2))
          (let bounds-y (call get-curve-coord-bounds current-y hoy hiy y2))
          (if waiting-for-first
            (= min-x (. bounds-x min))
            (= min-y (. bounds-y min))
            (= max-x (. bounds-x max))
            (= max-y (. bounds-y max))
            (= waiting-for-first false)
            (else
              (if (< (. bounds-x min) min-x)
                (= min-x (. bounds-x min))
              )
              (if (< (. bounds-y min) min-y)
                (= min-y (. bounds-y min))
              )
              (if (> (. bounds-x max) max-x)
                (= max-x (. bounds-x max))
              )
              (if (> (. bounds-y max) max-y)
                (= max-y (. bounds-y max))
              )
            )
          )
          (blank)
          (= current-x x2)
          (= current-y y2)
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (let bounds-x (call get-line-coord-bounds current-x subpath-x))
            (let bounds-y (call get-line-coord-bounds current-y subpath-y))
            (if waiting-for-first
              (= min-x (. bounds-x min))
              (= min-y (. bounds-y min))
              (= max-x (. bounds-x max))
              (= max-y (. bounds-y max))
              (= waiting-for-first false)
              (else
                (if (< (. bounds-x min) min-x)
                  (= min-x (. bounds-x min))
                )
                (if (< (. bounds-y min) min-y)
                  (= min-y (. bounds-y min))
                )
                (if (> (. bounds-x max) max-x)
                  (= max-x (. bounds-x max))
                )
                (if (> (. bounds-y max) max-y)
                  (= max-y (. bounds-y max))
                )
              )
            )
            (blank)
            (= current-x subpath-x)
            (= current-y subpath-y)
          )
        )
      )
    )
    (blank)
    (return (call Rect min-x min-y (- max-x min-x) (- max-y min-y)))
  )
  (fn-do + reserve _
    (param command-capacity Size)
    (param coord-capacity Size)
    (if (> command-capacity (. verbs size))
      (= verbs (call (. verbs resize) command-capacity))
    )
    (blank)
    (if (> (+ command-capacity 1) (. coord-offsets size))
      (= coord-offsets (call (. coord-offsets resize) (+ command-capacity 1)))
    )
    (blank)
    (if (> coord-capacity (. coords size))
      (= coords (call (. coords resize) coord-capacity))
    )
    (blank)
    (= ([] coord-offsets command-count) coord-count)
  )
  (fn-do + clear _
    (= command-count 0)
    (= coord-count 0)
    (= ([] coord-offsets 0) 0)
    (= is-closed false)
    (= matrix null)
    (= point-table null)
    (call (. control-projection-bounds-cache clear))
    (= control-bounding-box-cache null)
    (call mark-mutated)
  )
  (fn-do + trim _
    (if (< command-count (. verbs size))
      (= verbs (call (. verbs resize) command-count))
    )
    (if (< (+ command-count 1) (. coord-offsets size))
      (= coord-offsets (call (. coord-offsets resize) (+ command-count 1)))
    )
    (if (< coord-count (. coords size))
      (= coords (call (. coords resize) coord-count))
    )
    (call (. control-projection-bounds-cache trim))
  )
  (fn-do + release _
    (call clear)
    (= verbs (call (. verbs resize) 0))
    (= coord-offsets (call (. coord-offsets resize) 1))
    (= coords (call (. coords resize) 0))
    (call (. control-projection-bounds-cache release))
  )
  (fn-do + get-curves _
    (param with-closer _ (= false))
    (let reader curve-reader)
    (while (call (. reader next))
      (yield (. reader curve))
    )
    (blank)
    (if (and with-closer (not is-closed) (> command-count 1))
      (let first first-point)
      (let last last-point)
      (yield (call Curve last last first first .segment-type-line))
    )
  )
  (fn-expr + materialize-curves (list Curve)
    (in each (call get-curves))
  )
  (fn-do + materialize-segments _
    (let segments (list PathSegment))
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (blank)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (blank)
      (if (== verb .path-verb-move)
        (= current-x ([] coords start))
        (= current-y ([] coords (+ start 1)))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (+= segments (tuple .segment-type-move (tuple current-x current-y) (tuple current-x current-y) (tuple current-x current-y)))
        (= has-current true)
        (else-if (== verb .path-verb-line)
          (= current-x ([] coords start))
          (= current-y ([] coords (+ start 1)))
          (+= segments (tuple .segment-type-line (tuple current-x current-y) (tuple current-x current-y) (tuple current-x current-y)))
        )
        (else-if (== verb .path-verb-cubic)
          (let hox ([] coords start))
          (let hoy ([] coords (+ start 1)))
          (let hix ([] coords (+ start 2)))
          (let hiy ([] coords (+ start 3)))
          (= current-x ([] coords (+ start 4)))
          (= current-y ([] coords (+ start 5)))
          (if segments
            (= ([] segments (. Position last)) (= (. ([] segments (. Position last)) handle-out) (tuple hox hoy)))
          )
          (+= segments (tuple .segment-type-cubic (tuple current-x current-y) (tuple hix hiy) (tuple current-x current-y)))
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (+= segments (tuple .segment-type-line (tuple subpath-x subpath-y) (tuple subpath-x subpath-y) (tuple subpath-x subpath-y)))
          )
          (= current-x subpath-x)
          (= current-y subpath-y)
        )
      )
    )
    (blank)
    (return segments)
  )
  (fn-do + trace _
    (param sink PathTraceSink)
    (let reader command-reader)
    (while (call (. reader next))
      (if (== (. reader verb) .path-verb-move)
        (call (. sink move) (call (. reader coord) 0) (call (. reader coord) 1))
        (else-if (== (. reader verb) .path-verb-line)
          (call (. sink line) (call (. reader coord) 0) (call (. reader coord) 1))
        )
        (else-if (== (. reader verb) .path-verb-cubic)
          (call (. sink cubic)
            (block
              (arg (call (. reader coord) 0))
              (arg (call (. reader coord) 1))
              (arg (call (. reader coord) 2))
              (arg (call (. reader coord) 3))
              (arg (call (. reader coord) 4))
              (arg (call (. reader coord) 5))
            )
          )
        )
        (else-if (== (. reader verb) .path-verb-close)
          (call (. sink close))
        )
      )
    )
  )
  (fn-do + get-curve-bounding-box _
    (param index Index)
    (probe-count graphics.path.bounding-box.curves)
    (let command-index (+ index 1))
    (if (< command-index command-count)
      (let verb ([] verbs command-index))
      (let prev-index (- command-index 1))
      (let prev-verb ([] verbs prev-index))
      (let prev-start ([] coord-offsets prev-index))
      (let x1 Coord)
      (let y1 Coord)
      (let has-prev false)
      (blank)
      (if (or (== prev-verb .path-verb-move) (== prev-verb .path-verb-line))
        (= x1 ([] coords prev-start))
        (= y1 ([] coords (+ prev-start 1)))
        (= has-prev true)
        (else-if (== prev-verb .path-verb-cubic)
          (= x1 ([] coords (+ prev-start 4)))
          (= y1 ([] coords (+ prev-start 5)))
          (= has-prev true)
        )
      )
      (blank)
      (if has-prev
        (let start ([] coord-offsets command-index))
        (if (== verb .path-verb-line)
          (let x2 ([] coords start))
          (let y2 ([] coords (+ start 1)))
          (let bounds-x (call get-line-coord-bounds x1 x2))
          (let bounds-y (call get-line-coord-bounds y1 y2))
          (return
            (call Rect
              (block
                (arg (. bounds-x min))
                (arg (. bounds-y min))
                (arg (- (. bounds-x max) (. bounds-x min)))
                (arg (- (. bounds-y max) (. bounds-y min)))
              )
            )
          )
          (else-if (== verb .path-verb-cubic)
            (let hox ([] coords start))
            (let hoy ([] coords (+ start 1)))
            (let hix ([] coords (+ start 2)))
            (let hiy ([] coords (+ start 3)))
            (let x2 ([] coords (+ start 4)))
            (let y2 ([] coords (+ start 5)))
            (let bounds-x (call get-curve-coord-bounds x1 hox hix x2))
            (let bounds-y (call get-curve-coord-bounds y1 hoy hiy y2))
            (return
              (call Rect
                (block
                  (arg (. bounds-x min))
                  (arg (. bounds-y min))
                  (arg (- (. bounds-x max) (. bounds-x min)))
                  (arg (- (. bounds-y max) (. bounds-y min)))
                )
              )
            )
          )
        )
      )
    )
    (blank)
    (let curve (call get-curve-scalars index))
    (if (. curve found)
      (let bounds-x
        (block
          (case? (== (. curve type) .segment-type-line)
            (call get-line-coord-bounds (. curve x1) (. curve x2))
          )
          (default
            (call get-curve-coord-bounds (. curve x1) (. curve hox) (. curve hix) (. curve x2))
          )
        )
      )
      (let bounds-y
        (block
          (case? (== (. curve type) .segment-type-line)
            (call get-line-coord-bounds (. curve y1) (. curve y2))
          )
          (default
            (call get-curve-coord-bounds (. curve y1) (. curve hoy) (. curve hiy) (. curve y2))
          )
        )
      )
      (return (call Rect (. bounds-x min) (. bounds-y min) (- (. bounds-x max) (. bounds-x min)) (- (. bounds-y max) (. bounds-y min))))
    )
