    (call ensure-coord-capacity (+ coord-count (. span coord-count)))
    (blank)
    (call begin-mutation)
    (for (in i (..< 0 (. span command-count)))
      (let verb ([] (. span verbs) i))
      (let start ([] (. span coord-offsets) i))
      (if (== verb .path-verb-move)
        (call move-to ([] (. span coords) start) ([] (. span coords) (+ start 1)))
        (else-if (== verb .path-verb-line)
          (call line-to ([] (. span coords) start) ([] (. span coords) (+ start 1)))
        )
        (else-if (== verb .path-verb-cubic)
          (call cubic-curve-to
            (block
              (arg ([] (. span coords) start))
              (arg ([] (. span coords) (+ start 1)))
              (arg ([] (. span coords) (+ start 2)))
              (arg ([] (. span coords) (+ start 3)))
              (arg ([] (. span coords) (+ start 4)))
              (arg ([] (. span coords) (+ start 5)))
            )
          )
        )
        (else-if (== verb .path-verb-close)
          (call close)
        )
      )
    )
    (call end-mutation)
  )
  (fn-do + add-path-reverse _
    (param source Path)
    (let total-curves (. source curve-count))
    (return-if (if (not total-curves)))
    (blank)
    (let has-close-edge false)
    (let found-last-curve false)
    (let command-index (. source command-count))
    (while (> command-index 0)
      (-= command-index 1)
      (let curve (call (. source get-command-curve-scalars) command-index))
      (if (. curve found)
        (= has-close-edge (. curve is-close))
        (= found-last-curve true)
        (break)
      )
    )
    (blank)
    (let should-skip-first-curve (and (. source is-closed) found-last-curve has-close-edge))
    (let remaining-curves total-curves)
    (let did-start false)
    (call reserve (+ count (. source count)) (+ coord-size (. source coord-size)))
    (call begin-mutation)
    (= command-index (. source command-count))
    (while (> command-index 0)
      (-= command-index 1)
      (let curve (call (. source get-command-curve-scalars) command-index))
      (if (not (. curve found))
        (continue)
      )
      (blank)
      (-= remaining-curves 1)
      (if (and should-skip-first-curve (== remaining-curves 0))
        (continue)
      )
      (if (not did-start)
        (call move-to (. curve x2) (. curve y2))
      )
      (if (== (. curve type) .segment-type-line)
        (call line-to (. curve x1) (. curve y1))
        (else
          (call cubic-curve-to (. curve hix) (. curve hiy) (. curve hox) (. curve hoy) (. curve x1) (. curve y1))
        )
      )
      (= did-start true)
    )
    (blank)
    (if (and (. source is-closed) did-start)
      (call close)
    )
    (call end-mutation)
  )
  (fn-do + append-rectangle _
    (param rect Rect)
    (call reserve (+ count 5) (+ coord-size 8))
    (call move-to (. rect x) (. rect y))
    (call line-to (+ (. rect x) (. rect width)) (. rect y))
    (call line-to (+ (. rect x) (. rect width)) (+ (. rect y) (. rect height)))
    (call line-to (. rect x) (+ (. rect y) (. rect height)))
    (call close)
  )
  (fn-do + append-circle _
    (param center Point)
    (param radius Length)
    (let x (- (. center x) radius))
    (let y (- (. center y) radius))
    (let w (* radius 2))
    (let h (* radius 2))
    (let kappa 0.5522848)
    (let ox (* (/ w 2) kappa))
    (let oy (* (/ h 2) kappa))
    (let xe (+ x w))
    (let ye (+ y h))
    (let xm (+ x (/ w 2)))
    (let ym (+ y (/ h 2)))
    (blank)
    (call reserve (+ count 6) (+ coord-size 26))
    (call move-to x ym)
    (call cubic-curve-to x (- ym oy) (- xm ox) y xm y)
    (call cubic-curve-to (+ xm ox) y xe (- ym oy) xe ym)
    (call cubic-curve-to xe (+ ym oy) (+ xm ox) ye xm ye)
    (call cubic-curve-to (- xm ox) ye x (+ ym oy) x ym)
    (call close)
  )
  (fn-do + append-ellipse _
    (param center Point)
    (param radius Dimensions)
    (let x (- (. center x) (. radius width)))
    (let y (- (. center y) (. radius height)))
    (let w (* (. radius width) 2))
    (let h (* (. radius height) 2))
    (let magic 0.5522847498)
    (let ox (* (. radius width) magic))
    (let oy (* (. radius height) magic))
    (let xe (+ x w))
    (let ye (+ y h))
    (let xm (+ x (. radius width)))
    (let ym (+ y (. radius height)))
    (blank)
    (call reserve (+ count 6) (+ coord-size 26))
    (call move-to x ym)
    (call cubic-curve-to x (- ym oy) (- xm ox) y xm y)
    (call cubic-curve-to (+ xm ox) y xe (- ym oy) xe ym)
    (call cubic-curve-to xe (+ ym oy) (+ xm ox) ye xm ye)
    (call cubic-curve-to (- xm ox) ye x (+ ym oy) x ym)
    (call close)
  )
  (fn-do + add-curve _
    (param curve Curve)
    (call begin-mutation)
    (if (not curve-count)
      (call move-to (. curve anchor1 x) (. curve anchor1 y))
    )
    (blank)
    (if (== (. curve type) .segment-type-line)
      (call line-to (. curve anchor2 x) (. curve anchor2 y))
      (else
        (call cubic-curve-to
          (block
            (arg (. curve handle-out x))
            (arg (. curve handle-out y))
            (arg (. curve handle-in x))
            (arg (. curve handle-in y))
            (arg (. curve anchor2 x))
            (arg (. curve anchor2 y))
          )
        )
      )
    )
    (call end-mutation)
  )
  (fn-do + add-curve-reverse _
    (param curve Curve)
    (call begin-mutation)
    (if (not curve-count)
      (call move-to (. curve anchor2 x) (. curve anchor2 y))
    )
    (blank)
    (if (== (. curve type) .segment-type-line)
      (call line-to (. curve anchor1 x) (. curve anchor1 y))
      (else
        (call cubic-curve-to
          (block
            (arg (. curve handle-in x))
            (arg (. curve handle-in y))
            (arg (. curve handle-out x))
            (arg (. curve handle-out y))
            (arg (. curve anchor1 x))
            (arg (. curve anchor1 y))
          )
        )
      )
    )
    (call end-mutation)
  )
  (fn-do + add-curve _
    (param source Path)
    (param i Index)
    (call begin-mutation)
    (call append-indexed-curve source i)
    (call end-mutation)
  )
  (fn-do + add-curve-reverse _
    (param source Path)
    (param i Index)
    (call begin-mutation)
    (call append-indexed-curve-reverse source i)
    (call end-mutation)
  )
  (fn-do + add-curve-range _
    (param source Path)
    (param i Index)
    (param t1 PointOnCurve)
    (param t2 PointOnCurve)
    (call begin-mutation)
    (call append-indexed-curve-range source i t1 t2)
    (call end-mutation)
  )
  (fn-do + add-curve-range-reverse _
    (param source Path)
    (param i Index)
    (param t1 PointOnCurve)
    (param t2 PointOnCurve)
    (call begin-mutation)
    (call append-indexed-curve-range-reverse source i t1 t2)
    (call end-mutation)
  )
  (fn-do + split-at-point (tuple (: a (? Curve)) (: b (? Curve)))
    (param t PointOnCurve)
    (probe-count graphics.path.split-point.calls)
    (let i (as t Index))
    (-= t i)
    (blank)
    (let curve (call get-indexed-curve-scalars i))
    (if (not (. curve found))
      (throw (call OutOfBoundsError "Curve out of bounds"))
    )
    (blank)
    (if (== (. curve type) .segment-type-line)
      (if (== t 0)
        (let curve2
          (call path-curve-from-scalars
            (block
              (arg (. curve type))
              (arg (. curve x1))
              (arg (. curve y1))
              (arg (. curve hox))
              (arg (. curve hoy))
              (arg (. curve hix))
              (arg (. curve hiy))
              (arg (. curve x2))
              (arg (. curve y2))
            )
          )
        )
        (return (tuple null curve2))
        (else-if (== t 1)
          (let curve1
            (call path-curve-from-scalars
              (block
                (arg (. curve type))
                (arg (. curve x1))
                (arg (. curve y1))
                (arg (. curve hox))
                (arg (. curve hoy))
                (arg (. curve hix))
                (arg (. curve hiy))
                (arg (. curve x2))
                (arg (. curve y2))
              )
            )
          )
          (return (tuple curve1 null))
        )
        (else
          (let p-x (+ (. curve x1) (* (- (. curve x2) (. curve x1)) t)))
          (let p-y (+ (. curve y1) (* (- (. curve y2) (. curve y1)) t)))
          (let curve1
            (call path-curve-from-scalars
              (block
                (arg .segment-type-line)
                (arg (. curve x1))
                (arg (. curve y1))
                (arg (. curve x1))
                (arg (. curve y1))
                (arg p-x)
                (arg p-y)
                (arg p-x)
                (arg p-y)
              )
            )
          )
          (let curve2
            (call path-curve-from-scalars
              (block
                (arg .segment-type-line)
                (arg p-x)
                (arg p-y)
                (arg p-x)
                (arg p-y)
                (arg (. curve x2))
                (arg (. curve y2))
                (arg (. curve x2))
                (arg (. curve y2))
              )
            )
          )
          (return (tuple curve1 curve2))
        )
      )
      (else
        (let tt (- 1 t))
        (blank)
        (let p1-x (+ (* tt (. curve x1)) (* t (. curve hox))))
        (let p1-y (+ (* tt (. curve y1)) (* t (. curve hoy))))
        (let p2-x (+ (* tt (. curve hox)) (* t (. curve hix))))
        (let p2-y (+ (* tt (. curve hoy)) (* t (. curve hiy))))
        (let p3-x (+ (* tt (. curve hix)) (* t (. curve x2))))
        (let p3-y (+ (* tt (. curve hiy)) (* t (. curve y2))))
        (blank)
        ; interpolate from 4 to 3 points
        (let p4-x (+ (* tt p1-x) (* t p2-x)))
        (let p4-y (+ (* tt p1-y) (* t p2-y)))
        (let p5-x (+ (* tt p2-x) (* t p3-x)))
        (let p5-y (+ (* tt p2-y) (* t p3-y)))
        (blank)
        ; interpolate from 2 points to 1 point
        (let p6-x (+ (* tt p4-x) (* t p5-x)))
        (let p6-y (+ (* tt p4-y) (* t p5-y)))
        (blank)
        (let curve1
          (call path-curve-from-scalars
            (block
              (arg .segment-type-cubic)
              (arg (. curve x1))
              (arg (. curve y1))
              (arg p1-x)
              (arg p1-y)
              (arg p4-x)
              (arg p4-y)
              (arg p6-x)
              (arg p6-y)
            )
          )
        )
        (let curve2
          (call path-curve-from-scalars
            (block
              (arg .segment-type-cubic)
              (arg p6-x)
              (arg p6-y)
              (arg p5-x)
              (arg p5-y)
              (arg p3-x)
              (arg p3-y)
              (arg (. curve x2))
              (arg (. curve y2))
            )
          )
        )
        (return (tuple curve1 curve2))
      )
    )
  )
  (fn-do + split-at-range Path
    (param t1 PointOnCurve)
    (param t2 PointOnCurve)
    (param is-reverse _ (= false))
    (probe-count graphics.path.split-range.calls)
    (= t1 (call constrain-parameter t1))
    (= t2 (call constrain-parameter t2))
    (blank)
    (let path (call Path))
    (call (. path reserve) command-count coord-count)
    (call (. path begin-mutation))
    (let appended-curves Size)
    (blank)
    (let i1 (as (call floor t1) I64))
    (let tt1 (- t1 i1))
    (let i2 (as (call floor t2) I64))
    (let tt2 (- t2 i2))
    (if is-reverse
      (let may-wrap (< t1 t2))
      (if (and (== i1 i2) (not may-wrap))
        (+= appended-curves (call (. path append-indexed-curve-range) this i1 tt2 tt1))
        (else
          (if tt1
            (+= appended-curves (call (. path append-indexed-curve-range) this i1 0 tt1))
          )
          (blank)
          (if (not tt2)
            (-= i2 1)
          )
          (blank)
          (if may-wrap
            (let max I64 curve-count)
            (for (in i (.. (- i1 1) 0 (by: -1)))
              (+= appended-curves (call (. path append-indexed-curve) this i))
            )
            (for (in i (..< (- max 1) i2 (by: -1)))
              (+= appended-curves (call (. path append-indexed-curve) this i))
            )
            (else
              (for (in i (..< (- i1 1) i2 (by: -1)))
                (+= appended-curves (call (. path append-indexed-curve) this i))
              )
            )
          )
          (blank)
          (if tt2
            (+= appended-curves (call (. path append-indexed-curve-range) this i2 tt2 1))
          )
        )
      )
      (blank)
      (else
        (let may-wrap (> t1 t2))
        ; Treat an integer end parameter as the end of the previous curve.
        (if (and (not may-wrap) (not tt2) (> t2 t1))
          (-= i2 1)
          (= tt2 1)
        )
        (blank)
        (if (and (== i1 i2) (not may-wrap))
          (+= appended-curves (call (. path append-indexed-curve-range) this i1 tt1 tt2))
          (else
            (if tt1
              (+= appended-curves (call (. path append-indexed-curve-range) this i1 tt1 1))
              (else
                (-= i1 1)
              )
            )
            (blank)
            (if may-wrap
              (let max I64 curve-count)
              (for (in i (..< (+ i1 1) max))
                (+= appended-curves (call (. path append-indexed-curve) this i))
              )
              (for (in i (..< 0 i2))
                (+= appended-curves (call (. path append-indexed-curve) this i))
              )
              (else
                (for (in i (..< (+ i1 1) i2))
                  (+= appended-curves (call (. path append-indexed-curve) this i))
                )
              )
            )
            (blank)
            (if tt2
              (+= appended-curves (call (. path append-indexed-curve-range) this i2 0 tt2))
            )
          )
        )
      )
    )
    (blank)
    (call (. path end-mutation))
    (probe-count graphics.path.split-range.curves appended-curves)
    (return path)
  )
  (fn-do + get-point-at-distance _
    (param distance Length)
    (param be-precise _ (= false))
    (probe-count graphics.path.distance-queries)
    (let t (call get-parameter-at-distance distance be-precise))
    (if (<= t 0)
      (return first-point)
      (else-if (>= t curve-count)
        (return last-point)
      )
    )
    (blank)
    (return (call get-point-at t))
  )
  (fn-do + get-parameter-at-distance PointOnCurve
    (param distance Length)
    (param be-precise _ (= false))
    (probe-count graphics.path.parameter-queries)
    ; XXXjoe This should be a parameter based on zoomed resolution
    (let max-overshoot 0.2)
    (let min-overshoot (- max-overshoot))
    (blank)
    (let ptable (call compute-point-table))
    (for (in (tuple index (tuple pt1 pt2)) (call indexed (call pairwise ptable)))
      (let length-at-point (. pt2 length))
      (let overshoot (- (. pt2 length) distance))
      (if (> overshoot 0)
        (let t (. pt2 t))
        (let x1 (. pt2 x))
        (let y1 (. pt2 y))
        (let t1 (. pt1 t))
        (blank)
        (if (and be-precise (> overshoot max-overshoot))
          (let step -0.001)
          (while (> (call abs step) tolerance)
            (if (> step 0)
              (+= t step)
              (while (< t t1)
                (+= t step)
                (let point (call get-point-at t))
                (blank)
                (let dx (- (. point x) x1))
                (let dy (- (. point y) y1))
                (blank)
                (+= length-at-point (call sqrt (+ (* dx dx) (* dy dy))))
                (= overshoot (- length-at-point distance))
                (= x1 (. point x))
                (= y1 (. point y))
                (blank)
                (if (> overshoot 0)
                  (if (> overshoot max-overshoot)
                    (break)
                    (else
                      (return t1)
                    )
                  )
                )
                (blank)
                (= x1 (. point x))
                (= y1 (. point y))
              )
              (else
                (+= t step)
                (while (> t t1)
                  (+= t step)
                  (let point (call get-point-at t))
                  (blank)
                  (let dx (- x1 (. point x)))
                  (let dy (- y1 (. point y)))
                  (blank)
                  (-= length-at-point (call sqrt (+ (* dx dx) (* dy dy))))
                  (= overshoot (- length-at-point distance))
                  (= x1 (. point x))
                  (= y1 (. point y))
                  (blank)
                  (if (< overshoot 0)
                    (if (< overshoot min-overshoot)
                      (break)
                      (else
                        (return t)
                      )
                    )
                  )
                )
              )
            )
            (blank)
            (= t1 (- t step))
            (= step (/ (- step) 2))
          )
        )
        (blank)
        (let span-length (- (. pt2 length) (. pt1 length)))
        (if (<= span-length tolerance)
          (return (call max 0 t))
        )
        (blank)
        (let ratio (/ (- distance (. pt1 length)) span-length))
        (return (call max 0 (+ (. pt1 t) (* (- (. pt2 t) (. pt1 t)) ratio))))
        (else-if (== overshoot 0)
          (return (. ([] (!! point-table) (+ index 1)) t))
        )
      )
    )
    (blank)
    (return (as curve-count PointOnCurve))
  )
  (fn-do + get-length-at-parameter _
    (param t PointOnCurve)
    (param be-precise _ (= false))
    (probe-count graphics.path.length-parameter-queries)
    (let max-overshoot 0.01)
    (let min-overshoot (- max-overshoot))
    (blank)
    (let ptable (call compute-point-table))
    (for (in (tuple index (tuple pt1 pt2)) (call indexed (call pairwise ptable)))
      (let overshoot (- (. pt2 t) t))
      (if (> overshoot 0)
        (let span-t (- (. pt2 t) (. pt1 t)))
        (if (<= span-t tolerance)
          (return (. pt1 length))
        )
        (blank)
        (let ratio (/ (- t (. pt1 t)) span-t))
        (return (+ (. pt1 length) (* (- (. pt2 length) (. pt1 length)) ratio)))
        (else-if (== overshoot 0)
          (return (. pt2 length))
        )
      )
    )
    (blank)
    (return -1)
  )
  (fn-do + compute-point-table _
    (if point-table
      (probe-count graphics.path.point-table.cache-hits)
      (return point-table)
    )
    (blank)
    (probe-count graphics.path.point-table.builds)
    (let ptable (list PointDistance))
    (let total Length 0)
    (blank)
    (let lastx ([] coords 0))
    (let lasty ([] coords 1))
    (+= ptable (tuple 0.0 total lastx lasty))
    (blank)
    (let point-table-resolution 250)
    (let t-min tolerance)
    (let t-max (if-expr (> point-table-resolution 1) (- 1.0 tolerance) -1.0))
    (blank)
    (let curveindex Index)
    (blank)
    (for (in i (..< 0 command-count))
      (let verb PathVerb ([] verbs i))
      (let start Index ([] coord-offsets i))
      (if (== verb .path-verb-move)
        (continue)
      )
      (blank)
      (let prevx Coord)
      (let prevy Coord)
      (let hasprev false)
      (if (> i 0)
        (let previndex (- i 1))
        (let prevverb PathVerb ([] verbs previndex))
        (let prevstart Index ([] coord-offsets previndex))
        (if (or (== prevverb .path-verb-move) (== prevverb .path-verb-line))
          (= prevx ([] coords prevstart))
          (= prevy ([] coords (+ prevstart 1)))
          (= hasprev true)
          (else-if (== prevverb .path-verb-cubic)
            (= prevx ([] coords (+ prevstart 4)))
            (= prevy ([] coords (+ prevstart 5)))
            (= hasprev true)
          )
          (else-if (== prevverb .path-verb-close)
            (let close (call get-command-subpath-start previndex))
            (if (. close found)
              (= prevx (. close x))
              (= prevy (. close y))
              (= hasprev true)
            )
          )
        )
      )
      (blank)
      (if (not hasprev)
        (continue)
      )
      (blank)
      (if (== verb .path-verb-line)
        (let endx Coord ([] coords start))
        (let endy Coord ([] coords (+ start 1)))
        (let distance Length (call line-length-scalars prevx prevy endx endy))
        (= total (+ total distance))
        (= lastx endx)
        (= lasty endy)
        (if (> distance 0.0000001)
          (probe-count graphics.path.point-table.samples)
          (+= ptable (tuple (+ curveindex 1.0) total lastx lasty))
        )
        (+= curveindex 1)
        (continue)
      )
      (blank)
      (if (== verb .path-verb-close)
        (let close (call get-command-subpath-start i))
        (if (. close found)
          (let closx Coord (. close x))
          (let closy Coord (. close y))
          (if (and (== prevx closx) (== prevy closy))
            (continue)
          )
          (let distance Length (call line-length-scalars prevx prevy closx closy))
          (= total (+ total distance))
          (= lastx closx)
          (= lasty closy)
          (if (> distance 0.0000001)
            (probe-count graphics.path.point-table.samples)
            (+= ptable (tuple (+ curveindex 1.0) total lastx lasty))
          )
          (+= curveindex 1)
        )
        (continue)
      )
      (blank)
      (if (!= verb .path-verb-cubic)
        (continue)
      )
      (blank)
      (let step-min Coord t-min)
      (let step Coord (/ (- t-max step-min) point-table-resolution))
      (blank)
      (let sx Coord prevx)
      (let sy Coord prevy)
      (let ox Coord ([] coords start))
      (let oy Coord ([] coords (+ start 1)))
      (let ix Coord ([] coords (+ start 2)))
      (let iy Coord ([] coords (+ start 3)))
      (let ex Coord ([] coords (+ start 4)))
      (let ey Coord ([] coords (+ start 5)))
      (blank)
      (let coeffx (call cubic-coefficients-1d sx ox ix ex))
      (let coeffy (call cubic-coefficients-1d sy oy iy ey))
      (blank)
      (for (in t (.. step-min t-max (by: step)))
        (probe-count graphics.path.point-table.samples)
        (let x Coord (call cubic-evaluate-1d (. coeffx a) (. coeffx b) (. coeffx c) sx t))
        (let y Coord (call cubic-evaluate-1d (. coeffy a) (. coeffy b) (. coeffy c) sy t))
        (blank)
        (let distance Length (call line-length-scalars lastx lasty x y))
        (blank)
        (= total (+ total distance))
        (= lastx x)
        (= lasty y)
        (+= ptable (tuple (+ curveindex t) total lastx lasty))
      )
      (blank)
      (let distance Length (call line-length-scalars lastx lasty ex ey))
      (= total (+ total distance))
      (= lastx ex)
      (= lasty ey)
      (if (> distance 0.0000001)
        (probe-count graphics.path.point-table.samples)
        (+= ptable (tuple (+ curveindex 1.0) total lastx lasty))
      )
      (blank)
      (+= curveindex 1)
    )
    (blank)
    (= computed-length total)
    (= point-table ptable)
    (return ptable)
  )
  (fn-expr _ bounds-point _
    (param start Index)
    (param transform (? Matrix))
    (if-expr transform (call (. transform transform) point) point)
    (where
      (lazy point (call Point ([] coords start) ([] coords (+ start 1))))
    )
  )
  (fn-do _ trace-canvas _
    (param canvas Canvas)
    (probe-count graphics.path.outline.segments (call outline-segment-count))
    (call (. canvas trace-path) verbs coords command-count)
  )
  (fn-do _ outline-segment-count _
    (let count Size)
    (for (in i (..< 0 command-count))
      (if (!= ([] verbs i) .path-verb-close)
        (+= count 1)
      )
    )
    (return count)
  )
  (fn-expr _ path-curve-from-scalars Curve
    (param type SegmentType)
    (param x1 Coord)
    (param y1 Coord)
    (param hox Coord)
    (param hoy Coord)
    (param hix Coord)
    (param hiy Coord)
    (param x2 Coord)
    (param y2 Coord)
    (call Curve
      (block
        (arg anchor1)
        (arg handle-out)
        (arg handle-in)
        (arg anchor2)
        (arg type)
      )
    )
    (where
      (lazy anchor1 (call Point x1 y1))
      (lazy handle-out (call Point hox hoy))
      (lazy handle-in (call Point hix hiy))
      (lazy anchor2 (call Point x2 y2))
    )
  )
  (fn-expr _ get-curve-coord-bounds (tuple (: min Coord) (: max Coord))
    (param a1 Coord)
    (param ho Coord)
    (param hi Coord)
    (param a2 Coord)
    (scope (tuple (. bounds min) (. bounds max))
      (lazy bounds (call cubic-bounds-1d a1 ho hi a2 tolerance))
    )
  )
  (fn-expr _ get-line-coord-bounds (tuple (: min Coord) (: max Coord))
    (param a1 Coord)
    (param a2 Coord)
    (scope (tuple (. bounds min) (. bounds max))
      (lazy bounds (call line-bounds-1d a1 a2))
    )
  )
  (fn-do _ get-curve-scalars (tuple (: found Bool) (: type SegmentType) (: x1 Coord) (: y1 Coord) (: hox Coord) (: hoy Coord) (: hix Coord) (: hiy Coord) (: x2 Coord) (: y2 Coord) (: is-close Bool))
    (param target Index)
    (let curve-index Index)
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (blank)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (if (== verb .path-verb-move)
        (= current-x ([] coords start))
        (= current-y ([] coords (+ start 1)))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (else-if (and (== verb .path-verb-line) has-current)
          (let x2 ([] coords start))
          (let y2 ([] coords (+ start 1)))
          (if (== curve-index target)
            (return (tuple true .segment-type-line current-x current-y current-x current-y x2 y2 x2 y2 false))
          )
          (= current-x x2)
          (= current-y y2)
          (+= curve-index 1)
        )
        (else-if (and (== verb .path-verb-cubic) has-current)
          (let hox ([] coords start))
          (let hoy ([] coords (+ start 1)))
          (let hix ([] coords (+ start 2)))
          (let hiy ([] coords (+ start 3)))
          (let x2 ([] coords (+ start 4)))
          (let y2 ([] coords (+ start 5)))
          (if (== curve-index target)
            (return (tuple true .segment-type-cubic current-x current-y hox hoy hix hiy x2 y2 false))
          )
          (= current-x x2)
          (= current-y y2)
          (+= curve-index 1)
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (if (== curve-index target)
              (return (tuple true .segment-type-line current-x current-y current-x current-y subpath-x subpath-y subpath-x subpath-y true))
            )
            (+= curve-index 1)
          )
          (= current-x subpath-x)
          (= current-y subpath-y)
        )
      )
    )
    (blank)
    (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0 false))
  )
  (fn-do _ get-indexed-curve-scalars (tuple (: found Bool) (: type SegmentType) (: x1 Coord) (: y1 Coord) (: hox Coord) (: hoy Coord) (: hix Coord) (: hiy Coord) (: x2 Coord) (: y2 Coord) (: is-close Bool))
    (param target Index)
    (let found (call curve-command target))
    (if (and found (> found 0))
      (let command-index found)
      (let verb ([] verbs command-index))
      (let prev-index (- command-index 1))
      (let prev-verb ([] verbs prev-index))
      (let prev-start ([] coord-offsets prev-index))
      (let x1 Coord)
      (let y1 Coord)
      (let has-prev false)
      (blank)
      (if (or (== prev-verb .path-verb-move) (== prev-verb .path-verb-line))
        (= x1 ([] coords prev-start))
        (= y1 ([] coords (+ prev-start 1)))
        (= has-prev true)
        (else-if (== prev-verb .path-verb-cubic)
          (= x1 ([] coords (+ prev-start 4)))
          (= y1 ([] coords (+ prev-start 5)))
          (= has-prev true)
        )
      )
      (blank)
      (if has-prev
        (let start ([] coord-offsets command-index))
        (if (== verb .path-verb-line)
          (let x2 ([] coords start))
          (let y2 ([] coords (+ start 1)))
          (return (tuple true .segment-type-line x1 y1 x1 y1 x2 y2 x2 y2 false))
          (else-if (== verb .path-verb-cubic)
            (let hox ([] coords start))
            (let hoy ([] coords (+ start 1)))
            (let hix ([] coords (+ start 2)))
            (let hiy ([] coords (+ start 3)))
            (let x2 ([] coords (+ start 4)))
            (let y2 ([] coords (+ start 5)))
            (return (tuple true .segment-type-cubic x1 y1 hox hoy hix hiy x2 y2 false))
          )
        )
      )
    )
    (blank)
    (return (call get-curve-scalars target))
  )
  (fn-expr _ curve-command (? Index)
    (param target Index)
    (case? (< target (call leading-curve-count))
      (+ target 1)
    )
    (default
      (only-if ([] table target) (if (< target (. table length))))
    )
    (where
      (lazy table (call curve-command-table))
    )
  )
  (fn-do _ curve-command-table (list Index)
    (let known curve-commands)
    (return-if known (if known))
    (blank)
    (let table (list Index))
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (if (== verb .path-verb-move)
        (= current-x ([] coords start))
        (= current-y ([] coords (+ start 1)))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (else-if (and (== verb .path-verb-line) has-current)
          (+= table i)
          (= current-x ([] coords start))
          (= current-y ([] coords (+ start 1)))
        )
        (else-if (and (== verb .path-verb-cubic) has-current)
          (+= table i)
          (= current-x ([] coords (+ start 4)))
          (= current-y ([] coords (+ start 5)))
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (+= table i)
          )
          (= current-x subpath-x)
          (= current-y subpath-y)
        )
      )
    )
    (= curve-commands table)
    (return table)
  )
  (fn-do _ leading-curve-count Size
    (let known leading-curves)
    (return-if known (if known))
    (blank)
    (let count Size)
    (if (and command-count (== ([] verbs 0) .path-verb-move))
      (while (and (< (+ count 1) command-count) (or (== ([] verbs (+ count 1)) .path-verb-line) (== ([] verbs (+ count 1)) .path-verb-cubic)))
        (+= count 1)
      )
    )
    (= leading-curves count)
    (return count)
  )
  (fn-do _ get-command-curve-scalars (tuple (: found Bool) (: type SegmentType) (: x1 Coord) (: y1 Coord) (: hox Coord) (: hoy Coord) (: hix Coord) (: hiy Coord) (: x2 Coord) (: y2 Coord) (: is-close Bool))
    (param command-index Index)
    (if (>= command-index command-count)
      (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0 false))
    )
    (blank)
    (let verb ([] verbs command-index))
    (if (== verb .path-verb-move)
      (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0 false))
    )
    (blank)
    (let previous (call get-previous-command-point command-index))
    (if (not (. previous found))
      (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0 false))
    )
    (blank)
    (let start ([] coord-offsets command-index))
    (if (== verb .path-verb-line)
      (let end-x ([] coords start))
      (let end-y ([] coords (+ start 1)))
      (return (tuple true .segment-type-line (. previous x) (. previous y) (. previous x) (. previous y) end-x end-y end-x end-y false))
      (else-if (== verb .path-verb-cubic)
        (let hox ([] coords start))
        (let hoy ([] coords (+ start 1)))
        (let hix ([] coords (+ start 2)))
        (let hiy ([] coords (+ start 3)))
        (let end-x ([] coords (+ start 4)))
        (let end-y ([] coords (+ start 5)))
        (return (tuple true .segment-type-cubic (. previous x) (. previous y) hox hoy hix hiy end-x end-y false))
      )
      (else-if (== verb .path-verb-close)
        (let close (call get-command-subpath-start command-index))
        (if (not (. close found))
          (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0 false))
        )
        (if (and (== (. previous x) (. close x)) (== (. previous y) (. close y)))
          (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0 false))
        )
        (return (tuple true .segment-type-line (. previous x) (. previous y) (. previous x) (. previous y) (. close x) (. close y) (. close x) (. close y) true))
      )
    )
    (blank)
    (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0 false))
  )
  (fn-expr _ get-previous-command-point (tuple (: found Bool) (: x Coord) (: y Coord))
    (param command-index Index)
    (case? (<= command-index 0)
      (tuple false 0 0)
    )
    (case? (or (== verb .path-verb-move) (== verb .path-verb-line))
      (tuple true ([] coords start) ([] coords (+ start 1)))
    )
    (case? (== verb .path-verb-cubic)
      (tuple true ([] coords (+ start 4)) ([] coords (+ start 5)))
    )
    (case? (== verb .path-verb-close)
      (call get-command-subpath-start previous-index)
    )
    (default
      (tuple false 0 0)
    )
    (where
      (lazy previous-index (- command-index 1))
      (lazy verb ([] verbs previous-index))
      (lazy start ([] coord-offsets previous-index))
    )
  )
  (fn-do _ get-command-subpath-start (tuple (: found Bool) (: x Coord) (: y Coord))
    (param command-index Index)
    (let seek (+ command-index 1))
    (while (> seek 0)
      (-= seek 1)
      (if (== ([] verbs seek) .path-verb-move)
        (let start ([] coord-offsets seek))
        (return (tuple true ([] coords start) ([] coords (+ start 1))))
      )
    )
    (blank)
    (return (tuple false 0 0))
  )
  (fn-do _ get-control-bounding-box _
    (let cached control-bounding-box-cache)
    (return-if cached (if cached))
    (blank)
    (let min-x Coord ([] coords 0))
    (let min-y Coord ([] coords 1))
    (let max-x Coord min-x)
    (let max-y Coord min-y)
    (blank)
    (for (in i (..< 2 coord-count (by: 2)))
      (let x ([] coords i))
      (let y ([] coords (+ i 1)))
      (if (< x min-x)
        (= min-x x)
      )
      (if (< y min-y)
        (= min-y y)
      )
      (if (> x max-x)
        (= max-x x)
      )
      (if (> y max-y)
        (= max-y y)
      )
    )
    (blank)
    (let bounds (call Rect min-x min-y (- max-x min-x) (- max-y min-y)))
    (= control-bounding-box-cache bounds)
    (return bounds)
  )
  (fn-do _ invalidate _
    (= leading-curves null)
    (= curve-commands null)
    (if (or point-table (. control-projection-bounds-cache length) control-bounding-box-cache)
      (probe-count graphics.path.invalidations)
      (= point-table null)
      (= control-bounding-box-cache null)
      (if (. control-projection-bounds-cache length)
        (call (. control-projection-bounds-cache clear))
      )
    )
  )
  (fn-do _ mark-mutated _
    (if mutation-depth
      (= has-pending-mutation true)
      (else
        (+= path-revision 1)
        (call invalidate)
      )
    )
  )
  (fn-do _ begin-mutation _
    (+= mutation-depth 1)
  )
  (fn-do _ end-mutation _
    (-= mutation-depth 1)
    (if (and (not mutation-depth) has-pending-mutation)
      (= has-pending-mutation false)
      (+= path-revision 1)
      (call invalidate)
    )
  )
  (fn-do _ large-arc _
    (param point Point)
    (param radius Length)
    (param start-angle Radians)
    (param end-angle Radians)
    (param ccw _ (= false))
    (param is-continued _ (= false))
    (let remaining
      (block
        (case? ccw
          (- start-angle end-angle)
        )
        (default
          (- end-angle start-angle)
        )
      )
    )
    (if (< remaining 0)
      (= remaining (call normalize-angle remaining))
    )
    (blank)
    (let a1 start-angle)
    (let sign Float (if-expr ccw -1 1))
    (while (> remaining 0)
      (let amount Float (* sign (call min remaining (/ π 2))))
      (let a2 (+ a1 amount))
      (call small-arc point radius a1 a2 (if-expr is-continued true (!= a1 start-angle)))
      (-= remaining (call abs amount))
      (= a1 a2)
    )
  )
  (fn-do _ small-arc _
    (param point Point)
    (param radius Length)
    (param start-angle Radians)
    (param end-angle Radians)
    (param ccw _ (= false))
    (param is-continued _ (= false))
    (let a (/ (- end-angle start-angle) 2.0))
    (blank)
    (let x4 (* radius (call cos a)))
    (let y4 (* radius (call sin a)))
    (let x1 x4)
    (let y1 (- y4))
    (blank)
    (let f (* (/ 4.0 3.0) (call tan (/ a 2.0))))
    (blank)
    (let x2 (+ x1 (* f y4)))
    (let y2 (+ y1 (* f x4)))
    (let x3 x2)
    (let y3 (- y2))
    (blank)
    (let ar (+ a start-angle))
    (let cos-ar (call cos ar))
    (let sin-ar (call sin ar))
    (blank)
    (if (not is-continued)
      (let ax1 (+ (. point x) (* radius (call cos start-angle))))
      (let ay1 (+ (. point y) (* radius (call sin start-angle))))
      (call line-to ax1 ay1)
    )
    (blank)
    (let hox (+ (. point x) (- (* x2 cos-ar) (* y2 sin-ar))))
    (let hoy (+ (. point y) (+ (* x2 sin-ar) (* y2 cos-ar))))
    (let hix (+ (. point x) (- (* x3 cos-ar) (* y3 sin-ar))))
    (let hiy (+ (. point y) (+ (* x3 sin-ar) (* y3 cos-ar))))
    (let ax4 (+ (. point x) (* radius (call cos end-angle))))
    (let ay4 (+ (. point y) (* radius (call sin end-angle))))
    (call cubic-curve-to hox hoy hix hiy ax4 ay4)
  )
  (fn-do _ contains-line-polygon _
    (param point Point)
    (let inside-x false)
    (let inside-y false)
    (let first-x Coord)
    (let first-y Coord)
    (let prev-x Coord)
    (let prev-y Coord)
    (let has-prev false)
    (blank)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (if (== verb .path-verb-close)
        (continue)
      )
      (blank)
      (let start ([] coord-offsets i))
      (let x ([] coords start))
      (let y ([] coords (+ start 1)))
      (if has-prev
        (return-if true (if (call point-on-segment point prev-x prev-y x y)))
        (blank)
        (if (call segment-crosses-ray point prev-x prev-y x y)
          (= inside-x (not inside-x))
        )
        (if (call segment-crosses-vertical-ray point prev-x prev-y x y)
          (= inside-y (not inside-y))
        )
        (else
          (= first-x x)
          (= first-y y)
          (= has-prev true)
        )
      )
      (blank)
      (= prev-x x)
      (= prev-y y)
    )
    (blank)
    (if has-prev
      (return-if true (if (call point-on-segment point prev-x prev-y first-x first-y)))
      (blank)
      (if (call segment-crosses-ray point prev-x prev-y first-x first-y)
        (= inside-x (not inside-x))
      )
      (if (call segment-crosses-vertical-ray point prev-x prev-y first-x first-y)
        (= inside-y (not inside-y))
      )
    )
    (blank)
    (return (or inside-x inside-y))
  )
  (fn-do _ segment-crosses-ray _
    (param point Point)
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (let above1 (> y1 (. point y)))
    (let above2 (> y2 (. point y)))
    (return-if (if (== above1 above2)))
    (blank)
    (let x (+ x1 (/ (* (- (. point y) y1) (- x2 x1)) (- y2 y1))))
    (return (> x (. point x)))
  )
  (fn-do _ segment-crosses-vertical-ray _
    (param point Point)
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (let right1 (> x1 (. point x)))
    (let right2 (> x2 (. point x)))
    (return-if (if (== right1 right2)))
    (blank)
    (let y (+ y1 (/ (* (- (. point x) x1) (- y2 y1)) (- x2 x1))))
    (return (> y (. point y)))
  )
  (fn-do _ point-on-segment _
    (param point Point)
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (let dx (- x2 x1))
    (let dy (- y2 y1))
    (let px (- (. point x) x1))
    (let py (- (. point y) y1))
    (let cross (- (* dx py) (* dy px)))
    (return-if (if (> (call abs cross) tolerance)))
    (blank)
    (let min-x (- (call min x1 x2) tolerance))
    (let max-x (+ (call max x1 x2) tolerance))
    (let min-y (- (call min y1 y2) tolerance))
    (let max-y (+ (call max y1 y2) tolerance))
    (blank)
    (return (and (>= (. point x) min-x) (<= (. point x) max-x) (>= (. point y) min-y) (<= (. point y) max-y)))
  )
  (fn-expr _ point-on-cubic _
    (param point Point)
    (param a1-x Coord)
    (param a1-y Coord)
    (param ho-x Coord)
    (param ho-y Coord)
    (param hi-x Coord)
    (param hi-y Coord)
    (param a2-x Coord)
    (param a2-y Coord)
    (call point-on-cubic-scalars (. point x) (. point y) a1-x a1-y ho-x ho-y hi-x hi-y a2-x a2-y tolerance)
  )
  (fn-do _ get-point-at-scalars _
    (param a1-x Coord)
    (param a1-y Coord)
    (param ho-x Coord)
    (param ho-y Coord)
    (param hi-x Coord)
    (param hi-y Coord)
    (param a2-x Coord)
    (param a2-y Coord)
    (param t PointOnCurve)
    (param which PointType)
    (param distance (? Length))
    (let point (call cubic-evaluate-xy a1-x a1-y ho-x ho-y hi-x hi-y a2-x a2-y t))
    (blank)
    (if (== which .point-type-point)
      (return (call Point (. point x) (. point y)))
      (else
        (let tangent (call cubic-derivative-xy a1-x a1-y ho-x ho-y hi-x hi-y a2-x a2-y t))
        (let point-x (. tangent x))
        (let point-y (. tangent y))
        (blank)
        ; normal is just rotated tangent
        (if (== which .point-type-normal)
          (let old-x point-x)
          (= point-x point-y)
          (= point-y (- old-x))
        )
        (blank)
        (if distance
          (let length (call sqrt (+ (* point-x point-x) (* point-y point-y))))
          (let scale (if-expr (not length) 1.0 (/ distance length)))
          (return
            (call Point
              (block
                (arg (+ (. point x) (* point-x scale)))
                (arg (+ (. point y) (* point-y scale)))
              )
            )
          )
          (else
            (return (call Point point-x point-y))
          )
        )
      )
    )
  )
  (fn-do _ get-line-point-at-scalars _
    (param a1-x Coord)
    (param a1-y Coord)
    (param a2-x Coord)
    (param a2-y Coord)
    (param t PointOnCurve)
    (param which PointType)
    (param distance (? Length))
    (let x (+ a1-x (* (- a2-x a1-x) t)))
    (let y (+ a1-y (* (- a2-y a1-y) t)))
    (if (== which .point-type-point)
      (return (call Point x y))
    )
    (let point-x (- a2-x a1-x))
    (let point-y (- a2-y a1-y))
    (if (== which .point-type-normal)
      (let old-x point-x)
      (= point-x point-y)
      (= point-y (- old-x))
    )
    (if distance
      (let length (call sqrt (+ (* point-x point-x) (* point-y point-y))))
      (let scale (if-expr (not length) 1.0 (/ distance length)))
      (return (call Point (+ x (* point-x scale)) (+ y (* point-y scale))))
    )
    (return (call Point point-x point-y))
  )
  (fn-do _ append-indexed-curve _
    (param source Path)
    (param i Index)
    (let curve (call (. source get-indexed-curve-scalars) i))
    (if (not (. curve found))
      (return 0)
    )
    (blank)
    (return
      (call append-curve-scalars
        (block
          (arg (. curve type))
          (arg (. curve x1))
          (arg (. curve y1))
          (arg (. curve hox))
          (arg (. curve hoy))
          (arg (. curve hix))
          (arg (. curve hiy))
          (arg (. curve x2))
          (arg (. curve y2))
        )
      )
    )
  )
  (fn-do _ append-indexed-curve-reverse Size
    (param source Path)
    (param i Index)
    (let curve (call (. source get-indexed-curve-scalars) i))
    (if (not (. curve found))
      (return 0)
    )
    (blank)
    (call append-curve-scalars-reverse
      (block
        (arg (. curve type))
        (arg (. curve x1))
        (arg (. curve y1))
        (arg (. curve hox))
        (arg (. curve hoy))
        (arg (. curve hix))
        (arg (. curve hiy))
        (arg (. curve x2))
        (arg (. curve y2))
      )
    )
    (return 1)
  )
  (fn-do _ append-indexed-curve-range _
    (param source Path)
    (param i Index)
    (param t1 PointOnCurve)
    (param t2 PointOnCurve)
    (let curve (call (. source get-curve-range-scalars) i t1 t2))
    (if (not (. curve found))
      (return 0)
    )
    (blank)
    (return
      (call append-curve-scalars
        (block
          (arg (. curve type))
          (arg (. curve x1))
          (arg (. curve y1))
          (arg (. curve hox))
          (arg (. curve hoy))
          (arg (. curve hix))
          (arg (. curve hiy))
          (arg (. curve x2))
          (arg (. curve y2))
        )
      )
    )
  )
  (fn-do _ append-indexed-curve-range-reverse Size
    (param source Path)
    (param i Index)
    (param t1 PointOnCurve)
    (param t2 PointOnCurve)
    (let curve (call (. source get-curve-range-scalars) i t1 t2))
    (if (not (. curve found))
      (return 0)
    )
    (blank)
    (call append-curve-scalars-reverse
      (block
        (arg (. curve type))
        (arg (. curve x1))
        (arg (. curve y1))
        (arg (. curve hox))
        (arg (. curve hoy))
        (arg (. curve hix))
        (arg (. curve hiy))
        (arg (. curve x2))
        (arg (. curve y2))
      )
    )
    (return 1)
  )
  (fn-do _ append-curve-scalars Size
    (param type SegmentType)
    (param x1 Coord)
    (param y1 Coord)
    (param hox Coord)
    (param hoy Coord)
    (param hix Coord)
    (param hiy Coord)
    (param x2 Coord)
    (param y2 Coord)
    (if (not command-count)
      (call move-to x1 y1)
    )
    (blank)
    (if (== type .segment-type-line)
      (call line-to x2 y2)
      (else
        (call cubic-curve-to hox hoy hix hiy x2 y2)
      )
    )
    (blank)
    (return 1)
  )
  (fn-do _ append-curve-scalars-reverse _
    (param type SegmentType)
    (param x1 Coord)
    (param y1 Coord)
    (param hox Coord)
    (param hoy Coord)
    (param hix Coord)
    (param hiy Coord)
    (param x2 Coord)
    (param y2 Coord)
    (if (not command-count)
      (call move-to x2 y2)
    )
    (blank)
    (if (== type .segment-type-line)
      (call line-to x1 y1)
      (else
        (call cubic-curve-to hix hiy hox hoy x1 y1)
      )
    )
  )
  (fn-expr _ get-curve-range-scalars (tuple (: found Bool) (: type SegmentType) (: x1 Coord) (: y1 Coord) (: hox Coord) (: hoy Coord) (: hix Coord) (: hiy Coord) (: x2 Coord) (: y2 Coord))
    (param i Index)
    (param t1 PointOnCurve)
    (param t2 PointOnCurve)
    (case? (not (. curve found))
      (tuple false .segment-type-line 0 0 0 0 0 0 0 0)
    )
    (default
      (tuple true type x1 y1 hox hoy hix hiy x2 y2)
    )
    (where
      (lazy curve (call get-indexed-curve-scalars i))
      (lazy split
        (call split-curve-scalars
          (block
            (arg (. curve type))
            (arg (. curve x1))
            (arg (. curve y1))
            (arg (. curve hox))
            (arg (. curve hoy))
            (arg (. curve hix))
            (arg (. curve hiy))
            (arg (. curve x2))
            (arg (. curve y2))
            (arg t1)
            (arg t2)
          )
        )
      )
      (lazy type (. split curve-type))
      (lazy x1 (. split x1))
      (lazy y1 (. split y1))
      (lazy hox (. split hox))
      (lazy hoy (. split hoy))
      (lazy hix (. split hix))
      (lazy hiy (. split hiy))
      (lazy x2 (. split x2))
      (lazy y2 (. split y2))
    )
  )
  (fn-expr _ split-curve-scalars (tuple (: curve-type SegmentType) (: x1 Coord) (: y1 Coord) (: hox Coord) (: hoy Coord) (: hix Coord) (: hiy Coord) (: x2 Coord) (: y2 Coord))
    (param type SegmentType)
    (param x1 Coord)
    (param y1 Coord)
    (param hox Coord)
    (param hoy Coord)
    (param hix Coord)
    (param hiy Coord)
    (param x2 Coord)
    (param y2 Coord)
    (param t1 PointOnCurve)
    (param t2 PointOnCurve)
    (scope (tuple (. range type) (. range x1) (. range y1) (. range hox) (. range hoy) (. range hix) (. range hiy) (. range x2) (. range y2))
      (lazy range (call curve-range-scalars type x1 y1 hox hoy hix hiy x2 y2 t1 t2))
    )
  )
  (fn-do _ get-crossings-at _
    (param crossings (list Int))
    (param point Point)
    (param a1-x Coord)
    (param a1-y Coord)
    (param ho-x Coord)
    (param ho-y Coord)
    (param hi-x Coord)
    (param hi-y Coord)
    (param a2-x Coord)
    (param a2-y Coord)
    (let coeffx (call cubic-coefficients-1d a1-x ho-x hi-x a2-x))
    (let coeffy (call cubic-coefficients-1d a1-y ho-y hi-y a2-y))
    (blank)
    (let xroots (call cubic-roots-for-y (. point y) a1-y ho-y hi-y a2-y tolerance-tight))
    (for (in j (..< 0 (. xroots count)))
      (let t (call ray-crossing-parameter ([] xroots j)))
      (if (or (< t 0) (<= (call abs (call ray-crossing-direction coeffy t)) tolerance-tight))
        (continue)
      )
      (if (> (call cubic-evaluate-1d (. coeffx a) (. coeffx b) (. coeffx c) a1-x t) (. point x))
        (+= ([] crossings 0) 1)
      )
    )
    (blank)
    (let yroots (call cubic-roots-for-x (. point x) a1-x ho-x hi-x a2-x tolerance-tight))
    (for (in j (..< 0 (. yroots count)))
      (let t (call ray-crossing-parameter ([] yroots j)))
      (if (or (< t 0) (<= (call abs (call ray-crossing-direction coeffx t)) tolerance-tight))
        (continue)
      )
      (if (> (call cubic-evaluate-1d (. coeffy a) (. coeffy b) (. coeffy c) a1-y t) (. point y))
        (+= ([] crossings 1) 1)
      )
    )
  )
  (fn-do _ get-open-closer-crossings-at _
    (param crossings (list Int))
    (param point Point)
    (let first first-point)
    (let last last-point)
    (call get-crossings-at
      (block
        (arg crossings)
        (arg point)
        (arg (. last x))
        (arg (. last y))
        (arg (. last x))
        (arg (. last y))
        (arg (. first x))
        (arg (. first y))
        (arg (. first x))
        (arg (. first y))
      )
    )
  )
  (fn-expr _ normalize-parameter _
    (param t PointOnCurve)
    (match t
      (case= max
        (- max tolerance)
      )
      (case= 0
        tolerance
      )
      (default
        t
      )
    )
    (where
      (lazy max curve-count)
    )
  )
  (fn-expr _ constrain-parameter _
    (param t PointOnCurve)
    (case? (< t 0)
      (+ cc (call abs (% t curve-count)))
    )
    (case? (> t cc)
      (% t curve-count)
    )
    (default
      t
    )
    (where
      (lazy cc curve-count)
    )
  )
  (fn-do _ append-command Index
    (param verb PathVerb)
    (param coord-size Size)
    (call ensure-command-capacity (+ command-count 1))
    (call ensure-coord-capacity (+ coord-count coord-size))
    (blank)
    (= ([] verbs command-count) verb)
    (= ([] coord-offsets command-count) coord-count)
    (let start coord-count)
    (+= coord-count coord-size)
    (+= command-count 1)
    (= ([] coord-offsets command-count) coord-count)
    (blank)
    (probe-count graphics.path.segments.appended)
    (call mark-mutated)
    (return start)
  )
  (fn-do _ ensure-command-capacity _
    (param needed Size)
    (if (> needed (. verbs size))
      (= verbs (call (. verbs resize) (call next-command-capacity (. verbs size) needed)))
    )
    (blank)
    (if (> (+ needed 1) (. coord-offsets size))
      (= coord-offsets (call (. coord-offsets resize) (call next-offset-capacity (. coord-offsets size) (+ needed 1))))
    )
  )
  (fn-do _ ensure-coord-capacity _
    (param needed Size)
    (if (> needed (. coords size))
      (= coords (call (. coords resize) (call next-coord-capacity (. coords size) needed)))
    )
  )
  (fn-do _ next-command-capacity Size
    (param current Size)
    (param needed Size)
    (let new-size (if-expr (< current 16) 16 (* current 2)))
    (if (< new-size needed)
      (= new-size needed)
    )
    (return new-size)
  )
  (fn-do _ next-offset-capacity Size
    (param current Size)
    (param needed Size)
    (let current-commands Size)
    (if (> current 0)
      (= current-commands (- current 1))
    )
    (blank)
    (let needed-commands Size)
    (if (> needed 0)
      (= needed-commands (- needed 1))
    )
    (blank)
    (return (+ (call next-command-capacity current-commands needed-commands) 1))
  )
  (fn-do _ next-coord-capacity Size
    (param current Size)
    (param needed Size)
    (let new-size (if-expr (< current 32) 32 (* current 2)))
    (if (< new-size needed)
      (= new-size needed)
    )
    (return new-size)
  )
  (fn-do _ last-anchor _
    (let x Coord)
    (let y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (blank)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (if (== verb .path-verb-move)
        (= x ([] coords start))
        (= y ([] coords (+ start 1)))
        (= subpath-x x)
        (= subpath-y y)
        (= has-current true)
        (else-if (== verb .path-verb-line)
          (= x ([] coords start))
          (= y ([] coords (+ start 1)))
        )
        (else-if (== verb .path-verb-cubic)
          (= x ([] coords (+ start 4)))
          (= y ([] coords (+ start 5)))
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (= x subpath-x)
          (= y subpath-y)
        )
      )
    )
    (blank)
    (return (call Point x y))
  )
)

(type + PathCommandSpan (is Tuple)
  (prop + verbs (of Array PathVerb))
  (prop + coord-offsets (of Array Index))
  (prop + coords (of Array Coord))
  (prop + command-count Size)
  (prop + coord-count Size)
  (prop + revision Size)
)

(type + PathSubpathSpan (is Tuple)
  (prop + span PathCommandSpan)
  (prop + command-start Index)
  (prop + command-end Index)
  (prop + curve-count Size)
  (prop + is-closed Bool)
  (fn-expr + command-count Size :get
    (- command-end command-start)
  )
  (fn-do + materialize _
    (let path (call Path))
    (call materialize path)
    (return path)
  )
  (fn-do + materialize _
    (param path Path)
    (call (. path clear))
    (call (. path reserve) command-count (- ([] (. span coord-offsets) command-end) ([] (. span coord-offsets) command-start)))
    (blank)
    (for (in i (..< command-start command-end))
      (let verb ([] (. span verbs) i))
      (let start ([] (. span coord-offsets) i))
      (if (== verb .path-verb-move)
        (call (. path move-to) ([] (. span coords) start) ([] (. span coords) (+ start 1)))
        (else-if (== verb .path-verb-line)
          (call (. path line-to) ([] (. span coords) start) ([] (. span coords) (+ start 1)))
        )
        (else-if (== verb .path-verb-cubic)
          (call (. path cubic-curve-to)
            (block
              (arg ([] (. span coords) start))
              (arg ([] (. span coords) (+ start 1)))
              (arg ([] (. span coords) (+ start 2)))
              (arg ([] (. span coords) (+ start 3)))
              (arg ([] (. span coords) (+ start 4)))
              (arg ([] (. span coords) (+ start 5)))
            )
          )
        )
        (else-if (== verb .path-verb-close)
          (call (. path close))
        )
      )
    )
    (blank)
    (return path)
  )
  (fn-do + get-control-projection-bounds _
    (param line-ux Coord)
    (param line-uy Coord)
    (let min-side Coord)
    (let max-side Coord)
    (let min-proj Coord)
    (let max-proj Coord)
    (let waiting-for-first true)
    (blank)
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (blank)
    (for (in i (..< command-start command-end))
      (let verb ([] (. span verbs) i))
      (let start ([] (. span coord-offsets) i))
      (let x1 Coord)
      (let y1 Coord)
      (let hox Coord)
      (let hoy Coord)
      (let hix Coord)
      (let hiy Coord)
      (let x2 Coord)
      (let y2 Coord)
      (let has-curve false)
      (blank)
      (if (== verb .path-verb-move)
        (= current-x ([] (. span coords) start))
        (= current-y ([] (. span coords) (+ start 1)))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (else-if (and (== verb .path-verb-line) has-current)
          (= x1 current-x)
          (= y1 current-y)
          (= x2 ([] (. span coords) start))
          (= y2 ([] (. span coords) (+ start 1)))
          (= hox x1)
          (= hoy y1)
          (= hix x2)
          (= hiy y2)
          (= current-x x2)
          (= current-y y2)
          (= has-curve true)
        )
        (else-if (and (== verb .path-verb-cubic) has-current)
          (= x1 current-x)
          (= y1 current-y)
          (= hox ([] (. span coords) start))
          (= hoy ([] (. span coords) (+ start 1)))
          (= hix ([] (. span coords) (+ start 2)))
          (= hiy ([] (. span coords) (+ start 3)))
          (= x2 ([] (. span coords) (+ start 4)))
          (= y2 ([] (. span coords) (+ start 5)))
          (= current-x x2)
          (= current-y y2)
          (= has-curve true)
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (= x1 current-x)
            (= y1 current-y)
            (= x2 subpath-x)
            (= y2 subpath-y)
            (= hox x1)
            (= hoy y1)
            (= hix x2)
            (= hiy y2)
            (= has-curve true)
          )
          (= current-x subpath-x)
          (= current-y subpath-y)
        )
      )
      (blank)
      (if has-curve
        (for (in point-index (..< 0 4))
          (let x
            (block
              (case? (== point-index 0)
                x1
              )
              (case? (== point-index 1)
                hox
              )
              (case? (== point-index 2)
                hix
              )
              (default
                x2
              )
            )
          )
          (let y
            (block
              (case? (== point-index 0)
                y1
              )
              (case? (== point-index 1)
                hoy
              )
              (case? (== point-index 2)
                hiy
              )
              (default
                y2
              )
            )
          )
          (let side (- (* x line-uy) (* y line-ux)))
          (let proj (+ (* x line-ux) (* y line-uy)))
          (blank)
          (if waiting-for-first
            (= min-side side)
            (= max-side side)
            (= min-proj proj)
            (= max-proj proj)
            (= waiting-for-first false)
            (else
              (if (< side min-side)
                (= min-side side)
              )
              (if (> side max-side)
                (= max-side side)
              )
              (if (< proj min-proj)
                (= min-proj proj)
              )
              (if (> proj max-proj)
                (= max-proj proj)
              )
            )
          )
        )
      )
    )
    (blank)
    (return (call ControlProjectionBounds line-ux line-uy min-side max-side min-proj max-proj))
  )
)

(type + PathCommandReader
  (prop + span PathCommandSpan)
  (prop + next-index Index)
  (prop + command-index Index)
  (prop + verb PathVerb)
  (prop + coord-start Index)
  (prop + coord-end Index)
  (fn-do + This _
    (param span PathCommandSpan)
  )
  (fn-expr + coord-count Size :get
    (- coord-end coord-start)
  )
  (fn-do + next _
    (return-if (if (>= next-index (. span command-count))))
    (blank)
    (= command-index next-index)
    (= verb ([] (. span verbs) command-index))
    (= coord-start ([] (. span coord-offsets) command-index))
    (= coord-end ([] (. span coord-offsets) (+ command-index 1)))
    (+= next-index 1)
    (return true)
  )
  (fn-expr + coord _
    (param index Index)
    ([] (. span coords) (+ coord-start index))
  )
)

(type + PathCurveReader
  (prop + span PathCommandSpan)
  (prop + command-index Index)
  (prop + next-curve-index Index)
  (prop + curve-index Index)
  (prop + type SegmentType)
  (prop + is-close _ (= false))
  (prop + x1 Coord)
  (prop + y1 Coord)
  (prop + handle-out-x Coord)
  (prop + handle-out-y Coord)
  (prop + handle-in-x Coord)
  (prop + handle-in-y Coord)
  (prop + x2 Coord)
  (prop + y2 Coord)
  (blank)
  (prop _ current-x Coord)
  (prop _ current-y Coord)
  (prop _ subpath-x Coord)
  (prop _ subpath-y Coord)
  (prop _ has-current _ (= false))
  (fn-do + This _
    (param span PathCommandSpan)
  )
  (fn-expr + curve _ :get
    (call Curve (tuple x1 y1) (tuple handle-out-x handle-out-y) (tuple handle-in-x handle-in-y) (tuple x2 y2) type)
  )
  (fn-do + next _
    (while (< command-index (. span command-count))
      (let verb ([] (. span verbs) command-index))
      (let start ([] (. span coord-offsets) command-index))
      (blank)
      (if (== verb .path-verb-move)
        (= current-x ([] (. span coords) start))
        (= current-y ([] (. span coords) (+ start 1)))
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (+= command-index 1)
        (else-if (== verb .path-verb-line)
          (if (not has-current)
            (= current-x ([] (. span coords) start))
            (= current-y ([] (. span coords) (+ start 1)))
            (= subpath-x current-x)
            (= subpath-y current-y)
            (= has-current true)
            (+= command-index 1)
            (continue)
          )
          (blank)
          (= curve-index next-curve-index)
          (+= next-curve-index 1)
          (= type .segment-type-line)
          (= is-close false)
          (= x1 current-x)
          (= y1 current-y)
          (= x2 ([] (. span coords) start))
          (= y2 ([] (. span coords) (+ start 1)))
          (= handle-out-x x1)
          (= handle-out-y y1)
          (= handle-in-x x2)
          (= handle-in-y y2)
          (= current-x x2)
          (= current-y y2)
          (+= command-index 1)
          (return true)
        )
        (else-if (== verb .path-verb-cubic)
          (if (not has-current)
            (= current-x ([] (. span coords) (+ start 4)))
            (= current-y ([] (. span coords) (+ start 5)))
            (= subpath-x current-x)
            (= subpath-y current-y)
            (= has-current true)
            (+= command-index 1)
            (continue)
          )
          (blank)
          (= curve-index next-curve-index)
          (+= next-curve-index 1)
          (= type .segment-type-cubic)
          (= is-close false)
          (= x1 current-x)
          (= y1 current-y)
          (= handle-out-x ([] (. span coords) start))
          (= handle-out-y ([] (. span coords) (+ start 1)))
          (= handle-in-x ([] (. span coords) (+ start 2)))
          (= handle-in-y ([] (. span coords) (+ start 3)))
          (= x2 ([] (. span coords) (+ start 4)))
          (= y2 ([] (. span coords) (+ start 5)))
          (= current-x x2)
          (= current-y y2)
          (+= command-index 1)
          (return true)
        )
        (else-if (== verb .path-verb-close)
          (+= command-index 1)
          (if (not has-current)
            (continue)
          )
          (blank)
          (if (and (== current-x subpath-x) (== current-y subpath-y))
            (continue)
          )
          (blank)
          (= curve-index next-curve-index)
          (+= next-curve-index 1)
          (= type .segment-type-line)
          (= is-close true)
          (= x1 current-x)
          (= y1 current-y)
          (= x2 subpath-x)
          (= y2 subpath-y)
          (= handle-out-x x1)
          (= handle-out-y y1)
          (= handle-in-x x2)
          (= handle-in-y y2)
          (= current-x subpath-x)
          (= current-y subpath-y)
          (return true)
        )
      )
    )
    (blank)
    (return false)
  )
)

(type + PathTraceSink (is Interface)
  (fn-expr + move _
    (param x Coord)
    (param y Coord)
  )
  (fn-expr + line _
    (param x Coord)
    (param y Coord)
  )
  (fn-expr + cubic _
    (param hox Coord)
    (param hoy Coord)
    (param hix Coord)
    (param hiy Coord)
    (param x Coord)
    (param y Coord)
  )
  (fn-expr + close _)
)

(type + PathSegment (is Tuple)
  (prop + type SegmentType)
  (prop + handle-out Point)
  (prop + handle-in Point)
  (prop + anchor Point)
  (fn-to-expr + String
    (case? (== type .segment-type-cubic)
      (str type "[" handle-out ", " handle-in ", " anchor "]")
    )
    (default
      (str type "[" anchor "]")
    )
  )
  (fn-do + mirror-x _
    (param cx Coord)
    (let mirrored (= (. this anchor) (call (. anchor mirror-x) cx)))
    (= mirrored (= (. mirrored handle-out) (call (. handle-out mirror-x) cx)))
    (= mirrored (= (. mirrored handle-in) (call (. handle-in mirror-x) cx)))
    (return mirrored)
  )
  (fn-do + mirror-y _
    (param cy Coord)
    (let mirrored (= (. this anchor) (call (. anchor mirror-y) cy)))
    (= mirrored (= (. mirrored handle-out) (call (. handle-out mirror-y) cy)))
    (= mirrored (= (. mirrored handle-in) (call (. handle-in mirror-y) cy)))
    (return mirrored)
  )
  (fn-do + mirror _
    (param center Point)
    (let mirrored (= (. this anchor) (call (. anchor mirror) center)))
    (= mirrored (= (. mirrored handle-out) (call (. handle-out mirror) center)))
    (= mirrored (= (. mirrored handle-in) (call (. handle-in mirror) center)))
    (return mirrored)
  )
  (fn-do + translate _
    (param distance Point)
    (let translated (+= (. this anchor) distance))
    (= translated (+= (. translated handle-out) distance))
    (= translated (+= (. translated handle-in) distance))
    (return translated)
  )
  (fn-do + rotate _
    (param angle Radians)
    (param center Point)
    (let translated (= (. this anchor) (call (. anchor rotate) angle center)))
    (= translated (= (. translated handle-out) (call (. handle-out rotate) angle center)))
    (= translated (= (. translated handle-in) (call (. handle-in rotate) angle center)))
    (return translated)
  )
  (fn-do + transform _
    (param matrix Matrix)
    (let trans (= (. this anchor) (call (. matrix transform) anchor)))
    (= trans (= (. trans handle-out) (call (. matrix transform) handle-out)))
    (= trans (= (. trans handle-in) (call (. matrix transform) handle-in)))
    (return trans)
  )
)

(type + ControlProjectionBounds (is Tuple)
  (prop + line-ux Coord)
  (prop + line-uy Coord)
  (prop + min-side Coord)
  (prop + max-side Coord)
  (prop + min-proj Coord)
  (prop + max-proj Coord)
)

(fn-expr _ ray-crossing-parameter PointOnCurve
  (param t PointOnCurve)
  (if-expr (or (< t (- tolerance-tight)) (> t (+ 1 tolerance-tight))) -1.0 (call max 0.0 (call min 1.0 t)))
)

(fn-expr _ ray-crossing-direction Coord
  (param slope CubicCoefficients1D)
  (param t PointOnCurve)
  (case? (< t tolerance-tight)
    (call max (call cubic-derivative-1d (. slope a) (. slope b) (. slope c) 0.000001) 0.0)
  )
  (case? (> t (- 1 tolerance-tight))
    (call min (call cubic-derivative-1d (. slope a) (. slope b) (. slope c) 0.999999) 0.0)
  )
  (default
    (call cubic-derivative-1d (. slope a) (. slope b) (. slope c) t)
  )
)

(fn-do + path-curves-contain Bool
  (param curves (list Curve))
  (param point Point)
  (param fill-rule FillRule)
  (let winding Int)
  (for (in curve curves)
    (return-if true (if (and (call path-hull-reaches curve point) (>= (call (. curve get-parameter) point) 0))))
    (blank)
    (if (. curve is-line-like)
      (let a (. curve anchor1))
      (let b (. curve anchor2))
      (if (!= (> (. a y) (. point y)) (> (. b y) (. point y)))
        (let x (+ (. a x) (/ (* (- (. point y) (. a y)) (- (. b x) (. a x))) (- (. b y) (. a y)))))
        (if (> x (. point x))
          (+= winding (if-expr (> (. b y) (. a y)) 1 -1))
        )
      )
      (else
        (let roots
          (call cubic-roots-for-y
            (block
              (arg (. point y))
              (arg (. curve anchor1 y))
              (arg (. curve handle-out y))
              (arg (. curve handle-in y))
              (arg (. curve anchor2 y))
              (arg tolerance-tight)
            )
          )
        )
        (let x
          (call cubic-coefficients-1d
            (block
              (arg (. curve anchor1 x))
              (arg (. curve handle-out x))
              (arg (. curve handle-in x))
              (arg (. curve anchor2 x))
            )
          )
        )
        (let y
          (call cubic-coefficients-1d
            (block
              (arg (. curve anchor1 y))
              (arg (. curve handle-out y))
              (arg (. curve handle-in y))
              (arg (. curve anchor2 y))
            )
          )
        )
        (for (in i (..< 0 (. roots count)))
          (let t ([] roots i))
          (if (or (< t (- tolerance-tight)) (> t (+ 1 tolerance-tight)))
            (continue)
          )
          (= t (call max 0.0 (call min 1.0 t)))
          (let direction (call cubic-derivative-1d (. y a) (. y b) (. y c) t))
          (if (< t tolerance-tight)
            (= direction (call cubic-derivative-1d (. y a) (. y b) (. y c) 0.000001))
            (if (<= direction 0)
              (continue)
            )
            (else-if (> t (- 1 tolerance-tight))
              (= direction (call cubic-derivative-1d (. y a) (. y b) (. y c) 0.999999))
              (if (>= direction 0)
                (continue)
              )
            )
          )
          (if (> (call abs direction) tolerance-tight)
            (let intersection-x (call cubic-evaluate-1d (. x a) (. x b) (. x c) (. curve anchor1 x) t))
            (if (> intersection-x (. point x))
              (+= winding (if-expr (> direction 0) 1 -1))
            )
          )
        )
      )
    )
  )
  (return (if-expr (== fill-rule (. FillRule even-odd)) (!= (/and/ winding 1) 0) (!= winding 0)))
)

(type _ PointType
  (variant point-type-point)
  (variant point-type-normal)
  (variant point-type-tangent)
)

(type _ PointDistance (is Tuple)
  (prop + t PointOnCurve)
  (prop + length Length)
  (prop + x Coord)
  (prop + y Coord)
)

(fn-expr _ path-hull-reaches Bool
  (param curve Curve)
  (param point Point)
  (and within-x (>= (. point y) (- top reach)) (<= (. point y) (+ bottom reach)))
  (where
    (lazy left (call min (call min (. curve anchor1 x) (. curve handle-out x)) (call min (. curve handle-in x) (. curve anchor2 x))))
    (lazy right (call max (call max (. curve anchor1 x) (. curve handle-out x)) (call max (. curve handle-in x) (. curve anchor2 x))))
    (lazy top (call min (call min (. curve anchor1 y) (. curve handle-out y)) (call min (. curve handle-in y) (. curve anchor2 y))))
    (lazy bottom (call max (call max (. curve anchor1 y) (. curve handle-out y)) (call max (. curve handle-in y) (. curve anchor2 y))))
    (lazy reach (+ 0.01 (* (- (+ (- right left) bottom) top) 0.001)))
    (lazy within-x (and (>= (. point x) (- left reach)) (<= (. point x) (+ right reach))))
  )
)
