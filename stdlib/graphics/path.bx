      (call small-arc point radius start-angle end-angle is-continued)
      (else
        (call large-arc point radius start-angle end-angle ccw is-continued)
      )
    )
    (call end-mutation)
  )
  (fn-do + outline _
    (param canvas Canvas)
    (param fill-rule FillRule (= (. FillRule nonzero)))
