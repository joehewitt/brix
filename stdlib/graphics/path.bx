                (arg (+ (- (. offset y) (. origin y)) (/ (. bbox-start height) 2)))
              )
            )
          )
        )
      )
    )
    (blank)
    (if matrix
      (call (. mx pre-concatenate) matrix)
    )
    (blank)
    (call transform mx)
    (call end-mutation)
  )
  (fn-do + transform _
    (param matrix Matrix)
    (for (in i (..< 0 coord-count (by: 2)))
      (let x ([] coords i))
      (let y ([] coords (+ i 1)))
      (= ([] coords i) (+ (* x (. matrix a)) (* y (. matrix b)) (. matrix tx)))
      (= ([] coords (+ i 1)) (+ (* x (. matrix c)) (* y (. matrix d)) (. matrix ty)))
    )
    (call mark-mutated)
  )
  (fn-expr + contains _
    (param other Path)
    false
  )
  (fn-expr + contains _
    (param point Point)
    (call contains point crossings)
    (where
      (lazy crossings (list 0 0))
    )
  )
  (fn-expr + contains _
    (param point Point)
