  (fn-do + mirror-x _
    (param cx (? Coord))
    (let cxx (?? cx (. bounding-box center x)))
    (for (in i (..< 0 coord-count (by: 2)))
      (let x ([] coords i))
      (= ([] coords i) (if-expr (< x cxx) (- cxx (- x cxx)) (+ cxx (- cxx x))))
    )
