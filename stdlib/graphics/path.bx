  (fn-do + line-to _
    (param point Point)
    (call line-to (. point x) (. point y))
  )
  (fn-do + line-to _
    (param x Coord)
    (param y Coord)
    (probe-count graphics.path.build.lines)
    (let verb .path-verb-line)
    (if (not command-count)
      (= verb .path-verb-move)
    )
    (blank)
    (let start (call append-command verb 2))
    (= ([] coords start) x)
    (= ([] coords (+ start 1)) y)
  )
  (fn-do + line-by _
    (param x Coord)
    (param y Coord)
    (probe-count graphics.path.build.lines)
    (let last last-point)
    (+= x (. last x))
    (+= y (. last y))
    (call line-to x y)
  )
  (fn-do + quadratic-curve-to _
    (param hx Coord)
    (param hy Coord)
    (param x Coord)
    (param y Coord)
    (let start last-point)
    (let j (/ 2.0 3.0))
    (let hox (+ (. start x) (* j (- hx (. start x)))))
    (let hoy (+ (. start y) (* j (- hy (. start y)))))
    (let hix (+ x (* j (- hx x))))
    (let hiy (+ y (* j (- hy y))))
    (blank)
    (call cubic-curve-to hox hoy hix hiy x y)
  )
  (fn-do + cubic-curve-to _
    (param ho Point)
    (param hi Point)
    (param anchor Point)
    (call cubic-curve-to (. ho x) (. ho y) (. hi x) (. hi y) (. anchor x) (. anchor y))
  )
  (fn-do + cubic-curve-to _
    (param hox Coord)
    (param hoy Coord)
    (param hix Coord)
    (param hiy Coord)
    (param x Coord)
    (param y Coord)
    (probe-count graphics.path.build.cubics)
    (let start (call append-command .path-verb-cubic 6))
    (= ([] coords start) hox)
    (= ([] coords (+ start 1)) hoy)
    (= ([] coords (+ start 2)) hix)
    (= ([] coords (+ start 3)) hiy)
    (= ([] coords (+ start 4)) x)
    (= ([] coords (+ start 5)) y)
  )
  (fn-do + arc _
    (param point Point)
    (param radius Length)
    (param start-angle Radians)
    (param end-angle Radians)
    (param ccw _ (= false))
    (param is-continued _ (= false))
