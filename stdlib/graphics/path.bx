              (arg current-x)
              (arg current-y)
              (arg current-x)
              (arg current-y)
              (arg x2)
              (arg y2)
              (arg x2)
              (arg y2)
            )
          )
          (= current-x x2)
          (= current-y y2)
        )
        (else-if (and (== verb .path-verb-cubic) has-current)
          (let hox ([] coords start))
          (let hoy ([] coords (+ start 1)))
          (let hix ([] coords (+ start 2)))
          (let hiy ([] coords (+ start 3)))
          (let x2 ([] coords (+ start 4)))
          (let y2 ([] coords (+ start 5)))
          (return-if true (if (call point-on-cubic point current-x current-y hox hoy hix hiy x2 y2)))
          (blank)
          (probe-count graphics.path.contains.curves)
          (call get-crossings-at
            (block
              (arg crossings)
              (arg point)
              (arg current-x)
              (arg current-y)
              (arg hox)
              (arg hoy)
              (arg hix)
              (arg hiy)
              (arg x2)
              (arg y2)
            )
          )
          (= current-x x2)
          (= current-y y2)
        )
        (else-if (and (== verb .path-verb-close) has-current)
          (if (or (!= current-x subpath-x) (!= current-y subpath-y))
            (return-if true (if (call point-on-segment point current-x current-y subpath-x subpath-y)))
            (blank)
            (probe-count graphics.path.contains.curves)
            (call get-crossings-at
              (block
                (arg crossings)
                (arg point)
                (arg current-x)
                (arg current-y)
                (arg current-x)
                (arg current-y)
                (arg subpath-x)
                (arg subpath-y)
                (arg subpath-x)
                (arg subpath-y)
              )
            )
          )
          (= current-x subpath-x)
          (= current-y subpath-y)
        )
      )
    )
    (blank)
    (if (and (not is-closed) (> command-count 1))
      (probe-count graphics.path.contains.curves)
      (call get-open-closer-crossings-at crossings point)
    )
    (blank)
    (return (or (== (/and/ ([] crossings 0) 1) 1) (== (/and/ ([] crossings 1) 1) 1)))
  )
