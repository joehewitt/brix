    (call mark-mutated)
  )
  (fn-do + translate _
    (param distance Point)
    (for (in i (..< 0 coord-count (by: 2)))
      (+= ([] coords i) (. distance x))
      (+= ([] coords (+ i 1)) (. distance y))
    )
    (call mark-mutated)
  )
