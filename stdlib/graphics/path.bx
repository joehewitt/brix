    (call path-curves-contain closed-curves point fill-rule)
  )
  (fn-do + contains _
    (param point Point)
    (param crossings (list Int))
    (probe-count graphics.path.contains.calls)
    (let bbox (call get-control-bounding-box))
    (return-if (if (not (call (. bbox contains) point))))
    (blank)
    (if is-line-polygon
      (return (call contains-line-polygon point))
    )
    (blank)
    (if (< (. crossings length) 2)
      (call (. crossings clear))
      (+= crossings 0)
      (+= crossings 0)
      (else
        (= ([] crossings 0) 0)
        (= ([] crossings 1) 0)
      )
    )
    (let current-x Coord)
    (let current-y Coord)
    (let subpath-x Coord)
    (let subpath-y Coord)
    (let has-current false)
    (for (in i (..< 0 command-count))
      (let verb ([] verbs i))
      (let start ([] coord-offsets i))
      (if (== verb .path-verb-move)
        (= current-x ([] coords start))
        (= current-y ([] coords (+ start 1)))
