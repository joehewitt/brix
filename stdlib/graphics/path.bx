  )
  (fn-do + mirror-y _
    (param cy (? Coord))
    (let cyy (?? cy (. bounding-box center y)))
    (for (in i (..< 1 coord-count (by: 2)))
      (let y ([] coords i))
      (= ([] coords i) (if-expr (< y cyy) (- cyy (- y cyy)) (+ cyy (- cyy y))))
