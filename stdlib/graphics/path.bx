    (param bbox-start Rect)
    (param bbox-end Rect)
    (call begin-mutation)
    (let origin (. bbox-start center))
    (let scaler
      (call Dimensions
        (block
          (arg (/ (. bbox-end width) (. bbox-start width)))
          (arg (/ (. bbox-end height) (. bbox-start height)))
        )
      )
    )
    (let offset
      (call Point
        (block
          (arg (/ (- (. bbox-end x) (. bbox-start x)) (. scaler width)))
          (arg (/ (- (. bbox-end y) (. bbox-start y)) (. scaler height)))
        )
      )
    )
    (blank)
    (if matrix
      (let inverse-matrix (call (. matrix create-inverse)))
      (if inverse-matrix
        (call transform inverse-matrix)
      )
    )
    (blank)
    (let mx
      (call matrix-from-translation
        (block
          (arg
            (call Point
              (block
                (arg (- (. origin x) (/ (. bbox-start width) 2)))
                (arg (- (. origin y) (/ (. bbox-start height) 2)))
