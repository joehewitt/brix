(import ./curve-kernels)
(import ./effect)
(import ./offset-kernels)
(import ./path)
(import ./point)
(import ./primitives)
(import ./shapes)
(import /math)
(blank)
(prop _ stroke-teeny _ (= 0.000001))
(prop _ stroke-inversion-samples _ (= 32))
(prop _ stroke-patch-tolerance _ (= 0.25))
(blank)
(type-line _ StrokeZone (is (tuple (: start PointOnCurve) (: end PointOnCurve))))

(type + JoinType
  (variant bevel-join-type)
  (variant square-join-type)
  (variant miter-join-type)
  (variant round-join-type)
)

(type + StrokeEffect (is VectorEffect)
  (prop + width _ (=> effect-width))
  (prop + join-type _ (=> effect-join-type))
  (prop + cap _ (=> effect-cap))
  (prop + miter-limit _ (=> effect-miter-limit))
  (blank)
  (prop _ effect-width Length)
  (prop _ effect-join-type JoinType (= .round-join-type))
  (prop _ effect-cap LineCap (= .round))
  (prop _ effect-miter-limit Length (= 4))
  (fn-do + This _
    (param value Length)
    (param join JoinType (= .round-join-type))
    (param end LineCap (= .round))
    (param limit Length (= 4))
    (= effect-width value)
    (= effect-join-type join)
    (= effect-cap end)
    (= effect-miter-limit limit)
  )
  (fn-expr + equals _
    (param other VectorEffect)
    (case? (not (is other StrokeEffect))
      false
    )
    (default
      (and (== enabled (. stroked enabled)) same-shape (== miter-limit (. stroked miter-limit)))
    )
    (where
      (lazy stroked (as other StrokeEffect))
      (lazy same-shape (and (== width (. stroked width)) (== join-type (. stroked join-type)) (== cap (. stroked cap))))
    )
  )
  (fn-do + apply _
    (param source (list Path))
    (let result (call Path))
    (for (in path source)
      (let outline (call stroke path width .center join-type cap miter-limit))
      (if (. outline count)
        (call (. result add-path) outline)
      )
    )
    (return (if-expr (. result count) (list result) (call (of List Path))))
  )
  (fn-expr + copy _
    (call StrokeEffect effect-width effect-join-type effect-cap effect-miter-limit)
  )
)

(fn-do + stroke _
  (param path Path)
  (param width Length)
  (param alignment StrokeAlignment (= .center))
  (param join-type JoinType (= .bevel-join-type))
  (param cap LineCap (= .butt))
  (param miter-limit Length (= 1))
  (param offset Length (= 0))
  (if (or (<= width 0) (< (. path count) 2))
    (return (call Path))
  )
  (blank)
  (let outer-distance
    (block
      (case? (== alignment .center)
        (+ offset (/ width 2))
      )
      (case? (== alignment .outside)
        (+ offset width)
      )
      (default
        offset
      )
    )
  )
  (let inner-distance
    (block
      (case? (== alignment .center)
        (- offset (/ width 2))
      )
      (case? (== alignment .outside)
        offset
      )
      (default
        (- offset width)
      )
    )
  )
  (blank)
  (let result (call Path))
  (for (in subpath (. path subpaths))
    (let stroked
      (call stroke-subpath
        (block
          (arg (call (. subpath materialize)))
          (arg width)
          (arg outer-distance)
          (arg inner-distance)
          (arg join-type)
          (arg cap)
          (arg miter-limit)
        )
      )
    )
    (if (. stroked count)
      (call (. result add-path) stroked)
    )
  )
  (blank)
  (return result)
)

(fn-do + stroke-join Path
  (param pivot Point)
  (param incoming Point)
  (param outgoing Point)
  (param width Length)
  (param join-type JoinType (= .round-join-type))
  (param miter-limit Length (= 4))
  (return-if (call Path) (if (or (<= width 0) (<= (. incoming length) stroke-teeny) (<= (. outgoing length) stroke-teeny))))
  (let first (/ incoming (. incoming length)))
  (let second (/ outgoing (. outgoing length)))
  (let radius (/ width 2))
  (let contour (call StrokeContour width radius (- radius) join-type .butt miter-limit 1))
  (let first-normal (call stroke-unit-normal first 1))
  (let second-normal (call stroke-unit-normal second 1))
  (call (. contour outer line-to) pivot)
  (call (. contour outer line-to) (+ pivot (* first-normal radius)))
  (call (. contour inner line-to) pivot)
  (call (. contour inner line-to) (- pivot (* first-normal radius)))
  (call (. contour add-contour-join) pivot first-normal second-normal first second (:is-line false))
  (call (. contour outer line-to) pivot)
  (call (. contour inner line-to) pivot)
  (call (. contour outer close))
  (call (. contour inner close))
  (return (if-expr (< (call (. first cross) second) 0) (call Path (. contour inner path)) (call Path (. contour outer path))))
)

(type _ StrokeContour
  (prop + width Length)
  (prop + radius Length)
  (prop + outer-distance Length)
  (prop + inner-distance Length)
  (prop + join-type JoinType)
  (prop + cap LineCap)
  (prop + miter-limit Length)
  (prop + normal-sign Float)
  (prop + outer _ (= (call OffsetPathWriter)))
  (prop + inner _ (= (call OffsetPathWriter)))
  (prop + patches _ (= (call Path)))
  (prop + first-point Point)
  (prop + prev-point Point)
  (prop + first-unit-normal Point)
  (prop + prev-unit-normal Point)
  (prop + first-tangent Point)
  (prop + prev-tangent Point)
  (prop + first-outer-point Point)
  (prop + first-is-line _ (= false))
  (prop + segment-count Size)
  (prop + has-current _ (= false))
  (prop + has-zero-draw _ (= false))
  (fn-do + This _
    (param width Length)
    (param outer-distance Length)
    (param inner-distance Length)
    (param join-type JoinType)
    (param cap LineCap)
    (param miter-limit Length)
    (param normal-sign Float)
    (= radius (/ width 2))
  )
  (fn-do + move-to _
    (param point Point)
    (= first-point point)
    (= prev-point point)
    (= has-current true)
    (= has-zero-draw false)
    (= segment-count 0)
    (call (. outer reset))
    (call (. inner reset))
    (= patches (call Path))
  )
  (fn-do + mark-zero-draw _
    (if has-current
      (= has-zero-draw true)
    )
  )
  (fn-do + line-to _
    (param point Point)
    (call line-to point (:is-line true))
  )
  (fn-do + line-to _
    (param point Point)
    (param is-line Bool)
    (if (not has-current)
      (call move-to point)
      (return)
    )
    (let delta (- point prev-point))
    (let len (. delta length))
    (if (<= len stroke-teeny)
      (= has-zero-draw true)
      (probe-count graphics.stroke.teeny-drops)
      (return)
    )
    (let tangent (/ delta len))
    (let unit-normal (call stroke-unit-normal tangent normal-sign))
    (call pre-join-to unit-normal tangent (:is-line))
    (call append-line-to-offsets point unit-normal)
    (call post-join-to point unit-normal tangent)
  )
  (fn-do + cubic-to _
    (param handle-out Point)
    (param handle-in Point)
    (param point Point)
    (if (not has-current)
      (call move-to point)
      (return)
    )
    (if (call cubic-is-point-like prev-point handle-out handle-in point)
      (= has-zero-draw true)
      (return)
    )
    (if (call cubic-is-line-like prev-point handle-out handle-in point)
      (let saved-join join-type)
      (= join-type .round-join-type)
      (call line-to point (:is-line false))
      (= join-type saved-join)
      (return)
    )
    (let start-tangent (call cubic-tangent-at prev-point handle-out handle-in point 0))
    (let end-tangent (call cubic-tangent-at prev-point handle-out handle-in point 1))
    (let start-normal (call stroke-unit-normal start-tangent normal-sign))
    (let end-normal (call stroke-unit-normal end-tangent normal-sign))
    (blank)
    (call pre-join-to start-normal start-tangent (:is-line false))
    (call append-cubic-side outer prev-point handle-out handle-in point outer-distance)
    (call append-cubic-side inner prev-point handle-out handle-in point inner-distance)
    (blank)
    (let cusp (call cubic-cusp-parameter prev-point handle-out handle-in point))
    (if (> cusp 0)
      (probe-count graphics.stroke.cusp-patches)
      (let loc (call cubic-point prev-point handle-out handle-in point cusp))
      (call add-patch (call circle loc radius))
    )
    (blank)
    (call post-join-to point end-normal end-tangent)
  )
  (fn-do + finish _
    (param close Bool)
    (if (<= segment-count 0)
      (return (if-expr has-zero-draw (call zero-length-stroke first-point width cap) (call Path)))
    )
    (blank)
    (if close
      (call add-contour-join
        (block
          (arg prev-point)
          (arg prev-unit-normal)
          (arg first-unit-normal)
          (arg prev-tangent)
          (arg first-tangent)
          (:is-line first-is-line)
        )
      )
      (call (. outer close))
      (call (. inner close))
      (let outline (call Path))
      (call (. outline add-path) (. outer path))
      (call (. outline add-path) (call (. inner path reverse)))
      (call (. outline add-path) patches)
      (return outline)
    )
    (blank)
    (let outline (call Path (. outer path)))
    (let reversed-inner (call (. inner path reverse)))
    (call add-stroke-cap
      (block
        (arg outline)
        (arg prev-tangent)
        (arg (. outer last))
        (arg (. inner last))
        (arg width)
        (arg cap)
        (:is-end-cap true)
      )
    )
    (call append-path-tail outline reversed-inner)
    (call add-stroke-cap
      (block
        (arg outline)
        (arg first-tangent)
        (arg (. inner first))
        (arg first-outer-point)
        (arg width)
        (arg cap)
        (:is-end-cap false)
      )
    )
    (call (. outline close))
    (call (. outline add-path) patches)
    (return outline)
  )
  (fn-do _ append-cubic-side _
    (param writer OffsetPathWriter)
    (param p0 Point)
    (param p1 Point)
    (param p2 Point)
    (param p3 Point)
    (param distance Length)
    (let last-t PointOnCurve 0)
    (for (in zone (call inverted-stroke-zones p0 p1 p2 p3 distance normal-sign))
      (if (> (. zone start) last-t)
        (call append-offset-range writer p0 p1 p2 p3 last-t (. zone start) distance)
      )
      (call hug-inverted-range writer p0 p1 p2 p3 zone distance)
      (= last-t (. zone end))
    )
    (if (< last-t 1)
      (call append-offset-range writer p0 p1 p2 p3 last-t 1 distance)
    )
  )
  (fn-do _ append-offset-range _
    (param writer OffsetPathWriter)
    (param p0 Point)
    (param p1 Point)
    (param p2 Point)
    (param p3 Point)
    (param t0 PointOnCurve)
    (param t1 PointOnCurve)
    (param distance Length)
    (let piece (call cubic-range-scalars (. p0 x) (. p0 y) (. p1 x) (. p1 y) (. p2 x) (. p2 y) (. p3 x) (. p3 y) t0 t1))
    (call append-offset-cubic-split-inflections
      (block
        (arg writer)
        (arg (call Point (. piece x1) (. piece y1)))
        (arg (call Point (. piece hox) (. piece hoy)))
        (arg (call Point (. piece hix) (. piece hiy)))
        (arg (call Point (. piece x2) (. piece y2)))
        (arg distance)
        (arg normal-sign)
      )
    )
  )
  (fn-do _ hug-inverted-range _
    (param writer OffsetPathWriter)
    (param p0 Point)
    (param p1 Point)
    (param p2 Point)
    (param p3 Point)
    (param zone StrokeZone)
    (param distance Length)
    (probe-count graphics.stroke.inverted-zones)
    (let piece (call cubic-range-scalars (. p0 x) (. p0 y) (. p1 x) (. p1 y) (. p2 x) (. p2 y) (. p3 x) (. p3 y) (. zone start) (. zone end)))
    (call (. writer line-to) (call Point (. piece x1) (. piece y1)))
    (call (. writer cubic-curve-to)
      (block
        (arg (call Point (. piece hox) (. piece hoy)))
        (arg (call Point (. piece hix) (. piece hiy)))
        (arg (call Point (. piece x2) (. piece y2)))
      )
    )
    (call (. writer line-to) (call offset-cubic-point p0 p1 p2 p3 (. zone end) distance normal-sign))
    (blank)
    (let steps (call inverted-patch-steps p0 p1 p2 p3 zone distance))
    (let previous-t (. zone start))
    (let previous-normal (call stroke-unit-normal (call cubic-tangent-at p0 p1 p2 p3 (. zone start)) normal-sign))
    (for (in index (..< 0 steps))
      (let t (+ (. zone start) (/ (* (- (. zone end) (. zone start)) (as (+ index 1) Float)) steps)))
      (let normal (call stroke-unit-normal (call cubic-tangent-at p0 p1 p2 p3 t) normal-sign))
      (let arc (call cubic-range-scalars (. p0 x) (. p0 y) (. p1 x) (. p1 y) (. p2 x) (. p2 y) (. p3 x) (. p3 y) previous-t t))
      (call add-brush-patch arc previous-normal normal distance)
      (= previous-t t)
      (= previous-normal normal)
    )
  )
  (fn-do _ add-brush-patch _
    (param arc CurveRangeScalars)
    (param normal-a Point)
    (param normal-b Point)
    (param distance Length)
    (let near-a (call Point (. arc x1) (. arc y1)))
    (let near-b (call Point (. arc x2) (. arc y2)))
    (let handle-a (call Point (. arc hox) (. arc hoy)))
    (let handle-b (call Point (. arc hix) (. arc hiy)))
    (let far-a (+ near-a (* normal-a distance)))
    (let far-b (+ near-b (* normal-b distance)))
    (let denominator (call (. normal-a cross) normal-b))
    (if (> (call abs denominator) stroke-teeny)
      (let along-a (/ (call (. (- near-b near-a) cross) normal-b) denominator distance))
      (let along-b (/ (call (. (- near-b near-a) cross) normal-a) denominator distance))
      (if (and (> along-a 0) (< along-a 1) (> along-b 0) (< along-b 1))
        (let crossing (+ near-a (* normal-a (* along-a distance))))
        (if (call patch-is-forward (call (. (- near-b near-a) cross) (- crossing near-a)))
          (call (. patches move-to) near-a)
          (call (. patches cubic-curve-to) handle-a handle-b near-b)
          (else
            (call (. patches move-to) near-b)
            (call (. patches cubic-curve-to) handle-b handle-a near-a)
          )
        )
        (call (. patches line-to) crossing)
        (call (. patches close))
        (call (. patches move-to) crossing)
        (if (call patch-is-forward (call (. (- far-b crossing) cross) (- far-a crossing)))
          (call (. patches line-to) far-b)
          (call (. patches line-to) far-a)
          (else
            (call (. patches line-to) far-a)
            (call (. patches line-to) far-b)
          )
        )
        (call (. patches close))
        (return)
      )
    )
    (let twice-area (+ (call (. near-a cross) near-b) (call (. near-b cross) far-b) (call (. far-b cross) far-a) (call (. far-a cross) near-a)))
    (call (. patches move-to) near-a)
    (if (call patch-is-forward twice-area)
      (call (. patches cubic-curve-to) handle-a handle-b near-b)
      (call (. patches line-to) far-b)
      (call (. patches line-to) far-a)
      (else
        (call (. patches line-to) far-a)
        (call (. patches line-to) far-b)
        (call (. patches line-to) near-b)
        (call (. patches cubic-curve-to) handle-b handle-a near-a)
      )
    )
    (call (. patches close))
  )
  (fn-expr _ patch-is-forward _
    (param twice-area Float)
    (>= (* twice-area normal-sign) 0)
  )
  (fn-do _ add-patch _
    (param patch Path)
    (call (. patches add-path) (if-expr (== (. patch is-clockwise) (> normal-sign 0)) patch (call (. patch reverse))))
  )
  (fn-do _ pre-join-to _
    (param unit-normal Point)
    (param tangent Point)
    (param is-line Bool)
    (if (== segment-count 0)
      (= first-unit-normal unit-normal)
      (= prev-unit-normal unit-normal)
      (= first-tangent tangent)
      (= prev-tangent tangent)
      (= first-outer-point (+ prev-point (* unit-normal outer-distance)))
      (= first-is-line is-line)
      (call (. outer line-to) first-outer-point)
      (call (. inner line-to) (+ prev-point (* unit-normal inner-distance)))
      (else
        (call add-contour-join
          (block
            (arg prev-point)
            (arg prev-unit-normal)
            (arg unit-normal)
            (arg prev-tangent)
            (arg tangent)
            (:is-line)
          )
        )
      )
    )
  )
  (fn-do _ append-line-to-offsets _
    (param point Point)
    (param unit-normal Point)
    (call (. outer line-to) (+ point (* unit-normal outer-distance)))
    (call (. inner line-to) (+ point (* unit-normal inner-distance)))
  )
  (fn-do _ post-join-to _
    (param point Point)
    (param unit-normal Point)
    (param tangent Point)
    (= prev-point point)
    (= prev-unit-normal unit-normal)
    (= prev-tangent tangent)
    (+= segment-count 1)
  )
  (fn-do _ add-contour-join _
    (param pivot Point)
    (param before-normal Point)
    (param after-normal Point)
    (param before-tangent Point)
    (param after-tangent Point)
    (param is-line Bool)
    (probe-count graphics.stroke.joins)
    (call add-side-join
      (block
        (arg outer)
        (arg pivot)
        (arg before-normal)
        (arg after-normal)
        (arg before-tangent)
        (arg after-tangent)
        (arg outer-distance)
        (:is-line)
      )
    )
    (call add-side-join
      (block
        (arg inner)
        (arg pivot)
        (arg before-normal)
        (arg after-normal)
        (arg before-tangent)
        (arg after-tangent)
        (arg inner-distance)
        (:is-line)
      )
    )
  )
  (fn-do _ add-side-join _
    (param writer OffsetPathWriter)
    (param pivot Point)
    (param before-normal Point)
    (param after-normal Point)
    (param before-tangent Point)
    (param after-tangent Point)
    (param distance Length)
    (param is-line Bool)
    (let before-offset (+ pivot (* before-normal distance)))
    (let after-offset (+ pivot (* after-normal distance)))
    (let turn (call (. before-tangent cross) after-tangent))
    (blank)
    (if (<= (call abs distance) stroke-teeny)
      (call (. writer line-to) pivot)
      (return)
    )
    (if (<= (call abs turn) stroke-teeny)
      (if (>= (call (. before-tangent dot) after-tangent) -0.999)
        (call (. writer line-to) after-offset)
        (else-if (== join-type .square-join-type)
          (call append-square-join writer pivot before-normal after-normal before-tangent after-tangent distance (:is-line))
        )
        (else
          (call (. writer line-to) before-offset)
          (call (. writer line-to) after-offset)
        )
      )
      (return)
    )
    (if (< (* turn distance normal-sign) 0)
      (call (. writer line-to) pivot)
      (call (. writer line-to) after-offset)
      (return)
    )
    (if (== join-type .miter-join-type)
      (call add-miter-side-join writer pivot before-normal after-normal distance (:is-line))
      (else-if (== join-type .round-join-type)
        (call add-round-stroke-join writer pivot before-offset after-offset distance normal-sign)
      )
      (else-if (== join-type .square-join-type)
        (call append-square-join writer pivot before-normal after-normal before-tangent after-tangent distance (:is-line))
      )
      (else
        (call (. writer line-to) after-offset)
      )
    )
  )
  (fn-do _ add-miter-side-join _
    (param writer OffsetPathWriter)
    (param pivot Point)
    (param before-normal Point)
    (param after-normal Point)
    (param distance Length)
    (param is-line Bool)
    (let dot (call (. before-normal dot) after-normal))
    (if (or (> dot 0.999) (<= miter-limit 1))
      (call (. writer line-to) (+ pivot (* after-normal distance)))
      (return)
    )
    (if (< dot -0.999)
      (call (. writer line-to) (+ pivot (* before-normal distance)))
      (call (. writer line-to) (+ pivot (* after-normal distance)))
      (return)
    )
    (let sin-half (call sqrt (call max 0.0 (/ (+ 1.0 dot) 2.0))))
    (if (or (<= sin-half 0) (< sin-half (/ 1.0 miter-limit)))
      (call (. writer line-to) (+ pivot (* after-normal distance)))
      (return)
    )
    (let mid Point)
    (if (and (<= (call abs dot) stroke-teeny) (>= miter-limit 1.41421356237))
      (= mid (* (+ before-normal after-normal) distance))
      (else
        (let sum (+ before-normal after-normal))
        (let sum-length (. sum length))
        (if (<= sum-length stroke-teeny)
          (call (. writer line-to) (+ pivot (* after-normal distance)))
          (return)
        )
        (= mid (* (/ sum sum-length) (/ (call abs distance) sin-half)))
        (if (< distance 0)
          (= mid (- mid))
        )
      )
    )
    (blank)
    (call (. writer line-to) (+ pivot mid))
    (if (not is-line)
      (call (. writer line-to) (+ pivot (* after-normal distance)))
    )
  )
)

(fn-do _ stroke-subpath _
  (param path Path)
  (param width Length)
  (param outer-distance Length)
  (param inner-distance Length)
  (param join-type JoinType)
  (param cap LineCap)
  (param miter-limit Length)
  (probe-count graphics.stroke.subpaths)
  (let normal-sign (if-expr (and (. path is-closed) (not (. path is-clockwise))) -1.0 1.0))
  (blank)
  (let contour
    (call StrokeContour
      (block
        (arg width)
        (arg outer-distance)
        (arg inner-distance)
        (arg join-type)
        (arg cap)
        (arg miter-limit)
        (arg normal-sign)
      )
    )
  )
  (let span (. path commands))
  (let current (call Point 0 0))
  (let subpath-start (call Point 0 0))
  (let has-current false)
  (let closed false)
  (blank)
  (for (in i (..< 0 (. span command-count)))
    (let verb ([] (. span verbs) i))
    (let start ([] (. span coord-offsets) i))
    (if (== verb .path-verb-move)
      (= current (call Point ([] (. span coords) start) ([] (. span coords) (+ start 1))))
      (= subpath-start current)
      (= has-current true)
      (call (. contour move-to) current)
      (else-if (and (== verb .path-verb-line) has-current)
        (= current (call Point ([] (. span coords) start) ([] (. span coords) (+ start 1))))
        (call (. contour line-to) current)
      )
      (else-if (and (== verb .path-verb-cubic) has-current)
        (let h1 (call Point ([] (. span coords) start) ([] (. span coords) (+ start 1))))
        (let h2 (call Point ([] (. span coords) (+ start 2)) ([] (. span coords) (+ start 3))))
        (= current (call Point ([] (. span coords) (+ start 4)) ([] (. span coords) (+ start 5))))
        (call (. contour cubic-to) h1 h2 current)
      )
      (else-if (and (== verb .path-verb-close) has-current)
        (= closed true)
        (if (> (call (. current distance) subpath-start) stroke-teeny)
          (call (. contour line-to) subpath-start)
          (else
            (call (. contour mark-zero-draw))
          )
        )
        (= current subpath-start)
      )
    )
  )
  (blank)
  (return (call (. contour finish) closed))
)

(fn-expr _ zero-length-stroke _
  (param point Point)
  (param width Length)
  (param cap LineCap)
  (case? (== cap .round)
    (call circle point (/ width 2))
  )
  (case? (== cap .square)
    (call rectangle (call Rect (- (. point x) (/ width 2)) (- (. point y) (/ width 2)) width width))
  )
  (default
    (call Path)
  )
)

(fn-do _ add-round-stroke-join _
  (param writer OffsetPathWriter)
  (param center Point)
  (param from Point)
  (param to Point)
  (param distance Length)
  (param normal-sign Float)
  (let radius (call abs distance))
  (if (or (< radius stroke-teeny) (< (call (. from distance) to) stroke-teeny))
    (call (. writer line-to) to)
    (else
      (call (. writer line-to) from)
      (call (. writer arc) center radius (call (. from angle) center) (call (. to angle) center) (< (* distance normal-sign) 0))
    )
  )
)

(fn-do _ add-stroke-cap _
  (param outline Path)
  (param tangent Point)
  (param from Point)
  (param to Point)
  (param width Length)
  (param cap LineCap)
  (param is-end-cap Bool)
  (if (== cap .round)
    (call add-round-stroke-cap outline from to)
    (else-if (== cap .square)
      (let extension (* tangent (/ width 2)))
      (if (not is-end-cap)
        (= extension (- extension))
      )
      (call stroke-path-line-to outline (+ from extension))
      (call stroke-path-line-to outline (+ to extension))
      (call stroke-path-line-to outline to)
    )
    (else
      (call stroke-path-line-to outline to)
    )
  )
)

(fn-do _ add-round-stroke-cap _
  (param outline Path)
  (param from Point)
  (param to Point)
  (let center (call (. from midpoint) to))
  (let radius (/ (call (. from distance) to) 2))
  (if (< radius stroke-teeny)
    (call stroke-path-line-to outline to)
    (else
      (call (. outline arc) center radius (call (. from angle) center) (call (. to angle) center) (:is-continued true))
    )
  )
)

(fn-do _ stroke-path-line-to _
  (param path Path)
  (param point Point)
  (if (not (. path count))
    (call (. path move-to) point)
    (else-if (> (call (. path last-point distance) point) stroke-teeny)
      (call (. path line-to) point)
    )
  )
)

(fn-do _ append-path-tail _
  (param target Path)
  (param source Path)
  (let span (. source commands))
  (let skip-first-move true)
  (for (in i (..< 0 (. span command-count)))
    (let verb ([] (. span verbs) i))
    (let start ([] (. span coord-offsets) i))
    (if (and (== verb .path-verb-move) skip-first-move)
      (= skip-first-move false)
      (continue)
      (else-if (== verb .path-verb-move)
        (call (. target line-to) ([] (. span coords) start) ([] (. span coords) (+ start 1)))
      )
      (else-if (== verb .path-verb-line)
        (call (. target line-to) ([] (. span coords) start) ([] (. span coords) (+ start 1)))
      )
      (else-if (== verb .path-verb-cubic)
        (call (. target cubic-curve-to)
          (block
            (arg ([] (. span coords) start))
            (arg ([] (. span coords) (+ start 1)))
            (arg ([] (. span coords) (+ start 2)))
            (arg ([] (. span coords) (+ start 3)))
            (arg ([] (. span coords) (+ start 4)))
            (arg ([] (. span coords) (+ start 5)))
          )
        )
      )
    )
  )
)

(fn-do _ inverted-stroke-zones (list StrokeZone)
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (param distance Length)
  (param normal-sign Float)
  (let zones (list StrokeZone))
  (return-if zones (if (or (<= (call abs distance) stroke-teeny) (not (call may-invert-stroke p0 p1 p2 p3 distance)))))
  (let previous-t PointOnCurve 0)
  (let previous-inverted (< (call stroke-inversion p0 p1 p2 p3 0 distance normal-sign) 0))
  (let start PointOnCurve 0)
  (for (in index (..< 1 (+ stroke-inversion-samples 1)))
    (let t PointOnCurve (/ (as index Float) stroke-inversion-samples))
    (let inverted (< (call stroke-inversion p0 p1 p2 p3 t distance normal-sign) 0))
    (if (!= inverted previous-inverted)
      (let boundary
        (call refine-stroke-inversion
          (block
            (arg p0)
            (arg p1)
            (arg p2)
            (arg p3)
            (arg previous-t)
            (arg t)
            (arg previous-inverted)
            (arg distance)
            (arg normal-sign)
          )
        )
      )
      (if inverted
        (= start boundary)
        (else-if (> boundary start)
          (+= zones (call StrokeZone start boundary))
        )
      )
    )
    (= previous-t t)
    (= previous-inverted inverted)
  )
  (if (and previous-inverted (< start 1))
    (+= zones (call StrokeZone start 1))
  )
  (return zones)
)

(fn-do _ refine-stroke-inversion PointOnCurve
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (param low PointOnCurve)
  (param high PointOnCurve)
  (param low-inverted Bool)
  (param distance Length)
  (param normal-sign Float)
  (let a low)
  (let b high)
  (for (in ignored (..< 0 20))
    (let middle (/ (+ a b) 2))
    (if (== (< (call stroke-inversion p0 p1 p2 p3 middle distance normal-sign) 0) low-inverted)
      (= a middle)
      (else
        (= b middle)
      )
    )
  )
  (return (/ (+ a b) 2))
)

(fn-expr _ stroke-inversion Float
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (param t PointOnCurve)
  (param distance Length)
  (param normal-sign Float)
  (+ (* speed-squared (call sqrt speed-squared)) (* distance normal-sign cross))
  (where
    (lazy sample (call min (call max t stroke-teeny) (- 1 stroke-teeny)))
    (lazy rest (- 1 sample))
    (lazy a (* 3 rest rest))
    (lazy b (* 6 rest sample))
    (lazy c (* 3 sample sample))
    (lazy first-x (+ (* a (- (. p1 x) (. p0 x))) (* b (- (. p2 x) (. p1 x))) (* c (- (. p3 x) (. p2 x)))))
    (lazy first-y (+ (* a (- (. p1 y) (. p0 y))) (* b (- (. p2 y) (. p1 y))) (* c (- (. p3 y) (. p2 y)))))
    (lazy second-x (* 6 (+ (* rest (+ (- (. p2 x) (* 2 (. p1 x))) (. p0 x))) (* sample (+ (- (. p3 x) (* 2 (. p2 x))) (. p1 x))))))
    (lazy second-y (* 6 (+ (* rest (+ (- (. p2 y) (* 2 (. p1 y))) (. p0 y))) (* sample (+ (- (. p3 y) (* 2 (. p2 y))) (. p1 y))))))
    (lazy speed-squared (+ (* first-x first-x) (* first-y first-y)))
    (lazy cross (- (* first-x second-y) (* first-y second-x)))
  )
)

(fn-do _ inverted-patch-steps Size
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (param zone StrokeZone)
  (param distance Length)
  (let turn 0.0)
  (let previous (call cubic-tangent-at p0 p1 p2 p3 (. zone start)))
  (for (in index (..< 1 17))
    (let tangent
      (call cubic-tangent-at
        (block
          (arg p0)
          (arg p1)
          (arg p2)
          (arg p3)
          (arg (+ (. zone start) (/ (* (- (. zone end) (. zone start)) (as index Float)) 16)))
        )
      )
    )
    (+= turn (call abs (call atan2 (call (. previous cross) tangent) (call (. previous dot) tangent))))
    (= previous tangent)
  )
  (let step-angle (call min (/ π 16) (call sqrt (/ (* 8 stroke-patch-tolerance) (call abs distance)))))
  (return (call min (call max (as (call ceil (/ turn step-angle)) Size) 1) 512))
)

(fn-expr _ may-invert-stroke Bool
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (param distance Length)
  (< (* slowest slowest) (* (call abs distance) bend))
  (where
    (lazy first (* (- p1 p0) 3))
    (lazy second (* (- p2 p1) 3))
    (lazy third (* (- p3 p2) 3))
    (lazy slowest (call origin-triangle-distance first second third))
    (lazy bend (* 2 (call max (. (- second first) length) (. (- third second) length))))
  )
)

(fn-expr _ origin-triangle-distance Float
  (param a Point)
  (param b Point)
  (param c Point)
  (case? (or (and (>= ab 0) (>= bc 0) (>= ca 0)) (and (<= ab 0) (<= bc 0) (<= ca 0)))
    0.0
  )
  (default
    (call min
      (block
        (arg (call origin-segment-distance a b))
        (arg (call min (call origin-segment-distance b c) (call origin-segment-distance c a)))
      )
    )
  )
  (where
    (lazy ab (call (. (- b a) cross) (- a)))
    (lazy bc (call (. (- c b) cross) (- b)))
    (lazy ca (call (. (- a c) cross) (- c)))
  )
)

(fn-expr _ origin-segment-distance Float
  (param a Point)
  (param b Point)
  (. (+ a (* segment along)) length)
  (where
    (lazy segment (- b a))
    (lazy length-squared (call (. segment dot) segment))
    (lazy along (if-expr (<= length-squared 0) 0.0 (call min (call max (/ (- (call (. a dot) segment)) length-squared) 0) 1)))
  )
)
