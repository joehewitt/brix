(import ./color)
(import ./gradient)
(import ./matrix)
(import ./outline)
(import ./point)
(import ./primitives)
(import ./shader)
(import ./text)
(import /BxGraphics/BxGraphics.h)
(import /math)
(import /os/file)
(import /os/path)
(import /units)
(blank)
(prop _ default-text-color _ (= white))
(prop _ native-fill-known U8 (= 1))
(prop _ native-stroke-known U8 (= 2))
(prop _ native-width-known U8 (= 4))
(prop _ native-cap-known U8 (= 8))
(prop _ native-join-known U8 (= 16))
(prop _ native-dash-known U8 (= 32))
(prop _ canvas-group-mask U8 (= 1))
(prop _ canvas-group-blur U8 (= 2))
(prop _ canvas-group-opacity U8 (= 3))
(prop _ canvas-group-filter U8 (= 4))

(type + Canvas
  (implements Closable)
  (prop + width I32)
  (prop + height I32)
  (blank)
  (prop _ state (? CanvasState))
  (prop _ spare-state (? CanvasState))
  (fn-do + This _
    (param width I32)
    (param height I32)
    (= state (call create-state))
  )
  (fn-do + close _)
  (fn-expr + fill-color _ :get
    (?. state fill-color)
  )
  (fn-expr + stroke-color _ :get
    (?. state stroke-color)
  )
  (fn-expr + stroke-width Length :get
    (?? (?. state stroke-width) 0)
  )
  (fn-expr + stroke-cap LineCap :get
    (?? (?. state stroke-cap) (. LineCap butt))
  )
  (fn-expr + stroke-join LineJoin :get
    (?? (?. state stroke-join) (. LineJoin miter))
  )
  (fn-expr + stroke-dash Length :get
    (?? (?. state stroke-dash) 0)
  )
  (fn-expr + font Font :get
    (?? (?. state font) (call system-font))
  )
  (fn-expr + text-color RGBA :get
    (?? (?. state text-color) default-text-color)
  )
  (fn-expr + blend-mode _ :get
    (?? (?. state blend-mode) (. BlendMode normal))
  )
  (fn-expr + fill-paint (? Paint) :get
    (?. state fill-paint)
  )
  (fn-expr + stroke-brush (? Brush) :get
    (?. state stroke-brush)
  )
  (fn-expr + text-fill (? ShaderFill) :get
    (?. state text-fill)
  )
  (fn-expr + shape-fill (? ShaderFill) :get
    (?. state shape-fill)
  )
  (fn-expr + current-matrix Matrix :get
    (?? (?. state current-transform) (call Matrix))
  )
  (fn-expr + scale F64 :get
    1
  )
  (fn-expr + saved-state _ :get
    (call CanvasStateScope this)
  )
  (fn-do + fill-color _ :set (param color (? RGBA))
    (call (?. state set-fill-color) color)
  )
  (fn-do + stroke-color _ :set (param color (? RGBA))
    (call (?. state set-stroke-color) color)
  )
  (fn-do + stroke-width _ :set (param width Length)
    (call (?. state set-stroke-width) width)
  )
  (fn-do + stroke-cap _ :set (param cap LineCap)
    (call (?. state set-stroke-cap) cap)
  )
  (fn-do + stroke-join _ :set (param join LineJoin)
    (call (?. state set-stroke-join) join)
  )
  (fn-do + stroke-dash _ :set (param length Length)
    (call (?. state set-stroke-dash) length)
  )
  (fn-do + font _ :set (param font Font)
    (call (?. state set-font) font)
  )
  (fn-do + text-color _ :set (param color RGBA)
    (call (?. state set-text-color) color)
  )
  (fn-do + blend-mode _ :set (param mode BlendMode)
    (call (?. state set-blend-mode) mode)
  )
  (fn-do + fill-paint _ :set (param paint (? Paint))
    (call (?. state set-fill-paint) paint)
  )
  (fn-do + stroke-brush _ :set (param brush (? Brush))
    (call (?. state set-stroke-brush) brush)
  )
  (fn-do + text-fill _ :set (param fill (? ShaderFill))
    (call (?. state set-text-fill) fill)
  )
  (fn-do + shape-fill _ :set (param fill (? ShaderFill))
    (call (?. state set-shape-fill) fill)
  )
  (fn-do + write _ (?! Error)
    (param path Path)
  )
  (fn-do + push _
    (probe-count gui.canvas.state-pushes)
    (let current (!! state))
    (let next (?? spare-state (call create-state)))
    (= spare-state (. next previous))
    (call (. next copy-from) current)
    (= (. next previous) current)
    (= state next)
  )
  (fn-do + pop _
    (let current state)
    (let previous (?. current previous))
    (if (and current previous)
      (= (. current previous) spare-state)
      (= spare-state current)
      (= state previous)
      (else
        (= state (call create-state))
      )
    )
  )
  (fn-expr + create-state CanvasState
    (call CanvasState)
  )
  (fn-do + erase _
    (param color (? RGBA))
  )
  (fn-do + fill-gradient _
    (param rect Rect)
    (param gradient Gradient)
  )
  (fn-do + fill-shader _
    (param rect Rect)
    (param shader Shader)
    (param args (list F64) (= (call (of List F64))))
  )
  (fn-do + begin-filter _
    (param rect Rect)
    (param filter ShaderFilter)
  )
  (fn-do + end-filter _)
  (fn-do + rect _
    (param rect Rect)
  )
  (fn-do + square _
    (param x Coord)
    (param y Coord)
    (param width Length)
  )
  (fn-do + oval _
    (param rect Rect)
  )
  (fn-do + circle _
    (param cx Coord)
    (param cy Coord)
    (param radius Length)
  )
  (fn-do + move _
    (param x Coord)
    (param y Coord)
  )
  (fn-do + line _
    (param point Point)
    (call line (. point x) (. point y))
  )
  (fn-do + line _
    (param point1 Point)
    (param point2 Point)
    (call line (. point1 x) (. point1 y) (. point2 x) (. point2 y))
  )
  (fn-do + line _
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (call begin)
    (call move x1 y1)
    (call line x2 y2)
    (call end)
  )
  (fn-do + line _
    (param x Coord)
    (param y Coord)
  )
  (fn-do + curve _
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (param x3 Coord)
    (param y3 Coord)
    (param x4 Coord)
    (param y4 Coord)
    (call begin)
    (call move x1 y1)
    (call curve x2 y2 x3 y3 x4 y4)
    (call end)
  )
  (fn-do + curve _
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (param x3 Coord)
    (param y3 Coord)
  )
  (fn-do + translate _
    (param x Coord)
    (param y Coord)
    (call transform (call matrix-from-translation (call Point x y)))
  )
  (fn-do + transform _
    (param matrix Matrix)
    (call (?. state concatenate-transform) matrix)
  )
  (fn-do + transform-content _
    (param matrix Matrix)
    (call transform matrix)
  )
  (fn-do + outline _
    (param shape Outline)
    (call begin)
    (call outline-path shape)
    (call end)
  )
  (fn-do + rect-path _
    (param rect Rect)
    (call move (. rect x) (. rect y))
    (call line (. rect right) (. rect y))
    (call line (. rect right) (. rect bottom))
    (call line (. rect x) (. rect bottom))
    (call enclose)
  )
  (fn-do + oval-path _
    (param rect Rect)
    (let rx (/ (. rect width) 2))
    (let ry (/ (. rect height) 2))
    (let cx (+ (. rect x) rx))
    (let cy (+ (. rect y) ry))
    (let kx (* rx 0.5522847498307936))
    (let ky (* ry 0.5522847498307936))
    (call move (+ cx rx) cy)
    (call curve (+ cx rx) (+ cy ky) (+ cx kx) (+ cy ry) cx (+ cy ry))
    (call curve (- cx kx) (+ cy ry) (- cx rx) (+ cy ky) (- cx rx) cy)
    (call curve (- cx rx) (- cy ky) (- cx kx) (- cy ry) cx (- cy ry))
    (call curve (+ cx kx) (- cy ry) (+ cx rx) (- cy ky) (+ cx rx) cy)
    (call enclose)
  )
  (fn-do + outline-path _
    (param shape Outline)
    (let b (. shape bounds))
    (return-if (if (or (<= (. b width) 0) (<= (. b height) 0))))
    (let r (. shape effective-radius))
    (let k (* r 0.4477152501692064))
    (let side (?. (. shape arrow) side))
    (let size (?? (?. (. shape arrow) size) 0))
    (let tip (. shape arrow-tip))
    (let half (. shape arrow-half))
    (let arrowed (and (!= side null) (> half 0) (> size 0)))
    (call move (+ (. b x) r) (. b y))
    (if (and arrowed (== side (. Side top)))
      (call line (- (+ (. b x) tip) half) (. b y))
      (call line (+ (. b x) tip) (- (. b y) size))
      (call line (+ (. b x) tip half) (. b y))
    )
    (call line (- (. b right) r) (. b y))
    (if (> r 0)
      (call curve (- (. b right) k) (. b y) (. b right) (+ (. b y) k) (. b right) (+ (. b y) r))
    )
    (if (and arrowed (== side (. Side right)))
      (call line (. b right) (- (+ (. b y) tip) half))
      (call line (+ (. b right) size) (+ (. b y) tip))
      (call line (. b right) (+ (. b y) tip half))
    )
    (call line (. b right) (- (. b bottom) r))
    (if (> r 0)
      (call curve (. b right) (- (. b bottom) k) (- (. b right) k) (. b bottom) (- (. b right) r) (. b bottom))
    )
    (if (and arrowed (== side (. Side bottom)))
      (call line (+ (. b x) tip half) (. b bottom))
      (call line (+ (. b x) tip) (+ (. b bottom) size))
      (call line (- (+ (. b x) tip) half) (. b bottom))
    )
    (call line (+ (. b x) r) (. b bottom))
    (if (> r 0)
      (call curve (+ (. b x) k) (. b bottom) (. b x) (- (. b bottom) k) (. b x) (- (. b bottom) r))
    )
    (if (and arrowed (== side (. Side left)))
      (call line (. b x) (+ (. b y) tip half))
      (call line (- (. b x) size) (+ (. b y) tip))
      (call line (. b x) (- (+ (. b y) tip) half))
    )
    (call line (. b x) (+ (. b y) r))
    (if (> r 0)
      (call curve (. b x) (+ (. b y) k) (+ (. b x) k) (. b y) (+ (. b x) r) (. b y))
    )
    (call enclose)
  )
  (fn-do + clip _
    (param rect Rect)
    (call begin)
    (call rect-path rect)
    (call clip-path)
  )
  (fn-do + clip-outline _
    (param shape Outline)
    (call begin)
    (call outline-path shape)
    (call clip-path)
  )
  (fn-do + clip-path _
    (param fill-rule FillRule (= (. FillRule nonzero)))
    (let ignored fill-rule)
  )
  (fn-do + clip-mask _
    (param image RasterCanvas)
    (param rect Rect)
  )
  (fn-do + begin-mask _)
  (fn-do + end-mask _)
  (fn-do + begin-blur _
    (param radius Length)
  )
  (fn-do + end-blur _)
  (fn-do + draw-image _
    (param image RasterCanvas)
    (param rect Rect)
    (param template-alpha Bool (= false))
    (param sampling _ (= (. ImageSampling smooth)))
  )
  (fn-do + fill-image _
    (param image RasterCanvas)
    (param rect Rect)
    (param tile Rect)
    (param sampling _ (= (. ImageSampling smooth)))
  )
  (fn-expr + text-layout TextLayout
    (param text String)
    (param maximum-width (? Length) (= null))
    (param overflow TextOverflow (= (. TextOverflow truncate-tail)))
    (param wrap TextWrap (= (. TextWrap no-wrap)))
    (call TextLayout text font maximum-width overflow wrap)
  )
  (fn-do + draw-text _
    (param layout TextLayout)
    (param rect Rect)
    (param alignment TextAlignment (= (. TextAlignment left)))
  )
  (fn-expr + record-vector-geometry Bool
    (param index U32)
    (param generation U32)
    (param palette (list RGBA))
    (param transform Matrix)
    (param clip (? Rect))
    false
  )
  (fn-expr + record-image-resource Bool
    (param index U32)
    (param generation U32)
    (param rect Rect)
    (param tint (? RGBA))
    false
  )
  (fn-do + shadow _
    (param shape Outline)
    (param shadow Shadow)
  )
  (fn-do + shadow-path _
    (param shadow Shadow)
  )
  (fn-do + backdrop-blur _
    (param shape Outline)
    (param radius Length)
  )
  (fn-do + backdrop-shader _
    (param shape Outline)
    (param backdrop ShaderFilter)
    (param blur Length (= 0))
  )
  (fn-do + begin-opacity _
    (param opacity Ratio)
    (let ignored opacity)
  )
  (fn-do + end-opacity _)
  (fn-do + begin _)
  (fn-do + enclose _)
  (fn-do + end _
    (param closed Bool (= false))
    (param fill-rule FillRule (= (. FillRule nonzero)))
  )
  (fn-do + trace-path _
    (param verbs (of Array PathVerb))
    (param coords (of Array Coord))
    (param count Size)
    (call trace-canvas-path this verbs coords count)
  )
)

(type + CountingCanvas (is Canvas)
  (prop + command-count Size (= 0))
  (prop + state-command-count Size (= 0))
  (prop + primitive-command-count Size (= 0))
  (prop + path-command-count Size (= 0))
  (prop + path-count Size (= 0))
  (prop + path-segment-count Size (= 0))
  (prop + push-count Size (= 0))
  (prop + pop-count Size (= 0))
  (prop + color-change-count Size (= 0))
  (prop + cap-change-count Size (= 0))
  (prop + join-change-count Size (= 0))
  (prop + translate-count Size (= 0))
  (prop + transform-count Size (= 0))
  (prop + erase-count Size (= 0))
  (prop + gradient-count Size (= 0))
  (prop + shader-count Size (= 0))
  (prop + rect-count Size (= 0))
  (prop + square-count Size (= 0))
  (prop + oval-count Size (= 0))
  (prop + circle-count Size (= 0))
  (prop + immediate-line-count Size (= 0))
  (prop + immediate-curve-count Size (= 0))
  (prop + begin-count Size (= 0))
  (prop + move-count Size (= 0))
  (prop + path-line-count Size (= 0))
  (prop + path-curve-count Size (= 0))
  (prop + enclose-count Size (= 0))
  (prop + checksum Size (= 0))
  (blank)
  (prop _ current-path-segments Size (= 0))
  (fn-do + This _
    (param width I32)
    (param height I32)
    (= state (call create-state))
    (call tally 1 width height)
  )
  (fn-do + fill-color _ :set (param color (? RGBA))
    (probe-count graphics.canvas.state)
    (probe-count graphics.canvas.color-changes)
    (+= color-change-count 1)
    (+= state-command-count 1)
    (call tally-color 4 color)
    (call (?. state set-fill-color) color)
  )
  (fn-do + stroke-color _ :set (param color (? RGBA))
    (probe-count graphics.canvas.state)
    (probe-count graphics.canvas.color-changes)
    (+= color-change-count 1)
    (+= state-command-count 1)
    (call tally-color 5 color)
    (call (?. state set-stroke-color) color)
  )
  (fn-do + stroke-width _ :set (param width Length)
    (probe-count graphics.canvas.state)
    (probe-count graphics.canvas.color-changes)
    (+= color-change-count 1)
    (+= state-command-count 1)
    (call tally 6 width)
    (call (?. state set-stroke-width) width)
  )
  (fn-do + stroke-cap _ :set (param cap LineCap)
    (probe-count graphics.canvas.state)
    (+= cap-change-count 1)
    (+= state-command-count 1)
    (call tally 21 (call line-cap-key cap))
    (call (?. state set-stroke-cap) cap)
  )
  (fn-do + stroke-join _ :set (param join LineJoin)
    (probe-count graphics.canvas.state)
    (+= join-change-count 1)
    (+= state-command-count 1)
    (call tally 22 (call line-join-key join))
    (call (?. state set-stroke-join) join)
  )
  (fn-do + stroke-dash _ :set (param length Length)
    (probe-count graphics.canvas.state)
    (+= state-command-count 1)
    (call tally 25 length)
    (call (?. state set-stroke-dash) length)
  )
  (fn-do + push _
    (probe-count graphics.canvas.state)
    (+= push-count 1)
    (+= state-command-count 1)
    (call tally 2)
    (call (. super push))
  )
  (fn-do + pop _
    (probe-count graphics.canvas.state)
    (+= pop-count 1)
    (+= state-command-count 1)
    (call tally 3)
    (call (. super pop))
  )
  (fn-do + erase _
    (param color (? RGBA))
    (probe-count graphics.canvas.primitives)
    (+= erase-count 1)
    (+= primitive-command-count 1)
    (call tally-color 7 color)
  )
  (fn-do + fill-gradient _
    (param rect Rect)
    (param gradient Gradient)
    (call (. gradient validate))
    (probe-count graphics.canvas.primitives)
    (+= gradient-count 1)
    (+= primitive-command-count 1)
    (match gradient
      (case (: linear LinearGradient)
        (call tally 24 (. rect x) (. rect y) (. rect width) (. rect height) (. linear start x) (. linear start y))
        (+= checksum (+ (* (call coordinate-key (. linear end x)) 17) (* (call coordinate-key (. linear end y)) 19)))
      )
      (case (: radial RadialGradient)
        (let start (. radial start-center))
        (let end (. radial end-center))
        (call tally 25 (. rect x) (. rect y) (. rect width) (. rect height) (. start x) (. start y))
        (+= checksum (+ (* (call coordinate-key (. end x)) 17) (* (call coordinate-key (. end y)) 19)))
        (+= checksum (* (call coordinate-key (. radial start-radius)) 47))
        (+= checksum (* (call coordinate-key (. radial end-radius)) 53))
      )
      (case (: conic ConicGradient)
        (call tally 26 (. rect x) (. rect y) (. rect width) (. rect height) (. conic center x) (. conic center y))
        (+= checksum (* (call coordinate-key (. conic angle)) 17))
      )
    )
    (let stops (. gradient stops))
    (for (in index (..< 0 (. stops length)))
      (let stop ([] stops index))
      (let order (+ index 1))
      (+= checksum (+ (* order 23) (* (call coordinate-key (. stop offset)) 29)))
      (+= checksum (+ (* (call coordinate-key (. stop color red)) 31) (* (call coordinate-key (. stop color green)) 37)))
      (+= checksum (+ (* (call coordinate-key (. stop color blue)) 41) (* (call coordinate-key (. stop color alpha)) 43)))
    )
  )
  (fn-do + fill-shader _
    (param rect Rect)
    (param shader Shader)
    (param args (list F64) (= (call (of List F64))))
    (probe-count graphics.canvas.primitives)
    (+= shader-count 1)
    (+= primitive-command-count 1)
    (call tally 27 (. rect x) (. rect y) (. rect width) (. rect height) (. shader id) (as (. args length) Coord))
    (for (in index (..< 0 (. args length)))
      (+= checksum (+ (* (+ index 1) 59) (* (call coordinate-key ([] args index)) 61)))
    )
  )
  (fn-do + begin-filter _
    (param rect Rect)
    (param filter ShaderFilter)
    (probe-count graphics.canvas.state)
    (+= state-command-count 1)
    (call tally 28 (. rect x) (. rect y) (. rect width) (. rect height) (. filter shader id) (as (. filter args length) Coord))
    (for (in index (..< 0 (. filter args length)))
      (+= checksum (+ (* (+ index 1) 67) (* (call coordinate-key ([] (. filter args) index)) 71)))
    )
  )
  (fn-do + end-filter _
    (probe-count graphics.canvas.state)
    (+= state-command-count 1)
    (call tally 29)
  )
  (fn-do + rect _
    (param rect Rect)
    (probe-count graphics.canvas.primitives)
    (+= rect-count 1)
    (+= primitive-command-count 1)
    (call tally 8 (. rect x) (. rect y) (. rect width) (. rect height))
  )
  (fn-do + square _
    (param x Coord)
    (param y Coord)
    (param width Length)
    (probe-count graphics.canvas.primitives)
    (+= square-count 1)
    (+= primitive-command-count 1)
    (call tally 9 x y width)
  )
  (fn-do + oval _
    (param rect Rect)
    (probe-count graphics.canvas.primitives)
    (+= oval-count 1)
    (+= primitive-command-count 1)
    (call tally 10 (. rect x) (. rect y) (. rect width) (. rect height))
  )
  (fn-do + circle _
    (param cx Coord)
    (param cy Coord)
    (param radius Length)
    (probe-count graphics.canvas.primitives)
    (+= circle-count 1)
    (+= primitive-command-count 1)
    (call tally 11 cx cy radius)
  )
  (fn-do + move _
    (param x Coord)
    (param y Coord)
    (probe-count graphics.canvas.path.commands)
    (+= move-count 1)
    (+= path-command-count 1)
    (call tally 16 x y)
  )
  (fn-do + line _
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (probe-count graphics.canvas.primitives)
    (+= immediate-line-count 1)
    (+= primitive-command-count 1)
    (call tally 12 x1 y1 x2 y2)
  )
  (fn-do + line _
    (param x Coord)
    (param y Coord)
    (probe-count graphics.canvas.path.commands)
    (probe-count graphics.canvas.path.segments)
    (+= path-line-count 1)
    (+= path-command-count 1)
    (+= path-segment-count 1)
    (+= current-path-segments 1)
    (call tally 17 x y)
  )
  (fn-do + curve _
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (param x3 Coord)
    (param y3 Coord)
    (param x4 Coord)
    (param y4 Coord)
    (probe-count graphics.canvas.primitives)
    (+= immediate-curve-count 1)
    (+= primitive-command-count 1)
    (call tally 13 (+ x1 x2) (+ y1 y2) (+ x3 x4) (+ y3 y4))
  )
  (fn-do + curve _
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (param x3 Coord)
    (param y3 Coord)
    (probe-count graphics.canvas.path.commands)
    (probe-count graphics.canvas.path.segments)
    (+= path-curve-count 1)
    (+= path-command-count 1)
    (+= path-segment-count 1)
    (+= current-path-segments 1)
    (call tally 18 (+ x1 x2) (+ y1 y2) x3 y3)
  )
  (fn-do + translate _
    (param x Coord)
    (param y Coord)
    (probe-count graphics.canvas.state)
    (probe-count graphics.canvas.translates)
    (+= translate-count 1)
    (+= state-command-count 1)
    (call tally 14 x y)
    (call (?. state concatenate-transform) (call matrix-from-translation (call Point x y)))
  )
  (fn-do + transform _
    (param matrix Matrix)
    (probe-count graphics.canvas.state)
    (+= transform-count 1)
    (+= state-command-count 1)
    (call tally 23 (. matrix a) (. matrix c) (. matrix b) (. matrix d) (. matrix tx) (. matrix ty))
    (call (?. state concatenate-transform) matrix)
  )
  (fn-do + begin _
    (probe-group + graphics.canvas.path)
    (probe-count graphics.canvas.path.commands)
    (+= begin-count 1)
    (+= path-command-count 1)
    (= current-path-segments 0)
    (call tally 15)
  )
  (fn-do + enclose _
    (probe-count graphics.canvas.path.commands)
    (+= enclose-count 1)
    (+= path-command-count 1)
    (call tally 19)
  )
  (fn-do + end _
    (param closed Bool (= false))
    (param fill-rule FillRule (= (. FillRule nonzero)))
    (if closed
      (call enclose)
    )
    (blank)
    (+= path-count 1)
    (+= path-command-count 1)
    (probe-count graphics.canvas.path.commands)
    (call tally 20 (as current-path-segments Coord) (call fill-rule-key fill-rule))
    (probe-count graphics.canvas.paths)
    (probe-group - graphics.canvas.path)
  )
  (fn-do _ tally _
    (param code Size)
    (param a Coord (= 0))
    (param b Coord (= 0))
    (param c Coord (= 0))
    (param d Coord (= 0))
    (param e Coord (= 0))
    (param f Coord (= 0))
    (+= command-count 1)
    (probe-count graphics.canvas.commands)
    (+= checksum (+ (* command-count 131) (* code 17)))
    (+= checksum (+ (call coordinate-key a) (* (call coordinate-key b) 3) (* (call coordinate-key c) 5)))
    (+= checksum (+ (* (call coordinate-key d) 7) (* (call coordinate-key e) 11) (* (call coordinate-key f) 13)))
  )
  (fn-do _ tally-color _
    (param code Size)
    (param color (? RGBA))
    (if color
      (call tally code (. color red) (. color green) (. color blue) (. color alpha))
      (else
        (call tally code)
      )
    )
  )
  (fn-expr _ coordinate-key Size
    (param value Coord)
    (% (as (call abs (* value 1000)) Size) 1000003)
  )
)

(type + PNGCompression (is Union)
  (variant fast)
  (variant smallest)
)

(type + RasterCanvas (is Canvas)
  (implements Closable)
  (prop _ graphics Pointer)
  (prop _ is-closed _ (= false))
  (prop _ current-fill (? RGBA))
  (prop _ current-stroke (? RGBA))
  (prop _ current-stroke-width Length)
  (prop _ current-stroke-cap _ (= (. LineCap butt)))
  (prop _ current-stroke-join _ (= (. LineJoin miter)))
  (prop _ current-stroke-dash Length)
  (prop _ current-text-color _ (= default-text-color))
  (prop _ current-font _ (= (call system-font)))
  (prop _ current-transform _ (= (call Matrix)))
  (prop _ native-fill RGBA)
  (prop _ native-stroke RGBA)
  (prop _ native-stroke-width Length)
  (prop _ native-stroke-cap _ (= (. LineCap butt)))
  (prop _ native-stroke-join _ (= (. LineJoin miter)))
  (prop _ native-stroke-dash Length)
  (prop _ native-known U8)
  (prop _ current-blend-mode _ (= (. BlendMode normal)))
  (prop _ current-fill-paint (? Paint))
  (prop _ current-stroke-brush (? Brush))
  (prop _ current-text-fill (? ShaderFill))
  (prop _ current-shape-fill (? ShaderFill))
  (prop _ saved-states (list RasterSavedState))
  (prop _ group-targets (list Pointer))
  (prop _ group-kinds (list U8))
  (prop _ group-opacities (list Ratio))
  (prop _ group-filters (list ShaderFilter))
  (fn-do + This _
    (param width I32)
    (param height I32)
    (param scale F64 (= 1))
    (param clear-color (? RGBA) (= null))
    (param output-color-space (? Pointer) (= null))
    (param alpha-only Bool (= false))
    (probe-count gui.canvas.surface-creates)
    (if alpha-only
      (= graphics (call C:brixGraphicsCanvasCreateAlphaOnly width height scale))
      (else-if output-color-space
        (= graphics
          (call C:brixGraphicsCanvasCreateScaledWithColorSpace
            (block
              (arg width)
              (arg height)
              (arg scale)
              (arg output-color-space)
            )
          )
        )
      )
      (else
        (= graphics (call C:brixGraphicsCanvasCreateScaled width height scale))
      )
    )
    (if clear-color
      (let color clear-color)
      (call C:brixGraphicsClear graphics (. color red) (. color green) (. color blue) (. color alpha))
    )
  )
  (fn-do + This _
    (param extent Dimensions)
    (param scale F64)
    (param clear-color (? RGBA) (= null))
    (param output-color-space (? Pointer) (= null))
    (probe-count gui.canvas.surface-creates)
    (if output-color-space
      (= graphics
        (call C:brixGraphicsCanvasCreateScaledWithColorSpace
          (block
            (arg (. extent width))
            (arg (. extent height))
            (arg scale)
            (arg output-color-space)
          )
        )
      )
      (else
        (= graphics (call C:brixGraphicsCanvasCreateScaled (. extent width) (. extent height) scale))
      )
    )
    (if clear-color
      (let color clear-color)
      (call C:brixGraphicsClear graphics (. color red) (. color green) (. color blue) (. color alpha))
    )
  )
  (fn-do + This _
    (param width I32)
    (param height I32)
    (param scale F64)
    (param color-space ColorSpace)
    (param pixel-format _ (= (. PixelFormat rgba8)))
    (probe-count gui.canvas.surface-creates)
    (= graphics
      (call C:brixGraphicsCanvasCreateFormatted
        (block
          (arg width)
          (arg height)
          (arg scale)
          (arg (as color-space I32))
          (arg (as pixel-format I32))
        )
      )
    )
  )
  (fn-do + This _
    (param native Pointer)
    (= graphics native)
  )
  (fn-expr + fill-color _ :get
    current-fill
  )
  (fn-expr + stroke-color _ :get
    current-stroke
  )
  (fn-expr + stroke-width _ :get
    current-stroke-width
  )
  (fn-expr + stroke-cap _ :get
    current-stroke-cap
  )
  (fn-expr + stroke-join _ :get
    current-stroke-join
  )
  (fn-expr + stroke-dash _ :get
    current-stroke-dash
  )
  (fn-expr + font _ :get
    current-font
  )
  (fn-expr + text-color _ :get
    current-text-color
  )
  (fn-expr + blend-mode _ :get
    current-blend-mode
  )
  (fn-expr + fill-paint _ :get
    current-fill-paint
  )
  (fn-expr + stroke-brush _ :get
    current-stroke-brush
  )
  (fn-expr + text-fill _ :get
    current-text-fill
  )
  (fn-expr + shape-fill _ :get
    current-shape-fill
  )
  (fn-expr + current-matrix _ :get
    current-transform
  )
  (fn-expr + scale _ :get
    (call C:brixGraphicsCanvasGetScale graphics)
  )
  (fn-do + fill-color _ :set (param color (? RGBA))
    (= current-fill color)
    (return-if (if (not color)))
    (let value color)
    (return-if (if (and (!= (/and/ native-known native-fill-known) 0) (== native-fill value))))
    (= native-fill value)
    (= native-known (/or/ native-known native-fill-known))
    (call C:brixGraphicsSetFillColor graphics (. value red) (. value green) (. value blue) (. value alpha))
  )
  (fn-do + stroke-color _ :set (param color (? RGBA))
    (= current-stroke color)
    (return-if (if (not color)))
    (let value color)
    (return-if (if (and (!= (/and/ native-known native-stroke-known) 0) (== native-stroke value))))
    (= native-stroke value)
    (= native-known (/or/ native-known native-stroke-known))
    (call C:brixGraphicsSetStrokeColor graphics (. value red) (. value green) (. value blue) (. value alpha))
  )
  (fn-do + stroke-width _ :set (param width Length)
    (= current-stroke-width width)
    (return-if (if (and (!= (/and/ native-known native-width-known) 0) (== native-stroke-width width))))
    (= native-stroke-width width)
    (= native-known (/or/ native-known native-width-known))
    (call C:brixGraphicsSetStrokeWidth graphics width)
  )
  (fn-do + stroke-cap _ :set (param cap LineCap)
    (= current-stroke-cap cap)
    (return-if (if (and (!= (/and/ native-known native-cap-known) 0) (== native-stroke-cap cap))))
    (= native-stroke-cap cap)
    (= native-known (/or/ native-known native-cap-known))
    (call C:brixGraphicsSetStrokeCap graphics (call line-cap-code cap))
  )
  (fn-do + stroke-join _ :set (param join LineJoin)
    (= current-stroke-join join)
    (return-if (if (and (!= (/and/ native-known native-join-known) 0) (== native-stroke-join join))))
    (= native-stroke-join join)
    (= native-known (/or/ native-known native-join-known))
    (call C:brixGraphicsSetStrokeJoin graphics (call line-join-code join))
  )
  (fn-do + stroke-dash _ :set (param length Length)
    (= current-stroke-dash length)
    (return-if (if (and (!= (/and/ native-known native-dash-known) 0) (== native-stroke-dash length))))
    (= native-stroke-dash length)
    (= native-known (/or/ native-known native-dash-known))
    (call C:brixGraphicsSetStrokeDash graphics length)
  )
  (fn-do + font _ :set (param font Font)
    (= current-font font)
  )
  (fn-do + text-color _ :set (param color RGBA)
    (= current-text-color color)
  )
  (fn-do + blend-mode _ :set (param mode BlendMode)
    (= current-blend-mode mode)
    (call C:brixGraphicsSetBlendMode graphics mode)
  )
  (fn-do + fill-paint _ :set (param paint (? Paint))
    (= current-fill-paint paint)
  )
  (fn-do + stroke-brush _ :set (param brush (? Brush))
    (= current-stroke-brush brush)
  )
  (fn-do + text-fill _ :set (param fill (? ShaderFill))
    (= current-text-fill fill)
  )
  (fn-do + shape-fill _ :set (param fill (? ShaderFill))
    (= current-shape-fill fill)
  )
  (fn-do + push _
    (probe-count gui.canvas.state-pushes)
    (+= saved-states
      (call RasterSavedState
        (block
          (arg current-fill)
          (arg current-stroke)
          (arg current-stroke-width)
          (arg current-stroke-cap)
          (arg current-stroke-join)
          (arg current-stroke-dash)
          (arg current-text-color)
          (arg current-font)
          (arg current-transform)
          (arg native-fill)
          (arg native-stroke)
          (arg native-stroke-width)
          (arg native-stroke-cap)
          (arg native-stroke-join)
          (arg native-stroke-dash)
          (arg native-known)
          (arg current-blend-mode)
          (arg current-fill-paint)
          (arg current-stroke-brush)
          (arg current-text-fill)
          (arg current-shape-fill)
        )
      )
    )
    (call C:brixGraphicsSave graphics)
  )
  (fn-do + pop _
    (if (> (. saved-states length) 0)
      (let saved (call (. saved-states pop)))
      (= current-fill (. saved fill))
      (= current-stroke (. saved stroke))
      (= current-stroke-width (. saved stroke-width))
      (= current-stroke-cap (. saved stroke-cap))
      (= current-stroke-join (. saved stroke-join))
      (= current-stroke-dash (. saved stroke-dash))
      (= current-text-color (. saved text-color))
      (= current-font (. saved font))
      (= current-transform (. saved transform))
      (= native-fill (. saved native-fill))
      (= native-stroke (. saved native-stroke))
      (= native-stroke-width (. saved native-stroke-width))
      (= native-stroke-cap (. saved native-stroke-cap))
      (= native-stroke-join (. saved native-stroke-join))
      (= native-stroke-dash (. saved native-stroke-dash))
      (= native-known (. saved native-known))
      (= current-blend-mode (. saved blend-mode))
      (= current-fill-paint (. saved fill-paint))
      (= current-stroke-brush (. saved stroke-brush))
      (= current-text-fill (. saved text-fill))
      (= current-shape-fill (. saved shape-fill))
      (call C:brixGraphicsRestore graphics)
      (else
        (call reset-current-state)
        (call C:brixGraphicsRestore graphics)
        (call C:brixGraphicsSave graphics)
      )
    )
  )
  (fn-do + erase _
    (param color (? RGBA))
    (let erase-color (?? color transparent))
    (let red (. erase-color red))
    (let green (. erase-color green))
    (let blue (. erase-color blue))
    (let alpha (. erase-color alpha))
    (probe-group + gui.canvas.erase)
    (call C:brixGraphicsClear graphics red green blue alpha)
    (probe-group - gui.canvas.erase)
  )
  (fn-do + fill-gradient _
    (param rect Rect)
    (param gradient Gradient)
    (call (. gradient validate))
    (let stops (. gradient stops))
    (let components (list F64))
    (let locations (list F64))
    (for (in stop stops)
      (+= components (. stop color red))
      (+= components (. stop color green))
      (+= components (. stop color blue))
      (+= components (. stop color alpha))
      (+= locations (. stop offset))
    )
    (let kind I32)
    (let geometry (list F64))
    (match gradient
      (case (: linear LinearGradient)
        (= kind 1)
        (= geometry (list (. linear start x) (. linear start y) 0 (. linear end x) (. linear end y) 0))
      )
      (case (: radial RadialGradient)
        (= kind 2)
        (let start (. radial start-center))
        (let end (. radial end-center))
        (= geometry (list (. start x) (. start y) (. radial start-radius) (. end x) (. end y) (. radial end-radius)))
      )
      (case (: conic ConicGradient)
        (= kind 3)
        (= geometry (list (. conic center x) (. conic center y) (. conic angle) 0 0 0))
      )
    )
    (call C:brixGraphicsFillGradient
      (block
        (arg graphics)
        (arg (. rect x))
        (arg (. rect y))
        (arg (. rect width))
        (arg (. rect height))
        (arg kind)
        (arg (. geometry buffer-pointer))
        (arg (. components buffer-pointer))
        (arg (. locations buffer-pointer))
        (arg (. stops length))
      )
    )
  )
  (fn-do + fill-shader _
    (param rect Rect)
    (param shader Shader)
    (param args (list F64) (= (call (of List F64))))
    (call C:brixGraphicsFillShader
      (block
        (arg graphics)
        (arg (. rect x))
        (arg (. rect y))
        (arg (. rect width))
        (arg (. rect height))
        (arg (. shader id))
        (arg (. args buffer-pointer))
        (arg (. args length))
      )
    )
  )
  (fn-do + begin-filter _
    (param rect Rect)
    (param filter ShaderFilter)
    (call enter-group canvas-group-filter 1%%)
    (+= group-filters filter)
    (= graphics (call C:brixGraphicsBeginFilter graphics (. rect x) (. rect y) (. rect width) (. rect height)))
    (call apply-native-state)
  )
  (fn-do + end-filter _
    (return-if (if (not (call is-in-group canvas-group-filter))))
    (let layer graphics)
    (let filter (call (. group-filters pop)))
    (call leave-group)
    (let natives (. filter image-natives))
    (let scales (. filter image-scales))
    (call C:brixGraphicsEndFilter
      (block
        (arg graphics)
        (arg layer)
        (arg (. filter shader id))
        (arg (. filter args buffer-pointer))
        (arg (. filter args length))
        (arg (. natives buffer-pointer))
        (arg (. scales buffer-pointer))
        (arg (. natives length))
        (arg (. filter time))
        (arg 1)
        (arg current-blend-mode)
      )
    )
  )
  (fn-do + rect _
    (param rect Rect)
    (if current-shape-fill
      (call begin)
      (call rect-path rect)
      (call end true)
      (return)
    )
    (let has-fill (!= fill-color null))
    (let has-stroke (!= stroke-color null))
    (call C:brixGraphicsDrawRect graphics (. rect x) (. rect y) (. rect width) (. rect height) has-fill has-stroke)
  )
  (fn-do + square _
    (param x Coord)
    (param y Coord)
    (param width Length)
    (if current-shape-fill
      (call rect (call Rect x y width width))
      (return)
    )
    (let has-fill (!= fill-color null))
    (let has-stroke (!= stroke-color null))
    (call C:brixGraphicsDrawRect graphics x y width width has-fill has-stroke)
  )
  (fn-do + oval _
    (param rect Rect)
    (if current-shape-fill
      (call begin)
      (call oval-path rect)
      (call end true)
      (return)
    )
    (let has-fill (!= fill-color null))
    (let has-stroke (!= stroke-color null))
    (call C:brixGraphicsDrawEllipse graphics (. rect x) (. rect y) (. rect width) (. rect height) has-fill has-stroke)
  )
  (fn-do + circle _
    (param cx Coord)
    (param cy Coord)
    (param radius Length)
    (let diameter (* radius 2))
    (let x (- cx radius))
    (let y (- cy radius))
    (if current-shape-fill
      (call oval (call Rect x y diameter diameter))
      (return)
    )
    (let has-fill (!= fill-color null))
    (let has-stroke (!= stroke-color null))
    (call C:brixGraphicsDrawEllipse graphics x y diameter diameter has-fill has-stroke)
  )
  (fn-do + move _
    (param x Coord)
    (param y Coord)
    (call C:brixGraphicsMoveTo graphics x y)
  )
  (fn-do + line _
    (param x Coord)
    (param y Coord)
    (call C:brixGraphicsLineTo graphics x y)
  )
  (fn-do + curve _
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (param x3 Coord)
    (param y3 Coord)
    (call C:brixGraphicsCurveTo graphics x1 y1 x2 y2 x3 y3)
  )
  (fn-do + translate _
    (param x Coord)
    (param y Coord)
    (call transform (call matrix-from-translation (call Point x y)))
  )
  (fn-do + transform _
    (param matrix Matrix)
    (= current-transform (call (. current-transform concatenate) matrix))
    (call C:brixGraphicsTransform
      (block
        (arg graphics)
        (arg (. matrix a))
        (arg (. matrix c))
        (arg (. matrix b))
        (arg (. matrix d))
        (arg (. matrix tx))
        (arg (. matrix ty))
      )
    )
  )
  (fn-do + outline _
    (param shape Outline)
    (if current-shape-fill
      (call begin)
      (call outline-path shape)
      (call end true)
      (return)
    )
    (let has-fill (!= fill-color null))
    (let has-stroke (!= stroke-color null))
    (return-if (if (and (not has-fill) (not has-stroke))))
    (let b (. shape bounds))
    (call C:brixGraphicsDrawOutline
      (block
        (arg graphics)
        (arg (. b x))
        (arg (. b y))
        (arg (. b width))
        (arg (. b height))
        (arg (. shape radius))
        (arg (call outline-side-code (. shape arrow)))
        (arg (?? (?. (. shape arrow) offset) 0))
        (arg (?? (?. (. shape arrow) size) 0))
        (arg has-fill)
        (arg has-stroke)
      )
    )
  )
  (fn-do + clip _
    (param rect Rect)
    (call C:brixGraphicsClipRect graphics (. rect x) (. rect y) (. rect width) (. rect height))
  )
  (fn-do + clip-outline _
    (param shape Outline)
    (let b (. shape bounds))
    (call C:brixGraphicsClipOutline
      (block
        (arg graphics)
        (arg (. b x))
        (arg (. b y))
        (arg (. b width))
        (arg (. b height))
        (arg (. shape radius))
        (arg (call outline-side-code (. shape arrow)))
        (arg (?? (?. (. shape arrow) offset) 0))
        (arg (?? (?. (. shape arrow) size) 0))
      )
    )
  )
  (fn-do + clip-path _
    (param fill-rule FillRule (= (. FillRule nonzero)))
    (call C:brixGraphicsClipPath graphics (call fill-rule-code fill-rule))
  )
  (fn-do + clip-mask _
    (param image RasterCanvas)
    (param rect Rect)
    (call C:brixGraphicsClipMask graphics (. image native) (. rect x) (. rect y) (. rect width) (. rect height))
  )
  (fn-do + begin-mask _
    (call enter-group canvas-group-mask 1%%)
    (= graphics (call C:brixGraphicsBeginMask graphics))
    (call apply-native-state)
  )
  (fn-do + end-mask _
    (return-if (if (not (call is-in-group canvas-group-mask))))
    (let mask graphics)
    (call leave-group)
    (call C:brixGraphicsEndMask graphics mask)
  )
  (fn-do + begin-blur _
    (param radius Length)
    (call enter-group canvas-group-blur 1%%)
    (= graphics (call C:brixGraphicsBeginBlur graphics radius))
    (call apply-native-state)
  )
  (fn-do + end-blur _
    (return-if (if (not (call is-in-group canvas-group-blur))))
    (let layer graphics)
    (call leave-group)
    (call C:brixGraphicsEndBlur graphics layer current-blend-mode)
  )
  (fn-do + draw-image _
    (param image RasterCanvas)
    (param rect Rect)
    (param template-alpha Bool (= false))
    (param sampling _ (= (. ImageSampling smooth)))
    (call C:brixGraphicsDrawImage
      (block
        (arg graphics)
        (arg (. image native))
        (arg (. rect x))
        (arg (. rect y))
        (arg (. rect width))
        (arg (. rect height))
        (arg template-alpha)
        (arg sampling)
      )
    )
  )
  (fn-do + fill-image _
    (param image RasterCanvas)
    (param rect Rect)
    (param tile Rect)
    (param sampling _ (= (. ImageSampling smooth)))
    (call C:brixGraphicsFillImage
      (block
        (arg graphics)
        (arg (. image native))
        (arg (. rect x))
        (arg (. rect y))
        (arg (. rect width))
        (arg (. rect height))
        (arg (. tile x))
        (arg (. tile y))
        (arg (. tile width))
        (arg (. tile height))
        (arg sampling)
      )
    )
  )
  (fn-do + draw-text _
    (param layout TextLayout)
    (param rect Rect)
    (param alignment TextAlignment (= (. TextAlignment left)))
    (return-if (if (not (. layout native))))
    (blank)
    (let line-count (call C:brixGraphicsTextLayoutGetLineCount (. layout native)))
    (for (in index (..< 0 line-count))
      (let ignored index)
      (probe-count graphics.text.lines-drawn)
    )
    (let fill current-text-fill)
    (if fill
      (call C:brixGraphicsDrawTextLayoutShader
        (block
          (arg graphics)
          (arg (!! (. layout native)))
          (arg (. rect x))
          (arg (. rect y))
          (arg (. rect width))
          (arg (. rect height))
          (arg (call text-alignment-code alignment))
          (arg (. fill shader id))
          (arg (. fill args buffer-pointer))
          (arg (. fill args length))
          (arg (. fill time))
        )
      )
      (return)
    )
    (call C:brixGraphicsDrawTextLayout
      (block
        (arg graphics)
        (arg (!! (. layout native)))
        (arg (. rect x))
        (arg (. rect y))
        (arg (. rect width))
        (arg (. rect height))
        (arg (call text-alignment-code alignment))
        (arg (. text-color red))
        (arg (. text-color green))
        (arg (. text-color blue))
        (arg (. text-color alpha))
      )
    )
  )
  (fn-do + shadow _
    (param shape Outline)
    (param shadow Shadow)
    (let b (. shape bounds))
    (call C:brixGraphicsDrawOutlineShadow
      (block
        (arg graphics)
        (arg (. b x))
        (arg (. b y))
        (arg (. b width))
        (arg (. b height))
        (arg (. shape radius))
        (arg (call outline-side-code (. shape arrow)))
        (arg (?? (?. (. shape arrow) offset) 0))
        (arg (?? (?. (. shape arrow) size) 0))
        (arg (. shadow color red))
        (arg (. shadow color green))
        (arg (. shadow color blue))
        (arg (. shadow color alpha))
        (arg (. shadow blur))
        (arg (. shadow x))
        (arg (. shadow y))
        (arg (. shadow spread))
      )
    )
  )
  (fn-do + shadow-path _
    (param shadow Shadow)
    (call C:brixGraphicsDrawPathShadow
      (block
        (arg graphics)
        (arg (. shadow color red))
        (arg (. shadow color green))
        (arg (. shadow color blue))
        (arg (. shadow color alpha))
        (arg (. shadow blur))
        (arg (. shadow x))
        (arg (. shadow y))
      )
    )
  )
  (fn-do + backdrop-blur _
    (param shape Outline)
    (param radius Length)
    (let b (. shape bounds))
    (return-if (if (or (<= (. b width) 0) (<= (. b height) 0))))
    (use saved-state)
    (call clip-outline shape)
    (call backdrop-blur-in-clip b radius)
  )
  (fn-do + backdrop-shader _
    (param shape Outline)
    (param backdrop ShaderFilter)
    (param blur Length (= 0))
    (let b (. shape bounds))
    (return-if (if (or (<= (. b width) 0) (<= (. b height) 0))))
    (use saved-state)
    (call clip-outline shape)
    (call backdrop-shader-in-clip b backdrop blur)
  )
  (fn-do + begin-opacity _
    (param opacity Ratio)
    (call enter-group canvas-group-opacity opacity)
    (= graphics (call C:brixGraphicsBeginOpacity graphics))
    (call apply-native-state)
  )
  (fn-do + end-opacity _
    (return-if (if (not (call is-in-group canvas-group-opacity))))
    (let layer graphics)
    (let opacity ([] group-opacities (- (. group-opacities length) 1)))
    (call leave-group)
    (call C:brixGraphicsEndOpacity graphics layer opacity current-blend-mode)
  )
  (fn-do + begin _
    (probe-group + graphics.canvas.path)
    (call C:brixGraphicsBeginPath graphics)
  )
  (fn-do + enclose _
    (call C:brixGraphicsClosePath graphics)
  )
  (fn-do + end _
    (param closed Bool (= false))
    (param fill-rule FillRule (= (. FillRule nonzero)))
    (if closed
      (call enclose)
    )
    (blank)
    (let paint current-fill-paint)
    (let brush current-stroke-brush)
    (let fill fill-color)
    (let stroke stroke-color)
    (let brushed (and (!= brush null) (!= stroke null)))
    (let shading current-shape-fill)
    (if shading
      (call C:brixGraphicsFillPathShader
        (block
          (arg graphics)
          (arg (. shading shader id))
          (arg (. shading args buffer-pointer))
          (arg (. shading args length))
          (arg (. shading time))
          (arg (call fill-rule-code fill-rule))
        )
      )
      (if brushed
        (call stroke-path-brush (!! brush) (!! stroke) false fill-rule)
        (else
          (call C:brixGraphicsDrawPath graphics false (!= stroke null) (call fill-rule-code fill-rule))
        )
      )
      (else-if (and paint fill)
        (let color fill)
        (call C:brixGraphicsFillPathPaint
          (block
            (arg graphics)
            (arg (. paint shader id))
            (arg (. paint args buffer-pointer))
            (arg (. paint args length))
            (arg (. color red))
            (arg (. color green))
            (arg (. color blue))
            (arg (. color alpha))
            (arg (call fill-rule-code fill-rule))
          )
        )
        (if brushed
          (call stroke-path-brush (!! brush) (!! stroke) false fill-rule)
          (else
            (call C:brixGraphicsDrawPath graphics false (!= stroke null) (call fill-rule-code fill-rule))
          )
        )
      )
      (else-if brushed
        (call stroke-path-brush (!! brush) (!! stroke) (!= fill null) fill-rule)
      )
      (else
        (call C:brixGraphicsDrawPath graphics (!= fill null) (!= stroke null) (call fill-rule-code fill-rule))
      )
    )
    (probe-count graphics.canvas.paths)
    (probe-group - graphics.canvas.path)
  )
  (fn-do + trace-path _
    (param verbs (of Array PathVerb))
    (param coords (of Array Coord))
    (param count Size)
    (call trace-path-buffer (. verbs data) count (as (. coords data) (of CPointer F64)))
  )
  (fn-do + close _
    (if (not is-closed)
      (call (. saved-states clear))
      (while (> (. group-targets length) 0)
        (let target (call (. group-targets pop)))
        (let kind (call (. group-kinds pop)))
        (let opacity (call (. group-opacities pop)))
        (match kind
          (case= canvas-group-blur
            (call C:brixGraphicsEndBlur target graphics current-blend-mode)
          )
          (case= canvas-group-filter
            (let filter (call (. group-filters pop)))
            (let natives (. filter image-natives))
            (let scales (. filter image-scales))
            (call C:brixGraphicsEndFilter
              (block
                (arg target)
                (arg graphics)
                (arg (. filter shader id))
                (arg (. filter args buffer-pointer))
                (arg (. filter args length))
                (arg (. natives buffer-pointer))
                (arg (. scales buffer-pointer))
                (arg (. natives length))
                (arg (. filter time))
                (arg 1)
                (arg current-blend-mode)
              )
            )
          )
          (case= canvas-group-opacity
            (call C:brixGraphicsEndOpacity target graphics opacity current-blend-mode)
          )
          (default
            (call C:brixGraphicsEndMask target graphics)
          )
        )
        (= graphics target)
      )
      (call C:brixGraphicsCanvasRelease graphics)
      (= is-closed true)
    )
  )
  (fn-expr + content-serial U64 :get
    (call C:brixGraphicsCanvasContentSerial graphics)
  )
  (fn-expr + identity U64 :get
    (call C:brixGraphicsCanvasIdentity graphics)
  )
  (fn-expr + is-gpu-resident Bool :get
    (call C:brixGraphicsCanvasIsGPUResident graphics)
  )
  (fn-expr + pixel-width I32 :get
    (call C:brixGraphicsCanvasGetPixelWidth graphics)
  )
  (fn-expr + pixel-height I32 :get
    (call C:brixGraphicsCanvasGetPixelHeight graphics)
  )
  (fn-expr + color-space ColorSpace :get
    (as (call C:brixGraphicsCanvasGetColorSpaceKind graphics) ColorSpace)
  )
  (fn-expr + pixel-format PixelFormat :get
    (as (call C:brixGraphicsCanvasGetPixelFormat graphics) PixelFormat)
  )
  (fn-expr + bytes-per-pixel I32 :get
    (call C:brixGraphicsCanvasGetBytesPerPixel graphics)
  )
  (fn-expr + native _ :get
    graphics
  )
  (fn-do + write _
    (param path Path)
    (call write path (. PNGCompression fast))
  )
  (fn-do + write _
    (param path Path)
    (param compression PNGCompression)
    (let did-write
      (call C:brixGraphicsCanvasWritePNG
        (block
          (arg graphics)
          (arg (as path String))
          (arg (== compression (. PNGCompression smallest)))
        )
      )
    )
    (blank)
    (throw (call IOError (str "Unable to write image " path)) (if (not did-write)))
  )
  (fn-do + encode-png ([] Byte) (?! IOError)
    (param compression _ (= (. PNGCompression fast)))
    (let encoded (call C:brixGraphicsCanvasEncodePNG graphics (== compression (. PNGCompression smallest))))
    (throw (call IOError "Unable to encode image") (if (== encoded (call Pointer))))
    (let bytes ([] Byte (as (call C:brixGraphicsEncodedLength encoded) Size)))
    (call C:brixGraphicsEncodedCopy encoded (. bytes data) (. bytes size))
    (call C:brixGraphicsEncodedRelease encoded)
    (return bytes)
  )
  (fn-do + encode-jpeg ([] Byte) (?! IOError)
    (param quality F64 (= 0.85))
    (let encoded (call C:brixGraphicsCanvasEncodeJPEG graphics quality))
    (throw (call IOError "Unable to encode image") (if (== encoded (call Pointer))))
    (let bytes ([] Byte (as (call C:brixGraphicsEncodedLength encoded) Size)))
    (call C:brixGraphicsEncodedCopy encoded (. bytes data) (. bytes size))
    (call C:brixGraphicsEncodedRelease encoded)
    (return bytes)
  )
  (fn-do + surface-changed _
    (call C:brixGraphicsCanvasSurfaceChanged graphics)
  )
  (fn-expr + nontransparent-pixel-count U64
    (param rect Rect)
    (call C:brixGraphicsCanvasCountNonTransparentPixels
      (block
        (arg graphics)
        (arg (. rect x))
        (arg (. rect y))
        (arg (. rect width))
        (arg (. rect height))
      )
    )
  )
  (fn-do + opaque-pixel-bounds (? Rect)
    (param minimum-alpha I32 (= 0))
    (let box (list 0.0 0.0 0.0 0.0))
    (return-if null (if (not (call C:brixGraphicsCanvasOpaqueBounds graphics minimum-alpha (. box buffer-pointer)))))
    (return (call Rect ([] box 0) ([] box 1) ([] box 2) ([] box 3)))
  )
  (fn-expr + pixel-color RGBA
    (param point Point)
    (case? (<= (. pixel alpha) 0%%)
      transparent
    )
    (default
      (call RGBA
        (block
          (arg (/ (. pixel red) (. pixel alpha)))
          (arg (/ (. pixel green) (. pixel alpha)))
          (arg (/ (. pixel blue) (. pixel alpha)))
          (arg (. pixel alpha))
        )
      )
    )
    (where
      (lazy pixel (call rgba8 (call C:brixGraphicsCanvasGetPixel graphics (. point x) (. point y))))
    )
  )
  (fn-do + premultiplied-pixels ([] Byte)
    (let bytes ([] Byte (* (as pixel-width Size) (as pixel-height Size) 4)))
    (call C:brixGraphicsCanvasCopyPixels graphics (. bytes data) (. bytes size))
    (return bytes)
  )
  (fn-do + write-premultiplied-pixels Bool
    (param bytes ([] Byte))
    (return (call C:brixGraphicsCanvasWritePixels graphics (. bytes data) (. bytes size)))
  )
  (fn-expr + pixel-difference-count U64
    (param other RasterCanvas)
    (call C:brixGraphicsCanvasCountDifferentPixels graphics (. other native))
  )
  (fn-do + path-contains Bool
    (param point Point)
    (param fill-rule FillRule (= (. FillRule nonzero)))
    (let inside (call C:brixGraphicsPathContainsPoint graphics (. point x) (. point y) (call fill-rule-code fill-rule)))
    (probe-group - graphics.canvas.path)
    (return inside)
  )
  (fn-do + backdrop-blur-in-clip _
    (param bounds Rect)
    (param radius Length)
    (call C:brixGraphicsBackdropBlur graphics (. bounds x) (. bounds y) (. bounds width) (. bounds height) radius)
  )
  (fn-do + backdrop-shader-in-clip _
    (param bounds Rect)
    (param backdrop ShaderFilter)
    (param blur Length (= 0))
    (call C:brixGraphicsBackdropShader
      (block
        (arg graphics)
        (arg (. bounds x))
        (arg (. bounds y))
        (arg (. bounds width))
        (arg (. bounds height))
        (arg (. backdrop shader id))
        (arg (. backdrop args buffer-pointer))
        (arg (. backdrop args length))
        (arg (. backdrop time))
        (arg blur)
      )
    )
  )
  (fn-do + trace-path-buffer _
    (param verbs (of CPointer U8))
    (param count Size)
    (param coords (of CPointer F64))
    (call C:brixGraphicsAppendPath graphics verbs count coords)
  )
  (fn-do _ reset-current-state _
    (= current-fill null)
    (= current-stroke null)
    (= current-stroke-width 0)
    (= current-stroke-cap (. LineCap butt))
    (= current-stroke-join (. LineJoin miter))
    (= current-stroke-dash 0)
    (= current-text-color default-text-color)
    (= current-font (call system-font))
    (= current-transform (call Matrix))
    (= current-blend-mode (. BlendMode normal))
    (= current-fill-paint null)
    (= current-stroke-brush null)
    (= current-text-fill null)
    (= current-shape-fill null)
    (= native-known 0)
  )
  (fn-do _ enter-group _
    (param kind U8)
    (param opacity Ratio)
    (call push)
    (= current-blend-mode (. BlendMode normal))
    (+= group-targets graphics)
    (+= group-kinds kind)
    (+= group-opacities opacity)
  )
  (fn-expr _ is-in-group _
    (param kind U8)
    (and (> (. group-kinds length) 0) (== ([] group-kinds (- (. group-kinds length) 1)) kind))
  )
  (fn-do _ leave-group _
    (= graphics (call (. group-targets pop)))
    (call (. group-kinds pop))
    (call (. group-opacities pop))
    (call pop)
  )
  (fn-do _ apply-native-state _
    (if (!= (/and/ native-known native-fill-known) 0)
      (call C:brixGraphicsSetFillColor
        (block
          (arg graphics)
          (arg (. native-fill red))
          (arg (. native-fill green))
          (arg (. native-fill blue))
          (arg (. native-fill alpha))
        )
      )
    )
    (if (!= (/and/ native-known native-stroke-known) 0)
      (call C:brixGraphicsSetStrokeColor
        (block
          (arg graphics)
          (arg (. native-stroke red))
          (arg (. native-stroke green))
          (arg (. native-stroke blue))
          (arg (. native-stroke alpha))
        )
      )
    )
    (if (!= (/and/ native-known native-width-known) 0)
      (call C:brixGraphicsSetStrokeWidth graphics native-stroke-width)
    )
    (if (!= (/and/ native-known native-cap-known) 0)
      (call C:brixGraphicsSetStrokeCap graphics (call line-cap-code native-stroke-cap))
    )
    (if (!= (/and/ native-known native-join-known) 0)
      (call C:brixGraphicsSetStrokeJoin graphics (call line-join-code native-stroke-join))
    )
    (if (!= (/and/ native-known native-dash-known) 0)
      (call C:brixGraphicsSetStrokeDash graphics native-stroke-dash)
    )
  )
  (fn-do _ stroke-path-brush _
    (param brush Brush)
    (param color RGBA)
    (param fill Bool)
    (param fill-rule FillRule)
    (let values (list F64))
    (call append-brush-arguments brush values)
    (call C:brixGraphicsStrokePathBrush
      (block
        (arg graphics)
        (arg (. brush shader id))
        (arg (. values buffer-pointer))
        (arg (. values length))
        (arg (. color red))
        (arg (. color green))
        (arg (. color blue))
        (arg (. color alpha))
        (arg stroke-width)
        (arg fill)
        (arg (call fill-rule-code fill-rule))
      )
    )
  )
)

(type + SVGCanvas (is Canvas)
  (prop _ strings (list String))
  (prop _ path-points (list String))
  (prop _ gradient-count Size (= 0))
  (fn-do + This _
    (param width I32)
    (param height I32)
    (= state (call create-state))
  )
  (fn-do + write _
    (param path Path)
    ; . head = "<svg width=\"8.5in\" height=\"11in\" xmlns=\"http://www.w3.org/2000/svg\">"
    (let head (str "<svg width=\"" width "\" height=\"" height "\" viewBox=\"0 0 " width " " height "\""))
    (+= head " xmlns=\"http://www.w3.org/2000/svg\">")
    (let tail "</svg>")
    (blank)
    (let content (call (. "\n" join) strings))
    (let buf (+ head content tail))
    (blank)
    (let f (call File path (+ (. FileFlags create-mode) (. FileFlags write-mode) (. FileFlags truncate-mode))))
    (call (. f write) buf)
    (call (. f close))
  )
  (fn-do + erase _
    (param color (? RGBA))
    (= strings (call (of List String)))
    (= gradient-count 0)
  )
  (fn-do + fill-gradient _
    (param rect Rect)
    (param gradient Gradient)
    (call (. gradient validate))
    (+= gradient-count 1)
    (let id (str "gradient-" gradient-count))
    (let element String)
    (let definition String)
    (match gradient
      (case (: linear LinearGradient)
        (= element "linearGradient")
        (= definition (str "<defs><linearGradient id=\"" id "\" gradientUnits=\"userSpaceOnUse\""))
        (+= definition (str " x1=\"" (. linear start x) "\" y1=\"" (. linear start y) "\""))
        (+= definition (str " x2=\"" (. linear end x) "\" y2=\"" (. linear end y) "\">"))
      )
      (case (: radial RadialGradient)
        (= element "radialGradient")
        (= definition (str "<defs><radialGradient id=\"" id "\" gradientUnits=\"userSpaceOnUse\""))
        (+= definition (str " fx=\"" (. radial start-center x) "\" fy=\"" (. radial start-center y) "\""))
        (+= definition (str " fr=\"" (. radial start-radius) "\""))
        (+= definition (str " cx=\"" (. radial end-center x) "\" cy=\"" (. radial end-center y) "\""))
        (+= definition (str " r=\"" (. radial end-radius) "\">"))
      )
      (case ConicGradient
        (return)
      )
    )
    (for (in stop (. gradient stops))
      (let offset (as (. stop offset) Percent UnitString))
      (let opacity (as (. stop color alpha) Percent UnitString))
      (+= definition (str "<stop offset=\"" offset "\" stop-color=\"" (as (. stop color) Hex) "\""))
      (+= definition (str " stop-opacity=\"" opacity "\"/>"))
    )
    (+= definition (str "</" element "></defs>"))
    (+= strings definition)
    (let geometry (str " x=\"" (. rect x) "\" y=\"" (. rect y) "\""))
    (+= geometry (str " width=\"" (. rect width) "\" height=\"" (. rect height) "\""))
    (let transform-style (call svg-transform-style (?? (?. state current-transform) (call Matrix))))
    (+= strings (str "<rect" geometry " fill=\"url(#" id ")\" stroke=\"none\"" transform-style "/>"))
  )
  (fn-do + rect _
    (param rect Rect)
    (if (or fill-color stroke-color)
      (let geometry (str " x=\"" (. rect x) "\" y=\"" (. rect y) "\""))
      (+= geometry (str " width=\"" (. rect width) "\" height=\"" (. rect height) "\""))
      (+= strings (str "<rect" geometry (call svg-style (. FillRule nonzero)) "/>"))
    )
  )
  (fn-do + square _
    (param x Coord)
    (param y Coord)
    (param width Length)
    (call rect (call Rect x y width width))
  )
  (fn-do + oval _
    (param rect Rect)
    (if (or fill-color stroke-color)
      (let cx (+ (. rect x) (/ (. rect width) 2)))
      (let cy (+ (. rect y) (/ (. rect height) 2)))
      (let geometry (str " cx=\"" cx "\" cy=\"" cy "\""))
      (+= geometry (str " rx=\"" (/ (. rect width) 2) "\" ry=\"" (/ (. rect height) 2) "\""))
      (+= strings (str "<ellipse" geometry (call svg-style (. FillRule nonzero)) "/>"))
    )
  )
  (fn-do + circle _
    (param cx Coord)
    (param cy Coord)
    (param radius Length)
    (if (or fill-color stroke-color)
      (+= strings (str "<circle cx=\"" cx "\" cy=\"" cy "\" r=\"" radius "\"" (call svg-style (. FillRule nonzero)) "/>"))
    )
  )
  (fn-do + move _
    (param x Coord)
    (param y Coord)
    (+= path-points (str "M " x " " y))
  )
  (fn-do + line _
    (param x Coord)
    (param y Coord)
    (+= path-points (str "L " x " " y))
  )
  (fn-do + curve _
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (param x3 Coord)
    (param y3 Coord)
    (+= path-points (str "C " x1 "," y1 " " x2 "," y2 " " x3 "," y3))
  )
  (fn-do + translate _
    (param x Coord)
    (param y Coord)
    (call transform (call matrix-from-translation (call Point x y)))
  )
  (fn-do + begin-opacity _
    (param opacity Ratio)
    (let value (as opacity Percent UnitString))
    (+= strings (str "<g opacity=\"" value "\">"))
  )
  (fn-do + end-opacity _
    (+= strings "</g>")
  )
  (fn-do + begin _
    (probe-group + graphics.canvas.path)
    (= path-points (call (of List String)))
  )
  (fn-do + enclose _
    (+= path-points "Z")
  )
  (fn-do + end _
    (param closed Bool (= false))
    (param fill-rule FillRule (= (. FillRule nonzero)))
    (let points (call (. " " join) path-points))
    (let style (if-expr (or stroke-color fill-color) (call svg-style fill-rule) ""))
    (blank)
    (if (or fill-color stroke-color)
      (+= strings (str "<path d=\"" points "\"" style "/>"))
      (probe-count graphics.canvas.paths)
    )
    (probe-group - graphics.canvas.path)
  )
  (fn-do + close _)
  (fn-expr _ color-to-svg _
    (param color (? RGBA))
    (case? color
      (as color Hex)
    )
    (default
      "none"
    )
  )
  (fn-expr _ svg-style _
    (param fill-rule FillRule)
    (paragraph
      (str " fill=\"" fill "\"" fill-opacity " stroke=\"" stroke "\"" stroke-opacity " stroke-width=\"" stroke-width "\"" stroke-style fill-rule-style transform-style)
    )
    (where
      (lazy fill (call color-to-svg (?. state fill-color)))
      (lazy fill-opacity (call svg-opacity-style "fill" (?. state fill-color)))
      (lazy stroke-opacity (call svg-opacity-style "stroke" (?. state stroke-color)))
      (lazy stroke (call color-to-svg (?. state stroke-color)))
      (lazy stroke-style (if-expr stroke-color stroke-attributes ""))
      (lazy stroke-attributes (str " stroke-linecap=\"" stroke-cap "\" stroke-linejoin=\"" stroke-join "\"" dash-style))
      (lazy dash-style (if-expr (> stroke-dash 0) (str " stroke-dasharray=\"" stroke-dash "\"") ""))
      (lazy fill-rule-style (if-expr (== fill-rule (. FillRule even-odd)) " fill-rule=\"evenodd\"" ""))
      (lazy transform-style (call svg-transform-style (?? (?. state current-transform) (call Matrix))))
    )
  )
  (fn-expr _ svg-opacity-style String
    (param attribute String)
    (param color (? RGBA))
    (case? (< alpha 1)
      (str " " attribute "-opacity=\"" alpha "\"")
    )
    (default
      ""
    )
    (where
      (lazy alpha (?? (?. color alpha) 1))
    )
  )
  (fn-expr _ svg-transform-style String
    (param matrix Matrix)
    (case? (. matrix is-identity)
      ""
    )
    (default
      (str " transform=\"matrix(" (. matrix a) " " (. matrix c) " " (. matrix b) " " (. matrix d) " " (. matrix tx) " " (. matrix ty) ")\"")
    )
  )
)

(type + CanvasStateScope (is Tuple)
  (implements (of Usable Void))
  (prop _ canvas Canvas)
  (fn-do + This _
    (param canvas _)
  )
  (fn-do + begin-using _
    (call (. canvas push))
  )
  (fn-do + end-using _
    (call (. canvas pop))
  )
)

(fn-do + trace-canvas-path _
  (param canvas Canvas)
  (param verbs (of Array PathVerb))
  (param coords (of Array Coord))
  (param count Size)
  (let coord Index)
  (let current-x Coord)
  (let current-y Coord)
  (let subpath-x Coord)
  (let subpath-y Coord)
  (let has-current false)
  (for (in index (..< 0 count))
    (match? ([] verbs index)
      (case= .path-verb-move
        (= current-x ([] coords coord))
        (= current-y ([] coords (+ coord 1)))
        (+= coord 2)
        (= subpath-x current-x)
        (= subpath-y current-y)
        (= has-current true)
        (call (. canvas move) current-x current-y)
      )
      (case= .path-verb-line
        (= current-x ([] coords coord))
        (= current-y ([] coords (+ coord 1)))
        (+= coord 2)
        (call (. canvas line) current-x current-y)
      )
      (case= .path-verb-cubic
        (= current-x ([] coords (+ coord 4)))
        (= current-y ([] coords (+ coord 5)))
        (call (. canvas curve)
          (block
            (arg ([] coords coord))
            (arg ([] coords (+ coord 1)))
            (arg ([] coords (+ coord 2)))
            (arg ([] coords (+ coord 3)))
            (arg current-x)
            (arg current-y)
          )
        )
        (+= coord 6)
      )
      (case= .path-verb-close
        (if (and has-current (or (!= current-x subpath-x) (!= current-y subpath-y)))
          (call (. canvas line) subpath-x subpath-y)
          (= current-x subpath-x)
          (= current-y subpath-y)
        )
        (call (. canvas enclose))
      )
    )
  )
)

(fn-expr + line-cap-code _
  (param cap LineCap)
  (case? (only-if 1i32 (if (== cap (. LineCap round)))))
  (case? (only-if 2i32 (if (== cap (. LineCap square)))))
  (default
    (inline 0i32)
  )
)

(fn-expr + line-join-code _
  (param join LineJoin)
  (case? (only-if 1i32 (if (== join (. LineJoin round)))))
  (case? (only-if 2i32 (if (== join (. LineJoin bevel)))))
  (default
    (inline 0i32)
  )
)

(type _ RasterSavedState (is Tuple)
  (prop + fill (? RGBA))
  (prop + stroke (? RGBA))
  (prop + stroke-width Length)
  (prop + stroke-cap LineCap)
  (prop + stroke-join LineJoin)
  (prop + stroke-dash Length)
  (prop + text-color RGBA)
  (prop + font Font)
  (prop + transform Matrix)
  (prop + native-fill RGBA)
  (prop + native-stroke RGBA)
  (prop + native-stroke-width Length)
  (prop + native-stroke-cap LineCap)
  (prop + native-stroke-join LineJoin)
  (prop + native-stroke-dash Length)
  (prop + native-known U8)
  (prop + blend-mode BlendMode)
  (prop + fill-paint (? Paint))
  (prop + stroke-brush (? Brush))
  (prop + text-fill (? ShaderFill))
  (prop + shape-fill (? ShaderFill))
)

(type _ CanvasState
  (prop + text-color _ (= default-text-color))
  (prop + font _ (= (call system-font)))
  (prop + fill-color (? RGBA))
  (prop + stroke-color (? RGBA))
  (prop + stroke-width Length)
  (prop + stroke-cap LineCap (= (. LineCap butt)))
  (prop + stroke-join LineJoin (= (. LineJoin miter)))
  (prop + stroke-dash Length)
  (prop + current-transform Matrix (= (call Matrix)))
  (prop + blend-mode _ (= (. BlendMode normal)))
  (prop + fill-paint (? Paint))
  (prop + stroke-brush (? Brush))
  (prop + text-fill (? ShaderFill))
  (prop + shape-fill (? ShaderFill))
  (prop + previous (? CanvasState))
  (fn-do + copy-from _
    (param source CanvasState)
    (= text-color (. source text-color))
    (= font (. source font))
    (= fill-color (. source fill-color))
    (= stroke-color (. source stroke-color))
    (= stroke-width (. source stroke-width))
    (= stroke-cap (. source stroke-cap))
    (= stroke-join (. source stroke-join))
    (= stroke-dash (. source stroke-dash))
    (= current-transform (. source current-transform))
    (= blend-mode (. source blend-mode))
    (= fill-paint (. source fill-paint))
    (= stroke-brush (. source stroke-brush))
    (= text-fill (. source text-fill))
    (= shape-fill (. source shape-fill))
  )
  (fn-do + set-fill-color _
    (param color (? RGBA))
    (= fill-color color)
  )
  (fn-do + set-fill-paint _
    (param paint (? Paint))
    (= fill-paint paint)
  )
  (fn-do + set-stroke-brush _
    (param brush (? Brush))
    (= stroke-brush brush)
  )
  (fn-do + set-text-fill _
    (param fill (? ShaderFill))
    (= text-fill fill)
  )
  (fn-do + set-shape-fill _
    (param fill (? ShaderFill))
    (= shape-fill fill)
  )
  (fn-do + set-stroke-color _
    (param color (? RGBA))
    (= stroke-color color)
  )
  (fn-do + set-stroke-width _
    (param width Length)
    (= stroke-width width)
  )
  (fn-do + set-stroke-cap _
    (param cap LineCap)
    (= stroke-cap cap)
  )
  (fn-do + set-stroke-join _
    (param join LineJoin)
    (= stroke-join join)
  )
  (fn-do + set-stroke-dash _
    (param length Length)
    (= stroke-dash length)
  )
  (fn-do + concatenate-transform _
    (param matrix Matrix)
    (= current-transform (call (. current-transform concatenate) matrix))
  )
  (fn-do + set-font _
    (param value Font)
    (= font value)
  )
  (fn-do + set-text-color _
    (param color RGBA)
    (= text-color color)
  )
  (fn-do + set-blend-mode _
    (param mode BlendMode)
    (= blend-mode mode)
  )
)

(fn-expr _ line-cap-key Coord
  (param cap LineCap)
  (call line-cap-code cap)
)

(fn-expr _ line-join-key Coord
  (param join LineJoin)
  (call line-join-code join)
)

(fn-expr _ fill-rule-key Coord
  (param fill-rule FillRule)
  (call fill-rule-code fill-rule)
)

(fn-expr _ fill-rule-code I32
  (param fill-rule FillRule)
  (if-expr (== fill-rule (. FillRule even-odd)) 1 0)
)

(fn-expr _ text-alignment-code I32
  (param alignment TextAlignment)
  (case? (== alignment (. TextAlignment center))
    1i32
  )
  (case? (== alignment (. TextAlignment right))
    2i32
  )
  (default
    0i32
  )
)
