(import ./canvas)
(import ./point)
(import ./primitives)
(import /math)

(type + SmoothRect (is Tuple)
  (prop + bounds Rect)
  (prop + radius Length)
  (prop + smoothing F64 (= 0.6))
  (fn-do + outline _
    (param canvas Canvas)
    (let budget (/ (call min (. bounds width) (. bounds height)) 2))
    (let r (call clamp radius 0.0 budget))
    (if (<= r 0)
      (call (. canvas move) (. bounds left) (. bounds top))
      (call (. canvas line) (. bounds right) (. bounds top))
      (call (. canvas line) (. bounds right) (. bounds bottom))
      (call (. canvas line) (. bounds left) (. bounds bottom))
      (call (. canvas enclose))
      (return)
    )
    (let s (call clamp smoothing 0.0 (- (/ budget r) 1)))
    (let reach (* (+ 1 s) r))
    (let profile (call smooth-corner-profile r s))
    (call (. canvas move) (+ (. bounds left) reach) (. bounds top))
    (call trace-smooth-corner
      (block
        (arg canvas)
        (arg (call Point (. bounds right) (. bounds top)))
        (arg (call Point 1 0))
        (arg (call Point 0 1))
        (arg reach)
        (arg profile)
      )
    )
    (call trace-smooth-corner
      (block
        (arg canvas)
        (arg (call Point (. bounds right) (. bounds bottom)))
        (arg (call Point 0 1))
        (arg (call Point -1 0))
        (arg reach)
        (arg profile)
      )
    )
    (call trace-smooth-corner
      (block
        (arg canvas)
        (arg (call Point (. bounds left) (. bounds bottom)))
        (arg (call Point -1 0))
        (arg (call Point 0 -1))
        (arg reach)
        (arg profile)
      )
    )
    (call trace-smooth-corner
      (block
        (arg canvas)
        (arg (call Point (. bounds left) (. bounds top)))
        (arg (call Point 0 -1))
        (arg (call Point 1 0))
        (arg reach)
        (arg profile)
      )
    )
    (call (. canvas enclose))
  )
  (fn-do + clip _
    (param canvas Canvas)
    (call (. canvas begin))
    (call outline canvas)
    (call (. canvas clip-path))
  )
)

(fn-expr _ smooth-corner-profile (list Point)
  (param r Length)
  (param s F64)
  (call (of List Point)
    (block
      (item (call Point a 0))
      (item (call Point (+ a b) 0))
      (item start)
      (item (call Point (+ (. start x) (* handle (call cos beta))) (+ (. start y) (* handle (call sin beta)))))
      (item (call Point (- (. finish x) (* handle (call sin beta))) (- (. finish y) (* handle (call cos beta)))))
      (item finish)
      (item (call Point (+ (. finish x) d) (+ (. finish y) c)))
      (item (call Point (+ (. finish x) d) (+ (. finish y) b c)))
      (item (call Point reach reach))
    )
  )
  (where
    (lazy reach (* (+ 1 s) r))
    (lazy arc (* (/ π 2) (- 1 s)))
    (lazy chord (* (call sin (/ arc 2)) r (call sqrt 2)))
    (lazy beta (* (/ π 4) s))
    (lazy c (* r (call tan (/ beta 2)) (call cos beta)))
    (lazy d (* c (call tan beta)))
    (lazy b (/ (- reach chord c d) 3))
    (lazy a (* 2 b))
    (lazy start (call Point (+ a b c) d))
    (lazy finish (call Point (+ (. start x) chord) (+ (. start y) chord)))
    (lazy handle (* (/ 4.0 3.0) (call tan (/ arc 4)) r))
  )
)

(fn-do _ trace-smooth-corner _
  (param canvas Canvas)
  (param corner Point)
  (param along Point)
  (param across Point)
  (param reach Length)
  (param profile (list Point))
  (let origin (call Point (- (. corner x) (* (. along x) reach)) (- (. corner y) (* (. along y) reach))))
  (let placed (call (of List Point) (in (call Point (+ (. origin x) (* (. along x) (. each x)) (* (. across x) (. each y))) (+ (. origin y) (* (. along y) (. each x)) (* (. across y) (. each y)))) profile)))
  (call (. canvas line) (. origin x) (. origin y))
  (call (. canvas curve) (. ([] placed 0) x) (. ([] placed 0) y) (. ([] placed 1) x) (. ([] placed 1) y) (. ([] placed 2) x) (. ([] placed 2) y))
  (call (. canvas curve) (. ([] placed 3) x) (. ([] placed 3) y) (. ([] placed 4) x) (. ([] placed 4) y) (. ([] placed 5) x) (. ([] placed 5) y))
  (call (. canvas curve) (. ([] placed 6) x) (. ([] placed 6) y) (. ([] placed 7) x) (. ([] placed 7) y) (. ([] placed 8) x) (. ([] placed 8) y))
)
