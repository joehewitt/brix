(import ./curve-fit)
(import ./overlap)
(import ./path)
(import ./point)
(import ./primitives)
(import ./vector)
(import /math)
(blank)
(prop _ ink-speed-scale _ (= 120.0))
(prop _ ink-radius-follow _ (= 0.35))
(prop _ ink-taper-floor _ (= 0.12))
(prop _ ink-hold-widths _ (= 3.0))
(prop _ ink-freeze-widths _ (= 6.0))
(prop _ ink-spacing-widths _ (= 0.04))
(prop _ ink-fit-reach Index (= 3))
(prop _ ink-fit-density _ (= 16.0))
(prop _ ink-arc-limit _ (= (/ π 4)))

(type _ InkDisc (is Tuple)
  (prop + center Point)
  (prop + radius Length)
  (prop + travel Length)
)

(type + InkPen (is Tuple)
  (prop + size Length)
  (prop + thinning _ (= 0.5))
  (prop + smoothing _ (= 0.5))
  (prop + taper-start Length (= 0))
  (prop + taper-end Length (= 0))
  (prop + tolerance Length (= 0.5))
  (fn-expr _ spacing Length :get
    (call max tolerance (* size ink-spacing-widths))
  )
  (fn-expr _ least-radius Length :get
    (call max (* tolerance 0.25) 0.01)
  )
)

(type + InkStroke
  (prop + pen InkPen)
  (blank)
  (prop _ kept (list InkDisc))
  (prop _ tail (list InkDisc))
  (prop _ smoothed Point)
  (prop _ last-time F64)
  (prop _ travelled Length)
  (prop _ radius Length)
  (prop _ is-started _ (= false))
  (fn-do + This _
    (param pen _)
  )
  (fn-do + add _
    (param point Point)
    (param at F64)
    (if (not is-started)
      (= is-started true)
      (= smoothed point)
      (= last-time at)
      (= radius (/ (. pen size) 2))
      (+= tail (call InkDisc point radius 0))
      (return)
    )
    (= smoothed (+ smoothed (* (- point smoothed) (- 1 (call clamp (. pen smoothing) 0.0 0.9)))))
    (let latest (if-expr tail ([] tail (- (. tail length) 1)) ([] kept (- (. kept length) 1))))
    (let step (call (. smoothed distance) (. latest center)))
    (return-if (if (< step (. pen spacing))))
    (let elapsed (call max (- at last-time) 0.001))
    (= last-time at)
    (+= travelled step)
    (let speed (/ step elapsed (. pen size)))
    (let thin (* (call clamp (. pen thinning) 0.0 1.0) (call clamp (/ speed ink-speed-scale) 0.0 1.0)))
    (+= radius (* (- (* (/ (. pen size) 2) (- 1 thin)) radius) ink-radius-follow))
    (+= tail (call InkDisc smoothed radius travelled))
    (call freeze-old)
  )
  (fn-do + preview Path
    (let discs (call (of List InkDisc) kept))
    (++= discs tail)
    (return (call ink-ring-path (call ink-outline (call ink-clean (call shaped discs (. pen taper-start) 0)) (. pen tolerance))))
  )
  (fn-do + finish Path
    (return-if (call Path) (if (and (not kept) (not tail))))
    (let discs (call (of List InkDisc) kept))
    (++= discs tail)
    (let tapers (+ (. pen taper-start) (. pen taper-end)))
    (let scale (if-expr (> tapers travelled) (/ travelled tapers) 1.0))
    (let final (call shaped discs (* (. pen taper-start) scale) (* (. pen taper-end) scale)))
    (let rings (call (of List (list Point))))
    (+= rings
      (call ink-outline
        (block
          (arg (call ink-clean (call ink-pick final (call ink-prune final (* (. pen tolerance) 0.5)))))
          (arg (. pen tolerance))
        )
      )
    )
    (return (call ink-fitted (call remove-overlap rings) pen))
  )
  (fn-do _ shaped (list InkDisc)
    (param discs (list InkDisc))
    (param start Length)
    (param end Length)
    (let result (call (of List InkDisc)))
    (for (in disc discs)
      (let factor (* (call ink-taper (. disc travel) start) (call ink-taper (- travelled (. disc travel)) end)))
      (+= result (call InkDisc (. disc center) (call max (* (. disc radius) factor) (. pen least-radius)) (. disc travel)))
    )
    (return result)
  )
  (fn-do _ freeze-old _
    (let hold (+ (* (. pen size) ink-hold-widths) (. pen taper-end)))
    (return-if (if (< (call ink-length tail) (+ hold (* (. pen size) ink-freeze-widths)))))
    (let reach 0.0)
    (let index (- (. tail length) 1))
    (while (and (> index 0) (< reach hold))
      (+= reach (call (. ([] tail index) center distance) (. ([] tail (- index 1)) center)))
      (-= index 1)
    )
    (let chunk (call (of List InkDisc)))
    (if kept
      (+= chunk ([] kept (- (. kept length) 1)))
    )
    (for (in each (..< 0 index))
      (+= chunk ([] tail each))
    )
    (let flags (call ink-prune (call shaped chunk (. pen taper-start) 0) (* (. pen tolerance) 0.5)))
    (for (in each (..< (if-expr kept 1 0) (. chunk length)))
      (if (== ([] flags each) 1)
        (+= kept ([] chunk each))
      )
    )
    (let rest (call (of List InkDisc)))
    (for (in each (..< index (. tail length)))
      (+= rest ([] tail each))
    )
    (= tail rest)
  )
)

(fn-expr _ ink-taper F64
  (param distance Length)
  (param length Length)
  (if-expr (<= length 0) 1.0 (+ ink-taper-floor (* (- 1 ink-taper-floor) eased)))
  (where
    (lazy clamped (call clamp (/ distance length) 0.0 1.0))
    (lazy eased (* clamped (- 2 clamped)))
  )
)

(fn-do _ ink-length Length
  (param discs (list InkDisc))
  (return-if 0.0 (if (< (. discs length) 2)))
  (let total 0.0)
  (for (in index (..< 1 (. discs length)))
    (+= total (call (. ([] discs index) center distance) (. ([] discs (- index 1)) center)))
  )
  (return total)
)

(fn-do _ ink-clean (list InkDisc)
  (param discs (list InkDisc))
  (let clean (call (of List InkDisc)))
  (for (in disc discs)
    (let adding true)
    (while (and adding clean)
      (let previous ([] clean (- (. clean length) 1)))
      (let gap (call (. disc center distance) (. previous center)))
      (if (<= (+ gap (. disc radius)) (. previous radius))
        (= adding false)
        (else-if (<= (+ gap (. previous radius)) (. disc radius))
          (call (. clean pop))
        )
        (else
          (break)
        )
      )
    )
    (if adding
      (+= clean disc)
    )
  )
  (return clean)
)

(fn-do _ ink-prune ([] U8)
  (param discs (list InkDisc))
  (param tolerance Length)
  (let keep ([] U8 (. discs length)))
  (return-if keep (if (not discs)))
  (= ([] keep 0) 1)
  (= ([] keep (- (. discs length) 1)) 1)
  (return-if keep (if (<= (. discs length) 2)))
  (let firsts (call (of List Index)))
  (let lasts (call (of List Index)))
  (+= firsts 0)
  (+= lasts (- (. discs length) 1))
  (while firsts
    (let first (call (. firsts pop)))
    (let last (call (. lasts pop)))
    (let worst 0.0)
    (let split first)
    (for (in index (..< (+ first 1) last))
      (let miss (call ink-deviation ([] discs index) ([] discs first) ([] discs last)))
      (if (> miss worst)
        (= worst miss)
        (= split index)
      )
    )
    (if (> worst tolerance)
      (= ([] keep split) 1)
      (+= firsts first)
      (+= lasts split)
      (+= firsts split)
      (+= lasts last)
    )
  )
  (return keep)
)

(fn-expr _ ink-pick (list InkDisc)
  (param discs (list InkDisc))
  (param flags ([] U8))
  (in ([] discs each) (..< 0 (. discs length)) (when (== ([] flags each) 1)))
)

(fn-expr _ ink-deviation Length
  (param disc InkDisc)
  (param from InkDisc)
  (param to InkDisc)
  (call sqrt (+ (* place place) (* size size)))
  (where
    (lazy along (- (. to center) (. from center)))
    (lazy span (call (. along dot) along))
    (lazy t (if-expr (> span 0) (call clamp (/ (call (. (- (. disc center) (. from center)) dot) along) span) 0.0 1.0) 0.0))
    (lazy place (call (. disc center distance) (+ (. from center) (* along t))))
    (lazy size (- (. disc radius) (+ (. from radius) (* (- (. to radius) (. from radius)) t))))
  )
)

(fn-do _ ink-outline (list Point)
  (param discs (list InkDisc))
  (param tolerance Length)
  (let count (. discs length))
  (let ring (call (of List Point)))
  (return-if ring (if (== count 0)))
  (if (== count 1)
    (let only ([] discs 0))
    (+= ring (+ (. only center) (call Point (. only radius) 0)))
    (call ink-arc ring only (call Point 1 0) (call Point 1 0) tolerance)
    (return ring)
  )
  (let lefts (call (of List Point)))
  (let rights (call (of List Point)))
  (for (in index (..< 0 (- count 1)))
    (let a ([] discs index))
    (let b ([] discs (+ index 1)))
    (let along (- (. b center) (. a center)))
    (let unit (/ along (. along length)))
    (let normal (call Point (- (. unit y)) (. unit x)))
    (let lean (call clamp (/ (- (. a radius) (. b radius)) (. along length)) -1.0 1.0))
    (let upright (call sqrt (- 1 (* lean lean))))
    (+= lefts (+ (* normal upright) (* unit lean)))
    (+= rights (+ (* normal (- upright)) (* unit lean)))
  )
  (for (in index (..< 0 (- count 1)))
    (let a ([] discs index))
    (let b ([] discs (+ index 1)))
    (if (> index 0)
      (call ink-join ring a ([] rights (- index 1)) ([] rights index) tolerance)
    )
    (+= ring (+ (. a center) (* ([] rights index) (. a radius))))
    (+= ring (+ (. b center) (* ([] rights index) (. b radius))))
  )
  (call ink-arc ring ([] discs (- count 1)) ([] rights (- count 2)) ([] lefts (- count 2)) tolerance)
  (for (in step (..< 0 (- count 1)))
    (let index (- count 2 step))
    (let a ([] discs index))
    (let b ([] discs (+ index 1)))
    (if (< index (- count 2))
      (call ink-join ring b ([] lefts (+ index 1)) ([] lefts index) tolerance)
    )
    (+= ring (+ (. b center) (* ([] lefts index) (. b radius))))
    (+= ring (+ (. a center) (* ([] lefts index) (. a radius))))
  )
  (call ink-arc ring ([] discs 0) ([] lefts 0) ([] rights 0) tolerance)
  (return ring)
)

(fn-do _ ink-join _
  (param ring (list Point))
  (param disc InkDisc)
  (param from Point)
  (param to Point)
  (param tolerance Length)
  (if (> (call (. from cross) to) 0)
    (call ink-arc ring disc from to tolerance)
    (else
      (+= ring (. disc center))
    )
  )
)

(fn-do _ ink-arc _
  (param ring (list Point))
  (param disc InkDisc)
  (param from Point)
  (param to Point)
  (param tolerance Length)
  (let sweep (as (call atan2 (call (. from cross) to) (call (. from dot) to)) F64))
  (if (<= sweep 0)
    (+= sweep (* 2 (as π F64)))
  )
  (let ratio (call clamp (- 1 (/ tolerance (. disc radius))) -1.0 1.0))
  (let limit (call clamp (as (* 2 (call acos ratio)) F64) 0.05 ink-arc-limit))
  (let steps (call max (as (call ceil (/ sweep limit)) Index) 1))
  (let start (as (call atan2 (. from y) (. from x)) F64))
  (for (in index (..< 1 steps))
    (let angle (+ start (/ (* sweep (as index F64)) (as steps F64))))
    (+= ring (+ (. disc center) (* (call Point (call cos angle) (call sin angle)) (. disc radius))))
  )
)

(fn-do _ ink-ring-path Path
  (param ring (list Point))
  (let path (call Path))
  (return-if path (if (< (. ring length) 3)))
  (call (. path move-to) ([] ring 0))
  (for (in index (..< 1 (. ring length)))
    (call (. path line-to) ([] ring index))
  )
  (call (. path close))
  (return path)
)

(fn-do _ ink-fitted Path
  (param rings (list (list Point)))
  (param pen InkPen)
  (let spacing (call max (. pen tolerance) (/ (. pen size) ink-fit-density)))
  (let fitter (call CurveFitter (. pen tolerance) ink-fit-reach))
  (let ops (call (of List PathOp)))
  (for (in ring rings)
    (++= ops (call (. fitter fit) (call ink-subdivide ring spacing) (call (of List Index)) true))
  )
  (return (?? (call vector-path ops) (call Path)))
)

(fn-do _ ink-subdivide (list Point)
  (param ring (list Point))
  (param spacing Length)
  (let points (call (of List Point)))
  (for (in index (..< 0 (. ring length)))
    (let a ([] ring index))
    (let b ([] ring (% (+ index 1) (. ring length))))
    (let pieces (call max (as (call ceil (/ (call (. a distance) b) spacing)) Index) 1))
    (for (in piece (..< 0 pieces))
      (+= points (+ a (* (- b a) (/ (as piece F64) (as pieces F64)))))
    )
  )
  (return points)
)
