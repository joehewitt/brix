(import ./canvas)
(import /BxMovie/BxMovie.h)
(import /time/duration)
(blank)
(prop _ movie-writing U32 (= 1))
(prop _ movie-saving U32 (= 2))
(prop _ movie-saved U32 (= 3))
(prop _ movie-pause Duration (= 2ms))

(type + MovieError (is Error))

(type + MovieWriter
  (implements Closable)
  (prop + path String)
  (prop + width I32)
  (prop + height I32)
  (prop + frame-rate F64)
  (prop _ native Pointer)
  (prop _ is-closed _ (= false))
  (fn-do + This _ (?! Error)
    (param path String)
    (param width I32)
    (param height I32)
    (param frame-rate F64)
    (let created (call C:brixMovieCreate path width height frame-rate))
    (if (!= (call C:brixMovieGetStatus created) movie-writing)
      (let problem String (call C:brixMovieGetError created))
      (call C:brixMovieRelease created)
      (throw (call MovieError problem))
    )
    (= (. this path) path)
    (= (. this width) width)
    (= (. this height) height)
    (= (. this frame-rate) frame-rate)
    (= native created)
  )
  (fn-expr + frame-count I64 :get
    (if-expr is-closed 0i64 (call C:brixMovieGetFrameCount native))
  )
  (fn-do + add _ (?! Error)
    (param canvas RasterCanvas)
    (throw (call MovieError "The movie is closed") (if is-closed))
    (while (and (not (call C:brixMovieIsReady native)) (== (call C:brixMovieGetStatus native) movie-writing))
      (call (. movie-pause wait))
    )
    (if (not (call C:brixMovieAppendCanvas native (. canvas native)))
      (call fail)
    )
  )
  (fn-do + finish _ (?! Error)
    (throw (call MovieError "The movie is closed") (if is-closed))
    (if (not (call C:brixMovieFinish native))
      (call fail)
    )
    (while (== (call C:brixMovieGetStatus native) movie-saving)
      (call (. movie-pause wait))
    )
    (if (!= (call C:brixMovieGetStatus native) movie-saved)
      (call fail)
    )
  )
  (fn-do _ fail _ (?! Error)
    (let problem String (call C:brixMovieGetError native))
    (throw (call MovieError (if-expr (. problem length) problem "The movie could not be written")))
  )
  (fn-do + close _
    (if (not is-closed)
      (= is-closed true)
      (call C:brixMovieRelease native)
    )
  )
)
