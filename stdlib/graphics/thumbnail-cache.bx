(import ./image)
(import /os/path)
(import /stream/sort)

(type + ThumbnailClient (is Interface)
  (fn-do + thumbnail-loaded _
    (param ticket ThumbnailTicket)
  )
  (fn-do + thumbnail-priority F64
    (param ticket ThumbnailTicket)
  )
)

(type + ThumbnailState (is U8)
  (variant idle (= 0))
  (variant queued (= 1))
  (variant loading (= 2))
  (variant ready (= 3))
  (variant failed (= 4))
)

(type + ThumbnailEntry
  (prop + key String)
  (prop + path Path)
  (prop + bucket I32)
  (prop + image (? Image))
  (prop + state _ (= (. ThumbnailState idle)))
  (prop + used U64)
  (prop + byte-count Size)
  (prop + tickets (list ThumbnailTicket))
  (prop + is-removed _ (= false))
  (fn-do + This _
    (param key _)
    (param path _)
    (param bucket _)
  )
)

(type + ThumbnailTicket
  (prop + entry ThumbnailEntry)
  (prop + client ThumbnailClient)
  (prop + is-active _ (= true))
  (prop + image _ (=> (. entry image)))
  (prop + is-settled _ (=> (or (== (. entry state) (. ThumbnailState ready)) (== (. entry state) (. ThumbnailState failed)))))
  (fn-do + This _
    (param entry _)
    (param client _)
  )
)

(type + ThumbnailCache
  (implements Closable)
  (prop + budget-bytes Size (= 268435456))
  (prop + concurrency Size (= 4))
  (prop + buckets (list I32) (= (call (of List I32) 128 256 512 1024)))
  (blank)
  (prop _ entries (of Map String ThumbnailEntry))
  (prop _ queue (list ThumbnailEntry))
  (prop _ active Size)
  (prop _ tick U64)
  (prop _ byte-total Size)
  (prop _ is-closed _ (= false))
  (prop _ is-pump-scheduled _ (= false))
  (fn-expr + byte-count Size :get
    byte-total
  )
  (fn-expr + pending-count Size :get
    (+ (. queue length) active)
  )
  (fn-do + bucket-for I32
    (param pixel-size I32)
    (for (in bucket buckets)
      (return-if bucket (if (>= (* bucket 5) (* pixel-size 4))))
    )
    (return ([] buckets (- (. buckets length) 1)))
  )
  (fn-do + request ThumbnailTicket
    (param path Path)
    (param pixel-size I32)
    (param client ThumbnailClient)
    (let entry (call entry-for path (call bucket-for pixel-size)))
    (let ticket (call ThumbnailTicket entry client))
    (+= (. entry tickets) ticket)
    (+= tick 1)
    (= (. entry used) tick)
    (if (or (== (. entry state) (. ThumbnailState idle)) (== (. entry state) (. ThumbnailState queued)))
      (call enqueue entry)
      (call schedule-pump)
    )
    (return ticket)
  )
  (fn-do + ready-ticket (? ThumbnailTicket)
    (param path Path)
    (param client ThumbnailClient)
    (let index (. buckets length))
    (while (> index 0)
      (-= index 1)
      (let entry ([] entries (str ([] buckets index) ":" path)))
      (if (and entry (== (. entry state) (. ThumbnailState ready)))
        (let ticket (call ThumbnailTicket entry client))
        (+= (. entry tickets) ticket)
        (+= tick 1)
        (= (. entry used) tick)
        (return ticket)
      )
    )
    (return null)
  )
  (fn-do + cancel _
    (param ticket ThumbnailTicket)
    (return-if (if (not (. ticket is-active))))
    (= (. ticket is-active) false)
    (let entry (. ticket entry))
    (let tickets (. entry tickets))
    (for (in index (..< 0 (. tickets length)))
      (if (== (as ([] tickets index) Pointer) (as ticket Pointer))
        (call (. tickets remove) index)
        (break)
      )
    )
    (if (and (== (. tickets length) 0) (== (. entry state) (. ThumbnailState queued)))
      (call dequeue entry)
      (= (. entry state) (. ThumbnailState idle))
    )
    (call trim)
  )
  (fn-do + invalidate _
    (param path Path)
    (for (in bucket buckets)
      (let key (str bucket ":" path))
      (let entry ([] entries key))
      (if entry
        (-= ([] entries key))
        (call discard entry)
        (if (> (. entry tickets length) 0)
          (let replacement (call entry-for path bucket))
          (for (in ticket (. entry tickets))
            (= (. ticket entry) replacement)
            (+= (. replacement tickets) ticket)
          )
          (call (. entry tickets clear))
          (= (. replacement used) (. entry used))
          (call enqueue replacement)
        )
      )
    )
    (call schedule-pump)
  )
  (fn-do + close _
    (return-if (if is-closed))
    (= is-closed true)
    (call (. queue clear))
    (for (in entry (. entries values))
      (call discard entry)
    )
    (call (. entries clear))
  )
  (fn-do _ entry-for ThumbnailEntry
    (param path Path)
    (param bucket I32)
    (let key (str bucket ":" path))
    (let existing ([] entries key))
    (return-if existing (if existing))
    (let entry (call ThumbnailEntry key path bucket))
    (= ([] entries key) entry)
    (return entry)
  )
  (fn-do _ enqueue _
    (param entry ThumbnailEntry)
    (if (== (. entry state) (. ThumbnailState queued))
      (call dequeue entry)
    )
    (= (. entry state) (. ThumbnailState queued))
    (+= queue entry)
  )
  (fn-do _ dequeue _
    (param entry ThumbnailEntry)
    (for (in index (..< 0 (. queue length)))
      (if (== (as ([] queue index) Pointer) (as entry Pointer))
        (call (. queue remove) index)
        (break)
      )
    )
  )
  (fn-do _ schedule-pump _
    (return-if (if (or is-pump-scheduled is-closed)))
    (= is-pump-scheduled true)
    (do-new
      (inline (call run-scheduled-pump))
    )
  )
  (fn-do _ run-scheduled-pump _
    (= is-pump-scheduled false)
    (call pump)
  )
  (fn-do _ pump _
    (while (and (not is-closed) (< active concurrency) (> (. queue length) 0))
      (let entry (call take-next))
      (if (== (. entry tickets length) 0)
        (= (. entry state) (. ThumbnailState idle))
        (else
          (= (. entry state) (. ThumbnailState loading))
          (+= active 1)
          (do-new
            (inline (call load entry))
          )
        )
      )
    )
  )
  (fn-do _ take-next ThumbnailEntry
    (let best Size)
    (let best-priority F64)
    (for (in index (..< 0 (. queue length)))
      (let priority (call entry-priority ([] queue index)))
      (if (or (== index 0) (<= priority best-priority))
        (= best index)
        (= best-priority priority)
      )
    )
    (let entry ([] queue best))
    (call (. queue remove) best)
    (return entry)
  )
  (fn-do _ entry-priority F64
    (param entry ThumbnailEntry)
    (let result F64)
    (let found false)
    (for (in ticket (. entry tickets))
      (if (. ticket is-active)
        (let priority (call (. ticket client thumbnail-priority) ticket))
        (if (or (not found) (< priority result))
          (= result priority)
          (= found true)
        )
      )
    )
    (return result)
  )
  (fn-do _ load _
    (param entry ThumbnailEntry)
    (let image (catch? (call load-thumbnail (. entry path) (. entry bucket))))
    (-= active 1)
    (if (or is-closed (. entry is-removed))
      (call (?. image release))
      (call pump)
      (return)
    )
    (= (. entry image) image)
    (= (. entry state) (if-expr image (. ThumbnailState ready) (. ThumbnailState failed)))
    (= (. entry byte-count) (?? (?. image byte-count) 0))
    (+= byte-total (. entry byte-count))
    (for (in ticket (call (of List ThumbnailTicket) (. entry tickets)))
      (if (. ticket is-active)
        (call (. ticket client thumbnail-loaded) ticket)
      )
    )
    (call trim)
    (call pump)
  )
  (fn-do _ discard _
    (param entry ThumbnailEntry)
    (= (. entry is-removed) true)
    (if (== (. entry state) (. ThumbnailState queued))
      (call dequeue entry)
    )
    (-= byte-total (. entry byte-count))
    (= (. entry byte-count) 0)
    (call (?. (. entry image) release))
    (= (. entry image) null)
    (= (. entry state) (. ThumbnailState idle))
  )
  (fn-do _ trim _
    (return-if (if (<= byte-total budget-bytes)))
    (let candidates (call (of List ThumbnailEntry)))
    (for (in entry (. entries values))
      (if (and (== (. entry tickets length) 0) (== (. entry state) (. ThumbnailState ready)))
        (+= candidates entry)
      )
    )
    (let ordered (call sort candidates (:using thumbnail-older)))
    (let floor (- budget-bytes (/ budget-bytes 10)))
    (for (in entry ordered)
      (return-if (if (<= byte-total floor)))
      (-= ([] entries (. entry key)))
      (call discard entry)
    )
  )
)

(fn-expr _ thumbnail-older Comparison
  (param left ThumbnailEntry)
  (param right ThumbnailEntry)
  (case? (< (. left used) (. right used))
    (. Comparison lesser)
  )
  (case? (> (. left used) (. right used))
    (. Comparison greater)
  )
  (default
    (. Comparison equal)
  )
)
