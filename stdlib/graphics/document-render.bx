(import ./appearance)
(import ./canvas)
(import ./color)
(import ./document)
(import ./document-paths)
(import ./document-rows)
(import ./effect)
(import ./matrix)
(import ./network)
(import ./network-regions)
(import ./path)
(import ./point)
(import ./primitives)
(import ./style)
(import ./vectorgeometry)
(import /core/map)
(import /math)
(import /units)
(blank)
(prop _ vector-document-render-seed U64 (= 1469598103934665603u64))
(prop + vector-document-render-entries-per-node Size (= 4))

(type + VectorDocumentRegionPaint (is Tuple)
  (prop + path Path)
  (prop + color RGBA)
)

(type + VectorDocumentRenderItemKind (is U8)
  (variant render-element (= 0))
  (variant render-begin-layer (= 1))
  (variant render-end-layer (= 2))
  (variant render-embed (= 3))
  (variant render-begin-content (= 4))
  (variant render-end-content (= 5))
  (variant render-image (= 6))
)

(type + VectorDocumentImagePainter (is Interface)
  (fn-do + paint-document-image _
    (param canvas Canvas)
    (param image String)
    (param bounds Rect)
    (param world Matrix)
  )
)

(type + VectorDocumentEmbedPainter (is Interface)
  (fn-do + paint-embed _
    (param canvas Canvas)
    (param id U64)
    (param world Matrix)
  )
  (fn-do + paints-embed-content Bool
    (param id U64)
  )
)

(type + VectorDocumentRenderEntry
  (prop + id U64)
  (prop + key U64)
  (prop + paths (list Path))
  (prop + appearance VectorAppearance)
  (prop + regions (list VectorDocumentRegionPaint))
  (prop + ink-bounds Rect)
  (prop + palette (list RGBA))
  (prop + geometry VectorGeometry)
  (prop + handle (? VectorGeometryHandle))
  (prop + table (? VectorGeometryTable))
  (prop + last-use Size)
  (fn-do + This _
    (param id _)
    (param key _)
    (param paths _)
    (param appearance _)
    (param regions _)
    (param ink-bounds _)
    (param palette _)
    (param geometry _)
  )
  (fn-do + release-handle _
    (let current handle)
    (let owner table)
    (if (and current owner)
      (call (. owner release) current)
    )
    (= handle null)
    (= table null)
  )
)

(type + VectorDocumentRenderItem (is Tuple)
  (prop + kind VectorDocumentRenderItemKind)
  (prop + id U64)
  (prop + transform Matrix)
  (prop + opacity Ratio)
  (prop + entry (? VectorDocumentRenderEntry))
)

(type + VectorDocumentRenderer
  (implements (of Usable Void))
  (prop + document VectorDocument)
  (prop + paths VectorDocumentPaths)
  (prop + base-appearance _ (= (call VectorAppearance)))
  (prop + built Size)
  (prop + reused Size)
  (prop + last-built Size)
  (prop + last-reused Size)
  (prop + syncs Size)
  (blank)
  (prop _ tracker _ (= (call VectorDocumentChangeTracker)))
  (prop _ entries (of Map U64 (list VectorDocumentRenderEntry)))
  (prop _ render-items (list VectorDocumentRenderItem))
  (prop _ entry-count Size)
  (prop _ clock Size)
  (prop _ synced _ (= false))
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + This _
    (param document _)
    (lazy paths (call VectorDocumentPaths document))
  )
  (fn-do + This _
    (param document _)
    (param paths _)
  )
  (fn-expr + effect-computations Size :get
    (. paths effect-computations)
  )
  (fn-do + items (list VectorDocumentRenderItem) :get
    (for (in item render-items)
      (yield item)
    )
  )
  (fn-expr + item-count _ :get
    (. render-items length)
  )
  (fn-expr + cached-entry-count Size :get
    entry-count
  )
  (fn-do + sync _
    (let changes (call (. tracker scan) document))
    (return-if false (if (and synced (not (. changes changed length)) (not (. changes removed length)))))
    (= synced true)
    (+= syncs 1)
    (+= clock 1)
    (= last-built 0)
    (= last-reused 0)
    (call (. render-items clear))
    (call walk
      (block
        (arg (. document store root))
        (arg base-appearance)
        (arg (call appearance-hash base-appearance))
        (arg vector-document-render-seed)
        (arg (call Matrix))
      )
    )
    (if (or (. changes removed length) (> entry-count entry-budget))
      (call trim)
    )
    (if (. changes removed length)
      (call (. paths trim))
    )
    (return true)
  )
  (fn-do + invalidate _
    (= synced false)
  )
  (fn-do + paint _
    (param canvas Canvas)
    (param base Matrix (= (call Matrix)))
    (param table (? VectorGeometryTable) (= null))
    (param embeds (? VectorDocumentEmbedPainter) (= null))
    (param subtree (? U64) (= null))
    (param images (? VectorDocumentImagePainter) (= null))
    (let sealed Size 0)
    (let members (call subtree-members subtree))
    (for (in item render-items)
      (if (== (. item kind) .render-begin-content)
        (if (or (> sealed 0) (not embeds) (not (call (. embeds paints-embed-content) (. item id))))
          (+= sealed 1)
        )
        (else-if (== (. item kind) .render-end-content)
          (if (> sealed 0)
            (-= sealed 1)
          )
        )
        (else-if (> sealed 0)
          (continue)
        )
        (else-if (and members (not ([] members (. item id))))
          (continue)
        )
        (else-if (== (. item kind) .render-begin-layer)
          (call (. canvas push))
          (call (. canvas begin-opacity) (. item opacity))
        )
        (else-if (== (. item kind) .render-end-layer)
          (call (. canvas end-opacity))
          (call (. canvas pop))
        )
        (else-if (== (. item kind) .render-embed)
          (call (?. embeds paint-embed) canvas (. item id) (call (. base concatenate) (. item transform)))
        )
        (else-if (== (. item kind) .render-image)
          (if images
            (call (. images paint-document-image)
              (block
                (arg canvas)
                (arg (call (. document image) (. item id)))
                (arg (call (. document view-box) (. item id)))
                (arg (call (. base concatenate) (. item transform)))
              )
            )
          )
        )
        (else
          (call paint-entry canvas (!! (. item entry)) (call (. base concatenate) (. item transform)) table)
        )
      )
    )
  )
  (fn-do + release _
    (for (in id (call (of List U64) (. entries keys)))
      (for (in entry (!! ([] entries id)))
        (call (. entry release-handle))
      )
    )
    (call (. entries clear))
    (= entry-count 0)
    (= synced false)
  )
  (fn-do _ subtree-members (? (of Map U64 Bool))
    (param root (? U64))
    (return-if null (if (not root)))
    (let members
      (call (of Map U64 Bool)
        (block
          (entry root true)
        )
      )
    )
    (for (in id (call (. document descendants) root))
      (= ([] members id) true)
    )
    (return members)
  )
  (fn-do _ paint-entry _
    (param canvas Canvas)
    (param entry VectorDocumentRenderEntry)
    (param world Matrix)
    (param table (? VectorGeometryTable))
    (if table
      (let handle (call acquire-handle entry table))
      (return-if (if (call (. table paint-vector) handle canvas (. entry palette) world)))
    )
    (do-use (. canvas saved-state)
      (if (not (. world is-identity))
        (call (. canvas transform) world)
      )
      (call (. entry geometry paint) canvas (. entry palette))
    )
  )
  (fn-do _ acquire-handle _
    (param entry VectorDocumentRenderEntry)
    (param table VectorGeometryTable)
    (if (and (. entry handle) (. entry table) (== (as (. entry table) Pointer) (as table Pointer)))
      (return (. entry handle))
    )
    (call (. entry release-handle))
    (let geometry (. entry geometry))
    (let handle (call (. table intern-geometry) (. entry key) (=> () geometry)))
    (= (. entry handle) handle)
    (= (. entry table) table)
    (return handle)
  )
  (fn-do _ walk _
    (param row Index)
    (param inherited VectorAppearance)
    (param inherited-key U64)
    (param chain-key U64)
    (param parent-transform Matrix)
    (param chain (? VectorEffects) (= null))
    (let node ([] (. document store nodes) row))
    (return-if (if (!= (/and/ (. node flags) (/or/ vector-document-hidden vector-document-guide)) 0)))
    (let opacity (call clamped-opacity (. node opacity)))
    (return-if (if (<= opacity 0%%)))
    (let id (. node id))
    (let own-transform (call (. document row-transform) row))
    (let transform (if-expr own-transform (call (. parent-transform concatenate) own-transform) parent-transform))
    (let own-fill (call (. document row-fill) row))
    (let own-stroke (call (. document row-stroke) row))
    (let own-stroke-width (? Length) (only-if (. node stroke-width) (if (. node has-stroke-width))))
    (let own-alignment (call vector-document-alignment (. node stroke-alignment)))
    (let own-cap (call vector-document-cap (. node stroke-cap)))
    (let own-join (call vector-document-join (. node stroke-join)))
    (let own-fill-rule (call vector-document-fill-rule (. node fill-rule)))
    (let appearance inherited)
    (let paint-key inherited-key)
    (let inherits-fill (or (not own-fill) (== own-fill (. Fill inherit))))
    (let inherits-stroke (or (not own-stroke) (== own-stroke (. Stroke inherit))))
    (let inherits-style (and (not own-stroke-width) (not own-alignment) (not own-cap) (not own-join) (not own-fill-rule)))
    (if (or (not inherits-fill) (not inherits-stroke) (not inherits-style))
      (= appearance
        (call (. inherited over)
          (block
            (arg (?? own-fill (. Fill inherit)))
            (arg (?? own-stroke (. Stroke inherit)))
            (arg own-stroke-width)
            (arg own-alignment)
            (arg own-cap)
            (arg own-join)
            (arg own-fill-rule)
          )
        )
      )
      (= paint-key (call appearance-hash appearance))
    )
    (if (< opacity 1%%)
      (+= render-items (call VectorDocumentRenderItem .render-begin-layer id transform opacity null))
    )
    (if (and (== (. node kind) .group-node) (== (. node group-kind) .embed-group))
      (+= render-items (call VectorDocumentRenderItem .render-embed id transform 1%% null))
      (if (!= (. node first-child) 0)
        (+= render-items (call VectorDocumentRenderItem .render-begin-content id transform 1%% null))
        (let child (. node first-child))
        (while (!= child 0)
          (call walk child appearance paint-key chain-key transform chain)
          (= child (. ([] (. document store nodes) child) next-sibling))
        )
        (+= render-items (call VectorDocumentRenderItem .render-end-content id transform 1%% null))
      )
      (else-if (== (. node kind) .image-node)
        (+= render-items (call VectorDocumentRenderItem .render-image id transform 1%% null))
      )
      (else-if (== (. node kind) .group-node)
        (let effects (only-if (call (. document row-effects) row) (if (. node effects count))))
        (if (and effects (. effects combines-geometry))
          (let key (call element-key id (call (. paths combined-key) id) chain-key paint-key))
          (let entry (?? (call cached id key) (call build id key (call (. paths group-paths) id) appearance false chain)))
          (+= render-items (call VectorDocumentRenderItem .render-element id transform 1%% entry))
          (else
            (let member-chain chain)
            (let member-key chain-key)
            (if (and effects (. effects has-enabled))
              (= member-chain (if-expr (not chain) effects (call (. effects followed-by) chain)))
              (= member-key (call vector-document-mix chain-key (. node effects-stamp)))
            )
            (let child (. node first-child))
            (while (!= child 0)
              (call walk child appearance paint-key member-key transform member-chain)
              (= child (. ([] (. document store nodes) child) next-sibling))
            )
          )
        )
      )
      (else
        (let own-key
          (call vector-document-mix
            (block
              (arg (call vector-document-mix (. node geometry-stamp) (. node effects-stamp)))
              (arg (. node paint-stamp))
            )
          )
        )
        (let key (call element-key id own-key chain-key paint-key))
        (let entry (?? (call cached id key) (call build id key (call (. paths network-paths) id) appearance true chain)))
        (+= render-items (call VectorDocumentRenderItem .render-element id transform 1%% entry))
      )
    )
    (if (< opacity 1%%)
      (+= render-items (call VectorDocumentRenderItem .render-end-layer id transform opacity null))
    )
  )
  (fn-do _ cached _
    (param id U64)
    (param key U64)
    (let list ([] entries id))
    (return-if null (if (not list)))
    (for (in entry list)
      (if (== (. entry key) key)
        (= (. entry last-use) clock)
        (+= reused 1)
        (+= last-reused 1)
        (probe-count graphics.document.render.reused)
        (return entry)
      )
    )
    (return null)
  )
  (fn-do _ build _
    (param id U64)
    (param key U64)
    (param source (list Path))
    (param appearance VectorAppearance)
    (param network Bool)
    (param chain (? VectorEffects) (= null))
    (+= built 1)
    (+= last-built 1)
    (probe-count graphics.document.render.built)
    (let paths (if-expr chain (call (. chain apply) source) source))
    (let regions (if-expr network (call region-paints id) (call (of List VectorDocumentRegionPaint))))
    (let ink-bounds (call ink-bounds-of paths regions appearance))
    (let palette (list RGBA))
    (let geometry (call compile-geometry paths regions appearance ink-bounds palette))
    (let entry
      (call VectorDocumentRenderEntry
        (block
          (arg id)
          (arg key)
          (arg paths)
          (arg appearance)
          (arg regions)
          (arg ink-bounds)
          (arg palette)
          (arg geometry)
        )
      )
    )
    (= (. entry last-use) clock)
    (let list ([] entries id))
    (if list
      (if (>= (. list length) vector-document-render-entries-per-node)
        (let oldest (call oldest-index list))
        (call (. ([] list oldest) release-handle))
        (-= ([] list oldest))
        (-= entry-count 1)
      )
      (+= list entry)
      (else
        (let created (list VectorDocumentRenderEntry))
        (+= created entry)
        (= ([] entries id) created)
      )
    )
    (+= entry-count 1)
    (return entry)
  )
  (fn-do _ compile-geometry _
    (param paths (list Path))
    (param regions (list VectorDocumentRegionPaint))
    (param appearance VectorAppearance)
    (param ink-bounds Rect)
    (param palette (list RGBA))
    (let spans (list VectorGeometrySpan))
    (let no-paint (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
    (for (in region regions)
      (+= spans
        (call VectorGeometrySpan
          (block
            (arg (. region path))
            (arg (call VectorGeometryPaint (. VectorGeometryPaintRole color) (as (. palette length) U32)))
            (arg no-paint)
            (arg (. appearance stroke-width))
            (arg (. appearance stroke-cap))
            (arg (. appearance stroke-join))
            (arg (. FillRule nonzero))
          )
        )
      )
      (+= palette (. region color))
    )
    (if (. appearance is-simple)
      (let fill no-paint)
      (if (is (. appearance fill) RGBA)
        (= fill (call VectorGeometryPaint (. VectorGeometryPaintRole color) (as (. palette length) U32)))
        (+= palette (. appearance fill))
      )
      (let stroke no-paint)
      (if (is (. appearance stroke) RGBA)
        (= stroke (call VectorGeometryPaint (. VectorGeometryPaintRole color) (as (. palette length) U32)))
        (+= palette (. appearance stroke))
      )
      (for (in path paths)
        (+= spans
          (call VectorGeometrySpan
            (block
              (arg path)
              (arg fill)
              (arg stroke)
              (arg (. appearance stroke-width))
              (arg (. appearance stroke-cap))
              (arg (. appearance stroke-join))
              (arg (. appearance fill-rule))
            )
          )
        )
      )
      (return (call VectorGeometry ink-bounds ink-bounds spans false false))
    )
    (for (in layer (. appearance fill layers))
      (let color (. layer painted-color))
      (if color
        (let fill (call VectorGeometryPaint (. VectorGeometryPaintRole color) (as (. palette length) U32)))
        (+= palette color)
        (for (in path paths)
          (+= spans
            (call VectorGeometrySpan
              (block
                (arg path)
                (arg fill)
                (arg no-paint)
                (arg null)
                (arg null)
                (arg null)
                (arg (. appearance fill-rule))
              )
            )
          )
        )
      )
    )
    (for (in layer (. appearance resolved-stroke-layers))
      (let color (. layer painted-color))
      (let width (?? (. layer width) (. appearance stroke-width)))
      (if (and color (> width 0))
        (let stroke (call VectorGeometryPaint (. VectorGeometryPaintRole color) (as (. palette length) U32)))
        (+= palette color)
        (for (in path paths)
          (+= spans
            (call VectorGeometrySpan
              (block
                (arg path)
                (arg no-paint)
                (arg stroke)
                (arg width)
                (arg (?? (. layer cap) (. appearance stroke-cap)))
                (arg (?? (. layer join) (. appearance stroke-join)))
                (arg (. appearance fill-rule))
                (arg (?? (. layer alignment) (. appearance stroke-alignment)))
              )
            )
          )
        )
      )
    )
    (return (call VectorGeometry ink-bounds ink-bounds spans false false))
  )
  (fn-do _ region-paints _
    (param id U64)
    (let result (list VectorDocumentRegionPaint))
    (let fills (call (. document region-fills) id))
    (let painted false)
    (for (in fill fills)
      (if (or (. fill fill) (. fill conflict))
        (= painted true)
      )
    )
    (return-if result (if (not painted)))
    (let regions (call (. paths regions) id))
    (for (in region (. regions regions))
      (for (in fill fills)
        (if (and (== (. fill region) (. region id)) (. fill fill))
          (+= result (call VectorDocumentRegionPaint (. region path) (. fill fill)))
        )
      )
    )
    (return result)
  )
  (fn-expr _ entry-budget Size :get
    (+ (* (. document node-count) vector-document-render-entries-per-node) 64)
  )
  (fn-do _ trim _
    (let budget entry-budget)
    (for (in id (call (of List U64) (. entries keys)))
      (let list (!! ([] entries id)))
      (let limit (if-expr (call (. document contains) id) vector-document-render-entries-per-node 1))
      (if (and (> entry-count budget) (not (call (. document contains) id)))
        (= limit 0)
      )
      (while (> (. list length) limit)
        (let oldest (call oldest-index list))
        (call (. ([] list oldest) release-handle))
        (-= ([] list oldest))
        (-= entry-count 1)
      )
      (if (not (. list length))
        (-= ([] entries id))
      )
    )
  )
  (fn-do _ oldest-index _
    (param list (list VectorDocumentRenderEntry))
    (let result Index 0)
    (for (in index (..< 1 (. list length)))
      (if (< (. ([] list index) last-use) (. ([] list result) last-use))
        (= result index)
      )
    )
    (return result)
  )
  (fn-do _ appearance-hash _
    (param appearance VectorAppearance)
    (let result (call mix-fill vector-document-render-seed (. appearance fill)))
    (= result (call mix-stroke result (. appearance stroke)))
    (= result (call (. document mix-number) result (. appearance stroke-width)))
    (= result
      (call vector-document-mix
        (block
          (arg result)
          (arg (call vector-document-optional-alignment (. appearance stroke-alignment)))
        )
      )
    )
    (= result (call vector-document-mix result (call vector-document-optional-cap (. appearance stroke-cap))))
    (= result (call vector-document-mix result (call vector-document-optional-join (. appearance stroke-join))))
    (return (call vector-document-mix result (call vector-document-optional-fill-rule (. appearance fill-rule))))
  )
  (fn-do _ mix-fill _
    (param hash U64)
    (param fill Fill)
    (return-if (call vector-document-mix hash 1) (if (== fill (. Fill none))))
    (return-if (call vector-document-mix hash 2) (if (== fill (. Fill inherit))))
    (return-if (call vector-document-mix hash 3) (if (== fill (. Fill stroke))))
    (let result (call vector-document-mix hash 4))
    (for (in layer (. fill layers))
      (= result (call mix-color result (. layer color)))
      (= result (call vector-document-mix result (if-expr (. layer visible) 1u64 2u64)))
    )
    (return result)
  )
  (fn-do _ mix-stroke _
    (param hash U64)
    (param stroke Stroke)
    (return-if (call vector-document-mix hash 5) (if (== stroke (. Stroke none))))
    (return-if (call vector-document-mix hash 6) (if (== stroke (. Stroke inherit))))
    (let result (call vector-document-mix hash 7))
    (for (in layer (. stroke layers))
      (= result (call mix-color result (. layer color)))
      (= result (call vector-document-mix result (if-expr (. layer visible) 1u64 2u64)))
      (= result (call (. document mix-number) result (?? (. layer width) -1)))
      (= result (call vector-document-mix result (call vector-document-optional-alignment (. layer alignment))))
      (= result (call vector-document-mix result (call vector-document-optional-join (. layer join))))
      (= result (call vector-document-mix result (call vector-document-optional-cap (. layer cap))))
    )
    (return result)
  )
  (fn-do _ mix-color _
    (param hash U64)
    (param color RGBA)
    (let result (call (. document mix-number) hash (. color red)))
    (= result (call (. document mix-number) result (. color green)))
    (= result (call (. document mix-number) result (. color blue)))
    (return (call (. document mix-number) result (. color alpha)))
  )
)

(fn-do _ element-key _
  (param id U64)
  (param content U64)
  (param chain-key U64)
  (param paint-key U64)
  (let result (call vector-document-mix vector-document-render-seed id))
  (= result (call vector-document-mix result content))
  (= result (call vector-document-mix result chain-key))
  (return (call vector-document-mix result paint-key))
)

(fn-expr _ clamped-opacity _
  (param value Ratio)
  (case? (not (call is-finite value))
    1%%
  )
  (case? (<= value 0%%)
    0%%
  )
  (case? (>= value 1%%)
    1%%
  )
  (default
    value
  )
)

(fn-do _ ink-bounds-of _
  (param paths (list Path))
  (param regions (list VectorDocumentRegionPaint))
  (param appearance VectorAppearance)
  (let found false)
  (let result (call Rect 0 0 0 0))
  (let reach (if-expr (!= (. appearance stroke) (. Stroke none)) (. appearance stroke-extent) 0))
  (for (in path paths)
    (if (. path count)
      (let bounds (call (. path bounding-box inflate) (+ (* reach 2) 1) (+ (* reach 2) 1)))
      (= result (if-expr (not found) bounds (+ result bounds)))
      (= found true)
    )
  )
  (for (in region regions)
    (let bounds (. region path bounding-box))
    (= result (if-expr (not found) bounds (+ result bounds)))
    (= found true)
  )
  (return result)
)
