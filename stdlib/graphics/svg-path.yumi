./point
./vector

━━━━━━━━━━━━━━━━━━━━
+ svg-path-ops [PathOp] ?! Error
    - data String

SVGPathReader(data).read()

━━━━━━━━━━━━━━━━━━━━
_ SVGPathReader

+ data String

_ chars Char[]
_ position Index = 0
_ ops [PathOp]
_ current = Point(0, 0)
_ start = Point(0, 0)
_ cubic-control Point?
_ quadratic-control Point?
_ needs-move = false

────────────────────
+ This
    - data

.. chars = data as Char[]

────────────────────
+ do read [PathOp] ?! Error

skip()
=? ops if position >= chars.length
?! fail("Path data must start with M", position)
    if chars[position] != 'M' && chars[position] != 'm'
while position < chars.length
    . command = chars[position]
    position += 1
    if command == 'Z' || command == 'z'
        close()
    else
        ?! fail("“$command” is not a path command", position - 1)
            if !svg-path-command(command)
        . count Size = 0
        while count == 0 || starts-number()
            step(command, count)
            count += 1
    skip()
= ops

────────────────────
_ do step ?! Error
    - command Char
    - count Size

. relative = command >= 'a' && command <= 'z'
. base = if relative then current else Point(0, 0)
if command == 'M' || command == 'm'
    . point = base + read-point()
    if count == 0
        move(point)
    else
        line(point)
else if command == 'L' || command == 'l'
    line(base + read-point())
else if command == 'H' || command == 'h'
    . x = read-number()
    line(Point(if relative then current.x + x else x, current.y))
else if command == 'V' || command == 'v'
    . y = read-number()
    line(Point(current.x, if relative then current.y + y else y))
else if command == 'C' || command == 'c'
    . first = base + read-point()
    . second = base + read-point()
    cubic(first, second, base + read-point())
else if command == 'S' || command == 's'
    . first = svg-path-reflected(current, cubic-control)
    . second = base + read-point()
    cubic(first, second, base + read-point())
else if command == 'Q' || command == 'q'
    . control = base + read-point()
    quadratic(control, base + read-point())
else if command == 'T' || command == 't'
    quadratic(svg-path-reflected(current, quadratic-control), base + read-point())
else
    . rx = read-number()
    . ry = read-number()
    . rotation = read-number()
    . large = read-flag()
    . sweep = read-flag()
    . end = base + read-point()
    resume()
    ops += A(rx, ry, rotation, large, sweep, end.x, end.y)
    current = end
    cubic-control = null
    quadratic-control = null

────────────────────
_ do move
    - point Point

ops += M(point.x, point.y)
current = point
start = point
needs-move = false
cubic-control = null
quadratic-control = null

────────────────────
_ do line
    - point Point

resume()
ops += L(point.x, point.y)
current = point
cubic-control = null
quadratic-control = null

────────────────────
_ do cubic
    - first Point
    - second Point
    - end Point

resume()
ops += C(first.x, first.y, second.x, second.y, end.x, end.y)
current = end
cubic-control = second
quadratic-control = null

────────────────────
_ do quadratic
    - control Point
    - end Point

resume()
ops += Q(control.x, control.y, end.x, end.y)
current = end
cubic-control = null
quadratic-control = control

────────────────────
_ do close

ops += Z()
current = start
needs-move = true
cubic-control = null
quadratic-control = null

────────────────────
_ do resume

=? if !needs-move
ops += M(start.x, start.y)
needs-move = false

────────────────────
_ do read-point Point ?! Error

. x = read-number()
. y = read-number()
= Point(x, y)

────────────────────
_ do read-number F64 ?! Error

skip()
. begin = position
if position < chars.length && (chars[position] == '-' || chars[position] == '+')
    position += 1
. whole = digits()
. fraction Size = 0
if position < chars.length && chars[position] == '.'
    position += 1
    fraction = digits()
?! fail("A number is missing", begin)
    if whole + fraction == 0
if position < chars.length && (chars[position] == 'e' || chars[position] == 'E')
    . mark = position
    position += 1
    if position < chars.length && (chars[position] == '-' || chars[position] == '+')
        position += 1
    if digits() == 0
        position = mark
= data[begin .. < position] as F64

────────────────────
_ do read-flag Bool ?! Error

skip()
?! fail("An arc flag must be 0 or 1", position)
    if position >= chars.length || (chars[position] != '0' && chars[position] != '1')
position += 1
= chars[position - 1] == '1'

────────────────────
_ do digits Size

. begin = position
while position < chars.length && svg-path-digit(chars[position])
    position += 1
= position - begin

────────────────────
_ do starts-number Bool

skip()
=? false if position >= chars.length
. c = chars[position]
= svg-path-digit(c) || c == '.' || c == '-' || c == '+'

────────────────────
_ do skip

while position < chars.length && (svg-path-space(chars[position]) || chars[position] == ',')
    position += 1

────────────────────
_ fail Error
    - problem String
    - index Index

Error("$problem at character ${index + 1} of the path data")

━━━━━━━━━━━━━━━━━━━━
_ svg-path-reflected Point
    - point Point
    - control Point?

|? control
    point + (point - control)
??
    point

━━━━━━━━━━━━━━━━━━━━
_ svg-path-command
    - c Char

cubic-or-straight || c == 'Q' || c == 'q' || c == 'T' || c == 't' || c == 'A' || c == 'a'

.. move-or-line = c == 'M' || c == 'm' || c == 'L' || c == 'l'
.. straight = move-or-line || c == 'H' || c == 'h' || c == 'V' || c == 'v'
.. cubic-or-straight = straight || c == 'C' || c == 'c' || c == 'S' || c == 's'

━━━━━━━━━━━━━━━━━━━━
_ svg-path-digit
    - c Char

c >= '0' && c <= '9'

━━━━━━━━━━━━━━━━━━━━
_ svg-path-space
    - c Char

c == ' ' || c == '\t' || c == '\r' || c == '\n'
