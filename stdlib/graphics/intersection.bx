(import ./curve)
(import ./curve-kernels)
(import ./path)
(import ./point)
(import ./primitives)
(import ./utils)
(import /math)
(import /stream/aggregate)
(blank)
(prop _ hull-epsilon _ (= 1e-9))
(prop _ clip-call-limit _ (= 4096))
(prop _ clip-recursion-limit _ (= 40))
(prop _ three-fourths _ (= (/ 3.0 4.0)))
(prop _ four-ninths _ (= (/ 4.0 9.0)))

(type + PathIntersection (is Tuple)
  (prop + path1 (? Path))
  (prop + path2 (? Path))
  (prop + intersections (list CurveIntersection))
  (prop + equivalent Bool)
)

(type + CurveIntersection (is Tuple)
  (prop + t1 PointOnCurve)
  (prop + t2 PointOnCurve)
  (prop + path1 (? Path))
  (prop + path2 (? Path))
  (fn-do + normalize _
    (let nt1 t1)
    (if path1
      (if (>= t1 (. path1 curve-count))
        (= nt1 0)
      )
    )
    (blank)
    (let nt2 t2)
    (if path2
      (if (>= t2 (. path2 curve-count))
        (= nt2 0)
      )
    )
    (blank)
    (return
      (call CurveIntersection
        (block
          (arg nt1)
          (arg nt2)
          (arg path1)
          (arg path2)
        )
      )
    )
  )
)

(type + IntersectionWorkspace
  (implements (of Usable Void))
  ; Caller-owned storage for repeated intersection queries. Returned lists and pooled subpaths are
  ; valid until this workspace is cleared, released, or used again. A workspace must not be shared
  ; by overlapping calls; use a distinct workspace for nested or concurrent queries.
  (prop + growth-count Size)
  (prop + clear-count Size)
  (prop + fallback-allocation-count Size)
  (blank)
  (prop _ in-use _ (= false))
  (prop _ intersection-index Size)
  (prop _ path-index Size)
  (prop _ intersection-lists (list (list CurveIntersection)))
  (prop _ paths (list Path))
  (prop _ subpaths1 (list PathSubpathSpan))
  (prop _ subpaths2 (list PathSubpathSpan))
  (prop _ empty-path _ (= (call Path)))
  (prop _ counter _ (= (call Counter)))
  (prop _ empty-intersections (list CurveIntersection))
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + retained-capacity Size :get
    (let capacity (+ (. intersection-lists capacity) (. paths capacity)))
    (+= capacity (+ (. subpaths1 capacity) (. subpaths2 capacity) (. empty-intersections capacity)))
    (for (in intersections intersection-lists)
      (+= capacity (. intersections capacity))
    )
    (for (in path paths)
      (+= capacity (+ (. path command-capacity) (. path coord-capacity)))
    )
    (return capacity)
  )
  (fn-expr + retained-bytes Size :get
    (* retained-capacity 8)
  )
  (fn-do + clear _
    (for (in intersections intersection-lists)
      (call clear-curve-intersection-list intersections)
    )
    (for (in path paths)
      (call (. path clear))
    )
    (call clear-subpath-span-list subpaths1 (. empty-path commands))
    (call clear-subpath-span-list subpaths2 (. empty-path commands))
    (= intersection-index 0)
    (= path-index 0)
    (= (. counter count) 0)
    (+= clear-count 1)
    (probe-count graphics.geometry.scratch.clears)
  )
  (fn-do + trim _
    (throw (call Panic "Cannot trim an intersection workspace while it is in use") (if in-use))
    (blank)
    (call clear)
    (for (in intersections intersection-lists)
      (call (. intersections trim))
    )
    (for (in path paths)
      (call (. path trim))
    )
    (call (. intersection-lists trim))
    (call (. paths trim))
    (call (. subpaths1 trim))
    (call (. subpaths2 trim))
    (call (. empty-intersections trim))
  )
  (fn-do + release _
    (throw (call Panic "Cannot release an intersection workspace while it is in use") (if in-use))
    (blank)
    (call clear)
    (for (in intersections intersection-lists)
      (call (. intersections release))
    )
    (for (in path paths)
      (call (. path release))
    )
    (call (. intersection-lists release))
    (call (. paths release))
    (call (. subpaths1 release))
    (call (. subpaths2 release))
    (call (. empty-intersections release))
  )
)

(fn-do + intersect-paths _
  (param path1 Path)
  (param path2 Path)
  ; Doesn't currently work!
  (param should-test-closer _ (= false))
  (param should-ignore-lines _ (= false))
  (blank)
  (let results (list PathIntersection))
  (let workspace (call IntersectionWorkspace))
  (return (call intersect-paths-reusing results workspace path1 path2 should-test-closer should-ignore-lines))
)

(fn-do + intersect-paths-reusing _
  (param results (list PathIntersection))
  (param workspace IntersectionWorkspace)
  (param path1 Path)
  (param path2 Path)
  ; Doesn't currently work!
  (param should-test-closer _ (= false))
  (param should-ignore-lines _ (= false))
  (blank)
  (throw (call Panic "Intersection workspace is already in use") (if (. workspace in-use)))
  (blank)
  (let capacity-before (. workspace retained-capacity))
  (= (. workspace in-use) true)
  (let completed false)
  (finally
    (if (not completed)
      (call clear-path-intersection-list results (. workspace empty-intersections))
      (call (. workspace clear))
    )
    (let capacity-after (. workspace retained-capacity))
    (if (> capacity-after capacity-before)
      (+= (. workspace growth-count) 1)
      (probe-count graphics.geometry.scratch.growth)
    )
    (probe-count graphics.geometry.scratch.retained-capacity capacity-after)
    (= (. workspace in-use) false)
  )
  (blank)
  (call clear-path-intersection-list results (. workspace empty-intersections))
  (call (. workspace clear))
  (call (. path1 append-subpath-spans) (. workspace subpaths1))
  (call (. path2 append-subpath-spans) (. workspace subpaths2))
  (blank)
  (probe-group + graphics.intersect.paths.total)
  (probe-count graphics.intersect.paths.calls)
  (blank)
  (for (in subpath1 (. workspace subpaths1))
    (let l1 (. subpath1 curve-count))
    (blank)
    (for (in subpath2 (. workspace subpaths2))
      (let l2 (. subpath2 curve-count))
      (blank)
      (let all-closed (or (not should-test-closer) (and (. subpath1 is-closed) (. subpath2 is-closed))))
      (let equal-count 0)
      (let intersections (call acquire-intersection-list workspace))
      (blank)
      (if (and all-closed (or (not should-ignore-lines) (and (> l1 1) (> l2 1))))
        (let pathref1 path1)
        (if (or (!= (. subpath1 command-start) 0) (!= (. subpath1 command-end) (. path1 count)))
          (= pathref1 (call (. subpath1 materialize) (call acquire-intersection-path workspace)))
        )
        (blank)
        (let pathref2 path2)
        (if (or (!= (. subpath2 command-start) 0) (!= (. subpath2 command-end) (. path2 count)))
          (= pathref2 (call (. subpath2 materialize) (call acquire-intersection-path workspace)))
        )
        (blank)
        (if (and (not should-test-closer) (== l1 1))
          (let line1 (call first-subpath-curve subpath1))
          (if (and (. line1 found) (call line-like-scalars (. line1 x1) (. line1 y1) (. line1 hox) (. line1 hoy) (. line1 hix) (. line1 hiy) (. line1 x2) (. line1 y2)))
            (probe-group + graphics.intersect.line-path)
            (call intersect-line-path-scalars
              (block
                (arg intersections)
                (arg pathref2)
                (arg (. line1 x1))
                (arg (. line1 y1))
                (arg (. line1 x2))
                (arg (. line1 y2))
                (arg 0)
                (arg pathref1)
                (:line-is-first true)
              )
            )
            (probe-group - graphics.intersect.line-path)
            (call append-line-path-intersection results intersections pathref1 pathref2)
            (continue)
          )
        )
        (blank)
        (if (and (not should-test-closer) (== l2 1))
          (let line2 (call first-subpath-curve subpath2))
          (if (and (. line2 found) (call line-like-scalars (. line2 x1) (. line2 y1) (. line2 hox) (. line2 hoy) (. line2 hix) (. line2 hiy) (. line2 x2) (. line2 y2)))
            (probe-group + graphics.intersect.line-path)
            (call intersect-line-path-scalars
              (block
                (arg intersections)
                (arg pathref1)
                (arg (. line2 x1))
                (arg (. line2 y1))
                (arg (. line2 x2))
                (arg (. line2 y2))
                (arg 0)
                (arg pathref2)
                (arg false)
              )
            )
            (probe-group - graphics.intersect.line-path)
            (call append-line-path-intersection results intersections pathref1 pathref2)
            (continue)
          )
        )
        (blank)
        (probe-group + graphics.intersect.curve-pairs)
        (let span1 (. subpath1 span))
        (let span2 (. subpath2 span))
        (let i Index)
        (for (in command1 (..< (. subpath1 command-start) (. subpath1 command-end)))
          (let curve1 (call span-curve-at span1 command1))
          (if (not (. curve1 found))
            (continue)
          )
          (blank)
          (let j Index)
          (for (in command2 (..< (. subpath2 command-start) (. subpath2 command-end)))
            (let curve2 (call span-curve-at span2 command2))
            (if (not (. curve2 found))
              (continue)
            )
            (blank)
            (probe-count graphics.intersect.curve-pairs-tested)
            (if (or (call curves-equal-scalars (. curve1 x1) (. curve1 y1) (. curve1 hox) (. curve1 hoy) (. curve1 hix) (. curve1 hiy) (. curve1 x2) (. curve1 y2) (. curve2 x1) (. curve2 y1) (. curve2 hox) (. curve2 hoy) (. curve2 hix) (. curve2 hiy) (. curve2 x2) (. curve2 y2)) (call curves-equal-reverse-scalars (. curve1 x1) (. curve1 y1) (. curve1 hox) (. curve1 hoy) (. curve1 hix) (. curve1 hiy) (. curve1 x2) (. curve1 y2) (. curve2 x1) (. curve2 y1) (. curve2 hox) (. curve2 hoy) (. curve2 hix) (. curve2 hiy) (. curve2 x2) (. curve2 y2)))
              (+= equal-count 1)
              (+= j 1)
              (continue)
            )
            (blank)
            (let is-line1
              (call line-like-scalars
                (block
                  (arg (. curve1 x1))
                  (arg (. curve1 y1))
                  (arg (. curve1 hox))
                  (arg (. curve1 hoy))
                  (arg (. curve1 hix))
                  (arg (. curve1 hiy))
                  (arg (. curve1 x2))
                  (arg (. curve1 y2))
                )
              )
            )
            (let is-line2
              (call line-like-scalars
                (block
                  (arg (. curve2 x1))
                  (arg (. curve2 y1))
                  (arg (. curve2 hox))
                  (arg (. curve2 hoy))
                  (arg (. curve2 hix))
                  (arg (. curve2 hiy))
                  (arg (. curve2 x2))
                  (arg (. curve2 y2))
                )
              )
            )
            (lazy boxes-overlap
              (call control-boxes-overlap-scalars
                (block
                  (arg (. curve1 x1))
                  (arg (. curve1 y1))
                  (arg (. curve1 hox))
                  (arg (. curve1 hoy))
                  (arg (. curve1 hix))
                  (arg (. curve1 hiy))
                  (arg (. curve1 x2))
                  (arg (. curve1 y2))
                  (arg (. curve2 x1))
                  (arg (. curve2 y1))
                  (arg (. curve2 hox))
                  (arg (. curve2 hoy))
                  (arg (. curve2 hix))
                  (arg (. curve2 hiy))
                  (arg (. curve2 x2))
                  (arg (. curve2 y2))
                )
              )
            )
            (blank)
            (if (and is-line1 is-line2)
              (probe-count graphics.intersect.line-line-branches)
              (probe-group + graphics.intersect.line-line)
              (call intersect-line-line-scalars
                (block
                  (arg intersections)
                  (arg (. curve1 x1))
                  (arg (. curve1 y1))
                  (arg (. curve1 x2))
                  (arg (. curve1 y2))
                  (arg (. curve2 x1))
                  (arg (. curve2 y1))
                  (arg (. curve2 x2))
                  (arg (. curve2 y2))
                  (arg i)
                  (arg j)
                  (arg pathref1)
                  (arg pathref2)
                )
              )
              (probe-group - graphics.intersect.line-line)
              (else-if is-line1
                (probe-count graphics.intersect.curve-line-branches)
                (probe-group + graphics.intersect.curve-line)
                (call intersect-line-curve-scalars
                  (block
                    (arg intersections)
                    (arg (. curve1 x1))
                    (arg (. curve1 y1))
                    (arg (. curve1 x2))
                    (arg (. curve1 y2))
                    (arg (. curve2 x1))
                    (arg (. curve2 y1))
                    (arg (. curve2 hox))
                    (arg (. curve2 hoy))
                    (arg (. curve2 hix))
                    (arg (. curve2 hiy))
                    (arg (. curve2 x2))
                    (arg (. curve2 y2))
                    (arg i)
                    (arg j)
                    (arg pathref1)
                    (arg pathref2)
                  )
                )
                (probe-group - graphics.intersect.curve-line)
              )
              (else-if is-line2
                (probe-count graphics.intersect.curve-line-branches)
                (probe-group + graphics.intersect.curve-line)
                (call intersect-curve-line-scalars
                  (block
                    (arg intersections)
                    (arg (. curve1 x1))
                    (arg (. curve1 y1))
                    (arg (. curve1 hox))
                    (arg (. curve1 hoy))
                    (arg (. curve1 hix))
                    (arg (. curve1 hiy))
                    (arg (. curve1 x2))
                    (arg (. curve1 y2))
                    (arg (. curve2 x1))
                    (arg (. curve2 y1))
                    (arg (. curve2 x2))
                    (arg (. curve2 y2))
                    (arg i)
                    (arg j)
                    (arg pathref1)
                    (arg pathref2)
                  )
                )
                (probe-group - graphics.intersect.curve-line)
              )
              (else-if boxes-overlap
                (let c1-anchor1 (call Point (. curve1 x1) (. curve1 y1)))
                (let c1-handle-out (call Point (. curve1 hox) (. curve1 hoy)))
                (let c1-handle-in (call Point (. curve1 hix) (. curve1 hiy)))
                (let c1-anchor2 (call Point (. curve1 x2) (. curve1 y2)))
                (let c1
                  (call Curve
                    (block
                      (arg c1-anchor1)
                      (arg c1-handle-out)
                      (arg c1-handle-in)
                      (arg c1-anchor2)
                      (arg (. curve1 type))
                    )
                  )
                )
                (blank)
                (let c2-anchor1 (call Point (. curve2 x1) (. curve2 y1)))
                (let c2-handle-out (call Point (. curve2 hox) (. curve2 hoy)))
                (let c2-handle-in (call Point (. curve2 hix) (. curve2 hiy)))
                (let c2-anchor2 (call Point (. curve2 x2) (. curve2 y2)))
                (let c2
                  (call Curve
                    (block
                      (arg c2-anchor1)
                      (arg c2-handle-out)
                      (arg c2-handle-in)
                      (arg c2-anchor2)
                      (arg (. curve2 type))
                    )
                  )
                )
                (probe-count graphics.intersect.curve-curve-branches)
                (probe-group + graphics.intersect.curve-curve)
                (let hit-start (. intersections length))
                (call refine-curve-curve
                  (block
                    (arg intersections)
                    (arg (call reset-intersection-counter workspace))
                    (arg c1)
                    (arg c2)
                    (arg i)
                    (arg j)
                    (arg pathref1)
                    (arg pathref2)
                  )
                )
                (call polish-curve-intersections intersections hit-start c1 c2 i j)
                (probe-group - graphics.intersect.curve-curve)
              )
            )
            (+= j 1)
          )
          (+= i 1)
        )
        (probe-group - graphics.intersect.curve-pairs)
        (call append-path-intersection
          (block
            (arg results)
            (arg intersections)
            (arg pathref1)
            (arg pathref2)
            (arg (and (== l1 l2) (== equal-count l1)))
          )
        )
      )
    )
  )
  (blank)
  (probe-group - graphics.intersect.paths.total)
  (= completed true)
  (return results)
)

(fn-do + intersect-path-line _
  (param path1 Path)
  (param start Point)
  (param end Point)
  (probe-count graphics.intersect.path-line.calls)
  (let intersections (list CurveIntersection))
  (blank)
  (call intersect-line-path-scalars intersections path1 (. start x) (. start y) (. end x) (. end y) 0 null false)
  (blank)
  (return (call post-process-line-path-intersections intersections))
)

(fn-expr + intersect-line-path _
  (param out (list CurveIntersection))
  (param path Path)
  (param line Curve)
  (param line-index _)
  (param line-path (? Path))
  (param line-is-first _ (= false))
  (call intersect-line-path-scalars
    (block
      (arg out)
      (arg path)
      (arg (. line anchor1 x))
      (arg (. line anchor1 y))
      (arg (. line anchor2 x))
      (arg (. line anchor2 y))
      (arg line-index)
      (arg line-path)
      (arg line-is-first)
    )
  )
)

(fn-do + intersect-line-path-scalars _
  (param out (list CurveIntersection))
  (param path Path)
  (param lx1 Coord)
  (param ly1 Coord)
  (param lx2 Coord)
  (param ly2 Coord)
  (param line-index _)
  (param line-path (? Path))
  (param line-is-first _ (= false))
  (probe-count graphics.intersect.line-path.calls)
  (probe-group + graphics.intersect.line-path.prepare)
  (let linelength (call line-length-scalars lx1 ly1 lx2 ly2))
  (return-if (if (<= linelength tolerance)))
  (blank)
  (let lux (/ (- lx2 lx1) linelength))
  (let luy (/ (- ly2 ly1) linelength))
  (probe-group - graphics.intersect.line-path.prepare)
  (blank)
  (probe-group + graphics.intersect.line-path.bounds)
  (if (call path-line-bounds-rejected path lx1 ly1 linelength lux luy)
    (probe-count graphics.intersect.line-path.bounds-rejected)
    (probe-group - graphics.intersect.line-path.bounds)
    (return)
  )
  (probe-group - graphics.intersect.line-path.bounds)
  (blank)
  (probe-group + graphics.intersect.curve-pairs)
  (let span (. path commands))
  (let curve-index Index)
  (for (in command-index (..< 0 (. span command-count)))
    (let verb PathVerb ([] (. span verbs) command-index))
    (if (== verb .path-verb-move)
      (continue)
    )
    (blank)
    (let curve (call span-curve-at span command-index))
    (if (not (. curve found))
      (continue)
    )
    (blank)
    (probe-count graphics.intersect.curve-pairs-tested)
    (if (or (call curves-equal-scalars (. curve x1) (. curve y1) (. curve hox) (. curve hoy) (. curve hix) (. curve hiy) (. curve x2) (. curve y2) lx1 ly1 lx1 ly1 lx2 ly2 lx2 ly2) (call curves-equal-reverse-scalars (. curve x1) (. curve y1) (. curve hox) (. curve hoy) (. curve hix) (. curve hiy) (. curve x2) (. curve y2) lx1 ly1 lx1 ly1 lx2 ly2 lx2 ly2))
      (+= curve-index 1)
      (continue)
    )
    (blank)
    (if (call line-like-scalars (. curve x1) (. curve y1) (. curve hox) (. curve hoy) (. curve hix) (. curve hiy) (. curve x2) (. curve y2))
      (probe-count graphics.intersect.line-line-branches)
      (probe-group + graphics.intersect.line-line)
      (if line-is-first
        (call intersect-line-line-scalars
          (block
            (arg out)
            (arg lx1)
            (arg ly1)
            (arg lx2)
            (arg ly2)
            (arg (. curve x1))
            (arg (. curve y1))
            (arg (. curve x2))
            (arg (. curve y2))
            (arg line-index)
            (arg curve-index)
            (arg line-path)
            (arg path)
          )
        )
        (else
          (call intersect-line-line-scalars
            (block
              (arg out)
              (arg (. curve x1))
              (arg (. curve y1))
              (arg (. curve x2))
              (arg (. curve y2))
              (arg lx1)
              (arg ly1)
              (arg lx2)
              (arg ly2)
              (arg curve-index)
              (arg line-index)
              (arg path)
              (arg line-path)
            )
          )
        )
      )
      (probe-group - graphics.intersect.line-line)
      (else
        (probe-count graphics.intersect.curve-line-branches)
        (probe-group + graphics.intersect.curve-line)
        (let hits
          (call cubic-line-intersections-prepared-scalars
            (block
              (arg (. curve x1))
              (arg (. curve y1))
              (arg (. curve hox))
              (arg (. curve hoy))
              (arg (. curve hix))
              (arg (. curve hiy))
              (arg (. curve x2))
              (arg (. curve y2))
              (arg lx1)
              (arg ly1)
              (arg linelength)
              (arg lux)
              (arg luy)
              (arg tolerance)
            )
          )
        )
        (if line-is-first
          (call append-cubic-line-hits-reverse out hits line-index curve-index line-path path)
          (else
            (call append-cubic-line-hits out hits curve-index line-index path line-path)
          )
        )
        (probe-group - graphics.intersect.curve-line)
      )
    )
    (blank)
    (+= curve-index 1)
  )
  (probe-group - graphics.intersect.curve-pairs)
)

(fn-do + intersect-curves _
  (param out (list CurveIntersection))
  (param c1 Curve)
  (param c2 Curve)
  (param limit _ (= 0))
  (param i1 Index (= 0))
  (param i2 Index (= 0))
  (param p1 (? Path) (= null))
  (param p2 (? Path) (= null))
  (let start (. out length))
  (call refine-curve-curve out (call Counter) c1 c2 i1 i2 p1 p2)
  (call polish-curve-intersections out start c1 c2 i1 i2)
)

(fn-do + intersect-curves-reusing _
  (param out (list CurveIntersection))
  (param workspace IntersectionWorkspace)
  (param c1 Curve)
  (param c2 Curve)
  (param limit _ (= 0))
  (param i1 Index (= 0))
  (param i2 Index (= 0))
  (param p1 (? Path) (= null))
  (param p2 (? Path) (= null))
  (throw (call Panic "Intersection workspace is already in use") (if (. workspace in-use)))
  (blank)
  (let capacity-before (. workspace retained-capacity))
  (= (. workspace in-use) true)
  (let completed false)
  (finally
    (if (not completed)
      (call clear-curve-intersection-list out)
      (call (. workspace clear))
    )
    (let capacity-after (. workspace retained-capacity))
    (if (> capacity-after capacity-before)
      (+= (. workspace growth-count) 1)
      (probe-count graphics.geometry.scratch.growth)
    )
    (probe-count graphics.geometry.scratch.retained-capacity capacity-after)
    (= (. workspace in-use) false)
  )
  (blank)
  (call clear-curve-intersection-list out)
  (= (. workspace counter count) 0)
  (call refine-curve-curve out (. workspace counter) c1 c2 i1 i2 p1 p2)
  (call polish-curve-intersections out 0 c1 c2 i1 i2)
  (= completed true)
)

(fn-expr + curves-equal-scalars _
  (param ax1 Coord)
  (param ay1 Coord)
  (param ahox Coord)
  (param ahoy Coord)
  (param ahix Coord)
  (param ahiy Coord)
  (param ax2 Coord)
  (param ay2 Coord)
  (param bx1 Coord)
  (param by1 Coord)
  (param bhox Coord)
  (param bhoy Coord)
  (param bhix Coord)
  (param bhiy Coord)
  (param bx2 Coord)
  (param by2 Coord)
  (and same-head (== ahix bhix) (== ahiy bhiy) (== ax2 bx2) (== ay2 by2))
  (where
    (lazy same-head (and (== ax1 bx1) (== ay1 by1) (== ahox bhox) (== ahoy bhoy)))
  )
)

(fn-expr + curves-equal-reverse-scalars _
  (param ax1 Coord)
  (param ay1 Coord)
  (param ahox Coord)
  (param ahoy Coord)
  (param ahix Coord)
  (param ahiy Coord)
  (param ax2 Coord)
  (param ay2 Coord)
  (param bx1 Coord)
  (param by1 Coord)
  (param bhox Coord)
  (param bhoy Coord)
  (param bhix Coord)
  (param bhiy Coord)
  (param bx2 Coord)
  (param by2 Coord)
  (and reversed-head (== ahix bhox) (== ahiy bhoy) (== ax2 bx1) (== ay2 by1))
  (where
    (lazy reversed-head (and (== ax1 bx2) (== ay1 by2) (== ahox bhix) (== ahoy bhiy)))
  )
)

(fn-do + intersect-line-line-scalars _
  (param out (list CurveIntersection))
  (param ax1 Coord)
  (param ay1 Coord)
  (param ax2 Coord)
  (param ay2 Coord)
  (param bx1 Coord)
  (param by1 Coord)
  (param bx2 Coord)
  (param by2 Coord)
  (param i1 Index)
  (param i2 Index)
  (param p1 (? Path))
  (param p2 (? Path))
  (let intr (call line-line-intersection-scalars ax1 ay1 ax2 ay2 bx1 by1 bx2 by2))
  (if (. intr hit)
    (+= out (tuple (+ i1 (. intr t1)) (+ i2 (. intr t2)) p1 p2))
    (probe-count graphics.intersect.line-line.emitted-intersections)
  )
)

(fn-do + intersect-curve-line-scalars _
  (param out (list CurveIntersection))
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param lx1 Coord)
  (param ly1 Coord)
  (param lx2 Coord)
  (param ly2 Coord)
  (param curve-index _)
  (param line-index _)
  (param curve-path (? Path))
  (param line-path (? Path))
  (let linelength (call line-length-scalars lx1 ly1 lx2 ly2))
  (return-if (if (<= linelength tolerance)))
  (blank)
  (let lux (/ (- lx2 lx1) linelength))
  (let luy (/ (- ly2 ly1) linelength))
  (let hits
    (call cubic-line-intersections-prepared-scalars
      (block
        (arg x1)
        (arg y1)
        (arg hox)
        (arg hoy)
        (arg hix)
        (arg hiy)
        (arg x2)
        (arg y2)
        (arg lx1)
        (arg ly1)
        (arg linelength)
        (arg lux)
        (arg luy)
        (arg tolerance)
      )
    )
  )
  (call append-cubic-line-hits out hits curve-index line-index curve-path line-path)
)

(fn-do + intersect-line-curve-scalars _
  (param out (list CurveIntersection))
  (param lx1 Coord)
  (param ly1 Coord)
  (param lx2 Coord)
  (param ly2 Coord)
  (param x1 Coord)
  (param y1 Coord)
  (param hox Coord)
  (param hoy Coord)
  (param hix Coord)
  (param hiy Coord)
  (param x2 Coord)
  (param y2 Coord)
  (param line-index _)
  (param curve-index _)
  (param line-path (? Path))
  (param curve-path (? Path))
  (let linelength (call line-length-scalars lx1 ly1 lx2 ly2))
  (return-if (if (<= linelength tolerance)))
  (blank)
  (let lux (/ (- lx2 lx1) linelength))
  (let luy (/ (- ly2 ly1) linelength))
  (let hits
    (call cubic-line-intersections-prepared-scalars
      (block
        (arg x1)
        (arg y1)
        (arg hox)
        (arg hoy)
        (arg hix)
        (arg hiy)
        (arg x2)
        (arg y2)
        (arg lx1)
        (arg ly1)
        (arg linelength)
        (arg lux)
        (arg luy)
        (arg tolerance)
      )
    )
  )
  (call append-cubic-line-hits-reverse out hits line-index curve-index line-path curve-path)
)

(fn-do + intersect-line-line _
  (param out (list CurveIntersection))
  (param c1 Curve)
  (param c2 Curve)
  (param i1 Index)
  (param i2 Index)
  (param p1 (? Path))
  (param p2 (? Path))
  (let intr
    (call line-line-intersection-scalars
      (block
        (arg (. c1 anchor1 x))
        (arg (. c1 anchor1 y))
        (arg (. c1 anchor2 x))
        (arg (. c1 anchor2 y))
        (arg (. c2 anchor1 x))
        (arg (. c2 anchor1 y))
        (arg (. c2 anchor2 x))
        (arg (. c2 anchor2 y))
      )
    )
  )
  (if (. intr hit)
    (+= out (tuple (+ i1 (. intr t1)) (+ i2 (. intr t2)) p1 p2))
    (probe-count graphics.intersect.line-line.emitted-intersections)
  )
)

(fn-expr + intersect-curve-line _
  (param out (list CurveIntersection))
  (param curve Curve)
  (param line Curve)
  (param limit _ (= 0))
  (call intersect-curve-line out curve line 0 0 null null false limit)
)

(fn-do + intersect-curve-line _
  (param out (list CurveIntersection))
  (param curve Curve)
  (param line Curve)
  (param i1 Index)
  (param i2 Index)
  (param p1 (? Path))
  (param p2 (? Path))
  (param is-reverse _ (= false))
  (param limit _ (= 0))
  (let line-length (call (. line anchor1 distance) (. line anchor2)))
  (return-if (if (<= line-length tolerance)))
  (blank)
  (let line-ux (/ (- (. line anchor2 x) (. line anchor1 x)) line-length))
  (let line-uy (/ (- (. line anchor2 y) (. line anchor1 y)) line-length))
  (blank)
  (if is-reverse
    (call intersect-curve-line-prepared out curve line line-length line-ux line-uy i2 i1 p2 p1)
    (else
      (call intersect-curve-line-prepared out curve line line-length line-ux line-uy i1 i2 p1 p2)
    )
  )
)

(fn-do + append-cubic-line-hits _
  (param out (list CurveIntersection))
  (param hits CubicLineIntersectionsScalars)
  (param curve-index _)
  (param line-index _)
  (param curve-path (? Path))
  (param line-path (? Path))
  (if (> (. hits count) 0)
    (+= out (tuple (+ curve-index (. hits curve-first)) (+ line-index (. hits line-first)) curve-path line-path))
    (probe-count graphics.intersect.curve-line.emitted-intersections)
  )
  (if (> (. hits count) 1)
    (+= out (tuple (+ curve-index (. hits curve-second)) (+ line-index (. hits line-second)) curve-path line-path))
    (probe-count graphics.intersect.curve-line.emitted-intersections)
  )
  (if (> (. hits count) 2)
    (+= out (tuple (+ curve-index (. hits curve-third)) (+ line-index (. hits line-third)) curve-path line-path))
    (probe-count graphics.intersect.curve-line.emitted-intersections)
  )
)

(fn-do + append-cubic-line-hits-reverse _
  (param out (list CurveIntersection))
  (param hits CubicLineIntersectionsScalars)
  (param line-index _)
  (param curve-index _)
  (param line-path (? Path))
  (param curve-path (? Path))
  (if (> (. hits count) 0)
    (+= out (tuple (+ line-index (. hits line-first)) (+ curve-index (. hits curve-first)) line-path curve-path))
    (probe-count graphics.intersect.curve-line.emitted-intersections)
  )
  (if (> (. hits count) 1)
    (+= out (tuple (+ line-index (. hits line-second)) (+ curve-index (. hits curve-second)) line-path curve-path))
    (probe-count graphics.intersect.curve-line.emitted-intersections)
  )
  (if (> (. hits count) 2)
    (+= out (tuple (+ line-index (. hits line-third)) (+ curve-index (. hits curve-third)) line-path curve-path))
    (probe-count graphics.intersect.curve-line.emitted-intersections)
  )
)

(fn-expr + intersect-rays _
  (param out (list CurveIntersection))
  (param start1 Point)
  (param end1 Point)
  (param start2 Point)
  (param end2 Point)
  (call intersect-lines out start1 end1 start2 end2 true)
)

(type _ Counter
  (prop + count _ (= 0))
)

(type _ HullClips (is Tuple)
  (prop + t-min (? PointOnCurve))
  (prop + t-max (? PointOnCurve))
)

(type _ FixedHullChain (is Tuple)
  (prop + count Size)
  (prop + a-x Coord)
  (prop + a-y Coord)
  (prop + b-x Coord)
  (prop + b-y Coord)
  (prop + c-x Coord)
  (prop + c-y Coord)
  (prop + d-x Coord)
  (prop + d-y Coord)
)

(fn-expr _ control-boxes-overlap-scalars _
  (param ax1 Coord)
  (param ay1 Coord)
  (param ahox Coord)
  (param ahoy Coord)
  (param ahix Coord)
  (param ahiy Coord)
  (param ax2 Coord)
  (param ay2 Coord)
  (param bx1 Coord)
  (param by1 Coord)
  (param bhox Coord)
  (param bhoy Coord)
  (param bhix Coord)
  (param bhiy Coord)
  (param bx2 Coord)
  (param by2 Coord)
  (case? (not (>= (+ (call max (call max ax1 ahox) (call max ahix ax2)) tolerance) (call min (call min bx1 bhox) (call min bhix bx2))))
    false
  )
  (case? (not (<= (- (call min (call min ax1 ahox) (call min ahix ax2)) tolerance) (call max (call max bx1 bhox) (call max bhix bx2))))
    false
  )
  (case? (not (>= (+ (call max (call max ay1 ahoy) (call max ahiy ay2)) tolerance) (call min (call min by1 bhoy) (call min bhiy by2))))
    false
  )
  (default
    (<= (- (call min (call min ay1 ahoy) (call min ahiy ay2)) tolerance) (call max (call max by1 bhoy) (call max bhiy by2)))
  )
)

(fn-do _ post-process-intersections _
  (param intersections (list CurveIntersection))
  (if (not intersections)
    (return intersections)
  )
  (blank)
  (probe-group + graphics.intersect.post.normalize)
  (for (in index (..< 0 (. intersections length)))
    (= ([] intersections index) (call (. ([] intersections index) normalize)))
  )
  (probe-group - graphics.intersect.post.normalize)
  (probe-group + graphics.intersect.post.distinct)
  (let write Index)
  (for (in read (..< 0 (. intersections length)))
    (let intr ([] intersections read))
    (let duplicate false)
    (for (in seen (..< 0 write))
      (let previous ([] intersections seen))
      (if (and (== (. previous t1) (. intr t1)) (== (. previous t2) (. intr t2)))
        (= duplicate true)
        (break)
      )
    )
    (if (not duplicate)
      (= ([] intersections write) intr)
      (+= write 1)
    )
  )
  (if (< write (. intersections length))
    (-= ([] intersections (... write)))
  )
  (probe-group - graphics.intersect.post.distinct)
  (probe-group + graphics.intersect.post.sort)
  (call sort-curve-intersections intersections)
  (probe-group - graphics.intersect.post.sort)
  (return intersections)
)

(fn-do _ append-path-intersection _
  (param results (list PathIntersection))
  (param intersections (list CurveIntersection))
  (param subpath1 Path)
  (param subpath2 Path)
  (param equivalent Bool)
  (= intersections (call post-process-intersections intersections))
  (if intersections
    (probe-count graphics.intersect.intersection-points (. intersections length))
    (+= results (call PathIntersection subpath1 subpath2 intersections equivalent))
  )
)

(fn-do _ post-process-line-path-intersections _
  (param intersections (list CurveIntersection))
  (if (not intersections)
    (return intersections)
  )
  (blank)
  (probe-group + graphics.intersect.post.normalize)
  (for (in index (..< 0 (. intersections length)))
    (= ([] intersections index) (call (. ([] intersections index) normalize)))
  )
  (probe-group - graphics.intersect.post.normalize)
  (probe-group + graphics.intersect.post.sort)
  (call sort-curve-intersections intersections)
  (probe-group - graphics.intersect.post.sort)
  (blank)
  (probe-group + graphics.intersect.post.distinct)
  (let has-last false)
  (let last-t1 PointOnCurve)
  (let last-t2 PointOnCurve)
  (let write Index)
  (blank)
  (for (in intr intersections)
    (if (and has-last (< (call abs (- (. intr t1) last-t1)) tolerance) (< (call abs (- (. intr t2) last-t2)) tolerance))
      (probe-count graphics.intersect.post.numeric-duplicates)
      (continue)
    )
    (blank)
    (= ([] intersections write) intr)
    (+= write 1)
    (= last-t1 (. intr t1))
    (= last-t2 (. intr t2))
    (= has-last true)
  )
  (blank)
  (if (< write (. intersections length))
    (-= ([] intersections (... write)))
  )
  (probe-group - graphics.intersect.post.distinct)
  (return intersections)
)

(fn-do _ sort-curve-intersections _
  (param intersections (list CurveIntersection))
  (for (in index (..< 1 (. intersections length)))
    (let item ([] intersections index))
    (let insert index)
    (while (and (> insert 0) (< (. item t1) (. ([] intersections (- insert 1)) t1)))
      (= ([] intersections insert) ([] intersections (- insert 1)))
      (-= insert 1)
    )
    (= ([] intersections insert) item)
  )
)

(fn-do _ clear-curve-intersection-list _
  (param intersections (list CurveIntersection))
  (for (in index (..< 0 (. intersections length)))
    (= ([] intersections index) (call CurveIntersection 0 0 null null))
  )
  (call (. intersections clear))
)

(fn-do _ clear-path-intersection-list _
  (param results (list PathIntersection))
  (param empty (list CurveIntersection))
  (for (in index (..< 0 (. results length)))
    (= ([] results index) (call PathIntersection null null empty false))
  )
  (call (. results clear))
)

(fn-do _ clear-subpath-span-list _
  (param subpaths (list PathSubpathSpan))
  (param empty PathCommandSpan)
  (for (in index (..< 0 (. subpaths length)))
    (= ([] subpaths index) (call PathSubpathSpan empty 0 0 0 false))
  )
  (call (. subpaths clear))
)

(fn-do _ acquire-intersection-list _
  (param workspace IntersectionWorkspace)
  (if (== (. workspace intersection-index) (. workspace intersection-lists length))
    (+= (. workspace intersection-lists) (call (of List CurveIntersection)))
  )
  (let intersections ([] (. workspace intersection-lists) (. workspace intersection-index)))
  (+= (. workspace intersection-index) 1)
  (call clear-curve-intersection-list intersections)
  (return intersections)
)

(fn-do _ acquire-intersection-path _
  (param workspace IntersectionWorkspace)
  (if (== (. workspace path-index) (. workspace paths length))
    (+= (. workspace paths) (call Path))
  )
  (let path ([] (. workspace paths) (. workspace path-index)))
  (+= (. workspace path-index) 1)
  (call (. path clear))
  (return path)
)

(fn-do _ reset-intersection-counter _
  (param workspace IntersectionWorkspace)
  (= (. workspace counter count) 0)
  (return (. workspace counter))
)

(fn-do _ append-line-path-intersection _
  (param results (list PathIntersection))
  (param intersections (list CurveIntersection))
  (param subpath1 Path)
  (param subpath2 Path)
  (= intersections (call post-process-line-path-intersections intersections))
  (if intersections
    (probe-count graphics.intersect.intersection-points (. intersections length))
    (+= results (call PathIntersection subpath1 subpath2 intersections false))
  )
)

(fn-do _ first-subpath-curve _
  (param subpath PathSubpathSpan)
  (for (in command-index (..< (. subpath command-start) (. subpath command-end)))
    (let curve (call span-curve-at (. subpath span) command-index))
    (if (. curve found)
      (return curve)
    )
  )
  (blank)
  (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0))
)

(fn-do _ span-curve-at (tuple (: found Bool) (: type SegmentType) (: x1 Coord) (: y1 Coord) (: hox Coord) (: hoy Coord) (: hix Coord) (: hiy Coord) (: x2 Coord) (: y2 Coord))
  (param span PathCommandSpan)
  (param command-index Index)
  (if (>= command-index (. span command-count))
    (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0))
  )
  (blank)
  (let verb PathVerb ([] (. span verbs) command-index))
  (if (== verb .path-verb-move)
    (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0))
  )
  (blank)
  (let prev-x Coord)
  (let prev-y Coord)
  (let has-prev false)
  (if (> command-index 0)
    (let prev-index (- command-index 1))
    (let prev-verb PathVerb ([] (. span verbs) prev-index))
    (let prev-start Index ([] (. span coord-offsets) prev-index))
    (if (or (== prev-verb .path-verb-move) (== prev-verb .path-verb-line))
      (= prev-x ([] (. span coords) prev-start))
      (= prev-y ([] (. span coords) (+ prev-start 1)))
      (= has-prev true)
      (else-if (== prev-verb .path-verb-cubic)
        (= prev-x ([] (. span coords) (+ prev-start 4)))
        (= prev-y ([] (. span coords) (+ prev-start 5)))
        (= has-prev true)
      )
      (else-if (== prev-verb .path-verb-close)
        (let close (call span-close-start span prev-index))
        (if (. close found)
          (= prev-x (. close x))
          (= prev-y (. close y))
          (= has-prev true)
        )
      )
    )
  )
  (blank)
  (if (not has-prev)
    (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0))
  )
  (blank)
  (let start Index ([] (. span coord-offsets) command-index))
  (if (== verb .path-verb-line)
    (let end-x Coord ([] (. span coords) start))
    (let end-y Coord ([] (. span coords) (+ start 1)))
    (return (tuple true .segment-type-line prev-x prev-y prev-x prev-y end-x end-y end-x end-y))
    (else-if (== verb .path-verb-cubic)
      (let hox Coord ([] (. span coords) start))
      (let hoy Coord ([] (. span coords) (+ start 1)))
      (let hix Coord ([] (. span coords) (+ start 2)))
      (let hiy Coord ([] (. span coords) (+ start 3)))
      (let end-x Coord ([] (. span coords) (+ start 4)))
      (let end-y Coord ([] (. span coords) (+ start 5)))
      (return (tuple true .segment-type-cubic prev-x prev-y hox hoy hix hiy end-x end-y))
    )
    (else-if (== verb .path-verb-close)
      (let close (call span-close-start span command-index))
      (if (not (. close found))
        (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0))
      )
      (if (and (== prev-x (. close x)) (== prev-y (. close y)))
        (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0))
      )
      (return (tuple true .segment-type-line prev-x prev-y prev-x prev-y (. close x) (. close y) (. close x) (. close y)))
    )
  )
  (blank)
  (return (tuple false .segment-type-line 0 0 0 0 0 0 0 0))
)

(fn-do _ span-close-start (tuple (: found Bool) (: x Coord) (: y Coord))
  (param span PathCommandSpan)
  (param command-index Index)
  (let seek command-index)
  (while (> seek 0)
    (-= seek 1)
    (if (== ([] (. span verbs) seek) .path-verb-move)
      (let start Index ([] (. span coord-offsets) seek))
      (return (tuple true ([] (. span coords) start) ([] (. span coords) (+ start 1))))
    )
  )
  (blank)
  (return (tuple false 0 0))
)

(fn-expr _ path-line-bounds-rejected _
  (param path Path)
  (param lx1 Coord)
  (param ly1 Coord)
  (param linelength Length)
  (param lux _)
  (param luy _)
  (case? (not (. path count))
    true
  )
  (case? (or (> min-side tolerance) (< max-side (- tolerance)))
    true
  )
  (default
    (or (< max-proj (- tolerance)) (> min-proj (+ linelength tolerance)))
  )
  (where
    (lazy bounds (call (. path get-control-projection-bounds) lux luy))
    (lazy anchor-side (- (* lx1 luy) (* ly1 lux)))
    (lazy anchor-proj (+ (* lx1 lux) (* ly1 luy)))
    (lazy min-side (- (. bounds min-side) anchor-side))
    (lazy max-side (- (. bounds max-side) anchor-side))
    (lazy min-proj (- (. bounds min-proj) anchor-proj))
    (lazy max-proj (- (. bounds max-proj) anchor-proj))
  )
)

(fn-expr _ has-seen-root _
  (param roots (list PointOnCurve))
  (param root PointOnCurve)
  (call some roots (:where (< (call abs (- each root)) tolerance)))
)

(fn-do _ intersect-curve-line-prepared _
  (param out (list CurveIntersection))
  (param curve Curve)
  (param line Curve)
  (param line-length Length)
  (param line-ux _)
  (param line-uy _)
  (param curve-index _)
  (param line-index _)
  (param curve-path (? Path))
  (param line-path (? Path))
  (probe-group + graphics.intersect.curve-line.total)
  (probe-group + graphics.intersect.curve-line.solve-cubic)
  (let hits
    (call cubic-line-intersections-prepared-scalars
      (block
        (arg (. curve anchor1 x))
        (arg (. curve anchor1 y))
        (arg (. curve handle-out x))
        (arg (. curve handle-out y))
        (arg (. curve handle-in x))
        (arg (. curve handle-in y))
        (arg (. curve anchor2 x))
        (arg (. curve anchor2 y))
        (arg (. line anchor1 x))
        (arg (. line anchor1 y))
        (arg line-length)
        (arg line-ux)
        (arg line-uy)
        (arg tolerance)
      )
    )
  )
  (call append-cubic-line-hits out hits curve-index line-index curve-path line-path)
  (probe-group - graphics.intersect.curve-line.solve-cubic)
  (probe-group - graphics.intersect.curve-line.total)
)

(fn-do _ refine-curve-curve _
  (param out (list CurveIntersection))
  (param counter Counter)
  (param c1 Curve)
  (param c2 Curve)
  (param i1 Index)
  (param i2 Index)
  (param p1 (? Path))
  (param p2 (? Path))
  (param t-min PointOnCurve (= 0))
  (param t-max PointOnCurve (= 1))
  (param u-min PointOnCurve (= 0))
  (param u-max PointOnCurve (= 1))
  (param is-reverse Bool (= false))
  (param recursion Int (= 0))
  (+= (. counter count) 1)
  (return-if (if (or (>= (. counter count) clip-call-limit) (>= recursion clip-recursion-limit))))
  (blank)
  (let line (call signed-distance-line (. c2 anchor1) (. c2 anchor2)))
  (let d1 (call (. line distance) (. c2 handle-out)))
  (let d2 (call (. line distance) (. c2 handle-in)))
  (let factor (if-expr (> (* d1 d2) 0) three-fourths four-ninths))
  (let d-min (* factor (call min (call min 0 d1) d2)))
  (let d-max (* factor (call max (call max 0 d1) d2)))
  (let dp0 (call (. line distance) (. c1 anchor1)))
  (let dp1 (call (. line distance) (. c1 handle-out)))
  (let dp2 (call (. line distance) (. c1 handle-in)))
  (let dp3 (call (. line distance) (. c1 anchor2)))
  (return-if (if (and (== d1 0) (== d2 0) (== dp0 0) (== dp1 0) (== dp2 0) (== dp3 0))))
  (blank)
  (let clips (call clip-convex-hull-scalars dp0 dp1 dp2 dp3 d-min d-max))
  (return-if (if (not (. clips t-min))))
  (return-if (if (not (. clips t-max))))
  (blank)
  (let t-min-clip (. clips t-min))
  (let t-max-clip (. clips t-max))
  (let t-min-new (+ t-min (* (- t-max t-min) t-min-clip)))
  (let t-max-new (+ t-min (* (- t-max t-min) t-max-clip)))
  (let u-diff (- u-max u-min))
  (if (< (call max u-diff (- t-max-new t-min-new)) hull-epsilon)
    (let t1 (/ (+ t-min-new t-max-new) 2))
    (let t2 (/ (+ u-min u-max) 2))
    (if is-reverse
      (+= out (tuple (+ i2 t2) (+ i1 t1) p2 p1))
      (else
        (+= out (tuple (+ i1 t1) (+ i2 t2) p1 p2))
      )
    )
    (probe-count graphics.intersect.curve-curve.emitted-intersections)
    (return)
  )
  (blank)
  (let clipped (call (. c1 split-at-range) t-min-clip t-max-clip))
  (if (> (- t-max-clip t-min-clip) 0.8)
    (if (> (- t-max-new t-min-new) u-diff)
      (let (tuple left right) (call (. clipped subdivide) 0.5))
      (let t (/ (+ t-min-new t-max-new) 2))
      (call refine-curve-curve
        (block
          (arg out)
          (arg counter)
          (arg c2)
          (arg left)
          (arg i2)
          (arg i1)
          (arg p2)
          (arg p1)
          (arg u-min)
          (arg u-max)
          (arg t-min-new)
          (arg t)
          (arg (not is-reverse))
          (arg (+ recursion 1))
        )
      )
      (call refine-curve-curve
        (block
          (arg out)
          (arg counter)
          (arg c2)
          (arg right)
          (arg i2)
          (arg i1)
          (arg p2)
          (arg p1)
          (arg u-min)
          (arg u-max)
          (arg t)
          (arg t-max-new)
          (arg (not is-reverse))
          (arg (+ recursion 1))
        )
      )
      (else
        (let (tuple left right) (call (. c2 subdivide) 0.5))
        (let u (/ (+ u-min u-max) 2))
        (call refine-curve-curve
          (block
            (arg out)
            (arg counter)
            (arg left)
            (arg clipped)
            (arg i2)
            (arg i1)
            (arg p2)
            (arg p1)
            (arg u-min)
            (arg u)
            (arg t-min-new)
            (arg t-max-new)
            (arg (not is-reverse))
            (arg (+ recursion 1))
          )
        )
        (call refine-curve-curve
          (block
            (arg out)
            (arg counter)
            (arg right)
            (arg clipped)
            (arg i2)
            (arg i1)
            (arg p2)
            (arg p1)
            (arg u)
            (arg u-max)
            (arg t-min-new)
            (arg t-max-new)
            (arg (not is-reverse))
            (arg (+ recursion 1))
          )
        )
      )
    )
    (else-if (or (== u-diff 0) (>= u-diff hull-epsilon))
      (call refine-curve-curve
        (block
          (arg out)
          (arg counter)
          (arg c2)
          (arg clipped)
          (arg i2)
          (arg i1)
          (arg p2)
          (arg p1)
          (arg u-min)
          (arg u-max)
          (arg t-min-new)
          (arg t-max-new)
          (arg (not is-reverse))
          (arg (+ recursion 1))
        )
      )
    )
    (else
      (call refine-curve-curve
        (block
          (arg out)
          (arg counter)
          (arg clipped)
          (arg c2)
          (arg i1)
          (arg i2)
          (arg p1)
          (arg p2)
          (arg t-min-new)
          (arg t-max-new)
          (arg u-min)
          (arg u-max)
          (arg is-reverse)
          (arg (+ recursion 1))
        )
      )
    )
  )
)

(fn-do _ clip-convex-hull-scalars _
  (param dq0 Coord)
  (param dq1 Coord)
  (param dq2 Coord)
  (param dq3 Coord)
  (param d-min Coord)
  (param d-max Coord)
  (probe-count graphics.numeric.hulls)
  (let b-x Coord (/ 1.0 3.0))
  (let c-x Coord (/ 2.0 3.0))
  (let dist1 (- dq1 (/ (+ (* 2.0 dq0) dq3) 3.0)))
  (let dist2 (- dq2 (/ (+ dq0 (* 2.0 dq3)) 3.0)))
  (let top FixedHullChain)
  (let bottom FixedHullChain)
  (if (< (* dist1 dist2) 0)
    (= top (call FixedHullChain 3 0 dq0 b-x dq1 1 dq3 0 0))
    (= bottom (call FixedHullChain 3 0 dq0 c-x dq2 1 dq3 0 0))
    (else
      (if (and (!= dist2 0) (>= (/ dist1 dist2) 2))
        (= top (call FixedHullChain 3 0 dq0 b-x dq1 1 dq3 0 0))
        (else-if (or (== dist2 0) (<= (/ dist1 dist2) 0.5))
          (= top (call FixedHullChain 3 0 dq0 c-x dq2 1 dq3 0 0))
        )
        (else
          (= top (call FixedHullChain 4 0 dq0 b-x dq1 c-x dq2 1 dq3))
        )
      )
      (= bottom (call FixedHullChain 2 0 dq0 1 dq3 0 0 0 0))
    )
  )
  (blank)
  (let flip (or (< dist1 0) (and (== dist1 0) (< dist2 0))))
  (if flip
    (return
      (call HullClips
        (block
          (arg (call clip-fixed-convex-hull false bottom top d-min d-max))
          (arg (call clip-fixed-convex-hull true bottom top d-min d-max))
        )
      )
    )
  )
  (blank)
  (return
    (call HullClips
      (block
        (arg (call clip-fixed-convex-hull false top bottom d-min d-max))
        (arg (call clip-fixed-convex-hull true top bottom d-min d-max))
      )
    )
  )
)

(fn-do _ clip-fixed-convex-hull _
  (param reverse Bool)
  (param top FixedHullChain)
  (param bottom FixedHullChain)
  (param d-min Coord)
  (param d-max Coord)
  (probe-count graphics.numeric.hull-clips)
  (let top-first Index (if-expr reverse (- (. top count) 1) 0))
  (let bottom-first Index (if-expr reverse (- (. bottom count) 1) 0))
  (if (< (call fixed-chain-y top top-first) d-min)
    (return (call clip-fixed-hull-part top reverse true d-min))
  )
  (if (> (call fixed-chain-y bottom bottom-first) d-max)
    (return (call clip-fixed-hull-part bottom reverse false d-max))
  )
  (blank)
  (return (call fixed-chain-x top top-first))
)

(fn-do _ clip-fixed-hull-part (? PointOnCurve)
  (param chain FixedHullChain)
  (param reverse Bool)
  (param is-top Bool)
  (param threshold Coord)
  (let first Index (if-expr reverse (- (. chain count) 1) 0))
  (let px (call fixed-chain-x chain first))
  (let py (call fixed-chain-y chain first))
  (for (in step (..< 1 (. chain count)))
    (let index Index (if-expr reverse (- (. chain count) 1 step) step))
    (let qx (call fixed-chain-x chain index))
    (let qy (call fixed-chain-y chain index))
    (if (or (and is-top (>= qy threshold)) (and (not is-top) (<= qy threshold)))
      (if (== qy threshold)
        (return qx)
      )
      (return (+ px (/ (* (- threshold py) (- qx px)) (- qy py))))
    )
    (blank)
    (= px qx)
    (= py qy)
  )
  (blank)
  (return null)
)

(fn-expr _ fixed-chain-x _
  (param chain FixedHullChain)
  (param index Index)
  (case? (== index 0)
    (. chain a-x)
  )
  (case? (== index 1)
    (. chain b-x)
  )
  (case? (== index 2)
    (. chain c-x)
  )
  (default
    (. chain d-x)
  )
)

(fn-expr _ fixed-chain-y _
  (param chain FixedHullChain)
  (param index Index)
  (case? (== index 0)
    (. chain a-y)
  )
  (case? (== index 1)
    (. chain b-y)
  )
  (case? (== index 2)
    (. chain c-y)
  )
  (default
    (. chain d-y)
  )
)

(fn-do _ polish-curve-intersections _
  (param hits (list CurveIntersection))
  (param start Index)
  (param first Curve)
  (param second Curve)
  (param first-index Index)
  (param second-index Index)
  (for (in i (..< start (. hits length)))
    (let hit ([] hits i))
    (let t (- (. hit t1) first-index))
    (let u (- (. hit t2) second-index))
    (for (in iteration (..< 0 24))
      (let delta (- (call intersection-point first t) (call intersection-point second u)))
      (let a (call intersection-tangent first t))
      (let b (call intersection-tangent second u))
      (let determinant (call (. a cross) b))
      (if (or (<= (. delta length) 0.000000000001) (<= (call abs determinant) 0.000000000000001))
        (break)
      )
      (let next-t (call max 0 (call min 1 (- t (/ (call (. delta cross) b) determinant)))))
      (let next-u (call max 0 (call min 1 (- u (/ (call (. delta cross) a) determinant)))))
      (let next-first (call intersection-point first next-t))
      (let next-second (call intersection-point second next-u))
      (if (>= (call (. next-first distance) next-second) (. delta length))
        (break)
      )
      (= t next-t)
      (= u next-u)
    )
    (for (in endpoint (list 0.0 1.0))
      (for (in other (list 0.0 1.0))
        (if (and (<= (call abs (- t endpoint)) tolerance) (<= (call abs (- u other)) tolerance))
          (let endpoint-first (call intersection-point first endpoint))
          (let endpoint-second (call intersection-point second other))
          (if (<= (call (. endpoint-first distance) endpoint-second) 0.000000001)
            (= t endpoint)
            (= u other)
          )
        )
      )
    )
    (= ([] hits i) (call CurveIntersection (+ first-index t) (+ second-index u) (. hit path1) (. hit path2)))
  )
  (blank)
  (let write start)
  (for (in read (..< start (. hits length)))
    (let hit ([] hits read))
    (let duplicate false)
    (for (in seen (..< start write))
      (if (and (<= (call abs (- (. ([] hits seen) t1) (. hit t1))) tolerance) (<= (call abs (- (. ([] hits seen) t2) (. hit t2))) tolerance))
        (= duplicate true)
        (break)
      )
    )
    (if (not duplicate)
      (= ([] hits write) hit)
      (+= write 1)
    )
  )
  (if (< write (. hits length))
    (-= ([] hits (... write)))
  )
)

(fn-expr _ intersection-point Point
  (param curve Curve)
  (param t Float)
  (+ anchor handle-out handle-in end)
  (where
    (lazy u (- 1 t))
    (lazy anchor (* (. curve anchor1) (* u u u)))
    (lazy handle-out (* (. curve handle-out) (* 3 u u t)))
    (lazy handle-in (* (. curve handle-in) (* 3 u t t)))
    (lazy end (* (. curve anchor2) (* t t t)))
  )
)

(fn-expr _ intersection-tangent Point
  (param curve Curve)
  (param t Float)
  (+ first second third)
  (where
    (lazy u (- 1 t))
    (lazy first (* (- (. curve handle-out) (. curve anchor1)) (* 3 u u)))
    (lazy second (* (- (. curve handle-in) (. curve handle-out)) (* 6 u t)))
    (lazy third (* (- (. curve anchor2) (. curve handle-in)) (* 3 t t)))
  )
)
