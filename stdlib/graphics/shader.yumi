+ arg-kinds [ShaderArgKind]

────────────────────
+ get motion-vector [F64]

shader-motion-vector(args, arg-kinds)

────────────────────
+ get motion-none-vector [F64]

List'F64()

────────────────────
+ with-motion-vector This
    - vector [F64]

ShaderFill(shader, shader-moved-args(args, arg-kinds, vector), is-live, frame-rate, time, arg-kinds)

────────────────────
+ moves-to Bool
    - other This

shader-moves-to(shader, args, arg-kinds, other.shader, other.args, other.arg-kinds)

━━━━━━━━━━━━━━━━━━━━
_ shader-arg-kind ShaderArgKind
    - kinds [ShaderArgKind]
    - index Index

if index < kinds.length then kinds[index] else ShaderArgKind.number

━━━━━━━━━━━━━━━━━━━━
_ shader-color-at Bool
    - args [F64]
    - kinds [ShaderArgKind]
    - index Index

shader-arg-kind(kinds, index) == .color && index + 4 <= args.length

━━━━━━━━━━━━━━━━━━━━
_ do shader-motion-vector [F64]
    - args [F64]
    - kinds [ShaderArgKind]

. vector = List'F64()
. index = 0
while index < args.length
    if shader-color-at(args, kinds, index)
        vector ++= RGBA(args[index], args[index + 1], args[index + 2], alpha).motion-vector
            .. alpha = args[index + 3]
        index += 4
    else
        if shader-arg-kind(kinds, index) == .number
            vector += args[index]
        index += 1
= vector

━━━━━━━━━━━━━━━━━━━━
_ do shader-moved-args [F64]
    - args [F64]
    - kinds [ShaderArgKind]
    - vector [F64]

. moved = List'F64(args)
. index = 0
. cursor = 0
while index < args.length
    if shader-color-at(args, kinds, index)
        . color = RGBA([vector[cursor], vector[cursor + 1], vector[cursor + 2], vector[cursor + 3]])
        moved[index] = color.red
        moved[index + 1] = color.green
        moved[index + 2] = color.blue
        moved[index + 3] = color.alpha
        index += 4
        cursor += 4
    else
        if shader-arg-kind(kinds, index) == .number
            moved[index] = vector[cursor]
            cursor += 1
        index += 1
= moved

━━━━━━━━━━━━━━━━━━━━
_ shader-moves-to Bool
    - shader Shader
    - args [F64]
    - kinds [ShaderArgKind]
    - other-shader Shader
    - other-args [F64]
    - other-kinds [ShaderArgKind]

shader.id == other-shader.id && args.length == other-args.length && kinds == other-kinds

━━━━━━━━━━━━━━━━━━━━
+ Paint is Tuple

+ shader Shader
+ args [F64] = List'F64()

━━━━━━━━━━━━━━━━━━━━
+ Brush is Tuple

+ shader Shader
+ args [F64] = List'F64()
+ spacing F64 = 0.2
+ scatter F64 = 0
+ size-jitter F64 = 0
+ angle-jitter F64 = 0
+ roundness F64 = 1
+ angle F64? = null
+ flow F64 = 1
+ taper-start F64 = 0
+ taper-end F64 = 0
+ reveal F64 = 1
+ seed F64 = 0

━━━━━━━━━━━━━━━━━━━━
+ do append-brush-arguments
    - brush Brush
    - values [F64]

values += brush.spacing
values += brush.scatter
values += brush.size-jitter
values += brush.angle-jitter
values += brush.roundness
values += brush.angle ?? 0
values += if brush.angle != null then 1.0 else 0.0
values += brush.flow
values += brush.taper-start
values += brush.taper-end
values += brush.reveal
values += brush.seed
for arg in brush.args
    values += arg
