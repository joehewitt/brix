━━━━━━━━━━━━━━━━━━━━
+ ShaderArgKind is U8

| number
| color
| fixed
| cycle

━━━━━━━━━━━━━━━━━━━━
+ FrameCycle is Tuple

+ active F64
+ rest F64
+ active-per-width F64

────────────────────
+ at-width This
    - width F64

FrameCycle(max(active + active-per-width * width, 0.000001), rest)

────────────────────
+ is-resting Bool
    - time F64

fmod(max(time, 0), active + rest) >= active

────────────────────
+ next-start F64
    - time F64

(floor(max(time, 0) / (active + rest)) + 1) * (active + rest)

━━━━━━━━━━━━━━━━━━━━
+ do shader-cycle FrameCycle?
    - args [F64]
    - kinds [ShaderArgKind]

. found FrameCycle? = null
. index = 0
while index + 3 <= args.length
    if shader-arg-kind(kinds, index) == .cycle
        . cycle = FrameCycle(args[index], args[index + 1], args[index + 2])
        =? null if found && found != cycle
        found = cycle
        index += 3
    else
        index += 1
= found

