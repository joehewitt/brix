this.id = C:brixGraphicsShaderRegister(source)

────────────────────
_ This
    - source
    - id

━━━━━━━━━━━━━━━━━━━━
+ do compiled-shader Shader?
    - source String

. id = C:brixGraphicsShaderRegister(source)
. error String = C:brixGraphicsShaderError(id)
=? null if error.length > 0
= Shader(source, id)

━━━━━━━━━━━━━━━━━━━━
+ ShaderFilter is Tuple
    is Animatable

+ shader Shader
+ args [F64] = List'F64()
+ images [Image] = List'Image()
+ is-live = false
+ frame-rate F64? = null
+ time F64
+ arg-kinds [ShaderArgKind]

────────────────────
+ get image-natives [Pointer]

each.canvas.native in images

────────────────────
+ do get image-scales [F64]

. scales = List'F64()
for image in images
    scales += image.scale
= scales

────────────────────
+ get motion-vector [F64]

shader-motion-vector(args, arg-kinds)

────────────────────
+ get motion-none-vector [F64]

List'F64()

────────────────────
+ with-motion-vector This
    - vector [F64]

ShaderFilter
    - shader
    - shader-moved-args(args, arg-kinds, vector)
    - images
    - is-live
    - frame-rate
    - time
    - arg-kinds

────────────────────
+ moves-to Bool
    - other This

shader-moves-to(shader, args, arg-kinds, other.shader, other.args, other.arg-kinds) && same-images

.. same-images = images == other.images

