./primitives
/core/map

_ vector-document-paths-seed U64 = 1469598103934665603u64

━━━━━━━━━━━━━━━━━━━━
_ VectorDocumentGeometry

+ revision U64
+ network VectorNetwork
+ path Path?
+ regions NetworkRegions?
+ world-matrix Matrix?
+ world VectorNetwork?
+ world-path Path?

────────────────────
+ This
    - revision
    - network

━━━━━━━━━━━━━━━━━━━━
_ VectorDocumentEffects

+ stamp U64
+ effects VectorEffects

────────────────────
+ This
    - stamp
    - effects

━━━━━━━━━━━━━━━━━━━━
+ VectorDocumentPaths

+ document VectorDocument
+ effect-computations Size
+ geometry-builds Size

_ geometry Map'U64'VectorDocumentGeometry
_ effect-lists Map'U64'VectorDocumentEffects

────────────────────
+ This
    - document

────────────────────
+ network
    - id U64

entry-for(id).network

────────────────────
+ do effects
    - id U64

. stamp = document.effects-stamp(id)
. cached = effect-lists[id]
=? cached.effects if cached && cached.stamp == stamp
. created = document.effects(id)
effect-lists[id] = VectorDocumentEffects(stamp, created)
= created

────────────────────
+ do geometry-path
    - id U64

. entry = entry-for(id)
. existing = entry.path
=? existing if existing
. created = entry.network.geometry()
entry.path = created
= created

────────────────────
+ do world-network
    - id U64

. matrix = document.world-transform(id)
=? network(id) if !matrix
. entry = entry-for(id)
. existing = entry.world
=? existing if existing && entry.world-matrix! == matrix
geometry-builds += 1
. created = document.network(id)
created.transform(matrix)
entry.world = created
entry.world-matrix = matrix
entry.world-path = null
= created

────────────────────
+ world-end-point Point?
    - id U64
    - mapping Matrix?

|? !ends
    null
|? mapping
    mapping.transform(world)
??
    world

.. network = entry-for(id).network
.. ends = network.outline-ends()
.. position = network.vertex(ends.last.vertex).position
.. matrix = document.world-transform(id)
.. world = if matrix then matrix.transform(position) else position

────────────────────
+ do world-end-direction Point?
    - id U64
    - at-end Bool
    - normal Bool
    - mapping Matrix?

. network = entry-for(id).network
. ends = network.outline-ends()
=? null if !ends
. step = if at-end then ends.last else ends.first
. curve = world-segment-curve(id, step.segment)
. path = Path()
path.move-to(if step.reversed then curve.anchor2 else curve.anchor1)
if network-is-monotone-line(curve)
    path.line-to(if step.reversed then curve.anchor1 else curve.anchor2)
else
    path.cubic-curve-to
        - if step.reversed then curve.handle-in else curve.handle-out
        - if step.reversed then curve.handle-out else curve.handle-in
        - if step.reversed then curve.anchor1 else curve.anchor2
if mapping
    path.transform(mapping)
. count = network.segment-count
. t PointOnCurve = if at-end then count - tolerance else tolerance
. i = t as I32
= if normal then path.get-normal-at(t - i, null) else path.get-tangent-at(t - i, null)

────────────────────
+ world-segment-curve Curve
    - id U64
    - index Index

|? !matrix
    network.curve(edge.id)
??
    Curve
        - head
        - head + linear.transform(edge.tangent-start)
        - tail + linear.transform(edge.tangent-end)
        - tail

.. network = entry-for(id).network
.. edge = network.segment-at(index)
.. matrix = document.world-transform(id)
.. linear = matrix.create-shiftless()
.. head = matrix.transform(network.vertex(edge.start).position)
.. tail = matrix.transform(network.vertex(edge.end).position)

────────────────────
+ do world-path
    - id U64

=? geometry-path(id) if !document.world-transform(id)
. network = world-network(id)
. entry = entry-for(id)
. existing = entry.world-path
=? existing if existing
. created = network.geometry()
entry.world-path = created
= created

────────────────────
+ do regions
    - id U64

. entry = entry-for(id)
. existing = entry.regions
=? existing if existing
. created = NetworkRegionWorkspace().resolve(entry.network)
entry.regions = created
= created

────────────────────
+ paths
    - id U64

if document.is-network(id) then network-paths(id) else group-paths(id)

────────────────────
+ do network-paths
    - id U64

. path = geometry-path(id)
. effects = effects(id)
=? [path] if !effects.has-enabled
. key = vector-document-mix(document.geometry-stamp(id), document.effects-stamp(id))
. stored = document.effect-output(id, key)
=? stored if stored
effect-computations += 1
. result = effects.apply([path])
document.store-effect-output(id, key, result)
= result

────────────────────
+ do group-paths [Path]
    - id U64

. effects = effects(id)
. key = combined-key(id)
if effects.has-enabled
    . stored = document.effect-output(id, key)
    =? stored if stored
. source [Path]
for child in document.children(id)
    if !document.renders(child)
        continue
    . child-paths = if document.is-network(child) then network-paths(child) else group-paths(child)
    . child-transform = document.transform(child)
    for path in child-paths
        if child-transform
            . moved = Path(path)
            moved.transform(child-transform)
            source += moved
        else
            source += path
=? source if !effects.has-enabled
effect-computations += 1
. result = effects.apply(source)
document.store-effect-output(id, key, result)
= result

────────────────────
+ do combined-key U64
    - id U64

. result = vector-document-mix(vector-document-paths-seed, document.effects-stamp(id))
for child in document.children(id)
    if document.renders(child)
        result = vector-document-mix(result, document.stamp(child))
        if document.is-group(child)
            result = vector-document-mix(result, combined-key(child))
= result

────────────────────
+ do trim

for id in List'U64(geometry.keys)
    if !document.contains(id)
        -= geometry[id]
for id in List'U64(effect-lists.keys)
    if !document.contains(id)
        -= effect-lists[id]

────────────────────
_ do entry-for
    - id U64

. revision = document.network-revision(id)
. cached = geometry[id]
=? cached if cached && cached.revision == revision
geometry-builds += 1
. entry = VectorDocumentGeometry(revision, document.shared-network(id))
geometry[id] = entry
= entry
