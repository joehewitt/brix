(import ./matrix)
(import ./primitives)
(import ./style)
(blank)
(prop + vector-geometry-source-container U8 (= 1))
(prop + vector-geometry-source-graphic U8 (= 2))

(type + VectorGeometrySource (is Interface)
  (fn-do + prepare-vector-geometry-source _)
  (fn-expr + vector-geometry-source-pointer Pointer :get)
  (fn-expr + vector-geometry-source-kind U8 :get)
  (fn-expr + vector-geometry-source-fill Fill :get)
  (fn-expr + vector-geometry-source-stroke Stroke :get)
  (fn-expr + vector-geometry-source-stroke-width (? Length) :get)
  (fn-expr + vector-geometry-source-stroke-cap (? LineCap) :get)
  (fn-expr + vector-geometry-source-stroke-join (? LineJoin) :get)
  (fn-expr + vector-geometry-source-fill-rule (? FillRule) :get)
  (fn-expr + vector-geometry-source-transform (? Matrix) :get)
  (fn-expr + vector-geometry-source-compact Bool :get)
  (fn-expr + vector-geometry-source-child-count Size :get)
  (fn-do + vector-geometry-source-child VectorGeometrySource
    (param index Index)
  )
)
