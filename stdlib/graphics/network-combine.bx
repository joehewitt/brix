(import ./curve)
(import ./network)
(import ./network-regions)
(import ./point)
(import /math)
(blank)
(prop _ network-length-samples Size (= 64))

(type + NetworkWovenPiece (is Tuple)
  (prop + source Index)
  (prop + network VectorNetwork)
  (prop + over Bool)
)

(fn-do + network-free-end (? Index)
  (param network VectorNetwork)
  (let result (? Index))
  (for (in trace (call (. network traces) false))
    (let ends (call network-free-ends network trace))
    (if ends
      (= result ([] ends 1))
    )
  )
  (return result)
)

(fn-do + network-join _
  (param network VectorNetwork)
  (param start (? Index) (= null))
  (param tolerance Float (= 0.001))
  (let seed
    (scope (if-expr (and start (call (. network has-vertex) start) (== (call (. network degree) start) 1)) start any-end)
      (lazy any-end (call network-free-end network))
    )
  )
  (return-if (if (not seed)))
  (blank)
  (let chain (call network-run-ends network seed))
  (return-if (if (not chain)))
  (blank)
  (let head (if-expr (== ([] chain 1) seed) ([] chain 0) ([] chain 1)))
  (let tail seed)
  (while true
    (let joined (? Index))
    (let nearest (? Index))
    (let other (? Index))
    (let distance 0.0)
    (for (in trace (call (. network traces) false))
      (let ends (call network-free-ends network trace))
      (if (and ends (!= ([] ends 0) head) (!= ([] ends 0) tail) (!= ([] ends 1) head) (!= ([] ends 1) tail))
        (for (in chain-end (list head tail))
          (let position (. (call (. network vertex) chain-end) position))
          (for (in side (..< 0 2))
            (let gap (call (. (call (. network vertex) ([] ends side)) position distance) position))
            (if (or (not nearest) (< gap distance))
              (= joined chain-end)
              (= nearest ([] ends side))
              (= other ([] ends (- 1 side)))
              (= distance gap)
            )
          )
        )
      )
    )
    (if (not nearest)
      (break)
    )
    (if (<= distance tolerance)
      (call (. network merge-vertices) nearest (!! joined) (. (call (. network vertex) (!! joined)) position))
      (else
        (call (. network connect) (!! joined) nearest)
      )
    )
    (if (== (!! joined) head)
      (= head (!! other))
      (else
        (= tail (!! other))
      )
    )
  )
  (let run (call network-run network head))
  (if run
    (call (. network order-vertices) run)
  )
)

(fn-do + network-split (list VectorNetwork)
  (param network VectorNetwork)
  (let result (call (. network copy)))
  (let crossings (call (. (call NetworkRegionWorkspace) crossings) result))
  (let index Index 0)
  (while (< index (. crossings length))
    (let segment (. ([] crossings index) segment))
    (let parameters (list Float))
    (while (and (< index (. crossings length)) (== (. ([] crossings index) segment) segment))
      (+= parameters (. ([] crossings index) parameter))
      (+= index 1)
    )
    (call (. result cut) segment parameters)
  )
  (return (call (of List VectorNetwork) (in (call (. result extract) each) (call (. result traces) false))))
)

(fn-do + network-weave (list NetworkWovenPiece)
  (param networks (list VectorNetwork))
  (let merged (call VectorNetwork))
  (let bounds (list Index))
  (for (in network networks)
    (call (. merged add-network) network)
    (+= bounds (. merged next-segment-id))
  )
  (let crossings (call (. (call NetworkRegionWorkspace) crossings) merged))
  (let counts (list Size))
  (for (in item crossings)
    (while (<= (. counts length) (. item crossing))
      (+= counts 0)
    )
    (+= ([] counts (. item crossing)) 1)
  )
  (let woven (call (of Map Index (list NetworkCrossing))))
  (for (in item crossings (when (== ([] counts (. item crossing)) 2)))
    (let along (?? ([] woven (. item segment)) (call (of List NetworkCrossing))))
    (+= along item)
    (= ([] woven (. item segment)) along)
  )
  (let strands (call (. merged traces) false))
  (let visits (list NetworkVisit))
  (let lengths (list Float))
  (let spans (list (list Float)))
  (for (in strand (..< 0 (. strands length)))
    (let trace ([] strands strand))
    (let covered 0.0)
    (let order Size 0)
    (let measured (list Float))
    (for (in index (..< 0 (. trace segments length)))
      (let id ([] (. trace segments) index))
      (let reversed ([] (. trace reversed) index))
      (let curve (call network-travel-curve (call (. merged curve) id) reversed))
      (let along ([] woven id))
      (if along
        (let passed (if-expr reversed (call (of List NetworkCrossing) (in each (call (. along reversed)))) along))
        (for (in item passed)
          (let travelled
            (call network-curve-length
              (block
                (arg curve)
                (arg (if-expr reversed (- 1 (. item parameter)) (. item parameter)))
              )
            )
          )
          (+= visits
            (call NetworkVisit
              (block
                (arg strand)
                (arg order)
                (arg (. item crossing))
                (arg id)
                (arg (. item parameter))
                (arg (+ covered travelled))
              )
            )
          )
          (+= order 1)
        )
      )
      (let length (call network-curve-length curve 1))
      (+= measured length)
      (+= covered length)
    )
    (+= lengths covered)
    (+= spans measured)
  )
  (let partners (list Index))
  (let first-visits (call (of Map Index Index)))
  (for (in index (..< 0 (. visits length)))
    (+= partners index)
    (let crossing (. ([] visits index) crossing))
    (let earlier ([] first-visits crossing))
    (if (!= earlier null)
      (= ([] partners earlier) index)
      (= ([] partners index) earlier)
      (else
        (= ([] first-visits crossing) index)
      )
    )
  )
  (let phases (list Size))
  (for (in index (..< 0 (. strands length)))
    (+= phases 2)
  )
  (for (in start (..< 0 (. strands length)))
    (if (== ([] phases start) 2)
      (= ([] phases start) 0)
      (let changed true)
      (while changed
        (= changed false)
        (for (in index (..< 0 (. visits length)))
          (let visit ([] visits index))
          (let partner ([] visits ([] partners index)))
          (if (and (!= ([] phases (. visit strand)) 2) (== ([] phases (. partner strand)) 2))
            (= ([] phases (. partner strand))
              (scope (% order-sum 2)
                (lazy order-sum (+ ([] phases (. visit strand)) (. visit order) (. partner order) 1))
              )
            )
            (= changed true)
          )
        )
      )
    )
  )
  (let above (list Bool))
  (for (in index (..< 0 (. visits length)))
    (let leading (<= index ([] partners index)))
    (let lead ([] visits (if-expr leading index ([] partners index))))
    (let leads (== (% (+ ([] phases (. lead strand)) (. lead order)) 2) 0))
    (+= above (if-expr leading leads (not leads)))
  )
  (let cuts (list Index))
  (let cut-parameters (list (list Float)))
  (for (in strand (..< 0 (. strands length)))
    (let trace ([] strands strand))
    (let distances (list Float))
    (for (in visit visits)
      (if (== (. visit strand) strand)
        (+= distances (. visit distance))
      )
    )
    (let targets (list Float))
    (if (> (. distances length) 1)
      (for (in index (..< 1 (. distances length)))
        (+= targets (/ (+ ([] distances (- index 1)) ([] distances index)) 2))
      )
    )
    (if (and (. trace closed) (. distances length))
      (let wrapped (/ (+ ([] distances (- (. distances length) 1)) ([] distances 0) ([] lengths strand)) 2))
      (+= targets (if-expr (>= wrapped ([] lengths strand)) (- wrapped ([] lengths strand)) wrapped))
    )
    (for (in target targets)
      (call network-add-cut merged trace ([] spans strand) target cuts cut-parameters)
    )
  )
  (let placed (list Index))
  (for (in visit visits)
    (+= placed (. visit segment))
  )
  (for (in index (..< 0 (. cuts length)))
    (let pieces (call (. merged cut) ([] cuts index) ([] cut-parameters index)))
    (for (in visit-index (..< 0 (. visits length)))
      (let visit ([] visits visit-index))
      (if (== (. visit segment) ([] cuts index))
        (let slot Index 0)
        (for (in parameter ([] cut-parameters index))
          (if (< parameter (. visit parameter))
            (+= slot 1)
          )
        )
        (= ([] placed visit-index) ([] pieces slot))
      )
    )
  )
  (let lower (list NetworkWovenPiece))
  (let upper (list NetworkWovenPiece))
  (let pieces (call (. merged traces) false))
  (let owners (call (of Map Index Index)))
  (for (in index (..< 0 (. pieces length)))
    (for (in id (. ([] pieces index) segments))
      (= ([] owners id) index)
    )
  )
  (let tops (list Bool))
  (for (in index (..< 0 (. pieces length)))
    (+= tops false)
  )
  (for (in index (..< 0 (. visits length)) (when ([] above index)))
    (let owner ([] owners ([] placed index)))
    (if (!= owner null)
      (= ([] tops owner) true)
    )
  )
  (for (in index (..< 0 (. pieces length)))
    (let trace ([] pieces index))
    (let source (call network-source-index bounds (. (call (. merged segment) ([] (. trace segments) 0)) source)))
    (let piece (call NetworkWovenPiece source (call (. merged extract) trace) ([] tops index)))
    (if ([] tops index)
      (+= upper piece)
      (else
        (+= lower piece)
      )
    )
  )
  (return
    (call (of List NetworkWovenPiece)
      (block
        (spread lower)
        (spread upper)
      )
    )
  )
)

(type _ NetworkVisit (is Tuple)
  (prop + strand Index)
  (prop + order Size)
  (prop + crossing Index)
  (prop + segment Index)
  (prop + parameter Float)
  (prop + distance Float)
)

(fn-expr _ network-free-ends (? (list Index))
  (param network VectorNetwork)
  (param trace NetworkTrace)
  (case? (. trace closed)
    null
  )
  (case? (== ([] ends 0) ([] ends 1))
    null
  )
  (case? (or (!= (call (. network degree) ([] ends 0)) 1) (!= (call (. network degree) ([] ends 1)) 1))
    null
  )
  (default
    ends
  )
  (where
    (lazy ends (call (. network trace-ends) trace))
  )
)

(fn-do _ network-run-ends (? (list Index))
  (param network VectorNetwork)
  (param vertex Index)
  (for (in trace (call (. network traces) false))
    (let ends (call network-free-ends network trace))
    (return-if ends (if (and ends (or (== ([] ends 0) vertex) (== ([] ends 1) vertex)))))
  )
  (return null)
)

(fn-do _ network-run (? (list Index))
  (param network VectorNetwork)
  (param head Index)
  (for (in trace (call (. network traces) false))
    (let ends (call network-free-ends network trace))
    (if (and ends (or (== ([] ends 0) head) (== ([] ends 1) head)))
      (let vertices (list Index) (call (of List Index) ([] ends 0)))
      (for (in index (..< 0 (. trace segments length)))
        (let edge (call (. network segment) ([] (. trace segments) index)))
        (+= vertices (if-expr ([] (. trace reversed) index) (. edge start) (. edge end)))
      )
      (return (if-expr (== ([] ends 1) head) (call (of List Index) (in each (call (. vertices reversed)))) vertices))
    )
  )
  (return null)
)

(fn-do _ network-add-cut _
  (param network VectorNetwork)
  (param trace NetworkTrace)
  (param lengths (list Float))
  (param distance Float)
  (param cuts (list Index))
  (param cut-parameters (list (list Float)))
  (let covered 0.0)
  (for (in index (..< 0 (. trace segments length)))
    (let length ([] lengths index))
    (if (or (< distance (+ covered length)) (== index (- (. trace segments length) 1)))
      (let id ([] (. trace segments) index))
      (let reversed ([] (. trace reversed) index))
      (let curve (call network-travel-curve (call (. network curve) id) reversed))
      (let travelled (call network-curve-parameter curve (- distance covered)))
      (let parameter (call min (call max (if-expr reversed (- 1 travelled) travelled) 0.001) 0.999))
      (for (in slot (..< 0 (. cuts length)))
        (if (== ([] cuts slot) id)
          (call network-insert-sorted ([] cut-parameters slot) parameter)
          (return)
        )
      )
      (+= cuts id)
      (+= cut-parameters (call (of List Float) parameter))
      (return)
    )
    (+= covered length)
  )
)

(fn-do _ network-insert-sorted _
  (param values (list Float))
  (param value Float)
  (for (in index (..< 0 (. values length)))
    (return-if (if (< (call abs (- ([] values index) value)) 0.000000001)))
    (blank)
    (if (> ([] values index) value)
      (call (. values insert) value index)
      (return)
    )
  )
  (+= values value)
)

(fn-do _ network-source-index Index
  (param bounds (list Index))
  (param source Index)
  (for (in index (..< 0 (. bounds length)))
    (return-if index (if (< source ([] bounds index))))
  )
  (return 0)
)

(fn-expr _ network-travel-curve Curve
  (param curve Curve)
  (param reversed Bool)
  (if-expr reversed (call Curve (. curve anchor2) (. curve handle-in) (. curve handle-out) (. curve anchor1)) curve)
)

(fn-do _ network-curve-length Float
  (param curve Curve)
  (param extent Float)
  (let total 0.0)
  (let previous (. curve anchor1))
  (for (in index (..< 0 network-length-samples))
    (let point
      (call network-curve-point
        (block
          (arg curve)
          (arg (/ (* extent (as (+ index 1) Float)) (as network-length-samples Float)))
        )
      )
    )
    (+= total (call (. point distance) previous))
    (= previous point)
  )
  (return total)
)

(fn-do _ network-curve-parameter Float
  (param curve Curve)
  (param length Float)
  (let total 0.0)
  (let previous (. curve anchor1))
  (for (in index (..< 0 network-length-samples))
    (let point (call network-curve-point curve (/ (as (+ index 1) Float) (as network-length-samples Float))))
    (let piece (call (. point distance) previous))
    (if (and (> piece 0) (>= (+ total piece) length))
      (return (/ (+ (as index Float) (/ (- length total) piece)) (as network-length-samples Float)))
    )
    (+= total piece)
    (= previous point)
  )
  (return 1.0)
)
