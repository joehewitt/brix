━━━━━━━━━━━━━━━━━━━━
+ tests TestRender

════════════════════
test("Split Range")

1, arc.curve-count
    .. arc = truchet-split-range-arc()
2, arc.count
    .. arc = truchet-split-range-arc()
"(640, 640, 30, 30)", "$arc.bounding-box"
    .. arc = truchet-split-range-arc()
"(670, 640)", "$arc.first-point"
    .. arc = truchet-split-range-arc()
"(640, 670)", "$arc.last-point"
    .. arc = truchet-split-range-arc()

════════════════════
test("Arc Fidelity")

true, near(100, shallow-arc().bounding-box.right, 0.001)
true, near(96.5926, shallow-arc().bounding-box.x, 0.001)

════════════════════
test("Explicit Fill Rule Hit Testing")

true, fill-rule-hit-tests()

════════════════════
test("Bounding Box")

true, near-rect(Rect(0, -2.886751, 40, 7.886751), command-path().bounding-box)

════════════════════
test("Containment")

true, rectangle(Rect(0, 0, 10, 10)).contains((5, 5))
false, rectangle(Rect(0, 0, 10, 10)).contains((15, 5))
true, rectangle(Rect(0, 0, 10, 10)).contains((0, 5))

true, circle((0, 0), 10).contains((0, 0))
false, circle((0, 0), 10).contains((20, 0))
true, circle((0, 0), 10).contains((10, 0))

━━━━━━━━━━━━━━━━━━━━
_ do command-path

. path = Path()
path.move-to(0, 0)
path.line-to(10, 0)
path.quadratic-curve-to(15, 10, 20, 0)
path.cubic-curve-to(25, -10, 35, 10, 40, 0)
= path

━━━━━━━━━━━━━━━━━━━━
_ do shallow-arc

. path = Path()
path.arc((0, 0), 100, -15deg, 15deg)
= path

━━━━━━━━━━━━━━━━━━━━
_ do fill-rule-hit-tests

. path = rectangle(Rect(0, 0, 100, 100))
path.add-path(rectangle(Rect(25, 25, 100, 100)))
=? false if !path.contains((50, 50), FillRule.nonzero)
=? false if path.contains((50, 50), FillRule.even-odd)
=? false if path.contains((150, 150), FillRule.nonzero)
. ring = circle((50, 50), 40)
ring.add-path(circle((50, 50), 20).reverse())
=? false if ring.contains((50, 50), FillRule.nonzero)
=? false if !ring.contains((20, 50), FillRule.nonzero)
. triangle = Path()
triangle.move-to(0, 0)
triangle.line-to(100, 0)
triangle.line-to(100, 100)
=? false if !triangle.contains((80, 20), FillRule.nonzero)
= !triangle.contains((20, 80), FillRule.nonzero)

━━━━━━━━━━━━━━━━━━━━
_ truchet-split-range-arc

c.split-at-range(half, half + quarter)

.. c = circle((640, 640), 30)
.. quarter = c.curve-count / 4.0
.. half = c.curve-count / 2.0
