(import /graphics/curve)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/tests/support/geometry)
(import /math)
(import /test)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Curve Split Range"))
  (tuple true (call near-point (tuple 0 0) (. (call (. (call simple-curve) split-at-range) 0.0 0.5) anchor1)))
  (tuple true (call near-point (tuple 5 7.5) (. (call (. (call simple-curve) split-at-range) 0.0 0.5) anchor2)))
  (tuple true (call near-point (tuple 1.5625 5.625) (. (call (. (call simple-curve) split-at-range) 0.25 0.75) anchor1)))
  (tuple true (call near-point (tuple 8.4375 5.625) (. (call (. (call simple-curve) split-at-range) 0.25 0.75) anchor2)))
  (header (call test "Curve Parameter"))
  (tuple true (call near 0.5 (call (. (call simple-curve) get-parameter) (tuple 5 7.5))))
  (tuple true (call near -1 (call (. (call simple-curve) get-parameter) (tuple 5 5))))
  (tuple true (call near 0.5 (call (. (call line-curve) get-parameter) (tuple 5 0))))
  (tuple true (call near -1 (call (. (call line-curve) get-parameter) (tuple 5 1))))
)

(fn-expr + simple-curve _
  (call Curve (tuple 0 0) (tuple 0 10) (tuple 10 10) (tuple 10 0))
)

(fn-expr + line-curve _
  (call Curve (tuple 0 0) (tuple 0 0) (tuple 10 0) (tuple 10 0) .segment-type-line)
)
