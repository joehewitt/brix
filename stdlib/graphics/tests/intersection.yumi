━━━━━━━━━━━━━━━━━━━━
+ expected-crossing-intersections
    - intersections [CurveIntersection]

near-intersections(intersections, [0.211325, 0.788675], [0.115100, 0.884900])

━━━━━━━━━━━━━━━━━━━━
+ do crossing-curve

. curve = Path()
curve.move-to(0, 0)
curve.cubic-curve-to(0, 10, 10, 10, 10, 0)
= curve

━━━━━━━━━━━━━━━━━━━━
+ do tangent-curve-precision

. first = circle((50, 50), 30)
. second = circle((110, 50), 30)
. hits [CurveIntersection]
for a in first.curves
    for b in second.curves
        hits.clear()
        intersect-curves(hits, a, b)
        for hit in hits
            . pa = a.split-at-range(0, hit.t1).anchor2
            . pb = b.split-at-range(0, hit.t2).anchor2
            =? false if pa.distance(pb) > 0.00001
= true
