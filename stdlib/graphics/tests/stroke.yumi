━━━━━━━━━━━━━━━━━━━━
+ do check-coverage
    - t TestCase
    - label String
    - shape Path
    - alignment StrokeAlignment
    - width Length

. outline = stroke(shape, width, alignment, JoinType.round-join-type, LineCap.round, 4)
t.expect
    - "$label covers exactly its reach"
    - 0
    - coverage-mismatches(shape, outline, width, alignment)

━━━━━━━━━━━━━━━━━━━━
+ do coverage-mismatches Size
    - shape Path
    - outline Path
    - width Length
    - alignment StrokeAlignment

. polyline = flattened(shape)
. reach = if alignment == StrokeAlignment.center then width / 2 else width
. box = shape.bounding-box
. mismatches Size = 0
. y = box.y - reach - 3.37
while y < box.y + box.height + reach + 4
    . x = box.x - reach - 3.61
    while x < box.x + box.width + reach + 4
        . point = Point(x, y)
        . distance = polyline-distance(polyline, point)
        if distance > 1.5 && abs(distance - reach) > 1.5
            . in-reach = distance < reach
            . inside = shape.contains(point, FillRule.nonzero)
            . on-stroke-side =
                |? alignment == StrokeAlignment.inside
                    inside
                |? alignment == StrokeAlignment.outside
                    !inside
                ??
                    true
            . covered = outline.contains(point, FillRule.nonzero)
            if (on-stroke-side || !in-reach) && covered != (in-reach && on-stroke-side)
                mismatches += 1
        x += 16
    y += 16
= mismatches

━━━━━━━━━━━━━━━━━━━━
+ do flattened [Point]
    - path Path

. points [Point]
. span = path.commands
. current = Point(0, 0)
. start = Point(0, 0)
for i in 0 .. < span.command-count
    . verb = span.verbs[i]
    . offset = span.coord-offsets[i]
    if verb == .path-verb-move
        current = Point(span.coords[offset], span.coords[offset + 1])
        start = current
        points += current
    else if verb == .path-verb-line
        current = Point(span.coords[offset], span.coords[offset + 1])
        points += current
    else if verb == .path-verb-cubic
        . h1 = Point(span.coords[offset], span.coords[offset + 1])
        . h2 = Point(span.coords[offset + 2], span.coords[offset + 3])
        . end = Point(span.coords[offset + 4], span.coords[offset + 5])
        for step in 1 .. < 65
            points += cubic-point(current, h1, h2, end, (step as Float) / 64)
        current = end
    else if verb == .path-verb-close
        points += start
        current = start
= points

━━━━━━━━━━━━━━━━━━━━
+ do polyline-distance Float
    - points [Point]
    - point Point

. best = 1e300
for index in 1 .. < points.length
    . a = points[index - 1]
    . b = points[index]
    . segment = b - a
    . length-squared = segment.dot(segment)
    . along = if length-squared <= 0 then 0.0 else min(max(projection, 0), 1)
        .. projection = (point - a).dot(segment) / length-squared
    best = min(best, point.distance(a + segment * along))
= best

