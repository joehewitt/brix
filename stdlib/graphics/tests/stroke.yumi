━━━━━━━━━━━━━━━━━━━━
+ do aligned-join-tests TestCase
    - t TestCase

. shape = shallow-corner-shape()
. wedge = Point(443.8, 232)
. notch = shallow-notch-shape()
. notch-wedge = Point(200, -30)
for join in [JoinType.round-join-type, JoinType.miter-join-type, JoinType.bevel-join-type]
    for reversed in [false, true]
        . source = if reversed then shape.reverse() else shape
        . inside = stroke(source, 100, StrokeAlignment.inside, join, LineCap.round, 4)
        t.check
            - "an inside stroke covers its shallow inner join (reversed $reversed)"
            - inside.contains(wedge, FillRule.nonzero)
        . centered = stroke(source, 100, StrokeAlignment.center, join, LineCap.round, 4)
        t.check
            - "a centered stroke covers its shallow inner join (reversed $reversed)"
            - centered.contains(Point(452, 219), FillRule.nonzero)
        . notch-source = if reversed then notch.reverse() else notch
        . outside = stroke(notch-source, 100, StrokeAlignment.outside, join, LineCap.round, 4)
        t.check
            - "an outside stroke covers its shallow outer notch (reversed $reversed)"
            - outside.contains(notch-wedge, FillRule.nonzero)
= t

