━━━━━━━━━━━━━━━━━━━━
+ do straight-stroke-corner-width

. path = Path()
path.move-to(47, 189)
path.line-to(347, 25)
path.line-to(505, 176)
path.line-to(410, 346)
path.line-to(213, 314)
. valid = true
for representation in 0 .. < 3
    . source = path
    if representation > 0
        source = Path()
        source.move-to(path.first-point)
        for curve in path.curves
            . jitter = if representation == 2 then Point(0.3, -0.3) else Point(0, 0)
            source.cubic-curve-to(curve.anchor1 + jitter, curve.anchor2 - jitter, curve.anchor2)
    for reversed in [false, true]
        . directed = if reversed then source.reverse() else source
        for join in [.round-join-type, .miter-join-type, .bevel-join-type]
            . outline = stroke(directed, 4, .center, join, .round, 4)
            if !straight-stroke-width-covers(path, outline)
                -- "Bad representation $representation reversed $reversed join $join"
                valid = false
            . net-outline = network-stroke(network-from-path(directed), 4, join, .round, 4)
            if !straight-stroke-width-covers(path, net-outline)
                -- "Bad network representation $representation reversed $reversed join $join"
                valid = false
= valid

━━━━━━━━━━━━━━━━━━━━
+ do straight-stroke-width-covers
    - path Path
    - outline Path

. valid = true
for curve in path.curves
    . delta = curve.anchor2 - curve.anchor1
    . normal = Point(-delta.y, delta.x) / delta.length
    for fraction in [0.05, 0.25, 0.5, 0.75, 0.95]
        . center = curve.anchor1 + delta * fraction
        for side in [-1.0, 1.0]
            if !outline.contains(center + normal * (1.5 * side), FillRule.nonzero)
                -- "Missing width at $fraction $side: ${curve.anchor1} to ${curve.anchor2}"
                valid = false
            if outline.contains(center + normal * (2.5 * side), FillRule.nonzero)
                -- "Excess stroke width at $fraction on $side: ${curve.anchor1} to ${curve.anchor2}"
                valid = false
= valid
