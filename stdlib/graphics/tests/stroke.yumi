+ do coverage-tests TestCase
    - t TestCase

. corner = shallow-corner-shape()
. ring = circle(Point(200, 200), 60)
check-coverage(t, "corner inside", corner, StrokeAlignment.inside, 100)
check-coverage(t, "reversed corner inside", corner.reverse(), StrokeAlignment.inside, 100)
check-coverage(t, "corner center", corner, StrokeAlignment.center, 100)
check-coverage(t, "tight circle inside", ring, StrokeAlignment.inside, 160)
check-coverage(t, "tight circle center", ring, StrokeAlignment.center, 160)
check-coverage(t, "notch outside", shallow-notch-shape(), StrokeAlignment.outside, 100)
= t

