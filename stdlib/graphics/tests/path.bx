(import /graphics/canvas)
(import /graphics/path)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/tests/support/geometry)
(import /math)
(import /test)
(import /units)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Split Range"))
  (scope (tuple 1 (. arc curve-count))
    (lazy arc (call truchet-split-range-arc))
  )
  (scope (tuple 2 (. arc count))
    (lazy arc (call truchet-split-range-arc))
  )
  (scope (tuple "(640, 640, 30, 30)" (str (. arc bounding-box)))
    (lazy arc (call truchet-split-range-arc))
  )
  (scope (tuple "(670, 640)" (str (. arc first-point)))
    (lazy arc (call truchet-split-range-arc))
  )
  (scope (tuple "(640, 670)" (str (. arc last-point)))
    (lazy arc (call truchet-split-range-arc))
  )
  (header (call test "Arc Fidelity"))
  (tuple true (call near 100 (. (call shallow-arc) bounding-box right) 0.001))
  (tuple true (call near 96.5926 (. (call shallow-arc) bounding-box x) 0.001))
  (header (call test "Explicit Fill Rule Hit Testing"))
  (tuple true (call fill-rule-hit-tests))
  (header (call test "Bounding Box"))
  (tuple true (call near-rect (call Rect 0 -2.886751 40 7.886751) (. (call command-path) bounding-box)))
  (header (call test "Containment"))
  (tuple true (call (. (call rectangle (call Rect 0 0 10 10)) contains) (tuple 5 5)))
  (tuple false (call (. (call rectangle (call Rect 0 0 10 10)) contains) (tuple 15 5)))
  (tuple true (call (. (call rectangle (call Rect 0 0 10 10)) contains) (tuple 0 5)))
  (blank)
  (tuple true (call (. (call circle (tuple 0 0) 10) contains) (tuple 0 0)))
  (tuple false (call (. (call circle (tuple 0 0) 10) contains) (tuple 20 0)))
  (tuple true (call (. (call circle (tuple 0 0) 10) contains) (tuple 10 0)))
)

(fn-do _ command-path _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 10 0)
  (call (. path quadratic-curve-to) 15 10 20 0)
  (call (. path cubic-curve-to) 25 -10 35 10 40 0)
  (return path)
)

(fn-do _ shallow-arc _
  (let path (call Path))
  (call (. path arc) (tuple 0 0) 100 -15deg 15deg)
  (return path)
)

(fn-do _ fill-rule-hit-tests _
  (let path (call rectangle (call Rect 0 0 100 100)))
  (call (. path add-path) (call rectangle (call Rect 25 25 100 100)))
  (return-if false (if (not (call (. path contains) (tuple 50 50) (. FillRule nonzero)))))
  (return-if false (if (call (. path contains) (tuple 50 50) (. FillRule even-odd))))
  (return-if false (if (call (. path contains) (tuple 150 150) (. FillRule nonzero))))
  (let ring (call circle (tuple 50 50) 40))
  (call (. ring add-path) (call (. (call circle (tuple 50 50) 20) reverse)))
  (return-if false (if (call (. ring contains) (tuple 50 50) (. FillRule nonzero))))
  (return-if false (if (not (call (. ring contains) (tuple 20 50) (. FillRule nonzero)))))
  (let triangle (call Path))
  (call (. triangle move-to) 0 0)
  (call (. triangle line-to) 100 0)
  (call (. triangle line-to) 100 100)
  (return-if false (if (not (call (. triangle contains) (tuple 80 20) (. FillRule nonzero)))))
  (return (not (call (. triangle contains) (tuple 20 80) (. FillRule nonzero))))
)

(fn-expr _ truchet-split-range-arc _
  (call (. c split-at-range) half (+ half quarter))
  (where
    (lazy c (call circle (tuple 640 640) 30))
    (lazy quarter (/ (. c curve-count) 4.0))
    (lazy half (/ (. c curve-count) 2.0))
  )
)
