(import /graphics/canvas)
(import /graphics/color)
(import /graphics/network)
(import /graphics/network-stroke)
(import /graphics/path)
(import /graphics/primitives)
(import /graphics/stroke)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Network Junction Strokes"))
  (call (. cases run) junction-tests)
  (= cases (call (. cases then) "Network Junction Coverage" coverage-tests))
  (return cases)
)

(fn-do + junction-tests _
  (param t TestCase)
  (let net (call VectorNetwork))
  (let center (call (. net add-vertex) (tuple 70 70)))
  (call (. net connect) center (call (. net add-vertex) (tuple 20 100)))
  (call (. net connect) center (call (. net add-vertex) (tuple 120 100)))
  (call (. net connect) center (call (. net add-vertex) (tuple 70 20)))
  (let workspace (call NetworkStrokeWorkspace))
  (let outline (call (. workspace resolve) net 12))
  (call (. t check) "junction has filled center" (call (. outline contains) (tuple 70 70) (. FillRule nonzero)))
  (call (. t check) "stroke excludes remote space" (not (call (. outline contains) (tuple 5 5) (. FillRule nonzero))))
  (call (. t check) "round cap extends endpoint" (call (. outline contains) (tuple 70 15) (. FillRule nonzero)))
  (return t)
)

(fn-do + coverage-tests _
  (param t TestCase)
  (let net (call VectorNetwork))
  (let root (call (. net add-vertex) (tuple 50 50)))
  (call (. net connect) root (call (. net add-vertex) (tuple 10 50)))
  (call (. net connect) root (call (. net add-vertex) (tuple 90 50)))
  (call (. net connect) root (call (. net add-vertex) (tuple 50 10)))
  (call (. net connect) root (call (. net add-vertex) (tuple 50 90)))
  (for (in join (list .round-join-type .bevel-join-type .miter-join-type))
    (let outline (call network-stroke net 12 join .butt 4))
    (let actual (call RasterCanvas 8 8 1))
    (let expected (call RasterCanvas 8 8 1))
    (do-use actual
      (do-use expected
        (= (. actual fill-color) (call RGBA 0.2 0.4 0.6 0.5))
        (= (. expected fill-color) (call RGBA 0.2 0.4 0.6 0.5))
        (= (. actual stroke-color) null)
        (= (. expected stroke-color) null)
        (call (. actual translate) -46 -46)
        (call (. outline outline) actual)
        (call (. expected rect) (call Rect 0 0 8 8))
        (call (. t expect) "junction alpha is applied once" 0 (call (. actual pixel-difference-count) expected))
      )
    )
  )
  (let curved (call VectorNetwork))
  (let center (call (. curved add-vertex) (tuple 70 70)))
  (call (. curved connect) center (call (. curved add-vertex) (tuple 10 20)) (tuple -30 0) (tuple 0 30))
  (call (. curved connect) center (call (. curved add-vertex) (tuple 130 20)) (tuple 30 0) (tuple 0 30))
  (call (. curved connect) center (call (. curved add-vertex) (tuple 70 130)) (tuple 0 30) (tuple 0 -20))
  (let outline (call network-stroke curved 10))
  (call (. t check) "curved junction covers vertex" (call (. outline contains) (tuple 70 70) (. FillRule nonzero)))
  (call (. t check)
    (block
      (arg "curved junction retains branch coverage")
      (arg (call (. outline contains) (call network-curve-point (call (. curved curve) 1) 0.5) (. FillRule nonzero)))
    )
  )
  (return t)
)
