(import /graphics/canvas)
(import /graphics/color)
(import /graphics/graphic)
(import /graphics/matrix)
(import /graphics/outline)
(import /graphics/path)
(import /graphics/path-set)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/text)
(import /os/file)
(import /test)
(import /units)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "CoreGraphics Outline"))
  (tuple true (call core-graphics-outline-arrow-works))
  (header (call test "CoreGraphics Shadow"))
  (tuple true (call core-graphics-hard-shadow-works))
  (tuple true (call core-graphics-shadow-offset-uses-points))
  (header (call test "CoreGraphics Opacity Groups"))
  (tuple 0u64 (call core-graphics-nested-opacity-difference))
  (header (call test "CoreGraphics Image"))
  (tuple true (call core-graphics-image-draw-works))
  (header (call test "Canvas Stroke Style"))
  (tuple true (call core-graphics-stroke-caps-work))
  (tuple true (call core-graphics-stroke-joins-work))
  (header (call test "SVGCanvas Affine Transform"))
  (tuple true (call svg-canvas-transform-works))
  (header (call test "CoreGraphics Affine Composition"))
  (tuple true (call core-graphics-transform-composition-works))
  (header (call test "CoreGraphics Affine State"))
  (tuple true (call core-graphics-transform-state-works))
  (header (call test "CoreGraphics Affine Clip and Text"))
  (tuple true (call core-graphics-transform-clipping-and-text-work))
  (header (call test "CoreGraphics Affine Erase"))
  (tuple true (call core-graphics-transform-erase-works))
  (header (call test "CoreGraphics Fill Rules"))
  (tuple true (call core-graphics-fill-rules-work))
  (tuple true (call core-graphics-fill-rule-strokes-work))
)

(fn-do + core-graphics-image-draw-works Bool
  (let passed false)
  (let source (call RasterCanvas 12 10))
  (do-use source
    (= (. source fill-color) red)
    (call (. source rect) (call Rect 1 2 4 3))
    (blank)
    (let destination (call RasterCanvas 36 24))
    (do-use destination
      (call (. destination draw-image) source (call Rect 2 3 12 10))
      (= passed (> (call (. destination nontransparent-pixel-count) (call Rect 3 5 4 3)) 0))
      (= passed (and passed (== (call (. destination nontransparent-pixel-count) (call Rect 3 10 4 2)) 0)))
      (blank)
      (= (. source fill-color) blue)
      (call (. source rect) (call Rect 8 6 3 2))
      (call (. destination draw-image) source (call Rect 18 3 12 10))
      (= passed (and passed (> (call (. destination nontransparent-pixel-count) (call Rect 26 9 3 2)) 0)))
      (= passed (and passed (== (call (. destination nontransparent-pixel-count) (call Rect 10 9 3 2)) 0)))
    )
  )
  (blank)
  (return passed)
)

(fn-do + core-graphics-outline-arrow-works _
  (let canvas (call RasterCanvas 40 40 1))
  (do-use canvas
    (= (. canvas fill-color) red)
    (call (. canvas outline) (call Outline (call Rect 10 10 20 12) 3 (call OutlineArrow (. Side top) 12 5)))
    (let passed (> (call (. canvas nontransparent-pixel-count) (call Rect 21 6 2 4)) 0))
    (= passed (and passed (== (call (. canvas nontransparent-pixel-count) (call Rect 10 5 5 5)) 0)))
    (= passed (and passed (== (call (. canvas nontransparent-pixel-count) (call Rect 10 22 20 8)) 0)))
    (return passed)
  )
)

(fn-do + core-graphics-hard-shadow-works _
  (let canvas (call RasterCanvas 40 40 1))
  (do-use canvas
    (call (. canvas shadow) (call Outline (call Rect 10 10 10 10)) (call Shadow black 0 5 5))
    (let passed (== (call (. canvas nontransparent-pixel-count) (call Rect 21 21 3 3)) 9))
    (= passed (and passed (== (call (. canvas nontransparent-pixel-count) (call Rect 10 10 10 10)) 0)))
    (= passed (and passed (== (call (. canvas nontransparent-pixel-count) (call Rect 0 0 40 10)) 0)))
    (return passed)
  )
)

(fn-do + core-graphics-shadow-offset-uses-points _
  (let canvas (call RasterCanvas 40 40 2))
  (do-use canvas
    (call (. canvas shadow) (call Outline (call Rect 10 10 10 10)) (call Shadow black 0 6 0))
    (let passed (> (call (. canvas nontransparent-pixel-count) (call Rect 21 12 4 6)) 0))
    (= passed (and passed (== (call (. canvas nontransparent-pixel-count) (call Rect 2 10 7 10)) 0)))
    (= passed (and passed (== (call (. canvas nontransparent-pixel-count) (call Rect 27 10 6 10)) 0)))
    (return passed)
  )
)

(fn-do + core-graphics-nested-opacity-difference U64
  (let nested (call RasterCanvas 90 64 2))
  (let quarter (call RasterCanvas 90 64 2))
  (do-use nested
    (do-use quarter
      (call (. nested push))
      (call (. nested begin-opacity) 0.5%%)
      (call (. nested push))
      (call (. nested begin-opacity) 0.5%%)
      (= (. nested fill-color) red)
      (= (. nested stroke-color) null)
      (call (. nested rect) (call Rect 10 10 40 30))
      (call (. nested end-opacity))
      (call (. nested pop))
      (call (. nested end-opacity))
      (call (. nested pop))
      (blank)
      (call (. quarter push))
      (call (. quarter begin-opacity) 0.25%%)
      (= (. quarter fill-color) red)
      (= (. quarter stroke-color) null)
      (call (. quarter rect) (call Rect 10 10 40 30))
      (call (. quarter end-opacity))
      (call (. quarter pop))
      (return (call (. nested pixel-difference-count) quarter))
    )
  )
)

(fn-do + core-graphics-stroke-caps-work Bool
  (let butt (call core-graphics-cap-endpoint-pixels (. LineCap butt)))
  (let round (call core-graphics-cap-endpoint-pixels (. LineCap round)))
  (let square (call core-graphics-cap-endpoint-pixels (. LineCap square)))
  (let passed (== butt 0))
  (= passed (and passed (> round butt)))
  (= passed (and passed (> square round)))
  (return passed)
)

(fn-do _ core-graphics-cap-endpoint-pixels U64
  (param cap LineCap)
  (let canvas (call RasterCanvas 60 40 1))
  (do-use canvas
    (= (. canvas stroke-color) black)
    (= (. canvas stroke-width) 10)
    (= (. canvas stroke-cap) cap)
    (call (. canvas line) 20 20 40 20)
    (return (call (. canvas nontransparent-pixel-count) (call Rect 14 14 6 12)))
  )
)

(fn-do + core-graphics-stroke-joins-work Bool
  (let bevel (call core-graphics-join-pixels (. LineJoin bevel)))
  (let round (call core-graphics-join-pixels (. LineJoin round)))
  (let miter (call core-graphics-join-pixels (. LineJoin miter)))
  (let passed (> miter round))
  (= passed (and passed (> round bevel)))
  (return passed)
)

(fn-do _ core-graphics-join-pixels U64
  (param join LineJoin)
  (let canvas (call RasterCanvas 60 60 1))
  (do-use canvas
    (= (. canvas stroke-color) black)
    (= (. canvas stroke-width) 12)
    (= (. canvas stroke-join) join)
    (call (. canvas begin))
    (call (. canvas move) 15 45)
    (call (. canvas line) 40 45)
    (call (. canvas line) 40 20)
    (call (. canvas end))
    (return (call (. canvas nontransparent-pixel-count) (call Rect 0 0 60 60)))
  )
)

(fn-do + svg-canvas-transform-works Bool
  (let path "/private/tmp/brix-svg-canvas-transform.svg")
  (let canvas (call SVGCanvas 100 80))
  (= (. canvas fill-color) black)
  (call (. canvas translate) 10 2)
  (call (. canvas transform) (call matrix-from-scale (call Dimensions 2 3)))
  (call (. canvas circle) 4 4 2)
  (call (. canvas write) path)
  (blank)
  (let file (call File path (. FileFlags read-mode)))
  (let svg (as file String))
  (call (. file close))
  (blank)
  (let scale-style "transform=\"matrix(2 0 0 3")
  (+= scale-style " 10 2)\"")
  (let passed (if-expr (call (. svg find) scale-style) true false))
  (return passed)
)

(fn-do + core-graphics-transform-composition-works Bool
  (let canvas (call RasterCanvas 80 60 1))
  (do-use canvas
    (= (. canvas fill-color) black)
    (call (. canvas transform) (call matrix-from-translation (tuple 20 5)))
    (call (. canvas transform) (call matrix-from-scale (call Dimensions 2 3)))
    (call (. canvas rect) (call Rect 1 1 5 4))
    (let passed (> (call (. canvas nontransparent-pixel-count) (call Rect 22 8 10 12)) 0))
    (= passed (and passed (== (call (. canvas nontransparent-pixel-count) (call Rect 0 0 20 60)) 0)))
    (= passed (and passed (== (call (. canvas nontransparent-pixel-count) (call Rect 40 10 20 20)) 0)))
    (return passed)
  )
)

(fn-do + core-graphics-transform-state-works Bool
  (let canvas (call RasterCanvas 70 55 1))
  (do-use canvas
    (= (. canvas fill-color) black)
    (call (. canvas translate) 25 0)
    (call (. canvas push))
    (call (. canvas translate) 0 20)
    (call (. canvas rect) (call Rect 0 0 8 8))
    (call (. canvas pop))
    (call (. canvas rect) (call Rect 0 0 8 8))
    (call (. canvas pop))
    (= (. canvas fill-color) black)
    (call (. canvas rect) (call Rect 0 0 8 8))
    (let passed (> (call (. canvas nontransparent-pixel-count) (call Rect 25 20 8 8)) 0))
    (= passed (and passed (> (call (. canvas nontransparent-pixel-count) (call Rect 25 0 8 8)) 0)))
    (= passed (and passed (> (call (. canvas nontransparent-pixel-count) (call Rect 0 0 8 8)) 0)))
    (return passed)
  )
)

(fn-do + core-graphics-transform-clipping-and-text-work Bool
  (let passed false)
  (let canvas (call RasterCanvas 100 55 1))
  (do-use canvas
    (= (. canvas fill-color) black)
    (call (. canvas translate) 20 0)
    (call (. canvas clip) (call Rect 0 0 10 10))
    (call (. canvas rect) (call Rect 0 0 20 20))
    (= passed (> (call (. canvas nontransparent-pixel-count) (call Rect 20 0 10 10)) 0))
    (= passed (and passed (== (call (. canvas nontransparent-pixel-count) (call Rect 30 0 10 10)) 0)))
  )
  (blank)
  (let text-canvas (call RasterCanvas 100 40 1))
  (do-use text-canvas
    (= (. text-canvas text-color) black)
    (call (. text-canvas translate) 40 0)
    (let layout (call (. text-canvas text-layout) "Brix" 40 (. TextOverflow clip)))
    (do-use layout
      (call (. text-canvas draw-text) layout (call Rect 0 5 40 24))
      (= passed (and passed (== (call (. text-canvas nontransparent-pixel-count) (call Rect 0 0 39 40)) 0)))
      (= passed (and passed (> (call (. text-canvas nontransparent-pixel-count) (call Rect 40 0 40 40)) 0)))
    )
  )
  (return passed)
)

(fn-do + core-graphics-transform-erase-works Bool
  (let canvas (call RasterCanvas 30 20 2))
  (do-use canvas
    (call (. canvas erase) red)
    (call (. canvas transform) (call Matrix 0 0 0 0 17 19))
    (call (. canvas erase) null)
    (let passed (== (call (. canvas nontransparent-pixel-count) (call Rect 0 0 30 20)) 0))
    (call (. canvas erase) blue)
    (= passed (and passed (== (call (. canvas nontransparent-pixel-count) (call Rect 0 0 30 20)) 2400)))
    (return passed)
  )
)

(fn-do + core-graphics-fill-rules-work Bool
  (let path (call nested-contours false))
  (blank)
  (let nonzero-center U64)
  (let nonzero-ring U64)
  (let nonzero (call RasterCanvas 50 50 1))
  (do-use nonzero
    (= (. nonzero fill-color) black)
    (call (. path outline) nonzero)
    (= nonzero-center (call (. nonzero nontransparent-pixel-count) (call Rect 16 16 8 8)))
    (= nonzero-ring (call (. nonzero nontransparent-pixel-count) (call Rect 6 6 4 4)))
  )
  (blank)
  (let even-odd-center U64)
  (let even-odd-ring U64)
  (let even-odd (call RasterCanvas 50 50 1))
  (do-use even-odd
    (= (. even-odd fill-color) black)
    (call (. path outline) even-odd (. FillRule even-odd))
    (= even-odd-center (call (. even-odd nontransparent-pixel-count) (call Rect 16 16 8 8)))
    (= even-odd-ring (call (. even-odd nontransparent-pixel-count) (call Rect 6 6 4 4)))
  )
  (blank)
  (let opposite-center U64)
  (let opposite (call RasterCanvas 50 50 1))
  (do-use opposite
    (= (. opposite fill-color) black)
    (call (. (call nested-contours true) outline) opposite (. FillRule nonzero))
    (= opposite-center (call (. opposite nontransparent-pixel-count) (call Rect 16 16 8 8)))
  )
  (blank)
  (let passed (> nonzero-center 0))
  (= passed (and passed (> nonzero-ring 0)))
  (= passed (and passed (== even-odd-center 0)))
  (= passed (and passed (> even-odd-ring 0)))
  (= passed (and passed (== opposite-center 0)))
  (return passed)
)

(fn-do + core-graphics-fill-rule-strokes-work Bool
  (let canvas (call RasterCanvas 50 50 1))
  (do-use canvas
    (= (. canvas fill-color) black)
    (= (. canvas stroke-color) blue)
    (= (. canvas stroke-width) 2)
    (call (. (call nested-contours false) outline) canvas (. FillRule even-odd))
    (let passed (== (call (. canvas nontransparent-pixel-count) (call Rect 16 16 8 8)) 0))
    (= passed (and passed (> (call (. canvas nontransparent-pixel-count) (call Rect 11 16 3 8)) 0)))
    (= passed (and passed (> (call (. canvas nontransparent-pixel-count) (call Rect 4 16 3 8)) 0)))
    (return passed)
  )
)

(fn-do + nested-contours Path
  (param reverse-inner Bool)
  (let path (call Path))
  (call (. path add-path) (call rectangle (call Rect 5 5 30 30)))
  (let inner (call rectangle (call Rect 12 12 16 16)))
  (call (. path add-path) (if-expr reverse-inner (call (. inner reverse)) inner))
  (return path)
)
