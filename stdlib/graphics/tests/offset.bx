(import /graphics/graphic)
(import /graphics/offset)
(import /graphics/path)
(import /graphics/path-set)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/stroke)
(import /graphics/tests/support/geometry)
(import /graphics/tests/support/offset-fidelity)
(import /math)
(import /test)
(import /units)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Offset Topology Cleanup"))
  (tuple true (call rotated-rect-inner-offset-is-single-inset))
  (tuple true (call reversed-rotated-rect-inner-offset-is-single-inset))
  (tuple true (call self-crossing-offset-cleans-to-closed-contour))
  (tuple true (call self-crossing-inner-offset-splits-lobes))
  (tuple true (call convex-inset-drops-vanished-edge))
  (tuple true (call crossing-curve-offset-splits-lobes))
  (tuple 0 (call thin-crescent-miter-inset-count))
  (header (call test "Offset Trim Fidelity"))
  (tuple "1 open; faithful" (call offset-report (call pen-path) 30))
  (tuple "1 open; faithful" (call offset-report (call pen-path) 33))
  (tuple "1 open; faithful" (call offset-report (call pen-path) 60))
  (tuple "1 open; faithful" (call offset-report (call pen-path) 69))
  (tuple "1 open; faithful" (call offset-report (call pen-path) 92))
  (tuple "1 open; faithful" (call offset-report (call pen-path) 150))
  (tuple "1 open; faithful" (call offset-report (call pen-path) -33))
  (tuple "1 open; faithful" (call offset-report (call pen-path) -92))
  (tuple "1 open; faithful" (call offset-report (call inflection-cubic) 3))
  (tuple "1 open; faithful" (call offset-report (call open-cubic-snake-path) -8))
  (tuple "faithful" (call offset-fidelity (call open-cubic-snake-path) 12))
  (tuple "1 open; faithful" (call offset-report (call open-close-pass-path) -6))
  (tuple "faithful" (call offset-fidelity (call open-close-pass-path) 12))
  (tuple "faithful" (call offset-fidelity (call concave-path) 8))
  (tuple "faithful" (call offset-fidelity (call concave-path) -3))
  (tuple "faithful" (call offset-fidelity (call petal-loop-path) -8))
  (tuple "faithful" (call offset-fidelity (call petal-loop-path) 12))
  (tuple true (call hooked-cubic-offset-ignores-hook))
  (tuple "faithful" (call offset-fidelity (call tilted-line-shape (tuple 125 124) 84) 20.25))
  (tuple "faithful" (call offset-fidelity (call tilted-line-shape (tuple 125 124) 84) -20.5))
  (tuple "faithful" (call offset-fidelity (call zigzag-shape (tuple 125 124) 84) 20.25))
  (tuple "faithful" (call offset-fidelity (call zigzag-shape (tuple 125 124) 84) -20.5))
  (tuple "faithful" (call offset-fidelity (call spiral-shape (tuple 125 124) 84) 20.25))
  (tuple "faithful" (call offset-fidelity (call spiral-shape (tuple 125 124) 84) -20.5))
  (tuple "faithful" (call offset-fidelity (call open-wave-shape (tuple 125 124) 84) 20.25))
  (tuple "faithful" (call offset-fidelity (call open-wave-shape (tuple 125 124) 84) -20.5))
  (tuple "faithful" (call offset-fidelity (call hairpin-shape (tuple 125 124) 84) 20.25))
  (tuple "faithful" (call offset-fidelity (call hairpin-shape (tuple 125 124) 84) -20.5))
  (tuple "faithful" (call offset-fidelity (call cusp-sweep-shape (tuple 125 124) 84) 20.25))
  (tuple "faithful" (call offset-fidelity (call cusp-sweep-shape (tuple 125 124) 84) -20.5))
  (tuple "faithful" (call offset-fidelity (call tilted-rect-shape (tuple 125 124) 84) 20.25))
  (tuple "faithful" (call offset-fidelity (call tilted-rect-shape (tuple 125 124) 84) -20.5))
  (tuple "faithful" (call offset-fidelity (call triangle-shape (tuple 125 124) 84) 20.25))
  (tuple "faithful" (call offset-fidelity (call triangle-shape (tuple 125 124) 84) -20.5))
  (tuple "faithful" (call offset-fidelity (call circle (tuple 125 124) 58.8) 20.25))
  (tuple "faithful" (call offset-fidelity (call circle (tuple 125 124) 58.8) -20.5))
  (tuple "faithful" (call offset-fidelity (call pentagon-shape (tuple 125 124) 84) 20.25))
  (tuple "faithful" (call offset-fidelity (call pentagon-shape (tuple 125 124) 84) -20.5))
  (tuple "faithful" (call offset-fidelity (call rosette-shape (tuple 125 124) 84) 20.25))
  (tuple "faithful" (call offset-fidelity (call rosette-shape (tuple 125 124) 84) -20.5))
)

(fn-expr + rotated-rect-inner-offset-is-single-inset _
  (and one-contour (call (. path contains) (tuple 0 0)) (call near 476 (call path-area path) 0.001))
  (where
    (lazy path ([] (. (call offset-path (call PathSet (list (call rotated-rect-path))) -3 .miter-join-type 5) paths) 0))
    (lazy one-contour (and (. path is-closed) (== (call path-subpath-count path) 1)))
  )
)

(fn-expr + reversed-rotated-rect-inner-offset-is-single-inset _
  (and one-contour (call (. path contains) (tuple 0 0)) (call near 476 (call path-area path) 0.001))
  (where
    (lazy path ([] (. (call offset-path (call PathSet (list (call (. (call rotated-rect-path) reverse)))) -3 .miter-join-type 5) paths) 0))
    (lazy one-contour (and (. path is-closed) (== (call path-subpath-count path) 1)))
  )
)

(fn-expr + self-crossing-offset-cleans-to-closed-contour _
  (and two-contours square-bounds (call (. path contains) (tuple 0 18)) (not (call (. path contains) (tuple -18 0))))
  (where
    (lazy path ([] (. (call offset-path (call PathSet (list (call bowtie-path))) 5 .round-join-type) paths) 0))
    (lazy two-contours (and (. path is-closed) (== (call path-subpath-count path) 2)))
    (lazy square-bounds (call near-rect (call Rect -25 -25 50 50) (. path bounding-box) 0.01))
  )
)

(fn-expr + self-crossing-inner-offset-splits-lobes _
  (and two-lobes (call (. path contains) (tuple 0 10)) (not (call (. path contains) (tuple 0 0))) (not (call (. path contains) (tuple -18 0))))
  (where
    (lazy path ([] (. (call offset-path (call PathSet (list (call bowtie-path))) -5 .square-join-type 5) paths) 0))
    (lazy two-lobes (and (. path is-closed) (== (call path-subpath-count path) 2) (== (. path count) 8)))
  )
)

(fn-expr + convex-inset-drops-vanished-edge _
  (and (. path is-closed) (== (. path count) 4) (call near 106.98 (call path-area path) 0.01))
  (where
    (lazy path ([] (. (call offset-path (call PathSet (list (call trapezoid-path))) -4 .miter-join-type 5) paths) 0))
  )
)

(fn-expr + crossing-curve-offset-splits-lobes _
  (and (. path is-closed) (== (call path-subpath-count path) 2) lobes (not (call (. path contains) (tuple 0 14))))
  (where
    (lazy path ([] (. (call offset-path (call PathSet (list (call curved-eight-path))) 3 .round-join-type) paths) 0))
    (lazy lobes (and (call (. path contains) (tuple -14 -6)) (call (. path contains) (tuple 14 6))))
  )
)

(fn-expr + thin-crescent-miter-inset-count _
  (. (call offset-path (call PathSet (list (call thin-crescent-path))) -5.5 .miter-join-type 5) paths length)
)

(fn-expr + offset-report _
  (param source Path)
  (param distance Length)
  (str (call path-subpath-count path) " " shape "; " (call offset-fidelity source distance))
  (where
    (lazy path (call round-offset source distance))
    (lazy shape (if-expr (. path is-closed) "closed" "open"))
  )
)

(fn-expr + hooked-cubic-offset-ignores-hook _
  (and (not (. path is-closed)) (== (call path-subpath-count path) 1) (< deviation 0.5) (> (. path bounding-box x) -4))
  (where
    (lazy source (call hooked-cubic-path))
    (lazy path (call round-offset source 6))
    (lazy deviation (call offset-deviation (call path-segments source 48) path 6))
  )
)

(fn-do _ pen-path _
  (let path (call Path))
  (call (. path move-to) 270.109375 434.6484375)
  (call (. path line-to) 332.25390625 290.6171875)
  (call (. path cubic-curve-to)
    (block
      (arg 410.17578125)
      (arg 284.64453125)
      (arg 385.37890625)
      (arg 343.42578125)
      (arg 438.46484375)
      (arg 381.98046875)
    )
  )
  (call (. path cubic-curve-to) 491.55078125 420.53515625 482.95703125 337.515625 515.8125 312.0546875)
  (call (. path cubic-curve-to) 548.66796875 286.59375 608.37890625 226.2421875 631.8515625 282.28125)
  (call (. path cubic-curve-to) 655.32421875 338.3203125 695.5078125 388.12109375 695.5078125 388.12109375)
  (call (. path line-to) 764.36328125 179.45703125)
  (call (. path line-to) 816.91796875 391.44140625)
  (return path)
)

(fn-do _ trapezoid-path _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 40 0)
  (call (. path line-to) 21 19)
  (call (. path line-to) 19 19)
  (call (. path close))
  (return path)
)

(fn-do _ curved-eight-path _
  (let path (call Path))
  (call (. path move-to) -20 0)
  (call (. path cubic-curve-to) -20 -30 20 30 20 0)
  (call (. path cubic-curve-to) 20 -30 -20 30 -20 0)
  (call (. path close))
  (return path)
)

(fn-do _ thin-crescent-path _
  (let path (call Path))
  (call (. path move-to) 23.4 27.7)
  (call (. path line-to) 24.1 19.6)
  (call (. path line-to) 17.9 5.1)
  (call (. path line-to) 4.2 0)
  (call (. path line-to) 0 1.1)
  (call (. path line-to) 11.7 2.8)
  (call (. path line-to) 21.9 15.1)
  (call (. path close))
  (return path)
)

(fn-do _ hooked-cubic-path _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path cubic-curve-to) -0.3 0.3 60 -40 100 0)
  (return path)
)

(fn-do _ inflection-cubic _
  (let path (call Path))
  (call (. path move-to) -10 0)
  (call (. path cubic-curve-to) -5 20 5 -20 10 0)
  (return path)
)

(fn-do _ open-cubic-snake-path _
  (let radius 50)
  (let path (call Path))
  (call (. path move-to) (* (- radius) 0.86) (* radius 0.34))
  (call (. path cubic-curve-to)
    (block
      (arg (* (- radius) 0.65))
      (arg (* (- radius) 0.85))
      (arg (* (- radius) 0.18))
      (arg (* radius 0.82))
      (arg (* radius 0.06))
      (arg (* (- radius) 0.08))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (* radius 0.34))
      (arg (* (- radius) 1.04))
      (arg (* radius 0.76))
      (arg (* radius 0.74))
      (arg (* radius 0.88))
      (arg (* (- radius) 0.24))
    )
  )
  (return path)
)

(fn-do _ open-close-pass-path _
  (let radius 50)
  (let path (call Path))
  (call (. path move-to) (* (- radius) 0.82) (* (- radius) 0.5))
  (call (. path cubic-curve-to)
    (block
      (arg (* (- radius) 0.2))
      (arg (* (- radius) 1.0))
      (arg (* radius 0.55))
      (arg (* (- radius) 0.88))
      (arg (* radius 0.68))
      (arg (* (- radius) 0.18))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (* radius 0.82))
      (arg (* radius 0.6))
      (arg (* (- radius) 0.48))
      (arg (* radius 0.58))
      (arg (* (- radius) 0.58))
      (arg (* (- radius) 0.12))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (* (- radius) 0.56))
      (arg (* (- radius) 0.42))
      (arg (* (- radius) 0.18))
      (arg (* (- radius) 0.28))
      (arg (* radius 0.12))
      (arg (* radius 0.12))
    )
  )
  (return path)
)

(fn-do _ rotated-rect-path _
  (let path (call rectangle (call Rect -20 -10 40 20)))
  (call (. path rotate) 15deg (call Point 0 0))
  (return path)
)

(fn-do _ bowtie-path _
  (let path (call Path))
  (call (. path move-to) -20 -20)
  (call (. path line-to) 20 20)
  (call (. path line-to) -20 20)
  (call (. path line-to) 20 -20)
  (call (. path close))
  (return path)
)

(fn-do _ concave-path _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 40 0)
  (call (. path line-to) 40 20)
  (call (. path line-to) 20 8)
  (call (. path line-to) 0 20)
  (call (. path close))
  (return path)
)

(fn-do _ petal-loop-path _
  (let radius 50)
  (let path (call Path))
  (call (. path move-to) 0 (* (- radius) 0.9))
  (call (. path cubic-curve-to)
    (block
      (arg (* radius 1.25))
      (arg (* (- radius) 0.72))
      (arg (* radius 0.35))
      (arg (* radius 0.28))
      (arg (* radius 0.78))
      (arg (* radius 0.72))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (* radius 0.18))
      (arg (* radius 1.08))
      (arg (* (- radius) 0.4))
      (arg (* radius 0.34))
      (arg (* (- radius) 0.82))
      (arg (* radius 0.66))
    )
  )
  (call (. path cubic-curve-to) (* (- radius) 1.22) (* radius 0.08) (* (- radius) 0.55) (* (- radius) 0.72) 0 (* (- radius) 0.9))
  (call (. path close))
  (return path)
)

(fn-do _ path-subpath-count _
  (param path Path)
  (let count 0)
  (for (in subpath (. path subpaths))
    (+= count 1)
  )
  (return count)
)
