━━━━━━━━━━━━━━━━━━━━
_ do swerve

. path = Path()
path.move-to(0, 0)
path.cubic-curve-to(120, 0, -40, 60, 80, 40)
= path

━━━━━━━━━━━━━━━━━━━━
_ do nearest-agrees
    - path Path
    - spot Point

. found = path-nearest(path, spot)
=? false if !found
. least = 100000000.0
. along = found.point
. index Index = 0
for curve in path.curves
    for step in 0 .. 4000
        least = min(least, network-curve-point(curve, (step as Float) / 4000).distance(spot))
    if found.parameter >= (index as Float) && found.parameter <= (index as Float) + 1
        along = network-curve-point(curve, found.parameter - (index as Float))
    index += 1
. slack = max(0.0005, least * 0.000002)
|? abs(found.distance - least) > slack
    = false
|? abs(found.point.distance(spot) - found.distance) > slack
    = false
??
    = along.distance(found.point) < 0.001

━━━━━━━━━━━━━━━━━━━━
_ crossings-ascend
    - crossings [PathCrossing]

crossings.length == 2 && crossings[0].along < crossings[1].along
