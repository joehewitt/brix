(import /graphics/appearance)
(import /graphics/boolean)
(import /graphics/color)
(import /graphics/document)
(import /graphics/document-paths)
(import /graphics/document-rows)
(import /graphics/effect)
(import /graphics/matrix)
(import /graphics/network)
(import /graphics/network-graphic)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/style)
(import /stream/aggregate)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Vector Document Tree"))
  (call (. cases run) tree-tests)
  (= cases (call (. cases then) "Vector Document Cursor Traversal" traversal-tests))
  (= cases (call (. cases then) "Vector Document Id Map Growth" id-map-growth-tests))
  (= cases (call (. cases then) "Vector Document Id Map Deletes" id-map-delete-tests))
  (= cases (call (. cases then) "Vector Document Stamp Preservation" stamp-tests))
  (= cases (call (. cases then) "Vector Document Subtree Stamps" subtree-stamp-tests))
  (= cases (call (. cases then) "Vector Document Compaction" compaction-tests))
  (= cases (call (. cases then) "Vector Document Snapshots" snapshot-tests))
  (= cases (call (. cases then) "Vector Document Change Tracking" change-tests))
  (= cases (call (. cases then) "Vector Document Subtree Copies" copy-tests))
  (= cases (call (. cases then) "Vector Document Region Fill Remapping" region-remap-tests))
  (= cases (call (. cases then) "Vector Document Region Fill Merges" region-merge-tests))
  (= cases (call (. cases then) "Vector Document Region Fill Openings" region-open-tests))
  (= cases (call (. cases then) "Vector Document Resolved Appearance" appearance-tests))
  (= cases (call (. cases then) "Vector Document Paths" paths-tests))
  (= cases (call (. cases then) "Vector Document Content Restore" content-restore-tests))
  (= cases (call (. cases then) "Vector Document Values" value-tests))
  (= cases (call (. cases then) "Vector Document World Transforms" world-transform-tests))
  (= cases (call (. cases then) "Vector Document World Networks" world-network-tests))
  (return cases)
)

(fn-do + tree-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let root (. doc root))
  (let layer (call (. doc create-group) root "Layer"))
  (let first (call (. doc add-path) layer (call rectangle (call Rect 0 0 10 10)) "First"))
  (let second (call (. doc add-path) layer (call rectangle (call Rect 20 0 10 10)) "Second"))
  (let third (call (. doc add-path) layer (call rectangle (call Rect 40 0 10 10)) "Third" 0))
  (call (. t expect) "children keep insertion order" (list first second third) (call List (call (. doc children) layer)))
  (call (. doc move) third layer first)
  (call (. t expect)
    (block
      (arg "move before an anchor reorders siblings")
      (arg (list third first second))
      (arg (call List (call (. doc children) layer)))
    )
  )
  (call (. doc move) third root)
  (call (. t expect) "move appends to a new parent" (list layer third) (call List (call (. doc children) root)))
  (call (. t expect) "descendants walk the subtree" (list layer first second third) (call List (call (. doc descendants) root)))
  (let script (call (. doc create-group) root "Script" 0 layer))
  (call (. t expect) "insertion before an anchor" (list script layer third) (call List (call (. doc children) root)))
  (call (. doc delete) layer)
  (call (. t expect) "delete removes the subtree" (list script third) (call List (call (. doc children) root)))
  (call (. t check) "deleted descendants leave the id map" (not (call (. doc contains) first)))
  (call (. t check) "every deleted descendant leaves the id map" (not (call (. doc contains) second)))
  (return t)
)

(fn-do + id-map-growth-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let first (call (. doc add-path) (. doc root) (call rectangle (call Rect 0 0 1 1))))
  (call (. doc delete) first)
  (call (. doc add-path) (. doc root) (call rectangle (call Rect 0 0 1 1)) "Again" first)
  (let script-id (call vector-document-loop-id 7 (list 1)))
  (call (. doc add-path) (. doc root) (call rectangle (call Rect 0 0 1 1)) "" script-id)
  (for (in index (..< 0 200))
    (call (. doc add-path) (. doc root) (call rectangle (call Rect (as index Coord) 0 1 1)))
  )
  (call (. t expect) "the id map grows" "Again" (call (. doc name) first))
  (call (. t check) "script ids survive id map growth" (call (. doc contains) script-id))
  (return t)
)

(fn-do + id-map-delete-tests _
  (param t TestCase)
  (let grown (use (call VectorDocument)))
  (let created (list U64))
  (for (in index (..< 0 40))
    (+= created (call (. grown add-path) (. grown root) (call rectangle (call Rect (as index Coord) 0 4 4))))
  )
  (for (in id created)
    (call (. grown delete) id)
  )
  (let leftover (call some created (:where (call (. grown contains) each))))
  (call (. t check) "ids placed while the id map grows are removed on delete" (not leftover))
  (for (in id created)
    (call (. grown add-path) (. grown root) (call rectangle (call Rect 0 0 4 4)) "" id)
  )
  (call (. t expect) "deleted ids can be reused after the id map grows" 40 (call (. grown child-count) (. grown root)))
  (return t)
)

(fn-do + stamp-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let shape (call (. doc add-path) (. doc root) (call rectangle (call Rect 0 0 10 10)) "Shape"))
  (let stamp (call (. doc stamp) shape))
  (let geometry (call (. doc geometry-stamp) shape))
  (call (. doc set-name) shape "Shape")
  (call (. t expect) "identical names keep the stamp" stamp (call (. doc stamp) shape))
  (call (. doc set-network) shape (call (. doc network) shape))
  (call (. t expect) "identical geometry keeps the stamp" stamp (call (. doc stamp) shape))
  (call (. doc set-opacity) shape 0.5)
  (let faded (call (. doc stamp) shape))
  (call (. t check) "opacity advances the stamp" (!= faded stamp))
  (call (. t expect) "opacity keeps the geometry stamp" geometry (call (. doc geometry-stamp) shape))
  (call (. doc set-opacity) shape 0.5)
  (call (. t expect) "repeated opacity keeps the stamp" faded (call (. doc stamp) shape))
  (let paint (call (. doc paint-stamp) shape))
  (call (. doc set-fill) shape (as "#ff0000" RGBA))
  (call (. t check) "fill advances the paint stamp" (!= (call (. doc paint-stamp) shape) paint))
  (call (. t expect) "fill keeps the geometry stamp" geometry (call (. doc geometry-stamp) shape))
  (let filled (call (. doc stamp) shape))
  (call (. doc set-fill) shape (as "#ff0000" RGBA))
  (call (. t expect) "identical fill keeps the stamp" filled (call (. doc stamp) shape))
  (let filled-paint (call (. doc paint-stamp) shape))
  (call (. doc set-transform) shape (call matrix-from-translation (tuple 3 4)))
  (call (. t expect) "transform keeps the paint stamp" filled-paint (call (. doc paint-stamp) shape))
  (call (. t expect) "transform keeps the geometry stamp" geometry (call (. doc geometry-stamp) shape))
  (let moved (call (. doc network) shape))
  (call (. moved move-vertex) 1 (tuple 1 1))
  (call (. doc set-network) shape moved)
  (call (. t check) "geometry edits advance the geometry stamp" (!= (call (. doc geometry-stamp) shape) geometry))
  (let root-stamp (call (. doc stamp) (. doc root)))
  (call (. doc add-path) (. doc root) (call rectangle (call Rect 0 0 1 1)))
  (call (. t check) "structure edits advance the parent stamp" (!= (call (. doc stamp) (. doc root)) root-stamp))
  (let other (use (call VectorDocument)))
  (let twin (call (. other add-path) (. other root) (call rectangle (call Rect 0 0 10 10)) "Shape"))
  (let fresh (call (. doc add-path) (. doc root) (call rectangle (call Rect 0 0 10 10)) "Shape"))
  (call (. t expect)
    (block
      (arg "identical content in another document stamps identically")
      (arg (call (. doc geometry-stamp) fresh))
      (arg (call (. other geometry-stamp) twin))
    )
  )
  (return t)
)

(fn-do + subtree-stamp-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let outer (call (. doc create-group) (. doc root) "Outer"))
  (let inner (call (. doc create-group) outer "Inner"))
  (let deep (call (. doc add-path) inner (call rectangle (call Rect 0 0 10 10)) "Deep"))
  (let sibling (call (. doc add-path) (. doc root) (call rectangle (call Rect 20 0 10 10)) "Sibling"))
  (call (. t expect) "a leaf's subtree stamp is its stamp" (call (. doc stamp) deep) (call (. doc subtree-stamp) deep))
  (let outer-stamp (call (. doc stamp) outer))
  (let subtree (call (. doc subtree-stamp) outer))
  (call (. doc set-name) deep "Renamed")
  (call (. t expect) "a deep edit keeps the group's own stamp" outer-stamp (call (. doc stamp) outer))
  (call (. t check) "a deep edit changes the group's subtree stamp" (!= (call (. doc subtree-stamp) outer) subtree))
  (call (. doc set-name) deep "Deep")
  (call (. t expect) "equal content restores the subtree stamp" subtree (call (. doc subtree-stamp) outer))
  (call (. doc set-name) sibling "Renamed")
  (call (. t expect) "edits outside the subtree keep its stamp" subtree (call (. doc subtree-stamp) outer))
  (let snapshot (use (call (. doc snapshot))))
  (call (. doc delete) deep)
  (call (. t check) "removing a descendant changes the subtree stamp" (!= (call (. doc subtree-stamp) outer) subtree))
  (call (. doc restore) snapshot)
  (call (. t expect) "a restore brings the subtree stamp back" subtree (call (. doc subtree-stamp) outer))
  (return t)
)

(fn-do + compaction-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let keep (list U64))
  (let names (list String))
  (for (in index (..< 0 600))
    (let id
      (call (. doc add-path)
        (block
          (arg (. doc root))
          (arg (call rectangle (call Rect (as index Coord) (as index Coord) 5 5)))
          (arg (str "Shape " index))
        )
      )
    )
    (if (== (% index 3) 0)
      (+= keep id)
      (+= names (str "Shape " index))
    )
  )
  (let row-total (. doc store nodes length))
  (for (in id (call List (call (. doc children) (. doc root))))
    (if (and (!= (call (. doc name) id) "") (not (call (. keep has) id)))
      (call (. doc delete) id)
    )
  )
  (call (. t check) "compaction reclaims node rows" (< (. doc store nodes length) row-total))
  (call (. t expect) "compaction keeps the order" keep (call List (call (. doc children) (. doc root))))
  (call (. t expect) "compaction preserves ids and content" names (call (of List String) (in (call (. doc name) each) keep)))
  (call (. t expect) "compaction preserves geometry" (call Rect 3 3 5 5) (call (. doc geometry-bounds) ([] keep 1)))
  (call (. t expect)
    (block
      (arg "compaction preserves network rows")
      (arg (call Rect 3 3 5 5))
      (arg (. (call (. (call (. doc network) ([] keep 1)) geometry)) bounding-box))
    )
  )
  (let stamp (call (. doc stamp) ([] keep 1)))
  (call (. doc compact))
  (call (. t expect) "explicit compaction keeps stamps" stamp (call (. doc stamp) ([] keep 1)))
  (call (. t expect)
    (block
      (arg "explicit compaction keeps networks")
      (arg (call Rect 3 3 5 5))
      (arg (. (call (. (call (. doc network) ([] keep 1)) geometry)) bounding-box))
    )
  )
  (return t)
)

(fn-do + snapshot-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let layer (call (. doc create-group) (. doc root) "Layer"))
  (let saved (use (call (. doc snapshot))))
  (let added (call (. doc add-path) (. doc root) (call rectangle (call Rect 50 50 5 5))))
  (call (. doc delete) layer)
  (call (. doc restore) saved)
  (call (. t expect) "restore brings back the tree" (list layer) (call List (call (. doc children) (. doc root))))
  (call (. t check) "restore removes later nodes" (not (call (. doc contains) added)))
  (let next (call (. doc add-path) (. doc root) (call rectangle (call Rect 0 0 1 1))))
  (call (. t check) "restore never reissues ids" (> next added))
  (return t)
)

(fn-do + change-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let ids (list U64))
  (for (in index (..< 0 300))
    (+= ids (call (. doc add-path) (. doc root) (call rectangle (call Rect (as index Coord) 0 5 5))))
  )
  (let tracker (call VectorDocumentChangeTracker))
  (let initial (call (. tracker scan) doc))
  (call (. t expect) "the first scan reports every node" 301 (. initial changed length))
  (let quiet (call (. tracker scan) doc))
  (call (. t expect) "an unchanged document reports nothing" 0 (. quiet changed length))
  (let saved (use (call (. doc snapshot))))
  (call (. doc set-opacity) ([] ids 250) 0.5)
  (let edited (call (. tracker scan) doc))
  (call (. t expect) "one edit reports one node" (list ([] ids 250)) (. edited changed))
  (call (. doc delete) ([] ids 10))
  (let deleted (call (. tracker scan) doc))
  (call (. t expect) "deletes report the removed id" (list ([] ids 10)) (. deleted removed))
  (call (. doc restore) saved)
  (let restored (call (. tracker scan) doc))
  (call (. t check) "restores report reverted nodes" (call (. restored changed has) ([] ids 250)))
  (call (. t check) "restores report restored nodes" (call (. restored changed has) ([] ids 10)))
  (return t)
)

(fn-do + copy-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let layer (call (. doc create-group) (. doc root) "Layer"))
  (let first (call (. doc add-path) layer (call rectangle (call Rect 0 0 10 10)) "First"))
  (call (. doc add-path) layer (call rectangle (call Rect 20 0 10 10)) "Second")
  (let copy (call (. doc copy-node) doc layer (. doc root) (list 900u64 901u64)))
  (call (. t expect) "the copy takes the first requested id" 900 copy)
  (let copied (call List (call (. doc children) copy)))
  (call (. t expect) "the copy keeps child order" 2 (. copied length))
  (call (. t expect) "the first child takes the next requested id" 901 ([] copied 0))
  (call (. t expect) "unrequested ids come from the advanced counter" 902 ([] copied 1))
  (call (. t expect) "the copy is appended" (list layer copy) (call List (call (. doc children) (. doc root))))
  (let other (use (call VectorDocument)))
  (let imported (call (. other copy-node) doc first (. other root)))
  (call (. t expect) "copies between documents keep names" "First" (call (. other name) imported))
  (return t)
)

(fn-do + region-remap-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let network (call VectorNetwork))
  (let a (call (. network add-vertex) (tuple 0 0)))
  (let b (call (. network add-vertex) (tuple 100 0)))
  (let c (call (. network add-vertex) (tuple 100 100)))
  (let d (call (. network add-vertex) (tuple 0 100)))
  (call (. network connect) a b)
  (call (. network connect) b c)
  (call (. network connect) c d)
  (call (. network connect) d a)
  (let shape (call (. doc create-network) (. doc root) network "Square"))
  (call (. doc set-region-fills) shape (list (call NetworkRegionAppearance 1 (call RGBA 1 0 0 1))))
  (let moved (call (. doc network) shape))
  (call (. moved move-vertex) c (tuple 120 110))
  (call (. doc set-network) shape moved)
  (let fills (call (. doc region-fills) shape))
  (call (. t expect) "a reshaped region keeps its fill" 1 (. fills length))
  (call (. t expect) "the kept fill uses the fresh region id" 1 (. ([] fills 0) region))
  (call (. t expect) "the kept fill keeps its color" (call RGBA 1 0 0 1) (!! (. ([] fills 0) fill)))
  (let split (call (. doc network) shape))
  (call (. split connect) a c)
  (call (. doc set-network) shape split)
  (let halves (call (. doc region-fills) shape))
  (call (. t expect) "splitting a region yields one fill per half" 2 (. halves length))
  (call (. t expect) "the first half inherits the fill" (call RGBA 1 0 0 1) (!! (. ([] halves 0) fill)))
  (call (. t expect) "the second half inherits the fill" (call RGBA 1 0 0 1) (!! (. ([] halves 1) fill)))
  (call (. t expect) "region ids follow fresh resolution" (list 1 2) (list (. ([] halves 0) region) (. ([] halves 1) region)))
  (let stamp (call (. doc stamp) shape))
  (call (. doc set-network) shape (call (. doc network) shape))
  (call (. t expect) "rewriting identical geometry keeps the stamp" stamp (call (. doc stamp) shape))
  (let plain (call (. doc create-network) (. doc root) network "Plain"))
  (call (. doc set-region-fills) plain (list (call NetworkRegionAppearance 1 null)))
  (call (. doc set-network) plain (call (. doc network) plain))
  (call (. t expect)
    (block
      (arg "unpainted region entries are dropped on geometry writes")
      (arg 0)
      (arg (. (call (. doc region-fills) plain) length))
    )
  )
  (return t)
)

(fn-do + region-merge-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let shape (call (. doc add-path) (. doc root) (call rectangle (call Rect 0 0 100 100)) "Square"))
  (let split (call (. doc network) shape))
  (let divider (call (. split connect) 1 3))
  (call (. doc set-network) shape split)
  (call (. doc set-region-fills)
    (block
      (arg shape)
      (arg (list (call NetworkRegionAppearance 1 (call RGBA 1 0 0 1)) (call NetworkRegionAppearance 2 (call RGBA 0 0 1 1))))
    )
  )
  (let merged (call (. doc network) shape))
  (call (. merged remove-segment) divider)
  (call (. doc set-network) shape merged)
  (let fills (call (. doc region-fills) shape))
  (call (. t expect) "merged regions store one entry" 1 (. fills length))
  (call (. t check) "differently painted regions merge into a conflict" (. ([] fills 0) conflict))
  (call (. t check) "a conflict stores no fill" (== (. ([] fills 0) fill) null))
  (return t)
)

(fn-do + region-open-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let shape (call (. doc add-path) (. doc root) (call rectangle (call Rect 0 0 100 100)) "Square"))
  (call (. doc set-region-fills) shape (list (call NetworkRegionAppearance 1 (call RGBA 1 0 0 1))))
  (let opened (call (. doc network) shape))
  (call (. opened remove-segment) 1)
  (call (. doc set-network) shape opened)
  (call (. t expect) "opening a painted boundary drops its fill" 0 (. (call (. doc region-fills) shape) length))
  (return t)
)

(fn-do + appearance-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (call (. doc set-stroke) (. doc root) (call RGBA 0 0 0 1))
  (call (. doc set-stroke-cap) (. doc root) (. LineCap round))
  (let layer (call (. doc create-group) (. doc root) "Layer"))
  (call (. doc set-fill) layer (call RGBA 0 1 0 1))
  (let shape (call (. doc add-path) layer (call rectangle (call Rect 0 0 10 10)) "Shape"))
  (call (. doc set-stroke-width) shape 4)
  (let appearance (call (. doc resolved-appearance) shape))
  (call (. t expect) "fill inherits from the layer" (call RGBA 0 1 0 1) (as (. appearance fill) RGBA))
  (call (. t expect) "stroke inherits from the root" (call RGBA 0 0 0 1) (as (. appearance stroke) RGBA))
  (call (. t expect) "cap inherits from the root" (. LineCap round) (. appearance stroke-cap))
  (call (. t expect) "own width applies" 4 (. appearance stroke-width))
  (call (. doc set-fill) shape (. Fill none))
  (call (. t expect) "own fill overrides" (. Fill none) (. (call (. doc resolved-appearance) shape) fill))
  (return t)
)

(fn-do + paths-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let layer (call (. doc create-group) (. doc root) "Layer"))
  (let first (call (. doc add-path) layer (call rectangle (call Rect 0 0 10 10)) "First"))
  (call (. doc add-path) layer (call rectangle (call Rect 5 0 10 10)) "Second")
  (let paths (call VectorDocumentPaths doc))
  (call (. t expect) "group paths gather children" 2 (. (call (. paths paths) layer) length))
  (let network (call (. doc network) first))
  (let corner (. ([] (call (of List NetworkVertex) (. network vertices)) 0) id))
  (call (. network move-vertex) corner (tuple -5 -5))
  (call (. doc set-network) first network)
  (call (. t expect)
    (block
      (arg "geometry edits refresh cached networks")
      (arg (call Point -5 -5))
      (arg (. (call (. (call (. paths network) first) vertex) corner) position))
    )
  )
  (call (. doc set-effects) layer (call VectorEffects (list (call BooleanEffect (. BooleanEffectMode union-effect)))))
  (call (. t expect) "group effects combine children" 1 (. (call (. paths paths) layer) length))
  (return t)
)

(fn-do + content-restore-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let layer (call (. doc create-group) (. doc root) "Layer"))
  (let outside (call (. doc add-path) (. doc root) (call rectangle (call Rect 0 0 5 5)) "Outside"))
  (let first (call (. doc add-path) layer (call rectangle (call Rect 0 0 10 10)) "First"))
  (let group (call (. doc create-group) layer "Group"))
  (let nested (call (. doc add-path) group (call rectangle (call Rect 20 0 10 10)) "Nested"))
  (call (. doc set-value) layer "count" (call (. VectorDocumentValue number) 2))
  (call (. doc set-setting) layer "size" (call (. VectorDocumentValue number) 10))
  (let first-stamp (call (. doc stamp) first))
  (let snapshot (use (call (. doc snapshot))))
  (call (. doc delete) first)
  (call (. doc add-path) layer (call rectangle (call Rect 50 50 10 10)) "Later")
  (call (. doc set-name) outside "Renamed")
  (call (. doc set-value) layer "count" (call (. VectorDocumentValue number) 7))
  (call (. doc set-value) layer "extra" (call (. VectorDocumentValue number) 1))
  (call (. doc set-setting) layer "size" (call (. VectorDocumentValue number) 20))
  (call (. doc restore-contents) snapshot layer)
  (call (. t expect) "children come back in order with their ids" (list first group) (call List (call (. doc children) layer)))
  (call (. t expect) "nested children come back" (list nested) (call List (call (. doc children) group)))
  (call (. t expect) "restored children keep their stamps" first-stamp (call (. doc stamp) first))
  (call (. t expect) "nodes outside the subtree are untouched" "Renamed" (call (. doc name) outside))
  (call (. t expect) "values come back" "count=2" (call value-list doc layer))
  (call (. t expect) "settings are kept" "size=20" (call setting-list doc layer))
  (call (. doc restore-contents) snapshot outside)
  (call (. t expect) "restoring a childless node leaves it childless" 0 (call (. doc child-count) outside))
  (return t)
)

(fn-do + value-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let layer (call (. doc create-group) (. doc root) "Script" 0 0 (. VectorDocumentGroupKind script-group)))
  (let shape (call (. doc add-path) layer (call rectangle (call Rect 0 0 10 10)) "Shape"))
  (call (. doc set-value) layer "count" (call (. VectorDocumentValue number) 3))
  (call (. doc set-value) layer "corner" (call (. VectorDocumentValue point) (call Point 1 2)))
  (call (. doc set-value) layer "tint" (call (. VectorDocumentValue color) (call RGBA 1 0 0 1)))
  (call (. doc set-value) layer "label" (call (. VectorDocumentValue text) "hi there"))
  (call (. doc set-value) layer "target" (call (. VectorDocumentValue node) shape))
  (call (. doc set-value) layer "group" (call (. VectorDocumentValue nodes) (list shape layer)))
  (let all
    (paragraph
      (str "count=3 corner=(1, 2) tint=#ff0000 label='hi there' target=node " shape " group=nodes " shape " " layer)
    )
  )
  (call (. t expect) "every kind reads back in order" all (call value-list doc layer))
  (let spread-kind (call (. VectorDocumentValue text) "range"))
  (let spread-start (call (. VectorDocumentValue number) 0))
  (let spread-point (call (. VectorDocumentValue point) (call Point 3 4)))
  (let spread-color (call (. VectorDocumentValue color) (call RGBA 0 0 1 1)))
  (let spread (call (. VectorDocumentValue values) (list spread-kind spread-start spread-point spread-color)))
  (call (. doc set-value) layer "spread" spread)
  (call (. t expect)
    (block
      (arg "a list of values reads back in order")
      (arg "values 'range', 0, (3, 4), #0000ff")
      (arg (call value-text (call (. doc value) layer "spread")))
    )
  )
  (call (. doc set-value) layer "after" (call (. VectorDocumentValue number) 9))
  (call (. t expect)
    (block
      (arg "a value after a list keeps its place")
      (arg (str all " spread=values 'range', 0, (3, 4), #0000ff after=9"))
      (arg (call value-list doc layer))
    )
  )
  (call (. doc set-value) layer "spread" null)
  (call (. doc set-value) layer "after" null)
  (call (. t expect) "removing a list leaves the rest" all (call value-list doc layer))
  (let previous (call (. doc values-stamp) layer))
  (call (. doc set-value) layer "count" (call (. VectorDocumentValue number) 4))
  (call (. t check) "a changed value changes the stamp" (!= previous (call (. doc values-stamp) layer)))
  (call (. t check) "replacing keeps the position" (call (. (call value-list doc layer) starts-with) "count=4"))
  (call (. doc set-value) layer "count" (call (. VectorDocumentValue number) 3))
  (call (. t expect) "equal content restores the stamp" previous (call (. doc values-stamp) layer))
  (let copy (call (. doc copy-node) doc layer (. doc root)))
  (let other (use (call VectorDocument)))
  (let imported (call (. other copy-node) doc layer (. other root) (list layer shape)))
  (call (. t expect) "copies between documents carry values" all (call value-list other imported))
  (call (. t expect) "copies keep the values stamp" (call (. doc values-stamp) layer) (call (. other values-stamp) imported))
  (call (. doc set-values) copy (list (call VectorDocumentKeyedValue "size" (call (. VectorDocumentValue number) 8))))
  (for (in index (..< 0 400))
    (call (. doc set-value) copy "count" (call (. VectorDocumentValue nodes) (call (of List U64) (in shape (..< 0 (% index 9))))))
  )
  (call (. doc set-value) copy "count" (call (. VectorDocumentValue number) 5))
  (call (. doc compact))
  (call (. t expect) "compaction keeps values" all (call value-list doc layer))
  (call (. t expect) "compaction keeps rewritten values" "size=8 count=5" (call value-list doc copy))
  (let unset (call (. doc settings-stamp) layer))
  (let values-before (call (. doc values-stamp) layer))
  (let node-before (call (. doc stamp) layer))
  (call (. doc set-setting) layer "7 value" (call (. VectorDocumentValue number) 32))
  (call (. doc set-setting) layer "9 start" (call (. VectorDocumentValue point) (call Point 5 6)))
  (call (. t expect) "settings are apart from values" all (call value-list doc layer))
  (call (. t expect) "a setting leaves the values stamp alone" values-before (call (. doc values-stamp) layer))
  (let set-copy (call (. doc copy-node) doc layer (. doc root)))
  (for (in index (..< 0 400))
    (let rewritten (call (. VectorDocumentValue nodes) (call (of List U64) (in shape (..< 0 (% index 9))))))
    (call (. doc set-setting) set-copy "7 value" rewritten)
  )
  (call (. doc set-setting) set-copy "7 value" (call (. VectorDocumentValue number) 40))
  (call (. doc compact))
  (call (. t expect) "compaction keeps settings" "7 value=32 9 start=(5, 6)" (call setting-list doc layer))
  (call (. t expect)
    (block
      (arg "compaction keeps rewritten settings")
      (arg "7 value=40 9 start=(5, 6)")
      (arg (call setting-list doc set-copy))
    )
  )
  (call (. t expect) "compaction keeps values beside settings" all (call value-list doc layer))
  (call (. doc set-setting) layer "7 value" null)
  (call (. doc set-setting) layer "9 start" null)
  (call (. t expect) "removing every setting restores the stamp" unset (call (. doc settings-stamp) layer))
  (call (. t expect) "removing every setting restores the node" node-before (call (. doc stamp) layer))
  (return t)
)

(fn-expr + value-list String
  (param doc VectorDocument)
  (param id U64)
  (call (. " " join) (in (str (. each key) "=" (call value-text (. each value))) (call (. doc values) id)))
)

(fn-expr + setting-list _
  (param doc VectorDocument)
  (param id U64)
  (call (. " " join) (in (str (. each key) "=" (call value-text (. each value))) (call (. doc settings) id)))
)

(fn-do + value-text String
  (param value (? VectorDocumentValue))
  (return-if "none" (if (not value)))
  (blank)
  (match value
    (case (call .number number)
      (return (str number))
    )
    (case (call .point point)
      (return (str "(" (. point x) ", " (. point y) ")"))
    )
    (case (call .color color)
      (return (str (as color Hex)))
    )
    (case (call .text text)
      (return (str "'" text "'"))
    )
    (case (call .node id)
      (return (str "node " id))
    )
    (case (call .nodes ids)
      (let parts (list String))
      (for (in id ids)
        (+= parts (str id))
      )
      (return (str "nodes " (call (. " " join) parts)))
    )
    (case (call .values items)
      (let parts (list String))
      (for (in item items)
        (+= parts (call value-text item))
      )
      (return (str "values " (call (. ", " join) parts)))
    )
  )
)

(fn-do + world-transform-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let layer (call (. doc create-group) (. doc root) "Layer"))
  (let inner (call (. doc create-group) layer "Inner"))
  (let shape (call (. doc add-path) inner (call rectangle (call Rect 0 0 10 10)) "Shape"))
  (call (. t check) "untransformed nodes have no world transform" (== (call (. doc world-transform) shape) null))
  (call (. doc set-transform) layer (call matrix-from-translation (call Point 100 0)))
  (call (. doc set-transform) inner (call matrix-from-scale (call Dimensions 2 2)))
  (call (. doc set-transform) shape (call matrix-from-translation (call Point 5 0)))
  (call (. t expect)
    (block
      (arg "world transforms compose from the root")
      (arg (call Point 110 0))
      (arg (call (. (!! (call (. doc world-transform) shape)) transform) (call Point 0 0)))
    )
  )
  (call (. t expect)
    (block
      (arg "world transforms apply outer scales to inner offsets")
      (arg (call Point 130 20))
      (arg (call (. (!! (call (. doc world-transform) shape)) transform) (call Point 10 10)))
    )
  )
  (call (. t expect)
    (block
      (arg "parent transforms exclude the node")
      (arg (call Point 100 0))
      (arg (call (. (!! (call (. doc parent-transform) shape)) transform) (call Point 0 0)))
    )
  )
  (call (. t check) "children of the root have no parent transform" (== (call (. doc parent-transform) layer) null))
  (return t)
)

(fn-do + world-network-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let layer (call (. doc create-group) (. doc root) "Layer"))
  (let inner (call (. doc create-group) layer "Inner"))
  (let shape (call (. doc add-path) inner (call rectangle (call Rect 0 0 10 10)) "Shape"))
  (call (. doc set-transform) layer (call matrix-from-translation (call Point 100 0)))
  (call (. doc set-transform) inner (call matrix-from-scale (call Dimensions 2 2)))
  (call (. doc set-transform) shape (call matrix-from-translation (call Point 5 0)))
  (let paths (call VectorDocumentPaths doc))
  (call (. paths world-network) shape)
  (let corner (. (call (. (call (. doc network) shape) vertex) 1) position))
  (call (. doc set-transform) layer (call matrix-from-translation (call Point 200 0)))
  (call (. t expect)
    (block
      (arg "moving an ancestor refreshes the world network")
      (arg (call (. (!! (call (. doc world-transform) shape)) transform) corner))
      (arg (. (call (. (call (. paths world-network) shape) vertex) 1) position))
    )
  )
  (return t)
)

(fn-do + traversal-tests _
  (param t TestCase)
  (let doc (use (call VectorDocument)))
  (let first (call (. doc create-group) (. doc root)))
  (let nested (call (. doc create-group) first))
  (let last (call (. doc create-group) (. doc root)))
  (let view (call (. doc descendants) (. doc root)))
  (call (. t expect) "preorder excludes the root" (list first nested last) (call List view))
  (call (. t expect) "a leaf has no descendants" 0 (. (call List (call (. doc descendants) nested)) length))
  (let added (call (. doc create-group) first))
  (call (. t expect) "views see edits before traversal begins" (list first nested added last) (call List view))
  (for (in id (call List (call (. doc children) first)))
    (call (. doc delete) id)
  )
  (let subtree (call (. doc descendants) last))
  (let tail (call (. doc create-group) last))
  (call (. doc compact))
  (call (. t expect) "views resolve stable ids after compaction" (list tail) (call List subtree))
  (call (. t expect) "root views survive row compaction" (list first last tail) (call List view))
  (return t)
)
