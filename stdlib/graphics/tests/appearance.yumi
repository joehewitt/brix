/graphics/appearance
/graphics/canvas
/graphics/color
/graphics/path
/graphics/point
/graphics/primitives
/graphics/shapes
/graphics/style
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Aligned Stroke Painting")
cases.run(aligned-stroke-painting-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do aligned-stroke-painting-tests TestCase
    - t TestCase

. square = rectangle(Rect(20, 20, 60, 60))
. inside = paint-aligned-stroke(square, StrokeAlignment.inside, 10)
t.expect("an inside stroke paints just inside the edge", red, inside.pixel-color(Point(22, 50)))
t.expect("an inside stroke stops at its width", transparent, inside.pixel-color(Point(35, 50)))
t.expect
    - "an inside stroke leaves the outside alone"
    - transparent
    - inside.pixel-color(Point(15, 50))

. outside = paint-aligned-stroke(square, StrokeAlignment.outside, 10)
t.expect("an outside stroke paints just outside the edge", red, outside.pixel-color(Point(15, 50)))
t.expect("an outside stroke stops at its width", transparent, outside.pixel-color(Point(5, 50)))
t.expect
    - "an outside stroke leaves the inside alone"
    - transparent
    - outside.pixel-color(Point(25, 50))

. bar = rectangle(Rect(40, 20, 6, 60))
. thick = paint-aligned-stroke(bar, StrokeAlignment.inside, 20)
t.expect("a wide inside stroke fills a thin shape", red, thick.pixel-color(Point(43, 50)))
t.expect
    - "a wide inside stroke never leaves its shape"
    - transparent
    - thick.pixel-color(Point(36, 50))

. centered = paint-aligned-stroke(square, StrokeAlignment.center, 10)
t.expect("a centered stroke straddles the edge outside", red, centered.pixel-color(Point(17, 50)))
t.expect("a centered stroke straddles the edge inside", red, centered.pixel-color(Point(23, 50)))
= t

━━━━━━━━━━━━━━━━━━━━
+ do paint-aligned-stroke RasterCanvas
    - path Path
    - alignment StrokeAlignment
    - width Length

. canvas = RasterCanvas(100, 100, 1)
. appearance = VectorAppearance(Fill.none, [StrokeLayer(red, width, alignment)])
paint-appearance(canvas, [path], appearance)
= canvas
