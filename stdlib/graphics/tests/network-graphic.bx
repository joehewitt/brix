(import /graphics/appearance)
(import /graphics/boolean)
(import /graphics/color)
(import /graphics/effect)
(import /graphics/network)
(import /graphics/network-graphic)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/stroke)
(import /graphics/style)
(import /graphics/vector-group)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Network Graphic Invalidation"))
  (call (. cases run) invalidation-tests)
  (= cases (call (. cases then) "Network Graphic Copy Isolation" copy-tests))
  (= cases (call (. cases then) "Network Graphic Stroke Reach" stroke-reach-tests))
  (return cases)
)

(fn-do + invalidation-tests _
  (param t TestCase)
  (let image (call VectorGroup))
  (let graphic (call NetworkGraphic (call rectangle-network)))
  (+= image graphic)
  (call (. image checkpoint))
  (let probe (call NetworkGraphicInvalidationProbe))
  (= (. image invalidation-listener) (. probe changed))
  (call (. graphic network move-vertex) 1 (tuple -5 0))
  (call (. t expect) "network mutation publishes one document change" 1 (. probe count))
  (blank)
  (call (. probe reset))
  (call (. graphic network begin-update))
  (call (. graphic network move-vertex) 1 (tuple -10 0))
  (call (. graphic network move-vertex) 2 (tuple 30 0))
  (call (. graphic network checkpoint))
  (call (. t expect) "network batch defers document changes" 0 (. probe count))
  (call (. graphic network end-update))
  (call (. t expect) "network batch publishes one document change" 1 (. probe count))
  (blank)
  (let old-network (. graphic network))
  (let replacement (call rectangle-network))
  (= (. graphic network) replacement)
  (call (. probe reset))
  (call (. old-network move-vertex) 1 (tuple -20 0))
  (call (. t expect) "replaced network no longer invalidates its former owner" 0 (. probe count))
  (call (. replacement move-vertex) 1 (tuple -20 0))
  (call (. t expect) "replacement network invalidates its owner" 1 (. probe count))
  (return t)
)

(fn-do + copy-tests _
  (param t TestCase)
  (let graphic (call NetworkGraphic (call rectangle-network)))
  (let effects (list VectorEffect))
  (+= effects (call BooleanEffect))
  (= (. graphic effects) (call VectorEffects effects))
  (let red-fill (call RGBA 1 0 0 1))
  (call (. graphic paint-region) (tuple 10 10) red-fill)
  (let copy (call (. graphic copy)))
  (let source-effects (. graphic $effects items))
  (let copied-effects (. copy $effects items))
  (call (. t check)
    (block
      (arg "copy owns independent effects")
      (arg (!= (as ([] source-effects 0) Pointer) (as ([] copied-effects 0) Pointer)))
    )
  )
  (call (. copy network move-vertex) 1 (tuple -50 -50))
  (call (. t expect)
    (block
      (arg "copy mutation leaves source geometry isolated")
      (arg (call Point 0 0))
      (arg (. (call (. graphic network vertex) 1) position))
    )
  )
  (call (. copy paint-region) (tuple 10 10) (call RGBA 0 0 1 1))
  (call (. t expect) "copy painting leaves source appearance isolated" red-fill (!! (. ([] (. graphic appearances) 0) fill)))
  (return t)
)

(type + NetworkGraphicInvalidationProbe
  (prop + count Size)
  (prop + kinds U8)
  (fn-do + changed _
    (param changed-kinds U8)
    (+= count 1)
    (= kinds (/or/ kinds changed-kinds))
  )
  (fn-do + reset _
    (= count 0)
    (= kinds 0)
  )
)

(fn-do + stroke-reach-tests _
  (param t TestCase)
  (let graphic (call NetworkGraphic (call rectangle-network)))
  (= (. graphic stroke) black)
  (= (. graphic stroke-width) 1)
  (call (. t check) "a thin stroke misses a distant point" (not (call (. graphic hit) (tuple -12 10) 0)))
  (= (. graphic stroke) (as (list (call StrokeLayer black 1) (call StrokeLayer red 30 (. StrokeAlignment outside))) Stroke))
  (call (. t check) "a wide outside stroke layer extends picking" (call (. graphic hit) (tuple -12 10) 0))
  (= (. graphic stroke) (as (list (call StrokeLayer black 1) (call StrokeLayer red 30 (. StrokeAlignment outside) null null false)) Stroke))
  (call (. t check) "hidden stroke layers do not extend picking" (not (call (. graphic hit) (tuple -12 10) 0)))
  (call (. t check)
    (block
      (arg "a painted fill picks its interior")
      (arg (call (. graphic fill-hit) (tuple 10 10) (call VectorAppearance (call Fill red))))
    )
  )
  (call (. t check)
    (block
      (arg "fill picking stays inside the shape")
      (arg (not (call (. graphic fill-hit) (tuple 30 10) (call VectorAppearance (call Fill red)))))
    )
  )
  (call (. t check)
    (block
      (arg "an unpainted fill is click-through")
      (arg (not (call (. graphic fill-hit) (tuple 10 10) (call VectorAppearance (. Fill none)))))
    )
  )
  (call (. t check)
    (block
      (arg "a transparent fill is click-through")
      (arg (not (call (. graphic fill-hit) (tuple 10 10) (call VectorAppearance (call Fill transparent)))))
    )
  )
  (return t)
)

(fn-expr _ rectangle-network VectorNetwork
  (call network-from-path (call rectangle (call Rect 0 0 20 20)))
)
