(import /graphics/network)
(import /graphics/network-combine)
(import /graphics/network-regions)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /math)
(import /stream/aggregate)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Network Merging"))
  (call (. cases run) merging-tests)
  (= cases (call (. cases then) "Network Cutting" cutting-tests))
  (= cases (call (. cases then) "Network Crossings" crossing-tests))
  (= cases (call (. cases then) "Network Joining" joining-tests))
  (= cases (call (. cases then) "Network Splitting" splitting-tests))
  (= cases (call (. cases then) "Network Weaving" weaving-tests))
  (return cases)
)

(fn-do + merging-tests _
  (param t TestCase)
  (let base (call VectorNetwork))
  (call (. base connect) (call (. base add-vertex) (tuple 0 0)) (call (. base add-vertex) (tuple 100 0)))
  (let other (call VectorNetwork))
  (let c (call (. other add-vertex) (tuple 0 50)))
  (let d (call (. other add-vertex) (tuple 50 50)))
  (let e (call (. other add-vertex) (tuple 100 50)))
  (call (. other connect) c d (tuple 10 0) (tuple -10 0))
  (let second (call (. other connect) d e (tuple 10 0) (tuple -10 0)))
  (call (. other split) second 0.5)
  (call (. base add-network) other)
  (call (. t check) "merged vertices get fresh ids" (call unique (call (of List Index) (in (. each id) (. base vertices)))))
  (call (. t check) "merged segments get fresh ids" (call unique (call (of List Index) (in (. each id) (. base segments)))))
  (let sources (call (of List Index) (in (. each source) (. base segments))))
  (call (. t expect) "split halves keep one source" 3 (call distinct-count sources))
  (return t)
)

(fn-do + cutting-tests _
  (param t TestCase)
  (let network (call VectorNetwork))
  (let edge
    (call (. network connect)
      (block
        (arg (call (. network add-vertex) (tuple 0 0)))
        (arg (call (. network add-vertex) (tuple 100 0)))
        (arg (tuple 20 20))
        (arg (tuple -20 20))
      )
    )
  )
  (let original (call (. network curve) edge))
  (let pieces (call (. network cut) edge (list 0.25 0.75)))
  (call (. t expect) "cut pieces are separate paths" 3 (. (call (. network traces)) length))
  (call (. t check)
    (block
      (arg "the middle piece starts at the first cut")
      (arg (call near (. (call (. network curve) ([] pieces 1)) anchor1) (call network-curve-point original 0.25)))
    )
  )
  (call (. t check)
    (block
      (arg "the middle piece ends at the second cut")
      (arg (call near (. (call (. network curve) ([] pieces 1)) anchor2) (call network-curve-point original 0.75)))
    )
  )
  (call (. t check)
    (block
      (arg "the last piece ends where the segment did")
      (arg (call near (. (call (. network curve) ([] pieces 2)) anchor2) (tuple 100 0)))
    )
  )
  (call (. t expect) "cut ends are not paired" 0 (. (call (of List NetworkPair) (in each (. network pairs))) length))
  (blank)
  (let chain (call VectorNetwork))
  (let a (call (. chain add-vertex) (tuple 0 0)))
  (let b (call (. chain add-vertex) (tuple 50 0)))
  (let c (call (. chain add-vertex) (tuple 100 0)))
  (call (. chain connect) b a (tuple 0 10) (tuple 0 10))
  (call (. chain connect) b c (tuple 0 -10) (tuple 0 -10))
  (let extracted (call (. chain extract) ([] (call (. chain traces)) 0)))
  (call (. t check)
    (block
      (arg "an extracted trace starts where the trace did")
      (arg (call near (. ([] (call (. extracted traces)) 0) path first-point) (tuple 0 0)))
    )
  )
  (call (. t check)
    (block
      (arg "an extracted trace ends where the trace did")
      (arg (call near (. ([] (call (. extracted traces)) 0) path last-point) (tuple 100 0)))
    )
  )
  (return t)
)

(fn-do + crossing-tests _
  (param t TestCase)
  (let network (call VectorNetwork))
  (call (. network connect) (call (. network add-vertex) (tuple 0 50)) (call (. network add-vertex) (tuple 100 50)))
  (call (. network connect) (call (. network add-vertex) (tuple 50 0)) (call (. network add-vertex) (tuple 50 100)))
  (let workspace (call NetworkRegionWorkspace))
  (let crossings (call (. workspace crossings) network))
  (call (. t expect) "crossing lines meet once on each line" 2 (. crossings length))
  (call (. t expect) "both lines share the crossing" (. ([] crossings 0) crossing) (. ([] crossings 1) crossing))
  (call (. t check) "the crossing is where the lines meet" (call near (. ([] crossings 0) position) (tuple 50 50)))
  (call (. t expect)
    (block
      (arg "the crossing parameter is on the segment")
      (arg 0.5)
      (arg (/ (call round (* (. ([] crossings 0) parameter) 1000)) 1000))
    )
  )
  (call (. network connect) (call (. network add-vertex) (tuple 25 50)) (call (. network add-vertex) (tuple 25 80)))
  (= crossings (call (. workspace crossings) network))
  (call (. t expect) "an end touching a line cuts the line only" 3 (. crossings length))
  (call (. t expect) "a touch is its own crossing" 2 (call distinct-count (call (of List Index) (in (. each crossing) crossings))))
  (blank)
  (let looped (call VectorNetwork))
  (call (. looped connect) (call (. looped add-vertex) (tuple 0 0)) (call (. looped add-vertex) (tuple 100 0)) (tuple 150 100) (tuple -150 100))
  (let loops (call (. workspace crossings) looped))
  (call (. t expect) "a looped curve crosses itself twice" 2 (. loops length))
  (call (. t expect) "a looped curve crosses itself at one place" (. ([] loops 0) crossing) (. ([] loops 1) crossing))
  (blank)
  (let connected (call network-from-path (call rectangle (call Rect 0 0 100 100))))
  (call (. t expect) "connected segments do not cross" 0 (. (call (. workspace crossings) connected) length))
  (return t)
)

(fn-do + joining-tests _
  (param t TestCase)
  (let network (call VectorNetwork))
  (let a (call (. network add-vertex) (tuple 0 0)))
  (let b (call (. network add-vertex) (tuple 100 0)))
  (call (. network connect) a b)
  (call (. network connect) (call (. network add-vertex) (tuple 200 0)) (call (. network add-vertex) (tuple 100 0.0001)))
  (call (. network connect) (call (. network add-vertex) (tuple 300 50)) (call (. network add-vertex) (tuple 250 50)))
  (let loop (call (. network add-vertex) (tuple 0 200)))
  (let corner (call (. network add-vertex) (tuple 50 250)))
  (call (. network connect) loop corner)
  (let back (call (. network add-vertex) (tuple 0 250)))
  (call (. network connect) corner back)
  (call (. network connect) back loop)
  (call network-join network b)
  (let traces (call (. network traces)))
  (call (. t expect) "joined paths become one path beside the loop" 2 (. traces length))
  (call (. t expect) "touching ends merge" 8 (. network vertex-count))
  (call (. t expect) "a gap becomes a segment" 7 (. network segment-count))
  (call (. t check) "the joined path starts at the first path" (call near (. ([] traces 0) path first-point) (tuple 0 0)))
  (call (. t check)
    (block
      (arg "the joined path reverses a path that ends nearer")
      (arg (call near (call (. ([] traces 0) path get-point-at) 2) (tuple 200 0)))
    )
  )
  (call (. t check) "the joined path ends at the far end" (call near (. ([] traces 0) path last-point) (tuple 300 50)))
  (call (. t check) "the loop stays closed" (. ([] traces 1) path is-closed))
  (call (. t expect) "the free end is the last open path's end" 6 (!! (call network-free-end (call three-lines))))
  (blank)
  (let hooked (call VectorNetwork))
  (let knee (call (. hooked add-vertex) (tuple 254 309)))
  (let apex (call (. hooked add-vertex) (tuple 365 100)))
  (let tip (call (. hooked add-vertex) (tuple 700 335)))
  (call (. hooked connect) knee apex)
  (call (. hooked connect) apex tip)
  (call (. hooked connect) (call (. hooked add-vertex) (tuple 75 637)) (call (. hooked add-vertex) (tuple 254 309)))
  (call network-join hooked tip)
  (let joined (call (. hooked traces)))
  (call (. t expect) "a path meeting the first path's start joins there" 1 (. joined length))
  (call (. t check) "joining open paths leaves them open" (not (. ([] joined 0) path is-closed)))
  (call (. t expect) "the meeting ends merge" 4 (. hooked vertex-count))
  (call (. t expect) "meeting ends add no segment" 3 (. hooked segment-count))
  (call (. t check)
    (block
      (arg "the joined path keeps the first path's direction")
      (arg (and (call near (. ([] joined 0) path first-point) (tuple 75 637)) (call near (. ([] joined 0) path last-point) (tuple 700 335))))
    )
  )
  (call (. t check)
    (block
      (arg "points number along the joined path")
      (arg (call near (. ([] (call (of List NetworkVertex) (in each (. hooked vertices))) 1) position) (tuple 254 309)))
    )
  )
  (return t)
)

(fn-do + splitting-tests _
  (param t TestCase)
  (let network (call VectorNetwork))
  (call (. network connect) (call (. network add-vertex) (tuple 0 50)) (call (. network add-vertex) (tuple 100 50)))
  (call (. network connect) (call (. network add-vertex) (tuple 50 0)) (call (. network add-vertex) (tuple 50 100)))
  (let pieces (call network-split network))
  (call (. t expect) "crossing lines split into four pieces" 4 (. pieces length))
  (for (in piece pieces)
    (call (. t expect) "each piece is one segment" 1 (. piece segment-count))
    (call (. t check) "each piece reaches the crossing" (!= (call (. piece pick) (tuple 50 50) 0.01) null))
  )
  (call (. t expect) "splitting leaves the original alone" 2 (. network segment-count))
  (blank)
  (let boxed (call network-from-path (call rectangle (call Rect 0 0 100 100))))
  (call (. boxed connect) (call (. boxed add-vertex) (tuple 50 -10)) (call (. boxed add-vertex) (tuple 50 110)))
  (call (. t expect) "a crossed rectangle splits into five pieces" 5 (. (call network-split boxed) length))
  (call (. t expect)
    (block
      (arg "an uncrossed path stays whole")
      (arg 1)
      (arg (. (call network-split (call network-from-path (call rectangle (call Rect 0 0 100 100)))) length))
    )
  )
  (blank)
  (let branched (call VectorNetwork))
  (let hub (call (. branched add-vertex) (tuple 50 50)))
  (call (. branched connect) hub (call (. branched add-vertex) (tuple 0 0)))
  (call (. branched connect) hub (call (. branched add-vertex) (tuple 100 0)))
  (call (. branched connect) hub (call (. branched add-vertex) (tuple 50 100)))
  (call (. t expect) "a branch splits at its junction" 3 (. (call network-split branched) length))
  (return t)
)

(fn-do + weaving-tests _
  (param t TestCase)
  (let across (call VectorNetwork))
  (call add-line across (tuple 0 30) (tuple 100 30))
  (call add-line across (tuple 0 70) (tuple 100 70))
  (let down (call VectorNetwork))
  (call add-line down (tuple 30 0) (tuple 30 100))
  (call add-line down (tuple 70 0) (tuple 70 100))
  (let pieces (call network-weave (list across down)))
  (call (. t expect) "each strand splits between its crossings" 8 (. pieces length))
  (call (. t expect) "half the pieces go over" 4 (call over-count pieces))
  (call (. t check) "pieces under come first" (and (not (. ([] pieces 0) over)) (not (. ([] pieces 3) over))))
  (call (. t check) "pieces over come last" (and (. ([] pieces 4) over) (. ([] pieces 7) over)))
  (call (. t expect)
    (block
      (arg "the first strand starts over")
      (arg "over under")
      (arg (call over-text pieces true (list (tuple 30 30) (tuple 70 30))))
    )
  )
  (call (. t expect)
    (block
      (arg "the second strand alternates")
      (arg "under over")
      (arg (call over-text pieces true (list (tuple 30 70) (tuple 70 70))))
    )
  )
  (call (. t expect)
    (block
      (arg "the third strand alternates")
      (arg "under over")
      (arg (call over-text pieces false (list (tuple 30 30) (tuple 30 70))))
    )
  )
  (call (. t expect)
    (block
      (arg "the fourth strand alternates")
      (arg "over under")
      (arg (call over-text pieces false (list (tuple 70 30) (tuple 70 70))))
    )
  )
  (for (in point (list (call Point 30 30) (call Point 70 30) (call Point 30 70) (call Point 70 70)))
    (call (. t check)
      (block
        (arg "one strand goes over at each crossing")
        (arg (!= (call over-text pieces true (list point)) (call over-text pieces false (list point))))
      )
    )
  )
  (call (. t check)
    (block
      (arg "across pieces come from the first network")
      (arg (call all pieces (:where (== (== (. each source) 0) (call horizontal (. each network))))))
    )
  )
  (blank)
  (let eight (call VectorNetwork))
  (let a (call (. eight add-vertex) (tuple 0 0)))
  (let b (call (. eight add-vertex) (tuple 100 100)))
  (let c (call (. eight add-vertex) (tuple 100 0)))
  (let d (call (. eight add-vertex) (tuple 0 100)))
  (call (. eight connect) a b)
  (call (. eight connect) b c)
  (call (. eight connect) c d)
  (call (. eight connect) d a)
  (let woven (call network-weave (list eight)))
  (call (. t expect) "a figure eight weaves into two pieces" 2 (. woven length))
  (call (. t check) "a figure eight crosses over itself once" (and (not (. ([] woven 0) over)) (. ([] woven 1) over)))
  (call (. t check)
    (block
      (arg "each piece of a figure eight passes the crossing")
      (arg (call all woven (:where (!= (call (. each network pick) (tuple 50 50) 0.01) null))))
    )
  )
  (let line (call VectorNetwork))
  (call add-line line (tuple 0 0) (tuple 10 0))
  (call (. t expect) "an uncrossed path stays whole" 1 (. (call network-weave (list line)) length))
  (return t)
)

(fn-do + three-lines VectorNetwork
  (let network (call VectorNetwork))
  (call (. network connect) (call (. network add-vertex) (tuple 0 0)) (call (. network add-vertex) (tuple 10 0)))
  (call (. network connect) (call (. network add-vertex) (tuple 0 10)) (call (. network add-vertex) (tuple 10 10)))
  (call (. network connect) (call (. network add-vertex) (tuple 0 20)) (call (. network add-vertex) (tuple 10 20)))
  (call (. network add-vertex) (tuple 0 30))
  (return network)
)

(fn-do + add-line _
  (param network VectorNetwork)
  (param start Point)
  (param end Point)
  (call (. network connect) (call (. network add-vertex) start) (call (. network add-vertex) end))
)

(fn-do + over-text String
  (param pieces (list NetworkWovenPiece))
  (param across Bool)
  (param points (list Point))
  (let words (list String))
  (for (in point points)
    (for (in piece pieces)
      (if (and (== (call horizontal (. piece network)) across) (!= (call (. piece network pick) point 0.01) null))
        (+= words (if-expr (. piece over) "over" "under"))
      )
    )
  )
  (return (call (. " " join) words))
)

(fn-do + horizontal Bool
  (param network VectorNetwork)
  (let vertices (call (of List NetworkVertex) (in each (. network vertices))))
  (return (call all vertices (:where (== (. each position y) (. ([] vertices 0) position y)))))
)

(fn-expr + unique Bool
  (param ids (list Index))
  (== (call distinct-count ids) (. ids length))
)

(fn-do + distinct-count Size
  (param ids (list Index))
  (let seen (list Index))
  (for (in id ids)
    (if (not (call network-has-id seen id))
      (+= seen id)
    )
  )
  (return (. seen length))
)

(fn-do + over-count Size
  (param pieces (list NetworkWovenPiece))
  (let count Size 0)
  (for (in piece pieces)
    (if (. piece over)
      (+= count 1)
    )
  )
  (return count)
)

(fn-expr + near Bool
  (param point Point)
  (param expected Point)
  (< (call (. point distance) expected) 0.001)
)
