(import /graphics/network)
(import /graphics/network-stroke)
(import /graphics/offset-kernels)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/stroke)
(import /graphics/tests/support/geometry)
(import /math)
(import /test)
(blank)

(main
  (call tests)
  (call operation-tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Aligned Stroke Joins"))
  (call (. cases run) aligned-join-tests)
  (= cases (call (. cases then) "Stroke Coverage" coverage-tests))
  (return cases)
)

(fn-expr + operation-tests TestRender
  (header (call test "Stroke Operations"))
  (tuple true (call line-butt-stroke-bbox))
  (tuple true (call line-butt-stroke-area))
  (tuple true (call line-square-stroke-bbox))
  (tuple true (call line-square-stroke-area))
  (tuple true (call line-round-stroke-bbox))
  (tuple true (call acute-miter-limit-fallback))
  (tuple true (call tiny-segment-stroke))
  (tuple true (call right-angle-miter-fast-path))
  (tuple true (call nearly-180-miter-fallback))
  (tuple true (call collinear-degenerate-cubic-stroke))
  (header (call test "Near-Straight Stroke Corner Width"))
  (tuple true (call straight-stroke-corner-width))
)

(fn-do + aligned-join-tests TestCase
  (param t TestCase)
  (let shape (call shallow-corner-shape))
  (let wedge (call Point 443.8 232))
  (let notch (call shallow-notch-shape))
  (let notch-wedge (call Point 200 -30))
  (for (in join (list (. JoinType round-join-type) (. JoinType miter-join-type) (. JoinType bevel-join-type)))
    (for (in reversed (list false true))
      (let source (if-expr reversed (call (. shape reverse)) shape))
      (let inside (call stroke source 100 (. StrokeAlignment inside) join (. LineCap round) 4))
      (call (. t check)
        (block
          (arg (str "an inside stroke covers its shallow inner join (reversed " reversed ")"))
          (arg (call (. inside contains) wedge (. FillRule nonzero)))
        )
      )
      (let centered (call stroke source 100 (. StrokeAlignment center) join (. LineCap round) 4))
      (call (. t check)
        (block
          (arg (str "a centered stroke covers its shallow inner join (reversed " reversed ")"))
          (arg (call (. centered contains) (call Point 452 219) (. FillRule nonzero)))
        )
      )
      (let notch-source (if-expr reversed (call (. notch reverse)) notch))
      (let outside (call stroke notch-source 100 (. StrokeAlignment outside) join (. LineCap round) 4))
      (call (. t check)
        (block
          (arg (str "an outside stroke covers its shallow outer notch (reversed " reversed ")"))
          (arg (call (. outside contains) notch-wedge (. FillRule nonzero)))
        )
      )
    )
  )
  (return t)
)

(fn-do + coverage-tests TestCase
  (param t TestCase)
  (let corner (call shallow-corner-shape))
  (let ring (call circle (call Point 200 200) 60))
  (call check-coverage t "corner inside" corner (. StrokeAlignment inside) 100)
  (call check-coverage t "reversed corner inside" (call (. corner reverse)) (. StrokeAlignment inside) 100)
  (call check-coverage t "corner center" corner (. StrokeAlignment center) 100)
  (call check-coverage t "tight circle inside" ring (. StrokeAlignment inside) 160)
  (call check-coverage t "tight circle center" ring (. StrokeAlignment center) 160)
  (call check-coverage t "notch outside" (call shallow-notch-shape) (. StrokeAlignment outside) 100)
  (return t)
)

(fn-do + shallow-corner-shape Path
  (let path (call Path))
  (call (. path move-to) 50.45703125 208.56640625)
  (call (. path cubic-curve-to) 50.45703125 208.56640625 149.4689 121.6640625 256.8828125 121.6640625)
  (call (. path cubic-curve-to) 373.0677 121.6640625 470.66015625 189.953125 470.66015625 189.953125)
  (call (. path cubic-curve-to) 545.5232 233.5035 493.16015625 653.46875 493.16015625 653.46875)
  (call (. path cubic-curve-to) 493.16015625 653.46875 50.45703125 717.6026 50.45703125 607.921875)
  (call (. path close))
  (return path)
)

(fn-do + shallow-notch-shape Path
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 200 20)
  (call (. path line-to) 400 0)
  (call (. path line-to) 400 300)
  (call (. path line-to) 0 300)
  (call (. path close))
  (return path)
)

(fn-do + check-coverage _
  (param t TestCase)
  (param label String)
  (param shape Path)
  (param alignment StrokeAlignment)
  (param width Length)
  (let outline (call stroke shape width alignment (. JoinType round-join-type) (. LineCap round) 4))
  (call (. t expect)
    (block
      (arg (str label " covers exactly its reach"))
      (arg 0)
      (arg (call coverage-mismatches shape outline width alignment))
    )
  )
)

(fn-do + coverage-mismatches Size
  (param shape Path)
  (param outline Path)
  (param width Length)
  (param alignment StrokeAlignment)
  (let polyline (call flattened shape))
  (let reach (if-expr (== alignment (. StrokeAlignment center)) (/ width 2) width))
  (let box (. shape bounding-box))
  (let mismatches Size 0)
  (let y (- (. box y) reach 3.37))
  (while (< y (+ (. box y) (. box height) reach 4))
    (let x (- (. box x) reach 3.61))
    (while (< x (+ (. box x) (. box width) reach 4))
      (let point (call Point x y))
      (let distance (call polyline-distance polyline point))
      (if (and (> distance 1.5) (> (call abs (- distance reach)) 1.5))
        (let in-reach (< distance reach))
        (let inside (call (. shape contains) point (. FillRule nonzero)))
        (let on-stroke-side
          (block
            (case? (== alignment (. StrokeAlignment inside))
              inside
            )
            (case? (== alignment (. StrokeAlignment outside))
              (not inside)
            )
            (default
              true
            )
          )
        )
        (let covered (call (. outline contains) point (. FillRule nonzero)))
        (if (and (or on-stroke-side (not in-reach)) (!= covered (and in-reach on-stroke-side)))
          (+= mismatches 1)
        )
      )
      (+= x 16)
    )
    (+= y 16)
  )
  (return mismatches)
)

(fn-do + flattened (list Point)
  (param path Path)
  (let points (list Point))
  (let span (. path commands))
  (let current (call Point 0 0))
  (let start (call Point 0 0))
  (for (in i (..< 0 (. span command-count)))
    (let verb ([] (. span verbs) i))
    (let offset ([] (. span coord-offsets) i))
    (if (== verb .path-verb-move)
      (= current (call Point ([] (. span coords) offset) ([] (. span coords) (+ offset 1))))
      (= start current)
      (+= points current)
      (else-if (== verb .path-verb-line)
        (= current (call Point ([] (. span coords) offset) ([] (. span coords) (+ offset 1))))
        (+= points current)
      )
      (else-if (== verb .path-verb-cubic)
        (let h1 (call Point ([] (. span coords) offset) ([] (. span coords) (+ offset 1))))
        (let h2 (call Point ([] (. span coords) (+ offset 2)) ([] (. span coords) (+ offset 3))))
        (let end (call Point ([] (. span coords) (+ offset 4)) ([] (. span coords) (+ offset 5))))
        (for (in step (..< 1 65))
          (+= points (call cubic-point current h1 h2 end (/ (as step Float) 64)))
        )
        (= current end)
      )
      (else-if (== verb .path-verb-close)
        (+= points start)
        (= current start)
      )
    )
  )
  (return points)
)

(fn-do + polyline-distance Float
  (param points (list Point))
  (param point Point)
  (let best 1e300)
  (for (in index (..< 1 (. points length)))
    (let a ([] points (- index 1)))
    (let b ([] points index))
    (let segment (- b a))
    (let length-squared (call (. segment dot) segment))
    (let along
      (scope (if-expr (<= length-squared 0) 0.0 (call min (call max projection 0) 1))
        (lazy projection (/ (call (. (- point a) dot) segment) length-squared))
      )
    )
    (= best (call min best (call (. point distance) (+ a (* segment along)))))
  )
  (return best)
)

(fn-do + bent-line _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 10 0)
  (call (. path line-to) 10 10)
  (return path)
)

(fn-expr + line-butt-stroke _
  (call stroke (call line (tuple 0 0) (tuple 10 0)) 4 .center .bevel-join-type .butt 4 0)
)

(fn-expr + line-butt-stroke-bbox _
  (call near-rect (call Rect 0 -2 10 4) (. (call line-butt-stroke) bounding-box))
)

(fn-expr + line-butt-stroke-area _
  (call near 40 (call path-area (call line-butt-stroke)))
)

(fn-expr + line-square-stroke _
  (call stroke (call line (tuple 0 0) (tuple 10 0)) 4 .center .bevel-join-type .square 4 0)
)

(fn-expr + line-square-stroke-bbox _
  (call near-rect (call Rect -2 -2 14 4) (. (call line-square-stroke) bounding-box))
)

(fn-expr + line-square-stroke-area _
  (call near 56 (call path-area (call line-square-stroke)))
)

(fn-expr + line-round-stroke _
  (call stroke (call line (tuple 0 0) (tuple 10 0)) 4 .center .bevel-join-type .round 4 0)
)

(fn-expr + line-round-stroke-bbox _
  (call near-rect (call Rect -2 -2 14 4) (. (call line-round-stroke) bounding-box))
)

(fn-do + acute-miter-limit-fallback _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 20 0)
  (call (. path line-to) 10 -50)
  (call (. path close))
  (let stroked (call stroke path 2 .center .miter-join-type .butt 1 0))
  (return (and (> (. stroked bounding-box top) -51) (< (. stroked bounding-box height) 52)))
)

(fn-do + tiny-segment-stroke _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 0.000001 0)
  (call (. path line-to) 10 0)
  (let stroked (call stroke path 4 .center .bevel-join-type .butt 4 0))
  (return (and (call near-rect (call Rect 0 -2 10 4) (. stroked bounding-box)) (call near 40 (call path-area stroked))))
)

(fn-expr + right-angle-miter-fast-path _
  (and (call near-rect (call Rect 0 -2 12 12) (. stroked bounding-box)) (call (. stroked contains) (tuple 11 -1)))
  (where
    (lazy path (call bent-line))
    (lazy stroked (call stroke path 4 .center .miter-join-type .butt 4 0))
  )
)

(fn-do + nearly-180-miter-fallback _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 10 0)
  (call (. path line-to) 0.01 0.0001)
  (let stroked (call stroke path 4 .center .miter-join-type .butt 4 0))
  (return (and (< (. stroked bounding-box width) 15) (< (. stroked bounding-box height) 5)))
)

(fn-do + collinear-degenerate-cubic-stroke _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path cubic-curve-to) 3 0 7 0 10 0)
  (let stroked (call stroke path 4 .center .round-join-type .butt 4 0))
  (return (and (call near-rect (call Rect 0 -2 10 4) (. stroked bounding-box)) (call near 40 (call path-area stroked))))
)

(fn-do + straight-stroke-corner-width _
  (let path (call Path))
  (call (. path move-to) 47 189)
  (call (. path line-to) 347 25)
  (call (. path line-to) 505 176)
  (call (. path line-to) 410 346)
  (call (. path line-to) 213 314)
  (let valid true)
  (for (in representation (..< 0 3))
    (let source path)
    (if (> representation 0)
      (= source (call Path))
      (call (. source move-to) (. path first-point))
      (for (in curve (. path curves))
        (let jitter (if-expr (== representation 2) (call Point 0.3 -0.3) (call Point 0 0)))
        (call (. source cubic-curve-to) (+ (. curve anchor1) jitter) (- (. curve anchor2) jitter) (. curve anchor2))
      )
    )
    (for (in reversed (list false true))
      (let directed (if-expr reversed (call (. source reverse)) source))
      (for (in join (list .round-join-type .miter-join-type .bevel-join-type))
        (let outline (call stroke directed 4 .center join .round 4))
        (if (not (call straight-stroke-width-covers path outline))
          (print (str "Bad representation " representation " reversed " reversed " join " join))
          (= valid false)
        )
        (let net-outline (call network-stroke (call network-from-path directed) 4 join .round 4))
        (if (not (call straight-stroke-width-covers path net-outline))
          (print (str "Bad network representation " representation " reversed " reversed " join " join))
          (= valid false)
        )
      )
    )
  )
  (return valid)
)

(fn-do + straight-stroke-width-covers _
  (param path Path)
  (param outline Path)
  (let valid true)
  (for (in curve (. path curves))
    (let delta (- (. curve anchor2) (. curve anchor1)))
    (let normal (/ (call Point (- (. delta y)) (. delta x)) (. delta length)))
    (for (in fraction (list 0.05 0.25 0.5 0.75 0.95))
      (let center (+ (. curve anchor1) (* delta fraction)))
      (for (in side (list -1.0 1.0))
        (if (not (call (. outline contains) (+ center (* normal (* 1.5 side))) (. FillRule nonzero)))
          (print (str "Missing width at " fraction " " side ": " (. curve anchor1) " to " (. curve anchor2)))
          (= valid false)
        )
        (if (call (. outline contains) (+ center (* normal (* 2.5 side))) (. FillRule nonzero))
          (print (str "Excess stroke width at " fraction " on " side ": " (. curve anchor1) " to " (. curve anchor2)))
          (= valid false)
        )
      )
    )
  )
  (return valid)
)
