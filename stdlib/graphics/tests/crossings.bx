(import /graphics/crossings)
(import /graphics/network)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/tests/support/geometry)
(import /math)
(import /test)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Path Nearest Point"))
  (tuple true (call near-point (tuple 5 0) (. (!! (call path-nearest (call line (tuple 0 0) (tuple 10 0)) (tuple 5 3))) point)))
  (tuple true (call near 3 (. (!! (call path-nearest (call line (tuple 0 0) (tuple 10 0)) (tuple 5 3))) distance)))
  (tuple true (call near 0.5 (. (!! (call path-nearest (call line (tuple 0 0) (tuple 10 0)) (tuple 5 3))) parameter)))
  (tuple true (call near-point (tuple 10 0) (. (!! (call path-nearest (call line (tuple 0 0) (tuple 10 0)) (tuple 14 0))) point)))
  (tuple true (== (call path-nearest (call line (tuple 0 0) (tuple 10 0)) (tuple 5 3) 2) null))
  (tuple true (call near-point (tuple 10 4) (. (!! (call path-nearest (call box) (tuple 12 4))) point)))
  (tuple true (call near 1.4 (. (!! (call path-nearest (call box) (tuple 12 4))) parameter)))
  (tuple true (call near 14 (call (. (call box) get-length-at-parameter) (. (!! (call path-nearest (call box) (tuple 12 4))) parameter))))
  (tuple true (call near 34 (call (. (call box) get-length-at-parameter) (. (!! (call path-nearest (call box) (tuple -3 6))) parameter))))
  (header (call test "Path Nearest Point Inside A Curve"))
  (tuple true (call near-point (tuple 26 22) (. (!! (call path-nearest (call circle (tuple 10 10) 20) (tuple 28.4 23.8))) point) 0.02))
  (tuple true (call near 3 (. (!! (call path-nearest (call circle (tuple 10 10) 20) (tuple 28.4 23.8))) distance) 0.02))
  (tuple true (call near-point (tuple 26 22) (. (!! (call path-nearest (call circle (tuple 10 10) 20) (tuple 22 19))) point) 0.02))
  (tuple true (call near-point (tuple 26 22) (. (!! (call path-nearest (call circle (tuple 10 10) 20) (tuple 1010 760))) point) 0.02))
  (tuple true (call near 1230 (. (!! (call path-nearest (call circle (tuple 10 10) 20) (tuple 1010 760))) distance) 0.02))
  (tuple true (call nearest-agrees (call ellipse (tuple 120 315) (call Dimensions 20 15)) (tuple 143 322)))
  (tuple true (call nearest-agrees (call ellipse (tuple 120 315) (call Dimensions 20 15)) (tuple 125 318)))
  (tuple true (call nearest-agrees (call ellipse (tuple 120 315) (call Dimensions 20 15)) (tuple 1043 797)))
  (tuple true (call nearest-agrees (call ellipse (tuple 120 315) (call Dimensions 20 15)) (tuple -600 40)))
  (tuple true (call nearest-agrees (call ellipse (tuple 120 315) (call Dimensions 200 3)) (tuple 150 330)))
  (tuple true (call nearest-agrees (call circle (tuple 10 10) 0.05) (tuple 12 14)))
  (tuple true (call nearest-agrees (call swerve) (tuple 60 10)))
  (tuple true (call nearest-agrees (call swerve) (tuple 20 45)))
  (tuple true (call nearest-agrees (call swerve) (tuple 900 -700)))
  (tuple true (== (call path-nearest (call circle (tuple 10 10) 20) (tuple 1010 760) 100) null))
  (header (call test "Path Point Along A Line"))
  (tuple true (call near-point (tuple 10 4) (call (. (call box) get-point-at-distance) 14)))
  (tuple true (call near-point (tuple 0 6) (call (. (call box) get-point-at-distance) 34)))
  (tuple true (call near-point (tuple 2.92893 2.92893) (call (. (call disc) get-point-at-distance) (/ (. (call disc) length) 8)) 0.01))
  (tuple true (call near-point (tuple 20 10) (. (!! (call path-nearest (call disc) (tuple 30 10))) point) 0.001))
  (header (call test "Path Intersection Order"))
  (tuple 0 (. (call path-crossings (call line (tuple 0 0) (tuple 10 0)) (call line (tuple 0 5) (tuple 10 5))) length))
  (tuple 1 (. (call path-crossings (call line (tuple 0 0) (tuple 10 10)) (call line (tuple 0 10) (tuple 10 0))) length))
  (tuple true (call near-point (tuple 5 5) (. ([] (call path-crossings (call line (tuple 0 0) (tuple 10 10)) (call line (tuple 0 10) (tuple 10 0))) 0) point)))
  (tuple 2 (. (call path-crossings (call line (tuple -5 5) (tuple 15 5)) (call box)) length))
  (tuple true (call near-point (tuple 0 5) (. ([] (call path-crossings (call line (tuple -5 5) (tuple 15 5)) (call box)) 0) point)))
  (tuple true (call near-point (tuple 10 5) (. ([] (call path-crossings (call line (tuple -5 5) (tuple 15 5)) (call box)) 1) point)))
  (tuple true (call near-point (tuple 10 5) (. ([] (call path-crossings (call line (tuple 15 5) (tuple -5 5)) (call box)) 0) point)))
  (tuple true (call near-point (tuple 10 5) (. ([] (call path-crossings (call box) (call line (tuple -5 5) (tuple 15 5))) 0) point)))
  (tuple true (call near-point (tuple 0 5) (. ([] (call path-crossings (call box) (call line (tuple -5 5) (tuple 15 5))) 1) point)))
  (tuple 2 (. (call path-crossings (call box) (call rectangle (call Rect 5 5 10 10))) length))
  (tuple true (call near-point (tuple 10 5) (. ([] (call path-crossings (call box) (call rectangle (call Rect 5 5 10 10))) 0) point)))
  (tuple true (call near-point (tuple 5 10) (. ([] (call path-crossings (call box) (call rectangle (call Rect 5 5 10 10))) 1) point)))
  (tuple 2 (. (call path-crossings (call line (tuple -5 10) (tuple 25 10)) (call disc)) length))
  (tuple true (call near-point (tuple 0 10) (. ([] (call path-crossings (call line (tuple -5 10) (tuple 25 10)) (call disc)) 0) point) 0.001))
  (tuple true (call near-point (tuple 20 10) (. ([] (call path-crossings (call line (tuple -5 10) (tuple 25 10)) (call disc)) 1) point) 0.001))
  (tuple true (call crossings-ascend (call path-crossings (call disc) (call circle (tuple 18 10) 10))))
)

(fn-expr _ box _
  (call rectangle (call Rect 0 0 10 10))
)

(fn-expr _ disc _
  (call circle (tuple 10 10) 10)
)

(fn-do _ swerve _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path cubic-curve-to) 120 0 -40 60 80 40)
  (return path)
)

(fn-do _ nearest-agrees _
  (param path Path)
  (param spot Point)
  (let found (call path-nearest path spot))
  (return-if false (if (not found)))
  (blank)
  (let least 100000000.0)
  (let along (. found point))
  (let index Index 0)
  (for (in curve (. path curves))
    (for (in step (.. 0 4000))
      (= least (call min least (call (. (call network-curve-point curve (/ (as step Float) 4000)) distance) spot)))
    )
    (if (and (>= (. found parameter) (as index Float)) (<= (. found parameter) (+ (as index Float) 1)))
      (= along (call network-curve-point curve (- (. found parameter) (as index Float))))
    )
    (+= index 1)
  )
  (let slack (call max 0.0005 (* least 0.000002)))
  (case? (> (call abs (- (. found distance) least)) slack)
    (return false)
  )
  (case? (> (call abs (- (call (. found point distance) spot) (. found distance))) slack)
    (return false)
  )
  (default
    (return (< (call (. along distance) (. found point)) 0.001))
  )
)

(fn-expr _ crossings-ascend _
  (param crossings (list PathCrossing))
  (and (== (. crossings length) 2) (< (. ([] crossings 0) along) (. ([] crossings 1) along)))
)
