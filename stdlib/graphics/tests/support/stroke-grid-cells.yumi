/graphics/color
/graphics/path
/graphics/point
/graphics/primitives
/graphics/shapes
/graphics/stroke
/math
/units

+ stroke-grid-cell-count Index = 12
+ stroke-grid-cell-width I32 = 251
+ stroke-grid-cell-height I32 = 248

━━━━━━━━━━━━━━━━━━━━
+ stroke-grid-cell-name String
    - index

|? index < 10
    "0$index"
??
    "$index"

━━━━━━━━━━━━━━━━━━━━
+ stroke-grid-cell-stroked-path Path
    - index
    - cell Rect

stroke()
    - source
    - amount
    - stroke-grid-cell-alignment(index)
    - stroke-grid-cell-join-type(index)
    - stroke-grid-cell-cap(index)
    - 5
    - 0

.. center = cell.center
.. radius = min(cell.width, cell.height) * 0.34
.. source = stroke-grid-cell-shape(index, center, radius)
.. amount = stroke-grid-cell-stroke-amount(index)

━━━━━━━━━━━━━━━━━━━━
+ stroke-grid-cell-stroke-amount Length
    - index

match index
    |= 8
        amount * 0.5
    ??
        amount

.. amount = 4 + (index as Float) * 2.35

━━━━━━━━━━━━━━━━━━━━
+ do stroke-grid-cell-shape Path
    - index
    - center Point
    - radius Length

. kind = index % 12
if kind == 0
    = line(center + (-radius * 0.82, -radius * 0.22), center + (radius * 0.82, radius * 0.22))
else if kind == 1
    . path = rectangle()
        - Rect()
            - center.x - radius * 0.72
            - center.y - radius * 0.5
            - radius * 1.44
            - radius
    path.rotate(-9deg, center)
    = path
else if kind == 2
    . path = polygon(3, radius * 1.82, center)
    path.rotate(18deg, center)
    = path
else if kind == 3
    = circle(center, radius * 0.7)
else if kind == 4
    . path = polygon(5, radius * 1.78, center)
    path.rotate(-12deg, center)
    = path
else if kind == 5
    = stroke-grid-zigzag(center, radius)
else if kind == 6
    = stroke-grid-bounded-spiral(center, radius * 0.95, 3.4, 72, -45deg)
else if kind == 7
    = stroke-grid-cubic-snake(center, radius)
else if kind == 8
    = stroke-grid-rosette(center, radius * 0.92, radius * 0.28, 9, -18deg)
else if kind == 9
    = stroke-grid-lissajous(center, radius * 0.9)
else if kind == 10
    = stroke-grid-petal-loop(center, radius)
else
    = stroke-grid-comet-loop(center, radius)

━━━━━━━━━━━━━━━━━━━━
+ stroke-grid-cell-alignment StrokeAlignment
    - index

.center

━━━━━━━━━━━━━━━━━━━━
+ stroke-grid-cell-join-type JoinType
    - index

|? index >= 8
    .round-join-type
|? index % 3 == 0
    .round-join-type
|? index % 3 == 1
    .miter-join-type
??
    .square-join-type

━━━━━━━━━━━━━━━━━━━━
+ stroke-grid-cell-cap LineCap
    - index

match cap
    |= 0
        .round
    ??
        .square

.. cap = index % 2

━━━━━━━━━━━━━━━━━━━━
+ stroke-grid-cell-fill-color RGBA
    - index

match color
    |= 0
        RGBA(89%, 26%, 35%, 62%)
    |= 1
        RGBA(10%, 48%, 78%, 58%)
    |= 2
        RGBA(18%, 63%, 42%, 58%)
    |= 3
        RGBA(90%, 55%, 14%, 58%)
    |= 4
        RGBA(44%, 34%, 78%, 60%)
    |= 5
        RGBA(4%, 61%, 66%, 58%)
    |= 6
        RGBA(83%, 31%, 66%, 58%)
    |= 7
        RGBA(53%, 58%, 9%, 58%)
    |= 8
        RGBA(73%, 23%, 15%, 58%)
    |= 9
        RGBA(18%, 45%, 72%, 60%)
    |= 10
        RGBA(62%, 28%, 77%, 58%)
    ??
        RGBA(7%, 55%, 36%, 58%)

.. color = index % 12

━━━━━━━━━━━━━━━━━━━━
_ do stroke-grid-zigzag
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.82, -radius * 0.45))
path.line-to(center + (-radius * 0.42, radius * 0.36))
path.line-to(center + (-radius * 0.05, -radius * 0.24))
path.line-to(center + (radius * 0.34, radius * 0.48))
path.line-to(center + (radius * 0.82, -radius * 0.34))
= path

━━━━━━━━━━━━━━━━━━━━
_ do stroke-grid-cubic-snake
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.86, radius * 0.34))
path.cubic-curve-to()
    - center + (-radius * 0.65, -radius * 0.85)
    - center + (-radius * 0.18, radius * 0.82)
    - center + (radius * 0.06, -radius * 0.08)
path.cubic-curve-to()
    - center + (radius * 0.34, -radius * 1.04)
    - center + (radius * 0.76, radius * 0.74)
    - center + (radius * 0.88, -radius * 0.24)
= path

━━━━━━━━━━━━━━━━━━━━
_ do stroke-grid-bounded-spiral
    - center Point
    - radius Length
    - coils Float
    - steps Int
    - rotation Radians

. path = Path()
for i in 0 .. < steps
    . t = (i as Float) / ((steps - 1) as Float)
    . angle = rotation + t * coils * π * 2
    . point = center.translate-at-angle(angle, radius * t)
    if i == 0
        path.move-to(point)
    else
        path.line-to(point)

= path

━━━━━━━━━━━━━━━━━━━━
_ do stroke-grid-rosette
    - center Point
    - outer-radius Length
    - inner-radius Length
    - lobes Int
    - rotation Radians

. path = Path()
. count = lobes * 2
. step = (π * 2) / count

for i in 0 .. < count
    . a1 = rotation + step * i
    . a2 = rotation + step * (i + 1)
    . r1 = if i % 2 == 0 then outer-radius else inner-radius
    . r2 = if (i + 1) % 2 == 0 then outer-radius else inner-radius
    . bulge = outer-radius * (0.52 + ((i % 3) as Float) * 0.08)
    . p1 = center.translate-at-angle(a1, r1)
    . p2 = center.translate-at-angle(a2, r2)
    . h1 = center.translate-at-angle(a1 + step * 0.42, r1 + bulge)
    . h2 = center.translate-at-angle(a2 - step * 0.42, r2 + bulge)

    if i == 0
        path.move-to(p1)

    path.cubic-curve-to(h1, h2, p2)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do stroke-grid-lissajous
    - center Point
    - radius Length

. path = Path()
. first = true
for t in 0.0 .. < π * 2.0 by 0.11
    . point = Point()
        - center.x + sin(t * 3.0 + 0.35) * radius
        - center.y + sin(t * 4.0) * radius * 0.72
    if first
        path.move-to(point)
        first = false
    else
        path.line-to(point)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do stroke-grid-petal-loop
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (0, -radius * 0.9))
path.cubic-curve-to()
    - center + (radius * 1.25, -radius * 0.72)
    - center + (radius * 0.35, radius * 0.28)
    - center + (radius * 0.78, radius * 0.72)
path.cubic-curve-to()
    - center + (radius * 0.18, radius * 1.08)
    - center + (-radius * 0.4, radius * 0.34)
    - center + (-radius * 0.82, radius * 0.66)
path.cubic-curve-to()
    - center + (-radius * 1.22, radius * 0.08)
    - center + (-radius * 0.55, -radius * 0.72)
    - center + (0, -radius * 0.9)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do stroke-grid-comet-loop
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.9, 0))
path.cubic-curve-to()
    - center + (-radius * 0.5, -radius * 1.05)
    - center + (radius * 0.32, -radius * 0.62)
    - center + (radius * 0.68, -radius * 0.18)
path.cubic-curve-to()
    - center + (radius * 1.24, radius * 0.5)
    - center + (-radius * 0.18, radius * 0.95)
    - center + (-radius * 0.05, radius * 0.04)
path.cubic-curve-to()
    - center + (-radius * 0.34, -radius * 0.32)
    - center + (-radius * 0.54, radius * 0.38)
    - center + (-radius * 0.9, 0)
path.close()
= path
