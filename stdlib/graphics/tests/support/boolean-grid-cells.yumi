RGBA(78%, 15%, 27%, 68%)

━━━━━━━━━━━━━━━━━━━━
+ boolean-grid-clip-source-a-fill-color

RGBA(12%, 43%, 78%, 10%)

━━━━━━━━━━━━━━━━━━━━
