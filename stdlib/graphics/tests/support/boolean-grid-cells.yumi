/graphics/boolean
/graphics/color
/graphics/path
/graphics/point
/graphics/primitives
/graphics/shapes
/math
/units

+ boolean-grid-cell-count Index = 20
+ boolean-grid-cell-width I32 = 266
+ boolean-grid-cell-height I32 = 200

━━━━━━━━━━━━━━━━━━━━
+ boolean-grid-cell-name String
    - index

|? index < 10
    "0$index"
??
    "$index"

━━━━━━━━━━━━━━━━━━━━
+ boolean-grid-cell-source-a Path
    - index
    - cell Rect

|? operation == 3
    boolean-grid-clip-source-a(kind, cell)
|? kind == 0
    boolean-grid-rect-a(cell)
|? kind == 1
    boolean-grid-diamond-a(cell)
|? kind == 2
    boolean-grid-curve-a(cell)
|? kind == 3
    boolean-grid-contained-a(cell)
??
    boolean-grid-shared-edge-a(cell)

.. operation = index % 4
.. kind = boolean-grid-case-index(index)

━━━━━━━━━━━━━━━━━━━━
+ boolean-grid-cell-source-b Path
    - index
    - cell Rect

|? operation == 3
    boolean-grid-clip-source-b(kind, cell)
|? kind == 0
    boolean-grid-rect-b(cell)
|? kind == 1
    boolean-grid-diamond-b(cell)
|? kind == 2
    boolean-grid-curve-b(cell)
|? kind == 3
    boolean-grid-contained-b(cell)
??
    boolean-grid-shared-edge-b(cell)

.. operation = index % 4
.. kind = boolean-grid-case-index(index)

━━━━━━━━━━━━━━━━━━━━
+ boolean-grid-cell-result Path?
    - index
    - cell Rect

match operation
    |= 0
        union(a, b)
    |= 1
        intersect(a, b)
    |= 2
        subtract(a, b)
    ??
        clip(a, b)

.. a = boolean-grid-cell-source-a(index, cell)
.. b = boolean-grid-cell-source-b(index, cell)
.. operation = index % 4

━━━━━━━━━━━━━━━━━━━━
+ boolean-grid-cell-result-fill-color RGBA
    - index

match operation
    |= 0
        RGBA(16%, 56%, 34%, 62%)
    |= 1
        RGBA(90%, 55%, 9%, 64%)
    |= 2
        RGBA(24%, 45%, 82%, 62%)
    ??
        RGBA(3%, 60%, 66%, 62%)

.. operation = index % 4

━━━━━━━━━━━━━━━━━━━━
+ boolean-grid-source-a-fill-color

RGBA(12%, 43%, 78%, 13%)

━━━━━━━━━━━━━━━━━━━━
+ boolean-grid-source-b-fill-color

RGBA(86%, 24%, 35%, 13%)

━━━━━━━━━━━━━━━━━━━━
+ boolean-grid-source-a-stroke-color

RGBA(8%, 34%, 74%, 68%)

━━━━━━━━━━━━━━━━━━━━
