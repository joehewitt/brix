(import /graphics/curve-kernels)
(import /graphics/offset)
(import /graphics/offset-kernels)
(import /graphics/path)
(import /graphics/path-set)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/stroke)
(import /math)
(blank)
(prop _ offset-deviation-limit _ (= 0.5))
(prop _ offset-omission-limit _ (= 1.0))
(prop _ offset-validity-margin _ (= 0.5))

(fn-do + round-offset _
  (param source Path)
  (param distance Length)
  (let result (call Path))
  (for (in path (. (call offset-path (call PathSet (list source)) distance .round-join-type) paths))
    (call (. result add-path) path)
  )
  (return result)
)

(fn-expr + offset-fidelity _
  (param source Path)
  (param distance Length)
  (case? (> deviation offset-deviation-limit)
    (str "deviates by " deviation)
  )
  (case? (> omission offset-omission-limit)
    (str "omits by " omission)
  )
  (default
    "faithful"
  )
  (where
    (lazy result (call round-offset source distance))
    (lazy segments (call path-segments source 48))
    (lazy deviation (call offset-deviation segments result distance))
    (lazy omission (call offset-omission source segments result distance))
  )
)

(fn-do + offset-deviation _
  (param segments (list Point))
  (param result Path)
  (param distance Length)
  (let worst Length)
  (let pieces (call path-segments result 12))
  (let index 0)
  (while (< index (. pieces length))
    (let middle (* (+ ([] pieces index) ([] pieces (+ index 1))) 0.5))
    (let deviation (call abs (- (call segments-distance middle segments) (call abs distance))))
    (if (> deviation worst)
      (= worst deviation)
    )
    (+= index 2)
  )
  (return worst)
)

(fn-do + offset-omission _
  (param source Path)
  (param segments (list Point))
  (param result Path)
  (param distance Length)
  (let sign (if-expr (and (. source is-closed) (not (. source is-clockwise))) -1.0 1.0))
  (let outward
    (scope (if-expr (> distance 0) plus-margin (- distance offset-validity-margin))
      (lazy plus-margin (+ distance offset-validity-margin))
    )
  )
  (let pieces (call path-segments result 12))
  (let worst Length)
  (let reader (. source curve-reader))
  (while (call (. reader next))
    (let is-line (== (. reader type) .segment-type-line))
    (let p0 (call Point (. reader x1) (. reader y1)))
    (let p3 (call Point (. reader x2) (. reader y2)))
    (let p1 (if-expr is-line p0 (call Point (. reader handle-out-x) (. reader handle-out-y))))
    (let p2 (if-expr is-line p3 (call Point (. reader handle-in-x) (. reader handle-in-y))))
    (if (< (call (. p0 distance) p3) 0.001)
      (continue)
    )
    (blank)
    (for (in step (..< 1 24))
      (let t (/ (as step Float) 24))
      (let point (call source-offset-point p0 p1 p2 p3 t distance sign is-line))
      (if (< (call segments-distance point segments) (- (call abs distance) 0.02))
        (continue)
      )
      (let beyond (call source-offset-point p0 p1 p2 p3 t outward sign is-line))
      (if (< (call segments-distance beyond segments) (- (call abs outward) 0.02))
        (continue)
      )
      (blank)
      (let omission (call segments-distance point pieces))
      (if (> omission worst)
        (= worst omission)
      )
    )
  )
  (return worst)
)

(fn-do + path-segments _
  (param path Path)
  (param steps Int)
  (let segments (list Point))
  (let reader (. path curve-reader))
  (while (call (. reader next))
    (let previous (call Point (. reader x1) (. reader y1)))
    (if (== (. reader type) .segment-type-line)
      (+= segments previous)
      (+= segments (call Point (. reader x2) (. reader y2)))
      (else
        (for (in step (..< 1 (+ steps 1)))
          (let sample
            (call cubic-evaluate-xy
              (block
                (arg (. reader x1))
                (arg (. reader y1))
                (arg (. reader handle-out-x))
                (arg (. reader handle-out-y))
                (arg (. reader handle-in-x))
                (arg (. reader handle-in-y))
                (arg (. reader x2))
                (arg (. reader y2))
                (arg (/ (as step Float) steps))
              )
            )
          )
          (let point (call Point (. sample x) (. sample y)))
          (+= segments previous)
          (+= segments point)
          (= previous point)
        )
      )
    )
  )
  (return segments)
)

(fn-do + segments-distance _
  (param point Point)
  (param segments (list Point))
  (let best Length 1e100)
  (let index 0)
  (while (< index (. segments length))
    (let start ([] segments index))
    (let span (- ([] segments (+ index 1)) start))
    (let length2 (+ (* (. span x) (. span x)) (* (. span y) (. span y))))
    (let t 0.0)
    (if (> length2 0)
      (= t (call max 0.0 (call min 1.0 (/ (call (. (- point start) dot) span) length2))))
    )
    (let distance (call (. point distance) (+ start (* span t))))
    (if (< distance best)
      (= best distance)
    )
    (+= index 2)
  )
  (return best)
)

(fn-expr _ source-offset-point _
  (param p0 Point)
  (param p1 Point)
  (param p2 Point)
  (param p3 Point)
  (param t PointOnCurve)
  (param distance Length)
  (param sign Float)
  (param is-line Bool)
  (case? is-line
    (+ p0 (* (- p3 p0) t) (* (call offset-unit-normal (call unit-vector (- p3 p0)) sign) distance))
  )
  (default
    (call offset-cubic-point p0 p1 p2 p3 t distance sign)
  )
)
