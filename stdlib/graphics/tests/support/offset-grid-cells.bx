(import /graphics/color)
(import /graphics/offset)
(import /graphics/path)
(import /graphics/path-set)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/stroke)
(import /math)
(import /units)
(blank)
(prop + offset-grid-open-shape-count Int (= 8))
(prop + offset-grid-closed-shape-count Int (= 8))
(prop + offset-grid-source-shape-count Int (= 16))
(prop + offset-grid-cell-count Int (= 32))
(prop + offset-grid-cell-width I32 (= 251))
(prop + offset-grid-cell-height I32 (= 248))

(fn-expr + offset-grid-cell-name String
  (param index _)
  (case? (< index 10)
    (str "0" index)
  )
  (default
    (str index)
  )
)

(fn-expr + offset-grid-cell-source-path Path
  (param index _)
  (param cell Rect)
  (call offset-grid-cell-shape (call offset-grid-cell-shape-index index) center radius)
  (where
    (lazy center (. cell center))
    (lazy radius (* (call min (. cell width) (. cell height)) 0.34))
  )
)

(fn-expr + offset-grid-cell-result-layer PathSet
  (param index _)
  (param cell Rect)
  (call offset-path
    (block
      (arg (call PathSet (list source)))
      (arg (call offset-grid-cell-distance index))
      (arg (call offset-grid-cell-join-type index))
      (arg 5)
    )
  )
  (where
    (lazy source (call offset-grid-cell-source-path index cell))
  )
)

(fn-do + offset-grid-cell-result-path Path
  (param index _)
  (param cell Rect)
  (let layer (call offset-grid-cell-result-layer index cell))
  (let result Path)
  (for (in path (. layer paths))
    (if (. result count)
      (call (. result add-path) path)
      (else
        (= result path)
      )
    )
  )
  (return result)
)

(fn-expr + offset-grid-cell-distance Length
  (param index _)
  (case? (call offset-grid-cell-is-inner index)
    (- amount)
  )
  (default
    amount
  )
  (where
    (lazy amount (call offset-grid-cell-base-distance (call offset-grid-cell-shape-index index)))
  )
)

(fn-expr + offset-grid-cell-shape-index Index
  (param index _)
  (% index 16)
)

(fn-expr + offset-grid-cell-is-inner Bool
  (param index _)
  (>= index 16)
)

(fn-expr + offset-grid-cell-source-is-closed Bool
  (param index _)
  (>= kind 8)
  (where
    (lazy kind (call offset-grid-cell-shape-index index))
  )
)

(fn-expr + offset-grid-cell-base-distance Length
  (param index _)
  (match index
    (case= 0
      7
    )
    (case= 1
      8
    )
    (case= 2
      6
    )
    (case= 3
      8
    )
    (case= 4
      7
    )
    (case= 5
      6.5
    )
    (case= 6
      6
    )
    (case= 7
      8
    )
    (case= 8
      9
    )
    (case= 9
      10
    )
    (case= 10
      12
    )
    (case= 11
      9
    )
    (case= 12
      3
    )
    (case= 13
      5.5
    )
    (case= 14
      8
    )
    (default
      5.5
    )
  )
)

(fn-expr + offset-grid-cell-join-type JoinType
  (param index _)
  (match (% kind 3)
    (case= 0
      .round-join-type
    )
    (case= 1
      .miter-join-type
    )
    (default
      .square-join-type
    )
  )
  (where
    (lazy kind (call offset-grid-cell-shape-index index))
  )
)

(fn-do + offset-grid-cell-shape Path
  (param index _)
  (param center Point)
  (param radius Length)
  (let kind (% index 16))
  (if (== kind 0)
    (return (call line (+ center (tuple (* (- radius) 0.82) (* (- radius) 0.22))) (+ center (tuple (* radius 0.82) (* radius 0.22)))))
    (else-if (== kind 1)
      (return (call offset-grid-zigzag center radius))
    )
    (else-if (== kind 2)
      (return (call offset-grid-bounded-spiral center (* radius 0.95) 3.4 72 -45deg))
    )
    (else-if (== kind 3)
      (return (call offset-grid-cubic-snake center radius))
    )
    (else-if (== kind 4)
      (return (call offset-grid-open-wave center radius))
    )
    (else-if (== kind 5)
      (return (call offset-grid-hairpin center radius))
    )
    (else-if (== kind 6)
      (return (call offset-grid-close-pass center radius))
    )
    (else-if (== kind 7)
      (return (call offset-grid-cusp-sweep center radius))
    )
    (else-if (== kind 8)
      (let path
        (call rectangle
          (block
            (arg
              (call Rect
                (block
                  (arg (- (. center x) (* radius 0.72)))
                  (arg (- (. center y) (* radius 0.5)))
                  (arg (* radius 1.44))
                  (arg radius)
                )
              )
            )
          )
        )
      )
      (call (. path rotate) -9deg center)
      (return path)
    )
    (else-if (== kind 9)
      (let path (call polygon 3 (* radius 1.82) center))
      (call (. path rotate) 18deg center)
      (return path)
    )
    (else-if (== kind 10)
      (return (call circle center (* radius 0.7)))
    )
    (else-if (== kind 11)
      (let path (call polygon 5 (* radius 1.78) center))
      (call (. path rotate) -12deg center)
      (return path)
    )
    (else-if (== kind 12)
      (return (call offset-grid-rosette center (* radius 0.92) (* radius 0.28) 9 -18deg))
    )
    (else-if (== kind 13)
      (return (call offset-grid-lissajous center (* radius 0.9)))
    )
    (else-if (== kind 14)
      (return (call offset-grid-petal-loop center radius))
    )
  )
  (blank)
  (return (call offset-grid-bowtie center radius))
)

(fn-expr + offset-grid-cell-fill-color RGBA
  (param index _)
  (match color
    (case= 0
      (call RGBA 89% 26% 35% alpha)
    )
    (case= 1
      (call RGBA 4% 61% 66% alpha)
    )
    (case= 2
      (call RGBA 83% 31% 66% alpha)
    )
    (case= 3
      (call RGBA 53% 58% 9% alpha)
    )
    (case= 4
      (call RGBA 55% 36% 74% alpha)
    )
    (case= 5
      (call RGBA 20% 57% 34% alpha)
    )
    (case= 6
      (call RGBA 72% 35% 19% alpha)
    )
    (case= 7
      (call RGBA 18% 51% 74% alpha)
    )
    (case= 8
      (call RGBA 10% 48% 78% alpha)
    )
    (case= 9
      (call RGBA 18% 63% 42% alpha)
    )
    (case= 10
      (call RGBA 90% 55% 14% alpha)
    )
    (case= 11
      (call RGBA 44% 34% 78% alpha)
    )
    (case= 12
      (call RGBA 73% 23% 15% alpha)
    )
    (case= 13
      (call RGBA 24% 45% 82% alpha)
    )
    (case= 14
      (call RGBA 76% 43% 12% alpha)
    )
    (default
      (call RGBA 12% 57% 64% alpha)
    )
  )
  (where
    (lazy color (call offset-grid-cell-shape-index index))
    (lazy alpha (if-expr (call offset-grid-cell-is-inner index) 50% 58%))
  )
)

(fn-expr + offset-grid-source-stroke-color _
  (call RGBA 3% 7% 14% 38%)
)

(fn-do _ offset-grid-zigzag _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.82) (* (- radius) 0.45))))
  (call (. path line-to) (+ center (tuple (* (- radius) 0.42) (* radius 0.36))))
  (call (. path line-to) (+ center (tuple (* (- radius) 0.05) (* (- radius) 0.24))))
  (call (. path line-to) (+ center (tuple (* radius 0.34) (* radius 0.48))))
  (call (. path line-to) (+ center (tuple (* radius 0.82) (* (- radius) 0.34))))
  (return path)
)

(fn-do _ offset-grid-cubic-snake _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.86) (* radius 0.34))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 0.65) (* (- radius) 0.85))))
      (arg (+ center (tuple (* (- radius) 0.18) (* radius 0.82))))
      (arg (+ center (tuple (* radius 0.06) (* (- radius) 0.08))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 0.34) (* (- radius) 1.04))))
      (arg (+ center (tuple (* radius 0.76) (* radius 0.74))))
      (arg (+ center (tuple (* radius 0.88) (* (- radius) 0.24))))
    )
  )
  (return path)
)

(fn-do _ offset-grid-bounded-spiral _
  (param center Point)
  (param radius Length)
  (param coils Float)
  (param steps Int)
  (param rotation Radians)
  (let path (call Path))
  (for (in i (..< 0 steps))
    (let t (/ (as i Float) (as (- steps 1) Float)))
    (let angle (+ rotation (* t coils π 2)))
    (let point (call (. center translate-at-angle) angle (* radius t)))
    (if (== i 0)
      (call (. path move-to) point)
      (else
        (call (. path line-to) point)
      )
    )
  )
  (blank)
  (return path)
)

(fn-do _ offset-grid-open-wave _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.9) (* radius 0.15))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 0.68) (* (- radius) 0.85))))
      (arg (+ center (tuple (* (- radius) 0.32) (* radius 0.95))))
      (arg (+ center (tuple (* (- radius) 0.06) (* radius 0.02))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 0.26) (* (- radius) 1.0))))
      (arg (+ center (tuple (* radius 0.62) (* radius 0.82))))
      (arg (+ center (tuple (* radius 0.9) (* (- radius) 0.2))))
    )
  )
  (return path)
)

(fn-do _ offset-grid-hairpin _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.86) (* (- radius) 0.55))))
  (call (. path line-to) (+ center (tuple (* radius 0.2) (* (- radius) 0.55))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 0.88) (* (- radius) 0.55))))
      (arg (+ center (tuple (* radius 0.88) (* radius 0.52))))
      (arg (+ center (tuple (* radius 0.2) (* radius 0.52))))
    )
  )
  (call (. path line-to) (+ center (tuple (* (- radius) 0.86) (* radius 0.52))))
  (return path)
)

(fn-do _ offset-grid-close-pass _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.82) (* (- radius) 0.5))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 0.2) (* (- radius) 1.0))))
      (arg (+ center (tuple (* radius 0.55) (* (- radius) 0.88))))
      (arg (+ center (tuple (* radius 0.68) (* (- radius) 0.18))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 0.82) (* radius 0.6))))
      (arg (+ center (tuple (* (- radius) 0.48) (* radius 0.58))))
      (arg (+ center (tuple (* (- radius) 0.58) (* (- radius) 0.12))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 0.56) (* (- radius) 0.42))))
      (arg (+ center (tuple (* (- radius) 0.18) (* (- radius) 0.28))))
      (arg (+ center (tuple (* radius 0.12) (* radius 0.12))))
    )
  )
  (return path)
)

(fn-do _ offset-grid-cusp-sweep _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.8) (* radius 0.42))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 0.2) (* (- radius) 0.95))))
      (arg (+ center (tuple (* radius 0.16) (* (- radius) 0.95))))
      (arg (+ center (tuple (* (- radius) 0.04) (* radius 0.05))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 0.2) (* radius 0.85))))
      (arg (+ center (tuple (* radius 0.72) (* radius 0.62))))
      (arg (+ center (tuple (* radius 0.84) (* (- radius) 0.46))))
    )
  )
  (return path)
)

(fn-do _ offset-grid-rosette _
  (param center Point)
  (param outer-radius Length)
  (param inner-radius Length)
  (param lobes Int)
  (param rotation Radians)
  (let path (call Path))
  (let count (* lobes 2))
  (let step (/ (* π 2) count))
  (blank)
  (for (in i (..< 0 count))
    (let a1 (+ rotation (* step i)))
    (let a2 (+ rotation (* step (+ i 1))))
    (let r1 (if-expr (== (% i 2) 0) outer-radius inner-radius))
    (let r2 (if-expr (== (% (+ i 1) 2) 0) outer-radius inner-radius))
    (let bulge (* outer-radius (+ 0.52 (* (as (% i 3) Float) 0.08))))
    (let p1 (call (. center translate-at-angle) a1 r1))
    (let p2 (call (. center translate-at-angle) a2 r2))
    (let h1 (call (. center translate-at-angle) (+ a1 (* step 0.42)) (+ r1 bulge)))
    (let h2 (call (. center translate-at-angle) (- a2 (* step 0.42)) (+ r2 bulge)))
    (blank)
    (if (== i 0)
      (call (. path move-to) p1)
    )
    (blank)
    (call (. path cubic-curve-to) h1 h2 p2)
  )
  (blank)
  (call (. path close))
  (return path)
)

(fn-do _ offset-grid-lissajous _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (let first true)
  (for (in t (..< 0.0 (* π 2.0) (by: 0.11)))
    (let point
      (call Point
        (block
          (arg (+ (. center x) (* (call sin (+ (* t 3.0) 0.35)) radius)))
          (arg (+ (. center y) (* (call sin (* t 4.0)) radius 0.72)))
        )
      )
    )
    (if first
      (call (. path move-to) point)
      (= first false)
      (else
        (call (. path line-to) point)
      )
    )
  )
  (blank)
  (call (. path close))
  (return path)
)

(fn-do _ offset-grid-petal-loop _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple 0 (* (- radius) 0.9))))
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 1.25) (* (- radius) 0.72))))
      (arg (+ center (tuple (* radius 0.35) (* radius 0.28))))
      (arg (+ center (tuple (* radius 0.78) (* radius 0.72))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* radius 0.18) (* radius 1.08))))
      (arg (+ center (tuple (* (- radius) 0.4) (* radius 0.34))))
      (arg (+ center (tuple (* (- radius) 0.82) (* radius 0.66))))
    )
  )
  (call (. path cubic-curve-to)
    (block
      (arg (+ center (tuple (* (- radius) 1.22) (* radius 0.08))))
      (arg (+ center (tuple (* (- radius) 0.55) (* (- radius) 0.72))))
      (arg (+ center (tuple 0 (* (- radius) 0.9))))
    )
  )
  (call (. path close))
  (return path)
)

(fn-do _ offset-grid-bowtie _
  (param center Point)
  (param radius Length)
  (let path (call Path))
  (call (. path move-to) (+ center (tuple (* (- radius) 0.76) (* (- radius) 0.58))))
  (call (. path line-to) (+ center (tuple (* radius 0.76) (* radius 0.58))))
  (call (. path line-to) (+ center (tuple (* (- radius) 0.76) (* radius 0.58))))
  (call (. path line-to) (+ center (tuple (* radius 0.76) (* (- radius) 0.58))))
  (call (. path close))
  (return path)
)
