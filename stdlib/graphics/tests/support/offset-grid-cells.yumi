/graphics/color
/graphics/offset
/graphics/path
/graphics/path-set
/graphics/point
/graphics/primitives
/graphics/shapes
/graphics/stroke
/math
/units

+ offset-grid-open-shape-count Int = 8
+ offset-grid-closed-shape-count Int = 8
+ offset-grid-source-shape-count Int = 16
+ offset-grid-cell-count Int = 32
+ offset-grid-cell-width I32 = 251
+ offset-grid-cell-height I32 = 248

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-cell-name String
    - index

|? index < 10
    "0$index"
??
    "$index"

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-cell-source-path Path
    - index
    - cell Rect

offset-grid-cell-shape(offset-grid-cell-shape-index(index), center, radius)

.. center = cell.center
.. radius = min(cell.width, cell.height) * 0.34

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-cell-result-layer PathSet
    - index
    - cell Rect

offset-path()
    - PathSet([source])
    - offset-grid-cell-distance(index)
    - offset-grid-cell-join-type(index)
    - 5

.. source = offset-grid-cell-source-path(index, cell)

━━━━━━━━━━━━━━━━━━━━
+ do offset-grid-cell-result-path Path
    - index
    - cell Rect

. layer = offset-grid-cell-result-layer(index, cell)
. result Path
for path in layer.paths
    if result.count
        result.add-path(path)
    else
        result = path
= result

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-cell-distance Length
    - index

|? offset-grid-cell-is-inner(index)
    -amount
??
    amount

.. amount = offset-grid-cell-base-distance(offset-grid-cell-shape-index(index))

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-cell-shape-index Index
    - index

index % 16

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-cell-is-inner Bool
    - index

index >= 16

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-cell-source-is-closed Bool
    - index

kind >= 8

.. kind = offset-grid-cell-shape-index(index)

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-cell-base-distance Length
    - index

match index
    |= 0
        7
    |= 1
        8
    |= 2
        6
    |= 3
        8
    |= 4
        7
    |= 5
        6.5
    |= 6
        6
    |= 7
        8
    |= 8
        9
    |= 9
        10
    |= 10
        12
    |= 11
        9
    |= 12
        3
    |= 13
        5.5
    |= 14
        8
    ??
        5.5

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-cell-join-type JoinType
    - index

match kind % 3
    |= 0
        .round-join-type
    |= 1
        .miter-join-type
    ??
        .square-join-type

.. kind = offset-grid-cell-shape-index(index)

━━━━━━━━━━━━━━━━━━━━
+ do offset-grid-cell-shape Path
    - index
    - center Point
    - radius Length

. kind = index % 16
if kind == 0
    = line(center + (-radius * 0.82, -radius * 0.22), center + (radius * 0.82, radius * 0.22))
else if kind == 1
    = offset-grid-zigzag(center, radius)
else if kind == 2
    = offset-grid-bounded-spiral(center, radius * 0.95, 3.4, 72, -45deg)
else if kind == 3
    = offset-grid-cubic-snake(center, radius)
else if kind == 4
    = offset-grid-open-wave(center, radius)
else if kind == 5
    = offset-grid-hairpin(center, radius)
else if kind == 6
    = offset-grid-close-pass(center, radius)
else if kind == 7
    = offset-grid-cusp-sweep(center, radius)
else if kind == 8
    . path = rectangle()
        - Rect()
            - center.x - radius * 0.72
            - center.y - radius * 0.5
            - radius * 1.44
            - radius
    path.rotate(-9deg, center)
    = path
else if kind == 9
    . path = polygon(3, radius * 1.82, center)
    path.rotate(18deg, center)
    = path
else if kind == 10
    = circle(center, radius * 0.7)
else if kind == 11
    . path = polygon(5, radius * 1.78, center)
    path.rotate(-12deg, center)
    = path
else if kind == 12
    = offset-grid-rosette(center, radius * 0.92, radius * 0.28, 9, -18deg)
else if kind == 13
    = offset-grid-lissajous(center, radius * 0.9)
else if kind == 14
    = offset-grid-petal-loop(center, radius)

= offset-grid-bowtie(center, radius)

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-cell-fill-color RGBA
    - index

match color
    |= 0
        RGBA(89%, 26%, 35%, alpha)
    |= 1
        RGBA(4%, 61%, 66%, alpha)
    |= 2
        RGBA(83%, 31%, 66%, alpha)
    |= 3
        RGBA(53%, 58%, 9%, alpha)
    |= 4
        RGBA(55%, 36%, 74%, alpha)
    |= 5
        RGBA(20%, 57%, 34%, alpha)
    |= 6
        RGBA(72%, 35%, 19%, alpha)
    |= 7
        RGBA(18%, 51%, 74%, alpha)
    |= 8
        RGBA(10%, 48%, 78%, alpha)
    |= 9
        RGBA(18%, 63%, 42%, alpha)
    |= 10
        RGBA(90%, 55%, 14%, alpha)
    |= 11
        RGBA(44%, 34%, 78%, alpha)
    |= 12
        RGBA(73%, 23%, 15%, alpha)
    |= 13
        RGBA(24%, 45%, 82%, alpha)
    |= 14
        RGBA(76%, 43%, 12%, alpha)
    ??
        RGBA(12%, 57%, 64%, alpha)

.. color = offset-grid-cell-shape-index(index)
.. alpha = if offset-grid-cell-is-inner(index) then 50% else 58%

━━━━━━━━━━━━━━━━━━━━
+ offset-grid-source-stroke-color

RGBA(3%, 7%, 14%, 38%)

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-zigzag
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.82, -radius * 0.45))
path.line-to(center + (-radius * 0.42, radius * 0.36))
path.line-to(center + (-radius * 0.05, -radius * 0.24))
path.line-to(center + (radius * 0.34, radius * 0.48))
path.line-to(center + (radius * 0.82, -radius * 0.34))
= path

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-cubic-snake
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.86, radius * 0.34))
path.cubic-curve-to()
    - center + (-radius * 0.65, -radius * 0.85)
    - center + (-radius * 0.18, radius * 0.82)
    - center + (radius * 0.06, -radius * 0.08)
path.cubic-curve-to()
    - center + (radius * 0.34, -radius * 1.04)
    - center + (radius * 0.76, radius * 0.74)
    - center + (radius * 0.88, -radius * 0.24)
= path

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-bounded-spiral
    - center Point
    - radius Length
    - coils Float
    - steps Int
    - rotation Radians

. path = Path()
for i in 0 .. < steps
    . t = (i as Float) / ((steps - 1) as Float)
    . angle = rotation + t * coils * π * 2
    . point = center.translate-at-angle(angle, radius * t)
    if i == 0
        path.move-to(point)
    else
        path.line-to(point)

= path

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-open-wave
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.9, radius * 0.15))
path.cubic-curve-to()
    - center + (-radius * 0.68, -radius * 0.85)
    - center + (-radius * 0.32, radius * 0.95)
    - center + (-radius * 0.06, radius * 0.02)
path.cubic-curve-to()
    - center + (radius * 0.26, -radius * 1.0)
    - center + (radius * 0.62, radius * 0.82)
    - center + (radius * 0.9, -radius * 0.2)
= path

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-hairpin
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.86, -radius * 0.55))
path.line-to(center + (radius * 0.2, -radius * 0.55))
path.cubic-curve-to()
    - center + (radius * 0.88, -radius * 0.55)
    - center + (radius * 0.88, radius * 0.52)
    - center + (radius * 0.2, radius * 0.52)
path.line-to(center + (-radius * 0.86, radius * 0.52))
= path

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-close-pass
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.82, -radius * 0.5))
path.cubic-curve-to()
    - center + (-radius * 0.2, -radius * 1.0)
    - center + (radius * 0.55, -radius * 0.88)
    - center + (radius * 0.68, -radius * 0.18)
path.cubic-curve-to()
    - center + (radius * 0.82, radius * 0.6)
    - center + (-radius * 0.48, radius * 0.58)
    - center + (-radius * 0.58, -radius * 0.12)
path.cubic-curve-to()
    - center + (-radius * 0.56, -radius * 0.42)
    - center + (-radius * 0.18, -radius * 0.28)
    - center + (radius * 0.12, radius * 0.12)
= path

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-cusp-sweep
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.8, radius * 0.42))
path.cubic-curve-to()
    - center + (-radius * 0.2, -radius * 0.95)
    - center + (radius * 0.16, -radius * 0.95)
    - center + (-radius * 0.04, radius * 0.05)
path.cubic-curve-to()
    - center + (-radius * 0.2, radius * 0.85)
    - center + (radius * 0.72, radius * 0.62)
    - center + (radius * 0.84, -radius * 0.46)
= path

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-rosette
    - center Point
    - outer-radius Length
    - inner-radius Length
    - lobes Int
    - rotation Radians

. path = Path()
. count = lobes * 2
. step = (π * 2) / count

for i in 0 .. < count
    . a1 = rotation + step * i
    . a2 = rotation + step * (i + 1)
    . r1 = if i % 2 == 0 then outer-radius else inner-radius
    . r2 = if (i + 1) % 2 == 0 then outer-radius else inner-radius
    . bulge = outer-radius * (0.52 + ((i % 3) as Float) * 0.08)
    . p1 = center.translate-at-angle(a1, r1)
    . p2 = center.translate-at-angle(a2, r2)
    . h1 = center.translate-at-angle(a1 + step * 0.42, r1 + bulge)
    . h2 = center.translate-at-angle(a2 - step * 0.42, r2 + bulge)

    if i == 0
        path.move-to(p1)

    path.cubic-curve-to(h1, h2, p2)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-lissajous
    - center Point
    - radius Length

. path = Path()
. first = true
for t in 0.0 .. < π * 2.0 by 0.11
    . point = Point()
        - center.x + sin(t * 3.0 + 0.35) * radius
        - center.y + sin(t * 4.0) * radius * 0.72
    if first
        path.move-to(point)
        first = false
    else
        path.line-to(point)

path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-petal-loop
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (0, -radius * 0.9))
path.cubic-curve-to()
    - center + (radius * 1.25, -radius * 0.72)
    - center + (radius * 0.35, radius * 0.28)
    - center + (radius * 0.78, radius * 0.72)
path.cubic-curve-to()
    - center + (radius * 0.18, radius * 1.08)
    - center + (-radius * 0.4, radius * 0.34)
    - center + (-radius * 0.82, radius * 0.66)
path.cubic-curve-to()
    - center + (-radius * 1.22, radius * 0.08)
    - center + (-radius * 0.55, -radius * 0.72)
    - center + (0, -radius * 0.9)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do offset-grid-bowtie
    - center Point
    - radius Length

. path = Path()
path.move-to(center + (-radius * 0.76, -radius * 0.58))
path.line-to(center + (radius * 0.76, radius * 0.58))
path.line-to(center + (-radius * 0.76, radius * 0.58))
path.line-to(center + (radius * 0.76, -radius * 0.58))
path.close()
= path
