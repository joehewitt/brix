(import /graphics/matrix)
(import /graphics/network)
(import /graphics/network-regions)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Network Region Faces"))
  (call (. cases run) face-tests)
  (= cases (call (. cases then) "Network Region Holes" hole-tests))
  (= cases (call (. cases then) "Network Curved And Degenerate Regions" curved-tests))
  (= cases (call (. cases then) "Network Region Correspondence" correspondence-tests))
  (return cases)
)

(fn-do + face-tests _
  (param t TestCase)
  (let net (call network-from-path (call rectangle (call Rect 0 0 100 100))))
  (let workspace (call NetworkRegionWorkspace))
  (let faces (call (. workspace resolve) net))
  (call (. t expect) "rectangle has one face" 1 (. faces regions length))
  (call (. t check) "interior is pickable" (!= (call (. faces pick) (tuple 25 25)) null))
  (let a (call (. net add-vertex) (tuple 50 -10)))
  (let b (call (. net add-vertex) (tuple 50 110)))
  (call (. net connect) a b)
  (= faces (call (. workspace resolve) net))
  (call (. t expect) "crossing line divides rectangle" 2 (. faces regions length))
  (call (. t check) "faces have separate identities" (!= (. (!! (call (. faces pick) (tuple 25 25))) id) (. (!! (call (. faces pick) (tuple 75 25))) id)))
  (call (. t expect) "intersections do not edit network vertices" 6 (. net vertex-count))
  (let c (call (. net add-vertex) (tuple 75 25)))
  (call (. net connect) (call (. net add-vertex) (tuple 50 50)) c)
  (= faces (call (. workspace resolve) net))
  (call (. t expect) "dangling branch adds no region" 2 (. faces regions length))
  (return t)
)

(fn-do + hole-tests _
  (param t TestCase)
  (let path (call rectangle (call Rect 0 0 100 100)))
  (call (. path add-path) (call rectangle (call Rect 25 25 50 50)))
  (let net (call network-from-path path))
  (let workspace (call NetworkRegionWorkspace))
  (let faces (call (. workspace resolve) net))
  (call (. t expect) "nested loops have two selectable regions" 2 (. faces regions length))
  (let outer (!! (call (. faces pick) (tuple 10 10))))
  (let inner (!! (call (. faces pick) (tuple 50 50))))
  (call (. t check) "outer region excludes hole" (not (call (. outer contains) (tuple 50 50))))
  (call (. t check) "inner region remains paintable" (call (. inner contains) (tuple 50 50)))
  (return t)
)

(fn-do + correspondence-tests _
  (param t TestCase)
  (let net (call network-from-path (call rectangle (call Rect 0 0 100 100))))
  (let workspace (call NetworkRegionWorkspace))
  (let original (. ([] (. (call (. workspace resolve) net) regions) 0) id))
  (call (. net move-vertex) 1 (tuple -10 -10))
  (let faces (call (. workspace resolve) net))
  (call (. t expect) "moving boundary retains region identity" original (. ([] (. faces regions) 0) id))
  (let a (call (. net add-vertex) (tuple 50 -20)))
  (let b (call (. net add-vertex) (tuple 50 120)))
  (let divider (call (. net connect) a b))
  (= faces (call (. workspace resolve) net))
  (call (. t expect) "split descendants both reference predecessor" 2 (. faces regions length))
  (for (in face (. faces regions))
    (call (. t expect) "split provenance" original ([] (. face predecessors) 0))
  )
  (call (. net remove-segment) divider)
  (= faces (call (. workspace resolve) net))
  (call (. t expect) "merge produces one region" 1 (. faces regions length))
  (call (. t expect) "merge exposes both prior regions" 2 (. ([] (. faces regions) 0) predecessors length))
  (call (. net remove-segment) 1)
  (= faces (call (. workspace resolve) net))
  (call (. t expect) "opening boundary removes region" 0 (. faces regions length))
  (call (. t expect) "removed region is retired" 1 (. faces retired length))
  (blank)
  (let halves (call network-from-path (call rectangle (call Rect 0 0 100 100))))
  (call (. halves connect) (call (. halves add-vertex) (tuple 50 -20)) (call (. halves add-vertex) (tuple 50 120)))
  (let divided (call NetworkRegionWorkspace))
  (let left (. (!! (call (. (call (. divided resolve) halves) pick) (tuple 25 50))) id))
  (let right (. (!! (call (. (call (. divided resolve) halves) pick) (tuple 75 50))) id))
  (call (. halves reverse))
  (let reversed (call (. divided resolve) halves))
  (call (. t expect) "reversing keeps the left region" left (. (!! (call (. reversed pick) (tuple 25 50))) id))
  (call (. t expect) "reversing keeps the right region" right (. (!! (call (. reversed pick) (tuple 75 50))) id))
  (let far (call network-from-path (call rectangle (call Rect 0 0 100 100))))
  (call (. far reverse))
  (let travelling (call NetworkRegionWorkspace))
  (let kept (. ([] (. (call (. travelling resolve) far) regions) 0) id))
  (call (. far transform) (call matrix-from-translation (tuple 500 0)))
  (call (. t expect)
    (block
      (arg "a reversed region keeps its identity when it moves away")
      (arg kept)
      (arg (. ([] (. (call (. travelling resolve) far) regions) 0) id))
    )
  )
  (return t)
)

(fn-do + curved-tests _
  (param t TestCase)
  (let workspace (call NetworkRegionWorkspace))
  (let path (call circle (tuple 50 50) 30))
  (call (. path add-path) (call circle (tuple 80 50) 30))
  (let net (call network-from-path path))
  (let regions (call (. workspace resolve) net))
  (call (. t expect) "overlapping circles form three faces" 3 (. regions regions length))
  (call (. t check) "lens can be picked" (!= (call (. regions pick) (tuple 65 50)) null))
  (call (. t check) "left crescent can be picked" (!= (call (. regions pick) (tuple 25 50)) null))
  (= path (call circle (tuple 50 50) 30))
  (call (. path add-path) (call circle (tuple 110 50) 30))
  (= regions (call (. workspace resolve) (call network-from-path path)))
  (call (. t expect) "tangent circles remain two regions" 2 (. regions regions length))
  (= path (call circle (tuple 50 50) 30))
  (call (. path add-path) (call Path path))
  (= regions (call (. workspace resolve) (call network-from-path path)))
  (call (. t expect) "coincident circles have one region" 1 (. regions regions length))
  (= path (call rectangle (call Rect 0 0 50 50)))
  (call (. path add-path) (call rectangle (call Rect 50 0 50 50)))
  (= regions (call (. workspace resolve) (call network-from-path path)))
  (call (. t expect) "shared edge bounds two regions" 2 (. regions regions length))
  (= path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 100 100)
  (call (. path line-to) 0 100)
  (call (. path line-to) 100 0)
  (call (. path close))
  (= regions (call (. workspace resolve) (call network-from-path path)))
  (call (. t expect) "self-intersecting outline has two lobes" 2 (. regions regions length))
  (= net (call VectorNetwork))
  (let v (call (. net add-vertex) (tuple 20 20)))
  (call (. net connect) v v (tuple 60 -30) (tuple 60 30))
  (= regions (call (. workspace resolve) net))
  (call (. t expect) "single cubic loop has a region" 1 (. regions regions length))
  (call (. net connect) v v)
  (= regions (call (. workspace resolve) net))
  (call (. t expect) "zero-length edge creates no extra face" 1 (. regions regions length))
  (return t)
)
