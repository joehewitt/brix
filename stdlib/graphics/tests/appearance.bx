(import /graphics/appearance)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/style)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Aligned Stroke Painting"))
  (call (. cases run) aligned-stroke-painting-tests)
  (return cases)
)

(fn-do + aligned-stroke-painting-tests TestCase
  (param t TestCase)
  (let square (call rectangle (call Rect 20 20 60 60)))
  (let inside (call paint-aligned-stroke square (. StrokeAlignment inside) 10))
  (call (. t expect) "an inside stroke paints just inside the edge" red (call (. inside pixel-color) (call Point 22 50)))
  (call (. t expect) "an inside stroke stops at its width" transparent (call (. inside pixel-color) (call Point 35 50)))
  (call (. t expect)
    (block
      (arg "an inside stroke leaves the outside alone")
      (arg transparent)
      (arg (call (. inside pixel-color) (call Point 15 50)))
    )
  )
  (blank)
  (let outside (call paint-aligned-stroke square (. StrokeAlignment outside) 10))
  (call (. t expect) "an outside stroke paints just outside the edge" red (call (. outside pixel-color) (call Point 15 50)))
  (call (. t expect) "an outside stroke stops at its width" transparent (call (. outside pixel-color) (call Point 5 50)))
  (call (. t expect)
    (block
      (arg "an outside stroke leaves the inside alone")
      (arg transparent)
      (arg (call (. outside pixel-color) (call Point 25 50)))
    )
  )
  (blank)
  (let bar (call rectangle (call Rect 40 20 6 60)))
  (let thick (call paint-aligned-stroke bar (. StrokeAlignment inside) 20))
  (call (. t expect) "a wide inside stroke fills a thin shape" red (call (. thick pixel-color) (call Point 43 50)))
  (call (. t expect)
    (block
      (arg "a wide inside stroke never leaves its shape")
      (arg transparent)
      (arg (call (. thick pixel-color) (call Point 36 50)))
    )
  )
  (blank)
  (let centered (call paint-aligned-stroke square (. StrokeAlignment center) 10))
  (call (. t expect) "a centered stroke straddles the edge outside" red (call (. centered pixel-color) (call Point 17 50)))
  (call (. t expect) "a centered stroke straddles the edge inside" red (call (. centered pixel-color) (call Point 23 50)))
  (return t)
)

(fn-do + paint-aligned-stroke RasterCanvas
  (param path Path)
  (param alignment StrokeAlignment)
  (param width Length)
  (let canvas (call RasterCanvas 100 100 1))
  (let appearance (call VectorAppearance (. Fill none) (list (call StrokeLayer red width alignment))))
  (call paint-appearance canvas (list path) appearance)
  (return canvas)
)
