━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-image-draw-works Bool

. passed = false
. source = RasterCanvas(12, 10)
do use source
    source.fill-color = red
    source.rect(Rect(1, 2, 4, 3))

    . destination = RasterCanvas(36, 24)
    do use destination
        destination.draw-image(source, Rect(2, 3, 12, 10))
        passed = destination.nontransparent-pixel-count(Rect(3, 5, 4, 3)) > 0
        passed = passed && destination.nontransparent-pixel-count(Rect(3, 10, 4, 2)) == 0

        source.fill-color = blue
        source.rect(Rect(8, 6, 3, 2))
        destination.draw-image(source, Rect(18, 3, 12, 10))
        passed = passed && destination.nontransparent-pixel-count(Rect(26, 9, 3, 2)) > 0
        passed = passed && destination.nontransparent-pixel-count(Rect(10, 9, 3, 2)) == 0

= passed

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-outline-arrow-works

. canvas = RasterCanvas(40, 40, 1)
do use canvas
    canvas.fill-color = red
    canvas.outline(Outline(Rect(10, 10, 20, 12), 3, OutlineArrow(Side.top, 12, 5)))
    . passed = canvas.nontransparent-pixel-count(Rect(21, 6, 2, 4)) > 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(10, 5, 5, 5)) == 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(10, 22, 20, 8)) == 0
    = passed

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-hard-shadow-works

. canvas = RasterCanvas(40, 40, 1)
do use canvas
    canvas.shadow(Outline(Rect(10, 10, 10, 10)), Shadow(black, 0, 5, 5))
    . passed = canvas.nontransparent-pixel-count(Rect(21, 21, 3, 3)) == 9
    passed = passed && canvas.nontransparent-pixel-count(Rect(10, 10, 10, 10)) == 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(0, 0, 40, 10)) == 0
    = passed

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-shadow-offset-uses-points

. canvas = RasterCanvas(40, 40, 2)
do use canvas
    canvas.shadow(Outline(Rect(10, 10, 10, 10)), Shadow(black, 0, 6, 0))
    . passed = canvas.nontransparent-pixel-count(Rect(21, 12, 4, 6)) > 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(2, 10, 7, 10)) == 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(27, 10, 6, 10)) == 0
    = passed

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-nested-opacity-difference U64

. nested = RasterCanvas(90, 64, 2)
. quarter = RasterCanvas(90, 64, 2)
do use nested
    do use quarter
        nested.push()
        nested.begin-opacity(0.5%%)
        nested.push()
        nested.begin-opacity(0.5%%)
        nested.fill-color = red
        nested.stroke-color = null
        nested.rect(Rect(10, 10, 40, 30))
        nested.end-opacity()
        nested.pop()
        nested.end-opacity()
        nested.pop()

        quarter.push()
        quarter.begin-opacity(0.25%%)
        quarter.fill-color = red
        quarter.stroke-color = null
        quarter.rect(Rect(10, 10, 40, 30))
        quarter.end-opacity()
        quarter.pop()
        = nested.pixel-difference-count(quarter)

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-stroke-caps-work Bool

. butt = core-graphics-cap-endpoint-pixels(LineCap.butt)
. round = core-graphics-cap-endpoint-pixels(LineCap.round)
. square = core-graphics-cap-endpoint-pixels(LineCap.square)
. passed = butt == 0
passed = passed && round > butt
passed = passed && square > round
= passed

━━━━━━━━━━━━━━━━━━━━
_ do core-graphics-cap-endpoint-pixels U64
    - cap LineCap

. canvas = RasterCanvas(60, 40, 1)
do use canvas
    canvas.stroke-color = black
    canvas.stroke-width = 10
    canvas.stroke-cap = cap
    canvas.line(20, 20, 40, 20)
    = canvas.nontransparent-pixel-count(Rect(14, 14, 6, 12))

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-stroke-joins-work Bool

. bevel = core-graphics-join-pixels(LineJoin.bevel)
. round = core-graphics-join-pixels(LineJoin.round)
. miter = core-graphics-join-pixels(LineJoin.miter)
. passed = miter > round
passed = passed && round > bevel
= passed

━━━━━━━━━━━━━━━━━━━━
_ do core-graphics-join-pixels U64
    - join LineJoin

. canvas = RasterCanvas(60, 60, 1)
do use canvas
    canvas.stroke-color = black
    canvas.stroke-width = 12
    canvas.stroke-join = join
    canvas.begin()
    canvas.move(15, 45)
    canvas.line(40, 45)
    canvas.line(40, 20)
    canvas.end()
    = canvas.nontransparent-pixel-count(Rect(0, 0, 60, 60))

━━━━━━━━━━━━━━━━━━━━
+ do svg-canvas-transform-works Bool

. path = "/private/tmp/brix-svg-canvas-transform.svg"
. canvas = SVGCanvas(100, 80)
canvas.fill-color = black
canvas.translate(10, 2)
canvas.transform(matrix-from-scale(Dimensions(2, 3)))
canvas.circle(4, 4, 2)
canvas.write(path)

. file = File(path, FileFlags.read-mode)
. svg = file as String
file.close()

. scale-style = "transform=\"matrix(2 0 0 3"
scale-style += " 10 2)\""
. passed = if svg.find(scale-style) then true else false
= passed

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-transform-composition-works Bool

. canvas = RasterCanvas(80, 60, 1)
do use canvas
    canvas.fill-color = black
    canvas.transform(matrix-from-translation((20, 5)))
    canvas.transform(matrix-from-scale(Dimensions(2, 3)))
    canvas.rect(Rect(1, 1, 5, 4))
    . passed = canvas.nontransparent-pixel-count(Rect(22, 8, 10, 12)) > 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(0, 0, 20, 60)) == 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(40, 10, 20, 20)) == 0
    = passed

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-transform-state-works Bool

. canvas = RasterCanvas(70, 55, 1)
do use canvas
    canvas.fill-color = black
    canvas.translate(25, 0)
    canvas.push()
    canvas.translate(0, 20)
    canvas.rect(Rect(0, 0, 8, 8))
    canvas.pop()
    canvas.rect(Rect(0, 0, 8, 8))
    canvas.pop()
    canvas.fill-color = black
    canvas.rect(Rect(0, 0, 8, 8))
    . passed = canvas.nontransparent-pixel-count(Rect(25, 20, 8, 8)) > 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(25, 0, 8, 8)) > 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(0, 0, 8, 8)) > 0
    = passed

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-transform-clipping-and-text-work Bool

. passed = false
. canvas = RasterCanvas(100, 55, 1)
do use canvas
    canvas.fill-color = black
    canvas.translate(20, 0)
    canvas.clip(Rect(0, 0, 10, 10))
    canvas.rect(Rect(0, 0, 20, 20))
    passed = canvas.nontransparent-pixel-count(Rect(20, 0, 10, 10)) > 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(30, 0, 10, 10)) == 0

. text-canvas = RasterCanvas(100, 40, 1)
do use text-canvas
    text-canvas.text-color = black
    text-canvas.translate(40, 0)
    . layout = text-canvas.text-layout("Brix", 40, TextOverflow.clip)
    do use layout
        text-canvas.draw-text(layout, Rect(0, 5, 40, 24))
        passed = passed && text-canvas.nontransparent-pixel-count(Rect(0, 0, 39, 40)) == 0
        passed = passed && text-canvas.nontransparent-pixel-count(Rect(40, 0, 40, 40)) > 0
= passed

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-transform-erase-works Bool

. canvas = RasterCanvas(30, 20, 2)
do use canvas
    canvas.erase(red)
    canvas.transform(Matrix(0, 0, 0, 0, 17, 19))
    canvas.erase(null)
    . passed = canvas.nontransparent-pixel-count(Rect(0, 0, 30, 20)) == 0
    canvas.erase(blue)
    passed = passed && canvas.nontransparent-pixel-count(Rect(0, 0, 30, 20)) == 2400
    = passed

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-fill-rules-work Bool

. path = nested-contours(false)

. nonzero-center U64
. nonzero-ring U64
. nonzero = RasterCanvas(50, 50, 1)
do use nonzero
    nonzero.fill-color = black
    path.outline(nonzero)
    nonzero-center = nonzero.nontransparent-pixel-count(Rect(16, 16, 8, 8))
    nonzero-ring = nonzero.nontransparent-pixel-count(Rect(6, 6, 4, 4))

. even-odd-center U64
. even-odd-ring U64
. even-odd = RasterCanvas(50, 50, 1)
do use even-odd
    even-odd.fill-color = black
    path.outline(even-odd, FillRule.even-odd)
    even-odd-center = even-odd.nontransparent-pixel-count(Rect(16, 16, 8, 8))
    even-odd-ring = even-odd.nontransparent-pixel-count(Rect(6, 6, 4, 4))

. opposite-center U64
. opposite = RasterCanvas(50, 50, 1)
do use opposite
    opposite.fill-color = black
    nested-contours(true).outline(opposite, FillRule.nonzero)
    opposite-center = opposite.nontransparent-pixel-count(Rect(16, 16, 8, 8))

. passed = nonzero-center > 0
passed = passed && nonzero-ring > 0
passed = passed && even-odd-center == 0
passed = passed && even-odd-ring > 0
passed = passed && opposite-center == 0
= passed

━━━━━━━━━━━━━━━━━━━━
+ do core-graphics-fill-rule-strokes-work Bool

. canvas = RasterCanvas(50, 50, 1)
do use canvas
    canvas.fill-color = black
    canvas.stroke-color = blue
    canvas.stroke-width = 2
    nested-contours(false).outline(canvas, FillRule.even-odd)
    . passed = canvas.nontransparent-pixel-count(Rect(16, 16, 8, 8)) == 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(11, 16, 3, 8)) > 0
    passed = passed && canvas.nontransparent-pixel-count(Rect(4, 16, 3, 8)) > 0
    = passed

━━━━━━━━━━━━━━━━━━━━
+ do nested-contours Path
    - reverse-inner Bool

. path = Path()
path.add-path(rectangle(Rect(5, 5, 30, 30)))
. inner = rectangle(Rect(12, 12, 16, 16))
path.add-path(if reverse-inner then inner.reverse() else inner)
= path
