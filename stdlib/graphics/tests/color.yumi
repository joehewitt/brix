
/graphics/color
/graphics/tests/support/geometry
/test
/units

tests()

━━━━━━━━━━━━━━━━━━━━
+ tests TestRender

════════════════════
test("Hex Output")

"#80801a", RGB(50%, 50%, 10%) as Hex
"#264ade", RGB(15%, 29%, 87%) as Hex
"#000000", transparent as Hex
"#336699", RGBA(51.0 / 255, 102.0 / 255, 153.0 / 255) as Hex
"#ffffff", RGBA(1.2, 1.5, 2) as Hex
"#000000", RGBA(-0.5, -1, -2) as Hex

════════════════════
test("Hex Color Parsing")

"#336699", RGBA("  #336699 ") as Hex
"#aabbcc", RGBA("#AbC") as Hex
1.0, RGBA("#336699").alpha
128.0 / 255, RGBA("#33669980").alpha
136.0 / 255, RGBA("#3698").alpha
true, matched-color("") == null
true, matched-color("#") == null
true, matched-color("#12345") == null
true, matched-color("#12345g") == null
true, matched-color("#ggg") == null
true, matched-color("#1234567890") == null
"#ff0088", embedded-color("fill #f08, done")! as Hex
true, embedded-color("fill #f08badz, done") == null

════════════════════
test("RGB HSV")

"hsva(63.42592592592592%, 82.75862068965517%, 87%, 100%)", RGBA(15%, 29%, 87%) as HSVA
true, near(0.15%%, ((RGBA(15%, 29%, 87%) as HSVA) as RGBA).red)
true, near(0.29%%, ((RGBA(15%, 29%, 87%) as HSVA) as RGBA).green)
true, near(0.87%%, ((RGBA(15%, 29%, 87%) as HSVA) as RGBA).blue)

━━━━━━━━━━━━━━━━━━━━
_ matched-color
    - text String

match? text
    ~ color RGBA !.
        color

━━━━━━━━━━━━━━━━━━━━
_ embedded-color
    - text String

match? text
    ~ "fill " color RGBA ", done" !.
        color
