━━━━━━━━━━━━━━━━━━━━
_ do rotated-union-failures
    - first Path
    - second Path
    - expected String

. failures = ""
for step in 0 .. < 36
    . matrix = matrix-from-rotation((step as Float) * π / 18.0, (3, 7))
    . a = Path(first)
    . b = Path(second)
    a.transform(matrix)
    b.transform(matrix)
    . forward = outline-summary(union(a, b))
    if forward != expected
        failures = "$failures [$step: $forward]"
    . backward = outline-summary(union(b, a))
    if backward != expected
        failures = "$failures [-$step: $backward]"
= failures

