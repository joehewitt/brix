━━━━━━━━━━━━━━━━━━━━
_ do union-step-mismatches
    - paths [Path]

. sources [Path]
. joined = Path()
. mismatches Size
for path in paths
    sources += path
    if joined.count
        . next = union(joined, path)
        joined = if next then next else Path()
    else
        joined = path
    mismatches += region-mismatches(.union-effect, sources, List'Path(), joined)
= mismatches

