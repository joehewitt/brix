. piece = Curve((10, 0), (14, 3), (6, 7), (10, 10)).split-at-range(0.25, 0.75)
. path = Path()
path.move-to(piece.anchor1)
path.cubic-curve-to(piece.handle-out, piece.handle-in, piece.anchor2)
path.line-to(20, piece.anchor2.y)
path.line-to(20, piece.anchor1.y)
path.close()
= path

