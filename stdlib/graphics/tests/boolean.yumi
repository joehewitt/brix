━━━━━━━━━━━━━━━━━━━━
+ do boolean-effect-tests
    - t TestCase

. source = [rectangle(Rect(0, 0, 10, 10)), rectangle(Rect(5, 0, 10, 10)), rectangle(Rect(20, 0, 10, 10))]
. original = source[0].bounding-box
. union = BooleanEffect(.union-effect).apply(source)
t.expect("three-way union bounds", Rect(0, 0, 30, 10), union[0].bounding-box)
t.expect
    - "subtract remains left associative"
    - Rect(0, 0, 5, 10)
    - BooleanEffect(.subtract-effect).apply(source)[0].bounding-box
t.expect("empty intersection stays empty", 0, BooleanEffect(.intersect-effect).apply(source).length)
union[0].clear()
t.expect("outputs do not alias inputs", original, source[0].bounding-box)
. single = BooleanEffect().apply([source[0]])
single[0].clear()
t.expect("single-input outputs do not alias", original, source[0].bounding-box)
t.expect("empty input produces no paths", 0, BooleanEffect().apply(List'Path()).length)
= t

