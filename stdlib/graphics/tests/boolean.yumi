━━━━━━━━━━━━━━━━━━━━
_ self-union-summary
    - path Path

"${outline-summary(result)}; mismatches=$mismatches"

.. result = union(path, path)
.. mismatches = region-mismatches(.union-effect, [path], [path], result)

━━━━━━━━━━━━━━━━━━━━
_ boolean-summary
    - mode BooleanEffectMode
    - first Path
    - second Path

"${outline-summary(result)}; mismatches=${region-mismatches(mode, [first], [second], result)}"

.. result = boolean-result(mode, first, second)

━━━━━━━━━━━━━━━━━━━━
_ boolean-result
    - mode BooleanEffectMode
    - first Path
    - second Path

match mode
    |= .union-effect
        union(first, second)
    |= .intersect-effect
        intersect(first, second)
    ??
        subtract(first, second)

━━━━━━━━━━━━━━━━━━━━
_ do region-mismatches
    - mode BooleanEffectMode
    - first [Path]
    - second [Path]
    - result Path?

. bounds = first[0].bounding-box
. left = bounds.left
. top = bounds.top
. right = bounds.right
. bottom = bounds.bottom
for path in second
    . other = path.bounding-box
    left = min(left, other.left)
    top = min(top, other.top)
    right = max(right, other.right)
    bottom = max(bottom, other.bottom)
for path in first
    . other = path.bounding-box
    left = min(left, other.left)
    top = min(top, other.top)
    right = max(right, other.right)
    bottom = max(bottom, other.bottom)
. steps = 40
. step-x = (right - left) / (steps as Float)
. step-y = (bottom - top) / (steps as Float)
. offset = min(step-x, step-y) * 0.05
. mismatches Size
for row in 0 .. < steps
    for column in 0 .. < steps
        . x = left + ((column as Float) + 0.5) * step-x
        . y = top + ((row as Float) + 0.5) * step-y
        . expected = region-expects(mode, first, second, x, y)
        if expected != region-expects(mode, first, second, x + offset, y)
            continue
        if expected != region-expects(mode, first, second, x - offset, y)
            continue
        if expected != region-expects(mode, first, second, x, y + offset)
            continue
        if expected != region-expects(mode, first, second, x, y - offset)
            continue
        . actual = if result then result.contains(Point(x, y), FillRule.nonzero) else false
        if actual != expected
            mismatches += 1
= mismatches

━━━━━━━━━━━━━━━━━━━━
_ region-expects
    - mode BooleanEffectMode
    - first [Path]
    - second [Path]
    - x Coord
    - y Coord

match mode
    |= .union-effect
        in-first || in-second
    |= .intersect-effect
        in-first && in-second
    ??
        in-first && !in-second

.. in-first = paths-contain(first, x, y)
.. in-second = paths-contain(second, x, y)

━━━━━━━━━━━━━━━━━━━━
_ do paths-contain
    - paths [Path]
    - x Coord
    - y Coord

for path in paths
    if path.contains(Point(x, y), FillRule.nonzero)
        = true
= false

