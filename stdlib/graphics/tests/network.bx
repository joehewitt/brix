(import /graphics/curve)
(import /graphics/network)
(import /graphics/path)
(import /graphics/point)
(import /graphics/tests/support/geometry)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Network Exact Editing"))
  (call (. cases run) editing-tests)
  (= cases (call (. cases then) "Network Handle Constraints" handle-tests))
  (= cases (call (. cases then) "Network Vertex Duplication" duplication-tests))
  (= cases (call (. cases then) "Network Adjacent Vertex Duplication" adjacent-duplication-tests))
  (= cases (call (. cases then) "Network Path Conversion" path-tests))
  (= cases (call (. cases then) "Network Reversal" reversal-tests))
  (return (call (. cases then) "Network Update Scopes" update-scope-tests))
)

(fn-do + editing-tests _
  (param t TestCase)
  (let net (call VectorNetwork))
  (let a (call (. net add-vertex) (tuple 0 0)))
  (let b (call (. net add-vertex) (tuple 100 0)))
  (let id (call (. net connect) a b (tuple 0 100) (tuple 0 100)))
  (let p (call network-curve-point (call (. net curve) id) 0.5))
  (call (. net bend) id 0.5 (tuple 4 8) false false false)
  (call (. t check)
    (block
      (arg "bend moves grabbed point exactly")
      (arg (call near-point (+ p (call Point 4 8)) (call network-curve-point (call (. net curve) id) 0.5)))
    )
  )
  (return t)
)

(fn-do + path-tests _
  (param t TestCase)
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 50 0)
  (call (. path line-to) 50 50)
  (call (. path close))
  (call (. path move-to) 0 0)
  (call (. path line-to) -50 0)
  (let net (call network-from-path path))
  (call (. t expect) "coincident subpaths are not welded" 5 (. net vertex-count))
  (call (. t expect) "closing edge is explicit" 4 (. net segment-count))
  (call (. t expect) "conversion retains every curve" 4 (. (call (. net geometry)) curve-count))
  (call (. t expect) "conversion retains separate traces" 2 (. (call (. net traces)) length))
  (return t)
)

(fn-do + reversal-tests _
  (param t TestCase)
  (let net (call VectorNetwork))
  (let a (call (. net add-vertex) (tuple 0 0)))
  (let b (call (. net add-vertex) (tuple 100 0)))
  (let c (call (. net add-vertex) (tuple 100 100)))
  (let first (call (. net connect) a b (tuple 20 0) (tuple -20 10)))
  (let second (call (. net connect) b c (tuple 30 40) (tuple 0 -20)))
  (call (. net pair-handles) (call NetworkEnd first true) (call NetworkEnd second) false)
  (let forward (call (. net geometry)))
  (call (. net reverse))
  (let backward (call (. net geometry)))
  (call (. t expect) "the outline starts at the old end" (call Point 100 100) (. backward first-point))
  (call (. t expect) "the outline ends at the old start" (call Point 0 0) (. backward last-point))
  (let last (call (. forward get-curve) 1))
  (call (. t expect)
    (block
      (arg "the first curve is the old last curve backwards")
      (arg (call Curve (. last anchor2) (. last handle-in) (. last handle-out) (. last anchor1)))
      (arg (call (. backward get-curve) 0))
    )
  )
  (call (. net set-handle) (call NetworkEnd first) (tuple 0 10))
  (call (. t expect)
    (block
      (arg "paired handles stay paired at their vertex")
      (arg (call Point 0 -50))
      (arg (. (call (. net segment) second) tangent-end))
    )
  )
  (blank)
  (let loop (call VectorNetwork))
  (let corners
    (call (of List Index)
      (block
        (arg (in (call (. loop add-vertex) each) (list (call Point 0 0) (call Point 100 0) (call Point 100 100) (call Point 0 100))))
      )
    )
  )
  (for (in index (..< 0 4))
    (call (. loop connect) ([] corners index) ([] corners (% (+ index 1) 4)))
  )
  (call (. loop reverse))
  (let turned (call (. loop geometry)))
  (call (. t check) "a closed loop stays closed" (. turned is-closed))
  (call (. t expect) "a closed loop keeps its start" (call Point 0 0) (. turned first-point))
  (call (. t expect) "a closed loop runs the other way" (call Point 0 100) (. (call (. turned get-curve) 0) anchor2))
  (return t)
)

(fn-do + handle-tests _
  (param t TestCase)
  (let net (call VectorNetwork))
  (let a (call (. net add-vertex) (tuple 0 0)))
  (let b (call (. net add-vertex) (tuple 100 0)))
  (let c (call (. net add-vertex) (tuple 200 0)))
  (let first (call (. net connect) a b (tuple 0 0) (tuple -20 0)))
  (let second (call (. net connect) b c (tuple 40 0) (tuple 0 0)))
  (call (. net pair-handles) (call NetworkEnd first true) (call NetworkEnd second) true)
  (call (. net connect) b (call (. net add-vertex) (tuple 100 100)) (tuple 0 20))
  (call (. net split) first 0.5)
  (call (. net set-handle) (call NetworkEnd second) (tuple 10 10))
  (call (. t check)
    (block
      (arg "split transfers pair to retained endpoint")
      (arg (< (call (. (call (. net segment) 4) tangent-end distance) (tuple -10 -10)) 0.00001))
    )
  )
  (return t)
)

(fn-do + duplication-tests _
  (param t TestCase)
  (let net (call VectorNetwork))
  (let a (call (. net add-vertex) (tuple 0 0)))
  (let b (call (. net add-vertex) (tuple 100 0)))
  (let c (call (. net add-vertex) (tuple 200 0)))
  (let first (call (. net connect) a b (tuple 20 0) (tuple -20 0)))
  (let second (call (. net connect) b c (tuple 20 0) (tuple -20 0)))
  (call (. net pair-handles) (call NetworkEnd first true) (call NetworkEnd second) true)
  (let selected (list Index))
  (+= selected b)
  (let duplicates (call (. net duplicate-vertices) selected))
  (call (. t expect) "duplicated vertex retains both incident segments" 2 (call (. net degree) ([] duplicates 0)))
  (call (. t expect) "original vertex retains its incident segments" 2 (call (. net degree) b))
  (call (. net set-handle) (call NetworkEnd 3 true) (tuple 0 -10))
  (call (. t expect) "duplicated smooth handles remain paired" (call Point 0 10) (. (call (. net segment) 4) tangent-start))
  (return t)
)

(fn-do + adjacent-duplication-tests _
  (param t TestCase)
  (let net (call VectorNetwork))
  (let a (call (. net add-vertex) (tuple 0 0)))
  (let b (call (. net add-vertex) (tuple 100 0)))
  (let c (call (. net add-vertex) (tuple 200 0)))
  (call (. net connect) a b)
  (call (. net connect) b c)
  (let duplicates (call (. net duplicate-vertices) (list b a)))
  (call (. t expect) "only the duplicates are added" 5 (. net vertex-count))
  (call (. t expect) "the shared segment is copied once" 4 (. net segment-count))
  (call (. t expect) "the inner duplicate keeps both copied segments" 2 (call (. net degree) ([] duplicates 0)))
  (call (. t expect) "the outer duplicate keeps the one shared copy" 1 (call (. net degree) ([] duplicates 1)))
  (return t)
)

(fn-do _ update-scope-tests _
  (param t TestCase)
  (let net (call VectorNetwork))
  (let observer (call ScopeMutationObserver))
  (call (. net subscribe) observer)
  (do-use (. net updating)
    (call (. net add-vertex) (tuple 0 0))
    (do-use (. net updating)
      (call (. net add-vertex) (tuple 1 1))
    )
    (call (. t expect) "nested updates defer notification" 0 (. observer count))
  )
  (call (. t expect) "leaving the outer update publishes once" 1 (. observer count))
  (let failure (catch (call failed-scoped-update net)))
  (call (. t expect) "the update preserves errors" "scope failure" (as failure String))
  (call (. t expect) "error unwinding publishes the mutation" 2 (. observer count))
  (call (. net add-vertex) (tuple 3 3))
  (call (. t expect) "error unwinding restores update depth" 3 (. observer count))
  (return t)
)

(fn-do _ failed-scoped-update _
  (param net VectorNetwork)
  (use (. net updating))
  (call (. net add-vertex) (tuple 2 2))
  (throw (call Error "scope failure"))
)

(type _ ScopeMutationObserver (is NetworkMutationObserver)
  (prop + count Size)
  (fn-do + network-mutated _
    (param network VectorNetwork)
    (param revision Size)
    (+= count 1)
  )
)
