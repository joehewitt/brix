test("Offset Trim Fidelity")

"1 open; faithful", offset-report(pen-path(), 30)
"1 open; faithful", offset-report(pen-path(), 33)
"1 open; faithful", offset-report(pen-path(), 60)
"1 open; faithful", offset-report(pen-path(), 69)
"1 open; faithful", offset-report(pen-path(), 92)
"1 open; faithful", offset-report(pen-path(), 150)
"1 open; faithful", offset-report(pen-path(), -33)
"1 open; faithful", offset-report(pen-path(), -92)
"1 open; faithful", offset-report(inflection-cubic(), 3)
"1 open; faithful", offset-report(open-cubic-snake-path(), -8)
"faithful", offset-fidelity(open-cubic-snake-path(), 12)
"1 open; faithful", offset-report(open-close-pass-path(), -6)
"faithful", offset-fidelity(open-close-pass-path(), 12)
"faithful", offset-fidelity(concave-path(), 8)
"faithful", offset-fidelity(concave-path(), -3)
"faithful", offset-fidelity(petal-loop-path(), -8)
"faithful", offset-fidelity(petal-loop-path(), 12)
true, hooked-cubic-offset-ignores-hook()
"faithful", offset-fidelity(tilted-line-shape((125, 124), 84), 20.25)
"faithful", offset-fidelity(tilted-line-shape((125, 124), 84), -20.5)
"faithful", offset-fidelity(zigzag-shape((125, 124), 84), 20.25)
"faithful", offset-fidelity(zigzag-shape((125, 124), 84), -20.5)
"faithful", offset-fidelity(spiral-shape((125, 124), 84), 20.25)
"faithful", offset-fidelity(spiral-shape((125, 124), 84), -20.5)
"faithful", offset-fidelity(open-wave-shape((125, 124), 84), 20.25)
"faithful", offset-fidelity(open-wave-shape((125, 124), 84), -20.5)
"faithful", offset-fidelity(hairpin-shape((125, 124), 84), 20.25)
"faithful", offset-fidelity(hairpin-shape((125, 124), 84), -20.5)
"faithful", offset-fidelity(cusp-sweep-shape((125, 124), 84), 20.25)
"faithful", offset-fidelity(cusp-sweep-shape((125, 124), 84), -20.5)
"faithful", offset-fidelity(tilted-rect-shape((125, 124), 84), 20.25)
"faithful", offset-fidelity(tilted-rect-shape((125, 124), 84), -20.5)
"faithful", offset-fidelity(triangle-shape((125, 124), 84), 20.25)
"faithful", offset-fidelity(triangle-shape((125, 124), 84), -20.5)
"faithful", offset-fidelity(circle((125, 124), 58.8), 20.25)
"faithful", offset-fidelity(circle((125, 124), 58.8), -20.5)
"faithful", offset-fidelity(pentagon-shape((125, 124), 84), 20.25)
"faithful", offset-fidelity(pentagon-shape((125, 124), 84), -20.5)
"faithful", offset-fidelity(rosette-shape((125, 124), 84), 20.25)
"faithful", offset-fidelity(rosette-shape((125, 124), 84), -20.5)

━━━━━━━━━━━━━━━━━━━━
+ rotated-rect-inner-offset-is-single-inset

one-contour && path.contains((0, 0)) && near(476, path-area(path), 0.001)

.. path = offset-path(PathSet([rotated-rect-path()]), -3, .miter-join-type, 5).paths[0]
.. one-contour = path.is-closed && path-subpath-count(path) == 1

━━━━━━━━━━━━━━━━━━━━
+ reversed-rotated-rect-inner-offset-is-single-inset

one-contour && path.contains((0, 0)) && near(476, path-area(path), 0.001)

.. path = offset-path(PathSet([rotated-rect-path().reverse()]), -3, .miter-join-type, 5).paths[0]
.. one-contour = path.is-closed && path-subpath-count(path) == 1

━━━━━━━━━━━━━━━━━━━━
+ self-crossing-offset-cleans-to-closed-contour

two-contours && square-bounds && path.contains((0, 18)) && !path.contains((-18, 0))

.. path = offset-path(PathSet([bowtie-path()]), 5, .round-join-type).paths[0]
.. two-contours = path.is-closed && path-subpath-count(path) == 2
.. square-bounds = near-rect(Rect(-25, -25, 50, 50), path.bounding-box, 0.01)

━━━━━━━━━━━━━━━━━━━━
+ self-crossing-inner-offset-splits-lobes

two-lobes && path.contains((0, 10)) && !path.contains((0, 0)) && !path.contains((-18, 0))

.. path = offset-path(PathSet([bowtie-path()]), -5, .square-join-type, 5).paths[0]
.. two-lobes = path.is-closed && path-subpath-count(path) == 2 && path.count == 8

━━━━━━━━━━━━━━━━━━━━
+ convex-inset-drops-vanished-edge

path.is-closed && path.count == 4 && near(106.98, path-area(path), 0.01)

.. path = offset-path(PathSet([trapezoid-path()]), -4, .miter-join-type, 5).paths[0]

━━━━━━━━━━━━━━━━━━━━
+ crossing-curve-offset-splits-lobes

path.is-closed && path-subpath-count(path) == 2 && lobes && !path.contains((0, 14))

.. path = offset-path(PathSet([curved-eight-path()]), 3, .round-join-type).paths[0]
.. lobes = path.contains((-14, -6)) && path.contains((14, 6))

━━━━━━━━━━━━━━━━━━━━
+ thin-crescent-miter-inset-count

offset-path(PathSet([thin-crescent-path()]), -5.5, .miter-join-type, 5).paths.length

━━━━━━━━━━━━━━━━━━━━
+ offset-report
    - source Path
    - distance Length

"${path-subpath-count(path)} $shape; ${offset-fidelity(source, distance)}"

.. path = round-offset(source, distance)
.. shape = if path.is-closed then "closed" else "open"

━━━━━━━━━━━━━━━━━━━━
+ hooked-cubic-offset-ignores-hook

!path.is-closed && path-subpath-count(path) == 1 && deviation < 0.5 && path.bounding-box.x > -4

.. source = hooked-cubic-path()
.. path = round-offset(source, 6)
.. deviation = offset-deviation(path-segments(source, 48), path, 6)

