_ do pen-path

. path = Path()
path.move-to(270.109375, 434.6484375)
path.line-to(332.25390625, 290.6171875)
path.cubic-curve-to()
    - 410.17578125
    - 284.64453125
    - 385.37890625
    - 343.42578125
    - 438.46484375
    - 381.98046875
path.cubic-curve-to(491.55078125, 420.53515625, 482.95703125, 337.515625, 515.8125, 312.0546875)
path.cubic-curve-to(548.66796875, 286.59375, 608.37890625, 226.2421875, 631.8515625, 282.28125)
path.cubic-curve-to(655.32421875, 338.3203125, 695.5078125, 388.12109375, 695.5078125, 388.12109375)
path.line-to(764.36328125, 179.45703125)
path.line-to(816.91796875, 391.44140625)
= path

━━━━━━━━━━━━━━━━━━━━
_ do trapezoid-path

. path = Path()
path.move-to(0, 0)
path.line-to(40, 0)
path.line-to(21, 19)
path.line-to(19, 19)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do curved-eight-path

. path = Path()
path.move-to(-20, 0)
path.cubic-curve-to(-20, -30, 20, 30, 20, 0)
path.cubic-curve-to(20, -30, -20, 30, -20, 0)
path.close()
= path

