path.move-to(23.4, 27.7)
path.line-to(24.1, 19.6)
path.line-to(17.9, 5.1)
path.line-to(4.2, 0)
path.line-to(0, 1.1)
path.line-to(11.7, 2.8)
path.line-to(21.9, 15.1)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do hooked-cubic-path

. path = Path()
path.move-to(0, 0)
path.cubic-curve-to(-0.3, 0.3, 60, -40, 100, 0)
= path

━━━━━━━━━━━━━━━━━━━━
_ do inflection-cubic

. path = Path()
path.move-to(-10, 0)
path.cubic-curve-to(-5, 20, 5, -20, 10, 0)
= path

━━━━━━━━━━━━━━━━━━━━
_ do open-cubic-snake-path

. radius = 50
. path = Path()
path.move-to(-radius * 0.86, radius * 0.34)
path.cubic-curve-to()
    - -radius * 0.65
    - -radius * 0.85
    - -radius * 0.18
    - radius * 0.82
    - radius * 0.06
    - -radius * 0.08
path.cubic-curve-to()
    - radius * 0.34
    - -radius * 1.04
    - radius * 0.76
    - radius * 0.74
    - radius * 0.88
    - -radius * 0.24
= path

━━━━━━━━━━━━━━━━━━━━
_ do open-close-pass-path

. radius = 50
. path = Path()
path.move-to(-radius * 0.82, -radius * 0.5)
path.cubic-curve-to()
    - -radius * 0.2
    - -radius * 1.0
    - radius * 0.55
    - -radius * 0.88
    - radius * 0.68
    - -radius * 0.18
path.cubic-curve-to()
    - radius * 0.82
    - radius * 0.6
    - -radius * 0.48
    - radius * 0.58
    - -radius * 0.58
    - -radius * 0.12
path.cubic-curve-to()
    - -radius * 0.56
    - -radius * 0.42
    - -radius * 0.18
    - -radius * 0.28
    - radius * 0.12
    - radius * 0.12
= path

━━━━━━━━━━━━━━━━━━━━
_ do rotated-rect-path

. path = rectangle(Rect(-20, -10, 40, 20))
path.rotate(15deg, Point(0, 0))
= path

━━━━━━━━━━━━━━━━━━━━
_ do bowtie-path

. path = Path()
path.move-to(-20, -20)
path.line-to(20, 20)
path.line-to(-20, 20)
path.line-to(20, -20)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do concave-path

. path = Path()
path.move-to(0, 0)
path.line-to(40, 0)
path.line-to(40, 20)
path.line-to(20, 8)
path.line-to(0, 20)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do petal-loop-path

. radius = 50
. path = Path()
path.move-to(0, -radius * 0.9)
path.cubic-curve-to()
    - radius * 1.25
    - -radius * 0.72
    - radius * 0.35
    - radius * 0.28
    - radius * 0.78
    - radius * 0.72
path.cubic-curve-to()
    - radius * 0.18
    - radius * 1.08
    - -radius * 0.4
    - radius * 0.34
    - -radius * 0.82
    - radius * 0.66
path.cubic-curve-to(-radius * 1.22, radius * 0.08, -radius * 0.55, -radius * 0.72, 0, -radius * 0.9)
path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do path-subpath-count
    - path Path

. count = 0
for subpath in path.subpaths
    count += 1
= count
