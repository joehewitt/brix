test("Offset Topology Cleanup")

true, rotated-rect-inner-offset-is-single-inset()
true, reversed-rotated-rect-inner-offset-is-single-inset()
true, self-crossing-offset-cleans-to-closed-contour()
true, self-crossing-inner-offset-splits-lobes()
true, convex-inset-drops-vanished-edge()
true, crossing-curve-offset-splits-lobes()
0, thin-crescent-miter-inset-count()

