━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Network Graphic Invalidation")
cases.run(invalidation-tests)
cases = cases.then("Network Graphic Copy Isolation", copy-tests)
cases = cases.then("Network Graphic Stroke Reach", stroke-reach-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do invalidation-tests
    - t TestCase

. image = VectorGroup()
. graphic = NetworkGraphic(rectangle-network())
image += graphic
image.checkpoint()
. probe = NetworkGraphicInvalidationProbe()
image.invalidation-listener = probe.changed
graphic.network.move-vertex(1, (-5, 0))
t.expect("network mutation publishes one document change", 1, probe.count)

probe.reset()
graphic.network.begin-update()
graphic.network.move-vertex(1, (-10, 0))
graphic.network.move-vertex(2, (30, 0))
graphic.network.checkpoint()
t.expect("network batch defers document changes", 0, probe.count)
graphic.network.end-update()
t.expect("network batch publishes one document change", 1, probe.count)

. old-network = graphic.network
. replacement = rectangle-network()
graphic.network = replacement
probe.reset()
old-network.move-vertex(1, (-20, 0))
t.expect("replaced network no longer invalidates its former owner", 0, probe.count)
replacement.move-vertex(1, (-20, 0))
t.expect("replacement network invalidates its owner", 1, probe.count)
= t

━━━━━━━━━━━━━━━━━━━━
+ do copy-tests
    - t TestCase

. graphic = NetworkGraphic(rectangle-network())
. effects [VectorEffect]
effects += BooleanEffect()
graphic.effects = VectorEffects(effects)
. red-fill = RGBA(1, 0, 0, 1)
graphic.paint-region((10, 10), red-fill)
. copy = graphic.copy()
. source-effects = graphic.$effects.items
. copied-effects = copy.$effects.items
t.check
    - "copy owns independent effects"
    - source-effects[0] as Pointer != copied-effects[0] as Pointer
copy.network.move-vertex(1, (-50, -50))
t.expect
    - "copy mutation leaves source geometry isolated"
    - Point(0, 0)
    - graphic.network.vertex(1).position
copy.paint-region((10, 10), RGBA(0, 0, 1, 1))
t.expect("copy painting leaves source appearance isolated", red-fill, graphic.appearances[0].fill!)
= t

━━━━━━━━━━━━━━━━━━━━
+ NetworkGraphicInvalidationProbe

+ count Size
+ kinds U8

────────────────────
+ do changed
    - changed-kinds U8

count += 1
kinds = kinds /or/ changed-kinds

────────────────────
+ do reset

count = 0
kinds = 0

━━━━━━━━━━━━━━━━━━━━
+ do stroke-reach-tests
    - t TestCase

. graphic = NetworkGraphic(rectangle-network())
graphic.stroke = black
graphic.stroke-width = 1
t.check("a thin stroke misses a distant point", !graphic.hit((-12, 10), 0))
graphic.stroke = [StrokeLayer(black, 1), StrokeLayer(red, 30, StrokeAlignment.outside)] as Stroke
t.check("a wide outside stroke layer extends picking", graphic.hit((-12, 10), 0))
graphic.stroke = [StrokeLayer(black, 1), StrokeLayer(red, 30, StrokeAlignment.outside, null, null, false)] as Stroke
t.check("hidden stroke layers do not extend picking", !graphic.hit((-12, 10), 0))
t.check
    - "a painted fill picks its interior"
    - graphic.fill-hit((10, 10), VectorAppearance(Fill(red)))
t.check
    - "fill picking stays inside the shape"
    - !graphic.fill-hit((30, 10), VectorAppearance(Fill(red)))
t.check
    - "an unpainted fill is click-through"
    - !graphic.fill-hit((10, 10), VectorAppearance(Fill.none))
t.check
    - "a transparent fill is click-through"
    - !graphic.fill-hit((10, 10), VectorAppearance(Fill(transparent)))
= t

━━━━━━━━━━━━━━━━━━━━
_ rectangle-network VectorNetwork

network-from-path(rectangle(Rect(0, 0, 20, 20)))
