(import ./support/offset-grid-cells)
(import /graphics/canvas)
(import /graphics/primitives)
(import /os/file)
(import /os/path)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Offset Grid Source Sampling"))
  (call (. cases run) offset-grid-source-sampling-tests)
  (return (call (. cases then) "Offset Grid SVG Goldens" offset-grid-svg-golden-tests))
)

(fn-do _ offset-grid-source-sampling-tests _
  (param t TestCase)
  (for (in index (list 13 29))
    (let source (call offset-grid-cell-source-path index (call Rect 0 0 251 248)))
    (call (. t expect) (str "cell " index " has 58 samples and a close command") 59 (. source count))
    (call (. t check) (str "cell " index " source winding") (. source is-clockwise))
  )
  (blank)
  (return t)
)

(fn-do + offset-grid-svg-golden-tests _
  (param t TestCase)
  (for (in index (..< 0 32))
    (let name (call offset-grid-cell-name index))
    (let actual (call (. (call offset-grid-cell-svg index) trim)))
    (let expected (call (. (call offset-grid-cell-golden-svg index) trim)))
    (call (. t check) (str "cell " name " golden svg exists") (!= (call (. expected find) "<svg") null))
    (call (. t expect) (str "cell " name " svg") expected actual)
    (if (call offset-grid-cell-collapses index)
      (call (. t check) (str "cell " name " collapsed inset is empty") (== (call (. actual find) "<path") null))
      (else-if (call offset-grid-cell-source-is-closed index)
        (call (. t check) (str "cell " name " closed fill only") (!= (call (. actual find) "stroke=\"none\"") null))
        (call (. t check) (str "cell " name " closed offset paths") (call offset-grid-cell-result-paths-closed index))
      )
      (else
        (call (. t check) (str "cell " name " open stroke only") (!= (call (. actual find) "fill=\"none\"") null))
        (call (. t check) (str "cell " name " open visible stroke") (== (call (. actual find) "stroke=\"none\"") null))
        (call (. t check) (str "cell " name " open offset paths") (call offset-grid-cell-result-paths-open index))
      )
    )
  )
  (blank)
  (return t)
)

(fn-expr _ offset-grid-cell-collapses _
  (param index _)
  (== index 29)
)

(fn-do _ offset-grid-cell-golden-svg _
  (param index _)
  (let file (call File (call offset-grid-cell-golden-path index) (. FileFlags read-mode)))
  (let svg (as file String))
  (call (. file close))
  (return svg)
)

(fn-do _ offset-grid-cell-golden-path _
  (param index _)
  (let local (str "cell-" (call offset-grid-cell-name index) ".svg"))
  (if (. (call Path local) is-file)
    (return local)
  )
  (blank)
  (return (str "stdlib/graphics/tests/fixtures/offset-grid-golden/" local))
)

(fn-do _ offset-grid-cell-svg _
  (param index _)
  (let path (str "/private/tmp/brix-offset-grid-cell-" (call offset-grid-cell-name index) ".svg"))
  (call write-offset-grid-cell-svg index path)
  (let file (call File path (. FileFlags read-mode)))
  (let svg (as file String))
  (call (. file close))
  (return svg)
)

(fn-do _ write-offset-grid-cell-svg _
  (param index _)
  (param path String)
  (let canvas (call SVGCanvas 251 248))
  (if (call offset-grid-cell-source-is-closed index)
    (= (. canvas fill-color) (call offset-grid-cell-fill-color index))
    (= (. canvas stroke-color) null)
    (else
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) (call offset-grid-cell-fill-color index))
      (= (. canvas stroke-width) 4)
    )
  )
  (let result (call offset-grid-cell-result-path index (call Rect 0 0 251 248)))
  (if (. result count)
    (call (. result outline) canvas)
  )
  (call (. canvas write) path)
)

(fn-do _ offset-grid-cell-result-paths-closed _
  (param index _)
  (let layer (call offset-grid-cell-result-layer index (call Rect 0 0 251 248)))
  (return-if (if (not (. layer paths length))))
  (blank)
  (for (in path (. layer paths))
    (return-if (if (not (. path is-closed))))
  )
  (blank)
  (return true)
)

(fn-do _ offset-grid-cell-result-paths-open _
  (param index _)
  (let layer (call offset-grid-cell-result-layer index (call Rect 0 0 251 248)))
  (return-if (if (not (. layer paths length))))
  (blank)
  (for (in path (. layer paths))
    (return-if (if (. path is-closed)))
  )
  (blank)
  (return true)
)
