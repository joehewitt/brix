(import /graphics/art)
(import /graphics/graphic)
(import /graphics/primitives)
(import /test)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Lattice Image"))
  (tuple 3 (call lattice-grid-row-count))
  (tuple "2,2,2" (call lattice-grid-row-sizes))
  (tuple 3 (call mirrored-lattice-grid-row-count))
  (tuple "3,2,3" (call mirrored-lattice-grid-row-sizes))
  (tuple "6.25,0,17.5" (call mirrored-lattice-first-row-x))
)

(fn-expr + lattice-grid-row-count _
  (. (call lattice-grid) length)
)

(fn-expr + lattice-grid-row-sizes _
  (call (. "," join) (in (str (. each length)) (call lattice-grid)))
)

(fn-expr + mirrored-lattice-grid-row-count _
  (. (call mirrored-lattice-grid) length)
)

(fn-expr + mirrored-lattice-grid-row-sizes _
  (call (. "," join) (in (str (. each length)) (call mirrored-lattice-grid)))
)

(fn-do + lattice-grid _
  (let lattice (call LatticeImage))
  (= (. lattice spacing-x) 5)
  (= (. lattice spacing-y) 5)
  (return (call (. lattice get-grid) (call Rect 0 0 20 20) (call Rect 0 0 5 5)))
)

(fn-do + mirrored-lattice-grid _
  (let lattice (call LatticeImage))
  (= (. lattice spacing-x) 5)
  (= (. lattice spacing-y) 5)
  (= (. lattice mirrored) true)
  (return (call (. lattice get-grid) (call Rect 0 0 20 20) (call Rect 0 0 5 5)))
)

(fn-expr + mirrored-lattice-first-row-x _
  (call (. "," join) (in (str (. each tx)) ([] (call mirrored-lattice-grid) 0)))
)
