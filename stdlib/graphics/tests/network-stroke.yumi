/graphics/canvas
/graphics/color
/graphics/network
/graphics/network-stroke
/graphics/path
/graphics/primitives
/graphics/stroke
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Network Junction Strokes")
cases.run(junction-tests)
cases = cases.then("Network Junction Coverage", coverage-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do junction-tests
    - t TestCase

. net = VectorNetwork()
. center = net.add-vertex((70, 70))
net.connect(center, net.add-vertex((20, 100)))
net.connect(center, net.add-vertex((120, 100)))
net.connect(center, net.add-vertex((70, 20)))
. workspace = NetworkStrokeWorkspace()
. outline = workspace.resolve(net, 12)
t.check("junction has filled center", outline.contains((70, 70), FillRule.nonzero))
t.check("stroke excludes remote space", !outline.contains((5, 5), FillRule.nonzero))
t.check("round cap extends endpoint", outline.contains((70, 15), FillRule.nonzero))
= t

━━━━━━━━━━━━━━━━━━━━
+ do coverage-tests
    - t TestCase

. net = VectorNetwork()
. root = net.add-vertex((50, 50))
net.connect(root, net.add-vertex((10, 50)))
net.connect(root, net.add-vertex((90, 50)))
net.connect(root, net.add-vertex((50, 10)))
net.connect(root, net.add-vertex((50, 90)))
for join in [.round-join-type, .bevel-join-type, .miter-join-type]
    . outline = network-stroke(net, 12, join, .butt, 4)
    . actual = RasterCanvas(8, 8, 1)
    . expected = RasterCanvas(8, 8, 1)
    do use actual
        do use expected
            actual.fill-color = RGBA(0.2, 0.4, 0.6, 0.5)
            expected.fill-color = RGBA(0.2, 0.4, 0.6, 0.5)
            actual.stroke-color = null
            expected.stroke-color = null
            actual.translate(-46, -46)
            outline.outline(actual)
            expected.rect(Rect(0, 0, 8, 8))
            t.expect("junction alpha is applied once", 0, actual.pixel-difference-count(expected))
. curved = VectorNetwork()
. center = curved.add-vertex((70, 70))
curved.connect(center, curved.add-vertex((10, 20)), (-30, 0), (0, 30))
curved.connect(center, curved.add-vertex((130, 20)), (30, 0), (0, 30))
curved.connect(center, curved.add-vertex((70, 130)), (0, 30), (0, -20))
. outline = network-stroke(curved, 10)
t.check("curved junction covers vertex", outline.contains((70, 70), FillRule.nonzero))
t.check
    - "curved junction retains branch coverage"
    - outline.contains(network-curve-point(curved.curve(1), 0.5), FillRule.nonzero)
= t
