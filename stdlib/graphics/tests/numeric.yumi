+ tests TestRender

════════════════════
test("Numeric Utilities")

true, solve-quadratic-ok()
true, solve-cubic-ok()

━━━━━━━━━━━━━━━━━━━━
_ do solve-quadratic-ok

. roots = solve-quadratic(1.0, -3.0, 2.0, tolerance)
=? if roots.count != 2
=? if !near(1, roots.root1)
=? if !near(2, roots.root2)

. linear-roots = solve-quadratic(0.0, 2.0, -4.0, tolerance)
=? if linear-roots.count != 1
=? if !near(2, linear-roots.root1)

. no-roots = solve-quadratic(1.0, 0.0, 1.0, tolerance)
= no-roots.count == 0

━━━━━━━━━━━━━━━━━━━━
_ do solve-cubic-ok

. roots = solve-cubic(1.0, -6.0, 11.0, -6.0, tolerance)
=? if roots.count != 3

= root1-ok && root2-ok && root3-ok

.. root1-ok = has-root(roots, 1)
.. root2-ok = has-root(roots, 2)
.. root3-ok = has-root(roots, 3)

━━━━━━━━━━━━━━━━━━━━
_ has-root
    - roots CurveRoots
    - value

some(0 .. < roots.count) • where near(value, roots[each])
