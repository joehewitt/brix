(fn-expr _ first-path _
  (param paths (list Path))
  (only-if ([] paths 0) (if (. paths length)))
)

(fn-do + wave-right _
  (let path (call Path))
  (call (. path move-to) 10 0)
  (call (. path line-to) 20 0)
  (call (. path line-to) 20 10)
  (call (. path line-to) 10 10)
  (call (. path cubic-curve-to) (tuple 6 7) (tuple 14 3) (tuple 10 0))
  (call (. path close))
  (return path)
)

(fn-do + wave-notch _
  (let piece (call (. (call Curve (tuple 10 0) (tuple 14 3) (tuple 6 7) (tuple 10 10)) split-at-range) 0.25 0.75))
  (let path (call Path))
  (call (. path move-to) (. piece anchor1))
  (call (. path cubic-curve-to) (. piece handle-out) (. piece handle-in) (. piece anchor2))
  (call (. path line-to) 20 (. piece anchor2 y))
  (call (. path line-to) 20 (. piece anchor1 y))
  (call (. path close))
  (return path)
)

(fn-expr + rect-b _
  (call rectangle (call Rect 5 5 10 10))
)

(fn-expr + rect-contained _
  (call rectangle (call Rect 2 2 4 4))
)

(fn-expr + disjoint-rect _
  (call rectangle (call Rect 20 20 5 5))
)

(fn-expr + touching-rect _
  (call rectangle (call Rect 10 0 5 10))
)

(fn-expr _ none-or-empty-summary _
  (param path (? Path))
  (case? path
    (case? (. path count)
      (call optional-path-summary path)
    )
    (default
      "none-or-empty"
    )
  )
  (default
    "none-or-empty"
  )
)

(fn-expr _ outline-summary _
  (param path (? Path))
  (case? (not path)
    "none"
  )
  (default
    (str "contours=" contours "; curves=" (. path curve-count) "; closed=" (. path is-closed))
  )
  (where
    (lazy contours (call count (. path subpaths)))
  )
)

(fn-expr _ optional-path-near-area _
  (param area Length)
  (param path (? Path))
  (param epsilon _ (= 0.00001))
  (case? path
    (call near area (call path-area path) epsilon)
  )
  (default
    false
  )
)

(fn-expr + notch-l _
  (?? (call subtract (call rectangle (call Rect 0 0 60 60)) (call rectangle (call Rect 3 2 60 60))) (call Path))
)

(fn-expr + notch-rect _
  (call rectangle (call Rect 6 4 60 60))
)

