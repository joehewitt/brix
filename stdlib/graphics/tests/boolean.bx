(import /graphics/boolean)
(import /graphics/curve)
(import /graphics/matrix)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/tests/support/geometry)
(import /math)
(import /stream/aggregate)
(import /test)
(import /units)
(blank)

(main
  (call tests)
  (call effect-tests)
)

(fn-expr + tests TestRender
  (header (call test "Boolean Rect Arrangement"))
  (tuple true (call optional-path-near-area 175 (call union (call rect-a) (call rect-b)) 0.01))
  (tuple true (call optional-path-contains (tuple 2 2) (call union (call rect-a) (call rect-b))))
  (tuple true (call optional-path-contains (tuple 12 12) (call union (call rect-a) (call rect-b))))
  (tuple true (not (call optional-path-contains (tuple 12 2) (call union (call rect-a) (call rect-b)))))
  (tuple true (call optional-path-near-area 25 (call intersect (call rect-a) (call rect-b)) 0.01))
  (tuple true (call optional-path-near-area 75 (call subtract (call rect-a) (call rect-b)) 0.01))
  (tuple true (call optional-path-contains (tuple 2 2) (call subtract (call rect-a) (call rect-b))))
  (tuple true (not (call optional-path-contains (tuple 7 7) (call subtract (call rect-a) (call rect-b)))))
  (header (call test "Boolean No-Crossing Cases"))
  (tuple true (call optional-path-near-bbox (call Rect 0 0 25 25) (call union (call rect-a) (call disjoint-rect))))
  (tuple true (call optional-path-contains (tuple 2 2) (call union (call rect-a) (call disjoint-rect))))
  (tuple true (call optional-path-contains (tuple 22 22) (call union (call rect-a) (call disjoint-rect))))
  (tuple "none-or-empty" (call none-or-empty-summary (call intersect (call rect-a) (call disjoint-rect))))
  (tuple true (call optional-path-near-area 84 (call subtract (call rect-a) (call rect-contained)) 0.01))
  (tuple true (call optional-path-contains (tuple 1 1) (call subtract (call rect-a) (call rect-contained))))
  (tuple true (not (call optional-path-contains (tuple 3 3) (call subtract (call rect-a) (call rect-contained)))))
  (tuple true (call optional-path-near-area 294 (call subtract (call notch-l) (call notch-rect)) 0.01))
  (tuple true (call optional-path-near-area 3894 (call union (call notch-l) (call notch-rect)) 0.01))
  (tuple "none-or-empty" (call none-or-empty-summary (call intersect (call notch-l) (call notch-rect))))
  (scope (tuple "contours=1; curves=8; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .union-effect (call nested-c-inner) (call nested-c-outer)))
  )
  (scope (tuple "contours=0; curves=0; closed=false; mismatches=0" summary)
    (lazy summary (call boolean-summary .subtract-effect (call nested-c-inner) (call nested-c-outer)))
  )
  (scope (tuple "contours=1; curves=8; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .intersect-effect (call nested-c-inner) (call nested-c-outer)))
  )
  (header (call test "Boolean Shared Edge Rects"))
  (tuple true (call optional-path-near-bbox (call Rect 40 10 30 60) (call intersect (call shared-edge-left) (call shared-edge-right))))
  (tuple true (call optional-path-near-area 1800 (call intersect (call shared-edge-left) (call shared-edge-right)) 0.01))
  (tuple true (call optional-path-near-bbox (call Rect 10 10 90 60) (call union (call shared-edge-left) (call shared-edge-right))))
  (tuple true (call optional-path-near-bbox (call Rect 10 10 30 60) (call subtract (call shared-edge-left) (call shared-edge-right))))
  (tuple true (call optional-path-near-bbox (call Rect 40 10 30 60) (call intersect (call shared-edge-left) (call shared-edge-outline))))
  (tuple true (call optional-path-near-bbox (call Rect 10 10 90 60) (call union (call shared-edge-left) (call shared-edge-outline))))
  (tuple true (call optional-path-near-area 100 (call subtract (call rect-a) (call side-touching-rect)) 0.01))
  (tuple true (call optional-path-near-bbox (call Rect 0 0 10 10) (call union (call rect-a) (call rect-a))))
  (tuple true (call optional-path-near-bbox (call Rect 0 0 10 10) (call union (call rect-a) (call reversed-rect-a))))
  (tuple true (call optional-path-near-bbox (call Rect 0 0 10 10) (call intersect (call rect-a) (call reversed-rect-a))))
  (header (call test "Boolean Touching Shapes"))
  (tuple true (call optional-path-near-area 150 (call union (call rect-a) (call touching-rect)) 0.01))
  (tuple true (call optional-path-near-area 200 (call union (call rect-a) (call side-touching-rect)) 0.01))
  (tuple "contours=1; curves=8; closed=true" (call outline-summary (call union (call rect-a) (call inset-touching-rect))))
  (tuple true (call optional-path-near-area 160 (call union (call rect-a) (call inset-touching-rect)) 0.01))
  (tuple "contours=1; curves=8; closed=true" (call outline-summary (call union (call inset-touching-rect) (call rect-a))))
  (tuple "contours=1; curves=6; closed=true" (call outline-summary (call union (call zigzag-left) (call zigzag-right))))
  (tuple true (call optional-path-near-area 200 (call union (call zigzag-left) (call zigzag-right)) 0.01))
  (tuple "contours=1; curves=6; closed=true" (call outline-summary (call union (call zigzag-left) (call (. (call zigzag-right) reverse)))))
  (tuple true (call optional-path-contains (tuple 5 5) (call union (call bowl-left) (call bowl-right))))
  (tuple true (call optional-path-contains (tuple 15 5) (call union (call bowl-left) (call bowl-right))))
  (tuple "contours=1; curves=6; closed=true" (call outline-summary (call union (call wave-left) (call wave-right))))
  (tuple true (call optional-path-near-area 200 (call union (call wave-left) (call wave-right)) 0.01))
  (tuple "contours=1; curves=6; closed=true" (call outline-summary (call union (call wave-left) (call (. (call wave-right) reverse)))))
  (scope (tuple "contours=1; curves=6; closed=true" (call outline-summary (call union (call round-wave-left) flipped)))
    (lazy flipped (call (. (call wave-right) reverse)))
  )
  (tuple "contours=1; curves=8; closed=true" (call outline-summary (call union (call wave-left) (call wave-notch))))
  (tuple true (call optional-path-contains (tuple 15 5) (call union (call wave-left) (call wave-notch))))
  (tuple true (not (call optional-path-contains (tuple 15 1) (call union (call wave-left) (call wave-notch)))))
  (tuple "" (call rotated-union-failures (call bulged-rect) (call side-touching-rect) "contours=1; curves=8; closed=true"))
  (tuple "" (call rotated-union-failures (call rect-a) (call side-touching-rect) "contours=1; curves=8; closed=true"))
  (tuple "" (call rotated-union-failures (call rect-a) (call touching-rect) "contours=1; curves=6; closed=true"))
  (tuple "" (call rotated-union-failures (call round-wave-left) (call wave-right) "contours=1; curves=6; closed=true"))
  (tuple "" (call rotated-union-failures (call round-wave-left) (call wave-notch) "contours=1; curves=8; closed=true"))
  (tuple "" (call rotated-union-failures (call bowl-left) (call bowl-right) "contours=1; curves=2; closed=true"))
  (tuple "contours=2; curves=8; closed=true" (call outline-summary (call union (call rect-a) (call corner-touching-rect))))
  (tuple "contours=1; curves=4; closed=true" (call outline-summary (call subtract (call rect-a) (call touching-rect))))
  (tuple true (call optional-path-near-area 100 (call subtract (call rect-a) (call touching-rect)) 0.01))
  (tuple "contours=1; curves=5; closed=true" (call outline-summary (call subtract (call zigzag-left) (call zigzag-right))))
  (tuple true (call optional-path-near-area 110 (call subtract (call zigzag-left) (call zigzag-right)) 0.01))
  (scope (tuple "contours=1; curves=8; closed=true" (call outline-summary (call union doubled (call side-touching-rect))))
    (lazy doubled (call doubled-corner-bulged-rect))
  )
  (scope (tuple "contours=1; curves=8; closed=true" (call outline-summary (call union (call side-touching-rect) doubled)))
    (lazy doubled (call doubled-corner-bulged-rect))
  )
  (header (call test "Boolean Open Paths"))
  (tuple true (call optional-path-near-area 3350 (call union (call open-petal 1 true) (call open-petal -1 true)) 0.01))
  (scope (tuple "contours=1; curves=4; closed=true" (call outline-summary (call union (call open-petal 1 false) lower)))
    (lazy lower (call open-petal -1 false))
  )
  (tuple true (call optional-path-near-area 3350 (call union (call open-petal 1 false) (call open-petal -1 false)) 0.01))
  (scope (tuple "" (call rotated-union-failures (call open-petal 1 true) (call open-petal -1 true) shape))
    (lazy shape "contours=1; curves=4; closed=true")
  )
  (scope (tuple "" (call rotated-union-failures (call open-petal 1 false) (call open-petal -1 true) shape))
    (lazy shape "contours=1; curves=4; closed=true")
  )
  (scope (tuple "contours=1; curves=3; closed=true" (call outline-summary (call subtract (call open-petal 1 true) lower)))
    (lazy lower (call open-petal -1 true))
  )
  (tuple true (call optional-path-near-area 1675 (call subtract (call open-petal 1 true) (call open-petal -1 true)) 0.01))
  (tuple "none-or-empty" (call none-or-empty-summary (call intersect (call open-petal 1 true) (call open-petal -1 true))))
  (tuple true (call optional-path-near-area 100 (call union (call rect-a) (call open-line)) 0.01))
  (header (call test "Boolean Cusp Self Union"))
  (tuple "contours=1; curves=4; closed=true; mismatches=0" (call self-union-summary (call cusp-polygon)))
  (tuple "contours=1; curves=4; closed=true; mismatches=0" (call self-union-summary (call cusp-line-start)))
  (tuple "contours=2; curves=6; closed=true; mismatches=0" (call self-union-summary (call cusp-cubic-start)))
  (tuple "contours=1; curves=6; closed=true; mismatches=0" (call self-union-summary (call flower-petal-0)))
  (tuple "contours=1; curves=9; closed=true; mismatches=0" (call self-union-summary (call flower-petal-1)))
  (tuple "contours=1; curves=12; closed=true; mismatches=0" (call self-union-summary (call flower-petal-2)))
  (tuple "contours=1; curves=9; closed=true; mismatches=0" (call self-union-summary (call flower-petal-3)))
  (tuple "contours=1; curves=8; closed=true; mismatches=0" (call self-union-summary (call flower-petal-4)))
  (tuple "contours=1; curves=8; closed=true; mismatches=0" (call self-union-summary (call flower-petal-5)))
  (tuple "contours=1; curves=8; closed=true; mismatches=0" (call self-union-summary (call flower-petal-6)))
  (tuple "contours=1; curves=8; closed=true; mismatches=0" (call self-union-summary (call flower-petal-7)))
  (header (call test "Boolean Flower Petals"))
  (tuple 0 (call union-step-mismatches (call flower-petals)))
  (tuple 0 (call region-mismatches .union-effect (call flower-petals) (call (of List Path)) (call flower-union)))
  (header (call test "Boolean Multi-Contour Overlaps"))
  (scope (tuple "contours=3; curves=12; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .union-effect (call ring) (call circle (tuple 0 0) 3)))
  )
  (scope (tuple "contours=1; curves=4; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .union-effect (call ring) (call circle (tuple 0 0) 7)))
  )
  (scope (tuple "contours=2; curves=12; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .union-effect (call ring) (call circle (tuple 10 0) 4)))
  )
  (scope (tuple "contours=2; curves=10; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .subtract-effect (call ring) (call circle (tuple 10 0) 4)))
  )
  (scope (tuple "contours=1; curves=4; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .intersect-effect (call ring) (call circle (tuple 10 0) 4)))
  )
  (scope (tuple "contours=1; curves=6; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .subtract-effect (call circle (tuple 10 0) 4) (call ring)))
  )
  (scope (tuple "contours=2; curves=12; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .union-effect (call twin-circles) (call rectangle (call Rect -2 6 4 10))))
  )
  (scope (tuple "contours=1; curves=8; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .union-effect (call twin-circles) (call twin-circles)))
  )
  (scope (tuple "contours=2; curves=12; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .subtract-effect (call twin-circles) (call rectangle (call Rect -2 -2 4 4))))
  )
  (scope (tuple "contours=1; curves=4; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .intersect-effect (call twin-circles) (call rectangle (call Rect -2 -2 4 4))))
  )
  (scope (tuple "contours=1; curves=16; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .union-effect (call twin-diamonds) (call rectangle (call Rect -12 -2 24 4))))
  )
  (scope (tuple "contours=4; curves=16; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .subtract-effect (call twin-diamonds) (call rectangle (call Rect -12 -2 24 4))))
  )
  (scope (tuple "contours=1; curves=10; closed=true; mismatches=0" summary)
    (lazy summary (call boolean-summary .union-effect (call twin-diamonds) (call twin-diamonds)))
  )
)

(fn-do + effect-tests TestRender
  (let cases (call TestCase "Boolean Effect Ownership"))
  (call (. cases run) boolean-effect-tests)
  (return cases)
)

(fn-do + boolean-effect-tests _
  (param t TestCase)
  (let source (list (call rectangle (call Rect 0 0 10 10)) (call rectangle (call Rect 5 0 10 10)) (call rectangle (call Rect 20 0 10 10))))
  (let original (. ([] source 0) bounding-box))
  (let union (call (. (call BooleanEffect .union-effect) apply) source))
  (call (. t expect) "three-way union bounds" (call Rect 0 0 30 10) (. ([] union 0) bounding-box))
  (call (. t expect)
    (block
      (arg "subtract remains left associative")
      (arg (call Rect 0 0 5 10))
      (arg (. ([] (call (. (call BooleanEffect .subtract-effect) apply) source) 0) bounding-box))
    )
  )
  (call (. t expect) "empty intersection stays empty" 0 (. (call (. (call BooleanEffect .intersect-effect) apply) source) length))
  (call (. ([] union 0) clear))
  (call (. t expect) "outputs do not alias inputs" original (. ([] source 0) bounding-box))
  (let single (call (. (call BooleanEffect) apply) (list ([] source 0))))
  (call (. ([] single 0) clear))
  (call (. t expect) "single-input outputs do not alias" original (. ([] source 0) bounding-box))
  (call (. t expect) "empty input produces no paths" 0 (. (call (. (call BooleanEffect) apply) (call (of List Path))) length))
  (return t)
)

(fn-expr + rect-a _
  (call rectangle (call Rect 0 0 10 10))
)

(fn-expr + reversed-rect-a _
  (call (. (call rect-a) reverse))
)

(fn-expr + shared-edge-left _
  (call rectangle (call Rect 10 10 60 60))
)

(fn-expr + shared-edge-right _
  (call rectangle (call Rect 40 10 60 60))
)

(fn-do + shared-edge-outline _
  (let path (call Path))
  (call (. path move-to) 40 10)
  (call (. path line-to) 100 10)
  (call (. path line-to) 100 70)
  (call (. path line-to) 40 70)
  (call (. path line-to) 40 10)
  (call (. path close))
  (return path)
)

(fn-expr + side-touching-rect _
  (call rectangle (call Rect 10 5 10 10))
)

(fn-expr + inset-touching-rect _
  (call rectangle (call Rect 10 2 10 6))
)

(fn-expr + corner-touching-rect _
  (call rectangle (call Rect 10 10 5 5))
)

(fn-do + zigzag-left _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 10 0)
  (call (. path line-to) 12 5)
  (call (. path line-to) 10 10)
  (call (. path line-to) 0 10)
  (call (. path close))
  (return path)
)

(fn-do + zigzag-right _
  (let path (call Path))
  (call (. path move-to) 10 0)
  (call (. path line-to) 20 0)
  (call (. path line-to) 20 10)
  (call (. path line-to) 10 10)
  (call (. path line-to) 12 5)
  (call (. path close))
  (return path)
)

(fn-do + bowl-left _
  (let path (call Path))
  (call (. path move-to) 10 0)
  (call (. path cubic-curve-to) (tuple 0 0) (tuple 0 10) (tuple 10 10))
  (call (. path close))
  (return path)
)

(fn-do + bowl-right _
  (let path (call Path))
  (call (. path move-to) 10 0)
  (call (. path cubic-curve-to) (tuple 20 0) (tuple 20 10) (tuple 10 10))
  (call (. path close))
  (return path)
)

(fn-do + wave-left _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 10 0)
  (call (. path cubic-curve-to) (tuple 14 3) (tuple 6 7) (tuple 10 10))
  (call (. path line-to) 0 10)
  (call (. path close))
  (return path)
)

(fn-do + round-wave-left _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 10 0)
  (call (. path cubic-curve-to) (tuple 14 3) (tuple 6 7) (tuple 10 10))
  (call (. path line-to) 0 10)
  (call (. path cubic-curve-to) (tuple -4 7) (tuple -4 3) (tuple 0 0))
  (call (. path close))
  (return path)
)

(fn-do + bulged-rect _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 10 0)
  (call (. path line-to) 10 10)
  (call (. path line-to) 0 10)
  (call (. path cubic-curve-to) (tuple -4 7) (tuple -4 3) (tuple 0 0))
  (call (. path close))
  (return path)
)

(fn-do _ rotated-union-failures _
  (param first Path)
  (param second Path)
  (param expected String)
  (let failures "")
  (for (in step (..< 0 36))
    (let matrix (call matrix-from-rotation (/ (* (as step Float) π) 18.0) (tuple 3 7)))
    (let a (call Path first))
    (let b (call Path second))
    (call (. a transform) matrix)
    (call (. b transform) matrix)
    (let forward (call outline-summary (call union a b)))
    (if (!= forward expected)
      (= failures (str failures " [" step ": " forward "]"))
    )
    (let backward (call outline-summary (call union b a)))
    (if (!= backward expected)
      (= failures (str failures " [-" step ": " backward "]"))
    )
  )
  (return failures)
)

(fn-do + open-petal _
  (param side Coord)
  (param returns Bool)
  (let path (call Path))
  (call (. path move-to) 58 (* 33.5 side))
  (call (. path line-to) 0 0)
  (call (. path line-to) 100 0)
  (if returns
    (call (. path line-to) 58 (* 33.5 side))
  )
  (return path)
)

(fn-do + open-line _
  (let path (call Path))
  (call (. path move-to) 2 2)
  (call (. path line-to) 30 30)
  (return path)
)

(fn-do + doubled-corner-bulged-rect _
  (let path (call Path))
  (call (. path move-to) 0 0)
  (call (. path line-to) 10 0)
  (call (. path line-to) 10 0)
  (call (. path line-to) 10 10)
  (call (. path line-to) 0 10)
  (call (. path cubic-curve-to) (tuple -4 7) (tuple -4 3) (tuple 0 0))
  (call (. path close))
  (return path)
)

(fn-do _ union-step-mismatches _
  (param paths (list Path))
  (let sources (list Path))
  (let joined (call Path))
  (let mismatches Size)
  (for (in path paths)
    (+= sources path)
    (if (. joined count)
      (let next (call union joined path))
      (= joined (if-expr next next (call Path)))
      (else
        (= joined path)
      )
    )
    (+= mismatches (call region-mismatches .union-effect sources (call (of List Path)) joined))
  )
  (return mismatches)
)

(fn-expr _ flower-union _
  (call first-path (call (. (call BooleanEffect .union-effect) apply) (call flower-petals)))
)

(fn-expr _ self-union-summary _
  (param path Path)
  (str (call outline-summary result) "; mismatches=" mismatches)
  (where
    (lazy result (call union path path))
    (lazy mismatches (call region-mismatches .union-effect (list path) (list path) result))
  )
)

(fn-expr _ boolean-summary _
  (param mode BooleanEffectMode)
  (param first Path)
  (param second Path)
  (str (call outline-summary result) "; mismatches=" (call region-mismatches mode (list first) (list second) result))
  (where
    (lazy result (call boolean-result mode first second))
  )
)

(fn-expr _ boolean-result _
  (param mode BooleanEffectMode)
  (param first Path)
  (param second Path)
  (match mode
    (case= .union-effect
      (call union first second)
    )
    (case= .intersect-effect
      (call intersect first second)
    )
    (default
      (call subtract first second)
    )
  )
)

(fn-do _ region-mismatches _
  (param mode BooleanEffectMode)
  (param first (list Path))
  (param second (list Path))
  (param result (? Path))
  (let bounds (. ([] first 0) bounding-box))
  (let left (. bounds left))
  (let top (. bounds top))
  (let right (. bounds right))
  (let bottom (. bounds bottom))
  (for (in path second)
    (let other (. path bounding-box))
    (= left (call min left (. other left)))
    (= top (call min top (. other top)))
    (= right (call max right (. other right)))
    (= bottom (call max bottom (. other bottom)))
  )
  (for (in path first)
    (let other (. path bounding-box))
    (= left (call min left (. other left)))
    (= top (call min top (. other top)))
    (= right (call max right (. other right)))
    (= bottom (call max bottom (. other bottom)))
  )
  (let steps 40)
  (let step-x (/ (- right left) (as steps Float)))
  (let step-y (/ (- bottom top) (as steps Float)))
  (let offset (* (call min step-x step-y) 0.05))
  (let mismatches Size)
  (for (in row (..< 0 steps))
    (for (in column (..< 0 steps))
      (let x (+ left (* (+ (as column Float) 0.5) step-x)))
      (let y (+ top (* (+ (as row Float) 0.5) step-y)))
      (let expected (call region-expects mode first second x y))
      (if (!= expected (call region-expects mode first second (+ x offset) y))
        (continue)
      )
      (if (!= expected (call region-expects mode first second (- x offset) y))
        (continue)
      )
      (if (!= expected (call region-expects mode first second x (+ y offset)))
        (continue)
      )
      (if (!= expected (call region-expects mode first second x (- y offset)))
        (continue)
      )
      (let actual (if-expr result (call (. result contains) (call Point x y) (. FillRule nonzero)) false))
      (if (!= actual expected)
        (+= mismatches 1)
      )
    )
  )
  (return mismatches)
)

(fn-expr _ region-expects _
  (param mode BooleanEffectMode)
  (param first (list Path))
  (param second (list Path))
  (param x Coord)
  (param y Coord)
  (match mode
    (case= .union-effect
      (or in-first in-second)
    )
    (case= .intersect-effect
      (and in-first in-second)
    )
    (default
      (and in-first (not in-second))
    )
  )
  (where
    (lazy in-first (call paths-contain first x y))
    (lazy in-second (call paths-contain second x y))
  )
)

(fn-do _ paths-contain _
  (param paths (list Path))
  (param x Coord)
  (param y Coord)
  (for (in path paths)
    (if (call (. path contains) (call Point x y) (. FillRule nonzero))
      (return true)
    )
  )
  (return false)
)

(fn-do + ring _
  (let path (call circle (tuple 0 0) 10))
  (call (. path add-path) (call (. (call circle (tuple 0 0) 5) reverse)))
