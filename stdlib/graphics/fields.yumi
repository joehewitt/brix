
./color
./primitives
/math
/units

━━━━━━━━━━━━━━━━━━━━
+ Streamer'Source'Result is () Iterable'Result
    - layer Source

────────────────────
+ from value Float

:: self => do
    while true
        <= value

────────────────────
+ from value Int

:: self => do
    while true
        <= value as Result

────────────────────
+ from value HSVA

:: self => do
    while true
        <= value

────────────────────
+ from value Result

:: self => do
    while true
        <= value

━━━━━━━━━━━━━━━━━━━━
+ do sin-grad'T
    - increment Radians
    - max-value T
    - min-value T = 0

. a Radians = 0
while true
    <= min-value + sin(a) * (max-value - min-value)
    a += increment

━━━━━━━━━━━━━━━━━━━━
+ sin'T
    - increment Radians
    - max-value T
    - min-value T = 0

:: self =>
    sin-grad(increment, max-value, min-value)

━━━━━━━━━━━━━━━━━━━━
+ do grad'T
    - amount T
    - decrement Percent

while true
    <= amount
    amount *= (100% - decrement) / 100

━━━━━━━━━━━━━━━━━━━━
+ do linear-grad'T
    - increment T
    - min-value T
    - max-value T

. amount = min-value
while true
    <= amount
    amount += increment
    if amount > max-value
        amount = min-value

━━━━━━━━━━━━━━━━━━━━
+ do random-grad'T
    - min-value T
    - max-value T

while true
    <= random(min-value, max-value)

━━━━━━━━━━━━━━━━━━━━
+ random-field'T
    - min-value T
    - max-value T

:: self =>
    random-grad(min-value, max-value)
