(import ./curve)
(import ./network)
(import ./network-regions)
(import ./path)
(import ./point)
(import ./primitives)
(import ./shapes)
(import ./stroke)
(import /math)

(fn-do + network-stroke _
  (param network VectorNetwork)
  (param width Length)
  (param join JoinType (= .round-join-type))
  (param cap LineCap (= .round))
  (param miter-limit Length (= 4))
  (if (or (not (call is-finite width)) (not (call is-finite miter-limit)) (< miter-limit 1))
    (throw (call Panic "Invalid network stroke settings"))
  )
  (let result (call Path))
  (let pieces (list Path))
  (return-if result (if (<= width 0)))
  (for (in trace (call (. network traces)))
    (let first (call (. network segment) ([] (. trace segments) 0)))
    (let last (call (. network segment) ([] (. trace segments) (. Position last))))
    (let start (if-expr ([] (. trace reversed) 0) (. first end) (. first start)))
    (let end (if-expr ([] (. trace reversed) (. Position last)) (. last start) (. last end)))
    (let both-leaves (and (== (call (. network degree) start) 1) (== (call (. network degree) end) 1)))
    (let outline
      (call stroke
        (block
          (arg (. trace path))
          (arg width)
          (arg .center)
          (arg join)
          (arg (if-expr both-leaves cap .butt))
          (arg miter-limit)
        )
      )
    )
    (+= pieces outline)
    (if (and (not both-leaves) (not (. trace path is-closed)))
      (if (== (call (. network degree) start) 1)
        (+= pieces
          (call network-end-cap
            (block
              (arg (call network-outgoing network (call NetworkEnd (. first id) ([] (. trace reversed) 0))))
              (arg width)
              (arg cap)
            )
          )
        )
      )
      (if (== (call (. network degree) end) 1)
        (+= pieces
          (call network-end-cap
            (block
              (arg (call network-outgoing network (call NetworkEnd (. last id) (not ([] (. trace reversed) (. Position last))))))
              (arg width)
              (arg cap)
            )
          )
        )
      )
    )
  )
  (for (in vertex (. network vertices))
    (if (> (call (. network degree) (. vertex id)) 2)
      (let curves (list Curve))
      (let angles (list Float))
      (for (in edge (. network segments))
        (if (== (. edge start) (. vertex id))
          (call network-insert-ray
            (block
              (arg curves)
              (arg angles)
              (arg (call network-outgoing network (call NetworkEnd (. edge id) false)))
            )
          )
        )
        (if (== (. edge end) (. vertex id))
          (call network-insert-ray
            (block
              (arg curves)
              (arg angles)
              (arg (call network-outgoing network (call NetworkEnd (. edge id) true)))
            )
          )
        )
      )
      (for (in i (..< 0 (. curves length)))
        (let a ([] curves i))
        (let b ([] curves (if-expr (== i (- (. curves length) 1)) 0 (+ i 1))))
        (let patch
          (call stroke-join
            (block
              (arg (. vertex position))
              (arg (* (call network-start-direction a) -1))
              (arg (call network-start-direction b))
              (arg width)
              (arg join)
              (arg miter-limit)
            )
          )
        )
        (+= pieces patch)
      )
    )
  )
  (return-if ([] pieces 0) (if (== (. pieces length) 1)))
  (for (in piece pieces)
    (let area Float)
    (for (in curve (. piece curves))
      (+= area (call network-curve-area curve))
    )
    (if (< area 0)
      (for (in subpath (. piece subpaths))
        (call (. result add-path) (call (. (call (. subpath materialize)) reverse)))
      )
      (else
        (call (. result add-path) piece)
      )
    )
  )
  (return result)
)

(fn-expr + network-outgoing _
  (param network VectorNetwork)
  (param endpoint NetworkEnd)
  (if-expr (. endpoint at-end) flipped curve)
  (where
    (lazy curve (call (. network curve) (. endpoint segment)))
    (lazy flipped (call Curve (. curve anchor2) (. curve handle-in) (. curve handle-out) (. curve anchor1)))
  )
)

(fn-do _ network-insert-ray _
  (param curves (list Curve))
  (param angles (list Float))
  (param curve Curve)
  (let tangent (call network-start-direction curve))
  (let angle (call atan2 (. tangent y) (. tangent x)))
  (for (in i (..< 0 (. angles length)))
    (if (< angle ([] angles i))
      (call (. curves insert) curve i)
      (call (. angles insert) angle i)
      (return)
    )
  )
  (+= curves curve)
  (+= angles angle)
)

(fn-do + network-start-direction _
  (param curve Curve)
  (let delta (- (. curve handle-out) (. curve anchor1)))
  (if (<= (. delta length) 0.000000001)
    (= delta (- (. curve handle-in) (. curve anchor1)))
  )
  (if (<= (. delta length) 0.000000001)
    (= delta (- (. curve anchor2) (. curve anchor1)))
  )
  (return (if-expr (> (. delta length) 0) (/ delta (. delta length)) (call Point 1 0)))
)

(fn-do _ network-end-cap _
  (param curve Curve)
  (param width Length)
  (param cap LineCap)
  (return-if (call Path) (if (== cap .butt)))
  (return-if (call circle (. curve anchor1) (/ width 2)) (if (== cap .round)))
  (let direction (* (call network-start-direction curve) (/ width 2)))
  (let normal (call Point (- (. direction y)) (. direction x)))
  (let center (. curve anchor1))
  (let result (call Path))
  (call (. result move-to) (+ center normal))
  (call (. result line-to) (- (+ center normal) direction))
  (call (. result line-to) (- center normal direction))
  (call (. result line-to) (- center normal))
  (call (. result close))
  (return result)
)

(type + NetworkStrokeWorkspace
  (prop _ owner (? VectorNetwork))
  (prop _ version Size)
  (prop _ last-width Length)
  (prop _ last-join JoinType (= .round-join-type))
  (prop _ last-cap LineCap (= .round))
  (prop _ last-limit Length (= 4))
  (prop _ cached (? Path))
  (fn-do + resolve Path
    (param network VectorNetwork)
    (param width Length)
    (param join JoinType (= .round-join-type))
    (param cap LineCap (= .round))
    (param miter-limit Length (= 4))
    (let same-owner (and owner (== (as owner Pointer) (as network Pointer))))
    (let same-version (== version (. network revision)))
    (let same-settings (and (== width last-width) (== join last-join) (== cap last-cap)))
    (if (and same-owner same-version same-settings (== miter-limit last-limit) cached)
      (return cached)
    )
    (let result (call network-stroke network width join cap miter-limit))
    (= owner network)
    (= version (. network revision))
    (= last-width width)
    (= last-join join)
    (= last-cap cap)
    (= last-limit miter-limit)
    (= cached result)
    (return result)
  )
  (fn-do + clear _
    (= owner null)
    (= cached null)
  )
)
