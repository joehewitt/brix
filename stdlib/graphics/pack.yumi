
./canvas
./graphic
./intersection
./path
./point
./primitives
./shapes
/math

━━━━━━━━━━━━━━━━━━━━
+ Circ is (pt Point, radius Length)

────────────────────
+ to Path

circle(pt, radius)

━━━━━━━━━━━━━━━━━━━━
+ do pack-circles
    - size Dimensions
    - bounds Path
    - min-radius Coord = 10
    - max-radius Coord = 20
    - incr-radius Coord = 1
    - inverted = false

//graphics.pack.runs ++
. packed [Circ]
. failures = 0

. bbox = bounds.bounding-box

. looping = true
while looping
    . radius = min-radius
    . x =
        |? inverted
            random(0, size.width)
        ??
            random(bbox.left, bbox.right - radius * 2)
    . y =
        |? inverted
            random(0, size.height)
        ??
            random(bbox.top, bbox.bottom - radius * 2)
    . pt = Point(x, y)
    . last-radius = 0
    while true
        . did-fit = fits-bounds && !intersect-paths(bounds, circle(pt, radius)) && misses-packed
            .. fits-bounds = radius < max-radius && bounds.contains(pt) != inverted
            .. misses-packed = !circles-intersect(packed, (pt, radius))
        if did-fit
            last-radius = radius
            radius += incr-radius
        else if last-radius
            packed += (pt, last-radius)
            if packed.length > 1000
                looping = false
            break
        else
            failures += 1
            break

    if failures > 30000
        break

= packed

━━━━━━━━━━━━━━━━━━━━
+ do connect-circles
    - circles

for circ1 in circles
    for circ2 in circles when circ1 != circ2
        . hit = true
        for circ3 in circles when circ3 != circ1 && circ3 != circ2
            if circle-line-intersect(circ1.pt, circ2.pt, circ3.pt, circ3.radius)
                hit = false
                break
        if hit
            <= line(circ1.pt, circ2.pt)

━━━━━━━━━━━━━━━━━━━━
+ do circle-line-intersect
    - a Point
    - b Point
    - c Point
    - r Coord

//graphics.pack.line-tests ++
a = a.x -= c.x
a = a.y -= c.y
b = b.x -= c.x
b = b.y -= c.y

. dx = b.x - a.x
. dy = b.y - a.y
. aa = dx * dx + dy * dy
. bb = 2 * (a.x * (b.x - a.x) + a.y * (b.y - a.y))
. cc = a.x * a.x + a.y * a.y - r * r
. disc = bb * bb - 4 * aa * cc
=? if disc <= 0

. sqrtdisc = sqrt(disc)
. t1 = (-bb + sqrtdisc) / (2 * aa)
. t2 = (-bb - sqrtdisc) / (2 * aa)

= (0 < t1 && t1 < 1) || (0 < t2 && t2 < 1)

━━━━━━━━━━━━━━━━━━━━
+ do circles-intersect
    - packed [Circ]
    - a Circ

//graphics.pack.circle-scans ++
for b in packed when intersect-circles(a, b)
    = true

= false

━━━━━━━━━━━━━━━━━━━━
+ do intersect-circles
    - a Circ
    - b Circ

//graphics.pack.circle-tests ++
= abs(a.pt.distance(b.pt)) < min-radius

.. min-radius = a.radius + b.radius
