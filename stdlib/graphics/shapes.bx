(import ./path)
(import ./point)
(import ./primitives)
(import /math)

(fn-do + line _
  (param p1 Point)
  (param p2 Point)
  (let path (call Path))
  (call (. path reserve) 2 4)
  (call (. path move-to) (. p1 x) (. p1 y))
  (call (. path line-to) (. p2 x) (. p2 y))
  (return path)
)

(fn-do + square _
  (param center Point)
  (param size Length)
  (let path (call Path))
  (call (. path reserve) 5 8)
  (call (. path move-to) (. center x) (. center y))
  (call (. path line-to) (+ (. center x) size) (. center y))
  (call (. path line-to) (+ (. center x) size) (+ (. center y) size))
  (call (. path line-to) (. center x) (+ (. center y) size))
  (call (. path close))
  (return path)
)

(fn-do + rectangle _
  (param rect Rect)
  (let path (call Path))
  (call (. path reserve) 5 8)
  (call (. path move-to) (. rect x) (. rect y))
  (call (. path line-to) (+ (. rect x) (. rect width)) (. rect y))
  (call (. path line-to) (+ (. rect x) (. rect width)) (+ (. rect y) (. rect height)))
  (call (. path line-to) (. rect x) (+ (. rect y) (. rect height)))
  (call (. path close))
  (return path)
)

(fn-do + axis-rect _
  (param path Path)
  (return-if (if (not (. path is-closed))))
  (return-if (if (!= (. path count) 5)))
  (blank)
  (let bbox (. path bounding-box))
  (let has-top-left false)
  (let has-top-right false)
  (let has-bottom-right false)
  (let has-bottom-left false)
  (blank)
  (let span (. path commands))
  (let first-x Coord)
  (let first-y Coord)
  (let prev-x Coord)
  (let prev-y Coord)
  (let has-prev false)
  (for (in i (..< 0 (. span command-count)))
    (let verb ([] (. span verbs) i))
    (return-if (if (== verb .path-verb-cubic)))
    (blank)
    (if (== verb .path-verb-close)
      (if has-prev
        (return-if (if (not (call axis-rect-segment-xy prev-x prev-y first-x first-y))))
      )
      (continue)
    )
    (return-if (if (and (== verb .path-verb-move) (!= i 0))))
    (blank)
    (let start ([] (. span coord-offsets) i))
    (let x ([] (. span coords) start))
    (let y ([] (. span coords) (+ start 1)))
    (if has-prev
      (return-if (if (not (call axis-rect-segment-xy prev-x prev-y x y))))
      (else
        (= first-x x)
        (= first-y y)
        (= has-prev true)
      )
    )
    (blank)
    (if (call near-corner-xy x y (. bbox left) (. bbox top))
      (= has-top-left true)
      (else-if (call near-corner-xy x y (. bbox right) (. bbox top))
        (= has-top-right true)
      )
      (else-if (call near-corner-xy x y (. bbox right) (. bbox bottom))
        (= has-bottom-right true)
      )
      (else-if (call near-corner-xy x y (. bbox left) (. bbox bottom))
        (= has-bottom-left true)
      )
      (else
        (return)
      )
    )
    (= prev-x x)
    (= prev-y y)
  )
  (blank)
  (return-if (if (not has-top-left)))
  (return-if (if (not has-top-right)))
  (return-if (if (not has-bottom-right)))
  (return-if (if (not has-bottom-left)))
  (blank)
  (return bbox)
)

(fn-expr + near-corner _
  (param point Point)
  (param corner Point)
  (< (call (. point distance) corner) 0.00001)
)

(fn-expr + near-corner-xy _
  (param x Coord)
  (param y Coord)
  (param corner-x Coord)
  (param corner-y Coord)
  (< (+ (* dx dx) (* dy dy)) 0.0000000001)
  (where
    (lazy dx (- x corner-x))
    (lazy dy (- y corner-y))
  )
)

(fn-expr + axis-rect-segment-xy _
  (param x1 Coord)
  (param y1 Coord)
  (param x2 Coord)
  (param y2 Coord)
  (or (< (* dx dx) 0.0000000001) (< (* dy dy) 0.0000000001))
  (where
    (lazy dx (- x1 x2))
    (lazy dy (- y1 y2))
  )
)

(fn-do + circle _
  (param center Point)
  (param radius Length)
  (let x (- (. center x) radius))
  (let y (- (. center y) radius))
  (let w (* radius 2))
  (let h (* radius 2))
  (let kappa 0.5522848)
  (let ox (* (/ w 2) kappa))
  (let oy (* (/ h 2) kappa))
  (let xe (+ x w))
  (let ye (+ y h))
  (let xm (+ x (/ w 2)))
  (let ym (+ y (/ h 2)))
  (blank)
  (let path (call Path))
  (call (. path reserve) 6 26)
  (call (. path move-to) x ym)
  (call (. path cubic-curve-to) x (- ym oy) (- xm ox) y xm y)
  (call (. path cubic-curve-to) (+ xm ox) y xe (- ym oy) xe ym)
  (call (. path cubic-curve-to) xe (+ ym oy) (+ xm ox) ye xm ye)
  (call (. path cubic-curve-to) (- xm ox) ye x (+ ym oy) x ym)
  (call (. path close))
  (return path)
)

(fn-do + ellipse _
  (param center Point)
  (param radius Dimensions)
  (let x (- (. center x) (. radius width)))
  (let y (- (. center y) (. radius height)))
  (let w (* (. radius width) 2))
  (let h (* (. radius height) 2))
  (blank)
  (let magic 0.5522847498)
  (let ox (* (. radius width) magic))
  (let oy (* (. radius height) magic))
  (let xe (+ x w))
  (let ye (+ y h))
  (let xm (+ x (. radius width)))
  (let ym (+ y (. radius height)))
  (blank)
  (let path (call Path))
  (call (. path reserve) 6 26)
  (call (. path move-to) x ym)
  (call (. path cubic-curve-to) x (- ym oy) (- xm ox) y xm y)
  (call (. path cubic-curve-to) (+ xm ox) y xe (- ym oy) xe ym)
  (call (. path cubic-curve-to) xe (+ ym oy) (+ xm ox) ye xm ye)
  (call (. path cubic-curve-to) (- xm ox) ye x (+ ym oy) x ym)
  (call (. path close))
  (blank)
  (if (not (. path is-clockwise))
    (= path (call (. path reverse)))
  )
  (return path)
)

(fn-do + polygon _
  (param sides U32)
  (param width Length)
  (param center _ (= (call Point 0 0)))
  (let rx Coord (/ width 2.0))
  (let ry Coord (/ width 2.0))
  (blank)
  (let step (/ (* π 2.0) sides))
  (let a1 (/ (- π) 2.0))
  (blank)
  (let path (call Path))
  (call (. path reserve) (+ (as sides Size) 1) (* (as sides Size) 2))
  (blank)
  (for (in i (..< 0.0 sides))
    (let angle (+ a1 (* step (+ (- i) 1.0))))
    (let px (* (call cos angle) rx))
    (let py (* (call sin angle) ry))
    (let point (call Point (+ (. center x) px) (+ (. center y) py)))
    (blank)
    (if (== i 0)
      (call (. path move-to) point)
      (else
        (call (. path line-to) point)
      )
    )
  )
  (blank)
  (call (. path close))
  (blank)
  (if (not (. path is-clockwise))
    (= path (call (. path reverse)))
  )
  (blank)
  (return path)
)

(fn-do + spiral _
  (param center Point)
  (param radius Length)
  (param coils Float)
  (param chord Length (= 1))
  (param rotation Radians (= 0))
  ; Geometry algorithm from here:
  ; https://stackoverflow.com/questions/13894715/draw-equidistant-points-on-a-spiral
  (blank)
  (let spiral (call Path))
  (blank)
  (let theta-max (* coils 2 π))
  (let away-step (/ radius theta-max))
  (let theta (/ chord away-step))
  (let ys 0)
  (blank)
  (while (<= theta theta-max)
    (let away (* away-step theta))
    (let around (+ theta rotation))
    (let x (+ (. center x) (* (call cos around) away)))
    (let y (+ (. center y) (* (call sin around) away) ys))
    (call (. spiral line-to) x y)
    (blank)
    ; theta += chord / away
    (+= theta (/ (+ (* -2 away) (call sqrt (+ (* 4 away away) (* 8 away-step chord)))) (* 2 away-step)))
    (blank)
    ; ys += 1
    (+= radius 0.3)
    (= away-step (/ radius theta-max))
  )
  (blank)
  (return spiral)
)

(fn-do + leaf _
  (param center Point)
  (param size Dimensions)
  (let path (call Path))
  (blank)
  (call (. path move-to) center)
  (blank)
  (let tail (call Point (/ (. size width) 18.0) (/ (. size height) 8.0)))
  (let pt (- center (tuple (. tail x) (- (. size height) (. tail y)))))
  (let ho (+ pt (tuple (/ (- (. size width)) 3.0) (/ (. size height) 3.0))))
  (call (. path cubic-curve-to) (- center (tuple (* (. size width) 0.85) 0.0)) ho pt)
  (blank)
  (let pt1 (- center (tuple 0.0 (. size height))))
  (call (. path cubic-curve-to) (+ pt (tuple (. tail x) (/ (- (. tail y)) 2.0))) pt1 pt1)
  (blank)
  (let m (call Path path))
  (call (. m mirror-x) (. center x))
  (+= path (call (. m reverse)))
  (blank)
  (call (. path close))
  (blank)
  (call (. path translate) (tuple 0 (/ (. size height) 2)))
  (blank)
  (return path)
)

(fn-do + teardrop _
  (param center Point)
  (param size Dimensions)
  (let path (call Path))
  (blank)
  (call (. path move-to) center)
  (blank)
  (let pt (- center (tuple 0 (. size height))))
  (let ho (- pt (tuple (. size width) 0)))
  (call (. path cubic-curve-to) center ho pt)
  (blank)
  (let m (call Path path))
  (call (. m mirror-x) (. center x))
  (+= path (call (. m reverse)))
  (blank)
  (return path)
)
