(import ./appearance)
(import ./canvas)
(import ./color)
(import ./effect)
(import ./graphic)
(import ./matrix)
(import ./path)
(import ./path-set)
(import ./primitives)
(import ./style)
(import ./vector-source)
(import ./vectorgeometry)
(import /core/intrinsics)
(import /core/markup)
(import /core/style)
(import /units)
(blank)
(prop + vector-geometry-chunk-capacity Size (= 256))

(type + VectorGroupHost (is Interface)
  (implements MarkupElement)
  (implements MarkupRootElement)
  (using VectorPaintStyle)
  (fn-do + vector-host-viewport (? Rect) :get)
  (fn-do + vector-host-transform (? Matrix) :get)
  (fn-do + vector-host-changed _
    (param kinds U8)
  )
)

(type _ VectorGroupSlice
  (implements VectorGeometrySource)
  (prop + group VectorGroup)
  (prop + start Size)
  (prop + end Size)
  (fn-do _ This _
    (param group _)
    (param start _)
    (param end _)
  )
  (fn-do + prepare-vector-geometry-source _
    (call (. group ensure-vector-style-root))
  )
  (fn-expr + vector-geometry-source-pointer Pointer :get
    (as this Pointer)
  )
  (fn-expr + vector-geometry-source-kind U8 :get
    vector-geometry-source-container
  )
  (fn-expr + vector-geometry-source-fill Fill :get
    (. group $fill)
  )
  (fn-expr + vector-geometry-source-stroke Stroke :get
    (. group $stroke)
  )
  (fn-expr + vector-geometry-source-stroke-width (? Length) :get
    (. group $stroke-width)
  )
  (fn-expr + vector-geometry-source-stroke-cap (? LineCap) :get
    (. group $stroke-cap)
  )
  (fn-expr + vector-geometry-source-stroke-join (? LineJoin) :get
    (. group $stroke-join)
  )
  (fn-expr + vector-geometry-source-fill-rule (? FillRule) :get
    (. group $fill-rule)
  )
  (fn-expr + vector-geometry-source-transform (? Matrix) :get
    (. group $transform)
  )
  (fn-expr + vector-geometry-source-compact Bool :get
    (. group vector-geometry-source-compact)
  )
  (fn-expr + vector-geometry-source-child-count Size :get
    (- end start)
  )
  (fn-expr + vector-geometry-source-child VectorGeometrySource
    (param index Index)
    (call (. group vector-item-source) (+ start index))
  )
)

(type _ VectorHostedSource
  (implements VectorGeometrySource)
  (prop + group VectorGroup)
  (prop + host VectorGroupHost)
  (prop + content VectorGeometrySource)
  (fn-do _ This _
    (param group _)
    (param host _)
    (param content _)
  )
  (fn-do + prepare-vector-geometry-source _
    (call (. content prepare-vector-geometry-source))
  )
  (fn-expr + vector-geometry-source-pointer Pointer :get
    (as this Pointer)
  )
  (fn-expr + vector-geometry-source-kind U8 :get
    vector-geometry-source-container
  )
  (fn-expr + vector-geometry-source-fill Fill :get
    (. host $fill)
  )
  (fn-expr + vector-geometry-source-stroke Stroke :get
    (. host $stroke)
  )
  (fn-expr + vector-geometry-source-stroke-width (? Length) :get
    (. host $stroke-width)
  )
  (fn-expr + vector-geometry-source-stroke-cap (? LineCap) :get
    (. host $stroke-cap)
  )
  (fn-expr + vector-geometry-source-stroke-join (? LineJoin) :get
    (. host $stroke-join)
  )
  (fn-expr + vector-geometry-source-fill-rule (? FillRule) :get
    (. host $fill-rule)
  )
  (fn-expr + vector-geometry-source-transform (? Matrix) :get
    (call (. group vector-viewport-transform))
  )
  (fn-expr + vector-geometry-source-compact Bool :get
    (call vector-paint-is-compact (. host $fill) (. host $stroke) (. host $stroke-alignment))
  )
  (fn-expr + vector-geometry-source-child-count Size :get
    1
  )
  (fn-expr + vector-geometry-source-child VectorGeometrySource
    (param index Index)
    content
  )
)

(type _ VectorGeometryChunk
  (prop + source VectorGeometrySource)
  (prop + handle VectorGeometryHandle)
  (prop + palette (list RGBA))
  (fn-do _ This _
    (param source _)
    (param handle _)
    (param palette _)
  )
)

(type + VectorGroup
  (implements VectorNode)
  (implements GraphicContainer)
  (implements MarkupRootElement)
  (implements (of MarkupParent VectorNode))
  (using VectorPaintStyle)
  (using VectorCompositeStyle)
  (prop + id Size (= (call next-graphic-node-id)))
  (prop + invalidation-listener (? GraphicInvalidationListener))
  (prop + name _ (= ""))
  (prop + cache-policy _ (= (. GraphicsCachePolicy retained-cache)))
  (prop + paints-generated-result _ (= false))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (prop _ host (? VectorGroupHost))
  (prop _ hosted-source (? VectorHostedSource))
  (prop _ vector-items (list VectorNode))
  (prop _ vector-parent-node (? VectorGroup))
  (prop _ pending-nodes (list GraphicNode))
  (prop _ pending-groups (list VectorGroup))
  (prop _ pending-vector-kinds U8)
  (prop _ pending-published-kinds U8)
  (prop _ update-depth Size)
  (prop _ frame-version Size)
  (prop _ output-version Size (= 1))
  (prop _ computed-paths (? (list Path)))
  (prop _ computed-stamp (? GraphicsCacheStamp))
  (prop _ vector-geometry-table (? VectorGeometryTable))
  (prop _ vector-geometry-chunks (list VectorGeometryChunk))
  (prop _ vector-geometry-item-indices (? (of Map Pointer Size)))
  (prop _ vector-geometry-dirty-chunks (list Size))
  (prop _ vector-geometry-full-dirty _ (= true))
  (prop _ vector-geometry-support-checked _ (= false))
  (prop _ vector-geometry-supported _ (= false))
  (prop _ vector-geometry-source-revision Size)
  (blank)
  (prop + parent _ (=> vector-parent-node))
  (prop + revision _ (=> output-version))
  (prop + frame _ (=> (. (call vector-root) frame-version)))
  (blank)
  (depends vector-metadata-changed name)
  (depends vector-composite-changed cache-policy paints-generated-result)
  (fn-do + This _)
  (fn-do + This _
    (param owner VectorGroupHost)
    (= host owner)
  )
  (fn-do + This _
    (param paths (list Path))
    (call begin-update)
    (for (in path paths)
      (+= this (call PathGraphic path))
    )
    (call end-update)
  )
  (fn-do + items (list VectorNode) :get
    (for (in item vector-items)
      (yield item)
    )
  )
  (fn-do + graphics (list GraphicNode) :get
    (for (in item vector-items)
      (if (is item GraphicNode)
        (yield (as item GraphicNode))
      )
    )
  )
  (fn-do + child-paths (stream Path) :get
    (for (in item vector-items)
      (if (. item $visible)
        (call (. item update) (call last-evaluation-bounds))
        (for (in path (. item paths))
          (yield path)
        )
      )
    )
  )
  (fn-expr + paths (list Path) :get
    (?? computed-paths (call (of List Path)))
  )
  (fn-do + bounding-box _ :get
    (call update (call last-evaluation-bounds))
    (return (call paths-bounding-box paths))
  )
  (fn-do + prepare-vector-geometry-source _
    (call ensure-vector-style-root)
  )
  (fn-expr + vector-geometry-source-pointer Pointer :get
    (as this Pointer)
  )
  (fn-expr + vector-geometry-source-kind U8 :get
    vector-geometry-source-container
  )
  (fn-expr + vector-geometry-source-fill Fill :get
    $fill
  )
  (fn-expr + vector-geometry-source-stroke Stroke :get
    $stroke
  )
  (fn-expr + vector-geometry-source-stroke-width (? Length) :get
    $stroke-width
  )
  (fn-expr + vector-geometry-source-stroke-cap (? LineCap) :get
    $stroke-cap
  )
  (fn-expr + vector-geometry-source-stroke-join (? LineJoin) :get
    $stroke-join
  )
  (fn-expr + vector-geometry-source-fill-rule (? FillRule) :get
    $fill-rule
  )
  (fn-expr + vector-geometry-source-transform (? Matrix) :get
    $transform
  )
  (fn-expr + vector-geometry-source-compact Bool :get
    (and is-plain (call vector-paint-is-compact $fill $stroke $stroke-alignment))
    (where
      (lazy is-plain (and $visible (>= $opacity 1%%) (not (. $effects length)) (not paints-generated-result)))
    )
  )
  (fn-expr + vector-geometry-source-child-count Size :get
    (. vector-items length)
  )
  (fn-expr + vector-geometry-source-child VectorGeometrySource
    (param index Index)
    (call vector-item-source index)
  )
  (fn-do + effective-cache-policy GraphicsCachePolicy :get
    (let policy cache-policy)
    (return-if .no-cache (if (== policy .no-cache)))
    (for (in item vector-items)
      (let child-policy (. item effective-cache-policy))
      (return-if .no-cache (if (== child-policy .no-cache)))
      (if (== child-policy .frame-cache)
        (= policy .frame-cache)
      )
    )
    (return policy)
  )
  (fn-do + markup-absorb _
    (param content VectorNode)
    (match? content
      (case (: graphic GraphicNode)
        (call insert-graphic graphic null)
      )
      (case (: group VectorGroup)
        (call insert-group group null)
      )
    )
  )
  (fn-do + (infix this += (param child GraphicNode)) _
    (call insert-graphic child null)
  )
  (fn-do + (infix this -= (param child GraphicNode)) _
    (call remove-graphic child)
  )
  (fn-do + (infix this += (param child VectorGroup)) _
    (call insert-group child null)
  )
  (fn-do + (infix this -= (param child VectorGroup)) _
    (call remove-group child)
  )
  (fn-do + insert-graphic _
    (param child GraphicNode)
    (param anchor (? GraphicNode))
    (return-if (if (and anchor (== (as child Pointer) (as anchor Pointer)))))
    (return-if (if (and anchor (or (not (. anchor parent)) (!= (as (. anchor parent) Pointer) (as this Pointer))))))
    (let old-parent (. child parent))
    (if old-parent
      (call (. old-parent graphic-remove) child)
    )
    (call markup-insert this child anchor)
  )
  (fn-do + remove-graphic _
    (param child GraphicNode)
    (return-if (if (or (not (. child parent)) (!= (as (. child parent) Pointer) (as this Pointer)))))
    (call markup-remove this child)
  )
  (fn-do + insert-group _
    (param child VectorGroup)
    (param anchor (? VectorGroup))
    (return-if (if (and anchor (== (as child Pointer) (as anchor Pointer)))))
    (let old-parent (. child vector-parent-node))
    (if old-parent
      (call (. old-parent remove-group) child)
    )
    (if (. child host)
      (call attach-item child anchor)
      (else
        (call markup-insert this child anchor)
      )
    )
  )
  (fn-do + remove-group _
    (param child VectorGroup)
    (return-if (if (or (not (. child vector-parent-node)) (!= (as (. child vector-parent-node) Pointer) (as this Pointer)))))
    (if (. child host)
      (call detach-item child)
      (else
        (call markup-remove this child)
      )
    )
  )
  (fn-do + clear _
    (let graphics-to-remove (list GraphicNode))
    (let groups-to-remove (list VectorGroup))
    (for (in item vector-items)
      (match? item
        (case (: graphic GraphicNode)
          (+= graphics-to-remove graphic)
        )
        (case (: group VectorGroup)
          (if (not (. group host))
            (+= groups-to-remove group)
          )
        )
      )
    )
    (for (in graphic graphics-to-remove)
      (call remove-graphic graphic)
    )
    (for (in group groups-to-remove)
      (call remove-group group)
    )
  )
  (fn-do + begin-update _
    (call graphic-begin-update)
  )
  (fn-do + checkpoint _
    (call ensure-vector-style-root)
    (let batch markup-batch-root)
    (if batch
      (call (. batch markup-batch-queue checkpoint))
    )
    (call graphic-checkpoint)
  )
  (fn-do + end-update _
    (call ensure-vector-style-root)
    (let batch markup-batch-root)
    (if batch
      (call (. batch markup-batch-queue checkpoint))
    )
    (call graphic-end-update)
  )
  (fn-do + next-frame _
    (call graphic-next-frame)
  )
  (fn-do + vector-composite-changed _
    (call vector-content-changed graphic-change-composite)
  )
  (fn-do + vector-metadata-changed _
    (call vector-content-changed graphic-change-metadata)
  )
  (fn-do + markup-style-domains-changed _
    (param mask U32)
    (let kinds (call vector-style-change-kinds mask))
    (if kinds
      (call vector-content-changed kinds)
    )
  )
  (fn-do + close _
    (for (in item vector-items)
      (match? item
        (case (: graphic GraphicNode)
          (call release-node graphic)
        )
        (case (: group VectorGroup)
          (if (not (. group host))
            (call release-node group)
          )
        )
      )
    )
    (call release-vector-geometry)
  )
  (fn-do + update _
    (param bounds Rect)
    (call ensure-vector-style-root)
    (if update-depth
      (call graphic-checkpoint)
    )
    (let frame (. (call vector-root) frame-version))
    (return-if (if (and computed-paths (call (. current-stamp reuses) effective-cache-policy computed-stamp))))
    (lazy current-stamp (call GraphicsCacheStamp output-version bounds frame))
    (let source (list Path))
    (for (in path (call draw bounds))
      (+= source (call Path path))
    )
    (for (in item vector-items)
      (if (not (. item $visible))
        (continue)
      )
      (match? item
        (case (: child GraphicNode)
          (call (. child update) bounds)
          (for (in path (. child paths))
            (let result (call Path path))
            (if (. child $transform)
              (call (. result transform) (!! (. child $transform)))
            )
            (+= source result)
          )
        )
        (case (: child VectorGroup)
          (call (. child update) (call (. child vector-evaluation-bounds) bounds))
          (for (in path (. child paths))
            (let result (call Path path))
            (let transform (call (. child vector-transform-to-parent)))
            (if transform
              (call (. result transform) transform)
            )
            (+= source result)
          )
        )
      )
    )
    (= computed-paths (call (. $effects apply) source))
    (= computed-stamp (call GraphicsCacheStamp output-version bounds frame))
  )
  (fn-do + draw (stream Path)
    (let empty (list Path))
    (yield-all empty)
  )
  (fn-expr + draw (stream Path)
    (param bounds Rect)
    (call draw)
  )
  (fn-do + prepare-paint _
    (param bounds Rect)
  )
  (fn-do + paint-vector _
    (param canvas Canvas)
    (param inherited (? VectorAppearance) (= null))
    (param apply-opacity _ (= true))
    (param outer-effects (? VectorEffects) (= null))
    (param area (? Rect) (= null))
    (call ensure-vector-style-root)
    (return-if (if (not $visible)))
    (let appearance
      (call vector-appearance-over
        (block
          (arg this)
          (arg (call hosted-appearance (?? inherited (call canvas-vector-appearance canvas))))
        )
      )
    )
    (do-use (. canvas saved-state)
      (let opacity $opacity)
      (if (and apply-opacity (< opacity 1%%))
        (call (. canvas begin-opacity) opacity)
      )
      (if $transform
        (call (. canvas transform) (!! $transform))
      )
      (let bounds (?? area (call Rect 0 0 (. canvas width) (. canvas height))))
      (if (or (. $effects combines-geometry) paints-generated-result)
        (call update bounds)
        (let combined (if-expr outer-effects (call (. outer-effects apply) paths) paths))
        (call paint-appearance canvas combined appearance)
        (else
          (call prepare-paint bounds)
          (let member-effects (call member-effects-within outer-effects))
          (let own (list Path))
          (for (in path (call draw bounds))
            (+= own path)
          )
          (if (. own length)
            (let painted (if-expr member-effects (call (. member-effects apply) own) own))
            (call paint-appearance canvas painted appearance)
          )
          (for (in item vector-items)
            (match? item
              (case (: child GraphicNode)
                (call (. child paint) canvas appearance member-effects)
              )
              (case (: child VectorGroup)
                (call (. child paint-vector-in-parent) canvas appearance bounds member-effects)
              )
            )
          )
        )
      )
      (if (and apply-opacity (< opacity 1%%))
        (call (. canvas end-opacity))
      )
    )
  )
  (fn-do + compile-vector-geometry _
    (param viewport Rect)
    (call ensure-vector-style-root)
    (let ignored (call can-paint-vector-geometry viewport))
  )
  (fn-expr + vector-geometry-chunk-count Size :get
    (. vector-geometry-chunks length)
  )
  (fn-do + paint-vector-geometry Bool
    (param canvas Canvas)
    (param viewport Rect)
    (param transform Matrix)
    (param content Rect)
    (param color (? RGBA))
    (return-if false (if (not (call can-paint-vector-geometry viewport))))
    (= (. canvas fill-color) color)
    (= (. canvas stroke-color) color)
    (let table (!! vector-geometry-table))
    (if (== (. vector-geometry-chunks length) 1)
      (let chunk ([] vector-geometry-chunks 0))
      (return-if true (if (call (. table paint-vector-raster) (. chunk handle) canvas (. chunk palette) transform content)))
    )
    (for (in chunk vector-geometry-chunks)
      (call (. table paint-vector) (. chunk handle) canvas (. chunk palette) transform content)
    )
    (return true)
  )
  (fn-expr _ member-effects-within (? VectorEffects)
    (param outer-effects (? VectorEffects))
    (case? (not (. own has-enabled))
      outer-effects
    )
    (case? (not outer-effects)
      own
    )
    (default
      (call (. own followed-by) outer-effects)
    )
    (where
      (lazy own $effects)
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + markup-attach-child _
    (param child VectorNode)
    (param anchor (? VectorNode))
    (call attach-item child anchor)
  )
  (fn-do + markup-detach-child _
    (param child VectorNode)
    (call detach-item child)
  )
  (fn-expr + graphic-container-parent (? GraphicContainer) :get
    vector-parent-node
  )
  (fn-expr + graphic-update-depth Size :get
    (. (call vector-root) update-depth)
  )
  (fn-expr + graphic-frame-version Size :get
    (. (call vector-root) frame-version)
  )
  (fn-expr + graphic-container-node (? GraphicNode) :get
    null
  )
  (fn-expr + graphic-container-pointer Pointer :get
    (as this Pointer)
  )
  (fn-do + graphic-begin-update _
    (let root (call vector-root))
    (+= (. root update-depth) 1)
  )
  (fn-do + graphic-checkpoint _
    (call (. (call vector-root) flush-graphic-changes) false)
  )
  (fn-do + graphic-end-update _
    (let root (call vector-root))
    (call (. root flush-graphic-changes) false)
    (if (. root update-depth)
      (-= (. root update-depth) 1)
    )
    (if (not (. root update-depth))
      (call (. root publish-graphic-changes))
    )
  )
  (fn-do + graphic-queue-change _
    (param node GraphicNode)
    (param kinds U8)
    (let root (call vector-root))
    (if (not (. node has-pending-change))
      (+= (. root pending-nodes) node)
    )
    (call (. node merge-pending-change) kinds)
    (let owner (. node parent))
    (while owner
      (let container owner)
      (let container-node (. container graphic-container-node))
      (if container-node
        (if (not (. container-node has-pending-change))
          (+= (. root pending-nodes) container-node)
        )
        (call (. container-node merge-pending-change) kinds)
        (else
          (let group (call (of gc-object-from-pointer VectorGroup) (. container graphic-container-pointer)))
          (call (. group queue-vector-geometry-node) node)
          (call (. root queue-vector-invalidation) group kinds)
        )
      )
      (= owner (. container graphic-container-parent))
    )
    (if (not (. root update-depth))
      (call (. root flush-graphic-changes) true)
    )
  )
  (fn-do + graphic-insert _
    (param child GraphicNode)
    (param anchor (? GraphicNode))
    (call insert-graphic child anchor)
  )
  (fn-do + graphic-remove _
    (param child GraphicNode)
    (call remove-graphic child)
  )
  (fn-do + graphic-next-frame _
    (let root (call vector-root))
    (+= (. root frame-version) 1)
  )
  (fn-do + graphic-invalidate _
    (param kinds U8)
    (call vector-content-changed kinds)
  )
  (fn-do _ vector-content-changed _
    (param kinds U8)
    (let root (call vector-root))
    (let group (? VectorGroup) this)
    (while group
      (= (. group vector-geometry-full-dirty) true)
      (= (. group vector-geometry-support-checked) false)
      (= (. group vector-geometry-item-indices) null)
      (call (. group vector-geometry-dirty-chunks clear))
      (call (. root queue-vector-invalidation) group kinds)
      (= group (. group vector-parent-node))
    )
    (if (not (. root update-depth))
      (call (. root flush-graphic-changes) true)
    )
  )
  (fn-do _ queue-vector-invalidation _
    (param group VectorGroup)
    (param kinds U8)
    (if (not (. group pending-vector-kinds))
      (+= pending-groups group)
    )
    (= (. group pending-vector-kinds) (/or/ (. group pending-vector-kinds) kinds))
  )
  (fn-do _ invalidate-vector-cache _
    (param kinds U8)
    (= computed-paths null)
    (= computed-stamp null)
    (+= output-version 1)
    (if host
      (call (. host vector-host-changed) kinds)
    )
  )
  (fn-do _ flush-graphic-changes _
    (param publish Bool)
    (let kinds U8)
    (for (in node pending-nodes)
      (= kinds (/or/ kinds (call (. node apply-pending-change))))
    )
    (call (. pending-nodes clear))
    (for (in group pending-groups)
      (let group-kinds (. group pending-vector-kinds))
      (= (. group pending-vector-kinds) 0)
      (call (. group invalidate-vector-cache) group-kinds)
      (= kinds (/or/ kinds group-kinds))
    )
    (call (. pending-groups clear))
    (= pending-published-kinds (/or/ pending-published-kinds kinds))
    (if (and publish (not update-depth))
      (call publish-graphic-changes)
    )
  )
  (fn-do _ publish-graphic-changes _
    (let kinds pending-published-kinds)
    (= pending-published-kinds 0)
    (return-if (if (not kinds)))
    (if invalidation-listener
      (call invalidation-listener kinds)
    )
  )
  (fn-do _ vector-root VectorGroup
    (let result this)
    (while (. result vector-parent-node)
      (= result (. result vector-parent-node))
    )
    (return result)
  )
  (fn-do _ vector-item-index Size
    (param node VectorNode)
    (for (in i (..< 0 (. vector-items length)))
      (return-if i (if (== (as ([] vector-items i) Pointer) (as node Pointer))))
    )
    (return (. vector-items length))
  )
  (fn-expr _ vector-item-source VectorGeometrySource
    (param index Index)
    (if-expr (is item VectorGroup) (call (. (as item VectorGroup) geometry-source)) item)
    (where
      (lazy item ([] vector-items index))
    )
  )
  (fn-do _ geometry-source VectorGeometrySource
    (let owner host)
    (return-if this (if (not owner)))
    (let existing hosted-source)
    (return-if existing (if existing))
    (let source (call VectorHostedSource this owner this))
    (= hosted-source source)
    (return source)
  )
  (fn-expr _ hosted-appearance VectorAppearance
    (param inherited VectorAppearance)
    (if-expr (not owner) inherited (call vector-host-appearance-over owner inherited))
    (where
      (lazy owner host)
    )
  )
  (fn-expr _ vector-evaluation-bounds Rect
    (param inherited Rect)
    (?? (?. host vector-host-viewport) inherited)
  )
  (fn-expr _ vector-viewport-transform (? Matrix)
    (if-expr (or (not vector-parent-node) (not owner)) null (. owner vector-host-transform))
    (where
      (lazy owner host)
    )
  )
  (fn-expr _ vector-transform-to-parent (? Matrix)
    (case? viewport
      (if-expr style (call (. viewport concatenate) style) viewport)
    )
    (default
      style
    )
    (where
      (lazy viewport (call vector-viewport-transform))
      (lazy style $transform)
    )
  )
  (fn-do _ paint-vector-in-parent _
    (param canvas Canvas)
    (param inherited VectorAppearance)
    (param area Rect)
    (param outer-effects (? VectorEffects))
    (let bounds (call vector-evaluation-bounds area))
    (let transform (call vector-viewport-transform))
    (if (not transform)
      (call paint-vector canvas inherited true outer-effects bounds)
      (return)
    )
    (do-use (. canvas saved-state)
      (call (. canvas transform) transform)
      (call paint-vector canvas inherited true outer-effects bounds)
    )
  )
  (fn-expr _ last-evaluation-bounds Rect
    (if-expr computed-stamp (. computed-stamp bounds) (call Rect))
  )
  (fn-do _ release-node _
    (param child MarkupElement)
    (if (. child markup-batch-root)
      (call markup-release child)
    )
  )
  (fn-do _ attach-item _
    (param child VectorNode)
    (param anchor (? VectorNode))
    (let index (if-expr anchor (call vector-item-index anchor) (. vector-items length)))
    (match? child
      (case (: graphic GraphicNode)
        (= (. graphic parent) this)
      )
      (case (: group VectorGroup)
        (= (. group vector-parent-node) this)
      )
    )
    (call (. vector-items insert) child index)
    (call vector-content-changed (/or/ graphic-change-structure graphic-change-geometry))
  )
  (fn-do _ detach-item _
    (param child VectorNode)
    (let index (call vector-item-index child))
    (return-if (if (== index (. vector-items length))))
    (call (. vector-items remove) index)
    (match? child
      (case (: graphic GraphicNode)
        (= (. graphic parent) null)
        (= (. graphic previous) null)
        (= (. graphic next) null)
      )
      (case (: group VectorGroup)
        (= (. group vector-parent-node) null)
      )
    )
    (call vector-content-changed (/or/ graphic-change-structure graphic-change-geometry))
  )
  (fn-do _ resolve-vector-geometry _
    (param viewport Rect)
    (let root markup-batch-root)
    (return-if (if (not root)))
    (let table (call vector-geometry-table-for root))
    (if (!= vector-geometry-table table)
      (call release-vector-geometry)
      (= vector-geometry-table table)
      (= vector-geometry-full-dirty true)
    )
    (if vector-geometry-full-dirty
      (call release-vector-geometry-chunks table)
      (call build-vector-geometry-chunks table viewport)
      (else
        (for (in chunk-index vector-geometry-dirty-chunks)
          (call rebuild-vector-geometry-chunk table viewport chunk-index)
        )
      )
    )
    (call (. vector-geometry-dirty-chunks clear))
    (= vector-geometry-full-dirty false)
    (= vector-geometry-source-revision revision)
  )
  (fn-do _ release-vector-geometry _
    (return-if (if (not vector-geometry-table)))
    (call release-vector-geometry-chunks vector-geometry-table)
    (= vector-geometry-table null)
    (= vector-geometry-item-indices null)
    (call (. vector-geometry-dirty-chunks clear))
    (= vector-geometry-full-dirty true)
    (= vector-geometry-source-revision 0)
  )
  (fn-do _ release-vector-geometry-chunks _
    (param table VectorGeometryTable)
    (for (in chunk vector-geometry-chunks)
      (call (. table release) (. chunk handle))
    )
    (call (. vector-geometry-chunks clear))
  )
  (fn-do _ build-vector-geometry-chunks _
    (param table VectorGeometryTable)
    (param viewport Rect)
    (let item-count (. vector-items length))
    (if (> item-count vector-geometry-chunk-capacity)
      (let indices (call (of Map Pointer Size)))
      (for (in index (..< 0 item-count))
        (= ([] indices (as ([] vector-items index) Pointer)) index)
      )
      (= vector-geometry-item-indices indices)
      (else
        (= vector-geometry-item-indices null)
      )
    )
    (let start Size)
    (while (< start item-count)
      (let end (+ start vector-geometry-chunk-capacity))
      (if (> end item-count)
        (= end item-count)
      )
      (let source (call chunk-source (call VectorGroupSlice this start end)))
      (let acquisition (call (. table intern) source viewport))
      (+= vector-geometry-chunks (call VectorGeometryChunk source (. acquisition handle) (. acquisition palette)))
      (= start end)
    )
  )
  (fn-expr _ chunk-source VectorGeometrySource
    (param slice VectorGroupSlice)
    (if-expr (not owner) slice (call VectorHostedSource this owner slice))
    (where
      (lazy owner host)
    )
  )
  (fn-do _ rebuild-vector-geometry-chunk _
    (param table VectorGeometryTable)
    (param viewport Rect)
    (param index Size)
    (return-if (if (>= index (. vector-geometry-chunks length))))
    (let chunk ([] vector-geometry-chunks index))
    (call (. table release) (. chunk handle))
    (let acquisition (call (. table intern) (. chunk source) viewport))
    (= (. chunk handle) (. acquisition handle))
    (= (. chunk palette) (. acquisition palette))
  )
  (fn-do _ queue-vector-geometry-node _
    (param node GraphicNode)
    (return-if (if vector-geometry-full-dirty))
    (let indices vector-geometry-item-indices)
    (if (not indices)
      (= vector-geometry-full-dirty true)
      (return)
    )
    (let item-index ([] indices (as node Pointer)))
    (if (not item-index)
      (= vector-geometry-full-dirty true)
      (call (. vector-geometry-dirty-chunks clear))
      (return)
    )
    (let chunk-index (/ item-index vector-geometry-chunk-capacity))
    (for (in existing vector-geometry-dirty-chunks)
      (return-if (if (== existing chunk-index)))
    )
    (+= vector-geometry-dirty-chunks chunk-index)
  )
  (fn-do _ release-and-reject-vector-geometry Bool
    (call release-vector-geometry)
    (return false)
  )
  (fn-do _ can-paint-vector-geometry Bool
    (param viewport Rect)
    (return-if (call release-and-reject-vector-geometry) (if (or (. $effects length) paints-generated-result)))
    (if (not vector-geometry-support-checked)
      (= vector-geometry-supported (call vector-geometry-supports-source (call geometry-source)))
      (= vector-geometry-support-checked true)
    )
    (return-if (call release-and-reject-vector-geometry) (if (not vector-geometry-supported)))
    (if (!= vector-geometry-source-revision revision)
      (call resolve-vector-geometry viewport)
    )
    (return (!= vector-geometry-table null))
  )
  (fn-do _ ensure-vector-style-root _
    (let owner host)
    (if (and owner (not (. owner markup-batch-root)))
      (call markup-adopt owner null owner)
    )
    (if (not markup-batch-root)
      (call markup-adopt this null this)
    )
    (let root markup-batch-root)
    (if root
      (call (. root markup-batch-queue checkpoint))
    )
  )
)

(fn-expr _ vector-host-appearance-over VectorAppearance
  (param host VectorGroupHost)
  (param inherited VectorAppearance)
  (call (. inherited over)
    (block
      (arg (. host $fill))
      (arg (. host $stroke))
      (arg (. host $stroke-width))
      (arg (. host $stroke-alignment))
      (arg (. host $stroke-cap))
      (arg (. host $stroke-join))
      (arg (. host $fill-rule))
    )
  )
)
