(import ./curve)
(import ./intersection)
(import ./network)
(import ./path)
(import ./point)
(import ./primitives)
(import /math)

(type + PathLocation (is Tuple)
  (prop + parameter PointOnCurve)
  (prop + point Point)
  (prop + distance Length)
)

(type + PathCrossing (is Tuple)
  (prop + point Point)
  (prop + along Length)
  (prop + across Length)
)

(fn-do + path-nearest _
  (param path Path)
  (param point Point)
  (param limit (? Length) (= null))
  (let best (? PathLocation) null)
  (let index Index 0)
  (for (in curve (. path curves))
    (let hit (call network-curve-pick curve point index limit))
    (let reaches (or (== limit null) (<= (. hit distance) limit)))
    (if (and reaches (or (== best null) (< (. hit distance) (. best distance))))
      (= best
        (call PathLocation
          (block
            (arg (+ (as index Float) (call path-curve-parameter curve hit)))
            (arg (. hit position))
            (arg (. hit distance))
          )
        )
      )
    )
    (+= index 1)
  )
  (return best)
)

(fn-expr _ path-curve-parameter _
  (param curve Curve)
  (param hit NetworkHit)
  (case? (!= (. curve type) .segment-type-line)
    (. hit parameter)
  )
  (case? (<= squared 0)
    0.0
  )
  (default
    (call max 0.0 (call min 1.0 (/ (call (. (- (. hit position) (. curve anchor1)) dot) delta) squared)))
  )
  (where
    (lazy delta (- (. curve anchor2) (. curve anchor1)))
    (lazy squared (call (. delta dot) delta))
  )
)

(fn-do + path-crossings _
  (param a Path)
  (param b Path)
  (param merge Length (= 0.0001))
  (let found (list PathCrossing))
  (for (in pair (call intersect-paths a b))
    (for (in crossing (. pair intersections))
      (let source (. crossing path1))
      (if source
        (let point (call (. source get-point-at) (. crossing t1)))
        (let fresh true)
        (for (in other found)
          (if (<= (call (. other point distance) point) merge)
            (= fresh false)
          )
        )
        (let first (only-if (call path-nearest a point) (if fresh)))
        (let second (only-if (call path-nearest b point) (if fresh)))
        (if (and (!= first null) (!= second null))
          (+= found
            (call PathCrossing
              (block
                (arg point)
                (arg (call (. a get-length-at-parameter) (. first parameter)))
                (arg (call (. b get-length-at-parameter) (. second parameter)))
              )
            )
          )
        )
      )
    )
  )
  (let ordered (list PathCrossing))
  (let taken (list Bool))
  (for (in each found)
    (+= taken false)
  )
  (for (in round (..< 0 (. found length)))
    (let next (? Index) null)
    (for (in index (..< 0 (. found length)))
      (if (and (not ([] taken index)) (or (== next null) (call path-crossing-before ([] found index) ([] found next))))
        (= next index)
      )
    )
    (= ([] taken (!! next)) true)
    (+= ordered ([] found (!! next)))
  )
  (return ordered)
)

(fn-expr _ path-crossing-before _
  (param first PathCrossing)
  (param second PathCrossing)
  (or (< (. first along) (. second along)) (and (== (. first along) (. second along)) (< (. first across) (. second across))))
)
