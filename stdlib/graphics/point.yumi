
./primitives
./utils
/core/animatable
/math

. degrees = 180 / π
. radians = π / 180

━━━━━━━━━━━━━━━━━━━━
+ Point is Tuple
    is Animatable

+ x Coord
+ y Coord

────────────────────
+ This
    - vector [F64]

= This(vector[0], vector[1])

────────────────────
+ get angle

normalize-angle(atan2(-y, -x))

────────────────────
+ do get length

//graphics.point.lengths ++
= sqrt(x * x + y * y)

────────────────────
+ get negated

Point(-x, -y)

────────────────────
+ get point

angle, length

.. angle = Point(0, 0).angle(Point(-x, -y))
.. length = Point(0, 0).distance(Point(-x, -y))

────────────────────
+ get is-zero

x == 0 && y == 0

────────────────────
+ this == other Point

x == other.x && y == other.y

────────────────────
+ this + other Dimensions @inline

Point
    - x + other.width
    - y + other.height

────────────────────
+ this + n Length @inline

this + Point(n, n)

────────────────────
+ do this + other Point @inline

//graphics.point.ops ++
= Point
    - x + other.x
    - y + other.y

────────────────────
+ do this - other Point @inline

//graphics.point.ops ++
= Point
    - x - other.x
    - y - other.y

────────────────────
+ this > other Point

x > other.x && y > other.y

────────────────────
+ do this * q Float @inline

//graphics.point.ops ++
= Point
    - x * q
    - y * q

────────────────────
+ do this / q Float @inline

//graphics.point.ops ++
= Point
    - x / q
    - y / q

────────────────────
+ this / q Dimensions @inline

Point
    - x / q.width
    - y / q.height

────────────────────
+ -this @inline

Point
    - -x
    - -y

────────────────────
+ nearly-equals
    - other Point

nearly-equals(x, other.x) && nearly-equals(y, other.y)

────────────────────
+ slope
    - other Point

|? dx == 0
    0
?? slope

.. dy = other.y - y
.. dx = other.x - x
.. slope = dy / dx

────────────────────
+ slope-round
    - other Point

|? dx == 0
    0
?? slope

.. dy = vecround(other.y - y)
.. dx = vecround(other.x - x)
.. slope = dy / dx

────────────────────
+ distance
    - other Point

//graphics.point.distances ++
sqrt(dx * dx + dy * dy)

.. dx = other.x - x
.. dy = other.y - y

────────────────────
+ midpoint
    - other Point

Point
    - x + (other.x - x) / 2
    - y + (other.y - y) / 2

────────────────────
+ angle
    - other Point

//graphics.point.angles ++
normalize-angle(atan2(dy, dx))

.. dx = x - other.x
.. dy = y - other.y

────────────────────
+ direction
    - other Point

atan2(-dy, -dx) - π

.. dx = x - other.x
.. dy = y - other.y

────────────────────
+ normal Point
    - other Point
    - distance Length

|? distance
    (x + xa * distance, y + ya * distance)
?? (xa, ya)

.. dx = other.x - x
.. dy = other.y - y
.. angle = atan2(dx, dy)
.. xa = cos(-angle)
.. ya = sin(-angle)

────────────────────
+ do unit-normal Point
    - other Point

//graphics.point.normals ++
. dx = other.x - x
. dy = other.y - y
if dx == 0 && dy == 0
    = 0, 0
else
    . f = 1 / sqrt(dx * dx + dy * dy)
    dx *= f
    dy *= f
    = dy, -dx

────────────────────
+ do tangent Point
    - other Point
    - distance Length

|? distance
    (x + xa * distance, y + ya * distance)
?? (xa, ya)

. dx = other.x - x
. dy = other.y - y
. angle = atan2(dx, dy)
. xa = sin(angle)
. ya = cos(angle)

────────────────────
+ min
    - other Point

Point
    - min(x, other.x)
    - min(y, other.y)

────────────────────
+ max
    - other Point

Point
    - max(x, other.x)
    - max(y, other.y)

────────────────────
+ contained
    - rect Rect

x >= rect.x && y >= rect.y && x <= rect.x + rect.width && y <= rect.y + rect.height

────────────────────
+ rotate
    - angle Radians
    - center = Point(0, 0)

//graphics.point.rotations ++
Point
    - (x1 * c - y1 * s) + center.x
    - (y1 * c + x1 * s) + center.y

.. x1 = x - center.x
.. y1 = y - center.y
.. s = sin(angle)
.. c = cos(angle)

────────────────────
+ scale
    - scale-x Float
    - scale-y Float = scale-x

Point
    - x * scale-x
    - y * scale-y

────────────────────
+ translate-towards
    - amount Length
    - center = Point(0, 0)

translate-at-angle(ang, amount)
` Point
`     - x - (dx * amount)
`     - y - (dy * amount)

.. ang = this.angle(center)
` .. dx = x - center.x
` .. dy = y - center.y

────────────────────
+ translate-at-angle
    - angle Radians
    - length Length

Point
    - x + (cos(angle) * length)
    - y + (sin(angle) * length)

────────────────────
+ mirror-x
    - cx Coord

Point
    - if x < cx then cx - (x - cx) else cx + (cx - x)
    - y

────────────────────
+ mirror-y
    - cy Coord

Point
    - x
    - if y < cy then cy - (y - cy) else cy + (cy - y)

────────────────────
+ mirror
    - center Point

Point
    - if x < center.x then center.x - (x - center.x) else center.x + (center.x - x)
    - if y < center.y then center.y - (y - center.y) else center.y + (center.y - y)

────────────────────
+ dot @inline
    - other Point

x * other.x + y * other.y

────────────────────
+ cross @inline
    - other Point

x * other.y - y * other.x

────────────────────
+ project
    - other Point

|? other.is-zero
    other
??
    Point(other.x * scale, other.y * scale)
        .. scale = dot(other) / other.dot(other)

────────────────────
+ get motion-vector [F64]

[x as F64, y as F64]

━━━━━━━━━━━━━━━━━━━━
+ do intersect-lines Point?
    - start1 Point
    - end1 Point
    - start2 Point
    - end2 Point
    - as-infinity = false

. den = (end2.y - start2.y) * (end1.x - start1.x) - (end2.x - start2.x) * (end1.y - start1.y)
=? if den == 0

. start-dx = start1.x - start2.x
. start-dy = start1.y - start2.y
. ua = ((end2.x - start2.x) * start-dy - (end2.y - start2.y) * start-dx) / den
. ub = ((end1.x - start1.x) * start-dy - (end1.y - start1.y) * start-dx) / den
if !as-infinity
    =? if ua < 0
    =? if ub < 0
    =? if ua > 1
    =? if ub > 1

= Point
    - start1.x + ua * (end1.x - start1.x)
    - start1.y + ua * (end1.y - start1.y)

━━━━━━━━━━━━━━━━━━━━
+ vector
    - length Length
    - angle Radians

Point
    - cos(angle) * length
    - sin(angle) * length

━━━━━━━━━━━━━━━━━━━━
+ vecround

round(x / 0.001) * 0.001

━━━━━━━━━━━━━━━━━━━━
+ is-concave
    - angle-in Float
    - angle-out Float

|? abs(angle-in - angle-out) > π
    normalized-in > normalized-out
??
    angle-in > angle-out

.. normalized-in = normalize-angle(angle-in + π)
.. normalized-out = normalize-angle(angle-out + π)
