(import ./console)
(import ./trace)
(import /data/json)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)
(import /os/signal)
(import /stream/sort)
(import /time/clock)
(import /time/duration)
(blank)
(prop _ grace-period _ (= 2s))
(prop _ follow-interval _ (= 40ms))
(prop _ timed-out-status _ (= 124))
(prop _ kept-traces Size (= 20))
(prop _ probe-variables (list String) (= (list "PROBES_ENABLED" "PROBES_PATH" "PROBES_CONTROL_PATH")))

(type + ProbeRun
  (prop + program String)
  (prop + arguments (list String))
  (prop + trace-path (? String))
  (prop + catalog-path (? String))
  (prop + timeout (? Seconds))
  (prop + shows-lines _ (= true))
  (prop + line-limit Size (= 400))
  (prop + unmatched (list String))
  (prop + status Int)
  (prop + timed-out _ (= false))
  (prop + is-finished _ (= false))
  (prop + trace-error (? String))
  (blank)
  (prop _ child (? Process))
  (prop _ timer (? Task))
  (prop _ is-running _ (= false))
  (fn-do + This _
    (param program String)
    (param arguments (list String))
  )
  (subscribe-for (on sig sig-term (whenever #is-running))
    (call (?. child terminate))
  )
  (subscribe-for (on sig sig-int (whenever #is-running))
    (call (. grace-period wait))
    (if is-running
      (call (?. child terminate))
    )
  )
  (fn-do + run Int (?! Error)
    (let variables (call environment))
    (for (in name probe-variables)
      (-= ([] variables name))
    )
    (if trace-path
      (let trace (call Path trace-path))
      (if (. trace exists)
        (call (. trace delete))
      )
      (= ([] variables "PROBES_ENABLED") "1")
      (= ([] variables "PROBES_PATH") (!! trace-path))
      (if (and catalog-path (. (call Path catalog-path) is-file))
        (call write-file-atomically
          (block
            (arg (call Path (call trace-sidecar (!! trace-path) "probes.json")))
            (arg (call read-file-text (call Path (!! catalog-path))))
          )
        )
      )
    )
    (let started (call clock))
    (let spawned
      (call Process
        (block
          (arg program)
          (arg (. ProcessStderr inherit))
          (arg arguments)
          (:variables variables)
          (:stdio-mode (. ProcessStdio inherit))
        )
      )
    )
    (= child spawned)
    (= is-running true)
    (do-new
      (inline (call wait-for-exit this spawned))
    )
    (if timeout
      (= timer
        (do-new
          (inline (call watch-timeout (!! timeout)))
        )
      )
    )
    (let console (call ProbeConsole shows-lines line-limit))
    (if trace-path
      (call follow-trace trace-path console)
      (else
        (while (not is-finished)
          (call (. follow-interval wait))
        )
      )
    )
    (let elapsed (call nanoseconds-since started))
    (call (. spawned close))
    (if trace-path
      (call report console elapsed)
      (let kept (call Path (call trace-sidecar (!! trace-path) "probes.json")))
      (if (and (not (. (call Path (!! trace-path)) is-file)) (. kept is-file))
        (catch (call (. kept delete)))
      )
    )
    (return-if timed-out-status (if timed-out))
    (return status)
  )
  (fn-do _ follow-trace _
    (param path String)
    (param console ProbeConsole)
    (let reader (call TraceReader path true))
    (while (not is-finished)
      (if (not (call read-into reader console))
        (return)
      )
      (if (not (. reader advanced))
        (call (. follow-interval wait))
      )
    )
    (while true
      (if (or (not (call read-into reader console)) (not (. reader advanced)))
        (break)
      )
    )
    (if (not (. (call Path path) is-file))
      (= trace-error
        (paragraph
          "the program wrote no trace; it has no probes compiled in (check the --probes selectors)"
        )
      )
      (else-if (and (not (. reader is-done)) (not trace-error))
        (= trace-error "the program did not close its trace")
      )
    )
  )
  (fn-do _ read-into Bool
    (param reader TraceReader)
    (param console ProbeConsole)
    (let items
      (call (. reader read-available)
        (block
          (on-error (: error Error)
            (= trace-error (?? (. error message) "the trace could not be read"))
            (return false)
          )
        )
      )
    )
    (for (in item items)
      (call (. console observe) item)
    )
    (return true)
  )
  (fn-do _ report _
    (param console ProbeConsole)
    (param elapsed U64)
    (let outcome
      (scope (if-expr timed-out (str "timed out after " limit-text) (str "exit " status))
        (lazy limit-text (call duration-text (call seconds-nanoseconds (!! timeout))))
      )
    )
    (<- stderr (str "── probes ── " outcome " · " (call duration-text elapsed) " · " (call count-text (. console records)) " records\n"))
    (for (in line (call (. console footer-lines)))
      (<- stderr (str line "\n"))
    )
    (for (in selector unmatched)
      (<- stderr (str "warning: --probes selector " selector " matched no probe sites\n"))
    )
    (if trace-error
      (<- stderr (str "warning: " trace-error "\n"))
    )
    (return-if (if (not (. (call Path (!! trace-path)) is-file))))
    (blank)
    (<- stderr (str "trace: " (!! trace-path) "\n"))
    (<- stderr "query: brix probes summary · log · agg --field F · durations · tree · timeline · outliers (brix probes --help)\n")
  )
  (fn-do _ watch-timeout _
    (param limit Seconds)
    (call (. limit wait))
    (return-if (if is-finished))
    (blank)
    (= timed-out true)
    (call (?. child terminate))
    (call (. grace-period wait))
    (return-if (if is-finished))
    (blank)
    (call (?. child kill))
  )
  (fn-do + finish _
    (param code Int)
    (= status code)
    (= is-finished true)
    (= is-running false)
    (call (?. timer cancel))
  )
)

(fn-do _ wait-for-exit _
  (param run ProbeRun)
  (param child Process)
  (call (. run finish) (?? (call (. child wait) null) 1))
)

(fn-expr _ nanoseconds-since U64
  (param started ClockTime)
  (as (call (of (. started elapsed) Nanoseconds)) U64)
)

(fn-expr _ seconds-nanoseconds U64
  (param value Seconds)
  (as (as value Nanoseconds) U64)
)

(fn-do + parse-timeout (? Seconds)
  (param text String)
  (let scale 1.0)
  (let number text)
  (if (call (. text ends-with) "ms")
    (= scale 0.001)
    (= number ([] text (..< 0 (- (. text length) 2))))
    (else-if (call (. text ends-with) "s")
      (= number ([] text (..< 0 (- (. text length) 1))))
    )
    (else-if (call (. text ends-with) "m")
      (= scale 60.0)
      (= number ([] text (..< 0 (- (. text length) 1))))
    )
  )
  (return-if null (if (== (. number length) 0)))
  (blank)
  (let dots 0)
  (for (in char number)
    (if (== char '.')
      (+= dots 1)
      (else-if (or (< char '0') (> char '9'))
        (return null)
      )
    )
  )
  (return-if null (if (or (> dots 1) (== number "."))))
  (return (as (* (as number F64) scale) Seconds))
)

(fn-do + new-trace-path Path (?! Error)
  (param directory Path)
  (param name String)
  (call (. directory make-directories))
  (call prune-traces directory)
  (let now (call clock))
  (return (/ directory (str name "-" (. now s) (call (. (as (/ (. now ns) 1000000) Int) pad) 3) ".trace")))
)

(fn-do _ prune-traces _
  (param directory Path)
  (let traces (list String))
  (for (in entry (. directory entries))
    (if (call (. entry name ends-with) ".trace")
      (+= traces (. entry name))
    )
  )
  (return-if (if (< (. traces length) kept-traces)))
  (blank)
  (let ordered
    (block
      (call sort traces (:using (=> (a b) (if-expr (< (call trace-stamp a) (call trace-stamp b)) .lesser .greater))))
    )
  )
  (for (in index (..< 0 (+ (- (. ordered length) kept-traces) 1)))
    (let trace (as (/ directory ([] ordered index)) String))
    (for (in path (list trace (call trace-sidecar trace "probes.json") (call trace-sidecar trace "run.json")))
      (if (. (call Path path) exists)
        (catch (call (. (call Path path) delete)))
      )
    )
  )
)

(fn-expr _ trace-stamp String
  (param name String)
  (str (if-expr (< (. stamp length) 20) (* "0" (- 20 (. stamp length))) "") stamp)
  (where
    (lazy stem (if-expr (call (. name ends-with) ".trace") ([] name (..< 0 (- (. name length) 6))) name))
    (lazy dash (call (. stem find-reverse) "-"))
    (lazy stamp (if-expr dash ([] stem (... (+ dash 1))) stem))
  )
)

(fn-expr + trace-sidecar String
  (param trace String)
  (param suffix String)
  (str stem "." suffix)
  (where
    (lazy stem (if-expr (call (. trace ends-with) ".trace") ([] trace (..< 0 (- (. trace length) 6))) trace))
  )
)

(fn-do _ absolute String
  (param path String)
  (return-if path (if (or (== path "") (call (. path starts-with) "/"))))
  (blank)
  (let resolved
    (scope (. (call Path path) resolved)
      (on-error (: error Error)
        (return path)
      )
    )
  )
  (return (as resolved String))
)

(fn-do + write-last-run _ (?! Error)
  (param directory Path)
  (param run ProbeRun)
  (param code Int)
  (let trace (call absolute (?? (. run trace-path) "")))
  (return-if (if (or (== trace "") (not (. (call Path trace) is-file)))))
  (blank)
  (let kept (call trace-sidecar trace "probes.json"))
  (let record
    (call (of Map String JSON)
      (block
        (entry "program" (as (call absolute (. run program)) JSON))
      )
    )
  )
  (let arguments (list JSON))
  (for (in argument (. run arguments))
    (+= arguments argument)
  )
  (= ([] record "arguments") arguments)
  (= ([] record "trace") trace)
  (= ([] record "catalog") (if-expr (. (call Path kept) is-file) kept (call absolute (?? (. run catalog-path) ""))))
  (= ([] record "status") (as code Int))
  (= ([] record "timed-out") (. run timed-out))
  (let text (str (call to-json (as record JSON)) "\n"))
  (call write-file-atomically (call Path (call trace-sidecar trace "run.json")) text)
  (call write-file-atomically (/ directory "last.json") text)
)
