/os/file
/time/duration

_ poll-interval = 40ms
_ batch-size Size = 4096
_ file-magic U32 = 0x32504d59
_ segment-magic U32 = 0x32475350
_ transport-version U32 = 2
_ minimum-header-size U64 = 88
_ segment-header-size U64 = 64
_ record-header-size U64 = 64

━━━━━━━━━━━━━━━━━━━━
_ RecordState is U32

| empty
| writing
| committed

━━━━━━━━━━━━━━━━━━━━
+ TraceError is Error

────────────────────
+ to String

message ?? "Invalid probe trace"

━━━━━━━━━━━━━━━━━━━━
+ TraceRecordType is U8

| done = 0
| declare-log = 1
| declare-event = 2
| declare-property = 3
| declare-type = 4
| system-log = 5
| log = 6
| event = 7
| snapshot = 8
| declare-log2 = 9
| declare-key = 10
| declare-counter = 11
| counter = 12
| declare-profile-metric = 13
| profile-metric = 14

━━━━━━━━━━━━━━━━━━━━
+ TraceSlotType is U8

| none = 0
| bool = 1
| char = 2
| int8 = 3
| uint8 = 4
| int16 = 5
| uint16 = 6
| int32 = 7
| uint32 = 8
| int64 = 9
| uint64 = 10
| float32 = 11
| float64 = 12
| string = 13
| array = 14
| object = 15
| group = 16

━━━━━━━━━━━━━━━━━━━━
+ TraceSiteKind is U8

| log = 1
| event = 2
| counter = 3

━━━━━━━━━━━━━━━━━━━━
+ TraceMetricKind is U8

| counter = 1
| timer = 2

━━━━━━━━━━━━━━━━━━━━
+ TraceSlot is (type TraceSlotType, class-type U16)

━━━━━━━━━━━━━━━━━━━━
+ TraceSite is Tuple

+ id U16
+ kind TraceSiteKind
+ key String
+ name String?
+ template String
+ module-name String
+ source-path String
+ line U32
+ slots [TraceSlot]

━━━━━━━━━━━━━━━━━━━━
+ TraceMetricSite is Tuple

+ id U16
+ kind TraceMetricKind
+ key String
+ module-name String
+ source-path String
+ line U32
+ object-type-id U16

━━━━━━━━━━━━━━━━━━━━
+ TraceTime is (seconds U64, nanoseconds U64)

━━━━━━━━━━━━━━━━━━━━
