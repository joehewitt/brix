━━━━━━━━━━━━━━━━━━━━
+ TraceArray is Tuple

+ object-id U32
+ type-id U16
+ length U32
+ item-type U16
+ data Byte[]

━━━━━━━━━━━━━━━━━━━━
+ TraceValue is Union

| truth Bool
| character Char
| integer I64
| unsigned U64
| real F64
| text String
| object TraceObject
| array TraceArray

━━━━━━━━━━━━━━━━━━━━
+ TraceRecord is Tuple

+ site TraceSite
+ object-id U32
+ object-type-id U16
+ values [TraceValue]
+ time TraceTime
+ sequence U64?

━━━━━━━━━━━━━━━━━━━━
+ TraceCounter is Tuple

+ site TraceSite
+ object-id U32
+ object-type-id U16
+ value U64
+ time TraceTime
+ sequence U64?

━━━━━━━━━━━━━━━━━━━━
+ TraceMetric is Tuple

+ site TraceMetricSite
+ value U64
+ total-ns U64
+ active-count U64
+ active-elapsed-ns U64
+ time TraceTime
+ sequence U64?

━━━━━━━━━━━━━━━━━━━━
+ TraceSnapshot is (object-id U32, object-type-id U16, time TraceTime, sequence U64?)

━━━━━━━━━━━━━━━━━━━━
+ TraceSystemLog is (text String, time TraceTime, sequence U64?)

━━━━━━━━━━━━━━━━━━━━
