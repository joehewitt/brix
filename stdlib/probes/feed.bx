(import /probes/model)
(import /probes/trace)
(import /time/duration)
(blank)
(prop _ probe-follow-interval _ (= 40ms))

(type + ProbeFeed
  (prop + trace ProbeTrace)
  (prop + revision U64)
  (prop + seen U64)
  (prop + is-recording _ (= true))
  (prop + status (? Int))
  (prop + problem (? String))
  (fn-do + This _
    (param source TraceSource)
    (lazy trace (call ProbeTrace source))
  )
  (fn-do + follow _
    (let listed (catch (call (. trace read-catalog))))
    (if (is listed Error)
      (= problem (. (as listed Error) message))
    )
    (let reader (use (call TraceReader (. trace source trace) true)))
    (while is-recording
      (if (not (call read reader))
        (return)
      )
      (if (not (. reader advanced))
        (call (. probe-follow-interval wait))
      )
    )
    (while (and (call read reader) (. reader advanced))
      (continue)
    )
    (= (. trace is-closed) (. reader is-done))
  )
  (fn-do + finish _
    (param code (? Int))
    (= status code)
    (= is-recording false)
  )
  (fn-do _ read Bool
    (param reader TraceReader)
    (let items
      (call (. reader read-available)
        (block
          (on-error (: error Error)
            (= problem (?? (. error message) "The trace could not be read"))
            (return false)
          )
        )
      )
    )
    (if (> (. items length) 0)
      (for (in item items)
        (call (. trace observe) item)
      )
      (+= revision 1)
    )
    (return true)
  )
)
