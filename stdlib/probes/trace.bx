(import /os/file)
(import /time/duration)
(blank)
(prop _ poll-interval _ (= 40ms))
(prop _ batch-size Size (= 4096))
(prop _ file-magic U32 (= 0x32504d59))
(prop _ segment-magic U32 (= 0x32475350))
(prop _ transport-version U32 (= 2))
(prop _ minimum-header-size U64 (= 88))
(prop _ segment-header-size U64 (= 64))
(prop _ record-header-size U64 (= 64))

(type _ RecordState (is U32)
  (variant empty)
  (variant writing)
  (variant committed)
)

(type + TraceError (is Error)
  (fn-to-expr + String
    (?? message "Invalid probe trace")
  )
)

(type + TraceRecordType (is U8)
  (variant done (= 0))
  (variant declare-log (= 1))
  (variant declare-event (= 2))
  (variant declare-property (= 3))
  (variant declare-type (= 4))
  (variant system-log (= 5))
  (variant log (= 6))
  (variant event (= 7))
  (variant snapshot (= 8))
  (variant declare-log2 (= 9))
  (variant declare-key (= 10))
  (variant declare-counter (= 11))
  (variant counter (= 12))
  (variant declare-profile-metric (= 13))
  (variant profile-metric (= 14))
)

(type + TraceSlotType (is U8)
  (variant none (= 0))
  (variant bool (= 1))
  (variant char (= 2))
  (variant int8 (= 3))
  (variant uint8 (= 4))
  (variant int16 (= 5))
  (variant uint16 (= 6))
  (variant int32 (= 7))
  (variant uint32 (= 8))
  (variant int64 (= 9))
  (variant uint64 (= 10))
  (variant float32 (= 11))
  (variant float64 (= 12))
  (variant string (= 13))
  (variant array (= 14))
  (variant object (= 15))
  (variant group (= 16))
)

(type + TraceSiteKind (is U8)
  (variant log (= 1))
  (variant event (= 2))
  (variant counter (= 3))
)

(type + TraceMetricKind (is U8)
  (variant counter (= 1))
  (variant timer (= 2))
)

(type + TraceSlot (is (tuple (: type TraceSlotType) (: class-type U16))))

(type + TraceSite (is Tuple)
  (prop + id U16)
  (prop + kind TraceSiteKind)
  (prop + key String)
  (prop + name (? String))
  (prop + template String)
  (prop + module-name String)
  (prop + source-path String)
  (prop + line U32)
  (prop + slots (list TraceSlot))
)

(type + TraceMetricSite (is Tuple)
  (prop + id U16)
  (prop + kind TraceMetricKind)
  (prop + key String)
  (prop + module-name String)
  (prop + source-path String)
  (prop + line U32)
  (prop + object-type-id U16)
)

(type + TraceTime (is (tuple (: seconds U64) (: nanoseconds U64))))

(type + TraceObject (is (tuple (: object-id U32) (: type-id U16))))

(type + TraceArray (is Tuple)
  (prop + object-id U32)
  (prop + type-id U16)
  (prop + length U32)
  (prop + item-type U16)
  (prop + data ([] Byte))
)

(type + TraceValue (is Union)
  (variant truth Bool)
  (variant character Char)
  (variant integer I64)
  (variant unsigned U64)
  (variant real F64)
  (variant text String)
  (variant object TraceObject)
  (variant array TraceArray)
)

(type + TraceRecord (is Tuple)
  (prop + site TraceSite)
  (prop + object-id U32)
  (prop + object-type-id U16)
  (prop + values (list TraceValue))
  (prop + time TraceTime)
  (prop + sequence (? U64))
)

(type + TraceCounter (is Tuple)
  (prop + site TraceSite)
  (prop + object-id U32)
  (prop + object-type-id U16)
  (prop + value U64)
  (prop + time TraceTime)
  (prop + sequence (? U64))
)

(type + TraceMetric (is Tuple)
  (prop + site TraceMetricSite)
  (prop + value U64)
  (prop + total-ns U64)
  (prop + active-count U64)
  (prop + active-elapsed-ns U64)
  (prop + time TraceTime)
  (prop + sequence (? U64))
)

(type + TraceSnapshot (is (tuple (: object-id U32) (: object-type-id U16) (: time TraceTime) (: sequence (? U64)))))

(type + TraceSystemLog (is (tuple (: text String) (: time TraceTime) (: sequence (? U64)))))

(type + TraceTypeName (is (tuple (: id U16) (: name String))))

(type + TraceItem (is Union)
  (variant site TraceSite)
  (variant metric-site TraceMetricSite)
  (variant type-name TraceTypeName)
  (variant key String)
  (variant compiled)
  (variant log TraceRecord)
  (variant event TraceRecord)
  (variant counter TraceCounter)
  (variant metric TraceMetric)
  (variant snapshot TraceSnapshot)
  (variant system-log TraceSystemLog)
)

(type _ TraceHeader (is Tuple)
  (prop + header-size U64)
  (prop + segment-size U64)
  (prop + segment-count U64)
  (prop + record-header-size U64)
  (prop + is-done Bool)
)

(type _ TraceSegment (is (tuple (: header-size U64) (: segment-size U64) (: reserve-cursor U64) (: sealed-cursor U64))))

(type _ TracePending (is Tuple)
  (prop + time TraceTime)
  (prop + payload ([] Byte))
)

(type _ TraceInProgress (is (tuple (: position U64) (: length U64))))

(type _ TraceCursor
  (prop + data ([] Byte))
  (prop + offset Size (= 0))
  (fn-do + This _
    (param data ([] Byte))
  )
  (fn-expr + has-more _ :get
    (< offset (. data size))
  )
  (fn-do + (of read Num) Num (?! TraceError)
    (constraint is Num Number)
    (let value (call (of (. data read) Num) offset .little))
    (throw (call TraceError (str "Probe record ends early at offset " offset)) (if (== value null)))
    (+= offset (. Num size))
    (return value)
  )
  (fn-do + u8 U8 (?! TraceError)
    (return (call (of read U8)))
  )
  (fn-do + u16 U16 (?! TraceError)
    (return (call (of read U16)))
  )
  (fn-do + u32 U32 (?! TraceError)
    (return (call (of read U32)))
  )
  (fn-do + u64 U64 (?! TraceError)
    (return (call (of read U64)))
  )
  (fn-do + bytes ([] Byte) (?! TraceError)
    (param length Size)
    (throw (call TraceError (str "Probe record ends early at offset " offset)) (if (> length (- (. data size) offset))))
    (let slice ([] data (..< offset (+ offset length))))
    (+= offset length)
    (return slice)
  )
  (fn-do + string String (?! TraceError)
    (let length (call u32))
    (throw (call TraceError (str "Probe record ends early at offset " offset)) (if (> length (- (. data size) offset))))
    (let text (call (. data slice-string) (..< offset (+ offset length))))
    (+= offset length)
    (return text)
  )
)

(type + TraceReader
  (implements Closable)
  (prop + path String)
  (prop + follows Bool)
  (prop + is-done _ (= false))
  (prop + advanced _ (= false))
  (prop + sites (map U16 TraceSite))
  (prop + metric-sites (map U16 TraceMetricSite))
  (blank)
  (prop _ file (? File))
  (prop _ segment-index U64)
  (prop _ segment-offset U64 (= segment-header-size))
  (prop _ expected-sequence U64 (= 1))
  (prop _ pending (map U64 TracePending))
  (prop _ in-progress (map U64 TraceInProgress))
  (prop _ has-head _ (= false))
  (prop _ current-sequence (? U64))
  (prop _ current-time _ (= (call TraceTime 0 0)))
  (prop _ items (list TraceItem))
  (fn-do + This _
    (param path String)
    (param follows _ (= false))
  )
  (fn-do + close _
    (let opened file)
    (= file null)
    (call (?. opened close))
  )
  (fn-do + read-available (list TraceItem) (?! Error)
    (= items (call (of List TraceItem)))
    (= advanced false)
    (return-if items (if is-done))
    (if (== file null)
      (= file (call open-file))
      (return-if items (if (== file null)))
    )
    (let header (call read-header))
    (return-if items (if (== header null)))
    (call refresh-in-progress header)
    (call process-pending)
    (let at-end (call scan header))
    (call process-pending)
    (if (and (. header is-done) at-end)
      (throw (call TraceError "Probe trace ended with incomplete committed records") (if (!= (. in-progress length) 0)))
      (throw (call TraceError (str "Probe transport sequence gap: expected " expected-sequence ", got " (call first-pending))) (if (!= (. pending length) 0)))
      (= is-done true)
    )
    (return items)
  )
  (fn-do + read-all (stream TraceItem) (?! Error)
    (while (not is-done)
      (for (in item (call read-available))
        (yield item)
      )
      (if (not advanced)
        (if (not follows)
          (break)
        )
        (call (. poll-interval wait))
      )
    )
  )
  (fn-do _ open-file (? File) (?! Error)
    (let opened
      (call File path
        (block
          (on-error (: error IOError)
            (throw error (if (not follows)))
            (return null)
          )
        )
      )
    )
    (return opened)
  )
  (fn-do _ read-at (? ([] Byte)) (?! Error)
    (param position U64)
    (param length U64)
    (let buffer ([] Byte (as length Size)))
    (let count (call (. (!! file) read) (as length Size) buffer (as position Index)))
    (return-if null (if (< count length)))
    (return buffer)
  )
  (fn-do _ read-header (? TraceHeader) (?! Error)
    (let data (call read-at 0 minimum-header-size))
    (return-if null (if (== data null)))
    (let bytes data)
    (let magic (call (of word U32) bytes 0))
    (let version (call (of word U32) bytes 4))
    (return-if null (if (and (or (== magic 0) (== version 0)) follows)))
    (throw (call TraceError (str "Unsupported probe trace format: magic=" magic " version=" version)) (if (or (!= magic file-magic) (!= version transport-version))))
    (if (== (call (of word U64) bytes 80) 0)
      (return-if null (if follows))
      (throw (call TraceError "Probe trace header is not ready"))
    )
    (let header
      (call TraceHeader
        (block
          (arg (call (of word U64) bytes 8))
          (arg (call (of word U64) bytes 16))
          (arg (call (of word U64) bytes 24))
          (arg (call (of word U64) bytes 40))
          (arg (!= (call (of word U64) bytes 48) 0))
        )
      )
    )
    (throw (call TraceError (str "Invalid probe trace header size: " (. header header-size))) (if (< (. header header-size) minimum-header-size)))
    (throw (call TraceError (str "Invalid probe trace segment size: " (. header segment-size))) (if (< (. header segment-size) (+ segment-header-size record-header-size))))
    (throw (call TraceError (str "Invalid probe trace record header size: " (. header record-header-size))) (if (< (. header record-header-size) record-header-size)))
    (return header)
  )
  (fn-do _ read-segment (? TraceSegment) (?! Error)
    (param header TraceHeader)
    (let data (call read-at (call segment-position header) segment-header-size))
    (return-if null (if (== data null)))
    (let bytes data)
    (let magic (call (of word U32) bytes 0))
    (return-if null (if (== magic 0)))
    (throw (call TraceError (str "Invalid probe segment magic at segment " segment-index ": " magic)) (if (!= magic segment-magic)))
    (let segment
      (call TraceSegment
        (block
          (arg (call (of word U32) bytes 4))
          (arg (call (of word U64) bytes 8))
          (arg (call (of word U64) bytes 16))
          (arg (call (of word U64) bytes 24))
        )
      )
    )
    (let index (call (of word U64) bytes 32))
    (throw (call TraceError (str "Probe segment index mismatch: expected " segment-index ", got " index)) (if (!= index segment-index)))
    (throw (call TraceError (str "Invalid probe segment header size: " (. segment header-size))) (if (or (< (. segment header-size) segment-header-size) (> (. segment header-size) (. segment segment-size)))))
    (throw (call TraceError (str "Probe segment size mismatch: expected " (. header segment-size) ", got " (. segment segment-size))) (if (!= (. segment segment-size) (. header segment-size))))
    (return segment)
  )
  (fn-expr _ segment-position U64
    (param header TraceHeader)
    (+ (. header header-size) (* segment-index (. header segment-size)))
  )
  (fn-expr _ scan-limit U64
    (param segment TraceSegment)
    (param scans-reserved Bool)
    (case? (and scans-reserved (== (. segment sealed-cursor) 0))
      (. segment segment-size)
    )
    (case? (< bounded (. segment header-size))
      (. segment header-size)
    )
    (default
      bounded
    )
    (where
      (lazy cursor (if-expr (!= (. segment sealed-cursor) 0) (. segment sealed-cursor) (. segment reserve-cursor)))
      (lazy bounded (if-expr (< cursor (. segment segment-size)) cursor (. segment segment-size)))
    )
  )
  (fn-do _ scan Bool (?! Error)
    (param header TraceHeader)
    (while true
      (return-if true (if (>= segment-index (. header segment-count))))
      (let found (call read-segment header))
      (if (== found null)
        (throw (call TraceError (str "Probe trace ended before segment " segment-index " was initialized")) (if (. header is-done)))
        (return false)
      )
      (let segment found)
      (if (< segment-offset (. segment header-size))
        (= segment-offset (. segment header-size))
      )
      (if (>= segment-offset (call scan-limit segment (and follows (not (. header is-done)))))
        (if (< (+ segment-index 1) (. header segment-count))
          (+= segment-index 1)
          (= segment-offset segment-header-size)
          (= advanced true)
          (continue)
        )
        (return true)
      )
      (let position (+ (call segment-position header) segment-offset))
      (let envelope (call read-at position (. header record-header-size)))
      (if (== envelope null)
        (throw (call TraceError "Probe trace ended with an incomplete record header") (if (. header is-done)))
        (return false)
      )
      (let state (call (of word U32) envelope 0))
      (let length (call (of word U64) envelope 8))
      (if (not (call is-valid-length header segment envelope length))
        (throw (call TraceError (str "Invalid probe record length " length " at segment " segment-index " offset " segment-offset)) (if (. header is-done)))
        (return false)
      )
      (if (== state (. RecordState committed))
        (let data (call read-at position length))
        (if (== data null)
          (throw (call TraceError "Probe trace ended with an incomplete committed record") (if (. header is-done)))
          (return false)
        )
        (call queue data)
        (call process-pending)
        (+= segment-offset length)
        (= advanced true)
        (return-if false (if (>= (. items length) batch-size)))
        (continue)
      )
      (throw (call TraceError (str "Invalid probe record state " state " at segment " segment-index " offset " segment-offset)) (if (and (!= state (. RecordState writing)) (!= state (. RecordState empty)))))
      (= ([] in-progress position) (call TraceInProgress position length))
      (+= segment-offset length)
      (= advanced true)
    )
    (return false)
  )
  (fn-expr _ is-valid-length Bool
    (param header TraceHeader)
    (param segment TraceSegment)
    (param envelope ([] Byte))
    (param length U64)
    (and (>= envelope-size record-header-size) (<= envelope-size (. header record-header-size)) (>= length envelope-size) (<= payload-length (- length envelope-size)) (<= (+ segment-offset length) (. segment segment-size)))
    (where
      (lazy envelope-size (call (of word U32) envelope 4))
      (lazy payload-length (call (of word U64) envelope 16))
    )
  )
  (fn-do _ refresh-in-progress _ (?! Error)
    (param header TraceHeader)
    (let committed (list U64))
    (for (in position (. in-progress keys))
      (let record (!! ([] in-progress position)))
      (let envelope (call read-at position (. header record-header-size)))
      (if (== envelope null)
        (throw (call TraceError "Probe trace ended with an incomplete record header") (if (. header is-done)))
        (continue)
      )
      (if (== (call (of word U32) envelope 0) (. RecordState committed))
        (let data (call read-at position (. record length)))
        (if (== data null)
          (throw (call TraceError "Probe trace ended with an incomplete committed record") (if (. header is-done)))
          (continue)
        )
        (+= committed position)
        (call queue data)
        (call process-pending)
        (= advanced true)
        (else-if (. header is-done)
          (throw (call TraceError "Probe trace ended with incomplete committed records"))
        )
      )
    )
    (for (in position committed)
      (-= ([] in-progress position))
    )
  )
  (fn-do _ queue _ (?! TraceError)
    (param data ([] Byte))
    (let envelope-size (call (of word U32) data 4))
    (let length (call (of word U64) data 8))
    (let payload-length (call (of word U64) data 16))
    (let sequence (call (of word U64) data 24))
    (throw (call TraceError (str "Probe record length mismatch: expected " length ", got " (. data size))) (if (!= length (. data size))))
    (throw (call TraceError (str "Invalid probe record payload length: " payload-length)) (if (> payload-length (- length envelope-size))))
    (throw (call TraceError (str "Probe sequence moved backwards: expected " expected-sequence ", got " sequence)) (if (< sequence expected-sequence)))
    (throw (call TraceError (str "Duplicate probe transport sequence: " sequence)) (if (has pending sequence)))
    (let time (call TraceTime (call (of word U64) data 32) (call (of word U64) data 40)))
    (= ([] pending sequence) (call TracePending time ([] data (..< envelope-size (+ envelope-size payload-length)))))
  )
  (fn-do _ first-pending U64
    (let first (? U64) null)
    (for (in sequence (. pending keys))
      (if (or (== first null) (< sequence first))
        (= first sequence)
      )
    )
    (return (?? first 0))
  )
  (fn-do _ process-pending _ (?! TraceError)
    (while true
      (let record ([] pending expected-sequence))
      (return-if (if (== record null)))
      (-= ([] pending expected-sequence))
      (= current-sequence expected-sequence)
      (= current-time (. record time))
      (let cursor (call TraceCursor (. record payload)))
      (if has-head
        (call process-body cursor false)
        (else
          (call process-head cursor)
        )
      )
      (= current-sequence null)
      (+= expected-sequence 1)
      (= advanced true)
    )
  )
  (fn-do _ consume-sequence (? U64)
    (let sequence current-sequence)
    (= current-sequence null)
    (return sequence)
  )
  (fn-do _ emit _
    (param item TraceItem)
    (+= items item)
  )
  (fn-do _ process-head _ (?! TraceError)
    (param cursor TraceCursor)
    (while (. cursor has-more)
      (let type (as (call (. cursor u8)) TraceRecordType))
      (match type
        (case= .done
          (= has-head true)
          (call emit (. TraceItem compiled))
          (call process-body cursor false)
          (return)
        )
        (case= .declare-key
          (call emit (call (. TraceItem key) (call (. cursor string))))
        )
        (case= .declare-log
          (call declare-log cursor false)
        )
        (case= .declare-log2
          (call declare-log cursor true)
        )
        (case= .declare-event
          (call declare-event cursor)
        )
        (case= .declare-counter
          (call declare-counter cursor)
        )
        (case= .declare-profile-metric
          (call declare-metric cursor)
        )
        (case= .declare-type
          (call declare-type cursor)
        )
        (throw (call TraceError (str "Unrecognized probe declaration type: " type)))
      )
    )
  )
  (fn-do _ declare-log _ (?! TraceError)
    (param cursor TraceCursor)
    (param is-located Bool)
    (let id (call (. cursor u16)))
    (let key (if-expr is-located (call (. cursor string)) ""))
    (let name (call (. cursor string)))
    (let template (call (. cursor string)))
    (let module-name (if-expr is-located (call (. cursor string)) ""))
    (let source-path (if-expr is-located (call (. cursor string)) ""))
    (let line (if-expr is-located (call (. cursor u32)) 0))
    (call remember
      (block
        (arg
          (call TraceSite
            (block
              (arg id)
              (arg (. TraceSiteKind log))
              (arg key)
              (arg (only-if name (if (!= (. name size) 0))))
              (arg template)
              (arg module-name)
              (arg source-path)
              (arg line)
              (arg (call read-slots cursor))
            )
          )
        )
      )
    )
  )
  (fn-do _ declare-event _ (?! TraceError)
    (param cursor TraceCursor)
    (let id (call (. cursor u16)))
    (let key (call (. cursor string)))
    (let name (call (. cursor string)))
    (let module-name (call (. cursor string)))
    (call remember (call TraceSite id (. TraceSiteKind event) key name "" module-name "" 0 (call read-slots cursor)))
  )
  (fn-do _ declare-counter _ (?! TraceError)
    (param cursor TraceCursor)
    (let id (call (. cursor u16)))
    (let key (call (. cursor string)))
    (let module-name (call (. cursor string)))
    (let source-path (call (. cursor string)))
    (let line (call (. cursor u32)))
    (call remember
      (block
        (arg
          (call TraceSite
            (block
              (arg id)
              (arg (. TraceSiteKind counter))
              (arg key)
              (arg null)
              (arg "")
              (arg module-name)
              (arg source-path)
              (arg line)
              (arg (call (of List TraceSlot)))
            )
          )
        )
      )
    )
  )
  (fn-do _ declare-metric _ (?! TraceError)
    (param cursor TraceCursor)
    (let id (call (. cursor u16)))
    (let kind (call metric-kind (call (. cursor u8))))
    (let key (call (. cursor string)))
    (let module-name (call (. cursor string)))
    (let source-path (call (. cursor string)))
    (let line (call (. cursor u32)))
    (let site (call TraceMetricSite id kind key module-name source-path line (call (. cursor u16))))
    (= ([] metric-sites id) site)
    (call emit (call (. TraceItem metric-site) site))
  )
  (fn-do _ declare-type _ (?! TraceError)
    (param cursor TraceCursor)
    (let id (call (. cursor u16)))
    (call emit (call (. TraceItem type-name) (call TraceTypeName id (call (. cursor string)))))
  )
  (fn-do _ remember _
    (param site TraceSite)
    (= ([] sites (. site id)) site)
    (call emit (call (. TraceItem site) site))
  )
  (fn-do _ read-slots (list TraceSlot) (?! TraceError)
    (param cursor TraceCursor)
    (let count (call (. cursor u32)))
    (let slots (list TraceSlot))
    (for (in _ (..< 0 count))
      (let type (as (call (. cursor u8)) TraceSlotType))
      (+= slots (call TraceSlot type (call (. cursor u16))))
    )
    (return slots)
  )
  (fn-expr _ metric-kind TraceMetricKind (?! TraceError)
    (param value U8)
    (before
      (throw (call TraceError (str "Unrecognized profile metric kind: " value)) (if (and (!= value (. TraceMetricKind counter)) (!= value (. TraceMetricKind timer)))))
    )
    (as value TraceMetricKind)
  )
  (fn-do _ process-body Bool (?! TraceError)
    (param cursor TraceCursor)
    (param stops-on-done Bool)
    (while (. cursor has-more)
      (let type (as (call (. cursor u8)) TraceRecordType))
      (match type
        (case= .done
          (return-if true (if stops-on-done))
        )
        (case= .log
          (call process-record cursor false)
        )
        (case= .event
          (call process-record cursor true)
        )
        (case= .snapshot
          (let object-id (call (. cursor u32)))
          (let object-type-id (call (. cursor u16)))
          (call emit
            (block
              (arg
                (call (. TraceItem snapshot)
                  (block
                    (arg (call TraceSnapshot object-id object-type-id current-time (call consume-sequence)))
                  )
                )
              )
            )
          )
        )
        (case= .system-log
          (let text (call (. cursor string)))
          (call emit (call (. TraceItem system-log) (call TraceSystemLog text current-time (call consume-sequence))))
        )
        (case= .counter
          (call process-counter cursor)
        )
        (case= .profile-metric
          (call process-metric cursor)
        )
        (case= .declare-type
          (call declare-type cursor)
        )
        (throw (call TraceError (str "Unrecognized probe type: " type)))
      )
    )
    (return false)
  )
  (fn-do _ process-record _ (?! TraceError)
    (param cursor TraceCursor)
    (param is-event Bool)
    (let id (call (. cursor u16)))
    (let object-id (call (. cursor u32)))
    (let object-type-id (call (. cursor u16)))
    (let seconds (call (. cursor u64)))
    (let nanoseconds (call (. cursor u64)))
    (let site (call record-site id (if-expr is-event (. TraceSiteKind event) (. TraceSiteKind log))))
    (let values (if-expr (call is-group-event site) (call read-group-values cursor (. site slots)) (call read-values cursor (. site slots))))
    (let record
      (call TraceRecord
        (block
          (arg site)
          (arg object-id)
          (arg object-type-id)
          (arg values)
          (arg (call TraceTime seconds nanoseconds))
          (arg (call consume-sequence))
        )
      )
    )
    (call emit (if-expr is-event (call (. TraceItem event) record) (call (. TraceItem log) record)))
  )
  (fn-expr _ record-site TraceSite (?! TraceError)
    (param id U16)
    (param kind TraceSiteKind)
    (before
      (throw (call TraceError (str "Unrecognized " (call kind-name kind) " probe: " id)) (if (or (== site null) (!= (. site kind) kind))))
    )
    site
    (where
      (lazy site ([] sites id))
    )
  )
  (fn-expr _ kind-name String
    (param kind TraceSiteKind)
    (match kind
      (case= .log
        "log"
      )
      (case= .event
        "event"
      )
      (default
        "counter"
      )
    )
  )
  (fn-expr _ is-group-event Bool
    (param site TraceSite)
    (and is-event (!= (. site key size) 0) (or (== (. site name) "groupBegin") (== (. site name) "groupEnd")))
    (where
      (lazy is-event (== (. site kind) (. TraceSiteKind event)))
    )
  )
  (fn-do _ process-counter _ (?! TraceError)
    (param cursor TraceCursor)
    (let id (call (. cursor u16)))
    (let object-id (call (. cursor u32)))
    (let object-type-id (call (. cursor u16)))
    (let value (call (. cursor u64)))
    (let site (call record-site id (. TraceSiteKind counter)))
    (call emit
      (block
        (arg
          (call (. TraceItem counter)
            (block
              (arg (call TraceCounter site object-id object-type-id value current-time (call consume-sequence)))
            )
          )
        )
      )
    )
  )
  (fn-do _ process-metric _ (?! TraceError)
    (param cursor TraceCursor)
    (let id (call (. cursor u16)))
    (let kind (call metric-kind (call (. cursor u8))))
    (let value (call (. cursor u64)))
    (let total-ns (call (. cursor u64)))
    (let active-count (call (. cursor u64)))
    (let active-elapsed-ns (call (. cursor u64)))
    (let site ([] metric-sites id))
    (throw (call TraceError (str "Unrecognized profile metric: " id)) (if (== site null)))
    (throw (call TraceError (str "Profile metric kind mismatch for " id)) (if (!= (. site kind) kind)))
    (call emit
      (block
        (arg
          (call (. TraceItem metric)
            (block
              (arg
                (call TraceMetric
                  (block
                    (arg site)
                    (arg value)
                    (arg total-ns)
                    (arg active-count)
                    (arg active-elapsed-ns)
                    (arg current-time)
                    (arg (call consume-sequence))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ read-values (list TraceValue) (?! TraceError)
    (param cursor TraceCursor)
    (param slots (list TraceSlot))
    (let values (list TraceValue))
    (for (in slot slots)
      (+= values (call read-value cursor slot))
    )
    (return values)
  )
  (fn-do _ read-value TraceValue (?! TraceError)
    (param cursor TraceCursor)
    (param slot TraceSlot)
    (match (. slot type)
      (case= .string
        (return (call (. TraceValue text) (call (. cursor string))))
      )
      (case= .array
        (let length (call (. cursor u32)))
        (let item-type (call (. cursor u16)))
        (let data (call (. cursor bytes) length))
        (let object-id (call (. cursor u32)))
        (call process-body cursor true)
        (return (call (. TraceValue array) (call TraceArray object-id (. slot class-type) length item-type data)))
      )
      (case= .object
        (return (call read-object cursor slot))
      )
      (case= .group
        (return (call read-object cursor slot))
      )
      (default
        (return (call read-primitive cursor (. slot type)))
      )
    )
  )
  (fn-do _ read-object TraceValue (?! TraceError)
    (param cursor TraceCursor)
    (param slot TraceSlot)
    (let object-id (call (. cursor u32)))
    (call process-body cursor true)
    (return (call (. TraceValue object) (call TraceObject object-id (. slot class-type))))
  )
  (fn-do _ read-primitive TraceValue (?! TraceError)
    (param cursor TraceCursor)
    (param type TraceSlotType)
    (match type
      (case= .bool
        (return (call (. TraceValue truth) (!= (call (. cursor u8)) 0)))
      )
      (case= .char
        (return (call (. TraceValue character) (as (call (. cursor u8)) Char)))
      )
      (case= .int8
        (return (call (. TraceValue integer) (call (of (. cursor read) I8))))
      )
      (case= .uint8
        (return (call (. TraceValue unsigned) (call (. cursor u8))))
      )
      (case= .int16
        (return (call (. TraceValue integer) (call (of (. cursor read) I16))))
      )
      (case= .uint16
        (return (call (. TraceValue unsigned) (call (. cursor u16))))
      )
      (case= .int32
        (return (call (. TraceValue integer) (call (of (. cursor read) I32))))
      )
      (case= .uint32
        (return (call (. TraceValue unsigned) (call (. cursor u32))))
      )
      (case= .int64
        (return (call (. TraceValue integer) (call (of (. cursor read) I64))))
      )
      (case= .uint64
        (return (call (. TraceValue unsigned) (call (. cursor u64))))
      )
      (case= .float32
        (return (call (. TraceValue real) (call (of (. cursor read) F32))))
      )
      (case= .float64
        (return (call (. TraceValue real) (call (of (. cursor read) F64))))
      )
      (throw (call TraceError (str "Unsupported probe slot type: " type)))
    )
  )
  (fn-do _ read-group-values (list TraceValue) (?! TraceError)
    (param cursor TraceCursor)
    (param slots (list TraceSlot))
    (let values (list TraceValue))
    (for (in slot slots)
      (let is-kept (== (. values length) 0))
      (match (. slot type)
        (case= .string
          (let length (call (. cursor u32)))
          (let text (call (. cursor bytes) length))
          (if is-kept
            (+= values (call (. TraceValue text) (call (. text slice-string) (..< 0 (. text size)))))
          )
        )
        (case= .array
          (let length (call (. cursor u32)))
          (let item-type (call (. cursor u16)))
          (call (. cursor bytes) length)
          (let object-id (call (. cursor u32)))
          (if is-kept
            (+= values
              (call (. TraceValue array)
                (block
                  (arg (call TraceArray object-id (. slot class-type) length item-type ([] Byte 0)))
                )
              )
            )
          )
          (call skip-body cursor)
        )
        (case= .object
          (let object-id (call (. cursor u32)))
          (if is-kept
            (+= values (call (. TraceValue object) (call TraceObject object-id (. slot class-type))))
          )
          (call skip-body cursor)
        )
        (case= .group
          (let object-id (call (. cursor u32)))
          (if is-kept
            (+= values (call (. TraceValue object) (call TraceObject object-id (. slot class-type))))
          )
          (call skip-body cursor)
        )
        (default
          (let value (call read-primitive cursor (. slot type)))
          (if is-kept
            (+= values value)
          )
        )
      )
    )
    (return values)
  )
  (fn-do _ skip-body _ (?! TraceError)
    (param cursor TraceCursor)
    (while (. cursor has-more)
      (let type (as (call (. cursor u8)) TraceRecordType))
      (match type
        (case= .done
          (return)
        )
        (case= .log
          (call skip-record cursor (. TraceSiteKind log))
        )
        (case= .event
          (call skip-record cursor (. TraceSiteKind event))
        )
        (case= .snapshot
          (call (. cursor bytes) 6)
        )
        (case= .system-log
          (call (. cursor string))
        )
        (case= .counter
          (call (. cursor bytes) 16)
        )
        (case= .profile-metric
          (call (. cursor bytes) 35)
        )
        (case= .declare-type
          (call declare-type cursor)
        )
        (case= .declare-profile-metric
          (call (. cursor bytes) 3)
          (call (. cursor string))
          (call (. cursor string))
          (call (. cursor string))
          (call (. cursor bytes) 6)
        )
        (throw (call TraceError (str "Unrecognized nested probe type: " type)))
      )
    )
  )
  (fn-do _ skip-record _ (?! TraceError)
    (param cursor TraceCursor)
    (param kind TraceSiteKind)
    (let id (call (. cursor u16)))
    (call (. cursor bytes) 22)
    (let site ([] sites id))
    (throw (call TraceError (str "Unrecognized nested " (call kind-name kind) " probe: " id)) (if (or (== site null) (!= (. site kind) kind))))
    (for (in slot (. site slots))
      (match (. slot type)
        (case= .string
          (call (. cursor string))
        )
        (case= .array
          (let length (call (. cursor u32)))
          (call (. cursor bytes) (+ length 6))
          (call skip-body cursor)
        )
        (case= .object
          (call (. cursor bytes) 4)
          (call skip-body cursor)
        )
        (case= .group
          (call (. cursor bytes) 4)
          (call skip-body cursor)
        )
        (default
          (call read-primitive cursor (. slot type))
        )
      )
    )
  )
)

(fn-expr _ (of word Num) Num
  (param data ([] Byte))
  (param offset Size)
  (constraint is Num Number)
  (!! (call (of (. data read) Num) offset .little))
)
