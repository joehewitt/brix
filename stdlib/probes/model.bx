(import ./console)
(import ./trace)
(import /data/json)
(import /os/file)
(import /os/path)
(blank)
(prop _ group-type U16 (= 16))
(prop _ no-fields (list String))
(prop _ no-values (list TraceValue))

(type + TraceRowKind (is U8)
  (variant log (= 1))
  (variant event (= 2))
  (variant begin (= 3))
  (variant end (= 4))
  (variant system (= 5))
)

(type + TraceRow
  (prop + kind TraceRowKind)
  (prop + time U64)
  (prop + fields (list String))
  (prop + values (list TraceValue))
  (prop + index Size (= 0))
  (prop + site-id U16)
  (prop + key _ (= ""))
  (prop + label _ (= ""))
  (prop + location _ (= ""))
  (prop + path _ (= ""))
  (prop + line U32)
  (prop + depth Size (= 0))
  (prop + span U32)
  (prop + duration (? U64))
  (prop + parent (? Size))
  (prop + opening (? Size))
  (prop + owner _ (= ""))
  (prop + site (? TraceSite))
  (prop + types (? (map U16 String)))
  (prop + written (? String))
  (fn-do + This _
    (param kind TraceRowKind)
    (param time U64)
    (param fields (list String))
    (param values (list TraceValue))
  )
  (fn-expr + text String :get
    (?? written rendered)
    (where
      (lazy rendered (call rendered-text this))
    )
  )
  (fn-do + value (? TraceValue)
    (param name String)
    (for (in index (..< 0 (. fields length)))
      (return-if ([] values index) (if (and (== ([] fields index) name) (< index (. values length)))))
    )
    (return null)
  )
)

(fn-do _ rendered-text String
  (param row TraceRow)
  (return-if (. row label) (if (not (. row site))))
  (let site (. row site))
  (let types (?? (. row types) (call (of Map U16 String))))
  (let texts (list String))
  (for (in value (. row values))
    (+= texts (call value-text value types))
  )
  (if (== (. row kind) (. TraceRowKind event))
    (let prefix (if-expr (!= (. row owner) "") (str (. row owner) ".") ""))
    (return-if (str prefix ([] texts 0) " = " ([] texts 1)) (if (and (== (. site name) "set-property") (== (. texts length) 2))))
    (return (str prefix (. row label) ": " (call (. ", " join) texts)))
  )
  (return-if (call (. " " join) texts) (if (== (. site template) "")))
  (let parts (list String) (call (. site template split) "%%"))
  (let text ([] parts 0))
  (for (in index (..< 1 (. parts length)))
    (+= text (if-expr (< (- index 1) (. texts length)) ([] texts (- index 1)) ""))
    (+= text ([] parts index))
  )
  (return text)
)

(type + TraceCount (is (tuple (: key String) (: owner String) (: value U64) (: location String))))

(type + TraceSource
  (prop + trace _ (= ""))
  (prop + catalog _ (= ""))
  (prop + program _ (= ""))
  (prop + arguments (list String))
  (prop + status (? Int))
  (prop + timed-out _ (= false))
)

(type _ CatalogSite (is (tuple (: key String) (: template String) (: path String) (: line U32) (: fields (list String)))))

(type _ SiteInfo (is (tuple (: label String) (: location String) (: path String) (: line U32) (: fields (list String)) (: holds-group Bool) (: is-named Bool))))

(type + ProbeTrace
  (prop + source TraceSource)
  (prop + rows (list TraceRow))
  (prop + sites (map U16 TraceSite))
  (prop + site-rows (map U16 Size))
  (prop + counts (list TraceCount))
  (prop + metrics (list TraceMetric))
  (prop + types (map U16 String))
  (prop + start (? U64))
  (prop + latest U64)
  (prop + span U64)
  (prop + snapshots Size (= 0))
  (prop + is-closed _ (= false))
  (prop + named-sites Size (= 0))
  (prop + unnamed-sites Size (= 0))
  (prop + unmatched (list String))
  (prop + problem (? String))
  (blank)
  (prop _ catalog (map U16 CatalogSite))
  (prop _ infos (map U16 SiteInfo))
  (prop _ open (map U32 Size))
  (prop _ end-lines (map String Bool))
  (prop _ end-texts (map U32 String))
  (prop _ counter-index (map String Size))
  (prop _ metric-index (map String Size))
  (prop _ snapshot-object U32)
  (fn-do + This _
    (param source TraceSource)
  )
  (fn-expr + unended Size :get
    (. open length)
  )
  (fn-do + load _ (?! Error)
    (call read-catalog)
    (let reader (use (call TraceReader (. source trace) false)))
    (while (call read-batch reader)
      (continue)
    )
    (= is-closed (. reader is-done))
    (call finish)
  )
  (fn-do _ read-batch Bool
    (param reader TraceReader)
    (return-if false (if (. reader is-done)))
    (let items
      (call (. reader read-available)
        (block
          (on-error (: error Error)
            (= problem (?? (. error message) "the trace could not be read"))
            (return false)
          )
        )
      )
    )
    (for (in item items)
      (call observe item)
    )
    (return (. reader advanced))
  )
  (fn-do + read-catalog _ (?! Error)
    (return-if (if (or (== (. source catalog) "") (not (. (call Path (. source catalog)) is-file)))))
    (let root (call (. (call JSONReader (. source catalog) (call parse-json (call read-file-text (call Path (. source catalog))))) object)))
    (for (in selector (call (. ([] root "unmatched") items)))
      (+= unmatched (call (. selector string)))
    )
    (for (in item (call (. ([] root "sites") items)))
      (let site (call (. item object)))
      (let fields (list String))
      (for (in field (call (. ([] site "fields") items)))
        (+= fields (call (. field string)))
      )
      (= ([] catalog (as (call (. ([] site "id") int)) U16)) (call CatalogSite (call (. ([] site "key") string)) (call (. ([] site "template") string)) (call (. ([] site "path") string)) (as (call (. ([] site "line") int)) U32) fields))
    )
  )
  (fn-do + observe _
    (param item TraceItem)
    (match? item
      (case (call .site site)
        (= ([] sites (. site id)) site)
        (if (and (== (. site name) "groupEnd") (!= (. site source-path) ""))
          (= ([] end-lines (call site-location site)) true)
        )
      )
      (case (call .type-name named)
        (= ([] types (. named id)) (. named name))
      )
      (case (call .log record)
        (call observe-log record)
      )
      (case (call .event record)
        (call observe-event record)
      )
      (case (call .counter counter)
        (= ([] site-rows (. counter site id)) (+ (?? ([] site-rows (. counter site id)) 0) 1))
        (call count counter)
      )
      (case (call .metric metric)
        (call measure metric)
      )
      (case (call .snapshot snapshot)
        (= snapshot-object (. snapshot object-id))
        (+= snapshots 1)
      )
      (case (call .system-log log)
        (let row (call TraceRow .system (call trace-nanoseconds (. log time)) no-fields no-values))
        (= (. row label) "system")
        (= (. row written) (. log text))
        (call add row)
      )
    )
  )
  (fn-do _ count _
    (param counter TraceCounter)
    (let key (str (. counter site id) ":" (. counter object-id)))
    (let total
      (call TraceCount
        (block
          (arg (. counter site key))
          (arg (call owner-text (. counter object-id) (. counter object-type-id)))
          (arg (. counter value))
          (arg (call site-location (. counter site)))
        )
      )
    )
    (let index ([] counter-index key))
    (if index
      (= ([] counts index) total)
      (else
        (= ([] counter-index key) (. counts length))
        (+= counts total)
      )
    )
  )
  (fn-do _ measure _
    (param metric TraceMetric)
    (let index ([] metric-index (. metric site key)))
    (if index
      (= ([] metrics index) metric)
      (else
        (= ([] metric-index (. metric site key)) (. metrics length))
        (+= metrics metric)
      )
    )
  )
  (fn-do _ observe-log _
    (param record TraceRecord)
    (= snapshot-object 0)
    (if (== (. record site name) "groupBegin")
      (call begin (call new-row record .log) record null)
      (return)
    )
    (if (== (. record site name) "groupEnd")
      (call end (call new-row record .log) record)
      (return)
    )
    (if (and (== (. record object-type-id) group-type) ([] end-lines (. (call info-of (. record site)) location)))
      (= ([] end-texts (. record object-id)) (call record-text record types))
      (= ([] site-rows (. record site id)) (+ (?? ([] site-rows (. record site id)) 0) 1))
      (return)
    )
    (call add (call new-row record .log))
  )
  (fn-do _ observe-event _
    (param record TraceRecord)
    (if (and (!= (. record object-type-id) group-type) has-object (== (. record object-id) snapshot-object))
      (return)
    )
    (lazy has-object (!= (. record object-id) 0))
    (= snapshot-object 0)
    (let row (call new-row record .event))
    (if (== (. record site name) "groupBegin")
      (call begin row record (. record site key))
      (return)
    )
    (if (== (. record site name) "groupEnd")
      (call end row record)
      (return)
    )
    (if (and (!= (. record object-id) 0) (!= (. record object-type-id) group-type))
      (= (. row owner) (call owner-text (. record object-id) (. record object-type-id)))
    )
    (call add row)
  )
  (fn-do _ new-row TraceRow
    (param record TraceRecord)
    (param kind TraceRowKind)
    (let site (. record site))
    (let info (call info-of site))
    (let values (if-expr (. info holds-group) (call written-values record) (. record values)))
    (let row (call TraceRow kind (call trace-nanoseconds (. record time)) (. info fields) values))
    (= (. row site-id) (. site id))
    (= (. row key) (. site key))
    (= (. row label) (. info label))
    (= (. row location) (. info location))
    (= (. row path) (. info path))
    (= (. row line) (. info line))
    (= (. row site) site)
    (= (. row types) types)
    (if (== (. record object-type-id) group-type)
      (let parent ([] open (. record object-id)))
      (if parent
        (= (. row parent) parent)
        (= (. row depth) (+ (. ([] rows parent) depth) 1))
      )
    )
    (return row)
  )
  (fn-do _ begin _
    (param row TraceRow)
    (param record TraceRecord)
    (param text (? String))
    (= (. row kind) .begin)
    (= (. row written) text)
    (let group (call first-group record))
    (if group
      (= (. row span) group)
      (= ([] open group) (. rows length))
    )
    (call add row)
  )
  (fn-do _ end _
    (param row TraceRow)
    (param record TraceRecord)
    (= (. row kind) .end)
    (let group (call first-group record))
    (return-if (if (not group)))
    (= (. row span) group)
    (let text ([] end-texts group))
    (-= ([] end-texts group))
    (let started ([] open group))
    (if started
      (-= ([] open group))
      (let opening ([] rows started))
      (let elapsed (if-expr (> (. row time) (. opening time)) (- (. row time) (. opening time)) 0u64))
      (= (. opening duration) elapsed)
      (= (. row duration) elapsed)
      (= (. row opening) started)
      (= (. row parent) (. opening parent))
      (= (. row depth) (. opening depth))
      (= (. row label) (. opening label))
      (= (. row written) (?? text (. opening text)))
      (else
        (= (. row written) (?? text (. row label)))
      )
    )
    (call add row)
  )
  (fn-do _ first-group (? U32)
    (param record TraceRecord)
    (for (in value (. record values))
      (match? value
        (case (call .object object)
          (if (== (. object type-id) group-type)
            (return (. object object-id))
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ info-of SiteInfo
    (param site TraceSite)
    (let found ([] infos (. site id)))
    (return-if found (if found))
    (let holds
      (scope (and (!= (. site slots length) 0) (== (. ([] (. site slots) 0) type) (. TraceSlotType object)) group-slot)
        (lazy group-slot (== (. ([] (. site slots) 0) class-type) group-type))
      )
    )
    (let listed ([] catalog (. site id)))
    (let named (and listed (== (. listed key) (. site key)) (== (. listed template) (. site template)) (or (== (. site line) 0) (== (. listed line) (. site line)))))
    (let names (if-expr named (. (!! listed) fields) no-fields))
    (let written (list String))
    (for (in index (..< 0 (. site slots length)))
      (let slot ([] (. site slots) index))
      (if (and (== (. slot type) (. TraceSlotType object)) (== (. slot class-type) group-type))
        (continue)
      )
      (+= written (if-expr (< index (. names length)) ([] names index) (str "value" (+ (. written length) 1))))
    )
    (let path (if-expr (and named (== (. site source-path) "")) (. (!! listed) path) (. site source-path)))
    (let line (if-expr (and named (== (. site line) 0)) (. (!! listed) line) (. site line)))
    (let location (if-expr (!= path "") (str (call base-name path) ":" line) ""))
    (let info (call SiteInfo (call site-label site) location path line written holds named))
    (= ([] infos (. site id)) info)
    (return info)
  )
  (fn-expr + field-names (list String)
    (param site TraceSite)
    (. (call info-of site) fields)
  )
  (fn-expr + location-of String
    (param site TraceSite)
    (. (call info-of site) location)
  )
  (fn-expr _ owner-text String
    (param id U32)
    (param type U16)
    (str (call type-label type types) "#" id)
  )
  (fn-do _ add _
    (param row TraceRow)
    (= (. row index) (. rows length))
    (+= rows row)
    (= ([] site-rows (. row site-id)) (+ (?? ([] site-rows (. row site-id)) 0) 1))
    (if (or (not start) (< (. row time) start))
      (= start (. row time))
    )
    (if (> (. row time) latest)
      (= latest (. row time))
    )
  )
  (fn-do _ finish _
    (let base (?? start 0u64))
    (for (in row rows)
      (= (. row time) (if-expr (> (. row time) base) (- (. row time) base) 0u64))
    )
    (= span (if-expr (> latest base) (- latest base) 0u64))
    (= latest span)
    (if start
      (= start 0u64)
    )
    (for (in (tuple _ site) sites)
      (if (== (. site kind) (. TraceSiteKind counter))
        (continue)
      )
      (if (. (call info-of site) is-named)
        (+= named-sites 1)
        (else-if (!= (. site slots length) 0)
          (+= unnamed-sites 1)
        )
      )
    )
  )
)

(fn-expr _ base-name String
  (param path String)
  (case? slash
    ([] path (... (+ slash 1)))
  )
  (default
    path
  )
  (where
    (lazy slash (call (. path find-reverse) "/"))
  )
)
