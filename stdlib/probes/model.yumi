./console
./trace
/data/json
/os/file
/os/path

_ group-type U16 = 16
_ no-fields [String]
_ no-values [TraceValue]

━━━━━━━━━━━━━━━━━━━━
+ TraceRowKind is U8

| log = 1
| event = 2
| begin = 3
| end = 4
| system = 5

━━━━━━━━━━━━━━━━━━━━
+ TraceRow

+ kind TraceRowKind
+ time U64
+ fields [String]
+ values [TraceValue]
+ index Size = 0
+ site-id U16
+ key = ""
+ label = ""
+ location = ""
+ path = ""
+ line U32
+ depth Size = 0
+ span U32
+ duration U64?
+ parent Size?
+ opening Size?
+ owner = ""
+ site TraceSite?
+ types [U16 = String]?
+ written String?

────────────────────
+ This
    - kind TraceRowKind
    - time U64
    - fields [String]
    - values [TraceValue]

────────────────────
+ get text String

written ?? rendered

.. rendered = rendered-text(this)

────────────────────
+ do value TraceValue?
    - name String

for index in 0 .. < fields.length
    =? values[index] if fields[index] == name && index < values.length
= null

━━━━━━━━━━━━━━━━━━━━
_ do rendered-text String
    - row TraceRow

=? row.label if !row.site
. site = row.site
. types = row.types ?? Map'U16'String()
. texts [String]
for value in row.values
    texts += value-text(value, types)
if row.kind == TraceRowKind.event
    . prefix = if row.owner != "" then "${row.owner}." else ""
    =? "$prefix${texts[0]} = ${texts[1]}" if site.name == "set-property" && texts.length == 2
    = "$prefix${row.label}: ${", ".join(texts)}"
=? " ".join(texts) if site.template == ""
. parts [String] = site.template.split("%%")
. text = parts[0]
for index in 1 .. < parts.length
    text += if index - 1 < texts.length then texts[index - 1] else ""
    text += parts[index]
= text

━━━━━━━━━━━━━━━━━━━━
+ TraceCount is (key String, owner String, value U64, location String)

━━━━━━━━━━━━━━━━━━━━
+ TraceSource

+ trace = ""
+ catalog = ""
+ program = ""
+ arguments [String]
+ status Int?
+ timed-out = false

━━━━━━━━━━━━━━━━━━━━
_ CatalogSite is (key String, template String, path String, line U32, fields [String])

━━━━━━━━━━━━━━━━━━━━
_ SiteInfo is (label String, location String, path String, line U32, fields [String], holds-group Bool, is-named Bool)

━━━━━━━━━━━━━━━━━━━━
+ ProbeTrace

+ source TraceSource
+ rows [TraceRow]
+ sites [U16 = TraceSite]
+ site-rows [U16 = Size]
+ counts [TraceCount]
+ metrics [TraceMetric]
+ types [U16 = String]
+ start U64?
+ latest U64
+ span U64
+ snapshots Size = 0
+ is-closed = false
+ named-sites Size = 0
+ unnamed-sites Size = 0
+ unmatched [String]
+ problem String?

_ catalog [U16 = CatalogSite]
_ infos [U16 = SiteInfo]
_ open [U32 = Size]
_ end-lines [String = Bool]
_ end-texts [U32 = String]
_ counter-index [String = Size]
_ metric-index [String = Size]
_ snapshot-object U32

────────────────────
+ This
    - source TraceSource

────────────────────
+ get unended Size

open.length

────────────────────
+ do load ?! Error

read-catalog()
. reader = use TraceReader(source.trace, false)
while read-batch(reader)
    continue
is-closed = reader.is-done
finish()

────────────────────
_ do read-batch Bool
    - reader TraceReader

=? false if reader.is-done
. items = reader.read-available()
    catch error Error
        problem = error.message ?? "the trace could not be read"
        = false
for item in items
    observe(item)
= reader.advanced

────────────────────
+ do read-catalog ?! Error

=? if source.catalog == "" || !Path(source.catalog).is-file
. root = JSONReader(source.catalog, parse-json(read-file-text(Path(source.catalog)))).object()
for selector in root["unmatched"].items()
    unmatched += selector.string()
for item in root["sites"].items()
    . site = item.object()
    . fields [String]
    for field in site["fields"].items()
        fields += field.string()
    catalog[site["id"].int() as U16] = CatalogSite(site["key"].string(), site["template"].string(), site["path"].string(), site["line"].int() as U32, fields)

────────────────────
+ do observe
    - item TraceItem

match? item
    | .site(site)
        sites[site.id] = site
        if site.name == "groupEnd" && site.source-path != ""
            end-lines[site-location(site)] = true
    | .type-name(named)
        types[named.id] = named.name
    | .log(record)
        observe-log(record)
    | .event(record)
        observe-event(record)
    | .counter(counter)
        site-rows[counter.site.id] = (site-rows[counter.site.id] ?? 0) + 1
        count(counter)
    | .metric(metric)
        measure(metric)
    | .snapshot(snapshot)
        snapshot-object = snapshot.object-id
        snapshots += 1
    | .system-log(log)
        . row = TraceRow(.system, trace-nanoseconds(log.time), no-fields, no-values)
        row.label = "system"
        row.written = log.text
        add(row)

────────────────────
_ do count
    - counter TraceCounter

. key = "${counter.site.id}:${counter.object-id}"
. total = TraceCount
    - counter.site.key
    - owner-text(counter.object-id, counter.object-type-id)
    - counter.value
    - site-location(counter.site)
. index = counter-index[key]
if index
    counts[index] = total
else
    counter-index[key] = counts.length
    counts += total

────────────────────
_ do measure
    - metric TraceMetric

. index = metric-index[metric.site.key]
if index
    metrics[index] = metric
else
    metric-index[metric.site.key] = metrics.length
    metrics += metric

────────────────────
_ do observe-log
    - record TraceRecord

snapshot-object = 0
if record.site.name == "groupBegin"
    begin(new-row(record, .log), record, null)
    =
if record.site.name == "groupEnd"
    end(new-row(record, .log), record)
    =
if record.object-type-id == group-type && end-lines[info-of(record.site).location]
    end-texts[record.object-id] = record-text(record, types)
    site-rows[record.site.id] = (site-rows[record.site.id] ?? 0) + 1
    =
add(new-row(record, .log))

────────────────────
_ do observe-event
    - record TraceRecord

if record.object-type-id != group-type && has-object && record.object-id == snapshot-object
    =
.. has-object = record.object-id != 0
snapshot-object = 0
. row = new-row(record, .event)
if record.site.name == "groupBegin"
    begin(row, record, record.site.key)
    =
if record.site.name == "groupEnd"
    end(row, record)
    =
if record.object-id != 0 && record.object-type-id != group-type
    row.owner = owner-text(record.object-id, record.object-type-id)
add(row)

────────────────────
_ do new-row TraceRow
    - record TraceRecord
    - kind TraceRowKind

. site = record.site
. info = info-of(site)
. values = if info.holds-group then written-values(record) else record.values
. row = TraceRow(kind, trace-nanoseconds(record.time), info.fields, values)
row.site-id = site.id
row.key = site.key
row.label = info.label
row.location = info.location
row.path = info.path
row.line = info.line
row.site = site
row.types = types
if record.object-type-id == group-type
    . parent = open[record.object-id]
    if parent
        row.parent = parent
        row.depth = rows[parent].depth + 1
= row

────────────────────
_ do begin
    - row TraceRow
    - record TraceRecord
    - text String?

row.kind = .begin
row.written = text
. group = first-group(record)
if group
    row.span = group
    open[group] = rows.length
add(row)

────────────────────
_ do end
    - row TraceRow
    - record TraceRecord

row.kind = .end
. group = first-group(record)
=? if !group
row.span = group
. text = end-texts[group]
-= end-texts[group]
. started = open[group]
if started
    -= open[group]
    . opening = rows[started]
    . elapsed = if row.time > opening.time then row.time - opening.time else 0u64
    opening.duration = elapsed
    row.duration = elapsed
    row.opening = started
    row.parent = opening.parent
    row.depth = opening.depth
    row.label = opening.label
    row.written = text ?? opening.text
else
    row.written = text ?? row.label
add(row)

────────────────────
_ do first-group U32?
    - record TraceRecord

for value in record.values
    match? value
        | .object(object)
            if object.type-id == group-type
                = object.object-id
= null

────────────────────
_ do info-of SiteInfo
    - site TraceSite

. found = infos[site.id]
=? found if found
. holds = site.slots.length != 0 && site.slots[0].type == TraceSlotType.object && group-slot
    .. group-slot = site.slots[0].class-type == group-type
. listed = catalog[site.id]
. named = listed && listed.key == site.key && listed.template == site.template && (site.line == 0 || listed.line == site.line)
. names = if named then listed!.fields else no-fields
. written [String]
for index in 0 .. < site.slots.length
    . slot = site.slots[index]
    if slot.type == TraceSlotType.object && slot.class-type == group-type
        continue
    written += if index < names.length then names[index] else "value${written.length + 1}"
. path = if named && site.source-path == "" then listed!.path else site.source-path
. line = if named && site.line == 0 then listed!.line else site.line
. location = if path != "" then "${base-name(path)}:$line" else ""
. info = SiteInfo(site-label(site), location, path, line, written, holds, named)
infos[site.id] = info
= info

────────────────────
+ field-names [String]
    - site TraceSite

info-of(site).fields

────────────────────
+ location-of String
    - site TraceSite

info-of(site).location

────────────────────
_ owner-text String
    - id U32
    - type U16

"${type-label(type, types)}#$id"

────────────────────
_ do add
    - row TraceRow

row.index = rows.length
rows += row
site-rows[row.site-id] = (site-rows[row.site-id] ?? 0) + 1
if !start || row.time < start
    start = row.time
if row.time > latest
    latest = row.time

────────────────────
_ do finish

. base = start ?? 0u64
for row in rows
    row.time = if row.time > base then row.time - base else 0u64
span = if latest > base then latest - base else 0u64
latest = span
if start
    start = 0u64
for _, site in sites
    if site.kind == TraceSiteKind.counter
        continue
    if info-of(site).is-named
        named-sites += 1
    else if site.slots.length != 0
        unnamed-sites += 1

━━━━━━━━━━━━━━━━━━━━
_ base-name String
    - path String

|? slash
    path[slash + 1 ...]
??
    path

.. slash = path.find-reverse("/")
