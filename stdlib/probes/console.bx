(import ./trace)
(import /os/file)
(import /stream/sort)
(blank)
(prop _ group-type U16 (= 16))
(prop _ footer-limit Size (= 8))

(fn-expr + trace-nanoseconds U64
  (param time TraceTime)
  (+ (* (. time seconds) 1000000000) (. time nanoseconds))
)

(fn-expr + duration-text String
  (param nanoseconds U64)
  (case? (< nanoseconds 1000)
    (str nanoseconds "ns")
  )
  (case? (< nanoseconds 1000000)
    (call tenths nanoseconds 100 "µs")
  )
  (case? (< nanoseconds 1000000000)
    (call tenths nanoseconds 100000 "ms")
  )
  (default
    (call tenths nanoseconds 100000000 "s")
  )
)

(fn-expr _ tenths String
  (param value U64)
  (param unit U64)
  (param suffix String)
  (str (/ count 10) "." (% count 10) suffix)
  (where
    (lazy count (/ value unit))
  )
)

(fn-do + count-text String
  (param value U64)
  (let digits (str value))
  (let text "")
  (for (in index (..< 0 (. digits length)))
    (if (and (!= index 0) (== (% (- (. digits length) index) 3) 0))
      (+= text ",")
    )
    (+= text ([] digits (..< index (+ index 1))))
  )
  (return text)
)

(fn-expr + type-label String
  (param id U16)
  (param types (map U16 String))
  (case? (== id group-type)
    "group"
  )
  (case? name
    (call short-name name)
  )
  (default
    "object"
  )
  (where
    (lazy name ([] types id))
  )
)

(fn-expr _ short-name String
  (param name String)
  (case? colon
    ([] name (... (+ colon 1)))
  )
  (default
    name
  )
  (where
    (lazy colon (call (. name find-reverse) ":"))
  )
)

(fn-expr + value-text String
  (param value TraceValue)
  (param types (map U16 String))
  (match value
    (case (call .truth truth)
      (if-expr truth "true" "false")
    )
    (case (call .character character)
      (str character)
    )
    (case (call .integer integer)
      (str integer)
    )
    (case (call .unsigned unsigned)
      (str unsigned)
    )
    (case (call .real real)
      (str real)
    )
    (case (call .text text)
      text
    )
    (case (call .object object)
      (str (call type-label (. object type-id) types) "#" (. object object-id))
    )
    (case (call .array array)
      (str (call type-label (. array type-id) types) "[" (. array length) "]")
    )
  )
)

(fn-do + written-values (list TraceValue)
  (param record TraceRecord)
  (let values (list TraceValue))
  (for (in index (..< 0 (. record values length)))
    (let slot
      (scope (if-expr (< index (. record site slots length)) ([] (. record site slots) index) empty-slot)
        (lazy empty-slot (call TraceSlot .none 0))
      )
    )
    (if (and (== (. slot type) (. TraceSlotType object)) (== (. slot class-type) group-type))
      (continue)
    )
    (+= values ([] (. record values) index))
  )
  (return values)
)

(fn-do + record-text String
  (param record TraceRecord)
  (param types (map U16 String))
  (let values (call written-values record))
  (let texts (list String))
  (for (in value values)
    (+= texts (call value-text value types))
  )
  (let template (. record site template))
  (return-if (call (. " " join) texts) (if (== template "")))
  (blank)
  (let parts (list String) (call (. template split) "%%"))
  (let text ([] parts 0))
  (for (in index (..< 1 (. parts length)))
    (+= text (if-expr (< (- index 1) (. texts length)) ([] texts (- index 1)) ""))
    (+= text ([] parts index))
  )
  (return text)
)

(fn-expr + site-label String
  (param site TraceSite)
  (case? (!= (. site key) "")
    (. site key)
  )
  (case? (!= (. site template) "")
    (call (. "…" join) (call (. site template split) "%%"))
  )
  (default
    (?? (. site name) "probe")
  )
)

(fn-expr + site-location String
  (param site TraceSite)
  (case? (== (. site source-path) "")
    ""
  )
  (default
    (str (call base-name (. site source-path)) ":" (. site line))
  )
)

(fn-expr _ base-name String
  (param path String)
  (case? slash
    ([] path (... (+ slash 1)))
  )
  (default
    path
  )
  (where
    (lazy slash (call (. path find-reverse) "/"))
  )
)

(type _ OpenGroup (is Tuple)
  (prop + depth Size)
  (prop + start U64)
  (prop + label String)
  (prop + site TraceSite)
)

(type _ GroupStats (is Tuple)
  (prop + label String)
  (prop + location String)
  (prop + count U64)
  (prop + total U64)
  (prop + longest U64)
)

(type _ SiteStats (is (tuple (: label String) (: location String) (: count U64))))

(type _ CounterValue (is (tuple (: key String) (: object-id U32) (: value U64))))

(type + ProbeConsole
  (prop + shows-lines Bool)
  (prop + line-limit Size)
  (prop + shown Size (= 0))
  (prop + hidden Size (= 0))
  (prop + records U64)
  (prop + logs U64)
  (prop + events U64)
  (prop + snapshots U64)
  (prop + system-logs U64)
  (prop + first-time U64)
  (prop + last-time U64)
  (blank)
  (prop _ types (map U16 String))
  (prop _ end-lines (map String Bool))
  (prop _ groups (map U32 OpenGroup))
  (prop _ end-texts (map U32 String))
  (prop _ snapshot-object U32)
  (prop _ group-stats (map String GroupStats))
  (prop _ site-stats (map U16 SiteStats))
  (prop _ counters (map String CounterValue))
  (prop _ metrics (map String TraceMetric))
  (fn-do + This _
    (param shows-lines _ (= true))
    (param line-limit Size (= 400))
  )
  (fn-do + observe _
    (param item TraceItem)
    (match? item
      (case (call .site site)
        (if (and (== (. site name) "groupEnd") (!= (. site source-path) ""))
          (= ([] end-lines (call site-location site)) true)
        )
      )
      (case (call .type-name named)
        (= ([] types (. named id)) (. named name))
      )
      (case (call .log record)
        (call observe-log record)
      )
      (case (call .event record)
        (call observe-event record)
      )
      (case (call .counter counter)
        (= ([] counters (str (. counter site id) ":" (. counter object-id)))
          (call CounterValue
            (block
              (arg (. counter site key))
              (arg (. counter object-id))
              (arg (. counter value))
            )
          )
        )
      )
      (case (call .metric metric)
        (= ([] metrics (. metric site key)) metric)
      )
      (case (call .snapshot snapshot)
        (call note-time (. snapshot time))
        (+= snapshots 1)
        (= snapshot-object (. snapshot object-id))
      )
      (case (call .system-log log)
        (call note-time (. log time))
        (+= system-logs 1)
        (call show (. log time) 0 (str "[system] " (. log text)) "")
      )
    )
  )
  (fn-do _ observe-log _
    (param record TraceRecord)
    (call note-time (. record time))
    (+= logs 1)
    (= snapshot-object 0)
    (let depth (call depth-of record))
    (if (== (. record site name) "groupBegin")
      (call begin-group record depth (call record-text record types) (call site-label (. record site)))
      (return)
    )
    (if (== (. record site name) "groupEnd")
      (call end-group record)
      (return)
    )
    (let text (call record-text record types))
    (if (and (== (. record object-type-id) group-type) ([] end-lines (call site-location (. record site))))
      (= ([] end-texts (. record object-id)) text)
      (return)
    )
    (call count-site (. record site))
    (call show (. record time) depth (call key-text (. record site) text) (call site-location (. record site)))
  )
  (fn-do _ observe-event _
    (param record TraceRecord)
    (call note-time (. record time))
    (+= events 1)
    (if (and (!= (. record object-type-id) group-type) has-object (== (. record object-id) snapshot-object))
      (return)
    )
    (lazy has-object (!= (. record object-id) 0))
    (= snapshot-object 0)
    (let depth (call depth-of record))
    (if (== (. record site name) "groupBegin")
      (call begin-group record depth (. record site key) (. record site key))
      (return)
    )
    (if (== (. record site name) "groupEnd")
      (call end-group record)
      (return)
    )
    (call count-site (. record site))
    (let values (list String))
    (for (in value (call written-values record))
      (+= values (call value-text value types))
    )
    (let owner
      (scope (if-expr (and (!= (. record object-id) 0) (!= (. record object-type-id) group-type)) object-tag "")
        (lazy object-tag (str (call type-label (. record object-type-id) types) "#" (. record object-id) "."))
      )
    )
    (if (and (== (. record site name) "set-property") (== (. values length) 2))
      (call show (. record time) depth (str owner ([] values 0) " = " ([] values 1)) "")
      (return)
    )
    (let label (if-expr (!= (. record site key) "") (. record site key) (?? (. record site name) "event")))
    (call show (. record time) depth (str owner label ": " (call (. ", " join) values)) "")
  )
  (fn-do _ begin-group _
    (param record TraceRecord)
    (param depth Size)
    (param text String)
    (param label String)
    (let group (call first-group record))
    (if group
      (= ([] groups group) (call OpenGroup depth (call trace-nanoseconds (. record time)) text (. record site)))
    )
    (call show (. record time) depth (str "+ " text) (call site-location (. record site)))
  )
  (fn-do _ end-group _
    (param record TraceRecord)
    (let group (call first-group record))
    (return-if (if (not group)))
    (blank)
    (let found ([] groups group))
    (let text ([] end-texts group))
    (-= ([] end-texts group))
    (if (not found)
      (call show
        (block
          (arg (. record time))
          (arg (call depth-of record))
          (arg (str "- " (?? text (call site-label (. record site)))))
          (arg (call site-location (. record site)))
        )
      )
      (return)
    )
    (let open found)
    (-= ([] groups group))
    (let elapsed
      (scope (if-expr (> (call trace-nanoseconds (. record time)) (. open start)) since-start 0u64)
        (lazy since-start (- (call trace-nanoseconds (. record time)) (. open start)))
      )
    )
    (call add-group (. open site) elapsed)
    (call show
      (block
        (arg (. record time))
        (arg (. open depth))
        (arg (str "- " (?? text (. open label)) " " (call duration-text elapsed)))
        (arg (call site-location (. record site)))
      )
    )
  )
  (fn-do _ first-group (? U32)
    (param record TraceRecord)
    (for (in value (. record values))
      (match? value
        (case (call .object object)
          (if (== (. object type-id) group-type)
            (return (. object object-id))
          )
        )
      )
    )
    (return null)
  )
  (fn-expr _ depth-of Size
    (param record TraceRecord)
    (case? (or (!= (. record object-type-id) group-type) (not open))
      0
    )
    (default
      (+ (. open depth) 1)
    )
    (where
      (lazy open ([] groups (. record object-id)))
    )
  )
  (fn-expr _ key-text String
    (param site TraceSite)
    (param text String)
    (if-expr (!= (. site key) "") (str "[" (. site key) "] " text) text)
  )
  (fn-do _ note-time _
    (param time TraceTime)
    (let now (call trace-nanoseconds time))
    (+= records 1)
    (if (or (== first-time 0) (< now first-time))
      (= first-time now)
    )
    (if (> now last-time)
      (= last-time now)
    )
  )
  (fn-do _ count-site _
    (param site TraceSite)
    (let found ([] site-stats (. site id)))
    (if found
      (= ([] site-stats (. site id)) (call SiteStats (. found label) (. found location) (+ (. found count) 1)))
      (else
        (= ([] site-stats (. site id)) (call SiteStats (call site-label site) (call site-location site) 1))
      )
    )
  )
  (fn-do _ add-group _
    (param site TraceSite)
    (param elapsed U64)
    (let label (call site-label site))
    (let found ([] group-stats label))
    (if found
      (let stats found)
      (let longest (if-expr (> elapsed (. stats longest)) elapsed (. stats longest)))
      (= ([] group-stats label)
        (call GroupStats
          (block
            (arg label)
            (arg (. stats location))
            (arg (+ (. stats count) 1))
            (arg (+ (. stats total) elapsed))
            (arg longest)
          )
        )
      )
      (else
        (= ([] group-stats label) (call GroupStats label (call site-location site) 1 elapsed elapsed))
      )
    )
  )
  (fn-do _ show _
    (param time TraceTime)
    (param depth Size)
    (param text String)
    (param location String)
    (return-if (if (not shows-lines)))
    (blank)
    (if (>= shown line-limit)
      (+= hidden 1)
      (return)
    )
    (+= shown 1)
    (let offset
      (scope (if-expr (> (call trace-nanoseconds time) first-time) since-first 0u64)
        (lazy since-first (- (call trace-nanoseconds time) first-time))
      )
    )
    (let stamp (call duration-text offset))
    (let padding (if-expr (< (. stamp length) 8) (* " " (- 8 (. stamp length))) ""))
    (let indent (* "  " depth))
    (let place (if-expr (!= location "") (str "  " location) ""))
    (<- stderr (str "· " padding stamp "  " indent text place "\n"))
  )
  (fn-do + footer-lines (list String)
    (let lines (list String))
    (let counted (call counter-texts))
    (if (!= (. counted length) 0)
      (+= lines (str "counters: " (call capped counted)))
    )
    (let timed (call group-texts))
    (if (!= (. timed length) 0)
      (+= lines (str "groups: " (call capped timed)))
    )
    (let busy (call site-texts))
    (if (!= (. busy length) 0)
      (+= lines (str "busiest: " (call capped busy)))
    )
    (let measured (call metric-texts))
    (if (!= (. measured length) 0)
      (+= lines (str "metrics: " (call capped measured)))
    )
    (let kinds (list String))
    (if (!= logs 0)
      (+= kinds (str (call count-text logs) " logs"))
    )
    (if (!= events 0)
      (+= kinds (str (call count-text events) " events"))
    )
    (if (!= snapshots 0)
      (+= kinds (str (call count-text snapshots) " snapshots"))
    )
    (if (!= system-logs 0)
      (+= kinds (str (call count-text system-logs) " system log" (if-expr (!= system-logs 1) "s" "")))
    )
    (if (!= (. kinds length) 0)
      (+= lines
        (scope (str "records: " (call (. ", " join) kinds) " over " elapsed)
          (lazy elapsed (call duration-text (if-expr (> last-time first-time) (- last-time first-time) 0u64)))
        )
      )
    )
    (if (!= hidden 0)
      (+= lines
        (scope (str "warning: " omitted " probe lines not shown (limit " line-limit "); the trace has them all")
          (lazy omitted (call count-text (as hidden U64)))
        )
      )
    )
    (if (!= (call open-groups) 0)
      (+= lines (str "warning: " (call open-groups) " groups never ended"))
    )
    (return lines)
  )
  (fn-expr _ open-groups Size
    (. groups length)
  )
  (fn-expr _ capped String
    (param texts (list String))
    (case? (<= (. texts length) footer-limit)
      (call (. " · " join) texts)
    )
    (default
      (str (call (. " · " join) ([] texts (..< 0 footer-limit))) " · +" (- (. texts length) footer-limit) " more")
    )
  )
  (fn-do _ counter-texts (list String)
    (let totals (map String U64))
    (let objects (map String U64))
    (for (in (tuple _ counter) counters)
      (= ([] totals (. counter key)) (+ (?? ([] totals (. counter key)) 0u64) (. counter value)))
      (if (!= (. counter object-id) 0)
        (= ([] objects (. counter key)) (+ (?? ([] objects (. counter key)) 0u64) 1))
      )
    )
    (let keys (call sort (. totals keys) (:using (=> (a b) (if-expr (< a b) .lesser .greater)))))
    (let texts (list String))
    (for (in key keys)
      (let owners ([] objects key))
      (let suffix (if-expr (and owners (> owners 1)) (str " (" owners " objects)") ""))
      (+= texts (str key " " (call count-text (!! ([] totals key))) suffix))
    )
    (return texts)
  )
  (fn-do _ group-texts (list String)
    (let ordered (call sort group-values (:using (=> (a b) (if-expr (> (. a total) (. b total)) .lesser .greater)))))
    (lazy group-values (. group-stats values))
    (let texts (list String))
    (for (in stats ordered)
      (if (== (. stats count) 1)
        (+= texts (str (. stats label) " " (call duration-text (. stats total))))
        (else
          (+= texts
            (scope (str (. stats label) " " (call count-text (. stats count)) "× " total-text " (max " longest-text ")")
              (lazy total-text (call duration-text (. stats total)))
              (lazy longest-text (call duration-text (. stats longest)))
            )
          )
        )
      )
    )
    (return texts)
  )
  (fn-do _ site-texts (list String)
    (let ordered (call sort site-values (:using (=> (a b) (if-expr (> (. a count) (. b count)) .lesser .greater)))))
    (lazy site-values (. site-stats values))
    (let texts (list String))
    (for (in stats ordered)
      (if (< (. stats count) 2)
        (break)
      )
      (let place (if-expr (!= (. stats location) "") (str " " (. stats location)) ""))
      (+= texts (str (. stats label) " " (call count-text (. stats count)) "×" place))
    )
    (return texts)
  )
  (fn-do _ metric-texts (list String)
    (let keys (call sort (. metrics keys) (:using (=> (a b) (if-expr (< a b) .lesser .greater)))))
    (let texts (list String))
    (for (in key keys)
      (let metric (!! ([] metrics key)))
      (if (== (. metric site kind) (. TraceMetricKind timer))
        (+= texts (str key " " (call count-text (. metric value)) "× " (call duration-text (. metric total-ns))))
        (else
          (+= texts (str key " " (call count-text (. metric value))))
        )
      )
    )
    (return texts)
  )
)
