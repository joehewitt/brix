./console
./trace
/data/json
/os/env
/os/file
/os/path
/os/process
/os/signal
/stream/sort
/time/clock
/time/duration

_ grace-period = 2s
_ follow-interval = 40ms
_ timed-out-status = 124
_ kept-traces Size = 20
_ probe-variables [String] = ["PROBES_ENABLED", "PROBES_PATH", "PROBES_CONTROL_PATH"]

━━━━━━━━━━━━━━━━━━━━
+ ProbeRun

+ program String
+ arguments [String]
+ trace-path String?
+ catalog-path String?
+ timeout Seconds?
+ shows-lines = true
+ line-limit Size = 400
+ unmatched [String]
+ status Int
+ timed-out = false
+ is-finished = false
+ trace-error String?

_ child Process?
_ timer Task?
_ is-running = false

────────────────────
+ This
    - program String
    - arguments [String]

────────────────────
for sig on sig-term whenever #is-running

child?.terminate()

────────────────────
for sig on sig-int whenever #is-running

grace-period.wait()
if is-running
    child?.terminate()

────────────────────
+ do run Int ?! Error

. variables = environment()
for name in probe-variables
    -= variables[name]
if trace-path
    . trace = Path(trace-path)
    if trace.exists
        trace.delete()
    variables["PROBES_ENABLED"] = "1"
    variables["PROBES_PATH"] = trace-path!
    if catalog-path && Path(catalog-path).is-file
        write-file-atomically
            - Path(trace-sidecar(trace-path!, "probes.json"))
            - read-file-text(Path(catalog-path!))
. started = clock()
. spawned = Process(program, ProcessStderr.inherit, arguments) • variables variables • stdio-mode ProcessStdio.inherit
child = spawned
is-running = true
do new wait-for-exit(this, spawned)
if timeout
    timer = do new watch-timeout(timeout!)
. console = ProbeConsole(shows-lines, line-limit)
if trace-path
    follow-trace(trace-path, console)
else
    while !is-finished
        follow-interval.wait()
. elapsed = nanoseconds-since(started)
spawned.close()
if trace-path
    report(console, elapsed)
    . kept = Path(trace-sidecar(trace-path!, "probes.json"))
    if !Path(trace-path!).is-file && kept.is-file
        catch kept.delete()
=? timed-out-status if timed-out
= status

────────────────────
_ do follow-trace
    - path String
    - console ProbeConsole

. reader = TraceReader(path, true)
while !is-finished
    if !read-into(reader, console)
        =
    if !reader.advanced
        follow-interval.wait()
while true
    if !read-into(reader, console) || !reader.advanced
        break
if !Path(path).is-file
    trace-error = "the program wrote no trace; it has no probes compiled in (check the --probes selectors)"
else if !reader.is-done && !trace-error
    trace-error = "the program did not close its trace"

────────────────────
_ do read-into Bool
    - reader TraceReader
    - console ProbeConsole

. items = reader.read-available()
    catch error Error
        trace-error = error.message ?? "the trace could not be read"
        = false
for item in items
    console.observe(item)
= true

────────────────────
_ do report
    - console ProbeConsole
    - elapsed U64

. outcome = if timed-out then "timed out after $limit-text" else "exit $status"
    .. limit-text = duration-text(seconds-nanoseconds(timeout!))
stderr <- "── probes ── $outcome · ${duration-text(elapsed)} · ${count-text(console.records)} records\n"
for line in console.footer-lines()
    stderr <- "$line\n"
for selector in unmatched
    stderr <- "warning: --probes selector $selector matched no probe sites\n"
if trace-error
    stderr <- "warning: ${trace-error}\n"
=? if !Path(trace-path!).is-file
stderr <- "trace: ${trace-path!}\n"
stderr <- "query: yumi probes summary · log · agg --field F · durations · tree · timeline · outliers (yumi probes --help)\n"

────────────────────
_ do watch-timeout
    - limit Seconds

limit.wait()
=? if is-finished
timed-out = true
child?.terminate()
grace-period.wait()
=? if is-finished
child?.kill()

────────────────────
+ do finish
    - code Int

status = code
is-finished = true
is-running = false
timer?.cancel()

━━━━━━━━━━━━━━━━━━━━
_ do wait-for-exit
    - run ProbeRun
    - child Process

run.finish(child.wait(null) ?? 1)

━━━━━━━━━━━━━━━━━━━━
_ nanoseconds-since U64
    - started ClockTime

started.elapsed'Nanoseconds() as U64

━━━━━━━━━━━━━━━━━━━━
_ seconds-nanoseconds U64
    - value Seconds

(value as Nanoseconds) as U64

━━━━━━━━━━━━━━━━━━━━
+ do parse-timeout Seconds?
    - text String

. scale = 1.0
. number = text
if text.ends-with("ms")
    scale = 0.001
    number = text[0 .. < text.length - 2]
else if text.ends-with("s")
    number = text[0 .. < text.length - 1]
else if text.ends-with("m")
    scale = 60.0
    number = text[0 .. < text.length - 1]
=? null if number.length == 0
. dots = 0
for char in number
    if char == '.'
        dots += 1
    else if char < '0' || char > '9'
        = null
=? null if dots > 1 || number == "."
= ((number as F64) * scale) as Seconds

━━━━━━━━━━━━━━━━━━━━
+ do new-trace-path Path ?! Error
    - directory Path
    - name String

directory.make-directories()
prune-traces(directory)
. now = clock()
= directory / "${name}-${now.s}${((now.ns / 1000000) as Int).pad(3)}.trace"

━━━━━━━━━━━━━━━━━━━━
_ do prune-traces
    - directory Path

. traces [String]
for entry in directory.entries
    if entry.name.ends-with(".trace")
        traces += entry.name
=? if traces.length < kept-traces
. ordered = sort(traces) • using :: a, b => if trace-stamp(a) < trace-stamp(b) then .lesser else .greater
for index in 0 .. < ordered.length - kept-traces + 1
    . trace = (directory / ordered[index]) as String
    for path in [trace, trace-sidecar(trace, "probes.json"), trace-sidecar(trace, "run.json")]
        if Path(path).exists
            catch Path(path).delete()

━━━━━━━━━━━━━━━━━━━━
_ trace-stamp String
    - name String

"${if stamp.length < 20 then "0" * (20 - stamp.length) else ""}$stamp"

.. stem = if name.ends-with(".trace") then name[0 .. < name.length - 6] else name
.. dash = stem.find-reverse("-")
.. stamp = if dash then stem[dash + 1 ...] else stem

━━━━━━━━━━━━━━━━━━━━
+ trace-sidecar String
    - trace String
    - suffix String

"${stem}.$suffix"

.. stem = if trace.ends-with(".trace") then trace[0 .. < trace.length - 6] else trace

━━━━━━━━━━━━━━━━━━━━
_ do absolute String
    - path String

=? path if path == "" || path.starts-with("/")
. resolved = Path(path).resolved
    catch error Error
        = path
= resolved as String

━━━━━━━━━━━━━━━━━━━━
+ do write-last-run ?! Error
    - directory Path
    - run ProbeRun
    - code Int

. trace = absolute(run.trace-path ?? "")
=? if trace == "" || !Path(trace).is-file
. kept = trace-sidecar(trace, "probes.json")
. record = Map'String'JSON
    • "program" absolute(run.program) as JSON
. arguments [JSON]
for argument in run.arguments
    arguments += argument
record["arguments"] = arguments
record["trace"] = trace
record["catalog"] = if Path(kept).is-file then kept else absolute(run.catalog-path ?? "")
record["status"] = code as Int
record["timed-out"] = run.timed-out
. text = "${to-json(record as JSON)}\n"
write-file-atomically(Path(trace-sidecar(trace, "run.json")), text)
write-file-atomically(directory / "last.json", text)
