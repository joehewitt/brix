(import ./chat)
(import ./model)
(import /data/json)
(blank)
(prop + ai-task-create-tool _ (= "TaskCreate"))
(prop + ai-task-update-tool _ (= "TaskUpdate"))
(prop _ ai-task-tools _ (= (list "TaskCreate" "TaskUpdate" "TaskList" "TaskGet")))

(type + AITaskStatus (is Union)
  (variant pending)
  (variant active)
  (variant done)
)

(type + AITask (is Tuple)
  (prop + id String)
  (prop + subject String)
  (prop + status AITaskStatus)
)

(fn-expr + ai-is-task-call Bool
  (param call AIToolCallPart)
  (has ai-task-tools (. call tool-name))
)

(fn-do + ai-is-last-task-call Bool
  (param parts (list AIMessagePart))
  (param call AIToolCallPart)
  (let index (. parts length))
  (while (> index 0)
    (-= index 1)
    (if (= (| (: other AIToolCallPart)) ([] parts index))
      (return-if (== (. other call-id) (. call call-id)) (if (call ai-is-task-call other)))
    )
  )
  (return false)
)

(fn-do + ai-has-task-calls Bool
  (param parts (list AIMessagePart))
  (for (in part parts)
    (if (= (| (: call AIToolCallPart)) part)
      (return-if true (if (call ai-is-task-call call)))
    )
  )
  (return false)
)

(fn-do + ai-tasks (list AITask)
  (param messages (list AIChatMessage))
  (param message AIChatMessage)
  (param parts (list AIMessagePart))
  (let tasks (call (of List AITask)))
  (for (in earlier messages)
    (if (== (. earlier id) (. message id))
      (break)
    )
    (call ai-follow-tasks tasks (. earlier parts))
  )
  (call ai-follow-tasks tasks parts)
  (return (call ai-touched-tasks tasks parts))
)

(fn-do + ai-touched-tasks (list AITask)
  (param tasks (list AITask))
  (param parts (list AIMessagePart))
  (let ids (call (of Map String Bool)))
  (let subjects (call (of Map String Bool)))
  (for (in part parts)
    (if (= (| (: call AIToolCallPart)) part)
      (if (== (. call tool-name) ai-task-create-tool)
        (let number (call ai-task-number (call ai-task-output parts call)))
        (if number
          (= ([] ids number) true)
        )
        (let subject (call ai-argument (. call arguments) "subject"))
        (if subject
          (= ([] subjects subject) true)
        )
        (else-if (== (. call tool-name) ai-task-update-tool)
          (let id (call ai-argument (. call arguments) "taskId"))
          (if id
            (= ([] ids id) true)
          )
        )
      )
    )
  )
  (let touched (call (of List AITask)))
  (for (in task tasks)
    (if (or ([] ids (. task id)) ([] subjects (. task subject)))
      (+= touched task)
    )
  )
  (return touched)
)

(fn-do + ai-argument (? String)
  (param arguments JSON)
  (param name String)
  (let fields
    (match? arguments
      (case (map String JSON))
    )
  )
  (return-if null (if (not fields)))
  (for (in (tuple key value) fields)
    (if (== key name)
      (if (= (| (: text String)) value)
        (return text)
      )
    )
  )
  (return null)
)

(fn-do _ ai-follow-tasks _
  (param tasks (of List AITask))
  (param parts (list AIMessagePart))
  (for (in part parts)
    (if (= (| (: call AIToolCallPart)) part)
      (if (== (. call tool-name) ai-task-create-tool)
        (let subject (call ai-argument (. call arguments) "subject"))
        (if subject
          (let id (?? (call ai-task-number (call ai-task-output parts call)) (str (+ (. tasks length) 1))))
          (+= tasks (call AITask id subject (. AITaskStatus pending)))
        )
        (else-if (== (. call tool-name) ai-task-update-tool)
          (let id (call ai-argument (. call arguments) "taskId"))
          (if id
            (call ai-update-task
              (block
                (arg tasks)
                (arg id)
                (arg (call ai-argument (. call arguments) "status"))
                (arg (call ai-argument (. call arguments) "subject"))
              )
            )
          )
        )
      )
    )
  )
)

(fn-do _ ai-update-task _
  (param tasks (of List AITask))
  (param id String)
  (param status (? String))
  (param subject (? String))
  (for (in index (..< 0 (. tasks length)))
    (if (== (. ([] tasks index) id) id)
      (if (== status "deleted")
        (call (. tasks remove) index)
        (return)
      )
      (let task ([] tasks index))
      (= ([] tasks index) (call AITask id (?? subject (. task subject)) (?? (call ai-task-status status) (. task status))))
      (return)
    )
  )
)

(fn-expr _ ai-task-status (? AITaskStatus)
  (param status (? String))
  (case? (== status "completed")
    (. AITaskStatus done)
  )
  (case? (== status "in_progress")
    (. AITaskStatus active)
  )
  (case? (== status "pending")
    (. AITaskStatus pending)
  )
  (default
    null
  )
)

(fn-do _ ai-task-output String
  (param parts (list AIMessagePart))
  (param call AIToolCallPart)
  (for (in part parts)
    (if (= (| (: result AIToolResultPart)) part)
      (return-if (?? (. result text-output) "") (if (== (. result call-id) (. call call-id))))
    )
  )
  (return "")
)

(fn-expr _ ai-task-number (? String)
  (param text String)
  (case? (== start null)
    null
  )
  (case? (not (. number length))
    null
  )
  (default
    number
  )
  (where
    (lazy start (call (. text find) "#"))
    (lazy rest ([] text (... (+ start 1))))
    (lazy end (call (. rest find) " "))
    (lazy number (if-expr (!= end null) ([] rest (..< 0 end)) rest))
  )
)
