+ AIUsage is Tuple

+ input-tokens Size? = ai-usage-sum
    - cached-input-tokens
    - cache-creation-tokens
    - cache-read-tokens
    - tool-prompt-tokens
+ output-tokens Size? = ai-usage-sum(reasoning-tokens, thought-tokens)
+ total-tokens Size? = ai-usage-sum(input-tokens, output-tokens)
+ cached-input-tokens Size? = null
+ cache-creation-tokens Size? = null
+ cache-read-tokens Size? = null
+ reasoning-tokens Size? = null
+ thought-tokens Size? = null
+ tool-prompt-tokens Size? = null

━━━━━━━━━━━━━━━━━━━━
_ ai-usage-sum Size?
    - first Size?
    - second Size?
    - third Size? = null
    - fourth Size? = null

|? first is Size || second is Size || third is Size || fourth is Size
    (first ?? 0) + (second ?? 0) + (third ?? 0) + (fourth ?? 0)
??
    null

