━━━━━━━━━━━━━━━━━━━━
+ AIReply

+ parts [AIMessagePart]
+ usage = AIUsage()
+ finish-reason AIFinishReason?

────────────────────
+ do apply ?! AIError
    - event AIEvent

match event
    | begin AIPartBeginEvent
        . id = ai-part-id(begin.part)
        ?! AIError(AIErrorKind.invalid-response, "Duplicate AI part ID: $id")
            if ai-part-index(parts, id)
        parts += begin.part
    | delta AIPartDeltaEvent
        apply-ai-delta(parts, delta)
    | end AIPartEndEvent
        . index = ai-part-index(parts, ai-part-id(end.part))
        if index
            parts[index] = end.part
        else
            parts += end.part
    | changed AIUsageEvent
        usage = merge-ai-usage(usage, changed.usage)
    | done AIDoneEvent
        if done.usage
            usage = merge-ai-usage(usage, done.usage)
        finish-reason = done.finish-reason
    ?! AIError(AIErrorKind.invalid-response, "Unknown AI stream event")

━━━━━━━━━━━━━━━━━━━━
+ do complete ?! AIError
    - provider AIProvider
    - request AIRequest

. reply = AIReply()
for event in provider.stream(request)
    reply.apply(event)

. finish-reason = reply.finish-reason
?! AIError(AIErrorKind.invalid-response, "AI stream ended without a done event")
    if !finish-reason

. message = AIMessage(AIMessageRole.assistant, reply.parts)
. response = AIResponse(message, reply.usage, finish-reason)
if request.response-schema
    . decoded = match ai-final-text(reply.parts)
        ~ \json-text
        ?! AIError(AIErrorKind.invalid-response, "Structured AI response was not valid JSON")
    response.data = decoded

= response

━━━━━━━━━━━━━━━━━━━━
+ ai-response-text
    - response AIResponse

ai-parts-text(response.message.parts)

━━━━━━━━━━━━━━━━━━━━
+ ai-parts-text
    - parts [AIMessagePart]

"".join((each as AITextPart).text in parts when each is AITextPart)

━━━━━━━━━━━━━━━━━━━━
_ ai-final-text String
    - parts [AIMessagePart]

if texts.length > 0 then texts[texts.length - 1] else ""

.. texts = List'String((each as AITextPart).text in parts when each is AITextPart)

━━━━━━━━━━━━━━━━━━━━
+ ai-part-id
    - part AIMessagePart

match part
    | text AITextPart
        text.id
    | reasoning AIReasoningPart
        reasoning.id
    | search AIWebSearchPart
        search.id
    | file AIFilePart
        file.id
    | image AIImagePart
        image.id
    | audio AIAudioPart
        audio.id
    | video AIVideoPart
        video.id
    | tool-call AIToolCallPart
        tool-call.id
    | tool-result AIToolResultPart
        tool-result.id
    | refusal AIRefusalPart
        refusal.id
    | extension AIExtensionPart
        extension.id

━━━━━━━━━━━━━━━━━━━━
+ do ai-part-index Index?
    - parts [AIMessagePart]
    - id String

for index in 0 .. < parts.length
    if ai-part-id(parts[index]) == id
        = index
= null

━━━━━━━━━━━━━━━━━━━━
_ do apply-ai-delta ?! AIError
    - parts [AIMessagePart]
    - event AIPartDeltaEvent

. index = ai-part-index(parts, event.part-id)
?! AIError(AIErrorKind.invalid-response, "AI delta referenced unknown part ${event.part-id}")
    if !index

. part = parts[index]
if event.delta is AITextDelta && part is AITextPart
    . text = part as AITextPart
    text.text += (event.delta as AITextDelta).text
else if event.delta is AITextDelta && part is AIRefusalPart
    . refusal = part as AIRefusalPart
    refusal.text += (event.delta as AITextDelta).text
else if event.delta is AIReasoningDelta && part is AIReasoningPart
    . reasoning = part as AIReasoningPart
    reasoning.text += (event.delta as AIReasoningDelta).text
else if event.delta is AIToolArgumentsDelta && part is AIToolCallPart
    apply-ai-tool-delta(part, event.delta as AIToolArgumentsDelta)
else if event.delta is AIAudioDelta && part is AIAudioPart
    apply-ai-audio-delta(part, event.delta as AIAudioDelta)
else if event.delta is AIImageDelta && part is AIImagePart
    . image = part as AIImagePart
    image.image = (event.delta as AIImageDelta).image
else if event.delta is AIMediaProgressDelta && part is AIVideoPart
    . video = part as AIVideoPart
    video.video.progress = (event.delta as AIMediaProgressDelta).progress
else
    ?! AIError(AIErrorKind.invalid-response, "AI delta type did not match its part")

━━━━━━━━━━━━━━━━━━━━
_ do apply-ai-tool-delta
    - tool AIToolCallPart
    - delta AIToolArgumentsDelta

. previous = match tool.arguments
    | Null!
        ""
    | text String
        text
    ??
        to-json(tool.arguments)
. arrived = "$previous${delta.text}"
. decoded = match? arrived
    ~ \json-text
tool.arguments = decoded ?? arrived as JSON

━━━━━━━━━━━━━━━━━━━━
_ do apply-ai-audio-delta ?! AIError
    - audio AIAudioPart
    - delta AIAudioDelta

. source = audio.audio.file.source
?! AIError(AIErrorKind.invalid-response, "Audio delta requires an in-memory byte source")
    if source is not AIBytesSource
. previous = (source as AIBytesSource).data
. combined = Byte[previous.size + delta.data.size]
combined[0 .. < previous.size] = previous
combined[previous.size .. < combined.size] = delta.data
audio.audio.file.source = AIBytesSource(combined)

━━━━━━━━━━━━━━━━━━━━
_ merge-ai-usage
    - target AIUsage
    - update AIUsage

AIUsage
    • input-tokens update.input-tokens ?? target.input-tokens
    • output-tokens update.output-tokens ?? target.output-tokens
    • total-tokens update.total-tokens ?? target.total-tokens
    • cached-input-tokens update.cached-input-tokens ?? target.cached-input-tokens
    • cache-creation-tokens update.cache-creation-tokens ?? target.cache-creation-tokens
    • cache-read-tokens update.cache-read-tokens ?? target.cache-read-tokens
    • reasoning-tokens update.reasoning-tokens ?? target.reasoning-tokens
    • thought-tokens update.thought-tokens ?? target.thought-tokens
    • tool-prompt-tokens update.tool-prompt-tokens ?? target.tool-prompt-tokens
