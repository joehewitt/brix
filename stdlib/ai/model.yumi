━━━━━━━━━━━━━━━━━━━━
+ do ai-toolkits-context String?
    - toolkits [AIToolkit]
    - request AIRequest

. notes = List'String()
for kit in toolkits
    . note = kit.context(request)
    if note
        notes += note
=? null if !notes
= "\n\n".join(notes)

━━━━━━━━━━━━━━━━━━━━
+ do ai-toolkit-messages [AIMessage]
    - messages [AIMessage]
    - context String?

. transcript = List'AIMessage(messages)
=? transcript if !context
. index = transcript.length
while index > 0
    index -= 1
    . message = transcript[index]
    if message.role == AIMessageRole.user
        . parts = List'AIMessagePart()
        parts += AITextPart("toolkit-context", "${context}\n\n")
        parts ++= message.parts
        transcript[index] = AIMessage(message.role, parts, message.name)
        = transcript
= transcript

