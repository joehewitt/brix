(import ./model)
(import /data/json)
(blank)
(prop + ai-suggest-task-tool-name _ (= "suggest_task"))

(type + AISuggestedTask (is Tuple)
  (prop + id (? String))
  (prop + title String)
  (prop + summary String)
  (prop + prompt String)
  (prop + kind String (= "follow_up"))
  (prop + worktree String (= "new_from_main"))
  (prop + call-id (? String) (= null))
)

(fn-expr + ai-is-suggestion-call Bool
  (param call AIToolCallPart)
  (call ai-tool-matches-name (. call tool-name) ai-suggest-task-tool-name)
)

(fn-expr + ai-tool-matches-name Bool
  (param tool-name String)
  (param bare String)
  (or (== tool-name bare) (call (. tool-name ends-with) (str "__" bare)) (call (. tool-name ends-with) (str "_" bare)))
)

(fn-do + ai-suggested-task (? AISuggestedTask)
  (param call AIToolCallPart)
  (param result-id (? String) (= null))
  (return-if null (if (not (call ai-is-suggestion-call call))))
  (blank)
  (let fields
    (match? (. call arguments)
      (case (map String JSON))
    )
  )
  (return-if null (if (not fields)))
  (blank)
  (let title (call ai-suggestion-text ([] fields "title")))
  (let prompt (call ai-suggestion-text ([] fields "prompt")))
  (return-if null (if (or (not title) (not prompt))))
  (blank)
  (let summary (?? (call ai-suggestion-text ([] fields "summary")) ""))
  (let kind (?? (call ai-suggestion-text ([] fields "kind")) "follow_up"))
  (let worktree (?? (call ai-suggestion-text ([] fields "worktree_hint")) (call ai-suggestion-text ([] fields "worktree")) "new_from_main"))
  (return (call AISuggestedTask result-id title summary prompt kind worktree (. call call-id)))
)

(fn-do + ai-reply-suggestions (list AISuggestedTask)
  (param parts (list AIMessagePart))
  (let result-ids (call (of Map String String)))
  (for (in part parts)
    (if (= (| (: result AIToolResultPart)) part)
      (let parsed (call ai-suggestion-result-id result))
      (if parsed
        (= ([] result-ids (. result call-id)) parsed)
      )
    )
  )
  (let found (call (of List AISuggestedTask)))
  (for (in part parts)
    (if (= (| (: call AIToolCallPart)) part)
      (let task (call ai-suggested-task call ([] result-ids (. call call-id))))
      (if task
        (+= found task)
      )
    )
  )
  (return found)
)

(fn-expr + ai-suggest-task-instructions String
  (paragraph
    "<suggested-tasks>"
    (str "When you encounter concrete, well-scoped side work outside the user's current request — such as a real bug noticed in files you read, dead code, an orthogonal failure you intentionally left untouched, or a distinct follow-up phase the user deferred — call the " ai-suggest-task-tool-name " tool instead of derailing the current task.")
    "Most turns should suggest zero tasks. Never invent generic hygiene like 'add tests' or 'update docs', never suggest work that belongs inside the user's current request (do that work instead), and suggest at most 2 tasks per turn unless asked for a broader audit."
    "Make each prompt self-contained with exact file paths, symbols, evidence, and acceptance criteria so a fresh chat can execute it cold. The UI renders an interactive task card directly in the chat and sidebar for each suggestion, so do not repeat or summarize its title, summary, prompt, ID, kind, worktree hint, or status in your reply."
    "</suggested-tasks>"
  )
)

(fn-do _ ai-suggestion-result-id (? String)
  (param result AIToolResultPart)
  (let from-output (call ai-suggestion-id-from-json (. result output)))
  (return-if from-output (if from-output))
  (let text (. result text-output))
  (return-if null (if (or (not text) (== (. text length) 0))))
  (return (call ai-suggestion-id-from-text text))
)

(fn-do _ ai-suggestion-id-from-json (? String)
  (param value (? JSON))
  (return-if null (if (not value)))
  (if (= (| (: fields (map String JSON))) value)
    (let direct (call ai-suggestion-text ([] fields "id")))
    (return-if direct (if direct))
    (let content ([] fields "content"))
    (return-if (call ai-suggestion-id-from-json content) (if content))
    (let text (call ai-suggestion-text ([] fields "text")))
    (return-if (call ai-suggestion-id-from-text text) (if text))
    (return null)
  )
  (if (= (| (: items (list JSON))) value)
    (for (in item items)
      (let found (call ai-suggestion-id-from-json item))
      (return-if found (if found))
    )
    (return null)
  )
  (if (= (| (: text String)) value)
    (return (call ai-suggestion-id-from-text text))
  )
  (return null)
)

(fn-do _ ai-suggestion-id-from-text (? String)
  (param text String)
  (let parsed (catch? (call parse-json text)))
  (if (= (| (: fields (map String JSON))) parsed)
    (return (call ai-suggestion-text ([] fields "id")))
  )
  (return null)
)

(fn-expr _ ai-suggestion-text (? String)
  (param value (? JSON))
  (match? value
    (case (all (: text String) ({} (> (. (call (. it trim)) length) 0)))
      (call (. text trim))
    )
  )
)
