./media
./model
/core/channel
/graphics/canvas
/graphics/color
/graphics/image
/graphics/primitives
/math

+ ai-sheet-guide = RGBA("#9dbcf2")

_ ai-sheet-margin = 32.0
_ ai-sheet-gutter = 24.0
_ ai-sheet-crop-inset = 6.0
_ ai-sheet-close = 1.01
_ ai-sheet-ring Index = 10
_ ai-sheet-guide-band Index = 16
_ ai-sheet-veil-margin = 0.05
_ ai-sheet-canvases = [AISheetCanvas(1024, 1024), AISheetCanvas(1536, 1024), AISheetCanvas(1024, 1536)]

━━━━━━━━━━━━━━━━━━━━
_ AISheetCanvas is (width F64, height F64)

━━━━━━━━━━━━━━━━━━━━
+ AISheet is Tuple

+ width F64
+ height F64
+ columns Size
+ rows Size
+ count Size
+ cell-width F64
+ cell-height F64
+ padding F64 = 0

────────────────────
+ get aspect-ratio AIAspectRatio

|? width > height
    AIAspectRatio.landscape
|? width < height
    AIAspectRatio.portrait
??
    AIAspectRatio.square

────────────────────
+ get grid-name String

"${columns}×$rows grid"

────────────────────
+ cell Rect
    - index Index

Rect
    - left + column * (cell-width + ai-sheet-gutter)
    - top + row * (cell-height + ai-sheet-gutter)
    - cell-width
    - cell-height

.. column = (index % columns) as F64
.. row = (index / columns) as F64
.. left = (width - (columns as F64) * cell-width - ((columns - 1) as F64) * ai-sheet-gutter) / 2
.. top = (height - (rows as F64) * cell-height - ((rows - 1) as F64) * ai-sheet-gutter) / 2

────────────────────
+ live Rect
    - index Index

cell(index).pad(min(cell-width, cell-height) * padding)

────────────────────
+ crop Rect
    - index Index

Rect
    - left
    - top
    - floor(box.x + box.width - ai-sheet-crop-inset) - left
    - floor(box.y + box.height - ai-sheet-crop-inset) - top

.. box = cell(index)
.. left = ceil(box.x + ai-sheet-crop-inset)
.. top = ceil(box.y + ai-sheet-crop-inset)

────────────────────
+ cell-name String
    - index Index

"row ${index / columns + 1}, column ${index % columns + 1}"

━━━━━━━━━━━━━━━━━━━━
+ AIPainted is Tuple

+ image AIImage?
+ failure String?

━━━━━━━━━━━━━━━━━━━━
+ do ai-sheet AISheet
    - count Size
    - aspect F64 = 1
    - padding F64 = 0

. best AISheet? = null
for canvas in ai-sheet-canvases
    for columns in 1 .. max(count, 1)
        . made = ai-sheet-fit(canvas, columns, max(count, 1), aspect, padding)
        if !best || ai-sheet-beats(made, best)
            best = made
= best!

━━━━━━━━━━━━━━━━━━━━
+ ai-shape-aspect F64
    - ratio AIAspectRatio

match ratio
    | AIAspectRatio.landscape
        1.5
    | AIAspectRatio.portrait
        2.0 / 3.0
    ??
        1.0

━━━━━━━━━━━━━━━━━━━━
+ do ai-sheet-template AIImage ?! Error
    - sheet AISheet
    - cells [Index = Image] = Map'Index'Image()
    - is-clear = false

. canvas = use RasterCanvas(sheet.width as I32, sheet.height as I32)
canvas.stroke-color = null
if !is-clear
    canvas.fill-color = RGBA(1, 1, 1)
    canvas.rect(Rect(0, 0, sheet.width, sheet.height))
canvas.fill-color = null
canvas.stroke-color = ai-sheet-guide
for index in 0 .. < sheet.count
    canvas.stroke-width = 3
    canvas.stroke-dash = 0
    canvas.rect(sheet.cell(index).pad(1.5))
    if sheet.padding > 0
        canvas.stroke-width = 2
        canvas.stroke-dash = 10
        canvas.rect(sheet.live(index))
for index, image in cells
    image.draw(canvas, ai-sheet-fitted(image.size, sheet.crop(index)))
. bytes = canvas.encode-png()
= AIImage(AIFile(AIBytesSource(bytes), ai-format-png), sheet.width as Size, sheet.height as Size)

━━━━━━━━━━━━━━━━━━━━
+ do ai-sheet-crop RasterCanvas
    - sheet AISheet
    - painted Image
    - index Index

. crop = sheet.crop(index)
. canvas = RasterCanvas(crop.width as I32, crop.height as I32)
painted.draw(canvas, Rect(-crop.x, -crop.y, sheet.width, sheet.height))
= canvas

━━━━━━━━━━━━━━━━━━━━
+ do ai-sheet-slices [AIImage] ?! Error
    - sheet AISheet
    - painted Image
    - is-clear = false

. slices = List'AIImage()
for index in 0 .. < sheet.count
    . canvas = use ai-sheet-crop(sheet, painted, index)
    if is-clear
        ai-sheet-clean(canvas)
    . bytes = canvas.encode-png()
    . crop = sheet.crop(index)
    slices += AIImage
        - AIFile(AIBytesSource(bytes), ai-format-png)
        - crop.width as Size
        - crop.height as Size
= slices

━━━━━━━━━━━━━━━━━━━━
+ do ai-sheet-clean
    - canvas RasterCanvas

. width = canvas.pixel-width as Index
. height = canvas.pixel-height as Index
. bytes = canvas.premultiplied-pixels()
. counts = List'Size((0 as Size) in 0 .. < 256)
. ring Size = 0
for y in 0 .. < height
    for x in 0 .. < width
        if ai-sheet-near(x, y, width, height, ai-sheet-ring)
            counts[bytes[(y * width + x) * 4 + 3]] += 1
            ring += 1
=? if ring == 0
. median = ai-sheet-quantile(counts, ring, 0.5)
. veil = if median < 0.5 then min(0.9, upper-quantile + ai-sheet-veil-margin) else 0.0
    .. upper-quantile = ai-sheet-quantile(counts, ring, 0.9)
for y in 0 .. < height
    for x in 0 .. < width
        . at = (y * width + x) * 4
        . alpha = (bytes[at + 3] as F64) / 255
        if alpha > 0
            . red = (bytes[at] as F64) / 255 / alpha
            . green = (bytes[at + 1] as F64) / 255 / alpha
            . blue = (bytes[at + 2] as F64) / 255 / alpha
            . is-guide = near-guide && blue > red + 0.12 && blue > green + 0.02 && red > 0.35
                .. near-guide = ai-sheet-near(x, y, width, height, ai-sheet-guide-band)
            . kept = if is-guide then 0.0 else max(0.0, min(1.0, (alpha - veil) / (1 - veil)))
            if kept != alpha
                bytes[at] = round(min(1.0, red) * kept * 255) as Byte
                bytes[at + 1] = round(min(1.0, green) * kept * 255) as Byte
                bytes[at + 2] = round(min(1.0, blue) * kept * 255) as Byte
                bytes[at + 3] = round(kept * 255) as Byte
canvas.write-premultiplied-pixels(bytes)

━━━━━━━━━━━━━━━━━━━━
_ ai-sheet-near Bool
    - x Index
    - y Index
    - width Index
    - height Index
    - band Index

x < band || y < band || x + band >= width || y + band >= height

━━━━━━━━━━━━━━━━━━━━
_ do ai-sheet-quantile F64
    - counts [Size]
    - total Size
    - fraction F64

. wanted = ((total as F64) * fraction) as Size
. seen Size = 0
for level in 0 .. < counts.length
    seen += counts[level]
    =? (level as F64) / 255 if seen > wanted
= 1.0

━━━━━━━━━━━━━━━━━━━━
+ ai-decode-painted Image ?! Error
    - image AIImage

?! Error("The painted image has no bytes")
    if source is not AIBytesSource

decode-image((source as AIBytesSource).data)

.. source = image.file.source

━━━━━━━━━━━━━━━━━━━━
+ do ai-paint AIImage ?! Error
    - painter AIProvider
    - request AIRequest

. response = painter.complete(request)
for part in response.message.parts
    if | made AIImagePart = part
        = made.image
?! AIError(AIErrorKind.invalid-response, "The image service returned no image")

━━━━━━━━━━━━━━━━━━━━
+ do ai-paint-all [AIPainted] ?! Error
    - painter AIProvider
    - requests [AIRequest]

. results SyncBufferedChannel'AIIndexedPainted
for index in 0 .. < requests.length
    . request = requests[index]
    do new
        results <- AIIndexedPainted(index, ai-paint-caught(painter, request))
. painted = List'AIPainted(AIPainted(null, null) in requests)
for _ in 0 .. < requests.length
    . got = <- results
    ?! AIError(AIErrorKind.cancellation, "Image generation was canceled")
        if !got
    painted[got.index] = got.painted
= painted

━━━━━━━━━━━━━━━━━━━━
_ AIIndexedPainted is (index Index, painted AIPainted)

━━━━━━━━━━━━━━━━━━━━
_ do ai-paint-caught AIPainted
    - painter AIProvider
    - request AIRequest

. outcome = catch ai-paint(painter, request)
if | failure Error = outcome
    = AIPainted(null, failure.message)
= AIPainted(outcome as AIImage, null)

━━━━━━━━━━━━━━━━━━━━
_ ai-sheet-fit AISheet
    - canvas AISheetCanvas
    - columns Size
    - count Size
    - aspect F64
    - padding F64

AISheet(canvas.width, canvas.height, columns, rows, count, wide, wide / aspect, padding)

.. rows = (count + columns - 1) / columns
.. across = (canvas.width - ai-sheet-margin * 2 - ((columns - 1) as F64) * ai-sheet-gutter) / (columns as F64)
.. down = (canvas.height - ai-sheet-margin * 2 - ((rows - 1) as F64) * ai-sheet-gutter) / (rows as F64)
.. wide = floor(min(across, down * aspect))

━━━━━━━━━━━━━━━━━━━━
_ ai-sheet-beats Bool
    - made AISheet
    - best AISheet

|? area > held * ai-sheet-close
    true
|? area * ai-sheet-close < held
    false
??
    made.columns * made.rows < best.columns * best.rows

.. area = made.cell-width * made.cell-height
.. held = best.cell-width * best.cell-height

━━━━━━━━━━━━━━━━━━━━
_ ai-sheet-fitted Rect
    - size Dimensions
    - box Rect

|? size.width <= 0 || size.height <= 0
    box
??
    Rect(box.x + (box.width - wide) / 2, box.y + (box.height - tall) / 2, wide, tall)

.. scale = min(box.width / size.width, box.height / size.height)
.. wide = size.width * scale
.. tall = size.height * scale
