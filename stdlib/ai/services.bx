(import /ai)
(import /ai/claude)
(import /ai/codex)
(import /ai/imaging)
(import /ai/openai/completions)
(import /ai/openai/images)
(import /ai/openai/namer)
(import /ai/openai/responses)
(import /net/url)
(import /os/env)
(import /os/path)
(blank)
(prop + ai-default-image-model _ (= "gpt-image-2.5-flare"))
(prop _ ai-naming-effort _ (= "low"))
(prop _ ai-codex-reviewer _ (= "auto_review"))
(prop _ ai-codex-summary _ (= "auto"))
(prop _ ai-task-reminder _ (= "For work with several steps, keep a task list the person can see: create a task for each step with TaskCreate, loading it with ToolSearch first if it is deferred, and keep each task current with TaskUpdate as you work."))

(type + AIChatAgent (is Union)
  (variant claude)
  (variant codex)
  (variant openai)
)

(type + AIChatVariables (is (fn-type (? (map String String)))))

(type + AIChatSetup (is Tuple)
  (prop + agents _ (= (call (of List AIChatAgent) (list (. AIChatAgent claude) (. AIChatAgent codex) (. AIChatAgent openai)))))
  (prop + working-directory (? String) (= null))
  (prop + instructions (? String) (= null))
  (prop + suffix _ (= ""))
  (prop + effort (? String) (= null))
  (prop + images (? AIImageStore) (= null))
  (prop + drawing (? AIImageToolkit) (= null))
  (prop + toolkits _ (= (call (of List AIToolkit))))
  (prop + variables (? AIChatVariables) (= null))
  (prop + claude-model _ (= claude-default-model))
  (prop + mcp-servers _ (= (call (of List ClaudeMCPServer))))
  (prop + permission-mode _ (= "auto"))
  (prop + has-task-tools _ (= true))
  (prop + sandbox _ (= "workspace-write"))
  (prop + approval-policy _ (= "on-request"))
)

(type + AIChatAccounts
  (prop + claude AIAccess)
  (prop + codex AIAccess)
  (prop + openai AIAccess)
  (prop + titler OpenAIResponses)
  (prop + painter OpenAIImages)
  (blank)
  (prop _ endpoint URL)
  (prop _ responders _ (= (call (of List OpenAIResponses))))
  (fn-do + This _
    (param path Path)
    (let store (call AIAccessStore path))
    (= claude (call AIAccess store "claude-code" (. AIAccessKind approval) "Claude Code" "claude auth login"))
    (= codex (call AIAccess store "codex" (. AIAccessKind approval) "Codex" "codex login"))
    (= openai (call AIAccess store "openai" (. AIAccessKind api-key) "OpenAI" (:variable "OPENAI_API_KEY")))
    (let key (?? (. openai key) ""))
    (let base (call env "OPENAI_BASE_URL"))
    (= endpoint (if-expr base (call URL base) openai-api-base))
    (= titler (call OpenAIResponses key endpoint (:reasoning-effort ai-naming-effort)))
    (= painter (call OpenAIImages key endpoint))
  )
  (subscribe-for (on key (. openai keyed))
    (= (. titler api-key) key)
    (= (. painter api-key) key)
    (for (in each responders)
      (= (. each api-key) key)
    )
  )
  (fn-do + responder OpenAIResponses
    (param effort String)
    (let made (call OpenAIResponses (?? (. openai key) "") endpoint (:reasoning-effort effort)))
    (+= responders made)
    (return made)
  )
)

(fn-expr + ai-image-model String
  (?? (call env "OPENAI_IMAGE_MODEL") ai-default-image-model)
)

(fn-do + ai-chat-services (list AIChatService)
  (param accounts AIChatAccounts)
  (param setup _ (= (call AIChatSetup)))
  (let drawing (call ai-chat-drawing accounts setup))
  (let toolkits (call (of List AIToolkit) (. setup toolkits)))
  (+= toolkits (call AIQuestionToolkit))
  (let hosted (call (of List AIToolkit)))
  (if drawing
    (+= hosted drawing)
  )
  (++= hosted toolkits)
  (let services (call (of List AIChatService)))
  (for (in agent (. setup agents))
    (+= services (call ai-chat-service accounts setup agent drawing toolkits hosted))
  )
  (return services)
)

(fn-do _ ai-chat-drawing (? AIImageToolkit)
  (param accounts AIChatAccounts)
  (param setup AIChatSetup)
  (let images (. setup images))
  (let drawing (?? (. setup drawing) (only-if (call AIImageToolkit (. accounts painter) images (call ai-image-model)) (if images))))
  (return-if null (if (not drawing)))
  (= (. drawing access) (. accounts openai))
  (return drawing)
)

(fn-do _ ai-chat-service AIChatService
  (param accounts AIChatAccounts)
  (param setup AIChatSetup)
  (param agent AIChatAgent)
  (param drawing (? AIImageToolkit))
  (param toolkits (list AIToolkit))
  (param hosted (list AIToolkit))
  (let suffix (. setup suffix))
  (match agent
    (case (. AIChatAgent claude)
      (let claude (call ai-chat-claude setup hosted))
      (return (call AIChatService (str claude-default-model suffix) "Claude" claude (. setup claude-model) (:instructions (. setup instructions)) (:namer (call claude-chat-namer claude)) (:reminder (only-if ai-task-reminder (if (. setup has-task-tools)))) (:access (. accounts claude)) (:icon (. AIServiceIcon claude)) (:tool-access (. accounts openai))))
    )
    (case (. AIChatAgent codex)
      (let codex (call ai-chat-codex setup hosted))
      (return (call AIChatService (str "codex" suffix) "Codex" codex codex-default-model (:instructions (. setup instructions)) (:namer (call codex-chat-namer codex)) (:access (. accounts codex)) (:icon (. AIServiceIcon codex)) (:tool-access (. accounts openai))))
    )
    (case (. AIChatAgent openai)
      (let painting
        (call AIImagingProvider
          (block
            (arg (call (. accounts responder) (?? (. setup effort) openai-default-effort)))
            (arg drawing)
          )
        )
      )
      (++= (. painting toolkits) toolkits)
      (return (call AIChatService (str "openai" suffix) "ChatGPT" painting openai-default-model (:instructions (. setup instructions)) (:namer (call openai-chat-namer (. accounts titler))) (:access (. accounts openai)) (:icon (. AIServiceIcon openai)) (:tool-access (. accounts openai))))
    )
  )
)

(fn-expr _ ai-chat-claude ClaudeCode
  (param setup AIChatSetup)
  (param toolkits (list AIToolkit))
  (call ClaudeCode
    (block
      (:working-directory (. setup working-directory))
      (:permission-mode (. setup permission-mode))
      (:has-task-tools (. setup has-task-tools))
      (:effort (?? (. setup effort) claude-default-effort))
      (:variables (. setup variables))
      (:mcp-servers (. setup mcp-servers))
      (:toolkits toolkits)
    )
  )
)

(fn-expr _ ai-chat-codex Codex
  (param setup AIChatSetup)
  (param toolkits (list AIToolkit))
  (call Codex
    (block
      (:working-directory (. setup working-directory))
      (:sandbox (. setup sandbox))
      (:approval-policy (. setup approval-policy))
      (:approvals-reviewer ai-codex-reviewer)
      (:effort (?? (. setup effort) codex-default-effort))
      (:reasoning-summary ai-codex-summary)
      (:variables (. setup variables))
      (:toolkits toolkits)
    )
  )
)
