(import ./chat)
(import ./database)
(import ./model)
(import ./session)
(import /stream/aggregate)
(import /sys/random.h)

(type + AIChatStore
  (prop + services (list AIChatService))
  (prop + database (? AIChatDatabase))
  (prop + owner (? String))
  (prop + project (? String))
  (prop + sessions (list AIChatSession))
  (prop + active AIChatSession)
  (prop + error (? String))
  (prop + revision U64)
  (fn-do + This _
    (param services _)
    (param database (? AIChatDatabase) (= null))
    (param owner (? String) (= null))
    (param project (? String) (= null))
    (call open-database)
    (= active (call create-session (call starting-service)))
  )
  (fn-do + new-session _
    (param service (? AIChatService) (= null))
    (let chosen (?? service (. active service)))
    (if (or (not (. active is-empty)) (!= (. active service) chosen))
      (= active (call create-session chosen))
    )
    (return active)
  )
  (fn-do + select _
    (param session AIChatSession)
    (if (not (. session is-loaded))
      (call load session)
    )
    (return-if (if (not (. session is-loaded))))
    (= active session)
  )
  (fn-do + summon (? AIChatSession)
    (param id String)
    (for (in session sessions)
      (return-if session (if (== (. session chat id) id)))
    )
    (let summary (catch? (call (?. database load-summary) id)))
    (return-if null (if (not summary)))
    (let session (call saved-session summary))
    (+= sessions session)
    (+= revision 1)
    (return session)
  )
  (fn-do + mark-done _
    (param session AIChatSession)
    (param is-done Bool)
    (let marks (. session document marks))
    (= (. session document marks) (call AIChatMarks (. marks seen-at) (only-if (call ai-chat-now) (if is-done)) (. marks archived-at)))
    (+= revision 1)
    (let target database)
    (return-if (if (not target)))
    (call (. target mark-done) (. session chat id) is-done
      (block
        (on-error (: failure Error)
          (= error (str (?? (. session title) (. session chat id)) " could not be marked: " failure))
        )
      )
    )
  )
  (fn-do + mark-archived _
    (param session AIChatSession)
    (param is-archived Bool)
    (let marks (. session document marks))
    (= (. session document marks)
      (scope (if-expr is-archived archived-marks (call AIChatMarks (. marks seen-at)))
        (lazy archived-marks (call AIChatMarks (. marks seen-at) (. marks done-at) (call ai-chat-now)))
      )
    )
    (+= revision 1)
    (let target database)
    (return-if (if (not target)))
    (call (. target mark-archived) (. session chat id) is-archived
      (block
        (on-error (: failure Error)
          (= error (str (?? (. session title) (. session chat id)) " could not be archived: " failure))
        )
      )
    )
  )
  (fn-do + delete _
    (param session AIChatSession)
    (let id (. session chat id))
    (if (. session is-busy)
      (call (. session stop)
        (block
          (on-error (: failure Error)
            (= error (str (?? (. session title) id) " could not be stopped: " failure))
          )
        )
      )
    )
    (for (in index (..< 0 (. sessions length)))
      (if (== (. ([] sessions index) chat id) id)
        (call (. sessions remove) index)
        (break)
      )
    )
    (if (== (. active chat id) id)
      (= active (call create-session (. active service)))
    )
    (+= revision 1)
    (let target database)
    (return-if (if (not target)))
    (call (. target delete) id
      (block
        (on-error (: failure Error)
          (= error (str (?? (. session title) id) " could not be deleted: " failure))
        )
      )
    )
  )
  (fn-do + see _
    (param session AIChatSession)
    (let document (. session document))
    (return-if (if (not (call chat-is-unread (. document activity) (. document marks)))))
    (let at (call ai-chat-now))
    (let marks (. document marks))
    (= (. document marks) (call AIChatMarks at (. marks done-at) (. marks archived-at)))
    (+= revision 1)
    (let target database)
    (return-if (if (not target)))
    (call (. target see) (. session chat id) at
      (block
        (on-error (: failure Error)
          (= error (str (?? (. session title) (. session chat id)) " could not be saved: " failure))
        )
      )
    )
  )
  (fn-do _ create-session _
    (param service AIChatService)
    (let session (call adopt (call AIChat (call ai-chat-id)) service))
    (call (. sessions insert) session 0)
    (+= revision 1)
    (return session)
  )
  (fn-do _ adopt _
    (param chat AIChat)
    (param service AIChatService)
    (let session (call AIChatSession chat service))
    (for (on _ (. session document committed))
      (+= revision 1)
      (call save session)
    )
    (for (on progress (. session document progressed))
      (call save-progress session progress)
    )
    (return session)
  )
  (fn-do _ starting-service _
    (if (. sessions length)
      (for (in service services)
        (return-if service (if (== service (. ([] sessions 0) service))))
      )
    )
    (return ([] services 0))
  )
  (fn-do _ service-for _
    (param id (? String))
    (return-if ([] services 0) (if (== id null)))
    (for (in service services)
      (return-if service (if (== (. service id) id)))
    )
    (return (call AIChatService id id (call AIMissingProvider id) ""))
  )
  (fn-do _ open-database _
    (let source database)
    (return-if (if (not source)))
    (let summaries
      (call (. source load-index) owner
        (block
          (on-error (: failure Error)
            (= error (str "Saved chats could not be read: " failure))
            (= database null)
            (return)
          )
        )
      )
    )
    (for (in summary summaries)
      (+= sessions (call saved-session summary))
    )
    (for (on summary (. source changed))
      (call follow summary)
    )
  )
  (fn-do _ saved-session _
    (param summary AIChatSummary)
    (let session (call adopt (call AIChat (. summary id) "root" (. summary title)) (call service-for (. summary service))))
    (= (. session document branches) (. summary branches))
    (= (. session document is-empty) false)
    (= (. session document is-loaded) false)
    (= (. session document activity) (. summary activity))
    (= (. session document marks) (. summary marks))
    (return session)
  )
  (fn-do _ follow _
    (param summary AIChatSummary)
    (let held (call first (in each sessions (when (== (. each chat id) (. summary id))))))
    (if (and (== (. summary owner) owner) held)
      (= (. held document marks) (. summary marks))
      (+= revision 1)
      (else-if (and (== (. summary owner) owner) (== (. summary marks archived-at) null))
        (call (. sessions insert) (call saved-session summary) 0)
        (+= revision 1)
      )
      (else-if (and (!= (. summary owner) owner) held)
        (for (in index (..< 0 (. sessions length)))
          (if (== (. ([] sessions index) chat id) (. summary id))
            (call (. sessions remove) index)
            (break)
          )
        )
        (if (== (. active chat id) (. summary id))
          (= active (call create-session (. active service)))
        )
        (+= revision 1)
      )
    )
  )
  (fn-do _ load _
    (param session AIChatSession)
    (let source database)
    (return-if (if (not source)))
    (let saved
      (call (. source load) (. session chat id)
        (block
          (on-error (: failure Error)
            (= error (str (?? (. session title) (. session chat id)) " could not be opened: " failure))
            (return)
          )
        )
      )
    )
    (call (. session document restore) saved
      (block
        (on-error (: failure Error)
          (= error (str (?? (. session title) (. session chat id)) " could not be opened: " failure))
          (return)
        )
      )
    )
    (= error null)
    (+= revision 1)
    (do-new
      (call (. session catch-up))
    )
  )
  (fn-do _ save _
    (param session AIChatSession)
    (let target database)
    (return-if (if (not target)))
    (call (. target save) (call (. session document saved-chat)) (. session service id) owner (not (. session is-empty)) (:project project)
      (block
        (on-error (: failure Error)
          (= error (str (?? (. session title) (. session chat id)) " could not be saved: " failure))
          (return)
        )
      )
    )
    (= error null)
  )
  (fn-do _ save-progress _
    (param session AIChatSession)
    (param progress AIChatProgress)
    (let target database)
    (return-if (if (not target)))
    (let is-saved
      (call (. target save-progress) (. session chat id) progress
        (block
          (on-error (: failure Error)
            (= error (str (?? (. session title) (. session chat id)) " could not be saved: " failure))
            (return)
          )
        )
      )
    )
    (if (not is-saved)
      (call save session)
    )
  )
)

(fn-do + ai-chat-id String
  (let bytes ([] Byte 8))
  (call C:getentropy bytes 8)
  (let hex String (as bytes Hex))
  (return (str "chat-" hex))
)

(type _ AIMissingProvider (is AIProvider)
  (prop + name String)
  (fn-do + This _
    (param name _)
    (call super)
  )
  (fn-do + stream (stream AIEvent)
    (param request AIRequest)
    (if false
      (yield (call AIDoneEvent (. AIFinishReason error) (call AIUsage)))
    )
    (throw (call AIError (. AIErrorKind invalid-request) (str "This chat began with " name ", which is not set up here")))
  )
)
