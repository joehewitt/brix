(import ./media)
(import ./model)
(import ./questions)
(import /stream/aggregate)
(import /stream/combine)
(import /time/datetime)
(import /time/duration)
(import /time/timestamp)
(import /time/zone)
(blank)
(prop _ ai-chat-title-limit Size (= 40))

(type + AIChatMessage
  (prop + id String)
  (prop + role AIMessageRole)
  (prop + parts (list AIMessagePart))
  (prop + created-at Timestamp)
  (prop + model (? String))
  (prop + usage (? AIUsage))
  (prop + finish-reason (? AIFinishReason))
  (prop + error (? AIError))
  (prop + elapsed (? Duration))
  (fn-do + This _
    (param id _)
    (param role _)
    (param parts (list AIMessagePart))
    (param created-at _)
    (param model (? String) (= null))
    (param usage (? AIUsage) (= null))
    (param finish-reason (? AIFinishReason) (= null))
  )
  (fn-do + This _
    (param id _)
    (param role _)
    (param text String)
    (param created-at _)
    (param images (list AIImage) (= (call (of List AIImage))))
    (lazy parts (call ai-prompt-parts id text images))
  )
  (fn-expr + joins-request _ :get
    (and (not error) (> (. parts length) 0))
  )
)

(type + AIChatProgress (is Tuple)
  (prop + message AIChatMessage)
  (prop + part (? Index))
)

(type + AIChatBranch
  (prop + id String)
  (prop + parent-branch-id (? String))
  (prop + fork-message-id (? String))
  (prop + messages (list AIChatMessage))
  (prop + forks _ (= false))
  (prop + is-collapsed _ (= false))
  (blank)
  (prop _ shared-prefix (list AIChatMessage))
  (fn-do + This _
    (param id _)
    (param parent-branch-id (? String) (= null))
    (param fork-message-id (? String) (= null))
    (param shared-prefix (list AIChatMessage) (= (call (of List AIChatMessage))))
    (param forks _ (= false))
    (param is-collapsed _ (= false))
    (= (. this shared-prefix) (call copy-chat-messages shared-prefix))
  )
  (fn-expr + shared-messages _ :get
    shared-prefix
  )
  (fn-do _ This _
    (param branch AIChatBranch)
    (= id (. branch id))
    (= parent-branch-id (. branch parent-branch-id))
    (= fork-message-id (. branch fork-message-id))
    (= forks (. branch forks))
    (= is-collapsed (. branch is-collapsed))
    (lazy shared-prefix (call copy-chat-messages (. branch shared-prefix)))
    (lazy messages (call copy-chat-messages (. branch messages)))
  )
)

(type + AIChat
  (prop + id String)
  (prop + title (? String))
  (prop + root-branch-id String)
  (prop + branches (list AIChatBranch))
  (prop + is-kept _ (= false))
  (fn-do + This _
    (param id _)
    (param root-branch-id _ (= "root"))
    (param title (? String) (= null))
    (lazy branches
      (block
        (item (call AIChatBranch root-branch-id))
      )
    )
  )
  (fn-do _ This _
    (param chat AIChat)
    (= id (. chat id))
    (= title (. chat title))
    (= root-branch-id (. chat root-branch-id))
    (= is-kept (. chat is-kept))
    (lazy branches (in (call AIChatBranch each) (. chat branches)))
  )
)

(type + AIChatBranchSummary (is Tuple)
  (prop + id String)
  (prop + parent-branch-id (? String))
  (prop + title (? String))
  (prop + is-collapsed Bool)
)

(type + AIChatOutcome (is Union)
  (variant asks)
  (variant failed)
)

(type + AIChatPlace (is Union)
  (variant active)
  (variant done)
  (variant archived)
)

(type + AIChatActivity (is Tuple)
  (prop + sent-at (? Int) (= null))
  (prop + replied-at (? Int) (= null))
  (prop + active-at (? Int) (= null))
  (prop + outcome (? AIChatOutcome) (= null))
)

(type + AIChatMarks (is Tuple)
  (prop + seen-at (? Int) (= null))
  (prop + done-at (? Int) (= null))
  (prop + archived-at (? Int) (= null))
)

(fn-do + chat-activity AIChatActivity
  (param chat AIChat)
  (let sent (? Int) null)
  (let replied (? Int) null)
  (for (in branch (. chat branches))
    (let has-sent false)
    (let has-replied false)
    (let index (. branch messages length))
    (while (and (> index 0) (not (and has-sent has-replied)))
      (-= index 1)
      (let message ([] (. branch messages) index))
      (if (and (== (. message role) (. AIMessageRole user)) (not has-sent))
        (= has-sent true)
        (= sent (call ai-later sent (call ai-chat-time (. message created-at))))
        (else-if (and (== (. message role) (. AIMessageRole assistant)) is-finished (not has-replied))
          (= has-replied true)
          (= replied (call ai-later replied (call chat-reply-time message)))
        )
      )
      (lazy is-finished (!= (. message finish-reason) null))
    )
  )
  (return (call AIChatActivity sent replied (call ai-later sent replied) (call chat-outcome chat)))
)

(fn-expr + chat-outcome (? AIChatOutcome)
  (param chat AIChat)
  (case? (or (not messages) (not (. messages length)))
    null
  )
  (case? (or (!= (. last role) (. AIMessageRole assistant)) (== (. last finish-reason) null))
    null
  )
  (case? (or (!= (. last error) null) (== (. last finish-reason) (. AIFinishReason error)))
    (. AIChatOutcome failed)
  )
  (case? (call ai-reply-asks (. last parts))
    (. AIChatOutcome asks)
  )
  (default
    null
  )
  (where
    (lazy messages (?. (call chat-branch chat (. chat root-branch-id)) messages))
    (lazy last ([] messages (- (. messages length) 1)))
  )
)

(fn-expr + chat-marks-after AIChatMarks
  (param marks AIChatMarks)
  (param activity AIChatActivity)
  (call AIChatMarks (. marks seen-at) (call kept (. marks done-at)) (call kept (. marks archived-at)))
  (where
    (lazy kept (=> ((: mark (? Int))) (if-expr (call ai-is-later (. activity sent-at) mark) null mark)))
  )
)

(fn-expr + chat-is-unread Bool
  (param activity AIChatActivity)
  (param marks AIChatMarks)
  (call ai-is-later (. activity replied-at) (. marks seen-at))
)

(fn-expr + chat-place AIChatPlace
  (param marks AIChatMarks)
  (case? (!= (. marks archived-at) null)
    (. AIChatPlace archived)
  )
  (case? (!= (. marks done-at) null)
    (. AIChatPlace done)
  )
  (default
    (. AIChatPlace active)
  )
)

(fn-expr + ai-chat-now Int
  (. (call DateTime utc) since-epoch)
)

(fn-expr + ai-chat-time (? Int)
  (param stamp Timestamp)
  (only-if (as (. parsed since-epoch) Int) (if parsed))
  (where
    (lazy parsed (call parse-iso8601 stamp utc))
  )
)

(fn-expr _ chat-reply-time (? Int)
  (param message AIChatMessage)
  (case? (or (== started null) (== elapsed null))
    started
  )
  (default
    (as (+ started (/ elapsed 1s)) Int)
  )
  (where
    (lazy started (call ai-chat-time (. message created-at)))
    (lazy elapsed (. message elapsed))
  )
)

(fn-expr _ ai-later (? Int)
  (param one (? Int))
  (param other (? Int))
  (if-expr (call ai-is-later other one) other (?? one other))
)

(fn-expr _ ai-is-later Bool
  (param one (? Int))
  (param other (? Int))
  (case? (== one null)
    false
  )
  (case? (== other null)
    true
  )
  (default
    (> one other)
  )
)

(fn-expr + append-chat-message _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (param message AIChatMessage)
  (call insert-chat-message chat branch-id (call chat-owned-message-count chat branch-id) message)
)

(fn-do + append-chat-messages _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (param messages (list AIChatMessage))
  (let result (call AIChat chat))
  (let branch (call require-chat-branch result branch-id))
  (let taken (call (of Map String Bool)))
  (for (in owner (. result branches))
    (for (in message (. owner messages))
      (= ([] taken (. message id)) true)
    )
  )
  (for (in message messages)
    (throw (call AIError (. AIErrorKind invalid-request) (str "Duplicate chat message ID: " (. message id))) (if (!= ([] taken (. message id)) null)))
    (= ([] taken (. message id)) true)
    (+= (. branch messages) message)
  )
  (return result)
)

(fn-do + insert-chat-message _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (param index Index)
  (param message AIChatMessage)
  (throw (call AIError (. AIErrorKind invalid-request) (str "Duplicate chat message ID: " (. message id))) (if (call chat-has-message chat (. message id))))
  (blank)
  (let result (call AIChat chat))
  (let branch (call require-chat-branch result branch-id))
  (throw (call AIError (. AIErrorKind invalid-request) "Chat insertion index is outside the branch suffix") (if (> index (. branch messages length))))
  (blank)
  (call (. branch messages insert) message index)
  (return result)
)

(fn-do + remove-chat-message _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (param message-id String)
  (let result (call AIChat chat))
  (let branch (call require-chat-branch result branch-id))
  (let index (call chat-message-index (. branch messages) message-id))
  (throw (call AIError (. AIErrorKind invalid-request) (str "Message " message-id " is not owned by branch " branch-id)) (if (not index)))
  (blank)
  (throw (call AIError (. AIErrorKind invalid-request) (str "Message " message-id " anchors a child branch")) (if (call chat-message-anchors-child result branch-id message-id)))
  (blank)
  (call (. branch messages remove) index)
  (return result)
)

(fn-do + replace-chat-message AIChat
  (param chat AIChat)
  (param message AIChatMessage)
  (let result (call AIChat chat))
  (for (in branch (. result branches))
    (call replace-chat-message-in (. branch shared-prefix) message)
    (call replace-chat-message-in (. branch messages) message)
  )
  (return result)
)

(fn-do _ replace-chat-message-in _
  (param messages (list AIChatMessage))
  (param message AIChatMessage)
  (for (in index (..< 0 (. messages length)))
    (if (== (. ([] messages index) id) (. message id))
      (= ([] messages index) message)
    )
  )
)

(fn-do + revised-chat-message AIChatMessage
  (param message AIChatMessage)
  (param parts (list AIMessagePart))
  (let revised
    (call AIChatMessage
      (block
        (arg (. message id))
        (arg (. message role))
        (arg parts)
        (arg (. message created-at))
        (arg (. message model))
        (arg (. message usage))
        (arg (. message finish-reason))
      )
    )
  )
  (= (. revised error) (. message error))
  (= (. revised elapsed) (. message elapsed))
  (return revised)
)

(fn-do + branch-chat-at _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (param fork-message-id String)
  (param child-branch-id String)
  (throw (call AIError (. AIErrorKind invalid-request) (str "Duplicate chat branch ID: " child-branch-id)) (if (call chat-branch chat child-branch-id)))
  (blank)
  (let transcript (call chat-transcript chat branch-id))
  (let index (call chat-message-index transcript fork-message-id))
  (throw (call AIError (. AIErrorKind invalid-request) (str "Message " fork-message-id " is not in branch " branch-id)) (if (not index)))
  (blank)
  (let shared ([] transcript (.. 0 index)))
  (blank)
  (let result (call AIChat chat))
  (+= (. result branches) (call AIChatBranch child-branch-id branch-id fork-message-id shared true))
  (return result)
)

(fn-do + collapse-chat-at _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (param message-id String)
  (param child-branch-id String)
  (throw (call AIError (. AIErrorKind invalid-request) (str "Duplicate chat branch ID: " child-branch-id)) (if (call chat-branch chat child-branch-id)))
  (blank)
  (let result (call AIChat chat))
  (let branch (call require-chat-branch result branch-id))
  (let index (call chat-message-index (. branch messages) message-id))
  (throw (call AIError (. AIErrorKind invalid-request) (str "Message " message-id " is not owned by branch " branch-id)) (if (not index)))
  (blank)
  (let transcript (call chat-transcript result branch-id))
  (let start (+ (. branch shared-messages length) index))
  (let anchor (only-if (. ([] transcript (- start 1)) id) (if (> start 0))))
  (let child
    (call AIChatBranch
      (block
        (arg child-branch-id)
        (arg branch-id)
        (arg anchor)
        (arg ([] transcript (..< 0 start)))
        (arg (. branch forks))
        (arg true)
      )
    )
  )
  (let moved (call (of Map String Bool)))
  (for (in message ([] (. branch messages) (..< index (. branch messages length))))
    (+= (. child messages) message)
    (= ([] moved (. message id)) true)
  )
  (for (in other (. result branches))
    (if (and is-child (. other fork-message-id) (has moved (. other fork-message-id)))
      (= (. other parent-branch-id) child-branch-id)
    )
    (lazy is-child (== (. other parent-branch-id) branch-id))
  )
  (call (. branch messages remove) index (. child messages length))
  (= (. branch forks) true)
  (+= (. result branches) child)
  (return result)
)

(fn-do + unfold-chat-branch _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (let result (call AIChat chat))
  (let child (call require-chat-branch result branch-id))
  (throw (call AIError (. AIErrorKind invalid-request) "The root chat branch cannot be unfolded") (if (not (. child parent-branch-id))))
  (let parent-id (. child parent-branch-id))
  (let parent (call require-chat-branch result parent-id))
  (let index (call chat-unfold-index parent (. child fork-message-id)))
  (throw (call AIError (. AIErrorKind invalid-request) (str "Branch " branch-id " no longer has its fork message")) (if (== index null)))
  (blank)
  (let later (- (. parent messages length) index))
  (for (in message (|> (. child messages) indexed))
    (call (. parent messages insert) ([] message 1) (+ index ([] message 0)))
  )
  (if (not later)
    (= (. parent forks) (. child forks))
  )
  (for (in other (. result branches))
    (if (== (. other parent-branch-id) branch-id)
      (= (. other parent-branch-id) parent-id)
      (= (. other fork-message-id) (?? (. other fork-message-id) (. child fork-message-id)))
    )
  )
  (call (. result branches remove) (!! (call chat-branch-index result branch-id)))
  (return result)
)

(fn-do + remove-chat-branch _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (throw (call AIError (. AIErrorKind invalid-request) "The root chat branch cannot be removed") (if (== branch-id (. chat root-branch-id))))
  (call require-chat-branch chat branch-id)
  (blank)
  (let doomed (call chat-branch-family chat branch-id))
  (let result (call AIChat chat))
  (let index (. result branches length))
  (while (> index 0)
    (-= index 1)
    (if (has doomed (. ([] (. result branches) index) id))
      (call (. result branches remove) index)
    )
  )
  (return result)
)

(fn-do + set-chat-branch-forks _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (param forks Bool)
  (let result (call AIChat chat))
  (= (. (call require-chat-branch result branch-id) forks) forks)
  (return result)
)

(fn-do + chat-branch-family (of Map String Bool)
  (param chat AIChat)
  (param branch-id String)
  (let family
    (call (of Map String Bool)
      (block
        (entry branch-id true)
      )
    )
  )
  (let grew true)
  (while grew
    (= grew false)
    (for (in branch (. chat branches))
      (if (and (. branch parent-branch-id) (has family (. branch parent-branch-id)) (not (has family (. branch id))))
        (= ([] family (. branch id)) true)
        (= grew true)
      )
    )
  )
  (return family)
)

(fn-expr + chat-child-branches (list AIChatBranch)
  (param chat AIChat)
  (param branch-id String)
  (spread (. chat branches))
  (pipe ?> (== (. each parent-branch-id) branch-id))
  (pipe |> List)
)

(fn-do + chat-branch-trail (list AIChatBranch)
  (param chat AIChat)
  (param branch-id String)
  (let trail (call (of List AIChatBranch)))
  (let current (call chat-branch chat branch-id))
  (while (and current (<= (. trail length) (. chat branches length)))
    (let found current)
    (call (. trail insert) found 0)
    (return-if trail (if (not (. found parent-branch-id))))
    (= current (call chat-branch chat (. found parent-branch-id)))
  )
  (return trail)
)

(fn-expr + chat-can-branch-at Bool
  (param chat AIChat)
  (param branch-id String)
  (param message-id String)
  (case? (== transcript null)
    false
  )
  (case? (== index null)
    false
  )
  (default
    (>= (+ index 1) (call chat-compaction-floor transcript))
  )
  (where
    (lazy transcript (catch? (call chat-transcript chat branch-id)))
    (lazy index (call chat-message-index transcript message-id))
  )
)

(fn-expr + chat-can-collapse-at Bool
  (param chat AIChat)
  (param branch-id String)
  (param message-id String)
  (case? (not branch)
    false
  )
  (case? (== index null)
    false
  )
  (default
    (>= (+ (. branch shared-messages length) index) (call chat-compaction-floor transcript))
  )
  (where
    (lazy branch (call chat-branch chat branch-id))
    (lazy index (call chat-message-index (. branch messages) message-id))
    (lazy transcript (call chat-transcript chat branch-id))
  )
)

(fn-do + chat-can-unfold Bool
  (param chat AIChat)
  (param branch-id String)
  (let branch (call chat-branch chat branch-id))
  (return-if false (if (or (not branch) (not (. branch parent-branch-id)))))
  (let parent (call chat-branch chat (. branch parent-branch-id)))
  (return-if false (if (not parent)))
  (let index (call chat-unfold-index parent (. branch fork-message-id)))
  (return-if false (if (== index null)))
  (return (call all ([] (. parent messages) (..< index (. parent messages length))) (:where (not (call chat-message-compacts each)))))
)

(fn-do + chat-next-branch-id String
  (param chat AIChat)
  (let number (. chat branches length))
  (while (call chat-branch chat (str "branch-" number))
    (+= number 1)
  )
  (return (str "branch-" number))
)

(fn-expr + chat-branch-title String
  (param branch AIChatBranch)
  (?? (call chat-branch-label branch) "Side chat")
)

(fn-expr + chat-branch-label (? String)
  (param branch AIChatBranch)
  (only-if (call chat-title (call ai-parts-text (. prompt parts))) (if prompt))
  (where
    (lazy prompt (call chat-branch-prompt branch))
  )
)

(fn-expr + chat-branch-prompt (? AIChatMessage)
  (param branch AIChatBranch)
  (call first (in each (. branch messages) (when (== (. each role) (. AIMessageRole user)))))
)

(fn-expr + chat-branch-summaries (list AIChatBranchSummary)
  (param chat AIChat)
  (spread (. chat branches))
  (pipe *> (call AIChatBranchSummary (. each id) (. each parent-branch-id) (call chat-branch-label each) (. each is-collapsed)))
  (pipe |> List)
)

(fn-expr + chat-is-empty _
  (param chat AIChat)
  (and (not (. chat is-kept)) (== (call chat-message-count chat) 0))
)

(fn-expr + chat-message-compacts _
  (param message AIChatMessage)
  (call some (. message parts) (:where (call chat-part-compacts each)))
)

(fn-expr + chat-transcript _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (++ (call (of List AIChatMessage) (. branch shared-prefix)) (. branch messages))
  (where
    (lazy branch (call require-chat-branch chat branch-id))
  )
)

(fn-expr + chat-request-messages (list AIMessage) (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (in (call AIMessage (. each role) (. each parts)) (call chat-transcript chat branch-id) (when (. each joins-request)))
)

(fn-do + chat-next-message-number Size
  (param chat AIChat)
  (param issued Size (= 0))
  (let count (call chat-message-count chat))
  (let number (+ (if-expr (> issued count) issued count) 1))
  (while (call chat-has-message chat (call chat-message-id chat number))
    (+= number 1)
  )
  (return number)
)

(fn-do _ ai-prompt-parts (list AIMessagePart)
  (param id String)
  (param text String)
  (param images (list AIImage))
  (let parts (call (of List AIMessagePart)))
  (if (or (. text length) (not (. images length)))
    (+= parts (call AITextPart (str id ":text") text))
  )
  (for (in image images)
    (+= parts (call AIImagePart (str id ":image:" (. parts length)) image))
  )
  (return parts)
)

(fn-expr + chat-message-id _
  (param chat AIChat)
  (param number Size)
  (str (. chat id) ":" number)
)

(fn-expr + chat-title _
  (param prompt String)
  (case? (> (. line length) ai-chat-title-limit)
    (str (call (. ([] line (..< 0 ai-chat-title-limit)) trim)) "…")
  )
  (default
    line
  )
  (where
    (lazy line (call chat-first-line prompt))
  )
)

(fn-expr + chat-named-title _
  (param text String)
  (call chat-title unquoted)
  (where
    (lazy line (call chat-first-line text))
    (lazy is-quoted (and (> (. line length) 1) (call (. line starts-with) "\"") (call (. line ends-with) "\"")))
    (lazy unquoted (if-expr is-quoted ([] line (..< 1 (- (. line length) 1))) line))
  )
)

(fn-expr _ chat-first-line String
  (param text String)
  (if-expr (!= break null) (call (. ([] trimmed (..< 0 break)) trim)) trimmed)
  (where
    (lazy trimmed (call (. text trim)))
    (lazy break (call (. trimmed find) "\n"))
  )
)

(fn-expr _ chat-part-compacts _
  (param part AIMessagePart)
  (and (is part AIExtensionPart) (== (. (as part AIExtensionPart) part-type) ai-compaction-part))
)

(fn-do _ chat-compaction-floor Size
  (param transcript (list AIChatMessage))
  (let index (. transcript length))
  (while (> index 0)
    (-= index 1)
    (return-if (+ index 1) (if (call chat-message-compacts ([] transcript index))))
  )
  (return 0)
)

(fn-expr _ chat-unfold-index (? Index)
  (param parent AIChatBranch)
  (param anchor (? String))
  (case? (not anchor)
    0
  )
  (case? (!= index null)
    (+ index 1)
  )
  (case? (!= (call chat-message-index (. parent shared-messages) anchor) null)
    0
  )
  (default
    null
  )
  (where
    (lazy index (call chat-message-index (. parent messages) anchor))
  )
)

(fn-expr _ chat-message-count Size
  (param chat AIChat)
  (spread (. chat branches))
  (pipe *> (. each messages length))
  (pipe |> sum)
)

(fn-expr _ chat-owned-message-count _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (. (call require-chat-branch chat branch-id) messages length)
)

(fn-expr _ chat-has-message _
  (param chat AIChat)
  (param message-id String)
  (spread (. chat branches))
  (pipe *> (. each messages))
  (pipe |> flat-map)
  (pipe |> (call some (:where (== (. each id) message-id))))
)

(fn-expr + chat-branch (? AIChatBranch)
  (param chat AIChat)
  (param branch-id String)
  (spread (. chat branches))
  (pipe ?> (== (. each id) branch-id))
  (pipe |> first)
)

(fn-expr _ chat-message-index (? Index)
  (param messages (list AIChatMessage))
  (param message-id String)
  (spread messages)
  (pipe |> indexed)
  (pipe ?*> (only-if ([] each 0) (if (== (. ([] each 1) id) message-id))))
  (pipe |> first)
)

(fn-expr _ chat-branch-index (? Index)
  (param chat AIChat)
  (param branch-id String)
  (spread (. chat branches))
  (pipe |> indexed)
  (pipe ?*> (only-if ([] each 0) (if (== (. ([] each 1) id) branch-id))))
  (pipe |> first)
)

(fn-expr _ chat-message-anchors-child _
  (param chat AIChat)
  (param branch-id String)
  (param message-id String)
  (. chat branches)
  (pipe |> (call some (:where (and (== (. each parent-branch-id) branch-id) (== (. each fork-message-id) message-id)))))
)

(fn-expr _ require-chat-branch _ (?! AIError)
  (param chat AIChat)
  (param branch-id String)
  (before
    (throw (call AIError (. AIErrorKind invalid-request) (str "Unknown chat branch: " branch-id)) (if (not branch)))
  )
  branch
  (where
    (lazy branch (call chat-branch chat branch-id))
  )
)

(fn-expr _ copy-chat-messages _
  (param messages (list AIChatMessage))
  (call (of List AIChatMessage) messages)
)
