(import ./model)
(import /core/channel)
(import /data/json)
(import /os/env)
(import /os/file)
(import /os/path)
(import /time/duration)
(blank)
(prop _ ai-access-perms _ (= (/or/ user-read-perm user-write-perm)))

(type + AIAccessKind (is Union)
  (variant approval)
  (variant api-key)
)

(type + AIAccessStore
  (prop + path Path)
  (blank)
  (prop _ approvals _ (= (call (of Map String Bool))))
  (prop _ keys _ (= (call (of Map String String))))
  (prop _ is-loaded _ (= false))
  (fn-do + This _
    (param path _)
  )
  (fn-do + is-approved Bool
    (param id String)
    (call load)
    (return (has approvals id))
  )
  (fn-do + key (? String)
    (param id String)
    (call load)
    (return ([] keys id))
  )
  (fn-do + approve _ (?! Error)
    (param id String)
    (call load)
    (= ([] approvals id) true)
    (call save)
  )
  (fn-do + keep-key _ (?! Error)
    (param id String)
    (param key String)
    (call load)
    (= ([] keys id) key)
    (call save)
  )
  (fn-do _ load _
    (return-if (if is-loaded))
    (= is-loaded true)
    (let text (catch? (call read-file-text path)))
    (return-if (if (not text)))
    (let fields
      (match? (catch? (call parse-json text))
        (case (map String JSON))
      )
    )
    (return-if (if (not fields)))
    (if (= (| (: approved (list JSON))) ([] fields "approved"))
      (for (in item approved)
        (if (= (| (: id String)) item)
          (= ([] approvals id) true)
        )
      )
    )
    (if (= (| (: saved (map String JSON))) ([] fields "keys"))
      (for (in (tuple id value) saved)
        (if (= (| (: key String)) value)
          (= ([] keys id) key)
        )
      )
    )
  )
  (fn-do _ save _ (?! Error)
    (let approved (call (of List JSON)))
    (for (in (tuple id _) approvals)
      (+= approved id)
    )
    (let saved (call (of Map String JSON)))
    (for (in (tuple id key) keys)
      (= ([] saved id) key)
    )
    (let root
      (call (of Map String JSON)
        (block
          (:approved approved)
          (:keys saved)
        )
      )
    )
    (do
      (inline (call (?. (. path parent) make-directories)))
    )
    (call write-file-atomically path (call to-json root) ai-access-perms)
  )
)

(type + AIAccess
  (prop + id String)
  (prop + kind AIAccessKind)
  (prop + name String)
  (prop + sign-in (? String))
  (prop + variable (? String))
  (prop + is-granted Bool)
  (prop + is-checking _ (= false))
  (prop + account (? AIAccount))
  (prop + problem (? String))
  (prop + is-asking _ (= false))
  (prop + asking (? String))
  (event + keyed String)
  (blank)
  (prop _ store AIAccessStore)
  (prop _ found-key (? String))
  (prop _ waiters (list (of SyncBufferedChannel Bool)))
  (fn-do + This _
    (param store _)
    (param id _)
    (param kind _)
    (param name _)
    (param sign-in (? String) (= null))
    (param variable (? String) (= null))
    (= found-key (call ai-access-variable variable))
    (= is-granted (if-expr (== kind (. AIAccessKind approval)) (call (. store is-approved) id) (!= key null)))
  )
  (fn-expr + key (? String) :get
    (?? (call (. store key) id) (only-if found-key (if (call (. store is-approved) id))))
  )
  (fn-expr + has-found-key Bool :get
    (!= found-key null)
  )
  (fn-do + check _
    (param provider AIProvider)
    (return-if (if is-checking))
    (= is-checking true)
    (finally
      (= is-checking false)
    )
    (= problem null)
    (let found (catch (call (. provider account))))
    (match found
      (case (: failure AIError)
        (= account null)
        (= problem (. failure message))
      )
      (case (: known AIAccount)
        (= account known)
      )
      (default
        (= account null)
      )
    )
  )
  (fn-do + approve _
    (let failure (catch (call (. store approve) id)))
    (if (is failure Error)
      (= problem (str "Your approval could not be saved: " (. (as failure Error) message)))
      (else
        (= problem null)
        (= is-granted true)
        (if (= (| (: given String)) key)
          (<- keyed given)
        )
        (call answer true)
      )
    )
  )
  (fn-do + enter _
    (param text String)
    (let key (call (. text trim)))
    (return-if (if (not (. key length))))
    (let failure (catch (call (. store keep-key) id key)))
    (if (is failure Error)
      (= problem (str "The key could not be saved: " (. (as failure Error) message)))
      (else
        (= problem null)
        (= is-granted true)
        (<- keyed key)
        (call answer true)
      )
    )
  )
  (fn-do + ask Bool
    (param reason String)
    (param patience Duration)
    (return-if true (if is-granted))
    (let waiting (call (of SyncBufferedChannel Bool)))
    (+= waiters waiting)
    (= asking reason)
    (= is-asking true)
    (let timer (call (. patience loop) (=> () :do (<- waiting false))))
    (let granted (?? (<- waiting) false))
    (call (. timer cancel))
    (= waiters (call List (?> waiters (!= (as each Pointer) (as waiting Pointer)))))
    (if (not waiters)
      (= is-asking false)
    )
    (return (and granted is-granted))
  )
  (fn-do + decline _
    (call answer false)
  )
  (fn-do _ answer _
    (param granted Bool)
    (let waiting waiters)
    (= waiters (call (of List (of SyncBufferedChannel Bool))))
    (= is-asking false)
    (for (in each waiting)
      (<- each granted)
    )
  )
)

(fn-expr _ ai-access-variable (? String)
  (param name (? String))
  (case? (not name)
    null
  )
  (case? (> (. value length) 0)
    value
  )
  (default
    null
  )
  (where
    (lazy value (?? (call env name) ""))
  )
)

(fn-expr + ai-access-can-approve Bool
  (param account (? AIAccount))
  (and (!= account null) (== (. account status) (. AIAccountStatus signed-in)) (!= (. account billing) (. AIAccountBilling api)))
)
