(import ./media)
(import ./tool-tasks)
(import /data/json)
(import /time/duration)
(import /units)
(blank)
(prop + ai-compaction-part _ (= "compaction"))
(prop + ai-steer-part _ (= "steer"))

(type + AIMessageRole (is Union)
  (variant developer)
  (variant system)
  (variant user)
  (variant assistant)
  (variant tool)
)

(type + AIWebSearchStatus (is Union)
  (variant started)
  (variant searching)
  (variant completed)
  (variant failed)
)

(type + AICitation
  (prop + title String)
  (prop + url String)
  (prop + start-offset (? Index))
  (prop + end-offset (? Index))
  (fn-do + This _
    (param title _)
    (param url _)
    (param start-offset (? Index))
    (param end-offset (? Index))
  )
)

(type + AIMessagePart (is Union)
  (variant AITextPart)
  (variant AIReasoningPart)
  (variant AIWebSearchPart)
  (variant AIFilePart)
  (variant AIImagePart)
  (variant AIAudioPart)
  (variant AIVideoPart)
  (variant AIToolCallPart)
  (variant AIToolResultPart)
  (variant AIRefusalPart)
  (variant AIExtensionPart)
)

(type + AIMessagePartBase
  (prop + id String)
  (fn-do + This _
    (param id _)
  )
)

(type + AITextPart (is AIMessagePartBase)
  (prop + text String)
  (prop + source-id (? String))
  (prop + citations (list AICitation))
  (fn-do + This _
    (param id _)
    (param text _)
    (param source-id (? String) (= null))
    (param citations (list AICitation) (= (call (of List AICitation))))
    (call super id)
  )
)

(type + AIReasoningPart (is AIMessagePartBase)
  (prop + text String)
  (prop + source-id (? String))
  (prop + provider-signature (? JSON))
  (prop + is-update Bool)
  (fn-do + This _
    (param id _)
    (param text _)
    (param source-id (? String) (= null))
    (param provider-signature (? JSON) (= null))
    (param is-update _ (= false))
    (call super id)
  )
)

(type + AIWebSearchPart (is AIMessagePartBase)
  (prop + search-id (? String))
  (prop + query String)
  (prop + status AIWebSearchStatus)
  (fn-do + This _
    (param id _)
    (param query _)
    (param status _ (= (. AIWebSearchStatus completed)))
    (param search-id (? String) (= null))
    (call super id)
  )
)

(type + AIFilePart (is AIMessagePartBase)
  (prop + file AIFile)
  (fn-do + This _
    (param id _)
    (param file _)
    (call super id)
  )
)

(type + AIImagePart (is AIMessagePartBase)
  (prop + image AIImage)
  (fn-do + This _
    (param id _)
    (param image _)
    (call super id)
  )
)

(type + AIAudioPart (is AIMessagePartBase)
  (prop + audio AIAudio)
  (fn-do + This _
    (param id _)
    (param audio _)
    (call super id)
  )
)

(type + AIVideoPart (is AIMessagePartBase)
  (prop + video AIVideo)
  (fn-do + This _
    (param id _)
    (param video _)
    (call super id)
  )
)

(type + AIToolCallPart (is AIMessagePartBase)
  (prop + call-id String)
  (prop + tool-name String)
  (prop + arguments JSON)
  (prop + provider-signature (? JSON))
  (fn-do + This _
    (param id _)
    (param call-id _)
    (param tool-name _)
    (param arguments _)
    (param provider-signature (? JSON) (= null))
    (call super id)
  )
)

(type + AIToolResultPart (is AIMessagePartBase)
  (prop + call-id String)
  (prop + output JSON)
  (prop + text-output (? String))
  (prop + is-error Bool)
  (prop + images (list AIImage))
  (fn-do + This _
    (param id _)
    (param call-id _)
    (param output _ (= (as null JSON)))
    (param text-output (? String) (= null))
    (param is-error _ (= false))
    (param images (list AIImage) (= (call (of List AIImage))))
    (call super id)
  )
)

(type + AIRefusalPart (is AIMessagePartBase)
  (prop + text String)
  (fn-do + This _
    (param id _)
    (param text _)
    (call super id)
  )
)

(type + AIExtensionPart (is AIMessagePartBase)
  (prop + provider-id String)
  (prop + part-type String)
  (prop + data JSON)
  (fn-do + This _
    (param id _)
    (param provider-id _)
    (param part-type _)
    (param data _)
    (call super id)
  )
)

(type + AIMessage
  (prop + role AIMessageRole)
  (prop + parts (list AIMessagePart))
  (prop + name (? String))
  (fn-do + This _
    (param role _)
    (param parts (list AIMessagePart))
    (param name (? String) (= null))
  )
  (fn-do + This _
    (param role _)
    (param text String)
    (param name (? String) (= null))
    (lazy parts
      (block
        (item (call AITextPart "text" text))
      )
    )
  )
)

(type + AITool
  (prop + name String)
  (prop + description String)
  (prop + parameters JSON)
  (prop + is-strict Bool)
  (fn-do + This _
    (param name _)
    (param description _)
    (param parameters _)
    (param is-strict _ (= true))
  )
)

(type + AIToolChoice (is Union)
  (variant automatic)
  (variant none)
  (variant required)
  (variant AINamedToolChoice)
)

(type + AINamedToolChoice
  (prop + name String)
  (fn-do + This _
    (param name _)
  )
)

(type + AICommonOptions
  (prop + temperature (? Float))
  (prop + maximum-output-tokens (? Size))
  (prop + timeout (? Duration))
  (prop + stop-sequences (list String))
)

(type + AIWebSearchContext (is Union)
  (variant low)
  (variant medium)
  (variant high)
)

(type + AIWebSearchOptions
  (prop + context AIWebSearchContext (= (. AIWebSearchContext medium)))
  (prop + provider-json (? JSON))
)

(type + AIRequest
  (prop + model String)
  (prop + messages (list AIMessage))
  (prop + options AICommonOptions)
  (prop + tools (list AITool))
  (prop + tool-choice (? AIToolChoice))
  (prop + response-schema (? JSON))
  (prop + web-search (? AIWebSearchOptions))
  (prop + image-output (? AIImageOptions))
  (prop + audio-output (? AIAudioOptions))
  (prop + video-output (? AIVideoOptions))
  (prop + provider-json (? JSON))
  (prop + forks _ (= false))
  (prop + chat-id (? String))
  (fn-do + This _
    (param model _)
    (param messages (list AIMessage) (= (call (of List AIMessage))))
    (lazy options (call AICommonOptions))
  )
)

(type + AIUsage (is Tuple)
  (prop + input-tokens (? Size)
    (=
      (call ai-usage-sum
        (block
          (arg cached-input-tokens)
          (arg cache-creation-tokens)
          (arg cache-read-tokens)
          (arg tool-prompt-tokens)
        )
      )
    )
  )
  (prop + output-tokens (? Size) (= (call ai-usage-sum reasoning-tokens thought-tokens)))
  (prop + total-tokens (? Size) (= (call ai-usage-sum input-tokens output-tokens)))
  (prop + cached-input-tokens (? Size) (= null))
  (prop + cache-creation-tokens (? Size) (= null))
  (prop + cache-read-tokens (? Size) (= null))
  (prop + reasoning-tokens (? Size) (= null))
  (prop + thought-tokens (? Size) (= null))
  (prop + tool-prompt-tokens (? Size) (= null))
)

(fn-expr _ ai-usage-sum (? Size)
  (param first (? Size))
  (param second (? Size))
  (param third (? Size) (= null))
  (param fourth (? Size) (= null))
  (case? (or (is first Size) (is second Size) (is third Size) (is fourth Size))
    (+ (?? first 0) (?? second 0) (?? third 0) (?? fourth 0))
  )
  (default
    null
  )
)

(type + AIFinishReason (is Union)
  (variant stop)
  (variant length)
  (variant tool-calls)
  (variant content-filter)
  (variant cancellation)
  (variant error)
  (variant AIProviderFinishReason)
)

(type + AIProviderFinishReason (is (tuple (: provider-id String) (: reason String))))

(type + AIErrorKind (is Union)
  (variant authentication)
  (variant rate-limit)
  (variant context-length)
  (variant server)
  (variant timeout)
  (variant cancellation)
  (variant invalid-request)
  (variant invalid-response)
  (variant unknown)
)

(type + AIError (is Error)
  (prop + kind AIErrorKind)
  (prop + service-message String)
  (prop + http-status (? Int))
  (prop + is-retryable Bool)
  (prop + rate-limit-reset (? String))
  (fn-do + This _
    (param kind _)
    (param service-message _)
    (param http-status (? Int) (= null))
    (param is-retryable _ (= false))
    (param rate-limit-reset (? String) (= null))
    (= message service-message)
  )
)

(type + AIResponse
  (prop + message AIMessage)
  (prop + usage AIUsage)
  (prop + finish-reason AIFinishReason)
  (prop + data (? JSON))
  (fn-do + This _
    (param message _)
    (param usage _)
    (param finish-reason _)
    (param data (? JSON) (= null))
  )
)

(type + AISubagent (is Tuple)
  (prop + id String)
  (prop + title String)
  (prop + kind String)
  (prop + call-id String)
  (prop + is-running Bool)
  (prop + steps Size)
  (prop + latest (? String))
  (prop + result (? String))
  (prop + parts (list AIMessagePart))
)

(type + AIToolKind (is Union)
  (variant command)
  (variant read)
  (variant write)
  (variant edit)
  (variant search)
  (variant fetch)
  (variant web-search)
  (variant agent)
  (variant skill)
  (variant tool-search)
  (variant other)
)

(type + AIAccountStatus (is Union)
  (variant missing)
  (variant signed-out)
  (variant signed-in)
)

(type + AIAccountBilling (is Union)
  (variant subscription)
  (variant api)
  (variant unknown)
)

(type + AIAccount (is Tuple)
  (prop + status AIAccountStatus)
  (prop + billing _ (= (. AIAccountBilling unknown)))
  (prop + email (? String) (= null))
  (prop + plan (? String) (= null))
  (prop + organization (? String) (= null))
)

(type + AIToolkitResult (is Tuple)
  (prop + output JSON)
  (prop + images (list AIImage))
  (prop + shown (list AIImage))
)

(type + AIToolkit (is Interface)
  (fn-do + tools (list AITool))
  (fn-do + context (? String)
    (param request AIRequest)
  )
  (fn-expr + prompt (list AIMessage)
    (param messages (list AIMessage))
    messages
  )
  (fn-do + run AIToolkitResult (?! Error)
    (param request AIRequest)
    (param call AIToolCallPart)
  )
)

(fn-do + ai-toolkit-for (? AIToolkit)
  (param toolkits (list AIToolkit))
  (param name String)
  (for (in kit toolkits)
    (for (in tool (call (. kit tools)))
      (return-if kit (if (== (. tool name) name)))
    )
  )
  (return null)
)

(fn-do + ai-toolkits-context (? String)
  (param toolkits (list AIToolkit))
  (param request AIRequest)
  (let notes (call (of List String)))
  (for (in kit toolkits)
    (let note (call (. kit context) request))
    (if note
      (+= notes note)
    )
  )
  (return-if null (if (not notes)))
  (return (call (. "\n\n" join) notes))
)

(fn-do + ai-toolkit-messages (list AIMessage)
  (param messages (list AIMessage))
  (param context (? String))
  (let transcript (call (of List AIMessage) messages))
  (return-if transcript (if (not context)))
  (let index (. transcript length))
  (while (> index 0)
    (-= index 1)
    (let message ([] transcript index))
    (if (== (. message role) (. AIMessageRole user))
      (let parts (call (of List AIMessagePart)))
      (+= parts (call AITextPart "toolkit-context" (str context "\n\n")))
      (++= parts (. message parts))
      (= ([] transcript index) (call AIMessage (. message role) parts (. message name)))
      (return transcript)
    )
  )
  (return transcript)
)

(fn-do + ai-toolkits-messages (list AIMessage)
  (param toolkits (list AIToolkit))
  (param request AIRequest)
  (let messages (call (of List AIMessage) (. request messages)))
  (for (in kit toolkits)
    (= messages (call (. kit prompt) messages))
  )
  (return (call ai-toolkit-messages messages (call ai-toolkits-context toolkits request)))
)

(fn-do + ai-toolkit-request AIRequest
  (param toolkits (list AIToolkit))
  (param request AIRequest)
  (let asked (call AIRequest (. request model) (call ai-toolkits-messages toolkits request)))
  (= (. asked options) (. request options))
  (= (. asked forks) (. request forks))
  (= (. asked chat-id) (. request chat-id))
  (return asked)
)

(fn-do + ai-toolkit-parts (stream AIPartEndEvent)
  (param call AIToolCallPart)
  (param result AIToolkitResult)
  (yield (call AIPartEndEvent (call AIToolResultPart (str (. call id) ":result") (. call call-id) (. result output) (:images (. result images)))))
  (if (== (. result shown length) 1)
    (yield (call AIPartEndEvent (call AIImagePart (str (. call id) ":image") ([] (. result shown) 0))))
    (return)
  )
  (for (in index (..< 0 (. result shown length)))
    (yield (call AIPartEndEvent (call AIImagePart (str (. call id) ":image-" index) ([] (. result shown) index))))
  )
)

(fn-expr + ai-toolkit-failure AIToolResultPart
  (param call AIToolCallPart)
  (param message String)
  (call AIToolResultPart (str (. call id) ":result") (. call call-id) null message true)
)

(type + AIProvider
  (prop + tool-tasks _ (= (call AIToolTasks)))
  (fn-do + account (? AIAccount) (?! AIError)
    (return null)
  )
  (fn-expr + tool-title (? String)
    (param call AIToolCallPart)
    null
  )
  (fn-expr + tool-kind AIToolKind
    (param call AIToolCallPart)
    (. AIToolKind other)
  )
  (fn-expr + tool-input (? String)
    (param call AIToolCallPart)
    null
  )
  (fn-do + read-task-output (? String)
    (param task AIToolTask)
    (return null)
  )
  (fn-do + stop-work _ (?! AIError)
    (param parts (list AIMessagePart))
  )
  (fn-do + subagents (list AISubagent) (?! Error)
    (param parts (list AIMessagePart))
    (return (call (of List AISubagent)))
  )
  (fn-do + caught-up (? (list AIMessagePart)) (?! Error)
    (param parts (list AIMessagePart))
    (return null)
  )
  (fn-do + stream (stream AIEvent)
    (param request AIRequest)
    (if false
      (yield (call AIDoneEvent (. AIFinishReason error) (call AIUsage)))
    )
    (throw (call AIError (. AIErrorKind invalid-request) "AIProvider.stream is not implemented"))
  )
  (fn-do + follow-up (stream AIEvent)
    (param parts (list AIMessagePart))
    (if false
      (yield (call AIDoneEvent (. AIFinishReason stop) (call AIUsage)))
    )
  )
  (fn-do + steer _ (?! AIError)
    (param parts (list AIMessagePart))
    (param prompt String)
    (throw (call AIError (. AIErrorKind invalid-request) "This provider can't take a message while it replies"))
  )
  (fn-expr + complete _ (?! AIError)
    (param request AIRequest)
    (call complete this request)
  )
)

(type + AIEvent)

(type + AIPartBeginEvent (is AIEvent)
  (prop + part AIMessagePart)
  (fn-do + This _
    (param part _)
    (call super)
  )
)

(type + AIContentDelta (is Union)
  (variant AITextDelta)
  (variant AIReasoningDelta)
  (variant AIToolArgumentsDelta)
  (variant AIAudioDelta)
  (variant AIImageDelta)
  (variant AIMediaProgressDelta)
)

(type + AITextDelta
  (prop + text String)
  (fn-do + This _
    (param text _)
  )
)

(type + AIReasoningDelta
  (prop + text String)
  (fn-do + This _
    (param text _)
  )
)

(type + AIToolArgumentsDelta
  (prop + text String)
  (fn-do + This _
    (param text _)
  )
)

(type + AIAudioDelta
  (prop + data ([] Byte))
  (fn-do + This _
    (param data _)
  )
)

(type + AIImageDelta
  (prop + image AIImage)
  (fn-do + This _
    (param image _)
  )
)

(type + AIMediaProgressDelta
  (prop + progress Percent)
  (fn-do + This _
    (param progress _)
  )
)

(type + AIPartDeltaEvent (is AIEvent)
  (prop + part-id String)
  (prop + delta AIContentDelta)
  (fn-do + This _
    (param part-id _)
    (param delta _)
    (call super)
  )
)

(type + AIPartEndEvent (is AIEvent)
  (prop + part AIMessagePart)
  (fn-do + This _
    (param part _)
    (call super)
  )
)

(type + AIUsageEvent (is AIEvent)
  (prop + usage AIUsage)
  (fn-do + This _
    (param usage _)
    (call super)
  )
)

(type + AIDoneEvent (is AIEvent)
  (prop + finish-reason AIFinishReason)
  (prop + usage (? AIUsage))
  (fn-do + This _
    (param finish-reason _)
    (param usage (? AIUsage))
    (call super)
  )
)

(type + AIReply
  (prop + parts (list AIMessagePart))
  (prop + usage _ (= (call AIUsage)))
  (prop + finish-reason (? AIFinishReason))
  (fn-do + apply _ (?! AIError)
    (param event AIEvent)
    (match event
      (case (: begin AIPartBeginEvent)
        (let id (call ai-part-id (. begin part)))
        (throw (call AIError (. AIErrorKind invalid-response) (str "Duplicate AI part ID: " id)) (if (call ai-part-index parts id)))
        (+= parts (. begin part))
      )
      (case (: delta AIPartDeltaEvent)
        (call apply-ai-delta parts delta)
      )
      (case (: end AIPartEndEvent)
        (let index (call ai-part-index parts (call ai-part-id (. end part))))
        (if index
          (= ([] parts index) (. end part))
          (else
            (+= parts (. end part))
          )
        )
      )
      (case (: changed AIUsageEvent)
        (= usage (call merge-ai-usage usage (. changed usage)))
      )
      (case (: done AIDoneEvent)
        (if (. done usage)
          (= usage (call merge-ai-usage usage (. done usage)))
        )
        (= finish-reason (. done finish-reason))
      )
      (throw (call AIError (. AIErrorKind invalid-response) "Unknown AI stream event"))
    )
  )
)

(fn-do + complete _ (?! AIError)
  (param provider AIProvider)
  (param request AIRequest)
  (let reply (call AIReply))
  (for (in event (call (. provider stream) request))
    (call (. reply apply) event)
  )
  (blank)
  (let finish-reason (. reply finish-reason))
  (throw (call AIError (. AIErrorKind invalid-response) "AI stream ended without a done event") (if (not finish-reason)))
  (blank)
  (let message (call AIMessage (. AIMessageRole assistant) (. reply parts)))
  (let response (call AIResponse message (. reply usage) finish-reason))
  (if (. request response-schema)
    (let decoded
      (match (call ai-final-text (. reply parts))
        (~ \json-text)
        (throw (call AIError (. AIErrorKind invalid-response) "Structured AI response was not valid JSON"))
      )
    )
    (= (. response data) decoded)
  )
  (blank)
  (return response)
)

(fn-expr + ai-response-text _
  (param response AIResponse)
  (call ai-parts-text (. response message parts))
)

(fn-expr + ai-parts-text _
  (param parts (list AIMessagePart))
  (call (. "" join) (in (. (as each AITextPart) text) parts (when (is each AITextPart))))
)

(fn-expr _ ai-final-text String
  (param parts (list AIMessagePart))
  (if-expr (> (. texts length) 0) ([] texts (- (. texts length) 1)) "")
  (where
    (lazy texts (call (of List String) (in (. (as each AITextPart) text) parts (when (is each AITextPart)))))
  )
)

(fn-expr + ai-part-id _
  (param part AIMessagePart)
  (match part
    (case (: text AITextPart)
      (. text id)
    )
    (case (: reasoning AIReasoningPart)
      (. reasoning id)
    )
    (case (: search AIWebSearchPart)
      (. search id)
    )
    (case (: file AIFilePart)
      (. file id)
    )
    (case (: image AIImagePart)
      (. image id)
    )
    (case (: audio AIAudioPart)
      (. audio id)
    )
    (case (: video AIVideoPart)
      (. video id)
    )
    (case (: tool-call AIToolCallPart)
      (. tool-call id)
    )
    (case (: tool-result AIToolResultPart)
      (. tool-result id)
    )
    (case (: refusal AIRefusalPart)
      (. refusal id)
    )
    (case (: extension AIExtensionPart)
      (. extension id)
    )
  )
)

(fn-do + ai-part-index (? Index)
  (param parts (list AIMessagePart))
  (param id String)
  (for (in index (..< 0 (. parts length)))
    (if (== (call ai-part-id ([] parts index)) id)
      (return index)
    )
  )
  (return null)
)

(fn-do _ apply-ai-delta _ (?! AIError)
  (param parts (list AIMessagePart))
  (param event AIPartDeltaEvent)
  (let index (call ai-part-index parts (. event part-id)))
  (throw (call AIError (. AIErrorKind invalid-response) (str "AI delta referenced unknown part " (. event part-id))) (if (not index)))
  (blank)
  (let part ([] parts index))
  (if (and (is (. event delta) AITextDelta) (is part AITextPart))
    (let text (as part AITextPart))
    (+= (. text text) (. (as (. event delta) AITextDelta) text))
    (else-if (and (is (. event delta) AITextDelta) (is part AIRefusalPart))
      (let refusal (as part AIRefusalPart))
      (+= (. refusal text) (. (as (. event delta) AITextDelta) text))
    )
    (else-if (and (is (. event delta) AIReasoningDelta) (is part AIReasoningPart))
      (let reasoning (as part AIReasoningPart))
      (+= (. reasoning text) (. (as (. event delta) AIReasoningDelta) text))
    )
    (else-if (and (is (. event delta) AIToolArgumentsDelta) (is part AIToolCallPart))
      (call apply-ai-tool-delta part (as (. event delta) AIToolArgumentsDelta))
    )
    (else-if (and (is (. event delta) AIAudioDelta) (is part AIAudioPart))
      (call apply-ai-audio-delta part (as (. event delta) AIAudioDelta))
    )
    (else-if (and (is (. event delta) AIImageDelta) (is part AIImagePart))
      (let image (as part AIImagePart))
      (= (. image image) (. (as (. event delta) AIImageDelta) image))
    )
    (else-if (and (is (. event delta) AIMediaProgressDelta) (is part AIVideoPart))
      (let video (as part AIVideoPart))
      (= (. video video progress) (. (as (. event delta) AIMediaProgressDelta) progress))
    )
    (else
      (throw (call AIError (. AIErrorKind invalid-response) "AI delta type did not match its part"))
    )
  )
)

(fn-do _ apply-ai-tool-delta _
  (param tool AIToolCallPart)
  (param delta AIToolArgumentsDelta)
  (let previous
    (match (. tool arguments)
      (case (exact Null)
        ""
      )
      (case (: text String)
        text
      )
      (default
        (call to-json (. tool arguments))
      )
    )
  )
  (let arrived (str previous (. delta text)))
  (let decoded
    (match? arrived
      (~ \json-text)
    )
  )
  (= (. tool arguments) (?? decoded (as arrived JSON)))
)

(fn-do _ apply-ai-audio-delta _ (?! AIError)
  (param audio AIAudioPart)
  (param delta AIAudioDelta)
  (let source (. audio audio file source))
  (throw (call AIError (. AIErrorKind invalid-response) "Audio delta requires an in-memory byte source") (if (is-not source AIBytesSource)))
  (let previous (. (as source AIBytesSource) data))
  (let combined ([] Byte (+ (. previous size) (. delta data size))))
  (= ([] combined (..< 0 (. previous size))) previous)
  (= ([] combined (..< (. previous size) (. combined size))) (. delta data))
  (= (. audio audio file source) (call AIBytesSource combined))
)

(fn-expr _ merge-ai-usage _
  (param target AIUsage)
  (param update AIUsage)
  (call AIUsage
    (block
      (:input-tokens (?? (. update input-tokens) (. target input-tokens)))
      (:output-tokens (?? (. update output-tokens) (. target output-tokens)))
      (:total-tokens (?? (. update total-tokens) (. target total-tokens)))
      (:cached-input-tokens (?? (. update cached-input-tokens) (. target cached-input-tokens)))
      (:cache-creation-tokens (?? (. update cache-creation-tokens) (. target cache-creation-tokens)))
      (:cache-read-tokens (?? (. update cache-read-tokens) (. target cache-read-tokens)))
      (:reasoning-tokens (?? (. update reasoning-tokens) (. target reasoning-tokens)))
      (:thought-tokens (?? (. update thought-tokens) (. target thought-tokens)))
      (:tool-prompt-tokens (?? (. update tool-prompt-tokens) (. target tool-prompt-tokens)))
    )
  )
)
