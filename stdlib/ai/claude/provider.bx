(import ./continuation)
(import ./history)
(import ./subagents)
(import ./tool-host)
(import ./tools)
(import ./wire)
(import /ai/model)
(import /ai/tool-tasks)
(import /core/arena)
(import /data/json)
(import /data/jsonl)
(import /data/jsonrpc)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)
(import /stream/aggregate)
(blank)
(prop + claude-default-model _ (= "claude-opus-5-5"))
(prop + claude-default-effort _ (= "xhigh"))

(type + ClaudeVariables (is (fn-type (? (map String String)))))

(type + ClaudeCode (is AIProvider)
  (prop + executable (? String))
  (prop + working-directory (? String))
  (prop + tools (? (list String)))
  (prop + is-safe-mode Bool)
  (prop + allowed-tools (? (list String)))
  (prop + permission-mode (? String))
  (prop + is-persistent Bool)
  (prop + has-task-tools Bool)
  (prop + effort (? String))
  (prop + variables (? ClaudeVariables))
  (prop + mcp-servers (list ClaudeMCPServer))
  (prop + thinking-display (? String))
  (prop + toolkits (list AIToolkit))
  (prop + running Size)
  (blank)
  (prop _ links (list ClaudeLink))
  (fn-do + This _
    (param executable (? String) (= null))
    (param working-directory (? String) (= null))
    (param tools (? (list String)) (= null))
    (param is-safe-mode _ (= false))
    (param allowed-tools (? (list String)) (= null))
    (param permission-mode (? String) (= null))
    (param is-persistent _ (= true))
    (param has-task-tools _ (= false))
    (param effort (? String) (= null))
    (param variables (? ClaudeVariables) (= null))
    (param mcp-servers _ (= (call (of List ClaudeMCPServer))))
    (param thinking-display (? String) (= null))
    (param toolkits _ (= (call (of List AIToolkit))))
    (call super)
  )
  (fn-do + account (? AIAccount) (?! AIError)
    (throw (call AIError (. AIErrorKind unknown) (str "Claude Code did not report its account: " failure)) (on-error (: failure Error)))
    (let base (only-if (call variables) (if variables)))
    (let program (?? executable (call claude-executable)))
    (return-if (call AIAccount (. AIAccountStatus missing)) (if (not program)))
    (let process (use (call Process program (. ProcessStderr discard) (list "auth" "status" "--json") working-directory (call claude-environment base))))
    (let output (as process String))
    (let ignored (call (. process wait) null))
    (return (call claude-account (catch? (call parse-json output))))
  )
  (fn-expr + tool-title (? String)
    (param call AIToolCallPart)
    (call claude-tool-title call)
  )
  (fn-expr + tool-kind AIToolKind
    (param call AIToolCallPart)
    (call claude-tool-kind call)
  )
  (fn-expr + tool-input (? String)
    (param call AIToolCallPart)
    (call claude-tool-input call)
  )
  (fn-do + read-task-output (? String)
    (param task AIToolTask)
    (for (in link links)
      (return-if (call (. link task-output) (. task id)) (if (call (. link has-task) (. task id))))
    )
    (return null)
  )
  (fn-do + stop-work _ (?! AIError)
    (param parts (list AIMessagePart))
    (let link (call linked (call claude-parts-session parts)))
    (return-if (if (not link)))
    (call (. link halt))
  )
  (fn-do + stream (stream AIEvent)
    (param request AIRequest)
    (if toolkits
      (yield-all (call hosted-stream request))
      (return)
    )
    (let turn (use (call begin-turn request)))
    (for (in event (. turn events))
      (yield event)
    )
    (throw (. turn failure) (if (. turn failure)))
  )
  (fn-do + follow-up (stream AIEvent)
    (param parts (list AIMessagePart))
    (let link (call linked (call claude-parts-session parts)))
    (return-if (if (not link)))
    (let turn (call (. link follow)))
    (return-if (if (not turn)))
    (use turn)
    (let calls (call (of Map String AIToolCallPart)))
    (for (in event (. turn events))
      (yield-all (call hosted-events event (. turn host) calls))
    )
    (throw (. turn failure) (if (. turn failure)))
  )
  (fn-do + steer _ (?! AIError)
    (param parts (list AIMessagePart))
    (param prompt String)
    (let link (call linked (call claude-parts-session parts)))
    (throw (call AIError (. AIErrorKind invalid-request) "Claude Code has no running turn to steer") (if (or (not link) (. link is-closing))))
    (call (. link steer) prompt)
  )
  (fn-do + subagents (list AISubagent) (?! Error)
    (param parts (list AIMessagePart))
    (return (call claude-subagents parts working-directory))
  )
  (fn-do + caught-up (? (list AIMessagePart)) (?! Error)
    (param parts (list AIMessagePart))
    (return (call claude-caught-up parts working-directory))
  )
  (fn-do _ hosted-stream (stream AIEvent)
    (param request AIRequest)
    (let turn (use (call begin-turn (call ai-toolkit-request toolkits request) request)))
    (let calls (call (of Map String AIToolCallPart)))
    (for (in event (. turn events))
      (yield-all (call hosted-events event (. turn host) calls))
    )
    (throw (. turn failure) (if (. turn failure)))
  )
  (fn-do _ hosted-events (stream AIEvent)
    (param event AIEvent)
    (param hosting (? ClaudeToolHost))
    (param calls (map String AIToolCallPart))
    (match event
      (case (: begun AIPartBeginEvent)
        (let renamed (call claude-hosted-call (. begun part)))
        (if renamed
          (= ([] calls (. renamed call-id)) renamed)
          (yield (call AIPartBeginEvent renamed))
          (else-if (not (call claude-answers-hosted (. begun part) calls))
            (yield event)
          )
        )
      )
      (case (: ended AIPartEndEvent)
        (let renamed (call claude-hosted-call (. ended part)))
        (if renamed
          (= ([] calls (. renamed call-id)) renamed)
          (yield (call AIPartEndEvent renamed))
          (else-if (= (| (: result AIToolResultPart)) (. ended part))
            (let call ([] calls (. result call-id)))
            (let outcome (only-if (call (?. hosting take) (. result call-id) (. call tool-name)) (if call)))
            (if (= (| (: made AIToolkitResult)) (?. outcome result))
              (yield-all (call ai-toolkit-parts (!! call) made))
              (else-if (= (| (: failure String)) (?. outcome failure))
                (yield (call AIPartEndEvent (call ai-toolkit-failure (!! call) failure)))
              )
              (else
                (yield event)
              )
            )
          )
          (else
            (yield event)
          )
        )
      )
      (default
        (yield event)
      )
    )
  )
  (fn-do _ begin-turn ClaudeTurn (?! AIError)
    (param request AIRequest)
    (param original (? AIRequest) (= null))
    (let servers (call (of List ClaudeMCPServer) mcp-servers))
    (if toolkits
      (+= servers (call claude-hosted-server toolkits))
    )
    (let prompt (call claude-prompt request))
    (let plan (call claude-resume request))
    (let settings
      (call (. "\n" join)
        (block
          (arg
            (call claude-arguments
              (block
                (arg request)
                (arg tools)
                (arg is-safe-mode)
                (arg allowed-tools)
                (arg permission-mode)
                (arg (call ClaudeResume))
                (arg is-persistent)
                (arg effort)
                (arg servers)
                (arg thinking-display)
              )
            )
          )
        )
      )
    )
    (let live (call reusable plan settings))
    (return-if (call (. live ask) prompt original) (if live))
    (let base (only-if (call variables) (if variables)))
    (let program (?? executable (call claude-executable)))
    (throw (call AIError (. AIErrorKind unknown) "Claude Code is not installed") (if (not program)))
    (let point (. plan point))
    (let merges
      (block
        (case? (and point (call claude-is-stranded point working-directory))
          (list (call ClaudeMark point))
        )
        (default
          (. plan merges)
        )
      )
    )
    (let resume (if-expr merges (call ClaudeResume (call claude-merge-history merges)) plan))
    (let origin (if-expr merges (. ([] merges (- (. merges length) 1)) point) (. plan point)))
    (let arguments
      (call claude-arguments
        (block
          (arg request)
          (arg tools)
          (arg is-safe-mode)
          (arg allowed-tools)
          (arg permission-mode)
          (arg resume)
          (arg is-persistent)
          (arg effort)
          (arg servers)
          (arg thinking-display)
        )
      )
    )
    (let process (call claude-process program arguments working-directory has-task-tools base))
    (let basis (only-if (call claude-marks-basis merges) (if merges)))
    (let host (only-if (call ClaudeToolHost toolkits) (if toolkits)))
    (let link (call ClaudeLink this process settings origin basis host))
    (+= links link)
    (+= running 1)
    (return (call (. link ask) prompt original))
  )
  (fn-do _ reusable (? ClaudeLink)
    (param plan ClaudeResume)
    (param settings String)
    (let point (. plan point))
    (return-if null (if (or (not point) (. plan forks) (!= (. plan merges) null))))
    (for (in link links)
      (return-if link (if (and (== (. link session) (. point session)) (== (. link settings) settings) (not (. link is-closing)))))
    )
    (return null)
  )
  (fn-do _ linked (? ClaudeLink)
    (param session (? String))
    (let found (? ClaudeLink))
    (for (in link links)
      (if (and (!= session null) (== (. link session) session) (or (not found) (not (. link is-closing))))
        (= found link)
      )
    )
    (return found)
  )
  (fn-do _ forget _
    (param link ClaudeLink)
    (let index (. links length))
    (while (> index 0)
      (-= index 1)
      (if (== (as ([] links index) Pointer) (as link Pointer))
        (call (. links remove) index)
        (-= running 1)
      )
    )
  )
)

(fn-do + claude-executable (? String)
  (param directories (? (list String)) (= null))
  (for (in directory (?? directories (call claude-search-directories)))
    (let candidate (str directory "/claude"))
    (return-if candidate (if (. (call Path candidate) is-file)))
  )
  (return null)
)

(fn-expr + claude-environment (map String String)
  (param variables (? (map String String)) (= null))
  (spread (?? variables (call environment)))
  (pipe ?> (not (call claude-scrubs-variable ([] each 0))))
  (pipe *> (tuple ([] each 0) ([] each 1)))
  (pipe |> Map)
)

(type _ ClaudeLink
  (prop + settings String)
  (prop + is-closing _ (= false))
  (blank)
  (prop _ provider ClaudeCode)
  (prop _ process Process)
  (prop _ decoder _ (:= (call ClaudeDecoder)))
  (prop _ errors _ (:= (call (of Semaphore String))))
  (prop _ turn (? ClaudeTurn))
  (prop _ queued (list ClaudeTurn))
  (prop _ heard (? ClaudeTurn))
  (prop _ follower (? (of SyncBufferedChannel ClaudeTurn)))
  (prop _ tasks (map String Bool))
  (prop _ answers (map String (of SyncBufferedChannel ClaudeAnswer)))
  (prop _ is-owed _ (= false))
  (prop _ is-hushed _ (= false))
  (prop _ awaited Size)
  (prop _ is-interrupting _ (= false))
  (prop _ requests Size)
  (prop _ host (? ClaudeToolHost))
  (fn-do + This _
    (param owner ClaudeCode)
    (param child Process)
    (param settings _)
    (param origin (? ClaudePoint) (= null))
    (param basis (? String) (= null))
    (param host (? ClaudeToolHost) (= null))
    (lazy provider owner)
    (lazy process child)
    (= (. this host) host)
    (= (. decoder permission-mode) (. owner permission-mode))
    (= (. decoder parent) origin)
    (= (. decoder basis) basis)
    (let hosted (call (of List String)))
    (if host
      (+= hosted claude-tool-server)
    )
    (catch (call (. process write) (str (call claude-initialize-line (call request-id) hosted) "\n")))
    (do-new
      (call drain)
    )
    (do-new
      (call run)
    )
  )
  (fn-expr + session _ :get
    (. decoder session-id)
  )
  (fn-do + ask ClaudeTurn
    (param prompt JSON)
    (param request (? AIRequest) (= null))
    (= is-hushed false)
    (let asked (call ClaudeTurn this prompt request))
    (do
      (inline (call (?. follower close)))
    )
    (= follower null)
    (if (or turn awaited)
      (+= queued asked)
      (else
        (call start asked)
      )
    )
    (return asked)
  )
  (fn-do + steer _
    (param prompt String)
    (catch (call (. process write) (str (call claude-user-line prompt "next") "\n")))
  )
  (fn-do + follow (? ClaudeTurn)
    (let pending heard)
    (= heard null)
    (return-if pending (if pending))
    (return-if null (if is-closing))
    (do
      (inline (call (?. follower close)))
    )
    (let waiting (call (of SyncBufferedChannel ClaudeTurn)))
    (= follower waiting)
    (return (<- waiting))
  )
  (fn-expr + has-task Bool
    (param id String)
    (has tasks id)
  )
  (fn-do + task-output (? String)
    (param id String)
    (return-if null (if is-closing))
    (let asked (call request-id))
    (let waiting (call (of SyncBufferedChannel ClaudeAnswer)))
    (= ([] answers asked) waiting)
    (finally
      (-= ([] answers asked))
    )
    (catch (call (. process write) (str (call claude-task-output-line asked id) "\n")))
    (let answer (<- waiting))
    (return (call claude-task-output-text (?. answer response)))
  )
  (fn-do + halt _
    (= is-hushed true)
    (= is-owed false)
    (for (in (tuple id _) tasks)
      (catch (call (. process write) (str (call claude-stop-task-line (call request-id) id) "\n")))
    )
    (catch (call (. process write) (str (call claude-interrupt-line (call request-id) true) "\n")))
    (call calm)
  )
  (fn-do + leave _
    (param left ClaudeTurn)
    (if (and turn (== (as turn Pointer) (as left Pointer)))
      (call interrupt)
      (else
        (= queued (call List (?> queued (!= (as each Pointer) (as left Pointer)))))
        (call (. left settle) null)
      )
    )
  )
  (fn-do _ start _
    (param next ClaudeTurn)
    (= turn next)
    (= is-owed false)
    (let missed heard)
    (= heard null)
    (if missed
      (for (in event (. missed events))
        (if (is-not event AIDoneEvent)
          (call (. next deliver) event)
        )
      )
    )
    (catch (call (. process write) (str (call claude-user-line (?? (. next prompt) (as "" JSON))) "\n")))
  )
  (fn-do _ interrupt _
    (return-if (if is-interrupting))
    (= is-interrupting true)
    (catch (call (. process write) (str (call claude-interrupt-line (call request-id)) "\n")))
  )
  (fn-do _ run _
    (let problem (? String))
    (call listen
      (block
        (on-error (: failure Error)
          (= problem (str failure))
        )
      )
    )
    (if problem
      (call (. process terminate))
    )
    (let status (call (. process wait) null))
    (let output (?? (call (. errors await)) ""))
    (call (. process close))
    (call (. provider forget) this)
    (= is-closing true)
    (do
      (inline (call (?. follower close)))
    )
    (= follower null)
    (for (in (tuple id _) tasks)
      (call (. provider tool-tasks settle) id (. AIToolTaskStatus stopped))
    )
    (= tasks (call (of Map String Bool)))
    (for (in (tuple _ waiting) answers)
      (call (. waiting close))
    )
    (= answers (call (of Map String (of SyncBufferedChannel ClaudeAnswer))))
    (let failure (call AIError (. AIErrorKind unknown) (?? problem (call claude-exit-reason (?? status 0) (call (. output trim))))))
    (do
      (inline (call (?. turn settle) failure))
    )
    (= turn null)
    (for (in waiting queued)
      (call (. waiting settle) failure)
    )
    (call (. queued clear))
  )
  (fn-do _ drain _
    (let text (as (!! (. process stderr)) String))
    (call (. errors post) text)
  )
  (fn-do _ listen _ (?! JSONLineError) (?! IOError)
    (let scratch (use (call Arena)))
    (for (in line (~> process \json-line (with (call JSONParser scratch))))
      (call hear line)
    )
  )
  (fn-do _ hear _
    (param line JSON)
    (let hosted (call claude-mcp-message line))
    (if hosted
      (do-new
        (inline (call serve hosted))
      )
      (return)
    )
    (let answer (call claude-answer line))
    (if answer
      (let waiting ([] answers (. answer request-id)))
      (if waiting
        (<- waiting answer)
        (call (. waiting close))
      )
      (return)
    )
    (call track (call claude-task-event line))
    (if (call claude-is-requesting line)
      (= is-owed false)
    )
    (call deliver line
      (block
        (on-error (: failure AIError)
          (do
            (inline (call (?. turn settle) failure))
          )
        )
      )
    )
    (if (call claude-is-result line)
      (= awaited (call claude-queued-turns line))
      (call end-turn)
    )
  )
  (fn-do _ serve _
    (param hosted ClaudeMCPMessage)
    (let reply (?? (call (?. host answer) (. hosted message) (?? (?. turn request) (call AIRequest ""))) (call claude-mcp-refusal hosted)))
    (catch (call (. process write) (str (call claude-mcp-reply-line (. hosted request-id) reply) "\n")))
  )
  (fn-do _ deliver _ (?! AIError)
    (param line JSON)
    (for (in event (call (. decoder decode) line))
      (if (or turn (is-not event AIDoneEvent))
        (call (. (call current) deliver) event)
      )
    )
  )
  (fn-do _ current ClaudeTurn
    (return-if turn (if turn))
    (let started (call ClaudeTurn this))
    (= turn started)
    (= is-owed false)
    (if is-hushed
      (call (. started abandon))
      (return started)
    )
    (let waiting follower)
    (= follower null)
    (if waiting
      (<- waiting started)
      (call (. waiting close))
      (else
        (= heard started)
      )
    )
    (return started)
  )
  (fn-do _ track _
    (param event (? ClaudeTaskEvent))
    (let board (. provider tool-tasks))
    (match? event
      (case (call .started id call kind title is-backgrounded)
        (= ([] tasks id) is-backgrounded)
        (call (. board add) (call AIToolTask id call kind title is-backgrounded))
      )
      (case (call .progressed id summary)
        (call (. board note) id summary null)
      )
      (case (call .updated id status is-backgrounded)
        (if (and (!= is-backgrounded null) (has tasks id))
          (= ([] tasks id) is-backgrounded)
        )
        (call (. board note) id null is-backgrounded)
        (let ended (call claude-task-status status))
        (if ended
          (-= ([] tasks id))
          (call (. board settle) id ended)
          (call calm)
        )
      )
      (case (call .notified id status path summary)
        (let behind (?? (?. (call (. board task) id) is-backgrounded) ([] tasks id) true))
        (= is-owed (or is-owed (and behind (not is-hushed))))
        (-= ([] tasks id))
        (call (. board settle) id (?? (call claude-task-status status) (. AIToolTaskStatus completed)) summary)
        (call keep-output id path)
        (call calm)
      )
    )
  )
  (fn-do _ keep-output _
    (param id String)
    (param path (? String))
    (let task (call (. provider tool-tasks task) id))
    (return-if (if (or (not task) (not path))))
    (let text (catch? (call read-file-text (call Path path 0))))
    (if (!= text null)
      (call (. task show-output) text)
    )
  )
  (fn-do _ calm _
    (return-if (if (or (not is-hushed) turn)))
    (call release)
  )
  (fn-do _ end-turn _
    (let ended turn)
    (= turn null)
    (= is-interrupting false)
    (do
      (inline (call (?. ended settle) null))
    )
    (call (. decoder resume-turn))
    (if (and (. queued length) (not awaited))
      (let next ([] queued 0))
      (call (. queued remove) 0)
      (call start next)
      (else
        (call release)
      )
    )
  )
  (fn-do _ release _
    (return-if (if (or is-closing turn (. queued length) (. tasks length) is-owed awaited)))
    (= is-closing true)
    (do
      (inline (call (?. follower close)))
    )
    (= follower null)
    (catch (call (. process close-input)))
  )
  (fn-do _ request-id String
    (+= requests 1)
    (return (str "brix-" requests))
  )
)

(type _ ClaudeTurn
  (prop + events _ (:= (call (of SyncBufferedChannel AIEvent))))
  (prop + failure (? AIError))
  (prop + prompt (? JSON))
  (prop + request (? AIRequest))
  (prop + is-settled _ (= false))
  (blank)
  (prop _ link ClaudeLink)
  (prop _ is-abandoned _ (= false))
  (fn-do + This _
    (param link _)
    (param prompt (? JSON) (= null))
    (param request (? AIRequest) (= null))
  )
  (fn-expr + host (? ClaudeToolHost) :get
    (. link host)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call abandon)
  )
  (fn-do + abandon _
    (return-if (if is-settled))
    (= is-abandoned true)
    (call (. link leave) this)
  )
  (fn-do + deliver _
    (param event AIEvent)
    (return-if (if (or is-abandoned is-settled)))
    (<- events event)
  )
  (fn-do + settle _
    (param problem (? AIError))
    (return-if (if is-settled))
    (= is-settled true)
    (= failure problem)
    (if (not is-abandoned)
      (call (. events close))
    )
  )
)

(fn-do _ claude-process Process (?! AIError)
  (param program String)
  (param arguments (list String))
  (param directory (? String))
  (param has-task-tools _ (= false))
  (param base (? (map String String)) (= null))
  (if (and directory (not (. (call Path directory 0) is-dir)))
    (throw
      (call AIError
        (block
          (arg (. AIErrorKind invalid-request))
          (arg (str "Claude Code can't run in " directory " because it no longer exists"))
        )
      )
    )
  )
  (throw (call AIError (. AIErrorKind unknown) (str "Claude Code did not start: " failure)) (on-error (: failure Error)))
  (blank)
  (let variables (call claude-environment base))
  (if has-task-tools
    (= ([] variables "CLAUDE_CODE_ENABLE_TODO_TOOLS") "1")
  )
  (return (call Process program (. ProcessStderr capture) arguments directory variables))
)

(fn-expr _ claude-parts-session (? String)
  (param parts (list AIMessagePart))
  (call last (?*> parts (call claude-part-session each)))
)

(fn-expr _ claude-search-directories (list String)
  (spread (call (. (?? (call env "PATH") "") split) ":"))
  (item? (only-if (str home "/.local/bin") (if home)))
  (item "/opt/homebrew/bin")
  (item "/usr/local/bin")
  (pipe |> List)
  (where
    (lazy home (call env "HOME"))
  )
)

(fn-expr _ claude-scrubs-variable _
  (param name String)
  (or (call (. name starts-with) "ANTHROPIC_") (== name "CLAUDECODE") is-claude-setting)
  (where
    (lazy is-claude-setting (and (call (. name starts-with) "CLAUDE_") (!= name "CLAUDE_CONFIG_DIR")))
  )
)

(fn-expr _ claude-exit-reason _
  (param status Int)
  (param errors String)
  (case? (> (. errors length) 0)
    errors
  )
  (default
    (str "Claude Code exited with status " status)
  )
)

(fn-expr _ claude-mcp-refusal JSON
  (param hosted ClaudeMCPMessage)
  (call (of Map String JSON)
    (block
      (:jsonrpc "2.0")
      (:id (?? asked (as 0 JSON)))
      (:error (. (call JSONRPCError .method-not-found (str "Claude Code asked for " (. hosted server) ", which this app does not serve")) json))
    )
  )
  (where
    (lazy asked
      (match? (. hosted message)
        (case (map "id" id)
          id
        )
      )
    )
  )
)
