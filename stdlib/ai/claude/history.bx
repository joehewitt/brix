(import ./wire)
(import /ai/model)
(import /data/json)
(import /os/env)
(import /os/file)
(import /os/path)
(import /sys/random.h)

(type + ClaudeHistory (is Tuple)
  (prop + rows (of Map String (map String JSON)))
  (prop + tip (? String))
)

(fn-do + claude-merge-history ClaudePoint (?! AIError)
  (param marks (list ClaudeMark))
  (param home (? Path) (= null))
  (throw (call claude-history-error) (if (not (. marks length))))
  (let root (?? home (call claude-history-home)))
  (let directory (call claude-history-directory root (. ([] marks (- (. marks length) 1)) point session)))
  (throw (call claude-history-error) (if (not directory)))
  (let histories (call (of Map String ClaudeHistory)))
  (let merged (call (of List (map String JSON))))
  (let seen (call (of Map String Bool)))
  (for (in mark marks)
    (let session (. mark point session))
    (if (not (has histories session))
      (= ([] histories session) (call claude-history session (call claude-history-directory root session)))
    )
    (for (in row (call claude-history-chain (!! ([] histories session)) (. mark point entry)))
      (let id (?? (call claude-history-uuid row) ""))
      (if (not (has seen id))
        (= ([] seen id) true)
        (+= merged row)
      )
    )
  )
  (throw (call claude-history-error) (if (not (. merged length))))
  (blank)
  (let session (call claude-session-uuid))
  (let lines (call (of List String)))
  (let previous (? String))
  (for (in row merged)
    (let copy (call (of Map String JSON)))
    (for (in (tuple key value) row)
      (= ([] copy key) value)
    )
    (= ([] copy "sessionId") session)
    (if (and previous (not (call claude-history-boundary row)))
      (= ([] copy "parentUuid") previous)
    )
    (= previous (call claude-history-uuid row))
    (+= lines (call to-json copy))
  )
  (call claude-write-history (/ directory (str session ".jsonl")) lines)
  (return (call ClaudePoint session previous))
)

(fn-do _ claude-write-history _ (?! AIError)
  (param path Path)
  (param lines (list String))
  (throw (call AIError (. AIErrorKind unknown) (str "Claude Code's history could not be written: " failure)) (on-error (: failure Error)))
  (call write-file-atomically path (str (call (. "\n" join) lines) "\n"))
)

(fn-expr + claude-history-home Path
  (call Path (?? (call env "CLAUDE_CONFIG_DIR") (str (?? (call env "HOME") "/tmp") "/.claude")) 0)
)

(fn-do + claude-history-directory (? Path)
  (param home Path)
  (param session String)
  (let projects (/ home "projects"))
  (return-if (if (not (. projects is-dir))))
  (for (in folder (. projects contents))
    (let candidate (/ folder (str session ".jsonl")))
    (return-if folder (if (. candidate is-file)))
  )
  (return null)
)

(fn-do + claude-session-folders (list Path)
  (param session String)
  (param directory (? String) (= null))
  (param home (? Path) (= null))
  (let root (?? home (call claude-history-home)))
  (let folders (call (of List Path)))
  (if directory
    (let own (/ root "projects" (call claude-project-slug directory)))
    (+= folders own)
    (return-if folders (if (. (/ own (str session ".jsonl")) is-file)))
  )
  (let found (call claude-history-directory root session))
  (if found
    (+= folders found)
  )
  (return folders)
)

(fn-do + claude-session-path (? Path)
  (param session String)
  (param directory (? String) (= null))
  (param home (? Path) (= null))
  (for (in folder (call claude-session-folders session directory home))
    (let path (/ folder (str session ".jsonl")))
    (return-if path (if (. path is-file)))
  )
  (return null)
)

(fn-do + claude-project-slug String
  (param directory String)
  (let kept (call (of List String)))
  (for (in char directory)
    (if (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z')) (and (>= char '0') (<= char '9')))
      (+= kept (str char))
      (else-if (> (as char U32) 65535)
        (+= kept "--")
      )
      (else
        (+= kept "-")
      )
    )
  )
  (return (call (. "" join) kept))
)

(fn-do _ claude-history ClaudeHistory (?! AIError)
  (param session String)
  (param directory (? Path))
  (throw (call claude-history-error) (on-error Error))
  (throw (call claude-history-error) (if (not directory)))
  (let text (call read-file-text (/ directory (str session ".jsonl"))))
  (let rows (call (of Map String (map String JSON))))
  (let tip (? String))
  (for (in line (call (. text split) "\n"))
    (if (not (. (call (. line trim)) length))
      (continue)
    )
    (let value (catch? (call parse-json line)))
    (let row
      (match? value
        (case (map String JSON))
      )
    )
    (let id (only-if (call claude-history-uuid row) (if row)))
    (if id
      (= ([] rows id) (!! row))
      (= tip id)
    )
  )
  (return (call ClaudeHistory rows tip))
)

(fn-do _ claude-history-chain (list (map String JSON)) (?! AIError)
  (param history ClaudeHistory)
  (param entry (? String))
  (let chain (call (of List (map String JSON))))
  (let current (?? entry (. history tip)))
  (while current
    (let row ([] (. history rows) current))
    (throw (call claude-history-error) (if (or (not row) (> (. chain length) (. history rows length)))))
    (+= chain row)
    (= current
      (match? ([] row "parentUuid")
        (case String)
      )
    )
  )
  (let ordered (call (of List (map String JSON))))
  (++= ordered (call (. chain reversed)))
  (return ordered)
)

(fn-expr _ claude-history-uuid (? String)
  (param row (? (map String JSON)))
  (match? (?[] row "uuid")
    (case String)
  )
)

(fn-expr _ claude-history-boundary _
  (param row (map String JSON))
  (== subtype "compact_boundary")
  (where
    (lazy subtype
      (match? ([] row "subtype")
        (case String)
      )
    )
  )
)

(fn-expr _ claude-history-error _
  (call AIError (. AIErrorKind invalid-request) "Claude Code no longer has the history this chat needs")
)

(fn-do _ claude-session-uuid String
  (let bytes ([] Byte 16))
  (call C:getentropy bytes 16)
  (= ([] bytes 6) (/or/ (/and/ ([] bytes 6) 0x0f) 0x40))
  (= ([] bytes 8) (/or/ (/and/ ([] bytes 8) 0x3f) 0x80))
  (let hex String (as bytes Hex))
  (return (str ([] hex (..< 0 8)) "-" ([] hex (..< 8 12)) "-" ([] hex (..< 12 16)) "-" ([] hex (..< 16 20)) "-" ([] hex (..< 20 32))))
)
