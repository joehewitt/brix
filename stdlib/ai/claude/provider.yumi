────────────────────
+ This
    - executable String? = null
    - working-directory String? = null
    - tools [String]? = null
    - is-safe-mode = false
    - allowed-tools [String]? = null
    - permission-mode String? = null
    - is-persistent = true
    - has-task-tools = false
    - effort String? = null
    - variables ClaudeVariables? = null
    - mcp-servers = List'ClaudeMCPServer()
    - thinking-display String? = null
    - toolkits = List'AIToolkit()

super()

────────────────────
+ do account AIAccount? ?! AIError

?! AIError(AIErrorKind.unknown, "Claude Code did not report its account: $failure")
    catch failure Error
. base = variables() if variables
. program = executable ?? claude-executable()
=? AIAccount(AIAccountStatus.missing) if !program
. process = use Process(program, ProcessStderr.discard, ["auth", "status", "--json"], working-directory, claude-environment(base))
. output = process as String
. ignored = process.wait(null)
= claude-account(catch? parse-json(output))

────────────────────
+ tool-title String?
    - call AIToolCallPart

claude-tool-title(call)

────────────────────
+ tool-kind AIToolKind
    - call AIToolCallPart

claude-tool-kind(call)

────────────────────
+ tool-input String?
    - call AIToolCallPart

claude-tool-input(call)

────────────────────
+ do read-task-output String?
    - task AIToolTask

for link in links
    =? link.task-output(task.id) if link.has-task(task.id)
= null

────────────────────
+ do stop-work ?! AIError
    - parts [AIMessagePart]

. link = linked(claude-parts-session(parts))
=? if !link
link.halt()

────────────────────
+ do stream <AIEvent>
    - request AIRequest

if toolkits
    <<= hosted-stream(request)
    =
. turn = use begin-turn(request)
for event in turn.events
    <= event
?! turn.failure
    if turn.failure

────────────────────
+ do follow-up <AIEvent>
    - parts [AIMessagePart]

. link = linked(claude-parts-session(parts))
=? if !link
. turn = link.follow()
=? if !turn
use turn
. calls = Map'String'AIToolCallPart()
for event in turn.events
    <<= hosted-events(event, turn.host, calls)
?! turn.failure
    if turn.failure

────────────────────
+ do steer ?! AIError
    - parts [AIMessagePart]
    - prompt String

. link = linked(claude-parts-session(parts))
?! AIError(AIErrorKind.invalid-request, "Claude Code has no running turn to steer")
    if !link || link.is-closing
link.steer(prompt)

────────────────────
+ do subagents [AISubagent] ?! Error
    - parts [AIMessagePart]

= claude-subagents(parts, working-directory)

────────────────────
+ do caught-up [AIMessagePart]? ?! Error
    - parts [AIMessagePart]

= claude-caught-up(parts, working-directory)

────────────────────
_ do hosted-stream <AIEvent>
    - request AIRequest

. turn = use begin-turn(ai-toolkit-request(toolkits, request), request)
. calls = Map'String'AIToolCallPart()
for event in turn.events
    <<= hosted-events(event, turn.host, calls)
?! turn.failure
    if turn.failure

────────────────────
_ do hosted-events <AIEvent>
    - event AIEvent
    - hosting ClaudeToolHost?
    - calls [String = AIToolCallPart]

do match event
    | begun AIPartBeginEvent
        . renamed = claude-hosted-call(begun.part)
        if renamed
            calls[renamed.call-id] = renamed
            <= AIPartBeginEvent(renamed)
        else if !claude-answers-hosted(begun.part, calls)
            <= event
    | ended AIPartEndEvent
        . renamed = claude-hosted-call(ended.part)
        if renamed
            calls[renamed.call-id] = renamed
            <= AIPartEndEvent(renamed)
        else if | result AIToolResultPart = ended.part
            . call = calls[result.call-id]
            . outcome = hosting?.take(result.call-id, call.tool-name) if call
            if | made AIToolkitResult = outcome?.result
                <<= ai-toolkit-parts(call!, made)
            else if | failure String = outcome?.failure
                <= AIPartEndEvent(ai-toolkit-failure(call!, failure))
            else
                <= event
        else
            <= event
    ??
        <= event

────────────────────
_ do begin-turn ClaudeTurn ?! AIError
    - request AIRequest
    - original AIRequest? = null

. servers = List'ClaudeMCPServer(mcp-servers)
if toolkits
    servers += claude-hosted-server(toolkits)
. prompt = claude-prompt(request)
. plan = claude-resume(request)
. settings = "\n".join(claude-arguments(request, tools, is-safe-mode, allowed-tools, permission-mode, ClaudeResume(), is-persistent, effort, servers, thinking-display))
. live = reusable(plan, settings)
=? live.ask(prompt, original) if live
. base = variables() if variables
. program = executable ?? claude-executable()
?! AIError(AIErrorKind.unknown, "Claude Code is not installed")
    if !program
. point = plan.point
. merges = if point && claude-is-stranded(point, working-directory) then [ClaudeMark(point)] else plan.merges
. resume = if merges then ClaudeResume(claude-merge-history(merges)) else plan
. origin = if merges then merges[merges.length - 1].point else plan.point
. arguments = claude-arguments
    - request
    - tools
    - is-safe-mode
    - allowed-tools
    - permission-mode
    - resume
    - is-persistent
    - effort
    - servers
    - thinking-display
. process = claude-process(program, arguments, working-directory, has-task-tools, base)
. basis = claude-marks-basis(merges) if merges
. host = ClaudeToolHost(toolkits) if toolkits
. link = ClaudeLink(this, process, settings, origin, basis, host)
links += link
running += 1
= link.ask(prompt, original)

────────────────────
_ do reusable ClaudeLink?
    - plan ClaudeResume
    - settings String

. point = plan.point
=? null if !point || plan.forks || plan.merges != null
for link in links
    =? link if link.session == point.session && link.settings == settings && !link.is-closing
= null

────────────────────
_ do linked ClaudeLink?
    - session String?

. found ClaudeLink?
for link in links
    if session != null && link.session == session && (!found || !link.is-closing)
        found = link
= found

────────────────────
_ do forget
    - link ClaudeLink

. index = links.length
while index > 0
    index -= 1
    if links[index] as Pointer == link as Pointer
        links.remove(index)
        running -= 1

━━━━━━━━━━━━━━━━━━━━
+ do claude-executable String?
    - directories [String]? = null

for directory in directories ?? claude-search-directories()
    . candidate = "$directory/claude"
    =? candidate if Path(candidate).is-file
= null

━━━━━━━━━━━━━━━━━━━━
+ claude-environment [String = String]
    - variables [String = String]? = null

** (variables ?? environment())
?> !claude-scrubs-variable(each[0])
*> each[0], each[1]
|> Map

━━━━━━━━━━━━━━━━━━━━
_ ClaudeLink

+ settings String
+ is-closing = false

_ provider ClaudeCode
_ process Process
_ decoder := ClaudeDecoder()
_ errors := Semaphore'String()
_ turn ClaudeTurn?
_ queued [ClaudeTurn]
_ heard ClaudeTurn?
_ follower SyncBufferedChannel'ClaudeTurn?
_ tasks [String = Bool]
_ answers [String = SyncBufferedChannel'ClaudeAnswer]
_ is-owed = false
_ is-hushed = false
_ awaited Size
_ is-interrupting = false
_ requests Size
_ host ClaudeToolHost?

────────────────────
+ This
    - owner ClaudeCode
    - child Process
    - settings
    - origin ClaudePoint? = null
    - basis String? = null
    - host ClaudeToolHost? = null

.. provider = owner
.. process = child
this.host = host
decoder.permission-mode = owner.permission-mode
decoder.parent = origin
decoder.basis = basis
. hosted = List'String()
if host
    hosted += claude-tool-server
catch process.write("${claude-initialize-line(request-id(), hosted)}\n")
do new
    drain()
do new
    run()

────────────────────
+ get session

decoder.session-id

────────────────────
+ do ask ClaudeTurn
    - prompt JSON
    - request AIRequest? = null

is-hushed = false
. asked = ClaudeTurn(this, prompt, request)
do follower?.close()
follower = null
if turn || awaited
    queued += asked
else
    start(asked)
= asked

────────────────────
+ do steer
    - prompt String

catch process.write("${claude-user-line(prompt, "next")}\n")

────────────────────
+ do follow ClaudeTurn?

. pending = heard
heard = null
=? pending if pending
=? null if is-closing
do follower?.close()
. waiting = SyncBufferedChannel'ClaudeTurn()
follower = waiting
= <- waiting

────────────────────
+ has-task Bool
    - id String

tasks has id

────────────────────
+ do task-output String?
    - id String

=? null if is-closing
. asked = request-id()
. waiting = SyncBufferedChannel'ClaudeAnswer()
answers[asked] = waiting
do finally
    -= answers[asked]
catch process.write("${claude-task-output-line(asked, id)}\n")
. answer = <- waiting
= claude-task-output-text(answer?.response)

────────────────────
+ do halt

is-hushed = true
is-owed = false
for id, _ in tasks
    catch process.write("${claude-stop-task-line(request-id(), id)}\n")
catch process.write("${claude-interrupt-line(request-id(), true)}\n")
calm()

────────────────────
+ do leave
    - left ClaudeTurn

if turn && turn as Pointer == left as Pointer
    interrupt()
else
    queued = List(queued ?> each as Pointer != left as Pointer)
    left.settle(null)

────────────────────
_ do start
    - next ClaudeTurn

turn = next
is-owed = false
. missed = heard
heard = null
if missed
    for event in missed.events
        if event is not AIDoneEvent
            next.deliver(event)
catch process.write("${claude-user-line(next.prompt ?? "" as JSON)}\n")

────────────────────
_ do interrupt

=? if is-interrupting
is-interrupting = true
catch process.write("${claude-interrupt-line(request-id())}\n")

────────────────────
_ do run

. problem String?
listen()
    catch failure Error
        problem = "$failure"
if problem
    process.terminate()
. status = process.wait(null)
. output = errors.await() ?? ""
process.close()
provider.forget(this)
is-closing = true
do follower?.close()
follower = null
for id, _ in tasks
    provider.tool-tasks.settle(id, AIToolTaskStatus.stopped)
tasks = Map'String'Bool()
for _, waiting in answers
    waiting.close()
answers = Map'String'(SyncBufferedChannel'ClaudeAnswer)()
. failure = AIError(AIErrorKind.unknown, problem ?? claude-exit-reason(status ?? 0, output.trim()))
do turn?.settle(failure)
turn = null
for waiting in queued
    waiting.settle(failure)
queued.clear()

────────────────────
_ do drain

. text = process.stderr! as String
errors.post(text)

────────────────────
_ do listen ?! JSONLineError ?! IOError

. scratch = use Arena()
for line in process ~> \json-line with JSONParser(scratch)
    hear(line)

────────────────────
_ do hear
    - line JSON

. hosted = claude-mcp-message(line)
if hosted
    do new serve(hosted)
    =
. answer = claude-answer(line)
if answer
    . waiting = answers[answer.request-id]
    if waiting
        waiting <- answer
        waiting.close()
    =
track(claude-task-event(line))
if claude-is-requesting(line)
    is-owed = false
deliver(line)
    catch failure AIError
        do turn?.settle(failure)
if claude-is-result(line)
    awaited = claude-queued-turns(line)
    end-turn()

────────────────────
_ do serve
    - hosted ClaudeMCPMessage

. reply = host?.answer(hosted.message, turn?.request ?? AIRequest("")) ?? claude-mcp-refusal(hosted)
catch process.write("${claude-mcp-reply-line(hosted.request-id, reply)}\n")

────────────────────
_ do deliver ?! AIError
    - line JSON

for event in decoder.decode(line)
    if turn || event is not AIDoneEvent
        current().deliver(event)

────────────────────
_ do current ClaudeTurn

=? turn if turn
. started = ClaudeTurn(this)
turn = started
is-owed = false
if is-hushed
    started.abandon()
    = started
. waiting = follower
follower = null
if waiting
    waiting <- started
    waiting.close()
else
    heard = started
= started

────────────────────
_ do track
    - event ClaudeTaskEvent?

. board = provider.tool-tasks
do match? event
    | .started(id, call, kind, title, is-backgrounded)
        tasks[id] = is-backgrounded
        board.add(AIToolTask(id, call, kind, title, is-backgrounded))
    | .progressed(id, summary)
        board.note(id, summary, null)
    | .updated(id, status, is-backgrounded)
        if is-backgrounded != null && tasks has id
            tasks[id] = is-backgrounded
        board.note(id, null, is-backgrounded)
        . ended = claude-task-status(status)
        if ended
            -= tasks[id]
            board.settle(id, ended)
            calm()
    | .notified(id, status, path, summary)
        . behind = board.task(id)?.is-backgrounded ?? tasks[id] ?? true
        is-owed = is-owed || (behind && !is-hushed)
        -= tasks[id]
        board.settle(id, claude-task-status(status) ?? AIToolTaskStatus.completed, summary)
        keep-output(id, path)
        calm()

────────────────────
_ do keep-output
    - id String
    - path String?

. task = provider.tool-tasks.task(id)
=? if !task || !path
. text = catch? read-file-text(Path(path, 0))
if text != null
    task.show-output(text)

────────────────────
_ do calm

=? if !is-hushed || turn
release()

────────────────────
_ do end-turn

. ended = turn
turn = null
is-interrupting = false
do ended?.settle(null)
decoder.resume-turn()
if queued.length && !awaited
    . next = queued[0]
    queued.remove(0)
    start(next)
else
    release()

────────────────────
_ do release

=? if is-closing || turn || queued.length || tasks.length || is-owed || awaited
is-closing = true
do follower?.close()
follower = null
catch process.close-input()

────────────────────
_ do request-id String

requests += 1
= "yumi-$requests"

━━━━━━━━━━━━━━━━━━━━
_ ClaudeTurn

+ events := SyncBufferedChannel'AIEvent()
+ failure AIError?
+ prompt JSON?
+ request AIRequest?
+ is-settled = false

_ link ClaudeLink
_ is-abandoned = false

────────────────────
+ This
    - link
    - prompt JSON? = null
    - request AIRequest? = null

────────────────────
+ get host ClaudeToolHost?

link.host

────────────────────
+ begin-using

this

────────────────────
+ do end-using

abandon()

────────────────────
+ do abandon

=? if is-settled
is-abandoned = true
link.leave(this)

────────────────────
+ do deliver
    - event AIEvent

=? if is-abandoned || is-settled
events <- event

────────────────────
+ do settle
    - problem AIError?

=? if is-settled
is-settled = true
failure = problem
if !is-abandoned
    events.close()

━━━━━━━━━━━━━━━━━━━━
_ do claude-process Process ?! AIError
    - program String
    - arguments [String]
    - directory String?
    - has-task-tools = false
    - base [String = String]? = null

?! AIError(AIErrorKind.invalid-request, "Claude Code can't run in $directory because it no longer exists")
    if directory && !Path(directory, 0).is-dir
?! AIError(AIErrorKind.unknown, "Claude Code did not start: $failure")
    catch failure Error

. variables = claude-environment(base)
if has-task-tools
    variables["CLAUDE_CODE_ENABLE_TODO_TOOLS"] = "1"
= Process(program, ProcessStderr.capture, arguments, directory, variables)

━━━━━━━━━━━━━━━━━━━━
_ claude-parts-session String?
    - parts [AIMessagePart]

last((parts ?*> claude-part-session(each)))

━━━━━━━━━━━━━━━━━━━━
_ claude-search-directories [String]

** (env("PATH") ?? "").split(":")
*? "${home}/.local/bin" if home
* "/opt/homebrew/bin"
* "/usr/local/bin"
|> List

.. home = env("HOME")

━━━━━━━━━━━━━━━━━━━━
_ claude-scrubs-variable
    - name String

name.starts-with("ANTHROPIC_") || name == "CLAUDECODE" || is-claude-setting

.. is-claude-setting = name.starts-with("CLAUDE_") && name != "CLAUDE_CONFIG_DIR"

━━━━━━━━━━━━━━━━━━━━
_ claude-exit-reason
    - status Int
    - errors String

|? errors.length > 0
    errors
??
    "Claude Code exited with status $status"

━━━━━━━━━━━━━━━━━━━━
_ claude-mcp-refusal JSON
    - hosted ClaudeMCPMessage

Map'String'JSON
    • jsonrpc "2.0"
    • id asked ?? 0 as JSON
    • error JSONRPCError(.method-not-found, "Claude Code asked for ${hosted.server}, which this app does not serve").json

.. asked = match? hosted.message
    | ["id" = id]
        id
