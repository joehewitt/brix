(blank)
(prop _ claude-icon-color _ (= (call RGBA "#D97757")))

(type + ClaudeIcon (is VectorImage)
  (fn-do + This _
    (= view-box (call Rect 0 0 24 24))
  )
  (content
    (<> This
      (= fill claude-icon-color)
      (= stroke (. Stroke none))
      (blank)
      (<> VectorPath
        (= d (call claude-icon-path))
      )
    )
  )
)

