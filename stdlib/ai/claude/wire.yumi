    - message AIMessage

message.role == AIMessageRole.system || message.role == AIMessageRole.developer

━━━━━━━━━━━━━━━━━━━━
_ do claude-prompt-images ?! AIError
    - message AIMessage
    - images [AIImage]

for part in message.parts
    if | image AIImagePart = part
        images += image.image
    else
        ?! AIError(AIErrorKind.invalid-request, "Claude Code prompts hold only text and images")
            if part is not AITextPart

━━━━━━━━━━━━━━━━━━━━
_ claude-text-block JSON
    - text String

Map'String'JSON
    • type "text"
    • text text

━━━━━━━━━━━━━━━━━━━━
_ do claude-image-block JSON ?! AIError
    - image AIImage

. file = image.file
. source = Map'String'JSON()
if | remote AIURLSource = file.source
    source["type"] = "url"
    source["url"] = remote.url
else
    source["type"] = "base64"
    source["media_type"] = file.mime-type
    source["data"] = "${claude-image-data(file)}"
= Map'String'JSON
    • type "image"
    • source source

━━━━━━━━━━━━━━━━━━━━
+ do claude-image-data Base64 ?! AIError
    - file AIFile

do match? file.source
    | encoded AIBase64Source
        = encoded.data
    | held AIBytesSource
        = held.data as Base64
    | stored AIPathSource
        . bytes = read-file-bytes(Path(stored.path, 0))
            catch failure Error
                ?! AIError(AIErrorKind.invalid-request, "Unable to read image ${stored.path}: $failure")
        = bytes as Base64
?! AIError(AIErrorKind.invalid-request, "Claude Code cannot read this image")

━━━━━━━━━━━━━━━━━━━━
+ claude-part-session String?
    - part AIMessagePart

claude-part-mark(part)?.point.session

━━━━━━━━━━━━━━━━━━━━
+ do claude-part-mark ClaudeMark?
    - part AIMessagePart

=? if part is not AIExtensionPart
. extension = part as AIExtensionPart
=? if extension.provider-id != claude-provider-id || extension.part-type != claude-session-part
. fields = json-object(extension.data)
. id = json-string(fields?["session_id"])
=? if !fields || !id
. point = ClaudePoint(id, json-string(fields["entry"]))
. message = json-string(fields["message_id"])
. blocks = json-int(fields["blocks"]) ?? 0
. parent = json-object(fields["parent"])
. parent-id = json-string(parent?["session_id"])
=? ClaudeMark(point, null, null, message, blocks) if !parent || !parent-id
. origin = ClaudePoint(parent-id, json-string(parent["entry"]))
= ClaudeMark(point, origin, json-string(parent["basis"]), message, blocks)

━━━━━━━━━━━━━━━━━━━━
_ claude-control-request
    - request-id String
    - request [String = JSON]

to-json(root)

.. root = Map'String'JSON
    • type "control_request"
    • "request_id" request-id
    • request request

━━━━━━━━━━━━━━━━━━━━
_ claude-mcp-config String
    - servers [ClaudeMCPServer]

to-json(config)

.. config = Map'String'JSON
    • "mcpServers" Map'String'JSON((each.name, each.json) in servers)

━━━━━━━━━━━━━━━━━━━━
_ do claude-mcp-tools <String>
    - servers [ClaudeMCPServer]

for server in servers
    for tool in server.tools
        <= "mcp__${server.name}__$tool"

━━━━━━━━━━━━━━━━━━━━
_ do claude-flag <String>
    - name String
    - value String?

if value != null
    <= name
    <= value

━━━━━━━━━━━━━━━━━━━━
_ claude-part-id
    - message-id String
    - index Size

"$message-id:$index"

━━━━━━━━━━━━━━━━━━━━
_ claude-begun-part AIMessagePart?
    - id String
    - block [String = JSON]
    - is-update Bool

match? block
    | ["type" = "text"]
        AITextPart(id, "")
    | ["type" = "thinking"]
        AIReasoningPart(id, "") • is-update is-update
    | ["type" = "tool_use", "id" = call-id String, "name" = name String]
        AIToolCallPart(id, call-id, name, null)

━━━━━━━━━━━━━━━━━━━━
_ claude-completed-part AIMessagePart?
    - id String
    - block [String = JSON]
    - is-update Bool

match? block
    | ["type" = "text", "text" = text String]
        AITextPart(id, text)
    | ["type" = "thinking", "thinking" = text String]
        AIReasoningPart(id, text, null, block["signature"], is-update)
    | ["type" = "tool_use", "id" = call-id String, "name" = name String, "input" = input]
        AIToolCallPart(id, call-id, name, input)

━━━━━━━━━━━━━━━━━━━━
_ claude-content-delta AIContentDelta?
    - delta [String = JSON]

match? delta
    | ["type" = "text_delta", "text" = text String {it.length > 0}]
        AITextDelta(text)
    | ["type" = "thinking_delta", "thinking" = text String {it.length > 0}]
        AIReasoningDelta(text)
    | ["type" = "input_json_delta", "partial_json" = text String {it.length > 0}]
        AIToolArgumentsDelta(text)

━━━━━━━━━━━━━━━━━━━━
_ claude-result-part AIMessagePart?
    - block JSON

match? block
    | ["type" = "tool_result", "tool_use_id" = call-id String, "content" = content]
        AIToolResultPart("$call-id:result", call-id, content, claude-result-text(content), is-error)

.. is-error = json-flag((block as [String = JSON])["is_error"])

━━━━━━━━━━━━━━━━━━━━
_ claude-result-text String?
    - content JSON

match? content
    | text String
        text
    | blocks [JSON]
        "".join((claude-block-text(each) ?? "") in blocks)

━━━━━━━━━━━━━━━━━━━━
_ claude-block-text String?
    - block JSON

match? block
    | ["type" = "text", "text" = text String]
        text

━━━━━━━━━━━━━━━━━━━━
_ claude-finish-reason AIFinishReason
    - reason String

match reason
    |= "end_turn"
        AIFinishReason.stop
    |= "stop_sequence"
        AIFinishReason.stop
    |= "max_tokens"
        AIFinishReason.length
    |= "refusal"
        AIFinishReason.content-filter
    ??
        AIProviderFinishReason(claude-provider-id, reason)

━━━━━━━━━━━━━━━━━━━━
_ claude-error-kind
    - error String

match error
    |= "authentication_failed"
        AIErrorKind.authentication
    |= "rate_limit"
        AIErrorKind.rate-limit
    |= "invalid_request"
        AIErrorKind.invalid-request
    |= "server_error"
        AIErrorKind.server
    ??
        AIErrorKind.unknown

━━━━━━━━━━━━━━━━━━━━
_ claude-status-kind
    - status Int?

|? status == 401 || status == 403
    AIErrorKind.authentication
|? status == 429
    AIErrorKind.rate-limit
|? status != null && status >= 500
    AIErrorKind.server
??
    AIErrorKind.unknown

━━━━━━━━━━━━━━━━━━━━
_ claude-failure-message
    - root [String = JSON]
    - kind AIErrorKind?

|? kind == AIErrorKind.authentication
    "Claude Code is not signed in. Run \"claude auth login\" in a terminal, then try again."
??
    claude-result-message(root)

━━━━━━━━━━━━━━━━━━━━
_ claude-result-message
    - root [String = JSON]

json-string(root["result"]) ?? first-error ?? "Claude Code did not finish the turn"

.. first-error = match? root
    | ["errors" = [error String, ...]]
        error

━━━━━━━━━━━━━━━━━━━━
_ claude-usage
    - value [String = JSON]?

|? !value
    AIUsage()
??
    AIUsage
        • input-tokens (fresh ?? 0) + (created ?? 0) + (read ?? 0)
        • output-tokens json-size(value["output_tokens"])
        • cache-creation-tokens created
        • cache-read-tokens read
        • reasoning-tokens reasoning

.. fresh = json-size(value["input_tokens"])
.. created = json-size(value["cache_creation_input_tokens"])
.. read = json-size(value["cache_read_input_tokens"])
.. details = json-object(value["output_tokens_details"])
.. reasoning = json-size(details["thinking_tokens"]) if details

━━━━━━━━━━━━━━━━━━━━
_ json-string
    - value JSON?

match? value
    | String

━━━━━━━━━━━━━━━━━━━━
_ json-object
    - value JSON?

match? value
    | [String = JSON]

━━━━━━━━━━━━━━━━━━━━
_ json-int Int?
    - value JSON?

match? value
    | Int

━━━━━━━━━━━━━━━━━━━━
_ json-size Size?
    - value JSON?

match? value
    | Int {it >= 0}

━━━━━━━━━━━━━━━━━━━━
_ json-flag
    - value JSON?

json-bool(value) ?? false

━━━━━━━━━━━━━━━━━━━━
_ json-bool
    - value JSON?

match? value
    | Bool
