/ai/media
/ai/model
/ai/tool-tasks
/data/json
/os/file
/os/path

+ claude-provider-id = "claude-code"
_ claude-session-part = "session"

━━━━━━━━━━━━━━━━━━━━
+ ClaudePoint is Tuple

+ session String
+ entry String? = null

━━━━━━━━━━━━━━━━━━━━
+ ClaudeMark is Tuple

+ point ClaudePoint
+ parent ClaudePoint? = null
+ basis String? = null
+ message String? = null
+ blocks Size = 0

━━━━━━━━━━━━━━━━━━━━
+ ClaudeResume is Tuple

+ point ClaudePoint? = null
+ forks = false
+ merges [ClaudeMark]? = null

━━━━━━━━━━━━━━━━━━━━
+ ClaudeDecoder

+ permission-mode String?
+ parent ClaudePoint?
+ basis String?
+ session-id String?

_ message-id = ""
_ begun Size
_ streaming Size?
_ completed-id = ""
_ completed Size
_ failure AIErrorKind?
_ model = ""
_ entry String?
_ compactions Size
_ shows-updates = false

────────────────────
+ do decode <AIEvent> ?! AIError
    - line JSON

. root = json-object(line)
=? if !root || json-string(root["parent_tool_use_id"])

do match? root
    | ["type" = "stream_event", "event" = event [String = JSON]]
        <<= decode-stream(event, json-string(root["thinking_display"]))
    | ["type" = "assistant", "error" = error String]
        failure = claude-error-kind(error)
    | ["type" = "assistant", "message" = message [String = JSON]]
        <<= decode-message(message)
        <<= decode-entry(root)
    | ["type" = "user", "message" = ["content" = blocks [JSON]]]
        <<= decode-results(blocks)
        <<= decode-entry(root)
    | ["type" = "system", "subtype" = "init", "session_id" = id String, "model" = model String]
        check-permission-mode(model, json-string(root["permissionMode"]))
        <<= decode-session(id, model)
    | ["type" = "system", "subtype" = "compact_boundary"]
        <<= decode-compaction(root)
    | ["type" = "result"]
        <<= decode-structured(root)
        <= decode-result(root)

────────────────────
+ do resume-turn

parent = null
basis = null

────────────────────
+ do resume-mark
    - part AIMessagePart

. mark = claude-part-mark(part)
=? if !mark
. fields = json-object((part as AIExtensionPart).data)
session-id = mark.point.session
entry = mark.point.entry
parent = mark.parent
basis = mark.basis
model = json-string(fields?["model"]) ?? ""
completed-id = mark.message ?? ""
completed = mark.blocks

────────────────────
_ do check-permission-mode ?! AIError
    - model String
    - granted String?

. wanted = permission-mode
=? if wanted == null || granted == null || wanted == granted
. reason = "Claude Code would not use permission mode \"${wanted}\" with $model"
?! AIError(AIErrorKind.invalid-request, "$reason; it started in \"${granted}\"")

────────────────────
_ do decode-session <AIEvent>
    - id String
    - model String

=? if session-id
session-id = id
this.model = model
. part = session-part(id)
<= AIPartBeginEvent(part)
<= AIPartEndEvent(part)

────────────────────
_ do decode-entry <AIEvent>
    - root [String = JSON]

. uuid = json-string(root["uuid"])
. id = session-id
=? if !uuid || !id
entry = uuid
<= AIPartEndEvent(session-part(id))

────────────────────
_ do decode-compaction <AIEvent>
    - root [String = JSON]

compactions += 1
. id = "${ai-compaction-part}:$compactions"
. part = AIExtensionPart
    - id
    - claude-provider-id
    - ai-compaction-part
    - root["compact_metadata"] ?? null as JSON
<= AIPartBeginEvent(part)
<= AIPartEndEvent(part)

────────────────────
_ session-part
    - id String

AIExtensionPart(claude-session-part, claude-provider-id, claude-session-part, data)

.. data = claude-mark-data
    - ClaudeMark
        - ClaudePoint(id, entry)
        - parent
        - basis
        - completed-id if completed-id.length
        - completed
    - model

────────────────────
_ do decode-stream <AIEvent>
    - event [String = JSON]
    - display String?

do match? event
    | ["type" = "message_start", "message" = ["id" = id String]]
        message-id = id
        shows-updates = display == "updates"
        begun = 0
        streaming = null
    | ["type" = "content_block_start", "index" = index Int, "content_block" = block [String = JSON]]
        . position = index as Size
        . part = claude-begun-part(claude-part-id(message-id, position), block, shows-updates)
        streaming = position if part
        if part
            begun = position + 1
            <= AIPartBeginEvent(part)
    | ["type" = "content_block_delta", "index" = index Int, "delta" = delta [String = JSON]]
        . position = index as Size
        . change = claude-content-delta(delta)
        if change && streaming == position
            <= AIPartDeltaEvent(claude-part-id(message-id, position), change)

────────────────────
_ do decode-message <AIEvent>
    - message [String = JSON]

. id = json-string(message["id"]) ?? ""
if id != completed-id
    completed-id = id
    completed = 0
. index = completed
completed += 1

. block = match? message
    | ["content" = [block [String = JSON], ...]]
        block
=? if !block
. part = claude-completed-part(claude-part-id(id, index), block, shows-updates)
=? if !part
if id != message-id || index >= begun
    <= AIPartBeginEvent(part)
<= AIPartEndEvent(part)

────────────────────
_ do decode-results <AIEvent>
    - blocks [JSON]

for block in blocks
    . part = claude-result-part(block)
    if part
        <= AIPartBeginEvent(part)
        <= AIPartEndEvent(part)

────────────────────
_ do decode-structured <AIEvent>
    - root [String = JSON]

. output = root["structured_output"]
=? if output == null || json-flag(root["is_error"])
. part = AITextPart("structured-output", to-json(output))
<= AIPartBeginEvent(part)
<= AIPartEndEvent(part)

────────────────────
_ do decode-result AIEvent ?! AIError
    - root [String = JSON]

. kind = failure
failure = null
. usage = claude-usage(json-object(root["usage"]))
if !json-flag(root["is_error"])
    = AIDoneEvent(claude-finish-reason(json-string(root["stop_reason"]) ?? ""), usage)
if (json-string(root["terminal_reason"]) ?? "").starts-with("aborted")
    = AIDoneEvent(AIFinishReason.cancellation, usage)

. status = json-int(root["api_error_status"])
?! AIError(kind ?? claude-status-kind(status), claude-failure-message(root, kind), status)

━━━━━━━━━━━━━━━━━━━━
+ claude-account AIAccount
    - output JSON?

|? !json-flag(fields?["loggedIn"])
    AIAccount(AIAccountStatus.signed-out)
??
    AIAccount
        • status AIAccountStatus.signed-in
        • billing claude-billing(json-string(fields?["authMethod"]))
        • email json-string(fields?["email"])
        • plan json-string(fields?["subscriptionType"])
        • organization json-string(fields?["orgName"])

.. fields = json-object(output)

━━━━━━━━━━━━━━━━━━━━
_ claude-billing AIAccountBilling
    - method String?

match method
    |= null
        AIAccountBilling.unknown
    |= "claude.ai"
        AIAccountBilling.subscription
    ??
        AIAccountBilling.api

━━━━━━━━━━━━━━━━━━━━
+ ClaudeMCPServer is Tuple

+ name String
+ url String?
+ tools [String]

────────────────────
+ get json [String = JSON]

|? url
    Map'String'JSON
        • type "http"
        • url url
??
    Map'String'JSON
        • type "sdk"
        • name name

━━━━━━━━━━━━━━━━━━━━
+ claude-arguments [String]
    - request AIRequest
    - tools [String]? = null
    - is-safe-mode = false
    - allowed-tools [String]? = null
    - permission-mode String? = null
    - resume ClaudeResume? = null
    - is-persistent = true
    - effort String? = null
    - mcp-servers [ClaudeMCPServer] = List'ClaudeMCPServer()
    - thinking-display String? = null

* "--print"
* "--input-format"
* "stream-json"
* "--output-format"
* "stream-json"
* "--verbose"
* "--include-partial-messages"
*? "--safe-mode" if is-safe-mode
*? "--no-session-persistence" if !is-persistent
** claude-flag("--model", request.model if request.model.length)
** claude-flag("--effort", effort)
** claude-flag("--thinking-display", thinking-display)
** claude-flag("--append-system-prompt", claude-instructions(request))
** claude-flag("--json-schema", schema)
** claude-flag("--tools", offered)
** claude-flag("--allowedTools", approved)
** claude-flag("--permission-mode", permission-mode)
** claude-flag("--mcp-config", claude-mcp-config(mcp-servers) if mcp-servers.length)
** claude-flag("--resume", point?.session)
** claude-flag("--resume-session-at", point?.entry)
*? "--fork-session" if point && plan.forks
* "--permission-prompts"
* "none"
|> List

.. schema = to-json(request.response-schema) if request.response-schema
.. offered = (",".join(tools)) if tools
.. approved = (",".join(permitted)) if permitted.length
.. permitted [String] =
    **? allowed-tools
    ** claude-mcp-tools(mcp-servers)
.. plan = resume ?? claude-resume(request)
.. point = plan.point

━━━━━━━━━━━━━━━━━━━━
+ claude-resume ClaudeResume
    - request AIRequest

|? !marks.length
    ClaudeResume()
|? claude-marks-chain(marks)
    ClaudeResume(marks[marks.length - 1].point, request.forks)
??
    ClaudeResume(null, false, marks)

.. marks = claude-marks(request.messages)

━━━━━━━━━━━━━━━━━━━━
+ do claude-marks [ClaudeMark]
    - messages [AIMessage]

. marks = List'ClaudeMark()
for message in messages
    for part in message.parts
        . mark = claude-part-mark(part)
        if mark
            marks += mark
= marks

━━━━━━━━━━━━━━━━━━━━
+ do claude-marks-chain Bool
    - marks [ClaudeMark]

. index = marks.length - 1
while index > 0
    . mark = marks[index]
    =? true if mark.basis && mark.basis == claude-marks-basis(marks[0 .. < index])
    . parent = mark.parent ?? ClaudePoint(mark.point.session)
    =? false if !claude-same-point(parent, marks[index - 1].point)
    index -= 1
= true

━━━━━━━━━━━━━━━━━━━━
+ claude-marks-basis String
    - marks [ClaudeMark]

"${hash-for(points)}"

.. points = "|".join("${each.point.session}@${each.point.entry ?? ""}" in marks)

━━━━━━━━━━━━━━━━━━━━
+ claude-same-point
    - first ClaudePoint
    - second ClaudePoint

same-session && (first.entry == null || second.entry == null || first.entry == second.entry)

.. same-session = first.session == second.session

━━━━━━━━━━━━━━━━━━━━
+ claude-mark-data JSON
    - mark ClaudeMark
    - model String

Map'String'JSON
    • "session_id" mark.point.session
    • model model
    •? entry mark.point.entry
    •? "message_id" mark.message
    •? blocks blocks
    •? parent claude-parent-data(mark)

.. blocks = (mark.blocks as Int) if mark.message

━━━━━━━━━━━━━━━━━━━━
_ claude-parent-data JSON?
    - mark ClaudeMark

|? mark.parent == null
    null
??
    Map'String'JSON
        • "session_id" mark.parent.session
        •? entry mark.parent.entry
        •? basis mark.basis

━━━━━━━━━━━━━━━━━━━━
+ claude-instructions String?
    - request AIRequest

text if text.length

.. text = "\n\n".join(ai-parts-text(each.parts) in request.messages when claude-instructs(each))

━━━━━━━━━━━━━━━━━━━━
+ do claude-session-id String?
    - messages [AIMessage]

. found String?
for message in messages
    for part in message.parts
        found = claude-part-session(part) ?? found
= found

━━━━━━━━━━━━━━━━━━━━
+ do claude-prompt JSON ?! AIError
    - request AIRequest

?! AIError(AIErrorKind.invalid-request, "Claude Code runs its own tools")
    if request.tools.length

. prompts = List'String()
. images = List'AIImage()
for message in request.messages
    if claude-instructs(message)
        continue
    if message.role == AIMessageRole.user
        claude-prompt-images(message, images)
        . text = ai-parts-text(message.parts)
        if text.length
            prompts += text
    else if claude-session-id([message])
        prompts = List'String()
        images = List'AIImage()
    else
        ?! AIError(AIErrorKind.invalid-request, "Claude Code can only continue its own replies")

?! AIError(AIErrorKind.invalid-request, "Claude Code needs a prompt")
    if !prompts.length && !images.length
. text = "\n\n".join(prompts)
=? text if !images.length
. content = List'JSON()
for image in images
    content += claude-image-block(image)
if text.length
    content += claude-text-block(text)
= content

