━━━━━━━━━━━━━━━━━━━━
+ ClaudeTaskEvent is Union

| started(id String, call-id String?, kind String, title String, is-backgrounded Bool)
| progressed(id String, summary String?)
| updated(id String, status String?, is-backgrounded Bool?)
| notified(id String, status String, output-path String?, summary String?)

━━━━━━━━━━━━━━━━━━━━
+ claude-task-event ClaudeTaskEvent?
    - line JSON

match? root
    |= null
        null
    | ["type" = "system", "subtype" = "task_started", "task_id" = id String]
        ClaudeTaskEvent.started(id, call, kind, title, is-backgrounded)

        .. call = json-string(root["tool_use_id"])
        .. kind = json-string(root["task_type"]) ?? ""
        .. title = json-string(root["description"]) ?? ""
        .. is-backgrounded = json-bool(root["is_backgrounded"]) ?? true
    | ["type" = "system", "subtype" = "task_progress", "task_id" = id String]
        ClaudeTaskEvent.progressed(id, json-string(root["summary"]))
    | ["type" = "system", "subtype" = "task_notification", "task_id" = id String]
        ClaudeTaskEvent.notified(id, status, path, json-string(root["summary"]))

        .. status = json-string(root["status"]) ?? "completed"
        .. path = json-string(root["output_file"]) if json-string(root["output_file"]) != ""
    | ["type" = "system", "subtype" = "task_updated", "task_id" = id String, "patch" = patch [String = JSON]]
        ClaudeTaskEvent.updated
            - id
            - json-string(patch["status"])
            - json-bool(patch["is_backgrounded"])

.. root = json-object(line)

━━━━━━━━━━━━━━━━━━━━
+ claude-task-status AIToolTaskStatus?
    - status String?

match? status
    |= "completed"
        AIToolTaskStatus.completed
    |= "failed"
        AIToolTaskStatus.failed
    |= "stopped"
        AIToolTaskStatus.stopped
    |= "killed"
        AIToolTaskStatus.stopped

━━━━━━━━━━━━━━━━━━━━
+ claude-is-result
    - line JSON

json-string(root?["type"]) == "result" && !json-string(root?["parent_tool_use_id"])

.. root = json-object(line)

━━━━━━━━━━━━━━━━━━━━
+ claude-is-requesting
    - line JSON

json-string(root?["type"]) == "system" && json-string(root?["subtype"]) == "status" && json-string(root?["status"]) == "requesting" && !json-string(root?["parent_tool_use_id"])

.. root = json-object(line)

