(import ./history)
(import ./subagents)
(import ./wire)
(import /ai/model)
(import /data/json)
(import /os/file)
(import /os/path)

(fn-do + claude-caught-up (? (list AIMessagePart)) (?! Error)
  (param parts (list AIMessagePart))
  (param directory (? String))
  (let marked (? Index))
  (let mark (? ClaudeMark))
  (for (in position (..< 0 (. parts length)))
    (let found (call claude-part-mark ([] parts position)))
    (if found
      (= mark found)
      (= marked position)
    )
  )
  (return-if null (if (or (not mark) (not (. mark point entry)))))
  (blank)
  (let entry (. mark point entry))
  (let path (call claude-session-path (. mark point session) directory))
  (return-if null (if (not path)))
  (blank)
  (let text (call read-file-text path))
  (let start (call (. text find) (str "\"uuid\":\"" entry "\"")))
  (return-if null (if (== start null)))
  (blank)
  (let chain
    (call (of Map String Bool)
      (block
        (entry entry true)
      )
    )
  )
  (let decoder (call ClaudeDecoder))
  (call (. decoder resume-mark) ([] parts (!! marked)))
  (let reply (call AIReply))
  (let is-first true)
  (for (in line (call (. ([] text (..< start (. text length))) split) "\n"))
    (if is-first
      (= is-first false)
      (continue)
    )
    (let value (catch? (call parse-json line)))
    (if value
      (if (= (| (: fields (map String JSON))) value)
        (let uuid (call claude-field-text fields "uuid"))
        (let parent (?? (call claude-field-text fields "parentUuid") (call claude-field-text fields "logicalParentUuid")))
        (if (and uuid parent (has chain parent))
          (= ([] chain uuid) true)
          (let kind (call claude-field-text fields "type"))
          (if (or (== kind "assistant") (== kind "user"))
            (catch (call claude-apply-line decoder reply line))
          )
        )
      )
    )
  )
  (let merged (call (of List AIMessagePart) parts))
  (let added Size 0)
  (for (in part (. reply parts))
    (if (call claude-part-mark part)
      (= ([] merged (!! marked)) part)
      (else-if (is-not part AIExtensionPart)
        (let index (call ai-part-index merged (call ai-part-id part)))
        (if index
          (= ([] merged index) part)
          (else
            (+= merged part)
          )
        )
        (+= added 1)
      )
    )
  )
  (return-if null (if (== added 0)))
  (return merged)
)

(fn-do + claude-is-stranded Bool
  (param point ClaudePoint)
  (param directory (? String))
  (let entry (. point entry))
  (return-if false (if (not entry)))
  (blank)
  (let path (call claude-session-path (. point session) directory))
  (return-if false (if (not path)))
  (blank)
  (let text (catch? (call read-file-text path)))
  (return-if false (if (== text null)))
  (blank)
  (let start (call (. text find) (str "\"uuid\":\"" entry "\"")))
  (return-if false (if (== start null)))
  (blank)
  (let chain
    (call (of Map String Bool)
      (block
        (entry entry true)
      )
    )
  )
  (let checkpoint (? String))
  (let is-first true)
  (for (in line (call (. ([] text (..< start (. text length))) split) "\n"))
    (if is-first
      (= is-first false)
      (continue)
    )
    (let value (catch? (call parse-json line)))
    (if (= (| (: fields (map String JSON))) value)
      (let uuid (call claude-field-text fields "uuid"))
      (let parent (?? (call claude-field-text fields "parentUuid") (call claude-field-text fields "logicalParentUuid")))
      (if (== (call claude-field-text fields "type") "last-prompt")
        (= checkpoint (?? (call claude-field-text fields "leafUuid") checkpoint))
        (else-if (and uuid parent (has chain parent))
          (= ([] chain uuid) true)
        )
      )
    )
  )
  (return (and (!= checkpoint null) (not (has chain checkpoint))))
)

(fn-do _ claude-field-text (? String)
  (param fields (map String JSON))
  (param name String)
  (let value ([] fields name))
  (return-if null (if (== value null)))
  (blank)
  (if (= (| (: text String)) value)
    (return text)
  )
  (return null)
)
