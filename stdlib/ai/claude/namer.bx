(import ./provider)
(import /ai/session)
(blank)
(prop _ claude-namer-model _ (= "claude-haiku-5-5"))

(fn-expr + claude-chat-namer _
  (param claude ClaudeCode)
  (call AIChatService
    (block
      (arg claude-namer-model)
      (arg "Claude Haiku 5.5")
      (arg
        (call ClaudeCode
          (block
            (:executable (. claude executable))
            (:working-directory (. claude working-directory))
            (:tools (call (of List String)))
            (:is-safe-mode true)
            (:is-persistent false)
            (:variables (. claude variables))
          )
        )
      )
      (arg claude-namer-model)
    )
  )
)
