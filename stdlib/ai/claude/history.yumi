./wire
/ai/model
/data/json
/os/env
/os/file
/os/path
/sys/random.h

━━━━━━━━━━━━━━━━━━━━
+ ClaudeHistory is Tuple

+ rows Map'String'[String = JSON]
+ tip String?

━━━━━━━━━━━━━━━━━━━━
+ do claude-merge-history ClaudePoint ?! AIError
    - marks [ClaudeMark]
    - home Path? = null

?! claude-history-error()
    if !marks.length
. root = home ?? claude-history-home()
. directory = claude-history-directory(root, marks[marks.length - 1].point.session)
?! claude-history-error()
    if !directory
. histories = Map'String'ClaudeHistory()
. merged = List'[String = JSON]()
. seen = Map'String'Bool()
for mark in marks
    . session = mark.point.session
    if !(histories has session)
        histories[session] = claude-history(session, claude-history-directory(root, session))
    for row in claude-history-chain(histories[session]!, mark.point.entry)
        . id = claude-history-uuid(row) ?? ""
        if !(seen has id)
            seen[id] = true
            merged += row
?! claude-history-error()
    if !merged.length

. session = claude-session-uuid()
. lines = List'String()
. previous String?
for row in merged
    . copy = Map'String'JSON()
    for key, value in row
        copy[key] = value
    copy["sessionId"] = session
    if previous && !claude-history-boundary(row)
        copy["parentUuid"] = previous
    previous = claude-history-uuid(row)
    lines += to-json(copy)
claude-write-history(directory / "${session}.jsonl", lines)
= ClaudePoint(session, previous)

━━━━━━━━━━━━━━━━━━━━
_ do claude-write-history ?! AIError
    - path Path
    - lines [String]

?! AIError(AIErrorKind.unknown, "Claude Code's history could not be written: $failure")
    catch failure Error
write-file-atomically(path, "${"\n".join(lines)}\n")

━━━━━━━━━━━━━━━━━━━━
+ claude-history-home Path

Path(env("CLAUDE_CONFIG_DIR") ?? "${env("HOME") ?? "/tmp"}/.claude", 0)

━━━━━━━━━━━━━━━━━━━━
+ do claude-history-directory Path?
    - home Path
    - session String

. projects = home / "projects"
=? if !projects.is-dir
for folder in projects.contents
    . candidate = folder / "${session}.jsonl"
    =? folder if candidate.is-file
= null

━━━━━━━━━━━━━━━━━━━━
+ do claude-session-folders [Path]
    - session String
    - directory String? = null
    - home Path? = null

. root = home ?? claude-history-home()
. folders = List'Path()
if directory
    . own = root / "projects" / claude-project-slug(directory)
    folders += own
    =? folders if (own / "${session}.jsonl").is-file
. found = claude-history-directory(root, session)
if found
    folders += found
= folders

━━━━━━━━━━━━━━━━━━━━
+ do claude-session-path Path?
    - session String
    - directory String? = null
    - home Path? = null

for folder in claude-session-folders(session, directory, home)
    . path = folder / "${session}.jsonl"
    =? path if path.is-file
= null

━━━━━━━━━━━━━━━━━━━━
+ do claude-project-slug String
    - directory String

. kept = List'String()
for char in directory
    if (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z') || (char >= '0' && char <= '9')
        kept += "$char"
    else if (char as U32) > 65535
        kept += "--"
    else
        kept += "-"
= "".join(kept)

━━━━━━━━━━━━━━━━━━━━
_ do claude-history ClaudeHistory ?! AIError
    - session String
    - directory Path?

?! claude-history-error()
    catch Error
?! claude-history-error()
    if !directory
. text = read-file-text(directory / "${session}.jsonl")
. rows = Map'String'[String = JSON]()
. tip String?
for line in text.split("\n")
    if !line.trim().length
        continue
    . value = catch? parse-json(line)
    . row = match? value
        | [String = JSON]
    . id = claude-history-uuid(row) if row
    if id
        rows[id] = row!
        tip = id
= ClaudeHistory(rows, tip)

━━━━━━━━━━━━━━━━━━━━
_ do claude-history-chain [[String = JSON]] ?! AIError
    - history ClaudeHistory
    - entry String?

. chain = List'[String = JSON]()
. current = entry ?? history.tip
while current
    . row = history.rows[current]
    ?! claude-history-error()
        if !row || chain.length > history.rows.length
    chain += row
    current = match? row["parentUuid"]
        | String
. ordered = List'[String = JSON]()
ordered ++= chain.reversed()
= ordered

━━━━━━━━━━━━━━━━━━━━
_ claude-history-uuid String?
    - row [String = JSON]?

match? row?["uuid"]
    | String

━━━━━━━━━━━━━━━━━━━━
_ claude-history-boundary
    - row [String = JSON]

subtype == "compact_boundary"

.. subtype = match? row["subtype"]
    | String

━━━━━━━━━━━━━━━━━━━━
_ claude-history-error

AIError(AIErrorKind.invalid-request, "Claude Code no longer has the history this chat needs")

━━━━━━━━━━━━━━━━━━━━
_ do claude-session-uuid String

. bytes = Byte[16]
C:getentropy(bytes, 16)
bytes[6] = (bytes[6] /and/ 0x0f) /or/ 0x40
bytes[8] = (bytes[8] /and/ 0x3f) /or/ 0x80
. hex String = bytes as Hex
= "${hex[0 .. < 8]}-${hex[8 .. < 12]}-${hex[12 .. < 16]}-${hex[16 .. < 20]}-${hex[20 .. < 32]}"
