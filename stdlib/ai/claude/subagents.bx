(import ./history)
(import ./wire)
(import /ai/model)
(import /data/json)
(import /os/file)
(import /os/path)
(import /time/datetime)
(blank)
(prop _ claude-handback-tool _ (= "SubagentHandback"))
(prop _ claude-latest-limit Size (= 200))
(prop _ claude-quiet-seconds _ (= 120))

(fn-do + claude-subagents (list AISubagent) (?! Error)
  (param parts (list AIMessagePart))
  (param directory (? String))
  (let found (call (of List AISubagent)))
  (let session (? String))
  (let calls (call (of List String)))
  (for (in part parts)
    (= session (?? (call claude-part-session part) session))
    (if (= (| (: call AIToolCallPart)) part)
      (if (or (== (. call tool-name) "Agent") (== (. call tool-name) "Task"))
        (+= calls (. call call-id))
      )
    )
  )
  (return-if found (if (or (not session) (not (. calls length)))))
  (blank)
  (let metas (call (of Map String ClaudeAgentMeta)))
  (for (in home (call claude-session-folders session directory))
    (let folder (/ home session "subagents"))
    (if (. folder exists)
      (for (in entry (. folder entries))
        (if (call (. entry name ends-with) ".meta.json")
          (let meta (catch? (call claude-read-meta folder (. entry name))))
          (if meta
            (= ([] metas (. meta call-id)) meta)
          )
        )
      )
    )
  )
  (for (in call-id calls)
    (let meta ([] metas call-id))
    (if meta
      (let agent (catch? (call claude-read-agent meta)))
      (if agent
        (+= found agent)
      )
    )
  )
  (return found)
)

(fn-do + claude-apply-line _ (?! Error)
  (param decoder ClaudeDecoder)
  (param reply AIReply)
  (param line String)
  (for (in event (call (. decoder decode) (call parse-json line)))
    (call (. reply apply) event)
  )
)

(type _ ClaudeAgentMeta (is Tuple)
  (prop + id String)
  (prop + call-id String)
  (prop + title String)
  (prop + kind String)
  (prop + folder Path)
)

(fn-do _ claude-read-meta ClaudeAgentMeta (?! Error)
  (param folder Path)
  (param name String)
  (let fields (call (. (call JSONReader "agent" (call parse-json (call read-file-text (/ folder name)))) object)))
  (let id ([] name (..< 0 (- (. name length) (. ".meta.json" length)))))
  (let title (if-expr (. ([] fields "description") is-present) (call (. ([] fields "description") string)) "Agent"))
  (let kind (if-expr (. ([] fields "agentType") is-present) (call (. ([] fields "agentType") string)) "agent"))
  (return (call ClaudeAgentMeta id (call (. ([] fields "toolUseId") string)) title kind folder))
)

(fn-do _ claude-read-agent AISubagent (?! Error)
  (param meta ClaudeAgentMeta)
  (let path (/ (. meta folder) (str (. meta id) ".jsonl")))
  (let decoder (call ClaudeDecoder))
  (let reply (call AIReply))
  (for (in line (call (. (call read-file-text path) split) "\n"))
    (if (> (. (call (. line trim)) length) 0)
      (catch (call claude-apply-line decoder reply line))
    )
  )
  (let parts (call (of List AIMessagePart)))
  (let steps Size 0)
  (let latest (? String))
  (let result (? String))
  (for (in part (. reply parts))
    (if (is part AIExtensionPart)
      (continue)
    )
    (+= parts part)
    (if (= (| (: call AIToolCallPart)) part)
      (+= steps 1)
      (if (== (. call tool-name) claude-handback-tool)
        (= result (call claude-handback-message call))
      )
      (else-if (= (| (: text AITextPart)) part)
        (if (> (. (call (. text text trim)) length) 0)
          (= latest (call claude-first-line (. text text)))
        )
      )
    )
  )
  (let is-quiet (> (- (. (call now) since-epoch) (. path modified since-epoch)) claude-quiet-seconds))
  (return
    (call AISubagent
      (block
        (arg (. meta id))
        (arg (. meta title))
        (arg (. meta kind))
        (arg (. meta call-id))
        (arg (and (== result null) (not is-quiet)))
        (arg steps)
        (arg latest)
        (arg result)
        (arg parts)
      )
    )
  )
)

(fn-do _ claude-handback-message (? String)
  (param call AIToolCallPart)
  (if (= (| (: fields (map String JSON))) (. call arguments))
    (match? fields
      (case (map "message" (: message String))
        (return message)
      )
    )
  )
  (return null)
)

(fn-expr _ claude-first-line String
  (param text String)
  (if-expr (<= (. line length) claude-latest-limit) line (str (call (. ([] line (..< 0 claude-latest-limit)) trim)) "…"))
  (where
    (lazy trimmed (call (. text trim)))
    (lazy ending (call (. trimmed find) "\n"))
    (lazy line (if-expr (!= ending null) ([] trimmed (..< 0 ending)) trimmed))
  )
)
