./history
./subagents
./wire
/ai/model
/data/json
/os/file
/os/path

━━━━━━━━━━━━━━━━━━━━
+ do claude-caught-up [AIMessagePart]? ?! Error
    - parts [AIMessagePart]
    - directory String?

. marked Index?
. mark ClaudeMark?
for position in 0 .. < parts.length
    . found = claude-part-mark(parts[position])
    if found
        mark = found
        marked = position
=? null if !mark || !mark.point.entry
. entry = mark.point.entry
. path = claude-session-path(mark.point.session, directory)
=? null if !path
. text = read-file-text(path)
. start = text.find("\"uuid\":\"$entry\"")
=? null if start == null
. chain = Map'String'Bool
    • (entry) true
. decoder = ClaudeDecoder()
decoder.resume-mark(parts[marked!])
. reply = AIReply()
. is-first = true
for line in text[start .. < text.length].split("\n")
    if is-first
        is-first = false
        continue
    . value = catch? parse-json(line)
    if value
        if | fields [String = JSON] = value
            . uuid = claude-field-text(fields, "uuid")
            . parent = claude-field-text(fields, "parentUuid") ?? claude-field-text(fields, "logicalParentUuid")
            if uuid && parent && chain has parent
                chain[uuid] = true
                . kind = claude-field-text(fields, "type")
                if kind == "assistant" || kind == "user"
                    catch claude-apply-line(decoder, reply, line)
. merged = List'AIMessagePart(parts)
. added Size = 0
for part in reply.parts
    if claude-part-mark(part)
        merged[marked!] = part
    else if part is not AIExtensionPart
        . index = ai-part-index(merged, ai-part-id(part))
        if index
            merged[index] = part
        else
            merged += part
        added += 1
=? null if added == 0
= merged

━━━━━━━━━━━━━━━━━━━━
+ do claude-is-stranded Bool
    - point ClaudePoint
    - directory String?

. entry = point.entry
=? false if !entry
. path = claude-session-path(point.session, directory)
=? false if !path
. text = catch? read-file-text(path)
=? false if text == null
. start = text.find("\"uuid\":\"$entry\"")
=? false if start == null
. chain = Map'String'Bool
    • (entry) true
. checkpoint String?
. is-first = true
for line in text[start .. < text.length].split("\n")
    if is-first
        is-first = false
        continue
    . value = catch? parse-json(line)
    if | fields [String = JSON] = value
        . uuid = claude-field-text(fields, "uuid")
        . parent = claude-field-text(fields, "parentUuid") ?? claude-field-text(fields, "logicalParentUuid")
        if claude-field-text(fields, "type") == "last-prompt"
            checkpoint = claude-field-text(fields, "leafUuid") ?? checkpoint
        else if uuid && parent && chain has parent
            chain[uuid] = true
= checkpoint != null && !(chain has checkpoint)

━━━━━━━━━━━━━━━━━━━━
_ do claude-field-text String?
    - fields [String = JSON]
    - name String

. value = fields[name]
=? null if value == null
if | text String = value
    = text
= null
