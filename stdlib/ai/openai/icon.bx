(import /graphics/primitives)
(import /graphics/style)
(import /graphics/vector)
(import /gui/theme)
(import /gui/vector-image)
(import /math)

(type + OpenAIIcon (is VectorImage)
  (fn-do + This _
    (= view-box (call Rect 0 0 24 24))
  )
  (content
    (<> This
      (= fill $gui-text-color)
      (= stroke (. Stroke none))
      (blank)
      (<> VectorPath
        (= d (call openai-icon-path))
      )
    )
  )
)

