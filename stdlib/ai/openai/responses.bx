(import ./completions)
(import /ai/media)
(import /ai/model)
(import /data)
(import /data/json)
(import /net/http)
(import /net/sse)
(import /net/url)
(blank)
(prop + openai-default-model _ (= "gpt-6.1-sol"))
(prop + openai-default-effort _ (= "xhigh"))

(type + OpenAIResponses (is AIProvider)
  (prop + api-key String)
  (prop + base-url URL)
  (prop + reasoning-effort (? String))
  (prop + reasoning-summary (? String))
  (fn-do + This _
    (param api-key _)
    (param base-url _ (= openai-api-base))
    (param reasoning-effort (? String) (= null))
    (param reasoning-summary (? String) (= null))
    (call super)
  )
  (fn-expr _ headers (list HTTPHeader) :get
    (item (tuple "Authorization" (str "Bearer " api-key)))
    (item (tuple "Content-Type" "application/json"))
    (item (tuple "Accept" "text/event-stream"))
  )
  (fn-do + stream (stream AIEvent)
    (param request AIRequest)
    (for (in event (call openai-responses-provider-events this request))
      (yield event)
    )
  )
)

(fn-do _ openai-responses-provider-events (stream AIEvent)
  (param provider OpenAIResponses)
  (param request AIRequest)
  (let response
    (call openai-responses-provider-response provider request
      (block
        (on-error (: canceled TaskCancelationError)
          (throw (call AIError (. AIErrorKind cancellation) (str canceled)))
        )
        (on-error (: terminated TaskTerminationError)
          (throw (call AIError (. AIErrorKind cancellation) (str terminated)))
        )
      )
    )
  )
  (if (!= (. response status) (. HTTPStatus ok))
    (let error-body (. response text))
    (let error (call openai-response-error response error-body))
    (do
      (inline (call (. response close)))
    )
    (throw error)
  )
  (blank)
  (for (in event (call openai-responses-events (call OpenAIResponseLease response)))
    (yield event)
  )
)

(fn-do _ openai-responses-provider-response HTTPResponse (?! AIError)
  (param provider OpenAIResponses)
  (param request AIRequest)
  (let value
    (call openai-responses-request-value
      (block
        (arg request)
        (arg (. provider reasoning-effort))
        (arg (. provider reasoning-summary))
      )
    )
  )
  (let body (call to-json value))
  (let endpoint (/ (. provider base-url) "responses"))
  (blank)
  (throw (call AIError (. AIErrorKind unknown) (str transport-error)) (on-error (: transport-error Error)))
  (blank)
  (return (call http-send (call HTTPRequest (. HTTPMethod post) endpoint (. provider headers) body)))
)

(fn-do + openai-responses-request-value JSON (?! AIError)
  (param request AIRequest)
  (param reasoning-effort (? String) (= null))
  (param reasoning-summary (? String) (= null))
  (throw (call AIError (. AIErrorKind invalid-request) "AIRequest.model is required") (if (not (. request model))))
  (throw (call AIError (. AIErrorKind invalid-request) "OpenAI Responses does not support image output") (if (. request image-output)))
  (throw (call AIError (. AIErrorKind invalid-request) "OpenAI Responses does not support audio output") (if (. request audio-output)))
  (throw (call AIError (. AIErrorKind invalid-request) "OpenAI Responses does not support video output") (if (. request video-output)))
  (throw (call AIError (. AIErrorKind invalid-request) "OpenAI Responses does not support stop sequences") (if (. request options stop-sequences)))
  (blank)
  (let root
    (call (of Map String JSON)
      (block
        (:model (. request model))
        (:input (call responses-input-value (. request messages)))
        (:stream true)
        (:store false)
        (:include (call responses-include-list))
        (:temperature? (. request options temperature))
      )
    )
  )
  (blank)
  (if (. request options maximum-output-tokens)
    (= ([] root "max_output_tokens") (as (. request options maximum-output-tokens) Int))
  )
  (if (or reasoning-effort reasoning-summary)
    (= ([] root "reasoning")
      (call (of Map String JSON)
        (block
          (:effort? reasoning-effort)
          (:summary? reasoning-summary)
        )
      )
    )
  )
  (if (or (. request tools) (. request web-search))
    (= ([] root "tools") (call responses-tools-value (. request tools) (. request web-search)))
  )
  (if (. request tool-choice)
    (= ([] root "tool_choice") (call responses-tool-choice-value (. request tool-choice)))
  )
  (if (. request response-schema)
    (= ([] root "text")
      (call (of Map String JSON)
        (block
          (:format
            (call (of Map String JSON)
              (block
                (:type "json_schema")
                (:name "response")
                (:strict true)
                (:schema (. request response-schema))
              )
            )
          )
        )
      )
    )
  )
  (if (. request provider-json)
    (call merge-openai-object root (. request provider-json) "AIRequest.provider-json")
  )
  (return root)
)

(fn-expr _ responses-include-list (list JSON)
  (item "reasoning.encrypted_content")
)

(fn-do _ responses-input-value JSON (?! AIError)
  (param messages (list AIMessage))
  (let items (list JSON))
  (for (in message messages)
    (call add-responses-message items message)
  )
  (return items)
)

(fn-do _ add-responses-message _ (?! AIError)
  (param items (list JSON))
  (param message AIMessage)
  (if (== (. message role) (. AIMessageRole user))
    (+= items
      (call (of Map String JSON)
        (block
          (:role "user")
          (:content (call responses-user-content-value (. message parts)))
        )
      )
    )
    (else-if (== (. message role) (. AIMessageRole assistant))
      (call add-responses-reply items (. message parts))
    )
    (else-if (== (. message role) (. AIMessageRole tool))
      (for (in part (. message parts))
        (+= items (call responses-tool-result-value part))
      )
    )
    (else
      (+= items
        (call (of Map String JSON)
          (block
            (:role (call responses-role (. message role)))
            (:content (call ai-parts-text (. message parts)))
          )
        )
      )
    )
  )
)

(fn-expr _ responses-role _
  (param role AIMessageRole)
  (match role
    (case (. AIMessageRole developer)
      "developer"
    )
    (default
      "system"
    )
  )
)

(fn-expr _ responses-user-content-value JSON (?! AIError)
  (param parts (list AIMessagePart))
  (in (call responses-user-content each) parts)
)

(fn-expr _ responses-user-content JSON (?! AIError)
  (param part AIMessagePart)
  (match part
    (case (: text AITextPart)
      (call responses-text-content (. text text))
    )
    (case (: image AIImagePart)
      (call responses-image-content (. image image file))
    )
    (case (: file AIFilePart)
      (call responses-file-content (. file file))
    )
    (case (all (: extension AIExtensionPart) ({} (== (. it provider-id) "openai")))
      (. extension data)
    )
    (throw
      (call AIError
        (block
          (arg (. AIErrorKind invalid-request))
          (arg (str "OpenAI Responses cannot send " (type-of part) " from the user"))
        )
      )
    )
  )
)

(fn-expr _ responses-text-content JSON
  (param text String)
  (call (of Map String JSON)
    (block
      (:type "input_text")
      (:text text)
    )
  )
)

(fn-do _ responses-image-content JSON (?! AIError)
  (param file AIFile)
  (let file-id (call responses-file-id file))
  (let content
    (call (of Map String JSON)
      (block
        (:type "input_image")
        (:detail "auto")
      )
    )
  )
  (if file-id
    (= ([] content "file_id") file-id)
    (else
      (= ([] content "image_url") (call openai-file-url file))
    )
  )
  (return content)
)

(fn-do _ responses-file-content JSON (?! AIError)
  (param file AIFile)
  (let file-id (call responses-file-id file))
  (let content
    (call (of Map String JSON)
      (block
        (:type "input_file")
        (:filename? (. file filename))
      )
    )
  )
  (if file-id
    (= ([] content "file_id") file-id)
    (else-if (is (. file source) AIURLSource)
      (= ([] content "file_url") (. (as (. file source) AIURLSource) url))
    )
    (else
      (= ([] content "file_data") (call openai-file-url file))
    )
  )
  (return content)
)

(fn-expr _ responses-file-id (? String) (?! AIError)
  (param file AIFile)
  (case? (is-not (. file source) AIProviderFileSource)
    null
  )
  (throw (call AIError (. AIErrorKind invalid-request) (str "OpenAI cannot use a file ID owned by " (. provider-file provider-id))) (if (!= (. provider-file provider-id) "openai")))
  (default
    (. provider-file file-id)
  )
  (where
    (lazy provider-file (as (. file source) AIProviderFileSource))
  )
)

(fn-do _ add-responses-reply _ (?! AIError)
  (param items (list JSON))
  (param parts (list AIMessagePart))
  (let run-id (? String))
  (let run (list JSON))
  (for (in part parts)
    (let source-id (only-if (. (as part AITextPart) source-id) (if (is part AITextPart))))
    (if (and run-id (!= source-id run-id))
      (+= items (call responses-output-message run-id run))
      (= run (call (of List JSON)))
      (= run-id null)
    )
    (if source-id
      (= run-id source-id)
      (+= run (call responses-output-text (. (as part AITextPart) text)))
      (else
        (call add-responses-reply-item items part)
      )
    )
  )
  (if run-id
    (+= items (call responses-output-message run-id run))
  )
)

(fn-do _ add-responses-reply-item _ (?! AIError)
  (param items (list JSON))
  (param part AIMessagePart)
  (match part
    (case (: text AITextPart)
      (if (. text text)
        (+= items (call responses-said (. text text)))
      )
    )
    (case (: refusal AIRefusalPart)
      (+= items (call responses-said (. refusal text)))
    )
    (case (: reasoning AIReasoningPart)
      (let item (call json-object (. reasoning provider-signature)))
      (if (and item (== (call json-string ([] item "type")) "reasoning"))
        (+= items item)
      )
    )
    (case (: call AIToolCallPart)
      (+= items
        (call (of Map String JSON)
          (block
            (:type "function_call")
            (entry "call_id" (. call call-id))
            (:name (. call tool-name))
            (:arguments (call to-json (. call arguments)))
            (:id? (call json-string (. call provider-signature)))
          )
        )
      )
    )
    (case (: result AIToolResultPart)
      (+= items (call responses-tool-result-value result))
    )
    (case (: search AIWebSearchPart)
      (if (. search search-id)
        (+= items (call responses-search-call search))
      )
    )
    (case (: extension AIExtensionPart)
      (if (== (. extension provider-id) "openai")
        (+= items (. extension data))
      )
    )
    (throw
      (call AIError
        (block
          (arg (. AIErrorKind invalid-request))
          (arg (str "OpenAI Responses cannot send " (type-of part) " from the assistant"))
        )
      )
    )
  )
)

(fn-expr _ responses-said _
  (param text String)
  (call (of Map String JSON)
    (block
      (:role "assistant")
      (:content text)
    )
  )
)

(fn-expr _ responses-output-message _
  (param id String)
  (param content (list JSON))
  (call (of Map String JSON)
    (block
      (:type "message")
      (:id id)
      (:role "assistant")
      (:status "completed")
      (:content content)
    )
  )
)

(fn-expr _ responses-output-text JSON
  (param text String)
  (call (of Map String JSON)
    (block
      (:type "output_text")
      (:text text)
      (:annotations (call (of List JSON)))
    )
  )
)

(fn-expr _ responses-search-call _
  (param search AIWebSearchPart)
  (call (of Map String JSON)
    (block
      (:type "web_search_call")
      (:id? (. search search-id))
      (:status "completed")
      (:action
        (call (of Map String JSON)
          (block
            (:type "search")
            (:query (. search query))
          )
        )
      )
    )
  )
)

(fn-expr _ responses-tool-result-value JSON (?! AIError)
  (param part AIMessagePart)
  (match part
    (case (: result AIToolResultPart)
      (call (of Map String JSON)
        (block
          (:type "function_call_output")
          (entry "call_id" (. result call-id))
          (:output (?? (. result text-output) (call to-json (. result output))))
        )
      )
    )
    (throw (call AIError (. AIErrorKind invalid-request) "An OpenAI tool message can only hold tool results"))
  )
)

(fn-do _ responses-tools-value JSON (?! AIError)
  (param tools (list AITool))
  (param search (? AIWebSearchOptions))
  (let values (list JSON))
  (for (in tool tools)
    (+= values
      (call (of Map String JSON)
        (block
          (:type "function")
          (:name (. tool name))
          (:description (. tool description))
          (:parameters (. tool parameters))
          (:strict (. tool is-strict))
        )
      )
    )
  )
  (if search
    (let web
      (call (of Map String JSON)
        (block
          (:type "web_search")
          (entry "search_context_size" (call openai-search-context (. search context)))
        )
      )
    )
    (if (. search provider-json)
      (call merge-openai-object web (. search provider-json) "AIWebSearchOptions.provider-json")
    )
    (+= values web)
  )
  (return values)
)

(fn-expr _ responses-tool-choice-value _
  (param choice AIToolChoice)
  (match choice
    (case (. AIToolChoice automatic)
      (as "auto" JSON)
    )
    (case (. AIToolChoice none)
      (as "none" JSON)
    )
    (case (. AIToolChoice required)
      (as "required" JSON)
    )
    (case (: named AINamedToolChoice)
      (as (call responses-named-tool-choice named) JSON)
    )
  )
)

(fn-expr _ responses-named-tool-choice _
  (param choice AINamedToolChoice)
  (call (of Map String JSON)
    (block
      (:type "function")
      (:name (. choice name))
    )
  )
)

(fn-do + openai-responses-stream-events (stream AIEvent)
  (param body (of ReadableData Byte))
  (let state (call OpenAIResponsesState))
  (for (in event (call server-sent-events body))
    (if (!= (. event data) "[DONE]")
      (let decoded (call parse-openai-json (. event data) "OpenAI returned invalid response stream JSON"))
      (for (in ai-event (call consume-responses-event state decoded))
        (yield ai-event)
      )
    )
  )
  (blank)
  (if (not (. state is-done))
    (throw
      (call AIError
        (block
          (arg (. AIErrorKind invalid-response))
          (arg "OpenAI response stream ended before the response completed")
        )
      )
    )
  )
)

(fn-do + openai-responses-events (stream AIEvent)
  (param lease OpenAIResponseLease)
  (finally
    (inline (call (. lease close)))
  )
  (for (in event (call openai-responses-stream-events (. lease response reader)))
    (yield event)
  )
)

(type _ OpenAIResponsesState
  (prop + has-calls _ (= false))
  (prop + is-done _ (= false))
)

(fn-do _ consume-responses-event (stream AIEvent)
  (param state OpenAIResponsesState)
  (param value JSON)
  (throw (call AIError (. AIErrorKind invalid-response) "OpenAI response stream event was not an object") (if (is-not value (map String JSON))))
  (blank)
  (let root (as value (map String JSON)))
  (let kind (?? (call json-string ([] root "type")) ""))
  (let item-id (?? (call json-string ([] root "item_id")) ""))
  (let content-id (str item-id ":" (?? (call json-size ([] root "content_index")) 0)))
  (let delta (?? (call json-string ([] root "delta")) ""))
  (blank)
  (match kind
    (case "response.output_item.added"
      (let item (call json-object ([] root "item")))
      (let begun (only-if (call responses-begun-part item) (if item)))
      (if begun
        (yield (call AIPartBeginEvent begun))
      )
    )
    (case "response.content_part.added"
      (let part (?? (call json-object ([] root "part")) (call (of Map String JSON))))
      (let part-kind (call json-string ([] part "type")))
      (if (== part-kind "output_text")
        (yield (call AIPartBeginEvent (call AITextPart content-id "" item-id)))
        (else-if (== part-kind "refusal")
          (yield (call AIPartBeginEvent (call AIRefusalPart content-id "")))
        )
      )
    )
    (case "response.output_text.delta"
      (if delta
        (yield (call AIPartDeltaEvent content-id (call AITextDelta delta)))
      )
    )
    (case "response.refusal.delta"
      (if delta
        (yield (call AIPartDeltaEvent content-id (call AITextDelta delta)))
      )
    )
    (case "response.reasoning_summary_part.added"
      (if (?? (call json-size ([] root "summary_index")) 0)
        (yield (call AIPartDeltaEvent item-id (call AIReasoningDelta "\n\n")))
      )
    )
    (case "response.reasoning_summary_text.delta"
      (if delta
        (yield (call AIPartDeltaEvent item-id (call AIReasoningDelta delta)))
      )
    )
    (case "response.function_call_arguments.delta"
      (if delta
        (yield (call AIPartDeltaEvent item-id (call AIToolArgumentsDelta delta)))
      )
    )
    (case "response.output_item.done"
      (let item (call json-object ([] root "item")))
      (if item
        (for (in part (call responses-ended-parts state item))
          (yield (call AIPartEndEvent part))
        )
      )
    )
    (case "response.completed"
      (= (. state is-done) true)
      (yield (call responses-done state root))
    )
    (case "response.incomplete"
      (= (. state is-done) true)
      (yield (call responses-done state root))
    )
    (case "response.failed"
      (let response (?? (call json-object ([] root "response")) (call (of Map String JSON))))
      (throw (call responses-error (?? (call json-object ([] response "error")) (call (of Map String JSON)))))
    )
    (case "error"
      (throw (call responses-error root))
    )
    (default
      (return)
    )
  )
)

(fn-expr _ responses-begun-part (? AIMessagePart)
  (param item (map String JSON))
  (match? (call json-string ([] item "type"))
    (case "reasoning"
      (call AIReasoningPart id "")
    )
    (case "function_call"
      (call AIToolCallPart
        (block
          (arg id)
          (arg (?? (call json-string ([] item "call_id")) ""))
          (arg (?? (call json-string ([] item "name")) ""))
          (arg null)
        )
      )
    )
    (case "web_search_call"
      (call AIWebSearchPart id "" (. AIWebSearchStatus searching) id)
    )
  )
  (where
    (lazy id (?? (call json-string ([] item "id")) ""))
  )
)

(fn-do _ responses-ended-parts (stream AIMessagePart) (?! AIError)
  (param state OpenAIResponsesState)
  (param item (map String JSON))
  (let id (?? (call json-string ([] item "id")) ""))
  (let kind (?? (call json-string ([] item "type")) ""))
  (if (== kind "message")
    (let content (?? (call json-array ([] item "content")) (call (of List JSON))))
    (for (in index (..< 0 (. content length)))
      (let entry (?? (call json-object ([] content index)) (call (of Map String JSON))))
      (let entry-kind (call json-string ([] entry "type")))
      (if (== entry-kind "output_text")
        (let text (?? (call json-string ([] entry "text")) ""))
        (yield (call AITextPart (str id ":" index) text id (call responses-citations ([] entry "annotations"))))
        (else-if (== entry-kind "refusal")
          (yield (call AIRefusalPart (str id ":" index) (?? (call json-string ([] entry "refusal")) "")))
        )
      )
    )
    (else-if (== kind "reasoning")
      (yield (call AIReasoningPart id (call responses-summary-text item) null item))
    )
    (else-if (== kind "function_call")
      (= (. state has-calls) true)
      (let text (?? (call json-string ([] item "arguments")) ""))
      (let arguments (call parse-openai-json text "OpenAI returned invalid tool arguments"))
      (let call-id (?? (call json-string ([] item "call_id")) ""))
      (let name (?? (call json-string ([] item "name")) ""))
      (yield (call AIToolCallPart id call-id name arguments (as id JSON)))
    )
    (else-if (== kind "web_search_call")
      (let action (?? (call json-object ([] item "action")) (call (of Map String JSON))))
      (let query (?? (call json-string ([] action "query")) ""))
      (let failed (== (call json-string ([] item "status")) "failed"))
      (let status (if-expr failed (. AIWebSearchStatus failed) (. AIWebSearchStatus completed)))
      (yield (call AIWebSearchPart id query status id))
    )
  )
)

(fn-do _ responses-summary-text String
  (param item (map String JSON))
  (let texts (call (of List String)))
  (for (in value (?? (call json-array ([] item "summary")) (call (of List JSON))))
    (let text (call json-string ([] (?? (call json-object value) (call (of Map String JSON))) "text")))
    (if text
      (+= texts text)
    )
  )
  (return (call (. "\n\n" join) texts))
)

(fn-do _ responses-citations (list AICitation)
  (param value (? JSON))
  (let citations (call (of List AICitation)))
  (for (in entry (?? (call json-array value) (call (of List JSON))))
    (let annotation (?? (call json-object entry) (call (of Map String JSON))))
    (if (== (call json-string ([] annotation "type")) "url_citation")
      (let title (?? (call json-string ([] annotation "title")) ""))
      (let url (?? (call json-string ([] annotation "url")) ""))
      (let start (call json-size ([] annotation "start_index")))
      (let end (call json-size ([] annotation "end_index")))
      (+= citations (call AICitation title url start end))
    )
  )
  (return citations)
)

(fn-expr _ responses-done AIDoneEvent (?! AIError)
  (param state OpenAIResponsesState)
  (param root (map String JSON))
  (before
    (throw (call AIError (. AIErrorKind invalid-response) "OpenAI response event omitted its response") (if (not response)))
  )
  (call AIDoneEvent (call responses-finish-reason (. state has-calls) (call json-string ([] details "reason"))) usage)
  (where
    (lazy response (call json-object ([] root "response")))
    (lazy usage-value (call json-object ([] response "usage")))
    (lazy usage (if-expr usage-value (call responses-usage usage-value) (call AIUsage)))
    (lazy details (?? (call json-object ([] response "incomplete_details")) (call (of Map String JSON))))
  )
)

(fn-expr _ responses-finish-reason AIFinishReason
  (param has-calls Bool)
  (param reason (? String))
  (case? (== reason "max_output_tokens")
    (. AIFinishReason length)
  )
  (case? (== reason "content_filter")
    (. AIFinishReason content-filter)
  )
  (case? reason
    (call AIProviderFinishReason "openai" reason)
  )
  (case? has-calls
    (. AIFinishReason tool-calls)
  )
  (default
    (. AIFinishReason stop)
  )
)

(fn-expr _ responses-usage _
  (param value (map String JSON))
  (call AIUsage
    (block
      (:input-tokens (call json-size ([] value "input_tokens")))
      (:output-tokens (call json-size ([] value "output_tokens")))
      (:total-tokens (call json-size ([] value "total_tokens")))
      (:cached-input-tokens cached-input-tokens)
      (:reasoning-tokens reasoning-tokens)
    )
  )
  (where
    (lazy input-details (call json-object ([] value "input_tokens_details")))
    (lazy output-details (call json-object ([] value "output_tokens_details")))
    (lazy cached-input-tokens (only-if (call json-size ([] input-details "cached_tokens")) (if input-details)))
    (lazy reasoning-tokens (only-if (call json-size ([] output-details "reasoning_tokens")) (if output-details)))
  )
)

(fn-expr _ responses-error _
  (param error (map String JSON))
  (call AIError kind message null (or (== kind (. AIErrorKind rate-limit)) (== kind (. AIErrorKind server))))
  (where
    (lazy message (?? (call json-string ([] error "message")) "OpenAI could not complete the response"))
    (lazy kind
      (match (?? (call json-string ([] error "code")) "")
        (case "rate_limit_exceeded"
          (. AIErrorKind rate-limit)
        )
        (case "server_error"
          (. AIErrorKind server)
        )
        (case "context_length_exceeded"
          (. AIErrorKind context-length)
        )
        (default
          (. AIErrorKind invalid-request)
        )
      )
    )
  )
)

(fn-expr _ json-string _
  (param value (? JSON))
  (match? value
    (case String)
  )
)

(fn-expr _ json-object _
  (param value (? JSON))
  (match? value
    (case (map String JSON))
  )
)

(fn-expr _ json-array _
  (param value (? JSON))
  (match? value
    (case (list JSON))
  )
)

(fn-expr _ json-size (? Size)
  (param value (? JSON))
  (match? value
    (case (all Int ({} (>= it 0))))
  )
)
