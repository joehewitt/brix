(import /ai/media)
(import /ai/model)
(import /data)
(import /data/json)
(import /net/http)
(import /net/sse)
(import /net/url)
(import /os/file)
(import /stream/aggregate)
(blank)
(prop + openai-api-base URL (= "https://api.openai.com/v1"))

(type + OpenAICompletions (is AIProvider)
  (prop + api-key String)
  (prop + base-url URL)
  (fn-do + This _
    (param api-key _)
    (param base-url _ (= openai-api-base))
    (call super)
  )
  (fn-do + stream (stream AIEvent)
    (param request AIRequest)
    (for (in event (call openai-provider-events this request))
      (yield event)
    )
  )
  (fn-expr _ headers (list HTTPHeader) :get
    (item (tuple "Authorization" (str "Bearer " api-key)))
    (item (tuple "Content-Type" "application/json"))
    (item (tuple "Accept" "text/event-stream"))
  )
)

(type + OpenAIResponseLease
  (prop + response HTTPResponse)
  (prop + close-count Size)
  (prop + is-closed Bool)
  (fn-do + This _
    (param response _)
  )
  (fn-do + close _
    (return-if (if is-closed))
    (blank)
    (= is-closed true)
    (+= close-count 1)
    (call (. response close))
  )
)

(fn-expr + parse-openai-json JSON (?! AIError)
  (param text String)
  (param service-message String)
  (match text
    (~ \json-text)
    (throw (call AIError (. AIErrorKind invalid-response) service-message))
  )
)

(fn-expr + openai-request-json String (?! AIError)
  (param request AIRequest)
  (call to-json (call openai-request-value request))
)

(fn-do + openai-request-value JSON (?! AIError)
  (param request AIRequest)
  (throw (call AIError (. AIErrorKind invalid-request) "AIRequest.model is required") (if (not (. request model))))
  (throw (call AIError (. AIErrorKind invalid-request) "OpenAI Chat Completions does not support image output") (if (. request image-output)))
  (throw (call AIError (. AIErrorKind invalid-request) "OpenAI Chat Completions does not support video output") (if (. request video-output)))
  (blank)
  (let root
    (call (of Map String JSON)
      (block
        (:model (. request model))
        (:messages (call openai-messages-value (. request messages)))
        (:stream true)
        (entry "stream_options"
          (call (of Map String JSON)
            (block
              (entry "include_usage" true)
            )
          )
        )
        (:temperature? (. request options temperature))
      )
    )
  )
  (blank)
  (if (. request options maximum-output-tokens)
    (= ([] root "max_completion_tokens") (as (. request options maximum-output-tokens) Int))
  )
  (if (. request options stop-sequences)
    (= ([] root "stop") (call openai-strings-value (. request options stop-sequences)))
  )
  (if (. request tools)
    (= ([] root "tools") (call openai-tools-value (. request tools)))
  )
  (if (. request tool-choice)
    (= ([] root "tool_choice") (call openai-tool-choice-value (. request tool-choice)))
  )
  (if (. request response-schema)
    (= ([] root "response_format")
      (call (of Map String JSON)
        (block
          (:type "json_schema")
          (entry "json_schema"
            (call (of Map String JSON)
              (block
                (:name "response")
                (:strict true)
                (:schema (. request response-schema))
              )
            )
          )
        )
      )
    )
  )
  (if (. request web-search)
    (= ([] root "web_search_options") (call openai-web-search-value (. request web-search)))
  )
  (if (. request audio-output)
    (= ([] root "modalities") (call openai-modalities-value))
    (= ([] root "audio") (call openai-audio-output-value (!! (. request audio-output))))
  )
  (if (. request provider-json)
    (call merge-openai-object root (. request provider-json) "AIRequest.provider-json")
  )
  (return root)
)

(fn-do + openai-file-url _ (?! AIError)
  (param file AIFile)
  (if (is (. file source) AIURLSource)
    (return (. (as (. file source) AIURLSource) url))
  )
  (if (is (. file source) AIBase64Source)
    (return (str "data:" (. file mime-type) ";base64," (. (as (. file source) AIBase64Source) data)))
  )
  (if (is (. file source) AIBytesSource)
    (return (str "data:" (. file mime-type) ";base64," (as (. (as (. file source) AIBytesSource) data) Base64)))
  )
  (if (is (. file source) AIPathSource)
    (let bytes (call openai-path-bytes (. (as (. file source) AIPathSource) path)))
    (return (str "data:" (. file mime-type) ";base64," (as bytes Base64)))
  )
  (blank)
  (throw (call AIError (. AIErrorKind invalid-request) "OpenAI cannot use a remote provider file as a media URL"))
)

(fn-do + merge-openai-object _ (?! AIError)
  (param target (map String JSON))
  (param value JSON)
  (param label String)
  (throw (call AIError (. AIErrorKind invalid-request) (str label " must be a JSON object")) (if (is-not value (map String JSON))))
  (blank)
  (for (in (tuple key item) (as value (map String JSON)))
    (= ([] target key) item)
  )
)

(fn-expr + openai-search-context _
  (param context AIWebSearchContext)
  (match context
    (case (. AIWebSearchContext low)
      "low"
    )
    (case (. AIWebSearchContext medium)
      "medium"
    )
    (case (. AIWebSearchContext high)
      "high"
    )
  )
)

(fn-do + openai-stream-events (stream AIEvent)
  (param body (of ReadableData Byte))
  (let state (call OpenAIStreamState))
  (for (in event (call server-sent-events body))
    (if (== (. event data) "[DONE]")
      (for (in final-event (call finish-openai-stream state))
        (yield final-event)
      )
      (return)
    )
    (blank)
    (let decoded (call parse-openai-json (. event data) "OpenAI returned invalid stream JSON"))
    (for (in ai-event (call consume-openai-chunk state decoded))
      (yield ai-event)
    )
  )
)

(fn-do + openai-response-events (stream AIEvent)
  (param lease OpenAIResponseLease)
  (finally
    (inline (call (. lease close)))
  )
  (for (in event (call openai-stream-events (. lease response reader)))
    (yield event)
  )
)

(fn-do + openai-response-error _
  (param response HTTPResponse)
  (param body String)
  (let decoded (catch? (call JSON body)))
  (let service-message body)
  (if decoded
    (let root (call json-object decoded))
    (if root
      (let error (call json-object ([] root "error")))
      (if (and error (call json-string ([] error "message")))
        (= service-message (!! (call json-string ([] error "message"))))
      )
    )
  )
  (blank)
  (let status (as (. response status) Int))
  (let kind (call openai-error-kind status decoded))
  (let retryable (or (== status 408) (== status 409) (== status 429) (>= status 500)))
  (return (call AIError kind service-message status retryable (call (. response header) "Retry-After")))
)

(type _ OpenAIStreamState
  (prop + completion-id String (= "openai"))
  (prop + text _ (= ""))
  (prop + text-started _ (= false))
  (prop + citations (list AICitation))
  (prop + reasoning _ (= ""))
  (prop + reasoning-started _ (= false))
  (prop + refusal _ (= ""))
  (prop + refusal-started _ (= false))
  (prop + audio-id _ (= ""))
  (prop + audio-data ([] Byte) (= ([] Byte 0)))
  (prop + audio-transcript _ (= ""))
  (prop + audio-started _ (= false))
  (prop + tools (list OpenAIToolState))
  (prop + usage AIUsage)
  (prop + finish-reason (? AIFinishReason))
  (prop + next-search-id Size)
)

(type _ OpenAIToolState
  (prop + index Index)
  (prop + part-id String)
  (prop + call-id String)
  (prop + name String)
  (prop + arguments String)
  (fn-do _ This _
    (param index _)
    (param part-id _)
    (param call-id _ (= ""))
    (param name _ (= ""))
    (param arguments _ (= ""))
  )
)

(fn-do _ openai-provider-events (stream AIEvent)
  (param provider OpenAICompletions)
  (param request AIRequest)
  (let response
    (call openai-provider-response provider request
      (block
        (on-error (: canceled TaskCancelationError)
          (throw (call AIError (. AIErrorKind cancellation) (str canceled)))
        )
        (on-error (: terminated TaskTerminationError)
          (throw (call AIError (. AIErrorKind cancellation) (str terminated)))
        )
      )
    )
  )
  (if (!= (. response status) (. HTTPStatus ok))
    (let error-body (. response text))
    (let error (call openai-response-error response error-body))
    (do
      (inline (call (. response close)))
    )
    (throw error)
  )
  (blank)
  (for (in event (call openai-response-events (call OpenAIResponseLease response)))
    (yield event)
  )
)

(fn-do _ openai-provider-response HTTPResponse (?! AIError)
  (param provider OpenAICompletions)
  (param request AIRequest)
  (let body (call openai-request-json request))
  (let endpoint (/ (. provider base-url) "chat/completions"))
  (blank)
  (throw (call AIError (. AIErrorKind unknown) (str transport-error)) (on-error (: transport-error Error)))
  (blank)
  (return (call http-send (call HTTPRequest (. HTTPMethod post) endpoint (. provider headers) body)))
)

(fn-do _ openai-path-bytes ([] Byte) (?! AIError)
  (param path String)
  (throw (call AIError (. AIErrorKind invalid-request) "Unable to read AI media path") (on-error Error))
  (blank)
  (let source (call (of File Byte) path))
  (finally
    (inline (catch (call (. source close))))
  )
  (let reader ByteReadable source)
  (let bytes ([] Byte 0))
  (while true
    (let chunk ([] Byte 4096))
    (let count (call (. reader read) (. chunk size) chunk))
    (if (== count 0)
      (break)
    )
    (let old-size (. bytes size))
    (= bytes (call (. bytes resize) (+ old-size count)))
    (= ([] bytes (... old-size)) ([] chunk (..< 0 count)))
  )
  (return bytes)
)

(fn-expr _ openai-messages-value JSON (?! AIError)
  (param messages (list AIMessage))
  (spread messages)
  (pipe *> (call openai-message-value each))
  (pipe ?> (not (call openai-says-nothing each)))
  (pipe |> List)
)

(fn-expr _ openai-says-nothing _
  (param value JSON)
  (?? blank false)
  (where
    (lazy blank
      (match? value
        (case (list (= "role" "assistant") (= "content" "") (= "tool_calls" calls))
          false
        )
        (case (list (= "role" "assistant") (= "content" "") (= "refusal" refusal))
          false
        )
        (case (list (= "role" "assistant") (= "content" ""))
          true
        )
      )
    )
  )
)

(fn-expr _ openai-strings-value (list JSON)
  (param values (list String))
  (in (as each JSON) values)
)

(fn-expr _ openai-modalities-value JSON
  (call openai-modalities-list)
)

(fn-expr _ openai-modalities-list (list JSON)
  (item "text")
  (item "audio")
)

(fn-do _ openai-message-value JSON (?! AIError)
  (param message AIMessage)
  (let role (call openai-role (. message role)))
  (let root
    (call (of Map String JSON)
      (block
        (:role role)
        (:name? (. message name))
      )
    )
  )
  (blank)
  (if (== (. message role) (. AIMessageRole user))
    (= ([] root "content") (call openai-user-content-value (. message parts)))
    (else-if (== (. message role) (. AIMessageRole tool))
      (call encode-openai-tool-result-message root (. message parts))
    )
    (else
      (call encode-openai-text-message root (. message role) (. message parts))
    )
  )
  (blank)
  (return root)
)

(fn-do _ encode-openai-text-message _ (?! AIError)
  (param root (map String JSON))
  (param role AIMessageRole)
  (param parts (list AIMessagePart))
  (let text "")
  (let refusal (? String))
  (let tool-calls (list JSON))
  (blank)
  (for (in part parts)
    (if (is part AITextPart)
      (+= text (. (as part AITextPart) text))
      (else-if (and (is part AIToolCallPart) (== role (. AIMessageRole assistant)))
        (let call (as part AIToolCallPart))
        (if (not (call openai-has-result parts (. call call-id)))
          (let encoded
            (call (of Map String JSON)
              (block
                (:id (. call call-id))
                (:type "function")
                (:function
                  (call (of Map String JSON)
                    (block
                      (:name (. call tool-name))
                      (:arguments (call to-json (. call arguments)))
                    )
                  )
                )
              )
            )
          )
          (call (. tool-calls add) encoded)
        )
      )
      (else-if (and (is part AIRefusalPart) (== role (. AIMessageRole assistant)))
        (= refusal (. (as part AIRefusalPart) text))
      )
      (else-if (is part AIExtensionPart)
        (call encode-openai-extension root part)
      )
      (else-if (and (== role (. AIMessageRole assistant)) (call openai-keeps-private part))
        (continue)
      )
      (else
        (let message (str "OpenAI cannot serialize " (type-of part) " for role " role))
        (throw (call AIError (. AIErrorKind invalid-request) message))
      )
    )
  )
  (blank)
  (= ([] root "content") text)
  (if refusal
    (= ([] root "refusal") refusal)
  )
  (if tool-calls
    (= ([] root "tool_calls") tool-calls)
  )
)

(fn-do _ encode-openai-tool-result-message _ (?! AIError)
  (param root (map String JSON))
  (param parts (list AIMessagePart))
  (let results (list AIToolResultPart)
    (block
      (in (as each AIToolResultPart) parts (when (is each AIToolResultPart)))
    )
  )
  (throw (call AIError (. AIErrorKind invalid-request) "An OpenAI tool message requires exactly one tool result") (if (or (!= (. results length) 1) (!= (. parts length) 1))))
  (blank)
  (let result ([] results 0))
  (= ([] root "tool_call_id") (. result call-id))
  (= ([] root "content") (?? (. result text-output) (call to-json (. result output))))
)

(fn-expr _ openai-user-content-value JSON (?! AIError)
  (param parts (list AIMessagePart))
  (in (call openai-user-content each) parts)
)

(fn-expr _ openai-user-content _ (?! AIError)
  (param part AIMessagePart)
  (before
    (throw (call AIError (. AIErrorKind invalid-request) "Tool results must use the tool message role") (if (is part AIToolResultPart)))
    (throw (call AIError (. AIErrorKind invalid-request) "OpenAI content extensions require provider openai") (if (and (is part AIExtensionPart) (!= (. (as part AIExtensionPart) provider-id) "openai"))))
  )
  (match part
    (case (: text AITextPart)
      (call openai-text-content text)
    )
    (case (: image AIImagePart)
      (call openai-image-content (call openai-file-url (. image image file)))
    )
    (case (: audio AIAudioPart)
      (call openai-audio-content
        (block
          (arg (call openai-file-base64 (. audio audio file)))
          (arg (call openai-audio-format (. audio audio file mime-type)))
        )
      )
    )
    (case (: file AIFilePart)
      (call openai-file-content-value (. file file))
    )
    (case (: extension AIExtensionPart)
      (. extension data)
    )
    (throw (call AIError (. AIErrorKind invalid-request) (str "Unsupported OpenAI user content: " (type-of part))))
  )
)

(fn-expr _ openai-text-content JSON
  (param text AITextPart)
  (call (of Map String JSON)
    (block
      (:type "text")
      (:text (. text text))
    )
  )
)

(fn-expr _ openai-image-content JSON
  (param url String)
  (call (of Map String JSON)
    (block
      (:type "image_url")
      (entry "image_url"
        (call (of Map String JSON)
          (block
            (:url url)
          )
        )
      )
    )
  )
)

(fn-expr _ openai-audio-content JSON
  (param data String)
  (param format String)
  (call (of Map String JSON)
    (block
      (:type "input_audio")
      (entry "input_audio"
        (call (of Map String JSON)
          (block
            (:data data)
            (:format format)
          )
        )
      )
    )
  )
)

(fn-expr _ openai-file-content-value JSON (?! AIError)
  (param file AIFile)
  (case? (is (. file source) AIProviderFileSource)
    (throw (call AIError (. AIErrorKind invalid-request) message) (if (!= (. provider-file provider-id) "openai")))
    (blank)
    (call (of Map String JSON)
      (block
        (:type "file")
        (:file
          (call (of Map String JSON)
            (block
              (entry "file_id" (. provider-file file-id))
            )
          )
        )
      )
    )
    (blank)
    (lazy provider-file (as (. file source) AIProviderFileSource))
    (lazy message (str "OpenAI cannot use a file ID owned by " (. provider-file provider-id)))
  )
  (default
    (call (of Map String JSON)
      (block
        (:type "file")
        (:file
          (call (of Map String JSON)
            (block
              (entry "file_data" (call openai-file-url file))
              (:filename? (. file filename))
            )
          )
        )
      )
    )
  )
)

(fn-do _ openai-file-base64 String (?! AIError)
  (param file AIFile)
  (if (is (. file source) AIBase64Source)
    (return (. (as (. file source) AIBase64Source) data))
  )
  (if (is (. file source) AIBytesSource)
    (return (as (. (as (. file source) AIBytesSource) data) Base64))
  )
  (if (is (. file source) AIPathSource)
    (let bytes (call openai-path-bytes (. (as (. file source) AIPathSource) path)))
    (return (as bytes Base64))
  )
  (blank)
  (throw (call AIError (. AIErrorKind invalid-request) "OpenAI audio input requires bytes, base64, or a path"))
)

(fn-expr _ openai-audio-format _ (?! AIError)
  (param mime-type String)
  (match mime-type
    (case= ai-format-wav
      "wav"
    )
    (case= ai-format-mp3
      "mp3"
    )
    (throw (call AIError (. AIErrorKind invalid-request) "OpenAI audio input requires WAV or MP3"))
  )
)

(fn-do _ encode-openai-extension _ (?! AIError)
  (param root (map String JSON))
  (param extension AIExtensionPart)
  (if (== (. extension provider-id) "openai")
    (= ([] root (. extension part-type)) (. extension data))
  )
)

(fn-expr _ openai-keeps-private _
  (param part AIMessagePart)
  (or (is part AIReasoningPart) (is part AIWebSearchPart) (is part AIToolResultPart))
)

(fn-expr _ openai-has-result _
  (param parts (list AIMessagePart))
  (param call-id String)
  (call some parts (:where (and (is each AIToolResultPart) (== (. (as each AIToolResultPart) call-id) call-id))))
)

(fn-expr _ openai-tools-value JSON
  (param tools (list AITool))
  (call openai-tool-list tools)
)

(fn-expr _ openai-tool-list (list JSON)
  (param tools (list AITool))
  (in (call openai-tool-value each) tools)
)

(fn-expr _ openai-tool-value _
  (param tool AITool)
  (call (of Map String JSON)
    (block
      (:type "function")
      (:function
        (call (of Map String JSON)
          (block
            (:name (. tool name))
            (:description (. tool description))
            (:parameters (. tool parameters))
            (:strict (. tool is-strict))
          )
        )
      )
    )
  )
)

(fn-expr _ openai-tool-choice-value _
  (param choice AIToolChoice)
  (match choice
    (case (. AIToolChoice automatic)
      (as "auto" JSON)
    )
    (case (. AIToolChoice none)
      (as "none" JSON)
    )
    (case (. AIToolChoice required)
      (as "required" JSON)
    )
    (case (: named AINamedToolChoice)
      (as (call openai-named-tool-choice-value named) JSON)
    )
  )
)

(fn-expr _ openai-named-tool-choice-value _
  (param choice AINamedToolChoice)
  (call (of Map String JSON)
    (block
      (:type "function")
      (:function
        (call (of Map String JSON)
          (block
            (:name (. choice name))
          )
        )
      )
    )
  )
)

(fn-do _ openai-web-search-value JSON
  (param options AIWebSearchOptions)
  (let root
    (call (of Map String JSON)
      (block
        (entry "search_context_size" (call openai-search-context (. options context)))
      )
    )
  )
  (if (. options provider-json)
    (call merge-openai-object root (. options provider-json) "AIWebSearchOptions.provider-json")
  )
  (return root)
)

(fn-expr _ openai-audio-output-value JSON (?! AIError)
  (param options AIAudioOptions)
  (before
    (throw (call AIError (. AIErrorKind invalid-request) "OpenAI audio output requires a voice") (if (not (. options voice))))
    (throw (call AIError (. AIErrorKind invalid-request) "OpenAI audio output requires a format") (if (not (. options format))))
  )
  (call (of Map String JSON)
    (block
      (:voice (. options voice))
      (:format (call openai-audio-format (. options format)))
    )
  )
)

(fn-expr _ openai-role _
  (param role AIMessageRole)
  (match role
    (case (. AIMessageRole developer)
      "developer"
    )
    (case (. AIMessageRole system)
      "system"
    )
    (case (. AIMessageRole user)
      "user"
    )
    (case (. AIMessageRole assistant)
      "assistant"
    )
    (case (. AIMessageRole tool)
      "tool"
    )
  )
)

(fn-do _ consume-openai-chunk (stream AIEvent)
  (param state OpenAIStreamState)
  (param value JSON)
  (throw (call AIError (. AIErrorKind invalid-response) "OpenAI stream chunk was not an object") (if (is-not value (map String JSON))))
  (blank)
  (let root (as value (map String JSON)))
  (blank)
  (let completion-id (call json-string ([] root "id")))
  (if completion-id
    (= (. state completion-id) completion-id)
  )
  (blank)
  (let maybe-usage (call json-object ([] root "usage")))
  (if maybe-usage
    (let update (call openai-usage maybe-usage))
    (= (. state usage) (call merge-openai-stream-usage (. state usage) update))
    (yield (call AIUsageEvent update))
  )
  (blank)
  (let choice (call openai-first-choice root))
  (return-if (if (not choice)))
  (blank)
  (let finish (call json-string ([] choice "finish_reason")))
  (if finish
    (= (. state finish-reason) (call openai-finish-reason finish))
  )
  (blank)
  (let delta (call json-object ([] choice "delta")))
  (return-if (if (not delta)))
  (blank)
  (let reasoning (?? (call json-string ([] delta "reasoning")) (call json-string ([] delta "reasoning_content"))))
  (if reasoning
    (if (not (. state reasoning-started))
      (= (. state reasoning-started) true)
      (yield (call AIPartBeginEvent (call AIReasoningPart (call openai-part-id state "reasoning") "")))
    )
    (+= (. state reasoning) reasoning)
    (yield (call AIPartDeltaEvent (call openai-part-id state "reasoning") (call AIReasoningDelta reasoning)))
  )
  (blank)
  (let content (call json-string ([] delta "content")))
  (if content
    (if (not (. state text-started))
      (= (. state text-started) true)
      (yield (call AIPartBeginEvent (call AITextPart (call openai-part-id state "text") "")))
    )
    (+= (. state text) content)
    (yield (call AIPartDeltaEvent (call openai-part-id state "text") (call AITextDelta content)))
  )
  (blank)
  (call read-openai-annotations state delta)
  (blank)
  (let refusal (call json-string ([] delta "refusal")))
  (if refusal
    (if (not (. state refusal-started))
      (= (. state refusal-started) true)
      (yield (call AIPartBeginEvent (call AIRefusalPart (call openai-part-id state "refusal") "")))
    )
    (+= (. state refusal) refusal)
    (yield (call AIPartDeltaEvent (call openai-part-id state "refusal") (call AITextDelta refusal)))
  )
  (blank)
  (let audio (call json-object ([] delta "audio")))
  (if audio
    (for (in ai-event (call consume-openai-audio state audio))
      (yield ai-event)
    )
  )
  (blank)
  (let tool-calls (call json-array ([] delta "tool_calls")))
  (if tool-calls
    (for (in call tool-calls)
      (for (in ai-event (call consume-openai-tool-call state call))
        (yield ai-event)
      )
    )
  )
  (blank)
  (let search (?? (call json-object ([] delta "web_search")) (call json-object ([] delta "search_activity"))))
  (if search
    (let query (call json-string ([] search "query")))
    (if query
      (let search-id (call json-string ([] search "id")))
      (let part-id (call openai-part-id state (str "search-" (. state next-search-id))))
      (+= (. state next-search-id) 1)
      (let part (call AIWebSearchPart part-id query (. AIWebSearchStatus completed) search-id))
      (yield (call AIPartBeginEvent part))
      (yield (call AIPartEndEvent part))
    )
  )
)

(fn-do _ consume-openai-audio (stream AIEvent)
  (param state OpenAIStreamState)
  (param audio (map String JSON))
  (throw (call AIError (. AIErrorKind invalid-response) "OpenAI returned invalid base64 audio") (on-error SyntaxError))
  (blank)
  (if (not (. state audio-started))
    (= (. state audio-started) true)
    (= (. state audio-id) (?? (call json-string ([] audio "id")) (call openai-part-id state "audio-output")))
    (let file (call AIFile (call AIBytesSource ([] Byte 0)) ai-format-wav))
    (yield (call AIPartBeginEvent (call AIAudioPart (call openai-part-id state "audio") (call AIAudio file))))
  )
  (blank)
  (let data (call json-string ([] audio "data")))
  (if data
    (let bytes (call decode-base64 data))
    (let combined ([] Byte (+ (. state audio-data size) (. bytes size))))
    (= ([] combined (..< 0 (. state audio-data size))) (. state audio-data))
    (= ([] combined (... (. state audio-data size))) bytes)
    (= (. state audio-data) combined)
    (yield (call AIPartDeltaEvent (call openai-part-id state "audio") (call AIAudioDelta bytes)))
  )
  (blank)
  (let transcript (call json-string ([] audio "transcript")))
  (if transcript
    (+= (. state audio-transcript) transcript)
  )
)

(fn-do _ consume-openai-tool-call (stream AIEvent)
  (param state OpenAIStreamState)
  (param value JSON)
  (throw (call AIError (. AIErrorKind invalid-response) "OpenAI tool call delta was not an object") (if (is-not value (map String JSON))))
  (blank)
  (let call (as value (map String JSON)))
  (let wire-index
    (match ([] call "index")
      (case (all (: value Int) ({} (>= it 0)))
        (as value Index)
      )
      (throw (call AIError (. AIErrorKind invalid-response) "OpenAI tool call delta omitted its index"))
    )
  )
  (blank)
  (let tool (call openai-tool-state state wire-index))
  (if (not tool)
    (let new-tool (call OpenAIToolState wire-index (call openai-part-id state (str "tool-" wire-index))))
    (+= (. state tools) new-tool)
    (= tool new-tool)
    (yield (call AIPartBeginEvent (call AIToolCallPart (. new-tool part-id) "" "" null)))
  )
  (let active-tool OpenAIToolState tool)
  (blank)
  (let call-id (call json-string ([] call "id")))
  (if call-id
    (= (. active-tool call-id) call-id)
  )
  (let function (call json-object ([] call "function")))
  (if function
    (let name (call json-string ([] function "name")))
    (if name
      (+= (. active-tool name) name)
    )
    (let arguments (call json-string ([] function "arguments")))
    (if arguments
      (+= (. active-tool arguments) arguments)
      (yield (call AIPartDeltaEvent (. active-tool part-id) (call AIToolArgumentsDelta arguments)))
    )
  )
)

(fn-do _ finish-openai-stream (stream AIEvent)
  (param state OpenAIStreamState)
  (if (. state reasoning-started)
    (yield (call AIPartEndEvent (call AIReasoningPart (call openai-part-id state "reasoning") (. state reasoning))))
  )
  (if (. state text-started)
    (yield (call AIPartEndEvent (call AITextPart (call openai-part-id state "text") (. state text) null (. state citations))))
  )
  (if (. state refusal-started)
    (yield (call AIPartEndEvent (call AIRefusalPart (call openai-part-id state "refusal") (. state refusal))))
  )
  (if (. state audio-started)
    (let file (call AIFile (call AIBytesSource (. state audio-data)) ai-format-wav))
    (let audio (call AIAudio file null (. state audio-transcript) null (. state audio-id)))
    (yield (call AIPartEndEvent (call AIAudioPart (call openai-part-id state "audio") audio)))
  )
  (for (in tool (. state tools))
    (let decoded (call parse-openai-json (. tool arguments) "OpenAI returned invalid tool arguments"))
    (yield (call AIPartEndEvent (call AIToolCallPart (. tool part-id) (. tool call-id) (. tool name) decoded)))
  )
  (blank)
  (throw (call AIError (. AIErrorKind invalid-response) "OpenAI stream ended without a finish reason") (if (not (. state finish-reason))))
  (yield (call AIDoneEvent (. state finish-reason) (. state usage)))
)

(fn-do _ read-openai-annotations _
  (param state OpenAIStreamState)
  (param delta (map String JSON))
  (let annotations (call json-array ([] delta "annotations")))
  (return-if (if (not annotations)))
  (blank)
  (for (in value annotations)
    (let annotation (call json-object value))
    (if (and annotation (== (call json-string ([] annotation "type")) "url_citation"))
      (let citation (call json-object ([] annotation "url_citation")))
      (if citation
        (let title (?? (call json-string ([] citation "title")) ""))
        (let url (?? (call json-string ([] citation "url")) ""))
        (let start (call json-index ([] citation "start_index")))
        (let end (call json-index ([] citation "end_index")))
        (let parsed-citation (call AICitation title url start end))
        (call (. state citations add) parsed-citation)
      )
    )
  )
)

(fn-expr _ openai-first-choice _
  (param root (map String JSON))
  (match? root
    (case (list (= "choices" (list (: choice (map String JSON)) ...)) ...)
      choice
    )
  )
)

(fn-do _ openai-tool-state (? OpenAIToolState)
  (param state OpenAIStreamState)
  (param index Index)
  (for (in tool (. state tools))
    (if (== (. tool index) index)
      (return tool)
    )
  )
)

(fn-expr _ openai-part-id _
  (param state OpenAIStreamState)
  (param suffix String)
  (str (. state completion-id) ":" suffix)
)

(fn-expr _ openai-usage _
  (param value (map String JSON))
  (call AIUsage
    (block
      (:input-tokens (call json-size ([] value "prompt_tokens")))
      (:output-tokens (call json-size ([] value "completion_tokens")))
      (:total-tokens (call json-size ([] value "total_tokens")))
      (:cached-input-tokens cached-input-tokens)
      (:reasoning-tokens reasoning-tokens)
    )
  )
  (where
    (lazy prompt-details (call json-object ([] value "prompt_tokens_details")))
    (lazy completion-details (call json-object ([] value "completion_tokens_details")))
    (lazy cached-input-tokens (only-if (call json-size ([] prompt-details "cached_tokens")) (if prompt-details)))
    (lazy reasoning-tokens (only-if (call json-size ([] completion-details "reasoning_tokens")) (if completion-details)))
  )
)

(fn-expr _ merge-openai-stream-usage _
  (param target AIUsage)
  (param update AIUsage)
  (call AIUsage
    (block
      (:input-tokens (?? (. update input-tokens) (. target input-tokens)))
      (:output-tokens (?? (. update output-tokens) (. target output-tokens)))
      (:total-tokens (?? (. update total-tokens) (. target total-tokens)))
      (:cached-input-tokens (?? (. update cached-input-tokens) (. target cached-input-tokens)))
      (:cache-creation-tokens (?? (. update cache-creation-tokens) (. target cache-creation-tokens)))
      (:cache-read-tokens (?? (. update cache-read-tokens) (. target cache-read-tokens)))
      (:reasoning-tokens (?? (. update reasoning-tokens) (. target reasoning-tokens)))
      (:thought-tokens (?? (. update thought-tokens) (. target thought-tokens)))
      (:tool-prompt-tokens (?? (. update tool-prompt-tokens) (. target tool-prompt-tokens)))
    )
  )
)

(fn-expr _ openai-finish-reason _
  (param reason String)
  (match reason
    (case "stop"
      (. AIFinishReason stop)
    )
    (case "length"
      (. AIFinishReason length)
    )
    (case "tool_calls"
      (. AIFinishReason tool-calls)
    )
    (case "content_filter"
      (. AIFinishReason content-filter)
    )
    (default
      (call AIProviderFinishReason "openai" reason)
    )
  )
)

(fn-expr _ openai-error-kind _
  (param status Int)
  (param decoded (? JSON))
  (case? (or (== status 401) (== status 403))
    (. AIErrorKind authentication)
  )
  (case? (== status 429)
    (. AIErrorKind rate-limit)
  )
  (case? (>= status 500)
    (. AIErrorKind server)
  )
  (case? (and decoded (call (. (str decoded) lowercased find) "context"))
    (. AIErrorKind context-length)
  )
  (default
    (. AIErrorKind invalid-request)
  )
)

(fn-expr _ json-string _
  (param value (? JSON))
  (match? value
    (case String)
  )
)

(fn-expr _ json-object _
  (param value (? JSON))
  (match? value
    (case (map String JSON))
  )
)

(fn-expr _ json-array _
  (param value (? JSON))
  (match? value
    (case (list JSON))
  )
)

(fn-expr _ json-size (? Size)
  (param value (? JSON))
  (match? value
    (case (all Int ({} (>= it 0))))
  )
)

(fn-expr _ json-index _
  (param value (? JSON))
  (call json-size value)
)
