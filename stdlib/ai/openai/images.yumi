━━━━━━━━━━━━━━━━━━━━
+ OpenAIImages is AIProvider

+ api-key String
+ base-url URL
+ partial-images Size

────────────────────
+ This
    - api-key
    - base-url = openai-api-base
    - partial-images Size = 0

super()

────────────────────
_ get headers [HTTPHeader]

* "Authorization", "Bearer $api-key"
* "Content-Type", "application/json"
* "Accept", "text/event-stream"

────────────────────
+ do stream <AIEvent>
    - request AIRequest

for event in openai-image-provider-events(this, request)
    <= event

━━━━━━━━━━━━━━━━━━━━
_ do openai-image-provider-events <AIEvent>
    - provider OpenAIImages
    - request AIRequest

. response = openai-image-provider-response(provider, request)
    catch canceled TaskCancelationError
        ?! AIError(AIErrorKind.cancellation, "$canceled")
    catch terminated TaskTerminationError
        ?! AIError(AIErrorKind.cancellation, "$terminated")
if response.status != HTTPStatus.ok
    . error-body = response.text
    . error = openai-response-error(response, error-body)
    do response.close()
    ?! error

for event in openai-image-response-events(OpenAIResponseLease(response))
    <= event

━━━━━━━━━━━━━━━━━━━━
_ do openai-image-provider-response HTTPResponse ?! AIError
    - provider OpenAIImages
    - request AIRequest

. body = to-json(openai-image-request-value(request, provider.partial-images))
. endpoint = provider.base-url / openai-image-path(request)

?! AIError(AIErrorKind.unknown, "$transport-error")
    catch transport-error Error

= http-send(HTTPRequest(HTTPMethod.post, endpoint, provider.headers, body))

━━━━━━━━━━━━━━━━━━━━
+ openai-image-path
    - request AIRequest

if openai-image-inputs(request) then "images/edits" else "images/generations"

━━━━━━━━━━━━━━━━━━━━
+ do openai-image-request-value JSON ?! AIError
    - request AIRequest
    - partial-images Size = 0

?! AIError(AIErrorKind.invalid-request, "AIRequest.model is required")
    if !request.model
?! AIError(AIErrorKind.invalid-request, "OpenAI Images does not support audio output")
    if request.audio-output
?! AIError(AIErrorKind.invalid-request, "OpenAI Images does not support video output")
    if request.video-output

. prompt = openai-image-prompt(request)
?! AIError(AIErrorKind.invalid-request, "OpenAI Images requires a prompt")
    if !prompt

. options = request.image-output ?? AIImageOptions()
. size = openai-image-size(options)
. inputs = openai-image-inputs(request)
. root = Map'String'JSON
    • model request.model
    • prompt prompt
    • stream true
    •? size size
    •? quality openai-image-quality(options.quality)

if options.format
    root["output_format"] = openai-image-format(options.format)
if options.background
    root["background"] = openai-image-background(options.background)
if partial-images
    root["partial_images"] = partial-images as Int
if inputs
    root["images"] = openai-image-references(inputs)
if request.provider-json
    merge-openai-object(root, request.provider-json, "AIRequest.provider-json")
= root

━━━━━━━━━━━━━━━━━━━━
_ openai-image-prompt String
    - request AIRequest

|? options && options.prompt
    options.prompt
|? turn
    ai-parts-text(turn.parts)
??
    ""

.. options = request.image-output
.. turn = openai-image-turn(request.messages)

━━━━━━━━━━━━━━━━━━━━
_ do openai-image-inputs [AIImage]
    - request AIRequest

. inputs [AIImage]
. options = request.image-output
if options
    if options.reference-image
        inputs += options.reference-image
    for image in options.reference-images
        inputs += image
. turn = openai-image-turn(request.messages)
if turn
    for part in turn.parts
        if part is AIImagePart
            inputs += (part as AIImagePart).image
= inputs

━━━━━━━━━━━━━━━━━━━━
_ do openai-image-turn AIMessage?
    - messages [AIMessage]

. turn AIMessage?
for message in messages
    if message.role == AIMessageRole.user
        turn = message
= turn

━━━━━━━━━━━━━━━━━━━━
_ openai-image-size String? ?! AIError
    - options AIImageOptions

|? width && height
    "${width}x$height"
?! AIError(AIErrorKind.invalid-request, "OpenAI image size requires both width and height") if width || height
??
    openai-aspect-size(options.aspect-ratio)

.. width = options.width ?? 0
.. height = options.height ?? 0

━━━━━━━━━━━━━━━━━━━━
_ openai-aspect-size String?
    - ratio AIAspectRatio

match? ratio
    | AIAspectRatio.square
        "1024x1024"
    | AIAspectRatio.portrait
        "1024x1536"
    | AIAspectRatio.landscape
        "1536x1024"

━━━━━━━━━━━━━━━━━━━━
_ openai-image-quality String?
    - quality AIQuality

match? quality
    | AIQuality.low
        "low"
    | AIQuality.medium
        "medium"
    | AIQuality.high
        "high"
    | AIQuality.extra-high
        "xhigh"
    | AIQuality.ultra
        "max"

━━━━━━━━━━━━━━━━━━━━
_ openai-image-format ?! AIError
    - mime-type String

match mime-type
    |= ai-format-png
        "png"
    |= ai-format-jpeg
        "jpeg"
    |= ai-format-webp
        "webp"
    ?! AIError(AIErrorKind.invalid-request, "OpenAI image output requires PNG, JPEG, or WebP")

━━━━━━━━━━━━━━━━━━━━
_ openai-image-background
    - background AIImageBackground

match background
    | AIImageBackground.transparent
        "transparent"
    | AIImageBackground.opaque
        "opaque"

━━━━━━━━━━━━━━━━━━━━
_ openai-image-references JSON ?! AIError
    - images [AIImage]

openai-image-reference(each) in images

━━━━━━━━━━━━━━━━━━━━
_ openai-image-reference JSON ?! AIError
    - image AIImage

|? image.file.source is AIProviderFileSource
    ?! AIError(AIErrorKind.invalid-request, message)
        if provider-file.provider-id != "openai"

    Map'String'JSON
        • "file_id" provider-file.file-id

    .. provider-file = image.file.source as AIProviderFileSource
    .. message = "OpenAI cannot use a file ID owned by ${provider-file.provider-id}"
??
    Map'String'JSON
        • "image_url" openai-file-url(image.file)

━━━━━━━━━━━━━━━━━━━━
+ do openai-image-stream-events <AIEvent>
    - body ReadableData'Byte

. state = OpenAIImageStreamState()
for event in server-sent-events(body)
    if event.data != "[DONE]"
        . decoded = parse-openai-json(event.data, "OpenAI returned invalid image stream JSON")
        for ai-event in consume-openai-image-event(state, decoded)
            <= ai-event

for final-event in finish-openai-image-stream(state)
    <= final-event

━━━━━━━━━━━━━━━━━━━━
+ do openai-image-response-events <AIEvent>
    - lease OpenAIResponseLease

do finally lease.close()
for event in openai-image-stream-events(lease.response.reader)
    <= event

━━━━━━━━━━━━━━━━━━━━
_ OpenAIImageStreamState

+ image-count Size
+ image-started = false
+ usage AIUsage

━━━━━━━━━━━━━━━━━━━━
_ do consume-openai-image-event <AIEvent>
    - state OpenAIImageStreamState
    - value JSON

?! AIError(AIErrorKind.invalid-response, "OpenAI image stream event was not an object")
    if value is not [String = JSON]
. root = value as [String = JSON]
. kind = json-string(root["type"]) ?? ""
?! openai-image-stream-error(root)
    if kind == "error"

. is-partial = kind == "image_generation.partial_image" || kind == "image_edit.partial_image"
. is-complete = kind == "image_generation.completed" || kind == "image_edit.completed"
=? if !is-partial && !is-complete

. image = openai-stream-image(root)
. part-id = "image-${state.image-count}"
if !state.image-started
    state.image-started = true
    <= AIPartBeginEvent(AIImagePart(part-id, openai-blank-image(image)))
if is-partial
    <= AIPartDeltaEvent(part-id, AIImageDelta(image))
    =

state.image-started = false
state.image-count += 1
<= AIPartEndEvent(AIImagePart(part-id, image))

. usage = json-object(root["usage"])
if usage
    state.usage = openai-image-usage(usage)
    <= AIUsageEvent(state.usage)

━━━━━━━━━━━━━━━━━━━━
_ do finish-openai-image-stream <AIEvent>
    - state OpenAIImageStreamState

?! AIError(AIErrorKind.invalid-response, "OpenAI image stream ended before its image completed")
    if state.image-started || !state.image-count

<= AIDoneEvent(AIFinishReason.stop, state.usage)

━━━━━━━━━━━━━━━━━━━━
_ openai-stream-image AIImage ?! AIError
    - root [String = JSON]

?! AIError(AIErrorKind.invalid-response, "OpenAI returned invalid base64 image data")
    catch SyntaxError
?! AIError(AIErrorKind.invalid-response, "OpenAI image event omitted its image data")
    if !data

openai-sized-image(file, json-string(root["size"]) ?? "")

.. data = json-string(root["b64_json"])
.. format = json-string(root["output_format"]) ?? "png"
.. file = AIFile(AIBytesSource(decode-base64(data)), openai-image-mime-type(format))

━━━━━━━━━━━━━━━━━━━━
_ openai-sized-image AIImage
    - file AIFile
    - size String

match size
    ~ width \num'U32 "x" height \num'U32
        AIImage(file, width, height)
    ??
        AIImage(file)

━━━━━━━━━━━━━━━━━━━━
_ openai-blank-image
    - image AIImage

AIImage(AIFile(AIBytesSource(Byte[0]), image.file.mime-type), image.width, image.height)

━━━━━━━━━━━━━━━━━━━━
_ openai-image-mime-type
    - format String

match format
    | "jpeg"
        ai-format-jpeg
    | "webp"
        ai-format-webp
    ??
        ai-format-png

━━━━━━━━━━━━━━━━━━━━
_ openai-image-usage
    - value [String = JSON]

AIUsage
    • input-tokens json-size(value["input_tokens"])
    • output-tokens json-size(value["output_tokens"])
    • total-tokens json-size(value["total_tokens"])

━━━━━━━━━━━━━━━━━━━━
_ openai-image-stream-error
    - root [String = JSON]

AIError(kind, message)

.. error = json-object(root["error"]) ?? root
.. message = json-string(error["message"]) ?? "OpenAI image generation failed"
.. code = json-string(error["code"]) ?? ""
.. is-rejected = code == "moderation_blocked" || code == "image_generation_user_error"
.. kind = if is-rejected then AIErrorKind.invalid-request else AIErrorKind.server

━━━━━━━━━━━━━━━━━━━━
_ json-string
    - value JSON?

match? value
    | String

━━━━━━━━━━━━━━━━━━━━
_ json-object
    - value JSON?

match? value
    | [String = JSON]

━━━━━━━━━━━━━━━━━━━━
_ json-size Size?
    - value JSON?

match? value
    | Int {it >= 0}
