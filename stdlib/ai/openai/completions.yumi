+ do stream <AIEvent>
    - request AIRequest

for event in openai-provider-events(this, request)
    <= event

━━━━━━━━━━━━━━━━━━━━
_ do openai-provider-events <AIEvent>
    - provider OpenAICompletions
    - request AIRequest

. response = openai-provider-response(provider, request)
    catch canceled TaskCancelationError
        ?! AIError(AIErrorKind.cancellation, "$canceled")
    catch terminated TaskTerminationError
        ?! AIError(AIErrorKind.cancellation, "$terminated")
if response.status != HTTPStatus.ok
    . error-body = response.text
    . error = openai-response-error(response, error-body)
    do response.close()
    ?! error

for event in openai-response-events(OpenAIResponseLease(response))
    <= event

━━━━━━━━━━━━━━━━━━━━
_ do openai-provider-response HTTPResponse ?! AIError
    - provider OpenAICompletions
    - request AIRequest

. body = openai-request-json(request)
. endpoint = provider.base-url / "chat/completions"

?! AIError(AIErrorKind.unknown, "$transport-error")
    catch transport-error Error

= http-send(HTTPRequest(HTTPMethod.post, endpoint, provider.headers, body))

━━━━━━━━━━━━━━━━━━━━
+ parse-openai-json JSON ?! AIError
    - text String
    - service-message String

match text
    ~ \json-text
    ?! AIError(AIErrorKind.invalid-response, service-message)

━━━━━━━━━━━━━━━━━━━━
_ do openai-path-bytes Byte[] ?! AIError
    - path String

?! AIError(AIErrorKind.invalid-request, "Unable to read AI media path")
    catch Error

. source = File'Byte(path)
do finally catch source.close()
. reader ByteReadable = source
. bytes = Byte[0]
while true
    . chunk = Byte[4096]
    . count = reader.read(chunk.size, chunk)
    if count == 0
        break
    . old-size = bytes.size
    bytes = bytes.resize(old-size + count)
    bytes[old-size ...] = chunk[0 .. < count]
= bytes

━━━━━━━━━━━━━━━━━━━━
+ OpenAIResponseLease

+ response HTTPResponse
+ close-count Size
+ is-closed Bool

────────────────────
+ This
    - response

────────────────────
+ do close

=? if is-closed

is-closed = true
close-count += 1
response.close()

━━━━━━━━━━━━━━━━━━━━
