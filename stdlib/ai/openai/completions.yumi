+ do openai-request-value JSON ?! AIError
    - request AIRequest

?! AIError(AIErrorKind.invalid-request, "AIRequest.model is required")
    if !request.model
?! AIError(AIErrorKind.invalid-request, "OpenAI Chat Completions does not support image output")
    if request.image-output
?! AIError(AIErrorKind.invalid-request, "OpenAI Chat Completions does not support video output")
    if request.video-output

. root = Map'String'JSON
    • model request.model
    • messages openai-messages-value(request.messages)
    • stream true
    • "stream_options" Map'String'JSON
        • "include_usage" true
    •? temperature request.options.temperature

if request.options.maximum-output-tokens
    root["max_completion_tokens"] = request.options.maximum-output-tokens as Int
if request.options.stop-sequences
    root["stop"] = openai-strings-value(request.options.stop-sequences)
if request.tools
    root["tools"] = openai-tools-value(request.tools)
if request.tool-choice
    root["tool_choice"] = openai-tool-choice-value(request.tool-choice)
if request.response-schema
    root["response_format"] = Map'String'JSON
        • type "json_schema"
        • "json_schema" Map'String'JSON
            • name "response"
            • strict true
            • schema request.response-schema
if request.web-search
    root["web_search_options"] = openai-web-search-value(request.web-search)
if request.audio-output
    root["modalities"] = openai-modalities-value()
    root["audio"] = openai-audio-output-value(request.audio-output!)
if request.provider-json
    merge-openai-object(root, request.provider-json, "AIRequest.provider-json")
= root

━━━━━━━━━━━━━━━━━━━━
_ openai-messages-value JSON ?! AIError
    - messages [AIMessage]

** messages
*> openai-message-value(each)
?> !openai-says-nothing(each)
|> List

━━━━━━━━━━━━━━━━━━━━
_ openai-says-nothing
    - value JSON

blank ?? false

.. blank = match? value
    | ["role" = "assistant", "content" = "", "tool_calls" = calls]
        false
    | ["role" = "assistant", "content" = "", "refusal" = refusal]
        false
    | ["role" = "assistant", "content" = ""]
        true

━━━━━━━━━━━━━━━━━━━━
_ openai-strings-value [JSON]
    - values [String]

(each as JSON) in values

