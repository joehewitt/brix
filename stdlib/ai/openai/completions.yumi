+ do openai-stream-events <AIEvent>
    - body ReadableData'Byte

. state = OpenAIStreamState()
for event in server-sent-events(body)
    if event.data == "[DONE]"
        for final-event in finish-openai-stream(state)
            <= final-event
        =

    . decoded = parse-openai-json(event.data, "OpenAI returned invalid stream JSON")
    for ai-event in consume-openai-chunk(state, decoded)
        <= ai-event

