do finally lease.close()
for event in openai-stream-events(lease.response.reader)
    <= event

━━━━━━━━━━━━━━━━━━━━
_ OpenAIStreamState

+ completion-id String = "openai"
+ text = ""
+ text-started = false
+ citations [AICitation]
+ reasoning = ""
+ reasoning-started = false
+ refusal = ""
+ refusal-started = false
+ audio-id = ""
+ audio-data Byte[] = Byte[0]
+ audio-transcript = ""
+ audio-started = false
+ tools [OpenAIToolState]
+ usage AIUsage
+ finish-reason AIFinishReason?
+ next-search-id Size

━━━━━━━━━━━━━━━━━━━━
_ OpenAIToolState

+ index Index
+ part-id String
+ call-id String
+ name String
+ arguments String

────────────────────
_ This
    - index
    - part-id
    - call-id = ""
    - name = ""
    - arguments = ""

━━━━━━━━━━━━━━━━━━━━
_ do consume-openai-chunk <AIEvent>
    - state OpenAIStreamState
    - value JSON

?! AIError(AIErrorKind.invalid-response, "OpenAI stream chunk was not an object")
    if value is not [String = JSON]
. root = value as [String = JSON]

. completion-id = json-string(root["id"])
if completion-id
    state.completion-id = completion-id

. maybe-usage = json-object(root["usage"])
if maybe-usage
    . update = openai-usage(maybe-usage)
    state.usage = merge-openai-stream-usage(state.usage, update)
    <= AIUsageEvent(update)

. choice = openai-first-choice(root)
=? if !choice
. finish = json-string(choice["finish_reason"])
if finish
    state.finish-reason = openai-finish-reason(finish)

. delta = json-object(choice["delta"])
=? if !delta

. reasoning = json-string(delta["reasoning"]) ?? json-string(delta["reasoning_content"])
if reasoning
    if !state.reasoning-started
        state.reasoning-started = true
        <= AIPartBeginEvent(AIReasoningPart(openai-part-id(state, "reasoning"), ""))
    state.reasoning += reasoning
    <= AIPartDeltaEvent(openai-part-id(state, "reasoning"), AIReasoningDelta(reasoning))

. content = json-string(delta["content"])
if content
    if !state.text-started
        state.text-started = true
        <= AIPartBeginEvent(AITextPart(openai-part-id(state, "text"), ""))
    state.text += content
    <= AIPartDeltaEvent(openai-part-id(state, "text"), AITextDelta(content))

read-openai-annotations(state, delta)

. refusal = json-string(delta["refusal"])
if refusal
    if !state.refusal-started
        state.refusal-started = true
        <= AIPartBeginEvent(AIRefusalPart(openai-part-id(state, "refusal"), ""))
    state.refusal += refusal
    <= AIPartDeltaEvent(openai-part-id(state, "refusal"), AITextDelta(refusal))

. audio = json-object(delta["audio"])
if audio
    for ai-event in consume-openai-audio(state, audio)
        <= ai-event

. tool-calls = json-array(delta["tool_calls"])
if tool-calls
    for call in tool-calls
        for ai-event in consume-openai-tool-call(state, call)
            <= ai-event

. search = json-object(delta["web_search"]) ?? json-object(delta["search_activity"])
if search
    . query = json-string(search["query"])
    if query
        . search-id = json-string(search["id"])
        . part-id = openai-part-id(state, "search-${state.next-search-id}")
        state.next-search-id += 1
        . part = AIWebSearchPart(part-id, query, AIWebSearchStatus.completed, search-id)
        <= AIPartBeginEvent(part)
        <= AIPartEndEvent(part)

━━━━━━━━━━━━━━━━━━━━
_ do consume-openai-audio <AIEvent>
    - state OpenAIStreamState
    - audio [String = JSON]

?! AIError(AIErrorKind.invalid-response, "OpenAI returned invalid base64 audio")
    catch SyntaxError

if !state.audio-started
    state.audio-started = true
    state.audio-id = json-string(audio["id"]) ?? openai-part-id(state, "audio-output")
    . file = AIFile(AIBytesSource(Byte[0]), ai-format-wav)
    <= AIPartBeginEvent(AIAudioPart(openai-part-id(state, "audio"), AIAudio(file)))

. data = json-string(audio["data"])
if data
    . bytes = decode-base64(data)
    . combined = Byte[state.audio-data.size + bytes.size]
    combined[0 .. < state.audio-data.size] = state.audio-data
    combined[state.audio-data.size ...] = bytes
    state.audio-data = combined
    <= AIPartDeltaEvent(openai-part-id(state, "audio"), AIAudioDelta(bytes))

. transcript = json-string(audio["transcript"])
if transcript
    state.audio-transcript += transcript

━━━━━━━━━━━━━━━━━━━━
_ do consume-openai-tool-call <AIEvent>
    - state OpenAIStreamState
    - value JSON

?! AIError(AIErrorKind.invalid-response, "OpenAI tool call delta was not an object")
    if value is not [String = JSON]
. call = value as [String = JSON]
. wire-index = match call["index"]
    | value Int {it >= 0}
        value as Index
    ?! AIError(AIErrorKind.invalid-response, "OpenAI tool call delta omitted its index")

. tool = openai-tool-state(state, wire-index)
if !tool
    . new-tool = OpenAIToolState(wire-index, openai-part-id(state, "tool-$wire-index"))
    state.tools += new-tool
    tool = new-tool
    <= AIPartBeginEvent(AIToolCallPart(new-tool.part-id, "", "", null))
. active-tool OpenAIToolState = tool

. call-id = json-string(call["id"])
if call-id
    active-tool.call-id = call-id
. function = json-object(call["function"])
if function
    . name = json-string(function["name"])
    if name
        active-tool.name += name
    . arguments = json-string(function["arguments"])
    if arguments
        active-tool.arguments += arguments
        <= AIPartDeltaEvent(active-tool.part-id, AIToolArgumentsDelta(arguments))

━━━━━━━━━━━━━━━━━━━━
_ do finish-openai-stream <AIEvent>
    - state OpenAIStreamState

if state.reasoning-started
    <= AIPartEndEvent(AIReasoningPart(openai-part-id(state, "reasoning"), state.reasoning))
if state.text-started
    <= AIPartEndEvent(AITextPart(openai-part-id(state, "text"), state.text, null, state.citations))
if state.refusal-started
    <= AIPartEndEvent(AIRefusalPart(openai-part-id(state, "refusal"), state.refusal))
if state.audio-started
    . file = AIFile(AIBytesSource(state.audio-data), ai-format-wav)
    . audio = AIAudio(file, null, state.audio-transcript, null, state.audio-id)
    <= AIPartEndEvent(AIAudioPart(openai-part-id(state, "audio"), audio))
for tool in state.tools
    . decoded = parse-openai-json(tool.arguments, "OpenAI returned invalid tool arguments")
    <= AIPartEndEvent(AIToolCallPart(tool.part-id, tool.call-id, tool.name, decoded))

?! AIError(AIErrorKind.invalid-response, "OpenAI stream ended without a finish reason")
    if !state.finish-reason
<= AIDoneEvent(state.finish-reason, state.usage)

━━━━━━━━━━━━━━━━━━━━
_ do read-openai-annotations
    - state OpenAIStreamState
    - delta [String = JSON]

. annotations = json-array(delta["annotations"])
=? if !annotations
for value in annotations
    . annotation = json-object(value)
    if annotation && json-string(annotation["type"]) == "url_citation"
        . citation = json-object(annotation["url_citation"])
        if citation
            . title = json-string(citation["title"]) ?? ""
            . url = json-string(citation["url"]) ?? ""
            . start = json-index(citation["start_index"])
            . end = json-index(citation["end_index"])
            . parsed-citation = AICitation(title, url, start, end)
            state.citations.add(parsed-citation)

━━━━━━━━━━━━━━━━━━━━
_ openai-first-choice
    - root [String = JSON]

match? root
    | ["choices" = [choice [String = JSON], ...], ...]
        choice

━━━━━━━━━━━━━━━━━━━━
_ do openai-tool-state OpenAIToolState?
    - state OpenAIStreamState
    - index Index

for tool in state.tools
    if tool.index == index
        = tool

━━━━━━━━━━━━━━━━━━━━
_ openai-part-id
    - state OpenAIStreamState
    - suffix String

"${state.completion-id}:$suffix"

━━━━━━━━━━━━━━━━━━━━
_ openai-usage
    - value [String = JSON]

AIUsage
    • input-tokens json-size(value["prompt_tokens"])
    • output-tokens json-size(value["completion_tokens"])
    • total-tokens json-size(value["total_tokens"])
    • cached-input-tokens cached-input-tokens
    • reasoning-tokens reasoning-tokens

.. prompt-details = json-object(value["prompt_tokens_details"])
.. completion-details = json-object(value["completion_tokens_details"])
.. cached-input-tokens = json-size(prompt-details["cached_tokens"]) if prompt-details
.. reasoning-tokens = json-size(completion-details["reasoning_tokens"]) if completion-details

━━━━━━━━━━━━━━━━━━━━
_ merge-openai-stream-usage
    - target AIUsage
    - update AIUsage

AIUsage
    • input-tokens update.input-tokens ?? target.input-tokens
    • output-tokens update.output-tokens ?? target.output-tokens
    • total-tokens update.total-tokens ?? target.total-tokens
    • cached-input-tokens update.cached-input-tokens ?? target.cached-input-tokens
    • cache-creation-tokens update.cache-creation-tokens ?? target.cache-creation-tokens
    • cache-read-tokens update.cache-read-tokens ?? target.cache-read-tokens
    • reasoning-tokens update.reasoning-tokens ?? target.reasoning-tokens
    • thought-tokens update.thought-tokens ?? target.thought-tokens
    • tool-prompt-tokens update.tool-prompt-tokens ?? target.tool-prompt-tokens

━━━━━━━━━━━━━━━━━━━━
_ openai-finish-reason
    - reason String

match reason
    | "stop"
        AIFinishReason.stop
    | "length"
        AIFinishReason.length
    | "tool_calls"
        AIFinishReason.tool-calls
    | "content_filter"
        AIFinishReason.content-filter
    ??
        AIProviderFinishReason("openai", reason)

━━━━━━━━━━━━━━━━━━━━
+ do openai-response-error
    - response HTTPResponse
    - body String

. decoded = catch? JSON(body)
. service-message = body
if decoded
    . root = json-object(decoded)
    if root
        . error = json-object(root["error"])
        if error && json-string(error["message"])
            service-message = json-string(error["message"])!

. status = response.status as Int
. kind = openai-error-kind(status, decoded)
. retryable = status == 408 || status == 409 || status == 429 || status >= 500
= AIError(kind, service-message, status, retryable, response.header("Retry-After"))

━━━━━━━━━━━━━━━━━━━━
_ openai-error-kind
    - status Int
    - decoded JSON?

|? status == 401 || status == 403
    AIErrorKind.authentication
|? status == 429
    AIErrorKind.rate-limit
|? status >= 500
    AIErrorKind.server
|? decoded && "$decoded".lowercased.find("context")
    AIErrorKind.context-length
??
    AIErrorKind.invalid-request

━━━━━━━━━━━━━━━━━━━━
_ json-string
    - value JSON?

match? value
    | String

━━━━━━━━━━━━━━━━━━━━
_ json-object
    - value JSON?

match? value
    | [String = JSON]

━━━━━━━━━━━━━━━━━━━━
_ json-array
    - value JSON?

match? value
    | [JSON]

━━━━━━━━━━━━━━━━━━━━
_ json-size Size?
    - value JSON?

match? value
    | Int {it >= 0}

━━━━━━━━━━━━━━━━━━━━
_ json-index
    - value JSON?

json-size(value)
