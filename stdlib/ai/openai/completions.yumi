_ openai-file-content-value JSON ?! AIError
    - file AIFile

|? file.source is AIProviderFileSource
    ?! AIError(AIErrorKind.invalid-request, message)
        if provider-file.provider-id != "openai"

    Map'String'JSON
        • type "file"
        • file Map'String'JSON
            • "file_id" provider-file.file-id

    .. provider-file = file.source as AIProviderFileSource
    .. message = "OpenAI cannot use a file ID owned by ${provider-file.provider-id}"
??
    Map'String'JSON
        • type "file"
        • file Map'String'JSON
            • "file_data" openai-file-url(file)
            •? filename file.filename

━━━━━━━━━━━━━━━━━━━━
+ do openai-file-url ?! AIError
    - file AIFile

if file.source is AIURLSource
    = (file.source as AIURLSource).url
if file.source is AIBase64Source
    = "data:${file.mime-type};base64,${(file.source as AIBase64Source).data}"
if file.source is AIBytesSource
    = "data:${file.mime-type};base64,${(file.source as AIBytesSource).data as Base64}"
if file.source is AIPathSource
    . bytes = openai-path-bytes((file.source as AIPathSource).path)
    = "data:${file.mime-type};base64,${bytes as Base64}"

?! AIError(AIErrorKind.invalid-request, "OpenAI cannot use a remote provider file as a media URL")

━━━━━━━━━━━━━━━━━━━━
_ do openai-file-base64 String ?! AIError
    - file AIFile

if file.source is AIBase64Source
    = (file.source as AIBase64Source).data
if file.source is AIBytesSource
    = (file.source as AIBytesSource).data as Base64
if file.source is AIPathSource
    . bytes = openai-path-bytes((file.source as AIPathSource).path)
    = bytes as Base64

?! AIError(AIErrorKind.invalid-request, "OpenAI audio input requires bytes, base64, or a path")

━━━━━━━━━━━━━━━━━━━━
_ openai-audio-format ?! AIError
    - mime-type String

match mime-type
    |= ai-format-wav
        "wav"
    |= ai-format-mp3
        "mp3"
    ?! AIError(AIErrorKind.invalid-request, "OpenAI audio input requires WAV or MP3")

━━━━━━━━━━━━━━━━━━━━
_ do encode-openai-extension ?! AIError
    - root [String = JSON]
    - extension AIExtensionPart

if extension.provider-id == "openai"
    root[extension.part-type] = extension.data

