* "audio"

━━━━━━━━━━━━━━━━━━━━
_ do openai-message-value JSON ?! AIError
    - message AIMessage

. role = openai-role(message.role)
. root = Map'String'JSON
    • role role
    •? name message.name

if message.role == AIMessageRole.user
    root["content"] = openai-user-content-value(message.parts)
else if message.role == AIMessageRole.tool
    encode-openai-tool-result-message(root, message.parts)
else
    encode-openai-text-message(root, message.role, message.parts)

= root

━━━━━━━━━━━━━━━━━━━━
_ do encode-openai-text-message ?! AIError
    - root [String = JSON]
    - role AIMessageRole
    - parts [AIMessagePart]

. text = ""
. refusal String?
. tool-calls [JSON]

for part in parts
    if part is AITextPart
        text += (part as AITextPart).text
    else if part is AIToolCallPart && role == AIMessageRole.assistant
        . call = part as AIToolCallPart
        if !openai-has-result(parts, call.call-id)
            . encoded = Map'String'JSON
                • id call.call-id
                • type "function"
                • function Map'String'JSON
                    • name call.tool-name
                    • arguments to-json(call.arguments)
            tool-calls.add(encoded)
    else if part is AIRefusalPart && role == AIMessageRole.assistant
        refusal = (part as AIRefusalPart).text
    else if part is AIExtensionPart
        encode-openai-extension(root, part)
    else if role == AIMessageRole.assistant && openai-keeps-private(part)
        continue
    else
        . message = "OpenAI cannot serialize ${type-of part} for role $role"
        ?! AIError(AIErrorKind.invalid-request, message)

root["content"] = text
if refusal
    root["refusal"] = refusal
if tool-calls
    root["tool_calls"] = tool-calls

━━━━━━━━━━━━━━━━━━━━
_ do encode-openai-tool-result-message ?! AIError
    - root [String = JSON]
    - parts [AIMessagePart]

. results [AIToolResultPart] =
    (each as AIToolResultPart) in parts when each is AIToolResultPart
?! AIError(AIErrorKind.invalid-request, "An OpenAI tool message requires exactly one tool result")
    if results.length != 1 || parts.length != 1

. result = results[0]
root["tool_call_id"] = result.call-id
root["content"] = result.text-output ?? to-json(result.output)

━━━━━━━━━━━━━━━━━━━━
_ openai-user-content-value JSON ?! AIError
    - parts [AIMessagePart]

openai-user-content(each) in parts

━━━━━━━━━━━━━━━━━━━━
_ openai-user-content ?! AIError
    - part AIMessagePart

?! AIError(AIErrorKind.invalid-request, "Tool results must use the tool message role")
    if part is AIToolResultPart
?! AIError(AIErrorKind.invalid-request, "OpenAI content extensions require provider openai")
    if part is AIExtensionPart && (part as AIExtensionPart).provider-id != "openai"

match part
    | text AITextPart
        openai-text-content(text)
    | image AIImagePart
        openai-image-content(openai-file-url(image.image.file))
    | audio AIAudioPart
        openai-audio-content
            - openai-file-base64(audio.audio.file)
            - openai-audio-format(audio.audio.file.mime-type)
    | file AIFilePart
        openai-file-content-value(file.file)
    | extension AIExtensionPart
        extension.data
    ?! AIError(AIErrorKind.invalid-request, "Unsupported OpenAI user content: ${type-of part}")

