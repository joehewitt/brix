+ openai-default-model = "gpt-6.1-sol"
+ openai-default-effort = "xhigh"

━━━━━━━━━━━━━━━━━━━━
+ OpenAIResponses is AIProvider

+ api-key String
+ base-url URL
+ reasoning-effort String?
+ reasoning-summary String?

────────────────────
+ This
    - api-key
    - base-url = openai-api-base
    - reasoning-effort String? = null
    - reasoning-summary String? = null

super()

────────────────────
_ get headers [HTTPHeader]

* "Authorization", "Bearer $api-key"
* "Content-Type", "application/json"
* "Accept", "text/event-stream"

────────────────────
+ do stream <AIEvent>
    - request AIRequest

for event in openai-responses-provider-events(this, request)
    <= event

━━━━━━━━━━━━━━━━━━━━
_ do openai-responses-provider-events <AIEvent>
    - provider OpenAIResponses
    - request AIRequest

. response = openai-responses-provider-response(provider, request)
    catch canceled TaskCancelationError
        ?! AIError(AIErrorKind.cancellation, "$canceled")
    catch terminated TaskTerminationError
        ?! AIError(AIErrorKind.cancellation, "$terminated")
if response.status != HTTPStatus.ok
    . error-body = response.text
    . error = openai-response-error(response, error-body)
    do response.close()
    ?! error

for event in openai-responses-events(OpenAIResponseLease(response))
    <= event

━━━━━━━━━━━━━━━━━━━━
_ do openai-responses-provider-response HTTPResponse ?! AIError
    - provider OpenAIResponses
    - request AIRequest

. value = openai-responses-request-value
    - request
    - provider.reasoning-effort
    - provider.reasoning-summary
. body = to-json(value)
. endpoint = provider.base-url / "responses"

?! AIError(AIErrorKind.unknown, "$transport-error")
    catch transport-error Error

= http-send(HTTPRequest(HTTPMethod.post, endpoint, provider.headers, body))

━━━━━━━━━━━━━━━━━━━━
+ do openai-responses-request-value JSON ?! AIError
    - request AIRequest
    - reasoning-effort String? = null
    - reasoning-summary String? = null

?! AIError(AIErrorKind.invalid-request, "AIRequest.model is required")
    if !request.model
?! AIError(AIErrorKind.invalid-request, "OpenAI Responses does not support image output")
    if request.image-output
?! AIError(AIErrorKind.invalid-request, "OpenAI Responses does not support audio output")
    if request.audio-output
?! AIError(AIErrorKind.invalid-request, "OpenAI Responses does not support video output")
    if request.video-output
?! AIError(AIErrorKind.invalid-request, "OpenAI Responses does not support stop sequences")
    if request.options.stop-sequences

. root = Map'String'JSON
    • model request.model
    • input responses-input-value(request.messages)
    • stream true
    • store false
    • include responses-include-list()
    •? temperature request.options.temperature

if request.options.maximum-output-tokens
    root["max_output_tokens"] = request.options.maximum-output-tokens as Int
if reasoning-effort || reasoning-summary
    root["reasoning"] = Map'String'JSON
        •? effort reasoning-effort
        •? summary reasoning-summary
if request.tools || request.web-search
    root["tools"] = responses-tools-value(request.tools, request.web-search)
if request.tool-choice
    root["tool_choice"] = responses-tool-choice-value(request.tool-choice)
if request.response-schema
    root["text"] = Map'String'JSON
        • format Map'String'JSON
            • type "json_schema"
            • name "response"
            • strict true
            • schema request.response-schema
if request.provider-json
    merge-openai-object(root, request.provider-json, "AIRequest.provider-json")
= root

━━━━━━━━━━━━━━━━━━━━
_ responses-include-list [JSON]

* "reasoning.encrypted_content"

━━━━━━━━━━━━━━━━━━━━
_ do responses-input-value JSON ?! AIError
    - messages [AIMessage]

. items [JSON]
for message in messages
    add-responses-message(items, message)
= items

━━━━━━━━━━━━━━━━━━━━
_ do add-responses-message ?! AIError
    - items [JSON]
    - message AIMessage

if message.role == AIMessageRole.user
    items += Map'String'JSON
        • role "user"
        • content responses-user-content-value(message.parts)
else if message.role == AIMessageRole.assistant
    add-responses-reply(items, message.parts)
else if message.role == AIMessageRole.tool
    for part in message.parts
        items += responses-tool-result-value(part)
else
    items += Map'String'JSON
        • role responses-role(message.role)
        • content ai-parts-text(message.parts)

━━━━━━━━━━━━━━━━━━━━
_ responses-role
    - role AIMessageRole

match role
    | AIMessageRole.developer
        "developer"
    ??
        "system"

━━━━━━━━━━━━━━━━━━━━
_ responses-user-content-value JSON ?! AIError
    - parts [AIMessagePart]

responses-user-content(each) in parts

━━━━━━━━━━━━━━━━━━━━
_ responses-user-content JSON ?! AIError
    - part AIMessagePart

match part
    | text AITextPart
        responses-text-content(text.text)
    | image AIImagePart
        responses-image-content(image.image.file)
    | file AIFilePart
        responses-file-content(file.file)
    | extension AIExtensionPart {it.provider-id == "openai"}
        extension.data
    ?! AIError(AIErrorKind.invalid-request, "OpenAI Responses cannot send ${type-of part} from the user")

━━━━━━━━━━━━━━━━━━━━
_ responses-text-content JSON
    - text String

Map'String'JSON
    • type "input_text"
    • text text

━━━━━━━━━━━━━━━━━━━━
_ do responses-image-content JSON ?! AIError
    - file AIFile

. file-id = responses-file-id(file)
. content = Map'String'JSON
    • type "input_image"
    • detail "auto"
if file-id
    content["file_id"] = file-id
else
    content["image_url"] = openai-file-url(file)
= content

━━━━━━━━━━━━━━━━━━━━
_ do responses-file-content JSON ?! AIError
    - file AIFile

. file-id = responses-file-id(file)
. content = Map'String'JSON
    • type "input_file"
    •? filename file.filename
if file-id
    content["file_id"] = file-id
else if file.source is AIURLSource
    content["file_url"] = (file.source as AIURLSource).url
else
    content["file_data"] = openai-file-url(file)
= content

━━━━━━━━━━━━━━━━━━━━
_ responses-file-id String? ?! AIError
    - file AIFile

|? file.source is not AIProviderFileSource
    null
?! AIError(AIErrorKind.invalid-request, "OpenAI cannot use a file ID owned by ${provider-file.provider-id}") if provider-file.provider-id != "openai"
??
    provider-file.file-id

.. provider-file = file.source as AIProviderFileSource

━━━━━━━━━━━━━━━━━━━━
_ do add-responses-reply ?! AIError
    - items [JSON]
    - parts [AIMessagePart]

. run-id String?
. run [JSON]
for part in parts
    . source-id = (part as AITextPart).source-id if part is AITextPart
    if run-id && source-id != run-id
        items += responses-output-message(run-id, run)
        run = List'JSON()
        run-id = null
    if source-id
        run-id = source-id
        run += responses-output-text((part as AITextPart).text)
    else
        add-responses-reply-item(items, part)
if run-id
    items += responses-output-message(run-id, run)

━━━━━━━━━━━━━━━━━━━━
_ do add-responses-reply-item ?! AIError
    - items [JSON]
    - part AIMessagePart

match part
    | text AITextPart
        if text.text
            items += responses-said(text.text)
    | refusal AIRefusalPart
        items += responses-said(refusal.text)
    | reasoning AIReasoningPart
        . item = json-object(reasoning.provider-signature)
        if item && json-string(item["type"]) == "reasoning"
            items += item
    | call AIToolCallPart
        items += Map'String'JSON
            • type "function_call"
            • "call_id" call.call-id
            • name call.tool-name
            • arguments to-json(call.arguments)
            •? id json-string(call.provider-signature)
    | result AIToolResultPart
        items += responses-tool-result-value(result)
    | search AIWebSearchPart
        if search.search-id
            items += responses-search-call(search)
    | extension AIExtensionPart
        if extension.provider-id == "openai"
            items += extension.data
    ?! AIError(AIErrorKind.invalid-request, "OpenAI Responses cannot send ${type-of part} from the assistant")

━━━━━━━━━━━━━━━━━━━━
_ responses-said
    - text String

Map'String'JSON
    • role "assistant"
    • content text

━━━━━━━━━━━━━━━━━━━━
_ responses-output-message
    - id String
    - content [JSON]

Map'String'JSON
    • type "message"
    • id id
    • role "assistant"
    • status "completed"
    • content content

━━━━━━━━━━━━━━━━━━━━
_ responses-output-text JSON
    - text String

Map'String'JSON
    • type "output_text"
    • text text
    • annotations List'JSON()

━━━━━━━━━━━━━━━━━━━━
_ responses-search-call
    - search AIWebSearchPart

Map'String'JSON
    • type "web_search_call"
    •? id search.search-id
    • status "completed"
    • action Map'String'JSON
        • type "search"
        • query search.query

━━━━━━━━━━━━━━━━━━━━
_ responses-tool-result-value JSON ?! AIError
    - part AIMessagePart

match part
    | result AIToolResultPart
        Map'String'JSON
            • type "function_call_output"
            • "call_id" result.call-id
            • output result.text-output ?? to-json(result.output)
    ?! AIError(AIErrorKind.invalid-request, "An OpenAI tool message can only hold tool results")

━━━━━━━━━━━━━━━━━━━━
_ do responses-tools-value JSON ?! AIError
    - tools [AITool]
    - search AIWebSearchOptions?

. values [JSON]
for tool in tools
    values += Map'String'JSON
        • type "function"
        • name tool.name
        • description tool.description
        • parameters tool.parameters
        • strict tool.is-strict
if search
    . web = Map'String'JSON
        • type "web_search"
        • "search_context_size" openai-search-context(search.context)
    if search.provider-json
        merge-openai-object(web, search.provider-json, "AIWebSearchOptions.provider-json")
    values += web
= values

━━━━━━━━━━━━━━━━━━━━
_ responses-tool-choice-value
    - choice AIToolChoice

match choice
    | AIToolChoice.automatic
        "auto" as JSON
    | AIToolChoice.none
        "none" as JSON
    | AIToolChoice.required
        "required" as JSON
    | named AINamedToolChoice
        responses-named-tool-choice(named) as JSON

━━━━━━━━━━━━━━━━━━━━
_ responses-named-tool-choice
    - choice AINamedToolChoice

Map'String'JSON
    • type "function"
    • name choice.name

━━━━━━━━━━━━━━━━━━━━
+ do openai-responses-stream-events <AIEvent>
    - body ReadableData'Byte

. state = OpenAIResponsesState()
for event in server-sent-events(body)
    if event.data != "[DONE]"
        . decoded = parse-openai-json(event.data, "OpenAI returned invalid response stream JSON")
        for ai-event in consume-responses-event(state, decoded)
            <= ai-event

?! AIError(AIErrorKind.invalid-response, "OpenAI response stream ended before the response completed")
    if !state.is-done

━━━━━━━━━━━━━━━━━━━━
+ do openai-responses-events <AIEvent>
    - lease OpenAIResponseLease

do finally lease.close()
for event in openai-responses-stream-events(lease.response.reader)
    <= event

━━━━━━━━━━━━━━━━━━━━
_ OpenAIResponsesState

+ has-calls = false
+ is-done = false

━━━━━━━━━━━━━━━━━━━━
_ do consume-responses-event <AIEvent>
    - state OpenAIResponsesState
    - value JSON

?! AIError(AIErrorKind.invalid-response, "OpenAI response stream event was not an object")
    if value is not [String = JSON]
. root = value as [String = JSON]
. kind = json-string(root["type"]) ?? ""
. item-id = json-string(root["item_id"]) ?? ""
. content-id = "$item-id:${json-size(root["content_index"]) ?? 0}"
. delta = json-string(root["delta"]) ?? ""

match kind
    | "response.output_item.added"
        . item = json-object(root["item"])
        . begun = responses-begun-part(item) if item
        if begun
            <= AIPartBeginEvent(begun)
    | "response.content_part.added"
        . part = json-object(root["part"]) ?? Map'String'JSON()
        . part-kind = json-string(part["type"])
        if part-kind == "output_text"
            <= AIPartBeginEvent(AITextPart(content-id, "", item-id))
        else if part-kind == "refusal"
            <= AIPartBeginEvent(AIRefusalPart(content-id, ""))
    | "response.output_text.delta"
        if delta
            <= AIPartDeltaEvent(content-id, AITextDelta(delta))
    | "response.refusal.delta"
        if delta
            <= AIPartDeltaEvent(content-id, AITextDelta(delta))
    | "response.reasoning_summary_part.added"
        if json-size(root["summary_index"]) ?? 0
            <= AIPartDeltaEvent(item-id, AIReasoningDelta("\n\n"))
    | "response.reasoning_summary_text.delta"
        if delta
            <= AIPartDeltaEvent(item-id, AIReasoningDelta(delta))
    | "response.function_call_arguments.delta"
        if delta
            <= AIPartDeltaEvent(item-id, AIToolArgumentsDelta(delta))
    | "response.output_item.done"
        . item = json-object(root["item"])
        if item
            for part in responses-ended-parts(state, item)
                <= AIPartEndEvent(part)
    | "response.completed"
        state.is-done = true
        <= responses-done(state, root)
    | "response.incomplete"
        state.is-done = true
        <= responses-done(state, root)
    | "response.failed"
        . response = json-object(root["response"]) ?? Map'String'JSON()
        ?! responses-error(json-object(response["error"]) ?? Map'String'JSON())
    | "error"
        ?! responses-error(root)
    ??
        =

━━━━━━━━━━━━━━━━━━━━
_ responses-begun-part AIMessagePart?
    - item [String = JSON]

match? json-string(item["type"])
    | "reasoning"
        AIReasoningPart(id, "")
    | "function_call"
        AIToolCallPart
            - id
            - json-string(item["call_id"]) ?? ""
            - json-string(item["name"]) ?? ""
            - null
    | "web_search_call"
        AIWebSearchPart(id, "", AIWebSearchStatus.searching, id)

.. id = json-string(item["id"]) ?? ""

━━━━━━━━━━━━━━━━━━━━
_ do responses-ended-parts <AIMessagePart> ?! AIError
    - state OpenAIResponsesState
    - item [String = JSON]

. id = json-string(item["id"]) ?? ""
. kind = json-string(item["type"]) ?? ""
if kind == "message"
    . content = json-array(item["content"]) ?? List'JSON()
    for index in 0 .. < content.length
        . entry = json-object(content[index]) ?? Map'String'JSON()
        . entry-kind = json-string(entry["type"])
        if entry-kind == "output_text"
            . text = json-string(entry["text"]) ?? ""
            <= AITextPart("$id:$index", text, id, responses-citations(entry["annotations"]))
        else if entry-kind == "refusal"
            <= AIRefusalPart("$id:$index", json-string(entry["refusal"]) ?? "")
else if kind == "reasoning"
    <= AIReasoningPart(id, responses-summary-text(item), null, item)
else if kind == "function_call"
    state.has-calls = true
    . text = json-string(item["arguments"]) ?? ""
    . arguments = parse-openai-json(text, "OpenAI returned invalid tool arguments")
    . call-id = json-string(item["call_id"]) ?? ""
    . name = json-string(item["name"]) ?? ""
    <= AIToolCallPart(id, call-id, name, arguments, id as JSON)
else if kind == "web_search_call"
    . action = json-object(item["action"]) ?? Map'String'JSON()
    . query = json-string(action["query"]) ?? ""
    . failed = json-string(item["status"]) == "failed"
    . status = if failed then AIWebSearchStatus.failed else AIWebSearchStatus.completed
    <= AIWebSearchPart(id, query, status, id)

━━━━━━━━━━━━━━━━━━━━
_ do responses-summary-text String
    - item [String = JSON]

. texts = List'String()
for value in json-array(item["summary"]) ?? List'JSON()
    . text = json-string((json-object(value) ?? Map'String'JSON())["text"])
    if text
        texts += text
= "\n\n".join(texts)

━━━━━━━━━━━━━━━━━━━━
_ do responses-citations [AICitation]
    - value JSON?

. citations = List'AICitation()
for entry in json-array(value) ?? List'JSON()
    . annotation = json-object(entry) ?? Map'String'JSON()
    if json-string(annotation["type"]) == "url_citation"
        . title = json-string(annotation["title"]) ?? ""
        . url = json-string(annotation["url"]) ?? ""
        . start = json-size(annotation["start_index"])
        . end = json-size(annotation["end_index"])
        citations += AICitation(title, url, start, end)
= citations

━━━━━━━━━━━━━━━━━━━━
_ responses-done AIDoneEvent ?! AIError
    - state OpenAIResponsesState
    - root [String = JSON]

?! AIError(AIErrorKind.invalid-response, "OpenAI response event omitted its response")
    if !response

AIDoneEvent(responses-finish-reason(state.has-calls, json-string(details["reason"])), usage)

.. response = json-object(root["response"])
.. usage-value = json-object(response["usage"])
.. usage = if usage-value then responses-usage(usage-value) else AIUsage()
.. details = json-object(response["incomplete_details"]) ?? Map'String'JSON()

━━━━━━━━━━━━━━━━━━━━
_ responses-finish-reason AIFinishReason
    - has-calls Bool
    - reason String?

|? reason == "max_output_tokens"
    AIFinishReason.length
|? reason == "content_filter"
    AIFinishReason.content-filter
|? reason
    AIProviderFinishReason("openai", reason)
|? has-calls
    AIFinishReason.tool-calls
??
    AIFinishReason.stop

━━━━━━━━━━━━━━━━━━━━
_ responses-usage
    - value [String = JSON]

AIUsage
    • input-tokens json-size(value["input_tokens"])
    • output-tokens json-size(value["output_tokens"])
    • total-tokens json-size(value["total_tokens"])
    • cached-input-tokens cached-input-tokens
    • reasoning-tokens reasoning-tokens

.. input-details = json-object(value["input_tokens_details"])
.. output-details = json-object(value["output_tokens_details"])
.. cached-input-tokens = json-size(input-details["cached_tokens"]) if input-details
.. reasoning-tokens = json-size(output-details["reasoning_tokens"]) if output-details

━━━━━━━━━━━━━━━━━━━━
_ responses-error
    - error [String = JSON]

AIError(kind, message, null, kind == AIErrorKind.rate-limit || kind == AIErrorKind.server)

.. message = json-string(error["message"]) ?? "OpenAI could not complete the response"
.. kind = match json-string(error["code"]) ?? ""
    | "rate_limit_exceeded"
        AIErrorKind.rate-limit
    | "server_error"
        AIErrorKind.server
    | "context_length_exceeded"
        AIErrorKind.context-length
    ??
        AIErrorKind.invalid-request

━━━━━━━━━━━━━━━━━━━━
_ json-string
    - value JSON?

match? value
    | String

━━━━━━━━━━━━━━━━━━━━
_ json-object
    - value JSON?

match? value
    | [String = JSON]

━━━━━━━━━━━━━━━━━━━━
_ json-array
    - value JSON?

match? value
    | [JSON]

━━━━━━━━━━━━━━━━━━━━
_ json-size Size?
    - value JSON?

match? value
    | Int {it >= 0}
