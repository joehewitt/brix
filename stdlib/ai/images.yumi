./media
./model
./tasks
/os/file
/os/path

+ ai-image-tool-name = "generate_image"
+ ai-full-size-tool-name = "full_size_image"
+ ai-view-tool-name = "view_image"
+ ai-reply-argument = "reply"
_ ai-image-owner = "chat-images"

━━━━━━━━━━━━━━━━━━━━
+ AIImageStore

+ directory Path

_ last-number Size

────────────────────
+ This
    - directory

────────────────────
+ id String?
    - image AIImage

match? image.file.source
    | stored AIProviderFileSource {it.provider-id == ai-image-owner}
        stored.file-id
    | kept AIPathSource
        ai-kept-image-id(directory, Path(kept.path, 0))

────────────────────
+ referenced AIImage
    - image AIImage

if found then AIImage(AIFile(AIProviderFileSource(ai-image-owner, found), image.file.mime-type), image.width, image.height, image.source-id) else image

.. found = id(image)

────────────────────
+ do located AIImage
    - image AIImage

. found = id(image)
. file = path(found) if found
=? image if !file
= AIImage
    - AIFile(AIPathSource("$file"), image.file.mime-type)
    - image.width
    - image.height
    - image.source-id

────────────────────
+ do is-gone Bool
    - image AIImage

. found = id(image)
= found != null && path(found) == null

────────────────────
+ do path Path?
    - id String

=? null if !ai-is-image-id(id)
for extension in ["png", "jpg", "webp", "gif"]
    . candidate = directory / "$id.$extension"
    =? candidate if candidate.exists
= null

────────────────────
+ do input AIImage ?! AIError
    - id String

. found = path(id)
?! AIError(AIErrorKind.invalid-request, "There is no image with ID $id")
    if !found
= AIImage(AIFile(AIPathSource("$found"), ai-image-format(found.ext)))

────────────────────
+ do save AIImage ?! Error
    - image AIImage

. id = store(image)
. reference = AIFile(AIProviderFileSource(ai-image-owner, id), image.file.mime-type)
= AIImage(reference, image.width, image.height)

────────────────────
+ do attach AIImage ?! Error
    - image AIImage

. id = store(image)
. file = AIFile(AIPathSource("${path(id)!}"), image.file.mime-type)
= AIImage(file, image.width, image.height)

────────────────────
+ do adopt String? ?! Error
    - file Path

. id = file.base-name
=? null if !ai-is-image-id(id)
. chosen = if path(id) == null then id else next-id()
directory.make-directories()
file.copy(directory / "$chosen.${file.extension}")
= chosen

────────────────────
_ do store String ?! Error
    - image AIImage

. source = image.file.source
?! Error("An image has no bytes to save")
    if source is not AIBytesSource
. bytes = (source as AIBytesSource).data
directory.make-directories()
. id = next-id()
. target = directory / "$id.${ai-image-extension(image.file.mime-type)}"
. file = File(target, FileFlags.write-mode + FileFlags.create-mode + FileFlags.exclusive-mode)
do use file
    file.write(bytes, bytes.size)
= id

────────────────────
_ do next-id String

last-number += 1
while path("img-$last-number")
    last-number += 1
= "img-$last-number"

━━━━━━━━━━━━━━━━━━━━
+ ai-call-reply String?
    - call AIToolCallPart

reply if reply

.. reply = ai-argument(call.arguments, ai-reply-argument)?.trim()

━━━━━━━━━━━━━━━━━━━━
+ ai-is-image-call
    - call AIToolCallPart

call.tool-name == ai-image-tool-name || call.tool-name == ai-full-size-tool-name

━━━━━━━━━━━━━━━━━━━━
_ ai-kept-image-id String?
    - directory Path
    - file Path

file.base-name if file.parent == directory && ai-is-image-id(file.base-name)

━━━━━━━━━━━━━━━━━━━━
_ ai-is-image-id
    - id String

match id
    ~ "img-" [0-9a-f]+ !.
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
_ ai-image-extension
    - mime-type String

match mime-type
    |= ai-format-jpeg
        "jpg"
    |= ai-format-webp
        "webp"
    |= ai-format-gif
        "gif"
    ??
        "png"

━━━━━━━━━━━━━━━━━━━━
_ ai-image-format
    - extension String

match extension
    | "jpg"
        ai-format-jpeg
    | "webp"
        ai-format-webp
    | "gif"
        ai-format-gif
    ??
        ai-format-png
