(prop _ ai-tool-output-limit Size (= 16384))

(type + AIToolTaskStatus (is Union)
  (variant running)
  (variant completed)
  (variant failed)
  (variant stopped)
)

(type + AIToolTask
  (prop + id String)
  (prop + call-id (? String))
  (prop + kind String)
  (prop + title String)
  (prop + is-backgrounded Bool)
  (prop + status _ (= (. AIToolTaskStatus running)))
  (prop + summary (? String))
  (prop + output (? String))
  (fn-do + This _
    (param id _)
    (param call-id (? String))
    (param kind String)
    (param title String)
    (param is-backgrounded Bool)
  )
  (fn-expr + is-running _ :get
    (== status (. AIToolTaskStatus running))
  )
  (fn-expr + is-working-behind _ :get
    (and is-running is-backgrounded)
  )
  (fn-do + show-output _
    (param text String)
    (= output
      (scope (if-expr (> (. text size) ai-tool-output-limit) tail text)
        (lazy tail ([] text (..< (- (. text size) ai-tool-output-limit) (. text size))))
      )
    )
  )
)

(type + AIToolTasks
  (prop + revision U64)
  (blank)
  (prop _ tasks _ (= (call (of Map String AIToolTask))))
  (prop _ calls _ (= (call (of Map String AIToolTask))))
  (fn-expr + task (? AIToolTask)
    (param id String)
    ([] tasks id)
  )
  (fn-expr + for-call (? AIToolTask)
    (param call-id String)
    ([] calls call-id)
  )
  (fn-do + add _
    (param task AIToolTask)
    (= ([] tasks (. task id)) task)
    (if (. task call-id)
      (= ([] calls (. task call-id)) task)
    )
    (+= revision 1)
  )
  (fn-do + settle _
    (param id String)
    (param status AIToolTaskStatus)
    (param summary (? String) (= null))
    (let task ([] tasks id))
    (return-if (if (or (not task) (!= (. task status) (. AIToolTaskStatus running)))))
    (blank)
    (= (. task status) status)
    (if summary
      (= (. task summary) summary)
    )
    (+= revision 1)
  )
  (fn-do + note _
    (param id String)
    (param summary (? String))
    (param is-backgrounded (? Bool))
    (let task ([] tasks id))
    (return-if (if (not task)))
    (blank)
    (if summary
      (= (. task summary) summary)
    )
    (if (!= is-backgrounded null)
      (= (. task is-backgrounded) is-backgrounded)
    )
    (+= revision 1)
  )
  (fn-expr + working-behind (list AIToolTask)
    (param call-ids (map String Bool))
    (case-each (in (tuple id task) calls (when (and (. task is-working-behind) (has call-ids id))))
      task
    )
  )
)

(fn-expr + ai-tool-task (? AIToolTask)
  (param revision U64)
  (param tasks AIToolTasks)
  (param call-id String)
  (call (. tasks for-call) call-id)
)
