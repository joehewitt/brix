./model
/data/json

+ ai-question-tool-name = "ask_next_step"
_ ai-question-choice-limit Size = 2
_ ai-question-shown = "The question will appear under your reply. Now write your closing message: your full answer, without mentioning the question or its choices."

━━━━━━━━━━━━━━━━━━━━
+ AIQuestionChoice is Tuple

+ label String
+ detail String?

━━━━━━━━━━━━━━━━━━━━
