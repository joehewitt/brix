(import /ai/media)
(import /ai/model)
(import /core/channel)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/image)
(import /graphics/primitives)
(import /math)
(blank)
(prop + ai-sheet-guide _ (= (call RGBA "#9dbcf2")))
(blank)
(prop _ ai-sheet-margin _ (= 32.0))
(prop _ ai-sheet-gutter _ (= 24.0))
(prop _ ai-sheet-crop-inset _ (= 6.0))
(prop _ ai-sheet-close _ (= 1.01))
(prop _ ai-sheet-ring Index (= 10))
(prop _ ai-sheet-guide-band Index (= 16))
(prop _ ai-sheet-veil-margin _ (= 0.05))
(prop _ ai-sheet-canvases _ (= (list (call AISheetCanvas 1024 1024) (call AISheetCanvas 1536 1024) (call AISheetCanvas 1024 1536))))
(blank)
(type-line _ AISheetCanvas (is (tuple (: width F64) (: height F64))))
(type-line _ AIIndexedPainted (is (tuple (: index Index) (: painted AIPainted))))

(type + AISheet (is Tuple)
  (prop + width F64)
  (prop + height F64)
  (prop + columns Size)
  (prop + rows Size)
  (prop + count Size)
  (prop + cell-width F64)
  (prop + cell-height F64)
  (prop + padding F64 (= 0))
  (fn-expr + aspect-ratio AIAspectRatio :get
    (case? (> width height)
      (. AIAspectRatio landscape)
    )
    (case? (< width height)
      (. AIAspectRatio portrait)
    )
    (default
      (. AIAspectRatio square)
    )
  )
  (fn-expr + grid-name String :get
    (str columns "×" rows " grid")
  )
  (fn-expr + cell Rect
    (param index Index)
    (call Rect
      (block
        (arg (+ left (* column (+ cell-width ai-sheet-gutter))))
        (arg (+ top (* row (+ cell-height ai-sheet-gutter))))
        (arg cell-width)
        (arg cell-height)
      )
    )
    (where
      (lazy column (as (% index columns) F64))
      (lazy row (as (/ index columns) F64))
      (lazy left (/ (- width (* (as columns F64) cell-width) (* (as (- columns 1) F64) ai-sheet-gutter)) 2))
      (lazy top (/ (- height (* (as rows F64) cell-height) (* (as (- rows 1) F64) ai-sheet-gutter)) 2))
    )
  )
  (fn-expr + live Rect
    (param index Index)
    (call (. (call cell index) pad) (* (call min cell-width cell-height) padding))
  )
  (fn-expr + crop Rect
    (param index Index)
    (call Rect
      (block
        (arg left)
        (arg top)
        (arg (- (call floor (- (+ (. box x) (. box width)) ai-sheet-crop-inset)) left))
        (arg (- (call floor (- (+ (. box y) (. box height)) ai-sheet-crop-inset)) top))
      )
    )
    (where
      (lazy box (call cell index))
      (lazy left (call ceil (+ (. box x) ai-sheet-crop-inset)))
      (lazy top (call ceil (+ (. box y) ai-sheet-crop-inset)))
    )
  )
  (fn-expr + cell-name String
    (param index Index)
    (str "row " (+ (/ index columns) 1) ", column " (+ (% index columns) 1))
  )
)

(type + AIPainted (is Tuple)
  (prop + image (? AIImage))
  (prop + failure (? String))
)

(fn-do + ai-sheet AISheet
  (param count Size)
  (param aspect F64 (= 1))
  (param padding F64 (= 0))
  (let best (? AISheet) null)
  (for (in canvas ai-sheet-canvases)
    (for (in columns (.. 1 (call max count 1)))
      (let made (call ai-sheet-fit canvas columns (call max count 1) aspect padding))
      (if (or (not best) (call ai-sheet-beats made best))
        (= best made)
      )
    )
  )
  (return (!! best))
)

(fn-expr + ai-shape-aspect F64
  (param ratio AIAspectRatio)
  (match ratio
    (case (. AIAspectRatio landscape)
      1.5
    )
    (case (. AIAspectRatio portrait)
      (/ 2.0 3.0)
    )
    (default
      1.0
    )
  )
)

(fn-do + ai-sheet-template AIImage (?! Error)
  (param sheet AISheet)
  (param cells (map Index Image) (= (call (of Map Index Image))))
  (param is-clear _ (= false))
  (let canvas (use (call RasterCanvas (as (. sheet width) I32) (as (. sheet height) I32))))
  (= (. canvas stroke-color) null)
  (if (not is-clear)
    (= (. canvas fill-color) (call RGBA 1 1 1))
    (call (. canvas rect) (call Rect 0 0 (. sheet width) (. sheet height)))
  )
  (= (. canvas fill-color) null)
  (= (. canvas stroke-color) ai-sheet-guide)
  (for (in index (..< 0 (. sheet count)))
    (= (. canvas stroke-width) 3)
    (= (. canvas stroke-dash) 0)
    (call (. canvas rect) (call (. (call (. sheet cell) index) pad) 1.5))
    (if (> (. sheet padding) 0)
      (= (. canvas stroke-width) 2)
      (= (. canvas stroke-dash) 10)
      (call (. canvas rect) (call (. sheet live) index))
    )
  )
  (for (in (tuple index image) cells)
    (call (. image draw) canvas (call ai-sheet-fitted (. image size) (call (. sheet crop) index)))
  )
  (let bytes (call (. canvas encode-png)))
  (return (call AIImage (call AIFile (call AIBytesSource bytes) ai-format-png) (as (. sheet width) Size) (as (. sheet height) Size)))
)

(fn-do + ai-sheet-crop RasterCanvas
  (param sheet AISheet)
  (param painted Image)
  (param index Index)
  (let crop (call (. sheet crop) index))
  (let canvas (call RasterCanvas (as (. crop width) I32) (as (. crop height) I32)))
  (call (. painted draw) canvas (call Rect (- (. crop x)) (- (. crop y)) (. sheet width) (. sheet height)))
  (return canvas)
)

(fn-do + ai-sheet-slices (list AIImage) (?! Error)
  (param sheet AISheet)
  (param painted Image)
  (param is-clear _ (= false))
  (let slices (call (of List AIImage)))
  (for (in index (..< 0 (. sheet count)))
    (let canvas (use (call ai-sheet-crop sheet painted index)))
    (if is-clear
      (call ai-sheet-clean canvas)
    )
    (let bytes (call (. canvas encode-png)))
    (let crop (call (. sheet crop) index))
    (+= slices
      (call AIImage
        (block
          (arg (call AIFile (call AIBytesSource bytes) ai-format-png))
          (arg (as (. crop width) Size))
          (arg (as (. crop height) Size))
        )
      )
    )
  )
  (return slices)
)

(fn-do + ai-sheet-clean _
  (param canvas RasterCanvas)
  (let width (as (. canvas pixel-width) Index))
  (let height (as (. canvas pixel-height) Index))
  (let bytes (call (. canvas premultiplied-pixels)))
  (let counts (call (of List Size) (in (as 0 Size) (..< 0 256))))
  (let ring Size 0)
  (for (in y (..< 0 height))
    (for (in x (..< 0 width))
      (if (call ai-sheet-near x y width height ai-sheet-ring)
        (+= ([] counts ([] bytes (+ (* (+ (* y width) x) 4) 3))) 1)
        (+= ring 1)
      )
    )
  )
  (return-if (if (== ring 0)))
  (let median (call ai-sheet-quantile counts ring 0.5))
  (let veil
    (scope (if-expr (< median 0.5) (call min 0.9 (+ upper-quantile ai-sheet-veil-margin)) 0.0)
      (lazy upper-quantile (call ai-sheet-quantile counts ring 0.9))
    )
  )
  (for (in y (..< 0 height))
    (for (in x (..< 0 width))
      (let at (* (+ (* y width) x) 4))
      (let alpha (/ (as ([] bytes (+ at 3)) F64) 255))
      (if (> alpha 0)
        (let red (/ (as ([] bytes at) F64) 255 alpha))
        (let green (/ (as ([] bytes (+ at 1)) F64) 255 alpha))
        (let blue (/ (as ([] bytes (+ at 2)) F64) 255 alpha))
        (let is-guide
          (scope (and near-guide (> blue (+ red 0.12)) (> blue (+ green 0.02)) (> red 0.35))
            (lazy near-guide (call ai-sheet-near x y width height ai-sheet-guide-band))
          )
        )
        (let kept (if-expr is-guide 0.0 (call max 0.0 (call min 1.0 (/ (- alpha veil) (- 1 veil))))))
        (if (!= kept alpha)
          (= ([] bytes at) (as (call round (* (call min 1.0 red) kept 255)) Byte))
          (= ([] bytes (+ at 1)) (as (call round (* (call min 1.0 green) kept 255)) Byte))
          (= ([] bytes (+ at 2)) (as (call round (* (call min 1.0 blue) kept 255)) Byte))
          (= ([] bytes (+ at 3)) (as (call round (* kept 255)) Byte))
        )
      )
    )
  )
  (call (. canvas write-premultiplied-pixels) bytes)
)

(fn-expr + ai-decode-painted Image (?! Error)
  (param image AIImage)
  (before
    (throw (call Error "The painted image has no bytes") (if (is-not source AIBytesSource)))
  )
  (call decode-image (. (as source AIBytesSource) data))
  (where
    (lazy source (. image file source))
  )
)

(fn-do + ai-paint AIImage (?! Error)
  (param painter AIProvider)
  (param request AIRequest)
  (let response (call (. painter complete) request))
  (for (in part (. response message parts))
    (if (= (| (: made AIImagePart)) part)
      (return (. made image))
    )
  )
  (throw (call AIError (. AIErrorKind invalid-response) "The image service returned no image"))
)

(fn-do + ai-paint-all (list AIPainted) (?! Error)
  (param painter AIProvider)
  (param requests (list AIRequest))
  (let results (of SyncBufferedChannel AIIndexedPainted))
  (for (in index (..< 0 (. requests length)))
    (let request ([] requests index))
    (do-new
      (<- results (call AIIndexedPainted index (call ai-paint-caught painter request)))
    )
  )
  (let painted (call (of List AIPainted) (in (call AIPainted null null) requests)))
  (for (in _ (..< 0 (. requests length)))
    (let got (<- results))
    (throw (call AIError (. AIErrorKind cancellation) "Image generation was canceled") (if (not got)))
    (= ([] painted (. got index)) (. got painted))
  )
  (return painted)
)

(fn-expr _ ai-sheet-near Bool
  (param x Index)
  (param y Index)
  (param width Index)
  (param height Index)
  (param band Index)
  (or (< x band) (< y band) (>= (+ x band) width) (>= (+ y band) height))
)

(fn-do _ ai-sheet-quantile F64
  (param counts (list Size))
  (param total Size)
  (param fraction F64)
  (let wanted (as (* (as total F64) fraction) Size))
  (let seen Size 0)
  (for (in level (..< 0 (. counts length)))
    (+= seen ([] counts level))
    (return-if (/ (as level F64) 255) (if (> seen wanted)))
  )
  (return 1.0)
)

(fn-do _ ai-paint-caught AIPainted
  (param painter AIProvider)
  (param request AIRequest)
  (let outcome (catch (call ai-paint painter request)))
  (if (= (| (: failure Error)) outcome)
    (return (call AIPainted null (. failure message)))
  )
  (return (call AIPainted (as outcome AIImage) null))
)

(fn-expr _ ai-sheet-fit AISheet
  (param canvas AISheetCanvas)
  (param columns Size)
  (param count Size)
  (param aspect F64)
  (param padding F64)
  (call AISheet (. canvas width) (. canvas height) columns rows count wide (/ wide aspect) padding)
  (where
    (lazy rows (/ (- (+ count columns) 1) columns))
    (lazy across (/ (- (. canvas width) (* ai-sheet-margin 2) (* (as (- columns 1) F64) ai-sheet-gutter)) (as columns F64)))
    (lazy down (/ (- (. canvas height) (* ai-sheet-margin 2) (* (as (- rows 1) F64) ai-sheet-gutter)) (as rows F64)))
    (lazy wide (call floor (call min across (* down aspect))))
  )
)

(fn-expr _ ai-sheet-beats Bool
  (param made AISheet)
  (param best AISheet)
  (case? (> area (* held ai-sheet-close))
    true
  )
  (case? (< (* area ai-sheet-close) held)
    false
  )
  (default
    (< (* (. made columns) (. made rows)) (* (. best columns) (. best rows)))
  )
  (where
    (lazy area (* (. made cell-width) (. made cell-height)))
    (lazy held (* (. best cell-width) (. best cell-height)))
  )
)

(fn-expr _ ai-sheet-fitted Rect
  (param size Dimensions)
  (param box Rect)
  (case? (or (<= (. size width) 0) (<= (. size height) 0))
    box
  )
  (default
    (call Rect (+ (. box x) (/ (- (. box width) wide) 2)) (+ (. box y) (/ (- (. box height) tall) 2)) wide tall)
  )
  (where
    (lazy scale (call min (/ (. box width) (. size width)) (/ (. box height) (. size height))))
    (lazy wide (* (. size width) scale))
    (lazy tall (* (. size height) scale))
  )
)
