_ ai-written-prompt String
    - prompt String
    - style AIImageStyle?
    - brief String?

"$prompt$styled$briefed"

.. styled = if style then "\n\nStyle: ${style.prompt}" else ""
.. briefed = if brief then "\n\n$brief" else ""

━━━━━━━━━━━━━━━━━━━━
_ do ai-named-level AIImageLevel?
    - levels [AIImageLevel]
    - name String?

=? null if !name
for level in levels
    =? level if level.name == name
= null

━━━━━━━━━━━━━━━━━━━━
_ ai-chosen-shape AIAspectRatio
    - value JSON?
    - is-edit Bool
    - defaults AIImageDefaults?

|? named && named != ai-image-default
    ai-image-shape(value)
|? is-edit
    AIAspectRatio.automatic
??
    defaults?.default-shape() ?? AIAspectRatio.automatic

.. named = match? value
    | text String
        text

━━━━━━━━━━━━━━━━━━━━
_ ai-image-tool-description String

"".join
    * "Creates images and shows them to the user. You cannot see the images it creates. "
    * "Each result gives the new images' IDs, and images the user attaches are listed with their IDs instead of shown to you. "
    * "To change an earlier or attached image or build on it, pass its ID in images and describe the change in prompt. "
    * "Set count above 1 to offer the user variations to choose from. "
    * "Making images takes a while, so the user sees reply while they wait."

━━━━━━━━━━━━━━━━━━━━
_ ai-image-properties [String = JSON]

Map'String'JSON
    • reply ai-reply-schema()
    • prompt Map'String'JSON
        • type "string"
        • description "What the image should show, or how to change the given images"
    • images Map'String'JSON
        • type "array"
        • items Map'String'JSON
            • type "string"
        • description "IDs of earlier or attached images to edit or draw from, or an empty list"
    • count Map'String'JSON
        • type "integer"
        • description "How many variations to make, or 1 for a single image. Up to $ai-image-quick-limit when quick, else up to $ai-image-full-limit."
    • quick Map'String'JSON
        • type "boolean"
        • description "Draw every variation as a small draft on one sheet in a single request: much cheaper and faster, at lower resolution. The user can ask for any draft at full size later. Use it for many variations or rough options to choose from; leave it false for a few finished images."
    • directions Map'String'JSON
        • type "array"
        • items Map'String'JSON
            • type "string"
        • description "One short note per variation on how it differs, such as “at dusk” or “seen from above”, or an empty list to let them vary freely"
    • shape Map'String'JSON
        • type "string"
        • enum List'JSON(each in ai-image-shapes)
        • description "The image's shape. default follows the user's setting for new images and keeps the shape of images you change; use another value only when the user asks for one. auto lets the image model decide."
    • background Map'String'JSON
        • type "string"
        • enum List'JSON(each in ai-image-backgrounds)
        • description "transparent for artwork meant to sit on other things, such as logos, icons, stickers, and cutouts, and when changing a transparent image; opaque for a full scene; auto lets the image model decide. Only transparent makes a real transparent background; asking for one in prompt alone gets a painted checkerboard."

━━━━━━━━━━━━━━━━━━━━
_ ai-image-required [JSON]

* ai-reply-argument
* "prompt"
* "images"
* "count"
* "quick"
* "directions"
* "shape"
* "background"

━━━━━━━━━━━━━━━━━━━━
_ do ai-draft-index Index?
    - output JSON
    - id String

. fields = match? output
    | [String = JSON]
=? null if !fields || !ai-image-flag(fields["quick"])
. listed = match? fields["images"]
    | [JSON]
. found = listed ?? List'JSON()
for index in 0 .. < found.length
    if | each String = found[index]
        =? index if each == id
= null

━━━━━━━━━━━━━━━━━━━━
_ do ai-draft-call-origin AIDraftOrigin?
    - call AIToolCallPart
    - index Index
    - output JSON

. fields = match? call.arguments
    | [String = JSON]
=? null if !fields
. prompt = match? fields["prompt"]
    | String
=? null if !prompt
. directions = ai-image-directions(fields["directions"])
. sources = List'String()
. listed = match? fields["images"]
    | [JSON]
for value in listed ?? List'JSON()
    if | source String = value
        sources += source
. made = match? output
    | [String = JSON]
. shape = ai-image-shape(made?["shape"] ?? fields["shape"])
= AIDraftOrigin
    - prompt
    - directions[index] if index < directions.length
    - sources
    - if shape == AIAspectRatio.automatic then AIAspectRatio.square else shape
    - ai-image-backdrop(fields["background"])
    - ai-output-style(output)

━━━━━━━━━━━━━━━━━━━━
_ ai-variation-line String
    - sheet AISheet
    - directions [String]
    - index Index

"- ${sheet.cell-name(index)}: ${directions[index]}"

━━━━━━━━━━━━━━━━━━━━
_ ai-image-direction String
    - prompt String
    - directions [String]
    - index Index

if index < directions.length then "$prompt\n\nThis variation: ${directions[index]}" else prompt

━━━━━━━━━━━━━━━━━━━━
_ do ai-drawing-output JSON
    - drawing AIDrawing
    - images AIImageStore

. ids = List'JSON((images.id(each) ?? "") in drawing.images)
. output = Map'String'JSON()
if ids.length == 1 && !drawing.failures
    output["image"] = ids[0]
else
    output["images"] = ids
    output["quick"] = drawing.is-quick
    if drawing.is-quick
        output["shape"] = ai-shape-name(drawing.shape)
    if drawing.failures
        output["failed"] = drawing.failures[0]
. style = drawing.style
if style
    output["style"] = ai-style-json(style)
= output

━━━━━━━━━━━━━━━━━━━━
_ ai-style-json JSON
    - style AIImageStyle

Map'String'JSON
    • name style.name
    • description style.prompt
    •? id style.id

━━━━━━━━━━━━━━━━━━━━
_ do ai-output-has-image Bool
    - output JSON
    - id String

. fields = match? output
    | [String = JSON]
=? false if !fields
=? true if ai-image-text(fields["image"]) == id
. listed = match? fields["images"]
    | [JSON]
= some(listed ?? List'JSON()) • where ai-image-text(each) == id

━━━━━━━━━━━━━━━━━━━━
_ ai-image-text String
    - value JSON?

match value
    | text String
        text.trim()
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ ai-image-count Size
    - value JSON?
    - is-quick Bool

if wanted == null || wanted < 1 then 1 else min(wanted as Size, limit)

.. limit = if is-quick then ai-image-quick-limit else ai-image-full-limit
.. wanted = match? value
    | whole Int
        whole as F64
    | fraction Float
        fraction as F64

━━━━━━━━━━━━━━━━━━━━
_ ai-image-flag Bool
    - value JSON?

match value
    | flag Bool
        flag
    ??
        false

━━━━━━━━━━━━━━━━━━━━
_ do ai-image-directions [String]
    - value JSON?

. directions = List'String()
. listed = match? value
    | [JSON]
for item in listed ?? List'JSON()
    if | note String = item
        if note.trim().length
            directions += note.trim()
= directions

━━━━━━━━━━━━━━━━━━━━
_ ai-image-backdrop AIImageBackground?
    - value JSON?

match? name
    |= "transparent"
        AIImageBackground.transparent
    |= "opaque"
        AIImageBackground.opaque

.. name = match? value
    | text String
        text

━━━━━━━━━━━━━━━━━━━━
_ ai-image-shape AIAspectRatio
    - value JSON?

match name
    |= "square"
        AIAspectRatio.square
    |= "landscape"
        AIAspectRatio.landscape
    |= "portrait"
        AIAspectRatio.portrait
    ??
        AIAspectRatio.automatic

.. name = match? value
    | text String
        text

━━━━━━━━━━━━━━━━━━━━
_ do ai-image-transcript [AIMessage]
    - messages [AIMessage]
    - images AIImageStore

. transcript = List'AIMessage()
for message in messages
    if message.role == AIMessageRole.assistant
        ai-split-image-reply(transcript, message.parts, images)
    else if message.role == AIMessageRole.user
        transcript += ai-stashed-attachments(message, images)
    else
        transcript += message
= transcript

━━━━━━━━━━━━━━━━━━━━
_ do ai-stashed-attachments AIMessage
    - message AIMessage
    - images AIImageStore

. ids = List'String()
. parts = List'AIMessagePart()
. is-pruned = false
for part in message.parts
    if | attached AIImagePart = part
        . id = images.id(attached.image)
        if images.is-gone(attached.image)
            is-pruned = true
        else if id
            ids += id
        else
            parts += part
    else
        parts += part
=? message if !ids.length && !is-pruned
if ids.length
    parts += AITextPart
        - "attached-image-ids"
        - "\n\nAttached image IDs: ${", ".join(ids)}. $ai-stash-note"
if is-pruned
    parts += AITextPart("deleted-images", "\n\nAn image attached here has since been deleted.")
= AIMessage(message.role, parts, message.name)

━━━━━━━━━━━━━━━━━━━━
_ do ai-split-image-reply
    - transcript [AIMessage]
    - parts [AIMessagePart]
    - images AIImageStore

. said = List'AIMessagePart()
. seen = List'AIMessagePart()
for part in parts
    if | result AIToolResultPart = part
        if said
            ai-show-tool-images(transcript, seen)
            transcript += AIMessage(AIMessageRole.assistant, said)
            said = List'AIMessagePart()
        . answered = List'AIMessagePart()
        answered += result
        transcript += AIMessage(AIMessageRole.tool, answered)
        for index in 0 .. < result.images.length
            . image = result.images[index]
            if !images.is-gone(image)
                seen += AIImagePart("${result.id}:image-$index", images.located(image))
    else if | call AIToolCallPart = part
        if ai-has-tool-result(parts, call.call-id)
            said += call
    else if part is not AIImagePart
        said += part
ai-show-tool-images(transcript, seen)
if said
    transcript += AIMessage(AIMessageRole.assistant, said)

━━━━━━━━━━━━━━━━━━━━
_ do ai-show-tool-images
    - transcript [AIMessage]
    - seen [AIMessagePart]

=? if !seen
. parts = List'AIMessagePart()
parts += AITextPart("tool-images", "Images returned by the tools above:")
parts ++= seen
transcript += AIMessage(AIMessageRole.user, parts)
seen.clear()

━━━━━━━━━━━━━━━━━━━━
_ ai-has-tool-result
    - parts [AIMessagePart]
    - call-id String

some(parts) • where each is AIToolResultPart && (each as AIToolResultPart).call-id == call-id
