+ AIImagingProvider is AIProvider

+ chat AIProvider
+ kit AIImageToolkit?
+ toolkits = List'AIToolkit()

────────────────────
+ This
    - chat
    - kit

super()

╌╌╌╌╌╌╌╌╌╌ is AIProvider ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do stream <AIEvent>
    - request AIRequest

. drawing = kit
. said = List'AIMessagePart()
. round Size = 0
while true
    round += 1
    . history = List'AIMessage(request.messages)
    history += AIMessage(AIMessageRole.assistant, said)
    . transcript = if drawing then ai-image-transcript(history, drawing.images) else history
    for each in toolkits
        transcript = each.prompt(transcript)
    . noted = drawing?.note()
    . told = ai-toolkits-context(toolkits, request)
    . context = if noted && told then "$noted\n\n$told" else noted ?? told
    . turn = AIRequest(request.model, ai-toolkit-messages(transcript, context))
    if drawing
        turn.tools ++= drawing.tools()
    for each in toolkits
        turn.tools ++= each.tools()
    if round >= ai-image-round-limit
        turn.tool-choice = AIToolChoice.none

    . done AIDoneEvent?
    . calls = List'AIToolCallPart()
    for event in chat.stream(turn)
        if | finished AIDoneEvent = event
            done = finished
        else
            if | ended AIPartEndEvent = event
                said += ended.part
                if | call AIToolCallPart = ended.part
                    calls += call
            <= event

    ?! AIError(AIErrorKind.invalid-response, "The chat stream ended without a done event")
        if !done
    if !calls
        <= done
        =

    for call in calls
        for event in answer(request, call)
            said += event.part
            <= event

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ do answer <AIPartEndEvent>
    - request AIRequest
    - call AIToolCallPart

. drawing = kit
. owner = ai-toolkit-for(toolkits, call.tool-name) ?? (ai-toolkit-for(List'AIToolkit([drawing]), call.tool-name) if drawing)
if !owner
    <= AIPartEndEvent(ai-toolkit-failure(call, "There is no tool named ${call.tool-name}"))
    =
. ran = catch owner.run(request, call)
?! AIError(AIErrorKind.cancellation, "The tool call was canceled")
    if Task().is-canceled
if | failure Error = ran
    <= AIPartEndEvent(ai-toolkit-failure(call, failure.message))
    =
<<= ai-toolkit-parts(call, ran as AIToolkitResult)

