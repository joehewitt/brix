+ do ai-image-tool AITool
    - levels [AIImageLevel] = List'AIImageLevel()
    - has-styles = false

. properties = ai-image-properties()
. required = ai-image-required()
if levels
    properties["quality"] = ai-image-quality-schema(levels)
    required += "quality"
if has-styles
    properties["style"] = Map'String'JSON
        • type "string"
        • description "The look of these images, which the app adds to prompt and remembers with them. $ai-image-default follows the app: the style the user attached to their message, or else the style of the images you change. $ai-image-unstyled draws them with no style. Otherwise pass the ID of a saved style, or a short name for a look the user asks for that isn't saved, described in style_description."
    properties["style_description"] = Map'String'JSON
        • type List'JSON(each in ["string", "null"])
        • description "When style names a look that isn't saved, the look alone in one to three sentences: medium, technique, palette, lighting, texture, line, and mood. Otherwise null."
    required += "style"
    required += "style_description"
. parameters = Map'String'JSON
    • type "object"
    • properties properties
    • required required
    • "additionalProperties" false
= AITool(ai-image-tool-name, ai-image-tool-description(), parameters)

