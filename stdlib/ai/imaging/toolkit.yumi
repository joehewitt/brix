+ ai-output-style AIImageStyle?
    - output JSON

|? !fields
    null
|? !style
    null
|? !name.length || !description.length
    null
??
    AIImageStyle(name, description, id if id.length)

.. fields = match? output
    | [String = JSON]
.. style = match? fields["style"]
    | [String = JSON]
.. name = ai-image-text(style["name"])
.. description = ai-image-text(style["description"])
.. id = ai-image-text(style["id"])

