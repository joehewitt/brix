╌╌╌╌╌╌╌╌╌╌ is AIToolkit ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do tools [AITool]

. listed = List'AITool()
listed += ai-image-tool(levels, defaults != null)
listed += ai-full-size-tool()
listed += ai-view-tool()
= listed

────────────────────
+ context String?
    - request AIRequest

note()

────────────────────
+ prompt [AIMessage]
    - messages [AIMessage]

<* message in messages
    if message.role == AIMessageRole.user then ai-stashed-attachments(message, images) else message

────────────────────
+ do run AIToolkitResult ?! Error
    - request AIRequest
    - call AIToolCallPart

if call.tool-name == ai-view-tool-name
    . id = ai-argument(call.arguments, "image")
    ?! AIError(AIErrorKind.invalid-request, "$ai-view-tool-name needs the ID of an image")
        if !id
    . shown = Map'String'JSON
        • image id
    = AIToolkitResult(shown) • images List'AIImage([images.input(id)])
if call.tool-name == ai-full-size-tool-name
    . made = enlarge(request, call)
    . output = Map'String'JSON
        • image images.id(made.image) ?? ""
        • replaces made.draft
    . style = made.style
    if style
        output["style"] = ai-style-json(style)
    = AIToolkitResult(output) • shown List'AIImage([made.image])
. drawing = draw(request, call)
= AIToolkitResult(ai-drawing-output(drawing, images)) • shown drawing.images

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do note String?

. chosen = defaults
=? null if !chosen
. parts = List'String()
. shape = chosen.default-shape()
if shape && aspect-ratio == AIAspectRatio.automatic
    parts += "shape ${ai-shape-name(shape)}"
. level = chosen.default-level()
if level && levels
    parts += "quality $level"
=? null if !parts
= "<image-settings>\nThe user's settings for new images: ${", ".join(parts)}. Pass default for shape and quality to follow them, and another value only when the user asks for something different.\n</image-settings>"

────────────────────
_ do draw AIDrawing ?! Error
    - request AIRequest
    - call AIToolCallPart

?! AIError(AIErrorKind.invalid-request, "There is no tool named ${call.tool-name}")
    if call.tool-name != ai-image-tool-name
ai-image-unlock(access)
. fields = match call.arguments
    | fields [String = JSON]
        fields
    ?! AIError(AIErrorKind.invalid-request, "$ai-image-tool-name arguments must be an object")
. prompt = match fields["prompt"]
    | prompt String
        prompt
    ?! AIError(AIErrorKind.invalid-request, "$ai-image-tool-name needs a prompt")

. sources = List'AIImage()
. ids = List'String()
. listed = match? fields["images"]
    | [JSON]
for value in listed ?? List'JSON()
    . id = match value
        | id String
            id
        ?! AIError(AIErrorKind.invalid-request, "Image IDs must be strings")
    sources += images.input(id)
    ids += id
. wants-quick = ai-image-flag(fields["quick"])
. count = ai-image-count(fields["count"], wants-quick)
. directions = ai-image-directions(fields["directions"])
. ratio = if aspect-ratio != AIAspectRatio.automatic then aspect-ratio else chosen-shape
    .. chosen-shape = ai-chosen-shape(fields["shape"], sources.length > 0, defaults)
. backdrop = background ?? ai-image-backdrop(fields["background"])
. level = ai-image-level(levels, fields["quality"], defaults)
. style = chosen-style(request, fields, ids)
. written = ai-written-prompt(prompt, style, brief)
if wants-quick && count > 1
    . sheet = quick(written, sources, count, directions, ratio, backdrop, level)
    sheet.style = style
    = sheet

. requests = List'AIRequest()
for index in 0 .. < count
    requests += paint-request
        - ai-image-direction(written, directions, index)
        - sources
        - ratio
        - backdrop
        - level
. painted = ai-paint-all(painter, requests)
. drawing = AIDrawing(List'AIImage(), List'String(), false) • style style
for result in painted
    . image = result.image
    if image
        drawing.images += images.save(image)
    else
        drawing.failures += result.failure ?? "The image service returned no image"
?! AIError(AIErrorKind.invalid-response, drawing.failures[0])
    if !drawing.images
= drawing

────────────────────
_ do enlarge AIEnlarged ?! Error
    - request AIRequest
    - call AIToolCallPart

ai-image-unlock(access)
. draft = ai-argument(call.arguments, "image")
?! AIError(AIErrorKind.invalid-request, "$ai-full-size-tool-name needs the ID of a draft")
    if !draft
. origin = ai-draft-origin(request.messages, draft)
?! AIError(AIErrorKind.invalid-request, "$draft is not a quick draft")
    if !origin
. references = List'AIImage()
references += images.input(draft)
for id in origin.sources
    references += images.input(id)
. written = ai-written-prompt(origin.prompt, origin.style, brief)
. ratio = if aspect-ratio != AIAspectRatio.automatic then aspect-ratio else origin.ratio
. level = ai-image-level(levels, null, defaults)
. made = ai-paint
    - painter
    - paint-request
        - ai-full-size-prompt(written, origin.direction, origin.sources.length > 0)
        - references
        - ratio
        - background ?? origin.backdrop
        - level
= AIEnlarged(draft, images.save(made), origin.style)

────────────────────
_ do quick AIDrawing ?! Error
    - prompt String
    - sources [AIImage]
    - count Size
    - directions [String]
    - ratio AIAspectRatio
    - backdrop AIImageBackground?
    - level AIImageLevel?

. is-clear = backdrop == AIImageBackground.transparent
. sheet = ai-sheet(count, ai-shape-aspect(ratio))
. references = List'AIImage()
references += ai-sheet-template(sheet) • is-clear is-clear
references ++= sources
. request = paint-request
    - ai-variations-prompt(sheet, prompt, directions, sources.length > 0, is-clear)
    - references
    - sheet.aspect-ratio
    - if is-clear then AIImageBackground.transparent else AIImageBackground.opaque
    - level
. painted = use ai-decode-painted(ai-paint(painter, request))
. drawing = AIDrawing
    - List'AIImage()
    - List'String()
    - true
    - if ratio == AIAspectRatio.automatic then AIAspectRatio.square else ratio
for slice in ai-sheet-slices(sheet, painted, is-clear)
    drawing.images += images.save(slice)
= drawing

────────────────────
_ do paint-request AIRequest
    - prompt String
    - references [AIImage]
    - ratio AIAspectRatio
    - backdrop AIImageBackground?
    - level AIImageLevel?

. options = AIImageOptions()
options.prompt = prompt
options.aspect-ratio = ratio
options.quality = level?.quality ?? quality
options.background = backdrop
options.reference-images ++= references
. request = AIRequest(level?.model ?? image-model)
request.image-output = options
= request

────────────────────
_ do chosen-style AIImageStyle? ?! AIError
    - request AIRequest
    - fields [String = JSON]
    - sources [String]

. chosen = defaults
=? null if !chosen
. named = ai-image-text(fields["style"])
=? chosen.default-style(request, sources) if !named.length || named == ai-image-default
=? null if named == ai-image-unstyled
. saved = chosen.saved-style(named)
=? saved if saved
. look = ai-image-text(fields["style_description"])
?! AIError(AIErrorKind.invalid-request, "There is no saved style with ID $named. For a look that isn't saved, give its name in style and describe it in style_description.")
    if !look.length
= AIImageStyle(named, look)

