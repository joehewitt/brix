+ ai-image-default = "default"
+ ai-image-unstyled = "none"

_ ai-image-round-limit Size = 6
_ ai-image-quick-limit Size = 16
_ ai-image-full-limit Size = 4
_ ai-image-key-patience Duration = 10minutes
_ ai-stash-note = "You can't see attached images unless you call view_image with an ID. To build on one with generate_image, pass its ID in images; you don't need to view it first."
_ ai-image-shapes = [ai-image-default, "auto", "square", "landscape", "portrait"]
_ ai-image-backgrounds = ["auto", "transparent", "opaque"]

_ AIEnlarged is (draft String, image AIImage, style AIImageStyle?)
_ AIDraftOrigin is (prompt String, direction String?, sources [String], ratio AIAspectRatio, backdrop AIImageBackground?, style AIImageStyle?)

