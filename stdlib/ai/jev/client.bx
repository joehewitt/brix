(import ./model)
(import /ai/model)
(import /data/json)
(import /net/http)
(import /net/url)
(import /time/duration)
(blank)
(prop _ jev-api-base URL (= "https://api.typesafe.ai/v1"))

(type + Jev
  (prop + api-key String)
  (prop + base-url URL)
  (prop + retry-policy JevRetryPolicy)
  (fn-do + This _
    (param api-key _)
    (param base-url _ (= jev-api-base))
    (param retry-policy _ (= (call JevRetryPolicy)))
  )
  (fn-expr _ headers (list HTTPHeader) :get
    (item (tuple "Authorization" (str "Bearer " api-key)))
    (item (tuple "Content-Type" "application/json"))
    (item (tuple "Accept" "application/json"))
  )
  (fn-do + evaluate JevResponse (?! AIError)
    (param request JevRequest)
    (let body (call to-json (call encode request)))
    (let attempts (. retry-policy maximum-attempts))
    (= attempts (if-expr (== attempts 0) 1 attempts))
    (let attempt Size 0)
    (let delay (. retry-policy initial-delay))
    (blank)
    (while (< attempt attempts)
      (+= attempt 1)
      (let response (call post body))
      (if (and (call should-retry response) (< attempt attempts))
        (call (. delay wait))
        (= delay (* delay 2))
        (= delay (if-expr (> delay (. retry-policy maximum-delay)) (. retry-policy maximum-delay) delay))
        (else
          (return (call decode response))
        )
      )
    )
    (blank)
    (throw (call AIError (. AIErrorKind unknown) "Jev request did not complete"))
  )
  (fn-expr + evaluate JevResponse (?! AIError)
    (param state String)
    (param questions (map String JevQuestion))
    (param model _ (= "jev-latest"))
    (call evaluate (call JevRequest state questions model))
  )
  (fn-expr + evaluate JevResponse (?! AIError)
    (param state JSON)
    (param questions (map String JevQuestion))
    (param model _ (= "jev-latest"))
    (call evaluate (call JevRequest state questions model))
  )
  (fn-expr _ post HTTPResponse (?! AIError)
    (param body String)
    (throw (call AIError (. AIErrorKind unknown) (str transport-error)) (on-error (: transport-error Error)))
    (blank)
    (call http-post endpoint body headers)
    (where
      (lazy endpoint (/ base-url "systemone"))
    )
  )
  (fn-expr _ should-retry _
    (param response HTTPResponse)
    (or (== (. response status) 429) (== (. response status) 529))
  )
  (fn-do + encode JSON (?! AIError)
    (param request JevRequest)
    (throw (call AIError (. AIErrorKind invalid-request) "Jev request model is required") (if (not (. request model))))
    (blank)
    (let questions (call (of Map String JSON)))
    (for (in (tuple id question) (. request questions))
      (throw (call AIError (. AIErrorKind invalid-request) "Jev question IDs cannot be empty") (if (not id)))
      (= ([] questions id) (call question-value question))
    )
    (blank)
    (return
      (call (of Map String JSON)
        (block
          (:state (call validate-value (. request state) "Jev request state"))
          (:model (. request model))
          (:questions questions)
        )
      )
    )
  )
  (fn-do _ question-value JSON (?! AIError)
    (param question JevQuestion)
    (match question
      (case (: noul JevNoulQuestion)
        (return
          (call (of Map String JSON)
            (block
              (:type "noul")
              (:instructions (call validate-value (. noul instructions) "Jev Noul instructions"))
              (:criteria? (only-if (call noul-criteria-value (. noul criteria)) (if (. noul criteria))))
            )
          )
        )
      )
      (case (: choice JevChoiceQuestion)
        (throw (call AIError (. AIErrorKind invalid-request) "Jev Choice accepts at most 255 options") (if (> (. choice criteria length) 255)))
        (blank)
        (for (in (tuple name value) (. choice criteria))
          (throw (call AIError (. AIErrorKind invalid-request) "Jev Choice option names cannot be empty") (if (not name)))
          (call validate-choice-criterion value)
        )
        (blank)
        (return
          (call (of Map String JSON)
            (block
              (:type "choice")
              (:instructions (call validate-value (. choice instructions) "Jev Choice instructions"))
              (:criteria (. choice criteria))
            )
          )
        )
      )
      (case (: score JevScoreQuestion)
        (throw (call AIError (. AIErrorKind invalid-request) "Jev Score requires between 2 and 10 levels") (if (or (< (. score criteria length) 2) (> (. score criteria length) 10))))
        (blank)
        (for (in value (. score criteria))
          (call validate-value value "Jev Score criterion")
        )
        (blank)
        (return
          (call (of Map String JSON)
            (block
              (:type "score")
              (:instructions (call validate-value (. score instructions) "Jev Score instructions"))
              (:criteria (. score criteria))
            )
          )
        )
      )
    )
  )
  (fn-expr _ noul-criteria-value JSON (?! AIError)
    (param criteria JevNoulCriteria)
    (call (of Map String JSON)
      (block
        (:true? (only-if (call validate-value (. criteria yes) "Jev Noul yes criterion") (if (. criteria yes))))
        (:false? (only-if (call validate-value (. criteria no) "Jev Noul no criterion") (if (. criteria no))))
      )
    )
  )
  (fn-expr _ validate-value _
    (param value JSON)
    (param label String)
    (before
      (throw (call AIError (. AIErrorKind invalid-request) (str label " must be a string, object, or array")) (if (and (is-not value String) (is-not value (list JSON)) (is-not value (map String JSON)))))
    )
    value
  )
  (fn-expr _ validate-choice-criterion _
    (param value JSON)
    (before
      (throw (call AIError (. AIErrorKind invalid-request) "Choice criteria must be null, strings, objects, or arrays") (if (and (is-not value Null) (is-not value String) (is-not value (list JSON)) (is-not value (map String JSON)))))
    )
    value
  )
  (fn-do + decode JevResponse (?! AIError)
    (param response HTTPResponse)
    (let text
      (scope (. response text)
        (on-error (: error Error)
          (throw (call AIError (. AIErrorKind invalid-response) (str error)))
        )
      )
    )
    (throw (call response-error response text) (if (!= (. response status) (. HTTPStatus ok))))
    (blank)
    (return (call response-value (call parse-json text "Jev returned invalid response JSON")))
  )
  (fn-expr _ response-value _ (?! AIError)
    (param value JSON)
    (call JevResponse model answers usage)
    (where
      (lazy model (call require-string "Jev response model" ([] root "model")))
      (lazy root (call require-object "Jev response" value))
      (lazy answers
        (block
          (spread (call require-object "Jev response answers" ([] root "answers")))
          (pipe *> (tuple ([] each 0) (call answer-value ([] each 1))))
          (pipe |> Map)
        )
      )
      (lazy usage
        (call AIUsage
          (block
            (:input-tokens (call require-size "Jev input token usage" ([] wire-usage "input_tokens")))
            (:output-tokens (call require-size "Jev output token usage" ([] wire-usage "output_tokens")))
            (blank)
            (lazy wire-usage (call require-object "Jev response usage" ([] root "usage")))
          )
        )
      )
    )
  )
  (fn-expr _ answer-value JevAnswer (?! AIError)
    (param value JSON)
    (match kind
      (case= "noul"
        (call JevNoulAnswer
          (block
            (arg (call require-probability "Jev Noul probability" ([] root "noul")))
          )
        )
      )
      (case= "choice"
        (call JevChoiceAnswer
          (block
            (arg (call require-string "Jev Choice selection" ([] root "choice")))
            (arg (call require-probabilities "Jev Choice probabilities" ([] root "probabilities")))
            (arg (call require-probability "Jev Choice confidence" ([] root "confidence")))
          )
        )
      )
      (case= "score"
        (call JevScoreAnswer
          (block
            (arg (call require-number "Jev Score value" ([] root "score")))
            (arg (call require-legend ([] root "legend")))
            (arg (call require-probabilities "Jev Score probabilities" ([] root "probabilities")))
            (arg (call require-probability "Jev Score confidence" ([] root "confidence")))
          )
        )
      )
      (throw (call AIError (. AIErrorKind invalid-response) (str "Unknown Jev answer type: " kind)))
    )
    (where
      (lazy root (call require-object "Jev answer" value))
      (lazy kind (call require-string "Jev answer type" ([] root "type")))
    )
  )
  (fn-expr _ require-object _ (?! AIError)
    (param label String)
    (param value (? JSON))
    (before
      (throw (call AIError (. AIErrorKind invalid-response) (str label " must be an object")) (if (not value)))
    )
    (match value
      (case (: object (map String JSON))
        object
      )
      (throw (call AIError (. AIErrorKind invalid-response) (str label " must be an object")))
    )
  )
  (fn-expr _ require-string _ (?! AIError)
    (param label String)
    (param value (? JSON))
    (before
      (throw (call AIError (. AIErrorKind invalid-response) (str label " must be a string")) (if (not value)))
    )
    (match value
      (case (: text String)
        text
      )
      (throw (call AIError (. AIErrorKind invalid-response) (str label " must be a string")))
    )
  )
  (fn-expr _ require-number _ (?! AIError)
    (param label String)
    (param value (? JSON))
    (before
      (throw (call AIError (. AIErrorKind invalid-response) (str label " must be a number")) (if (not value)))
    )
    (match value
      (case (: number Float)
        number
      )
      (case (: number Int)
        (as number Float)
      )
      (throw (call AIError (. AIErrorKind invalid-response) (str label " must be a number")))
    )
  )
  (fn-expr _ require-probability _ (?! AIError)
    (param label String)
    (param value (? JSON))
    (before
      (throw (call AIError (. AIErrorKind invalid-response) (str label " must be between 0 and 1")) (if (or (< number 0) (> number 1))))
    )
    number
    (where
      (lazy number (call require-number label value))
    )
  )
  (fn-do _ require-size Size (?! AIError)
    (param label String)
    (param value (? JSON))
    (throw (call AIError (. AIErrorKind invalid-response) (str label " must be a non-negative integer")) (if (not value)))
    (blank)
    (match value
      (case (all (: number Int) ({} (>= it 0)))
        (return number)
      )
      (throw (call AIError (. AIErrorKind invalid-response) (str label " must be a non-negative integer")))
    )
  )
  (fn-expr _ require-probabilities _ (?! AIError)
    (param label String)
    (param value (? JSON))
    (spread (call require-object label value))
    (pipe *> (tuple ([] each 0) (call require-probability (str label " value") ([] each 1))))
    (pipe |> Map)
  )
  (fn-expr _ require-legend _ (?! AIError)
    (param value (? JSON))
    (spread (call require-object "Jev Score legend" value))
    (pipe *> (tuple ([] each 0) (call require-string "Jev Score legend value" ([] each 1))))
    (pipe |> Map)
  )
  (fn-expr _ parse-json _ (?! AIError)
    (param text String)
    (param service-message String)
    (match text
      (~ \json-text)
      (throw (call AIError (. AIErrorKind invalid-response) service-message))
    )
  )
  (fn-expr _ parse-json-optional (? JSON)
    (param text String)
    (match? text
      (~ \json-text)
    )
  )
  (fn-expr _ response-message _
    (param body String)
    (?? message detail nested-message body)
    (where
      (lazy root
        (match? (call parse-json-optional body)
          (case (: root (map String JSON))
            root
          )
        )
      )
      (lazy message
        (match? root
          (case (: root (map String JSON))
            (match? ([] root "message")
              (case (: message String))
            )
          )
        )
      )
      (lazy detail
        (match? root
          (case (: root (map String JSON))
            (match? ([] root "detail")
              (case (: detail String))
            )
          )
        )
      )
      (lazy nested-message
        (match? root
          (case (: root (map String JSON))
            (match? ([] root "error")
              (case (: error (map String JSON))
                (match? ([] error "message")
                  (case (: message String))
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-expr _ error-kind _
    (param status Int)
    (match status
      (case= 401
        (. AIErrorKind authentication)
      )
      (case= 403
        (. AIErrorKind authentication)
      )
      (case= 429
        (. AIErrorKind rate-limit)
      )
      (case= 529
        (. AIErrorKind server)
      )
      (case= 500
        (. AIErrorKind server)
      )
      (default
        (. AIErrorKind invalid-request)
      )
    )
  )
  (fn-expr _ response-error _
    (param response HTTPResponse)
    (param text String)
    (call AIError kind message (. response status) retryable (call (. response header) "Retry-After"))
    (where
      (lazy kind (call error-kind (. response status)))
      (lazy message (call response-message text))
      (lazy retryable (call should-retry response))
    )
  )
)
