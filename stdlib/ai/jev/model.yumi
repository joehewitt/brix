/ai/model
/data/json
/time/duration

━━━━━━━━━━━━━━━━━━━━
+ JevRequest is Tuple

+ state JSON
+ questions [String = JevQuestion]
+ model String = "jev-latest"

━━━━━━━━━━━━━━━━━━━━
+ JevResponse is Tuple

+ model String
+ answers [String = JevAnswer]
+ usage AIUsage

━━━━━━━━━━━━━━━━━━━━
+ JevNoulCriteria is Tuple

+ yes JSON?
+ no JSON?

━━━━━━━━━━━━━━━━━━━━
+ JevQuestion is Union

| JevNoulQuestion
| JevChoiceQuestion
| JevScoreQuestion

━━━━━━━━━━━━━━━━━━━━
+ JevNoulQuestion is Tuple

+ instructions JSON
+ criteria JevNoulCriteria?

━━━━━━━━━━━━━━━━━━━━
+ JevChoiceQuestion is Tuple

+ instructions JSON
+ criteria [String = JSON]

━━━━━━━━━━━━━━━━━━━━
+ JevScoreQuestion is Tuple

+ instructions JSON
+ criteria [JSON]

━━━━━━━━━━━━━━━━━━━━
+ JevAnswer is Union

| JevNoulAnswer
| JevChoiceAnswer
| JevScoreAnswer

━━━━━━━━━━━━━━━━━━━━
+ JevNoulAnswer is Tuple

+ yes-probability Float

━━━━━━━━━━━━━━━━━━━━
+ JevChoiceAnswer is Tuple

+ choice String
+ probabilities [String = Float]
+ confidence Float

━━━━━━━━━━━━━━━━━━━━
+ JevScoreAnswer is Tuple

+ score Float
+ legend [String = String]
+ probabilities [String = Float]
+ confidence Float

━━━━━━━━━━━━━━━━━━━━
+ JevRetryPolicy is Tuple

+ maximum-attempts Size = 3
+ initial-delay Duration = 500ms
+ maximum-delay Duration = 8s
