(import /ai/model)
(import /data/json)
(import /time/duration)

(type + JevRequest (is Tuple)
  (prop + state JSON)
  (prop + questions (map String JevQuestion))
  (prop + model String (= "jev-latest"))
)

(type + JevResponse (is Tuple)
  (prop + model String)
  (prop + answers (map String JevAnswer))
  (prop + usage AIUsage)
)

(type + JevNoulCriteria (is Tuple)
  (prop + yes (? JSON))
  (prop + no (? JSON))
)

(type + JevQuestion (is Union)
  (variant JevNoulQuestion)
  (variant JevChoiceQuestion)
  (variant JevScoreQuestion)
)

(type + JevNoulQuestion (is Tuple)
  (prop + instructions JSON)
  (prop + criteria (? JevNoulCriteria))
)

(type + JevChoiceQuestion (is Tuple)
  (prop + instructions JSON)
  (prop + criteria (map String JSON))
)

(type + JevScoreQuestion (is Tuple)
  (prop + instructions JSON)
  (prop + criteria (list JSON))
)

(type + JevAnswer (is Union)
  (variant JevNoulAnswer)
  (variant JevChoiceAnswer)
  (variant JevScoreAnswer)
)

(type + JevNoulAnswer (is Tuple)
  (prop + yes-probability Float)
)

(type + JevChoiceAnswer (is Tuple)
  (prop + choice String)
  (prop + probabilities (map String Float))
  (prop + confidence Float)
)

(type + JevScoreAnswer (is Tuple)
  (prop + score Float)
  (prop + legend (map String String))
  (prop + probabilities (map String Float))
  (prop + confidence Float)
)

(type + JevRetryPolicy (is Tuple)
  (prop + maximum-attempts Size (= 3))
  (prop + initial-delay Duration (= 500ms))
  (prop + maximum-delay Duration (= 8s))
)
