./chat
./database
./model
./session
/stream/aggregate
/sys/random.h

━━━━━━━━━━━━━━━━━━━━
+ AIChatStore

+ services [AIChatService]
+ database AIChatDatabase?
+ owner String?
+ project String?
+ sessions [AIChatSession]
+ active AIChatSession
+ error String?
+ revision U64

────────────────────
+ This
    - services
    - database AIChatDatabase? = null
    - owner String? = null
    - project String? = null

open-database()
active = create-session(starting-service())

────────────────────
+ do new-session
    - service AIChatService? = null

. chosen = service ?? active.service
if !active.is-empty || active.service != chosen
    active = create-session(chosen)
= active

────────────────────
+ do select
    - session AIChatSession

if !session.is-loaded
    load(session)
=? if !session.is-loaded
active = session

────────────────────
+ do summon AIChatSession?
    - id String

for session in sessions
    =? session if session.chat.id == id
. summary = catch? database?.load-summary(id)
=? null if !summary
. session = saved-session(summary)
sessions += session
revision += 1
= session

────────────────────
+ do mark-done
    - session AIChatSession
    - is-done Bool

. marks = session.document.marks
session.document.marks = AIChatMarks(marks.seen-at, ai-chat-now() if is-done, marks.archived-at)
revision += 1
. target = database
=? if !target
target.mark-done(session.chat.id, is-done)
    catch failure Error
        error = "${session.title ?? session.chat.id} could not be marked: $failure"

────────────────────
+ do mark-archived
    - session AIChatSession
    - is-archived Bool

. marks = session.document.marks
session.document.marks = if is-archived then archived-marks else AIChatMarks(marks.seen-at)
    .. archived-marks = AIChatMarks(marks.seen-at, marks.done-at, ai-chat-now())
revision += 1
. target = database
=? if !target
target.mark-archived(session.chat.id, is-archived)
    catch failure Error
        error = "${session.title ?? session.chat.id} could not be archived: $failure"

────────────────────
+ do delete
    - session AIChatSession

. id = session.chat.id
if session.is-busy
    session.stop()
        catch failure Error
            error = "${session.title ?? id} could not be stopped: $failure"
for index in 0 .. < sessions.length
    if sessions[index].chat.id == id
        sessions.remove(index)
        break
if active.chat.id == id
    active = create-session(active.service)
revision += 1
. target = database
=? if !target
target.delete(id)
    catch failure Error
        error = "${session.title ?? id} could not be deleted: $failure"

────────────────────
+ do see
    - session AIChatSession

. document = session.document
=? if !chat-is-unread(document.activity, document.marks)
. at = ai-chat-now()
. marks = document.marks
document.marks = AIChatMarks(at, marks.done-at, marks.archived-at)
revision += 1
. target = database
=? if !target
target.see(session.chat.id, at)
    catch failure Error
        error = "${session.title ?? session.chat.id} could not be saved: $failure"

────────────────────
_ do create-session
    - service AIChatService

. session = adopt(AIChat(ai-chat-id()), service)
sessions.insert(session, 0)
revision += 1
= session

────────────────────
_ do adopt
    - chat AIChat
    - service AIChatService

. session = AIChatSession(chat, service)
for _ on session.document.committed
    revision += 1
    save(session)
for progress on session.document.progressed
    save-progress(session, progress)
= session

────────────────────
_ do starting-service

if sessions.length
    for service in services
        =? service if service == sessions[0].service
= services[0]

────────────────────
_ do service-for
    - id String?

=? services[0] if id == null
for service in services
    =? service if service.id == id
= AIChatService(id, id, AIMissingProvider(id), "")

────────────────────
_ do open-database

. source = database
=? if !source
. summaries = source.load-index(owner)
    catch failure Error
        error = "Saved chats could not be read: $failure"
        database = null
        =
for summary in summaries
    sessions += saved-session(summary)
for summary on source.changed
    follow(summary)

────────────────────
_ do saved-session
    - summary AIChatSummary

. session = adopt(AIChat(summary.id, "root", summary.title), service-for(summary.service))
session.document.branches = summary.branches
session.document.is-empty = false
session.document.is-loaded = false
session.document.activity = summary.activity
session.document.marks = summary.marks
= session

────────────────────
_ do follow
    - summary AIChatSummary

. held = first(each in sessions when each.chat.id == summary.id)
if summary.owner == owner && held
    held.document.marks = summary.marks
    revision += 1
else if summary.owner == owner && summary.marks.archived-at == null
    sessions.insert(saved-session(summary), 0)
    revision += 1
else if summary.owner != owner && held
    for index in 0 .. < sessions.length
        if sessions[index].chat.id == summary.id
            sessions.remove(index)
            break
    if active.chat.id == summary.id
        active = create-session(active.service)
    revision += 1

────────────────────
_ do load
    - session AIChatSession

. source = database
=? if !source
. saved = source.load(session.chat.id)
    catch failure Error
        error = "${session.title ?? session.chat.id} could not be opened: $failure"
        =
session.document.restore(saved)
    catch failure Error
        error = "${session.title ?? session.chat.id} could not be opened: $failure"
        =
error = null
revision += 1
do new
    session.catch-up()

────────────────────
_ do save
    - session AIChatSession

. target = database
=? if !target
target.save(session.document.saved-chat(), session.service.id, owner, !session.is-empty) • project project
    catch failure Error
        error = "${session.title ?? session.chat.id} could not be saved: $failure"
        =
error = null

────────────────────
_ do save-progress
    - session AIChatSession
    - progress AIChatProgress

. target = database
=? if !target
. is-saved = target.save-progress(session.chat.id, progress)
    catch failure Error
        error = "${session.title ?? session.chat.id} could not be saved: $failure"
        =
if !is-saved
    save(session)

━━━━━━━━━━━━━━━━━━━━
+ do ai-chat-id String

. bytes = Byte[8]
C:getentropy(bytes, 8)
. hex String = bytes as Hex
= "chat-$hex"

━━━━━━━━━━━━━━━━━━━━
_ AIMissingProvider is AIProvider

+ name String

────────────────────
+ This
    - name

super()

────────────────────
+ do stream <AIEvent>
    - request AIRequest

if false
    <= AIDoneEvent(AIFinishReason.error, AIUsage())
?! AIError(AIErrorKind.invalid-request, "This chat began with $name, which is not set up here")
