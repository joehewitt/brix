./model
/core/channel
/data/json
/os/env
/os/file
/os/path
/time/duration

_ ai-access-perms = user-read-perm /or/ user-write-perm

━━━━━━━━━━━━━━━━━━━━
+ AIAccessKind is Union

| approval
| api-key

━━━━━━━━━━━━━━━━━━━━
+ AIAccessStore

+ path Path

_ approvals = Map'String'Bool()
_ keys = Map'String'String()
_ is-loaded = false

────────────────────
+ This
    - path

────────────────────
+ do is-approved Bool
    - id String

load()
= approvals has id

────────────────────
+ do key String?
    - id String

load()
= keys[id]

────────────────────
+ do approve ?! Error
    - id String

load()
approvals[id] = true
save()

────────────────────
+ do keep-key ?! Error
    - id String
    - key String

load()
keys[id] = key
save()

────────────────────
_ do load

=? if is-loaded
is-loaded = true
. text = catch? read-file-text(path)
=? if !text
. fields = match? (catch? parse-json(text))
    | [String = JSON]
=? if !fields
if | approved [JSON] = fields["approved"]
    for item in approved
        if | id String = item
            approvals[id] = true
if | saved [String = JSON] = fields["keys"]
    for id, value in saved
        if | key String = value
            keys[id] = key

────────────────────
_ do save ?! Error

. approved = List'JSON()
for id, _ in approvals
    approved += id
. saved = Map'String'JSON()
for id, key in keys
    saved[id] = key
. root = Map'String'JSON
    • approved approved
    • keys saved
do path.parent?.make-directories()
write-file-atomically(path, to-json(root), ai-access-perms)

━━━━━━━━━━━━━━━━━━━━
+ AIAccess

+ id String
+ kind AIAccessKind
+ name String
+ sign-in String?
+ variable String?
+ is-granted Bool
+ is-checking = false
+ account AIAccount?
+ problem String?
+ is-asking = false
+ asking String?
+ event keyed String

_ store AIAccessStore
_ found-key String?
_ waiters [SyncBufferedChannel'Bool]

────────────────────
+ This
    - store
    - id
    - kind
    - name
    - sign-in String? = null
    - variable String? = null

found-key = ai-access-variable(variable)
is-granted = if kind == AIAccessKind.approval then store.is-approved(id) else key != null

────────────────────
+ get key String?

store.key(id) ?? (found-key if store.is-approved(id))

────────────────────
+ get has-found-key Bool

found-key != null

────────────────────
+ do check
    - provider AIProvider

=? if is-checking
is-checking = true
problem = null
. found = catch provider.account()
is-checking = false
do match found
    | failure AIError
        account = null
        problem = failure.message
    | known AIAccount
        account = known
    ??
        account = null

────────────────────
+ do approve

. failure = catch store.approve(id)
if failure is Error
    problem = "Your approval could not be saved: ${(failure as Error).message}"
else
    problem = null
    is-granted = true
    if | given String = key
        keyed <- given
    answer(true)

────────────────────
+ do enter
    - text String

. key = text.trim()
=? if !key.length
. failure = catch store.keep-key(id, key)
if failure is Error
    problem = "The key could not be saved: ${(failure as Error).message}"
else
    problem = null
    is-granted = true
    keyed <- key
    answer(true)

────────────────────
+ do ask Bool
    - reason String
    - patience Duration

=? true if is-granted
. waiting = SyncBufferedChannel'Bool()
waiters += waiting
asking = reason
is-asking = true
. timer = patience.loop(=> do waiting <- false)
. granted = (<- waiting) ?? false
timer.cancel()
waiters = List(waiters ?> each as Pointer != waiting as Pointer)
if !waiters
    is-asking = false
= granted && is-granted

────────────────────
+ do decline

answer(false)

────────────────────
_ do answer
    - granted Bool

. waiting = waiters
waiters = List'(SyncBufferedChannel'Bool)()
is-asking = false
for each in waiting
    each <- granted

━━━━━━━━━━━━━━━━━━━━
_ ai-access-variable String?
    - name String?

|? !name
    null
|? value.length > 0
    value
??
    null

.. value = env(name) ?? ""

━━━━━━━━━━━━━━━━━━━━
+ ai-access-can-approve Bool
    - account AIAccount?

account != null && account.status == AIAccountStatus.signed-in && account.billing != AIAccountBilling.api
