/ai
/ai/jev/jev
/net/http
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Jev Response Decoding")
cases.run(jev-response-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do jev-response-tests
    - t TestCase

. jev = Jev("test")
. response-text = "
    {"model":"jev-1.13.0","answers":{"urgent":{"type":"noul","noul":1},"department":{"type":"choice","choice":"billing","probabilities":{"billing":0.88,"technical":0.12},"confidence":0.81},"frustration":{"type":"score","score":1.05,"legend":{"0":"Calm","1":"Frustrated","2":"Very angry"},"probabilities":{"0":0,"1":0.95,"2":0.05},"confidence":0.92}},"usage":{"input_tokens":304,"output_tokens":18}}
. wire-response = HTTPResponse(HTTPStatus.ok, response-text)
. decoded = catch jev.decode(wire-response)
t.check("valid response decoded", decoded is JevResponse)
if decoded is not JevResponse
    = t
. response = decoded as JevResponse

t.expect("model", "jev-1.13.0", response.model)
t.check("Noul variant", response.answers["urgent"] is JevNoulAnswer)
t.expect
    - "integer probability normalized"
    - 1.0
    - (response.answers["urgent"] as JevNoulAnswer).yes-probability
t.check("Choice variant", response.answers["department"] is JevChoiceAnswer)
. choice = response.answers["department"] as JevChoiceAnswer
t.expect("Choice selection", "billing", choice.choice)
t.expect("Choice probability", 0.88, choice.probabilities["billing"]!)
t.check("Score variant", response.answers["frustration"] is JevScoreAnswer)
. score = response.answers["frustration"] as JevScoreAnswer
t.expect("weighted score", 1.05, score.score)
t.expect("Score legend", "Very angry", score.legend["2"]!)
t.expect("input usage", 304, response.usage.input-tokens!)
t.expect("output usage", 18, response.usage.output-tokens!)
= t
