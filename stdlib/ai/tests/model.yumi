/ai/model
/data/json
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("AI Completion Collection")
cases.run(ai-completion-tests)
cases = cases.then("AI Streamed Tool Arguments", ai-tool-argument-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do ai-tool-argument-tests TestCase
    - t TestCase

. reply = AIReply()
reply.apply(AIPartBeginEvent(AIToolCallPart("call", "call-1", "Glob", null)))
reply.apply(AIPartDeltaEvent("call", AIToolArgumentsDelta("{\"pattern\": \"*.yu")))
. call = reply.parts[0] as AIToolCallPart
t.expect("unfinished arguments keep what arrived", "{\"pattern\": \"*.yu", text-of(call.arguments))

reply.apply(AIPartDeltaEvent("call", AIToolArgumentsDelta("mi\"}")))
t.expect("finished arguments are decoded", "*.yumi", pattern-of(call.arguments))
t.check("decoded arguments are no longer text", call.arguments is not String)
= t

━━━━━━━━━━━━━━━━━━━━
_ text-of
    - value JSON

text ?? ""

.. text = match? value
    | String

━━━━━━━━━━━━━━━━━━━━
_ pattern-of
    - value JSON

pattern ?? ""

.. pattern = match? value
    | ["pattern" = found String]
        found

━━━━━━━━━━━━━━━━━━━━
+ do ai-completion-tests TestCase
    - t TestCase

. events = List'AIEvent()
events += AIPartBeginEvent(AITextPart("answer", ""))
events += AIPartDeltaEvent("answer", AITextDelta("Hel"))
events += AIUsageEvent(usage-with-input(2))
events += AIPartDeltaEvent("answer", AITextDelta("lo"))
events += AIPartEndEvent(AITextPart("answer", "Hello"))
events += AIDoneEvent(AIFinishReason.stop, usage-with-output(1, 3))

. provider = ScriptedAIProvider(events)
. response = provider.complete(AIRequest("mock-model"))
t.expect("assembled text", "Hello", ai-response-text(response))
t.expect("merged input usage", 2, response.usage.input-tokens!)
t.expect("merged output usage", 1, response.usage.output-tokens!)
t.expect("final total usage", 3, response.usage.total-tokens!)
t.expect("finish reason", AIFinishReason.stop, response.finish-reason)
= t

━━━━━━━━━━━━━━━━━━━━
_ usage-with-input
    - count Size

AIUsage
    • input-tokens count

━━━━━━━━━━━━━━━━━━━━
_ usage-with-output
    - output Size
    - total Size

AIUsage
    • output-tokens output
    • total-tokens total

━━━━━━━━━━━━━━━━━━━━
+ ScriptedAIProvider is AIProvider

+ events List'AIEvent

────────────────────
+ This
    - events

super()

────────────────────
+ do stream <AIEvent>
    - request AIRequest

for event in events
    <= event
