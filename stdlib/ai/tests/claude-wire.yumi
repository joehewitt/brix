/ai
/ai/claude/wire
/data/json
/data/jsonl
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Claude Wire Text Turn")
cases.run(text-turn-tests)
cases = cases.then("Claude Wire Tool Use", tool-use-tests)
cases = cases.then("Claude Wire Unstreamed And Ignored Lines", passive-line-tests)
cases = cases.then("Claude Wire Turn Failures", failure-tests)
cases = cases.then("Claude Wire Arguments", argument-tests)
cases = cases.then("Claude Wire Prompts", prompt-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
_ do text-turn-tests TestCase
    - t TestCase

t.expect
    - "a streamed turn becomes part events"
    - text-turn-events().trim()
    - summaries(text-turn-lines())
= t

━━━━━━━━━━━━━━━━━━━━
_ do tool-use-tests TestCase
    - t TestCase

t.expect("a tool call streams its arguments", tool-use-events().trim(), summaries(tool-use-lines()))
t.expect
    - "tool results keep their outcome"
    - tool-result-events().trim()
    - summaries(tool-result-lines())
= t

━━━━━━━━━━━━━━━━━━━━
_ do passive-line-tests TestCase
    - t TestCase

t.expect
    - "an unstreamed message is whole"
    - unstreamed-events().trim()
    - summaries(unstreamed-lines())
t.expect("unknown and subagent lines are skipped", "", summaries(ignored-lines()))
t.expect
    - "a block of an unknown kind is skipped with its deltas"
    - unknown-block-events().trim()
    - summaries(unknown-block-lines())
= t

━━━━━━━━━━━━━━━━━━━━
_ do failure-tests TestCase
    - t TestCase

. logged-out = catch summaries(logged-out-lines())
t.check("a logged-out turn fails", logged-out is AIError)
if logged-out is AIError
    . error = logged-out as AIError
    t.expect("the failure is an authentication error", AIErrorKind.authentication, error.kind)
    t.expect
        - "the failure keeps the service message"
        - "Claude Code is not signed in. Run \"claude auth login\" in a terminal, then try again."
        - error.service-message

. strict = ClaudeDecoder()
strict.permission-mode = "auto"
t.expect
    - "a granted permission mode starts the turn"
    - "begin:session:22222222:fast | end:session:22222222:fast"
    - " | ".join(decode-all(strict, permission-line("auto")))
. refused = catch decode-all(strict, permission-line("default"))
t.check("a refused permission mode fails the turn", refused is AIError)
if refused is AIError
    t.expect
        - "the failure names the mode and the model"
        - "Claude Code would not use permission mode \"auto\" with fast; it started in \"default\""
        - (refused as AIError).service-message

. overloaded = catch summaries(overloaded-lines())
t.check("an API failure fails the turn", overloaded is AIError)
if overloaded is AIError
    . error = overloaded as AIError
    t.expect("the status selects the error kind", AIErrorKind.server, error.kind)
    t.expect("the status is kept", 529, error.http-status!)

. unexplained = catch summaries(unexplained-lines())
t.check("a failure without a message fails the turn", unexplained is AIError)
if unexplained is AIError
    . error = unexplained as AIError
    t.expect("an unexplained failure is unknown", AIErrorKind.unknown, error.kind)
    t.expect("the first reported error is the message", "tool crashed", error.service-message)

t.expect
    - "an interrupted turn is cancelled"
    - "done:cancellation:0:0:0"
    - summaries(interrupted-lines())

. decoder = ClaudeDecoder()
. first = catch decode-all(decoder, logged-out-lines())
t.check("the first turn fails", first is AIError)
t.expect
    - "a later turn is unaffected"
    - "done:stop:3:1:0"
    - "\n".join(decode-all(decoder, recovered-lines()))
= t

━━━━━━━━━━━━━━━━━━━━
_ do argument-tests TestCase
    - t TestCase

. plain = "
    --print|--input-format|stream-json|--output-format|stream-json|--verbose|--include-partial-messages
. bare = AIRequest("", [AIMessage(AIMessageRole.user, "hi")])

. messages = List'AIMessage()
messages += AIMessage(AIMessageRole.system, "Be brief")
messages += AIMessage(AIMessageRole.developer, "Answer in French")
messages += AIMessage(AIMessageRole.user, "hi")
. reply = session-reply("11111111-1111-4111-8111-111111111111")
messages += AIMessage(AIMessageRole.assistant, reply)
messages += AIMessage(AIMessageRole.user, "again")
. expected = "
    ${plain}|--safe-mode|--model|haiku|--append-system-prompt|Be brief

    Answer in French|--tools|Read,Grep|--resume|11111111-1111-4111-8111-111111111111|--permission-prompts|none
t.expect
    - "a request becomes flags"
    - expected
    - "|".join(claude-arguments(AIRequest("haiku", messages), ["Read", "Grep"], true))
t.expect
    - "an empty tool list disables tools"
    - "${plain}|--tools||--permission-prompts|none"
    - "|".join(claude-arguments(bare, List'String()))
t.expect
    - "an empty approval list adds nothing"
    - "${plain}|--permission-prompts|none"
    - "|".join(claude-arguments(bare, null, false, List'String()))
= t

━━━━━━━━━━━━━━━━━━━━
_ do prompt-tests TestCase
    - t TestCase

. messages = List'AIMessage()
messages += AIMessage(AIMessageRole.system, "Be brief")
messages += AIMessage(AIMessageRole.user, "one")
t.expect("a new chat sends its prompt", "one" as JSON, claude-prompt(AIRequest("", messages)))

messages += AIMessage(AIMessageRole.assistant, session-reply("first"))
messages += AIMessage(AIMessageRole.user, "two")
messages += AIMessage(AIMessageRole.user, "three")
t.expect
    - "only what the session has not seen is sent"
    - "two\n\nthree" as JSON
    - claude-prompt(AIRequest("", messages))
messages += AIMessage(AIMessageRole.assistant, session-reply("second"))
messages += AIMessage(AIMessageRole.user, "four")
t.expect("the latest session is resumed", "second", claude-session-id(messages) ?? "")
t.expect
    - "the prompt follows the latest session"
    - "four" as JSON
    - claude-prompt(AIRequest("", messages))

messages += AIMessage(AIMessageRole.assistant, "written elsewhere")
messages += AIMessage(AIMessageRole.user, "five")
. foreign = catch claude-prompt(AIRequest("", messages))
t.check("another provider's reply cannot be continued", foreign is AIError)
= t

━━━━━━━━━━━━━━━━━━━━
_ do session-reply [AIMessagePart]
    - id String

. parts = List'AIMessagePart()
parts += AIExtensionPart("session", claude-provider-id, "session", data)
parts += AITextPart("text", "reply")
= parts

.. data = Map'String'JSON
    • "session_id" id

━━━━━━━━━━━━━━━━━━━━
_ summaries String ?! AIError ?! JSONLineError
    - text String

"\n".join(decode-all(ClaudeDecoder(), text))

━━━━━━━━━━━━━━━━━━━━
_ do decode-all [String] ?! AIError ?! JSONLineError
    - decoder ClaudeDecoder
    - text String

. seen = List'String()
for line in text ~> \json-line
    for event in decoder.decode(line)
        seen += summary(event)
= seen

━━━━━━━━━━━━━━━━━━━━
_ summary
    - event AIEvent

match event
    | begin AIPartBeginEvent
        "begin:${part-summary(begin.part)}"
    | delta AIPartDeltaEvent
        "delta:${delta.part-id}:${delta-text(delta.delta)}"
    | end AIPartEndEvent
        "end:${part-summary(end.part)}"
    | done AIDoneEvent
        "done:${finish-summary(done.finish-reason)}:${usage-summary(done.usage!)}"
    ??
        "other"

━━━━━━━━━━━━━━━━━━━━
_ part-summary
    - part AIMessagePart

match part
    | text AITextPart
        "text:${text.id}:${text.text}"
    | reasoning AIReasoningPart
        "reasoning:${reasoning.id}:${reasoning.text}"
    | call AIToolCallPart
        "call:${call.id}:${call.call-id}:${call.tool-name}:${to-json(call.arguments)}"
    | result AIToolResultPart
        "result:${result.id}:$output:${if result.is-error then "failed" else "ok"}"
        .. output = result.text-output ?? "none"
    | extension AIExtensionPart
        "${extension.part-type}:${session-summary(extension.data)}"
    ??
        "other"

━━━━━━━━━━━━━━━━━━━━
_ session-summary
    - data JSON

"${fields["session_id"] as String}:${fields["model"] as String}"

.. fields = data as [String = JSON]

━━━━━━━━━━━━━━━━━━━━
_ delta-text
    - delta AIContentDelta

match delta
    | text AITextDelta
        text.text
    | reasoning AIReasoningDelta
        reasoning.text
    | arguments AIToolArgumentsDelta
        arguments.text
    ??
        "other"

━━━━━━━━━━━━━━━━━━━━
_ finish-summary
    - reason AIFinishReason

match reason
    | {it == AIFinishReason.stop}
        "stop"
    | {it == AIFinishReason.cancellation}
        "cancellation"
    ??
        "other"

━━━━━━━━━━━━━━━━━━━━
_ usage-summary
    - usage AIUsage

"${usage.input-tokens ?? 0}:${usage.output-tokens ?? 0}:${usage.reasoning-tokens ?? 0}"

