(import /ai)

(fn-expr + echo-service _
  (param provider AIProvider)
  (call AIChatService "echo" "Echo" provider "echo-model")
)

(type + EchoProvider (is AIProvider)
  (fn-do + stream (stream AIEvent)
    (param request AIRequest)
    (let count (. request messages length))
    (let reply (if-expr (== count 1) (str count " message") (str count " messages")))
    (yield (call AIPartBeginEvent (call AITextPart "echo" "")))
    (yield (call AIPartDeltaEvent "echo" (call AITextDelta "Echo: ")))
    (yield (call AIPartDeltaEvent "echo" (call AITextDelta reply)))
    (yield (call AIPartEndEvent (call AITextPart "echo" (str "Echo: " reply))))
    (yield (call AIDoneEvent (. AIFinishReason stop) usage))
    (blank)
    (lazy usage
      (call AIUsage
        (block
          (:input-tokens 3)
          (:output-tokens 2)
        )
      )
    )
  )
)

(type + FailingProvider (is AIProvider)
  (fn-do + stream (stream AIEvent)
    (param request AIRequest)
    (yield (call AIPartBeginEvent (call AITextPart "partial" "")))
    (yield (call AIPartDeltaEvent "partial" (call AITextDelta "Partial")))
    (throw (call AIError (. AIErrorKind server) "The service is unavailable" 503))
  )
)

(type + GateProvider (is AIProvider)
  (prop + text String)
  (prop + is-open _ (= false))
  (prop + is-closed _ (= false))
  (prop + gate _ (:= (call (of SyncBufferedChannel Bool))))
  (fn-do + This _
    (param text _)
    (call super)
  )
  (fn-do + stream (stream AIEvent)
    (param request AIRequest)
    (= is-open true)
    (= is-closed false)
    (finally
      (= is-open false)
      (= is-closed true)
    )
    (if (. text length)
      (yield (call AIPartBeginEvent (call AITextPart "gated" "")))
      (yield (call AIPartDeltaEvent "gated" (call AITextDelta text)))
    )
    (<- gate)
    (yield (call AIDoneEvent (. AIFinishReason stop) (call AIUsage)))
  )
)
