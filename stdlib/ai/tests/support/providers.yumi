/ai

━━━━━━━━━━━━━━━━━━━━
+ echo-service
    - provider AIProvider

AIChatService("echo", "Echo", provider, "echo-model")

━━━━━━━━━━━━━━━━━━━━
+ EchoProvider is AIProvider

╌╌╌╌╌╌╌╌╌╌ is AIProvider ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do stream <AIEvent>
    - request AIRequest

. count = request.messages.length
. reply = if count == 1 then "$count message" else "$count messages"
<= AIPartBeginEvent(AITextPart("echo", ""))
<= AIPartDeltaEvent("echo", AITextDelta("Echo: "))
<= AIPartDeltaEvent("echo", AITextDelta(reply))
<= AIPartEndEvent(AITextPart("echo", "Echo: $reply"))
<= AIDoneEvent(AIFinishReason.stop, usage)

.. usage = AIUsage
    • input-tokens 3
    • output-tokens 2

━━━━━━━━━━━━━━━━━━━━
+ FailingProvider is AIProvider

╌╌╌╌╌╌╌╌╌╌ is AIProvider ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do stream <AIEvent>
    - request AIRequest

<= AIPartBeginEvent(AITextPart("partial", ""))
<= AIPartDeltaEvent("partial", AITextDelta("Partial"))
?! AIError(AIErrorKind.server, "The service is unavailable", 503)

━━━━━━━━━━━━━━━━━━━━
+ GateProvider is AIProvider

+ text String
+ is-open = false
+ is-closed = false
+ gate := SyncBufferedChannel'Bool()

────────────────────
+ This
    - text

super()

╌╌╌╌╌╌╌╌╌╌ is AIProvider ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do stream <AIEvent>
    - request AIRequest

is-open = true
is-closed = false
do finally
    is-open = false
    is-closed = true
if text.length
    <= AIPartBeginEvent(AITextPart("gated", ""))
    <= AIPartDeltaEvent("gated", AITextDelta(text))
<- gate
<= AIDoneEvent(AIFinishReason.stop, AIUsage())
