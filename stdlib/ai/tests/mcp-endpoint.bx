(import /ai/mcp)
(import /data/json)
(import /net/fake-network)
(import /net/http)
(import /net/http-server)
(import /net/network)
(import /net/sse)
(import /net/url)
(import /test)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "MCP Handshake"))
  (call (. cases run) handshake-tests)
  (= cases (call (. cases then) "MCP Messages" message-tests))
  (= cases (call (. cases then) "MCP Origins" origin-tests))
  (= cases (call (. cases then) "MCP Tools" tool-tests))
  (= cases (call (. cases then) "MCP Request Headers" header-tests))
  (= cases (call (. cases then) "MCP Progress" progress-tests))
  (return cases)
)

(fn-do + handshake-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call tool-server))
    (call (. server start))
    (let known (call post (call rpc "initialize" "{\"protocolVersion\":\"2025-06-18\"}")))
    (call (. t expect) "initialize keeps a version the server speaks" "\"2025-06-18\"" (call field known "result" "protocolVersion"))
    (call (. t expect) "initialize names the server" "\"notes\"" (call field known "result" "serverInfo" "name"))
    (call (. t expect) "initialize gives the server's instructions" "\"Keeps notes.\"" (call field known "result" "instructions"))
    (let unknown (call post (call rpc "initialize" "{\"protocolVersion\":\"1999-01-01\"}")))
    (call (. t expect) "initialize answers a version it does not speak with its newest handshake version" "\"2025-11-25\"" (call field unknown "result" "protocolVersion"))
    (let refused (call post (call rpc "ping" "{}") (call one-header "MCP-Protocol-Version" "1999-01-01")))
    (call (. t expect) "a handshake under a version header the server does not speak is bad" (. HTTPStatus bad-request) (. refused status))
    (call (. t expect) "the refusal is an unsupported version" "-32022" (call field refused "error" "code"))
    (call (. t expect) "the refusal lists the versions the server speaks" "[\"2025-11-25\", \"2025-06-18\"]" (call field refused "error" "data" "supported"))
    (let missing (call post (call rpc "resources/list" "{}")))
    (call (. t expect) "a method the server does not have is not found" (. HTTPStatus not-found) (. missing status))
    (call (. t expect) "the refusal says the method was not found" "-32601" (call field missing "error" "code"))
    (call (. server close))
  )
  (return t)
)

(fn-do + message-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call tool-server))
    (call (. server start))
    (call (. t expect) "a notification is accepted with no answer" (. HTTPStatus accepted) (=> () (. (call post "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}") status)))
    (let answered (call post "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}"))
    (call (. t expect) "a response from the client is bad" (. HTTPStatus bad-request) (. answered status))
    (call (. t expect) "the refusal says the request is invalid" "-32600" (call field answered "error" "code"))
    (let garbled (call post "{\"jsonrpc\":"))
    (call (. t expect) "a body that is not JSON is bad" (. HTTPStatus bad-request) (. garbled status))
    (call (. t expect) "the refusal is a parse error" "-32700" (call field garbled "error" "code"))
    (call (. server close))
  )
  (return t)
)

(fn-do + origin-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call tool-server))
    (call (. server start))
    (let ping (call rpc "ping" "{}"))
    (let foreign (call post ping (call one-header "Origin" "https://elsewhere.example")))
    (call (. t expect) "a page from an origin the server does not allow is forbidden" (. HTTPStatus forbidden) (. foreign status))
    (call (. t expect) "the refusal says why" "\"Origin not allowed\"" (call field foreign "error" "message"))
    (call (. t expect) "an origin the server allows is served" (. HTTPStatus ok) (=> () (. (call post ping (call one-header "Origin" "https://notes.example")) status)))
    (call (. t expect) "a loopback origin on any port is served" (. HTTPStatus ok) (=> () (. (call post ping (call one-header "Origin" "http://localhost:5173")) status)))
    (call (. t expect) "a request with no origin is served" (. HTTPStatus ok) (=> () (. (call post ping) status)))
    (call (. server close))
  )
  (return t)
)

(fn-do + tool-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call tool-server))
    (call (. server start))
    (let listed (call post (call rpc "tools/list" "{}")))
    (call (. t expect) "tools/list names each tool in order" "\"echo\"" (call field listed "result" "tools" "0" "name"))
    (call (. t expect) "a tool with no schema takes an empty object" "{\"type\": \"object\", \"additionalProperties\": false}" (call field listed "result" "tools" "1" "inputSchema"))
    (let echoed (call post (call rpc "tools/call" "{\"name\":\"echo\",\"arguments\":{\"text\":\"hello\"}}")))
    (call (. t expect) "a tool's text comes back as text content" "\"hello\"" (call field echoed "result" "content" "0" "text"))
    (let unknown (call post (call rpc "tools/call" "{\"name\":\"nothing\"}")))
    (call (. t expect) "a call to a tool the server does not have is answered" (. HTTPStatus ok) (. unknown status))
    (call (. t expect) "the answer says the parameters are invalid" "-32602" (call field unknown "error" "code"))
    (let failed (call post (call rpc "tools/call" "{\"name\":\"fail\"}")))
    (call (. t expect) "a tool that raises gives a result marked as an error" "true" (call field failed "result" "isError"))
    (call (. t expect) "the result says what the tool raised" "\"the tool failed\"" (call field failed "result" "content" "0" "text"))
    (let listed-arguments (call post (call rpc "tools/call" "{\"name\":\"echo\",\"arguments\":[1]}")))
    (call (. t expect) "arguments that are not an object are invalid" "-32602" (call field listed-arguments "error" "code"))
    (call (. server close))
  )
  (return t)
)

(fn-do + header-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call tool-server))
    (call (. server start))
    (let echo (call rpc "tools/call" (str "{\"name\":\"echo\",\"arguments\":{\"text\":\"hi\"}," meta "}")))
    (let served (call post echo (call protocol-headers "tools/call" "echo")))
    (call (. t expect) "a request whose headers repeat its body is served" "\"hi\"" (call field served "result" "content" "0" "text"))
    (let encoded (call post echo (call protocol-headers "tools/call" "=?base64?ZWNobw==?=")))
    (call (. t expect) "a tool name in the header may be written in Base64" "\"hi\"" (call field encoded "result" "content" "0" "text"))
    (let bare (call post echo))
    (call (. t expect) "a request with no version header is bad" (. HTTPStatus bad-request) (. bare status))
    (call (. t expect) "the refusal is a header mismatch" "-32020" (call field bare "error" "code"))
    (call (. t expect) "a method header that differs from the body is a mismatch" "\"Header mismatch: Mcp-Method header 'tools/list' does not match body 'tools/call'\"" (call field (call post echo (call protocol-headers "tools/list" "echo")) "error" "message"))
    (call (. t expect) "a name header that differs from the body is a mismatch" "\"Header mismatch: Mcp-Name header 'fail' does not match body 'echo'\"" (call field (call post echo (call protocol-headers "tools/call" "fail")) "error" "message"))
    (let discovered (call post (call rpc "server/discover" (str "{" meta "}")) (call protocol-headers "server/discover" null)))
    (call (. t expect) "server/discover lists the versions the server speaks after the handshake" "[\"2026-07-28\"]" (call field discovered "result" "supportedVersions"))
    (call (. t expect) "server/discover may be cached by anyone" "\"public\"" (call field discovered "result" "cacheScope"))
    (let initialize (call post (call rpc "initialize" (str "{" meta "}")) (call protocol-headers "initialize" null)))
    (call (. t expect) "initialize is not a method after the handshake" "-32601" (call field initialize "error" "code"))
    (call (. server close))
  )
  (return t)
)

(fn-do + progress-tests TestCase
  (param t TestCase)
  (do-with network (call FakeNetwork)
    (let server (call tool-server))
    (call (. server start))
    (let body (call rpc "tools/call" "{\"name\":\"count\",\"_meta\":{\"progressToken\":\"p1\"}}"))
    (let response (call http-send (call HTTPRequest (. HTTPMethod post) (call URL "http://tools.test/mcp") (call (of List HTTPHeader)) body)))
    (call (. t expect) "a call that asks for progress is answered with events" "text/event-stream" (call (. response header) "Content-Type"))
    (let heard (list String))
    (for (in event (call server-sent-events (. response reader)))
      (+= heard (call event-summary (. event data)))
    )
    (call (. response close))
    (call (. t expect) "progress comes before the result, with the client's token" (list "progress p1 1" "progress p1 2" "result counted to 2") heard)
    (call (. server close))
  )
  (return t)
)

(fn-do + tool-server HTTPServer
  (<> HTTPServer (id: server)
    (= host "tools.test")
    (= port 80)
    (blank)
    (<> MCPEndpoint (text: "/mcp")
      (= name "notes")
      (= instructions "Keeps notes.")
      (= allowed-origins (list "https://notes.example"))
      (blank)
      (<> MCPTool (text: "echo")
        (= call echo-tool)
      )
      (<> MCPTool (text: "fail")
        (= call fail-tool)
      )
      (<> MCPTool (text: "count")
        (= call count-tool)
      )
    )
  )
  (return server)
)

(prop _ meta _ (= "\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}"))

(fn-expr + rpc String
  (param method String)
  (param params String)
  (str "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"" method "\",\"params\":" params "}")
)

(fn-do + post HTTPResponse (?! Error)
  (param body String)
  (param headers (list HTTPHeader) (= (call (of List HTTPHeader))))
  (return (call http-fetch (call HTTPRequest (. HTTPMethod post) (call URL "http://tools.test/mcp") headers body)))
)

(fn-do + one-header (list HTTPHeader)
  (param name String)
  (param value String)
  (let headers (list HTTPHeader))
  (+= headers (tuple name value))
  (return headers)
)

(fn-do + protocol-headers (list HTTPHeader)
  (param method String)
  (param name (? String))
  (let headers (list HTTPHeader))
  (+= headers (tuple "MCP-Protocol-Version" "2026-07-28"))
  (+= headers (tuple "Mcp-Method" method))
  (if name
    (+= headers (tuple "Mcp-Name" name))
  )
  (return headers)
)

(fn-do + field String (?! Error)
  (param response HTTPResponse)
  (param ... path (list String))
  (let value (call parse-json (. response text)))
  (for (in key path)
    (= value (call member value key))
  )
  (return (call to-json value))
)

(fn-do + member JSON
  (param value JSON)
  (param key String)
  (match value
    (case (: fields (map String JSON))
      (return (?? ([] fields key) null))
    )
    (case (: items (list JSON))
      (let index (call Int key))
      (return-if null (if (>= index (. items length))))
      (blank)
      (return ([] items index))
    )
    (default
      (return null)
    )
  )
)

(fn-do + event-summary String (?! Error)
  (param data String)
  (let message (call parse-json data))
  (if (is (call member message "method") String)
    (let params (call member message "params"))
    (return (str "progress " (call text-of (call member params "progressToken")) " " (call text-of (call member params "progress"))))
  )
  (return (str "result " (call text-of (call member (call member (call member (call member message "result") "content") "0") "text"))))
)

(fn-expr + text-of String
  (param value JSON)
  (match value
    (case (: text String)
      text
    )
    (default
      (call to-json value)
    )
  )
)

(fn-do + echo-tool MCPToolResult (?! Error)
  (param call MCPToolCall)
  (return (call (. ([] call "text") string)))
)

(fn-do + fail-tool MCPToolResult (?! Error)
  (param call MCPToolCall)
  (throw (call Error "the tool failed"))
)

(fn-do + count-tool MCPToolResult (?! Error)
  (param call MCPToolCall)
  (call (. call progress) 1.0 2.0)
  (call (. call progress) 2.0 2.0)
  (return "counted to 2")
)
