/time/timer

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Claude Provider Turns")
cases.run(turn-tests)
cases = cases.then("Claude Provider Tool Turn", tool-tests)
cases = cases.then("Claude Provider Launch", launch-tests)
cases = cases.then("Claude Provider Abandoned Stream", abandon-tests)
cases = cases.then("Claude Provider Stopped Chat", stop-tests)
cases = cases.then("Claude Provider Background Work", background-tests)
cases = cases.then("Claude Provider Stop During Background Work", background-stop-tests)
cases = cases.then("Claude Provider Report Taken Mid-Turn", absorbed-tests)
cases = cases.then("Claude Provider Failures", failure-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
_ do turn-tests TestCase
    - t TestCase

. fake = FakeClaude()
do finally fake.remove()
. claude = fake.provider()
. session = AIChatSession(AIChat("turns"), AIChatService("claude", "Claude", claude, ""))

session.ask("hello")
. first = session.messages[1]
t.expect("a new chat starts a new session", "hello back resumed=no", ai-parts-text(first.parts))
await-idle(claude)
t.expect("a finished turn without background work leaves no process", 0, claude.running)

session.ask("hello")
t.expect
    - "a later turn resumes the session"
    - "hello back resumed=yes"
    - ai-parts-text(session.messages[3].parts)
= t

━━━━━━━━━━━━━━━━━━━━
_ do tool-tests TestCase
    - t TestCase

. fake = FakeClaude()
do finally fake.remove()
. claude = fake.provider()
. session = AIChatSession(AIChat("tools"), AIChatService("claude", "Claude", claude, ""))

session.ask("browse")
. reply = session.messages[1]
t.check("a tool turn finishes without an error", reply.error == null)
t.expect("a tool turn keeps its parts in order", "extension, call, result, text", part-kinds(reply))
= t

━━━━━━━━━━━━━━━━━━━━
_ do launch-tests TestCase
    - t TestCase

. fake = FakeClaude()
do finally fake.remove()
. claude = fake.provider()
claude.working-directory = "/usr"
claude.tools = ["Read", "Grep"]
claude.is-safe-mode = true
claude.allowed-tools = ["Read"]
claude.permission-mode = "acceptEdits"

. messages = List'AIMessage()
messages += AIMessage(AIMessageRole.system, "Be brief")
messages += AIMessage(AIMessageRole.user, "report")
. request = AIRequest("haiku", messages)
. flags = claude-arguments(request, claude.tools, true, claude.allowed-tools, "acceptEdits")
. arguments = " ".join(flags)
t.expect
    - "the process gets its flags, directory and environment"
    - "$arguments /usr unset unset"
    - ai-response-text(complete(claude, request))
= t

━━━━━━━━━━━━━━━━━━━━
_ do abandon-tests TestCase
    - t TestCase

. fake = FakeClaude()
do finally fake.remove()
. claude = fake.provider()

. seen = List'String()
for event in claude.stream(AIRequest("", [AIMessage(AIMessageRole.user, "slow")]))
    if event is AIPartDeltaEvent
        seen += "delta"
        t.expect("a turn in flight has a process", 1, claude.running)
        break
t.expect("the stream delivered its first text", "delta", ", ".join(seen))
await-idle(claude)
t.expect("leaving a stream interrupts its turn and lets the idle process end", 0, claude.running)
= t

━━━━━━━━━━━━━━━━━━━━
_ do stop-tests TestCase
    - t TestCase

. fake = FakeClaude()
do finally fake.remove()
. claude = fake.provider()
. session = AIChatSession(AIChat("stopped"), AIChatService("claude", "Claude", claude, ""))

session.send("slow")
await-text(session, 1)
session.stop()
await-idle(claude)

session.ask("hello")
t.expect
    - "the next turn resumes the stopped session"
    - "hello back resumed=yes"
    - ai-parts-text(session.messages[3].parts)
= t

━━━━━━━━━━━━━━━━━━━━
_ do background-tests TestCase
    - t TestCase

. fake = FakeClaude()
do finally fake.remove()
. claude = fake.provider()
. session = AIChatSession(AIChat("background"), AIChatService("claude", "Claude", claude, ""))

session.ask("spawn")
t.check("a reply ends while its background agent runs", !session.is-busy)
t.expect("the process outlives the reply", 1, claude.running)

session.ask("hello")
t.expect
    - "a prompt during background work reuses the process"
    - "hello back resumed=no"
    - ai-parts-text(session.messages[3].parts)

await-replies(session, 5)
t.check
    - "the agent's result arrives without a prompt"
    - session.messages[4].role == AIMessageRole.assistant
t.expect
    - "the agent's result is its own reply"
    - "agent finished"
    - ai-parts-text(session.messages[4].parts)
await-idle(claude)
t.expect("the process ends once its agent is done", 0, claude.running)
= t

━━━━━━━━━━━━━━━━━━━━
_ do background-stop-tests TestCase
    - t TestCase

. fake = FakeClaude()
do finally fake.remove()
. claude = fake.provider()
. session = AIChatSession(AIChat("background-stop"), AIChatService("claude", "Claude", claude, ""))

session.ask("spawn")
session.send("slow")
await-text(session, 3)
session.stop()
t.check
    - "the stopped reply is cancelled"
    - session.messages[3].finish-reason == AIFinishReason.cancellation

await-replies(session, 5)
t.expect
    - "the agent survives the stop and reports"
    - "agent finished"
    - ai-parts-text(session.messages[4].parts)
await-idle(claude)
t.expect("the process ends once its agent is done", 0, claude.running)
= t

━━━━━━━━━━━━━━━━━━━━
_ do absorbed-tests TestCase
    - t TestCase

. fake = FakeClaude()
do finally fake.remove()
. claude = fake.provider()
. session = AIChatSession(AIChat("absorbed"), AIChatService("claude", "Claude", claude, ""))

session.ask("absorb")
t.expect
    - "a reply takes in its agent's report"
    - "absorbed"
    - ai-parts-text(session.messages[1].parts)
await-idle(claude)
t.expect("the process ends once a reply took its agent's report in", 0, claude.running)
= t

━━━━━━━━━━━━━━━━━━━━
_ do failure-tests TestCase
    - t TestCase

. fake = FakeClaude()
do finally fake.remove()
. claude = fake.provider()

. crash = catch complete(claude, AIRequest("", [AIMessage(AIMessageRole.user, "crash")]))
t.check("a turn fails when the process exits", crash is AIError)
if crash is AIError
    t.expect
        - "the failure carries the error output"
        - "fake failure"
        - (crash as AIError).service-message

. garbage = catch complete(claude, AIRequest("", [AIMessage(AIMessageRole.user, "garbage")]))
t.check("output that is not JSON fails the turn", garbage is AIError)

await-idle(claude)
t.expect("failed turns leave no process", 0, claude.running)
= t

━━━━━━━━━━━━━━━━━━━━
_ do await-idle
    - claude ClaudeCode

. deadline = Deadline(5s)
while !deadline.has-passed && claude.running
    1ms.wait()

━━━━━━━━━━━━━━━━━━━━
_ do await-replies
    - session AIChatSession
    - count Size

. deadline = Deadline(5s)
while !deadline.has-passed && (session.messages.length < count || session.is-busy)
    1ms.wait()

━━━━━━━━━━━━━━━━━━━━
_ do await-text
    - session AIChatSession
    - index Index

. deadline = Deadline(5s)
while !deadline.has-passed && (session.messages.length <= index || !ai-parts-text(session.messages[index].parts).length)
    1ms.wait()

━━━━━━━━━━━━━━━━━━━━
_ part-kinds
    - message AIChatMessage

", ".join(part-kind(each) in message.parts)

━━━━━━━━━━━━━━━━━━━━
_ part-kind
    - part AIMessagePart

match part
    | AITextPart
        "text"
    | AIExtensionPart
        "extension"
    | AIToolCallPart
        "call"
    | AIToolResultPart
        "result"
    ??
        "other"

━━━━━━━━━━━━━━━━━━━━
_ FakeClaude

+ directory String
+ program String

────────────────────
_ This

directory = "/tmp/yumi-claude-${monotonic-time-nanoseconds()}"
program = "$directory/claude"
Path(directory).make-directory()
. flags = FileFlags.write-mode + FileFlags.create-mode + FileFlags.truncate-mode
. script = File'Byte(program, flags, user-rwx-perm)
script.write(fake-claude-script())
script.close()

────────────────────
+ do provider

. claude = ClaudeCode()
claude.executable = program
= claude

────────────────────
+ do remove

Path(program).delete()
Path(directory).delete()

━━━━━━━━━━━━━━━━━━━━
_ ¶ fake-claude-script

#!/bin/sh
session=sess-1
resumed=no
previous=
for argument in "\$@"; do
  if [ "\$previous" = "--resume" ]; then
    session=\$argument
    resumed=yes
  fi
  previous=\$argument
done
say() { printf '%s\\n' "\$1"; }
begin() { printf '{"type":"system","subtype":"init","session_id":"%s","model":"fake-model"}\\n' "\$session"; }
text() {
  printf '{"type":"assistant","message":{"id":"msg_1","content":[{"type":"text","text":"%s"}]},"parent_tool_use_id":null}\\n' "\$1"
}
finish() { say '{"type":"result","subtype":"success","is_error":false,"stop_reason":"end_turn","total_cost_usd":0,"usage":{"input_tokens":1,"output_tokens":1}}'; }
while IFS= read -r line; do
  case "\$line" in
    *'"initialize"'*) say '{"type":"control_response","response":{"subtype":"success","request_id":"yumi-1","response":{}}}' ;;
    *'"interrupt"'*)
      say '{"type":"control_response","response":{"subtype":"success","request_id":"yumi-2","response":{}}}'
      say '{"type":"result","subtype":"error_during_execution","is_error":true,"terminal_reason":"aborted_streaming","usage":{"input_tokens":1,"output_tokens":1}}' ;;
    *hello*) begin; text "hello back resumed=\$resumed"; finish ;;
    *spawn*)
      begin
      text "started"
      say '{"type":"system","subtype":"task_started","task_id":"t1","description":"agent","is_backgrounded":true}'
      finish
      ( sleep 0.5
        say '{"type":"system","subtype":"task_notification","task_id":"t1","status":"completed","output_file":"","summary":"done"}'
        begin
        text "agent finished"
        finish ) & ;;
    *absorb*)
      begin
      say '{"type":"system","subtype":"task_started","task_id":"t2","description":"agent","is_backgrounded":true}'
      say '{"type":"system","subtype":"task_notification","task_id":"t2","status":"completed","output_file":"","summary":"done"}'
      say '{"type":"system","subtype":"status","status":"requesting"}'
      text "absorbed"
      finish ;;
    *report*) begin; text "\$* \$(pwd) \${CLAUDECODE-unset} \${ANTHROPIC_API_KEY-unset}"; finish ;;
    *slow*)
      begin
      say '{"type":"stream_event","event":{"type":"message_start","message":{"id":"msg_slow"}},"parent_tool_use_id":null}'
      say '{"type":"stream_event","event":{"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}},"parent_tool_use_id":null}'
      say '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"1"}},"parent_tool_use_id":null}' ;;
    *browse*)
      begin
      say '{"type":"stream_event","event":{"type":"message_start","message":{"id":"msg_tool"}},"parent_tool_use_id":null}'
      say '{"type":"stream_event","event":{"type":"content_block_start","index":0,"content_block":{"type":"tool_use","id":"toolu_1","name":"Glob","input":{}}},"parent_tool_use_id":null}'
      say '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"input_json_delta","partial_json":""}},"parent_tool_use_id":null}'
      say '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"input_json_delta","partial_json":"{\\"pattern\\": \\"*.yu"}},"parent_tool_use_id":null}'
      say '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"input_json_delta","partial_json":"mi\\"}"}},"parent_tool_use_id":null}'
      say '{"type":"assistant","message":{"id":"msg_tool","content":[{"type":"tool_use","id":"toolu_1","name":"Glob","input":{"pattern":"*.yumi"}}]},"parent_tool_use_id":null}'
      say '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_1","content":[{"type":"text","text":"main.yumi\\napp.yumi"}]}]},"parent_tool_use_id":null}'
      say '{"type":"stream_event","event":{"type":"message_start","message":{"id":"msg_answer"}},"parent_tool_use_id":null}'
      say '{"type":"stream_event","event":{"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}},"parent_tool_use_id":null}'
      say '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Two files."}},"parent_tool_use_id":null}'
      say '{"type":"assistant","message":{"id":"msg_answer","content":[{"type":"text","text":"Two files."}]},"parent_tool_use_id":null}'
      finish ;;
    *crash*) echo 'fake failure' >&2; exit 3 ;;
    *garbage*) say 'not json' ;;
  esac
done
wait
