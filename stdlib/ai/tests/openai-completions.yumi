data: {"id":"chat-2","choices":[{"delta":{"web_search":{"id":"search-1","query":"brix ai"}},"finish_reason":null}],"usage":null}

data: {"id":"chat-2","choices":[{"delta":{"audio":{"id":"audio-1","data":"Zm9v","transcript":"foo"}},"finish_reason":"stop"}],"usage":null}

data: {"id":"chat-2","choices":[],"usage":{"prompt_tokens":1,"completion_tokens":0,"total_tokens":1}}

data: [DONE]${"\n\n"}

━━━━━━━━━━━━━━━━━━━━
_ OpenAIStreamProvider is AIProvider

+ source ReadableData'Byte

────────────────────
_ This
    - source

super()

────────────────────
+ do stream <AIEvent>
    - request AIRequest

for event in openai-stream-events(source)
    <= event

━━━━━━━━━━━━━━━━━━━━
_ FragmentedAIStream
    is ReadableData'Byte

+ data Byte[]
+ max-read Size
+ cursor Index

────────────────────
_ This
    - data
    - max-read

────────────────────
+ get is-encoded

false

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

. remaining = data.size - cursor
. wanted = if size < max-read then size else max-read
. amount = if remaining < wanted then remaining else wanted
if amount
    buffer[0 .. < amount] = data[cursor .. < cursor + amount]
    cursor += amount
= amount
