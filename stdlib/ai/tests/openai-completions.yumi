/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("OpenAI Transcript Encoding")
cases.run(openai-transcript-tests)
cases = cases.then("OpenAI Fragmented Stream", openai-stream-tests)
cases = cases.then("OpenAI Search And Media", openai-search-media-tests)
cases = cases.then("OpenAI Invalid Stream", openai-invalid-stream-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do openai-transcript-tests TestCase
    - t TestCase

. reply [AIMessagePart]
reply += AIReasoningPart("thought", "considering")
reply += AITextPart("text", "It is sunny.")
reply += AIToolCallPart("ran", "call-1", "Read", JSON("{}"))
reply += AIToolResultPart("ran:result", "call-1", "contents")
reply += AIToolCallPart("asked", "call-2", "weather", JSON("{}"))
reply += AIExtensionPart("session", "elsewhere", "session", JSON("{}"))
. marker [AIMessagePart]
marker += AIExtensionPart("session", "elsewhere", "session", JSON("{}"))

. messages [AIMessage]
messages += AIMessage(AIMessageRole.user, "weather")
messages += AIMessage(AIMessageRole.assistant, reply)
messages += AIMessage(AIMessageRole.assistant, marker)
messages += AIMessage(AIMessageRole.user, "and tomorrow?")
. root = openai-request-value(AIRequest("gpt-test", messages)) as [String = JSON]
. sent = root["messages"] as [JSON]

t.expect("a reply with nothing to send is left out", 3, sent.length)
. answer = sent[1] as [String = JSON]
t.expect("a reply keeps its text", "It is sunny.", answer["content"] as String)
. calls = answer["tool_calls"] as [JSON]
t.expect("a call the provider already answered is left out", 1, calls.length)
t.expect("an open call is sent", "call-2", (calls[0] as [String = JSON])["id"] as String)
t.check("another provider's data is left out", answer["session"] == null)
= t

━━━━━━━━━━━━━━━━━━━━
+ do openai-stream-tests TestCase
    - t TestCase

. source = FragmentedAIStream(openai-tool-sse(), 3)
. lines = collect-event-summaries(source)

. expected = "
    begin:text
    delta:Hel
    delta:lo
    begin:tool
    delta:{"x":
    delta:1}
    usage:2
    end:text:1
    end:tool:weather:{"x": 1}
    done:tool-calls:3
t.expect("fragmented SSE event lifecycle", expected, "\n".join(lines))

. null-source = DataStream'Byte(openai-null-tool-sse())
. null-lines = collect-event-summaries(null-source)
t.expect("JSON null tool arguments remain valid", true, has-line(null-lines, "end:tool:none:null"))
= t

━━━━━━━━━━━━━━━━━━━━
+ do openai-search-media-tests TestCase
    - t TestCase

. source = DataStream'Byte(openai-search-audio-sse())
. lines = collect-event-summaries(source)

t.expect("search is observed without inference", true, has-line(lines, "end:search:brix ai"))
t.expect("audio part completes", true, has-line(lines, "end:audio:foo"))
t.expect("stream completes", "done:stop:1", lines.tail)
= t

━━━━━━━━━━━━━━━━━━━━
+ do openai-invalid-stream-tests TestCase
    - t TestCase

. source-text = "
    data: {"id":"chat-3","choices":[{"delta":{"content":"unfinished"},"finish_reason":null}]}${"\n\n"}
. source = DataStream'Byte(source-text)
. provider = OpenAIStreamProvider(source)
. result = catch complete(provider, AIRequest("mock"))
t.check("missing terminal marker is invalid", result is AIError)
if result is AIError
    . error = result as AIError
    t.expect("missing terminal marker kind", AIErrorKind.invalid-response, error.kind)
= t

━━━━━━━━━━━━━━━━━━━━
_ do has-line
    - lines [String]
    - expected String

for line in lines
    if line == expected
        = true
= false

━━━━━━━━━━━━━━━━━━━━
_ do collect-event-summaries ?! AIError
    - source ReadableData'Byte

. lines [String]
for event in openai-stream-events(source)
    lines += ai-event-summary(event)
= lines

━━━━━━━━━━━━━━━━━━━━
_ ai-event-summary
    - event AIEvent

match event
    | begin AIPartBeginEvent
        "begin:${ai-part-kind(begin.part)}"
    | delta AIPartDeltaEvent
        ai-delta-summary(delta.delta)
    | usage AIUsageEvent
        "usage:${usage.usage.input-tokens ?? 0}"
    | end AIPartEndEvent
        ai-part-end-summary(end.part)
    | done AIDoneEvent
        "done:${finish-summary(done.finish-reason)}:${done.usage?.total-tokens ?? 0}"
    ??
        "other"

━━━━━━━━━━━━━━━━━━━━
_ ai-delta-summary
    - delta AIContentDelta

match delta
    | text AITextDelta
        "delta:${text.text}"
    | arguments AIToolArgumentsDelta
        "delta:${arguments.text}"
    | audio AIAudioDelta
        "audio-delta:${audio.data.size}"
    ??
        "other"

━━━━━━━━━━━━━━━━━━━━
_ ai-part-end-summary
    - part AIMessagePart

match part
    | text AITextPart
        "end:text:${text.citations.length}"
    | tool AIToolCallPart
        "end:tool:${tool.tool-name}:${to-json(tool.arguments)}"
    | search AIWebSearchPart
        "end:search:${search.query}"
    | audio AIAudioPart
        "end:audio:${audio.audio.transcript ?? ""}"
    ??
        "other"

━━━━━━━━━━━━━━━━━━━━
_ ai-part-kind
    - part AIMessagePart

match part
    | AITextPart
        "text"
    | AIToolCallPart
        "tool"
    | AIWebSearchPart
        "search"
    | AIAudioPart
        "audio"
    ??
        "other"

━━━━━━━━━━━━━━━━━━━━
_ finish-summary
    - reason AIFinishReason

match reason
    | {it == AIFinishReason.stop}
        "stop"
    | {it == AIFinishReason.tool-calls}
        "tool-calls"
    ??
        "other"

━━━━━━━━━━━━━━━━━━━━
_ " openai-tool-sse

data: {"id":"chat-1","choices":[{"delta":{"role":"assistant"},"finish_reason":null}],"usage":null}

