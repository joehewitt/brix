(import ./support/providers)
(import /ai)
(import /data/sqlite)
(import /math)
(import /math/fake-random)
(import /os/file)
(import /os/path)
(import /test)
(import /time/duration)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "AI Chat Branching"))
  (call (. cases run) branching-tests)
  (= cases (call (. cases then) "AI Chat Archive Round Trip" round-trip-tests))
  (= cases (call (. cases then) "AI Chat Archive Unsettled Turns" unsettled-turn-tests))
  (= cases (call (. cases then) "AI Chat Archive Damaged Files" damaged-file-tests))
  (= cases (call (. cases then) "AI Chat Ids" chat-id-tests))
  (return cases)
)

(fn-do + branching-tests TestCase
  (param t TestCase)
  (let chat (call AIChat "chat-1"))
  (= chat (call append-chat-message chat "root" (call message "m1" (. AIMessageRole user) "hello")))
  (= chat (call append-chat-message chat "root" (call message "m2" (. AIMessageRole assistant) "first reply")))
  (= chat (call branch-chat-at chat "root" "m1" "alternate"))
  (= chat (call append-chat-message chat "root" (call message "m3" (. AIMessageRole user) "parent only")))
  (= chat (call append-chat-message chat "alternate" (call message "m4" (. AIMessageRole assistant) "child only")))
  (blank)
  (call (. t expect) "parent transcript" "m1, m2, m3" (call message-ids (call chat-transcript chat "root")))
  (call (. t expect) "child transcript" "m1, m4" (call message-ids (call chat-transcript chat "alternate")))
  (return t)
)

(fn-do + chat-id-tests TestCase
  (param t TestCase)
  (let first "")
  (let second "")
  (do-with random (call FakeRandom)
    (= first (call ai-chat-id))
    (= second (call ai-chat-id))
  )
  (let again "")
  (do-with random (call FakeRandom)
    (= again (call ai-chat-id))
  )
  (call (. t expect) "a seeded fake makes the same first id each time" first again)
  (call (. t expect) "ids drawn in one binding differ" true (!= first second))
  (call (. t expect) "an id is chat- and sixteen hex digits" 21 (. first length))
  (return t)
)

(fn-do + round-trip-tests TestCase
  (param t TestCase)
  (let directory (call fresh-archive-directory "round-trip"))
  (finally
    (inline (call clean-archive-directory directory))
  )
  (let store (call AIChatStore (call test-services) (call AIChatDatabase directory)))
  (call (. t check) "an unused store writes nothing" (not (. directory exists)))
  (blank)
  (let first (. store active))
  (call (. first ask) "What is a monad?")
  (call (. t check) "a turn saves the chat list" (. (/ directory "chats.db") exists))
  (call (. t check) "a turn saves the chat" (call (. (call AIChatDatabase directory) has) (. first chat id)))
  (blank)
  (let second (call (. store new-session)))
  (call (. second document choose) ([] (. store services) 1))
  (call (. second ask) "Second chat")
  (blank)
  (let reopened (call AIChatStore (call test-services) (call AIChatDatabase directory)))
  (call (. t expect)
    (block
      (arg "saved chats keep their ids")
      (arg (str (. second chat id) ", " (. first chat id)))
      (arg (str (. ([] (. reopened sessions) 1) chat id) ", " (. ([] (. reopened sessions) 2) chat id)))
    )
  )
  (call (. t expect)
    (block
      (arg "saved chats keep their services, and a fresh chat takes the newest one")
      (arg "failing, failing, echo")
      (arg (call (. ", " join) (in (. each service id) (. reopened sessions))))
    )
  )
  (let restored ([] (. reopened sessions) 2))
  (call (. t check) "a saved chat waits to be opened" (and (not (. restored is-loaded)) (== (. restored messages length) 0)))
  (call (. reopened select) restored)
  (call (. t check) "selecting a saved chat opens it" (and (== (. reopened active) restored) (. restored is-loaded)))
  (call (. t expect) "the reply returns" "Echo: 1 message" (call text-of ([] (. restored messages) 1)))
  (blank)
  (call (. restored ask) "And a functor?")
  (call (. t expect)
    (block
      (arg "a reopened chat continues its ids")
      (arg (str (. first chat id) ":1, " (. first chat id) ":2, " (. first chat id) ":3, " (. first chat id) ":4"))
      (arg (call message-ids (. restored messages)))
    )
  )
  (let again (call AIChatStore (call test-services) (call AIChatDatabase directory)))
  (call (. again select) ([] (. again sessions) 2))
  (call (. t expect) "later turns are saved" 4 (. again active messages length))
  (blank)
  (let narrowed (call AIChatStore (list (call echo-service (call EchoProvider))) (call AIChatDatabase directory)))
  (let orphan ([] (. narrowed sessions) 1))
  (call (. t expect) "a fresh chat takes a service the store offers" "echo" (. narrowed active service id))
  (call (. narrowed select) orphan)
  (call (. orphan ask) "Hello again")
  (call (. t expect)
    (block
      (arg "a chat whose service is gone says so")
      (arg "This chat began with failing, which is not set up here")
      (arg (. (!! (. ([] (. orphan messages) 3) error)) service-message))
    )
  )
  (return t)
)

(fn-do + unsettled-turn-tests TestCase
  (param t TestCase)
  (let directory (call fresh-archive-directory "unsettled"))
  (finally
    (inline (call clean-archive-directory directory))
  )
  (let store (call AIChatStore (list (call echo-service (call GateProvider "Half a rep"))) (call AIChatDatabase directory)))
  (let session (. store active))
  (call (. session send) "Are you there?")
  (for (in attempt (..< 0 2000))
    (if (not (. (call text-of ([] (. session messages) 1)) length))
      (call (. 1ms wait))
    )
  )
  (blank)
  (let interrupted (call AIChatStore (call test-services) (call AIChatDatabase directory)))
  (call (. interrupted select) ([] (. interrupted sessions) 1))
  (call (. t expect)
    (block
      (arg "an interrupted turn keeps its reply so far")
      (arg "Half a rep")
      (arg (call text-of ([] (. interrupted active messages) 1)))
    )
  )
  (call (. t check)
    (block
      (arg "an interrupted reply reopens as stopped")
      (arg (== (. ([] (. interrupted active messages) 1) finish-reason) (. AIFinishReason cancellation)))
    )
  )
  (call (. t check) "an interrupted turn is not left running" (not (. interrupted active is-busy)))
  (blank)
  (call (. session stop))
  (let stopped (call AIChatStore (call test-services) (call AIChatDatabase directory)))
  (call (. stopped select) ([] (. stopped sessions) 1))
  (call (. t expect) "a stopped reply keeps its text" "Half a rep" (call text-of ([] (. stopped active messages) 1)))
  (blank)
  (let unused (call (. store new-session)))
  (let listed (call AIChatStore (call test-services) (call AIChatDatabase directory)))
  (call (. t expect) "unused chats stay out of the list" 2 (. listed sessions length))
  (call (. t check) "unused chats are not saved" (not (call (. (call AIChatDatabase directory) has) (. unused chat id))))
  (return t)
)

(fn-do + damaged-file-tests TestCase
  (param t TestCase)
  (let directory (call fresh-archive-directory "damaged"))
  (finally
    (inline (call clean-archive-directory directory))
  )
  (let store (call AIChatStore (call test-services) (call AIChatDatabase directory)))
  (call (. store active ask) "Keep me")
  (let kept (. store active chat id))
  (let database-path (/ directory "chats.db"))
  (blank)
  (call alter database-path (str "update parts set kind = 'broken-' || kind where chat = '" kept "'"))
  (let broken (call AIChatStore (call test-services) (call AIChatDatabase directory)))
  (let fresh (. broken active))
  (call (. broken select) ([] (. broken sessions) 1))
  (call (. t check) "a damaged chat stays closed" (and (== (. broken active) fresh) (not (. ([] (. broken sessions) 1) is-loaded))))
  (call (. t check) "a damaged chat reports why" (!= (. broken error) null))
  (call alter database-path (str "update parts set kind = substr(kind, 8) where chat = '" kept "'"))
  (call (. broken select) ([] (. broken sessions) 1))
  (call (. t check) "a repaired chat opens" (and (== (. broken active) ([] (. broken sessions) 1)) (== (. broken error) null)))
  (blank)
  (call alter database-path "pragma user_version = 9")
  (let newer (call AIChatStore (call test-services) (call AIChatDatabase directory)))
  (call (. t check) "an unsupported chat list reports why" (!= (. newer error) null))
  (blank)
  (call write-text database-path "not a database")
  (let detached (call AIChatStore (call test-services) (call AIChatDatabase directory)))
  (call (. t check) "a damaged chat list reports why" (!= (. detached error) null))
  (call (. t expect) "a damaged chat list leaves one fresh chat" 1 (. detached sessions length))
  (call (. detached active ask) "Unsaved")
  (call (. t expect) "a damaged chat list is left alone" "not a database" (call read-text database-path))
  (return t)
)

(fn-expr _ test-services (list AIChatService)
  (item (call echo-service (call EchoProvider)))
  (item (call AIChatService "failing" "Failing" (call FailingProvider) "echo-model"))
)

(fn-expr _ message _
  (param id String)
  (param role AIMessageRole)
  (param text String)
  (call AIChatMessage id role text "2026-08-21T00:00:00Z")
)

(fn-expr _ message-ids _
  (param messages (list AIChatMessage))
  (call (. ", " join) (in (. each id) messages))
)

(fn-do _ fresh-archive-directory _
  (param name String)
  (let directory (call Path (str "/tmp/ai-chat-archive-" name "-" (. (call Task) id)) 0))
  (call clean-archive-directory directory)
  (return directory)
)

(fn-do _ clean-archive-directory _
  (param directory Path)
  (return-if (if (not (. directory exists))))
  (blank)
  (for (in child (. directory contents))
    (call (. child delete))
  )
  (call (. directory delete))
)

(fn-do _ read-text _
  (param path Path)
  (let file (use (call File path)))
  (let text (as file String))
  (return text)
)

(fn-do _ alter _
  (param path Path)
  (param sql String)
  (let database (use (call SQLite (str path))))
  (call (. database execute-script) sql)
)

(fn-do _ write-text _
  (param path Path)
  (param text String)
  (let file (call File path (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode))))
  (do-use file
    (call (. file write) text)
  )
)

(fn-expr _ text-of _
  (param message AIChatMessage)
  (call ai-parts-text (. message parts))
)
