(import /ai)
(import /ai/claude/wire)
(import /data/json)
(import /data/jsonl)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Claude Wire Text Turn"))
  (call (. cases run) text-turn-tests)
  (= cases (call (. cases then) "Claude Wire Tool Use" tool-use-tests))
  (= cases (call (. cases then) "Claude Wire Unstreamed And Ignored Lines" passive-line-tests))
  (= cases (call (. cases then) "Claude Wire Turn Failures" failure-tests))
  (= cases (call (. cases then) "Claude Wire Arguments" argument-tests))
  (= cases (call (. cases then) "Claude Wire Prompts" prompt-tests))
  (return cases)
)

(fn-do _ text-turn-tests TestCase
  (param t TestCase)
  (call (. t expect)
    (block
      (arg "a streamed turn becomes part events")
      (arg (call (. (call text-turn-events) trim)))
      (arg (call summaries (call text-turn-lines)))
    )
  )
  (return t)
)

(fn-do _ tool-use-tests TestCase
  (param t TestCase)
  (call (. t expect) "a tool call streams its arguments" (call (. (call tool-use-events) trim)) (call summaries (call tool-use-lines)))
  (call (. t expect)
    (block
      (arg "tool results keep their outcome")
      (arg (call (. (call tool-result-events) trim)))
      (arg (call summaries (call tool-result-lines)))
    )
  )
  (return t)
)

(fn-do _ passive-line-tests TestCase
  (param t TestCase)
  (call (. t expect)
    (block
      (arg "an unstreamed message is whole")
      (arg (call (. (call unstreamed-events) trim)))
      (arg (call summaries (call unstreamed-lines)))
    )
  )
  (call (. t expect) "unknown and subagent lines are skipped" "" (call summaries (call ignored-lines)))
  (call (. t expect)
    (block
      (arg "a block of an unknown kind is skipped with its deltas")
      (arg (call (. (call unknown-block-events) trim)))
      (arg (call summaries (call unknown-block-lines)))
    )
  )
  (return t)
)

(fn-do _ failure-tests TestCase
  (param t TestCase)
  (let logged-out (catch (call summaries (call logged-out-lines))))
  (call (. t check) "a logged-out turn fails" (is logged-out AIError))
  (if (is logged-out AIError)
    (let error (as logged-out AIError))
    (call (. t expect) "the failure is an authentication error" (. AIErrorKind authentication) (. error kind))
    (call (. t expect)
      (block
        (arg "the failure keeps the service message")
        (arg "Claude Code is not signed in. Run \"claude auth login\" in a terminal, then try again.")
        (arg (. error service-message))
      )
    )
  )
  (blank)
  (let strict (call ClaudeDecoder))
  (= (. strict permission-mode) "auto")
  (call (. t expect)
    (block
      (arg "a granted permission mode starts the turn")
      (arg "begin:session:22222222:fast | end:session:22222222:fast")
      (arg (call (. " | " join) (call decode-all strict (call permission-line "auto"))))
    )
  )
  (let refused (catch (call decode-all strict (call permission-line "default"))))
  (call (. t check) "a refused permission mode fails the turn" (is refused AIError))
  (if (is refused AIError)
    (call (. t expect)
      (block
        (arg "the failure names the mode and the model")
        (arg "Claude Code would not use permission mode \"auto\" with fast; it started in \"default\"")
        (arg (. (as refused AIError) service-message))
      )
    )
  )
  (blank)
  (let overloaded (catch (call summaries (call overloaded-lines))))
  (call (. t check) "an API failure fails the turn" (is overloaded AIError))
  (if (is overloaded AIError)
    (let error (as overloaded AIError))
    (call (. t expect) "the status selects the error kind" (. AIErrorKind server) (. error kind))
    (call (. t expect) "the status is kept" 529 (!! (. error http-status)))
  )
  (blank)
  (let unexplained (catch (call summaries (call unexplained-lines))))
  (call (. t check) "a failure without a message fails the turn" (is unexplained AIError))
  (if (is unexplained AIError)
    (let error (as unexplained AIError))
    (call (. t expect) "an unexplained failure is unknown" (. AIErrorKind unknown) (. error kind))
    (call (. t expect) "the first reported error is the message" "tool crashed" (. error service-message))
  )
  (blank)
  (call (. t expect)
    (block
      (arg "an interrupted turn is cancelled")
      (arg "done:cancellation:0:0:0")
      (arg (call summaries (call interrupted-lines)))
    )
  )
  (blank)
  (let decoder (call ClaudeDecoder))
  (let first (catch (call decode-all decoder (call logged-out-lines))))
  (call (. t check) "the first turn fails" (is first AIError))
  (call (. t expect)
    (block
      (arg "a later turn is unaffected")
      (arg "done:stop:3:1:0")
      (arg (call (. "\n" join) (call decode-all decoder (call recovered-lines))))
    )
  )
  (return t)
)

(fn-do _ argument-tests TestCase
  (param t TestCase)
  (let plain
    (paragraph
      "--print|--input-format|stream-json|--output-format|stream-json|--verbose|--include-partial-messages"
    )
  )
  (let bare (call AIRequest "" (list (call AIMessage (. AIMessageRole user) "hi"))))
  (blank)
  (let messages (call (of List AIMessage)))
  (+= messages (call AIMessage (. AIMessageRole system) "Be brief"))
  (+= messages (call AIMessage (. AIMessageRole developer) "Answer in French"))
  (+= messages (call AIMessage (. AIMessageRole user) "hi"))
  (let reply (call session-reply "11111111-1111-4111-8111-111111111111"))
  (+= messages (call AIMessage (. AIMessageRole assistant) reply))
  (+= messages (call AIMessage (. AIMessageRole user) "again"))
  (let expected
    (paragraph
      (str plain "|--safe-mode|--model|haiku|--append-system-prompt|Be brief")
      (blank)
      "Answer in French|--tools|Read,Grep|--resume|11111111-1111-4111-8111-111111111111|--permission-prompts|none"
    )
  )
  (call (. t expect)
    (block
      (arg "a request becomes flags")
      (arg expected)
      (arg (call (. "|" join) (call claude-arguments (call AIRequest "haiku" messages) (list "Read" "Grep") true)))
    )
  )
  (call (. t expect)
    (block
      (arg "an empty tool list disables tools")
      (arg (str plain "|--tools||--permission-prompts|none"))
      (arg (call (. "|" join) (call claude-arguments bare (call (of List String)))))
    )
  )
  (call (. t expect)
    (block
      (arg "an empty approval list adds nothing")
      (arg (str plain "|--permission-prompts|none"))
      (arg (call (. "|" join) (call claude-arguments bare null false (call (of List String)))))
    )
  )
  (return t)
)

(fn-do _ prompt-tests TestCase
  (param t TestCase)
  (let messages (call (of List AIMessage)))
  (+= messages (call AIMessage (. AIMessageRole system) "Be brief"))
  (+= messages (call AIMessage (. AIMessageRole user) "one"))
  (call (. t expect) "a new chat sends its prompt" (as "one" JSON) (call claude-prompt (call AIRequest "" messages)))
  (blank)
  (+= messages (call AIMessage (. AIMessageRole assistant) (call session-reply "first")))
  (+= messages (call AIMessage (. AIMessageRole user) "two"))
  (+= messages (call AIMessage (. AIMessageRole user) "three"))
  (call (. t expect)
    (block
      (arg "only what the session has not seen is sent")
      (arg (as "two\n\nthree" JSON))
      (arg (call claude-prompt (call AIRequest "" messages)))
    )
  )
  (+= messages (call AIMessage (. AIMessageRole assistant) (call session-reply "second")))
  (+= messages (call AIMessage (. AIMessageRole user) "four"))
  (call (. t expect) "the latest session is resumed" "second" (?? (call claude-session-id messages) ""))
  (call (. t expect)
    (block
      (arg "the prompt follows the latest session")
      (arg (as "four" JSON))
      (arg (call claude-prompt (call AIRequest "" messages)))
    )
  )
  (blank)
  (+= messages (call AIMessage (. AIMessageRole assistant) "written elsewhere"))
  (+= messages (call AIMessage (. AIMessageRole user) "five"))
  (let foreign (catch (call claude-prompt (call AIRequest "" messages))))
  (call (. t check) "another provider's reply cannot be continued" (is foreign AIError))
  (return t)
)

(fn-do _ session-reply (list AIMessagePart)
  (param id String)
  (let parts (call (of List AIMessagePart)))
  (+= parts (call AIExtensionPart "session" claude-provider-id "session" data))
  (+= parts (call AITextPart "text" "reply"))
  (return parts)
  (blank)
  (lazy data
    (call (of Map String JSON)
      (block
        (entry "session_id" id)
      )
    )
  )
)

(fn-expr _ summaries String (?! AIError) (?! JSONLineError)
  (param text String)
  (call (. "\n" join) (call decode-all (call ClaudeDecoder) text))
)

(fn-do _ decode-all (list String) (?! AIError) (?! JSONLineError)
  (param decoder ClaudeDecoder)
  (param text String)
  (let seen (call (of List String)))
  (for (in line (~> text \json-line))
    (for (in event (call (. decoder decode) line))
      (+= seen (call summary event))
    )
  )
  (return seen)
)

(fn-expr _ summary _
  (param event AIEvent)
  (match event
    (case (: begin AIPartBeginEvent)
      (str "begin:" (call part-summary (. begin part)))
    )
    (case (: delta AIPartDeltaEvent)
      (str "delta:" (. delta part-id) ":" (call delta-text (. delta delta)))
    )
    (case (: end AIPartEndEvent)
      (str "end:" (call part-summary (. end part)))
    )
    (case (: done AIDoneEvent)
      (str "done:" (call finish-summary (. done finish-reason)) ":" (call usage-summary (!! (. done usage))))
    )
    (default
      "other"
    )
  )
)

(fn-expr _ part-summary _
  (param part AIMessagePart)
  (match part
    (case (: text AITextPart)
      (str "text:" (. text id) ":" (. text text))
    )
    (case (: reasoning AIReasoningPart)
      (str "reasoning:" (. reasoning id) ":" (. reasoning text))
    )
    (case (: call AIToolCallPart)
      (str "call:" (. call id) ":" (. call call-id) ":" (. call tool-name) ":" (call to-json (. call arguments)))
    )
    (case (: result AIToolResultPart)
      (str "result:" (. result id) ":" output ":" (if-expr (. result is-error) "failed" "ok"))
      (lazy output (?? (. result text-output) "none"))
    )
    (case (: extension AIExtensionPart)
      (str (. extension part-type) ":" (call session-summary (. extension data)))
    )
    (default
      "other"
    )
  )
)

(fn-expr _ session-summary _
  (param data JSON)
  (str (as ([] fields "session_id") String) ":" (as ([] fields "model") String))
  (where
    (lazy fields (as data (map String JSON)))
  )
)

(fn-expr _ delta-text _
  (param delta AIContentDelta)
  (match delta
    (case (: text AITextDelta)
      (. text text)
    )
    (case (: reasoning AIReasoningDelta)
      (. reasoning text)
    )
    (case (: arguments AIToolArgumentsDelta)
      (. arguments text)
    )
    (default
      "other"
    )
  )
)

(fn-expr _ finish-summary _
  (param reason AIFinishReason)
  (match reason
    (case ({} (== it (. AIFinishReason stop)))
      "stop"
    )
    (case ({} (== it (. AIFinishReason cancellation)))
      "cancellation"
    )
    (default
      "other"
    )
  )
)

(fn-expr _ usage-summary _
  (param usage AIUsage)
  (str (?? (. usage input-tokens) 0) ":" (?? (. usage output-tokens) 0) ":" (?? (. usage reasoning-tokens) 0))
)

