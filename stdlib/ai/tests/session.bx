(import ./support/providers)
(import /ai)
(import /data/json)
(import /test)
(import /time/duration)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "AI Chat Session Turns"))
  (call (. cases run) session-turn-tests)
  (= cases (call (. cases then) "AI Chat Session Failure" session-failure-tests))
  (= cases (call (. cases then) "AI Chat Session Stop" session-stop-tests))
  (= cases (call (. cases then) "AI Chat Session Early Stop" session-early-stop-tests))
  (= cases (call (. cases then) "AI Chat Session Manual Turns" session-manual-tests))
  (return cases)
)

(fn-do + session-turn-tests TestCase
  (param t TestCase)
  (let session (call AIChatSession (call AIChat "one") (call echo-service (call EchoProvider))))
  (call (. session ask) "  What is a monad?\nBe brief.  ")
  (call (. t expect) "the first prompt titles the session" "What is a monad?" (?? (. session title) ""))
  (blank)
  (call (. session ask) "And a functor?")
  (call (. t expect) "a later turn sees the transcript" "Echo: 3 messages" (call text-of ([] (. session messages) 3)))
  (return t)
)

(fn-do + session-failure-tests TestCase
  (param t TestCase)
  (let session (call AIChatSession (call AIChat "three") (call echo-service (call FailingProvider))))
  (call (. session ask) "Hello")
  (call (. t expect) "the chat keeps a failed reply" 2 (. (call chat-transcript (. session chat) "root") length))
  (blank)
  (let resumed (call AIChatSession (call AIChat "three") (call echo-service (call EchoProvider))))
  (call (. resumed document restore) (. session chat))
  (call (. resumed ask) "Still there?")
  (call (. t expect)
    (block
      (arg "a failed reply stays out of the request")
      (arg "Echo: 2 messages")
      (arg (call text-of ([] (. resumed messages) 3)))
    )
  )
  (return t)
)

(fn-do + session-stop-tests TestCase
  (param t TestCase)
  (let provider (call GateProvider "Half a rep"))
  (let session (call AIChatSession (call AIChat "four") (call echo-service provider)))
  (call (. session send) "Are you there?")
  (call (. t expect)
    (block
      (arg "the chat holds only the prompt during a turn")
      (arg 1)
      (arg (. (call chat-transcript (. session chat) "root") length))
    )
  )
  (blank)
  (call await-text session)
  (call (. t expect) "deltas reach the waiting reply" "Half a rep" (call text-of ([] (. session messages) 1)))
  (call (. session stop))
  (call (. t check) "stopping ends the provider's stream" (. provider is-closed))
  (call (. t expect) "a stopped reply keeps its text" "Half a rep" (call text-of ([] (. session messages) 1)))
  (call (. t expect)
    (block
      (arg "a stopped reply records why it ended")
      (arg (. AIFinishReason cancellation))
      (arg (!! (. ([] (. session messages) 1) finish-reason)))
    )
  )
  (blank)
  (let resumed (call AIChatSession (call AIChat "four") (call echo-service (call EchoProvider))))
  (call (. resumed document restore) (. session chat))
  (call (. resumed ask) "Go on")
  (call (. t expect) "a stopped reply joins the request" "Echo: 3 messages" (call text-of ([] (. resumed messages) 3)))
  (return t)
)

(fn-do + session-early-stop-tests TestCase
  (param t TestCase)
  (let provider (call GateProvider ""))
  (let session (call AIChatSession (call AIChat "five") (call echo-service provider)))
  (call (. session send) "One more")
  (call (. session stop))
  (call (. t expect) "an empty stopped reply is dropped" 1 (. session messages length))
  (blank)
  (call (. session send) "And again")
  (call await-start provider)
  (call (. session stop))
  (call (. t expect) "a reply stopped before any content is dropped" 2 (. session messages length))
  (call (. t expect)
    (block
      (arg "a dropped reply's id is not used again")
      (arg "five:1, five:3")
      (arg (call (. ", " join) (in (. each id) (. session messages))))
    )
  )
  (call (. t check) "its stream is ended" (. provider is-closed))
  (return t)
)

(fn-do + session-manual-tests TestCase
  (param t TestCase)
  (let session (call AIChatSession (call AIChat "six") (call echo-service (call AIProvider))))
  (call (. session begin-turn) "Count")
  (blank)
  (let waiting (. (!! (. session reply)) parts))
  (call (. session apply-event) (call AIPartBeginEvent (call AITextPart "count" "")))
  (call (. session apply-event) (call AIPartDeltaEvent "count" (call AITextDelta "One")))
  (call (. session apply-event) (call AIPartDeltaEvent "count" (call AITextDelta ", two")))
  (call (. session apply-event) (call AIPartEndEvent (call AITextPart "count" "One, two.")))
  (call (. t check)
    (block
      (arg "the reply keeps one part list while it streams")
      (arg (== (as (. (!! (. session reply)) parts) Pointer) (as waiting Pointer)))
    )
  )
  (call (. session apply-event) (call AIDoneEvent (. AIFinishReason length) usage))
  (call (. session finish-reply))
  (call (. t expect)
    (block
      (arg "a finished reply keeps the reason its stream gave")
      (arg (. AIFinishReason length))
      (arg (!! (. ([] (. session messages) 1) finish-reason)))
    )
  )
  (blank)
  (call (. session begin-turn) "Again")
  (call (. session apply-event) (call AIPartBeginEvent (call AITextPart "again" "Three")))
  (call (. session fail-reply) (call AIError (. AIErrorKind timeout) "Offline"))
  (blank)
  (call (. session begin-turn) "Once more")
  (call (. session finish-reply))
  (blank)
  (call (. session begin-turn) "And once more")
  (call (. session apply-event) (call AIPartBeginEvent (call AIExtensionPart "note" "echo" "note" null)))
  (call (. session finish-reply) (. AIFinishReason cancellation))
  (call (. t expect) "a reply holding only provider notes is dropped" 6 (. session messages length))
  (return t)
  (blank)
  (lazy usage
    (call AIUsage
      (block
        (:input-tokens 4)
        (:output-tokens 5)
      )
    )
  )
)

(fn-do _ await-text _
  (param session AIChatSession)
  (for (in attempt (..< 0 2000))
    (if (not (. (call text-of ([] (. session messages) 1)) length))
      (call (. 1ms wait))
    )
  )
)

(fn-do _ await-start _
  (param provider GateProvider)
  (for (in attempt (..< 0 2000))
    (if (not (. provider is-open))
      (call (. 1ms wait))
    )
  )
)

(fn-expr _ text-of _
  (param message AIChatMessage)
  (call ai-parts-text (. message parts))
)
