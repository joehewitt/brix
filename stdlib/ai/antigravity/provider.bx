(import ./tool-host)
(import ./tools)
(import ./wire)
(import /ai/model)
(import /core/arena)
(import /data/json)
(import /data/jsonl)
(import /data/jsonrpc)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)
(import /stream/aggregate)
(blank)
(prop + antigravity-default-model _ (= "gemini-4-neon"))
(prop + antigravity-default-effort _ (= "xhigh"))

(type + AntigravityVariables (is (fn-type (? (map String String)))))

(type + Antigravity (is AIProvider)
  (prop + executable (? String))
  (prop + working-directory (? String))
  (prop + permission-mode (? String))
  (prop + effort (? String))
  (prop + is-persistent Bool)
  (prop + variables (? AntigravityVariables))
  (prop + mcp-servers (list AntigravityMCPServer))
  (prop + toolkits (list AIToolkit))
  (prop + running Size)
  (blank)
  (prop _ links (list AntigravityLink))
  (fn-do + This _
    (param executable (? String) (= null))
    (param working-directory (? String) (= null))
    (param permission-mode (? String) (= null))
    (param effort (? String) (= null))
    (param is-persistent _ (= true))
    (param variables (? AntigravityVariables) (= null))
    (param mcp-servers _ (= (call (of List AntigravityMCPServer))))
    (param toolkits _ (= (call (of List AIToolkit))))
    (call super)
  )
  (fn-do + account (? AIAccount) (?! AIError)
    (throw (call AIError (. AIErrorKind unknown) (str "Antigravity did not report its account: " failure)) (on-error (: failure Error)))
    (blank)
    (let base (only-if (call variables) (if variables)))
    (let program (?? executable (call antigravity-executable (call antigravity-search-directories base))))
    (return-if (call AIAccount (. AIAccountStatus missing)) (if (not program)))
    (blank)
    (let process
      (call Process
        (block
          (arg program)
          (arg (. ProcessStderr discard))
          (arg (list "acp" "--stdio"))
          (arg working-directory)
          (arg (call antigravity-environment base))
        )
      )
    )
    (finally
      (inline (call antigravity-ended process))
    )
    (return (call antigravity-account-status process))
  )
  (fn-expr + tool-title (? String)
    (param call AIToolCallPart)
    (call antigravity-tool-title call)
  )
  (fn-expr + tool-kind AIToolKind
    (param call AIToolCallPart)
    (call antigravity-tool-kind call)
  )
  (fn-expr + tool-input (? String)
    (param call AIToolCallPart)
    (call antigravity-tool-input call)
  )
  (fn-do + stop-work _ (?! AIError)
    (param parts (list AIMessagePart))
    (let link (call linked (call antigravity-parts-session parts)))
    (return-if (if (not link)))
    (blank)
    (call (. link halt))
  )
  (fn-do + stream (stream AIEvent)
    (param request AIRequest)
    (let turn (use (call begin-turn request)))
    (for (in event (. turn events))
      (yield event)
    )
    (throw (. turn failure) (if (. turn failure)))
  )
  (fn-do _ begin-turn AntigravityTurn (?! AIError)
    (param request AIRequest)
    (let plan (call antigravity-resume request))
    (let replays (or (. plan forks) (. plan is-merged)))
    (let blocks (call antigravity-prompt-blocks (if-expr toolkits (call ai-toolkit-request toolkits request) request) replays))
    (let directory (?? working-directory (call cwd)))
    (let instructions (call antigravity-instructions request))
    (let servers (call antigravity-mcp-servers-for mcp-servers (. request chat-id)))
    (let settings-key
      (call to-json
        (call (of Map String JSON)
          (block
            (:cwd directory)
            (:model (. request model))
            (:effort? effort)
            (:mode? permission-mode)
            (:instructions? instructions)
            (:servers (call (of List JSON) (in (as (. each json) JSON) servers)))
          )
        )
      )
    )
    (let live (call reusable plan settings-key))
    (return-if (call (. live ask) blocks request) (if live))
    (blank)
    (let base (only-if (call variables) (if variables)))
    (let program (?? executable (call antigravity-executable (call antigravity-search-directories base))))
    (throw (call AIError (. AIErrorKind unknown) "Antigravity is not installed") (if (not program)))
    (blank)
    (let process (call antigravity-process program directory base permission-mode))
    (let resume-session (only-if (. (. plan point) session) (if (and (. plan point) (not replays)))))
    (let origin (only-if (. plan point) (if (not (. plan is-merged)))))
    (let host (only-if (call AntigravityToolHost toolkits) (if (> (. toolkits length) 0))))
    (if host
      (catch (call (. host start)))
    )
    (let link
      (call AntigravityLink
        (block
          (arg this)
          (arg process)
          (arg settings-key)
          (arg directory)
          (arg instructions)
          (arg resume-session)
          (arg origin)
          (arg host)
        )
      )
    )
    (+= links link)
    (+= running 1)
    (return (call (. link ask) blocks request))
  )
  (fn-do _ reusable (? AntigravityLink)
    (param plan AntigravityResume)
    (param key String)
    (let point (. plan point))
    (return-if null (if (or (not point) (. plan forks) (. plan is-merged))))
    (blank)
    (for (in link links)
      (return-if link (if (and (== (. link session) (. point session)) (== (. link settings) key) (not (. link is-closing)))))
    )
    (return null)
  )
  (fn-do _ linked (? AntigravityLink)
    (param session (? String))
    (let found (? AntigravityLink))
    (for (in link links)
      (if (and (!= session null) (== (. link session) session) (or (not found) (not (. link is-closing))))
        (= found link)
      )
    )
    (return found)
  )
  (fn-do _ forget _
    (param link AntigravityLink)
    (let index (. links length))
    (while (> index 0)
      (-= index 1)
      (if (== (as ([] links index) Pointer) (as link Pointer))
        (call (. links remove) index)
        (-= running 1)
      )
    )
  )
)

(fn-do + antigravity-executable (? String)
  (param directories (list String))
  (for (in name (list "agy" "antigravity"))
    (for (in directory directories)
      (let candidate (str directory "/" name))
      (return-if candidate (if (. (call Path candidate 0) is-file)))
    )
  )
  (return (call antigravity-bundled-executable))
)

(fn-expr + antigravity-search-directories (list String)
  (param variables (? (map String String)) (= null))
  (spread (call (. (?? ([] (?? variables (call environment)) "PATH") "") split) ":"))
  (item? (only-if (str home "/.local/bin") (if home)))
  (item? (only-if (str home "/.antigravity/bin") (if home)))
  (item "/opt/homebrew/bin")
  (item "/usr/local/bin")
  (pipe |> List)
  (where
    (lazy home (call env "HOME"))
  )
)

(fn-expr + antigravity-environment (map String String)
  (param variables (? (map String String)) (= null))
  (spread (?? variables (call environment)))
  (pipe *> (tuple ([] each 0) ([] each 1)))
  (pipe |> Map)
)

(fn-do _ antigravity-bundled-executable (? String)
  (let home (call env "HOME"))
  (return-if null (if (not home)))
  (blank)
  (let base (str home "/.t3/tools/antigravity-acp"))
  (for (in arch (list "darwin-arm64" "darwin-x64"))
    (let active-path (call Path (str base "/" arch "/active.json") 0))
    (if (. active-path is-file)
      (let text (catch? (call read-file-text active-path)))
      (let parsed (only-if (catch? (call parse-json text)) (if text)))
      (let release (call json-string (?[] (call json-object parsed) "releaseId")))
      (if (and release (> (. release length) 0))
        (let binary (str base "/" arch "/versions/" release "/antigravity"))
        (return-if binary (if (. (call Path binary 0) is-file)))
      )
    )
  )
  (return null)
)

(type _ AntigravityLink
  (prop + settings String)
  (prop + is-closing _ (= false))
  (blank)
  (prop _ provider Antigravity)
  (prop _ process Process)
  (prop _ directory String)
  (prop _ instructions (? String))
  (prop _ resume-id (? String))
  (prop _ host (? AntigravityToolHost))
  (prop _ decoder _ (:= (call AntigravityDecoder)))
  (prop _ errors _ (:= (call (of Semaphore String))))
  (prop _ turn (? AntigravityTurn))
  (prop _ queued (list AntigravityTurn))
  (prop _ answers (map String (of SyncBufferedChannel JSONRPCOutcome)))
  (prop _ requests Size)
  (prop _ is-initialized _ (= false))
  (prop _ is-interrupting _ (= false))
  (prop _ has-exited _ (= false))
  (fn-do + This _
    (param owner Antigravity)
    (param child Process)
    (param settings _)
    (param directory _)
    (param instructions _)
    (param resume-id (? String) (= null))
    (param origin (? AntigravityPoint) (= null))
    (param host (? AntigravityToolHost) (= null))
    (lazy provider owner)
    (lazy process child)
    (= (. decoder parent) origin)
    (do-new
      (call drain)
    )
    (do-new
      (call run)
    )
  )
  (fn-expr + session _ :get
    (. decoder session)
  )
  (fn-do + ask AntigravityTurn
    (param blocks (list JSON))
    (param request AIRequest)
    (let asked (call AntigravityTurn this blocks request))
    (if turn
      (+= queued asked)
      (else
        (call start asked)
      )
    )
    (return asked)
  )
  (fn-do + halt _
    (for (in waiting queued)
      (call (. waiting settle) null)
    )
    (call (. queued clear))
    (if turn
      (call interrupt)
      (else
        (call release)
      )
    )
  )
  (fn-do + leave _
    (param left AntigravityTurn)
    (if (and turn (== (as turn Pointer) (as left Pointer)))
      (call interrupt)
      (else
        (= queued (call List (?> queued (!= (as each Pointer) (as left Pointer)))))
        (call (. left settle) null)
      )
    )
  )
  (fn-do _ start _
    (param next AntigravityTurn)
    (= turn next)
    (= is-interrupting false)
    (do-new
      (call begin next)
    )
  )
  (fn-do _ begin _
    (param next AntigravityTurn)
    (if host
      (= (. host active-request) (. next request))
    )
    (call open-session (. next request)
      (block
        (on-error (: failure AIError)
          (call fail next failure)
          (return)
        )
      )
    )
    (if is-interrupting
      (call end-turn)
      (return)
    )
    (let params (call antigravity-prompt-params (?? (. decoder session) "") (. next blocks)))
    (let result
      (call request "session/prompt" params
        (block
          (on-error (: failure AIError)
            (call fail next failure)
            (return)
          )
        )
      )
    )
    (return-if (if (or (not turn) (!= (as turn Pointer) (as next Pointer)))))
    (blank)
    (for (in event (call (. decoder finish) result))
      (do
        (inline (call (?. turn deliver) event))
      )
    )
    (call end-turn)
  )
  (fn-do _ session-servers (list AntigravityMCPServer)
    (param chat-id (? String))
    (let servers (call antigravity-mcp-servers-for (. provider mcp-servers) chat-id))
    (if (and host (. host is-running))
      (+= servers (. host server))
    )
    (return servers)
  )
  (fn-do _ open-session _ (?! AIError)
    (param asked AIRequest)
    (return-if (if (!= (. decoder session) null)))
    (blank)
    (if (not is-initialized)
      (let ignored (call request "initialize" (call antigravity-initialize-params)))
      (= is-initialized true)
    )
    (let servers (call session-servers (. asked chat-id)))
    (let result (? (map String JSON)))
    (let id (? String))
    (if resume-id
      (let resumed (call json-object (call request "session/resume" (call antigravity-resume-session-params resume-id directory servers))))
      (= result resumed)
      (= id (?? (call json-string (?[] resumed "sessionId")) resume-id))
      (= resume-id null)
      (else
        (let created (call json-object (call request "session/new" (call antigravity-new-session-params directory servers instructions))))
        (= result created)
        (= id (call json-string (?[] created "sessionId")))
      )
    )
    (throw (call AIError (. AIErrorKind invalid-response) "Antigravity did not open a session") (if (not id)))
    (blank)
    (call apply-config id result (. asked model) (. provider effort))
    (for (in event (call (. decoder open) id (. asked model)))
      (do
        (inline (call (?. turn deliver) event))
      )
    )
  )
  (fn-do _ apply-config _
    (param session-id String)
    (param result (? (map String JSON)))
    (param model String)
    (param effort (? String))
    (if (> (. model length) 0)
      (let model-opt (call antigravity-config-option result "model" "model"))
      (let current (call json-string (?[] model-opt "currentValue")))
      (let config-id (?? (call json-string (?[] model-opt "id")) "model"))
      (if (and (!= current model) (or (not model-opt) (call antigravity-config-supports model-opt model)))
        (let ignored (catch? (call request "session/set_config_option" (call antigravity-config-params session-id config-id model))))
      )
    )
    (if (and effort (> (. effort length) 0))
      (let effort-opt (call antigravity-config-option result "thought_level" "thought_level"))
      (if effort-opt
        (let current (call json-string ([] effort-opt "currentValue")))
        (let config-id (?? (call json-string ([] effort-opt "id")) "thought_level"))
        (if (and (!= current effort) (call antigravity-config-supports effort-opt effort))
          (let ignored (catch? (call request "session/set_config_option" (call antigravity-config-params session-id config-id effort))))
        )
      )
    )
  )
  (fn-do _ request JSON (?! AIError)
    (param method String)
    (param params JSON)
    (throw (call AIError (. AIErrorKind unknown) (str "Antigravity stopped before it could " method)) (if has-exited))
    (blank)
    (let id (call request-id))
    (let waiting (call (of SyncBufferedChannel JSONRPCOutcome)))
    (= ([] answers id) waiting)
    (call send (call to-json (. (call JSONRPCRequest id method params) json)))
    (let outcome (<- waiting))
    (-= ([] answers id))
    (throw (call AIError (. AIErrorKind unknown) (str "Antigravity stopped before it answered " method)) (if (not outcome)))
    (blank)
    (match outcome
      (case (call .result value)
        (return value)
      )
      (case (call .error error)
        (throw (call antigravity-rpc-error method error))
      )
    )
  )
  (fn-do _ fail _
    (param next AntigravityTurn)
    (param failure AIError)
    (call (. next settle) failure)
    (if (and turn (== (as turn Pointer) (as next Pointer)))
      (call end-turn)
    )
  )
  (fn-do _ interrupt _
    (let session (. decoder session))
    (= is-interrupting true)
    (return-if (if (not session)))
    (blank)
    (call send (call to-json (. (call JSONRPCNotification "session/cancel" (call antigravity-cancel-params session)) json)))
  )
  (fn-do _ run _
    (let problem (? String))
    (call listen
      (block
        (on-error (: failure Error)
          (= problem (str failure))
        )
      )
    )
    (if problem
      (call (. process terminate))
    )
    (let status (call (. process wait) null))
    (let output (?? (call (. errors await)) ""))
    (call (. process close))
    (if host
      (call (. host close))
    )
    (call (. provider forget) this)
    (= is-closing true)
    (= has-exited true)
    (for (in (tuple _ waiting) answers)
      (call (. waiting close))
    )
    (= answers (call (of Map String (of SyncBufferedChannel JSONRPCOutcome))))
    (let failure (call AIError (. AIErrorKind unknown) (?? problem (call antigravity-exit-reason (?? status 0) (call (. output trim))))))
    (do
      (inline (call (?. turn settle) failure))
    )
    (= turn null)
    (for (in waiting queued)
      (call (. waiting settle) failure)
    )
    (call (. queued clear))
  )
  (fn-do _ drain _
    (let text (as (!! (. process stderr)) String))
    (call (. errors post) text)
  )
  (fn-do _ listen _ (?! JSONLineError) (?! IOError)
    (let scratch (use (call Arena)))
    (for (in line (~> process \json-line (with (call JSONParser scratch))))
      (call hear line)
    )
  )
  (fn-do _ hear _
    (param line JSON)
    (let message (catch? (call json-rpc-message line false)))
    (return-if (if (not message)))
    (blank)
    (match message
      (case (: response JSONRPCResponse)
        (call answer response)
      )
      (case (: asked JSONRPCRequest)
        (call reply asked)
      )
      (case (: notice JSONRPCNotification)
        (call deliver notice)
      )
    )
  )
  (fn-do _ answer _
    (param response JSONRPCResponse)
    (let key (call antigravity-response-key response))
    (let waiting (only-if ([] answers key) (if key)))
    (return-if (if (not waiting)))
    (blank)
    (<- waiting (. response outcome))
    (call (. waiting close))
  )
  (fn-do _ reply _
    (param asked JSONRPCRequest)
    (if (== (. asked method) "session/request_permission")
      (let allows (!= (. provider permission-mode) "read-only"))
      (let answer (call antigravity-permission-answer (. asked params) allows))
      (call send (call to-json (. (call (. asked response) answer) json)))
      (return)
    )
    (let refusal (call JSONRPCError .method-not-found (str "Brix does not answer " (. asked method))))
    (call send (call to-json (. (call (. asked error-response) refusal) json)))
  )
  (fn-do _ deliver _
    (param notice JSONRPCNotification)
    (call emit notice
      (block
        (on-error (: failure AIError)
          (do
            (inline (call (?. turn settle) failure))
          )
        )
      )
    )
  )
  (fn-do _ emit _ (?! AIError)
    (param notice JSONRPCNotification)
    (for (in event (call (. decoder decode) (. notice method) (. notice params)))
      (do
        (inline (call (?. turn deliver) event))
      )
      (if host
        (if (= (| (: ended AIPartEndEvent)) event)
          (if (= (| (: call AIToolCallPart)) (. ended part))
            (let outcome (call (. host take) (. call tool-name)))
            (if (and outcome (. outcome result))
              (for (in extra (call ai-toolkit-parts call (. outcome result)))
                (if (is (. extra part) AIImagePart)
                  (call (?. turn deliver) extra)
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ end-turn _
    (let ended turn)
    (= turn null)
    (= is-interrupting false)
    (do
      (inline (call (?. ended settle) null))
    )
    (call (. decoder end-turn))
    (if (. queued length)
      (let next ([] queued 0))
      (call (. queued remove) 0)
      (call start next)
      (else
        (call release)
      )
    )
  )
  (fn-do _ release _
    (return-if (if (or is-closing turn (. queued length))))
    (blank)
    (= is-closing true)
    (catch (call (. process close-input)))
  )
  (fn-do _ send _
    (param line String)
    (catch (call (. process write) (str line "\n")))
  )
  (fn-do _ request-id String
    (+= requests 1)
    (return (str "brix-" requests))
  )
)

(type _ AntigravityTurn
  (prop + events _ (:= (call (of SyncBufferedChannel AIEvent))))
  (prop + failure (? AIError))
  (prop + blocks (list JSON))
  (prop + request AIRequest)
  (prop + is-settled _ (= false))
  (blank)
  (prop _ link AntigravityLink)
  (prop _ is-abandoned _ (= false))
  (fn-do + This _
    (param link _)
    (param blocks _)
    (param request _)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call abandon)
  )
  (fn-do + abandon _
    (return-if (if is-settled))
    (blank)
    (= is-abandoned true)
    (call (. link leave) this)
  )
  (fn-do + deliver _
    (param event AIEvent)
    (return-if (if (or is-abandoned is-settled)))
    (blank)
    (<- events event)
  )
  (fn-do + settle _
    (param problem (? AIError))
    (return-if (if is-settled))
    (blank)
    (= is-settled true)
    (= failure problem)
    (if (not is-abandoned)
      (call (. events close))
    )
  )
)

(fn-do _ antigravity-process Process (?! AIError)
  (param program String)
  (param directory (? String))
  (param base (? (map String String)))
  (param permission-mode (? String))
  (throw (call AIError (. AIErrorKind invalid-request) (str "Antigravity can't run in " directory " because it no longer exists")) (if (and directory (not (. (call Path directory 0) is-dir)))))
  (throw (call AIError (. AIErrorKind unknown) (str "Antigravity did not start: " failure)) (on-error (: failure Error)))
  (let args (list "acp" "--stdio"))
  (if (or (== permission-mode "auto") (== permission-mode "bypass") (== permission-mode "full-access"))
    (+= args "--dangerously-skip-permissions")
    (else-if (== permission-mode "read-only")
      (+= args "--sandbox")
    )
  )
  (return (call Process program (. ProcessStderr capture) args directory (call antigravity-environment base)))
)

(fn-do _ antigravity-account-status AIAccount (?! Error)
  (param process Process)
  (let init-id "brix-initialize")
  (let list-id "brix-account")
  (call (. process write) (str (call to-json (. (call JSONRPCRequest init-id "initialize" (call antigravity-initialize-params)) json)) "\n"))
  (call (. process write) (str (call to-json (. (call JSONRPCRequest list-id "session/list" (call (of Map String JSON))) json)) "\n"))
  (let scratch (use (call Arena)))
  (for (in line (~> process \json-line (with (call JSONParser scratch))))
    (let message (catch? (call json-rpc-message line false)))
    (if (= (| (: response JSONRPCResponse)) message)
      (if (== (call antigravity-response-key response) list-id)
        (match (. response outcome)
          (case (call .result _)
            (return (call AIAccount (. AIAccountStatus signed-in) (. AIAccountBilling subscription)))
          )
          (case (call .error error)
            (return-if (call AIAccount (. AIAccountStatus signed-out)) (if (call antigravity-is-auth-error error)))
            (throw error)
          )
        )
      )
    )
  )
  (throw (call Error "Antigravity exited before it reported its account"))
)

(fn-do _ antigravity-ended _
  (param process Process)
  (catch (call (. process close-input)))
  (let ignored (call (. process wait) null))
  (call (. process close))
)

(fn-expr _ json-string _
  (param value (? JSON))
  (match? value
    (case String)
  )
)

(fn-expr _ json-object _
  (param value (? JSON))
  (match? value
    (case (map String JSON))
  )
)
