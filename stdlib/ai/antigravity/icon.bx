(import /graphics/color)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/vector)
(import /gui/vector-image)
(import /math)
(blank)
(prop _ antigravity-icon-color _ (= (call RGBA "#5B8CFF")))

(type + AntigravityIcon (is VectorImage)
  (fn-do + This _
    (= view-box (call Rect 0 0 24 24))
  )
  (content
    (<> This
      (= fill antigravity-icon-color)
      (= stroke (. Stroke none))
      (blank)
      (<> VectorPath
        (= d (call antigravity-icon-path))
      )
    )
  )
)

(fn-expr _ antigravity-icon-path (list PathOp)
  (item (call M 12 1.5))
  (item (call C 12.95 7.45 16.55 11.05 22.5 12))
  (item (call C 16.55 12.95 12.95 16.55 12 22.5))
  (item (call C 11.05 16.55 7.45 12.95 1.5 12))
  (item (call C 7.45 11.05 11.05 7.45 12 1.5))
  (item (call Z))
)
