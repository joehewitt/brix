(import ./wire)
(import /ai/mcp)
(import /ai/model)
(import /ai/suggestions)
(import /data/json)
(import /net/http-server)
(blank)
(prop + antigravity-tool-server _ (= "brix-tools"))

(type + AntigravityHostedOutcome (is Tuple)
  (prop + tool String)
  (prop + result (? AIToolkitResult))
  (prop + failure (? String))
)

(type + AntigravityToolHost (is HTTPServer)
  (prop + toolkits (list AIToolkit))
  (prop + active-request (? AIRequest))
  (blank)
  (prop _ outcomes (list AntigravityHostedOutcome))
  (prop _ calls Size)
  (fn-do + This _
    (param toolkits _)
    (= port 0)
    (let endpoint (call MCPEndpoint "/mcp"))
    (= (. endpoint name) antigravity-tool-server)
    (for (in kit toolkits)
      (for (in tool (call (. kit tools)))
        (let hosted (call MCPTool (. tool name)))
        (= (. hosted description) (. tool description))
        (= (. hosted input-schema) (. tool parameters))
        (= (. hosted call) (=> (called) (call invoke (. tool name) called)))
        (+= endpoint hosted)
      )
    )
    (+= this endpoint)
  )
  (fn-expr + server AntigravityMCPServer :get
    (call AntigravityMCPServer antigravity-tool-server (str "http://127.0.0.1:" port "/mcp"))
  )
  (fn-do + take (? AntigravityHostedOutcome)
    (param tool String)
    (for (in index (..< 0 (. outcomes length)))
      (let outcome ([] outcomes index))
      (if (call ai-tool-matches-name tool (. outcome tool))
        (call (. outcomes remove) index)
        (return outcome)
      )
    )
    (return null)
  )
  (fn-do _ invoke MCPToolResult (?! Error)
    (param name String)
    (param called MCPToolCall)
    (let kit (call ai-toolkit-for toolkits name))
    (throw (call Error (str "Unknown tool: " name)) (if (not kit)))
    (blank)
    (let request (?? active-request (call AIRequest "" (call (of List AIMessage)))))
    (+= calls 1)
    (let id (str antigravity-tool-server "-" calls))
    (let part (call AIToolCallPart id id name (as (. called arguments fields) JSON)))
    (let ran (catch (call (. kit run) request part)))
    (if (= (| (: failure Error)) ran)
      (+= outcomes (call AntigravityHostedOutcome name null (. failure message)))
      (return (call MCPToolResult (. failure message) true))
    )
    (let made (as ran AIToolkitResult))
    (+= outcomes (call AntigravityHostedOutcome name made null))
    (let text
      (match (. made output)
        (case (: plain String)
          plain
        )
        (default
          (call to-json (. made output))
        )
      )
    )
    (let reply (call MCPToolResult text))
    (for (in image (. made images))
      (let encoded (catch? (call antigravity-image-data (. image file))))
      (if encoded
        (+= (. reply images) (call MCPImage encoded (. image file mime-type)))
      )
    )
    (return reply)
  )
)
