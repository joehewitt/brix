(import /ai/media)
(import /ai/model)
(import /data/json)
(import /data/jsonrpc)
(import /os/file)
(import /os/path)
(import /stream/aggregate)
(blank)
(prop + antigravity-provider-id _ (= "antigravity"))
(prop + antigravity-title-field _ (= "_acpTitle"))
(prop + antigravity-kind-field _ (= "_acpKind"))
(prop _ antigravity-session-part _ (= "session"))
(prop _ antigravity-client-name _ (= "brix"))
(prop _ antigravity-client-version _ (= "0.1.0"))
(prop _ antigravity-protocol-version Int (= 1))
(prop _ antigravity-auth-code Int (= -32000))
(prop _ antigravity-signed-out-text _
  (=
    (paragraph
      "Antigravity is not signed in. Run \"agy acp --login\" in a terminal, then try again."
    )
  )
)

(type + AntigravityMCPServer (is Tuple)
  (prop + name String)
  (prop + url String)
  (prop + headers (map String String) (= (call (of Map String String))))
  (prop + chat-header (? String) (= null))
  (fn-expr + json (map String JSON) :get
    (call (of Map String JSON)
      (block
        (:type "http")
        (:name name)
        (:url url)
        (:headers header-list)
      )
    )
    (where
      (lazy header-list
        (call (of List JSON)
          (block
            (arg (in (call antigravity-mcp-header ([] each 0) ([] each 1)) headers))
          )
        )
      )
    )
  )
)

(fn-do + antigravity-mcp-servers-for (list AntigravityMCPServer)
  (param servers (list AntigravityMCPServer))
  (param chat-id (? String))
  (let resolved (call (of List AntigravityMCPServer)))
  (for (in server servers)
    (let header (. server chat-header))
    (if (and header (> (. header length) 0) chat-id (> (. chat-id length) 0))
      (let headers (call (of Map String String)))
      (for (in (tuple key value) (. server headers))
        (= ([] headers key) value)
      )
      (= ([] headers header) chat-id)
      (+= resolved (call AntigravityMCPServer (. server name) (. server url) headers))
      (else
        (+= resolved server)
      )
    )
  )
  (return resolved)
)

(type + AntigravityPoint (is Tuple)
  (prop + session String)
)

(type + AntigravityMark (is Tuple)
  (prop + point AntigravityPoint)
  (prop + parent (? AntigravityPoint) (= null))
)

(type + AntigravityResume (is Tuple)
  (prop + point (? AntigravityPoint) (= null))
  (prop + forks _ (= false))
  (prop + is-merged _ (= false))
)

(type _ AntigravityToolState
  (prop + id String)
  (prop + name String)
  (prop + title (? String) (= null))
  (prop + kind (? String) (= null))
  (prop + input (? JSON) (= null))
  (prop + is-begun _ (= false))
  (prop + is-done _ (= false))
  (fn-do + This _
    (param id _)
    (param name _)
  )
  (fn-expr + call-part AIToolCallPart :get
    (call AIToolCallPart id id name (call antigravity-tool-arguments input title kind))
  )
)

(type + AntigravityDecoder
  (prop + session (? String))
  (prop + model _ (= ""))
  (prop + parent (? AntigravityPoint))
  (blank)
  (prop _ text-id (? String))
  (prop _ text-body _ (= ""))
  (prop _ thought-id (? String))
  (prop _ thought-body _ (= ""))
  (prop _ text-count Size)
  (prop _ thought-count Size)
  (prop _ tools _ (= (call (of Map String AntigravityToolState))))
  (prop _ usage (? AIUsage))
  (fn-do + open (stream AIEvent)
    (param session String)
    (param model String)
    (= (. this session) session)
    (= (. this model) model)
    (yield (call AIPartEndEvent (call mark-part session)))
  )
  (fn-do + decode (stream AIEvent) (?! AIError)
    (param method String)
    (param params JSON)
    (return-if (if (!= method "session/update")))
    (blank)
    (let fields (call json-object params))
    (let active (. this session))
    (let target (call json-string (?[] fields "sessionId")))
    (return-if (if (or (not fields) (not active) (and (!= target null) (!= target active)))))
    (blank)
    (let update (call json-object ([] fields "update")))
    (return-if (if (not update)))
    (blank)
    (let kind (?? (call json-string ([] update "sessionUpdate")) ""))
    (match? kind
      (case= "agent_message_chunk"
        (yield-all (call decode-message-chunk update))
      )
      (case= "agent_thought_chunk"
        (yield-all (call decode-thought-chunk update))
      )
      (case= "tool_call"
        (yield-all (call decode-tool-call update))
      )
      (case= "tool_call_update"
        (yield-all (call decode-tool-call update))
      )
      (case= "usage_update"
        (let counted (call antigravity-usage update))
        (= usage counted)
        (yield (call AIUsageEvent counted))
      )
    )
  )
  (fn-do + finish (stream AIEvent)
    (param result JSON)
    (yield-all (call flush-thought))
    (yield-all (call flush-text))
    (let fields (call json-object result))
    (let reported (call json-object (?[] fields "usage")))
    (if reported
      (= usage (call antigravity-usage reported))
    )
    (let reason (call antigravity-finish-reason (call json-string (?[] fields "stopReason"))))
    (yield (call AIDoneEvent reason usage))
  )
  (fn-do + end-turn _
    (= text-id null)
    (= text-body "")
    (= thought-id null)
    (= thought-body "")
    (= text-count 0)
    (= thought-count 0)
    (= tools (call (of Map String AntigravityToolState)))
    (= parent null)
    (= usage null)
  )
  (fn-expr _ mark-part _
    (param session String)
    (call antigravity-mark-part (call AntigravityMark (call AntigravityPoint session) parent) model)
  )
  (fn-do _ flush-text (stream AIEvent)
    (let id text-id)
    (return-if (if (not id)))
    (blank)
    (let body text-body)
    (= text-id null)
    (= text-body "")
    (yield (call AIPartEndEvent (call AITextPart id body)))
  )
  (fn-do _ flush-thought (stream AIEvent)
    (let id thought-id)
    (return-if (if (not id)))
    (blank)
    (let body thought-body)
    (= thought-id null)
    (= thought-body "")
    (yield (call AIPartEndEvent (call AIReasoningPart id body)))
  )
  (fn-do _ decode-message-chunk (stream AIEvent)
    (param update (map String JSON))
    (let chunk (call antigravity-chunk-text ([] update "content")))
    (return-if (if (or (not chunk) (== (. chunk length) 0))))
    (blank)
    (yield-all (call flush-thought))
    (if (not text-id)
      (+= text-count 1)
      (= text-id (str "text-" text-count))
      (= text-body "")
      (yield (call AIPartBeginEvent (call AITextPart (!! text-id) "")))
    )
    (+= text-body chunk)
    (yield (call AIPartDeltaEvent (!! text-id) (call AITextDelta chunk)))
  )
  (fn-do _ decode-thought-chunk (stream AIEvent)
    (param update (map String JSON))
    (let chunk (call antigravity-chunk-text ([] update "content")))
    (return-if (if (or (not chunk) (== (. chunk length) 0))))
    (blank)
    (yield-all (call flush-text))
    (if (not thought-id)
      (+= thought-count 1)
      (= thought-id (str "thought-" thought-count))
      (= thought-body "")
      (yield (call AIPartBeginEvent (call AIReasoningPart (!! thought-id) "")))
    )
    (+= thought-body chunk)
    (yield (call AIPartDeltaEvent (!! thought-id) (call AIReasoningDelta chunk)))
  )
  (fn-do _ decode-tool-call (stream AIEvent)
    (param update (map String JSON))
    (let id (call json-string ([] update "toolCallId")))
    (return-if (if (or (not id) (== (. id length) 0))))
    (blank)
    (yield-all (call flush-thought))
    (yield-all (call flush-text))
    (let state (call tool-state id update))
    (if (not (. state is-begun))
      (= (. state is-begun) true)
      (yield (call AIPartBeginEvent (. state call-part)))
    )
    (let status (?? (call json-string ([] update "status")) ""))
    (if (and (not (. state is-done)) (or (== status "completed") (== status "failed")))
      (= (. state is-done) true)
      (yield (call AIPartEndEvent (. state call-part)))
      (let output-text (?? (call antigravity-tool-output update) ""))
      (let result
        (call AIToolResultPart
          (block
            (arg (str id ":result"))
            (arg id)
            (arg (?? ([] update "rawOutput") (as output-text JSON)))
            (arg output-text)
            (arg (== status "failed"))
          )
        )
      )
      (yield (call AIPartBeginEvent result))
      (yield (call AIPartEndEvent result))
    )
  )
  (fn-do _ tool-state AntigravityToolState
    (param id String)
    (param update (map String JSON))
    (let existing ([] tools id))
    (let name (?? (call json-string ([] update "name")) (call json-string ([] update "title")) (call json-string ([] update "kind")) "tool"))
    (let state (?? existing (call AntigravityToolState id name)))
    (if (not existing)
      (= ([] tools id) state)
    )
    (let updated-name (call json-string ([] update "name")))
    (if (and updated-name (> (. updated-name length) 0))
      (= (. state name) updated-name)
    )
    (let title (call json-string ([] update "title")))
    (if (and title (> (. title length) 0))
      (= (. state title) title)
    )
    (let kind (call json-string ([] update "kind")))
    (if (and kind (> (. kind length) 0))
      (= (. state kind) kind)
    )
    (let raw-input ([] update "rawInput"))
    (if (and (!= raw-input null) (is-not raw-input Null))
      (= (. state input) raw-input)
    )
    (return state)
  )
)

(fn-expr + antigravity-resume AntigravityResume
  (param request AIRequest)
  (case? (not (. marks length))
    (call AntigravityResume)
  )
  (case? (call antigravity-marks-chain marks)
    (call AntigravityResume (. ([] marks (- (. marks length) 1)) point) (. request forks))
  )
  (default
    (call AntigravityResume null false true)
  )
  (where
    (lazy marks (call antigravity-marks (. request messages)))
  )
)

(fn-do + antigravity-marks (list AntigravityMark)
  (param messages (list AIMessage))
  (let marks (call (of List AntigravityMark)))
  (for (in message messages)
    (for (in part (. message parts))
      (let mark (call antigravity-part-mark part))
      (if mark
        (+= marks mark)
      )
    )
  )
  (return marks)
)

(fn-do + antigravity-marks-chain Bool
  (param marks (list AntigravityMark))
  (for (in index (..< 1 (. marks length)))
    (let mark ([] marks index))
    (let parent (?? (. mark parent) (call AntigravityPoint (. mark point session))))
    (return-if false (if (!= (. parent session) (. ([] marks (- index 1)) point session))))
  )
  (return true)
)

(fn-expr + antigravity-mark-part AIExtensionPart
  (param mark AntigravityMark)
  (param model String)
  (call AIExtensionPart
    (block
      (arg antigravity-session-part)
      (arg antigravity-provider-id)
      (arg antigravity-session-part)
      (arg (call antigravity-mark-data mark model))
    )
  )
)

(fn-expr + antigravity-mark-data JSON
  (param mark AntigravityMark)
  (param model String)
  (call (of Map String JSON)
    (block
      (entry "session_id" (. mark point session))
      (:model model)
      (:parent? (call antigravity-parent-data mark))
    )
  )
)

(fn-expr _ antigravity-parent-data (? JSON)
  (param mark AntigravityMark)
  (case? (== (. mark parent) null)
    null
  )
  (default
    (call (of Map String JSON)
      (block
        (entry "session_id" (. mark parent session))
      )
    )
  )
)

(fn-do + antigravity-part-mark (? AntigravityMark)
  (param part AIMessagePart)
  (return-if (if (is-not part AIExtensionPart)))
  (blank)
  (let extension (as part AIExtensionPart))
  (return-if (if (or (!= (. extension provider-id) antigravity-provider-id) (!= (. extension part-type) antigravity-session-part))))
  (blank)
  (let fields (call json-object (. extension data)))
  (let id (call json-string (?[] fields "session_id")))
  (return-if (if (or (not fields) (not id))))
  (blank)
  (let point (call AntigravityPoint id))
  (let parent (call json-object ([] fields "parent")))
  (let parent-id (call json-string (?[] parent "session_id")))
  (return-if (call AntigravityMark point) (if (or (not parent) (not parent-id))))
  (return (call AntigravityMark point (call AntigravityPoint parent-id)))
)

(fn-expr + antigravity-part-session (? String)
  (param part AIMessagePart)
  (. (?. (call antigravity-part-mark part) point) session)
)

(fn-expr + antigravity-parts-session (? String)
  (param parts (list AIMessagePart))
  (call last (?*> parts (call antigravity-part-session each)))
)

(fn-expr + antigravity-instructions (? String)
  (param request AIRequest)
  (only-if text (if (. text length)))
  (where
    (lazy text (call (. "\n\n" join) (in (call ai-parts-text (. each parts)) (. request messages) (when (call antigravity-instructs each)))))
  )
)

(fn-do + antigravity-prompt-blocks (list JSON) (?! AIError)
  (param request AIRequest)
  (param replays _ (= false))
  (throw (call AIError (. AIErrorKind invalid-request) "Antigravity runs its own tools") (if (. request tools length)))
  (blank)
  (let prompts (call (of List String)))
  (let images (call (of List AIImage)))
  (if replays
    (let context (call antigravity-replay-context (. request messages)))
    (if (> (. context length) 0)
      (+= prompts context)
    )
    (let latest (call antigravity-latest-user (. request messages)))
    (if latest
      (call antigravity-prompt-images latest images)
      (let text (call ai-parts-text (. latest parts)))
      (if (. text length)
        (+= prompts text)
      )
    )
    (else
      (for (in message (. request messages))
        (if (call antigravity-instructs message)
          (continue)
        )
        (if (== (. message role) (. AIMessageRole user))
          (call antigravity-prompt-images message images)
          (let text (call ai-parts-text (. message parts)))
          (if (. text length)
            (+= prompts text)
          )
          (else-if (call antigravity-parts-session (. message parts))
            (= prompts (call (of List String)))
            (= images (call (of List AIImage)))
          )
          (else
            (throw (call AIError (. AIErrorKind invalid-request) "Antigravity can only continue its own replies"))
          )
        )
      )
    )
  )
  (if (. request response-schema)
    (+= prompts (call antigravity-schema-note (. request response-schema)))
  )
  (blank)
  (throw (call AIError (. AIErrorKind invalid-request) "Antigravity needs a prompt") (if (and (not (. prompts length)) (not (. images length)))))
  (blank)
  (let blocks (call (of List JSON)))
  (let text (call (. "\n\n" join) prompts))
  (if (. text length)
    (+= blocks (call antigravity-text-block text))
  )
  (for (in image images)
    (+= blocks (call antigravity-image-block image))
  )
  (return blocks)
)

(fn-expr + antigravity-initialize-params JSON
  (call (of Map String JSON)
    (block
      (entry "protocolVersion" antigravity-protocol-version)
      (entry "clientCapabilities" (call (of Map String JSON)))
      (entry "clientInfo"
        (call (of Map String JSON)
          (block
            (:name antigravity-client-name)
            (:version antigravity-client-version)
          )
        )
      )
    )
  )
)

(fn-do + antigravity-new-session-params (map String JSON)
  (param directory String)
  (param servers (list AntigravityMCPServer))
  (param instructions (? String))
  (let params
    (call (of Map String JSON)
      (block
        (:cwd directory)
        (entry "mcpServers" (call (of List JSON) (in (as (. each json) JSON) servers)))
      )
    )
  )
  (if (and instructions (> (. instructions length) 0))
    (= ([] params "_meta")
      (call (of Map String JSON)
        (block
          (:antigravity
            (call (of Map String JSON)
              (block
                (entry "systemPrompt"
                  (call (of Map String JSON)
                    (block
                      (:append instructions)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (return params)
)

(fn-expr + antigravity-resume-session-params (map String JSON)
  (param session-id String)
  (param directory String)
  (param servers (list AntigravityMCPServer))
  (call (of Map String JSON)
    (block
      (entry "sessionId" session-id)
      (:cwd directory)
      (entry "mcpServers" (call (of List JSON) (in (as (. each json) JSON) servers)))
    )
  )
)

(fn-expr + antigravity-prompt-params (map String JSON)
  (param session-id String)
  (param blocks (list JSON))
  (call (of Map String JSON)
    (block
      (entry "sessionId" session-id)
      (:prompt (as blocks JSON))
    )
  )
)

(fn-expr + antigravity-cancel-params (map String JSON)
  (param session-id String)
  (call (of Map String JSON)
    (block
      (entry "sessionId" session-id)
    )
  )
)

(fn-expr + antigravity-config-params (map String JSON)
  (param session-id String)
  (param config-id String)
  (param value String)
  (call (of Map String JSON)
    (block
      (entry "sessionId" session-id)
      (entry "configId" config-id)
      (:value value)
    )
  )
)

(fn-do + antigravity-config-option (? (map String JSON))
  (param result (? (map String JSON)))
  (param category String)
  (param fallback-id String)
  (let list-value (?[] result "configOptions"))
  (return-if null (if (is-not list-value (list JSON))))
  (blank)
  (for (in item (as list-value (list JSON)))
    (let option (call json-object item))
    (let cat (call json-string (?[] option "category")))
    (let id (call json-string (?[] option "id")))
    (if (and option (or (== cat category) (== id fallback-id)))
      (return option)
    )
  )
  (return null)
)

(fn-do + antigravity-config-supports Bool
  (param option (map String JSON))
  (param wanted String)
  (let choices ([] option "options"))
  (return-if true (if (is-not choices (list JSON))))
  (blank)
  (for (in item (as choices (list JSON)))
    (let entry (call json-object item))
    (let value (?? (call json-string (?[] entry "value")) (call json-string (?[] entry "id"))))
    (return-if true (if (== value wanted)))
    (let grouped (?[] entry "options"))
    (if (is grouped (list JSON))
      (for (in sub (as grouped (list JSON)))
        (let sub-entry (call json-object sub))
        (let sub-value (?? (call json-string (?[] sub-entry "value")) (call json-string (?[] sub-entry "id"))))
        (return-if true (if (== sub-value wanted)))
      )
    )
  )
  (return false)
)

(fn-do + antigravity-permission-answer JSON
  (param params JSON)
  (param allows Bool)
  (let fields (call json-object params))
  (let options (?[] fields "options"))
  (let chosen (only-if (call antigravity-pick-option (as options (list JSON)) allows) (if (is options (list JSON)))))
  (if chosen
    (return
      (call (of Map String JSON)
        (block
          (:outcome
            (call (of Map String JSON)
              (block
                (:outcome "selected")
                (entry "optionId" chosen)
              )
            )
          )
        )
      )
    )
  )
  (return
    (call (of Map String JSON)
      (block
        (:outcome
          (call (of Map String JSON)
            (block
              (:outcome "cancelled")
            )
          )
        )
      )
    )
  )
)

(fn-do _ antigravity-pick-option (? String)
  (param options (list JSON))
  (param allows Bool)
  (let preferred (if-expr allows (list "allow_once" "allow_always") (list "reject_once" "reject_always")))
  (for (in want preferred)
    (for (in item options)
      (let fields (call json-object item))
      (let kind (call json-string (?[] fields "kind")))
      (let id (call json-string (?[] fields "optionId")))
      (if (and (== kind want) id)
        (return id)
      )
    )
  )
  (return null)
)

(fn-expr + antigravity-is-auth-error Bool
  (param error JSONRPCError)
  (or (== (as (. error code) Int) antigravity-auth-code) (call antigravity-has-auth-text (. error message)))
)

(fn-expr + antigravity-rpc-error AIError
  (param method String)
  (param error JSONRPCError)
  (case? (call antigravity-is-auth-error error)
    (call AIError (. AIErrorKind authentication) antigravity-signed-out-text)
  )
  (default
    (call AIError (. AIErrorKind invalid-request) (str "Antigravity could not " method ": " (. error message)))
  )
)

(fn-expr + antigravity-response-key (? String)
  (param response JSONRPCResponse)
  (match? (. response id)
    (case String)
  )
)

(fn-expr + antigravity-exit-reason _
  (param status Int)
  (param errors String)
  (case? (> (. errors length) 0)
    errors
  )
  (default
    (str "Antigravity exited with status " status)
  )
)

(fn-expr _ antigravity-has-auth-text Bool
  (param text String)
  (or (!= (call (. lower find) "authentication required") null) (!= (call (. lower find) "sign in") null) (!= (call (. lower find) "not authenticated") null))
  (where
    (lazy lower (. text lowercased))
  )
)

(fn-expr _ antigravity-mcp-header JSON
  (param name String)
  (param value String)
  (call (of Map String JSON)
    (block
      (:name name)
      (:value value)
    )
  )
)

(fn-expr _ antigravity-finish-reason AIFinishReason
  (param reason (? String))
  (match reason
    (case= "max_tokens"
      (. AIFinishReason length)
    )
    (case= "cancelled"
      (. AIFinishReason cancellation)
    )
    (case= "refusal"
      (. AIFinishReason content-filter)
    )
    (case= "error"
      (. AIFinishReason error)
    )
    (default
      (. AIFinishReason stop)
    )
  )
)

(fn-expr _ antigravity-instructs _
  (param message AIMessage)
  (or (== (. message role) (. AIMessageRole system)) (== (. message role) (. AIMessageRole developer)))
)

(fn-do _ antigravity-latest-user (? AIMessage)
  (param messages (list AIMessage))
  (let index (. messages length))
  (while (> index 0)
    (-= index 1)
    (let message ([] messages index))
    (return-if message (if (== (. message role) (. AIMessageRole user))))
  )
  (return null)
)

(fn-do _ antigravity-replay-context String
  (param messages (list AIMessage))
  (let last-user Index -1)
  (for (in index (..< 0 (. messages length)))
    (if (== (. ([] messages index) role) (. AIMessageRole user))
      (= last-user index)
    )
  )
  (let lines (call (of List String)))
  (for (in index (..< 0 (. messages length)))
    (if (== index last-user)
      (break)
    )
    (let message ([] messages index))
    (if (call antigravity-instructs message)
      (continue)
    )
    (let text (call (. (call ai-parts-text (. message parts)) trim)))
    (if (> (. text length) 0)
      (let speaker (if-expr (== (. message role) (. AIMessageRole user)) "User" "Assistant"))
      (+= lines (str speaker ":\n" text))
    )
  )
  (return-if "" (if (not (. lines length))))
  (return (str "Previous conversation context (branched):\n\n" (call (. "\n\n" join) lines) "\n\nContinue from here:"))
)

(fn-expr _ antigravity-schema-note String
  (param schema JSON)
  (str "Respond with raw JSON only (no markdown fences or commentary) matching this JSON Schema:\n" (call to-json schema))
)

(fn-do _ antigravity-prompt-images _ (?! AIError)
  (param message AIMessage)
  (param images (list AIImage))
  (for (in part (. message parts))
    (if (= (| (: image AIImagePart)) part)
      (+= images (. image image))
      (else
        (throw (call AIError (. AIErrorKind invalid-request) "Antigravity prompts hold only text and images") (if (is-not part AITextPart)))
      )
    )
  )
)

(fn-expr _ antigravity-text-block JSON
  (param text String)
  (call (of Map String JSON)
    (block
      (:type "text")
      (:text text)
    )
  )
)

(fn-do _ antigravity-image-block JSON (?! AIError)
  (param image AIImage)
  (let file (. image file))
  (let data (str (call antigravity-image-data file)))
  (return
    (call (of Map String JSON)
      (block
        (:type "image")
        (entry "mimeType" (. file mime-type))
        (:data data)
      )
    )
  )
)

(fn-do + antigravity-image-data Base64 (?! AIError)
  (param file AIFile)
  (match? (. file source)
    (case (: encoded AIBase64Source)
      (return (. encoded data))
    )
    (case (: held AIBytesSource)
      (return (as (. held data) Base64))
    )
    (case (: stored AIPathSource)
      (let bytes
        (call read-file-bytes (call Path (. stored path) 0)
          (block
            (on-error (: failure Error)
              (throw (call AIError (. AIErrorKind invalid-request) (str "Antigravity cannot read image " (. stored path) ": " failure)))
            )
          )
        )
      )
      (return (as bytes Base64))
    )
  )
  (throw (call AIError (. AIErrorKind invalid-request) "Antigravity cannot read this image"))
)

(fn-do _ antigravity-chunk-text (? String)
  (param value (? JSON))
  (return-if null (if (not value)))
  (blank)
  (if (= (| (: text String)) value)
    (return text)
  )
  (if (= (| (: fields (map String JSON))) value)
    (return (call json-string ([] fields "text")))
  )
  (if (= (| (: items (list JSON))) value)
    (let parts (call (of List String)))
    (for (in item items)
      (let piece (call antigravity-chunk-text item))
      (if piece
        (+= parts piece)
      )
    )
    (return-if null (if (not (. parts length))))
    (return (call (. "" join) parts))
  )
  (return null)
)

(fn-do _ antigravity-tool-arguments JSON
  (param input (? JSON))
  (param title (? String))
  (param kind (? String))
  (let fields (call (of Map String JSON)))
  (if (= (| (: object (map String JSON))) input)
    (for (in (tuple key value) object)
      (= ([] fields key) value)
    )
    (else-if (and (!= input null) (is-not input Null))
      (= ([] fields "input") input)
    )
  )
  (if title
    (= ([] fields antigravity-title-field) title)
  )
  (if kind
    (= ([] fields antigravity-kind-field) kind)
  )
  (return fields)
)

(fn-do _ antigravity-tool-output (? String)
  (param update (map String JSON))
  (let blocks ([] update "content"))
  (if (is blocks (list JSON))
    (let parts (call (of List String)))
    (for (in item (as blocks (list JSON)))
      (let text (call antigravity-tool-content-text item))
      (if (and text (> (. text length) 0))
        (+= parts text)
      )
    )
    (return-if (call (. "\n" join) parts) (if (> (. parts length) 0)))
  )
  (let raw ([] update "rawOutput"))
  (if (= (| (: text String)) raw)
    (return text)
  )
  (if (and (!= raw null) (is-not raw Null))
    (return (call to-json raw))
  )
  (return null)
)

(fn-expr _ antigravity-tool-content-text (? String)
  (param item JSON)
  (match? item
    (case (list (= "type" "content") (= "content" (map "text" (: text String))))
      text
    )
    (case (list (= "type" "text") (= "text" (: text String)))
      text
    )
    (case (list (= "type" "diff") (= "path" (: path String)))
      path
    )
  )
)

(fn-expr _ antigravity-usage AIUsage
  (param value (map String JSON))
  (call AIUsage
    (block
      (:input-tokens (?? (call json-size ([] value "inputTokens")) (call json-size ([] value "used"))))
      (:output-tokens (call json-size ([] value "outputTokens")))
      (:total-tokens (?? (call json-size ([] value "totalTokens")) (call json-size ([] value "used"))))
      (:cached-input-tokens (call json-size ([] value "cachedReadTokens")))
      (:cache-creation-tokens (call json-size ([] value "cachedWriteTokens")))
      (:thought-tokens (call json-size ([] value "thoughtTokens")))
    )
  )
)

(fn-expr _ json-string _
  (param value (? JSON))
  (match? value
    (case String)
  )
)

(fn-expr _ json-object _
  (param value (? JSON))
  (match? value
    (case (map String JSON))
  )
)

(fn-expr _ json-size (? Size)
  (param value (? JSON))
  (match? value
    (case (all Int ({} (>= it 0))))
  )
)
