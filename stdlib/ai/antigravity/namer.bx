(import ./provider)
(import /ai/session)
(blank)
(prop _ antigravity-namer-model _ (= "gemini-4-hydrogen"))

(fn-expr + antigravity-chat-namer _
  (param antigravity Antigravity)
  (call AIChatService antigravity-namer-model "Gemini 4 Hydrogen" provider antigravity-namer-model)
  (where
    (lazy provider
      (call Antigravity
        (block
          (:executable (. antigravity executable))
          (:working-directory (. antigravity working-directory))
          (:permission-mode "read-only")
          (:effort "low")
          (:is-persistent false)
          (:variables (. antigravity variables))
        )
      )
    )
  )
)
