(import ./provider)
(import /ai/session)
(blank)
(prop _ codex-namer-model _ (= "gpt-6-luna"))

(fn-expr + codex-chat-namer _
  (param codex Codex)
  (call AIChatService codex-namer-model "GPT-6-Luna" provider codex-namer-model)
  (where
    (lazy provider
      (call Codex
        (block
          (:executable (. codex executable))
          (:working-directory (. codex working-directory))
          (:sandbox "read-only")
          (:approval-policy "never")
          (:effort "low")
          (:is-persistent false)
          (:variables (. codex variables))
        )
      )
    )
  )
)
