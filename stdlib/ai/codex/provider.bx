(import ./tools)
(import ./wire)
(import /ai/model)
(import /core/arena)
(import /data/json)
(import /data/jsonl)
(import /data/jsonrpc)
(import /os/env)
(import /os/path)
(import /os/process)
(blank)
(prop + codex-default-model _ (= "gpt-6.1-sol"))
(prop + codex-default-effort _ (= "xhigh"))

(type + CodexVariables (is (fn-type (? (map String String)))))

(type + Codex (is AIProvider)
  (prop + executable (? String))
  (prop + working-directory (? String))
  (prop + sandbox (? String))
  (prop + approval-policy (? String))
  (prop + approvals-reviewer (? String))
  (prop + effort (? String))
  (prop + reasoning-summary (? String))
  (prop + is-persistent Bool)
  (prop + variables (? CodexVariables))
  (prop + toolkits (list AIToolkit))
  (prop + running Size)
  (blank)
  (prop _ links (list CodexLink))
  (fn-do + This _
    (param executable (? String) (= null))
    (param working-directory (? String) (= null))
    (param sandbox (? String) (= null))
    (param approval-policy (? String) (= null))
    (param approvals-reviewer (? String) (= null))
    (param effort (? String) (= null))
    (param reasoning-summary (? String) (= null))
    (param is-persistent _ (= true))
    (param variables (? CodexVariables) (= null))
    (param toolkits _ (= (call (of List AIToolkit))))
    (call super)
  )
  (fn-do + account (? AIAccount) (?! AIError)
    (throw (call AIError (. AIErrorKind unknown) (str "Codex did not report its account: " failure)) (on-error (: failure Error)))
    (let base (only-if (call variables) (if variables)))
    (let program (?? executable (call codex-executable (call codex-search-directories base))))
    (return-if (call AIAccount (. AIAccountStatus missing)) (if (not program)))
    (let process
      (call Process
        (block
          (arg program)
          (arg (. ProcessStderr discard))
          (arg (list "app-server"))
          (arg working-directory)
          (arg (call codex-environment base))
        )
      )
    )
    (finally
      (inline (call codex-ended process))
    )
    (return (call codex-account (call codex-account-answer process)))
  )
  (fn-expr + tool-title (? String)
    (param call AIToolCallPart)
    (call codex-tool-title call)
  )
  (fn-expr + tool-kind AIToolKind
    (param call AIToolCallPart)
    (call codex-tool-kind call)
  )
  (fn-expr + tool-input (? String)
    (param call AIToolCallPart)
    (call codex-tool-input call)
  )
  (fn-do + stop-work _ (?! AIError)
    (param parts (list AIMessagePart))
    (let link (call linked (call codex-parts-thread parts)))
    (return-if (if (not link)))
    (call (. link halt))
  )
  (fn-do + stream (stream AIEvent)
    (param request AIRequest)
    (let turn (use (call begin-turn request)))
    (for (in event (. turn events))
      (yield event)
    )
    (throw (. turn failure) (if (. turn failure)))
  )
  (fn-do + steer _ (?! AIError)
    (param parts (list AIMessagePart))
    (param prompt String)
    (let link (call linked (call codex-parts-thread parts)))
    (throw (call AIError (. AIErrorKind invalid-request) "Codex has no running turn to steer") (if (or (not link) (. link is-closing))))
    (call (. link steer) prompt)
  )
  (fn-do _ begin-turn CodexTurn (?! AIError)
    (param request AIRequest)
    (let input (call codex-input (if-expr toolkits (call ai-toolkit-request toolkits request) request)))
    (let plan (call codex-resume request))
    (throw (call AIError (. AIErrorKind invalid-request) "Codex can't continue this chat because its branches were rearranged") (if (. plan is-merged)))
    (let settings
      (call codex-thread-settings
        (block
          (arg request)
          (arg working-directory)
          (arg sandbox)
          (arg approval-policy)
          (arg approvals-reviewer)
        )
      )
    )
    (let key (call to-json (as settings JSON)))
    (let turning (call codex-turn-settings effort reasoning-summary (. request response-schema)))
    (let live (call reusable plan key))
    (return-if (call (. live ask) input turning request) (if live))
    (let base (only-if (call variables) (if variables)))
    (let program (?? executable (call codex-executable (call codex-search-directories base))))
    (throw (call AIError (. AIErrorKind unknown) "Codex is not installed") (if (not program)))
    (let process (call codex-process program working-directory base))
    (let link
      (call CodexLink
        (block
          (arg this)
          (arg process)
          (arg key)
          (arg (call codex-open plan settings is-persistent toolkits))
          (arg (. plan point))
        )
      )
    )
    (+= links link)
    (+= running 1)
    (return (call (. link ask) input turning request))
  )
  (fn-do _ reusable (? CodexLink)
    (param plan CodexResume)
    (param key String)
    (let point (. plan point))
    (return-if null (if (or (not point) (. plan forks))))
    (for (in link links)
      (return-if link (if (and (== (. link thread) (. point thread)) (== (. link settings) key) (not (. link is-closing)))))
    )
    (return null)
  )
  (fn-do _ linked (? CodexLink)
    (param thread (? String))
    (let found (? CodexLink))
    (for (in link links)
      (if (and (!= thread null) (== (. link thread) thread) (or (not found) (not (. link is-closing))))
        (= found link)
      )
    )
    (return found)
  )
  (fn-do _ forget _
    (param link CodexLink)
    (let index (. links length))
    (while (> index 0)
      (-= index 1)
      (if (== (as ([] links index) Pointer) (as link Pointer))
        (call (. links remove) index)
        (-= running 1)
      )
    )
  )
)

(fn-do + codex-executable (? String)
  (param directories (list String))
  (for (in directory directories)
    (let candidate (str directory "/codex"))
    (return-if candidate (if (. (call Path candidate) is-file)))
  )
  (return null)
)

(fn-expr + codex-search-directories (list String)
  (param variables (? (map String String)) (= null))
  (spread (call (. (?? ([] (?? variables (call environment)) "PATH") "") split) ":"))
  (item? (only-if (str home "/.local/bin") (if home)))
  (item "/opt/homebrew/bin")
  (item "/usr/local/bin")
  (pipe |> List)
  (where
    (lazy home (call env "HOME"))
  )
)

(fn-expr + codex-environment (map String String)
  (param variables (? (map String String)) (= null))
  (spread (?? variables (call environment)))
  (pipe ?> (not (call codex-scrubs-variable ([] each 0))))
  (pipe *> (tuple ([] each 0) ([] each 1)))
  (pipe |> Map)
)

(type _ CodexLink
  (prop + settings String)
  (prop + is-closing _ (= false))
  (blank)
  (prop _ provider Codex)
  (prop _ process Process)
  (prop _ opening (? CodexOpen))
  (prop _ decoder _ (:= (call CodexDecoder)))
  (prop _ errors _ (:= (call (of Semaphore String))))
  (prop _ turn (? CodexTurn))
  (prop _ queued (list CodexTurn))
  (prop _ answers (map String (of SyncBufferedChannel JSONRPCOutcome)))
  (prop _ requests Size)
  (prop _ is-interrupting _ (= false))
  (prop _ has-exited _ (= false))
  (fn-do + This _
    (param owner Codex)
    (param child Process)
    (param settings _)
    (param opening CodexOpen)
    (param origin (? CodexPoint) (= null))
    (lazy provider owner)
    (lazy process child)
    (= (. this opening) opening)
    (= (. decoder parent) origin)
    (call send (call to-json (. (call JSONRPCRequest (call request-id) "initialize" (call codex-initialize-params (> (. (call codex-dynamic-tools (. owner toolkits)) length) 0))) json)))
    (call send (call to-json (. (call JSONRPCNotification "initialized" null) json)))
    (do-new
      (call drain)
    )
    (do-new
      (call run)
    )
  )
  (fn-expr + thread _ :get
    (. decoder thread)
  )
  (fn-do + ask CodexTurn
    (param input (list JSON))
    (param settings (map String JSON))
    (param request AIRequest)
    (let asked (call CodexTurn this input settings request))
    (if turn
      (+= queued asked)
      (else
        (call start asked)
      )
    )
    (return asked)
  )
  (fn-do + steer _ (?! AIError)
    (param prompt String)
    (let thread (. decoder thread))
    (let id (. decoder turn))
    (throw (call AIError (. AIErrorKind invalid-request) "Codex has no running turn to steer") (if (or (not turn) (not thread) (not id))))
    (call request "turn/steer" (call codex-steer-params thread id prompt))
  )
  (fn-do + halt _
    (for (in waiting queued)
      (call (. waiting settle) null)
    )
    (call (. queued clear))
    (if turn
      (call interrupt)
      (else
        (call release)
      )
    )
  )
  (fn-do + leave _
    (param left CodexTurn)
    (if (and turn (== (as turn Pointer) (as left Pointer)))
      (call interrupt)
      (else
        (= queued (call List (?> queued (!= (as each Pointer) (as left Pointer)))))
        (call (. left settle) null)
      )
    )
  )
  (fn-do _ start _
    (param next CodexTurn)
    (= turn next)
    (= is-interrupting false)
    (do-new
      (call begin next)
    )
  )
  (fn-do _ begin _
    (param next CodexTurn)
    (call open-thread
      (block
        (on-error (: failure AIError)
          (call fail next failure)
          (return)
        )
      )
    )
    (if is-interrupting
      (call end-turn)
      (return)
    )
    (let params (call codex-turn-params (?? (. decoder thread) "") (. next input) (. next settings)))
    (let result
      (call request "turn/start" params
        (block
          (on-error (: failure AIError)
            (call fail next failure)
            (return)
          )
        )
      )
    )
    (return-if (if (or (not turn) (!= (as turn Pointer) (as next Pointer)))))
    (= (. decoder turn) (?? (. decoder turn) (call codex-result-turn result)))
    (if is-interrupting
      (call interrupt)
    )
  )
  (fn-do _ open-thread _ (?! AIError)
    (let opened opening)
    (return-if (if (not opened)))
    (= opening null)
    (let account (call json-object (call request "account/read" (call (of Map String JSON)))))
    (call codex-check-account (call json-object (?[] account "account")))
    (let result (call json-object (call request (. opened method) (. opened params))))
    (let id (call json-string (?[] (call json-object (?[] result "thread")) "id")))
    (throw (call AIError (. AIErrorKind invalid-response) "Codex did not open a thread") (if (not id)))
    (for (in event (call (. decoder open) id (?? (call json-string (?[] result "model")) "")))
      (do
        (inline (call (?. turn deliver) event))
      )
    )
  )
  (fn-do _ request JSON (?! AIError)
    (param method String)
    (param params JSON)
    (throw (call AIError (. AIErrorKind unknown) (str "Codex stopped before it could " method)) (if has-exited))
    (let id (call request-id))
    (let waiting (call (of SyncBufferedChannel JSONRPCOutcome)))
    (= ([] answers id) waiting)
    (call send (call to-json (. (call JSONRPCRequest id method params) json)))
    (let outcome (<- waiting))
    (-= ([] answers id))
    (throw (call AIError (. AIErrorKind unknown) (str "Codex stopped before it answered " method)) (if (not outcome)))
    (match outcome
      (case (call .result value)
        (return value)
      )
      (case (call .error error)
        (throw (call AIError (. AIErrorKind invalid-request) (str "Codex could not " method ": " (. error message))))
      )
    )
  )
  (fn-do _ fail _
    (param next CodexTurn)
    (param failure AIError)
    (call (. next settle) failure)
    (if (and turn (== (as turn Pointer) (as next Pointer)))
      (call end-turn)
    )
  )
  (fn-do _ interrupt _
    (let thread (. decoder thread))
    (let id (. decoder turn))
    (if (or (not thread) (not id))
      (= is-interrupting true)
      (return)
    )
    (call send
      (block
        (arg
          (call to-json
            (block
              (arg (. (call JSONRPCRequest (call request-id) "turn/interrupt" (call codex-interrupt-params thread id)) json))
            )
          )
        )
      )
    )
  )
  (fn-do _ run _
    (let problem (? String))
    (call listen
      (block
        (on-error (: failure Error)
          (= problem (str failure))
        )
      )
    )
    (if problem
      (call (. process terminate))
    )
    (let status (call (. process wait) null))
    (let output (?? (call (. errors await)) ""))
    (call (. process close))
    (call (. provider forget) this)
    (= is-closing true)
    (= has-exited true)
    (for (in (tuple _ waiting) answers)
      (call (. waiting close))
    )
    (= answers (call (of Map String (of SyncBufferedChannel JSONRPCOutcome))))
    (let failure (call AIError (. AIErrorKind unknown) (?? problem (call codex-exit-reason (?? status 0) (call (. output trim))))))
    (do
      (inline (call (?. turn settle) failure))
    )
    (= turn null)
    (for (in waiting queued)
      (call (. waiting settle) failure)
    )
    (call (. queued clear))
  )
  (fn-do _ drain _
    (let text (as (!! (. process stderr)) String))
    (call (. errors post) text)
  )
  (fn-do _ listen _ (?! JSONLineError) (?! IOError)
    (let scratch (use (call Arena)))
    (for (in line (~> process \json-line (with (call JSONParser scratch))))
      (call hear line)
    )
  )
  (fn-do _ hear _
    (param line JSON)
    (let message (catch? (call json-rpc-message line false)))
    (return-if (if (not message)))
    (match message
      (case (: response JSONRPCResponse)
        (call answer response)
      )
      (case (: asked JSONRPCRequest)
        (call reply asked)
      )
      (case (: notice JSONRPCNotification)
        (call deliver notice)
      )
    )
  )
  (fn-do _ answer _
    (param response JSONRPCResponse)
    (let key (call codex-response-key response))
    (let waiting (only-if ([] answers key) (if key)))
    (return-if (if (not waiting)))
    (<- waiting (. response outcome))
    (call (. waiting close))
  )
  (fn-do _ reply _
    (param asked JSONRPCRequest)
    (if (== (. asked method) "item/tool/call")
      (do-new
        (call serve asked)
      )
      (return)
    )
    (let answer (call codex-server-answer (. asked method)))
    (let refusal (call JSONRPCError .method-not-found (str "Brix does not answer " (. asked method))))
    (let response (if-expr (!= answer null) (call (. asked response) answer) (call (. asked error-response) refusal)))
    (call send (call to-json (. response json)))
  )
  (fn-do _ serve _
    (param asked JSONRPCRequest)
    (let params (call json-object (. asked params)))
    (let id (?? (call json-string (?[] params "callId")) ""))
    (let call
      (call AIToolCallPart
        (block
          (arg id)
          (arg id)
          (arg (?? (call json-string (?[] params "tool")) ""))
          (arg (?? (?[] params "arguments") (as null JSON)))
        )
      )
    )
    (let reply (catch (call run-tool call)))
    (if (= (| (: failure Error)) reply)
      (call (. decoder host)
        (block
          (arg id)
          (arg (call (of List AIPartEndEvent) (list (call AIPartEndEvent (call ai-toolkit-failure call (. failure message))))))
        )
      )
      (call send (call to-json (. (call (. asked response) failure-reply) json))
        (block
          (lazy failure-reply (call codex-tool-reply (call (of List JSON) (list (call codex-output-item (. failure message)))) false))
        )
      )
      (return)
    )
    (call send (call to-json (. (call (. asked response) (as reply JSON)) json)))
  )
  (fn-do _ run-tool JSON (?! Error)
    (param call AIToolCallPart)
    (let kit (call ai-toolkit-for (. provider toolkits) (. call tool-name)))
    (let current turn)
    (throw (call AIError (. AIErrorKind invalid-request) (str "Brix has no tool named " (. call tool-name))) (if (or (not kit) (not current))))
    (let result (call (. kit run) (. current request) call))
    (let content (call codex-tool-content result))
    (let events (call (of List AIPartEndEvent)))
    (for (in event (call ai-toolkit-parts call result))
      (+= events event)
    )
    (call (. decoder host) (. call id) events)
    (return (call codex-tool-reply content true))
  )
  (fn-do _ deliver _
    (param notice JSONRPCNotification)
    (call emit notice
      (block
        (on-error (: failure AIError)
          (do
            (inline (call (?. turn settle) failure))
          )
        )
      )
    )
    (if (call (. decoder ends-turn) (. notice method) (. notice params))
      (call end-turn)
    )
  )
  (fn-do _ emit _ (?! AIError)
    (param notice JSONRPCNotification)
    (for (in event (call (. decoder decode) (. notice method) (. notice params)))
      (do
        (inline (call (?. turn deliver) event))
      )
    )
  )
  (fn-do _ end-turn _
    (let ended turn)
    (= turn null)
    (= is-interrupting false)
    (do
      (inline (call (?. ended settle) null))
    )
    (call (. decoder end-turn))
    (if (. queued length)
      (let next ([] queued 0))
      (call (. queued remove) 0)
      (call start next)
      (else
        (call release)
      )
    )
  )
  (fn-do _ release _
    (return-if (if (or is-closing turn (. queued length))))
    (= is-closing true)
    (catch (call (. process close-input)))
  )
  (fn-do _ send _
    (param line String)
    (catch (call (. process write) (str line "\n")))
  )
  (fn-do _ request-id String
    (+= requests 1)
    (return (str "brix-" requests))
  )
)

(type _ CodexTurn
  (prop + events _ (:= (call (of SyncBufferedChannel AIEvent))))
  (prop + failure (? AIError))
  (prop + input (list JSON))
  (prop + settings (map String JSON))
  (prop + request AIRequest)
  (prop + is-settled _ (= false))
  (blank)
  (prop _ link CodexLink)
  (prop _ is-abandoned _ (= false))
  (fn-do + This _
    (param link _)
    (param input _)
    (param settings _)
    (param request _)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call abandon)
  )
  (fn-do + abandon _
    (return-if (if is-settled))
    (= is-abandoned true)
    (call (. link leave) this)
  )
  (fn-do + deliver _
    (param event AIEvent)
    (return-if (if (or is-abandoned is-settled)))
    (<- events event)
  )
  (fn-do + settle _
    (param problem (? AIError))
    (return-if (if is-settled))
    (= is-settled true)
    (= failure problem)
    (if (not is-abandoned)
      (call (. events close))
    )
  )
)

(fn-do _ codex-process Process (?! AIError)
  (param program String)
  (param directory (? String))
  (param base (? (map String String)))
  (throw (call AIError (. AIErrorKind invalid-request) (str "Codex can't run in " directory " because it no longer exists")) (if (and directory (not (. (call Path directory 0) is-dir)))))
  (throw (call AIError (. AIErrorKind unknown) (str "Codex did not start: " failure)) (on-error (: failure Error)))
  (return (call Process program (. ProcessStderr capture) (list "app-server") directory (call codex-environment base)))
)

(fn-do _ codex-account-answer (? JSON) (?! Error)
  (param process Process)
  (let asked "brix-account")
  (call (. process write) (str (call to-json (. (call JSONRPCRequest "brix-initialize" "initialize" params) json)) "\n")
    (block
      (lazy params (call codex-initialize-params))
    )
  )
  (call (. process write) (str (call to-json (. (call JSONRPCNotification "initialized" null) json)) "\n"))
  (call (. process write) (str (call to-json (. (call JSONRPCRequest asked "account/read" (call (of Map String JSON))) json)) "\n"))
  (let scratch (use (call Arena)))
  (for (in line (~> process \json-line (with (call JSONParser scratch))))
    (let message (catch? (call json-rpc-message line false)))
    (if (= (| (: response JSONRPCResponse)) message)
      (if (== (call codex-response-key response) asked)
        (match (. response outcome)
          (case (call .result value)
            (return value)
          )
          (case (call .error error)
            (throw error)
          )
        )
      )
    )
  )
  (throw (call Error "Codex exited before it reported its account"))
)

(fn-do _ codex-ended _
  (param process Process)
  (catch (call (. process close-input)))
  (let ignored (call (. process wait) null))
  (call (. process close))
)

(fn-expr _ codex-result-turn (? String)
  (param result JSON)
  (match? result
    (case (map "turn" (map "id" (: id String)))
      id
    )
  )
)

(fn-expr _ codex-scrubs-variable _
  (param name String)
  (or (call (. name starts-with) "OPENAI_") (and (call (. name starts-with) "CODEX_") (!= name "CODEX_HOME")))
)

(fn-expr _ json-string _
  (param value (? JSON))
  (match? value
    (case String)
  )
)

(fn-expr _ json-object _
  (param value (? JSON))
  (match? value
    (case (map String JSON))
  )
)
