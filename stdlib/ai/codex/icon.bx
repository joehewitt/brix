(import /graphics/color)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/vector)
(import /gui/vector-image)
(import /math)
(blank)
(prop _ codex-icon-color _ (= (call RGBA "#7A9DFF")))

(type + CodexIcon (is VectorImage)
  (fn-do + This _
    (= view-box (call Rect 0 0 24 24))
  )
  (content
    (<> This
      (= fill codex-icon-color)
      (= stroke (. Stroke none))
      (= fill-rule (. FillRule even-odd))
      (blank)
      (<> VectorPath
        (= d (call codex-icon-path))
      )
    )
  )
)

(fn-expr _ codex-icon-path (list PathOp)
  (item (call M 8.086 0.457))
