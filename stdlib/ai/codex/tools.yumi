./wire
/ai/model
/ai/tasks
/data/json
/os/path
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ codex-tool-title String?
    - call AIToolCallPart

match call.tool-name
    |= codex-command-tool
        codex-first-line(codex-command(arguments))
    |= codex-patch-tool
        codex-patch-title(arguments)
    |= codex-image-tool
        "View ${codex-file-name(ai-argument(arguments, "path")) ?? "an image"}"
    |= codex-agent-tool
        codex-agent-title(ai-argument(arguments, "action"))
    ??
        codex-mcp-title(call.tool-name)

.. arguments = call.arguments

━━━━━━━━━━━━━━━━━━━━
+ codex-tool-kind AIToolKind
    - call AIToolCallPart

match call.tool-name
    |= codex-command-tool
        codex-command-kind(call.arguments)
    |= codex-patch-tool
        if codex-patch-adds(call.arguments) then AIToolKind.write else AIToolKind.edit
    |= codex-image-tool
        AIToolKind.read
    |= codex-agent-tool
        AIToolKind.agent
    ??
        AIToolKind.other

━━━━━━━━━━━━━━━━━━━━
+ codex-tool-input String?
    - call AIToolCallPart

match? call.tool-name
    |= codex-command-tool
        codex-read-path(arguments) ?? codex-command(arguments)
    |= codex-patch-tool
        codex-patch-path(arguments)
    |= codex-image-tool
        ai-argument(arguments, "path")
    |= codex-agent-tool
        ai-argument(arguments, "prompt")

.. arguments = call.arguments

━━━━━━━━━━━━━━━━━━━━
_ codex-command String?
    - arguments JSON

codex-unwrapped(command) if command

.. command = ai-argument(arguments, "command")

━━━━━━━━━━━━━━━━━━━━
_ codex-unwrapped String
    - command String

|? start == null || !command.ends-with("'") || command[0 .. < start].find(" ") != null
    command
??
    command[open + 1 .. < command.length - 1]

.. start = command.find(" -lc '") ?? command.find(" -c '")
.. open = command.find("'", start) ?? start

━━━━━━━━━━━━━━━━━━━━
_ do codex-command-kind AIToolKind
    - arguments JSON

. actions = codex-actions(arguments)
. first = codex-action-kind(actions[0]) if actions.length
for action in actions
    =? AIToolKind.command if codex-action-kind(action) != first
= first ?? AIToolKind.command

━━━━━━━━━━━━━━━━━━━━
_ codex-action-kind AIToolKind?
    - action JSON

match? action
    | ["type" = "read"]
        AIToolKind.read
    | ["type" = "listFiles"]
        AIToolKind.search
    | ["type" = "search"]
        AIToolKind.search

━━━━━━━━━━━━━━━━━━━━
_ do codex-read-path String?
    - arguments JSON

. actions = codex-actions(arguments)
=? null if actions.length != 1
= match? actions[0]
    | ["type" = "read", "path" = path String]
        path

━━━━━━━━━━━━━━━━━━━━
_ codex-actions [JSON]
    - arguments JSON

match arguments
    | ["actions" = actions [JSON]]
        actions
    ??
        List'JSON()

━━━━━━━━━━━━━━━━━━━━
_ codex-changes [JSON]
    - arguments JSON

match arguments
    | ["changes" = changes [JSON]]
        changes
    ??
        List'JSON()

━━━━━━━━━━━━━━━━━━━━
_ codex-patch-adds Bool
    - arguments JSON

changes.length > 0 && adds

.. changes = codex-changes(arguments)
.. adds = all(changes) • where (each is ["kind" = ["type" = "add"], ...])

━━━━━━━━━━━━━━━━━━━━
_ codex-patch-path String?
    - arguments JSON

match? codex-changes(arguments)
    | [["path" = path String, ...]]
        path

━━━━━━━━━━━━━━━━━━━━
_ codex-patch-title String
    - arguments JSON

|? count > 1
    "Edit $count files"
|? codex-patch-adds(arguments)
    "Write ${name ?? "a file"}"
??
    "Edit ${name ?? "a file"}"

.. count = codex-changes(arguments).length
.. name = codex-file-name(codex-patch-path(arguments))

━━━━━━━━━━━━━━━━━━━━
_ codex-agent-title String
    - action String?

match action
    |= "spawnAgent"
        "Start an agent"
    |= "wait"
        "Wait for agents"
    |= "sendInput"
        "Message an agent"
    |= "closeAgent"
        "Close an agent"
    ??
        "Work with agents"

━━━━━━━━━━━━━━━━━━━━
_ codex-file-name String?
    - path String?

Path(path, 0).name if path

━━━━━━━━━━━━━━━━━━━━
_ codex-first-line String?
    - text String?

|? text == null
    null
|? text.find("\n") != null
    "${text[0 .. < text.find("\n")!].trim()} …"
??
    text.trim()

━━━━━━━━━━━━━━━━━━━━
_ codex-mcp-title String
    - name String

|? parts.length >= 3 && parts[0] == "mcp"
    "${parts[1]}: ${parts[2]}"
??
    name

.. parts = List(name.split("__"))
