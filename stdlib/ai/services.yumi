+ ai-default-image-model = "gpt-image-2.5-flare"
_ ai-naming-effort = "low"
_ ai-codex-reviewer = "auto_review"
_ ai-codex-summary = "auto"
_ ai-task-reminder = "For work with several steps, keep a task list the person can see: create a task for each step with TaskCreate, loading it with ToolSearch first if it is deferred, and keep each task current with TaskUpdate as you work."

━━━━━━━━━━━━━━━━━━━━
+ AIChatAgent is Union

| claude
| codex
| openai

━━━━━━━━━━━━━━━━━━━━
+ AIChatVariables is () [String = String]?

━━━━━━━━━━━━━━━━━━━━
+ AIChatSetup is Tuple

+ agents = List'AIChatAgent([AIChatAgent.claude, AIChatAgent.codex, AIChatAgent.openai])
+ working-directory String? = null
+ instructions String? = null
+ suffix = ""
+ effort String? = null
+ images AIImageStore? = null
+ drawing AIImageToolkit? = null
+ toolkits = List'AIToolkit()
+ variables AIChatVariables? = null
+ claude-model = claude-default-model
+ mcp-servers = List'ClaudeMCPServer()
+ permission-mode = "auto"
+ has-task-tools = true
+ sandbox = "workspace-write"
+ approval-policy = "on-request"

━━━━━━━━━━━━━━━━━━━━
+ AIChatAccounts

+ claude AIAccess
+ codex AIAccess
+ openai AIAccess
+ titler OpenAIResponses
+ painter OpenAIImages

_ endpoint URL
_ responders = List'OpenAIResponses()

────────────────────
+ This
    - path Path

. store = AIAccessStore(path)
claude = AIAccess(store, "claude-code", AIAccessKind.approval, "Claude Code", "claude auth login")
codex = AIAccess(store, "codex", AIAccessKind.approval, "Codex", "codex login")
openai = AIAccess(store, "openai", AIAccessKind.api-key, "OpenAI") • variable "OPENAI_API_KEY"
. key = openai.key ?? ""
. base = env("OPENAI_BASE_URL")
endpoint = if base then URL(base) else openai-api-base
titler = OpenAIResponses(key, endpoint) • reasoning-effort ai-naming-effort
painter = OpenAIImages(key, endpoint)

────────────────────
for key on openai.keyed

titler.api-key = key
painter.api-key = key
for each in responders
    each.api-key = key

────────────────────
+ do responder OpenAIResponses
    - effort String

. made = OpenAIResponses(openai.key ?? "", endpoint) • reasoning-effort effort
responders += made
= made

━━━━━━━━━━━━━━━━━━━━
+ ai-image-model String

env("OPENAI_IMAGE_MODEL") ?? ai-default-image-model

━━━━━━━━━━━━━━━━━━━━
+ do ai-chat-services [AIChatService]
    - accounts AIChatAccounts
    - setup = AIChatSetup()

. drawing = ai-chat-drawing(accounts, setup)
. toolkits = List'AIToolkit(setup.toolkits)
toolkits += AIQuestionToolkit()
. hosted = List'AIToolkit()
if drawing
    hosted += drawing
hosted ++= toolkits
. services = List'AIChatService()
for agent in setup.agents
    services += ai-chat-service(accounts, setup, agent, drawing, toolkits, hosted)
= services

━━━━━━━━━━━━━━━━━━━━
_ do ai-chat-drawing AIImageToolkit?
    - accounts AIChatAccounts
    - setup AIChatSetup

. images = setup.images
. drawing = setup.drawing ?? (AIImageToolkit(accounts.painter, images, ai-image-model()) if images)
=? null if !drawing
drawing.access = accounts.openai
= drawing

━━━━━━━━━━━━━━━━━━━━
_ do ai-chat-service AIChatService
    - accounts AIChatAccounts
    - setup AIChatSetup
    - agent AIChatAgent
    - drawing AIImageToolkit?
    - toolkits [AIToolkit]
    - hosted [AIToolkit]

. suffix = setup.suffix
match agent
    | AIChatAgent.claude
        . claude = ai-chat-claude(setup, hosted)
        = AIChatService("$claude-default-model$suffix", "Claude", claude, setup.claude-model) • instructions setup.instructions • namer claude-chat-namer(claude) • reminder (ai-task-reminder if setup.has-task-tools) • access accounts.claude • icon AIServiceIcon.claude • tool-access accounts.openai
    | AIChatAgent.codex
        . codex = ai-chat-codex(setup, hosted)
        = AIChatService("codex$suffix", "Codex", codex, codex-default-model) • instructions setup.instructions • namer codex-chat-namer(codex) • access accounts.codex • icon AIServiceIcon.codex • tool-access accounts.openai
    | AIChatAgent.openai
        . painting = AIImagingProvider
            - accounts.responder(setup.effort ?? openai-default-effort)
            - drawing
        painting.toolkits ++= toolkits
        = AIChatService("openai$suffix", "ChatGPT", painting, openai-default-model) • instructions setup.instructions • namer openai-chat-namer(accounts.titler) • access accounts.openai • icon AIServiceIcon.openai • tool-access accounts.openai

━━━━━━━━━━━━━━━━━━━━
_ ai-chat-claude ClaudeCode
    - setup AIChatSetup
    - toolkits [AIToolkit]

ClaudeCode
    • working-directory setup.working-directory
    • permission-mode setup.permission-mode
    • has-task-tools setup.has-task-tools
    • effort setup.effort ?? claude-default-effort
    • variables setup.variables
    • mcp-servers setup.mcp-servers
    • toolkits toolkits

━━━━━━━━━━━━━━━━━━━━
_ ai-chat-codex Codex
    - setup AIChatSetup
    - toolkits [AIToolkit]

Codex
    • working-directory setup.working-directory
    • sandbox setup.sandbox
    • approval-policy setup.approval-policy
    • approvals-reviewer ai-codex-reviewer
    • effort setup.effort ?? codex-default-effort
    • reasoning-summary ai-codex-summary
    • variables setup.variables
    • toolkits toolkits
