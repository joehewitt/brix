/core/channel
/data/json
/data/jsonrpc
/net/http

━━━━━━━━━━━━━━━━━━━━
+ MCPToolHandler is () MCPToolResult ?! Error
    - call MCPToolCall

━━━━━━━━━━━━━━━━━━━━
+ MCPTool

+ name String
+ title String?
+ description = ""
+ input-schema JSON
+ call MCPToolHandler?

────────────────────
+ This
    - name String

────────────────────
+ get json [String = JSON]

Map'String'JSON
    • name name
    •? title title
    • description description
    • "inputSchema" schema

.. schema = if !(input-schema is Null) then input-schema else mcp-empty-input-schema()

━━━━━━━━━━━━━━━━━━━━
+ MCPToolCall

+ request JSONRPCRequest
+ headers [HTTPHeader]
+ name String
+ tool MCPTool?
+ arguments JSONObjectReader

_ progress-token JSON
_ updates SyncBufferedChannel'JSONRPCMessage?

────────────────────
+ This
    - request JSONRPCRequest
    - headers [HTTPHeader]
    - name String
    - fields [String = JSON]
    - progress-token JSON
    - tool MCPTool?
    - updates SyncBufferedChannel'JSONRPCMessage?

arguments = JSONObjectReader("arguments", fields)

────────────────────
+ this[key String]

arguments[key]

────────────────────
+ header String?
    - name String

http-header(headers, name)

────────────────────
+ get wants-progress

updates != null && !(progress-token is Null)

────────────────────
+ do progress
    - amount Float
    - total Float? = null
    - message String? = null

=? if !wants-progress

. params = Map'String'JSON
    • "progressToken" progress-token
    • progress amount
    •? total total
    •? message message
updates! <- JSONRPCNotification("notifications/progress", params)

━━━━━━━━━━━━━━━━━━━━
+ MCPImage is Tuple

+ data Base64
+ mime-type String

────────────────────
+ get json [String = JSON]

Map'String'JSON
    • type "image"
    • data data
    • "mimeType" mime-type

━━━━━━━━━━━━━━━━━━━━
+ MCPToolResult

+ text String
+ images [MCPImage]
+ structured-content JSON
+ is-error = false

────────────────────
+ This
    - text String
    - is-error = false
    - structured-content JSON = null

────────────────────
+ from text String

This(text)

────────────────────
+ from json JSON

This(to-json(json), false, json)

────────────────────
+ get json [String = JSON]

Map'String'JSON
    • content content
    •? "structuredContent" structured-content if !(structured-content is Null)
    •? "isError" true if is-error

.. content [JSON] =
    *? text-content if text.length || !images.length
    ** each.json in images
.. text-content = Map'String'JSON
    • type "text"
    • text text

━━━━━━━━━━━━━━━━━━━━
+ mcp-empty-input-schema JSON

Map'String'JSON
    • type "object"
    • "additionalProperties" false
