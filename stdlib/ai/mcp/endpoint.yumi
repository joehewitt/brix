+ mcp-protocol-version = "2026-07-28"

_ mcp-handshake-versions [String] = ["2025-11-25", "2025-06-18"]

_ mcp-header-mismatch = -32020 as JSONRPCErrorCode
_ mcp-unsupported-version = -32022 as JSONRPCErrorCode
_ mcp-meta-version = "io.modelcontextprotocol/protocolVersion"
_ mcp-meta-capabilities = "io.modelcontextprotocol/clientCapabilities"

━━━━━━━━━━━━━━━━━━━━
+ MCPService

────────────────────
+ do call-tool MCPToolResult ?! Error
    - call MCPToolCall

. tool = call.tool
?! JSONRPCError(.invalid-params, "Unknown tool: ${call.name}")
    if !tool
. handler = tool.call
?! JSONRPCError(.internal-error, "Tool ${call.name} has no call")
    if !handler
= handler(call)

━━━━━━━━━━━━━━━━━━━━
+ MCPEndpoint is Route

+ name = "yumi"
+ version = "0.1.0"
+ instructions String?
+ service = MCPService()
+ tools [MCPTool]
+ allowed-origins [String]
+ cache-ttl Milliseconds = 0ms

────────────────────
+ This
    - path String

post = this.respond-mcp

────────────────────
+ do this += tool MCPTool

tools += tool
= tool

────────────────────
+ tool MCPTool?
    - name String

first(each in tools when each.name == name)

────────────────────
_ do respond-mcp HTTPResponse ?! Error
    - request HTTPRequest

= receive(request)
    catch failure MCPProtocolError
        mcp-http-response(failure.status, JSONRPCResponse(failure.id, .error(failure)))

────────────────────
_ do receive HTTPResponse ?! Error
    - request HTTPRequest

?! MCPProtocolError(HTTPStatus.forbidden, .invalid-request, "Origin not allowed")
    if !is-allowed-origin(request.header("Origin"))

. message = parse-json-rpc(request.text)
    catch error JSONRPCError
        ?! MCPProtocolError(HTTPStatus.bad-request, error.code, error.message)

= match message
    | rpc JSONRPCRequest
        respond-request(request, rpc)
    | JSONRPCNotification
        HTTPResponse(HTTPStatus.accepted)
    ?! MCPProtocolError(HTTPStatus.bad-request, .invalid-request, "Clients must not send responses")

────────────────────
_ do respond-request HTTPResponse ?! Error
    - request HTTPRequest
    - rpc JSONRPCRequest

check-request(request, rpc)
if rpc.method == "tools/call" && mcp-meta(rpc) has "progressToken"
    = HTTPResponse(call-events(rpc, request.headers))
= mcp-http-response(HTTPStatus.ok, dispatch(rpc, request.headers, null))

────────────────────
_ do check-request ?! MCPProtocolError
    - request HTTPRequest
    - rpc JSONRPCRequest

. id = rpc.id
if is-handshake(rpc)
    check-handshake(request, rpc)
    =

. meta = mcp-meta(rpc)
. body-version = match meta[mcp-meta-version]
    | text String
        text
    ?! MCPProtocolError(HTTPStatus.bad-request, .invalid-params, "Missing _meta \"$mcp-meta-version\"", id)
?! MCPProtocolError(HTTPStatus.bad-request, .invalid-params, "Missing _meta \"$mcp-meta-capabilities\"", id)
    if !(meta has mcp-meta-capabilities)

. header-version = request.header("MCP-Protocol-Version")
?! header-mismatch("Missing MCP-Protocol-Version header", id)
    if !header-version
?! header-mismatch("MCP-Protocol-Version header '${header-version}' does not match body '$body-version'", id)
    if header-version != body-version
?! unsupported-version(body-version, [mcp-protocol-version], id)
    if body-version != mcp-protocol-version

. header-method = request.header("Mcp-Method")
?! header-mismatch("Missing Mcp-Method header", id)
    if !header-method
?! header-mismatch("Mcp-Method header '${header-method}' does not match body '${rpc.method}'", id)
    if header-method != rpc.method

if rpc.method == "tools/call"
    . header-name = request.header("Mcp-Name")
    ?! header-mismatch("Missing Mcp-Name header", id)
        if !header-name
    . decoded = mcp-header-value(header-name)
        catch SyntaxError
            ?! header-mismatch("Mcp-Name header is not valid Base64", id)
    . body-name = match mcp-params(rpc)["name"]
        | text String
            text
        ??
            ""
    ?! header-mismatch("Mcp-Name header '$decoded' does not match body '$body-name'", id)
        if decoded != body-name

?! MCPProtocolError(HTTPStatus.not-found, .method-not-found, "Method not found: ${rpc.method}", id)
    if !is-mcp-method(rpc.method)

────────────────────
_ do check-handshake ?! MCPProtocolError
    - request HTTPRequest
    - rpc JSONRPCRequest

. version = request.header("MCP-Protocol-Version")
if version && !(mcp-handshake-versions has version)
    ?! unsupported-version(version, mcp-handshake-versions, rpc.id)
?! MCPProtocolError(HTTPStatus.not-found, .method-not-found, "Method not found: ${rpc.method}", rpc.id)
    if !is-handshake-method(rpc.method)

────────────────────
_ do call-events <ServerSentEvent>
    - rpc JSONRPCRequest
    - headers [HTTPHeader]

. updates SyncBufferedChannel'JSONRPCMessage
. runner = MCPCallRunner()
. is-answered = false
do finally
    updates.close()
    if !is-answered
        runner.task?.cancel()

runner.task = do new run-call(rpc, headers, updates, runner)
catch failure
    stderr <- "MCP call ${rpc.method} failed: ${failure}\n"
for message in updates
    is-answered = message is JSONRPCResponse
    <= ServerSentEvent("$message")

────────────────────
_ do run-call
    - rpc JSONRPCRequest
    - headers [HTTPHeader]
    - updates SyncBufferedChannel'JSONRPCMessage
    - runner MCPCallRunner

do finally
    . failure = Task().failure
    if failure && !Task().is-canceled && !Task().is-terminating
        updates <- rpc.error-response(JSONRPCError(.internal-error, "${failure}"))
    updates.close()
=? if updates.is-closed

updates <- dispatch(rpc, headers, updates)

────────────────────
_ do dispatch JSONRPCResponse
    - rpc JSONRPCRequest
    - headers [HTTPHeader]
    - updates SyncBufferedChannel'JSONRPCMessage?

. outcome = catch method-result(rpc, headers, updates)
= match outcome
    | fields [String = JSON]
        rpc.response(fields)
    | error JSONRPCError
        rpc.error-response(error)

────────────────────
_ do method-result [String = JSON] ?! JSONRPCError
    - rpc JSONRPCRequest
    - headers [HTTPHeader]
    - updates SyncBufferedChannel'JSONRPCMessage?

= match rpc.method
    | "initialize"
        initialize-result(rpc)
    | "ping"
        Map'String'JSON()
    | "server/discover"
        discover-result()
    | "tools/list"
        tools-list-result()
    | "tools/call"
        tools-call-result(rpc, headers, updates)
    ?! JSONRPCError(.method-not-found, "Method not found: ${rpc.method}")

────────────────────
_ initialize-result [String = JSON]
    - rpc JSONRPCRequest

Map'String'JSON
    • "protocolVersion" if mcp-handshake-versions has requested then requested else mcp-handshake-versions[0]
    • capabilities capabilities
    • "serverInfo" info
    •? instructions instructions

.. requested = initialize-version(rpc)
.. capabilities = Map'String'JSON
    • tools Map'String'JSON()
.. info = Map'String'JSON
    • name name
    • version version

────────────────────
_ discover-result [String = JSON]

cacheable(fields)

.. versions [JSON] =
    * mcp-protocol-version
.. capabilities = Map'String'JSON
    • tools Map'String'JSON()
.. fields = Map'String'JSON
    • "supportedVersions" versions
    • capabilities capabilities
    •? instructions instructions

────────────────────
_ tools-list-result [String = JSON]

cacheable(fields)

.. fields = Map'String'JSON
    • tools each.json in tools

────────────────────
_ do tools-call-result [String = JSON] ?! JSONRPCError
    - rpc JSONRPCRequest
    - headers [HTTPHeader]
    - updates SyncBufferedChannel'JSONRPCMessage?

. params = mcp-params(rpc)
. name = match params["name"]
    | text String
        text
    ?! JSONRPCError(.invalid-params, "tools/call needs a string \"name\"")
?! JSONRPCError(.invalid-params, "\"arguments\" must be an object")
    if params has "arguments" && !(params["arguments"]! is [String = JSON])

. progress-token = mcp-meta(rpc)["progressToken"] as JSON
. call = MCPToolCall
    - rpc
    - headers
    - name
    - json-object(params["arguments"])
    - progress-token
    - tool(name)
    - updates
. result = service.call-tool(call)
    catch error JSONRPCError
        ?! error
    catch error Error
        MCPToolResult(error.message, true)
= complete(result.json)

────────────────────
_ do cacheable [String = JSON]
    - fields [String = JSON]

fields["ttlMs"] = cache-ttl as Int
fields["cacheScope"] = "public"
= complete(fields)

────────────────────
_ do complete [String = JSON]
    - fields [String = JSON]

. info = Map'String'JSON
    • name name
    • version version
. meta = Map'String'JSON
    • "io.modelcontextprotocol/serverInfo" info
fields["resultType"] = "complete"
fields["_meta"] = meta
= fields

────────────────────
_ is-allowed-origin Bool
    - origin String?

!origin || allowed-origins has origin || is-loopback-origin(origin)

━━━━━━━━━━━━━━━━━━━━
_ MCPCallRunner

+ task Task?

━━━━━━━━━━━━━━━━━━━━
_ MCPProtocolError is JSONRPCError

+ status HTTPStatus
+ id JSONRPCID?

────────────────────
+ This
    - status HTTPStatus
    - code JSONRPCErrorCode
    - text String
    - id JSONRPCID? = null
    - data JSON = null

message = text

━━━━━━━━━━━━━━━━━━━━
_ header-mismatch MCPProtocolError
    - text String
    - id JSONRPCID?

MCPProtocolError(HTTPStatus.bad-request, mcp-header-mismatch, "Header mismatch: $text", id)

━━━━━━━━━━━━━━━━━━━━
_ unsupported-version MCPProtocolError
    - requested String
    - supported [String]
    - id JSONRPCID?

MCPProtocolError
    - HTTPStatus.bad-request
    - mcp-unsupported-version
    - "Unsupported protocol version"
    - id
    - data

.. data = Map'String'JSON
    • supported List'JSON(each as JSON in supported)
    • requested requested

━━━━━━━━━━━━━━━━━━━━
_ initialize-version String
    - rpc JSONRPCRequest

match mcp-params(rpc)["protocolVersion"]
    | text String
        text
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ is-mcp-method
    - method String

method == "server/discover" || method == "tools/list" || method == "tools/call"

━━━━━━━━━━━━━━━━━━━━
_ is-handshake
    - rpc JSONRPCRequest

!(mcp-meta(rpc) has mcp-meta-version)

━━━━━━━━━━━━━━━━━━━━
_ is-handshake-method
    - method String

method == "initialize" || method == "ping" || method == "tools/list" || method == "tools/call"

━━━━━━━━━━━━━━━━━━━━
_ mcp-params [String = JSON]
    - rpc JSONRPCRequest

json-object(rpc.params)

━━━━━━━━━━━━━━━━━━━━
_ mcp-meta [String = JSON]
    - rpc JSONRPCRequest

json-object(mcp-params(rpc)["_meta"])

━━━━━━━━━━━━━━━━━━━━
_ json-object [String = JSON]
    - value JSON?

match value
    | fields [String = JSON]
        fields
    ??
        Map'String'JSON()

━━━━━━━━━━━━━━━━━━━━
_ mcp-header-value String ?! SyntaxError
    - value String

|? !(value.starts-with("=?base64?") && value.ends-with("?="))
    value
??
    decode-base64(value[9 .. < value.length - 2]).slice-string()

━━━━━━━━━━━━━━━━━━━━
_ is-loopback-origin
    - origin String

match origin
    ~ ("http://" | "https://") ("localhost" | "127.0.0.1" | "[::1]") (":" [0-9]+)?
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
_ mcp-http-response HTTPResponse
    - status HTTPStatus
    - response JSONRPCResponse

HTTPResponse(status, "$response", headers)

.. headers [HTTPHeader] =
    * "Content-Type", "application/json"
