/ai
/data/json
/os/path

━━━━━━━━━━━━━━━━━━━━
+ do run-archive-bench-open Size ?! Error
    - name String
    - turns Size
    - draws Bool
    - rounds Size

. directory = archive-bench-directory(name)
do finally clean-archive-bench-directory(directory)
. chat = archive-bench-chat("chat-1", turns, draws)
archive-bench-save(AIChatDatabase(directory), chat)
. checksum Size = 0
for round in 0 .. < rounds
    . archive = AIChatDatabase(directory)
    checksum += archive.load-index(null).length
    checksum += archive-bench-checksum(archive.load(chat.id))
= checksum

━━━━━━━━━━━━━━━━━━━━
+ do run-archive-bench-save Size ?! Error
    - name String
    - turns Size
    - draws Bool

. directory = archive-bench-directory(name)
do finally clean-archive-bench-directory(directory)
. archive = AIChatDatabase(directory)
. chat = AIChat("chat-1")
for turn in 0 .. < turns
    chat = append-chat-message(chat, "root", archive-bench-prompt(chat, turn))
    archive-bench-save(archive, chat)
    chat = append-chat-message(chat, "root", archive-bench-reply(chat, turn, draws))
    archive-bench-save(archive, chat)
= archive-bench-checksum(AIChatDatabase(directory).load(chat.id))

━━━━━━━━━━━━━━━━━━━━
_ do archive-bench-save ?! Error
    - archive AIChatDatabase
    - chat AIChat

archive.save(chat, "echo") • is-listed true

━━━━━━━━━━━━━━━━━━━━
_ do archive-bench-checksum Size
    - chat AIChat

. total Size = 0
for branch in chat.branches
    for message in branch.messages
        total += message.parts.length + message.id.length
= total

━━━━━━━━━━━━━━━━━━━━
_ do archive-bench-chat AIChat ?! AIError
    - id String
    - turns Size
    - draws Bool

. chat = AIChat(id)
for turn in 0 .. < turns
    chat = append-chat-message(chat, "root", archive-bench-prompt(chat, turn))
    chat = append-chat-message(chat, "root", archive-bench-reply(chat, turn, draws))
= chat

━━━━━━━━━━━━━━━━━━━━
_ archive-bench-prompt AIChatMessage
    - chat AIChat
    - turn Size

AIChatMessage
    - chat-message-id(chat, turn * 2 + 1)
    - AIMessageRole.user
    - "Please look at step $turn of the plan and fix whatever still fails."
    - "2026-08-21T00:00:00Z"

━━━━━━━━━━━━━━━━━━━━
_ do archive-bench-reply AIChatMessage
    - chat AIChat
    - turn Size
    - draws Bool

. parts = List'AIMessagePart()
. steps Size = if draws then 9 else 40
for step in 0 .. < steps
    . key = "${turn}-$step"
    if step % 3 != 2
        parts += AIReasoningPart
            - "reasoning-$key"
            - "Checking step $step before running it."
            - null
            - archive-bench-signature(key) as JSON
    parts += AIToolCallPart("call-$key", "toolu-$key", "Bash", archive-bench-arguments(key))
    parts += archive-bench-result(key, draws, step == 0)
    if step % 5 == 0
        parts += AITextPart
            - "text-$key"
            - "Step $step passes now; the remaining failure is in the parser."
= AIChatMessage
    - chat-message-id(chat, turn * 2 + 2)
    - AIMessageRole.assistant
    - parts
    - "2026-08-21T00:00:00Z"
    - "claude-opus-5-5"
    - null
    - AIFinishReason.stop

━━━━━━━━━━━━━━━━━━━━
_ archive-bench-signature String
    - key String

"EqQBCkgIBxABGAIqQ$key" ++ ("Zm9yIHRoZSBiZW5jaCBzaWduYXR1cmUgYmxvY2sgb2YgYmFzZTY0IHRleHQgaGVyZQ" * 40)

━━━━━━━━━━━━━━━━━━━━
_ archive-bench-arguments JSON
    - key String

Map'String'JSON
    • command "cd /Users/me/Code/project && bin/run test --selector file:tests/step-${key}.test --verbose --no-cache" * 3
    • description "Run the failing test for step $key"

━━━━━━━━━━━━━━━━━━━━
_ do archive-bench-result AIToolResultPart
    - key String
    - draws Bool
    - has-image Bool

. text = "src/parser/step-${key}.yumi:12: expected an expression after the arrow, found a newline\n" * 16
=? AIToolResultPart("result-$key", "toolu-$key", text, text) if !draws
. items = List'JSON()
if has-image
    items += archive-bench-image(key)
items += archive-bench-text-item(text)
= AIToolResultPart("result-$key", "toolu-$key", items, text)

━━━━━━━━━━━━━━━━━━━━
_ archive-bench-text-item JSON
    - text String

Map'String'JSON
    • type "text"
    • text text

━━━━━━━━━━━━━━━━━━━━
_ archive-bench-image JSON
    - key String

Map'String'JSON
    • type "image"
    • source source

.. source = Map'String'JSON
    • type "base64"
    • "media_type" "image/png"
    • data "iVBORw0KGgoAAAANSUhEUgAA$key" ++ ("QUJDREVGR0hJSktMTU5PUFFSU1RVVldYWVphYmNkZWZnaGlqa2xtbm9wcXJzdHV2d3h5ejAxMjM0NTY3ODkrLw" * 2000)

━━━━━━━━━━━━━━━━━━━━
_ do archive-bench-directory Path
    - name String

. directory = Path("/tmp/ai-archive-bench-${name}-${Task().id}", 0)
clean-archive-bench-directory(directory)
= directory

━━━━━━━━━━━━━━━━━━━━
_ do clean-archive-bench-directory
    - directory Path

=? if !directory.exists
for child in directory.contents
    child.delete()
directory.delete()
