(import /ai)
(import /math)
(import /os/path)
(import /time/datetime)
(import /time/timer)
(import /time/timestamp)
(import /time/zone)
(blank)
(prop _ chat-search-bench-page Size (= 30))
(prop _ chat-search-bench-start _ (= 1704067200))
(prop _ chat-search-bench-active Size (= 40))
(prop _ chat-search-bench-done Size (= 160))
(prop _ chat-search-bench-rare _ (= "quokka"))
(prop _ chat-search-bench-common _ (= "the"))
(prop _ chat-search-bench-letter _ (= "t"))
(prop _ chat-search-bench-letters _ (= "th"))
(prop _ chat-search-bench-words _ (= "parser failing test"))
(prop _ chat-search-bench-typed _ (= "parser"))
(prop _ chat-search-bench-repeats Size (= 5))
(prop _ chat-search-bench-vocabulary Size (= 30000))
(prop _ chat-search-bench-lexicon _
  (=
    (paragraph
      "the to and a of is in it that i for this you with be on not can if we so are as but at run from should file test now will by or use one there code error have what an all when change then fix just here into which line was new would also my need see more function do like has make only check out build add these up some value type still first case path call return other them no each because how where works next work same its any instead before after both looks way back read update parser failing does source text name list output set string compiler rather version module step class field current command tool data write results keep passes branch commit"
    )
  )
)
(prop _ chat-search-bench-consonants _ (= "b d f g h k l m n p r s t v w z"))
(prop _ chat-search-bench-vowels _ (= "a e i o u"))

(type + ChatSearchBenchTimes (is Tuple)
  (prop + build-ms U64)
  (prop + text-kb U64)
  (prop + database-kb U64)
  (prop + rare-us U64)
  (prop + common-us U64)
  (prop + letter-us U64)
  (prop + letters-us U64)
  (prop + words-us U64)
  (prop + page-us U64)
  (prop + keystroke-us U64)
  (prop + keystroke-max-us U64)
  (prop + keystroke-calls-us U64)
  (prop + checksum U64)
)

(type + ChatSearchBenchBuild (is Tuple)
  (prop + build-ms U64)
  (prop + text-kb U64)
  (prop + database-kb U64)
)

(fn-do + run-chat-search-bench ChatSearchBenchTimes (?! Error)
  (param count Size)
  (let directory (call temporary-directory "chat-search-bench"))
  (finally
    (inline (call clean-chat-search-bench directory))
  )
  (let built (call build-chat-search-bench directory count))
  (let database (call AIChatDatabase directory))
  (let check (call ChatSearchBenchCheck))
  (let rare-us (call chat-search-bench-case database chat-search-bench-rare null check))
  (let common-us (call chat-search-bench-case database chat-search-bench-common null check))
  (let letter-us (call chat-search-bench-case database chat-search-bench-letter null check))
  (let letters-us (call chat-search-bench-case database chat-search-bench-letters null check))
  (let words-us (call chat-search-bench-case database chat-search-bench-words null check))
  (let first
    (call (. database search)
      (block
        (arg chat-search-bench-common)
        (arg (. AIChatPlace archived))
        (arg null)
        (arg null)
        (arg chat-search-bench-page)
      )
    )
  )
  (let page-us
    (call chat-search-bench-case
      (block
        (arg database)
        (arg chat-search-bench-common)
        (arg (. ([] first (- (. first length) 1)) summary))
        (arg check)
      )
    )
  )
  (let typing (call chat-search-bench-typing database check true))
  (let calls (call chat-search-bench-typing database (call ChatSearchBenchCheck) false))
  (return
    (call ChatSearchBenchTimes
      (block
        (arg (. built build-ms))
        (arg (. built text-kb))
        (arg (. built database-kb))
        (arg rare-us)
        (arg common-us)
        (arg letter-us)
        (arg letters-us)
        (arg words-us)
        (arg page-us)
        (arg (. typing mean-us))
        (arg (. typing max-us))
        (arg (. calls mean-us))
        (arg (. check value))
      )
    )
  )
)

(fn-do + build-chat-search-bench ChatSearchBenchBuild (?! Error)
  (param directory Path)
  (param count Size)
  (let started (call monotonic-time-nanoseconds))
  (let database (call AIChatDatabase directory))
  (let words (call ChatSearchWords 20261110))
  (let text-bytes Size 0)
  (for (in index (..< 0 count))
    (let chat (call chat-search-bench-chat index words))
    (+= text-bytes (call chat-search-bench-text-size chat))
    (call (. database save) chat "echo" (:is-listed true))
  )
  (for (in index (..< 0 count))
    (let age (- count 1 index))
    (if (>= age chat-search-bench-active)
      (call (. database mark-done) (str "chat-" index) true)
    )
    (if (>= age (+ chat-search-bench-active chat-search-bench-done))
      (call (. database mark-archived) (str "chat-" index) true)
    )
  )
  (let build-ms (/ (- (call monotonic-time-nanoseconds) started) 1000000))
  (let size (+ (. (/ directory "chats.db") stat size) (. (/ directory "chats.db-wal") stat size)))
  (return (call ChatSearchBenchBuild build-ms (/ (as text-bytes U64) 1024) (/ (as size U64) 1024)))
)

(type _ ChatSearchBenchTyping (is Tuple)
  (prop + mean-us U64)
  (prop + max-us U64)
)

(type _ ChatSearchBenchCheck
  (prop + value U64)
  (fn-do + add _
    (param found (list AIChatFound))
    (for (in position (..< 0 (. found length)))
      (let item ([] found position))
      (= value (+ (* value 31) (* (as (?? (. item summary activity active-at) 0) U64) (as (+ position 1) U64))))
      (for (in span (. item snippet))
        (= value (+ (* value 7) (as (. span text size) U64) (if-expr (. span is-match) 1 0)))
      )
    )
  )
)

(fn-do _ chat-search-bench-case U64 (?! Error)
  (param database AIChatDatabase)
  (param text String)
  (param after (? AIChatSummary))
  (param check ChatSearchBenchCheck)
  (call (. check add) (call (. database search) text (. AIChatPlace archived) null after chat-search-bench-page))
  (let started (call monotonic-time-nanoseconds))
  (for (in repeat (..< 0 chat-search-bench-repeats))
    (call (. database search) text (. AIChatPlace archived) null after chat-search-bench-page)
  )
  (return (/ (- (call monotonic-time-nanoseconds) started) 1000 (as chat-search-bench-repeats U64)))
)

(fn-do _ chat-search-bench-typing ChatSearchBenchTyping (?! Error)
  (param database AIChatDatabase)
  (param check ChatSearchBenchCheck)
  (param is-grouped Bool)
  (let typed chat-search-bench-typed)
  (let totals (call (of List U64)))
  (for (in length (.. 1 (. typed length)))
    (+= totals 0)
  )
  (for (in repeat (..< 0 chat-search-bench-repeats))
    (for (in length (.. 1 (. typed length)))
      (let started (call monotonic-time-nanoseconds))
      (call chat-search-bench-keystroke database ([] typed (..< 0 length)) check is-grouped)
      (+= ([] totals (- length 1)) (- (call monotonic-time-nanoseconds) started))
    )
  )
  (let total U64)
  (let most U64)
  (for (in spent totals)
    (+= total spent)
    (= most (call max most spent))
  )
  (let runs (as chat-search-bench-repeats U64))
  (return (call ChatSearchBenchTyping (/ total 1000 runs (as (. totals length) U64)) (/ most 1000 runs)))
)

(fn-do _ chat-search-bench-keystroke _ (?! Error)
  (param database AIChatDatabase)
  (param text String)
  (param check ChatSearchBenchCheck)
  (param is-grouped Bool)
  (if is-grouped
    (for (in group (call (. database search-places) text null chat-search-bench-page))
      (call (. check add) (. group found))
    )
    (else
      (for (in place (list (. AIChatPlace active) (. AIChatPlace done) (. AIChatPlace archived)))
        (call (. check add) (call (. database search) text place null null chat-search-bench-page))
      )
    )
  )
)

(fn-do _ chat-search-bench-chat AIChat (?! AIError)
  (param index Size)
  (param words ChatSearchWords)
  (let chat (call AIChat (str "chat-" index) "root" (call (. words text) 5)))
  (let start (+ chat-search-bench-start (* index 3600)))
  (for (in turn (..< 0 4))
    (let at (+ start (* turn 600)))
    (let prompt
      (call AIChatMessage
        (block
          (arg (call chat-message-id chat (+ (* turn 2) 1)))
          (arg (. AIMessageRole user))
          (arg (call (. words text) 70))
          (arg (call chat-search-bench-stamp at))
        )
      )
    )
    (= chat (call append-chat-message chat "root" prompt))
    (let reply (call AITextPart (str "text-" index "-" turn) (call chat-search-bench-reply index turn words)))
    (let answer
      (call AIChatMessage
        (block
          (arg (call chat-message-id chat (+ (* turn 2) 2)))
          (arg (. AIMessageRole assistant))
          (arg (call (of List AIMessagePart) reply))
          (arg (call chat-search-bench-stamp (+ at 60)))
          (arg "claude-opus-5-5")
          (arg null)
          (arg (. AIFinishReason stop))
        )
      )
    )
    (= chat (call append-chat-message chat "root" answer))
  )
  (return chat)
)

(fn-do _ chat-search-bench-reply String
  (param index Size)
  (param turn Size)
  (param words ChatSearchWords)
  (let text (call (. words text) 400))
  (return-if (str text " " chat-search-bench-rare) (if (and (== (% index 1000) 500) (== turn 2))))
  (return text)
)

(fn-expr _ chat-search-bench-stamp Timestamp
  (param seconds Int)
  (as (call DateTime seconds utc) ISO8601)
)

(fn-do _ chat-search-bench-text-size Size
  (param chat AIChat)
  (let total (?? (?. (. chat title) size) 0))
  (for (in branch (. chat branches))
    (for (in message (. branch messages))
      (+= total (. (call ai-parts-text (. message parts)) size))
    )
  )
  (return total)
)

(fn-do _ clean-chat-search-bench _
  (param directory Path)
  (return-if (if (not (. directory exists))))
  (for (in child (. directory contents))
    (call (. child delete))
  )
  (call (. directory delete))
)

(type _ ChatSearchWords
  (prop + state U64)
  (prop + words (list String))
  (prop + weights (list F64))
  (fn-do + This _
    (param state _)
    (lazy words (call chat-search-bench-vocabulary-words state))
    (lazy weights (call chat-search-bench-weights (. words length)))
  )
  (fn-do + text String
    (param count Size)
    (let picked (call (of List String)))
    (for (in index (..< 0 count))
      (+= picked (call word))
    )
    (return (call (. " " join) picked))
  )
  (fn-do + word String
    (let target (* (/ (as (call next) F64) 2147483648.0) ([] weights (- (. weights length) 1))))
    (let low Size 0)
    (let high (- (. weights length) 1))
    (while (< low high)
      (let middle (/ (+ low high) 2))
      (if (< ([] weights middle) target)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return ([] words low))
  )
  (fn-do + next U64
    (= state (+ (* state 6364136223846793005) 1442695040888963407))
    (return (/zrshift/ state 33))
  )
)

(fn-do _ chat-search-bench-vocabulary-words (list String)
  (param seed U64)
  (let words (call (of List String) (call (. chat-search-bench-lexicon split) " ")))
  (let consonants (call (of List String) (call (. chat-search-bench-consonants split) " ")))
  (let vowels (call (of List String) (call (. chat-search-bench-vowels split) " ")))
  (let state seed)
  (while (< (. words length) chat-search-bench-vocabulary)
    (= state (+ (* state 6364136223846793005) 1442695040888963407))
    (let bits (/zrshift/ state 20))
    (let syllables (as (+ 2 (% bits 2)) Size))
    (let word "")
    (for (in syllable (..< 0 syllables))
      (let chosen (as (/zrshift/ bits (+ 1 (* (as syllable U64) 7))) Size))
      (= word
        (scope (str word consonant ([] vowels (% (/ chosen (. consonants length)) (. vowels length))))
          (lazy consonant ([] consonants (% chosen (. consonants length))))
        )
      )
    )
    (+= words word)
  )
  (return words)
)

(fn-do _ chat-search-bench-weights (list F64)
  (param count Size)
  (let weights (call (of List F64)))
  (let total F64)
  (for (in rank (..< 0 count))
    (+= total (/ 1.0 (as (+ rank 1) F64)))
    (+= weights total)
  )
  (return weights)
)
