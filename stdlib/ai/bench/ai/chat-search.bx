; benchmark.meta description: Builds a 5,000-chat archive of about 9 KB of Zipf-distributed text per chat, then times full-text search: a rare word, a common word, one- and two-letter prefixes, three words, a second page, and typing a word with all three places searched per keystroke, in one grouped call and in one call per place.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: chat-search
(blank)
(import /ai/bench/fixtures/chat-search-bench-fixture)
(blank)

(main
  (let times (call run-chat-search-bench 5000))
  (probe-count ai.bench.search.build-ms-5k (. times build-ms))
  (probe-count ai.bench.search.text-kb-5k (. times text-kb))
  (probe-count ai.bench.search.database-kb-5k (. times database-kb))
  (probe-count ai.bench.search.rare-us-5k (. times rare-us))
  (probe-count ai.bench.search.common-us-5k (. times common-us))
  (probe-count ai.bench.search.letter-us-5k (. times letter-us))
  (probe-count ai.bench.search.letters-us-5k (. times letters-us))
  (probe-count ai.bench.search.words-us-5k (. times words-us))
  (probe-count ai.bench.search.page-us-5k (. times page-us))
  (probe-count ai.bench.search.keystroke-us-5k (. times keystroke-us))
  (probe-count ai.bench.search.keystroke-max-us-5k (. times keystroke-max-us))
  (probe-count ai.bench.search.keystroke-calls-us-5k (. times keystroke-calls-us))
  (blank)
  (print (str "bench-result ai/chat-search checksum=" (. times checksum)))
)
