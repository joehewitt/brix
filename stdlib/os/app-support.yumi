./bundle
./env
./path

+ main-app-id String := main-bundle-id ?? executable-name()

━━━━━━━━━━━━━━━━━━━━
+ app-support-path
    - app-id String

Path(env("HOME") ?? "/tmp", 0) / "Library" / "Application Support" / app-id

━━━━━━━━━━━━━━━━━━━━
_ executable-name String

if path then path.name else "brix"

.. path = catch? executable-path()
