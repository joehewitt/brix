(import ./file)
(import /BxCore/BxSystem.h)
(import /BxEvents/BxEvents.h)
(import /unistd.h)
(blank)
(prop + memory-pressure _ (= (call MemoryPressureStream)))

(type + MemoryPressure (is Union)
  (variant warning)
  (variant critical)
)

(type _ MemoryPressureStream
  (implements (of Usable Void))
  (prop _ fd I32 (= -1))
  (blank)
  (delegate (of Broadcastable MemoryPressure))
  (prop _ channel _ (:= (call (of AsyncOnDemandChannel MemoryPressure) this)))
  (fn-do + begin-using _
    (let watched (call C:brixWatchMemoryPressure))
    (return-if (if (< watched 0)))
    (= fd watched)
    (do-new
      (while true
        (call wait-until-readable watched)
        (let level (call C:brixTakeMemoryPressure watched))
        (if (< level 0)
          (break)
        )
        (if (> level 1)
          (<- channel (. MemoryPressure critical))
          (else-if (> level 0)
            (<- channel (. MemoryPressure warning))
          )
        )
      )
      (call C:brixReleaseEventDescriptor watched)
      (call C:close watched)
    )
  )
  (fn-do + end-using _
    (call C:brixUnwatchMemoryPressure fd)
    (= fd -1)
  )
)
