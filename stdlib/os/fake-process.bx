(import ./file)
(import ./process)
(import /errno.h)
(import /signal.h)
(import /sys/socket.h)
(import /unistd.h)

(type + FakeProcessRun
  (prop + program String)
  (prop + arguments (list String))
  (prop + directory String)
  (prop + variables (map String String))
  (prop + input File)
  (prop + output File)
  (prop + errors File)
  (fn-do + This _
    (param program String)
    (param arguments (list String))
    (param directory String)
    (param variables (map String String))
    (param input File)
    (param output File)
    (param errors File)
  )
  (fn-do + say _
    (param line String)
    (call (. output write) (str line "\n"))
  )
  (fn-do + complain _
    (param line String)
    (call (. errors write) (str line "\n"))
  )
)

(type + FakeProcessScript (is (fn-type Int (?! Error) (param run FakeProcessRun))))

(type + FakeProcess
  (prop + script FakeProcessScript)
  (prop + replaced (list (list String)))
  (prop _ children (list FakeChild))
  (prop _ next-pid Int (= 100000))
  (prop _ lock _ (= (call Mutex)))
  (fn-do + This _
    (param script FakeProcessScript)
  )
  (fn-do + spawn-process I32
    (param name String)
    (param argv ([] String))
    (param envp ([] String))
    (param directory String)
    (param streams ([] I32))
    (param passed ([] I32))
    (param leads-group Bool)
    (let input (call fake-stream ([] streams 0) 0 (. FileFlags read-mode)))
    (let output (call fake-stream ([] streams 1) 1 (. FileFlags write-mode)))
    (let errors (call fake-stream ([] streams 2) 2 (. FileFlags write-mode)))
    (let run (call FakeProcessRun name (call fake-arguments argv) directory (call fake-variables envp) input output errors))
    (return (call start run))
  )
  (fn-do + spawn-pty I32
    (param executable String)
    (param argv ([] String))
    (param envp ([] String))
    (param directory String)
    (param columns Size)
    (param rows Size)
    (param terminal ([] I32))
    (let ends ([] I32 2))
    (return-if (- C:EMFILE) (if (== (call C:socketpair C:AF_UNIX C:SOCK_STREAM 0 ends) -1)))
    (blank)
    (= ([] terminal 0) ([] ends 0))
    (let run
      (call FakeProcessRun
        (block
          (arg executable)
          (arg (call fake-arguments argv))
          (arg directory)
          (arg (call fake-variables envp))
          (arg (call File ([] ends 1)))
          (arg (call File (call C:dup ([] ends 1))))
          (arg (call File (call C:dup ([] ends 1))))
        )
      )
    )
    (return (call start run))
  )
  (fn-do + signal-process I32
    (param pid Int)
    (param signal I32)
    (let child (call child-with (if-expr (< pid 0) (- pid) pid)))
    (return-if -1 (if (not child)))
    (return-if 0 (if (or (== signal 0) (== signal C:SIGSTOP) (== signal C:SIGCONT))))
    (blank)
    (do
      (use lock)
      (return-if 0 (if (. child has-exited)))
      (= (. child signal) signal)
    )
    (call (?. (. child task) cancel))
    (return 0)
  )
  (fn-do + wait-for-process-exit Bool
    (param pid Int)
    (param listener Pointer)
    (let child (call child-with pid))
    (return-if false (if (not child)))
    (blank)
    (let waiter (call FakeWaiter listener))
    (do
      (use lock)
      (return-if false (if (. child has-exited)))
      (+= (. child waiters) waiter)
    )
    (let got (call (. waiter semaphore await)))
    (return (not (?? got false)))
  )
  (fn-do + cancel-process-exit-listener _
    (param pid Int)
    (param listener Pointer)
    (let child (call child-with pid))
    (return-if (if (not child)))
    (blank)
    (use lock)
    (let kept (list FakeWaiter))
    (for (in waiter (. child waiters))
      (if (== (. waiter listener) listener)
        (call (. waiter semaphore post) false)
        (else
          (+= kept waiter)
        )
      )
    )
    (= (. child waiters) kept)
  )
  (fn-do + reap-process I32
    (param pid Int)
    (param usage ([] ProcessUsage))
    (let child (call child-with pid))
    (return-if C:ECHILD (if (not child)))
    (blank)
    (use lock)
    (return-if C:ECHILD (if (not (. child has-exited))))
    (blank)
    (= ([] usage 0) (call ProcessUsage (. child code) (as (. child signal) I64) 0 0 0 0 0))
    (let kept (list FakeChild))
    (for (in each children)
      (if (!= (. each pid) pid)
        (+= kept each)
      )
    )
    (= children kept)
    (return 0)
  )
  (fn-do + list-processes Int
    (param by-group Bool)
    (param value Int)
    (param pids ([] I32))
    (param capacity Size)
    (return 0)
  )
  (fn-do + process-directory (? String)
    (param pid Int)
    (let child (call child-with pid))
    (return-if null (if (not child)))
    (return (. (!! child) run directory))
  )
  (fn-do + replace-process I32
    (param path String)
    (param argv ([] String))
    (let given (list String))
    (+= given path)
    (++= given (call fake-arguments argv))
    (do
      (use lock)
      (+= replaced given)
    )
    (return -1)
  )
  (fn-do _ start I32
    (param run FakeProcessRun)
    (let child (call adopt run))
    (= (. child task)
      (do-new
        (inline (call play child))
      )
    )
    (return (as (. child pid) I32))
  )
  (fn-do _ adopt FakeChild
    (param run FakeProcessRun)
    (use lock)
    (let made (call FakeChild next-pid run))
    (+= next-pid 1)
    (+= children made)
    (return made)
  )
  (fn-do _ play _
    (param child FakeChild)
    (finally
      (inline (call finish child))
    )
    (let outcome (catch (call script (. child run))))
    (= (. child code) (if-expr (is outcome Int) (as outcome Int) 1))
  )
  (fn-do _ finish _
    (param child FakeChild)
    (do
      (inline (call (. child run input close)))
    )
    (do
      (inline (call (. child run output close)))
    )
    (do
      (inline (call (. child run errors close)))
    )
    (use lock)
    (= (. child has-exited) true)
    (for (in waiter (. child waiters))
      (call (. waiter semaphore post) true)
    )
    (= (. child waiters) (call (of List FakeWaiter)))
  )
  (fn-do _ child-with (? FakeChild)
    (param pid Int)
    (use lock)
    (for (in each children)
      (return-if each (if (== (. each pid) pid)))
    )
    (return null)
  )
)

(type _ FakeChild
  (prop + pid Int)
  (prop + run FakeProcessRun)
  (prop + task (? Task))
  (prop + code I64)
  (prop + signal I32)
  (prop + has-exited _ (= false))
  (prop + waiters (list FakeWaiter))
  (fn-do + This _
    (param pid Int)
    (param run FakeProcessRun)
  )
)

(type _ FakeWaiter
  (prop + listener Pointer)
  (prop + semaphore _ (= (call (of Semaphore Bool))))
  (fn-do + This _
    (param listener Pointer)
  )
)

(fn-do _ fake-stream File (?! Error)
  (param given I32)
  (param standard I32)
  (param mode FileFlags)
  (if (== given discarded-stream)
    (return (call File "/dev/null" mode))
  )
  (return (call File (call C:dup (if-expr (== given inherited-stream) standard given))))
)

(fn-do _ fake-arguments (list String)
  (param argv ([] String))
  (let arguments (list String))
  (for (in index (..< 1 (- (. argv length) 1)))
    (+= arguments ([] argv index))
  )
  (return arguments)
)

(fn-do _ fake-variables (map String String)
  (param envp ([] String))
  (let variables (call (of Map String String)))
  (for (in index (..< 0 (- (. envp length) 1)))
    (let entry ([] envp index))
    (let split (call (. entry find) "="))
    (if split
      (= ([] variables ([] entry (..< 0 split))) ([] entry (... (+ split 1))))
    )
  )
  (return variables)
)
