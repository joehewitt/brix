(import ./file)
(import ./outbox)
(import /string.h)
(blank)
(prop + message-header-size Size (= 8))
(prop _ message-buffer-size Size (= 65536))

(type + Message (is Tuple)
  (prop + kind U32)
  (prop + bytes ([] Byte))
  (fn-expr + data Pointer :get
    (. bytes data)
  )
  (fn-expr + size Size :get
    (. bytes size)
  )
  (fn-do + (of record Record) (? Record)
    (param offset Size (= 0))
    (return-if null (if (> (+ offset (. Record size)) (. bytes size))))
    (return ([] (as (+ (. bytes data) offset) (of CPointer Record)) 0))
  )
  (fn-expr + text String
    (param offset Size (= 0))
    (if-expr (>= offset (. bytes size)) "" (call (. bytes slice-string) (..< offset (. bytes size))))
  )
)

(type + MessageChannel
  (implements Closable)
  (prop + file File)
  (prop _ outbox Outbox)
  (prop _ is-reading _ (= true))
  (prop _ is-closed _ (= false))
  (prop _ buffer _ (= ([] Byte message-buffer-size)))
  (prop _ start Size)
  (prop _ filled Size)
  (fn-do + This _
    (param file _)
    (lazy outbox (call Outbox file))
  )
  (fn-expr + is-open Bool :get
    (and is-reading (not (. outbox has-failed)))
  )
  (fn-do + close _
    (return-if (if is-closed))
    (= is-closed true)
    (= is-reading false)
    (if (. outbox is-idle)
      (catch (call (. file close)))
      (return)
    )
    (= (. outbox on-drained) (=> () (catch (call (. file close)))))
  )
  (fn-do + send _
    (param kind U32)
    (param data (? Pointer) (= null))
    (param size Size (= 0))
    (param tail (? Pointer) (= null))
    (param tail-size Size (= 0))
    (return-if (if (not is-open)))
    (let packet ([] Byte (+ message-header-size size tail-size)))
    (let words (as (. packet data) (of CPointer U32)))
    (= ([] words 0) kind)
    (= ([] words 1) (as (+ size tail-size) U32))
    (let head data)
    (if (and head (> size 0))
      (call C:memcpy (as (+ (. packet data) message-header-size) Pointer) head size)
    )
    (let rest tail)
    (if (and rest (> tail-size 0))
      (call C:memcpy (as (+ (. packet data) message-header-size size) Pointer) rest tail-size)
    )
    (call (. outbox send) packet)
  )
  (fn-do + (of send-record Record) _
    (param kind U32)
    (param record Record)
    (param tail (? Pointer) (= null))
    (param tail-size Size (= 0))
    (let copy record)
    (call send kind (as &copy Pointer) (. Record size) tail tail-size)
  )
  (fn-do + send-text _
    (param kind U32)
    (param text String)
    (param data (? Pointer) (= null))
    (param size Size (= 0))
    (call send kind data size (as text Pointer) (. text size))
  )
  (fn-do + receive (? Message)
    (while true
      (let message (call take))
      (return-if message (if message))
      (return-if null (if (not (call fill true))))
    )
  )
  (fn-do + poll (? Message)
    (let message (call take))
    (return-if message (if message))
    (call fill false)
    (return (call take))
  )
  (fn-do _ take (? Message)
    (let available (- filled start))
    (return-if null (if (< available message-header-size)))
    (let header (as (+ (. buffer data) start) (of CPointer U32)))
    (let kind ([] header 0))
    (let length (as ([] header 1) Size))
    (if (> (+ message-header-size length) (. buffer size))
      (call compact)
      (= buffer (call (. buffer resize) (+ message-header-size length)))
    )
    (return-if null (if (< available (+ message-header-size length))))
    (let bytes ([] Byte length))
    (if (> length 0)
      (call C:memcpy (as (. bytes data) Pointer) (as (+ (. buffer data) start message-header-size) Pointer) length)
    )
    (+= start (+ message-header-size length))
    (if (== start filled)
      (= start 0)
      (= filled 0)
    )
    (return (call Message kind bytes))
  )
  (fn-do _ compact _
    (return-if (if (== start 0)))
    (let remaining (- filled start))
    (if (> remaining 0)
      (call C:memmove (as (. buffer data) Pointer) (as (+ (. buffer data) start) Pointer) remaining)
    )
    (= start 0)
    (= filled remaining)
  )
  (fn-do _ fill Bool
    (param waits Bool)
    (return-if false (if (not is-reading)))
    (call compact)
    (if (== filled (. buffer size))
      (= buffer (call (. buffer resize) (* (. buffer size) 2)))
    )
    (let count
      (call read-more waits
        (block
          (on-error (: failure IOError)
            (= is-reading false)
            (return false)
          )
        )
      )
    )
    (return-if false (if (== count null)))
    (if (== count 0)
      (= is-reading false)
      (return false)
    )
    (+= filled count)
    (return true)
  )
  (fn-do _ read-more (? Size) (?! IOError)
    (param waits Bool)
    (let space (- (. buffer size) filled))
    (if waits
      (return (call (. file read) space ([] buffer (... filled))))
    )
    (return (call (. file read-available) space ([] buffer (... filled))))
  )
)
