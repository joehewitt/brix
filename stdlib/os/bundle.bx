(import /BxEvents/BxEvents.h)
(blank)
(prop _ main-bundle-buffer-size I64 (= 256))
(blank)
(prop + main-bundle-id (? String) (:= (call main-bundle-string "CFBundleIdentifier")))
(prop + main-bundle-name (? String) (:= (call main-bundle-string "CFBundleName")))

(fn-do _ main-bundle-string (? String)
  (param key String)
  (let buffer ([] Byte main-bundle-buffer-size))
  (let length (call C:brixMainBundleString key buffer main-bundle-buffer-size))
  (if (< length 0)
    (return null)
  )
  (if (> length main-bundle-buffer-size)
    (= buffer ([] Byte length))
    (call C:brixMainBundleString key buffer length)
  )
  (return (call (. buffer slice-string) (..< 0 (as length Size))))
)
