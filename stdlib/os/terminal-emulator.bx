(import /BxTerminal/BxTerminal.h)
(import /gc/gc)
(blank)
(prop + terminal-event-bell U32 (= 1))
(prop + terminal-event-title U32 (= 2))
(prop + terminal-event-pwd U32 (= 4))
(prop + terminal-event-reset U32 (= 8))
(blank)
(prop + terminal-run-bold U32 (= 1))
(prop + terminal-run-italic U32 (= 2))
(prop + terminal-run-faint U32 (= 4))
(prop + terminal-run-underline U32 (= 8))
(prop + terminal-run-strike U32 (= 16))
(prop + terminal-run-overline U32 (= 32))
(prop + terminal-run-invisible U32 (= 64))
(prop + terminal-run-blink U32 (= 128))
(prop + terminal-run-wide U32 (= 256))
(prop + terminal-run-isolated U32 (= 512))
(prop + terminal-run-sprite U32 (= 1024))
(prop + terminal-run-background U32 (= 32768))
(blank)
(prop + terminal-dirty-none _ (= 0))
(prop + terminal-dirty-partial _ (= 1))
(prop + terminal-dirty-full _ (= 2))
(blank)
(prop + terminal-cursor-bar _ (= 0))
(prop + terminal-cursor-block _ (= 1))
(prop + terminal-cursor-underline _ (= 2))
(prop + terminal-cursor-block-hollow _ (= 3))
(blank)
(prop + terminal-mods-shift U32 (= 1))
(prop + terminal-mods-control U32 (= 2))
(prop + terminal-mods-alt U32 (= 4))
(prop + terminal-mods-super U32 (= 8))
(prop + terminal-mods-caps-lock U32 (= 16))
(blank)
(prop _ terminal-run-fields Size (= 7))
(prop _ terminal-mode-alternate-scroll U32 (= 1007))
(prop _ terminal-mode-synchronized-output U32 (= 2026))

(type + TerminalKeyAction (is U32)
  (variant release)
  (variant press)
  (variant repeat)
)

(type + TerminalMouseAction (is U32)
  (variant press)
  (variant release)
  (variant motion)
)

(type + TerminalMouseButton (is U32)
  (variant none)
  (variant left)
  (variant right)
  (variant middle)
  (variant wheel-up)
  (variant wheel-down)
  (variant wheel-left)
  (variant wheel-right)
)

(type + TerminalRun (is Tuple)
  (prop + column Size)
  (prop + columns Size)
  (prop + foreground U32)
  (prop + background U32)
  (prop + flags U32)
  (prop + text String)
  (fn-expr + has-background Bool :get
    (!= (/and/ flags terminal-run-background) 0)
  )
  (fn-expr + has-flag Bool
    (param flag U32)
    (!= (/and/ flags flag) 0)
  )
)

(type + TerminalRow (is Tuple)
  (prop + y Int)
  (prop + runs (list TerminalRun))
  (prop + selection-start Int)
  (prop + selection-end Int)
  (prop + wraps Bool)
)

(type + TerminalCursor (is Tuple)
  (prop + is-visible Bool)
  (prop + column Size)
  (prop + row Size)
  (prop + style Int)
  (prop + is-blinking Bool)
)

(type + TerminalColors (is Tuple)
  (prop + foreground U32)
  (prop + background U32)
  (prop + cursor U32)
)

(type + TerminalScrollbar (is Tuple)
  (prop + total Size)
  (prop + offset Size)
  (prop + length Size)
)

(type + TerminalEmulator
  (implements Closable)
  (prop + columns Size)
  (prop + rows Size)
  (blank)
  (prop _ handle (? Pointer))
  (prop _ cleanup (? CleanupHandle))
  (prop _ byte-buffer ([] Byte) (= ([] Byte 4096)))
  (prop _ run-buffer ([] U32) (= ([] U32 512)))
  (prop _ text-buffer ([] Byte) (= ([] Byte 2048)))
  (prop _ int-buffer ([] I32) (= ([] I32 8)))
  (prop _ word-buffer ([] U32) (= ([] U32 8)))
  (fn-do + This _
    (param columns Size)
    (param rows Size)
    (param scrollback-lines Size (= 10000))
    (= (. this columns) columns)
    (= (. this rows) rows)
    (let native (call C:brixTerminalCreate columns rows scrollback-lines))
    (throw (call Error "Unable to create terminal emulator") (if (== native (call Pointer))))
    (= handle native)
    (= cleanup (call on-reclaim this native release-terminal-emulator))
  )
  (fn-expr + is-open Bool :get
    (!= handle null)
  )
  (fn-do + close _
    (if handle
      (call (?. cleanup cancel))
      (call release-terminal-emulator (!! handle))
      (= handle null)
    )
  )
  (fn-do + reset _
    (return-if (if (not handle)))
    (call C:brixTerminalReset handle)
  )
  (fn-do + resize _
    (param columns Size)
    (param rows Size)
    (param cell-width Size)
    (param cell-height Size)
    (return-if (if (not handle)))
    (= (. this columns) columns)
    (= (. this rows) rows)
    (call C:brixTerminalResize (!! handle) columns rows cell-width cell-height)
  )
  (fn-do + write (? ([] Byte))
    (param bytes ([] Byte))
    (param length Size)
    (return-if null (if (not handle)))
    (call C:brixTerminalWrite handle bytes length)
    (return (call take-replies))
  )
  (fn-do + take-replies (? ([] Byte))
    (return-if null (if (not handle)))
    (let length (as (call C:brixTerminalReplyLength handle) Size))
    (return-if null (if (== length 0)))
    (let replies ([] Byte length))
    (call C:brixTerminalTakeReplies (!! handle) replies length)
    (return replies)
  )
  (fn-do + take-events U32
    (return-if 0 (if (not handle)))
    (return (call C:brixTerminalTakeEvents handle))
  )
  (fn-do + title String :get
    (return-if "" (if (not handle)))
    (let length (as (call C:brixTerminalCopyTitle handle byte-buffer (. byte-buffer length)) Size))
    (return-if "" (if (== length 0)))
    (if (> length (. byte-buffer length))
      (= byte-buffer ([] Byte length))
      (call C:brixTerminalCopyTitle (!! handle) byte-buffer length)
    )
    (return (call (. byte-buffer slice-string) (..< 0 length)))
  )
  (fn-do + pwd String :get
    (return-if "" (if (not handle)))
    (let length (as (call C:brixTerminalCopyPwd (!! handle) byte-buffer (. byte-buffer length)) Size))
    (return-if "" (if (== length 0)))
    (if (> length (. byte-buffer length))
      (= byte-buffer ([] Byte length))
      (call C:brixTerminalCopyPwd (!! handle) byte-buffer length)
    )
    (return (call (. byte-buffer slice-string) (..< 0 length)))
  )
  (fn-do + set-colors _
    (param foreground U32)
    (param background U32)
    (param cursor U32)
    (param palette ([] U32))
    (return-if (if (not handle)))
    (call C:brixTerminalSetColors handle foreground background cursor palette (. palette length))
  )
  (fn-do + set-dark _
    (param is-dark Bool)
    (return-if (if (not handle)))
    (call C:brixTerminalSetDark handle is-dark)
  )
  (fn-expr + mode-enabled Bool
    (param mode U32)
    (param is-ansi _ (= false))
    (if-expr (not handle) false (call C:brixTerminalModeEnabled handle mode is-ansi))
  )
  (fn-expr + is-alternate-scrolling Bool :get
    (call mode-enabled terminal-mode-alternate-scroll)
  )
  (fn-expr + is-synchronizing Bool :get
    (call mode-enabled terminal-mode-synchronized-output)
  )
  (fn-expr + is-mouse-tracking Bool :get
    (if-expr handle (call C:brixTerminalMouseTracking handle) false)
  )
  (fn-expr + is-alternate-screen Bool :get
    (if-expr handle (call C:brixTerminalIsAlternateScreen handle) false)
  )
  (fn-expr + is-viewport-at-bottom Bool :get
    (if-expr handle (call C:brixTerminalViewportAtBottom handle) true)
  )
  (fn-do + scroll-by _
    (param rows Int)
    (return-if (if (not handle)))
    (call C:brixTerminalScrollDelta handle rows)
  )
  (fn-do + scroll-to-top _
    (return-if (if (not handle)))
    (call C:brixTerminalScrollTop handle)
  )
  (fn-do + scroll-to-bottom _
    (return-if (if (not handle)))
    (call C:brixTerminalScrollBottom handle)
  )
  (fn-do + scroll-to-row _
    (param row Size)
    (return-if (if (not handle)))
    (call C:brixTerminalScrollRow handle row)
  )
  (fn-do + scrollbar TerminalScrollbar :get
    (return-if (call TerminalScrollbar 0 0 0) (if (not handle)))
    (call C:brixTerminalScrollbar handle word-buffer)
    (return (call TerminalScrollbar ([] word-buffer 0) ([] word-buffer 1) ([] word-buffer 2)))
  )
  (fn-do + render-update Int
    (return-if terminal-dirty-none (if (not handle)))
    (return (call C:brixTerminalRenderUpdate handle))
  )
  (fn-do + cursor TerminalCursor :get
    (return-if (call TerminalCursor false 0 0 terminal-cursor-block false) (if (not handle)))
    (call C:brixTerminalRenderCursor handle int-buffer)
    (return
      (call TerminalCursor
        (block
          (arg (!= ([] int-buffer 0) 0))
          (arg ([] int-buffer 1))
          (arg ([] int-buffer 2))
          (arg ([] int-buffer 3))
          (arg (!= ([] int-buffer 4) 0))
        )
      )
    )
  )
  (fn-do + colors TerminalColors :get
    (return-if (call TerminalColors 0 0 0) (if (not handle)))
    (call C:brixTerminalRenderColors handle word-buffer)
    (return (call TerminalColors ([] word-buffer 0) ([] word-buffer 1) ([] word-buffer 2)))
  )
  (fn-do + render-rows (list TerminalRow)
    (param dirty-only Bool)
    (let rendered (list TerminalRow))
    (return-if rendered (if (not handle)))
    (call C:brixTerminalRenderBeginRows handle dirty-only)
    (while true
      (let y (call C:brixTerminalRenderNextRow (!! handle)))
      (return-if rendered (if (< y 0)))
      (+= rendered (call read-row y))
    )
    (return rendered)
  )
  (fn-do + render-clean _
    (return-if (if (not handle)))
    (call C:brixTerminalRenderClean handle)
  )
  (fn-do + encode-key (? ([] Byte))
    (param key-code U32)
    (param mods U32)
    (param action U32)
    (param text (? String))
    (param unshifted U32 (= 0))
    (return-if null (if (not handle)))
    (let input (?? text ""))
    (let length
      (call C:brixTerminalEncodeKey
        (block
          (arg handle)
          (arg key-code)
          (arg mods)
          (arg action)
          (arg input)
          (arg (. input size))
          (arg unshifted)
          (arg byte-buffer)
          (arg (. byte-buffer length))
        )
      )
    )
    (return (call encoded length))
  )
  (fn-do + encode-mouse (? ([] Byte))
    (param action U32)
    (param button U32)
    (param mods U32)
    (param x F32)
    (param y F32)
    (return-if null (if (not handle)))
    (let length
      (call C:brixTerminalEncodeMouse
        (block
          (arg handle)
          (arg action)
          (arg button)
          (arg mods)
          (arg x)
          (arg y)
          (arg byte-buffer)
          (arg (. byte-buffer length))
        )
      )
    )
    (return (call encoded length))
  )
  (fn-do + encode-paste (? ([] Byte))
    (param text String)
    (return-if null (if (or (not handle) (== (. text size) 0))))
    (let length (as (call C:brixTerminalEncodePaste handle text (. text size) byte-buffer (. byte-buffer length)) Size))
    (if (> length (. byte-buffer length))
      (= byte-buffer ([] Byte length))
      (= length (call C:brixTerminalEncodePaste (!! handle) text (. text size) byte-buffer (. byte-buffer length)))
    )
    (return (call encoded length))
  )
  (fn-do + encode-focus (? ([] Byte))
    (param is-focused Bool)
    (return-if null (if (not handle)))
    (let length (call C:brixTerminalEncodeFocus handle is-focused byte-buffer (. byte-buffer length)))
    (return (call encoded length))
  )
  (fn-do + select-press _
    (param column Size)
    (param row Size)
    (param x F64)
    (param y F64)
    (return-if (if (not handle)))
    (call C:brixTerminalSelectPress handle column row x y)
  )
  (fn-do + select-drag _
    (param column Size)
    (param row Size)
    (param x F64)
    (param y F64)
    (param is-rectangle _ (= false))
    (return-if (if (not handle)))
    (call C:brixTerminalSelectDrag handle column row x y is-rectangle)
  )
  (fn-do + select-release _
    (param column Size)
    (param row Size)
    (return-if (if (not handle)))
    (call C:brixTerminalSelectRelease handle column row)
  )
  (fn-do + select-all _
    (return-if (if (not handle)))
    (call C:brixTerminalSelectAll handle)
  )
  (fn-do + clear-selection _
    (return-if (if (not handle)))
    (call C:brixTerminalSelectClear handle)
  )
  (fn-expr + has-selection Bool :get
    (if-expr handle (call C:brixTerminalHasSelection handle) false)
  )
  (fn-do + selection-text (? String)
    (return-if null (if (not handle)))
    (let length (as (call C:brixTerminalCopySelection handle byte-buffer (. byte-buffer length)) Size))
    (return-if null (if (== length 0)))
    (if (> length (. byte-buffer length))
      (= byte-buffer ([] Byte length))
      (call C:brixTerminalCopySelection (!! handle) byte-buffer length)
    )
    (return (call (. byte-buffer slice-string) (..< 0 length)))
  )
  (fn-do + all-text (? String)
    (return-if null (if (not handle)))
    (let length (as (call C:brixTerminalCopyAll handle byte-buffer (. byte-buffer length)) Size))
    (return-if null (if (== length 0)))
    (return-if (call (. byte-buffer slice-string) (..< 0 length)) (if (<= length (. byte-buffer length))))
    (let bytes ([] Byte length))
    (call C:brixTerminalCopyAll (!! handle) bytes length)
    (return (call (. bytes slice-string) (..< 0 length)))
  )
  (fn-do _ encoded (? ([] Byte))
    (param length Size)
    (return-if null (if (or (== length 0) (> length (. byte-buffer length)))))
    (let bytes ([] Byte length))
    (for (in index (..< 0 length))
      (= ([] bytes index) ([] byte-buffer index))
    )
    (return bytes)
  )
  (fn-do _ read-row TerminalRow
    (param y Int)
    (let count (as (call C:brixTerminalRowRunCount (!! handle)) Size))
    (let text-length (as (call C:brixTerminalRowTextLength (!! handle)) Size))
    (if (> (* count terminal-run-fields) (. run-buffer length))
      (= run-buffer ([] U32 (* count terminal-run-fields)))
    )
    (if (> text-length (. text-buffer length))
      (= text-buffer ([] Byte text-length))
    )
    (call C:brixTerminalRowCopy (!! handle) run-buffer text-buffer)
    (let runs (list TerminalRun))
    (for (in index (..< 0 count))
      (let base (* index terminal-run-fields))
      (let offset (as ([] run-buffer (+ base 5)) Size))
      (let length (as ([] run-buffer (+ base 6)) Size))
      (+= runs
        (call TerminalRun
          (block
            (arg ([] run-buffer base))
            (arg ([] run-buffer (+ base 1)))
            (arg ([] run-buffer (+ base 2)))
            (arg ([] run-buffer (+ base 3)))
            (arg ([] run-buffer (+ base 4)))
            (arg (call (. text-buffer slice-string) (..< offset (+ offset length))))
          )
        )
      )
    )
    (call C:brixTerminalRowInfo (!! handle) int-buffer)
    (let wraps (!= ([] int-buffer 3) 0))
    (return-if (call TerminalRow y runs -1 -1 wraps) (if (== ([] int-buffer 0) 0)))
    (return (call TerminalRow y runs ([] int-buffer 1) ([] int-buffer 2) wraps))
  )
)

(fn-do _ release-terminal-emulator _
  (param handle Pointer)
  (call C:brixTerminalRelease handle)
)
