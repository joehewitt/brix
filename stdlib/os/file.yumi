+ This
    - fd I32
    - is-non-blocking = true
    - cleanup-on-reclaim = true

this.fd = fd
if cleanup-on-reclaim
    cleanup = on-reclaim(this, fd, reclaim-file-descriptor)
` flags[non-block-mode] = is-non-blocking
set-flag(FileFlags.non-block-mode, is-non-blocking)

