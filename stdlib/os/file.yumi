────────────────────
+ do close

=? if fd < 0

. descriptor = fd
fd = -1
. maybe-cleanup = cleanup
if maybe-cleanup
    do maybe-cleanup.cancel()
    cleanup = null

C:brixReleaseEventDescriptor(descriptor)
C:close(descriptor)
    ?! IOError("Unable to close file")
        if it

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

if size == 0
    = 0

while 1
    . read-size = C:read(fd, buffer, size)
    if read-size >= 0
        = read-size

    . err = C:brixGetErrNo()
    if err == C:EBADF
        ` occurs when file was closed while waiting for read
        =
    else if err == C:EWOULDBLOCK
        wait-until-readable(fd)
    else if err != C:EINTR
        ?! IOError("Unable to read file")

────────────────────
+ do read-available Size? ?! IOError
    - size Size
    - buffer Byte[]

=? 0 if size == 0
while 1
    . read-size = C:read(fd, buffer, size)
    =? read-size if read-size >= 0
    . err = C:brixGetErrNo()
    =? 0 if err == C:EBADF
    =? null if err == C:EWOULDBLOCK
    ?! IOError("Unable to read file")
        if err != C:EINTR

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]
    - offset Index

if size == 0
    = 0

while 1
    . read-size = C:pread(fd, buffer, size, offset)
    if read-size >= 0
        = read-size

    . err = C:brixGetErrNo()
    if err == C:EBADF
        ` occurs when file was closed while waiting for read
        =
    else if err == C:EWOULDBLOCK
        wait-until-readable(fd)
    else if err != C:EINTR
        ?! IOError("Unable to read file")

