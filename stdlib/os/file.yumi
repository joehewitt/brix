────────────────────
+ do to Byte[]

. buffer, length = remaining-bytes()
= buffer[0 .. < length]

────────────────────
_ do remaining-bytes (Byte[], Size)

. position = C:lseek(fd, 0, 1)
. end-position = C:lseek(fd, 0, 2)
. capacity Size = 65536
if position >= 0 && end-position >= position
    C:lseek(fd, position, 0)
    . span = end-position - position
    capacity = span + 1
. buffer = Byte[capacity]
. length Size
while true
    if length == buffer.size
        buffer = buffer.resize(buffer.size * 2)
    . count = read(buffer.size - length, buffer[length ...])
        catch failure IOError
            ?! Panic(failure as String)
    if count == 0
        break
    length += count
= buffer, length

────────────────────
+ do write Size
    - buffer ImmutableArray'Byte
    - size Size

. total-size = size
while 1
    . wrote-size = C:write(fd, buffer, size)
    if wrote-size == size
        = total-size

    if wrote-size >= 0 && wrote-size < size
        wait-until-writable(fd)

        buffer = buffer + wrote-size
        size = size - wrote-size
    else if C:brixGetErrNo() == C:EWOULDBLOCK
        wait-until-writable(fd)
    else if C:brixGetErrNo() != C:EINTR
        ?! IOError("Unable to write file $fd")

────────────────────
+ do write Size
    - buffer ImmutableArray'Byte
    - size Size
    - offset Index

. total-size = size
while 1
    . wrote-size = C:pwrite(fd, buffer, size, offset)
    if wrote-size == size
        = total-size

    if wrote-size >= 0 && wrote-size < size
        wait-until-writable(fd)

        buffer = buffer + wrote-size
        size = size - wrote-size
        offset += wrote-size
    else if C:brixGetErrNo() == C:EWOULDBLOCK
        wait-until-writable(fd)
    else if C:brixGetErrNo() != C:EINTR
        ?! IOError("Unable to write file $fd")

` + flags[flag FileFlags]
────────────────────
+ has-flag
    - flag FileFlags

all-flags /and/ flag

` + flags[flag FileFlags] = truth Bool
────────────────────
+ do set-flag
    - flag FileFlags
    - truth Bool

. flags-now = all-flags
if truth
    if !(flags-now /and/ flag)
        C:brixfcntl(fd, C:F_SETFL, flags-now /or/ flag)
else
    if all-flags /and/ flag
        C:brixfcntl(fd, C:F_SETFL, flags-now /and/ (not(flag) as FileFlags))

