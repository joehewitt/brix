────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

if size == 0
    = 0

while 1
    . read-size = C:read(fd, buffer, size)
    if read-size > 0
        `  -- "READ $read-size of $size from $fd"
        = read-size
    `  else
    `      -- "CAN'T READ $read-size"

    . err = C:brixGetErrNo()
    `  -- "GOT ERR $err"
    if err == C:EBADF
        ` occurs when file was closed while waiting for read
        =
    else if err != C:EWOULDBLOCK && err != C:ENOTTY && err != 0
        ?! IOError("Unable to read file")

    wait-until-readable(fd)

    `  -- "resuming..."

━━━━━━━━━━━━━━━━━━━━
+ file-size-text String
    - size FileSize

|? size <= 0
    "Zero bytes"
|? size == 1
    "1 byte"
|? size < 1000
    "$size bytes"
|? size < 1000000
    file-size-scaled-text(size, 1000, "KB")
|? size < 1000000000
    file-size-scaled-text(size, 1000000, "MB")
??
    file-size-scaled-text(size, 1000000000, "GB")

━━━━━━━━━━━━━━━━━━━━
_ file-size-scaled-text String
    - size FileSize
    - unit FileSize
    - suffix String

|? whole >= 100 || tenth == 0
    "$whole $suffix"
??
    "$whole.$tenth $suffix"

.. whole = size / unit
.. tenth = (size % unit) * 10 / unit

