━━━━━━━━━━━━━━━━━━━━
+ do wait-until-readable ?! TimeoutError
    - fd I32
    - deadline Deadline?

if deadline
    check-wait(wait-for-handle(fd, false, deadline) as WaitResult)
else
    wait-until-readable(fd)

