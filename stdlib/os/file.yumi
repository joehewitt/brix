+ do handle-file-error
    - error

if error
    ?! current-file-error()

━━━━━━━━━━━━━━━━━━━━
+ current-file-error

Error(file-error-message(C:brixGetErrNo()))

━━━━━━━━━━━━━━━━━━━━
_ file-error-message
    - err Int

match err
    |= C:EACCES
        "Access denied"
    |= C:EEXIST
        "File already exists"
    |= C:ELOOP
        "Loop in symbolic links"
    |= C:EMLINK
        "Link max exceeded"
    |= C:ENOENT
        "Invalid path"
    |= C:ENOSPC
        "Out of space"
    |= C:ENOTDIR
        "Not a directoruy"
    |= C:ENAMETOOLONG
        "Name too long"
    ??
        "Error"

