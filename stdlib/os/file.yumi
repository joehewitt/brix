━━━━━━━━━━━━━━━━━━━━
+ do wait-until-writable ?! TimeoutError
    - fd I32
    - deadline Deadline?

if deadline
    check-wait(wait-for-handle(fd, true, deadline) as WaitResult)
else
    wait-until-writable(fd)

━━━━━━━━━━━━━━━━━━━━
_ do check-wait ?! TimeoutError
    - result WaitResult

check-task-cancelation(result == WaitResult.canceled)
?! TimeoutError()
    if result == WaitResult.timed-out

━━━━━━━━━━━━━━━━━━━━
_ WaitResult is U32

| ready = 0
| canceled = 1
| timed-out = 2
