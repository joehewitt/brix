+ user-read-perm FilePermissions = 256
+ user-write-perm FilePermissions = 128
+ user-exec-perm FilePermissions = 64
+ group-read-perm FilePermissions = 32
+ group-write-perm FilePermissions = 16
+ group-exec-perm FilePermissions = 8
+ other-read-perm FilePermissions = 4
+ other-write-perm FilePermissions = 2
+ other-exec-perm FilePermissions = 1
+ user-rwx-perm = user-read-perm /or/ user-write-perm /or/ user-exec-perm
+ group-rwx-perm = group-read-perm /or/ group-write-perm /or/ group-exec-perm
+ other-rwx-perm = other-read-perm /or/ other-write-perm /or/ other-exec-perm
+ all-rwx-perm = user-rwx-perm /or/ group-rwx-perm /or/ other-rwx-perm
+ user-rw-perm = user-read-perm /or/ user-write-perm
+ group-rw-perm = group-read-perm /or/ group-write-perm
+ other-rw-perm = other-read-perm /or/ other-write-perm
+ all-rw-perm = user-rw-perm /or/ group-rw-perm /or/ other-rw-perm
+ stdin := File(0, true, false)
+ stdout := File(1, true, false)
+ stderr := File(2, true, false)
+ console := stdout

+ FileOffset is Long
+ FileSize is Long

