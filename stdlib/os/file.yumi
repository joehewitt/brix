────────────────────
+ This ?! IOError
    - path String
    - mode = FileFlags.read-mode
    - perms = all-rw-perm

?! IOError("Unable to open file $path")
    if fd <= 0

= This(fd, true)

.. fd = C:brixopen(path, mode, perms)

────────────────────
+ This ?! IOError
    - path Path
    - mode = FileFlags.read-mode
    - perms = all-rw-perm

= This(path as String, mode, perms)

────────────────────
+ This
    - paths [String]
    - mode = FileFlags.read-mode
    - perms = all-rw-perm

for path in paths
    . fd = C:brixopen(path, mode, perms)
    if fd >= 0
        = This(fd, true)

