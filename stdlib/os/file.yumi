. bytes Byte[] = file
= bytes

━━━━━━━━━━━━━━━━━━━━
+ do write-file-atomically ?! Error
    - path Path
    - text String
    - perms = all-rw-perm

. temporary = Path("$path.${Task().id}.saving", 0)
do finally
    if temporary.exists
        catch temporary.delete()
. mode = FileFlags.write-mode + FileFlags.create-mode + FileFlags.truncate-mode
. file = File(temporary, mode, perms)
do use file
    file.write(text)
    ?! Error("Unable to flush $path")
        if file.flush()
temporary.move(path)

