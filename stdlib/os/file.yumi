    - cleanup-on-reclaim = true

` Raw descriptor construction adopts reclaim ownership by default, matching File(fd).
` Use file.tail() to share an existing File owner, or pass cleanup-on-reclaim = false to borrow.
file = File'Token(fd, is-non-blocking, cleanup-on-reclaim)

