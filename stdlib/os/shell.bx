(import ./env)
(import ./process)
(import /BxCore/BxString.h)
(import /core/tokenstream)
(import /time/duration)
(blank)
(prop _ login-shell-timeout _ (= 10s))
(prop _ login-shell-marker _ (= "__BRIX_LOGIN_SHELL_ENVIRONMENT__"))
(prop _ login-shell-skipped _ (= (list "PWD" "OLDPWD" "SHLVL" "_")))
(prop _ login-shell _ (:= (call LoginShellAdoption)))

(fn-do + login-shell-environment (map String String) (?! Error)
  (let shell (?? (call env "SHELL") "/bin/zsh"))
  (let script (str "printf " login-shell-marker "; /usr/bin/env -0; printf " login-shell-marker))
  (let arguments (list "-l" "-i" "-c" script))
  (let process (use (call Process shell (. ProcessStderr discard) arguments (:group (. ProcessGroup own)))))
  (call (. process close-input))
  (let watch (call LoginShellWatch process))
  (let output (call (. (call (of ChunkedTokenStream Byte) process) read)))
  (let status (?? (call (. process wait) null) -1))
  (call (. watch settle))
  (throw (call Error (str shell " timed out after " login-shell-timeout)) (if (. watch is-timed-out)))
  (throw (call Error (str shell " exited with status " status)) (if (!= status 0)))
  (throw (call Error (str shell " printed an environment that is not UTF-8")) (if (!= (call C:brixStringValidateUtf8 (. output data) (. output size)) 0)))
  (return (call login-shell-variables (call (. output slice-string))))
)

(fn-do + adopt-login-shell-environment _
  (call (. login-shell start))
)

(fn-do + await-login-shell-environment _
  (call (. login-shell wait))
)

(fn-do _ login-shell-variables (map String String) (?! Error)
  (param text String)
  (let start (call (. text find) login-shell-marker))
  (let end (call (. text find-reverse) login-shell-marker))
  (throw (call Error "The login shell printed no environment") (if (or (== start null) (== end null) (<= end start))))
  (blank)
  (let variables (call (of Map String String)))
  (for (in entry (call (. ([] text (..< (+ start (. login-shell-marker length)) end)) split) "\x00"))
    (let split (call (. entry find) "="))
    (if (!= split null)
      (let name ([] entry (..< 0 split)))
      (if (not (has login-shell-skipped name))
        (= ([] variables name) ([] entry (... (+ split 1))))
      )
    )
  )
  (return variables)
)

(type _ LoginShellAdoption
  (prop _ lock _ (= (call Mutex)))
  (prop _ is-pending _ (= false))
  (prop _ waiters (list Semaphore))
  (fn-do + start _
    (use lock)
    (return-if (if is-pending))
    (blank)
    (= is-pending true)
    (do-new
      (inline (call adopt))
    )
  )
  (fn-do + wait _
    (let waiter (call enroll))
    (call (?. waiter wait))
  )
  (fn-do _ enroll (? Semaphore)
    (use lock)
    (return-if null (if (not is-pending)))
    (blank)
    (let waiter (call Semaphore))
    (+= waiters waiter)
    (return waiter)
  )
  (fn-do _ adopt _
    (let found (catch? (call login-shell-environment)))
    (if found
      (for (in (tuple name value) found)
        (call set-env name value)
      )
    )
    (for (in waiter (call finish))
      (call (. waiter post))
    )
  )
  (fn-do _ finish (list Semaphore)
    (use lock)
    (= is-pending false)
    (let pending waiters)
    (= waiters (call (of List Semaphore)))
    (return pending)
  )
)

(type _ LoginShellWatch
  (prop + is-timed-out _ (= false))
  (blank)
  (prop _ process Process)
  (prop _ is-settled _ (= false))
  (prop _ timer (? Task))
  (fn-do + This _
    (param process _)
    (= timer
      (do-new
        (call watch)
      )
    )
  )
  (fn-do + settle _
    (= is-settled true)
    (call (?. timer cancel))
  )
  (fn-do _ watch _
    (call (. login-shell-timeout wait))
    (return-if (if is-settled))
    (blank)
    (= is-timed-out true)
    (call (. process kill-tree))
  )
)
