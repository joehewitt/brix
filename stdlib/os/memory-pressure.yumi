./file
/BxCore/BxSystem.h
/BxEvents/BxEvents.h
/unistd.h

+ memory-pressure = MemoryPressureStream()

━━━━━━━━━━━━━━━━━━━━
+ MemoryPressure is Union

| warning
| critical

━━━━━━━━━━━━━━━━━━━━
_ MemoryPressureStream
    is Usable'Void

_ fd I32 = -1

as Broadcastable'MemoryPressure for
_ channel := AsyncOnDemandChannel'MemoryPressure(this)

────────────────────
+ do begin-using

. watched = C:brixWatchMemoryPressure()
=? if watched < 0
fd = watched
do new
    while true
        wait-until-readable(watched)
        . level = C:brixTakeMemoryPressure(watched)
        if level < 0
            break
        if level > 1
            channel <- MemoryPressure.critical
        else if level > 0
            channel <- MemoryPressure.warning
    C:brixReleaseEventDescriptor(watched)
    C:close(watched)

────────────────────
+ do end-using

C:brixUnwatchMemoryPressure(fd)
fd = -1
