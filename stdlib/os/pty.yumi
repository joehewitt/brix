./env
./file
./process
./tty
/BxCore/BxCore.h
/data
/errno.h
/signal.h
/string.h
/sys/ioctl.h
/unistd.h

_ default-search-path = "/usr/bin:/bin:/usr/sbin:/sbin"

━━━━━━━━━━━━━━━━━━━━
+ Pty
    is Closable
    is WritableData

+ process Process
+ columns Size
+ rows Size

_ input File
_ output File
_ is-closed = false

────────────────────
+ This ?! Error
    - path String
    - columns Size
    - rows Size
    - args [String] = List'String()
    - directory String? = null
    - variables [String = String]? = null

. argv =
    * path
    ** args
    -> String[1 + args.length + 1]
. entries = variables ?? environment()
. envp =
    ** entries
    *> "${each[0]}=${each[1]}"
    -> String[entries.length + 1]
. master = I32[1]
. executable = executable-path(path, entries)
. pid = C:brixSpawnPty(executable, argv, envp, directory ?? "", columns, rows, master)
?! IOError("Unable to run $path: ${C:strerror(-pid)}")
    if pid < 0
. duplicate = C:dup(master[0])
if duplicate < 0
    C:kill(pid, C:SIGHUP)
    C:close(master[0])
    ?! IOError("Unable to open a terminal for $path")
this.columns = columns
this.rows = rows
input = File(master[0])
output = File(duplicate)
process = Process(pid, output, input)

────────────────────
+ get pid Int

process.pid

────────────────────
+ get foreground-group Int

C:tcgetpgrp(input.fd)

────────────────────
+ get has-foreground-job Bool

group > 0 && group != process.pid

.. group = foreground-group

────────────────────
+ do resize
    - columns Size
    - rows Size
    - pixel-width Size = 0
    - pixel-height Size = 0

=? if is-closed
this.columns = columns
this.rows = rows
. size = Winsize[1]
size[0] = Winsize(rows as Short, columns as Short, pixel-width as Short, pixel-height as Short)
C:brixioctl(input.fd, C:TIOCSWINSZ, size)

────────────────────
+ do read Size
    - size Size
    - buffer Byte[]

=? 0 if size == 0 || is-closed
while true
    . count = C:read(output.fd, buffer, size)
    =? count if count > 0
    =? 0 if count == 0
    . error = C:brixGetErrNo()
    =? 0 if error != C:EWOULDBLOCK && error != C:EINTR
    wait-until-readable(output.fd)
= 0

────────────────────
+ do read-available Size?
    - size Size
    - buffer Byte[]

=? 0 if size == 0 || is-closed
while true
    . count = C:read(output.fd, buffer, size)
    =? count if count >= 0
    . error = C:brixGetErrNo()
    =? null if error == C:EWOULDBLOCK
    =? 0 if error != C:EINTR
= 0

────────────────────
+ do wait Int?

= process.wait(null)

────────────────────
+ do hang-up

signal(C:SIGHUP)

────────────────────
+ do terminate

signal(C:SIGTERM)

────────────────────
+ do kill

signal(C:SIGKILL)

────────────────────
_ do signal
    - number I32

=? if is-closed
C:kill(-(process.pid as I32), number)

────────────────────
+ do close

=? if is-closed
hang-up()
is-closed = true
process.close()

────────────────────
+ do write Size
    - buffer Byte[]
    - size Size

=? 0 if is-closed
= input.write(buffer, size)

━━━━━━━━━━━━━━━━━━━━
+ do find-executable String?
    - name String
    - variables [String = String]

=? (name if C:access(name, C:X_OK) == 0) if name.find("/") != null
for directory in (variables["PATH"] ?? default-search-path).split(":")
    . candidate = if directory.length > 0 then "$directory/$name" else "./$name"
    =? candidate if C:access(candidate, C:X_OK) == 0
= null

━━━━━━━━━━━━━━━━━━━━
_ do executable-path String
    - name String
    - variables [String = String]

=? name if name.find("/") != null
= find-executable(name, variables) ?? name
