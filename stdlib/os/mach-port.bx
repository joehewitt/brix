(import /BxEvents/BxEvents.h)
(blank)
(prop _ mach-parcel-port-limit I32 (= 8))
(prop _ mach-parcel-byte-limit I32 (= 256))

(type + MachParcel (is Tuple)
  (prop + sender I32)
  (prop + ports (list U32))
  (prop + bytes ([] Byte))
)

(type + MachRendezvous
  (implements Closable)
  (prop + name String)
  (prop + port U32)
  (fn-do + This _ (?! IOError)
    (param name String)
    (let checked-in (call C:brixMachRendezvousCheckIn name))
    (throw (call IOError (str "Unable to check in the Mach rendezvous " name)) (if (== checked-in 0)))
    (return (call This name checked-in))
  )
  (fn-do _ This _
    (param name _)
    (param port _)
  )
  (fn-do + receive (? MachParcel)
    (return-if null (if (== port 0)))
    (let rights ([] U32 mach-parcel-port-limit))
    (let bytes ([] Byte mach-parcel-byte-limit))
    (let counts ([] I32 3))
    (return-if null (if (not (call C:brixMachReceiveParcel port rights mach-parcel-port-limit bytes mach-parcel-byte-limit counts))))
    (let ports (list U32))
    (for (in index (..< 0 ([] counts 0)))
      (+= ports ([] rights index))
    )
    (return (call MachParcel ([] counts 2) ports ([] bytes (..< 0 ([] counts 1)))))
  )
  (fn-do + close _
    (return-if (if (== port 0)))
    (call C:brixMachRendezvousClose port)
    (= port 0)
  )
)

(type + MachPort
  (implements Closable)
  (prop + port U32)
  (fn-do + This _ (?! IOError)
    (param name String)
    (let found (call C:brixMachRendezvousLookUp name))
    (throw (call IOError (str "Unable to find the Mach rendezvous " name)) (if (== found 0)))
    (return (call This found))
  )
  (fn-do _ This _
    (param port _)
  )
  (fn-do + send Bool
    (param rights (list U32))
    (param data (of CPointer Void))
    (param size Size)
    (return-if false (if (== port 0)))
    (return (call C:brixMachSendParcel port (. rights buffer-pointer) (. rights length) data size))
  )
  (fn-do + close _
    (return-if (if (== port 0)))
    (call C:brixMachPortRelease port)
    (= port 0)
  )
)

(fn-do + release-mach-right _
  (param port U32)
  (call C:brixMachPortRelease port)
)
