
/YuCore/YuSystem.h
/stdlib.h
/unistd.h

_ env-lock := Mutex()

━━━━━━━━━━━━━━━━━━━━
+ do env String?
    - name String

use env-lock
. value = C:getenv(name)
=? null if !value
= value as String

━━━━━━━━━━━━━━━━━━━━
+ do env-required
    - name String

=? env(name)
?! Error("$name variable not defined")

━━━━━━━━━━━━━━━━━━━━
+ do set-env
    - name String
    - value String

use env-lock
C:setenv(name, value, 1)

━━━━━━━━━━━━━━━━━━━━
+ do environment [String = String]

use env-lock
. variables = Map'String'String()
. entries = C:yumiEnvironment()
. index = 0
while true
    . entry = entries[index]
    if !entry
        break
    . text = entry as String
    . split = text.find("=")
    if split != null
        variables[text[0 .. < split]] = text[split + 1 ...]
    index += 1
= variables

━━━━━━━━━━━━━━━━━━━━
+ cwd String

C:getcwd(buf, 4096)

.. buf = Char8[4096]
