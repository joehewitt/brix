(import ./env)
(import ./file)
(import ./process)
(import ./tty)
(import /BxCore/BxCore.h)
(import /data)
(import /errno.h)
(import /signal.h)
(import /string.h)
(import /sys/ioctl.h)
(import /time/duration)
(import /unistd.h)
(blank)
(prop _ default-search-path _ (= "/usr/bin:/bin:/usr/sbin:/sbin"))

(type + Pty
  (implements Closable)
  (implements WritableData)
  (prop + process Process)
  (prop + columns Size)
  (prop + rows Size)
  (blank)
  (prop _ input File)
  (prop _ output File)
  (prop _ is-closed _ (= false))
  (prop _ has-exited _ (= false))
  (prop _ escalation (? Task))
  (fn-do + This _ (?! Error)
    (param path String)
    (param columns Size)
    (param rows Size)
    (param args (list String) (= (call (of List String))))
    (param directory (? String) (= null))
    (param variables (? (map String String)) (= null))
    (let argv
      (block
        (item path)
        (spread args)
        (pipe -> ([] String (+ 1 (. args length) 1)))
      )
    )
    (let entries (?? variables (call environment)))
    (let envp
      (block
        (spread entries)
        (pipe *> (str ([] each 0) "=" ([] each 1)))
        (pipe -> ([] String (+ (. entries length) 1)))
      )
    )
    (let master ([] I32 1))
    (let executable (call executable-path path entries))
    (let pid (call C:brixSpawnPty executable argv envp (?? directory "") columns rows master))
    (throw (call IOError (str "Unable to run " path ": " (call C:strerror (- pid)))) (if (< pid 0)))
    (let duplicate (call C:dup ([] master 0)))
    (if (< duplicate 0)
      (call C:kill pid C:SIGHUP)
      (call C:close ([] master 0))
      (throw (call IOError (str "Unable to open a terminal for " path)))
    )
    (= (. this columns) columns)
    (= (. this rows) rows)
    (= input (call File ([] master 0)))
    (= output (call File duplicate))
    (= process (call Process pid output input))
  )
  (fn-expr + pid Int :get
    (. process pid)
  )
  (fn-expr + foreground-group Int :get
    (call C:tcgetpgrp (. input fd))
  )
  (fn-expr + has-foreground-job Bool :get
    (and (> group 0) (!= group (. process pid)))
    (where
      (lazy group foreground-group)
    )
  )
  (fn-do + resize _
    (param columns Size)
    (param rows Size)
    (param pixel-width Size (= 0))
    (param pixel-height Size (= 0))
    (return-if (if is-closed))
    (= (. this columns) columns)
    (= (. this rows) rows)
    (let size ([] Winsize 1))
    (= ([] size 0) (call Winsize (as rows Short) (as columns Short) (as pixel-width Short) (as pixel-height Short)))
    (call C:brixioctl (. input fd) C:TIOCSWINSZ size)
  )
  (fn-do + read Size
    (param size Size)
    (param buffer ([] Byte))
    (return-if 0 (if (or (== size 0) is-closed)))
    (while true
      (let count (call C:read (. output fd) buffer size))
      (return-if count (if (> count 0)))
      (return-if 0 (if (== count 0)))
      (let error (call C:brixGetErrNo))
      (return-if 0 (if (and (!= error C:EWOULDBLOCK) (!= error C:EINTR))))
      (call wait-until-readable (. output fd))
    )
    (return 0)
  )
  (fn-do + read-available (? Size)
    (param size Size)
    (param buffer ([] Byte))
    (return-if 0 (if (or (== size 0) is-closed)))
    (while true
      (let count (call C:read (. output fd) buffer size))
      (return-if count (if (>= count 0)))
      (let error (call C:brixGetErrNo))
      (return-if null (if (== error C:EWOULDBLOCK)))
      (return-if 0 (if (!= error C:EINTR)))
    )
    (return 0)
  )
  (fn-do + wait (? Int)
    (let status (call (. process wait) null))
    (if (!= status null)
      (call exited)
    )
    (return status)
  )
  (fn-do + reap _
    (call (. process reap))
    (call exited)
  )
  (fn-do + hang-up _
    (call signal C:SIGHUP)
  )
  (fn-do + terminate _
    (call signal C:SIGTERM)
  )
  (fn-do + kill _
    (call signal C:SIGKILL)
  )
  (fn-do _ signal _
    (param number I32)
    (return-if (if (and is-closed has-exited)))
    (call C:kill (- (as (. process pid) I32)) number)
  )
  (fn-do + escalate _
    (param grace Seconds)
    (return-if (if (or has-exited escalation)))
    (= escalation
      (do-new @detached
        (call (. grace wait))
        (call terminate)
        (call (. grace wait))
        (call kill)
      )
    )
  )
  (fn-do + close _
    (return-if (if is-closed))
    (call hang-up)
    (= is-closed true)
    (call (. process close))
  )
  (fn-do + write Size
    (param buffer (of ImmutableArray Byte))
    (param size Size)
    (return-if 0 (if (== size 0)))
    (throw (call IOError "The terminal is closed") (if is-closed))
    (return (call (. input write) buffer size))
  )
  (fn-do _ exited _
    (= has-exited true)
    (call (?. escalation cancel-later))
  )
)

(fn-do + find-executable (? String)
  (param name String)
  (param variables (map String String))
  (return-if (only-if name (if (== (call C:access name C:X_OK) 0))) (if (!= (call (. name find) "/") null)))
  (for (in directory (call (. (?? ([] variables "PATH") default-search-path) split) ":"))
    (let candidate (if-expr (> (. directory length) 0) (str directory "/" name) (str "./" name)))
    (return-if candidate (if (== (call C:access candidate C:X_OK) 0)))
  )
  (return null)
)

(fn-do _ executable-path String
  (param name String)
  (param variables (map String String))
  (return-if name (if (!= (call (. name find) "/") null)))
  (return (?? (call find-executable name variables) name))
)
