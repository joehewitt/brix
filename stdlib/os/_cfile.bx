(import /time/clock)
(blank)
(prop + event-delete _ (= 0x0001))
(prop + event-write _ (= 0x0002))
(prop + event-extend _ (= 0x0004))
(prop + event-attrib _ (= 0x0008))
(prop + event-link _ (= 0x0010))
(prop + event-rename _ (= 0x0020))
(prop + event-revoke _ (= 0x0040))

(type + FileStat (is Tuple)
  (prop + dev U64)
  (prop + ino U64)
  (prop + mode U32)
  (prop + nlink U32)
  (prop + uid U32)
  (prop + gid U32)
  (prop + size I64)
  (prop + blocks I64)
  (prop + blksize I64)
  (prop + atime ClockTime)
  (prop + mtime ClockTime)
  (prop + ctime ClockTime)
  (prop + btime ClockTime)
)

(type + Glob (is Tuple)
  (prop + count Size)
  (prop + paths (of CPointer (of CPointer Char8)))
  (prop + handle Pointer)
)
