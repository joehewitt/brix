./env
./process
/YuCore/YuString.h
/core/tokenstream
/time/duration

_ login-shell-timeout = 10s
_ login-shell-marker = "__YUMI_LOGIN_SHELL_ENVIRONMENT__"
_ login-shell-skipped = ["PWD", "OLDPWD", "SHLVL", "_"]
_ login-shell := LoginShellAdoption()

━━━━━━━━━━━━━━━━━━━━
+ do login-shell-environment [String = String] ?! Error

. shell = env("SHELL") ?? "/bin/zsh"
. script = "printf $login-shell-marker; /usr/bin/env -0; printf $login-shell-marker"
. process = use Process(shell, ProcessStderr.discard, ["-l", "-i", "-c", script]) • group ProcessGroup.own
process.close-input()
. watch = LoginShellWatch(process)
. output = ChunkedTokenStream'Byte(process).read()
. status = process.wait(null) ?? -1
watch.settle()
?! Error("$shell timed out after $login-shell-timeout")
    if watch.is-timed-out
?! Error("$shell exited with status $status")
    if status != 0
?! Error("$shell printed an environment that is not UTF-8")
    if C:yumiStringValidateUtf8(output.data, output.size) != 0
= login-shell-variables(output.slice-string())

━━━━━━━━━━━━━━━━━━━━
+ do adopt-login-shell-environment

login-shell.start()

━━━━━━━━━━━━━━━━━━━━
+ do await-login-shell-environment

login-shell.wait()

━━━━━━━━━━━━━━━━━━━━
_ do login-shell-variables [String = String] ?! Error
    - text String

. start = text.find(login-shell-marker)
. end = text.find-reverse(login-shell-marker)
?! Error("The login shell printed no environment")
    if start == null || end == null || end <= start
. variables = Map'String'String()
for entry in text[start + login-shell-marker.length .. < end].split("\0")
    . split = entry.find("=")
    if split != null
        . name = entry[0 .. < split]
        if !(login-shell-skipped has name)
            variables[name] = entry[split + 1 ...]
= variables

━━━━━━━━━━━━━━━━━━━━
_ LoginShellAdoption

_ lock = Mutex()
_ is-pending = false
_ waiters [Semaphore]

────────────────────
+ do start

use lock
=? if is-pending
is-pending = true
do new adopt()

────────────────────
+ do wait

. waiter = enroll()
waiter?.wait()

────────────────────
_ do enroll Semaphore?

use lock
=? null if !is-pending
. waiter = Semaphore()
waiters += waiter
= waiter

────────────────────
_ do adopt

. found = catch? login-shell-environment()
if found
    for name, value in found
        set-env(name, value)
for waiter in finish()
    waiter.post()

────────────────────
_ do finish [Semaphore]

use lock
is-pending = false
. pending = waiters
waiters = List'Semaphore()
= pending

━━━━━━━━━━━━━━━━━━━━
_ LoginShellWatch

+ is-timed-out = false

_ process Process
_ is-settled = false
_ timer Task?

────────────────────
+ This
    - process

do new
    watch()

────────────────────
+ do settle

is-settled = true
timer?.cancel()

────────────────────
_ do watch

timer = get-active-task()
login-shell-timeout.wait()
=? if is-settled
is-timed-out = true
process.kill-tree()
