(import ./env)
(import ./outbox)
(import ./process)
(import ./pty)
(import ./terminal-emulator)
(import ./terminal-path)
(import /time/duration)
(import /time/timer)
(blank)
(prop _ terminal-read-size Size (= 65536))
(prop _ terminal-read-budget-ns U64 (= 4000000))
(prop _ terminal-sync-limit-ns U64 (= 1000000000))
(prop _ terminal-stop-grace _ (= 1500ms))
(prop _ terminal-newline-byte Byte (= 10))

(type + TerminalSession
  (implements Closable)
  (prop + emulator TerminalEmulator)
  (prop + directory String)
  (prop + shell String)
  (prop + title _ (= ""))
  (prop + revision Size (= 0))
  (prop + exit-code (? Int))
  (prop + is-running _ (= false))
  (event + bell TerminalSession)
  (event + exited Int)
  (blank)
  (prop _ pty (? Pty))
  (prop _ generation Size (= 0))
  (prop _ buffer _ (= ([] Byte terminal-read-size)))
  (prop _ outbox (? Outbox))
  (prop _ ends-line _ (= true))
  (prop _ is-shell _ (= false))
  (prop _ held-since (? U64))
  (prop _ is-hold-expired _ (= false))
  (prop _ hold-watcher (? Task))
  (fn-do + This _
    (param directory String)
    (param columns Size (= 80))
    (param rows Size (= 24))
    (= (. this directory) directory)
    (= shell (?? (call env "SHELL") "/bin/zsh"))
    (= emulator (call TerminalEmulator columns rows))
  )
  (fn-do + start _ (?! Error)
    (return-if (if pty))
    (blank)
    (= is-shell true)
    (let opened (call open shell (list "-l") (call terminal-environment)))
    (let current generation)
    (do-new @detached
      (call pump opened current)
    )
  )
  (fn-do + execute (? Int) (?! Error)
    (param path String)
    (param args (list String))
    (param variables (map String String))
    (throw (call Error "A process is already running in this terminal") (if pty))
    (blank)
    (let opened (call open path args variables))
    (return (call pump opened generation))
  )
  (fn-do + working-directory String
    (let opened pty)
    (return-if directory (if (not opened)))
    (blank)
    (let group (. opened foreground-group))
    (let found (? String) null)
    (if (> group 0)
      (= found (call process-directory group))
    )
    (return (?? found (call process-directory (. opened pid)) directory))
  )
  (fn-do + resolve-link (? TerminalPathLink)
    (param text String)
    (let parsed (call terminal-path-link text))
    (let found (call terminal-resolve-file (. parsed path) (list (call working-directory) directory)))
    (return-if null (if (not found)))
    (return (call TerminalPathLink found (. parsed line) (. parsed column)))
  )
  (fn-do + interrupt _
    (let opened pty)
    (return-if (if (not opened)))
    (blank)
    (call (. opened hang-up))
    (call (. opened escalate) terminal-stop-grace)
  )
  (fn-do + restart _ (?! Error)
    (call stop)
    (call (. emulator reset))
    (+= revision 1)
    (call start)
  )
  (fn-do + clear _
    (call (. emulator reset))
    (call release-hold)
    (= ends-line true)
    (+= revision 1)
  )
  (fn-do + echo _
    (param text String)
    (let bytes (call (of Array Byte) text))
    (return-if (if (== (. bytes size) 0)))
    (blank)
    (call (. emulator write) bytes (. bytes size))
    (= ends-line (== ([] bytes (- (. bytes size) 1)) terminal-newline-byte))
    (+= revision 1)
  )
  (fn-do + clear-scrollback _
    (call (. emulator clear-selection))
    (let bytes (call (of Array Byte) "\x1b[H\x1b[2J\x1b[3J"))
    (let ignored (call (. emulator write) bytes (. bytes size)))
    (= ends-line true)
    (+= revision 1)
    (if (and is-shell is-running (not is-busy))
      (call send-text "\x0c")
    )
  )
  (fn-do + echo-line _
    (param text String)
    (if (not ends-line)
      (call echo "\r\n")
    )
    (call echo (str text "\r\n"))
  )
  (fn-do + send _
    (param bytes ([] Byte))
    (call (?. outbox send) bytes)
  )
  (fn-do + send-text _
    (param text String)
    (call send (call (of Array Byte) text))
  )
  (fn-do + resize _
    (param columns Size)
    (param rows Size)
    (param cell-width Size)
    (param cell-height Size)
    (return-if (if (and (== columns (. emulator columns)) (== rows (. emulator rows)))))
    (blank)
    (call (. emulator resize) columns rows cell-width cell-height)
    (call (?. pty resize) columns rows (* columns cell-width) (* rows cell-height))
    (+= revision 1)
  )
  (fn-expr + is-holding-frame Bool :get
    (!= held-since null)
  )
  (fn-expr + is-busy Bool :get
    (?? (?. pty has-foreground-job) false)
  )
  (fn-do + close _
    (call stop)
    (call (. emulator close))
  )
  (fn-do _ open Pty (?! Error)
    (param path String)
    (param args (list String))
    (param variables (map String String))
    (let opened (call Pty path (. emulator columns) (. emulator rows) args directory variables))
    (= pty opened)
    (= outbox (call Outbox opened))
    (= exit-code null)
    (= is-running true)
    (+= generation 1)
    (+= revision 1)
    (return opened)
  )
  (fn-do _ stop _
    (+= generation 1)
    (let opened pty)
    (= pty null)
    (call (?. outbox clear))
    (= outbox null)
    (= is-running false)
    (call release-hold)
    (return-if (if (not opened)))
    (blank)
    (call (. opened close))
    (call (. opened escalate) terminal-stop-grace)
  )
  (fn-do _ pump (? Int)
    (param opened Pty)
    (param current Size)
    (finally
      (inline (call (. opened reap)))
    )
    (while true
      (let count (call (. opened read) (. buffer length) buffer))
      (if (!= current generation)
        (let ignored (call (. opened wait)))
        (return null)
      )
      (if (== count 0)
        (break)
      )
      (let started (call monotonic-time-nanoseconds))
      (call absorb count)
      (while (< (- (call monotonic-time-nanoseconds) started) terminal-read-budget-ns)
        (let more (?? (call (. opened read-available) (. buffer length) buffer) 0))
        (if (== more 0)
          (break)
        )
        (call absorb more)
      )
      (call publish)
      (if (>= (- (call monotonic-time-nanoseconds) started) terminal-read-budget-ns)
        (call (. 1ms wait))
      )
    )
    (let code (?? (call (. opened wait)) -1))
    (return-if null (if (!= current generation)))
    (blank)
    (= pty null)
    (= outbox null)
    (= is-running false)
    (= exit-code code)
    (call (. opened close))
    (call release-hold)
    (+= revision 1)
    (<- exited code)
    (return code)
  )
  (fn-do _ absorb _
    (param count Size)
    (let replies (call (. emulator write) buffer count))
    (= ends-line (== ([] buffer (- count 1)) terminal-newline-byte))
    (if replies
      (call send replies)
    )
  )
  (fn-do _ publish _
    (call deliver-events)
    (if (not (. emulator is-synchronizing))
      (= is-hold-expired false)
      (else-if (not is-hold-expired)
        (call hold-frame)
        (return)
      )
    )
    (= held-since null)
    (+= revision 1)
  )
  (fn-do _ hold-frame _
    (return-if (if held-since))
    (blank)
    (= held-since (call monotonic-time-nanoseconds))
    (return-if (if (and hold-watcher (not (. hold-watcher is-finished)))))
    (blank)
    (= hold-watcher
      (do-new
        (call watch-hold)
      )
    )
  )
  (fn-do _ watch-hold _
    (while true
      (let since held-since)
      (if (not since)
        (break)
      )
      (let elapsed (- (call monotonic-time-nanoseconds) since))
      (if (>= elapsed terminal-sync-limit-ns)
        (= held-since null)
        (= is-hold-expired true)
        (+= revision 1)
        (break)
      )
      (call (. (as (- terminal-sync-limit-ns elapsed) Nanoseconds) wait))
    )
  )
  (fn-do _ release-hold _
    (= held-since null)
    (= is-hold-expired false)
  )
  (fn-do _ deliver-events _
    (let events (call (. emulator take-events)))
    (return-if (if (== events 0)))
    (blank)
    (if (!= (/and/ events terminal-event-title) 0)
      (= title (. emulator title))
    )
    (if (!= (/and/ events terminal-event-bell) 0)
      (<- bell this)
    )
  )
)

(fn-do + terminal-environment (map String String)
  (let variables (call environment))
  (= ([] variables "TERM") "xterm-256color")
  (= ([] variables "COLORTERM") "truecolor")
  (= ([] variables "TERM_PROGRAM") "Brix")
  (return variables)
)
