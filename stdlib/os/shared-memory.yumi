./file
/BxEvents/BxEvents.h
/unistd.h

━━━━━━━━━━━━━━━━━━━━
+ SharedMemory
    is Closable

+ name String
+ size Size
+ data Pointer
+ owned Bool

────────────────────
_ This
    - name
    - size
    - data
    - owned

────────────────────
+ do close

C:brixSharedMemoryUnmap(data, size)
if owned
    C:brixSharedMemoryUnlink(name)

━━━━━━━━━━━━━━━━━━━━
+ do create-shared-memory SharedMemory ?! IOError
    - name String
    - size Size

. fd = C:brixSharedMemoryCreate(name, size)
?! IOError("Unable to create shared memory $name")
    if fd < 0
. data = C:brixSharedMemoryMap(fd, size, true)
C:close(fd)
if !data
    C:brixSharedMemoryUnlink(name)
    ?! IOError("Unable to map shared memory $name")
= SharedMemory(name, size, data, true)

━━━━━━━━━━━━━━━━━━━━
+ do open-shared-memory SharedMemory ?! IOError
    - name String
    - size Size

. fd = C:brixSharedMemoryOpen(name)
?! IOError("Unable to open shared memory $name")
    if fd < 0
. data = C:brixSharedMemoryMap(fd, size, false)
C:close(fd)
C:brixSharedMemoryUnlink(name)
?! IOError("Unable to map shared memory $name")
    if !data
= SharedMemory(name, size, data, false)
