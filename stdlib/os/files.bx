  (claim C:rmdir)
  (claim C:link)
  (claim C:symlink)
  (claim C:chmod)
  (claim C:mkdir)
  (claim C:mkdtemp)
  (claim C:access)
  (claim C:brixPathWatchCreate)
  (claim C:brixSharedMemoryCreate)
