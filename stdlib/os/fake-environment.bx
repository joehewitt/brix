(import ./env)
(import ./path)

(type + FakeEnvironment
  (prop + variables (map String String))
  (prop + executable Path)
  (fn-do + This _
    (param variables (map String String) (= (call (of Map String String))))
    (param executable Path (= (call Path "/fake/bin/program" 0)))
  )
  (fn-do + env (? String)
    (param name String)
    (return ([] variables name))
  )
  (fn-do + set-env _
    (param name String)
    (param value String)
    (= ([] variables name) value)
  )
  (fn-do + environment (map String String)
    (return (call (of Map String String) variables))
  )
  (fn-do + executable-path Path (?! Error)
    (return executable)
  )
)
