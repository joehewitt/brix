/YuEvents/YuEvents.h

_ main-bundle-buffer-size I64 = 256

+ main-bundle-id String? := main-bundle-string("CFBundleIdentifier")
+ main-bundle-name String? := main-bundle-string("CFBundleName")

━━━━━━━━━━━━━━━━━━━━
_ do main-bundle-string String?
    - key String

. buffer = Byte[main-bundle-buffer-size]
. length = C:yumiMainBundleString(key, buffer, main-bundle-buffer-size)
if length < 0
    = null
if length > main-bundle-buffer-size
    buffer = Byte[length]
    C:yumiMainBundleString(key, buffer, length)
= buffer.slice-string(0 .. < (length as Size))
