(import ./env)
(import ./file)
(import /BxCore/BxCore.h)
(import /BxCore/BxSystem.h)
(import /BxEvents/BxEvents.h)
(import /data)
(import /fcntl.h)
(import /signal.h)
(import /string.h)
(import /unistd.h)
(blank)
(prop _ inherited-stream I32 (= -1))
(prop _ discarded-stream I32 (= -2))
(prop _ signaled-status-base _ (= 128))

(type + ProcessStderr (is Union)
  (variant inherit)
  (variant capture)
  (variant discard)
)

(type + ProcessStdio (is Union)
  (variant pipe)
  (variant inherit)
)

(type + ProcessGroup (is Union)
  (variant inherit)
  (variant own)
)

(type + ProcessPipe (is (tuple (: reader File) (: writer File))))

(type + ConnectedProcess (is (tuple (: process Process) (: socket File))))

(type + ProcessUsage (is Tuple)
  (prop + exit-code I64)
  (prop + signal I64)
  (prop + user-nanoseconds I64)
  (prop + system-nanoseconds I64)
  (prop + involuntary-switches I64)
  (prop + instructions U64)
  (prop + cycles U64)
)

(type + Process
  (implements (of Usable Void))
  (implements Closable)
  (implements (of ReadableData Char))
  (implements WritableData)
  (prop + pid Int)
  (prop + stderr (? File))
  (prop + leads-group Bool)
  (prop + closed _ (:= (call ProcessExitStream this)))
  (blank)
  (prop _ stdin (? File))
  (prop _ stdout (? File))
  (prop _ status Int)
  (prop _ reaped-usage (? ProcessUsage))
  (prop _ is-reaped Bool)
  (fn-do + This _
    (param pid Int)
    (param stdout (? File))
    (param stdin (? File))
    (param stderr (? File) (= null))
    (param leads-group _ (= false))
  )
  (fn-do + This _
    (param name String)
    (param ... args (list String) (= (call (of List String))))
    (return (call This name args))
  )
  (fn-do + This _ (?! Error)
    (param name String)
    (param args (list String))
    (param directory (? String) (= null))
    (param variables (? (map String String)) (= null))
    (return (call This name (. ProcessStderr inherit) args directory variables))
  )
  (fn-do + This _ (?! Error)
    (param name String)
    (param stderr-mode ProcessStderr)
    (param args (list String))
    (param directory (? String) (= null))
    (param variables (? (map String String)) (= null))
    (param descriptors (list I32) (= (call (of List I32))))
    (param stdio-mode ProcessStdio (= (. ProcessStdio pipe)))
    (param group ProcessGroup (= (. ProcessGroup inherit)))
    (param output-file (? File) (= null))
    (let captures-errors (== stderr-mode (. ProcessStderr capture)))
    (let pipes (== stdio-mode (. ProcessStdio pipe)))
    (let leads (== group (. ProcessGroup own)))
    (let argv
      (block
        (item name)
        (spread args)
        (pipe -> ([] String (+ 1 (. args length) 1)))
      )
    )
    (let entries (?? variables (call environment)))
    (let envp
      (block
        (spread entries)
        (pipe *> (str ([] each 0) "=" ([] each 1)))
        (pipe -> ([] String (+ (. entries length) 1)))
      )
    )
    (blank)
    (let passed (call duplicate-descriptors name descriptors))
    (finally
      (inline (call close-descriptors passed))
    )
    (let input ([] I32 2))
    (let output ([] I32 2))
    (if pipes
      (= input (call open-pipe name))
      (= output
        (call open-pipe name
          (block
            (on-error (: failure Error)
              (call close-pipe input)
              (throw failure)
            )
          )
        )
      )
    )
    (let errors ([] I32 2))
    (if captures-errors
      (= errors
        (call open-pipe name
          (block
            (on-error (: failure Error)
              (if pipes
                (call close-pipe input)
                (call close-pipe output)
              )
              (throw failure)
            )
          )
        )
      )
    )
    (blank)
    (let redirected (?? (?. output-file fd) inherited-stream))
    (let streams ([] I32 3))
    (= ([] streams 0) (if-expr pipes ([] input 0) inherited-stream))
    (= ([] streams 1) (if-expr pipes ([] output 1) redirected))
    (= ([] streams 2) redirected)
    (if captures-errors
      (= ([] streams 2) ([] errors 1))
      (else-if (== stderr-mode (. ProcessStderr discard))
        (= ([] streams 2) discarded-stream)
      )
    )
    (let passing ([] I32 (. passed length)))
    (for (in index (..< 0 (. passed length)))
      (= ([] passing index) ([] passed index))
    )
    (let child
      (call C:brixSpawn
        (block
          (arg name)
          (arg argv)
          (arg envp)
          (arg (?? directory ""))
          (arg streams)
          (arg passing)
          (arg (. passed length))
          (arg (if-expr leads 1 0))
        )
      )
    )
    (if (< child 0)
      (if pipes
        (call close-pipe input)
        (call close-pipe output)
      )
      (if captures-errors
        (call close-pipe errors)
      )
      (throw (call IOError (str "Unable to run " name ": " (call C:strerror (- child)))))
    )
    (blank)
    (let captured (? File))
    (if captures-errors
      (call C:close ([] errors 1))
      (= captured (call File ([] errors 0)))
    )
    (if (not pipes)
      (return (call This child null null captured leads))
    )
    (call C:close ([] input 0))
    (call C:close ([] output 1))
    (return (call This child (call File ([] output 0)) (call File ([] input 1)) captured leads))
  )
  (fn-expr + write _
    (param buffer (of ImmutableArray Byte))
    (param size Size)
    (call (. (!! stdin) write) buffer size)
  )
  (fn-do + wait (? Int)
    (param sem (? Semaphore))
    ; Waits for the process to end and gives its exit status. It gives none where the listener `sem`
    ; names is cancelled, and ends the waiting task where that task is cancelled. Every task that
    ; waits for the process at once receives the same status.
    (return-if status (if is-reaped))
    (blank)
    (let semaphore-pointer Pointer)
    (if sem
      (= semaphore-pointer (. sem native-pointer))
    )
    (if (not (call C:brixSuspendActiveTaskUntilProcExit pid semaphore-pointer))
      (call collect)
      (return status)
    )
    (call check-task-cancelation (. (call Task) is-cancel-in-force))
  )
  (fn-do + wait-usage (? ProcessUsage) (?! IOError)
    ; Waits for the process to end and gives its exit status with the resources it used. Where the
    ; process was already waited for, it gives what that wait collected.
    (return-if reaped-usage (if is-reaped))
    (blank)
    (if (call C:brixSuspendActiveTaskUntilProcExit pid null)
      (call check-task-cancelation (. (call Task) is-cancel-in-force))
      (return null)
    )
    (let error (call collect))
    (throw (call IOError (str "Unable to wait for process " pid ": " (call C:strerror error))) (if (!= error 0)))
    (return reaped-usage)
  )
  (fn-do _ collect I32
    (return-if 0 (if is-reaped))
    (blank)
    (let usage ([] ProcessUsage 1))
    (let error (call C:brixReapProcess pid usage))
    (return-if error (if (!= error 0)))
    (blank)
    (let reaped ([] usage 0))
    (= status (if-expr (!= (. reaped signal) 0) (+ signaled-status-base (. reaped signal)) (. reaped exit-code)))
    (= reaped-usage reaped)
    (= is-reaped true)
    (return 0)
  )
  (fn-do + terminate _
    (call send-signal C:SIGTERM)
  )
  (fn-do + kill _
    (call send-signal C:SIGKILL)
  )
  (fn-do + reap _
    ; Ends the process where it still runs, with SIGKILL, and waits for it with the active task's
    ; cancellation held off, so that it is reaped however the task that started it ends. A cleanup
    ; calls it; where the process was already waited for, it does nothing.
    (return-if (if is-reaped))
    (blank)
    (call kill)
    (do (without cancel)
      (do
        (inline (call wait null))
      )
    )
  )
  (fn-do + terminate-group _
    (return-if (if (not leads-group)))
    (blank)
    (call C:kill (- pid) C:SIGTERM)
  )
  (fn-do + kill-tree _
    (let tree (list Int))
    (if leads-group
      (call C:kill (- pid) C:SIGSTOP)
      (++= tree (call process-group-members pid))
    )
    (if (and (not is-reaped) (not (has tree pid)))
      (+= tree pid)
    )
    (let index Index 0)
    (while (< index (. tree length))
      (for (in child (call process-children ([] tree index)))
        (if (not (has tree child))
          (call C:kill child C:SIGSTOP)
          (+= tree child)
        )
      )
      (+= index 1)
    )
    (for (in member tree)
      (call C:kill member C:SIGKILL)
    )
    (if leads-group
      (call C:kill (- pid) C:SIGKILL)
    )
  )
  (fn-expr + group-members (list Int) :get
    (if-expr leads-group (call process-group-members pid) (call (of List Int)))
  )
  (fn-do _ send-signal _
    (param number I32)
    (return-if (if is-reaped))
    (blank)
    (call C:kill pid number)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    ; Ends a process a `use` scope started, as `reap` does, and closes its streams. A process meant to
    ; outlive the scope that starts it is made without `use`, and its maker reaps it.
    (call reap)
    (call close)
  )
  (fn-do + close-input _
    (do
      (inline (call (?. stdin close)))
    )
  )
  (fn-do + close _
    (do
      (inline (call (?. stdin close)))
    )
    (do
      (inline (call (?. stdout close)))
    )
    (do
      (inline (call (?. stderr close)))
    )
  )
  (fn-expr + read _
    (param size Size)
    (param buffer ([] Byte))
    (call (. (!! stdout) read) size buffer)
  )
)

(fn-do + process-pipe ProcessPipe (?! IOError)
  (let ends (call open-pipe "a process pipe"))
  (call C:brixfcntl ([] ends 0) C:F_SETFD C:FD_CLOEXEC)
  (call C:brixfcntl ([] ends 1) C:F_SETFD C:FD_CLOEXEC)
  (return (call ProcessPipe (call File ([] ends 0)) (call File ([] ends 1))))
)

(fn-do + connected-process ConnectedProcess (?! Error)
  (param name String)
  (param stderr-mode ProcessStderr (= (. ProcessStderr inherit)))
  (param args (list String) (= (call (of List String))))
  (param directory (? String) (= null))
  (param variables (? (map String String)) (= null))
  (param descriptors (list I32) (= (call (of List I32))))
  (let ends ([] I32 2))
  (throw (call IOError (str "Unable to create a socket for " name)) (if (not (call C:brixSocketPair ends))))
  (blank)
  (let passed (list I32))
  (+= passed ([] ends 1))
  (++= passed descriptors)
  (let spawned
    (call Process name stderr-mode args directory variables passed
      (block
        (on-error (: failure Error)
          (call C:close ([] ends 0))
          (call C:close ([] ends 1))
          (throw failure)
        )
      )
    )
  )
  (call C:close ([] ends 1))
  (return (call ConnectedProcess spawned (call File ([] ends 0))))
)

(fn-do + process-children (list Int)
  (param parent Int)
  (return (call listed-processes false parent))
)

(fn-do + process-group-members (list Int)
  (param group Int)
  (return (call listed-processes true group))
)

(fn-do + process-directory (? String)
  (param pid Int)
  (let buffer ([] Byte 4096))
  (let length (call C:brixProcessDirectory pid buffer (. buffer size)))
  (return-if null (if (< length 0)))
  (return (call (. buffer slice-string) (..< 0 (as length Size))))
)

(fn-do _ listed-processes (list Int)
  (param by-group Bool)
  (param value Int)
  (let capacity Size 64)
  (while true
    (let pids ([] I32 capacity))
    (let count
      (block
        (case? by-group
          (call C:brixProcessGroupMembers value pids capacity)
        )
        (default
          (call C:brixChildProcesses value pids capacity)
        )
      )
    )
    (return-if (call (of List Int)) (if (<= count 0)))
    (blank)
    (if (< count capacity)
      (let listed (list Int))
      (for (in index (..< 0 count))
        (+= listed ([] pids index))
      )
      (return listed)
    )
    (*= capacity 2)
  )
)

(fn-do _ open-pipe _ (?! IOError)
  (param name String)
  (let ends ([] I32 2))
  (throw (call IOError (str "Unable to open a pipe for " name)) (if (== (call C:pipe ends) -1)))
  (return ends)
)

(fn-do _ duplicate-descriptors _ (?! IOError)
  (param name String)
  (param descriptors (list I32))
  (let floor (+ 3 (as (. descriptors length) I32)))
  (let copies (call (of List I32)))
  (for (in descriptor descriptors)
    (let copy (call C:brixfcntl descriptor C:F_DUPFD_CLOEXEC floor))
    (if (== copy -1)
      (call close-descriptors copies)
      (throw (call IOError (str "Unable to pass descriptor " descriptor " to " name)))
    )
    (call (. copies append) copy)
  )
  (return copies)
)

(fn-do _ close-descriptors _
  (param descriptors (list I32))
  (for (in descriptor descriptors)
    (call C:close descriptor)
  )
)

(fn-do _ close-pipe _
  (param ends ([] I32))
  (call C:close ([] ends 0))
  (call C:close ([] ends 1))
)

(type _ ProcessExitStream
  (implements (of Usable Void))
  (prop + process Process)
  (blank)
  (prop _ lock Semaphore)
  (blank)
  (delegate (of Broadcastable Int))
  (prop _ channel _ (:= (call (of AsyncOnDemandChannel Int) this)))
  (fn-do + This _
    (param process Process)
  )
  (fn-do + begin-using _
    (do-new
      (let status (call (. process wait) lock))
      (if status
        (<- channel status)
      )
    )
  )
  (fn-do + end-using _
    (call C:brixCancelProcExitEventListener (. process pid) (. lock native-pointer))
  )
)
