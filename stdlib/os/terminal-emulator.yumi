+ length Size

━━━━━━━━━━━━━━━━━━━━
+ TerminalEmulator
    is Closable

+ columns Size
+ rows Size

_ handle Pointer?
_ cleanup CleanupHandle?
_ byte-buffer Byte[] = Byte[4096]
_ run-buffer U32[] = U32[512]
_ text-buffer Byte[] = Byte[2048]
_ int-buffer I32[] = I32[8]
_ word-buffer U32[] = U32[8]

────────────────────
+ This
    - columns Size
    - rows Size
    - scrollback-lines Size = 10000

this.columns = columns
this.rows = rows
. native = C:brixTerminalCreate(columns, rows, scrollback-lines)
?! Error("Unable to create terminal emulator")
    if native == Pointer()
handle = native
cleanup = on-reclaim(this, native, release-terminal-emulator)

────────────────────
+ get is-open Bool

handle != null

────────────────────
+ do close

if handle
    cleanup?.cancel()
    release-terminal-emulator(handle!)
    handle = null

────────────────────
+ do reset

=? if !handle
C:brixTerminalReset(handle)

────────────────────
+ do resize
    - columns Size
    - rows Size
    - cell-width Size
    - cell-height Size

=? if !handle
this.columns = columns
this.rows = rows
C:brixTerminalResize(handle!, columns, rows, cell-width, cell-height)

────────────────────
+ do write Byte[]?
    - bytes Byte[]
    - length Size

=? null if !handle
C:brixTerminalWrite(handle, bytes, length)
= take-replies()

────────────────────
+ do take-replies Byte[]?

=? null if !handle
. length = C:brixTerminalReplyLength(handle) as Size
=? null if length == 0
. replies = Byte[length]
C:brixTerminalTakeReplies(handle!, replies, length)
= replies

────────────────────
+ do take-events U32

=? 0 if !handle
= C:brixTerminalTakeEvents(handle)

────────────────────
+ do get title String

=? "" if !handle
. length = C:brixTerminalCopyTitle(handle, byte-buffer, byte-buffer.length) as Size
=? "" if length == 0
if length > byte-buffer.length
    byte-buffer = Byte[length]
    C:brixTerminalCopyTitle(handle!, byte-buffer, length)
= byte-buffer.slice-string(0 .. < length)

────────────────────
+ do get pwd String

=? "" if !handle
. length = C:brixTerminalCopyPwd(handle!, byte-buffer, byte-buffer.length) as Size
=? "" if length == 0
if length > byte-buffer.length
    byte-buffer = Byte[length]
    C:brixTerminalCopyPwd(handle!, byte-buffer, length)
= byte-buffer.slice-string(0 .. < length)

────────────────────
+ do set-colors
    - foreground U32
    - background U32
    - cursor U32
    - palette U32[]

=? if !handle
C:brixTerminalSetColors(handle, foreground, background, cursor, palette, palette.length)

────────────────────
+ do set-dark
    - is-dark Bool

=? if !handle
C:brixTerminalSetDark(handle, is-dark)

────────────────────
+ mode-enabled Bool
    - mode U32
    - is-ansi = false

if !handle then false else C:brixTerminalModeEnabled(handle, mode, is-ansi)

────────────────────
+ get is-alternate-scrolling Bool

mode-enabled(terminal-mode-alternate-scroll)

────────────────────
+ get is-synchronizing Bool

mode-enabled(terminal-mode-synchronized-output)

────────────────────
+ get is-mouse-tracking Bool

if handle then C:brixTerminalMouseTracking(handle) else false

────────────────────
+ get is-alternate-screen Bool

if handle then C:brixTerminalIsAlternateScreen(handle) else false

────────────────────
+ get is-viewport-at-bottom Bool

if handle then C:brixTerminalViewportAtBottom(handle) else true

────────────────────
+ do scroll-by
    - rows Int

=? if !handle
C:brixTerminalScrollDelta(handle, rows)

────────────────────
+ do scroll-to-top

=? if !handle
C:brixTerminalScrollTop(handle)

────────────────────
+ do scroll-to-bottom

=? if !handle
C:brixTerminalScrollBottom(handle)

────────────────────
+ do scroll-to-row
    - row Size

=? if !handle
C:brixTerminalScrollRow(handle, row)

────────────────────
+ do get scrollbar TerminalScrollbar

=? TerminalScrollbar(0, 0, 0) if !handle
C:brixTerminalScrollbar(handle, word-buffer)
= TerminalScrollbar(word-buffer[0], word-buffer[1], word-buffer[2])

────────────────────
+ do render-update Int

=? terminal-dirty-none if !handle
= C:brixTerminalRenderUpdate(handle)

────────────────────
+ do get cursor TerminalCursor

=? TerminalCursor(false, 0, 0, terminal-cursor-block, false) if !handle
C:brixTerminalRenderCursor(handle, int-buffer)
= TerminalCursor
    - int-buffer[0] != 0
    - int-buffer[1]
    - int-buffer[2]
    - int-buffer[3]
    - int-buffer[4] != 0

────────────────────
+ do get colors TerminalColors

=? TerminalColors(0, 0, 0) if !handle
C:brixTerminalRenderColors(handle, word-buffer)
= TerminalColors(word-buffer[0], word-buffer[1], word-buffer[2])

────────────────────
+ do render-rows [TerminalRow]
    - dirty-only Bool

. rendered [TerminalRow]
=? rendered if !handle
C:brixTerminalRenderBeginRows(handle, dirty-only)
while true
    . y = C:brixTerminalRenderNextRow(handle!)
    =? rendered if y < 0
    rendered += read-row(y)
= rendered

────────────────────
+ do render-clean

=? if !handle
C:brixTerminalRenderClean(handle)

────────────────────
+ do encode-key Byte[]?
    - key-code U32
    - mods U32
    - action U32
    - text String?
    - unshifted U32 = 0

=? null if !handle
. input = text ?? ""
. length = C:brixTerminalEncodeKey
    - handle
    - key-code
    - mods
    - action
    - input
    - input.size
    - unshifted
    - byte-buffer
    - byte-buffer.length
= encoded(length)

────────────────────
+ do encode-mouse Byte[]?
    - action U32
    - button U32
    - mods U32
    - x F32
    - y F32

=? null if !handle
. length = C:brixTerminalEncodeMouse
    - handle
    - action
    - button
    - mods
    - x
    - y
    - byte-buffer
    - byte-buffer.length
= encoded(length)

────────────────────
+ do encode-paste Byte[]?
    - text String

=? null if !handle || text.size == 0
. length = C:brixTerminalEncodePaste(handle, text, text.size, byte-buffer, byte-buffer.length) as Size
if length > byte-buffer.length
    byte-buffer = Byte[length]
    length = C:brixTerminalEncodePaste(handle!, text, text.size, byte-buffer, byte-buffer.length)
= encoded(length)

────────────────────
+ do encode-focus Byte[]?
    - is-focused Bool

=? null if !handle
. length = C:brixTerminalEncodeFocus(handle, is-focused, byte-buffer, byte-buffer.length)
= encoded(length)

────────────────────
+ do select-press
    - column Size
    - row Size
    - x F64
    - y F64

=? if !handle
C:brixTerminalSelectPress(handle, column, row, x, y)

────────────────────
+ do select-drag
    - column Size
    - row Size
    - x F64
    - y F64
    - is-rectangle = false

=? if !handle
C:brixTerminalSelectDrag(handle, column, row, x, y, is-rectangle)

────────────────────
+ do select-release
    - column Size
    - row Size

=? if !handle
C:brixTerminalSelectRelease(handle, column, row)

────────────────────
+ do select-all

=? if !handle
C:brixTerminalSelectAll(handle)

────────────────────
+ do clear-selection

=? if !handle
C:brixTerminalSelectClear(handle)

────────────────────
+ get has-selection Bool

if handle then C:brixTerminalHasSelection(handle) else false

────────────────────
+ do selection-text String?

=? null if !handle
. length = C:brixTerminalCopySelection(handle, byte-buffer, byte-buffer.length) as Size
=? null if length == 0
if length > byte-buffer.length
    byte-buffer = Byte[length]
    C:brixTerminalCopySelection(handle!, byte-buffer, length)
= byte-buffer.slice-string(0 .. < length)

────────────────────
+ do all-text String?

=? null if !handle
. length = C:brixTerminalCopyAll(handle, byte-buffer, byte-buffer.length) as Size
=? null if length == 0
=? byte-buffer.slice-string(0 .. < length) if length <= byte-buffer.length
. bytes = Byte[length]
C:brixTerminalCopyAll(handle!, bytes, length)
= bytes.slice-string(0 .. < length)

────────────────────
_ do encoded Byte[]?
    - length Size

=? null if length == 0 || length > byte-buffer.length
. bytes = Byte[length]
for index in 0 .. < length
    bytes[index] = byte-buffer[index]
= bytes

────────────────────
_ do read-row TerminalRow
    - y Int

. count = C:brixTerminalRowRunCount(handle!) as Size
. text-length = C:brixTerminalRowTextLength(handle!) as Size
if count * terminal-run-fields > run-buffer.length
    run-buffer = U32[count * terminal-run-fields]
if text-length > text-buffer.length
    text-buffer = Byte[text-length]
C:brixTerminalRowCopy(handle!, run-buffer, text-buffer)
. runs [TerminalRun]
for index in 0 .. < count
    . base = index * terminal-run-fields
    . offset = run-buffer[base + 5] as Size
    . length = run-buffer[base + 6] as Size
    runs += TerminalRun
        - run-buffer[base]
        - run-buffer[base + 1]
        - run-buffer[base + 2]
        - run-buffer[base + 3]
        - run-buffer[base + 4]
        - text-buffer.slice-string(offset .. < offset + length)
C:brixTerminalRowInfo(handle!, int-buffer)
. wraps = int-buffer[3] != 0
=? TerminalRow(y, runs, -1, -1, wraps) if int-buffer[0] == 0
= TerminalRow(y, runs, int-buffer[1], int-buffer[2], wraps)

━━━━━━━━━━━━━━━━━━━━
_ do release-terminal-emulator
    - handle Pointer

C:brixTerminalRelease(handle)
