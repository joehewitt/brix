/BxTerminal/BxTerminal.h
/gc/gc

+ terminal-event-bell U32 = 1
+ terminal-event-title U32 = 2
+ terminal-event-pwd U32 = 4
+ terminal-event-reset U32 = 8

+ terminal-run-bold U32 = 1
+ terminal-run-italic U32 = 2
+ terminal-run-faint U32 = 4
+ terminal-run-underline U32 = 8
+ terminal-run-strike U32 = 16
+ terminal-run-overline U32 = 32
+ terminal-run-invisible U32 = 64
+ terminal-run-blink U32 = 128
+ terminal-run-wide U32 = 256
+ terminal-run-isolated U32 = 512
+ terminal-run-sprite U32 = 1024
+ terminal-run-background U32 = 32768

+ terminal-dirty-none = 0
+ terminal-dirty-partial = 1
+ terminal-dirty-full = 2

+ terminal-cursor-bar = 0
+ terminal-cursor-block = 1
+ terminal-cursor-underline = 2
+ terminal-cursor-block-hollow = 3

+ terminal-mods-shift U32 = 1
+ terminal-mods-control U32 = 2
+ terminal-mods-alt U32 = 4
+ terminal-mods-super U32 = 8
+ terminal-mods-caps-lock U32 = 16

_ terminal-run-fields Size = 7
_ terminal-mode-alternate-scroll U32 = 1007
_ terminal-mode-synchronized-output U32 = 2026

━━━━━━━━━━━━━━━━━━━━
