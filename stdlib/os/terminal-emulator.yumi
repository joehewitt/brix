| release
| press
| repeat

━━━━━━━━━━━━━━━━━━━━
+ TerminalMouseAction is U32

| press
| release
| motion

━━━━━━━━━━━━━━━━━━━━
+ TerminalMouseButton is U32

| none
| left
| right
| middle
| wheel-up
| wheel-down
| wheel-left
| wheel-right

━━━━━━━━━━━━━━━━━━━━
+ TerminalRun is Tuple

+ column Size
+ columns Size
+ foreground U32
+ background U32
+ flags U32
+ text String

────────────────────
+ get has-background Bool

(flags /and/ terminal-run-background) != 0

────────────────────
+ has-flag Bool
    - flag U32

(flags /and/ flag) != 0

━━━━━━━━━━━━━━━━━━━━
+ TerminalRow is Tuple

+ y Int
+ runs [TerminalRun]
+ selection-start Int
+ selection-end Int
+ wraps Bool

━━━━━━━━━━━━━━━━━━━━
