(import ./file)
(import /BxEvents/BxEvents.h)
(import /unistd.h)

(type + SharedMemory
  (implements Closable)
  (prop + name String)
  (prop + size Size)
  (prop + data Pointer)
  (prop + owned Bool)
  (fn-do _ This _
    (param name _)
    (param size _)
    (param data _)
    (param owned _)
  )
  (fn-do + close _
    (call C:brixSharedMemoryUnmap data size)
    (if owned
      (call C:brixSharedMemoryUnlink name)
    )
  )
)

(fn-do + create-shared-memory SharedMemory (?! IOError)
  (param name String)
  (param size Size)
  (let fd (call C:brixSharedMemoryCreate name size))
  (throw (call IOError (str "Unable to create shared memory " name)) (if (< fd 0)))
  (blank)
  (let data (call C:brixSharedMemoryMap fd size true))
  (call C:close fd)
  (if (not data)
    (call C:brixSharedMemoryUnlink name)
    (throw (call IOError (str "Unable to map shared memory " name)))
  )
  (return (call SharedMemory name size data true))
)

(fn-do + open-shared-memory SharedMemory (?! IOError)
  (param name String)
  (param size Size)
  (let fd (call C:brixSharedMemoryOpen name))
  (throw (call IOError (str "Unable to open shared memory " name)) (if (< fd 0)))
  (blank)
  (let data (call C:brixSharedMemoryMap fd size false))
  (call C:close fd)
  (call C:brixSharedMemoryUnlink name)
  (throw (call IOError (str "Unable to map shared memory " name)) (if (not data)))
  (return (call SharedMemory name size data false))
)
