
/time/clock

+ event-delete = 0x0001
+ event-write = 0x0002
+ event-extend = 0x0004
+ event-attrib = 0x0008
+ event-link = 0x0010
+ event-rename = 0x0020
+ event-revoke = 0x0040

━━━━━━━━━━━━━━━━━━━━
+ FileStat is Tuple

+ dev U64
+ ino U64
+ mode U32
+ nlink U32
+ uid U32
+ gid U32
+ size I64
+ blocks I64
+ blksize I64
+ atime ClockTime
+ mtime ClockTime
+ ctime ClockTime
+ btime ClockTime

━━━━━━━━━━━━━━━━━━━━
+ Glob is Tuple

+ count Size
+ paths CPointer'(CPointer'Char8)
+ handle Pointer
