(import /data)

(type + Outbox
  (prop + target WritableData)
  (prop + has-failed _ (= false))
  (prop + on-drained (? Doer))
  (prop _ queued (list ([] Byte)))
  (prop _ head Index (= 0))
  (prop _ spent _ (= ([] Byte 0)))
  (prop _ is-flushing _ (= false))
  (fn-do + This _
    (param target _)
  )
  (fn-expr + is-idle Bool :get
    (not is-flushing)
  )
  (fn-do + send _
    (param bytes ([] Byte))
    (return-if (if (or has-failed (== (. bytes size) 0))))
    (blank)
    (+= queued bytes)
    (return-if (if is-flushing))
    (blank)
    (= is-flushing true)
    (do-new
      (call flush)
    )
  )
  (fn-do + clear _
    (call (. queued clear))
    (= head 0)
  )
  (fn-do _ flush _
    (while (and (< head (. queued length)) (not has-failed))
      (let next ([] queued head))
      (= ([] queued head) spent)
      (+= head 1)
      (if (== head (. queued length))
        (call clear)
        (else-if (>= (* head 2) (. queued length))
          (-= ([] queued (..< 0 head)))
          (= head 0)
        )
      )
      (let offset Size 0)
      (while (and (< offset (. next size)) (not has-failed))
        (let written (catch (call (. target write) (+ next offset) (- (. next size) offset))))
        (match written
          (case (: count Size)
            (if (> count 0)
              (+= offset count)
              (else
                (= has-failed true)
              )
            )
          )
          (case Error
            (= has-failed true)
          )
        )
      )
      (if has-failed
        (call clear)
      )
    )
    (= is-flushing false)
    (let drained on-drained)
    (= on-drained null)
    (if drained
      (call drained)
    )
  )
)
