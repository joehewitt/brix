(import /os/path)
(import /test)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Path"))
  (tuple "" (. (call Path "foo.bar/baz") ext))
  (tuple "" (. (call Path ".profile") ext))
  (tuple "local" (. (call Path ".env.local") ext))
  (blank)
  (tuple "foo" (. (call Path "/foo") head))
  (tuple "foo" (. (call Path "/foo/bar") head))
  (header (call test "Stats"))
  (tuple 22 (. (call Path "foo/bar/baz.txt") stat size))
  (. (call Path "foo/bar") is-dir)
  (. (call Path "foo/bar/baz.txt") is-file)
)
