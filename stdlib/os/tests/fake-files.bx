(import /os/env)
(import /os/fake-files)
(import /os/file)
(import /os/files)
(import /os/path)
(import /test)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Fake Files Paths"))
  (call (. cases run) path-tests)
  (= cases (call (. cases then) "Fake Files Changes" change-tests))
  (= cases (call (. cases then) "Fake Files Folders" folder-tests))
  (return cases)
)

(fn-do + path-tests TestCase
  (param t TestCase)
  (let root (call temporary-directory "fake-files"))
  (let fake (call FakeFiles root))
  (call (. t expect) "a path inside the fake lies under its root" (str (. fake root) "/notes/a.txt") (call (. fake inside) "/notes/a.txt"))
  (call (. t expect) "a relative path is taken from the fake's folder" (str (. fake root) "/a.txt") (call (. fake inside) "a.txt"))
  (call (. t expect) "a path cannot climb above the root" (str (. fake root) "/etc") (call (. fake inside) "/../../etc"))
  (call (. t expect) "a real path under the root is given back without it" "/notes" (call (. fake outside) (str (. fake root) "/notes")))
  (call (. t expect) "a library is handed the path inside the root" (str (. fake root) "/db.sqlite") (call (. fake native-path) "/db.sqlite"))
  (call remove-tree root)
  (return t)
)

(fn-do + change-tests TestCase
  (param t TestCase)
  (let root (call temporary-directory "fake-files"))
  (do-with files (call FakeFiles root)
    (call (. (call Path "/notes" 0) make-directory))
    (call write-file-atomically (call Path "/notes/a.txt" 0) "first")
    (call (. (call Path "/notes/a.txt" 0) move) (call Path "/notes/b.txt" 0))
    (call (. t expect) "a moved file is read at its new path" "first" (call read-file-text (call Path "/notes/b.txt" 0)))
    (call (. t expect) "the old path no longer exists" false (. (call Path "/notes/a.txt" 0) exists))
    (call (. t expect) "a folder lists what was written in it" "b.txt" (. ([] (call (of List PathEntry) (. (call Path "/notes" 0) entries)) 0) name))
    (call (. t expect) "a resolved path is the fake's" "/notes/b.txt" (str (. (call Path "/notes/b.txt" 0) resolved)))
  )
  (call (. t expect) "the file lies in the real root" "first" (call read-file-text (/ root "notes/b.txt")))
  (call remove-tree root)
  (call (. t expect) "the root is gone once removed" false (. root exists))
  (return t)
)

(fn-do + folder-tests TestCase
  (param t TestCase)
  (let root (call temporary-directory "fake-files"))
  (do-with files (call FakeFiles root)
    (call (. t expect) "the current folder is the fake's root" "/" (call cwd))
    (let made (call temporary-directory "case"))
    (call (. t expect) "a temporary folder is made inside the fake" true (call (. (str made) starts-with) "/tmp/case."))
    (call (. t expect) "the temporary folder exists under the fake" true (. made is-dir))
    (call (. t expect) "the temporary root is the fake's" "/tmp" (str (call temporary-root)))
  )
  (call remove-tree root)
  (return t)
)
