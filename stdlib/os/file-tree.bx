(import ./file)
(import ./path)
(import /stream/sort)
(import /time/debounced)
(import /time/duration)
(blank)
(prop + file-tree-flush-delay _ (= 16ms))
(blank)
(prop _ file-tree-new-file-perms _
  (=
    (block
      (/or/ user-read-perm user-write-perm group-read-perm other-read-perm)
    )
  )
)
(blank)
(type-line + FileRelocation (is (tuple (: from String) (: to (? String)))))

(type + FileTree
  (implements Closable)
  (prop + root FileNode)
  (prop + hides-name FileNameFilter (= file-tree-hides-name))
  (prop + is-watching _ (= false))
  (event + changed (list FileNode))
  (event + modified FileNode)
  (event + relocated FileRelocation)
  (blank)
  (prop _ directories (of Map String FileNode))
  (prop _ dirty (of Map String FileNode))
  (prop _ next-key Size (= 1))
  (prop _ schedule-flush DebouncedAction)
  (prop _ is-closed _ (= false))
  (prop _ is-watch-pending _ (= true))
  (prop _ watch (? Closable))
  (prop _ changes (? (of Broadcastable PathWatchEvent)))
  (prop _ observed (of Map String FileNode))
  (prop _ stale (of Map String FileNode))
  (fn-do + This _
    (param location Path)
    (param changes _ (= null))
    (let resolved (?? (catch? (. location resolved)) location))
    (= root (call FileNode (call take-key) (str resolved) (. PathKind directory) 0 true))
    (= (. root retain-count) 1)
    (= schedule-flush (call throttled file-tree-flush-delay (. this flush)))
  )
  (fn-do + close _
    (= is-closed true)
    (= is-watching false)
    (let stream watch)
    (= watch null)
    (if stream
      (call (. stream close))
    )
  )
  (fn-expr + loaded-count Size :get
    (. directories length)
  )
  (fn-do + children-of (? (list FileNode))
    (param node FileNode)
    (return
      (block
        (case? (not (. node is-directory))
          null
        )
        (default
          (?? (. node children) (call load node))
        )
      )
    )
  )
  (fn-do + retain _
    (param node FileNode)
    (+= (. node retain-count) 1)
  )
  (fn-do + release _
    (param node FileNode)
    (if (> (. node retain-count) 0)
      (-= (. node retain-count) 1)
    )
  )
  (fn-do + key-path (list String)
    (param target Path)
    (let node (call find target))
    (return (if-expr node (call keys-to node) (call (of List String))))
  )
  (fn-do + find (? FileNode)
    (param target Path)
    (let names (call relative-names target))
    (return-if (if (== names null)))
    (blank)
    (let node root)
    (for (in name names)
      (let children (call children-of node))
      (return-if (if (== children null)))
      (blank)
      (let found (call file-tree-named children name))
      (return-if (if (not found)))
      (blank)
      (= node found)
    )
    (return node)
  )
  (fn-do + contains Bool
    (param target Path)
    (return (!= (call relative-names target) null))
  )
  (fn-do + observe _
    (param node FileNode)
    (+= (. node observe-count) 1)
    (= ([] observed (. node key)) node)
  )
  (fn-do + unobserve _
    (param node FileNode)
    (return-if (if (== (. node observe-count) 0)))
    (blank)
    (-= (. node observe-count) 1)
    (return-if (if (> (. node observe-count) 0)))
    (blank)
    (if (has observed (. node key))
      (-= ([] observed (. node key)))
    )
    (if (has stale (. node key))
      (-= ([] stale (. node key)))
    )
  )
  (fn-expr + keys-to (list String)
    (param node FileNode)
    (case? owner
      (call (of List String)
        (block
          (spread (call keys-to owner))
          (item (. node key))
        )
      )
    )
    (default
      (call (of List String))
    )
    (where
      (lazy owner (. node parent))
    )
  )
  (fn-do + create (? FileNode) (?! Error)
    (param owner FileNode)
    (param is-folder Bool)
    (let location (. owner path))
    (let name (call file-tree-free-name location (if-expr is-folder "untitled folder" "untitled")))
    (if is-folder
      (call (. (/ location name) make-directory))
      (else
        (let mode (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags exclusive-mode)))
        (let made (call File (/ location name) mode file-tree-new-file-perms))
        (call (. made close))
      )
    )
    (call settle (list owner))
    (return (call named owner name))
  )
  (fn-do + rename _ (?! Error)
    (param node FileNode)
    (param name String)
    (let owner (. node parent))
    (return-if (if (or (not owner) (== name (. node name)))))
    (throw (call Error "A name cannot be empty") (if (not name)))
    (throw (call Error "A name cannot contain a slash") (if (!= (call (. name find) "/") null)))
    (throw (call Error (str name " is not a usable name")) (if (or (== name ".") (== name ".."))))
    (blank)
    (let location (. owner path))
    (let from (. node relative-path))
    (call (. (/ location (. node name)) move-exclusive) (/ location name))
    (call settle (list owner))
    (<- relocated (call FileRelocation from (call file-tree-join (. owner relative-path) name)))
  )
  (fn-do + move _ (?! Error)
    (param nodes (list FileNode))
    (param owner FileNode)
    (let location (. owner path))
    (let owners (list FileNode) (list owner))
    (finally
      (inline (call settle owners))
    )
    (for (in node nodes)
      (let source (. node parent))
      (if (and source (!= (. source key) (. owner key)))
        (+= owners source)
        (let from (. node relative-path))
        (call (. node path move-exclusive) (/ location (. node name)))
        (<- relocated (call FileRelocation from (call file-tree-join (. owner relative-path) (. node name))))
      )
    )
  )
  (fn-do + receive _ (?! Error)
    (param paths (list Path))
    (param owner FileNode)
    (param copies Bool)
    (let location (. owner path))
    (finally
      (inline (call settle (list owner)))
    )
    (for (in path paths)
      (let target (/ location (. path name)))
      (if copies
        (call file-tree-copy path target)
        (else-if (!= (str (. path dir)) (str location))
          (let from (call relative-of path))
          (call (. path move-exclusive) target)
          (if (!= from null)
            (<- relocated (call FileRelocation from (call file-tree-join (. owner relative-path) (. path name))))
          )
        )
      )
    )
  )
  (fn-do + duplicate (? FileNode) (?! Error)
    (param node FileNode)
    (let owner (. node parent))
    (return-if null (if (not owner)))
    (blank)
    (let location (. owner path))
    (let name (call file-tree-copy-name location (. node name)))
    (call file-tree-copy (. node path) (/ location name))
    (call settle (list owner))
    (return (call named owner name))
  )
  (fn-do + removed _
    (param node FileNode)
    (let owner (. node parent))
    (return-if (if (not owner)))
    (blank)
    (let from (. node relative-path))
    (call settle (list owner))
    (<- relocated (call FileRelocation from null))
  )
  (fn-do + flush _
    (return-if (if is-closed))
    (blank)
    (let touched (call (of List FileNode) (. stale values)))
    (call (. stale clear))
    (call flush-directories)
    (for (in node touched)
      (if (not (. node is-detached))
        (<- modified node)
      )
    )
  )
  (fn-do _ flush-directories _
    (return-if (if (not dirty)))
    (blank)
    (let batch (call (of List FileNode) (. dirty values)))
    (call (. dirty clear))
    (blank)
    (let scans (list FileTreeScan))
    (let orphans (call (of Map U64 FileNode)))
    (let touched (list FileNode))
    (for (in node batch)
      (if (or (. node is-detached) (== (. node children) null))
        (continue)
      )
      (if (== (. node retain-count) 0)
        (call unload node)
        (+= touched node)
        (continue)
      )
      (+= scans (call scan node orphans))
    )
    (blank)
    (for (in found scans)
      (if (call rebuild found orphans)
        (+= touched (. found node))
      )
    )
    (blank)
    (for (in node (. orphans values))
      (call detach node)
    )
    (blank)
    (if touched
      (<- changed touched)
    )
  )
  (fn-do _ settle _
    (param owners (list FileNode))
    (for (in owner owners)
      (+= (. owner retain-count) 1)
      (= ([] dirty (. owner key)) owner)
    )
    (call flush)
    (for (in owner owners)
      (-= (. owner retain-count) 1)
    )
  )
  (fn-expr _ relative-of (? String)
    (param path Path)
    (case? (== text base)
      ""
    )
    (case? (call (. text starts-with) (str base "/"))
      ([] text (... (+ (. base length) 1)))
    )
    (default
      null
    )
    (where
      (lazy base (str (. root path)))
      (lazy text (str path))
    )
  )
  (fn-do _ named (? FileNode)
    (param owner FileNode)
    (param name String)
    (let children (call children-of owner))
    (return (only-if (call file-tree-named children name) (if (!= children null))))
  )
  (fn-do _ relative-names (? (list String))
    (param target Path)
    (let names (?. (call (. target relative-to) (. root path)) components))
    (return-if names (if names))
    (blank)
    (let resolved (?? (catch? (. target resolved)) target))
    (return (?. (call (. resolved relative-to) (. root path)) components))
  )
  (fn-do _ take-key _
    (let key (str next-key))
    (+= next-key 1)
    (return key)
  )
  (fn-do _ ensure-watching _
    (return-if (if (or (not is-watch-pending) is-closed)))
    (blank)
    (= is-watch-pending false)
    (let location (. root path))
    (if (. location is-dir)
      (call watch-root location)
    )
  )
  (fn-do _ watch-root _
    (param location Path)
    (let source (?? changes (as (call (. location watch) true) (of Broadcastable PathWatchEvent))))
    (= watch (catch? (call listen-for-changes source (. this note))))
    (= is-watching (!= watch null))
  )
  (fn-do _ note _
    (param event PathWatchEvent)
    (return-if (if is-closed))
    (blank)
    (let text (as (. event path) String))
    (if (. event must-rescan)
      (call mark-loaded-under text)
      (return)
    )
    (if (call (. event flags contains) (. PathWatchFlags root-changed))
      (call mark root)
    )
    (call note-observed text)
    (return-if (if (not (call file-tree-changes-names (. event flags)))))
    (blank)
    (let above (. event path parent))
    (return-if (if (not above)))
    (blank)
    (let owner ([] directories (str above)))
    (if owner
      (call mark owner)
    )
  )
  (fn-do _ note-observed _
    (param text String)
    (return-if (if (not observed)))
    (blank)
    (let found false)
    (for (in node (. observed values))
      (if (and (call file-tree-is-at node text) (not (has stale (. node key))))
        (= ([] stale (. node key)) node)
        (= found true)
      )
    )
    (if found
      (call schedule-flush)
    )
  )
  (fn-do _ mark _
    (param node FileNode)
    (= ([] dirty (. node key)) node)
    (call schedule-flush)
  )
  (fn-do _ mark-loaded-under _
    (param text String)
    (let prefix (str text "/"))
    (for (in pair (. directories items))
      (if (or (== (. pair key) text) (call (. pair key starts-with) prefix))
        (= ([] dirty (. pair value key)) (. pair value))
      )
    )
    (call schedule-flush)
  )
  (fn-do _ load (list FileNode)
    (param node FileNode)
    (call ensure-watching)
    (let location (. node path))
    (let listed (call file-entries location hides-name))
    (let entries (?? listed (call (of List FileEntry))))
    (let next
      (call (of List FileNode)
        (block
          (spread entries)
          (pipe *> (call FileNode (call take-key) (. each name) (. each kind) (. each inode) (. each is-directory) node))
        )
      )
    )
    (let sorted (call file-tree-sorted next))
    (= (. node is-unreadable) (== listed null))
    (= (. node children) sorted)
    (call index node (str location))
    (return sorted)
  )
  (fn-do _ scan FileTreeScan
    (param node FileNode)
    (param orphans (of Map U64 FileNode))
    (let listed (catch? (call (of List PathEntry) (. node path entries))))
    (let entries (?? listed (call (of List PathEntry))))
    (let present (call (of Map String PathEntry)))
    (for (in entry entries)
      (= ([] present (. entry name)) entry)
    )
    (blank)
    (let kept (call (of Map String FileNode)))
    (let lost Size 0)
    (for (in child (!! (. node children)))
      (let entry ([] present (. child name)))
      (if (and entry (call file-tree-is-same-item child entry))
        (= ([] kept (. child name)) child)
        (else
          (let previous ([] orphans (. child inode)))
          (if previous
            (call detach previous)
          )
          (= ([] orphans (. child inode)) child)
          (+= lost 1)
        )
      )
    )
    (return (call FileTreeScan node entries kept (!= listed null) lost))
  )
  (fn-do _ rebuild Bool
    (param found FileTreeScan)
    (param orphans (of Map U64 FileNode))
    (let node (. found node))
    (let location (. node path))
    (let next (list FileNode))
    (let gained Size 0)
    (for (in entry (. found entries))
      (if (call hides-name (. entry name))
        (continue)
      )
      (let child ([] (. found kept) (. entry name)))
      (if child
        (= (. child inode) (. entry inode))
        (+= next child)
        (continue)
      )
      (let is-directory (call file-tree-entry-is-directory location entry))
      (let moved ([] orphans (. entry inode)))
      (if (and moved (== (. moved kind) (. entry kind)) (== (. moved is-directory) is-directory))
        (-= ([] orphans (. entry inode)))
        (call adopt moved node (. entry name))
        (+= next moved)
        (else
          (+= next (call FileNode (call take-key) (. entry name) (. entry kind) (. entry inode) is-directory node))
        )
      )
      (+= gained 1)
    )
    (blank)
    (let unreadable (not (. found is-readable)))
    (return-if false (if (and (== gained 0) (== (. found lost) 0) (== (. node is-unreadable) unreadable))))
    (blank)
    (= (. node is-unreadable) unreadable)
    (= (. node children) (call file-tree-sorted next))
    (return true)
  )
  (fn-do _ adopt _
    (param node FileNode)
    (param owner FileNode)
    (param name String)
    (= (. node parent) owner)
    (= (. node name) name)
    (= (. node sort-name) (. name lowercased))
    (if (!= (. node children) null)
      (call reindex node)
      (call mark node)
    )
  )
  (fn-do _ reindex _
    (param node FileNode)
    (call forget node)
    (call index node (str (. node path)))
    (for (in child (!! (. node children)))
      (if (!= (. child children) null)
        (call reindex child)
      )
    )
  )
  (fn-do _ index _
    (param node FileNode)
    (param text String)
    (= (. node listed-path) text)
    (= ([] directories text) node)
  )
  (fn-do _ forget _
    (param node FileNode)
    (let text (. node listed-path))
    (return-if (if (not text)))
    (blank)
    (= (. node listed-path) null)
    (let indexed ([] directories text))
    (if (and indexed (== (. indexed key) (. node key)))
      (-= ([] directories text))
    )
  )
  (fn-do _ unload _
    (param node FileNode)
    (let children (. node children))
    (return-if (if (== children null)))
    (blank)
    (for (in child children)
      (call detach child)
    )
    (= (. node children) null)
    (call forget node)
  )
  (fn-do _ detach _
    (param node FileNode)
    (= (. node is-detached) true)
    (call unload node)
  )
)

(type + FileNameFilter (is (fn-type Bool (param name String))))

(type + FileEntry (is Tuple)
  (prop + name String)
  (prop + kind PathKind)
  (prop + inode U64)
  (prop + is-directory Bool)
)

(type + FileNode
  (prop + key String)
  (prop + name String)
  (prop + sort-name String)
  (prop + kind PathKind)
  (prop + inode U64)
  (prop + is-directory Bool)
  (prop + parent (? FileNode))
  (prop + children (? (list FileNode)))
  (prop + listed-path (? String))
  (prop + retain-count Size (= 0))
  (prop + observe-count Size (= 0))
  (prop + is-unreadable _ (= false))
  (prop + is-detached _ (= false))
  (fn-do + This _
    (param key _)
    (param name _)
    (param kind _)
    (param inode _)
    (param is-directory _)
    (param parent (? FileNode) (= null))
    (= sort-name (. name lowercased))
  )
  (fn-expr + path Path :get
    (case? owner
      (/ (. owner path) name)
    )
    (default
      (call Path name 0)
    )
    (where
      (lazy owner parent)
    )
  )
  (fn-expr + relative-path String :get
    (case? (not owner)
      ""
    )
    (case? (not (. owner parent))
      name
    )
    (default
      (str (. owner relative-path) "/" name)
    )
    (where
      (lazy owner parent)
    )
  )
)

(fn-do + file-node-is-within Bool
  (param node FileNode)
  (param ancestor FileNode)
  (let cursor (? FileNode) node)
  (while cursor
    (return-if true (if (== (. cursor key) (. ancestor key))))
    (blank)
    (= cursor (. cursor parent))
  )
  (return false)
)

(fn-expr + file-tree-hides-name Bool
  (param name String)
  (== name ".DS_Store")
)

(fn-do + file-entries (? (list FileEntry))
  (param location Path)
  (param hides FileNameFilter)
  (let listed (catch? (call (of List PathEntry) (. location entries))))
  (return
    (match listed
      (case= null
        null
      )
      (default
        (call (of List FileEntry)
          (block
            (spread listed)
            (pipe ?*>
              (block
                (only-if (call FileEntry (. each name) (. each kind) (. each inode) is-directory) (if (not (call hides (. each name)))))
                (lazy is-directory (call file-tree-entry-is-directory location each))
              )
            )
          )
        )
      )
    )
  )
)

(fn-expr + file-tree-entry-is-directory Bool
  (param location Path)
  (param entry PathEntry)
  (match (. entry kind)
    (case= (. PathKind directory)
      true
    )
    (case= (. PathKind link)
      (?? (catch? (. (/ location (. entry name)) is-dir)) false)
    )
    (default
      false
    )
  )
)

(fn-expr + file-order Comparison
  (param left _)
  (param right _)
  (case? (and (. left is-directory) (not (. right is-directory)))
    (. Comparison lesser)
  )
  (case? (and (. right is-directory) (not (. left is-directory)))
    (. Comparison greater)
  )
  (case? (< (. left sort-name) (. right sort-name))
    (. Comparison lesser)
  )
  (case? (> (. left sort-name) (. right sort-name))
    (. Comparison greater)
  )
  (case? (< (. left name) (. right name))
    (. Comparison lesser)
  )
  (case? (> (. left name) (. right name))
    (. Comparison greater)
  )
  (default
    (. Comparison equal)
  )
)

(type _ FileTreeScan (is Tuple)
  (prop + node FileNode)
  (prop + entries (list PathEntry))
  (prop + kept (of Map String FileNode))
  (prop + is-readable Bool)
  (prop + lost Size)
)

(fn-do + file-tree-copy _ (?! Error)
  (param source Path)
  (param target Path)
  (throw (call Error (str "An item named " (. target name) " already exists")) (if (. target exists)))
  (blank)
  (call (. source clone) target
    (block
      (on-error (: failure Error)
        (call file-tree-duplicate source target)
      )
    )
  )
)

(fn-do _ file-tree-duplicate _ (?! Error)
  (param source Path)
  (param target Path)
  (if (not (. source is-dir))
    (call (. source copy) target)
    (return)
  )
  (call (. target make-directory))
  (for (in entry (. source entries))
    (call file-tree-duplicate (/ source (. entry name)) (/ target (. entry name)))
  )
)

(fn-expr _ file-tree-join String
  (param base String)
  (param name String)
  (if-expr (== base "") name (str base "/" name))
)

(fn-do _ file-tree-copy-name String
  (param location Path)
  (param name String)
  (let dot (call (. name find-reverse) "."))
  (let stem (if-expr (or (== dot null) (== dot 0)) name ([] name (..< 0 dot))))
  (let suffix (if-expr (or (== dot null) (== dot 0)) "" ([] name (... dot))))
  (let candidate (str stem " copy" suffix))
  (let count 2)
  (while (. (/ location candidate) exists)
    (= candidate (str stem " copy " count suffix))
    (+= count 1)
  )
  (return candidate)
)

(fn-do _ file-tree-free-name String
  (param location Path)
  (param stem String)
  (let name stem)
  (let count 2)
  (while (. (/ location name) exists)
    (= name (str stem " " count))
    (+= count 1)
  )
  (return name)
)

(fn-expr _ file-tree-changes-names Bool
  (param flags PathWatchFlags)
  (!= (/and/ flags names) 0)
  (where
    (lazy names (/or/ entries mounts))
    (lazy entries (/or/ (. PathWatchFlags created) (. PathWatchFlags removed) (. PathWatchFlags renamed)))
    (lazy mounts (/or/ (. PathWatchFlags mounted) (. PathWatchFlags unmounted)))
  )
)

(fn-expr _ file-tree-is-at Bool
  (param node FileNode)
  (param text String)
  (and (not (. node is-detached)) (call (. text ends-with) (. node name)) (== text (str (. node path))))
)

(fn-expr _ file-tree-is-same-item Bool
  (param node FileNode)
  (param entry PathEntry)
  (and (== (. node kind) (. entry kind)) (or (not (. node is-directory)) (== (. node inode) (. entry inode))))
)

(fn-do _ file-tree-named (? FileNode)
  (param nodes (list FileNode))
  (param name String)
  (for (in node nodes)
    (return-if node (if (== (. node name) name)))
  )
)

(fn-expr _ file-tree-sorted (list FileNode)
  (param nodes (list FileNode))
  (call sort nodes (:using file-order))
)
