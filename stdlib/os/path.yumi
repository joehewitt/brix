
./cfile
./env
./file
/BxCore/BxCore.h
/BxCore/BxSystem.h
/BxEvents/BxEvents.h
/dirent.h
/stdio.h
/string.h
/sys/stat.h
/time/clock
/time/datetime
/time/zone
/unistd.h

+ separator = "/"

━━━━━━━━━━━━━━━━━━━━
+ Path is Tuple
    is Hashable

+ mode => stat.mode
+ exists => error == 0
    .. error = C:brixStat(normalized, &result)
    .. result FileStat
+ is-dir => do
    . result FileStat
    . error = C:brixStat(normalized, &result)
    = error == 0 && result.mode /and/ (C:S_IFMT as U32) == C:S_IFDIR
+ is-file => do
    . result FileStat
    . error = C:brixStat(normalized, &result)
    = error == 0 && result.mode /and/ (C:S_IFMT as U32) == C:S_IFREG
+ is-link => do
    . result FileStat
    . error = C:brixLinkStat(normalized, &result)
    = error == 0 && result.mode /and/ (C:S_IFMT as U32) == C:S_IFLNK
+ created => DateTime(stat.btime.s + local.offset)
+ modified => DateTime(stat.mtime.s + local.offset)
+ accessed => DateTime(stat.atime.s + local.offset)
+ size FileSize => stat.size
+ changed                => change-stream(event-write)
+ extended               => change-stream(event-delete)
+ renamed                => change-stream(event-rename)
+ deleted                => change-stream(event-delete)
+ revoked                => change-stream(event-revoke)
+ changed-attributes     => change-stream(event-attrib)
+ changed-links          => change-stream(event-link)

_ path String

────────────────────
+ This
    - path String
    - noop

────────────────────
+ This ~ Char

~ "/"? (\file-word "/")+ \file-word?
    This(it)

.. file-word ~
    ~ \file-char+

.. file-char ~
    ~ [a-zA-Z0-9.]

────────────────────
+ from str String

This(str, 0)

────────────────────
+ to String

path

────────────────────
+ to Iterable'Path

contents

────────────────────
+ get hash Hash

hash-for(path)

────────────────────
+ get name String

|? last-slash
    path[last-slash + 1 ...]
??
     path

.. last-slash = path.find-reverse(separator)

────────────────────
+ get base-name String

|? last-dot && last-dot > 0
    name[... last-dot]
??
    name

.. last-dot = name.find-reverse(".")

────────────────────
+ get extension String

|? last-dot && last-dot > 0
    name[last-dot + 1 ...]
??
    ""

.. last-dot = name.find-reverse(".")

────────────────────
+ get dir

|? last-slash
    Path(path[0 .. < last-slash])
??
    Path("")

.. last-slash = path.find-reverse(separator)

────────────────────
+ get parent Path?

|? last-slash == null || path == separator
    null
|? last-slash == 0
    Path(separator, 0)
??
    Path(path[0 .. < last-slash], 0)

.. last-slash = path.find-reverse(separator)

────────────────────
+ get home-abbreviated String

|? home && (path == home || path.starts-with("$home$separator"))
    "~${path[home.length ...]}"
??
    path

.. home = env("HOME")

────────────────────
+ get head Path

|? first-slash == -1
    path
|? first-slash == 0 && second-slash == -1
    path[1 ...]
|? first-slash == 0
    path[1 .. < second-slash]
??
    path[0 .. < first-slash]

.. first-slash = path.find(separator) ?? -1
.. second-slash = path.find(separator, first-slash + 1) ?? -1

────────────────────
+ get tail Path

|? first-slash == -1
    ""
|? first-slash == 0
    path[second-slash + 1 ...]
??
    path[first-slash + 1 ...]

.. first-slash = path.find(separator) ?? -1
.. second-slash = path.find(separator, first-slash + 1) ?? -1

────────────────────
+ get ext String

|? last-dot && last-dot > 0
    file-name[last-dot + 1 ...]
??
    ""

.. file-name = name
.. last-dot = file-name.find-reverse(".")

────────────────────
+ get original Path

|? is-link
    buf.slice-string(0 .. < link-size)
??
    path

`  ?! current-file-error()
`      if it == -1

.. buf = Byte[4096]
.. link-size = C:readlink(path, buf, buf.size)

────────────────────
+ do get normalized String

. parts [String]
for part in absolute.split("/")
    if part == "" || part == "."
        continue
    if part == ".."
        if parts
            parts.pop()
        continue
    parts += part
= "/${"/".join(parts)}"

.. absolute = if path[0] == '/' then path else "${C:getcwd(Char[4096], 4096)}/$path"

────────────────────
+ do get resolved Path

. buf = Byte[4096]
. found = C:realpath(normalized, buf)
?! current-file-error()
    if !found
= Path(buf.slice-string(0 .. < C:strlen(buf)), 0)

────────────────────
+ do get entries <PathEntry>

. d = C:opendir(path)
    ?! current-file-error()
        if !it
do finally C:closedir(d)

. buf = Byte[4096]
. info BxDirEntry
while C:brixReadDirEntry(d, buf, &info)
    <= PathEntry(buf.slice-string(0 .. < info.name-length), info.kind as PathKind, info.inode)

────────────────────
+ do get contents <Path>

for entry in entries
    <= this / entry.name

────────────────────
+ get stat

?! current-file-error()
    if error

buf[0]

.. buf = FileStat[1]
.. error = C:brixStat(path, buf)

────────────────────
+ get components [String]

List'String
    ** path.split(separator)
    ?> each.length > 0

────────────────────
_ get lstat

?! current-file-error()
    if error

buf[0]

.. buf = FileStat[1]
.. error = C:brixLinkStat(path, buf)

────────────────────
+ this / subpath Path

|? !path
    subpath
|? path == separator
    "$path$subpath"
??
    "$path$separator$subpath"

────────────────────
+ !this

!path

────────────────────
+ split

path.split(separator)

────────────────────
+ relative-to Path?
    - base Path

|? path == "$base"
    Path("", 0)
|? path.starts-with(prefix)
    Path(path[prefix.length ...], 0)
??
    null

.. prefix = if "$base".ends-with(separator) then "$base" else "$base$separator"

────────────────────
+ find
    - pattern String
    - is-recursive = false

abs-pattern.match(is-recursive)

.. abs-pattern = this / pattern

────────────────────
+ do match <Path>
    - is-recursive = false

. buf = Glob[1]
. err = C:brixGlob(path, buf)
    ?! Error("Invalid pattern")
        if it
do finally C:brixGlobFree(buf)

. match = buf[0]
for i in 0 .. < match.count
    <= Path(match.paths[i] as String)

────────────────────
+ do rename
    - new-name String

. new-path = dir / new-name
move(new-path)
= new-path

────────────────────
+ do move
    - new-path Path

. status = C:rename(path as String, new-path as String)
handle-file-error(status)

────────────────────
+ do move-exclusive
    - new-path Path

. status = C:brixRenameExclusive(path as String, new-path as String)
handle-file-error(status)

────────────────────
+ do copy
    - new-path Path

. source = stat
. target FileStat
=? if C:brixStat(new-path as String, &target) == 0 && target.dev == source.dev && target.ino == source.ino
. this-file = use File'Byte(path)
. flags = FileFlags.create-mode /or/ FileFlags.write-mode /or/ FileFlags.truncate-mode
. new-file = use File'Byte(new-path, flags, source.mode as FilePermissions)

new-file <-* this-file as <Array>

────────────────────
+ do clone
    - new-path Path

. status = C:brixCloneFile(path, new-path as String)
handle-file-error(status)

────────────────────
+ do delete

. status = C:remove(path)
handle-file-error(status)

────────────────────
+ do hard-link
    - link-path Path

. status = C:link(path, link-path as String)
handle-file-error(status)

────────────────────
+ do soft-link
    - link-path Path

. status = C:symlink(path, link-path as String)
handle-file-error(status)

────────────────────
+ do change-mode
    - mode FilePermissions

. status = C:chmod(path, mode)
handle-file-error(status)

────────────────────
+ readable

File(this, FileFlags.read-mode)

────────────────────
+ writable

File(this, FileFlags.write-mode /or/ FileFlags.create-mode)

────────────────────
+ rewritable

File(this, FileFlags.write-mode /or/ FileFlags.create-mode /or/ FileFlags.truncate-mode)

────────────────────
+ do make-directory
    - name = ""
    - mode FilePermissions = 0

. actual-path = if name then this / name else this
. above = actual-path.parent ?? Path(".", 0)
. actual-mode = if mode then mode else (above.mode as FilePermissions)
. status = C:mkdir(actual-path as String, actual-mode)
handle-file-error(status)

────────────────────
+ do make-directories ?! Error
    - mode FilePermissions = 0

=? if is-dir
. above = parent
if above
    above.make-directories(mode)
make-directory("", mode)
    catch failure Error
        ?! failure if !is-dir

────────────────────
+ watch
    - is-recursive = false

PathWatchStream(normalized, is-recursive)

────────────────────
_ change-stream
    - change-type

FileChangeStream(this, change-type)

━━━━━━━━━━━━━━━━━━━━
+ PathKind is U8

| unknown = 0
| pipe = 1
| character-device = 2
| directory = 4
| block-device = 6
| file = 8
| link = 10
| socket = 12

━━━━━━━━━━━━━━━━━━━━
+ PathEntry is Tuple

+ name String
+ kind PathKind
+ inode U64

━━━━━━━━━━━━━━━━━━━━
+ PathWatchFlags is U64

| none = 0
| must-scan-subdirectories = 0x00000001
| user-dropped = 0x00000002
| kernel-dropped = 0x00000004
| event-ids-wrapped = 0x00000008
| history-done = 0x00000010
| root-changed = 0x00000020
| mounted = 0x00000040
| unmounted = 0x00000080
| created = 0x00000100
| removed = 0x00000200
| inode-metadata-modified = 0x00000400
| renamed = 0x00000800
| modified = 0x00001000
| finder-info-modified = 0x00002000
| owner-changed = 0x00004000
| extended-attributes-modified = 0x00008000
| is-file = 0x00010000
| is-directory = 0x00020000
| is-symbolic-link = 0x00040000
| own-event = 0x00080000
| is-hard-link = 0x00100000
| is-last-hard-link = 0x00200000
| cloned = 0x00400000

────────────────────
+ get must-rescan Bool

contains(PathWatchFlags.must-scan-subdirectories)

────────────────────
+ contains
    - flag PathWatchFlags

this /and/ flag != 0

━━━━━━━━━━━━━━━━━━━━
+ PathWatchEvent is Tuple

+ root Path
+ path Path
+ flags PathWatchFlags
+ must-rescan Bool
+ is-recursive Bool

────────────────────
+ This
    - root Path
    - path Path
    - flags PathWatchFlags
    - is-recursive Bool

.. must-rescan = flags.must-rescan

━━━━━━━━━━━━━━━━━━━━
+ PathWatchHandler is () Void
    - event PathWatchEvent

━━━━━━━━━━━━━━━━━━━━
+ PathWatchListener
    is Closable

+ source Broadcastable'PathWatchEvent
+ handler PathWatchHandler

_ subscription Subscription'PathWatchEvent?

────────────────────
+ This
    - source
    - handler

────────────────────
+ do close

. made = subscription
subscription = null
if made
    catch? source.unsubscribe(made)

────────────────────
+ do listen ?! Error

. made = Subscription'PathWatchEvent(this.dispatch)
subscription = made
source.subscribe(made)

────────────────────
_ do dispatch
    - event PathWatchEvent
    - from Broadcastable'PathWatchEvent

handler(event)

━━━━━━━━━━━━━━━━━━━━
+ do listen-for-changes PathWatchListener ?! Error
    - source Broadcastable'PathWatchEvent
    - handler PathWatchHandler

. listener = PathWatchListener(source, handler)
listener.listen()
= listener

━━━━━━━━━━━━━━━━━━━━
+ do temporary-directory ?! Error
    - prefix String = "brix"
    - parent String? = null

. root = parent ?? env("TMPDIR") ?? "/tmp"
. folder = if root.ends-with("/") then root[0 .. < root.length - 1] else root
. template = byte-view("$folder/$prefix.XXXXXX")
. buffer = Byte[template.length + 1]
buffer[0 .. < template.length] = template
buffer[template.length] = 0
?! current-file-error()
    if !C:mkdtemp(buffer)
= Path(buffer.slice-string(0 .. < template.length), 0)

━━━━━━━━━━━━━━━━━━━━
+ do executable-path Path ?! Error

. buffer = Byte[4096]
?! Error("This program's path is longer than ${buffer.size} bytes")
    if C:brixExecutablePath(buffer, buffer.size) != 0
= Path(buffer.slice-string(0 .. < C:strlen(buffer)), 0).resolved

━━━━━━━━━━━━━━━━━━━━
_ BxDirEntry is Tuple

+ inode U64
+ name-length U32
+ kind U32

━━━━━━━━━━━━━━━━━━━━
_ BxPathWatchNativeEvent is Tuple

+ path CPointer'Char8
+ flags U64

━━━━━━━━━━━━━━━━━━━━
_ PathWatchStream
    is Usable'Void
    is Closable

+ root Path
+ is-recursive Bool

_ watcher Pointer
_ lock Semaphore

as Broadcastable'PathWatchEvent for
_ channel := AsyncOnDemandChannel'PathWatchEvent(this)

────────────────────
+ This
    - root Path
    - is-recursive Bool

────────────────────
+ do begin-using

watcher = C:brixPathWatchCreate(root as String, is-recursive)
?! Error("Unable to watch path $root")
    if !watcher

. active-watcher = watcher
do new
    while true
        if C:brixSuspendActiveTaskUntilPathWatchEvent(active-watcher, lock.native-pointer)
            break

        . native-event BxPathWatchNativeEvent
        while C:brixPathWatchNextEvent(active-watcher, &native-event)
            . event-path = Path(native-event.path)
            . event-flags = native-event.flags as PathWatchFlags
            channel <- PathWatchEvent(root, event-path, event-flags, is-recursive)

    C:brixPathWatchRelease(active-watcher)
    if watcher == active-watcher
        watcher = Pointer()

────────────────────
+ do end-using

if watcher
    C:brixCancelPathWatchEventListener(watcher, lock.native-pointer)

────────────────────
+ do close

channel.close()

━━━━━━━━━━━━━━━━━━━━
_ FileChangeStream
    is Usable'Void

+ file File
+ path Path
+ change-type Int

_ lock Semaphore

as Broadcastable'Path for
_ channel := AsyncOnDemandChannel'Path(this)

────────────────────
+ This
    - path Path
    - change-type Int

.. file = File(path, FileFlags.event-only-mode)

────────────────────
+ do begin-using

do new
    while true
        if C:brixSuspendActiveTaskUntilFileChange(file, change-type, lock.native-pointer)
            break

        channel <- path

────────────────────
+ do end-using

C:brixCancelFileChangeEventListener(file, change-type, lock.native-pointer)
file.close()
