(import /BxCore/BxSystem.h)
(import /stdlib.h)
(import /unistd.h)
(blank)
(prop _ env-lock _ (:= (call Mutex)))

(fn-do + env (? String)
  (param name String)
  (use env-lock)
  (let value (call C:getenv name))
  (return-if null (if (not value)))
  (return (as value String))
)

(fn-do + env-required _
  (param name String)
  (return? (call env name))
  (throw (call Error (str name " variable not defined")))
)

(fn-do + set-env _
  (param name String)
  (param value String)
  (use env-lock)
  (call C:setenv name value 1)
)

(fn-do + environment (map String String)
  (use env-lock)
  (let variables (call (of Map String String)))
  (let entries (call C:brixEnvironment))
  (let index 0)
  (while true
    (let entry ([] entries index))
    (if (not entry)
      (break)
    )
    (let text (as entry String))
    (let split (call (. text find) "="))
    (if (!= split null)
      (= ([] variables ([] text (..< 0 split))) ([] text (... (+ split 1))))
    )
    (+= index 1)
  )
  (return variables)
)

(fn-expr + cwd String
  (call C:getcwd buf 4096)
  (where
    (lazy buf ([] Char8 4096))
  )
)
