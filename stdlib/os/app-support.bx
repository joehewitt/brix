(import ./bundle)
(import ./env)
(import ./path)
(blank)
(prop + main-app-id String (:= (?? main-bundle-id (call executable-name))))

(fn-expr + app-support-path _
  (param app-id String)
  (/ (call Path (?? (call env "HOME") "/tmp") 0) "Library" "Application Support" app-id)
)

(fn-expr _ executable-name String
  (if-expr path (. path name) "brix")
  (where
    (lazy path (catch? (call executable-path)))
  )
)
