(import ./env)
(import ./path)
(import ./terminal-emulator)
(import /math)
(blank)
(prop _ terminal-path-delimiters _ (= "\"'`()[]{}<>|,;=*\$!?&"))

(type + TerminalPathSpan (is Tuple)
  (prop + start Size)
  (prop + end Size)
  (prop + text String)
)

(type + TerminalPathLink (is Tuple)
  (prop + path String)
  (prop + line (? Size))
  (prop + column (? Size))
)

(fn-do + terminal-row-cells (list String)
  (param runs (list TerminalRun))
  (let cells (list String))
  (for (in run runs)
    (while (< (. cells length) (. run column))
      (+= cells " ")
    )
    (if (call (. run has-flag) terminal-run-isolated)
      (+= cells (. run text))
      (for (in index (..< 1 (. run columns)))
        (+= cells "")
      )
      (else
        (for (in point (. run text codepoints))
          (+= cells (str point))
        )
      )
    )
  )
  (return cells)
)

(fn-do + terminal-path-span (? TerminalPathSpan)
  (param cells (list String))
  (param column Size)
  (return-if null (if (or (>= column (. cells length)) (not (call terminal-is-path-cell ([] cells column))))))
  (blank)
  (let start column)
  (while (and (> start 0) (call terminal-is-path-cell ([] cells (- start 1))))
    (-= start 1)
  )
  (let end (+ column 1))
  (while (and (< end (. cells length)) (call terminal-is-path-cell ([] cells end)))
    (+= end 1)
  )
  (while (and (> end start) (or (== ([] cells (- end 1)) ".") (== ([] cells (- end 1)) ":")))
    (-= end 1)
  )
  (return-if null (if (<= end column)))
  (blank)
  (let text "")
  (for (in index (..< start end))
    (+= text ([] cells index))
  )
  (return (call TerminalPathSpan start end text))
)

(fn-do + terminal-path-link TerminalPathLink
  (param text String)
  (let parts (call (of List String) (call (. text split) ":")))
  (let numbers (list Size))
  (while (and (> (. parts length) 1) (< (. numbers length) 2))
    (let number (call terminal-path-number ([] parts (- (. parts length) 1))))
    (if (== number null)
      (break)
    )
    (call (. numbers insert) number 0)
    (call (. parts remove) (- (. parts length) 1))
  )
  (let line (only-if (call terminal-path-index ([] numbers 0)) (if (> (. numbers length) 0))))
  (let column (only-if (call terminal-path-index ([] numbers 1)) (if (> (. numbers length) 1))))
  (return (call TerminalPathLink (call (. ":" join) parts) line column))
)

(fn-do + terminal-resolve-file (? String)
  (param text String)
  (param bases (list String))
  (for (in candidate (call terminal-path-candidates text bases))
    (let path (call Path candidate 0))
    (if (and (. path exists) (not (. path is-dir)))
      (return (str (?? (catch? (. path resolved)) path)))
    )
  )
  (return null)
)

(fn-do _ terminal-path-candidates (list String)
  (param text String)
  (param bases (list String))
  (let found (list String))
  (return-if found (if (== (. text length) 0)))
  (blank)
  (if (call (. text starts-with) "/")
    (+= found text)
    (return found)
  )
  (if (call (. text starts-with) "~/")
    (let home (call env "HOME"))
    (if home
      (+= found (str home ([] text (... 1))))
    )
    (return found)
  )
  (for (in base bases)
    (+= found (str base "/" text))
    (if (or (call (. text starts-with) "a/") (call (. text starts-with) "b/"))
      (+= found (str base "/" ([] text (... 2))))
    )
  )
  (return found)
)

(fn-expr _ terminal-is-path-cell Bool
  (param cell String)
  (or (== (. cell length) 0) (and (!= cell " ") (!= cell "\t") (== (call (. terminal-path-delimiters find) cell) null)))
)

(fn-do _ terminal-path-number (? Size)
  (param text String)
  (return-if null (if (not text)))
  (blank)
  (let value Size 0)
  (for (in char text)
    (return-if null (if (or (< char '0') (> char '9'))))
    (blank)
    (= value (+ (* value 10) (- (as char U32) (as '0' U32))))
  )
  (return value)
)

(fn-expr _ terminal-path-index Size
  (param number Size)
  (- (call max number 1) 1)
)
