do stdin?.close()

────────────────────
+ do close

do stdin?.close()
do stdout?.close()
do stderr?.close()

────────────────────
+ read
    - size Size
    - buffer Byte[]

stdout!.read(size, buffer)

━━━━━━━━━━━━━━━━━━━━
+ do process-pipe ProcessPipe ?! IOError

. ends = open-pipe("a process pipe")
C:brixfcntl(ends[0], C:F_SETFD, C:FD_CLOEXEC)
C:brixfcntl(ends[1], C:F_SETFD, C:FD_CLOEXEC)
= ProcessPipe(File(ends[0]), File(ends[1]))

━━━━━━━━━━━━━━━━━━━━
+ do connected-process ConnectedProcess ?! Error
    - name String
    - stderr-mode ProcessStderr = ProcessStderr.inherit
    - args [String] = List'String()
    - directory String? = null
    - variables [String = String]? = null
    - descriptors [I32] = List'I32()

. ends = I32[2]
?! IOError("Unable to create a socket for $name")
    if !C:brixSocketPair(ends)
. passed [I32]
passed += ends[1]
passed ++= descriptors
. spawned = Process(name, stderr-mode, args, directory, variables, passed)
    catch failure Error
        C:close(ends[0])
        C:close(ends[1])
        ?! failure
C:close(ends[1])
= ConnectedProcess(spawned, File(ends[0]))

━━━━━━━━━━━━━━━━━━━━
+ do process-children [Int]
    - parent Int

= listed-processes(false, parent)

━━━━━━━━━━━━━━━━━━━━
+ do process-group-members [Int]
    - group Int

= listed-processes(true, group)

━━━━━━━━━━━━━━━━━━━━
+ do process-directory String?
    - pid Int

. buffer = Byte[4096]
. length = C:brixProcessDirectory(pid, buffer, buffer.size)
=? null if length < 0
= buffer.slice-string(0 .. < (length as Size))

━━━━━━━━━━━━━━━━━━━━
_ do listed-processes [Int]
    - by-group Bool
    - value Int

. capacity Size = 64
while true
    . pids = I32[capacity]
    . count = if by-group then C:brixProcessGroupMembers(value, pids, capacity) else C:brixChildProcesses(value, pids, capacity)
    =? List'Int() if count <= 0
    if count < capacity
        . listed [Int]
        for index in 0 .. < count
            listed += pids[index]
        = listed
    capacity *= 2

━━━━━━━━━━━━━━━━━━━━
_ do open-pipe ?! IOError
    - name String

. ends = I32[2]
?! IOError("Unable to open a pipe for $name")
    if C:pipe(ends) == -1
= ends

━━━━━━━━━━━━━━━━━━━━
_ do duplicate-descriptors ?! IOError
    - name String
    - descriptors [I32]

. floor = 3 + (descriptors.length as I32)
. copies = List'I32()
for descriptor in descriptors
    . copy = C:brixfcntl(descriptor, C:F_DUPFD_CLOEXEC, floor)
    if copy == -1
        close-descriptors(copies)
        ?! IOError("Unable to pass descriptor $descriptor to $name")
    copies.append(copy)
= copies

━━━━━━━━━━━━━━━━━━━━
_ do close-descriptors
    - descriptors [I32]

for descriptor in descriptors
    C:close(descriptor)

━━━━━━━━━━━━━━━━━━━━
_ do close-pipe
    - ends I32[]

C:close(ends[0])
C:close(ends[1])

━━━━━━━━━━━━━━━━━━━━
_ ProcessExitStream
    is Usable'Void

+ process Process

_ lock Semaphore

as Broadcastable'Int for
_ channel := AsyncOnDemandChannel'Int(this)

────────────────────
+ This
    - process Process

────────────────────
+ do begin-using

do new
    . status = process.wait(lock)
    if status
        channel <- status

────────────────────
+ do end-using

C:brixCancelProcExitEventListener(process.pid, lock.native-pointer)
