━━━━━━━━━━━━━━━━━━━━
+ Process
    is Usable'Void
    is Closable
    is ReadableData'Char
    is WritableData

+ pid Int
+ stderr File?
+ leads-group Bool
+ closed := ProcessExitStream(this)

_ stdin File?
_ stdout File?
_ status Int
_ reaped-usage ProcessUsage?
_ is-reaped Bool

────────────────────
+ This
    - pid Int
    - stdout File?
    - stdin File?
    - stderr File? = null
    - leads-group = false

────────────────────
+ This
    - name String
    ... args [String] = List'String()

= This(name, args)

────────────────────
+ This ?! Error
    - name String
    - args [String]
    - directory String? = null
    - variables [String = String]? = null

= This(name, ProcessStderr.inherit, args, directory, variables)

────────────────────
+ This ?! Error
    - name String
    - stderr-mode ProcessStderr
    - args [String]
    - directory String? = null
    - variables [String = String]? = null
    - descriptors [I32] = List'I32()
    - stdio-mode ProcessStdio = ProcessStdio.pipe
    - group ProcessGroup = ProcessGroup.inherit
    - output-file File? = null

. captures-errors = stderr-mode == ProcessStderr.capture
. pipes = stdio-mode == ProcessStdio.pipe
. leads = group == ProcessGroup.own
. argv =
    * name
    ** args
    -> String[1 + args.length + 1]
. entries = variables ?? environment()
. envp =
    ** entries
    *> "${each[0]}=${each[1]}"
    -> String[entries.length + 1]

. passed = duplicate-descriptors(name, descriptors)
do finally close-descriptors(passed)
. input = I32[2]
. output = I32[2]
if pipes
    input = open-pipe(name)
    output = open-pipe(name)
        catch failure Error
            close-pipe(input)
            ?! failure
. errors = I32[2]
if captures-errors
    errors = open-pipe(name)
        catch failure Error
            if pipes
                close-pipe(input)
                close-pipe(output)
            ?! failure

. redirected = output-file?.fd ?? inherited-stream
. streams = I32[3]
streams[0] = if pipes then input[0] else inherited-stream
streams[1] = if pipes then output[1] else redirected
streams[2] = redirected
if captures-errors
    streams[2] = errors[1]
else if stderr-mode == ProcessStderr.discard
    streams[2] = discarded-stream
. passing = I32[passed.length]
for index in 0 .. < passed.length
    passing[index] = passed[index]
. child = C:brixSpawn
    - name
    - argv
    - envp
    - directory ?? ""
    - streams
    - passing
    - passed.length
    - if leads then 1 else 0
if child < 0
    if pipes
        close-pipe(input)
        close-pipe(output)
    if captures-errors
        close-pipe(errors)
    ?! IOError("Unable to run $name: ${C:strerror(-child)}")

. captured File?
if captures-errors
    C:close(errors[1])
    captured = File(errors[0])
if !pipes
    = This(child, null, null, captured, leads)
C:close(input[0])
C:close(output[1])
= This(child, File(output[0]), File(input[1]), captured, leads)

────────────────────
+ write
    - buffer ImmutableArray'Byte
    - size Size

stdin!.write(buffer, size)

────────────────────
+ do wait Int?
    - sem Semaphore?

` Waits for the process to end and gives its exit status. It gives none where the listener `sem`
` names is cancelled, and ends the waiting task where that task is cancelled. Every task that
` waits for the process at once receives the same status.
=? status if is-reaped

. semaphore-pointer Pointer
if sem
    semaphore-pointer = sem.native-pointer
if !C:brixSuspendActiveTaskUntilProcExit(pid, semaphore-pointer)
    collect()
    = status
check-task-cancelation(Task().is-cancel-in-force)

────────────────────
+ do wait-usage ProcessUsage? ?! IOError

` Waits for the process to end and gives its exit status with the resources it used. Where the
` process was already waited for, it gives what that wait collected.
=? reaped-usage if is-reaped
if C:brixSuspendActiveTaskUntilProcExit(pid, null)
    check-task-cancelation(Task().is-cancel-in-force)
    = null
. error = collect()
?! IOError("Unable to wait for process $pid: ${C:strerror(error)}")
    if error != 0
= reaped-usage

────────────────────
_ do collect I32

=? 0 if is-reaped
. usage = ProcessUsage[1]
. error = C:brixReapProcess(pid, usage)
=? error if error != 0
. reaped = usage[0]
status = if reaped.signal != 0 then signaled-status-base + reaped.signal else reaped.exit-code
reaped-usage = reaped
is-reaped = true
= 0

────────────────────
+ do terminate

send-signal(C:SIGTERM)

────────────────────
+ do kill

send-signal(C:SIGKILL)

────────────────────
+ do reap

` Ends the process where it still runs, with SIGKILL, and waits for it with the active task's
` cancellation held off, so that it is reaped however the task that started it ends. A cleanup
` calls it; where the process was already waited for, it does nothing.
=? if is-reaped
kill()
do without cancel
    do wait(null)

────────────────────
+ do terminate-group

=? if !leads-group
C:kill(-pid, C:SIGTERM)

────────────────────
+ do kill-tree

. tree [Int]
if leads-group
    C:kill(-pid, C:SIGSTOP)
    tree ++= process-group-members(pid)
if !is-reaped && !(tree has pid)
    tree += pid
. index Index = 0
while index < tree.length
    for child in process-children(tree[index])
        if !(tree has child)
            C:kill(child, C:SIGSTOP)
            tree += child
    index += 1
for member in tree
    C:kill(member, C:SIGKILL)
if leads-group
    C:kill(-pid, C:SIGKILL)

────────────────────
+ get group-members [Int]

if leads-group then process-group-members(pid) else List'Int()

────────────────────
_ do send-signal
    - number I32

=? if is-reaped
C:kill(pid, number)

────────────────────
+ begin-using

this

────────────────────
+ do end-using

` Ends a process a `use` scope started, as `reap` does, and closes its streams. A process meant to
` outlive the scope that starts it is made without `use`, and its maker reaps it.
reap()
close()

