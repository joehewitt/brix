./file
./path
/stream/sort
/time/debounced
/time/duration

+ file-tree-flush-delay = 16ms

_ file-tree-new-file-perms =
    user-read-perm /or/ user-write-perm /or/ group-read-perm /or/ other-read-perm

+ FileRelocation is (from String, to String?)

━━━━━━━━━━━━━━━━━━━━
+ FileTree
    is Closable

+ root FileNode
+ hides-name FileNameFilter = file-tree-hides-name
+ is-watching = false
+ event changed [FileNode]
+ event modified FileNode
+ event relocated FileRelocation

_ directories Map'String'FileNode
_ dirty Map'String'FileNode
_ next-key Size = 1
_ schedule-flush DebouncedAction
_ is-closed = false
_ is-watch-pending = true
_ watch Closable?
_ changes Broadcastable'PathWatchEvent?
_ observed Map'String'FileNode
_ stale Map'String'FileNode

────────────────────
+ This
    - location Path
    - changes = null

. resolved = catch? location.resolved ?? location
root = FileNode(take-key(), "$resolved", PathKind.directory, 0, true)
root.retain-count = 1
schedule-flush = throttled(file-tree-flush-delay, this.flush)

────────────────────
+ do close

is-closed = true
is-watching = false
. stream = watch
watch = null
if stream
    stream.close()

────────────────────
+ get loaded-count Size

directories.length

────────────────────
+ do children-of [FileNode]?
    - node FileNode

=
    |? !node.is-directory
        null
    ??
        node.children ?? load(node)

────────────────────
+ do retain
    - node FileNode

node.retain-count += 1

────────────────────
+ do release
    - node FileNode

if node.retain-count > 0
    node.retain-count -= 1

────────────────────
+ do key-path [String]
    - target Path

. node = find(target)
= if node then keys-to(node) else List'String()

────────────────────
+ do find FileNode?
    - target Path

. names = relative-names(target)
=? if names == null
. node = root
for name in names
    . children = children-of(node)
    =? if children == null
    . found = file-tree-named(children, name)
    =? if !found
    node = found
= node

────────────────────
+ do contains Bool
    - target Path

= relative-names(target) != null

────────────────────
+ do observe
    - node FileNode

node.observe-count += 1
observed[node.key] = node

────────────────────
+ do unobserve
    - node FileNode

=? if node.observe-count == 0
node.observe-count -= 1
=? if node.observe-count > 0
if observed has node.key
    -= observed[node.key]
if stale has node.key
    -= stale[node.key]

────────────────────
+ keys-to [String]
    - node FileNode

|? owner
    List'String
        ** keys-to(owner)
        * node.key
??
    List'String()

.. owner = node.parent

────────────────────
+ do create FileNode? ?! Error
    - owner FileNode
    - is-folder Bool

. location = owner.path
. name = file-tree-free-name(location, if is-folder then "untitled folder" else "untitled")
if is-folder
    (location / name).make-directory()
else
    . mode = FileFlags.write-mode + FileFlags.create-mode + FileFlags.exclusive-mode
    . made = File((location / name), mode, file-tree-new-file-perms)
    made.close()
settle([owner])
= named(owner, name)

────────────────────
+ do rename ?! Error
    - node FileNode
    - name String

. owner = node.parent
=? if !owner || name == node.name
?! Error("A name cannot be empty")
    if !name
?! Error("A name cannot contain a slash")
    if name.find("/") != null
?! Error("$name is not a usable name")
    if name == "." || name == ".."
. location = owner.path
. from = node.relative-path
(location / node.name).move-exclusive(location / name)
settle([owner])
relocated <- FileRelocation(from, file-tree-join(owner.relative-path, name))

────────────────────
+ do move ?! Error
    - nodes [FileNode]
    - owner FileNode

. location = owner.path
. owners [FileNode] = [owner]
do finally settle(owners)
for node in nodes
    . source = node.parent
    if source && source.key != owner.key
        owners += source
        . from = node.relative-path
        node.path.move-exclusive(location / node.name)
        relocated <- FileRelocation(from, file-tree-join(owner.relative-path, node.name))

────────────────────
+ do receive ?! Error
    - paths [Path]
    - owner FileNode
    - copies Bool

. location = owner.path
do finally settle([owner])
for path in paths
    . target = location / path.name
    if copies
        file-tree-copy(path, target)
    else if "${path.dir}" != "$location"
        . from = relative-of(path)
        path.move-exclusive(target)
        if from != null
            relocated <- FileRelocation(from, file-tree-join(owner.relative-path, path.name))

────────────────────
+ do duplicate FileNode? ?! Error
    - node FileNode

. owner = node.parent
=? null if !owner
. location = owner.path
. name = file-tree-copy-name(location, node.name)
file-tree-copy(node.path, location / name)
settle([owner])
= named(owner, name)

────────────────────
+ do removed
    - node FileNode

. owner = node.parent
=? if !owner
. from = node.relative-path
settle([owner])
relocated <- FileRelocation(from, null)

────────────────────
+ do flush

=? if is-closed
. touched = List'FileNode(stale.values)
stale.clear()
flush-directories()
for node in touched
    if !node.is-detached
        modified <- node

────────────────────
_ do flush-directories

=? if !dirty
. batch = List'FileNode(dirty.values)
dirty.clear()

. scans [FileTreeScan]
. orphans = Map'U64'FileNode()
. touched [FileNode]
for node in batch
    if node.is-detached || node.children == null
        continue
    if node.retain-count == 0
        unload(node)
        touched += node
        continue
    scans += scan(node, orphans)

for found in scans
    if rebuild(found, orphans)
        touched += found.node

for node in orphans.values
    detach(node)

if touched
    changed <- touched

────────────────────
_ do settle
    - owners [FileNode]

for owner in owners
    owner.retain-count += 1
    dirty[owner.key] = owner
flush()
for owner in owners
    owner.retain-count -= 1

────────────────────
_ relative-of String?
    - path Path

|? text == base
    ""
|? text.starts-with("$base/")
    text[base.length + 1 ...]
??
    null

.. base = "${root.path}"
.. text = "$path"

────────────────────
_ do named FileNode?
    - owner FileNode
    - name String

. children = children-of(owner)
= file-tree-named(children, name) if children != null

────────────────────
_ do relative-names [String]?
    - target Path

. names = target.relative-to(root.path)?.components
=? names if names
. resolved = catch? target.resolved ?? target
= resolved.relative-to(root.path)?.components

────────────────────
_ do take-key

. key = "$next-key"
next-key += 1
= key

────────────────────
_ do ensure-watching

=? if !is-watch-pending || is-closed
is-watch-pending = false
. location = root.path
if location.is-dir
    watch-root(location)

────────────────────
_ do watch-root
    - location Path

. source = changes ?? (location.watch(true) as Broadcastable'PathWatchEvent)
watch = catch? listen-for-changes(source, this.note)
is-watching = watch != null

────────────────────
_ do note
    - event PathWatchEvent

=? if is-closed
. text = event.path as String
if event.must-rescan
    mark-loaded-under(text)
    =
if event.flags.contains(PathWatchFlags.root-changed)
    mark(root)
note-observed(text)
=? if !file-tree-changes-names(event.flags)
. above = event.path.parent
=? if !above
. owner = directories["${above}"]
if owner
    mark(owner)

────────────────────
_ do note-observed
    - text String

=? if !observed
. found = false
for node in observed.values
    if file-tree-is-at(node, text) && !(stale has node.key)
        stale[node.key] = node
        found = true
if found
    schedule-flush()

────────────────────
_ do mark
    - node FileNode

dirty[node.key] = node
schedule-flush()

────────────────────
_ do mark-loaded-under
    - text String

. prefix = "$text/"
for pair in directories.items
    if pair.key == text || pair.key.starts-with(prefix)
        dirty[pair.value.key] = pair.value
schedule-flush()

────────────────────
_ do load [FileNode]
    - node FileNode

ensure-watching()
. location = node.path
. listed = file-entries(location, hides-name)
. entries = listed ?? List'FileEntry()
. next = List'FileNode
    ** entries
    *> FileNode(take-key(), each.name, each.kind, each.inode, each.is-directory, node)
. sorted = file-tree-sorted(next)
node.is-unreadable = listed == null
node.children = sorted
index(node, "$location")
= sorted

────────────────────
_ do scan FileTreeScan
    - node FileNode
    - orphans Map'U64'FileNode

. listed = catch? List'PathEntry(node.path.entries)
. entries = listed ?? List'PathEntry()
. present = Map'String'PathEntry()
for entry in entries
    present[entry.name] = entry

. kept = Map'String'FileNode()
. lost Size = 0
for child in node.children!
    . entry = present[child.name]
    if entry && file-tree-is-same-item(child, entry)
        kept[child.name] = child
    else
        . previous = orphans[child.inode]
        if previous
            detach(previous)
        orphans[child.inode] = child
        lost += 1
= FileTreeScan(node, entries, kept, listed != null, lost)

────────────────────
_ do rebuild Bool
    - found FileTreeScan
    - orphans Map'U64'FileNode

. node = found.node
. location = node.path
. next [FileNode]
. gained Size = 0
for entry in found.entries
    if hides-name(entry.name)
        continue
    . child = found.kept[entry.name]
    if child
        child.inode = entry.inode
        next += child
        continue
    . is-directory = file-tree-entry-is-directory(location, entry)
    . moved = orphans[entry.inode]
    if moved && moved.kind == entry.kind && moved.is-directory == is-directory
        -= orphans[entry.inode]
        adopt(moved, node, entry.name)
        next += moved
    else
        next += FileNode(take-key(), entry.name, entry.kind, entry.inode, is-directory, node)
    gained += 1

. unreadable = !found.is-readable
=? false if gained == 0 && found.lost == 0 && node.is-unreadable == unreadable
node.is-unreadable = unreadable
node.children = file-tree-sorted(next)
= true

────────────────────
_ do adopt
    - node FileNode
    - owner FileNode
    - name String

node.parent = owner
node.name = name
node.sort-name = name.lowercased
if node.children != null
    reindex(node)
    mark(node)

────────────────────
_ do reindex
    - node FileNode

forget(node)
index(node, "${node.path}")
for child in node.children!
    if child.children != null
        reindex(child)

────────────────────
_ do index
    - node FileNode
    - text String

node.listed-path = text
directories[text] = node

────────────────────
_ do forget
    - node FileNode

. text = node.listed-path
=? if !text
node.listed-path = null
. indexed = directories[text]
if indexed && indexed.key == node.key
    -= directories[text]

────────────────────
_ do unload
    - node FileNode

. children = node.children
=? if children == null
for child in children
    detach(child)
node.children = null
forget(node)

────────────────────
_ do detach
    - node FileNode

node.is-detached = true
unload(node)

━━━━━━━━━━━━━━━━━━━━
+ FileNameFilter is () Bool
    - name String

━━━━━━━━━━━━━━━━━━━━
+ FileEntry is Tuple

+ name String
+ kind PathKind
+ inode U64
+ is-directory Bool

━━━━━━━━━━━━━━━━━━━━
+ FileNode

+ key String
+ name String
+ sort-name String
+ kind PathKind
+ inode U64
+ is-directory Bool
+ parent FileNode?
+ children [FileNode]?
+ listed-path String?
+ retain-count Size = 0
+ observe-count Size = 0
+ is-unreadable = false
+ is-detached = false

────────────────────
+ This
    - key
    - name
    - kind
    - inode
    - is-directory
    - parent FileNode? = null

sort-name = name.lowercased

────────────────────
+ get path Path

|? owner
    owner.path / name
??
    Path(name, 0)

.. owner = parent

────────────────────
+ get relative-path String

|? !owner
    ""
|? !owner.parent
    name
??
    "${owner.relative-path}/$name"

.. owner = parent

━━━━━━━━━━━━━━━━━━━━
+ do file-node-is-within Bool
    - node FileNode
    - ancestor FileNode

. cursor FileNode? = node
while cursor
    =? true if cursor.key == ancestor.key
    cursor = cursor.parent
= false

━━━━━━━━━━━━━━━━━━━━
+ file-tree-hides-name Bool
    - name String

name == ".DS_Store"

━━━━━━━━━━━━━━━━━━━━
+ do file-entries [FileEntry]?
    - location Path
    - hides FileNameFilter

. listed = catch? List'PathEntry(location.entries)
= match listed
    |= null
        null
    ??
        List'FileEntry
            ** listed
            ?*>
                FileEntry(each.name, each.kind, each.inode, is-directory) if !hides(each.name)
                .. is-directory = file-tree-entry-is-directory(location, each)

━━━━━━━━━━━━━━━━━━━━
+ file-tree-entry-is-directory Bool
    - location Path
    - entry PathEntry

match entry.kind
    |= PathKind.directory
        true
    |= PathKind.link
        catch? (location / entry.name).is-dir ?? false
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ file-order Comparison
    - left
    - right

|? left.is-directory && !right.is-directory
    Comparison.lesser
|? right.is-directory && !left.is-directory
    Comparison.greater
|? left.sort-name < right.sort-name
    Comparison.lesser
|? left.sort-name > right.sort-name
    Comparison.greater
|? left.name < right.name
    Comparison.lesser
|? left.name > right.name
    Comparison.greater
??
    Comparison.equal

━━━━━━━━━━━━━━━━━━━━
_ FileTreeScan is Tuple

+ node FileNode
+ entries [PathEntry]
+ kept Map'String'FileNode
+ is-readable Bool
+ lost Size

━━━━━━━━━━━━━━━━━━━━
+ do file-tree-copy ?! Error
    - source Path
    - target Path

?! Error("An item named ${target.name} already exists")
    if target.exists
source.clone(target)
    catch failure Error
        file-tree-duplicate(source, target)

━━━━━━━━━━━━━━━━━━━━
_ do file-tree-duplicate ?! Error
    - source Path
    - target Path

if !source.is-dir
    source.copy(target)
    =
target.make-directory()
for entry in source.entries
    file-tree-duplicate(source / entry.name, target / entry.name)

━━━━━━━━━━━━━━━━━━━━
_ file-tree-join String
    - base String
    - name String

if base == "" then name else "$base/$name"

━━━━━━━━━━━━━━━━━━━━
_ do file-tree-copy-name String
    - location Path
    - name String

. dot = name.find-reverse(".")
. stem = if dot == null || dot == 0 then name else name[0 .. < dot]
. suffix = if dot == null || dot == 0 then "" else name[dot ...]
. candidate = "$stem copy$suffix"
. count = 2
while (location / candidate).exists
    candidate = "$stem copy $count$suffix"
    count += 1
= candidate

━━━━━━━━━━━━━━━━━━━━
_ do file-tree-free-name String
    - location Path
    - stem String

. name = stem
. count = 2
while (location / name).exists
    name = "$stem $count"
    count += 1
= name

━━━━━━━━━━━━━━━━━━━━
_ file-tree-changes-names Bool
    - flags PathWatchFlags

flags /and/ names != 0

.. names = entries /or/ mounts
.. entries = PathWatchFlags.created /or/ PathWatchFlags.removed /or/ PathWatchFlags.renamed
.. mounts = PathWatchFlags.mounted /or/ PathWatchFlags.unmounted

━━━━━━━━━━━━━━━━━━━━
_ file-tree-is-at Bool
    - node FileNode
    - text String

!node.is-detached && text.ends-with(node.name) && text == "${node.path}"

━━━━━━━━━━━━━━━━━━━━
_ file-tree-is-same-item Bool
    - node FileNode
    - entry PathEntry

node.kind == entry.kind && (!node.is-directory || node.inode == entry.inode)

━━━━━━━━━━━━━━━━━━━━
_ do file-tree-named FileNode?
    - nodes [FileNode]
    - name String

for node in nodes
    =? node if node.name == name

━━━━━━━━━━━━━━━━━━━━
_ file-tree-sorted [FileNode]
    - nodes [FileNode]

sort(nodes) • using file-order
