./clock
./duration
./timer
/BxEvents/BxEvents.h

━━━━━━━━━━━━━━━━━━━━
+ Deadline is Tuple

+ nanoseconds U64

────────────────────
+ This
    - after Nanoseconds

= This(monotonic-time-nanoseconds() + after as U64)

────────────────────
+ get has-passed

monotonic-time-nanoseconds() >= nanoseconds

────────────────────
+ get remaining Nanoseconds

if nanoseconds > now then (nanoseconds - now) as Nanoseconds else 0ns

.. now = monotonic-time-nanoseconds()

━━━━━━━━━━━━━━━━━━━━
+ wait-for-handle U32 @door(time)
    - fd I32
    - writable Bool
    - deadline Deadline

|? writable
    C:brixSuspendActiveTaskUntilWritable(fd, deadline.nanoseconds)
??
    C:brixSuspendActiveTaskUntilReadable(fd, deadline.nanoseconds)
