(import ./clock)
(import ./ctime)
(import ./deadline)
(import ./duration)
(import ./timer)
(import ./zone)
(import /BxEvents/BxEvents.h)

(type + FakeClock
  (prop + zone TimeZone)
  (blank)
  (prop _ wall U64)
  (prop _ monotonic U64 (= 1000000000))
  (prop _ waiters (list ClockWaiter))
  (prop _ next-id U64 (= 1))
  (prop _ lock _ (= (call Mutex)))
  (fn-do + This _
    (param start CSeconds (= 1767225600))
    (param zone _ (= utc))
    (= wall (* (as start U64) 1000000000))
  )
  (fn-do + advance _
    (param by Duration)
    (let target (as (+ monotonic (as by Nanoseconds)) U64))
    (call settle)
    (while true
      (let waiter (call take-due target))
      (if (not waiter)
        (break)
      )
      (call move-to (. waiter deadline))
      (call check-task-cancelation (call (. waiter task resume-now)))
      (call settle)
    )
    (call move-to target)
  )
  (fn-expr + get-clock-time CTimeSpec
    (call CTimeSpec (as (/ wall 1000000000) CSeconds) (as (% wall 1000000000) CNanoseconds))
  )
  (fn-expr + get-utc-time CSeconds
    (as (/ wall 1000000000) CSeconds)
  )
  (fn-expr + local-time-zone TimeZone
    zone
  )
  (fn-expr + monotonic-time-nanoseconds U64
    monotonic
  )
  (fn-do + wait-for-duration Bool
    (param delay Microseconds)
    (param sem Semaphore)
    (let task (call Task))
    (return-if true (if (. task is-canceled)))
    (return-if (call real-wait-for-duration delay sem) (if (<= delay 0)))
    (blank)
    (let id (call add-waiter (as (+ monotonic (as delay Nanoseconds)) U64) sem task))
    (let canceled (call (. task suspend)))
    (return (or (== (call remove-waiter id) .canceled) canceled))
  )
  (fn-do + cancel-timer-event-listener _
    (param sem Semaphore)
    (let task (call cancel-waiter sem))
    (call (?. task resume-later))
  )
  (fn-do + freeze-thread _
    (param delay Duration)
    (call advance delay)
  )
  (fn-do + wait-for-handle U32
    (param fd I32)
    (param writable Bool)
    (param deadline Deadline)
    (let task (call Task))
    (return-if (as (. HandleWait canceled) U32) (if (. task is-canceled)))
    (return-if (as (. HandleWait timed-out) U32) (if (>= monotonic (. deadline nanoseconds))))
    (blank)
    (let id (call add-waiter (. deadline nanoseconds) null task))
    (let watcher
      (do-new
        (if (and (== (call wait-without-deadline fd writable) (as (. HandleWait ready) U32)) (call mark-ready id))
          (call (. task resume-later))
        )
      )
    )
    (let canceled (call (. task suspend)))
    (let state (call remove-waiter id))
    (call (. watcher cancel-later))
    (return-if (as (. HandleWait canceled) U32) (if canceled))
    (return (if-expr (== state .due) (as (. HandleWait timed-out) U32) (as (. HandleWait ready) U32)))
  )
  (fn-do _ move-to _
    (param point U64)
    (return-if (if (<= point monotonic)))
    (blank)
    (+= wall (- point monotonic))
    (= monotonic point)
  )
  (fn-do _ settle _
    (call check-task-cancelation (call real-wait-for-duration 0 (call Semaphore)))
  )
  (fn-do _ add-waiter U64
    (param deadline U64)
    (param sem (? Semaphore))
    (param task Task)
    (use lock)
    (let id next-id)
    (+= next-id 1)
    (+= waiters (call ClockWaiter id deadline sem task .pending))
    (return id)
  )
  (fn-do _ remove-waiter WaiterState
    (param id U64)
    (use lock)
    (for (in index (..< 0 (. waiters length)))
      (if (== (. ([] waiters index) id) id)
        (let state (. ([] waiters index) state))
        (call (. waiters remove) index)
        (return state)
      )
    )
    (return .pending)
  )
  (fn-do _ take-due (? ClockWaiter)
    (param target U64)
    (use lock)
    (let found Index -1)
    (for (in index (..< 0 (. waiters length)))
      (let waiter ([] waiters index))
      (if (and (== (. waiter state) .pending) (<= (. waiter deadline) target))
        (if (or (< found 0) (< (. waiter deadline) (. ([] waiters found) deadline)))
          (= found index)
        )
      )
    )
    (return-if null (if (< found 0)))
    (blank)
    (= ([] waiters found) (= (. ([] waiters found) state) .due))
    (return ([] waiters found))
  )
  (fn-do _ cancel-waiter (? Task)
    (param sem Semaphore)
    (use lock)
    (for (in index (..< 0 (. waiters length)))
      (let waiter ([] waiters index))
      (if (and (== (. waiter state) .pending) (== (?. (. waiter sem) native-pointer) (. sem native-pointer)))
        (= ([] waiters index) (= (. waiter state) .canceled))
        (return (. waiter task))
      )
    )
    (return null)
  )
  (fn-do _ mark-ready Bool
    (param id U64)
    (use lock)
    (for (in index (..< 0 (. waiters length)))
      (let waiter ([] waiters index))
      (if (and (== (. waiter id) id) (== (. waiter state) .pending))
        (= ([] waiters index) (= (. waiter state) .ready))
        (return true)
      )
    )
    (return false)
  )
)

(type _ ClockWaiter (is Tuple)
  (prop + id U64)
  (prop + deadline U64)
  (prop + sem (? Semaphore))
  (prop + task Task)
  (prop + state WaiterState)
)

(type _ WaiterState (is U8)
  (variant pending (= 0))
  (variant due (= 1))
  (variant canceled (= 2))
  (variant ready (= 3))
)

(type _ HandleWait (is U32)
  (variant ready (= 0))
  (variant canceled (= 1))
  (variant timed-out (= 2))
)

(fn-expr _ wait-without-deadline U32
  (param fd I32)
  (param writable Bool)
  (case? writable
    (call C:brixSuspendActiveTaskUntilWritable fd 0)
  )
  (default
    (call C:brixSuspendActiveTaskUntilReadable fd 0)
  )
)

(fn-do _ real-wait-for-duration Bool
  (param delay Microseconds)
  (param sem Semaphore)
  (return (call wait-for-duration delay sem))
)
