
./ctime
./duration
/BxCore/BxTime.h

━━━━━━━━━━━━━━━━━━━━
+ effect time
    - C:clock_gettime
    - C:nanosleep
    - C:brixGetUTCTime
    - C:brixGetTimeZone
    - C:brixGetTimeZoneOffset
    - C:brixMonotonicTimeNanoseconds
    - C:brixSuspendActiveTaskUntilTime
    - C:brixSuspendActiveTaskUntilAbsoluteTime
    - C:brixCancelTimerEventListener

━━━━━━━━━━━━━━━━━━━━
+ ClockTime is Tuple

+ s CSeconds
+ ns CNanoseconds

────────────────────
+ this == other ClockTime

s == other.s && ns == other.ns

────────────────────
+ this > other ClockTime

s > other.s || (s == other.s && ns > other.ns)

────────────────────
+ this < other ClockTime

s < other.s || (s == other.s && ns < other.ns)

────────────────────
+ this - other ClockTime

ds + dns

.. ds Milliseconds = s - other.s
.. dns Milliseconds = ns - other.ns

────────────────────
+ elapsed'Unit

clock().diff'Unit(this)

────────────────────
+ diff'Unit
    - other ClockTime

ds + dns

.. ds = (s - other.s) as Unit
.. dns = (ns - other.ns) as Unit

━━━━━━━━━━━━━━━━━━━━
+ clock

ClockTime(ts.sec, ts.nsec)

.. ts = get-clock-time()

━━━━━━━━━━━━━━━━━━━━
+ get-clock-time CTimeSpec ?! Error @door(time)

?! Error("Unable to retrieve clock ($err)")
    if err != 0

time-spec

.. tsbuf = CTimeSpec[1]
.. err = C:clock_gettime(C:CLOCK_REALTIME, tsbuf)
.. time-spec = tsbuf[0]

━━━━━━━━━━━━━━━━━━━━
+ do measure'T
    - fn T

. c = clock()
. result = fn()
. d = clock() - c
-- "MEASURED $d"
= result
