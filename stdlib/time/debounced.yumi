./duration

━━━━━━━━━━━━━━━━━━━━
+ DebouncedAction is () Void

━━━━━━━━━━━━━━━━━━━━
+ do debounced DebouncedAction
    - delay Duration
    - action Doer

` A call while the action runs starts a new delay and does not cut the action short: the task
` lets go of `pending` once its delay ends.
. pending Task?
= => do
    pending?.cancel-later()
    pending = do new
        delay.wait()
        pending = null
        action()
            catch error Error
                unhandled-error(error)

━━━━━━━━━━━━━━━━━━━━
+ do throttled DebouncedAction
    - delay Duration
    - action Doer

. is-pending = false
. is-requested = false
= => do
    is-requested = true
    if !is-pending
        is-pending = true
        do new
            while is-requested
                delay.wait()
                is-requested = false
                action()
                    catch error Error
                        unhandled-error(error)
            is-pending = false
