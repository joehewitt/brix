
/YuCore/YuTime.h

` Represents time_t
+ CSeconds (csec) is Long
+ CNanoseconds (cnsec) is Long

━━━━━━━━━━━━━━━━━━━━
+ CTime is (sec I32, min I32, hour I32, mday I32, mon I32, year I32, wday I32, yday I32, isdst I32, gmtoff Long, zone CPointer'Char8)
` Represents "struct tm"

━━━━━━━━━━━━━━━━━━━━
+ CTimeSpec is (sec CSeconds, nsec CNanoseconds)
` Represents "struct timespec"

━━━━━━━━━━━━━━━━━━━━
+ get-utc-time

C:yumiGetUTCTime() as CSeconds

━━━━━━━━━━━━━━━━━━━━
+ get-time-zone-name

C:yumiGetTimeZone()

━━━━━━━━━━━━━━━━━━━━
+ get-time-zone-offset

C:yumiGetTimeZoneOffset()

━━━━━━━━━━━━━━━━━━━━
+ break-down-utc-time
    - secs CSeconds

tm

.. buf CTime
.. breakdown = C:yumiBreakDownUTCTime(secs, &buf) as CPointer'CTime
.. tm = breakdown[0]

━━━━━━━━━━━━━━━━━━━━
+ do make-time
    - second I32
    - minute I32
    - hour I32
    - day I32
    - month I32
    - year I32

. tm = CTime(second, minute, hour, day, month, year, 0, 0, -1)
. t = C:yumiMakeTime(&tm)
= t

