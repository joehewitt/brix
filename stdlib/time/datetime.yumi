
./ctime
./duration
./zone
/math
/units

+ midnight = 12am
+ noon = 12pm
+ january       = Month.january
+ february      = Month.february
+ march         = Month.march
+ april         = Month.april
+ may           = Month.may
+ june          = Month.june
+ july          = Month.july
+ august        = Month.august
+ september     = Month.september
+ october       = Month.october
+ november      = Month.november
+ december      = Month.december
+ february-leap  = Month.february-leap

+ AbsoluteTime is UInt

━━━━━━━━━━━━━━━━━━━━
+ DateTime is Tuple

+ since-epoch CSeconds
+ second Second
+ minute Minute
+ hour Hour
+ day DayOfMonth
+ month Month
+ year Year

 ` @readonly
+ day-of-week DayOfWeek

` @readonly
+ day-of-year DayOfYear
+ zone = local
+ is-daylight-savings Bool

────────────────────
+ This
    - zone = local

= This(zone.now, zone)

────────────────────
+ This
    - time Time
    - date = today

= This(date, time)

────────────────────
+ This
    - date Date
    - time = midnight

= This(time.second, time.minute, time.hour, date.day, date.month, date.year, time.zone)

────────────────────
+ This
    - second Second
    - minute Minute
    - hour Hour
    - day DayOfMonth
    - month Month
    - year Year
    - zone = local

= This(new-seconds, zone)

.. new-seconds = make-time(second as I32, minute as I32, hour as I32, d as I32, m as I32, y as I32)
.. d = day.number + 1
.. m = month.number
.. y = year - 1900

────────────────────
+ This
    - since-epoch CSeconds
    - zone = local

.. tm = break-down-utc-time(since-epoch)
.. second = tm.sec as Second
.. minute = tm.min as Minute
.. hour = tm.hour as Hour
.. day = month.day(tm.mday)
.. day-of-week = tm.wday as DayOfWeek
.. day-of-year = year.day(tm.yday)
.. month = year.month(tm.mon)
.. year = Year(tm.year + 1900)
.. is-daylight-savings = tm.isdst > 0

────────────────────
+ to TimeZone

zone

────────────────────
+ to CSeconds

since-epoch

────────────────────
+ to Second

second

────────────────────
+ to Minute

minute

────────────────────
+ to Hour

hour

────────────────────
+ to DayOfMonth

day

────────────────────
+ to DayOfWeek

day-of-week

────────────────────
+ to DayOfYear

day-of-year

────────────────────
+ to Month

month

────────────────────
+ to Year

year

────────────────────
+ to Date

date

────────────────────
+ to Time

time

────────────────────
+ to String

"$day $year $hour:$m"

.. m = minute.pad(2)

────────────────────
+ get readable String

"$short-month ${day.number + 1}, $year at ${clock.military-hour}:$m ${clock.ampm.uppercased}"

.. clock = time
.. m = minute.pad(2)
.. short-month = "${month.short-name[0 .. < 1].uppercased}${month.short-name[1 ...]}"

────────────────────
+ get time

Time(hour, minute, second, zone)

────────────────────
+ time = time Time

This(second, time.minute, time.hour, day, month, year, time.zone)

────────────────────
+ since-epoch = other

This((other as Seconds) + zone.offset, zone)

────────────────────
+ second = other

This(other, minute, hour, day, month, year)

────────────────────
+ minute = other

This(second, other, hour, day, month, year)

────────────────────
+ hour = other

This(second, minute, other, day, month, year)

────────────────────
+ date = date Date

This(second, minute, hour, date.day, date.month, date.year, zone)

────────────────────
+ day = other

This(second, minute, hour, other, month, year)

────────────────────
+ month = other

This(second, minute, hour, day, other, year)

────────────────────
+ year = other

This(second, minute, hour, day, month, other)

────────────────────
+ zone = other

This(csecs, other)
.. csecs = zone.convert(seconds, other)

────────────────────
+ this == other CSeconds

since-epoch == other

────────────────────
+ this < other CSeconds

since-epoch < other

────────────────────
+ this > other CSeconds

since-epoch > other

────────────────────
+ this - other DateTime

TimeDelta(this, other)

────────────────────
+ this - other CSeconds

DateTime(since-epoch - other, zone)

────────────────────
+ this + other CSeconds

DateTime(since-epoch + other, zone)

────────────────────
+ elapsed

zone.now - since-epoch

────────────────────
+ date

Date(day, year)

────────────────────
+ decade

(modf(year / 100.0)[1] * 10 as AbsoluteTime) * 10

────────────────────
+ century

modf(year / 100.0)[0] as AbsoluteTime

────────────────────
+ millenium

(year / 1000.0) as AbsoluteTime

