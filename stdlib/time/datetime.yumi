scale * this

━━━━━━━━━━━━━━━━━━━━
+ DayOfWeek is Tuple
    is Scalable'AbsoluteTime

| sunday        = ("sunday", "sun")
| monday        = ("monday", "mon")
| tuesday       = ("tuesday", "tue")
| wednesday     = ("wednesday", "wed")
| thursday      = ("thursday", "thu")
| friday        = ("friday", "fri")
| saturday      = ("saturday", "sat")

+ name = ""
+ short-name = ""
+ scale => Scale(0, 6)

────────────────────
+ to String

name

────────────────────
+ to AbsoluteTime

number

────────────────────
+ to Abbreviation

short-name

━━━━━━━━━━━━━━━━━━━━
