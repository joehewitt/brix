"$number"

────────────────────
+ to AbsoluteTime

number

━━━━━━━━━━━━━━━━━━━━
+ Month is Tuple
    is Scalable'AbsoluteTime

| january       = (0, "january", "jan", 31)
| february      = (1, "february", "feb", 28)
| march         = (2, "march", "mar", 31)
| april         = (3, "april", "apr", 30)
| may           = (4, "may", "may", 31)
| june          = (5, "june", "jun", 30)
| july          = (6, "july", "jul", 31)
| august        = (7, "august", "aug", 31)
| september     = (8, "september", "sep", 30)
| october       = (9, "october", "oct", 31)
| november      = (10, "november", "nov", 30)
| december      = (11, "december", "dec", 31)
| february-leap  = (1, "february", "feb", 29)

+ number Int
+ name String
+ short-name String
+ days AbsoluteTime
+ day-scale => Scale(0, days-1)
+ scale => Scale(0, 11)

────────────────────
+ This
    - number AbsoluteTime

= now.year.month(number)

────────────────────
+ to String

name

────────────────────
+ to AbsoluteTime

number

────────────────────
+ to Abbreviation

short-name

────────────────────
+ to Days

days

────────────────────
+ day
    - number Int

?! OutOfBoundsError("$this ranges from 0 to $days")
    if n < 0 || n > days - 1

DayOfMonth(n as AbsoluteTime, this)

.. n = number - 1

────────────────────
+ this
    - number Int
    - year Year

day(number).year(year)

────────────────────
+ this
    - number Int

day(number)

━━━━━━━━━━━━━━━━━━━━
+ Year is AbsoluteTime

+ is-leap-year => (this /and/ 3) == 0 && ((this % 25) != 0 || (this /and/ 15) == 0)
+ days => if is-leap-year then 366days else 365days
+ day-scale => Scale(0, days - 1)

────────────────────
+ to Days

days

────────────────────
+ day
    - number Int

?! OutOfBoundsError("$this ranges from 0 to ${days - 1}")
    if number < 0 || (number as Days) > days

DayOfYear(number as AbsoluteTime, this)

────────────────────
+ month
    - number Int

?! OutOfBoundsError("Months range from 0 to 11")
     if number < 0 || number > 11

|? number == 1 && is-leap-year
    february-leap
??
    number as Month

━━━━━━━━━━━━━━━━━━━━
+ Date is Tuple

+ day DayOfMonth
+ year Year
+ month => day.month

────────────────────
+ to DateTime

DateTime(this)

────────────────────
+ to DayOfWeek

DateTime(this).day-of-week

────────────────────
+ to DayOfMonth

day

────────────────────
+ to DayOfYear

DateTime(this).day-of-year

────────────────────
+ to Month

day.month

────────────────────
+ to Year

year

────────────────────
+ to String

"$day.month $d $year"

.. d = day.number + 1

────────────────────
+ month = other Month

This(other.day(day), year)

────────────────────
+ this + time Time

DateTime(this, time)

━━━━━━━━━━━━━━━━━━━━
+ Time is Tuple

+ hour Hour
+ minute Minute = 0
+ second Second = 0
+ zone TimeZone = local
+ military-time = false

────────────────────
+ This
    - t F64
    - zone TimeZone = local

= This(t, false, zone)

────────────────────
+ This
    - t F64
    - pm Bool
    - zone TimeZone = local

= This(h, m, 0, zone, true)

.. hm = modf(t)
.. hour24 = hm[0] as Hour
.. minute60 = hm[1]
.. h =
    |? hour24 == 12 && !pm
        0
    |? hour24 != 12 && pm
        12 + hour24
    ??
        hour24
.. m = Scale(0, 0.59) * minute60

────────────────────
+ to Hour

hour

────────────────────
+ to Minute

minute

────────────────────
+ to DateTime

DateTime(this)

────────────────────
+ to String

|? military-time
    "$military-hour:$min$ampm"
??
    "$hour:$min:$sec"

.. min = minute.pad(2)
.. sec = second.pad(2)

────────────────────
+ get military-hour

|? hour == 0
    12
|? hour > 12
    hour - 12
??
    hour

────────────────────
+ get ampm

|? hour < 12
    "am"
??
    "pm"

────────────────────
+ this + date Date

DateTime(date, this)

━━━━━━━━━━━━━━━━━━━━
+ AM (am) is F32

────────────────────
+ This
    - t

= Time(t, false)

━━━━━━━━━━━━━━━━━━━━
+ PM (pm) is F32

────────────────────
+ This
    - t

= Time(t, true)

━━━━━━━━━━━━━━━━━━━━
+ TimeDelta is (later DateTime, earlier DateTime)

+ delta = later.since-epoch - earlier.since-epoch

────────────────────
+ to String

delta

────────────────────
+ to ''OtherDuration
    - OtherDuration is Duration

delta

────────────────────
+ to CSeconds

delta

────────────────────
+ to Iterable''OtherDuration
    - OtherDuration is Duration

range(OtherDuration(1))

────────────────────
+ range
    - interval Duration
    - Duration is! Duration

start .. end by interval

.. start = earlier.since-epoch
.. end = later.since-epoch

━━━━━━━━━━━━━━━━━━━━

+ 1hour = 1hours
+ 1minute = 1minutes
+ 1second = 1seconds
