/os/file
/os/process
/test
/time
/time/fake-clock
/time/timer

_ start = 1767225600

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Fake Clock Reads")
cases.run(read-tests)
cases = cases.then("Fake Clock Waits", wait-tests)
cases = cases.then("Fake Clock Order", order-tests)
cases = cases.then("Fake Clock Loops", loop-tests)
cases = cases.then("Fake Clock Timers", timer-tests)
cases = cases.then("Fake Clock Freeze", freeze-tests)
cases = cases.then("Fake Clock Handle Waits", handle-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do read-tests TestCase
    - t TestCase

. fake = FakeClock()
do with time = fake
    t.expect("the wall clock starts at the fake's start", start, clock().s)
    t.expect("a date reads the fake's time", "2026-01-01T00:00:00+00:00", DateTime() as ISO8601)
    t.expect("the local zone is the fake's", "UTC", local.name)
    . began = monotonic-time-nanoseconds()
    fake.advance(90s)
    t.expect("advancing moves the wall clock", start + 90, clock().s)
    . moved = monotonic-time-nanoseconds() - began
    t.expect("advancing moves the monotonic clock", 90000000000u, moved)
= t

━━━━━━━━━━━━━━━━━━━━
+ do wait-tests TestCase
    - t TestCase

. fake = FakeClock()
. heard [String]
do with time = fake
    . reminder = do new
        5minutes.wait()
        heard += "ring"
    fake.advance(4minutes)
    t.expect("a wait does not end before its time", 0, heard.length)
    fake.advance(60s)
    t.expect("a wait ends when fake time reaches it", ["ring"], heard)
    reminder.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do order-tests TestCase
    - t TestCase

. fake = FakeClock()
. heard [String]
do with time = fake
    . third = do new
        3s.wait()
        heard += "third at ${clock().s - start}"
    . first = do new
        1s.wait()
        heard += "first at ${clock().s - start}"
    . second = do new
        2s.wait()
        heard += "second at ${clock().s - start}"
    fake.advance(5s)
    . expected = ["first at 1", "second at 2", "third at 3"]
    t.expect("waits end in deadline order, each at its deadline", expected, heard)
    t.expect("the clock ends at the time advanced to", start + 5, clock().s)
    third.close()
    first.close()
    second.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do loop-tests TestCase
    - t TestCase

. fake = FakeClock()
. ticks = 0
do with time = fake
    . loop = 100ms.loop(=> do ticks += 1)
    fake.advance(1s)
    t.expect("a timer loop ticks once for each interval passed", 10, ticks)
    fake.advance(50ms)
    t.expect("a loop does not tick between intervals", 10, ticks)
    loop.cancel()
    fake.advance(1s)
    t.expect("cancelling a loop ends its wait", 10, ticks)
= t

━━━━━━━━━━━━━━━━━━━━
+ do timer-tests TestCase
    - t TestCase

. fake = FakeClock()
. ticks [Milliseconds]
. counter Subscriber'Milliseconds = :: elapsed, source => do ticks += elapsed
do with time = fake
    . timer = Timer(100ms)
    timer.subscribe(counter)
    fake.advance(1s)
    t.expect("a timer's subscribers hear each tick advancing passes", 10, ticks.length)
    t.expect("each tick gives the time since the timer began", 1000ms, ticks[9])
    timer.unsubscribe(counter)
    fake.advance(1s)
    t.expect("a timer with no subscriber stops", 10, ticks.length)
= t

━━━━━━━━━━━━━━━━━━━━
+ do freeze-tests TestCase
    - t TestCase

. fake = FakeClock()
. heard [String]
do with time = fake
    . waiting = do new
        1s.wait()
        heard += "woke"
    2s.freeze()
    t.expect("freezing moves fake time on", start + 2, clock().s)
    t.expect("freezing ends the waits it passes", ["woke"], heard)
    waiting.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do handle-tests TestCase
    - t TestCase

. fake = FakeClock()
. heard [String]
. idle = process-pipe()
. busy = process-pipe()
do with time = fake
    . timing-out = do new
        . waited = catch wait-until-readable(idle.reader.fd, Deadline(1s))
        heard += if waited is TimeoutError then "timed out" else "ready"
    fake.advance(999ms)
    t.expect("a handle wait goes on before its deadline", 0, heard.length)
    fake.advance(1ms)
    t.expect("a handle wait times out at its deadline in fake time", ["timed out"], heard)
    timing-out.close()

    . readable = do new
        . waited = catch wait-until-readable(busy.reader.fd, Deadline(1s))
        heard += if waited is TimeoutError then "timed out" else "ready"
    fake.advance(0s)
    busy.writer.write("x")
    readable.wait()
    t.expect("a handle that becomes ready ends the wait", ["timed out", "ready"], heard)
    t.expect("a wait that ends on its handle leaves fake time alone", start + 1, clock().s)
= t
