(import /test)
(import /time/datetime)
(import /time/duration)
(import /time/timestamp)
(import /time/zone)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Time Shorthand"))
  (tuple "2:05am" 2.05am)
  (tuple "2:30pm" 2.30pm)
  (tuple "12:00pm" noon)
  (tuple "12:00am" midnight)
  (header (call test "Full Dates"))
  (tuple "december 31 2016 15:30" (+ (call (. (call (. december day) 31) year) 2016) 3.30pm))
  (tuple "january 1 2017 15:30" (+ (call (. (call (. january day) 1) year) 2017) 3.30pm))
  (header (call test "Month Lengths"))
  (== (. (call (. (call Year 2015) month) 1) days) 28)
  (== (. (call (. (call Year 2016) month) 1) days) 29)
  (header (call test "Leap Years"))
  (tuple "february 29 2016 15:30" (+ (call (. (call (. (call (. (call Year 2016) month) 1) day) 29) year) 2016) 3.30pm))
  (tuple "2016-02-29T12:00:00+00:00" (as (call DateTime 1456747200 utc) ISO8601))
  (header (call test "Calendar Months"))
  (tuple "february 29 2024" (+ (call (. (call (. january day) 31) year) 2024) 1months))
  (tuple "february 28 2023" (+ (call (. (call (. january day) 31) year) 2023) 1months))
  (tuple "february 28 2025" (+ (call (. (call (. (call (. (call Year 2024) month) 1) day) 29) year) 2024) 1years))
  (tuple "february 15 2024" (+ (call (. (call (. november day) 15) year) 2023) 3months))
  (tuple "february 29 2024" (- (call (. (call (. march day) 31) year) 2024) 1months))
  (tuple "2016-03-29T12:00:00+00:00" (as (+ (call DateTime 1456747200 utc) 1months) ISO8601))
  (tuple "2015-01-29T12:00:00+00:00" (as (- (call DateTime 1456747200 utc) 13months) ISO8601))
  (tuple "2016-02-29T12:01:00+00:00" (as (+ (call DateTime 1456747200 utc) 60) ISO8601))
  (tuple "2016-02-29T11:59:00+00:00" (as (- (call DateTime 1456747200 utc) 60) ISO8601))
)
