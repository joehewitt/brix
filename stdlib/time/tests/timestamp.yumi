/test
/time/datetime
/time/timestamp
/time/zone

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Timestamp Zone Offsets")
cases.run(zone-offset-tests)
cases = cases.then("Timestamp Local Zone", local-zone-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do zone-offset-tests TestCase
    - t TestCase

t.expect("UTC has a zero offset", "2015-09-16T01:00:00+00:00", iso(0))
t.expect("minutes east are kept", "2015-09-16T01:00:00+05:45", iso(20700))
t.expect("minutes west are kept", "2015-09-16T01:00:00-03:30", iso(-12600))
t.expect("RFC 2822 offsets have no colon", "Wed, 16 Sep 2015 01:00:00 +0545", rfc(20700))
= t

━━━━━━━━━━━━━━━━━━━━
+ do local-zone-tests TestCase
    - t TestCase

. summer String = wall-clock(5) as ISO8601
t.expect("a summer date keeps its wall clock", "2020-06-16T14:30:00", summer[0 .. < 19])
. winter String = wall-clock(11) as ISO8601
t.expect("a winter date keeps its wall clock", "2020-12-16T14:30:00", winter[0 .. < 19])
= t

━━━━━━━━━━━━━━━━━━━━
_ wall-clock
    - month Int

Year(2020).month(month).day(16).year(2020) + 2.30pm

━━━━━━━━━━━━━━━━━━━━
_ iso
    - offset Int

DateTime(1442365200, TimeZone("Test", offset)) as ISO8601

━━━━━━━━━━━━━━━━━━━━
_ rfc
    - offset Int

DateTime(1442365200, TimeZone("Test", offset)) as RFC2822
