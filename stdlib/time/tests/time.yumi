+ tests TestRender

════════════════════
test("Time Shorthand")

"2:05am",       2.05am
"2:30pm",       2.30pm
"12:00pm",      noon
"12:00am",      midnight

════════════════════
test("Full Dates")

"december 31 2016 15:30",   december.day(31).year(2016) + 3.30pm
"january 1 2017 15:30",     january.day(1).year(2017) + 3.30pm

════════════════════
test("Month Lengths")

Year(2015).month(1).days == 28
Year(2016).month(1).days == 29

════════════════════
test("Leap Years")

"february 29 2016 15:30",       Year(2016).month(1).day(29).year(2016) + 3.30pm
"2016-02-29T12:00:00+00:00",    DateTime(1456747200, utc) as ISO8601
