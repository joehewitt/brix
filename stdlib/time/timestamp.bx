(import ./_ctime)
(import ./datetime)
(import ./zone)
(import /math)
(blank)
(type-line + Timestamp (is String))
(type-line + RFC2822 (is Timestamp))
(type-line + ISO8601 (is Timestamp))
(type-line + RFC3339 (is ISO8601))

(extend + DateTime
  (fn-to-expr + RFC2822
    (str weekday ", " day-text " " month-text " " year-text " " clock " " offset)
    (where
      (lazy weekday (call rfc2822-weekday day-of-week))
      (lazy day-number (+ (. this day number) 1))
      (lazy day-text (call (. day-number pad) 2))
      (lazy month-abbreviation (as month Abbreviation))
      (lazy month-text (str (. ([] month-abbreviation 0) uppercase) ([] month-abbreviation (... 1))))
      (lazy year-text (call (. year pad) 4))
      (lazy clock (call timestamp-clock this))
      (lazy offset (call timezone-offset-rfc2822 zone))
    )
  )
  (fn-to-expr + ISO8601
    (str year-text "-" month-text "-" day-text "T" clock offset)
    (where
      (lazy year-text (call (. year pad) 4))
      (lazy month-number (+ (. month number) 1))
      (lazy month-text (call (. month-number pad) 2))
      (lazy day-number (+ (. this day number) 1))
      (lazy day-text (call (. day-number pad) 2))
      (lazy clock (call timestamp-clock this))
      (lazy offset (call timezone-offset-iso8601 zone))
    )
  )
  (fn-to-expr + RFC3339
    (as this ISO8601)
  )
)

(fn-expr + parse-iso8601 (? DateTime)
  (param text String)
  (param zone _ (= local))
  (case? (< (. text length) 19)
    null
  )
  (case? (or (!= ([] text (..< 4 5)) "-") (!= ([] text (..< 7 8)) "-") (!= ([] text (..< 10 11)) "T"))
    null
  )
  (case? (or (!= ([] text (..< 13 14)) ":") (!= ([] text (..< 16 17)) ":"))
    null
  )
  (case? (or (< year 1) (< month 1) (> month 12) (< day 1) (> day 31))
    null
  )
  (case? (or (> hour 23) (> minute 59) (> second 60))
    null
  )
  (case? (== offset null)
    null
  )
  (default
    (call DateTime (+ utc (as (. zone offset) I64)) zone)
  )
  (where
    (lazy year (as ([] text (..< 0 4)) I64))
    (lazy month (as ([] text (..< 5 7)) I64))
    (lazy day (as ([] text (..< 8 10)) I64))
    (lazy hour (as ([] text (..< 11 13)) I64))
    (lazy minute (as ([] text (..< 14 16)) I64))
    (lazy second (as ([] text (..< 17 19)) I64))
    (lazy offset (call iso8601-offset ([] text (... 19)) zone))
    (lazy utc (- (+ (* (call civil-days year month day) 86400) (* hour 3600) (* minute 60) second) offset))
  )
)

(fn-do _ iso8601-offset (? I64)
  (param rest String)
  (param zone TimeZone)
  (let index Index 0)
  (if (call (. rest starts-with) ".")
    (= index 1)
    (while (and (< index (. rest length)) (!= (call (. "0123456789" find) ([] rest (..< index (+ index 1)))) null))
      (+= index 1)
    )
  )
  (let designator ([] rest (... index)))
  (return-if (as (. zone offset) I64) (if (== (. designator length) 0)))
  (return-if 0 (if (== designator "Z")))
  (blank)
  (let sign I64 (if-expr (== ([] designator (..< 0 1)) "-") -1 1))
  (return-if null (if (and (> sign 0) (!= ([] designator (..< 0 1)) "+"))))
  (return-if null (if (< (. designator length) 3)))
  (blank)
  (let hours (as ([] designator (..< 1 3)) I64))
  (return-if (* sign hours 3600) (if (== (. designator length) 3)))
  (blank)
  (let minutes-at (if-expr (and (== (. designator length) 6) (== ([] designator (..< 3 4)) ":")) 4 3))
  (return-if null (if (!= (. designator length) (+ minutes-at 2))))
  (return (* sign (+ (* hours 3600) (* (as ([] designator (..< minutes-at (+ minutes-at 2))) I64) 60))))
)

(fn-expr _ civil-days I64
  (param year I64)
  (param month I64)
  (param day I64)
  (- (+ (- (+ (* era 146097) (* year-of-era 365) (/ year-of-era 4)) (/ year-of-era 100)) day-of-year) 719468)
  (where
    (lazy shifted (if-expr (<= month 2) (- year 1) year))
    (lazy era (/ shifted 400))
    (lazy year-of-era (- shifted (* era 400)))
    (lazy day-of-year (- (+ (/ (+ (* 153 (if-expr (> month 2) (- month 3) (+ month 9))) 2) 5) day) 1))
  )
)

(fn-expr _ rfc2822-weekday _
  (param day DayOfWeek)
  (match day
    (case= (. DayOfWeek sunday)
      "Sun"
    )
    (case= (. DayOfWeek monday)
      "Mon"
    )
    (case= (. DayOfWeek tuesday)
      "Tue"
    )
    (case= (. DayOfWeek wednesday)
      "Wed"
    )
    (case= (. DayOfWeek thursday)
      "Thu"
    )
    (case= (. DayOfWeek friday)
      "Fri"
    )
    (case= (. DayOfWeek saturday)
      "Sat"
    )
    (throw (call Panic "Unknown day of week"))
  )
)

(fn-expr _ timestamp-clock _
  (param time DateTime)
  (str hour ":" minute ":" second)
  (where
    (lazy hour (call (. time hour pad) 2))
    (lazy minute (call (. time minute pad) 2))
    (lazy second (call (. time second pad) 2))
  )
)

(fn-expr _ timezone-offset-rfc2822 _
  (param time-zone TimeZone)
  (str sign hour minute)
  (where
    (lazy sign (if-expr (< (. time-zone offset) 0) "-" "+"))
    (lazy absolute (call abs (. time-zone offset)))
    (lazy hour-value (/ absolute 3600))
    (lazy minute-value (% (/ absolute 60) 60))
    (lazy hour (call (. hour-value pad) 2))
    (lazy minute (call (. minute-value pad) 2))
  )
)

(fn-expr _ timezone-offset-iso8601 _
  (param time-zone TimeZone)
  (str sign hour ":" minute)
  (where
    (lazy sign (if-expr (< (. time-zone offset) 0) "-" "+"))
    (lazy absolute (call abs (. time-zone offset)))
    (lazy hour-value (/ absolute 3600))
    (lazy minute-value (% (/ absolute 60) 60))
    (lazy hour (call (. hour-value pad) 2))
    (lazy minute (call (. minute-value pad) 2))
  )
)
