• DialogButton
    background-color = AnsiColor(12)

    when #is-focused
        color = AnsiColor(0)
        background-color = AnsiColor(14)
    when #is-hovered
        color = AnsiColor(255)
        background-color = AnsiColor(7)
    when #is-pressed
        color = AnsiColor(255)
        background-color = AnsiColor(12)
    when !#is-effectively-enabled
        color = AnsiColor(8)
        background-color = AnsiColor(0)

