• This
    focus-mode = FocusMode.inside

+ title = "Dialog"
+ event accepted DialogAcceptEvent
+ event canceled DialogCancelEvent
+ event dismissed DialogDismissEvent
+ is-modal-root => true

────────────────────

<This • absolute cover:.screen
    <ModalBackdrop

    <DialogPanel • dialog-panel absolute center:.parent
        title = #title

        + <Box body • dialog-body flex:1 flex-col
            <Box

        + <Box actions • dialog-actions flex-row
            <Box

    <Shortcut "Cancel"
        key = .escape
        action = => do cancel()

    <Shortcut "Accept"
        key = .enter
        when = => !has-focused-button()
        action = => do accept()

────────────────────
