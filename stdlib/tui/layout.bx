(import ./box)
(import ./primitives)
(import /core/intrinsics)
(import /math)
(blank)
(prop + flex-col _ (= (call FlexLayout (. Orientation vertical))))
(prop + flex-row _ (= (call FlexLayout (. Orientation horizontal))))
(prop + flow-col _ (= (call FlowLayout (. Orientation vertical))))
(prop + flow-row _ (= (call FlowLayout (. Orientation horizontal))))
(prop + masonry-col _ (= (call MasonryLayout (. Orientation vertical))))
(prop + masonry-row _ (= (call MasonryLayout (. Orientation horizontal))))
(blank)
(prop _ flex-scratch (list Flex))
(prop _ masonry-scratch-stack (list MasonryScratch))

(type + LayoutArrangeHint (is U8)
  (variant full (= 0))
  (variant children-only (= 1))
)

(type + Layout
  (fn-do + arrange-box _
    (param box Box)
    (param hint LayoutArrangeHint (= (. LayoutArrangeHint full)))
  )
  (fn-expr + measure-content _
    (param box Box)
    (param query MeasureQuery)
    (call PSize 0 0)
  )
)

(type + FlexLayout (is Layout)
  (prop + orient Orientation)
  (fn-do + This _
    (param orient _)
  )
  (fn-do + arrange-box _
    (param box Box)
    (param hint LayoutArrangeHint (= (. LayoutArrangeHint full)))
    (probe-count tui.layout.builtin.arrange-fast)
    (call arrange-flex-content box)
  )
  (fn-expr + measure-content _
    (param box Box)
    (param query MeasureQuery)
    (call layout-natural-size box orient)
  )
  (fn-do _ arrange-flex-content _
    (param box Box)
    (let total-flex Float)
    (let content (. box content-bounds))
    (let total-size (if-expr (== orient (. Orientation horizontal)) (. content width) (. content height)))
    (let last-flex-child (? Box) null)
    (blank)
    (call (. flex-scratch clear))
    (let child (. box first-active-child))
    (while child
      (let live child)
      (probe-count tui.layout.arrange.children-considered)
      (let child-flex (. live $flex))
      (+= flex-scratch child-flex)
      (+= total-flex child-flex)
      (if (!= child-flex 0)
        (= last-flex-child live)
      )
      (if (== child-flex 0)
        (-= total-size
          (block
            (case? (== orient (. Orientation horizontal))
              (. live measured-outer-size width)
            )
            (default
              (. live measured-outer-size height)
            )
          )
        )
      )
      (= child (. live next-active-sibling))
    )
    (blank)
    (= total-size (call max 0 total-size))
    (blank)
    (let offset Coord 0)
    (let child-size Coord 0)
    (let cross-size Coord 0)
    (let scan Index 0)
    (= child (. box first-active-child))
    (while child
      (let live child)
      (let next-child (. live next-active-sibling))
      (let child-flex ([] flex-scratch scan))
      (+= scan 1)
      (probe-count tui.layout.arrange.children-arranged)
      (if (== child-flex 0)
        (if (== orient (. Orientation horizontal))
          (let size (. live measured-outer-size width))
          (call (. live arrange-outer-bounds) (call Rect (+ (. content x) offset) (. content y) size (. content height)))
          (+= offset size)
          (else
            (let size (. live measured-outer-size height))
            (call (. live arrange-outer-bounds) (call Rect (. content x) (+ (. content y) offset) (. content width) size))
            (+= offset size)
          )
        )
        (else
          (let ratio (/ child-flex total-flex))
          (let is-last-flex (and last-flex-child (== live last-flex-child)))
          (let size
            (scope (if-expr is-last-flex remaining (as (call round (* ratio total-size)) Coord))
              (lazy remaining (- total-size child-size))
            )
          )
          (+= child-size size)
          (blank)
          (if (== orient (. Orientation horizontal))
            (call (. live arrange-outer-bounds) (call Rect (+ (. content x) offset) (. content y) size (. content height)))
            (else
              (call (. live arrange-outer-bounds) (call Rect (. content x) (+ (. content y) offset) (. content width) size))
            )
          )
          (+= offset size)
        )
      )
      (if (== orient (. Orientation horizontal))
        (= cross-size (call max cross-size (. content height)))
        (else
          (= cross-size (call max cross-size (. content width)))
        )
      )
      (= child next-child)
    )
    (blank)
    (if (== orient (. Orientation horizontal))
      (= (. box inner-width) offset)
      (= (. box inner-height) cross-size)
      (else
        (= (. box inner-width) cross-size)
        (= (. box inner-height) offset)
      )
    )
  )
)

(type + FlowLayout (is Layout)
  (prop + orient Orientation)
  (fn-do + This _
    (param orient _)
  )
  (fn-do + arrange-box _
    (param box Box)
    (param hint LayoutArrangeHint (= (. LayoutArrangeHint full)))
    (probe-count tui.layout.builtin.arrange-fast)
    (if (== hint (. LayoutArrangeHint children-only))
      (return-if (if (call arrange-flow-content-incremental box)))
    )
    (call arrange-flow-content box)
  )
  (fn-expr + measure-content _
    (param box Box)
    (param query MeasureQuery)
    (call layout-natural-size box orient)
  )
  (fn-do _ arrange-flow-content _
    (param box Box)
    (let offset Coord 0)
    (let cross-size Coord 0)
    (let content (. box content-bounds))
    (let child (. box first-active-child))
    (while child
      (let live child)
      (let next-child (. live next-active-sibling))
      (probe-count tui.layout.arrange.children-considered)
      (probe-count tui.layout.arrange.children-arranged)
      (let intrinsic (. live measured-outer-size))
      (if (== orient (. Orientation horizontal))
        (let size (. intrinsic width))
        (call (. live arrange-outer-bounds) (call Rect (+ (. content x) offset) (. content y) size (. intrinsic height)))
        (+= offset size)
        (= cross-size (call max cross-size (. intrinsic height)))
        (else
          (let size (. intrinsic height))
          (call (. live arrange-outer-bounds) (call Rect (. content x) (+ (. content y) offset) (. content width) size))
          (+= offset size)
          (= cross-size (call max cross-size (. intrinsic width)))
        )
      )
      (= child next-child)
    )
    (blank)
    (if (== orient (. Orientation horizontal))
      (= (. box inner-width) offset)
      (= (. box inner-height) cross-size)
      (else
        (= (. box inner-width) cross-size)
        (= (. box inner-height) offset)
      )
    )
  )
  (fn-do _ arrange-flow-content-incremental Bool
    (param box Box)
    (let query (call measure-fit-query))
    (let first-dirty (? Box))
    (let last-dirty (? Box))
    (let before-first (? Box))
    (let previous (? Box))
    (let has-history true)
    (let child (. box first-active-child))
    (while child
      (let live child)
      (probe-count tui.layout.arrange.children-considered)
      (if (not (call (. live last-measure-result) query))
        (= has-history false)
      )
      (if (. live $is-layout-invalid)
        (if (not first-dirty)
          (= first-dirty live)
          (= before-first previous)
        )
        (= last-dirty live)
      )
      (= previous live)
      (= child (. live next-active-sibling))
    )
    (blank)
    (if (not first-dirty)
      (probe-count tui.layout.arrange.fallback.no-candidate)
      (return false)
    )
    (if (not has-history)
      (probe-count tui.layout.arrange.fallback.no-child-history)
      (return false)
    )
    (blank)
    (let content (. box content-bounds))
    (let offset Coord 0)
    (if before-first
      (let previous-bounds (. before-first outer-bounds))
      (= offset
        (block
          (case? (== orient (. Orientation horizontal))
            (- (. previous-bounds right) (. content x))
          )
          (default
            (- (. previous-bounds bottom) (. content y))
          )
        )
      )
    )
    (blank)
    (let retained-cross (if-expr (== orient (. Orientation horizontal)) (. box inner-height) (. box inner-width)))
    (let cross-size retained-cross)
    (let recompute-cross false)
    (let passed-dirty-range false)
    (let suffix-length Size 0)
    (= child first-dirty)
    (blank)
    (while child
      (let live child)
      (let next-child (. live next-active-sibling))
      (probe-count tui.layout.arrange.children-considered)
      (probe-count tui.layout.arrange.children-arranged)
      (let previous-bounds (. live outer-bounds))
      (let previous-measure (. (!! (call (. live last-measure-result) query)) outer-size))
      (let intrinsic (. live measured-outer-size))
      (let rect
        (block
          (case? (== orient (. Orientation horizontal))
            (call Rect (+ (. content x) offset) (. content y) (. intrinsic width) (. intrinsic height))
          )
          (default
            (call Rect (. content x) (+ (. content y) offset) (. content width) (. intrinsic height))
          )
        )
      )
      (call (. live arrange-outer-bounds) rect)
      (+= suffix-length 1)
      (blank)
      (if (== orient (. Orientation horizontal))
        (+= offset (. intrinsic width))
        (= cross-size (call max cross-size (. intrinsic height)))
        (if (and (== (. previous-measure height) retained-cross) (< (. intrinsic height) (. previous-measure height)))
          (= recompute-cross true)
        )
        (else
          (+= offset (. intrinsic height))
          (= cross-size (call max cross-size (. intrinsic width)))
          (if (and (== (. previous-measure width) retained-cross) (< (. intrinsic width) (. previous-measure width)))
            (= recompute-cross true)
          )
        )
      )
      (blank)
      (if (== live (!! last-dirty))
        (= passed-dirty-range true)
      )
      (if (and passed-dirty-range (== rect previous-bounds))
        (if recompute-cross
          (= cross-size (call flow-current-cross-size box query))
        )
        (if (== orient (. Orientation horizontal))
          (= (. box inner-height) cross-size)
          (else
            (= (. box inner-width) cross-size)
          )
        )
        (probe-count tui.layout.arrange.early-outs)
        (probe-count tui.layout.arrange.changed-suffix-length suffix-length)
        (return true)
      )
      (blank)
      (= child next-child)
    )
    (blank)
    (if recompute-cross
      (= cross-size (call flow-current-cross-size box query))
    )
    (if (== orient (. Orientation horizontal))
      (= (. box inner-width) offset)
      (= (. box inner-height) cross-size)
      (else
        (= (. box inner-width) cross-size)
        (= (. box inner-height) offset)
      )
    )
    (blank)
    (probe-count tui.layout.arrange.early-outs)
    (probe-count tui.layout.arrange.changed-suffix-length suffix-length)
    (return true)
  )
  (fn-do _ flow-current-cross-size Coord
    (param box Box)
    (param query MeasureQuery)
    ; Horizontal Flow preserves intrinsic child heights in bounds. Vertical Flow stretches child
    ; bounds to the container width, so the latest generic measure-cache result is the only derivable
    ; intrinsic cross extent. This scan reads those existing results and never arranges a child.
    (blank)
    (let cross-size Coord 0)
    (let child (. box first-active-child))
    (while child
      (let live child)
      (probe-count tui.layout.arrange.children-considered)
      (let intrinsic (. (!! (call (. live last-measure-result) query)) outer-size))
      (if (== orient (. Orientation horizontal))
        (= cross-size (call max cross-size (. intrinsic height)))
        (else
          (= cross-size (call max cross-size (. intrinsic width)))
        )
      )
      (= child (. live next-active-sibling))
    )
    (return cross-size)
  )
)

(type + MasonryLayout (is Layout)
  (prop + orient Orientation)
  (fn-do + This _
    (param orient _)
  )
  (fn-do + arrange-box _
    (param box Box)
    (param hint LayoutArrangeHint (= (. LayoutArrangeHint full)))
    (probe-count tui.layout.builtin.arrange-fast)
    (call arrange-masonry-content box)
  )
  (fn-expr + measure-content _
    (param box Box)
    (param query MeasureQuery)
    (call measure-masonry-content box query)
  )
  (fn-do _ arrange-masonry-content _
    (param box Box)
    (let content (. box content-bounds))
    (let cross-available (if-expr (== orient (. Orientation vertical)) (. content width) (. content height)))
    (let scratch (call acquire-scratch))
    (call prepare-tracks box cross-available scratch)
    (blank)
    (let child (. box first-active-child))
    (while child
      (let live child)
      (probe-count tui.layout.arrange.children-considered)
      (probe-count tui.layout.arrange.children-arranged)
      (let track (call shortest-track scratch))
      (let track-size ([] (. scratch track-sizes) track))
      (let track-offset ([] (. scratch track-offsets) track))
      (let primary-offset ([] (. scratch track-lengths) track))
      (let measure (call (. live measure) (call child-query track-size)))
      (let primary-size
        (scope (if-expr (== orient (. Orientation vertical)) (. measure outer-size height) width)
          (lazy width (. measure outer-size width))
        )
      )
      (if (== orient (. Orientation vertical))
        (call (. live arrange-outer-bounds)
          (block
            (arg (call Rect (+ (. content x) track-offset) (+ (. content y) primary-offset) track-size primary-size))
          )
        )
        (else
          (call (. live arrange-outer-bounds)
            (block
              (arg (call Rect (+ (. content x) primary-offset) (+ (. content y) track-offset) primary-size track-size))
            )
          )
        )
      )
      (= ([] (. scratch track-lengths) track) (+ primary-offset primary-size (call primary-gap box)))
      (= child (. live next-active-sibling))
    )
    (blank)
    (let primary-size (call max-primary-size scratch (call primary-gap box)))
    (let cross-size (call track-span scratch))
    (if (== orient (. Orientation vertical))
      (= (. box inner-width) cross-size)
      (= (. box inner-height) primary-size)
      (else
        (= (. box inner-width) primary-size)
        (= (. box inner-height) cross-size)
      )
    )
    (blank)
    (call release-scratch scratch)
  )
  (fn-do _ measure-masonry-content _
    (param box Box)
    (param query MeasureQuery)
    (let cross-available (call query-cross-size box query))
    (let scratch (call acquire-scratch))
    (call prepare-tracks box cross-available scratch)
    (blank)
    (let child (. box first-active-child))
    (while child
      (let live child)
      (let track (call shortest-track scratch))
      (let track-size ([] (. scratch track-sizes) track))
      (let measure (call (. live measure) (call child-query track-size)))
      (let primary-size
        (scope (if-expr (== orient (. Orientation vertical)) (. measure outer-size height) width)
          (lazy width (. measure outer-size width))
        )
      )
      (= ([] (. scratch track-lengths) track) (+ ([] (. scratch track-lengths) track) primary-size (call primary-gap box)))
      (= child (. live next-active-sibling))
    )
    (blank)
    (let primary-size (call max-primary-size scratch (call primary-gap box)))
    (let cross-size (call track-span scratch))
    (call release-scratch scratch)
    (blank)
    (let size
      (block
        (case? (== orient (. Orientation vertical))
          (call PSize cross-size primary-size)
        )
        (default
          (call PSize primary-size cross-size)
        )
      )
    )
    (return size)
  )
  (fn-expr _ acquire-scratch _
    (case? (> (. masonry-scratch-stack length) 0)
      (call (. masonry-scratch-stack pop))
    )
    (default
      (call MasonryScratch)
    )
  )
  (fn-do _ release-scratch _
    (param scratch MasonryScratch)
    (call (. scratch clear))
    (+= masonry-scratch-stack scratch)
  )
  (fn-do _ prepare-tracks _
    (param box Box)
    (param available-cross Coord)
    (param scratch MasonryScratch)
    (call (. scratch clear))
    (blank)
    (let count (call track-count box available-cross))
    (let gap (call cross-gap box))
    (let total-gap (* gap (call Coord (- count 1))))
    (let track-space (call max 0 (- available-cross total-gap)))
    (let track-count-coord (call Coord count))
    (let base-size (/ track-space track-count-coord))
    (let remainder (as (- track-space (* base-size track-count-coord)) Size))
    (let offset Coord 0)
    (blank)
    (for (in index (..< 0 count))
      (let size base-size)
      (if (< index remainder)
        (+= size 1)
      )
      (+= (. scratch track-offsets) offset)
      (+= (. scratch track-sizes) size)
      (+= (. scratch track-lengths) 0)
      (+= offset (+ size gap))
    )
  )
  (fn-expr _ track-count _
    (param box Box)
    (param available-cross Coord)
    (case? explicit
      explicit
    )
    (default
      tracked
    )
    (where
      (lazy explicit (call explicit-track-count box))
      (lazy min-size (call max 1 (call min-track-size box)))
      (lazy gap (call cross-gap box))
      (lazy safe-cross (call max 0 available-cross))
      (lazy count (as (/ (+ safe-cross gap) (+ min-size gap)) Size))
      (lazy tracked
        (block
          (case? (> count 0)
            count
          )
          (default
            1
          )
        )
      )
    )
  )
  (fn-do _ explicit-track-count _
    (param box Box)
    (let count
      (scope (if-expr (== orient (. Orientation vertical)) column-count (. box $masonry-row-count))
        (lazy column-count (?? (. box $masonry-column-count) (. box $masonry-row-count)))
      )
    )
    (return-if (as count Size) (if (and count (> count 0))))
  )
  (fn-expr _ query-cross-size Coord
    (param box Box)
    (param query MeasureQuery)
    (case? available
      available
    )
    (case? maximum
      maximum
    )
    (default
      (+ (* min-size (call Coord count)) (* gap (call Coord (- count 1))))
    )
    (where
      (lazy available (if-expr (== orient (. Orientation vertical)) (?? (. query inline available) (. query block available)) (. query block available)))
      (lazy maximum (if-expr (== orient (. Orientation vertical)) (?? (. query inline max) (. query block max)) (. query block max)))
      (lazy count (?? (call explicit-track-count box) 1))
      (lazy min-size (call max 1 (call min-track-size box)))
      (lazy gap (call cross-gap box))
    )
  )
  (fn-expr _ min-track-size _
    (param box Box)
    (if-expr (== orient (. Orientation vertical)) (. box $masonry-min-column-width) min-height)
    (where
      (lazy min-height (. box $masonry-min-row-height))
    )
  )
  (fn-expr _ cross-gap Coord
    (param box Box)
    (call max 0 (if-expr (== orient (. Orientation vertical)) (. box $masonry-column-gap) (. box $masonry-row-gap)))
  )
  (fn-expr _ primary-gap Coord
    (param box Box)
    (call max 0 (if-expr (== orient (. Orientation vertical)) (. box $masonry-row-gap) (. box $masonry-column-gap)))
  )
  (fn-expr _ child-query _
    (param track-size Coord)
    (case? (== orient (. Orientation vertical))
      (call measure-fit-query track-size)
    )
    (default
      (call MeasureQuery (call fit-axis-query) (call fit-axis-query track-size))
    )
  )
  (fn-do _ shortest-track _
    (param scratch MasonryScratch)
    (let selected (as 0 Size))
    (let best ([] (. scratch track-lengths) 0))
    (let index (as 1 Size))
    (while (< index (. scratch track-lengths length))
      (let length ([] (. scratch track-lengths) index))
      (if (< length best)
        (= selected index)
        (= best length)
      )
      (+= index 1)
    )
    (return selected)
  )
  (fn-do _ max-primary-size _
    (param scratch MasonryScratch)
    (param gap Coord)
    (let primary Coord 0)
    (for (in length (. scratch track-lengths))
      (let track-primary (call max 0 (- length gap)))
      (= primary (call max primary track-primary))
    )
    (return primary)
  )
  (fn-expr _ track-span Coord
    (param scratch MasonryScratch)
    (match (. scratch track-sizes length)
      (case= 0
        0
      )
      (default
        (+ ([] (. scratch track-offsets) last) ([] (. scratch track-sizes) last))
      )
    )
    (where
      (lazy last (- (. scratch track-sizes length) 1))
    )
  )
)

(type _ MasonryScratch
  (prop + track-offsets (list Coord))
  (prop + track-sizes (list Coord))
  (prop + track-lengths (list Coord))
  (fn-do + clear _
    (call (. track-offsets clear))
    (call (. track-sizes clear))
    (call (. track-lengths clear))
  )
)

(fn-do _ layout-natural-size _
  (param box Box)
  (param orient Orientation)
  (let primary Coord 0)
  (let cross Coord 0)
  (let child (. box first-active-child))
  (while child
    (let live child)
    (let size (. live measured-outer-size))
    (if (== orient (. Orientation horizontal))
      (+= primary (. size width))
      (= cross (call max cross (. size height)))
      (else
        (+= primary (. size height))
        (= cross (call max cross (. size width)))
      )
    )
    (= child (. live next-active-sibling))
  )
  (blank)
  (let size
    (block
      (case? (== orient (. Orientation horizontal))
        (call PSize primary cross)
      )
      (default
        (call PSize cross primary)
      )
    )
  )
  (return size)
)
