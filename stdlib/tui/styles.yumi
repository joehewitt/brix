━━━━━━━━━━━━━━━━━━━━
+ BoxPaint is Style

+ background-color BackgroundColor? = null
+ background Painter? = null
+ opacity Ratio = 1%%

. background-color -> paint
. background -> paint
. opacity -> paint

━━━━━━━━━━━━━━━━━━━━
+ TextPaint is Style

+ @inherited color AnsiColor = white

. color -> paint

━━━━━━━━━━━━━━━━━━━━
+ BoxDisplay is Style

+ display Display = Display.visible

. display -> layout, layout on parent, active-list on parent, paint

━━━━━━━━━━━━━━━━━━━━
+ BoxFocus is Style

+ focus-mode = FocusMode.none

. focus-mode -> paint

━━━━━━━━━━━━━━━━━━━━
+ BoxPlacement is Style

+ flex Flex = 0
+ position Position? = null
+ anchor Anchor = .parent
+ left PositionOffset? = null
+ top PositionOffset? = null
+ right PositionOffset? = null
+ bottom PositionOffset? = null
+ align-x AnchorPoint? = null
+ align-y AnchorPoint? = null

. flex -> layout on parent
. position -> layout on parent, active-list on parent
. anchor -> layout on parent
. left -> layout on parent
. top -> layout on parent
. right -> layout on parent
. bottom -> layout on parent
. align-x -> layout on parent
. align-y -> layout on parent

━━━━━━━━━━━━━━━━━━━━
+ BoxSpacing is Style

+ margin-top Coord = 0
+ margin-right Coord = 0
+ margin-bottom Coord = 0
+ margin-left Coord = 0
+ padding-top Coord = 0
+ padding-right Coord = 0
+ padding-bottom Coord = 0
+ padding-left Coord = 0

. margin-top -> layout on parent
. margin-right -> layout on parent
. margin-bottom -> layout on parent
. margin-left -> layout on parent
. padding-top -> layout, layout on parent
. padding-right -> layout, layout on parent
. padding-bottom -> layout, layout on parent
. padding-left -> layout, layout on parent

━━━━━━━━━━━━━━━━━━━━
+ BoxSize is Style

+ min-width SizeSpec = SizeSpec.auto
+ max-width SizeSpec = SizeSpec.auto
+ min-height SizeSpec = SizeSpec.auto
+ max-height SizeSpec = SizeSpec.auto

. min-width -> layout, layout on parent
. max-width -> layout, layout on parent
. min-height -> layout, layout on parent
. max-height -> layout, layout on parent

━━━━━━━━━━━━━━━━━━━━
+ BoxBorder is Style

+ border BorderPainter = DefaultBorderPainter()
+ border-style BorderStyle = BorderStyle.none
+ border-color AnsiColor = white

. border -> layout, layout on parent, paint
. border-style -> layout, layout on parent, paint
. border-color -> paint

━━━━━━━━━━━━━━━━━━━━
+ BoxLayout is Style

` The layout style: authoring `layout` chooses the descriptor the root layout phase invokes for
` the box's children. The value is computed style like any other; changing it invalidates the
` box's own layout domain.

+ layout Layout? = null

. layout -> layout

━━━━━━━━━━━━━━━━━━━━
+ BoxMasonry is Style

+ masonry-column-count Int? = null
+ masonry-row-count Int? = null
+ masonry-min-column-width Coord = 20
+ masonry-min-row-height Coord = 4
+ masonry-column-gap Coord = 0
+ masonry-row-gap Coord = 0

. masonry-column-count -> layout
. masonry-row-count -> layout
. masonry-min-column-width -> layout
. masonry-min-row-height -> layout
. masonry-column-gap -> layout
. masonry-row-gap -> layout
