+ key-for-item String
    - item Item
    - key-prefix String
    - index Index

match key-builder, key-prefix
    | builder MarkupKeyBuilder'Item, _
        builder(item)
    | _, {it}
        "$key-prefix/$index"
    ??
        "$index"

