+ do leave-selection

ensure-selection()

. row = current-selected-row()
sync-selected-state-from-row(row)

. entry = entry-for-row(row)
=? if !entry

if row && row.has-children && entry.is-expanded
    collapse-entry(entry)
    =
. parent-key = entry.parent-key
if parent-key
    select-entry-key(parent-key)

