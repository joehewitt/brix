+ do reset-tree

expanded-keys = List'String()
child-cache = List'(TreeBoxChildren'Item)()
selected-key = null
selection-generation += 1

. current-root = root-node
if current-root
    . root-children = load-children(current-root)
    if root-children != null
        cache-children("", root-children)

rebuild-entries()

