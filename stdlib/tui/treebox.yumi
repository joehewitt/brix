+ do reload

child-cache = List'(TreeBoxChildren'Item)()
. next = visible-entries()
=? if tree-box-entries-match'Item(entries, next)

. held = selected-key
if held && tree-box-entry-for-key'Item(next, held) == null
    selected-key = surviving-key(held, next)
    selection-generation += 1
entries = next
restore-selected-key()
sync-selected-row()
if selected-key != held
    notify-selected()

────────────────────
_ do visible-entries [TreeBoxEntry'Item]

. next [TreeBoxEntry'Item] = List'(TreeBoxEntry'Item)()
. current-root = root-node
if current-root
    . root-children = children-for("", current-root)
    if root-children != null
        append-visible-entries(next, root-children, "", 0)
= next

────────────────────
_ do surviving-key String?
    - key String
    - next [TreeBoxEntry'Item]

. start = entry-index-for-key(key)
=? if start == null
. present = Map'String'Bool()
for entry in next
    present[entry.key] = true
for index in start + 1 .. < entries.length
    =? entries[index].key if present has entries[index].key
. index = start
while index > 0
    index -= 1
    =? entries[index].key if present has entries[index].key

────────────────────
+ do append-visible-entries
    - target [TreeBoxEntry'Item]
    - items [Item]
    - key-prefix String
    - depth Index
    - parent-key String? = null

. index Index = 0
for item in items
    . key = key-for-item(item, key-prefix, index)
    . is-expanded = expanded-key(key)
    target += TreeBoxEntry'Item(item, key, depth, parent-key, is-expanded)
    if is-expanded
        . child-items = children-for(key, item)
        if child-items != null
            append-visible-entries(target, child-items, key, depth + 1, key)
    index += 1

