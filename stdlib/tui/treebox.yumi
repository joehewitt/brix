+ do activate-selection

ensure-selection()

. row = current-selected-row()
sync-selected-state-from-row(row)
if row && row.has-children
    . entry = entry-for-row(row)
    if entry
        if entry.is-expanded
            collapse-entry(entry)
        else
            . ignored = expand-entry(entry)
    =
notify-activated()

