+ do reveal-key-path Bool
    - keys [String]

=? if !keys

. target-key = keys[keys.length - 1]
. last-ancestor = keys.length - 1
. index Index = 0
while index < last-ancestor
    add-expanded-key(keys[index])
    index += 1

rebuild-entries()
=? if entry-index-for-key(target-key) == null

select-entry-key(target-key)
= true

