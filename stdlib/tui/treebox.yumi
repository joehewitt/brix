+ do sync-selected-row-state Bool
    - row ListItem?

. live-row = row
. has-children = live-row?.has-children ?? false
. changed = selected-row != live-row || selected-row-has-children != has-children
selected-row = live-row
selected-row-has-children = has-children
= changed

