━━━━━━━━━━━━━━━━━━━━
_ do tree-box-entries-match'Item Bool
    - current [TreeBoxEntry'Item]
    - next [TreeBoxEntry'Item]

=? false if current.length != next.length
for index in 0 .. < current.length
    . a = current[index]
    . b = next[index]
    =? false if a.key != b.key || a.depth != b.depth || a.is-expanded != b.is-expanded
    =? false if !(a.item == b.item)
= true

