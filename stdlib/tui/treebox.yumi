────────────────────
+ do select-row
    - row ListItem?

. owner = tree
. live-row = valid-row(row)
if selected-row == live-row
    if live-row
        ensure-row-visible(live-row)
        owner?.sync-selected-key-from-row()
else
    . old = selected-row
    if old
        old.is-selected = false

    selected-row = live-row
    if live-row
        live-row.is-selected = true
        ensure-row-visible(live-row)

    if owner
        owner.sync-selected-key-from-row()
        owner.notify-selected()
    else
        selected <- SelectEvent()

────────────────────
+ do activate-selection

. owner = tree
if owner
    owner.activate-selection()
    =
super.activate-selection()

────────────────────
+ do ensure-selection

. row = valid-row(selected-row)
if row
    if !row.is-selected
        row.is-selected = true
    ensure-row-visible(row)
    tree?.sync-selected-key-from-row()
    =
. owner = tree
if owner
    catch owner.sync-selected-row()
else
    super.ensure-selection()

