(type-line + Tcflag (is Long))
(type-line + Speed (is Long))
(type-line + Cc (is U8))

(type + Termios (is Tuple)
  (prop + ciflag Tcflag)
  (prop + coflag Tcflag)
  (prop + ccflag Tcflag)
  (prop + clflag Tcflag)
  (prop + cc _ (= ([] Cc 20)))
  (prop + cispeed Speed)
  (prop + cospeed Speed)
  (prop + padding Long)
  (prop + padding2 Long)
)
