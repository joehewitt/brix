_ table-column-min-width'Row Coord
    - column TableColumn'Row

max(0, column.min-width)

━━━━━━━━━━━━━━━━━━━━
_ table-column-flex'Row Float
    - column TableColumn'Row

match column.column-width
    | TableWidth.flex(flex)
        flex as Float
    ??
        0

━━━━━━━━━━━━━━━━━━━━
_ do table-clamp-column-width'Row Coord
    - column TableColumn'Row
    - width Coord

. result = max(table-column-min-width(column), width)
if column.max-width
    result = min(result, column.max-width)
= result

━━━━━━━━━━━━━━━━━━━━
_ table-aligned-text String
    - text String
    - width Coord
    - align TableAlign

" " * left-padding + text + " " * right-padding

.. display-width = DisplayText(text).display-width as Coord
.. padding = max(0, width - display-width)
.. left-padding =
    |? align == TableAlign.right
        padding
    |? align == TableAlign.center
        padding / 2
    ??
        0
.. right-padding = padding - left-padding
