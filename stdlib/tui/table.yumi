────────────────────

<This
    <Shortcut "Scroll Left"
        key = .arrow-left
        show-in-status = false
        action = => do scroll-body(4, Direction.left)

    <Shortcut "Scroll Right"
        key = .arrow-right
        show-in-status = false
        action = => do scroll-body(4, Direction.right)

    if #show-header
        <TableHeaderRow'Row
            table = this

    for row in ordered-rows(#rows, #sort-column-id, #sort-direction) keyed by key-for-row-with(row, key-builder)
        <TableRow'Row row-box • h:1 flex-row
            table = this
            item = row
            row-key = key-for-row-with(row, #key-builder)
            min-width = width-of-metrics(#metrics)

            for column in #visible-columns keyed by column.id
                <TableCell'Row cell-box • flex-row h:1
                    item = row
                    column = column
                    row = row-box
                    column-width = column-width-for(column, #metrics)
                    margin-right = if column == #visible-columns.tail then 0 else #column-gap

                    + <Box cell - cell-box TableCell'Row • flex:1 flex-row
                        <Label • flex:1
                            text = cell-box.#text

