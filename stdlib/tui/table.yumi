+ do select-row ?! Error
    - row ListItem?

. table-row = table-row-for'Row(row)
. next-handle = table-row?.row-handle
. current-row = selected-row
if same-row
    if table-row
        ensure-row-visible(table-row)
else
    . old-row = selected-table-row()
    . old-handle = old-row?.row-handle
    selected-row = table-row
    selected-row-handle = next-handle

    if old-handle
        row-selection[old-handle] <- SelectEvent()
    else if old-row
        old-row.is-selected = false
    if table-row
        if next-handle
            row-selection[next-handle] <- SelectEvent()
        else
            table-row.is-selected = true
        ensure-row-visible(table-row)

    selected <- SelectEvent()

.. same-row =
    |? !current-row
        !table-row
    |? table-row
        current-row as Pointer == table-row as Pointer
    ??
        false

