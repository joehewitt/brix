    ensure-row-visible(row)

────────────────────
_ do claim-row-handle TableRowHandle

. index Index
if free-row-handle-indexes
    index = free-row-handle-indexes.pop()
else
    index = row-handle-generations.length
    row-handle-generations += 1
    row-handle-live += false

. generation = row-handle-generations[index]
?! Panic("Table row handle generation overflow")
    if !generation
row-handle-live[index] = true
= (index, generation)

────────────────────
_ do release-row-handle
    - handle TableRowHandle

=? if handle.index >= row-handle-generations.length
=? if !row-handle-live[handle.index]
=? if row-handle-generations[handle.index] != handle.generation

row-handle-live[handle.index] = false
. next-generation = handle.generation + 1
?! Panic("Table row handle generation overflow")
    if !next-generation
row-handle-generations[handle.index] = next-generation
free-row-handle-indexes += handle.index

────────────────────
_ do replace-row-handle TableRowHandle
    - handle TableRowHandle

release-row-handle(handle)
= claim-row-handle()

────────────────────
_ do did-unmount-row
    - row TableRow'Row
    - handle TableRowHandle

if selected-row-handle == handle || selected-row == row
    selected-row-handle = null
    selected-row = null

────────────────────
_ do did-change-row-handle
    - row TableRow'Row
    - old-handle TableRowHandle
    - next-handle TableRowHandle

if selected-row-handle == old-handle
    selected-row = row
    selected-row-handle = next-handle

