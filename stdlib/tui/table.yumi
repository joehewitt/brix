_ claimed-row-key String?

────────────────────
+ do sync-row-key-handle

=? if claimed-row-key == row-key

. owner = table
. old-handle = row-handle
if owner && old-handle
    . next-handle = owner.replace-row-handle(old-handle)
    owner.row-selection[old-handle].rekey(next-handle)
        catch err Error
            ?! Panic(err.message)
    owner.row-activation[old-handle].rekey(next-handle)
        catch err Error
            ?! Panic(err.message)
    row-handle = next-handle
    owner.did-change-row-handle(this, old-handle, next-handle)
claimed-row-key = row-key

────────────────────
whenever #row-key

sync-row-key-handle()

────────────────────
_ do claim-row-endpoints ?! Error
    - owner Table'Row
    - claimed TableRowHandle

for event on owner.row-selection[claimed]
    is-selected = row-handle != null && owner.selected-row-handle == row-handle
for event on owner.row-activation[claimed]
    is-selected = row-handle != null && owner.selected-row-handle == row-handle

────────────────────
+ do mounted

super.mounted()
. owner = table
=? if !owner

. claimed = owner.claim-row-handle()
row-handle = claimed
claimed-row-key = row-key
claim-row-endpoints(owner, claimed)
    catch err Error
        ?! Panic(err.message)
. selected = owner.selected-row
if selected && selected as Pointer == this as Pointer
    owner.selected-row-handle = claimed
    is-selected = true

────────────────────
+ do unmounted

. owner = table
. claimed = row-handle
if owner && claimed
    owner.did-unmount-row(this, claimed)
    owner.row-selection[claimed].release()
    owner.row-activation[claimed].release()
    owner.release-row-handle(claimed)
row-handle = null
claimed-row-key = null
is-selected = false
super.unmounted()

