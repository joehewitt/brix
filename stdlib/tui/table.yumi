+ do toggle-sort
    - column TableColumn'Row

=? if !column.is-sortable

. old-column = sort-column-id
. old-direction = sort-direction
. same-column = sort-column-id == column.id
if !same-column
    sort-column-id = column.id
    sort-direction = TableSortDirection.ascending
else
    sort-direction = match sort-direction
        | TableSortDirection.none
            TableSortDirection.ascending
        | TableSortDirection.ascending
            TableSortDirection.descending
        ??
            TableSortDirection.none
    if sort-direction == TableSortDirection.none
        sort-column-id = null

if old-column != sort-column-id || old-direction != sort-direction
    sorted <- TableSortEvent()

