────────────────────
+ do resolve-metrics [TableColumnMetric'Row]
    - available-width Coord

. visible = visible-columns
. gap = max(0, column-gap)
. gap-total = if visible.length > 0 then gap * Coord(visible.length - 1) else 0
. column-space = max(0, available-width - gap-total)
. fixed-total Coord = 0
. flex-total Float = 0
. flex-columns [TableColumn'Row] = List'(TableColumn'Row)()
. widths [Coord] = List'Coord()

for column in visible
    . width Coord = table-column-min-width(column)
    match column.column-width
        | TableWidth.fixed(value)
            width = table-clamp-column-width(column, value)
        | TableWidth.percent(percent)
            width = table-clamp-column-width
                - column
                - round((percent as Ratio) * column-space) as Coord
        | TableWidth.flex(flex)
            flex-total += flex as Float
            flex-columns += column
        ??
            width = auto-column-width(column)
    widths += width
    fixed-total += width

. remaining = max(0, column-space - fixed-total)
. last-flex TableColumn'Row? = flex-columns.tail if flex-columns.length > 0
. assigned-flex Coord = 0
. index Index = 0
for column in visible
    . flex = table-column-flex(column)
    if flex != 0
        . is-last = false
        if last-flex
            is-last = column == last-flex
        . extra = if is-last then leftover else round((flex / flex-total) * remaining) as Coord
            .. leftover = remaining - assigned-flex
        . width = table-clamp-column-width(column, widths[index] + extra)
        assigned-flex += extra
        widths[index] = width
    index += 1

= metrics

.. metrics =
    zip(visible, widths)
    *> TableColumnMetric'Row(each[0], 0, each[1])
    |> scan • using :: previous, current =>
        TableColumnMetric'Row(current.column, previous.x + previous.width + gap, current.width)
    |> List

────────────────────
+ width-of-metrics Coord
    - current-metrics [TableColumnMetric'Row]

max • stream
    * 0 as Coord
    **
        current-metrics
        *> each.x + each.width

────────────────────
+ auto-column-width Coord
    - column TableColumn'Row

table-clamp-column-width(column, width as Coord)

.. width = max • stream
    * DisplayText(header-text(column)).display-width
    **
        rows
        *> DisplayText(column.value-text(each)).display-width

────────────────────
+ ordered-rows [Row]
    - current-rows [Row]
    - current-sort-column-id String?
    - current-sort-direction TableSortDirection = TableSortDirection.none

|? !column || current-sort-direction == TableSortDirection.none
    source
|? comparer
    sort(source) • using comparer • is-reverse is-descending
|? keyer
    sort(source) • using key-comparer • is-reverse is-descending

    .. key-comparer Comparer'Row = :: left Row, right Row =>
        compare-basic(keyer(left), keyer(right))
??
    source

.. source = List'Row(current-rows)
.. column = column-for-id(current-sort-column-id)
.. sort-column = column
.. is-descending = current-sort-direction == TableSortDirection.descending
.. comparer = sort-column.compare
.. keyer = sort-column.sort-key ?? sort-column.value

