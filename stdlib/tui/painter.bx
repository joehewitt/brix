(import ./box)
(import ./canvas)
(import ./primitives)
(import /math)
(import /stream/aggregate)
(import /units)
(blank)
(prop + paint-skip-compositing-layers _ (= false))

(type + Painter
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
  )
)

(type + DefaultBackgroundPainter (is Painter)
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (call paint-default-background node rect canvas)
  )
)

(type + LayerCompositor
  (prop + layers (list CompositingLayer))
  (prop + base-canvas (? Canvas))
  (prop + final-canvas (? Canvas))
  (prop + base-paint-count _ (= 0))
  (prop + layer-paint-count _ (= 0))
  (prop + composite-cell-count _ (= 0))
  (blank)
  (prop _ dirty-bounds Rect)
  (prop _ has-dirty-bounds _ (= false))
  (fn-do + paint _
    (param root Box)
    (param canvas Canvas)
    (let has-new-surfaces (call ensure-surfaces (. root bounds size)))
    (call begin-layer-reconcile)
    (do-use canvas
      (call (. canvas offset) (tuple (. root scroll-x) (. root scroll-y)))
      (call collect-layers root canvas)
    )
    (call finish-layer-reconcile)
    (blank)
    (let needs-ordered (> (. layers length) 0))
    (let damage (call (. root take-paint-damage-bounds)))
    (let needs-base (or has-new-surfaces (call needs-base-paint root)))
    (blank)
    (if (or needs-base damage)
      (call repaint-base root)
      (if needs-base
        (call add-dirty-bounds (. root bounds))
        (else-if damage
          (call add-dirty-bounds damage)
        )
      )
    )
    (blank)
    (call paint-dirty-layers)
    (if needs-ordered
      (call compose-ordered root)
      (else
        (call compose-dirty-bounds)
      )
    )
    (call (. canvas copy) (!! final-canvas))
  )
  (fn-do + reset _
    (call (. layers clear))
    (= base-canvas null)
    (= final-canvas null)
    (= has-dirty-bounds false)
  )
  (fn-do _ ensure-surfaces Bool
    (param size PSize)
    (if (and base-canvas final-canvas)
      (return-if false (if (and (== (. base-canvas width) (. size width)) (== (. base-canvas height) (. size height)))))
    )
    (blank)
    (= base-canvas (call Canvas size))
    (= final-canvas (call Canvas size))
    (for (in layer layers)
      (= (. layer needs-content-paint) true)
    )
    (return true)
  )
  (fn-do _ begin-layer-reconcile _
    (= has-dirty-bounds false)
    (for (in layer layers)
      (= (. layer was-seen) false)
      (= (. layer needs-geometry-cleanup) false)
    )
  )
  (fn-do _ collect-layers _
    (param root Box)
    (param canvas Canvas)
    (for (in child (. root structural-children))
      (call collect-layer-subtree child canvas)
    )
  )
  (fn-do _ collect-layer-subtree _
    (param box Box)
    (param canvas Canvas)
    (if (not (. box is-display-visible))
      (call (. box invalidate-retained-paint-footprint))
      (return)
    )
    (if (and (not (. box is-markup-shadow)) (not (call (. canvas is-rect-visible) (. box bounds))))
      (return)
    )
    (blank)
    (if (. box requires-compositing-layer)
      (call collect-hidden-paint-damage box)
      (call update-layer (call layer-for box))
      (return)
    )
    (if (. box is-markup-shadow)
      (call collect-layers box canvas)
      (else
        (do-use canvas
          (call (. canvas clip) (. box content-bounds))
          (call (. canvas offset) (tuple (. box scroll-x) (. box scroll-y)))
          (call collect-layers box canvas)
        )
      )
    )
  )
  (fn-do _ collect-hidden-paint-damage _
    (param box Box)
    (for (in child (. box structural-children))
      (if (. child is-display-visible)
        (call collect-hidden-paint-damage child)
        (else
          (call (. child invalidate-retained-paint-footprint))
        )
      )
    )
  )
  (fn-do _ layer-for _
    (param owner Box)
    (for (in layer layers)
      (if (== (. layer owner) owner)
        (return layer)
      )
    )
    (blank)
    (let fresh (call CompositingLayer owner))
    (+= layers fresh)
    (return fresh)
  )
  (fn-do _ update-layer _
    (param layer CompositingLayer)
    (let owner (. layer owner))
    (let next-bounds (. owner bounds))
    (let next-opacity (. owner compositing-opacity))
    (let geometry-changed (and (. layer has-bounds) (!= (. layer bounds) next-bounds)))
    (let same-size-move (and geometry-changed (== (. layer bounds size) (. next-bounds size))))
    (blank)
    (= (. layer was-seen) true)
    (blank)
    (if (not (. layer has-bounds))
      (= (. layer bounds) next-bounds)
      (= (. layer previous-bounds) next-bounds)
      (= (. layer has-bounds) true)
      (= (. layer needs-content-paint) true)
      (call add-dirty-bounds next-bounds)
      (else-if geometry-changed
        (= (. layer previous-bounds) (. layer bounds))
        (= (. layer bounds) next-bounds)
        (call add-dirty-bounds (. layer previous-bounds))
        (call add-dirty-bounds (. layer bounds))
        (if (not same-size-move)
          (= (. layer needs-content-paint) true)
        )
      )
    )
    (blank)
    (if (!= (. layer opacity) next-opacity)
      (= (. layer opacity) next-opacity)
      (call add-dirty-bounds (. layer bounds))
    )
    (blank)
    (if (call layer-subtree-paint-invalid owner)
      (if (and same-size-move (not (call layer-descendant-paint-invalid owner)))
        (= (. layer needs-geometry-cleanup) true)
        (else
          (= (. layer needs-content-paint) true)
          (call add-dirty-bounds (. layer bounds))
        )
      )
    )
  )
  (fn-do _ finish-layer-reconcile _
    (let index Index 0)
    (while (< index (. layers length))
      (let layer ([] layers index))
      (if (not (. layer was-seen))
        (if (. layer has-bounds)
          (call add-dirty-bounds (. layer bounds))
        )
        (call (. layers remove) index)
        (else
          (+= index 1)
        )
      )
    )
  )
  (fn-expr _ needs-base-paint _
    (param root Box)
    (call some (. root structural-children) (:where (call base-subtree-paint-invalid each)))
  )
  (fn-do _ base-subtree-paint-invalid Bool
    (param box Box)
    (return-if (if (not (. box is-paint-visible))))
    (return-if (if (. box requires-compositing-layer)))
    (return-if true (if (. box $is-paint-invalid)))
    (blank)
    (return (call some (. box structural-children) (:where (call base-subtree-paint-invalid each))))
  )
  (fn-do _ repaint-base _
    (param root Box)
    (let base (!! base-canvas))
    (call (. base reset))
    (do-use base
      (call (. base offset) (tuple (. root scroll-x) (. root scroll-y)))
      (for (in child (. root structural-children))
        (if (not (. child requires-compositing-layer))
          (call paint-with-compositing-layers-skipped child base)
        )
      )
    )
    (blank)
    (+= base-paint-count 1)
    (probe-count tui.layers.base-paints)
  )
  (fn-do _ paint-with-compositing-layers-skipped _
    (param box Box)
    (param canvas Canvas)
    (let previous paint-skip-compositing-layers)
    (= paint-skip-compositing-layers true)
    (finally
      (= paint-skip-compositing-layers previous)
    )
    (blank)
    (call (. box paint) canvas)
  )
  (fn-do _ paint-dirty-layers _
    (for (in layer layers)
      (if (. layer needs-content-paint)
        (call paint-layer-content layer)
        (else-if (. layer needs-geometry-cleanup)
          (= (. layer owner $is-layout-invalid) false)
          (call (. layer owner mark-layout-arranged))
          (call (. layer owner did-paint))
          (= (. layer needs-geometry-cleanup) false)
        )
      )
    )
  )
  (fn-do _ paint-layer-content _
    (param layer CompositingLayer)
    (let size (. layer bounds size))
    (let needs-surface true)
    (if (. layer surface)
      (let existing (. layer surface))
      (= needs-surface (or (!= (. existing width) (. size width)) (!= (. existing height) (. size height))))
    )
    (if needs-surface
      (= (. layer surface) (call Canvas size true))
    )
    (blank)
    (let surface (!! (. layer surface)))
    (call (. surface reset))
    (do-use surface
      (call (. surface offset) (tuple (- (. layer bounds x)) (- (. layer bounds y))))
      (call (. layer owner paint) surface)
    )
    (blank)
    (= (. layer needs-content-paint) false)
    (= (. layer needs-geometry-cleanup) false)
    (+= layer-paint-count 1)
    (probe-count tui.layers.content-paints)
  )
  (fn-do _ compose-ordered _
    (param root Box)
    (let final (!! final-canvas))
    (call (. final reset))
    (call (. final copy) (!! base-canvas))
    (blank)
    (do-use final
      (call (. final offset) (tuple (. root scroll-x) (. root scroll-y)))
      (call compose-ordered-children root final)
    )
    (blank)
    (= has-dirty-bounds false)
  )
  (fn-do _ compose-ordered-children Bool
    (param parent Box)
    (param canvas Canvas)
    (let saw-layer false)
    (for (in child (. parent structural-children))
      (if (not (. child is-display-visible))
        (continue)
      )
      (if (and (not (. child is-markup-shadow)) (not (call (. canvas is-rect-visible) (. child bounds))))
        (continue)
      )
      (blank)
      (if (. child requires-compositing-layer)
        (call composite-layer (call layer-for child) canvas)
        (= saw-layer true)
        (else
          (if saw-layer
            (call paint-with-compositing-layers-skipped child canvas)
          )
          (if (call compose-ordered-descendants child canvas)
            (= saw-layer true)
          )
        )
      )
    )
    (blank)
    (return saw-layer)
  )
  (fn-do _ compose-ordered-descendants Bool
    (param box Box)
    (param canvas Canvas)
    (if (. box is-markup-shadow)
      (return (call compose-ordered-children box canvas))
    )
    (blank)
    (let saw-layer false)
    (do-use canvas
      (call (. canvas clip) (. box content-bounds))
      (call (. canvas offset) (tuple (. box scroll-x) (. box scroll-y)))
      (= saw-layer (call compose-ordered-children box canvas))
    )
    (return saw-layer)
  )
  (fn-do _ composite-layer _
    (param layer CompositingLayer)
    (param canvas Canvas)
    (if (and (> (. layer opacity) 0%%) (. layer surface))
      (call (. canvas composite) (. layer surface) (. layer bounds) (. layer bounds point) (. layer opacity))
      (+= composite-cell-count (* (as (. layer bounds width) Size) (. layer bounds height)))
    )
  )
  (fn-do _ compose-dirty-bounds _
    (return-if (if (not has-dirty-bounds)))
    (blank)
    (let final (!! final-canvas))
    (call (. final copy) dirty-bounds (!! base-canvas))
    (blank)
    (for (in layer layers)
      (if (and (> (. layer opacity) 0%%) (. layer surface) (call rects-intersect dirty-bounds (. layer bounds)))
        (call (. final composite) (. layer surface) dirty-bounds (. layer bounds point) (. layer opacity))
        (let cells (call rect-intersection-area dirty-bounds (. layer bounds)))
        (+= composite-cell-count cells)
        (probe-count tui.layers.composited-cells cells)
      )
    )
    (blank)
    (= has-dirty-bounds false)
  )
  (fn-do _ add-dirty-bounds _
    (param rect Rect)
    (return-if (if (<= (. rect width) 0)))
    (return-if (if (<= (. rect height) 0)))
    (blank)
    (if (not has-dirty-bounds)
      (= dirty-bounds rect)
      (= has-dirty-bounds true)
      (else
        (= dirty-bounds (call union-rect dirty-bounds rect))
      )
    )
  )
  (fn-expr _ layer-subtree-paint-invalid Bool
    (param box Box)
    (case? (. box $is-paint-invalid)
      true
    )
    (default
      (call layer-descendant-paint-invalid box)
    )
  )
  (fn-expr _ layer-descendant-paint-invalid Bool
    (param box Box)
    (call some (. box structural-children) (:where (call layer-subtree-paint-invalid each)))
  )
)

(fn-do + paint-box-background _
  (param node Box)
  (param rect Rect)
  (param canvas Canvas)
  (let painter (. node $background))
  (if painter
    (call paint-background-painter painter node rect canvas)
    (else
      (call paint-default-background node rect canvas)
    )
  )
)

(fn-do + paint-default-background _
  (param node Box)
  (param rect Rect)
  (param canvas Canvas)
  (let color (. node $background-color))
  (if (not color)
    (= (. canvas background) null)
    (return)
  )
  (= (. canvas background) color)
  (call (. canvas fill) rect)
)

(fn-expr + clamped-compositing-opacity _
  (param opacity Ratio)
  (case? (<= opacity 0%%)
    0%%
  )
  (case? (>= opacity 1%%)
    1%%
  )
  (default
    opacity
  )
)

(fn-expr + union-rect _
  (param a Rect)
  (param b Rect)
  (call Rect left top (- right left) (- bottom top))
  (where
    (lazy left (call min (. a x) (. b x)))
    (lazy top (call min (. a y) (. b y)))
    (lazy right (call max (. a right) (. b right)))
    (lazy bottom (call max (. a bottom) (. b bottom)))
  )
)

(type _ CompositingLayer
  (prop + owner Box)
  (prop + bounds Rect)
  (prop + previous-bounds Rect)
  (prop + opacity Ratio (= 1%%))
  (prop + surface (? Canvas))
  (prop + has-bounds _ (= false))
  (prop + was-seen _ (= false))
  (prop + needs-content-paint _ (= true))
  (prop + needs-geometry-cleanup _ (= false))
  (fn-do + This _
    (param owner _)
  )
)

(fn-do _ paint-background-painter _
  (param painter Painter)
  (param node Box)
  (param rect Rect)
  (param canvas Canvas)
  (call (. painter paint) node rect canvas)
)

(fn-expr _ rects-intersect _
  (param a Rect)
  (param b Rect)
  (and (< (. a x) (. b right)) (< (. b x) (. a right)) (< (. a y) (. b bottom)) (< (. b y) (. a bottom)))
)

(fn-expr _ rect-intersection-area Size
  (param a Rect)
  (param b Rect)
  (case? (not (call rects-intersect a b))
    0
  )
  (default
    (* (as (- right left) Size) (- bottom top))
  )
  (where
    (lazy left (call max (. a x) (. b x)))
    (lazy top (call max (. a y) (. b y)))
    (lazy right (call min (. a right) (. b right)))
    (lazy bottom (call min (. a bottom) (. b bottom)))
  )
)
