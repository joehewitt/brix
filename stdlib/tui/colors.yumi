./primitives
/math
/units

+ black = AnsiColor(0)
+ maroon = AnsiColor(1)
+ green = AnsiColor(2)
+ olive = AnsiColor(3)
+ navy = AnsiColor(4)
+ purple = AnsiColor(5)
+ teal = AnsiColor(6)
+ silver = AnsiColor(7)
+ grey = AnsiColor(8)
+ gray = grey
+ red = AnsiColor(9)
+ lime = AnsiColor(10)
+ yellow = AnsiColor(11)
+ blue = AnsiColor(12)
+ fuchsia = AnsiColor(13)
+ magenta = fuchsia
+ aqua = AnsiColor(14)
+ cyan = aqua
+ brightwhite = AnsiColor(15)
+ white = AnsiColor(255)
+ charcoal = AnsiColor(234)
+ slate = AnsiColor(237)
+ dimgray = AnsiColor(240)
+ midgray = AnsiColor(244)
+ mutedgray = AnsiColor(246)
+ lightgray = AnsiColor(252)
+ deepblue = AnsiColor(20)
+ vermillion = AnsiColor(202)
+ salmon = AnsiColor(203)
+ coral = AnsiColor(209)
+ orange = AnsiColor(214)
+ amber = AnsiColor(220)
+ gold = AnsiColor(226)
+ chartreuse = AnsiColor(118)
+ emerald = AnsiColor(48)
+ mint = AnsiColor(121)
+ sky = AnsiColor(81)
+ ice = AnsiColor(195)
+ rose = AnsiColor(205)
+ pink = AnsiColor(213)
+ violet = AnsiColor(135)
+ indigo = AnsiColor(56)

━━━━━━━━━━━━━━━━━━━━
+ ansi-gray
    - level Percent

(232 + clipped) as AnsiColor

.. clipped = min(23, max(0, raw))
.. raw = round(((level as Ratio) * 255.0 - 8.0) / 10.0) as Int

━━━━━━━━━━━━━━━━━━━━
+ ansi-rgb
    - red Int
    - green Int
    - blue Int

(16 + r * 36 + g * 6 + b) as AnsiColor

.. r = ansi-cube-level(red)
.. g = ansi-cube-level(green)
.. b = ansi-cube-level(blue)

━━━━━━━━━━━━━━━━━━━━
+ ansi-red
    - intensity Percent = 100%

ansi-rgb(ansi-intensity-level(intensity), 0, 0)

━━━━━━━━━━━━━━━━━━━━
+ ansi-green
    - intensity Percent = 100%

ansi-rgb(0, ansi-intensity-level(intensity), 0)

━━━━━━━━━━━━━━━━━━━━
+ ansi-blue
    - intensity Percent = 100%

ansi-rgb(0, 0, ansi-intensity-level(intensity))

━━━━━━━━━━━━━━━━━━━━
+ ansi-yellow
    - intensity Percent = 100%

ansi-rgb(level, level, 0)

.. level = ansi-intensity-level(intensity)

━━━━━━━━━━━━━━━━━━━━
+ ansi-cyan
    - intensity Percent = 100%

ansi-rgb(0, level, level)

.. level = ansi-intensity-level(intensity)

━━━━━━━━━━━━━━━━━━━━
+ ansi-magenta
    - intensity Percent = 100%

ansi-rgb(level, 0, level)

.. level = ansi-intensity-level(intensity)

━━━━━━━━━━━━━━━━━━━━
+ ansi-orange
    - intensity Percent = 100%

ansi-rgb(level, orange-green-level(level), 0)

.. level = ansi-intensity-level(intensity)

━━━━━━━━━━━━━━━━━━━━
_ ansi-cube-level
    - value Int

min(5, (max(0, value)))

━━━━━━━━━━━━━━━━━━━━
_ ansi-intensity-level
    - intensity Percent

min(5, (max(0, raw)))

.. raw = round((intensity as Ratio) * 5.0) as Int

━━━━━━━━━━━━━━━━━━━━
_ orange-green-level
    - level Int

(level + 1) / 2
