(import ./box)
(import ./colors)
(import ./events)
(import ./layout)
(import ./listbox)
(import ./primitives)
(import ./shortcuts)
(import ./styles)
(import ./text)
(import ./theme)
(import /core/function)
(import /core/list)
(import /core/markup)
(import /core/string)
(import /math)
(import /stream/aggregate)
(import /stream/combine)
(import /stream/sort)
(import /ui/input)
(import /units)

(style-extend TUIDefaultTheme
  (using BoxPaint)
  (using TextPaint)
  (rule Table
    (= background-color (call AnsiColor 0))
    (= color (call AnsiColor 7))
  )
  (blank)
  (rule TableHeaderRow
    (= background-color (call AnsiColor 0))
    (= color (call AnsiColor 255))
  )
  (blank)
  (rule TableRow
    (= background-color (call AnsiColor 0))
    (= color (call AnsiColor 7))
    (blank)
    (when-style #is-selected
      (= color (call AnsiColor 255))
      (= background-color (call AnsiColor 4))
    )
  )
)

(type + TableRowHandle (is (tuple (: index Index) (: generation U64))))

(type + (of Table Row) (is ListBox)
  (prop + rows (list Row) (= (call (of List Row))))
  (prop + key-builder (? (of MarkupKeyBuilder Row)))
  (prop + visible-columns (list (of TableColumn Row)) (= (call (of List (of TableColumn Row)))))
  (prop + column-gap Coord (= 2))
  (prop + show-header _ (= true))
  (prop + metrics (list (of TableColumnMetric Row)) (= (call (of List (of TableColumnMetric Row)))))
  (prop + sort-column-id (? String))
  (prop + sort-direction TableSortDirection (= (. TableSortDirection none)))
  (prop + metrics-width Coord (=> (call width-of-metrics metrics)))
  (prop + selected-row-handle (? TableRowHandle))
  (event + sorted TableSortEvent)
  (event + row-selection SelectEvent TableRowHandle)
  (event + row-activation ActivateEvent TableRowHandle)
  (blank)
  (prop _ columns-value (list (of TableColumn Row)) (= (call (of List (of TableColumn Row)))))
  (prop _ row-handle-generations (list U64) (= (call (of List U64))))
  (prop _ row-handle-live (list Bool) (= (call (of List Bool))))
  (prop _ free-row-handle-indexes (list Index) (= (call (of List Index))))
  (blank)
  (depends refresh-metrics rows visible-columns column-gap sort-column-id sort-direction)
  (blank)
  (rule This
    (= layout flex-col)
  )
  (content
    (<> This
      (<> Shortcut (text: "Scroll Left")
        (= key .arrow-left)
        (= show-in-status false)
        (= action (=> () :do (call scroll-body 4 (. Direction left))))
      )
      (blank)
      (<> Shortcut (text: "Scroll Right")
        (= key .arrow-right)
        (= show-in-status false)
        (= action (=> () :do (call scroll-body 4 (. Direction right))))
      )
      (blank)
      (if #show-header
        (<> (of TableHeaderRow Row)
          (= table this)
        )
      )
      (blank)
      (for (in row (call ordered-rows #rows #sort-column-id #sort-direction) (keyed-by (call key-for-row-with row key-builder)))
        (<> (of TableRow Row) (id: row-box) (• h 1) (• flex-row)
          (= table this)
          (= item row)
          (= row-key (call key-for-row-with row #key-builder))
          (= min-width (call width-of-metrics #metrics))
          (blank)
          (for (in column #visible-columns (keyed-by (. column id)))
            (<> (of TableCell Row) (id: cell-box) (• flex-row) (• h 1)
              (= item row)
              (= column column)
              (= row row-box)
              (= column-width (call column-width-for column #metrics))
              (= margin-right (if-expr (== column (. #visible-columns tail)) 0 #column-gap))
              (blank)
              (+<> Box (id: cell) (param: cell-box (of TableCell Row)) (• flex 1) (• flex-row)
                (<> Label (• flex 1)
                  (= text (. cell-box #text))
                )
              )
            )
          )
        )
      )
    )
  )
  (whenever-rule (trigger children (of TableHeaderRow Row))
    (call invalidate-layout)
  )
  (whenever-rule (trigger children (of TableRow Row))
    (call invalidate-layout)
  )
  (fn-do + arrange-outer-bounds _
    (param rect Rect)
    (call (. super arrange-outer-bounds) rect)
    (call ensure-active-child-links)
    (= metrics (call resolve-metrics (. content-bounds width)))
  )
  (fn-do + update-layout _
    (call ensure-active-child-links)
    (= metrics (call resolve-metrics (. content-bounds width)))
    (call invalidate-layout)
    (call (. flex-col arrange-box) this)
    (call (. super update-layout))
  )
  (fn-expr + columns (list (of TableColumn Row)) :get
    columns-value
  )
  (fn-do + selected-item (? Row) :get
    (let row (call selected-table-row))
    (return-if (if (not row)))
    (return (. row item))
  )
  (fn-do + selected-key (? String) :get
    (let row (call selected-table-row))
    (return-if (if (not row)))
    (return (. row row-key))
  )
  (fn-expr + selected-table-row (? (of TableRow Row))
    (case? handle
      (only-if ([] matching-rows 0) (if (. matching-rows length)))
    )
    (case? (and unmounted-row (is unmounted-row (of TableRow Row)))
      (as unmounted-row (of TableRow Row))
    )
    (default
      null
    )
    (where
      (lazy handle selected-row-handle)
      (lazy matching-rows (list (of TableRow Row)) (case-each (in row (call ordered-row-boxes) (when (== (. row row-handle) handle)))))
      (lazy unmounted-row (call valid-row selected-row))
    )
  )
  (fn-expr _ (of table-row-for Row) (? (of TableRow Row))
    (param row (? ListItem))
    (case? (and live-row (is live-row (of TableRow Row)))
      (as live-row (of TableRow Row))
    )
    (default
      null
    )
    (where
      (lazy live-row (call valid-row row))
    )
  )
  (fn-do + select-row _ (?! Error)
    (param row (? ListItem))
    (let table-row (call (of table-row-for Row) row))
    (let next-handle (?. table-row row-handle))
    (let current-row selected-row)
    (if same-row
      (if table-row
        (call ensure-row-visible table-row)
      )
      (else
        (let old-row (call selected-table-row))
        (let old-handle (?. old-row row-handle))
        (= selected-row table-row)
        (= selected-row-handle next-handle)
        (blank)
        (if old-handle
          (<- ([] row-selection old-handle) (call SelectEvent))
          (else-if old-row
            (= (. old-row is-selected) false)
          )
        )
        (if table-row
          (if next-handle
            (<- ([] row-selection next-handle) (call SelectEvent))
            (else
              (= (. table-row is-selected) true)
            )
          )
          (call ensure-row-visible table-row)
        )
        (blank)
        (<- selected (call SelectEvent))
      )
    )
    (blank)
    (lazy same-row
      (block
        (case? (not current-row)
          (not table-row)
        )
        (case? table-row
          (== (as current-row Pointer) (as table-row Pointer))
        )
        (default
          false
        )
      )
    )
  )
  (fn-do + activate-selection _ (?! Error)
    (call ensure-selection)
    (let row (call selected-table-row))
    (if row
      (let handle (. row row-handle))
      (if handle
        (<- ([] row-activation handle) (call ActivateEvent))
        (else
          (= (. row is-selected) true)
        )
      )
    )
    (<- activated (call ActivateEvent))
  )
  (fn-do + ensure-selection _
    (let row (call selected-table-row))
    (if row
      (let handle (. row row-handle))
      (if handle
        (<- ([] row-selection handle) (call SelectEvent))
        (else
          (= (. row is-selected) true)
        )
      )
      (call ensure-row-visible row)
    )
  )
  (fn-do _ claim-row-handle TableRowHandle
    (let index Index)
    (if free-row-handle-indexes
      (= index (call (. free-row-handle-indexes pop)))
      (else
        (= index (. row-handle-generations length))
        (+= row-handle-generations 1)
        (+= row-handle-live false)
      )
    )
    (blank)
    (let generation ([] row-handle-generations index))
    (throw (call Panic "Table row handle generation overflow") (if (not generation)))
    (= ([] row-handle-live index) true)
    (return (tuple index generation))
  )
  (fn-do _ release-row-handle _
    (param handle TableRowHandle)
    (return-if (if (>= (. handle index) (. row-handle-generations length))))
    (return-if (if (not ([] row-handle-live (. handle index)))))
    (return-if (if (!= ([] row-handle-generations (. handle index)) (. handle generation))))
    (blank)
    (= ([] row-handle-live (. handle index)) false)
    (let next-generation (+ (. handle generation) 1))
    (throw (call Panic "Table row handle generation overflow") (if (not next-generation)))
    (= ([] row-handle-generations (. handle index)) next-generation)
    (+= free-row-handle-indexes (. handle index))
  )
  (fn-do _ replace-row-handle TableRowHandle
    (param handle TableRowHandle)
    (call release-row-handle handle)
    (return (call claim-row-handle))
  )
  (fn-do _ did-unmount-row _
    (param row (of TableRow Row))
    (param handle TableRowHandle)
    (if (or (== selected-row-handle handle) (== selected-row row))
      (= selected-row-handle null)
      (= selected-row null)
    )
  )
  (fn-do _ did-change-row-handle _
    (param row (of TableRow Row))
    (param old-handle TableRowHandle)
    (param next-handle TableRowHandle)
    (if (== selected-row-handle old-handle)
      (= selected-row row)
      (= selected-row-handle next-handle)
    )
  )
  (fn-do + columns _ :set (param value (list (of TableColumn Row)))
    (= columns-value value)
    (call refresh-visible-columns)
  )
  (fn-expr + key-for-row (? String)
    (param row Row)
    (call key-for-row-with row key-builder)
  )
  (fn-do + key-for-row-with (? String)
    (param row Row)
    (param builder (? (of MarkupKeyBuilder Row)))
    (return-if (call builder row) (if builder))
  )
  (fn-do + refresh-visible-columns _
    (= visible-columns (case-each (in column columns (when (. column is-visible)))))
  )
  (fn-expr + header-text String
    (param column (of TableColumn Row))
    (call table-header-label column sort-column-id sort-direction)
  )
  (fn-do + column-at-x (? (of TableColumn Row))
    (param x Coord)
    (for (in metric metrics)
      (if (and (>= x (. metric x)) (< x (+ (. metric x) (. metric width))))
        (return (. metric column))
      )
    )
  )
  (fn-expr + column-width-for Coord
    (param column (of TableColumn Row))
    (call column-width-for column metrics)
  )
  (fn-expr + column-width-for Coord
    (param column (of TableColumn Row))
    (param current-metrics (list (of TableColumnMetric Row)))
    (case? metric
      (. metric width)
    )
    (default
      (call table-column-min-width column)
    )
    (where
      (lazy metric (call metric-for-column column current-metrics))
    )
  )
  (fn-expr + metric-for-column (? (of TableColumnMetric Row))
    (param column (of TableColumn Row))
    (call metric-for-column column metrics)
  )
  (fn-do + metric-for-column (? (of TableColumnMetric Row))
    (param column (of TableColumn Row))
    (param current-metrics (list (of TableColumnMetric Row)))
    (for (in metric current-metrics)
      (if (== (. metric column) column)
        (return metric)
      )
    )
  )
  (fn-do + column-for-id (? (of TableColumn Row))
    (param id (? String))
    (return-if (if (not id)))
    (blank)
    (for (in column columns)
      (if (== (. column id) id)
        (return column)
      )
    )
  )
  (fn-do + toggle-sort _
    (param column (of TableColumn Row))
    (return-if (if (not (. column is-sortable))))
    (blank)
    (let old-column sort-column-id)
    (let old-direction sort-direction)
    (let same-column (== sort-column-id (. column id)))
    (if (not same-column)
      (= sort-column-id (. column id))
      (= sort-direction (. TableSortDirection ascending))
      (else
        (= sort-direction
          (match sort-direction
            (case (. TableSortDirection none)
              (. TableSortDirection ascending)
            )
            (case (. TableSortDirection ascending)
              (. TableSortDirection descending)
            )
            (default
              (. TableSortDirection none)
            )
          )
        )
        (if (== sort-direction (. TableSortDirection none))
          (= sort-column-id null)
        )
      )
    )
    (blank)
    (if (or (!= old-column sort-column-id) (!= old-direction sort-direction))
      (<- sorted (call TableSortEvent))
    )
  )
  (fn-expr + scroll-body _
    (param amount Coord)
    (param direction Direction)
    (call scroll amount direction)
  )
  (fn-do + header-row (? (of TableHeaderRow Row))
    (for (in child active-children)
      (if (is child (of TableHeaderRow Row))
        (return (as child (of TableHeaderRow Row)))
      )
    )
  )
  (fn-expr + ordered-row-boxes _
    (spread active-children)
    (pipe ?*>
      (match? each
        (case (: row (of TableRow Row))
          row
        )
      )
    )
    (pipe ?> (and (. each is-effectively-enabled) (== (. each $display) .visible)))
    (pipe |> List)
  )
  (fn-do _ refresh-metrics _
    (= metrics (call resolve-metrics (. content-bounds width)))
    (call invalidate-layout)
  )
  (fn-do + resolve-metrics (list (of TableColumnMetric Row))
    (param available-width Coord)
    (let visible visible-columns)
    (let gap (call max 0 column-gap))
    (let gap-total (if-expr (> (. visible length) 0) (* gap (call Coord (- (. visible length) 1))) 0))
    (let column-space (call max 0 (- available-width gap-total)))
    (let fixed-total Coord 0)
    (let flex-total Float 0)
    (let flex-columns (list (of TableColumn Row)) (call (of List (of TableColumn Row))))
    (let widths (list Coord) (call (of List Coord)))
    (blank)
    (for (in column visible)
      (let width Coord (call table-column-min-width column))
      (match (. column column-width)
        (case (call (. TableWidth fixed) value)
          (= width (call table-clamp-column-width column value))
        )
        (case (call (. TableWidth percent) percent)
          (= width
            (call table-clamp-column-width
              (block
                (arg column)
                (arg (as (call round (* (as percent Ratio) column-space)) Coord))
              )
            )
          )
        )
        (case (call (. TableWidth flex) flex)
          (+= flex-total (as flex Float))
          (+= flex-columns column)
        )
        (default
          (= width (call auto-column-width column))
        )
      )
      (+= widths width)
      (+= fixed-total width)
    )
    (blank)
    (let remaining (call max 0 (- column-space fixed-total)))
    (let last-flex (? (of TableColumn Row)) (only-if (. flex-columns tail) (if (> (. flex-columns length) 0))))
    (let assigned-flex Coord 0)
    (let index Index 0)
    (for (in column visible)
      (let flex (call table-column-flex column))
      (if (!= flex 0)
        (let is-last false)
        (if last-flex
          (= is-last (== column last-flex))
        )
        (let extra
          (scope (if-expr is-last leftover (as (call round (* (/ flex flex-total) remaining)) Coord))
            (lazy leftover (- remaining assigned-flex))
          )
        )
        (let width (call table-clamp-column-width column (+ ([] widths index) extra)))
        (+= assigned-flex extra)
        (= ([] widths index) width)
      )
      (+= index 1)
    )
    (blank)
    (return metrics)
    (blank)
    (lazy metrics
      (block
        (call zip visible widths)
        (pipe *> (call (of TableColumnMetric Row) ([] each 0) 0 ([] each 1)))
        (pipe |>
          (call scan
            (:using
              (=> (previous current)
                (block
                  (call (of TableColumnMetric Row) (. current column) (+ (. previous x) (. previous width) gap) (. current width))
                )
              )
            )
          )
        )
        (pipe |> List)
      )
    )
  )
  (fn-expr + width-of-metrics Coord
    (param current-metrics (list (of TableColumnMetric Row)))
    (call max
      (:stream
        (block
          (item (as 0 Coord))
          (spread
            (block
              current-metrics
              (pipe *> (+ (. each x) (. each width)))
            )
          )
        )
      )
    )
  )
  (fn-expr + auto-column-width Coord
    (param column (of TableColumn Row))
    (call table-clamp-column-width column (as width Coord))
    (where
      (lazy width
        (call max
          (:stream
            (block
              (item (. (call DisplayText (call header-text column)) display-width))
              (spread
                (block
                  rows
                  (pipe *> (. (call DisplayText (call (. column value-text) each)) display-width))
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-expr + ordered-rows (list Row)
    (param current-rows (list Row))
    (param current-sort-column-id (? String))
    (param current-sort-direction TableSortDirection (= (. TableSortDirection none)))
    (case? (or (not column) (== current-sort-direction (. TableSortDirection none)))
      source
    )
    (case? comparer
      (call sort source (:using comparer) (:is-reverse is-descending))
    )
    (case? keyer
      (call sort source (:using key-comparer) (:is-reverse is-descending))
      (blank)
      (lazy key-comparer (of Comparer Row)
        (=> ((: left Row) (: right Row))
          (block
            (call compare-basic (call keyer left) (call keyer right))
          )
        )
      )
    )
    (default
      source
    )
    (where
      (lazy source (call (of List Row) current-rows))
      (lazy column (call column-for-id current-sort-column-id))
      (lazy sort-column column)
      (lazy is-descending (== current-sort-direction (. TableSortDirection descending)))
      (lazy comparer (. sort-column compare))
      (lazy keyer (?? (. sort-column sort-key) (. sort-column value)))
    )
  )
)

(type + (of TableTextProvider Row) (is (fn-type String (param row Row))))

(type + TableWidth (is Union)
  (variant auto)
  (variant fixed Coord)
  (variant flex Flex)
  (variant percent Percent)
)

(type + TableAlign (is Union)
  (variant left)
  (variant center)
  (variant right)
)

(type + TableSortDirection (is Union)
  (variant none)
  (variant ascending)
  (variant descending)
)

(type + TableSortEvent (is BoxEvent)
  (fn-to-expr + String
    "TableSortEvent()"
  )
)

(type + (of TableColumnMetric Row) (is Tuple)
  (prop + column (of TableColumn Row))
  (prop + x Coord)
  (prop + width Coord)
  (prop + right _ (=> (+ x width)))
)

(type + (of TableColumn Row)
  (prop + id String (= ""))
  (prop + title String (= ""))
  (prop + column-width TableWidth (= (. TableWidth auto)))
  (prop + min-width Coord (= 0))
  (prop + max-width (? Coord))
  (prop + align TableAlign (= (. TableAlign left)))
  (prop + is-visible _ (= true))
  (prop + compare (? (of Comparer Row)))
  (prop + sort-key (? (of TableTextProvider Row)))
  (prop + value (? (of TableTextProvider Row)))
  (prop + is-sortable _ (=> (or (!= compare null) (!= sort-key null) (!= value null))))
  (fn-do + This _)
  (fn-do + This _
    (param title String)
    (= (. this title) title)
    (= id title)
  )
  (fn-expr + value-text String
    (param row Row)
    (case? provider
      (call provider row)
    )
    (default
      ""
    )
    (where
      (lazy provider value)
    )
  )
)

(type + (of TableHeaderRow Row) (is Box)
  (prop + table (? (of Table Row)))
  (content
    (<> This (• flex-row) (• h 1)
      (for (in metric (?? (?. #table #metrics) (call (of List (of TableColumnMetric Row)))) (keyed-by (. metric column id)))
        (<> Label (• w (. metric width))
          (= text
            (call table-aligned-text
              (block
                (arg
                  (call table-header-label
                    (block
                      (arg (. metric column))
                      (arg (?. #table #sort-column-id))
                      (arg (?. #table #sort-direction))
                    )
                  )
                )
                (arg (. metric width))
                (arg (. metric column align))
              )
            )
          )
          (= margin-right (if-expr (== (. metric column) (. (?. #table #visible-columns) tail)) 0 (?? (?. #table #column-gap) 0)))
        )
      )
    )
  )
  (subscribe-for (on event mouse-up)
    (let owner table)
    (if (and owner (call (. content-bounds contains) (. event point)))
      (let column (call (. owner column-at-x) (- (. event point x) (. owner scroll-x) (. content-bounds x))))
      (if column
        (call (. owner toggle-sort) column)
      )
      (call (. event cancel))
    )
  )
)

(fn-expr _ (of table-header-label Row) String
  (param column (of TableColumn Row))
  (param sort-column-id (? String))
  (param sort-direction TableSortDirection (= (. TableSortDirection none)))
  (+ (. column title) marker)
  (where
    (lazy marker
      (block
        (case? (!= sort-column-id (. column id))
          ""
        )
        (default
          (match sort-direction
            (case (. TableSortDirection ascending)
              " ↑"
            )
            (case (. TableSortDirection descending)
              " ↓"
            )
            (default
              ""
            )
          )
        )
      )
    )
  )
)

(type + (of TableCell Row) (is Box)
  (prop + item Row)
  (prop + column (of TableColumn Row))
  (prop + row (? (of TableRow Row)))
  (prop + column-width Coord)
  (prop + is-selected _ (= (?? (?. #row #is-selected) false)))
  (prop + text _ (= (call table-aligned-text (call (. #column value-text) #item) #column-width (. #column align))))
  (blank)
  (rule This
    (= min-width #column-width)
    (= max-width #column-width)
  )
)

(type + (of TableRow Row) (is ListItem)
  (prop + table (? (of Table Row)))
  (prop + item (? Row))
  (prop + row-handle (? TableRowHandle))
  (prop + row-key (? String))
  (prop _ claimed-row-key (? String))
  (fn-do + sync-row-key-handle _
    (return-if (if (== claimed-row-key row-key)))
    (blank)
    (let owner table)
    (let old-handle row-handle)
    (if (and owner old-handle)
      (let next-handle (call (. owner replace-row-handle) old-handle))
      (call (. ([] (. owner row-selection) old-handle) rekey) next-handle
        (block
          (on-error (: err Error)
            (throw (call Panic (. err message)))
          )
        )
      )
      (call (. ([] (. owner row-activation) old-handle) rekey) next-handle
        (block
          (on-error (: err Error)
            (throw (call Panic (. err message)))
          )
        )
      )
      (= row-handle next-handle)
      (call (. owner did-change-row-handle) this old-handle next-handle)
    )
    (= claimed-row-key row-key)
  )
  (whenever-rule #row-key
    (call sync-row-key-handle)
  )
  (fn-do _ claim-row-endpoints _ (?! Error)
    (param owner (of Table Row))
    (param claimed TableRowHandle)
    (for (on event ([] (. owner row-selection) claimed))
      (= is-selected (and (!= row-handle null) (== (. owner selected-row-handle) row-handle)))
    )
    (for (on event ([] (. owner row-activation) claimed))
      (= is-selected (and (!= row-handle null) (== (. owner selected-row-handle) row-handle)))
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (let owner table)
    (return-if (if (not owner)))
    (blank)
    (let claimed (call (. owner claim-row-handle)))
    (= row-handle claimed)
    (= claimed-row-key row-key)
    (call claim-row-endpoints owner claimed
      (block
        (on-error (: err Error)
          (throw (call Panic (. err message)))
        )
      )
    )
    (let selected (. owner selected-row))
    (if (and selected (== (as selected Pointer) (as this Pointer)))
      (= (. owner selected-row-handle) claimed)
      (= is-selected true)
    )
  )
  (fn-do + unmounted _
    (let owner table)
    (let claimed row-handle)
    (if (and owner claimed)
      (call (. owner did-unmount-row) this claimed)
      (call (. ([] (. owner row-selection) claimed) release))
      (call (. ([] (. owner row-activation) claimed) release))
      (call (. owner release-row-handle) claimed)
    )
    (= row-handle null)
    (= claimed-row-key null)
    (= is-selected false)
    (call (. super unmounted))
  )
)

(fn-expr _ (of table-column-min-width Row) Coord
  (param column (of TableColumn Row))
  (call max 0 (. column min-width))
)

(fn-expr _ (of table-column-flex Row) Float
  (param column (of TableColumn Row))
  (match (. column column-width)
    (case (call (. TableWidth flex) flex)
      (as flex Float)
    )
    (default
      0
    )
  )
)

(fn-do _ (of table-clamp-column-width Row) Coord
  (param column (of TableColumn Row))
  (param width Coord)
  (let result (call max (call table-column-min-width column) width))
  (if (. column max-width)
    (= result (call min result (. column max-width)))
  )
  (return result)
)

(fn-expr _ table-aligned-text String
  (param text String)
  (param width Coord)
  (param align TableAlign)
  (+ (* " " left-padding) text (* " " right-padding))
  (where
    (lazy display-width (as (. (call DisplayText text) display-width) Coord))
    (lazy padding (call max 0 (- width display-width)))
    (lazy left-padding
      (block
        (case? (== align (. TableAlign right))
          padding
        )
        (case? (== align (. TableAlign center))
          (/ padding 2)
        )
        (default
          0
        )
      )
    )
    (lazy right-padding (- padding left-padding))
  )
)
