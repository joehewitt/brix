+ flex-col = FlexLayout(Orientation.vertical)
+ flex-row = FlexLayout(Orientation.horizontal)
+ flow-col = FlowLayout(Orientation.vertical)
+ flow-row = FlowLayout(Orientation.horizontal)
+ masonry-col = MasonryLayout(Orientation.vertical)
+ masonry-row = MasonryLayout(Orientation.horizontal)

_ flex-scratch [Flex]
_ masonry-scratch-stack [MasonryScratch]

━━━━━━━━━━━━━━━━━━━━
+ LayoutArrangeHint is U8

| full = 0
| children-only = 1

