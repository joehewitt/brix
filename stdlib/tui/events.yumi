
./primitives
/ui/input

+ KeyEvent is TerminalEvent
+ DialogEvent is BoxEvent

━━━━━━━━━━━━━━━━━━━━
+ TerminalEvents is Union

| KeyPressEvent
| KeyInputEvent
| PasteEvent
| CursorEvent
| MouseDownEvent
| MouseUpEvent
| MouseMoveEvent
| MouseDragEvent
| ScrollEvent
| SizeRequestEvent
| UnknownEvent

────────────────────
+ This ~ Char TerminalEvents

~ \paste-start text \paste-text \paste-end
    PasteEvent(text)
~ \escape "[<" code I32 ";" x I32 ";" y I32 type \char
    mouse-event(Point((x - 1) as Coord, (y - 1) as Coord), code, type)
~ \escape "[8;" x I32 ";" y I32 "t"
    SizeRequestEvent(x, y)
~ \escape "[" row I32 ";" col I32 "R"
    CursorEvent(row, col)
~ \escape "[27;" modifiers I32 ";" code I32 "~"
    csi-u-event(code, modifiers)
~ \escape "[" code \csi-number? modifiers \csi-modifiers? final \csi-final
    csi-event(code ?? 1, modifiers ?? 1, final)
~ \escape "[" \csi-parameters? \csi-intermediates? \csi-final
    UnknownEvent()
~ \escape "O" final \csi-final
    csi-letter-event(final, 1)
~ \escape "b"
    (KeyPressEvent(Key.arrow-left, PointerModifiers(false, false, true)))
~ \escape "f"
    (KeyPressEvent(Key.arrow-right, PointerModifiers(false, false, true)))
~ \escape "B"
    option-shift-key(Key.arrow-left)
~ \escape "F"
    option-shift-key(Key.arrow-right)
~ \escape c \control-key
    control-key-event(c, true)
~ \escape c \option-char
    option-key-input(c)
~ \escape
    KeyPressEvent(Key.escape)
~ c \control-key
    control-key-event(c, false)
~ c \char
    char-event(c)

.. escape ~
    ~ "\x1b"
.. char Char ~
    ~ c .
        c[0]
.. paste-start ~
    ~ "\x1b[200~"
.. paste-end ~
    ~ "\x1b[201~"
.. paste-text String ~
    ~ chars \paste-char*
        Array(chars).slice-string()
.. paste-char Char ~
    ~ !(\paste-end) c .
        c[0]
.. csi-number I32 ~
    ~ number I32
        number
.. csi-modifiers I32 ~
    ~ ";" modifiers I32
        modifiers
.. csi-parameters ~
    ~ [0-?]+
.. csi-intermediates ~
    ~ [ -/]+
.. csi-final Char ~
    ~ [@-~]
        it[0]
.. control-key Char ~
    ~ c ("\t" | "\r" | "\n" | "\x7f")
        c[0]
.. option-char Char ~
    ~ !(\escape) c \char
        c

━━━━━━━━━━━━━━━━━━━━
+ FocusedInputEvent is KeyPressEvent || KeyInputEvent || PasteEvent

━━━━━━━━━━━━━━━━━━━━
+ PointerEvent is MouseDownEvent || MouseUpEvent || MouseMoveEvent || MouseDragEvent || ScrollEvent

━━━━━━━━━━━━━━━━━━━━
+ BoxEventRouteNext is () Pointer?
    - event Pointer
    - current Pointer

━━━━━━━━━━━━━━━━━━━━
+ BoxEventRouteState is Tuple

+ next BoxEventRouteNext?
+ root Pointer?
+ boundary Pointer?
+ route-point Point
+ offset Point
+ point Point

━━━━━━━━━━━━━━━━━━━━
+ BoxEvent

+ is-canceled = false
+ route-root Pointer?
+ route-boundary Pointer?
+ route-offset Point

_ event-route-next BoxEventRouteNext?
_ event-route-point Point
_ event-point Point

────────────────────
+ get has-own-route Bool

if event-route-next then true else false

────────────────────
+ do cancel

is-canceled = true

────────────────────
+ do begin-route BoxEventRouteState
    - next BoxEventRouteNext
    - root Pointer
    - root-point Point
    - offset Point
    - boundary Pointer?

. old-next = event-route-next
. old-root = route-root
. old-boundary = route-boundary
. old-route = event-route-point
. old-offset = route-offset
. old-point = event-point
. saved = BoxEventRouteState(old-next, old-root, old-boundary, old-route, old-offset, old-point)
event-route-next = next
route-root = root
route-boundary = boundary
event-route-point = root-point
event-point = Point(root-point.x - offset.x, root-point.y - offset.y)
route-offset = offset
= saved

────────────────────
+ do end-route
    - saved BoxEventRouteState

event-route-next = saved.next
route-root = saved.root
route-boundary = saved.boundary
event-route-point = saved.route-point
route-offset = saved.offset
event-point = saved.point

────────────────────
+ do advance-route
    - offset Point

event-point = Point(event-route-point.x - offset.x, event-route-point.y - offset.y)
route-offset = offset

────────────────────
+ do next-event-owner Pointer?
    - current Pointer

=? if !event-route-next
= event-route-next(this as Pointer, current)

