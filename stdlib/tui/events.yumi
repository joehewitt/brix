━━━━━━━━━━━━━━━━━━━━
_ csi-event TerminalEvents
    - code I32
    - modifiers I32
    - final Char

match final
    |= '~'
        csi-tilde-event(code, modifiers)
    |= 'u'
        csi-u-event(code, modifiers)
    |= 'Z'
        (KeyPressEvent(Key.tab, PointerModifiers(true))) as TerminalEvents
    ??
        csi-letter-event(final, modifiers)

━━━━━━━━━━━━━━━━━━━━
_ csi-letter-event TerminalEvents
    - final Char
    - modifiers I32

|? key
    key-press-event(key, modifiers)
??
    UnknownEvent() as TerminalEvents

.. key = csi-letter-key(final)

━━━━━━━━━━━━━━━━━━━━
_ csi-letter-key Key?
    - final Char

match? final
    |= 'A'
        Key.arrow-up
    |= 'B'
        Key.arrow-down
    |= 'C'
        Key.arrow-right
    |= 'D'
        Key.arrow-left
    |= 'H'
        Key.home
    |= 'F'
        Key.end
    |= 'P'
        Key.function-key(1)
    |= 'Q'
        Key.function-key(2)
    |= 'R'
        Key.function-key(3)
    |= 'S'
        Key.function-key(4)

━━━━━━━━━━━━━━━━━━━━
_ csi-tilde-event TerminalEvents
    - code I32
    - modifiers I32

|? key
    key-press-event(key, modifiers)
??
    UnknownEvent() as TerminalEvents

.. key = csi-tilde-key(code)

━━━━━━━━━━━━━━━━━━━━
_ csi-tilde-key Key?
    - code I32

match? code
    |= 1
        Key.home
    |= 3
        Key.delete
    |= 4
        Key.end
    |= 5
        Key.page-up
    |= 6
        Key.page-down
    |= 7
        Key.home
    |= 8
        Key.end
    |? code >= 11 && code <= 15
        Key.function-key((code - 10) as U32)
    |? code >= 17 && code <= 21
        Key.function-key((code - 11) as U32)
    |= 23
        Key.function-key(11)
    |= 24
        Key.function-key(12)
    |= 25
        Key.function-key(13)
    |= 26
        Key.function-key(14)
    |= 28
        Key.function-key(15)
    |= 29
        Key.function-key(16)

━━━━━━━━━━━━━━━━━━━━
_ csi-u-event TerminalEvents
    - code I32
    - modifiers I32

|? key
    key-press-event(key, modifiers)
|? code > 32 && code < 0x110000
    (KeyInputEvent(code as Char, xterm-modifiers(modifiers))) as TerminalEvents
|? code == 32
    (KeyInputEvent(' ', xterm-modifiers(modifiers))) as TerminalEvents
??
    UnknownEvent() as TerminalEvents

.. key = csi-u-key(code)

━━━━━━━━━━━━━━━━━━━━
_ csi-u-key Key?
    - code I32

match? code
    |= 9
        Key.tab
    |= 13
        Key.enter
    |= 27
        Key.escape
    |= 127
        Key.backspace

━━━━━━━━━━━━━━━━━━━━
_ key-press-event TerminalEvents
    - key Key
    - modifiers I32

KeyPressEvent(key, xterm-modifiers(modifiers))

━━━━━━━━━━━━━━━━━━━━
_ xterm-modifiers PointerModifiers
    - modifiers I32

PointerModifiers(bits % 2 == 1, (bits / 4) % 2 == 1, (bits / 2) % 2 == 1, (bits / 8) % 2 == 1)

.. bits = if modifiers > 1 then modifiers - 1 else 0

━━━━━━━━━━━━━━━━━━━━
_ control-key-event TerminalEvents
    - char Char
    - option Bool

match char
    |= '\t'
        (KeyPressEvent(Key.tab, PointerModifiers(false, false, option))) as TerminalEvents
    |= '\r'
        (KeyPressEvent(Key.enter, PointerModifiers(false, false, option))) as TerminalEvents
    |= '\n'
        (KeyInputEvent('j', PointerModifiers(false, true, option))) as TerminalEvents
    ??
        (KeyPressEvent(Key.backspace, PointerModifiers(false, false, option))) as TerminalEvents

━━━━━━━━━━━━━━━━━━━━
_ char-event TerminalEvents
    - char Char

|? char == 0 as Char
    (KeyInputEvent(' ', PointerModifiers(false, true))) as TerminalEvents
|? char < ' '
    (KeyInputEvent((char + 0x60) as Char, PointerModifiers(false, true))) as TerminalEvents
|? char >= 'A' && char <= 'Z'
    (KeyInputEvent(char, PointerModifiers(true))) as TerminalEvents
??
    (KeyInputEvent(char)) as TerminalEvents

━━━━━━━━━━━━━━━━━━━━
_ option-shift-key TerminalEvents
    - key Key

KeyPressEvent(key, PointerModifiers(true, false, true))

━━━━━━━━━━━━━━━━━━━━
_ option-key-input TerminalEvents
    - char Char

KeyInputEvent(char, PointerModifiers(char >= 'A' && char <= 'Z', false, true))

━━━━━━━━━━━━━━━━━━━━
_ do mouse-event TerminalEvents
    - point Point
    - code I32
    - type Char

. base = code % 4
. button = mouse-button(code)
if (code / 64) % 2 == 1
    . scroll = ScrollEvent(point, scroll-direction(base, (code / 4) % 2 == 1))
    apply-mouse-modifiers(scroll, code)
    = scroll
if (code / 32) % 2 == 1
    if base == 3
        . move = MouseMoveEvent(point)
        apply-mouse-modifiers(move, code)
        = move
    . drag = MouseDragEvent(point, button)
    apply-mouse-modifiers(drag, code)
    = drag
if type == 'M'
    . down = MouseDownEvent(point, button)
    apply-mouse-modifiers(down, code)
    = down
if type == 'm'
    . up = MouseUpEvent(point, button)
    apply-mouse-modifiers(up, code)
    = up
= UnknownEvent()

━━━━━━━━━━━━━━━━━━━━
_ mouse-button PointerButton
    - code I32

match code % 4
    |? (code / 128) % 2 == 1
        PointerButton.other((code % 4 + 3) as U32)
    |= 1
        PointerButton.middle
    |= 2
        PointerButton.secondary
    ??
        PointerButton.primary

━━━━━━━━━━━━━━━━━━━━
_ scroll-direction Direction
    - base I32
    - shift Bool

match base
    |= 0
        if shift then Direction.left else Direction.up
    |= 1
        if shift then Direction.right else Direction.down
    |= 2
        Direction.left
    ??
        Direction.right

━━━━━━━━━━━━━━━━━━━━
_ do apply-mouse-modifiers
    - event MouseEvent
    - code I32

event.modifiers = PointerModifiers((code / 4) % 2 == 1, (code / 16) % 2 == 1, (code / 8) % 2 == 1)
