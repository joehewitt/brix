────────────────────
for event on mouse-up

. row = row-at(event.point)
if row
    this.select-row(row)
    interacted <- true

────────────────────
whenever children ListItem

. row = selected-row
if row && !valid-row(row)
    row.is-selected = false
    selected-row = null

────────────────────
+ do can-scroll Bool
    - direction Direction

=? if direction == Direction.left
=? if direction == Direction.right

. next = scroll-point(1, direction)
= next.x != scroll-x || next.y != scroll-y

────────────────────
+ do reveal-focus

. row = valid-row(selected-row)
if row
    row.reveal-in-ancestors(row.bounds)
else
    super.reveal-focus()

────────────────────
+ get previous-row

|? !selected-row
    last-row
|? index && index > 0
    row-at-index(index - 1)
??
    null

.. index = selected-index

────────────────────
+ get next-row

|? !selected-row
    first-row
|? index
    row-at-index(index + 1)
??
    null

.. index = selected-index

────────────────────
+ get first-row

selectable-rows() |> first

────────────────────
+ get last-row

selectable-rows() |> last

────────────────────
+ get selected-index Index?

** selectable-rows()
|> indexed
?*> each[0] if each[1] == selected-row
|> first

────────────────────
+ get selectable-row-count Index

selectable-rows() |> count

────────────────────
+ get page-row-step Int

max(1, (content-bounds.height as Int))

