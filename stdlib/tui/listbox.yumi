interacted <- true

────────────────────
_ do interact-activate-selection

activate-selection()
interacted <- true

────────────────────
+ do select-relative
    - direction Direction

. next = relative-row(direction)
if next
    this.select-row(next)
else
    ensure-selection-visible()

────────────────────
+ do select-page
    - direction Direction

. step = page-row-step
. offset = if direction == Direction.up then -step else step
. target = ListCursor(selectable-row-count, selected-index).clamped(offset)
this.select-row(row-at-index(target) if target != null)

────────────────────
+ do select-first-row

this.select-row(first-row)

────────────────────
+ do select-last-row

this.select-row(last-row)

────────────────────
+ do select-row ?! Error
    - row ListItem?

. live-row = valid-row(row)
if selected-row == live-row
    if live-row
        ensure-row-visible(live-row)
else
    . old = selected-row
    if old
        old.is-selected = false

    selected-row = live-row
    if live-row
        live-row.is-selected = true
        ensure-row-visible(live-row)

    selected <- SelectEvent()

────────────────────
+ do activate-selection ?! Error

ensure-selection()

activated <- ActivateEvent()

────────────────────
+ do ensure-selection

. row = valid-row(selected-row)
if row
    if !row.is-selected
        row.is-selected = true
    ensure-row-visible(row)
    =

────────────────────
+ do ensure-selection-visible

. row = valid-row(selected-row)
if row
    ensure-row-visible(row)

────────────────────
+ relative-row
    - direction Direction

match direction
    |= Direction.up
        previous-row
    ??
        next-row

────────────────────
+ row-at-index
    - target Index

** selectable-rows()
|> indexed
?*> each[1] if each[0] == target
|> first

────────────────────
+ do row-at
    - point Point

=? if !content-bounds.contains(point)

. row = hit-test(point).ancestor-or-self'ListItem
if row
    = valid-row(row)

────────────────────
+ selectable-rows @inline

** active-children
?*> selectable-row(each)

────────────────────
+ do selectable-row ListItem? @inline
    - node Box

if node is ListItem && node.is-effectively-enabled && node.$display == .visible
    = node as ListItem

────────────────────
+ do valid-row
    - row ListItem?

=? selectable-row(row)
    if row && row.ancestor'ListBox == this

────────────────────
+ do ensure-row-visible
    - row ListItem

. visible = content-bounds
if visible.height <= 0
    if scroll-y != 0
        scroll((scroll-x, 0))
    =
. next = scroll-y
if row.bounds.y + next < visible.y
    next = visible.y - row.bounds.y
else if row.bounds.bottom + next > visible.bottom
    next = visible.bottom - row.bounds.bottom

next = clipped-scroll-y(next)
if next != scroll-y
    scroll((scroll-x, next))

