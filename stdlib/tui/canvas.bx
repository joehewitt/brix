(import /math)
(import /units)
(import /graphics/color)
(import /data/stream)
(import ./colors)
(import ./primitives)
(blank)
(prop _ default-text-color _ (= white))
(prop _ default-background _ (= (call terminal-background-default)))
(prop _ terminal-background-ansi-tag U32 (= (/lshift/ 1u32 24)))
(prop _ terminal-background-rgb-tag U32 (= (/lshift/ 2u32 24)))
(prop _ terminal-background-kind-mask U32 (= (/lshift/ 255u32 24)))
(prop _ layer-coverage-background U8 (= 1))
(prop _ layer-coverage-text U8 (= 2))
(prop _ layer-coverage-all U8 (= 3))
(prop _ escape-reset-bytes _ (= (call byte-view "\x1b[0m")))
(prop _ escape-csi-bytes _ (= (call byte-view "\x1b[")))
(prop _ escape-fg-ansi-prefix-bytes _ (= (call byte-view "\x1b[38;5;")))
(prop _ escape-bg-default-bytes _ (= (call byte-view "\x1b[49m")))
(prop _ escape-bg-ansi-prefix-bytes _ (= (call byte-view "\x1b[48;5;")))
(prop _ escape-bg-rgb-prefix-bytes _ (= (call byte-view "\x1b[48;2;")))
(prop _ escape-semicolon-bytes _ (= (call byte-view ";")))
(prop _ escape-cursor-suffix-bytes _ (= (call byte-view "H")))
(prop _ escape-sgr-suffix-bytes _ (= (call byte-view "m")))
(blank)
(type-line + TerminalBackground (is U32))

(type + Canvas
  (prop + width Coord (= 0))
  (prop + height Coord (= 0))
  (blank)
  (prop _ state _ (= (call State)))
  (prop _ spare-state (? State))
  (prop _ text-buffer _ (= ([] Char 0)))
  (prop _ display-width-buffer _ (= ([] U8 0)))
  (prop _ row-non-single-display-counts _ (= ([] Size 0)))
  (prop _ fg-buffer _ (= ([] AnsiColor 0)))
  (prop _ bg-buffer _ (= ([] TerminalBackground 0)))
  (prop _ coverage-buffer _ (= ([] U8 0)))
  (prop _ has-transparent-cells _ (= false))
  (fn-do + This _
    (param size PSize)
    (param is-transparent _ (= false))
    (throw (call Panic "canvas size must not be negative") (if (or (< (. size width) 0) (< (. size height) 0))))
    (blank)
    (let length (* (as (. size width) Size) (. size height)))
    (blank)
    (= width (. size width))
    (= height (. size height))
    (= has-transparent-cells is-transparent)
    (blank)
    ;  //this:create -> width, height
    (= text-buffer ([] Char length))
    (= ([] text-buffer (... 0)) (char " "))
    (blank)
    (= display-width-buffer ([] U8 length))
    (= ([] display-width-buffer (... 0)) 1)
    (blank)
    (= row-non-single-display-counts ([] Size height))
    (= ([] row-non-single-display-counts (... 0)) 0)
    (blank)
    (= fg-buffer ([] AnsiColor length))
    (= ([] fg-buffer (... 0)) default-text-color)
    (blank)
    (= bg-buffer ([] TerminalBackground length))
    (= ([] bg-buffer (... 0)) default-background)
    (blank)
    (if has-transparent-cells
      (= coverage-buffer ([] U8 length))
      (= ([] coverage-buffer (... 0)) 0)
    )
  )
  (fn-expr + background _ :get
    (. state background)
  )
  (fn-do + text-color _ :set (param color AnsiColor)
    (= (. state text-color) color)
  )
  (fn-do + background _ :set (param value (? BackgroundColor))
    (= (. state background) value)
  )
  (fn-do + reset _
    (= (. state text-color) default-text-color)
    (= (. state background) null)
    (= (. state cursor-x) 0)
    (= (. state cursor-y) 0)
    (= (. state offset-x) 0)
    (= (. state offset-y) 0)
    (= (. state clip) null)
    (= (. state previous) null)
    (blank)
    (= ([] text-buffer (... 0)) (char " "))
    (= ([] display-width-buffer (... 0)) 1)
    (= ([] row-non-single-display-counts (... 0)) 0)
    (= ([] fg-buffer (... 0)) default-text-color)
    (= ([] bg-buffer (... 0)) default-background)
    (if has-transparent-cells
      (= ([] coverage-buffer (... 0)) 0)
    )
  )
  (fn-do + push _
    (let previous state)
    (let next (?? spare-state (call State)))
    (= spare-state (. next previous))
    (call (. next assign) previous)
    (= (. next previous) previous)
    (= state next)
  )
  (fn-do + pop _
    (let popped state)
    (= state (!! (. popped previous)))
    (= (. popped previous) spare-state)
    (= spare-state popped)
  )
  (fn-do + paint-background _
    (param value BackgroundColor)
    (param rect Rect)
    (do-use this
      (= background value)
      (call fill rect)
    )
  )
  (fn-do + paint-background-cell _
    (param value BackgroundColor)
    (param point Point)
    (let x (+ (. state offset-x) (. point x)))
    (let y (+ (. state offset-y) (. point y)))
    (blank)
    (return-if (if (< x 0)))
    (return-if (if (>= x width)))
    (return-if (if (< y 0)))
    (return-if (if (>= y height)))
    (blank)
    (if (. state clip)
      (let clip (. state clip))
      (return-if (if (< x (. clip x))))
      (return-if (if (>= x (. clip right))))
      (return-if (if (< y (. clip y))))
      (return-if (if (>= y (. clip bottom))))
    )
    (blank)
    (let cell (call get-pointer bg-buffer x y))
    (if cell
      (call paint-background-cell-buffer value cell)
      (call mark-coverage-cell x y layer-coverage-background)
    )
  )
  (fn-do + move _
    (param point Point)
    (= (. state cursor-x) (. point x))
    (= (. state cursor-y) (. point y))
  )
  (fn-do + move-by _
    (param offset Point)
    (+= (. state cursor-x) (. offset x))
    (+= (. state cursor-y) (. offset y))
  )
  (fn-do + offset _
    (param offset Point)
    (+= (. state offset-x) (. offset x))
    (+= (. state offset-y) (. offset y))
  )
  (fn-do + is-rect-visible Bool
    (param rect Rect)
    (return-if false (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (blank)
    (let left (call max 0 (+ (. state offset-x) (. rect x))))
    (let top (call max 0 (+ (. state offset-y) (. rect y))))
    (let right (call min width (+ (. state offset-x) (. rect right))))
    (let bottom (call min height (+ (. state offset-y) (. rect bottom))))
    (if (. state clip)
      (let clip (. state clip))
      (= left (call max left (. clip x)))
      (= top (call max top (. clip y)))
      (= right (call min right (. clip right)))
      (= bottom (call min bottom (. clip bottom)))
    )
    (return (and (< left right) (< top bottom)))
  )
  (fn-do + clip _
    (param bounds Rect)
    (let next (call Rect (+ (. state offset-x) (. bounds x)) (+ (. state offset-y) (. bounds y)) (. bounds width) (. bounds height)))
    (if (. state clip)
      (let current (. state clip))
      (let left (call max (. current x) (. next x)))
      (let top (call max (. current y) (. next y)))
      (let right (call max left (call min (. current right) (. next right))))
      (let bottom (call max top (call min (. current bottom) (. next bottom))))
      (= (. state clip) (call Rect left top (- right left) (- bottom top)))
      (else
        (= (. state clip) next)
      )
    )
  )
  (fn-do + fill _
    (param rect Rect)
    (let (tuple min-x min-y max-x max-y)
      (block
        (call get-content-bounds (tuple (. rect x) (. rect y) (. rect width) (. rect height)))
      )
    )
    (blank)
    (return-if (if (< min-y 0)))
    (return-if (if (> min-y height)))
    (return-if (if (<= max-x 0)))
    (return-if (if (<= max-y min-y)))
    (blank)
    (return-if (if (not (. state background))))
    (blank)
    (let background (. state background))
    (for (in y (..< min-y max-y))
      (call paint-background-run background (call get-pointer bg-buffer min-x y) max-x)
      (if (not has-transparent-cells)
        (call clear-display-run min-x y max-x)
      )
      (call mark-coverage-run min-x y max-x layer-coverage-background)
    )
  )
  (fn-do + print _
    (param text String)
    ; XXXjoe Problems will arise if text has line breaks in it
    (call print-single-width-text text (. text length))
  )
  (fn-do + print-display-text _
    (param text DisplayText)
    (if (. text is-single-cell)
      (call print-single-width-text (. text text) (. text codepoint-count))
      (return)
    )
    (let (tuple min-x min-y max-x max-y)
      (block
        (call get-content-bounds (tuple (. state cursor-x) (. state cursor-y) (as (. text display-width) Coord) 1))
      )
    )
    (blank)
    (return-if (if (< min-y 0)))
    (return-if (if (>= min-y height)))
    (return-if (if (<= max-x 0)))
    (return-if (if (<= max-y min-y)))
    (blank)
    ;  //this:print -> min-y, text
    (let text-x (+ (. state offset-x) (. state cursor-x)))
    (let end-x (+ min-x max-x))
    (let x text-x)
    (let char-index 0)
    (blank)
    (call clear-display-run min-x min-y max-x)
    (if (. state background)
      (call paint-background-run (. state background) (call get-pointer bg-buffer min-x min-y) max-x)
      (call mark-coverage-run min-x min-y max-x layer-coverage-background)
    )
    (blank)
    (for (in char (. text text))
      (let char-width (as (call (. text width-at) char-index) Coord))
      (+= char-index 1)
      (if (<= char-width 0)
        (continue)
      )
      (blank)
      (let next-x (+ x char-width))
      (if (<= next-x min-x)
        (= x next-x)
        (continue)
      )
      (if (or (< x min-x) (> next-x end-x))
        (= x next-x)
        (continue)
      )
      (blank)
      (call paint-display-cell char x min-y char-width)
      (= x next-x)
    )
  )
  (fn-do + copy _
    (param source Canvas)
    (call copy (call Rect 0 0 width height) source)
  )
  (fn-do + copy _
    (param rect Rect)
    (param source Canvas)
    (let right-limit (call min width (. source width)))
    (let bottom-limit (call min height (. source height)))
    (let (tuple min-x max-x) (call clip (. rect x) (. rect right) 0 right-limit))
    (let (tuple min-y max-y) (call clip (. rect y) (. rect bottom) 0 bottom-limit))
    (blank)
    (return-if (if (<= max-x min-x)))
    (return-if (if (<= max-y min-y)))
    (blank)
    (for (in y (..< min-y max-y))
      (let count (- max-x min-x))
      (let source-index (call (. source buffer-index) min-x y))
      (let target-index (call buffer-index min-x y))
      (for (in x (..< 0 count))
        (= ([] text-buffer (+ target-index x)) ([] (. source text-buffer) (+ source-index x)))
        (call set-display-width-cell (+ target-index x) y ([] (. source display-width-buffer) (+ source-index x)))
        (= ([] fg-buffer (+ target-index x)) ([] (. source fg-buffer) (+ source-index x)))
        (= ([] bg-buffer (+ target-index x)) ([] (. source bg-buffer) (+ source-index x)))
        (if has-transparent-cells
          (= ([] coverage-buffer (+ target-index x))
            (block
              (case? (. source has-transparent-cells)
                ([] (. source coverage-buffer) (+ source-index x))
              )
              (default
                layer-coverage-all
              )
            )
          )
        )
      )
    )
  )
  (fn-do + composite _
    (param source Canvas)
    (param rect Rect)
    (param point Point)
    (param opacity Ratio)
    (let alpha (call clamped-opacity opacity))
    (return-if (if (<= alpha 0%%)))
    (blank)
    (let left (call max (. rect x) (. point x)))
    (let top (call max (. rect y) (. point y)))
    (let right (call min (. rect right) (+ (. point x) (. source width))))
    (let bottom (call min (. rect bottom) (+ (. point y) (. source height))))
    (return-if (if (or (<= right left) (<= bottom top))))
    (blank)
    (let (tuple min-x min-y span-x max-y)
      (block
        (call get-content-bounds (tuple left top (- right left) (- bottom top)))
      )
    )
    (blank)
    (return-if (if (<= span-x 0)))
    (return-if (if (<= max-y min-y)))
    (blank)
    (let max-x (+ min-x span-x))
    (let origin-x (+ (. state offset-x) (. point x)))
    (let origin-y (+ (. state offset-y) (. point y)))
    (for (in y (..< min-y max-y))
      (for (in x (..< min-x max-x))
        (let source-x (- x origin-x))
        (let source-y (- y origin-y))
        (let source-index (call (. source buffer-index) source-x source-y))
        (let target-index (call buffer-index x y))
        (let coverage
          (block
            (case? (. source has-transparent-cells)
              ([] (. source coverage-buffer) source-index)
            )
            (default
              layer-coverage-all
            )
          )
        )
        (blank)
        (if (== coverage 0)
          (continue)
        )
        (blank)
        (let paints-background (!= (/and/ coverage layer-coverage-background) 0))
        (let paints-text (!= (/and/ coverage layer-coverage-text) 0))
        (blank)
        (if paints-background
          (let layer-background (call terminal-background-rgba ([] (. source bg-buffer) source-index)))
          (let target-background (call terminal-background-rgba ([] bg-buffer target-index)))
          (let blended-background
            (call blend-rgba-opacity
              (block
                (arg layer-background)
                (arg target-background)
                (arg alpha)
              )
            )
          )
          (= ([] bg-buffer target-index) (call terminal-background-rgb blended-background))
          (if (not paints-text)
            (= ([] fg-buffer target-index)
              (call blend-ansi-over-rgba
                (block
                  (arg ([] fg-buffer target-index))
                  (arg layer-background)
                  (arg alpha)
                )
              )
            )
          )
        )
        (blank)
        (if paints-text
          (= ([] text-buffer target-index) ([] (. source text-buffer) source-index))
          (call set-display-width-cell target-index y ([] (. source display-width-buffer) source-index))
          (= ([] fg-buffer target-index)
            (call blend-ansi-over-ansi
              (block
                (arg ([] (. source fg-buffer) source-index))
                (arg ([] fg-buffer target-index))
                (arg alpha)
              )
            )
          )
        )
      )
    )
  )
  (fn-do + dump _
    (return (call dump-rows false))
  )
  (fn-do + dump-lines _
    (return (call dump-rows true))
  )
  (fn-expr + dump _
    (param out _)
    (<- out (call dump))
  )
  (fn-do + dump-diff String
    (param previous Canvas)
    (let out (call (of DataStream Byte) 4096))
    (call (. out reset))
    (call dump-diff out previous)
    (return (call (. out data slice-string) (..< 0 (. out length))))
  )
  (fn-do + dump-diff _
    (param out _)
    (param previous Canvas)
    (let did-write false)
    (let scratch ([] Byte 16))
    (blank)
    (for (in y (..< 0 height))
      (let changed-start width)
      (let changed-end Coord 0)
      (for (in x (..< 0 width))
        (if (not (call is-same-cell (tuple x y) previous))
          (if (== changed-start width)
            (= changed-start x)
          )
          (= changed-end (+ x 1))
        )
      )
      (blank)
      (if (< changed-start changed-end)
        (let start (call min (call display-span-start changed-start y) (call (. previous diff-span-start) changed-start y)))
        (let end (call max (call display-span-end changed-end y) (call min (call (. previous diff-span-end) changed-end y) width)))
        (call dump-row-span-to out y start end scratch)
        (= did-write true)
      )
    )
    (blank)
    (if did-write
      (call write-bytes-to out escape-reset-bytes)
    )
  )
  (fn-do + begin-using _
    (call push)
    (return this)
  )
  (fn-do + end-using _
    (call pop)
  )
  (fn-do _ dump-rows String
    (param as-lines Bool)
    (return-if "\x1b[0m" (if (<= width 0)))
    (blank)
    (let frame "")
    (blank)
    (probe-group +- tui.canvas (text: "dump"))
    (blank)
    (for (in y (..< 0 height))
      (let start 0)
      (let current-fg default-text-color)
      (let current-bg default-background)
      (let text-ptr (!! (call get-pointer text-buffer 0 y)))
      (let display-width-ptr (!! (call get-pointer display-width-buffer 0 y)))
      (let has-non-single-display-cells (!= ([] row-non-single-display-counts y) 0))
      (let fg-ptr (!! (call get-pointer fg-buffer 0 y)))
      (let bg-ptr (!! (call get-pointer bg-buffer 0 y)))
      (if (not as-lines)
        (+= frame (str "\x1b[0m\x1b[" (+ y 1) ";1H"))
        (else-if (== y 0)
          (+= frame "\x1b[0m")
        )
        (else
          (+= frame "\x1b[0m\n")
        )
      )
      (+= frame (call escape-fg default-text-color))
      (blank)
      (probe-group +- tui.canvas (text: "row " y))
      (for (in x (..< 0 width))
        (let cell-fg ([] fg-ptr x))
        (if (!= cell-fg current-fg)
          (probe-log tui.canvas.fg-run (items: start x ([] text-ptr (..< start x))))
          (+= frame
            (call display-text-run
              (block
                (arg text-ptr)
                (arg display-width-ptr)
                (arg (as start Coord))
                (arg x)
                (arg has-non-single-display-cells)
              )
            )
          )
          (= start x)
          (blank)
          (probe-log tui.canvas.fg (text: "cell-fg"))
          (+= frame (call escape-fg cell-fg))
          (= current-fg cell-fg)
        )
        (blank)
        (let cell-bg ([] bg-ptr x))
        (if (!= cell-bg current-bg)
          (probe-log tui.canvas.bg-run (items: y start x ([] text-ptr (..< start x))))
          (+= frame
            (call display-text-run
              (block
                (arg text-ptr)
                (arg display-width-ptr)
                (arg (as start Coord))
                (arg x)
                (arg has-non-single-display-cells)
              )
            )
          )
          (= start x)
          (blank)
          (probe-log tui.canvas.bg (text: "cell-bg"))
          (+= frame (call escape-bg cell-bg))
          (= current-bg cell-bg)
        )
      )
      (blank)
      (let line
        (call display-text-run
          (block
            (arg text-ptr)
            (arg display-width-ptr)
            (arg (as start Coord))
            (arg width)
            (arg has-non-single-display-cells)
          )
        )
      )
      (probe-log tui.canvas.text (items: y (. line length) start width ([] text-ptr (..< start width))))
      (+= frame line)
    )
    (blank)
    (+= frame "\x1b[0m")
    (return frame)
  )
  (fn-do _ print-single-width-text _
    (param text String)
    (param display-width Size)
    (let (tuple min-x min-y max-x max-y)
      (block
        (call get-content-bounds (tuple (. state cursor-x) (. state cursor-y) (as display-width Coord) 1))
      )
    )
    (blank)
    (return-if (if (< min-y 0)))
    (return-if (if (>= min-y height)))
    (return-if (if (<= max-x 0)))
    (return-if (if (<= max-y min-y)))
    (blank)
    ;  //this:print -> min-y, text
    (let text-x (+ (. state offset-x) (. state cursor-x)))
    (let source-start (if-expr (< text-x min-x) (- min-x text-x) 0))
    (blank)
    (call clear-display-run min-x min-y max-x)
    (blank)
    (let text-ptr (call get-pointer text-buffer min-x min-y))
    (if text-ptr
      (let row text-ptr)
      (for (in i (..< 0 max-x))
        (= ([] row i) ([] text (+ source-start i)))
      )
    )
    (blank)
    (let fg-ptr (call get-pointer fg-buffer min-x min-y))
    (= (?[] fg-ptr (..< 0 max-x)) (. state text-color))
    (blank)
    (call mark-coverage-run min-x min-y max-x layer-coverage-text)
    (if (. state background)
      (call paint-background-run (. state background) (call get-pointer bg-buffer min-x min-y) max-x)
      (call mark-coverage-run min-x min-y max-x layer-coverage-background)
    )
  )
  (fn-do _ is-same-cell _
    (param point Point)
    (param previous Canvas)
    (return-if (if (>= (. point x) (. previous width))))
    (return-if (if (>= (. point y) (. previous height))))
    (blank)
    (let index (call buffer-index (. point x) (. point y)))
    (let previous-index (call (. previous buffer-index) (. point x) (. point y)))
    (blank)
    (return-if (if (!= ([] text-buffer index) ([] (. previous text-buffer) previous-index))))
    (return-if (if (!= ([] display-width-buffer index) ([] (. previous display-width-buffer) previous-index))))
    (return-if (if (!= ([] fg-buffer index) ([] (. previous fg-buffer) previous-index))))
    (blank)
    (return (== ([] bg-buffer index) ([] (. previous bg-buffer) previous-index)))
  )
  (fn-do _ dump-row-span-to _
    (param out _)
    (param y Coord)
    (param start Coord)
    (param end Coord)
    (param scratch ([] Byte))
    (call write-row-position-to out y start scratch)
    (call write-fg-to out default-text-color scratch)
    (let current-fg default-text-color)
    (let current-bg default-background)
    (let run-start start)
    (let text-ptr (!! (call get-pointer text-buffer 0 y)))
    (let display-width-ptr (!! (call get-pointer display-width-buffer 0 y)))
    (let has-non-single-display-cells (!= ([] row-non-single-display-counts y) 0))
    (let fg-ptr (!! (call get-pointer fg-buffer 0 y)))
    (let bg-ptr (!! (call get-pointer bg-buffer 0 y)))
    (blank)
    (for (in x (..< start end))
      (let cell-fg ([] fg-ptr x))
      (if (!= cell-fg current-fg)
        (call write-char-run-to
          (block
            (arg out)
            (arg text-ptr)
            (arg display-width-ptr)
            (arg run-start)
            (arg x)
            (arg has-non-single-display-cells)
            (arg scratch)
          )
        )
        (= run-start x)
        (blank)
        (call write-fg-to out cell-fg scratch)
        (= current-fg cell-fg)
      )
      (blank)
      (let cell-bg ([] bg-ptr x))
      (if (!= cell-bg current-bg)
        (call write-char-run-to
          (block
            (arg out)
            (arg text-ptr)
            (arg display-width-ptr)
            (arg run-start)
            (arg x)
            (arg has-non-single-display-cells)
            (arg scratch)
          )
        )
        (= run-start x)
        (blank)
        (call write-bg-to out cell-bg scratch)
        (= current-bg cell-bg)
      )
    )
    (blank)
    (call write-char-run-to
      (block
        (arg out)
        (arg text-ptr)
        (arg display-width-ptr)
        (arg run-start)
        (arg end)
        (arg has-non-single-display-cells)
        (arg scratch)
      )
    )
  )
  (fn-do _ write-row-position-to _
    (param out _)
    (param y Coord)
    (param x Coord)
    (param scratch ([] Byte))
    (call write-bytes-to out escape-reset-bytes)
    (call write-bytes-to out escape-csi-bytes)
    (call write-uint-to out (as (+ y 1) U32) scratch)
    (call write-bytes-to out escape-semicolon-bytes)
    (call write-uint-to out (as (+ x 1) U32) scratch)
    (call write-bytes-to out escape-cursor-suffix-bytes)
  )
  (fn-do _ write-fg-to _
    (param out _)
    (param color AnsiColor)
    (param scratch ([] Byte))
    (call write-bytes-to out escape-fg-ansi-prefix-bytes)
    (call write-uint-to out color scratch)
    (call write-bytes-to out escape-sgr-suffix-bytes)
  )
  (fn-do _ write-bg-to _
    (param out _)
    (param color TerminalBackground)
    (param scratch ([] Byte))
    (if (== color default-background)
      (call write-bytes-to out escape-bg-default-bytes)
      (return)
    )
    (if (== kind terminal-background-ansi-tag)
      (call write-bytes-to out escape-bg-ansi-prefix-bytes)
      (call write-uint-to out (/and/ color 255) scratch)
      (call write-bytes-to out escape-sgr-suffix-bytes)
      (return)
    )
    (call write-bytes-to out escape-bg-rgb-prefix-bytes)
    (call write-uint-to out r scratch)
    (call write-bytes-to out escape-semicolon-bytes)
    (call write-uint-to out g scratch)
    (call write-bytes-to out escape-semicolon-bytes)
    (call write-uint-to out b scratch)
    (call write-bytes-to out escape-sgr-suffix-bytes)
    (blank)
    (lazy kind (call terminal-background-kind color))
    (lazy r (/and/ (/rshift/ color 16) 255))
    (lazy g (/and/ (/rshift/ color 8) 255))
    (lazy b (/and/ color 255))
  )
  (fn-do _ write-char-run-to _
    (param out _)
    (param text-ptr _)
    (param display-width-ptr _)
    (param start Coord)
    (param end Coord)
    (param has-non-single-display-cells Bool)
    (param scratch ([] Byte))
    (if (not has-non-single-display-cells)
      (for (in x (..< start end))
        (call write-char-to out ([] text-ptr x) scratch)
      )
      (return)
    )
    (for (in x (..< start end))
      (if (!= ([] display-width-ptr x) 0)
        (call write-char-to out ([] text-ptr x) scratch)
      )
    )
  )
  (fn-do _ display-text-run _
    (param text-ptr _)
    (param display-width-ptr _)
    (param start Coord)
    (param end Coord)
    (param has-non-single-display-cells Bool)
    (if (not has-non-single-display-cells)
      (return (call (. text-ptr slice-string) (..< start end)))
    )
    (blank)
    (let result "")
    (for (in x (..< start end))
      (if (!= ([] display-width-ptr x) 0)
        (+= result ([] text-ptr x))
      )
    )
    (return result)
  )
  (fn-do _ clear-display-run _
    (param x Coord)
    (param y Coord)
    (param count Coord)
    (let start (call display-span-start x y))
    (let end (call display-span-end (+ x count) y))
    (return-if (if (<= end start)))
    (blank)
    (let clear-count (- end start))
    (let text-ptr (call get-pointer text-buffer start y))
    (let fg-ptr (call get-pointer fg-buffer start y))
    (blank)
    (= (?[] text-ptr (..< 0 clear-count)) (char " "))
    (= (?[] fg-ptr (..< 0 clear-count)) default-text-color)
    (blank)
    (let row-start (call buffer-index start y))
    (for (in i (..< 0 clear-count))
      (call set-display-width-cell (+ row-start i) y 1)
    )
  )
  (fn-do _ paint-display-cell _
    (param char Char)
    (param x Coord)
    (param y Coord)
    (param display-width Coord)
    (let index (call buffer-index x y))
    (= ([] text-buffer index) char)
    (call set-display-width-cell index y (as display-width U8))
    (= ([] fg-buffer index) (. state text-color))
    (blank)
    (let offset 1)
    (while (< offset display-width)
      (let continuation (+ index offset))
      (= ([] text-buffer continuation) (char " "))
      (call set-display-width-cell continuation y 0)
      (= ([] fg-buffer continuation) (. state text-color))
      (+= offset 1)
    )
    (blank)
    (call mark-coverage-run x y display-width layer-coverage-text)
  )
  (fn-do _ set-display-width-cell _
    (param cell-index Index)
    (param y Coord)
    (param value U8)
    (let old ([] display-width-buffer cell-index))
    (return-if (if (== old value)))
    (blank)
    (if (and (== old 1) (!= value 1))
      (+= ([] row-non-single-display-counts y) 1)
      (else-if (and (!= old 1) (== value 1))
        (-= ([] row-non-single-display-counts y) 1)
      )
    )
    (blank)
    (= ([] display-width-buffer cell-index) value)
  )
  (fn-expr _ display-span-start _
    (param x Coord)
    (param y Coord)
    (case? (== ([] row-non-single-display-counts y) 0)
      x
    )
    (default
      (call display-run-start x y)
    )
  )
  (fn-expr _ display-span-end _
    (param x Coord)
    (param y Coord)
    (case? (== ([] row-non-single-display-counts y) 0)
      x
    )
    (default
      (call display-run-end x y)
    )
  )
  (fn-expr _ diff-span-start Coord
    (param x Coord)
    (param y Coord)
    (case? (or (>= y height) (>= x width))
      x
    )
    (default
      (call display-span-start x y)
    )
  )
  (fn-expr _ diff-span-end Coord
    (param x Coord)
    (param y Coord)
    (case? (or (>= y height) (>= x width))
      x
    )
    (default
      (call display-span-end x y)
    )
  )
  (fn-do _ display-run-start Coord
    (param x Coord)
    (param y Coord)
    (if (<= width 0)
      (return 0)
    )
    (blank)
    (let start x)
    (if (>= start width)
      (= start (- width 1))
    )
    (blank)
    (while (and (> start 0) (== ([] display-width-buffer (call buffer-index start y)) 0))
      (-= start 1)
    )
    (blank)
    (return start)
  )
  (fn-do _ display-run-end Coord
    (param x Coord)
    (param y Coord)
    (if (<= width 0)
      (return 0)
    )
    (blank)
    (let end (call min x width))
    (while (and (< end width) (== ([] display-width-buffer (call buffer-index end y)) 0))
      (+= end 1)
    )
    (blank)
    (return end)
  )
  (fn-do _ write-char-to _
    (param out _)
    (param char Char)
    (param scratch ([] Byte))
    (if (< code 128)
      (= ([] scratch 0) (as code Byte))
      (call (. out write) scratch 1)
      (return)
    )
    (if (< code 2048)
      (= ([] scratch 0) (as (/or/ 192 (/rshift/ code 6)) Byte))
      (= ([] scratch 1) (call utf8-continuation-byte code))
      (call (. out write) scratch 2)
      (return)
    )
    (if (< code 65536)
      (= ([] scratch 0) (as (/or/ 224 (/rshift/ code 12)) Byte))
      (= ([] scratch 1) (call utf8-continuation-byte (/rshift/ code 6)))
      (= ([] scratch 2) (call utf8-continuation-byte code))
      (call (. out write) scratch 3)
      (return)
    )
    (= ([] scratch 0) (as (/or/ 240 (/rshift/ code 18)) Byte))
    (= ([] scratch 1) (call utf8-continuation-byte (/rshift/ code 12)))
    (= ([] scratch 2) (call utf8-continuation-byte (/rshift/ code 6)))
    (= ([] scratch 3) (call utf8-continuation-byte code))
    (call (. out write) scratch 4)
    (blank)
    (lazy code (as char U32))
  )
  (fn-expr _ utf8-continuation-byte Byte
    (param code U32)
    (as (/or/ 128 (/and/ code 63)) Byte)
  )
  (fn-do _ write-uint-to _
    (param out _)
    (param value U32)
    (param scratch ([] Byte))
    (let cursor (. scratch size))
    (let current value)
    (while 1
      (-= cursor 1)
      (= ([] scratch cursor) (as (+ 48 (% current 10)) Byte))
      (= current (/ current 10))
      (blank)
      (if (== current 0)
        (break)
      )
    )
    (blank)
    (let count (- (. scratch size) cursor))
    (for (in i (..< 0 count))
      (= ([] scratch i) ([] scratch (+ cursor i)))
    )
    (blank)
    (return (call (. out write) scratch count))
  )
  (fn-expr _ write-bytes-to _
    (param out _)
    (param bytes (of ImmutableArray Byte))
    (call (. out write) bytes (. bytes size))
  )
  (fn-do _ mark-coverage-cell _
    (param x Coord)
    (param y Coord)
    (param mask U8)
    (return-if (if (not has-transparent-cells)))
    (blank)
    (let index (call buffer-index x y))
    (if (< index (. coverage-buffer size))
      (= ([] coverage-buffer index) (/or/ ([] coverage-buffer index) mask))
    )
  )
  (fn-do _ mark-coverage-run _
    (param x Coord)
    (param y Coord)
    (param count Coord)
    (param mask U8)
    (return-if (if (not has-transparent-cells)))
    (blank)
    (let coverage-ptr (call get-pointer coverage-buffer x y))
    (return-if (if (not coverage-ptr)))
    (blank)
    (let row coverage-ptr)
    (for (in i (..< 0 count))
      (= ([] row i) (/or/ ([] row i) mask))
    )
  )
  (fn-expr _ get-pointer _
    (param buf _)
    (param x Coord)
    (param y Coord)
    (case? (and (>= x 0) (>= y 0) (< increment (. buf size)))
      (+ buf increment)
    )
    (where
      (lazy increment (call buffer-index x y))
    )
  )
  (fn-expr _ buffer-index Index
    (param x Coord)
    (param y Coord)
    (+ (* (as y Index) width) x)
  )
  (fn-expr _ get-content-bounds _
    (param content Rect)
    (tuple min-x min-y max-x max-y)
    (where
      (lazy (tuple min-x-view max-x-view)
        (block
          (case? (. state clip)
            (call clip (. state clip x) (. state clip right) 0 width)
          )
          (default
            (tuple 0 width)
          )
        )
      )
      (lazy (tuple min-x over-x)
        (call clip left right min-x-view max-x-view
          (block
            (lazy left (+ (. state offset-x) (. content x)))
            (lazy right (+ left (. content width)))
          )
        )
      )
      (lazy max-x (- over-x min-x))
      (lazy (tuple min-y-view max-y-view)
        (block
          (case? (. state clip)
            (call clip (. state clip y) (. state clip bottom) 0 height)
          )
          (default
            (tuple 0 height)
          )
        )
      )
      (lazy (tuple min-y max-y)
        (call clip top bottom min-y-view max-y-view
          (block
            (lazy top (+ (. state offset-y) (. content y)))
            (lazy bottom (+ top (. content height)))
          )
        )
      )
    )
  )
)

(type + BackgroundColor (is Union)
  (variant ansi (tuple (: color AnsiColor)))
  (variant rgba (tuple (: color RGBA)))
  (variant hsva (tuple (: color HSVA)))
)

(fn-expr + clip _
  (param left-edge Coord)
  (param right-edge Coord)
  (param min-edge Coord)
  (param max-edge Coord)
  (tuple left right)
  (where
    (lazy left
      (call max clipped-min-edge min-edge
        (block
          (lazy clipped-min-edge (call min left-edge max-edge))
        )
      )
    )
    (lazy right
      (call max clipped-min-edge min-edge
        (block
          (lazy clipped-min-edge (call min right-edge max-edge))
        )
      )
    )
    ; .. left = min of clipped-min-edge and max-edge
    ;     .. clipped-min-edge = max of left-edge and min-edge
    ; .. right = min of clipped-min-edge and max-edge
    ;     .. clipped-min-edge = max of right-edge and min-edge
  )
)

(type _ State
  (prop + text-color _ (= default-text-color))
  (prop + background (? BackgroundColor))
  (prop + cursor-x Coord)
  (prop + cursor-y Coord)
  (prop + offset-x Coord)
  (prop + offset-y Coord)
  (prop + clip (? Rect))
  (prop + previous (? State))
  (fn-do + assign _
    (param other State)
    (= text-color (. other text-color))
    (= background (. other background))
    (= cursor-x (. other cursor-x))
    (= cursor-y (. other cursor-y))
    (= offset-x (. other offset-x))
    (= offset-y (. other offset-y))
    (= clip (. other clip))
  )
)

(fn-expr _ escape-fg _
  (param color AnsiColor)
  (str "\x1b[38;5;" color "m")
)

(fn-expr _ escape-bg _
  (param color TerminalBackground)
  (case? (== color default-background)
    "\x1b[49m"
  )
  (case? (== kind terminal-background-ansi-tag)
    (str "\x1b[48;5;" (/and/ color 255) "m")
  )
  (default
    (str "\x1b[48;2;" r ";" g ";" b "m")
  )
  (where
    (lazy kind (call terminal-background-kind color))
    (lazy r (/and/ (/rshift/ color 16) 255))
    (lazy g (/and/ (/rshift/ color 8) 255))
    (lazy b (/and/ color 255))
  )
)

(fn-do _ paint-background-run _
  (param background BackgroundColor)
  (param bg-ptr _)
  (param count Coord)
  (return-if (if (not bg-ptr)))
  (blank)
  (let row bg-ptr)
  (let ignored
    (match background
      (case (call .ansi color)
        (call paint-ansi-background-run color row count)
      )
      (case (call .rgba color)
        (call paint-rgba-background-run color row count)
      )
      (case (call .hsva color)
        (call paint-rgba-background-run color row count)
      )
    )
  )
)

(fn-do _ paint-ansi-background-run I64
  (param color AnsiColor)
  (param row _)
  (param count Coord)
  (= ([] row (..< 0 count)) (call terminal-background-ansi color))
  (return 0)
)

(fn-do _ paint-rgba-background-run I64
  (param color RGBA)
  (param row _)
  (param count Coord)
  (if (<= (. color alpha) 0)
    (return 0)
  )
  (blank)
  (if (>= (. color alpha) 1)
    (= ([] row (..< 0 count)) (call terminal-background-rgb color))
    (return 0)
  )
  (blank)
  (for (in x (..< 0 count))
    (= ([] row x) (call terminal-background-rgb (call blend-rgba color (call terminal-background-rgba ([] row x)))))
  )
  (blank)
  (return 0)
)

(fn-do _ paint-background-cell-buffer I64
  (param background BackgroundColor)
  (param cell _)
  (let ignored
    (match background
      (case (call .ansi color)
        (= ([] cell 0) (call terminal-background-ansi color))
      )
      (case (call .rgba color)
        (call paint-rgba-background-cell color cell)
      )
      (case (call .hsva color)
        (call paint-rgba-background-cell color cell)
      )
    )
  )
  (blank)
  (return 0)
)

(fn-do _ paint-rgba-background-cell I64
  (param color RGBA)
  (param cell _)
  (if (<= (. color alpha) 0)
    (return 0)
  )
  (blank)
  (if (>= (. color alpha) 1)
    (= ([] cell 0) (call terminal-background-rgb color))
    (return 0)
  )
  (blank)
  (= ([] cell 0) (call terminal-background-rgb (call blend-rgba color (call terminal-background-rgba ([] cell 0)))))
  (return 0)
)

(fn-expr _ terminal-background-default TerminalBackground
  0u32
)

(fn-expr _ terminal-background-ansi TerminalBackground
  (param color AnsiColor)
  (/or/ terminal-background-ansi-tag (as color U32))
)

(fn-expr _ terminal-background-rgb TerminalBackground
  (param color RGBA)
  (/or/ terminal-background-rgb-tag (/lshift/ r 16) (/lshift/ g 8) b)
  (where
    (lazy r (as (* (. color red) 255) U32))
    (lazy g (as (* (. color green) 255) U32))
    (lazy b (as (* (. color blue) 255) U32))
  )
)

(fn-expr _ terminal-background-kind U32
  (param color TerminalBackground)
  (/and/ color terminal-background-kind-mask)
)

(fn-expr _ terminal-background-rgba RGBA
  (param color TerminalBackground)
  (case? (== kind terminal-background-ansi-tag)
    (call ansi-rgba (as (/and/ color 255) AnsiColor))
  )
  (case? (== kind terminal-background-rgb-tag)
    (call RGBA (/ r 255.0) (/ g 255.0) (/ b 255.0))
  )
  (default
    (call RGBA 0 0 0)
  )
  (where
    (lazy kind (call terminal-background-kind color))
    (lazy r (as (/and/ (/rshift/ color 16) 255) Float))
    (lazy g (as (/and/ (/rshift/ color 8) 255) Float))
    (lazy b (as (/and/ color 255) Float))
  )
)

(fn-expr _ blend-rgba RGBA
  (param foreground RGBA)
  (param background RGBA)
  (call RGBA red green blue)
  (where
    (lazy alpha (. foreground alpha))
    (lazy inverse (- 1 alpha))
    (lazy red (+ (* (. foreground red) alpha) (* (. background red) inverse)))
    (lazy green (+ (* (. foreground green) alpha) (* (. background green) inverse)))
    (lazy blue (+ (* (. foreground blue) alpha) (* (. background blue) inverse)))
  )
)

(fn-expr _ blend-rgba-opacity RGBA
  (param foreground RGBA)
  (param background RGBA)
  (param opacity Ratio)
  (call RGBA red green blue)
  (where
    (lazy alpha (* (. foreground alpha) opacity))
    (lazy inverse (- 1 alpha))
    (lazy red (+ (* (. foreground red) alpha) (* (. background red) inverse)))
    (lazy green (+ (* (. foreground green) alpha) (* (. background green) inverse)))
    (lazy blue (+ (* (. foreground blue) alpha) (* (. background blue) inverse)))
  )
)

(fn-expr _ blend-ansi-over-rgba _
  (param color AnsiColor)
  (param overlay RGBA)
  (param opacity Ratio)
  (call rgba-ansi (call blend-rgba-opacity overlay (call ansi-rgba color) opacity))
)

(fn-expr _ blend-ansi-over-ansi _
  (param foreground AnsiColor)
  (param background AnsiColor)
  (param opacity Ratio)
  (call rgba-ansi (call blend-rgba-opacity (call ansi-rgba foreground) (call ansi-rgba background) opacity))
)

(fn-expr _ clamped-opacity _
  (param opacity Ratio)
  (case? (<= opacity 0%%)
    0%%
  )
  (case? (>= opacity 1%%)
    1%%
  )
  (default
    opacity
  )
)

(fn-expr _ ansi-rgba RGBA
  (param color AnsiColor)
  (case? (< code 16)
    (call RGBA (call ansi-base-channel code 0) (call ansi-base-channel code 1) (call ansi-base-channel code 2))
  )
  (case? (< code 232)
    (call RGBA
      (block
        (arg (call ansi-cube-channel red-index))
        (arg (call ansi-cube-channel green-index))
        (arg (call ansi-cube-channel blue-index))
      )
    )
  )
  (default
    (call RGBA level level level)
  )
  (where
    (lazy code Int color)
    (lazy cube (- code 16))
    (lazy red-index (/ cube 36))
    (lazy green-index (% (/ cube 6) 6))
    (lazy blue-index (% cube 6))
    (lazy grey (+ 8 (* (- code 232) 10)))
    (lazy level (/ grey 255.0))
  )
)

(fn-expr _ ansi-base-channel Float
  (param color Int)
  (param channel Index)
  (case? (== color 7)
    (/ 192 255.0)
  )
  (case? (== color 8)
    (/ 128 255.0)
  )
  (case? (== (/and/ base bit) 0)
    0
  )
  (case? bright
    1
  )
  (default
    (/ 128 255.0)
  )
  (where
    (lazy bright (>= color 8))
    (lazy base (if-expr bright (- color 8) color))
    (lazy bit
      (block
        (case? (== channel 0)
          1
        )
        (case? (== channel 1)
          2
        )
        (default
          4
        )
      )
    )
  )
)

(fn-expr _ ansi-cube-channel _
  (param index Int)
  (case? (== index 0)
    0
  )
  (default
    (/ (+ 55 (* index 40)) 255.0)
  )
)

(fn-expr _ rgba-ansi AnsiColor
  (param color RGBA)
  (case? (and (< (call abs (- (. color red) (. color green))) 0.03) (< (call abs (- (. color green) (. color blue))) 0.03))
    (call grayscale-ansi (/ (+ (. color red) (. color green) (. color blue)) 3.0))
  )
  (default
    (as (+ 16 (* red 36) (* green 6) blue) AnsiColor)
  )
  (where
    (lazy red (call ansi-cube-index (. color red)))
    (lazy green (call ansi-cube-index (. color green)))
    (lazy blue (call ansi-cube-index (. color blue)))
  )
)

(fn-expr _ grayscale-ansi AnsiColor
  (param level Float)
  (case? (< level 0.03)
    16
  )
  (default
    (as (+ 232 clipped) AnsiColor)
  )
  (where
    (lazy clipped (call min 23 (call max 0 raw)))
    (lazy raw (as (call round (/ (- (* level 255.0) 8.0) 10.0)) Int))
  )
)

(fn-expr _ ansi-cube-index Int
  (param value Float)
  (case? (< byte 48.0)
    0
  )
  (default
    (call min 5 (call max 1 raw))
  )
  (where
    (lazy byte (* value 255.0))
    (lazy raw (as (call round (/ (- byte 55.0) 40.0)) Int))
  )
)
