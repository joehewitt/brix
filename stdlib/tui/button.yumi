• extend TUIDefaultTheme
    using BoxPaint
    using TextPaint

• Button
    color = AnsiColor(255)
    background-color = AnsiColor(8)

    when #is-focused
        color = AnsiColor(11)
    when #is-hovered
        color = AnsiColor(255)
        background-color = AnsiColor(244)
    when #is-pressed
        color = AnsiColor(255)
        background-color = AnsiColor(237)
    when !#is-effectively-enabled
        color = AnsiColor(8)
        background-color = AnsiColor(0)

