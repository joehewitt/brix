.. live = box

────────────────────
+ is-in-focus-scope Bool
    - box Box

box.ancestor-or-self'Box • where each.uid == scope.uid

.. scope = focus-scope()

────────────────────
+ do move-focus
    - going-backward = false

catch markup-batch-queue.checkpoint()
. scope = focus-scope()
. candidate = scope.next-focus-candidate(focused-box, going-backward)
focus: candidate

────────────────────
+ focus-scope

modal-box ?? this

────────────────────
+ do refresh-modal-box

. next-modal = active-modal-root()

if next-modal != modal-box
    . cleared-modal-focus = false
    if modal-box
        . old-modal = modal-box
        if focused-box?.ancestor-or-self'Box • where each == old-modal
            focused-box?.is-focused = false
            focused-box = null
            cleared-modal-focus = true

    modal-box = next-modal

    if modal-box
        . new-modal = modal-box
        if !focused-box || !is-in-focus-scope(focused-box)
            focus: new-modal.next-focus-candidate(null)
    else
        if cleared-modal-focus || !is-valid-focused-box(focused-box)
            focused-box?.is-focused = false
            focused-box = null
            focus: next-focus-candidate(null)

    invalidate-layout()
    invalidate-paint()

────────────────────
+ do flush-animation-frames

. count = animation-frame-callbacks.length
while count && animation-frame-callbacks
    . callback = animation-frame-callbacks.pop-first()
    callback()
        catch error Error
            unhandled-error(error)
    count -= 1

