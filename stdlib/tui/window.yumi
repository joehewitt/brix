────────────────────
+ do apply-focus
    - box Box?

if box != focused-box
    focused-box?.is-focused = false
    focused-box = box
    box?.is-focused = true
    if box
        needs-focus-reveal = true
        schedule-paint()

────────────────────
_ do reveal-pending-focus

=? if !needs-focus-reveal
needs-focus-reveal = false
focused-box?.reveal-focus()

