+ do dispatch-key-press
    - event KeyPressEvent

prepare-input-dispatch()
if focused-box
    publish-focused-input(this, focused-box, event)

if !event.is-canceled
    if event.key == Key.tab
        move-focus(event.modifiers.shift)
        event.cancel()
    else
        dispatch-shortcut-key-press(active-shortcuts(), event)
settle-input-dispatch()

