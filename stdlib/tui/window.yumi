    - event MouseDragEvent

. hit = hit-path(event.root-point)
update-hit-path(hit)

if !pressed-path-is-live()
    clear-pressed-path()
. drag-hit = pressed-hit ?? hit
drag-hit.publish-pointer(event)

────────────────────
+ do dispatch-pointer-event
    - event ScrollEvent

. hit = hit-path(event.root-point)
update-hit-path(hit)
hit.publish-pointer(event)
if !event.is-canceled && route-scroll-event(event, hit.target)
    event.cancel()

