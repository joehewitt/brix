────────────────────
+ do dispatch-pointer-event
    - event MouseDownEvent

. hit = hit-path(event.root-point)
update-hit-path(hit)
hit.publish-pointer(event)
if !event.is-canceled
    if event.button == PointerButton.primary
        . target-to-focus Box? = hit.target.ancestor-or-self'Box • where each.can-focus
        if target-to-focus
            focus: target-to-focus
    clear-pressed-path()
    pressed-hit = hit
    pressed-box = hit.target
    pressed-button = event.button
    pressed-box?.is-pressed = true

────────────────────
_ pressed-path-is-live Bool

|? pressed-hit
    pressed-hit.target.ancestor-or-self'Box • where each == this
??
    false

────────────────────
_ do clear-pressed-path

pressed-box?.is-pressed = false
pressed-box = null
pressed-hit = null

────────────────────
+ do dispatch-pointer-event
    - event MouseUpEvent

. hit = hit-path(event.root-point)
update-hit-path(hit)

if !pressed-path-is-live()
    clear-pressed-path()
. matching-hit = pressed-hit if pressed-button == event.button
. release-hit = matching-hit ?? hit
release-hit.publish-pointer(event)

. is-release-target = matching-hit != null && hit.target == pressed-box
if !event.is-canceled && is-release-target && event.button == PointerButton.primary
    . click-event = ClickEvent(event.root-point)
    release-hit.publish-click(click-event)

if matching-hit
    clear-pressed-path()

────────────────────
