+ do release-input-inside
    - subtree Box

. focused-inside = focused-box?.ancestor-or-self'Box • where each.uid == subtree.uid
. pending-inside = pending-focus-box?.ancestor-or-self'Box • where each.uid == subtree.uid
if focused-inside || pending-inside
