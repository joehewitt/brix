
./window
/core/markup
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ App is MarkupNode

+ is-quitting = false
+ windows [Window]
_ has-run = false
_ ending Completion'Bool?

────────────────────
+ This

when-main-ends(autorun)

────────────────────
+ do markup-absorb
    - window Window

this += window

────────────────────
+ do this += window Window

window.app = this
windows += window
if has-run
    window.open()
= window

────────────────────
+ do window-closed

. waiting = ending
=? if !waiting || waiting.is-finished
=? if some(windows) • where !each.is-closed
waiting.finish(true)

────────────────────
+ do run

has-run = true
. waiting = Completion'Bool()
ending = waiting
for window in windows
    window.open()
if some(windows) • where !each.is-closed
    waiting.await()
ending = null
close()
Task().when-finished(end-process)

────────────────────
_ do autorun

=? if has-run
run()

────────────────────
_ do end-process

request-process-termination(0)

────────────────────
+ do quit

is-quitting = true
for window in windows
    window.close()
        catch error Error
            unhandled-error(error)

────────────────────
+ do close

for window in windows
    window.close()
        catch error Error
            unhandled-error(error)
super.close()
