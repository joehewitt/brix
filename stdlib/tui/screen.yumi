./box
./canvas
./primitives
/core/markup

━━━━━━━━━━━━━━━━━━━━
+ Screen is Box
    is MarkupRootElement

+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────
+ do frame String
    - width Coord
    - height Coord

markup-batch-queue.checkpoint()
arrange-bounds(Rect(0, 0, width, height))
update-layout()
. canvas = Canvas(PSize(width, height))
paint(canvas)
= canvas.dump-lines()
