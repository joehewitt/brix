(import ./border)
(import ./box)
(import ./canvas)
(import ./colors)
(import ./layout)
(import ./painter)
(import ./primitives)
(import /core/style)
(import /data/markdown)
(import /math)
(blank)
(type-line + MarkdownText (is RichText))

(type + TextBox (alias Label) (is Box)
  (prop + text String)
  (prop + intrinsic-size _ (=> (call padded-size (call PSize (as (. display-text display-width) Coord) 1))))
  (blank)
  (prop _ display-text _ (= (call DisplayText "")))
  (blank)
  (depends invalidate-content-size text)
  (fn-do + This _
    (param text String)
  )
  (when-rule #text
    (= display-text (call DisplayText text))
  )
  (fn-expr + measured-content-size PSize
    (param query MeasureQuery)
    (before
      (do
        (call sync-display-text)
      )
    )
    (call PSize (as (. display-text display-width) Coord) 1)
  )
  (fn-do + emit-tui-box-node _
    (call (. super emit-tui-box-node))
    (blank)
    (probe-log (: this tui.box.text) (items: text))
  )
  (fn-do + paint _
    (param canvas Canvas)
    (if (not is-paint-visible)
      (call did-paint)
      (return)
    )
    (call sync-display-text)
    (let fg paint-text-color)
    (let content content-bounds)
    (do-use canvas
      (= (. canvas text-color) fg)
      (call paint-box-background this bounds canvas)
      (call paint-box-border this bounds canvas)
      (call (. canvas move) (. content point))
      (call (. canvas clip) content)
      (call (. canvas print-display-text) display-text)
      (for (in box structural-children)
        (if (and paint-skip-compositing-layers (. box requires-compositing-layer))
          (continue)
        )
        (call (. box paint) canvas)
      )
    )
    (blank)
    (call did-paint)
  )
  (fn-do + sync-display-text _
    (if (!= (. display-text text) text)
      (= display-text (call DisplayText text))
    )
  )
  (fn-do + markup-absorb _
    (param content String)
    (if (!= text content)
      (= text content)
    )
  )
)

(type + RichTextPaint (is Style)
  (prop + header-color AnsiColor @inherited (= aqua))
  (prop + strong-color AnsiColor @inherited (= white))
  (prop + em-color AnsiColor @inherited (= yellow))
  (prop + link-color AnsiColor @inherited (= aqua))
  (prop + image-color AnsiColor @inherited (= purple))
  (prop + quote-color AnsiColor @inherited (= grey))
  (prop + code-color AnsiColor @inherited (= lime))
  (prop + divider-color AnsiColor @inherited (= grey))
  (prop + bullet-color AnsiColor @inherited (= silver))
  (prop + hover-link-color AnsiColor @inherited (= black))
  (prop + hover-link-background BackgroundColor @inherited (= aqua))
  (blank)
  (style-domains header-color (domain paint))
  (style-domains strong-color (domain paint))
  (style-domains em-color (domain paint))
  (style-domains link-color (domain paint))
  (style-domains image-color (domain paint))
  (style-domains quote-color (domain paint))
  (style-domains code-color (domain paint))
  (style-domains divider-color (domain paint))
  (style-domains bullet-color (domain paint))
  (style-domains hover-link-color (domain paint))
  (style-domains hover-link-background (domain paint))
)

(type + RichText (is Box)
  (using RichTextPaint)
  (prop + text (? String) (= null))
  (prop + document Markdown (= (call MDDocument (call (of List Markdown)))))
  (prop + preferred-wrap-width Coord (= (call default-rich-text-wrap-width)))
  (prop + show-link-urls _ (= false))
  (prop + show-image-urls _ (= false))
  (prop + hovered-link-url (? String))
  (blank)
  (prop _ lines (of List RichTextLine) (= (call (of List RichTextLine))))
  (prop _ rich-layout-width Coord (= -1))
  (prop _ is-rich-layout-invalid _ (= true))
  (blank)
  (depends invalidate-rich-layout text document show-link-urls show-image-urls)
  (depends invalidate-paint hovered-link-url)
  (fn-do + This _
    (param text String)
  )
  (fn-do + This _
    (param document Markdown)
  )
  (subscribe-for (on event mouse-move)
    (let url (call link-url (. event point)))
    (if (!= hovered-link-url url)
      (= hovered-link-url url)
    )
  )
  (fn-do + measured-content-size PSize
    (param query MeasureQuery)
    (let layout (call RichTextLayout this (call rich-measure-width query)))
    (call (. layout render) (call rich-document))
    (call (. layout finish))
    (return (call PSize (as (. layout width) Coord) (call rich-line-count (. layout line-count))))
  )
  (fn-do + update-layout _
    (let text-layout (call RichTextLayout this (. content-bounds width)))
    (call (. text-layout render) (call rich-document))
    (call (. text-layout finish))
    (blank)
    (= lines (. text-layout lines))
    (= inner-width (as (. text-layout width) Coord))
    (= inner-height (call rich-line-count (. text-layout line-count)))
    (= rich-layout-width (. content-bounds width))
    (= is-rich-layout-invalid false)
    (= $is-layout-invalid false)
    (call mark-layout-arranged)
  )
  (fn-do + paint _
    (param canvas Canvas)
    (if (not is-paint-visible)
      (call did-paint)
      (return)
    )
    (blank)
    (if (or is-rich-layout-invalid (!= rich-layout-width (. content-bounds width)))
      (call update-layout)
    )
    (blank)
    (do-use canvas
      (call paint-box-background this bounds canvas)
      (call paint-box-border this bounds canvas)
      (let content content-bounds)
      (call (. canvas clip) content)
      (call (. canvas offset) (tuple scroll-x scroll-y))
      (blank)
      (let y (. content y))
      (for (in line lines)
        (let x (+ (. content x) (as (. line indent) Coord)))
        (for (in run (. line runs))
          (if (and (. run url) hovered-link-url (== (. run url) hovered-link-url))
            (let hover-bounds (call Rect x y (as (. run display-text display-width) Coord) 1))
            (call (. canvas paint-background) $hover-link-background hover-bounds)
            (= (. canvas text-color) $hover-link-color)
            (else
              (= (. canvas text-color) (call role-color (. run role)))
            )
          )
          (call (. canvas move) (tuple x y))
          (call (. canvas print-display-text) (. run display-text))
          (+= x (as (. run display-text display-width) Coord))
        )
        (+= y 1)
      )
    )
    (blank)
    (call did-paint)
  )
  (fn-do + invalidate-rich-layout _
    (= is-rich-layout-invalid true)
    (call invalidate-content-size)
  )
  (fn-do + link-url _
    (param point Point)
    (if (or is-rich-layout-invalid (!= rich-layout-width (. content-bounds width)))
      (call update-layout)
    )
    (blank)
    (let content content-bounds)
    (let content-x (- (. point x) (. content x) scroll-x))
    (let content-y (- (. point y) (. content y) scroll-y))
    (blank)
    (return-if (if (< content-y 0)))
    (return-if (if (>= content-y (. lines length))))
    (blank)
    (let line ([] lines content-y))
    (let x (as (. line indent) Coord))
    (for (in run (. line runs))
      (let next-x (+ x (as (. run display-text display-width) Coord)))
      (if (and (>= content-x x) (< content-x next-x))
        (return (. run url))
      )
      (= x next-x)
    )
  )
  (fn-expr _ rich-measure-width _
    (param query MeasureQuery)
    (call rich-positive-measure-width width)
    (where
      (lazy candidate-width (?? (. query inline available) (. query inline max) preferred-wrap-width))
      (lazy width (call constrained-axis-size candidate-width (. query inline) $min-width $max-width))
    )
  )
  (fn-expr _ rich-document _
    (case? source
      (call Markdown source)
    )
    (default
      document
    )
    (where
      (lazy source (?? text ""))
    )
  )
  (fn-expr _ role-color AnsiColor
    (param role RichTextRole)
    (match role
      (case (. RichTextRole body)
        $color
      )
      (case (. RichTextRole header)
        $header-color
      )
      (case (. RichTextRole strong)
        $strong-color
      )
      (case (. RichTextRole em)
        $em-color
      )
      (case (. RichTextRole link)
        $link-color
      )
      (case (. RichTextRole image)
        $image-color
      )
      (case (. RichTextRole quote)
        $quote-color
      )
      (case (. RichTextRole code)
        $code-color
      )
      (case (. RichTextRole divider)
        $divider-color
      )
      (case (. RichTextRole bullet)
        $bullet-color
      )
    )
  )
)

(fn-expr + default-rich-text-wrap-width Coord
  80
)

(type _ RichTextRole (is Union)
  (variant body)
  (variant header)
  (variant strong)
  (variant em)
  (variant link)
  (variant image)
  (variant quote)
  (variant code)
  (variant divider)
  (variant bullet)
)

(type _ RichTextRun
  (prop + text String (= ""))
  (prop + display-text _ (= (call DisplayText "")))
  (prop + role RichTextRole)
  (prop + url (? String))
  (fn-do + This _
    (param text String)
    (param display-text DisplayText)
    (param role RichTextRole)
    (param url (? String) (= null))
  )
)

(type _ RichTextLine
  (prop + runs (list RichTextRun))
  (prop + indent Int)
  (prop + width Int)
  (fn-do + This _
    (param indent Int (= 0))
  )
  (fn-do + add _
    (param display DisplayText)
    (param role RichTextRole)
    (param url (? String) (= null))
    (return-if (if (not (. display text))))
    (blank)
    (if (= (| (list ... run)) runs)
      (if (and (== (. run role) role) (== (. run url) url))
        (+= (. run text) (. display text))
        (= (. run display-text) (+ (. run display-text) display))
        (+= width (as (. display display-width) Int))
        (return)
      )
    )
    (+= runs (call RichTextRun (. display text) display role url))
    (+= width (as (. display display-width) Int))
  )
)

(type _ RichTextLayout
  (prop + max-width Int)
  (prop + width Int)
  (prop + lines (of List RichTextLine))
  (prop + line-count Int)
  (blank)
  (prop _ component RichText)
  (prop _ line (? RichTextLine))
  (prop _ indent Int)
  (prop _ x Int)
  (prop _ is-first-block _ (= true))
  (prop _ link-url (? String))
  (fn-do + This _
    (param component RichText)
    (param max-width Coord)
    (if (<= max-width 0)
      (= (. this max-width) (as (call rich-positive-measure-width (. component preferred-wrap-width)) Int))
      (else
        (= (. this max-width) (as max-width Int))
      )
    )
  )
  (fn-do + current-line _ :get
    (if (not line)
      (= line (call RichTextLine indent))
    )
    (return (!! line))
  )
  (fn-expr + available-width _ :get
    (case? (> max-width indent)
      (- max-width indent)
    )
    (default
      1
    )
  )
  (fn-do + render _
    (param node Markdown)
    (call render-block node)
  )
  (fn-do + finish _
    (if line
      (call newline)
    )
  )
  (fn-do + before-block _
    (if is-first-block
      (= is-first-block false)
      (return)
    )
    (if line
      (call newline)
    )
    (blank)
    (+= lines (call RichTextLine indent))
    (+= line-count 1)
  )
  (fn-do + newline _
    (if line
      (+= lines line)
      (+= line-count 1)
      (= width (call max width (+ (. (!! line) width) (. (!! line) indent))))
    )
    (blank)
    (= line null)
    (= x 0)
  )
  (fn-do + add-raw _
    (param text String)
    (param role RichTextRole)
    (call add-display (call DisplayText text) role)
  )
  (fn-do + add-display _
    (param text DisplayText)
    (param role RichTextRole)
    (call (. current-line add) text role link-url)
    (+= x (as (. text display-width) Int))
  )
  (fn-do + add-text _
    (param text String)
    (param role RichTextRole)
    (let word "")
    (for (in c text)
      (if (== c (char "\n"))
        (call add-word word role)
        (= word "")
        (call newline)
        (else-if (call is-rich-space c)
          (call add-word word role)
          (= word "")
          (call add-space role)
        )
        (else
          (+= word c)
        )
      )
    )
    (blank)
    (call add-word word role)
  )
  (fn-do + add-space _
    (param role RichTextRole)
    (return-if (if (== x 0)))
    (blank)
    (if (> (+ x 1) available-width)
      (call newline)
      (else
        (call add-raw " " role)
      )
    )
  )
  (fn-do + add-word _
    (param word String)
    (param role RichTextRole)
    (return-if (if (not word)))
    (blank)
    (let word-display (call DisplayText word))
    (if (> (as (. word-display display-width) Int) available-width)
      (for (in c word)
        (let char-display (call DisplayText (str c)))
        (let char-width (as (. char-display display-width) Int))
        (if (> (+ x char-width) available-width)
          (call newline)
        )
        (call add-display char-display role)
      )
      (return)
    )
    (if (and (> x 0) (> (+ x (as (. word-display display-width) Int)) available-width))
      (call newline)
    )
    (blank)
    (call add-display word-display role)
  )
  (fn-do + render-blocks _
    (param nodes (list Markdown))
    (for (in node nodes)
      (call render-block node)
    )
  )
  (fn-do + render-block _
    (param node Markdown)
    (if (= (| (: doc MDDocument)) node)
      (call render-blocks (. doc content))
      (else-if (= (| (: header MDHeader)) node)
        (call before-block)
        (call render-inlines (. header content) (. RichTextRole header))
        (call newline)
      )
      (else-if (= (| (: paragraph MDParagraph)) node)
        (call before-block)
        (call render-inlines (. paragraph content) (. RichTextRole body))
        (call newline)
      )
      (else-if (= (| (: divider MDDivider)) node)
        (call before-block)
        (call add-raw (* "-" available-width) (. RichTextRole divider))
        (call newline)
      )
      (else-if (= (| (: list MDList)) node)
        (call before-block)
        (call render-list list)
      )
      (else-if (= (| (: item MDListItem)) node)
        (call before-block)
        (call render-list-item item)
      )
      (else-if (= (| (: quote MDBlockQuote)) node)
        (call before-block)
        (call render-quote (. quote content))
      )
      (else-if (= (| (: code MDFencedCode)) node)
        (call before-block)
        (call render-code (. code body))
      )
      (else-if (= (| (: table MDTable)) node)
        (call before-block)
        (call render-table table)
      )
      (else-if (= (| (: row MDTableRow)) node)
        (call before-block)
        (call render-table-row row)
      )
      (else-if (= (| (: cell MDTableCell)) node)
        (call before-block)
        (call render-inlines (. cell content) (. RichTextRole body))
        (call newline)
      )
      (else
        (call before-block)
        (call render-inline node (. RichTextRole body))
        (call newline)
      )
    )
  )
  (fn-do + render-list _
    (param list MDList)
    (let number (. list start))
    (for (in child (. list children))
      (if (= (| (: item MDListItem)) child)
        (let marker (if-expr (. list ordered) (str number ". ") "* "))
        (call render-list-item item marker)
        (+= number 1)
        (else
          (call render-block child)
        )
      )
    )
  )
  (fn-do + render-list-item _
    (param item MDListItem)
    (param marker _ (= "* "))
    (if line
      (call newline)
    )
    (blank)
    (let previous-indent indent)
    (let content-indent (+ indent (. marker length)))
    (blank)
    (= indent previous-indent)
    (call add-raw marker (. RichTextRole bullet))
    (= indent content-indent)
    (call render-inlines (. item content) (. RichTextRole body))
    (call newline)
    (blank)
    (for (in block (. item blocks))
      (= indent content-indent)
      (if (= (| (: list MDList)) block)
        (call render-list list)
        (else
          (call render-block block)
        )
      )
    )
    (blank)
    (= indent previous-indent)
  )
  (fn-do + render-quote _
    (param content (list Markdown))
    (let previous-indent indent)
    (blank)
    (+= indent 2)
    (for (in node content)
      (if line
        (call newline)
      )
      (call add-raw "> " (. RichTextRole quote))
      (if (= (| (: paragraph MDParagraph)) node)
        (call render-inlines (. paragraph content) (. RichTextRole quote))
        (call newline)
        (else-if (= (| (: header MDHeader)) node)
          (call render-inlines (. header content) (. RichTextRole quote))
          (call newline)
        )
        (else-if (= (| (: code MDFencedCode)) node)
          (call render-code (. code body))
        )
        (else
          (call render-inline node (. RichTextRole quote))
          (call newline)
        )
      )
    )
    (= indent previous-indent)
  )
  (fn-do + render-table _
    (param table MDTable)
    (call render-table-row (. table header))
    (for (in row (. table rows))
      (call render-table-row row)
    )
  )
  (fn-do + render-table-row _
    (param row MDTableRow)
    (if line
      (call newline)
    )
    (let is-first true)
    (for (in cell (. row cells))
      (if (not is-first)
        (call add-raw " | " (. RichTextRole divider))
      )
      (call render-inlines (. cell content) (. RichTextRole body))
      (= is-first false)
    )
    (call newline)
  )
  (fn-do + render-code _
    (param code String)
    (for (in code-line (call (. code split) "\n"))
      (call add-text code-line (. RichTextRole code))
      (call newline)
    )
  )
  (fn-do + render-inlines _
    (param nodes (list Markdown))
    (param role RichTextRole)
    (for (in node nodes)
      (call render-inline node role)
    )
  )
  (fn-do + render-inline _
    (param node Markdown)
    (param role RichTextRole)
    (if (= (| (: text MDText)) node)
      (call add-text (. text text) role)
      (else-if (= (| (: strong MDStrong)) node)
        (call render-inlines (. strong content) (. RichTextRole strong))
      )
      (else-if (= (| (: em MDEm)) node)
        (call render-inlines (. em content) (. RichTextRole em))
      )
      (else-if (= (| (: link MDLink)) node)
        (let previous-link-url link-url)
        (= link-url (. link url))
        (call render-inlines (. link content) (. RichTextRole link))
        (= link-url previous-link-url)
        (if (. component show-link-urls)
          (call add-text (str " (" (. link url) ")") (. RichTextRole quote))
        )
      )
      (else-if (= (| (: image MDImage)) node)
        (call add-text "[image: " (. RichTextRole image))
        (call render-inlines (. image content) (. RichTextRole image))
        (call add-text "]" (. RichTextRole image))
        (if (. component show-image-urls)
          (call add-text (str " (" (. image url) ")") (. RichTextRole quote))
        )
      )
      (else-if (= (| (: code MDInlineCode)) node)
        (call add-text (. code code) (. RichTextRole code))
      )
      (else-if (= (| (: cell MDTableCell)) node)
        (call render-inlines (. cell content) role)
      )
      (else-if (= (| (: quote MDBlockQuote)) node)
        (call render-quote (. quote content))
      )
      (else-if (= (| (: paragraph MDParagraph)) node)
        (call render-inlines (. paragraph content) role)
      )
      (else
        (call add-text (str node) role)
      )
    )
  )
)

(fn-expr _ rich-positive-measure-width _
  (param width Coord)
  (case? (> width 0)
    width
  )
  (default
    (call default-rich-text-wrap-width)
  )
)

(fn-expr _ rich-line-count Coord
  (param count Int)
  (as count Coord)
)

(fn-expr _ is-rich-space _
  (param c Char)
  (or (== c (char " ")) (== c (char "\t")) (== c (char "\r")))
)
