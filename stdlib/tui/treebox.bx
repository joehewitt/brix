(import ./box)
(import ./colors)
(import ./events)
(import ./layout)
(import ./listbox)
(import ./primitives)
(import ./shortcuts)
(import ./styles)
(import ./theme)
(import ./window)
(import /core/channel)
(import /core/list)
(import /core/markup)
(import /stream/combine)
(import /ui/input)

(style-extend TUIDefaultTheme
  (using BoxPaint)
  (rule TreeBox (• bg (call AnsiColor 0)))
)

(type + (of TreeBox Item) (is Box)
  (rule This
    (= focus-mode (. FocusMode inside))
  )
  (blank)
  (prop + root-node (? Item))
  (prop + load-children (of TreeBoxChildProvider Item) (= tree-box-no-children))
  (prop + key-builder (? (of MarkupKeyBuilder Item)))
  (prop + entries (list (of TreeBoxEntry Item)) (= (call (of List (of TreeBoxEntry Item)))))
  (prop + selected-entry (? (of TreeBoxEntry Item))
    (=
      (call (of tree-box-entry-for-key Item)
        (block
          (arg #entries)
          (arg #selected-key)
          (arg #selection-generation)
        )
      )
    )
  )
  (prop + selected-item (? Item)
    (=
      (call (of tree-box-entry-item Item)
        (block
          (arg #selected-entry)
          (arg #selection-generation)
        )
      )
    )
  )
  (prop + selected-row (? ListItem))
  (prop + selected-entry-is-expanded Bool (= (?? (?. #selected-entry is-expanded) false)))
  (prop + can-open-selection Bool (= (and #selected-row-has-children (not #selected-entry-is-expanded))))
  (prop + can-leave-selection Bool
    (=
      (call (of tree-box-can-leave-selection Item)
        (block
          (arg selected-entry)
          (arg #selected-row-has-children)
          (arg #selection-generation)
        )
      )
    )
  )
  (event + selected SelectEvent)
  (event + activated ActivateEvent)
  (event + interacted Bool)
  (blank)
  (prop _ list (? (of TreeBoxList Item)))
  (prop _ expanded-keys (list String) (= (call (of List String))))
  (prop _ child-cache (list (of TreeBoxChildren Item)) (= (call (of List (of TreeBoxChildren Item)))))
  (prop _ selected-key (? String))
  (prop _ selected-row-has-children _ (= false))
  (prop _ selection-generation Size (= 0))
  (content
    (<> This (• flex-col)
      (if #can-leave-selection
        (<> Shortcut (text: "Back")
          (= key .arrow-left)
          (= action (=> () :do (call interact-leave-selection)))
        )
      )
      (blank)
      (if #can-open-selection
        (<> Shortcut (text: "Open")
          (= key .arrow-right)
          (= action (=> () :do (call interact-open-selection)))
        )
      )
      (blank)
      (for (in current-entries (call (of tree-box-entry-snapshots Item) #entries))
        (<> (of TreeBoxList Item) (id: list) (• flex 1)
          (= tree this)
          (= entries current-entries)
          (blank)
          (for (in entry current-entries)
            (let item (. entry item))
            (+<> ListItem (id: row) (param: item Item))
          )
        )
      )
    )
  )
  (whenever-rule #root-node
    (call reset-tree)
  )
  (whenever-rule (trigger children ListItem)
    (catch (call sync-selected-row))
  )
  (fn-do + did-layout _
    (catch (call sync-selected-row))
  )
  (fn-do + mounted _
    (catch (call reset-tree))
    (catch (call sync-selected-row))
  )
  (fn-do + reset-tree _
    (= expanded-keys (call (of List String)))
    (= child-cache (call (of List (of TreeBoxChildren Item))))
    (= selected-key null)
    (+= selection-generation 1)
    (blank)
    (let current-root root-node)
    (if current-root
      (let root-children (call load-children current-root))
      (if (!= root-children null)
        (call cache-children "" root-children)
      )
    )
    (blank)
    (call rebuild-entries)
  )
  (fn-do _ interact-open-selection _
    (call open-selection)
    (<- interacted true)
  )
  (fn-do _ interact-leave-selection _
    (call leave-selection)
    (<- interacted true)
  )
  (fn-do + open-selection _
    (call ensure-selection)
    (blank)
    (let row (call current-selected-row))
    (call sync-selected-state-from-row row)
    (return-if (if (not row)))
    (return-if (if (not (. row has-children))))
    (blank)
    (let entry (call entry-for-row row))
    (return-if (if (not entry)))
    (blank)
    (if (not (. entry is-expanded))
      (let ignored (call expand-entry entry))
    )
  )
  (fn-do + leave-selection _
    (call ensure-selection)
    (blank)
    (let row (call current-selected-row))
    (call sync-selected-state-from-row row)
    (blank)
    (let entry (call entry-for-row row))
    (return-if (if (not entry)))
    (blank)
    (if (and row (. row has-children) (. entry is-expanded))
      (call collapse-entry entry)
      (return)
    )
    (let parent-key (. entry parent-key))
    (if parent-key
      (call select-entry-key parent-key)
    )
  )
  (fn-do + select-relative _
    (param direction Direction)
    (let current-list list)
    (if current-list
      (call (. current-list select-relative) direction)
    )
  )
  (fn-do + row-at-index (? ListItem)
    (param index Index)
    (let current-list list)
    (if current-list
      (return (call (. current-list row-at-index) index))
    )
  )
  (fn-do + activate-selection _
    (call ensure-selection)
    (blank)
    (let row (call current-selected-row))
    (call sync-selected-state-from-row row)
    (if (and row (. row has-children))
      (let entry (call entry-for-row row))
      (if entry
        (if (. entry is-expanded)
          (call collapse-entry entry)
          (else
            (let ignored (call expand-entry entry))
          )
        )
      )
      (return)
    )
    (call notify-activated)
  )
  (fn-do + ensure-selection _
    (let current-list list)
    (if current-list
      (catch (call (. current-list ensure-selection)))
    )
  )
  (fn-do + select-row _
    (param row (? ListItem))
    (let current-list list)
    (if current-list
      (call (. current-list select-row) row)
      (call focus-list)
    )
  )
  (fn-do + rebuild-entries _
    (= entries (call visible-entries))
    (call restore-selected-key)
    (call sync-selected-row)
  )
  (fn-do + reload _
    (= child-cache (call (of List (of TreeBoxChildren Item))))
    (let next (call visible-entries))
    (return-if (if (call (of tree-box-entries-match Item) entries next)))
    (blank)
    (let held selected-key)
    (if (and held (== (call (of tree-box-entry-for-key Item) next held) null))
      (= selected-key (call surviving-key held next))
      (+= selection-generation 1)
    )
    (= entries next)
    (call restore-selected-key)
    (call sync-selected-row)
    (if (!= selected-key held)
      (call notify-selected)
    )
  )
  (fn-do _ visible-entries (list (of TreeBoxEntry Item))
    (let next (list (of TreeBoxEntry Item)) (call (of List (of TreeBoxEntry Item))))
    (let current-root root-node)
    (if current-root
      (let root-children (call children-for "" current-root))
      (if (!= root-children null)
        (call append-visible-entries next root-children "" 0)
      )
    )
    (return next)
  )
  (fn-do _ surviving-key (? String)
    (param key String)
    (param next (list (of TreeBoxEntry Item)))
    (let start (call entry-index-for-key key))
    (return-if (if (== start null)))
    (let present (call (of Map String Bool)))
    (for (in entry next)
      (= ([] present (. entry key)) true)
    )
    (for (in index (..< (+ start 1) (. entries length)))
      (return-if (. ([] entries index) key) (if (has present (. ([] entries index) key))))
    )
    (let index start)
    (while (> index 0)
      (-= index 1)
      (return-if (. ([] entries index) key) (if (has present (. ([] entries index) key))))
    )
  )
  (fn-do + append-visible-entries _
    (param target (list (of TreeBoxEntry Item)))
    (param items (list Item))
    (param key-prefix String)
    (param depth Index)
    (param parent-key (? String) (= null))
    (let index Index 0)
    (for (in item items)
      (let key (call key-for-item item key-prefix index))
      (let is-expanded (call expanded-key key))
      (+= target (call (of TreeBoxEntry Item) item key depth parent-key is-expanded))
      (if is-expanded
        (let child-items (call children-for key item))
        (if (!= child-items null)
          (call append-visible-entries target child-items key (+ depth 1) key)
        )
      )
      (+= index 1)
    )
  )
  (fn-expr + key-for-item String
    (param item Item)
    (param key-prefix String)
    (param index Index)
    (match (tuple key-builder key-prefix)
      (case (tuple (: builder (of MarkupKeyBuilder Item)) _)
        (call builder item)
      )
      (case (tuple _ ({} it))
        (str key-prefix "/" index)
      )
      (default
        (str index)
      )
    )
  )
  (fn-do + expand-entry Bool
    (param entry (of TreeBoxEntry Item))
    (let children (call children-for (. entry key) (. entry item)))
    (return-if (if (== children null)))
    (return-if (if (not children)))
    (blank)
    (call add-expanded-key (. entry key))
    (call select-entry-key (. entry key))
    (call rebuild-entries)
    (return true)
  )
  (fn-do + collapse-entry _
    (param entry (of TreeBoxEntry Item))
    (call remove-expanded-key (. entry key))
    (call select-entry-key (. entry key))
    (call rebuild-entries)
  )
  (fn-do + select-entry-key _
    (param key String)
    (let row (call row-for-key key))
    (if row
      (call select-row row)
      (else-if (!= selected-key key)
        (= selected-key key)
        (+= selection-generation 1)
      )
    )
  )
  (fn-do + reveal-key-path Bool
    (param keys (list String))
    (return-if (if (not keys)))
    (blank)
    (let target-key ([] keys (- (. keys length) 1)))
    (let last-ancestor (- (. keys length) 1))
    (let index Index 0)
    (while (< index last-ancestor)
      (call add-expanded-key ([] keys index))
      (+= index 1)
    )
    (blank)
    (call rebuild-entries)
    (return-if (if (== (call entry-index-for-key target-key) null)))
    (blank)
    (call select-entry-key target-key)
    (return true)
  )
  (fn-do + sync-selected-row _
    (call sync-tree-rows)
    (blank)
    (let current-list list)
    (if (not current-list)
      (call restore-selected-key)
      (return)
    )
    (if (not entries)
      (if (. current-list selected-row)
        (call (. current-list select-row) null)
      )
      (call sync-selected-row-state null)
      (return)
    )
    (call restore-selected-key)
    (blank)
    (let row (call row-for-key selected-key))
    (return-if (if (not row)))
    (if (or (!= (. current-list selected-row) row) (!= selected-row row))
      (call (. current-list select-row) row)
      (else
        (call sync-selected-row-state row)
        (call (. current-list ensure-row-visible) row)
      )
    )
  )
  (fn-do + sync-selected-key-from-row _
    (let row (call current-selected-row))
    (call sync-selected-row-state row)
    (return-if (if (not row)))
    (blank)
    (let key (call key-for-row row))
    (if (!= selected-key key)
      (= selected-key key)
      (+= selection-generation 1)
    )
  )
  (fn-expr + current-selected-row (? ListItem)
    (case? selected-list-row
      selected-list-row
    )
    (case? current-list
      valid-selected-row
    )
    (default
      selected-row
    )
    (where
      (lazy current-list list)
      (lazy selected-list-row (?. current-list selected-row))
      (lazy valid-selected-row (call (. current-list valid-row) selected-row))
    )
  )
  (fn-expr + entry-for-row (? (of TreeBoxEntry Item))
    (param row (? ListItem))
    (call (of tree-box-entry-for-key Item) entries key selection-generation)
    (where
      (lazy key (call key-for-row row))
    )
  )
  (fn-do + sync-selected-state-from-row _
    (param row (? ListItem))
    (call sync-selected-row-state row)
    (return-if (if (not row)))
    (blank)
    (let key (call key-for-row row))
    (if (!= selected-key key)
      (= selected-key key)
      (+= selection-generation 1)
    )
  )
  (fn-do + focus-list _
    (let current-list list)
    (if current-list
      (call (?. (of ancestor Window) focus) current-list)
    )
  )
  (fn-do + sync-selected-row-state Bool
    (param row (? ListItem))
    (let live-row row)
    (let has-children (?? (?. live-row has-children) false))
    (let changed (or (!= selected-row live-row) (!= selected-row-has-children has-children)))
    (= selected-row live-row)
    (= selected-row-has-children has-children)
    (return changed)
  )
  (fn-do + sync-tree-rows _
    (let current-list list)
    (return-if (if (not current-list)))
    (blank)
    (for (in (tuple row entry) (call zip (call (. current-list selectable-rows)) entries))
      (if (is row (of TreeBoxItem Item))
        (call (. (as row (of TreeBoxItem Item)) sync-entry-from) entry)
      )
    )
  )
  (fn-do + restore-selected-key _
    (if (not entries)
      (if (!= selected-key null)
        (= selected-key null)
        (+= selection-generation 1)
      )
      (return)
    )
    (return-if (if (!= (call entry-index-for-key selected-key) null)))
    (blank)
    (= selected-key (. ([] entries 0) key))
    (+= selection-generation 1)
  )
  (fn-do + row-for-key (? ListItem)
    (param key (? String))
    (let current-list list)
    (return-if (if (not current-list)))
    (blank)
    (let index (call entry-index-for-key key))
    (return-if (if (not index)))
    (blank)
    (return (call (. current-list row-at-index) index))
  )
  (fn-do + key-for-row (? String)
    (param row (? ListItem))
    (return-if (if (not row)))
    (blank)
    (let current-list list)
    (return-if (if (not current-list)))
    (blank)
    (let index Index 0)
    (for (in child (. current-list active-children))
      (let candidate (call (. current-list selectable-row) child))
      (if candidate
        (if (== candidate row)
          (return (call entry-key-at index))
        )
        (+= index 1)
      )
    )
  )
  (fn-do + entry-key-at (? String)
    (param index (? Index))
    (return-if (if (not index)))
    (blank)
    (let live-index index)
    (if (< live-index (. entries length))
      (return (. ([] entries live-index) key))
    )
  )
  (fn-do + entry-index-for-key (? Index)
    (param key (? String))
    (return-if (if (not key)))
    (blank)
    (let live-key key)
    (let index Index 0)
    (for (in entry entries)
      (if (== (. entry key) live-key)
        (return index)
      )
      (+= index 1)
    )
  )
  (fn-do + children-for (? (list Item))
    (param key String)
    (param item Item)
    (let cached (call cached-children-for key))
    (if cached
      (return (. cached items))
    )
    (blank)
    (let children (call load-children item))
    (if (!= children null)
      (call cache-children key children)
      (return children)
    )
  )
  (fn-do + cached-children-for (? (of TreeBoxChildren Item))
    (param key String)
    (for (in cached child-cache)
      (if (== (. cached key) key)
        (return cached)
      )
    )
  )
  (fn-do + cache-children _
    (param key String)
    (param items (list Item))
    (for (in cached child-cache)
      (if (== (. cached key) key)
        (= (. cached items) items)
        (return)
      )
    )
    (+= child-cache (call (of TreeBoxChildren Item) key items))
  )
  (fn-expr + expanded-key Bool
    (param key String)
    (has expanded-keys key)
  )
  (fn-do + add-expanded-key _
    (param key String)
    (if (not (call expanded-key key))
      (+= expanded-keys key)
      (+= selection-generation 1)
    )
  )
  (fn-do + remove-expanded-key _
    (param key String)
    (let index Index 0)
    (while (< index (. expanded-keys length))
      (if (== ([] expanded-keys index) key)
        (call (. expanded-keys remove) index)
        (+= selection-generation 1)
        (return)
      )
      (+= index 1)
    )
  )
  (fn-do + notify-selected _
    (+= selection-generation 1)
    (= selected-entry (call (of tree-box-entry-for-key Item) entries selected-key selection-generation))
    (= selected-item (call (of tree-box-entry-item Item) selected-entry selection-generation))
    (<- selected (call SelectEvent))
  )
  (fn-do + notify-activated _
    (<- activated (call ActivateEvent))
  )
)

(type + (of TreeBoxList Item) (is ListBox)
  (prop + entries (list (of TreeBoxEntry Item)) (= (call (of List (of TreeBoxEntry Item)))))
  (blank)
  (prop _ tree (? (of TreeBox Item)))
  (whenever-rule (trigger children ListItem)
    (let owner tree)
    (if owner
      (catch (call (. owner sync-selected-row)))
    )
  )
  (subscribe-for (on event selected)
    (let owner tree)
    (if owner
      (let old-key (. owner selected-key))
      (call (. owner sync-selected-key-from-row))
      (if (!= old-key (. owner selected-key))
        (call (. owner notify-selected))
      )
    )
  )
  (subscribe-for (on event interacted)
    (if tree
      (<- (. tree interacted) true)
    )
  )
  (fn-do + select-row _
    (param row (? ListItem))
    (let owner tree)
    (let live-row (call valid-row row))
    (if (== selected-row live-row)
      (if live-row
        (call ensure-row-visible live-row)
        (call (?. owner sync-selected-key-from-row))
      )
      (else
        (let old selected-row)
        (if old
          (= (. old is-selected) false)
        )
        (blank)
        (= selected-row live-row)
        (if live-row
          (= (. live-row is-selected) true)
          (call ensure-row-visible live-row)
        )
        (blank)
        (if owner
          (call (. owner sync-selected-key-from-row))
          (call (. owner notify-selected))
          (else
            (<- selected (call SelectEvent))
          )
        )
      )
    )
  )
  (fn-do + activate-selection _
    (let owner tree)
    (if owner
      (call (. owner activate-selection))
      (return)
    )
    (call (. super activate-selection))
  )
  (fn-do + ensure-selection _
    (let row (call valid-row selected-row))
    (if row
      (if (not (. row is-selected))
        (= (. row is-selected) true)
      )
      (call ensure-row-visible row)
      (call (?. tree sync-selected-key-from-row))
      (return)
    )
    (let owner tree)
    (if owner
      (catch (call (. owner sync-selected-row)))
      (else
        (call (. super ensure-selection))
      )
    )
  )
  (fn-do + mounted _
    (let owner tree)
    (if owner
      (= (. owner list) this)
      (catch (call (. owner sync-selected-row)))
      (call (. owner focus-list))
    )
  )
  (fn-do + unmounted _
    (let owner tree)
    (if (and owner (== (. owner list) this))
      (= (. owner list) null)
    )
  )
)

(type + (of TreeBoxItem Item) (is ListItem)
  (prop + entry (? (of TreeBoxEntry Item)))
  (prop + item (? Item))
  (prop + depth Index (= 0))
  (prop + indent Coord (= 0))
  (prop + is-expanded _ (= false))
  (prop + content-text _ (= ""))
  (fn-do + This _
    (param item Item)
  )
  (when-rule #content-text
    (call sync-text)
  )
  (when-rule #entry
    (call sync-entry)
  )
  (whenever-rule #has-children
    (call sync-text)
  )
  (whenever-rule #is-expanded
    (call sync-text)
  )
  (fn-do + sync-entry-from _
    (param next-entry (of TreeBoxEntry Item))
    (return-if (if (== entry next-entry)))
    (= entry next-entry)
    (call sync-entry)
  )
  (fn-do + sync-entry _
    (let current entry)
    (if current
      (= item (. current item))
      (= depth (. current depth))
      (= indent (call tree-box-indent depth))
      (= is-expanded (. current is-expanded))
      (call sync-text)
    )
  )
  (fn-do + sync-text _
    (= text (call tree-box-row-text depth has-children is-expanded content-text))
  )
)

(type + (of TreeBoxEntry Item)
  (prop + item Item)
  (prop + key String)
  (prop + parent-key (? String))
  (prop + depth Index)
  (prop + is-expanded _ (= false))
  (fn-do + This _
    (param item _)
    (param key _)
    (param depth _)
    (param parent-key _ (= null))
    (param is-expanded _ (= false))
  )
)

(type + (of TreeBoxChildProvider TreeItem) (is (fn-type (? (list TreeItem)) (param item TreeItem))))

(type _ (of TreeBoxChildren Item)
  (prop + key String)
  (prop + items (list Item))
  (fn-do + This _
    (param key _)
    (param items _)
  )
)

(fn-expr _ (of tree-box-no-children Item) (? (list Item))
  (param item Item)
  null
)

(fn-do _ (of tree-box-entry-for-key Item) (? (of TreeBoxEntry Item))
  (param entries (list (of TreeBoxEntry Item)))
  (param key (? String))
  (param selection-generation Size (= 0))
  (return-if (if (not key)))
  (blank)
  (let live-key key)
  (for (in entry entries)
    (if (== (. entry key) live-key)
      (return entry)
    )
  )
)

(fn-do _ (of tree-box-entries-match Item) Bool
  (param current (list (of TreeBoxEntry Item)))
  (param next (list (of TreeBoxEntry Item)))
  (return-if false (if (!= (. current length) (. next length))))
  (for (in index (..< 0 (. current length)))
    (let a ([] current index))
    (let b ([] next index))
    (return-if false (if (or (!= (. a key) (. b key)) (!= (. a depth) (. b depth)) (!= (. a is-expanded) (. b is-expanded)))))
    (return-if false (if (not (== (. a item) (. b item)))))
  )
  (return true)
)

(fn-expr _ (of tree-box-entry-snapshots Item) (list (list (of TreeBoxEntry Item)))
  (param entries (list (of TreeBoxEntry Item)))
  (item entries)
)

(fn-do _ (of tree-box-entry-item Item) (? Item)
  (param entry (? (of TreeBoxEntry Item)))
  (param selection-generation Size (= 0))
  (return-if (. entry item) (if entry))
)

(fn-expr _ (of tree-box-can-leave-selection Item) _
  (param entry (? (of TreeBoxEntry Item)))
  (param has-children Bool (= false))
  (param selection-generation Size (= 0))
  (case? (not entry)
    false
  )
  (case? (. entry parent-key)
    true
  )
  (default
    (and has-children (. entry is-expanded))
  )
)

(fn-do _ tree-box-indent _
  (param depth Index)
  (let indent 0tx)
  (let remaining depth)
  (while (> remaining 0)
    (+= indent 2)
    (-= remaining 1)
  )
  (blank)
  (return indent)
)

(fn-expr _ tree-box-row-text _
  (param depth Index)
  (param has-children Bool)
  (param is-expanded Bool)
  (param content String)
  (str indent-text disclosure-marker " " content)
  (where
    (lazy indent-text (call tree-box-indent-string depth))
    (lazy disclosure-marker (call tree-box-disclosure-marker has-children is-expanded))
  )
)

(fn-expr _ tree-box-indent-string _
  (param depth Index)
  (* " " (call tree-box-indent depth))
)

(fn-expr _ tree-box-disclosure-marker _
  (param has-children Bool)
  (param is-expanded Bool)
  (case? (not has-children)
    " "
  )
  (case? is-expanded
    "▾"
  )
  (default
    "▸"
  )
)
