━━━━━━━━━━━━━━━━━━━━
+ LayerCompositor

+ layers [CompositingLayer]
+ base-canvas Canvas?
+ final-canvas Canvas?
+ base-paint-count = 0
+ layer-paint-count = 0
+ composite-cell-count = 0

_ dirty-bounds Rect
_ has-dirty-bounds = false

────────────────────
+ do paint
    - root Box
    - canvas Canvas

. has-new-surfaces = ensure-surfaces(root.bounds.size)
begin-layer-reconcile()
do use canvas
    canvas.offset((root.scroll-x, root.scroll-y))
    collect-layers(root, canvas)
finish-layer-reconcile()

. needs-ordered = layers.length > 0
. damage = root.take-paint-damage-bounds()
. needs-base = has-new-surfaces || needs-base-paint(root)

if needs-base || damage
    repaint-base(root)
    if needs-base
        add-dirty-bounds(root.bounds)
    else if damage
        add-dirty-bounds(damage)

paint-dirty-layers()
if needs-ordered
    compose-ordered(root)
else
    compose-dirty-bounds()
canvas.copy(final-canvas!)

────────────────────
+ do reset

layers.clear()
base-canvas = null
final-canvas = null
has-dirty-bounds = false

────────────────────
_ do ensure-surfaces Bool
    - size PSize

if base-canvas && final-canvas
    =? false if base-canvas.width == size.width && base-canvas.height == size.height

base-canvas = Canvas(size)
final-canvas = Canvas(size)
for layer in layers
    layer.needs-content-paint = true
= true

────────────────────
_ do begin-layer-reconcile

has-dirty-bounds = false
for layer in layers
    layer.was-seen = false
    layer.needs-geometry-cleanup = false

────────────────────
_ do collect-layers
    - root Box
    - canvas Canvas

for child in root.structural-children
    collect-layer-subtree(child, canvas)

────────────────────
_ do collect-layer-subtree
    - box Box
    - canvas Canvas

if !box.is-display-visible
    box.invalidate-retained-paint-footprint()
    =
if !box.is-markup-shadow && !canvas.is-rect-visible(box.bounds)
    =

if box.requires-compositing-layer
    collect-hidden-paint-damage(box)
    update-layer(layer-for(box))
    =
if box.is-markup-shadow
    collect-layers(box, canvas)
else
    do use canvas
        canvas.clip(box.content-bounds)
        canvas.offset((box.scroll-x, box.scroll-y))
        collect-layers(box, canvas)

────────────────────
_ do collect-hidden-paint-damage
    - box Box

for child in box.structural-children
    if child.is-display-visible
        collect-hidden-paint-damage(child)
    else
        child.invalidate-retained-paint-footprint()

────────────────────
_ do layer-for
    - owner Box

for layer in layers
    if layer.owner == owner
        = layer

. fresh = CompositingLayer(owner)
layers += fresh
= fresh

────────────────────
_ do update-layer
    - layer CompositingLayer

. owner = layer.owner
. next-bounds = owner.bounds
. next-opacity = owner.compositing-opacity
. geometry-changed = layer.has-bounds && layer.bounds != next-bounds
. same-size-move = geometry-changed && layer.bounds.size == next-bounds.size

layer.was-seen = true

if !layer.has-bounds
    layer.bounds = next-bounds
    layer.previous-bounds = next-bounds
    layer.has-bounds = true
    layer.needs-content-paint = true
    add-dirty-bounds(next-bounds)
else if geometry-changed
    layer.previous-bounds = layer.bounds
    layer.bounds = next-bounds
    add-dirty-bounds(layer.previous-bounds)
    add-dirty-bounds(layer.bounds)
    if !same-size-move
        layer.needs-content-paint = true

if layer.opacity != next-opacity
    layer.opacity = next-opacity
    add-dirty-bounds(layer.bounds)

if layer-subtree-paint-invalid(owner)
    if same-size-move && !layer-descendant-paint-invalid(owner)
        layer.needs-geometry-cleanup = true
    else
        layer.needs-content-paint = true
        add-dirty-bounds(layer.bounds)

────────────────────
_ do finish-layer-reconcile

. index Index = 0
while index < layers.length
    . layer = layers[index]
    if !layer.was-seen
        if layer.has-bounds
            add-dirty-bounds(layer.bounds)
        layers.remove(index)
    else
        index += 1

────────────────────
_ needs-base-paint
    - root Box

some(root.structural-children) • where base-subtree-paint-invalid(each)

────────────────────
_ do base-subtree-paint-invalid Bool
    - box Box

=? if !box.is-paint-visible
=? if box.requires-compositing-layer
=? true
    if box.$is-paint-invalid

= some(box.structural-children) • where base-subtree-paint-invalid(each)

────────────────────
_ do repaint-base
    - root Box

. base = base-canvas!
base.reset()
do use base
    base.offset((root.scroll-x, root.scroll-y))
    for child in root.structural-children
        if !child.requires-compositing-layer
            paint-with-compositing-layers-skipped(child, base)

base-paint-count += 1
//tui.layers.base-paints ++

────────────────────
_ do paint-with-compositing-layers-skipped
    - box Box
    - canvas Canvas

. previous = paint-skip-compositing-layers
paint-skip-compositing-layers = true
do finally
    paint-skip-compositing-layers = previous

box.paint(canvas)

────────────────────
_ do paint-dirty-layers

for layer in layers
    if layer.needs-content-paint
        paint-layer-content(layer)
    else if layer.needs-geometry-cleanup
        layer.owner.$is-layout-invalid = false
        layer.owner.mark-layout-arranged()
        layer.owner.did-paint()
        layer.needs-geometry-cleanup = false

────────────────────
_ do paint-layer-content
    - layer CompositingLayer

. size = layer.bounds.size
. needs-surface = true
if layer.surface
    . existing = layer.surface
    needs-surface = existing.width != size.width || existing.height != size.height
if needs-surface
    layer.surface = Canvas(size, true)

. surface = layer.surface!
surface.reset()
do use surface
    surface.offset((-layer.bounds.x, -layer.bounds.y))
    layer.owner.paint(surface)

layer.needs-content-paint = false
layer.needs-geometry-cleanup = false
layer-paint-count += 1
//tui.layers.content-paints ++

────────────────────
_ do compose-ordered
    - root Box

. final = final-canvas!
final.reset()
final.copy(base-canvas!)

do use final
    final.offset((root.scroll-x, root.scroll-y))
    compose-ordered-children(root, final)

has-dirty-bounds = false

────────────────────
_ do compose-ordered-children Bool
    - parent Box
    - canvas Canvas

. saw-layer = false
for child in parent.structural-children
    if !child.is-display-visible
        continue
    if !child.is-markup-shadow && !canvas.is-rect-visible(child.bounds)
        continue

    if child.requires-compositing-layer
        composite-layer(layer-for(child), canvas)
        saw-layer = true
    else
        if saw-layer
            paint-with-compositing-layers-skipped(child, canvas)
        if compose-ordered-descendants(child, canvas)
            saw-layer = true

= saw-layer

────────────────────
_ do compose-ordered-descendants Bool
    - box Box
    - canvas Canvas

if box.is-markup-shadow
    = compose-ordered-children(box, canvas)

. saw-layer = false
do use canvas
    canvas.clip(box.content-bounds)
    canvas.offset((box.scroll-x, box.scroll-y))
    saw-layer = compose-ordered-children(box, canvas)
= saw-layer

────────────────────
_ do composite-layer
    - layer CompositingLayer
    - canvas Canvas

if layer.opacity > 0%% && layer.surface
    canvas.composite(layer.surface, layer.bounds, layer.bounds.point, layer.opacity)
    composite-cell-count += layer.bounds.width * layer.bounds.height

────────────────────
_ do compose-dirty-bounds

=? if !has-dirty-bounds

. final = final-canvas!
final.copy(dirty-bounds, base-canvas!)

for layer in layers
    if layer.opacity > 0%% && layer.surface && rects-intersect(dirty-bounds, layer.bounds)
        final.composite(layer.surface, dirty-bounds, layer.bounds.point, layer.opacity)
        . cells = rect-intersection-area(dirty-bounds, layer.bounds)
        composite-cell-count += cells
        //tui.layers.composited-cells += cells

has-dirty-bounds = false

────────────────────
_ do add-dirty-bounds
    - rect Rect

=? if rect.width <= 0
=? if rect.height <= 0

if !has-dirty-bounds
    dirty-bounds = rect
    has-dirty-bounds = true
else
    dirty-bounds = union-rect(dirty-bounds, rect)

────────────────────
_ layer-subtree-paint-invalid Bool
    - box Box

|? box.$is-paint-invalid
    true
??
    layer-descendant-paint-invalid(box)

────────────────────
_ layer-descendant-paint-invalid Bool
    - box Box

some(box.structural-children) • where layer-subtree-paint-invalid(each)

━━━━━━━━━━━━━━━━━━━━
+ do paint-box-background
    - node Box
    - rect Rect
    - canvas Canvas

. painter = node.$background
if painter
    paint-background-painter(painter, node, rect, canvas)
else
    paint-default-background(node, rect, canvas)

━━━━━━━━━━━━━━━━━━━━
+ do paint-default-background
    - node Box
    - rect Rect
    - canvas Canvas

. color = node.$background-color
if !color
    canvas.background = null
    =
canvas.background = color
canvas.fill(rect)

━━━━━━━━━━━━━━━━━━━━
+ clamped-compositing-opacity
    - opacity Ratio

|? opacity <= 0%%
    0%%
|? opacity >= 1%%
    1%%
??
    opacity

━━━━━━━━━━━━━━━━━━━━
+ union-rect
    - a Rect
    - b Rect

Rect(left, top, right - left, bottom - top)

.. left = min(a.x, b.x)
.. top = min(a.y, b.y)
.. right = max(a.right, b.right)
.. bottom = max(a.bottom, b.bottom)

━━━━━━━━━━━━━━━━━━━━
_ CompositingLayer

+ owner Box
+ bounds Rect
+ previous-bounds Rect
+ opacity Ratio = 1%%
+ surface Canvas?
+ has-bounds = false
+ was-seen = false
+ needs-content-paint = true
+ needs-geometry-cleanup = false

────────────────────
+ This
    - owner

━━━━━━━━━━━━━━━━━━━━
_ do paint-background-painter
    - painter Painter
    - node Box
    - rect Rect
    - canvas Canvas

painter.paint(node, rect, canvas)

━━━━━━━━━━━━━━━━━━━━
_ rects-intersect
    - a Rect
    - b Rect

a.x < b.right && b.x < a.right && a.y < b.bottom && b.y < a.bottom

━━━━━━━━━━━━━━━━━━━━
_ rect-intersection-area Size
    - a Rect
    - b Rect

|? !rects-intersect(a, b)
    0
??
    (right - left) * (bottom - top)

.. left = max(a.x, b.x)
.. top = max(a.y, b.y)
.. right = min(a.right, b.right)
.. bottom = min(a.bottom, b.bottom)
