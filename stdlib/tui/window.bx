(import ./app)
(import ./box)
(import ./canvas)
(import ./colors)
(import ./events)
(import ./painter)
(import ./primitives)
(import ./shortcuts)
(import ./terminal)
(import /core/markup)
(import /math)
(import /os/signal)
(import /stream/aggregate)
(import /ui/input)
(blank)
; @markup-runtime-internal
(type + Window (is Box)
  (implements Inspectable)
  (implements TerminalPainter)
  (implements MarkupRootElement)
  (implements InputHost)
  (prop + app (? App))
  (prop + is-closed _ (= false))
  (prop + hovered-box (? Box))
  (prop + pressed-box (? Box))
  (prop + pressed-hit (? HitPath))
  (prop + focused-box (? Box))
  (prop + shortcuts (list Shortcut) (= (call active-window-shortcuts #shortcut-nodes #focused-box #modal-box)))
  (prop + terminal _
    (:=
      (call Terminal this
        (block
          (:is-full-screen true)
          (:is-mouse-handled true)
        )
      )
    )
  )
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (prop _ pressed-button _ (= (. PointerButton primary)))
  (prop _ pending-focus-box (? Box))
  (prop _ needs-focus-reveal _ (= false))
  (prop _ modal-box (? Box))
  (prop _ animation-frame-callbacks (list Doer))
  (prop _ shortcut-nodes (of Descendants Shortcut))
  (prop _ is-terminal-ready _ (= false))
  (prop _ did-initial-layout _ (= false))
  (prop _ compositor _ (:= (call LayerCompositor)))
  (fn-do + This _
    (= input-host (as this InputHost))
  )
  (subscribe (on (. terminal ready))
    ; The window is its own batch root. Markup construction mounts it eagerly; imperatively built
    ; windows mount here, and adoption prunes already-mounted subtrees. Mount dirtiness schedules
    ; the batch queue, and the first paint checkpoints it, so the initial styles settle without an
    ; explicit request.
    (call markup-mount-root this this)
    (blank)
    (= is-terminal-ready true)
    (call set-paint-scheduler (. terminal schedule-paint))
    (= size (. terminal view-size))
    (catch (call (. markup-batch-queue checkpoint)))
    (call focus (inline (call next-focus-candidate null)))
    (call schedule-paint)
  )
  (subscribe (on (. terminal closed))
    (call close
      (block
        (on-error (: error Error)
          (call unhandled-error error)
        )
      )
    )
  )
  (subscribe-for (on view-size (. terminal resized))
    (probe-count tui.resize.window-updates)
    (probe-group + tui.resize.window-apply)
    (= size view-size)
    (probe-group - tui.resize.window-apply)
  )
  (subscribe-for (on event (. terminal key-press))
    (call dispatch-key-press event)
  )
  (subscribe-for (on event (. terminal char))
    (call dispatch-key-input event)
  )
  (subscribe-for (on event (. terminal paste))
    (call dispatch-paste event)
  )
  (subscribe-for (on event (. terminal mouse-move))
    (call dispatch-pointer-event event)
  )
  (subscribe-for (on event (. terminal mouse-down))
    (call dispatch-pointer-event event)
  )
  (subscribe-for (on event (. terminal mouse-up))
    (call dispatch-pointer-event event)
  )
  (subscribe-for (on event (. terminal mouse-drag))
    (call dispatch-pointer-event event)
  )
  (subscribe-for (on event (. terminal scroll))
    ; for .direction on terminal.scroll
    (blank)
    (call dispatch-pointer-event event)
  )
  (fn-do + emit-tui-box-node _
    (call (. super emit-tui-box-node))
    (blank)
    (if focused-box
      (let box focused-box)
      (probe-log (: this tui.box.reference) (items: "focused" box (. (type-of box) concrete-name) (call (. box inspectable-summary))))
    )
    (if hovered-box
      (let box hovered-box)
      (probe-log (: this tui.box.reference) (items: "hovered" box (. (type-of box) concrete-name) (call (. box inspectable-summary))))
    )
    (if pressed-box
      (let box pressed-box)
      (probe-log (: this tui.box.reference) (items: "pressed" box (. (type-of box) concrete-name) (call (. box inspectable-summary))))
    )
    (if modal-box
      (let box modal-box)
      (probe-log (: this tui.box.reference) (items: "modal" box (. (type-of box) concrete-name) (call (. box inspectable-summary))))
    )
  )
  (fn-expr + hit-test _
    (param point Point)
    (. (call hit-path point) target)
  )
  (fn-expr + hit-path _
    (param point Point)
    (case? (and modal-box (. modal-box is-interactive-visible))
      (call hit-path-within modal-box point)
    )
    (default
      (call (. super hit-path) point)
    )
  )
  (fn-do + schedule-paint _
    (if is-terminal-ready
      (call (?. (catch? terminal) schedule-paint))
    )
  )
  (fn-do + dispatch-pointer-event _
    (param event MouseMoveEvent)
    (let hit (call hit-path (. event root-point)))
    (call update-hit-path hit)
    (call (. hit publish-pointer) event)
  )
  (fn-do + dispatch-pointer-event _
    (param event MouseDownEvent)
    (let hit (call hit-path (. event root-point)))
    (call update-hit-path hit)
    (call (. hit publish-pointer) event)
    (if (not (. event is-canceled))
      (if (== (. event button) (. PointerButton primary))
        (let target-to-focus (? Box) (call (of (. hit target ancestor-or-self) Box) (:where (. each can-focus))))
        (if target-to-focus
          (call focus (inline target-to-focus))
        )
      )
      (call clear-pressed-path)
      (= pressed-hit hit)
      (= pressed-box (. hit target))
      (= pressed-button (. event button))
      (= (?. pressed-box is-pressed) true)
    )
  )
  (fn-expr _ pressed-path-is-live Bool
    (case? pressed-hit
      (call (of (. pressed-hit target ancestor-or-self) Box) (:where (== each this)))
    )
    (default
      false
    )
  )
  (fn-do _ clear-pressed-path _
    (= (?. pressed-box is-pressed) false)
    (= pressed-box null)
    (= pressed-hit null)
  )
  (fn-do + dispatch-pointer-event _
    (param event MouseUpEvent)
    (let hit (call hit-path (. event root-point)))
    (call update-hit-path hit)
    (blank)
    (if (not (call pressed-path-is-live))
      (call clear-pressed-path)
    )
    (let matching-hit (only-if pressed-hit (if (== pressed-button (. event button)))))
    (let release-hit (?? matching-hit hit))
    (call (. release-hit publish-pointer) event)
    (blank)
    (let is-release-target (and (!= matching-hit null) (== (. hit target) pressed-box)))
    (if (and (not (. event is-canceled)) is-release-target (== (. event button) (. PointerButton primary)))
      (let click-event (call ClickEvent (. event root-point)))
      (call (. release-hit publish-click) click-event)
    )
    (blank)
    (if matching-hit
      (call clear-pressed-path)
    )
  )
  (fn-do + dispatch-pointer-event _
    (param event MouseDragEvent)
    (let hit (call hit-path (. event root-point)))
    (call update-hit-path hit)
    (blank)
    (if (not (call pressed-path-is-live))
      (call clear-pressed-path)
    )
    (let drag-hit (?? pressed-hit hit))
    (call (. drag-hit publish-pointer) event)
  )
  (fn-do + dispatch-pointer-event _
    (param event ScrollEvent)
    (let hit (call hit-path (. event root-point)))
    (call update-hit-path hit)
    (call (. hit publish-pointer) event)
    (if (and (not (. event is-canceled)) (call route-scroll-event event (. hit target)))
      (call (. event cancel))
    )
  )
  (fn-do + markup-attach-child _
    (param child Box)
    (param anchor (? Box))
    (call (. super markup-attach-child) child anchor)
    (call refresh-modal-box)
  )
  (fn-do + markup-detach-child _
    (param child Box)
    (if (== modal-box child)
      (if (call (of (?. focused-box ancestor-or-self) Box) (:where (== each child)))
        (= (?. focused-box is-focused) false)
        (= focused-box null)
      )
    )
    (blank)
    (call (. super markup-detach-child) child)
    (call refresh-modal-box)
  )
  (fn-do + request-animation-frame _
    (param callback Doer)
    (+= animation-frame-callbacks callback)
    (let maybe-terminal (catch? terminal))
    (if (and maybe-terminal is-terminal-ready)
      (if (not did-initial-layout)
        (call (. maybe-terminal schedule-paint))
        (return)
      )
      (call (. maybe-terminal schedule-animation-frame))
      (else
        (call schedule-paint)
      )
    )
  )
  (fn-do + close _
    (return-if (if is-closed))
    (= is-closed true)
    (call close-box)
    (blank)
    (let maybe-terminal (catch? terminal))
    (if maybe-terminal
      (catch (call (. maybe-terminal close)))
    )
    (call (?. app window-closed))
  )
  (fn-do + paint _
    (param canvas Canvas)
    (probe-group + tui.frame.animation)
    (let should-flush-animation did-initial-layout)
    (if should-flush-animation
      (call flush-animation-frames-before-paint)
    )
    (probe-group - tui.frame.animation)
    (blank)
    ; Root-controlled phase order: checkpoint the batch so phases observe stable computed style, then
    ; run layout top-down before painting. A clean queue, a clean store, and a clean tree all exit
    ; immediately, so no pending-check is needed here; the layout walk arranges only raised subtrees
    ; and clears each bit as the work completes.
    (probe-group + tui.frame.markup-checkpoint)
    (catch (call (. markup-batch-queue checkpoint)))
    (probe-group - tui.frame.markup-checkpoint)
    (call settle-pending-focus)
    (catch (call validate-focus))
    (probe-group + tui.frame.layout)
    (call update-layout)
    (probe-group - tui.frame.layout)
    (if (and (not should-flush-animation) animation-frame-callbacks)
      (call flush-initial-animation-frames-before-paint)
    )
    (= did-initial-layout true)
    (call reveal-pending-focus)
    (blank)
    (probe-group + tui.frame.paint-tree)
    (call (. compositor paint) this canvas)
    (probe-group - tui.frame.paint-tree)
    (blank)
    (call did-paint)
    (blank)
    (if (and (not should-flush-animation) animation-frame-callbacks)
      (call (?. (catch? terminal) schedule-animation-frame))
    )
    (blank)
    (return (call focused-paint-result))
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    ; The window is the root phase controller: settling raised persistent domain bits on the nodes
    ; whose declared properties changed. Pending layout or paint state schedules a paint; the paint
    ; pass runs layout top-down first when any layout is pending, and each phase clears its bits as
    ; the work completes.
    (if (or (. flush is-layout-invalid) (. flush is-paint-invalid))
      (catch (call schedule-paint))
    )
    (call refresh-modal-box)
    (call settle-pending-focus)
  )
  (fn-do _ size _ :set (param size PSize)
    (= width (. size width))
    (= height (. size height))
    (= bounds (call Rect width height (tuple 0 0)))
    ;  //this:tui.layout.invalidate-size
    (call invalidate-layout)
  )
  (fn-do + open _
    (probe-log (: this tui.box.root) (items: (. (type-of this) concrete-name) (call inspectable-summary)))
    (blank)
    (for (on sig sig-int)
      (let interrupt (call KeyInputEvent 'c' (call PointerModifiers false true)))
      (call dispatch-key-input interrupt)
      (if (not (. interrupt is-canceled))
        (catch (call close))
        (call request-process-termination 130)
      )
      (if is-closed
        (break)
      )
    )
  )
  (fn-do + focus _
    (param box (? Box))
    (let focus-box box)
    (if (not focus-box)
      (= pending-focus-box null)
      (call apply-focus null)
      (return)
    )
    (let target focus-box)
    (return-if (if (not (call is-in-focus-scope target))))
    (blank)
    (if (not (. target can-focus))
      (= pending-focus-box target)
      (return)
    )
    (= pending-focus-box null)
    (call apply-focus target)
  )
  (fn-do + release-input-inside _
    (param subtree Box)
    (let focused-inside (call (of (?. focused-box ancestor-or-self) Box) (:where (== (. each uid) (. subtree uid)))))
    (let pending-inside (call (of (?. pending-focus-box ancestor-or-self) Box) (:where (== (. each uid) (. subtree uid)))))
    (if (or focused-inside pending-inside)
      (call focus (inline null))
    )
    (blank)
    (if (call (of (?. pressed-box ancestor-or-self) Box) (:where (== (. each uid) (. subtree uid))))
      (= (?. pressed-box is-pressed) false)
      (= pressed-box null)
      (= pressed-hit null)
    )
    (blank)
    (if (call (of (?. hovered-box ancestor-or-self) Box) (:where (== (. each uid) (. subtree uid))))
      (= (?. hovered-box is-hovered) false)
      (= hovered-box null)
    )
  )
  (fn-do + settle-pending-focus _
    (let focus-box pending-focus-box)
    (return-if (if (not focus-box)))
    (blank)
    (let target focus-box)
    (if (not (call is-in-focus-scope target))
      (= pending-focus-box null)
      (return)
    )
    (if (. target can-focus)
      (= pending-focus-box null)
      (call apply-focus target)
    )
  )
  (fn-do + apply-focus _
    (param box (? Box))
    (if (!= box focused-box)
      (= (?. focused-box is-focused) false)
      (= focused-box box)
      (= (?. box is-focused) true)
      (if box
        (= needs-focus-reveal true)
        (call schedule-paint)
      )
    )
  )
  (fn-do _ reveal-pending-focus _
    (return-if (if (not needs-focus-reveal)))
    (= needs-focus-reveal false)
    (call (?. focused-box reveal-focus))
  )
  (fn-do + validate-focus _
    (if (not (call is-valid-focused-box focused-box))
      (= (?. focused-box is-focused) false)
      (= focused-box null)
    )
  )
  (fn-expr + is-valid-focused-box _
    (param box (? Box))
    (case? (not box)
      true
    )
    (default
      (and (. live can-focus) (call is-in-focus-scope live))
    )
    (where
      (lazy live box)
    )
  )
  (fn-expr + is-in-focus-scope Bool
    (param box Box)
    (call (of (. box ancestor-or-self) Box) (:where (== (. each uid) (. scope uid))))
    (where
      (lazy scope (call focus-scope))
    )
  )
  (fn-do + move-focus _
    (param going-backward _ (= false))
    (catch (call (. markup-batch-queue checkpoint)))
    (let scope (call focus-scope))
    (let candidate (call (. scope next-focus-candidate) focused-box going-backward))
    (call focus (inline candidate))
  )
  (fn-expr + focus-scope _
    (?? modal-box this)
  )
  (fn-do + refresh-modal-box _
    (let next-modal (call active-modal-root))
    (blank)
    (if (!= next-modal modal-box)
      (let cleared-modal-focus false)
      (if modal-box
        (let old-modal modal-box)
        (if (call (of (?. focused-box ancestor-or-self) Box) (:where (== each old-modal)))
          (= (?. focused-box is-focused) false)
          (= focused-box null)
          (= cleared-modal-focus true)
        )
      )
      (blank)
      (= modal-box next-modal)
      (blank)
      (if modal-box
        (let new-modal modal-box)
        (if (or (not focused-box) (not (call is-in-focus-scope focused-box)))
          (call focus (inline (call (. new-modal next-focus-candidate) null)))
        )
        (else
          (if (or cleared-modal-focus (not (call is-valid-focused-box focused-box)))
            (= (?. focused-box is-focused) false)
            (= focused-box null)
            (call focus (inline (call next-focus-candidate null)))
          )
        )
      )
      (blank)
      (call invalidate-layout)
      (call invalidate-paint)
    )
  )
  (fn-do + flush-animation-frames _
    (let count (. animation-frame-callbacks length))
    (while (and count animation-frame-callbacks)
      (let callback (call (. animation-frame-callbacks pop-first)))
      (call callback
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
      (-= count 1)
    )
  )
  (fn-expr + focused-paint-result _
    (case? (and box (. live shows-terminal-cursor))
      (call TerminalPaintResult (. live cursor-point) true)
    )
    (default
      (call TerminalPaintResult (tuple 0 0) false)
    )
    (where
      (lazy box focused-box)
      (lazy live box)
    )
  )
  (fn-do + flush-animation-frames-before-paint _
    (call flush-animation-frames)
  )
  (fn-do + flush-initial-animation-frames-before-paint _
    ; The first RAF batch needs settled bounds, but it still has to land before the first compositor
    ; paint. Mark the window layout-ready so callbacks that requeue RAFs use the normal frame scheduler.
    (= did-initial-layout true)
    (probe-group + tui.frame.animation)
    (call flush-animation-frames-before-paint)
    (probe-group - tui.frame.animation)
    (probe-group + tui.frame.markup-checkpoint)
    (catch (call (. markup-batch-queue checkpoint)))
    (probe-group - tui.frame.markup-checkpoint)
    (call settle-pending-focus)
    (catch (call validate-focus))
    (probe-group + tui.frame.layout)
    (call update-layout)
    (probe-group - tui.frame.layout)
  )
  (fn-do + dispatch-key-press _
    (param event KeyPressEvent)
    (call prepare-input-dispatch)
    (if focused-box
      (call publish-focused-input this focused-box event)
    )
    (blank)
    (if (not (. event is-canceled))
      (if (== (. event key) (. Key tab))
        (call move-focus (. event modifiers shift))
        (call (. event cancel))
        (else
          (call dispatch-shortcut-key-press (call active-shortcuts) event)
        )
      )
    )
    (call settle-input-dispatch)
  )
  (fn-do + dispatch-key-input _
    (param event KeyInputEvent)
    (call prepare-input-dispatch)
    (if focused-box
      (call publish-focused-input this focused-box event)
    )
    (if (not (. event is-canceled))
      (call dispatch-shortcut-key-input (call active-shortcuts) event)
    )
    (call settle-input-dispatch)
  )
  (fn-do + dispatch-paste _
    (param event PasteEvent)
    (call prepare-input-dispatch)
    (if focused-box
      (call publish-focused-input this focused-box event)
    )
    (call settle-input-dispatch)
  )
  (fn-do _ prepare-input-dispatch _
    (catch (call (. markup-batch-queue checkpoint)))
    (call settle-pending-focus)
    (catch (call validate-focus))
  )
  (fn-do + settle-input-dispatch _
    (catch (call (. markup-batch-queue checkpoint)))
    (call settle-pending-focus)
  )
  (fn-expr + active-shortcuts _
    (call active-window-shortcuts shortcut-nodes focused-box modal-box)
  )
  (fn-do _ update-hit-test _
    (param point Point)
    (call update-hit-path (call hit-path point))
  )
  (fn-do _ update-hit-path _
    (param path HitPath)
    (let hit (. path target))
    (if (!= hit hovered-box)
      (= (?. hovered-box is-hovered) false)
      (blank)
      (= hovered-box hit)
      (= (. hit is-hovered) true)
    )
  )
)
