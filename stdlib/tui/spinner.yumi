━━━━━━━━━━━━━━━━━━━━
+ Spinner is Box

+ frames = SpinnerFrames.braille
+ interval = 120ms
+ colorful = true

_ ticker = Timer(interval)

────────────────────

<This • flex-col
    if #colorful
        <Label
            text = spinner-frame-character(#frames, spinner-animation-frame((##ticker), #interval))
            color = spinner-frame-color(spinner-animation-frame((##ticker), #interval))
    else
        <Label
            text = spinner-frame-character(#frames, spinner-animation-frame((##ticker), #interval))

╌╌╌╌╌╌╌╌╌╌ is MarkupElement ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do close

super.close()
ticker.end-using()

━━━━━━━━━━━━━━━━━━━━
+ SpinnerFrames is Union

| braille
| dots
| circle
| arc
| quadrant
| arrows

━━━━━━━━━━━━━━━━━━━━
+ spinner-animation-frame Size
    - elapsed Microseconds
    - interval Microseconds

|? interval <= 0
    0
??
    (elapsed / interval) as Size

━━━━━━━━━━━━━━━━━━━━
_ spinner-frame-character String
    - frames SpinnerFrames
    - index Size

set[index % set.length] as String

.. set = spinner-frame-set(frames)

━━━━━━━━━━━━━━━━━━━━
_ spinner-frame-set String
    - frames SpinnerFrames

match frames
    | SpinnerFrames.dots
        "⠁⠂⠄⡀⢀⠠⠐⠈"
    | SpinnerFrames.circle
        "◐◓◑◒"
    | SpinnerFrames.arc
        "◜◠◝◞◡◟"
    | SpinnerFrames.quadrant
        "▖▘▝▗"
    | SpinnerFrames.arrows
        "←↖↑↗→↘↓↙"
    ??
        "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

━━━━━━━━━━━━━━━━━━━━
_ spinner-frame-color AnsiColor
    - index Size

match index % 6
    | 0
        salmon
    | 1
        orange
    | 2
        gold
    | 3
        chartreuse
    | 4
        sky
    ??
        pink
