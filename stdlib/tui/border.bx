(import ./box)
(import ./canvas)
(import ./primitives)

(type + BorderPainter
  (fn-expr + border-insets _
    (param node Box)
    (call Insets 0 0 0 0)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
  )
)

(type + DefaultBorderPainter (is BorderPainter)
  (fn-expr + border-insets Insets
    (param node Box)
    (match (. node $border-style)
      (case= (. BorderStyle none)
        (call Insets 0 0 0 0)
      )
      (default
        (call Insets 1 1 1 1)
      )
    )
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (return-if (if (== (. node $border-style) (. BorderStyle none))))
    (return-if (if (<= (. rect width) 0)))
    (return-if (if (<= (. rect height) 0)))
    (blank)
    (let chars (call border-chars (. node $border-style)))
    (call paint-border-frame rect chars (. node $border-color) canvas)
  )
)

(type + BorderStyle (is Union)
  (variant none)
  (variant single)
  (variant rounded)
  (variant double)
  (variant heavy)
  (variant dashed)
)

(type + BorderChars (is Tuple)
  (prop + top-left String)
  (prop + top-right String)
  (prop + bottom-left String)
  (prop + bottom-right String)
  (prop + horizontal String)
  (prop + vertical String)
)

(fn-expr + border-chars _
  (param style BorderStyle)
  (match style
    (case (. BorderStyle rounded)
      (call BorderChars "╭" "╮" "╰" "╯" "─" "│")
    )
    (case (. BorderStyle double)
      (call BorderChars "╔" "╗" "╚" "╝" "═" "║")
    )
    (case (. BorderStyle heavy)
      (call BorderChars "┏" "┓" "┗" "┛" "━" "┃")
    )
    (case (. BorderStyle dashed)
      (call BorderChars "┌" "┐" "└" "┘" "╌" "╎")
    )
    (default
      (call BorderChars "┌" "┐" "└" "┘" "─" "│")
    )
  )
)

(fn-do + paint-box-border _
  (param node Box)
  (param rect Rect)
  (param canvas Canvas)
  (call (. node $border paint) node rect canvas)
)

(fn-do + paint-border-frame _
  (param rect Rect)
  (param chars BorderChars)
  (param color AnsiColor)
  (param canvas Canvas)
  (return-if (if (<= (. rect width) 0)))
  (return-if (if (<= (. rect height) 0)))
  (blank)
  (do-use canvas
    (= (. canvas text-color) color)
    (blank)
    (if (and (== (. rect width) 1) (== (. rect height) 1))
      (call print-border-cell canvas (. rect x) (. rect y) (. chars top-left))
      (return)
    )
    (if (== (. rect height) 1)
      (call paint-border-row
        (block
          (arg canvas)
          (arg (. rect x))
          (arg (. rect y))
          (arg (. rect width))
          (arg (. chars top-left))
          (arg (. chars horizontal))
          (arg (. chars top-right))
        )
      )
      (return)
    )
    (if (== (. rect width) 1)
      (call paint-border-column
        (block
          (arg canvas)
          (arg (. rect x))
          (arg (. rect y))
          (arg (. rect height))
          (arg (. chars top-left))
          (arg (. chars vertical))
          (arg (. chars bottom-left))
        )
      )
      (return)
    )
    (call paint-border-row
      (block
        (arg canvas)
        (arg (. rect x))
        (arg (. rect y))
        (arg (. rect width))
        (arg (. chars top-left))
        (arg (. chars horizontal))
        (arg (. chars top-right))
      )
    )
    (call paint-border-row
      (block
        (arg canvas)
        (arg (. rect x))
        (arg (- (. rect bottom) 1))
        (arg (. rect width))
        (arg (. chars bottom-left))
        (arg (. chars horizontal))
        (arg (. chars bottom-right))
      )
    )
    (for (in y (..< (+ (. rect y) 1) (- (. rect bottom) 1)))
      (call print-border-cell canvas (. rect x) y (. chars vertical))
      (call print-border-cell canvas (- (. rect right) 1) y (. chars vertical))
    )
  )
)

(fn-do _ paint-border-row _
  (param canvas Canvas)
  (param x Coord)
  (param y Coord)
  (param width Coord)
  (param left String)
  (param middle String)
  (param right String)
  (call print-border-cell canvas x y left)
  (if (> width 1)
    (for (in cell-x (..< (+ x 1) (- (+ x width) 1)))
      (call print-border-cell canvas cell-x y middle)
    )
    (call print-border-cell canvas (- (+ x width) 1) y right)
  )
)

(fn-do _ paint-border-column _
  (param canvas Canvas)
  (param x Coord)
  (param y Coord)
  (param height Coord)
  (param top String)
  (param middle String)
  (param bottom String)
  (call print-border-cell canvas x y top)
  (if (> height 1)
    (for (in cell-y (..< (+ y 1) (- (+ y height) 1)))
      (call print-border-cell canvas x cell-y middle)
    )
    (call print-border-cell canvas x (- (+ y height) 1) bottom)
  )
)

(fn-do _ print-border-cell _
  (param canvas Canvas)
  (param x Coord)
  (param y Coord)
  (param text String)
  (call (. canvas move) (tuple x y))
  (call (. canvas print) text)
)
