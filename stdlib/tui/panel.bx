(import ./border)
(import ./box)
(import ./colors)
(import ./layout)
(import ./position)
(import ./primitives)
(import ./styles)
(import ./theme)

(style-extend TUIDefaultTheme
  (using BoxPaint)
  (using BoxBorder)
  (using BoxSpacing)
  (rule GroupPanel
    (rule group-panel-frame
      (= background-color (call AnsiColor 0))
      (= border-style (. BorderStyle rounded))
    )
    (blank)
    (rule group-panel-header
      (= background-color (call AnsiColor 0))
      (= padding-left 1)
      (= padding-right 1)
    )
    (blank)
    (rule group-panel-body
      (= padding-top 1)
      (= padding-right 1)
      (= padding-bottom 1)
      (= padding-left 1)
    )
  )
)

(type + GroupPanel (is Box)
  (rule This
    (rule group-panel-frame (• flex-col))
    (blank)
    (rule group-panel-header (• flow-row) (• absolute)
      (= left (call (. PositionOffset coord) 2))
      (= top (call (. PositionOffset coord) 0))
    )
    (blank)
    (rule group-panel-body (• flex-col))
  )
  (content
    (<> This (• flex-col)
      (<> Box (• group-panel-frame) (• flex 1)
        (<> Box (• group-panel-body) (• flex 1)
          (+<> Box)
        )
      )
      (blank)
      (<> Box (• group-panel-header)
        (+<> Box (id: header))
      )
    )
  )
)
