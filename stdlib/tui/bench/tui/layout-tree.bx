; benchmark.meta description: Computes a deterministic terminal layout tree.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,compile-timing
(blank)
(import /core/markup)
(import /core/style)
(import /tui/box)
(import /tui/canvas)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let root (call BenchRoot))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 96 32))
  (blank)
  (let labels (list Label))
  (for (in row-index (..< 0 8))
    (let row (call BenchRow))
    (call markup-append root row)
    (blank)
    (for (in column-index (..< 0 6))
      (let cell (call BenchCell))
      (call markup-append row cell)
      (blank)
      (let title (call Label (str "cell-" row-index "-" column-index)))
      (let body (call Label (str "value " (+ (* row-index 10) column-index))))
      (call markup-append cell title)
      (call markup-append cell body)
      (+= labels title)
      (+= labels body)
    )
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let canvas (call Canvas (call PSize 96 32)))
  (let checksum Size 0)
  (for (in frame (..< 0 36))
    (for (in index (..< 0 (. labels length)))
      (= (. ([] labels index) text) (str "f" frame ":" index ":" (% (+ frame index) 17)))
    )
    (blank)
    (call (. root update-layout))
    (call (. root paint) canvas)
    (+= checksum (+ (. root inner-height) (. root inner-width) (. ([] labels (% frame (. labels length))) text length)))
  )
  (blank)
  (print (str "bench-result tui/layout-tree checksum=" checksum))
)

(type + BenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flex-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + BenchRow (is Box)
  (rule This
    (= layout flex-row)
    (= flex 1)
  )
)

(type + BenchCell (is Box)
  (rule This
    (= layout flex-col)
    (= flex 1)
  )
)
