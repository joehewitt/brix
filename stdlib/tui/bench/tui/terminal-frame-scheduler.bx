; benchmark.meta description: Measures terminal frame scheduler invalidation latency, pacing jitter, coalescing, and overrun skipping.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gc-runtime,tui,tui-fps,ui-smoothness,compile-timing
(blank)
(import /BxCore/BxCore.h)
(import /stream/sort)
(import /time/duration)
(import /time/timer)
(blank)

(main
  (let immediate-count Size 60)
  (let coalesced-request-count Size 24)
  (let animation-count Size 36)
  (let overrun-count Size 6)
  (let scheduler-interval 4ms)
  (let scheduler-interval-ns (call scheduler-interval-nanoseconds))
  (blank)
  (let immediate (call ImmediateFrameRecorder))
  (let immediate-scheduler (call (. scheduler-interval animation-loop) (:with (. immediate frame))))
  (blank)
  (for (in index (..< 0 immediate-count))
    (= (. immediate request-time) (call monotonic-time-nanoseconds))
    (call (. immediate-scheduler request-now))
    (call (. immediate done wait))
  )
  (call (. immediate-scheduler cancel))
  (blank)
  (let coalesced (call CoalescedFrameRecorder))
  (let coalesced-scheduler (call (. scheduler-interval animation-loop) (:with (. coalesced frame))))
  (blank)
  (for (in index (..< 0 coalesced-request-count))
    (call (. coalesced-scheduler request-now))
  )
  (call (. coalesced done wait))
  (call (. coalesced-scheduler cancel))
  (blank)
  (let animation (call AnimationFrameRecorder animation-count))
  (let animation-scheduler (call (. scheduler-interval animation-loop) (:with (. animation frame))))
  (= (. animation scheduler) animation-scheduler)
  (call (. animation-scheduler request-next))
  (call (. animation done wait))
  (call (. animation-scheduler cancel))
  (blank)
  (let overrun (call OverrunFrameRecorder overrun-count (* (as scheduler-interval Nanoseconds) 3)))
  (let overrun-scheduler (call (. scheduler-interval animation-loop) (:with (. overrun frame))))
  (= (. overrun scheduler) overrun-scheduler)
  (call (. overrun-scheduler request-next))
  (call (. overrun done wait))
  (call (. overrun-scheduler cancel))
  (blank)
  (let animation-intervals (call frame-intervals (. animation times)))
  (let overrun-intervals (call frame-intervals (. overrun times)))
  (let invalidate-p50-us (call percentile-us (. immediate latencies) 50))
  (let invalidate-p95-us (call percentile-us (. immediate latencies) 95))
  (let invalidate-max-us (call max-us (. immediate latencies)))
  (let interval-p50-us (call percentile-us animation-intervals 50))
  (let interval-p95-us (call percentile-us animation-intervals 95))
  (let interval-max-us (call max-us animation-intervals))
  (let coalesced-invalidations (- coalesced-request-count (. coalesced callbacks)))
  (let dropped-frames (call dropped-frame-count overrun-intervals scheduler-interval-ns))
  (blank)
  (probe-count tui.bench.terminal.invalidate-p50-us invalidate-p50-us)
  (probe-count tui.bench.terminal.invalidate-p95-us invalidate-p95-us)
  (probe-count tui.bench.terminal.invalidate-max-us invalidate-max-us)
  (probe-count tui.bench.terminal.interval-p50-us interval-p50-us)
  (probe-count tui.bench.terminal.interval-p95-us interval-p95-us)
  (probe-count tui.bench.terminal.interval-max-us interval-max-us)
  (probe-count tui.bench.terminal.coalesced-invalidations coalesced-invalidations)
  (probe-count tui.bench.terminal.dropped-frames dropped-frames)
  (probe-count tui.bench.mutations (+ immediate-count coalesced-request-count animation-count overrun-count))
  (blank)
  (let checksum (* (. immediate latencies length) 1000000))
  (+= checksum (+ (* (. animation times length) 1000) (. overrun times length)))
  (blank)
  (call C:brixBenchCollect)
  (blank)
  (print (str "bench-result tui/terminal-frame-scheduler checksum=" checksum))
)

(type + ImmediateFrameRecorder
  (prop + request-time U64)
  (prop + latencies (list U64))
  (prop + done _ (:= (call Semaphore)))
  (fn-do + frame _
    (let frame-start (call monotonic-time-nanoseconds))
    (+= latencies (- (call monotonic-time-nanoseconds) request-time))
    (probe-count tui.bench.frames)
    (call spend-frame-budget frame-start)
    (call (. done post))
  )
)

(type + CoalescedFrameRecorder
  (prop + callbacks Size (= 0))
  (prop + done _ (:= (call Semaphore)))
  (fn-do + frame _
    (let frame-start (call monotonic-time-nanoseconds))
    (+= callbacks 1)
    (probe-count tui.bench.frames)
    (call spend-frame-budget frame-start)
    (call (. done post))
  )
)

(type + AnimationFrameRecorder
  (prop + frame-count Size)
  (prop + frames Size (= 0))
  (prop + scheduler (? AnimationLoop))
  (prop + times (list U64))
  (prop + done _ (:= (call Semaphore)))
  (fn-do + This _
    (param frame-count _)
  )
  (fn-do + frame _
    (let frame-start (call monotonic-time-nanoseconds))
    (+= times (call monotonic-time-nanoseconds))
    (+= frames 1)
    (probe-count tui.bench.frames)
    (call spend-frame-budget frame-start)
    (if (< frames frame-count)
      (call (. (!! scheduler) request-next))
      (else
        (call (. done post))
      )
    )
  )
)

(type + OverrunFrameRecorder
  (prop + frame-count Size)
  (prop + overrun-duration Nanoseconds)
  (prop + frames Size (= 0))
  (prop + scheduler (? AnimationLoop))
  (prop + times (list U64))
  (prop + done _ (:= (call Semaphore)))
  (fn-do + This _
    (param frame-count _)
    (param overrun-duration _)
  )
  (fn-do + frame _
    (let frame-start (call monotonic-time-nanoseconds))
    (+= times (call monotonic-time-nanoseconds))
    (+= frames 1)
    (probe-count tui.bench.frames)
    (if (< frames frame-count)
      (call busy-wait overrun-duration)
      (call spend-frame-budget frame-start)
      (call (. (!! scheduler) request-next))
      (else
        (call spend-frame-budget frame-start)
        (call (. done post))
      )
    )
  )
)

(fn-do + spend-frame-budget _
  (param frame-start U64)
  (let elapsed (- (call monotonic-time-nanoseconds) frame-start))
  (if (< elapsed (call scheduler-interval-nanoseconds))
    (call C:brixGCFrameBudget (- (call scheduler-interval-nanoseconds) elapsed))
  )
)

(fn-expr + scheduler-interval-nanoseconds U64
  (as (as 4ms Nanoseconds) U64)
)

(fn-do + frame-intervals _
  (param times (list U64))
  (let result (list U64))
  (for (in index (..< 1 (. times length)))
    (+= result (- ([] times index) ([] times (- index 1))))
  )
  (return result)
)

(fn-expr + percentile-us _
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted index) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(fn-do + max-us _
  (param values (list U64))
  (let maximum U64)
  (for (in value values)
    (if (> value maximum)
      (= maximum value)
    )
  )
  (return (/ maximum 1000))
)

(fn-do + dropped-frame-count _
  (param intervals (list U64))
  (param target-ns U64)
  (if (not target-ns)
    (return 0)
  )
  (blank)
  (let dropped U64)
  (for (in interval intervals)
    (if (> interval (+ target-ns (/ target-ns 2)))
      (+= dropped (- (/ interval target-ns) 1))
    )
  )
  (return dropped)
)

(fn-do + busy-wait _
  (param duration Nanoseconds)
  (let end-time (+ (call monotonic-time-nanoseconds) (as duration U64)))
  (let spin U64)
  (while (< (call monotonic-time-nanoseconds) end-time)
    (+= spin 1)
  )
)
