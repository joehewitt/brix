; benchmark.meta description: Edits one TUI text leaf at depth between layout frames.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,tui-fps,compile-timing
(blank)
(import /core/markup)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let root (call BenchDeepLeafRoot))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 100 32))
  (blank)
  (let parent Box root)
  (for (in depth (..< 0 96))
    (let child (call BenchDeepNode))
    (call markup-append parent child)
    (= parent child)
  )
  (blank)
  (let leaf (call Label "deep-leaf"))
  (call markup-append parent leaf)
  (= (. root leaf) leaf)
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (blank)
  (let checksum Size 0)
  (for (in frame (..< 0 128))
    (= (?. (. root leaf) text) (str "deep-leaf-" frame))
    (call (. root markup-batch-queue checkpoint))
    (call (. root update-layout))
    (probe-count tui.bench.frames)
    (probe-count tui.bench.mutations)
    (+= checksum (+ (. root inner-width) (. root inner-height) (?? (. (?. (. root leaf) text) length) 0) frame))
  )
  (blank)
  (print (str "bench-result tui/layout-deep-leaf-edit checksum=" checksum))
)

(type + BenchDeepLeafRoot (is Box)
  (implements MarkupRootElement)
  (prop + leaf (? TextBox))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + BenchDeepNode (is Box)
  (rule This
    (= layout flow-col)
  )
)
