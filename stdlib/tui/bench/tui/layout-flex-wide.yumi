`benchmark.meta description: Measures a wide horizontal Flex layout with fixed and flexible cells.
`benchmark.meta timing: recommended
`benchmark.meta profiles: tui,compile-timing

/tui/box
/tui/layout
/tui/primitives
/tui/text

<BenchFlexWideRoot root
    for index in 0 .. < 360
        <BenchFlexWideCell
            <Label "c$index"

root.markup-batch-queue.checkpoint()
root.bounds = Rect(0, 0, 160, 30)

. checksum Size = 0
for frame in 0 .. < 64
    root.update-layout()
    checksum += root.inner-height + root.inner-width + frame

-- "bench-result tui/layout-flex-wide checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ BenchFlexWideRoot is Box
    is MarkupRootElement

+ markup-batch-queue := MarkupBatchQueue(this)

• This
    layout = flex-row

╌╌╌╌╌╌╌╌╌╌ is MarkupRootElement ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
+ BenchFlexWideCell is Box

• This
    layout = flow-col
    flex = 1
