`benchmark.meta description: Computes a deterministic terminal layout tree.
`benchmark.meta timing: recommended
`benchmark.meta profiles: tui,compile-timing

/core/markup
/core/style
/tui/box
/tui/canvas
/tui/layout
/tui/primitives
/tui/text

. root = BenchRoot()
markup-mount-root(root, root)
root.bounds = Rect(0, 0, 96, 32)

. labels [Label]
for row-index in 0 .. < 8
    . row = BenchRow()
    markup-append(root, row)

    for column-index in 0 .. < 6
        . cell = BenchCell()
        markup-append(row, cell)

        . title = Label("cell-${row-index}-$column-index")
        . body = Label("value ${row-index * 10 + column-index}")
        markup-append(cell, title)
        markup-append(cell, body)
        labels += title
        labels += body

root.markup-batch-queue.checkpoint()

. canvas = Canvas(PSize(96, 32))
. checksum Size = 0
for frame in 0 .. < 36
    for index in 0 .. < labels.length
        labels[index].text = "f$frame:$index:${(frame + index) % 17}"

    root.update-layout()
    root.paint(canvas)
    checksum += root.inner-height + root.inner-width + labels[frame % labels.length].text.length

-- "bench-result tui/layout-tree checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ BenchRoot is Box
    is MarkupBatch

+ markup-batch-queue := MarkupBatchQueue(this)

