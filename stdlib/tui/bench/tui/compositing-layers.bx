; benchmark.meta description: Moves a retained opacity compositing layer over static TUI content.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,tui-fps,compile-timing
(blank)
(import /core/markup)
(import /graphics/color)
(import /tui/box)
(import /tui/canvas)
(import /tui/colors)
(import /tui/primitives)
(import /tui/painter)
(import /units)
(blank)

(main
  (<> BenchCompositingApp (id: root))
  (blank)
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 120 36))
  (call (. root markup-batch-queue checkpoint))
  (call (. root arrange-static-content))
  (blank)
  (let compositor (call LayerCompositor))
  (let previous-canvas (? Canvas))
  (let checksum Size 0)
  (blank)
  (for (in frame (..< 0 240))
    (call (. root move-overlay) frame)
    (call (. root markup-batch-queue checkpoint))
    (blank)
    (let canvas (call Canvas (. root bounds size)))
    (call (. compositor paint) root canvas)
    (blank)
    (let output-size Size 0)
    (if previous-canvas
      (let diff (call (. canvas dump-diff) previous-canvas))
      (= output-size (. diff size))
      (probe-count tui.bench.canvas.diff-dumps)
      (probe-count tui.bench.canvas.diff-bytes output-size)
      (if (> output-size 0)
        (probe-count tui.bench.canvas.changed-diffs)
      )
      (else
        (let full (call (. canvas dump)))
        (= output-size (. full size))
        (probe-count tui.bench.canvas.full-dumps)
        (probe-count tui.bench.canvas.full-bytes output-size)
      )
    )
    (= previous-canvas canvas)
    (blank)
    (probe-count tui.bench.frames)
    (+= checksum
      (scope (+ output-size weighted-base weighted-layers (. compositor composite-cell-count))
        (lazy weighted-base (* (. compositor base-paint-count) 17))
        (lazy weighted-layers (* (. compositor layer-paint-count) 31))
      )
    )
    (+= checksum (+ (. root overlay bounds x) (. root overlay bounds y)))
  )
  (blank)
  (print (str "bench-result tui/compositing-layers checksum=" checksum))
)

(type + BenchCompositingApp (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> BenchStaticBackdrop (id: base))
    (<> BenchOpacityOverlay (id: overlay) (• absolute) (• bg black)
      (= opacity 0.5%%)
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + arrange-static-content _
    (= (. base bounds) bounds)
    (= (. overlay width) 36)
    (= (. overlay height) 10)
    (call (. overlay arrange-bounds) (call Rect 18 8 (. overlay width) (. overlay height)))
  )
  (fn-do + move-overlay _
    (param frame Size)
    (let panel-width Coord 36)
    (let panel-height Coord 10)
    (let max-x (- (. bounds width) panel-width))
    (let max-y (- (. bounds height) panel-height))
    (let x (call bounce-coordinate (* frame 2) max-x))
    (let y (call bounce-coordinate frame max-y))
    (blank)
    (= (. overlay width) panel-width)
    (= (. overlay height) panel-height)
    (call (. overlay arrange-bounds) (call Rect x y panel-width panel-height))
  )
)

(type + BenchStaticBackdrop (is Box)
  (prop + paint-count _ (= 0))
  (fn-do + paint _
    (param canvas Canvas)
    (if (not is-paint-visible)
      (call did-paint)
      (return)
    )
    (+= paint-count 1)
    (do-use canvas
      (for (in y (..< (. bounds y) (. bounds bottom)))
        (for (in x (..< (. bounds x) (. bounds right)))
          (call (. canvas paint-background-cell) (call backdrop-color x y bounds) (tuple x y))
        )
      )
      (blank)
      (= (. canvas text-color) (call AnsiColor 255))
      (for (in y (..< (+ (. bounds y) 1) (- (. bounds bottom) 1)))
        (call (. canvas move) (tuple (+ (. bounds x) 2) y))
        (call (. canvas print) (call backdrop-line y))
      )
    )
    (blank)
    (call did-paint)
  )
)

(type + BenchOpacityOverlay (is Box)
  (fn-do + paint _
    (param canvas Canvas)
    (if (not is-paint-visible)
      (call did-paint)
      (return)
    )
    (do-use canvas
      (call paint-box-background this bounds canvas)
      (= (. canvas text-color) (call AnsiColor 250))
      (call (. canvas clip) content-bounds)
      (call (. canvas move) (tuple (+ (. bounds x) 2) (+ (. bounds y) 1)))
      (call (. canvas print) " opacity layer 50% ")
      (call (. canvas move) (tuple (+ (. bounds x) 2) (+ (. bounds y) 3)))
      (call (. canvas print) " retained surface ")
    )
    (blank)
    (call did-paint)
  )
)

(fn-expr _ backdrop-line _
  (param y Coord)
  (paragraph
    (str "row " y "  ## markdown-ish static backdrop with **strong**, `code`, links, gradients, and enough text to cover the frame")
  )
)

(fn-expr _ backdrop-color _
  (param x Coord)
  (param y Coord)
  (param rect Rect)
  (call RGBA red green blue)
  (where
    (lazy red (+ 0.04 (* 0.44 x-ratio) (* 0.18 y-ratio)))
    (lazy green (+ 0.10 (* 0.22 inverse-x) (* 0.48 y-ratio)))
    (lazy blue (+ 0.28 (* 0.52 inverse-y) (* 0.12 x-ratio)))
    (lazy inverse-x (- 1 x-ratio))
    (lazy inverse-y (- 1 y-ratio))
    (lazy x-ratio (/ (as (- x (. rect x)) Float) (as (- width 1) Float)))
    (lazy y-ratio (/ (as (- y (. rect y)) Float) (as (- height 1) Float)))
    (lazy width (if-expr (> (. rect width) 1) (. rect width) 2))
    (lazy height (if-expr (> (. rect height) 1) (. rect height) 2))
  )
)

(fn-expr _ bounce-coordinate Coord
  (param value Size)
  (param maximum Coord)
  (case? (<= maximum 0)
    0
  )
  (case? (<= phase maximum)
    phase
  )
  (default
    (- period phase)
  )
  (where
    (lazy period (* maximum 2))
    (lazy phase (call Coord (% value (as period Size))))
  )
)
