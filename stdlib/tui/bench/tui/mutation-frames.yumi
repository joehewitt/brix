+ This

app-self = this
for row-index in 0 .. < 10
    . row = BenchRowData("row-$row-index", row-index)
    rows += row

    for column-index in 0 .. < 8
        . cell = BenchCellData("cell-${row-index}-$column-index", row, row-index, column-index)
        row.cells += cell
        cells += cell

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

────────────────────
+ do apply-mutation
    - frame Size
    - mutation Size

//tui.bench.mutations ++
. kind = mutation % 4
if kind == 0
    apply-content-update(frame, mutation)
else if kind == 1
    apply-restyle(frame, mutation)
else if kind == 2
    apply-reflow(frame, mutation)
else
    apply-repaint(frame, mutation)

────────────────────
+ do apply-content-update
    - frame Size
    - mutation Size

//tui.bench.updates ++
. row = rows[(frame * 17 + mutation * 11) % rows.length]
. slot = (frame * 5 + mutation * 3) % row.cells.length
. cell = row.cells[slot]
. replacement = BenchCellData
    - "cell-${cell.row-index}-${cell.column-index}-$data-serial"
    - row
    - cell.row-index
    - cell.column-index
replacement.title = "r${cell.row-index} c${cell.column-index} f$frame"
replacement.value = "value ${(frame * 31 + mutation * 7 + cell.column-index) % 997}"
replacement.is-hot = cell.is-hot
replacement.is-muted = cell.is-muted
replacement.is-wide = cell.is-wide
row.cells[slot] = replacement
cells[cell.row-index * 8 + cell.column-index] = replacement
data-serial += 1

────────────────────
+ do apply-restyle
    - frame Size
    - mutation Size

//tui.bench.restyles ++
. cell = cells[(frame * 13 + mutation * 7) % cells.length]
. row = rows[(frame + mutation * 3) % rows.length]
if mutation == 1
    cell.is-hot = !cell.is-hot
    if frame % 5 == 0
        cell.is-muted = !cell.is-muted
    touch-cell(cell)
else
    row.is-alert = !row.is-alert
    touch-row(row)
paint-serial += 1

────────────────────
+ do apply-reflow
    - frame Size
    - mutation Size

//tui.bench.reflows ++
. cell = cells[(frame * 19 + mutation * 5) % cells.length]
. row = rows[(frame * 5 + mutation) % rows.length]
if mutation == 2
    cell.is-wide = !cell.is-wide
    touch-cell(cell)
else
    row.is-flow = !row.is-flow
    if mutation == 6
        row.is-tall = !row.is-tall
    touch-row(row)

if mutation == 6 && frame % 12 == 0
    bounds = Rect(0, 0, 104 + Coord((frame + mutation) % 5) * 4, 30 + Coord(frame % 4) * 2)
    invalidate-layout()
layout-serial += 1

────────────────────
+ do touch-row
    - row BenchRowData

rows[row.index] = row

────────────────────
+ do touch-cell
    - cell BenchCellData

for index in 0 .. < cell.row.cells.length
    if cell.row.cells[index].id == cell.id
        cell.row.cells[index] = cell
        =

────────────────────
+ do apply-repaint
    - frame Size
    - mutation Size

//tui.bench.repaints ++
if mutation == 3
    repaint-cell(cells[(frame * 23 + mutation * 3) % cells.length], frame, mutation)
else
    . row = rows[(frame * 7 + mutation) % rows.length]
    for cell in row.cells
        repaint-cell(cell, frame, mutation)
repaint-serial += 1

────────────────────
+ do repaint-cell
    - cell BenchCellData
    - frame Size
    - mutation Size

. view = cell.view
if view
    view.scroll((0, -Coord((frame + mutation + cell.column-index) % 3)))
    view.invalidate-paint()

────────────────────
+ frame-checksum Size
    - frame Size

frame + sample-cell.title.length + sample-cell.value.length + inner-width + inner-height + sample-row.cells.length + data-serial + paint-serial + layout-serial + repaint-serial

.. sample-cell = cells[(frame * 11) % cells.length]
.. sample-row = rows[(frame * 3) % rows.length]

