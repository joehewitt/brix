`benchmark.meta description: Applies deterministic TUI markup updates, restyles, reflows, repaints, and canvas diffs across many frames.
`benchmark.meta timing: recommended
`benchmark.meta profiles: tui,tui-fps,compile-timing

/core/markup
/core/style
/tui/box
/tui/canvas
/tui/colors
/tui/layout
/tui/primitives
/tui/text

. frame-count Size = 1200
. mutations-per-frame Size = 8

<BenchApp root

markup-mount-root(root, root)
root.bounds = Rect(0, 0, 120, 36)
root.markup-batch-queue.checkpoint()
root.update-layout()

. checksum Size = 0
. previous-canvas Canvas?
for frame in 0 .. < frame-count
    for mutation in 0 .. < mutations-per-frame
        root.apply-mutation(frame, mutation)

    root.markup-batch-queue.checkpoint()
    root.update-layout()

    . canvas = Canvas(root.bounds.size)
    root.paint(canvas)

    . output-size Size = 0
    if previous-canvas
        . diff = canvas.dump-diff(previous-canvas)
        output-size = diff.size
        //tui.bench.canvas.diff-dumps ++
        //tui.bench.canvas.diff-bytes += output-size
        if output-size > 0
            //tui.bench.canvas.changed-diffs ++
    else
        . full = canvas.dump()
        output-size = full.size
        //tui.bench.canvas.full-dumps ++
        //tui.bench.canvas.full-bytes += output-size
    previous-canvas = canvas

    //tui.bench.frames ++
    checksum += root.frame-checksum(frame) + output-size

-- "bench-result tui/mutation-frames checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ BenchApp is Box
    is MarkupRootElement

+ app-self BenchApp?
+ rows [BenchRowData]
+ cells [BenchCellData]
+ data-serial = 0
+ paint-serial = 0
+ layout-serial = 0
+ repaint-serial = 0
+ markup-batch-queue := MarkupBatchQueue(this)

• This
    layout = flex-col
    background-color = black
    color = white

────────────────────

<Label
    text = header-text(#data-serial, #paint-serial, #layout-serial, #repaint-serial)
    color = black
    background-color = lime

<Box
    layout = flex-col
    flex = 1
    background-color = black

    for row in #rows keyed by row.id
        <BenchRowView
            app = app-self!
            row = row
            data-serial = #data-serial
            paint-serial = #paint-serial
            layout-serial = #layout-serial
            repaint-serial = #repaint-serial
            layout = row-layout(row, #layout-serial)
            flex = row-flex(row, #layout-serial) as Flex
            background-color = row-background(row, #paint-serial)
            color = row-color(row, #paint-serial)

