; benchmark.meta description: Applies deterministic TUI markup updates, restyles, reflows, repaints, and canvas diffs across many frames.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,tui-fps,compile-timing
(blank)
(import /core/markup)
(import /core/style)
(import /tui/box)
(import /tui/canvas)
(import /tui/colors)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let frame-count Size 1200)
  (let mutations-per-frame Size 8)
  (blank)
  (<> BenchApp (id: root))
  (blank)
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 120 36))
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (blank)
  (let checksum Size 0)
  (let previous-canvas (? Canvas))
  (for (in frame (..< 0 frame-count))
    (for (in mutation (..< 0 mutations-per-frame))
      (call (. root apply-mutation) frame mutation)
    )
    (blank)
    (call (. root markup-batch-queue checkpoint))
    (call (. root update-layout))
    (blank)
    (let canvas (call Canvas (. root bounds size)))
    (call (. root paint) canvas)
    (blank)
    (let output-size Size 0)
    (if previous-canvas
      (let diff (call (. canvas dump-diff) previous-canvas))
      (= output-size (. diff size))
      (probe-count tui.bench.canvas.diff-dumps)
      (probe-count tui.bench.canvas.diff-bytes output-size)
      (if (> output-size 0)
        (probe-count tui.bench.canvas.changed-diffs)
      )
      (else
        (let full (call (. canvas dump)))
        (= output-size (. full size))
        (probe-count tui.bench.canvas.full-dumps)
        (probe-count tui.bench.canvas.full-bytes output-size)
      )
    )
    (= previous-canvas canvas)
    (blank)
    (probe-count tui.bench.frames)
    (+= checksum (+ (call (. root frame-checksum) frame) output-size))
  )
  (blank)
  (print (str "bench-result tui/mutation-frames checksum=" checksum))
)

(type + BenchApp (is Box)
  (implements MarkupRootElement)
  (prop + app-self (? BenchApp))
  (prop + rows (list BenchRowData))
  (prop + cells (list BenchCellData))
  (prop + data-serial _ (= 0))
  (prop + paint-serial _ (= 0))
  (prop + layout-serial _ (= 0))
  (prop + repaint-serial _ (= 0))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flex-col)
    (= background-color black)
    (= color white)
  )
  (content
    (<> Label
      (= text (call header-text #data-serial #paint-serial #layout-serial #repaint-serial))
      (= color black)
      (= background-color lime)
    )
    (blank)
    (<> Box
      (= layout flex-col)
      (= flex 1)
      (= background-color black)
      (blank)
      (for (in row #rows (keyed-by (. row id)))
        (<> BenchRowView
          (= app (!! app-self))
          (= row row)
          (= data-serial #data-serial)
          (= paint-serial #paint-serial)
          (= layout-serial #layout-serial)
          (= repaint-serial #repaint-serial)
          (= layout (call row-layout row #layout-serial))
          (= flex (as (call row-flex row #layout-serial) Flex))
          (= background-color (call row-background row #paint-serial))
          (= color (call row-color row #paint-serial))
        )
      )
    )
  )
  (fn-do + This _
    (= app-self this)
    (for (in row-index (..< 0 10))
      (let row (call BenchRowData (str "row-" row-index) row-index))
      (+= rows row)
      (blank)
      (for (in column-index (..< 0 8))
        (let cell (call BenchCellData (str "cell-" row-index "-" column-index) row row-index column-index))
        (+= (. row cells) cell)
        (+= cells cell)
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + apply-mutation _
    (param frame Size)
    (param mutation Size)
    (probe-count tui.bench.mutations)
    (let kind (% mutation 4))
    (if (== kind 0)
      (call apply-content-update frame mutation)
      (else-if (== kind 1)
        (call apply-restyle frame mutation)
      )
      (else-if (== kind 2)
        (call apply-reflow frame mutation)
      )
      (else
        (call apply-repaint frame mutation)
      )
    )
  )
  (fn-do + apply-content-update _
    (param frame Size)
    (param mutation Size)
    (probe-count tui.bench.updates)
    (let row ([] rows (% (+ (* frame 17) (* mutation 11)) (. rows length))))
    (let slot (% (+ (* frame 5) (* mutation 3)) (. row cells length)))
    (let cell ([] (. row cells) slot))
    (let replacement
      (call BenchCellData
        (block
          (arg (str "cell-" (. cell row-index) "-" (. cell column-index) "-" data-serial))
          (arg row)
          (arg (. cell row-index))
          (arg (. cell column-index))
        )
      )
    )
    (= (. replacement title) (str "r" (. cell row-index) " c" (. cell column-index) " f" frame))
    (= (. replacement value) (str "value " (% (+ (* frame 31) (* mutation 7) (. cell column-index)) 997)))
    (= (. replacement is-hot) (. cell is-hot))
    (= (. replacement is-muted) (. cell is-muted))
    (= (. replacement is-wide) (. cell is-wide))
    (= ([] (. row cells) slot) replacement)
    (= ([] cells (+ (* (. cell row-index) 8) (. cell column-index))) replacement)
    (+= data-serial 1)
  )
  (fn-do + apply-restyle _
    (param frame Size)
    (param mutation Size)
    (probe-count tui.bench.restyles)
    (let cell ([] cells (% (+ (* frame 13) (* mutation 7)) (. cells length))))
    (let row ([] rows (% (+ frame (* mutation 3)) (. rows length))))
    (if (== mutation 1)
      (= (. cell is-hot) (not (. cell is-hot)))
      (if (== (% frame 5) 0)
        (= (. cell is-muted) (not (. cell is-muted)))
      )
      (call touch-cell cell)
      (else
        (= (. row is-alert) (not (. row is-alert)))
        (call touch-row row)
      )
    )
    (+= paint-serial 1)
  )
  (fn-do + apply-reflow _
    (param frame Size)
    (param mutation Size)
    (probe-count tui.bench.reflows)
    (let cell ([] cells (% (+ (* frame 19) (* mutation 5)) (. cells length))))
    (let row ([] rows (% (+ (* frame 5) mutation) (. rows length))))
    (if (== mutation 2)
      (= (. cell is-wide) (not (. cell is-wide)))
      (call touch-cell cell)
      (else
        (= (. row is-flow) (not (. row is-flow)))
        (if (== mutation 6)
          (= (. row is-tall) (not (. row is-tall)))
        )
        (call touch-row row)
      )
    )
    (blank)
    (if (and (== mutation 6) (== (% frame 12) 0))
      (= bounds (call Rect 0 0 (+ 104 (* (call Coord (% (+ frame mutation) 5)) 4)) (+ 30 (* (call Coord (% frame 4)) 2))))
      (call invalidate-layout)
    )
    (+= layout-serial 1)
  )
  (fn-do + touch-row _
    (param row BenchRowData)
    (= ([] rows (. row index)) row)
  )
  (fn-do + touch-cell _
    (param cell BenchCellData)
    (for (in index (..< 0 (. cell row cells length)))
      (if (== (. ([] (. cell row cells) index) id) (. cell id))
        (= ([] (. cell row cells) index) cell)
        (return)
      )
    )
  )
  (fn-do + apply-repaint _
    (param frame Size)
    (param mutation Size)
    (probe-count tui.bench.repaints)
    (if (== mutation 3)
      (call repaint-cell ([] cells (% (+ (* frame 23) (* mutation 3)) (. cells length))) frame mutation)
      (else
        (let row ([] rows (% (+ (* frame 7) mutation) (. rows length))))
        (for (in cell (. row cells))
          (call repaint-cell cell frame mutation)
        )
      )
    )
    (+= repaint-serial 1)
  )
  (fn-do + repaint-cell _
    (param cell BenchCellData)
    (param frame Size)
    (param mutation Size)
    (let view (. cell view))
    (if view
      (call (. view scroll) (tuple 0 (- (call Coord (% (+ frame mutation (. cell column-index)) 3)))))
      (call (. view invalidate-paint))
    )
  )
  (fn-expr + frame-checksum Size
    (param frame Size)
    (+ frame (. sample-cell title length) (. sample-cell value length) inner-width inner-height (. sample-row cells length) data-serial paint-serial layout-serial repaint-serial)
    (where
      (lazy sample-cell ([] cells (% (* frame 11) (. cells length))))
      (lazy sample-row ([] rows (% (* frame 3) (. rows length))))
    )
  )
  (fn-expr + header-text String
    (param data Int)
    (param paint Int)
    (param layout-count Int)
    (param repaint Int)
    (str " TUI mutation frame bench d" data " p" paint " l" layout-count " r" repaint " ")
  )
  (fn-expr + row-layout _
    (param row BenchRowData)
    (param serial Int)
    (if-expr (. row is-flow) flow-row flex-row)
  )
  (fn-expr + row-flex _
    (param row BenchRowData)
    (param serial Int)
    (if-expr (. row is-tall) 2 1)
  )
  (fn-expr + row-background _
    (param row BenchRowData)
    (param serial Int)
    (if-expr (. row is-alert) navy black)
  )
  (fn-expr + row-color _
    (param row BenchRowData)
    (param serial Int)
    (if-expr (. row is-alert) yellow white)
  )
  (fn-expr + cell-flex _
    (param cell BenchCellData)
    (param serial Int)
    (if-expr (. cell is-wide) 3 1)
  )
  (fn-expr + cell-background _
    (param cell BenchCellData)
    (param serial Int)
    (if-expr (. cell is-hot) blue black)
  )
  (fn-expr + cell-color _
    (param cell BenchCellData)
    (param serial Int)
    (if-expr (. cell is-muted) grey white)
  )
  (fn-expr + cell-title String
    (param cell BenchCellData)
    (param serial Int)
    (param repaint Int)
    (str " " (. cell title) " " (% repaint 7) " ")
  )
  (fn-expr + cell-value String
    (param cell BenchCellData)
    (param serial Int)
    (param repaint Int)
    (str " " (. cell value) " " (. cell row-index) ":" (. cell column-index) ":" (% repaint 5) " ")
  )
)

(type + BenchRowView (is Box)
  (prop + app BenchApp)
  (prop + row BenchRowData)
  (prop + cells (list BenchCellData))
  (prop + data-serial _ (= 0))
  (prop + paint-serial _ (= 0))
  (prop + layout-serial _ (= 0))
  (prop + repaint-serial _ (= 0))
  (content
    (for (in cell #cells (keyed-by (. cell id)))
      (<> BenchCellView
        (= app #app)
        (= cell cell)
        (= data-serial #data-serial)
        (= repaint-serial #repaint-serial)
        (= layout flex-col)
        (= flex (as (call (. app cell-flex) cell #layout-serial) Flex))
        (= background-color (call (. app cell-background) cell #paint-serial))
        (= color (call (. app cell-color) cell #paint-serial))
      )
    )
  )
  (fn-do + This _
    (param app _)
    (param row _)
    (lazy cells (. row cells))
  )
)

(type + BenchCellView (is Box)
  (prop + app BenchApp)
  (prop + cell BenchCellData)
  (prop + data-serial _ (= 0))
  (prop + repaint-serial _ (= 0))
  (content
    (<> Label
      (= text (call (. app cell-title) cell #data-serial #repaint-serial))
    )
    (blank)
    (<> Label
      (= text (call (. app cell-value) cell #data-serial #repaint-serial))
    )
  )
  (fn-do + This _
    (param app _)
    (param cell _)
    (= (. cell view) this)
  )
)

(type + BenchRowData
  (prop + id String)
  (prop + index Size)
  (prop + cells (list BenchCellData))
  (prop + is-alert _ (= false))
  (prop + is-flow _ (= false))
  (prop + is-tall _ (= false))
  (fn-do + This _
    (param id _)
    (param index _)
  )
)

(type + BenchCellData
  (prop + id String)
  (prop + row BenchRowData)
  (prop + row-index Size)
  (prop + column-index Size)
  (prop + title String)
  (prop + value String)
  (prop + is-hot _ (= false))
  (prop + is-muted _ (= false))
  (prop + is-wide _ (= false))
  (prop + view (? BenchCellView))
  (fn-do + This _
    (param id _)
    (param row _)
    (param row-index _)
    (param column-index _)
    (= title (str "r" row-index " c" column-index))
    (= value (str "value " (+ (* row-index 10) column-index)))
  )
)
