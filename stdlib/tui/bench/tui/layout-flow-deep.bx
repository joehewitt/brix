; benchmark.meta description: Measures a deeply nested vertical Flow layout tree.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,compile-timing
(blank)
(import /core/markup)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let root (call BenchFlowDeepRoot))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 80 24))
  (blank)
  (let parent Box root)
  (let deepest Box root)
  (for (in depth (..< 0 160))
    (let node (call BenchFlowDeepNode))
    (call markup-append parent node)
    (call markup-append node (call Label (str "node-" depth)))
    (= parent node)
    (= deepest node)
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let checksum Size 0)
  (for (in frame (..< 0 48))
    (call (. root update-layout))
    (+= checksum (+ (. root inner-height) (. root inner-width) (. deepest bounds y) frame))
  )
  (blank)
  (print (str "bench-result tui/layout-flow-deep checksum=" checksum))
)

(type + BenchFlowDeepRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + BenchFlowDeepNode (is Box)
  (rule This
    (= layout flow-col)
  )
)
