; benchmark.meta description: Mutates text inside hidden TUI subtrees every frame.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,tui-fps,compile-timing
(blank)
(import /core/markup)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let root (call BenchHiddenDirtyRoot))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 120 40))
  (blank)
  (for (in group-index (..< 0 40))
    (let visible (call BenchHiddenDirtyVisibleGroup))
    (call markup-append root visible)
    (call markup-append visible (call Label (str "visible-" group-index)))
    (blank)
    (let hidden (call BenchHiddenDirtyHiddenGroup))
    (call markup-append root hidden)
    (for (in item-index (..< 0 24))
      (let label (call Label (str "hidden-" group-index "-" item-index)))
      (call markup-append hidden label)
      (+= (. root hidden-labels) label)
    )
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (blank)
  (let checksum Size 0)
  (for (in frame (..< 0 96))
    (let label ([] (. root hidden-labels) (% frame (. root hidden-labels length))))
    (= (. label text) (str "hidden-update-" frame))
    (call (. root markup-batch-queue checkpoint))
    (call (. root update-layout))
    (probe-count tui.bench.frames)
    (probe-count tui.bench.mutations)
    (+= checksum (+ (. root inner-width) (. root inner-height) (. label text length) frame))
  )
  (blank)
  (print (str "bench-result tui/layout-hidden-dirty checksum=" checksum))
)

(type + BenchHiddenDirtyRoot (is Box)
  (implements MarkupRootElement)
  (prop + hidden-labels (list TextBox))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + BenchHiddenDirtyVisibleGroup (is Box)
  (rule This
    (= layout flow-col)
  )
)

(type + BenchHiddenDirtyHiddenGroup (is Box)
  (rule This
    (= layout flow-col)
    (= display (. Display hidden))
  )
)
