; benchmark.meta description: Toggles large TUI subtrees between hidden and visible display states.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,tui-fps,compile-timing
(blank)
(import /core/markup)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let root (call BenchHiddenToggleRoot))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 120 44))
  (blank)
  (for (in group-index (..< 0 36))
    (let group (call BenchToggleGroup))
    (= (. group is-hidden) (== (% group-index 2) 0))
    (call markup-append root group)
    (+= (. root groups) group)
    (for (in item-index (..< 0 18))
      (call markup-append group (call Label (str "toggle-" group-index "-" item-index)))
    )
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (blank)
  (let checksum Size 0)
  (for (in frame (..< 0 72))
    (let group ([] (. root groups) (% frame (. root groups length))))
    (= (. group is-hidden) (not (. group is-hidden)))
    (call (. root markup-batch-queue checkpoint))
    (call (. root update-layout))
    (probe-count tui.bench.frames)
    (probe-count tui.bench.mutations)
    (+= checksum (+ (. root inner-width) (. root inner-height) frame))
  )
  (blank)
  (print (str "bench-result tui/layout-hidden-toggle checksum=" checksum))
)

(type + BenchHiddenToggleRoot (is Box)
  (implements MarkupRootElement)
  (prop + groups (list BenchToggleGroup))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + BenchToggleGroup (is Box)
  (prop + is-hidden _ (= true))
  (blank)
  (rule This
    (= layout flow-col)
    (= display (if-expr #is-hidden (. Display hidden) (. Display visible)))
  )
)
