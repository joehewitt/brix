`benchmark.meta description: Full-arrange control for size-stable edits among 1,000 Flow siblings.
`benchmark.meta timing: recommended
`benchmark.meta profiles: tui,tui-fps,compile-timing

/core/markup
/tui/box
/tui/layout
/tui/primitives

. root = BenchFlowStableFullRoot()
. target BenchFlowStableFullCell?
markup-mount-root(root, root)

for index in 0 .. < 1000
    . cell = BenchFlowStableFullCell()
    markup-append(root, cell)
    if index == 500
        target = cell

root.markup-batch-queue.checkpoint()
root.bounds = Rect(0, 0, 120, 40)
root.update-layout()

. checksum Size = 0
for frame in 0 .. < 512
    target!.revision += 1
    root.invalidate-layout()
    //+tui.bench.layout
    root.update-layout()
    //-tui.bench.layout
    //tui.bench.mutations ++
    //tui.bench.frames ++
    checksum += root.inner-height + root.inner-width + frame

-- "bench-result tui/layout-flow-size-stable-1000-full checksum=$checksum"

