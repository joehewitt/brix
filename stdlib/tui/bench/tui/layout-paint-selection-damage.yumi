`benchmark.meta description: Measures layout and paint damage for selection, status, and row text edits.
`benchmark.meta timing: recommended
`benchmark.meta profiles: tui,tui-fps,ui-smoothness,compile-timing

/core/markup
/core/style
/tui/box
/tui/canvas
/tui/colors
/tui/layout
/tui/primitives
/tui/text

. row-count Size = 320
. step-count Size = 160

. root = DamageBenchRoot()
root.bounds = Rect(0, 0, 120, 40)

. status = Label("status-0")
root.status = status
markup-append(root, status)

for index in 0 .. < row-count
    . row = DamageBenchRow(index)
    root.rows += row
    markup-append(root, row)

markup-mount-root(root, root)
root.rows[0].is-selected = true
root.markup-batch-queue.checkpoint()
root.update-layout()

. previous = Canvas(root.bounds.size)
root.paint(previous)

. checksum Size = 0
for step in 0 .. < step-count
    //+tui.bench.input-step
    root.apply-step(step)

    //+tui.bench.checkpoint
    root.markup-batch-queue.checkpoint()
    //-tui.bench.checkpoint

    //+tui.bench.layout
    root.update-layout()
    //-tui.bench.layout

    . canvas = Canvas(root.bounds.size)
    //+tui.bench.paint
    root.paint(canvas)
    //-tui.bench.paint

    //+tui.bench.canvas-diff
    . diff = canvas.dump-diff(previous)
    //-tui.bench.canvas-diff
    previous = canvas

    //tui.bench.frames ++
    //tui.bench.mutations ++
    //tui.bench.canvas.diff-dumps ++
    //tui.bench.canvas.diff-bytes += diff.size
    checksum += diff.size + root.selected-index + root.status.text.length + step
    //-tui.bench.input-step

-- "bench-result tui/layout-paint-selection-damage checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ DamageBenchRoot is Box
    is MarkupBatch

+ rows [DamageBenchRow]
+ status Label
+ selected-index Size = 0
+ markup-batch-queue := MarkupBatchQueue(this)

• This
    layout = flow-col
    background-color = black

