; benchmark.meta description: Measures layout and paint damage for selection, status, and row text edits.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,tui-fps,ui-smoothness,compile-timing
(blank)
(import /core/markup)
(import /core/style)
(import /tui/box)
(import /tui/canvas)
(import /tui/colors)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let row-count Size 320)
  (let step-count Size 160)
  (blank)
  (let root (call DamageBenchRoot))
  (= (. root bounds) (call Rect 0 0 120 40))
  (blank)
  (let status (call Label "status-0"))
  (= (. root status) status)
  (call markup-append root status)
  (blank)
  (for (in index (..< 0 row-count))
    (let row (call DamageBenchRow index))
    (+= (. root rows) row)
    (call markup-append root row)
  )
  (blank)
  (call markup-mount-root root root)
  (= (. ([] (. root rows) 0) is-selected) true)
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (blank)
  (let previous (call Canvas (. root bounds size)))
  (call (. root paint) previous)
  (blank)
  (let checksum Size 0)
  (for (in step (..< 0 step-count))
    (probe-group + tui.bench.input-step)
    (call (. root apply-step) step)
    (blank)
    (probe-group + tui.bench.checkpoint)
    (call (. root markup-batch-queue checkpoint))
    (probe-group - tui.bench.checkpoint)
    (blank)
    (probe-group + tui.bench.layout)
    (call (. root update-layout))
    (probe-group - tui.bench.layout)
    (blank)
    (let canvas (call Canvas (. root bounds size)))
    (probe-group + tui.bench.paint)
    (call (. root paint) canvas)
    (probe-group - tui.bench.paint)
    (blank)
    (probe-group + tui.bench.canvas-diff)
    (let diff (call (. canvas dump-diff) previous))
    (probe-group - tui.bench.canvas-diff)
    (= previous canvas)
    (blank)
    (probe-count tui.bench.frames)
    (probe-count tui.bench.mutations)
    (probe-count tui.bench.canvas.diff-dumps)
    (probe-count tui.bench.canvas.diff-bytes (. diff size))
    (+= checksum (+ (. diff size) (. root selected-index) (. root status text length) step))
    (probe-group - tui.bench.input-step)
  )
  (blank)
  (print (str "bench-result tui/layout-paint-selection-damage checksum=" checksum))
)

(type + DamageBenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + rows (list DamageBenchRow))
  (prop + status Label)
  (prop + selected-index Size (= 0))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
    (= background-color black)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + apply-step _
    (param step Size)
    (let kind (% step 3))
    (if (== kind 0)
      (call select-index (% (+ (* step 17) 11) (. rows length)))
      (else-if (== kind 1)
        (= (. status text) (str "status-" step "-" (% selected-index 13)))
      )
      (else
        (let row ([] rows (% (+ (* step 19) 5) (. rows length))))
        (= (. row text) (str "row-" (. row index) "-edit-" step))
      )
    )
  )
  (fn-do + select-index _
    (param index Size)
    (= (. ([] rows selected-index) is-selected) false)
    (= selected-index index)
    (= (. ([] rows selected-index) is-selected) true)
  )
)

(type + DamageBenchRow (is Label)
  (prop + index Size)
  (prop + is-selected _ (= false))
  (blank)
  (rule This
    (= color silver)
    (= background-color black)
    (blank)
    (when-style #is-selected
      (= color white)
      (= background-color navy)
    )
  )
  (fn-do + This _
    (param index _)
    (= text (str "row-" index))
  )
)
