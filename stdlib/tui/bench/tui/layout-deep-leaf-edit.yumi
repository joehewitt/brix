`benchmark.meta description: Edits one TUI text leaf at depth between layout frames.
`benchmark.meta timing: recommended
`benchmark.meta profiles: tui,tui-fps,compile-timing

/core/markup
/tui/box
/tui/layout
/tui/primitives
/tui/text

. root = BenchDeepLeafRoot()
markup-mount-root(root, root)
root.bounds = Rect(0, 0, 100, 32)

. parent Box = root
for depth in 0 .. < 96
    . child = BenchDeepNode()
    markup-append(parent, child)
    parent = child

. leaf = Label("deep-leaf")
markup-append(parent, leaf)
root.leaf = leaf

root.markup-batch-queue.checkpoint()
root.update-layout()

. checksum Size = 0
for frame in 0 .. < 128
    root.leaf?.text = "deep-leaf-$frame"
    root.markup-batch-queue.checkpoint()
    root.update-layout()
    //tui.bench.frames ++
    //tui.bench.mutations ++
    checksum += root.inner-width + root.inner-height + (root.leaf?.text.length ?? 0) + frame

-- "bench-result tui/layout-deep-leaf-edit checksum=$checksum"

