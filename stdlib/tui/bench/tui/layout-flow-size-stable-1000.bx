; benchmark.meta description: Measures optimized size-stable edits among 1,000 Flow siblings.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,tui-fps,compile-timing
(blank)
(import /core/markup)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(blank)

(main
  (let root (call BenchFlowStableRoot))
  (let target (? BenchFlowStableCell))
  (call markup-mount-root root root)
  (blank)
  (for (in index (..< 0 1000))
    (let cell (call BenchFlowStableCell))
    (call markup-append root cell)
    (if (== index 500)
      (= target cell)
    )
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (= (. root bounds) (call Rect 0 0 120 40))
  (call (. root update-layout))
  (blank)
  (let checksum Size 0)
  (for (in frame (..< 0 512))
    (+= (. (!! target) revision) 1)
    (probe-group + tui.bench.layout)
    (call (. root update-layout))
    (probe-group - tui.bench.layout)
    (probe-count tui.bench.mutations)
    (probe-count tui.bench.frames)
    (+= checksum (+ (. root inner-height) (. root inner-width) frame))
  )
  (blank)
  (print (str "bench-result tui/layout-flow-size-stable-1000 checksum=" checksum))
)

(type + BenchFlowStableRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + BenchFlowStableCell (is Box)
  (prop + revision Size (= 0))
  (blank)
  (depends invalidate-content-size revision)
  (fn-expr + measured-content-size PSize
    (param query MeasureQuery)
    (call PSize 7 1)
  )
)
