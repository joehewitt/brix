; benchmark.meta description: Measures layout with large hidden subtrees mixed with visible rows.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,compile-timing
(blank)
(import /core/markup)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let root (call BenchHiddenRoot))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 120 40))
  (blank)
  (for (in group-index (..< 0 48))
    (let visible (call BenchVisibleGroup))
    (call markup-append root visible)
    (call markup-append visible (call Label (str "visible-" group-index)))
    (blank)
    (let hidden (call BenchHiddenGroup))
    (call markup-append root hidden)
    (for (in item-index (..< 0 32))
      (call markup-append hidden (call Label (str "hidden-" group-index "-" item-index)))
    )
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let checksum Size 0)
  (for (in frame (..< 0 64))
    (call (. root update-layout))
    (+= checksum (+ (. root inner-height) (. root inner-width) frame))
  )
  (blank)
  (print (str "bench-result tui/layout-hidden-subtrees checksum=" checksum))
)

(type + BenchHiddenRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + BenchVisibleGroup (is Box)
  (rule This
    (= layout flow-col)
  )
)

(type + BenchHiddenGroup (is Box)
  (rule This
    (= layout flow-col)
    (= display (. Display hidden))
  )
)
