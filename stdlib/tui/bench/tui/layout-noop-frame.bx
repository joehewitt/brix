; benchmark.meta description: Runs settled TUI layout and paint frames with no mutations.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,tui-fps,compile-timing
(blank)
(import /core/markup)
(import /tui/box)
(import /tui/canvas)
(import /tui/colors)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let root (call BenchNoopRoot))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 120 40))
  (blank)
  (for (in row-index (..< 0 24))
    (let row (call BenchNoopRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 8))
      (call markup-append row (call Label (str "noop-" row-index "-" cell-index)))
    )
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (let previous (call Canvas (. root bounds size)))
  (call (. root paint) previous)
  (blank)
  (let checksum Size 0)
  (for (in frame (..< 0 120))
    (call (. root markup-batch-queue checkpoint))
    (call (. root update-layout))
    (let canvas (call Canvas (. root bounds size)))
    (call (. root paint) canvas)
    (let diff (call (. canvas dump-diff) previous))
    (= previous canvas)
    (probe-count tui.bench.frames)
    (probe-count tui.bench.canvas.diff-dumps)
    (probe-count tui.bench.canvas.diff-bytes (. diff size))
    (+= checksum (+ (. diff size) (. root inner-width) (. root inner-height) frame))
  )
  (blank)
  (print (str "bench-result tui/layout-noop-frame checksum=" checksum))
)

(type + BenchNoopRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + BenchNoopRow (is Box)
  (rule This
    (= layout flow-row)
  )
)
