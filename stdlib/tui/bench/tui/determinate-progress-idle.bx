; benchmark.meta description: Measures idle markup work in a rich TUI table with 300 determinate progress meters.
; benchmark.meta timing: recommended
; benchmark.meta profiles: tui,timing
(blank)
(import /core/markup)
(import /data/stream)
(import /stream/sort)
(import /time/duration)
(import /tui)
(blank)

(main
  (let root (call RichTableBench))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 120 32))
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (let previous (call Canvas (. root bounds size)))
  (call (. root paint) previous)
  (let current (call Canvas (. root bounds size)))
  (let output (call (of DataStream Byte) 8192))
  (let checksum Size)
  (for (in step (..< 0 12))
    (call (. 25ms wait))
    (probe-group + tui.bench.input-step)
    (probe-group + tui.bench.checkpoint)
    (call (. root markup-batch-queue checkpoint))
    (probe-group - tui.bench.checkpoint)
    (probe-group + tui.bench.layout)
    (call (. root update-layout))
    (probe-group - tui.bench.layout)
    (call (. current reset))
    (probe-group + tui.bench.paint)
    (call (. root paint) current)
    (probe-group - tui.bench.paint)
    (call (. output reset))
    (probe-group + tui.bench.canvas-diff)
    (call (. current dump-diff) output previous)
    (probe-group - tui.bench.canvas-diff)
    (+= checksum (. output length))
    (probe-count tui.bench.frames)
    (probe-count tui.bench.mutations)
    (probe-group - tui.bench.input-step)
    (let recycled previous)
    (= previous current)
    (= current recycled)
  )
  (call (. root close))
  (print (str "bench-result tui/determinate-progress-idle checksum=" checksum))
)

(type + RichRecord (is Tuple)
  (prop + id Int)
  (prop + name String)
  (prop + usage Int)
)

(type + RichTableBench (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This (• flex-col)
      (<> (of Table RichRecord) (id: table) (• flex 1)
        (= rows (call (of List RichRecord) (in (call RichRecord each (str "process-" each) (% each 100)) (..< 0 300))))
        (= columns (call rich-columns))
        (= key-builder (=> (item) (str (. item id))))
        (<> Box (slot: cell) (param: cell) (• flex-row)
          (if (== (. cell column id) "usage")
            (<> ProgressBar (• flex 1)
              (= value (. cell #item usage))
              (= bar-prefix "")
              (= bar-suffix "")
              (= show-percent false)
            )
            (else
              (<> Label (• flex 1)
                (= text (. cell #text))
                (= color (if-expr (. cell #is-selected) yellow cyan))
              )
            )
          )
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(fn-do + rich-columns (list (of TableColumn RichRecord))
  (let id (call (of TableColumn RichRecord) "ID"))
  (= (. id id) "id")
  (= (. id column-width) (call (. TableWidth fixed) 8))
  (= (. id value) (=> (item) (str (. item id))))
  (let name (call (of TableColumn RichRecord) "Process"))
  (= (. name id) "name")
  (= (. name column-width) (call (. TableWidth flex) 1))
  (= (. name value) (=> (item) (. item name)))
  (let usage (call (of TableColumn RichRecord) "Usage"))
  (= (. usage id) "usage")
  (= (. usage column-width) (call (. TableWidth fixed) 16))
  (return (list id name usage))
)
