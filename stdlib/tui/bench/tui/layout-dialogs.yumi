`benchmark.meta description: Measures natural layout for many declarative dialogs.
`benchmark.meta timing: recommended
`benchmark.meta profiles: tui,compile-timing

/core/markup
/tui

<BenchDialogHost host
markup-mount-root(host, host)
host.bounds = Rect(0, 0, 100, 32)

host.markup-batch-queue.checkpoint()

. checksum Size = 0
for frame in 0 .. < 40
    host.update-layout()
    checksum += host.inner-height + host.inner-width + frame

-- "bench-result tui/layout-dialogs checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ BenchDialogHost is Box
    is MarkupRootElement

+ markup-batch-queue := MarkupBatchQueue(this)

• This
    layout = flow-col

────────────────────

<This
    for index in 0 .. < 80
        <AlertDialog
            message = "message-$index"

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush
