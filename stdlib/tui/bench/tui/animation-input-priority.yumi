`benchmark.meta description: Requests immediate repaints while the TUI animation loop is waiting for its next frame.
`benchmark.meta timing: recommended
`benchmark.meta profiles: tui,timing

/time/duration
/time/timer

. ready = SyncBufferedChannel'Bool()
. loop = AnimationLoop(100ms as Nanoseconds, => do ready <- true)
loop.request-now()
<- ready
. frames = 0
for _ in 0 .. < 8
    loop.request-next()
    20ms.wait()
    //+tui.bench.input-step
    loop.request-now()
    <- ready
    //-tui.bench.input-step
    frames += 1
loop.cancel()
-- "bench-result tui/animation-input-priority checksum=$frames"
