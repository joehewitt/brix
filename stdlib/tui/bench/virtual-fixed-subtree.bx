(import /core/markup)
(import /data/stream)
(import /tui/bench/virtual-fixed-kernel)
(import /tui/box)
(import /tui/canvas)
(import /tui/colors)
(import /tui/layout)
(import /tui/primitives)
(import /tui/shortcuts)
(import /tui/text)
(import /tui/virtual)
(import /ui/input)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)
(prop _ virtual-subtree-count VirtualCoord (= 1000000000vcoord))
(prop _ virtual-subtree-opening-scroll VirtualCoord (= 4001vcoord))

(fn-do + run-virtual-fixed-subtree Size
  (let harness (call VirtualSubtreeHarness))
  (let stats-before (call virtual-kernel-stats (. harness root region)))
  (blank)
  (let address I64 1000)
  (let step Size 0)
  (while (< step 2048)
    (+= address 1)
    (call (. harness frame) address 24 false)
    (+= step 1)
  )
  (blank)
  (= step 0)
  (while (< step 256)
    (let jump-address I64 1000)
    (if (== (% step 4) 1)
      (= jump-address 1000000)
      (else-if (== (% step 4) 2)
        (= jump-address 500000000)
      )
      (else-if (== (% step 4) 3)
        (= jump-address 999999980)
      )
    )
    (call (. harness frame) jump-address 24 false)
    (+= step 1)
  )
  (blank)
  (= step 0)
  (while (< step 64)
    (call (. harness frame) address 24 true)
    (+= step 1)
  )
  (blank)
  (= step 0)
  (while (< step 64)
    (call (. harness frame) address 12 false)
    (call (. harness frame) address 24 false)
    (+= step 1)
  )
  (blank)
  (let stats-after (call virtual-kernel-stats (. harness root region)))
  (call emit-virtual-region-stats (. harness root region) stats-before stats-after)
  (blank)
  (return (+ (. harness checksum) (. harness root region pool-size)))
)

(type + VirtualSubtreeHarness
  (prop + root _ (:= (call VirtualSubtreeRoot)))
  (prop + previous-canvas Canvas)
  (prop + current-canvas Canvas)
  (prop + frame-output _ (:= (call (of DataStream Byte) 8192)))
  (prop + checksum Size)
  (fn-do + This _
    (call markup-mount-root root root)
    (call (. root arrange-bounds) (call Rect 0 0 80 48))
    (call (. root markup-batch-queue checkpoint))
    (= (. root region virtual-scroll) (call VirtualPoint 0vcoord virtual-subtree-opening-scroll))
    (call (. root update-layout))
    (call (. root arrange-bounds) (call Rect 0 0 80 24))
    (call (. root update-layout))
    (blank)
    (= previous-canvas (call Canvas (call PSize 80 48)))
    (= current-canvas (call Canvas (call PSize 80 48)))
    (call (. previous-canvas reset))
    (call (. root paint) previous-canvas)
    (let warmup-frame (call (. previous-canvas dump)))
    (throw (call Panic "virtual-fixed-subtree warmup did not render row content") (if (== (call (. warmup-frame find) "1001 g") null)))
  )
  (fn-do + frame _
    (param address I64)
    (param viewport-height Coord)
    (param resets-source Bool)
    (probe-group + tui.bench.input-step)
    (if resets-source
      (call (. root source bump-revision))
    )
    (let y (as (+ (* address 4) 1) VirtualCoord))
    (= (. root region virtual-scroll) (call VirtualPoint 0vcoord y))
    (call (. root region invalidate-layout))
    (call (. root arrange-bounds) (call Rect 0 0 80 viewport-height))
    (blank)
    (probe-group + tui.bench.checkpoint)
    (call (. root markup-batch-queue checkpoint))
    (probe-group - tui.bench.checkpoint)
    (blank)
    (probe-group + tui.bench.layout)
    (call (. root update-layout))
    (probe-group - tui.bench.layout)
    (blank)
    (call (. current-canvas reset))
    (probe-group + tui.bench.paint)
    (call (. root paint) current-canvas)
    (probe-group - tui.bench.paint)
    (blank)
    (call (. frame-output reset))
    (probe-group + tui.bench.canvas-diff)
    (call (. current-canvas dump-diff) frame-output previous-canvas)
    (probe-group - tui.bench.canvas-diff)
    (blank)
    (probe-count tui.bench.frames)
    (probe-count tui.bench.mutations)
    (probe-count tui.bench.canvas.diff-dumps)
    (if (. frame-output length)
      (probe-count tui.bench.canvas.changed-diffs)
    )
    (probe-count tui.bench.canvas.diff-bytes (. frame-output length))
    (blank)
    (+= checksum (+ (* (. frame-output length) 17) (% (as address Size) 1000003) viewport-height))
    (let recycled-canvas previous-canvas)
    (= previous-canvas current-canvas)
    (= current-canvas recycled-canvas)
    (probe-group - tui.bench.input-step)
  )
)

(type + VirtualSubtreeRoot (is Box)
  (implements MarkupRootElement)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + source _ (:= (call VirtualRangeSource virtual-subtree-count)))
  (prop + virtual-layout _ (:= (call VerticalFixedLayout 4vcoord)))
  (prop + region (of VirtualRegion I64))
  (prop + selected-address I64 (= 1000))
  (prop + status-message _ (= "Row 1,000 of 1,000,000,000"))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This (• flex-col) (• bg black)
      (<> (of VirtualRegion I64) (id: region) (• flex 1) (• bg black)
        (= source #source)
        (= virtual-layout #virtual-layout)
        (= overscan (call VirtualInsets 12vcoord 0vcoord 12vcoord 0vcoord))
        (= virtual-scroll (call VirtualPoint 0vcoord virtual-subtree-opening-scroll))
        (blank)
        (<> VirtualComplexRow (slot: row) (param: slot) (• flex-row)
          (= address (. slot #address))
          (= item (. slot #item))
          (= generation (. slot #generation))
          (= is-even (== (% (. slot #item) 2) 0))
          (= parts (call virtual-subtree-parts (. slot #item)))
          (= read-current (=> () (. slot item)))
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
  (fn-do + move _
    (param rows I64)
    (call go-to (+ selected-address rows))
  )
  (fn-do + go-to _
    (param requested I64)
    (let address requested)
    (if (< address 0)
      (= address 0)
    )
    (if (>= address (as virtual-subtree-count I64))
      (= address (- (as virtual-subtree-count I64) 1))
    )
    (= selected-address address)
    (= status-message (str "Row " (+ address 1) " of 1,000,000,000"))
    (= (. region virtual-scroll) (call VirtualPoint 0vcoord (+ (* address 4) 1)))
    (call (. region invalidate-layout))
    (call (. region invalidate-paint))
  )
)

(type + VirtualComplexRow (is Box)
  (prop + address I64)
  (prop + item I64)
  (prop + generation U64)
  (prop + is-even Bool)
  (prop + parts (list String))
  (prop + read-current (of Getter I64))
  (blank)
  (rule This (• flex-row) (• flex 1) (• text (if-expr #is-even white silver)) (• bg (if-expr #is-even navy black)))
  (content
    (<> This
      (<> Label (• text white) (• bg (if-expr #is-even navy black))
        (= text (str #address " g" #generation))
      )
      (blank)
      (if #is-even
        (<> Label (text: " even ") (• text aqua))
        (else
          (<> Label (text: " odd ") (• text yellow))
        )
      )
      (blank)
      (<> Box (• flex-row)
        (for (in part #parts)
          (<> Label (• text (if-expr #is-even lime rose))
            (= text part)
          )
        )
      )
      (blank)
      (<> VirtualStatefulChild
        (= address #address)
      )
      (blank)
      (<> VirtualFocusableChild
        (= read-current read-current)
      )
    )
  )
)

(type + VirtualStatefulChild (is Label)
  (prop + address I64)
  (prop + retained-state U64 (= 1))
  (blank)
  (rule This (• text teal)
    (= text (str " state:" #retained-state ":" (% #address 97) " "))
  )
)

(type + VirtualFocusableChild (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + read-current (of Getter I64))
  (prop + last-read I64)
  (content
    (<> This (• flex-row)
      (<> Shortcut (text: "Read current virtual row")
        (= key .enter)
        (= show-in-status false)
        (= action (=> () :do (= last-read (call read-current))))
      )
      (blank)
      (<> Label (• text (if-expr #is-focused white gray))
        (= text (str " current:" #last-read " "))
      )
    )
  )
)

(fn-expr _ virtual-subtree-parts (list String)
  (param item I64)
  (call (of List String) (list (str " [" item "]") (str " [" (% item 7) "]") (str " [" (% item 13) "] ")))
)
