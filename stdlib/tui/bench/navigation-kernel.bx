(import /core/markup)
(import /core/style)
(import /data/stream)
(import /tui/bench/virtual-fixed-kernel)
(import /tui/box)
(import /tui/canvas)
(import /tui/colors)
(import /tui/layout)
(import /tui/primitives)
(import /tui/shortcuts)
(import /tui/text)
(import /ui/input)

(fn-do + run-navigation-kernel Size
  (param scenario String)
  (param is-fresh-list Bool)
  (let root-row-count Size 180)
  (let child-row-count Size 64)
  (let step-count Size 120)
  (let root-items (call make-navigation-kernel-items "root" "root" root-row-count 0))
  (let root-column (call NavigationKernelColumn "root" root-items))
  (blank)
  (let root (call NavigationKernelRoot))
  (= (. root root-column) root-column)
  (= (. root child-row-count) child-row-count)
  (call (. root navigate-to) 0 step-count is-fresh-list)
  (blank)
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 132 42))
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (call assert-navigation-kernel-layout root scenario)
  (blank)
  ; Warm up one complete product frame outside the measured input-step boundary.
  (let previous-canvas (call Canvas (. root bounds size)))
  (call (. previous-canvas reset))
  (call (. root paint) previous-canvas)
  (let frame-output (call (of DataStream Byte) 8192))
  (call (. frame-output reset))
  (call (. previous-canvas dump) frame-output)
  (if (not (. frame-output length))
    (throw (call Panic (str "tui/navigation-kernel-" scenario " warmup paint produced no output")))
  )
  (probe-count tui.bench.canvas.full-dumps)
  (probe-count tui.bench.canvas.full-bytes (. frame-output length))
  (blank)
  ; Product Terminal.repaint rotates these two canvases and reuses one output stream.
  (let current-canvas (call Canvas (. root bounds size)))
  (let checksum Size 0)
  (let mounted-rows Size 0)
  (let reused-rows Size 0)
  (let remounted-rows Size 0)
  (let full-bytes (. frame-output length))
  (let diff-bytes Size 0)
  (blank)
  (for (in step (..< 0 step-count))
    ; This span is the measured product-loop boundary: mutation through streamed canvas diff.
    (probe-group + tui.bench.input-step)
    (let row-mounts-before (. root row-mount-count))
    (let selected-index (call navigation-kernel-index step root-row-count is-fresh-list))
    (call (. root navigate-to) selected-index step is-fresh-list)
    (blank)
    (probe-group + tui.bench.checkpoint)
    (call (. root markup-batch-queue checkpoint))
    (probe-group - tui.bench.checkpoint)
    (blank)
    (let frame-mounted-rows (- (. root row-mount-count) row-mounts-before))
    (call assert-navigation-kernel-identity frame-mounted-rows child-row-count scenario is-fresh-list)
    (let frame-reused-rows (- child-row-count frame-mounted-rows))
    (let frame-remounted-rows (if-expr is-fresh-list frame-mounted-rows 0))
    (blank)
    (probe-group + tui.bench.layout)
    (call (. root update-layout))
    (probe-group - tui.bench.layout)
    (call assert-navigation-kernel-layout root scenario)
    (blank)
    (call (. current-canvas reset))
    (probe-group + tui.bench.paint)
    (call (. root paint) current-canvas)
    (probe-group - tui.bench.paint)
    (blank)
    (call (. frame-output reset))
    (probe-group + tui.bench.canvas-diff)
    (call (. current-canvas dump-diff) frame-output previous-canvas)
    (probe-group - tui.bench.canvas-diff)
    (if (not (. frame-output length))
      (throw (call Panic (str "tui/navigation-kernel-" scenario " measured frame " step " produced no diff")))
    )
    (blank)
    (probe-count tui.bench.frames)
    (probe-count tui.bench.mutations)
    (probe-count tui.bench.rows.mounted frame-mounted-rows)
    (probe-count tui.bench.rows.reused frame-reused-rows)
    (probe-count tui.bench.rows.remounted frame-remounted-rows)
    (probe-count tui.bench.canvas.diff-dumps)
    (probe-count tui.bench.canvas.changed-diffs)
    (probe-count tui.bench.canvas.diff-bytes (. frame-output length))
    (blank)
    (+= mounted-rows frame-mounted-rows)
    (+= reused-rows frame-reused-rows)
    (+= remounted-rows frame-remounted-rows)
    (+= diff-bytes (. frame-output length))
    (+= checksum (call navigation-kernel-frame-checksum root (. frame-output length) step))
    (blank)
    (let recycled-canvas previous-canvas)
    (= previous-canvas current-canvas)
    (= current-canvas recycled-canvas)
    (probe-group - tui.bench.input-step)
  )
  (blank)
  (call emit-zero-virtual-kernel-stats)
  (blank)
  (return (+ checksum identity-checksum output-checksum))
  (lazy identity-checksum (+ (* mounted-rows 67) (* reused-rows 71) (* remounted-rows 73)))
  (lazy output-checksum (+ (* full-bytes 79) (* diff-bytes 83)))
)

(type + NavigationKernelRoot (is Box)
  (implements MarkupRootElement)
  (prop + root-column NavigationKernelColumn (= (call NavigationKernelColumn "root" (call (of List NavigationKernelItem)))))
  (prop + child-row-count Size (= 64))
  (prop + child-items (list NavigationKernelItem))
  (prop + selected-index Size (= 0))
  (prop + status-message _ (= "ready"))
  (prop + app-self (? NavigationKernelRoot))
  (prop + focused-box (? Box))
  (prop + modal-box (? Box))
  (prop + shortcuts (list Shortcut) (= (call active-window-shortcuts #shortcut-nodes #focused-box #modal-box)))
  (prop + activation-count Size (= 0))
  (prop + selected-is-dir _ (= false))
  (prop + selected-is-file _ (= true))
  (prop + row-mount-count Size (= 0))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (prop _ shortcut-nodes (of Descendants Shortcut))
  (prop _ kernel-rows (of Descendants NavigationKernelRow))
  (blank)
  (rule This (• flow-col) (• bg black)
    (= focus-mode (. FocusMode keys))
  )
  (content
    (<> This
      (if #selected-is-dir
        (<> Shortcut (text: "Open")
          (= key .arrow-right)
          (= action (=> () :do (+= activation-count 1)))
        )
      )
      (blank)
      (if #selected-is-file
        (<> Shortcut (text: "Preview")
          (= key .space)
          (= action (=> () :do (+= activation-count 1)))
        )
      )
      (blank)
      (<> Label (id: status) (• text white) (• bg grey)
        (= text (call navigation-kernel-status-text #status-message #shortcuts))
      )
      (blank)
      (<> Box (• flex-row)
        (<> Box (• flow-col)
          (= min-width (call (. SizeSpec coord) 28))
          (= max-width (call (. SizeSpec coord) 28))
          (for (in item (. root-column items))
            (<> NavigationKernelRow
              (= app (!! app-self))
              (= item item)
              (= is-selected (== #selected-index (. item index)))
            )
          )
        )
        (blank)
        (<> Box (• flow-col)
          (= min-width (call (. SizeSpec coord) 40))
          (= max-width (call (. SizeSpec coord) 40))
          (for (in item #child-items (keyed-by (. item id)))
            (<> NavigationKernelRow
              (= app (!! app-self))
              (= item item)
            )
          )
        )
      )
    )
  )
  (fn-do + This _
    (= app-self this)
    (= focused-box this)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + selected-item (? NavigationKernelItem)
    (if (not (. root-column items))
      (return)
    )
    (return ([] (. root-column items) selected-index))
  )
  (fn-do + navigate-to _
    (param index Size)
    (param step Size)
    (param is-fresh-list Bool)
    (= selected-index index)
    (= status-message (str "selected-" index "-step-" step))
    (call replace-child-items step is-fresh-list)
  )
  (fn-do + replace-child-items _
    (param step Size)
    (param is-fresh-list Bool)
    (let item (call selected-item))
    (let identity-prefix (if-expr is-fresh-list (str "child-fresh-" step) "child-stable"))
    (let content-prefix (str "child-" (?? (?. item index) 0) "-step-" step))
    (let salt (+ (?? (?. item index) 0) step))
    (blank)
    (= child-items (call make-navigation-kernel-items identity-prefix content-prefix child-row-count salt))
    (blank)
    (= selected-is-dir (?? (?. item is-dir) false))
    (= selected-is-file (?? (?. item is-file) false))
  )
  (fn-do + visible-row-count Size
    (let count Size 0)
    (for (in row kernel-rows)
      (if (and (> (. row bounds width) 0) (> (. row bounds height) 0))
        (+= count 1)
      )
    )
    (return count)
  )
)

(type + NavigationKernelRow (is Label)
  (prop + app NavigationKernelRoot)
  (prop + item NavigationKernelItem)
  (prop + is-selected _ (= false))
  (blank)
  (rule This (• text (call kernel-row-fg #is-selected)) (• bg (call kernel-row-bg #is-selected)))
  (fn-do + This _
    (param app _)
    (param item _)
    (+= (. app row-mount-count) 1)
    (= text (str " " (call navigation-kernel-item-icon item) " " (. item name)))
  )
)

(type + NavigationKernelColumn (is Tuple)
  (prop + id String)
  (prop + items (list NavigationKernelItem))
)

(type + NavigationKernelItem (is Tuple)
  (prop + id String)
  (prop + name String)
  (prop + index Size)
  (prop + is-dir Bool)
  (prop + is-file Bool)
)

(fn-do _ make-navigation-kernel-items (list NavigationKernelItem)
  (param identity-prefix String)
  (param content-prefix String)
  (param count Size)
  (param salt Size)
  (let items (list NavigationKernelItem))
  (for (in index (..< 0 count))
    (let is-dir (== (% (+ index salt) 5) 0))
    (let id (str identity-prefix "-" index))
    (let name (str content-prefix "-row-" index))
    (+= items (call NavigationKernelItem id name index is-dir (not is-dir)))
  )
  (return items)
)

(fn-expr _ navigation-kernel-index Size
  (param step Size)
  (param row-count Size)
  (param is-fresh-list Bool)
  (if-expr is-fresh-list (% (* step 5) row-count) (% (+ (* step 23) 5) row-count))
)

(fn-expr _ navigation-kernel-item-icon String
  (param item NavigationKernelItem)
  (case? (. item is-dir)
    "d"
  )
  (default
    "f"
  )
)

(fn-expr _ kernel-row-fg AnsiColor
  (param is-selected Bool)
  (if-expr is-selected white silver)
)

(fn-expr _ kernel-row-bg AnsiColor
  (param is-selected Bool)
  (if-expr is-selected navy black)
)

(fn-do _ navigation-kernel-status-text String
  (param message String)
  (param shortcuts (list Shortcut) (= (call (of List Shortcut))))
  (let labels (list String))
  (for (in shortcut shortcuts)
    (if (. shortcut show-in-status)
      (+= labels (. shortcut status-label))
    )
  )
  (blank)
  (let shortcut-text (call (. " | " join) labels))
  (let status
    (block
      (case? (and message shortcut-text)
        (str " " message " | " shortcut-text " ")
      )
      (case? message
        (str " " message " ")
      )
      (default
        (str " " shortcut-text " ")
      )
    )
  )
  (return status)
)

(fn-do _ assert-navigation-kernel-layout _
  (param root NavigationKernelRoot)
  (param scenario String)
  (if (or (<= (. root bounds width) 0) (<= (. root bounds height) 0))
    (throw (call Panic (str "tui/navigation-kernel-" scenario " root has no layout bounds")))
  )
  (if (or (<= (. root status bounds width) 0) (<= (. root status bounds height) 0))
    (throw (call Panic (str "tui/navigation-kernel-" scenario " status has no layout bounds")))
  )
  (if (not (call (. root visible-row-count)))
    (throw (call Panic (str "tui/navigation-kernel-" scenario " laid out no visible rows")))
  )
)

(fn-do _ assert-navigation-kernel-identity _
  (param mounted-rows Size)
  (param expected-rows Size)
  (param scenario String)
  (param is-fresh-list Bool)
  (if (> mounted-rows expected-rows)
    (throw (call Panic (str "tui/navigation-kernel-" scenario " mounted too many rows")))
  )
  (if (and is-fresh-list (!= mounted-rows expected-rows))
    (throw (call Panic (str "tui/navigation-kernel-" scenario " did not remount the fresh row list")))
  )
  (if (and (not is-fresh-list) mounted-rows)
    (throw (call Panic (str "tui/navigation-kernel-" scenario " remounted stable row identities")))
  )
)

(fn-expr _ navigation-kernel-frame-checksum Size
  (param root NavigationKernelRoot)
  (param output-size Size)
  (param step Size)
  (+ output-checksum selection-checksum status-checksum layout-checksum step)
  (where
    (lazy output-checksum (* output-size 17))
    (lazy selection-checksum (* (. root selected-index) 31))
    (lazy status-checksum (* (. root status text length) 43))
    (lazy layout-checksum (* (call (. root visible-row-count)) 59))
  )
)
