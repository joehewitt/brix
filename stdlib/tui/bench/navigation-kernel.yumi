/ui/input

━━━━━━━━━━━━━━━━━━━━
+ do run-navigation-kernel Size
    - scenario String
    - is-fresh-list Bool

. root-row-count Size = 180
. child-row-count Size = 64
. step-count Size = 120
. root-items = make-navigation-kernel-items("root", "root", root-row-count, 0)
. root-column = NavigationKernelColumn("root", root-items)

. root = NavigationKernelRoot()
root.root-column = root-column
root.child-row-count = child-row-count
root.navigate-to(0, step-count, is-fresh-list)

markup-mount-root(root, root)
root.bounds = Rect(0, 0, 132, 42)
root.markup-batch-queue.checkpoint()
root.update-layout()
assert-navigation-kernel-layout(root, scenario)

` Warm up one complete product frame outside the measured input-step boundary.
. previous-canvas = Canvas(root.bounds.size)
previous-canvas.reset()
root.paint(previous-canvas)
. frame-output = DataStream'Byte(8192)
frame-output.reset()
previous-canvas.dump(frame-output)
if !frame-output.length
    ?! Panic("tui/navigation-kernel-$scenario warmup paint produced no output")
//tui.bench.canvas.full-dumps ++
//tui.bench.canvas.full-bytes += frame-output.length

` Product Terminal.repaint rotates these two canvases and reuses one output stream.
. current-canvas = Canvas(root.bounds.size)
. checksum Size = 0
. mounted-rows Size = 0
. reused-rows Size = 0
. remounted-rows Size = 0
. full-bytes = frame-output.length
. diff-bytes Size = 0

for step in 0 .. < step-count
    ` This span is the measured product-loop boundary: mutation through streamed canvas diff.
    //+tui.bench.input-step
    . row-mounts-before = root.row-mount-count
    . selected-index = navigation-kernel-index(step, root-row-count, is-fresh-list)
    root.navigate-to(selected-index, step, is-fresh-list)

    //+tui.bench.checkpoint
    root.markup-batch-queue.checkpoint()
    //-tui.bench.checkpoint

    . frame-mounted-rows = root.row-mount-count - row-mounts-before
    assert-navigation-kernel-identity(frame-mounted-rows, child-row-count, scenario, is-fresh-list)
    . frame-reused-rows = child-row-count - frame-mounted-rows
    . frame-remounted-rows = if is-fresh-list then frame-mounted-rows else 0

    //+tui.bench.layout
    root.update-layout()
    //-tui.bench.layout
    assert-navigation-kernel-layout(root, scenario)

    current-canvas.reset()
    //+tui.bench.paint
    root.paint(current-canvas)
    //-tui.bench.paint

    frame-output.reset()
    //+tui.bench.canvas-diff
    current-canvas.dump-diff(frame-output, previous-canvas)
    //-tui.bench.canvas-diff
    if !frame-output.length
        ?! Panic("tui/navigation-kernel-$scenario measured frame $step produced no diff")

    //tui.bench.frames ++
    //tui.bench.mutations ++
    //tui.bench.rows.mounted += frame-mounted-rows
    //tui.bench.rows.reused += frame-reused-rows
    //tui.bench.rows.remounted += frame-remounted-rows
    //tui.bench.canvas.diff-dumps ++
    //tui.bench.canvas.changed-diffs ++
    //tui.bench.canvas.diff-bytes += frame-output.length

    mounted-rows += frame-mounted-rows
    reused-rows += frame-reused-rows
    remounted-rows += frame-remounted-rows
    diff-bytes += frame-output.length
    checksum += navigation-kernel-frame-checksum(root, frame-output.length, step)

    . recycled-canvas = previous-canvas
    previous-canvas = current-canvas
    current-canvas = recycled-canvas
    //-tui.bench.input-step

emit-zero-virtual-kernel-stats()

= checksum + identity-checksum + output-checksum
.. identity-checksum = mounted-rows * 67 + reused-rows * 71 + remounted-rows * 73
.. output-checksum = full-bytes * 79 + diff-bytes * 83

━━━━━━━━━━━━━━━━━━━━
+ NavigationKernelRoot is Box
    is MarkupRootElement

+ root-column NavigationKernelColumn = NavigationKernelColumn("root", List'NavigationKernelItem())
+ child-row-count Size = 64
+ child-items [NavigationKernelItem]
+ selected-index Size = 0
+ status-message = "ready"
+ app-self NavigationKernelRoot?
+ focused-box Box?
+ modal-box Box?
+ shortcuts [Shortcut] = active-window-shortcuts(#shortcut-nodes, #focused-box, #modal-box)
+ activation-count Size = 0
+ selected-is-dir = false
+ selected-is-file = true
+ row-mount-count Size = 0
+ markup-batch-queue := MarkupBatchQueue(this)

_ shortcut-nodes Descendants'Shortcut
_ kernel-rows Descendants'NavigationKernelRow

• This • flow-col bg:black
    focus-mode = FocusMode.keys

────────────────────

<This
    if #selected-is-dir
        <Shortcut "Open"
            key = .arrow-right
            action = => do activation-count += 1

    if #selected-is-file
        <Shortcut "Preview"
            key = .space
            action = => do activation-count += 1

    <Label status • text:white bg:grey
        text = navigation-kernel-status-text(#status-message, #shortcuts)

    <Box • flex-row
        <Box • flow-col
            min-width = SizeSpec.coord(28)
            max-width = SizeSpec.coord(28)
            for item in root-column.items
                <NavigationKernelRow
                    app = app-self!
                    item = item
                    is-selected = #selected-index == item.index

        <Box • flow-col
            min-width = SizeSpec.coord(40)
            max-width = SizeSpec.coord(40)
            for item in #child-items keyed by item.id
                <NavigationKernelRow
                    app = app-self!
                    item = item

────────────────────
+ This

app-self = this
focused-box = this

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

────────────────────
+ do selected-item NavigationKernelItem?

if !root-column.items
    =
= root-column.items[selected-index]

────────────────────
+ do navigate-to
    - index Size
    - step Size
    - is-fresh-list Bool

selected-index = index
status-message = "selected-${index}-step-${step}"
replace-child-items(step, is-fresh-list)

────────────────────
+ do replace-child-items
    - step Size
    - is-fresh-list Bool

. item = selected-item()
. identity-prefix = if is-fresh-list then "child-fresh-$step" else "child-stable"
. content-prefix = "child-${item?.index ?? 0}-step-$step"
. salt = (item?.index ?? 0) + step

child-items = make-navigation-kernel-items(identity-prefix, content-prefix, child-row-count, salt)

selected-is-dir = item?.is-dir ?? false
selected-is-file = item?.is-file ?? false

────────────────────
+ do visible-row-count Size

. count Size = 0
for row in kernel-rows
    if row.bounds.width > 0 && row.bounds.height > 0
        count += 1
= count

━━━━━━━━━━━━━━━━━━━━
+ NavigationKernelRow is Label

+ app NavigationKernelRoot
+ item NavigationKernelItem
+ is-selected = false

• This • text:kernel-row-fg(#is-selected) bg:kernel-row-bg(#is-selected)

────────────────────
+ This
    - app
    - item

app.row-mount-count += 1
text = " ${navigation-kernel-item-icon(item)} ${item.name}"

━━━━━━━━━━━━━━━━━━━━
+ NavigationKernelColumn is Tuple

+ id String
+ items [NavigationKernelItem]

━━━━━━━━━━━━━━━━━━━━
+ NavigationKernelItem is Tuple

+ id String
+ name String
+ index Size
+ is-dir Bool
+ is-file Bool

━━━━━━━━━━━━━━━━━━━━
_ do make-navigation-kernel-items [NavigationKernelItem]
    - identity-prefix String
    - content-prefix String
    - count Size
    - salt Size

. items [NavigationKernelItem]
for index in 0 .. < count
    . is-dir = (index + salt) % 5 == 0
    . id = "${identity-prefix}-$index"
    . name = "${content-prefix}-row-$index"
    items += NavigationKernelItem(id, name, index, is-dir, !is-dir)
= items

━━━━━━━━━━━━━━━━━━━━
_ navigation-kernel-index Size
    - step Size
    - row-count Size
    - is-fresh-list Bool

if is-fresh-list then (step * 5) % row-count else (step * 23 + 5) % row-count

━━━━━━━━━━━━━━━━━━━━
_ navigation-kernel-item-icon String
    - item NavigationKernelItem

|? item.is-dir
    "d"
??
    "f"

━━━━━━━━━━━━━━━━━━━━
_ kernel-row-fg AnsiColor
    - is-selected Bool

if is-selected then white else silver

━━━━━━━━━━━━━━━━━━━━
_ kernel-row-bg AnsiColor
    - is-selected Bool

if is-selected then navy else black

━━━━━━━━━━━━━━━━━━━━
_ do navigation-kernel-status-text String
    - message String
    - shortcuts [Shortcut] = List'Shortcut()

. labels [String]
for shortcut in shortcuts
    if shortcut.show-in-status
        labels += shortcut.status-label

. shortcut-text = " | ".join(labels)
. status =
    |? message && shortcut-text
        " $message | $shortcut-text "
    |? message
        " $message "
    ??
        " $shortcut-text "
= status

━━━━━━━━━━━━━━━━━━━━
_ do assert-navigation-kernel-layout
    - root NavigationKernelRoot
    - scenario String

if root.bounds.width <= 0 || root.bounds.height <= 0
    ?! Panic("tui/navigation-kernel-$scenario root has no layout bounds")
if root.status.bounds.width <= 0 || root.status.bounds.height <= 0
    ?! Panic("tui/navigation-kernel-$scenario status has no layout bounds")
if !root.visible-row-count()
    ?! Panic("tui/navigation-kernel-$scenario laid out no visible rows")

━━━━━━━━━━━━━━━━━━━━
_ do assert-navigation-kernel-identity
    - mounted-rows Size
    - expected-rows Size
    - scenario String
    - is-fresh-list Bool

if mounted-rows > expected-rows
    ?! Panic("tui/navigation-kernel-$scenario mounted too many rows")
if is-fresh-list && mounted-rows != expected-rows
    ?! Panic("tui/navigation-kernel-$scenario did not remount the fresh row list")
if !is-fresh-list && mounted-rows
    ?! Panic("tui/navigation-kernel-$scenario remounted stable row identities")

━━━━━━━━━━━━━━━━━━━━
_ navigation-kernel-frame-checksum Size
    - root NavigationKernelRoot
    - output-size Size
    - step Size

output-checksum + selection-checksum + status-checksum + layout-checksum + step
.. output-checksum = output-size * 17
.. selection-checksum = root.selected-index * 31
.. status-checksum = root.status.text.length * 43
.. layout-checksum = root.visible-row-count() * 59
