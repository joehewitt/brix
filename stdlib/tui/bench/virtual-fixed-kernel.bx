(import /BxGC/BxGC.h)
(import /core/markup)
(import /os/env)
(import /tui/bench/collect)
(import /tui/box)
(import /tui/primitives)
(import /tui/virtual)
(import /ui/virtual)
(import /ui/virtual-layout)
(import /ui/virtual-recycler)
(blank)
(prop _ virtual-kernel-count VirtualCoord (= 1000000000vcoord))
(prop _ virtual-kernel-opening-scroll VirtualCoord (= 4001vcoord))
(prop _ virtual-kernel-row-height VirtualCoord (= 4vcoord))
(prop _ virtual-kernel-pool-high-water Size (= 19))

(type + VirtualKernelStats (is Tuple)
  (prop + pool-created Size)
  (prop + pool-high-water Size)
  (prop + roots-created Size)
  (prop + window-refreshes Size)
  (prop + placements-emitted Size)
  (prop + layout-addresses-inspected Size)
  (prop + rebinds Size)
  (prop + source-binds Size)
  (prop + placement-buffer-grows Size)
  (prop + stale-commits Size)
)

(fn-do + run-virtual-fixed-stable-window Size
  (let root (call prepare-virtual-fixed-kernel))
  (call run-virtual-fixed-stable-updates root 2)
  (let stats-before (call virtual-kernel-stats (. root region)))
  (let objects-before (call C:brixGCAllocatedObjectCount))
  (let bytes-before (call C:brixGCAllocatedByteCount))
  (call run-virtual-fixed-stable-updates root 4096)
  (blank)
  (let allocated-objects (- (call C:brixGCAllocatedObjectCount) objects-before))
  (let allocated-bytes (- (call C:brixGCAllocatedByteCount) bytes-before))
  (let delta (call virtual-stats-delta stats-before (call virtual-kernel-stats (. root region))))
  (call emit-virtual-kernel-stats root delta)
  (call emit-virtual-kernel-high-water root)
  (call assert-no-growth delta (as allocated-objects Size) (as allocated-bytes Size) "stable-window")
  (throw (call Panic "virtual-fixed-stable-window rebound an unchanged placement window") (if (or (!= (. delta source-binds) 0) (!= (. delta rebinds) 0))))
  (throw (call Panic "virtual-fixed-stable-window produced unexpected refresh or placement counts") (if (or (!= (. delta window-refreshes) 4096) (!= (. delta placements-emitted) 53248))))
  (blank)
  (let checksum (call virtual-kernel-checksum delta (as allocated-objects Size) (as allocated-bytes Size)))
  (call (. root region publish-bindings))
  (return checksum)
)

(fn-do _ run-virtual-fixed-stable-updates _
  (param root VirtualFixedKernelRoot)
  (param count Size)
  (let step Size 0)
  (while (< step count)
    (let y
      (scope (if-expr (== (% step 2) 0) virtual-kernel-opening-scroll next-scroll)
        (lazy next-scroll (+ virtual-kernel-opening-scroll 1vcoord))
      )
    )
    (call (. root region refresh-bindings-at) 0vcoord y 80vcoord 24vcoord)
    (+= step 1)
  )
)

(fn-do + run-virtual-fixed-adjacent-scroll Size
  (let root (call prepare-virtual-fixed-kernel))
  (call run-virtual-fixed-adjacent-updates root virtual-kernel-opening-scroll 19)
  (call (. root region refresh-bindings-at) 0vcoord virtual-kernel-opening-scroll 80vcoord 24vcoord)
  (let stats-before (call virtual-kernel-stats (. root region)))
  (let objects-before (call C:brixGCAllocatedObjectCount))
  (let bytes-before (call C:brixGCAllocatedByteCount))
  (call run-virtual-fixed-adjacent-updates root virtual-kernel-opening-scroll 4096)
  (blank)
  (let allocated-objects (- (call C:brixGCAllocatedObjectCount) objects-before))
  (let allocated-bytes (- (call C:brixGCAllocatedByteCount) bytes-before))
  (let delta (call virtual-stats-delta stats-before (call virtual-kernel-stats (. root region))))
  (call emit-virtual-kernel-stats root delta)
  (call emit-virtual-kernel-high-water root)
  (call assert-no-growth delta (as allocated-objects Size) (as allocated-bytes Size) "adjacent-scroll")
  (throw (call Panic "virtual-fixed-adjacent-scroll did not rotate exactly one slot per row") (if (or (!= (. delta source-binds) 4096) (!= (. delta rebinds) 4096))))
  (throw (call Panic "virtual-fixed-adjacent-scroll changed the prewarmed pool high-water") (if (!= (. root region pool-size) virtual-kernel-pool-high-water)))
  (blank)
  (let checksum (call virtual-kernel-checksum delta (as allocated-objects Size) (as allocated-bytes Size)))
  (call (. root region publish-bindings))
  (return checksum)
)

(fn-do _ run-virtual-fixed-adjacent-updates _
  (param root VirtualFixedKernelRoot)
  (param opening-scroll VirtualCoord)
  (param count Size)
  (let step Size 0)
  (let scroll opening-scroll)
  (while (< step count)
    (+= scroll virtual-kernel-row-height)
    (call (. root region refresh-bindings-at) 0vcoord scroll 80vcoord 24vcoord)
    (+= step 1)
  )
)

(fn-do + run-virtual-fixed-jump-ladder Size
  (let root (call prepare-virtual-fixed-kernel))
  (call run-virtual-fixed-jump-updates root 1)
  (call (. root region refresh-bindings-at) 0vcoord 168001vcoord 80vcoord 24vcoord)
  (let stats-before (call virtual-kernel-stats (. root region)))
  (let objects-before (call C:brixGCAllocatedObjectCount))
  (let bytes-before (call C:brixGCAllocatedByteCount))
  (call run-virtual-fixed-jump-updates root 256)
  (blank)
  (let allocated-objects (- (call C:brixGCAllocatedObjectCount) objects-before))
  (let allocated-bytes (- (call C:brixGCAllocatedByteCount) bytes-before))
  (let delta (call virtual-stats-delta stats-before (call virtual-kernel-stats (. root region))))
  (call emit-virtual-kernel-stats root delta)
  (call emit-virtual-kernel-high-water root)
  (call assert-no-growth delta (as allocated-objects Size) (as allocated-bytes Size) "jump-ladder")
  (throw (call Panic "virtual-fixed-jump-ladder refresh count was distance-dependent") (if (!= (. delta window-refreshes) 1024)))
  (throw (call Panic "virtual-fixed-jump-ladder did not bind exactly one window per jump") (if (or (!= (. delta source-binds) 13312) (!= (. delta rebinds) 13312))))
  (throw (call Panic "virtual-fixed-jump-ladder emitted or inspected more than thirteen rows per jump") (if (or (!= (. delta placements-emitted) 13312) (!= (. delta layout-addresses-inspected) 13312))))
  (blank)
  (let checksum (call virtual-kernel-checksum delta (as allocated-objects Size) (as allocated-bytes Size)))
  (call (. root region publish-bindings))
  (return checksum)
)

(fn-do _ run-virtual-fixed-jump-updates _
  (param root VirtualFixedKernelRoot)
  (param count Size)
  (let cycle Size 0)
  (while (< cycle count)
    (call (. root region refresh-bindings-at) 0vcoord 4001vcoord 80vcoord 24vcoord)
    (call (. root region refresh-bindings-at) 0vcoord 4000001vcoord 80vcoord 24vcoord)
    (call (. root region refresh-bindings-at) 0vcoord 2000000001vcoord 80vcoord 24vcoord)
    (call (. root region refresh-bindings-at) 0vcoord 3999999921vcoord 80vcoord 24vcoord)
    (+= cycle 1)
  )
)

(fn-do + run-virtual-fixed-lifetime Size
  (let root (call prepare-virtual-fixed-kernel))
  (let opening-revision (. root source revision value))
  (call bench-collect)
  (let opening-live-bytes (call C:brixGCLiveByteCount))
  (let checksum (call run-virtual-fixed-lifetime-phases root))
  (blank)
  (= (. root source revision value) opening-revision)
  (= (. root region virtual-scroll) (call VirtualPoint 0vcoord virtual-kernel-opening-scroll))
  (call (. root region arrange-bounds) (call Rect 0 0 80 24))
  (call (. root region update-layout))
  (call bench-collect)
  (let final-live-bytes (call C:brixGCLiveByteCount))
  (throw (call Panic (str "virtual-fixed-lifetime live memory grew from " opening-live-bytes " to " final-live-bytes)) (if (and (not (call virtual-kernel-has-runtime-probes)) (> final-live-bytes opening-live-bytes))))
  (throw (call Panic "virtual-fixed-lifetime exceeded the prewarmed pool capacity") (if (!= (. root region pool-size) virtual-kernel-pool-high-water)))
  (blank)
  (return (as (+ checksum final-live-bytes) Size))
)

(fn-do _ run-virtual-fixed-lifetime-phases Size
  (param root VirtualFixedKernelRoot)
  (call run-virtual-fixed-resize-updates root 19)
  (call (. root region refresh-bindings-at) 0vcoord virtual-kernel-opening-scroll 80vcoord 24vcoord)
  (let checksum Size)
  (blank)
  (let resize-before (call virtual-kernel-stats (. root region)))
  (let resize-objects-before (call C:brixGCAllocatedObjectCount))
  (let resize-bytes-before (call C:brixGCAllocatedByteCount))
  (call run-virtual-fixed-resize-updates root 256)
  (let resize-objects (- (call C:brixGCAllocatedObjectCount) resize-objects-before))
  (let resize-bytes (- (call C:brixGCAllocatedByteCount) resize-bytes-before))
  (let resize-delta (call virtual-stats-delta resize-before (call virtual-kernel-stats (. root region))))
  (call emit-virtual-kernel-stats root resize-delta)
  (call assert-no-growth resize-delta (as resize-objects Size) (as resize-bytes Size) "lifetime-resize")
  (+= checksum (call virtual-kernel-checksum resize-delta (as resize-objects Size) (as resize-bytes Size)))
  (call (. root region publish-bindings))
  (blank)
  (call run-virtual-fixed-revision-updates root 2)
  (let revision-before (call virtual-kernel-stats (. root region)))
  (let revision-objects-before (call C:brixGCAllocatedObjectCount))
  (let revision-bytes-before (call C:brixGCAllocatedByteCount))
  (call run-virtual-fixed-revision-updates root 256)
  (let revision-objects (- (call C:brixGCAllocatedObjectCount) revision-objects-before))
  (let revision-bytes (- (call C:brixGCAllocatedByteCount) revision-bytes-before))
  (let revision-delta (call virtual-stats-delta revision-before (call virtual-kernel-stats (. root region))))
  (call emit-virtual-kernel-stats root revision-delta)
  (call assert-no-growth
    (block
      (arg revision-delta)
      (arg (as revision-objects Size))
      (arg (as revision-bytes Size))
      (arg "lifetime-revision")
    )
  )
  (throw (call Panic "virtual-fixed-lifetime revision reset bound more than one active window") (if (> (. revision-delta source-binds) (* 256 13))))
  (+= checksum
    (call virtual-kernel-checksum
      (block
        (arg revision-delta)
        (arg (as revision-objects Size))
        (arg (as revision-bytes Size))
      )
    )
  )
  (call (. root region publish-bindings))
  (blank)
  (call run-virtual-fixed-adjacent-updates root virtual-kernel-opening-scroll 19)
  (call (. root region refresh-bindings-at) 0vcoord virtual-kernel-opening-scroll 80vcoord 24vcoord)
  (let adjacent-before (call virtual-kernel-stats (. root region)))
  (let adjacent-objects-before (call C:brixGCAllocatedObjectCount))
  (let adjacent-bytes-before (call C:brixGCAllocatedByteCount))
  (call run-virtual-fixed-adjacent-updates root virtual-kernel-opening-scroll 65536)
  (let adjacent-objects (- (call C:brixGCAllocatedObjectCount) adjacent-objects-before))
  (let adjacent-bytes (- (call C:brixGCAllocatedByteCount) adjacent-bytes-before))
  (let adjacent-delta (call virtual-stats-delta adjacent-before (call virtual-kernel-stats (. root region))))
  (call emit-virtual-kernel-stats root adjacent-delta)
  (call assert-no-growth
    (block
      (arg adjacent-delta)
      (arg (as adjacent-objects Size))
      (arg (as adjacent-bytes Size))
      (arg "lifetime-adjacent")
    )
  )
  (throw (call Panic "virtual-fixed-lifetime adjacent phase did not bind exactly one entering row") (if (or (!= (. adjacent-delta source-binds) 65536) (!= (. adjacent-delta rebinds) 65536))))
  (+= checksum
    (call virtual-kernel-checksum
      (block
        (arg adjacent-delta)
        (arg (as adjacent-objects Size))
        (arg (as adjacent-bytes Size))
      )
    )
  )
  (call (. root region publish-bindings))
  (call emit-virtual-kernel-high-water root)
  (blank)
  (return checksum)
)

(fn-do _ run-virtual-fixed-resize-updates _
  (param root VirtualFixedKernelRoot)
  (param count Size)
  (let cycle Size 0)
  (while (< cycle count)
    (call (. root region refresh-bindings-at) 0vcoord virtual-kernel-opening-scroll 80vcoord 48vcoord)
    (call (. root region refresh-bindings-at) 0vcoord virtual-kernel-opening-scroll 80vcoord 24vcoord)
    (+= cycle 1)
  )
)

(fn-do _ run-virtual-fixed-revision-updates _
  (param root VirtualFixedKernelRoot)
  (param count Size)
  (let cycle Size 0)
  (while (< cycle count)
    (call (. root source bump-revision))
    (call (. root region refresh-bindings-at) 0vcoord virtual-kernel-opening-scroll 80vcoord 24vcoord)
    (+= cycle 1)
  )
)

(fn-do _ prepare-virtual-fixed-kernel VirtualFixedKernelRoot
  (let root (call VirtualFixedKernelRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root region arrange-bounds) (call Rect 0 0 80 24))
  (= (. root region virtual-scroll) (call VirtualPoint 0vcoord virtual-kernel-opening-scroll))
  (call (. root region update-layout))
  (call (. root region arrange-bounds) (call Rect 0 0 80 48))
  (call (. root region update-layout))
  (call (. root region arrange-bounds) (call Rect 0 0 80 24))
  (call (. root region update-layout))
  (= (. root region virtual-scroll) (call VirtualPoint 0vcoord (+ virtual-kernel-opening-scroll 1vcoord)))
  (call (. root region update-layout))
  (= (. root region virtual-scroll) (call VirtualPoint 0vcoord virtual-kernel-opening-scroll))
  (call (. root region update-layout))
  (throw (call Panic "virtual fixed kernel did not prewarm exactly nineteen physical slots") (if (!= (. root region pool-size) virtual-kernel-pool-high-water)))
  (return root)
)

(fn-do _ emit-virtual-kernel-stats _
  (param root VirtualFixedKernelRoot)
  (param delta VirtualKernelStats)
  (probe-count tui.virtual.pool.created (. delta pool-created))
  (probe-count tui.virtual.roots.created (. delta roots-created))
  (probe-count tui.virtual.window.refreshes (. delta window-refreshes))
  (probe-count tui.virtual.placements.emitted (. delta placements-emitted))
  (probe-count tui.virtual.layout.addresses-inspected (. delta layout-addresses-inspected))
  (probe-count tui.virtual.rebinds (. delta rebinds))
  (probe-count tui.virtual.source.binds (. delta source-binds))
  (probe-count tui.virtual.placement-buffer-grows (. delta placement-buffer-grows))
  (probe-count tui.virtual.stale-commits (. delta stale-commits))
)

(fn-do _ emit-virtual-kernel-high-water _
  (param root VirtualFixedKernelRoot)
  (probe-count tui.virtual.pool.high-water (. root region pool-size))
)

(fn-do + emit-virtual-region-stats _
  (param region (of VirtualRegion I64))
  (param opening VirtualKernelStats)
  (param closing VirtualKernelStats)
  (let delta (call virtual-stats-delta opening closing))
  (probe-count tui.virtual.pool.created (. delta pool-created))
  (probe-count tui.virtual.pool.high-water (. region pool-size))
  (probe-count tui.virtual.roots.created (. delta roots-created))
  (probe-count tui.virtual.window.refreshes (. delta window-refreshes))
  (probe-count tui.virtual.placements.emitted (. delta placements-emitted))
  (probe-count tui.virtual.layout.addresses-inspected (. delta layout-addresses-inspected))
  (probe-count tui.virtual.rebinds (. delta rebinds))
  (probe-count tui.virtual.source.binds (. delta source-binds))
  (probe-count tui.virtual.placement-buffer-grows (. delta placement-buffer-grows))
  (probe-count tui.virtual.stale-commits (. delta stale-commits))
)

(fn-do + emit-zero-virtual-kernel-stats _
  (probe-count tui.virtual.pool.created 0)
  (probe-count tui.virtual.pool.high-water 0)
  (probe-count tui.virtual.roots.created 0)
  (probe-count tui.virtual.window.refreshes 0)
  (probe-count tui.virtual.placements.emitted 0)
  (probe-count tui.virtual.layout.addresses-inspected 0)
  (probe-count tui.virtual.rebinds 0)
  (probe-count tui.virtual.source.binds 0)
  (probe-count tui.virtual.placement-buffer-grows 0)
  (probe-count tui.virtual.stale-commits 0)
)

(fn-do _ assert-no-growth _
  (param delta VirtualKernelStats)
  (param allocated-objects Size)
  (param allocated-bytes Size)
  (param scenario String)
  (throw (call Panic (str "virtual-fixed-" scenario " created a slot or root after prewarm")) (if (or (!= (. delta pool-created) 0) (!= (. delta roots-created) 0))))
  (throw (call Panic (str "virtual-fixed-" scenario " grew the reusable placement buffer after prewarm")) (if (!= (. delta placement-buffer-grows) 0)))
  (throw (call Panic (str "virtual-fixed-" scenario " allocated " allocated-objects " objects after prewarm")) (if (and (not (call virtual-kernel-has-runtime-probes)) (!= allocated-objects 0))))
  (throw (call Panic (str "virtual-fixed-" scenario " allocated " allocated-bytes " bytes after prewarm")) (if (and (not (call virtual-kernel-has-runtime-probes)) (!= allocated-bytes 0))))
)

(fn-expr _ virtual-kernel-has-runtime-probes Bool
  (if-expr probes (> (. probes size) 0) false)
  (where
    (lazy probes (call env "PROBES_ENABLED"))
  )
)

(fn-expr _ virtual-stats-delta _
  (param opening VirtualKernelStats)
  (param closing VirtualKernelStats)
  (call VirtualKernelStats
    (block
      (arg (- (. closing pool-created) (. opening pool-created)))
      (arg (- (. closing pool-high-water) (. opening pool-high-water)))
      (arg (- (. closing roots-created) (. opening roots-created)))
      (arg (- (. closing window-refreshes) (. opening window-refreshes)))
      (arg (- (. closing placements-emitted) (. opening placements-emitted)))
      (arg (- (. closing layout-addresses-inspected) (. opening layout-addresses-inspected)))
      (arg (- (. closing rebinds) (. opening rebinds)))
      (arg (- (. closing source-binds) (. opening source-binds)))
      (arg (- (. closing placement-buffer-grows) (. opening placement-buffer-grows)))
      (arg (- (. closing stale-commits) (. opening stale-commits)))
    )
  )
)

(fn-expr + virtual-kernel-stats VirtualKernelStats
  (param region (of VirtualRegion I64))
  (call VirtualKernelStats
    (block
      (arg (. recycler pool-created))
      (arg (. recycler pool-high-water))
      (arg (. region roots-created))
      (arg (. recycler window-refreshes))
      (arg (. recycler placements-emitted))
      (arg (. recycler layout-addresses-inspected))
      (arg (. recycler rebinds))
      (arg (. recycler source-binds))
      (arg (. recycler placement-buffer-grows))
      (arg (. recycler stale-commits))
    )
  )
  (where
    (lazy recycler (. region stats))
  )
)

(fn-do _ virtual-kernel-checksum Size
  (param delta VirtualKernelStats)
  (param allocated-objects Size)
  (param allocated-bytes Size)
  (let checksum (+ (* (. delta window-refreshes) 3) (* (. delta placements-emitted) 5)))
  (+= checksum (+ (* (. delta source-binds) 7) (* (. delta rebinds) 11)))
  (+= checksum (+ (* allocated-objects 13) (* allocated-bytes 17)))
  (return checksum)
)

(type + VirtualFixedKernelRoot (is Box)
  (implements MarkupRootElement)
  (prop + source _ (:= (call VirtualRangeSource virtual-kernel-count)))
  (prop + virtual-layout _ (:= (call VerticalFixedLayout virtual-kernel-row-height)))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This
      (<> (of VirtualRegion I64) (id: region)
        (= source #source)
        (= virtual-layout #virtual-layout)
        (= overscan (call VirtualInsets 12vcoord 0vcoord 12vcoord 0vcoord))
        (blank)
        (<> VirtualFixedKernelRow (slot: row) (param: slot)
          (= item (. slot #item))
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + VirtualFixedKernelRow (is Box)
  (prop + item I64)
)
