; benchmark.meta description: Exercises collection coalescing, unkeyed remounts, and keyed rebuild reuse.
; benchmark.meta timing: recommended
; benchmark.meta profiles: markup-runtime,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /core/style)
(import /gc/gc)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let step-count Size 48)
  (let markup-attachment-lane (call C:brixGCMarkupAttachmentsSidePayloadLane))
  (call C:brixCollect)
  (do
    (inline (call drain-reclaim-cleanups))
  )
  (let opening-markup-attachments (call C:brixGCObjectSidePayloadCount markup-attachment-lane))
  (do
    (inline opening-markup-attachments)
  )
  (blank)
  (let small-forward (call make-collection-items 64 "small"))
  (let small-backward (call reversed-items small-forward))
  (let medium-forward (call make-collection-items 512 "medium"))
  (let medium-backward (call reversed-items medium-forward))
  (let large-forward (call make-collection-items 900 "large"))
  (let large-backward (call reversed-items large-forward))
  (blank)
  (let root (call CollectionBenchRoot))
  (= (. root items) (call make-collection-items 384 "unkeyed"))
  (= (. root keyed-small) small-forward)
  (= (. root keyed-medium) medium-forward)
  (= (. root keyed-large) large-forward)
  (blank)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (let settled-markup-attachments (call C:brixGCObjectSidePayloadCount markup-attachment-lane))
  (do
    (inline settled-markup-attachments)
  )
  (let settled-markup-hosts (call collection-bench-host-count root))
  (throw (call Panic "markup/collection-coalesce-remount initial attachment tree is inconsistent") (if (!= settled-markup-attachments (+ opening-markup-attachments settled-markup-hosts))))
  (blank)
  (let checksum Size 0)
  (for (in step (..< 0 step-count))
    (+= (. root items) (call CollectionBenchItem (str "temp-" step) (str "temp-" step)))
    (call (. root items remove) (- (. root items length) 1))
    (= ([] (. root items) (% step (. root items length))) (call CollectionBenchItem (str "set-" step) (str "set-" step)))
    (blank)
    (if (== (% step 2) 0)
      (= (. root keyed-small) small-backward)
      (= (. root keyed-medium) medium-backward)
      (= (. root keyed-large) large-backward)
      (else
        (= (. root keyed-small) small-forward)
        (= (. root keyed-medium) medium-forward)
        (= (. root keyed-large) large-forward)
      )
    )
    (blank)
    (call (. root markup-batch-queue checkpoint))
    (probe-count markup.bench.steps)
    (+= checksum (+ (. root items length) (. root keyed-small length)))
    (+= checksum (+ (. root keyed-medium length) (. root keyed-large length) step))
  )
  (blank)
  (call C:brixCollect)
  (do
    (inline (call drain-reclaim-cleanups))
  )
  (let final-markup-attachments (call C:brixGCObjectSidePayloadCount markup-attachment-lane))
  (let final-markup-hosts (call collection-bench-host-count root))
  (throw (call Panic "markup/collection-coalesce-remount retained reclaimed attachment owners") (if (!= final-markup-attachments (+ opening-markup-attachments final-markup-hosts))))
  (throw (call Panic "markup/collection-coalesce-remount lost its live attachment tree") (if (<= final-markup-attachments opening-markup-attachments)))
  (blank)
  (print (str "bench-result markup/collection-coalesce-remount checksum=" checksum))
)

(type + CollectionBenchItem (is Tuple)
  (prop + id String)
  (prop + text String)
)

(type + CollectionBenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + items (list CollectionBenchItem))
  (prop + keyed-small (list CollectionBenchItem))
  (prop + keyed-medium (list CollectionBenchItem))
  (prop + keyed-large (list CollectionBenchItem))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This
      (<> Box
        (for (in item #items)
          (<> Label
            (= text (. item text))
          )
        )
      )
      (blank)
      (<> Box
        (for (in item #keyed-small (keyed-by (. item id)))
          (<> Label
            (= text (. item text))
          )
        )
      )
      (blank)
      (<> Box
        (for (in item #keyed-medium (keyed-by (. item id)))
          (<> Label
            (= text (. item text))
          )
        )
      )
      (blank)
      (<> Box
        (for (in item #keyed-large (keyed-by (. item id)))
          (<> Label
            (= text (. item text))
          )
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(fn-expr _ make-collection-items (list CollectionBenchItem)
  (param count Size)
  (param prefix String)
  (in (call CollectionBenchItem (str prefix "-" each) (str prefix " row " each)) (..< 0 count))
)

(fn-do _ reversed-items (list CollectionBenchItem)
  (param source (list CollectionBenchItem))
  (let items (list CollectionBenchItem))
  (let index (. source length))
  (while (> index 0)
    (-= index 1)
    (+= items ([] source index))
  )
  (return items)
)

(fn-do _ collection-bench-host-count Size
  (param root MarkupElement)
  (let count Size 1)
  (let cursor (call markup-query-first-descendant-host root))
  (while cursor
    (+= count 1)
    (= cursor (call markup-query-next-descendant-host root cursor))
  )
  (return count)
)
