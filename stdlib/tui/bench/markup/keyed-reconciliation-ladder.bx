; benchmark.meta description: Measures unchanged, reverse, shuffled, and sparse-edit keyed rebuilds by size.
; benchmark.meta timing: recommended
; benchmark.meta profiles: markup-runtime,compile-timing
(blank)
(import /core/markup)
(import /core/style)
(import /time/timer)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let checksum Size 0)
  (blank)
  (+= checksum (call run-keyed-reconciliation-ladder 0))
  (+= checksum (call run-keyed-reconciliation-ladder 4))
  (+= checksum (call run-keyed-reconciliation-ladder 16))
  (+= checksum (call run-keyed-reconciliation-ladder 32))
  (+= checksum (call run-keyed-reconciliation-ladder 64))
  (+= checksum (call run-keyed-reconciliation-ladder 256))
  (+= checksum (call run-keyed-reconciliation-ladder 1023))
  (+= checksum (call run-keyed-reconciliation-ladder 1024))
  (+= checksum (call run-keyed-reconciliation-ladder 4096))
  (+= checksum (call run-keyed-reconciliation-ladder 16384))
  (blank)
  (print (str "bench-result markup/keyed-reconciliation-ladder checksum=" checksum))
)

(fn-do _ run-keyed-reconciliation-ladder Size
  (param size Size)
  (let forward (call make-keyed-ladder-items size "row"))
  (let unchanged (call make-keyed-ladder-items size "same"))
  (let backward (call reverse-keyed-ladder-items forward))
  (let shuffled (call shuffle-keyed-ladder-items forward))
  (let sparse (call sparse-keyed-ladder-items forward))
  (blank)
  (let root (call KeyedLadderRoot))
  (= (. root items) forward)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let started (call monotonic-time-nanoseconds))
  (= (. root items) unchanged)
  (call (. root markup-batch-queue checkpoint))
  (= (. root items) backward)
  (call (. root markup-batch-queue checkpoint))
  (= (. root items) shuffled)
  (call (. root markup-batch-queue checkpoint))
  (= (. root items) sparse)
  (call (. root markup-batch-queue checkpoint))
  (let elapsed (- (call monotonic-time-nanoseconds) started))
  (blank)
  (call record-keyed-ladder-time size elapsed)
  (return (+ size (as elapsed Size)))
)

(type + KeyedLadderItem (is Tuple)
  (prop + id String)
  (prop + text String)
)

(type + KeyedLadderRoot (is Box)
  (implements MarkupRootElement)
  (prop + items (list KeyedLadderItem))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This
      (for (in item #items (keyed-by (. item id)))
        (<> Label
          (= text (. item text))
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(fn-expr _ make-keyed-ladder-items (list KeyedLadderItem)
  (param count Size)
  (param prefix String)
  (in (call KeyedLadderItem (str "id-" each) (str prefix "-" each)) (..< 0 count))
)

(fn-do _ reverse-keyed-ladder-items (list KeyedLadderItem)
  (param source (list KeyedLadderItem))
  (let items (list KeyedLadderItem))
  (let index (. source length))
  (while (> index 0)
    (-= index 1)
    (+= items ([] source index))
  )
  (return items)
)

(fn-do _ shuffle-keyed-ladder-items (list KeyedLadderItem)
  (param source (list KeyedLadderItem))
  (let items (list KeyedLadderItem))
  (for (in item source)
    (+= items item)
  )
  (blank)
  (let state U64 17)
  (let index (. items length))
  (while (> index 1)
    (-= index 1)
    (= state (+ (* state 1664525) 1013904223))
    (let swap-index (as (% state (as (+ index 1) U64)) Index))
    (let temporary ([] items index))
    (= ([] items index) ([] items swap-index))
    (= ([] items swap-index) temporary)
  )
  (return items)
)

(fn-do _ sparse-keyed-ladder-items (list KeyedLadderItem)
  (param source (list KeyedLadderItem))
  (let items (list KeyedLadderItem))
  (let index Index 0)
  (for (in item source)
    (if (== (% index 16) 0)
      (+= items (call KeyedLadderItem (str "edited-" index) (str "edited-" index)))
      (else
        (+= items item)
      )
    )
    (+= index 1)
  )
  (return items)
)

(fn-do _ record-keyed-ladder-time _
  (param size Size)
  (param elapsed U64)
  (if (== size 0)
    (probe-count markup.bench.keyed-ladder-0-ns elapsed)
    (else-if (== size 4)
      (probe-count markup.bench.keyed-ladder-4-ns elapsed)
    )
    (else-if (== size 16)
      (probe-count markup.bench.keyed-ladder-16-ns elapsed)
    )
    (else-if (== size 32)
      (probe-count markup.bench.keyed-ladder-32-ns elapsed)
    )
    (else-if (== size 64)
      (probe-count markup.bench.keyed-ladder-64-ns elapsed)
    )
    (else-if (== size 256)
      (probe-count markup.bench.keyed-ladder-256-ns elapsed)
    )
    (else-if (== size 1023)
      (probe-count markup.bench.keyed-ladder-1023-ns elapsed)
    )
    (else-if (== size 1024)
      (probe-count markup.bench.keyed-ladder-1024-ns elapsed)
    )
    (else-if (== size 4096)
      (probe-count markup.bench.keyed-ladder-4096-ns elapsed)
    )
    (else-if (== size 16384)
      (probe-count markup.bench.keyed-ladder-16384-ns elapsed)
    )
  )
)
