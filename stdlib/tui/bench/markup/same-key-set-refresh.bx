; benchmark.meta description: Refreshes same-key collection rows in place with changed-key and explicit-replace controls.
; benchmark.meta timing: recommended
; benchmark.meta profiles: markup-runtime,compile-timing
(blank)
(import /core/markup)
(import /core/style)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let row-count Size 256)
  (let same-key-passes Size 40)
  (blank)
  (let root (call SameKeyBenchRoot))
  (blank)
  (= (. root items) (call make-same-key-items row-count "opening"))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let region (!! (. root %first-child)))
  (let opening-rows (list SameKeyBenchRow))
  (for (in index (..< 0 row-count))
    (+= opening-rows (as (!! (call (. region child-at) index)) SameKeyBenchRow))
  )
  (blank)
  (let identity-preserved Size 0)
  (let checksum Size 0)
  (blank)
  (= (. root phase) 1)
  (for (in pass (..< 0 same-key-passes))
    (for (in index (..< 0 row-count))
      (let id (str "row-" index))
      (= ([] (. root items) index) (call SameKeyBenchItem id (str "same-" pass "-" index)))
    )
    (blank)
    (call (. root markup-batch-queue checkpoint))
    (blank)
    (for (in index (..< 0 row-count))
      (let row (as (!! (call (. region child-at) index)) SameKeyBenchRow))
      (throw (call Panic "markup/same-key-set-refresh changed same-key row identity") (if (!= row ([] opening-rows index))))
      (throw (call Panic "markup/same-key-set-refresh left tracked row content stale") (if (!= (. row text) (str "same-" pass "-" index))))
      (+= identity-preserved 1)
      (+= checksum (+ (. row text length) index))
    )
  )
  (blank)
  (let changed-before (list SameKeyBenchRow))
  (= (. root phase) 2)
  (for (in index (..< 0 row-count))
    (+= changed-before (as (!! (call (. region child-at) index)) SameKeyBenchRow))
    (= ([] (. root items) index) (call SameKeyBenchItem (str "changed-" index) (str "changed-" index)))
  )
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (for (in index (..< 0 row-count))
    (let row (as (!! (call (. region child-at) index)) SameKeyBenchRow))
    (throw (call Panic "markup/same-key-set-refresh reused a changed-key row") (if (== row ([] changed-before index))))
    (throw (call Panic "markup/same-key-set-refresh lost changed-key content") (if (!= (. row text) (str "changed-" index))))
    (+= checksum (. row text length))
  )
  (blank)
  (let forced-before (list SameKeyBenchRow))
  (= (. root phase) 3)
  (for (in index (..< 0 row-count))
    (+= forced-before (as (!! (call (. region child-at) index)) SameKeyBenchRow))
    (call (. root items replace) index (call SameKeyBenchItem (str "changed-" index) (str "forced-" index)))
  )
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (for (in index (..< 0 row-count))
    (let row (as (!! (call (. region child-at) index)) SameKeyBenchRow))
    (throw (call Panic "markup/same-key-set-refresh reused an explicitly replaced row") (if (== row ([] forced-before index))))
    (throw (call Panic "markup/same-key-set-refresh lost explicit replacement content") (if (!= (. row text) (str "forced-" index))))
    (+= checksum (. row text length))
  )
  (blank)
  (probe-count markup.bench.same-key.identity-preserved identity-preserved)
  (blank)
  (print (str "bench-result markup/same-key-set-refresh checksum=" checksum))
)

(type + SameKeyBenchItem
  (prop + id String)
  (prop + text String)
  (fn-do + This _
    (param id _)
    (param text _)
  )
)

(type + SameKeyBenchRow (is Label)
  (prop + sink SameKeyBenchRoot)
  (fn-do + This _
    (param sink _)
    (if (== (. sink phase) 1)
      (probe-count markup.bench.same-key.builds)
      (else-if (> (. sink phase) 1)
        (probe-count markup.bench.same-key.control-builds)
      )
    )
  )
  (fn-do + mounted _
    (if (== (. sink phase) 1)
      (probe-count markup.bench.same-key.mounts)
      (else-if (> (. sink phase) 1)
        (probe-count markup.bench.same-key.control-mounts)
      )
    )
  )
  (fn-do + unmounted _
    (if (== (. sink phase) 1)
      (probe-count markup.bench.same-key.unmounts)
      (else-if (> (. sink phase) 1)
        (probe-count markup.bench.same-key.control-unmounts)
      )
    )
  )
)

(type + SameKeyBenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + items (list SameKeyBenchItem))
  (prop + phase Size (= 0))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This
      (for (in item #items (keyed-by (call same-key-bench-key item)))
        (<> SameKeyBenchRow
          (= sink this)
          (= text (. item text))
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(fn-do _ same-key-bench-key String
  (param item SameKeyBenchItem)
  (probe-count markup.bench.same-key.key-calls)
  (return (. item id))
)

(fn-expr _ make-same-key-items (list SameKeyBenchItem)
  (param count Size)
  (param phase String)
  (in (call SameKeyBenchItem (str "row-" each) (str phase "-" each)) (..< 0 count))
)
