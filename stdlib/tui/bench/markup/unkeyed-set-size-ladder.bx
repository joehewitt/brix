; benchmark.meta description: Measures a two-row middle set from 16 through 16,384 unkeyed rows.
; benchmark.meta timing: recommended
; benchmark.meta profiles: markup-runtime,compile-timing
(blank)
(import /core/markup)
(import /core/style)
(import /time/timer)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let checksum Size 0)
  (blank)
  (+= checksum (call run-unkeyed-set-ladder 16))
  (+= checksum (call run-unkeyed-set-ladder 64))
  (+= checksum (call run-unkeyed-set-ladder 256))
  (+= checksum (call run-unkeyed-set-ladder 1024))
  (+= checksum (call run-unkeyed-set-ladder 4096))
  (+= checksum (call run-unkeyed-set-ladder 16384))
  (blank)
  (print (str "bench-result markup/unkeyed-set-size-ladder checksum=" checksum))
)

(fn-do _ run-unkeyed-set-ladder Size
  (param size Size)
  (let root (call UnkeyedSetLadderRoot))
  (= (. root items) (call make-unkeyed-set-ladder-items size))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let middle Index (/ size 2))
  (blank)
  (= (. root measuring) true)
  (let started (call monotonic-time-nanoseconds))
  (= ([] (. root items) middle) (call UnkeyedSetLadderItem "changed-a"))
  (= ([] (. root items) (+ middle 1)) (call UnkeyedSetLadderItem "changed-b"))
  (call (. root markup-batch-queue checkpoint))
  (let elapsed (- (call monotonic-time-nanoseconds) started))
  (= (. root measuring) false)
  (blank)
  (throw (call Panic "markup/unkeyed-set-size-ladder remounted outside the changed range") (if (or (!= (. root mounts) 2) (!= (. root unmounts) 2))))
  (call record-unkeyed-set-ladder size elapsed (. root mounts))
  (blank)
  (probe-log _ (text: "Count-changing controls retain their shifting semantics outside the set timing."))
  (call (. root items insert) (call UnkeyedSetLadderItem "insert-control") middle)
  (call (. root markup-batch-queue checkpoint))
  (call (. root items remove) middle)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (return (+ size middle (. root mounts) (. root unmounts) (as elapsed Size)))
)

(type + UnkeyedSetLadderItem (is Tuple)
  (prop + text String)
)

(type + UnkeyedSetLadderRow (is Label)
  (prop + sink UnkeyedSetLadderRoot)
  (fn-do + mounted _
    (if (. sink measuring)
      (+= (. sink mounts) 1)
    )
  )
  (fn-do + unmounted _
    (if (. sink measuring)
      (+= (. sink unmounts) 1)
    )
  )
)

(type + UnkeyedSetLadderRoot (is Box)
  (implements MarkupRootElement)
  (prop + items (list UnkeyedSetLadderItem))
  (prop + measuring _ (= false))
  (prop + mounts Size (= 0))
  (prop + unmounts Size (= 0))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This
      (for (in item #items)
        (<> UnkeyedSetLadderRow
          (= sink this)
          (= text (. item text))
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(fn-expr _ make-unkeyed-set-ladder-items (list UnkeyedSetLadderItem)
  (param count Size)
  (in (call UnkeyedSetLadderItem (str "row-" each)) (..< 0 count))
)

(fn-do _ record-unkeyed-set-ladder _
  (param size Size)
  (param elapsed U64)
  (param remounts Size)
  (if (== size 16)
    (probe-count markup.bench.unkeyed-set.ladder-16-ns elapsed)
    (probe-count markup.bench.unkeyed-set.ladder-16-remounts remounts)
    (else-if (== size 64)
      (probe-count markup.bench.unkeyed-set.ladder-64-ns elapsed)
      (probe-count markup.bench.unkeyed-set.ladder-64-remounts remounts)
    )
    (else-if (== size 256)
      (probe-count markup.bench.unkeyed-set.ladder-256-ns elapsed)
      (probe-count markup.bench.unkeyed-set.ladder-256-remounts remounts)
    )
    (else-if (== size 1024)
      (probe-count markup.bench.unkeyed-set.ladder-1024-ns elapsed)
      (probe-count markup.bench.unkeyed-set.ladder-1024-remounts remounts)
    )
    (else-if (== size 4096)
      (probe-count markup.bench.unkeyed-set.ladder-4096-ns elapsed)
      (probe-count markup.bench.unkeyed-set.ladder-4096-remounts remounts)
    )
    (else-if (== size 16384)
      (probe-count markup.bench.unkeyed-set.ladder-16384-ns elapsed)
      (probe-count markup.bench.unkeyed-set.ladder-16384-remounts remounts)
    )
  )
)
