`benchmark.meta description: Exercises collection coalescing, unkeyed remounts, and keyed rebuild reuse.
`benchmark.meta timing: recommended
`benchmark.meta profiles: markup-runtime,compile-timing

/YuGC/YuGC.h
/core/markup
/core/style
/gc/gc
/tui/box
/tui/layout
/tui/primitives
/tui/text

. step-count Size = 48
. markup-attachment-lane = C:yumiGCMarkupAttachmentsSidePayloadLane()
C:yumiCollect()
do drain-reclaim-cleanups()
. opening-markup-attachments = C:yumiGCObjectSidePayloadCount(markup-attachment-lane)
do opening-markup-attachments

. small-forward = make-collection-items(64, "small")
. small-backward = reversed-items(small-forward)
. medium-forward = make-collection-items(512, "medium")
. medium-backward = reversed-items(medium-forward)
. large-forward = make-collection-items(900, "large")
. large-backward = reversed-items(large-forward)

. root = CollectionBenchRoot()
root.items = make-collection-items(384, "unkeyed")
root.keyed-small = small-forward
root.keyed-medium = medium-forward
root.keyed-large = large-forward

markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
. settled-markup-attachments = C:yumiGCObjectSidePayloadCount(markup-attachment-lane)
do settled-markup-attachments
. settled-markup-hosts = collection-bench-host-count(root)
?! Panic("markup/collection-coalesce-remount initial attachment tree is inconsistent")
    if settled-markup-attachments != opening-markup-attachments + settled-markup-hosts

. checksum Size = 0
for step in 0 .. < step-count
    root.items += CollectionBenchItem("temp-$step", "temp-$step")
    root.items.remove(root.items.length - 1)
    root.items[step % root.items.length] = CollectionBenchItem("set-$step", "set-$step")

    if step % 2 == 0
        root.keyed-small = small-backward
        root.keyed-medium = medium-backward
        root.keyed-large = large-backward
    else
        root.keyed-small = small-forward
        root.keyed-medium = medium-forward
        root.keyed-large = large-forward

    root.markup-batch-queue.checkpoint()
    //markup.bench.steps ++
    checksum += root.items.length + root.keyed-small.length
    checksum += root.keyed-medium.length + root.keyed-large.length + step

C:yumiCollect()
do drain-reclaim-cleanups()
. final-markup-attachments = C:yumiGCObjectSidePayloadCount(markup-attachment-lane)
. final-markup-hosts = collection-bench-host-count(root)
?! Panic("markup/collection-coalesce-remount retained reclaimed attachment owners")
    if final-markup-attachments != opening-markup-attachments + final-markup-hosts
?! Panic("markup/collection-coalesce-remount lost its live attachment tree")
    if final-markup-attachments <= opening-markup-attachments

-- "bench-result markup/collection-coalesce-remount checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ CollectionBenchItem is Tuple

+ id String
+ text String

━━━━━━━━━━━━━━━━━━━━
+ CollectionBenchRoot is Box
    is MarkupBatch

+ items [CollectionBenchItem]
+ keyed-small [CollectionBenchItem]
+ keyed-medium [CollectionBenchItem]
+ keyed-large [CollectionBenchItem]
+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────

<This
    <Box
        for item in #items
            <Label
                text = item.text

    <Box
        for item in #keyed-small keyed by item.id
            <Label
                text = item.text

    <Box
        for item in #keyed-medium keyed by item.id
            <Label
                text = item.text

    <Box
        for item in #keyed-large keyed by item.id
            <Label
                text = item.text

╌╌╌╌╌╌╌╌╌╌ is MarkupBatch ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
_ make-collection-items [CollectionBenchItem]
    - count Size
    - prefix String

CollectionBenchItem("${prefix}-$each", "$prefix row $each") in 0 .. < count

━━━━━━━━━━━━━━━━━━━━
_ do reversed-items [CollectionBenchItem]
    - source [CollectionBenchItem]

. items [CollectionBenchItem]
. index = source.length
while index > 0
    index -= 1
    items += source[index]
= items

━━━━━━━━━━━━━━━━━━━━
_ do collection-bench-host-count Size
    - root MarkupHost

. count Size = 1
. cursor = markup-query-first-descendant-host(root)
while cursor
    count += 1
    cursor = markup-query-next-descendant-host(root, cursor)
= count
