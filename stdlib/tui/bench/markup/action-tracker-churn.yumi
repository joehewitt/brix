`benchmark.meta description: Flips many tracked dynamic declarations between alternate dependency sets.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gc-runtime,markup-runtime,compile-timing

/BxCore/BxCore.h
/core/markup
/core/style
/tui/box
/tui/layout
/tui/primitives
/tui/text

. row-count Size = 180
. step-count Size = 120

<ActionTrackerRoot root

root.row-indexes = make-indexes(row-count)
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
. subscriber-payloads-before = C:brixGCObjectSidePayloadCount(0)

. checksum Size = 0
for step in 0 .. < step-count
    root.mode = step % 3
    root.primary = "primary-$step"
    root.secondary = "secondary-${step % 17}"
    root.tertiary = "tertiary-${step % 31}"
    root.markup-batch-queue.checkpoint()
    //markup.bench.steps ++
    checksum += root.mode + root.primary.length + root.sample-text.length + step

C:brixBenchCollect()
. subscriber-payloads-after = C:brixGCObjectSidePayloadCount(0)
` No-GC and never-collect variants intentionally retain side payloads, so only bound normal GC.
if C:brixGCRuntimeMode() == 2
    ` Each remounted keyed row has a refreshable row-item lane plus its dynamic declaration lane.
    . subscriber-payload-limit = subscriber-payloads-before + row-count * step-count * 2
    ?! Panic("Property subscriber lane growth exceeded the per-row churn bound")
        if subscriber-payloads-after > subscriber-payload-limit

-- "bench-result markup/action-tracker-churn checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ ActionTrackerRoot is Box
    is MarkupRootElement

+ row-indexes [SyntheticIndex]
+ mode Size = 0
+ primary = "primary-0"
+ secondary = "secondary-0"
+ tertiary = "tertiary-0"
+ markup-batch-queue := MarkupBatchQueue(this)
+ sample-text => action-tracker-text(mode, primary, secondary, tertiary)

────────────────────

<This
    if #mode == 0
        for row in #row-indexes keyed by row.value
            <Label
                text = "${row.value}:#primary"
    else if #mode == 1
        for row in #row-indexes keyed by row.value
            <Label
                text = "${row.value}:#secondary"
    else
        for row in #row-indexes keyed by row.value
            <Label
                text = "${row.value}:#primary:#tertiary"

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
+ SyntheticIndex is Tuple

+ value Size

━━━━━━━━━━━━━━━━━━━━
_ action-tracker-text
    - mode Size
    - primary String
    - secondary String
    - tertiary String

match mode
    | 0
        primary
    | 1
        secondary
    ??
        "$primary:$tertiary"

━━━━━━━━━━━━━━━━━━━━
_ make-indexes [SyntheticIndex]
    - count Size

SyntheticIndex(each) in 0 .. < count
