; benchmark.meta description: Compares direct selected-row style toggles with root-index predicate fanout.
; benchmark.meta timing: recommended
; benchmark.meta profiles: markup-runtime,compile-timing
(blank)
(import /core/markup)
(import /core/style)
(import /tui/box)
(import /tui/colors)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let row-count Size 640)
  (let step-count Size 180)
  (blank)
  (let root (call StyleSelectionRoot))
  (let direct-host (call Box))
  (call markup-append root direct-host)
  (blank)
  (for (in index (..< 0 row-count))
    (let direct (call DirectSelectionRow index))
    (call markup-append direct-host direct)
    (+= (. root direct-rows) direct)
  )
  (blank)
  (= (. root row-models) (call make-indexes row-count))
  (blank)
  (call markup-mount-root root root)
  (= (. ([] (. root direct-rows) 0) is-selected) true)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let checksum Size 0)
  (for (in step (..< 0 step-count))
    (let old-index (. root selected-index))
    (let next-index (% (+ (* step 29) 7) row-count))
    (blank)
    (= (. ([] (. root direct-rows) old-index) is-selected) false)
    (= (. ([] (. root direct-rows) next-index) is-selected) true)
    (= (. root selected-index) next-index)
    (call (. root markup-batch-queue checkpoint))
    (blank)
    (probe-count markup.bench.steps)
    (+= checksum (+ old-index next-index (. ([] (. root direct-rows) next-index) text length) step))
  )
  (blank)
  (print (str "bench-result style/selection-predicate-toggle checksum=" checksum))
)

(type + StyleSelectionRoot (is Box)
  (implements MarkupRootElement)
  (prop + selected-index Size (= 0))
  (prop + direct-rows (list DirectSelectionRow))
  (prop + row-models (list SyntheticIndex))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (content
    (<> This
      (<> Box
        (for (in row #row-models (keyed-by (. row value)))
          (<> IndexedSelectionRow
            (= index (. row value))
            (= is-selected (== #selected-index (. row value)))
          )
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + DirectSelectionRow (is Label)
  (prop + index Size)
  (prop + is-selected _ (= false))
  (blank)
  (rule This
    (= color silver)
    (= background-color black)
    (blank)
    (when-style #is-selected
      (= color white)
      (= background-color navy)
    )
  )
  (fn-do + This _
    (param index _)
    (= text (str "direct-" index))
  )
)

(type + IndexedSelectionRow (is Label)
  (prop + index Size)
  (prop + is-selected _ (= false))
  (blank)
  (rule This
    (= color silver)
    (= background-color black)
    (blank)
    (when-style #is-selected
      (= color white)
      (= background-color teal)
    )
  )
  (fn-do + This _
    (param index _)
    (= text (str "indexed-" index))
  )
)

(type + SyntheticIndex (is Tuple)
  (prop + value Size)
)

(fn-expr _ make-indexes (list SyntheticIndex)
  (param count Size)
  (in (call SyntheticIndex each) (..< 0 count))
)
