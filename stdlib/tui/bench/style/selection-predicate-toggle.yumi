`benchmark.meta description: Compares direct selected-row style toggles with root-index predicate fanout.
`benchmark.meta timing: recommended
`benchmark.meta profiles: markup-runtime,compile-timing

/core/markup
/core/style
/tui/box
/tui/colors
/tui/layout
/tui/primitives
/tui/text

. row-count Size = 640
. step-count Size = 180

. root = StyleSelectionRoot()
. direct-host = Box()
markup-append(root, direct-host)

for index in 0 .. < row-count
    . direct = DirectSelectionRow(index)
    markup-append(direct-host, direct)
    root.direct-rows += direct

root.row-models = make-indexes(row-count)

markup-mount-root(root, root)
root.direct-rows[0].is-selected = true
root.markup-batch-queue.checkpoint()

. checksum Size = 0
for step in 0 .. < step-count
    . old-index = root.selected-index
    . next-index = (step * 29 + 7) % row-count

    root.direct-rows[old-index].is-selected = false
    root.direct-rows[next-index].is-selected = true
    root.selected-index = next-index
    root.markup-batch-queue.checkpoint()

    //markup.bench.steps ++
    checksum += old-index + next-index + root.direct-rows[next-index].text.length + step

-- "bench-result style/selection-predicate-toggle checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ StyleSelectionRoot is Box
    is MarkupRootElement

+ selected-index Size = 0
+ direct-rows [DirectSelectionRow]
+ row-models [SyntheticIndex]
+ markup-batch-queue := MarkupBatchQueue(this)

