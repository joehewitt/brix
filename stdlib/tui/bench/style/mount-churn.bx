; benchmark.meta description: Repeatedly mounts and unmounts a large styled TUI subtree.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gc-runtime,markup-runtime,compile-timing
(blank)
(import /BxCore/BxCore.h)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /core/style)
(import /tui/box)
(import /tui/colors)
(import /tui/layout)
(import /tui/primitives)
(blank)

(main
  (let attachment-lane (call C:brixGCStyleAttachmentsSidePayloadLane))
  (let template-lane (call C:brixGCStyleTemplatesSidePayloadLane))
  (let object-lane (call C:brixGCStyleObjectsSidePayloadLane))
  (let opening-style-attachments (call C:brixGCObjectSidePayloadCount attachment-lane))
  (let opening-style-templates (call C:brixGCObjectSidePayloadCount template-lane))
  (let opening-style-objects (call C:brixGCObjectSidePayloadCount object-lane))
  (blank)
  (let root (call StyleChurnRoot))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 120 40))
  (blank)
  (let subtree (call StyleChurnBranch))
  (let node-count Size 1)
  (for (in branch-index (..< 0 100))
    (let branch (call StyleChurnBranch))
    (call markup-append subtree branch)
    (+= node-count 1)
    (blank)
    (for (in leaf-index (..< 0 49))
      (let leaf (call StyleChurnLeaf))
      (call markup-append branch leaf)
      (+= node-count 1)
    )
  )
  (blank)
  (let cold-objects-before (call C:brixGCAllocatedObjectCount))
  (let cold-bytes-before (call C:brixGCAllocatedByteCount))
  (call markup-append root subtree)
  (call (. root markup-batch-queue checkpoint))
  (let cold-objects (- (call C:brixGCAllocatedObjectCount) cold-objects-before))
  (let cold-bytes (- (call C:brixGCAllocatedByteCount) cold-bytes-before))
  (let cold-style-side-payloads (call style-side-payload-count))
  (blank)
  (call markup-remove root subtree)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let warm-objects Size 0)
  (let warm-bytes Size 0)
  (let checksum node-count)
  (for (in cycle (..< 0 6))
    (let objects-before (call C:brixGCAllocatedObjectCount))
    (let bytes-before (call C:brixGCAllocatedByteCount))
    (call markup-append root subtree)
    (call (. root markup-batch-queue checkpoint))
    (call (. root update-layout))
    (+= checksum (+ (. root inner-width) (. root inner-height) cycle))
    (call markup-remove root subtree)
    (call (. root markup-batch-queue checkpoint))
    (+= warm-objects (as (- (call C:brixGCAllocatedObjectCount) objects-before) Size))
    (+= warm-bytes (as (- (call C:brixGCAllocatedByteCount) bytes-before) Size))
  )
  (blank)
  (let warm-objects-per-cycle (/ warm-objects 6))
  (let warm-bytes-per-cycle (/ warm-bytes 6))
  (let cold-objects-per-node (/ cold-objects node-count))
  (let cold-bytes-per-node (/ cold-bytes node-count))
  (let warm-objects-per-node (/ warm-objects-per-cycle node-count))
  (let warm-bytes-per-node (/ warm-bytes-per-cycle node-count))
  (blank)
  (call C:brixBenchCollect)
  (blank)
  (let final-style-attachments (call C:brixGCObjectSidePayloadCount attachment-lane))
  (let final-style-templates (call C:brixGCObjectSidePayloadCount template-lane))
  (let final-style-objects (call C:brixGCObjectSidePayloadCount object-lane))
  (let maximum-style-objects (+ opening-style-objects 16))
  (throw (call Panic "style/mount-churn attachment lane escaped its mounted root bound") (if (!= final-style-attachments (+ opening-style-attachments 1))))
  (throw (call Panic "style/mount-churn template lane lost or retained an owner association") (if (!= final-style-templates (+ opening-style-templates node-count 1))))
  (throw (call Panic "style/mount-churn object lane escaped its static-site bound") (if (or (< final-style-objects opening-style-objects) (> final-style-objects maximum-style-objects))))
  (blank)
  (print (str "bench-result style/mount-churn checksum=" checksum))
)

(type + StyleChurnRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (blank)
    (= layout flex-col)
    (= flex 1)
    (= background-color navy)
    (= color white)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + StyleChurnBranch (is Box)
  (rule This
    (blank)
    (= layout flex-row)
    (= flex 1)
    (= background-color blue)
    (= color silver)
  )
)

(type + StyleChurnLeaf (is Box)
  (rule This
    (blank)
    (= layout flow-col)
    (= flex 1)
    (= background-color teal)
    (= color white)
  )
)

(fn-expr _ style-attachments-side-payload-count Size
  (as (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleAttachmentsSidePayloadLane)) Size)
)

(fn-do _ style-side-payload-count _
  (let count (call style-attachments-side-payload-count))
  (+= count (as (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleTemplatesSidePayloadLane)) Size))
  (+= count (as (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleObjectsSidePayloadLane)) Size))
  (return count)
)
