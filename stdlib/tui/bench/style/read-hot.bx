; benchmark.meta description: Repeatedly reads mounted TUI style properties from a settled tree.
; benchmark.meta timing: recommended
; benchmark.meta profiles: markup-runtime,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /core/style)
(import /tui/box)
(import /tui/canvas)
(import /tui/colors)
(import /tui/layout)
(import /tui/primitives)
(blank)

(main
  (let attachment-lane (call C:brixGCStyleAttachmentsSidePayloadLane))
  (let template-lane (call C:brixGCStyleTemplatesSidePayloadLane))
  (let object-lane (call C:brixGCStyleObjectsSidePayloadLane))
  (let opening-style-attachments (call C:brixGCObjectSidePayloadCount attachment-lane))
  (let opening-style-templates (call C:brixGCObjectSidePayloadCount template-lane))
  (let opening-style-objects (call C:brixGCObjectSidePayloadCount object-lane))
  (blank)
  (let root (call StyleReadRoot))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 120 40))
  (blank)
  (let boxes (list Box))
  (+= boxes root)
  (blank)
  (for (in row-index (..< 0 32))
    (let row (call StyleReadRow))
    (call markup-append root row)
    (+= boxes row)
    (blank)
    (for (in column-index (..< 0 31))
      (let cell (call StyleReadCell))
      (call markup-append row cell)
      (+= boxes cell)
    )
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (blank)
  (let checksum Size 0)
  (for (in pass (..< 0 96))
    (for (in box boxes)
      (+= checksum (. box $flex))
      (if (. box $layout)
        (+= checksum 1)
      )
      (if (. box $background-color)
        (+= checksum (call background-checksum (!! (. box $background-color))))
      )
      (+= checksum (. box $color))
    )
  )
  (blank)
  (+= checksum (. boxes length))
  (+= checksum (call style-side-payload-count))
  (blank)
  (let final-style-attachments (call C:brixGCObjectSidePayloadCount attachment-lane))
  (let final-style-templates (call C:brixGCObjectSidePayloadCount template-lane))
  (let final-style-objects (call C:brixGCObjectSidePayloadCount object-lane))
  (let maximum-style-objects (+ opening-style-objects 16))
  (throw (call Panic "style/read-hot attachment lane escaped its mounted root bound") (if (!= final-style-attachments (+ opening-style-attachments 1))))
  (throw (call Panic "style/read-hot template lane does not match the live tree") (if (!= final-style-templates (+ opening-style-templates (. boxes length)))))
  (throw (call Panic "style/read-hot object lane escaped its static-site bound") (if (or (< final-style-objects opening-style-objects) (> final-style-objects maximum-style-objects))))
  (blank)
  (print (str "bench-result style/read-hot checksum=" checksum))
)

(type + StyleReadRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flex-col)
    (= flex 1)
    (= background-color navy)
    (= color white)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + StyleReadRow (is Box)
  (rule This
    (= layout flex-row)
    (= flex 1)
    (= background-color blue)
    (= color silver)
  )
)

(type + StyleReadCell (is Box)
  (rule This
    (= layout flow-col)
    (= flex 1)
    (= background-color teal)
    (= color white)
  )
)

(fn-expr _ background-checksum Size
  (param background BackgroundColor)
  (match background
    (case (call .ansi color)
      (as color Size)
    )
    (default
      0
    )
  )
)

(fn-do _ style-side-payload-count Size
  (let count (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleAttachmentsSidePayloadLane)))
  (+= count (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleTemplatesSidePayloadLane)))
  (+= count (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleObjectsSidePayloadLane)))
  (return (as count Size))
)
