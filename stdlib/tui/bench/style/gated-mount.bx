; benchmark.meta description: Builds and mounts large TUI subtrees whose boxes carry fixed when-gated styles.
; benchmark.meta timing: recommended
; benchmark.meta profiles: markup-runtime,compile-timing
(blank)
(import /core/markup)
(import /core/style)
(import /tui/box)
(import /tui/colors)
(import /tui/layout)
(import /tui/primitives)
(blank)

(main
  (let root (call GatedMountRoot))
  (call markup-mount-root root root)
  (= (. root bounds) (call Rect 0 0 120 40))
  (blank)
  (let checksum Size 0)
  (for (in cycle (..< 0 8))
    (let subtree (call GatedMountBranch cycle))
    (for (in branch-index (..< 0 50))
      (let branch (call GatedMountBranch branch-index))
      (call markup-append subtree branch)
      (for (in leaf-index (..< 0 40))
        (call markup-append branch (call GatedMountLeaf leaf-index))
      )
    )
    (call markup-append root subtree)
    (call (. root markup-batch-queue checkpoint))
    (call (. root update-layout))
    (+= checksum (+ (. root inner-width) (. root inner-height) cycle))
    (call markup-remove root subtree)
    (call (. root markup-batch-queue checkpoint))
  )
  (blank)
  (print (str "bench-result style/gated-mount checksum=" checksum))
)

(type + GatedMountRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flex-col)
    (= flex 1)
    (= background-color navy)
    (= color white)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + GatedMountBranch (is Box)
  (prop + index Size)
  (prop + is-even _ (= (== (% #index 2) 0)))
  (blank)
  (rule This
    (= layout flex-row)
    (= flex 1)
    (= background-color blue)
    (= color silver)
    (blank)
    (when-style #is-even
      (= background-color purple)
      (= color white)
    )
  )
  (fn-do + This _
    (param index _)
  )
)

(type + GatedMountLeaf (is Box)
  (prop + index Size)
  (prop + is-first _ (= (== (% #index 3) 0)))
  (prop + is-second _ (= (== (% #index 3) 1)))
  (prop + is-wide _ (= (== (% #index 5) 0)))
  (blank)
  (rule This
    (= layout flow-col)
    (= flex 1)
    (= background-color teal)
    (= color white)
    (blank)
    (when-style #is-first
      (= background-color navy)
      (= color silver)
    )
    (blank)
    (when-style #is-second
      (= background-color maroon)
      (= color lime)
    )
    (blank)
    (when-style #is-wide
      (= flex 2)
      (= background-color olive)
    )
  )
  (fn-do + This _
    (param index _)
  )
)
