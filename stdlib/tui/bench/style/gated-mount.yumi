`benchmark.meta description: Builds and mounts large TUI subtrees whose boxes carry fixed when-gated styles.
`benchmark.meta timing: recommended
`benchmark.meta profiles: markup-runtime,compile-timing

/core/markup
/core/style
/tui/box
/tui/colors
/tui/layout
/tui/primitives

. root = GatedMountRoot()
markup-mount-root(root, root)
root.bounds = Rect(0, 0, 120, 40)

. checksum Size = 0
for cycle in 0 .. < 8
    . subtree = GatedMountBranch(cycle)
    for branch-index in 0 .. < 50
        . branch = GatedMountBranch(branch-index)
        markup-append(subtree, branch)
        for leaf-index in 0 .. < 40
            markup-append(branch, GatedMountLeaf(leaf-index))
    markup-append(root, subtree)
    root.markup-batch-queue.checkpoint()
    root.update-layout()
    checksum += root.inner-width + root.inner-height + cycle
    markup-remove(root, subtree)
    root.markup-batch-queue.checkpoint()

-- "bench-result style/gated-mount checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ GatedMountRoot is Box
    is MarkupRootElement

+ markup-batch-queue := MarkupBatchQueue(this)

• This
    layout = flex-col
    flex = 1
    background-color = navy
    color = white

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
+ GatedMountBranch is Box

+ index Size
+ is-even = #index % 2 == 0

• This
    layout = flex-row
    flex = 1
    background-color = blue
    color = silver

    when #is-even
        background-color = purple
        color = white

────────────────────
+ This
    - index

━━━━━━━━━━━━━━━━━━━━
+ GatedMountLeaf is Box

+ index Size
+ is-first = #index % 3 == 0
+ is-second = #index % 3 == 1
+ is-wide = #index % 5 == 0

• This
