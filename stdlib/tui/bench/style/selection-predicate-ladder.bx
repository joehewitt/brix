; benchmark.meta description: Measures stable selected-index predicate fanout at 100, 1,000, and 5,000 rows.
; benchmark.meta timing: recommended
; benchmark.meta profiles: markup-runtime,compile-timing
(blank)
(import /core/markup)
(import /core/style)
(import /time/timer)
(import /tui/box)
(import /tui/colors)
(import /tui/layout)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (let checksum Size 0)
  (blank)
  (+= checksum (call run-selection-predicate-ladder 100))
  (+= checksum (call run-selection-predicate-ladder 1000))
  (+= checksum (call run-selection-predicate-ladder 5000))
  (blank)
  (print (str "bench-result style/selection-predicate-ladder checksum=" checksum))
)

(fn-do _ run-selection-predicate-ladder Size
  (param size Size)
  (let root (call SelectionPredicateLadderRoot))
  (= (. root row-models) (call make-selection-predicate-indexes size))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let started (call monotonic-time-nanoseconds))
  (for (in step (..< 0 4))
    (= (. root selected-index) (% (+ (* step 29) 7) size))
    (call (. root markup-batch-queue checkpoint))
  )
  (let elapsed (- (call monotonic-time-nanoseconds) started))
  (blank)
  (call record-selection-predicate-ladder size elapsed)
  (return (+ size (. root selected-index) (as elapsed Size)))
)

(type + SelectionPredicateLadderRoot (is Box)
  (implements MarkupRootElement)
  (prop + selected-index Size (= 0))
  (prop + row-models (list SelectionPredicateIndex))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This
      (for (in row #row-models (keyed-by (. row value)))
        (<> SelectionPredicateLadderRow
          (= index (. row value))
          (= is-selected (== #selected-index (. row value)))
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + SelectionPredicateLadderRow (is Label)
  (prop + index Size)
  (prop + is-selected _ (= false))
  (blank)
  (rule This
    (= color silver)
    (= background-color black)
    (blank)
    (when-style #is-selected
      (= color white)
      (= background-color teal)
    )
  )
  (fn-do + This _
    (param index _)
    (= text (str "indexed-" index))
  )
)

(type + SelectionPredicateIndex (is Tuple)
  (prop + value Size)
)

(fn-expr _ make-selection-predicate-indexes (list SelectionPredicateIndex)
  (param count Size)
  (in (call SelectionPredicateIndex each) (..< 0 count))
)

(fn-do _ record-selection-predicate-ladder _
  (param size Size)
  (param elapsed U64)
  (if (== size 100)
    (probe-count markup.bench.selection-predicate.ladder-100-ns elapsed)
    (else-if (== size 1000)
      (probe-count markup.bench.selection-predicate.ladder-1000-ns elapsed)
    )
    (else-if (== size 5000)
      (probe-count markup.bench.selection-predicate.ladder-5000-ns elapsed)
    )
  )
)
