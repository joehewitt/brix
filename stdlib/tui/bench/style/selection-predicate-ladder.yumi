`benchmark.meta description: Measures stable selected-index predicate fanout at 100, 1,000, and 5,000 rows.
`benchmark.meta timing: recommended
`benchmark.meta profiles: markup-runtime,compile-timing

/core/markup
/core/style
/time/timer
/tui/box
/tui/colors
/tui/layout
/tui/primitives
/tui/text

. checksum Size = 0

checksum += run-selection-predicate-ladder(100)
checksum += run-selection-predicate-ladder(1000)
checksum += run-selection-predicate-ladder(5000)

-- "bench-result style/selection-predicate-ladder checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do run-selection-predicate-ladder Size
    - size Size

. root = SelectionPredicateLadderRoot()
root.row-models = make-selection-predicate-indexes(size)
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()

. started = monotonic-time-nanoseconds()
for step in 0 .. < 4
    root.selected-index = (step * 29 + 7) % size
    root.markup-batch-queue.checkpoint()
. elapsed = monotonic-time-nanoseconds() - started

record-selection-predicate-ladder(size, elapsed)
= size + root.selected-index + (elapsed as Size)

━━━━━━━━━━━━━━━━━━━━
+ SelectionPredicateLadderRoot is Box
    is MarkupBatch

+ selected-index Size = 0
+ row-models [SelectionPredicateIndex]
+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────

<This
    for row in #row-models keyed by row.value
        <SelectionPredicateLadderRow
            index = row.value
            is-selected = #selected-index == row.value

╌╌╌╌╌╌╌╌╌╌ is MarkupBatch ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
+ SelectionPredicateLadderRow is Label

+ index Size
+ is-selected = false

• This
    color = silver
    background-color = black

    when #is-selected
        color = white
        background-color = teal

────────────────────
+ This
    - index

text = "indexed-$index"

━━━━━━━━━━━━━━━━━━━━
+ SelectionPredicateIndex is Tuple

+ value Size

━━━━━━━━━━━━━━━━━━━━
_ make-selection-predicate-indexes [SelectionPredicateIndex]
    - count Size

SelectionPredicateIndex(each) in 0 .. < count

━━━━━━━━━━━━━━━━━━━━
_ do record-selection-predicate-ladder
    - size Size
    - elapsed U64

if size == 100
    //markup.bench.selection-predicate.ladder-100-ns += elapsed
else if size == 1000
    //markup.bench.selection-predicate.ladder-1000-ns += elapsed
else if size == 5000
    //markup.bench.selection-predicate.ladder-5000-ns += elapsed
