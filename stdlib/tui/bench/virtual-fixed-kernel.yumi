/tui/virtual

_ virtual-kernel-count VirtualCoord = 1000000000vcoord
_ virtual-kernel-opening-scroll VirtualCoord = 4001vcoord
_ virtual-kernel-row-height VirtualCoord = 4vcoord
_ virtual-kernel-pool-high-water Size = 19

━━━━━━━━━━━━━━━━━━━━
+ VirtualKernelStats is Tuple

+ pool-created Size
+ pool-high-water Size
+ roots-created Size
+ window-refreshes Size
+ placements-emitted Size
+ layout-addresses-inspected Size
+ rebinds Size
+ source-binds Size
+ placement-buffer-grows Size
+ stale-commits Size

━━━━━━━━━━━━━━━━━━━━
+ do run-virtual-fixed-stable-window Size

. root = prepare-virtual-fixed-kernel()
run-virtual-fixed-stable-updates(root, 2)
. stats-before = virtual-kernel-stats(root.region)
. objects-before = C:yumiGCAllocatedObjectCount()
. bytes-before = C:yumiGCAllocatedByteCount()
run-virtual-fixed-stable-updates(root, 4096)

. allocated-objects = C:yumiGCAllocatedObjectCount() - objects-before
. allocated-bytes = C:yumiGCAllocatedByteCount() - bytes-before
. delta = virtual-stats-delta(stats-before, virtual-kernel-stats(root.region))
emit-virtual-kernel-stats(root, delta)
emit-virtual-kernel-high-water(root)
assert-no-growth(delta, allocated-objects as Size, allocated-bytes as Size, "stable-window")
?! Panic("virtual-fixed-stable-window rebound an unchanged placement window")
    if delta.source-binds != 0 || delta.rebinds != 0
?! Panic("virtual-fixed-stable-window produced unexpected refresh or placement counts")
    if delta.window-refreshes != 4096 || delta.placements-emitted != 53248

. checksum = virtual-kernel-checksum(delta, allocated-objects as Size, allocated-bytes as Size)
root.region.publish-bindings()
= checksum

━━━━━━━━━━━━━━━━━━━━
_ do run-virtual-fixed-stable-updates
    - root VirtualFixedKernelRoot
    - count Size

. step Size = 0
while step < count
    . y = if step % 2 == 0 then virtual-kernel-opening-scroll else next-scroll
        .. next-scroll = virtual-kernel-opening-scroll + 1vcoord
    root.region.refresh-bindings-at(0vcoord, y, 80vcoord, 24vcoord)
    step += 1

━━━━━━━━━━━━━━━━━━━━
+ do run-virtual-fixed-adjacent-scroll Size

. root = prepare-virtual-fixed-kernel()
run-virtual-fixed-adjacent-updates(root, virtual-kernel-opening-scroll, 19)
root.region.refresh-bindings-at(0vcoord, virtual-kernel-opening-scroll, 80vcoord, 24vcoord)
. stats-before = virtual-kernel-stats(root.region)
. objects-before = C:yumiGCAllocatedObjectCount()
. bytes-before = C:yumiGCAllocatedByteCount()
run-virtual-fixed-adjacent-updates(root, virtual-kernel-opening-scroll, 4096)

. allocated-objects = C:yumiGCAllocatedObjectCount() - objects-before
. allocated-bytes = C:yumiGCAllocatedByteCount() - bytes-before
. delta = virtual-stats-delta(stats-before, virtual-kernel-stats(root.region))
emit-virtual-kernel-stats(root, delta)
emit-virtual-kernel-high-water(root)
assert-no-growth(delta, allocated-objects as Size, allocated-bytes as Size, "adjacent-scroll")
?! Panic("virtual-fixed-adjacent-scroll did not rotate exactly one slot per row")
    if delta.source-binds != 4096 || delta.rebinds != 4096
?! Panic("virtual-fixed-adjacent-scroll changed the prewarmed pool high-water")
    if root.region.pool-size != virtual-kernel-pool-high-water

. checksum = virtual-kernel-checksum(delta, allocated-objects as Size, allocated-bytes as Size)
root.region.publish-bindings()
= checksum

━━━━━━━━━━━━━━━━━━━━
_ do run-virtual-fixed-adjacent-updates
    - root VirtualFixedKernelRoot
    - opening-scroll VirtualCoord
    - count Size

. step Size = 0
. scroll = opening-scroll
while step < count
    scroll += virtual-kernel-row-height
    root.region.refresh-bindings-at(0vcoord, scroll, 80vcoord, 24vcoord)
    step += 1

━━━━━━━━━━━━━━━━━━━━
+ do run-virtual-fixed-jump-ladder Size

. root = prepare-virtual-fixed-kernel()
run-virtual-fixed-jump-updates(root, 1)
root.region.refresh-bindings-at(0vcoord, 168001vcoord, 80vcoord, 24vcoord)
. stats-before = virtual-kernel-stats(root.region)
. objects-before = C:yumiGCAllocatedObjectCount()
. bytes-before = C:yumiGCAllocatedByteCount()
run-virtual-fixed-jump-updates(root, 256)

. allocated-objects = C:yumiGCAllocatedObjectCount() - objects-before
. allocated-bytes = C:yumiGCAllocatedByteCount() - bytes-before
. delta = virtual-stats-delta(stats-before, virtual-kernel-stats(root.region))
emit-virtual-kernel-stats(root, delta)
emit-virtual-kernel-high-water(root)
assert-no-growth(delta, allocated-objects as Size, allocated-bytes as Size, "jump-ladder")
?! Panic("virtual-fixed-jump-ladder refresh count was distance-dependent")
    if delta.window-refreshes != 1024
?! Panic("virtual-fixed-jump-ladder did not bind exactly one window per jump")
    if delta.source-binds != 13312 || delta.rebinds != 13312
?! Panic("virtual-fixed-jump-ladder emitted or inspected more than thirteen rows per jump")
    if delta.placements-emitted != 13312 || delta.layout-addresses-inspected != 13312

. checksum = virtual-kernel-checksum(delta, allocated-objects as Size, allocated-bytes as Size)
root.region.publish-bindings()
= checksum

━━━━━━━━━━━━━━━━━━━━
_ do run-virtual-fixed-jump-updates
    - root VirtualFixedKernelRoot
    - count Size

. cycle Size = 0
while cycle < count
    root.region.refresh-bindings-at(0vcoord, 4001vcoord, 80vcoord, 24vcoord)
    root.region.refresh-bindings-at(0vcoord, 4000001vcoord, 80vcoord, 24vcoord)
    root.region.refresh-bindings-at(0vcoord, 2000000001vcoord, 80vcoord, 24vcoord)
    root.region.refresh-bindings-at(0vcoord, 3999999921vcoord, 80vcoord, 24vcoord)
    cycle += 1

━━━━━━━━━━━━━━━━━━━━
+ do run-virtual-fixed-lifetime Size

. root = prepare-virtual-fixed-kernel()
. opening-revision = root.source.revision.value
bench-collect()
. opening-live-bytes = C:yumiGCLiveByteCount()
. checksum = run-virtual-fixed-lifetime-phases(root)

root.source.revision.value = opening-revision
root.region.virtual-scroll = VirtualPoint(0vcoord, virtual-kernel-opening-scroll)
root.region.arrange-bounds(Rect(0, 0, 80, 24))
root.region.update-layout()
bench-collect()
. final-live-bytes = C:yumiGCLiveByteCount()
?! Panic("virtual-fixed-lifetime live memory grew from $opening-live-bytes to $final-live-bytes")
    if !virtual-kernel-has-runtime-probes() && final-live-bytes > opening-live-bytes
?! Panic("virtual-fixed-lifetime exceeded the prewarmed pool capacity")
    if root.region.pool-size != virtual-kernel-pool-high-water

= (checksum + final-live-bytes) as Size

━━━━━━━━━━━━━━━━━━━━
_ do run-virtual-fixed-lifetime-phases Size
    - root VirtualFixedKernelRoot

run-virtual-fixed-resize-updates(root, 19)
root.region.refresh-bindings-at(0vcoord, virtual-kernel-opening-scroll, 80vcoord, 24vcoord)
. checksum Size

. resize-before = virtual-kernel-stats(root.region)
. resize-objects-before = C:yumiGCAllocatedObjectCount()
. resize-bytes-before = C:yumiGCAllocatedByteCount()
run-virtual-fixed-resize-updates(root, 256)
. resize-objects = C:yumiGCAllocatedObjectCount() - resize-objects-before
. resize-bytes = C:yumiGCAllocatedByteCount() - resize-bytes-before
. resize-delta = virtual-stats-delta(resize-before, virtual-kernel-stats(root.region))
emit-virtual-kernel-stats(root, resize-delta)
assert-no-growth(resize-delta, resize-objects as Size, resize-bytes as Size, "lifetime-resize")
checksum += virtual-kernel-checksum(resize-delta, resize-objects as Size, resize-bytes as Size)
root.region.publish-bindings()

run-virtual-fixed-revision-updates(root, 2)
. revision-before = virtual-kernel-stats(root.region)
. revision-objects-before = C:yumiGCAllocatedObjectCount()
. revision-bytes-before = C:yumiGCAllocatedByteCount()
run-virtual-fixed-revision-updates(root, 256)
. revision-objects = C:yumiGCAllocatedObjectCount() - revision-objects-before
. revision-bytes = C:yumiGCAllocatedByteCount() - revision-bytes-before
. revision-delta = virtual-stats-delta(revision-before, virtual-kernel-stats(root.region))
emit-virtual-kernel-stats(root, revision-delta)
assert-no-growth
    - revision-delta
    - revision-objects as Size
    - revision-bytes as Size
    - "lifetime-revision"
?! Panic("virtual-fixed-lifetime revision reset bound more than one active window")
    if revision-delta.source-binds > 256 * 13
checksum += virtual-kernel-checksum
    - revision-delta
    - revision-objects as Size
    - revision-bytes as Size
root.region.publish-bindings()

run-virtual-fixed-adjacent-updates(root, virtual-kernel-opening-scroll, 19)
root.region.refresh-bindings-at(0vcoord, virtual-kernel-opening-scroll, 80vcoord, 24vcoord)
. adjacent-before = virtual-kernel-stats(root.region)
. adjacent-objects-before = C:yumiGCAllocatedObjectCount()
. adjacent-bytes-before = C:yumiGCAllocatedByteCount()
run-virtual-fixed-adjacent-updates(root, virtual-kernel-opening-scroll, 65536)
. adjacent-objects = C:yumiGCAllocatedObjectCount() - adjacent-objects-before
. adjacent-bytes = C:yumiGCAllocatedByteCount() - adjacent-bytes-before
. adjacent-delta = virtual-stats-delta(adjacent-before, virtual-kernel-stats(root.region))
emit-virtual-kernel-stats(root, adjacent-delta)
assert-no-growth
    - adjacent-delta
    - adjacent-objects as Size
    - adjacent-bytes as Size
    - "lifetime-adjacent"
?! Panic("virtual-fixed-lifetime adjacent phase did not bind exactly one entering row")
    if adjacent-delta.source-binds != 65536 || adjacent-delta.rebinds != 65536
checksum += virtual-kernel-checksum
    - adjacent-delta
    - adjacent-objects as Size
    - adjacent-bytes as Size
root.region.publish-bindings()
emit-virtual-kernel-high-water(root)

= checksum

━━━━━━━━━━━━━━━━━━━━
_ do run-virtual-fixed-resize-updates
    - root VirtualFixedKernelRoot
    - count Size

. cycle Size = 0
while cycle < count
    root.region.refresh-bindings-at(0vcoord, virtual-kernel-opening-scroll, 80vcoord, 48vcoord)
    root.region.refresh-bindings-at(0vcoord, virtual-kernel-opening-scroll, 80vcoord, 24vcoord)
    cycle += 1

━━━━━━━━━━━━━━━━━━━━
_ do run-virtual-fixed-revision-updates
    - root VirtualFixedKernelRoot
    - count Size

. cycle Size = 0
while cycle < count
    root.source.bump-revision()
    root.region.refresh-bindings-at(0vcoord, virtual-kernel-opening-scroll, 80vcoord, 24vcoord)
    cycle += 1

━━━━━━━━━━━━━━━━━━━━
_ do prepare-virtual-fixed-kernel VirtualFixedKernelRoot

. root = VirtualFixedKernelRoot()
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.region.arrange-bounds(Rect(0, 0, 80, 24))
root.region.virtual-scroll = VirtualPoint(0vcoord, virtual-kernel-opening-scroll)
root.region.update-layout()
root.region.arrange-bounds(Rect(0, 0, 80, 48))
root.region.update-layout()
root.region.arrange-bounds(Rect(0, 0, 80, 24))
root.region.update-layout()
root.region.virtual-scroll = VirtualPoint(0vcoord, virtual-kernel-opening-scroll + 1vcoord)
root.region.update-layout()
root.region.virtual-scroll = VirtualPoint(0vcoord, virtual-kernel-opening-scroll)
root.region.update-layout()
?! Panic("virtual fixed kernel did not prewarm exactly nineteen physical slots")
    if root.region.pool-size != virtual-kernel-pool-high-water
= root

━━━━━━━━━━━━━━━━━━━━
