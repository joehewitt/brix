━━━━━━━━━━━━━━━━━━━━
+ AbsolutePosition is Position

╌╌╌╌╌╌╌╌╌╌ is Position ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ participates-in-layout
    - parent Box
    - child Box

participation(parent, child).contributes-to-measure

────────────────────
+ participation
    - parent Box
    - child Box

LayoutParticipation(false, false, true)

────────────────────
+ do arrange
    - parent Box
    - child Box

. content = child.anchor-bounds(parent)
. intrinsic = child.outer-intrinsic-size
. inline = absolute-axis(content.x, content.width, intrinsic.width, child.$left, child.$right)
. block = absolute-axis(content.y, content.height, intrinsic.height, child.$top, child.$bottom)
if child.$align-x
    inline = absolute-axis-align
        - content.x
        - content.width
        - intrinsic.width
        - child.$align-x!
        - child.$left
        - child.$right
if child.$align-y
    block = absolute-axis-align
        - content.y
        - content.height
        - intrinsic.height
        - child.$align-y!
        - child.$top
        - child.$bottom
child.arrange-outer-bounds(Rect(inline.start, block.start, inline.span, block.span))

━━━━━━━━━━━━━━━━━━━━
_ absolute-axis
    - start Coord
    - span Coord
    - intrinsic Coord
    - near PositionOffset?
    - far PositionOffset?

|? near-pin
    absolute-axis-pin(start, span, intrinsic, near-pin)
|? far-pin
    absolute-axis-pin(start, span, intrinsic, far-pin)
|? near && far && near-edge && far-edge
    PositionAxis(start + near-edge, max(0, (span - near-edge - far-edge)))
|? near && near-edge
    PositionAxis(start + near-edge, intrinsic)
|? far && far-edge
    PositionAxis(start + span - far-edge - intrinsic, intrinsic)
??
    PositionAxis(start, intrinsic)

.. near-pin = position-offset-pin(near)
.. far-pin = position-offset-pin(far)
.. near-edge = position-offset-edge(near)
.. far-edge = position-offset-edge(far)

━━━━━━━━━━━━━━━━━━━━
_ absolute-axis-pin
    - start Coord
    - span Coord
    - intrinsic Coord
    - pin PositionAxisPin

PositionAxis((start + round(pin.target * span) - round(pin.source * intrinsic)) as Coord, intrinsic)

━━━━━━━━━━━━━━━━━━━━
_ do absolute-axis-align
    - start Coord
    - span Coord
    - intrinsic Coord
    - align AnchorPoint
    - near PositionOffset?
    - far PositionOffset?

. target = start + round(anchor-point-ratio(align) * span)
. source = round(anchor-point-ratio(align) * intrinsic)
. offset Coord = 0
. near-edge = position-offset-edge(near)
. far-edge = position-offset-edge(far)
if near-edge
    offset = near-edge
else if far-edge
    offset = -far-edge

= PositionAxis((target + offset - source) as Coord, intrinsic)

━━━━━━━━━━━━━━━━━━━━
_ do position-offset-edge
    - offset PositionOffset?

=? if !offset

. edge Coord? = null
. ignored = match offset
    | PositionOffset.coord(n)
        edge = n
    | PositionOffset.percent(percent)
        edge = null
    | PositionOffset.anchor-start
        edge = null
    | PositionOffset.anchor-center
        edge = null
    | PositionOffset.anchor-end
        edge = null
    | PositionOffset.pin(pin)
        edge = null

= edge

━━━━━━━━━━━━━━━━━━━━
_ do position-offset-pin
    - offset PositionOffset?

=? if !offset

. pin-result PositionAxisPin? = null
. ignored = match offset
    | PositionOffset.coord(n)
        pin-result = null
    | PositionOffset.anchor-start
        pin-result = PositionAxisPin(0%%, 0%%)
    | PositionOffset.anchor-center
        pin-result = PositionAxisPin(0.5%%, 0.5%%)
    | PositionOffset.anchor-end
        pin-result = PositionAxisPin(1%%, 1%%)
    | PositionOffset.percent(percent)
        pin-result = PositionAxisPin(ratio, ratio)
        .. ratio = percent as Ratio
    | PositionOffset.pin(pin)
        pin-result = PositionAxisPin(anchor-point-ratio(pin.source), anchor-point-ratio(pin.target))

= pin-result

━━━━━━━━━━━━━━━━━━━━
_ anchor-point-ratio
    - point AnchorPoint

match point
    | AnchorPoint.start
        0%%
    | AnchorPoint.center
        0.5%%
    | AnchorPoint.end
        1%%
    ??
        0%%
