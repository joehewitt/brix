pop()

────────────────────
_ do print-single-width-text
    - text String
    - display-width Size

. min-x, min-y, max-x, max-y
    get-content-bounds((state.cursor-x, state.cursor-y, display-width as Coord, 1))

=? if min-y < 0
=? if min-y >= height
=? if max-x <= 0
=? if max-y <= min-y

`  //this:print -> min-y, text
. text-x = state.offset-x + state.cursor-x
. source-start = if text-x < min-x then min-x - text-x else 0

clear-display-run(min-x, min-y, max-x)

. text-ptr = get-pointer(text-buffer, min-x, min-y)
if text-ptr
    . row = text-ptr
    for i in 0 .. < max-x
        row[i] = text[source-start + i]

. fg-ptr = get-pointer(fg-buffer, min-x, min-y)
fg-ptr?[0 .. < max-x] = state.text-color

mark-coverage-run(min-x, min-y, max-x, layer-coverage-text)
if state.background
    paint-background-run(state.background, get-pointer(bg-buffer, min-x, min-y), max-x)
    mark-coverage-run(min-x, min-y, max-x, layer-coverage-background)

────────────────────
_ do is-same-cell
    - point Point
    - previous Canvas

=? if point.x >= previous.width
=? if point.y >= previous.height

. index = point.y * width + point.x
. previous-index = point.y * previous.width + point.x

=? if text-buffer[index] != previous.text-buffer[previous-index]
=? if display-width-buffer[index] != previous.display-width-buffer[previous-index]
=? if fg-buffer[index] != previous.fg-buffer[previous-index]

= bg-buffer[index] == previous.bg-buffer[previous-index]

────────────────────
_ do dump-row-span-to
    - out
    - y Coord
    - start Coord
    - end Coord
    - scratch Byte[]

write-row-position-to(out, y, start, scratch)
write-fg-to(out, default-text-color, scratch)
. current-fg = default-text-color
. current-bg = default-background
. run-start = start
. text-ptr = get-pointer(text-buffer, 0, y)!
. display-width-ptr = get-pointer(display-width-buffer, 0, y)!
. has-non-single-display-cells = row-non-single-display-counts[y] != 0
. fg-ptr = get-pointer(fg-buffer, 0, y)!
. bg-ptr = get-pointer(bg-buffer, 0, y)!

for x in start .. < end
    . cell-fg = fg-ptr[x]
    if cell-fg != current-fg
        write-char-run-to
            - out
            - text-ptr
            - display-width-ptr
            - run-start
            - x
            - has-non-single-display-cells
            - scratch
        run-start = x

        write-fg-to(out, cell-fg, scratch)
        current-fg = cell-fg

    . cell-bg = bg-ptr[x]
    if cell-bg != current-bg
        write-char-run-to
            - out
            - text-ptr
            - display-width-ptr
            - run-start
            - x
            - has-non-single-display-cells
            - scratch
        run-start = x

        write-bg-to(out, cell-bg, scratch)
        current-bg = cell-bg

write-char-run-to
    - out
    - text-ptr
    - display-width-ptr
    - run-start
    - end
    - has-non-single-display-cells
    - scratch

────────────────────
_ do write-row-position-to
    - out
    - y Coord
    - x Coord
    - scratch Byte[]

write-bytes-to(out, escape-reset-bytes)
write-bytes-to(out, escape-csi-bytes)
write-uint-to(out, (y + 1) as U32, scratch)
write-bytes-to(out, escape-semicolon-bytes)
write-uint-to(out, (x + 1) as U32, scratch)
write-bytes-to(out, escape-cursor-suffix-bytes)

────────────────────
_ do write-fg-to
    - out
    - color AnsiColor
    - scratch Byte[]

write-bytes-to(out, escape-fg-ansi-prefix-bytes)
write-uint-to(out, color, scratch)
write-bytes-to(out, escape-sgr-suffix-bytes)

────────────────────
_ do write-bg-to
    - out
    - color TerminalBackground
    - scratch Byte[]

if color == default-background
    write-bytes-to(out, escape-bg-default-bytes)
    =
if kind == terminal-background-ansi-tag
    write-bytes-to(out, escape-bg-ansi-prefix-bytes)
    write-uint-to(out, color /and/ 255, scratch)
    write-bytes-to(out, escape-sgr-suffix-bytes)
    =
write-bytes-to(out, escape-bg-rgb-prefix-bytes)
write-uint-to(out, r, scratch)
write-bytes-to(out, escape-semicolon-bytes)
write-uint-to(out, g, scratch)
write-bytes-to(out, escape-semicolon-bytes)
write-uint-to(out, b, scratch)
write-bytes-to(out, escape-sgr-suffix-bytes)

.. kind = terminal-background-kind(color)
.. r = (color /rshift/ 16) /and/ 255
.. g = (color /rshift/ 8) /and/ 255
.. b = color /and/ 255

────────────────────
_ do write-char-run-to
    - out
    - text-ptr
    - display-width-ptr
    - start Coord
    - end Coord
    - has-non-single-display-cells Bool
    - scratch Byte[]

if !has-non-single-display-cells
    for x in start .. < end
        write-char-to(out, text-ptr[x], scratch)
    =
for x in start .. < end
    if display-width-ptr[x] != 0
        write-char-to(out, text-ptr[x], scratch)

────────────────────
_ do display-text-run
    - text-ptr
    - display-width-ptr
    - start Coord
    - end Coord
    - has-non-single-display-cells Bool

if !has-non-single-display-cells
    = text-ptr.slice-string(start .. < end)

. result = ""
for x in start .. < end
    if display-width-ptr[x] != 0
        result += text-ptr[x]
= result

────────────────────
_ do clear-display-run
    - x Coord
    - y Coord
    - count Coord

. start = display-span-start(x, y)
. end = display-span-end(x + count, y)
=? if end <= start

. clear-count = end - start
. text-ptr = get-pointer(text-buffer, start, y)
. fg-ptr = get-pointer(fg-buffer, start, y)

text-ptr?[0 .. < clear-count] = ' '
fg-ptr?[0 .. < clear-count] = default-text-color

for i in 0 .. < clear-count
    set-display-width-cell(y * width + start + i, y, 1)

────────────────────
_ do paint-display-cell
    - char Char
    - x Coord
    - y Coord
    - display-width Coord

. index = y * width + x
text-buffer[index] = char
set-display-width-cell(index, y, display-width as U8)
fg-buffer[index] = state.text-color

. offset = 1
while offset < display-width
    . continuation = index + offset
    text-buffer[continuation] = ' '
    set-display-width-cell(continuation, y, 0)
    fg-buffer[continuation] = state.text-color
    offset += 1

mark-coverage-run(x, y, display-width, layer-coverage-text)

────────────────────
_ do set-display-width-cell
    - cell-index Index
    - y Coord
    - value U8

. old = display-width-buffer[cell-index]
=? if old == value

if old == 1 && value != 1
    row-non-single-display-counts[y] += 1
else if old != 1 && value == 1
    row-non-single-display-counts[y] -= 1

display-width-buffer[cell-index] = value

────────────────────
_ display-span-start
    - x Coord
    - y Coord

|? row-non-single-display-counts[y] == 0
    x
??
    display-run-start(x, y)

────────────────────
_ display-span-end
    - x Coord
    - y Coord

|? row-non-single-display-counts[y] == 0
    x
??
    display-run-end(x, y)

────────────────────
_ do display-run-start Coord
    - x Coord
    - y Coord

if width <= 0
    = 0

. start = x
if start >= width
    start = width - 1

while start > 0 && display-width-buffer[y * width + start] == 0
    start -= 1

= start

────────────────────
_ do display-run-end Coord
    - x Coord
    - y Coord

if width <= 0
    = 0

. end = min(x, width)
while end < width && display-width-buffer[y * width + end] == 0
    end += 1

= end

────────────────────
_ do write-char-to
    - out
    - char Char
    - scratch Byte[]

if code < 128
    scratch[0] = code as Byte
    out.write(scratch, 1)
    =
if code < 2048
    scratch[0] = (192 /or/ (code /rshift/ 6)) as Byte
    scratch[1] = utf8-continuation-byte(code)
    out.write(scratch, 2)
    =
if code < 65536
    scratch[0] = (224 /or/ (code /rshift/ 12)) as Byte
    scratch[1] = utf8-continuation-byte(code /rshift/ 6)
    scratch[2] = utf8-continuation-byte(code)
    out.write(scratch, 3)
    =
scratch[0] = (240 /or/ (code /rshift/ 18)) as Byte
scratch[1] = utf8-continuation-byte(code /rshift/ 12)
scratch[2] = utf8-continuation-byte(code /rshift/ 6)
scratch[3] = utf8-continuation-byte(code)
out.write(scratch, 4)

.. code = char as U32

────────────────────
_ utf8-continuation-byte Byte
    - code U32

(128 /or/ (code /and/ 63)) as Byte

────────────────────
_ do write-uint-to
    - out
    - value U32
    - scratch Byte[]

. cursor = scratch.size
. current = value
while 1
    cursor -= 1
    scratch[cursor] = (48 + (current % 10)) as Byte
    current = current / 10

    if current == 0
        break

. count = scratch.size - cursor
for i in 0 .. < count
    scratch[i] = scratch[cursor + i]

= out.write(scratch, count)

────────────────────
_ write-bytes-to
    - out
    - bytes Byte[]

out.write(bytes, bytes.size)

────────────────────
_ do mark-coverage-cell
    - x Coord
    - y Coord
    - mask U8

=? if !has-transparent-cells

. index = y * width + x
if index < coverage-buffer.size
    coverage-buffer[index] = coverage-buffer[index] /or/ mask

────────────────────
_ do mark-coverage-run
    - x Coord
    - y Coord
    - count Coord
    - mask U8

=? if !has-transparent-cells

. coverage-ptr = get-pointer(coverage-buffer, x, y)
=? if !coverage-ptr

. row = coverage-ptr
for i in 0 .. < count
    row[i] = row[i] /or/ mask

────────────────────
_ get-pointer
    - buf
    - x Coord
    - y Coord

|? increment < buf.size
    buf + increment

.. increment = row-offset + x
.. row-offset = y * width

────────────────────
_ get-content-bounds
    - content Rect

min-x, min-y, max-x, max-y

.. min-x-view, max-x-view =
    |? state.clip
        clip(state.clip.x, state.clip.right, 0, width)
    ??
        (0, width)
.. min-x, over-x = clip(left, right, min-x-view, max-x-view)
    .. left = state.offset-x + content.x
    .. right = left + content.width
.. max-x = over-x - min-x
.. min-y-view, max-y-view =
    |? state.clip
        clip(state.clip.y, state.clip.bottom, 0, height)
    ??
        (0, height)
.. min-y, max-y = clip(top, bottom, min-y-view, max-y-view)
    .. top = state.offset-y + content.y
    .. bottom = top + content.height

━━━━━━━━━━━━━━━━━━━━
+ BackgroundColor is Union

| ansi(color AnsiColor)
| rgba(color RGBA)
| hsva(color HSVA)

━━━━━━━━━━━━━━━━━━━━
_ State

+ text-color = default-text-color
+ background BackgroundColor?
+ cursor-x Coord
+ cursor-y Coord
+ offset-x Coord
+ offset-y Coord
+ clip Rect?
+ previous State?

────────────────────
+ do assign
    - other State

text-color = other.text-color
background = other.background
cursor-x = other.cursor-x
cursor-y = other.cursor-y
offset-x = other.offset-x
offset-y = other.offset-y
clip = other.clip

━━━━━━━━━━━━━━━━━━━━
+ clip
    - left-edge Coord
    - right-edge Coord
    - min-edge Coord
    - max-edge Coord

left, right

.. left = max(clipped-min-edge, min-edge)
    .. clipped-min-edge = min(left-edge, max-edge)
.. right = max(clipped-min-edge, min-edge)
    .. clipped-min-edge = min(right-edge, max-edge)
` .. left = min of clipped-min-edge and max-edge
`     .. clipped-min-edge = max of left-edge and min-edge
` .. right = min of clipped-min-edge and max-edge
`     .. clipped-min-edge = max of right-edge and min-edge

━━━━━━━━━━━━━━━━━━━━
_ escape-fg
    - color AnsiColor

"\x1b[38;5;${color}m"

━━━━━━━━━━━━━━━━━━━━
_ escape-bg
    - color TerminalBackground

|? color == default-background
    "\x1b[49m"
|? kind == terminal-background-ansi-tag
    "\x1b[48;5;${color /and/ 255}m"
??
    "\x1b[48;2;$r;$g;${b}m"

.. kind = terminal-background-kind(color)
.. r = (color /rshift/ 16) /and/ 255
.. g = (color /rshift/ 8) /and/ 255
.. b = color /and/ 255

━━━━━━━━━━━━━━━━━━━━
_ do paint-background-run
    - background BackgroundColor
    - bg-ptr
    - count Coord

=? if !bg-ptr

. row = bg-ptr
. ignored = match background
    | .ansi(color)
        paint-ansi-background-run(color, row, count)
    | .rgba(color)
        paint-rgba-background-run(color, row, count)
    | .hsva(color)
        paint-rgba-background-run(color, row, count)

━━━━━━━━━━━━━━━━━━━━
_ do paint-ansi-background-run I64
    - color AnsiColor
    - row
    - count Coord

row[0 .. < count] = terminal-background-ansi(color)
= 0

━━━━━━━━━━━━━━━━━━━━
_ do paint-rgba-background-run I64
    - color RGBA
    - row
    - count Coord

if color.alpha <= 0
    = 0

if color.alpha >= 1
    row[0 .. < count] = terminal-background-rgb(color)
    = 0

for x in 0 .. < count
    row[x] = terminal-background-rgb(blend-rgba(color, terminal-background-rgba(row[x])))

= 0

━━━━━━━━━━━━━━━━━━━━
_ do paint-background-cell-buffer I64
    - background BackgroundColor
    - cell

. ignored = match background
    | .ansi(color)
        cell[0] = terminal-background-ansi(color)
    | .rgba(color)
        paint-rgba-background-cell(color, cell)
    | .hsva(color)
        paint-rgba-background-cell(color, cell)

= 0

━━━━━━━━━━━━━━━━━━━━
_ do paint-rgba-background-cell I64
    - color RGBA
    - cell

if color.alpha <= 0
    = 0

if color.alpha >= 1
    cell[0] = terminal-background-rgb(color)
    = 0

cell[0] = terminal-background-rgb(blend-rgba(color, terminal-background-rgba(cell[0])))
= 0

━━━━━━━━━━━━━━━━━━━━
_ terminal-background-default TerminalBackground

0u32

━━━━━━━━━━━━━━━━━━━━
_ terminal-background-ansi TerminalBackground
    - color AnsiColor

terminal-background-ansi-tag /or/ (color as U32)

━━━━━━━━━━━━━━━━━━━━
_ terminal-background-rgb TerminalBackground
    - color RGBA

terminal-background-rgb-tag /or/ (r /lshift/ 16) /or/ (g /lshift/ 8) /or/ b

.. r = (color.red * 255) as U32
.. g = (color.green * 255) as U32
.. b = (color.blue * 255) as U32

━━━━━━━━━━━━━━━━━━━━
_ terminal-background-kind U32
    - color TerminalBackground

color /and/ terminal-background-kind-mask

━━━━━━━━━━━━━━━━━━━━
_ terminal-background-rgba RGBA
    - color TerminalBackground

|? kind == terminal-background-ansi-tag
    ansi-rgba((color /and/ 255) as AnsiColor)
|? kind == terminal-background-rgb-tag
    RGBA(r / 255.0, g / 255.0, b / 255.0)
??
    RGBA(0, 0, 0)

.. kind = terminal-background-kind(color)
.. r = ((color /rshift/ 16) /and/ 255) as Float
.. g = ((color /rshift/ 8) /and/ 255) as Float
.. b = (color /and/ 255) as Float

━━━━━━━━━━━━━━━━━━━━
_ blend-rgba RGBA
    - foreground RGBA
    - background RGBA

RGBA(red, green, blue)

.. alpha = foreground.alpha
.. inverse = 1 - alpha
.. red = foreground.red * alpha + background.red * inverse
.. green = foreground.green * alpha + background.green * inverse
.. blue = foreground.blue * alpha + background.blue * inverse

━━━━━━━━━━━━━━━━━━━━
_ blend-rgba-opacity RGBA
    - foreground RGBA
    - background RGBA
    - opacity Ratio

RGBA(red, green, blue)

.. alpha = foreground.alpha * opacity
.. inverse = 1 - alpha
.. red = foreground.red * alpha + background.red * inverse
.. green = foreground.green * alpha + background.green * inverse
.. blue = foreground.blue * alpha + background.blue * inverse

━━━━━━━━━━━━━━━━━━━━
_ blend-ansi-over-rgba
    - color AnsiColor
    - overlay RGBA
    - opacity Ratio

rgba-ansi(blend-rgba-opacity(overlay, ansi-rgba(color), opacity))

━━━━━━━━━━━━━━━━━━━━
_ blend-ansi-over-ansi
    - foreground AnsiColor
    - background AnsiColor
    - opacity Ratio

rgba-ansi(blend-rgba-opacity(ansi-rgba(foreground), ansi-rgba(background), opacity))

━━━━━━━━━━━━━━━━━━━━
_ clamped-opacity
    - opacity Ratio

|? opacity <= 0%%
    0%%
|? opacity >= 1%%
    1%%
??
    opacity

━━━━━━━━━━━━━━━━━━━━
_ ansi-rgba RGBA
    - color AnsiColor

|? code < 16
    RGBA(ansi-base-channel(code, 0), ansi-base-channel(code, 1), ansi-base-channel(code, 2))
|? code < 232
    RGBA()
        - ansi-cube-channel(red-index)
        - ansi-cube-channel(green-index)
        - ansi-cube-channel(blue-index)
??
    RGBA(level, level, level)

.. code Int = color
.. cube = code - 16
.. red-index = cube / 36
.. green-index = (cube / 6) % 6
.. blue-index = cube % 6
.. grey = 8 + (code - 232) * 10
.. level = grey / 255.0

━━━━━━━━━━━━━━━━━━━━
_ ansi-base-channel Float
    - color Int
    - channel Index

|? color == 7
    192 / 255.0
|? color == 8
    128 / 255.0
|? (base /and/ bit) == 0
    0
|? bright
    1
??
    128 / 255.0

.. bright = color >= 8
.. base = if bright then color - 8 else color
.. bit =
    |? channel == 0
        1
    |? channel == 1
        2
    ??
        4

━━━━━━━━━━━━━━━━━━━━
_ ansi-cube-channel
    - index Int

|? index == 0
    0
??
    (55 + index * 40) / 255.0

━━━━━━━━━━━━━━━━━━━━
_ rgba-ansi AnsiColor
    - color RGBA

|? abs(color.red - color.green) < 0.03 && abs(color.green - color.blue) < 0.03
    grayscale-ansi((color.red + color.green + color.blue) / 3.0)
??
    (16 + red * 36 + green * 6 + blue) as AnsiColor

.. red = ansi-cube-index(color.red)
.. green = ansi-cube-index(color.green)
.. blue = ansi-cube-index(color.blue)

━━━━━━━━━━━━━━━━━━━━
_ grayscale-ansi AnsiColor
    - level Float

|? level < 0.03
    16
??
    (232 + clipped) as AnsiColor

.. clipped = min(23, (max(0, raw)))
.. raw = round((level * 255.0 - 8.0) / 10.0) as Int

━━━━━━━━━━━━━━━━━━━━
_ ansi-cube-index Int
    - value Float

|? byte < 48.0
    0
??
    min(5, (max(1, raw)))

.. byte = value * 255.0
.. raw = round((byte - 55.0) / 40.0) as Int
