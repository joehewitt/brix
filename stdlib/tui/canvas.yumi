    =
. min-x, min-y, max-x, max-y
    get-content-bounds((state.cursor-x, state.cursor-y, text.display-width as Coord, 1))

=? if min-y < 0
=? if min-y >= height
=? if max-x <= 0
=? if max-y <= min-y

`  //this:print -> min-y, text
. text-x = state.offset-x + state.cursor-x
. end-x = min-x + max-x
. x = text-x
. char-index = 0

clear-display-run(min-x, min-y, max-x)
if state.background
    paint-background-run(state.background, get-pointer(bg-buffer, min-x, min-y), max-x)
    mark-coverage-run(min-x, min-y, max-x, layer-coverage-background)

for char in text.text
    . char-width = text.width-at(char-index) as Coord
    char-index += 1
    if char-width <= 0
        continue

    . next-x = x + char-width
    if next-x <= min-x
        x = next-x
        continue
    if x < min-x || next-x > end-x
        x = next-x
        continue

    paint-display-cell(char, x, min-y, char-width)
    x = next-x

────────────────────
+ do copy
    - source Canvas

copy(Rect(0, 0, width, height), source)

────────────────────
+ do copy
    - rect Rect
    - source Canvas

. right-limit = min(width, source.width)
. bottom-limit = min(height, source.height)
. min-x, max-x = clip(rect.x, rect.right, 0, right-limit)
. min-y, max-y = clip(rect.y, rect.bottom, 0, bottom-limit)

=? if max-x <= min-x
=? if max-y <= min-y

for y in min-y .. < max-y
    . count = max-x - min-x
    . source-index = y * source.width + min-x
    . target-index = y * width + min-x
    for x in 0 .. < count
        text-buffer[target-index + x] = source.text-buffer[source-index + x]
        set-display-width-cell(target-index + x, y, source.display-width-buffer[source-index + x])
        fg-buffer[target-index + x] = source.fg-buffer[source-index + x]
        bg-buffer[target-index + x] = source.bg-buffer[source-index + x]
        if has-transparent-cells
            coverage-buffer[target-index + x] =
                |? source.has-transparent-cells
                    source.coverage-buffer[source-index + x]
                ??
                    layer-coverage-all

────────────────────
+ do composite
    - source Canvas
    - rect Rect
    - point Point
    - opacity Ratio

. alpha = clamped-opacity(opacity)
=? if alpha <= 0%%

. left = max(rect.x, point.x)
. top = max(rect.y, point.y)
. right = min(rect.right, (point.x + source.width))
. bottom = min(rect.bottom, (point.y + source.height))
=? if right <= left || bottom <= top

. min-x, min-y, span-x, max-y
    get-content-bounds((left, top, right - left, bottom - top))

=? if span-x <= 0
=? if max-y <= min-y

. max-x = min-x + span-x
. origin-x = state.offset-x + point.x
. origin-y = state.offset-y + point.y
for y in min-y .. < max-y
    for x in min-x .. < max-x
        . source-x = x - origin-x
        . source-y = y - origin-y
        . source-index = source-y * source.width + source-x
        . target-index = y * width + x
        . coverage =
            |? source.has-transparent-cells
                source.coverage-buffer[source-index]
            ??
                layer-coverage-all

        if coverage == 0
            continue

        . paints-background = (coverage /and/ layer-coverage-background) != 0
        . paints-text = (coverage /and/ layer-coverage-text) != 0

        if paints-background
            . layer-background = terminal-background-rgba(source.bg-buffer[source-index])
            . target-background = terminal-background-rgba(bg-buffer[target-index])
            . blended-background = blend-rgba-opacity()
                - layer-background
                - target-background
                - alpha
            bg-buffer[target-index] = terminal-background-rgb(blended-background)
            if !paints-text
                fg-buffer[target-index] = blend-ansi-over-rgba()
                    - fg-buffer[target-index]
                    - layer-background
                    - alpha

        if paints-text
            text-buffer[target-index] = source.text-buffer[source-index]
            set-display-width-cell(target-index, y, source.display-width-buffer[source-index])
            fg-buffer[target-index] = blend-ansi-over-ansi()
                - source.fg-buffer[source-index]
                - fg-buffer[target-index]
                - alpha

────────────────────
+ do dump

. frame = ""

//+-tui.canvas// dump

for y in 0 .. < height
    . start = 0
    . current-fg = default-text-color
    . current-bg = default-background
    . text-ptr = get-pointer(text-buffer, 0, y)!
    . display-width-ptr = get-pointer(display-width-buffer, 0, y)!
    . has-non-single-display-cells = row-non-single-display-counts[y] != 0
    . fg-ptr = get-pointer(fg-buffer, 0, y)!
    . bg-ptr = get-pointer(bg-buffer, 0, y)!
    frame += "\x1b[0m\x1b[${y + 1};1H"
    frame += escape-fg(default-text-color)

    //+-tui.canvas// row $y
    for x in 0 .. < width
        . cell-fg = fg-ptr[x]
        if cell-fg != current-fg
            //tui.canvas.fg-run -> start, x, text-ptr[start .. < x]
            frame += display-text-run
                - text-ptr
                - display-width-ptr
                - start as Coord
                - x
                - has-non-single-display-cells
            start = x

            //tui.canvas.fg// cell-fg
            frame += escape-fg(cell-fg)
            current-fg = cell-fg

        . cell-bg = bg-ptr[x]
        if cell-bg != current-bg
            //tui.canvas.bg-run -> y, start, x, text-ptr[start .. < x]
            frame += display-text-run
                - text-ptr
                - display-width-ptr
                - start as Coord
                - x
                - has-non-single-display-cells
            start = x

            //tui.canvas.bg// cell-bg
            frame += escape-bg(cell-bg)
            current-bg = cell-bg

    . line = display-text-run
        - text-ptr
        - display-width-ptr
        - start as Coord
        - width
        - has-non-single-display-cells
    //tui.canvas.text -> y, line.length, start, width, text-ptr[start .. < width]
    frame += line

frame += "\x1b[0m"
= frame

────────────────────
+ dump
    - out

out <- dump()

