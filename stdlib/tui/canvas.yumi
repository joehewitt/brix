+ do fill
    - rect Rect

. min-x, min-y, max-x, max-y
    get-content-bounds((rect.x, rect.y, rect.width, rect.height))

=? if min-y < 0
=? if min-y > height
=? if max-x <= 0
=? if max-y <= min-y

=? if !state.background

. background = state.background
for y in min-y .. < max-y
    paint-background-run(background, get-pointer(bg-buffer, min-x, y), max-x)
    if !has-transparent-cells
        clear-display-run(min-x, y, max-x)
    mark-coverage-run(min-x, y, max-x, layer-coverage-background)

