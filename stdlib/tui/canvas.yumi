+ do dump-diff String
    - previous Canvas

. out = DataStream'Byte(4096)
out.reset()
dump-diff(out, previous)
= out.data.slice-string(0 .. < out.length)

────────────────────
+ do dump-diff
    - out
    - previous Canvas

. did-write = false
. scratch = Byte[16]

for y in 0 .. < height
    . changed-start = width
    . changed-end Coord = 0
    for x in 0 .. < width
        if !(is-same-cell((x, y), previous))
            if changed-start == width
                changed-start = x
            changed-end = width

    if changed-start < changed-end
        . start = display-span-start(changed-start, y)
        . end = display-span-end(changed-end, y)
        dump-row-span-to(out, y, start, end, scratch)
        did-write = true

if did-write
    write-bytes-to(out, escape-reset-bytes)

