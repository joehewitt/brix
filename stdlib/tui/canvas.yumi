    coverage-buffer[0 ...] = 0

────────────────────
+ do push

. previous = state
. next = spare-state ?? State()
spare-state = next.previous
next.assign(previous)
next.previous = previous
state = next

────────────────────
+ do pop

. popped = state
state = popped.previous!
popped.previous = spare-state
spare-state = popped

