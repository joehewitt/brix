do use this
    background = value
    fill(rect)

────────────────────
+ do paint-background-cell
    - value BackgroundColor
    - point Point

. x = state.offset-x + point.x
. y = state.offset-y + point.y

=? if x < 0
=? if x >= width
=? if y < 0
=? if y >= height

if state.clip
    . clip = state.clip
    =? if x < clip.x
    =? if x >= clip.right
    =? if y < clip.y
    =? if y >= clip.bottom

. cell = get-pointer(bg-buffer, x, y)
if cell
    paint-background-cell-buffer(value, cell)
    mark-coverage-cell(x, y, layer-coverage-background)

