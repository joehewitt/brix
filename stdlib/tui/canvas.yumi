
/math
/units
/graphics/color
/data/stream
./colors
./primitives

_ default-text-color = white
_ default-background = terminal-background-default()
_ terminal-background-ansi-tag U32 = 1u32 /lshift/ 24
_ terminal-background-rgb-tag U32 = 2u32 /lshift/ 24
_ terminal-background-kind-mask U32 = 255u32 /lshift/ 24
_ layer-coverage-background U8 = 1
_ layer-coverage-text U8 = 2
_ layer-coverage-all U8 = 3
_ escape-reset-bytes = "\x1b[0m" as Byte[]
_ escape-csi-bytes = "\x1b[" as Byte[]
_ escape-fg-ansi-prefix-bytes = "\x1b[38;5;" as Byte[]
_ escape-bg-default-bytes = "\x1b[49m" as Byte[]
_ escape-bg-ansi-prefix-bytes = "\x1b[48;5;" as Byte[]
_ escape-bg-rgb-prefix-bytes = "\x1b[48;2;" as Byte[]
_ escape-semicolon-bytes = ";" as Byte[]
_ escape-cursor-suffix-bytes = "H" as Byte[]
_ escape-sgr-suffix-bytes = "m" as Byte[]

+ TerminalBackground is U32

━━━━━━━━━━━━━━━━━━━━
+ Canvas

_ state = State()
_ spare-state State?
_ text-buffer = Char[0]
_ display-width-buffer = U8[0]
_ row-non-single-display-counts = Size[0]
_ fg-buffer = AnsiColor[0]
_ bg-buffer = TerminalBackground[0]
_ coverage-buffer = U8[0]
_ has-transparent-cells = false
+ width Coord = 0
+ height Coord = 0

────────────────────
+ This
    - size PSize
    - is-transparent = false

. length = size.width * size.height

width = size.width
height = size.height
has-transparent-cells = is-transparent

`  //this:create -> width, height
text-buffer = Char[length]
text-buffer[0 ...] = ' '

display-width-buffer = U8[length]
display-width-buffer[0 ...] = 1

row-non-single-display-counts = Size[height]
row-non-single-display-counts[0 ...] = 0

fg-buffer = AnsiColor[length]
fg-buffer[0 ...] = default-text-color

bg-buffer = TerminalBackground[length]
bg-buffer[0 ...] = default-background

if has-transparent-cells
    coverage-buffer = U8[length]
    coverage-buffer[0 ...] = 0

