state.offset-x += offset.x
state.offset-y += offset.y

────────────────────
+ do is-rect-visible Bool
    - rect Rect

=? false
    if rect.width <= 0 || rect.height <= 0
. left = max(0, state.offset-x + rect.x)
. top = max(0, state.offset-y + rect.y)
. right = min(width, state.offset-x + rect.right)
. bottom = min(height, state.offset-y + rect.bottom)
if state.clip
    . clip = state.clip
    left = max(left, clip.x)
    top = max(top, clip.y)
    right = min(right, clip.right)
    bottom = min(bottom, clip.bottom)
= left < right && top < bottom

────────────────────
+ do clip
    - bounds Rect

. next = Rect(state.offset-x + bounds.x, state.offset-y + bounds.y, bounds.width, bounds.height)
if state.clip
    . current = state.clip
    . left = max(current.x, next.x)
    . top = max(current.y, next.y)
    . right = max(left, (min(current.right, next.right)))
    . bottom = max(top, (min(current.bottom, next.bottom)))
    state.clip = Rect(left, top, right - left, bottom - top)
else
    state.clip = next

