(import ./box)
(import ./canvas)
(import ./primitives)
(import /core/markup)

(type + Screen (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + frame String
    (param width Coord)
    (param height Coord)
    (call (. markup-batch-queue checkpoint))
    (call arrange-bounds (call Rect 0 0 width height))
    (call update-layout)
    (let canvas (call Canvas (call PSize width height)))
    (call paint canvas)
    (return (call (. canvas dump-lines)))
  )
)
