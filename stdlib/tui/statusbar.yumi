
./box
./colors
./primitives
./shortcuts
./styles
./text
./theme
./window
/core/markup

━━━━━━━━━━━━━━━━━━━━
• extend TUIDefaultTheme
    using BoxPaint
    using TextPaint

• StatusBar
    background-color = AnsiColor(8)
    color = AnsiColor(255)

━━━━━━━━━━━━━━━━━━━━
+ StatusBar is Label

+ message = ""
+ text = status-bar-text(#message, #window?.#shortcuts ?? List'Shortcut())

_ window Ancestor'Window

━━━━━━━━━━━━━━━━━━━━
_ status-bar-text
    - message String
    - shortcuts [Shortcut] = List'Shortcut()

|? message && shortcuts
    " $message | $shortcut-text"
|? message
    " $message "
??
    " $shortcut-text"

.. shortcut-text
    ** shortcuts
    ?> each.show-in-status
    *> each.status-label
    |> " • ".join
