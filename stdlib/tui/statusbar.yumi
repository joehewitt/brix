━━━━━━━━━━━━━━━━━━━━
• extend TUIDefaultTheme
    using BoxPaint
    using TextPaint

• StatusBar
    background-color = AnsiColor(8)
    color = AnsiColor(255)

━━━━━━━━━━━━━━━━━━━━
+ StatusBar is Label

+ message = ""
+ text = status-bar-text(#message, #window?.#shortcuts ?? List'Shortcut())

_ window Ancestor'Window

━━━━━━━━━━━━━━━━━━━━
_ status-bar-text
    - message String
    - shortcuts [Shortcut] = List'Shortcut()

|? message && shortcuts
    " $message | $shortcut-text"
|? message
    " $message "
??
    " $shortcut-text"

.. shortcut-text = " • ".join(status-bar-labels(shortcuts))

━━━━━━━━━━━━━━━━━━━━
_ do status-bar-labels [String]
    - shortcuts [Shortcut]

. labels [String]
for shortcut in shortcuts
    if shortcut.show-in-status && !shortcut.key-scope
        labels += shortcut.status-label
for shortcut in shortcuts
    if shortcut.show-in-status && shortcut.key-scope
        labels += shortcut.status-label
= labels
