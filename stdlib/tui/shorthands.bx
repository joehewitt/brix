(import ./border)
(import ./canvas)
(import ./layout)
(import ./position)
(import ./primitives)
(import ./styles)
(import /units)

(style TUIShorthandsTheme
  (using BoxPaint)
  (using TextPaint)
  (using BoxPlacement)
  (using BoxSpacing)
  (using BoxSize)
  (using BoxBorder)
  (using BoxLayout)
  (using BoxMasonry)
  (rule flex-col
    (= layout flex-col)
  )
  (blank)
  (rule flex-row
    (= layout flex-row)
  )
  (blank)
  (rule flow-col
    (= layout flow-col)
  )
  (blank)
  (rule flow-row
    (= layout flow-row)
  )
  (blank)
  (rule masonry-col
    (= layout masonry-col)
  )
  (blank)
  (rule masonry-row
    (= layout masonry-row)
  )
  (blank)
  (rule masonry-cols
    (param count Int)
    (= masonry-column-count count)
  )
  (blank)
  (rule masonry-rows
    (param count Int)
    (= masonry-row-count count)
  )
  (blank)
  (rule masonry-min-col
    (param w Coord)
    (= masonry-min-column-width w)
  )
  (blank)
  (rule masonry-min-row
    (param h Coord)
    (= masonry-min-row-height h)
  )
  (blank)
  (rule masonry-col-gap
    (param value Coord)
    (= masonry-column-gap value)
  )
  (blank)
  (rule masonry-row-gap
    (param value Coord)
    (= masonry-row-gap value)
  )
  (blank)
  (rule flex
    (param amount Int)
    (= flex (as amount Flex))
  )
  (blank)
  (rule absolute
    (= position (call AbsolutePosition))
  )
  (blank)
  (rule bg
    (param value (? BackgroundColor))
    (= background-color value)
  )
  (blank)
  (rule text
    (param c AnsiColor)
    (= color c)
  )
  (blank)
  (rule m
    (param value Coord)
    (= margin-top value)
    (= margin-right value)
    (= margin-bottom value)
    (= margin-left value)
  )
  (blank)
  (rule mx
    (param value Coord)
    (= margin-left value)
    (= margin-right value)
  )
  (blank)
  (rule my
    (param value Coord)
    (= margin-top value)
    (= margin-bottom value)
  )
  (blank)
  (rule mt
    (param value Coord)
    (= margin-top value)
  )
  (blank)
  (rule mr
    (param value Coord)
    (= margin-right value)
  )
  (blank)
  (rule mb
    (param value Coord)
    (= margin-bottom value)
  )
  (blank)
  (rule ml
    (param value Coord)
    (= margin-left value)
  )
  (blank)
  (rule p
    (param value Coord)
    (= padding-top value)
    (= padding-right value)
    (= padding-bottom value)
    (= padding-left value)
  )
  (blank)
  (rule px
    (param value Coord)
    (= padding-left value)
    (= padding-right value)
  )
  (blank)
  (rule py
    (param value Coord)
    (= padding-top value)
    (= padding-bottom value)
  )
  (blank)
  (rule pt
    (param value Coord)
    (= padding-top value)
  )
  (blank)
  (rule pr
    (param value Coord)
    (= padding-right value)
  )
  (blank)
  (rule pb
    (param value Coord)
    (= padding-bottom value)
  )
  (blank)
  (rule pl
    (param value Coord)
    (= padding-left value)
  )
  (blank)
  (rule border
    (= border-style (. BorderStyle single))
  )
  (blank)
  (rule border
    (param value AnsiColor)
    (= border-color value)
  )
  (blank)
  (rule border
    (param value BorderPainter)
    (= border value)
  )
  (blank)
  (rule border-solid
    (= border-style (. BorderStyle single))
  )
  (blank)
  (rule border-none
    (= border-style (. BorderStyle none))
  )
  (blank)
  (rule border-rounded
    (= border-style (. BorderStyle rounded))
  )
  (blank)
  (rule border-double
    (= border-style (. BorderStyle double))
  )
  (blank)
  (rule border-heavy
    (= border-style (. BorderStyle heavy))
  )
  (blank)
  (rule border-dashed
    (= border-style (. BorderStyle dashed))
  )
  (blank)
  (rule w
    (param size Size)
    (= min-width (as size SizeSpec))
    (= max-width (as size SizeSpec))
  )
  (blank)
  (rule h
    (param size Size)
    (= min-height (as size SizeSpec))
    (= max-height (as size SizeSpec))
  )
  (blank)
  (rule center
    (param anchor Anchor (= .screen))
    (= anchor anchor)
    (= left .anchor-center)
    (= top .anchor-center)
  )
  (blank)
  (rule cover
    (param anchor Anchor (= .screen))
    (= anchor anchor)
    (= left 0)
    (= top 0)
    (= right 0)
    (= bottom 0)
  )
  (blank)
  (rule inset
    (param value PositionOffset)
    (= left value)
    (= top value)
    (= right value)
    (= bottom value)
  )
  (blank)
  (rule inset
    (param pos (tuple (: x PositionOffset) (: y PositionOffset)))
    (= left (. pos x))
    (= top (. pos y))
    (= right (. pos x))
    (= bottom (. pos y))
  )
)
