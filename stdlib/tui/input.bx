(import /os/file)
(import /time/deadline)
(import /time/duration)
(blank)
(prop + terminal-escape-delay _ (= 50ms))
(blank)
(prop _ escape-byte Byte (= 27))

(type + TerminalInput
  (implements ByteReadable)
  (implements (of Decodable Char))
  (prop + source File)
  (prop + escape-delay _ (= terminal-escape-delay))
  (blank)
  (prop _ is-escape-open _ (= false))
  (prop _ replay _ (= ([] Byte 0)))
  (prop _ replay-offset Size)
  (fn-do + This _
    (param source File)
  )
  (fn-do + read Size (?! Error)
    (param size Size)
    (param buffer ([] Byte))
    (if is-escape-open
      (= is-escape-open false)
      (if (not (call is-readable-within escape-delay))
        (= replay (call (of Array Byte) "[27u"))
        (= replay-offset 0)
      )
    )
    (if (< replay-offset (. replay size))
      (let left (- (. replay size) replay-offset))
      (let count (if-expr (< size left) size left))
      (= ([] buffer (..< 0 count)) ([] replay (..< replay-offset (+ replay-offset count))))
      (+= replay-offset count)
      (return count)
    )
    (let count (call (. source read) size buffer))
    (= is-escape-open (and (> count 0) (== ([] buffer (- count 1)) escape-byte)))
    (return count)
  )
  (fn-do _ is-readable-within Bool
    (param delay Nanoseconds)
    (let waited (catch (call wait-until-readable (. source fd) (call Deadline delay))))
    (return (not (is waited TimeoutError)))
  )
)
