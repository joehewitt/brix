(fn-do + tui-box-measurement-protocol-tests TestCase
  (param t TestCase)
  (<> TuiStyleDemo (id: demo) (• flow-col) (• p 1)
    (<> TextBox (id: padded) (text: "abc") (• m 1) (• p 1))
    (<> TextBox (id: invisible) (text: "zz")
      (= display (. Display invisible))
    )
    (<> TextBox (id: hidden) (text: "hidden")
      (= display (. Display hidden))
    )
  )
  (blank)
  (call (. demo markup-batch-queue checkpoint))
  (blank)
  (let measure (call (. demo measure)))
  (= t (call (. t expect) "flow measure content width uses child outer width" 7 (. measure content-size width)))
  (= t (call (. t expect) "flow measure content height skips hidden" 6 (. measure content-size height)))
  (blank)
  (return t)
)

