(import /core/markup)
(import /test)
(import /tui)
(import /tui/text)
(import /units)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "TUI Structural Content Invalidation"))
  (call (. cases run) tui-structural-content-invalidation-tests)
  (= cases (call (. cases then) "TUI Transparent Markup Regions" tui-transparent-markup-region-tests))
  (= cases (call (. cases then) "TUI Flex Inner Size" tui-flex-inner-size-tests))
  (= cases (call (. cases then) "TUI Masonry Layout" tui-masonry-layout-tests))
  (= cases (call (. cases then) "TUI Flex Spacing Layout" tui-flex-spacing-layout-tests))
  (= cases (call (. cases then) "TUI Flow Spacing Layout" tui-flow-spacing-layout-tests))
  (= cases (call (. cases then) "TUI Box Measurement Protocol" tui-box-measurement-protocol-tests))
  (= cases (call (. cases then) "TUI Rich Text Measurement" tui-rich-text-measurement-tests))
  (= cases (call (. cases then) "TUI Absolute Position Layout" tui-absolute-position-layout-tests))
  (= cases (call (. cases then) "TUI Absolute Anchor Layout" tui-absolute-anchor-layout-tests))
  (= cases (call (. cases then) "TUI Dynamic Absolute Size Frames" tui-dynamic-absolute-size-frame-tests))
  (= cases (call (. cases then) "TUI Style Target Generated Content" tui-style-target-generated-content-tests))
  (= cases (call (. cases then) "TUI Hit Test Paint Order" tui-hit-test-paint-order-tests))
  (return cases)
)

(fn-do + tui-structural-content-invalidation-tests TestCase
  (param t TestCase)
  (<> TuiStyleDemo (id: demo) (• flow-col)
    (<> Box (id: host) (• flow-col)
      (<> TextBox (id: first) (text: "a"))
    )
    (<> TextBox (id: after) (text: "z"))
  )
  (blank)
  (call (. demo markup-batch-queue checkpoint))
  (= (. demo bounds) (call Rect 0 0 10 10))
  (call (. demo update-layout))
  (blank)
  (let added (call TextBox "b"))
  (call markup-append host added)
  (call (. demo markup-batch-queue checkpoint))
  (call (. demo update-layout))
  (blank)
  (= t (call (. t expect) "structural append updates host inner height" 2 (. host inner-height)))
  (= t (call (. t expect) "structural append updates parent inner height" 3 (. demo inner-height)))
  (= t (call expect-bounds t "structural append after" after 0 2 10 1))
  (blank)
  (return t)
)

(fn-do + tui-transparent-markup-region-tests TestCase
  (param t TestCase)
  (<> TuiTransparentRegionDemo (id: demo) (• flex-row))
  (blank)
  (call markup-mount-root demo demo)
  (call (. demo markup-batch-queue checkpoint))
  (= (. demo bounds) (call Rect 0 0 40 4))
  (call (. demo invalidate-layout))
  (call (. demo update-layout))
  (blank)
  (let region (!! (. demo %first-child)))
  (let first (!! (. region %first-child)))
  (let second (call (. region child-at) 1))
  (let branch (!! (. region %next-sibling)))
  (let preview (!! (. branch %first-child)))
  (blank)
  (= t (call expect-bounds t "transparent loop first" first 0 0 10 4))
  (= t (call expect-bounds t "transparent loop second" (!! second) 10 0 10 4))
  (= t (call expect-bounds t "transparent branch preview" preview 20 0 20 4))
  (blank)
  (call (. demo insert-item))
  (call (. demo markup-batch-queue checkpoint))
  (call (. demo update-layout))
  (blank)
  (let inserted (call (. region child-at) 1))
  (let shifted (call (. region child-at) 2))
  (= t (call expect-bounds t "transparent loop inserted" (!! inserted) 8 0 8 4))
  (= t (call expect-bounds t "transparent loop shifted" (!! shifted) 16 0 8 4))
  (= t (call expect-bounds t "transparent branch after insert" preview 24 0 16 4))
  (= t (call (. t check) "transparent region hit test" (== (call (. demo hit-test) (tuple 9 1)) (!! inserted))))
  (blank)
  (return t)
)

(fn-do + tui-flex-inner-size-tests TestCase
  (param t TestCase)
  (let overflow (call FlexInnerTestHost (. Orientation horizontal)))
  (call markup-mount-root overflow overflow)
  (call markup-append overflow (call FixedTextBox "a" 28))
  (call markup-append overflow (call FixedTextBox "b" 28))
  (call markup-append overflow (call FixedTextBox "c" 28))
  (call (. overflow markup-batch-queue checkpoint))
  (= (. overflow bounds) (call Rect 0 0 60 10))
  (call (. overflow update-layout))
  (blank)
  (= t (call (. t expect) "horizontal overflow inner width" 84 (. overflow inner-width)))
  (blank)
  (let underflow (call FlexInnerTestHost (. Orientation horizontal)))
  (call markup-mount-root underflow underflow)
  (call markup-append underflow (call FixedTextBox "a" 20))
  (call markup-append underflow (call FixedTextBox "b" 20))
  (call (. underflow markup-batch-queue checkpoint))
  (= (. underflow bounds) (call Rect 0 0 60 10))
  (call (. underflow update-layout))
  (blank)
  (= t (call (. t expect) "horizontal underflow inner width" 40 (. underflow inner-width)))
  (blank)
  (let mixed (call FlexInnerTestHost (. Orientation horizontal)))
  (call markup-mount-root mixed mixed)
  (let mixed-fixed (call FixedTextBox "a" 10))
  (<> Box (id: mixed-flex) (• flex 1))
  (let mixed-trailing (call FixedTextBox "z" 10))
  (call markup-append mixed mixed-fixed)
  (call markup-append mixed mixed-flex)
  (call markup-append mixed mixed-trailing)
  (call (. mixed markup-batch-queue checkpoint))
  (= (. mixed bounds) (call Rect 0 0 60 10))
  (call (. mixed update-layout))
  (blank)
  (= t (call expect-bounds t "mixed fixed" mixed-fixed 0 0 10 10))
  (= t (call expect-bounds t "mixed flex" mixed-flex 10 0 40 10))
  (= t (call expect-bounds t "mixed trailing" mixed-trailing 50 0 10 10))
  (= t (call (. t expect) "mixed inner width" 60 (. mixed inner-width)))
  (blank)
  (let filtered (call FlexInnerTestHost (. Orientation horizontal)))
  (call markup-mount-root filtered filtered)
  (call markup-append filtered (call FixedTextBox "v" 12))
  (call markup-append filtered (call HiddenFixedTextBox "hidden" 30))
  (call markup-append filtered (call AbsoluteFixedTextBox "absolute" 30))
  (call (. filtered markup-batch-queue checkpoint))
  (= (. filtered bounds) (call Rect 0 0 60 10))
  (call (. filtered update-layout))
  (blank)
  (= t (call (. t expect) "filtered inner width ignores inactive children" 12 (. filtered inner-width)))
  (blank)
  (let rounded (call FlexInnerTestHost (. Orientation horizontal)))
  (call markup-mount-root rounded rounded)
  (<> Box (id: rounded-a) (• flex 1))
  (<> Box (id: rounded-b) (• flex 1))
  (<> Box (id: rounded-c) (• flex 1))
  (let rounded-tail (call FixedTextBox "z" 1))
  (call markup-append rounded rounded-a)
  (call markup-append rounded rounded-b)
  (call markup-append rounded rounded-c)
  (call markup-append rounded rounded-tail)
  (call (. rounded markup-batch-queue checkpoint))
  (= (. rounded bounds) (call Rect 0 0 11 4))
  (call (. rounded update-layout))
  (blank)
  (= t (call expect-bounds t "rounded first flex" rounded-a 0 0 3 4))
  (= t (call expect-bounds t "rounded second flex" rounded-b 3 0 3 4))
  (= t (call expect-bounds t "rounded remainder flex" rounded-c 6 0 4 4))
  (= t (call expect-bounds t "rounded trailing fixed" rounded-tail 10 0 1 4))
  (blank)
  (return t)
)

(fn-do + tui-masonry-layout-tests TestCase
  (param t TestCase)
  (<> TuiStyleDemo (id: vertical) (• masonry-col) (• masonry-cols 2)
    (<> MasonryFixedBox (id: va)
      (= fixed-width 3)
      (= fixed-height 3)
    )
    (<> MasonryFixedBox (id: vb)
      (= fixed-width 3)
      (= fixed-height 2)
    )
    (<> MasonryFixedBox (id: vc)
      (= fixed-width 3)
      (= fixed-height 2)
    )
    (<> MasonryFixedBox (id: vd)
      (= fixed-width 3)
      (= fixed-height 1)
    )
  )
  (blank)
  (call (. vertical markup-batch-queue checkpoint))
  (= (. vertical bounds) (call Rect 0 0 10 10))
  (call (. vertical update-layout))
  (blank)
  (= t (call expect-bounds t "masonry vertical a" va 0 0 5 3))
  (= t (call expect-bounds t "masonry vertical b" vb 5 0 5 2))
  (= t (call expect-bounds t "masonry vertical c" vc 5 2 5 2))
  (= t (call expect-bounds t "masonry vertical d" vd 0 3 5 1))
  (= t (call (. t expect) "masonry vertical inner width" 10 (. vertical inner-width)))
  (= t (call (. t expect) "masonry vertical inner height" 4 (. vertical inner-height)))
  (blank)
  (<> TuiStyleDemo (id: horizontal) (• masonry-row) (• masonry-rows 2)
    (<> MasonryFixedBox (id: ha)
      (= fixed-width 4)
      (= fixed-height 1)
    )
    (<> MasonryFixedBox (id: hb)
      (= fixed-width 2)
      (= fixed-height 1)
    )
    (<> MasonryFixedBox (id: hc)
      (= fixed-width 3)
      (= fixed-height 1)
    )
    (<> MasonryFixedBox (id: hd)
      (= fixed-width 1)
      (= fixed-height 1)
    )
  )
  (blank)
  (call (. horizontal markup-batch-queue checkpoint))
  (= (. horizontal bounds) (call Rect 0 0 12 5))
  (call (. horizontal update-layout))
  (blank)
  (= t (call expect-bounds t "masonry horizontal a" ha 0 0 4 3))
  (= t (call expect-bounds t "masonry horizontal b" hb 0 3 2 2))
  (= t (call expect-bounds t "masonry horizontal c" hc 2 3 3 2))
  (= t (call expect-bounds t "masonry horizontal d" hd 4 0 1 3))
  (= t (call (. t expect) "masonry horizontal inner width" 5 (. horizontal inner-width)))
  (= t (call (. t expect) "masonry horizontal inner height" 5 (. horizontal inner-height)))
  (blank)
  (<> TuiStyleDemo (id: auto-count) (• masonry-col) (• masonry-min-col 5)
    (<> MasonryFixedBox (id: auto-a)
      (= fixed-width 1)
      (= fixed-height 1)
    )
    (<> MasonryFixedBox (id: auto-b)
      (= fixed-width 1)
      (= fixed-height 1)
    )
    (<> MasonryFixedBox (id: auto-c)
      (= fixed-width 1)
      (= fixed-height 1)
    )
  )
  (blank)
  (call (. auto-count markup-batch-queue checkpoint))
  (= (. auto-count bounds) (call Rect 0 0 11 10))
  (call (. auto-count update-layout))
  (= t (call expect-bounds t "masonry auto first resize a" auto-a 0 0 6 1))
  (= t (call expect-bounds t "masonry auto first resize b" auto-b 6 0 5 1))
  (= t (call expect-bounds t "masonry auto first resize c" auto-c 0 1 6 1))
  (blank)
  (call (. auto-count arrange-bounds) (call Rect 0 0 16 10))
  (call (. auto-count update-layout))
  (= t (call expect-bounds t "masonry auto second resize a" auto-a 0 0 6 1))
  (= t (call expect-bounds t "masonry auto second resize b" auto-b 6 0 5 1))
  (= t (call expect-bounds t "masonry auto second resize c" auto-c 11 0 5 1))
  (blank)
  (<> TuiStyleDemo (id: gaps) (• masonry-col) (• masonry-cols 2) (• masonry-col-gap 1) (• masonry-row-gap 1)
    (<> MasonryFixedBox (id: ga)
      (= fixed-width 1)
      (= fixed-height 3)
    )
    (<> MasonryFixedBox (id: gb)
      (= fixed-width 1)
      (= fixed-height 1)
    )
    (<> MasonryFixedBox (id: gc)
      (= fixed-width 1)
      (= fixed-height 1)
    )
  )
  (blank)
  (call (. gaps markup-batch-queue checkpoint))
  (= (. gaps bounds) (call Rect 0 0 9 10))
  (call (. gaps update-layout))
  (blank)
  (= t (call expect-bounds t "masonry gap a" ga 0 0 4 3))
  (= t (call expect-bounds t "masonry gap b" gb 5 0 4 1))
  (= t (call expect-bounds t "masonry gap c" gc 5 2 4 1))
  (= t (call (. t expect) "masonry gap inner height" 3 (. gaps inner-height)))
  (blank)
  (<> TuiStyleDemo (id: rich-demo) (• masonry-col) (• masonry-cols 1)
    (<> MarkdownText (id: masonry-rich) (text: "one two three four"))
    (<> TextBox (id: masonry-after) (text: "after"))
  )
  (blank)
  (call (. rich-demo markup-batch-queue checkpoint))
  (= (. rich-demo bounds) (call Rect 0 0 5 10))
  (call (. rich-demo update-layout))
  (blank)
  (= t (call (. t expect) "masonry rich text contributes wrapped height" 5 (. rich-demo inner-height)))
  (= t (call expect-bounds t "masonry rich following child" masonry-after 0 4 5 1))
  (blank)
  (return t)
)

