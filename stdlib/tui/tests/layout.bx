  (= t (call (. t expect) "rich text max width measures wrapped width" 5 (. measure content-size width)))
  (= t (call (. t expect) "rich text max width measures wrapped height" 4 (. measure content-size height)))
  (blank)
  (return t)
)

(fn-do + tui-absolute-position-layout-tests TestCase
  (param t TestCase)
  (<> TuiStyleDemo (id: demo) (• flow-col) (• border) (• p 1)
    (<> TextBox (id: flow-a) (text: "a"))
    (<> TextBox (id: abs-left) (text: "absolute") (• absolute) (• m 1) (• p 1)
      (= left 2)
      (= top 1)
    )
    (<> TextBox (id: abs-corner) (text: "xy") (• absolute)
      (= right 3)
      (= bottom 2)
    )
    (<> Box (id: abs-stretch) (• absolute) (• m 1)
      (= left 1)
      (= right 2)
      (= top 0)
      (= bottom 3)
    )
    (<> Box (id: abs-parent) (• absolute) (• flex-col) (• p 1)
      (= left 4)
      (= right 4)
      (= top 2)
      (= bottom 1)
      (<> TextBox (id: abs-child) (text: "z"))
    )
    (<> TextBox (id: flow-b) (text: "bb"))
  )
  (blank)
  (call (. demo markup-batch-queue checkpoint))
  (= (. demo bounds) (call Rect 0 0 20 10))
  (call (. demo update-layout))
  (blank)
  (= t (call expect-bounds t "flow a unaffected" flow-a 2 2 16 1))
  (= t (call expect-bounds t "flow b unaffected" flow-b 2 3 16 1))
  (= t (call (. t expect) "flow inner width ignores absolutes" 2 (. demo inner-width)))
  (= t (call (. t expect) "flow inner height ignores absolutes" 2 (. demo inner-height)))
  (blank)
  (= t (call expect-bounds t "absolute left top outer margin" abs-left 5 4 10 3))
  (= t (call expect-bounds t "absolute right bottom" abs-corner 13 5 2 1))
  (= t (call expect-bounds t "absolute stretched margin box" abs-stretch 4 3 11 1))
  (= t (call expect-bounds t "absolute parent" abs-parent 6 4 8 3))
  (= t (call expect-bounds t "absolute child laid out" abs-child 7 5 6 1))
  (blank)
  (return t)
)

(fn-do + tui-absolute-anchor-layout-tests TestCase
  (param t TestCase)
  (<> TuiStyleDemo (id: demo) (• flow-col) (• border) (• p 1)
    (<> Box (id: start-point) (• absolute)
      (= left .anchor-start)
      (= top .anchor-start)
      (= width 2)
      (= height 1)
    )
    (<> Box (id: center-point) (• absolute)
      (= left .anchor-center)
      (= top .anchor-center)
      (= width 4)
      (= height 2)
    )
    (<> Box (id: center-with-far-edge) (• absolute)
      (= left .anchor-center)
      (= right 0)
      (= top .anchor-center)
      (= bottom 0)
      (= width 4)
      (= height 2)
    )
    (<> Box (id: end-point) (• absolute)
      (= right .anchor-end)
      (= bottom .anchor-end)
      (= width 3)
      (= height 2)
    )
    (<> Box (id: percent-center) (• absolute)
      (= left 50%)
      (= top 50%)
      (= width 4)
      (= height 2)
    )
    (<> Box (id: percent-end) (• absolute)
      (= right 100%)
      (= bottom 100%)
      (= width 2)
      (= height 1)
    )
    (<> Box (id: margin-center) (• absolute)
      (= left .anchor-center)
      (= top .anchor-center)
      (= margin-left 2)
      (= margin-top 2)
      (= width 4)
      (= height 2)
    )
  )
  (blank)
  (call (. demo markup-batch-queue checkpoint))
  (= (. demo bounds) (call Rect 0 0 20 10))
  (call (. demo update-layout))
  (blank)
  (= t (call expect-bounds t "anchor start" start-point 2 2 2 1))
  (= t (call expect-bounds t "anchor center" center-point 8 4 4 2))
  (= t (call expect-bounds t "anchor center beats far edge" center-with-far-edge 8 4 4 2))
  (= t (call expect-bounds t "anchor end" end-point 15 6 3 2))
  (= t (call expect-bounds t "percent center" percent-center 8 4 4 2))
  (= t (call expect-bounds t "percent end" percent-end 16 7 2 1))
  (= t (call expect-bounds t "margin offsets centered anchor" margin-center 9 5 4 2))
  (blank)
  (return t)
)

(fn-do + tui-style-target-generated-content-tests TestCase
  (param t TestCase)
  (<> TuiStyleDemo (id: demo) (• flow-col)
    (<> StyleTargetLabel (id: target) (text: "row") (• generated-chevron)
      (= background-color (call AnsiColor 0))
    )
    (<> TextBox (id: after) (text: "after"))
  )
  (blank)
  (call (. demo markup-batch-queue checkpoint))
  (= (. demo bounds) (call Rect 0 0 10 4))
  (call (. demo update-layout))
  (blank)
  (let generated (!! (. target %next-sibling)))
  (= t (call expect-bounds t "style target generated chevron" generated 8 0 1 1))
  (= t (call expect-bounds t "style target flow sibling" after 0 1 10 1))
  (blank)
  (return t)
)

(fn-do + tui-dynamic-absolute-size-frame-tests TestCase
  (param t TestCase)
  (<> TuiDynamicAbsoluteSizeFrameDemo (id: demo))
  (blank)
  (call (. demo markup-batch-queue checkpoint))
  (= (. demo bounds) (call Rect 0 0 80 24))
  (call (. demo update-layout))
  (blank)
  (for (in frame (.. 1 2))
    (call (. demo advance-frame))
    (call (. demo markup-batch-queue checkpoint))
    (call (. demo update-layout))
    (= t
      (call expect-bounds
        (block
          (arg t)
          (arg (str "dynamic absolute size frame " frame))
          (arg (. demo overlay))
          (arg (. demo left))
          (arg (. demo top))
          (arg 42)
          (arg 14)
        )
      )
    )
  )
  (blank)
  (return t)
)

(fn-do + tui-hit-test-paint-order-tests TestCase
  (param t TestCase)
  (<> TuiStyleDemo (id: demo)
    (<> Box (id: under))
    (<> Box (id: over))
  )
  (blank)
  (= (. demo bounds) (call Rect 0 0 10 5))
  (= (. under bounds) (call Rect 1 1 5 3))
  (= (. over bounds) (call Rect 2 1 5 3))
  (blank)
  (= t (call (. t check) "hit later painted overlapping sibling" (== (call (. demo hit-test) (tuple 3 2)) over)))
  (= t (call (. t check) "hit earlier sibling outside overlap" (== (call (. demo hit-test) (tuple 1 2)) under)))
  (= t (call (. t check) "hit parent outside children" (== (as (call (. demo hit-test) (tuple 9 4)) Pointer) (as demo Pointer))))
  (blank)
  (return t)
)

(fn-do _ expect-bounds TestCase
  (param t TestCase)
  (param label String)
  (param box Box)
  (param x Coord)
  (param y Coord)
  (param width Coord)
  (param height Coord)
  (= t (call (. t expect) (str label " x") x (. box bounds x)))
  (= t (call (. t expect) (str label " y") y (. box bounds y)))
  (= t (call (. t expect) (str label " width") width (. box bounds width)))
  (= t (call (. t expect) (str label " height") height (. box bounds height)))
  (return t)
)

(type + StyleTargetLabel (is TextBox)
  (prop + style-target-fixture _ (= true))
  (blank)
  (rule generated-chevron
    (= padding-right 2)
    (blank)
    (<> Label (slot: after) (text: ">")
      (= position absolute)
      (= anchor style-target)
      (= right 1)
      (= align-y center)
    )
  )
)

(type + TuiStyleDemo (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + TuiDynamicAbsoluteSizeFrameDemo (is TuiStyleDemo)
  (prop + overlay-width Coord (= 30))
  (prop + overlay-height Coord (= 12))
  (prop + left Coord (= 0))
  (prop + top Coord (= 0))
  (content
    (<> Box (id: overlay) (• absolute) (• flow-col) (• border-double)
      (= left #left)
      (= top #top)
      (= min-width (call (. SizeSpec coord) #overlay-width))
      (= max-width (call (. SizeSpec coord) #overlay-width))
      (= min-height (call (. SizeSpec coord) #overlay-height))
      (= max-height (call (. SizeSpec coord) #overlay-height))
    )
  )
  (fn-do + advance-frame _
    (= overlay-width 40)
    (= overlay-height 12)
    (+= left 1)
    (= top (% (+ top 1) 13))
  )
)

(type + FlexInnerTestHost (is Box)
  (implements MarkupRootElement)
  (prop + orient Orientation)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout (call FlexLayout #orient))
  )
  (fn-do + This _
    (param orient _)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + FixedTextBox (is TextBox)
  (prop + fixed-width Coord)
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) #fixed-width))
    (= max-width (call (. SizeSpec coord) #fixed-width))
  )
  (fn-do + This _
    (param text String)
    (param fixed-width _)
    (call super text)
  )
)

(type + MasonryFixedBox (is Box)
  (prop + fixed-width Coord (= 0))
  (prop + fixed-height Coord (= 0))
  (fn-expr + measured-content-size PSize
    (param query MeasureQuery)
    (call PSize fixed-width fixed-height)
  )
)

(type + HiddenFixedTextBox (is FixedTextBox)
  (rule This
    (= display (. Display hidden))
  )
  (fn-do + This _
    (param text String)
    (param fixed-width Coord)
    (call super text fixed-width)
  )
)

(type + AbsoluteFixedTextBox (is FixedTextBox)
  (rule This
    (= position absolute)
    (= left 0)
    (= top 2)
  )
  (fn-do + This _
    (param text String)
    (param fixed-width Coord)
    (call super text fixed-width)
  )
)

(type + TuiRegionItem
  (prop + id String)
  (prop + text String)
  (fn-do + This _
    (param id _)
    (param text _)
  )
)

(type + TuiTransparentRegionDemo (is Box)
  (implements MarkupRootElement)
  (prop + items (list TuiRegionItem) (= (call (of List TuiRegionItem) (list (call TuiRegionItem "a" "A") (call TuiRegionItem "b" "B")))))
  (prop + show-preview _ (= true))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (for (in item #items (keyed-by (. item id)))
      (<> TextBox (value: (. item text))
        (= flex 1)
      )
    )
    (blank)
    (if #show-preview
      (<> TextBox (text: "P") (• flex 2))
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + insert-item _
    (= items
      (call (of List TuiRegionItem)
        (block
          (arg (list (call TuiRegionItem "a" "A") (call TuiRegionItem "c" "C") (call TuiRegionItem "b" "B")))
        )
      )
    )
  )
)
