(import /core/markup)
(import /test)
(import /tui/box)
(import /tui/colors)
(import /tui/columntree)
(import /tui/events)
(import /tui/listbox)
(import /tui/primitives)
(import /tui/text)
(import /tui/virtual)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "TUI Box Scroll"))
  (call (. cases run) box-scroll-2d-tests)
  (= cases (call (. cases then) "TUI Scroll Routing" scroll-routing-tests))
  (= cases (call (. cases then) "TUI Virtual Two Axis" virtual-two-axis-tests))
  (= cases (call (. cases then) "TUI Virtual Overscan Focus" virtual-overscan-focus-tests))
  (= cases (call (. cases then) "TUI Virtual Region Input" virtual-region-input-tests))
  (return cases)
)

(fn-do _ virtual-two-axis-tests _
  (param t TestCase)
  (<> VirtualTwoAxisHost (id: host))
  (blank)
  (call markup-mount-root host host)
  (call (. host markup-batch-queue checkpoint))
  (call (. host arrange-bounds) (call Rect 0 0 80 24))
  (call (. host update-layout))
  (blank)
  (let columns (. host columns))
  (call (. columns scroll) 25 (. Direction right))
  (call (. host update-layout))
  (let partial (!! (call virtual-root-for-address columns 2)))
  (= t
    (call (. t expect)
      (block
        (arg "partly visible columns sit left of the viewport edge")
        (arg (- (. columns content-bounds x) 5))
        (arg (. partial bounds x))
      )
    )
  )
  (= t (call (. t expect) "columns keep their width" 10 (. partial bounds width)))
  (= t (call (. t expect) "columns span the region height" (. columns content-bounds height) (. partial bounds height)))
  (= t (call (. t check) "partly visible columns are in the viewport" (. partial is-in-viewport)))
  (blank)
  (let wide (. host wide))
  (call (. wide scroll) 30 (. Direction right))
  (call (. wide scroll) 2 (. Direction down))
  (call (. host update-layout))
  (let wide-root (!! (call virtual-root-for-address wide 2)))
  (= t
    (call (. t expect)
      (block
        (arg "wide rows shift by the horizontal scroll")
        (arg (- (. wide content-bounds x) 30))
        (arg (. wide-root bounds x))
      )
    )
  )
  (= t (call (. t expect) "the top wide row sits at the viewport top" (. wide content-bounds y) (. wide-root bounds y)))
  (return t)
)

(fn-do _ virtual-overscan-focus-tests _
  (param t TestCase)
  (<> VirtualScrollHost (id: host))
  (blank)
  (call markup-mount-root host host)
  (call (. host markup-batch-queue checkpoint))
  (call (. host region arrange-bounds) (call Rect 0 0 80 24))
  (= (. host region virtual-scroll) (call VirtualPoint 0vcoord 4000vcoord))
  (call (. host region update-layout))
  (blank)
  (let first (call (. host region next-focus-candidate) null))
  (let first-root (of (?. first ancestor-or-self) (of VirtualSlotRoot I64)))
  (= t (call (. t expect) "traversal starts at the first visible row" 1000 (?? (. (?. first-root slot) address) -1)))
  (let focused-root (!! first-root))
  (blank)
  (= (. host region virtual-scroll) (call VirtualPoint 0vcoord 4008vcoord))
  (call (. host region update-layout))
  (let keeps-address (== (. focused-root slot address) 1000))
  (= t (call (. t check) "a row scrolled into overscan stays bound" (and (. focused-root slot is-bound) keeps-address)))
  (= t (call (. t check) "a row in overscan is outside the viewport" (not (. focused-root is-in-viewport))))
  (let next (call (. host region next-focus-candidate) null))
  (let next-root (of (?. next ancestor-or-self) (of VirtualSlotRoot I64)))
  (= t (call (. t expect) "traversal skips overscan rows" 1002 (?? (. (?. next-root slot) address) -1)))
  (let candidates (call (. host region focus-candidates)))
  (let offscreen Size)
  (for (in candidate candidates)
    (if (not (?? (?. (of (. candidate ancestor-or-self) (of VirtualSlotRoot I64)) is-in-viewport) false))
      (+= offscreen 1)
    )
  )
  (= t (call (. t expect) "focus candidates come only from the viewport" 0 offscreen))
  (= t (call (. t expect) "every visible row offers a focus candidate" 6 (. candidates length)))
  (return t)
)

(fn-do _ virtual-region-input-tests _
  (param t TestCase)
  (<> VirtualScrollHost (id: host))
  (blank)
  (call markup-mount-root host host)
  (call (. host markup-batch-queue checkpoint))
  (call (. host region arrange-bounds) (call Rect 0 0 80 24))
  (= (. host region virtual-scroll) (call VirtualPoint 0vcoord 4000vcoord))
  (call (. host region update-layout))
  (blank)
  (let root (!! (call virtual-root-for-address (. host region) 1000)))
  (let row (as (!! (. root %first-child)) VirtualScrollRow))
  (let frames (list HitFrame)
    (block
      (item (call HitFrame (. host region) (call Point 1 1) (. host region input-generation)))
      (item (call HitFrame root (call Point 1 1) (. root input-generation)))
      (item (call HitFrame row (call Point 1 1) (. row input-generation)))
    )
  )
  (let pressed-hit (call HitPath row (. host region) (call Point 0 0) (call Point 1 1) null frames))
  (blank)
  (= (. host region virtual-scroll) (call VirtualPoint 0vcoord 8000vcoord))
  (call (. host region update-layout))
  (call (. pressed-hit publish-click) (call ClickEvent))
  (= t (call (. t expect) "a click on a row recycled since the press is dropped" 0 (. row click-count)))
  (return t)
)

(fn-do _ virtual-root-for-address (? (of VirtualSlotRoot I64))
  (param region (of VirtualRegion I64))
  (param address I64)
  (let index Index)
  (while (< index (. region pool-size))
    (let root (call (. region root-at) index))
    (if (and root (. root slot is-bound) (== (. root slot address) address))
      (return root)
    )
    (+= index 1)
  )
  (return null)
)

(fn-do _ box-scroll-2d-tests _
  (param t TestCase)
  (<> ScrollBoxHost (id: host) (• flow-row)
    (<> Box (id: first)
      (= min-width (call (. SizeSpec coord) 40))
      (= max-width (call (. SizeSpec coord) 40))
      (= min-height (call (. SizeSpec coord) 4))
      (= max-height (call (. SizeSpec coord) 4))
    )
    (<> Box (id: second)
      (= min-width (call (. SizeSpec coord) 40))
      (= max-width (call (. SizeSpec coord) 40))
      (= min-height (call (. SizeSpec coord) 4))
      (= max-height (call (. SizeSpec coord) 4))
    )
  )
  (blank)
  (call markup-mount-root host host)
  (call (. host markup-batch-queue checkpoint))
  (call (. host arrange-bounds) (call Rect 0 0 30 3))
  (call (. host update-layout))
  (blank)
  (= t (call (. t expect) "inner width tracks laid out content" 80 (. host inner-width)))
  (= t (call (. t expect) "inner height tracks laid out content" 4 (. host inner-height)))
  (blank)
  (= t (call (. t check) "scrolls right" (call (. host scroll) 10 (. Direction right))))
  (= t (call (. t expect) "scroll right changes x" -10 (. host scroll-x)))
  (= t (call (. t expect) "scroll right leaves y" 0 (. host scroll-y)))
  (blank)
  (= t (call (. t check) "scrolls down" (call (. host scroll) 10 (. Direction down))))
  (= t (call (. t expect) "scroll down keeps x" -10 (. host scroll-x)))
  (= t (call (. t expect) "scroll down clips y" -1 (. host scroll-y)))
  (= t (call (. t check) "cannot scroll down past bottom" (not (call (. host scroll) 10 (. Direction down)))))
  (blank)
  (= t (call (. t check) "scrolls left" (call (. host scroll) 100 (. Direction left))))
  (= t (call (. t expect) "scroll left clips x" 0 (. host scroll-x)))
  (= t (call (. t check) "scrolls up" (call (. host scroll) 10 (. Direction up))))
  (= t (call (. t expect) "scroll up clips y" 0 (. host scroll-y)))
  (blank)
  (= t (call (. t check) "scroll bounds visible moves x and y" (call (. host scroll-bounds-visible) (. second bounds))))
  (= t (call (. t expect) "visible second box x" -50 (. host scroll-x)))
  (= t (call (. t expect) "visible second box y" -1 (. host scroll-y)))
  (blank)
  (return t)
)

(fn-do _ scroll-routing-tests _
  (param t TestCase)
  (<> ListScrollHost (id: list-host) (• flex-col))
  (blank)
  (call markup-mount-root list-host list-host)
  (call (. list-host markup-batch-queue checkpoint))
  (call (. list-host arrange-bounds) (call Rect 0 0 20 5))
  (call (. list-host update-layout))
  (blank)
  (call (. list-host list scroll) 99 (. Direction down))
  (blank)
  (let edge-scroll (call ScrollEvent (call Point 1 1) (. Direction down)))
  (let edge-canceled (call (. list-host publish-pointer) edge-scroll))
  (call (. t check) "clipped scroll does not cancel event" (not edge-canceled))
  (blank)
  (<> TreeScrollHost (id: tree-host) (• flex-col))
  (blank)
  (call markup-mount-root tree-host tree-host)
  (call (. tree-host markup-batch-queue checkpoint))
  (call (. tree-host arrange-bounds) (call Rect 0 0 40 8))
  (call (. tree-host update-layout))
  (blank)
  (call (. tree-host tree enter))
  (call (. tree-host markup-batch-queue checkpoint))
  (call (. tree-host update-layout))
  (blank)
  (call (. tree-host tree scroll) (tuple 0 (. tree-host tree scroll-y)))
  (let horizontal-scroll (call ScrollEvent (call Point 1 1) (. Direction right)))
  (call (. tree-host publish-pointer) horizontal-scroll)
  (= t (call (. t expect) "horizontal wheel scrolls tree" -1 (. tree-host tree scroll-x)))
  (blank)
  (let vertical-scroll (call ScrollEvent (call Point 31 2) (. Direction down)))
  (call (. tree-host publish-pointer) vertical-scroll)
  (= t (call (. t expect) "vertical wheel scrolls hovered column" -1 (call column-scroll-y (. tree-host tree) 1)))
  (blank)
  (return t)
)

(fn-expr + long-row-texts (list String)
  (spread (in (str "Row " each) (.. 1 20)))
)

(fn-expr + scroll-node-children _
  (param item ScrollNode)
  (match (. item id)
    (case "tree"
      (item (call ScrollNode "root" "Root" (:has-children true)))
    )
    (case "root"
      (spread (in (call ScrollNode (str "leaf-" each) (str "Leaf " each)) (.. 1 20)))
    )
    (default
      (call (of List ScrollNode))
    )
  )
)

(fn-expr + column-scroll-y _
  (param tree (of ColumnTree ScrollNode))
  (param index Index)
  (if-expr (< index (. tree columns length)) (. ([] (. tree columns) index) scroll-y) 0)
)

(type + ScrollBoxHost (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + VirtualScrollHost (is Box)
  (implements MarkupRootElement)
  (prop + source _ (:= (call VirtualRangeSource 1000000000vcoord)))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> (of VirtualRegion I64) (id: region) (• flex 1)
      (= source #source)
      (= virtual-layout (call VerticalFixedLayout 4vcoord))
      (= overscan (call VirtualInsets 12vcoord 0vcoord 12vcoord 0vcoord))
      (blank)
      (<> VirtualScrollRow (slot: row) (param: slot)
        (= item (. slot #item))
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + VirtualTwoAxisHost (is Box)
  (implements MarkupRootElement)
  (prop + source _ (:= (call VirtualRangeSource 1000vcoord)))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This (• flex-col)
      (<> (of VirtualRegion I64) (id: columns) (• flex 1)
        (= source #source)
        (= virtual-layout (call HorizontalFixedLayout 10vcoord))
        (= overscan (call VirtualInsets 0vcoord 10vcoord 0vcoord 10vcoord))
        (blank)
        (<> VirtualScrollRow (slot: row) (param: slot)
          (= item (. slot #item))
        )
      )
      (blank)
      (<> (of VirtualRegion I64) (id: wide) (• flex 1)
        (= source #source)
        (= virtual-layout (call VerticalFixedLayout 1vcoord 200vcoord))
        (blank)
        (<> VirtualScrollRow (slot: row) (param: slot)
          (= item (. slot #item))
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + VirtualScrollRow (is Box)
  (prop + item I64)
  (prop + click-count Size (= 0))
  (blank)
  (rule This (• flex 1)
    (= background-color (if-expr (== (% #item 2) 0) navy black))
  )
  (content
    (<> This
      (<> VirtualScrollOwnedChild)
    )
  )
  (subscribe-for (on event click)
    (+= click-count 1)
  )
)

(type + VirtualScrollOwnedChild (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
)

(type + ListScrollHost (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> ListBox (id: list) (• flex 1)
      (for (in text (call long-row-texts))
        (<> ListItem
          (= text text)
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + TreeScrollHost (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> (of ColumnTree ScrollNode) (id: tree) (• flex 1)
      (= root-node (call ScrollNode "tree" "Tree" (:has-children true)))
      (= load-children scroll-node-children)
      (blank)
      (<> ScrollTreeRow (slot: row) (param: item)
        (= item item)
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + ScrollNode
  (prop + id String)
  (prop + text String)
  (prop + has-children _ (= false))
  (fn-do + This _
    (param id _)
    (param text _)
    (param has-children _ (= false))
  )
)

(type + ScrollTreeRow (is ListItem)
  (prop + item ScrollNode)
  (fn-do + This _
    (param item _)
    (= has-children (. item has-children))
    (= text (str " 📁 " (. item text)))
  )
)
