+ table-test-score String
    - row DemoRecord

"${row.score}"

━━━━━━━━━━━━━━━━━━━━
+ table-test-score-key String
    - row DemoRecord

"${row.score}"

━━━━━━━━━━━━━━━━━━━━
+ TableTestHost is Box
    is MarkupBatch

+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────

<This • flex-col
    <Table'DemoRecord table • flex:1
        columns = table-test-columns()
        rows = table-test-rows()
        key-builder = table-test-key

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

. ignored = flush.applied

━━━━━━━━━━━━━━━━━━━━
+ DemoRecord is Tuple

+ id String
+ pid Int
+ name String
+ score Int
