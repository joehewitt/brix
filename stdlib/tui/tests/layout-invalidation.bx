(import /core/markup)
(import /test)
(import /tui/box)
(import /tui/layout)
(import /tui/primitives)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "TUI Flow Row Shrink"))
  (call (. cases run) tui-flow-row-shrink-tests)
  (= cases (call (. cases then) "TUI Hidden Subtree Reveal" tui-hidden-subtree-reveal-tests))
  (return cases)
)

(fn-do + tui-flow-row-shrink-tests TestCase
  (param t TestCase)
  (let root (call TuiFlowRowRoot))
  (let tall (call TuiFlowRowCell))
  (let middle (call TuiFlowRowCell))
  (let last (call TuiFlowRowCell))
  (= (. tall measured-height) 5)
  (= (. middle measured-height) 2)
  (= (. last measured-height) 3)
  (call markup-mount-root root root)
  (call markup-append root tall)
  (call markup-append root middle)
  (call markup-append root last)
  (call (. root markup-batch-queue checkpoint))
  (= (. root bounds) (call Rect 0 0 40 8))
  (call (. root update-layout))
  (= t (call (. t expect) "row height starts at the tallest child" 5 (. root inner-height)))
  (blank)
  (= (. tall measured-height) 1)
  (call (. root update-layout))
  (= t (call (. t expect) "row height shrinks to the remaining tallest child" 3 (. root inner-height)))
  (return t)
)

(fn-do + tui-hidden-subtree-reveal-tests TestCase
  (param t TestCase)
  (let root (call TuiHiddenRevealRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (= (. root bounds) (call Rect 0 0 20 8))
  (call (. root update-layout))
  (blank)
  (= (. root leaf measured-height) 3)
  (= (. root group is-hidden) false)
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (= t (call (. t expect) "revealed leaf y" 0 (. root leaf bounds y)))
  (= t (call (. t expect) "revealed leaf height" 3 (. root leaf bounds height)))
  (= t (call (. t expect) "following sibling y" 3 (. root after bounds y)))
  (= t (call (. t expect) "following sibling height" 1 (. root after bounds height)))
  (= t (call (. t expect) "root inner height" 4 (. root inner-height)))
  (return t)
)

(type + TuiFlowRowRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-row)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + TuiFlowRowCell (is Box)
  (prop + measured-width Coord (= 3))
  (prop + measured-height Coord (= 1))
  (blank)
  (depends invalidate-content-size measured-width)
  (depends invalidate-content-size measured-height)
  (fn-expr + measured-content-size PSize
    (param query MeasureQuery)
    (call PSize measured-width measured-height)
  )
)

(type + TuiHiddenRevealRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (content
    (<> This
      (<> TuiHiddenRevealGroup (id: group)
        (<> TuiHiddenRevealLeaf (id: leaf))
      )
      (<> TuiHiddenRevealLeaf (id: after))
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + TuiHiddenRevealGroup (is Box)
  (prop + is-hidden _ (= true))
  (blank)
  (rule This
    (= layout flow-col)
    (= display (if-expr #is-hidden (. Display hidden) (. Display visible)))
  )
)

(type + TuiHiddenRevealLeaf (is Box)
  (prop + measured-height Coord (= 1))
  (blank)
  (depends invalidate-content-size measured-height)
  (fn-expr + measured-content-size PSize
    (param query MeasureQuery)
    (call PSize 3 measured-height)
  )
)
