(import /test)
(import /tui/events)
(import /ui/key-combo)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Terminal Events"))
  (tuple "Option+Left" (call key-press-summary "\x1b[1;3D"))
  (tuple "Option+Left" (call key-press-summary "\x1bb"))
  (tuple "Option+Right" (call key-press-summary "\x1b[1;3C"))
  (tuple "Option+Right" (call key-press-summary "\x1bf"))
  (tuple "Option+Shift+Left" (call key-press-summary "\x1b[1;4D"))
  (tuple "Option+Shift+Left" (call key-press-summary "\x1bB"))
  (tuple "Option+Shift+Right" (call key-press-summary "\x1b[1;4C"))
  (tuple "Option+Shift+Right" (call key-press-summary "\x1bF"))
  (tuple "Home, End" (call key-press-summary "\x1b[H\x1b[F"))
  (tuple "Home, End" (call key-press-summary "\x1b[1~\x1b[4~"))
  (tuple "Shift+Enter" (call key-press-summary "\x1b[13;2u"))
  (tuple "Shift+Enter" (call key-press-summary "\x1b[27;2;13~"))
  (header (call test "Terminal Input"))
  (tuple "" (call input-text "\x1b[?2004h"))
)

(fn-do _ input-text _
  (param source String)
  (let text "")
  (for (in event (in (~ TerminalEvents) source))
    (if (is event KeyInputEvent)
      (let input (as event KeyInputEvent))
      (+= text (. input char))
    )
  )
  (blank)
  (return text)
)

(fn-do _ key-press-summary _
  (param source String)
  (let events (list String))
  (for (in event (in (~ TerminalEvents) source))
    (if (is event KeyPressEvent)
      (let press (as event KeyPressEvent))
      (+= events (. (call KeyCombo (. press modifiers) (call (. KeyTrigger key) (. press key))) display-label))
      (else
        (+= events (str event))
      )
    )
  )
  (blank)
  (return (call (. ", " join) events))
)
