(import /core/markup)
(import /test)
(import /tui/box)
(import /tui/events)
(import /tui/primitives)
(import /tui/text)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Pointer Routing"))
  (call (. cases run) pointer-routing-tests)
  (= cases (call (. cases then) "Pointer Modal Routing" pointer-modal-routing-tests))
  (= cases (call (. cases then) "Pointer Scroll Routing" pointer-scroll-routing-tests))
  (= cases (call (. cases then) "Pointer Reentrant Routing" pointer-reentrant-routing-tests))
  (= cases (call (. cases then) "Focus Traversal" focus-traversal-tests))
  (= cases (call (. cases then) "Layout Checkpoint Outside Mutation" layout-checkpoint-outside-tests))
  (return cases)
)

(fn-do + pointer-routing-tests TestCase
  (param t TestCase)
  (let trace (list String))
  (let root (call PointerProbeBox "root" trace))
  (let mid (call PointerProbeBox "mid" trace))
  (let leaf (call PointerProbeBox "leaf" trace))
  (call markup-mount-root root root)
  (call markup-append root mid)
  (call markup-append mid leaf)
  (= (. root bounds) (call Rect 0 0 20 20))
  (= (. mid bounds) (call Rect 0 0 20 20))
  (= (. leaf bounds) (call Rect 0 0 20 20))
  (= (. root scroll-x) -2)
  (= (. mid scroll-y) -3)
  (blank)
  (call (. root publish-pointer) (call MouseDownEvent (tuple 5 5)))
  (let expected-nested "leaf:down:(7, 8), mid:down:(7, 5), root:down:(5, 5)")
  (call (. t expect) "nested pointer order and local points" expected-nested (call (. ", " join) trace))
  (blank)
  (return t)
)

(fn-do + pointer-modal-routing-tests TestCase
  (param t TestCase)
  (let modal-trace (list String))
  (let modal-root (call PointerProbeBox "modal-root" modal-trace))
  (let modal-outer (call PointerProbeBox "modal-outer" modal-trace))
  (let modal (call PointerProbeBox "modal" modal-trace))
  (let modal-leaf (call PointerProbeBox "modal-leaf" modal-trace))
  (call markup-mount-root modal-root modal-root)
  (call markup-append modal-root modal-outer)
  (call markup-append modal-outer modal)
  (call markup-append modal modal-leaf)
  (= (. modal-root bounds) (call Rect 0 0 20 10))
  (= (. modal-outer bounds) (call Rect 0 0 20 10))
  (= (. modal bounds) (call Rect 2 2 10 5))
  (= (. modal-leaf bounds) (call Rect 2 2 10 5))
  (blank)
  (let modal-hit (call (. modal-root hit-path-within) modal (tuple 3 3)))
  (call (. modal-hit publish-pointer) (call MouseDownEvent (tuple 3 3)))
  (let expected-modal "modal-leaf:down:(3, 3), modal:down:(3, 3), modal-root:down:(3, 3)")
  (call (. t expect) "modal route excludes outer boxes" expected-modal (call (. ", " join) modal-trace))
  (blank)
  (call (. modal-trace clear))
  (let backdrop-hit (call (. modal-root hit-path-within) modal (tuple 0 0)))
  (call (. backdrop-hit publish-pointer) (call MouseDownEvent (tuple 0 0)))
  (let expected-backdrop "modal:down:(0, 0), modal-root:down:(0, 0)")
  (call (. t expect) "modal backdrop excludes outer boxes" expected-backdrop (call (. ", " join) modal-trace))
  (blank)
  (return t)
)

(fn-do + pointer-scroll-routing-tests TestCase
  (param t TestCase)
  (let scroll-trace (list String))
  (let scroll-root (call PointerProbeBox "scroll-root" scroll-trace))
  (let scroller (call PointerProbeBox "scroller" scroll-trace))
  (let scroll-inner (call PointerProbeBox "scroll-inner" scroll-trace))
  (let scroll-leaf (call PointerProbeBox "scroll-leaf" scroll-trace))
  (call markup-mount-root scroll-root scroll-root)
  (call markup-append scroll-root scroller)
  (call markup-append scroller scroll-inner)
  (call markup-append scroll-inner scroll-leaf)
  (= (. scroll-root bounds) (call Rect 0 0 20 10))
  (= (. scroller bounds) (call Rect 0 0 20 10))
  (= (. scroll-inner bounds) (call Rect 0 0 20 30))
  (= (. scroll-leaf bounds) (call Rect 0 0 20 30))
  (blank)
  (let pressed (call (. scroll-root hit-path) (tuple 1 5)))
  (call (. pressed publish-pointer) (call MouseDownEvent (tuple 1 5)))
  (blank)
  (call (. scroller scroll) (tuple 0 -3))
  (let expected-scrolled-drag
    (paragraph
      "scroll-leaf:drag:(1, 8), scroll-inner:drag:(1, 8), scroller:drag:(1, 5), scroll-root:drag:(1, 5)"
    )
  )
  (call (. scroll-trace clear))
  (call (. pressed publish-pointer) (call MouseDragEvent (tuple 1 5)))
  (let actual-drag (call (. ", " join) scroll-trace))
  (call (. t expect) "captured drag uses live scrolled points" expected-scrolled-drag actual-drag)
  (let captured-leaf-y (?? (?. (call (. pressed point-for) scroll-leaf) y) -1))
  (call (. t expect) "captured point-for uses live scroll" 8 captured-leaf-y)
  (blank)
  (return t)
)

(fn-do + pointer-reentrant-routing-tests TestCase
  (param t TestCase)
  (let forward-trace (list String))
  (let forward-root (call PointerProbeBox "forward-root" forward-trace))
  (let forward-mid (call ForwardingPointerProbeBox "forward-mid" forward-trace))
  (let forward-leaf (call PointerProbeBox "forward-leaf" forward-trace))
  (call markup-mount-root forward-root forward-root)
  (call markup-append forward-root forward-mid)
  (call markup-append forward-mid forward-leaf)
  (= (. forward-root bounds) (call Rect 0 0 20 20))
  (= (. forward-mid bounds) (call Rect 0 0 20 20))
  (= (. forward-leaf bounds) (call Rect 0 0 20 20))
  (= (. forward-mid forward-next) true)
  (call (. forward-root publish-pointer) (call MouseDownEvent (tuple 3 2)))
  (let expected-forward
    (paragraph
      "forward-leaf:down:(3, 2), forward-mid:down:(3, 2), forward-leaf:down:(3, 2), forward-mid:down:(3, 2), forward-root:down:(3, 2)"
    )
  )
  (let actual-forward (call (. ", " join) forward-trace))
  (call (. t expect) "same pointer event resumes outer route" expected-forward actual-forward)
  (blank)
  (return t)
)

(fn-do + focus-traversal-tests TestCase
  (param t TestCase)
  (<> TuiPainterDemo (id: hidden-root)
    (<> Box (id: hidden-parent)
      (= display (. Display invisible))
    )
  )
  (blank)
  (call markup-mount-root hidden-root hidden-root)
  (call (. hidden-root markup-batch-queue checkpoint))
  (blank)
  (let focus-trace (list String))
  (let hidden-child (call PointerProbeBox "hidden-child" focus-trace))
  (let visible-after (call PointerProbeBox "visible-after" focus-trace))
  (call markup-append hidden-parent hidden-child)
  (call markup-append hidden-root visible-after)
  (call (. hidden-root markup-batch-queue checkpoint))
  (blank)
  (let visible-after-box Box visible-after)
  (let hidden-candidates (call (. hidden-root focus-candidates)))
  (= t (call (. t expect) "hidden subtree focus candidate count" 1 (. hidden-candidates length)))
  (= t (call (. t check) "hidden subtree candidate is visible" (== ([] hidden-candidates 0) visible-after-box)))
  (blank)
  (return t)
)

(fn-do + layout-checkpoint-outside-tests TestCase
  (param t TestCase)
  (<> CheckpointHost (id: host))
  (blank)
  (call markup-mount-root host host)
  (call (. host markup-batch-queue checkpoint))
  (call (. host arrange-bounds) (call Rect 0 0 80 24))
  (call (. host update-layout))
  (blank)
  (= (. host region base) 12345678)
  (call (. host region invalidate-layout))
  (call (. host update-layout))
  (= t
    (call (. t expect)
      (block
        (arg "outside data changes during the region checkpoint")
        (arg "Outside 12345678")
        (arg (. host outside text))
      )
    )
  )
  (blank)
  (call (. host update-layout))
  (= t
    (call (. t expect)
      (block
        (arg "outside relayout is not lost")
        (arg (. host outside intrinsic-size width))
        (arg (. host outside bounds width))
      )
    )
  )
  (return t)
)

(type + CheckpointShared
  (prop + outside-text _ (= "Outside"))
)

(type + CheckpointRegion (is Box)
  (prop + shared (? CheckpointShared))
  (prop + base I64)
  (fn-do + did-layout _
    (= (?. shared outside-text) (str "Outside " base))
    (let root markup-batch-root)
    (if root
      (catch (call (. root markup-batch-queue checkpoint)))
    )
  )
)

(type + CheckpointHost (is Box)
  (implements MarkupRootElement)
  (prop + shared _ (:= (call CheckpointShared)))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This (• flex-col)
      (<> Box (• flex-row)
        (<> Label (id: outside)
          (= text (. shared #outside-text))
        )
      )
      (blank)
      (<> CheckpointRegion (id: region) (• flex 1)
        (= shared #shared)
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + TuiPainterDemo (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + PointerProbeBox (is Box)
  (implements MarkupRootElement)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + name String)
  (prop + trace (list String))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + This _
    (param name _)
    (param trace _)
  )
  (subscribe-for (on event mouse-down)
    (let point (. event point))
    (+= trace (str name ":down:" point))
  )
  (subscribe-for (on event mouse-drag)
    (let point (. event point))
    (+= trace (str name ":drag:" point))
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + ForwardingPointerProbeBox (is PointerProbeBox)
  (prop + forward-next _ (= false))
  (subscribe-for (on event mouse-down)
    (if forward-next
      (= forward-next false)
      (call publish-pointer event)
    )
  )
)
