(import /core/markup)
(import /test)
(import /tui/box)
(import /tui/canvas)
(import /tui/events)
(import /tui/primitives)
(import /tui/texteditor)
(import /ui/input)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "TUI TextEditor Navigation"))
  (call (. cases run) text-editor-navigation-tests)
  (= cases (call (. cases then) "TUI TextEditor Paint After Growth" text-editor-paint-after-growth-tests))
  (= cases (call (. cases then) "TUI TextEditor Nested Flex Growth" text-editor-nested-flex-growth-tests))
  (= cases (call (. cases then) "TUI TextEditor Parent Clip Cursor" text-editor-parent-clip-cursor-tests))
  (= cases (call (. cases then) "TUI TextEditor Mouse Selection" text-editor-mouse-selection-tests))
  (return cases)
)

(fn-do _ text-editor-navigation-tests TestCase
  (param t TestCase)
  (let editor (call TextEditor "abcdefghijkl"))
  (= (. editor multiline) true)
  (call (. editor arrange-bounds) (call Rect 0 0 4 3))
  (call (. editor update-layout))
  (= (. editor selection) (call TextSelection 0 0))
  (blank)
  (call (. editor handle-key-press) (call KeyPressEvent (. Key arrow-down)))
  (= t (call (. t expect) "wrapped down moves to next visual line" 4 (. editor selection cursor)))
  (call (. editor handle-key-press) (call KeyPressEvent (. Key arrow-up)))
  (= t (call (. t expect) "wrapped up returns to previous visual line" 0 (. editor selection cursor)))
  (blank)
  (return t)
)

(fn-do _ text-editor-mouse-selection-tests TestCase
  (param t TestCase)
  (let scrolled (call TextEditor "abcdef"))
  (call (. scrolled arrange-bounds) (call Rect 0 0 4 1))
  (call (. scrolled update-layout))
  (call (. scrolled publish-pointer) (call MouseDownEvent (tuple 0 0)))
  (call (. scrolled publish-pointer) (call MouseDragEvent (tuple 6 0)))
  (= t (call (. t expect) "drag past right edge selects to end" (call TextSelection 0 6) (. scrolled selection)))
  (= t (call (. t check) "drag past right edge scrolls" (< (. scrolled scroll-x) 0)))
  (blank)
  (return t)
)

(fn-do _ text-editor-paint-after-growth-tests TestCase
  (param t TestCase)
  (let editor (call TextEditor "abc"))
  (= (. editor multiline) true)
  (= (. editor is-focused) true)
  (call (. editor arrange-bounds) (call Rect 0 0 10 1))
  (call (. editor update-layout))
  (= (. editor selection) (call TextSelection 3 3))
  (call (. editor insert-text) "\n")
  (= t (call (. t expect) "newline insertion scrolled to caret in stale one-line bounds" -1 (. editor scroll-y)))
  (blank)
  (call (. editor arrange-bounds) (call Rect 0 0 10 2))
  (call (. editor update-layout))
  (let canvas (call Canvas (call PSize 10 2)))
  (call (. editor paint) canvas)
  (let frame (call (. canvas dump)))
  (blank)
  (= t (call (. t expect) "paint corrects scroll before drawing" 0 (. editor scroll-y)))
  (= t (call (. t check) "paint after newline keeps previous line visible" (!= (call (. frame find) "abc") null)))
  (blank)
  (return t)
)

(fn-do _ text-editor-nested-flex-growth-tests TestCase
  (param t TestCase)
  (<> TextEditorNestedFlexGrowthHarness (id: host) (• flex-col))
  (blank)
  (call markup-mount-root host host)
  (call (. host markup-batch-queue checkpoint))
  (call (. host arrange-bounds) (call Rect 0 0 20 8))
  (call (. host update-layout))
  (blank)
  (= t (call (. t expect) "initial prompt height" 1 (. host prompt bounds height)))
  (= t (call (. t expect) "initial composer height" 1 (. host composer bounds height)))
  (blank)
  (= (. host composer is-focused) true)
  (= (. host composer selection) (call TextSelection (. host composer text length) (. host composer text length)))
  (call (. host composer insert-text) "\n")
  (call (. host update-layout))
  (blank)
  (= t (call (. t expect) "nested flex prompt grows after newline" 2 (. host prompt bounds height)))
  (= t (call (. t expect) "nested flex composer grows after newline" 2 (. host composer bounds height)))
  (blank)
  (return t)
)

(fn-do _ text-editor-parent-clip-cursor-tests TestCase
  (param t TestCase)
  (<> TextEditorClippedParentHarness (id: host) (• flex-col))
  (blank)
  (call markup-mount-root host host)
  (call (. host markup-batch-queue checkpoint))
  (call (. host arrange-bounds) (call Rect 0 0 30 5))
  (call (. host update-layout))
  (= (. host editor is-focused) true)
  (blank)
  (for (in line (list "one" "two" "three" "four" "last line"))
    (call (. host editor insert-text) line)
    (call (. host editor insert-text) "\n")
    (call (. host update-layout))
  )
  (blank)
  (call (. host paint) (call Canvas (call PSize 30 5)))
  (blank)
  (if (!= (. host editor cursor-point y) (- (. host panel content-bounds bottom) 1))
    (throw (call Panic (str "TextEditor cursor escaped parent clip: cursor " (. host editor cursor-point y) ", bottom " (. host panel content-bounds bottom))))
  )
  (blank)
  (return t)
)

(type + TextEditorNestedFlexGrowthHarness (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This
      (<> Box (id: transcript) (• flex 1))
      (<> Box (id: prompt) (• flex-row)
        (<> TextEditor (id: composer) (text: "") (• flex 1)
          (= multiline true)
          (= max-height 6)
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + TextEditorClippedParentHarness (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This
      (<> Box (id: panel) (• flex-col) (• flex 1)
        (<> Box
          (= min-height (call (. SizeSpec coord) 1))
          (= max-height (call (. SizeSpec coord) 1))
        )
        (<> TextEditor (id: editor) (text: "")
          (= multiline true)
          (= max-height 5)
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)
