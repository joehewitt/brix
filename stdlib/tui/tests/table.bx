(import /core/markup)
(import /math)
(import /test)
(import /tui)
(import /tui/box)
(import /tui/colors)
(import /tui/primitives)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "TUI Table"))
  (= cases (call table-layout-tests cases))
  (= cases (call (. cases then) "TUI Table Sort Selection" table-sort-selection-tests))
  (= cases (call (. cases then) "TUI Table Selection Replacement" table-selection-replacement-tests))
  (return cases)
)

(fn-do + table-layout-tests TestCase
  (param t TestCase)
  (let host (call mounted-table-test-host))
  (blank)
  (= t (call (. t expect) "metrics width" 24 (. host table metrics-width)))
  (blank)
  (return t)
)

(fn-do + table-sort-selection-tests TestCase
  (param t TestCase)
  (let host (call mounted-table-test-host))
  (let before-sort (call (. host table ordered-row-boxes)))
  (let selected-widget ([] before-sort 0))
  (catch (call (. host table select-row) selected-widget))
  (blank)
  (let score (call (. host table column-for-id) "score"))
  (call (. host table toggle-sort) (!! score))
  (call (. host markup-batch-queue checkpoint))
  (call (. host markup-batch-queue checkpoint))
  (call (. host update-layout))
  (blank)
  (let ascending (call (. host table ordered-row-boxes)))
  (call (. t check) "sort preserves selected row state" (. ([] ascending 1) is-selected))
  (call (. t expect) "sort changes only display index" 1 (?? (. host table selected-index) 99))
  (return t)
)

(fn-do + table-selection-replacement-tests TestCase
  (param t TestCase)
  (let host (call mounted-table-test-host))
  (let selected-widget ([] (call (. host table ordered-row-boxes)) 0))
  (catch (call (. host table select-row) selected-widget))
  (let score (call (. host table column-for-id) "score"))
  (call (. host table toggle-sort) (!! score))
  (call (. host markup-batch-queue checkpoint))
  (call (. host markup-batch-queue checkpoint))
  (call (. host table toggle-sort) (!! score))
  (call (. host markup-batch-queue checkpoint))
  (call (. host markup-batch-queue checkpoint))
  (blank)
  (let replacement-rows (list DemoRecord)
    (block
      (item (call DemoRecord "b" 7 "Beta" 10))
      (item (call DemoRecord "d" 12 "Delta" 20))
      (item (call DemoRecord "c" 300 "Gamma" 30))
    )
  )
  (= (. host table rows) replacement-rows)
  (call (. host markup-batch-queue checkpoint))
  (call (. host markup-batch-queue checkpoint))
  (call (. host update-layout))
  (blank)
  (let replaced (call (. host table ordered-row-boxes)))
  (call (. t expect) "replacement occupies old display index" "d" (?? (. ([] replaced 1) row-key) ""))
  (call (. t check) "replacement at old display index is unselected" (not (. ([] replaced 1) is-selected)))
  (call (. t expect) "removed selection clears selected key" "" (?? (. host table selected-key) ""))
  (return t)
)

(fn-do + mounted-table-test-host TableTestHost
  (let host (call TableTestHost))
  (call markup-mount-root host host)
  (call (. host markup-batch-queue checkpoint))
  (call (. host markup-batch-queue checkpoint))
  (= (. host bounds) (call Rect 0 0 24 4))
  (call (. host update-layout))
  (call (. host table arrange-outer-bounds) (call Rect 0 0 24 4))
  (call (. host table update-layout))
  (return host)
)

(fn-expr + table-test-rows (list DemoRecord)
  (item (call DemoRecord "a" 42 "Alpha" 20))
  (item (call DemoRecord "b" 7 "Beta" 10))
  (item (call DemoRecord "c" 300 "Gamma" 30))
)

(fn-expr + table-test-columns (list (of TableColumn DemoRecord))
  (item (call table-test-column "pid" "PID" (call (. TableWidth fixed) 4) (. TableAlign right) table-test-pid))
  (item (call table-test-column "name" "Name" (call (. TableWidth flex) 1) (. TableAlign left) table-test-name))
  (item
    (call table-test-sort-column
      (block
        (arg "score")
        (arg "Score")
        (arg (. TableWidth auto))
        (arg (. TableAlign right))
        (arg table-test-score)
        (arg table-test-score-key)
      )
    )
  )
)

(fn-do + table-test-column (of TableColumn DemoRecord)
  (param id String)
  (param title String)
  (param width TableWidth)
  (param align TableAlign)
  (param value (of TableTextProvider DemoRecord))
  (let column (call (of TableColumn DemoRecord) title))
  (= (. column id) id)
  (= (. column column-width) width)
  (= (. column align) align)
  (= (. column value) value)
  (return column)
)

(fn-do + table-test-sort-column (of TableColumn DemoRecord)
  (param id String)
  (param title String)
  (param width TableWidth)
  (param align TableAlign)
  (param value (of TableTextProvider DemoRecord))
  (param sort-key (of TableTextProvider DemoRecord))
  (let column (call table-test-column id title width align value))
  (= (. column sort-key) sort-key)
  (return column)
)

(fn-expr + table-test-key String
  (param row DemoRecord)
  (. row id)
)

(fn-expr + table-test-pid String
  (param row DemoRecord)
  (str (. row pid))
)

(fn-expr + table-test-name String
  (param row DemoRecord)
  (. row name)
)

(fn-expr + table-test-score String
  (param row DemoRecord)
  (str (. row score))
)

(fn-expr + table-test-score-key String
  (param row DemoRecord)
  (str (. row score))
)

(type + TableTestHost (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This (• flex-col)
      (<> (of Table DemoRecord) (id: table) (• flex 1)
        (= columns (call table-test-columns))
        (= rows (call table-test-rows))
        (= key-builder table-test-key)
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + DemoRecord (is Tuple)
  (prop + id String)
  (prop + pid Int)
  (prop + name String)
  (prop + score Int)
)
