+ scroll-node-children
    - item ScrollNode

match item.id
    | "tree"
        * ScrollNode("root", "Root") • has children
    | "root"
        ** ScrollNode("leaf-${each}", "Leaf ${each}") in 1 .. 20
    ??
        List'ScrollNode()

