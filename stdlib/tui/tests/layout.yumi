+ do tui-dynamic-absolute-size-frame-tests TestCase
    - t TestCase

<TuiDynamicAbsoluteSizeFrameDemo demo

demo.markup-batch-queue.checkpoint()
demo.bounds = Rect(0, 0, 80, 24)
demo.update-layout()

for frame in 1 .. 2
    demo.advance-frame()
    demo.markup-batch-queue.checkpoint()
    demo.update-layout()
    t = expect-bounds
        - t
        - "dynamic absolute size frame $frame"
        - demo.overlay
        - demo.left
        - demo.top
        - 42
        - 14

= t

━━━━━━━━━━━━━━━━━━━━
+ do tui-hit-test-paint-order-tests TestCase
    - t TestCase

<TuiStyleDemo demo
    <Box under
    <Box over

demo.bounds = Rect(0, 0, 10, 5)
under.bounds = Rect(1, 1, 5, 3)
over.bounds = Rect(2, 1, 5, 3)

t = t.check("hit later painted overlapping sibling", demo.hit-test((3, 2)) == over)
t = t.check("hit earlier sibling outside overlap", demo.hit-test((1, 2)) == under)
t = t.check("hit parent outside children", demo.hit-test((9, 4)) as Pointer == demo as Pointer)

= t

━━━━━━━━━━━━━━━━━━━━
_ do expect-bounds TestCase
    - t TestCase
    - label String
    - box Box
    - x Coord
    - y Coord
    - width Coord
    - height Coord

t = t.expect("$label x", x, box.bounds.x)
t = t.expect("$label y", y, box.bounds.y)
t = t.expect("$label width", width, box.bounds.width)
t = t.expect("$label height", height, box.bounds.height)
= t

