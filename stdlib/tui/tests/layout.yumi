+ do tui-absolute-position-layout-tests TestCase
    - t TestCase

<TuiStyleDemo demo • flow-col border p:1
    <TextBox flow-a "a"
    <TextBox abs-left "absolute" • absolute m:1 p:1
        left = 2
        top = 1
    <TextBox abs-corner "xy" • absolute
        right = 3
        bottom = 2
    <Box abs-stretch • absolute m:1
        left = 1
        right = 2
        top = 0
        bottom = 3
    <Box abs-parent • absolute flex-col p:1
        left = 4
        right = 4
        top = 2
        bottom = 1
        <TextBox abs-child "z"
    <TextBox flow-b "bb"

demo.markup-batch-queue.checkpoint()
demo.bounds = Rect(0, 0, 20, 10)
demo.update-layout()

t = expect-bounds(t, "flow a unaffected", flow-a, 2, 2, 16, 1)
t = expect-bounds(t, "flow b unaffected", flow-b, 2, 3, 16, 1)
t = t.expect("flow inner width ignores absolutes", 2, demo.inner-width)
t = t.expect("flow inner height ignores absolutes", 2, demo.inner-height)

t = expect-bounds(t, "absolute left top outer margin", abs-left, 5, 4, 10, 3)
t = expect-bounds(t, "absolute right bottom", abs-corner, 13, 5, 2, 1)
t = expect-bounds(t, "absolute stretched margin box", abs-stretch, 4, 3, 11, 1)
t = expect-bounds(t, "absolute parent", abs-parent, 6, 4, 8, 3)
t = expect-bounds(t, "absolute child laid out", abs-child, 7, 5, 6, 1)

= t

━━━━━━━━━━━━━━━━━━━━
+ do tui-absolute-anchor-layout-tests TestCase
    - t TestCase

<TuiStyleDemo demo • flow-col border p:1
    <Box start-point • absolute
        left = .anchor-start
        top = .anchor-start
        width = 2
        height = 1
    <Box center-point • absolute
        left = .anchor-center
        top = .anchor-center
        width = 4
        height = 2
    <Box center-with-far-edge • absolute
        left = .anchor-center
        right = 0
        top = .anchor-center
        bottom = 0
        width = 4
        height = 2
    <Box end-point • absolute
        right = .anchor-end
        bottom = .anchor-end
        width = 3
        height = 2
    <Box percent-center • absolute
        left = 50%
        top = 50%
        width = 4
        height = 2
    <Box percent-end • absolute
        right = 100%
        bottom = 100%
        width = 2
        height = 1
    <Box margin-center • absolute
        left = .anchor-center
        top = .anchor-center
        margin-left = 2
        margin-top = 2
        width = 4
        height = 2

demo.markup-batch-queue.checkpoint()
demo.bounds = Rect(0, 0, 20, 10)
demo.update-layout()

t = expect-bounds(t, "anchor start", start-point, 2, 2, 2, 1)
t = expect-bounds(t, "anchor center", center-point, 8, 4, 4, 2)
t = expect-bounds(t, "anchor center beats far edge", center-with-far-edge, 8, 4, 4, 2)
t = expect-bounds(t, "anchor end", end-point, 15, 6, 3, 2)
t = expect-bounds(t, "percent center", percent-center, 8, 4, 4, 2)
t = expect-bounds(t, "percent end", percent-end, 16, 7, 2, 1)
t = expect-bounds(t, "margin offsets centered anchor", margin-center, 9, 5, 4, 2)

= t

