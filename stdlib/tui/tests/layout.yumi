tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("TUI Structural Content Invalidation")
cases.run(tui-structural-content-invalidation-tests)
cases = cases.then("TUI Transparent Markup Regions", tui-transparent-markup-region-tests)
cases = cases.then("TUI Flex Inner Size", tui-flex-inner-size-tests)
cases = cases.then("TUI Masonry Layout", tui-masonry-layout-tests)
cases = cases.then("TUI Flex Spacing Layout", tui-flex-spacing-layout-tests)
cases = cases.then("TUI Flow Spacing Layout", tui-flow-spacing-layout-tests)
cases = cases.then("TUI Box Measurement Protocol", tui-box-measurement-protocol-tests)
cases = cases.then("TUI Rich Text Measurement", tui-rich-text-measurement-tests)
cases = cases.then("TUI Absolute Position Layout", tui-absolute-position-layout-tests)
cases = cases.then("TUI Absolute Anchor Layout", tui-absolute-anchor-layout-tests)
cases = cases.then("TUI Dynamic Absolute Size Frames", tui-dynamic-absolute-size-frame-tests)
cases = cases.then("TUI Style Target Generated Content", tui-style-target-generated-content-tests)
cases = cases.then("TUI Hit Test Paint Order", tui-hit-test-paint-order-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do tui-structural-content-invalidation-tests TestCase
    - t TestCase

<TuiStyleDemo demo • flow-col
    <Box host • flow-col
        <TextBox first "a"
    <TextBox after "z"

demo.markup-batch-queue.checkpoint()
demo.bounds = Rect(0, 0, 10, 10)
demo.update-layout()

. added = TextBox("b")
markup-append(host, added)
demo.markup-batch-queue.checkpoint()
demo.update-layout()

t = t.expect("structural append updates host inner height", 2, host.inner-height)
t = t.expect("structural append updates parent inner height", 3, demo.inner-height)
t = expect-bounds(t, "structural append after", after, 0, 2, 10, 1)

= t

━━━━━━━━━━━━━━━━━━━━
+ do tui-transparent-markup-region-tests TestCase
    - t TestCase

<TuiTransparentRegionDemo demo • flex-row

markup-mount-root(demo, demo)
demo.markup-batch-queue.checkpoint()
demo.bounds = Rect(0, 0, 40, 4)
demo.invalidate-layout()
demo.update-layout()

. region = demo.%first-child!
. first = region.%first-child!
. second = region.child-at(1)
. branch = region.%next-sibling!
. preview = branch.%first-child!

t = expect-bounds(t, "transparent loop first", first, 0, 0, 10, 4)
t = expect-bounds(t, "transparent loop second", second!, 10, 0, 10, 4)
t = expect-bounds(t, "transparent branch preview", preview, 20, 0, 20, 4)

demo.insert-item()
demo.markup-batch-queue.checkpoint()
demo.update-layout()

. inserted = region.child-at(1)
. shifted = region.child-at(2)
t = expect-bounds(t, "transparent loop inserted", inserted!, 8, 0, 8, 4)
t = expect-bounds(t, "transparent loop shifted", shifted!, 16, 0, 8, 4)
t = expect-bounds(t, "transparent branch after insert", preview, 24, 0, 16, 4)
t = t.check("transparent region hit test", demo.hit-test((9, 1)) == inserted!)

= t

━━━━━━━━━━━━━━━━━━━━
+ do tui-flex-inner-size-tests TestCase
    - t TestCase

. overflow = FlexInnerTestHost(Orientation.horizontal)
markup-mount-root(overflow, overflow)
markup-append(overflow, FixedTextBox("a", 28))
markup-append(overflow, FixedTextBox("b", 28))
markup-append(overflow, FixedTextBox("c", 28))
overflow.markup-batch-queue.checkpoint()
overflow.bounds = Rect(0, 0, 60, 10)
overflow.update-layout()

t = t.expect("horizontal overflow inner width", 84, overflow.inner-width)

. underflow = FlexInnerTestHost(Orientation.horizontal)
markup-mount-root(underflow, underflow)
markup-append(underflow, FixedTextBox("a", 20))
markup-append(underflow, FixedTextBox("b", 20))
underflow.markup-batch-queue.checkpoint()
underflow.bounds = Rect(0, 0, 60, 10)
underflow.update-layout()

t = t.expect("horizontal underflow inner width", 40, underflow.inner-width)

. mixed = FlexInnerTestHost(Orientation.horizontal)
markup-mount-root(mixed, mixed)
. mixed-fixed = FixedTextBox("a", 10)
<Box mixed-flex • flex:1
. mixed-trailing = FixedTextBox("z", 10)
markup-append(mixed, mixed-fixed)
markup-append(mixed, mixed-flex)
markup-append(mixed, mixed-trailing)
mixed.markup-batch-queue.checkpoint()
mixed.bounds = Rect(0, 0, 60, 10)
mixed.update-layout()

t = expect-bounds(t, "mixed fixed", mixed-fixed, 0, 0, 10, 10)
t = expect-bounds(t, "mixed flex", mixed-flex, 10, 0, 40, 10)
t = expect-bounds(t, "mixed trailing", mixed-trailing, 50, 0, 10, 10)
t = t.expect("mixed inner width", 60, mixed.inner-width)

. filtered = FlexInnerTestHost(Orientation.horizontal)
markup-mount-root(filtered, filtered)
markup-append(filtered, FixedTextBox("v", 12))
markup-append(filtered, HiddenFixedTextBox("hidden", 30))
markup-append(filtered, AbsoluteFixedTextBox("absolute", 30))
filtered.markup-batch-queue.checkpoint()
filtered.bounds = Rect(0, 0, 60, 10)
filtered.update-layout()

t = t.expect("filtered inner width ignores inactive children", 12, filtered.inner-width)

. rounded = FlexInnerTestHost(Orientation.horizontal)
markup-mount-root(rounded, rounded)
<Box rounded-a • flex:1
<Box rounded-b • flex:1
<Box rounded-c • flex:1
. rounded-tail = FixedTextBox("z", 1)
markup-append(rounded, rounded-a)
markup-append(rounded, rounded-b)
markup-append(rounded, rounded-c)
markup-append(rounded, rounded-tail)
rounded.markup-batch-queue.checkpoint()
rounded.bounds = Rect(0, 0, 11, 4)
rounded.update-layout()

t = expect-bounds(t, "rounded first flex", rounded-a, 0, 0, 3, 4)
t = expect-bounds(t, "rounded second flex", rounded-b, 3, 0, 3, 4)
t = expect-bounds(t, "rounded remainder flex", rounded-c, 6, 0, 4, 4)
t = expect-bounds(t, "rounded trailing fixed", rounded-tail, 10, 0, 1, 4)

= t

