+ do tui-masonry-layout-tests TestCase
    - t TestCase

<TuiStyleDemo vertical • masonry-col masonry-cols:2
    <MasonryFixedBox va
        fixed-width = 3
        fixed-height = 3
    <MasonryFixedBox vb
        fixed-width = 3
        fixed-height = 2
    <MasonryFixedBox vc
        fixed-width = 3
        fixed-height = 2
    <MasonryFixedBox vd
        fixed-width = 3
        fixed-height = 1

vertical.markup-batch-queue.checkpoint()
vertical.bounds = Rect(0, 0, 10, 10)
vertical.update-layout()

t = expect-bounds(t, "masonry vertical a", va, 0, 0, 5, 3)
t = expect-bounds(t, "masonry vertical b", vb, 5, 0, 5, 2)
t = expect-bounds(t, "masonry vertical c", vc, 5, 2, 5, 2)
t = expect-bounds(t, "masonry vertical d", vd, 0, 3, 5, 1)
t = t.expect("masonry vertical inner width", 10, vertical.inner-width)
t = t.expect("masonry vertical inner height", 4, vertical.inner-height)

<TuiStyleDemo horizontal • masonry-row masonry-rows:2
    <MasonryFixedBox ha
        fixed-width = 4
        fixed-height = 1
    <MasonryFixedBox hb
        fixed-width = 2
        fixed-height = 1
    <MasonryFixedBox hc
        fixed-width = 3
        fixed-height = 1
    <MasonryFixedBox hd
        fixed-width = 1
        fixed-height = 1

horizontal.markup-batch-queue.checkpoint()
horizontal.bounds = Rect(0, 0, 12, 5)
horizontal.update-layout()

t = expect-bounds(t, "masonry horizontal a", ha, 0, 0, 4, 3)
t = expect-bounds(t, "masonry horizontal b", hb, 0, 3, 2, 2)
t = expect-bounds(t, "masonry horizontal c", hc, 2, 3, 3, 2)
t = expect-bounds(t, "masonry horizontal d", hd, 4, 0, 1, 3)
t = t.expect("masonry horizontal inner width", 5, horizontal.inner-width)
t = t.expect("masonry horizontal inner height", 5, horizontal.inner-height)

<TuiStyleDemo auto-count • masonry-col masonry-min-col:5
    <MasonryFixedBox auto-a
        fixed-width = 1
        fixed-height = 1
    <MasonryFixedBox auto-b
        fixed-width = 1
        fixed-height = 1
    <MasonryFixedBox auto-c
        fixed-width = 1
        fixed-height = 1

auto-count.markup-batch-queue.checkpoint()
auto-count.bounds = Rect(0, 0, 11, 10)
auto-count.update-layout()
t = expect-bounds(t, "masonry auto first resize a", auto-a, 0, 0, 6, 1)
t = expect-bounds(t, "masonry auto first resize b", auto-b, 6, 0, 5, 1)
t = expect-bounds(t, "masonry auto first resize c", auto-c, 0, 1, 6, 1)

auto-count.arrange-bounds(Rect(0, 0, 16, 10))
auto-count.update-layout()
t = expect-bounds(t, "masonry auto second resize a", auto-a, 0, 0, 6, 1)
t = expect-bounds(t, "masonry auto second resize b", auto-b, 6, 0, 5, 1)
t = expect-bounds(t, "masonry auto second resize c", auto-c, 11, 0, 5, 1)

<TuiStyleDemo gaps • masonry-col masonry-cols:2 masonry-col-gap:1 masonry-row-gap:1
    <MasonryFixedBox ga
        fixed-width = 1
        fixed-height = 3
    <MasonryFixedBox gb
        fixed-width = 1
        fixed-height = 1
    <MasonryFixedBox gc
        fixed-width = 1
        fixed-height = 1

gaps.markup-batch-queue.checkpoint()
gaps.bounds = Rect(0, 0, 9, 10)
gaps.update-layout()

t = expect-bounds(t, "masonry gap a", ga, 0, 0, 4, 3)
t = expect-bounds(t, "masonry gap b", gb, 5, 0, 4, 1)
t = expect-bounds(t, "masonry gap c", gc, 5, 2, 4, 1)
t = t.expect("masonry gap inner height", 3, gaps.inner-height)

<TuiStyleDemo rich-demo • masonry-col masonry-cols:1
    <MarkdownText masonry-rich "one two three four"
    <TextBox masonry-after "after"

rich-demo.markup-batch-queue.checkpoint()
rich-demo.bounds = Rect(0, 0, 5, 10)
rich-demo.update-layout()

t = t.expect("masonry rich text contributes wrapped height", 5, rich-demo.inner-height)
t = expect-bounds(t, "masonry rich following child", masonry-after, 0, 4, 5, 1)

= t

