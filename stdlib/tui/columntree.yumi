+ do restore-path Bool
    - keys [String]

if !keys
    reload-root()
    = false

clear-path()

. current-root = root-node
if !current-root
    = false

. items [Item]? = load-children(current-root)
if items == null
    = false

. key-prefix = ""
. depth Index = 0
while depth < keys.length
    . current-items = items
    . match-index = index-of-key(keys[depth], current-items, key-prefix)
    if match-index == null
        if depth == 0 && current-items
            path.append(current-items)
            focus-level(0)
        = false

    . item = current-items[match-index]
    path.append(current-items, match-index)
    key-prefix = keys[depth]
    depth += 1

    if depth < keys.length
        . child-items = load-children(item)
        if child-items == null
            focus-level(path.levels.length - 1)
            = false
        items = child-items

if path.levels
    focus-level(path.levels.length - 1)
= true

