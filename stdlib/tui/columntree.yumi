+ do refresh

. current-root = root-node
if !current-root || !path.levels
    reload-root()
    =

. held-active = path.active-index
. held-focus = active-column?.is-focused ?? false
. owner Item = current-root
. key-prefix = ""
. index Index = 0
while index < path.levels.length
    . level = path.levels[index]
    . items = load-children(owner) ?? List'Item()
    if !items
        if index == 0
            clear-path()
        else
            . ignored = truncate-path-after(index - 1)
        break

    . previous = level.selected-index
    . held = level.selected-item
    . found Index? = null
    if held
        found = index-of-key(key-for-item(held, key-prefix, previous), items, key-prefix)
    . lost = previous >= 0 && found == null
    . selected = -1
    if found != null
        selected = found
    else if lost
        selected = min(previous, (items.length as Int) - 1)
    if selected != previous || !column-tree-items-match'Item(level.items, items)
        path.replace(index, items, selected)
    if selected < 0
        break

    owner = items[selected]
    if lost
        . ignored = truncate-path-after(index)
        publish-selection()
    if lost || index + 1 == path.levels.length
        append-preview(index, owner)
        break
    key-prefix = key-for-item(owner, key-prefix, selected)
    index += 1

refresh-selected-item()
project-active-column()
if held-focus && path.levels && path.active-index != held-active
    focus-level(path.active-index)

