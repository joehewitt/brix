────────────────────
+ focus ~>

~> settled
~> waiting-for-level(i, id) for (i, id) on focus-requests

    then applying(i, id) if requested-column(i, id) != null

    then applying(i, id) on level-mounted when requested-column(i, id) != null

    then settled on path-shortened when path.level-id(i) != id

~> applying(i, id)
    do
        . column = requested-column(i, id)
        if column
            ancestor'Window?.focus(column)
            ensure-active-column-visible()
            publish-active-column-changed()

    then settled if true

────────────────────
+ scroll-into-view ~>

~> settled
~> waiting-for-layout(i, id) for (i, id) on scroll-requests
    then settled if requested-column-is-laid-out(i, id)
        do scroll-requested-column-into-view(i, id)

    then settled on laid-out when requested-column-is-laid-out(i, id)
        do scroll-requested-column-into-view(i, id)

    then settled on path-shortened when path.level-id(i) != id

