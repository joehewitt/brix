────────────────────
+ do clamp-scroll-after-layout

. layout = editor-layout(content-bounds.width, visible-text())
inner-width = layout.width
inner-height = layout.height
. caret = editor-caret-rect(layout)
. content-width = max(layout.width, (caret.right - content-bounds.x))
. next-x = clipped-editor-scroll-axis(scroll-x, content-bounds.width, content-width)
. next-y = clipped-editor-scroll-axis(scroll-y, content-bounds.height, layout.height)
. next = Point(next-x, next-y)
if next != Point(scroll-x, scroll-y)
    scroll(next)

