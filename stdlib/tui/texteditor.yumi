+ This
    - text String = ""

────────────────────
for event on key-input

if event.modifiers.control && event.char == 'a'
    select-all()
    event.cancel()
else if event.char >= ' ' && !event.modifiers.control && !event.modifiers.option && !event.modifiers.command
    insert-text(event.char as String)
    event.cancel()

────────────────────
for event on paste

insert-text(event.text)
event.cancel()

────────────────────
