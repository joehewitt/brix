────────────────────
+ do scroll-editor-caret-visible Bool
    - rect Rect
    - layout TextEditorLayout

. visible = editor-visible-content-bounds()
. next-x = scroll-x
. next-y = scroll-y

if visible.width > 0
    if rect.x + next-x < visible.x
        next-x = visible.x - rect.x
    else if rect.right + next-x > visible.right
        next-x = visible.right - rect.right
    . content-width = max(layout.width, (rect.right - content-bounds.x))
    next-x = clipped-editor-scroll-axis(next-x, visible.width, content-width)

if visible.height > 0
    if rect.y + next-y < visible.y
        next-y = visible.y - rect.y
    else if rect.bottom + next-y > visible.bottom
        next-y = visible.bottom - rect.bottom
    next-y = clipped-editor-scroll-axis(next-y, visible.height, layout.height)

. next = Point(next-x, next-y)
=? if next == Point(scroll-x, scroll-y)

scroll(next)
= true

