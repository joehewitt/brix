_ TextEditorLayout

+ source String
+ lines [TextEditorLine]
+ width Coord
+ wrap-width Coord
+ height => lines.length as Coord

────────────────────
+ This
    - source String
    - wrap-width Coord
    - should-wrap Bool

. display = DisplayText(source)
. line-start Index = 0
. line-width Coord = 0
. index Index = 0
. safe-wrap = max(1, wrap-width)

for char in source
    . char-width = display.width-at(index) as Coord
    if char == '\n'
        append-line(line-start, index, index + 1, line-width)
        index += 1
        line-start = index
        line-width = 0
    else
        if should-wrap && line-width > 0 && line-width + char-width > safe-wrap
            append-line(line-start, index, index, line-width)
            line-start = index
            line-width = 0
        line-width += char-width
        index += 1

append-line(line-start, index, index, line-width)

────────────────────
+ do append-line
    - start Index
    - text-end Index
    - end Index
    - line-width Coord

lines += TextEditorLine(start, text-end, end, line-width)
width = max(width, line-width)

────────────────────
+ do line-index-at Index
    - text-index Index

. safe-index = clipped-index(text-index, source.length)
. index Index = 0
while index < lines.length
    . line = lines[index]
    if safe-index >= line.start && (safe-index < line.end || index == lines.length - 1)
        = index
    index += 1

= lines.length - 1

────────────────────
+ caret-line-index Index
    - text-index Index
    - is-upstream Bool

|? !is-upstream || line-index == 0
    line-index
|? previous.text-end == text-index && previous.end == text-index
    line-index - 1
??
    line-index

.. line-index = line-index-at(text-index)
.. previous = lines[line-index - 1]

────────────────────
+ x-in-line Coord
    - line-index Index
    - text-index Index

DisplayText(source[line.start .. < end]).display-width as Coord

.. line = lines[line-index]
.. clipped = clipped-index(text-index, source.length)
.. line-clipped = max(line.start, clipped)
.. end = min(line.text-end, line-clipped)

────────────────────
+ do index-at Index
    - line-index Index
    - x Coord

. line = lines[clipped-index(line-index, lines.length - 1)]
. index = line.start
. current Coord = 0
while index < line.text-end
    . char-width = DisplayText(source[index] as String).display-width as Coord
    if current + char-width > x
        = index
    current += char-width
    index += 1

= line.text-end

