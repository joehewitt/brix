. cursor = selection.cursor
if cursor > 0
    delete-range(cursor - 1, cursor)

────────────────────
+ do delete-forward

if !selection.is-collapsed
    delete-selection()
    =
. cursor = selection.cursor
if cursor < text.length
    delete-range(cursor, cursor + 1)

