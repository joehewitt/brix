+ do is-editor-cursor-visible Bool

. visible = editor-visible-content-bounds()
=? if visible.width <= 0 || visible.height <= 0

. point = editor-cursor-point()
= within-x && point.y >= visible.y && point.y < visible.bottom
    .. within-x = point.x >= visible.x && point.x < visible.right

