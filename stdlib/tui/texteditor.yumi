────────────────────
+ do paint-lines
    - layout TextEditorLayout
    - canvas Canvas

. line-index Index = 0
for line in layout.lines
    . normal-color = if should-paint-placeholder() then placeholder-color else paint-text-color
    . start = max(selection.start, line.start)
    . end = min(selection.end, line.text-end)
    . y = content-bounds.y + (line-index as Coord)
    if selection.is-collapsed || should-paint-placeholder() || start >= end
        paint-line-segment(layout, line, line.start, line.text-end, normal-color, y, canvas)
    else
        paint-line-segment(layout, line, line.start, start, normal-color, y, canvas)
        paint-selected-line-segment(layout, line, start, end, normal-color, y, canvas)
        paint-line-segment(layout, line, end, line.text-end, normal-color, y, canvas)
    line-index += 1

