+ do paint-line-segment
    - layout TextEditorLayout
    - line TextEditorLine
    - start Index
    - end Index
    - color AnsiColor
    - y Coord
    - canvas Canvas

=? if start >= end

canvas.text-color = color
canvas.move((content-bounds.x + left, y))
canvas.print-display-text(DisplayText(layout.source[start .. < end]))

.. left = DisplayText(layout.source[line.start .. < start]).display-width as Coord

────────────────────
+ do paint-selected-line-segment
    - layout TextEditorLayout
    - line TextEditorLine
    - start Index
    - end Index
    - color AnsiColor
    - y Coord
    - canvas Canvas

=? if start >= end

canvas.text-color = color
. previous-background = canvas.background
canvas.background = selection-background
canvas.move((content-bounds.x + left, y))
canvas.print-display-text(DisplayText(layout.source[start .. < end]))
canvas.background = previous-background

.. left = DisplayText(layout.source[line.start .. < start]).display-width as Coord

────────────────────
+ do paint-selection
    - layout TextEditorLayout
    - canvas Canvas

=? if selection.is-collapsed
=? if should-paint-placeholder()

. line-index Index = 0
for line in layout.lines
    . start = max(selection.start, line.start)
    . end = min(selection.end, line.text-end)
    if start < end
        . left = DisplayText(layout.source[line.start .. < start]).display-width as Coord
        . right = DisplayText(layout.source[line.start .. < end]).display-width as Coord
        canvas.paint-background
            - selection-background
            - Rect
                - content-bounds.x + left
                - content-bounds.y + (line-index as Coord)
                - right - left
                - 1
    line-index += 1

────────────────────
+ handle-key-press Bool
    - event KeyPressEvent

match event.key
    |= Key.backspace
        delete-backward()
        true
    |= Key.delete
        delete-forward()
        true
    |= Key.arrow-left
        move-left(event-extend-selection(event), event-option(event))
        true
    |= Key.arrow-right
        move-right(event-extend-selection(event), event-option(event))
        true
    |= Key.home
        move-to-line-edge(false, event-extend-selection(event))
        true
    |= Key.end
        move-to-line-edge(true, event-extend-selection(event))
        true
    |= Key.arrow-up
        move-vertical(-1, event-extend-selection(event))
    |= Key.arrow-down
        move-vertical(1, event-extend-selection(event))
    |= Key.page-up
        move-page(-1, event-extend-selection(event))
    |= Key.page-down
        move-page(1, event-extend-selection(event))
    |= Key.enter
        handle-submit-key(event)
    ??
        false

────────────────────
+ do handle-submit-key Bool
    - event KeyPressEvent

if multiline && event-extend-selection(event)
    insert-text("\n")
else
    submit()
= true

────────────────────
+ do submit

submitted <- SubmitEvent()
ancestor'Form?.submit()

────────────────────
+ do insert-text
    - value String

. insert = normalized-insert-text(value)
=? if !insert

. start = selection.start
. end = selection.end
text = text[... start] ++ insert ++ text[end ...]
move-caret(start + insert.length)

────────────────────
+ normalized-insert-text
    - value String

** value
?> each != '\r'
*> match each
    |= '\n'
        if multiline then "\n" else " "
    ??
        each as String
|> "".join

