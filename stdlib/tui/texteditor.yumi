+ do move-vertical Bool
    - delta Int
    - extend-selection Bool

. layout = editor-layout(content-bounds.width, visible-text())
. line-index = caret-line-index(layout) as Int
. target-line = line-index + delta
=? if target-line < 0
=? if target-line >= layout.lines.length

. target = layout.index-at(target-line, caret-x(layout))
place-caret-on-line(target, target-line, layout, extend-selection)
= true

────────────────────
+ do move-page Bool
    - delta Int
    - extend-selection Bool

. visible-height = max(1, content-bounds.height)
. layout = editor-layout(content-bounds.width, visible-text())
. line-index = caret-line-index(layout) as Int
. target-line = line-index + delta * (visible-height as Int)
. last-line = (layout.lines.length - 1) as Int
. upper-line = min(target-line, last-line)
target-line = max(0, upper-line)
=? if target-line == line-index

. target = layout.index-at(target-line, caret-x(layout))
place-caret-on-line(target, target-line, layout, extend-selection)
= true

