super.emit-tui-box-node()

//this:tui.box.texteditor -> text, cursor-point.x, cursor-point.y

────────────────────
+ do paint
    - canvas Canvas

if !is-paint-visible
    did-paint()
    =
. source = paint-text()
. layout = editor-layout(content-bounds.width, source)
inner-width = layout.width
inner-height = layout.height

if is-focused
    ensure-caret-visible()

do use canvas
    paint-box-background(this, bounds, canvas)
    paint-box-border(this, bounds, canvas)

    canvas.clip(content-bounds)
    canvas.offset((scroll-x, scroll-y))
    paint-selection(layout, canvas)
    paint-lines(layout, canvas)

    for box in structural-children
        if paint-skip-compositing-layers && box.requires-compositing-layer
            continue
        box.paint(canvas)

did-paint()

