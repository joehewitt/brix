━━━━━━━━━━━━━━━━━━━━
• extend TUIDefaultTheme
    using BoxPaint
    using TextPaint

• ProgressBar
    • progress-fill
        background-color = AnsiColor(48)
        color = AnsiColor(255)

    • progress-empty
        background-color = AnsiColor(237)
        color = AnsiColor(8)

━━━━━━━━━━━━━━━━━━━━
+ ProgressBar is Box

+ value = 0
+ total Int? = 100
+ label = ""
+ bar-prefix = "["
+ bar-suffix = "]"
+ show-percent = true
+ interval = 120ms
+ fill-character = ""
+ empty-character = ""
+ progress = progress-position(#value, #total, #elapsed, #interval)

_ ticker = Timer(interval)
_ elapsed Microseconds

────────────────────

<This • h:1 flex-row
    <Label
        text = if #label then "${#label} " else ""

    <Label
        text = #bar-prefix

    + <Box track • flex:1 flex-row
        <ProgressBarSegment • progress-fill
            character = #fill-character
            flex = round(#progress * 100) as Flex
        <ProgressBarSegment • progress-empty
            character = #empty-character
            flex = 100 - round(#progress * 100) as Flex

    <Label
        text = #bar-suffix

    <Label
        text = progress-percent(#value, #total, #show-percent)

────────────────────
for tick on ticker whenever (#total ?? 0) <= 0

elapsed = tick

╌╌╌╌╌╌╌╌╌╌ is MarkupHost ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do close

super.close()
ticker.end-using()

━━━━━━━━━━━━━━━━━━━━
_ progress-position Float
    - value Int
    - total Int?
    - elapsed Microseconds
    - interval Microseconds

|? total && total > 0
    progress-fraction(value, total)
|? interval <= 0
    0
??
    ((((elapsed / interval) as Int) * 7) % 101) / 100.0

━━━━━━━━━━━━━━━━━━━━
_ progress-fraction Float
    - value Int
    - total Int

(min(total, max(0, value)) as Float) / total

━━━━━━━━━━━━━━━━━━━━
_ progress-percent String
    - value Int
    - total Int?
    - visible Bool

|? !visible || !total || total <= 0
    ""
??
    "${" " * max(1, 4 - text.length)}$text%"

.. text = (round(progress-fraction(value, total) * 100) as Int) as String

━━━━━━━━━━━━━━━━━━━━
+ ProgressBarSegment is Box

+ character = ""

────────────────────

<This • h:1 flex-row
    <Label
        text = progress-repeat-character(#character)

