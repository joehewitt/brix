(import ./box)
(import ./button)
(import ./canvas)
(import ./colors)
(import ./events)
(import ./form)
(import ./layout)
(import ./primitives)
(import ./shortcuts)
(import ./styles)
(import ./text)
(import ./theme)
(import ./window)
(import /math)
(import /ui/input)
(import /units)

(style-extend TUIDefaultTheme
  (using BoxPaint)
  (using TextPaint)
  (using BoxSpacing)
  (rule DialogButton
    (= background-color (call AnsiColor 12))
    (blank)
    (when-style #is-focused
      (= color (call AnsiColor 0))
      (= background-color (call AnsiColor 14))
    )
    (when-style #is-hovered
      (= color (call AnsiColor 255))
      (= background-color (call AnsiColor 7))
    )
    (when-style #is-pressed
      (= color (call AnsiColor 255))
      (= background-color (call AnsiColor 12))
    )
    (when-style (not #is-effectively-enabled)
      (= color (call AnsiColor 8))
      (= background-color (call AnsiColor 0))
    )
  )
  (blank)
  (rule ModalBackdrop
    (= background-color (call AnsiColor 0))
    (= opacity backdrop-opacity)
  )
  (blank)
  (rule ModalDialog
    (rule dialog-panel
      (= background-color (call AnsiColor 8))
    )
    (blank)
    (rule dialog-title
      (= background-color (call AnsiColor 12))
      (= color (call AnsiColor 255))
    )
    (blank)
    (rule dialog-body
      (= background-color (call AnsiColor 8))
      (= padding-top 1)
      (= padding-right 1)
      (= padding-bottom 1)
      (= padding-left 1)
    )
    (blank)
    (rule dialog-actions
      (= background-color (call AnsiColor 8))
    )
    (blank)
    (rule dialog-button
      (= background-color (call AnsiColor 12))
    )
    (blank)
    (rule cancel-button
      (= margin-right 1)
    )
  )
)

(type + ModalDialog (is Form)
  (rule This
    (= focus-mode (. FocusMode inside))
  )
  (blank)
  (prop + title _ (= "Dialog"))
  (event + accepted DialogAcceptEvent)
  (event + canceled DialogCancelEvent)
  (event + dismissed DialogDismissEvent)
  (prop + is-modal-root _ (=> true))
  (content
    (<> This (• absolute) (• cover .screen)
      (<> ModalBackdrop)
      (blank)
      (<> DialogPanel (• dialog-panel) (• absolute) (• center .parent)
        (= title #title)
        (blank)
        (+<> Box (id: body) (• dialog-body) (• flex 1) (• flex-col)
          (<> Box)
        )
        (blank)
        (+<> Box (id: actions) (• dialog-actions) (• flex-row)
          (<> Box)
        )
      )
      (blank)
      (<> Shortcut (text: "Cancel")
        (= key .escape)
        (= action (=> () :do (call cancel)))
      )
      (blank)
      (<> Shortcut (text: "Accept")
        (= key .enter)
        (= when (=> () (not (call has-focused-button))))
        (= action (=> () :do (call accept)))
      )
    )
  )
  (subscribe-for (on event submitted)
    (call accept)
    (call (. event cancel))
  )
  (fn-do + emit-tui-box-node _
    (call (. super emit-tui-box-node))
    (blank)
    (probe-log (: this tui.dialog) (items: title))
  )
  (fn-do + accept _
    (<- accepted (call DialogAcceptEvent))
    (call dismiss)
  )
  (fn-do + cancel _
    (<- canceled (call DialogCancelEvent))
    (call dismiss)
  )
  (fn-do + dismiss _
    (<- dismissed (call DialogDismissEvent))
  )
  (fn-expr _ has-focused-button Bool
    (case? (not focused)
      false
    )
    (default
      (is focused Button)
    )
    (where
      (lazy focused (?. (of ancestor Window) focused-box))
    )
  )
)

(type + DialogPanel (is Box)
  (prop + title _ (= "Dialog"))
  (blank)
  (rule This
    (= layout flex-col)
  )
  (content
    (<> Label (• dialog-title)
      (= text (str " " #title))
    )
  )
)

(type + DialogButton (is Button)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
)

(type + AlertDialog (is ModalDialog)
  (prop + message _ (= ""))
  (prop + title _ (= "Alert"))
  (content
    (<> Box (slot: body)
      (<> Label (text: (str " " message)))
    )
    (blank)
    (<> Box (slot: actions)
      (<> Box (• flex 1))
      (<> DialogButton (id: ok-button) (text: " OK ") (• dialog-button))
    )
  )
  (subscribe-for (on event (. ok-button click) (when (. ok-button is-effectively-enabled)))
    (call accept)
    (call (. event cancel))
  )
)

(type + ConfirmDialog (is ModalDialog)
  (prop + message _ (= ""))
  (content
    (<> This
      (= title "Confirm")
      (blank)
      (<> Box (slot: body)
        (<> Label (text: (str " " message)))
      )
      (blank)
      (<> Box (slot: actions)
        (<> Box (• flex 1))
        (<> DialogButton (id: cancel-button) (text: " Cancel ") (• dialog-button))
        (blank)
        (<> DialogButton (id: ok-button) (text: " OK ") (• dialog-button))
      )
    )
  )
  (subscribe-for (on event (. cancel-button click) (when (. cancel-button is-effectively-enabled)))
    (call cancel)
    (call (. event cancel))
  )
  (subscribe-for (on event (. ok-button click) (when (. ok-button is-effectively-enabled)))
    (call accept)
    (call (. event cancel))
  )
)

(type + ModalBackdrop (is Box)
  (rule This (• absolute) (• inset 0))
)
