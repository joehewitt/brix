(import ./border)
(import ./box)
(import ./canvas)
(import ./colors)
(import ./events)
(import ./form)
(import ./painter)
(import ./primitives)
(import ./styles)
(import ./theme)
(import /math)
(import /ui/input)
(blank)
(type-line _ TextEditorLine (is (tuple (: start Index) (: text-end Index) (: end Index) (: width Coord))))

(style-extend TUIDefaultTheme
  (using BoxPaint)
  (using TextPaint)
  (rule TextEditor
    (= background-color (call AnsiColor 0))
    (blank)
    (when-style #is-focused
      (= background-color (call AnsiColor 4))
    )
    (when-style (not #is-effectively-enabled)
      (= color (call AnsiColor 8))
      (= background-color (call AnsiColor 0))
    )
  )
)

(type + TextEditor (is Box)
  (rule This
    (= focus-mode (. FocusMode input))
  )
  (blank)
  (prop + text String (= ""))
  (prop + placeholder String)
  (prop + multiline _ (= false))
  (prop + wrap _ (= (. TextEditorWrap auto)))
  (prop + selection _ (= (call TextSelection 0 0)))
  (prop + mask (? Char))
  (prop + preferred-wrap-width Coord (= 80))
  (prop + placeholder-color AnsiColor (= midgray))
  (prop + selection-background BackgroundColor (= blue))
  (event + submitted SubmitEvent)
  (prop + cursor-point _ (=> (call editor-cursor-point)))
  (prop + shows-terminal-cursor _ (=> (and (== $focus-mode (. FocusMode input)) (or (not multiline) (not has-vertical-overflow) (call is-editor-cursor-visible)))))
  (blank)
  (prop _ is-caret-upstream _ (= false))
  (blank)
  (depends invalidate-content-size text placeholder multiline wrap mask preferred-wrap-width)
  (depends invalidate-paint text placeholder selection mask placeholder-color selection-background)
  (fn-do + This _
    (param text String (= ""))
  )
  (subscribe-for (on event key-input)
    (if (and (. event modifiers control) (== (. event char) 'a'))
      (call select-all)
      (call (. event cancel))
      (else-if (and (>= (. event char) (char " ")) (not (. event modifiers control)) (not (. event modifiers option)) (not (. event modifiers command)))
        (call insert-text (as (. event char) String))
        (call (. event cancel))
      )
    )
  )
  (subscribe-for (on event paste)
    (call insert-text (. event text))
    (call (. event cancel))
  )
  (subscribe-for (on event key-press)
    (if (call handle-key-press event)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event mouse-down (when is-effectively-enabled))
    (call place-caret-at-point (. event point) false)
  )
  (subscribe-for (on event mouse-drag (when is-effectively-enabled))
    (call place-caret-at-point (. event point) true)
    (call (. event cancel))
  )
  (whenever-rule #text
    (= is-caret-upstream false)
    (let clipped (call clipped-selection selection))
    (if (!= selection clipped)
      (= selection clipped)
    )
  )
  (fn-expr + measured-content-size PSize
    (param query MeasureQuery)
    (call PSize (. layout width) (. layout height))
    (where
      (lazy layout (call editor-layout (call measure-width query) (call paint-text)))
    )
  )
  (fn-do + clamp-scroll-after-layout _
    (let layout (call editor-layout (. content-bounds width) (call visible-text)))
    (= inner-width (. layout width))
    (= inner-height (. layout height))
    (let caret (call editor-caret-rect layout))
    (let content-width (call max (. layout width) (- (. caret right) (. content-bounds x))))
    (let next-x (call clipped-editor-scroll-axis scroll-x (. content-bounds width) content-width))
    (let next-y (call clipped-editor-scroll-axis scroll-y (. content-bounds height) (. layout height)))
    (let next (call Point next-x next-y))
    (if (!= next (call Point scroll-x scroll-y))
      (call scroll next)
    )
  )
  (fn-do + emit-tui-box-node _
    (call (. super emit-tui-box-node))
    (blank)
    (probe-log (: this tui.box.texteditor) (items: text (. cursor-point x) (. cursor-point y)))
  )
  (fn-do + paint _
    (param canvas Canvas)
    (if (not is-paint-visible)
      (call did-paint)
      (return)
    )
    (let source (call paint-text))
    (let layout (call editor-layout (. content-bounds width) source))
    (= inner-width (. layout width))
    (= inner-height (. layout height))
    (blank)
    (if is-focused
      (call ensure-caret-visible)
    )
    (blank)
    (do-use canvas
      (call paint-box-background this bounds canvas)
      (call paint-box-border this bounds canvas)
      (blank)
      (call (. canvas clip) content-bounds)
      (call (. canvas offset) (tuple scroll-x scroll-y))
      (call paint-selection layout canvas)
      (call paint-lines layout canvas)
      (blank)
      (for (in box structural-children)
        (if (and paint-skip-compositing-layers (. box requires-compositing-layer))
          (continue)
        )
        (call (. box paint) canvas)
      )
    )
    (blank)
    (call did-paint)
  )
  (fn-expr + visible-text String
    (case? mask
      (* (as mask String) (. text length))
    )
    (default
      text
    )
  )
  (fn-expr + paint-text String
    (case? (call should-paint-placeholder)
      placeholder
    )
    (default
      (call visible-text)
    )
  )
  (fn-expr + should-paint-placeholder Bool
    (and (not text) placeholder)
  )
  (fn-expr + uses-soft-wrap Bool
    (and multiline (or (== wrap (. TextEditorWrap auto)) (== wrap (. TextEditorWrap soft))))
  )
  (fn-expr + editor-layout TextEditorLayout
    (param width Coord)
    (param source String)
    (call TextEditorLayout source (call editor-wrap-width width) (call uses-soft-wrap))
  )
  (fn-expr + editor-wrap-width Coord
    (param width Coord)
    (call max 1 candidate)
    (where
      (lazy candidate (if-expr (> width 0) width preferred-wrap-width))
    )
  )
  (fn-expr + intrinsic-size _
    (call padded-size (call measured-content-size (call measure-fit-query preferred-wrap-width)))
  )
  (fn-expr + measure-width Coord
    (param query MeasureQuery)
    (call max 1 candidate)
    (where
      (lazy candidate (?? (. query inline available) (. query inline max) preferred-wrap-width))
    )
  )
  (fn-do + paint-lines _
    (param layout TextEditorLayout)
    (param canvas Canvas)
    (let line-index Index 0)
    (for (in line (. layout lines))
      (let normal-color (if-expr (call should-paint-placeholder) placeholder-color paint-text-color))
      (let start (call max (. selection start) (. line start)))
      (let end (call min (. selection end) (. line text-end)))
      (let y (+ (. content-bounds y) (as line-index Coord)))
      (if (or (. selection is-collapsed) (call should-paint-placeholder) (>= start end))
        (call paint-line-segment layout line (. line start) (. line text-end) normal-color y canvas)
        (else
          (call paint-line-segment layout line (. line start) start normal-color y canvas)
          (call paint-selected-line-segment layout line start end normal-color y canvas)
          (call paint-line-segment layout line end (. line text-end) normal-color y canvas)
        )
      )
      (+= line-index 1)
    )
  )
  (fn-do + paint-line-segment _
    (param layout TextEditorLayout)
    (param line TextEditorLine)
    (param start Index)
    (param end Index)
    (param color AnsiColor)
    (param y Coord)
    (param canvas Canvas)
    (return-if (if (>= start end)))
    (blank)
    (= (. canvas text-color) color)
    (call (. canvas move) (tuple (+ (. content-bounds x) left) y))
    (call (. canvas print-display-text) (call DisplayText ([] (. layout source) (..< start end))))
    (blank)
    (lazy left (as (. (call DisplayText ([] (. layout source) (..< (. line start) start))) display-width) Coord))
  )
  (fn-do + paint-selected-line-segment _
    (param layout TextEditorLayout)
    (param line TextEditorLine)
    (param start Index)
    (param end Index)
    (param color AnsiColor)
    (param y Coord)
    (param canvas Canvas)
    (return-if (if (>= start end)))
    (blank)
    (= (. canvas text-color) color)
    (let previous-background (. canvas background))
    (= (. canvas background) selection-background)
    (call (. canvas move) (tuple (+ (. content-bounds x) left) y))
    (call (. canvas print-display-text) (call DisplayText ([] (. layout source) (..< start end))))
    (= (. canvas background) previous-background)
    (blank)
    (lazy left (as (. (call DisplayText ([] (. layout source) (..< (. line start) start))) display-width) Coord))
  )
  (fn-do + paint-selection _
    (param layout TextEditorLayout)
    (param canvas Canvas)
    (return-if (if (. selection is-collapsed)))
    (return-if (if (call should-paint-placeholder)))
    (blank)
    (let line-index Index 0)
    (for (in line (. layout lines))
      (let start (call max (. selection start) (. line start)))
      (let end (call min (. selection end) (. line text-end)))
      (if (< start end)
        (let left (as (. (call DisplayText ([] (. layout source) (..< (. line start) start))) display-width) Coord))
        (let right (as (. (call DisplayText ([] (. layout source) (..< (. line start) end))) display-width) Coord))
        (call (. canvas paint-background)
          (block
            (arg selection-background)
            (arg
              (call Rect
                (block
                  (arg (+ (. content-bounds x) left))
                  (arg (+ (. content-bounds y) (as line-index Coord)))
                  (arg (- right left))
                  (arg 1)
                )
              )
            )
          )
        )
      )
      (+= line-index 1)
    )
  )
  (fn-expr + handle-key-press Bool
    (param event KeyPressEvent)
    (match (. event key)
      (case= (. Key backspace)
        (call delete-backward)
        true
      )
      (case= (. Key delete)
        (call delete-forward)
        true
      )
      (case= (. Key arrow-left)
        (call move-left (call event-extend-selection event) (call event-option event))
        true
      )
      (case= (. Key arrow-right)
        (call move-right (call event-extend-selection event) (call event-option event))
        true
      )
      (case= (. Key home)
        (call move-to-line-edge false (call event-extend-selection event))
        true
      )
      (case= (. Key end)
        (call move-to-line-edge true (call event-extend-selection event))
        true
      )
      (case= (. Key arrow-up)
        (call move-vertical -1 (call event-extend-selection event))
      )
      (case= (. Key arrow-down)
        (call move-vertical 1 (call event-extend-selection event))
      )
      (case= (. Key page-up)
        (call move-page -1 (call event-extend-selection event))
      )
      (case= (. Key page-down)
        (call move-page 1 (call event-extend-selection event))
      )
      (case= (. Key enter)
        (call handle-submit-key event)
      )
      (default
        false
      )
    )
  )
  (fn-do + handle-submit-key Bool
    (param event KeyPressEvent)
    (if (and multiline (call event-extend-selection event))
      (call insert-text "\n")
      (else
        (call submit)
      )
    )
    (return true)
  )
  (fn-do + submit _
    (<- submitted (call SubmitEvent))
    (call (?. (of ancestor Form) submit))
  )
  (fn-do + insert-text _
    (param value String)
    (let insert (call normalized-insert-text value))
    (return-if (if (not insert)))
    (blank)
    (let start (. selection start))
    (let end (. selection end))
    (= text (++ ([] text (... _ start)) insert ([] text (... end))))
    (call move-caret (+ start (. insert length)))
  )
  (fn-expr + normalized-insert-text _
    (param value String)
    (spread value)
    (pipe ?> (!= each (char "\r")))
    (pipe *>
      (match each
        (case= (char "\n")
          (if-expr multiline "\n" " ")
        )
        (default
          (as each String)
        )
      )
    )
    (pipe |> (. "" join))
  )
  (fn-do + delete-backward _
    (if (not (. selection is-collapsed))
      (call delete-selection)
      (return)
    )
    (let cursor (. selection cursor))
    (if (> cursor 0)
      (call delete-range (- cursor 1) cursor)
    )
  )
  (fn-do + delete-forward _
    (if (not (. selection is-collapsed))
      (call delete-selection)
      (return)
    )
    (let cursor (. selection cursor))
    (if (< cursor (. text length))
      (call delete-range cursor (+ cursor 1))
    )
  )
  (fn-do + delete-selection _
    (call delete-range (. selection start) (. selection end))
  )
  (fn-do + delete-range _
    (param start Index)
    (param end Index)
    (return-if (if (>= start end)))
    (blank)
    (= text (++ ([] text (... _ start)) ([] text (... end))))
    (call move-caret start)
  )
  (fn-do + select-all _
    (= selection (call TextSelection 0 (. text length)))
    (= is-caret-upstream false)
    (call invalidate-paint)
  )
  (fn-do + move-left _
    (param extend-selection Bool)
    (param by-word Bool)
    (let target (if-expr by-word (call word-left (. selection cursor)) (. selection cursor)))
    (if (and (not by-word) (> target 0))
      (-= target 1)
    )
    (if (and (not extend-selection) (not (. selection is-collapsed)) (not by-word))
      (= target (. selection start))
    )
    (call move-caret target extend-selection)
  )
  (fn-do + move-right _
    (param extend-selection Bool)
    (param by-word Bool)
    (let target (if-expr by-word (call word-right (. selection cursor)) (+ (. selection cursor) 1)))
    (if (and (not extend-selection) (not (. selection is-collapsed)) (not by-word))
      (= target (. selection end))
    )
    (call move-caret target extend-selection)
  )
  (fn-do + move-to-line-edge _
    (param is-end Bool)
    (param extend-selection Bool)
    (let layout (call editor-layout (. content-bounds width) (call visible-text)))
    (let line-index (call caret-line-index layout))
    (let line ([] (. layout lines) line-index))
    (let target (if-expr is-end (. line text-end) (. line start)))
    (call place-caret-on-line target line-index layout extend-selection)
  )
  (fn-do + move-vertical Bool
    (param delta Int)
    (param extend-selection Bool)
    (let layout (call editor-layout (. content-bounds width) (call visible-text)))
    (let line-index (as (call caret-line-index layout) Int))
    (let target-line (+ line-index delta))
    (return-if (if (< target-line 0)))
    (return-if (if (>= target-line (. layout lines length))))
    (blank)
    (let target (call (. layout index-at) target-line (call caret-x layout)))
    (call place-caret-on-line target target-line layout extend-selection)
    (return true)
  )
  (fn-do + move-page Bool
    (param delta Int)
    (param extend-selection Bool)
    (let visible-height (call max 1 (. content-bounds height)))
    (let layout (call editor-layout (. content-bounds width) (call visible-text)))
    (let line-index (as (call caret-line-index layout) Int))
    (let target-line (+ line-index (* delta (as visible-height Int))))
    (let last-line (as (- (. layout lines length) 1) Int))
    (let upper-line (call min target-line last-line))
    (= target-line (call max 0 upper-line))
    (return-if (if (== target-line line-index)))
    (blank)
    (let target (call (. layout index-at) target-line (call caret-x layout)))
    (call place-caret-on-line target target-line layout extend-selection)
    (return true)
  )
  (fn-do + move-caret _
    (param target Index)
    (param is-extending Bool (= false))
    (call place-caret target is-extending false)
  )
  (fn-do _ place-caret _
    (param target Index)
    (param is-extending Bool)
    (param is-upstream Bool)
    (let next (call clipped-index target (. text length)))
    (if is-extending
      (= selection (call TextSelection (. selection anchor) next))
      (else
        (= selection (call TextSelection next next))
      )
    )
    (= is-caret-upstream is-upstream)
    (call ensure-caret-visible)
    (call invalidate-paint)
  )
  (fn-do _ place-caret-on-line _
    (param target Index)
    (param line-index Index)
    (param layout TextEditorLayout)
    (param is-extending Bool)
    (call place-caret target is-extending (!= (call (. layout line-index-at) target) line-index))
  )
  (fn-do _ place-caret-at-point _
    (param point Point)
    (param is-extending Bool)
    (let layout (call editor-layout (. content-bounds width) (call visible-text)))
    (let line-index (call point-line-index point layout))
    (let target (call (. layout index-at) line-index (call point-text-x point)))
    (call place-caret-on-line target line-index layout is-extending)
  )
  (fn-do + point-line-index Index
    (param point Point)
    (param layout TextEditorLayout)
    (let y (as (- (. point y) (. content-bounds y) scroll-y) Int))
    (let last (as (- (. layout lines length) 1) Int))
    (return clipped)
    (blank)
    (lazy clipped (call min last (call max 0 y)))
  )
  (fn-expr + point-text-x Coord
    (param point Point)
    (- (. point x) (. content-bounds x) scroll-x)
  )
  (fn-do + word-left Index
    (param cursor Index)
    (return-if 0 (if mask))
    (blank)
    (let index (call clipped-index cursor (. text length)))
    (while (and (> index 0) (call text-editor-word-separator ([] text (- index 1))))
      (-= index 1)
    )
    (while (and (> index 0) (not (call text-editor-word-separator ([] text (- index 1)))))
      (-= index 1)
    )
    (return index)
  )
  (fn-do + word-right Index
    (param cursor Index)
    (return-if (. text length) (if mask))
    (blank)
    (let index (call clipped-index cursor (. text length)))
    (while (and (< index (. text length)) (call text-editor-word-separator ([] text index)))
      (+= index 1)
    )
    (while (and (< index (. text length)) (not (call text-editor-word-separator ([] text index))))
      (+= index 1)
    )
    (return index)
  )
  (fn-expr + clipped-selection TextSelection
    (param value TextSelection)
    (call TextSelection (call clipped-index (. value anchor) (. text length)) (call clipped-index (. value cursor) (. text length)))
  )
  (fn-do + ensure-caret-visible _
    (let layout (call editor-layout (. content-bounds width) (call visible-text)))
    (= inner-width (. layout width))
    (= inner-height (. layout height))
    (return (call scroll-editor-caret-visible (call editor-caret-rect layout) layout))
  )
  (fn-do + scroll-editor-caret-visible Bool
    (param rect Rect)
    (param layout TextEditorLayout)
    (let visible (call editor-visible-content-bounds))
    (let next-x scroll-x)
    (let next-y scroll-y)
    (blank)
    (if (> (. visible width) 0)
      (if (< (+ (. rect x) next-x) (. visible x))
        (= next-x (- (. visible x) (. rect x)))
        (else-if (> (+ (. rect right) next-x) (. visible right))
          (= next-x (- (. visible right) (. rect right)))
        )
      )
      (let content-width (call max (. layout width) (- (. rect right) (. content-bounds x))))
      (= next-x (call clipped-editor-scroll-axis next-x (. visible width) content-width))
    )
    (blank)
    (if (> (. visible height) 0)
      (if (< (+ (. rect y) next-y) (. visible y))
        (= next-y (- (. visible y) (. rect y)))
        (else-if (> (+ (. rect bottom) next-y) (. visible bottom))
          (= next-y (- (. visible bottom) (. rect bottom)))
        )
      )
      (= next-y (call clipped-editor-scroll-axis next-y (. visible height) (. layout height)))
    )
    (blank)
    (let next (call Point next-x next-y))
    (return-if (if (== next (call Point scroll-x scroll-y))))
    (blank)
    (call scroll next)
    (return true)
  )
  (fn-do + editor-visible-content-bounds Rect
    (let visible content-bounds)
    (for (in ancestor ancestors)
      (if (. ancestor is-markup-shadow)
        (continue)
      )
      (= visible (call text-editor-rect-intersection visible (. ancestor content-bounds)))
    )
    (blank)
    (return visible)
  )
  (fn-expr + clipped-editor-scroll-axis Coord
    (param requested Coord)
    (param visible-size Coord)
    (param content-size Coord)
    (call min 0 lower-clipped)
    (where
      (lazy lower-clipped
        (call max scroll-min requested
          (block
            (lazy scroll-min (call min 0 (- visible-size content-size)))
          )
        )
      )
    )
  )
  (fn-do + is-editor-cursor-visible Bool
    (let visible (call editor-visible-content-bounds))
    (return-if (if (or (<= (. visible width) 0) (<= (. visible height) 0))))
    (blank)
    (let point (call editor-cursor-point))
    (return
      (scope (and within-x (>= (. point y) (. visible y)) (< (. point y) (. visible bottom)))
        (lazy within-x (and (>= (. point x) (. visible x)) (< (. point x) (. visible right))))
      )
    )
  )
  (fn-expr + editor-cursor-point Point
    (call Point (+ (. content-bounds x) (. caret x) scroll-x) (+ (. content-bounds y) (. caret y) scroll-y))
    (where
      (lazy caret (call caret-display-point (call editor-layout (. content-bounds width) (call visible-text))))
    )
  )
  (fn-expr + editor-caret-rect Rect
    (param layout TextEditorLayout)
    (call Rect (+ (. content-bounds x) (. caret x)) (+ (. content-bounds y) (. caret y)) 1 1)
    (where
      (lazy caret (call caret-display-point layout))
    )
  )
  (fn-expr + caret-line-index Index
    (param layout TextEditorLayout)
    (call (. layout caret-line-index) (. selection cursor) is-caret-upstream)
  )
  (fn-expr + caret-x Coord
    (param layout TextEditorLayout)
    (call (. layout x-in-line) (call caret-line-index layout) (. selection cursor))
  )
  (fn-expr + caret-display-point Point
    (param layout TextEditorLayout)
    (case? (and (!= line-index row-start-line) (>= x (. layout wrap-width)))
      (call Point 0 (as row-start-line Coord))
    )
    (default
      (call Point x (as line-index Coord))
    )
    (where
      (lazy line-index (call caret-line-index layout))
      (lazy row-start-line (call (. layout line-index-at) (. selection cursor)))
      (lazy x (call caret-x layout))
    )
  )
)

(type + TextEditorWrap (is Union)
  (variant auto)
  (variant none)
  (variant soft)
)

(type + TextSelection (is (tuple (: anchor Index) (: cursor Index)))
  (fn-expr + start _ :get
    (call min anchor cursor)
  )
  (fn-expr + end _ :get
    (call max anchor cursor)
  )
  (fn-expr + is-collapsed _ :get
    (== anchor cursor)
  )
)

(type _ TextEditorLayout
  (prop + source String)
  (prop + lines (list TextEditorLine))
  (prop + width Coord)
  (prop + wrap-width Coord)
  (prop + height _ (=> (as (. lines length) Coord)))
  (fn-do + This _
    (param source String)
    (param wrap-width Coord)
    (param should-wrap Bool)
    (let display (call DisplayText source))
    (let line-start Index 0)
    (let line-width Coord 0)
    (let index Index 0)
    (let safe-wrap (call max 1 wrap-width))
    (blank)
    (for (in char source)
      (let char-width (as (call (. display width-at) index) Coord))
      (if (== char (char "\n"))
        (call append-line line-start index (+ index 1) line-width)
        (+= index 1)
        (= line-start index)
        (= line-width 0)
        (else
          (if (and should-wrap (> line-width 0) (> (+ line-width char-width) safe-wrap))
            (call append-line line-start index index line-width)
            (= line-start index)
            (= line-width 0)
          )
          (+= line-width char-width)
          (+= index 1)
        )
      )
    )
    (blank)
    (call append-line line-start index index line-width)
  )
  (fn-do + append-line _
    (param start Index)
    (param text-end Index)
    (param end Index)
    (param line-width Coord)
    (+= lines (call TextEditorLine start text-end end line-width))
    (= width (call max width line-width))
  )
  (fn-do + line-index-at Index
    (param text-index Index)
    (let safe-index (call clipped-index text-index (. source length)))
    (let index Index 0)
    (while (< index (. lines length))
      (let line ([] lines index))
      (if (and (>= safe-index (. line start)) (or (< safe-index (. line end)) (== index (- (. lines length) 1))))
        (return index)
      )
      (+= index 1)
    )
    (blank)
    (return (- (. lines length) 1))
  )
  (fn-expr + caret-line-index Index
    (param text-index Index)
    (param is-upstream Bool)
    (case? (or (not is-upstream) (== line-index 0))
      line-index
    )
    (case? (and (== (. previous text-end) text-index) (== (. previous end) text-index))
      (- line-index 1)
    )
    (default
      line-index
    )
    (where
      (lazy line-index (call line-index-at text-index))
      (lazy previous ([] lines (- line-index 1)))
    )
  )
  (fn-expr + x-in-line Coord
    (param line-index Index)
    (param text-index Index)
    (as (. (call DisplayText ([] source (..< (. line start) end))) display-width) Coord)
    (where
      (lazy line ([] lines line-index))
      (lazy clipped (call clipped-index text-index (. source length)))
      (lazy line-clipped (call max (. line start) clipped))
      (lazy end (call min (. line text-end) line-clipped))
    )
  )
  (fn-do + index-at Index
    (param line-index Index)
    (param x Coord)
    (let line ([] lines (call clipped-index line-index (- (. lines length) 1))))
    (let index (. line start))
    (let current Coord 0)
    (while (< index (. line text-end))
      (let char-width (as (. (call DisplayText (as ([] source index) String)) display-width) Coord))
      (if (> (+ current char-width) x)
        (return index)
      )
      (+= current char-width)
      (+= index 1)
    )
    (blank)
    (return (. line text-end))
  )
)

(fn-expr _ clipped-index Index
  (param value Index)
  (param limit Index)
  (call max 0 upper)
  (where
    (lazy upper (call min value limit))
  )
)

(fn-expr _ text-editor-rect-intersection Rect
  (param a Rect)
  (param b Rect)
  (call Rect left top (- right left) (- bottom top))
  (where
    (lazy left (call max (. a x) (. b x)))
    (lazy top (call max (. a y) (. b y)))
    (lazy right (call max left (call min (. a right) (. b right))))
    (lazy bottom (call max top (call min (. a bottom) (. b bottom))))
  )
)

(fn-expr _ event-extend-selection Bool
  (param event KeyPressEvent)
  (. event modifiers shift)
)

(fn-expr _ event-option Bool
  (param event KeyPressEvent)
  (. event modifiers option)
)

(fn-expr _ text-editor-word-separator Bool
  (param char Char)
  (or (== char (char " ")) (== char (char "\t")) (== char (char "\n")) (== char (char "\r")))
)
