_ RichTextRun

+ text String = ""
+ display-text = DisplayText("")
+ role RichTextRole
+ url String?

────────────────────
+ This
    - text String
    - display-text DisplayText
    - role RichTextRole
    - url String? = null

━━━━━━━━━━━━━━━━━━━━
_ RichTextLine

+ runs [RichTextRun]
+ indent Int
+ width Int

────────────────────
+ This
    - indent Int = 0

────────────────────
+ do add
    - display DisplayText
    - role RichTextRole
    - url String? = null

=? if !display.text

if | [..., run] = runs
    if run.role == role && run.url == url
        run.text += display.text
        run.display-text = run.display-text + display
        width += display.display-width as Int
        =
runs += RichTextRun(display.text, display, role, url)
width += display.display-width as Int

━━━━━━━━━━━━━━━━━━━━
_ RichTextLayout

+ max-width Int
+ width Int
+ lines List'RichTextLine
+ line-count Int

_ component RichText
_ line RichTextLine?
_ indent Int
_ x Int
_ is-first-block = true
_ link-url String?

────────────────────
+ This
    - component RichText
    - max-width Coord

if max-width <= 0
    this.max-width = rich-positive-measure-width(component.preferred-wrap-width) as Int
else
    this.max-width = max-width as Int

────────────────────
+ do get current-line

if !line
    line = RichTextLine(indent)
= line!

────────────────────
+ get available-width

|? max-width > indent
    max-width - indent
??
    1

────────────────────
+ do render
    - node Markdown

render-block(node)

────────────────────
+ do finish

if line
    newline()

────────────────────
+ do before-block

if is-first-block
    is-first-block = false
    =
if line
    newline()

lines += RichTextLine(indent)
line-count += 1

────────────────────
+ do newline

if line
    lines += line
    line-count += 1
    width = max(width, line!.width + line!.indent)

line = null
x = 0

────────────────────
+ do add-raw
    - text String
    - role RichTextRole

add-display(DisplayText(text), role)

────────────────────
+ do add-display
    - text DisplayText
    - role RichTextRole

current-line.add(text, role, link-url)
x += text.display-width as Int

────────────────────
+ do add-text
    - text String
    - role RichTextRole

. word = ""
for c in text
    if c == '\n'
        add-word(word, role)
        word = ""
        newline()
    else if is-rich-space(c)
        add-word(word, role)
        word = ""
        add-space(role)
    else
        word += c

add-word(word, role)

────────────────────
+ do add-space
    - role RichTextRole

=? if x == 0

if x + 1 > available-width
    newline()
else
    add-raw(" ", role)

────────────────────
+ do add-word
    - word String
    - role RichTextRole

=? if !word

. word-display = DisplayText(word)
if (word-display.display-width as Int) > available-width
    for c in word
        . char-display = DisplayText("$c")
        . char-width = char-display.display-width as Int
        if x + char-width > available-width
            newline()
        add-display(char-display, role)
    =
if x > 0 && x + (word-display.display-width as Int) > available-width
    newline()

add-display(word-display, role)

────────────────────
+ do render-blocks
    - nodes [Markdown]

for node in nodes
    render-block(node)

────────────────────
+ do render-block
    - node Markdown

if | doc MDDocument = node
    render-blocks(doc.content)
else if | header MDHeader = node
    before-block()
    render-inlines(header.content, RichTextRole.header)
    newline()
else if | paragraph MDParagraph = node
    before-block()
    render-inlines(paragraph.content, RichTextRole.body)
    newline()
else if | divider MDDivider = node
    before-block()
    add-raw("-" * available-width, RichTextRole.divider)
    newline()
else if | list MDList = node
    before-block()
    render-list(list)
else if | item MDListItem = node
    before-block()
    render-list-item(item)
else if | quote MDBlockQuote = node
    before-block()
    render-quote(quote.content)
else if | code MDFencedCode = node
    before-block()
    render-code(code.body)
else if | table MDTable = node
    before-block()
    render-table(table)
else if | row MDTableRow = node
    before-block()
    render-table-row(row)
else if | cell MDTableCell = node
    before-block()
    render-inlines(cell.content, RichTextRole.body)
    newline()
else
    before-block()
    render-inline(node, RichTextRole.body)
    newline()

────────────────────
+ do render-list
    - list MDList

. number = list.start
for child in list.children
    if | item MDListItem = child
        . marker = if list.ordered then "${number}. " else "* "
        render-list-item(item, marker)
        number += 1
    else
        render-block(child)

────────────────────
+ do render-list-item
    - item MDListItem
    - marker = "* "

if line
    newline()

. previous-indent = indent
. content-indent = indent + marker.length

indent = previous-indent
add-raw(marker, RichTextRole.bullet)
indent = content-indent
render-inlines(item.content, RichTextRole.body)
newline()

for block in item.blocks
    indent = content-indent
    if | list MDList = block
        render-list(list)
    else
        render-block(block)

indent = previous-indent

────────────────────
+ do render-quote
    - content [Markdown]

. previous-indent = indent

indent += 2
for node in content
    if line
        newline()
    add-raw("> ", RichTextRole.quote)
    if | paragraph MDParagraph = node
        render-inlines(paragraph.content, RichTextRole.quote)
        newline()
    else if | header MDHeader = node
        render-inlines(header.content, RichTextRole.quote)
        newline()
    else if | code MDFencedCode = node
        render-code(code.body)
    else
        render-inline(node, RichTextRole.quote)
        newline()
indent = previous-indent

────────────────────
+ do render-table
    - table MDTable

render-table-row(table.header)
for row in table.rows
    render-table-row(row)

────────────────────
+ do render-table-row
    - row MDTableRow

if line
    newline()
. is-first = true
for cell in row.cells
    if !is-first
        add-raw(" | ", RichTextRole.divider)
    render-inlines(cell.content, RichTextRole.body)
    is-first = false
newline()

────────────────────
+ do render-code
    - code String

for code-line in code.split("\n")
    add-text(code-line, RichTextRole.code)
    newline()

────────────────────
+ do render-inlines
    - nodes [Markdown]
    - role RichTextRole

for node in nodes
    render-inline(node, role)

────────────────────
+ do render-inline
    - node Markdown
    - role RichTextRole

if | text MDText = node
    add-text(text.text, role)
else if | strong MDStrong = node
    render-inlines(strong.content, RichTextRole.strong)
else if | em MDEm = node
    render-inlines(em.content, RichTextRole.em)
else if | link MDLink = node
    . previous-link-url = link-url
    link-url = link.url
    render-inlines(link.content, RichTextRole.link)
    link-url = previous-link-url
    if component.show-link-urls
        add-text(" (${link.url})", RichTextRole.quote)
else if | image MDImage = node
    add-text("[image: ", RichTextRole.image)
    render-inlines(image.content, RichTextRole.image)
    add-text("]", RichTextRole.image)
    if component.show-image-urls
        add-text(" (${image.url})", RichTextRole.quote)
else if | code MDInlineCode = node
    add-text(code.code, RichTextRole.code)
else if | cell MDTableCell = node
    render-inlines(cell.content, role)
else if | quote MDBlockQuote = node
    render-quote(quote.content)
else if | paragraph MDParagraph = node
    render-inlines(paragraph.content, role)
else
    add-text("$node", role)

