super.emit-tui-box-node()

//this:tui.box.text -> text

────────────────────
+ do paint
    - canvas Canvas

if !is-paint-visible
    did-paint()
    =
sync-display-text()
. fg = paint-text-color
. content = content-bounds
do use canvas
    canvas.text-color = fg
    paint-box-background(this, bounds, canvas)
    paint-box-border(this, bounds, canvas)
    canvas.move(content.point)
    canvas.clip(content)
    canvas.print-display-text(display-text)
    for box in structural-children
        if paint-skip-compositing-layers && box.requires-compositing-layer
            continue
        box.paint(canvas)

did-paint()

