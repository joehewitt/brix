+ RichTextPaint is Style

+ @inherited header-color AnsiColor = aqua
+ @inherited strong-color AnsiColor = white
+ @inherited em-color AnsiColor = yellow
+ @inherited link-color AnsiColor = aqua
+ @inherited image-color AnsiColor = purple
+ @inherited quote-color AnsiColor = grey
+ @inherited code-color AnsiColor = lime
+ @inherited divider-color AnsiColor = grey
+ @inherited bullet-color AnsiColor = silver
+ @inherited hover-link-color AnsiColor = black
+ @inherited hover-link-background BackgroundColor = aqua

. header-color -> paint
. strong-color -> paint
. em-color -> paint
. link-color -> paint
. image-color -> paint
. quote-color -> paint
. code-color -> paint
. divider-color -> paint
. bullet-color -> paint
. hover-link-color -> paint
. hover-link-background -> paint

━━━━━━━━━━━━━━━━━━━━
+ RichText is Box
    using RichTextPaint

+ text String? = null
+ document Markdown = MDDocument(List'Markdown())
+ preferred-wrap-width Coord = default-rich-text-wrap-width()
+ show-link-urls = false
+ show-image-urls = false
+ hovered-link-url String?

_ lines List'RichTextLine = List'RichTextLine()
_ rich-layout-width Coord = -1
_ is-rich-layout-invalid = true

. invalidate-rich-layout < text, document, show-link-urls, show-image-urls
. invalidate-paint < hovered-link-url

────────────────────
+ This
    - text String

────────────────────
+ This
    - document Markdown

────────────────────
for event on mouse-move

. url = link-url(event.point)
if hovered-link-url != url
    hovered-link-url = url

────────────────────
+ do measured-content-size PSize
    - query MeasureQuery

. layout = RichTextLayout(this, rich-measure-width(query))
layout.render(rich-document())
layout.finish()
= PSize(layout.width as Coord, rich-line-count(layout.line-count))

────────────────────
+ do update-layout

. text-layout = RichTextLayout(this, content-bounds.width)
text-layout.render(rich-document())
text-layout.finish()

lines = text-layout.lines
inner-width = text-layout.width as Coord
inner-height = rich-line-count(text-layout.line-count)
rich-layout-width = content-bounds.width
is-rich-layout-invalid = false
$is-layout-invalid = false
mark-layout-arranged()

────────────────────
+ do paint
    - canvas Canvas

if !is-paint-visible
    did-paint()
    =

if is-rich-layout-invalid || rich-layout-width != content-bounds.width
    update-layout()

do use canvas
    paint-box-background(this, bounds, canvas)
    paint-box-border(this, bounds, canvas)
    . content = content-bounds
    canvas.clip(content)
    canvas.offset((scroll-x, scroll-y))

    . y = content.y
    for line in lines
        . x = content.x + (line.indent as Coord)
        for run in line.runs
            if run.url && hovered-link-url && run.url == hovered-link-url
                . hover-bounds = Rect(x, y, run.display-text.display-width as Coord, 1)
                canvas.paint-background($hover-link-background, hover-bounds)
                canvas.text-color = $hover-link-color
            else
                canvas.text-color = role-color(run.role)
            canvas.move((x, y))
            canvas.print-display-text(run.display-text)
            x += run.display-text.display-width as Coord
        y += 1

did-paint()

────────────────────
+ do invalidate-rich-layout

is-rich-layout-invalid = true
invalidate-content-size()

────────────────────
+ do link-url
    - point Point

if is-rich-layout-invalid || rich-layout-width != content-bounds.width
    update-layout()

. content = content-bounds
. content-x = point.x - content.x - scroll-x
. content-y = point.y - content.y - scroll-y

=? if content-y < 0
=? if content-y >= lines.length

. line = lines[content-y]
. x = line.indent as Coord
for run in line.runs
    . next-x = x + (run.display-text.display-width as Coord)
    if content-x >= x && content-x < next-x
        = run.url
    x = next-x

────────────────────
_ rich-measure-width
    - query MeasureQuery

rich-positive-measure-width(width)

.. candidate-width = query.inline.available ?? query.inline.max ?? preferred-wrap-width
.. width = constrained-axis-size(candidate-width, query.inline, $min-width, $max-width)

────────────────────
_ rich-document

|? source
    Markdown(source)
??
    document

.. source = text ?? ""

────────────────────
_ role-color AnsiColor
    - role RichTextRole

match role
    | RichTextRole.body
        $color
    | RichTextRole.header
        $header-color
    | RichTextRole.strong
        $strong-color
    | RichTextRole.em
        $em-color
    | RichTextRole.link
        $link-color
    | RichTextRole.image
        $image-color
    | RichTextRole.quote
        $quote-color
    | RichTextRole.code
        $code-color
    | RichTextRole.divider
        $divider-color
    | RichTextRole.bullet
        $bullet-color

