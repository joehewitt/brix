(import ./border)
(import ./box)
(import ./canvas)
(import ./colors)
(import ./layout)
(import ./painter)
(import ./position)
(import ./primitives)
(import /core/style)
(import /units)

(type + BoxPaint (is Style)
  (prop + background-color (? BackgroundColor) (= null))
  (prop + background (? Painter) (= null))
  (prop + opacity Ratio (= 1%%))
  (blank)
  (style-domains background-color (domain paint))
  (style-domains background (domain paint))
  (style-domains opacity (domain paint))
)

(type + TextPaint (is Style)
  (prop + color AnsiColor @inherited (= white))
  (blank)
  (style-domains color (domain paint))
)

(type + BoxDisplay (is Style)
  (prop + display Display (= (. Display visible)))
  (blank)
  (style-domains display (domain layout) (domain layout parent) (domain active-list parent) (domain paint))
)

(type + BoxFocus (is Style)
  (prop + focus-mode _ (= (. FocusMode none)))
  (blank)
  (style-domains focus-mode (domain paint))
)

(type + BoxPlacement (is Style)
  (prop + flex Flex (= 0))
  (prop + position (? Position) (= null))
  (prop + anchor Anchor (= .parent))
  (prop + left (? PositionOffset) (= null))
  (prop + top (? PositionOffset) (= null))
  (prop + right (? PositionOffset) (= null))
  (prop + bottom (? PositionOffset) (= null))
  (prop + align-x (? AnchorPoint) (= null))
  (prop + align-y (? AnchorPoint) (= null))
  (blank)
  (style-domains flex (domain layout parent))
  (style-domains position (domain layout parent) (domain active-list parent))
  (style-domains anchor (domain layout parent))
  (style-domains left (domain layout parent))
  (style-domains top (domain layout parent))
  (style-domains right (domain layout parent))
  (style-domains bottom (domain layout parent))
  (style-domains align-x (domain layout parent))
  (style-domains align-y (domain layout parent))
)

(type + BoxSpacing (is Style)
  (prop + margin-top Coord (= 0))
  (prop + margin-right Coord (= 0))
  (prop + margin-bottom Coord (= 0))
  (prop + margin-left Coord (= 0))
  (prop + padding-top Coord (= 0))
  (prop + padding-right Coord (= 0))
  (prop + padding-bottom Coord (= 0))
  (prop + padding-left Coord (= 0))
  (blank)
  (style-domains margin-top (domain layout parent))
  (style-domains margin-right (domain layout parent))
  (style-domains margin-bottom (domain layout parent))
  (style-domains margin-left (domain layout parent))
  (style-domains padding-top (domain layout) (domain layout parent))
  (style-domains padding-right (domain layout) (domain layout parent))
  (style-domains padding-bottom (domain layout) (domain layout parent))
  (style-domains padding-left (domain layout) (domain layout parent))
)

(type + BoxSize (is Style)
  (prop + min-width SizeSpec (= (. SizeSpec auto)))
  (prop + max-width SizeSpec (= (. SizeSpec auto)))
  (prop + min-height SizeSpec (= (. SizeSpec auto)))
  (prop + max-height SizeSpec (= (. SizeSpec auto)))
  (blank)
  (style-domains min-width (domain layout) (domain layout parent))
  (style-domains max-width (domain layout) (domain layout parent))
  (style-domains min-height (domain layout) (domain layout parent))
  (style-domains max-height (domain layout) (domain layout parent))
)

(type + BoxBorder (is Style)
  (prop + border BorderPainter (= (call DefaultBorderPainter)))
  (prop + border-style BorderStyle (= (. BorderStyle none)))
  (prop + border-color AnsiColor (= white))
  (blank)
  (style-domains border (domain layout) (domain layout parent) (domain paint))
  (style-domains border-style (domain layout) (domain layout parent) (domain paint))
  (style-domains border-color (domain paint))
)

(type + BoxLayout (is Style)
  ; The layout style: authoring `layout` chooses the descriptor the root layout phase invokes for
  ; the box's children. The value is computed style like any other; changing it invalidates the
  ; box's own layout domain.
  (blank)
  (prop + layout (? Layout) (= null))
  (blank)
  (style-domains layout (domain layout))
)

(type + BoxMasonry (is Style)
  (prop + masonry-column-count (? Int) (= null))
  (prop + masonry-row-count (? Int) (= null))
  (prop + masonry-min-column-width Coord (= 20))
  (prop + masonry-min-row-height Coord (= 4))
  (prop + masonry-column-gap Coord (= 0))
  (prop + masonry-row-gap Coord (= 0))
  (blank)
  (style-domains masonry-column-count (domain layout))
  (style-domains masonry-row-count (domain layout))
  (style-domains masonry-min-column-width (domain layout))
  (style-domains masonry-min-row-height (domain layout))
  (style-domains masonry-column-gap (domain layout))
  (style-domains masonry-row-gap (domain layout))
)
