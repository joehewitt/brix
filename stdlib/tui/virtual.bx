(import ./box)
(import ./canvas)
(import ./events)
(import ./layout)
(import ./markup)
(import ./primitives)
(import ./styles)
(import /core/list)
(import /core/markup)
(import /math)
(import /ui/virtual)
(import /ui/virtual-layout)
(import /ui/virtual-recycler)

(type + (of VirtualSlotRoot VItem) (is Box)
  (prop + slot (of VirtualSlot VItem))
  (prop + is-in-viewport Bool)
  (blank)
  (prop _ vhidden Display (= (. Display hidden)))
  (prop _ vvisible Display (= (. Display visible)))
  (blank)
  (rule This (• flex-row)
    (= display (if-expr (. slot #is-bound) vvisible vhidden))
  )
  (fn-expr + is-interactive-visible _ :get
    (and (. slot is-bound) is-display-visible (?? (?. %parent is-interactive-visible) true))
  )
  (fn-expr + is-focus-traversal-reachable _ :get
    (and (. slot is-bound) is-in-viewport)
  )
  (fn-do + paint _
    (param canvas Canvas)
    (if (not is-in-viewport)
      (call did-paint)
      (return)
    )
    (call (. super paint) canvas)
  )
)

(type + (of VirtualRegion VItem) (is Box)
  (implements MarkupRootElement)
  (implements VirtualRecyclerOwner)
  (prop + source (? (of VirtualSource VItem)))
  (prop + virtual-layout (? VirtualLayout))
  (prop + overscan _ (= (call VirtualInsets 0vcoord 0vcoord 0vcoord 0vcoord)))
  (prop + virtual-scroll VirtualPoint)
  (prop + virtual-extent-x VirtualExtent)
  (prop + virtual-extent-y VirtualExtent)
  (prop + scroll-changed _ (=> scrolled))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (prop + has-horizontal-overflow _ (=> (> (. virtual-extent-x known) (as (as (. content-bounds width) I64) VirtualCoord))))
  (prop + has-vertical-overflow _ (=> (> (. virtual-extent-y known) (as (as (. content-bounds height) I64) VirtualCoord))))
  (blank)
  (prop _ recycler _ (:= (call (of VirtualRecycler VItem))))
  (prop _ updated-during-layout-pass Bool)
  (prop _ observed-root-count Size)
  (prop _ stat-roots-created Size)
  (fn-do + This _
    (= (. recycler owner) this)
  )
  (content
    (<> This
      (for (in slot (. recycler #slots))
        (<> (of VirtualSlotRoot VItem)
          (= slot slot)
          (blank)
          (+<> Box (id: row) (param: slot (of VirtualSlot VItem)))
        )
      )
    )
  )
  (whenever-rule (. (?. #source revision) #changes)
    (call invalidate-layout)
    (call invalidate-paint)
  )
  (whenever-rule (?. (?. #virtual-layout revision) #changes)
    (call invalidate-layout)
    (call invalidate-paint)
  )
  (fn-expr + markup-query-boundary _ :get
    true
  )
  (fn-expr + stats VirtualRecyclerStats :get
    (. recycler stats)
  )
  (fn-expr + roots-created Size :get
    stat-roots-created
  )
  (fn-expr + pool-size _ :get
    (. recycler pool-size)
  )
  (fn-expr + slot-at (? (of VirtualSlot VItem))
    (param index Index)
    (call (. recycler slot-at) index)
  )
  (fn-do + refresh-bindings _
    (return-if (if (or (not source) (not virtual-layout))))
    (let viewport (. content-bounds size))
    (let viewport-width (as (as (. viewport width) I64) VirtualCoord))
    (let viewport-height (as (as (. viewport height) I64) VirtualCoord))
    (call refresh-bindings-at (. virtual-scroll x) (. virtual-scroll y) viewport-width viewport-height)
    (call publish-bindings)
    (call update-viewport-membership)
    (let window (. recycler window))
    (let resolved (. window resolved-scroll))
    (if (!= resolved virtual-scroll)
      (= virtual-scroll resolved)
    )
    (let extent-x (. window extent-x))
    (if (!= extent-x virtual-extent-x)
      (= virtual-extent-x extent-x)
    )
    (let extent-y (. window extent-y))
    (if (!= extent-y virtual-extent-y)
      (= virtual-extent-y extent-y)
    )
  )
  (fn-do + refresh-bindings-at _
    (param scroll-x VirtualCoord)
    (param scroll-y VirtualCoord)
    (param viewport-width VirtualCoord)
    (param viewport-height VirtualCoord)
    (return-if (if (or (not source) (not virtual-layout))))
    (= (. recycler source) source)
    (= (. recycler layout) virtual-layout)
    (let window (. recycler window))
    (= (. window scroll-x) scroll-x)
    (= (. window scroll-y) scroll-y)
    (= (. window viewport-width) viewport-width)
    (= (. window viewport-height) viewport-height)
    (= (. window frame-width) viewport-width)
    (= (. window frame-height) viewport-height)
    (= (. window row-height) 1vcoord)
    (call (. window set-overscan) overscan)
    (call (. recycler refresh))
  )
  (fn-do + publish-bindings _
    (return-if (if (not (. recycler has-pending-changes))))
    (= (. recycler has-pending-changes) false)
    (call checkpoint-window)
    (call count-created-roots)
  )
  (fn-do + release-bindings _
    (call (. recycler release))
    (= source null)
    (= virtual-scroll (call VirtualPoint 0vcoord 0vcoord))
    (= virtual-extent-x (call VirtualExtent 0vcoord null false))
    (= virtual-extent-y (call VirtualExtent 0vcoord null false))
    (= observed-root-count 0)
    (call checkpoint-window)
    (call invalidate-layout)
    (call invalidate-paint)
  )
  (fn-do + scroll-to-address Bool
    (param address I64)
    (param alignment _ (= (. ScrollAlignment start)))
    (return-if false (if (or (not source) (not virtual-layout))))
    (= (. recycler source) source)
    (= (. recycler layout) virtual-layout)
    (let window (. recycler window))
    (= (. window frame-width) (as (as (. content-bounds width) I64) VirtualCoord))
    (= (. window frame-height) (as (as (. content-bounds height) I64) VirtualCoord))
    (= (. window row-height) 1vcoord)
    (let rect (call (. recycler rect-for-address) address))
    (return-if false (if (not rect)))
    (let x (if-expr (> (. rect width) (. window frame-width)) (. virtual-scroll x) (. rect x)))
    (let y (call virtual-revealed (. virtual-scroll y) (. window frame-height) (. rect y) (. rect height) alignment))
    (return (call set-virtual-scroll (call VirtualPoint x y)))
  )
  (fn-do + scroll-to-virtual Bool
    (param point VirtualPoint)
    (return (call set-virtual-scroll point))
  )
  (fn-do + root-at (? (of VirtualSlotRoot VItem))
    (param index Index)
    (let pool %first-child)
    (return-if (if (not pool)))
    (let child (call (. pool child-at) index))
    (return-if (if (not child)))
    (return (as child (of VirtualSlotRoot VItem)))
  )
  (fn-expr + append-hit-path _
    (param point Point)
    (case? (or (not is-interactive-visible) (not (call is-inside-content point)))
      (call (of List HitFrame))
    )
    (case? (not pool-root)
      (call (of List HitFrame))
    )
    (default
      (call (. pool-root append-hit-path) inner-point)
    )
    (where
      (lazy inner-point (tuple (- (. point x) scroll-x) (- (. point y) scroll-y)))
      (lazy pool-root %first-child)
    )
  )
  (fn-do + pointer-hit-result (? HitResult)
    (param point Point)
    (param offset Point)
    (return-if (if (not (call is-inside-content point))))
    (return (call (. super pointer-hit-result) point offset))
  )
  (fn-expr _ is-inside-content _
    (param point Point)
    (and horizontal vertical)
    (where
      (lazy horizontal (and (>= (. point x) (. content-bounds x)) (< (. point x) (. content-bounds right))))
      (lazy vertical (and (>= (. point y) (. content-bounds y)) (< (. point y) (. content-bounds bottom))))
    )
  )
  (fn-do _ checkpoint-window _
    (let root markup-batch-root)
    (if root
      (catch (call (. root markup-batch-queue checkpoint)))
    )
  )
  (fn-do _ count-created-roots _
    (while (and (< observed-root-count (. recycler pool-size)) (call root-at observed-root-count))
      (+= observed-root-count 1)
      (+= stat-roots-created 1)
    )
  )
  (fn-do _ arrange-virtual-roots _
    (let pool %first-child)
    (return-if (if (not pool)))
    (call (. pool arrange-bounds) content-bounds)
    (call (. pool update-layout))
    (blank)
    (let window (. recycler window))
    (let origin-x (. window resolved-scroll-x))
    (let origin-y (. window resolved-scroll-y))
    (let slot-index Index)
    (let cursor (. pool %first-child))
    (while cursor
      (let root (as cursor (of VirtualSlotRoot VItem)))
      (let placement (call (. recycler placement-for-slot) slot-index))
      (if placement
        (call (. root arrange-outer-bounds) (call viewport-rect placement origin-x origin-y))
        (= (. root is-in-viewport) (call placement-in-viewport placement))
        (else
          (call (. root arrange-outer-bounds) (call Rect (. content-bounds x) (. content-bounds y) 0 0))
          (= (. root is-in-viewport) false)
        )
      )
      (call (. root update-layout))
      (= cursor (. cursor %next-sibling))
      (+= slot-index 1)
    )
  )
  (fn-expr _ viewport-rect _
    (param placement VirtualPlacement)
    (param origin-x VirtualCoord)
    (param origin-y VirtualCoord)
    (call Rect x y width height)
    (where
      (lazy x (call checked-cell (- (+ (as (. content-bounds x) I64) (. placement x)) origin-x)))
      (lazy y (call checked-cell (- (+ (as (. content-bounds y) I64) (. placement y)) origin-y)))
      (lazy width (call checked-cell (. placement width)))
      (lazy height (call checked-cell (. placement height)))
    )
  )
  (fn-do _ update-viewport-membership _
    (let pool %first-child)
    (return-if (if (not pool)))
    (let slot-index Index)
    (let cursor (. pool %first-child))
    (while cursor
      (let root (as cursor (of VirtualSlotRoot VItem)))
      (let placement (call (. recycler placement-for-slot) slot-index))
      (= (. root is-in-viewport) (and (!= placement null) (call placement-in-viewport placement)))
      (= cursor (. cursor %next-sibling))
      (+= slot-index 1)
    )
  )
  (fn-expr _ placement-in-viewport _
    (param placement VirtualPlacement)
    (and horizontal vertical)
    (where
      (lazy window (. recycler window))
      (lazy left (. window resolved-scroll-x))
      (lazy top (. window resolved-scroll-y))
      (lazy horizontal (and (> (. placement width) 0vcoord) (> (+ (. placement x) (. placement width)) left) (< (. placement x) (+ left (. window viewport-width)))))
      (lazy vertical (and (> (. placement height) 0vcoord) (> (+ (. placement y) (. placement height)) top) (< (. placement y) (+ top (. window viewport-height)))))
    )
  )
  (fn-do _ set-virtual-scroll Bool
    (param requested VirtualPoint)
    (let x (call min (call max-virtual-scroll-x) (call max 0vcoord (. requested x))))
    (let y (call min (call max-virtual-scroll-y) (call max 0vcoord (. requested y))))
    (let next (call VirtualPoint x y))
    (return-if false (if (== next virtual-scroll)))
    (blank)
    (= virtual-scroll next)
    (call invalidate-layout)
    (call invalidate-paint)
    (return true)
  )
  (fn-expr _ max-virtual-scroll-x VirtualCoord
    (call max 0vcoord (- (. virtual-extent-x known) viewport-width))
    (where
      (lazy viewport-width (call max 0vcoord (as (. content-bounds width) I64)))
    )
  )
  (fn-expr _ max-virtual-scroll-y VirtualCoord
    (call max 0vcoord (- (. virtual-extent-y known) viewport-height))
    (where
      (lazy viewport-height (call max 0vcoord (as (. content-bounds height) I64)))
    )
  )
  (fn-do + virtual-slot-departing _
    (param slot-index Index)
    (let root (call root-at slot-index))
    (return-if (if (not root)))
    (+= (. root input-generation) 1)
    (let input-owner (? Box) root)
    (while (and input-owner (== (. input-owner input-host) null))
      (= input-owner (. input-owner %parent))
    )
    (call (?. (?. input-owner input-host) release-input-inside) root)
    (= (. root is-in-viewport) false)
  )
  (fn-do + virtual-slot-arriving _
    (param slot-index Index)
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (call PSize width height)
  )
  (fn-do + update-layout _
    (= updated-during-layout-pass false)
    (call (. super update-layout))
    (if (not updated-during-layout-pass)
      (call update-virtual-layout)
    )
  )
  (fn-do + did-layout _
    (call update-virtual-layout)
    (= updated-during-layout-pass true)
  )
  (fn-do _ update-virtual-layout _
    (call refresh-bindings)
    (call arrange-virtual-roots)
    (= inner-width (. content-bounds width))
    (= inner-height (. content-bounds height))
    (= scroll-x 0)
    (= scroll-y 0)
    (= $is-layout-invalid false)
    (call mark-layout-arranged)
  )
  (fn-do + scroll _
    (param point Point)
    (let x (as (as (- 0tx (. point x)) I64) VirtualCoord))
    (let y (as (as (- 0tx (. point y)) I64) VirtualCoord))
    (let ignored (call set-virtual-scroll (call VirtualPoint x y)))
  )
  (fn-do + scroll Bool
    (param amount Coord)
    (param direction Direction (= (. Direction down)))
    (let delta (as (as amount I64) VirtualCoord))
    (let x (. virtual-scroll x))
    (let y (. virtual-scroll y))
    (return
      (match direction
        (case .up
          (call set-virtual-scroll (call VirtualPoint x (- y delta)))
        )
        (case .down
          (call set-virtual-scroll (call VirtualPoint x (+ y delta)))
        )
        (case .left
          (call set-virtual-scroll (call VirtualPoint (- x delta) y))
        )
        (case .right
          (call set-virtual-scroll (call VirtualPoint (+ x delta) y))
        )
        (default
          (call (. super scroll) amount direction)
        )
      )
    )
  )
  (fn-expr + can-scroll Bool
    (param direction Direction)
    (match direction
      (case .up
        (> (. virtual-scroll y) 0vcoord)
      )
      (case .down
        (< (. virtual-scroll y) (call max-virtual-scroll-y))
      )
      (case .left
        (> (. virtual-scroll x) 0vcoord)
      )
      (case .right
        (< (. virtual-scroll x) (call max-virtual-scroll-x))
      )
      (default
        (call (. super can-scroll) direction)
      )
    )
  )
  (fn-expr + clipped-scroll-x Coord
    (param requested Coord)
    0
  )
  (fn-expr + clipped-scroll-y Coord
    (param requested Coord)
    0
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(fn-expr _ virtual-revealed VirtualCoord
  (param position VirtualCoord)
  (param viewport VirtualCoord)
  (param start VirtualCoord)
  (param length VirtualCoord)
  (param alignment ScrollAlignment)
  (match alignment
    (case (. ScrollAlignment start)
      start
    )
    (case (. ScrollAlignment center)
      (- (+ start (/ length 2vcoord)) (/ viewport 2vcoord))
    )
    (case (. ScrollAlignment end)
      (- (+ start length) viewport)
    )
    (default
      (case? (or (> length viewport) (< start position))
        start
      )
      (case? (> (+ start length) (+ position viewport))
        (- (+ start length) viewport)
      )
      (default
        position
      )
    )
  )
)

(fn-expr _ checked-cell Coord
  (param value I64)
  (before
    (throw (call Panic "Virtual placement exceeds terminal coordinates") (if (or (> value (as (. Coord max) I64)) (< value (- (- (as (. Coord max) I64)) 1)))))
  )
  (as value I16)
)
