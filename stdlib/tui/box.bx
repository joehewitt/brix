(import /math)
(import /units)
(import /core/markup)
(import /core/intrinsics)
(import ./markup)
(import /stream)
(import /stream/filter)
(import /ui/key-assignment)
(import ./primitives)
(import ./layout)
(import ./position)
(import ./painter)
(import ./border)
(import ./canvas)
(import ./colors)
(import ./events)
(import ./styles)
(import ./theme)
(import ./shorthands)
(import ./text)
(blank)
(prop _ layout-position _ (= (call LayoutPosition)))
(blank)
(type-line + HitResult (is (tuple (: target Box) (: offset Point))))
(type-line _ MeasureCacheEntry (is (tuple (: query MeasureQuery) (: result MeasureResult) (: generation U32))))

(type + Box
  (implements Inspectable)
  (implements (of MarkupParent Box))
  (implements KeyScopeNode)
  (implements EventNode)
  (using TUIDefaultTheme)
  (using TUIShorthandsTheme)
  (using BoxPaint)
  (using TextPaint)
  (using BoxDisplay)
  (using BoxFocus)
  (using BoxPlacement)
  (using BoxSpacing)
  (using BoxSize)
  (using BoxBorder)
  (using BoxLayout)
  (using BoxMasonry)
  (prop + markup-attachment-cache (? MarkupAttachment))
  (prop + x Coord)
  (prop + y Coord)
  (prop + width Coord)
  (prop + height Coord)
  (prop + scroll-x Coord)
  (prop + scroll-y Coord)
  (prop + inner-width Coord)
  (prop + inner-height Coord)
  (prop + bounds Rect)
  (prop + viewport-bounds (? Rect))
  (prop + paint-scheduler (? Doer))
  (prop + input-host (? InputHost))
  (prop + input-generation U64)
  (prop + is-hovered _ (= false))
  (prop + is-pressed _ (= false))
  (prop + is-focused _ (= false))
  (prop + is-enabled _ (= true))
  (prop + is-effectively-enabled _ (= true))
  (prop + intrinsic-size _ (=> (. (call measure) border-size)))
  (prop + outer-intrinsic-size _ (=> (. (call measure) outer-size)))
  (prop + measured-outer-size _ (=> (. (call measure) outer-size)))
  (event + key-press KeyPressEvent)
  (event + key-input KeyInputEvent)
  (event + paste PasteEvent)
  (event + mouse-down MouseDownEvent)
  (event + mouse-up MouseUpEvent)
  (event + mouse-move MouseMoveEvent)
  (event + mouse-drag MouseDragEvent)
  (event + scrolled ScrollEvent)
  (event + click ClickEvent)
  (prop + is-markup-shadow _ (=> markup-is-transparent-region))
  (prop + is-style-shadow _ (=> (call markup-is-style-shadow this)))
  (prop + is-modal-root _ (=> false))
  (prop + has-horizontal-overflow _ (=> (> inner-width (. content-bounds width))))
  (prop + has-vertical-overflow _ (=> (> inner-height (. content-bounds height))))
  (prop + has-overflow _ (=> (or has-horizontal-overflow has-vertical-overflow)))
  (prop + cursor-point _ (=> (call Point 0 0)))
  (prop + can-focus _ (=> (and (call focus-mode-can-focus $focus-mode) is-interactive-visible is-effectively-enabled)))
  (prop + shows-terminal-cursor _ (=> (== $focus-mode (. FocusMode input))))
  (blank)
  (prop _ child-list-generation U32)
  (prop _ hidden-dirty-below _ (= false))
  (prop _ layout-invalidation-kind U8 (= (. TuiLayout clean)))
  (prop _ measure-generation U32)
  (prop _ measure-cache (? MeasureCacheEntry))
  (prop _ retained-paint-bounds Rect)
  (prop _ has-retained-paint-bounds _ (= false))
  (prop _ paint-damage-bounds Rect)
  (prop _ has-paint-damage-bounds _ (= false))
  (prop _ active-first-child (? Box))
  (prop _ active-next (? Box))
  (prop _ active-list-child-list-generation U32)
  (blank)
  (depends own-enabled-changed is-enabled)
  (fn-do + inspectable-inspect _
    (param facet String)
    (param depth U32 (= 1))
    (param offset U32 (= 0))
    (param limit U32 (= 100))
    (match facet
      (case= "children"
        (call emit-tui-box-children offset limit)
      )
      (case= "tree"
        (call emit-tui-box-tree depth offset limit)
      )
      (case= "snapshot"
        (call inspectable-snapshot)
      )
      (default
        (call emit-tui-box-node)
      )
    )
  )
  (fn-expr + markup-make-region (? Box)
    (call BoxRegion)
  )
  (fn-expr + key-scope-parent (? KeyScopeNode) :get
    %parent
  )
  (fn-expr + is-key-scope Bool :get
    (call focus-mode-contributes-shortcuts $focus-mode)
  )
  (fn-expr + event-parent (? EventNode) :get
    %parent
  )
  (fn-expr + markup-batch-root _ :get
    (call markup-root-of this)
  )
  (fn-expr + markup-first-child (? MarkupElement) :get
    (call markup-structural-first-child-host this)
  )
  (fn-expr + markup-next-sibling (? MarkupElement) :get
    (call markup-structural-next-sibling-host this)
  )
  (fn-expr + margin-edges _ :get
    (. (call Insets $margin-top $margin-right $margin-bottom $margin-left) clamped)
  )
  (fn-expr + padding-edges _ :get
    (. (call Insets $padding-top $padding-right $padding-bottom $padding-left) clamped)
  )
  (fn-expr + border-edges _ :get
    (. (call (. $border border-insets) this) clamped)
  )
  (fn-expr + padding-bounds _ :get
    (call (. bounds inset) border-edges)
  )
  (fn-expr + content-bounds _ :get
    (call (. padding-bounds inset) padding-edges)
  )
  (fn-expr + outer-bounds _ :get
    (call (. bounds outset) margin-edges)
  )
  (fn-expr + is-displayed _ :get
    (!= $display .hidden)
  )
  (fn-expr + is-paint-visible Bool :get
    (and is-display-visible (?? (?. %parent is-paint-visible) true))
  )
  (fn-expr + is-interactive-visible Bool :get
    (and is-display-visible (?? (?. %parent is-interactive-visible) true))
  )
  (fn-expr + is-display-visible _ :get
    (== $display .visible)
  )
  (fn-expr + is-focus-traversal-reachable Bool :get
    true
  )
  (fn-expr + compositing-opacity _ :get
    (call clamped-compositing-opacity $opacity)
  )
  (fn-expr + requires-compositing-layer _ :get
    (!= compositing-opacity 1%%)
  )
  (fn-do + effective-position _ :get
    (return? $position)
    (return layout-position)
  )
  (fn-do + layout-parent _ :get
    (let maybe-parent %parent)
    (while (and maybe-parent (. maybe-parent is-markup-shadow))
      (= maybe-parent (. maybe-parent %parent))
    )
    (return maybe-parent)
  )
  (fn-expr + root Box :get
    (?? (?. %parent root) this)
  )
  (fn-do + ancestors _ :get @inline
    (let next %parent)
    (while next
      (let ancestor next)
      (= next (. ancestor %parent))
      (yield ancestor)
    )
  )
  (fn-do + structural-children _ :get @inline
    (let next %first-child)
    (while next
      (let child next)
      (= next (. child %next-sibling))
      (yield child)
    )
  )
  (fn-do + active-children _ :get @inline
    (call ensure-active-child-links)
    (blank)
    (let maybe-child active-first-child)
    (if maybe-child
      (let child maybe-child)
      (while true
        (yield child)
        (blank)
        (if (not (. child active-next))
          (break)
        )
        (= child (. child active-next))
      )
    )
  )
  (fn-do + boxes-before _ :get
    (let other %previous-sibling)
    (while other
      (yield (!! other))
      (blank)
      (= other (. (!! other) %previous-sibling))
    )
  )
  (fn-do + boxes-after _ :get
    (let other %next-sibling)
    (while other
      (yield (!! other))
      (blank)
      (= other (. (!! other) %next-sibling))
    )
  )
  (fn-expr + paint-text-color _ :get
    $color
  )
  (fn-expr + first-active-child (? Box) :get
    (before
      (do
        (call ensure-active-child-links)
      )
    )
    active-first-child
  )
  (fn-expr + next-active-sibling (? Box) :get
    active-next
  )
  (fn-expr _ size _ :set (param size Size)
    (call invalidate-content-size)
  )
  (fn-do + mounted _
    (call inherit-enabled (?? (?. %parent is-effectively-enabled) true))
  )
  (fn-do + unmounted _)
  (fn-do + close _ (?! Error)
    (call close-box)
  )
  (fn-do + inherit-enabled _
    (param inherited Bool)
    (let next (and inherited is-enabled))
    (return-if (if (== next is-effectively-enabled)))
    (blank)
    (= is-effectively-enabled next)
    (for (in child structural-children)
      (call (. child inherit-enabled) next)
    )
  )
  (fn-do + markup-attach-shadow-child _
    (param child MarkupElement)
    (param anchor (? MarkupElement))
    (+= child-list-generation 1)
    (= $is-active-list-invalid true)
    (call invalidate-child-list)
  )
  (fn-do + markup-detach-shadow-child _
    (param child MarkupElement)
    (+= child-list-generation 1)
    (= $is-active-list-invalid true)
    (call invalidate-child-list)
  )
  (fn-do + active-modal-root (? Box)
    (let modal (? Box))
    (if (and is-modal-root is-interactive-visible)
      (= modal this)
    )
    (blank)
    (for (in child structural-children)
      (let child-modal (call (. child active-modal-root)))
      (if child-modal
        (= modal child-modal)
      )
    )
    (blank)
    (return modal)
  )
  (fn-expr + anchor-bounds Rect
    (param parent Box)
    (match $anchor
      (case (. Anchor screen)
        (. root bounds)
      )
      (case (. Anchor style-target)
        (throw (call Panic "style-target anchor requires a style-generated box") (if (not is-style-shadow)))
        (throw (call Panic "style-target anchor requires a style content slot") (if (not slot)))
        (call style-target-anchor-bounds parent slot)
        (blank)
        (lazy slot (call markup-style-slot this))
      )
      (default
        (. parent content-bounds)
      )
    )
  )
  (fn-do + style-target-anchor-bounds _
    (param parent Box)
    (param slot U32)
    (if (== slot (. MarkupStyleSlot after))
      (let cursor %previous-sibling)
      (while (and cursor (. cursor is-style-shadow))
        (= cursor (. cursor %previous-sibling))
      )
      (throw (call Panic "style-target after anchor requires a previous target sibling") (if (not cursor)))
      (return (. cursor bounds))
    )
    (blank)
    (if (== slot (. MarkupStyleSlot before))
      (let cursor %next-sibling)
      (while (and cursor (. cursor is-style-shadow))
        (= cursor (. cursor %next-sibling))
      )
      (throw (call Panic "style-target before anchor requires a next target sibling") (if (not cursor)))
      (return (. cursor bounds))
    )
    (blank)
    (return (. parent bounds))
  )
  (fn-expr + participates-in-parent-layout _
    (param parent Box)
    (and is-displayed (not is-markup-shadow) (call (. effective-position participates-in-layout) parent this))
  )
  (fn-do + hidden-layout-boundary _
    (return-if this (if (not is-displayed)))
    (blank)
    (for (in ancestor ancestors)
      (if (not (. ancestor is-displayed))
        (return ancestor)
      )
    )
  )
  (fn-do + park-hidden-dirty _
    (= hidden-dirty-below true)
    (= layout-invalidation-kind (. TuiLayout self))
    (call mark-measure-inputs-changed)
  )
  (fn-do + clear-measure-cache _
    (= measure-cache null)
  )
  (fn-do + measure MeasureResult
    (param query MeasureQuery (= (call measure-fit-query)))
    (probe-count tui.layout.measure.calls)
    (return-if (call zero-measure-result) (if (not is-displayed)))
    (blank)
    (call classify-pending-layout-invalidation)
    (blank)
    (if measure-cache
      (let entry measure-cache)
      (if (and (== (. entry generation) measure-generation) (== (. entry query) query))
        (probe-count tui.layout.measure.cache-hit)
        (return (. entry result))
      )
    )
    (blank)
    (probe-count tui.layout.measure.cache-miss)
    (let content-size (call constrained-content-size (call measured-content-size query) query))
    (let border-size (call padded-size content-size))
    (let result (call MeasureResult content-size border-size (call (. this outer-size) border-size)))
    (blank)
    (= measure-cache (call MeasureCacheEntry query result measure-generation))
    (return result)
  )
  (fn-do + last-measure-result (? MeasureResult)
    (param query MeasureQuery)
    (if (and measure-cache (== (. measure-cache query) query))
      (return (. measure-cache result))
    )
  )
  (fn-do + mark-layout-arranged _
    (= layout-invalidation-kind (. TuiLayout clean))
    (call clamp-scroll-after-layout)
  )
  (fn-do + clamp-scroll-after-layout _
    (let next (call clipped-scroll-point (call Point scroll-x scroll-y)))
    (if (!= next (call Point scroll-x scroll-y))
      (call scroll next)
    )
  )
  (fn-expr + measured-content-size PSize
    (param query MeasureQuery)
    (if-expr box-layout (call (. box-layout measure-content) this query) (call PSize width height))
    (where
      (lazy box-layout $layout)
    )
  )
  (fn-expr + constrained-content-size _
    (param size PSize)
    (param query MeasureQuery)
    (call PSize width height)
    (where
      (lazy width (call constrained-axis-size (. size width) (. query inline) $min-width $max-width))
      (lazy height (call constrained-axis-size (. size height) (. query block) $min-height $max-height))
    )
  )
  (fn-do + constrained-axis-size _
    (param size Coord)
    (param query AxisQuery)
    (param minimum SizeSpec)
    (param maximum SizeSpec)
    (let result size)
    (let min-size (call resolved-size-spec query minimum))
    (if min-size
      (= result (call max result min-size))
    )
    (let max-size (call resolved-size-spec query maximum))
    (if max-size
      (= result (call min result max-size))
    )
    (return result)
  )
  (fn-expr + resolved-size-spec _
    (param query AxisQuery)
    (param spec SizeSpec)
    (match? spec
      (case (call (. SizeSpec coord) value)
        value
      )
      (case (call (. SizeSpec percent) percent)
        (call resolved-percent-size percent query)
      )
    )
  )
  (fn-do + resolved-percent-size (? Coord)
    (param percent Percent)
    (param query AxisQuery)
    (if (. query available)
      (return (as (call round (* (as percent Ratio) (. query available))) Coord))
    )
  )
  (fn-expr + padded-size _
    (param size PSize)
    (call PSize
      (block
        (arg (+ (. size width) (. padding horizontal) (. border horizontal)))
        (arg (+ (. size height) (. padding vertical) (. border vertical)))
      )
    )
    (where
      (lazy padding padding-edges)
      (lazy border border-edges)
    )
  )
  (fn-expr + outer-size _
    (param size PSize)
    (call PSize (+ (. size width) (. margin horizontal)) (+ (. size height) (. margin vertical)))
    (where
      (lazy margin margin-edges)
    )
  )
  (fn-do + ensure-active-child-links _
    (if (not %first-child)
      (= active-first-child null)
      (= active-list-child-list-generation child-list-generation)
      (= $is-active-list-invalid false)
      (return)
    )
    (if (== active-list-child-list-generation child-list-generation)
      (return-if (if (and (not $is-active-list-invalid) (not (call has-shadow-active-list-invalid)))))
    )
    (blank)
    (= active-first-child null)
    (blank)
    (let active-tail (? Box) null)
    (for (in child structural-children)
      (probe-count tui.layout.active-list.children-scanned)
      (= active-tail (call append-active-child child active-tail))
    )
    (blank)
    (= active-list-child-list-generation child-list-generation)
    (= $is-active-list-invalid false)
    (probe-count tui.layout.active-list.rebuilds)
  )
  (fn-expr + inspectable-summary _
    (str (. (type-of this) concrete-name) " #" (. this uid))
  )
  (fn-do + emit-tui-box-node _
    (probe-log (: this tui.box.node) (items: (. (type-of this) concrete-name) (call inspectable-summary) (. bounds x) (. bounds y) (. bounds width) (. bounds height) inner-width inner-height scroll-x scroll-y $is-layout-invalid $is-paint-invalid is-hovered is-pressed is-focused is-effectively-enabled))
  )
  (fn-do + emit-tui-box-children _
    (param offset U32 (= 0))
    (param limit U32 (= 100))
    (let index U32 0)
    (let emitted U32 0)
    (for (in child structural-children)
      (if (and (>= index offset) (< emitted limit))
        (probe-log (: this tui.box.child) (items: index child (. (type-of child) concrete-name) (call (. child inspectable-summary))))
        (+= emitted 1)
      )
      (+= index 1)
    )
    (blank)
    (probe-log (: this tui.box.child.count) (items: index))
  )
  (fn-do + emit-tui-box-tree _
    (param depth U32 (= 1))
    (param offset U32 (= 0))
    (param limit U32 (= 100))
    (call emit-tui-box-node)
    (return-if (if (== depth 0)))
    (blank)
    (let index U32 0)
    (let emitted U32 0)
    (for (in child structural-children)
      (if (and (>= index offset) (< emitted limit))
        (probe-log (: this tui.box.child) (items: index child (. (type-of child) concrete-name) (call (. child inspectable-summary))))
        (if (> depth 1)
          (call (. child emit-tui-box-tree) (- depth 1) 0 limit)
        )
        (+= emitted 1)
      )
      (+= index 1)
    )
    (blank)
    (probe-log (: this tui.box.child.count) (items: index))
  )
  (fn-do + invalidate-layout _
    (let hidden-boundary (call hidden-layout-boundary))
    (if hidden-boundary
      (call (. hidden-boundary park-hidden-dirty))
      (return)
    )
    (call mark-measure-inputs-changed)
    (call mark-self-layout-invalid)
    (if (and is-markup-shadow layout-parent)
      (call (. (!! layout-parent) invalidate-layout))
    )
    (call invalidate-paint)
  )
  (fn-do + invalidate-content-size _
    (call invalidate-content-size-climb true)
  )
  (fn-do + arrange-bounds _
    (param rect Rect)
    (if (!= bounds rect)
      (= bounds rect)
      (= $is-layout-invalid true)
      (call invalidate-paint)
    )
  )
  (fn-do + arrange-outer-bounds _
    (param rect Rect)
    (call arrange-bounds (call (. rect inset) margin-edges))
  )
  (fn-do + update-layout _
    (call update-layout-pass)
  )
  (fn-do + did-layout _)
  (fn-do + did-paint _
    (call record-retained-paint-bounds)
    (= $is-paint-invalid false)
  )
  (fn-do + record-retained-paint-bounds _
    (if (and is-paint-visible (not is-markup-shadow) (> (. bounds width) 0) (> (. bounds height) 0))
      (= retained-paint-bounds (call root-paint-bounds))
      (= has-retained-paint-bounds true)
    )
  )
  (fn-do + retained-paint-footprint (? Rect)
    (let footprint (? Rect))
    (if has-retained-paint-bounds
      (= footprint retained-paint-bounds)
    )
    (blank)
    (for (in child structural-children)
      (let child-footprint (call (. child retained-paint-footprint)))
      (if child-footprint
        (if footprint
          (= footprint (call union-rect footprint child-footprint))
          (else
            (= footprint child-footprint)
          )
        )
      )
    )
    (blank)
    (return footprint)
  )
  (fn-do + clear-retained-paint-footprint _
    (= has-retained-paint-bounds false)
    (for (in child structural-children)
      (call (. child clear-retained-paint-footprint))
    )
  )
  (fn-do + invalidate-retained-paint-footprint _
    (let footprint (call retained-paint-footprint))
    (if (and (not footprint) (not is-markup-shadow) (> (. bounds width) 0) (> (. bounds height) 0))
      (= footprint (call root-paint-bounds))
    )
    (return-if (if (not footprint)))
    (blank)
    (call (. root add-paint-damage-bounds) footprint)
    (call clear-retained-paint-footprint)
  )
  (fn-do + add-paint-damage-bounds _
    (param rect Rect)
    (return-if (if (<= (. rect width) 0)))
    (return-if (if (<= (. rect height) 0)))
    (blank)
    (if (not has-paint-damage-bounds)
      (= paint-damage-bounds rect)
      (= has-paint-damage-bounds true)
      (else
        (= paint-damage-bounds (call union-rect paint-damage-bounds rect))
      )
    )
  )
  (fn-do + take-paint-damage-bounds _
    (return-if (if (not has-paint-damage-bounds)))
    (blank)
    (let damage paint-damage-bounds)
    (= has-paint-damage-bounds false)
    (return damage)
  )
  (fn-do + paint _
    (param canvas Canvas)
    (if (not is-paint-visible)
      (if (and (not is-displayed) $is-paint-invalid-below)
        (= $is-paint-invalid-below false)
      )
      (call did-paint)
      (return)
    )
    (if $is-layout-invalid
      (call update-layout)
    )
    (blank)
    (if (and (not is-markup-shadow) (not (call (. canvas is-rect-visible) bounds)))
      (= $is-paint-invalid false)
      (return)
    )
    (probe-count tui.frame.paint.boxes)
    (if is-markup-shadow
      (for (in box structural-children)
        (if (and paint-skip-compositing-layers (. box requires-compositing-layer))
          (continue)
        )
        (call (. box paint) canvas)
      )
      (call did-paint)
      (return)
    )
    (do-use canvas
      (call paint-box-background this bounds canvas)
      (call paint-box-border this bounds canvas)
      (call (. canvas clip) content-bounds)
      (call (. canvas offset) (tuple scroll-x scroll-y))
      (blank)
      (for (in box structural-children)
        (if (and paint-skip-compositing-layers (. box requires-compositing-layer))
          (continue)
        )
        (call (. box paint) canvas)
      )
    )
    (blank)
    (call did-paint)
  )
  (fn-do + arrange-positioned-children _
    (for (in child structural-children)
      (call arrange-positioned-child child)
    )
  )
  (fn-expr + hit-test _
    (param point Point)
    (. (call hit-path point) target)
  )
  (fn-expr + hit-path _
    (param point Point)
    (case? hit
      (call HitPath (. hit target) this (. hit offset) point null frames)
    )
    (default
      (call HitPath this this (call Point 0 0) point null frames)
    )
    (where
      (lazy hit (call pointer-hit-result point (call Point 0 0)))
      (lazy frames (++ (call (of List HitFrame) (list (call HitFrame this point input-generation))) (call append-hit-path point)))
    )
  )
  (fn-expr + hit-path-within _
    (param modal Box)
    (param point Point)
    (case? hit
      (call HitPath (. hit target) this (. hit offset) point modal frames)
    )
    (default
      (call HitPath modal this (call Point 0 0) point modal frames)
    )
    (where
      (lazy hit (call (. modal pointer-hit-result) point (call Point 0 0)))
      (lazy frames (++ root-frames (call (. modal append-hit-path) point)))
      (lazy root-frames (list HitFrame)
        (block
          (item (call HitFrame this point input-generation))
          (item (call HitFrame modal point (. modal input-generation)))
        )
      )
    )
  )
  (fn-do + append-hit-path (list HitFrame)
    (param point Point)
    (return-if (call (of List HitFrame)) (if (not is-interactive-visible)))
    (blank)
    (let inner-point (tuple (- (. point x) scroll-x) (- (. point y) scroll-y)))
    (let cursor %last-child)
    (while cursor
      (let child cursor)
      (if (. child is-markup-shadow)
        (let shadow-frames (call (. child append-hit-path) inner-point))
        (if (> (. shadow-frames length) 0)
          (return shadow-frames)
        )
        (else-if (and (not (. child is-style-shadow)) (. child is-interactive-visible))
          (if (not (call (. child bounds contains) inner-point))
            (= cursor (. child %previous-sibling))
            (continue)
          )
          (let child-frame (call HitFrame child inner-point (. child input-generation)))
          (return (++ (call (of List HitFrame) (list child-frame)) (call (. child append-hit-path) inner-point)))
        )
      )
      (= cursor (. child %previous-sibling))
    )
    (return (call (of List HitFrame)))
  )
  (fn-do + pointer-hit-result (? HitResult)
    (param point Point)
    (param offset Point)
    (return-if (if (not is-interactive-visible)))
    (blank)
    (let inner-point (call Point (- (. point x) scroll-x) (- (. point y) scroll-y)))
    (let child-offset (call Point (+ (. offset x) scroll-x) (+ (. offset y) scroll-y)))
    (let cursor %last-child)
    (while cursor
      (let child cursor)
      (if (. child is-markup-shadow)
        (return? (call (. child pointer-hit-result) inner-point child-offset))
        (else-if (and (not (. child is-style-shadow)) (. child is-interactive-visible))
          (if (not (call (. child bounds contains) inner-point))
            (= cursor (. child %previous-sibling))
            (continue)
          )
          (return (?? (call (. child pointer-hit-result) inner-point child-offset) (call HitResult child child-offset)))
        )
      )
      (= cursor (. child %previous-sibling))
    )
  )
  (fn-do + (of descendant Target) (? Target)
    (param where (of Predicate Target) (= (call (of type-identity Target))))
    ; - Target = Target
    (blank)
    (if (is this Target)
      (let target (as this Target))
      (if (call where target)
        (return target)
      )
    )
    (blank)
    (for (in child structural-children)
      (return? (call (of (. child descendant) Target) (:where where)))
    )
  )
  (fn-do + (of ancestor Target) (? Target)
    (param where (of Predicate Target) (= (call (of type-identity Target))))
    ; - Target = Target
    (blank)
    (for (in ancestor ancestors)
      (if (is ancestor Target)
        (let target (as ancestor Target))
        (if (call where target)
          (return target)
        )
      )
      (return (call (of (. ancestor ancestor) Target) (:where where)))
    )
  )
  (fn-expr + (of ancestor-or-self Target) (? Target)
    (param where (of Predicate Target) (= (call (of type-identity Target))))
    ; - Target = Target
    (blank)
    (case? (and (is this Target) (call where (as this Target)))
      (as this Target)
    )
    (default
      (call (of ancestor Target) (:where where))
    )
  )
  (fn-do + focus-candidates _
    (let candidates (list Box))
    (if is-interactive-visible
      (call collect-interactive-focus-candidates candidates)
    )
    (return candidates)
  )
  (fn-do + next-focus-candidate (? Box)
    (param current (? Box))
    (param going-backward _ (= false))
    (let search (call FocusCandidateSearch current going-backward))
    (if is-interactive-visible
      (call collect-interactive-focus-candidate-search search)
    )
    (return (call (. search result)))
  )
  (fn-do + (of before Target) (? Target)
    (param where (of Predicate Target) (= (call (of type-identity Target))))
    ; - Target = Target
    (blank)
    (for (in box boxes-before (when (is box Target)))
      (let target (as box Target))
      (if (call where target)
        (return target)
      )
    )
  )
  (fn-do + (of after Target) (? Target)
    (param where (of Predicate Target) (= (call (of type-identity Target))))
    ; - Target = Target
    (blank)
    (for (in box boxes-after (when (is box Target)))
      (let target (as box Target))
      (if (call where target)
        (return target)
      )
    )
  )
  (fn-do + schedule-paint _
    (if paint-scheduler
      (call paint-scheduler
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
      (else
        (call (?. %parent schedule-paint))
      )
    )
  )
  (fn-do + invalidate-paint _
    (let paint-root root)
    (let already-scheduled (. paint-root $is-paint-invalid))
    (= $is-paint-invalid true)
    (= (. paint-root $is-paint-invalid) true)
    (if (not already-scheduled)
      (call (. paint-root schedule-paint))
    )
  )
  (fn-do + set-paint-scheduler _
    (param scheduler (? Doer))
    (= paint-scheduler scheduler)
    (for (in child structural-children)
      (call (. child set-paint-scheduler) scheduler)
    )
  )
  (fn-do + (of publish-pointer Event) Bool
    (param event Event)
    (constraint is Event PointerEvent)
    (let hit (call hit-path root-point))
    (let canceled (call (. hit publish-pointer) event))
    (if canceled
      (return true)
    )
    (return
      (match event
        (case ScrollEvent
          (let scroll-event (as event ScrollEvent))
          (if (call route-scroll-event scroll-event (. hit target))
            (call (. scroll-event cancel))
          )
          (. scroll-event is-canceled)
        )
        (default
          false
        )
      )
    )
    (blank)
    (lazy root-point
      (block
        (match event
          (case MouseDownEvent
            (. (as event MouseDownEvent) root-point)
          )
          (case MouseUpEvent
            (. (as event MouseUpEvent) root-point)
          )
          (case MouseMoveEvent
            (. (as event MouseMoveEvent) root-point)
          )
          (case MouseDragEvent
            (. (as event MouseDragEvent) root-point)
          )
          (case ScrollEvent
            (. (as event ScrollEvent) root-point)
          )
        )
      )
    )
  )
  (fn-do + route-scroll-event Bool
    (param event ScrollEvent)
    (param target (? Box))
    (let scrollable target)
    (while scrollable
      (if (call (. scrollable can-scroll) (. event direction))
        (return (call (. scrollable scroll) 1 (. event direction)))
      )
      (return-if false (if (. scrollable is-modal-root)))
      (blank)
      (= scrollable (. scrollable %parent))
    )
    (blank)
    (return false)
  )
  (fn-do + scroll _
    (param point Point)
    (if (or (!= (. point x) scroll-x) (!= (. point y) scroll-y))
      (= scroll-x (. point x))
      (= scroll-y (. point y))
      (call invalidate-paint)
    )
  )
  (fn-do + scroll Bool
    (param amount Coord)
    (param direction Direction (= (. Direction down)))
    (let next (call scroll-point amount direction))
    (return-if (if (== next (call Point scroll-x scroll-y))))
    (blank)
    (call scroll next)
    (return true)
  )
  (fn-expr + can-scroll Bool
    (param direction Direction)
    (or (!= (. next x) scroll-x) (!= (. next y) scroll-y))
    (where
      (lazy next (call scroll-point 1 direction))
    )
  )
  (fn-expr + scroll-point Point
    (param amount Coord)
    (param direction Direction)
    (call clipped-scroll-point (call unclipped-scroll-point amount direction))
  )
  (fn-expr + unclipped-scroll-point _
    (param amount Coord)
    (param direction Direction)
    (case? (== direction (. Direction up))
      (call Point scroll-x (+ scroll-y amount))
    )
    (case? (== direction (. Direction down))
      (call Point scroll-x (- scroll-y amount))
    )
    (case? (== direction (. Direction left))
      (call Point (+ scroll-x amount) scroll-y)
    )
    (case? (== direction (. Direction right))
      (call Point (- scroll-x amount) scroll-y)
    )
    (default
      (call Point scroll-x scroll-y)
    )
  )
  (fn-expr + clipped-scroll-point Point
    (param requested Point)
    (call Point (call clipped-scroll-x (. requested x)) (call clipped-scroll-y (. requested y)))
  )
  (fn-expr + clipped-scroll-x Coord
    (param requested Coord)
    (call min 0 lower-clipped)
    (where
      (lazy lower-clipped
        (call max scroll-min requested
          (block
            (lazy scroll-min (call min 0 (- (. content-bounds width) inner-width)))
          )
        )
      )
    )
  )
  (fn-expr + clipped-scroll-y Coord
    (param requested Coord)
    (call min 0 lower-clipped)
    (where
      (lazy lower-clipped
        (call max scroll-min requested
          (block
            (lazy scroll-min (call min 0 (- (. content-bounds height) inner-height)))
          )
        )
      )
    )
  )
  (fn-do + scroll-bounds-visible Bool
    (param rect Rect)
    (let visible content-bounds)
    (let next-x scroll-x)
    (let next-y scroll-y)
    (if (> (. visible width) 0)
      (if (< (+ (. rect x) next-x) (. visible x))
        (= next-x (- (. visible x) (. rect x)))
        (else-if (> (+ (. rect right) next-x) (. visible right))
          (= next-x (- (. visible right) (. rect right)))
        )
      )
    )
    (if (> (. visible height) 0)
      (if (< (+ (. rect y) next-y) (. visible y))
        (= next-y (- (. visible y) (. rect y)))
        (else-if (> (+ (. rect bottom) next-y) (. visible bottom))
          (= next-y (- (. visible bottom) (. rect bottom)))
        )
      )
    )
    (blank)
    (let next (call clipped-scroll-point (call Point next-x next-y)))
    (return-if (if (== next (call Point scroll-x scroll-y))))
    (blank)
    (call scroll next)
    (return true)
  )
  (fn-do + reveal-focus _
    (call reveal-in-ancestors bounds)
  )
  (fn-do + reveal-in-ancestors _
    (param rect Rect)
    (let visible rect)
    (let current (? Box) %parent)
    (while current
      (let ancestor current)
      (if (not (. ancestor is-markup-shadow))
        (call (. ancestor scroll-bounds-visible) visible)
        (= visible
          (call Rect
            (block
              (arg (+ (. visible x) (. ancestor scroll-x)))
              (arg (+ (. visible y) (. ancestor scroll-y)))
              (arg (. visible width))
              (arg (. visible height))
            )
          )
        )
      )
      (return-if (if (. ancestor is-modal-root)))
      (blank)
      (= current (. ancestor %parent))
    )
  )
  (fn-expr + markup-content _
    (param child Box)
    child
  )
  (fn-expr + markup-content Box
    (param content String)
    (call TextBox content)
  )
  (fn-do + markup-attach-child _
    (param child Box)
    (param anchor (? Box))
    (+= child-list-generation 1)
    (= $is-active-list-invalid true)
    (call invalidate-child-list)
  )
  (fn-do + markup-detach-child _
    (param child Box)
    (call (. child invalidate-retained-paint-footprint))
    (blank)
    (= (. child active-next) null)
    (blank)
    (+= child-list-generation 1)
    (= $is-active-list-invalid true)
    (call invalidate-child-list)
  )
  (fn-do + child-at (? Box)
    (param index Index)
    (let cursor %first-child)
    (let current Index 0)
    (while cursor
      (if (== current index)
        (return cursor)
      )
      (= cursor (. cursor %next-sibling))
      (+= current 1)
    )
    (return null)
  )
  (fn-do + close-box _ (?! Error)
    (for (in child structural-children)
      (call (. child close))
    )
  )
  (fn-do + request-animation-frame _
    (param callback Doer)
    (let frame-parent %parent)
    (if frame-parent
      (call (. frame-parent request-animation-frame) callback)
      (return)
    )
    (call callback
      (block
        (on-error (: error Error)
          (call unhandled-error error)
        )
      )
    )
    (call schedule-paint)
  )
  (fn-do _ own-enabled-changed _
    (call inherit-enabled (?? (?. %parent is-effectively-enabled) true))
  )
  (fn-do _ mark-measure-inputs-changed _
    (+= measure-generation 1)
    (if (== measure-generation 0)
      (= measure-cache null)
    )
  )
  (fn-do _ classify-pending-layout-invalidation _
    (if (and $is-layout-invalid (== layout-invalidation-kind (. TuiLayout clean)))
      (= layout-invalidation-kind (. TuiLayout self))
      (call mark-measure-inputs-changed)
    )
  )
  (fn-do _ mark-self-layout-invalid _
    (= layout-invalidation-kind (. TuiLayout self))
    (= $is-layout-invalid true)
  )
  (fn-do _ mark-child-only-layout-invalid _
    (if (!= layout-invalidation-kind (. TuiLayout self))
      (= layout-invalidation-kind (. TuiLayout children-only))
    )
    (= $is-layout-invalid true)
  )
  (fn-do _ invalidate-child-list _
    (call invalidate-content-size-climb true)
    (if (and is-markup-shadow layout-parent)
      (call (. (!! layout-parent) invalidate-layout))
    )
  )
  (fn-do _ invalidate-content-size-climb Bool
    (param is-origin Bool)
    (probe-count tui.layout.invalidation.visits)
    (if (not is-displayed)
      (probe-count tui.layout.invalidation.hidden-stops)
      (call park-hidden-dirty)
      (return false)
    )
    (blank)
    (call mark-measure-inputs-changed)
    (if (!= layout-invalidation-kind (. TuiLayout clean))
      (probe-count tui.layout.invalidation.frontier-stops)
      (return true)
    )
    (blank)
    (let parent %parent)
    (if parent
      (return-if false (if (not (call (. parent invalidate-content-size-climb) false))))
    )
    (blank)
    (let root-was-paint-invalid false)
    (if (not parent)
      (= root-was-paint-invalid $is-paint-invalid)
    )
    (blank)
    (if (not parent)
      (if is-origin
        (call mark-self-layout-invalid)
        (else
          (call mark-child-only-layout-invalid)
        )
      )
      (= $is-paint-invalid true)
      (if (not root-was-paint-invalid)
        (probe-count tui.layout.invalidation.root-schedules)
        (call schedule-paint)
      )
      (else-if is-origin
        (call mark-self-layout-invalid)
        (if (not $is-paint-invalid)
          (= $is-paint-invalid true)
        )
      )
      (else-if (not is-markup-shadow)
        (call mark-child-only-layout-invalid)
        (= $is-paint-invalid true)
      )
    )
    (blank)
    (return true)
  )
  (fn-do _ root-paint-bounds Rect
    (let dx Coord 0)
    (let dy Coord 0)
    (let current (? Box) %parent)
    (while current
      (let ancestor current)
      (if (not (. ancestor is-markup-shadow))
        (+= dx (. ancestor scroll-x))
        (+= dy (. ancestor scroll-y))
      )
      (= current (. ancestor %parent))
    )
    (return (call Rect (+ (. bounds x) dx) (+ (. bounds y) dy) (. bounds width) (. bounds height)))
  )
  (fn-do _ append-active-child (? Box)
    (param child Box)
    (param active-tail (? Box))
    (= (. child active-next) null)
    (blank)
    (if (. child is-markup-shadow)
      (let tail active-tail)
      (for (in grandchild (. child structural-children))
        (= tail (call append-active-child grandchild tail))
      )
      (call (. child mark-shadow-active-list-clean))
      (return tail)
    )
    (blank)
    (if (call (. child participates-in-parent-layout) this)
      (if (not active-first-child)
        (= active-first-child child)
        (return child)
      )
      (= (?. active-tail active-next) child)
      (return child)
    )
    (blank)
    (return active-tail)
  )
  (fn-do _ has-shadow-active-list-invalid Bool
    (for (in child structural-children (when (. child is-markup-shadow)))
      (let is-invalid (. child $is-active-list-invalid))
      (let list-invalid (!= (. child active-list-child-list-generation) (. child child-list-generation)))
      (let shadow-invalid (call (. child has-shadow-active-list-invalid)))
      (return-if true (if (or is-invalid list-invalid shadow-invalid)))
    )
    (return false)
  )
  (fn-do _ mark-shadow-active-list-clean _
    (= active-first-child null)
    (= active-list-child-list-generation child-list-generation)
    (= $is-active-list-invalid false)
    (for (in child structural-children (when (. child is-markup-shadow)))
      (call (. child mark-shadow-active-list-clean))
    )
  )
  (fn-do _ update-layout-pass _
    (if (not is-displayed)
      (if (or $is-layout-invalid $is-layout-invalid-below hidden-dirty-below)
        (probe-count tui.layout.hidden.boundary-stops)
        (= hidden-dirty-below true)
        (= $is-layout-invalid false)
        (= $is-layout-invalid-below false)
      )
      (return)
    )
    (let needs-layout (or $is-layout-invalid hidden-dirty-below))
    (if hidden-dirty-below
      (= hidden-dirty-below false)
      (probe-count tui.layout.hidden.reveals)
      (for (in child structural-children)
        (call (. child invalidate-revealed-layout))
      )
    )
    (blank)
    (let visit-below $is-layout-invalid-below)
    (let did-work (or needs-layout visit-below))
    (if needs-layout
      (probe-count tui.frame.layout.boxes)
      (probe-count tui.layout.dirty.frontier-nodes)
      (call classify-pending-layout-invalidation)
      (if (not is-markup-shadow)
        (let box-layout $layout)
        (if box-layout
          (let hint (. LayoutArrangeHint full))
          (if (and (== layout-invalidation-kind (. TuiLayout children-only)) (not $is-active-list-invalid))
            (= hint (. LayoutArrangeHint children-only))
          )
          (call (. box-layout arrange-box) this hint)
        )
        (call arrange-positioned-children)
      )
      (= $is-layout-invalid false)
      (call mark-layout-arranged)
      (= visit-below $is-layout-invalid-below)
    )
    (blank)
    (if visit-below
      (= $is-layout-invalid-below false)
      (for (in child structural-children)
        (call (. child update-layout-pass))
      )
    )
    (blank)
    (if did-work
      (call did-layout)
    )
  )
  (fn-do _ invalidate-revealed-layout _
    (if (not is-displayed)
      (call park-hidden-dirty)
      (return)
    )
    (call mark-measure-inputs-changed)
    (call mark-self-layout-invalid)
    (for (in child structural-children)
      (call (. child invalidate-revealed-layout))
    )
  )
  (fn-do _ arrange-positioned-child _
    (param child Box)
    (probe-count tui.layout.arrange.children-considered)
    (if (. child is-markup-shadow)
      (for (in grandchild (. child structural-children))
        (call arrange-positioned-child grandchild)
      )
      (return)
    )
    (if (and (. child is-displayed) (not (call (. child participates-in-parent-layout) this)))
      (probe-count tui.layout.arrange.children-arranged)
      (call (. child effective-position arrange) this child)
    )
  )
  (fn-do _ collect-interactive-focus-candidates _
    (param candidates (list Box))
    (if (call focus-mode-can-focus $focus-mode)
      (if is-effectively-enabled
        (+= candidates this)
      )
      (return)
    )
    (for (in child structural-children)
      (if (and (. child is-display-visible) (. child is-focus-traversal-reachable))
        (call (. child collect-interactive-focus-candidates) candidates)
      )
    )
  )
  (fn-do _ collect-interactive-focus-candidate-search _
    (param search FocusCandidateSearch)
    (if (call focus-mode-can-focus $focus-mode)
      (if is-effectively-enabled
        (call (. search add) this)
      )
      (return)
    )
    (for (in child structural-children)
      (if (and (. child is-display-visible) (. child is-focus-traversal-reachable))
        (call (. child collect-interactive-focus-candidate-search) search)
      )
    )
  )
  (fn-do _ clear-children _
    (while true
      (let maybe-child %first-child)
      (if (not maybe-child)
        (break)
      )
      (let child maybe-child)
      (call markup-remove this child)
      (call (. child close))
    )
  )
)

(type + HitFrame (is Tuple)
  (prop + box Box)
  (prop + point Point)
  (prop + generation U64 (= 0))
)

(type + InputHost (is Interface)
  (fn-do + release-input-inside _
    (param subtree Box)
  )
)

(type + FocusMode (is Union)
  (variant none)
  (variant keys)
  (variant inside)
  (variant input)
)

(type + HitPath (is Tuple)
  (prop + target Box)
  (prop + root Box)
  (prop + offset Point)
  (prop + root-point Point)
  (prop + boundary (? Box))
  (prop + frames (list HitFrame))
  (fn-do + point-for (? Point)
    (param box Box)
    (let current (? Box) target)
    (let current-offset (call live-offset))
    (while current
      (if (== current box)
        (return (call Point (- (. root-point x) (. current-offset x)) (- (. root-point y) (. current-offset y))))
      )
      (if (and boundary (== (as current Pointer) (as boundary Pointer)))
        (if (== (as root Pointer) (as box Pointer))
          (return root-point)
        )
        (break)
      )
      (let parent (. current %parent))
      (if parent
        (= current-offset
          (block
            (call Point (- (. current-offset x) (. parent scroll-x)) (- (. current-offset y) (. parent scroll-y)))
          )
        )
      )
      (= current parent)
    )
  )
  (fn-expr + with-root-point HitPath
    (param point Point)
    (call HitPath target root offset point boundary frames)
  )
  (fn-do + is-current Bool
    (for (in frame frames)
      (return-if (if (!= (. frame generation) (. frame box input-generation))))
    )
    (return true)
  )
  (fn-do + (of publish-pointer Event) Bool
    (param event Event)
    (constraint is Event PointerEvent)
    (return-if false (if (not (call is-current))))
    (blank)
    (return
      (match event
        (case MouseDownEvent
          (let mouse-event (as event MouseDownEvent))
          (let saved (call begin-pointer-route mouse-event (. mouse-event root-point)))
          (finally
            (inline (call (. mouse-event end-route) saved))
          )
          (<- (. target mouse-down) mouse-event)
          (. mouse-event is-canceled)
        )
        (case MouseUpEvent
          (let mouse-event (as event MouseUpEvent))
          (let saved (call begin-pointer-route mouse-event (. mouse-event root-point)))
          (finally
            (inline (call (. mouse-event end-route) saved))
          )
          (<- (. target mouse-up) mouse-event)
          (. mouse-event is-canceled)
        )
        (case MouseMoveEvent
          (let mouse-event (as event MouseMoveEvent))
          (let saved (call begin-pointer-route mouse-event (. mouse-event root-point)))
          (finally
            (inline (call (. mouse-event end-route) saved))
          )
          (<- (. target mouse-move) mouse-event)
          (. mouse-event is-canceled)
        )
        (case MouseDragEvent
          (let mouse-event (as event MouseDragEvent))
          (let saved (call begin-pointer-route mouse-event (. mouse-event root-point)))
          (finally
            (inline (call (. mouse-event end-route) saved))
          )
          (<- (. target mouse-drag) mouse-event)
          (. mouse-event is-canceled)
        )
        (case ScrollEvent
          (let scroll-event (as event ScrollEvent))
          (let saved (call begin-pointer-route scroll-event (. scroll-event root-point)))
          (finally
            (inline (call (. scroll-event end-route) saved))
          )
          (<- (. target scrolled) scroll-event)
          (. scroll-event is-canceled)
        )
      )
    )
  )
  (fn-do + publish-click Bool
    (param event ClickEvent)
    (return-if false (if (not (call is-current))))
    (blank)
    (let saved (call (. event begin-route) box-event-route-next root-pointer point offset route-boundary))
    (finally
      (inline (call (. event end-route) saved))
    )
    (<- (. target click) event)
    (return (. event is-canceled))
    (blank)
    (lazy root-pointer (as root Pointer))
    (lazy point (. event root-point))
    (lazy offset (call live-offset))
    (lazy route-boundary (call boundary-pointer))
  )
  (fn-do _ live-offset Point
    (let current (? Box) target)
    (let current-offset (call Point 0 0))
    (let offset-root (?? boundary root))
    (while current
      (if (== (as current Pointer) (as offset-root Pointer))
        (return current-offset)
      )
      (let parent (. current %parent))
      (if (not parent)
        (return offset)
      )
      (= current-offset
        (block
          (call Point (+ (. current-offset x) (. parent scroll-x)) (+ (. current-offset y) (. parent scroll-y)))
        )
      )
      (= current parent)
    )
    (return offset)
  )
  (fn-expr _ boundary-pointer _
    (case? boundary
      (as boundary Pointer)
    )
    (default
      null
    )
  )
  (fn-do _ begin-pointer-route _
    (param event MouseEvent)
    (param point Point)
    (return (call (. event begin-route) box-event-route-next root-pointer point route-offset route-boundary))
    (blank)
    (lazy root-pointer (as root Pointer))
    (lazy route-offset (call live-offset))
    (lazy route-boundary (call boundary-pointer))
  )
)

(fn-do + (of publish-focused-input Event) Bool
  (param root Box)
  (param target Box)
  (param event Event)
  (constraint is Event FocusedInputEvent)
  (return
    (match event
      (case KeyPressEvent
        (let key-event (as event KeyPressEvent))
        (let saved (call (. key-event begin-route) box-event-route-next root-pointer origin origin null))
        (finally
          (inline (call (. key-event end-route) saved))
        )
        (<- (. target key-press) key-event)
        (. key-event is-canceled)
      )
      (case KeyInputEvent
        (let input-event (as event KeyInputEvent))
        (let saved (call (. input-event begin-route) box-event-route-next root-pointer origin origin null))
        (finally
          (inline (call (. input-event end-route) saved))
        )
        (<- (. target key-input) input-event)
        (. input-event is-canceled)
      )
      (case PasteEvent
        (let paste-event (as event PasteEvent))
        (let saved (call (. paste-event begin-route) box-event-route-next root-pointer origin origin null))
        (finally
          (inline (call (. paste-event end-route) saved))
        )
        (<- (. target paste) paste-event)
        (. paste-event is-canceled)
      )
    )
  )
  (blank)
  (lazy root-pointer (as root Pointer))
  (lazy origin (call Point 0 0))
)

(fn-do + box-event-route-next (? Pointer)
  (param raw-event Pointer)
  (param raw-current Pointer)
  (let event (call (of gc-object-from-pointer BoxEvent) raw-event))
  (return-if (if (== (. event route-root) raw-current)))
  (blank)
  (if (== (. event route-boundary) raw-current)
    (call (. event advance-route) (call Point 0 0))
    (return (. event route-root))
  )
  (let current (call (of gc-object-from-pointer Box) raw-current))
  (let parent (. current %parent))
  (return-if (if (not parent)))
  (blank)
  (let offset (call Point (- (. event route-offset x) (. parent scroll-x)) (- (. event route-offset y) (. parent scroll-y))))
  (call (. event advance-route) offset)
  (return (as parent Pointer))
)

(fn-expr + focus-mode-can-focus _
  (param mode FocusMode)
  (or (== mode (. FocusMode keys)) (== mode (. FocusMode input)))
)

(fn-expr + focus-mode-contributes-shortcuts _
  (param mode FocusMode)
  (or (== mode (. FocusMode keys)) (== mode (. FocusMode inside)))
)

(type _ TuiLayout (is U8)
  (variant clean)
  (variant children-only)
  (variant self)
)

(type _ FocusCandidateSearch
  (prop + current (? Box))
  (prop + going-backward _ (= false))
  (prop + first (? Box))
  (prop + last (? Box))
  (prop + before-current (? Box))
  (prop + after-current (? Box))
  (prop + is-current-found _ (= false))
  (fn-do + This _
    (param current _)
    (param going-backward _)
  )
  (fn-do + add _
    (param candidate Box)
    (if (not first)
      (= first candidate)
    )
    (blank)
    (= last candidate)
    (blank)
    (if current
      (let live-current current)
      (if (== (. candidate uid) (. live-current uid))
        (= is-current-found true)
        (return)
      )
    )
    (if is-current-found
      (if (not after-current)
        (= after-current candidate)
      )
      (else
        (= before-current candidate)
      )
    )
  )
  (fn-do + result _
    (return-if (if (not first)))
    (blank)
    (if (or (not current) (not is-current-found))
      (if going-backward
        (return last)
      )
      (return first)
    )
    (blank)
    (if going-backward
      (return (?? before-current last))
    )
    (blank)
    (return (?? after-current first))
  )
)
