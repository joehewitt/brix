(import ./code-syntax-style)
(import /math)
(import /tui)

(type + CodeRun (is (tuple (: text String) (: color AnsiColor))))

(type + CodeSurfacePoint (is (tuple (: row Size) (: column Size))))

(type + CodeSurfaceRow (is Tuple)
  (prop + runs (list CodeRun))
  (prop + number (? Size) (= null))
  (prop + selection-start Size (= 0))
  (prop + selection-end Size (= 0))
  (prop + selects-past-end _ (= false))
  (prop + rule (? String) (= null))
  (prop + rule-color AnsiColor (= code-line-number-color))
  (prop + background (? BackgroundColor) (= null))
)

(type + CodeClipboard
  (prop + text _ (= ""))
)

(type + CodeSurface (is Box)
  (rule This
    (= focus-mode (. FocusMode input))
  )
  (blank)
  (prop + top Size)
  (prop + left Size)
  (prop + shows-numbers _ (= true))
  (prop + clipboard CodeClipboard (= (call CodeClipboard)))
  (prop + cursor-point _ (=> (call surface-cursor-point)))
  (prop + shows-terminal-cursor _ (=> (and is-focused (call is-caret-visible))))
  (subscribe-for (on event mouse-down (when is-effectively-enabled))
    (call place-at (. event point) false)
  )
  (subscribe-for (on event mouse-drag (when is-effectively-enabled))
    (call place-at (. event point) true)
    (call (. event cancel))
  )
  (subscribe-for (on event scrolled)
    (call scroll-rows (. event direction))
    (call (. event cancel))
  )
  (fn-expr + surface-row-count Size
    0
  )
  (fn-expr + surface-row CodeSurfaceRow
    (param row Size)
    (call CodeSurfaceRow (call (of List CodeRun)))
  )
  (fn-expr + surface-caret CodeSurfacePoint
    (call CodeSurfacePoint 0 0)
  )
  (fn-expr + surface-number-limit Size
    (call surface-row-count)
  )
  (fn-do + surface-place _
    (param point CodeSurfacePoint)
    (param extends Bool)
  )
  (fn-expr + page-rows Size :get
    (if-expr (> text-height 1) (- text-height 1) 1)
  )
  (fn-expr + text-height Size :get
    (if-expr (> (. content-bounds height) 0) (as (. content-bounds height) Size) 0)
  )
  (fn-expr + text-width Size :get
    (if-expr (> width 0) (as width Size) 0)
    (where
      (lazy width (- (. content-bounds width) (call gutter-width)))
    )
  )
  (fn-do + copy-text _
    (param text String)
    (= (. clipboard text) text)
    (call (. (?. (of ancestor Window) terminal) write-clipboard) text)
  )
  (fn-do + place-at _
    (param point Point)
    (param extends Bool)
    (let content content-bounds)
    (let x (- (. point x) (. content x) (call gutter-width)))
    (let y (- (. point y) (. content y)))
    (return-if (if (< y 0)))
    (blank)
    (let column (+ left (if-expr (> x 0) (as x Size) 0)))
    (call surface-place (call CodeSurfacePoint (+ top (as y Size)) column) extends)
    (call reveal-caret)
  )
  (fn-do + scroll-rows _
    (param direction Direction)
    (let count (call surface-row-count))
    (let last (if-expr (> count text-height) (- count text-height) 0))
    (match direction
      (case .up
        (= top (if-expr (> top 3) (- top 3) 0))
      )
      (case .down
        (= top (call min (+ top 3) last))
      )
      (case .left
        (= left (if-expr (> left 3) (- left 3) 0))
      )
      (case .right
        (+= left 3)
      )
      (default
        (return)
      )
    )
    (call invalidate-paint)
  )
  (fn-do + reveal-caret _
    (let caret (call surface-caret))
    (let height text-height)
    (let width text-width)
    (if (> height 0)
      (if (< (. caret row) top)
        (= top (. caret row))
        (else-if (>= (. caret row) (+ top height))
          (= top (- (+ (. caret row) 1) height))
        )
      )
    )
    (if (> width 0)
      (if (< (. caret column) left)
        (= left (. caret column))
        (else-if (>= (. caret column) (+ left width))
          (= left (- (+ (. caret column) 1) width))
        )
      )
    )
    (call invalidate-paint)
  )
  (fn-do + center-caret _
    (let caret (call surface-caret))
    (let half (/ text-height 2))
    (= top (if-expr (> (. caret row) half) (- (. caret row) half) 0))
    (= left 0)
    (call reveal-caret)
  )
  (fn-do + gutter-width Coord
    (return-if 0 (if (not shows-numbers)))
    (blank)
    (let digits Coord 1)
    (let limit Size 10)
    (let count (call surface-number-limit))
    (while (>= count limit)
      (+= digits 1)
      (*= limit 10)
    )
    (return (+ (call max digits 3) 2))
  )
  (fn-expr + surface-cursor-point Point
    (call Point (+ (. content x) (call gutter-width) (as x Coord)) (+ (. content y) (as y Coord)))
    (where
      (lazy caret (call surface-caret))
      (lazy content content-bounds)
      (lazy x (- (as (. caret column) I64) (as left I64)))
      (lazy y (- (as (. caret row) I64) (as top I64)))
    )
  )
  (fn-expr + is-caret-visible Bool
    (and (>= (. caret row) top) (< (. caret row) (+ top text-height)) (>= (. caret column) left) (<= (. caret column) (+ left text-width)))
    (where
      (lazy caret (call surface-caret))
    )
  )
  (fn-do + paint _
    (param canvas Canvas)
    (if (not is-paint-visible)
      (call did-paint)
      (return)
    )
    (let content content-bounds)
    (let count (call surface-row-count))
    (let caret (call surface-caret))
    (do-use canvas
      (call (. canvas clip) content)
      (call (. canvas paint-background) code-background content)
      (= (. canvas background) null)
      (for (in y (..< 0 text-height))
        (let row (+ top y))
        (if (>= row count)
          (break)
        )
        (call paint-row canvas (call surface-row row) (+ (. content y) (as y Coord)) (== row (. caret row)))
      )
    )
    (call did-paint)
  )
  (fn-do _ paint-row _
    (param canvas Canvas)
    (param shown CodeSurfaceRow)
    (param y Coord)
    (param is-caret-row Bool)
    (let content content-bounds)
    (let gutter (call gutter-width))
    (let text-x (+ (. content x) gutter))
    (let band (?? (. shown background) (only-if code-current-line (if is-caret-row))))
    (if band
      (call (. canvas paint-background) band (call Rect (. content x) y (. content width) 1))
      (= (. canvas background) null)
    )
    (call paint-selection canvas shown text-x y)
    (let number (. shown number))
    (if (and (> gutter 0) (!= number null))
      (let label (str number))
      (= (. canvas text-color) (if-expr is-caret-row code-caret-number-color code-line-number-color))
      (call (. canvas move) (tuple (- text-x 1 (as (. label length) Coord)) y))
      (call (. canvas print) label)
    )
    (call (. canvas push))
    (call (. canvas clip) (call Rect text-x y (- (. content right) text-x) 1))
    (let rule (. shown rule))
    (if rule
      (= (. canvas text-color) (. shown rule-color))
      (call (. canvas move) (tuple text-x y))
      (call (. canvas print) (* rule text-width))
      (else
        (call paint-runs canvas (. shown runs) text-x y)
      )
    )
    (call (. canvas pop))
  )
  (fn-do _ paint-selection _
    (param canvas Canvas)
    (param shown CodeSurfaceRow)
    (param text-x Coord)
    (param y Coord)
    (let end (if-expr (. shown selects-past-end) (+ (. shown selection-end) 1) (. shown selection-end)))
    (return-if (if (<= end (. shown selection-start))))
    (blank)
    (let from (- (as (. shown selection-start) I64) (as left I64)))
    (let to (call min (- (as end I64) (as left I64)) (as text-width I64)))
    (return-if (if (or (<= to 0) (<= to from))))
    (blank)
    (let start (if-expr (> from 0) from 0))
    (call (. canvas paint-background)
      (block
        (arg code-selection)
        (arg (call Rect (+ text-x (as start Coord)) y (as (- to start) Coord) 1))
      )
    )
    (= (. canvas background) null)
  )
  (fn-do _ paint-runs _
    (param canvas Canvas)
    (param runs (list CodeRun))
    (param text-x Coord)
    (param y Coord)
    (let origin (as text-x I64))
    (let right (+ origin (as text-width I64)))
    (let x (- origin (as left I64)))
    (for (in run runs)
      (if (>= x right)
        (break)
      )
      (let display (call DisplayText (. run text)))
      (let next (+ x (as (. display display-width) I64)))
      (if (> next origin)
        (let text (. run text))
        (let start x)
        (if (< start origin)
          (let skipped Index 0)
          (while (and (< skipped (. display codepoint-count)) (<= (+ start (as (call (. display width-at) skipped) I64)) origin))
            (+= start (as (call (. display width-at) skipped) I64))
            (+= skipped 1)
          )
          (= text ([] text (... skipped)))
        )
        (= (. canvas text-color) (. run color))
        (call (. canvas move) (tuple (as start Coord) y))
        (call (. canvas print-display-text) (call DisplayText text))
      )
      (= x next)
    )
  )
)
