+ runs [CodeRun]
+ number Size? = null
+ selection-start Size = 0
+ selection-end Size = 0
+ selects-past-end = false
+ rule String? = null
+ rule-color AnsiColor = code-line-number-color
+ background BackgroundColor? = null

