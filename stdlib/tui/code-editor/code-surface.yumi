• This
    focus-mode = FocusMode.input

+ top Size
+ left Size
+ shows-numbers = true
+ clipboard CodeClipboard = CodeClipboard()
+ cursor-point => surface-cursor-point()
+ shows-terminal-cursor => is-focused && is-caret-visible()

────────────────────
for event on mouse-down when is-effectively-enabled

place-at(event.point, false)

────────────────────
for event on mouse-drag when is-effectively-enabled

place-at(event.point, true)
event.cancel()

────────────────────
for event on scrolled

scroll-rows(event.direction)
event.cancel()

────────────────────
+ surface-row-count Size

0

────────────────────
+ surface-row CodeSurfaceRow
    - row Size

CodeSurfaceRow(List'CodeRun())

────────────────────
+ surface-caret CodeSurfacePoint

CodeSurfacePoint(0, 0)

────────────────────
+ surface-number-limit Size

surface-row-count()

────────────────────
+ do surface-place
    - point CodeSurfacePoint
    - extends Bool

────────────────────
+ get page-rows Size

if text-height > 1 then text-height - 1 else 1

────────────────────
+ get text-height Size

if content-bounds.height > 0 then content-bounds.height as Size else 0

────────────────────
+ get text-width Size

if width > 0 then width as Size else 0

.. width = content-bounds.width - gutter-width()

────────────────────
+ do copy-text
    - text String

clipboard.text = text
ancestor'Window?.terminal.write-clipboard(text)

────────────────────
+ do place-at
    - point Point
    - extends Bool

. content = content-bounds
. x = point.x - content.x - gutter-width()
. y = point.y - content.y
=? if y < 0
. column = left + (if x > 0 then x as Size else 0)
surface-place(CodeSurfacePoint(top + (y as Size), column), extends)
reveal-caret()

────────────────────
+ do scroll-rows
    - direction Direction

. count = surface-row-count()
. last = if count > text-height then count - text-height else 0
do match direction
    | .up
        top = if top > 3 then top - 3 else 0
    | .down
        top = min(top + 3, last)
    | .left
        left = if left > 3 then left - 3 else 0
    | .right
        left += 3
    ??
        =
invalidate-paint()

────────────────────
+ do reveal-caret

. caret = surface-caret()
. height = text-height
. width = text-width
if height > 0
    if caret.row < top
        top = caret.row
    else if caret.row >= top + height
        top = caret.row + 1 - height
if width > 0
    if caret.column < left
        left = caret.column
    else if caret.column >= left + width
        left = caret.column + 1 - width
invalidate-paint()

────────────────────
+ do center-caret

. caret = surface-caret()
. half = text-height / 2
top = if caret.row > half then caret.row - half else 0
left = 0
reveal-caret()

────────────────────
+ do gutter-width Coord

=? 0 if !shows-numbers
. digits Coord = 1
. limit Size = 10
. count = surface-number-limit()
while count >= limit
    digits += 1
    limit *= 10
= max(digits, 3) + 2

────────────────────
+ surface-cursor-point Point

Point(content.x + gutter-width() + (x as Coord), content.y + (y as Coord))

.. caret = surface-caret()
.. content = content-bounds
.. x = (caret.column as I64) - (left as I64)
.. y = (caret.row as I64) - (top as I64)

────────────────────
+ is-caret-visible Bool

caret.row >= top && caret.row < top + text-height && caret.column >= left && caret.column <= left + text-width

.. caret = surface-caret()

────────────────────
+ do paint
    - canvas Canvas

if !is-paint-visible
    did-paint()
    =
. content = content-bounds
. count = surface-row-count()
. caret = surface-caret()
do use canvas
    canvas.clip(content)
    canvas.paint-background(code-background, content)
    canvas.background = null
    for y in 0 .. < text-height
        . row = top + y
        if row >= count
            break
        paint-row(canvas, surface-row(row), content.y + (y as Coord), row == caret.row)
did-paint()

────────────────────
_ do paint-row
    - canvas Canvas
    - shown CodeSurfaceRow
    - y Coord
    - is-caret-row Bool

. content = content-bounds
. gutter = gutter-width()
. text-x = content.x + gutter
. band = shown.background ?? (code-current-line if is-caret-row)
if band
    canvas.paint-background(band, Rect(content.x, y, content.width, 1))
    canvas.background = null
paint-selection(canvas, shown, text-x, y)
. number = shown.number
if gutter > 0 && number != null
    . label = "$number"
    canvas.text-color = if is-caret-row then code-caret-number-color else code-line-number-color
    canvas.move((text-x - 1 - (label.length as Coord), y))
    canvas.print(label)
canvas.push()
canvas.clip(Rect(text-x, y, content.right - text-x, 1))
. rule = shown.rule
if rule
    canvas.text-color = shown.rule-color
    canvas.move((text-x, y))
    canvas.print(rule * text-width)
else
    paint-runs(canvas, shown.runs, text-x, y)
canvas.pop()

────────────────────
_ do paint-selection
    - canvas Canvas
    - shown CodeSurfaceRow
    - text-x Coord
    - y Coord

. end = if shown.selects-past-end then shown.selection-end + 1 else shown.selection-end
=? if end <= shown.selection-start
. from = (shown.selection-start as I64) - (left as I64)
. to = min((end as I64) - (left as I64), text-width as I64)
=? if to <= 0 || to <= from
. start = if from > 0 then from else 0
canvas.paint-background
    - code-selection
    - Rect(text-x + (start as Coord), y, (to - start) as Coord, 1)
canvas.background = null

────────────────────
_ do paint-runs
    - canvas Canvas
    - runs [CodeRun]
    - text-x Coord
    - y Coord

. origin = text-x as I64
. right = origin + (text-width as I64)
. x = origin - (left as I64)
for run in runs
    if x >= right
        break
    . display = DisplayText(run.text)
    . next = x + (display.display-width as I64)
    if next > origin
        . text = run.text
        . start = x
        if start < origin
            . skipped Index = 0
            while skipped < display.codepoint-count && start + (display.width-at(skipped) as I64) <= origin
                start += display.width-at(skipped) as I64
                skipped += 1
            text = text[skipped ...]
        canvas.text-color = run.color
        canvas.move((start as Coord, y))
        canvas.print-display-text(DisplayText(text))
    x = next
