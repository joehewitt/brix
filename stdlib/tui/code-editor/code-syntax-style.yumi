/code/syntax
/graphics/color
/tui

+ code-background = BackgroundColor.rgba(RGBA("#0d1117"))
+ code-current-line = BackgroundColor.rgba(RGBA("#161b22"))
+ code-selection = BackgroundColor.rgba(RGBA("#264f78"))
+ code-held-band = BackgroundColor.rgba(RGBA("#3d1a1d"))
+ code-plain-color = AnsiColor(252)
+ code-comment-color = AnsiColor(245)
+ code-keyword-color = AnsiColor(210)
+ code-operator-color = AnsiColor(216)
+ code-punctuation-color = AnsiColor(248)
+ code-string-color = AnsiColor(153)
+ code-escape-color = AnsiColor(80)
+ code-number-color = AnsiColor(117)
+ code-function-color = AnsiColor(183)
+ code-type-color = AnsiColor(215)
+ code-parameter-color = AnsiColor(222)
+ code-tag-color = AnsiColor(114)
+ code-invalid-color = AnsiColor(203)
+ code-line-number-color = AnsiColor(243)
+ code-caret-number-color = AnsiColor(255)
+ code-fold-color = AnsiColor(242)

━━━━━━━━━━━━━━━━━━━━
+ code-role-color AnsiColor
    - role SyntaxRole

match role
    | .comment
        code-comment-color
    | .keyword
        code-keyword-color
    | .operator
        code-operator-color
    | .punctuation
        code-punctuation-color
    | .string
        code-string-color
    | .escape
        code-escape-color
    | .number
        code-number-color
    | .constant
        code-number-color
    | .function
        code-function-color
    | .type-name
        code-type-color
    | .parameter
        code-parameter-color
    | .builtin
        code-number-color
    | .property
        code-number-color
    | .attribute
        code-number-color
    | .tag
        code-tag-color
    | .label
        code-number-color
    | .namespace
        code-type-color
    | .invalid
        code-invalid-color
    ??
        code-plain-color
