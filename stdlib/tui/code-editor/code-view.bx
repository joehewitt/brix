(import ./code-surface)
(import ./code-syntax-style)
(import /code)
(import /code/syntax)
(import /math)
(import /tui)
(import /ui/input)

(type + CodeEditor (is CodeSurface)
  (prop + session (? CodeSession))
  (prop + caret-line Size)
  (prop + caret-column Size)
  (prop + line-count Size)
  (prop + language-title String (= "Plain Text"))
  (prop + is-modified Bool)
  (event + save-requested CodeSession)
  (blank)
  (prop _ shown-generation U64)
  (subscribe-for (on event key-input)
    (let active session)
    (if (and active (. event modifiers control))
      (if (call press active (. event char))
        (call (. event cancel))
      )
      (else-if (and active (not (. event modifiers option)) (not (. event modifiers command)))
        (call (. active type) (as (. event char) String))
        (call refresh)
        (call (. event cancel))
      )
    )
  )
  (subscribe-for (on event paste)
    (let active session)
    (if active
      (call (. active paste) (. event text))
      (call refresh)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event key-press)
    (if (call handle-key event)
      (call (. event cancel))
    )
  )
  (fn-do + show _
    (param next CodeSession)
    (+= shown-generation 1)
    (let generation shown-generation)
    (= session next)
    (= language-title (if-expr (. next language) (. next language title) "Plain Text"))
    (= top 0)
    (= left 0)
    (call refresh)
    (for (on revision (. next updated) (until (!= generation shown-generation)))
      (call refresh)
    )
  )
  (fn-do + clear _
    (+= shown-generation 1)
    (= session null)
    (= line-count 0)
    (call invalidate-paint)
  )
  (fn-do + jump-to _
    (param line Size)
    (param column Size (= 0))
    (let active session)
    (return-if (if (not active)))
    (call (. active place) line (as column Float))
    (call refresh)
    (call center-caret)
  )
  (fn-do + refresh _
    (let active session)
    (return-if (if (not active)))
    (= caret-line (. active caret-line))
    (= caret-column (. active caret-column))
    (= line-count (. active line-count))
    (= is-modified (. active is-modified))
    (call reveal-caret)
  )
  (fn-do + handle-key Bool
    (param event KeyPressEvent)
    (let active session)
    (return-if false (if (not active)))
    (let extends (call code-event-shift event))
    (let word (call code-event-option event))
    (match (. event key)
      (case= (. Key backspace)
        (if word
          (call (. active delete-word-backward))
          (else
            (call (. active delete-backward))
          )
        )
      )
      (case= (. Key delete)
        (if word
          (call (. active delete-word-forward))
          (else
            (call (. active delete-forward))
          )
        )
      )
      (case= (. Key arrow-left)
        (if word
          (call (. active move-word-left) extends)
          (else
            (call (. active move-left) extends)
          )
        )
      )
      (case= (. Key arrow-right)
        (if word
          (call (. active move-word-right) extends)
          (else
            (call (. active move-right) extends)
          )
        )
      )
      (case= (. Key arrow-up)
        (call (. active move-up) extends)
      )
      (case= (. Key arrow-down)
        (call (. active move-down) extends)
      )
      (case= (. Key home)
        (call (. active move-to-line-start) extends)
      )
      (case= (. Key end)
        (call (. active move-to-line-end) extends)
      )
      (case= (. Key page-up)
        (call (. active move-up) extends page-rows)
      )
      (case= (. Key page-down)
        (call (. active move-down) extends page-rows)
      )
      (case= (. Key enter)
        (call (. active newline))
      )
      (case= (. Key tab)
        (if extends
          (call (. active outdent-lines))
          (else
            (call (. active insert-tab))
          )
        )
      )
      (case= (. Key escape)
        (call (. active collapse))
      )
      (default
        (return false)
      )
    )
    (call refresh)
    (return true)
  )
  (fn-do + press Bool
    (param active CodeSession)
    (param char Char)
    (match char
      (case= 'a'
        (call (. active select-all))
      )
      (case= 'c'
        (if (. active has-selection)
          (call copy-text (. active selected-text))
        )
      )
      (case= 'x'
        (if (. active has-selection)
          (call copy-text (. active selected-text))
          (call (. active delete-selection))
        )
      )
      (case= 'v'
        (call (. active paste) (. clipboard text))
      )
      (case= 'z'
        (let ignored (call (. active undo)))
      )
      (case= 'y'
        (let ignored (call (. active redo)))
      )
      (case= 's'
        (<- save-requested active)
      )
      (default
        (return false)
      )
    )
    (call refresh)
    (return true)
  )
  (fn-expr + surface-row-count Size
    (if-expr active (call (. active folds row-count) (. active line-count)) 0)
    (where
      (lazy active session)
    )
  )
  (fn-expr + surface-number-limit Size
    line-count
  )
  (fn-do + surface-row CodeSurfaceRow
    (param row Size)
    (let active (!! session))
    (let line (call (. active folds actual) row))
    (let runs (call (of List CodeRun) (in (call CodeRun (. each text) (call code-role-color (. each role))) (call (. active styled-runs) line))))
    (if (call (. active folds is-folded) line)
      (+= runs (call CodeRun " ⋯" code-fold-color))
    )
    (let start (. active selection-start))
    (let end (. active selection-end))
    (let first (call (. active text line-at) start))
    (let last (call (. active text line-at) end))
    (if (or (== start end) (< line first) (> line last))
      (return (call CodeSurfaceRow runs (+ line 1)))
    )
    (let from (if-expr (== line first) (call (. active display-column) start) 0))
    (let to (if-expr (== line last) (call (. active display-column) end) (call (. active line-columns) line)))
    (return (call CodeSurfaceRow runs (+ line 1) from to (< line last)))
  )
  (fn-expr + surface-caret CodeSurfacePoint
    (case? (not active)
      (call CodeSurfacePoint 0 0)
    )
    (default
      (call CodeSurfacePoint (call (. active folds shown) (. active caret-line)) (. active caret-column))
    )
    (where
      (lazy active session)
    )
  )
  (fn-do + surface-place _
    (param point CodeSurfacePoint)
    (param extends Bool)
    (let active session)
    (return-if (if (not active)))
    (call (. active place) (call (. active folds actual) (. point row)) (as (. point column) Float) extends)
    (call refresh)
  )
)

(fn-expr + code-event-shift Bool
  (param event KeyPressEvent)
  (. event modifiers shift)
)

(fn-expr + code-event-option Bool
  (param event KeyPressEvent)
  (. event modifiers option)
)
