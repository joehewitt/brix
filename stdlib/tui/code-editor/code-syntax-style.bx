(import /code/syntax)
(import /graphics/color)
(import /tui)
(blank)
(prop + code-background _ (= (call (. BackgroundColor rgba) (call RGBA "#0d1117"))))
(prop + code-current-line _ (= (call (. BackgroundColor rgba) (call RGBA "#161b22"))))
(prop + code-selection _ (= (call (. BackgroundColor rgba) (call RGBA "#264f78"))))
(prop + code-held-band _ (= (call (. BackgroundColor rgba) (call RGBA "#3d1a1d"))))
(prop + code-plain-color _ (= (call AnsiColor 252)))
(prop + code-comment-color _ (= (call AnsiColor 107)))
(prop + code-keyword-color _ (= (call AnsiColor 210)))
(prop + code-operator-color _ (= (call AnsiColor 216)))
(prop + code-punctuation-color _ (= (call AnsiColor 248)))
(prop + code-string-color _ (= (call AnsiColor 153)))
(prop + code-escape-color _ (= (call AnsiColor 80)))
(prop + code-number-color _ (= (call AnsiColor 117)))
(prop + code-function-color _ (= (call AnsiColor 183)))
(prop + code-type-color _ (= (call AnsiColor 215)))
(prop + code-parameter-color _ (= (call AnsiColor 222)))
(prop + code-tag-color _ (= (call AnsiColor 114)))
(prop + code-invalid-color _ (= (call AnsiColor 203)))
(prop + code-line-number-color _ (= (call AnsiColor 243)))
(prop + code-caret-number-color _ (= (call AnsiColor 255)))
(prop + code-fold-color _ (= (call AnsiColor 242)))

(fn-expr + code-role-color AnsiColor
  (param role SyntaxRole)
  (match role
    (case .comment
      code-comment-color
    )
    (case .keyword
      code-keyword-color
    )
    (case .operator
      code-operator-color
    )
    (case .punctuation
      code-punctuation-color
    )
    (case .string
      code-string-color
    )
    (case .escape
      code-escape-color
    )
    (case .number
      code-number-color
    )
    (case .constant
      code-number-color
    )
    (case .function
      code-function-color
    )
    (case .type-name
      code-type-color
    )
    (case .parameter
      code-parameter-color
    )
    (case .builtin
      code-number-color
    )
    (case .property
      code-number-color
    )
    (case .attribute
      code-number-color
    )
    (case .tag
      code-tag-color
    )
    (case .label
      code-number-color
    )
    (case .namespace
      code-type-color
    )
    (case .invalid
      code-invalid-color
    )
    (default
      code-plain-color
    )
  )
)
