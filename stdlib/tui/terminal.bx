(import /os/file)
(import /data)
(import /data/stream)
(import /os/signal)
(import /os/tty)
(import /graphics/color)
(import /time/debounced)
(import /time/duration)
(import /time/timer)
(import ./cterm)
(import ./primitives)
(import ./events)
(import ./input)
(import ./canvas)
(import ./colors)
(import /BxCore/BxCore.h)
(import /sys/ioctl.h)
(blank)
(prop + full-screen-code _ (= 1049))
(prop + mouse-code _ (= (list 1000 1001 1002 1003 1006)))
(prop + show-cursor-code _ (= 25))
(prop + auto-wrap-code _ (= 7))
(prop + bracketed-paste-code _ (= 2004))
(prop + synchronized-output-code _ (= 2026))
(prop + resize-settle-delay _ (= 80ms))
(blank)
; 24fps is all xterm can handle
(prop + terminal-frame-interval _ (= 42ms))
(blank)
; 60fps looks great in ghostty and mac terminal
;  + terminal-frame-interval = 16666667ns
(blank)
(type-line + TerminalPaintResult (is (tuple (: cursor-point Point) (: is-cursor-shown Bool))))

(type + Terminal
  (implements Closable)
  (prop + painter (? TerminalPainter))
  (blank)
  (prop + is-raw _ (= true))
  (prop + sends-signals _ (= true))
  (prop + is-full-screen _ (= false))
  (prop + is-mouse-handled _ (= false))
  (prop + is-cursor-shown _ (= false))
  (prop + is-open _ (= true))
  (event + ready Terminal)
  (event + resized PSize)
  (event + closed Terminal)
  (event + mouse-down MouseDownEvent)
  (event + mouse-up MouseUpEvent)
  (event + mouse-move MouseMoveEvent)
  (event + mouse-drag MouseDragEvent)
  (event + scroll ScrollEvent)
  (event + key-press KeyPressEvent)
  (event + char KeyInputEvent)
  (event + paste PasteEvent)
  (blank)
  (prop _ is-painting _ (= false))
  (prop _ paint-task U32)
  (prop _ paint-finished (of SyncBufferedChannel Bool))
  (blank)
  (prop _ close-wait (of SyncBufferedChannel Bool))
  (prop _ tty-in _ (= (call File (list "/dev/tty" "/dev/stdin") (. FileFlags read-mode))))
  (prop + view-size _ (= (call PSize 0 10)))
  (prop _ origin-x Coord)
  (prop _ origin-y Coord)
  (prop _ cursor-x Coord)
  (prop _ cursor-y Coord)
  (prop _ is-paint-invalid _ (= true))
  (prop _ is-resizing _ (= false))
  (prop _ settle-resize _ (:= (call debounced resize-settle-delay (. this finish-resize))))
  (prop _ previous-canvas (? Canvas))
  (prop _ current-canvas (? Canvas))
  (prop _ frame-output _ (= (call (of DataStream Byte) 8192)))
  (prop _ term-state _ (= ([] Termios 1)))
  (prop _ cursor-query (of AsyncChannel CursorEvent))
  (blank)
  (prop _ paint-loop _ (:= (call (. terminal-frame-interval animation-loop) (:with repaint))))
  (blank)
  (delegate (of Writable String))
  (prop _ tty-out _ (= (call File (list "/dev/tty" "/dev/stdout") (. FileFlags write-mode))))
  (fn-do + This _
    (param painter (? TerminalPainter))
    (param is-full-screen _ (= false))
    (param is-mouse-handled _ (= false))
    (param is-cursor-shown _ (= true))
  )
  (subscribe-for (on sig sig-wnch (whenever #is-open))
    (= is-resizing true)
    (call sync-size)
    (call schedule-paint)
    (call settle-resize)
  )
  (when-rule #is-raw
    (call C:brixTerminalEnter tty-in term-state)
    (call apply-signals)
    (call sync-size)
  )
  (whenever-rule #sends-signals
    (call apply-signals)
  )
  (when-rule (not #is-raw)
    (call C:brixTerminalExit tty-in term-state)
  )
  (when-rule #is-open
    (do-new
      (call set-mode auto-wrap-code false)
      (call set-mode bracketed-paste-code true)
      (call fill-out)
      (<- ready this)
      (blank)
      (for (in event (in (~ TerminalEvents) (call TerminalInput tty-in)))
        (if (is event KeyPressEvent)
          (<- key-press (as event KeyPressEvent))
          (else-if (is event KeyInputEvent)
            (<- char (as event KeyInputEvent))
          )
          (else-if (is event PasteEvent)
            (<- paste (as event PasteEvent))
          )
          (else-if (is event MouseDownEvent)
            (<- mouse-down (as event MouseDownEvent))
          )
          (else-if (is event MouseUpEvent)
            (<- mouse-up (as event MouseUpEvent))
          )
          (else-if (is event MouseMoveEvent)
            (<- mouse-move (as event MouseMoveEvent))
          )
          (else-if (is event MouseDragEvent)
            (<- mouse-drag (as event MouseDragEvent))
          )
          (else-if (is event ScrollEvent)
            (<- scroll (as event ScrollEvent))
          )
          (else-if (is event CursorEvent)
            (<- cursor-query event)
          )
        )
      )
      (blank)
      (call close)
    )
  )
  (when-rule #is-full-screen
    (call set-mode full-screen-code is-full-screen)
  )
  (when-rule #is-mouse-handled
    (call set-mode mouse-code is-mouse-handled)
  )
  (when-rule #is-cursor-shown
    (call set-mode show-cursor-code is-cursor-shown)
  )
  (fn-expr + text-color _ :set (param color AnsiColor)
    (call escapes (str "[38;5;" colorm))
  )
  (fn-expr + text-color _ :set (param color RGBA)
    (call escapes (str "[38;2;" r ";" g ";" b "m")
      (block
        (lazy r (as (* (. color red) 255) Int))
        (lazy g (as (* (. color green) 255) Int))
        (lazy b (as (* (. color blue) 255) Int))
      )
    )
  )
  (fn-expr + background _ :set (param color AnsiColor)
    (call escapes (str "[48;5;" color "m"))
  )
  (fn-expr + background _ :set (param color RGBA)
    (call escapes (str "[48;2;" r ";" g ";" b "m")
      (block
        (lazy r (as (* (. color red) 255) Int))
        (lazy g (as (* (. color green) 255) Int))
        (lazy b (as (* (. color blue) 255) Int))
      )
    )
  )
  (fn-do + background _ :set (param color HSVA)
    (= background (as color RGBA))
  )
  (fn-do + cursor _
    (call escapes "[6n")
    (let (tuple point _) (<- cursor-query))
    (return point)
  )
  (fn-expr + move _
    (param point Point)
    (call write-move tty-out point)
  )
  (fn-expr + move-by _
    (param offset Point)
    (call move (+ cursor offset))
  )
  (fn-do + clear _
    (param color AnsiColor (= black))
    (call escapes (str "[48;5;" colorm))
    (call escapes "[0J")
  )
  (fn-do + schedule-paint _
    (return-if (if (not is-open)))
    (= is-paint-invalid true)
    (call (. paint-loop request-now))
  )
  (fn-do + schedule-animation-frame _
    (return-if (if (not is-open)))
    (= is-paint-invalid true)
    (call (. paint-loop request-next))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (catch (call close))
  )
  (fn-do + close _
    (if is-open
      (= is-open false)
      (call (. paint-loop cancel))
      (let closes-from-paint (and is-painting (== paint-task (call get-current-task-id))))
      (blank)
      (do-new @detached
        (if is-painting
          (<- paint-finished)
        )
        (call restore-terminal)
        (call finish-close)
      )
      (blank)
      (if (not closes-from-paint)
        (<- close-wait)
      )
    )
  )
  (fn-do _ write-move _
    (param out _)
    (param point Point)
    (= cursor-x (. point x))
    (= cursor-y (. point y))
    (let col (+ (. point x) origin-x 1))
    (let row (+ (. point y) origin-y 1))
    (return (call write-escape out (str "[" row ";" col "H")))
  )
  (fn-do _ repaint _
    (if (and is-open is-paint-invalid painter (not is-painting) (not is-resizing))
      (let frame-start-nanos (call monotonic-time-nanoseconds))
      ;  //+-tui.paint// Repaint terminal
      (probe-count tui.paint.frames)
      (probe-count tui.frame.actual)
      (probe-group + tui.paint.frame)
      (probe-group + tui.frame.total)
      (= is-paint-invalid false)
      (= is-painting true)
      (= paint-task (call get-current-task-id))
      (finally
        (= is-painting false)
        (= paint-task 0)
        (if (not is-open)
          (<- paint-finished true)
        )
      )
      (blank)
      (probe-group + tui.frame.canvas)
      (let canvas Canvas)
      (if (and current-canvas (== (. current-canvas width) (. view-size width)) (== (. current-canvas height) (. view-size height)))
        (= canvas current-canvas)
        (= current-canvas null)
        (else
          (= canvas (call Canvas view-size))
        )
      )
      (call (. canvas reset))
      (probe-group - tui.frame.canvas)
      (blank)
      ;  //this:paint -> canvas
      (probe-group + tui.frame.app-paint)
      (let paint-result (call TerminalPaintResult (tuple 0 0) is-cursor-shown))
      (if painter
        (= paint-result (call (. painter paint) canvas))
      )
      (probe-group - tui.frame.app-paint)
      (return-if (if (not is-open)))
      (blank)
      (probe-group + tui.frame.output)
      (call (. frame-output reset))
      (call write-mode frame-output show-cursor-code false)
      (call write-mode frame-output synchronized-output-code true)
      (if previous-canvas
        (probe-count tui.frame.diff-dumps)
        (probe-group + tui.frame.dump-diff)
        (call (. canvas dump-diff) frame-output previous-canvas)
        (probe-group - tui.frame.dump-diff)
        (else
          (probe-count tui.frame.full-dumps)
          (probe-log tui.frame.event.dump-full (items: (. view-size width) (. view-size height)))
          (probe-group + tui.frame.dump-full)
          (call (. canvas dump) frame-output)
          (probe-group - tui.frame.dump-full)
        )
      )
      ; Flush the frame before moving the real terminal cursor out of any right-margin state.
      (call write-mode frame-output synchronized-output-code false)
      (probe-group + tui.frame.cursor)
      (call write-move frame-output (. paint-result cursor-point))
      (probe-group - tui.frame.cursor)
      (if (. paint-result is-cursor-shown)
        (call write-mode frame-output show-cursor-code true)
      )
      (call (. tty-out write) (. frame-output data) (. frame-output length))
      (probe-group - tui.frame.output)
      (blank)
      (= current-canvas previous-canvas)
      (= previous-canvas canvas)
      (blank)
      (probe-log tui.frame.event.end (items: (. view-size width) (. view-size height)))
      (probe-group - tui.frame.total)
      (probe-group - tui.paint.frame)
      (blank)
      (let frame-elapsed-nanos (- (call monotonic-time-nanoseconds) frame-start-nanos))
      (let frame-interval-nanos (as terminal-frame-interval U64))
      (let frame-budget-nanos 0u64)
      (if (< frame-elapsed-nanos frame-interval-nanos)
        (= frame-budget-nanos (- frame-interval-nanos frame-elapsed-nanos))
      )
      (call C:brixGCFrameBudget frame-budget-nanos)
    )
  )
  (fn-do + write-clipboard _
    (param text String)
    (<- tty-out (str "\x1b]52;c;" (as (call (of Array Byte) text) Base64) "\x07"))
  )
  (fn-do _ apply-signals _
    (return-if (if (not is-raw)))
    (call C:brixTerminalSetSignals tty-in (if-expr sends-signals 1 0))
  )
  (fn-do _ sync-size _
    (probe-count tui.resize.events)
    (probe-group + tui.resize.sync-size)
    (let win-size ([] Winsize 1))
    (let err (call C:brixioctl tty-out C:TIOCGWINSZ win-size))
    (if err
      (throw (call Error "Unable to read terminal size"))
    )
    (blank)
    (let size ([] win-size 0))
    (let w (. size col))
    (let h (. size row))
    ;  //tui.events.sync-size -> w, h
    (probe-log tui.resize.event.sync-size (items: w h))
    (blank)
    (let previous-view-size view-size)
    (= view-size
      (block
        (case? is-full-screen
          (tuple w h)
        )
        (default
          (tuple w (. view-size height))
        )
      )
    )
    (blank)
    (if (!= view-size previous-view-size)
      (= previous-canvas null)
      (= current-canvas null)
    )
    (blank)
    (<- resized view-size)
    (probe-group - tui.resize.sync-size)
  )
  (fn-do _ finish-resize _
    (return-if (if (not is-open)))
    (= is-resizing false)
    (call schedule-paint)
    (call repaint)
  )
  (fn-expr _ escapes _
    (param text _)
    ; _ escapes <- text
    (blank)
    ;  //tui.terminal.escapes// text
    (call write-escape tty-out text)
  )
  (fn-do _ write-escape _
    (param out _)
    (param text _)
    (<- out (str "\x1b" text))
    (return out)
  )
  (fn-expr _ set-mode _
    (param code Int)
    (param is-on Bool)
    ; _ mode[code Int] = is-on Bool
    (blank)
    (call write-mode tty-out code is-on)
  )
  (fn-do _ set-mode _
    (param codes (list Int))
    (param is-on Bool)
    (for (in code codes)
      (call set-mode code is-on)
    )
  )
  (fn-expr _ write-mode _
    (param out _)
    (param code Int)
    (param is-on Bool)
    (call write-escape out (str "[?" code on-or-off)
      (block
        (lazy on-or-off (if-expr is-on "h" "l"))
      )
    )
  )
  (fn-do _ fill-out _
    (= origin-y cursor-y)
    (blank)
    ;  //tui.terminal.fill-out// view-size.height
    (return (<- tty-out (* "\n" (. view-size height))))
  )
  (fn-do _ restore-terminal _
    (catch (call set-mode mouse-code false))
    (catch (call set-mode synchronized-output-code false))
    (catch (call set-mode bracketed-paste-code false))
    (catch (call set-mode auto-wrap-code true))
    (catch (call set-mode full-screen-code false))
    (catch (call set-mode show-cursor-code true))
    (catch (call C:brixTerminalExit tty-in term-state))
  )
  (fn-do _ finish-close _
    (catch (call (. tty-in close)))
    (catch (call (. tty-out close)))
    (call (. paint-loop cancel))
    (<- closed this)
    (<- close-wait true)
    (blank)
    ; ----------------------------------------------------------------------------------------------------
    ; whenever is-open
    ;
    ; mode[full-screen-code] = #is-full-screen
    ; mode[mouse-code] = #is-mouse-handled
    ; mode[show-cursor-code] = #is-cursor-shown
    (blank)
    ; on sig-wnch
    ;     sync-size()
    ;     schedule-paint()
  )
)

(type + TerminalPainter (is Interface)
  (fn-expr + paint TerminalPaintResult
    (param canvas Canvas)
  )
)
