(import ./border)
(import ./box)
(import ./colors)
(import ./events)
(import ./layout)
(import ./listbox)
(import ./painter)
(import ./position)
(import ./primitives)
(import ./shortcuts)
(import ./styles)
(import ./text)
(import ./theme)
(import ./window)
(import /core/channel)
(import /core/markup)
(import /math)
(import /ui/input)

(style-extend TUIDefaultTheme
  (using BoxPaint)
  (using BoxBorder)
  (using BoxSpacing)
  (rule ColumnTree
    (= background-color (call AnsiColor 0))
    (blank)
    (rule ListItem
      (when-style #has-children
        (= padding-right 2)
        (blank)
        (<> Label (slot: after) (text: "›") (• absolute)
          (= anchor style-target)
          (= right 1)
          (= align-y center)
        )
      )
    )
  )
  (blank)
  (rule ColumnTreeColumn
    (= background-color (call AnsiColor 0))
    (= border-style (. BorderStyle single))
    (= border-color (call AnsiColor 8))
    (blank)
    (when-style #is-active-column
      (= border-color (call AnsiColor 14))
    )
  )
  (blank)
  (rule ColumnTreeColumnSpace
    (= background-color (call AnsiColor 0))
  )
)

(type + (of ColumnTree Item) (is Box)
  (rule This
    (= focus-mode (. FocusMode inside))
  )
  (blank)
  (prop + root-node (? Item))
  (prop + load-children (of ColumnTreeChildProvider Item) (= column-tree-no-children))
  (prop + key-builder (? (of MarkupKeyBuilder Item)))
  (prop + active-column (? (of ColumnTreeColumn Item)))
  (prop + selected-item (? Item)
    (=
      (call (of column-tree-selected-item-from Item)
        (block
          (arg (. #path #active-index))
          (arg (. #path #levels))
        )
      )
    )
  )
  (prop + owners (list Item)
    (=
      (call (of column-tree-owners-from Item)
        (block
          (arg #root-node)
          (arg (. #path #levels))
        )
      )
    )
  )
  (prop + can-go-back Bool (= (> (. #path #active-index) 0)))
  (prop + can-enter Bool
    (=
      (call (of column-tree-can-enter-from Item)
        (block
          (arg (. #path #active-index))
          (arg (. #path #levels))
          (arg (?? (?. (?. #active-column #selected-row) #has-children) false))
        )
      )
    )
  )
  (blank)
  (event + active-column-changed ActivateEvent)
  (event + selected SelectEvent)
  (event + activated ActivateEvent)
  (event + interacted Bool)
  (event _ level-mounted Bool)
  (event _ laid-out Bool)
  (event _ path-shortened Bool)
  (event _ focus-requests ColumnFocusRequest)
  (event _ scroll-requests ColumnScrollRequest)
  (blank)
  (prop _ path (of ColumnTreePath Item))
  (prop _ viewport-retention ColumnTreeViewportRetention)
  (prop _ pending-preview-level-id (? String))
  (prop + focus _
    (machine
      (state settled)
      (state (call waiting-for-level i id) (trigger for (tuple i id) focus-requests)
        (blank)
        (then (call applying i id) (trigger if (!= (call requested-column i id) null)))
        (blank)
        (then (call applying i id) (trigger on level-mounted (!= (call requested-column i id) null)))
        (blank)
        (then settled (trigger on path-shortened (!= (call (. path level-id) i) id)))
      )
      (blank)
      (state (call applying i id)
        (do
          (let column (call requested-column i id))
          (if column
            (call (?. (of ancestor Window) focus) column)
            (call ensure-active-column-visible)
            (call publish-active-column-changed)
          )
        )
        (blank)
        (then settled (trigger if true))
      )
    )
  )
  (prop + scroll-into-view _
    (machine
      (state settled)
      (state (call waiting-for-layout i id) (trigger for (tuple i id) scroll-requests)
        (then settled (trigger if (call requested-column-is-laid-out i id))
          (do
            (inline (call scroll-requested-column-into-view i id))
          )
        )
        (blank)
        (then settled (trigger on laid-out (call requested-column-is-laid-out i id))
          (do
            (inline (call scroll-requested-column-into-view i id))
          )
        )
        (blank)
        (then settled (trigger on path-shortened (!= (call (. path level-id) i) id)))
      )
    )
  )
  (content
    (<> This (• flex-row)
      (if #can-go-back
        (<> Shortcut (text: "Back")
          (= key .arrow-left)
          (= action (=> () :do (call interact-back)))
        )
      )
      (blank)
      (if #can-enter
        (<> Shortcut (text: "Open")
          (= key .arrow-right)
          (= action (=> () :do (call interact-enter)))
        )
      )
      (blank)
      (for (in level (. #path #levels) (keyed-by (. level id)))
        (<> (of ColumnTreeColumn Item) (id: column)
          (= tree this)
          (= level level)
          (= items (. level items))
          (= is-active-column
            (call (of column-tree-level-is-active Item)
              (block
                (arg level)
                (arg (. #path #levels))
                (arg (. #path #active-index))
              )
            )
          )
          (blank)
          (for (in item (. column #items))
            (+<> ListItem (id: row) (param: item Item))
          )
        )
      )
      (blank)
      (if (> (. #viewport-retention #slot-count) 0)
        (<> ColumnTreeColumnSpace
          (= slot-count (. #viewport-retention #slot-count))
        )
      )
    )
  )
  (whenever-rule #root-node
    (call reload-root)
  )
  (fn-do + did-layout _
    (call (. viewport-retention release-if-unscrolled) scroll-x)
    (<- laid-out true)
  )
  (fn-do + mounted _
    (call reload-root)
    (call project-active-column)
  )
  (fn-expr + columns (list (of ColumnTreeColumn Item)) :get
    (call live-columns)
  )
  (fn-do _ interact-enter _
    (call enter)
    (<- interacted true)
  )
  (fn-do _ interact-back _
    (call back)
    (<- interacted true)
  )
  (fn-do + select-relative _
    (param offset Int)
    (let column active-column)
    (if column
      (if (< offset 0)
        (call (. column select-relative) (. Direction up))
        (else
          (call (. column select-relative) (. Direction down))
        )
      )
    )
  )
  (fn-do + enter _
    (param source (? (of ColumnTreeColumn Item)) (= null))
    (let index (. path active-index))
    (if source
      (let source-index (call column-index-of source))
      (return-if (if (not source-index)))
      (= index source-index)
    )
    (blank)
    (let next-index (+ index 1))
    (if (< next-index (. path levels length))
      (let selection-changed (call (. path ensure-selection) next-index))
      (call focus-level next-index)
      (if selection-changed
        (call publish-selection)
      )
      (call preview-selection next-index)
      (return)
    )
    (blank)
    (let child-items (call children-of-selection index))
    (if (not child-items)
      (<- activated (call ActivateEvent))
      (return)
    )
    (blank)
    (call truncate-path-after index)
    (call (. path append) child-items 0)
    (call focus-level next-index)
    (call publish-selection)
    (call preview-selection next-index)
  )
  (fn-do + back _
    (return-if (if (== (. path active-index) 0)))
    (blank)
    (let index (- (. path active-index) 1))
    (call focus-level index)
    (call truncate-path-after-retaining-space index)
  )
  (fn-do + focus-column _
    (param column (? (of ColumnTreeColumn Item)))
    (return-if (if (not column)))
    (blank)
    (let index (call column-index-of column))
    (if (!= index null)
      (call focus-level index)
    )
  )
  (fn-do + focus-level _
    (param index Index)
    (return-if (if (not (call (. path focus) index))))
    (let id (call (. path level-id) index))
    (return-if (if (not id)))
    (blank)
    (call project-active-column)
    (<- focus-requests (call ColumnFocusRequest index id))
  )
  (fn-do + restore-path Bool
    (param keys (list String))
    (if (not keys)
      (call reload-root)
      (return false)
    )
    (blank)
    (call clear-path)
    (blank)
    (let current-root root-node)
    (if (not current-root)
      (return false)
    )
    (blank)
    (let items (? (list Item)) (call load-children current-root))
    (if (== items null)
      (return false)
    )
    (blank)
    (let key-prefix "")
    (let depth Index 0)
    (while (< depth (. keys length))
      (let current-items items)
      (let match-index (call index-of-key ([] keys depth) current-items key-prefix))
      (if (== match-index null)
        (if (and (== depth 0) current-items)
          (call (. path append) current-items)
          (call focus-level 0)
        )
        (return false)
      )
      (blank)
      (let item ([] current-items match-index))
      (call (. path append) current-items match-index)
      (= key-prefix ([] keys depth))
      (+= depth 1)
      (blank)
      (if (< depth (. keys length))
        (let child-items (call load-children item))
        (if (== child-items null)
          (call focus-level (- (. path levels length) 1))
          (return false)
        )
        (= items child-items)
      )
    )
    (blank)
    (if (. path levels)
      (call focus-level (- (. path levels length) 1))
    )
    (return true)
  )
  (fn-do _ preview-selection _
    (param index Index)
    (let next-index (+ index 1))
    (if (< next-index (. path levels length))
      (call request-level-scroll next-index)
      (return)
    )
    (if (and (call selected-item-at index) (not (call level-column index)))
      (= pending-preview-level-id (call (. path level-id) index))
      (return)
    )
    (let child-items (call children-of-selection index))
    (if (== child-items null)
      (call truncate-path-after index)
      (return)
    )
    (let selected-index (if-expr (== next-index (. path active-index)) 0 -1))
    (call (. path append) child-items selected-index)
    (if (>= selected-index 0)
      (call publish-selection)
    )
    (call (. viewport-retention consume))
    (call request-level-scroll next-index)
  )
  (fn-do _ request-level-scroll _
    (param index Index)
    (let id (call (. path level-id) index))
    (if id
      (<- scroll-requests (call ColumnScrollRequest index id))
    )
  )
  (fn-do _ truncate-path-after-retaining-space _
    (param index Index)
    (let removed-count (call truncate-path-after index))
    (if (and (> removed-count 0) (< scroll-x 0))
      (call (. viewport-retention retain) removed-count)
    )
  )
  (fn-do _ truncate-path-after Size
    (param index Index)
    (let removed-count (call (. path truncate-after) index))
    (if (not (. path levels))
      (call (. viewport-retention release))
    )
    (<- path-shortened true)
    (return removed-count)
  )
  (fn-do + select-row _
    (param row ListItem)
    (param column (of ColumnTreeColumn Item))
    (let maybe-row-index (. column selected-index))
    (return-if (if (== maybe-row-index null)))
    (call select-row-at-index maybe-row-index column)
  )
  (fn-do + clear-row-selection _
    (param column (of ColumnTreeColumn Item))
    (call select-row-at-index -1 column)
  )
  (fn-do _ select-row-at-index _
    (param row-index Int)
    (param column (of ColumnTreeColumn Item))
    (let maybe-index (call column-index-of column))
    (return-if (if (== maybe-index null)))
    (let index maybe-index)
    (return-if (if (>= index (. path levels length))))
    (blank)
    (let changed (call (. path select) row-index index))
    (blank)
    (if (!= index (. path active-index))
      (call focus-level index)
    )
    (blank)
    (if changed
      (call truncate-path-after-retaining-space index)
      (call publish-selection)
    )
    (blank)
    (call preview-selection index)
  )
  (fn-do _ column-index-of (? Index)
    (param column (of ColumnTreeColumn Item))
    (let target (. column level))
    (return-if (if (not target)))
    (blank)
    (return (call (. path index-of) target))
  )
  (fn-expr _ live-columns _
    (spread active-children)
    (pipe ?*>
      (match? each
        (case (: column (of ColumnTreeColumn Item))
          column
        )
      )
    )
    (pipe |> List)
  )
  (fn-do _ project-active-column _
    (let index (. path active-index))
    (let level-id (call (. path level-id) index))
    (let column (call (of column-tree-level-column Item) columns (. path levels) index level-id))
    (if (!= active-column column)
      (= active-column column)
    )
    (call release-unused-viewport-retention)
  )
  (fn-do + column-mounted _
    (param column (of ColumnTreeColumn Item))
    (call project-active-column)
    (<- level-mounted true)
    (call preview-pending-level column)
  )
  (fn-do _ preview-pending-level _
    (param column (of ColumnTreeColumn Item))
    (let pending-id pending-preview-level-id)
    (return-if (if (not pending-id)))
    (let level (. column level))
    (return-if (if (not level)))
    (return-if (if (!= (. level id) pending-id)))
    (blank)
    (= pending-preview-level-id null)
    (let index (call (. path index-of) level))
    (if (and (!= index null) (== (+ index 1) (. path levels length)))
      (call preview-selection index)
    )
  )
  (fn-do _ release-unused-viewport-retention _
    (call (. viewport-retention release-if-unscrolled) scroll-x)
  )
  (fn-expr _ requested-column (? (of ColumnTreeColumn Item))
    (param index Index)
    (param level-id String)
    (call (of column-tree-level-column Item) columns (. path levels) index level-id)
  )
  (fn-expr _ requested-column-is-laid-out Bool
    (param index Index)
    (param level-id String)
    (case? column
      (> (. column bounds width) 0)
    )
    (default
      false
    )
    (where
      (lazy column (call requested-column index level-id))
    )
  )
  (fn-do _ scroll-requested-column-into-view _
    (param index Index)
    (param level-id String)
    (let column (call requested-column index level-id))
    (if column
      (call scroll-bounds-visible (. column bounds))
    )
  )
  (fn-do _ ensure-active-column-visible _
    (let column active-column)
    (if (not column)
      (if (!= scroll-x 0)
        (call scroll (tuple 0 scroll-y))
      )
      (return)
    )
    (return (call scroll-bounds-visible (. column bounds)))
  )
  (fn-do + reload-root _
    (call clear-path)
    (blank)
    (let current-root root-node)
    (if current-root
      (let child-items (call load-children current-root))
      (if (!= child-items null)
        (if child-items
          (call (. path append) child-items 0)
          (call focus-level 0)
        )
      )
    )
    (blank)
    (call project-active-column)
  )
  (fn-do + refresh _
    (let current-root root-node)
    (if (or (not current-root) (not (. path levels)))
      (call reload-root)
      (return)
    )
    (blank)
    (let held-active (. path active-index))
    (let held-focus (?? (?. active-column is-focused) false))
    (let owner Item current-root)
    (let key-prefix "")
    (let index Index 0)
    (while (< index (. path levels length))
      (let level ([] (. path levels) index))
      (let items (?? (call load-children owner) (call (of List Item))))
      (if (not items)
        (if (== index 0)
          (call clear-path)
          (else
            (let ignored (call truncate-path-after (- index 1)))
          )
        )
        (break)
      )
      (blank)
      (let previous (. level selected-index))
      (let held (. level selected-item))
      (let found (? Index) null)
      (if held
        (= found (call index-of-key (call key-for-item held key-prefix previous) items key-prefix))
      )
      (let lost (and (>= previous 0) (== found null)))
      (let selected -1)
      (if (!= found null)
        (= selected found)
        (else-if lost
          (= selected (call min previous (- (as (. items length) Int) 1)))
        )
      )
      (if (or (!= selected previous) (not (call (of column-tree-items-match Item) (. level items) items)))
        (call (. path replace) index items selected)
      )
      (if (< selected 0)
        (break)
      )
      (blank)
      (= owner ([] items selected))
      (if lost
        (let ignored (call truncate-path-after index))
        (call publish-selection)
      )
      (if (or lost (== (+ index 1) (. path levels length)))
        (call append-preview index owner)
        (break)
      )
      (= key-prefix (call key-for-item owner key-prefix selected))
      (+= index 1)
    )
    (blank)
    (call refresh-selected-item)
    (call project-active-column)
    (if (and held-focus (. path levels) (!= (. path active-index) held-active))
      (call focus-level (. path active-index))
    )
  )
  (fn-do _ append-preview _
    (param index Index)
    (param owner Item)
    (let children (?? (call load-children owner) (call (of List Item))))
    (return-if (if (not children)))
    (call (. path append) children)
    (call (. viewport-retention consume))
    (call request-level-scroll (+ index 1))
  )
  (fn-do _ clear-path _
    (call (. path clear))
    (<- path-shortened true)
    (call project-active-column)
    (call (. viewport-retention release))
    (if (!= scroll-x 0)
      (call scroll (tuple 0 scroll-y))
    )
  )
  (fn-do _ children-of-selection (? (list Item))
    (param index Index)
    (return-if (if (>= index (. path levels length))))
    (let item (call selected-item-at index))
    (return-if (if (not item)))
    (let row (call selected-row-at index))
    (return-if (if (not row)))
    (return-if (if (not (. row has-children))))
    (blank)
    (let children (call load-children item))
    (if (!= children null)
      (if children
        (return children)
      )
    )
  )
  (fn-do _ selected-row-at (? ListItem)
    (param index Index)
    (return-if (if (>= index (. path levels length))))
    (let selected-index (. ([] (. path levels) index) selected-index))
    (return-if (if (< selected-index 0)))
    (let column (call level-column index))
    (return-if (if (not column)))
    (return (call (. column row-at-index) selected-index))
  )
  (fn-expr _ level-column (? (of ColumnTreeColumn Item))
    (param index Index)
    (call (of column-tree-level-column Item) columns (. path levels) index (call (. path level-id) index))
  )
  (fn-expr + selected-item-at (? Item)
    (param index Index)
    (call (. path selected-item-at) index)
  )
  (fn-do _ index-of-key (? Index)
    (param key String)
    (param items (list Item))
    (param key-prefix String)
    (let index Index 0)
    (for (in item items)
      (if (== (call key-for-item item key-prefix index) key)
        (return index)
      )
      (+= index 1)
    )
  )
  (fn-expr _ key-for-item String
    (param item Item)
    (param key-prefix String)
    (param index Index)
    (case? builder
      (call builder item)
    )
    (case? key-prefix
      (str key-prefix "/" index)
    )
    (default
      (str index)
    )
    (where
      (lazy builder key-builder)
    )
  )
  (fn-do _ publish-active-column-changed _
    (call refresh-selected-item)
    (<- active-column-changed (call ActivateEvent))
  )
  (fn-do _ publish-selection _
    (call refresh-selected-item)
    (<- selected (call SelectEvent))
  )
  (fn-do _ refresh-selected-item _
    (= selected-item (call (of column-tree-selected-item-from Item) (. path active-index) (. path levels)))
  )
)

(type + (of ColumnTreeColumn Item) (is ListBox)
  (prop + items (list Item) (= (call (of List Item))))
  (prop + is-active-column _ (= false))
  (blank)
  (prop _ tree (? (of ColumnTree Item)))
  (prop _ level (? (of ColumnTreeLevel Item)))
  ; Markup can transiently detach a keyed column while its row event is still in flight.
  (prop _ selection-owner (? (of ColumnTree Item)))
  (blank)
  (rule This (• flex-col)
    (= min-width (call (. SizeSpec coord) 28))
    (= max-width (call (. SizeSpec coord) 28))
  )
  (whenever-rule #level
    (call project-level-selection)
  )
  (whenever-rule (trigger children ListItem)
    (catch (call project-level-selection))
  )
  (subscribe-for (on event interacted)
    (let owner (call selection-owner-for-update))
    (if owner
      (<- (. owner interacted) true)
    )
  )
  (fn-do + select-row _
    (param row (? ListItem))
    (let owner (call selection-owner-for-update))
    (call (. super select-row) row)
    (blank)
    (if owner
      (if selected-row
        (call (. owner select-row) selected-row this)
        (else
          (call (. owner clear-row-selection) this)
        )
      )
    )
  )
  (fn-do _ selection-owner-for-update (? (of ColumnTree Item))
    (if tree
      (return tree)
    )
    (blank)
    (let owner selection-owner)
    (if (and owner (== (. owner active-column) this))
      (return owner)
    )
  )
  (fn-do + activate-selection _
    (let owner tree)
    (if owner
      (call (. owner enter) this)
      (return)
    )
    (call (. super activate-selection))
  )
  (fn-do + ensure-selection _
    (call project-level-selection)
  )
  (fn-do + mounted _
    (= selection-owner tree)
    (call (?. tree column-mounted) this)
    (call project-level-selection)
  )
  (fn-do + unmounted _
    (= is-active-column false)
  )
  (fn-do _ project-level-selection _
    (return-if (if (== %parent null)))
    (let model level)
    (return-if (if (not model)))
    (blank)
    (let desired (? ListItem))
    (let index (. model selected-index))
    (if (>= index 0)
      (= desired (call row-at-index index))
    )
    (blank)
    (if (!= selected-row desired)
      (catch (call (. super select-row) desired))
    )
  )
)

(type + ColumnTreeColumnSpace (is Box)
  (prop + slot-count Index (= 0))
  (blank)
  (rule This
    (= min-width (call column-tree-column-space-width slot-count))
    (= max-width (call column-tree-column-space-width slot-count))
  )
  (fn-do _ column-tree-column-space-width _
    (param count Index)
    (let width Coord 0)
    (let remaining count)
    (while (> remaining 0)
      (+= width 30)
      (-= remaining 1)
    )
    (blank)
    (return width)
  )
)

(type + (of ColumnTreeChildProvider ColumnItem) (is (fn-type (? (list ColumnItem)) (param item ColumnItem))))

(type _ ColumnFocusRequest (is Tuple)
  (prop + index Index)
  (prop + level-id String)
)

(type _ ColumnScrollRequest (is Tuple)
  (prop + index Index)
  (prop + level-id String)
)

(type _ (of ColumnTreeLevel Item)
  (prop + id String)
  (prop + items (list Item))
  (prop + selected-index Int (= -1))
  (fn-do + This _
    (param id _)
    (param items _)
    (param selected-index _ (= -1))
  )
  (fn-expr + selected-item (? Item) :get
    (only-if ([] items selected-index) (if (and (>= selected-index 0) (< selected-index (. items length)))))
  )
)

(type _ (of ColumnTreePath Item)
  (prop + levels (list (of ColumnTreeLevel Item)))
  (prop + active-index Index)
  (blank)
  (prop _ next-level-id Size)
  (fn-do + clear _
    (call (. levels release))
    (= active-index 0)
  )
  (fn-do + focus Bool
    (param index Index)
    (return-if (if (>= index (. levels length))))
    (= active-index index)
    (return true)
  )
  (fn-do + append _
    (param items (list Item))
    (param selected-index Int (= -1))
    (+= next-level-id 1)
    (+= levels (call (of ColumnTreeLevel Item) (str next-level-id) items selected-index))
  )
  (fn-do + truncate-after Size
    (param index Index)
    (let before-count (. levels length))
    (let next-count (+ index 1))
    (while (> (. levels length) next-count)
      (call (. levels remove) (- (. levels length) 1))
    )
    (blank)
    (if (not levels)
      (= active-index 0)
      (else-if (>= active-index (. levels length))
        (= active-index (- (. levels length) 1))
      )
    )
    (blank)
    (return (- before-count (. levels length)))
  )
  (fn-do + select Bool
    (param selected-index Int)
    (param index Index)
    (return-if (if (>= index (. levels length))))
    (let current ([] levels index))
    (return-if (if (== (. current selected-index) selected-index)))
    (blank)
    (call replace index (. current items) selected-index)
    (return true)
  )
  (fn-do + replace _
    (param index Index)
    (param items (list Item))
    (param selected-index Int)
    (return-if (if (>= index (. levels length))))
    (let next-levels (call (of List (of ColumnTreeLevel Item)) levels))
    (= ([] next-levels index)
      (call (of ColumnTreeLevel Item)
        (block
          (arg (. ([] levels index) id))
          (arg items)
          (arg selected-index)
        )
      )
    )
    (= levels next-levels)
  )
  (fn-do + ensure-selection Bool
    (param index Index)
    (return-if (if (>= index (. levels length))))
    (let level ([] levels index))
    (return-if (if (and (>= (. level selected-index) 0) (< (. level selected-index) (. level items length)))))
    (return-if (if (not (. level items))))
    (blank)
    (return (call select 0 index))
  )
  (fn-do + index-of (? Index)
    (param target (of ColumnTreeLevel Item))
    (let index Index 0)
    (for (in candidate levels)
      (if (== (. candidate id) (. target id))
        (return index)
      )
      (+= index 1)
    )
  )
  (fn-do + level-id (? String)
    (param index Index)
    (return-if (. ([] levels index) id) (if (< index (. levels length))))
  )
  (fn-do + selected-item-at (? Item)
    (param index Index)
    (return-if (if (>= index (. levels length))))
    (let level ([] levels index))
    (let selected-index (. level selected-index))
    (return-if (if (< selected-index 0)))
    (blank)
    (let items (. level items))
    (let item-index selected-index)
    (return-if ([] items item-index) (if (< item-index (. items length))))
  )
)

(type _ ColumnTreeViewportRetention
  (prop + slot-count Index (= 0))
  (fn-do + retain _
    (param count Size)
    (+= slot-count count)
  )
  (fn-do + consume _
    (if (> slot-count 0)
      (-= slot-count 1)
    )
  )
  (fn-do + release _
    (= slot-count 0)
  )
  (fn-do + release-if-unscrolled _
    (param scroll-x Coord)
    (if (== scroll-x 0)
      (call release)
    )
  )
)

(fn-do _ (of column-tree-no-children Item) (? (list Item))
  (param item Item)
)

(fn-do _ (of column-tree-level-column Item) (? (of ColumnTreeColumn Item))
  (param live-columns (list (of ColumnTreeColumn Item)))
  (param levels (list (of ColumnTreeLevel Item)))
  (param index Index)
  (param level-id (? String))
  (return-if (if (>= index (. levels length))))
  (let current-id (. ([] levels index) id))
  (return-if (if (and (!= level-id null) (!= level-id current-id))))
  (blank)
  (for (in column live-columns)
    (if (== (?. (. column level) id) current-id)
      (return column)
    )
  )
)

(fn-do _ (of column-tree-owners-from Item) (list Item)
  (param root (? Item))
  (param levels (list (of ColumnTreeLevel Item)))
  (let owners (list Item) (call (of List Item)))
  (return-if owners (if (not root)))
  (+= owners root)
  (for (in level levels)
    (let owner (. level selected-item))
    (if owner
      (+= owners owner)
    )
  )
  (return owners)
)

(fn-do _ (of column-tree-items-match Item) Bool
  (param current (list Item))
  (param next (list Item))
  (return-if false (if (!= (. current length) (. next length))))
  (for (in index (..< 0 (. current length)))
    (return-if false (if (not (== ([] current index) ([] next index)))))
  )
  (return true)
)

(fn-do _ (of column-tree-level-is-active Item) Bool
  (param level (of ColumnTreeLevel Item))
  (param levels (list (of ColumnTreeLevel Item)))
  (param active-index Index)
  (return-if (if (>= active-index (. levels length))))
  (return (== (. ([] levels active-index) id) (. level id)))
)

(fn-do _ (of column-tree-selected-item-from Item) (? Item)
  (param active-index Index)
  (param levels (list (of ColumnTreeLevel Item)))
  (return-if (if (>= active-index (. levels length))))
  (blank)
  (let level ([] levels active-index))
  (let selected-index (. level selected-index))
  (return-if (if (< selected-index 0)))
  (blank)
  (let items (. level items))
  (let index selected-index)
  (return-if ([] items index) (if (< index (. items length))))
)

(fn-expr _ (of column-tree-can-enter-from Item) Bool
  (param index Index)
  (param levels (list (of ColumnTreeLevel Item)))
  (param selected-row-has-children Bool)
  (case? (>= index (. levels length))
    (> (. levels length) 0)
  )
  (case? (< next-index (. levels length))
    true
  )
  (default
    selected-row-has-children
  )
  (where
    (lazy next-index (+ index 1))
  )
)
