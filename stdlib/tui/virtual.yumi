────────────────────
+ do refresh-bindings

=? if !source || !virtual-layout
. viewport = content-bounds.size
. viewport-width = (viewport.width as I64) as VirtualCoord
. viewport-height = (viewport.height as I64) as VirtualCoord
refresh-bindings-at(virtual-scroll.x, virtual-scroll.y, viewport-width, viewport-height)
publish-bindings()
update-viewport-membership()
. window = recycler.window
. resolved = window.resolved-scroll
if resolved != virtual-scroll
    virtual-scroll = resolved
. extent-x = window.extent-x
if extent-x != virtual-extent-x
    virtual-extent-x = extent-x
. extent-y = window.extent-y
if extent-y != virtual-extent-y
    virtual-extent-y = extent-y

────────────────────
+ do refresh-bindings-at
    - scroll-x VirtualCoord
    - scroll-y VirtualCoord
    - viewport-width VirtualCoord
    - viewport-height VirtualCoord

=? if !source || !virtual-layout
recycler.source = source
recycler.layout = virtual-layout
. window = recycler.window
window.scroll-x = scroll-x
window.scroll-y = scroll-y
window.viewport-width = viewport-width
window.viewport-height = viewport-height
window.frame-width = viewport-width
window.frame-height = viewport-height
window.row-height = 1vcoord
window.set-overscan(overscan)
recycler.refresh()

────────────────────
+ do publish-bindings

=? if !recycler.has-pending-changes
recycler.has-pending-changes = false
checkpoint-window()
count-created-roots()

────────────────────
+ do release-bindings

recycler.release()
source = null
virtual-scroll = VirtualPoint(0vcoord, 0vcoord)
virtual-extent-x = VirtualExtent(0vcoord, null, false)
virtual-extent-y = VirtualExtent(0vcoord, null, false)
observed-root-count = 0
checkpoint-window()
invalidate-layout()
invalidate-paint()

────────────────────
+ do scroll-to-address Bool
    - address I64
    - alignment = ScrollAlignment.start

=? false if !source || !virtual-layout
recycler.source = source
recycler.layout = virtual-layout
. window = recycler.window
window.frame-width = (content-bounds.width as I64) as VirtualCoord
window.frame-height = (content-bounds.height as I64) as VirtualCoord
window.row-height = 1vcoord
. rect = recycler.rect-for-address(address)
=? false if !rect
. x = if rect.width > window.frame-width then virtual-scroll.x else rect.x
. y = virtual-revealed(virtual-scroll.y, window.frame-height, rect.y, rect.height, alignment)
= set-virtual-scroll(VirtualPoint(x, y))

────────────────────
+ do scroll-to-virtual Bool
    - point VirtualPoint

= set-virtual-scroll(point)

