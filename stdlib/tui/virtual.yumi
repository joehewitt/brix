    - requested Coord

0

────────────────────
+ clipped-scroll-y Coord
    - requested Coord

0

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

. ignored = flush.applied

━━━━━━━━━━━━━━━━━━━━
_ virtual-revealed VirtualCoord
    - position VirtualCoord
    - viewport VirtualCoord
    - start VirtualCoord
    - length VirtualCoord
    - alignment ScrollAlignment

match alignment
    | ScrollAlignment.start
        start
    | ScrollAlignment.center
        start + length / 2vcoord - viewport / 2vcoord
    | ScrollAlignment.end
        start + length - viewport
    ??
        |? length > viewport || start < position
            start
        |? start + length > position + viewport
            start + length - viewport
        ??
            position

━━━━━━━━━━━━━━━━━━━━
_ checked-cell Coord
    - value I64

?! Panic("Virtual placement exceeds terminal coordinates")
    if value > (Coord.max as I64) || value < -(Coord.max as I64) - 1

value as I16
