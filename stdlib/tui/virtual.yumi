+ do root-at VirtualSlotRoot'VItem?
    - index Index

. pool = %first-child
=? if !pool
. child = pool.child-at(index)
=? if !child
= child as VirtualSlotRoot'VItem

────────────────────
+ append-hit-path
    - point Point

|? !is-interactive-visible || !is-inside-content(point)
    List'HitFrame()
|? !pool-root
    List'HitFrame()
??
    pool-root.append-hit-path(inner-point)

.. inner-point = point.x - scroll-x, point.y - scroll-y
.. pool-root = %first-child

────────────────────
+ do pointer-hit-result HitResult?
    - point Point
    - offset Point

=? if !is-inside-content(point)
= super.pointer-hit-result(point, offset)

────────────────────
_ is-inside-content
    - point Point

horizontal && vertical

.. horizontal = point.x >= content-bounds.x && point.x < content-bounds.right
.. vertical = point.y >= content-bounds.y && point.y < content-bounds.bottom

────────────────────
_ do checkpoint-window

. root = markup-batch-root
if root
    catch root.markup-batch-queue.checkpoint()

────────────────────
_ do count-created-roots

while observed-root-count < recycler.pool-size && root-at(observed-root-count)
    observed-root-count += 1
    stat-roots-created += 1

────────────────────
_ do arrange-virtual-roots

. pool = %first-child
=? if !pool
pool.arrange-bounds(content-bounds)
pool.update-layout()

. window = recycler.window
. origin-x = window.resolved-scroll-x
. origin-y = window.resolved-scroll-y
. slot-index Index
. cursor = pool.%first-child
while cursor
    . root = cursor as VirtualSlotRoot'VItem
    . placement = recycler.placement-for-slot(slot-index)
    if placement
        root.arrange-outer-bounds(viewport-rect(placement, origin-x, origin-y))
        root.is-in-viewport = placement-in-viewport(placement)
    else
        root.arrange-outer-bounds(Rect(content-bounds.x, content-bounds.y, 0, 0))
        root.is-in-viewport = false
    root.update-layout()
    cursor = cursor.%next-sibling
    slot-index += 1

────────────────────
_ viewport-rect
    - placement VirtualPlacement
    - origin-x VirtualCoord
    - origin-y VirtualCoord

Rect(x, y, width, height)

.. x = checked-cell((content-bounds.x as I64) + placement.x - origin-x)
.. y = checked-cell((content-bounds.y as I64) + placement.y - origin-y)
.. width = checked-cell(placement.width)
.. height = checked-cell(placement.height)

────────────────────
_ do update-viewport-membership

. pool = %first-child
=? if !pool
. slot-index Index
. cursor = pool.%first-child
while cursor
    . root = cursor as VirtualSlotRoot'VItem
    . placement = recycler.placement-for-slot(slot-index)
    root.is-in-viewport = placement != null && placement-in-viewport(placement)
    cursor = cursor.%next-sibling
    slot-index += 1

────────────────────
_ placement-in-viewport
    - placement VirtualPlacement

horizontal && vertical

.. window = recycler.window
.. left = window.resolved-scroll-x
.. top = window.resolved-scroll-y
.. horizontal = placement.width > 0vcoord && placement.x + placement.width > left && placement.x < left + window.viewport-width
.. vertical = placement.height > 0vcoord && placement.y + placement.height > top && placement.y < top + window.viewport-height

────────────────────
_ do set-virtual-scroll Bool
    - requested VirtualPoint

. x = min(max-virtual-scroll-x(), (max(0vcoord, requested.x)))
. y = min(max-virtual-scroll-y(), (max(0vcoord, requested.y)))
. next = VirtualPoint(x, y)
=? false if next == virtual-scroll

virtual-scroll = next
invalidate-layout()
invalidate-paint()
= true

────────────────────
_ max-virtual-scroll-x VirtualCoord

max(0vcoord, (virtual-extent-x.known - viewport-width))

.. viewport-width = max(0vcoord, (content-bounds.width as I64))

────────────────────
_ max-virtual-scroll-y VirtualCoord

max(0vcoord, (virtual-extent-y.known - viewport-height))

.. viewport-height = max(0vcoord, (content-bounds.height as I64))

────────────────────
+ do virtual-slot-departing
    - slot-index Index

. root = root-at(slot-index)
=? if !root
root.input-generation += 1
. input-owner Box? = root
while input-owner && input-owner.input-host == null
    input-owner = input-owner.%parent
input-owner?.input-host?.release-input-inside(root)
root.is-in-viewport = false

────────────────────
+ do virtual-slot-arriving
    - slot-index Index

────────────────────
+ measured-content-size
    - query MeasureQuery

PSize(width, height)

────────────────────
+ do update-layout

updated-during-layout-pass = false
super.update-layout()
if !updated-during-layout-pass
    update-virtual-layout()

────────────────────
+ do did-layout

update-virtual-layout()
updated-during-layout-pass = true

────────────────────
_ do update-virtual-layout

refresh-bindings()
arrange-virtual-roots()
inner-width = content-bounds.width
inner-height = content-bounds.height
scroll-x = 0
scroll-y = 0
$is-layout-invalid = false
mark-layout-arranged()

────────────────────
+ do scroll
    - point Point

. x = ((0tx - point.x) as I64) as VirtualCoord
. y = ((0tx - point.y) as I64) as VirtualCoord
. ignored = set-virtual-scroll(VirtualPoint(x, y))

────────────────────
+ do scroll Bool
    - amount Coord
    - direction Direction = Direction.down

. delta = (amount as I64) as VirtualCoord
. x = virtual-scroll.x
. y = virtual-scroll.y
= match direction
    | .up
        set-virtual-scroll(VirtualPoint(x, y - delta))
    | .down
        set-virtual-scroll(VirtualPoint(x, y + delta))
    | .left
        set-virtual-scroll(VirtualPoint(x - delta, y))
    | .right
        set-virtual-scroll(VirtualPoint(x + delta, y))
    ??
        super.scroll(amount, direction)

────────────────────
+ can-scroll Bool
    - direction Direction

match direction
    | .up
        virtual-scroll.y > 0vcoord
    | .down
        virtual-scroll.y < max-virtual-scroll-y()
    | .left
        virtual-scroll.x > 0vcoord
    | .right
        virtual-scroll.x < max-virtual-scroll-x()
    ??
        super.can-scroll(direction)

