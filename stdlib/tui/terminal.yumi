+ Terminal
    is Closable

+ painter TerminalPainter?

+ is-raw = true
+ sends-signals = true
+ is-full-screen = false
+ is-mouse-handled = false
+ is-cursor-shown = false
+ is-open = true
+ event ready Terminal
+ event resized PSize
+ event closed Terminal
+ event mouse-down MouseDownEvent
+ event mouse-up MouseUpEvent
+ event mouse-move MouseMoveEvent
+ event mouse-drag MouseDragEvent
+ event scroll ScrollEvent
+ event key-press KeyPressEvent
+ event char KeyInputEvent
+ event paste PasteEvent

_ is-painting = false
_ paint-task U32
_ paint-finished SyncBufferedChannel'Bool

_ close-wait SyncBufferedChannel'Bool
_ tty-in = File(["/dev/tty", "/dev/stdin"], FileFlags.read-mode)
+ view-size = PSize(0, 10)
_ origin-x Coord
_ origin-y Coord
_ cursor-x Coord
_ cursor-y Coord
_ is-paint-invalid = true
_ is-resizing = false
_ settle-resize := debounced(resize-settle-delay, this.finish-resize)
_ previous-canvas Canvas?
_ current-canvas Canvas?
_ frame-output = DataStream'Byte(8192)
_ term-state = Termios[1]
_ cursor-query AsyncChannel'CursorEvent

_ paint-loop := terminal-frame-interval.animation-loop • with repaint

as Writable'String for
_ tty-out = File(["/dev/tty", "/dev/stdout"], FileFlags.write-mode)

────────────────────
+ This
    - painter TerminalPainter?
    - is-full-screen = false
    - is-mouse-handled = false
    - is-cursor-shown = true

────────────────────
for sig on sig-wnch whenever #is-open

is-resizing = true
sync-size()
schedule-paint()
settle-resize()

────────────────────
when #is-raw

C:yumiTerminalEnter(tty-in, term-state)
apply-signals()
sync-size()

────────────────────
whenever #sends-signals

apply-signals()

────────────────────
when !#is-raw

C:yumiTerminalExit(tty-in, term-state)

────────────────────
when #is-open

do new
    set-mode(auto-wrap-code, false)
    set-mode(bracketed-paste-code, true)
    fill-out()
    ready <- this

    for event in ~ TerminalEvents in TerminalInput(tty-in)
        if event is KeyPressEvent
            key-press <- (event as KeyPressEvent)
        else if event is KeyInputEvent
            char <- (event as KeyInputEvent)
        else if event is PasteEvent
            paste <- (event as PasteEvent)
        else if event is MouseDownEvent
            mouse-down <- (event as MouseDownEvent)
        else if event is MouseUpEvent
            mouse-up <- (event as MouseUpEvent)
        else if event is MouseMoveEvent
            mouse-move <- (event as MouseMoveEvent)
        else if event is MouseDragEvent
            mouse-drag <- (event as MouseDragEvent)
        else if event is ScrollEvent
            scroll <- (event as ScrollEvent)
        else if event is CursorEvent
            cursor-query <- event

    close()

────────────────────
when #is-full-screen

set-mode(full-screen-code, is-full-screen)

────────────────────
when #is-mouse-handled

set-mode(mouse-code, is-mouse-handled)

────────────────────
when #is-cursor-shown

set-mode(show-cursor-code, is-cursor-shown)

