+ full-screen-code = 1049
+ mouse-code = [1000, 1001, 1002, 1003, 1006]
+ show-cursor-code = 25
+ auto-wrap-code = 7
+ bracketed-paste-code = 2004
+ synchronized-output-code = 2026
+ resize-settle-delay = 80ms

` 24fps is all xterm can handle
+ terminal-frame-interval = 42ms

` 60fps looks great in ghostty and mac terminal
`  + terminal-frame-interval = 16666667ns

+ TerminalPaintResult is (cursor-point Point, is-cursor-shown Bool)

