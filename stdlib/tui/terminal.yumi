escapes("[48;5;$colorm")
escapes("[0J")

────────────────────
+ do schedule-paint

=? if !is-open
is-paint-invalid = true
paint-loop.request-now()

────────────────────
+ do schedule-animation-frame

=? if !is-open
is-paint-invalid = true
paint-loop.request-next()

────────────────────
+ begin-using

this

────────────────────
+ do end-using

catch close()

────────────────────
+ do close

if is-open
    is-open = false
    paint-loop.cancel()
    . closes-from-paint = is-painting && paint-task == get-current-task-id()

    do new @detached
        if is-painting
            <- paint-finished
        restore-terminal()
        finish-close()

    if !closes-from-paint
        <- close-wait

────────────────────
_ do write-move
    - out
    - point Point

cursor-x = point.x
cursor-y = point.y
. col = point.x + origin-x + 1
. row = point.y + origin-y + 1
= write-escape(out, "[$row;$colH")

────────────────────
_ do repaint

if is-open && is-paint-invalid && painter && !is-painting && !is-resizing
    . frame-start-nanos = monotonic-time-nanoseconds()
    `  //+-tui.paint// Repaint terminal
    //tui.paint.frames ++
    //tui.frame.actual ++
    //+tui.paint.frame
    //+tui.frame.total
    is-paint-invalid = false
    is-painting = true
    paint-task = get-current-task-id()
    do finally
        is-painting = false
        paint-task = 0
        if !is-open
            paint-finished <- true

    //+tui.frame.canvas
    . canvas Canvas
    if current-canvas && current-canvas.width == view-size.width && current-canvas.height == view-size.height
        canvas = current-canvas
        current-canvas = null
    else
        canvas = Canvas(view-size)
    canvas.reset()
    //-tui.frame.canvas

    `  //this:paint -> canvas
    //+tui.frame.app-paint
    . paint-result = TerminalPaintResult((0, 0), is-cursor-shown)
    if painter
        paint-result = painter.paint(canvas)
    //-tui.frame.app-paint
    =? if !is-open

    //+tui.frame.output
    frame-output.reset()
    write-mode(frame-output, show-cursor-code, false)
    write-mode(frame-output, synchronized-output-code, true)
    if previous-canvas
        //tui.frame.diff-dumps ++
        //+tui.frame.dump-diff
        canvas.dump-diff(frame-output, previous-canvas)
        //-tui.frame.dump-diff
    else
        //tui.frame.full-dumps ++
        //tui.frame.event.dump-full -> view-size.width, view-size.height
        //+tui.frame.dump-full
        canvas.dump(frame-output)
        //-tui.frame.dump-full
    ` Flush the frame before moving the real terminal cursor out of any right-margin state.
    write-mode(frame-output, synchronized-output-code, false)
    //+tui.frame.cursor
    write-move(frame-output, paint-result.cursor-point)
    //-tui.frame.cursor
    if paint-result.is-cursor-shown
        write-mode(frame-output, show-cursor-code, true)
    tty-out.write(frame-output.data, frame-output.length)
    //-tui.frame.output

    current-canvas = previous-canvas
    previous-canvas = canvas

    //tui.frame.event.end -> view-size.width, view-size.height
    //-tui.frame.total
    //-tui.paint.frame

    . frame-elapsed-nanos = monotonic-time-nanoseconds() - frame-start-nanos
    . frame-interval-nanos = terminal-frame-interval as U64
    . frame-budget-nanos = 0u64
    if frame-elapsed-nanos < frame-interval-nanos
        frame-budget-nanos = frame-interval-nanos - frame-elapsed-nanos
    C:yumiGCFrameBudget(frame-budget-nanos)

────────────────────
+ do write-clipboard
    - text String

tty-out <- "\x1b]52;c;${byte-view(text) as Base64}\x07"

────────────────────
_ do apply-signals

=? if !is-raw
C:yumiTerminalSetSignals(tty-in, if sends-signals then 1 else 0)

────────────────────
_ do sync-size

//tui.resize.events ++
//+tui.resize.sync-size
. win-size = Winsize[1]
. err = C:yumiioctl(tty-out, C:TIOCGWINSZ, win-size)
if err
    ?! Error("Unable to read terminal size")

. size = win-size[0]
. w = size.col
. h = size.row
`  //tui.events.sync-size -> w, h
//tui.resize.event.sync-size -> w, h

. previous-view-size = view-size
view-size =
    |? is-full-screen
        (w, h)
    ??
        (w, view-size.height)

if view-size != previous-view-size
    previous-canvas = null
    current-canvas = null

resized <- view-size
//-tui.resize.sync-size

────────────────────
_ do finish-resize

=? if !is-open
is-resizing = false
schedule-paint()
repaint()

────────────────────
_ escapes
    - text
`_ escapes <- text

`  //tui.terminal.escapes// text
write-escape(tty-out, text)

────────────────────
_ do write-escape
    - out
    - text

out <- "\x1b$text"
= out

────────────────────
_ set-mode
    - code Int
    - is-on Bool
`_ mode[code Int] = is-on Bool

write-mode(tty-out, code, is-on)

────────────────────
_ do set-mode
    - codes [Int]
    - is-on Bool

for code in codes
    set-mode(code, is-on)

────────────────────
_ write-mode
    - out
    - code Int
    - is-on Bool

write-escape(out, "[?$code$on-or-off")
    .. on-or-off = if is-on then "h" else "l"

────────────────────
_ do fill-out

origin-y = cursor-y

`  //tui.terminal.fill-out// view-size.height
= tty-out <- "\n" * view-size.height

────────────────────
_ do restore-terminal

catch set-mode(mouse-code, false)
catch set-mode(synchronized-output-code, false)
catch set-mode(bracketed-paste-code, false)
catch set-mode(auto-wrap-code, true)
catch set-mode(full-screen-code, false)
catch set-mode(show-cursor-code, true)
catch C:yumiTerminalExit(tty-in, term-state)

────────────────────
_ do finish-close

catch tty-in.close()
catch tty-out.close()
paint-loop.cancel()
closed <- this
close-wait <- true

` ----------------------------------------------------------------------------------------------------
` whenever is-open
`
` mode[full-screen-code] = #is-full-screen
` mode[mouse-code] = #is-mouse-handled
` mode[show-cursor-code] = #is-cursor-shown

` on sig-wnch
`     sync-size()
`     schedule-paint()

