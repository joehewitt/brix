(import ./file-line-source)
(import /math)
(import /os/file)
(import /os/path)
(import /stream/combine)
(import /tui)
(import /tui/virtual)
(import /ui/input)
(import /ui/key-combo)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)
(prop _ preview-error-detail _ (= "The file may be unreadable or invalid for the selected preview mode."))
(prop _ preview-sniff-byte-limit Size (= 8192))
(prop _ preview-sniff-control-threshold Size (= 4))
(prop _ preview-sniff-control-percent Size (= 2))
(blank)
(type-line + FilePreviewCloseEvent (is BoxEvent))

(type + FileBinarySource
  (implements (of VirtualSource String))
  (implements VirtualSequenceDomain)
  (implements Closable)
  (prop + revision _ (:= (call VirtualRevision)))
  (prop + byte-count _ (=> file-size))
  (blank)
  (prop _ file (? (of File Byte)))
  (prop _ file-size Index)
  (prop _ row-count VirtualCoord)
  (fn-do + This _ (?! IOError)
    (param path Path)
    (let size (. path size))
    (throw (call IOError "Unable to preview a negative-sized file") (if (< size 0)))
    (blank)
    (= file-size (as size Index))
    (= row-count (call max 1vcoord (as (/ (+ file-size 15) 16) VirtualCoord)))
    (= file (call (of File Byte) path))
  )
  (fn-expr + domain VirtualSequenceDomain :get
    this
  )
  (fn-expr + known-count _ :get
    row-count
  )
  (fn-expr + estimated-count (? VirtualCoord) :get
    row-count
  )
  (fn-expr + is-final _ :get
    true
  )
  (fn-expr + address-at _
    (param index VirtualCoord)
    (as index I64)
  )
  (fn-expr + index-of _
    (param address I64)
    (case? (or (< address 0) (>= address (as row-count I64)))
      null
    )
    (default
      (as address VirtualCoord)
    )
  )
  (fn-do + bind _
    (param address I64)
    (param generation U64)
    (param target (of VirtualBindingTarget String))
    (if (or (< address 0) (>= address (as row-count I64)) (not file))
      (call (. target fail) generation)
      (return)
    )
    (blank)
    (if (== file-size 0)
      (call (. target commit) (call VirtualKey (. revision value) 0) "(empty file)" generation)
      (return)
    )
    (blank)
    (let offset (* (as address Index) 16))
    (let amount (call min 16 (- file-size offset)))
    (let bytes ([] Byte amount))
    (let maybe-actual (catch? (call (. (!! file) read) amount bytes offset)))
    (if (or (not maybe-actual) (!= maybe-actual amount))
      (call (. target fail) generation)
      (return)
    )
    (blank)
    (let text (call binary-preview-row bytes offset))
    (call (. target commit) (call VirtualKey (. revision value) offset) text generation)
  )
  (fn-do + close _
    (return-if (if (not file)))
    (call (. file close))
    (= file null)
    (call (. revision bump))
  )
  (fn-expr _ binary-preview-row _
    (param bytes ([] Byte))
    (param offset Index)
    (str ". " offset "  " hex " " ascii)
    (where
      (lazy hex (call hex-bytes bytes))
      (lazy ascii (call ascii-bytes bytes))
    )
  )
  (fn-expr _ hex-bytes _
    (param bytes ([] Byte))
    (call (. " " join) (in ([] (as ([] bytes each) Hex) (..< 2 4)) (..< 0 (. bytes size))))
  )
  (fn-expr _ ascii-bytes _
    (param bytes ([] Byte))
    (call (. "" join) (in (call printable-byte ([] bytes each)) (..< 0 (. bytes size))))
  )
  (fn-expr _ printable-byte _
    (param value Byte)
    (case? (and (>= value 32) (<= value 126))
      (as (as value Char) String)
    )
    (default
      "."
    )
  )
)

(type + FilePreviewContent (is Union)
  (variant none)
  (variant text (tuple (: path Path) (: source FileLineSource) (: is-empty Bool)))
  (variant binary (tuple (: path Path) (: source FileBinarySource)))
  (variant error (tuple (: path Path)))
)

(fn-expr _ preview-content-text (? (tuple (: path Path) (: source FileLineSource)))
  (param content FilePreviewContent)
  (match? content
    (case (call .text path source is-empty)
      (tuple path source)
    )
  )
)

(fn-expr _ preview-content-binary _
  (param content FilePreviewContent)
  (match? content
    (case (call .binary path source)
      source
    )
  )
)

(fn-expr _ preview-content-message _
  (param content FilePreviewContent)
  (match content
    (case (call .text path source is-empty)
      (if-expr is-empty "(empty file)" "")
    )
    (case (call .error path)
      "Unable to preview this file."
    )
    (default
      ""
    )
  )
)

(fn-expr _ preview-content-message-detail _
  (param content FilePreviewContent)
  (match content
    (case (call .error path)
      preview-error-detail
    )
    (default
      ""
    )
  )
)

(fn-expr _ preview-content-title _
  (param content FilePreviewContent)
  (param extent VirtualExtent)
  (match content
    (case (call .text path source is-empty)
      (case? (. extent is-final)
        (str " " (. path name) " | " (. source known-count) " lines")
      )
      (default
        (str " " (. path name) " ")
      )
    )
    (case (call .binary path source)
      (str " " (. path name) " | " (. source byte-count) " bytes | binary ")
    )
    (case (call .error path)
      (str " " (. path name) " ")
    )
    (default
      " Preview "
    )
  )
)

(fn-do _ open-preview-content _ (?! Error)
  (param path Path)
  (if (call preview-file-is-text path)
    (let source (call FileLineSource path))
    (return (call (. FilePreviewContent text) path source (== (. source byte-count) 0)))
  )
  (blank)
  (let source (call FileBinarySource path))
  (return (call (. FilePreviewContent binary) path source))
)

(type + FilePreview (is Box)
  (prop + content FilePreviewContent)
  (prop + preview-message _ (= (call preview-content-message #content)))
  (prop + preview-message-detail _ (= (call preview-content-message-detail #content)))
  (prop + title _ (= (call preview-content-title #content (. region #virtual-extent-y))))
  (event + open-requests Path)
  (event + refresh-requests Path)
  (event + close-requests Bool)
  (event + closed FilePreviewCloseEvent)
  (blank)
  (rule This (• absolute) (• cover .screen)
    (= focus-mode (. FocusMode keys))
    (= display (. Display hidden))
    (blank)
    (when-style #is-open
      (= display (. Display visible))
    )
  )
  (content
    (if #is-open
      (<> Shortcut (text: "Scroll up")
        (= key .arrow-up)
        (= action (=> () :do (call scroll-from-command (. Direction up))))
      )
      (blank)
      (<> Shortcut (text: "Scroll down")
        (= key .arrow-down)
        (= action (=> () :do (call scroll-from-command (. Direction down))))
      )
      (blank)
      (<> Shortcut (text: "Page up")
        (= key (call KeyCombo (. Key page-up)))
        (= action (=> () :do (call scroll-page (. Direction up))))
      )
      (blank)
      (<> Shortcut (text: "Page down")
        (= key (call KeyCombo (. Key page-down)))
        (= action (=> () :do (call scroll-page (. Direction down))))
      )
      (blank)
      (<> Shortcut (text: "Start of preview")
        (= key (call KeyCombo (. Key home)))
        (= action (=> () :do (call scroll-to-start)))
      )
      (blank)
      (<> Shortcut (text: "End of preview")
        (= key (call KeyCombo (. Key end)))
        (= action (=> () :do (call scroll-to-end)))
      )
      (blank)
      (<> Shortcut (text: "Close preview")
        (= key .space)
        (= action (=> () :do (<- close-requests true)))
      )
    )
    (blank)
    (<> ModalBackdrop)
    (blank)
    (<> Box (• flex-col) (• absolute) (• border yellow) (• bg black)
      (= left 1)
      (= top 1)
      (= right 1)
      (= bottom 2)
      (blank)
      (<> Label (• text black) (• bg yellow)
        (= text #title)
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• bg black) (• px 1)
        (<> (of VirtualRegion String) (id: region) (• flex 1)
          (= virtual-layout (call VerticalFixedLayout 1vcoord))
          (= overscan (call VirtualInsets 3vcoord 0vcoord 3vcoord 0vcoord))
          (blank)
          (<> Label (slot: row) (param: slot) (• text silver) (• bg black)
            (= text (call preview-row-text #content (. slot #address) (. slot #item)))
          )
        )
        (blank)
        (if (> (. #preview-message length) 0)
          (<> Box (• flow-col) (• absolute) (• inset 0) (• bg black)
            (<> Label (• text yellow) (• bg black)
              (= text #preview-message)
            )
            (blank)
            (if (> (. #preview-message-detail length) 0)
              (<> Label (• text silver) (• bg black)
                (= text #preview-message-detail)
              )
            )
          )
        )
      )
    )
    (blank)
    ; The preview lifecycle: opening loads the requested path, closing unwinds and announces
    ; itself. Refreshes while open reload content without a phase change.
    (blank)
    (state is-closed)
    (blank)
    (state is-open (trigger for path open-requests)
      (call load-path path)
      (blank)
      (finally
        (call unload-preview)
      )
      (blank)
      (then is-closed (trigger on close-requests))
    )
  )
  (subscribe-for (on path refresh-requests)
    (if is-open
      (call refresh-path path)
    )
  )
  (subscribe-for (on event scrolled)
    (if is-open
      (call scroll-from-command (. event direction))
      (call (. event cancel))
    )
  )
  (when-rule #is-open
    (call focus-self)
  )
  (fn-do + scroll-from-command _
    (param direction Direction)
    (let ignored (call (. region scroll) 3 direction))
  )
  (fn-do + scroll-page _
    (param direction Direction)
    (let amount (call max 1 (. region content-bounds height)))
    (let ignored (call (. region scroll) amount direction))
  )
  (fn-do + scroll-to-start _
    (let ignored (call (. region scroll-to-address) 0))
  )
  (fn-do + scroll-to-end _
    (let binary (call preview-content-binary content))
    (if binary
      (call scroll-binary-to-end binary)
      (return)
    )
    (blank)
    (let text (call preview-content-text content))
    (if text
      (call scroll-text-to-end (. text path) (. text source))
    )
  )
  (fn-do _ scroll-binary-to-end _
    (param source FileBinarySource)
    (let last (- (as (. source known-count) I64) 1))
    (let ignored (call (. region scroll-to-address) last))
  )
  (fn-do _ scroll-text-to-end _
    (param path Path)
    (param source FileLineSource)
    (call (. source scan-to-end)
      (block
        (on-error Error
          (call show-preview-error path)
          (return)
        )
      )
    )
    (if (== (. source known-count) 0vcoord)
      (= content (call .text path source true))
      (return)
    )
    (= content (call .text path source false))
    (call (. region refresh-bindings))
    (let last (- (as (. source known-count) I64) 1))
    (let ignored (call (. region scroll-to-address) last))
  )
  (fn-do + load-path _
    (param path Path)
    (if (not (catch? (call install-path path)))
      (call show-preview-error path)
    )
  )
  (fn-do _ install-path _ (?! Error)
    (param path Path)
    (call release-preview-content)
    (let opened (call open-preview-content path))
    (= content opened)
    (match opened
      (case (call .text current-path source is-empty)
        (= (. region source) source)
      )
      (case (call .binary current-path source)
        (= (. region source) source)
      )
      (default
        (= (. region source) null)
      )
    )
    (= (. region virtual-scroll) (call VirtualPoint 0vcoord 0vcoord))
    (call (. region invalidate-layout))
  )
  (fn-do + refresh-path _
    (param path Path)
    (if (not (catch? (call refresh-path-content path)))
      (call show-preview-error path)
    )
  )
  (fn-do _ refresh-path-content _ (?! Error)
    (param path Path)
    (let current (call preview-content-text content))
    (if current
      (call refresh-text-path-content path (. current path) (. current source))
      (else
        (call install-path path)
      )
    )
  )
  (fn-do _ refresh-text-path-content _ (?! Error)
    (param path Path)
    (param current-path Path)
    (param source FileLineSource)
    (if (or (!= current-path path) (not (call preview-file-is-text path)))
      (call install-path path)
      (return)
    )
    (blank)
    (let reset (call (. source refresh)))
    (if reset
      (= (. region virtual-scroll) (call VirtualPoint 0vcoord 0vcoord))
    )
    (= content (call .text path source (== (. source byte-count) 0)))
    (call (. region refresh-bindings))
    (call (. region invalidate-layout))
  )
  (fn-do + unload-preview _
    (call release-preview-content)
    (<- closed (call FilePreviewCloseEvent))
  )
  (fn-do + release-preview-content _
    (let previous content)
    (= content .none)
    (call (. region release-bindings))
    (blank)
    (let text (call preview-content-text previous))
    (if text
      (call (. text source close))
    )
    (let binary (call preview-content-binary previous))
    (if binary
      (call (. binary close))
    )
  )
  (fn-do + show-preview-error _
    (param path Path)
    (call release-preview-content)
    (= content (call .error path))
  )
  (fn-expr + preview-row-text _
    (param preview FilePreviewContent)
    (param address I64)
    (param content String)
    (match preview
      (case (call .binary path source)
        content
      )
      (default
        (str (+ address 1) ": " content)
      )
    )
  )
  (fn-expr + focus-self _
    (call (?. (of ancestor Window) focus) this)
  )
)

(fn-do _ preview-file-is-text _ (?! Error)
  (param path Path)
  (let file-size (. path size))
  (throw (call IOError "Unable to preview a negative-sized file") (if (< file-size 0)))
  (return-if true (if (== file-size 0)))
  (blank)
  (let read-size (call min (+ preview-sniff-byte-limit 3) (as file-size Size)))
  (let bytes ([] Byte read-size))
  (let file (use (call (of File Byte) path)))
  (let actual Size (call (. file read) read-size bytes 0))
  (let inspected (call min actual preview-sniff-byte-limit))
  (return (call preview-sample-is-text bytes actual inspected))
)

(fn-do _ preview-sample-is-text _
  (param bytes ([] Byte))
  (param available Size)
  (param inspected Size)
  (let controls Size)
  (let valid true)
  (let index Index)
  (while (and (< index inspected) valid)
    (let byte ([] bytes index))
    (if (== byte 0)
      (= valid false)
      (else-if (<= byte 127)
        (if (call preview-suspicious-control byte)
          (+= controls 1)
        )
        (+= index 1)
      )
      (else
        (let sequence (call file-valid-utf8-sequence bytes available index))
        (if (== sequence 0)
          (= valid false)
          (else
            (+= index sequence)
          )
        )
      )
    )
  )
  (blank)
  (return
    (match (tuple valid (>= controls preview-sniff-control-threshold))
      (case (tuple false _)
        false
      )
      (case (tuple _ false)
        true
      )
      (default
        (<= (* controls 100) (* inspected preview-sniff-control-percent))
      )
    )
  )
)

(fn-expr _ preview-suspicious-control _
  (param byte Byte)
  (or (and (< byte 32) (!= byte 9) (!= byte 10) (!= byte 12) (!= byte 13)) (== byte 127))
)
