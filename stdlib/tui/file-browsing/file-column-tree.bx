(import ./file-row)
(import ./file-view)
(import /os/file-tree)
(import /tui)
(import /tui/columntree)

(type + FileColumnTree (is FileView)
  (content
    (<> This (• flex-col)
      (<> (of ColumnTree FileNode) (id: columns) (• flex 1)
        (= root-node (. files root))
        (= load-children (=> (node) (call (. files children-of) node)))
        (= key-builder (=> (node) (. node key)))
        (blank)
        (<> FileRow (slot: row) (param: item)
          (= item item)
        )
      )
    )
  )
  (subscribe-for (on touched (. files changed))
    (call (. columns refresh))
  )
  (whenever-rule (. columns #owners)
    (call sync-retained)
  )
  (subscribe-for (on event (. columns selected))
    (call note-selection)
  )
  (subscribe-for (on event (. columns active-column-changed))
    (call note-selection)
  )
  (subscribe-for (on event (. columns activated))
    (let node (call selected-node))
    (if (and node (not (. node is-directory)))
      (call open node)
    )
  )
  (fn-expr + selected-node (? FileNode)
    (. columns selected-item)
  )
  (fn-do + show-node _
    (param node FileNode)
    (let ignored (call (. columns restore-path) (call (. files keys-to) node)))
  )
  (fn-do + focus-list _
    (let column (. columns active-column))
    (if column
      (call (. columns focus-column) column)
    )
  )
  (fn-do + follow-current _
    (let node (. session current))
    (return-if (if (or (not node) (. node is-detached) (== (?. (. columns selected-item) key) (. node key)))))
    (blank)
    (call show-node node)
  )
  (fn-expr + search-candidates (list FileNode)
    (if-expr column (. column items) (call (of List FileNode)))
    (where
      (lazy column (. columns active-column))
    )
  )
  (fn-do + select-node _
    (param node FileNode)
    (let column (. columns active-column))
    (return-if (if (not column)))
    (blank)
    (for (in index (..< 0 (. column items length)))
      (if (== (. ([] (. column items) index) key) (. node key))
        (let row (call (. column row-at-index) index))
        (if row
          (catch (call (. column select-row) row))
        )
        (return)
      )
    )
  )
  (fn-do _ sync-retained _
    (let next (call (of Map String FileNode)))
    (for (in owner (. columns owners))
      (= ([] next (. owner key)) owner)
    )
    (call retain-only next)
  )
)
