./file-icon
/os/file-tree
/tui
/tui/listbox
/tui/treebox

━━━━━━━━━━━━━━━━━━━━
+ FileRow is ListItem

+ item FileNode

• This • text:file-icon-color(#item)

────────────────────

<This
    text = " ${file-row-text(#item, #item.#name)}"

────────────────────
+ This
    - item

has-children = item.is-directory

━━━━━━━━━━━━━━━━━━━━
+ FileTreeRow is TreeBoxItem'FileNode

• This • text:file-icon-color(#item)

────────────────────

<This
    has-children = #item?.is-directory ?? false
    content-text = file-row-text(#item, #item?.#name)

━━━━━━━━━━━━━━━━━━━━
+ file-row-text String
    - node FileNode?
    - name String?

|? node && name
    "${file-icon-text(node)} ${file-display-name(node.is-directory, node.kind, name)}"
??
    ""
