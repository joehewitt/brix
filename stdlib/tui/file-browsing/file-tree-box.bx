(import ./file-row)
(import ./file-view)
(import /os/file-tree)
(import /tui)
(import /tui/treebox)

(type + FileTreeBox (is FileView)
  (content
    (<> This (• flex-col)
      (<> (of TreeBox FileNode) (id: tree) (• flex 1)
        (= root-node (. files root))
        (= load-children (=> (node) (call (. files children-of) node)))
        (= key-builder (=> (node) (. node key)))
        (blank)
        (<> FileTreeRow (slot: row) (param: item)
          (= item item)
        )
      )
    )
  )
  (subscribe-for (on touched (. files changed))
    (call (. tree reload))
  )
  (whenever-rule (. tree #entries)
    (call sync-retained)
  )
  (subscribe-for (on event (. tree selected))
    (call note-selection)
  )
  (subscribe-for (on event (. tree activated))
    (let node (call selected-node))
    (if (and node (not (. node is-directory)))
      (call open node)
    )
  )
  (fn-expr + selected-node (? FileNode)
    (. tree selected-item)
  )
  (fn-do + show-node _
    (param node FileNode)
    (let ignored (catch? (call (. tree reveal-key-path) (call (. files keys-to) node))))
  )
  (fn-do + focus-list _
    (call (. tree focus-list))
  )
  (fn-do + follow-current _
    (let node (. session current))
    (return-if (if (or (not node) (. node is-detached) (== (?. (. tree selected-item) key) (. node key)))))
    (call show-node node)
  )
  (fn-expr + search-candidates (list FileNode)
    (call (of List FileNode) (in (. each item) (. tree entries)))
  )
  (fn-do + select-node _
    (param node FileNode)
    (for (in index (..< 0 (. tree entries length)))
      (if (== (. ([] (. tree entries) index) key) (. node key))
        (let row (call (. tree row-at-index) index))
        (if row
          (catch (call (. tree select-row) row))
        )
        (return)
      )
    )
  )
  (fn-do _ sync-retained _
    (let next (call (of Map String FileNode)))
    (for (in entry (. tree entries))
      (if (. entry is-expanded)
        (= ([] next (. entry key)) (. entry item))
      )
    )
    (call retain-only next)
  )
)
