/os/file-tree
/os/path
/tui

━━━━━━━━━━━━━━━━━━━━
+ file-icon-text String
    - node FileNode

|? node.is-directory
    "📁"
|? node.kind == PathKind.link
    "🔗"
|? node.kind == PathKind.file
    "📄"
??
    "·"

━━━━━━━━━━━━━━━━━━━━
+ file-icon-color AnsiColor
    - node FileNode?

|? !node
    silver
|? node.is-directory
    aqua
|? node.kind == PathKind.link
    yellow
??
    silver

━━━━━━━━━━━━━━━━━━━━
+ file-display-name String
    - is-directory Bool
    - kind PathKind
    - name String

|? is-directory
    "$name/"
|? kind == PathKind.link
    "$name@"
??
    name
