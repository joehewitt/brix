+ FileView is Box

• This
    focus-mode = FocusMode.inside

+ files FileTree
+ session FileSession = FileSession()
+ query = ""

_ clears-query := debounced(file-search-clear-delay, this.clear-query)
_ retained Map'String'FileNode = Map'String'FileNode()

────────────────────
for event on key-input

if file-is-search-char(event.char) && !event.modifiers.option && !event.modifiers.control
    extend-query(event.char)
    event.cancel()

────────────────────
for node on session.revealed

choose(node)
show-node(node)
focus-list()

────────────────────
whenever session.#current

follow-current()

