_ preview-error-detail = "The file may be unreadable or invalid for the selected preview mode."
_ preview-sniff-byte-limit Size = 8192
_ preview-sniff-control-threshold Size = 4
_ preview-sniff-control-percent Size = 2

+ FilePreviewCloseEvent is BoxEvent

