+ FileBinarySource
    is VirtualSource'String
    is VirtualSequenceDomain
    is Closable

+ revision := VirtualRevision()
+ byte-count => file-size

_ file File'Byte?
_ file-size Index
_ row-count VirtualCoord

────────────────────
+ This ?! IOError
    - path Path

. size = path.size
?! IOError("Unable to preview a negative-sized file")
    if size < 0

file-size = size as Index
row-count = max(1vcoord, (((file-size + 15) / 16) as VirtualCoord))
file = File'Byte(path)

────────────────────
+ get domain VirtualSequenceDomain

this

╌╌╌╌╌╌╌╌╌╌ is VirtualSequenceDomain ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get known-count

row-count

────────────────────
+ get estimated-count VirtualCoord?

row-count

────────────────────
+ get is-final

true

────────────────────
+ address-at
    - index VirtualCoord

index as I64

────────────────────
+ index-of
    - address I64

|? address < 0 || address >= (row-count as I64)
    null
??
    address as VirtualCoord

╌╌╌╌╌╌╌╌╌╌ is VirtualSource'String ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do bind
    - address I64
    - generation U64
    - target VirtualBindingTarget'String

if address < 0 || address >= (row-count as I64) || !file
    target.fail(generation)
    =

if file-size == 0
    target.commit(VirtualKey(revision.value, 0), "(empty file)", generation)
    =

. offset = (address as Index) * 16
. amount = min(16, (file-size - offset))
. bytes = Byte[amount]
. maybe-actual = catch? file!.read(amount, bytes, offset)
if !maybe-actual || maybe-actual != amount
    target.fail(generation)
    =

. text = binary-preview-row(bytes, offset)
target.commit(VirtualKey(revision.value, offset), text, generation)

╌╌╌╌╌╌╌╌╌╌ is Closable ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do close

=? if !file
file.close()
file = null
revision.bump()

────────────────────
_ binary-preview-row
    - bytes Byte[]
    - offset Index

". $offset  $hex $ascii"

.. hex = hex-bytes(bytes)
.. ascii = ascii-bytes(bytes)

────────────────────
_ hex-bytes
    - bytes Byte[]

" ".join((bytes[each] as Hex)[2 .. < 4] in 0 .. < bytes.size)

────────────────────
_ ascii-bytes
    - bytes Byte[]

"".join(printable-byte(bytes[each]) in 0 .. < bytes.size)

────────────────────
_ printable-byte
    - value Byte

|? value >= 32 && value <= 126
    (value as Char) as String
??
    "."

━━━━━━━━━━━━━━━━━━━━
+ FilePreviewContent is Union

| none
| text(path Path, source FileLineSource, is-empty Bool)
| binary(path Path, source FileBinarySource)
| error(path Path)

━━━━━━━━━━━━━━━━━━━━
_ preview-content-text (path Path, source FileLineSource)?
    - content FilePreviewContent

match? content
    | .text(path, source, is-empty)
        (path, source)

━━━━━━━━━━━━━━━━━━━━
_ preview-content-binary
    - content FilePreviewContent

match? content
    | .binary(path, source)
        source

━━━━━━━━━━━━━━━━━━━━
_ preview-content-message
    - content FilePreviewContent

match content
    | .text(path, source, is-empty)
        if is-empty then "(empty file)" else ""
    | .error(path)
        "Unable to preview this file."
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ preview-content-message-detail
    - content FilePreviewContent

match content
    | .error(path)
        preview-error-detail
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ preview-content-title
    - content FilePreviewContent
    - extent VirtualExtent

match content
    | .text(path, source, is-empty)
        |? extent.is-final
            " ${path.name} | ${source.known-count} lines"
        ??
            " ${path.name} "
    | .binary(path, source)
        " ${path.name} | ${source.byte-count} bytes | binary "
    | .error(path)
        " ${path.name} "
    ??
        " Preview "

━━━━━━━━━━━━━━━━━━━━
_ do open-preview-content ?! Error
    - path Path

if preview-file-is-text(path)
    . source = FileLineSource(path)
    = FilePreviewContent.text(path, source, source.byte-count == 0)

. source = FileBinarySource(path)
= FilePreviewContent.binary(path, source)

