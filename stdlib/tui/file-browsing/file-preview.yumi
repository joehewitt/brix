` The preview lifecycle: opening loads the requested path, closing unwinds and announces
` itself. Refreshes while open reload content without a phase change.

~> is-closed

~> is-open for path on open-requests
    do
        load-path(path)

    do finally
        unload-preview()

    then is-closed on close-requests

────────────────────
for path on refresh-requests

if is-open
    refresh-path(path)

────────────────────
for event on scrolled

if is-open
    scroll-from-command(event.direction)
    event.cancel()

────────────────────
when #is-open

focus-self()

────────────────────
+ do scroll-from-command
    - direction Direction

. ignored = region.scroll(3, direction)

────────────────────
+ do scroll-page
    - direction Direction

. amount = max(1, region.content-bounds.height)
. ignored = region.scroll(amount, direction)

────────────────────
+ do scroll-to-start

. ignored = region.scroll-to-address(0)

────────────────────
+ do scroll-to-end

. binary = preview-content-binary(content)
if binary
    scroll-binary-to-end(binary)
    =

. text = preview-content-text(content)
if text
    scroll-text-to-end(text.path, text.source)

────────────────────
_ do scroll-binary-to-end
    - source FileBinarySource

. last = (source.known-count as I64) - 1
. ignored = region.scroll-to-address(last)

────────────────────
_ do scroll-text-to-end
    - path Path
    - source FileLineSource

source.scan-to-end()
    catch Error
        show-preview-error(path)
        =
if source.known-count == 0vcoord
    content = .text(path, source, true)
    =
content = .text(path, source, false)
region.refresh-bindings()
. last = (source.known-count as I64) - 1
. ignored = region.scroll-to-address(last)

────────────────────
+ do load-path
    - path Path

if !catch? install-path(path)
    show-preview-error(path)

────────────────────
_ do install-path ?! Error
    - path Path

release-preview-content()
. opened = open-preview-content(path)
content = opened
match opened
    | .text(current-path, source, is-empty)
        region.source = source
    | .binary(current-path, source)
        region.source = source
    ??
        region.source = null
region.virtual-scroll = VirtualPoint(0vcoord, 0vcoord)
region.invalidate-layout()

────────────────────
+ do refresh-path
    - path Path

if !catch? refresh-path-content(path)
    show-preview-error(path)

────────────────────
_ do refresh-path-content ?! Error
    - path Path

. current = preview-content-text(content)
if current
    refresh-text-path-content(path, current.path, current.source)
else
    install-path(path)

────────────────────
_ do refresh-text-path-content ?! Error
    - path Path
    - current-path Path
    - source FileLineSource

if current-path != path || !preview-file-is-text(path)
    install-path(path)
    =

. reset = source.refresh()
if reset
    region.virtual-scroll = VirtualPoint(0vcoord, 0vcoord)
content = .text(path, source, source.byte-count == 0)
region.refresh-bindings()
region.invalidate-layout()

────────────────────
+ do unload-preview

release-preview-content()
closed <- FilePreviewCloseEvent()

────────────────────
+ do release-preview-content

. previous = content
content = .none
region.release-bindings()

. text = preview-content-text(previous)
if text
    text.source.close()
. binary = preview-content-binary(previous)
if binary
    binary.close()

────────────────────
+ do show-preview-error
    - path Path

release-preview-content()
content = .error(path)

────────────────────
+ preview-row-text
    - preview FilePreviewContent
    - address I64
    - content String

match preview
    | .binary(path, source)
        content
    ??
        "${address + 1}: $content"

────────────────────
+ focus-self

ancestor'Window?.focus(this)

━━━━━━━━━━━━━━━━━━━━
_ do preview-file-is-text ?! Error
    - path Path

. file-size = path.size
?! IOError("Unable to preview a negative-sized file")
    if file-size < 0
=? true if file-size == 0

. read-size = min((preview-sniff-byte-limit + 3), (file-size as Size))
. bytes = Byte[read-size]
. file = use File'Byte(path)
. actual Size = file.read(read-size, bytes, 0)
. inspected = min(actual, preview-sniff-byte-limit)
= preview-sample-is-text(bytes, actual, inspected)

━━━━━━━━━━━━━━━━━━━━
_ do preview-sample-is-text
    - bytes Byte[]
    - available Size
    - inspected Size

. controls Size
. valid = true
. index Index
while index < inspected && valid
    . byte = bytes[index]
    if byte == 0
        valid = false
    else if byte <= 127
        if preview-suspicious-control(byte)
            controls += 1
        index += 1
    else
        . sequence = file-valid-utf8-sequence(bytes, available, index)
        if sequence == 0
            valid = false
        else
            index += sequence

= match valid, controls >= preview-sniff-control-threshold
    | false, _
        false
    | _, false
        true
    ??
        controls * 100 <= inspected * preview-sniff-control-percent

━━━━━━━━━━━━━━━━━━━━
_ preview-suspicious-control
    - byte Byte

(byte < 32 && byte != 9 && byte != 10 && byte != 12 && byte != 13) || byte == 127
