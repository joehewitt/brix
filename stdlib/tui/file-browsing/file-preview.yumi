────────────────────

if #is-open
    <Shortcut "Scroll up"
        key = .arrow-up
        action = => do scroll-from-command(Direction.up)

    <Shortcut "Scroll down"
        key = .arrow-down
        action = => do scroll-from-command(Direction.down)

    <Shortcut "Page up"
        key = KeyCombo(Key.page-up)
        action = => do scroll-page(Direction.up)

    <Shortcut "Page down"
        key = KeyCombo(Key.page-down)
        action = => do scroll-page(Direction.down)

    <Shortcut "Start of preview"
        key = KeyCombo(Key.home)
        action = => do scroll-to-start()

    <Shortcut "End of preview"
        key = KeyCombo(Key.end)
        action = => do scroll-to-end()

    <Shortcut "Close preview"
        key = .space
        action = => do close-requests <- true

<ModalBackdrop

<Box • flex-col absolute border:yellow bg:black
    left = 1
    top = 1
    right = 1
    bottom = 2

    <Label • text:black bg:yellow
        text = #title

    <Box • flex-col flex:1 bg:black px:1
        <VirtualRegion'String region • flex:1
            virtual-layout = VerticalFixedLayout(1vcoord)
            overscan = VirtualInsets(3vcoord, 0vcoord, 3vcoord, 0vcoord)

            <Label (row) - slot • text:silver bg:black
                text = preview-row-text(#content, slot.#address, slot.#item)

        if #preview-message.length > 0
            <Box • flow-col absolute inset:0 bg:black
                <Label • text:yellow bg:black
                    text = #preview-message

                if #preview-message-detail.length > 0
                    <Label • text:silver bg:black
                        text = #preview-message-detail

