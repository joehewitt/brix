./file-row
./file-view
/os/file-tree
/tui
/tui/columntree

━━━━━━━━━━━━━━━━━━━━
+ FileColumnTree is FileView

────────────────────

<This • flex-col
    <ColumnTree'FileNode columns • flex:1
        root-node = files.root
        load-children = :: node => files.children-of(node)
        key-builder = :: node => node.key

        <FileRow (row) - item
            item = item

────────────────────
for touched on files.changed

columns.refresh()

────────────────────
whenever columns.#owners

sync-retained()

────────────────────
for event on columns.selected

note-selection()

────────────────────
for event on columns.active-column-changed

note-selection()

────────────────────
for event on columns.activated

. node = selected-node()
if node && !node.is-directory
    open(node)

────────────────────
+ selected-node FileNode?

columns.selected-item

────────────────────
+ do show-node
    - node FileNode

. ignored = columns.restore-path(files.keys-to(node))

────────────────────
+ do focus-list

. column = columns.active-column
if column
    columns.focus-column(column)

────────────────────
+ do follow-current

. node = session.current
=? if !node || node.is-detached || columns.selected-item?.key == node.key
show-node(node)

────────────────────
+ search-candidates [FileNode]

if column then column.items else List'FileNode()

.. column = columns.active-column

────────────────────
+ do select-node
    - node FileNode

. column = columns.active-column
=? if !column
for index in 0 .. < column.items.length
    if column.items[index].key == node.key
        . row = column.row-at-index(index)
        if row
            catch column.select-row(row)
        =

────────────────────
_ do sync-retained

. next = Map'String'FileNode()
for owner in columns.owners
    next[owner.key] = owner
retain-only(next)
