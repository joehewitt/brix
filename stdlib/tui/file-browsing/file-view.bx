(import /os/file-session)
(import /os/file-tree)
(import /os/path)
(import /time/debounced)
(import /time/duration)
(import /tui)
(blank)
(prop + file-search-clear-delay _ (= 850ms))

(type + FileView (is Box)
  (rule This
    (= focus-mode (. FocusMode inside))
  )
  (blank)
  (prop + files FileTree)
  (prop + session FileSession (= (call FileSession)))
  (prop + query _ (= ""))
  (blank)
  (prop _ clears-query _ (:= (call debounced file-search-clear-delay (. this clear-query))))
  (prop _ retained (of Map String FileNode) (= (call (of Map String FileNode))))
  (subscribe-for (on event key-input)
    (if (and (call file-is-search-char (. event char)) (not (. event modifiers option)) (not (. event modifiers control)))
      (call extend-query (. event char))
      (call (. event cancel))
    )
  )
  (subscribe-for (on node (. session revealed))
    (call choose node)
    (call show-node node)
    (call focus-list)
  )
  (whenever-rule (. session #current)
    (call follow-current)
  )
  (fn-do + unmounted _
    (call retain-only (call (of Map String FileNode)))
    (call (. super unmounted))
  )
  (fn-expr + selected-node (? FileNode)
    null
  )
  (fn-do + show-node _
    (param node FileNode)
  )
  (fn-do + focus-list _)
  (fn-do + follow-current _)
  (fn-expr + search-candidates (list FileNode)
    (call (of List FileNode))
  )
  (fn-do + select-node _
    (param node FileNode)
  )
  (fn-do + reveal Bool
    (param target Path)
    (let node (call (. files find) target))
    (return-if false (if (not node)))
    (blank)
    (call show-node node)
    (return true)
  )
  (fn-do + open _
    (param node (? FileNode))
    (if node
      (<- (. session opened) node)
    )
  )
  (fn-do + note-selection _
    (return-if (if (call hidden-layout-boundary)))
    (blank)
    (call choose (call selected-node))
  )
  (fn-do + choose _
    (param node (? FileNode))
    (if (!= (?. (. session current) key) (?. node key))
      (= (. session current) node)
    )
  )
  (fn-do + retain-only _
    (param next (of Map String FileNode))
    (for (in pair (. retained items))
      (if (not (has next (. pair key)))
        (call (. files release) (. pair value))
      )
    )
    (for (in pair (. next items))
      (if (not (has retained (. pair key)))
        (call (. files retain) (. pair value))
      )
    )
    (= retained next)
  )
  (fn-do + extend-query _
    (param char Char)
    (let is-fresh (== (. query length) 0))
    (+= query (. char lowercase))
    (call clears-query)
    (let candidates (call search-candidates))
    (return-if (if (== (. candidates length) 0)))
    (blank)
    (let current (call selected-node))
    (let start Index 0)
    (for (in index (..< 0 (. candidates length)))
      (if (and current (== (. ([] candidates index) key) (. current key)))
        (= start index)
      )
    )
    (let offset (if-expr is-fresh 1 0))
    (for (in scan (..< 0 (. candidates length)))
      (let node ([] candidates (% (+ start offset scan) (. candidates length))))
      (if (call (. node sort-name starts-with) query)
        (call select-node node)
        (return)
      )
    )
  )
  (fn-do _ clear-query _
    (= query "")
  )
)

(fn-expr + file-is-search-char Bool
  (param char Char)
  (case? (and (>= char 'a') (<= char 'z'))
    true
  )
  (case? (and (>= char 'A') (<= char 'Z'))
    true
  )
  (case? (and (>= char '0') (<= char '9'))
    true
  )
  (default
    (or (== char '_') (== char '-') (== char '.'))
  )
)
