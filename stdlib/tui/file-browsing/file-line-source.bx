(import /math)
(import /os/file)
(import /os/path)
(import /time/clock)
(import /ui/virtual)
(blank)
(prop _ file-line-read-chunk Size (= 4096))
(prop _ file-line-raw-display-limit Size (= 1024))
(prop _ file-line-display-character-limit Size (= 240))
(prop _ file-line-normal-page-lines Size (= 256))
(prop _ file-line-page-cache-limit Size (= 16))

(type + FileLineSource
  (implements (of VirtualSource String))
  (implements VirtualSequenceDomain)
  (implements Closable)
  (prop + revision _ (:= (call VirtualRevision)))
  (prop + byte-count _ (=> file-size))
  (blank)
  (prop _ path Path)
  (prop _ file (? (of File Byte)))
  (prop _ identity FileLineIdentity)
  (prop _ file-size Index)
  (prop _ known-line-count VirtualCoord)
  (prop _ known-byte-offset Index)
  (prop _ final Bool)
  (prop _ final-line-start-offset Index)
  (prop _ final-line-unterminated Bool)
  (prop _ pages (list FileLinePage))
  (prop _ checkpoints (list FileLineCheckpoint))
  (fn-do + This _ (?! Error)
    (param path Path)
    (= identity (call FileLineIdentity path))
    (blank)
    (throw (call IOError "Unable to open a negative-sized file") (if (< (. identity size) 0)))
    (blank)
    (= file-size (as (. identity size) Index))
    (= file (call (of File Byte) (as path String)))
  )
  (fn-expr + domain VirtualSequenceDomain :get
    this
  )
  (fn-expr + known-count VirtualCoord :get
    known-line-count
  )
  (fn-expr + estimated-count (? VirtualCoord) :get
    (call estimate-count)
  )
  (fn-expr + is-final Bool :get
    final
  )
  (fn-expr + address-at I64
    (param index VirtualCoord)
    index
  )
  (fn-expr + index-of (? VirtualCoord)
    (param address I64)
    (case? (< address 0)
      null
    )
    (case? (and final (>= (as address VirtualCoord) known-line-count))
      null
    )
    (default
      (as address VirtualCoord)
    )
  )
  (fn-do + close _
    (return-if (if (not file)))
    (blank)
    (call (. file close))
    (= file null)
    (call (. revision bump))
    (call clear-cache-and-domain)
  )
  (fn-do + bind _
    (param address I64)
    (param generation U64)
    (param target (of VirtualBindingTarget String))
    (if (or (< address 0) (not file))
      (call (. target fail) generation)
      (return)
    )
    (blank)
    (let record (catch? (call resolve address)))
    (if (not record)
      (call (. target fail) generation)
      (return)
    )
    (blank)
    (let key (call VirtualKey (. revision value) (. record start-offset)))
    (call (. target commit) key (. record text) generation)
  )
  (fn-do + scan-to-end _ (?! IOError)
    (throw (call IOError "FileLineSource is closed") (if (not file)))
    (blank)
    (call scan-to-end-impl)
  )
  (fn-do + refresh Bool (?! Error)
    (let next (call FileLineIdentity path))
    (throw (call IOError "Unable to refresh a negative-sized file") (if (< (. next size) 0)))
    (blank)
    (let resets
      (block
        (case? (or (!= (. next dev) (. identity dev)) (!= (. next ino) (. identity ino)))
          true
        )
        (case? (< (. next size) (. identity size))
          true
        )
        (case? (and (== (. next size) (. identity size)) (!= (. next mtime) (. identity mtime)))
          true
        )
        (default
          false
        )
      )
    )
    (blank)
    (if resets
      (call reset-to next)
      (else
        (if (> (. next size) (. identity size))
          (if (and final final-line-unterminated (> known-line-count 0vcoord))
            (call rollback-unterminated-final-line)
            (else
              (= final false)
            )
          )
        )
        (= identity next)
        (= file-size (as (. next size) Index))
      )
    )
    (blank)
    (return resets)
  )
  (fn-expr _ estimate-count (? VirtualCoord)
    (case? final
      known-line-count
    )
    (case? (or (<= known-line-count 0vcoord) (== known-byte-offset 0))
      null
    )
    (default
      (call max known-line-count (as estimate VirtualCoord))
    )
    (where
      (lazy estimate (/ (* (as file-size I64) (as known-line-count I64)) (as known-byte-offset I64)))
    )
  )
  (fn-do _ reset-to _ (?! IOError)
    (param next FileLineIdentity)
    (call (?. file close))
    (= file null)
    (call clear-cache-and-domain)
    (call (. revision bump))
    (= identity next)
    (= file-size (as (. next size) Index))
    (= file (call (of File Byte) (as path String)))
  )
  (fn-do _ clear-cache-and-domain _
    (= pages (call (of List FileLinePage)))
    (= checkpoints (call (of List FileLineCheckpoint)))
    (= known-line-count 0vcoord)
    (= known-byte-offset 0)
    (= final false)
    (= final-line-start-offset 0)
    (= final-line-unterminated false)
  )
  (fn-do _ resolve (? FileLineRecord) (?! IOError)
    (param address VirtualCoord)
    (if (and final (>= address known-line-count))
      (return null)
    )
    (blank)
    (let cached (call cached-record address))
    (if cached
      (return cached)
    )
    (blank)
    (let extends-prefix (>= address known-line-count))
    (let scan-start
      (block
        (case? extends-prefix
          (call FileLineCheckpoint known-line-count known-byte-offset)
        )
        (default
          (call closest-checkpoint address)
        )
      )
    )
    (let scan-line (. scan-start line))
    (let scan-offset (. scan-start offset))
    (blank)
    (let scanner (call FileLineScanner this scan-offset))
    (while (< scan-line address)
      (let skipped (call (. scanner skip-line)))
      (if (not skipped)
        (if extends-prefix
          (call publish-prefix scan-line (. scanner offset) true)
          (call note-final-line scan-line (. scanner last-line-start) (. scanner last-line-terminated))
        )
        (return null)
      )
      (+= scan-line 1vcoord)
      (if extends-prefix
        (call publish-prefix scan-line (. scanner offset) (. scanner at-eof))
        (if (. scanner at-eof)
          (call note-final-line scan-line (. scanner last-line-start) (. scanner last-line-terminated))
        )
      )
      (call retain-checkpoint-if-boundary scan-line (. scanner offset))
    )
    (blank)
    (let records (list FileLineRecord))
    (while (< (. records length) file-line-normal-page-lines)
      (let scanned (call (. scanner next-line)))
      (if (not scanned)
        (if extends-prefix
          (call publish-prefix scan-line (. scanner offset) true)
          (call note-final-line scan-line (. scanner last-line-start) (. scanner last-line-terminated))
        )
        (break)
      )
      (let record (call FileLineRecord (. scanned start-offset) (. scanned text)))
      (+= records record)
      (+= scan-line 1vcoord)
      (if extends-prefix
        (call publish-prefix scan-line (. scanner offset) (. scanner at-eof))
        (if (. scanner at-eof)
          (call note-final-line scan-line (. scanned start-offset) (. scanned terminated))
        )
      )
      (call retain-checkpoint-if-boundary scan-line (. scanner offset))
      (if (. scanner at-eof)
        (break)
      )
    )
    (blank)
    (if (not (. records length))
      (return null)
    )
    (blank)
    (+= pages (call FileLinePage address records))
    (if (> (. pages length) file-line-page-cache-limit)
      (call (. pages remove) 0)
    )
    (return ([] records 0))
  )
  (fn-do _ cached-record (? FileLineRecord)
    (param address VirtualCoord)
    (let page-index Index)
    (while (< page-index (. pages length))
      (let page ([] pages page-index))
      (let relative (- address (. page first-line)))
      (if (and (>= relative 0vcoord) (< relative (as (as (. page lines length) I64) VirtualCoord)))
        (return ([] (. page lines) relative))
      )
      (+= page-index 1)
    )
    (return null)
  )
  (fn-do _ publish-prefix _
    (param count VirtualCoord)
    (param offset Index)
    (param is-eof Bool)
    (= known-line-count count)
    (= known-byte-offset offset)
    (if is-eof
      (= final true)
    )
  )
  (fn-do _ note-final-line _
    (param count VirtualCoord)
    (param start-offset Index)
    (param terminated Bool)
    (if (<= count 0vcoord)
      (= final-line-start-offset 0)
      (= final-line-unterminated false)
      (else
        (= final-line-start-offset start-offset)
        (= final-line-unterminated (not terminated))
      )
    )
  )
  (fn-do _ rollback-unterminated-final-line _
    (let rollback-line (- known-line-count 1vcoord))
    (let page-index Index)
    (while (< page-index (. pages length))
      (let page-end (. ([] pages page-index) first-line))
      (+= page-end (as (as (. ([] pages page-index) lines length) I64) VirtualCoord))
      (if (> page-end rollback-line)
        (call (. pages remove) page-index)
        (else
          (+= page-index 1)
        )
      )
    )
    (blank)
    (let checkpoint-index Index)
    (while (< checkpoint-index (. checkpoints length))
      (if (> (. ([] checkpoints checkpoint-index) line) rollback-line)
        (call (. checkpoints remove) checkpoint-index)
        (else
          (+= checkpoint-index 1)
        )
      )
    )
    (blank)
    (= known-line-count rollback-line)
    (= known-byte-offset final-line-start-offset)
    (= final false)
    (= final-line-unterminated false)
    (call (. revision bump))
  )
  (fn-do _ scan-to-end-impl _ (?! IOError)
    (return-if (if final))
    (blank)
    (let scanner (call FileLineScanner this known-byte-offset))
    (let line known-line-count)
    (let last-line-start final-line-start-offset)
    (let last-line-terminated (not final-line-unterminated))
    (while true
      (if (not (call (. scanner skip-line)))
        (break)
      )
      (+= line 1vcoord)
      (= last-line-start (. scanner last-line-start))
      (= last-line-terminated (. scanner last-line-terminated))
      (call retain-checkpoint-if-boundary line (. scanner offset))
    )
    (call publish-prefix line (. scanner offset) true)
    (call note-final-line line last-line-start last-line-terminated)
  )
  (fn-do _ closest-checkpoint FileLineCheckpoint
    (param address VirtualCoord)
    (let index (. checkpoints length))
    (while (> index 0)
      (-= index 1)
      (let checkpoint ([] checkpoints index))
      (if (<= (. checkpoint line) address)
        (return checkpoint)
      )
    )
    (return (call FileLineCheckpoint 0vcoord 0))
  )
  (fn-do _ retain-checkpoint-if-boundary _
    (param line VirtualCoord)
    (param offset Index)
    (if (and (> line 0vcoord) (== (as (% line (as file-line-normal-page-lines I64)) VirtualCoord) 0vcoord))
      (call retain-checkpoint line offset)
    )
  )
  (fn-do _ retain-checkpoint _
    (param line VirtualCoord)
    (param offset Index)
    (return-if (if (<= line 0vcoord)))
    (blank)
    (if (. checkpoints length)
      (let last ([] checkpoints (- (. checkpoints length) 1)))
      (return-if (if (>= (. last line) line)))
    )
    (blank)
    (+= checkpoints (call FileLineCheckpoint line offset))
  )
  (fn-do _ read-chunk Size (?! IOError)
    (param size Size)
    (param buffer ([] Byte))
    (param offset Index)
    (throw (call IOError "FileLineSource is closed") (if (not file)))
    (blank)
    (return (call (. file read) size buffer offset))
  )
)

(fn-expr + file-valid-utf8-sequence Size
  (param bytes ([] Byte))
  (param size Size)
  (param index Index)
  (case? (<= first 127)
    1
  )
  (case? (and (>= first 194) (<= first 223))
    (if-expr (and (< (+ index 1) size) (call file-utf8-continuation ([] bytes (+ index 1)))) 2 0)
  )
  (case? (and (>= first 224) (<= first 239))
    (call file-valid-utf8-three bytes size index)
  )
  (case? (and (>= first 240) (<= first 244))
    (call file-valid-utf8-four bytes size index)
  )
  (default
    0
  )
  (where
    (lazy first ([] bytes index))
  )
)

(type _ FileLineIdentity (is Tuple)
  (prop _ dev U64)
  (prop _ ino U64)
  (prop _ size I64)
  (prop _ mtime ClockTime)
  (fn-do + This _ (?! Error)
    (param path Path)
    (return
      (call This (. stat dev) (. stat ino) (. stat size) (. stat mtime)
        (block
          (lazy stat (. path stat))
        )
      )
    )
  )
)

(type _ FileLineRecord (is Tuple)
  (prop _ start-offset Index)
  (prop _ text String)
)

(type _ FileLinePage (is Tuple)
  (prop _ first-line VirtualCoord)
  (prop _ lines (list FileLineRecord))
)

(type _ FileLineCheckpoint (is Tuple)
  (prop _ line VirtualCoord)
  (prop _ offset Index)
)

(type _ FileLineScan (is Tuple)
  (prop _ start-offset Index)
  (prop _ text String)
  (prop _ terminated Bool)
)

(type _ FileLineScanner
  (prop _ source FileLineSource)
  (prop _ buffer-size Size)
  (prop _ buffer-index Index)
  (prop _ offset Index)
  (prop _ at-eof Bool)
  (prop _ last-line-start Index)
  (prop _ last-line-terminated Bool)
  (prop _ buffer _ (:= ([] Byte file-line-read-chunk)))
  (fn-do _ This _
    (param source _)
    (param offset _)
  )
  (fn-do _ next-line (? FileLineScan) (?! IOError)
    (return-if (if at-eof))
    (blank)
    (let start offset)
    (= last-line-start start)
    (= last-line-terminated false)
    (let raw ([] Byte file-line-raw-display-limit))
    (let raw-size Size)
    (let has-bytes Bool)
    (blank)
    (while true
      (let maybe-byte (call next-byte))
      (if (not maybe-byte)
        (= at-eof true)
        (if (not has-bytes)
          (return null)
        )
        (break)
      )
      (let byte maybe-byte)
      (if (== byte 10)
        (= last-line-terminated true)
        (break)
      )
      (= has-bytes true)
      (if (< raw-size (. raw size))
        (= ([] raw raw-size) byte)
        (+= raw-size 1)
      )
    )
    (blank)
    (if (and raw-size (== ([] raw (- raw-size 1)) 13))
      (-= raw-size 1)
    )
    (return (call FileLineScan start (call file-line-display raw raw-size) last-line-terminated))
  )
  (fn-do _ skip-line Bool (?! IOError)
    (return-if (if at-eof))
    (blank)
    (= last-line-start offset)
    (= last-line-terminated false)
    (let has-bytes Bool)
    (while true
      (let maybe-byte (call next-byte))
      (if (not maybe-byte)
        (= at-eof true)
        (return has-bytes)
      )
      (if (== maybe-byte 10)
        (= last-line-terminated true)
        (return true)
      )
      (= has-bytes true)
    )
  )
  (fn-do _ next-byte (? Byte) (?! IOError)
    (if (>= buffer-index buffer-size)
      (if (>= offset (. source file-size))
        (= at-eof true)
        (return null)
      )
      (let remaining (- (. source file-size) offset))
      (let request (call min file-line-read-chunk remaining))
      (= buffer-size (call (. source read-chunk) request buffer offset))
      (= buffer-index 0)
      (if (not buffer-size)
        (= at-eof true)
        (return null)
      )
    )
    (blank)
    (let byte ([] buffer buffer-index))
    (+= buffer-index 1)
    (+= offset 1)
    (if (>= offset (. source file-size))
      (= at-eof true)
    )
    (return byte)
  )
)

(fn-do _ file-line-display String
  (param raw ([] Byte))
  (param size Size)
  (let output ([] Byte (* file-line-display-character-limit 4)))
  (let read-index Index)
  (let write-index Index)
  (let characters Size)
  (while (and (< read-index size) (< characters file-line-display-character-limit))
    (let sequence (call file-valid-utf8-sequence raw size read-index))
    (if sequence
      (let copy-index Size)
      (while (< copy-index sequence)
        (= ([] output write-index) ([] raw (+ read-index copy-index)))
        (+= write-index 1)
        (+= copy-index 1)
      )
      (+= read-index sequence)
      (else
        (= ([] output write-index) 239)
        (= ([] output (+ write-index 1)) 191)
        (= ([] output (+ write-index 2)) 189)
        (+= write-index 3)
        (+= read-index 1)
      )
    )
    (+= characters 1)
  )
  (return (call (. output slice-string) (..< 0 write-index)))
)

(fn-expr _ file-valid-utf8-three Size
  (param bytes ([] Byte))
  (param size Size)
  (param index Index)
  (case? (>= (+ index 2) size)
    0
  )
  (case? (not third-valid)
    0
  )
  (case? (== first 224)
    (if-expr (and (>= second 160) (<= second 191)) 3 0)
  )
  (case? (== first 237)
    (if-expr (and (>= second 128) (<= second 159)) 3 0)
  )
  (default
    (if-expr (call file-utf8-continuation second) 3 0)
  )
  (where
    (lazy first ([] bytes index))
    (lazy second ([] bytes (+ index 1)))
    (lazy third-valid (call file-utf8-continuation ([] bytes (+ index 2))))
  )
)

(fn-expr _ file-valid-utf8-four Size
  (param bytes ([] Byte))
  (param size Size)
  (param index Index)
  (case? (>= (+ index 3) size)
    0
  )
  (case? (or (not third-valid) (not fourth-valid))
    0
  )
  (case? (== first 240)
    (if-expr (and (>= second 144) (<= second 191)) 4 0)
  )
  (case? (== first 244)
    (if-expr (and (>= second 128) (<= second 143)) 4 0)
  )
  (default
    (if-expr (call file-utf8-continuation second) 4 0)
  )
  (where
    (lazy first ([] bytes index))
    (lazy second ([] bytes (+ index 1)))
    (lazy third-valid (call file-utf8-continuation ([] bytes (+ index 2))))
    (lazy fourth-valid (call file-utf8-continuation ([] bytes (+ index 3))))
  )
)

(fn-expr _ file-utf8-continuation Bool
  (param byte Byte)
  (and (>= byte 128) (<= byte 191))
)
