(import /os/file-tree)
(import /os/path)
(import /tui)

(fn-expr + file-icon-text String
  (param node FileNode)
  (case? (. node is-directory)
    "📁"
  )
  (case? (== (. node kind) (. PathKind link))
    "🔗"
  )
  (case? (== (. node kind) (. PathKind file))
    "📄"
  )
  (default
    "·"
  )
)

(fn-expr + file-icon-color AnsiColor
  (param node (? FileNode))
  (case? (not node)
    silver
  )
  (case? (. node is-directory)
    aqua
  )
  (case? (== (. node kind) (. PathKind link))
    yellow
  )
  (default
    silver
  )
)

(fn-expr + file-display-name String
  (param is-directory Bool)
  (param kind PathKind)
  (param name String)
  (case? is-directory
    (str name "/")
  )
  (case? (== kind (. PathKind link))
    (str name "@")
  )
  (default
    name
  )
)
