────────────────────
+ do publish-pointer'Event Bool
    - event Event
    - Event is PointerEvent

. hit = hit-path(root-point)
. canceled = hit.publish-pointer(event)
if canceled
    = true
= match event
    | ScrollEvent
        . scroll-event = event as ScrollEvent
        if route-scroll-event(scroll-event, hit.target)
            scroll-event.cancel()
        scroll-event.is-canceled
    ??
        false

.. root-point =
    match event
        | MouseDownEvent
            (event as MouseDownEvent).root-point
        | MouseUpEvent
            (event as MouseUpEvent).root-point
        | MouseMoveEvent
            (event as MouseMoveEvent).root-point
        | MouseDragEvent
            (event as MouseDragEvent).root-point
        | ScrollEvent
            (event as ScrollEvent).root-point

────────────────────
+ do route-scroll-event Bool
    - event ScrollEvent
    - target Box?

. scrollable = target
while scrollable
    if scrollable.can-scroll(event.direction)
        = scrollable.scroll(1, event.direction)
    =? false if scrollable.is-modal-root
    scrollable = scrollable.%parent

= false

────────────────────
+ do scroll
    - point Point

if point.x != scroll-x || point.y != scroll-y
    scroll-x = point.x
    scroll-y = point.y
    invalidate-paint()

────────────────────
+ do scroll Bool
    - amount Coord
    - direction Direction = Direction.down

. next = scroll-point(amount, direction)
=? if next == Point(scroll-x, scroll-y)

scroll(next)
= true

────────────────────
+ can-scroll Bool
    - direction Direction

next.x != scroll-x || next.y != scroll-y

.. next = scroll-point(1, direction)

────────────────────
+ scroll-point Point
    - amount Coord
    - direction Direction

clipped-scroll-point(unclipped-scroll-point(amount, direction))

────────────────────
+ unclipped-scroll-point
    - amount Coord
    - direction Direction

|? direction == Direction.up
    Point(scroll-x, scroll-y + amount)
|? direction == Direction.down
    Point(scroll-x, scroll-y - amount)
|? direction == Direction.left
    Point(scroll-x + amount, scroll-y)
|? direction == Direction.right
    Point(scroll-x - amount, scroll-y)
??
    Point(scroll-x, scroll-y)

────────────────────
+ clipped-scroll-point Point
    - requested Point

Point(clipped-scroll-x(requested.x), clipped-scroll-y(requested.y))

────────────────────
+ clipped-scroll-x Coord
    - requested Coord

min(0, lower-clipped)

.. lower-clipped = max(scroll-min, requested)
    .. scroll-min = min(0, content-bounds.width - inner-width)

────────────────────
+ clipped-scroll-y Coord
    - requested Coord

min(0, lower-clipped)

.. lower-clipped = max(scroll-min, requested)
    .. scroll-min = min(0, content-bounds.height - inner-height)

────────────────────
+ do scroll-bounds-visible Bool
    - rect Rect

. visible = content-bounds
. next-x = scroll-x
. next-y = scroll-y
if visible.width > 0
    if rect.x + next-x < visible.x
        next-x = visible.x - rect.x
    else if rect.right + next-x > visible.right
        next-x = visible.right - rect.right
if visible.height > 0
    if rect.y + next-y < visible.y
        next-y = visible.y - rect.y
    else if rect.bottom + next-y > visible.bottom
        next-y = visible.bottom - rect.bottom

. next = clipped-scroll-point(Point(next-x, next-y))
=? if next == Point(scroll-x, scroll-y)

scroll(next)
= true

