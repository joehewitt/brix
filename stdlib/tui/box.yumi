= match event
    | KeyPressEvent
        . key-event = event as KeyPressEvent
        . saved = key-event.begin-route(box-event-route-next, root-pointer, origin, origin, null)
        do finally key-event.end-route(saved)
        target.key-press <- key-event
        key-event.is-canceled
    | KeyInputEvent
        . input-event = event as KeyInputEvent
        . saved = input-event.begin-route(box-event-route-next, root-pointer, origin, origin, null)
        do finally input-event.end-route(saved)
        target.key-input <- input-event
        input-event.is-canceled
    | PasteEvent
        . paste-event = event as PasteEvent
        . saved = paste-event.begin-route(box-event-route-next, root-pointer, origin, origin, null)
        do finally paste-event.end-route(saved)
        target.paste <- paste-event
        paste-event.is-canceled

.. root-pointer = root as Pointer
.. origin = Point(0, 0)

