────────────────────
+ do paint
    - canvas Canvas

if !is-paint-visible
    if !is-displayed && $is-paint-invalid-below
        $is-paint-invalid-below = false
    did-paint()
    =
if $is-layout-invalid
    update-layout()

if !is-markup-shadow && !canvas.is-rect-visible(bounds)
    $is-paint-invalid = false
    =
//tui.frame.paint.boxes ++
if is-markup-shadow
    for box in structural-children
        if paint-skip-compositing-layers && box.requires-compositing-layer
            continue
        box.paint(canvas)
    did-paint()
    =
do use canvas
    paint-box-background(this, bounds, canvas)
    paint-box-border(this, bounds, canvas)
    canvas.clip(content-bounds)
    canvas.offset((scroll-x, scroll-y))

    for box in structural-children
        if paint-skip-compositing-layers && box.requires-compositing-layer
            continue
        box.paint(canvas)

did-paint()

