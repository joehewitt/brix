if !footprint && !is-markup-shadow && bounds.width > 0 && bounds.height > 0
    footprint = root-paint-bounds()
=? if !footprint

root.add-paint-damage-bounds(footprint)
clear-retained-paint-footprint()

────────────────────
+ do add-paint-damage-bounds
    - rect Rect

=? if rect.width <= 0
=? if rect.height <= 0

if !has-paint-damage-bounds
    paint-damage-bounds = rect
    has-paint-damage-bounds = true
else
    paint-damage-bounds = union-rect(paint-damage-bounds, rect)

