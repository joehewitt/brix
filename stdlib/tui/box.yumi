+ do publish-pointer'Event Bool
    - event Event
    - Event is PointerEvent

=? false if !is-current()

= match event
    | MouseDownEvent
        . mouse-event = event as MouseDownEvent
        . saved = begin-pointer-route(mouse-event, mouse-event.root-point)
        do finally mouse-event.end-route(saved)
        target.mouse-down <- mouse-event
        mouse-event.is-canceled
    | MouseUpEvent
        . mouse-event = event as MouseUpEvent
        . saved = begin-pointer-route(mouse-event, mouse-event.root-point)
        do finally mouse-event.end-route(saved)
        target.mouse-up <- mouse-event
        mouse-event.is-canceled
    | MouseMoveEvent
        . mouse-event = event as MouseMoveEvent
        . saved = begin-pointer-route(mouse-event, mouse-event.root-point)
        do finally mouse-event.end-route(saved)
        target.mouse-move <- mouse-event
        mouse-event.is-canceled
    | MouseDragEvent
        . mouse-event = event as MouseDragEvent
        . saved = begin-pointer-route(mouse-event, mouse-event.root-point)
        do finally mouse-event.end-route(saved)
        target.mouse-drag <- mouse-event
        mouse-event.is-canceled
    | ScrollEvent
        . scroll-event = event as ScrollEvent
        . saved = begin-pointer-route(scroll-event, scroll-event.root-point)
        do finally scroll-event.end-route(saved)
        target.scrolled <- scroll-event
        scroll-event.is-canceled

