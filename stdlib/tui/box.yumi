//this:tui.box.node -> (type-of this).concrete-name, inspectable-summary(), bounds.x, bounds.y, bounds.width, bounds.height, inner-width, inner-height, scroll-x, scroll-y, $is-layout-invalid, $is-paint-invalid, is-hovered, is-pressed, is-focused, is-effectively-enabled

