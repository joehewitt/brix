────────────────────
_ do invalidate-content-size-climb Bool
    - is-origin Bool

//tui.layout.invalidation.visits ++
if !is-displayed
    //tui.layout.invalidation.hidden-stops ++
    park-hidden-dirty()
    = false

mark-measure-inputs-changed()
if layout-invalidation-kind != TuiLayout.clean
    //tui.layout.invalidation.frontier-stops ++
    = true

. parent = %parent
if parent
    =? false
        if !parent.invalidate-content-size-climb(false)

. root-was-paint-invalid = false
if !parent
    root-was-paint-invalid = $is-paint-invalid

if !parent
    if is-origin
        mark-self-layout-invalid()
    else
        mark-child-only-layout-invalid()
    $is-paint-invalid = true
    if !root-was-paint-invalid
        //tui.layout.invalidation.root-schedules ++
        schedule-paint()
else if is-origin
    mark-self-layout-invalid()
    if !$is-paint-invalid
        $is-paint-invalid = true
else if !is-markup-shadow
    mark-child-only-layout-invalid()
    $is-paint-invalid = true

= true

────────────────────
_ do root-paint-bounds Rect

. dx Coord = 0
. dy Coord = 0
. current Box? = %parent
while current
    . ancestor = current
    if !ancestor.is-markup-shadow
        dx += ancestor.scroll-x
        dy += ancestor.scroll-y
    current = ancestor.%parent
= Rect(bounds.x + dx, bounds.y + dy, bounds.width, bounds.height)

────────────────────
_ do append-active-child Box?
    - child Box
    - active-tail Box?

child.active-next = null

if child.is-markup-shadow
    . tail = active-tail
    for grandchild in child.structural-children
        tail = append-active-child(grandchild, tail)
    child.mark-shadow-active-list-clean()
    = tail

if child.participates-in-parent-layout(this)
    if !active-first-child
        active-first-child = child
        = child
    active-tail?.active-next = child
    = child

= active-tail

────────────────────
_ do has-shadow-active-list-invalid Bool

for child in structural-children when child.is-markup-shadow
    . is-invalid = child.$is-active-list-invalid
    . list-invalid = child.active-list-child-list-generation != child.child-list-generation
    . shadow-invalid = child.has-shadow-active-list-invalid()
    =? true
        if is-invalid || list-invalid || shadow-invalid
= false

────────────────────
_ do mark-shadow-active-list-clean

active-first-child = null
active-list-child-list-generation = child-list-generation
$is-active-list-invalid = false
for child in structural-children when child.is-markup-shadow
    child.mark-shadow-active-list-clean()

────────────────────
_ do update-layout-pass

if !is-displayed
    if $is-layout-invalid || $is-layout-invalid-below || hidden-dirty-below
        //tui.layout.hidden.boundary-stops ++
        hidden-dirty-below = true
        $is-layout-invalid = false
        $is-layout-invalid-below = false
    =
. needs-layout = $is-layout-invalid || hidden-dirty-below
if hidden-dirty-below
    hidden-dirty-below = false
    //tui.layout.hidden.reveals ++
    for child in structural-children
        child.invalidate-revealed-layout()

. visit-below = $is-layout-invalid-below
. did-work = needs-layout || visit-below
if needs-layout
    //tui.frame.layout.boxes ++
    //tui.layout.dirty.frontier-nodes ++
    classify-pending-layout-invalidation()
    if !is-markup-shadow
        . box-layout = $layout
        if box-layout
            . hint = LayoutArrangeHint.full
            if layout-invalidation-kind == TuiLayout.children-only && !$is-active-list-invalid
                hint = LayoutArrangeHint.children-only
            box-layout.arrange-box(this, hint)
        arrange-positioned-children()
    $is-layout-invalid = false
    mark-layout-arranged()
    visit-below = $is-layout-invalid-below

if visit-below
    $is-layout-invalid-below = false
    for child in structural-children
        child.update-layout-pass()

if did-work
    did-layout()

────────────────────
_ do invalidate-revealed-layout

if !is-displayed
    park-hidden-dirty()
    =
mark-measure-inputs-changed()
mark-self-layout-invalid()
for child in structural-children
    child.invalidate-revealed-layout()

────────────────────
_ do arrange-positioned-child
    - child Box

//tui.layout.arrange.children-considered ++
if child.is-markup-shadow
    for grandchild in child.structural-children
        arrange-positioned-child(grandchild)
    =
if child.is-displayed && !child.participates-in-parent-layout(this)
    //tui.layout.arrange.children-arranged ++
    child.effective-position.arrange(this, child)

────────────────────
_ do collect-interactive-focus-candidates
    - candidates [Box]

if focus-mode-can-focus($focus-mode)
    if is-effectively-enabled
        candidates += this
    =
for child in structural-children
    if child.is-display-visible && child.is-focus-traversal-reachable
        child.collect-interactive-focus-candidates(candidates)

────────────────────
_ do collect-interactive-focus-candidate-search
    - search FocusCandidateSearch

if focus-mode-can-focus($focus-mode)
    if is-effectively-enabled
        search.add(this)
    =
for child in structural-children
    if child.is-display-visible && child.is-focus-traversal-reachable
        child.collect-interactive-focus-candidate-search(search)

────────────────────
_ do clear-children

while true
    . maybe-child = %first-child
    if !maybe-child
        break
    . child = maybe-child
    markup-remove(this, child)
    child.close()

