while next
    . child = next
    next = child.%next-sibling
    <= child

────────────────────
+ do get active-children @inline

ensure-active-child-links()

. maybe-child = active-first-child
if maybe-child
    . child = maybe-child
    while true
        <= child
        if !child.active-next
            break
        child = child.active-next

