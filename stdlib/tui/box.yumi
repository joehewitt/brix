. own-enabled-changed < is-enabled

────────────────────
+ do inspectable-inspect
    - facet String
    - depth U32 = 1
    - offset U32 = 0
    - limit U32 = 100

match facet
    |= "children"
        emit-tui-box-children(offset, limit)
    |= "tree"
        emit-tui-box-tree(depth, offset, limit)
    |= "snapshot"
        inspectable-snapshot()
    ??
        emit-tui-box-node()

