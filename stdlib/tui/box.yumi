+ hit-test
    - point Point

hit-path(point).target

────────────────────
+ hit-path
    - point Point

|? hit
    HitPath(hit.target, this, hit.offset, point, null, frames)
??
    HitPath(this, this, Point(0, 0), point, null, frames)

.. hit = pointer-hit-result(point, Point(0, 0))
.. frames = List'HitFrame([HitFrame(this, point, input-generation)]) ++ (append-hit-path(point))

────────────────────
+ hit-path-within
    - modal Box
    - point Point

|? hit
    HitPath(hit.target, this, hit.offset, point, modal, frames)
??
    HitPath(modal, this, Point(0, 0), point, modal, frames)

.. hit = modal.pointer-hit-result(point, Point(0, 0))
.. frames = root-frames ++ (modal.append-hit-path(point))
.. root-frames [HitFrame] =
    * HitFrame(this, point, input-generation)
    * HitFrame(modal, point, modal.input-generation)

────────────────────
+ do append-hit-path [HitFrame]
    - point Point

=? List'HitFrame()
    if !is-interactive-visible

. inner-point = point.x - scroll-x, point.y - scroll-y
. cursor = %last-child
while cursor
    . child = cursor
    if child.is-markup-shadow
        . shadow-frames = child.append-hit-path(inner-point)
        if shadow-frames.length > 0
            = shadow-frames
    else if !child.is-style-shadow && child.is-interactive-visible
        if !child.bounds.contains(inner-point)
            cursor = child.%previous-sibling
            continue
        . child-frame = HitFrame(child, inner-point, child.input-generation)
        = List'HitFrame([child-frame]) ++ (child.append-hit-path(inner-point))
    cursor = child.%previous-sibling
= List'HitFrame()

────────────────────
+ do pointer-hit-result HitResult?
    - point Point
    - offset Point

=? if !is-interactive-visible

. inner-point = Point(point.x - scroll-x, point.y - scroll-y)
. child-offset = Point(offset.x + scroll-x, offset.y + scroll-y)
. cursor = %last-child
while cursor
    . child = cursor
    if child.is-markup-shadow
        =? child.pointer-hit-result(inner-point, child-offset)
    else if !child.is-style-shadow && child.is-interactive-visible
        if !child.bounds.contains(inner-point)
            cursor = child.%previous-sibling
            continue
        = child.pointer-hit-result(inner-point, child-offset) ?? HitResult(child, child-offset)
    cursor = child.%previous-sibling

