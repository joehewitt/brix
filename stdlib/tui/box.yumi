────────────────────
+ do measure MeasureResult
    - query MeasureQuery = measure-fit-query()

//tui.layout.measure.calls ++
=? zero-measure-result()
    if !is-displayed

classify-pending-layout-invalidation()

if measure-cache
    . entry = measure-cache
    if entry.generation == measure-generation && entry.query == query
        //tui.layout.measure.cache-hit ++
        = entry.result

//tui.layout.measure.cache-miss ++
. content-size = constrained-content-size(measured-content-size(query), query)
. border-size = padded-size(content-size)
. result = MeasureResult(content-size, border-size, this.outer-size(border-size))

measure-cache = MeasureCacheEntry(query, result, measure-generation)
= result

────────────────────
+ do last-measure-result MeasureResult?
