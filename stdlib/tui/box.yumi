+ do active-modal-root Box?

. modal Box?
if is-modal-root && is-interactive-visible
    modal = this

for child in structural-children
    . child-modal = child.active-modal-root()
    if child-modal
        modal = child-modal

= modal

────────────────────
+ anchor-bounds Rect
    - parent Box

match $anchor
    | Anchor.screen
        root.bounds
    | Anchor.style-target
        ?! Panic("style-target anchor requires a style-generated box")
            if !is-style-shadow
        ?! Panic("style-target anchor requires a style content slot")
            if !slot
        style-target-anchor-bounds(parent, slot)

        .. slot = markup-style-slot(this)
    ??
        parent.content-bounds

────────────────────
+ do style-target-anchor-bounds
    - parent Box
    - slot U32

if slot == MarkupStyleSlot.after
    . cursor = %previous-sibling
    while cursor && cursor.is-style-shadow
        cursor = cursor.%previous-sibling
    ?! Panic("style-target after anchor requires a previous target sibling")
        if !cursor
    = cursor.bounds

if slot == MarkupStyleSlot.before
    . cursor = %next-sibling
    while cursor && cursor.is-style-shadow
        cursor = cursor.%next-sibling
    ?! Panic("style-target before anchor requires a next target sibling")
        if !cursor
    = cursor.bounds

= parent.bounds

