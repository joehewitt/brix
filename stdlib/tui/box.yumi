if !%first-child
    active-first-child = null
    active-list-child-list-generation = child-list-generation
    $is-active-list-invalid = false
    =
if active-list-child-list-generation == child-list-generation
    =? if !$is-active-list-invalid && !has-shadow-active-list-invalid()

active-first-child = null

. active-tail Box? = null
for child in structural-children
    //tui.layout.active-list.children-scanned ++
    active-tail = append-active-child(child, active-tail)

active-list-child-list-generation = child-list-generation
$is-active-list-invalid = false
//tui.layout.active-list.rebuilds ++

