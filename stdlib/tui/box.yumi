+ do emit-tui-box-children
    - offset U32 = 0
    - limit U32 = 100

. index U32 = 0
. emitted U32 = 0
for child in structural-children
    if index >= offset && emitted < limit
        //this:tui.box.child -> index, child, (type-of child).concrete-name, child.inspectable-summary()
        emitted += 1
    index += 1

//this:tui.box.child.count -> index

────────────────────
+ do emit-tui-box-tree
    - depth U32 = 1
    - offset U32 = 0
    - limit U32 = 100

emit-tui-box-node()
=? if depth == 0

. index U32 = 0
. emitted U32 = 0
for child in structural-children
    if index >= offset && emitted < limit
        //this:tui.box.child -> index, child, (type-of child).concrete-name, child.inspectable-summary()
        if depth > 1
            child.emit-tui-box-tree(depth - 1, 0, limit)
        emitted += 1
    index += 1

//this:tui.box.child.count -> index

