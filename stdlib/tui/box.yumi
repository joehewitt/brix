+ padded-size
    - size PSize

PSize
    - size.width + padding.horizontal + border.horizontal
    - size.height + padding.vertical + border.vertical

.. padding = padding-edges
.. border = border-edges

────────────────────
+ outer-size
    - size PSize

PSize(size.width + margin.horizontal, size.height + margin.vertical)

.. margin = margin-edges

