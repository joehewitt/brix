────────────────────
+ do invalidate-paint

. paint-root = root
. already-scheduled = paint-root.$is-paint-invalid
$is-paint-invalid = true
paint-root.$is-paint-invalid = true
if !already-scheduled
    paint-root.schedule-paint()

────────────────────
+ do set-paint-scheduler
