|? boundary
    boundary as Pointer
??
    null

────────────────────
_ do begin-pointer-route
    - event MouseEvent
    - point Point

= event.begin-route(box-event-route-next, root-pointer, point, route-offset, route-boundary)

.. root-pointer = root as Pointer
.. route-offset = live-offset()
.. route-boundary = boundary-pointer()

