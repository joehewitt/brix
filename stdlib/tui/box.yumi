+ markup-attachment-cache MarkupAttachment?
+ x Coord
+ y Coord
+ width Coord
+ height Coord
+ scroll-x Coord
+ scroll-y Coord
+ inner-width Coord
+ inner-height Coord
+ bounds Rect
+ viewport-bounds Rect?
+ paint-scheduler Doer?
+ input-host InputHost?
+ input-generation U64
+ is-hovered = false
+ is-pressed = false
+ is-focused = false
+ is-enabled = true
+ is-effectively-enabled = true
+ intrinsic-size => measure().border-size
+ outer-intrinsic-size => measure().outer-size
+ measured-outer-size => measure().outer-size
+ event key-press KeyPressEvent
+ event key-input KeyInputEvent
+ event paste PasteEvent
+ event mouse-down MouseDownEvent
+ event mouse-up MouseUpEvent
+ event mouse-move MouseMoveEvent
+ event mouse-drag MouseDragEvent
+ event scrolled ScrollEvent
+ event click ClickEvent
+ is-markup-shadow => markup-is-transparent-region
+ is-style-shadow => markup-is-style-shadow(this)
+ is-modal-root => false
+ has-horizontal-overflow => inner-width > content-bounds.width
+ has-vertical-overflow => inner-height > content-bounds.height
+ has-overflow => has-horizontal-overflow || has-vertical-overflow
+ cursor-point => Point(0, 0)
+ can-focus => focus-mode-can-focus($focus-mode) && is-interactive-visible && is-effectively-enabled
+ shows-terminal-cursor => $focus-mode == FocusMode.input

