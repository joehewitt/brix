+ do box-event-route-next Pointer?
    - raw-event Pointer
    - raw-current Pointer

. event = gc-object-from-pointer'BoxEvent(raw-event)
=? if event.route-root == raw-current
if event.route-boundary == raw-current
    event.advance-route(Point(0, 0))
    = event.route-root
. current = gc-object-from-pointer'Box(raw-current)
. parent = current.%parent
=? if !parent
. offset = Point(event.route-offset.x - parent.scroll-x, event.route-offset.y - parent.scroll-y)
event.advance-route(offset)
= parent as Pointer

