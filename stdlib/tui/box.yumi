_ FocusCandidateSearch

+ current Box?
+ going-backward = false
+ first Box?
+ last Box?
+ before-current Box?
+ after-current Box?
+ is-current-found = false

────────────────────
+ This
    - current
    - going-backward

────────────────────
+ do add
    - candidate Box

if !first
    first = candidate

last = candidate

if current
    . live-current = current
    if candidate.uid == live-current.uid
        is-current-found = true
        =
if is-current-found
    if !after-current
        after-current = candidate
else
    before-current = candidate

────────────────────
+ do result

=? if !first

if !current || !is-current-found
    if going-backward
        = last
    = first

if going-backward
    = before-current ?? last

= after-current ?? first
