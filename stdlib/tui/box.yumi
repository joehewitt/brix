=? false if !is-current()

. saved = event.begin-route(box-event-route-next, root-pointer, point, offset, route-boundary)
do finally event.end-route(saved)
target.click <- event
= event.is-canceled

.. root-pointer = root as Pointer
.. point = event.root-point
.. offset = live-offset()
.. route-boundary = boundary-pointer()

────────────────────
_ do live-offset Point

. current Box? = target
. current-offset = Point(0, 0)
. offset-root = boundary ?? root
while current
    if current as Pointer == offset-root as Pointer
        = current-offset
    . parent = current.%parent
    if !parent
        = offset
    current-offset =
        Point(current-offset.x + parent.scroll-x, current-offset.y + parent.scroll-y)
    current = parent
= offset

