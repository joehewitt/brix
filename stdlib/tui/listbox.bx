(import ./box)
(import ./colors)
(import ./events)
(import ./layout)
(import ./primitives)
(import ./shortcuts)
(import ./styles)
(import ./text)
(import ./theme)
(import /core/list-cursor)
(import /math)
(import /stream/aggregate)
(import /stream/combine)
(import /ui/input)
(import /ui/key-combo)

(style-extend TUIDefaultTheme
  (using BoxPaint)
  (using TextPaint)
  (rule ListBox
    (= background-color (call AnsiColor 0))
  )
  (blank)
  (rule ListItem
    (= background-color (call AnsiColor 0))
    (= color (call AnsiColor 7))
    (blank)
    (when-style #is-selected
      (= color (call AnsiColor 255))
      (= background-color (call AnsiColor 4))
    )
  )
)

(type + ListBox (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + selected-row (? ListItem))
  (event + selected SelectEvent)
  (event + activated ActivateEvent)
  (event + interacted Bool)
  (content
    (<> This (• flex-col)
      (<> Shortcut (text: "Previous")
        (= key .arrow-up)
        (= action (=> () :do (call interact-select-relative (. Direction up))))
      )
      (blank)
      (<> Shortcut (text: "Next")
        (= key .arrow-down)
        (= action (=> () :do (call interact-select-relative (. Direction down))))
      )
      (blank)
      (<> Shortcut (text: "Page Up")
        (= key (call KeyCombo (. Key page-up)))
        (= show-in-status false)
        (= action (=> () :do (call interact-select-page (. Direction up))))
      )
      (blank)
      (<> Shortcut (text: "Page Down")
        (= key (call KeyCombo (. Key page-down)))
        (= show-in-status false)
        (= action (=> () :do (call interact-select-page (. Direction down))))
      )
      (blank)
      (<> Shortcut (text: "First")
        (= key (call KeyCombo (. Key home)))
        (= show-in-status false)
        (= action (=> () :do (call interact-select-first-row)))
      )
      (blank)
      (<> Shortcut (text: "Last")
        (= key (call KeyCombo (. Key end)))
        (= show-in-status false)
        (= action (=> () :do (call interact-select-last-row)))
      )
      (blank)
      (<> Shortcut (text: "Activate")
        (= key .enter)
        (= action (=> () :do (call interact-activate-selection)))
      )
    )
  )
  (subscribe-for (on event mouse-up)
    (let row (call row-at (. event point)))
    (if row
      (call (. this select-row) row)
      (<- interacted true)
    )
  )
  (whenever-rule (trigger children ListItem)
    (let row selected-row)
    (if (and row (not (call valid-row row)))
      (= (. row is-selected) false)
      (= selected-row null)
    )
  )
  (fn-do + can-scroll Bool
    (param direction Direction)
    (return-if (if (== direction (. Direction left))))
    (return-if (if (== direction (. Direction right))))
    (blank)
    (let next (call scroll-point 1 direction))
    (return (or (!= (. next x) scroll-x) (!= (. next y) scroll-y)))
  )
  (fn-do + reveal-focus _
    (let row (call valid-row selected-row))
    (if row
      (call (. row reveal-in-ancestors) (. row bounds))
      (else
        (call (. super reveal-focus))
      )
    )
  )
  (fn-expr + previous-row _ :get
    (case? (not selected-row)
      last-row
    )
    (case? (and index (> index 0))
      (call row-at-index (- index 1))
    )
    (default
      null
    )
    (where
      (lazy index selected-index)
    )
  )
  (fn-expr + next-row _ :get
    (case? (not selected-row)
      first-row
    )
    (case? index
      (call row-at-index (+ index 1))
    )
    (default
      null
    )
    (where
      (lazy index selected-index)
    )
  )
  (fn-expr + first-row _ :get
    (|> (call selectable-rows) first)
  )
  (fn-expr + last-row _ :get
    (|> (call selectable-rows) last)
  )
  (fn-expr + selected-index (? Index) :get
    (spread (call selectable-rows))
    (pipe |> indexed)
    (pipe ?*> (only-if ([] each 0) (if (== ([] each 1) selected-row))))
    (pipe |> first)
  )
  (fn-expr + selectable-row-count Index :get
    (|> (call selectable-rows) count)
  )
  (fn-expr + page-row-step Int :get
    (call max 1 (as (. content-bounds height) Int))
  )
  (fn-do _ interact-select-relative _
    (param direction Direction)
    (call select-relative direction)
    (<- interacted true)
  )
  (fn-do _ interact-select-page _
    (param direction Direction)
    (call select-page direction)
    (<- interacted true)
  )
  (fn-do _ interact-select-first-row _
    (call select-first-row)
    (<- interacted true)
  )
  (fn-do _ interact-select-last-row _
    (call select-last-row)
    (<- interacted true)
  )
  (fn-do _ interact-activate-selection _
    (call activate-selection)
    (<- interacted true)
  )
  (fn-do + select-relative _
    (param direction Direction)
    (let next (call relative-row direction))
    (if next
      (call (. this select-row) next)
      (else
        (call ensure-selection-visible)
      )
    )
  )
  (fn-do + select-page _
    (param direction Direction)
    (let step page-row-step)
    (let offset (if-expr (== direction (. Direction up)) (- step) step))
    (let target (call (. (call ListCursor selectable-row-count selected-index) clamped) offset))
    (call (. this select-row) (only-if (call row-at-index target) (if (!= target null))))
  )
  (fn-do + select-first-row _
    (call (. this select-row) first-row)
  )
  (fn-do + select-last-row _
    (call (. this select-row) last-row)
  )
  (fn-do + select-row _ (?! Error)
    (param row (? ListItem))
    (let live-row (call valid-row row))
    (if (== selected-row live-row)
      (if live-row
        (call ensure-row-visible live-row)
      )
      (else
        (let old selected-row)
        (if old
          (= (. old is-selected) false)
        )
        (blank)
        (= selected-row live-row)
        (if live-row
          (= (. live-row is-selected) true)
          (call ensure-row-visible live-row)
        )
        (blank)
        (<- selected (call SelectEvent))
      )
    )
  )
  (fn-do + activate-selection _ (?! Error)
    (call ensure-selection)
    (blank)
    (<- activated (call ActivateEvent))
  )
  (fn-do + ensure-selection _
    (let row (call valid-row selected-row))
    (if row
      (if (not (. row is-selected))
        (= (. row is-selected) true)
      )
      (call ensure-row-visible row)
      (return)
    )
  )
  (fn-do + ensure-selection-visible _
    (let row (call valid-row selected-row))
    (if row
      (call ensure-row-visible row)
    )
  )
  (fn-expr + relative-row _
    (param direction Direction)
    (match direction
      (case= (. Direction up)
        previous-row
      )
      (default
        next-row
      )
    )
  )
  (fn-expr + row-at-index _
    (param target Index)
    (spread (call selectable-rows))
    (pipe |> indexed)
    (pipe ?*> (only-if ([] each 1) (if (== ([] each 0) target))))
    (pipe |> first)
  )
  (fn-do + row-at _
    (param point Point)
    (return-if (if (not (call (. content-bounds contains) point))))
    (blank)
    (let row (of (. (call hit-test point) ancestor-or-self) ListItem))
    (if row
      (return (call valid-row row))
    )
  )
  (fn-expr + selectable-rows _ @inline
    (spread active-children)
    (pipe ?*> (call selectable-row each))
  )
  (fn-do + selectable-row (? ListItem) @inline
    (param node Box)
    (if (and (is node ListItem) (. node is-effectively-enabled) (== (. node $display) .visible))
      (return (as node ListItem))
    )
  )
  (fn-do + valid-row _
    (param row (? ListItem))
    (return-if (call selectable-row row) (if (and row (== (of (. row ancestor) ListBox) this))))
  )
  (fn-do + ensure-row-visible _
    (param row ListItem)
    (let visible content-bounds)
    (if (<= (. visible height) 0)
      (if (!= scroll-y 0)
        (call scroll (tuple scroll-x 0))
      )
      (return)
    )
    (let next scroll-y)
    (if (< (+ (. row bounds y) next) (. visible y))
      (= next (- (. visible y) (. row bounds y)))
      (else-if (> (+ (. row bounds bottom) next) (. visible bottom))
        (= next (- (. visible bottom) (. row bounds bottom)))
      )
    )
    (blank)
    (= next (call clipped-scroll-y next))
    (if (!= next scroll-y)
      (call scroll (tuple scroll-x next))
    )
  )
)

(type + ListItem (is Label)
  (prop + is-selected _ (= false))
  (prop + has-children _ (= false))
)
