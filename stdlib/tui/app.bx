(import ./window)
(import /core/markup)
(import /stream/aggregate)

(type + App (is MarkupNode)
  (prop + is-quitting _ (= false))
  (prop + windows (list Window))
  (prop _ has-run _ (= false))
  (prop _ ending (? (of Completion Bool)))
  (fn-do + This _
    (call when-main-ends autorun)
  )
  (fn-do + markup-absorb _
    (param window Window)
    (+= this window)
  )
  (fn-do + (infix this += (param window Window)) _
    (= (. window app) this)
    (+= windows window)
    (if has-run
      (call (. window open))
    )
    (return window)
  )
  (fn-do + window-closed _
    (param window Window)
    (-= windows window)
    (let waiting ending)
    (return-if (if (or (not waiting) (. waiting is-finished))))
    (return-if (if (call some windows (:where (not (. each is-closed))))))
    (blank)
    (call (. waiting finish) true)
  )
  (fn-do + run _
    (= has-run true)
    (let waiting (call (of Completion Bool)))
    (= ending waiting)
    (for (in window windows)
      (call (. window open))
    )
    (if (call some windows (:where (not (. each is-closed))))
      (call (. waiting await))
    )
    (= ending null)
    (call close)
    (call (. (call Task) when-finished) end-process)
  )
  (fn-do _ autorun _
    (return-if (if has-run))
    (blank)
    (call run)
  )
  (fn-do _ window-snapshot (list Window)
    (let snapshot (list Window))
    (++= snapshot windows)
    (return snapshot)
  )
  (fn-do _ end-process _
    (call request-process-termination 0)
  )
  (fn-do + quit _
    (= is-quitting true)
    (for (in window (call window-snapshot))
      (call (. window close)
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
    )
  )
  (fn-do + close _
    (for (in window (call window-snapshot))
      (call (. window close)
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
    )
    (call (. super close))
  )
)
