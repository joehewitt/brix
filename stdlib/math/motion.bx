(import ./easing)
(import ./math)
(import /time/duration)
(import /units)
(blank)
(prop _ motion-rest-pace _ (= 40.0))
(blank)
(prop + instant _ (= (call InstantMotion)))

(type + MotionSample (is Tuple)
  (prop + offset F64)
  (prop + speed F64)
  (prop + is-done Bool)
)

(type + Motion
  (fn-expr + is-additive Bool :get
    false
  )
  (fn-expr + sample MotionSample
    (param offset F64)
    (param speed F64)
    (param elapsed Duration)
    (param precision F64)
    (call MotionSample 0 0 true)
  )
  (fn-expr + rest F64
    (param offset F64)
    (param speed F64)
    0
  )
)

(fn-expr + spring SpringMotion
  (param duration Duration)
  (param bounce F64 (= 0))
  (call SpringMotion duration bounce)
)

(fn-expr + curve CurveMotion
  (param duration Duration)
  (param easing Easing)
  (call CurveMotion duration easing)
)

(fn-expr + linear CurveMotion
  (param duration Duration)
  (call CurveMotion duration (. Easing linear))
)

(fn-expr + ease CurveMotion
  (param duration Duration)
  (call CurveMotion duration (. Easing ease))
)

(fn-expr + ease-in CurveMotion
  (param duration Duration)
  (call CurveMotion duration (. Easing ease-in))
)

(fn-expr + ease-out CurveMotion
  (param duration Duration)
  (call CurveMotion duration (. Easing ease-out))
)

(fn-expr + ease-in-out CurveMotion
  (param duration Duration)
  (call CurveMotion duration (. Easing ease-in-out))
)

(fn-expr + cubic-bezier CurveMotion
  (param duration Duration)
  (param x1 F64)
  (param y1 F64)
  (param x2 F64)
  (param y2 F64)
  (call CurveMotion duration (call (. Easing cubic-bezier) (call CubicBezier x1 y1 x2 y2)))
)

(fn-expr + steps CurveMotion
  (param duration Duration)
  (param count Int)
  (call CurveMotion duration (call (. Easing steps) count))
)

(fn-expr + decay DecayMotion
  (param rate F64 (= 0.998))
  (call DecayMotion rate)
)

(fn-expr + follow FollowMotion
  (param rate F64)
  (call FollowMotion rate)
)

(fn-expr + keyframes KeyframeMotion
  (param duration Duration)
  (param stops (list MotionStop))
  (param settle (? SpringMotion) (= null))
  (call KeyframeMotion duration stops settle)
)

(fn-expr + motion KeyframeMotion
  (param duration Duration)
  (call KeyframeMotion duration (call (of List MotionStop)) null)
)

(type + SpringMotion (is Motion)
  (prop + duration Duration)
  (prop + bounce F64)
  (blank)
  (prop _ frequency _ (= 0.0))
  (prop _ damping _ (= 1.0))
  (fn-do + This _
    (param duration _)
    (param bounce _)
    (let seconds (as (as duration Seconds) F64))
    (= frequency (if-expr (> seconds 0) (/ (* 2 (as π F64)) seconds) 0.0))
    (= damping (if-expr (>= bounce 0) (- 1 bounce) (/ 1 (+ 1 (call max bounce -0.99)))))
  )
  (fn-do + sample _
    (param offset F64)
    (param speed F64)
    (param elapsed Duration)
    (param precision F64)
    (return-if (call MotionSample 0 0 true) (if (<= frequency 0)))
    (blank)
    (let t (as (as elapsed Seconds) F64))
    (let place 0.0)
    (let pace 0.0)
    (if (< damping 0.999999)
      (let fading (* damping frequency))
      (let ringing (* frequency (call sqrt (- 1 (* damping damping)))))
      (let fade (call exp (* (- fading) t)))
      (let turn (call cos (* ringing t)))
      (let swing (call sin (* ringing t)))
      (= place (* fade (+ (* offset turn) (* (/ (+ speed (* fading offset)) ringing) swing))))
      (= pace
        (scope (* fade (- (* speed turn) (* (/ (+ (* frequency frequency offset) drag) ringing) swing)))
          (lazy drag (* fading speed))
        )
      )
      (else-if (<= damping 1.000001)
        (let fade (call exp (* (- frequency) t)))
        (let lead (+ speed (* frequency offset)))
        (= place (* (+ offset (* lead t)) fade))
        (= pace (* (- speed (* frequency lead t)) fade))
      )
      (else
        (let spread (* frequency (call sqrt (- (* damping damping) 1))))
        (let fast (- (* (- damping) frequency) spread))
        (let slow (+ (* (- damping) frequency) spread))
        (let second (/ (- speed (* slow offset)) (- fast slow)))
        (let first (- offset second))
        (= place (+ (* first (call exp (* slow t))) (* second (call exp (* fast t)))))
        (= pace (+ (* first slow (call exp (* slow t))) (* second fast (call exp (* fast t)))))
      )
    )
    (return-if (call MotionSample 0 0 true) (if (and (< (call abs place) precision) (< (call abs pace) (* precision motion-rest-pace)))))
    (return (call MotionSample place pace false))
  )
)

(type + CurveMotion (is Motion)
  (prop + duration Duration)
  (prop + easing Easing)
  (fn-do + This _
    (param duration _)
    (param easing _)
  )
  (fn-expr + is-additive _ :get
    true
  )
  (fn-expr + sample _
    (param offset F64)
    (param speed F64)
    (param elapsed Duration)
    (param precision F64)
    (case? (or (<= span 0) (>= t span))
      (call MotionSample 0 0 true)
    )
    (default
      (call MotionSample
        (block
          (arg (* offset (- 1 (call (. easing eased) progress))))
          (arg (/ (* (- offset) (call (. easing slope) progress)) span))
          (arg false)
        )
      )
    )
    (where
      (lazy span (as (as duration Seconds) F64))
      (lazy t (as (as elapsed Seconds) F64))
      (lazy progress (/ t span))
    )
  )
)

(type + DecayMotion (is Motion)
  (prop + rate F64)
  (blank)
  (prop _ fade _ (= 0.0))
  (fn-do + This _
    (param rate _)
    (= fade (if-expr (and (> rate 0) (< rate 1)) (* -1000 (call log rate)) 0.0))
  )
  (fn-expr + sample _
    (param offset F64)
    (param speed F64)
    (param elapsed Duration)
    (param precision F64)
    (case? (or (<= fade 0) (< (call abs (- place resting)) precision))
      (call MotionSample resting 0 true)
    )
    (default
      (call MotionSample place (* speed remaining) false)
    )
    (where
      (lazy resting (call rest offset speed))
      (lazy t (as (as elapsed Seconds) F64))
      (lazy remaining (call exp (* (- fade) t)))
      (lazy place (- resting (* (/ speed fade) remaining)))
    )
  )
  (fn-expr + rest _
    (param offset F64)
    (param speed F64)
    (if-expr (> fade 0) (+ offset (/ speed fade)) offset)
  )
)

(type + FollowMotion (is Motion)
  (prop + rate F64)
  (fn-do + This _
    (param rate _)
  )
  (fn-expr + sample _
    (param offset F64)
    (param speed F64)
    (param elapsed Duration)
    (param precision F64)
    (case? (or (<= rate 0) (< (call abs place) precision))
      (call MotionSample 0 0 true)
    )
    (default
      (call MotionSample place (* (- rate) place) false)
    )
    (where
      (lazy place (* offset (call exp (* (- rate) (as (as elapsed Seconds) F64)))))
    )
  )
)

(type + InstantMotion (is Motion))

(type + MotionStop (is Tuple)
  (prop + at F64)
  (prop + progress F64)
  (prop + easing _ (= (. Easing linear)))
)

(type + KeyframePlace (is Tuple)
  (prop + segment Index)
  (prop + fraction F64)
  (prop + slope F64)
)

(fn-do + (of keyframe-place Stop) KeyframePlace
  (param stops (list Stop))
  (param at F64)
  (return-if (call KeyframePlace 0 0 0) (if (or (== (. stops length) 0) (<= at (. ([] stops 0) at)))))
  (blank)
  (let last (- (. stops length) 1))
  (return-if (call KeyframePlace last 1 0) (if (>= at (. ([] stops last) at))))
  (blank)
  (let segment 1)
  (while (and (< segment last) (>= at (. ([] stops segment) at)))
    (+= segment 1)
  )
  (let start (. ([] stops (- segment 1)) at))
  (let span (- (. ([] stops segment) at) start))
  (return-if (call KeyframePlace segment 1 0) (if (<= span 0)))
  (blank)
  (let local (/ (- at start) span))
  (let easing (. ([] stops segment) easing))
  (return (call KeyframePlace segment (call (. easing eased) local) (/ (call (. easing slope) local) span)))
)

(type + KeyframeMotion (is Motion)
  (prop + duration Duration)
  (prop + stops (list MotionStop))
  (prop + settle (? SpringMotion))
  (fn-do + This _
    (param duration _)
    (param stops _)
    (param settle _)
  )
  (fn-do + at This
    (param at Ratio)
    (param progress F64)
    (param easing Easing (= (. Easing linear)))
    (param motion (? SpringMotion) (= null))
    (throw (call Panic "Only the last stop of a keyframe motion ends on a spring") (if settle))
    (blank)
    (+= stops (call MotionStop at progress easing))
    (if motion
      (= settle motion)
    )
    (return this)
  )
  (fn-expr + progress (tuple F64 F64)
    (param elapsed Duration)
    (case? (or (<= span 0) (== (. stops length) 0))
      (tuple 1 0)
    )
    (case? (== (. place segment) 0)
      (tuple (. ([] stops 0) progress) 0)
    )
    (default
      (tuple (+ from (* (- to from) (. place fraction))) (/ (* (- to from) (. place slope)) span))
    )
    (where
      (lazy span (as (as duration Seconds) F64))
      (lazy place (call keyframe-place stops (/ (as (as elapsed Seconds) F64) span)))
      (lazy from (. ([] stops (- (. place segment) 1)) progress))
      (lazy to (. ([] stops (. place segment)) progress))
    )
  )
  (fn-expr _ settling (? MotionSample)
    (param elapsed Duration)
    (param precision F64)
    (case? (or (not spring) (< (. stops length) 2))
      null
    )
    (case? (< t begins)
      null
    )
    (default
      (call MotionSample (+ (. ([] stops last) progress) (. sample offset)) (. sample speed) (. sample is-done))
    )
    (where
      (lazy spring settle)
      (lazy last (- (. stops length) 1))
      (lazy span (as (as duration Seconds) F64))
      (lazy begins (* (. ([] stops (- last 1)) at) span))
      (lazy t (as (as elapsed Seconds) F64))
      (lazy arrival (call progress (as (call max (- begins 0.000001) 0.0) Seconds)))
      (lazy offset (- (. ([] stops (- last 1)) progress) (. ([] stops last) progress)))
      (lazy pace (if-expr (>= last 2) ([] arrival 1) 0.0))
      (lazy sample (call (. spring sample) offset pace (as (- t begins) Seconds) precision))
    )
  )
  (fn-expr + is-additive _ :get
    true
  )
  (fn-do + sample _
    (param offset F64)
    (param speed F64)
    (param elapsed Duration)
    (param precision F64)
    (return-if (call MotionSample 0 0 true) (if (== offset 0)))
    (blank)
    (let tolerance (/ precision (call abs offset)))
    (let settled (call settling elapsed tolerance))
    (if settled
      (return-if (call MotionSample 0 0 true) (if (. settled is-done)))
      (return (call MotionSample (* offset (- 1 (. settled offset))) (* (- offset) (. settled speed)) false))
    )
    (let span (as (as duration Seconds) F64))
    (return-if (call MotionSample 0 0 true) (if (>= (as (as elapsed Seconds) F64) span)))
    (blank)
    (let shape (call progress elapsed))
    (return (call MotionSample (* offset (- 1 ([] shape 0))) (* (- offset) ([] shape 1)) false))
  )
)

(type + MotionChannel
  (prop + value (list F64))
  (prop + speed (list F64))
  (prop + target (list F64))
  (prop + precision F64)
  (blank)
  (prop _ runs _ (= (call (of List MotionRun))))
  (fn-do + This _
    (param start (list F64))
    (param precision F64 (= 0.01))
    (lazy value (call (of List F64) start))
    (lazy target (call (of List F64) start))
    (lazy speed (call (of List F64) (in 0.0 start)))
  )
  (fn-expr + is-moving Bool :get
    (> (. runs length) 0)
  )
  (fn-do + update _
    (param now Duration)
    (return-if (if (== (. runs length) 0)))
    (blank)
    (for (in index (..< 0 (. value length)))
      (= ([] value index) ([] target index))
      (= ([] speed index) 0)
    )
    (let kept Size 0)
    (for (in at (..< 0 (. runs length)))
      (let run ([] runs at))
      (let elapsed (if-expr (> now (. run start)) (- now (. run start)) 0ns))
      (let is-done true)
      (for (in index (..< 0 (. value length)))
        (let sample (call (. run motion sample) ([] (. run offset) index) ([] (. run speed) index) elapsed precision))
        (+= ([] value index) (. sample offset))
        (+= ([] speed index) (. sample speed))
        (if (not (. sample is-done))
          (= is-done false)
        )
      )
      (if (not is-done)
        (= ([] runs kept) run)
        (+= kept 1)
      )
    )
    (call (. runs remove) kept (- (. runs length) kept))
  )
  (fn-do + retarget _
    (param to (list F64))
    (param motion Motion)
    (param now Duration)
    (call update now)
    (let offset (call (of List F64)))
    (let pace (call (of List F64)))
    (let is-still true)
    (if (. motion is-additive)
      (for (in index (..< 0 (. value length)))
        (+= offset (- ([] target index) ([] to index)))
        (+= pace 0)
        (= ([] target index) ([] to index))
        (if (!= ([] offset index) 0)
          (= is-still false)
        )
      )
      (else
        (= runs (call (of List MotionRun)))
        (for (in index (..< 0 (. value length)))
          (let resting (+ ([] to index) (call (. motion rest) (- ([] value index) ([] to index)) ([] speed index))))
          (+= offset (- ([] value index) resting))
          (+= pace ([] speed index))
          (= ([] target index) resting)
          (if (or (!= ([] offset index) 0) (!= ([] pace index) 0))
            (= is-still false)
          )
        )
      )
    )
    (return-if (if is-still))
    (blank)
    (+= runs (call MotionRun motion now offset pace))
  )
  (fn-do + jump _
    (param to (list F64))
    (param pace (? (list F64)) (= null))
    (= runs (call (of List MotionRun)))
    (for (in index (..< 0 (. value length)))
      (= ([] value index) ([] to index))
      (= ([] target index) ([] to index))
      (= ([] speed index) (if-expr pace ([] pace index) 0.0))
    )
  )
  (fn-do + stop _
    (param now Duration)
    (call update now)
    (call jump value)
  )
)

(type _ MotionRun (is Tuple)
  (prop + motion Motion)
  (prop + start Duration)
  (prop + offset (list F64))
  (prop + speed (list F64))
)
