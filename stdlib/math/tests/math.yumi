
/BxCore/BxCore.h
/math
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ tests TestRender

════════════════════
test("Min Max")

"first>second>1",  min-trace()
"first>second>2",  max-trace()

════════════════════
test("F64 Intrinsic Semantics")

-C:getInfinity(),  1.0 / sqrt(-0.0)
C:getInfinity(),   1.0 / abs(-0.0)

-C:getInfinity(),  1.0 / min(-0.0, 0.0)
C:getInfinity(),   1.0 / min(0.0, -0.0)
-C:getInfinity(),  1.0 / max(-0.0, 0.0)
C:getInfinity(),   1.0 / max(0.0, -0.0)

true,              min(nan(), 42.0) != min(nan(), 42.0)
42.0,              min(42.0, nan())
true,              max(nan(), 42.0) != max(nan(), 42.0)
42.0,              max(42.0, nan())

════════════════════
test("Power Of Two")

0u8,    power-of-2(0u8)
1u8,    power-of-2(1u8)
4u8,    power-of-2(3u8)
4u8,    power-of-2(4u8)
128u8,  power-of-2(128u8)
0u8,    power-of-2(129u8)

9223372036854775808u64, power-of-2(9223372036854775808)
0u64,                   power-of-2(9223372036854775809)

━━━━━━━━━━━━━━━━━━━━
_ nan

C:getInfinity() - C:getInfinity()

━━━━━━━━━━━━━━━━━━━━
_ do min-trace String

. trace = ArgumentTrace()
. value = min(trace.first(), trace.second())
= "${trace.text}$value"

━━━━━━━━━━━━━━━━━━━━
_ do max-trace String

. trace = ArgumentTrace()
. value = max(trace.first(), trace.second())
= "${trace.text}$value"

━━━━━━━━━━━━━━━━━━━━
_ ArgumentTrace

+ text := ""

────────────────────
+ do first F64

text += "first>"
= 1.0

────────────────────
+ do second F64

text += "second>"
= 2.0
