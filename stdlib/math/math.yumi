+ π = 3.14159265358979323846264338327rad
+ euler = 2.7182818284590451
+ epsilon = 0.000000000001

_ random-state U64 = random-seed()
_ random-increment U64 = 0x9e3779b97f4a7c15
_ random-first-multiplier U64 = 0xbf58476d1ce4e5b9
_ random-second-multiplier U64 = 0x94d049bb133111eb

