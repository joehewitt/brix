━━━━━━━━━━━━━━━━━━━━
_ do random-seed U64

. seed = U64[1]
C:getentropy(seed, 8)
= seed[0]

━━━━━━━━━━━━━━━━━━━━
_ do next-random U64

random-state += random-increment
= random-mix(random-state)

━━━━━━━━━━━━━━━━━━━━
_ random-mix U64
    - state U64

second /xor/ (second /zrshift/ 31)

.. first = (state /xor/ (state /zrshift/ 30)) * random-first-multiplier
.. second = (first /xor/ (first /zrshift/ 27)) * random-second-multiplier

━━━━━━━━━━━━━━━━━━━━
_ random-fraction F64
    - bits U64

((bits /zrshift/ 11) as F64) / 9007199254740992.0

━━━━━━━━━━━━━━━━━━━━
_ do random-between'Num Num
    - bits U64
    - min Num
    - max Num

if Num.is-integer
    . width = ((max as I64) - (min as I64)) as U64
    = ((min as I64) + ((bits % width) as I64)) as Num
. value = (min + random-fraction(bits) * (max - min)) as Num
= if value != max then value else min

━━━━━━━━━━━━━━━━━━━━
+ do random F64

= random-fraction(next-random())

━━━━━━━━━━━━━━━━━━━━
+ do random'Num Num
    - min Num
    - max Num

= random-between(next-random(), min, max)

━━━━━━━━━━━━━━━━━━━━
+ Random

+ seed U64
_ state U64

────────────────────
+ This

seed = random-seed()
state = seed

────────────────────
+ This
    - seed U64

state = seed

────────────────────
+ do random F64

= random-fraction(draw())

────────────────────
+ do random'Num Num
    - min Num
    - max Num

= random-between(draw(), min, max)

────────────────────
+ do split Random

= Random(draw())

────────────────────
_ do draw U64

state += random-increment
= random-mix(state)

━━━━━━━━━━━━━━━━━━━━
+ not'Num
    - n Num

Num.max - n

━━━━━━━━━━━━━━━━━━━━
+ min F64
    - n1 F64
    - n2 F64

━━━━━━━━━━━━━━━━━━━━
+ min'Num
    - n1 Num
    - n2 Num

|? n2 < n1
    n2
??
    n1

━━━━━━━━━━━━━━━━━━━━
+ max F64
    - n1 F64
    - n2 F64

━━━━━━━━━━━━━━━━━━━━
+ max'Num
    - n1 Num
    - n2 Num

|? n2 > n1
    n2
??
    n1

━━━━━━━━━━━━━━━━━━━━
+ clamp'Num
    - value Num
    - low Num
    - high Num

|? value < low
    low
|? value > high
    high
??
    value

━━━━━━━━━━━━━━━━━━━━
+ clamp-unit F64
    - value F64

if !is-finite(value) then 0 else clamp(value, 0, 1)

━━━━━━━━━━━━━━━━━━━━
+ is-even'Num
    - n Num

n % 2 == 0

━━━━━━━━━━━━━━━━━━━━
+ is-odd'Num
    - n Num

n % 2 != 0

━━━━━━━━━━━━━━━━━━━━
+ num
    - numerator Float
    - denominator Float

numerator / denominator

━━━━━━━━━━━━━━━━━━━━
+ denom
    - denominator Float
    - numerator Float

numerator / denominator

━━━━━━━━━━━━━━━━━━━━
+ power-of-2'Num
    - n Num

if shift == bit-width then (0 as Num) else (1 as Num) /lshift/ shift

.. shift = bit-width - count-leading-zeros((n - 1) as Num)
.. bit-width = (type-of n).size * 8
