+ surface-ring-size Size = 3
+ surface-rendezvous-variable = "BRIX_SURFACE_RENDEZVOUS"
_ surface-view-rendezvous-count U64

━━━━━━━━━━━━━━━━━━━━
+ SurfaceMessageKind is U32

| surfaces = 1
| frame = 2
| release = 3
| size = 4
| pointer = 5
| starved = 6
| key = 7
| text = 8
| focus = 9
| app = 64

━━━━━━━━━━━━━━━━━━━━
+ SurfaceKeyPhase is U32

| press = 0
| release = 1

━━━━━━━━━━━━━━━━━━━━
+ SurfaceKeyRecord is Tuple

+ phase SurfaceKeyPhase
+ key U32
+ native-key-code U32
+ is-repeat U32
+ modifier-bits U64

────────────────────
+ get modifiers PointerModifiers

pointer-modifiers-from-native(modifier-bits)

━━━━━━━━━━━━━━━━━━━━
