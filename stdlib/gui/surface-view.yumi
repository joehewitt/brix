━━━━━━━━━━━━━━━━━━━━
+ SurfaceSender
    is Closable

+ channel MessageChannel
+ host MachPort
+ generation U32
+ wanted SurfaceSizeRequest?
+ frames-sent Size
+ frames-skipped Size
_ surfaces [SharedSurface]
_ held [Bool]
_ drawing Index?
_ next-frame U64 = 1

────────────────────
+ This ?! IOError
    - channel MessageChannel
    - rendezvous String

= This(channel, MachPort(rendezvous))

────────────────────
_ This
    - channel
    - host

────────────────────
+ do resize ?! IOError
    - pixel-width I32
    - pixel-height I32
    - scale F64

release-surfaces()
generation += 1
. ports [U32]
for index in 0 .. < surface-ring-size
    . surface = SharedSurface(pixel-width, pixel-height)
    surfaces += surface
    held += false
    ports += surface.make-port()
. report = SurfaceSetReport(generation, surface-ring-size as U32, pixel-width, pixel-height, scale)
?! IOError("Unable to send surfaces to the host")
    if !host.send(ports, &report, SurfaceSetReport.size)
channel.send-record(SurfaceMessageKind.surfaces, report)

────────────────────
+ do acquire SharedSurface?

for index in 0 .. < surfaces.length
    if !held[index]
        held[index] = true
        drawing = index
        = surfaces[index]
frames-skipped += 1
channel.send(SurfaceMessageKind.starved)
= null

────────────────────
+ do deliver
    - rendered U64

. slot = drawing
=? if slot == null
drawing = null
. report = SurfaceFrameReport
    - next-frame
    - generation
    - slot as U32
    - monotonic-time-nanoseconds()
    - rendered
next-frame += 1
frames-sent += 1
channel.send-record(SurfaceMessageKind.frame, report)

────────────────────
+ do abandon

. slot = drawing
=? if slot == null
held[slot] = false
drawing = null

────────────────────
+ do handle Bool
    - message Message

match message.kind as SurfaceMessageKind
    |= .release
        . released = message.record'SurfaceSlot()
        if released && released.generation == generation && released.slot < held.length
            held[released.slot] = false
        = true
    |= .size
        wanted = message.record'SurfaceSizeRequest() ?? wanted
        = true
    ??
        = false

────────────────────
_ do release-surfaces

for surface in surfaces
    surface.close()
surfaces.clear()
held.clear()
drawing = null

────────────────────
+ do close

release-surfaces()
host.close()

━━━━━━━━━━━━━━━━━━━━
_ SurfaceSet

+ generation U32
+ canvases [RasterCanvas?]

────────────────────
+ This
    - generation
    - canvases

────────────────────
+ do close

for canvas in canvases
    canvas?.close()
canvases.clear()

━━━━━━━━━━━━━━━━━━━━
_ SurfaceRetiree is Tuple

+ generation U32
+ slot U32
+ after I64

━━━━━━━━━━━━━━━━━━━━
+ SurfaceView is Box

• This
    focus-mode = FocusMode.input

+ rendezvous MachRendezvous?
+ channel MessageChannel?
+ sender I32
+ shown SurfaceFrameReport?
+ shown-at U64
+ frames-received Size
+ frames-shown Size
+ frames-unseen Size
+ event first-frame SurfaceFrameReport
_ sets [SurfaceSet]
_ pending SurfaceFrameReport?
_ retired [SurfaceRetiree]
_ requested SurfaceSizeRequest?
_ awaits-first = false

. hover-changed < is-hovered
. focus-changed < is-focused

────────────────────
+ do listen String ?! IOError

rendezvous?.close()
surface-view-rendezvous-count += 1
. opened = MachRendezvous("com.yumi.surface.${C:getpid()}.$surface-view-rendezvous-count")
rendezvous = opened
= opened.name

────────────────────
+ do connect
    - channel MessageChannel
    - sender I32

retire-session()
this.channel = channel
this.sender = sender
requested = null
awaits-first = true
request-size()
focus-changed()

────────────────────
+ do disconnect

channel = null
pending = null
retired.clear()

────────────────────
+ get shown-image RasterCanvas?

canvas-for(current.generation, current.slot) if current

.. current = shown

────────────────────
+ do handle Bool
    - message Message

match message.kind as SurfaceMessageKind
    |= .surfaces
        collect-surfaces()
        = true
    |= .frame
        . report = message.record'SurfaceFrameReport()
        if report
            receive-frame(report)
        = true
    |= .starved
        release-retired()
        = true
    ??
        = false

────────────────────
+ do request-size

. open = channel
=? if !open
. content = content-bounds
=? if content.width <= 0 || content.height <= 0
. wanted = SurfaceSizeRequest(content.width, content.height, backing-scale)
. last = requested
if last
    =? if last.width == wanted.width && last.height == wanted.height && last.scale == wanted.scale
requested = wanted
open.send-record(SurfaceMessageKind.size, wanted)

────────────────────
_ get backing-scale F64

if host then (host as Window).backing-scale else 1

.. host = window

────────────────────
_ get last-frame-id I64

if host then (host as Window).last-metal-frame-id else -1

.. host = window

────────────────────
_ get completed-frame-id I64

if host then (host as Window).completed-metal-frame-id else -1

.. host = window

────────────────────
_ do retire-session

. current = shown
. index Size = 0
while index < sets.length
    . set = sets[index]
    if current && set.generation == current.generation
        set.generation = 0
        index += 1
    else
        set.close()
        sets.remove(index)
pending = null
retired.clear()
if current
    shown = SurfaceFrameReport(current.frame, 0, current.slot, current.finished, current.rendered)

────────────────────
_ do collect-surfaces

. listening = rendezvous
=? if !listening
while true
    . parcel = listening.receive()
    =? if !parcel
    if parcel.sender != sender || parcel.bytes.size < SurfaceSetReport.size
        for right in parcel.ports
            release-mach-right(right)
    else
        install(parcel)

────────────────────
_ do install
    - parcel MachParcel

. report = (parcel.bytes.data as CPointer'SurfaceSetReport)[0]
. canvases [RasterCanvas?]
for right in parcel.ports
    . surface = shared-surface-from-port(right)
    if surface
        canvases += surface.canvas(report.scale)
        surface.close()
    else
        canvases += null
sets += SurfaceSet(report.generation, canvases)

────────────────────
_ canvas-for RasterCanvas?
    - generation U32
    - slot U32

match found
    |= null
        null
    |? slot >= it.canvases.length
        null
    ??
        it.canvases[slot]

.. found = first(each in sets when each.generation == generation)

────────────────────
_ do receive-frame
    - report SurfaceFrameReport

frames-received += 1
release-retired()
if !canvas-for(report.generation, report.slot)
    release(report.generation, report.slot)
    =
. previous = pending
if previous
    release(previous.generation, previous.slot)
    frames-unseen += 1
pending = report
invalidate-paint()

────────────────────
_ do release
    - generation U32
    - slot U32

. open = channel
=? if !open
open.send-record(SurfaceMessageKind.release, SurfaceSlot(generation, slot))

────────────────────
_ do release-retired

. completed = completed-frame-id
. index Size = 0
while index < retired.length
    . entry = retired[index]
    if entry.after <= completed
        release(entry.generation, entry.slot)
        retired.remove(index)
    else
        index += 1
prune-sets()

────────────────────
_ do prune-sets

=? if sets.length < 2
. newest = sets[sets.length - 1].generation
. index Size = 0
while index < sets.length
    . set = sets[index]
    if set.generation != newest && !is-referenced(set.generation)
        set.close()
        sets.remove(index)
    else
        index += 1

────────────────────
_ is-referenced Bool
    - generation U32

shown?.generation == generation || pending?.generation == generation || is-retired

.. is-retired = some(retired) • where each.generation == generation

────────────────────
_ do advance

. next = pending
=? if !next
pending = null
. previous = shown
if previous
    retired += SurfaceRetiree(previous.generation, previous.slot, last-frame-id)
shown = next
shown-at = monotonic-time-nanoseconds()
frames-shown += 1
canvas-for(next.generation, next.slot)?.surface-changed()
if awaits-first
    awaits-first = false
    first-frame <- next

────────────────────
for event on pointer-down

send-record(PointerRecordKind.down, event, Point(0, 0), event.button, event.click-count)

────────────────────
for event on pointer-up

send-record(PointerRecordKind.up, event, Point(0, 0), event.button)
event.cancel()

────────────────────
for event on pointer-drag

send-record(PointerRecordKind.drag, event, event.delta, event.button)
event.cancel()

────────────────────
for event on pointer-move

send-record(PointerRecordKind.move, event, event.delta)

────────────────────
for event on scroll

send-record
    - PointerRecordKind.scroll
    - event
    - event.delta
    - PointerButton.primary
    - 0
    - event.is-precise
    - event.phase
    - event.momentum-phase
event.cancel()

────────────────────
for event on magnify

send-record
    - PointerRecordKind.magnify
    - event
    - Point(event.magnification, 0)
    - PointerButton.primary
    - 0
    - false
    - event.phase
event.cancel()

────────────────────
for event on key-press

send-key
    - SurfaceKeyPhase.press
    - event.key
    - event.native-key-code
    - event.modifiers
    - event.is-repeat
    - event.characters
event.cancel()

────────────────────
for event on key-release

send-key
    - SurfaceKeyPhase.release
    - event.key
    - event.native-key-code
    - event.modifiers
    - false
    - event.characters
event.cancel()

────────────────────
for event on key-input

send-text(SurfaceTextAction.input, event.text, event.replaces-before, event.replaces-length)
event.cancel()

────────────────────
for event on text-composition

send-text(SurfaceTextAction.composition, event.text, event.selection-start, event.selection-length)
event.cancel()

────────────────────
for event on text-command

send-text(SurfaceTextAction.command, event.selector)
event.cancel()

────────────────────
_ do hover-changed

=? if is-hovered
channel?.send-record(SurfaceMessageKind.pointer, PointerRecord(PointerRecordKind.exit, Point(0, 0)))

────────────────────
_ do focus-changed

channel?.send-record
    - SurfaceMessageKind.focus
    - SurfaceFocusRecord(if is-focused then 1u32 else 0u32, 0)

────────────────────
_ do send-key
    - phase SurfaceKeyPhase
    - key Key
    - native-key-code U32
    - modifiers PointerModifiers
    - is-repeat Bool
    - characters String

. record = SurfaceKeyRecord
    - phase
    - key-to-native(key)
    - native-key-code
    - if is-repeat then 1u32 else 0u32
    - pointer-modifiers-to-native(modifiers)
channel?.send-record(SurfaceMessageKind.key, record, characters as Pointer, characters.size)

────────────────────
_ do send-text
    - action SurfaceTextAction
    - text String
    - start Size = 0
    - length Size = 0

.. record = SurfaceTextRecord(action, start as U32, length as U32, 0)
channel?.send-record(SurfaceMessageKind.text, record, text as Pointer, text.size)

────────────────────
_ do send-record
    - kind PointerRecordKind
    - event GUIEvent
    - delta Point
    - button PointerButton = PointerButton.primary
    - click-count U32 = 0
    - is-precise = false
    - phase = ScrollPhase.none
    - momentum-phase = ScrollPhase.none

. open = channel
=? if !open
. record = PointerRecord
    - kind
    - content-point(event.point)
    - delta
    - event.pointer-id
    - pointer-device-kind-to-native(event.device-kind)
    - pointer-button-to-native(button)
    - event.buttons
    - pointer-modifiers-to-native(event.modifiers)
    - event.ordering-time
    - click-count
    - is-precise
    - phase
    - momentum-phase
open.send-record(SurfaceMessageKind.pointer, record)

────────────────────
_ content-point Point
    - point Point

point - (content-bounds.top-left - bounds.top-left)

────────────────────
+ do did-layout

super.did-layout()
request-size()

────────────────────
+ do paint-self
    - canvas Canvas

advance()
release-retired()
. current = shown
=? if !current
. image = canvas-for(current.generation, current.slot)
=? if !image
canvas.draw-image(image, content-bounds)

────────────────────
+ do close

for set in sets
    set.close()
sets.clear()
rendezvous?.close()
rendezvous = null
super.close()
