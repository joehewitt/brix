(import ./frame-clock)
(import ./keyframes)
(import ./motion-scope)
(import /core/markup)
(import /core/style)
(import /math)
(import /math/motion)
(import /stream/aggregate)
(import /time/duration)
(blank)
(prop + gui-style-motion _ (:= (call GUIStyleMotion)))
(blank)
(prop _ style-motion-precision _ (= 0.001))
(prop _ style-motion-quiet-domains _ (= (list "paint" "presentation" "composite" "vector-composite")))
(blank)
(prop _ style-motion-transform-group _ (= (list "translate" "scale" "rotate" "transform")))
(prop _ style-motion-adding _ (= (list "translate" "rotate")))
(prop _ style-motion-watched _ (= (list "animation" "enter-space" "match" "timeline")))
(prop _ style-motion-scaling _ (= (list "scale" "opacity")))

(type + StyleMotionOwner (is Interface)
  (implements FrameOwner)
  (implements MarkupElement)
  (fn-expr + is-entering Bool :get
    false
  )
  (fn-expr + is-leaving Bool :get
    false
  )
  (fn-expr + is-motion-visible Bool :get
    true
  )
  (fn-expr + motion-start (? Duration) :get
    null
  )
  (fn-expr + snaps-motion Bool :get
    is-entering
  )
  (fn-do + drive-timeline Bool
    (param run KeyframeRun)
    (return false)
  )
)

(type + StyleMotionRange (is (tuple (: minimum (? F64)) (: maximum (? F64)))))

(type _ StyleMotionKeys (is (tuple (: key (? Size)) (: group (? Size)) (: bare (? Size)))))

(type + StyleLayerMode (is Union)
  (variant replacing)
  (variant adding)
  (variant scaling)
)

(type + GUIStyleMotion
  (prop _ runs _ (= (call (of List StyleMotionRun))))
  (prop _ plays _ (= (call (of List KeyframeRun))))
  (prop _ held _ (= (call (of List KeyframeRun))))
  (prop _ quiet-mask U32)
  (prop _ quiet-count Size (= 0))
  (prop _ ranges _ (= (call (of Map String StyleMotionRange))))
  (prop _ keys _ (= (call (of Map U64 StyleMotionKeys))))
  (prop _ layout-slots _ (= (call (of Map String Size))))
  (prop _ motion-info (? StyleInfo))
  (fn-do + This _
    (= ([] ranges "opacity") (call StyleMotionRange 0 1))
    (= ([] ranges "scale") (call StyleMotionRange 0 null))
    (= ([] ranges "corner-radius") (call StyleMotionRange 0 null))
    (= ([] ranges "backdrop-blur") (call StyleMotionRange 0 null))
    (= ([] ranges "border-width") (call StyleMotionRange 0 null))
  )
  (fn-expr + running-count Size :get
    (. runs length)
  )
  (fn-expr + playing-count Size :get
    (. plays length)
  )
  (fn-do + watch-mounts _
    (let found (call motion-style))
    (return-if (if (not found)))
    (for (in name (list "animation" "enter-space" "match"))
      (let offset (call slot-named found name))
      (if offset
        (call style-report-on-mount found offset)
      )
    )
    (let shown (call style-info-named "GUIBoxDisplay"))
    (let display (only-if (call slot-named shown "display") (if shown)))
    (if (and shown display)
      (call style-report-on-mount shown display)
    )
  )
  (fn-do + watch-mask U64
    (param info StyleInfo)
    (let found (call motion-style))
    (return-if (. U64 max) (if (not found)))
    (let mask U64)
    (for (in property (. info properties))
      (if (call watches found info property)
        (= mask (/or/ mask (/lshift/ 1u64 (. property offset))))
      )
    )
    (return mask)
  )
  (fn-expr _ watches Bool
    (param motion StyleInfo)
    (param info StyleInfo)
    (param property StylePropertyInfo)
    (case? (or (== (. property name) "display") (call covers property))
      true
    )
    (case? (== info motion)
      (!= (call (. style-motion-watched find) (. property name)) null)
    )
    (default
      (or (!= (. keys key) null) (!= (. keys group) null))
    )
    (where
      (lazy keys (call keys-for motion info property))
    )
  )
  (fn-expr + is-motion-property Bool
    (param change StyleValueChange)
    (param name String)
    (and (== (. change info) (call motion-style)) (== (. ([] (. change info properties) (. change offset)) name) name))
  )
  (fn-expr + layout-motion (? Motion)
    (param owner MarkupElement)
    (param name String)
    (param cause MarkupCause)
    (case? (is scoped InstantMotion)
      scoped
    )
    (case? (not found)
      scoped
    )
    (default
      (?? (call read-slot owner found (call layout-slot found name)) layout-fallback scoped)
    )
    (where
      (lazy scoped (call scope-motion cause))
      (lazy found (call motion-style))
      (lazy layout-fallback (call read-slot owner found (call layout-slot found "layout")))
    )
  )
  (fn-expr _ layout-slot (? Size)
    (param motion StyleInfo)
    (param name String)
    (if-expr (== known (. Size max)) null known)
    (where
      (lazy known (?? ([] layout-slots name) (call find-layout-slot motion name)))
    )
  )
  (fn-do _ find-layout-slot Size
    (param motion StyleInfo)
    (param name String)
    (let found (?? (call slot-named motion (str "motion." name)) (. Size max)))
    (= ([] layout-slots name) found)
    (return found)
  )
  (fn-expr _ read-slot (? Motion)
    (param owner MarkupElement)
    (param motion StyleInfo)
    (param slot (? Size))
    (if-expr (== slot null) null (call (of style-read-object Motion) owner motion slot))
  )
  (fn-do + defer-entrance _
    (param owner StyleMotionOwner)
    (param start Duration)
    (let now (?? (?. (. owner frame-clock) now) start))
    (return-if (if (<= start now)))
    (for (in play plays)
      (if (and (. play is-entrance) (== (as (. play owner) Pointer) (as owner Pointer)))
        (= (. play delay) (- start now))
      )
    )
  )
  (fn-do _ motion-style (? StyleInfo)
    (let found (?? motion-info (call style-info-named "GUIBoxMotion")))
    (= motion-info found)
    (return found)
  )
  (fn-do + covers Bool
    (param property StylePropertyInfo)
    (if (!= quiet-count (call style-domain-count))
      (= quiet-mask 0)
      (for (in name style-motion-quiet-domains)
        (let domain (call style-domain-named name))
        (if (>= domain 0)
          (= quiet-mask (/or/ quiet-mask (/lshift/ 1u32 (as domain U32))))
        )
      )
      (= quiet-count (call style-domain-count))
    )
    (let domains (/or/ (. property self-domain-mask) (. property parent-domain-mask)))
    (return (and (!= domains 0) (== (/or/ domains quiet-mask) quiet-mask)))
  )
  (fn-expr + range (? StyleMotionRange)
    (param property StylePropertyInfo)
    ([] ranges (. property name))
  )
  (fn-expr + mode StyleLayerMode
    (param property StylePropertyInfo)
    (case? (!= (call (. style-motion-adding find) (. property name)) null)
      (. StyleLayerMode adding)
    )
    (case? (!= (call (. style-motion-scaling find) (. property name)) null)
      (. StyleLayerMode scaling)
    )
    (default
      (. StyleLayerMode replacing)
    )
  )
  (fn-expr + motion-for (? Motion)
    (param owner MarkupElement)
    (param info StyleInfo)
    (param property StylePropertyInfo)
    (case? (not found)
      null
    )
    (default
      (?? (call read-slot owner found (. slots key)) (call read-slot owner found (. slots group)) bare-motion)
    )
    (where
      (lazy found (call motion-style))
      (lazy slots (call keys-for found info property))
      (lazy bare-motion (call read-slot owner found (. slots bare)))
    )
  )
  (fn-do _ keys-for StyleMotionKeys
    (param motion StyleInfo)
    (param info StyleInfo)
    (param property StylePropertyInfo)
    (let code (/or/ (/lshift/ (as (. info style-index) U64) 32) (as (. property offset) U64)))
    (let known ([] keys code))
    (return-if known (if known))
    (let key (call slot-named motion (str "motion." (. property name))))
    (let group
      (scope (only-if (call slot-named motion "motion.transform") (if in-transform-group))
        (lazy in-transform-group (!= (call (. style-motion-transform-group find) (. property name)) null))
      )
    )
    (let bare (only-if (call slot-named motion "motion") (if (call covers property))))
    (let made (call StyleMotionKeys key group bare))
    (= ([] keys code) made)
    (return made)
  )
  (fn-do _ slot-named (? Size)
    (param motion StyleInfo)
    (param name String)
    (for (in property (. motion properties))
      (return-if (. property offset) (if (== (. property name) name)))
    )
    (return null)
  )
  (fn-do _ running (? StyleMotionRun)
    (param node MarkupElement)
    (param info StyleInfo)
    (param offset Size)
    (for (in run runs)
      (return-if run (if (and (== (as (. run node) Pointer) (as node Pointer)) (== (. run info) info) (== (. run offset) offset))))
    )
    (return null)
  )
  (fn-do + entry (? StyleMotionRun)
    (param owner StyleMotionOwner)
    (param info StyleInfo)
    (param offset Size)
    (let node (as owner MarkupElement))
    (let found (call running node info offset))
    (return-if found (if found))
    (let property (call (. info property-at) offset))
    (return-if null (if (not property)))
    (let settled (call style-read-settled node info offset))
    (call style-watch-changes info offset)
    (let made
      (call StyleMotionRun
        (block
          (arg this)
          (arg node)
          (arg owner)
          (arg info)
          (arg offset)
          (arg property)
          (arg (call StylePresenter property (. settled bits)))
        )
      )
    )
    (= (. made range) (call range property))
    (= (. made mode) (call mode property))
    (+= runs made)
    (return made)
  )
  (fn-do + forget _
    (param owner StyleMotionOwner)
    (return-if (if (and (== (. runs length) 0) (== (. plays length) 0) (== (. held length) 0))))
    (for (in play (call (of List KeyframeRun) held))
      (if (== (as (. play owner) Pointer) (as owner Pointer))
        (-= held play)
      )
    )
    (for (in play (call (of List KeyframeRun) plays))
      (if (== (as (. play owner) Pointer) (as owner Pointer))
        (call (. play cancel))
      )
    )
    (for (in run (call (of List StyleMotionRun) runs))
      (if (== (as (. run owner) Pointer) (as owner Pointer))
        (call (. run stop))
      )
    )
  )
  (fn-do + holds Bool
    (param root MarkupElement)
    (for (in run runs)
      (return-if true (if (and (!= (. run channel) null) (call style-is-within (. run node) root))))
    )
    (return (call some plays (:where (and (. each ends) (call style-is-within (. each owner) root)))))
  )
  (fn-do + hold _
    (param play KeyframeRun)
    (+= held play)
  )
  (fn-do + release-held _
    (param owner StyleMotionOwner)
    (for (in play (call (of List KeyframeRun) held))
      (if (== (as (. play owner) Pointer) (as owner Pointer))
        (-= held play)
        (call (. play release))
      )
    )
  )
  (fn-do + restart-within _
    (param root MarkupElement)
    (for (in play (call (of List KeyframeRun) plays))
      (if (call style-is-within (. play owner) root)
        (call (. play cancel))
      )
    )
    (for (in run (call (of List StyleMotionRun) runs))
      (if (call style-is-within (. run node) root)
        (call (. run stop))
      )
    )
    (call style-unsettle root)
  )
  (fn-do + ended _
    (param run StyleMotionRun)
    (for (in index (..< 0 (. runs length)))
      (if (== (as ([] runs index) Pointer) (as run Pointer))
        (call (. runs remove) index)
        (return)
      )
    )
  )
  (fn-do + play-ended _
    (param play KeyframeRun)
    (for (in index (..< 0 (. plays length)))
      (if (== (as ([] plays index) Pointer) (as play Pointer))
        (call (. plays remove) index)
        (return)
      )
    )
  )
  (fn-do + play KeyframeRun
    (param owner StyleMotionOwner)
    (param animation KeyframeAnimation)
    (param is-styled Bool (= false))
    (let started (call KeyframeRun this owner animation))
    (= (. started is-styled) is-styled)
    (= (. started is-entrance) (and is-styled (. owner is-entering)))
    (+= plays started)
    (call (. started begin))
    (return started)
  )
  (fn-do + replay _
    (param owner StyleMotionOwner)
    (param animation KeyframeAnimation)
    (call (?. (call styled-play owner) cancel))
    (do
      (inline (call play owner animation true))
    )
  )
  (fn-do _ styled-play (? KeyframeRun)
    (param owner StyleMotionOwner)
    (for (in play plays)
      (return-if play (if (and (. play is-styled) (== (as (. play owner) Pointer) (as owner Pointer)))))
    )
    (return null)
  )
  (fn-do + change-value _
    (param owner StyleMotionOwner)
    (param change StyleValueChange)
    (let node (as owner MarkupElement))
    (let property ([] (. change info properties) (. change offset)))
    (if (and (== (. change info) (call motion-style)) (== (. property name) "animation"))
      (call animation-changed owner change)
      (return)
    )
    (let run (call running node (. change info) (. change offset)))
    (let clock (. owner frame-clock))
    (let scoped (call scope-motion (call current-markup-cause)))
    (let own (call motion-for node (. change info) property))
    (let motion (if-expr (is scoped InstantMotion) scoped (?? own (only-if scoped (if (call covers property))))))
    (if (or (not clock) (not motion) (is motion InstantMotion) (not (. owner is-motion-visible)) (. owner snaps-motion))
      (call (?. run settle-now))
      (return)
    )
    (let ends-none (. change none))
    (let target
      (scope (if-expr ends-none (call style-motion-none-vector property (. change old-bits)) end-vector)
        (lazy end-vector (call style-motion-vector property (. change bits) false))
      )
    )
    (let channel (?. run channel))
    (let from (if-expr channel (call (of List F64) (. channel value)) (call start-vector property change)))
    (let moves
      (scope (or (. change none) (. change old-none) bits-move)
        (lazy bits-move (call style-motion-moves property (. change old-bits) (. change bits)))
      )
    )
    (if (or (not target) (not from) (!= (. target length) (. from length)) (not moves))
      (call (?. run settle-now))
      (return)
    )
    (if (and run (not ends-none))
      (call (. run presenter retarget) (. change bits))
    )
    (let now (. clock now))
    (if channel
      (= (. (!! run) ends-none) ends-none)
      (call (. channel retarget) target motion now)
      (return)
    )
    (let start (. owner motion-start))
    (let begins (if-expr (and start (> start now)) start now))
    (let started (call MotionChannel from style-motion-precision))
    (call (. started retarget) target motion begins)
    (return-if (if (not (. started is-moving))))
    (let sample (if-expr ends-none (. change old-bits) (. change bits)))
    (let moving
      (scope (?? run (call StyleMotionRun this node owner (. change info) (. change offset) property presenter))
        (lazy presenter (call StylePresenter property sample))
      )
    )
    (if (not run)
      (= (. moving range) (call range property))
      (= (. moving mode) (call mode property))
      (+= runs moving)
    )
    (= (. moving channel) started)
    (= (. moving ends-none) ends-none)
    (call (. moving present) now)
    (call (. clock start) owner moving)
  )
  (fn-do _ animation-changed _
    (param owner StyleMotionOwner)
    (param change StyleValueChange)
    (let node (as owner MarkupElement))
    (let current (call styled-play owner))
    (if (and current (. current is-entrance) (not (. owner is-entering)))
      (= (. current is-styled) false)
      (else
        (call (?. current ease-back))
      )
    )
    (let next (call (of style-read-object KeyframeAnimation) node (. change info) (. change offset)))
    (if next
      (do
        (inline (call play owner next true))
      )
    )
  )
  (fn-expr _ start-vector (? (list F64))
    (param property StylePropertyInfo)
    (param change StyleValueChange)
    (if-expr (. change old-none) (call style-motion-none-vector property (. change bits)) old-vector)
    (where
      (lazy old-vector (call style-motion-vector property (. change old-bits) false))
    )
  )
)

(type + StyleMotionLayer
  (prop + mode StyleLayerMode)
  (prop + component (? Index))
  (prop + values (? (list F64)))
  (fn-do + This _
    (param mode _)
    (param component _)
  )
  (fn-do + apply _
    (param shown (list F64))
    (let given values)
    (return-if (if (not given)))
    (let from (?? component 0))
    (for (in index (..< 0 (. given length)))
      (let place (+ from index))
      (if (< place (. shown length))
        (match mode
          (case= .adding
            (= ([] shown place) (+ ([] shown place) ([] given index)))
          )
          (case= .scaling
            (= ([] shown place) (* ([] shown place) ([] given index)))
          )
          (default
            (= ([] shown place) ([] given index))
          )
        )
      )
    )
  )
)

(type + StyleMotionRun
  (implements FrameAnimation)
  (prop + host GUIStyleMotion)
  (prop + node MarkupElement)
  (prop + owner StyleMotionOwner)
  (prop + info StyleInfo)
  (prop + offset Size)
  (prop + property StylePropertyInfo)
  (prop + presenter StylePresenter)
  (prop + channel (? MotionChannel))
  (prop + ends-none _ (= false))
  (prop + range (? StyleMotionRange))
  (prop + mode _ (= (. StyleLayerMode replacing)))
  (prop + layers _ (= (call (of List StyleMotionLayer))))
  (blank)
  (prop _ is-stopped _ (= false))
  (prop _ blank (? (list F64)))
  (prop _ based _ (= (call (of List F64))))
  (prop _ opened _ (= (call (of List F64))))
  (prop _ presented _ (= (call (of List F64))))
  (fn-do + This _
    (param host _)
    (param node _)
    (param owner _)
    (param info _)
    (param offset _)
    (param property _)
    (param presenter _)
  )
  (fn-do + base (? (list F64))
    (let vector (call (of List F64)))
    (return (only-if vector (if (call fill-base vector))))
  )
  (fn-do _ fill-base Bool
    (param into (list F64))
    (call (. into clear))
    (let moving channel)
    (if moving
      (++= into (. moving value))
      (return true)
    )
    (let settled (call style-read-settled node info offset))
    (return-if true (if (call style-motion-vector-into into property (. settled bits) (. settled none))))
    (let vector (?? (call style-motion-none-vector property (. settled bits)) blank))
    (return-if false (if (not vector)))
    (++= into vector)
    (return true)
  )
  (fn-do + adopt _
    (param sample (? StyleObjectHolder))
    (return-if (if (not sample)))
    (call (. presenter adopt) sample)
    (= blank (?? blank (call (. sample motion-none-vector))))
  )
  (fn-do + open-vector (? (list F64))
    (param layer StyleMotionLayer)
    (let whole based)
    (return-if null (if (not (call fill-base whole))))
    (let length (if-expr (!= (. layer component) null) 1 (. whole length)))
    (call (. opened clear))
    (match (. layer mode)
      (case= .adding
        (for (in _ (..< 0 length))
          (+= opened 0.0)
        )
      )
      (case= .scaling
        (for (in _ (..< 0 length))
          (+= opened 1.0)
        )
      )
      (default
        (let part (. layer component))
        (return-if whole (if (or (== part null) (>= part (. whole length)))))
        (+= opened ([] whole part))
      )
    )
    (return opened)
  )
  (fn-do + shown (? (list F64))
    (let shown (call base))
    (return-if null (if (not shown)))
    (for (in layer layers)
      (call (. layer apply) shown)
    )
    (return shown)
  )
  (fn-do + present _
    (param now (? Duration) (= null))
    (return-if (if is-stopped))
    (if now
      (call (?. channel update) now)
    )
    (let values presented)
    (if (not (call fill-base values))
      (call end)
      (return)
    )
    (for (in layer layers)
      (call (. layer apply) values)
    )
    (let limits range)
    (if (and limits (. property is-float))
      (let low (. limits minimum))
      (let high (. limits maximum))
      (if (and low (< ([] values 0) low))
        (= ([] values 0) low)
      )
      (if (and high (> ([] values 0) high))
        (= ([] values 0) high)
      )
    )
    (call style-present node info offset (call (. presenter bits) values) false)
  )
  (fn-do + settle-now _
    (= channel null)
    (if (== (. layers length) 0)
      (call stop)
      (return)
    )
    (call (?. (. owner frame-clock) cancel) this)
    (call present)
  )
  (fn-do + remove-layer _
    (param layer StyleMotionLayer)
    (for (in index (..< 0 (. layers length)))
      (if (== (as ([] layers index) Pointer) (as layer Pointer))
        (call (. layers remove) index)
        (return)
      )
    )
  )
  (fn-do + release _
    (param now (? Duration) (= null))
    (if (and (== (. layers length) 0) (not channel))
      (call stop)
      (return)
    )
    (call present now)
  )
  (fn-do + ease-from _
    (param shown (list F64))
    (param now Duration)
    (let motion (call (. host motion-for) node info property))
    (let target (call base))
    (if (or (not motion) (is motion InstantMotion) (not target) (!= (. target length) (. shown length)) has-layers)
      (call release now)
      (return)
    )
    (lazy has-layers (!= (. layers length) 0))
    (let eased (call MotionChannel shown style-motion-precision))
    (call (. eased retarget) (if-expr channel (call (of List F64) (. channel target)) target) motion now)
    (if (not (. eased is-moving))
      (call release now)
      (return)
    )
    (= channel eased)
    (call present now)
    (call (?. (. owner frame-clock) start) owner this)
  )
  (fn-do + stop _
    (return-if (if is-stopped))
    (call end)
    (call (?. (. owner frame-clock) cancel) this)
  )
  (fn-do _ end _
    (= is-stopped true)
    (call (. host ended) this)
    (call style-unpresent node info offset)
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if is-stopped))
    (call present (. tick now))
    (let moving channel)
    (if (and moving (not (. moving is-moving)))
      (= channel null)
      (if (and ends-none (== (. layers length) 0))
        (call end)
        (return false)
      )
      (if (== (. layers length) 0)
        (call end)
        (return false)
      )
      (call present)
    )
    (return (!= channel null))
  )
  (fn-do + finish _
    (return-if (if is-stopped))
    (= channel null)
    (if (== (. layers length) 0)
      (call end)
      (return)
    )
    (call present)
  )
)

(type + KeyframeRun
  (implements FrameAnimation)
  (prop + host GUIStyleMotion)
  (prop + owner StyleMotionOwner)
  (prop + animation KeyframeAnimation)
  (prop + is-styled _ (= false))
  (prop + is-entrance _ (= false))
  (prop + is-done _ (= false))
  (prop + is-scrubbed _ (= false))
  (prop + delay Duration (= 0ns))
  (blank)
  (prop _ entries _ (= (call (of List StyleMotionRun))))
  (prop _ layers _ (= (call (of List StyleMotionLayer))))
  (prop _ tracks _ (= (call (of List KeyframeTrack))))
  (prop _ ended (? (of Completion Bool)))
  (fn-do + This _
    (param host _)
    (param owner _)
    (param animation _)
  )
  (fn-do + begin _
    (for (in track (. animation tracks))
      (let info (. track info))
      (if info
        (let found (call (. host entry) owner info (. track offset)))
        (if found
          (call (. found adopt) (. track sample))
          (let layer (call StyleMotionLayer (call (. host mode) (. found property)) (. track component)))
          (+= (. found layers) layer)
          (+= entries found)
          (+= layers layer)
          (+= tracks track)
        )
      )
    )
    (let clock (. owner frame-clock))
    (if (or (not clock) (== (. entries length) 0))
      (call complete (?. clock now))
      (return)
    )
    (return-if (if (and is-styled (call (. owner drive-timeline) this))))
    (let start (. owner motion-start))
    (if (and start (> start (. clock now)))
      (= delay (- start (. clock now)))
    )
    (call step 0ns (. clock now))
    (call (. clock start) owner this (. animation clock-rate))
  )
  (fn-expr + ends Bool :get
    (and (not is-done) (not is-scrubbed) (!= (call iterations) null))
  )
  (fn-do + scrub _
    (param progress F64)
    (return-if (if is-done))
    (= is-scrubbed true)
    (let total (call iterations))
    (let count (if-expr total (as total F64) 1.0))
    (let seconds (* (as (as (. animation duration) Seconds) F64) count (call clamp progress 0.0 1.0)))
    (let ignored (call step (as (as seconds Seconds) Nanoseconds) (?? (?. (. owner frame-clock) now) 0ns)))
  )
  (fn-do + wait _
    (return-if (if is-done))
    (let done (?? ended (call (of Completion Bool))))
    (= ended done)
    (call (. done await))
  )
  (fn-do + cancel _
    (return-if (if is-done))
    (call (?. (. owner frame-clock) cancel) this)
    (call complete (?. (. owner frame-clock) now))
  )
  (fn-do + ease-back _
    (return-if (if is-done))
    (= is-done true)
    (call (?. (. owner frame-clock) cancel) this)
    (call ease-out)
    (call signal)
  )
  (fn-do + release _
    (call ease-out)
  )
  (fn-do _ ease-out _
    (let now (?? (?. (. owner frame-clock) now) 0ns))
    (for (in index (..< 0 (. entries length)))
      (let entry ([] entries index))
      (let shown (call (. entry shown)))
      (call (. entry remove-layer) ([] layers index))
      (if shown
        (call (. entry ease-from) shown now)
        (else
          (call (. entry release) now)
        )
      )
    )
  )
  (fn-do _ complete _
    (param now (? Duration))
    (= is-done true)
    (for (in index (..< 0 (. entries length)))
      (call (. ([] entries index) remove-layer) ([] layers index))
    )
    (for (in entry entries)
      (call (. entry release) now)
    )
    (call signal)
  )
  (fn-do _ signal _
    (call (. host play-ended) this)
    (call (?. ended finish) true)
    (= ended null)
  )
  (fn-do _ iterations (? Size)
    (match (. animation repeat)
      (case= .forever
        (return null)
      )
      (case (call .times count)
        (return (call max count 1))
      )
      (default
        (return 1)
      )
    )
  )
  (fn-do _ step Bool
    (param elapsed Duration)
    (param now Duration)
    (let span (. animation duration))
    (let spans (as (as span Seconds) F64))
    (let total (call iterations))
    (let turn (if-expr (> spans 0) (as (call floor (/ (as (as elapsed Seconds) F64) spans)) Int) 0))
    (let last (if-expr total (- total 1) turn))
    (let finished (and (!= total null) (> turn last)))
    (let iteration (if-expr finished last turn))
    (let into (if-expr finished (- elapsed (* span last)) (- elapsed (* span iteration))))
    (let reversed (call is-reversed iteration))
    (let moving false)
    (for (in index (..< 0 (. tracks length)))
      (let track ([] tracks index))
      (let layer ([] layers index))
      (let entry ([] entries index))
      (let open (call (. entry open-vector) layer))
      (if open
        (let local (if-expr reversed (if-expr (< into span) (- span into) 0ns) into))
        (let values (?? (. layer values) (call (of List F64))))
        (= (. layer values) values)
        (if (and (call (. track fill) values local span style-motion-precision open) (not reversed))
          (= moving true)
        )
      )
      (call (. entry present) now)
    )
    (return (or (not finished) moving))
  )
  (fn-do _ is-reversed Bool
    (param iteration Int)
    (match (. animation direction)
      (case= .reverse
        (return true)
      )
      (case= .alternate
        (return (== (% iteration 2) 1))
      )
      (case= .alternate-reverse
        (return (== (% iteration 2) 0))
      )
      (default
        (return false)
      )
    )
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if is-done))
    (return-if true (if (call step (if-expr (> (. tick elapsed) delay) (- (. tick elapsed) delay) 0ns) (. tick now))))
    (if (. owner is-leaving)
      (= is-done true)
      (call (. host hold) this)
      (call signal)
      (return false)
    )
    (call complete (. tick now))
    (return false)
  )
  (fn-do + finish _
    (return-if (if is-done))
    (call complete (?. (. owner frame-clock) now))
  )
)
