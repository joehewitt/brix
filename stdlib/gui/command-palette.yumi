+ CommandPalette is Palette'CommandPaletteEntry

+ snapshot [Command]
+ recents = Recents()
+ chooser CommandChooserNode?
+ choices [CommandChoice]
+ returns-to-commands = false
+ prompt = command-palette-prompt(#chooser)
+ empty-text = command-palette-empty-text(#query, #chooser)
+ results = command-palette-entries(#snapshot, #choices, #query, recents.#keys, #chooser)
+ key-builder = :: entry => entry.key

