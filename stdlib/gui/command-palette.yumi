<This
    <LucideCheck • icon command-palette-check
        align-y = Alignment.center
        display = if #is-on then Display.visible else Display.invisible
    <MatchLabel title-label
        text = #title
        hits = #entry?.title-hits ?? List'MatchSpan()
        align-y = Alignment.center
    <MatchLabel detail-label • command-palette-detail flex:1
        text = #detail
        hits = #detail-hits
        align-y = Alignment.center
    if #command
        <Label shortcut • command-palette-shortcut
            text = #shortcut-label
            text-alignment = TextAlignment.right
            align-y = Alignment.center

━━━━━━━━━━━━━━━━━━━━
+ command-shortcut-label
    - command Command
    - palette CommandPalette?

match palette?.host-window
    | host Window
        ", ".join • stream
            ** host.registered-key-bindings
            ?*> command-shortcut-for(each, command)
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ command-shortcut-for
    - binding KeyBinding
    - command Command

|? !target || target.identity != command.identity
    null
|? !label
    null
??
    label

.. target = binding.command-target
.. label = binding.symbol-label

━━━━━━━━━━━━━━━━━━━━
_ do command-palette-matches [Command]
    - commands [Command]
    - query String
    - recent [String]

. ordered [Command]
for key in recent
    . found = first(each in commands when each.stable-key == key)
    if found && found.is-discoverable
        ordered += found
=? ordered if !query
for command in commands
    if command.is-discoverable && !(recent has command.stable-key)
        ordered += command
= fuzzy-ranked(ordered, query, :: command => command-palette-text(command))

━━━━━━━━━━━━━━━━━━━━
_ command-palette-text
    - command Command

"${command.title} ${command.description}"

━━━━━━━━━━━━━━━━━━━━
_ command-palette-prompt
    - chooser CommandChooserNode?

|? chooser
    chooser.prompt
??
    ""

━━━━━━━━━━━━━━━━━━━━
_ command-palette-empty-text
    - query String
    - chooser CommandChooserNode?

|? chooser
    "No matches found"
|? query
    "No commands found"
??
    ""

━━━━━━━━━━━━━━━━━━━━
_ do command-palette-entries [CommandPaletteEntry]
    - commands [Command]
    - choices [CommandChoice]
    - query String
    - recent [String]
    - chooser CommandChooserNode?

. pattern = FuzzyQuery(query)
. entries [CommandPaletteEntry]
if chooser
    for choice in fuzzy-ranked(choices, query, :: choice => choice.title)
        entries += CommandPaletteEntry
            - "choice:${choice.key}"
            - null
            - choice
            - match-spans(pattern.positions(choice.title))
    = entries
for command in command-palette-matches(commands, query, recent)
    . size = command.title.size
    . positions = pattern.positions(command-palette-text(command))
    . title-hits = match-spans(List'Index(each in positions when each < size))
    . detail-hits = match-spans(List'Index(each in positions when each > size), size + 1)
    entries += CommandPaletteEntry
        - "command:${command.identity.address}"
        - command
        - null
        - title-hits
        - detail-hits
= entries

━━━━━━━━━━━━━━━━━━━━
_ command-palette-entry-title
    - command Command?
    - choice CommandChoice?

choice?.title ?? command?.title ?? ""

━━━━━━━━━━━━━━━━━━━━
_ command-palette-entry-is-on
    - command Command?
    - choice CommandChoice?

choice?.checked ?? command?.is-on ?? false

━━━━━━━━━━━━━━━━━━━━
_ command-palette-entry-detail
    - is-enabled Bool
    - command Command?

|? !command
    ""
|? !is-enabled && command.unavailable-reason
    command.unavailable-reason
??
    command.description

━━━━━━━━━━━━━━━━━━━━
_ command-palette-entry-shortcut
    - command Command?
    - palette CommandPalette?

|? command
    command-shortcut-label(command, palette)
??
    ""

━━━━━━━━━━━━━━━━━━━━
_ do load-command-choices
    - source CommandChooserNode

= source.choices()
    catch err Error
        = List'CommandChoice()
