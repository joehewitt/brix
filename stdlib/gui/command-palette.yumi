────────────────────
+ do show-commands

chooser = null
choices = List'CommandChoice()
returns-to-commands = false
reset()

────────────────────
+ do execute
    - command Command

. host = host-window
=? if !host
. live Command?
for current in host.commands
    if current.identity == command.identity
        live = current
        break
=? if !live
if !live.is-available
    notice = if live.unavailable-reason then live.unavailable-reason else default-notice
        .. default-notice = "“${live.title}” is unavailable"
    =
recents.remember(live.stable-key)
if live is CommandChooserNode
    show-choices(live as CommandChooserNode)
    returns-to-commands = true
    =
live.run()
dismiss(DismissReason.chosen)

────────────────────
+ do choose-choice
    - choice CommandChoice

. source = chooser
=? if !source
dismiss(DismissReason.chosen)
source.choose(choice)


━━━━━━━━━━━━━━━━━━━━
+ CommandPaletteRow is Box

+ entry CommandPaletteEntry?
+ command Command? = #entry?.command
+ choice CommandChoice? = #entry?.choice
+ title = command-palette-entry-title(#command, #choice)
+ is-enabled = #command?.is-available ?? true
+ is-on = command-palette-entry-is-on(#command, #choice)
+ detail = command-palette-entry-detail(#is-enabled, #command)
+ detail-hits = if #is-enabled then #entry?.detail-hits ?? List'MatchSpan() else List'MatchSpan()
+ shortcut-label = command-palette-entry-shortcut(#command, #palette)

_ palette Ancestor'CommandPalette

