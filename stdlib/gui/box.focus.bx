(import ./box)
(import ./events)
(import ./primitives)
(import ./styles)
(import /graphics/canvas)
(import /graphics/primitives)
(import /graphics/roundedrect)
(import /math)

(type + BoxFocus (facet-of Box)
  (sees BoxScroll)
  (using GUIBoxFocus)
  (using GUIFocusRingStyle)
  (event + focus FocusEvent)
  (event + blur BlurEvent)
  (blank)
  (prop + is-focused _ (= false))
  (prop + is-focus-visible _ (= false))
  (prop + is-focus-within _ (= false))
  (prop + remembered-focus (? Box))
  (prop + admits-focus-traversal _ (=> true))
  (prop + is-focus-enabled _ (=> true))
  (prop + is-focus-ready _ (=> true))
  (prop + native-focus-handle (? Pointer) (=> null))
  (prop + accepts-focus _
    (=>
      (block
        (and is-focusable is-effectively-enabled is-available is-focus-admitted)
        (lazy is-focusable (and (call focus-mode-can-focus $focus-mode) is-focus-enabled))
        (lazy is-available (and is-input-visible (!= markup-batch-root null)))
      )
    )
  )
  (prop + is-focus-admitted _
    (=>
      (block
        (or (not host) (call (. host admits-focus) this))
        (lazy host window)
      )
    )
  )
  (prop + can-focus _ (=> (and accepts-focus is-focus-ready)))
  (prop + delegates-focus _ (=> (and $focus-group (not (call focus-mode-can-focus $focus-mode)))))
  (prop + holds-group-focus _
    (=>
      (block
        (and delegates-focus is-effectively-enabled is-available is-focus-admitted)
        (lazy is-available (and is-input-visible (!= markup-batch-root null)))
      )
    )
  )
  (prop + can-hold-focus _ (=> (or can-focus holds-group-focus)))
  (blank)
  (prop _ is-focus-home _ (= false))
  (fn-do + focus-candidates _
    (let candidates (list Box))
    (call collect-focus-candidates candidates)
    (return candidates)
  )
  (fn-do + focus-candidate-at-edge _
    (param going-backward _ (= false))
    (return-if (if (not is-input-visible)))
    (let cursor (? Box) (if-expr going-backward (call focus-walk-last-visible) this))
    (while cursor
      (let candidate cursor)
      (return-if candidate (if (call (. candidate is-focus-walk-candidate))))
      (if going-backward
        (= cursor (call focus-walk-previous this candidate))
        (else
          (= cursor (call focus-walk-next this candidate))
        )
      )
    )
  )
  (fn-do + focus-candidate-after _
    (param current Box)
    (param going-backward _ (= false))
    (return-if (if (not (call (. current is-within) this))))
    (let cursor (? Box))
    (if going-backward
      (= cursor (call focus-walk-previous this current))
      (else
        (= cursor (call focus-walk-next this current))
      )
    )
    (while cursor
      (let candidate cursor)
      (return-if candidate (if (call (. candidate is-focus-walk-candidate))))
      (if going-backward
        (= cursor (call focus-walk-previous this candidate))
        (else
          (= cursor (call focus-walk-next this candidate))
        )
      )
    )
  )
  (fn-do + nearest-focus-group (? Box)
    (let cursor (? Box) this)
    (while cursor
      (let box cursor)
      (return-if box (if (and (. box $focus-group) (not (. box is-markup-shadow)))))
      (return-if null (if (. box is-presentation-layer)))
      (= cursor (. box material-parent))
    )
    (return null)
  )
  (fn-do + focus-group-target (? Box)
    (return-if null (if (not is-input-visible)))
    (let kept remembered-focus)
    (if kept
      (let usable (or (. kept accepts-focus) (. kept holds-group-focus)))
      (return-if kept (if (and (not (. kept is-markup-shadow)) usable (call (. kept is-within) this))))
      (= remembered-focus null)
    )
    (return (?? (call seek-group-focus true) (call seek-group-focus false) (call seek-group-holder)))
  )
  (fn-do + nearest-focus-owner _
    (let cursor (? Box) this)
    (while cursor
      (if (and (not (. cursor is-markup-shadow)) (. cursor can-focus))
        (return cursor)
      )
      (= cursor (. cursor material-parent))
    )
  )
  (fn-do + request-focus _
    (let host window-host)
    (return (if-expr host (call (. host accept-focus-request) this) false))
  )
  (fn-do + clear-focus Bool
    (let host window-host)
    (return (if-expr host (call (. host accept-focus-request) null) false))
  )
  (fn-do + is-focus-traversal-reachable _
    (return-if true (if is-presentation-layer))
    (let rect bounds)
    (let cursor (. this material-parent))
    (while cursor
      (let ancestor cursor)
      (return-if false (if (not (. ancestor admits-focus-traversal))))
      (if (not (. ancestor is-markup-shadow))
        (if (. ancestor clips-content)
          (let outside-x (<= (. rect right) (. ancestor content-bounds left)))
          (= outside-x (or outside-x (>= (. rect left) (. ancestor content-bounds right))))
          (let outside-y (<= (. rect bottom) (. ancestor content-bounds top)))
          (= outside-y (or outside-y (>= (. rect top) (. ancestor content-bounds bottom))))
          (let clips-fixed-x (not (call (. ancestor is-scroll-axis-enabled) (. Orientation horizontal))))
          (let clips-fixed-y (not (call (. ancestor is-scroll-axis-enabled) (. Orientation vertical))))
          (return-if false (if (and clips-fixed-x outside-x)))
          (return-if false (if (and clips-fixed-y outside-y)))
        )
        (let offset (. ancestor content-offset))
        (= rect (call Rect (- (. rect x) (. offset x)) (- (. rect y) (. offset y)) (. rect width) (. rect height)))
      )
      (return-if true (if (. ancestor is-presentation-layer)))
      (= cursor (. ancestor material-parent))
    )
    (return true)
  )
  (fn-expr + admits-focus _
    (param box Box)
    true
  )
  (fn-do + reveal-focus _
    (return-if (if (not (call has-scroll-container-ancestor))))
    (call (. root ensure-visible)
      (block
        (arg this)
        (arg (. ScrollAlignment nearest))
        (arg (call Insets 0 0 0 0))
        (arg (. ScrollCause focus))
      )
    )
  )
  (fn-expr + focus-ring-reach _ :get
    (case? (or (not ring) (<= width 0) (<= height 0))
      0
    )
    (default
      (+ (call max 0 (. ring offset)) (call max 0 (. ring width)))
    )
    (where
      (lazy ring $focus-ring)
    )
  )
  (fn-do + paint-focus-ring _
    (param canvas Canvas)
    (let ring $focus-ring)
    (return-if (if (or (not ring) (<= (. ring width) 0) (<= width 0) (<= height 0))))
    (let extent (+ (call max 0 (. ring offset)) (/ (. ring width) 2)))
    (let outline (call (. bounds pad) (- extent)))
    (do-use (. canvas saved-state)
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) (. ring color))
      (= (. canvas stroke-width) (. ring width))
      (if (> effective-corner-radius 0)
        (let radius (+ effective-corner-radius extent))
        (call (. canvas begin))
        (call (. (call RoundedRect outline radius radius radius radius) outline) canvas)
        (call (. canvas end))
        (else
          (call (. canvas rect) outline)
        )
      )
    )
  )
  (fn-do ^ sync-focus-home _
    (let is-home $focus-home)
    (return-if (if (== is-home is-focus-home)))
    (let host window-host)
    (return-if (if (not host)))
    (= is-focus-home is-home)
    (if is-home
      (call (. host register-focus-home) this)
      (else
        (call (. host unregister-focus-home) this)
      )
    )
  )
  (fn-do ^ release-focus-home _
    (return-if (if (not is-focus-home)))
    (= is-focus-home false)
    (call (?. window-host unregister-focus-home) this)
  )
  (fn-do _ collect-focus-candidates _
    (param candidates (list Box))
    (return-if (if (not is-input-visible)))
    (if (and (not is-markup-shadow) accepts-focus (call is-focus-traversal-reachable))
      (+= candidates this)
    )
    (for (in child (call RenderedChildCursor this))
      (call (. child collect-focus-candidates) candidates)
    )
  )
  (fn-expr _ is-focus-walk-candidate _
    (case? is-markup-shadow
      false
    )
    (default
      (and accepts-focus (call is-focus-traversal-reachable))
    )
  )
  (fn-do _ focus-walk-next _
    (param boundary Box)
    (param node Box)
    (if (. node is-display-visible)
      (let child (call (. node focus-walk-first-visible-child)))
      (return-if child (if child))
    )
    (blank)
    (let cursor node)
    (while (!= (as cursor Pointer) (as boundary Pointer))
      (let parent (. cursor material-parent))
      (return-if (if (not parent)))
      (let sibling (call (. cursor focus-walk-next-visible-sibling) parent))
      (return-if sibling (if sibling))
      (= cursor parent)
    )
  )
  (fn-do _ focus-walk-previous _
    (param boundary Box)
    (param node Box)
    (return-if (if (== (as node Pointer) (as boundary Pointer))))
    (let parent (. node material-parent))
    (return-if (if (not parent)))
    (let sibling (call (. node focus-walk-previous-visible-sibling) parent))
    (return (if-expr sibling (call (. sibling focus-walk-last-visible)) parent))
  )
  (fn-do _ focus-walk-first-visible-child _
    (let candidate (call gui-rendered-resolve this %first-child))
    (while candidate
      (return-if candidate (if (call gui-focus-edge-visible this candidate)))
      (= candidate (call gui-rendered-resolve this (call gui-rendered-climb candidate this)))
    )
  )
  (fn-do _ focus-walk-last-visible-child _
    (let candidate (call gui-rendered-reverse-resolve this %last-child))
    (while candidate
      (return-if candidate (if (call gui-focus-edge-visible this candidate)))
      (= candidate
        (call gui-rendered-reverse-resolve
          (block
            (arg this)
            (arg (call gui-rendered-reverse-climb candidate this))
          )
        )
      )
    )
  )
  (fn-do _ focus-walk-next-visible-sibling _
    (param owner Box)
    (let candidate (call gui-rendered-resolve owner (call gui-rendered-climb this owner)))
    (while candidate
      (return-if candidate (if (call gui-focus-edge-visible owner candidate)))
      (= candidate (call gui-rendered-resolve owner (call gui-rendered-climb candidate owner)))
    )
  )
  (fn-do _ focus-walk-previous-visible-sibling _
    (param owner Box)
    (let candidate (call gui-rendered-reverse-resolve owner (call gui-rendered-reverse-climb this owner)))
    (while candidate
      (return-if candidate (if (call gui-focus-edge-visible owner candidate)))
      (= candidate
        (call gui-rendered-reverse-resolve
          (block
            (arg owner)
            (arg (call gui-rendered-reverse-climb candidate owner))
          )
        )
      )
    )
  )
  (fn-do _ focus-walk-last-visible Box
    (let cursor this)
    (while true
      (let child (call (. cursor focus-walk-last-visible-child)))
      (return-if cursor (if (not child)))
      (= cursor child)
    )
  )
  (fn-do _ gui-focus-edge-visible _
    (param owner Box)
    (param candidate Box)
    (let cursor (? GuiNode) candidate)
    (while (and cursor (!= (as cursor Pointer) (as owner Pointer)))
      (let node cursor)
      (return-if false (if (and (is node Box) (not (. (as node Box) is-display-visible)))))
      (= cursor (. node %parent))
    )
    (return true)
  )
  (fn-do _ seek-group-holder (? Box)
    (for (in child (call RenderedChildCursor this))
      (let found (call (. child seek-holder-from)))
      (return-if found (if found))
    )
    (return null)
  )
  (fn-expr _ seek-holder-from (? Box)
    (case? (not is-input-visible)
      null
    )
    (case? (and (not is-markup-shadow) holds-group-focus)
      this
    )
    (default
      (call seek-group-holder)
    )
  )
  (fn-do _ seek-group-focus (? Box)
    (param prefers Bool)
    (for (in child (call RenderedChildCursor this))
      (let found (call (. child seek-focus-from) prefers))
      (return-if found (if found))
    )
    (return null)
  )
  (fn-do _ seek-focus-from (? Box)
    (param prefers Bool)
    (return-if null (if (not is-input-visible)))
    (if (not is-markup-shadow)
      (let delegates (or $focus-group (and $focus-default (not (call focus-mode-can-focus $focus-mode)))))
      (return-if (call focus-group-target) (if (and prefers delegates)))
      (let wanted (if-expr prefers $focus-default (call focus-mode-takes-keys $focus-mode)))
      (return-if this (if (and wanted accepts-focus)))
    )
    (return (call seek-group-focus prefers))
  )
)
