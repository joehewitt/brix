+ PlaneSliderThumbEdge is Box

━━━━━━━━━━━━━━━━━━━━
_ clamped-axis F64
    - value F64
    - minimum F64
    - maximum F64

|? !is-finite(value) || value <= minimum
    minimum
|? value >= maximum
    maximum
??
    value

━━━━━━━━━━━━━━━━━━━━
_ snapped-axis F64
    - value F64
    - minimum F64
    - maximum F64
    - step F64

|? !is-finite(step) || step <= 0
    clamped-axis(value, minimum, maximum)
??
    clamped-axis(minimum + round((clamped - minimum) / step) * step, minimum, maximum)

.. clamped = clamped-axis(value, minimum, maximum)

━━━━━━━━━━━━━━━━━━━━
_ axis-ratio F64
    - value F64
    - minimum F64
    - maximum F64

|? !is-finite(minimum) || !is-finite(maximum) || maximum <= minimum
    0
??
    (clamped-axis(value, minimum, maximum) - minimum) / (maximum - minimum)

━━━━━━━━━━━━━━━━━━━━
_ axis-increment F64
    - minimum F64
    - maximum F64
    - step F64

|? is-finite(step) && step > 0
    step
??
    (maximum - minimum) * 0.01
