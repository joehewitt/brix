+ measured-content-size
    - query MeasureQuery

Dimensions(200, 150)

────────────────────
_ do plane-state-changed

. ratio = value-ratio(effective-value)
render-x = ratio.x as Ratio
render-y = ratio.y as Ratio
if !is-effectively-enabled
    inoperable <- true

────────────────────
+ do accept-user-value
    - candidate Point
    - phase ValueChangePhase = ValueChangePhase.discrete

=? if !is-effectively-enabled
. old = effective-value
. next = normalized-value(candidate)
=? if next == old && (phase == ValueChangePhase.discrete || phase == ValueChangePhase.changed)
if next != old
    . change = ValueChange'Point(old, next, phase)
    value-changing <- change
    =? if change.is-canceled
value = next
value-changed <- ValueChange'Point(old, next, phase)

────────────────────
_ do step-values
    - x-steps F64
    - y-steps F64

. current = effective-value
. increment = small-increment
accept-user-value(Point(current.x + x-steps * increment.x, current.y + y-steps * increment.y))

────────────────────
_ do accept-pointer-point
    - point Point
    - phase ValueChangePhase

. plane = plane-rect
. target = point + drag-offset
. current = value-ratio(effective-value)
. x-ratio = if plane.width > 0 then (target.x - plane.x) / plane.width else current.x
. y-ratio = if plane.height > 0 then (target.y - plane.y) / plane.height else current.y
accept-user-value(value-at-ratio(Point(x-ratio, y-ratio)), phase)

────────────────────
_ get effective-value Point

Point(clamped-axis(value.x, minimum.x, maximum.x), clamped-axis(value.y, minimum.y, maximum.y))

────────────────────
_ normalized-value Point
    - candidate Point

Point
    - snapped-axis(candidate.x, minimum.x, maximum.x, step.x)
    - snapped-axis(candidate.y, minimum.y, maximum.y, step.y)

────────────────────
_ value-ratio Point
    - point Point

Point(axis-ratio(point.x, minimum.x, maximum.x), axis-ratio(point.y, minimum.y, maximum.y))

────────────────────
_ value-at-ratio Point
    - ratio Point

Point(minimum.x + ratio.x * (maximum.x - minimum.x), minimum.y + ratio.y * (maximum.y - minimum.y))

────────────────────
_ get small-increment Point

Point(axis-increment(minimum.x, maximum.x, step.x), axis-increment(minimum.y, maximum.y, step.y))

────────────────────
_ get plane-rect

Rect
    - content-bounds.x - bounds.x
    - content-bounds.y - bounds.y
    - content-bounds.width
    - content-bounds.height

────────────────────
_ get thumb-center

thumb.bounds.center - Point(bounds.x, bounds.y)

────────────────────
_ event-target-is-thumb
    - event GUIEvent

|? !hit-thumb
    false
??
    owner as Pointer? == this as Pointer?

.. hit-thumb = event.hit-box?.ancestor-or-self'PlaneSliderThumb
.. owner = hit-thumb.ancestor'PlaneSlider

────────────────────
_ do publish-drag-ended

. current = effective-value
value-changed <- ValueChange'Point(current, current, ValueChangePhase.ended)

