────────────────────

<This
    background = #plane-painter
    <PlaneSliderThumbArea thumb-area • absolute
        anchor = Anchor.parent
        left = PositionOffset.coord(-plane-slider-thumb-radius)
        top = PositionOffset.coord(-plane-slider-thumb-radius)
        right = PositionOffset.coord(-plane-slider-thumb-radius)
        bottom = PositionOffset.coord(-plane-slider-thumb-radius)
        <PlaneSliderThumb thumb • absolute flex-row
            anchor = Anchor.parent
            left = PositionOffset.percent(#render-x)
            top = PositionOffset.percent(#render-y)
            <PlaneSliderThumbEdge • flex:1

    <KeyShortcut "Right"
        key = .arrow-right
        discoverable = false
        action = => do step-values(1, 0)

    <KeyShortcut "Left"
        key = .arrow-left
        discoverable = false
        action = => do step-values(-1, 0)

    <KeyShortcut "Down"
        key = .arrow-down
        discoverable = false
        action = => do step-values(0, 1)

    <KeyShortcut "Up"
        key = .arrow-up
        discoverable = false
        action = => do step-values(0, -1)

    <KeyShortcut "Page Right"
        key = KeyModifier.shift + Key.arrow-right
        discoverable = false
        action = => do step-values(10, 0)

    <KeyShortcut "Page Left"
        key = KeyModifier.shift + Key.arrow-left
        discoverable = false
        action = => do step-values(-10, 0)

    <KeyShortcut "Page Down"
        key = KeyModifier.shift + Key.arrow-down
        discoverable = false
        action = => do step-values(0, 10)

    <KeyShortcut "Page Up"
        key = KeyModifier.shift + Key.arrow-up
        discoverable = false
        action = => do step-values(0, -10)

    <KeyShortcut "Minimum"
        key = .home
        discoverable = false
        action = => do accept-user-value(minimum)

    <KeyShortcut "Maximum"
        key = .end
        discoverable = false
        action = => do accept-user-value(maximum)

────────────────────
_ gesture ~>

~> idle

~> dragging for press on pointer-down when press.button == PointerButton.primary && is-effectively-enabled && !(gesture is .dragging)
    do
        if event-target-is-thumb(press)
            drag-offset = thumb-center - press.point
            accept-user-value(effective-value, ValueChangePhase.began)
        else
            drag-offset = Point(0, 0)
            accept-pointer-point(press.point, ValueChangePhase.began)

    for drag on pointer-drag when drag.pointer-id == press.pointer-id && drag.button == PointerButton.primary
        accept-pointer-point(drag.point, ValueChangePhase.changed)
        drag.cancel()

    then idle for up on pointer-up when up.pointer-id == press.pointer-id && up.button == PointerButton.primary
        do
            accept-pointer-point(up.point, ValueChangePhase.ended)
            up.cancel()

    then awaiting-release(press.pointer-id) on blur
    then awaiting-release(press.pointer-id) on inoperable
    then idle on unmounting
        do publish-drag-ended()

~> awaiting-release(pointer-id)
    do publish-drag-ended()

    for drag on pointer-drag when drag.pointer-id == pointer-id && drag.button == PointerButton.primary
        drag.cancel()

    then idle for up on pointer-up when up.pointer-id == pointer-id && up.button == PointerButton.primary
        do up.cancel()

    then idle on unmounting

────────────────────
for press on pointer-down when press.button != PointerButton.primary || !is-effectively-enabled || gesture is .dragging

press.cancel()

