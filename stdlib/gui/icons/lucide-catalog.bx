(import ./lucide-tags)
(import /math)
(import /stream/sort)
(blank)
(prop + lucide-catalog _ (:= (call lucide-catalog-entries)))

(type + LucideCatalogEntry (is Tuple)
  (prop + name String)
  (prop + tags (list String))
)

(fn-do + lucide-catalog-search (list LucideCatalogEntry)
  (param query String)
  (param limit Size (= 24))
  (let words (call (of List String) (in each (call (. query lowercased split) " ") (when (. each length)))))
  (return-if (call (of List LucideCatalogEntry)) (if (not words)))
  (let matches (call (of List LucideCatalogMatch)))
  (for (in entry lucide-catalog)
    (let score (call lucide-catalog-score entry words))
    (if (> score 0)
      (+= matches (call LucideCatalogMatch entry score))
    )
  )
  (let ordered (call sort matches (:using (=> (a b) (if-expr (or (> (. a score) (. b score)) (and (== (. a score) (. b score)) (< (. a entry name) (. b entry name)))) .lesser .greater)))))
  (return (call (of List LucideCatalogEntry) (in (. each entry) ([] ordered (..< 0 (call min limit (. ordered length)))))))
)

(type _ LucideCatalogMatch (is Tuple)
  (prop + entry LucideCatalogEntry)
  (prop + score Int)
)

(fn-do _ lucide-catalog-score Int
  (param entry LucideCatalogEntry)
  (param words (list String))
  (let total 0)
  (for (in word words)
    (let best (call lucide-word-score entry word))
    (return-if 0 (if (== best 0)))
    (+= total best)
  )
  (return total)
)

(fn-do _ lucide-word-score Int
  (param entry LucideCatalogEntry)
  (param word String)
  (return-if 40 (if (== (. entry name) word)))
  (let best 0)
  (for (in part (call (. entry name split) "-"))
    (if (== part word)
      (= best (call max best 20))
    )
  )
  (if (!= (call (. entry name find) word) null)
    (= best (call max best 8))
  )
  (for (in tag (. entry tags))
    (if (== tag word)
      (= best (call max best 12))
      (else-if (!= (call (. tag find) word) null)
        (= best (call max best 4))
      )
    )
  )
  (return best)
)

(fn-do _ lucide-catalog-entries (list LucideCatalogEntry)
  (let entries (call (of List LucideCatalogEntry)))
  (for (in line (call (. (call lucide-tag-lines) split) "\n"))
    (let bar (call (. line find) "|"))
    (if (== bar null)
      (if (. line length)
        (+= entries (call LucideCatalogEntry line (call (of List String))))
      )
      (else
        (let split (as bar Index))
        (let listed ([] line (..< (+ split 1) (. line size))))
        (+= entries
          (call LucideCatalogEntry
            (block
              (arg ([] line (..< 0 split)))
              (arg (call (of List String) (in each (call (. listed split) ",") (when (. each length)))))
            )
          )
        )
      )
    )
  )
  (return entries)
)
