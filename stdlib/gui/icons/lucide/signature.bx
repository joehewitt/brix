(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-signature
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSignature (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 66 0 21 17 1 18.844 15.132 4 0.5 0.5 0 0 0 18 15.5 1 18 16 4 1 1 0 0 1 17 17 1 15 17 4 1 1 0 0 1 14 16 2 14 13.455 10.009 12.03 5.5 12 4 1 1 0 0 0 5.5 17 2 9.653 17 10.245 5.705 11.208 3.5 4 2.5 2.5 0 1 1 14.518 6.784 0 0 2 6 0 3 21 1 21 21)
)
