(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-grid-2x2-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGridN2x2Plus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 61 0 12 3 1 12 20 4 1 1 0 0 1 11 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 11 4 1 1 0 0 1 20 12 1 3 12 0 0 2 6 0 16 19 1 22 19 0 0 2 6 0 19 22 1 19 16)
)
