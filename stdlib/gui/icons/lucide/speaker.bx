(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-speaker
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSpeaker (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 6 2 1 18 2 4 2 2 0 0 1 20 4 1 20 20 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4 20 1 4 4 4 2 2 0 0 1 6 2 5 0 0 2 6 0 12 6 1 12.01 6 1 0 12 14 4 0 0 2 6 0 12 14 1 12.01 14)
)
