(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mop
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMop (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 34 0 10 22 2 12.761 22 15 20.21 15 18 2 10.58 18 10.92 13 6.5 13 4 1 1 0 1 0 6.5 22 5 4 3 3 0 0 1 7 19 0 0 2 6 0 12.5 11.5 1 22 2 0 0 6 28 0 6.98 13.02 1 9.645 10.356 4 1.21 1.21 0 0 1 11.355 10.356 1 13.645 12.644 4 1.21 1.21 0 0 1 13.645 14.356 1 11.557 16.443)
)
