(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-screen-share
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScreenShare (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 13 3 1 4 3 4 2 2 0 0 0 2 5 1 2 15 4 2 2 0 0 0 4 17 1 20 17 4 2 2 0 0 0 22 15 1 22 12 0 0 2 6 0 8 21 1 16 21 0 0 2 6 0 12 17 1 12 21 0 0 2 6 0 17 8 1 22 3 0 0 3 9 0 17 3 1 22 3 1 22 8)
)
