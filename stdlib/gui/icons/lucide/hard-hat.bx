(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hard-hat
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHardHat (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 10 10 1 10 5 4 1 1 0 0 1 11 4 1 13 4 4 1 1 0 0 1 14 5 1 14 10 0 0 3 14 0 14 6 4 6 6 0 0 1 20 12 1 20 15 0 0 3 14 0 4 15 1 4 12 4 6 6 0 0 1 10 6 0 0 10 48 0 3 15 1 21 15 4 1 1 0 0 1 22 16 1 22 18 4 1 1 0 0 1 21 19 1 3 19 4 1 1 0 0 1 2 18 1 2 16 4 1 1 0 0 1 3 15 5)
)
