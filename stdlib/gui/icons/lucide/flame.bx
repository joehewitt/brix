(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flame
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlame (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 49 0 12 3 3 13 7 16 9.5 3 19 12 19 15 4 1 1 0 0 1 5 15 4 5 5 0 0 1 6 12 4 1 1 0 0 0 11 12 2 11 10 9.5 9 9.5 7 3 9.5 5 12 3)
)
