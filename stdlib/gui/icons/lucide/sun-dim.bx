(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sun-dim
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSunDim (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 4 0 0 2 6 0 12 4 1 12.01 4 0 0 2 6 0 20 12 1 20.01 12 0 0 2 6 0 12 20 1 12.01 20 0 0 2 6 0 4 12 1 4.01 12 0 0 2 6 0 17.657 6.343 1 17.667 6.343 0 0 2 6 0 17.657 17.657 1 17.667 17.657 0 0 2 6 0 6.343 17.657 1 6.353 17.657 0 0 2 6 0 6.343 6.343 1 6.353 6.343)
)
