(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rectangle-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRectangleHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 6 1 20 6 4 2 2 0 0 1 22 8 1 22 16 4 2 2 0 0 1 20 18 1 4 18 4 2 2 0 0 1 2 16 1 2 8 4 2 2 0 0 1 4 6 5)
)
