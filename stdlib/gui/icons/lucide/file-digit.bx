(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-digit
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileDigit (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 47 0 4 12 1 4 4 4 2 2 0 0 1 6 2 1 14 2 4 2.4 2.4 0 0 1 15.706 2.706 1 19.294 6.294 4 2.4 2.4 0 0 1 20 8 1 20 20 4 2 2 0 0 1 18 22 0 0 4 17 0 14 2 1 14 7 4 1 1 0 0 0 15 8 1 20 8 0 0 3 9 0 10 16 1 12 16 1 12 22 0 0 2 6 0 10 22 1 14 22 0 0 10 48 0 4 16 1 4 16 4 2 2 0 0 1 6 18 1 6 20 4 2 2 0 0 1 4 22 1 4 22 4 2 2 0 0 1 2 20 1 2 18 4 2 2 0 0 1 4 16 5)
)
