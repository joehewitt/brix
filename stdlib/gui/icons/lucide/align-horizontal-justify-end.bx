(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-horizontal-justify-end
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignHorizontalJustifyEnd (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 5 1 6 5 4 2 2 0 0 1 8 7 1 8 17 4 2 2 0 0 1 6 19 1 4 19 4 2 2 0 0 1 2 17 1 2 7 4 2 2 0 0 1 4 5 5 0 0 10 48 0 14 7 1 16 7 4 2 2 0 0 1 18 9 1 18 15 4 2 2 0 0 1 16 17 1 14 17 4 2 2 0 0 1 12 15 1 12 9 4 2 2 0 0 1 14 7 5 0 0 2 6 0 22 2 1 22 22)
)
