(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flower-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlowerN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 16 68 0 12 5 4 3 3 0 1 1 15 8 0 12 5 4 3 3 0 1 0 9 8 0 12 5 1 12 6 0 9 8 4 3 3 0 1 0 12 11 0 9 8 1 10 8 0 15 8 4 3 3 0 1 1 12 11 0 15 8 1 14 8 0 12 11 1 12 10 1 0 12 8 2 0 0 2 6 0 12 10 1 12 22 0 0 4 18 0 12 22 2 16.2 22 19 20.333 19 17 2 14.8 17 12 18.667 12 22 5 0 0 4 18 0 12 22 2 7.8 22 5 20.333 5 17 2 9.2 17 12 18.667 12 22 5)
)
