(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-award
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAward (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 15.477 12.89 1 16.992 21.416 4 0.5 0.5 0 0 1 16.182 21.886 1 12.602 19.199 4 1 1 0 0 0 11.405 19.199 1 7.819 21.885 4 0.5 0.5 0 0 1 7.009 21.416 1 8.523 12.89 1 0 12 8 6)
)
