(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-venetian-mask
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVenetianMask (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 10 0 18 11 2 16.5 11 15.5 11.5 15 13 0 0 13 77 0 4 6 4 2 2 0 0 0 2 8 1 2 12 4 5 5 0 0 0 7 17 4 8 8 0 0 1 12 19 4 8 8 0 0 1 17 17 4 5 5 0 0 0 22 12 1 22 8 4 2 2 0 0 0 20 6 1 17 6 4 8 8 0 0 0 12 8 4 8 8 0 0 0 7 6 5 0 0 2 10 0 6 11 2 7.5 11 8.5 11.5 9 13)
)
