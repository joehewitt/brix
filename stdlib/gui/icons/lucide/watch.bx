(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-watch
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWatch (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 12 10 1 12 12.2 1 13.6 13.2 0 0 6 28 0 16.13 7.66 1 15.32 3.61 4 2 2 0 0 0 13.32 2 1 10.64 2 4 2 2 0 0 0 8.64 3.61 1 7.86 7.66 0 0 6 28 0 7.88 16.36 1 8.68 20.36 4 2 2 0 0 0 10.68 21.97 1 13.4 21.97 4 2 2 0 0 0 15.4 20.36 1 16.21 16.31 1 0 12 12 6)
)
