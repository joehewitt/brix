(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ferris-wheel
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFerrisWheel (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 2 0 0 2 6 0 12 2 1 12 6 0 0 2 6 0 6.8 15 1 3.3 17 0 0 2 6 0 20.7 7 1 17.2 9 0 0 2 6 0 6.8 9 1 3.3 7 0 0 2 6 0 20.7 17 1 17.2 15 0 0 3 9 0 9 22 1 12 14 1 15 22 0 0 2 6 0 8 22 1 16 22 0 0 2 11 0 18 18.7 4 9 9 0 1 0 6 18.7)
)
