(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-switch-camera
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSwitchCamera (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 11 19 1 4 19 4 2 2 0 0 1 2 17 1 2 7 4 2 2 0 0 1 4 5 1 9 5 0 0 6 28 0 13 5 1 20 5 4 2 2 0 0 1 22 7 1 22 17 4 2 2 0 0 1 20 19 1 15 19 1 0 12 12 3 0 0 3 9 0 18 22 1 15 19 1 18 16 0 0 3 9 0 6 2 1 9 5 1 6 8)
)
