(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-euro
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEuro (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4 10 1 16 10 0 0 2 6 0 4 14 1 13 14 0 0 5 33 0 19 6 4 7.7 7.7 0 0 0 13.8 4 4 7.9 7.9 0 0 0 6 12 2 6 16.4 9.5 20 13.8 20 2 15.8 20 17.6 19.2 19 18)
)
