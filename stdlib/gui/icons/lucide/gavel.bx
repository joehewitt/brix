(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-gavel
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGavel (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 14 13 1 5.619 21.38 4 1 1 0 0 1 2.618 18.38 1 11.002 9.999 0 0 2 6 0 16 16 1 22 10 0 0 2 6 0 21.5 10.5 1 13.5 2.5 0 0 2 6 0 8 8 1 14 2 0 0 2 6 0 8.5 7.5 1 16.5 15.5)
)
