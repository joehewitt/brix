(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-signpost
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSignpost (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 13 1 12 21 0 0 2 6 0 12 3 1 12 6 0 0 13 67 0 2.354 10.354 4 1.207 1.207 0 0 1 2.354 8.646 1 4.414 6.586 4 2 2 0 0 1 5.828 6 1 18.172 6 4 2 2 0 0 1 19.586 6.586 1 21.646 8.646 4 1.207 1.207 0 0 1 21.646 10.354 1 19.586 12.414 4 2 2 0 0 1 18.172 13 1 5.828 13 4 2 2 0 0 1 4.414 12.414 5)
)
