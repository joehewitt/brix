(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-skip-forward
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSkipForward (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 21 4 1 21 20 0 0 7 34 0 6.029 4.285 4 2 2 0 0 0 3 6 1 3 18 4 2 2 0 0 0 6.029 19.715 1 16.026 13.717 4 2 2 0 0 0 16.029 10.285 5)
)
