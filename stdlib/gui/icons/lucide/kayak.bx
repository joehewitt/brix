(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-kayak
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideKayak (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 23 0 18 17 4 1 1 0 0 0 17 18 1 17 19 4 2 2 0 1 0 19 17 5 0 0 5 33 0 20.97 3.61 4 0.45 0.45 0 0 0 20.39 3.03 2 10.2 6.6 6.6 10.2 3.03 20.39 4 0.45 0.45 0 0 0 3.61 20.97 2 13.8 17.4 17.4 13.8 20.97 3.61 0 0 2 6 0 6.707 6.707 1 17.293 17.293 0 0 5 23 0 7 5 4 2 2 0 1 0 5 7 1 6 7 4 1 1 0 0 0 7 6 5)
)
