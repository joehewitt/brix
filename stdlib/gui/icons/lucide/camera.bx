(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-camera
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCamera (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 17 89 0 13.997 4 4 2 2 0 0 1 15.757 5.05 1 16.243 5.95 4 2 2 0 0 0 18.003 7 1 20 7 4 2 2 0 0 1 22 9 1 22 18 4 2 2 0 0 1 20 20 1 4 20 4 2 2 0 0 1 2 18 1 2 9 4 2 2 0 0 1 4 7 1 5.997 7 4 2 2 0 0 0 7.756 5.952 1 8.245 5.048 4 2 2 0 0 1 10.004 4 5 1 0 12 13 3)
)
