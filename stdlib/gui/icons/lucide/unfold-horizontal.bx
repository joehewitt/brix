(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-unfold-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUnfoldHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 12 1 22 12 0 0 2 6 0 8 12 1 2 12 0 0 2 6 0 12 2 1 12 4 0 0 2 6 0 12 8 1 12 10 0 0 2 6 0 12 14 1 12 16 0 0 2 6 0 12 20 1 12 22 0 0 3 9 0 19 15 1 22 12 1 19 9 0 0 3 9 0 5 9 1 2 12 1 5 15)
)
