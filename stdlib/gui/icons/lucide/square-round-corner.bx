(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-square-round-corner
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquareRoundCorner (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 21 11 4 8 8 0 0 0 13 3 0 0 8 39 0 21 15 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 1 9 3)
)
