(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-scatter-chart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScatterChart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 1 7.5 7.5 0.5 1 1 18.5 5.5 0.5 1 1 11.5 11.5 0.5 1 1 7.5 16.5 0.5 1 1 17.5 14.5 0.5 0 0 4 17 0 3 3 1 3 19 4 2 2 0 0 0 5 21 1 21 21)
)
