(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-paperclip
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePaperclip (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 16 6 1 7.586 14.586 4 2 2 0 0 0 10.415 17.415 1 18.829 8.829 4 4 4 0 1 0 13.172 3.172 1 4.793 11.723 4 6 6 0 1 0 13.278 20.208 1 21.657 11.657)
)
