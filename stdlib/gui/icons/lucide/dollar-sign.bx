(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-dollar-sign
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDollarSign (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 3 0 12 2 12 22 0 0 6 28 0 17 5 1 9.5 5 4 3.5 3.5 0 0 0 9.5 12 1 14.5 12 4 3.5 3.5 0 0 1 14.5 19 1 6 19)
)
