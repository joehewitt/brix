(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sort-desc
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSortDesc (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 3 16 1 7 20 1 11 16 0 0 2 6 0 7 20 1 7 4 0 0 2 6 0 11 4 1 21 4 0 0 2 6 0 11 8 1 18 8 0 0 2 6 0 11 12 1 15 12)
)
