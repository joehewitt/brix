(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-between-horizonal-end
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBetweenHorizonalEnd (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 3 1 15 3 4 1 1 0 0 1 16 4 1 16 9 4 1 1 0 0 1 15 10 1 4 10 4 1 1 0 0 1 3 9 1 3 4 4 1 1 0 0 1 4 3 5 0 0 3 9 0 22 15 1 19 12 1 22 9 0 0 10 48 0 4 14 1 15 14 4 1 1 0 0 1 16 15 1 16 20 4 1 1 0 0 1 15 21 1 4 21 4 1 1 0 0 1 3 20 1 3 15 4 1 1 0 0 1 4 14 5)
)
