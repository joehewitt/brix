(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wallet
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWallet (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 14 72 0 19 7 1 19 4 4 1 1 0 0 0 18 3 1 5 3 4 2 2 0 0 0 5 7 1 20 7 4 1 1 0 0 1 21 8 1 21 12 1 18 12 4 2 2 0 0 0 18 16 1 21 16 4 1 1 0 0 0 22 15 1 22 13 4 1 1 0 0 0 21 12 0 0 6 28 0 3 5 1 3 19 4 2 2 0 0 0 5 21 1 20 21 4 1 1 0 0 0 21 20 1 21 16)
)
