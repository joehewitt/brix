(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ear-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEarOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 18 0 6 18.5 4 3.5 3.5 0 1 0 13 18.5 2 13 16.93 13.92 15.98 15.04 15.04 0 0 2 10 0 6 8.5 2 6 7.75 6.13 7.03 6.36 6.36 0 0 3 18 0 8.8 3.15 4 6.5 6.5 0 0 1 19 8.5 2 19 10.13 18.56 11.31 17.91 12.26 0 0 4 22 0 12.5 6 4 2.5 2.5 0 0 1 15 8.5 0 10 13 4 2 2 0 0 0 11.82 11.82 3 0 2 2 22 22)
)
