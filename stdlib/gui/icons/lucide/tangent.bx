(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tangent
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTangent (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 17 4 2 0 0 2 6 0 15.59 5.41 1 5.41 15.59 1 0 4 17 2 0 0 3 17 0 12 22 2 12 22 8 13 10.5 10.5 2 13 8 22 12 22 12)
)
