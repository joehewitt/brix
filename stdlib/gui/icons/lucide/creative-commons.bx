(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-creative-commons
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCreativeCommons (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 10 0 0 4 27 0 10 9.3 4 2.8 2.8 0 0 0 6.5 10.3 4 3.1 3.1 0 0 0 6.5 13.7 4 2.7 2.7 0 0 0 10 14.7 0 0 4 27 0 17 9.3 4 2.8 2.8 0 0 0 13.5 10.3 4 3.1 3.1 0 0 0 13.5 13.7 4 2.7 2.7 0 0 0 17 14.7)
)
