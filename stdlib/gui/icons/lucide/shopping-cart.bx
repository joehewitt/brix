(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shopping-cart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShoppingCart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 8 21 1 1 0 19 21 1 0 0 8 34 0 2.05 2.05 1 4.05 2.05 1 6.71 14.47 4 2 2 0 0 0 8.71 16.05 1 18.49 16.05 4 2 2 0 0 0 20.44 14.48 1 22.09 7.05 1 5.12 7.05)
)
