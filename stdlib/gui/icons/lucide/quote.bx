(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-quote
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideQuote (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 14 80 0 16 3 4 2 2 0 0 0 14 5 1 14 11 4 2 2 0 0 0 16 13 4 1 1 0 0 1 17 14 1 17 15 4 2 2 0 0 1 15 17 4 1 1 0 0 0 14 18 1 14 20 4 1 1 0 0 0 15 21 4 6 6 0 0 0 21 15 1 21 5 4 2 2 0 0 0 19 3 5 0 0 14 80 0 5 3 4 2 2 0 0 0 3 5 1 3 11 4 2 2 0 0 0 5 13 4 1 1 0 0 1 6 14 1 6 15 4 2 2 0 0 1 4 17 4 1 1 0 0 0 3 18 1 3 20 4 1 1 0 0 0 4 21 4 6 6 0 0 0 10 15 1 10 5 4 2 2 0 0 0 8 3 5)
)
