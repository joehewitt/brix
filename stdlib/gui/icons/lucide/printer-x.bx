(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-printer-x
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePrinterX (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 12.531 22 1 7 22 4 1 1 0 0 1 6 21 1 6 15 4 1 1 0 0 1 7 14 1 13.377 14 0 0 2 6 0 16.5 16.5 1 21.5 21.5 0 0 2 6 0 16.5 21.5 1 21.5 16.5 0 0 8 39 0 6 18 1 4 18 4 2 2 0 0 1 2 16 1 2 11 4 2 2 0 0 1 4 9 1 20 9 4 2 2 0 0 1 22 11 1 22 12.5 0 0 6 28 0 6 9 1 6 3 4 1 1 0 0 1 7 2 1 17 2 4 1 1 0 0 1 18 3 1 18 9)
)
