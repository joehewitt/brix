(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tent
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTent (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 3.5 21 1 14 3 0 0 2 6 0 20.5 21 1 10 3 0 0 3 9 0 15.5 21 1 12 15 1 8.5 21 0 0 2 6 0 2 21 1 22 21)
)
