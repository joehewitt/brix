(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-git-merge-conflict
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGitMergeConflict (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 12 6 1 16 6 4 2 2 0 0 1 18 8 1 18 15 0 0 2 6 0 6 12 1 6 21 0 0 2 6 0 9 3 1 3 9 0 0 2 6 0 9 9 1 3 3 1 0 18 18 3)
)
