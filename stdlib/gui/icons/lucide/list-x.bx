(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-list-x
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideListX (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 5 1 3 5 0 0 2 6 0 11 12 1 3 12 0 0 2 6 0 16 19 1 3 19 0 0 2 6 0 15.5 9.5 1 20.5 14.5 0 0 2 6 0 20.5 9.5 1 15.5 14.5)
)
