(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-route
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRoute (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 6 19 3 0 0 6 28 0 9 19 1 17.5 19 4 3.5 3.5 0 0 0 17.5 12 1 6.5 12 4 3.5 3.5 0 0 1 6.5 5 1 15 5 1 0 18 5 3)
)
