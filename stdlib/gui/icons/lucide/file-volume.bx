(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-volume
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileVolume (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 4 11.55 1 4 4 4 2 2 0 0 1 6 2 1 14 2 4 2.4 2.4 0 0 1 15.706 2.706 1 19.294 6.294 4 2.4 2.4 0 0 1 20 8 1 20 20 4 2 2 0 0 1 18 22 1 16.05 22 0 0 4 17 0 14 2 1 14 7 4 1 1 0 0 0 15 8 1 20 8 0 0 2 11 0 12 15 4 5 5 0 0 1 12 21 0 0 13 67 0 8 14.502 4 0.5 0.5 0 0 0 7.174 14.121 1 5.281 15.752 4 1 1 0 0 1 4.63 15.995 1 3.5 15.995 4 0.5 0.5 0 0 0 3 16.496 1 3 19.502 4 0.5 0.5 0 0 0 3.5 20.003 1 4.629 20.003 4 1 1 0 0 1 5.281 20.246 1 7.174 21.879 4 0.5 0.5 0 0 0 8 21.499 5)
)
