(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-usb-c-port
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUsbCPort (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 6 12 1 18 12 0 0 10 48 0 6 8 1 18 8 4 4 4 0 0 1 22 12 1 22 12 4 4 4 0 0 1 18 16 1 6 16 4 4 4 0 0 1 2 12 1 2 12 4 4 4 0 0 1 6 8 5)
)
