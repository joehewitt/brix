(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tag
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTag (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 12.586 2.586 4 2 2 0 0 0 11.172 2 1 4 2 4 2 2 0 0 0 2 4 1 2 11.172 4 2 2 0 0 0 2.586 12.586 1 11.29 21.29 4 2.426 2.426 0 0 0 14.71 21.29 1 21.29 14.71 4 2.426 2.426 0 0 0 21.29 11.29 5 1 1 7.5 7.5 0.5)
)
