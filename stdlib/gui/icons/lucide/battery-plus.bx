(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-battery-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBatteryPlus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 9 1 10 15 0 0 6 28 0 12.543 6 1 16 6 4 2 2 0 0 1 18 8 1 18 16 4 2 2 0 0 1 16 18 1 12.395 18 0 0 2 6 0 22 14 1 22 10 0 0 2 6 0 7 12 1 13 12 0 0 6 28 0 7.606 18 1 4 18 4 2 2 0 0 1 2 16 1 2 8 4 2 2 0 0 1 4 6 1 7.606 6)
)
