(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-a-arrow-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAArrowDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 14 12 1 18 16 1 22 12 0 0 2 6 0 18 16 1 18 7 0 0 4 17 0 2 16 1 6.039 6.31 4 0.5 0.5 0 0 1 6.962 6.31 1 11 16 0 0 2 6 0 3.304 13 1 9.696 13)
)
