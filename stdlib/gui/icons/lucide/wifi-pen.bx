(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wifi-pen
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWifiPen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 2 8.82 4 15 15 0 0 1 22 8.82 0 0 9 45 0 21.378 16.626 4 1 1 0 0 0 18.374 13.622 1 14.364 17.634 4 2 2 0 0 0 13.858 18.488 1 13.021 21.358 4 0.5 0.5 0 0 0 13.641 21.978 1 16.511 21.141 4 2 2 0 0 0 17.365 20.635 5 0 0 2 11 0 5 12.859 4 10 10 0 0 1 15.5 10.637 0 0 2 11 0 8.5 16.429 4 5 5 0 0 1 11.5 15.023)
)
