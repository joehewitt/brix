(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-droplet
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDroplet (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 48 0 12 22 4 7 7 0 0 0 19 15 2 19 13 18 11.1 16 9.5 2 14 7.9 12.5 5.5 12 3 2 11.5 5.5 10 7.9 8 9.5 2 6 11.1 5 13 5 15 4 7 7 0 0 0 12 22 5)
)
