(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-candy-cane
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCandyCane (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10.8 5 1 12.911 9.223 0 0 2 6 0 17.75 7 1 15 2.1 0 0 2 6 0 4.874 14.647 1 6.994 18.887 0 0 7 39 0 5.7 21 4 2 2 0 0 1 2.2 19 1 10.8 5 4 6 6 0 0 1 21.2 11 4 2 2 0 1 1 17.736 9 4 2 2 0 1 0 14.272 7 5 0 0 2 6 0 7.906 9.712 1 9.911 14.123)
)
