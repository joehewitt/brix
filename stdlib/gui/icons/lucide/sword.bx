(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sword
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSword (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 19 1 5 13 0 0 2 6 0 5 21 1 3 19 0 0 2 6 0 8 16 1 4 20 0 0 5 15 0 9.5 17.5 1 21 6 1 21 3 1 18 3 1 6.5 14.5)
)
