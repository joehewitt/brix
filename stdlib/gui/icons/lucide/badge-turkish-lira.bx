(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-badge-turkish-lira
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBadgeTurkishLira (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 11 7 1 11 17 4 5 5 0 0 0 16 12 0 0 2 6 0 15 8 1 9 11 0 0 9 67 0 3.85 8.62 4 4 4 0 0 1 8.63 3.85 4 4 4 0 0 1 15.37 3.85 4 4 4 0 0 1 20.15 8.63 4 4 4 0 0 1 20.15 15.37 4 4 4 0 0 1 15.38 20.15 4 4 4 0 0 1 8.63 20.15 4 4 4 0 0 1 3.85 15.38 4 4 4 0 0 1 3.85 8.62)
)
