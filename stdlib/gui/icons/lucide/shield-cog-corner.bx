(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shield-cog-corner
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShieldCogCorner (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 54 0 11 22 2 7.194 20.55 4 18.034 4 13 1 4 6 4 1 1 0 0 1 5 5 2 7 5 9.5 3.8 11.24 2.28 4 1.17 1.17 0 0 1 12.76 2.28 2 14.51 3.81 17 5 19 5 4 1 1 0 0 1 20 6 1 20 10 0 0 2 6 0 14.923 16.547 1 14 16.164 0 0 2 6 0 14.923 18.843 1 14 19.226 0 0 2 6 0 16.547 14.923 1 16.164 14 0 0 2 6 0 16.547 20.467 1 16.164 21.391 0 0 2 6 0 18.843 14.923 1 19.226 14 0 0 2 6 0 19.225 21.391 1 18.843 20.467 0 0 2 6 0 20.467 16.547 1 21.39 16.164 0 0 2 6 0 20.467 18.843 1 21.39 19.226 1 0 17.695 17.695 3)
)
