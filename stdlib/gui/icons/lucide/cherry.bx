(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cherry
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCherry (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 26 0 2 17 4 5 5 0 0 0 12 17 2 12 14.24 9.5 12 7 14 2 4.5 12 2 14.24 2 17 5 0 0 5 26 0 12 17 4 5 5 0 0 0 22 17 2 22 14.24 19.5 12 17 14 2 14.5 12 12 14.24 12 17 5 0 0 3 17 0 7 14 2 10.22 11.09 11.29 5.25 12 2 2 13.66 4.38 16.94 11 17 14 0 0 4 18 0 22 9 2 17.71 9 14.86 6.67 12 2 2 17.71 2 22 6.67 22 9 5)
)
