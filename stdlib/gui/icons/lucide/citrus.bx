(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-citrus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCitrus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 28 0 21.66 17.67 4 1.08 1.08 0 0 1 21.62 19.27 4 12 12 0 0 1 4.73 2.38 4 1.1 1.1 0 0 1 6.34 2.34 5 0 0 2 11 0 19.65 15.66 4 8 8 0 0 1 8.35 4.34 0 0 2 6 0 14 10 1 8.5 15.5 0 0 3 9 0 14 17.85 1 14 10 1 6.15 10)
)
