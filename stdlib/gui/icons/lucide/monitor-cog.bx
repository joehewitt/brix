(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-monitor-cog
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMonitorCog (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 17 1 12 21 0 0 2 6 0 14.305 7.53 1 15.228 7.148 0 0 2 6 0 15.228 4.852 1 14.305 4.469 0 0 2 6 0 16.852 3.228 1 16.469 2.304 0 0 2 6 0 16.852 8.772 1 16.469 9.695 0 0 2 6 0 19.148 3.228 1 19.531 2.304 0 0 2 6 0 19.53 9.696 1 19.148 8.772 0 0 2 6 0 20.772 4.852 1 21.696 4.469 0 0 2 6 0 20.772 7.148 1 21.696 7.531 0 0 8 39 0 22 13 1 22 15 4 2 2 0 0 1 20 17 1 4 17 4 2 2 0 0 1 2 15 1 2 5 4 2 2 0 0 1 4 3 1 11 3 0 0 2 6 0 8 21 1 16 21 1 0 18 6 3)
)
