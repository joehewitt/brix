(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-remove-formatting
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRemoveFormatting (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 12 0 4 7 1 4 4 1 20 4 1 20 7 0 0 2 6 0 5 20 1 11 20 0 0 2 6 0 13 4 1 8 20 0 0 2 6 0 15 15 1 20 20 0 0 2 6 0 20 15 1 15 20)
)
