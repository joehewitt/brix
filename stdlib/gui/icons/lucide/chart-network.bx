(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chart-network
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChartNetwork (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 13.11 7.664 1 14.89 10.336 0 0 2 6 0 14.162 12.788 1 10.838 14.212 0 0 2 6 0 20 4 1 13.94 5.515 0 0 4 17 0 3 3 1 3 19 4 2 2 0 0 0 5 21 1 21 21 1 0 12 6 2 1 0 16 12 2 1 0 9 15 2)
)
