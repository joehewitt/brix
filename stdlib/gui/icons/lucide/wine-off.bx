(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wine-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWineOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 8 22 1 16 22 0 0 4 12 0 7 10 1 10 10 0 17 10 1 15.657 10 0 0 2 6 0 12 15 1 12 22 0 0 8 46 0 7.307 7.307 4 12.33 12.33 0 0 0 7 10 4 5 5 0 0 0 14.391 14.391 0 8.638 2.981 2 8.75 2.668 8.872 2.34 9 2 1 15 2 2 16.5 6 17 8 17 10 2 17 10.407 16.95 10.809 16.855 11.198 3 0 2 2 22 22)
)
