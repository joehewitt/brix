(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-paint-roller
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePaintRoller (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 2 1 16 2 4 2 2 0 0 1 18 4 1 18 6 4 2 2 0 0 1 16 8 1 4 8 4 2 2 0 0 1 2 6 1 2 4 4 2 2 0 0 1 4 2 5 0 0 8 39 0 10 16 1 10 14 4 2 2 0 0 1 12 12 1 20 12 4 2 2 0 0 0 22 10 1 22 7 4 2 2 0 0 0 20 5 1 18 5 0 0 10 48 0 9 16 1 11 16 4 1 1 0 0 1 12 17 1 12 21 4 1 1 0 0 1 11 22 1 9 22 4 1 1 0 0 1 8 21 1 8 17 4 1 1 0 0 1 9 16 5)
)
