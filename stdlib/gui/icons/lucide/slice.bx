(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-slice
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSlice (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 42 0 11 16.586 1 11 19 4 1 1 0 0 1 10 20 1 2 20 1 18.37 3.63 4 1 1 0 1 1 21.37 6.63 1 11.707 16.293 4 1 1 0 0 1 10.293 16.293 1 8 14)
)
