(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-indian-rupee
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideIndianRupee (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 6 3 1 18 3 0 0 2 6 0 6 8 1 18 8 0 0 2 6 0 6 13 1 14.5 21 0 0 2 6 0 6 13 1 9 13 0 0 2 10 0 9 13 2 15.667 13 15.667 3 9 3)
)
