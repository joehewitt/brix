(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-arrow-down-1-0
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArrowDownN1N0 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 3 16 1 7 20 1 11 16 0 0 2 6 0 7 20 1 7 4 0 0 3 9 0 17 10 1 17 4 1 15 4 0 0 2 6 0 15 10 1 19 10 0 0 10 48 0 17 14 1 17 14 4 2 2 0 0 1 19 16 1 19 18 4 2 2 0 0 1 17 20 1 17 20 4 2 2 0 0 1 15 18 1 15 16 4 2 2 0 0 1 17 14 5)
)
