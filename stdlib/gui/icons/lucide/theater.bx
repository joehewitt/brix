(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-theater
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTheater (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 10 0 2 10 2 2 10 5 7 5 2 0 0 2 10 0 22 10 2 22 10 19 7 19 2 0 0 2 10 0 10 2 2 10 6.4 6.4 10 2 10 0 0 2 10 0 14 2 2 14 6.4 17.6 10 22 10 0 0 2 10 0 2 10 2 2 10 4 12 4 15 0 0 2 10 0 22 10 2 22 10 20 12 20 15 0 0 2 6 0 8 15 1 16 15 0 0 6 28 0 2 22 1 2 21 4 2 2 0 0 1 4 19 1 8 19 4 2 2 0 0 1 10 21 1 10 22 0 0 6 28 0 14 22 1 14 21 4 2 2 0 0 1 16 19 1 20 19 4 2 2 0 0 1 22 21 1 22 22)
)
