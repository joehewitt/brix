(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-truck-electric
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTruckElectric (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 14 19 1 14 7 4 2 2 0 0 0 12 5 1 9 5 0 0 2 6 0 15 19 1 9 19 0 0 8 39 0 19 19 1 21 19 4 1 1 0 0 0 22 18 1 22 14.35 4 1 1 0 0 0 21.78 13.73 1 18.3 9.38 4 1 1 0 0 0 17.52 9 1 14 9 0 0 4 17 0 2 13 1 2 18 4 1 1 0 0 0 3 19 1 5 19 0 0 6 28 0 4 3 1 2.15 5.15 4 0.495 0.495 0 0 0 2.5 6.01 1 4.65 6.01 4 0.47 0.47 0 0 1 5 6.87 1 3 9.02 1 0 17 19 2 1 0 7 19 2)
)
