(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-edit
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileEdit (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 12.659 22 1 18 22 4 2 2 0 0 0 20 20 1 20 8 4 2.4 2.4 0 0 0 19.294 6.294 1 15.706 2.706 4 2.4 2.4 0 0 0 14 2 1 6 2 4 2 2 0 0 0 4 4 1 4 13.34 0 0 4 17 0 14 2 1 14 7 4 1 1 0 0 0 15 8 1 20 8 0 0 9 45 0 10.378 12.622 4 1 1 0 0 1 13.378 15.625 1 8.36 20.637 4 2 2 0 0 1 7.506 21.143 1 4.639 21.98 4 0.5 0.5 0 0 1 4.019 21.36 1 4.855 18.491 4 2 2 0 0 1 5.361 17.638 5)
)
