(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cross
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCross (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 25 133 0 4 9 4 2 2 0 0 0 2 11 1 2 13 4 2 2 0 0 0 4 15 1 8 15 4 1 1 0 0 1 9 16 1 9 20 4 2 2 0 0 0 11 22 1 13 22 4 2 2 0 0 0 15 20 1 15 16 4 1 1 0 0 1 16 15 1 20 15 4 2 2 0 0 0 22 13 1 22 11 4 2 2 0 0 0 20 9 1 16 9 4 1 1 0 0 1 15 8 1 15 4 4 2 2 0 0 0 13 2 1 11 2 4 2 2 0 0 0 9 4 1 9 8 4 1 1 0 0 1 8 9 5)
)
