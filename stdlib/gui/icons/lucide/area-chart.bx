(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-area-chart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAreaChart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 3 3 1 3 19 4 2 2 0 0 0 5 21 1 21 21 0 0 13 67 0 7 11.207 4 0.5 0.5 0 0 1 7.146 10.854 1 9.146 8.854 4 0.5 0.5 0 0 1 9.854 8.854 1 13.146 12.146 4 0.5 0.5 0 0 0 13.854 12.146 1 18.146 7.854 4 0.5 0.5 0 0 1 19 8.207 1 19 16 4 1 1 0 0 1 18 17 1 8 17 4 1 1 0 0 1 7 16 5)
)
