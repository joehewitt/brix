(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cake
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCake (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 20 21 1 20 13 4 2 2 0 0 0 18 11 1 6 11 4 2 2 0 0 0 4 13 1 4 21 0 0 6 38 0 4 16 2 4 16 4.5 15 6 15 2 7.5 15 8.5 17 10 17 2 11.5 17 12.5 15 14 15 2 15.5 15 16.5 17 18 17 2 19.5 17 20 16 20 16 0 0 2 6 0 2 21 1 22 21 0 0 2 6 0 7 8 1 7 11 0 0 2 6 0 12 8 1 12 11 0 0 2 6 0 17 8 1 17 11 0 0 2 6 0 7 4 1 7.01 4 0 0 2 6 0 12 4 1 12.01 4 0 0 2 6 0 17 4 1 17.01 4)
)
