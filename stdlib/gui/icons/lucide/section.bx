(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-section
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSection (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 26 0 16 5 4 4 3 0 0 0 8 5 2 8 9 16 8 16 12 4 4 3 0 0 1 8 12 0 0 4 26 0 8 19 4 4 3 0 0 0 16 19 2 16 15 8 16 8 12 4 4 3 0 0 1 16 12)
)
