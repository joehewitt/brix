(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pencil-sparkles
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePencilSparkles (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 3 1 8 3 0 0 2 6 0 15.007 5.008 1 18.994 8.994 0 0 2 6 0 20 15 1 20 19 0 0 9 45 0 21.174 6.813 4 2.82 2.82 0 0 0 17.188 2.826 1 3.842 16.175 4 2 2 0 0 0 3.342 17.005 1 2.021 21.357 4 0.5 0.5 0 0 0 2.644 21.979 1 6.997 20.659 4 2 2 0 0 0 7.827 20.162 5 0 0 2 6 0 22 17 1 18 17 0 0 2 6 0 4 5 1 4 9 0 0 2 6 0 6 7 1 2 7 0 0 2 6 0 9 2 1 9 4)
)
