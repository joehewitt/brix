(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sticky-note-x
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStickyNoteX (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 15 3 1 15 8 4 1 1 0 0 0 16 9 1 21 9 0 0 2 6 0 16 16 1 21 21 0 0 10 50 0 21 12 1 21 9 4 2.4 2.4 0 0 0 20.294 7.294 1 16.706 3.706 4 2.4 2.4 0 0 0 15 3 1 5 3 4 2 2 0 0 0 3 5 1 3 19 4 2 2 0 0 0 5 21 1 12 21 0 0 2 6 0 21 16 1 16 21)
)
