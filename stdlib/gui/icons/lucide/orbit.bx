(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-orbit
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideOrbit (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 20.341 6.484 4 10 10 0 0 1 10.266 21.85 0 0 2 11 0 3.659 17.516 4 10 10 0 0 1 13.74 2.152 1 0 12 12 3 1 0 19 5 2 1 0 5 19 2)
)
