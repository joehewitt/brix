(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-form
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideForm (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4 14 1 10 14 0 0 2 6 0 4 2 1 14 2 0 0 10 48 0 5 18 1 19 18 4 1 1 0 0 1 20 19 1 20 21 4 1 1 0 0 1 19 22 1 5 22 4 1 1 0 0 1 4 21 1 4 19 4 1 1 0 0 1 5 18 5 0 0 10 48 0 5 6 1 19 6 4 1 1 0 0 1 20 7 1 20 9 4 1 1 0 0 1 19 10 1 5 10 4 1 1 0 0 1 4 9 1 4 7 4 1 1 0 0 1 5 6 5)
)
