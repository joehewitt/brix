(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chess-bishop
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChessBishop (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 5 20 4 2 2 0 0 1 7 18 1 17 18 4 2 2 0 0 1 19 20 1 19 21 4 1 1 0 0 1 18 22 1 6 22 4 1 1 0 0 1 5 21 5 0 0 5 31 0 15 18 2 16.5 17.385 18 15.539 18 13.077 2 18 8.769 14.5 4.462 12 2 2 9.5 4.462 6 8.77 6 13.077 2 6 15.539 7.5 17.385 9 18 0 0 2 6 0 16 7 1 13.5 9.5 0 0 2 6 0 9 2 1 15 2)
)
