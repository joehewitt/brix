(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-home
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHome (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 15 21 1 15 13 4 1 1 0 0 0 14 12 1 10 12 4 1 1 0 0 0 9 13 1 9 21 0 0 11 56 0 3 10 4 2 2 0 0 1 3.709 8.472 1 10.709 2.472 4 2 2 0 0 1 13.291 2.472 1 20.291 8.472 4 2 2 0 0 1 21 10 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 5)
)
