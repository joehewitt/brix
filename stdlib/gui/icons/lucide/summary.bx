(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-summary
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSummary (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 4 1 7 4 0 0 3 9 0 18 16 1 21 19 1 18 22 0 0 4 17 0 3 4 1 3 17 4 2 2 0 0 0 5 19 1 21 19 0 0 2 6 0 7 14 1 14 14 0 0 2 6 0 7 9 1 19 9)
)
