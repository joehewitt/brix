(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-vector-square
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVectorSquare (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 19.5 7 4 24 24 0 0 1 19.5 17 0 0 2 11 0 4.5 7 4 24 24 0 0 0 4.5 17 0 0 2 11 0 7 19.5 4 24 24 0 0 0 17 19.5 0 0 2 11 0 7 4.5 4 24 24 0 0 1 17 4.5 0 0 10 48 0 18 17 1 21 17 4 1 1 0 0 1 22 18 1 22 21 4 1 1 0 0 1 21 22 1 18 22 4 1 1 0 0 1 17 21 1 17 18 4 1 1 0 0 1 18 17 5 0 0 10 48 0 18 2 1 21 2 4 1 1 0 0 1 22 3 1 22 6 4 1 1 0 0 1 21 7 1 18 7 4 1 1 0 0 1 17 6 1 17 3 4 1 1 0 0 1 18 2 5 0 0 10 48 0 3 17 1 6 17 4 1 1 0 0 1 7 18 1 7 21 4 1 1 0 0 1 6 22 1 3 22 4 1 1 0 0 1 2 21 1 2 18 4 1 1 0 0 1 3 17 5 0 0 10 48 0 3 2 1 6 2 4 1 1 0 0 1 7 3 1 7 6 4 1 1 0 0 1 6 7 1 3 7 4 1 1 0 0 1 2 6 1 2 3 4 1 1 0 0 1 3 2 5)
)
