(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-loader
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLoader (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 2 1 12 6 0 0 2 6 0 16.2 7.8 1 19.1 4.9 0 0 2 6 0 18 12 1 22 12 0 0 2 6 0 16.2 16.2 1 19.1 19.1 0 0 2 6 0 12 18 1 12 22 0 0 2 6 0 4.9 19.1 1 7.8 16.2 0 0 2 6 0 2 12 1 6 12 0 0 2 6 0 4.9 4.9 1 7.8 7.8)
)
