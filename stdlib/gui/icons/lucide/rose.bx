(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rose
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRose (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 17 10 1 16 10 4 4 4 0 1 1 20 6 1 20 6.534 0 0 6 28 0 17 6 1 18 6 4 4 4 0 0 1 19.42 13.74 1 17.13 14.61 4 6 6 0 0 1 11.791 3.93 1 13.86 2.62 0 0 5 31 0 4.5 17 2 7.3 16.5 8.9 17 10 17.8 2 11.1 18.6 11.8 20 12.3 21.5 2 10.3 21.9 8.8 21.9 7.5 21.2 2 6.3 20.6 5.2 19.3 4.5 17 0 0 2 10 0 9.77 12 2 4 15 2 22 2 22 1 0 17 8 2)
)
