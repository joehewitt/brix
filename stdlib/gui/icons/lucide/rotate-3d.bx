(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rotate-3d
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRotateN3d (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 15.194 13.707 1 19.008 15.567 1 17.148 19.381 0 0 2 11 0 16.47214 7.52786 4 5 10 0 1 0 13 21.79796 0 0 2 11 0 21.79796 11 4 10 5 0 1 0 19 15.57071)
)
