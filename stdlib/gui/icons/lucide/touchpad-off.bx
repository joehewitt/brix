(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-touchpad-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTouchpadOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 20 1 12 14 0 0 2 6 0 19.656 14 1 22 14 0 0 2 6 0 2 14 1 14 14 0 0 2 6 0 2 2 1 22 22 0 0 5 25 0 20 20 1 4 20 4 2 2 0 0 1 2 18 1 2 6 4 2 2 0 0 1 4 4 0 0 4 17 0 9.656 4 1 20 4 4 2 2 0 0 1 22 6 1 22 16.344)
)
