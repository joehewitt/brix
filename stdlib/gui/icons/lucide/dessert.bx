(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-dessert
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDessert (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 71 0 10.162 3.167 4 10 10 0 0 0 2 13 4 2 2 0 0 0 6 13 1 6 12 4 2 2 0 0 1 10 12 1 10 16 4 2 2 0 0 0 14 16 1 14 12 4 2 2 0 0 1 18 12 1 18 13 4 2 2 0 0 0 22 12.994 4 10 10 0 0 0 13.839 3.168 0 0 2 11 0 20.804 14.869 4 9 9 0 0 1 3.196 14.869 1 0 12 4 2)
)
