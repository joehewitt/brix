(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sun-snow
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSunSnow (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 21 1 10 20 0 0 2 6 0 10 4 1 10 3 0 0 2 11 0 10 9 4 3 3 0 0 0 10 15 0 0 3 9 0 14 20 1 15.25 17.5 1 18 18 0 0 3 9 0 14 4 1 15.25 6.5 1 18 6 0 0 4 12 0 17 21 1 14 15 1 15.5 12 1 22 12 0 0 3 9 0 17 3 1 14 9 1 15.5 12 0 0 2 6 0 2 12 1 3 12 0 0 3 9 0 20 10 1 18.5 12 1 20 14 0 0 2 6 0 3.64 18.36 1 4.34 17.66 0 0 2 6 0 4.34 6.34 1 3.64 5.64)
)
