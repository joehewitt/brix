(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-command
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCommand (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 47 0 15 6 1 15 18 4 3 3 0 1 0 18 15 1 6 15 4 3 3 0 1 0 9 18 1 9 6 4 3 3 0 1 0 6 9 1 18 9 4 3 3 0 1 0 15 6)
)
