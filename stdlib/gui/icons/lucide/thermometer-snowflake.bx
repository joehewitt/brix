(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-thermometer-snowflake
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideThermometerSnowflake (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 10 20 1 8.75 17.5 1 6 18 0 0 3 9 0 10 4 1 8.75 6.5 1 6 6 0 0 2 6 0 10.585 15 1 10 15 0 0 3 9 0 2 12 1 8.5 12 1 10 9 0 0 5 23 0 20 14.54 4 4 4 0 1 1 16 14.54 1 16 4 4 2 2 0 0 1 20 4 5 0 0 3 9 0 4 10 1 5.5 12 1 4 14 0 0 3 9 0 7 21 1 10 15 1 8.5 12 0 0 3 9 0 7 3 1 10 9 1 12 9)
)
