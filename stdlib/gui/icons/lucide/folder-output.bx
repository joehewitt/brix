(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-folder-output
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFolderOutput (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 69 0 2 7.5 1 2 5 4 2 2 0 0 1 4 3 1 7.9 3 4 2 2 0 0 1 9.59 3.9 1 10.4 5.1 4 2 2 0 0 0 12.07 6 1 20 6 4 2 2 0 0 1 22 8 1 22 18 4 2 2 0 0 1 20 20 1 4 20 4 2 2 0 0 1 2 18.5 0 0 2 6 0 2 13 1 12 13 0 0 3 9 0 5 10 1 2 13 1 5 16)
)
