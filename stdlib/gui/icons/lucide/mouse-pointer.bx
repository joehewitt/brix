(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mouse-pointer
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMousePointer (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12.586 12.586 1 19 19 0 0 9 45 0 3.688 3.037 4 0.497 0.497 0 0 0 3.037 3.688 1 9.537 19.687 4 0.501 0.501 0 0 0 10.484 19.625 1 12.053 13.542 4 2 2 0 0 1 13.501 12.063 1 19.625 10.484 4 0.5 0.5 0 0 0 19.688 9.537 5)
)
