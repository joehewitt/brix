(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-georgian-lari
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGeorgianLari (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 11.5 21 4 7.5 7.5 0 1 1 18.85 12 0 0 2 6 0 13 12 1 13 3 0 0 2 6 0 4 21 1 20 21 0 0 2 6 0 9 12 1 9 3)
)
