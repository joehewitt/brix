(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-feather
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFeather (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 37 0 14.086 18.412 4 2 2 0 0 1 12.67 19 1 5 19 1 5 11.328 4 2 2 0 0 1 5.586 9.914 1 11.75 3.75 4 6 6 0 1 1 20.24 12.24 5 0 0 2 6 0 16 8 1 2 22 0 0 2 6 0 17.488 15 1 9 15)
)
