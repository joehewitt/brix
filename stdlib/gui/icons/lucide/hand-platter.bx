(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hand-platter
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHandPlatter (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 3 1 12 2 0 0 10 48 0 15.4 17.4 1 18.6 14.6 4 2 2 0 1 1 21.4 17.5 1 17.8 20.8 2 17.1 21.6 16.1 22 15 22 1 11 22 2 9.9 22 8.9 21.6 8.2 20.8 1 6.898 19.336 4 1 1 0 0 0 6.151 19 1 5 19 0 0 4 17 0 2 14 1 14 14 4 2 2 0 0 1 14 18 1 12 18 0 0 2 6 0 4 10 1 20 10 0 0 2 11 0 5 10 4 7 7 0 0 1 19 10 0 0 4 17 0 5 14 1 5 20 4 1 1 0 0 1 4 21 1 2 21)
)
