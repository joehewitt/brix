(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zodiac-libra
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZodiacLibra (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 31 0 3 16 1 9.857 16 2 10.019 15.988 10.047 15.677 9.895 15.62 4 6 6 0 1 1 14.107 15.62 2 13.954 15.677 13.982 15.988 14.145 16 1 21 16 0 0 2 6 0 3 20 1 21 20)
)
