(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wind-arrow-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWindArrowDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 2 1 10 10 0 0 3 14 0 12.8 21.6 4 2 2 0 1 0 14 18 1 2 18 0 0 3 14 0 17.5 10 4 2.5 2.5 0 1 1 19.5 14 1 2 14 0 0 3 9 0 6 6 1 10 10 1 14 6)
)
