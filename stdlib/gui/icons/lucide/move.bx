(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-move
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMove (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 2 1 12 22 0 0 3 9 0 15 19 1 12 22 1 9 19 0 0 3 9 0 19 9 1 22 12 1 19 15 0 0 2 6 0 2 12 1 22 12 0 0 3 9 0 5 9 1 2 12 1 5 15 0 0 3 9 0 9 5 1 12 2 1 15 5)
)
