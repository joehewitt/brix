(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rotate-ccw-key
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRotateCcwKey (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 7 1 12 13 0 0 2 6 0 12 9 1 14 9 0 0 4 22 0 3 12 4 9 9 0 1 0 12 3 4 9.74 9.74 0 0 0 5.26 5.74 1 3 8 0 0 3 9 0 3 3 1 3 8 1 8 8 1 0 12 15 2)
)
