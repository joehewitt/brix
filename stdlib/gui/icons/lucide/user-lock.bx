(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-user-lock
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUserLock (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 19 16 1 19 14 4 2 2 0 0 0 15 14 1 15 16 0 0 4 17 0 9.5 15 1 7 15 4 4 4 0 0 0 3 19 1 3 21 1 0 10 7 4 0 0 10 48 0 13.899 16 1 20.101 16 4 0.899 0.899 0 0 1 21 16.899 1 21 20.101 4 0.899 0.899 0 0 1 20.101 21 1 13.899 21 4 0.899 0.899 0 0 1 13 20.101 1 13 16.899 4 0.899 0.899 0 0 1 13.899 16 5)
)
