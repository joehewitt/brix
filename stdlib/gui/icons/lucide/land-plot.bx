(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-land-plot
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLandPlot (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 12 0 12 8 1 18 5 1 12 2 1 12 12 0 0 8 39 0 8 11.99 1 2.5 15.13 4 1 1 0 0 0 2.5 16.87 1 11 21.73 4 2 2 0 0 0 13 21.73 1 21.5 16.87 4 1 1 0 0 0 21.5 15.13 1 16 12 0 0 2 6 0 6.49 12.85 1 17.51 19.15 0 0 2 6 0 17.51 12.85 1 6.5 19.15)
)
