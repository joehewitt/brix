(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-images
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideImages (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 22 11 1 20.704 9.704 4 2.4 2.4 0 0 0 17.296 9.704 1 11 16 0 0 6 33 0 4 8 4 2 2 0 0 0 2 10 1 2 20 4 2 2 0 0 0 4 22 1 14 22 4 2 2 0 0 0 16 20 1 1 13 7 1 0 0 10 48 0 10 2 1 20 2 4 2 2 0 0 1 22 4 1 22 14 4 2 2 0 0 1 20 16 1 10 16 4 2 2 0 0 1 8 14 1 8 4 4 2 2 0 0 1 10 2 5)
)
