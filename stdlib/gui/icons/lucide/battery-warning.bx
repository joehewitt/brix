(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-battery-warning
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBatteryWarning (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 17 1 10.01 17 0 0 2 6 0 10 7 1 10 13 0 0 6 28 0 14 6 1 16 6 4 2 2 0 0 1 18 8 1 18 16 4 2 2 0 0 1 16 18 1 14 18 0 0 2 6 0 22 14 1 22 10 0 0 6 28 0 6 18 1 4 18 4 2 2 0 0 1 2 16 1 2 8 4 2 2 0 0 1 4 6 1 6 6)
)
