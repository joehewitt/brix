(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-dna-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDnaOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 13 0 15 2 2 13.65 3.5 12.908 5 12.5 6.5 1 14 8 0 0 2 6 0 17 6 1 14.109 3.109 0 0 2 10 0 2 15 2 5.333 12 8.667 12 12 12 0 0 2 6 0 2 2 1 22 22 0 0 2 6 0 20 9 1 20.891 9.891 0 0 3 13 0 22 9 2 20.5 10.35 19 11.092 17.5 11.5 1 16.5 10.5 0 0 2 6 0 3.109 14.109 1 4 15 0 0 2 6 0 6.5 12.5 1 7.5 13.5 0 0 2 6 0 7 18 1 9.891 20.891 0 0 3 13 0 9 22 2 10.35 20.5 11.092 19 11.5 17.5 1 10 16)
)
