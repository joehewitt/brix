(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-clover
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideClover (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16.17 7.83 1 2 22 0 0 9 67 0 4.02 12 4 2.827 2.827 0 1 1 7.83 7.83 4 2.827 2.827 0 1 1 12 4.02 4 2.827 2.827 0 1 1 16.17 7.83 4 2.827 2.827 0 1 1 19.98 12 4 2.827 2.827 0 1 1 16.17 16.17 4 2.827 2.827 0 1 1 12 19.98 4 2.827 2.827 0 1 1 7.83 16.17 4 1 1 0 1 1 4 12 0 0 2 6 0 7.83 7.83 1 16.17 16.17)
)
