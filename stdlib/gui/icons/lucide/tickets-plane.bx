(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tickets-plane
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTicketsPlane (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 10.5 17 1 11.727 17 4 2 2 0 0 0 13.072 16.48 1 18 12 0 0 2 6 0 12 13.5 1 15.794 14.006 0 0 4 17 0 3.173 8.18 1 14.173 3.18 4 2 2 0 0 1 16.82 4.173 1 18.56 8 0 0 2 6 0 6 10 1 6 8 0 0 2 6 0 6 14 1 6 15 0 0 2 6 0 6 19 1 6 21 0 0 10 48 0 4 8 1 20 8 4 2 2 0 0 1 22 10 1 22 19 4 2 2 0 0 1 20 21 1 4 21 4 2 2 0 0 1 2 19 1 2 10 4 2 2 0 0 1 4 8 5)
)
