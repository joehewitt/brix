(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bell-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBellOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 10.268 21 4 2 2 0 0 0 13.732 21 0 0 5 29 0 17 17 1 4 17 4 1 1 0 0 1 3.26 15.327 2 4.59 13.956 6 12.499 6 8 4 6 6 0 0 1 6.258 6.258 0 0 2 6 0 2 2 1 22 22 0 0 3 18 0 8.668 3.01 4 6 6 0 0 1 18 8 2 18 10.687 18.77 12.653 19.707 14.05)
)
