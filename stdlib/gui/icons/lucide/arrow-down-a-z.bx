(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-arrow-down-a-z
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArrowDownAZ (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 3 16 1 7 20 1 11 16 0 0 2 6 0 7 20 1 7 4 0 0 2 6 0 20 8 1 15 8 0 0 4 17 0 15 10 1 15 6.5 4 2.5 2.5 0 0 1 20 6.5 1 20 10 0 0 4 12 0 15 14 1 20 14 1 15 20 1 20 20)
)
