(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-panel-left-right-dashed
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePanelLeftRightDashed (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 10 1 15 9 0 0 2 6 0 15 15 1 15 14 0 0 2 6 0 15 21 1 15 19 0 0 2 6 0 15 5 1 15 3 0 0 2 6 0 9 10 1 9 9 0 0 2 6 0 9 15 1 9 14 0 0 2 6 0 9 21 1 9 19 0 0 2 6 0 9 5 1 9 3 0 0 10 48 0 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 5)
)
