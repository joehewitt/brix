(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hand-fist
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHandFist (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 19 107 0 12.035 17.012 4 3 3 0 0 0 9.035 14.012 1 8.724 14.01 4 0.72 0.72 0 0 1 8.219 12.781 1 9.414 11.586 4 2 2 0 0 1 10.828 11 1 12 11 4 2 2 0 0 0 12 7 1 9.243 7 4 3 3 0 0 0 7.121 7.879 1 4.414 10.586 4 4.83 4.83 0 0 0 3 14 4 8 8 0 0 0 11 22 1 13 22 4 8 8 0 0 0 21 14 1 21 7 4 2 2 0 1 0 17 7 1 17 9 4 2 2 0 1 0 21 9 0 0 4 22 0 13.888 9.662 4 2 2 0 0 0 17 8 1 17 5 4 2 2 0 1 0 13 5 0 0 3 14 0 9 5 4 2 2 0 1 0 5 5 1 5 10 0 0 4 17 0 9 7 1 9 4 4 2 2 0 1 1 13 4 1 13 7.268)
)
