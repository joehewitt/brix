(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-accessibility
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAccessibility (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 16 4 1 0 0 3 9 0 18 19 1 19 12 1 13 13 0 0 4 12 0 5 8 1 8 5 1 13.5 8 1 11.14 11.5 0 0 2 11 0 4.24 14.5 4 5 5 0 0 0 11.12 20.5 0 0 2 11 0 13.76 17.5 4 5 5 0 0 0 6.88 11.5)
)
