(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hand-grab
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHandGrab (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 25 0 18 11.5 1 18 9 4 2 2 0 0 0 16 7 4 2 2 0 0 0 14 9 1 14 10.4 0 0 5 25 0 14 10 1 14 8 4 2 2 0 0 0 12 6 4 2 2 0 0 0 10 8 1 10 10 0 0 5 25 0 10 9.9 1 10 9 4 2 2 0 0 0 8 7 4 2 2 0 0 0 6 9 1 6 14 0 0 3 19 0 6 14 4 2 2 0 0 0 4 12 4 2 2 0 0 0 2 14 0 0 7 41 0 18 11 4 2 2 0 1 1 22 11 1 22 14 4 8 8 0 0 1 14 22 1 10 22 4 8 8 0 0 1 2 14 4 2 2 0 1 1 6 14)
)
