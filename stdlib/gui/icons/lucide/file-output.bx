(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-output
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileOutput (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 58 0 4.226 20.925 4 2 2 0 0 0 6 22 1 18 22 4 2 2 0 0 0 20 20 1 20 8 4 2.4 2.4 0 0 0 19.294 6.294 1 15.706 2.706 4 2.4 2.4 0 0 0 14 2 1 6 2 4 2 2 0 0 0 4 4 1 4 7.127 0 0 4 17 0 14 2 1 14 7 4 1 1 0 0 0 15 8 1 20 8 0 0 2 6 0 5 11 1 2 14 0 0 3 9 0 5 17 1 2 14 1 12 14)
)
