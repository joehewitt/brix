(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-table-columns-split
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTableColumnsSplit (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 14 14 1 14 16 0 0 2 6 0 14 20 1 14 22 0 0 2 6 0 14 2 1 14 4 0 0 2 6 0 14 8 1 14 10 0 0 2 6 0 2 15 1 10 15 0 0 6 28 0 2 3 1 8 3 4 2 2 0 0 1 10 5 1 10 19 4 2 2 0 0 1 8 21 1 2 21 0 0 2 6 0 2 9 1 10 9 0 0 2 6 0 22 15 1 18 15 0 0 6 28 0 22 3 1 20 3 4 2 2 0 0 0 18 5 1 18 19 4 2 2 0 0 0 20 21 1 22 21 0 0 2 6 0 22 9 1 18 9 0 0 2 6 0 5 3 1 5 21)
)
