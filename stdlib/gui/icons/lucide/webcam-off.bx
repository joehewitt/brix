(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-webcam-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWebcamOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 22 1 12 18 0 0 2 11 0 12.754 7.096 4 3 3 0 0 1 14.904 9.246 0 0 2 11 0 12.863 12.873 4 3 3 0 0 1 9.127 9.138 0 0 2 11 0 16.566 16.57 4 8 8 0 0 1 5.43 5.433 0 0 2 6 0 2 2 1 22 22 0 0 2 6 0 7 22 1 17 22 0 0 2 11 0 8.478 2.817 4 8 8 0 0 1 19.183 13.522)
)
