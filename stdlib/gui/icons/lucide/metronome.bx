(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-metronome
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMetronome (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 11.4 1 12 9.1 0 0 2 6 0 12 17 1 18.59 10.41 0 0 8 39 0 15.05 5.7 1 14.832 5.009 4 3 3 0 0 0 9.169 5.009 1 4.418 19.695 4 1 1 0 0 0 5.37 21 1 18.623 21 4 1 1 0 0 0 19.574 19.69 1 18.45 16.2 1 0 20 9 2)
)
