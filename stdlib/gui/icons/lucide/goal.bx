(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-goal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGoal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 12 0 12 13 1 12 2 1 20 6 1 12 10 0 0 2 11 0 20.561 10.222 4 9 9 0 1 1 8.011 4.932 0 0 2 11 0 8.002 9.997 4 5 5 0 1 0 16.902 12.017)
)
