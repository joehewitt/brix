(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bomb
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBomb (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 11 13 9 0 0 6 28 0 14.35 4.65 1 16.3 2.7 4 2.41 2.41 0 0 1 19.7 2.7 1 21.3 4.3 4 2.4 2.4 0 0 1 21.3 7.7 1 19.35 9.65 0 0 2 6 0 22 2 1 20.5 3.5)
)
