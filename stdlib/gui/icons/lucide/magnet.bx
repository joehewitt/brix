(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-magnet
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMagnet (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 15 1 16 19 0 0 13 67 0 2.352 10.648 4 1.205 1.205 0 0 0 2.352 12.352 1 4.648 14.648 4 1.205 1.205 0 0 0 6.352 14.648 1 12.381 8.619 4 1 1 0 1 1 15.381 11.619 1 9.352 17.648 4 1.205 1.205 0 0 0 9.352 19.352 1 11.648 21.648 4 1.205 1.205 0 0 0 13.352 21.648 1 19.717 15.281 4 1 1 0 0 0 8.716 4.282 5 0 0 2 6 0 5 8 1 9 12)
)
