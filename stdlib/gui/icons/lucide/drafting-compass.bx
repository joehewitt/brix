(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-drafting-compass
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDraftingCompass (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12.99 6.74 1 14.92 10.18 0 0 2 11 0 19.136 12 4 10 10 0 0 1 4.865 12 0 0 2 6 0 21 21 1 18.84 17.16 0 0 2 6 0 3 21 1 11.02 6.74 1 0 12 5 2)
)
