(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wine
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWine (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 8 22 1 16 22 0 0 2 6 0 7 10 1 17 10 0 0 2 6 0 12 15 1 12 22 0 0 7 37 0 12 15 4 5 5 0 0 0 17 10 2 17 8 16.5 6 15 2 1 9 2 2 7.5 6 7 8 7 10 4 5 5 0 0 0 12 15 5)
)
