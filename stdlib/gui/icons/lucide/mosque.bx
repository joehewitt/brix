(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mosque
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMosque (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 12.268 2 4 2 2 0 0 0 15.733 4 0 0 2 6 0 14 5 1 14 8 0 0 4 17 0 16 22 1 16 19 4 2 2 0 0 0 12 19 1 12 22 0 0 6 32 0 21 13 2 20.338 11.503 19.334 10.247 18.1 9.37 2 16.825 8.47 15.422 8 14 8 2 12.578 8 11.174 8.47 9.9 9.37 2 8.668 10.248 7.663 11.504 7 13 5 0 0 2 6 0 3 9 1 7 9 0 0 9 47 0 7 22 1 7 6 4 5 5 0 0 0 5 2 4 5 5 0 0 0 3 6 1 3 20 4 2 2 0 0 0 5 22 1 19 22 4 2 2 0 0 0 21 20 1 21 13)
)
