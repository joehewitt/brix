(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bell-electric
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBellElectric (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 18.518 17.347 4 7 7 0 0 1 14 19 0 0 2 11 0 18.8 4 4 11 11 0 0 1 20 9 0 0 2 6 0 9 9 1 9.01 9 1 0 20 16 2 1 0 9 9 7 0 0 10 48 0 6 16 1 12 16 4 2 2 0 0 1 14 18 1 14 20 4 2 2 0 0 1 12 22 1 6 22 4 2 2 0 0 1 4 20 1 4 18 4 2 2 0 0 1 6 16 5)
)
