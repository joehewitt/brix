(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-list-ordered
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideListOrdered (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 5 1 21 5 0 0 2 6 0 11 12 1 21 12 0 0 2 6 0 11 19 1 21 19 0 0 3 9 0 4 4 1 5 4 1 5 9 0 0 2 6 0 4 9 1 6 9 0 0 4 21 0 6.5 20 1 3.4 20 2 3.4 19 6 18.075 6 16.5 4 1.5 1.5 0 0 0 3.4 15.48)
)
