(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-drum
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDrum (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 2 1 10 10 0 0 2 6 0 22 2 1 14 10 2 0 12 9 10 5 0 0 2 6 0 7 13.4 1 7 21.3 0 0 2 6 0 12 14 1 12 22 0 0 2 6 0 17 13.4 1 17 21.3 0 0 4 17 0 2 9 1 2 17 4 10 5 0 0 0 22 17 1 22 9)
)
