(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-repeat-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRepeatN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 2 9 1 5 6 1 8 9 0 0 4 17 0 13 18 1 7 18 4 2 2 0 0 1 5 16 1 5 6 0 0 3 9 0 22 15 1 19 18 1 16 15 0 0 4 17 0 11 6 1 17 6 4 2 2 0 0 1 19 8 1 19 18)
)
