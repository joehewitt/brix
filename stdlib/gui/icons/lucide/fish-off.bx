(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-fish-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFishOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 62 0 18 12.47 1 18 12.5 0 18 12 1 18 12.47 0 17.525 17.526 4 6.744 6.744 0 0 1 15 18 2 11.44 18 7.44 15.47 6.5 12 2 6.848 10.72 7.614 9.567 8.621 8.62 0 12.065 6.532 4 8.802 8.802 0 0 1 15 6 2 18.56 6 21.06 8.54 22 12 2 21.691 13.14 21.214 14.177 20.587 15.058 0 0 9 53 0 7 10.67 2 7 8 5.58 5.97 2.73 5.5 2 1.73 7 1.73 10.5 2.96 12 2 1.72 13.5 1.72 17 2.73 18.5 2 5.58 18.03 7 16 7 13.33 0 14.48 8.958 4 9.77 9.77 0 0 1 16 6.07 0 16 17.93 4 9.77 9.77 0 0 1 14.272 14.312 0 0 11 48 0 16.01 17.93 1 15.78 19.33 4 2 2 0 0 1 13.8 21 1 9.5 21 4 5.96 5.96 0 0 0 10.99 17.02 0 8.53 3 1 13.8 3 4 2 2 0 0 1 15.78 4.67 1 16.01 6.07 0 2 2 1 22 22)
)
