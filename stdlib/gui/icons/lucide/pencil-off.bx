(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pencil-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePencilOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 10 10 1 3.843 16.162 4 2 2 0 0 0 3.343 16.995 1 2.021 21.355 4 0.5 0.5 0 0 0 2.643 21.979 1 7.001 20.656 4 2 2 0 0 0 7.831 20.156 1 14 13.982 0 0 4 17 0 12.829 7.172 1 17.188 2.826 4 1 1 0 1 1 21.174 6.812 1 16.821 11.165 0 0 2 6 0 15 5 1 19 9 0 0 2 6 0 2 2 1 22 22)
)
