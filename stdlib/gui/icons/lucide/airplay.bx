(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-airplay
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAirplay (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 5 17 1 4 17 4 2 2 0 0 1 2 15 1 2 5 4 2 2 0 0 1 4 3 1 20 3 4 2 2 0 0 1 22 5 1 22 15 4 2 2 0 0 1 20 17 1 19 17 0 0 4 10 0 12 15 1 17 21 1 7 21 5)
)
