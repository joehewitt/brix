(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hotel
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHotel (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 22 1 10 15.43 0 0 2 6 0 12 11 1 12.01 11 0 0 2 6 0 12 7 1 12.01 7 0 0 2 6 0 14 15.43 1 14 22 0 0 2 11 0 15 16 4 5 5 0 0 0 9 16 0 0 2 6 0 16 11 1 16.01 11 0 0 2 6 0 16 7 1 16.01 7 0 0 2 6 0 8 11 1 8.01 11 0 0 2 6 0 8 7 1 8.01 7 0 0 10 48 0 6 2 1 18 2 4 2 2 0 0 1 20 4 1 20 20 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4 20 1 4 4 4 2 2 0 0 1 6 2 5)
)
