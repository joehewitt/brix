(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-grape
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGrape (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 22 5 1 22 2 1 16.11 7.89 1 0 16.6 15.89 3 1 0 8.11 7.4 3 1 0 12.35 11.65 3 1 0 13.91 5.85 3 1 0 18.15 10.09 3 1 0 6.56 13.2 3 1 0 10.8 17.44 3 1 0 5 19 3)
)
