(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-layers-minus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLayersMinus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 53 0 12.83 2.18 4 2 2 0 0 0 11.17 2.18 1 2.6 6.08 4 1 1 0 0 0 2.6 7.91 1 11.18 11.82 4 2 2 0 0 0 12.01 12 4 2 2 0 0 0 12.84 11.82 1 21.42 7.92 4 1 1 0 0 0 21.42 6.088 5 0 0 2 6 0 16 17 1 22 17 0 0 4 22 0 2.003 11.995 4 1 1 0 0 0 2.6 12.91 1 11.18 16.82 4 2 2 0 0 0 12.01 17 0 0 6 33 0 2.003 16.995 4 1 1 0 0 0 2.6 17.91 1 11.18 21.82 4 2 2 0 0 0 12.01 22 4 2 2 0 0 0 12.84 21.82 1 14.95 20.86 0 0 3 14 0 22.018 12.004 4 1 1 0 0 1 21.42 12.92 1 21.243 13)
)
