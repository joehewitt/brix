(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-saudi-riyal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSaudiRiyal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 20 19.5 1 14.5 20.7 0 0 4 17 0 14.5 4 1 14.5 15.22 4 1 1 0 0 0 15.742 16.19 1 20 15.2 0 0 4 17 0 2.978 19.351 1 8.527 17.988 4 2 2 0 0 0 10 16 1 10 2 0 0 2 6 0 20 10 1 4 13.5)
)
