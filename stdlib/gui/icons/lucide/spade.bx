(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-spade
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSpade (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 18 1 12 22 0 0 9 55 0 2 14.499 4 5.5 5.5 0 0 0 11.591 18.174 4 0.6 0.6 0 0 1 12.409 18.175 4 5.5 5.5 0 0 0 22 14.5 2 22 12.21 20.5 10.5 19 9 1 13.508 3.688 4 2 2 0 0 0 10.508 3.668 1 5 8.999 2 3.5 10.499 2 12.199 2 14.499)
)
