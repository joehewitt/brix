(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mail-x
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMailX (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 38 0 22 13 1 22 6 4 2 2 0 0 0 20 4 1 4 4 4 2 2 0 0 0 2 6 1 2 18 2 2 19.1 2.9 20 4 20 1 13 20 0 0 4 17 0 22 7 1 13.03 12.7 4 1.94 1.94 0 0 1 10.97 12.7 1 2 7 0 0 2 6 0 17 17 1 21 21 0 0 2 6 0 21 17 1 17 21)
)
