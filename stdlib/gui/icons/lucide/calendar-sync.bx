(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-calendar-sync
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCalendarSync (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 11 10 1 11 14 1 15 14 0 0 3 14 0 11 14 1 12.535 12.395 4 5 5 0 0 1 20.535 13.895 0 0 2 6 0 16 2 1 16 5 0 0 3 14 0 21 18 1 19.465 19.605 4 5 5 0 0 1 11.465 18.105 0 0 3 9 0 21 22 1 21 18 1 17 18 0 0 8 39 0 21 8.517 1 21 5 4 2 2 0 0 0 19 3 1 5 3 4 2 2 0 0 0 3 5 1 3 19 4 2 2 0 0 0 5 21 1 8.517 21 0 0 2 6 0 3 9 1 7 9 0 0 2 6 0 8 2 1 8 5)
)
