(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-fence
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFence (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 30 0 4 3 1 2 5 1 2 20 2 2 20.6 2.4 21 3 21 1 5 21 2 5.6 21 6 20.6 6 20 1 6 5 5 0 0 2 6 0 6 8 1 10 8 0 0 2 6 0 6 18 1 10 18 0 0 8 30 0 12 3 1 10 5 1 10 20 2 10 20.6 10.4 21 11 21 1 13 21 2 13.6 21 14 20.6 14 20 1 14 5 5 0 0 2 6 0 14 8 1 18 8 0 0 2 6 0 14 18 1 18 18 0 0 8 30 0 20 3 1 18 5 1 18 20 2 18 20.6 18.4 21 19 21 1 21 21 2 21.6 21 22 20.6 22 20 1 22 5 5)
)
