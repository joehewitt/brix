(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-triangle-alert
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTriangleAlert (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 36 0 21.73 18 1 13.73 4 4 2 2 0 0 0 10.25 4 1 2.25 18 4 2 2 0 0 0 4 21 1 20 21 4 2 2 0 0 0 21.73 18 0 0 2 6 0 12 9 1 12 13 0 0 2 6 0 12 17 1 12.01 17)
)
