(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lamp-wall-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLampWallDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 19.929 18.629 4 1 1 0 0 1 19 20 1 9 20 4 1 1 0 0 1 8.072 18.629 1 10.072 13.629 4 1 1 0 0 1 11 13 1 17 13 4 1 1 0 0 1 17.928 13.629 5 0 0 9 45 0 6 3 4 2 2 0 0 1 8 5 1 8 7 4 2 2 0 0 1 6 9 1 5 9 4 1 1 0 0 1 4 8 1 4 4 4 1 1 0 0 1 5 3 5 0 0 4 17 0 8 6 1 12 6 4 2 2 0 0 1 14 8 1 14 13)
)
