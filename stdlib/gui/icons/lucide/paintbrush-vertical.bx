(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-paintbrush-vertical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePaintbrushVertical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 2 1 10 4 0 0 2 6 0 14 2 1 14 6 0 0 7 29 0 17 2 4 1 1 0 0 1 18 3 1 18 12 1 6 12 1 6 3 4 1 1 0 0 1 7 2 5 0 0 14 77 0 6 12 4 1 1 0 0 0 5 13 1 5 14 4 2 2 0 0 0 7 16 1 9 16 4 1 1 0 0 1 10 17 1 10 19.9 4 2 2 0 1 0 14 19.9 1 14 17 4 1 1 0 0 1 15 16 1 17 16 4 2 2 0 0 0 19 14 1 19 13 4 1 1 0 0 0 18 12)
)
