(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shield-lock
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShieldLock (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 54 0 20 9.807 1 20 6 4 1 1 0 0 0 19 5 2 17 5 14.51 3.81 12.76 2.28 4 1.17 1.17 0 0 0 11.24 2.28 2 9.5 3.8 7 5 5 5 4 1 1 0 0 0 4 6 1 4 13 2 4 16.88 6.107 19.254 9 20.796 0 0 4 17 0 19 17 1 19 15 4 2 2 0 0 0 15 15 1 15 17 0 0 10 48 0 14 17 1 20 17 4 1 1 0 0 1 21 18 1 21 21 4 1 1 0 0 1 20 22 1 14 22 4 1 1 0 0 1 13 21 1 13 18 4 1 1 0 0 1 14 17 5)
)
