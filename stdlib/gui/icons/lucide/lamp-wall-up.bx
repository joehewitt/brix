(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lamp-wall-up
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLampWallUp (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 19.929 9.629 4 1 1 0 0 1 19 11 1 9 11 4 1 1 0 0 1 8.072 9.629 1 10.072 4.629 4 1 1 0 0 1 11 4 1 17 4 4 1 1 0 0 1 17.928 4.629 5 0 0 9 45 0 6 15 4 2 2 0 0 1 8 17 1 8 19 4 2 2 0 0 1 6 21 1 5 21 4 1 1 0 0 1 4 20 1 4 16 4 1 1 0 0 1 5 15 5 0 0 4 17 0 8 18 1 12 18 4 2 2 0 0 0 14 16 1 14 11)
)
