(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hand-heart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHandHeart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 27 0 11 14 1 13 14 4 2 2 0 0 0 13 10 1 10 10 2 9.4 10 8.9 10.2 8.6 10.6 1 3 16 0 0 8 47 0 14.45 13.39 1 19.5 8.696 2 20.196 8 21 6.85 21 5.75 4 2.75 2.75 0 0 0 16.203 3.913 4 0.276 0.276 0 0 1 15.797 3.913 4 2.75 2.75 0 0 0 11 5.75 2 11 6.95 11.802 7.998 12.5 8.696 1 16 11.95 0 0 2 6 0 2 15 1 8 21 0 0 7 34 0 7 20 1 8.6 18.6 2 8.9 18.2 9.4 18 10 18 1 14 18 2 15.1 18 16.1 17.6 16.8 16.8 1 21.4 12.4 4 1 1 0 0 0 18.65 9.49)
)
