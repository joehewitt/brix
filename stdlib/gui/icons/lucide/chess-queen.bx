(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chess-queen
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChessQueen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 4 20 4 2 2 0 0 1 6 18 1 18 18 4 2 2 0 0 1 20 20 1 20 21 4 1 1 0 0 1 19 22 1 5 22 4 1 1 0 0 1 4 21 5 0 0 4 17 0 12.474 5.943 1 14.041 11.283 4 1 1 0 0 0 15.791 11.611 1 18.407 8.209 0 0 2 6 0 20 9 1 17 18 0 0 4 17 0 5.594 8.209 1 8.209 11.612 4 1 1 0 0 0 9.959 11.283 1 11.526 5.943 0 0 2 6 0 7 18 1 4 9 1 0 12 4 2 1 0 20 7 2 1 0 4 7 2)
)
