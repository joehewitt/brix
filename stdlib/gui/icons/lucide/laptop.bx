(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-laptop
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLaptop (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 67 0 18 5 4 2 2 0 0 1 20 7 1 20 15.526 4 2 2 0 0 0 20.212 16.423 1 21.28 18.55 4 1 1 0 0 1 20.38 20 1 3.62 20 4 1 1 0 0 1 2.72 18.55 1 3.788 16.423 4 2 2 0 0 0 4 15.526 1 4 7 4 2 2 0 0 1 6 5 5 0 0 2 6 0 20.054 15.987 1 3.946 15.987)
)
