(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hdmi-port
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHdmiPort (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 17 89 0 22 9 4 1 1 0 0 0 21 8 1 3 8 4 1 1 0 0 0 2 9 1 2 13 4 1 1 0 0 0 3 14 1 3.5 14 4 2 2 0 0 1 5.1 14.8 1 5.4 15.2 4 2 2 0 0 0 7 16 1 17 16 4 2 2 0 0 0 18.6 15.2 1 18.9 14.8 4 2 2 0 0 1 20.5 14 1 21 14 4 1 1 0 0 0 22 13 5 0 0 2 6 0 8 12 1 16 12)
)
