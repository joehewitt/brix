(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zap
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZap (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 67 0 15.914 4 4 1.5 1.5 0 0 0 13.44 2.439 1 4.44 11.439 4 1.5 1.5 0 0 0 5.5 14 1 9.502 14 4 0.5 0.5 0 0 1 9.973 14.666 1 8.086 20 4 1.5 1.5 0 0 0 10.561 21.56 1 19.561 12.56 4 1.5 1.5 0 0 0 18.5 10 1 14.503 10 4 0.5 0.5 0 0 1 14.031 9.333 5)
)
