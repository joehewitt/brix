(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-headset
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeadset (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 20 91 0 3 11 1 6 11 4 2 2 0 0 1 8 13 1 8 16 4 2 2 0 0 1 6 18 1 5 18 4 2 2 0 0 1 3 16 1 3 11 5 0 3 11 4 9 9 0 1 1 21 11 0 21 11 1 21 16 4 2 2 0 0 1 19 18 1 18 18 4 2 2 0 0 1 16 16 1 16 13 4 2 2 0 0 1 18 11 1 21 11 5 0 0 4 17 0 21 16 1 21 18 4 4 4 0 0 1 17 22 1 12 22)
)
