(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sun-moon
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSunMoon (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 2 1 12 4 0 0 5 33 0 14.837 16.385 4 6 6 0 1 1 7.614 9.163 2 8.238 9.016 8.584 9.823 8.329 10.411 4 4 4 0 0 0 13.589 15.67 2 14.178 15.415 14.985 15.76 14.837 16.385 0 0 2 11 0 16 12 4 4 4 0 0 0 12 8 0 0 2 6 0 19 5 1 17.744 6.256 0 0 2 6 0 20 12 1 22 12)
)
