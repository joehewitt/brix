(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-utility-pole
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUtilityPole (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 2 1 12 22 0 0 2 6 0 2 5 1 22 5 0 0 2 6 0 3 3 1 3 5 0 0 2 6 0 7 3 1 7 5 0 0 2 6 0 17 3 1 17 5 0 0 2 6 0 21 3 1 21 5 0 0 3 9 0 19 5 1 12 12 1 5 5)
)
