(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-signpost-big
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSignpostBig (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 15 0 10 9 1 4 9 1 2 7 1 4 5 1 10 5 0 0 5 15 0 14 5 1 20 5 1 22 7 1 20 9 1 14 9 0 0 4 17 0 10 22 1 10 4 4 2 2 0 1 1 14 4 1 14 22 0 0 2 6 0 8 22 1 16 22)
)
