(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tree-palm
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTreePalm (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 29 0 13 8 2 13 5.24 10.54 3 7.5 3 2 4.46 3 2 5.24 2 8 1 4 8 1 5 7 1 6 8 1 10 8 0 0 7 30 0 13 7.14 4 5.82 5.82 0 0 1 16.5 6 2 19.54 6 22 8.24 22 11 1 19 11 1 18 10 1 17 11 1 14 11 0 0 7 29 0 5.89 9.71 2 3.74 11.86 3.59 15.18 5.54 17.14 1 9.78 12.89 1 10.48 12.19 1 11.19 11.48 1 13.31 9.36 2 11.36 7.4 8.04 7.56 5.89 9.71 0 0 4 20 0 11 15.5 2 11.5 18 10.83 20 10 22 1 14 22 2 16 16.5 13.5 10 13 8)
)
