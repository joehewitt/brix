(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tree-deciduous
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTreeDeciduous (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 50 0 8 19 4 4 4 0 0 1 5.76 11.68 4 3.5 3.5 0 0 1 9 6.03 1 9 6 4 3 3 0 1 1 15 6 1 15 6.04 4 3.5 3.5 0 0 1 18.24 11.69 4 4 4 0 0 1 16 19 5 0 0 2 6 0 12 19 1 12 22)
)
