(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ticket-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTicketPlus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 67 0 2 9 4 3 3 0 0 1 2 15 1 2 17 4 2 2 0 0 0 4 19 1 20 19 4 2 2 0 0 0 22 17 1 22 15 4 3 3 0 0 1 22 9 1 22 7 4 2 2 0 0 0 20 5 1 4 5 4 2 2 0 0 0 2 7 5 0 0 2 6 0 9 12 1 15 12 0 0 2 6 0 12 9 1 12 15)
)
