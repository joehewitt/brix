(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ribbon
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRibbon (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 25 0 12 11.22 2 11 9.997 10 9 10 8 4 2 2 0 0 1 14 8 2 14 9 13.002 10.002 11.99 11.22 0 0 2 6 0 12 18 1 14.57 14.5 0 0 2 11 0 6.243 9.016 4 7 7 0 0 1 17.75 9.007 0 0 2 6 0 9.35 14.53 1 12 11.22 0 0 14 73 0 9.35 14.53 2 7.728 12.246 6 10.221 6 7 4 6 5 0 0 1 18 7 2 17.995 10.22 16.222 12.235 14.57 14.5 1 18.127 19.027 4 1 1 0 0 1 17.924 20.457 1 16.03 21.817 4 1 1 0 0 1 14.646 21.602 1 12 18 1 9.321 21.593 4 1 1 0 0 1 7.931 21.806 1 6.066 20.453 4 1 1 0 0 1 5.863 19.031 5)
)
