(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-paper-bag
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePaperBag (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 42 0 5.364 3.848 2 4 6 3 9.652 3 12.652 1 3 19 4 2 2 0 0 0 5 21 1 19 21 4 2 2 0 0 0 21 19 1 21 14 2 21 11.666 19.184 9.332 18.378 6.998 0 0 12 61 0 7 3 1 18.379 3 4 2 2 0 0 1 20.168 4.106 1 20.891 5.553 4 1 1 0 0 1 19.997 7 1 11.472 7 4 2 2 0 0 1 9.683 5.894 1 8.79 4.105 4 2 2 0 1 0 5.211 5.894 1 7.472 10.416 4 5 5 0 0 1 8 12.652 1 8 21)
)
