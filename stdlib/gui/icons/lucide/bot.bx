(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bot
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBot (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 12 8 1 12 4 1 8 4 0 0 10 48 0 6 8 1 18 8 4 2 2 0 0 1 20 10 1 20 18 4 2 2 0 0 1 18 20 1 6 20 4 2 2 0 0 1 4 18 1 4 10 4 2 2 0 0 1 6 8 5 0 0 2 6 0 2 14 1 4 14 0 0 2 6 0 20 14 1 22 14 0 0 2 6 0 15 13 1 15 15 0 0 2 6 0 9 13 1 9 15)
)
