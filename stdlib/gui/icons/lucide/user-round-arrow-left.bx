(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-user-round-arrow-left
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUserRoundArrowLeft (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 19 16 1 16 19 0 0 2 11 0 2 21 4 8 8 0 0 1 14.664 14.5 0 0 3 9 0 22 19 1 16 19 1 19 22 1 0 10 8 5)
)
