(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chess-knight
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChessKnight (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 5 20 4 2 2 0 0 1 7 18 1 17 18 4 2 2 0 0 1 19 20 1 19 21 4 1 1 0 0 1 18 22 1 6 22 4 1 1 0 0 1 5 21 5 0 0 9 46 0 16.5 18 2 17.5 16 19 13 19 9 4 7 7 0 0 0 12 2 1 6.635 2 4 1 1 0 0 0 5.867 3.64 1 7 5 1 4.68 10.802 4 2 2 0 0 0 5.63 13.328 1 8.5 14.784 0 0 2 6 0 15 5 1 16.425 3.575 0 0 2 6 0 17 8 1 18.53 6.47 0 0 2 6 0 9.713 12.185 1 7 18)
)
