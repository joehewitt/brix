(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-test-tubes
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTestTubes (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 25 0 9 2 1 9 19.5 4 2.5 2.5 0 0 1 6.5 22 4 2.5 2.5 0 0 1 4 19.5 1 4 2 0 0 5 25 0 20 2 1 20 19.5 4 2.5 2.5 0 0 1 17.5 22 4 2.5 2.5 0 0 1 15 19.5 1 15 2 0 0 2 6 0 3 2 1 10 2 0 0 2 6 0 14 2 1 21 2 0 0 2 6 0 9 16 1 4 16 0 0 2 6 0 20 16 1 15 16)
)
