(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-move-3-d
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMoveN3D (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 5 3 1 5 19 1 21 19 0 0 2 6 0 5 19 1 11 13 0 0 3 9 0 2 6 1 5 3 1 8 6 0 0 3 9 0 18 16 1 21 19 1 18 22)
)
