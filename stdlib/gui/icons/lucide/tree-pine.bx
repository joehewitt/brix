(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tree-pine
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTreePine (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 19 85 0 17 14 1 20 17.3 4 1 1 0 0 1 19.3 19 1 4.7 19 4 1 1 0 0 1 4 17.3 1 7 14 1 6.7 14 4 1 1 0 0 1 6 12.3 1 9 9 1 8.8 9 4 1 1 0 0 1 8 7.3 1 12 3 1 16 7.3 4 1 1 0 0 1 15.2 9 1 15 9 1 18 12.3 4 1 1 0 0 1 17.3 14 1 17 14 5 0 0 2 6 0 12 22 1 12 19)
)
