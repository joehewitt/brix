(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-box-select
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBoxSelect (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 5 3 4 2 2 0 0 0 3 5 0 0 2 11 0 19 3 4 2 2 0 0 1 21 5 0 0 2 11 0 21 19 4 2 2 0 0 1 19 21 0 0 2 11 0 5 21 4 2 2 0 0 1 3 19 0 0 2 6 0 9 3 1 10 3 0 0 2 6 0 9 21 1 10 21 0 0 2 6 0 14 3 1 15 3 0 0 2 6 0 14 21 1 15 21 0 0 2 6 0 3 9 1 3 10 0 0 2 6 0 21 9 1 21 10 0 0 2 6 0 3 14 1 3 15 0 0 2 6 0 21 14 1 21 15)
)
