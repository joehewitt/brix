(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rotate-cw-fading-clock
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRotateCwFadingClock (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 12 3 4 9.75 9.75 0 0 1 18.74 5.74 0 0 2 6 0 18.74 5.74 1 21 8 0 0 2 6 0 21 8 1 21 3 0 0 2 10 0 7.5 19.794 2 1.5 16.33 1.5 7.67 7.5 4.206 0 0 2 11 0 7.5 4.206 4 9 9 0 0 1 12 3 0 0 3 9 0 12 7 1 12 12 1 16 14 0 0 2 11 0 14 20.775 4 9 9 0 0 1 12 21 0 0 2 11 0 19 17.656 4 9 9 0 0 1 17.5 19.112 0 0 2 11 0 21 12 4 9 9 0 0 1 20.772 14 0 0 2 6 0 21 8 1 16 8)
)
