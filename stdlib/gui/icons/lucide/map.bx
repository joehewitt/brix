(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-map
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMap (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 17 89 0 14.106 5.553 4 2 2 0 0 0 15.894 5.553 1 19.553 3.723 4 1 1 0 0 1 21 4.619 1 21 17.383 4 1 1 0 0 1 20.447 18.277 1 15.894 20.554 4 2 2 0 0 1 14.106 20.554 1 9.894 18.448 4 2 2 0 0 0 8.106 18.448 1 4.447 20.278 4 1 1 0 0 1 3 19.381 1 3 6.618 4 1 1 0 0 1 3.553 5.724 1 8.106 3.447 4 2 2 0 0 1 9.894 3.447 5 0 0 2 6 0 15 5.764 1 15 20.764 0 0 2 6 0 9 3.236 1 9 18.236)
)
