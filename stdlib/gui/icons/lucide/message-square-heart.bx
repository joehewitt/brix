(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-message-square-heart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMessageSquareHeart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 22 17 4 2 2 0 0 1 20 19 1 6.828 19 4 2 2 0 0 0 5.414 19.586 1 3.212 21.788 4 0.71 0.71 0 0 1 2 21.286 1 2 5 4 2 2 0 0 1 4 3 1 20 3 4 2 2 0 0 1 22 5 5 0 0 10 64 0 7.5 9.5 2 7.5 10.187 7.765 10.883 8.197 11.344 1 11.206 14.608 4 1.14 1.14 0 0 0 11.613 14.922 4 1 1 0 0 0 12.396 14.918 4 1.14 1.14 0 0 0 12.794 14.608 1 15.802 11.344 4 2.77 2.77 0 0 0 16.5 9.5 4 2.5 2.5 0 0 0 12 8 4 2.5 2.5 0 0 0 7.5 9.5)
)
