(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-vibrate
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVibrate (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 15 0 2 8 1 4 10 1 2 12 1 4 14 1 2 16 0 0 5 15 0 22 8 1 20 10 1 22 12 1 20 14 1 22 16 0 0 10 48 0 9 5 1 15 5 4 1 1 0 0 1 16 6 1 16 18 4 1 1 0 0 1 15 19 1 9 19 4 1 1 0 0 1 8 18 1 8 6 4 1 1 0 0 1 9 5 5)
)
