(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-angry
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAngry (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 11 1 15 9.416 0 0 2 11 0 17 9 4 5 5 0 0 0 14 10 0 0 2 11 0 7 9 4 5 5 0 0 1 10 10 0 0 2 6 0 9 11 1 9 9.416 0 0 2 11 0 9 16 4 5 5 0 0 1 15.001 16 1 0 12 12 10)
)
