(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-diameter
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDiameter (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 19 19 2 1 0 5 5 2 0 0 2 11 0 6.48 3.66 4 10 10 0 0 1 20.34 17.52 0 0 2 6 0 6.41 6.41 1 17.59 17.59 0 0 2 11 0 3.66 6.48 4 10 10 0 0 0 17.52 20.34)
)
