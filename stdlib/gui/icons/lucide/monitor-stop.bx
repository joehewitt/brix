(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-monitor-stop
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMonitorStop (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 17 1 12 21 0 0 2 6 0 8 21 1 16 21 0 0 10 48 0 4 3 1 20 3 4 2 2 0 0 1 22 5 1 22 15 4 2 2 0 0 1 20 17 1 4 17 4 2 2 0 0 1 2 15 1 2 5 4 2 2 0 0 1 4 3 5 0 0 10 48 0 10 7 1 14 7 4 1 1 0 0 1 15 8 1 15 12 4 1 1 0 0 1 14 13 1 10 13 4 1 1 0 0 1 9 12 1 9 8 4 1 1 0 0 1 10 7 5)
)
