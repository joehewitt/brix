(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-palette
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePalette (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 50 0 12 22 4 1 1 0 0 1 12 2 4 10 9 0 0 1 22 11 4 5 5 0 0 1 17 16 1 14.75 16 4 1.75 1.75 0 0 0 13.35 18.8 1 13.65 19.2 4 1.75 1.75 0 0 1 12.25 22 5 1 1 13.5 6.5 0.5 1 1 17.5 10.5 0.5 1 1 6.5 12.5 0.5 1 1 8.5 7.5 0.5)
)
