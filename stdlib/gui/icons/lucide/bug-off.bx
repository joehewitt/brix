(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bug-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBugOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 20 1 12 12 0 0 4 17 0 12.656 7 1 14 7 4 4 4 0 0 1 18 11 1 18 12.344 0 0 2 6 0 14.12 3.88 1 16 2 0 0 4 22 0 17.123 17.123 4 6 6 0 0 1 6 14 1 6 11 4 4 4 0 0 1 7.72 7.713 0 0 2 6 0 2 2 1 22 22 0 0 2 11 0 21 5 4 4 4 0 0 1 17.45 8.97 0 0 2 6 0 22 13 1 18.656 13 0 0 2 11 0 3 21 4 4 4 0 0 1 6.81 17 0 0 2 11 0 3 5 4 4 4 0 0 0 6.55 8.97 0 0 2 6 0 6 13 1 2 13 0 0 2 6 0 8 2 1 9.88 3.88 0 0 3 14 0 9.712 4.06 4 3 3 0 0 1 15 6 1 15 7.13)
)
