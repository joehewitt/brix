(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mouse-pointer-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMousePointerN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 4.037 4.688 4 0.495 0.495 0 0 1 4.688 4.037 1 20.688 10.537 4 0.5 0.5 0 0 1 20.625 11.484 1 14.501 13.064 4 2 2 0 0 0 13.063 14.499 1 11.484 20.625 4 0.5 0.5 0 0 1 10.537 20.688 5)
)
