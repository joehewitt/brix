(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-antenna
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAntenna (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 12 1 7 2 0 0 2 6 0 7 12 1 12 2 0 0 2 6 0 12 12 1 17 2 0 0 2 6 0 17 12 1 22 2 0 0 2 6 0 4.5 7 1 19.5 7 0 0 2 6 0 12 16 1 12 22)
)
