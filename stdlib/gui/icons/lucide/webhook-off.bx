(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-webhook-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWebhookOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 21 0 17 17 1 12 17 2 10.91 16.98 10.06 17.92 9.5 18.9 4 3 3 0 1 1 2.57 15 0 0 2 11 0 9 3.4 4 4 4 0 0 1 15.52 4.06 0 0 3 14 0 6 17 1 9.1 11.2 4 2.5 2.5 0 0 0 9.157 9.15 0 0 2 11 0 20.3 20.3 4 4 4 0 0 1 18 21 0 0 2 11 0 18.6 13 4 4 4 0 0 1 21.957 16.414 0 0 2 6 0 12 6 1 12.6 7 0 0 2 6 0 2 2 1 22 22)
)
