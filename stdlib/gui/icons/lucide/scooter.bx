(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-scooter
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScooter (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 21 4 1 17.5 4 1 19.5 15.05 0 0 4 21 0 6.95 17 1 12.092 17 2 12.615 17 13.042 16.594 13.155 16.084 4 6.5 6.5 0 0 1 18.5 11.075 1 0 19.5 17.5 2.5 1 0 4.5 17.5 2.5)
)
