(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-image-upscale
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideImageUpscale (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 16 3 1 21 3 1 21 8 0 0 3 14 0 17 21 1 19 21 4 2 2 0 0 0 21 19 0 0 2 6 0 21 12 1 21 15 0 0 2 6 0 21 3 1 16 8 0 0 3 14 0 3 7 1 3 5 4 2 2 0 0 1 5 3 0 0 4 17 0 5 21 1 9.144 16.856 4 1.21 1.21 0 0 1 10.856 16.856 1 13 19 0 0 2 6 0 9 3 1 12 3 0 0 10 48 0 4 11 1 12 11 4 1 1 0 0 1 13 12 1 13 20 4 1 1 0 0 1 12 21 1 4 21 4 1 1 0 0 1 3 20 1 3 12 4 1 1 0 0 1 4 11 5)
)
