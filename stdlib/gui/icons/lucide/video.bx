(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-video
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVideo (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 16 13 1 21.223 16.482 4 0.5 0.5 0 0 0 22 16.066 1 22 7.87 4 0.5 0.5 0 0 0 21.248 7.438 1 16 10.5 0 0 10 48 0 4 6 1 14 6 4 2 2 0 0 1 16 8 1 16 16 4 2 2 0 0 1 14 18 1 4 18 4 2 2 0 0 1 2 16 1 2 8 4 2 2 0 0 1 4 6 5)
)
