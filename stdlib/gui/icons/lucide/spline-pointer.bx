(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-spline-pointer
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSplinePointer (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 12.034 12.681 4 0.498 0.498 0 0 1 12.681 12.034 1 21.681 15.534 4 0.5 0.5 0 0 1 21.648 16.477 1 18.204 17.545 4 1 1 0 0 0 17.544 18.205 1 16.477 21.648 4 0.5 0.5 0 0 1 15.534 21.681 5 0 0 2 11 0 5 17 4 12 12 0 0 1 17 5 1 0 19 5 2 1 0 5 19 2)
)
