(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-gallery-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGalleryHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 3 1 2 21 0 0 10 48 0 8 3 1 16 3 4 2 2 0 0 1 18 5 1 18 19 4 2 2 0 0 1 16 21 1 8 21 4 2 2 0 0 1 6 19 1 6 5 4 2 2 0 0 1 8 3 5 0 0 2 6 0 22 3 1 22 21)
)
