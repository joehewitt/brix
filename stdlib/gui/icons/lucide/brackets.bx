(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-brackets
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBrackets (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 16 3 1 19 3 4 1 1 0 0 1 20 4 1 20 20 4 1 1 0 0 1 19 21 1 16 21 0 0 6 28 0 8 21 1 5 21 4 1 1 0 0 1 4 20 1 4 4 4 1 1 0 0 1 5 3 1 8 3)
)
