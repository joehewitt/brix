(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flip-horizontal-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlipHorizontalN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 12 0 3 7 1 8 12 1 3 17 1 3 7 0 0 4 12 0 21 7 1 16 12 1 21 17 1 21 7 0 0 2 6 0 12 20 1 12 22 0 0 2 6 0 12 14 1 12 16 0 0 2 6 0 12 8 1 12 10 0 0 2 6 0 12 2 1 12 4)
)
