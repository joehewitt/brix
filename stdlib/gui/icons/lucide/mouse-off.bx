(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mouse-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMouseOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 6 1 12 6.343 0 0 4 22 0 18.218 18.218 4 7 7 0 0 1 5 15 1 5 9 4 7 7 0 0 1 5.782 5.782 0 0 3 14 0 19 13.343 1 19 9 4 7 7 0 0 0 8.56 2.902 0 0 2 6 0 22 22 1 2 2)
)
