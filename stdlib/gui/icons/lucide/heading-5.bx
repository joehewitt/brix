(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-heading-5
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeadingN5 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4 12 1 12 12 0 0 2 6 0 4 18 1 4 6 0 0 2 6 0 12 18 1 12 6 0 0 3 9 0 17 13 1 17 10 1 21 10 0 0 5 27 0 17 17.7 2 17.4 17.9 17.8 18 18.3 18 2 19.8 18 21 16.9 21 15.5 2 21 14.1 19.8 13 18.3 13 1 17 13)
)
