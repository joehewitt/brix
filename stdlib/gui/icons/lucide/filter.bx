(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-filter
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFilter (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 67 0 10 20 4 1 1 0 0 0 10.553 20.895 1 12.553 21.895 4 1 1 0 0 0 14 21 1 14 14 4 2 2 0 0 1 14.517 12.659 1 21.74 4.67 4 1 1 0 0 0 21 3 1 3 3 4 1 1 0 0 0 2.258 4.67 1 9.483 12.659 4 2 2 0 0 1 10 14 5)
)
