(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mic-audio-lines
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMicAudioLines (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 3 1 10 5.341 0 0 2 6 0 12 17 1 12 21 0 0 2 6 0 14 5 1 14 5.341 0 0 2 6 0 18 5 1 18 18 0 0 2 6 0 2 10 1 2 13 0 0 2 6 0 22 10 1 22 13 0 0 2 6 0 6 6 1 6 17 0 0 2 6 0 9 21 1 15 21 0 0 10 48 0 12 9 1 12 9 4 2 2 0 0 1 14 11 1 14 15 4 2 2 0 0 1 12 17 1 12 17 4 2 2 0 0 1 10 15 1 10 11 4 2 2 0 0 1 12 9 5)
)
