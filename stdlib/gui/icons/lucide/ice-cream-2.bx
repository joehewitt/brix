(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ice-cream-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideIceCreamN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 43 0 12 17 2 17 17 20 14.31 20 11 1 4 11 2 4 14.31 7 17 12 17 0 8 21 1 16 21 0 12 18 1 12 21 0 5.14 11 4 3.5 3.5 0 1 1 11.85 11 0 0 2 11 0 12.14 11 4 3.5 3.5 0 1 1 18.85 11 0 0 2 11 0 15.5 6.5 4 3.5 3.5 0 1 0 8.5 6.5)
)
