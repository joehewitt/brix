(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-id-card-lanyard
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideIdCardLanyard (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 13.5 8 1 10.5 8 0 0 11 53 0 15 2 1 14 4 1 17 4 4 2 2 0 0 1 19 6 1 19 20 4 2 2 0 0 1 17 22 1 7 22 4 2 2 0 0 1 5 20 1 5 6 4 2 2 0 0 1 7 4 1 10 4 0 0 2 11 0 16.899 22 4 5 5 0 0 0 7.1 22 0 0 2 6 0 9 2 1 12 8 1 0 12 15 3)
)
