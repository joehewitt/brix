(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-newspaper
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideNewspaper (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 18 1 10 18 0 0 2 6 0 18 14 1 10 14 0 0 12 61 0 4 22 1 20 22 4 2 2 0 0 0 22 20 1 22 4 4 2 2 0 0 0 20 2 1 8 2 4 2 2 0 0 0 6 4 1 6 20 4 2 2 0 0 1 2 20 1 2 11 4 2 2 0 0 1 4 9 1 6 9 0 0 10 48 0 11 6 1 17 6 4 1 1 0 0 1 18 7 1 18 9 4 1 1 0 0 1 17 10 1 11 10 4 1 1 0 0 1 10 9 1 10 7 4 1 1 0 0 1 11 6 5)
)
