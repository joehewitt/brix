(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-message-square-dot
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMessageSquareDot (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 12.7 3 1 4 3 4 2 2 0 0 0 2 5 1 2 21.286 4 0.71 0.71 0 0 0 3.212 21.788 1 5.414 19.586 4 2 2 0 0 1 6.828 19 1 20 19 4 2 2 0 0 0 22 17 1 22 12.3 1 0 19 6 3)
)
