(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-fishing-hook
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFishingHook (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 17.586 11.414 1 11.656 17.344 4 1 1 0 0 1 3.656 9.344 1 6.793 6.207 4 0.707 0.707 0 0 1 8 6.707 1 8 10 0 0 2 6 0 20.414 8.586 1 22 7 1 0 19 10 2)
)
