(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-film
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFilm (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 5 0 0 2 6 0 7 3 1 7 21 0 0 2 6 0 3 7.5 1 7 7.5 0 0 2 6 0 3 12 1 21 12 0 0 2 6 0 3 16.5 1 7 16.5 0 0 2 6 0 17 3 1 17 21 0 0 2 6 0 17 7.5 1 21 7.5 0 0 2 6 0 17 16.5 1 21 16.5)
)
