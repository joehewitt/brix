(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-blinds
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBlinds (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 3 3 1 21 3 0 0 2 6 0 20 7 1 8 7 0 0 2 6 0 20 11 1 8 11 0 0 2 6 0 10 19 1 20 19 0 0 2 6 0 8 15 1 20 15 0 0 2 6 0 4 3 1 4 17 1 0 4 19 2)
)
