(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pyramid
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePyramid (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 2.5 16.88 4 1 1 0 0 1 2.18 15.45 1 11.18 2.43 4 1 1 0 0 1 12.82 2.43 1 21.82 15.44 4 1 1 0 0 1 21.5 16.88 1 12.99 21.74 4 2 2 0 0 1 11.01 21.74 5 0 0 2 6 0 12 2 1 12 22)
)
