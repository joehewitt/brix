(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-medal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMedal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 7.21 15 1 2.66 7.14 4 2 2 0 0 1 2.79 4.94 1 4.4 2.8 4 2 2 0 0 1 6 2 1 18 2 4 2 2 0 0 1 19.6 2.8 1 21.2 4.94 4 2 2 0 0 1 21.34 7.14 1 16.79 15 0 0 2 6 0 11 12 1 5.12 2.2 0 0 2 6 0 13 12 1 18.88 2.2 0 0 2 6 0 8 7 1 16 7 1 0 12 17 5 0 0 3 9 0 12 18 1 12 16 1 11.5 16)
)
