(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-life-buoy
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLifeBuoy (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 10 0 0 2 6 0 4.93 4.93 1 9.17 9.17 0 0 2 6 0 14.83 9.17 1 19.07 4.93 0 0 2 6 0 14.83 14.83 1 19.07 19.07 0 0 2 6 0 9.17 14.83 1 4.93 19.07 1 0 12 12 4)
)
