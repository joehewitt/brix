(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-save-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSavePlus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 12.5 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 1 15.2 3 4 2 2 0 0 1 16.6 3.6 1 20.4 7.4 4 2 2 0 0 1 21 8.8 1 21 12 0 0 4 17 0 16 13 1 8 13 4 1 1 0 0 0 7 14 1 7 21 0 0 2 6 0 19 22 1 19 16 0 0 2 6 0 22 19 1 16 19 0 0 4 17 0 7 3 1 7 7 4 1 1 0 0 0 8 8 1 15 8)
)
