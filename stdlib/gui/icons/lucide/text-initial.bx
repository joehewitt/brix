(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-text-initial
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTextInitial (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 5 1 21 5 0 0 2 6 0 15 12 1 21 12 0 0 2 6 0 3 19 1 21 19 0 0 4 17 0 3 12 1 6.553 4.276 4 0.5 0.5 0 0 1 7.447 4.276 1 11 12 0 0 2 6 0 3.92 10 1 10.08 10)
)
