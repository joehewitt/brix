(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-stamp
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStamp (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 31 0 14 13 1 14 8.5 2 14 7 15 7 15 5 4 3 3 0 0 0 9 5 2 9 7 10 7 10 8.5 1 10 13 0 0 9 45 0 20 15.5 4 2.5 2.5 0 0 0 17.5 13 1 6.5 13 4 2.5 2.5 0 0 0 4 15.5 1 4 17 4 1 1 0 0 0 5 18 1 19 18 4 1 1 0 0 0 20 17 5 0 0 2 6 0 5 22 1 19 22)
)
