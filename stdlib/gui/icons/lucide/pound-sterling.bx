(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pound-sterling
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePoundSterling (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 10 0 18 7 2 18 1.667 10 1.667 10 7 0 0 2 6 0 10 7 1 10 21 0 0 2 6 0 6 21 1 18 21 0 0 2 6 0 6 13 1 16 13)
)
