(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tractor
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTractor (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 10 11 1 21 11.9 4 1 1 0 0 1 21.8 13 1 21.135 17.158 4 1 1 0 0 1 20.147 18 1 20 18 0 0 2 6 0 16 18 1 11 18 0 0 3 14 0 18 5 4 1 1 0 0 0 17 6 1 17 11.573 0 0 4 17 0 3 4 1 11.129 4 4 1 1 0 0 1 12.119 4.863 1 13 11.246 0 0 2 6 0 4 11 1 4 4 0 0 2 6 0 7 15 1 7.01 15 0 0 2 6 0 8 10.1 1 8 4 1 0 18 18 2 1 0 7 15 5)
)
