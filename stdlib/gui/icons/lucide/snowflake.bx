(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-snowflake
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSnowflake (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 10 20 1 8.75 17.5 1 6 18 0 0 3 9 0 10 4 1 8.75 6.5 1 6 6 0 0 3 9 0 14 20 1 15.25 17.5 1 18 18 0 0 3 9 0 14 4 1 15.25 6.5 1 18 6 0 0 3 9 0 17 21 1 14 15 1 10 15 0 0 3 9 0 17 3 1 14 9 1 15.5 12 0 0 3 9 0 2 12 1 8.5 12 1 10 9 0 0 3 9 0 20 10 1 18.5 12 1 20 14 0 0 3 9 0 22 12 1 15.5 12 1 14 15 0 0 3 9 0 4 10 1 5.5 12 1 4 14 0 0 3 9 0 7 21 1 10 15 1 8.5 12 0 0 3 9 0 7 3 1 10 9 1 14 9)
)
