(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-church
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChurch (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 9 1 14 9 0 0 2 6 0 12 7 1 12 12 0 0 4 17 0 14 21 1 14 18 4 2 2 0 0 0 10 18 1 10 21 0 0 10 50 0 18 9 1 21.52 11.147 4 1 1 0 0 1 22 12.001 1 22 19 4 2 2 0 0 1 20 21 1 4 21 4 2 2 0 0 1 2 19 1 2 12.001 4 1 1 0 0 1 2.48 11.147 1 6 9 0 0 8 39 0 6 21 1 6 7 4 1 1 0 0 1 6.376 6.218 1 11.376 2.219 4 1 1 0 0 1 12.625 2.22 1 17.625 6.22 4 1 1 0 0 1 18 7 1 18 21)
)
