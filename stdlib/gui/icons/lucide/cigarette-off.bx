(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cigarette-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCigaretteOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 12 12 1 3 12 4 1 1 0 0 0 2 13 1 2 15 4 1 1 0 0 0 3 16 1 16 16 0 0 2 10 0 18 8 2 18 5.5 16 5.5 16 3 0 0 2 6 0 2 2 1 22 22 0 0 4 22 0 21 12 4 1 1 0 0 1 22 13 1 22 15 4 1 1 0 0 1 21.5 15.866 0 0 2 10 0 22 8 2 22 5.5 20 5.5 20 3 0 0 2 6 0 7 12 1 7 16)
)
