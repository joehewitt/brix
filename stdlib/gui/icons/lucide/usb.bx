(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-usb
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUsb (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 10 7 1 1 0 4 20 1 0 0 2 6 0 4.7 19.3 1 19 5 0 0 4 10 0 21 3 1 18 4 1 20 6 5 0 0 3 9 0 9.26 7.68 1 5 12 1 7 17 0 0 3 9 0 10 14 1 15 16 1 18.5 12.5 0 0 5 13 0 18 12 1 19 11 1 20 12 1 19 13 5)
)
