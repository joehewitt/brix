(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-user-key
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUserKey (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 20 11 1 20 17 0 0 2 6 0 20 13 1 22 13 0 0 5 25 0 3 21 1 3 19 4 4 4 0 0 1 7 15 1 13 15 4 4 4 0 0 1 15.072 15.578 1 0 10 7 4 1 0 20 19 2)
)
