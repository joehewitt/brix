(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-step-forward
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStepForward (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 34 0 10.029 4.285 4 2 2 0 0 0 7 6 1 7 18 4 2 2 0 0 0 10.029 19.715 1 20.026 13.717 4 2 2 0 0 0 20.029 10.285 5 0 0 2 6 0 3 4 1 3 20)
)
