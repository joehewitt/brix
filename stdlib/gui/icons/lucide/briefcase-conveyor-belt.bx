(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-briefcase-conveyor-belt
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBriefcaseConveyorBelt (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 20 1 10 22 0 0 2 6 0 14 20 1 14 22 0 0 2 6 0 18 20 1 18 22 0 0 2 6 0 21 20 1 3 20 0 0 2 6 0 6 20 1 6 22 0 0 6 28 0 8 16 1 8 4 4 2 2 0 0 1 10 2 1 14 2 4 2 2 0 0 1 16 4 1 16 16 0 0 10 48 0 6 6 1 18 6 4 2 2 0 0 1 20 8 1 20 14 4 2 2 0 0 1 18 16 1 6 16 4 2 2 0 0 1 4 14 1 4 8 4 2 2 0 0 1 6 6 5)
)
