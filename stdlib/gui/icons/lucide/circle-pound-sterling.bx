(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-circle-pound-sterling
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCirclePoundSterling (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 10 0 0 3 14 0 10 16 1 10 9.5 4 1 1 0 0 1 15 9.5 0 0 2 6 0 8 12 1 12 12 0 0 2 6 0 8 16 1 15 16)
)
