(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-siren
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSiren (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 7 18 1 7 12 4 5 5 0 1 1 17 12 1 17 18 0 0 9 45 0 5 21 4 1 1 0 0 0 6 22 1 18 22 4 1 1 0 0 0 19 21 1 19 20 4 2 2 0 0 0 17 18 1 7 18 4 2 2 0 0 0 5 20 5 0 0 2 6 0 21 12 1 22 12 0 0 2 6 0 18.5 4.5 1 18 5 0 0 2 6 0 2 12 1 3 12 0 0 2 6 0 12 2 1 12 3 0 0 2 6 0 4.929 4.929 1 5.636 5.636 0 0 2 6 0 12 12 1 12 18)
)
