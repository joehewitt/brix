(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ampersand
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAmpersand (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 12 1 19 12 0 0 6 41 0 17.5 12 4 8 8 0 0 1 9.5 20 4 4.5 4.5 0 0 1 5 15.5 2 5 9.5 13 11.5 13 7 4 3 3 0 1 0 7 7 2 7 10 9.5 15.5 19 20)
)
