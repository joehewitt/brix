(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-end-vertical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignEndVertical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 4 1 16 4 4 2 2 0 0 1 18 6 1 18 8 4 2 2 0 0 1 16 10 1 4 10 4 2 2 0 0 1 2 8 1 2 6 4 2 2 0 0 1 4 4 5 0 0 10 48 0 11 14 1 16 14 4 2 2 0 0 1 18 16 1 18 18 4 2 2 0 0 1 16 20 1 11 20 4 2 2 0 0 1 9 18 1 9 16 4 2 2 0 0 1 11 14 5 0 0 2 6 0 22 22 1 22 2)
)
