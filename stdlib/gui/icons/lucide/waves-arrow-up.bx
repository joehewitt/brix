(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-waves-arrow-up
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWavesArrowUp (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 2 1 12 10 0 0 6 38 0 2 15 2 2.6 15.5 3.2 16 4.5 16 2 7 16 7 14 9.5 14 2 12.1 14 11.9 16 14.5 16 2 17 16 17 14 19.5 14 2 20.8 14 21.4 14.5 22 15 0 0 6 38 0 2 21 2 2.6 21.5 3.2 22 4.5 22 2 7 22 7 20 9.5 20 2 12.1 20 11.9 22 14.5 22 2 17 22 17 20 19.5 20 2 20.8 20 21.4 20.5 22 21 0 0 3 9 0 8 6 1 12 2 1 16 6)
)
