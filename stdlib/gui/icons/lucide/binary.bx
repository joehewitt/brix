(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-binary
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBinary (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 16 14 1 16 14 4 2 2 0 0 1 18 16 1 18 18 4 2 2 0 0 1 16 20 1 16 20 4 2 2 0 0 1 14 18 1 14 16 4 2 2 0 0 1 16 14 5 0 0 10 48 0 8 4 1 8 4 4 2 2 0 0 1 10 6 1 10 8 4 2 2 0 0 1 8 10 1 8 10 4 2 2 0 0 1 6 8 1 6 6 4 2 2 0 0 1 8 4 5 0 0 2 6 0 6 20 1 10 20 0 0 2 6 0 14 10 1 18 10 0 0 3 9 0 6 14 1 8 14 1 8 20 0 0 3 9 0 14 4 1 16 4 1 16 10)
)
