(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-vertical-space-around
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignVerticalSpaceAround (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 9 9 1 15 9 4 2 2 0 0 1 17 11 1 17 13 4 2 2 0 0 1 15 15 1 9 15 4 2 2 0 0 1 7 13 1 7 11 4 2 2 0 0 1 9 9 5 0 0 2 6 0 22 20 1 2 20 0 0 2 6 0 22 4 1 2 4)
)
