(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-warehouse
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWarehouse (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 18 21 1 18 10 4 1 1 0 0 0 17 9 1 7 9 4 1 1 0 0 0 6 10 1 6 21 0 0 11 56 0 22 19 4 2 2 0 0 1 20 21 1 4 21 4 2 2 0 0 1 2 19 1 2 8 4 2 2 0 0 1 3.132 6.197 1 11.082 2.223 4 2 2 0 0 1 12.919 2.223 1 20.867 6.197 4 2 2 0 0 1 22 8 5 0 0 2 6 0 6 13 1 18 13 0 0 2 6 0 6 17 1 18 17)
)
