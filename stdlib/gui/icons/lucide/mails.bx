(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mails
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMails (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 33 0 17 19 4 2 2 0 0 1 15 21 1 4 21 4 2 2 0 0 1 2 19 1 2 11 4 2 2 0 0 1 3 9.268 0 0 4 17 0 22 5.5 1 15.581 9.679 4 2 2 0 0 1 13.419 9.679 1 7 5.5 0 0 10 48 0 9 3 1 20 3 4 2 2 0 0 1 22 5 1 22 13 4 2 2 0 0 1 20 15 1 9 15 4 2 2 0 0 1 7 13 1 7 5 4 2 2 0 0 1 9 3 5)
)
