(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-waves-vertical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWavesVertical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 23 0 12 2 3 14 4.5 12 7 3 10 9.5 12 12 3 14 14.5 12 17 3 10 19.5 12 22 0 0 5 23 0 19 2 3 21 4.5 19 7 3 17 9.5 19 12 3 21 14.5 19 17 3 17 19.5 19 22 0 0 5 23 0 5 2 3 7 4.5 5 7 3 3 9.5 5 12 3 7 14.5 5 17 3 3 19.5 5 22)
)
