(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zodiac-cancer
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZodiacCancer (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 21 14.5 4 9 6.5 0 0 1 5.5 19 0 0 2 11 0 3 9.5 4 9 6.5 0 0 1 18.5 5 1 0 17.5 14.5 3.5 1 0 6.5 9.5 3.5)
)
