(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-radar
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRadar (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 19.07 4.93 4 10 10 0 0 0 6.99 3.34 0 0 2 6 0 4 6 1 4.01 6 0 0 2 11 0 2.29 9.62 4 10 10 0 1 0 21.31 8.35 0 0 2 11 0 16.24 7.76 4 6 6 0 1 0 8.23 16.67 0 0 2 6 0 12 18 1 12.01 18 0 0 2 11 0 17.99 11.66 4 6 6 0 0 1 15.77 16.67 1 0 12 12 2 0 0 2 6 0 13.41 10.59 1 19.07 4.93)
)
