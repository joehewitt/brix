(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bath
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBath (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 4 1 8 6 0 0 2 6 0 17 19 1 17 21 0 0 2 6 0 2 12 1 22 12 0 0 2 6 0 7 19 1 7 21 0 0 8 39 0 9 5 1 7.621 3.621 4 2.121 2.121 0 0 0 4 5 1 4 17 4 2 2 0 0 0 6 19 1 18 19 4 2 2 0 0 0 20 17 1 20 12)
)
