(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rabbit
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRabbit (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 13 16 4 3 3 0 0 1 15.24 21 0 0 2 6 0 18 12 1 18.01 12 0 0 14 71 0 18 21 1 10 21 4 4 4 0 0 1 6 17 4 7 7 0 0 1 13 10 1 13.2 10 1 9.6 6.4 4 1 1 0 1 1 12.4 3.6 1 15.8 7 1 16 7 2 19.3 7 22 9.7 22 13 1 22 14 4 2 2 0 0 1 20 16 1 19 16 4 3 3 0 0 0 16 19 0 0 4 17 0 20 8.54 1 20 4 4 2 2 0 1 0 16 4 1 16 7 0 0 2 11 0 7.612 12.524 4 3 3 0 1 0 6.012 16.824)
)
