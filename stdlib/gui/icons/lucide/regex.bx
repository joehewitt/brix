(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-regex
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRegex (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 17 3 1 17 13 0 0 2 6 0 12.67 5.5 1 21.33 10.5 0 0 2 6 0 12.67 10.5 1 21.33 5.5 0 0 10 48 0 9 17 4 2 2 0 0 0 7 15 1 5 15 4 2 2 0 0 0 3 17 1 3 19 4 2 2 0 0 0 5 21 1 7 21 4 2 2 0 0 0 9 19 1 9 17 5)
)
