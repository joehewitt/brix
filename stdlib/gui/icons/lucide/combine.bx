(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-combine
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCombine (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 22 0 14 3 4 1 1 0 0 1 15 4 1 15 9 4 1 1 0 0 1 14 10 0 0 4 22 0 19 3 4 1 1 0 0 1 20 4 1 20 9 4 1 1 0 0 1 19 10 0 0 2 6 0 7 15 1 10 18 0 0 5 20 0 7 21 1 10 18 1 5 18 4 2 2 0 0 1 3 16 1 3 14 0 0 10 48 0 15 14 1 20 14 4 1 1 0 0 1 21 15 1 21 20 4 1 1 0 0 1 20 21 1 15 21 4 1 1 0 0 1 14 20 1 14 15 4 1 1 0 0 1 15 14 5 0 0 10 48 0 4 3 1 9 3 4 1 1 0 0 1 10 4 1 10 9 4 1 1 0 0 1 9 10 1 4 10 4 1 1 0 0 1 3 9 1 3 4 4 1 1 0 0 1 4 3 5)
)
