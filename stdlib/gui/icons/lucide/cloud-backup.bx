(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cloud-backup
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCloudBackup (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 22 0 21 15.251 4 4.5 4.5 0 0 0 17.5 8 1 15.71 8 4 7 7 0 1 0 3 13.607 0 0 3 9 0 7 11 1 7 15 1 11 15 0 0 5 30 0 8 19 4 5 5 0 0 0 17 16 4 4.5 4.5 0 0 0 12.5 11.5 4 4.82 4.82 0 0 0 9.09 12.91 1 7 15)
)
