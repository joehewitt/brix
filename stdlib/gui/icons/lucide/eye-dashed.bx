(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-eye-dashed
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEyeDashed (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 13.054 18.946 4 11 11 0 0 1 10.944 18.946 0 0 2 11 0 13.054 5.054 4 11 11 0 0 0 10.944 5.053 0 0 2 11 0 17.072 6.274 4 11 11 0 0 1 18.825 7.447 0 0 2 11 0 18.825 16.552 4 11 11 0 0 1 17.072 17.726 0 0 4 27 0 2.514 13.303 4 11 11 0 0 1 2.062 12.349 4 1 1 0 0 1 2.062 11.652 4 11 11 0 0 1 2.512 10.697 0 0 4 27 0 21.485 10.697 4 11 11 0 0 1 21.938 11.652 4 1 1 0 0 1 21.938 12.349 4 11 11 0 0 1 21.485 13.303 0 0 2 11 0 5.173 7.448 4 11 11 0 0 1 6.926 6.274 0 0 2 11 0 6.926 17.726 4 11 11 0 0 1 5.173 16.552 1 0 12 12 3)
)
