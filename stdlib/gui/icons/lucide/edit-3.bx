(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-edit-3
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEditN3 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 13 21 1 21 21 0 0 9 45 0 21.174 6.812 4 1 1 0 0 0 17.188 2.825 1 3.842 16.174 4 2 2 0 0 0 3.342 17.004 1 2.021 21.356 4 0.5 0.5 0 0 0 2.644 21.978 1 6.997 20.658 4 2 2 0 0 0 7.827 20.161 5)
)
