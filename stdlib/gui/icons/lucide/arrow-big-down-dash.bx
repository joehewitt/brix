(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-arrow-big-down-dash
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArrowBigDownDash (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 15 78 0 14 8 4 1 1 0 0 1 15 9 1 15 11 4 1 1 0 0 0 16 12 1 19.293 12 4 0.707 0.707 0 0 1 19.793 13.207 1 12.854 20.146 4 1.207 1.207 0 0 1 11.146 20.146 1 4.206 13.206 4 0.707 0.707 0 0 1 4.706 12 1 8 12 4 1 1 0 0 0 9 11 1 9 9 4 1 1 0 0 1 10 8 5 0 0 2 6 0 9 4 1 15 4)
)
