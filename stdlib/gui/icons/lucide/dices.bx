(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-dices
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDices (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 10 1 12 10 4 2 2 0 0 1 14 12 1 14 20 4 2 2 0 0 1 12 22 1 4 22 4 2 2 0 0 1 2 20 1 2 12 4 2 2 0 0 1 4 10 5 0 0 6 28 0 17.92 14 1 21.42 10.5 4 2.24 2.24 0 0 0 21.42 7.5 1 16.42 2.58 4 2.24 2.24 0 0 0 13.42 2.58 1 10 6 0 0 2 6 0 6 18 1 6.01 18 0 0 2 6 0 10 14 1 10.01 14 0 0 2 6 0 15 6 1 15.01 6 0 0 2 6 0 18 9 1 18.01 9)
)
