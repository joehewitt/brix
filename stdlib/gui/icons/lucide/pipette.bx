(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pipette
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePipette (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 47 0 12 9 1 3.586 17.414 4 2 2 0 0 0 3 18.828 1 3 20.172 4 2 2 0 0 1 2.414 21.586 4 2 2 0 0 1 3.828 21 1 5.172 21 4 2 2 0 0 0 6.586 20.414 1 15 12 0 0 9 40 0 18 9 1 18.4 9.4 4 1 1 0 1 1 15.4 12.4 1 11.6 8.6 4 1 1 0 1 1 14.6 5.6 1 15 6 1 18.4 2.6 4 1 1 0 1 1 21.4 5.6 5 0 0 2 6 0 2 22 1 2.414 21.586)
)
