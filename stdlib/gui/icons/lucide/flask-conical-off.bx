(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flask-conical-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlaskConicalOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 2 1 10 4.343 0 0 2 6 0 14 2 1 14 8.343 0 0 2 6 0 2 2 1 22 22 0 0 5 25 0 20 20 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4.245 19.04 1 9.472 9.477 0 0 2 6 0 6.453 15 1 15 15 0 0 2 6 0 8.5 2 1 15.5 2)
)
