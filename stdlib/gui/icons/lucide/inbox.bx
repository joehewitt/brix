(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-inbox
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideInbox (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 18 0 22 12 1 16 12 1 14 15 1 10 15 1 8 12 1 2 12 0 0 12 54 0 5.45 5.11 1 2 12 1 2 18 4 2 2 0 0 0 4 20 1 20 20 4 2 2 0 0 0 22 18 1 22 12 1 18.55 5.11 4 2 2 0 0 0 16.76 4 1 7.24 4 4 2 2 0 0 0 5.45 5.11 5)
)
