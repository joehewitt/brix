(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lectern
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLectern (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 16 12 1 19 12 4 2 2 0 0 0 20.902 10.62 1 21.958 7.287 4 1 1 0 0 0 21 6 1 3 6 4 1 1 0 0 0 2.042 7.287 1 3.098 10.621 4 2 2 0 0 0 5 12 1 8 12 0 0 4 17 0 18 6 1 18 3 4 1 1 0 0 0 17 2 1 14 2 0 0 10 48 0 9 10 1 15 10 4 1 1 0 0 1 16 11 1 16 21 4 1 1 0 0 1 15 22 1 9 22 4 1 1 0 0 1 8 21 1 8 11 4 1 1 0 0 1 9 10 5)
)
