(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-heart-crack
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeartCrack (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 35 0 12.409 5.824 2 11.707 6.616 11.259 7.32 10.994 7.99 1 13.147 10.146 4 0.5 0.5 0 0 1 13.147 10.853 1 10.854 13.146 4 0.5 0.5 0 0 0 10.854 13.853 1 12 15 0 0 9 53 0 13.508 20.313 4 2 2 0 0 1 10.508 20.332 1 5 15 2 3.5 13.5 2 11.8 2 9.5 4 5.5 5.5 0 0 1 11.591 5.823 4 0.6 0.6 0 0 0 12.409 5.824 4 5.5 5.5 0 0 1 22 9.5 2 22 11.79 20.5 13.5 19 15 5)
)
