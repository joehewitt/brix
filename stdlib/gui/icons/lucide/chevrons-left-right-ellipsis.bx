(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chevrons-left-right-ellipsis
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChevronsLeftRightEllipsis (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 12 1 12.01 12 0 0 2 6 0 16 12 1 16.01 12 0 0 3 9 0 17 7 1 22 12 1 17 17 0 0 3 9 0 7 7 1 2 12 1 7 17 0 0 2 6 0 8 12 1 8.01 12)
)
