(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-stars
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStars (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 17 89 0 11.017 2.814 4 1 1 0 0 1 12.983 2.814 1 14.034 8.372 4 2 2 0 0 0 15.628 9.966 1 21.186 11.017 4 1 1 0 0 1 21.186 12.983 1 15.628 14.034 4 2 2 0 0 0 14.034 15.628 1 12.983 21.186 4 1 1 0 0 1 11.017 21.186 1 9.966 15.628 4 2 2 0 0 0 8.372 14.034 1 2.814 12.983 4 1 1 0 0 1 2.814 11.017 1 8.372 9.966 4 2 2 0 0 0 9.966 8.372 5 0 0 2 6 0 20 2 1 20 6 0 0 2 6 0 22 4 1 18 4 1 0 4 20 2)
)
