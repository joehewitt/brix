(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-badge-dollar-sign
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBadgeDollarSign (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 68 0 3.85 8.62 4 4 4 0 0 1 8.63 3.85 4 4 4 0 0 1 15.37 3.85 4 4 4 0 0 1 20.15 8.63 4 4 4 0 0 1 20.15 15.37 4 4 4 0 0 1 15.38 20.15 4 4 4 0 0 1 8.63 20.15 4 4 4 0 0 1 3.85 15.38 4 4 4 0 0 1 3.85 8.62 5 0 0 6 28 0 16 8 1 10 8 4 2 2 0 1 0 10 12 1 14 12 4 2 2 0 1 1 14 16 1 8 16 0 0 2 6 0 12 18 1 12 6)
)
