(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zodiac-leo
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZodiacLeo (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 33 0 10 16 2 10 12 7 11.5 7 8 4 5 5 0 0 1 17 8 2 17 11.466 14 14.196 14 18 4 3 3 0 0 0 20 18 1 0 7 16 3)
)
