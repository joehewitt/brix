(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chart-pie
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChartPie (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 37 0 21 12 2 21.552 12 22.005 11.551 21.95 11.002 4 10 10 0 0 0 12.997 2.051 2 12.447 1.996 11.999 2.449 11.999 3.001 1 11.999 11.001 4 1 1 0 0 0 12.999 12.001 5 0 0 2 11 0 21.21 15.89 4 10 10 0 1 1 8 2.83)
)
