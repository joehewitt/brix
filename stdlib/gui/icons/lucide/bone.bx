(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bone
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBone (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 82 0 17 10 2 17.7 9.3 18.69 10 19.5 10 4 2.5 2.5 0 1 0 19.5 5 4 0.5 0.5 0 0 1 19 4.5 4 2.5 2.5 0 1 0 14 4.5 2 14 5.31 14.7 6.3 14 7 1 7 14 2 6.3 14.7 5.31 14 4.5 14 4 2.5 2.5 0 0 0 4.5 19 2 4.78 19 5 19.22 5 19.5 4 2.5 2.5 0 1 0 10 19.5 2 10 18.69 9.3 17.7 10 17 5)
)
