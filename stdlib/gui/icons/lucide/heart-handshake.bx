(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-heart-handshake
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeartHandshake (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 18 117 0 19.414 14.414 2 21 12.828 22 11.5 22 9.5 4 5.5 5.5 0 0 0 12.409 5.824 4 0.6 0.6 0 0 1 11.591 5.825 4 5.5 5.5 0 0 0 2 9.5 2 2 11.8 3.5 13.5 5 15 1 10.535 20.362 4 2 2 0 0 0 13.414 20.414 4 2.12 2.12 0 0 0 13.41 17.414 4 2.124 2.124 0 1 0 16.41 14.414 4 2.124 2.124 0 0 0 19.414 14.414 4 2 2 0 0 0 19.414 11.586 1 17.533 9.704 4 2.41 2.41 0 0 0 14.124 9.704 1 12.414 11.414 4 2 2 0 0 1 9.586 11.414 4 2 2 0 0 1 9.586 8.586 1 12.409 5.824)
)
