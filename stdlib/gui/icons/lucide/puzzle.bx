(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-puzzle
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePuzzle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 25 153 0 15.39 4.39 4 1 1 0 0 0 17.07 3.916 4 2.5 2.5 0 1 1 20.084 6.931 4 1 1 0 0 0 19.61 8.611 1 21.293 10.293 4 2.414 2.414 0 0 1 21.293 13.707 1 19.61 15.39 4 1 1 0 0 1 17.93 14.916 4 2.5 2.5 0 1 0 14.916 17.931 4 1 1 0 0 1 15.39 19.611 1 13.707 21.293 4 2.414 2.414 0 0 1 10.293 21.293 1 8.61 19.61 4 1 1 0 0 0 6.93 20.084 4 2.5 2.5 0 1 1 3.916 17.069 4 1 1 0 0 0 4.39 15.389 1 2.707 13.707 4 2.414 2.414 0 0 1 2.707 10.293 1 4.39 8.61 4 1 1 0 0 1 6.07 9.084 4 2.5 2.5 0 1 0 9.084 6.069 4 1 1 0 0 1 8.61 4.389 1 10.293 2.707 4 2.414 2.414 0 0 1 13.707 2.707 5)
)
