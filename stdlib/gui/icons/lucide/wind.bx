(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wind
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWind (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 12.8 19.6 4 2 2 0 1 0 14 16 1 2 16 0 0 3 14 0 17.5 8 4 2.5 2.5 0 1 1 19.5 12 1 2 12 0 0 3 14 0 9.8 4.4 4 2 2 0 1 1 11 8 1 2 8)
)
