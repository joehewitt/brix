(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-popcorn
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePopcorn (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 43 0 18 8 4 2 2 0 0 0 18 4 4 2 2 0 0 0 14 4 4 2 2 0 0 0 10 4 4 2 2 0 0 0 6 4 4 2 2 0 0 0 6 8 0 0 2 6 0 10 22 1 9 8 0 0 2 6 0 14 22 1 15 8 0 0 9 41 0 20 8 2 20.5 8 20.9 8.4 20.8 9 1 18.2 21 2 18.1 21.5 17.5 22 17 22 1 7 22 2 6.4 22 5.9 21.6 5.8 21 1 3.2 9 2 3.1 8.4 3.5 8 4 8 5)
)
