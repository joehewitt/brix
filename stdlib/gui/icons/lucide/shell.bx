(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shell
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShell (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 59 0 14 11 4 2 2 0 1 1 10 11 4 4 4 0 0 1 18 11 4 6 6 0 0 1 6 11 4 8 8 0 0 1 22 11 4 10 10 0 1 1 2 11 4 11.93 11.93 0 0 1 4.42 3.78 4 2 2 0 1 1 7.58 6.22)
)
