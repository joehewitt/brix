(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-eye-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEyeOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 27 0 10.733 5.076 4 10.744 10.744 0 0 1 21.938 11.651 4 1 1 0 0 1 21.938 12.347 4 10.747 10.747 0 0 1 20.494 14.837 0 0 2 11 0 14.084 14.158 4 3 3 0 0 1 9.842 9.916 0 0 4 27 0 17.479 17.499 4 10.75 10.75 0 0 1 2.062 12.348 4 1 1 0 0 1 2.062 11.652 4 10.75 10.75 0 0 1 6.508 6.509 0 0 2 6 0 2 2 1 22 22)
)
