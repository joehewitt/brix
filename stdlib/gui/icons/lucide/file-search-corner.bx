(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-search-corner
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileSearchCorner (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 11.1 22 1 6 22 4 2 2 0 0 1 4 20 1 4 4 4 2 2 0 0 1 6 2 1 14 2 4 2.4 2.4 0 0 1 15.706 2.706 1 19.295 6.294 4 2.4 2.4 0 0 1 20 8 1 20 11.25 0 0 4 17 0 14 2 1 14 7 4 1 1 0 0 0 15 8 1 20 8 0 0 2 6 0 21 22 1 18.12 19.12 1 0 16 17 3)
)
