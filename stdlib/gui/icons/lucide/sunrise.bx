(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sunrise
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSunrise (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 2 1 12 10 0 0 2 6 0 4.93 10.93 1 6.34 12.34 0 0 2 6 0 2 18 1 4 18 0 0 2 6 0 20 18 1 22 18 0 0 2 6 0 19.07 10.93 1 17.66 12.34 0 0 2 6 0 22 22 1 2 22 0 0 3 9 0 8 6 1 12 2 1 16 6 0 0 2 11 0 16 18 4 4 4 0 0 0 8 18)
)
