(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-folder-lock
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFolderLock (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 15 17 1 21 17 4 1 1 0 0 1 22 18 1 22 21 4 1 1 0 0 1 21 22 1 15 22 4 1 1 0 0 1 14 21 1 14 18 4 1 1 0 0 1 15 17 5 0 0 12 61 0 10 20 1 4 20 4 2 2 0 0 1 2 18 1 2 5 4 2 2 0 0 1 4 3 1 7.9 3 4 2 2 0 0 1 9.59 3.9 1 10.4 5.1 4 2 2 0 0 0 12.07 6 1 20 6 4 2 2 0 0 1 22 8 1 22 10.5 0 0 4 17 0 20 17 1 20 15 4 2 2 0 1 0 16 15 1 16 17)
)
