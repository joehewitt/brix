(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-message-circle-heart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMessageCircleHeart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 41 0 2.992 16.342 4 2 2 0 0 1 3.086 17.509 1 2.021 20.799 4 1 1 0 0 0 3.257 21.967 1 6.67 20.969 4 2 2 0 0 1 7.769 21.061 4 10 10 0 1 0 2.992 16.342 0 0 7 39 0 7.828 13.07 4 3 3 0 0 1 12 8.764 4 3 3 0 0 1 17.004 10.988 4 3 3 0 0 1 16.172 13.071 1 12.725 16.691 4 1 1 0 0 1 11.275 16.69 5)
)
