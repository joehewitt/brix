(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-refresh-ccw
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRefreshCcw (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 22 0 21 12 4 9 9 0 0 0 12 3 4 9.75 9.75 0 0 0 5.26 5.74 1 3 8 0 0 3 9 0 3 3 1 3 8 1 8 8 0 0 4 22 0 3 12 4 9 9 0 0 0 12 21 4 9.75 9.75 0 0 0 18.74 18.26 1 21 16 0 0 3 9 0 16 16 1 21 16 1 21 21)
)
