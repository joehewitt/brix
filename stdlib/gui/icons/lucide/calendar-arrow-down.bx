(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-calendar-arrow-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCalendarArrowDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 14 17 1 18 21 1 22 17 0 0 2 6 0 16 2 1 16 5 0 0 2 6 0 18 13 1 18 21 0 0 8 39 0 21 10.354 1 21 5 4 2 2 0 0 0 19 3 1 5 3 4 2 2 0 0 0 3 5 1 3 19 4 2 2 0 0 0 5 21 1 12.343 21 0 0 2 6 0 3 9 1 21 9 0 0 2 6 0 8 2 1 8 5)
)
