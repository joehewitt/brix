(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tablet-smartphone
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTabletSmartphone (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 8 1 11 8 4 2 2 0 0 1 13 10 1 13 20 4 2 2 0 0 1 11 22 1 5 22 4 2 2 0 0 1 3 20 1 3 10 4 2 2 0 0 1 5 8 5 0 0 7 36 0 5 4 4 2 2 0 0 1 7 2 1 19 2 4 2 2 0 0 1 21 4 1 21 20 4 2 2 0 0 1 19 22 1 16.6 22 0 0 2 6 0 8 18 1 8.01 18)
)
