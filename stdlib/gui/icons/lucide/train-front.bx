(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-train-front
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTrainFront (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 8 3.1 1 8 7 4 4 4 0 0 0 16 7 1 16 3.1 0 0 2 6 0 9 15 1 8 14 0 0 2 6 0 15 15 1 16 14 0 0 7 32 0 9 19 2 6.2 19 4 16.8 4 14 1 4 10 4 8 8 0 0 1 20 10 1 20 14 2 20 16.8 17.8 19 15 19 5 0 0 2 6 0 8 19 1 6 22 0 0 2 6 0 16 19 1 18 22)
)
