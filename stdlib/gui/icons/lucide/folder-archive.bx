(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-folder-archive
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFolderArchive (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 15 19 2 0 0 13 69 0 20.9 19.8 4 2 2 0 0 0 22 18 1 22 8 4 2 2 0 0 0 20 6 1 12.1 6 4 2 2 0 0 1 10.41 5.1 1 9.6 3.9 4 2 2 0 0 0 7.93 3 1 4 3 4 2 2 0 0 0 2 5 1 2 18 4 2 2 0 0 0 4 20 1 9.1 20 0 0 2 6 0 15 11 1 15 10 0 0 2 6 0 15 17 1 15 15)
)
