(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cable
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCable (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 17 19 4 1 1 0 0 1 16 18 1 16 16 4 2 2 0 0 1 18 14 1 20 14 4 2 2 0 0 1 22 16 1 22 18 4 1 1 0 0 1 21 19 5 0 0 2 6 0 17 21 1 17 19 0 0 6 28 0 19 14 1 19 6.5 4 1 1 0 0 0 12 6.5 1 12 17.5 4 1 1 0 0 1 5 17.5 1 5 10 0 0 2 6 0 21 21 1 21 19 0 0 2 6 0 3 5 1 3 3 0 0 9 45 0 4 10 4 2 2 0 0 1 2 8 1 2 6 4 1 1 0 0 1 3 5 1 7 5 4 1 1 0 0 1 8 6 1 8 8 4 2 2 0 0 1 6 10 5 0 0 2 6 0 7 5 1 7 3)
)
