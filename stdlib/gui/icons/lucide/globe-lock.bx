(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-globe-lock
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGlobeLock (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 27 0 15.686 15 4 14.5 14.5 0 0 1 12 22 4 14.5 14.5 0 0 1 12 2 4 10 10 0 1 0 21.542 15 0 0 2 6 0 2 12 1 10.5 12 0 0 4 17 0 20 6 1 20 4 4 2 2 0 1 0 16 4 1 16 6 0 0 10 48 0 15 6 1 21 6 4 1 1 0 0 1 22 7 1 22 10 4 1 1 0 0 1 21 11 1 15 11 4 1 1 0 0 1 14 10 1 14 7 4 1 1 0 0 1 15 6 5)
)
