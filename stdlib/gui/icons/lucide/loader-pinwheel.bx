(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-loader-pinwheel
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLoaderPinwheel (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 19 0 22 12 4 1 1 0 0 1 12 12 4 1 1 0 0 0 2 12 0 0 3 19 0 7 20.7 4 1 1 0 1 1 12 12 4 1 1 0 1 0 17 3.4 0 0 3 19 0 7 3.3 4 1 1 0 1 1 12 11.9 4 1 1 0 1 0 17 20.5 1 0 12 12 10)
)
