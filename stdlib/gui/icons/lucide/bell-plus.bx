(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bell-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBellPlus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 10.268 21 4 2 2 0 0 0 13.732 21 0 0 2 6 0 15 8 1 21 8 0 0 2 6 0 18 5 1 18 11 0 0 7 45 0 20.002 14.464 4 9 9 0 0 0 20.74 15.327 4 1 1 0 0 1 20 17 1 4 17 4 1 1 0 0 1 3.26 15.327 2 4.59 13.956 6 12.499 6 8 4 6 6 0 0 1 14.75 2.668)
)
