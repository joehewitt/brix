(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-balloon
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBalloon (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 12 16 1 12 17 4 2 2 0 0 0 14 19 1 15 19 4 2 2 0 0 1 17 21 1 17 22 0 0 2 11 0 12 6 4 2 2 0 0 1 14 8 0 0 4 25 0 18 8 2 18 12 14.5 16 12 16 2 9.5 16 6 12 6 8 4 6 6 0 0 1 18 8)
)
