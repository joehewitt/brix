(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-layer-arrow-up
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLayerArrowUp (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 14 1 12 4 0 0 9 47 0 7.674 10.774 1 2.58 13.09 4 1 1 0 0 0 2.58 14.912 1 11.18 18.822 4 2 2 0 0 0 12.83 18.822 1 21.41 14.922 4 1 1 0 0 0 22 14.002 4 1 1 0 0 0 21.41 13.08 1 16.332 10.772 0 0 3 9 0 9 7 1 12 4 1 15 7)
)
