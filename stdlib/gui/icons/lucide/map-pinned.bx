(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-map-pinned
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMapPinned (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 33 0 18 8 2 18 11.613 14.131 15.429 12.607 16.795 4 1 1 0 0 1 11.393 16.795 2 9.87 15.429 6 11.613 6 8 4 6 6 0 0 1 18 8 1 0 12 8 2 0 0 10 50 0 8.714 14 1 5.004 14 4 1 1 0 0 0 4.056 14.683 1 2.052 20.683 4 1 1 0 0 0 3 22 1 21 22 4 1 1 0 0 0 21.948 20.684 1 19.948 14.684 4 1 1 0 0 0 18.999 14 1 15.287 14)
)
