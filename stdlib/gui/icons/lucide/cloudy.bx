(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cloudy
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCloudy (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 23 0 17.5 12 4 1 1 0 1 1 17.5 21 1 9.006 21 4 7 7 0 1 1 15.708 12 5 0 0 4 22 0 21.832 9 4 3 3 0 0 0 19 7 1 16.793 7 4 5.5 5.5 0 0 0 6.073 7.61)
)
