(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bold
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBold (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 47 0 6 12 1 15 12 4 4 4 0 0 1 15 20 1 7 20 4 1 1 0 0 1 6 19 1 6 5 4 1 1 0 0 1 7 4 1 14 4 4 4 4 0 0 1 14 12)
)
