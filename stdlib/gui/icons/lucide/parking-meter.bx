(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-parking-meter
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideParkingMeter (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 15 1 13 15 0 0 2 6 0 12 12 1 12 15 0 0 2 6 0 12 19 1 12 22 0 0 7 34 0 15.282 19 4 1 1 0 0 0 16.23 18.32 1 18.6 11.332 4 7 7 0 1 0 5.4 11.332 1 7.77 18.32 4 1 1 0 0 0 8.718 19 5 0 0 2 11 0 9 9 4 3 3 0 1 1 15 9)
)
