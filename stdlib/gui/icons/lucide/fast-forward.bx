(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-fast-forward
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFastForward (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 34 0 12 6 4 2 2 0 0 1 15.414 4.586 1 21.414 10.586 4 2 2 0 0 1 21.414 13.414 1 15.414 19.414 4 2 2 0 0 1 12 18 5 0 0 7 34 0 2 6 4 2 2 0 0 1 5.414 4.586 1 11.414 10.586 4 2 2 0 0 1 11.414 13.414 1 5.414 19.414 4 2 2 0 0 1 2 18 5)
)
