(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-plane-takeoff
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePlaneTakeoff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 22 1 22 22 0 0 22 103 0 6.36 17.4 1 4 17 1 2 13 1 3.1 12.45 4 2 2 0 0 1 4.9 12.45 1 5.07 12.55 4 2 2 0 0 0 6.87 12.55 1 8 12 1 5 6 1 5.9 5.55 4 2 2 0 0 1 7.99 5.75 1 12.01 8.75 4 2 2 0 0 0 14.11 8.95 1 18.3 6.89 4 2.41 2.41 0 0 1 20.03 6.72 1 21 7 4 1.4 1.4 0 0 1 21.87 8.99 1 21.49 9.75 2 21.26 10.21 20.89 10.59 20.42 10.83 1 7.58 17.2 4 2 2 0 0 1 6.36 17.38 5)
)
