(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-start-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignStartHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 6 6 1 8 6 4 2 2 0 0 1 10 8 1 10 20 4 2 2 0 0 1 8 22 1 6 22 4 2 2 0 0 1 4 20 1 4 8 4 2 2 0 0 1 6 6 5 0 0 10 48 0 16 6 1 18 6 4 2 2 0 0 1 20 8 1 20 13 4 2 2 0 0 1 18 15 1 16 15 4 2 2 0 0 1 14 13 1 14 8 4 2 2 0 0 1 16 6 5 0 0 2 6 0 22 2 1 2 2)
)
