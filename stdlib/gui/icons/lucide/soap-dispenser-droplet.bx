(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-soap-dispenser-droplet
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSoapDispenserDroplet (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10.5 2 1 10.5 6 0 0 3 14 0 14 2 1 7 2 4 2 2 0 0 0 5 4 0 0 7 47 0 19.29 14.76 4 6.67 6.67 0 0 1 17 11 4 6.6 6.6 0 0 1 14.71 14.76 2 13.56 15.68 13 16.8 13 17.95 2 13 20.17 14.8 22 17 22 2 19.2 22 21 20.17 21 17.95 2 21 16.79 20.43 15.69 19.29 14.76 0 0 11 53 0 9.607 21 1 6 21 4 2 2 0 0 1 4 19 1 4 12 4 2 2 0 0 1 6 10 1 13 10 1 13 7 4 1 1 0 0 0 12 6 1 9 6 4 1 1 0 0 0 8 7 1 8 10)
)
