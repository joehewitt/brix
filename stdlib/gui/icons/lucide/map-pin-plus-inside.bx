(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-map-pin-plus-inside
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMapPinPlusInside (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 33 0 20 10 2 20 14.993 14.461 20.193 12.601 21.799 4 1 1 0 0 1 11.399 21.799 2 9.539 20.193 4 14.993 4 10 4 8 8 0 0 1 20 10 0 0 2 6 0 12 7 1 12 13 0 0 2 6 0 9 10 1 15 10)
)
