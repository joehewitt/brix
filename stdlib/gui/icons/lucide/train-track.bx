(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-train-track
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTrainTrack (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 17 1 17 2 0 0 2 6 0 2 14 1 10 22 0 0 2 6 0 5 11 1 13 19 0 0 2 6 0 8 8 1 16 16 0 0 2 6 0 11 5 1 19 13 0 0 2 6 0 14 2 1 22 10 0 0 2 6 0 7 22 1 22 7)
)
