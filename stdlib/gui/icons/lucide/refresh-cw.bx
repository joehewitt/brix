(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-refresh-cw
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRefreshCw (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 22 0 3 12 4 9 9 0 0 1 12 3 4 9.75 9.75 0 0 1 18.74 5.74 1 21 8 0 0 3 9 0 21 3 1 21 8 1 16 8 0 0 4 22 0 21 12 4 9 9 0 0 1 12 21 4 9.75 9.75 0 0 1 5.26 18.26 1 3 16 0 0 3 9 0 8 16 1 3 16 1 3 21)
)
