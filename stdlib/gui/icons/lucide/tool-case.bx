(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tool-case
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideToolCase (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 15 1 14 15 0 0 11 48 0 14.817 10.995 1 13.846 9.545 1 14.88 8.313 4 2 2 0 0 0 12.855 5.075 1 11.035 5.439 1 9.91 3.885 4 2 2 0 0 0 6.285 4.633 1 6.141 6.55 1 4.416 6.976 4 2 2 0 0 0 4.226 10.732 1 4.883 11.002 0 0 6 28 0 18.822 10.995 1 21.082 5.615 4 1 1 0 0 0 20.525 4.297 1 16.954 2.9 4 1 1 0 0 0 15.673 3.433 1 14.749 5.555 0 0 9 45 0 4 12.006 4 1 1 0 0 1 4.994 11 1 19 11 4 1 1 0 0 1 20 12 1 20 19 4 2 2 0 0 1 18 21 1 6 21 4 2 2 0 0 1 4 19 5)
)
