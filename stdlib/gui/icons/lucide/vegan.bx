(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-vegan
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVegan (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 13 0 16 8 3 22 8 22 2 3 16 2 16 8 0 0 2 11 0 17.41 3.59 4 10 10 0 1 0 20.41 6.59 0 0 3 18 0 2 2 4 26.6 26.6 0 0 1 12 22 2 12.9 15.18 13.5 12.5 16 8)
)
