(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-message-square-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMessageSquareOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 36 0 19 19 1 6.828 19 4 2 2 0 0 0 5.414 19.586 1 3.212 21.788 4 0.7 0.7 0 0 1 2 21.286 1 2 5 4 2 2 0 0 1 3.184 3.174 0 0 2 6 0 2 2 1 22 22 0 0 4 17 0 8.656 3 1 20 3 4 2 2 0 0 1 22 5 1 22 16.344)
)
