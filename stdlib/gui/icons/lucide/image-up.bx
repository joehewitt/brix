(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-image-up
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideImageUp (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 53 0 10.3 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 15 1 17.9 11.9 4 2 2 0 0 0 15.086 11.914 1 6 21 0 0 3 9 0 14 19.5 1 17 16.5 1 20 19.5 0 0 2 6 0 17 22 1 17 16.5 1 0 9 9 2)
)
