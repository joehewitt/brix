(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sport-shoe
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSportShoe (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 10.42 1 19.8 5.35 0 0 2 6 0 19 18 1 22 18 0 0 12 65 0 9.5 22 1 21.414 9.415 4 2 2 0 0 0 21.2 6.4 1 15.59 2.192 4 1 1 0 0 0 14 3 1 14 5 4 2 2 0 0 1 12.606 6.906 1 8.677 8.053 4 1 1 0 0 0 8 9 2 7.845 15.393 5.918 18 4 18 4 2 2 0 0 0 4 22 1 18 22)
)
