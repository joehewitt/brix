(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-axe
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAxe (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 14 12 1 5.619 20.38 4 1 1 0 0 1 2.618 17.38 1 11 9 0 0 13 72 0 15 15.5 4 0.5 0.5 0 0 0 15.5 16 4 6.5 6.5 0 0 0 22 9.5 4 0.5 0.5 0 0 0 21.5 9 1 19.828 9 4 2 2 0 0 1 18.414 8.414 1 13.352 3.352 4 1.205 1.205 0 0 0 11.648 3.352 1 9.352 5.648 4 1.205 1.205 0 0 0 9.352 7.352 1 14.414 12.414 4 2 2 0 0 1 15 13.828 5)
)
