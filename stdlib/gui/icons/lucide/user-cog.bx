(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-user-cog
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUserCog (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 10 15 1 6 15 4 4 4 0 0 0 2 19 1 2 21 0 0 2 6 0 14.305 16.53 1 15.228 16.148 0 0 2 6 0 15.228 13.852 1 14.305 13.469 0 0 2 6 0 16.852 12.228 1 16.469 11.305 0 0 2 6 0 16.852 17.772 1 16.469 18.696 0 0 2 6 0 19.148 12.228 1 19.531 11.305 0 0 2 6 0 19.53 18.696 1 19.148 17.772 0 0 2 6 0 20.772 13.852 1 21.696 13.469 0 0 2 6 0 20.772 16.148 1 21.696 16.531 1 0 18 15 3 1 0 9 7 4)
)
