(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-candy-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCandyOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 10 1 10 17.9 0 0 2 11 0 11.802 6.145 4 5 5 0 0 1 17.855 12.198 0 0 2 6 0 14 6.1 1 14 8.343 0 0 5 25 0 15.5 15.571 1 14.536 16.535 4 5 5 0 0 1 7.465 16.535 4 5 5 0 0 1 7.465 9.465 1 8.429 8.5 0 0 8 49 0 16 7 1 16 3 4 1 1 0 0 1 17.707 2.293 4 2.5 2.5 0 0 0 19.859 3.01 4 1 1 0 0 1 20.99 4.141 4 2.5 2.5 0 0 0 21.707 6.293 4 1 1 0 0 1 21 8 1 17 8 0 0 2 6 0 2 2 1 22 22 0 0 8 49 0 8 17 1 8 21 4 1 1 0 0 1 6.293 21.707 4 2.5 2.5 0 0 0 4.141 20.99 4 1 1 0 0 1 3.01 19.859 4 2.5 2.5 0 0 0 2.293 17.707 4 1 1 0 0 1 3 16 1 7 16)
)
