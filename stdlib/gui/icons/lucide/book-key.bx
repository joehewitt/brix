(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-book-key
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBookKey (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 13 2 1 6.5 2 4 2.5 2.5 0 0 0 4 4.5 1 4 19.5 0 0 2 6 0 17 2 1 17 8 0 0 2 6 0 17 4 1 19 4 0 0 6 28 0 20 15.2 1 20 21 4 1 1 0 0 1 19 22 1 6.5 22 4 1 1 0 0 1 6.5 17 1 20 17 1 0 17 10 2)
)
