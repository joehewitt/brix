(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-skip-back
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSkipBack (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 34 0 17.971 4.285 4 2 2 0 0 1 21 6 1 21 18 4 2 2 0 0 1 17.971 19.715 1 7.974 13.717 4 2 2 0 0 1 7.971 10.285 5 0 0 2 6 0 3 20 1 3 4)
)
