(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-paw-print
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePawPrint (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 11 4 2 1 0 18 8 2 1 0 20 16 2 0 0 7 36 0 9 10 4 5 5 0 0 1 14 15 1 14 18.5 4 3.5 3.5 0 0 1 7.16 19.545 3 6.52 17.48 4.46 16.84 4 3.5 3.5 0 0 1 5.5 10 5)
)
