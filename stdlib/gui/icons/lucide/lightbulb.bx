(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lightbulb
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLightbulb (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 39 0 15 14 2 15.2 13 15.7 12.3 16.5 11.5 2 17.5 10.6 18 9.3 18 8 4 6 6 0 0 0 6 8 2 6 9 6.2 10.2 7.5 11.5 2 8.2 12.2 8.8 13 9 14 0 0 2 6 0 9 18 1 15 18 0 0 2 6 0 10 22 1 14 22)
)
