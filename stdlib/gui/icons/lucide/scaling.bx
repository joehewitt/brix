(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-scaling
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScaling (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 12 3 1 5 3 4 2 2 0 0 0 3 5 1 3 19 4 2 2 0 0 0 5 21 1 19 21 4 2 2 0 0 0 21 19 1 21 12 0 0 3 9 0 14 15 1 9 15 1 9 10 0 0 3 9 0 16 3 1 21 3 1 21 8 0 0 2 6 0 21 3 1 9 15)
)
