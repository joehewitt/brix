(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bird
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBird (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 7 1 16.01 7 0 0 6 28 0 3.4 18 1 12 18 4 8 8 0 0 0 20 10 1 20 7 4 4 4 0 0 0 12.72 4.7 1 2 20 0 0 3 9 0 20 7 1 22 7.5 1 20 8 0 0 2 6 0 10 18 1 10 21 0 0 2 6 0 14 17.75 1 14 21 0 0 2 11 0 7 18 4 6 6 0 0 0 10.84 7.39)
)
