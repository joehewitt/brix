(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shopping-basket
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShoppingBasket (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 11 1 14 20 0 0 2 6 0 19 11 1 15 4 0 0 2 6 0 2 11 1 22 11 0 0 6 28 0 3.5 11 1 5.1 18.4 4 2 2 0 0 0 7.1 20 1 16.9 20 4 2 2 0 0 0 18.9 18.4 1 20.6 11 0 0 2 6 0 4.5 15.5 1 19.5 15.5 0 0 2 6 0 5 11 1 9 4 0 0 2 6 0 9 11 1 10 20)
)
