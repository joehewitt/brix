(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-heading-4
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeadingN4 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 18 1 12 6 0 0 4 17 0 17 10 1 17 13 4 1 1 0 0 0 18 14 1 21 14 0 0 2 6 0 21 10 1 21 18 0 0 2 6 0 4 12 1 12 12 0 0 2 6 0 4 18 1 4 6)
)
