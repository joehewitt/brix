(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-concierge-bell
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideConciergeBell (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 3 20 4 1 1 0 0 1 2 19 1 2 18 4 2 2 0 0 1 4 16 1 20 16 4 2 2 0 0 1 22 18 1 22 19 4 1 1 0 0 1 21 20 5 0 0 2 11 0 20 16 4 8 8 0 1 0 4 16 0 0 2 6 0 12 4 1 12 8 0 0 2 6 0 10 4 1 14 4)
)
