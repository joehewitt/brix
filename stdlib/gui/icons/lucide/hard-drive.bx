(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hard-drive
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHardDrive (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 16 1 10.01 16 0 0 13 67 0 2.212 11.577 4 2 2 0 0 0 2 12.473 1 2 18 4 2 2 0 0 0 4 20 1 20 20 4 2 2 0 0 0 22 18 1 22 12.473 4 2 2 0 0 0 21.788 11.577 1 18.55 5.11 4 2 2 0 0 0 16.76 4 1 7.24 4 4 2 2 0 0 0 5.45 5.11 5 0 0 2 6 0 21.946 12.013 1 2.054 12.013 0 0 2 6 0 6 16 1 6.01 16)
)
