(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-server-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideServerOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 7 2 1 20 2 4 2 2 0 0 1 22 4 1 22 8 4 2 2 0 0 1 20 10 1 15 10 0 0 7 28 0 10 10 1 2.5 2.5 2 2 2 2 2.5 2 5 1 2 8 4 2 2 0 0 0 4 10 1 10 10 5 0 0 4 17 0 22 17 1 22 16 4 2 2 0 0 0 20 14 1 19 14 0 0 10 38 0 4 14 4 2 2 0 0 0 2 16 1 2 20 4 2 2 0 0 0 4 22 1 20.5 22 1 21.5 21.5 1 22 22 1 14 14 1 4 14 5 0 0 2 6 0 6 18 1 6.01 18 0 0 2 6 0 2 2 1 22 22)
)
