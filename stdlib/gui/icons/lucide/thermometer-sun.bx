(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-thermometer-sun
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideThermometerSun (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 2 1 12 4 0 0 2 11 0 12 8 4 4 4 0 0 0 10.355 15.647 0 0 2 6 0 2 12 1 4 12 0 0 5 23 0 20 14.54 4 4 4 0 1 1 16 14.54 1 16 4 4 2 2 0 0 1 20 4 5 0 0 2 6 0 4.93 4.93 1 6.34 6.34 0 0 2 6 0 6.34 17.66 1 4.93 19.07)
)
