(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chart-column-big
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChartColumnBig (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 3 3 1 3 19 4 2 2 0 0 0 5 21 1 21 21 0 0 10 48 0 16 5 1 18 5 4 1 1 0 0 1 19 6 1 19 16 4 1 1 0 0 1 18 17 1 16 17 4 1 1 0 0 1 15 16 1 15 6 4 1 1 0 0 1 16 5 5 0 0 10 48 0 8 8 1 10 8 4 1 1 0 0 1 11 9 1 11 16 4 1 1 0 0 1 10 17 1 8 17 4 1 1 0 0 1 7 16 1 7 9 4 1 1 0 0 1 8 8 5)
)
