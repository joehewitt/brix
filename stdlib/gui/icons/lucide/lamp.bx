(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lamp
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLamp (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 12 1 12 18 0 0 9 45 0 4.077 10.615 4 1 1 0 0 0 5 12 1 19 12 4 1 1 0 0 0 19.923 10.615 1 16.846 3.231 4 2 2 0 0 0 15 2 1 9 2 4 2 2 0 0 0 7.154 3.23 5 0 0 9 45 0 8 20 4 2 2 0 0 1 10 18 1 14 18 4 2 2 0 0 1 16 20 1 16 21 4 1 1 0 0 1 15 22 1 9 22 4 1 1 0 0 1 8 21 5)
)
