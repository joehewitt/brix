(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-gallery-thumbnails
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGalleryThumbnails (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 15 4 2 2 0 0 1 19 17 1 5 17 4 2 2 0 0 1 3 15 1 3 5 4 2 2 0 0 1 5 3 5 0 0 2 6 0 4 21 1 5 21 0 0 2 6 0 9 21 1 10 21 0 0 2 6 0 14 21 1 15 21 0 0 2 6 0 19 21 1 20 21)
)
