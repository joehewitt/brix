(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-timer-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTimerOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 2 1 14 2 0 0 3 19 0 4.6 11 4 8 8 0 0 0 6.3 19.7 4 8 8 0 0 0 15 21.4 0 0 3 19 0 7.4 7.4 4 8 8 0 0 1 17.7 8.4 4 8 8 0 0 1 18.6 18.6 0 0 2 6 0 2 2 1 22 22 0 0 2 6 0 12 12 1 12 10)
)
