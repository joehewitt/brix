(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-timer-reset
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTimerReset (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 2 1 14 2 0 0 2 6 0 12 14 1 12 10 0 0 4 22 0 4 13 4 8 8 0 0 1 12 6 4 8 8 0 1 1 6.7 20 1 4 17.6 0 0 3 9 0 9 17 1 4 17 1 4 22)
)
