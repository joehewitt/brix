(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-leaf
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLeaf (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 33 0 11 20 4 7 7 0 0 1 9.8 6.1 2 15.5 5 17 4.48 19 2 2 20 4 21 6.18 21 10 2 21 15.5 16.22 20 11 20 5 0 0 3 17 0 2 21 2 2 18 3.85 15.64 7.08 15 2 9.5 14.52 12 13 13 12)
)
