(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-squares-unite
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquaresUnite (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 17 89 0 4 16 4 2 2 0 0 1 2 14 1 2 4 4 2 2 0 0 1 4 2 1 14 2 4 2 2 0 0 1 16 4 1 16 7 4 1 1 0 0 0 17 8 1 20 8 4 2 2 0 0 1 22 10 1 22 20 4 2 2 0 0 1 20 22 1 10 22 4 2 2 0 0 1 8 20 1 8 17 4 1 1 0 0 0 7 16 5)
)
