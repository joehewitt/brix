(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bed-double
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBedDouble (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 2 20 1 2 12 4 2 2 0 0 1 4 10 1 20 10 4 2 2 0 0 1 22 12 1 22 20 0 0 6 28 0 4 10 1 4 6 4 2 2 0 0 1 6 4 1 18 4 4 2 2 0 0 1 20 6 1 20 10 0 0 2 6 0 12 4 1 12 10 0 0 2 6 0 2 18 1 22 18)
)
