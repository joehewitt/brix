(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-dna
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDna (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 16 1 11.5 17.5 0 0 2 6 0 14 8 1 12.5 6.5 0 0 2 10 0 15 2 2 13.202 3.998 12.482 5.995 12.193 7.993 0 0 2 6 0 16.5 10.5 1 17.5 11.5 0 0 2 6 0 17 6 1 14.109 3.109 0 0 2 10 0 2 15 2 8.667 9 15.333 15 22 9 0 0 2 6 0 20 9 1 20.891 9.891 0 0 2 6 0 3.109 14.109 1 4 15 0 0 2 6 0 6.5 12.5 1 7.5 13.5 0 0 2 6 0 7 18 1 9.891 20.891 0 0 2 10 0 9 22 2 10.798 20.002 11.518 18.005 11.807 16.007)
)
