(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cloud-alert
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCloudAlert (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 12 1 12 16 0 0 2 6 0 12 20 1 12.01 20 0 0 5 25 0 8.128 16.949 4 7 7 0 1 1 15.71 8 1 17.5 8 4 1 1 0 0 1 17.5 17 1 15.858 17)
)
