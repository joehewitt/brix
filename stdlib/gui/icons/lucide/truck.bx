(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-truck
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTruck (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 14 18 1 14 6 4 2 2 0 0 0 12 4 1 4 4 4 2 2 0 0 0 2 6 1 2 17 4 1 1 0 0 0 3 18 1 5 18 0 0 2 6 0 15 18 1 9 18 0 0 8 39 0 19 18 1 21 18 4 1 1 0 0 0 22 17 1 22 13.35 4 1 1 0 0 0 21.78 12.726 1 18.3 8.376 4 1 1 0 0 0 17.52 8 1 14 8 1 0 17 18 2 1 0 7 18 2)
)
