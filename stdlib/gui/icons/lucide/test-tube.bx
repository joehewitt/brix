(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-test-tube
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTestTube (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 23 0 14.5 2 1 14.5 19.5 2 14.5 20.9 13.4 22 12 22 2 10.6 22 9.5 20.9 9.5 19.5 1 9.5 2 0 0 2 6 0 8.5 2 1 15.5 2 0 0 2 6 0 14.5 16 1 9.5 16)
)
