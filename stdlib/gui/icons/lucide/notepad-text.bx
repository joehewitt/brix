(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-notepad-text
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideNotepadText (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 8 2 1 8 6 0 0 2 6 0 12 2 1 12 6 0 0 2 6 0 16 2 1 16 6 0 0 10 48 0 6 4 1 18 4 4 2 2 0 0 1 20 6 1 20 20 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4 20 1 4 6 4 2 2 0 0 1 6 4 5 0 0 2 6 0 8 10 1 14 10 0 0 2 6 0 8 14 1 16 14 0 0 2 6 0 8 18 1 13 18)
)
