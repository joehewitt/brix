(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-squirrel
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquirrel (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 15.236 22 4 3 3 0 0 0 13.036 17 0 0 7 36 0 16 20 4 3 3 0 0 1 19 17 1 20 17 4 2 2 0 0 0 22 15 1 22 13 4 4 4 0 0 0 18 9 1 18 4 0 0 2 6 0 18 13 1 18.01 13 0 0 9 59 0 18 6 4 4 4 0 0 0 14 10 4 7 7 0 0 0 7 17 2 7 12 11 12 11 6.5 4 4.5 4.5 0 1 0 2 6.5 4 2.5 2.5 0 0 0 7 6.5 2 7 10 3 11 3 17 2 3 19.8 5.2 22 8 22 1 18 22)
)
