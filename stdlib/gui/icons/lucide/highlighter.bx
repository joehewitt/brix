(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-highlighter
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHighlighter (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 15 0 9 11 1 3 17 1 3 20 1 12 20 1 15 17 0 0 6 28 0 22 12 1 17.4 16.6 4 2 2 0 0 1 14.6 16.6 1 9.4 11.4 4 2 2 0 0 1 9.4 8.6 1 14 4)
)
