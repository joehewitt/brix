(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-roller-coaster
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRollerCoaster (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 6 19 1 6 5 0 0 2 6 0 10 19 1 10 6.8 0 0 2 6 0 14 19 1 14 11.2 0 0 2 6 0 18 5 1 18 9 0 0 2 6 0 18 19 1 18 13 0 0 2 6 0 22 19 1 22 9 0 0 6 36 0 2 19 1 2 9 4 4 4 0 0 1 6 5 2 8 5 10 6.33 12 9 2 14 11.67 16 13 18 13 4 4 4 0 1 0 15 6.35)
)
