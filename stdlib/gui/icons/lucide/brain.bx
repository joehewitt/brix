(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-brain
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBrain (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 18 1 12 5 0 0 3 19 0 15 13 4 4.17 4.17 0 0 1 12 9 4 4.17 4.17 0 0 1 9 13 0 0 3 19 0 17.598 6.5 4 3 3 0 1 0 12 5 4 3 3 0 1 0 6.402 6.5 0 0 2 11 0 17.997 5.125 4 4 4 0 0 1 20.523 10.895 0 0 2 11 0 18 18 4 4 4 0 0 0 20 10.536 0 0 3 19 0 19.967 17.483 4 4 4 0 1 1 12 18 4 4 4 0 1 1 4.033 17.483 0 0 2 11 0 6 18 4 4 4 0 0 1 4 10.536 0 0 2 11 0 6.003 5.125 4 4 4 0 0 0 3.477 10.895)
)
