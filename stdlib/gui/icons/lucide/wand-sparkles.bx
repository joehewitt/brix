(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wand-sparkles
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWandSparkles (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 47 0 21.64 3.64 1 20.36 2.36 4 1.21 1.21 0 0 0 18.64 2.36 1 2.36 18.64 4 1.21 1.21 0 0 0 2.36 20.36 1 3.64 21.64 4 1.2 1.2 0 0 0 5.36 21.64 1 21.64 5.36 4 1.2 1.2 0 0 0 21.64 3.64 0 0 2 6 0 14 7 1 17 10 0 0 2 6 0 5 6 1 5 10 0 0 2 6 0 19 14 1 19 18 0 0 2 6 0 10 2 1 10 4 0 0 2 6 0 7 8 1 3 8 0 0 2 6 0 21 16 1 17 16 0 0 2 6 0 11 3 1 9 3)
)
