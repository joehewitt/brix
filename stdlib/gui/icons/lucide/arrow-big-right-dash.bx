(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-arrow-big-right-dash
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArrowBigRightDash (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 15 78 0 11 9 4 1 1 0 0 0 12 8 1 12 4.707 4 0.707 0.707 0 0 1 13.207 4.207 1 20.147 11.147 4 1.207 1.207 0 0 1 20.147 12.854 1 13.207 19.794 4 0.707 0.707 0 0 1 12 19.294 1 12 16 4 1 1 0 0 0 11 15 1 9 15 4 1 1 0 0 1 8 14 1 8 10 4 1 1 0 0 1 9 9 5 0 0 2 6 0 4 9 1 4 15)
)
