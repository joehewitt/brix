(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sliders-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSlidersHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 5 1 3 5 0 0 2 6 0 12 19 1 3 19 0 0 2 6 0 14 3 1 14 7 0 0 2 6 0 16 17 1 16 21 0 0 2 6 0 21 12 1 12 12 0 0 2 6 0 21 19 1 16 19 0 0 2 6 0 21 5 1 14 5 0 0 2 6 0 8 10 1 8 14 0 0 2 6 0 8 12 1 3 12)
)
