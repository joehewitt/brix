(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-earth
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEarth (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 21.54 15 1 17 15 4 2 2 0 0 0 15 17 1 15 21.54 0 0 8 47 0 7 3.34 1 7 5 4 3 3 0 0 0 10 8 4 2 2 0 0 1 12 10 2 12 11.1 12.9 12 14 12 4 2 2 0 0 0 16 10 2 16 8.9 16.9 8 18 8 1 21.17 8 0 0 7 36 0 11 21.95 1 11 18 4 2 2 0 0 0 9 16 4 2 2 0 0 1 7 14 1 7 13 4 2 2 0 0 0 5 11 1 2.05 11 1 0 12 12 10)
)
