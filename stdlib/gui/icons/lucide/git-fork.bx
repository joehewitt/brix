(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-git-fork
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGitFork (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 18 3 1 0 6 6 3 1 0 18 6 3 0 0 6 26 0 18 9 1 18 11 2 18 11.6 17.6 12 17 12 1 7 12 2 6.4 12 6 11.6 6 11 1 6 9 0 0 2 6 0 12 12 1 12 15)
)
