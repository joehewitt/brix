(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-qr-code
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideQrCode (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 3 1 7 3 4 1 1 0 0 1 8 4 1 8 7 4 1 1 0 0 1 7 8 1 4 8 4 1 1 0 0 1 3 7 1 3 4 4 1 1 0 0 1 4 3 5 0 0 10 48 0 17 3 1 20 3 4 1 1 0 0 1 21 4 1 21 7 4 1 1 0 0 1 20 8 1 17 8 4 1 1 0 0 1 16 7 1 16 4 4 1 1 0 0 1 17 3 5 0 0 10 48 0 4 16 1 7 16 4 1 1 0 0 1 8 17 1 8 20 4 1 1 0 0 1 7 21 1 4 21 4 1 1 0 0 1 3 20 1 3 17 4 1 1 0 0 1 4 16 5 0 0 4 17 0 21 16 1 18 16 4 2 2 0 0 0 16 18 1 16 21 0 0 2 6 0 21 21 1 21 21.01 0 0 4 17 0 12 7 1 12 10 4 2 2 0 0 1 10 12 1 7 12 0 0 2 6 0 3 12 1 3.01 12 0 0 2 6 0 12 3 1 12.01 3 0 0 2 6 0 12 16 1 12 16.01 0 0 2 6 0 16 12 1 17 12 0 0 2 6 0 21 12 1 21 12.01 0 0 2 6 0 12 21 1 12 20)
)
