(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hexagon
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHexagon (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 14 70 0 21 16 1 21 8 4 2 2 0 0 0 20 6.27 1 13 2.27 4 2 2 0 0 0 11 2.27 1 4 6.27 4 2 2 0 0 0 3 8 1 3 16 4 2 2 0 0 0 4 17.73 1 11 21.73 4 2 2 0 0 0 13 21.73 1 20 17.73 4 2 2 0 0 0 21 16 5)
)
