(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-route-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRouteOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 6 19 3 0 0 3 13 0 9 19 1 17.5 19 2 17.9 19 18.4 18.9 18.8 18.8 0 0 3 14 0 5.2 5.2 4 3.5 3.53 0 0 0 6.5 12 1 12 12 0 0 2 6 0 2 2 1 22 22 0 0 2 11 0 21 15.3 4 3.5 3.5 0 0 0 17.7 12 0 0 2 6 0 15 5 1 10.7 5 1 0 18 5 3)
)
