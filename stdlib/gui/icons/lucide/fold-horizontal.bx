(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-fold-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFoldHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 12 1 8 12 0 0 2 6 0 22 12 1 16 12 0 0 2 6 0 12 2 1 12 4 0 0 2 6 0 12 8 1 12 10 0 0 2 6 0 12 14 1 12 16 0 0 2 6 0 12 20 1 12 22 0 0 3 9 0 19 9 1 16 12 1 19 15 0 0 3 9 0 5 15 1 8 12 1 5 9)
)
