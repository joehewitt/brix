(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-drumstick
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDrumstick (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 19 0 15.4 15.63 4 7.875 6 135 1 1 21.63 9.4 4 4.5 3.43 135 0 0 15.4 15.63 0 0 5 25 0 8.29 12.71 1 5.69 15.31 4 2.5 2.5 0 1 0 4.04 19.96 4 2.5 2.5 0 1 0 8.7 18.3 1 11.29 15.71)
)
