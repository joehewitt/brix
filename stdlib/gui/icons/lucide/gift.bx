(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-gift
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGift (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 7 1 12 21 0 0 6 28 0 20 11 1 20 19 4 2 2 0 0 1 18 21 1 6 21 4 2 2 0 0 1 4 19 1 4 11 0 0 5 35 0 7.5 7 4 1 1 0 0 1 7.5 2 4 4.8 8 0 0 1 12 7 4 4.8 8 0 0 1 16.5 2 4 1 1 0 0 1 16.5 7 0 0 10 48 0 4 7 1 20 7 4 1 1 0 0 1 21 8 1 21 10 4 1 1 0 0 1 20 11 1 4 11 4 1 1 0 0 1 3 10 1 3 8 4 1 1 0 0 1 4 7 5)
)
