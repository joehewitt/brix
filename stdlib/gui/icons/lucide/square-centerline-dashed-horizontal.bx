(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-square-centerline-dashed-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquareCenterlineDashedHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 27 0 8 3 1 5 3 4 2 2 0 0 0 3 5 1 3 19 2 3 20.1 3.9 21 5 21 1 8 21 0 0 6 28 0 16 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 1 16 21 0 0 2 6 0 12 20 1 12 22 0 0 2 6 0 12 14 1 12 16 0 0 2 6 0 12 8 1 12 10 0 0 2 6 0 12 2 1 12 4)
)
