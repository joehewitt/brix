(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-heading-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeadingN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4 12 1 12 12 0 0 2 6 0 4 18 1 4 6 0 0 2 6 0 12 18 1 12 6 0 0 4 20 0 21 18 1 17 18 2 17 14 21 15 21 12 2 21 10.5 19 9.5 17 11)
)
