(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-square-pen
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquarePen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 12 3 1 5 3 4 2 2 0 0 0 3 5 1 3 19 4 2 2 0 0 0 5 21 1 19 21 4 2 2 0 0 0 21 19 1 21 12 0 0 9 45 0 18.375 2.625 4 1 1 0 0 1 21.375 5.625 1 12.362 14.639 4 2 2 0 0 1 11.509 15.144 1 8.636 15.984 4 0.5 0.5 0 0 1 8.016 15.364 1 8.856 12.491 4 2 2 0 0 1 9.362 11.639 5)
)
