(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sigma
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSigma (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 61 0 18 7 1 18 5 4 1 1 0 0 0 17 4 1 6.5 4 4 0.5 0.5 0 0 0 6.1 4.8 1 10.6 10.8 4 2 2 0 0 1 10.6 13.2 1 6.1 19.2 4 0.5 0.5 0 0 0 6.5 20 1 17 20 4 1 1 0 0 0 18 19 1 18 17)
)
