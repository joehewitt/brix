(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-decimals-arrow-left
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDecimalsArrowLeft (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 13 21 1 10 18 1 13 15 0 0 2 6 0 20 18 1 10 18 0 0 2 6 0 3 11 1 3.01 11 0 0 10 48 0 8.5 3 1 8.5 3 4 2.5 2.5 0 0 1 11 5.5 1 11 8.5 4 2.5 2.5 0 0 1 8.5 11 1 8.5 11 4 2.5 2.5 0 0 1 6 8.5 1 6 5.5 4 2.5 2.5 0 0 1 8.5 3 5)
)
