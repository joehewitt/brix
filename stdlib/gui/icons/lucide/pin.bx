(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pin
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePin (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 17 1 12 22 0 0 19 105 0 9 10.76 4 2 2 0 0 1 7.89 12.55 1 6.11 13.45 4 2 2 0 0 0 5 15.24 1 5 16 4 1 1 0 0 0 6 17 1 18 17 4 1 1 0 0 0 19 16 1 19 15.24 4 2 2 0 0 0 17.89 13.45 1 16.11 12.55 4 2 2 0 0 1 15 10.76 1 15 7 4 1 1 0 0 1 16 6 4 2 2 0 0 0 16 2 1 8 2 4 2 2 0 0 0 8 6 4 1 1 0 0 1 9 7 5)
)
