(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-horizontal-space-between
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignHorizontalSpaceBetween (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 5 1 7 5 4 2 2 0 0 1 9 7 1 9 17 4 2 2 0 0 1 7 19 1 5 19 4 2 2 0 0 1 3 17 1 3 7 4 2 2 0 0 1 5 5 5 0 0 10 48 0 17 7 1 19 7 4 2 2 0 0 1 21 9 1 21 15 4 2 2 0 0 1 19 17 1 17 17 4 2 2 0 0 1 15 15 1 15 9 4 2 2 0 0 1 17 7 5 0 0 2 6 0 3 2 1 3 22 0 0 2 6 0 21 2 1 21 22)
)
