(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-superscript
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSuperscript (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4 19 1 12 11 0 0 2 6 0 12 19 1 4 11 0 0 7 42 0 20 12 1 16 12 2 16 10.5 16.442 10 17.5 9.5 2 18.558 9 20 8.334 20 7.002 2 20 6.53 19.83 6.072 19.516 5.712 4 2.105 2.105 0 0 0 16.899 5.276 2 16.479 5.515 16.161 5.89 16 6.336)
)
