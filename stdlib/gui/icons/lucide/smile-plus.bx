(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-smile-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSmilePlus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 13.267 2.08 4 10 10 0 1 0 21.92 10.733 0 0 2 6 0 15 10 1 15 9 0 0 2 6 0 16 5 1 22 5 0 0 2 11 0 16.472 15 4 6 6 0 0 1 7.529 15 0 0 2 6 0 19 2 1 19 8 0 0 2 6 0 9 10 1 9 9)
)
