(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ghost
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGhost (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 9 10 1 9.01 10 0 0 2 6 0 15 10 1 15.01 10 0 0 12 44 0 12 2 4 8 8 0 0 0 4 10 1 4 22 1 7 19 1 9.5 21.5 1 12 19 1 14.5 21.5 1 17 19 1 20 22 1 20 10 4 8 8 0 0 0 12 2 5)
)
