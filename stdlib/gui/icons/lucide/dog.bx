(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-dog
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDog (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 10 0 11.25 16.25 1 12.75 16.25 1 12 17 5 0 0 2 6 0 16 14 1 16 14.5 0 0 5 33 0 4.42 11.247 4 13.152 13.152 0 0 0 4 14.556 2 4 18.728 7.582 21 12 21 2 16.418 21 20 18.728 20 14.556 4 11.702 11.702 0 0 0 19.507 11.247 0 0 2 6 0 8 14 1 8 14.5 0 0 10 67 0 8.5 8.5 2 8.116 9.55 7.417 10.528 6.156 11 2 4.225 11.722 2.58 10.703 2.5 10 2 2.387 9.006 3.677 3.47 6.5 3 2 8.423 2.679 10.151 3.845 10.151 5.235 4 7.497 7.497 0 0 1 14 5.277 2 14 3.887 15.844 2.679 17.767 3 2 20.59 3.47 21.88 9.006 21.767 10 2 21.687 10.703 20.042 11.722 18.111 11 2 16.85 10.528 16.256 9.55 15.872 8.5)
)
