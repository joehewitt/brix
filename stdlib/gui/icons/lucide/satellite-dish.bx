(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-satellite-dish
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSatelliteDish (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 12 0 4 10 4 7.31 7.31 0 0 0 14 20 5 0 0 2 6 0 9 15 1 12 12 0 0 2 11 0 17 13 4 6 6 0 0 0 11 7 0 0 2 11 0 21 13 4 10 10 0 0 0 11 3)
)
