(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-package-open
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePackageOpen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 22 1 12 13 0 0 9 45 0 15.17 2.21 4 1.67 1.67 0 0 1 16.8 2.21 1 21 4.57 4 1.93 1.93 0 0 1 21 7.93 1 8.82 14.79 4 1.655 1.655 0 0 1 7.18 14.79 1 3 12.43 4 1.93 1.93 0 0 1 3 9.07 5 0 0 8 39 0 20 13 1 20 16.87 4 2.06 2.06 0 0 1 18.89 18.7 1 12.89 21.78 4 1.93 1.93 0 0 1 11.11 21.78 1 5.11 18.7 4 2.06 2.06 0 0 1 4 16.87 1 4 13 0 0 9 45 0 21 12.43 4 1.93 1.93 0 0 0 21 9.07 1 8.83 2.2 4 1.64 1.64 0 0 0 7.2 2.2 1 3 4.57 4 1.93 1.93 0 0 0 3 7.93 1 15.18 14.79 4 1.636 1.636 0 0 0 16.81 14.79 5)
)
