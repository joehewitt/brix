(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-keyboard
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideKeyboard (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 8 1 10.01 8 0 0 2 6 0 12 12 1 12.01 12 0 0 2 6 0 14 8 1 14.01 8 0 0 2 6 0 16 12 1 16.01 12 0 0 2 6 0 18 8 1 18.01 8 0 0 2 6 0 6 8 1 6.01 8 0 0 2 6 0 7 16 1 17 16 0 0 2 6 0 8 12 1 8.01 12 0 0 10 48 0 4 4 1 20 4 4 2 2 0 0 1 22 6 1 22 18 4 2 2 0 0 1 20 20 1 4 20 4 2 2 0 0 1 2 18 1 2 6 4 2 2 0 0 1 4 4 5)
)
