(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hat-glasses
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHatGlasses (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 14 18 4 2 2 0 0 0 10 18 0 0 8 39 0 19 11 1 16.89 4.343 4 2 2 0 0 0 14.138 3.195 1 12.862 3.805 4 2 2 0 0 1 12 4 1 8.5 4 4 2 2 0 0 0 6.575 5.456 1 5 11 0 0 2 6 0 2 11 1 22 11 1 0 17 18 3 1 0 7 18 3)
)
