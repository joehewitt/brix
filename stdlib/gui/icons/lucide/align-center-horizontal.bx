(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-center-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignCenterHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 12 1 22 12 0 0 6 28 0 10 16 1 10 20 4 2 2 0 0 1 8 22 1 6 22 4 2 2 0 0 1 4 20 1 4 16 0 0 6 28 0 10 8 1 10 4 4 2 2 0 0 0 8 2 1 6 2 4 2 2 0 0 0 4 4 1 4 8 0 0 6 28 0 20 16 1 20 17 4 2 2 0 0 1 18 19 1 16 19 4 2 2 0 0 1 14 17 1 14 16 0 0 6 27 0 14 8 1 14 7 2 14 5.9 14.9 5 16 5 1 18 5 4 2 2 0 0 1 20 7 1 20 8)
)
