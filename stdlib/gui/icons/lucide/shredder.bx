(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shredder
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShredder (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 4 13 1 4 4 4 2 2 0 0 1 6 2 1 14 2 4 2.4 2.4 0 0 1 15.706 2.706 1 19.294 6.294 4 2.4 2.4 0 0 1 20 8 1 20 13 0 0 4 17 0 14 2 1 14 7 4 1 1 0 0 0 15 8 1 20 8 0 0 2 6 0 10 22 1 10 17 0 0 2 6 0 14 19 1 14 17 0 0 2 6 0 18 20 1 18 17 0 0 2 6 0 2 13 1 22 13 0 0 2 6 0 6 20 1 6 17)
)
