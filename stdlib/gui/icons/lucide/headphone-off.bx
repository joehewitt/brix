(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-headphone-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeadphoneOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 21 14 1 19.657 14 0 0 3 14 0 9.128 3.47 4 9 9 0 0 1 21 12 1 21 15.343 0 0 2 6 0 2 2 1 22 22 0 0 5 25 0 20.414 20.414 4 2 2 0 0 1 19 21 1 18 21 4 2 2 0 0 1 16 19 1 16 16 0 0 9 47 0 3 14 1 6 14 4 2 2 0 0 1 8 16 1 8 19 4 2 2 0 0 1 6 21 1 5 21 4 2 2 0 0 1 3 19 1 3 12 4 9 9 0 0 1 5.636 5.636)
)
