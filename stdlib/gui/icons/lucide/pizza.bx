(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pizza
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePizza (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 14 1 11 15 0 0 2 6 0 13.75 18.25 1 12.5 19.67 0 0 2 11 0 17.775 5.654 4 15.68 15.68 0 0 0 5.654 17.774 0 0 2 11 0 18.8 9.3 4 1 1 0 0 0 20.9 17 0 0 7 39 0 21.964 20.732 4 1 1 0 0 1 20.732 21.964 1 2.732 16.964 4 1 1 0 0 1 2.037 15.732 4 19.68 19.68 0 0 1 15.732 2.037 4 1 1 0 0 1 16.964 2.732 5)
)
