(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-table-rows-split
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTableRowsSplit (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 14 10 1 16 10 0 0 2 6 0 15 22 1 15 14 0 0 2 6 0 15 2 1 15 6 0 0 2 6 0 2 10 1 4 10 0 0 2 6 0 20 10 1 22 10 0 0 2 6 0 3 19 1 21 19 0 0 6 28 0 3 22 1 3 16 4 2 2 135 0 1 5 14 1 19 14 4 2 2 45 0 1 21 16 1 21 22 0 0 6 28 0 3 2 1 3 4 4 2 2 45 0 0 5 6 1 19 6 4 2 2 135 0 0 21 4 1 21 2 0 0 2 6 0 8 10 1 10 10 0 0 2 6 0 9 22 1 9 14 0 0 2 6 0 9 2 1 9 6)
)
