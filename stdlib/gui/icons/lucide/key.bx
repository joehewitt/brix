(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-key
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideKey (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 15.5 7.5 1 17.8 9.8 4 1 1 0 0 0 19.2 9.8 1 21.3 7.7 4 1 1 0 0 0 21.3 6.3 1 19 4 0 0 2 6 0 21 2 1 11.4 11.6 1 0 7.5 15.5 5.5)
)
