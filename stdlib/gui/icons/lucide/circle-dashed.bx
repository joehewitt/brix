(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-circle-dashed
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCircleDashed (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 10.1 2.182 4 10 10 0 0 1 13.9 2.182 0 0 2 11 0 13.9 21.818 4 10 10 0 0 1 10.1 21.818 0 0 2 11 0 17.609 3.721 4 10 10 0 0 1 20.299 6.421 0 0 2 11 0 2.182 13.9 4 10 10 0 0 1 2.182 10.1 0 0 2 11 0 20.279 17.609 4 10 10 0 0 1 17.579 20.299 0 0 2 11 0 21.818 10.1 4 10 10 0 0 1 21.818 13.9 0 0 2 11 0 3.721 6.391 4 10 10 0 0 1 6.421 3.701 0 0 2 11 0 6.391 20.279 4 10 10 0 0 1 3.701 17.579)
)
