(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-house-wifi
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHouseWifi (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 9.5 13.866 4 4 4 0 0 1 14.5 13.876 0 0 2 6 0 12 17 1 12.01 17 0 0 11 56 0 3 10 4 2 2 0 0 1 3.709 8.472 1 10.709 2.472 4 2 2 0 0 1 13.291 2.472 1 20.291 8.472 4 2 2 0 0 1 21 10 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 5 0 0 2 11 0 7 10.754 4 8 8 0 0 1 17 10.754)
)
