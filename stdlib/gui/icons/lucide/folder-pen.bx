(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-folder-pen
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFolderPen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 59 0 2 11.5 1 2 5 4 2 2 0 0 1 4 3 1 7.9 3 2 8.6 3 9.2 3.3 9.6 3.9 1 10.4 5.1 2 10.8 5.7 11.4 6 12.1 6 1 20 6 4 2 2 0 0 1 22 8 1 22 18 4 2 2 0 0 1 20 20 1 10.5 20 0 0 9 45 0 11.378 13.626 4 1 1 0 1 0 8.374 10.622 1 3.364 15.634 4 2 2 0 0 0 2.858 16.488 1 2.021 19.358 4 0.5 0.5 0 0 0 2.641 19.978 1 5.511 19.141 4 2 2 0 0 0 6.365 18.635 5)
)
