(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-line-style
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLineStyle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 5 1 13 5 0 0 2 6 0 15 12 1 21 12 0 0 2 6 0 19 5 1 21 5 0 0 2 6 0 3 12 1 9 12 0 0 2 6 0 3 19 1 21 19 0 0 2 6 0 3 5 1 5 5)
)
