(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-box
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileBox (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 14 2 1 14 7 4 1 1 0 0 0 15 8 1 20 8 0 0 10 50 0 14.692 22 1 18 22 4 2 2 0 0 0 20 20 1 20 8 4 2.4 2.4 0 0 0 19.294 6.294 1 15.706 2.706 4 2.4 2.4 0 0 0 14 2 1 6 2 4 2 2 0 0 0 4 4 1 4 7.804 0 0 3 9 0 2.264 13.752 1 7 16.5 1 11.737 13.752 0 0 13 67 0 2.995 13.014 4 2 2 0 0 0 2 14.744 1 2 18.26 4 2 2 0 0 0 2.996 19.99 1 5.996 21.73 4 2 2 0 0 0 8.004 21.73 1 11.004 19.99 4 2 2 0 0 0 12 18.26 1 12 14.743 4 2 2 0 0 0 11.005 13.013 1 8.005 11.271 4 2 2 0 0 0 6.113 11.207 5 0 0 2 6 0 7 16.5 1 7 22)
)
