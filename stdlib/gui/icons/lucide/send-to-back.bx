(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-send-to-back
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSendToBack (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 16 14 1 20 14 4 2 2 0 0 1 22 16 1 22 20 4 2 2 0 0 1 20 22 1 16 22 4 2 2 0 0 1 14 20 1 14 16 4 2 2 0 0 1 16 14 5 0 0 10 48 0 4 2 1 8 2 4 2 2 0 0 1 10 4 1 10 8 4 2 2 0 0 1 8 10 1 4 10 4 2 2 0 0 1 2 8 1 2 4 4 2 2 0 0 1 4 2 5 0 0 4 17 0 7 14 1 7 15 4 2 2 0 0 0 9 17 1 10 17 0 0 4 17 0 14 7 1 15 7 4 2 2 0 0 1 17 9 1 17 10)
)
