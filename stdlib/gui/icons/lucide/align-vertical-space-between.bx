(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-vertical-space-between
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignVerticalSpaceBetween (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 7 15 1 17 15 4 2 2 0 0 1 19 17 1 19 19 4 2 2 0 0 1 17 21 1 7 21 4 2 2 0 0 1 5 19 1 5 17 4 2 2 0 0 1 7 15 5 0 0 10 48 0 9 3 1 15 3 4 2 2 0 0 1 17 5 1 17 7 4 2 2 0 0 1 15 9 1 9 9 4 2 2 0 0 1 7 7 1 7 5 4 2 2 0 0 1 9 3 5 0 0 2 6 0 2 21 1 22 21 0 0 2 6 0 2 3 1 22 3)
)
