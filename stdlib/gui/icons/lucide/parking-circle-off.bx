(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-parking-circle-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideParkingCircleOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 12.656 7 1 13 7 4 3 3 0 0 1 15.984 10.307 0 0 2 6 0 13 13 1 9 13 0 0 2 11 0 19.071 19.071 4 1 1 0 0 1 4.93 4.93 0 0 2 6 0 2 2 1 22 22 0 0 2 11 0 8.357 2.687 4 10 10 0 0 1 21.313 15.643 0 0 2 6 0 9 17 1 9 9)
)
