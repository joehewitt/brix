(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mail-question-mark
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMailQuestionMark (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 38 0 22 10.5 1 22 6 4 2 2 0 0 0 20 4 1 4 4 4 2 2 0 0 0 2 6 1 2 18 2 2 19.1 2.9 20 4 20 1 16.5 20 0 0 4 17 0 22 7 1 13.03 12.7 4 1.94 1.94 0 0 1 10.97 12.7 1 2 7 0 0 5 32 0 18 15.28 2 18.2 14.88 18.5 14.48 18.9 14.28 4 2.1 2.1 0 0 1 21.5 14.68 2 21.8 15.08 22 15.48 22 15.98 2 22 17.28 20 17.98 20 17.98 0 0 2 6 0 20 22 1 20 22.01)
)
