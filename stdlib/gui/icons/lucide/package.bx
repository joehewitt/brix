(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-package
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePackage (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 67 0 11 21.73 4 2 2 0 0 0 13 21.73 1 20 17.73 4 2 2 0 0 0 21 16 1 21 8 4 2 2 0 0 0 20 6.27 1 13 2.27 4 2 2 0 0 0 11 2.27 1 4 6.27 4 2 2 0 0 0 3 8 1 3 16 4 2 2 0 0 0 4 17.73 5 0 0 2 6 0 12 22 1 12 12 0 0 3 9 0 3.29 7 1 12 12 1 20.71 7 0 0 2 6 0 7.5 4.27 1 16.5 9.42)
)
