(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hop
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHop (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 24 0 10.82 16.12 2 12.51 16.72 14.73 16.91 16 16.97 2 16.55 17 17 16.55 16.97 16 2 16.91 14.73 16.71 12.5 16.12 10.82 0 0 9 61 0 11.5 6.5 2 13.14 6.5 16.5 6.12 18.21 5.43 2 18.73 5.23 18.76 4.61 18.33 4.26 4 10 10 0 0 0 4.26 18.33 2 4.61 18.76 5.22 18.73 5.43 18.21 2 6.12 16.5 6.5 13.14 6.5 11.5 2 7.84 11.95 9.6 12.4 11.38 12.12 4 0.88 0.88 0 0 0 12.11 11.38 2 12.41 9.24 11.96 7.88 11.5 6.5 0 0 4 26 0 15.62 16.95 2 15.82 17.8 16.24 19.71 16.12 21.23 4 0.77 0.77 0 0 1 15.22 21.93 4 16.64 16.64 0 0 1 11.14 20.57 0 0 4 26 0 16.13 21.05 2 17.78 21.68 19.81 21.89 21 21.96 4 0.9 0.9 0 0 0 21.96 21 4 17.68 17.68 0 0 0 21.06 16.13 0 0 4 26 0 16.94 15.62 2 17.8 15.82 19.71 16.24 21.23 16.12 4 0.77 0.77 0 0 0 21.93 15.22 4 16.64 16.64 0 0 0 20.57 11.14 0 0 4 26 0 17.99 5.52 4 20.82 20.82 0 0 1 21.14 10.02 4 0.8 0.8 0 0 1 20.46 11.15 2 18.13 11.35 15.16 10.83 12.19 9.58 0 0 3 14 0 4.93 4.93 1 3 3 4 0.7 0.7 0 0 1 3 2 0 0 4 26 0 9.58 12.18 2 10.82 15.16 11.35 18.13 11.15 20.46 4 0.8 0.8 0 0 1 10.02 21.14 4 20.82 20.82 0 0 1 5.52 17.99)
)
