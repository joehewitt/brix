(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cup-soda
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCupSoda (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 6 8 1 7.75 20.28 4 2 2 0 0 0 9.75 22 1 14.29 22 4 2 2 0 0 0 16.29 20.28 1 18 8 0 0 2 6 0 5 8 1 19 8 0 0 3 19 0 7 15 4 6.47 6.47 0 0 1 12 15 4 6.47 6.47 0 0 0 17 15 0 0 3 9 0 12 8 1 13 2 1 15 2)
)
