(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-square-arrow-out-down-left
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquareArrowOutDownLeft (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 13 21 1 19 21 4 2 2 0 0 0 21 19 1 21 5 4 2 2 0 0 0 19 3 1 5 3 4 2 2 0 0 0 3 5 1 3 11 0 0 2 6 0 3 21 1 12 12 0 0 3 9 0 9 21 1 3 21 1 3 15)
)
