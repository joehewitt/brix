(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-radio-receiver
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRadioReceiver (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 5 16 1 5 18 0 0 2 6 0 19 16 1 19 18 0 0 10 48 0 4 8 1 20 8 4 2 2 0 0 1 22 10 1 22 14 4 2 2 0 0 1 20 16 1 4 16 4 2 2 0 0 1 2 14 1 2 10 4 2 2 0 0 1 4 8 5 0 0 2 6 0 18 12 1 18.01 12)
)
