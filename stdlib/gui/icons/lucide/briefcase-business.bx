(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-briefcase-business
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBriefcaseBusiness (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 12 1 12.01 12 0 0 6 28 0 16 6 1 16 4 4 2 2 0 0 0 14 2 1 10 2 4 2 2 0 0 0 8 4 1 8 6 0 0 2 11 0 22 13 4 18.15 18.15 0 0 1 2 13 0 0 10 48 0 4 6 1 20 6 4 2 2 0 0 1 22 8 1 22 18 4 2 2 0 0 1 20 20 1 4 20 4 2 2 0 0 1 2 18 1 2 8 4 2 2 0 0 1 4 6 5)
)
