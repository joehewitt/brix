(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-building-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBuildingN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 12 1 14 12 0 0 2 6 0 10 8 1 14 8 0 0 4 17 0 14 21 1 14 18 4 2 2 0 0 0 10 18 1 10 21 0 0 10 50 0 6 10 1 4 10 4 2 2 0 0 0 2 12 1 2 19 4 2 2 0 0 0 4 21 1 20 21 4 2 2 0 0 0 22 19 1 22 9 4 2 2 0 0 0 20 7 1 18 7 0 0 6 28 0 6 21 1 6 5 4 2 2 0 0 1 8 3 1 16 3 4 2 2 0 0 1 18 5 1 18 21)
)
