(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-unlink
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUnlink (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 18.84 12.25 1 20.56 10.54 1 20.54 10.54 4 5.004 5.004 0 0 0 20.42 3.47 4 5.006 5.006 0 0 0 13.47 3.47 1 11.75 5.18 0 0 5 25 0 5.17 11.75 1 3.46 13.46 4 5.004 5.004 0 0 0 3.58 20.53 4 5.006 5.006 0 0 0 10.53 20.53 1 12.24 18.82 3 0 8 2 8 5 3 0 2 8 5 8 3 0 16 19 16 22 3 0 19 16 22 16)
)
