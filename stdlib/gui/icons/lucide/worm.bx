(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-worm
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWorm (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 19 12 1 17.5 15 0 0 2 6 0 19.63 18.81 1 22 20 0 0 13 67 0 6.47 8.23 4 1.68 1.68 0 0 1 8.91 10.16 1 8.27 12.24 4 6.76 6.76 0 0 0 18.43 19.91 1 18.85 19.64 4 1 1 0 1 0 16.12 15.43 1 15.7 15.7 4 1.76 1.76 0 0 1 13.07 13.71 1 13.71 11.63 4 6.66 6.66 0 0 0 3.94 3.9 1 3.24 4.3 4 1 1 0 1 0 5.79 8.64 5)
)
