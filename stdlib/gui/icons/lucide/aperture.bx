(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-aperture
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAperture (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 10 0 0 2 6 0 14.31 8 1 20.05 17.94 0 0 2 6 0 9.69 8 1 21.17 8 0 0 2 6 0 7.38 12 1 13.12 2.06 0 0 2 6 0 9.69 16 1 3.95 6.06 0 0 2 6 0 14.31 16 1 2.83 16 0 0 2 6 0 16.62 12 1 10.88 21.94)
)
