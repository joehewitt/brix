(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-book-copy
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBookCopy (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 5 7 4 2 2 0 0 0 3 9 1 3 20 0 0 6 28 0 5.803 18 1 5 18 4 2 2 0 0 0 5 22 1 14.5 22 4 0.5 0.5 0 0 0 15 21.5 1 15 21 0 0 10 50 0 9 15 1 9 4 4 2 2 0 0 1 11 2 1 20.5 2 4 0.5 0.5 0 0 1 21 2.5 1 21 16.5 4 0.5 0.5 0 0 1 20.5 17 1 11 17 4 2 2 0 0 1 11 13 1 21 13)
)
