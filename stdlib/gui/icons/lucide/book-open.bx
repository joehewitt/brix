(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-book-open
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBookOpen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 5 1 12 21 0 0 15 83 0 20.001 19 4 2 2 0 0 0 22 17 1 22 5 4 2 2 0 0 0 20.001 3 1 16 3.002 4 5 5 0 0 0 12 5 4 5 5 0 0 0 8 3 1 4 3 4 2 2 0 0 0 2 5 1 2 17 4 2 2 0 0 0 3.999 19 1 8 19 4 5 5 0 0 1 12 21 4 5 5 0 0 1 16 19 5)
)
