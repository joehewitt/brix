(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-octagon-alert
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideOctagonAlert (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 16 1 12.01 16 0 0 2 6 0 12 8 1 12 12 0 0 17 89 0 15.312 2 4 2 2 0 0 1 16.726 2.586 1 21.414 7.274 4 2 2 0 0 1 22 8.688 1 22 15.312 4 2 2 0 0 1 21.414 16.726 1 16.726 21.414 4 2 2 0 0 1 15.312 22 1 8.688 22 4 2 2 0 0 1 7.274 21.414 1 2.586 16.726 4 2 2 0 0 1 2 15.312 1 2 8.688 4 2 2 0 0 1 2.586 7.274 1 7.274 2.586 4 2 2 0 0 1 8.688 2 5)
)
