(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-vote
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVote (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 9 12 1 11 14 1 15 10 0 0 8 31 0 5 7 2 5 5.9 5.9 5 7 5 1 17 5 4 2 2 0 0 1 19 7 1 19 19 1 5 19 1 5 7 5 0 0 2 6 0 22 19 1 2 19)
)
