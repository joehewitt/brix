(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-smartphone-nfc
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSmartphoneNfc (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 3 6 1 8 6 4 1 1 0 0 1 9 7 1 9 17 4 1 1 0 0 1 8 18 1 3 18 4 1 1 0 0 1 2 17 1 2 7 4 1 1 0 0 1 3 6 5 0 0 2 11 0 13 8.32 4 7.43 7.43 0 0 1 13 15.68 0 0 2 11 0 16.46 6.21 4 11.76 11.76 0 0 1 16.46 17.79 0 0 2 11 0 19.91 4.1 4 15.91 15.91 0 0 1 19.92 19.9)
)
