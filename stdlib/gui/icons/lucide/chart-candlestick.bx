(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chart-candlestick
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChartCandlestick (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 9 5 1 9 9 0 0 10 48 0 8 9 1 10 9 4 1 1 0 0 1 11 10 1 11 14 4 1 1 0 0 1 10 15 1 8 15 4 1 1 0 0 1 7 14 1 7 10 4 1 1 0 0 1 8 9 5 0 0 2 6 0 9 15 1 9 17 0 0 2 6 0 17 3 1 17 5 0 0 10 48 0 16 5 1 18 5 4 1 1 0 0 1 19 6 1 19 12 4 1 1 0 0 1 18 13 1 16 13 4 1 1 0 0 1 15 12 1 15 6 4 1 1 0 0 1 16 5 5 0 0 2 6 0 17 13 1 17 16 0 0 4 17 0 3 3 1 3 19 4 2 2 0 0 0 5 21 1 21 21)
)
