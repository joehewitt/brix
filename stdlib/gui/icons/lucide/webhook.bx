(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-webhook
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWebhook (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 28 0 18 16.98 1 12.01 16.98 2 10.91 16.98 10.06 17.92 9.53 18.88 4 4 4 0 0 1 2 17 2 2.01 16.3 2.2 15.6 2.57 15 0 0 4 21 0 6 17 1 9.13 11.22 2 9.66 10.25 9.23 9.04 8.63 8.12 4 4 4 0 1 1 15.52 4.06 0 0 4 21 0 12 6 1 15.13 11.73 2 15.66 12.7 16.9 13 18 13 4 4 4 0 0 1 18 21)
)
