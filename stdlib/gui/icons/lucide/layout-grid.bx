(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-layout-grid
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLayoutGrid (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 3 1 9 3 4 1 1 0 0 1 10 4 1 10 9 4 1 1 0 0 1 9 10 1 4 10 4 1 1 0 0 1 3 9 1 3 4 4 1 1 0 0 1 4 3 5 0 0 10 48 0 15 3 1 20 3 4 1 1 0 0 1 21 4 1 21 9 4 1 1 0 0 1 20 10 1 15 10 4 1 1 0 0 1 14 9 1 14 4 4 1 1 0 0 1 15 3 5 0 0 10 48 0 15 14 1 20 14 4 1 1 0 0 1 21 15 1 21 20 4 1 1 0 0 1 20 21 1 15 21 4 1 1 0 0 1 14 20 1 14 15 4 1 1 0 0 1 15 14 5 0 0 10 48 0 4 14 1 9 14 4 1 1 0 0 1 10 15 1 10 20 4 1 1 0 0 1 9 21 1 4 21 4 1 1 0 0 1 3 20 1 3 15 4 1 1 0 0 1 4 14 5)
)
