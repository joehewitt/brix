(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hard-drive-upload
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHardDriveUpload (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 16 6 1 12 2 1 8 6 0 0 2 6 0 12 2 1 12 10 0 0 10 48 0 4 14 1 20 14 4 2 2 0 0 1 22 16 1 22 20 4 2 2 0 0 1 20 22 1 4 22 4 2 2 0 0 1 2 20 1 2 16 4 2 2 0 0 1 4 14 5 0 0 2 6 0 6 18 1 6.01 18 0 0 2 6 0 10 18 1 10.01 18)
)
