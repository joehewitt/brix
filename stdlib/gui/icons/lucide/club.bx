(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-club
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideClub (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 28 0 17.28 9.05 4 5.5 5.5 0 1 0 6.72 9.05 4 5.5 5.5 0 1 0 12 17.66 4 5.5 5.5 0 1 0 17.28 9.06 5 0 0 2 6 0 12 17.66 1 12 22)
)
