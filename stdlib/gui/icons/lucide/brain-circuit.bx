(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-brain-circuit
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBrainCircuit (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 36 0 12 5 4 3 3 0 1 0 6.003 5.125 4 4 4 0 0 0 3.477 10.895 4 4 4 0 0 0 4.033 17.483 4 4 4 0 1 0 12 18 5 0 0 2 11 0 9 13 4 4.5 4.5 0 0 0 12 9 0 0 2 11 0 6.003 5.125 4 3 3 0 0 0 6.401 6.5 0 0 2 11 0 3.477 10.896 4 4 4 0 0 1 4.062 10.5 0 0 2 11 0 6 18 4 4 4 0 0 1 4.033 17.484 0 0 2 6 0 12 13 1 16 13 0 0 4 17 0 12 18 1 18 18 4 2 2 0 0 1 20 20 1 20 21 0 0 2 6 0 12 8 1 20 8 0 0 3 14 0 16 8 1 16 5 4 2 2 0 0 1 18 3 1 0 16 13 0.5 1 0 18 3 0.5 1 0 20 21 0.5 1 0 20 8 0.5)
)
