(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-beer-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBeerOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 13 13 1 13 18 0 0 2 6 0 17 11.47 1 17 8 0 0 3 14 0 17 11 1 18 11 4 3 3 0 0 1 20.745 15.211 0 0 2 6 0 2 2 1 22 22 0 0 6 28 0 5 8 1 5 20 4 2 2 0 0 0 7 22 1 15 22 4 2 2 0 0 0 17 20 1 17 17 0 0 3 18 0 7.536 7.535 2 6.766 7.649 6.154 8 5.5 8 4 2.5 2.5 0 0 1 3.732 3.732 0 0 7 47 0 8.727 3.204 2 9.306 2.767 9.885 2 11 2 2 12.56 2 13 3.5 14 3.5 2 15 3.5 15.72 3 16.5 3 4 1 1 0 1 1 16.5 8 2 15.72 8 15 7.5 14 7.5 4 3.149 3.149 0 0 0 13.158 7.62 0 0 2 6 0 9 14.6 1 9 18)
)
