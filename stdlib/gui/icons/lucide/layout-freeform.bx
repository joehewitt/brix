(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-layout-freeform
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLayoutFreeform (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 3 1 9 3 4 1 1 0 0 1 10 4 1 10 9 4 1 1 0 0 1 9 10 1 4 10 4 1 1 0 0 1 3 9 1 3 4 4 1 1 0 0 1 4 3 5 0 0 10 48 0 15 4 1 20 4 4 1 1 0 0 1 21 5 1 21 10 4 1 1 0 0 1 20 11 1 15 11 4 1 1 0 0 1 14 10 1 14 5 4 1 1 0 0 1 15 4 5 0 0 10 48 0 5 14 1 10 14 4 1 1 0 0 1 11 15 1 11 20 4 1 1 0 0 1 10 21 1 5 21 4 1 1 0 0 1 4 20 1 4 15 4 1 1 0 0 1 5 14 5)
)
