(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-files
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFiles (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 15 2 1 11 2 4 2 2 0 0 0 9 4 1 9 15 4 2 2 0 0 0 11 17 1 19 17 4 2 2 0 0 0 21 15 1 21 8 0 0 7 34 0 16.706 2.706 4 2.4 2.4 0 0 0 15 2 1 15 7 4 1 1 0 0 0 16 8 1 21 8 4 2.4 2.4 0 0 0 20.294 6.294 5 0 0 6 33 0 5 7 4 2 2 0 0 0 3 9 1 3 20 4 2 2 0 0 0 5 22 1 13 22 4 2 2 0 0 0 14.732 21)
)
