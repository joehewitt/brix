(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-card-sim
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCardSim (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 14 1 12 18 0 0 11 56 0 14.172 2 4 2 2 0 0 1 15.586 2.586 1 19.414 6.414 4 2 2 0 0 1 20 7.828 1 20 20 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4 20 1 4 4 4 2 2 0 0 1 6 2 5 0 0 2 6 0 8 14 1 16 14 0 0 10 48 0 9 10 1 15 10 4 1 1 0 0 1 16 11 1 16 17 4 1 1 0 0 1 15 18 1 9 18 4 1 1 0 0 1 8 17 1 8 11 4 1 1 0 0 1 9 10 5)
)
