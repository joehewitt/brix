(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-umbrella
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUmbrella (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 12 13 1 12 20 4 2 2 0 0 0 16 20 0 0 2 6 0 12 2 1 12 4 0 0 5 28 0 20.992 13 4 1 1 0 0 0 21.962 11.726 4 10.284 10.284 0 0 0 2.039 11.726 4 1 1 0 0 0 3 13 5)
)
