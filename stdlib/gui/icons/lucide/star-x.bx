(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-star-x
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStarX (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15.5 15.5 1 20.5 20.5 0 0 18 99 0 20.063 11.525 1 21.84 9.794 4 0.53 0.53 0 0 0 21.546 8.889 1 16.38 8.134 4 2.1 2.1 0 0 1 14.785 6.974 1 12.475 2.294 4 0.53 0.53 0 0 0 11.525 2.295 1 9.216 6.974 4 2.1 2.1 0 0 1 7.619 8.134 1 2.454 8.889 4 0.53 0.53 0 0 0 2.16 9.795 1 5.896 13.432 4 2.1 2.1 0 0 1 6.507 15.311 1 5.627 20.45 4 0.53 0.53 0 0 0 6.396 21.01 1 11.013 18.582 4 2.1 2.1 0 0 1 12 18.339 4 2 2 0 0 1 12.132 18.343 0 0 2 6 0 20.5 15.5 1 15.5 20.5)
)
