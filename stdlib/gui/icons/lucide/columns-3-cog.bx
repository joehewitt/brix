(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-columns-3-cog
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideColumnsN3Cog (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 10.6 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 10.6 0 0 2 6 0 14.305 19.53 1 15.228 19.148 0 0 2 6 0 15 3 1 15 10.6 0 0 2 6 0 15.229 16.852 1 14.305 16.469 0 0 2 6 0 16.852 15.228 1 16.469 14.305 0 0 2 6 0 16.852 20.772 1 16.469 21.696 0 0 2 6 0 19.148 15.228 1 19.531 14.305 0 0 2 6 0 19.53 21.696 1 19.148 20.772 0 0 2 6 0 20.773 16.852 1 21.695 16.469 0 0 2 6 0 20.773 19.148 1 21.695 19.531 0 0 2 6 0 9 3 1 9 21 1 0 18 18 3)
)
