(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pilcrow-left
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePilcrowLeft (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 14 3 1 14 14 0 0 4 17 0 14 9 1 11 9 4 3 3 0 0 1 11 3 1 20 3 0 0 2 6 0 18 3 1 18 14 0 0 3 9 0 22 18 1 2 18 1 6 14 0 0 2 6 0 6 22 1 2 18)
)
