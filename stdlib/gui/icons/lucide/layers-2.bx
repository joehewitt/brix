(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-layers-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLayersN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 13 13.74 4 2 2 0 0 1 11 13.74 1 2.5 8.87 4 1 1 0 0 1 2.5 7.13 1 11 2.26 4 2 2 0 0 1 13 2.26 1 21.5 7.13 4 1 1 0 0 1 21.5 8.87 5 0 0 8 39 0 20 14.285 1 21.5 15.13 4 1 1 0 0 1 21.5 16.87 1 13 21.74 4 2 2 0 0 1 11 21.74 1 2.5 16.87 4 1 1 0 0 1 2.5 15.13 1 4 14.285)
)
