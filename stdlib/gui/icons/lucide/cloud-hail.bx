(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cloud-hail
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCloudHail (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 22 0 4 14.899 4 7 7 0 1 1 15.71 8 1 17.5 8 4 4.5 4.5 0 0 1 20 16.242 0 0 2 6 0 16 14 1 16 16 0 0 2 6 0 8 14 1 8 16 0 0 2 6 0 16 20 1 16.01 20 0 0 2 6 0 8 20 1 8.01 20 0 0 2 6 0 12 16 1 12 18 0 0 2 6 0 12 22 1 12.01 22)
)
