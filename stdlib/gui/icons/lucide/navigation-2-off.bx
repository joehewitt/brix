(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-navigation-2-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideNavigationN2Off (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 15 0 9.31 9.31 1 5 21 1 12 17 1 19 21 1 17.83 17.83 0 0 3 9 0 14.53 8.88 1 12 2 1 10.83 5.17 3 0 2 2 22 22)
)
