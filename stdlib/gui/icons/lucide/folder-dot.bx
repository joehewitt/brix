(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-folder-dot
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFolderDot (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 14 69 0 4 20 1 20 20 4 2 2 0 0 0 22 18 1 22 8 4 2 2 0 0 0 20 6 1 12.07 6 4 2 2 0 0 1 10.41 5.1 1 9.59 3.9 4 2 2 0 0 0 7.93 3 1 4 3 4 2 2 0 0 0 2 5 1 2 18 2 2 19.1 2.9 20 4 20 5 1 0 12 13 1)
)
