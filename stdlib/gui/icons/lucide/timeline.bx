(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-timeline
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTimeline (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4 12 1 4.01 12 0 0 2 6 0 4 16 1 4.01 16 0 0 2 6 0 4 20 1 4.01 20 0 0 2 6 0 4 4 1 4.01 4 0 0 2 6 0 4 8 1 4.01 8 0 0 10 48 0 9.414 13.414 4 2 2 0 0 0 10.828 14 1 19 14 4 1 1 0 0 0 20 13 1 20 11 4 1 1 0 0 0 19 10 1 10.828 10 4 2 2 0 0 0 9.414 10.586 1 8 12 5 0 0 10 48 0 9.414 21.414 4 2 2 0 0 0 10.828 22 1 19 22 4 1 1 0 0 0 20 21 1 20 19 4 1 1 0 0 0 19 18 1 10.828 18 4 2 2 0 0 0 9.414 18.586 1 8 20 5 0 0 10 48 0 9.414 5.414 4 2 2 0 0 0 10.828 6 1 19 6 4 1 1 0 0 0 20 5 1 20 3 4 1 1 0 0 0 19 2 1 10.828 2 4 2 2 0 0 0 9.414 2.586 1 8 4 5)
)
