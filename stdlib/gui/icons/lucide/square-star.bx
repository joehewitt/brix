(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-square-star
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquareStar (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 21 111 0 11.035 7.69 4 1 1 0 0 1 12.944 7.714 1 13.681 9.166 4 1 1 0 0 0 14.418 9.701 1 16.052 9.957 4 1 1 0 0 1 16.64 11.763 1 15.468 12.931 4 1 1 0 0 0 15.186 13.797 1 15.445 15.41 4 1 1 0 0 1 13.904 16.544 1 12.439 15.794 4 1 1 0 0 0 11.527 15.794 1 10.062 16.544 4 1 1 0 0 1 8.523 15.411 1 8.781 13.798 4 1 1 0 0 0 8.499 12.932 1 7.343 11.779 4 1 1 0 0 1 7.915 9.957 1 9.548 9.701 4 1 1 0 0 0 10.285 9.166 5 0 0 10 48 0 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 5)
)
