(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-dumbbell
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDumbbell (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 17.596 12.768 4 2 2 0 1 0 20.425 9.939 1 18.657 8.172 4 2 2 0 0 0 21.485 5.343 1 18.657 2.515 4 2 2 0 0 0 15.828 5.343 1 14.061 3.575 4 2 2 0 1 0 11.232 6.404 5 0 0 2 6 0 2.5 21.5 1 3.9 20.1 0 0 2 6 0 20.1 3.9 1 21.5 2.5 0 0 9 45 0 5.343 21.485 4 2 2 0 1 0 8.172 18.657 1 9.939 20.425 4 2 2 0 1 0 12.768 17.596 1 6.404 11.232 4 2 2 0 1 0 3.575 14.061 1 5.343 15.828 4 2 2 0 0 0 2.515 18.657 5 0 0 2 6 0 9.6 14.4 1 14.4 9.6)
)
