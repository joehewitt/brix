(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ham
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHam (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 13.144 21.144 4 7.274 10.445 45 1 0 2.856 10.856 0 0 3 19 0 13.144 21.144 4 7.274 4.365 45 0 0 2.856 10.856 4 7.274 4.365 45 0 0 13.144 21.144 0 0 5 25 0 16.565 10.435 1 18.6 8.4 4 2.501 2.501 0 1 0 20.25 3.75 4 2.5 2.5 0 1 0 15.59 5.41 1 13.566 7.435 0 0 2 6 0 8.5 16.5 1 7.5 15.5)
)
