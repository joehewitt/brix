(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ruler-dimension-line
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRulerDimensionLine (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 15 1 10 12 0 0 2 6 0 14 15 1 14 12 0 0 2 6 0 18 15 1 18 12 0 0 2 6 0 2 8 1 2 4 0 0 2 6 0 22 6 1 2 6 0 0 2 6 0 22 8 1 22 4 0 0 2 6 0 6 15 1 6 12 0 0 10 48 0 4 12 1 20 12 4 2 2 0 0 1 22 14 1 22 18 4 2 2 0 0 1 20 20 1 4 20 4 2 2 0 0 1 2 18 1 2 14 4 2 2 0 0 1 4 12 5)
)
