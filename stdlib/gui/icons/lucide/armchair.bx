(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-armchair
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArmchair (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 19 9 1 19 6 4 2 2 0 0 0 17 4 1 7 4 4 2 2 0 0 0 5 6 1 5 9 0 0 13 67 0 3 16 4 2 2 0 0 0 5 18 1 19 18 4 2 2 0 0 0 21 16 1 21 11 4 2 2 0 0 0 17 11 1 17 12.5 4 0.5 0.5 0 0 1 16.5 13 1 7.5 13 4 0.5 0.5 0 0 1 7 12.5 1 7 11 4 2 2 0 0 0 3 11 5 0 0 2 6 0 5 18 1 5 20 0 0 2 6 0 19 18 1 19 20)
)
