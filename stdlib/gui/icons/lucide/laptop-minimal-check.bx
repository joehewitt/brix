(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-laptop-minimal-check
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLaptopMinimalCheck (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 20 1 22 20 0 0 3 9 0 9 10 1 11 12 1 15 8 0 0 10 48 0 5 4 1 19 4 4 2 2 0 0 1 21 6 1 21 14 4 2 2 0 0 1 19 16 1 5 16 4 2 2 0 0 1 3 14 1 3 6 4 2 2 0 0 1 5 4 5)
)
