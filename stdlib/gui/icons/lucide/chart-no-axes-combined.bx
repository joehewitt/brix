(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chart-no-axes-combined
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChartNoAxesCombined (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 16 1 12 21 0 0 2 6 0 16 14.639 1 16 21 0 0 2 6 0 20 10.656 1 20 21 0 0 6 28 0 22 3 1 13.354 11.646 4 0.5 0.5 0 0 1 12.646 11.646 1 9.354 8.354 4 0.5 0.5 0 0 0 8.647 8.354 1 2 15 0 0 2 6 0 4 18.463 1 4 21 0 0 2 6 0 8 14.656 1 8 21)
)
