(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-equal-approximately
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEqualApproximately (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 19 0 5 15 4 6.5 6.5 0 0 1 12 15 4 6.5 6.5 0 0 0 19 15 0 0 3 19 0 5 9 4 6.5 6.5 0 0 1 12 9 4 6.5 6.5 0 0 0 19 9)
)
