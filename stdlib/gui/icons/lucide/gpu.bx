(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-gpu
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGpu (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 2 17 1 20 17 4 2 2 0 0 0 22 15 1 22 7 4 2 2 0 0 0 20 5 1 2 5 0 0 2 6 0 2 21 1 2 3 0 0 6 28 0 7 17 1 7 20 4 1 1 0 0 0 8 21 1 13 21 4 1 1 0 0 0 14 20 1 14 17 1 0 16 11 2 1 0 8 11 2)
)
