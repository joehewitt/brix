(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-piggy-bank
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePiggyBank (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 26 131 0 11 17 1 14 17 1 14 19 4 1 1 0 0 0 15 20 1 17 20 4 1 1 0 0 0 18 19 1 18 16 4 3.16 3.16 0 0 0 20 14 1 21 14 4 1 1 0 0 0 22 13 1 22 11 4 1 1 0 0 0 21 10 1 20 10 4 5 5 0 0 0 18 6 1 18 3 4 4 4 0 0 0 14.8 4.6 1 14.5 5 1 11 5 4 6 6 0 0 0 5 11 1 5 12 4 5 5 0 0 0 7 16 1 7 19 4 1 1 0 0 0 8 20 1 10 20 4 1 1 0 0 0 11 19 5 0 0 2 6 0 16 10 1 16.01 10 0 0 4 17 0 2 8 1 2 9 4 2 2 0 0 0 4 11 1 5 11)
)
