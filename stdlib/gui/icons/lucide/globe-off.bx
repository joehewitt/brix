(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-globe-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGlobeOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 19 0 10.114 4.462 4 14.5 14.5 0 0 1 12 2 4 10 10 0 0 1 21.313 15.643 0 0 3 19 0 15.557 15.556 4 14.5 14.5 0 0 1 12 22 4 10 10 0 0 1 4.929 4.929 0 0 3 19 0 15.892 10.234 4 14.5 14.5 0 0 0 12 2 4 10 10 0 0 0 8.357 2.687 0 0 2 6 0 17.656 12 1 22 12 0 0 3 19 0 19.071 19.071 4 10 10 0 0 1 12 22 4 14.5 14.5 0 0 1 8.44 8.45 0 0 2 6 0 2 12 1 12 12 0 0 2 6 0 2 2 1 22 22)
)
