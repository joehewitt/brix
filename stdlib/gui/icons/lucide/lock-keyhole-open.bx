(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lock-keyhole-open
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLockKeyholeOpen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 16 1 0 0 10 48 0 5 10 1 19 10 4 2 2 0 0 1 21 12 1 21 20 4 2 2 0 0 1 19 22 1 5 22 4 2 2 0 0 1 3 20 1 3 12 4 2 2 0 0 1 5 10 5 0 0 3 14 0 7 10 1 7 7 4 5 5 0 0 1 16.33 4.5)
)
