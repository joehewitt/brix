(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-baggage-claim
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBaggageClaim (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 25 0 22 18 1 6 18 4 2 2 0 0 1 4 16 1 4 7 4 2 2 0 0 0 2 5 0 0 6 28 0 17 14 1 17 4 4 2 2 0 0 0 15 2 1 14 2 4 2 2 0 0 0 12 4 1 12 14 0 0 10 48 0 9 6 1 20 6 4 1 1 0 0 1 21 7 1 21 13 4 1 1 0 0 1 20 14 1 9 14 4 1 1 0 0 1 8 13 1 8 7 4 1 1 0 0 1 9 6 5 1 0 18 20 2 1 0 9 20 2)
)
