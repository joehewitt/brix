(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cannabis
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCannabis (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 22 1 12 18 0 0 15 101 0 7 12 2 5.5 12 2.5 13.5 2 15 2 5.5 16.5 8 16 8 16 2 6.5 17.5 6 19.5 6 21 2 8.5 21 10.5 19.5 12 18 2 13.5 19.5 15.5 21 18 21 2 18 19.5 17.5 17.5 16 16 2 16 16 18.5 16.5 22 15 2 21.5 13.5 18.5 12 17 12 2 18.5 11 21 8 21 6 2 18.5 6 15.5 7.5 14 9 2 14 6.5 13.5 4 12 2 2 10.5 4 10 6.5 10 9 2 8.5 7.5 5.5 6 3 6 2 3 8 5.5 11 7 12)
)
