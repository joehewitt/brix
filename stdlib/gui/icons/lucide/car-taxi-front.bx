(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-car-taxi-front
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCarTaxiFront (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 2 1 14 2 0 0 8 34 0 21 8 1 19 10 1 17.5 6.3 4 2 2 0 0 0 15.646 5 1 8.4 5 4 2 2 0 0 0 6.497 6.257 1 5 10 1 3 8 0 0 2 6 0 7 14 1 7.01 14 0 0 2 6 0 17 14 1 17.01 14 0 0 10 48 0 5 10 1 19 10 4 2 2 0 0 1 21 12 1 21 16 4 2 2 0 0 1 19 18 1 5 18 4 2 2 0 0 1 3 16 1 3 12 4 2 2 0 0 1 5 10 5 0 0 2 6 0 5 18 1 5 20 0 0 2 6 0 19 18 1 19 20)
)
