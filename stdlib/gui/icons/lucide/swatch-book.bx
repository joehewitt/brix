(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-swatch-book
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSwatchBook (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 34 0 11 17 4 4 4 0 0 1 3 17 1 3 5 4 2 2 0 0 1 5 3 1 9 3 4 2 2 0 0 1 11 5 5 0 0 6 28 0 16.7 13 1 19 13 4 2 2 0 0 1 21 15 1 21 19 4 2 2 0 0 1 19 21 1 7 21 0 0 2 6 0 7 17 1 7.01 17 0 0 6 28 0 11 8 1 13.3 5.7 4 2.4 2.4 0 0 1 16.704 5.704 1 18.6 7.6 4 2.4 2.4 0 0 1 18.626 11.034 1 9.9 19.8)
)
