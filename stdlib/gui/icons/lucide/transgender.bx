(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-transgender
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTransgender (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 16 1 12 22 0 0 2 6 0 14 20 1 10 20 0 0 3 9 0 18 2 1 22 2 1 22 6 0 0 2 6 0 2 2 1 9.17 9.17 0 0 3 9 0 2 5.355 1 2 2 1 5.357 2 0 0 2 6 0 22 2 1 14.83 9.17 0 0 2 6 0 8 5 1 5 8 1 0 12 12 4)
)
