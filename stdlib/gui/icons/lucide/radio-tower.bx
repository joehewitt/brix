(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-radio-tower
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRadioTower (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 10 0 4.9 16.1 2 1 12.2 1 5.8 4.9 1.9 0 0 2 11 0 7.8 4.7 4 6.14 6.14 0 0 0 7 12.2 1 0 12 9 2 0 0 2 10 0 16.2 4.8 2 18.2 6.8 18.46 9.91 17 12.27 0 0 2 11 0 19.1 1.9 4 9.96 9.96 0 0 1 19.1 16 0 0 2 6 0 9.5 18 1 14.5 18 0 0 3 9 0 8 22 1 12 11 1 16 22)
)
