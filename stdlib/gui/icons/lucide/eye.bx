(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-eye
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEye (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 35 0 2.062 12.348 4 1 1 0 0 1 2.062 11.652 4 10.75 10.75 0 0 1 21.938 11.652 4 1 1 0 0 1 21.938 12.348 4 10.75 10.75 0 0 1 2.062 12.348 1 0 12 12 3)
)
