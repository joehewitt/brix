(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-save-all
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSaveAll (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 10 2 1 10 5 4 1 1 0 0 0 11 6 1 16 6 0 0 6 28 0 18 18 1 18 12 4 1 1 0 0 0 17 11 1 11 11 4 1 1 0 0 0 10 12 1 10 18 0 0 4 17 0 18 22 1 4 22 4 2 2 0 0 1 2 20 1 2 6 0 0 11 56 0 8 18 4 2 2 0 0 1 6 16 1 6 4 4 2 2 0 0 1 8 2 1 17.172 2 4 2 2 0 0 1 18.586 2.586 1 21.414 5.414 4 2 2 0 0 1 22 6.828 1 22 16 4 2 2 0 0 1 19.99 18 5)
)
