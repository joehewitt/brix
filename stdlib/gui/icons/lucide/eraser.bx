(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-eraser
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEraser (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 21 21 1 8 21 4 2 2 0 0 1 6.58 20.413 1 2.586 16.414 4 2 2 0 0 1 2.586 13.586 1 12.586 3.586 4 2 2 0 0 1 15.415 3.586 1 21.414 9.586 4 2 2 0 0 1 21.414 12.414 1 12.834 21 0 0 2 6 0 5.082 11.09 1 13.91 19.918)
)
