(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-radio-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRadioOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 13.414 13.414 4 2 2 0 1 1 10.586 10.586 0 0 2 11 0 16.247 7.761 4 6 6 0 0 1 17.991 12.333 0 0 2 11 0 19.075 4.933 4 10 10 0 0 1 21.309 15.653 0 0 2 6 0 2 2 1 22 22 0 0 2 11 0 4.925 19.067 4 10 10 0 0 1 4.925 4.933 0 0 2 11 0 7.753 16.239 4 6 6 0 0 1 7.753 7.761)
)
