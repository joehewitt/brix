(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-axis-3d
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAxisN3d (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 13.5 10.5 1 15 9 0 0 4 17 0 4 4 1 4 19 4 1 1 0 0 0 5 20 1 20 20 0 0 2 6 0 4.293 19.707 1 6 18 0 0 2 6 0 9 15 1 10.5 13.5)
)
