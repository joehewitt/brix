(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-washing-machine
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWashingMachine (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 3 6 1 6 6 0 0 2 6 0 17 6 1 17.01 6 0 0 10 48 0 5 2 1 19 2 4 2 2 0 0 1 21 4 1 21 20 4 2 2 0 0 1 19 22 1 5 22 4 2 2 0 0 1 3 20 1 3 4 4 2 2 0 0 1 5 2 5 1 0 12 13 5 0 0 3 19 0 12 18 4 2.5 2.5 0 0 0 12 13 4 2.5 2.5 0 0 1 12 8)
)
