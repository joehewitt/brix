(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hand-metal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHandMetal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 25 0 18 12.5 1 18 10 4 2 2 0 0 0 16 8 4 2 2 0 0 0 14 10 1 14 11.4 0 0 4 17 0 14 11 1 14 9 4 2 2 0 1 0 10 9 1 10 11 0 0 4 17 0 10 10.5 1 10 5 4 2 2 0 1 0 6 5 1 6 14 0 0 10 49 0 7 15 1 5.24 13.24 4 2 2 0 0 0 2.41 16.06 1 6.01 19.66 2 7.5 21.14 9.2 22 12 22 1 14 22 4 8 8 0 0 0 22 14 1 22 7 4 2 2 0 1 0 18 7 1 18 12)
)
