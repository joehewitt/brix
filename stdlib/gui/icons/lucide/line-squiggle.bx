(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-line-squiggle
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLineSquiggle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 38 0 7 3.5 2 12 1.5 14 6 10 7.5 2 1.5 10 2 15 5 16 2 10 18 14 6 19 9 2 24 12 19.5 22.5 15 21 2 10 18.5 15.5 10 21 19)
)
