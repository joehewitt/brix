(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-start-vertical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignStartVertical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 8 14 1 13 14 4 2 2 0 0 1 15 16 1 15 18 4 2 2 0 0 1 13 20 1 8 20 4 2 2 0 0 1 6 18 1 6 16 4 2 2 0 0 1 8 14 5 0 0 10 48 0 8 4 1 20 4 4 2 2 0 0 1 22 6 1 22 8 4 2 2 0 0 1 20 10 1 8 10 4 2 2 0 0 1 6 8 1 6 6 4 2 2 0 0 1 8 4 5 0 0 2 6 0 2 2 1 2 22)
)
