(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-arrow-big-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArrowBigDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 15 78 0 9 5 4 1 1 0 0 1 10 4 1 14 4 4 1 1 0 0 1 15 5 1 15 11 4 1 1 0 0 0 16 12 1 19.293 12 4 0.707 0.707 0 0 1 19.793 13.207 1 12.707 20.293 4 1 1 0 0 1 11.293 20.293 1 4.207 13.207 4 0.707 0.707 0 0 1 4.707 12 1 8 12 4 1 1 0 0 0 9 11 5)
)
