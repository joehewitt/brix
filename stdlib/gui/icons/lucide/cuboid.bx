(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cuboid
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCuboid (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 22 1 10 14 0 0 3 9 0 2.336 8.89 1 10 14 1 21.715 6.971 0 0 13 67 0 22 14 4 2 2 0 0 1 21.029 15.715 1 11.029 21.715 4 2 2 0 0 1 8.891 21.665 1 2.891 17.665 4 2 2 0 0 1 2 16 1 2 10 4 2 2 0 0 1 2.971 8.285 1 12.971 2.285 4 2 2 0 0 1 15.109 2.335 1 21.109 6.335 4 2 2 0 0 1 22 8 5)
)
