(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rocket
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRocket (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 20 0 12 15 1 12 20 2 12 20 15.03 19.45 16 18 2 17.08 16.38 16 13 16 13 0 0 5 32 0 4.5 16.5 2 3 17.76 2.5 21.5 2.5 21.5 2 2.5 21.5 6.24 21 7.5 19.5 2 8.21 18.66 8.2 17.37 7.41 16.59 4 2.18 2.18 0 0 0 4.5 16.5 0 0 6 35 0 9 12 4 22 22 0 0 1 11 8.05 4 12.88 12.88 0 0 1 22 2 2 22 4.72 21.22 9.5 16 13 4 22.4 22.4 0 0 1 12 15 5 0 0 4 20 0 9 12 1 4 12 2 4 12 4.55 8.97 6 8 2 7.62 6.92 11 8.05 11 8.05)
)
