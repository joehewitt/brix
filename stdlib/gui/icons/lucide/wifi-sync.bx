(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wifi-sync
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWifiSync (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 11.965 10.105 1 11.965 14.105 1 13.5 12.5 4 5 5 0 0 1 21.5 14 0 0 2 6 0 11.965 14.105 1 15.965 14.105 0 0 4 17 0 17.965 18.105 1 21.965 18.105 1 20.43 19.71 4 5 5 0 0 1 12.43 18.21 0 0 2 11 0 2 8.82 4 15 15 0 0 1 22 8.82 0 0 2 6 0 21.965 22.105 1 21.965 18.105 0 0 2 11 0 5 12.86 4 10 10 0 0 1 8 10.828 0 0 2 6 0 8.5 16.429 1 8.51 16.429)
)
