(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-presentation
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePresentation (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 3 1 22 3 0 0 6 28 0 21 3 1 21 14 4 2 2 0 0 1 19 16 1 5 16 4 2 2 0 0 1 3 14 1 3 3 0 0 3 9 0 7 21 1 12 16 1 17 21)
)
