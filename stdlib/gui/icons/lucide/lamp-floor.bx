(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lamp-floor
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLampFloor (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 10 1 12 22 0 0 9 45 0 17.929 7.629 4 1 1 0 0 1 17 9 1 7 9 4 1 1 0 0 1 6.072 7.629 1 8.072 2.629 4 1 1 0 0 1 9 2 1 15 2 4 1 1 0 0 1 15.928 2.629 5 0 0 2 6 0 9 22 1 15 22)
)
