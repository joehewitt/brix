(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-university
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUniversity (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 14 21 1 14 18 4 2 2 0 0 0 10 18 1 10 21 0 0 2 6 0 18 12 1 18.01 12 0 0 2 6 0 18 16 1 18.01 16 0 0 15 78 0 22 7 4 1 1 0 0 0 21 6 1 19 6 4 2 2 0 0 1 17.857 5.641 1 13.143 2.36 4 2 2 0 0 0 10.857 2.359 1 6.143 5.64 4 2 2 0 0 1 5 6 1 3 6 4 1 1 0 0 0 2 7 1 2 19 4 2 2 0 0 0 4 21 1 20 21 4 2 2 0 0 0 22 19 5 0 0 2 6 0 6 12 1 6.01 12 0 0 2 6 0 6 16 1 6.01 16 1 0 12 10 2)
)
