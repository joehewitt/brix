(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cloud-sun
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCloudSun (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 2 1 12 4 0 0 2 6 0 4.93 4.93 1 6.34 6.34 0 0 2 6 0 20 12 1 22 12 0 0 2 6 0 19.07 4.93 1 17.66 6.34 0 0 2 11 0 15.947 12.65 4 4 4 0 0 0 10.022 8.522 0 0 6 26 0 13 22 1 7 22 4 5 5 0 1 1 11.9 16 1 13 16 4 3 3 0 0 1 13 22 5)
)
