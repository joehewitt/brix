(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-globe-x
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGlobeX (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 3 1 21 8 0 0 5 30 0 2 12 1 22 12 4 10 10 0 1 1 12 2 4 14.5 14.5 0 0 0 12 22 4 14.5 14.5 0 0 0 16 12 0 0 2 6 0 21 3 1 16 8)
)
