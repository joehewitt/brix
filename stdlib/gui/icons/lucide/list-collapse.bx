(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-list-collapse
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideListCollapse (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 5 1 21 5 0 0 2 6 0 10 12 1 21 12 0 0 2 6 0 10 19 1 21 19 0 0 3 9 0 3 10 1 6 7 1 3 4 0 0 3 9 0 3 20 1 6 17 1 3 14)
)
