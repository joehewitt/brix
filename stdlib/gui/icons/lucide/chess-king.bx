(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chess-king
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChessKing (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 4 20 4 2 2 0 0 1 6 18 1 18 18 4 2 2 0 0 1 20 20 1 20 21 4 1 1 0 0 1 19 22 1 5 22 4 1 1 0 0 1 4 21 5 0 0 9 53 0 6.7 18 1 5.7 17 2 4.35 15.682 3 14.09 3 12 4 5 5 0 0 1 7.95 7 2 9.534 7 10.65 7.455 12 8.818 2 13.35 7.455 14.466 7 16.05 7 4 5 5 0 0 1 21 12 2 21 14.082 19.641 15.673 18.3 17 1 17.3 18 0 0 2 6 0 10 4 1 14 4 0 0 2 6 0 12 2 1 12 8.818)
)
