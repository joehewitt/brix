(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-captions
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCaptions (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 5 1 19 5 4 2 2 0 0 1 21 7 1 21 17 4 2 2 0 0 1 19 19 1 5 19 4 2 2 0 0 1 3 17 1 3 7 4 2 2 0 0 1 5 5 5 0 0 8 24 0 7 15 1 11 15 0 15 15 1 17 15 0 7 11 1 9 11 0 13 11 1 17 11)
)
