(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-messages-square
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMessagesSquare (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 16 10 4 2 2 0 0 1 14 12 1 6.828 12 4 2 2 0 0 0 5.414 12.586 1 3.212 14.788 4 0.71 0.71 0 0 1 2 14.286 1 2 4 4 2 2 0 0 1 4 2 1 14 2 4 2 2 0 0 1 16 4 5 0 0 9 47 0 20 9 4 2 2 0 0 1 22 11 1 22 21.286 4 0.71 0.71 0 0 1 20.788 21.788 1 18.586 19.586 4 2 2 0 0 0 17.172 19 1 10 19 4 2 2 0 0 1 8 17 1 8 16)
)
