(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-salad
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSalad (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 7 21 1 17 21 0 0 5 23 0 12 21 4 9 9 0 0 0 21 12 1 3 12 4 9 9 0 0 0 12 21 5 0 0 7 51 0 11.38 12 4 2.4 2.4 0 0 1 10.98 7.23 4 2.4 2.4 0 0 1 14.18 4.46 4 2.4 2.4 0 0 1 17.65 3.83 4 2.4 2.4 0 0 1 21.02 7.2 4 2.4 2.4 0 0 1 19.92 10.9 4 2.51 2.51 0 0 1 19.95 12 0 0 2 6 0 13 12 1 17 8 0 0 3 18 0 10.9 7.25 4 3.99 3.99 0 0 0 4 10 2 4 10.73 4.2 11.41 4.54 12)
)
