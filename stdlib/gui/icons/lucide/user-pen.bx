(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-user-pen
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUserPen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 11.5 15 1 7 15 4 4 4 0 0 0 3 19 1 3 21 0 0 9 45 0 21.378 16.626 4 1 1 0 0 0 18.374 13.622 1 14.364 17.634 4 2 2 0 0 0 13.858 18.488 1 13.021 21.358 4 0.5 0.5 0 0 0 13.641 21.978 1 16.511 21.141 4 2 2 0 0 0 17.365 20.635 5 1 0 10 7 4)
)
