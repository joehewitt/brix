(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sailboat
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSailboat (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 2 1 10 17 0 0 7 39 0 7 22 4 4 4 0 0 1 3 18 4 1 1 0 0 1 4 17 1 20 17 4 1 1 0 0 1 21 18 4 4 4 0 0 1 17 22 5 0 0 7 34 0 9.159 2.46 4 1 1 0 0 1 10.68 2.267 1 20.657 11.247 4 1 1 0 0 1 20 13 1 4 13 4 1 1 0 0 1 3.176 11.433 5)
)
