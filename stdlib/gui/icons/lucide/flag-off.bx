(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flag-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlagOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 18 0 16 16 2 13 16 11 14 8 14 4 6 6 0 0 0 4 15.528 0 0 2 6 0 2 2 1 22 22 0 0 2 6 0 4 22 1 4 4 0 0 6 29 0 7.656 2 1 8 2 2 11 2 13 4 15.333 4 3 17.333 4 18.4 3.2 4 1 1 0 0 1 20 4 1 20 14.347)
)
