(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ambulance
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAmbulance (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 10 1 6 10 0 0 8 39 0 14 18 1 14 6 4 2 2 0 0 0 12 4 1 4 4 4 2 2 0 0 0 2 6 1 2 17 4 1 1 0 0 0 3 18 1 5 18 0 0 10 50 0 19 18 1 21 18 4 1 1 0 0 0 22 17 1 22 13.72 4 1 1 0 0 0 21.316 12.772 1 19.393 12.131 4 1 1 0 0 1 18.815 11.629 1 17.276 8.553 4 1 1 0 0 0 16.382 8 1 14 8 0 0 2 6 0 8 8 1 8 12 0 0 2 6 0 9 18 1 15 18 1 0 17 18 2 1 0 7 18 2)
)
