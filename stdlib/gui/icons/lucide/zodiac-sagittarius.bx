(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zodiac-sagittarius
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZodiacSagittarius (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 15 3 1 21 3 1 21 9 0 0 2 6 0 21 3 1 3 21 0 0 2 6 0 9 9 1 15 15)
)
