(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-blender
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBlender (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 8 14 4 2 2 0 0 0 6.037 15.615 1 5.019 20.808 4 1 1 0 0 0 6 22 1 18 22 4 1 1 0 0 0 18.981 20.808 1 17.963 15.615 4 2 2 0 0 0 16 14 5 0 0 2 6 0 17 2 1 16 14 0 0 2 6 0 8.006 14 1 7 2 0 0 3 19 0 7.565 8.787 4 5 5 0 0 0 12 8 4 5 5 0 0 1 16.56 7.25 0 0 5 25 0 19 2 1 5 2 4 2 2 0 0 0 3 4 1 3 9 4 2 2 0 0 0 3.688 10.5 0 0 2 6 0 12 18 1 12.01 18)
)
