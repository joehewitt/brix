(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-library-big
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLibraryBig (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 3 1 10 3 4 1 1 0 0 1 11 4 1 11 20 4 1 1 0 0 1 10 21 1 4 21 4 1 1 0 0 1 3 20 1 3 4 4 1 1 0 0 1 4 3 5 0 0 2 6 0 7 3 1 7 21 0 0 9 41 0 20.4 18.9 2 20.6 19.4 20.3 20 19.8 20.2 1 17.9 20.9 2 17.4 21.1 16.8 20.8 16.6 20.3 1 11.1 5.1 2 10.9 4.6 11.2 4 11.7 3.8 1 13.6 3.1 2 14.1 2.9 14.7 3.2 14.9 3.7 5)
)
