(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-alarm-clock
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlarmClock (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 13 8 0 0 3 9 0 12 9 1 12 13 1 14 15 0 0 2 6 0 5 3 1 2 6 0 0 2 6 0 22 6 1 19 3 0 0 2 6 0 6.38 18.7 1 4 21 0 0 2 6 0 17.64 18.67 1 20 21)
)
