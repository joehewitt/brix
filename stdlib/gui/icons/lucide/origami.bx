(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-origami
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideOrigami (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 12 12 1 12 4 4 1 1 0 0 1 13 3 1 19.297 3 4 1 1 0 0 1 19.948 4.759 1 15.252 8.784 0 0 6 28 0 12 21 1 4.586 13.586 4 2 2 0 0 1 4 12.172 1 4 6.415 4 1.002 1.002 0 0 1 5.707 5.708 1 20 20.009 0 0 10 50 0 12.214 3.381 1 20.628 18.347 4 1 1 0 0 1 20.461 19.546 1 19.293 20.709 4 1 1 0 0 1 18.587 21 1 6.351 21 4 1 1 0 0 1 5.726 20.781 1 3.25 18.8 4 1 1 0 0 1 3.881 17.019 1 8.046 17.046)
)
