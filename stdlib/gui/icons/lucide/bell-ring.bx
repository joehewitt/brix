(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bell-ring
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBellRing (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 10.268 21 4 2 2 0 0 0 13.732 21 0 0 2 10 0 22 8 2 22 5.7 21.2 3.7 20 2 0 0 7 44 0 3.262 15.326 4 1 1 0 0 0 4 17 1 20 17 4 1 1 0 0 0 20.74 15.327 2 19.41 13.956 18 12.499 18 8 4 6 6 0 0 0 6 8 2 6 12.499 4.589 13.956 3.262 15.326 0 0 2 10 0 4 2 2 2.8 3.7 2 5.7 2 8)
)
