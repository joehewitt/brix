(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-landmark
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLandmark (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 18 1 10 11 0 0 7 34 0 11.119 2.205 4 2 2 0 0 1 12.881 2.205 1 20.721 6.051 4 0.5 0.5 0 0 1 20.5 7 1 3.5 7 4 0.5 0.5 0 0 1 3.28 6.051 5 0 0 2 6 0 14 18 1 14 11 0 0 2 6 0 18 18 1 18 11 0 0 2 6 0 3 22 1 21 22 0 0 2 6 0 6 18 1 6 11)
)
