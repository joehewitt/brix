(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-volume
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVolume (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 67 0 11 4.702 4 0.705 0.705 0 0 0 9.797 4.204 1 6.413 7.587 4 1.4 1.4 0 0 1 5.416 8 1 3 8 4 1 1 0 0 0 2 9 1 2 15 4 1 1 0 0 0 3 16 1 5.416 16 4 1.4 1.4 0 0 1 6.413 16.413 1 9.796 19.797 4 0.705 0.705 0 0 0 11 19.298 5)
)
