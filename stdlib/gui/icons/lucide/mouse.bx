(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mouse
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMouse (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 12 2 1 12 2 4 7 7 0 0 1 19 9 1 19 15 4 7 7 0 0 1 12 22 1 12 22 4 7 7 0 0 1 5 15 1 5 9 4 7 7 0 0 1 12 2 5 0 0 2 6 0 12 6 1 12 10)
)
