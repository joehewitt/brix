(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-unfold-vertical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUnfoldVertical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 22 1 12 16 0 0 2 6 0 12 8 1 12 2 0 0 2 6 0 4 12 1 2 12 0 0 2 6 0 10 12 1 8 12 0 0 2 6 0 16 12 1 14 12 0 0 2 6 0 22 12 1 20 12 0 0 3 9 0 15 19 1 12 22 1 9 19 0 0 3 9 0 15 5 1 12 2 1 9 5)
)
