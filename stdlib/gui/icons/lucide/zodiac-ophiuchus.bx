(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zodiac-ophiuchus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZodiacOphiuchus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 19 0 3 10 4 6.06 6.06 0 0 1 12 10 4 6.06 6.06 0 0 0 21 10 0 0 4 17 0 6 3 1 6 15 4 6 6 0 0 0 18 15 1 18 3)
)
