(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-gallery-horizontal-end
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGalleryHorizontalEnd (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 7 1 2 17 0 0 2 6 0 6 5 1 6 19 0 0 10 48 0 12 3 1 20 3 4 2 2 0 0 1 22 5 1 22 19 4 2 2 0 0 1 20 21 1 12 21 4 2 2 0 0 1 10 19 1 10 5 4 2 2 0 0 1 12 3 5)
)
