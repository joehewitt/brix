(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-toggle-left
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideToggleLeft (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 9 12 3 0 0 10 48 0 9 5 1 15 5 4 7 7 0 0 1 22 12 1 22 12 4 7 7 0 0 1 15 19 1 9 19 4 7 7 0 0 1 2 12 1 2 12 4 7 7 0 0 1 9 5 5)
)
