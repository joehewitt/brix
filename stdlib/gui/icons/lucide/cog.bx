(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cog
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCog (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 10.27 1 7 3.34 0 0 2 6 0 11 13.73 1 7 20.66 0 0 2 6 0 12 22 1 12 20 0 0 2 6 0 12 2 1 12 4 0 0 2 6 0 14 12 1 22 12 0 0 2 6 0 17 20.66 1 16 18.93 0 0 2 6 0 17 3.34 1 16 5.07 0 0 2 6 0 2 12 1 4 12 0 0 2 6 0 20.66 17 1 18.93 16 0 0 2 6 0 20.66 7 1 18.93 8 0 0 2 6 0 3.34 17 1 5.07 16 0 0 2 6 0 3.34 7 1 5.07 8 1 0 12 12 2 1 0 12 12 8)
)
