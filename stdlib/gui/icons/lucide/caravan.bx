(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-caravan
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCaravan (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 18 19 1 18 9 4 4 4 0 0 0 14 5 1 6 5 4 4 4 0 0 0 2 9 1 2 17 4 2 2 0 0 0 4 19 1 6 19 0 0 6 28 0 2 9 1 5 9 4 1 1 0 0 1 6 10 1 6 12 4 1 1 0 0 1 5 13 1 2 13 0 0 9 42 0 22 17 1 22 18 4 1 1 0 0 1 21 19 1 10 19 1 10 10 4 1 1 0 0 1 11 9 1 13 9 4 1 1 0 0 1 14 10 1 14 19 1 0 8 19 2)
)
