(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-astroid
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAstroid (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 67 0 12.983 21.186 4 1 1 0 0 1 11.017 21.186 4 10 10 0 0 0 2.814 12.983 4 1 1 0 0 1 2.814 11.017 4 10 10 0 0 0 11.017 2.814 4 1 1 0 0 1 12.983 2.814 4 10 10 0 0 0 21.186 11.017 4 1 1 0 0 1 21.186 12.983 4 10 10 0 0 0 12.983 21.186)
)
