(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-play-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePlayOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 10.215 4.56 1 20.005 10.27 4 2 2 0 0 1 20.008 13.728 1 19.615 13.958 0 0 4 17 0 16.042 16.042 1 8.008 20.728 4 2 2 0 0 1 5 19 1 5 5 0 0 2 6 0 2 2 1 22 22)
)
