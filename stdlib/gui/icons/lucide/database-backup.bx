(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-database-backup
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDatabaseBackup (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 2 0 12 5 9 3 0 0 2 11 0 3 12 4 9 3 0 0 0 8 14.69 0 0 2 6 0 21 9.3 1 21 5 0 0 3 14 0 3 5 1 3 19 4 9 3 0 0 0 9.47 21.88 0 0 3 9 0 12 12 1 12 16 1 16 16 0 0 5 29 0 13 20 4 5 5 0 0 0 22 17 4 4.5 4.5 0 0 0 17.5 12.5 2 16.17 12.5 14.96 13.04 14.09 13.91 1 12 16)
)
