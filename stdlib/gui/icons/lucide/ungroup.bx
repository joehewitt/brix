(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ungroup
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUngroup (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 13 14 1 19 14 4 2 2 0 0 1 21 16 1 21 19 4 2 2 0 0 1 19 21 1 13 21 4 2 2 0 0 1 11 19 1 11 16 4 2 2 0 0 1 13 14 5 0 0 10 48 0 5 3 1 11 3 4 2 2 0 0 1 13 5 1 13 8 4 2 2 0 0 1 11 10 1 5 10 4 2 2 0 0 1 3 8 1 3 5 4 2 2 0 0 1 5 3 5)
)
