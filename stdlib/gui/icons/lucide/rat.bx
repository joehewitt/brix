(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rat
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRat (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 13 22 1 4 22 4 2 2 0 0 1 4 18 1 16 18 0 0 2 11 0 13.236 18 4 3 3 0 0 0 11.036 13 0 0 2 6 0 16 9 1 16.01 9 0 0 6 33 0 16.82 3.94 4 3 3 0 1 1 20.057 8.808 1 21.872 11.395 4 1.5 1.5 0 0 1 20.372 13.495 1 17.5 13.042 4 3 3 0 0 0 14 16.042 0 0 4 27 0 17 4.988 4 3 3 0 1 0 11.8 7.04 4 7 7 0 0 0 4 14.015 4 4 4 0 0 0 8 18)
)
