(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-message-square-dashed
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMessageSquareDashed (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 14 3 1 16 3 0 0 2 6 0 16 19 1 14 19 0 0 2 6 0 2 12 1 2 10 0 0 4 17 0 2 16 1 2 21.286 4 0.71 0.71 0 0 0 3.212 21.788 1 4.361 20.639 0 0 3 14 0 20 19 4 2 2 0 0 0 22 17 1 22 16 0 0 2 6 0 22 10 1 22 12 0 0 3 14 0 22 6 1 22 5 4 2 2 0 0 0 20 3 0 0 3 14 0 4 3 4 2 2 0 0 0 2 5 1 2 6 0 0 2 6 0 8 19 1 10 19 0 0 2 6 0 8 3 1 10 3)
)
