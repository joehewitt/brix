(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rectangle-goggles
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRectangleGoggles (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 15 78 0 20 6 4 2 2 0 0 1 22 8 1 22 16 4 2 2 0 0 1 20 18 1 16 18 4 2 2 0 0 1 14.4 17.2 1 12.8 15.07 4 1 1 0 0 0 11.2 15.07 1 9.6 17.2 4 2 2 0 0 1 8 18 1 4 18 4 2 2 0 0 1 2 16 1 2 8 4 2 2 0 0 1 4 6 5)
)
