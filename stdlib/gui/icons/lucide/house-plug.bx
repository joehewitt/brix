(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-house-plug
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHousePlug (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 12 1 10 8.964 0 0 2 6 0 14 12 1 14 8.964 0 0 9 45 0 15 12 4 1 1 0 0 1 16 13 1 16 15 4 2 2 0 0 1 14 17 1 10 17 4 2 2 0 0 1 8 15 1 8 13 4 1 1 0 0 1 9 12 5 0 0 14 72 0 8.5 21 1 5 21 4 2 2 0 0 1 3 19 1 3 10 4 2 2 0 0 1 3.709 8.472 1 10.709 2.472 4 2 2 0 0 1 13.291 2.472 1 20.291 8.472 4 2 2 0 0 1 21 10 1 21 19 4 2 2 0 0 1 19 21 1 14 21 4 2 2 0 0 1 12 19 1 12 17)
)
