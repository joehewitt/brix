(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-list-checks
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideListChecks (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 13 5 1 21 5 0 0 2 6 0 13 12 1 21 12 0 0 2 6 0 13 19 1 21 19 0 0 3 9 0 3 17 1 5 19 1 9 15 0 0 3 9 0 3 7 1 5 9 1 9 5)
)
