(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-house-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHousePlus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 12.35 21 1 5 21 4 2 2 0 0 1 3 19 1 3 10 4 2 2 0 0 1 3.71 8.47 1 10.71 2.47 4 2 2 0 0 1 13.29 2.47 1 20.29 8.47 4 2 2 0 0 1 21 10 1 21 12.35 0 0 5 25 0 14.8 12.4 4 1 1 0 0 0 14 12 1 10 12 4 1 1 0 0 0 9 13 1 9 21 0 0 2 6 0 15 18 1 21 18 0 0 2 6 0 18 15 1 18 21)
)
