(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-send
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSend (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 14.536 21.686 4 0.5 0.5 0 0 0 15.473 21.662 1 21.973 2.662 4 0.496 0.496 0 0 0 21.338 2.027 1 2.338 8.527 4 0.5 0.5 0 0 0 2.314 9.464 1 10.244 12.644 4 2 2 0 0 1 11.356 13.754 5 0 0 2 6 0 21.854 2.147 1 10.914 13.086)
)
