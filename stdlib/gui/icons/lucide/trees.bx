(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-trees
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTrees (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 37 0 10 10 1 10 10.2 4 3 3 0 0 1 8.9 16 1 5 16 4 3 3 0 0 1 4 10.2 1 4 10 4 3 3 0 0 1 10 10 5 0 0 2 6 0 7 16 1 7 22 0 0 2 6 0 13 19 1 13 22 0 0 11 48 0 12 19 1 20.3 19 4 1 1 0 0 0 21 17.3 1 18 14 1 18.3 14 4 1 1 0 0 0 19 12.3 1 16 9 1 16.2 9 4 1 1 0 0 0 17 7.3 1 13 3 1 11.6 4.5)
)
