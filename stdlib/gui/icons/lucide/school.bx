(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-school
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSchool (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 14 21 1 14 18 4 2 2 0 0 0 10 18 1 10 21 0 0 2 6 0 18 4.933 1 18 21 0 0 4 17 0 4 6 1 11.106 2.21 4 2 2 0 0 1 12.894 2.21 1 20 6 0 0 10 50 0 6 11 1 2.48 13.147 4 1 1 0 0 0 2 14.001 1 2 19 4 2 2 0 0 0 4 21 1 20 21 4 2 2 0 0 0 22 19 1 22 14 4 1 1 0 0 0 21.52 13.147 1 18 11 0 0 2 6 0 6 4.933 1 6 21 1 0 12 9 2)
)
