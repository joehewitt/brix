(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-martini
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMartini (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 26 0 12 12 1 4.207 4.207 4 0.707 0.707 0 0 1 4.707 3 1 19.293 3 4 0.707 0.707 0 0 1 19.793 4.207 5 0 0 2 6 0 12 12 1 12 22 0 0 2 6 0 7 22 1 17 22)
)
