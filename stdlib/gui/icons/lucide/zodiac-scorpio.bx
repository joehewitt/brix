(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zodiac-scorpio
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZodiacScorpio (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 31 0 10 19 1 10 5.5 4 1 1 0 0 1 15 5.5 1 15 17 4 2 2 0 0 0 17 19 1 22 19 1 19 16 0 0 2 6 0 22 19 1 19 22 0 0 3 14 0 5 19 1 5 5.5 4 1 1 0 0 1 10 5.5 0 0 2 11 0 5 5.5 4 2.5 2.5 0 0 0 2.5 3)
)
