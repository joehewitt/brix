(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wand
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWand (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 4 1 15 2 0 0 2 6 0 15 16 1 15 14 0 0 2 6 0 8 9 1 10 9 0 0 2 6 0 20 9 1 22 9 0 0 2 6 0 17.8 11.8 1 19 13 0 0 2 6 0 15 9 1 15.01 9 0 0 2 6 0 17.8 6.2 1 19 5 0 0 2 6 0 3 21 1 12 12 0 0 2 6 0 12.2 6.2 1 11 5)
)
