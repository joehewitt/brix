(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-package-x
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePackageX (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 22 1 12 12 0 0 2 6 0 16.5 14.5 1 21.5 19.5 0 0 2 6 0 16.5 19.5 1 21.5 14.5 0 0 12 61 0 21 10.5 1 21 8 4 2 2 0 0 0 20 6.27 1 13 2.27 4 2 2 0 0 0 11 2.27 1 4 6.27 4 2 2 0 0 0 3 8 1 3 16 4 2 2 0 0 0 4 17.729 1 11 21.729 4 2 2 0 0 0 13 21.73 1 13.13 21.656 0 0 3 9 0 3.29 7 1 12 12 1 20.71 7 0 0 2 6 0 7.5 4.27 1 16.497 9.418)
)
