(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lollipop
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLollipop (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 11 11 8 0 0 2 6 0 21 21 1 16.7 16.7 0 0 4 27 0 11 11 4 2 2 0 0 0 15 11 4 4 4 0 0 0 7 11 4 6 6 0 0 0 19 11)
)
