(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-japanese-yen
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideJapaneseYen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 18 0 12 9.5 1 12 21 0 12 9.5 1 6 3 0 12 9.5 1 18 3 0 0 2 6 0 6 15 1 18 15 0 0 2 6 0 6 11 1 18 11)
)
