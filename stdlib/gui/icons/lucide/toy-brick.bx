(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-toy-brick
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideToyBrick (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 8 1 20 8 4 1 1 0 0 1 21 9 1 21 19 4 1 1 0 0 1 20 20 1 4 20 4 1 1 0 0 1 3 19 1 3 9 4 1 1 0 0 1 4 8 5 0 0 6 27 0 10 8 1 10 5 2 10 4.4 9.6 4 9 4 1 6 4 4 1 1 0 0 0 5 5 1 5 8 0 0 6 27 0 19 8 1 19 5 2 19 4.4 18.6 4 18 4 1 15 4 4 1 1 0 0 0 14 5 1 14 8)
)
