(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-list-start
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideListStart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 3 5 1 9 5 0 0 2 6 0 3 12 1 16 12 0 0 2 6 0 3 19 1 16 19 0 0 3 9 0 16 8 1 13 5 1 16 2 0 0 4 17 0 21 19 1 21 7 4 2 2 0 0 0 19 5 1 13 5)
)
