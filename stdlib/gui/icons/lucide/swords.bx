(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-swords
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSwords (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 15 0 14.5 17.5 1 3 6 1 3 3 1 6 3 1 17.5 14.5 3 0 13 19 19 13 3 0 16 16 20 20 3 0 19 21 21 19 0 0 5 15 0 14.5 6.5 1 18 3 1 21 3 1 21 6 1 17.5 9.5 3 0 5 14 9 18 3 0 7 17 4 20 3 0 3 19 5 21)
)
