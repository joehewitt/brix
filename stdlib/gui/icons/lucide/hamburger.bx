(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hamburger
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHamburger (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 12 16 1 4 16 4 2 2 0 1 1 4 12 1 20 12 4 2 2 0 1 1 20 16 1 15.75 16 0 0 4 27 0 5 12 4 2 2 0 0 1 3 10 4 9 7 0 0 1 21 10 4 2 2 0 0 1 19 12 0 0 7 43 0 5 16 4 2 2 0 0 0 3 18 4 3 3 0 0 0 6 21 1 18 21 4 3 3 0 0 0 21 18 4 2 2 0 0 0 19 16 3 19 16 19 16 0 0 4 17 0 6.67 12 1 12.8 16.6 4 2 2 0 0 0 15.6 16.2 1 18.75 12)
)
