(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zodiac-gemini
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZodiacGemini (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 4.525 1 16 19.473 0 0 2 11 0 20 3 4 17 17 0 0 1 4 3 0 0 2 11 0 4 21 4 17 17 0 0 1 20 21 0 0 2 6 0 8 4.525 1 8 19.473)
)
