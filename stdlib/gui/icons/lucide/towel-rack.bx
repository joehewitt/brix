(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-towel-rack
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTowelRack (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 22 7 1 20 7 0 0 12 61 0 6.5 3 1 17.5 3 4 2.5 2.5 0 0 1 20 5.5 1 20 20 4 1 1 0 0 1 19 21 1 10 21 4 1 1 0 0 1 9 20 1 9 5.5 4 1 1 0 0 0 4 5.5 1 4 17 4 1 1 0 0 0 5 18 1 9 18 0 0 2 6 0 9 7 1 2 7)
)
