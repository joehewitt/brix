(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-audio-lines-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAudioLinesOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 10 1 10 21 0 0 2 6 0 10 3 1 10 4.35 0 0 2 6 0 14 14 1 14 15 0 0 2 6 0 14 8 1 14 8.35 0 0 2 6 0 18 5 1 18 12.35 0 0 2 6 0 2 10 1 2 13 0 0 2 6 0 2 2 1 22 22 0 0 2 6 0 22 10 1 22 13 0 0 2 6 0 6 6 1 6 17)
)
