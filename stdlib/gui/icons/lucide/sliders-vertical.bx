(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sliders-vertical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSlidersVertical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 8 1 14 8 0 0 2 6 0 12 21 1 12 12 0 0 2 6 0 12 8 1 12 3 0 0 2 6 0 17 16 1 21 16 0 0 2 6 0 19 12 1 19 3 0 0 2 6 0 19 21 1 19 16 0 0 2 6 0 3 14 1 7 14 0 0 2 6 0 5 10 1 5 3 0 0 2 6 0 5 21 1 5 14)
)
