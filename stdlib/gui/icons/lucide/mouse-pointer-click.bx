(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mouse-pointer-click
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMousePointerClick (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 14 4.1 1 12 6 0 0 2 6 0 5.1 8 1 2.2 7.2 0 0 2 6 0 6 12 1 4.1 14 0 0 2 6 0 7.2 2.2 1 8 5.1 0 0 9 45 0 9.037 9.69 4 0.498 0.498 0 0 1 9.69 9.037 1 20.69 13.537 4 0.5 0.5 0 0 1 20.616 14.486 1 16.267 15.527 4 1 1 0 0 0 15.527 16.266 1 14.487 20.616 4 0.5 0.5 0 0 1 13.537 20.69 5)
)
