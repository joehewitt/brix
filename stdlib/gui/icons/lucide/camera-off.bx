(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-camera-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCameraOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 14.564 14.558 4 3 3 0 1 1 10.442 10.437 0 0 2 6 0 2 2 1 22 22 0 0 7 36 0 20 20 1 4 20 4 2 2 0 0 1 2 18 1 2 9 4 2 2 0 0 1 4 7 1 5.997 7 4 2 2 0 0 0 6.816 6.825 0 0 9 47 0 9.695 4.024 4 2 2 0 0 1 10.004 4 1 13.997 4 4 2 2 0 0 1 15.757 5.05 1 16.243 5.95 4 2 2 0 0 0 18.003 7 1 20 7 4 2 2 0 0 1 22 9 1 22 16.344)
)
