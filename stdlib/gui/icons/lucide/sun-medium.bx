(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sun-medium
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSunMedium (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 4 0 0 2 6 0 12 3 1 12 4 0 0 2 6 0 12 20 1 12 21 0 0 2 6 0 3 12 1 4 12 0 0 2 6 0 20 12 1 21 12 0 0 2 6 0 18.364 5.636 1 17.657 6.343 0 0 2 6 0 6.343 17.657 1 5.636 18.364 0 0 2 6 0 5.636 5.636 1 6.343 6.343 0 0 2 6 0 17.657 17.657 1 18.364 18.364)
)
