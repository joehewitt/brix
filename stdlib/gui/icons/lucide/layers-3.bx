(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-layers-3
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLayersN3 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 12.83 2.18 4 2 2 0 0 0 11.17 2.18 1 2.6 6.08 4 1 1 0 0 0 2.6 7.91 1 11.18 11.82 4 2 2 0 0 0 12.84 11.82 1 21.42 7.92 4 1 1 0 0 0 21.42 6.09 5 0 0 6 33 0 2 12 4 1 1 0 0 0 2.58 12.91 1 11.18 16.82 4 2 2 0 0 0 12.83 16.82 1 21.41 12.92 4 1 1 0 0 0 22 12 0 0 6 33 0 2 17 4 1 1 0 0 0 2.58 17.91 1 11.18 21.82 4 2 2 0 0 0 12.83 21.82 1 21.41 17.92 4 1 1 0 0 0 22 17)
)
