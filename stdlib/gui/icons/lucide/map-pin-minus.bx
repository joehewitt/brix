(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-map-pin-minus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMapPinMinus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 41 0 18.977 14 2 19.6 12.701 20 11.343 20 10 4 8 8 0 0 0 4 10 2 4 14.993 9.539 20.193 11.399 21.799 4 1 1 0 0 0 12.601 21.799 4 32 32 0 0 0 13.425 21.061 1 0 12 10 3 0 0 2 6 0 16 18 1 22 18)
)
