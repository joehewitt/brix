(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-book-heart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBookHeart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 4 19.5 1 4 4.5 4 2.5 2.5 0 0 1 6.5 2 1 19 2 4 1 1 0 0 1 20 3 1 20 21 4 1 1 0 0 1 19 22 1 6.5 22 4 1 1 0 0 1 6.5 17 1 20 17 0 0 6 31 0 8.62 9.8 4 2.25 2.25 0 1 1 12 6.836 4 2.25 2.25 0 1 1 15.38 9.802 1 12.754 12.658 4 0.998 0.998 0 0 1 11.247 12.658 5)
)
