(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pause
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePause (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 15 3 1 18 3 4 1 1 0 0 1 19 4 1 19 20 4 1 1 0 0 1 18 21 1 15 21 4 1 1 0 0 1 14 20 1 14 4 4 1 1 0 0 1 15 3 5 0 0 10 48 0 6 3 1 9 3 4 1 1 0 0 1 10 4 1 10 20 4 1 1 0 0 1 9 21 1 6 21 4 1 1 0 0 1 5 20 1 5 4 4 1 1 0 0 1 6 3 5)
)
