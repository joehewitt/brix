(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lightbulb-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLightbulbOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 18 0 16.8 11.2 2 17.6 10.3 18 9.2 18 8 4 6 6 0 0 0 8.7 3 0 0 2 6 0 2 2 1 22 22 0 0 3 18 0 6.3 6.3 4 4.67 4.67 0 0 0 7.5 11.5 2 8.2 12.2 8.8 13 9 14 0 0 2 6 0 9 18 1 15 18 0 0 2 6 0 10 22 1 14 22)
)
