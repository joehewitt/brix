(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-git-branch-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGitBranchPlus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 6 3 1 6 15 0 0 4 20 0 18 9 4 3 3 0 1 0 18 3 4 3 3 0 0 0 18 9 5 0 0 4 20 0 6 21 4 3 3 0 1 0 6 15 4 3 3 0 0 0 6 21 5 0 0 2 11 0 15 6 4 9 9 0 0 0 6 15 0 0 2 6 0 18 15 1 18 21 0 0 2 6 0 21 18 1 15 18)
)
