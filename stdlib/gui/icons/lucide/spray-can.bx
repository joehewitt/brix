(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-spray-can
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSprayCan (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 3 3 1 3.01 3 0 0 2 6 0 7 5 1 7.01 5 0 0 2 6 0 11 7 1 11.01 7 0 0 2 6 0 3 7 1 3.01 7 0 0 2 6 0 7 9 1 7.01 9 0 0 2 6 0 3 11 1 3.01 11 4 0 15 5 4 4 0 0 8 32 0 19 9 1 21 11 1 21 21 2 21 21.6 20.6 22 20 22 1 14 22 2 13.4 22 13 21.6 13 21 1 13 11 1 15 9 0 0 2 6 0 13 14 1 21 12 0 0 2 6 0 13 19 1 21 17)
)
