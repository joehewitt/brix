(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-maximize
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMaximize (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 8 3 1 5 3 4 2 2 0 0 0 3 5 1 3 8 0 0 4 17 0 21 8 1 21 5 4 2 2 0 0 0 19 3 1 16 3 0 0 4 17 0 3 16 1 3 19 4 2 2 0 0 0 5 21 1 8 21 0 0 4 17 0 16 21 1 19 21 4 2 2 0 0 0 21 19 1 21 16)
)
