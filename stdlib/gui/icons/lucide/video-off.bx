(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-video-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVideoOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 31 0 10.66 6 1 14 6 4 2 2 0 0 1 16 8 1 16 10.5 1 21.248 7.438 4 0.5 0.5 0 0 1 22 7.87 1 22 16.066 0 0 7 36 0 16 16 4 2 2 0 0 1 14 18 1 4 18 4 2 2 0 0 1 2 16 1 2 8 4 2 2 0 0 1 4 6 1 6 6 0 0 2 6 0 2 2 1 22 22)
)
