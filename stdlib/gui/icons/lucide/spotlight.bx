(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-spotlight
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSpotlight (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15.295 19.562 1 16 22 0 0 2 6 0 17 16 1 20.758 18.098 0 0 2 6 0 19 12.5 1 22.026 11.902 0 0 9 45 0 7.61 6.3 4 3 3 0 0 0 3.69 7.6 1 2.31 10.39 4 3 3 0 0 0 3.61 14.3 1 10.5 17.897 4 1 1 0 0 0 11.842 17.45 1 14.948 11.239 4 1 1 0 0 0 14.501 9.898 5 0 0 2 6 0 8 9 1 8 2)
)
