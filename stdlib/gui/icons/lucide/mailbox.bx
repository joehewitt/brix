(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mailbox
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMailbox (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 46 0 22 17 4 2 2 0 0 1 20 19 1 4 19 4 2 2 0 0 1 2 17 1 2 9.5 2 2 7 4 5 6.5 5 1 18 5 2 20.2 5 22 6.8 22 9 1 22 17 5 0 0 3 9 0 15 9 1 18 9 1 18 11 0 0 4 21 0 6.5 5 2 9 5 11 7 11 9.5 1 11 17 4 2 2 0 0 1 9 19 3 0 6 10 7 10)
)
