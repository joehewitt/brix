(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-folder-git-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFolderGitN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 18 19 4 5 5 0 0 1 13 14 1 13 22 0 0 12 61 0 9 20 1 4 20 4 2 2 0 0 1 2 18 1 2 5 4 2 2 0 0 1 4 3 1 7.9 3 4 2 2 0 0 1 9.59 3.9 1 10.4 5.1 4 2 2 0 0 0 12.07 6 1 20 6 4 2 2 0 0 1 22 8 1 22 13 1 0 13 12 2 1 0 20 19 2)
)
