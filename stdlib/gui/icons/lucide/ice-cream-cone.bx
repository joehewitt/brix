(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ice-cream-cone
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideIceCreamCone (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 7 11 1 11.08 21.35 4 1 1 0 0 0 12.92 21.35 1 17 11 0 0 2 11 0 17 7 4 5 5 0 0 0 7 7 0 0 4 22 0 17 7 4 2 2 0 0 1 17 11 1 7 11 4 2 2 0 0 1 7 7)
)
