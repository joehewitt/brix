(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-stack
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileStack (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 33 0 11 21 4 1 1 0 0 1 10 22 1 4 22 4 1 1 0 0 1 3 21 1 3 13 4 1 1 0 0 1 4 12 0 0 6 33 0 16 16 4 1 1 0 0 1 15 17 1 9 17 4 1 1 0 0 1 8 16 1 8 8 4 1 1 0 0 1 9 7 0 0 11 56 0 21 6 4 2 2 0 0 0 20.414 4.586 1 18.414 2.586 4 2 2 0 0 0 17 2 1 14 2 4 1 1 0 0 0 13 3 1 13 11 4 1 1 0 0 0 14 12 1 20 12 4 1 1 0 0 0 21 11 5)
)
