(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sticky-notes
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStickyNotes (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 10 8 4 2.4 2.4 0 0 1 11.706 8.706 1 15.294 12.294 4 2.4 2.4 0 0 1 16 14 1 16 20 4 2 2 0 0 1 14 22 1 4 22 4 2 2 0 0 1 2 20 1 2 10 4 2 2 0 0 1 4 8 5 0 0 4 17 0 10 8 1 10 13 4 1 1 0 0 0 11 14 1 16 14 0 0 8 44 0 8 4 4 2 2 0 0 1 10 2 1 16 2 4 2.4 2.4 0 0 1 17.706 2.706 1 21.294 6.294 4 2.4 2.4 0 0 1 22 8 1 22 14 4 2 2 0 0 1 20 16 0 0 4 17 0 16 2 1 16 7 4 1 1 0 0 0 17 8 1 22 8)
)
