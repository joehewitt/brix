(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-picture-in-picture
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePictureInPicture (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 2 10 1 8 10 1 8 4 0 0 2 6 0 2 4 1 8 10 0 0 4 17 0 21 10 1 21 7 4 2 2 0 0 0 19 5 1 12 5 0 0 4 17 0 3 14 1 3 16 4 2 2 0 0 0 5 18 1 8 18 0 0 10 48 0 13 14 1 21 14 4 1 1 0 0 1 22 15 1 22 20 4 1 1 0 0 1 21 21 1 13 21 4 1 1 0 0 1 12 20 1 12 15 4 1 1 0 0 1 13 14 5)
)
