(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-phone
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePhone (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 17 101 0 13.832 16.568 4 1 1 0 0 0 15.045 16.265 1 15.4 15.8 4 2 2 0 0 1 17 15 1 20 15 4 2 2 0 0 1 22 17 1 22 20 4 2 2 0 0 1 20 22 4 18 18 0 0 1 2 4 4 2 2 0 0 1 4 2 1 7 2 4 2 2 0 0 1 9 4 1 9 7 4 2 2 0 0 1 8.2 8.6 1 7.732 8.951 4 1 1 0 0 0 7.44 10.184 4 14 14 0 0 0 13.832 16.568)
)
