(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-glass-water
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGlassWater (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 5.116 4.104 4 1 1 0 0 1 6.11 3 1 17.89 3 4 1 1 0 0 1 18.884 4.105 1 17.19 20.21 4 2 2 0 0 1 15.2 22 1 8.8 22 4 2 2 0 0 1 6.8 20.21 5 0 0 3 19 0 6 12 4 5 5 0 0 1 12 12 4 5 5 0 0 0 18 12)
)
