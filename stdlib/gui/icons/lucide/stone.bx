(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-stone
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStone (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 11.264 2.205 4 4 4 0 0 0 6.42 4.211 1 2.42 12.211 4 4 4 0 0 0 3.779 17.328 1 9.779 21.328 4 4 4 0 0 0 14.217 21.328 1 20.217 17.328 4 4 4 0 0 0 21.793 12.736 1 19.793 6.736 4 4 4 0 0 0 17.263 4.206 5 0 0 3 9 0 11.99 22 1 14 12 1 21.822 15.184 0 0 2 6 0 14 12 1 8.47 2.302)
)
