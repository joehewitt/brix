(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hd
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHd (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 12 1 6 12 0 0 2 6 0 10 15 1 10 9 0 0 9 45 0 14 14.5 4 0.5 0.5 0 0 0 14.5 15 1 15.5 15 4 2.5 2.5 0 0 0 18 12.5 1 18 11.5 4 2.5 2.5 0 0 0 15.5 9 1 14.5 9 4 0.5 0.5 0 0 0 14 9.5 5 0 0 2 6 0 6 15 1 6 9 0 0 10 48 0 4 5 1 20 5 4 2 2 0 0 1 22 7 1 22 17 4 2 2 0 0 1 20 19 1 4 19 4 2 2 0 0 1 2 17 1 2 7 4 2 2 0 0 1 4 5 5)
)
