(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-coins
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCoins (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 13.744 17.736 4 6 6 0 1 1 6.264 10.256 0 0 3 9 0 15 6 1 16 6 1 16 10 0 0 3 9 0 6.134 14.768 1 7 14.268 1 9 17.732 1 0 16 8 6)
)
