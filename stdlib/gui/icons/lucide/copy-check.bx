(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-copy-check
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCopyCheck (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 12 15 1 14 17 1 18 13 0 0 10 48 0 10 8 1 20 8 4 2 2 0 0 1 22 10 1 22 20 4 2 2 0 0 1 20 22 1 10 22 4 2 2 0 0 1 8 20 1 8 10 4 2 2 0 0 1 10 8 5 0 0 6 30 0 4 16 2 2.9 16 2 15.1 2 14 1 2 4 2 2 2.9 2.9 2 4 2 1 14 2 2 15.1 2 16 2.9 16 4)
)
