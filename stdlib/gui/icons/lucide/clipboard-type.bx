(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-clipboard-type
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideClipboardType (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 9 2 1 15 2 4 1 1 0 0 1 16 3 1 16 5 4 1 1 0 0 1 15 6 1 9 6 4 1 1 0 0 1 8 5 1 8 3 4 1 1 0 0 1 9 2 5 0 0 10 50 0 16 4 1 18 4 4 2 2 0 0 1 20 6 1 20 20 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4 20 1 4 6 4 2 2 0 0 1 6 4 1 8 4 0 0 4 12 0 9 12 1 9 11 1 15 11 1 15 12 0 0 2 6 0 11 17 1 13 17 0 0 2 6 0 12 11 1 12 17)
)
