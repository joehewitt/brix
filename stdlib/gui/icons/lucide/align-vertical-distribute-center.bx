(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-vertical-distribute-center
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignVerticalDistributeCenter (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 22 17 1 19 17 0 0 2 6 0 22 7 1 17 7 0 0 2 6 0 5 17 1 2 17 0 0 2 6 0 7 7 1 2 7 0 0 10 48 0 7 14 1 17 14 4 2 2 0 0 1 19 16 1 19 18 4 2 2 0 0 1 17 20 1 7 20 4 2 2 0 0 1 5 18 1 5 16 4 2 2 0 0 1 7 14 5 0 0 10 48 0 9 4 1 15 4 4 2 2 0 0 1 17 6 1 17 8 4 2 2 0 0 1 15 10 1 9 10 4 2 2 0 0 1 7 8 1 7 6 4 2 2 0 0 1 9 4 5)
)
