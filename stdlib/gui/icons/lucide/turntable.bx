(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-turntable
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTurntable (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 12.01 1 10.01 12.01 0 0 3 14 0 18 8 1 18 12 4 8 8 0 0 1 16.93 16 1 0 10 12 4 0 0 10 48 0 4 4 1 20 4 4 2 2 0 0 1 22 6 1 22 18 4 2 2 0 0 1 20 20 1 4 20 4 2 2 0 0 1 2 18 1 2 6 4 2 2 0 0 1 4 4 5)
)
