(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chart-bar-stacked
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChartBarStacked (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 13 1 11 17 0 0 2 6 0 15 5 1 15 9 0 0 4 17 0 3 3 1 3 19 4 2 2 0 0 0 5 21 1 21 21 0 0 10 48 0 8 13 1 15 13 4 1 1 0 0 1 16 14 1 16 16 4 1 1 0 0 1 15 17 1 8 17 4 1 1 0 0 1 7 16 1 7 14 4 1 1 0 0 1 8 13 5 0 0 10 48 0 8 5 1 18 5 4 1 1 0 0 1 19 6 1 19 8 4 1 1 0 0 1 18 9 1 8 9 4 1 1 0 0 1 7 8 1 7 6 4 1 1 0 0 1 8 5 5)
)
