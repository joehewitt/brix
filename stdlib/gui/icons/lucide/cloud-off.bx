(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cloud-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCloudOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 22 0 10.94 5.274 4 7 7 0 0 1 15.71 10 1 17.5 10 4 4.5 4.5 0 0 1 21.722 16.057 0 0 4 22 0 18.796 18.81 4 4.5 4.5 0 0 1 17.5 19 1 9 19 4 7 7 0 0 1 5.79 5.78 0 0 2 6 0 2 2 1 22 22)
)
