(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-database-arrow-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDatabaseArrowDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 16 19 1 19 22 1 22 19 0 0 2 6 0 19 16 1 19 22 0 0 2 6 0 21 12.536 1 21 5 0 0 2 11 0 3 12 4 9 3 0 0 0 15.182 14.806 0 0 3 14 0 3 5 1 3 19 4 9 3 0 0 0 13.318 21.968 2 0 12 5 9 3)
)
