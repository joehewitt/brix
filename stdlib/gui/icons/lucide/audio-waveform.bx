(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-audio-waveform
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAudioWaveform (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 66 0 2 13 4 2 2 0 0 0 4 11 1 4 7 4 2 2 0 0 1 8 7 1 8 20 4 2 2 0 0 0 12 20 1 12 4 4 2 2 0 0 1 16 4 1 16 17 4 2 2 0 0 0 20 17 1 20 13 4 2 2 0 0 1 22 11)
)
