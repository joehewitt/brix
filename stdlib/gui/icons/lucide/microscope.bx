(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-microscope
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMicroscope (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 6 18 1 14 18 0 0 2 6 0 3 22 1 21 22 0 0 3 14 0 14 22 4 7 7 0 1 0 14 8 1 13 8 0 0 2 6 0 9 14 1 11 14 0 0 7 29 0 9 12 4 2 2 0 0 1 7 10 1 7 6 1 13 6 1 13 10 4 2 2 0 0 1 11 12 5 0 0 6 28 0 12 6 1 12 3 4 1 1 0 0 0 11 2 1 9 2 4 1 1 0 0 0 8 3 1 8 6)
)
