(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-repeat-1
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRepeatN1 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 17 2 1 21 6 1 17 10 0 0 4 17 0 3 11 1 3 10 4 4 4 0 0 1 7 6 1 21 6 0 0 3 9 0 7 22 1 3 18 1 7 14 0 0 4 17 0 21 13 1 21 14 4 4 4 0 0 1 17 18 1 3 18 0 0 3 9 0 11 10 1 12 10 1 12 14)
)
