(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rotate-ccw-square
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRotateCcwSquare (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 20 9 1 20 7 4 2 2 0 0 0 18 5 1 12 5 0 0 3 9 0 15 2 1 12 5 1 15 8 0 0 8 39 0 20 13 1 20 18 4 2 2 0 0 1 18 20 1 6 20 4 2 2 0 0 1 4 18 1 4 7 4 2 2 0 0 1 6 5 1 8 5)
)
