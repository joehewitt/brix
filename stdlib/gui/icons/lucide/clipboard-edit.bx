(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-clipboard-edit
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideClipboardEdit (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 16 4 1 18 4 4 2 2 0 0 1 20 6 1 20 8 0 0 9 45 0 21.34 15.664 4 1 1 0 1 0 18.336 12.66 1 13.326 17.672 4 2 2 0 0 0 12.82 18.526 1 11.983 21.396 4 0.5 0.5 0 0 0 12.603 22.016 1 15.473 21.179 4 2 2 0 0 0 16.327 20.673 5 0 0 6 28 0 8 22 1 6 22 4 2 2 0 0 1 4 20 1 4 6 4 2 2 0 0 1 6 4 1 8 4 0 0 10 48 0 9 2 1 15 2 4 1 1 0 0 1 16 3 1 16 5 4 1 1 0 0 1 15 6 1 9 6 4 1 1 0 0 1 8 5 1 8 3 4 1 1 0 0 1 9 2 5)
)
