(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-delete
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDelete (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 10 5 4 2 2 0 0 0 8.656 5.519 1 2.328 11.259 4 1 1 0 0 0 2.328 12.74 1 8.656 18.481 4 2 2 0 0 0 10 19 1 20 19 4 2 2 0 0 0 22 17 1 22 7 4 2 2 0 0 0 20 5 5 0 0 2 6 0 12 9 1 18 15 0 0 2 6 0 18 9 1 12 15)
)
