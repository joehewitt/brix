(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ampersands
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAmpersands (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 39 0 10 17 2 5 14 3 10 3 8 4 2 2 0 0 1 7 8 2 7 10.5 2 10.5 2 14 2 2 15.7 3.3 17 5 17 2 7.8 17 10 14.8 10 12 0 0 6 39 0 22 17 2 17 14 15 10 15 8 4 2 2 0 0 1 19 8 2 19 10.5 14 10.5 14 14 2 14 15.7 15.3 17 17 17 2 19.8 17 22 14.8 22 12)
)
