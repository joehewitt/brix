(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-case-upper
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCaseUpper (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 47 0 15 11 1 19.5 11 4 1 1 0 0 1 19.5 16 1 15.5 16 4 0.5 0.5 0 0 1 15 15.5 1 15 6.5 4 0.5 0.5 0 0 1 15.5 6 1 18.5 6 4 1 1 0 0 1 18.5 11 0 0 4 17 0 2 16 1 6.039 6.31 4 0.5 0.5 0 0 1 6.962 6.31 1 11 16 0 0 2 6 0 3.304 13 1 9.696 13)
)
