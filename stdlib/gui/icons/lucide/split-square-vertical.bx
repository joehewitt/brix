(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-split-square-vertical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSplitSquareVertical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 26 0 5 8 1 5 5 2 5 4 6 3 7 3 1 17 3 2 18 3 19 4 19 5 1 19 8 0 0 6 26 0 19 16 1 19 19 2 19 20 18 21 17 21 1 7 21 2 6 21 5 20 5 19 1 5 16 3 0 4 12 20 12)
)
