(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-thumbs-up
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideThumbsUp (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 15 73 0 15 5.88 1 14 10 1 19.83 10 4 2 2 0 0 1 21.75 12.56 1 19.42 20.56 4 2 2 0 0 1 17.5 22 1 4 22 4 2 2 0 0 1 2 20 1 2 12 4 2 2 0 0 1 4 10 1 6.76 10 4 2 2 0 0 0 8.55 8.89 1 12 2 4 3.13 3.13 0 0 1 15 5.88 5 0 0 2 6 0 7 10 1 7 22)
)
