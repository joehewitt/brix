(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-thumbs-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideThumbsDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 15 73 0 9 18.12 1 10 14 1 4.17 14 4 2 2 0 0 1 2.25 11.44 1 4.58 3.44 4 2 2 0 0 1 6.5 2 1 20 2 4 2 2 0 0 1 22 4 1 22 12 4 2 2 0 0 1 20 14 1 17.24 14 4 2 2 0 0 0 15.45 15.11 1 12 22 4 3.13 3.13 0 0 1 9 18.12 5 0 0 2 6 0 17 14 1 17 2)
)
