(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-git-pull-request-create
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGitPullRequestCreate (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 6 6 3 0 0 2 6 0 6 9 1 6 21 0 0 4 17 0 13 6 1 16 6 4 2 2 0 0 1 18 8 1 18 11 0 0 2 6 0 18 15 1 18 21 0 0 2 6 0 21 18 1 15 18)
)
