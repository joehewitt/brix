(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cctv-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCctvOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 34 0 12.309 6.652 1 17.106 9.053 4 1 1 0 0 1 17.553 10.394 1 17.052 11.395 1 17.657 12 1 20.382 12 4 1 1 0 0 1 21.276 13.447 1 20.552 14.895 0 0 7 36 0 15.166 15.166 1 14.447 16.605 4 1 1 0 0 1 13.105 17.052 1 3.61 12.3 4 2.92 2.92 0 0 1 2.31 8.39 1 3.69 5.6 4 2.9 2.9 0 0 1 4.563 4.563 0 0 4 17 0 2 19 1 5.76 19 4 2 2 0 0 0 7.56 17.9 1 9.001 14.998 0 0 2 6 0 2 2 1 22 22 0 0 2 6 0 2 21 1 2 17 0 0 2 6 0 7 9 1 7.01 9)
)
