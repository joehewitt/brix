(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-vibrate-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVibrateOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 15 0 2 8 1 4 10 1 2 12 1 4 14 1 2 16 0 0 5 15 0 22 8 1 20 10 1 22 12 1 20 14 1 22 16 0 0 6 26 0 8 8 1 8 18 2 8 18.55 8.45 19 9 19 1 15 19 2 15.55 19 16 18.55 16 18 1 16 16 0 0 4 16 0 16 10.34 1 16 6 2 16 5.45 15.55 5 15 5 1 10.66 5 3 0 2 2 22 22)
)
