(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hop-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHopOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 17 0 10.82 16.12 2 12.51 16.72 14.73 16.91 16 16.97 2 16.28 16.98 16.53 16.88 16.7 16.7 0 0 4 24 0 11.14 20.57 2 11.66 20.81 13.58 21.69 15.22 21.94 2 15.68 22 16.08 21.69 16.12 21.23 2 16.24 19.71 15.82 17.8 15.62 16.95 0 0 3 18 0 16.13 21.05 2 17.78 21.68 19.81 21.89 21 21.96 4 0.9 0.9 0 0 0 21.7 21.7 0 0 4 26 0 17.99 5.52 4 20.83 20.83 0 0 1 21.14 10.02 4 0.8 0.8 0 0 1 20.46 11.15 2 19.29 11.25 17.96 11.17 16.56 10.9 0 0 3 17 0 20.57 11.14 2 20.81 11.66 21.69 13.58 21.94 15.22 2 21.98 15.52 21.86 15.81 21.63 15.97 0 0 6 40 0 4.93 4.93 4 10 10 0 0 0 4.26 18.33 2 4.61 18.76 5.22 18.73 5.43 18.21 2 6.12 16.5 6.5 13.14 6.5 11.5 2 7.84 11.95 9.6 12.4 11.38 12.12 4 0.85 0.85 0 0 0 11.86 11.88 0 0 4 25 0 5.52 17.99 2 6.57 18.94 8.43 20.41 10.02 21.14 4 0.8 0.8 0 0 0 11.15 20.46 2 11.35 18.12 10.82 15.16 9.58 12.18 0 0 4 25 0 8.35 2.68 4 10 10 0 0 1 18.33 4.26 2 18.76 4.61 18.73 5.22 18.21 5.43 2 16.71 6.03 13.91 6.41 12.14 6.48 0 0 2 6 0 2 2 1 22 22)
)
