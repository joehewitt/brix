(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-list-todo
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideListTodo (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 13 5 1 21 5 0 0 2 6 0 13 12 1 21 12 0 0 2 6 0 13 19 1 21 19 0 0 3 9 0 3 17 1 5 19 1 9 15 0 0 10 48 0 4 4 1 8 4 4 1 1 0 0 1 9 5 1 9 9 4 1 1 0 0 1 8 10 1 4 10 4 1 1 0 0 1 3 9 1 3 5 4 1 1 0 0 1 4 4 5)
)
