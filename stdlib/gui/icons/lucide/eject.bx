(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-eject
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEject (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 34 0 4 13 4 1 1 0 0 1 3.28 11.305 1 10.537 3.637 4 2 2 0 0 1 13.463 3.637 1 20.719 11.305 4 1 1 0 0 1 20 13 5 0 0 10 48 0 4 17 1 20 17 4 1 1 0 0 1 21 18 1 21 20 4 1 1 0 0 1 20 21 1 4 21 4 1 1 0 0 1 3 20 1 3 18 4 1 1 0 0 1 4 17 5)
)
