(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-import
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideImport (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 3 1 12 15 0 0 3 9 0 8 11 1 12 15 1 16 11 0 0 10 50 0 8 5 1 4 5 4 2 2 0 0 0 2 7 1 2 17 4 2 2 0 0 0 4 19 1 20 19 4 2 2 0 0 0 22 17 1 22 7 4 2 2 0 0 0 20 5 1 16 5)
)
