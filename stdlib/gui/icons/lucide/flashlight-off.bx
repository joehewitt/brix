(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flashlight-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlashlightOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11.652 6 1 18 6 0 0 2 6 0 12 13 1 12 14 0 0 10 50 0 16 16 1 16 20 4 2 2 0 0 1 14 22 1 10 22 4 2 2 0 0 1 8 20 1 8 12 4 4 4 0 0 0 7.2 9.6 1 6.6 8.8 4 3 3 0 0 1 6 7 1 6 6 0 0 2 6 0 2 2 1 22 22 0 0 7 36 0 7.649 2 1 17 2 4 1 1 0 0 1 18 3 1 18 7 4 3 3 0 0 1 17.4 8.8 1 16.8 9.6 4 4 4 0 0 0 16.25 10.607)
)
