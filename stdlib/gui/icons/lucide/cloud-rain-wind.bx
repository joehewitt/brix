(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cloud-rain-wind
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCloudRainWind (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 22 0 4 14.899 4 7 7 0 1 1 15.71 8 1 17.5 8 4 4.5 4.5 0 0 1 20 16.242 0 0 2 6 0 9.2 22 1 12.2 15 0 0 2 6 0 9 13 1 6 20 0 0 2 6 0 17 13 1 14 20)
)
