(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mail-search
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMailSearch (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 38 0 22 12.5 1 22 6 4 2 2 0 0 0 20 4 1 4 4 4 2 2 0 0 0 2 6 1 2 18 2 2 19.1 2.9 20 4 20 1 11.5 20 0 0 4 17 0 22 7 1 13.03 12.7 4 1.94 1.94 0 0 1 10.97 12.7 1 2 7 0 0 4 20 0 18 21 4 3 3 0 1 0 18 15 4 3 3 0 0 0 18 21 5 1 0 18 18 3 0 0 2 6 0 22 22 1 20.5 20.5)
)
