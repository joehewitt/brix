(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-fingerprint-pattern
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFingerprintPattern (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 18 0 12 10 4 2 2 0 0 0 10 12 2 10 13.02 9.9 14.51 9.74 16 0 0 2 10 0 14 13.12 2 14 15.5 14 19.5 13 22 0 0 2 10 0 17.29 21.02 2 17.41 20.42 17.72 18.72 17.79 18 0 0 2 11 0 2 12 4 10 10 0 0 1 20 6 0 0 2 6 0 2 16 1 2.01 16 0 0 2 10 0 21.8 16 2 22 14 21.931 10.646 21.8 10 0 0 3 18 0 5 19.5 2 5.5 18 6 15 6 12 4 6 6 0 0 1 6.34 10 0 0 2 10 0 8.65 22 2 8.86 21.34 9.1 20.68 9.22 20 0 0 3 14 0 9 6.8 4 6 6 0 0 1 18 12 1 18 14)
)
