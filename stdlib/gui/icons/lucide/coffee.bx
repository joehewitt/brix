(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-coffee
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCoffee (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 2 1 10 4 0 0 2 6 0 14 2 1 14 4 0 0 11 58 0 16 8 4 1 1 0 0 1 17 9 1 17 17 4 4 4 0 0 1 13 21 1 7 21 4 4 4 0 0 1 3 17 1 3 9 4 1 1 0 0 1 4 8 1 18 8 4 4 4 0 1 1 18 16 1 17 16 0 0 2 6 0 6 2 1 6 4)
)
