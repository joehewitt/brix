(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-layer-arrow-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLayerArrowDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 10 1 12 20 0 0 3 14 0 22 10 4 1 1 0 0 1 21.41 10.92 1 16.333 13.228 0 0 7 36 0 22.017 10.005 4 1 1 0 0 0 21.42 9.089 1 12.83 5.179 4 2 2 0 0 0 11.17 5.18 1 2.6 9.08 4 1 1 0 0 0 2.58 10.911 1 7.673 13.227 0 0 3 9 0 9 17 1 12 20 1 15 17)
)
