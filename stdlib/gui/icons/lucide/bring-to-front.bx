(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bring-to-front
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBringToFront (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 10 8 1 14 8 4 2 2 0 0 1 16 10 1 16 14 4 2 2 0 0 1 14 16 1 10 16 4 2 2 0 0 1 8 14 1 8 10 4 2 2 0 0 1 10 8 5 0 0 6 33 0 4 10 4 2 2 0 0 1 2 8 1 2 4 4 2 2 0 0 1 4 2 1 8 2 4 2 2 0 0 1 10 4 0 0 6 33 0 14 20 4 2 2 0 0 0 16 22 1 20 22 4 2 2 0 0 0 22 20 1 22 16 4 2 2 0 0 0 20 14)
)
