(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-monitor-speaker
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMonitorSpeaker (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 5.5 20 1 8 20 0 0 2 6 0 17 9 1 17.01 9 0 0 10 48 0 14 4 1 20 4 4 2 2 0 0 1 22 6 1 22 18 4 2 2 0 0 1 20 20 1 14 20 4 2 2 0 0 1 12 18 1 12 6 4 2 2 0 0 1 14 4 5 0 0 6 28 0 8 6 1 4 6 4 2 2 0 0 0 2 8 1 2 14 4 2 2 0 0 0 4 16 1 8 16 1 0 17 15 1)
)
