(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-computer
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideComputer (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 7 2 1 17 2 4 2 2 0 0 1 19 4 1 19 8 4 2 2 0 0 1 17 10 1 7 10 4 2 2 0 0 1 5 8 1 5 4 4 2 2 0 0 1 7 2 5 0 0 10 48 0 4 14 1 20 14 4 2 2 0 0 1 22 16 1 22 20 4 2 2 0 0 1 20 22 1 4 22 4 2 2 0 0 1 2 20 1 2 16 4 2 2 0 0 1 4 14 5 0 0 2 6 0 6 18 1 8 18 0 0 2 6 0 12 18 1 18 18)
)
