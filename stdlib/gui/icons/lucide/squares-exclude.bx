(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-squares-exclude
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquaresExclude (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 61 0 16 12 1 16 14 4 2 2 0 0 1 14 16 1 9 16 4 1 1 0 0 0 8 17 1 8 20 4 2 2 0 0 0 10 22 1 20 22 4 2 2 0 0 0 22 20 1 22 10 4 2 2 0 0 0 20 8 1 20 8 0 0 11 58 0 4 16 4 2 2 0 0 1 2 14 1 2 4 4 2 2 0 0 1 4 2 1 14 2 4 2 2 0 0 1 16 4 1 16 7 4 1 1 0 0 1 15 8 1 10 8 4 2 2 0 0 0 8 10 1 8 12)
)
