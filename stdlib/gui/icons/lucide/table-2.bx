(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-table-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTableN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 20 80 0 9 3 1 5 3 4 2 2 0 0 0 3 5 1 3 9 0 9 3 1 19 3 4 2 2 0 0 1 21 5 1 21 9 0 9 3 1 9 21 0 9 21 1 19 21 4 2 2 0 0 0 21 19 1 21 9 0 9 21 1 5 21 4 2 2 0 0 1 3 19 1 3 9 0 3 9 1 21 9)
)
