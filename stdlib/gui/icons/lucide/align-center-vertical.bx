(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-center-vertical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignCenterVertical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 2 1 12 22 0 0 6 27 0 8 10 1 4 10 4 2 2 0 0 1 2 8 1 2 6 2 2 4.9 2.9 4 4 4 1 8 4 0 0 6 28 0 16 10 1 20 10 4 2 2 0 0 0 22 8 1 22 6 4 2 2 0 0 0 20 4 1 16 4 0 0 6 27 0 8 20 1 7 20 4 2 2 0 0 1 5 18 1 5 16 2 5 14.9 5.9 14 7 14 1 8 14 0 0 6 28 0 16 14 1 17 14 4 2 2 0 0 1 19 16 1 19 18 4 2 2 0 0 1 17 20 1 16 20)
)
