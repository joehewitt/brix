(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-radical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRadical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 3 12 1 6.28 12 4 1 1 0 0 1 7.228 12.684 1 9.526 20.618 4 0.5 0.5 0 0 0 10.486 20.574 1 13.82 4.771 4 1 1 0 0 1 14.792 4 1 21 4)
)
