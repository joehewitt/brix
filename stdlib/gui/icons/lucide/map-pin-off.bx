(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-map-pin-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMapPinOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 12.75 7.09 4 3 3 0 0 1 14.91 9.25 0 0 5 33 0 17.072 17.072 2 15.438 19.242 13.545 20.984 12.601 21.799 4 1 1 0 0 1 11.399 21.799 2 9.539 20.193 4 14.993 4 10 4 8 8 0 0 1 5.432 5.432 0 0 2 6 0 2 2 1 22 22 0 0 3 18 0 8.475 2.818 4 8 8 0 0 1 20 10 2 20 11.183 19.69 12.377 19.19 13.533 0 0 2 11 0 9.13 9.13 4 3 3 0 0 0 12.87 12.87)
)
