(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-piano
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePiano (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 50 0 18.5 8 2 17.1 8 15.9 7.2 15.3 6 4 6.87 6.87 0 0 0 2 9 1 2 20 4 2 2 0 0 0 4 22 1 20 22 4 2 2 0 0 0 22 20 1 22 11.5 2 22 9.6 20.4 8 18.5 8 0 0 2 6 0 2 14 1 22 14 0 0 2 6 0 6 14 1 6 18 0 0 2 6 0 10 14 1 10 18 0 0 2 6 0 14 14 1 14 18 0 0 2 6 0 18 14 1 18 18)
)
