(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sofa
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSofa (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 20 9 1 20 6 4 2 2 0 0 0 18 4 1 6 4 4 2 2 0 0 0 4 6 1 4 9 0 0 13 67 0 2 16 4 2 2 0 0 0 4 18 1 20 18 4 2 2 0 0 0 22 16 1 22 11 4 2 2 0 0 0 18 11 1 18 12.5 4 0.5 0.5 0 0 1 17.5 13 1 6.5 13 4 0.5 0.5 0 0 1 6 12.5 1 6 11 4 2 2 0 0 0 2 11 5 0 0 2 6 0 4 18 1 4 20 0 0 2 6 0 20 18 1 20 20 0 0 2 6 0 12 4 1 12 13)
)
