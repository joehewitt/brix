(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-popsicle
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePopsicle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 32 0 18.6 14.4 2 19.4 13.6 19.4 12.4 18.6 11.6 1 10.5 3.5 4 4.95 4.95 0 1 0 3.4 10.6 1 11.5 18.7 2 12.4 19.4 13.6 19.4 14.4 18.6 5 0 0 2 6 0 22 22 1 16.5 16.5)
)
