(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mountain-snow
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMountainSnow (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 19 0 8 3 1 12 11 1 17 6 1 22 21 1 2 21 1 8 3 5 0 0 3 17 0 4.14 15.08 2 6.76 13.51 9.38 13.65 12 15.5 2 14.74 17.44 17.49 17.5 20.23 15.69)
)
