(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-notebook-text
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideNotebookText (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 6 1 6 6 0 0 2 6 0 2 10 1 6 10 0 0 2 6 0 2 14 1 6 14 0 0 2 6 0 2 18 1 6 18 0 0 10 48 0 6 2 1 18 2 4 2 2 0 0 1 20 4 1 20 20 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4 20 1 4 4 4 2 2 0 0 1 6 2 5 0 0 2 6 0 9.5 8 1 14.5 8 0 0 2 6 0 9.5 12 1 16 12 0 0 2 6 0 9.5 16 1 14 16)
)
