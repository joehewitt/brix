(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bell-check
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBellCheck (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 10.268 21 4 2 2 0 0 0 13.732 21 0 0 3 9 0 15 8 1 17 10 1 21 6 0 0 3 18 0 16.8607 4.4824 4 6 6 0 0 0 6 8 2 6 12.499 4.589 13.956 3.262 15.326 0 0 5 29 0 3.262 15.326 4 1 1 0 0 0 4 17 1 20 17 4 1 1 0 0 0 20.74 15.327 2 20.209 14.779 19.665 14.218 19.203 13.454)
)
