(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-memory-stick
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMemoryStick (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 12 1 12 10 0 0 2 6 0 12 18 1 12 16 0 0 2 6 0 16 12 1 16 10 0 0 2 6 0 16 18 1 16 16 0 0 2 6 0 2 11 1 3.5 11 0 0 2 6 0 20 18 1 20 16 0 0 2 6 0 20.5 11 1 22 11 0 0 2 6 0 4 18 1 4 16 0 0 2 6 0 8 12 1 8 10 0 0 2 6 0 8 18 1 8 16 0 0 10 48 0 4 6 1 20 6 4 2 2 0 0 1 22 8 1 22 14 4 2 2 0 0 1 20 16 1 4 16 4 2 2 0 0 1 2 14 1 2 8 4 2 2 0 0 1 4 6 5)
)
