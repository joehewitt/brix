(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-brush-cleaning
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBrushCleaning (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 22 1 15 18 0 0 14 77 0 19 14 4 1 1 0 0 0 20 13 1 20 12 4 2 2 0 0 0 18 10 1 15 10 4 1 1 0 0 1 14 9 1 14 4 4 2 2 0 0 0 10 4 1 10 9 4 1 1 0 0 1 9 10 1 6 10 4 2 2 0 0 0 4 12 1 4 13 4 1 1 0 0 0 5 14 0 0 7 29 0 19 14 1 5 14 1 3.027 20.767 4 1 1 0 0 0 4 22 1 20 22 4 1 1 0 0 0 20.973 20.767 5 0 0 2 6 0 8 22 1 9 18)
)
