(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-scissors-line-dashed
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScissorsLineDashed (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 5.42 9.42 1 8 12 1 0 4 8 2 0 0 2 6 0 14 6 1 5.42 14.58 1 0 4 16 2 0 0 2 6 0 10.8 14.8 1 14 18 0 0 2 6 0 16 12 1 14 12 0 0 2 6 0 22 12 1 20 12)
)
