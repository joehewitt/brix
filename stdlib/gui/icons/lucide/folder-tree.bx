(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-folder-tree
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFolderTree (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 67 0 20 10 4 1 1 0 0 0 21 9 1 21 6 4 1 1 0 0 0 20 5 1 17.5 5 4 1 1 0 0 1 16.7 4.6 1 15.8 3.4 4 1 1 0 0 0 15 3 1 13 3 4 1 1 0 0 0 12 4 1 12 9 4 1 1 0 0 0 13 10 5 0 0 13 67 0 20 21 4 1 1 0 0 0 21 20 1 21 17 4 1 1 0 0 0 20 16 1 17.1 16 4 1 1 0 0 1 16.22 15.45 1 15.8 14.6 4 1 1 0 0 0 14.88 14 1 13 14 4 1 1 0 0 0 12 15 1 12 20 4 1 1 0 0 0 13 21 5 0 0 3 14 0 3 5 4 2 2 0 0 0 5 7 1 8 7 0 0 4 17 0 3 3 1 3 16 4 2 2 0 0 0 5 18 1 8 18)
)
