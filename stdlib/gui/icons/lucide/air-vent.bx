(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-air-vent
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAirVent (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 18 17.5 4 2.5 2.5 0 1 1 14 19.53 1 14 12 0 0 10 50 0 6 12 1 4 12 4 2 2 0 0 1 2 10 1 2 5 4 2 2 0 0 1 4 3 1 20 3 4 2 2 0 0 1 22 5 1 22 10 4 2 2 0 0 1 20 12 1 18 12 0 0 2 6 0 6 8 1 18 8 0 0 3 14 0 6.6 15.572 4 2 2 0 1 0 10 17 1 10 12)
)
