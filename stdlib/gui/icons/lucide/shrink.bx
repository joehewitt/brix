(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shrink
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShrink (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 18 0 15 15 1 21 21 0 15 15 1 15 19.8 0 15 15 1 19.8 15 0 0 6 18 0 9 19.8 1 9 15 0 9 15 1 4.2 15 0 9 15 1 3 21 0 0 6 18 0 15 4.2 1 15 9 0 15 9 1 19.8 9 0 15 9 1 21 3 0 0 6 18 0 9 4.2 1 9 9 0 9 9 1 4.2 9 0 9 9 1 3 3)
)
