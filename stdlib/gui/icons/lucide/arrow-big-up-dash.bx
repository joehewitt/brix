(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-arrow-big-up-dash
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArrowBigUpDash (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 15 78 0 14 16 4 1 1 0 0 0 15 15 1 15 13 4 1 1 0 0 1 16 12 1 19.293 12 4 0.707 0.707 0 0 0 19.793 10.793 1 12.854 3.854 4 1.207 1.207 0 0 0 11.146 3.854 1 4.206 10.794 4 0.707 0.707 0 0 0 4.706 12 1 8 12 4 1 1 0 0 1 9 13 1 9 15 4 1 1 0 0 0 10 16 5 0 0 2 6 0 9 20 1 15 20)
)
