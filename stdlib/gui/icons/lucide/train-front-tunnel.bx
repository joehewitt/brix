(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-train-front-tunnel
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTrainFrontTunnel (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 2 22 1 2 12 4 10 10 0 1 1 22 12 1 22 22 0 0 4 17 0 15 6.8 1 15 8.2 4 3 2.8 0 1 1 9 8.2 1 9 6.8 0 0 2 6 0 10 15 1 10.01 15 0 0 2 6 0 14 15 1 14.01 15 0 0 7 34 0 10 19 4 4 4 0 0 1 6 15 1 6 12 4 6 6 0 1 1 18 12 1 18 15 4 4 4 0 0 1 14 19 5 0 0 2 6 0 9 19 1 7 22 0 0 2 6 0 15 19 1 17 22)
)
