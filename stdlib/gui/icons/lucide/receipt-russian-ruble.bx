(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-receipt-russian-ruble
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideReceiptRussianRuble (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 33 187 0 4 3 4 1 1 0 0 1 5 2 4 1.3 1.3 0 0 1 5.7 2.2 1 6.633 2.8 4 1.3 1.3 0 0 0 8.033 2.8 1 8.967 2.2 4 1.3 1.3 0 0 1 10.367 2.2 1 11.3 2.8 4 1.3 1.3 0 0 0 12.7 2.8 1 13.633 2.2 4 1.3 1.3 0 0 1 15.033 2.2 1 15.967 2.8 4 1.3 1.3 0 0 0 17.367 2.8 1 18.3 2.2 4 1.3 1.3 0 0 1 19 2 4 1 1 0 0 1 20 3 1 20 21 4 1 1 0 0 1 19 22 4 1.3 1.3 0 0 1 18.3 21.8 1 17.367 21.2 4 1.3 1.3 0 0 0 15.967 21.2 1 15.033 21.8 4 1.3 1.3 0 0 1 13.633 21.8 1 12.7 21.2 4 1.3 1.3 0 0 0 11.3 21.2 1 10.367 21.8 4 1.3 1.3 0 0 1 8.967 21.8 1 8.033 21.2 4 1.3 1.3 0 0 0 6.633 21.2 1 5.7 21.8 4 1.3 1.3 0 0 1 5 22 4 1 1 0 0 1 4 21 5 0 0 5 20 0 8 11 1 13 11 4 2 2 0 0 0 13 7 1 10 7 1 10 17 0 0 2 6 0 8 15 1 13 15)
)
