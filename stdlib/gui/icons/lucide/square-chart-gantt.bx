(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-square-chart-gantt
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquareChartGantt (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 5 0 0 2 6 0 9 8 1 16 8 0 0 2 6 0 8 12 1 14 12 0 0 2 6 0 11 16 1 16 16)
)
