(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cooking-pot
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCookingPot (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 12 1 22 12 0 0 6 28 0 20 12 1 20 20 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4 20 1 4 12 0 0 2 6 0 4 8 1 20 4 0 0 6 28 0 8.86 6.78 1 8.41 4.97 4 2 2 0 0 1 9.86 2.54 1 11.8 2.06 4 2 2 0 0 1 14.23 3.52 1 14.68 5.32)
)
