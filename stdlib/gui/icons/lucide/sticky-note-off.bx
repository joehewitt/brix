(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sticky-note-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStickyNoteOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 15 3 1 15 8 4 1 1 0 0 0 16 9 1 21 9 0 0 2 6 0 2 2 1 22 22 0 0 6 33 0 3.586 3.586 4 2 2 0 0 0 3 5 1 3 19 4 2 2 0 0 0 5 21 1 19 21 4 2 2 0 0 0 20.414 20.414 0 0 6 28 0 8.656 3 1 15 3 4 2.4 2.4 0 0 1 16.706 3.706 1 20.294 7.294 4 2.4 2.4 0 0 1 21 9 1 21 15.344)
)
