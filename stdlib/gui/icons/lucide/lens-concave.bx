(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lens-concave
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLensConcave (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 55 0 7 2 4 1 1 0 0 0 6.2 3.6 4 14 14 0 0 1 6.2 20.4 4 1 1 0 0 0 7 22 1 17 22 4 1 1 0 0 0 17.8 20.4 4 14 14 0 0 1 17.8 3.6 4 1 1 0 0 0 17 2 5)
)
