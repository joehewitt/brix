(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bottle-wine
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBottleWine (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 17 89 0 10 3 4 1 1 0 0 1 11 2 1 13 2 4 1 1 0 0 1 14 3 1 14 5 4 6 6 0 0 0 15.2 8.6 1 15.8 9.4 4 6 6 0 0 1 17 13 1 17 21 4 1 1 0 0 1 16 22 1 8 22 4 1 1 0 0 1 7 21 1 7 13 4 6 6 0 0 1 8.2 9.4 1 8.8 8.6 4 6 6 0 0 0 10 5 5 0 0 6 28 0 17 13 1 13 13 4 1 1 0 0 0 12 14 1 12 17 4 1 1 0 0 0 13 18 1 17 18)
)
