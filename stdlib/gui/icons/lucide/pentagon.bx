(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pentagon
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePentagon (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 10.83 2.38 4 2 2 0 0 1 13.17 2.38 1 21.17 8.12 4 2 2 0 0 1 21.9 10.37 1 18.86 19.63 4 2 2 0 0 1 16.96 21 1 7.04 21 4 2 2 0 0 1 5.14 19.63 1 2.1 10.37 4 2 2 0 0 1 2.83 8.12 5)
)
