(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-locate-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLocateOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 19 1 12 22 0 0 2 6 0 12 2 1 12 5 0 0 2 11 0 18.89 13.24 4 7 7 0 0 0 10.76 5.11 0 0 2 6 0 19 12 1 22 12 0 0 2 6 0 2 12 1 5 12 0 0 2 6 0 2 2 1 22 22 0 0 2 11 0 7.05 7.05 4 7 7 0 0 0 16.95 16.95)
)
