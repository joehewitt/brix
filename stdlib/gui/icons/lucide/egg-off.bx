(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-egg-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEggOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 2 1 22 22 0 0 4 20 0 20 14.347 1 20 14 2 20 8 16 2 12 2 2 10.922 2 9.843 2.436 8.843 3.19 0 0 3 18 0 6.206 6.21 2 4.871 8.4 4 11.2 4 14 4 8 8 0 0 0 18.568 18.568)
)
