(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-text-cursor
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTextCursor (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 17 22 1 16 22 4 4 4 0 0 1 12 18 1 12 6 4 4 4 0 0 1 16 2 1 17 2 0 0 3 14 0 7 22 1 8 22 4 4 4 0 0 0 12 18 0 0 3 14 0 7 2 1 8 2 4 4 4 0 0 1 12 6)
)
