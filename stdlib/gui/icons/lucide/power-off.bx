(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-power-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePowerOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 18.36 6.64 4 9 9 0 0 1 20.77 15 0 0 2 11 0 6.16 6.16 4 9 9 0 1 0 18.84 18.84 0 0 2 6 0 12 2 1 12 6 0 0 2 6 0 2 2 1 22 22)
)
