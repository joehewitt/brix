(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-moon
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMoon (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 33 0 20.985 12.486 4 9 9 0 1 1 11.512 3.014 2 11.917 2.992 12.129 3.474 11.914 3.817 4 6 6 0 0 0 20.182 12.085 2 20.526 11.87 21.007 12.081 20.985 12.486)
)
