(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-alarm-smoke
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlarmSmoke (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 10 0 11 21 2 11 18.5 13 18.5 13 16 0 0 2 10 0 16 21 2 16 18.5 18 18.5 18 16 0 0 6 28 0 19 8 1 18.2 11 4 1.25 1.25 0 0 1 17 12 1 7 12 4 1.25 1.25 0 0 1 5.8 11 1 5 8 0 0 9 45 0 21 3 4 1 1 0 0 1 22 4 1 22 6 4 2 2 0 0 1 20 8 1 4 8 4 2 2 0 0 1 2 6 1 2 4 4 1 1 0 0 1 3 3 5 0 0 2 10 0 6 21 2 6 18.5 8 18.5 8 16)
)
