(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cloud-download
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCloudDownload (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 12 13 1 12 21 1 8 17 0 0 2 6 0 12 21 1 16 17 0 0 4 22 0 4.393 15.269 4 7 7 0 1 1 15.71 8 1 17.5 8 4 4.5 4.5 0 0 1 19.936 16.284)
)
