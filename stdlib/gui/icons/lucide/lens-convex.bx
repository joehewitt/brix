(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lens-convex
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLensConvex (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 55 0 13.433 2 4 1 1 0 0 1 14.257 2.448 4 18 18 0 0 1 14.257 21.552 4 1 1 0 0 1 13.433 22 1 10.567 22 4 1 1 0 0 1 9.743 21.552 4 18 18 0 0 1 9.743 2.448 4 1 1 0 0 1 10.567 2 5)
)
