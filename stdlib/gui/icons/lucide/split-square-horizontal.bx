(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-split-square-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSplitSquareHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 26 0 8 19 1 5 19 2 4 19 3 18 3 17 1 3 7 2 3 6 4 5 5 5 1 8 5 0 0 6 26 0 16 5 1 19 5 2 20 5 21 6 21 7 1 21 17 2 21 18 20 19 19 19 1 16 19 3 0 12 4 12 20)
)
