(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-house-heart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHouseHeart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 31 0 8.62 13.8 4 2.25 2.25 0 1 1 12 10.836 4 2.25 2.25 0 1 1 15.38 13.802 1 12.754 16.658 4 0.998 0.998 0 0 1 11.247 16.658 5 0 0 11 56 0 3 10 4 2 2 0 0 1 3.709 8.472 1 10.709 2.472 4 2 2 0 0 1 13.291 2.472 1 20.291 8.472 4 2 2 0 0 1 21 10 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 5)
)
