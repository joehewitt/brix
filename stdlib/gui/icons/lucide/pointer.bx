(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pointer
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePointer (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 22 14 4 8 8 0 0 1 14 22 0 0 4 22 0 18 11 1 18 10 4 2 2 0 0 0 16 8 4 2 2 0 0 0 14 10 0 0 5 25 0 14 10 1 14 9 4 2 2 0 0 0 12 7 4 2 2 0 0 0 10 9 1 10 10 0 0 5 25 0 10 9.5 1 10 4 4 2 2 0 0 0 8 2 4 2 2 0 0 0 6 4 1 6 14 0 0 9 46 0 18 11 4 2 2 0 1 1 22 11 1 22 14 4 8 8 0 0 1 14 22 1 12 22 2 9.2 22 7.5 21.14 6.01 19.66 1 2.41 16.06 4 2 2 0 0 1 5.24 13.24 1 7 15)
)
