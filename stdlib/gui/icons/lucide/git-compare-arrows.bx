(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-git-compare-arrows
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGitCompareArrows (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 5 6 3 0 0 4 17 0 12 6 1 17 6 4 2 2 0 0 1 19 8 1 19 15 0 0 3 9 0 15 9 1 12 6 1 15 3 1 0 19 18 3 0 0 4 17 0 12 18 1 7 18 4 2 2 0 0 1 5 16 1 5 9 0 0 3 9 0 9 15 1 12 18 1 9 21)
)
