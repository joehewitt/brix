(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mail-open
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMailOpen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 58 0 21.2 8.4 2 21.7 8.78 22 9.37 22 10 1 22 20 4 2 2 0 0 1 20 22 1 4 22 4 2 2 0 0 1 2 20 1 2 10 4 2 2 0 0 1 2.8 8.4 1 10.8 2.4 4 2 2 0 0 1 13.2 2.4 1 21.2 8.4 5 0 0 4 17 0 22 10 1 13.03 15.7 4 1.94 1.94 0 0 1 10.97 15.7 1 2 10)
)
