(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chart-gantt
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChartGantt (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 6 1 18 6 0 0 2 6 0 12 16 1 18 16 0 0 4 17 0 3 3 1 3 19 4 2 2 0 0 0 5 21 1 21 21 0 0 2 6 0 8 11 1 15 11)
)
