(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-omega
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideOmega (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 55 0 3 20 1 7.5 20 4 0.5 0.5 0 0 0 8 19.5 1 8 19.218 4 0.52 0.52 0 0 0 7.753 18.781 4 8 8 0 1 1 16.247 18.78 4 0.52 0.52 0 0 0 16 19.218 1 16 19.5 4 0.5 0.5 0 0 0 16.5 20 1 21 20)
)
