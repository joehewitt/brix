(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-replace-all
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideReplaceAll (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 22 0 14 14 4 1 1 0 0 1 15 15 1 15 20 4 1 1 0 0 1 14 21 0 0 2 11 0 14 4 4 1 1 0 0 1 15 3 0 0 2 11 0 15 10 4 1 1 0 0 1 14 9 0 0 4 22 0 19 14 4 1 1 0 0 1 20 15 1 20 20 4 1 1 0 0 1 19 21 0 0 2 11 0 21 4 4 1 1 0 0 0 20 3 0 0 2 11 0 21 9 4 1 1 0 0 1 20 10 0 0 3 9 0 3 7 1 6 10 1 9 7 0 0 4 17 0 6 10 1 6 5 4 2 2 0 0 1 8 3 1 10 3 0 0 10 48 0 4 14 1 9 14 4 1 1 0 0 1 10 15 1 10 20 4 1 1 0 0 1 9 21 1 4 21 4 1 1 0 0 1 3 20 1 3 15 4 1 1 0 0 1 4 14 5)
)
