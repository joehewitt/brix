(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-circle-dot-dashed
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCircleDotDashed (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 10.1 2.18 4 9.93 9.93 0 0 1 13.9 2.18 0 0 2 11 0 17.6 3.71 4 9.95 9.95 0 0 1 20.29 6.41 0 0 2 11 0 21.82 10.1 4 9.93 9.93 0 0 1 21.82 13.9 0 0 2 11 0 20.29 17.6 4 9.95 9.95 0 0 1 17.59 20.29 0 0 2 11 0 13.9 21.82 4 9.94 9.94 0 0 1 10.1 21.82 0 0 2 11 0 6.4 20.29 4 9.95 9.95 0 0 1 3.71 17.59 0 0 2 11 0 2.18 13.9 4 9.93 9.93 0 0 1 2.18 10.1 0 0 2 11 0 3.71 6.4 4 9.95 9.95 0 0 1 6.41 3.71 1 0 12 12 1)
)
