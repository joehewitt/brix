(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-users
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUsers (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 16 21 1 16 19 4 4 4 0 0 0 12 15 1 6 15 4 4 4 0 0 0 2 19 1 2 21 0 0 2 11 0 16 3.128 4 4 4 0 0 1 16 10.872 0 0 3 14 0 22 21 1 22 19 4 4 4 0 0 0 19 15.13 1 0 9 7 4)
)
