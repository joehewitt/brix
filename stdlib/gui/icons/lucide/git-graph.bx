(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-git-graph
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGitGraph (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 5 6 3 0 0 2 6 0 5 9 1 5 15 1 0 5 18 3 0 0 2 6 0 12 3 1 12 21 1 0 19 6 3 0 0 2 11 0 16 15.7 4 9 9 0 0 0 19 9)
)
