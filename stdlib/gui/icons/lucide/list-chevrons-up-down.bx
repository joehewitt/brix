(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-list-chevrons-up-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideListChevronsUpDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 3 5 1 11 5 0 0 2 6 0 3 12 1 11 12 0 0 2 6 0 3 19 1 11 19 0 0 3 9 0 15 8 1 18 5 1 21 8 0 0 3 9 0 15 16 1 18 19 1 21 16)
)
