(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-glasses
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGlasses (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 6 15 4 1 0 18 15 4 0 0 3 19 0 14 15 4 2 2 0 0 0 12 13 4 2 2 0 0 0 10 15 0 0 3 13 0 2.5 13 1 5 7 2 5.7 5.7 6.4 5 8 5 0 0 3 13 0 21.5 13 1 19 7 2 18.3 5.7 17.5 5 16 5)
)
