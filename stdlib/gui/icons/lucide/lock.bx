(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lock
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLock (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 11 1 19 11 4 2 2 0 0 1 21 13 1 21 20 4 2 2 0 0 1 19 22 1 5 22 4 2 2 0 0 1 3 20 1 3 13 4 2 2 0 0 1 5 11 5 0 0 4 17 0 7 11 1 7 7 4 5 5 0 0 1 17 7 1 17 11)
)
