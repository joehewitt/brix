(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-broom-sparkles
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBroomSparkles (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 2 1 11 4 0 0 2 6 0 12 3 1 10 3 0 0 2 6 0 13.5 10.5 1 22 2 0 0 9 45 0 14.734 13.841 4 2 2 0 0 0 14.42 11.421 1 12.58 9.58 4 2 2 0 0 0 10.159 9.266 1 2.502 13.727 4 1 1 0 0 0 2.3 15.3 1 8.703 21.703 4 1 1 0 0 0 10.274 21.499 5 0 0 2 6 0 20 15 1 20 19 0 0 2 6 0 22 17 1 18 17 0 0 2 6 0 4 4 1 4 8 0 0 2 6 0 5 18 1 7 16 0 0 2 6 0 6 6 1 2 6 0 0 2 6 0 7.699 10.7 1 13.301 16.301)
)
