(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-syringe
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSyringe (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 18 2 1 22 6 0 0 2 6 0 17 7 1 20 4 0 0 6 26 0 19 9 1 8.7 19.3 2 7.7 20.3 6.2 20.3 5.3 19.3 1 4.7 18.7 2 3.7 17.7 3.7 16.2 4.7 15.3 1 15 5 0 0 2 6 0 9 11 1 13 15 0 0 2 6 0 5 19 1 2 22 0 0 2 6 0 14 4 1 20 10)
)
