(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bug-play
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBugPlay (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 33 0 10 19.655 4 6 6 0 0 1 6 14 1 6 11 4 4 4 0 0 1 10 7 1 14 7 4 4 4 0 0 1 18 10.97 0 0 7 34 0 14 15.003 4 1 1 0 0 1 15.517 14.144 1 20.514 17.141 4 1 1 0 0 1 20.514 18.859 1 15.517 21.856 4 1 1 0 0 1 14 20.996 5 0 0 2 6 0 14.12 3.88 1 16 2 0 0 2 11 0 21 5 4 4 4 0 0 1 17.45 8.97 0 0 2 11 0 3 21 4 4 4 0 0 1 6.81 17 0 0 2 11 0 3 5 4 4 4 0 0 0 6.55 8.97 0 0 2 6 0 6 13 1 2 13 0 0 2 6 0 8 2 1 9.88 3.88 0 0 4 17 0 9 7.13 1 9 6 4 3 3 0 1 1 15 6 1 15 7.13)
)
