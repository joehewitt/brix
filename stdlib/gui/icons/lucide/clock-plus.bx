(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-clock-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideClockPlus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 12 6 1 12 12 1 15.644 13.822 0 0 2 6 0 16 19 1 22 19 0 0 2 6 0 19 16 1 19 22 0 0 2 11 0 21.92 13.267 4 10 10 0 1 0 13.267 21.92)
)
