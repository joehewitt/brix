(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-square-dashed-bottom-code
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquareDashedBottomCode (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 10 9.5 1 8 12 1 10 14.5 0 0 2 6 0 14 21 1 15 21 0 0 3 9 0 14 9.5 1 16 12 1 14 14.5 0 0 8 44 0 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 0 0 2 6 0 9 21 1 10 21)
)
