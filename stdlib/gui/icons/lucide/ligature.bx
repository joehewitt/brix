(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ligature
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLigature (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 14 12 1 16 12 1 16 20 0 0 2 6 0 14 20 1 18 20 0 0 2 6 0 6 12 1 10 12 0 0 2 6 0 6 20 1 10 20 0 0 3 14 0 8 20 1 8 8 4 4 4 0 0 1 15.464 6)
)
