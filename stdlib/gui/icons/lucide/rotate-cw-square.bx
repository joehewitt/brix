(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rotate-cw-square
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRotateCwSquare (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 12 5 1 6 5 4 2 2 0 0 0 4 7 1 4 10 0 0 3 9 0 9 8 1 12 5 1 9 2 0 0 8 39 0 4 14 1 4 18 4 2 2 0 0 0 6 20 1 18 20 4 2 2 0 0 0 20 18 1 20 7 4 2 2 0 0 0 18 5 1 16 5)
)
