(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-gallery-vertical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGalleryVertical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 3 2 1 21 2 0 0 10 48 0 5 6 1 19 6 4 2 2 0 0 1 21 8 1 21 16 4 2 2 0 0 1 19 18 1 5 18 4 2 2 0 0 1 3 16 1 3 8 4 2 2 0 0 1 5 6 5 0 0 2 6 0 3 22 1 21 22)
)
