(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-calendar-heart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCalendarHeart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 12.127 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 10.125 0 0 6 31 0 14.62 17.8 4 2.25 2.25 0 1 1 18 14.836 4 2.25 2.25 0 1 1 21.38 17.802 1 18.754 20.658 4 0.998 0.998 0 0 1 17.247 20.658 5 0 0 2 6 0 16 2 1 16 5 0 0 2 6 0 3 9 1 21 9 0 0 2 6 0 8 2 1 8 5)
)
