(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-speech
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSpeech (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 46 0 8.8 20 1 8.8 15.9 1 10.7 16.1 4 2.3 2.3 0 0 0 12.864 14 1 12.864 8.3 4 5.37 5.37 0 0 0 2 8.25 2 2 11.05 2.656 11.304 3 12.8 4 5.77 5.77 0 0 1 3.029 15.558 1 2 20 0 0 2 11 0 19.8 17.8 4 7.5 7.5 0 0 0 19.803 7.197 0 0 2 11 0 17 15 4 3.5 3.5 0 0 0 16.975 10.025)
)
