(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-footprints
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFootprints (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 46 0 4 16 1 4 13.62 2 4 11.5 2.97 10.5 3 8 2 3.03 5.28 4.49 2 7.5 2 2 9.37 2 10 3.8 10 5.5 2 10 8.61 8 11.16 8 14.18 1 8 16 4 2 2 0 1 1 4 16 5 0 0 9 46 0 20 20 1 20 17.62 2 20 15.5 21.03 14.5 21 12 2 20.97 9.28 19.51 6 16.5 6 2 14.63 6 14 7.8 14 9.5 2 14 12.61 16 15.16 16 18.18 1 16 20 4 2 2 0 1 0 20 20 5 0 0 2 6 0 16 17 1 20 17 0 0 2 6 0 4 13 1 8 13)
)
