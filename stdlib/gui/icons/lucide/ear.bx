(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ear
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEar (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 26 0 6 8.5 4 6.5 6.5 0 1 1 19 8.5 2 19 14.5 13 14.5 13 18.5 4 3.5 3.5 0 1 1 6 18.5 0 0 4 22 0 15 8.5 4 2.5 2.5 0 0 0 10 8.5 1 10 9.5 4 2 2 0 1 1 10 13.5)
)
