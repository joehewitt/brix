(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 8 6 1 8 12 0 0 2 6 0 15 6 1 15 12 0 0 2 6 0 2 12 1 21.6 12 0 0 11 54 0 18 18 1 21 18 2 21 18 21.5 16.3 21.8 15.2 2 21.9 14.8 22 14.4 22 14 2 22 13.6 21.9 13.2 21.8 12.8 1 20.4 7.8 2 20.1 6.8 19.1 6 18 6 1 4 6 4 2 2 0 0 0 2 8 1 2 18 1 5 18 1 0 7 18 2 0 0 2 6 0 9 18 1 14 18 1 0 16 18 2)
)
