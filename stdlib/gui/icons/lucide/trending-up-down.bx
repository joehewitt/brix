(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-trending-up-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTrendingUpDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 14.828 14.828 1 21 21 0 0 3 9 0 21 16 1 21 21 1 16 21 0 0 4 12 0 21 3 1 12 12 1 8 8 1 2 14 0 0 3 9 0 21 8 1 21 3 1 16 3)
)
