(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-stop-circle
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStopCircle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 10 0 0 10 48 0 10 9 1 14 9 4 1 1 0 0 1 15 10 1 15 14 4 1 1 0 0 1 14 15 1 10 15 4 1 1 0 0 1 9 14 1 9 10 4 1 1 0 0 1 10 9 5)
)
