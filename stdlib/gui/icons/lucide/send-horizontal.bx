(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-send-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSendHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 3.714 3.048 4 0.498 0.498 0 0 0 3.031 3.675 1 5.874 11.302 4 2 2 0 0 1 5.874 12.698 1 3.032 20.325 4 0.498 0.498 0 0 0 3.714 20.952 1 21.714 12.452 4 0.5 0.5 0 0 0 21.714 11.548 5 0 0 2 6 0 6 12 1 22 12)
)
