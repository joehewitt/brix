(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-map-pin-house
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMapPinHouse (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 15 22 4 1 1 0 0 1 14 21 1 14 17 4 1 1 0 0 1 14.445 16.168 1 17.445 14.168 4 1 1 0 0 1 18.555 14.168 1 21.555 16.168 4 1 1 0 0 1 22 17 1 22 21 4 1 1 0 0 1 21 22 5 0 0 4 26 0 18 10 4 8 8 0 0 0 2 10 2 2 14.993 7.539 20.193 9.399 21.799 4 1 1 0 0 0 10 21.999 0 0 2 6 0 18 22 1 18 19 1 0 10 10 3)
)
