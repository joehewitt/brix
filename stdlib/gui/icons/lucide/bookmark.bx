(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bookmark
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBookmark (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 17 3 4 2 2 0 0 1 19 5 1 19 20 4 1 1 0 0 1 17.504 20.868 1 12.992 18.29 4 2 2 0 0 0 11.008 18.29 1 6.496 20.868 4 1 1 0 0 1 5 20 1 5 5 4 2 2 0 0 1 7 3 5)
)
