(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-alarm-clock-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlarmClockOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 6.87 6.87 4 8 8 0 1 0 18.13 18.13 0 0 2 11 0 19.9 14.25 4 8 8 0 0 0 10.75 5.1 0 0 2 6 0 22 6 1 19 3 0 0 2 6 0 6.26 18.67 1 4 21 0 0 2 6 0 2 2 1 22 22 0 0 2 6 0 4 4 1 2 6)
)
