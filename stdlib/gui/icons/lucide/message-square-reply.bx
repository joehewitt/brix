(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-message-square-reply
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMessageSquareReply (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 22 17 4 2 2 0 0 1 20 19 1 6.828 19 4 2 2 0 0 0 5.414 19.586 1 3.212 21.788 4 0.71 0.71 0 0 1 2 21.286 1 2 5 4 2 2 0 0 1 4 3 1 20 3 4 2 2 0 0 1 22 5 5 0 0 3 9 0 10 8 1 7 11 1 10 14 0 0 4 17 0 17 14 1 17 13 4 2 2 0 0 0 15 11 1 7 11)
)
