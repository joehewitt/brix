(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bot-message-square
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBotMessageSquare (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 12 6 1 12 2 1 8 2 0 0 2 6 0 15 11 1 15 13 0 0 2 6 0 2 12 1 4 12 0 0 2 6 0 20 12 1 22 12 0 0 11 56 0 20 16 4 2 2 0 0 1 18 18 1 8.828 18 4 2 2 0 0 0 7.414 18.586 1 5.212 20.788 4 0.71 0.71 0 0 1 4 20.286 1 4 8 4 2 2 0 0 1 6 6 1 18 6 4 2 2 0 0 1 20 8 5 0 0 2 6 0 9 11 1 9 13)
)
