(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-stretch-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStretchHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 4 1 20 4 4 2 2 0 0 1 22 6 1 22 8 4 2 2 0 0 1 20 10 1 4 10 4 2 2 0 0 1 2 8 1 2 6 4 2 2 0 0 1 4 4 5 0 0 10 48 0 4 14 1 20 14 4 2 2 0 0 1 22 16 1 22 18 4 2 2 0 0 1 20 20 1 4 20 4 2 2 0 0 1 2 18 1 2 16 4 2 2 0 0 1 4 14 5)
)
