(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-amphora
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAmphora (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 28 0 10 2 1 10 7.632 2 10 8.056 9.728 8.427 9.347 8.614 4 6 6 0 0 0 6 14 2 6.006 18 9 21 11 22 0 0 4 17 0 10 5 1 8 5 4 2 2 0 0 0 8 9 1 8.68 9 0 0 5 28 0 14 2 1 14 7.632 2 14 8.056 14.272 8.427 14.652 8.614 4 6 6 0 0 1 18 14 2 18 18 15 21 13 22 0 0 4 17 0 14 5 1 16 5 4 2 2 0 0 1 16 9 1 15.32 9 0 0 2 6 0 18 22 1 6 22 0 0 2 6 0 9 2 1 15 2)
)
