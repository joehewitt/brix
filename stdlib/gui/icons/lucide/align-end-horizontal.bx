(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-end-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignEndHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 6 2 1 8 2 4 2 2 0 0 1 10 4 1 10 16 4 2 2 0 0 1 8 18 1 6 18 4 2 2 0 0 1 4 16 1 4 4 4 2 2 0 0 1 6 2 5 0 0 10 48 0 16 9 1 18 9 4 2 2 0 0 1 20 11 1 20 16 4 2 2 0 0 1 18 18 1 16 18 4 2 2 0 0 1 14 16 1 14 11 4 2 2 0 0 1 16 9 5 0 0 2 6 0 22 22 1 2 22)
)
