(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-scan-heart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScanHeart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 17 3 1 19 3 4 2 2 0 0 1 21 5 1 21 7 0 0 4 17 0 21 17 1 21 19 4 2 2 0 0 1 19 21 1 17 21 0 0 4 17 0 3 7 1 3 5 4 2 2 0 0 1 5 3 1 7 3 0 0 4 17 0 7 21 1 5 21 4 2 2 0 0 1 3 19 1 3 17 0 0 6 31 0 7.828 13.07 4 3 3 0 0 1 12 8.764 4 3 3 0 0 1 16.172 13.07 1 12.725 16.69 4 1 1 0 0 1 11.276 16.69 5)
)
