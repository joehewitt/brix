(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-fishing-rod
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFishingRod (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4 11 1 5 11 0 0 7 35 0 8 15 4 2 2 0 0 1 4 15 1 4 3 4 1 1 0 0 1 5 2 1 5.5 2 2 14 2 20 9 20 18 1 20 22 1 0 18 18 2)
)
