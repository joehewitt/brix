(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-helicopter
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHelicopter (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 17 1 11 21 0 0 4 17 0 14 3 1 14 11 4 2 2 0 0 0 16 13 1 21.865 13 0 0 2 6 0 17 17 1 17 21 0 0 7 39 0 18 17 4 4 4 0 0 0 22 13 4 8 6 0 0 0 14 7 4 6 5 0 0 0 8 12 1 8 15 4 2 2 0 0 0 10 17 5 0 0 2 6 0 2 10 1 2 15 0 0 2 6 0 6 3 1 22 3 0 0 2 6 0 7 21 1 21 21 0 0 2 6 0 8 13 1 2 13)
)
