(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-microwave
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMicrowave (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 4 1 20 4 4 2 2 0 0 1 22 6 1 22 17 4 2 2 0 0 1 20 19 1 4 19 4 2 2 0 0 1 2 17 1 2 6 4 2 2 0 0 1 4 4 5 0 0 10 48 0 7 8 1 13 8 4 1 1 0 0 1 14 9 1 14 14 4 1 1 0 0 1 13 15 1 7 15 4 1 1 0 0 1 6 14 1 6 9 4 1 1 0 0 1 7 8 5 0 0 2 6 0 18 8 1 18 15 0 0 2 6 0 6 19 1 6 21 0 0 2 6 0 18 19 1 18 21)
)
