(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rewind
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRewind (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 34 0 12 6 4 2 2 0 0 0 8.586 4.586 1 2.586 10.586 4 2 2 0 0 0 2.586 13.414 1 8.586 19.414 4 2 2 0 0 0 12 18 5 0 0 7 34 0 22 6 4 2 2 0 0 0 18.586 4.586 1 12.586 10.586 4 2 2 0 0 0 12.586 13.414 1 18.586 19.414 4 2 2 0 0 0 22 18 5)
)
