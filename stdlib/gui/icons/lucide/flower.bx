(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flower
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlower (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 3 0 0 5 35 0 12 16.5 4 4.5 4.5 0 1 1 7.5 12 4 4.5 4.5 0 1 1 12 7.5 4 4.5 4.5 0 1 1 16.5 12 4 4.5 4.5 0 1 1 12 16.5 0 0 2 6 0 12 7.5 1 12 9 0 0 2 6 0 7.5 12 1 9 12 0 0 2 6 0 16.5 12 1 15 12 0 0 2 6 0 12 16.5 1 12 15 0 0 2 6 0 8 8 1 9.88 9.88 0 0 2 6 0 14.12 9.88 1 16 8 0 0 2 6 0 8 16 1 9.88 14.12 0 0 2 6 0 14.12 14.12 1 16 16)
)
