(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-handbag
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHandbag (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 2.048 18.566 4 2 2 0 0 0 4 21 1 20 21 4 2 2 0 0 0 21.952 18.566 1 19.952 9.566 4 2 2 0 0 0 18 8 1 6 8 4 2 2 0 0 0 4.048 9.566 5 0 0 4 17 0 8 11 1 8 6 4 4 4 0 0 1 16 6 1 16 11)
)
