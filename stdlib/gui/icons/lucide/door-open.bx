(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-door-open
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDoorOpen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 20 1 2 20 0 0 9 40 0 11 4.562 1 11 20.719 4 1 1 0 0 0 12.242 21.689 1 19 20 1 19 5.562 4 2 2 0 0 0 17.485 3.622 1 13.485 2.622 4 2 2 0 0 0 11 4.561 5 0 0 4 17 0 11 4 1 8 4 4 2 2 0 0 0 6 6 1 6 20 0 0 2 6 0 14 12 1 14.01 12 0 0 2 6 0 22 20 1 19 20)
)
