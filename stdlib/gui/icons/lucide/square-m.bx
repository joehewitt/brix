(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-square-m
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquareM (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 8 16 1 8 8.5 4 0.5 0.5 0 0 1 8.9 8.2 1 11.6 11.799 4 0.5 0.5 0 0 0 12.4 11.799 1 15.1 8.199 4 0.5 0.5 0 0 1 16 8.499 1 16 16 0 0 10 48 0 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 5)
)
