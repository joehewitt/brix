(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shower-head
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShowerHead (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4 4 1 6.5 6.5 0 0 2 11 0 13.5 6.5 4 4.95 4.95 0 0 0 6.5 13.5 0 0 2 6 0 15 5 1 5 15 0 0 2 6 0 14 17 1 14 17.01 0 0 2 6 0 10 16 1 10 16.01 0 0 2 6 0 13 13 1 13 13.01 0 0 2 6 0 16 10 1 16 10.01 0 0 2 6 0 11 20 1 11 20.01 0 0 2 6 0 17 14 1 17 14.01 0 0 2 6 0 20 11 1 20 11.01)
)
