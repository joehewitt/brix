(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-soup
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSoup (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 23 0 12 21 4 9 9 0 0 0 21 12 1 3 12 4 9 9 0 0 0 12 21 5 0 0 2 6 0 7 21 1 17 21 0 0 2 6 0 19.5 12 1 22 6 0 0 4 24 0 16.25 3 2 16.52 3.1 17.05 3.53 17 4.36 2 16.94 5.19 16.07 5.56 16 6.38 2 15.95 7.16 16.34 7.62 16.73 8 0 0 4 24 0 11.25 3 2 11.52 3.1 12.05 3.53 11.99 4.36 2 11.94 5.19 11.06 5.56 11.01 6.38 2 10.95 7.16 11.34 7.62 11.73 8 0 0 4 24 0 6.25 3 2 6.52 3.1 7.05 3.53 7 4.36 2 6.94 5.19 6.07 5.56 6 6.38 2 5.95 7.16 6.34 7.62 6.74 8)
)
