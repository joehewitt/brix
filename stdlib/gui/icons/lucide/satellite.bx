(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-satellite
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSatellite (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 13.5 6.5 1 10.352 3.352 4 1.205 1.205 0 0 0 8.648 3.352 1 6.352 5.648 4 1.205 1.205 0 0 0 6.352 7.352 1 9.5 10.5 0 0 2 6 0 16.5 7.5 1 19 5 0 0 6 28 0 17.5 10.5 1 20.648 13.648 4 1.205 1.205 0 0 1 20.648 15.352 1 18.352 17.648 4 1.205 1.205 0 0 1 16.648 17.648 1 13.5 14.5 0 0 2 11 0 9 21 4 6 6 0 0 0 3 15 0 0 9 45 0 9.352 10.648 4 1.205 1.205 0 0 0 9.352 12.352 1 11.648 14.648 4 1.205 1.205 0 0 0 13.352 14.648 1 17.648 10.352 4 1.205 1.205 0 0 0 17.648 8.648 1 15.352 6.352 4 1.205 1.205 0 0 0 13.648 6.352 5)
)
