(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-server
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideServer (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 2 1 20 2 4 2 2 0 0 1 22 4 1 22 8 4 2 2 0 0 1 20 10 1 4 10 4 2 2 0 0 1 2 8 1 2 4 4 2 2 0 0 1 4 2 5 0 0 10 48 0 4 14 1 20 14 4 2 2 0 0 1 22 16 1 22 20 4 2 2 0 0 1 20 22 1 4 22 4 2 2 0 0 1 2 20 1 2 16 4 2 2 0 0 1 4 14 5 3 0 6 6 6.01 6 3 0 6 18 6.01 18)
)
