(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-database-zap
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDatabaseZap (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 2 0 12 5 9 3 0 0 3 14 0 3 5 1 3 19 4 9 3 0 0 0 15 21.84 0 0 2 6 0 21 5 1 21 8 0 0 4 12 0 21 12 1 18 17 1 22 17 1 19 22 0 0 2 11 0 3 12 4 9 3 0 0 0 14.59 14.87)
)
