(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zodiac-virgo
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZodiacVirgo (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 22 0 11 5.5 4 1 1 0 0 1 16 5.5 1 16 16 4 5 5 0 0 0 21 21 0 0 4 22 0 16 11.5 4 1 1 0 0 1 21 11.5 1 21 16 4 5 5 0 0 1 16 21 0 0 4 17 0 6 19 1 6 6 4 3 3 0 0 0 3 3 1 3 3 0 0 3 14 0 6 5.5 4 1 1 0 0 1 11 5.5 1 11 19)
)
