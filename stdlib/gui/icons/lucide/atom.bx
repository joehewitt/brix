(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-atom
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAtom (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 1 0 0 6 32 0 20.2 20.2 2 22.24 18.17 20.22 12.84 15.7 8.3 2 11.16 3.78 5.83 1.76 3.8 3.8 2 1.76 5.83 3.78 11.16 8.3 15.7 2 12.84 20.22 18.17 22.24 20.2 20.2 5 0 0 6 32 0 15.7 15.7 2 20.22 11.16 22.24 5.83 20.2 3.8 2 18.17 1.76 12.84 3.78 8.3 8.3 2 3.78 12.84 1.76 18.17 3.8 20.2 2 5.83 22.24 11.16 20.22 15.7 15.7 5)
)
