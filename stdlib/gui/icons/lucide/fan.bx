(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-fan
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFan (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 10.827 16.379 4 6.082 6.082 0 0 1 2.209 9.377 1 7.621 10.827 4 6.082 6.082 0 0 1 14.623 2.209 1 13.173 7.621 4 6.082 6.082 0 0 1 21.791 14.623 1 16.379 13.173 4 6.082 6.082 0 0 1 9.377 21.791 1 10.827 16.379 5 0 0 2 6 0 12 12 1 12 12.01)
)
