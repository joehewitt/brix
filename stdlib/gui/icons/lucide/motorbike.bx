(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-motorbike
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMotorbike (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 18 14 1 17 11 0 0 5 25 0 3 9 1 9 11 4 2 2 0 0 1 11 9 1 13 9 4 2 2 0 0 1 14.99 10.81 0 0 7 41 0 8 17 1 11 17 4 1 1 0 0 0 12 16 4 6 6 0 0 1 18 10 4 1 1 0 0 0 19 9 1 19 8.25 4 5 5 0 0 0 17 5 1 0 19 17 3 1 0 5 17 3)
)
