(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-vertical-justify-center
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignVerticalJustifyCenter (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 7 16 1 17 16 4 2 2 0 0 1 19 18 1 19 20 4 2 2 0 0 1 17 22 1 7 22 4 2 2 0 0 1 5 20 1 5 18 4 2 2 0 0 1 7 16 5 0 0 10 48 0 9 2 1 15 2 4 2 2 0 0 1 17 4 1 17 6 4 2 2 0 0 1 15 8 1 9 8 4 2 2 0 0 1 7 6 1 7 4 4 2 2 0 0 1 9 2 5 0 0 2 6 0 2 12 1 22 12)
)
