(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cpu
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCpu (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 20 1 12 22 0 0 2 6 0 12 2 1 12 4 0 0 2 6 0 17 20 1 17 22 0 0 2 6 0 17 2 1 17 4 0 0 2 6 0 2 12 1 4 12 0 0 2 6 0 2 17 1 4 17 0 0 2 6 0 2 7 1 4 7 0 0 2 6 0 20 12 1 22 12 0 0 2 6 0 20 17 1 22 17 0 0 2 6 0 20 7 1 22 7 0 0 2 6 0 7 20 1 7 22 0 0 2 6 0 7 2 1 7 4 0 0 10 48 0 6 4 1 18 4 4 2 2 0 0 1 20 6 1 20 18 4 2 2 0 0 1 18 20 1 6 20 4 2 2 0 0 1 4 18 1 4 6 4 2 2 0 0 1 6 4 5 0 0 10 48 0 9 8 1 15 8 4 1 1 0 0 1 16 9 1 16 15 4 1 1 0 0 1 15 16 1 9 16 4 1 1 0 0 1 8 15 1 8 9 4 1 1 0 0 1 9 8 5)
)
