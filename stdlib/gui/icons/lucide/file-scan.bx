(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-scan
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileScan (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 20 10 1 20 8 4 2.4 2.4 0 0 0 19.294 6.296 1 15.706 2.708 4 2.4 2.4 0 0 0 14 2 1 6 2 4 2 2 0 0 0 4 4 1 4 20 4 2 2 0 0 0 6 22 1 10.35 22 0 0 4 17 0 14 2 1 14 7 4 1 1 0 0 0 15 8 1 20 8 0 0 2 11 0 16 14 4 2 2 0 0 0 14 16 0 0 2 11 0 16 22 4 2 2 0 0 1 14 20 0 0 2 11 0 20 14 4 2 2 0 0 1 22 16 0 0 2 11 0 20 22 4 2 2 0 0 0 22 20)
)
