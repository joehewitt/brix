(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bed-single
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBedSingle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 3 20 1 3 12 4 2 2 0 0 1 5 10 1 19 10 4 2 2 0 0 1 21 12 1 21 20 0 0 6 28 0 5 10 1 5 6 4 2 2 0 0 1 7 4 1 17 4 4 2 2 0 0 1 19 6 1 19 10 0 0 2 6 0 3 18 1 21 18)
)
