(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-between-vertical-end
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBetweenVerticalEnd (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 3 1 9 3 4 1 1 0 0 1 10 4 1 10 15 4 1 1 0 0 1 9 16 1 4 16 4 1 1 0 0 1 3 15 1 3 4 4 1 1 0 0 1 4 3 5 0 0 3 9 0 9 22 1 12 19 1 15 22 0 0 10 48 0 15 3 1 20 3 4 1 1 0 0 1 21 4 1 21 15 4 1 1 0 0 1 20 16 1 15 16 4 1 1 0 0 1 14 15 1 14 4 4 1 1 0 0 1 15 3 5)
)
