(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-plug-zap-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePlugZapN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 29 0 6.3 20.3 4 2.4 2.4 0 0 0 9.7 20.3 1 12 18 1 6 12 1 3.7 14.3 4 2.4 2.4 0 0 0 3.7 17.7 5 0 0 2 6 0 2 22 1 5 19 0 0 2 6 0 7.5 13.5 1 10 11 0 0 2 6 0 10.5 16.5 1 13 14 0 0 4 12 0 18 3 1 14 7 1 20 7 1 16 11)
)
