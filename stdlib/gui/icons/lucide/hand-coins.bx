(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hand-coins
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHandCoins (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 27 0 11 15 1 13 15 4 2 2 0 1 0 13 11 1 10 11 2 9.4 11 8.9 11.2 8.6 11.6 1 3 17 0 0 8 37 0 7 21 1 8.6 19.6 2 8.9 19.2 9.4 19 10 19 1 14 19 2 15.1 19 16.1 18.6 16.8 17.8 1 21.4 13.4 4 2 2 0 0 0 18.65 10.49 1 14.45 14.39 0 0 2 6 0 2 16 1 8 22 1 0 16 9 2.9 1 0 6 5 3)
)
