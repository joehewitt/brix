(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bow-arrow
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBowArrow (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 17 3 1 21 3 1 21 7 0 0 4 22 0 18.575 11.082 4 13 13 0 0 1 19.623 20.109 4 1.17 1.17 0 0 1 17.709 20.706 1 14 17 0 0 4 22 0 7 10 1 3.29 6.29 4 1.17 1.17 0 0 1 3.89 4.38 4 13 13 0 0 1 12.92 5.43 0 0 13 67 0 7 14 4 1.7 1.7 0 0 0 5.793 14.5 1 3.147 17.146 4 0.5 0.5 0 0 0 3.5 18 1 5 18 4 1 1 0 0 1 6 19 1 6 20.5 4 0.5 0.5 0 0 0 6.854 20.854 1 9.5 18.207 4 1.7 1.7 0 0 0 10 17 1 10 15 4 1 1 0 0 0 9 14 5 0 0 2 6 0 9.707 14.293 1 21 3)
)
