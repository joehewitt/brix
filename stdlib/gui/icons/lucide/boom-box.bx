(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-boom-box
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBoomBox (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 4 9 1 4 5 4 2 2 0 0 1 6 3 1 18 3 4 2 2 0 0 1 20 5 1 20 9 0 0 2 6 0 8 8 1 8 9 0 0 2 6 0 12 8 1 12 9 0 0 2 6 0 16 8 1 16 9 0 0 10 48 0 4 9 1 20 9 4 2 2 0 0 1 22 11 1 22 19 4 2 2 0 0 1 20 21 1 4 21 4 2 2 0 0 1 2 19 1 2 11 4 2 2 0 0 1 4 9 5 1 0 8 15 2 1 0 16 15 2)
)
