(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shuffle
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShuffle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 18 14 1 22 18 1 18 22 0 0 3 9 0 18 2 1 22 6 1 18 10 0 0 6 28 0 2 18 1 3.973 18 4 4 4 0 0 0 7.273 16.3 1 12.727 7.7 4 4 4 0 0 1 16.027 6 1 22 6 0 0 3 14 0 2 6 1 3.972 6 4 4 4 0 0 1 7.572 8.2 0 0 4 17 0 22 18 1 15.959 18 4 4 4 0 0 1 12.659 16.2 1 12.3 15.75)
)
