(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-container
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideContainer (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 63 0 22 7.7 2 22 7.1 21.6 6.5 21.2 6.2 1 14.9 2.3 4 1.72 1.72 0 0 0 13.2 2.3 1 2.9 8.3 2 2.4 8.5 2 9.1 2 9.7 1 2 16.3 2 2 16.8 2.4 17.5 2.8 17.8 1 9.1 21.7 4 1.72 1.72 0 0 0 10.8 21.7 1 21.1 15.7 2 21.6 15.4 22 14.7 22 14.2 5 0 0 3 9 0 10 21.9 1 10 14 1 2.1 9.1 0 0 2 6 0 10 14 1 21.9 7.1 0 0 2 6 0 14 19.8 1 14 11.7 0 0 2 6 0 18 17.5 1 18 9.4)
)
