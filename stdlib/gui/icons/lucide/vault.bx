(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-vault
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVault (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 5 1 1 7.5 7.5 0.5 0 0 2 6 0 7.9 7.9 1 10.6 10.6 1 1 16.5 7.5 0.5 0 0 2 6 0 13.4 10.6 1 16.1 7.9 1 1 7.5 16.5 0.5 0 0 2 6 0 7.9 16.1 1 10.6 13.4 1 1 16.5 16.5 0.5 0 0 2 6 0 13.4 13.4 1 16.1 16.1 1 0 12 12 2)
)
