(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-scroll
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScroll (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 19 17 1 19 5 4 2 2 0 0 0 17 3 1 4 3 0 0 14 72 0 8 21 1 20 21 4 2 2 0 0 0 22 19 1 22 18 4 1 1 0 0 0 21 17 1 11 17 4 1 1 0 0 0 10 18 1 10 19 4 2 2 0 1 1 6 19 1 6 5 4 2 2 0 1 0 2 5 1 2 7 4 1 1 0 0 0 3 8 1 6 8)
)
