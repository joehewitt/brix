(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-gem
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGem (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 15 0 10.5 3 1 8 9 1 12 22 1 16 9 1 13.5 3 0 0 11 56 0 17 3 4 2 2 0 0 1 18.6 3.8 1 21.6 7.8 4 2 2 0 0 1 21.613 10.182 1 13.623 21.168 4 2 2 0 0 1 10.376 21.168 1 2.386 10.182 4 2 2 0 0 1 2.4 7.8 1 5.398 3.803 4 2 2 0 0 1 7 3 5 0 0 2 6 0 2 9 1 22 9)
)
