(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-text-wrap
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTextWrap (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 16 16 1 13 19 1 16 22 0 0 4 17 0 3 12 1 17.5 12 4 1 1 0 0 1 17.5 19 1 13 19 0 0 2 6 0 3 19 1 9 19 0 0 2 6 0 3 5 1 21 5)
)
