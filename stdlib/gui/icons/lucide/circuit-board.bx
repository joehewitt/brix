(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-circuit-board
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCircuitBoard (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 5 0 0 4 17 0 11 9 1 15 9 4 2 2 0 0 0 17 7 1 17 3 1 0 9 9 2 0 0 4 17 0 7 21 1 7 17 4 2 2 0 0 1 9 15 1 13 15 1 0 15 15 2)
)
