(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-road
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRoad (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 17 1 12 21 0 0 2 6 0 12 5 1 12 3 0 0 2 6 0 12 9 1 12 12 0 0 9 45 0 2.077 18.449 4 2 2 0 0 0 4 21 1 20 21 4 2 2 0 0 0 21.924 18.45 1 17.924 4.45 4 2 2 0 0 0 16 3 1 8 3 4 2 2 0 0 0 6.076 4.45 5)
)
