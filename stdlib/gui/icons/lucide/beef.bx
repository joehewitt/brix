(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-beef
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBeef (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 33 0 16.4 13.7 4 6.5 6.5 0 1 0 6.28 6.6 2 5.18 9.73 5.5 10.5 3.1 12.68 4 3 3 0 0 0 5 18 2 9 18 13.4 16.2 16.4 13.7 0 0 6 32 0 18.5 6 1 20.69 10.5 4 6.48 6.48 0 0 1 18.4 17.7 2 15.4 20.2 11 22 7 22 4 3 3 0 0 1 4.32 20.34 1 2.4 16.5 1 0 12.5 8.5 2.5)
)
