(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cloud-sync
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCloudSync (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 17 18 1 15.465 19.605 4 5 5 0 0 1 7.465 18.105 0 0 3 9 0 17 22 1 17 18 1 13 18 0 0 4 22 0 20.996 15.251 4 4.5 4.5 0 0 0 17.495 8 1 15.705 8 4 7 7 0 1 0 2.996 13.607 0 0 3 9 0 7 10 1 7 14 1 11 14 0 0 3 14 0 7 14 1 8.535 12.395 4 5 5 0 0 1 16.535 13.895)
)
