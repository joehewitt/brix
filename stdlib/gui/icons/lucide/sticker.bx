(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sticker
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSticker (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 21 9 4 2.4 2.4 0 0 0 20.294 7.294 1 16.706 3.706 4 2.4 2.4 0 0 0 15 3 1 5 3 4 2 2 0 0 0 3 5 1 3 19 4 2 2 0 0 0 5 21 1 19 21 4 2 2 0 0 0 21 19 5 0 0 4 17 0 15 3 1 15 8 4 1 1 0 0 0 16 9 1 21 9 0 0 2 6 0 8 13 1 8.01 13 0 0 2 6 0 16 13 1 16.01 13 0 0 3 17 0 10 16 2 10 16 10.8 17 12 17 2 13.3 17 14 16 14 16)
)
