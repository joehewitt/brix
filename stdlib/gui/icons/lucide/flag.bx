(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flag
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlag (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 76 0 4 22 1 4 4 4 1 1 0 0 1 4.4 3.2 4 6 6 0 0 1 8 2 2 11 2 13 4 15.333 4 3 17.333 4 18.4 3.2 4 1 1 0 0 1 20 4 1 20 14 4 1 1 0 0 1 19.6 14.8 4 6 6 0 0 1 16 16 2 13 16 11 14 8 14 4 6 6 0 0 0 4 15.528)
)
