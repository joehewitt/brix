(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rectangle-vertical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRectangleVertical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 8 2 1 16 2 4 2 2 0 0 1 18 4 1 18 20 4 2 2 0 0 1 16 22 1 8 22 4 2 2 0 0 1 6 20 1 6 4 4 2 2 0 0 1 8 2 5)
)
