(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bluetooth-searching
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBluetoothSearching (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 18 0 7 7 1 17 17 1 12 22 1 12 2 1 17 7 1 7 17 0 0 2 11 0 20.83 14.83 4 4 4 0 0 0 20.83 9.17 0 0 2 6 0 18 12 1 18.01 12)
)
