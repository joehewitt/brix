(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-car
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCar (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 15 78 0 19 17 1 21 17 2 21.6 17 22 16.6 22 16 1 22 13 2 22 12.1 21.3 11.3 20.5 11.1 2 18.7 10.6 16 10 16 10 2 16 10 14.7 8.6 13.8 7.7 2 13.3 7.3 12.7 7 12 7 1 5 7 2 4.4 7 3.9 7.4 3.6 7.9 1 2.2 10.8 4 3.7 3.7 0 0 0 2 12 1 2 16 2 2 16.6 2.4 17 3 17 1 5 17 1 0 7 17 2 0 0 2 6 0 9 17 1 15 17 1 0 17 17 2)
)
