(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-book-marked
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBookMarked (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 15 0 10 2 1 10 10 1 13 7 1 16 10 1 16 2 0 0 10 50 0 4 19.5 1 4 4.5 4 2.5 2.5 0 0 1 6.5 2 1 19 2 4 1 1 0 0 1 20 3 1 20 21 4 1 1 0 0 1 19 22 1 6.5 22 4 1 1 0 0 1 6.5 17 1 20 17)
)
