(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-plug
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePlug (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 22 1 12 17 0 0 2 6 0 15 8 1 15 2 0 0 9 45 0 17 8 4 1 1 0 0 1 18 9 1 18 13 4 4 4 0 0 1 14 17 1 10 17 4 4 4 0 0 1 6 13 1 6 9 4 1 1 0 0 1 7 8 5 0 0 2 6 0 9 8 1 9 2)
)
