(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-picture-in-picture-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePictureInPictureN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 38 0 21 9 1 21 6 4 2 2 0 0 0 19 4 1 4 4 4 2 2 0 0 0 2 6 1 2 16 2 2 17.1 2.9 18 4 18 1 8 18 0 0 10 48 0 14 13 1 20 13 4 2 2 0 0 1 22 15 1 22 18 4 2 2 0 0 1 20 20 1 14 20 4 2 2 0 0 1 12 18 1 12 15 4 2 2 0 0 1 14 13 5)
)
