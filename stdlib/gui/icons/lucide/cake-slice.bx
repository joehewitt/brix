(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cake-slice
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCakeSlice (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 13 1 3 13 0 0 2 6 0 16 17 1 3 17 0 0 11 57 0 7.2 7.9 1 3.812 10.4 4 2 2 0 0 0 3 12.01 1 3 20 4 1 1 0 0 0 4 21 1 20 21 4 1 1 0 0 0 21 20 1 21 11.346 2 21 9.346 18.56 5.32 14.56 3.32 4 1 1 0 0 0 13.478 3.377 1 10.4 5.6 1 0 9 7 2)
)
