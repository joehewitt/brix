(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sprout
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSprout (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 59 0 14 9.536 1 14 7 4 4 4 0 0 1 18 3 1 19.5 3 4 0.5 0.5 0 0 1 20 3.5 1 20 5 4 4 4 0 0 1 16 9 4 4 4 0 0 0 12 13 2 12 15 13 16 13 18 4 5 5 0 0 1 12 21 0 0 3 19 0 4 9 4 5 5 0 0 1 12 13 4 5 5 0 0 1 4 9 0 0 2 6 0 5 21 1 19 21)
)
