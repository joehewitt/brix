(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-user-cog-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUserCogN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 14.305 19.53 1 15.228 19.148 0 0 2 6 0 15.228 16.852 1 14.305 16.469 0 0 2 6 0 16.852 15.228 1 16.469 14.305 0 0 2 6 0 16.852 20.772 1 16.469 21.696 0 0 2 6 0 19.148 15.228 1 19.531 14.305 0 0 2 6 0 19.53 21.696 1 19.148 20.772 0 0 2 11 0 2 21 4 8 8 0 0 1 12.434 13.38 0 0 2 6 0 20.772 16.852 1 21.696 16.469 0 0 2 6 0 20.772 19.148 1 21.696 19.531 1 0 10 8 5 1 0 18 18 3)
)
