(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hourglass
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHourglass (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 5 22 1 19 22 0 0 2 6 0 5 2 1 19 2 0 0 7 31 0 17 22 1 17 17.828 4 2 2 0 0 0 16.414 16.414 1 12 12 1 7.586 16.414 4 2 2 0 0 0 7 17.828 1 7 22 0 0 7 31 0 7 2 1 7 6.172 4 2 2 0 0 0 7.586 7.586 1 12 12 1 16.414 7.586 4 2 2 0 0 0 17 6.172 1 17 2)
)
