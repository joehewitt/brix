(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-biceps-flexed
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBicepsFlexed (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 62 0 12.409 13.017 4 5 5 0 0 1 22 15 2 22 18.866 18 22 13 22 2 8.923 22 4.847 21.18 2.629 19.538 2 2.203 19.222 1.998 18.706 2.009 18.176 2 2.118 12.723 2.627 2 10 2 4 3 3 0 0 1 13 5 4 2 2 0 0 1 11 7 2 9.895 7 9.36 6.556 9 6 0 0 2 11 0 15 14 4 5 5 0 0 0 7.416 16 0 0 2 10 0 9.964 6.825 2 8.019 7.977 9.5 13 8 15)
)
