(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-guitar
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGuitar (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11.9 12.1 1 16.414 7.586 0 0 12 64 0 20.1 2.3 4 1 1 0 0 0 18.7 2.3 1 17.586 3.414 4 2 2 0 0 0 17 4.828 1 17 6.172 4 2 2 0 0 1 16.414 7.586 4 2 2 0 0 1 17.828 7 1 19.172 7 4 2 2 0 0 0 20.586 6.414 1 21.7 5.3 4 1 1 0 0 0 21.7 3.9 5 0 0 2 6 0 6 16 1 8 18 0 0 11 71 0 8.23 9.85 4 3 3 0 0 1 11 8 4 5 5 0 0 1 16 13 4 3 3 0 0 1 14.15 15.77 1 13.23 16.15 4 2 2 0 0 0 12 18 4 4 4 0 0 1 8 22 4 6 6 0 0 1 2 16 4 4 4 0 0 1 6 12 4 2 2 0 0 0 7.85 10.77 5)
)
