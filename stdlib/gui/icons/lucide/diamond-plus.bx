(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-diamond-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDiamondPlus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 8 1 12 16 0 0 9 45 0 2.7 10.3 4 2.41 2.41 0 0 0 2.7 13.71 1 10.29 21.3 4 2.41 2.41 0 0 0 13.7 21.3 1 21.29 13.71 4 2.41 2.41 0 0 0 21.29 10.3 1 13.7 2.71 4 2.41 2.41 0 0 0 10.29 2.71 5 0 0 2 6 0 8 12 1 16 12)
)
