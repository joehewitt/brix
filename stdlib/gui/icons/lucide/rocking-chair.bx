(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-rocking-chair
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRockingChair (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 13 1 18.708 20.416 0 0 2 11 0 3 19 4 15 15 0 0 0 21 19 0 0 4 17 0 3 2 1 6.21 11.633 4 2 2 0 0 0 8.109 13 1 18 13 0 0 2 6 0 9 13 1 5.292 20.416)
)
