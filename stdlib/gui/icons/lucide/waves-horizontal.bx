(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-waves-horizontal
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWavesHorizontal (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 23 0 2 12 3 4.5 14 7 12 3 9.5 10 12 12 3 14.5 14 17 12 3 19.5 10 22 12 0 0 5 23 0 2 19 3 4.5 21 7 19 3 9.5 17 12 19 3 14.5 21 17 19 3 19.5 17 22 19 0 0 5 23 0 2 5 3 4.5 7 7 5 3 9.5 3 12 5 3 14.5 7 17 5 3 19.5 3 22 5)
)
