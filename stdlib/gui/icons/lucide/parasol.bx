(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-parasol
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideParasol (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12.5 11.134 1 18.196 21 0 0 5 28 0 20.425 5.299 4 10 10 0 0 0 3.484 15.079 2 3.667 15.642 4.327 15.853 4.839 15.557 1 20.16 6.711 2 20.672 6.415 20.82 5.738 20.424 5.298 0 0 2 6 0 21 21 1 3 21)
)
