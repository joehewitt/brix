(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-expand
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideExpand (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 15 1 21 21 0 0 2 6 0 15 9 1 21 3 0 0 3 9 0 21 16 1 21 21 1 16 21 0 0 3 9 0 21 8 1 21 3 1 16 3 0 0 3 9 0 3 16 1 3 21 1 8 21 0 0 2 6 0 3 21 1 9 15 0 0 3 9 0 3 8 1 3 3 1 8 3 0 0 2 6 0 9 9 1 3 3)
)
