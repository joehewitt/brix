(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-split
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSplit (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 16 3 1 21 3 1 21 8 0 0 3 9 0 8 3 1 3 3 1 3 8 0 0 4 17 0 12 22 1 12 13.7 4 4 4 0 0 0 10.828 10.828 1 3 3 0 0 2 6 0 15 9 1 21 3)
)
