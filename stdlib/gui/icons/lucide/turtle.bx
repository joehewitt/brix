(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-turtle
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTurtle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 16 71 0 12 10 1 14 14 1 14 17 4 1 1 0 0 0 15 18 1 17 18 4 1 1 0 0 0 18 17 1 18 14 4 8 8 0 1 0 2 14 1 2 17 4 1 1 0 0 0 3 18 1 5 18 4 1 1 0 0 0 6 17 1 6 14 1 8 10 1 12 10 5 0 0 2 6 0 4.82 7.9 1 8 10 0 0 2 6 0 15.18 7.9 1 12 10 0 0 4 17 0 16.93 10 1 20 10 4 2 2 0 0 1 20 14 1 2 14)
)
