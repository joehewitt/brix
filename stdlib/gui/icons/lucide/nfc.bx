(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-nfc
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideNfc (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 6 8.32 4 7.43 7.43 0 0 1 6 15.68 0 0 2 11 0 9.46 6.21 4 11.76 11.76 0 0 1 9.46 17.79 0 0 2 11 0 12.91 4.1 4 15.91 15.91 0 0 1 12.92 19.9 0 0 2 11 0 16.37 2 4 20.16 20.16 0 0 1 16.37 22)
)
