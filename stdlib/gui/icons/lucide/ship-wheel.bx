(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ship-wheel
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShipWheel (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 8 0 0 2 6 0 12 2 1 12 9.5 0 0 2 6 0 19 5 1 13.77 10.23 0 0 2 6 0 22 12 1 14.5 12 0 0 2 6 0 19 19 1 13.77 13.77 0 0 2 6 0 12 14.5 1 12 22 0 0 2 6 0 10.23 13.77 1 5 19 0 0 2 6 0 9.5 12 1 2 12 0 0 2 6 0 10.23 10.23 1 5 5 1 0 12 12 2.5)
)
