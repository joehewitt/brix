(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-car-battery
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCarBattery (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 14 13 1 18 13 0 0 2 6 0 16 15 1 16 11 0 0 2 6 0 18 5 1 18 7 0 0 2 6 0 6 13 1 10 13 0 0 2 6 0 6 5 1 6 7 0 0 10 48 0 4 7 1 20 7 4 2 2 0 0 1 22 9 1 22 17 4 2 2 0 0 1 20 19 1 4 19 4 2 2 0 0 1 2 17 1 2 9 4 2 2 0 0 1 4 7 5)
)
