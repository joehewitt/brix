(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-arrows-up-from-line
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArrowsUpFromLine (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 4 6 1 7 3 1 10 6 0 0 2 6 0 7 17 1 7 3 0 0 3 9 0 14 6 1 17 3 1 20 6 0 0 2 6 0 17 17 1 17 3 0 0 2 6 0 4 21 1 20 21)
)
