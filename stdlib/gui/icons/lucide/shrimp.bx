(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shrimp
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShrimp (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 12 1 11.01 12 0 0 3 17 0 13 22 2 13.5 21.5 14.12 21 15.5 21 2 14.12 21 13.5 20.5 13 20 0 0 10 55 0 14 2 4 3.28 3.28 0 0 1 10.773 3.798 1 4.603 3.237 4 2.387 2.387 0 1 0 4.387 8 1 15.5 8 4 1 1 0 0 1 15.5 21 4 1 1 0 0 0 15.5 16 1 12 16 4 7 7 0 0 1 5 9 1 5 8 0 0 2 11 0 14 8 4 8.5 8.5 0 0 1 14 16 0 0 2 10 0 16 16 2 18 16 20.5 12 20 10)
)
