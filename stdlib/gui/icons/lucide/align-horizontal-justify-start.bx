(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-align-horizontal-justify-start
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideAlignHorizontalJustifyStart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 8 5 1 10 5 4 2 2 0 0 1 12 7 1 12 17 4 2 2 0 0 1 10 19 1 8 19 4 2 2 0 0 1 6 17 1 6 7 4 2 2 0 0 1 8 5 5 0 0 10 48 0 18 7 1 20 7 4 2 2 0 0 1 22 9 1 22 15 4 2 2 0 0 1 20 17 1 18 17 4 2 2 0 0 1 16 15 1 16 9 4 2 2 0 0 1 18 7 5 0 0 2 6 0 2 2 1 2 22)
)
