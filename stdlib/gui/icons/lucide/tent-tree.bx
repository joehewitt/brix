(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tent-tree
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTentTree (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 4 4 2 0 0 3 9 0 14 5 1 17 2 1 20 5 0 0 3 9 0 14 10 1 17 7 1 20 10 0 0 2 6 0 17 14 1 17 2 0 0 5 13 0 17 14 1 7 14 1 2 22 1 22 22 5 0 0 2 6 0 8 14 1 8 22 0 0 2 6 0 9 14 1 14 22)
)
