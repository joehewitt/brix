(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-squares-subtract
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquaresSubtract (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 10 22 4 2 2 0 0 1 8 20 0 0 2 6 0 16 22 1 14 22 0 0 13 67 0 16 4 4 2 2 0 0 0 14 2 1 4 2 4 2 2 0 0 0 2 4 1 2 14 4 2 2 0 0 0 4 16 1 7 16 4 1 1 0 0 0 8 15 1 8 10 4 2 2 0 0 1 10 8 1 15 8 4 1 1 0 0 0 16 7 5 0 0 2 11 0 20 8 4 2 2 0 0 1 22 10 0 0 2 6 0 22 14 1 22 16 0 0 2 11 0 22 20 4 2 2 0 0 1 20 22)
)
