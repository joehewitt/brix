(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-spool
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSpool (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 17 13.44 1 4.442 17.082 4 2 2 0 0 0 4.982 21 1 19 21 4 2 2 0 0 0 19.558 17.079 1 18.443 16.759 4 2 2 0 0 1 17 14.837 1 17 7.66 0 0 8 39 0 7 10.56 1 19.558 6.918 4 2 2 0 0 0 19.018 3 1 5 3 4 2 2 0 0 0 4.442 6.921 1 5.557 7.241 4 2 2 0 0 1 7 9.163 1 7 16.341)
)
