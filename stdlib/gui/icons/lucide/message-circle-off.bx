(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-message-circle-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMessageCircleOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 2 2 1 22 22 0 0 8 49 0 4.93 4.929 4 10 10 0 0 0 2.992 16.341 4 2 2 0 0 1 3.086 17.508 1 2.021 20.798 4 1 1 0 0 0 3.257 21.966 1 6.67 20.968 4 2 2 0 0 1 7.769 21.06 4 10 10 0 0 0 19.071 19.071 0 0 2 11 0 8.35 2.69 4 10 10 0 0 1 21.3 15.65)
)
