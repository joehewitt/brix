(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-save-pen
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSavePen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 13.33 13 1 8 13 4 1 1 0 0 0 7 14 1 7 21 0 0 9 45 0 14.363 17.634 4 2 2 0 0 0 13.857 18.488 1 13.02 21.358 4 0.5 0.5 0 0 0 13.64 21.978 1 16.51 21.141 4 2 2 0 0 0 17.364 20.635 1 21.377 16.626 4 1 1 0 1 0 18.373 13.622 5 0 0 4 17 0 7 3 1 7 7 4 1 1 0 0 0 8 8 1 15 8 0 0 10 50 0 9 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 1 15.2 3 4 2 2 0 0 1 16.6 3.6 1 20.4 7.4 4 2 2 0 0 1 21 8.8 1 21 9.1)
)
