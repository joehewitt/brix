(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-activity
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideActivity (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 22 12 1 19.52 12 4 2 2 0 0 0 17.59 13.46 1 15.24 21.82 4 0.25 0.25 0 0 1 14.76 21.82 1 9.24 2.18 4 0.25 0.25 0 0 0 8.76 2.18 1 6.41 10.54 4 2 2 0 0 1 4.49 12 1 2 12)
)
