(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-leafy-green
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLeafyGreen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 88 0 2 22 2 3.25 21.013 4.27 20.025 5.9 19.8 4 5.56 5.56 0 0 1 9.7 21.3 4 4 4 0 0 0 15.887 18.947 4 3.5 3.5 0 0 0 19.577 13.831 4 3.5 3.5 0 0 0 20.95 8 4 3.5 3.5 0 1 0 16 3.05 4 3.5 3.5 0 0 0 10.169 4.423 4 3.5 3.5 0 0 0 5.053 8.113 4 4 4 0 0 0 2.705 14.268 2 3.499 15.42 4.409 16.712 4.2 18.1 2 3.926 19.743 3.014 20.732 2 22 0 0 2 6 0 2 22 1 17 7)
)
