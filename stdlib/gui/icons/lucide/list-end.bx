(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-list-end
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideListEnd (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 5 1 3 5 0 0 2 6 0 16 12 1 3 12 0 0 2 6 0 9 19 1 3 19 0 0 3 9 0 16 16 1 13 19 1 16 22 0 0 4 17 0 21 5 1 21 17 4 2 2 0 0 1 19 19 1 13 19)
)
