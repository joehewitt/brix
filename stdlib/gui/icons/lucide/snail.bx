(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-snail
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSnail (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 27 0 2 13 4 6 6 0 1 0 14 13 4 4 4 0 1 0 6 13 4 2 2 0 0 0 10 13 1 0 10 13 8 0 0 6 27 0 2 21 1 14 21 2 18.4 21 22 17.4 22 13 1 22 7 4 2 2 0 1 0 18 7 1 18 13 0 0 2 6 0 18 3 1 19.1 5.2 0 0 2 6 0 22 3 1 20.9 5.2)
)
