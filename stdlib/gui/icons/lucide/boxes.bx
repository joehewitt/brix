(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-boxes
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBoxes (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 46 0 2.97 12.92 4 2 2 0 0 0 2 14.63 1 2 17.87 4 2 2 0 0 0 2.97 19.58 1 5.97 21.38 4 2 2 0 0 0 8.03 21.38 1 12 19 1 12 13.5 1 7 10.5 1 2.97 12.92 5 0 0 2 6 0 7 16.5 1 2.26 13.65 0 0 2 6 0 7 16.5 1 12 13.5 0 0 2 6 0 7 16.5 1 7 21.67 0 0 11 46 0 12 13.5 1 12 19 1 15.97 21.38 4 2 2 0 0 0 18.03 21.38 1 21.03 19.58 4 2 2 0 0 0 22 17.87 1 22 14.63 4 2 2 0 0 0 21.03 12.92 1 17 10.5 1 12 13.5 5 0 0 2 6 0 17 16.5 1 12 13.5 0 0 2 6 0 17 16.5 1 21.74 13.65 0 0 2 6 0 17 16.5 1 17 21.67 0 0 11 46 0 7.97 4.42 4 2 2 0 0 0 7 6.13 1 7 10.5 1 12 13.5 1 17 10.5 1 17 6.13 4 2 2 0 0 0 16.03 4.42 1 13.03 2.62 4 2 2 0 0 0 10.97 2.62 1 7.97 4.42 5 0 0 2 6 0 12 8 1 7.26 5.15 0 0 2 6 0 12 8 1 16.74 5.15 0 0 2 6 0 12 13.5 1 12 8)
)
