(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-layout-dashboard
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLayoutDashboard (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 3 1 9 3 4 1 1 0 0 1 10 4 1 10 11 4 1 1 0 0 1 9 12 1 4 12 4 1 1 0 0 1 3 11 1 3 4 4 1 1 0 0 1 4 3 5 0 0 10 48 0 15 3 1 20 3 4 1 1 0 0 1 21 4 1 21 7 4 1 1 0 0 1 20 8 1 15 8 4 1 1 0 0 1 14 7 1 14 4 4 1 1 0 0 1 15 3 5 0 0 10 48 0 15 12 1 20 12 4 1 1 0 0 1 21 13 1 21 20 4 1 1 0 0 1 20 21 1 15 21 4 1 1 0 0 1 14 20 1 14 13 4 1 1 0 0 1 15 12 5 0 0 10 48 0 4 16 1 9 16 4 1 1 0 0 1 10 17 1 10 20 4 1 1 0 0 1 9 21 1 4 21 4 1 1 0 0 1 3 20 1 3 17 4 1 1 0 0 1 4 16 5)
)
