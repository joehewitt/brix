(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-laugh
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLaugh (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 10 1 15 9 0 0 5 30 0 7.084 14.302 4 5.12 5.12 0 0 0 16.917 14.302 4 0.24 0.24 0 0 0 16.682 14 1 7.32 14 4 0.24 0.24 0 0 0 7.085 14.302 0 0 2 6 0 9 10 1 9 9 1 0 12 12 10)
)
