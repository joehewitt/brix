(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-square-stack
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquareStack (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 30 0 4 10 2 2.9 10 2 9.1 2 8 1 2 4 2 2 2.9 2.9 2 4 2 1 8 2 2 9.1 2 10 2.9 10 4 0 0 6 30 0 10 16 2 8.9 16 8 15.1 8 14 1 8 10 2 8 8.9 8.9 8 10 8 1 14 8 2 15.1 8 16 8.9 16 10 0 0 10 48 0 16 14 1 20 14 4 2 2 0 0 1 22 16 1 22 20 4 2 2 0 0 1 20 22 1 16 22 4 2 2 0 0 1 14 20 1 14 16 4 2 2 0 0 1 16 14 5)
)
