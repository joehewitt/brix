(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-joystick
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideJoystick (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 21 17 4 2 2 0 0 0 19 15 1 5 15 4 2 2 0 0 0 3 17 1 3 19 4 2 2 0 0 0 5 21 1 19 21 4 2 2 0 0 0 21 19 1 21 17 5 0 0 2 6 0 6 15 1 6 13 0 0 2 6 0 12 15 1 12 9 1 0 12 6 3)
)
