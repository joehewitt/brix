(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mouse-pointer-ban
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMousePointerBan (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 2.034 2.681 4 0.498 0.498 0 0 1 2.681 2.034 1 11.681 5.534 4 0.5 0.5 0 0 1 11.648 6.478 1 8.204 7.545 4 1 1 0 0 0 7.544 8.205 1 6.478 11.648 4 0.5 0.5 0 0 1 5.534 11.681 5 1 0 16 16 6 0 0 2 6 0 11.8 11.8 1 20.2 20.2)
)
