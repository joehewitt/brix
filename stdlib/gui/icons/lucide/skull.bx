(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-skull
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSkull (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 13 0 12.5 17 1 12 16 1 11.5 17 1 12.5 17 5 0 0 9 50 0 15 22 4 1 1 0 0 0 16 21 1 16 20 4 2 2 0 0 0 17.56 16.75 4 8 8 0 1 0 6.44 16.75 4 2 2 0 0 0 8 20 1 8 21 4 1 1 0 0 0 9 22 5 1 0 15 12 1 1 0 9 12 1)
)
