(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-utensils
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUtensils (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 27 0 3 2 1 3 9 2 3 10.1 3.9 11 5 11 1 9 11 4 2 2 0 0 0 11 9 1 11 2 0 0 2 6 0 7 2 1 7 22 0 0 9 34 0 21 15 1 21 2 4 5 5 0 0 0 16 7 1 16 13 2 16 14.1 16.9 15 18 15 1 21 15 5 0 21 15 1 21 22)
)
