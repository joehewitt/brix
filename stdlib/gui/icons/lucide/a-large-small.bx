(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-a-large-small
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideALargeSmall (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 15 16 1 17.536 8.672 4 1.02 1.02 1 0 1 19.464 8.672 1 22 16 0 0 2 6 0 15.697 14 1 21.303 14 0 0 4 17 0 2 16 1 6.039 6.31 4 0.5 0.5 0 0 1 6.962 6.31 1 11 16 0 0 2 6 0 3.304 13 1 9.696 13)
)
