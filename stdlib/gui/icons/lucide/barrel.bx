(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-barrel
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBarrel (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 10 3 4 41 41 0 0 0 10 21 0 0 2 11 0 14 3 4 41 41 0 0 1 14 21 0 0 9 55 0 16.997 21 4 2 2 0 0 0 18.677 20.08 4 15.25 15.25 0 0 0 18.677 3.92 4 2 2 0 0 0 16.997 3 1 6.997 3 4 2 2 0 0 0 5.316 3.92 4 15.25 15.25 0 0 0 5.316 20.08 4 2 2 0 0 0 6.997 21 5 0 0 2 6 0 3.54 16 1 20.454 16 0 0 2 6 0 3.54 8 1 20.454 8)
)
