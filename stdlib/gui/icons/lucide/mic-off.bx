(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-mic-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMicOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 19 1 12 22 0 0 3 14 0 15 9.34 1 15 5 4 3 3 0 0 0 9.32 3.67 0 0 3 14 0 16.95 16.95 4 7 7 0 0 1 5 12 1 5 10 0 0 3 14 0 18.89 13.23 4 7 7 0 0 0 19 12 1 19 10 0 0 2 6 0 2 2 1 22 22 0 0 3 14 0 9 9 1 9 12 4 3 3 0 0 0 14.12 14.12)
)
