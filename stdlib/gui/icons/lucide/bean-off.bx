(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bean-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBeanOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 26 0 9 9 2 8.36 9.64 7.479 9.954 6.598 10.165 4 6 6 0 0 0 8 22 4 13.96 13.96 0 0 0 17.9 17.9 0 0 3 18 0 10.75 5.093 4 6 6 0 0 1 22 8 2 22 10.411 21.39 12.68 20.317 14.66 0 0 4 22 0 5.341 10.62 4 4 4 0 0 0 11.828 11.828 0 10.62 5.341 4 4.015 4.015 0 0 1 12.659 7.381 3 0 2 2 22 22)
)
