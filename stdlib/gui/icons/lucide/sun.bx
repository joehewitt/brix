(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sun
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSun (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 4 0 0 2 6 0 12 2 1 12 4 0 0 2 6 0 12 20 1 12 22 0 0 2 6 0 4.93 4.93 1 6.34 6.34 0 0 2 6 0 17.66 17.66 1 19.07 19.07 0 0 2 6 0 2 12 1 4 12 0 0 2 6 0 20 12 1 22 12 0 0 2 6 0 6.34 17.66 1 4.93 19.07 0 0 2 6 0 19.07 4.93 1 17.66 6.34)
)
