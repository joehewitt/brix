(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-megaphone
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMegaphone (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 61 0 11 6 4 13 13 0 0 0 19.4 3.2 4 1 1 0 0 1 21 4 1 21 16 4 1 1 0 0 1 19.4 16.8 4 13 13 0 0 0 11 14 1 5 14 4 2 2 0 0 1 3 12 1 3 8 4 2 2 0 0 1 5 6 5 0 0 4 27 0 6 14 4 12 12 0 0 0 8.4 21.2 4 2 2 0 0 0 11.6 18.8 4 8 8 0 0 1 10 14 0 0 2 6 0 8 6 1 8 14)
)
