(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-hospital
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHospital (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 7 1 12 11 0 0 4 17 0 14 21 1 14 18 4 2 2 0 0 0 10 18 1 10 21 0 0 2 6 0 14 9 1 10 9 0 0 10 50 0 18 11 1 20 11 4 2 2 0 0 1 22 13 1 22 19 4 2 2 0 0 1 20 21 1 4 21 4 2 2 0 0 1 2 19 1 2 10 4 2 2 0 0 1 4 8 1 6 8 0 0 6 28 0 18 21 1 18 5 4 2 2 0 0 0 16 3 1 8 3 4 2 2 0 0 0 6 5 1 6 21)
)
