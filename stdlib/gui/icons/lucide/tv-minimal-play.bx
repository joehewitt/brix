(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tv-minimal-play
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTvMinimalPlay (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 34 0 15.033 9.44 4 0.647 0.647 0 0 1 15.033 10.56 1 10.968 12.912 4 0.645 0.645 0 0 1 10 12.352 1 10 7.648 4 0.645 0.645 0 0 1 10.967 7.088 5 0 0 2 6 0 7 21 1 17 21 0 0 10 48 0 4 3 1 20 3 4 2 2 0 0 1 22 5 1 22 15 4 2 2 0 0 1 20 17 1 4 17 4 2 2 0 0 1 2 15 1 2 5 4 2 2 0 0 1 4 3 5)
)
