(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chess-pawn
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChessPawn (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 5 20 4 2 2 0 0 1 7 18 1 17 18 4 2 2 0 0 1 19 20 1 19 21 4 1 1 0 0 1 18 22 1 6 22 4 1 1 0 0 1 5 21 5 0 0 2 6 0 14.5 10 1 16 18 0 0 2 6 0 7 10 1 17 10 0 0 2 6 0 8 18 1 9.5 10 1 0 12 6 4)
)
