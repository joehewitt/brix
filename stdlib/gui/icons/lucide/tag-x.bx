(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tag-x
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTagX (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 16.5 6.5 1 12.586 2.586 4 2 2 0 0 0 11.172 2 1 4 2 4 2 2 0 0 0 2 4 1 2 11.172 4 2 2 0 0 0 2.586 12.586 1 11.29 21.29 4 2.43 2.43 0 0 0 14.71 21.29 1 16.5 19.5 0 0 2 6 0 16.5 10.5 1 21.5 15.5 0 0 2 6 0 21.5 10.5 1 16.5 15.5 1 1 7.5 7.5 0.5)
)
