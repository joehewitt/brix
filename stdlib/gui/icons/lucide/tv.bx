(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tv
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTv (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 17 2 1 12 7 1 7 2 0 0 10 48 0 4 7 1 20 7 4 2 2 0 0 1 22 9 1 22 20 4 2 2 0 0 1 20 22 1 4 22 4 2 2 0 0 1 2 20 1 2 9 4 2 2 0 0 1 4 7 5)
)
