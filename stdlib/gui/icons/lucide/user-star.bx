(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-user-star
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideUserStar (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 21 111 0 16.051 12.616 4 1 1 0 0 1 17.96 12.64 1 18.697 14.092 4 1 1 0 0 0 19.434 14.627 1 21.068 14.883 4 1 1 0 0 1 21.656 16.689 1 20.484 17.857 4 1 1 0 0 0 20.202 18.723 1 20.461 20.336 4 1 1 0 0 1 18.92 21.47 1 17.455 20.72 4 1 1 0 0 0 16.543 20.72 1 15.078 21.47 4 1 1 0 0 1 13.539 20.337 1 13.797 18.724 4 1 1 0 0 0 13.515 17.858 1 12.359 16.705 4 1 1 0 0 1 12.931 14.883 1 14.564 14.627 4 1 1 0 0 0 15.301 14.092 5 0 0 4 17 0 8 15 1 7 15 4 4 4 0 0 0 3 19 1 3 21 1 0 10 7 4)
)
