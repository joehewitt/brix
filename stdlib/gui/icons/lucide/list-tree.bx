(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-list-tree
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideListTree (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 8 5 1 21 5 0 0 2 6 0 13 12 1 21 12 0 0 2 6 0 13 19 1 21 19 0 0 3 14 0 3 10 4 2 2 0 0 0 5 12 1 8 12 0 0 4 17 0 3 5 1 3 17 4 2 2 0 0 0 5 19 1 8 19)
)
