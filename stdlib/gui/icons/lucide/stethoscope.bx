(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-stethoscope
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStethoscope (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 2 1 11 4 0 0 2 6 0 5 2 1 5 4 0 0 8 39 0 5 3 1 4 3 4 2 2 0 0 0 2 5 1 2 9 4 6 6 0 0 0 14 9 1 14 5 4 2 2 0 0 0 12 3 1 11 3 0 0 3 14 0 8 15 4 6 6 0 0 0 20 15 1 20 12 1 0 20 10 2)
)
