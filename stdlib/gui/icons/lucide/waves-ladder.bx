(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-waves-ladder
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWavesLadder (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 19 5 4 2 2 0 0 0 17 7 1 17 18 0 0 6 38 0 2 18 2 2.6 18.5 3.2 19 4.5 19 2 7 19 7 17 9.5 17 2 12.1 17 11.9 19 14.5 19 2 17 19 17 17 19.5 17 2 20.8 17 21.4 17.5 22 18 0 0 2 6 0 7 13 1 17 13 0 0 2 6 0 7 9 1 17 9 0 0 3 14 0 9 5 4 2 2 0 0 0 7 7 1 7 18)
)
