(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-key-round
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideKeyRound (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 17 89 0 2.586 17.414 4 2 2 0 0 0 2 18.828 1 2 21 4 1 1 0 0 0 3 22 1 6 22 4 1 1 0 0 0 7 21 1 7 20 4 1 1 0 0 1 8 19 1 9 19 4 1 1 0 0 0 10 18 1 10 17 4 1 1 0 0 1 11 16 1 11.172 16 4 2 2 0 0 0 12.586 15.414 1 13.4 14.6 4 6.5 6.5 0 1 0 9.4 10.6 5 1 1 16.5 7.5 0.5)
)
