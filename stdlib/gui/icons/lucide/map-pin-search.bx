(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-map-pin-search
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMapPinSearch (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 33 0 12.248 21.969 4 1 1 0 0 1 11.399 21.799 2 9.539 20.193 4 14.993 4 10 4 8 8 0 0 1 20 10 2 20 10.42 19.961 10.841 19.888 11.262 0 0 2 6 0 22 22 1 20.12 20.12 1 0 12 10 3 1 0 18 18 3)
)
