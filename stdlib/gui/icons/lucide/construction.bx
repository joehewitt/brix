(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-construction
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideConstruction (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 3 6 1 21 6 4 1 1 0 0 1 22 7 1 22 13 4 1 1 0 0 1 21 14 1 3 14 4 1 1 0 0 1 2 13 1 2 7 4 1 1 0 0 1 3 6 5 0 0 2 6 0 17 14 1 17 21 0 0 2 6 0 7 14 1 7 21 0 0 2 6 0 17 3 1 17 6 0 0 2 6 0 7 3 1 7 6 0 0 2 6 0 10 14 1 2.3 6.3 0 0 2 6 0 14 6 1 21.7 13.7 0 0 2 6 0 8 6 1 16 14)
)
