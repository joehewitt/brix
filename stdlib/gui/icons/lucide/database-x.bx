(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-database-x
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDatabaseX (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 17 17 1 22 22 0 0 2 11 0 19.323 13.744 4 9 3 0 0 0 21 12 0 0 2 6 0 21 13.127 1 21 5 0 0 2 6 0 22 17 1 17 22 0 0 2 11 0 3 12 4 9 3 0 0 0 13.563 14.954 0 0 3 14 0 3 5 1 3 19 4 9 3 0 0 0 13 21.981 2 0 12 5 9 3)
)
