(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-heading-3
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeadingN3 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4 12 1 12 12 0 0 2 6 0 4 18 1 4 6 0 0 2 6 0 12 18 1 12 6 0 0 3 18 0 17.5 10.5 2 19.2 9.5 21 10.5 21 12 4 2 2 0 0 1 19 14 0 0 3 18 0 17 17.5 2 19 19 21 17.8 21 16 4 2 2 0 0 0 19 14)
)
