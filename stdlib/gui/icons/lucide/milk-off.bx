(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-milk-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMilkOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 8 2 1 16 2 0 0 16 73 0 9 2 1 9 3.343 0 15 2 1 15 4.789 4 4 4 0 0 0 15.672 7.008 1 16.328 7.992 4 4 4 0 0 1 17 10.212 1 17 11.343 0 7.8 7.8 1 7.672 7.992 4 4 4 0 0 0 7 10.212 1 7 20 4 2 2 0 0 0 9 22 1 15 22 4 2 2 0 0 0 17 20 1 17 17 0 0 3 19 0 7 15 4 6.47 6.47 0 0 1 12 15 4 6.472 6.472 0 0 0 15.435 15.435 3 0 2 2 22 22)
)
