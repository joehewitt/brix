(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pocket-knife
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePocketKnife (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 41 0 3 2 1 3 3 2 3 4 5 4 5 5 2 5 6 3 6 3 7 2 3 8 5 8 5 9 2 5 10 3 10 3 11 2 3 12 5 12 5 13 0 0 2 6 0 18 6 1 18.01 6 0 0 2 6 0 6 18 1 6.01 18 0 0 5 23 0 20.83 8.83 4 4 4 0 0 0 15.17 3.17 1 3.17 15.17 4 4 4 0 1 0 8.83 20.83 5 0 0 4 17 0 18 11.66 1 18 22 4 4 4 0 0 0 22 18 1 22 6)
)
