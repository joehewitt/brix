(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-workflow
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWorkflow (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 3 1 9 3 4 2 2 0 0 1 11 5 1 11 9 4 2 2 0 0 1 9 11 1 5 11 4 2 2 0 0 1 3 9 1 3 5 4 2 2 0 0 1 5 3 5 0 0 4 17 0 7 11 1 7 15 4 2 2 0 0 0 9 17 1 13 17 0 0 10 48 0 15 13 1 19 13 4 2 2 0 0 1 21 15 1 21 19 4 2 2 0 0 1 19 21 1 15 21 4 2 2 0 0 1 13 19 1 13 15 4 2 2 0 0 1 15 13 5)
)
