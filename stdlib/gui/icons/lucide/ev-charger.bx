(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-ev-charger
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEvCharger (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 14 13 1 16 13 4 2 2 0 0 1 18 15 1 18 17 4 2 2 0 0 0 22 17 1 22 10.002 4 2 2 0 0 0 21.41 8.582 1 18 5 0 0 6 28 0 14 21 1 14 5 4 2 2 0 0 0 12 3 1 5 3 4 2 2 0 0 0 3 5 1 3 21 0 0 2 6 0 2 21 1 15 21 0 0 2 6 0 3 7 1 14 7 0 0 4 12 0 9 11 1 7 14 1 10 14 1 8 17)
)
