(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-logs
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLogs (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 3 5 1 4 5 0 0 2 6 0 3 12 1 4 12 0 0 2 6 0 3 19 1 4 19 0 0 2 6 0 8 5 1 9 5 0 0 2 6 0 8 12 1 9 12 0 0 2 6 0 8 19 1 9 19 0 0 2 6 0 13 5 1 21 5 0 0 2 6 0 13 12 1 21 12 0 0 2 6 0 13 19 1 21 19)
)
