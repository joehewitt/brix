(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-circle-star
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCircleStar (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 12 12 10 0 0 21 111 0 11.051 7.616 4 1 1 0 0 1 12.96 7.64 1 13.697 9.092 4 1 1 0 0 0 14.434 9.627 1 16.068 9.883 4 1 1 0 0 1 16.656 11.689 1 15.484 12.857 4 1 1 0 0 0 15.202 13.723 1 15.461 15.336 4 1 1 0 0 1 13.92 16.47 1 12.455 15.72 4 1 1 0 0 0 11.543 15.72 1 10.078 16.47 4 1 1 0 0 1 8.539 15.337 1 8.797 13.724 4 1 1 0 0 0 8.515 12.857 1 7.359 11.705 4 1 1 0 0 1 7.931 9.883 1 9.564 9.627 4 1 1 0 0 0 10.301 9.092 5)
)
