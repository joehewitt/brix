(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-toolbox
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideToolbox (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 12 1 16 16 0 0 6 28 0 16 6 1 16 4 4 2 2 0 0 0 14 2 1 10 2 4 2 2 0 0 0 8 4 1 8 6 0 0 13 67 0 17 6 4 2 2 0 0 1 18.414 6.586 1 21.414 9.586 4 2 2 0 0 1 22 11 1 22 19 4 2 2 0 0 1 20 21 1 4 21 4 2 2 0 0 1 2 19 1 2 11 4 2 2 0 0 1 2.586 9.586 1 5.586 6.586 4 2 2 0 0 1 7 6 5 0 0 2 6 0 2 14 1 22 14 0 0 2 6 0 8 12 1 8 16)
)
