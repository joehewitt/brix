(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-video
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileVideo (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 6 22 4 2 2 0 0 1 4 20 1 4 4 4 2 2 0 0 1 6 2 1 14 2 4 2.4 2.4 0 0 1 15.704 2.706 1 19.292 6.294 4 2.4 2.4 0 0 1 20 8 1 20 20 4 2 2 0 0 1 18 22 5 0 0 4 17 0 14 2 1 14 7 4 1 1 0 0 0 15 8 1 20 8 0 0 7 34 0 15.033 13.44 4 0.647 0.647 0 0 1 15.033 14.56 1 10.968 16.912 4 0.645 0.645 0 0 1 10 16.352 1 10 11.648 4 0.645 0.645 0 0 1 10.967 11.088 5)
)
