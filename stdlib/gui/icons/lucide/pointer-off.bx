(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pointer-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePointerOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 10 4.5 1 10 4 4 2 2 0 0 0 7.59 2.043 0 0 2 11 0 13.9 8.4 4 2 2 0 0 0 12.64 7.105 0 0 6 33 0 21.7 16.2 4 8 8 0 0 0 22 14 1 22 11 4 2 2 0 1 0 18 11 1 18 10 4 2 2 0 0 0 14.37 8.842 0 0 7 36 0 7 15 1 5.2 13.2 4 2 2 0 0 0 2.41 16.06 1 6 19.7 4 7.74 7.74 0 0 0 12 22 1 14 22 4 8 8 0 0 0 19.657 19.657 0 0 2 6 0 6 6 1 6 14 0 0 2 6 0 2 2 1 22 22)
)
