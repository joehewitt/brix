(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-archive-restore
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArchiveRestore (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 3 3 1 21 3 4 1 1 0 0 1 22 4 1 22 7 4 1 1 0 0 1 21 8 1 3 8 4 1 1 0 0 1 2 7 1 2 4 4 1 1 0 0 1 3 3 5 0 0 4 17 0 4 8 1 4 19 4 2 2 0 0 0 6 21 1 8 21 0 0 4 17 0 20 8 1 20 19 4 2 2 0 0 1 18 21 1 16 21 0 0 3 9 0 9 15 1 12 12 1 15 15 0 0 2 6 0 12 12 1 12 21)
)
