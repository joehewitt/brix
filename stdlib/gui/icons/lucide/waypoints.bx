(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-waypoints
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWaypoints (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10.586 5.414 1 5.414 10.586 0 0 2 6 0 18.586 13.414 1 13.414 18.586 0 0 2 6 0 6 12 1 18 12 1 0 12 20 2 1 0 12 4 2 1 0 20 12 2 1 0 4 12 2)
)
