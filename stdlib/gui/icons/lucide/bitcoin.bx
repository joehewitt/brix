(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bitcoin
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBitcoin (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 16 56 0 11.767 19.089 2 16.691 19.957 17.907 13.064 12.983 12.195 0 11.767 19.089 1 5.86 18.047 0 11.768 19.089 1 11.421 21.059 0 12.984 12.195 2 17.908 13.064 19.124 6.17 14.199 5.302 0 12.984 12.195 1 9.044 11.501 0 14.199 5.301 1 8.29 4.26 0 14.198 5.302 1 14.546 3.332 0 7.48 20.364 1 10.606 2.637)
)
