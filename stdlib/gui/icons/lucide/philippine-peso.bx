(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-philippine-peso
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePhilippinePeso (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 20 11 1 4 11 0 0 2 6 0 20 7 1 4 7 0 0 6 28 0 7 21 1 7 4 4 1 1 0 0 1 8 3 1 12 3 4 1 1 0 0 1 12 15 1 7 15)
)
