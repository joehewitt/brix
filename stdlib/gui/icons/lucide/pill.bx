(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pill
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePill (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 26 0 10.5 20.5 1 20.5 10.5 4 4.95 4.95 0 1 0 13.5 3.5 1 3.5 13.5 4 4.95 4.95 0 1 0 10.5 20.5 5 0 0 2 6 0 8.5 8.5 1 15.5 15.5)
)
