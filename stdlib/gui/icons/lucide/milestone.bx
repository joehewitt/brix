(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-milestone
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMilestone (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 13 1 12 21 0 0 2 6 0 12 3 1 12 6 0 0 11 56 0 18.172 6 4 2 2 0 0 1 19.586 6.586 1 21.646 8.646 4 1.207 1.207 0 0 1 21.646 10.354 1 19.586 12.414 4 2 2 0 0 1 18.172 13 1 4 13 4 1 1 0 0 1 3 12 1 3 7 4 1 1 0 0 1 4 6 5)
)
