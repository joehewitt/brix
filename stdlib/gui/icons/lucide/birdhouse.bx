(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-birdhouse
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBirdhouse (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 18 1 12 22 0 0 2 6 0 17 18 1 18.956 6.532 0 0 4 17 0 3 8 1 10.82 2.385 4 2 2 0 0 1 13.18 2.385 1 21 8 0 0 2 6 0 4 18 1 20 18 0 0 2 6 0 7 18 1 5.044 6.532 1 0 12 10 2)
)
