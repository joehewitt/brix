(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-scale
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScale (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 3 1 12 21 0 0 5 18 0 19 8 1 22 16 4 5 5 0 0 1 16 16 5 1 19 7 0 0 5 25 0 3 7 1 4 7 4 17 17 0 0 0 12 5 4 17 17 0 0 0 20 7 1 21 7 0 0 5 18 0 5 8 1 8 16 4 5 5 0 0 1 2 16 5 1 5 7 0 0 2 6 0 7 21 1 17 21)
)
