(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-fire-extinguisher
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFireExtinguisher (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 15 6.5 1 15 3 4 1 1 0 0 0 14 2 1 12 2 4 1 1 0 0 0 11 3 1 11 6.5 0 0 2 6 0 9 18 1 17 18 0 0 2 6 0 18 3 1 15 3 0 0 3 14 0 11 3 4 6 6 0 0 0 5 9 1 5 20 0 0 2 6 0 5 13 1 9 13 0 0 7 34 0 17 10 4 4 4 0 0 0 9 10 1 9 20 4 2 2 0 0 0 11 22 1 15 22 4 2 2 0 0 0 17 20 5)
)
