(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-door-closed
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDoorClosed (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 12 1 10.01 12 0 0 6 28 0 18 20 1 18 6 4 2 2 0 0 0 16 4 1 8 4 4 2 2 0 0 0 6 6 1 6 20 0 0 2 6 0 2 20 1 22 20)
)
