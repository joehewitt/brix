(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-test-tube-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTestTubeN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 25 0 21 7 1 6.82 21.18 4 2.83 2.83 0 0 1 2.83 21.17 4 2.83 2.83 0 0 1 2.83 17.17 1 17 3 0 0 2 6 0 16 2 1 22 8 0 0 2 6 0 12 16 1 4 16)
)
