(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-notebook-pen
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideNotebookPen (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 13.4 2 1 6 2 4 2 2 0 0 0 4 4 1 4 20 4 2 2 0 0 0 6 22 1 18 22 4 2 2 0 0 0 20 20 1 20 12.6 0 0 2 6 0 2 6 1 6 6 0 0 2 6 0 2 10 1 6 10 0 0 2 6 0 2 14 1 6 14 0 0 2 6 0 2 18 1 6 18 0 0 9 45 0 21.378 5.626 4 1 1 0 1 0 18.374 2.622 1 13.364 7.634 4 2 2 0 0 0 12.858 8.488 1 12.021 11.358 4 0.5 0.5 0 0 0 12.641 11.978 1 15.511 11.141 4 2 2 0 0 0 16.365 10.635 5)
)
