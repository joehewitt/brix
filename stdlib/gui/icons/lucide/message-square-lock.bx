(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-message-square-lock
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMessageSquareLock (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 22 8.5 1 22 5 4 2 2 0 0 0 20 3 1 4 3 4 2 2 0 0 0 2 5 1 2 21.286 4 0.71 0.71 0 0 0 3.212 21.788 1 5.414 19.586 4 2 2 0 0 1 6.828 19 1 10 19 0 0 4 17 0 20 15 1 20 13 4 2 2 0 0 0 16 13 1 16 15 0 0 10 48 0 15 15 1 21 15 4 1 1 0 0 1 22 16 1 22 19 4 1 1 0 0 1 21 20 1 15 20 4 1 1 0 0 1 14 19 1 14 16 4 1 1 0 0 1 15 15 5)
)
