(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-earth-lock
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEarthLock (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 14 0 7 3.34 1 7 5 4 3 3 0 0 0 10 8 0 0 7 36 0 11 21.95 1 11 18 4 2 2 0 0 0 9 16 4 2 2 0 0 1 7 14 1 7 13 4 2 2 0 0 0 5 11 1 2.05 11 0 0 4 17 0 21.54 15 1 17 15 4 2 2 0 0 0 15 17 1 15 21.54 0 0 2 11 0 12 2 4 10 10 0 1 0 21.54 15 0 0 4 17 0 20 6 1 20 4 4 2 2 0 1 0 16 4 1 16 6 0 0 10 48 0 15 6 1 21 6 4 1 1 0 0 1 22 7 1 22 10 4 1 1 0 0 1 21 11 1 15 11 4 1 1 0 0 1 14 10 1 14 7 4 1 1 0 0 1 15 6 5)
)
