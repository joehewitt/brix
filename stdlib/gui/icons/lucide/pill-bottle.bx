(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pill-bottle
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePillBottle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 18 11 1 14 11 4 1 1 0 0 0 13 12 1 13 17 4 1 1 0 0 0 14 18 1 18 18 0 0 6 28 0 6 7 1 6 20 4 2 2 0 0 0 8 22 1 16 22 4 2 2 0 0 0 18 20 1 18 7 0 0 10 48 0 5 2 1 19 2 4 1 1 0 0 1 20 3 1 20 6 4 1 1 0 0 1 19 7 1 5 7 4 1 1 0 0 1 4 6 1 4 3 4 1 1 0 0 1 5 2 5)
)
