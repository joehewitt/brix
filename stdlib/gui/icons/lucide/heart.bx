(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-heart
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 55 0 2 9.5 4 5.5 5.5 0 0 1 11.591 5.824 4 0.56 0.56 0 0 0 12.409 5.824 4 5.49 5.49 0 0 1 22 9.5 2 22 11.79 20.5 13.5 19 15 1 13.508 20.313 4 2 2 0 0 1 10.508 20.332 1 5 15 2 3.5 13.5 2 11.8 2 9.5)
)
