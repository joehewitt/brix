(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-graduation-cap
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGraduationCap (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 21.42 10.922 4 1 1 0 0 0 21.401 9.084 1 12.83 5.18 4 2 2 0 0 0 11.17 5.18 1 2.6 9.08 4 1 1 0 0 0 2.6 10.912 1 11.17 14.82 4 2 2 0 0 0 12.83 14.82 5 0 0 2 6 0 22 10 1 22 16 0 0 4 17 0 6 12.5 1 6 16 4 6 3 0 0 0 18 16 1 18 12.5)
)
