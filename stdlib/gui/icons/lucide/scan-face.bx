(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-scan-face
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScanFace (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 3 7 1 3 5 4 2 2 0 0 1 5 3 1 7 3 0 0 4 17 0 17 3 1 19 3 4 2 2 0 0 1 21 5 1 21 7 0 0 4 17 0 21 17 1 21 19 4 2 2 0 0 1 19 21 1 17 21 0 0 4 17 0 7 21 1 5 21 4 2 2 0 0 1 3 19 1 3 17 0 0 3 17 0 8 14 2 8 14 9.5 16 12 16 2 14.5 16 16 14 16 14 0 0 2 6 0 9 9 1 9.01 9 0 0 2 6 0 15 9 1 15.01 9)
)
