(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-beaker
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBeaker (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4.5 3 1 19.5 3 0 0 6 28 0 6 3 1 6 19 4 2 2 0 0 0 8 21 1 16 21 4 2 2 0 0 0 18 19 1 18 3 0 0 2 6 0 6 14 1 18 14)
)
