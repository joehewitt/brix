(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chess-rook
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChessRook (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 5 20 4 2 2 0 0 1 7 18 1 17 18 4 2 2 0 0 1 19 20 1 19 21 4 1 1 0 0 1 18 22 1 6 22 4 1 1 0 0 1 5 21 5 0 0 2 6 0 10 2 1 10 4 0 0 2 6 0 14 2 1 14 4 0 0 2 6 0 17 18 1 16 9 0 0 6 28 0 6 2 1 6 7 4 2 2 0 0 0 8 9 1 16 9 4 2 2 0 0 0 18 7 1 18 2 0 0 2 6 0 6 4 1 18 4 0 0 2 6 0 7 18 1 8 9)
)
