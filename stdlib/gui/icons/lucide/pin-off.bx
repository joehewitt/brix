(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pin-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePinOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 17 1 12 22 0 0 5 25 0 15 9.34 1 15 7 4 1 1 0 0 1 16 6 4 2 2 0 0 0 16 2 1 7.89 2 0 0 2 6 0 2 2 1 22 22 0 0 8 39 0 9 9 1 9 10.76 4 2 2 0 0 1 7.89 12.55 1 6.11 13.45 4 2 2 0 0 0 5 15.24 1 5 16 4 1 1 0 0 0 6 17 1 17 17)
)
