(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flask-conical
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlaskConical (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 14 2 1 14 8 4 2 2 0 0 0 14.245 8.96 1 19.755 19.04 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4.245 19.04 1 9.755 8.96 4 2 2 0 0 0 10 8 1 10 2 0 0 2 6 0 6.453 15 1 17.547 15 0 0 2 6 0 8.5 2 1 15.5 2)
)
