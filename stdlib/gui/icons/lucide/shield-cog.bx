(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shield-cog
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShieldCog (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10.929 14.467 1 10.546 15.391 0 0 2 6 0 10.929 8.923 1 10.546 8 0 0 2 6 0 13.225 8.923 1 13.608 8 0 0 2 6 0 13.607 15.391 1 13.225 14.467 0 0 2 6 0 14.849 10.547 1 15.772 10.164 0 0 2 6 0 14.849 12.843 1 15.772 13.226 0 0 11 67 0 20 13 2 20 18 16.5 20.5 12.34 21.95 4 1 1 0 0 1 11.67 21.94 2 7.5 20.5 4 18 4 13 1 4 6 4 1 1 0 0 1 5 5 2 7 5 9.5 3.8 11.24 2.28 4 1.17 1.17 0 0 1 12.76 2.28 2 14.51 3.81 17 5 19 5 4 1 1 0 0 1 20 6 5 0 0 2 6 0 9.305 10.547 1 8.382 10.164 0 0 2 6 0 9.305 12.843 1 8.382 13.226 1 0 12.077 11.695 3)
)
