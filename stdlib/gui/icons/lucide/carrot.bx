(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-carrot
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCarrot (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 32 0 15 16 4 1 1 0 0 0 8 9 3 4 13 2.013 21.385 4 0.5 0.5 0 0 0 2.615 21.987 3 11 20 15 16 1 12 13 0 0 5 23 0 15 9 3 19 13 22 9 3 19 5 15 9 3 19 5 15 2 3 11 5 15 9 0 0 2 6 0 8 15 1 5.42 12.42)
)
