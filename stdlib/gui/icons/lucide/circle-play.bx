(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-circle-play
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCirclePlay (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 34 0 9 9.003 4 1 1 0 0 1 10.517 8.144 1 15.514 11.141 4 1 1 0 0 1 15.514 12.859 1 10.517 15.856 4 1 1 0 0 1 9 14.996 5 1 0 12 12 10)
)
