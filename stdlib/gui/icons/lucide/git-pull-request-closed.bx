(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-git-pull-request-closed
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideGitPullRequestClosed (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 6 6 3 0 0 2 6 0 6 9 1 6 21 0 0 2 6 0 21 3 1 15 9 0 0 2 6 0 21 9 1 15 3 0 0 2 6 0 18 11.5 1 18 15 1 0 18 18 3)
)
