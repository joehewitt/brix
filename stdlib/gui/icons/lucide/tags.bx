(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tags
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTags (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 13.172 2 4 2 2 0 0 1 14.586 2.586 1 21.296 9.296 4 2.4 2.4 0 0 1 21.296 12.704 1 16.704 17.296 4 2.4 2.4 0 0 1 13.296 17.296 1 6.586 10.586 4 2 2 0 0 1 6 9.172 1 6 3 4 1 1 0 0 1 7 2 5 0 0 5 25 0 2 7 1 2 13.172 4 2 2 0 0 0 2.586 14.586 1 9.296 21.296 4 2.4 2.4 0 0 0 12.487 21.489 1 1 10.5 6.5 0.5)
)
