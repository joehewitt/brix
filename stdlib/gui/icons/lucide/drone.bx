(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-drone
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDrone (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 10 1 7 7 0 0 2 6 0 10 14 1 7 17 0 0 2 6 0 14 10 1 17 7 0 0 2 6 0 14 14 1 17 17 0 0 2 11 0 14.205 4.139 4 4 4 0 1 1 19.644 10.002 0 0 2 11 0 19.637 14 4 4 4 0 1 1 14.205 19.868 0 0 2 11 0 4.367 10 4 4 4 0 1 1 9.805 4.138 0 0 2 11 0 9.795 19.862 4 4 4 0 1 1 4.366 13.989 0 0 10 48 0 11 8 1 13 8 4 1 1 0 0 1 14 9 1 14 15 4 1 1 0 0 1 13 16 1 11 16 4 1 1 0 0 1 10 15 1 10 9 4 1 1 0 0 1 11 8 5)
)
