(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pc-case
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePcCase (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 7 2 1 17 2 4 2 2 0 0 1 19 4 1 19 20 4 2 2 0 0 1 17 22 1 7 22 4 2 2 0 0 1 5 20 1 5 4 4 2 2 0 0 1 7 2 5 0 0 2 6 0 15 14 1 15.01 14 0 0 2 6 0 9 6 1 15 6 0 0 2 6 0 9 10 1 15 10)
)
