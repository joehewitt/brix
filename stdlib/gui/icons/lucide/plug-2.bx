(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-plug-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePlugN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 9 2 1 9 8 0 0 2 6 0 15 2 1 15 8 0 0 2 6 0 12 17 1 12 22 0 0 2 6 0 5 8 1 19 8 0 0 6 21 0 6 11 1 6 8 1 18 8 1 18 11 4 6 6 0 1 1 6 11 5)
)
