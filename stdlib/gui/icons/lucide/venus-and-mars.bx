(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-venus-and-mars
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVenusAndMars (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 20 1 14 20 0 0 2 6 0 12 16 1 12 22 0 0 3 9 0 17 2 1 21 2 1 21 6 0 0 2 6 0 21 2 1 15.54 7.46 1 0 12 11 5)
)
