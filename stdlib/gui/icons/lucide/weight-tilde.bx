(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-weight-tilde
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWeightTilde (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 6.5 8 4 2 2 0 0 0 4.594 9.46 1 2.1 18.5 4 2 2 0 0 0 4 21 1 20 21 4 2 2 0 0 0 21.925 18.46 1 19.4 9.5 4 2 2 0 0 0 17.48 8 5 0 0 3 19 0 7.999 15 4 2.5 2.5 0 0 1 11.999 15 4 2.5 2.5 0 0 0 15.999 15 1 0 12 5 3)
)
