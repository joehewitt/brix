(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-heater
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeater (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 10 0 11 8 2 13 5 9 5 11 2 0 0 2 10 0 15.5 8 2 17.5 5 13.5 5 15.5 2 0 0 2 6 0 6 10 1 6.01 10 0 0 2 6 0 6 14 1 6.01 14 0 0 2 6 0 10 16 1 10 12 0 0 2 6 0 14 16 1 14 12 0 0 2 6 0 18 16 1 18 12 0 0 9 47 0 20 6 4 2 2 0 0 1 22 8 1 22 18 4 2 2 0 0 1 20 20 1 4 20 4 2 2 0 0 1 2 18 1 2 8 4 2 2 0 0 1 4 6 1 7 6 0 0 2 6 0 5 20 1 5 22 0 0 2 6 0 19 20 1 19 22)
)
