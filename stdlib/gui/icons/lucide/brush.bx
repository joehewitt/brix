(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-brush
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBrush (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 11 10 1 14 13 0 0 5 28 0 6.5 21 4 3.5 3.5 0 1 0 3 17.5 4 2.62 2.62 0 0 1 2.292 19.292 4 1 1 0 0 0 3 21 5 0 0 4 17 0 9.969 17.031 1 21.378 5.624 4 1 1 0 0 0 18.376 2.622 1 6.967 14.031)
)
