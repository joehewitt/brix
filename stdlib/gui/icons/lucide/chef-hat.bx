(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-chef-hat
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideChefHat (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 64 0 17 21 4 1 1 0 0 0 18 20 1 18 14.65 2 18 14.193 18.316 13.806 18.727 13.609 4 4 4 0 0 0 16.593 6.02 4 5 5 0 0 0 7.407 6.02 4 4 4 0 0 0 5.273 13.608 2 5.684 13.806 6 14.193 6 14.649 1 6 20 4 1 1 0 0 0 7 21 5 0 0 2 6 0 6 17 1 18 17)
)
