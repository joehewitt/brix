(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-scan-box
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScanBox (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 12 1 12 17.5 0 0 4 17 0 17 3 1 19 3 4 2 2 0 0 1 21 5 1 21 7 0 0 4 17 0 21 17 1 21 19 4 2 2 0 0 1 19 21 1 17 21 0 0 4 17 0 3 7 1 3 5 4 2 2 0 0 1 5 3 1 7 3 0 0 4 17 0 7 21 1 5 21 4 2 2 0 0 1 3 19 1 3 17 0 0 3 9 0 7.264 9.252 1 12 12 1 16.737 9.252 0 0 13 67 0 7.995 8.514 4 2 2 0 0 0 7 10.244 1 7 13.76 4 2 2 0 0 0 7.996 15.49 1 10.996 17.23 4 2 2 0 0 0 13.004 17.23 1 16.004 15.49 4 2 2 0 0 0 17 13.76 1 17 10.243 4 2 2 0 0 0 16.005 8.513 1 13.005 6.771 4 2 2 0 0 0 11.113 6.707 5)
)
