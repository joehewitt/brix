(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-heart-pulse
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeartPulse (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 55 0 2 9.5 4 5.5 5.5 0 0 1 11.591 5.824 4 0.56 0.56 0 0 0 12.409 5.824 4 5.49 5.49 0 0 1 22 9.5 2 22 11.79 20.5 13.5 19 15 1 13.508 20.313 4 2 2 0 0 1 10.508 20.332 1 5 15 2 3.5 13.5 2 11.8 2 9.5 0 0 7 21 0 3.22 13 1 9.5 13 1 10 12 1 12 16.5 1 14 9.5 1 15.5 13 1 20.77 13)
)
