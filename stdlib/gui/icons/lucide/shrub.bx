(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shrub
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShrub (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 12 22 1 12 16.828 4 2 2 0 0 0 11.414 15.414 1 9.5 13.5 0 0 2 6 0 14.5 14.5 1 12 17 0 0 6 31 0 17 8.8 4 6 6 0 0 1 13.8 20 1 10 20 4 6.5 6.5 0 0 1 7 8 4 5 5 0 0 1 17 8 5)
)
