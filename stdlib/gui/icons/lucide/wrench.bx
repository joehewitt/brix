(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wrench
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWrench (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 13 70 0 14.7 6.3 4 1 1 0 0 0 14.7 7.7 1 16.3 9.3 4 1 1 0 0 0 17.7 9.3 1 20.806 6.195 2 21.126 5.873 21.669 5.975 21.789 6.413 4 6 6 0 0 1 13.53 13.47 1 5.62 21.38 4 1 1 0 0 1 2.621 18.38 1 10.531 10.47 4 6 6 0 0 1 17.588 2.211 2 18.026 2.331 18.128 2.873 17.807 3.195 5)
)
