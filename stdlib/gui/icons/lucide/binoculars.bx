(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-binoculars
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBinoculars (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 10 1 14 10 0 0 6 28 0 19 7 1 19 4 4 1 1 0 0 0 18 3 1 16 3 4 1 1 0 0 0 15 4 1 15 7 0 0 11 55 0 20 21 4 2 2 0 0 0 22 19 1 22 15.149 2 22 13.759 20 12.187 20 10.32 1 20 8 4 1 1 0 0 0 19 7 1 15 7 4 1 1 0 0 0 14 8 1 14 19 4 2 2 0 0 0 16 21 5 0 0 2 6 0 22 16 1 2 16 0 0 11 55 0 4 21 4 2 2 0 0 1 2 19 1 2 15.149 2 2 13.759 4 12.187 4 10.32 1 4 8 4 1 1 0 0 1 5 7 1 9 7 4 1 1 0 0 1 10 8 1 10 19 4 2 2 0 0 1 8 21 5 0 0 6 28 0 9 7 1 9 4 4 1 1 0 0 0 8 3 1 6 3 4 1 1 0 0 0 5 4 1 5 7)
)
