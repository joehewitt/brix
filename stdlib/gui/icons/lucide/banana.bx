(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-banana
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBanana (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 18 0 4 13 2 7.5 11 12 11 14 15 4 5.5 5.5 0 0 1 22 20 0 0 8 46 0 5.15 17.89 2 10.67 16.37 13.8 11 12.15 5.89 2 11.55 4 11.5 2 13 2 2 16.22 2 18 7.5 18 10 2 18 16.5 13.8 22 7.51 22 2 5.11 22 2 22 2 20 2 2 18.5 3.14 18.45 5.15 17.89 5)
)
