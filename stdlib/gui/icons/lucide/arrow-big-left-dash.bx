(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-arrow-big-left-dash
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArrowBigLeftDash (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 15 78 0 13 9 4 1 1 0 0 1 12 8 1 12 4.707 4 0.707 0.707 0 0 0 10.793 4.207 1 3.853 11.147 4 1.207 1.207 0 0 0 3.853 12.854 1 10.793 19.794 4 0.707 0.707 0 0 0 12 19.294 1 12 16 4 1 1 0 0 1 13 15 1 15 15 4 1 1 0 0 0 16 14 1 16 10 4 1 1 0 0 0 15 9 5 0 0 2 6 0 20 9 1 20 15)
)
