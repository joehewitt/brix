(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-apple
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideApple (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 12 6.528 1 12 3 4 1 1 0 0 1 13 2 1 13 2 0 0 8 59 0 18.237 21 4 15 15 0 0 0 22 11 4 6 6 0 0 0 12 6.528 4 6 6 0 0 0 2 11 4 15.1 15.1 0 0 0 5.763 21 4 3 3 0 0 0 9.411 21.648 4 5.5 5.5 0 0 1 14.589 21.648 4 3 3 0 0 0 18.237 21)
)
