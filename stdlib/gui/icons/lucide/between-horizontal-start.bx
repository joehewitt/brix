(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-between-horizontal-start
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBetweenHorizontalStart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 9 3 1 20 3 4 1 1 0 0 1 21 4 1 21 9 4 1 1 0 0 1 20 10 1 9 10 4 1 1 0 0 1 8 9 1 8 4 4 1 1 0 0 1 9 3 5 0 0 3 9 0 2 9 1 5 12 1 2 15 0 0 10 48 0 9 14 1 20 14 4 1 1 0 0 1 21 15 1 21 20 4 1 1 0 0 1 20 21 1 9 21 4 1 1 0 0 1 8 20 1 8 15 4 1 1 0 0 1 9 14 5)
)
