(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-star-half
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideStarHalf (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 66 0 12 18.338 4 2.1 2.1 0 0 0 11.013 18.582 1 6.396 21.01 4 0.53 0.53 0 0 1 5.626 20.45 1 6.507 15.311 4 2.12 2.12 0 0 0 5.896 13.432 1 2.16 9.795 4 0.53 0.53 0 0 1 2.454 8.889 1 7.619 8.134 4 2.12 2.12 0 0 0 9.216 6.974 1 11.525 2.295 4 0.53 0.53 0 0 1 12 2)
)
