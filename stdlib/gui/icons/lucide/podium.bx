(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-podium
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePodium (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 12 6 1 12 2 1 11 2 0 0 12 66 0 9 15 4 1 1 0 0 0 8 14 1 4 14 4 1 1 0 0 0 3 15 1 3 20 4 1 1 0 0 0 4 21 1 20 21 4 1 1 0 0 0 21 20 1 21 17 4 1 1 0 0 0 20 16 1 16 16 4 1 1 0 0 0 15 17 0 0 6 28 0 9 21 1 9 11 4 1 1 0 0 1 10 10 1 14 10 4 1 1 0 0 1 15 11 1 15 21)
)
