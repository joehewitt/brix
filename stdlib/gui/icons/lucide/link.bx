(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-link
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLink (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 25 0 10 13 4 5 5 0 0 0 17.54 13.54 1 20.54 10.54 4 5 5 0 0 0 13.47 3.47 1 11.75 5.18 0 0 5 25 0 14 11 4 5 5 0 0 0 6.46 10.46 1 3.46 13.46 4 5 5 0 0 0 10.53 20.53 1 12.24 18.82)
)
