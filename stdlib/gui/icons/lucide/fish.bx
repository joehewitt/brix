(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-fish
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFish (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 32 0 6.5 12 2 7.44 8.54 11.44 6 15 6 2 18.56 6 21.06 8.54 22 12 2 21.06 15.47 18.56 18 15 18 2 11.44 18 7.44 15.47 6.5 12 5 0 0 2 6 0 18 12 1 18 12.5 0 0 2 11 0 16 17.93 4 9.77 9.77 0 0 1 16 6.07 0 0 5 31 0 7 10.67 2 7 8 5.58 5.97 2.73 5.5 2 1.73 7 1.73 10.5 2.96 12 2 1.72 13.5 1.72 17 2.73 18.5 2 5.58 18.03 7 16 7 13.33 0 0 5 24 0 10.46 7.26 2 10.2 5.88 9.17 4.24 8 3 1 13.8 3 4 2 2 0 0 1 15.78 4.67 1 16.01 6.07 0 0 5 25 0 16.01 17.93 1 15.78 19.33 4 2 2 0 0 1 13.8 21 1 9.5 21 4 5.96 5.96 0 0 0 10.99 17.02)
)
