(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-heart-x
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHeartX (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15.5 12.5 1 20.5 17.5 0 0 2 6 0 20.5 12.5 1 15.5 17.5 0 0 7 45 0 21.955 8.774 4 5.5 5.5 0 0 0 12.409 5.824 4 0.6 0.6 0 0 1 11.591 5.824 4 5.5 5.5 0 0 0 2 9.5 2 2 11.8 3.5 13.5 5 15 1 10.508 20.332 4 2 2 0 0 0 13.078 20.684)
)
