(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-braces
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBraces (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 46 0 8 3 1 7 3 4 2 2 0 0 0 5 5 1 5 10 4 2 2 0 0 1 3 12 4 2 2 0 0 1 5 14 1 5 19 2 5 20.1 5.9 21 7 21 1 8 21 0 0 9 46 0 16 21 1 17 21 4 2 2 0 0 0 19 19 1 19 14 2 19 12.9 19.9 12 21 12 4 2 2 0 0 1 19 10 1 19 5 4 2 2 0 0 0 17 3 1 16 3)
)
