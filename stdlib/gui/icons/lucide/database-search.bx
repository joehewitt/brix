(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-database-search
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDatabaseSearch (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 21 11.693 1 21 5 0 0 2 6 0 22 22 1 20.125 20.125 0 0 2 11 0 3 12 4 9 3 0 0 0 11.697 14.998 0 0 3 14 0 3 5 1 3 19 4 9 3 0 0 0 12.28 21.999 1 0 18 18 3 2 0 12 5 9 3)
)
