(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-book-lock
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBookLock (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 18 6 1 18 4 4 2 2 0 1 0 14 4 1 14 6 0 0 6 28 0 20 15 1 20 21 4 1 1 0 0 1 19 22 1 6.5 22 4 1 1 0 0 1 6.5 17 1 20 17 0 0 4 17 0 4 19.5 1 4 4.5 4 2.5 2.5 0 0 1 6.5 2 1 10 2 0 0 10 48 0 13 6 1 19 6 4 1 1 0 0 1 20 7 1 20 10 4 1 1 0 0 1 19 11 1 13 11 4 1 1 0 0 1 12 10 1 12 7 4 1 1 0 0 1 13 6 5)
)
