(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-list-video
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideListVideo (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 21 5 1 3 5 0 0 2 6 0 10 12 1 3 12 0 0 2 6 0 10 19 1 3 19 0 0 7 34 0 15 12.003 4 1 1 0 0 1 16.517 11.144 1 21.514 14.141 4 1 1 0 0 1 21.514 15.859 1 16.517 18.856 4 1 1 0 0 1 15 17.996 5)
)
