(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-id-card
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideIdCard (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 16 10 1 18 10 0 0 2 6 0 16 14 1 18 14 0 0 2 11 0 6.17 15 4 3 3 0 0 1 11.83 15 1 0 9 11 2 0 0 10 48 0 4 5 1 20 5 4 2 2 0 0 1 22 7 1 22 17 4 2 2 0 0 1 20 19 1 4 19 4 2 2 0 0 1 2 17 1 2 7 4 2 2 0 0 1 4 5 5)
)
