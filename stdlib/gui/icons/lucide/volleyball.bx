(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-volleyball
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVolleyball (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 11 7 4 16 16 20 0 1 21.98 11.362 0 0 2 11 0 12 12 4 13 13 0 0 1 3.34 17 0 0 2 11 0 16.83 13.634 4 16 16 0 0 1 7.563 20.962 0 0 3 19 0 20.66 17 4 13 13 0 0 0 12 12 4 13 13 0 0 1 12 2 0 0 2 11 0 8.17 15.366 4 16 16 0 0 1 6.457 3.676 1 0 12 12 10)
)
