(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-save-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSaveOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 13 13 1 8 13 4 1 1 0 0 0 7 14 1 7 21 0 0 2 6 0 14 8 1 15 8 0 0 2 6 0 17 21 1 17 17 0 0 2 6 0 2 2 1 22 22 0 0 6 33 0 20.41 20.41 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 3.59 3.59 0 0 2 10 0 29.5 11.5 2 29.5 11.5 34.5 16.5 33.5 16.5 0 0 6 28 0 9 3 1 15.2 3 4 2 2 0 0 1 16.6 3.6 1 20.4 7.4 4 2 2 0 0 1 21 8.8 1 21 15)
)
