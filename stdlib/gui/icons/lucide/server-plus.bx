(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-server-plus
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideServerPlus (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 12.5 10 1 4 10 4 2 2 0 0 1 2 8 1 2 4 4 2 2 0 0 1 4 2 1 20 2 4 2 2 0 0 1 22 4 1 22 6 0 0 2 6 0 16 12 1 22 12 0 0 2 6 0 19 9 1 19 15 0 0 8 39 0 22 18 1 22 20 4 2 2 0 0 1 20 22 1 4 22 4 2 2 0 0 1 2 20 1 2 16 4 2 2 0 0 1 4 14 1 12.5 14 0 0 2 6 0 6 18 1 6.01 18 0 0 2 6 0 6 6 1 6.01 6)
)
