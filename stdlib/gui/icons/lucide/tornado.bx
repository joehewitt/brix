(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-tornado
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTornado (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 21 4 1 3 4 0 0 2 6 0 18 8 1 6 8 0 0 2 6 0 19 12 1 9 12 0 0 2 6 0 16 16 1 10 16 0 0 2 6 0 11 20 1 9 20)
)
