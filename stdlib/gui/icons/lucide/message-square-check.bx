(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-message-square-check
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMessageSquareCheck (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 56 0 22 17 4 2 2 0 0 1 20 19 1 6.828 19 4 2 2 0 0 0 5.414 19.586 1 3.212 21.788 4 0.7 0.7 0 0 1 2 21.286 1 2 5 4 2 2 0 0 1 4 3 1 20 3 4 2 2 0 0 1 22 5 5 0 0 3 9 0 9 11 1 11 13 1 15 9)
)
