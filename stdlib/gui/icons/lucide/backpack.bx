(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-backpack
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBackpack (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 4 10 4 4 4 0 0 1 8 6 1 16 6 4 4 4 0 0 1 20 10 1 20 20 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4 20 5 0 0 2 6 0 8 10 1 16 10 0 0 2 6 0 8 18 1 16 18 0 0 6 28 0 8 22 1 8 16 4 2 2 0 0 1 10 14 1 14 14 4 2 2 0 0 1 16 16 1 16 22 0 0 6 28 0 9 6 1 9 4 4 2 2 0 0 1 11 2 1 13 2 4 2 2 0 0 1 15 4 1 15 6)
)
