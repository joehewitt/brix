(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-egg-fried
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEggFried (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 1 0 11.5 12.5 3.5 0 0 10 60 0 3 8 2 3 4.5 5.5 2 9.5 2 2 14.5 2 14.33 5 17 7 2 19.67 9 22 9 22 13 2 22 17.5 19.5 19.5 15 19.5 2 12.5 19.5 12.5 22 9 22 2 5.5 22 2 20 2 16.5 2 2 13.5 3.5 13.5 3.5 11.5 2 3.5 10 3 9 3 8 5)
)
