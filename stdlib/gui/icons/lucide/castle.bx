(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-castle
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCastle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 5 1 10 3 0 0 2 6 0 14 5 1 14 3 0 0 4 17 0 15 21 1 15 18 4 3 3 0 0 0 9 18 1 9 21 0 0 2 6 0 18 3 1 18 11 0 0 2 6 0 18 5 1 6 5 0 0 2 6 0 22 11 1 2 11 0 0 6 28 0 22 9 1 22 19 4 2 2 0 0 1 20 21 1 4 21 4 2 2 0 0 1 2 19 1 2 9 0 0 2 6 0 6 3 1 6 11)
)
