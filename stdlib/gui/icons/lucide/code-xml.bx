(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-code-xml
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCodeXml (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 18 16 1 22 12 1 18 8 0 0 3 9 0 6 8 1 2 12 1 6 16 0 0 2 6 0 14.5 4 1 9.5 20)
)
