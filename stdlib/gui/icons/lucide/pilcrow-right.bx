(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-pilcrow-right
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePilcrowRight (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10 3 1 10 14 0 0 4 17 0 10 9 1 7 9 4 1 1 0 0 1 7 3 1 15 3 0 0 2 6 0 14 3 1 14 14 0 0 3 9 0 18 14 1 22 18 1 2 18 0 0 2 6 0 22 18 1 18 22)
)
