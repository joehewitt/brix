(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-banknote-arrow-down
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBanknoteArrowDown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 12 18 1 4 18 4 2 2 0 0 1 2 16 1 2 8 4 2 2 0 0 1 4 6 1 20 6 4 2 2 0 0 1 22 8 1 22 13 0 0 3 9 0 16 19 1 19 22 1 22 19 0 0 2 6 0 18 12 1 18.01 12 0 0 2 6 0 19 16 1 19 22 0 0 2 6 0 6 12 1 6.01 12 1 0 12 12 2)
)
