(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-volume-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideVolumeOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 11 0 16 9 4 5 5 0 0 1 16.95 11.293 0 0 2 11 0 19.364 5.636 4 9 9 0 0 1 21.253 15.596 0 0 2 6 0 2 2 1 22 22 0 0 12 61 0 7 7 1 6.413 7.587 4 1.4 1.4 0 0 1 5.416 8 1 3 8 4 1 1 0 0 0 2 9 1 2 15 4 1 1 0 0 0 3 16 1 5.416 16 4 1.4 1.4 0 0 1 6.413 16.413 1 9.796 19.797 4 0.705 0.705 0 0 0 11 19.298 1 11 11 0 0 3 14 0 9.828 4.172 4 0.686 0.686 0 0 1 11 4.657 1 11 5.343)
)
