(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-arrow-down-01
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideArrowDownN01 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 3 16 1 7 20 1 11 16 0 0 2 6 0 7 20 1 7 4 0 0 10 48 0 17 4 1 17 4 4 2 2 0 0 1 19 6 1 19 8 4 2 2 0 0 1 17 10 1 17 10 4 2 2 0 0 1 15 8 1 15 6 4 2 2 0 0 1 17 4 5 0 0 3 9 0 17 20 1 17 14 1 15 14 0 0 2 6 0 15 20 1 19 20)
)
