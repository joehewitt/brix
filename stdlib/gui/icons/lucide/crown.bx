(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-crown
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCrown (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 15 78 0 11.562 3.266 4 0.5 0.5 0 0 1 12.438 3.266 1 15.39 8.87 4 1 1 0 0 0 16.906 9.164 1 21.183 5.5 4 0.5 0.5 0 0 1 21.981 6.019 1 19.147 16.265 4 1 1 0 0 1 18.191 16.999 1 5.81 16.999 4 1 1 0 0 1 4.853 16.265 1 2.02 6.02 4 0.5 0.5 0 0 1 2.818 5.501 1 7.094 9.165 4 1 1 0 0 0 8.61 8.871 5 0 0 2 6 0 5 21 1 19 21)
)
