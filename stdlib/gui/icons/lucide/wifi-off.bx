(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-wifi-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideWifiOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 20 1 12.01 20 0 0 2 11 0 8.5 16.429 4 5 5 0 0 1 15.5 16.429 0 0 2 11 0 5 12.859 4 10 10 0 0 1 10.17 10.169 0 0 2 11 0 19 12.859 4 10 10 0 0 0 16.993 11.336 0 0 2 11 0 2 8.82 4 15 15 0 0 1 6.177 6.177 0 0 2 11 0 22 8.82 4 15 15 0 0 0 10.712 5.056 0 0 2 6 0 2 2 1 22 22)
)
