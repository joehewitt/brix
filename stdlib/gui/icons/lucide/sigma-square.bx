(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-sigma-square
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSigmaSquare (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 5 0 0 7 21 0 16 8.9 1 16 7 1 8 7 1 12 12 1 8 17 1 16 17 1 16 15.1)
)
