(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-between-vertical-start
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBetweenVerticalStart (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 8 1 9 8 4 1 1 0 0 1 10 9 1 10 20 4 1 1 0 0 1 9 21 1 4 21 4 1 1 0 0 1 3 20 1 3 9 4 1 1 0 0 1 4 8 5 0 0 3 9 0 15 2 1 12 5 1 9 2 0 0 10 48 0 15 8 1 20 8 4 1 1 0 0 1 21 9 1 21 20 4 1 1 0 0 1 20 21 1 15 21 4 1 1 0 0 1 14 20 1 14 9 4 1 1 0 0 1 15 8 5)
)
