(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cookie
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCookie (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 27 0 12 2 4 10 10 0 1 0 22 12 4 4 4 0 0 1 17 7 4 4 4 0 0 1 12 2 0 0 2 6 0 8.5 8.5 1 8.5 8.51 0 0 2 6 0 16 15.5 1 16 15.51 0 0 2 6 0 12 12 1 12 12.01 0 0 2 6 0 11 17 1 11 17.01 0 0 2 6 0 7 14 1 7 14.01)
)
