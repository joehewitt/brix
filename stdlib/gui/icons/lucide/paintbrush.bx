(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-paintbrush
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucidePaintbrush (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 14.622 17.897 1 3.942 14.984 0 0 15 78 0 18.376 2.622 4 1 1 0 1 1 21.378 5.624 1 17.36 9.643 4 0.5 0.5 0 0 0 17.36 10.35 1 18.304 11.294 4 2.41 2.41 0 0 1 18.304 14.702 1 17.36 15.646 4 0.5 0.5 0 0 1 16.653 15.646 1 8.354 7.348 4 0.5 0.5 0 0 1 8.354 6.641 1 9.298 5.697 4 2.41 2.41 0 0 1 12.706 5.697 1 13.65 6.641 4 0.5 0.5 0 0 0 14.357 6.641 5 0 0 6 36 0 9 8 2 7.196 10.71 5.03 11.46 2.417 11.948 4 0.507 0.507 0 0 0 2.115 12.767 1 9.435 21.65 4 1 1 0 0 0 10.62 21.854 2 12.735 20.405 16 16.792 16 15)
)
