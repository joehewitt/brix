(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bus-front
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBusFront (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 4 6 1 2 7 0 0 2 6 0 10 6 1 14 6 0 0 2 6 0 22 7 1 20 6 0 0 10 48 0 6 3 1 18 3 4 2 2 0 0 1 20 5 1 20 17 4 2 2 0 0 1 18 19 1 6 19 4 2 2 0 0 1 4 17 1 4 5 4 2 2 0 0 1 6 3 5 0 0 2 6 0 4 11 1 20 11 0 0 2 6 0 8 15 1 8.01 15 0 0 2 6 0 16 15 1 16.01 15 0 0 2 6 0 6 19 1 6 21 0 0 2 6 0 18 21 1 18 19)
)
