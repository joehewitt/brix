(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flame-kindling
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlameKindling (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 49 0 12 2 2 13 5 14.5 5.5 15.5 6.5 4 5 5 0 0 1 17 10 4 5 5 0 1 1 7 10 2 7 9.7 7 9.4 7.1 9.1 4 2 2 0 1 0 10.4 7.1 2 8 4.5 11 2 12 2 5 0 0 2 6 0 5 22 1 19 18 0 0 2 6 0 5 18 1 19 22)
)
