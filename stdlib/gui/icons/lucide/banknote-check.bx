(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-banknote-check
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBanknoteCheck (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 11.748 18 1 4 18 4 2 2 0 0 1 2 16 1 2 8 4 2 2 0 0 1 4 6 1 20 6 4 2 2 0 0 1 22 8 1 22 12.875 0 0 3 9 0 16 19 1 18 21 1 22 17 0 0 2 6 0 18 12 1 18.01 12 0 0 2 6 0 6 12 1 6.01 12 1 0 12 12 2)
)
