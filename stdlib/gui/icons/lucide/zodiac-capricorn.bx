(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zodiac-capricorn
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZodiacCapricorn (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 22 0 11 21 4 3 3 0 0 0 14 18 1 14 6.5 4 1 1 0 0 0 7 6.5 0 0 4 17 0 7 19 1 7 6 4 3 3 0 0 0 4 3 1 4 3 1 0 17 17 3)
)
