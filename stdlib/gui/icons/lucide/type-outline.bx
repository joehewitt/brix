(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-type-outline
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTypeOutline (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 25 133 0 14 16.5 4 0.5 0.5 0 0 0 14.5 17 1 15 17 4 2 2 0 0 1 15 21 1 9 21 4 2 2 0 0 1 9 17 1 9.5 17 4 0.5 0.5 0 0 0 10 16.5 1 10 7.5 4 0.5 0.5 0 0 0 9.5 7 1 6.5 7 4 0.5 0.5 0 0 0 6 7.5 1 6 8 4 2 2 0 0 1 2 8 1 2 5 4 2 2 0 0 1 4 3 1 20 3 4 2 2 0 0 1 22 5 1 22 8 4 2 2 0 0 1 18 8 1 18 7.5 4 0.5 0.5 0 0 0 17.5 7 1 14.5 7 4 0.5 0.5 0 0 0 14 7.5 5)
)
