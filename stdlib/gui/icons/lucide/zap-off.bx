(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zap-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZapOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 10.768 5.111 1 13.44 2.44 4 1.5 1.5 0 0 1 15.914 4.001 1 14.281 8.626 0 0 4 17 0 18.889 13.232 1 19.561 12.56 4 1.5 1.5 0 0 0 18.5 10 1 15.656 10 0 0 2 6 0 2 2 1 22 22 0 0 8 39 0 7.94 7.94 1 4.44 11.439 4 1.5 1.5 0 0 0 5.5 14 1 9.502 14 4 0.5 0.5 0 0 1 9.973 14.666 1 8.086 20 4 1.5 1.5 0 0 0 10.561 21.56 1 16.061 16.06)
)
