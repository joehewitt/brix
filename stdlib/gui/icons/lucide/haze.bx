(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-haze
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideHaze (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 5.2 6.2 1 6.6 7.6 0 0 2 6 0 2 13 1 4 13 0 0 2 6 0 20 13 1 22 13 0 0 2 6 0 17.4 7.6 1 18.8 6.2 0 0 2 6 0 22 17 1 2 17 0 0 2 6 0 22 21 1 2 21 0 0 2 11 0 16 13 4 4 4 0 0 0 8 13 0 0 2 6 0 12 5 1 12 2.5)
)
