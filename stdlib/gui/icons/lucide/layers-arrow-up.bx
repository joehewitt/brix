(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-layers-arrow-up
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLayersArrowUp (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 12 1 12 2 0 0 6 33 0 2 17.002 4 1 1 0 0 0 2.58 17.912 1 11.18 21.822 4 2 2 0 0 0 12.83 21.822 1 21.41 17.922 4 1 1 0 0 0 22 17.002 0 0 9 47 0 7.674 8.774 1 2.58 11.09 4 1 1 0 0 0 2.58 12.912 1 11.18 16.822 4 2 2 0 0 0 12.83 16.822 1 21.41 12.922 4 1 1 0 0 0 22 12.002 4 1 1 0 0 0 21.41 11.08 1 16.332 8.772 0 0 3 9 0 9 5 1 12 2 1 15 5)
)
