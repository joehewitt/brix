(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-drill
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideDrill (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 42 0 10 18 4 1 1 0 0 1 11 19 1 11 21 4 1 1 0 0 1 10 22 1 5 22 4 3 3 0 0 1 2 19 4 1 1 0 0 1 3 18 5 0 0 12 61 0 13 10 1 4 10 4 2 2 0 0 1 2 8 1 2 4 4 2 2 0 0 1 4 2 1 13 2 4 1 1 0 0 1 14 3 1 14 9 4 1 1 0 0 1 13 10 1 12.19 13.242 4 1 1 0 0 1 11.22 14 1 8 14 0 0 6 28 0 14 4 1 17 4 4 1 1 0 0 1 18 5 1 18 7 4 1 1 0 0 1 17 8 1 14 8 0 0 2 6 0 18 6 1 22 6 0 0 2 6 0 5 10 1 3 18 0 0 2 6 0 7 18 1 9 10)
)
