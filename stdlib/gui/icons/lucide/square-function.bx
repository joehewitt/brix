(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-square-function
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideSquareFunction (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 5 3 1 19 3 4 2 2 0 0 1 21 5 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 1 3 5 4 2 2 0 0 1 5 3 5 0 0 4 20 0 9 17 2 11 17 11.8 16 11.8 14.2 1 11.8 10 2 11.8 8 12.8 6.7 15 7 0 0 2 6 0 9 11.2 1 14.7 11.2)
)
