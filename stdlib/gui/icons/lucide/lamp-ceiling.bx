(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-lamp-ceiling
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLampCeiling (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12 2 1 12 7 0 0 2 11 0 14.829 15.998 4 3 3 0 1 1 9.171 15.998 0 0 9 45 0 20.92 14.606 4 1 1 0 0 1 20 16 1 4 16 4 1 1 0 0 1 3.08 14.606 1 6.08 7.606 4 1 1 0 0 1 7 7 1 17 7 4 1 1 0 0 1 17.92 7.606 5)
)
