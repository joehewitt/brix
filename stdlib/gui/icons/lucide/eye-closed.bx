(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-eye-closed
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideEyeClosed (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 15 18 1 14.278 14.75 0 0 2 11 0 2 8 4 10.645 10.645 0 0 0 22 8 0 0 2 6 0 20 15 1 18.274 12.95 0 0 2 6 0 4 15 1 5.726 12.95 0 0 2 6 0 9 18 1 9.722 14.75)
)
