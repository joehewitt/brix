(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bean
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBean (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 41 0 10.165 6.598 2 9.954 7.478 9.64 8.36 9 9 2 8.36 9.64 7.479 9.954 6.598 10.165 4 6 6 0 0 0 8 22 2 15.732 22 22 15.732 22 8 4 6 6 0 0 0 10.165 6.598 5 0 0 2 11 0 5.341 10.62 4 4 4 0 1 0 10.62 5.34)
)
