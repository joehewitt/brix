(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-refresh-cw-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRefreshCwOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 21 0 21 8 1 18.74 5.74 4 9.75 9.75 0 0 0 12 3 2 11 3 10.03 3.16 9.13 3.47 0 0 3 9 0 8 16 1 3 16 1 3 21 0 0 2 10 0 3 12 2 3 9.51 4 7.26 5.64 5.64 0 0 4 21 0 3 16 1 5.26 18.26 4 9.75 9.75 0 0 0 12 21 2 14.49 21 16.74 20 18.36 18.36 0 0 2 10 0 21 12 2 21 13 20.84 13.97 20.53 14.87 0 0 3 9 0 21 3 1 21 8 1 16 8 0 0 2 6 0 22 22 1 2 2)
)
