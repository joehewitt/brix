(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-scan-qr-code
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideScanQrCode (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 17 12 1 17 16 4 1 1 0 0 1 16 17 1 12 17 0 0 4 17 0 17 3 1 19 3 4 2 2 0 0 1 21 5 1 21 7 0 0 2 6 0 17 8 1 17 7 0 0 4 17 0 21 17 1 21 19 4 2 2 0 0 1 19 21 1 17 21 0 0 4 17 0 3 7 1 3 5 4 2 2 0 0 1 5 3 1 7 3 0 0 2 6 0 7 17 1 7.01 17 0 0 4 17 0 7 21 1 5 21 4 2 2 0 0 1 3 19 1 3 17 0 0 10 48 0 8 7 1 11 7 4 1 1 0 0 1 12 8 1 12 11 4 1 1 0 0 1 11 12 1 8 12 4 1 1 0 0 1 7 11 1 7 8 4 1 1 0 0 1 8 7 5)
)
