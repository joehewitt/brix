(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-flip-vertical-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFlipVerticalN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 12 0 17 3 1 12 8 1 7 3 1 17 3 0 0 4 12 0 17 21 1 12 16 1 7 21 1 17 21 0 0 2 6 0 4 12 1 2 12 0 0 2 6 0 10 12 1 8 12 0 0 2 6 0 16 12 1 14 12 0 0 2 6 0 22 12 1 20 12)
)
