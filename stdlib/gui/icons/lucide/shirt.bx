(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shirt
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShirt (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 18 86 0 20.38 3.46 1 16 2 4 4 4 0 0 1 8 2 1 3.62 3.46 4 2 2 0 0 0 2.28 5.69 1 2.86 9.16 4 1 1 0 0 0 3.85 10 1 6 10 1 6 20 2 6 21.1 6.9 22 8 22 1 16 22 4 2 2 0 0 0 18 20 1 18 10 1 20.15 10 4 1 1 0 0 0 21.14 9.16 1 21.72 5.69 4 2 2 0 0 0 20.38 3.46 5)
)
