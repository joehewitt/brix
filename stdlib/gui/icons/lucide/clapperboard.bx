(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-clapperboard
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideClapperboard (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 12.296 3.464 1 15.316 7.42 0 0 7 27 0 20.2 6 1 3 11 1 2.1 8.6 2 1.8 7.5 2.4 6.4 3.4 6.1 1 16.9 2.1 2 18 1.8 19.1 2.4 19.4 3.4 5 0 0 7 29 0 3 11 1 21 11 1 21 19 4 2 2 0 0 1 19 21 1 5 21 4 2 2 0 0 1 3 19 5 0 0 2 6 0 6.18 5.276 1 9.28 9.175)
)
