(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-server-cog
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideServerCog (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 10.852 14.772 1 10.469 15.695 0 0 3 14 0 13.148 14.772 4 3 3 0 1 0 10.852 9.228 1 10.469 8.305 0 0 2 6 0 13.148 9.228 1 13.531 8.305 0 0 3 14 0 13.53 15.696 1 13.148 14.772 4 3 3 0 1 1 10.852 9.228 0 0 2 6 0 14.772 10.852 1 15.695 10.469 0 0 2 6 0 14.772 13.148 1 15.695 13.531 0 0 10 50 0 4.5 10 1 4 10 4 2 2 0 0 1 2 8 1 2 4 4 2 2 0 0 1 4 2 1 20 2 4 2 2 0 0 1 22 4 1 22 8 4 2 2 0 0 1 20 10 1 19.5 10 0 0 10 50 0 4.5 14 1 4 14 4 2 2 0 0 0 2 16 1 2 20 4 2 2 0 0 0 4 22 1 20 22 4 2 2 0 0 0 22 20 1 22 16 4 2 2 0 0 0 20 14 1 19.5 14 0 0 2 6 0 6 18 1 6.01 18 0 0 2 6 0 6 6 1 6.01 6 0 0 2 6 0 9.228 10.852 1 8.305 10.469 0 0 2 6 0 9.228 13.148 1 8.305 13.531)
)
