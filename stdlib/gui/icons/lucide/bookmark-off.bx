(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-bookmark-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideBookmarkOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 8 39 0 19 19 1 19 20 4 1 1 0 0 1 17.504 20.868 1 12.992 18.29 4 2 2 0 0 0 11.008 18.29 1 6.496 20.868 4 1 1 0 0 1 5 20 1 5 5 0 0 2 6 0 2 2 1 22 22 0 0 4 17 0 8.656 3 1 17 3 4 2 2 0 0 1 19 5 1 19 13.344)
)
