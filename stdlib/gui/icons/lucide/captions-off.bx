(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-captions-off
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCaptionsOff (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 10.5 5 1 19 5 4 2 2 0 0 1 21 7 1 21 15.5 0 0 2 6 0 17 11 1 16.5 11 0 0 5 25 0 19 19 1 5 19 4 2 2 0 0 1 3 17 1 3 7 4 2 2 0 0 1 5 5 0 0 2 6 0 2 2 1 22 22 0 0 2 6 0 7 11 1 11 11 0 0 2 6 0 7 15 1 9.5 15)
)
