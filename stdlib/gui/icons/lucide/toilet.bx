(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-toilet
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideToilet (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 11 58 0 7 12 1 20 12 4 1 1 0 0 1 21 13 4 5 5 0 0 1 16 18 1 15.402 18 4 0.5 0.5 0 0 0 14.978 18.765 1 16.522 21.235 4 0.5 0.5 0 0 1 16.098 22 1 5.402 22 4 0.5 0.5 0 0 1 4.978 21.235 1 7 18 0 0 7 36 0 8 18 4 5 5 0 0 1 3 13 1 3 4 4 2 2 0 0 1 5 2 1 13 2 4 2 2 0 0 1 15 4 1 15 12)
)
