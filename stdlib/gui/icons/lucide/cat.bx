(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cat
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCat (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 75 0 12 5 2 12.67 5 13.35 5.09 14 5.26 2 15.78 3.26 19.03 2.42 20.42 3 2 21.82 3.58 20 10 20 10 2 20.57 11.07 21 12.24 21 13.44 2 21 17.9 16.97 21 12 21 2 7.03 21 3 18 3 13.44 2 3 12.19 3.5 11.04 4 10 2 4 10 2.11 3.58 3.5 3 2 4.89 2.42 8.22 3.23 10 5.23 4 9.04 9.04 0 0 1 12 5 5 0 0 2 6 0 8 14 1 8 14.5 0 0 2 6 0 16 14 1 16 14.5 0 0 5 13 0 11.25 16.25 1 12.75 16.25 1 12 17 1 11.25 16.25 5)
)
