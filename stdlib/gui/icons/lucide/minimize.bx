(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-minimize
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideMinimize (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 4 17 0 8 3 1 8 6 4 2 2 0 0 1 6 8 1 3 8 0 0 4 17 0 21 8 1 18 8 4 2 2 0 0 1 16 6 1 16 3 0 0 4 17 0 3 16 1 6 16 4 2 2 0 0 1 8 18 1 8 21 0 0 4 17 0 16 21 1 16 18 4 2 2 0 0 1 18 16 1 21 16)
)
