(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-image-play
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideImagePlay (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 34 0 15 15.003 4 1 1 0 0 1 16.517 14.144 1 21.514 17.141 4 1 1 0 0 1 21.514 18.859 1 16.517 21.856 4 1 1 0 0 1 15 20.996 5 0 0 8 39 0 21 12.17 1 21 5 4 2 2 0 0 0 19 3 1 5 3 4 2 2 0 0 0 3 5 1 3 19 4 2 2 0 0 0 5 21 1 11 21 0 0 2 6 0 6 21 1 11 16 1 0 9 9 2)
)
