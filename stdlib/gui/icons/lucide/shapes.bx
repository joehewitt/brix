(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-shapes
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideShapes (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 7 34 0 8.3 10 4 0.7 0.7 0 0 1 7.674 8.921 1 11.4 3 4 0.7 0.7 0 0 1 12.598 2.957 1 16.3 8.9 4 0.7 0.7 0 0 1 15.728 10 5 0 0 10 48 0 4 14 1 9 14 4 1 1 0 0 1 10 15 1 10 20 4 1 1 0 0 1 9 21 1 4 21 4 1 1 0 0 1 3 20 1 3 15 4 1 1 0 0 1 4 14 5 1 0 17.5 17.5 3.5)
)
