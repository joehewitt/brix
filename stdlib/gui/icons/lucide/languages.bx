(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-languages
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideLanguages (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 2 6 0 5 8 1 11 14 0 0 3 9 0 4 14 1 10 8 1 12 5 0 0 2 6 0 2 5 1 14 5 0 0 2 6 0 7 2 1 8 2 0 0 3 9 0 22 22 1 17 12 1 12 22 0 0 2 6 0 14 18 1 20 18)
)
