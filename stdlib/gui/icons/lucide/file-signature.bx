(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-signature
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileSignature (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 9 45 0 14.364 13.634 4 2 2 0 0 0 13.858 14.488 1 13.021 17.358 4 0.5 0.5 0 0 0 13.641 17.978 1 16.511 17.141 4 2 2 0 0 0 17.365 16.635 1 21.378 12.626 4 1 1 0 0 0 18.374 9.622 5 0 0 3 14 0 14.487 7.858 4 1 1 0 0 1 14 7 1 14 2 0 0 10 50 0 20 19.645 1 20 20 4 2 2 0 0 1 18 22 1 6 22 4 2 2 0 0 1 4 20 1 4 4 4 2 2 0 0 1 6 2 1 14 2 4 2.4 2.4 0 0 1 15.704 2.706 1 18.22 5.222 0 0 2 6 0 8 18 1 9 18)
)
