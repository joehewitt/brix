(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-zodiac-aquarius
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideZodiacAquarius (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 12 61 0 2 10 1 4.456 6.316 4 0.7 0.7 0 0 1 5.562 6.303 1 7.952 9.716 4 0.7 0.7 0 0 0 9.048 9.715 1 11.45 6.283 4 0.7 0.7 0 0 1 12.548 6.283 1 14.95 9.715 4 0.7 0.7 0 0 0 16.048 9.715 1 18.437 6.302 4 0.7 0.7 0 0 1 19.543 6.315 1 22 10 0 0 12 61 0 2 18.002 1 4.456 14.318 4 0.7 0.7 0 0 1 5.562 14.305 1 7.952 17.718 4 0.7 0.7 0 0 0 9.049 17.718 1 11.451 14.286 4 0.7 0.7 0 0 1 12.549 14.286 1 14.951 17.718 4 0.7 0.7 0 0 0 16.049 17.718 1 18.438 14.305 4 0.7 0.7 0 0 1 19.544 14.318 1 22 18.002)
)
