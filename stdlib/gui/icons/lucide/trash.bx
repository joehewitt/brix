(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-trash
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideTrash (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 6 28 0 19 6 1 19 20 4 2 2 0 0 1 17 22 1 7 22 4 2 2 0 0 1 5 20 1 5 6 0 0 2 6 0 3 6 1 21 6 0 0 6 28 0 8 6 1 8 4 4 2 2 0 0 1 10 2 1 14 2 4 2 2 0 0 1 16 4 1 16 6)
)
