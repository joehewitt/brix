(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-router
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRouter (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 14 1 20 14 4 2 2 0 0 1 22 16 1 22 20 4 2 2 0 0 1 20 22 1 4 22 4 2 2 0 0 1 2 20 1 2 16 4 2 2 0 0 1 4 14 5 0 0 2 6 0 6.01 18 1 6 18 0 0 2 6 0 10.01 18 1 10 18 0 0 2 6 0 15 10 1 15 14 0 0 2 11 0 17.84 7.17 4 4 4 0 0 0 12.18 7.17 0 0 2 11 0 20.66 4.34 4 8 8 0 0 0 9.35 4.34)
)
