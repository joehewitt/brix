(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-cassette-tape
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideCassetteTape (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 48 0 4 4 1 20 4 4 2 2 0 0 1 22 6 1 22 18 4 2 2 0 0 1 20 20 1 4 20 4 2 2 0 0 1 2 18 1 2 6 4 2 2 0 0 1 4 4 5 1 0 8 10 2 0 0 2 6 0 8 12 1 16 12 1 0 16 10 2 0 0 6 28 0 6 20 1 6.7 17.1 4 1.4 1.4 0 0 1 8.1 16 1 15.9 16 4 1.4 1.4 0 0 1 17.3 17 1 18 20)
)
