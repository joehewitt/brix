(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-recycle
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideRecycle (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 5 25 0 7 19 1 4.815 19 4 1.83 1.83 0 0 1 3.245 18.119 4 1.785 1.785 0 0 1 3.241 16.335 1 7.196 9.5 0 0 5 25 0 11 19 1 19.203 19 4 1.83 1.83 0 0 0 20.759 18.11 4 1.784 1.784 0 0 0 20.759 16.335 1 19.533 14.215 0 0 3 9 0 14 16 1 11 19 1 14 22 0 0 3 9 0 8.293 13.596 1 7.196 9.5 1 3.1 10.598 0 0 5 25 0 9.344 5.811 1 10.437 3.919 4 1.83 1.83 0 0 1 11.985 3 4 1.784 1.784 0 0 1 13.531 3.888 1 17.474 10.731 0 0 3 9 0 13.378 9.633 1 17.474 10.731 1 18.571 6.635)
)
