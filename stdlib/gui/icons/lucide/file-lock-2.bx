(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-file-lock-2
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideFileLockN2 (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 10 50 0 4 9.8 1 4 4 4 2 2 0 0 1 6 2 1 14 2 4 2.4 2.4 0 0 1 15.706 2.706 1 19.294 6.294 4 2.4 2.4 0 0 1 20 8 1 20 20 4 2 2 0 0 1 18 22 1 15 22 0 0 4 17 0 14 2 1 14 7 4 1 1 0 0 0 15 8 1 20 8 0 0 4 17 0 9 17 1 9 15 4 2 2 0 0 0 5 15 1 5 17 0 0 10 48 0 4 17 1 10 17 4 1 1 0 0 1 11 18 1 11 21 4 1 1 0 0 1 10 22 1 4 22 4 1 1 0 0 1 3 21 1 3 18 4 1 1 0 0 1 4 17 5)
)
