(import /graphics/primitives)
(import /gui/icon)
(import /gui/icons/lucide-icon)
(import /gui/theme)

(style-extend GUIDefaultTheme
  (rule icon-clock-arrow-right
    (own-rule icon-host
      (<> LucideIcon (slot: first-child) (• icon)
        (= glyph (call lucide-glyph-program))
      )
    )
  )
)

(type + LucideClockArrowRight (is LucideIcon)
  (fn-do + This _
    (= glyph (call lucide-glyph-program))
  )
)

(fn-expr _ lucide-glyph-program (list Coord)
  (list 0 0 3 9 0 12 6 1 12 12 1 14 13 0 0 2 11 0 13.5 21.885 4 10 10 0 1 1 22 12 0 0 2 6 0 14 18 1 22 18 0 0 3 9 0 18 22 1 22 18 1 18 14)
)
