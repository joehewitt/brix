━━━━━━━━━━━━━━━━━━━━
+ do paint-lucide-glyph
    - canvas Canvas
    - program [Coord]
    - rect Rect
    - stroke-width F64 = 2
    - color RGBA = black

. side = min(rect.width, rect.height)
=? if side <= 0
. scale = side / 24
do use canvas.saved-state
    canvas.translate(rect.x + (rect.width - side) / 2, rect.y + (rect.height - side) / 2)
    canvas.transform(matrix-from-scale(Dimensions(scale, scale)))
    canvas.stroke-color = color
    canvas.stroke-width = stroke-width
    canvas.stroke-cap = LineCap.round
    canvas.stroke-join = LineJoin.round
    for part in lucide-glyph-parts(program)
        canvas.fill-color = color if part.is-filled
        for path in part.shape.draw()
            path.outline(canvas)

━━━━━━━━━━━━━━━━━━━━
+ do lucide-glyph-path [Coord]
    - ops [PathOp]
    - is-filled Bool

. data = List'Coord()
for op in ops
    if op is PathMoveTo
        . move = op as PathMoveTo
        data += LucideGlyphOp.move-to as U32
        data += move.x
        data += move.y
    else if op is PathLineTo
        . line = op as PathLineTo
        data += LucideGlyphOp.line-to as U32
        data += line.x
        data += line.y
    else if op is PathCubicTo
        . cubic = op as PathCubicTo
        data += LucideGlyphOp.cubic-to as U32
        data += cubic.c1x
        data += cubic.c1y
        data += cubic.c2x
        data += cubic.c2y
        data += cubic.x
        data += cubic.y
    else if op is PathQuadraticTo
        . quadratic = op as PathQuadraticTo
        data += LucideGlyphOp.quadratic-to as U32
        data += quadratic.cx
        data += quadratic.cy
        data += quadratic.x
        data += quadratic.y
    else if op is PathArcTo
        . arc = op as PathArcTo
        data += LucideGlyphOp.arc-to as U32
        data += arc.rx
        data += arc.ry
        data += arc.rotation
        data += if arc.large then 1.0 else 0.0
        data += if arc.sweep then 1.0 else 0.0
        data += arc.x
        data += arc.y
    else
        data += LucideGlyphOp.close as U32
. program = List'Coord()
program += LucideGlyphShape.path as U32
program += if is-filled then 1.0 else 0.0
program += ops.length as Coord
program += data.length as Coord
program ++= data
= program

━━━━━━━━━━━━━━━━━━━━
+ do lucide-glyph-svg String
    - program [Coord]
    - stroke-width F64 = 2

. lines = List'String()
lines += "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"${lucide-glyph-number(stroke-width)}\" stroke-linecap=\"round\" stroke-linejoin=\"round\">"
. cursor Index = 0
while cursor < program.length
    . kind = program[cursor] as U32 as LucideGlyphShape
    . fill = if program[cursor + 1] != 0 then " fill=\"currentColor\"" else ""
    cursor += 2
    match kind
        |= LucideGlyphShape.path
            . limit = cursor + 2 + (program[cursor + 1] as Index)
            lines += "  <path d=\"${lucide-glyph-path-data(program, cursor + 2, limit)}\"$fill />"
            cursor = limit
        |= LucideGlyphShape.circle
            lines += "  <circle cx=\"${lucide-glyph-number(program[cursor])}\" cy=\"${lucide-glyph-number(program[cursor + 1])}\" r=\"${lucide-glyph-number(program[cursor + 2])}\"$fill />"
            cursor += 3
        |= LucideGlyphShape.ellipse
            lines += "  <ellipse cx=\"${lucide-glyph-number(program[cursor])}\" cy=\"${lucide-glyph-number(program[cursor + 1])}\" rx=\"${lucide-glyph-number(program[cursor + 2])}\" ry=\"${lucide-glyph-number(program[cursor + 3])}\"$fill />"
            cursor += 4
        |= LucideGlyphShape.line
            lines += "  <line x1=\"${lucide-glyph-number(program[cursor])}\" y1=\"${lucide-glyph-number(program[cursor + 1])}\" x2=\"${lucide-glyph-number(program[cursor + 2])}\" y2=\"${lucide-glyph-number(program[cursor + 3])}\"$fill />"
            cursor += 4
        |= LucideGlyphShape.rectangle
            lines += "  <rect x=\"${lucide-glyph-number(program[cursor])}\" y=\"${lucide-glyph-number(program[cursor + 1])}\" width=\"${lucide-glyph-number(program[cursor + 2])}\" height=\"${lucide-glyph-number(program[cursor + 3])}\"$fill />"
            cursor += 4
lines += "</svg>"
= "${"\n".join(lines)}\n"

━━━━━━━━━━━━━━━━━━━━
+ do lucide-glyph-module String
    - name String
    - type-name String
    - program [Coord]

. values = ", ".join(List'String(lucide-glyph-number(each) in program))
. lines = List'String()
lines += "/graphics/primitives"
lines += "/gui/icon"
lines += "/gui/icons/lucide-icon"
lines += "/gui/theme"
lines += ""
lines += "━━━━━━━━━━━━━━━━━━━━"
lines += "• extend GUIDefaultTheme"
lines += ""
lines += "• icon-$name"
lines += "    • own icon-host"
lines += "        <LucideIcon (first-child) • icon"
lines += "            glyph = lucide-glyph-program()"
lines += ""
lines += "━━━━━━━━━━━━━━━━━━━━"
lines += "+ $type-name is LucideIcon"
lines += ""
lines += "────────────────────"
lines += "+ This"
lines += ""
lines += "glyph = lucide-glyph-program()"
lines += ""
lines += "━━━━━━━━━━━━━━━━━━━━"
lines += "_ lucide-glyph-program [Coord]"
lines += ""
lines += "[$values]"
= "${"\n".join(lines)}\n"

━━━━━━━━━━━━━━━━━━━━
+ lucide-glyph-number String
    - value F64

if rounded == 0 then "0" else "$rounded"

.. rounded = round(value * 1000) / 1000

━━━━━━━━━━━━━━━━━━━━
_ LucideGlyphShape is U32

| path = 0
| circle = 1
| ellipse = 2
| line = 3
| rectangle = 4

━━━━━━━━━━━━━━━━━━━━
_ LucideGlyphOp is U32

| move-to = 0
| line-to = 1
| cubic-to = 2
| quadratic-to = 3
| arc-to = 4
| close = 5

━━━━━━━━━━━━━━━━━━━━
_ LucideGlyphPart is Tuple

+ shape GraphicNode
+ is-filled Bool

━━━━━━━━━━━━━━━━━━━━
_ do lucide-glyph-parts [LucideGlyphPart]
    - program [Coord]

. parts = List'LucideGlyphPart()
. cursor Index = 0
while cursor < program.length
    . kind = program[cursor] as U32 as LucideGlyphShape
    . is-filled = program[cursor + 1] != 0
    cursor += 2
    match kind
        |= LucideGlyphShape.path
            . limit = cursor + 2 + (program[cursor + 1] as Index)
            parts += LucideGlyphPart(VectorPath(lucide-glyph-ops(program, cursor + 2, limit, program[cursor] as Size)), is-filled)
            cursor = limit
        |= LucideGlyphShape.circle
            parts += LucideGlyphPart(Circle(Point(program[cursor], program[cursor + 1]), program[cursor + 2]), is-filled)
            cursor += 3
        |= LucideGlyphShape.ellipse
            . center = Point(program[cursor], program[cursor + 1])
            parts += LucideGlyphPart(Ellipse(center, Dimensions(program[cursor + 2], program[cursor + 3])), is-filled)
            cursor += 4
        |= LucideGlyphShape.line
            . from = Point(program[cursor], program[cursor + 1])
            parts += LucideGlyphPart(Line(from, Point(program[cursor + 2], program[cursor + 3])), is-filled)
            cursor += 4
        |= LucideGlyphShape.rectangle
            . bounds = Rect(program[cursor], program[cursor + 1], program[cursor + 2], program[cursor + 3])
            parts += LucideGlyphPart(Rectangle(bounds), is-filled)
            cursor += 4
= parts

━━━━━━━━━━━━━━━━━━━━
_ do lucide-glyph-ops [PathOp]
    - program [Coord]
    - start Index
    - limit Index
    - count Size

. ops [PathOp]
ops.reserve(count)
. cursor = start
while cursor < limit
    match program[cursor] as U32 as LucideGlyphOp
        |= LucideGlyphOp.move-to
            ops += M(program[cursor + 1], program[cursor + 2])
            cursor += 3
        |= LucideGlyphOp.line-to
            ops += L(program[cursor + 1], program[cursor + 2])
            cursor += 3
        |= LucideGlyphOp.cubic-to
            ops += C
                - program[cursor + 1]
                - program[cursor + 2]
                - program[cursor + 3]
                - program[cursor + 4]
                - program[cursor + 5]
                - program[cursor + 6]
            cursor += 7
        |= LucideGlyphOp.quadratic-to
            ops += Q
                - program[cursor + 1]
                - program[cursor + 2]
                - program[cursor + 3]
                - program[cursor + 4]
            cursor += 5
        |= LucideGlyphOp.arc-to
            ops += A
                - program[cursor + 1]
                - program[cursor + 2]
                - program[cursor + 3]
                - program[cursor + 4] != 0
                - program[cursor + 5] != 0
                - program[cursor + 6]
                - program[cursor + 7]
            cursor += 8
        |= LucideGlyphOp.close
            ops += Z()
            cursor += 1
= ops

━━━━━━━━━━━━━━━━━━━━
_ do lucide-glyph-path-data String
    - program [Coord]
    - start Index
    - limit Index

. parts = List'String()
. cursor = start
while cursor < limit
    match program[cursor] as U32 as LucideGlyphOp
        |= LucideGlyphOp.move-to
            parts += "M${lucide-glyph-number(program[cursor + 1])} ${lucide-glyph-number(program[cursor + 2])}"
            cursor += 3
        |= LucideGlyphOp.line-to
            parts += "L${lucide-glyph-number(program[cursor + 1])} ${lucide-glyph-number(program[cursor + 2])}"
            cursor += 3
        |= LucideGlyphOp.cubic-to
            parts += "C${lucide-glyph-coords(program, cursor + 1, 6)}"
            cursor += 7
        |= LucideGlyphOp.quadratic-to
            parts += "Q${lucide-glyph-coords(program, cursor + 1, 4)}"
            cursor += 5
        |= LucideGlyphOp.arc-to
            parts += "A${lucide-glyph-coords(program, cursor + 1, 7)}"
            cursor += 8
        |= LucideGlyphOp.close
            parts += "Z"
            cursor += 1
= "".join(parts)

━━━━━━━━━━━━━━━━━━━━
_ lucide-glyph-coords String
    - program [Coord]
    - start Index
    - count Size

" ".join(List'String(lucide-glyph-number(program[start + each]) in 0 .. < count))
