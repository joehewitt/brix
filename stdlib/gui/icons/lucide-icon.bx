(import /graphics/canvas)
(import /graphics/color)
(import /graphics/graphic)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/vector)
(import /gui/vector-image)
(import /math)

(type + LucideIcon (is VectorImage)
  (rule This
    (= fill (. Fill none))
    (= stroke black)
    (= stroke-width 2)
    (= stroke-cap (. LineCap round))
    (= stroke-join (. LineJoin round))
  )
  (fn-do + glyph _ :set (param program (list Coord))
    (call (. group clear))
    (= view-box (call Rect 0 0 24 24))
    (for (in part (call lucide-glyph-parts program))
      (if (. part is-filled)
        (= (. part shape fill) (. Fill stroke))
      )
      (+= group (. part shape))
    )
  )
)

(fn-do + paint-lucide-glyph _
  (param canvas Canvas)
  (param program (list Coord))
  (param rect Rect)
  (param stroke-width F64 (= 2))
  (param color RGBA (= black))
  (let side (call min (. rect width) (. rect height)))
  (return-if (if (<= side 0)))
  (blank)
  (let scale (/ side 24))
  (do-use (. canvas saved-state)
    (call (. canvas translate) (+ (. rect x) (/ (- (. rect width) side) 2)) (+ (. rect y) (/ (- (. rect height) side) 2)))
    (call (. canvas transform) (call matrix-from-scale (call Dimensions scale scale)))
    (= (. canvas stroke-color) color)
    (= (. canvas stroke-width) stroke-width)
    (= (. canvas stroke-cap) (. LineCap round))
    (= (. canvas stroke-join) (. LineJoin round))
    (for (in part (call lucide-glyph-parts program))
      (= (. canvas fill-color) (only-if color (if (. part is-filled))))
      (for (in path (call (. part shape draw)))
        (call (. path outline) canvas)
      )
    )
  )
)

(fn-do + lucide-glyph-path (list Coord)
  (param ops (list PathOp))
  (param is-filled Bool)
  (let data (call (of List Coord)))
  (for (in op ops)
    (if (is op PathMoveTo)
      (let move (as op PathMoveTo))
      (+= data (as (. LucideGlyphOp move-to) U32))
      (+= data (. move x))
      (+= data (. move y))
      (else-if (is op PathLineTo)
        (let line (as op PathLineTo))
        (+= data (as (. LucideGlyphOp line-to) U32))
        (+= data (. line x))
        (+= data (. line y))
      )
      (else-if (is op PathCubicTo)
        (let cubic (as op PathCubicTo))
        (+= data (as (. LucideGlyphOp cubic-to) U32))
        (+= data (. cubic c1x))
        (+= data (. cubic c1y))
        (+= data (. cubic c2x))
        (+= data (. cubic c2y))
        (+= data (. cubic x))
        (+= data (. cubic y))
      )
      (else-if (is op PathQuadraticTo)
        (let quadratic (as op PathQuadraticTo))
        (+= data (as (. LucideGlyphOp quadratic-to) U32))
        (+= data (. quadratic cx))
        (+= data (. quadratic cy))
        (+= data (. quadratic x))
        (+= data (. quadratic y))
      )
      (else-if (is op PathArcTo)
        (let arc (as op PathArcTo))
        (+= data (as (. LucideGlyphOp arc-to) U32))
        (+= data (. arc rx))
        (+= data (. arc ry))
        (+= data (. arc rotation))
        (+= data (if-expr (. arc large) 1.0 0.0))
        (+= data (if-expr (. arc sweep) 1.0 0.0))
        (+= data (. arc x))
        (+= data (. arc y))
      )
      (else
        (+= data (as (. LucideGlyphOp close) U32))
      )
    )
  )
  (let program (call (of List Coord)))
  (+= program (as (. LucideGlyphShape path) U32))
  (+= program (if-expr is-filled 1.0 0.0))
  (+= program (as (. ops length) Coord))
  (+= program (as (. data length) Coord))
  (++= program data)
  (return program)
)

(fn-do + lucide-glyph-svg String
  (param program (list Coord))
  (param stroke-width F64 (= 2))
  (let lines (call (of List String)))
  (+= lines
    (paragraph
      (str "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"" (call lucide-glyph-number stroke-width) "\" stroke-linecap=\"round\" stroke-linejoin=\"round\">")
    )
  )
  (let cursor Index 0)
  (while (< cursor (. program length))
    (let kind (as ([] program cursor) U32 LucideGlyphShape))
    (let fill (if-expr (!= ([] program (+ cursor 1)) 0) " fill=\"currentColor\"" ""))
    (+= cursor 2)
    (match kind
      (case= (. LucideGlyphShape path)
        (let limit (+ cursor 2 (as ([] program (+ cursor 1)) Index)))
        (+= lines (str "  <path d=\"" (call lucide-glyph-path-data program (+ cursor 2) limit) "\"" fill " />"))
        (= cursor limit)
      )
      (case= (. LucideGlyphShape circle)
        (+= lines
          (paragraph
            (str "  <circle cx=\"" (call lucide-glyph-number ([] program cursor)) "\" cy=\"" (call lucide-glyph-number ([] program (+ cursor 1))) "\" r=\"" (call lucide-glyph-number ([] program (+ cursor 2))) "\"" fill " />")
          )
        )
        (+= cursor 3)
      )
      (case= (. LucideGlyphShape ellipse)
        (+= lines
          (paragraph
            (str "  <ellipse cx=\"" (call lucide-glyph-number ([] program cursor)) "\" cy=\"" (call lucide-glyph-number ([] program (+ cursor 1))) "\" rx=\"" (call lucide-glyph-number ([] program (+ cursor 2))) "\" ry=\"" (call lucide-glyph-number ([] program (+ cursor 3))) "\"" fill " />")
          )
        )
        (+= cursor 4)
      )
      (case= (. LucideGlyphShape line)
        (+= lines
          (paragraph
            (str "  <line x1=\"" (call lucide-glyph-number ([] program cursor)) "\" y1=\"" (call lucide-glyph-number ([] program (+ cursor 1))) "\" x2=\"" (call lucide-glyph-number ([] program (+ cursor 2))) "\" y2=\"" (call lucide-glyph-number ([] program (+ cursor 3))) "\"" fill " />")
          )
        )
        (+= cursor 4)
      )
      (case= (. LucideGlyphShape rectangle)
        (+= lines
          (paragraph
            (str "  <rect x=\"" (call lucide-glyph-number ([] program cursor)) "\" y=\"" (call lucide-glyph-number ([] program (+ cursor 1))) "\" width=\"" (call lucide-glyph-number ([] program (+ cursor 2))) "\" height=\"" (call lucide-glyph-number ([] program (+ cursor 3))) "\"" fill " />")
          )
        )
        (+= cursor 4)
      )
    )
  )
  (+= lines "</svg>")
  (return (str (call (. "\n" join) lines) "\n"))
)

(fn-do + lucide-glyph-module String
  (param name String)
  (param type-name String)
  (param program (list Coord))
  (let values (call (. " " join) (call (of List String) (in (call lucide-glyph-number each) program))))
  (let lines (call (of List String)))
  (+= lines "(import /graphics/primitives)")
  (+= lines "(import /gui/icon)")
  (+= lines "(import /gui/icons/lucide-icon)")
  (+= lines "(import /gui/theme)")
  (+= lines "")
  (+= lines "(style-extend GUIDefaultTheme")
  (+= lines (str "  (rule icon-" name))
  (+= lines "    (own-rule icon-host")
  (+= lines "      (<> LucideIcon (slot: first-child) (• icon)")
  (+= lines "        (= glyph (call lucide-glyph-program))")
  (+= lines "      )")
  (+= lines "    )")
  (+= lines "  )")
  (+= lines ")")
  (+= lines "")
  (+= lines (str "(type + " type-name " (is LucideIcon)"))
  (+= lines "  (fn-do + This _")
  (+= lines "    (= glyph (call lucide-glyph-program))")
  (+= lines "  )")
  (+= lines ")")
  (+= lines "")
  (+= lines "(fn-expr _ lucide-glyph-program (list Coord)")
  (+= lines (str "  (list " values ")"))
  (+= lines ")")
  (return (str (call (. "\n" join) lines) "\n"))
)

(fn-expr + lucide-glyph-number String
  (param value F64)
  (if-expr (== rounded 0) "0" (str rounded))
  (where
    (lazy rounded (/ (call round (* value 1000)) 1000))
  )
)

(type _ LucideGlyphShape (is U32)
  (variant path (= 0))
  (variant circle (= 1))
  (variant ellipse (= 2))
  (variant line (= 3))
  (variant rectangle (= 4))
)

(type _ LucideGlyphOp (is U32)
  (variant move-to (= 0))
  (variant line-to (= 1))
  (variant cubic-to (= 2))
  (variant quadratic-to (= 3))
  (variant arc-to (= 4))
  (variant close (= 5))
)

(type _ LucideGlyphPart (is Tuple)
  (prop + shape GraphicNode)
  (prop + is-filled Bool)
)

(fn-do _ lucide-glyph-parts (list LucideGlyphPart)
  (param program (list Coord))
  (let parts (call (of List LucideGlyphPart)))
  (let cursor Index 0)
  (while (< cursor (. program length))
    (let kind (as ([] program cursor) U32 LucideGlyphShape))
    (let is-filled (!= ([] program (+ cursor 1)) 0))
    (+= cursor 2)
    (match kind
      (case= (. LucideGlyphShape path)
        (let limit (+ cursor 2 (as ([] program (+ cursor 1)) Index)))
        (+= parts
          (call LucideGlyphPart
            (block
              (arg (call VectorPath (call lucide-glyph-ops program (+ cursor 2) limit (as ([] program cursor) Size))))
              (arg is-filled)
            )
          )
        )
        (= cursor limit)
      )
      (case= (. LucideGlyphShape circle)
        (+= parts
          (call LucideGlyphPart
            (block
              (arg (call Circle (call Point ([] program cursor) ([] program (+ cursor 1))) ([] program (+ cursor 2))))
              (arg is-filled)
            )
          )
        )
        (+= cursor 3)
      )
      (case= (. LucideGlyphShape ellipse)
        (let center (call Point ([] program cursor) ([] program (+ cursor 1))))
        (+= parts
          (call LucideGlyphPart
            (block
              (arg (call Ellipse center (call Dimensions ([] program (+ cursor 2)) ([] program (+ cursor 3)))))
              (arg is-filled)
            )
          )
        )
        (+= cursor 4)
      )
      (case= (. LucideGlyphShape line)
        (let from (call Point ([] program cursor) ([] program (+ cursor 1))))
        (+= parts
          (call LucideGlyphPart
            (block
              (arg (call Line from (call Point ([] program (+ cursor 2)) ([] program (+ cursor 3)))))
              (arg is-filled)
            )
          )
        )
        (+= cursor 4)
      )
      (case= (. LucideGlyphShape rectangle)
        (let bounds
          (call Rect
            (block
              (arg ([] program cursor))
              (arg ([] program (+ cursor 1)))
              (arg ([] program (+ cursor 2)))
              (arg ([] program (+ cursor 3)))
            )
          )
        )
        (+= parts (call LucideGlyphPart (call Rectangle bounds) is-filled))
        (+= cursor 4)
      )
    )
  )
  (return parts)
)

(fn-do _ lucide-glyph-ops (list PathOp)
  (param program (list Coord))
  (param start Index)
  (param limit Index)
  (param count Size)
  (let ops (list PathOp))
  (call (. ops reserve) count)
  (let cursor start)
  (while (< cursor limit)
    (match (as ([] program cursor) U32 LucideGlyphOp)
      (case= (. LucideGlyphOp move-to)
        (+= ops (call M ([] program (+ cursor 1)) ([] program (+ cursor 2))))
        (+= cursor 3)
      )
      (case= (. LucideGlyphOp line-to)
        (+= ops (call L ([] program (+ cursor 1)) ([] program (+ cursor 2))))
        (+= cursor 3)
      )
      (case= (. LucideGlyphOp cubic-to)
        (+= ops
          (call C
            (block
              (arg ([] program (+ cursor 1)))
              (arg ([] program (+ cursor 2)))
              (arg ([] program (+ cursor 3)))
              (arg ([] program (+ cursor 4)))
              (arg ([] program (+ cursor 5)))
              (arg ([] program (+ cursor 6)))
            )
          )
        )
        (+= cursor 7)
      )
      (case= (. LucideGlyphOp quadratic-to)
        (+= ops
          (call Q
            (block
              (arg ([] program (+ cursor 1)))
              (arg ([] program (+ cursor 2)))
              (arg ([] program (+ cursor 3)))
              (arg ([] program (+ cursor 4)))
            )
          )
        )
        (+= cursor 5)
      )
      (case= (. LucideGlyphOp arc-to)
        (+= ops
          (call A
            (block
              (arg ([] program (+ cursor 1)))
              (arg ([] program (+ cursor 2)))
              (arg ([] program (+ cursor 3)))
              (arg (!= ([] program (+ cursor 4)) 0))
              (arg (!= ([] program (+ cursor 5)) 0))
              (arg ([] program (+ cursor 6)))
              (arg ([] program (+ cursor 7)))
            )
          )
        )
        (+= cursor 8)
      )
      (case= (. LucideGlyphOp close)
        (+= ops (call Z))
        (+= cursor 1)
      )
    )
  )
  (return ops)
)

(fn-do _ lucide-glyph-path-data String
  (param program (list Coord))
  (param start Index)
  (param limit Index)
  (let parts (call (of List String)))
  (let cursor start)
  (while (< cursor limit)
    (match (as ([] program cursor) U32 LucideGlyphOp)
      (case= (. LucideGlyphOp move-to)
        (+= parts
          (paragraph
            (str "M" (call lucide-glyph-number ([] program (+ cursor 1))) " " (call lucide-glyph-number ([] program (+ cursor 2))))
          )
        )
        (+= cursor 3)
      )
      (case= (. LucideGlyphOp line-to)
        (+= parts
          (paragraph
            (str "L" (call lucide-glyph-number ([] program (+ cursor 1))) " " (call lucide-glyph-number ([] program (+ cursor 2))))
          )
        )
        (+= cursor 3)
      )
      (case= (. LucideGlyphOp cubic-to)
        (+= parts (str "C" (call lucide-glyph-coords program (+ cursor 1) 6)))
        (+= cursor 7)
      )
      (case= (. LucideGlyphOp quadratic-to)
        (+= parts (str "Q" (call lucide-glyph-coords program (+ cursor 1) 4)))
        (+= cursor 5)
      )
      (case= (. LucideGlyphOp arc-to)
        (+= parts (str "A" (call lucide-glyph-coords program (+ cursor 1) 7)))
        (+= cursor 8)
      )
      (case= (. LucideGlyphOp close)
        (+= parts "Z")
        (+= cursor 1)
      )
    )
  )
  (return (call (. "" join) parts))
)

(fn-expr _ lucide-glyph-coords String
  (param program (list Coord))
  (param start Index)
  (param count Size)
  (call (. " " join) (call (of List String) (in (call lucide-glyph-number ([] program (+ start each))) (..< 0 count))))
)
