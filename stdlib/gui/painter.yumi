painter.paint(node, rect, canvas)

━━━━━━━━━━━━━━━━━━━━
+ do paint-default-background
    - node Box
    - rect Rect
    - canvas Canvas

=? if rect.width <= 0 || rect.height <= 0
. color = node.$background-color
. fill = node.$background-fill
. image = node.$background-image
=? if !color && !fill && !image
. area = node.$shape?.extent(node, rect) ?? rect
if color || fill
    do use canvas.saved-state
        canvas.fill-color = color
        canvas.shape-fill = fill
        canvas.stroke-color = null
        canvas.rect(area)
if image
    paint-background-image(node, image, area, canvas)

━━━━━━━━━━━━━━━━━━━━
+ do paint-background-image
    - node Box
    - image Image
    - area Rect
    - canvas Canvas

=? if image.is-released
. tile = image-fit-rect
    - image.size
    - area
    - node.$background-fit
    - node.$background-align-x
    - node.$background-align-y
=? if tile.width <= 0 || tile.height <= 0
. repeat = node.$background-repeat
. visible = image-repeat-rect(area, tile, repeat)
=? if visible.width <= 0 || visible.height <= 0
. sampling = node.$background-sampling
if repeat != ImageRepeat.none
    image.fill • destination canvas
        - visible
        - tile
        - sampling
else if visible == tile
    image.draw • destination canvas
        - tile
        - sampling
else
    do use canvas.saved-state
        canvas.clip(visible)
        image.draw • destination canvas
            - tile
            - sampling
