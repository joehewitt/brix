━━━━━━━━━━━━━━━━━━━━
+ BevelPainter is Painter

+ edge RGBA
+ sheen RGBA
+ bounce RGBA
+ rim RGBA
+ gloss RGBA

────────────────────
+ This
    - edge
    - sheen = transparent
    - bounce = transparent
    - rim = transparent
    - gloss = transparent

────────────────────
+ get clips-to-shape

false

────────────────────
+ do paint
    - node Box
    - rect Rect
    - canvas Canvas

. width = node.effective-border-widths.top
. face = rect.pad(width)
=? if face.width <= 0 || face.height <= 0
. radius = node.effective-corner-radius
. outer = bevel-outline(rect, radius)
do use canvas.saved-state
    outer.clip(canvas)
    paint-default-background(node, rect, canvas)
    paint-bevel-fill
        - face
        - bevel-mirror(face.top-center, face.bottom-center, face.height, bevel-glow, sheen, bounce)
        - canvas
. half = width / 2
paint-bevel-ring
    - outer
    - bevel-outline(rect.pad(half), radius - half)
    - LinearGradient
        - rect.top-center
        - rect.bottom-center
        - [GradientStop(0%, rim), GradientStop(100%, rim)]
    - canvas
paint-bevel-shader(rect, radius, gloss, bevel-gloss-shader, canvas)
paint-bevel-shader(rect, radius, edge, bevel-edge-shader, canvas)

━━━━━━━━━━━━━━━━━━━━
_ bevel-outline RoundedRect
    - rect Rect
    - radius Length

RoundedRect(rect, max(0, radius), max(0, radius), max(0, radius), max(0, radius))

━━━━━━━━━━━━━━━━━━━━
_ do bevel-mirror LinearGradient
    - start Point
    - end Point
    - extent Length
    - profile [(Length, Float)]
    - near RGBA
    - far RGBA

. stops = List'GradientStop()
for (reach, strength) in profile
    . at Ratio = min(0.5, reach / extent)
    stops += GradientStop(at, near.with-alpha(near.alpha * strength))
for (reach, strength) in profile.reversed()
    . at Ratio = max(0.5, 1 - reach / extent)
    stops += GradientStop(at, far.with-alpha(far.alpha * strength))
= LinearGradient(start, end, stops)

━━━━━━━━━━━━━━━━━━━━
_ do paint-bevel-shader
    - rect Rect
    - radius Length
    - color RGBA
    - shader Shader
    - canvas Canvas

=? if color.alpha <= 0
. pixel = if gui-pixel-scale > 0 then 1 / gui-pixel-scale else 0.5
canvas.fill-shader(rect, shader, [radius, pixel, color.red, color.green, color.blue, color.alpha])

━━━━━━━━━━━━━━━━━━━━
_ ¶ bevel-shape-source

float2 bevelNormal(float2 position, float2 size, float radius, thread float& depth) {
    float2 extent = size * 0.5;
    float2 q = abs(position - extent) - (extent - radius);
    float2 corner = max(q, 0.0);
    float span = length(corner);
    depth = radius - span - min(max(q.x, q.y), 0.0);
    if (span > 0.0001) {
        return corner / span;
    }
    return q.x > q.y ? float2(1.0, 0.0) : float2(0.0, 1.0);
}

━━━━━━━━━━━━━━━━━━━━
_ ¶ bevel-gloss-source

float4 shade(float2 position, float2 size, ShaderArgs args) {
    float depth;
    float2 normal = bevelNormal(position, size, args[0], depth);
    float cover = saturate(0.5 + depth / args[1]);
    float spread = max(depth - 0.25, 0.0) / 0.22;
    float outer = cover * pow(normal.y, 5.0) / (1.0 + spread * spread);
    float band = (depth - 0.67) / 0.27;
    float inner = 0.53 * normal.y * exp(-0.5 * band * band);
    return float4(brixDecodeSRGB(float3(args[2], args[3], args[4])), args[5] * saturate(outer + inner));
}

━━━━━━━━━━━━━━━━━━━━
_ ¶ bevel-edge-source

float4 shade(float2 position, float2 size, ShaderArgs args) {
    float depth;
    float2 normal = bevelNormal(position, size, args[0], depth);
    float band = (depth - 0.2) / 0.255;
    float strength = pow(normal.x, 1.5) * exp(-0.5 * band * band);
    return float4(brixDecodeSRGB(float3(args[2], args[3], args[4])), args[5] * saturate(strength));
}

━━━━━━━━━━━━━━━━━━━━
_ do paint-bevel-fill
    - rect Rect
    - gradient LinearGradient
    - canvas Canvas

=? if all(gradient.stops) • where each.color.alpha <= 0
canvas.fill-gradient(rect, gradient)

━━━━━━━━━━━━━━━━━━━━
_ do paint-bevel-ring
    - outer RoundedRect
    - inner RoundedRect
    - gradient LinearGradient
    - canvas Canvas

=? if all(gradient.stops) • where each.color.alpha <= 0
do use canvas.saved-state
    canvas.begin()
    outer.outline(canvas)
    inner.outline(canvas)
    canvas.clip-path(FillRule.even-odd)
    paint-bevel-fill(outer.bounds, gradient, canvas)

