_ bevel-glow [(Length, Float)] = [(0, 1), (1, 0.6), (1.5, 0.45), (2, 0.35), (3, 0.2), (4, 0.15), (5, 0.1), (6, 0.05), (7, 0)]
_ bevel-gloss-shader := Shader("${bevel-shape-source()}\n${bevel-gloss-source()}")
_ bevel-edge-shader := Shader("${bevel-shape-source()}\n${bevel-edge-source()}")

