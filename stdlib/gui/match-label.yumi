━━━━━━━━━━━━━━━━━━━━
+ MatchSpan is Tuple

+ start Size
+ end Size

━━━━━━━━━━━━━━━━━━━━
+ do match-spans [MatchSpan]
    - positions [Index]
    - offset Index = 0

. spans [MatchSpan]
. index Index = 0
while index < positions.length
    . start = positions[index]
    . end = start + 1
    index += 1
    while index < positions.length && positions[index] == end
        end += 1
        index += 1
    spans += MatchSpan(start - offset, end - offset)
= spans

━━━━━━━━━━━━━━━━━━━━
+ MatchLabel is Text

+ text String = ""
+ hits [MatchSpan] = List'MatchSpan()
+ pieces = match-label-pieces(#text, #hits)

────────────────────

<This
    for piece in #pieces keyed by piece.order
        <MatchLabelSpan
            text = piece.text
            is-hit = piece.is-hit

━━━━━━━━━━━━━━━━━━━━
+ MatchLabelSpan is Span

+ is-hit = false

━━━━━━━━━━━━━━━━━━━━
_ MatchPiece is Tuple

+ order Index
+ text String
+ is-hit Bool

━━━━━━━━━━━━━━━━━━━━
_ do match-label-pieces [MatchPiece]
    - text String
    - hits [MatchSpan]

. pieces [MatchPiece]
. bytes = byte-view(text)
. size = bytes.size
=? pieces if size == 0
. marks = Bool[size]
for hit in hits
    . end = if hit.end < size then hit.end else size
    for index in hit.start .. < end
        marks[index] = true
. cursor Index = 0
while cursor < size
    . finish = cursor + 1
    . is-hit = marks[cursor]
    while finish < size && utf8-is-continuation(bytes[finish])
        is-hit = is-hit || marks[finish]
        finish += 1
    for index in cursor .. < finish
        marks[index] = is-hit
    cursor = finish
. first Index = 0
for index in 1 .. < size + 1
    if index == size || marks[index] != marks[first]
        pieces += MatchPiece(pieces.length, bytes.slice-string(first .. < index), marks[first])
        first = index
= pieces
