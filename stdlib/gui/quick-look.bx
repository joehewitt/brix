(import ./box)
(import ./primitives)
(import ./window)
(import /BxAppleGUI/BxAppleGUI.h)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /os/path)

(type + QuickLookView (is Box)
  (rule This
    (= window-draggable false)
  )
  (blank)
  (prop + path (? Path))
  (prop + native (? Pointer))
  (blank)
  (depends path-changed path)
  (fn-do + mounted _
    (call (. super mounted))
    (let host-box window)
    (return-if (if (not host-box)))
    (blank)
    (let host-window (as host-box Window))
    (call (. host-window ensure-native))
    (let window-handle (. host-window native))
    (return-if (if (not window-handle)))
    (blank)
    (let made (call C:brixGuiQuickLookCreate window-handle))
    (return-if (if (== made (call Pointer))))
    (blank)
    (= native made)
    (call set-native-peer-artifact-required true)
    (call path-changed)
  )
  (fn-do + unmounted _
    (call (. super unmounted))
    (let peer native)
    (if peer
      (= native null)
      (call C:brixGuiQuickLookRelease peer)
    )
  )
  (fn-do + sync-native-geometry-self _
    (param native-origin Point)
    (param visible Bool)
    (param native-parent (? Pointer))
    (param transform (? Matrix))
    (let peer native)
    (return-if (if (not peer)))
    (blank)
    (let host window)
    (return-if (if (not host)))
    (blank)
    (let content content-bounds)
    (let zoom native-zoom)
    (call C:brixGuiPeerSetContainer (?? (. (as host Window) native) (call Pointer)) peer (?? native-parent (call Pointer)))
    (let corner (call native-placed-point (- (. content top-left) native-origin) native-origin transform))
    (let linear (?? transform (call Matrix)))
    (call C:brixGuiPeerSetFrame
      (block
        (arg peer)
        (arg (* (. corner x) zoom))
        (arg (* (. corner y) zoom))
        (arg (* (. content width) zoom))
        (arg (* (. content height) zoom))
        (arg (. linear a))
        (arg (. linear c))
        (arg (. linear b))
        (arg (. linear d))
      )
    )
    (let shown (and visible (> (. content width) 0) (> (. content height) 0) (call is-presentation-visible content)))
    (call C:brixGuiPeerSetVisible peer shown)
    (call C:brixGuiPeerSetOpacity peer effective-opacity)
  )
  (fn-do _ path-changed _
    (let peer native)
    (return-if (if (not peer)))
    (blank)
    (let target path)
    (if target
      (call C:brixGuiQuickLookSetPath peer (call native-path (as target String)))
      (else
        (call C:brixGuiQuickLookSetPath peer "")
      )
    )
  )
)
