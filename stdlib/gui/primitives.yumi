━━━━━━━━━━━━━━━━━━━━
+ cursor-style-native-value
    - style CursorStyle

match style
    | CursorStyle.automatic
        0u32
    | CursorStyle.arrow
        1u32
    | CursorStyle.pointing-hand
        2u32
    | CursorStyle.text
        3u32
    | CursorStyle.crosshair
        4u32
    | CursorStyle.move
        5u32
    | CursorStyle.open-hand
        6u32
    | CursorStyle.closed-hand
        7u32
    | CursorStyle.not-allowed
        8u32
    | CursorStyle.resize-horizontal
        9u32
    | CursorStyle.resize-vertical
        10u32
    | CursorStyle.hidden
        11u32
    | CursorStyle.resize-nwse
        12u32
    | CursorStyle.resize-nesw
        13u32
    | CursorStyle.rotate
        14u32
    | CursorStyle.custom
        15u32
    ??
        0u32

━━━━━━━━━━━━━━━━━━━━
+ cursor-style-native-image Pointer
    - style CursorStyle

match style
    | CursorStyle.custom(image)
        image.native
    ??
        Pointer()

