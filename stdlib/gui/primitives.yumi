━━━━━━━━━━━━━━━━━━━━
+ gui-safe-span
    - value Length

if is-finite(value) then max(0, value) else 0

━━━━━━━━━━━━━━━━━━━━
+ image-fit-rect Rect
    - natural Dimensions
    - bounds Rect
    - fit ImageFit
    - align-x AnchorPoint
    - align-y AnchorPoint

Rect
    - bounds.x + (bounds.width - size.width) * align-x.fraction
    - bounds.y + (bounds.height - size.height) * align-y.fraction
    - size.width
    - size.height

.. size = image-fit-size(natural, bounds, fit)

━━━━━━━━━━━━━━━━━━━━
+ image-fit-size Dimensions
    - natural Dimensions
    - bounds Rect
    - fit ImageFit

|? natural.width <= 0 || natural.height <= 0
    Dimensions(bounds.width, bounds.height)
??
    match fit
        | ImageFit.fill
            Dimensions(bounds.width, bounds.height)
        | ImageFit.none
            natural
        | ImageFit.cover
            Dimensions(natural.width * cover, natural.height * cover)
        | ImageFit.scale-down
            Dimensions(natural.width * min(1, contain), natural.height * min(1, contain))
        ??
            Dimensions(natural.width * contain, natural.height * contain)

.. scale-x = bounds.width / natural.width
.. scale-y = bounds.height / natural.height
.. contain = min(scale-x, scale-y)
.. cover = max(scale-x, scale-y)

━━━━━━━━━━━━━━━━━━━━
+ image-repeat-rect Rect
    - bounds Rect
    - tile Rect
    - repeat ImageRepeat

match repeat
    | ImageRepeat.x
        Rect(bounds.x, top, bounds.width, max(0, bottom - top))
    | ImageRepeat.y
        Rect(left, bounds.y, max(0, right - left), bounds.height)
    | ImageRepeat.both
        bounds
    ??
        Rect(left, top, max(0, right - left), max(0, bottom - top))

.. left = max(bounds.x, tile.x)
.. top = max(bounds.y, tile.y)
.. right = min(bounds.right, tile.right)
.. bottom = min(bounds.bottom, tile.bottom)
