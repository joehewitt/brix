+ thumb-length Length

━━━━━━━━━━━━━━━━━━━━
+ gui-scroll-consume-axis
    - position Length
    - minimum Length
    - maximum Length
    - delta Length

ScrollAxisConsumption(delta, actual, delta - actual)

.. next = min(maximum, max(minimum, position + delta))
.. actual = next - position

━━━━━━━━━━━━━━━━━━━━
+ gui-scroll-reveal-axis
    - position Length
    - minimum Length
    - maximum Length
    - viewport-start Length
    - viewport-length Length
    - interval-start Length
    - interval-length Length
    - leading-margin Length
    - trailing-margin Length
    - alignment ScrollAlignment

min(maximum, max(minimum, requested))

.. safe-viewport = gui-safe-span(viewport-length)
.. safe-interval = gui-safe-span(interval-length)
.. leading = interval-start - viewport-start - leading-margin
.. trailing = interval-start + safe-interval - viewport-start - safe-viewport + trailing-margin
.. requested = match alignment
    | ScrollAlignment.start
        leading
    | ScrollAlignment.center
        interval-start + safe-interval / 2 - viewport-start - safe-viewport / 2
    | ScrollAlignment.end
        trailing
    ??
        gui-scroll-nearest-position(position, leading, trailing, oversized)
.. oversized = safe-interval + leading-margin + trailing-margin > safe-viewport

━━━━━━━━━━━━━━━━━━━━
_ gui-scroll-nearest-position Length
    - position Length
    - leading Length
    - trailing Length
    - oversized Bool

|? oversized && position <= leading
    leading
|? oversized && position >= trailing
    trailing
|? oversized
    position
|? position > leading
    leading
|? position < trailing
    trailing
??
    position

━━━━━━━━━━━━━━━━━━━━
+ gui-scroll-indicator-outline
    - bounds Rect

Outline(bounds, min(bounds.width, bounds.height) / 2)

━━━━━━━━━━━━━━━━━━━━
+ gui-scroll-indicator-metrics
    - position Length
    - minimum Length
    - maximum Length
    - viewport Length
    - content Length
    - track-length Length
    - minimum-thumb-length Length

|? content <= 0 || maximum <= minimum
    ScrollIndicatorMetrics(0, safe-track)
??
    ScrollIndicatorMetrics(travel * progress, thumb-length)

.. safe-track = gui-safe-span(track-length)
.. fraction = min(1, gui-safe-span(viewport) / content)
.. thumb-length = min(safe-track, max(minimum-thumb-length, safe-track * fraction))
.. travel = safe-track - thumb-length
.. progress = min(1, max(0, (position - minimum) / (maximum - minimum)))

