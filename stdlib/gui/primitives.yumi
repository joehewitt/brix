./cursor-image
/graphics/outline
/graphics/point
/graphics/primitives
/math
/time/duration
/units

+ gui-scroll-indicator-linger = 800ms
+ gui-scroll-hover-hold = 300ms

+ AxisQuery is (mode AxisMeasureMode, min Length, available Length?, max Length?)
+ MeasureQuery is (inline AxisQuery, block AxisQuery)
+ PositionPin is (source AnchorPoint, target AnchorPoint)

