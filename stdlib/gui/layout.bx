(import ./box)
(import ./primitives)
(import /graphics/primitives)
(import /math)
(blank)
(prop + flex-col _ (= (call FlexLayout (. Orientation vertical))))
(prop + flex-row _ (= (call FlexLayout (. Orientation horizontal))))
(prop + flow-col _ (= (call FlowLayout (. Orientation vertical))))
(prop + flow-row _ (= (call FlowLayout (. Orientation horizontal))))
(blank)
(prop _ gui-flex-scratch-stack (list GUIFlexScratch))

(type + LayoutArrangeHint (is U8)
  (variant full (= 0))
  (variant children-only (= 1))
)

(type + Layout
  (fn-do + arrange-box _
    (param box Box)
    (param hint LayoutArrangeHint (= (. LayoutArrangeHint full)))
  )
  (fn-do + child-content-size-invalidated _
    (param box Box)
    (param child Box)
  )
  (fn-expr + preserves-positioned-children-on-children-only _ :get
    false
  )
  (fn-expr + sequence-axis (? Orientation) :get
    null
  )
  (fn-expr + measure-content _
    (param box Box)
    (param query MeasureQuery)
    (call Dimensions 0 0)
  )
  (fn-expr + carry-slot (? Index)
    (param box Box)
    (param child Box)
    null
  )
)

(type + FlexLayout (is Layout)
  (prop + orient Orientation)
  (fn-do + This _
    (param orient _)
  )
  (fn-do + arrange-box _
    (param box Box)
    (param hint LayoutArrangeHint (= (. LayoutArrangeHint full)))
    (probe-count gui.layout.builtin.arrange-fast)
    (if (== hint (. LayoutArrangeHint children-only))
      (return-if (if (and (. box has-rigid-flex-children) (not (. box carried-child)) (call arrange-flex-stack-incremental box))))
      (call arrange-flex-content box)
      (call (. box arrange-positioned-children))
      (return)
    )
    (call arrange-flex-content box)
  )
  (fn-do + child-content-size-invalidated _
    (param box Box)
    (param child Box)
    (return-if (if (. box $is-active-list-invalid)))
    (if (not (call (. child participates-in-parent-layout) box))
      (call (. box invalidate-layout))
      (return)
    )
    (call (. box retain-indexed-dirty-layout-child) child)
  )
  (fn-expr + preserves-positioned-children-on-children-only _ :get
    true
  )
  (fn-expr + sequence-axis _ :get
    orient
  )
  (fn-expr + measure-content _
    (param box Box)
    (param query MeasureQuery)
    (call gui-flex-natural-size box orient query (. box computed-gap))
  )
  (fn-expr + carry-slot (? Index)
    (param box Box)
    (param child Box)
    (call gui-carry-slot box child orient)
  )
  (fn-do _ arrange-flex-content _
    (param box Box)
    (let content (. box content-bounds))
    (let available (call gui-main-size (. content size) orient))
    (let query (call (. box child-layout-query)))
    (let scratch GUIFlexScratch (call acquire-gui-flex-scratch))
    (let coupled (== (. box $stack-motion) (. StackMotion coupled)))
    (blank)
    (let order (call gui-carried-order box))
    (if order
      (for (in live order)
        (call gather-flex-child scratch live query coupled false)
      )
      (else
        (let child (. box first-active-child))
        (let whole (and (not coupled) (not (. box has-spaced-children))))
        (let spaced false)
        (while child
          (let live child)
          (= child (. live next-active-sibling))
          (if (not whole)
            (if (. live is-released)
              (= spaced true)
              (continue)
            )
            (= spaced (or spaced (< (. live layout-space) 1)))
          )
          (call gather-flex-child scratch live query coupled whole)
        )
        (if (and (not whole) (not spaced))
          (= (. box has-spaced-children) false)
        )
      )
    )
    (let fixed (. scratch fixed))
    (let total-flex (. scratch total-flex))
    (blank)
    (let gap (. box computed-gap))
    (let gaps Length 0)
    (if (. scratch is-uniform)
      (if (> (. scratch children length) 1)
        (= gaps (* gap (- (. scratch children length) 1)))
      )
      (else
        (let reach Float)
        (for (in space (. scratch spaces))
          (+= gaps (* gap space reach))
          (= reach (call max reach space))
        )
      )
    )
    (+= fixed gaps)
    (if (> fixed available)
      (-= fixed (call gui-flex-shrink scratch (- fixed available) orient available))
    )
    (let remaining (call gui-safe-span (- available fixed)))
    (while (> total-flex 0)
      (let clamped-one false)
      (for (in index (..< 0 (. scratch children length)))
        (if (not ([] (. scratch flexible) index))
          (continue)
        )
        (let live ([] (. scratch children) index))
        (let weight ([] (. scratch weights) index))
        (let proposed (/ (* remaining weight) total-flex))
        (let margin ([] (. scratch margins) index))
        (let proposed-outer (+ proposed margin))
        (let constrained-outer (call (. live constrained-outer-main-size) proposed-outer orient available))
        (if (!= constrained-outer proposed-outer)
          (let constrained (call gui-safe-span (- constrained-outer margin)))
          (let space (call (. scratch space-at) index))
          (let taken
            (scope (if-expr (and (< space 1) (> constrained proposed)) scaled constrained)
              (lazy scaled (call max proposed (* constrained space)))
            )
          )
          (= ([] (. scratch allocations) index) constrained)
          (= ([] (. scratch flexible) index) false)
          (if (< space 1)
            (= ([] (. scratch shares) index) (call gui-flex-footprint constrained taken margin space))
          )
          (= remaining (call gui-safe-span (- remaining taken)))
          (-= total-flex weight)
          (= clamped-one true)
        )
      )
      (if (not clamped-one)
        (break)
      )
    )
    (blank)
    (let allocated-flex Length 0)
    (let last-flex (? Index))
    (if (> total-flex 0)
      (for (in index (..< 0 (. scratch children length)))
        (if ([] (. scratch flexible) index)
          (= last-flex index)
        )
      )
    )
    (blank)
    (for (in index (..< 0 (. scratch children length)))
      (if ([] (. scratch flexible) index)
        (let weight ([] (. scratch weights) index))
        (let allocation (/ (* remaining weight) total-flex))
        (if (and last-flex (== index last-flex))
          (= allocation (- remaining allocated-flex))
        )
        (= ([] (. scratch allocations) index) (call gui-safe-span allocation))
        (+= allocated-flex ([] (. scratch allocations) index))
        (let space (call (. scratch space-at) index))
        (if (< space 1)
          (let span ([] (. scratch allocations) index))
          (= ([] (. scratch shares) index) (call gui-flex-footprint span span ([] (. scratch margins) index) space))
        )
      )
    )
    (blank)
    (if coupled
      (let horizontal (== orient (. Orientation horizontal)))
      (for (in index (..< 0 (. scratch children length)))
        (if (and (> ([] (. scratch weights) index) 0) (== (call (. scratch space-at) index) 1))
          (let outer (+ ([] (. scratch allocations) index) ([] (. scratch margins) index)))
          (call (. scratch set-share) index (call (. ([] (. scratch children) index) presented-share) outer horizontal))
        )
      )
    )
    (blank)
    (let count (. scratch children length))
    (let used Length 0)
    (for (in index (..< 0 count))
      (if (<= ([] (. scratch weights) index) 0)
        (+= used (* (call gui-main-size ([] (. scratch measures) index) orient) (call (. scratch share-at) index)))
        (else
          (+= used (* (+ ([] (. scratch allocations) index) ([] (. scratch margins) index)) (call (. scratch share-at) index)))
        )
      )
    )
    (+= used gaps)
    (let spacing (call gui-flex-justify-spacing (. box $justify) (call gui-safe-span (- available used)) count))
    (let offset (. spacing lead))
    (let cross-size Length 0)
    (let has-baseline false)
    (let rigid (and (not coupled) (not order) (. scratch is-uniform) (== (. box $justify) (. Justify start))))
    (let reach Float)
    (for (in index (..< 0 count))
      (let live ([] (. scratch children) index))
      (let space (call (. scratch space-at) index))
      (if (> index 0)
        (+= offset (+ (* gap space reach) (. spacing between)))
      )
      (= reach (call max reach space))
      (let size ([] (. scratch allocations) index))
      (let is-flexible (> ([] (. scratch weights) index) 0))
      (if is-flexible
        (+= size ([] (. scratch margins) index))
        (else
          (= size (call gui-main-size ([] (. scratch measures) index) orient))
        )
      )
      (probe-count gui.layout.arrange.children-arranged)
      (let align (call flex-child-align box live))
      (let child-query query)
      (if (or is-flexible (> ([] (. scratch shrinks) index) 0))
        (= rigid false)
        (if (== orient (. Orientation horizontal))
          (= child-query
            (call MeasureQuery
              (block
                (arg (if-expr is-flexible (call exact-axis-query size) (call fit-axis-query size)))
                (arg (. query block))
              )
            )
          )
          (call (. live flow-measure) child-query)
        )
      )
      (if (== orient (. Orientation horizontal))
        (= has-baseline (or has-baseline (== align (. Alignment first-baseline))))
      )
      (let rect
        (call place-flex-child
          (block
            (arg live)
            (arg content)
            (arg child-query)
            (arg ([] (. scratch measures) index))
            (arg offset)
            (arg size)
            (arg align)
          )
        )
      )
      (= cross-size (call max cross-size (call flex-cross-extent content rect)))
      (+= offset (* size (call (. scratch share-at) index)))
    )
    (blank)
    (= (. box has-rigid-flex-children) (and rigid (not has-baseline)))
    (if has-baseline
      (= cross-size (call max cross-size (call gui-flex-align-baselines box (. scratch children) (. content y))))
    )
    (blank)
    (if (== orient (. Orientation horizontal))
      (= (. box inner-width) offset)
      (= (. box inner-height) cross-size)
      (else
        (= (. box inner-width) cross-size)
        (= (. box inner-height) offset)
      )
    )
    (blank)
    (call (. scratch clear))
    (+= gui-flex-scratch-stack scratch)
  )
  (fn-do _ gather-flex-child _ @inline
    (param scratch GUIFlexScratch)
    (param live Box)
    (param query MeasureQuery)
    (param coupled Bool)
    (param whole Bool)
    (probe-count gui.layout.arrange.children-considered)
    (let space (if-expr whole 1.0 (. live layout-space)))
    (let weight (* (call gui-flex-weight (. live $flex)) space))
    (let margin (call gui-main-inset-size (. live margin-edges) orient))
    (let size (call Dimensions 0 0))
    (let share space)
    (if (> weight 0)
      (+= (. scratch total-flex) weight)
      (+= (. scratch fixed) (* margin space))
      (if (not whole)
        (call (. live place-flexibly))
      )
      (else
        (= size (. (call (. live flow-measure) query) outer-size))
        (if (not whole)
          (= share
            (call (. live layout-share)
              (block
                (arg (call gui-main-size size orient))
                (arg (== orient (. Orientation horizontal)))
                (arg coupled)
              )
            )
          )
        )
        (+= (. scratch fixed) (* (call gui-main-size size orient) share))
      )
    )
    (if (not whole)
      (call (. scratch add-space) space share)
    )
    (+= (. scratch children) live)
    (+= (. scratch weights) weight)
    (+= (. scratch margins) margin)
    (+= (. scratch measures) size)
    (+= (. scratch allocations) 0)
    (+= (. scratch flexible) (> weight 0))
    (+= (. scratch shrinks) (if-expr (> weight 0) 0.0 (call gui-flex-weight (. live $shrink))))
  )
  (fn-expr _ flex-child-align Alignment
    (param box Box)
    (param live Box)
    (case? (== orient (. Orientation horizontal))
      (?? (. live $align-y) (. box $align-children))
    )
    (default
      (?? (. live $align-x) (. box $align-children))
    )
  )
  (fn-expr _ flex-cross-extent Length
    (param content Rect)
    (param rect Rect)
    (case? (== orient (. Orientation horizontal))
      (call max (. content height) (- (. rect bottom) (. content y)))
    )
    (default
      (call max (. content width) (- (. rect right) (. content x)))
    )
  )
  (fn-expr _ flex-main-start Length
    (param child Box)
    (if-expr (== orient (. Orientation horizontal)) (. bounds left) (. bounds top))
    (where
      (lazy bounds (. child outer-bounds))
    )
  )
  (fn-do _ place-flex-child Rect
    (param live Box)
    (param content Rect)
    (param query MeasureQuery)
    (param measured Dimensions)
    (param offset Length)
    (param size Length)
    (param align Alignment)
    (if (== orient (. Orientation horizontal))
      (let stretched (call gui-flex-stretched-cross live (. content height) (. Orientation vertical) measured))
      (let cross (call gui-flex-cross-axis live (. content y) (. content height) stretched query orient align))
      (let rect (call Rect (+ (. content x) offset) (. cross start) size (. cross span)))
      (call (. live arrange-outer-bounds) rect)
      (return rect)
    )
    (let stretched (call gui-flex-stretched-cross live (. content width) (. Orientation horizontal) measured))
    (let cross (call gui-flex-cross-axis live (. content x) (. content width) stretched query orient align))
    (let rect (call Rect (. cross start) (+ (. content y) offset) (. cross span) size))
    (call (. live arrange-outer-bounds) rect)
    (return rect)
  )
  (fn-do _ arrange-flex-stack-incremental Bool
    (param box Box)
    (let indexed-dirty (. box indexed-dirty-layout-children))
    (if indexed-dirty
      (let dirty indexed-dirty)
      (let first-dirty ([] dirty 0))
      (let last-dirty first-dirty)
      (let first-start (call flex-main-start first-dirty))
      (let last-start first-start)
      (let ambiguous-order false)
      (for (in index (..< 1 (. dirty length)))
        (let candidate ([] dirty index))
        (let candidate-start (call flex-main-start candidate))
        (if (< candidate-start first-start)
          (= first-dirty candidate)
          (= first-start candidate-start)
          (else-if (and (== candidate-start first-start) (!= (as candidate Pointer) (as first-dirty Pointer)))
            (= ambiguous-order true)
          )
        )
        (if (> candidate-start last-start)
          (= last-dirty candidate)
          (= last-start candidate-start)
          (else-if (and (== candidate-start last-start) (!= (as candidate Pointer) (as last-dirty Pointer)))
            (= ambiguous-order true)
          )
        )
      )
      (if (not ambiguous-order)
        (probe-count gui.layout.arrange.indexed-dirty-ranges)
        (return (call arrange-flex-stack-range box first-dirty last-dirty))
      )
      (probe-count gui.layout.arrange.fallback.indexed-order)
    )
    (blank)
    (let query (call (. box child-layout-query)))
    (let first-dirty (? Box))
    (let last-dirty (? Box))
    (let child (. box first-active-child))
    (while child
      (let live child)
      (probe-count gui.layout.arrange.children-considered)
      (if (not (call (. live has-last-measure-result) query))
        (probe-count gui.layout.arrange.fallback.no-child-history)
        (return false)
      )
      (if (. live $is-layout-invalid)
        (if (not first-dirty)
          (= first-dirty live)
        )
        (= last-dirty live)
      )
      (= child (. live next-active-sibling))
    )
    (blank)
    (if (not first-dirty)
      (probe-count gui.layout.arrange.fallback.no-candidate)
      (return false)
    )
    (return (call arrange-flex-stack-range box first-dirty (!! last-dirty)))
  )
  (fn-do _ arrange-flex-stack-range Bool
    (param box Box)
    (param first-dirty Box)
    (param last-dirty Box)
    (return-if false (if (or (not (call (. first-dirty participates-in-parent-layout) box)) last-outside)))
    (lazy last-outside (not (call (. last-dirty participates-in-parent-layout) box)))
    (if (not (. first-dirty has-arrangement))
      (probe-count gui.layout.arrange.fallback.unarranged)
      (return false)
    )
    (let content (. box content-bounds))
    (let query (call (. box child-layout-query)))
    (let gap (. box computed-gap))
    (let horizontal (== orient (. Orientation horizontal)))
    (let start (call flex-main-start first-dirty))
    (let offset (if-expr horizontal (- start (. content x)) (- start (. content y))))
    (let retained-cross (if-expr horizontal (. box inner-height) (. box inner-width)))
    (let cross-size retained-cross)
    (let recompute-cross false)
    (let passed-dirty-range false)
    (let end offset)
    (let child (? Box) first-dirty)
    (blank)
    (while child
      (let live child)
      (let next-child (. live next-active-sibling))
      (probe-count gui.layout.arrange.children-considered)
      (probe-count gui.layout.arrange.children-arranged)
      (if (not (call (. live has-last-measure-result) query))
        (probe-count gui.layout.arrange.fallback.no-child-history)
        (return false)
      )
      (return-if false (if (or (. live is-released) (!= (. live layout-space) 1))))
      (return-if false (if (or (> (call gui-flex-weight (. live $flex)) 0) (> (call gui-flex-weight (. live $shrink)) 0))))
      (let align (call flex-child-align box live))
      (return-if false (if (and horizontal (== align (. Alignment first-baseline)))))
      (let previous (. live outer-bounds))
      (let previous-extent (call flex-cross-extent content previous))
      (let measured (. (call (. live flow-measure) query) outer-size))
      (let size (call gui-main-size measured orient))
      (let rect (call place-flex-child live content query measured offset size align))
      (call (. live effective-position settle) box live)
      (let extent (call flex-cross-extent content rect))
      (= cross-size (call max cross-size extent))
      (if (and (>= previous-extent retained-cross) (< extent previous-extent))
        (= recompute-cross true)
      )
      (= end (+ offset size))
      (= offset (+ end gap))
      (blank)
      (if (== (as live Pointer) (as last-dirty Pointer))
        (= passed-dirty-range true)
      )
      (if (and passed-dirty-range (== rect previous))
        (call settle-flex-stack-cross box content cross-size recompute-cross)
        (probe-count gui.layout.arrange.early-outs)
        (return true)
      )
      (blank)
      (= child next-child)
    )
    (blank)
    (if horizontal
      (= (. box inner-width) end)
      (else
        (= (. box inner-height) end)
      )
    )
    (call settle-flex-stack-cross box content cross-size recompute-cross)
    (probe-count gui.layout.arrange.early-outs)
    (return true)
  )
  (fn-do _ settle-flex-stack-cross _
    (param box Box)
    (param content Rect)
    (param cross-size Length)
    (param recompute Bool)
    (let size cross-size)
    (if recompute
      (= size 0)
      (let child (. box first-active-child))
      (while child
        (let live child)
        (probe-count gui.layout.arrange.children-considered)
        (= size (call max size (call flex-cross-extent content (. live outer-bounds))))
        (= child (. live next-active-sibling))
      )
    )
    (if (== orient (. Orientation horizontal))
      (= (. box inner-height) size)
      (else
        (= (. box inner-width) size)
      )
    )
  )
)

(fn-expr _ gui-flex-footprint Float
  (param span Length)
  (param taken Length)
  (param margin Length)
  (param space Float)
  (if-expr (> outer 0) (/ (+ taken (* margin space)) outer) 0.0)
  (where
    (lazy outer (+ span margin))
  )
)

(type + FlowLayout (is Layout)
  (prop + orient Orientation)
  (fn-do + This _
    (param orient _)
  )
  (fn-do + arrange-box _
    (param box Box)
    (param hint LayoutArrangeHint (= (. LayoutArrangeHint full)))
    (probe-count gui.layout.builtin.arrange-fast)
    (if (and (== hint (. LayoutArrangeHint children-only)) (not (. box carried-child)))
      (return-if (if (call arrange-flow-content-incremental box)))
    )
    (call arrange-flow-content box)
  )
  (fn-do + child-content-size-invalidated _
    (param box Box)
    (param child Box)
    (return-if (if (. box $is-active-list-invalid)))
    (if (not (call (. child participates-in-parent-layout) box))
      (call (. box invalidate-layout))
      (return)
    )
    (call (. box retain-indexed-dirty-layout-child) child)
  )
  (fn-expr + preserves-positioned-children-on-children-only _ :get
    true
  )
  (fn-expr + sequence-axis _ :get
    orient
  )
  (fn-expr + measure-content _
    (param box Box)
    (param query MeasureQuery)
    (call gui-layout-natural-size box orient query 0)
  )
  (fn-expr + carry-slot (? Index)
    (param box Box)
    (param child Box)
    (call gui-carry-slot box child orient)
  )
  (fn-do _ arrange-flow-content _
    (param box Box)
    (let offset Length 0)
    (let cross-size Length 0)
    (let content (. box content-bounds))
    (let query (call (. box child-layout-query)))
    (let coupled (== (. box $stack-motion) (. StackMotion coupled)))
    (let order (call gui-carried-order box))
    (if order
      (for (in live order)
        (let step (call flow-place live content query coupled offset))
        (+= offset (. step width))
        (= cross-size (call max cross-size (. step height)))
      )
      (else
        (let child (. box first-active-child))
        (while child
          (let live child)
          (= child (. live next-active-sibling))
          (probe-count gui.layout.arrange.children-considered)
          (probe-count gui.layout.arrange.children-arranged)
          (if (not (. live is-released))
            (let step (call flow-place live content query coupled offset))
            (+= offset (. step width))
            (= cross-size (call max cross-size (. step height)))
          )
        )
      )
    )
    (blank)
    (if (== orient (. Orientation horizontal))
      (= (. box inner-width) offset)
      (= (. box inner-height) cross-size)
      (else
        (= (. box inner-width) cross-size)
        (= (. box inner-height) offset)
      )
    )
  )
  (fn-do _ flow-place Dimensions
    (param live Box)
    (param content Rect)
    (param query MeasureQuery)
    (param coupled Bool)
    (param offset Length)
    (let intrinsic (. (call (. live flow-measure) query) outer-size))
    (if (== orient (. Orientation horizontal))
      (let share (call (. live layout-share) (. intrinsic width) true coupled))
      (call (. live arrange-outer-bounds)
        (block
          (arg (call Rect (+ (. content x) offset) (. content y) (. intrinsic width) (. intrinsic height)))
        )
      )
      (return (call Dimensions (* (. intrinsic width) share) (. intrinsic height)))
    )
    (let share (call (. live layout-share) (. intrinsic height) false coupled))
    (call (. live arrange-outer-bounds) (call Rect (. content x) (+ (. content y) offset) (. content width) (. intrinsic height)))
    (return (call Dimensions (* (. intrinsic height) share) (. intrinsic width)))
  )
  (fn-do _ arrange-flow-content-incremental _
    (param box Box)
    (let indexed-dirty (. box indexed-dirty-layout-children))
    (if indexed-dirty
      (let dirty indexed-dirty)
      (let first-dirty ([] dirty 0))
      (let last-dirty first-dirty)
      (let first-start (call flow-retained-main-start first-dirty))
      (let last-start first-start)
      (let ambiguous-order false)
      (for (in index (..< 1 (. dirty length)))
        (let candidate ([] dirty index))
        (let candidate-start (call flow-retained-main-start candidate))
        (if (< candidate-start first-start)
          (= first-dirty candidate)
          (= first-start candidate-start)
          (else-if (and (== candidate-start first-start) (!= (as candidate Pointer) (as first-dirty Pointer)))
            (= ambiguous-order true)
          )
        )
        (if (> candidate-start last-start)
          (= last-dirty candidate)
          (= last-start candidate-start)
          (else-if (and (== candidate-start last-start) (!= (as candidate Pointer) (as last-dirty Pointer)))
            (= ambiguous-order true)
          )
        )
      )
      (if (not ambiguous-order)
        (probe-count gui.layout.arrange.indexed-dirty-ranges)
        (return (call arrange-flow-dirty-range box first-dirty last-dirty))
      )
      (probe-count gui.layout.arrange.fallback.indexed-order)
    )
    (blank)
    (let query (call (. box child-layout-query)))
    (let first-dirty (? Box))
    (let last-dirty (? Box))
    (let has-history true)
    (let child (. box first-active-child))
    (while child
      (let live child)
      (probe-count gui.layout.arrange.children-considered)
      (if (not (call (. live has-last-measure-result) query))
        (= has-history false)
      )
      (if (. live $is-layout-invalid)
        (if (not first-dirty)
          (= first-dirty live)
        )
        (= last-dirty live)
      )
      (= child (. live next-active-sibling))
    )
    (blank)
    (if (not first-dirty)
      (probe-count gui.layout.arrange.fallback.no-candidate)
      (return false)
    )
    (if (not has-history)
      (probe-count gui.layout.arrange.fallback.no-child-history)
      (return false)
    )
    (return (call arrange-flow-dirty-range box first-dirty (!! last-dirty)))
  )
  (fn-expr _ flow-retained-main-start Length
    (param child Box)
    (if-expr (== orient (. Orientation horizontal)) (. bounds left) (. bounds top))
    (where
      (lazy bounds (. child outer-bounds))
    )
  )
  (fn-do _ arrange-flow-dirty-range _
    (param box Box)
    (param first-dirty Box)
    (param last-dirty Box)
    (let content (. box content-bounds))
    (let query (call (. box child-layout-query)))
    (return-if false (if (== (. box $stack-motion) (. StackMotion coupled))))
    (if (not (call (. first-dirty has-last-measure-result) query))
      (probe-count gui.layout.arrange.fallback.no-child-history)
      (return false)
    )
    (if (not (. first-dirty has-arrangement))
      (probe-count gui.layout.arrange.fallback.unarranged)
      (return false)
    )
    (blank)
    (let previous-first-bounds (. first-dirty outer-bounds))
    (let offset
      (block
        (case? (== orient (. Orientation horizontal))
          (- (. previous-first-bounds left) (. content x))
        )
        (default
          (- (. previous-first-bounds top) (. content y))
        )
      )
    )
    (blank)
    (let retained-cross (if-expr (== orient (. Orientation horizontal)) (. box inner-height) (. box inner-width)))
    (let cross-size retained-cross)
    (let recompute-cross false)
    (let passed-dirty-range false)
    (let child (? Box) first-dirty)
    (blank)
    (while child
      (let live child)
      (let next-child (. live next-active-sibling))
      (probe-count gui.layout.arrange.children-considered)
      (probe-count gui.layout.arrange.children-arranged)
      (if (not (call (. live has-last-measure-result) query))
        (probe-count gui.layout.arrange.fallback.no-child-history)
        (return false)
      )
      (return-if false (if (or (. live is-released) (!= (. live layout-space) 1))))
      (let previous-bounds (. live outer-bounds))
      (let previous-cross (call (. live last-measured-outer-cross-size) query orient))
      (let intrinsic (. (call (. live flow-measure) query) outer-size))
      (let intrinsic-cross
        (scope (if-expr is-horizontal (. intrinsic height) (. intrinsic width))
          (lazy is-horizontal (== orient (. Orientation horizontal)))
        )
      )
      (let rect
        (block
          (case? (== orient (. Orientation horizontal))
            (call Rect (+ (. content x) offset) (. content y) (. intrinsic width) (. intrinsic height))
          )
          (default
            (call Rect (. content x) (+ (. content y) offset) (. content width) (. intrinsic height))
          )
        )
      )
      (call (. live arrange-outer-bounds) rect)
      (blank)
      (if (== orient (. Orientation horizontal))
        (+= offset (. intrinsic width))
        (else
          (+= offset (. intrinsic height))
        )
      )
      (= cross-size (call max cross-size intrinsic-cross))
      (if (and (== previous-cross retained-cross) (< intrinsic-cross previous-cross))
        (= recompute-cross true)
      )
      (blank)
      (if (== (as live Pointer) (as last-dirty Pointer))
        (= passed-dirty-range true)
      )
      (if (and passed-dirty-range (== rect previous-bounds))
        (if recompute-cross
          (return-if false (if (not (call recompute-flow-cross-size box query))))
          (else-if (== orient (. Orientation horizontal))
            (= (. box inner-height) cross-size)
          )
          (else
            (= (. box inner-width) cross-size)
          )
        )
        (probe-count gui.layout.arrange.early-outs)
        (return true)
      )
      (blank)
      (= child next-child)
    )
    (blank)
    (if (== orient (. Orientation horizontal))
      (= (. box inner-width) offset)
      (else
        (= (. box inner-height) offset)
      )
    )
    (if recompute-cross
      (return-if false (if (not (call recompute-flow-cross-size box query))))
      (else-if (== orient (. Orientation horizontal))
        (= (. box inner-height) cross-size)
      )
      (else
        (= (. box inner-width) cross-size)
      )
    )
    (blank)
    (probe-count gui.layout.arrange.early-outs)
    (return true)
  )
  (fn-do _ recompute-flow-cross-size _
    (param box Box)
    (param query MeasureQuery)
    (let cross-size Length 0)
    (let child (. box first-active-child))
    (while child
      (let live child)
      (probe-count gui.layout.arrange.children-considered)
      (return-if false (if (not (call (. live has-last-measure-result) query))))
      (let intrinsic-cross (call (. live last-measured-outer-cross-size) query orient))
      (= cross-size (call max cross-size intrinsic-cross))
      (= child (. live next-active-sibling))
    )
    (if (== orient (. Orientation horizontal))
      (= (. box inner-height) cross-size)
      (else
        (= (. box inner-width) cross-size)
      )
    )
    (return true)
  )
)

(type + GridTrack (is Union)
  (variant auto)
  (variant fixed Length)
  (variant flex Float)
)

(type + GridFill (is Tuple)
  (prop + width Length)
  (prop + stretches _ (= true))
)

(type + GridLayout (is Layout)
  (prop + tracks (list GridTrack))
  (prop + min-track Length)
  (prop + fill (? GridFill))
  (prop + column-gap (? Length))
  (prop + row-gap (? Length))
  (fn-do + This _
    (param columns Size)
    (param min-track Length (= 0))
    (lazy tracks (call gui-grid-auto-tracks columns))
  )
  (fn-do + This _
    (param tracks (list GridTrack))
    (param min-track Length (= 0))
  )
  (fn-do + This _
    (param filling GridFill)
    (= fill filling)
  )
  (fn-do + arrange-box _
    (param box Box)
    (param hint LayoutArrangeHint (= (. LayoutArrangeHint full)))
    (let content (. box content-bounds))
    (let grid (call solve box (call (. box child-layout-query))))
    (let gap-x (?? column-gap (. box computed-gap)))
    (let gap-y (?? row-gap (. box computed-gap)))
    (let count (. grid widths length))
    (let y (. content y))
    (for (in row (..< 0 (. grid heights length)))
      (let x (. content x))
      (for (in column (..< 0 count))
        (let index (+ (* row count) column))
        (if (< index (. grid cells length))
          (let cell ([] (. grid cells) index))
          (let track (call Rect x y ([] (. grid widths) column) ([] (. grid heights) row)))
          (call (. cell arrange-outer-bounds) (call gui-grid-cell-rect cell track ([] (. grid sizes) index)))
        )
        (+= x (+ ([] (. grid widths) column) gap-x))
      )
      (+= y (+ ([] (. grid heights) row) gap-y))
    )
    (= (. box inner-width) (. grid width))
    (= (. box inner-height) (. grid height))
  )
  (fn-expr + measure-content _
    (param box Box)
    (param query MeasureQuery)
    (call Dimensions (. grid width) (. grid height))
    (where
      (lazy grid (call solve box (call (. box derived-child-measure-query) query)))
    )
  )
  (fn-do _ solve GUIGridSolution
    (param box Box)
    (param query MeasureQuery)
    (let grid (call GUIGridSolution))
    (let child (. box first-active-child))
    (while child
      (let live child)
      (+= (. grid cells) live)
      (= child (. live next-active-sibling))
    )
    (blank)
    (let gap-x (?? column-gap (. box computed-gap)))
    (let gap-y (?? row-gap (. box computed-gap)))
    (let available (. query inline available))
    (let shape (call resolved-tracks available (. grid cells length) gap-x))
    (let count (. shape length))
    (return-if grid (if (== count 0)))
    (blank)
    (let natural-query (call MeasureQuery (call fit-axis-query) (. query block)))
    (for (in column (..< 0 count))
      (let fixed (call gui-grid-fixed-width ([] shape column)))
      (let natural Length 0)
      (if (== fixed null)
        (let index column)
        (while (< index (. grid cells length))
          (= natural
            (call max
              (block
                (arg natural)
                (arg (call ceil (. (call (. ([] (. grid cells) index) flow-measure) natural-query) outer-size width)))
              )
            )
          )
          (+= index count)
        )
      )
      (+= (. grid widths) (?? fixed natural))
    )
    (blank)
    (let gaps (* gap-x (- count 1)))
    (if (!= available null)
      (call fit-tracks shape (. grid widths) (call gui-safe-span (- available gaps)))
    )
    (blank)
    (let rows (/ (- (+ (. grid cells length) count) 1) count))
    (let height Length 0)
    (for (in row (..< 0 rows))
      (let row-height Length 0)
      (for (in column (..< 0 count))
        (let index (+ (* row count) column))
        (if (< index (. grid cells length))
          (let cell-query (call MeasureQuery (call fit-axis-query ([] (. grid widths) column)) (. query block)))
          (let size (. (call (. ([] (. grid cells) index) flow-measure) cell-query) outer-size))
          (+= (. grid sizes) size)
          (= row-height (call max row-height (. size height)))
        )
      )
      (+= (. grid heights) row-height)
      (+= height row-height)
    )
    (if (> rows 1)
      (+= height (* gap-y (- rows 1)))
    )
    (blank)
    (let width gaps)
    (for (in column (..< 0 count))
      (+= width ([] (. grid widths) column))
    )
    (= (. grid width) width)
    (= (. grid height) height)
    (return grid)
  )
  (fn-do _ resolved-tracks (list GridTrack)
    (param available (? Length))
    (param cells Size)
    (param gap Length)
    (let filling fill)
    (return-if tracks (if (not filling)))
    (let span (call max (call gui-safe-span (. filling width)) 1))
    (let count
      (block
        (case? (!= available null)
          (as (call max 1.0 (call floor (/ (+ available gap) (+ span gap)))) Size)
        )
        (default
          (call max 1 cells)
        )
      )
    )
    (let track (if-expr (. filling stretches) (call (. GridTrack flex) 1) (call (. GridTrack fixed) span)))
    (return
      (call (of List GridTrack)
        (block
          (spread (..< 0 count))
          (pipe *> track)
        )
      )
    )
  )
  (fn-do _ fit-tracks _
    (param shape (list GridTrack))
    (param widths (list Length))
    (param available Length)
    (let total-flex Float)
    (let reserved Length 0)
    (let natural Length 0)
    (for (in column (..< 0 (. shape length)))
      (let track ([] shape column))
      (let weight (call gui-grid-flex-weight track))
      (if (!= (call gui-grid-fixed-width track) null)
        (+= reserved ([] widths column))
        (else-if (> weight 0)
          (+= total-flex weight)
          (= ([] widths column) (call min ([] widths column) (call gui-safe-span min-track)))
          (+= reserved ([] widths column))
        )
        (else
          (+= natural ([] widths column))
        )
      )
    )
    (blank)
    (let space (call gui-safe-span (- available reserved)))
    (if (> natural space)
      (= natural (call shrink-auto-tracks shape widths space))
    )
    (return-if (if (<= total-flex 0)))
    (blank)
    (let leftover (call gui-safe-span (- space natural)))
    (for (in column (..< 0 (. shape length)))
      (let weight (call gui-grid-flex-weight ([] shape column)))
      (if (> weight 0)
        (+= ([] widths column) (call floor (/ (* leftover weight) total-flex)))
      )
    )
  )
  (fn-do _ shrink-auto-tracks Length
    (param shape (list GridTrack))
    (param widths (list Length))
    (param space Length)
    (let settled (list Bool))
    (let unsettled Size 0)
    (for (in column (..< 0 (. shape length)))
      (let is-auto (call gui-grid-is-auto ([] shape column)))
      (+= settled (not is-auto))
      (if is-auto
        (+= unsettled 1)
      )
    )
    (blank)
    (let remaining space)
    (let progressed true)
    (while (and progressed (> unsettled 0))
      (= progressed false)
      (let share (/ remaining unsettled))
      (for (in column (..< 0 (. shape length)))
        (if (and (not ([] settled column)) (<= ([] widths column) share))
          (= ([] settled column) true)
          (-= remaining ([] widths column))
          (-= unsettled 1)
          (= progressed true)
        )
      )
    )
    (blank)
    (let total (- space remaining))
    (return-if total (if (== unsettled 0)))
    (let share (call floor (/ remaining unsettled)))
    (let floor-width (call gui-safe-span min-track))
    (for (in column (..< 0 (. shape length)))
      (if (not ([] settled column))
        (= ([] widths column) (call max (call min ([] widths column) floor-width) share))
        (+= total ([] widths column))
      )
    )
    (return total)
  )
)

(type _ GUIGridSolution
  (prop + cells (list Box))
  (prop + sizes (list Dimensions))
  (prop + widths (list Length))
  (prop + heights (list Length))
  (prop + width Length)
  (prop + height Length)
)

(fn-expr _ gui-grid-auto-tracks (list GridTrack)
  (param count Size)
  (spread (..< 0 count))
  (pipe *> (. GridTrack auto))
  (pipe |> List)
)

(fn-expr _ gui-grid-is-auto _
  (param track GridTrack)
  (match track
    (case (. GridTrack auto)
      true
    )
    (default
      false
    )
  )
)

(fn-expr _ gui-grid-fixed-width (? Length)
  (param track GridTrack)
  (match? track
    (case (call (. GridTrack fixed) value)
      (call gui-safe-span value)
    )
  )
)

(fn-expr _ gui-grid-flex-weight Float
  (param track GridTrack)
  (match track
    (case (call (. GridTrack flex) weight)
      (call gui-flex-weight weight)
    )
    (default
      0
    )
  )
)

(fn-expr _ gui-grid-cell-rect Rect
  (param cell Box)
  (param track Rect)
  (param size Dimensions)
  (call Rect x y width height)
  (where
    (lazy align-x (if-expr (== (. cell $align-x) (. Alignment stretch)) null (. cell $align-x)))
    (lazy align-y (if-expr (== (. cell $align-y) (. Alignment stretch)) null (. cell $align-y)))
    (lazy width (if-expr (!= align-x null) (call min (. size width) (. track width)) (. track width)))
    (lazy height (if-expr (!= align-y null) (call min (. size height) (. track height)) (. track height)))
    (lazy x (if-expr (!= align-x null) (+ (. track x) (* (- (. track width) width) (. align-x fraction))) (. track x)))
    (lazy y (if-expr (!= align-y null) (+ (. track y) (* (- (. track height) height) (. align-y fraction))) (. track y)))
  )
)

(type _ GUIFlexSpacing (is (tuple (: lead Length) (: between Length))))

(fn-expr _ gui-flex-justify-spacing GUIFlexSpacing
  (param justify Justify)
  (param free Length)
  (param count Size)
  (match justify
    (case (. Justify center)
      (call GUIFlexSpacing (/ free 2) 0)
    )
    (case (. Justify end)
      (call GUIFlexSpacing free 0)
    )
    (case (. Justify space-between)
      (if-expr (> count 1) (call GUIFlexSpacing 0 (/ free (- count 1))) (call GUIFlexSpacing 0 0))
    )
    (case (. Justify space-around)
      (call GUIFlexSpacing (/ free count 2) (/ free count))
    )
    (case (. Justify space-evenly)
      (call GUIFlexSpacing (/ free (+ count 1)) (/ free (+ count 1)))
    )
    (default
      (call GUIFlexSpacing 0 0)
    )
  )
)

(fn-do _ gui-flex-align-baselines Length
  (param box Box)
  (param children (list Box))
  (param top Length)
  (let rises (call (of List Length)))
  (let line Length 0)
  (for (in live children)
    (let rise (if-expr (call gui-flex-aligns-baseline box live) (call gui-flex-child-rise live) -1))
    (+= rises rise)
    (= line (call max line rise))
  )
  (let bottom Length 0)
  (for (in index (..< 0 (. children length)))
    (let rise ([] rises index))
    (if (>= rise 0)
      (let live ([] children index))
      (let outer (. live outer-bounds))
      (call (. live arrange-outer-bounds) (call Rect (. outer x) (- (+ top line) rise) (. outer width) (. outer height)))
      (= bottom (call max bottom (+ (- line rise) (. outer height))))
    )
  )
  (return bottom)
)

(fn-expr _ gui-flex-aligns-baseline Bool
  (param box Box)
  (param child Box)
  (== (?? (. child $align-y) (. box $align-children)) (. Alignment first-baseline))
)

(fn-do _ gui-flex-child-rise Length
  (param child Box)
  (call (. child update-layout))
  (let outer (. child outer-bounds))
  (return (- (?? (. child first-baseline) (. outer bottom)) (. outer y)))
)

(type _ GUIFlexScratch
  (prop + children (list Box))
  (prop + weights (list Float))
  (prop + margins (list Length))
  (prop + measures (list Dimensions))
  (prop + allocations (list Length))
  (prop + flexible (list Bool))
  (prop + shrinks (list Float))
  (prop + settled (list Bool))
  (prop + spaces (list Float))
  (prop + shares (list Float))
  (prop + is-uniform _ (= true))
  (prop + fixed Length (= 0))
  (prop + total-flex Float)
  (fn-do + clear _
    (call (. children clear))
    (call (. weights clear))
    (call (. margins clear))
    (call (. measures clear))
    (call (. allocations clear))
    (call (. flexible clear))
    (call (. shrinks clear))
    (call (. settled clear))
    (call (. spaces clear))
    (call (. shares clear))
    (= is-uniform true)
    (= fixed 0)
    (= total-flex 0)
  )
  (fn-do + add-space _
    (param space Float)
    (param share Float)
    (if is-uniform
      (return-if (if (and (== space 1) (== share 1))))
      (= is-uniform false)
      (for (in index (..< 0 (. children length)))
        (+= spaces 1.0)
        (+= shares 1.0)
      )
    )
    (+= spaces space)
    (+= shares share)
  )
  (fn-do + set-share _
    (param index Index)
    (param share Float)
    (if is-uniform
      (return-if (if (== share 1)))
      (= is-uniform false)
      (for (in kid (..< 0 (. children length)))
        (+= spaces 1.0)
        (+= shares 1.0)
      )
    )
    (= ([] shares index) share)
  )
  (fn-expr + space-at Float @inline
    (param index Index)
    (if-expr is-uniform 1.0 ([] spaces index))
  )
  (fn-expr + share-at Float @inline
    (param index Index)
    (if-expr is-uniform 1.0 ([] shares index))
  )
)

(fn-do _ acquire-gui-flex-scratch _
  (return (if-expr (> (. gui-flex-scratch-stack length) 0) (call (. gui-flex-scratch-stack pop)) (call GUIFlexScratch)))
)

(fn-expr _ gui-flex-stretched-cross Length
  (param box Box)
  (param available Length)
  (param orient Orientation)
  (param measured Dimensions)
  (case? (and (== orient (. Orientation horizontal)) (not (. box has-inline-limits)))
    available
  )
  (case? (and (== orient (. Orientation vertical)) (not (. box has-block-limits)))
    available
  )
  (case? (and (== orient (. Orientation horizontal)) (. box has-exact-inline-size) (> (. measured width) 0))
    (. measured width)
  )
  (case? (and (== orient (. Orientation vertical)) (. box has-exact-block-size) (> (. measured height) 0))
    (. measured height)
  )
  (default
    (call (. box constrained-outer-main-size) available orient available)
  )
)

(fn-do _ gui-flex-natural-size _
  (param box Box)
  (param orient Orientation)
  (param query MeasureQuery)
  (param gap Length)
  (let child-query (call (. box derived-child-measure-query) query))
  (let available (. child-query inline available))
  (if (or (!= orient (. Orientation horizontal)) (not available))
    (return (call gui-layout-natural-size box orient query gap))
  )
  (blank)
  (let fixed Length 0)
  (let shrinkable Length 0)
  (let total-flex Float)
  (let cross Length 0)
  (let count Size 0)
  (let child (. box first-active-child))
  (let reach Float)
  (while child
    (let live child)
    (= child (. live next-active-sibling))
    (if (. live is-released)
      (continue)
    )
    (let space (. live layout-space))
    (let weight (* (call gui-flex-weight (. live $flex)) space))
    (if (> weight 0)
      (+= total-flex weight)
      (+= fixed (call gui-main-inset-size (. live margin-edges) orient))
      (else
        (let size (. (call (. live flow-measure) child-query) outer-size))
        (+= fixed (* (. size width) space))
        (if (> (call gui-flex-weight (. live $shrink)) 0)
          (+= shrinkable (* (. size width) space))
        )
        (= cross (call max cross (. size height)))
      )
    )
    (+= fixed (* gap space reach))
    (= reach (call max reach space))
    (+= count 1)
  )
  (if (and (> fixed available) (> shrinkable 0))
    (-= fixed (call gui-flex-natural-shrink box child-query (- fixed available) available))
  )
  (blank)
  (return-if (call Dimensions fixed cross) (if (<= total-flex 0)))
  (blank)
  (let remaining (call gui-safe-span (- available fixed)))
  (let primary fixed)
  (= child (. box first-active-child))
  (while child
    (let live child)
    (let weight (if-expr (. live is-released) 0 (* (call gui-flex-weight (. live $flex)) (. live layout-space))))
    (if (> weight 0)
      (let margin (call gui-main-inset-size (. live margin-edges) orient))
      (let share (+ (/ (* remaining weight) total-flex) margin))
      (let share-query (call MeasureQuery (call fit-axis-query share) (. child-query block)))
      (let size (. (call (. live flow-measure) share-query) outer-size))
      (+= primary (- (. size width) margin))
      (= cross (call max cross (. size height)))
    )
    (= child (. live next-active-sibling))
  )
  (blank)
  (return (call Dimensions primary cross))
)

(fn-do _ gui-flex-natural-shrink Length
  (param box Box)
  (param query MeasureQuery)
  (param overflow Length)
  (param available Length)
  (let scratch GUIFlexScratch (call acquire-gui-flex-scratch))
  (let child (. box first-active-child))
  (while child
    (let live child)
    (= child (. live next-active-sibling))
    (if (or (. live is-released) (> (call gui-flex-weight (. live $flex)) 0))
      (continue)
    )
    (let space (. live layout-space))
    (call (. scratch add-space) space space)
    (+= (. scratch children) live)
    (+= (. scratch measures) (. (call (. live flow-measure) query) outer-size))
    (+= (. scratch shrinks) (call gui-flex-weight (. live $shrink)))
  )
  (let reduced (call gui-flex-shrink scratch overflow (. Orientation horizontal) available))
  (call (. scratch clear))
  (+= gui-flex-scratch-stack scratch)
  (return reduced)
)

(fn-do _ gui-layout-natural-size _
  (param box Box)
  (param orient Orientation)
  (param query MeasureQuery)
  (param gap Length)
  (let primary Length 0)
  (let cross Length 0)
  (let reach Float)
  (let child-query (call (. box derived-child-measure-query) query))
  (let child (. box first-active-child))
  (while child
    (let live child)
    (= child (. live next-active-sibling))
    (if (. live is-released)
      (continue)
    )
    (let size (. (call (. live flow-measure) child-query) outer-size))
    (let space (. live layout-space))
    (+= primary (* gap space reach))
    (= reach (call max reach space))
    (if (== orient (. Orientation horizontal))
      (+= primary (* (. size width) space))
      (= cross (call max cross (. size height)))
      (else
        (+= primary (* (. size height) space))
        (= cross (call max cross (. size width)))
      )
    )
  )
  (blank)
  (return
    (scope (if-expr is-horizontal (call Dimensions primary cross) (call Dimensions cross primary))
      (lazy is-horizontal (== orient (. Orientation horizontal)))
    )
  )
)

(fn-expr _ gui-main-size _
  (param size Dimensions)
  (param orient Orientation)
  (if-expr (== orient (. Orientation horizontal)) (. size width) (. size height))
)

(fn-do _ gui-flex-shrink Length
  (param scratch GUIFlexScratch)
  (param overflow Length)
  (param orient Orientation)
  (param available Length)
  (let settled (. scratch settled))
  (call (. settled clear))
  (for (in index (..< 0 (. scratch children length)))
    (+= settled (<= ([] (. scratch shrinks) index) 0))
  )
  (let remaining overflow)
  (let reduced Length 0)
  (while (> remaining 0)
    (let snap (? Index))
    (let snap-size Length 0)
    (let snap-main Length 0)
    (let snap-weight Float)
    (for (in index (..< 0 (. scratch children length)))
      (if ([] settled index)
        (continue)
      )
      (let weight ([] (. scratch shrinks) index))
      (let main (call gui-main-size ([] (. scratch measures) index) orient))
      (let probe (call gui-safe-span (- main 1)))
      (let size (call (. ([] (. scratch children) index) constrained-outer-main-size) probe orient available))
      (if (and (< size (- probe 0.01)) outweighs)
        (= snap index)
        (= snap-size size)
        (= snap-main main)
        (= snap-weight weight)
      )
      (lazy outweighs (or (> weight snap-weight) (and (== weight snap-weight) (> main snap-main))))
    )
    (if (= (| (: chosen Index)) snap)
      (let taken (* (- snap-main snap-size) (call (. scratch share-at) chosen)))
      (+= reduced taken)
      (-= remaining taken)
      (call gui-flex-set-main scratch chosen snap-size orient)
      (else
        (break)
      )
    )
  )
  (let total Float)
  (for (in index (..< 0 (. scratch children length)))
    (if (not ([] settled index))
      (+= total (* ([] (. scratch shrinks) index) (call gui-main-size ([] (. scratch measures) index) orient)))
    )
  )
  (let clamped-one true)
  (while (and clamped-one (> total 0) (> remaining 0))
    (= clamped-one false)
    (for (in index (..< 0 (. scratch children length)))
      (if ([] settled index)
        (continue)
      )
      (let weight ([] (. scratch shrinks) index))
      (let main (call gui-main-size ([] (. scratch measures) index) orient))
      (let proposed (call gui-safe-span (- main (/ (* (call max remaining 0) weight main) total))))
      (let size
        (call min
          (block
            (arg main)
            (arg (call (. ([] (. scratch children) index) constrained-outer-main-size) proposed orient available))
          )
        )
      )
      (if (> (call abs (- size proposed)) 0.01)
        (-= total (* weight main))
        (let taken (call gui-flex-settle scratch index main size orient))
        (+= reduced taken)
        (-= remaining taken)
        (= clamped-one true)
      )
    )
  )
  (for (in index (..< 0 (. scratch children length)))
    (if (and (not ([] settled index)) (> total 0))
      (let main (call gui-main-size ([] (. scratch measures) index) orient))
      (let proposed (call gui-safe-span (- main (/ (* (call max remaining 0) ([] (. scratch shrinks) index) main) total))))
      (let size
        (call min
          (block
            (arg main)
            (arg (call (. ([] (. scratch children) index) constrained-outer-main-size) proposed orient available))
          )
        )
      )
      (+= reduced (* (- main size) (call (. scratch share-at) index)))
      (call gui-flex-set-main scratch index size orient)
    )
  )
  (return reduced)
)

(fn-do _ gui-flex-settle Length
  (param scratch GUIFlexScratch)
  (param index Index)
  (param main Length)
  (param size Length)
  (param orient Orientation)
  (= ([] (. scratch settled) index) true)
  (call gui-flex-set-main scratch index size orient)
  (return (* (- main size) (call (. scratch share-at) index)))
)

(fn-do _ gui-flex-set-main _
  (param scratch GUIFlexScratch)
  (param index Index)
  (param size Length)
  (param orient Orientation)
  (let measure ([] (. scratch measures) index))
  (= ([] (. scratch measures) index)
    (scope (if-expr (== orient (. Orientation horizontal)) by-width by-height)
      (lazy by-width (call Dimensions size (. measure height)))
      (lazy by-height (call Dimensions (. measure width) size))
    )
  )
)

(fn-expr _ gui-main-inset-size _
  (param insets Insets)
  (param orient Orientation)
  (if-expr (== orient (. Orientation horizontal)) (. insets horizontal) (. insets vertical))
)

(fn-expr _ gui-flex-weight _
  (param value Float)
  (if-expr (and (call is-finite value) (> value 0)) value 0)
)

(type _ GUIFlexCrossAxis (is (tuple (: start Length) (: span Length))))

(fn-expr _ gui-flex-cross-axis _
  (param child Box)
  (param start Length)
  (param span Length)
  (param stretched Length)
  (param query MeasureQuery)
  (param orient Orientation)
  (param align Alignment)
  (case? (== align (. Alignment stretch))
    (call GUIFlexCrossAxis start stretched)
  )
  (default
    (call GUIFlexCrossAxis (+ start (* (- span size) (. align fraction))) size)
  )
  (where
    (lazy natural (. (call (. child flow-measure) query) outer-size))
    (lazy size (call min (if-expr (== orient (. Orientation horizontal)) (. natural height) (. natural width)) span))
  )
)

(fn-do _ gui-carry-slot (? Index)
  (param box Box)
  (param child Box)
  (param orient Orientation)
  (let center (. child carried-center))
  (return-if null (if (not center)))
  (let horizontal (== orient (. Orientation horizontal)))
  (let along (if-expr horizontal (. center x) (. center y)))
  (let slot Index 0)
  (let cursor (. box first-active-child))
  (while cursor
    (let live cursor)
    (= cursor (. live next-active-sibling))
    (if (and (not (. live is-released)) (!= (as live Pointer) (as child Pointer)))
      (let frame (. live bounds))
      (let middle (if-expr horizontal (+ (. frame x) (/ (. frame width) 2)) (+ (. frame y) (/ (. frame height) 2))))
      (if (< middle along)
        (+= slot 1)
      )
    )
  )
  (return slot)
)

(fn-do _ gui-carried-order (? (list Box))
  (param box Box)
  (let carried (. box carried-child))
  (return-if null (if (not carried)))
  (return-if null (if (!= (as (. carried layout-parent) (? Pointer)) (as box Pointer))))
  (let slot (. carried carry-slot))
  (return-if null (if (== slot null)))
  (let order (list Box))
  (let cursor (. box first-active-child))
  (while cursor
    (let live cursor)
    (= cursor (. live next-active-sibling))
    (if (and (not (. live is-released)) (!= (as live Pointer) (as carried Pointer)))
      (+= order live)
    )
  )
  (call (. order insert) carried (call min slot (. order length)))
  (return order)
)
