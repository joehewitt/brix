if fit then min(size, gui-safe-span(available)) else size

━━━━━━━━━━━━━━━━━━━━
+ placement-align
    - align AnchorPoint
    - anchor-start Length
    - anchor-span Length
    - size Length
    - offset Length

match align
    | AnchorPoint.center
        anchor-start + (anchor-span - size) / 2
    | AnchorPoint.end
        anchor-start + anchor-span - size - offset
    ??
        anchor-start + offset

━━━━━━━━━━━━━━━━━━━━
+ placement-clamp-arrow
    - offset Length
    - size Length
    - margin Length

|? size <= margin * 2
    size / 2
??
    min(max(offset, margin), size - margin)

━━━━━━━━━━━━━━━━━━━━
+ placement-available
    - side Side
    - anchor Rect
    - boundary Rect
    - gap Length

match side
    | Side.top
        anchor.top - gap - boundary.top
    | Side.bottom
        boundary.bottom - anchor.bottom - gap
    | Side.left
        anchor.left - gap - boundary.left
    ??
        boundary.right - anchor.right - gap

━━━━━━━━━━━━━━━━━━━━
+ placement-choose-side
    - side Side
    - flip Bool
    - anchor Rect
    - boundary Rect
    - gap Length
    - natural Dimensions

|? preferred-fits || !flip
    side
|? opposite-fits || opposite-room > preferred-room
    side.opposite
??
    side

.. needed = if side.is-vertical then natural.height else natural.width
.. preferred-room = placement-available(side, anchor, boundary, gap)
.. opposite-room = placement-available(side.opposite, anchor, boundary, gap)
.. preferred-fits = needed <= preferred-room
.. opposite-fits = needed <= opposite-room

━━━━━━━━━━━━━━━━━━━━
_ PlacementAxis is (start Length, span Length)

━━━━━━━━━━━━━━━━━━━━
_ placement-main-axis
    - side Side
    - anchor Rect
    - boundary Rect
    - gap Length
    - natural Dimensions
    - fit Bool

match side
    | Side.top
        PlacementAxis(anchor.top - gap - height, height)
    | Side.bottom
        PlacementAxis(anchor.bottom + gap, height)
    | Side.left
        PlacementAxis(anchor.left - gap - width, width)
    ??
        PlacementAxis(anchor.right + gap, width)

.. room = gui-safe-span(placement-available(side, anchor, boundary, gap))
.. height = placement-fit-span(natural.height, room, fit)
.. width = placement-fit-span(natural.width, room, fit)
