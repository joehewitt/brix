popup.measure(measure-fit-query(boundary.width, boundary.height)).border-size

━━━━━━━━━━━━━━━━━━━━
+ placement-clamp
    - start Length
    - bound-start Length
    - bound-span Length
    - size Length

|? size >= bound-span
    bound-start
??
    min(max(start, bound-start), bound-start + bound-span - size)

━━━━━━━━━━━━━━━━━━━━
