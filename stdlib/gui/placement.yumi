+ AnchoredPlacement is Placement

+ side Side
+ align AnchorPoint
+ gap Length
+ offset Length
+ flip = true
+ shift = true
+ fit = true
+ match-width = false
+ arrow-margin Length = 12

────────────────────
+ This
    - side = Side.bottom
    - align = AnchorPoint.start
    - gap = 4
    - offset = 0
    - match-width = false

╌╌╌╌╌╌╌╌╌╌ is Placement ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ place PlacementResult
    - request PlacementRequest

|? chosen.is-vertical
    PlacementResult(Rect(cross-start, main.start, cross-size, main.span), chosen, arrow)
??
    PlacementResult(Rect(main.start, cross-start, main.span, cross-size), chosen, arrow)

.. anchor = request.anchor
.. boundary = request.boundary
.. natural = placement-natural-size(request.popup, boundary)
.. reach = gap + request.popup.effective-shape.anchor-gap
.. chosen = placement-choose-side(side, flip, anchor, boundary, reach, natural)
.. main = placement-main-axis(chosen, anchor, boundary, reach, natural, fit)
.. matched-width = if match-width then max(natural.width, anchor.width) else natural.width
.. cross-natural = if chosen.is-vertical then matched-width else natural.height
.. cross-anchor-start = if chosen.is-vertical then anchor.x else anchor.y
.. cross-anchor-span = if chosen.is-vertical then anchor.width else anchor.height
.. cross-bound-start = if chosen.is-vertical then boundary.x else boundary.y
.. cross-bound-span = if chosen.is-vertical then boundary.width else boundary.height
.. cross-size = placement-fit-span(cross-natural, cross-bound-span, fit)
.. aligned = placement-align(align, cross-anchor-start, cross-anchor-span, cross-size, offset)
.. cross-start = if shift then clamped else aligned
.. clamped = placement-clamp(aligned, cross-bound-start, cross-bound-span, cross-size)
.. anchor-center = cross-anchor-start + cross-anchor-span / 2
.. arrow = placement-clamp-arrow(anchor-center - cross-start, cross-size, arrow-margin)

