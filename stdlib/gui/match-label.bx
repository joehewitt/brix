(import ./styles)
(import ./text)
(import ./theme)
(import /graphics/text)

(style-extend GUIDefaultTheme
  (using GUIFontStyle)
  (using GUITextComposition)
  (using GUITextPaint)
  (rule MatchLabel
    (= text-wrap (. TextWrap no-wrap))
    (= text-overflow (. TextOverflow truncate-tail))
  )
  (blank)
  (rule MatchLabelSpan
    (when-style #is-hit
      (• text gui-accent-bright-color)
      (= font-weight (. FontWeight bold))
    )
  )
)

(type + MatchSpan (is Tuple)
  (prop + start Size)
  (prop + end Size)
)

(fn-do + match-spans (list MatchSpan)
  (param positions (list Index))
  (param offset Index (= 0))
  (let spans (list MatchSpan))
  (let index Index 0)
  (while (< index (. positions length))
    (let start ([] positions index))
    (let end (+ start 1))
    (+= index 1)
    (while (and (< index (. positions length)) (== ([] positions index) end))
      (+= end 1)
      (+= index 1)
    )
    (+= spans (call MatchSpan (- start offset) (- end offset)))
  )
  (return spans)
)

(type + MatchLabel (is Text)
  (prop + text String (= ""))
  (prop + hits (list MatchSpan) (= (call (of List MatchSpan))))
  (prop + pieces _ (= (call match-label-pieces #text #hits)))
  (content
    (<> This
      (for (in piece #pieces (keyed-by (. piece order)))
        (<> MatchLabelSpan
          (= text (. piece text))
          (= is-hit (. piece is-hit))
        )
      )
    )
  )
)

(type + MatchLabelSpan (is Span)
  (prop + is-hit _ (= false))
)

(type _ MatchPiece (is Tuple)
  (prop + order Index)
  (prop + text String)
  (prop + is-hit Bool)
)

(fn-do _ match-label-pieces (list MatchPiece)
  (param text String)
  (param hits (list MatchSpan))
  (let pieces (list MatchPiece))
  (let bytes (call byte-view text))
  (let size (. bytes size))
  (return-if pieces (if (== size 0)))
  (let marks ([] Bool size))
  (for (in hit hits)
    (let end (if-expr (< (. hit end) size) (. hit end) size))
    (for (in index (..< (. hit start) end))
      (= ([] marks index) true)
    )
  )
  (let cursor Index 0)
  (while (< cursor size)
    (let finish (+ cursor 1))
    (let is-hit ([] marks cursor))
    (while (and (< finish size) (call utf8-is-continuation ([] bytes finish)))
      (= is-hit (or is-hit ([] marks finish)))
      (+= finish 1)
    )
    (for (in index (..< cursor finish))
      (= ([] marks index) is-hit)
    )
    (= cursor finish)
  )
  (let first Index 0)
  (for (in index (..< 1 (+ size 1)))
    (if (or (== index size) (!= ([] marks index) ([] marks first)))
      (+= pieces (call MatchPiece (. pieces length) (call (. bytes slice-string) (..< first index)) ([] marks first)))
      (= first index)
    )
  )
  (return pieces)
)
