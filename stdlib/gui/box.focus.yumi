━━━━━━━━━━━━━━━━━━━━
+ BoxFocus is facet of Box
    sees BoxScroll
    using GUIBoxFocus
    using GUIFocusRingStyle

+ event focus FocusEvent
+ event blur BlurEvent

+ is-focused = false
+ is-focus-visible = false
+ is-focus-within = false
+ remembered-focus Box?
+ admits-focus-traversal => true
+ is-focus-enabled => true
+ is-focus-ready => true
+ native-focus-handle Pointer? => null
+ accepts-focus =>
    is-focusable && is-effectively-enabled && is-available && is-focus-admitted
    .. is-focusable = focus-mode-can-focus($focus-mode) && is-focus-enabled
    .. is-available = is-input-visible && markup-batch-root != null
+ is-focus-admitted =>
    !host || host.admits-focus(this)
    .. host = window
+ can-focus => accepts-focus && is-focus-ready
+ delegates-focus => $focus-group && !focus-mode-can-focus($focus-mode)
+ holds-group-focus =>
    delegates-focus && is-effectively-enabled && is-available && is-focus-admitted
    .. is-available = is-input-visible && markup-batch-root != null
+ can-hold-focus => can-focus || holds-group-focus

_ is-focus-home = false

────────────────────
+ do focus-candidates

. candidates [Box]
collect-focus-candidates(candidates)
= candidates

────────────────────
+ do focus-candidate-at-edge
    - going-backward = false

=? if !is-input-visible
. cursor Box? = if going-backward then focus-walk-last-visible() else this
while cursor
    . candidate = cursor
    =? candidate if candidate.is-focus-walk-candidate()
    if going-backward
        cursor = focus-walk-previous(this, candidate)
    else
        cursor = focus-walk-next(this, candidate)

────────────────────
+ do focus-candidate-after
    - current Box
    - going-backward = false

=? if !current.is-within(this)
. cursor Box?
if going-backward
    cursor = focus-walk-previous(this, current)
else
    cursor = focus-walk-next(this, current)
while cursor
    . candidate = cursor
    =? candidate if candidate.is-focus-walk-candidate()
    if going-backward
        cursor = focus-walk-previous(this, candidate)
    else
        cursor = focus-walk-next(this, candidate)

────────────────────
+ do nearest-focus-group Box?

. cursor Box? = this
while cursor
    . box = cursor
    =? box if box.$focus-group && !box.is-markup-shadow
    =? null if box.is-presentation-layer
    cursor = box.material-parent
= null

────────────────────
+ do focus-group-target Box?

=? null if !is-input-visible
. kept = remembered-focus
if kept
    . usable = kept.accepts-focus || kept.holds-group-focus
    =? kept if !kept.is-markup-shadow && usable && kept.is-within(this)
    remembered-focus = null
= seek-group-focus(true) ?? seek-group-focus(false) ?? seek-group-holder()

────────────────────
+ do nearest-focus-owner

. cursor Box? = this
while cursor
    if !cursor.is-markup-shadow && cursor.can-focus
        = cursor
    cursor = cursor.material-parent

────────────────────
+ do request-focus

. host = window-host
= if host then host.accept-focus-request(this) else false

────────────────────
+ do clear-focus Bool

. host = window-host
= if host then host.accept-focus-request(null) else false

────────────────────
+ do is-focus-traversal-reachable

=? true if is-presentation-layer
. rect = bounds
. cursor = this.material-parent
while cursor
    . ancestor = cursor
    =? false if !ancestor.admits-focus-traversal
    if !ancestor.is-markup-shadow
        if ancestor.clips-content
            . outside-x = rect.right <= ancestor.content-bounds.left
            outside-x = outside-x || rect.left >= ancestor.content-bounds.right
            . outside-y = rect.bottom <= ancestor.content-bounds.top
            outside-y = outside-y || rect.top >= ancestor.content-bounds.bottom
            . clips-fixed-x = !ancestor.is-scroll-axis-enabled(Orientation.horizontal)
            . clips-fixed-y = !ancestor.is-scroll-axis-enabled(Orientation.vertical)
            =? false if clips-fixed-x && outside-x
            =? false if clips-fixed-y && outside-y
        . offset = ancestor.content-offset
        rect = Rect(rect.x - offset.x, rect.y - offset.y, rect.width, rect.height)
    =? true if ancestor.is-presentation-layer
    cursor = ancestor.material-parent
= true

────────────────────
+ admits-focus
    - box Box

true

────────────────────
+ do reveal-focus

=? if !has-scroll-container-ancestor()
root.ensure-visible
    - this
    - ScrollAlignment.nearest
    - Insets(0, 0, 0, 0)
    - ScrollCause.focus

────────────────────
+ get focus-ring-reach

|? !ring || width <= 0 || height <= 0
    0
??
    max(0, ring.offset) + max(0, ring.width)

.. ring = $focus-ring

────────────────────
+ do paint-focus-ring
    - canvas Canvas

. ring = $focus-ring
=? if !ring || ring.width <= 0 || width <= 0 || height <= 0
. extent = max(0, ring.offset) + ring.width / 2
. outline = bounds.pad(-extent)
do use canvas.saved-state
    canvas.fill-color = null
    canvas.stroke-color = ring.color
    canvas.stroke-width = ring.width
    if effective-corner-radius > 0
        . radius = effective-corner-radius + extent
        canvas.begin()
        RoundedRect(outline, radius, radius, radius, radius).outline(canvas)
        canvas.end()
    else
        canvas.rect(outline)

────────────────────
^ do sync-focus-home

. is-home = $focus-home
=? if is-home == is-focus-home
. host = window-host
=? if !host
is-focus-home = is-home
if is-home
    host.register-focus-home(this)
else
    host.unregister-focus-home(this)

────────────────────
^ do release-focus-home

=? if !is-focus-home
is-focus-home = false
window-host?.unregister-focus-home(this)

────────────────────
_ do collect-focus-candidates
    - candidates [Box]

=? if !is-input-visible
if !is-markup-shadow && accepts-focus && is-focus-traversal-reachable()
    candidates += this
for child in RenderedChildCursor(this)
    child.collect-focus-candidates(candidates)

────────────────────
_ is-focus-walk-candidate

|? is-markup-shadow
    false
??
    accepts-focus && is-focus-traversal-reachable()

────────────────────
_ do focus-walk-next
    - boundary Box
    - node Box

if node.is-display-visible
    . child = node.focus-walk-first-visible-child()
    =? child if child

. cursor = node
while cursor as Pointer != boundary as Pointer
    . parent = cursor.material-parent
    =? if !parent
    . sibling = cursor.focus-walk-next-visible-sibling(parent)
    =? sibling if sibling
    cursor = parent

────────────────────
_ do focus-walk-previous
    - boundary Box
    - node Box

=? if node as Pointer == boundary as Pointer
. parent = node.material-parent
=? if !parent
. sibling = node.focus-walk-previous-visible-sibling(parent)
= if sibling then sibling.focus-walk-last-visible() else parent

────────────────────
_ do focus-walk-first-visible-child

. candidate = gui-rendered-resolve(this, %first-child)
while candidate
    =? candidate if gui-focus-edge-visible(this, candidate)
    candidate = gui-rendered-resolve(this, gui-rendered-climb(candidate, this))

────────────────────
_ do focus-walk-last-visible-child

. candidate = gui-rendered-reverse-resolve(this, %last-child)
while candidate
    =? candidate if gui-focus-edge-visible(this, candidate)
    candidate = gui-rendered-reverse-resolve
        - this
        - gui-rendered-reverse-climb(candidate, this)

────────────────────
_ do focus-walk-next-visible-sibling
    - owner Box

. candidate = gui-rendered-resolve(owner, gui-rendered-climb(this, owner))
while candidate
    =? candidate if gui-focus-edge-visible(owner, candidate)
    candidate = gui-rendered-resolve(owner, gui-rendered-climb(candidate, owner))

────────────────────
_ do focus-walk-previous-visible-sibling
    - owner Box

. candidate = gui-rendered-reverse-resolve(owner, gui-rendered-reverse-climb(this, owner))
while candidate
    =? candidate if gui-focus-edge-visible(owner, candidate)
    candidate = gui-rendered-reverse-resolve
        - owner
        - gui-rendered-reverse-climb(candidate, owner)

────────────────────
_ do focus-walk-last-visible Box

. cursor = this
while true
    . child = cursor.focus-walk-last-visible-child()
    =? cursor if !child
    cursor = child

────────────────────
_ do gui-focus-edge-visible
    - owner Box
    - candidate Box

. cursor GuiNode? = candidate
while cursor && cursor as Pointer != owner as Pointer
    . node = cursor
    =? false if node is Box && !(node as Box).is-display-visible
    cursor = node.%parent
= true

────────────────────
_ do seek-group-holder Box?

for child in RenderedChildCursor(this)
    . found = child.seek-holder-from()
    =? found if found
= null

────────────────────
_ seek-holder-from Box?

|? !is-input-visible
    null
|? !is-markup-shadow && holds-group-focus
    this
??
    seek-group-holder()

────────────────────
_ do seek-group-focus Box?
    - prefers Bool

for child in RenderedChildCursor(this)
    . found = child.seek-focus-from(prefers)
    =? found if found
= null

────────────────────
_ do seek-focus-from Box?
    - prefers Bool

=? null if !is-input-visible
if !is-markup-shadow
    . delegates = $focus-group || ($focus-default && !focus-mode-can-focus($focus-mode))
    =? focus-group-target() if prefers && delegates
    . wanted = if prefers then $focus-default else focus-mode-takes-keys($focus-mode)
    =? this if wanted && accepts-focus
= seek-group-focus(prefers)
