• Toolbar • flex-col bg:gui-glass-panel-color
    backdrop-blur = gui-glass-panel-blur
    border-color = gui-toolbar-edge-color
    border-bottom-width = gui-hairline
    window-draggable = true

    • toolbar-items • flex-row h:gui-toolbar-height pr:gui-toolbar-pad gap:gui-toolbar-gap items-center

    • TabBar • bg:transparent pb:gui-toolbar-tab-pad
        border-bottom-width = 0

    • TabTray • liquid-glass
        border-width = 0

• ToolbarSpace • flex:1

• ToolbarTitle • text:gui-strong-text-color px:4 shrink:1
    font-size = gui-title3-font-size
    font-weight = FontWeight.semibold
    align-y = Alignment.center

• ToolbarGroup • liquid-glass flex-row h:gui-toolbar-item-height p:gui-toolbar-group-pad items-center
    corner-radius = gui-toolbar-group-height / 2
    window-draggable = false

    • Slider • mx:10
        align-y = Alignment.center

    • SegmentedControl • bg:transparent p:0
        corner-radius = gui-toolbar-item-height / 2

        • Segment • h:gui-toolbar-item-height px:12
            min-height = gui-toolbar-item-height
            max-height = gui-toolbar-item-height
            corner-radius = gui-toolbar-item-height / 2

    • MenuButton • bg:transparent text:gui-glass-icon-color h:gui-toolbar-item-height pl:12 pr:10
        corner-radius = gui-toolbar-item-height / 2
        shadow = null

        when #is-hover-within
            • bg:gui-hover-color

        when #is-press-within
            • bg:gui-pressed-color

        when #is-open
            • bg:gui-pressed-color

        when #is-untitled
            • px:0
            • w:gui-toolbar-item-height

            • button-content
                align-x = Alignment.center

            • button-title • flex:0

• ToolbarButton • bg:transparent text:gui-glass-icon-color h:gui-toolbar-item-height px:12
    corner-radius = gui-toolbar-item-height / 2
    shadow = null
    motion = gui-motion-quick

    • icon • w:gui-toolbar-icon h:gui-toolbar-icon mr:6

    when #is-untitled
        • px:0
        • w:gui-toolbar-item-height

        • icon • mr:0

    when #is-hover-within
        • bg:gui-hover-color

    when #is-press-within
        • bg:gui-pressed-color

    when #is-on
        • bg:gui-pressed-color
        • text:gui-accent-bright-color

    when #is-default
        • bg:gui-accent-color
        • text:gui-accent-text-color

    when !#is-effectively-enabled
        • bg:transparent
        cursor = CursorStyle.arrow

    when !#is-enabled
        opacity = 0.3%%

