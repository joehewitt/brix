+ Toolbar is Box

+ is-title-bar = false
+ is-beside-stoplights = #is-title-bar && !(owner-window?.#is-full-screen ?? false)
+ stoplight-inset = owner-window?.#stoplight-inset ?? window-stoplight-inset

_ owner-window Ancestor'Window

────────────────────

<This
    + <Box • toolbar-items
        padding-left = if #is-beside-stoplights then #stoplight-inset else gui-toolbar-pad
    + <Box accessory

