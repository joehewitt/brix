+ gui-toolbar-height Length = 52
+ gui-toolbar-pad Length = 10
+ gui-toolbar-gap Length = 8
+ gui-toolbar-item-height Length = 28
+ gui-toolbar-group-pad Length = 3
+ gui-toolbar-group-height Length = gui-toolbar-item-height + (gui-toolbar-group-pad + gui-liquid-glass-border) * 2
+ gui-toolbar-icon Length = 16
+ gui-toolbar-stoplight-offset = Point
    - window-stoplight-offset.x
    - gui-toolbar-height / 2 - window-stoplight-center
+ gui-toolbar-tab-pad Length = 8
+ gui-toolbar-tab-bar-height Length = gui-tab-bar-height - ((gui-tab-bar-height - gui-tab-tray-height) / 2 - 1) + gui-toolbar-tab-pad

