./box
./events
./frame-clock
/graphics/point
/math
/math/motion
/time/duration

_ pinch-reach = 0.7
_ pinch-rubber = 0.55
_ pinch-stiffness = 22.0
_ pinch-rest = 0.001
_ pinch-motion = spring((2 * (π as F64) / pinch-stiffness) as Seconds)

━━━━━━━━━━━━━━━━━━━━
+ PinchChange is Tuple

+ scale F64
+ anchor Point

━━━━━━━━━━━━━━━━━━━━
+ PinchTracker
    is FrameAnimation

+ box Box
+ low = 1.0
+ high = 1.0
+ scale = 1.0
+ anchor = Point(0, 0)
+ is-tracking = false
+ is-settling = false
+ event moved PinchChange
+ event ended PinchChange

_ raw = 1.0
_ target = 1.0
_ settling = MotionChannel([0.0], pinch-rest)

────────────────────
+ This
    - box

────────────────────
+ get is-active Bool

is-tracking || is-settling

────────────────────
+ do handle Bool
    - event MagnifyEvent
    - current F64

. phase = event.phase
if phase == ScrollPhase.none
    is-settling = false
    is-tracking = false
    scale = clamp(current * event.scale, low, high)
    anchor = event.point
    moved <- PinchChange(scale, anchor)
    ended <- PinchChange(scale, anchor)
    = true
if phase == ScrollPhase.began
    is-settling = false
    is-tracking = true
    raw = unshape(current)
    anchor = event.point
=? false if !is-tracking
if phase == ScrollPhase.ended || phase == ScrollPhase.cancelled
    release()
    = true
raw = raw * event.scale
scale = shape(raw)
anchor = event.point
moved <- PinchChange(scale, anchor)
= true

────────────────────
+ do reset

is-tracking = false
is-settling = false

────────────────────
_ do release

is-tracking = false
target = clamp(scale, low, high)
if target == scale || target <= 0
    ended <- PinchChange(scale, anchor)
    =
settling.jump([log(scale / target)])
settling.retarget([0.0], pinch-motion, box.frame-clock?.now ?? 0ns)
is-settling = true
box.animate(this)

────────────────────
_ shape F64
    - value F64

|? value < low && low > 0
    low * exp(-pinch-band(log(low / value)))
|? value > high && high > 0
    high * exp(pinch-band(log(value / high)))
??
    value

────────────────────
_ unshape F64
    - value F64

|? value < low && low > 0
    low * exp(-pinch-unband(log(low / value)))
|? value > high && high > 0
    high * exp(pinch-unband(log(value / high)))
??
    value

────────────────────
+ do advance Bool
    - tick FrameTick

=? false if !is-settling
settling.update(tick.now)
if !settling.is-moving
    finish()
    = false
scale = target * exp(settling.value[0])
moved <- PinchChange(scale, anchor)
= true

────────────────────
+ do finish

=? if !is-settling
is-settling = false
scale = target
ended <- PinchChange(scale, anchor)

━━━━━━━━━━━━━━━━━━━━
_ pinch-band F64
    - distance F64

(1 - 1 / (distance * pinch-rubber / pinch-reach + 1)) * pinch-reach

━━━━━━━━━━━━━━━━━━━━
_ pinch-unband F64
    - stretch F64

pinch-reach * (1 / (1 - min(stretch, pinch-reach * 0.99) / pinch-reach) - 1) / pinch-rubber
