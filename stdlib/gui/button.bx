(import ./box)
(import ./commands)
(import ./events)
(import ./icon)
(import ./keys)
(import ./label)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/text)
(import /math/motion)
(import /time/duration)
(import /ui/input)
(import /units)

(style-extend GUIDefaultTheme
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxPlacement)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFocusRingStyle)
  (using GUIFontStyle)
  (using GUITextPaint)
  (rule Button (• bg gui-field-color) (• text gui-text-color) (• h gui-control-height) (• px gui-control-padding)
    (= font-size gui-control-font-size)
    (= corner-radius gui-control-radius)
    (= shadow gui-control-shadow)
    (= cursor (. CursorStyle pointing-hand))
    (blank)
    (when-style #is-untitled
      (• pl 6)
      (• pr 0)
    )
    (blank)
    (when-style #is-hover-within
      (= background-color (call (. gui-hover-color over) gui-field-color))
    )
    (blank)
    (when-style #is-press-within
      (= background-color (call (. gui-pressed-color over) gui-field-color))
    )
    (blank)
    (when-style #is-destructive
      (• text gui-danger-color)
    )
    (blank)
    (when-style #is-on
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
    (blank)
    (when-style #is-default
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
    (blank)
    (when-style #is-accent-pressed
      (= background-color (call (. gui-pressed-color over) gui-accent-color))
    )
    (blank)
    (when-style (not #is-effectively-enabled)
      (• bg gui-field-color)
      (• text gui-text-color)
      (= cursor (. CursorStyle arrow))
    )
    (blank)
    (when-style #is-focus-visible
      (= focus-ring gui-focus-ring)
      (= (. motion focus-ring) gui-motion-quick)
    )
    (blank)
    (rule button-content
      (= align-x (. Alignment center))
    )
    (blank)
    (rule icon (• w gui-control-icon-size) (• h gui-control-icon-size) (• mr 6))
  )
  (blank)
  (rule button-hint (• text gui-muted-text-color) (• ml 6)
    (= font-size gui-footnote-font-size)
  )
  (blank)
  (rule button-badge (• bg gui-pressed-color) (• text gui-text-color) (• h 16) (• px 6) (• ml 6)
    (= corner-radius 8)
    (= font-size gui-footnote-font-size)
    (= font-weight (. FontWeight bold))
  )
)

(type + ButtonRole (is Union)
  (variant normal)
  (variant default)
  (variant cancel)
  (variant destructive)
)

(type + Button (is Box)
  (prop + title _ (= ""))
  (prop + shorthand (? String))
  (prop + action (? Doer))
  (prop + command (? CommandNode))
  (prop + is-on _ (= (?? (?. #command #is-on) false)))
  (prop + is-enabled _ (= (?? (?. #command #enabled) true)))
  (prop + is-untitled _ (= (== #title "")))
  (prop + role _ (= (. ButtonRole normal)))
  (prop + is-default _ (= (== #role (. ButtonRole default))))
  (prop + is-destructive _ (= (== #role (. ButtonRole destructive))))
  (prop + is-accent-pressed _ (= (and (or #is-on #is-default) #is-press-within)))
  (blank)
  (rule This (• flex-col)
    (= focus-mode (. FocusMode press))
    (= window-draggable false)
    (blank)
    (rule icon
      (= align-y (. Alignment center))
    )
  )
  (blank)
  (rule button-leading)
  (rule button-title)
  (rule button-trailing)
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This
      (<> Box (• button-content) (• icon-host) (• flex-row) (• flex 1) (• items-center)
        (+<> Box (id: leading) (• button-leading))
        (<> Label (• button-title)
          (= text #title)
          (= shorthand #shorthand)
        )
        (+<> Box (id: trailing) (• button-trailing))
      )
      (if (== #role (. ButtonRole default))
        (<> KeyShortcut (text: "Default")
          (= key .enter)
          (= discoverable false)
          (= is-container-wide true)
          (= action (=> () :do (call activate)))
        )
      )
      (if (== #role (. ButtonRole cancel))
        (<> KeyShortcut (text: "Cancel")
          (= key .escape)
          (= discoverable false)
          (= is-container-wide true)
          (= action (=> () :do (call activate)))
        )
      )
    )
  )
  (subscribe-for (on event click)
    (call activate)
    (if (or command action)
      (call (. event cancel))
    )
  )
  (fn-do + activate Bool
    (return-if false (if (not is-effectively-enabled)))
    (let callback action)
    (call (?. command run))
    (if callback
      (call callback)
    )
    (return true)
  )
)
