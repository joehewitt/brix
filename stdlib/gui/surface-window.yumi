requested

────────────────────
+ do run ?! Error

. rendezvous = env(surface-rendezvous-variable)
?! Error("No host is waiting for this program's surface")
    if !rendezvous
C:dup2(output-descriptor, 1)
C:dup2(output-descriptor, 2)
C:close(output-descriptor)
. opened = SurfaceSender(MessageChannel(File(channel-descriptor)), rendezvous)
sender = opened
do finally
    opened.close()
    renderer.close()
open()
accept-window-activated()
. loop = TimerLoop()
frame-loop = loop
loop.loop(frame-interval, step)
. stopped = failure
?! stopped
    if stopped

────────────────────
_ do step

. opened = sender
if !opened || !opened.channel.is-open
    frame-loop?.cancel()
    =
receive(opened)
fit(opened)
    catch error Error
        failure = error
        frame-loop?.cancel()
        =
if requested
    tick()
    . frame = use WindowFrame(this)
    frame.committed = update-frame()

────────────────────
+ do tick

────────────────────
+ do handle
    - message Message

────────────────────
+ do resized

relayout()

────────────────────
+ do relayout

=? if !requested
resize-renderer()
settle-layout()
schedule-render()

────────────────────
_ do resize-renderer

. view = viewport
renderer.resize(view.width, view.height, backing-scale, background ?? transparent)
scene.add-damage(Rect(view))

────────────────────
_ do receive
    - opened SurfaceSender

while true
    . message = opened.channel.poll()
    =? if !message
    if !opened.handle(message)
        dispatch(message)

────────────────────
_ do dispatch
    - message Message

match message.kind as SurfaceMessageKind
    |= .pointer
        . record = message.record'PointerRecord()
        if record
            accept-pointer-record(record)
    |= .key
        . record = message.record'SurfaceKeyRecord()
        if record
            accept-key-record(record, message.text(SurfaceKeyRecord.size))
    |= .text
        . record = message.record'SurfaceTextRecord()
        if record
            accept-text-record(record, message.text(SurfaceTextRecord.size))
    |= .focus
        . record = message.record'SurfaceFocusRecord()
        if record && record.is-focused != 0
            accept-window-activated()
        else if record
            accept-window-deactivated()
    ??
        handle(message)

────────────────────
_ do accept-key-record
    - record SurfaceKeyRecord
    - characters String

. key = key-from-native(record.key, record.native-key-code)
if record.phase == SurfaceKeyPhase.release
    dispatch-key-release(KeyReleaseEvent(key, record.modifiers, record.native-key-code, characters))
    =
dispatch-key-press
    - KeyPressEvent
        - key
        - record.modifiers
        - record.is-repeat != 0
        - record.native-key-code
        - characters
. modifiers = record.modifiers
if characters.length && !modifiers.command && !modifiers.control
    accept-text-action(NativeTextActionKind.input, characters, 0, 0, true)

────────────────────
_ do accept-text-record
    - record SurfaceTextRecord
    - text String

accept-text-action(record.action as NativeTextActionKind, text, record.start, record.length, false)

────────────────────
_ do fit ?! Error
    - opened SurfaceSender

. wanted = opened.wanted
=? if !wanted
. current = requested
if current
    . same-size = current.width == wanted.width && current.height == wanted.height
    =? if same-size && current.scale == wanted.scale
requested = wanted
opened.resize
    - ceil(wanted.width * wanted.scale) as I32
    - ceil(wanted.height * wanted.scale) as I32
    - wanted.scale
size = Dimensions(wanted.width, wanted.height)
resized()

────────────────────
+ get display-scale

if requested then requested.scale else 1

────────────────────
+ do ensure-native

────────────────────
+ do accept-native-scroll
    - event ScrollEvent

. ignored = dispatch-pointer-event(event)

────────────────────
+ do render

. opened = sender
=? false if !opened || !requested
. surface = opened.acquire()
if !surface
    schedule-render()
    = false
. started = monotonic-time-nanoseconds()
. view = viewport
if renderer.width != view.width || renderer.height != view.height || renderer.scale != backing-scale
    resize-renderer()
scene.maintain(this, backing-scale, background ?? transparent)
scene.damage-pending-textures()
renderer.present-into(surface)
. did-encode = scene.frame-metal(renderer)
if renderer.has-pending-fill-frames || scene.has-pending-textures
    schedule-render()
mark-painted()
if !did-encode
    opened.abandon()
    = false
renderer.finish()
opened.deliver(monotonic-time-nanoseconds() - started)
= true
