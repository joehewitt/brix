━━━━━━━━━━━━━━━━━━━━
_ switcher-held-key
    - trigger KeyCombo

KeyCombo(PointerModifiers(false, held.control, held.option, held.command), KeyTrigger.none)

.. held = trigger.modifiers

━━━━━━━━━━━━━━━━━━━━
_ switcher-released
    - held PointerModifiers
    - pressed PointerModifiers

command-released || control-released || option-released

.. command-released = held.command && !pressed.command
.. control-released = held.control && !pressed.control
.. option-released = held.option && !pressed.option
