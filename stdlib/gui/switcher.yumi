────────────────────

<This
    outside-press-passes = false

    for entry in #entries
        <SwitcherRow'Item
            switcher = this
            index = entry.index

            + <Box row - entry SwitcherEntry'Item • flex-row flex:1

    <KeyShortcut "Next"
        key = #trigger
        discoverable = false
        action = => do advance(1)
    if !#trigger.modifiers.shift
        <KeyShortcut "Previous"
            key = #trigger + KeyModifier.shift
            discoverable = false
            action = => do advance(-1)
    <KeyShortcut "Next"
        key = .arrow-down
        discoverable = false
        action = => do advance(1)
    <KeyShortcut "Previous"
        key = .arrow-up
        discoverable = false
        action = => do advance(-1)
    <KeyShortcut "Choose"
        key = .enter
        repeat = false
        discoverable = false
        action = => do choose-selected()
    <SwitcherHold
        key = switcher-held-key(#trigger)
        for modifiers on changed
            release(modifiers)

────────────────────
+ do present
    - choices [Item]
    - key KeyCombo

if is-open
    advance(1)
    =
=? if choices.length == 0
items = choices
trigger = key
selected-index = 0
show()
advance(1)

────────────────────
+ do advance
    - offset Int

. next = ListCursor(items.length, selected-index).wrapped(offset)
if next != null
    selected-index = next

────────────────────
+ do choose-selected

choose-at(selected-index)

────────────────────
+ do choose-at
    - index Size

=? if index >= items.length
choose(items[index])

────────────────────
+ do choose
    - item Item

dismiss(DismissReason.chosen)
chosen <- item

────────────────────
_ do release
    - modifiers PointerModifiers

=? if !is-open || !switcher-released(trigger.modifiers, modifiers)
choose-selected()

