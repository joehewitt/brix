━━━━━━━━━━━━━━━━━━━━
+ HistoryStepRow is Box

+ log EditableLog?
+ step HistoryStep?
+ parts [HistoryPartSlot] = history-part-slots(#step)

• This • flex-row

────────────────────

<This
    <Label number • history-step-number
        align-y = Alignment.center
        text = "${(#step?.index ?? 0) + 1}"
    for slot in #parts keyed by slot.order
        <HistoryPart
            log = log
            id = step?.id ?? 0
            part = slot.part
    if #step?.failure
        <Label failure • history-step-failure
            align-y = Alignment.center
            text = #step?.failure ?? ""

━━━━━━━━━━━━━━━━━━━━
+ HistoryPartSlot is Tuple

+ order Index
+ part CommandSentencePart

━━━━━━━━━━━━━━━━━━━━
+ HistoryPart is Box

+ log EditableLog?
+ id U64 = 0
+ part CommandSentencePart?
+ number = command-sentence-number(#part) if #part
+ point = command-sentence-point(#part) if #part
+ choices = history-part-choices(#part)
+ text = history-part-text(#part)

• This • flex-row

────────────────────

<This
    if #number
        <NumberField number-field • history-number-field
            align-y = Alignment.center
            value = #number!.display-value
            step = #number!.step
            unit = #number!.unit.suffix
            for event on value-changing
                edit
                    - number!.key
                    - CommandParameterValue.number(event.value / number!.unit.display-scale)
                    - event.phase
                event.cancel()
    else if #point
        <NumberField x-field • history-number-field
            align-y = Alignment.center
            label = "X"
            value = #point!.value.x as F64
            for event on value-changing
                edit
                    - point!.key
                    - CommandParameterValue.point(Point(event.value, point!.value.y))
                    - event.phase
                event.cancel()
        <NumberField y-field • history-number-field
            align-y = Alignment.center
            label = "Y"
            value = #point!.value.y as F64
            for event on value-changing
                edit
                    - point!.key
                    - CommandParameterValue.point(Point(point!.value.x, event.value))
                    - event.phase
                event.cancel()
    else if #choices.length
        <Select'String choice-select
            align-y = Alignment.center
            options = #choices
            selected = #text
            for event on selection-changed
                edit
                    - command-part-key(part!) ?? ""
                    - CommandParameterValue.text(event.value)
                    - ValueChangePhase.discrete
    else
        <Label text-label
            align-y = Alignment.center
            text = #text

────────────────────
+ do edit
    - key String
    - value CommandParameterValue
    - phase ValueChangePhase

. active = log
=? if !active || !key.length
. ignored = active.edit-parameter(id, key, value, phase)

━━━━━━━━━━━━━━━━━━━━
_ history-steps [HistoryStep]
    - revision U64
    - log EditableLog?

match log
    |= null
        List'HistoryStep()
    ??
        List'HistoryStep
            ** 0 .. < log.length
            *> HistoryStep
                - each
                - log.step-id(each)
                - log.step-title(each)
                - log.step-sentence(each)
                - log.step-failure(each)

━━━━━━━━━━━━━━━━━━━━
_ history-part-slots [HistoryPartSlot]
    - step HistoryStep?

if step then slots else List'HistoryPartSlot()

.. sentence = step.sentence
.. slots = List'HistoryPartSlot(HistoryPartSlot(each, sentence[each]) in 0 .. < sentence.length)

━━━━━━━━━━━━━━━━━━━━
_ history-part-choices [String]
    - part CommandSentencePart?

match part
    | .input(parameter)
        parameter.options
    ??
        List'String()

━━━━━━━━━━━━━━━━━━━━
_ history-part-text String
    - part CommandSentencePart?

|? !part
    ""
??
    match part
        | .text(value)
            value
        | .number(parameter)
            "${parameter.display-value.places(2)}${parameter.unit.suffix}"
        | .point(parameter)
            "(${(parameter.value.x as F64).places(2)}, ${(parameter.value.y as F64).places(2)})"
        | .input(parameter)
            parameter.value
        | .color(parameter)
            parameter.value
        | .reference(parameter)
            parameter.text
        | .definition(parameter)
            parameter.value
        | .value(parameter)
            parameter.text
