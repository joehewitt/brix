(import ./icon-button)
(import ./icons/lucide/chevron-right)
(import ./styles)
(import ./theme)
(import /math)

(type + DisclosureChevron (is LucideChevronRight)
  (prop + is-open _ (= false))
  (blank)
  (rule This
    (= (. motion rotate) gui-motion-quick)
    (blank)
    (when-style #is-open
      (= rotate (/ π 2))
    )
  )
)

(type + DisclosureButton (is IconButton)
  (prop + is-open _ (= false))
  (blank)
  (rule This
    (rule icon
      (= (. motion rotate) gui-motion-quick)
    )
    (blank)
    (when-style #is-open
      (rule icon
        (= rotate (/ π 2))
      )
    )
  )
)
