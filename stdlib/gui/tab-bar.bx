(import ./box)
(import ./choice-control)
(import ./drag)
(import ./events)
(import ./icon-button)
(import ./icons/lucide/x)
(import ./keys)
(import ./label)
(import ./layout)
(import ./painter)
(import ./position)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./text-input)
(import ./theme)
(import ./window)
(import /core/intrinsics)
(import /core/list-cursor)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /math)
(import /ui/input)
(import /units)
(blank)
(prop + gui-tab-height Length (= 26))
(prop + gui-tab-stroke Length (= 1))
(prop + gui-tab-radius Length (= (/ gui-tab-height 2)))
(prop + gui-tab-icon Length (= 18))
(prop + gui-tab-side Length (= (* (- gui-tab-radius gui-tab-stroke) 2)))
(prop + gui-tab-gap Length (= 2))
(prop + gui-tab-tray-pad Length (= 1.5))
(prop + gui-tab-modified-size Length (= 8))
(prop + gui-tab-divider-width Length (= 1))
(prop + gui-tab-divider-height Length (= 14))
(prop + gui-tab-tray-height Length (= (+ gui-tab-height (* gui-tab-tray-pad 2))))
(prop + gui-tab-bar-height Length (= 34))
(prop + gui-tab-bar-stoplight-offset _
  (=
    (call Point
      (block
        (arg (. window-stoplight-offset x))
        (arg (- (+ (/ gui-tab-bar-height 2) 1) window-stoplight-center))
      )
    )
  )
)

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (using GUIBoxDisplay)
  (using GUIBoxLayout)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxPlacement)
  (using GUIBoxScroll)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFocusRingStyle)
  (using GUITextComposition)
  (using GUITextPaint)
  (rule tab-tray (• p gui-tab-tray-pad) (• gap gui-tab-gap) (• items-center) (• overhang)
    (= align-y (. Alignment center))
    (= corner-radius (+ gui-tab-radius gui-tab-tray-pad))
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-clip-margin gui-tab-tray-pad)
  )
  (blank)
  (rule tab-pill (• text gui-tab-text-color) (• h (- gui-tab-height (* gui-tab-stroke 2))) (• items-center)
    (= border-width gui-tab-stroke)
    (= corner-radius gui-tab-radius)
    (blank)
    (when-style #is-hover-within
      (• text gui-text-color)
    )
    (blank)
    (when-style #shows-hover
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-framed
      (• text gui-strong-text-color)
      (= background-color gui-bevel-fill-color)
      (= background
        (call BevelPainter
          (block
            (arg gui-bevel-edge-color)
            (arg gui-bevel-sheen-color)
            (arg gui-bevel-bounce-color)
            (arg gui-bevel-rim-color)
            (arg gui-bevel-gloss-color)
          )
        )
      )
    )
    (blank)
    (rule tab-divider (• absolute) (• bg gui-tray-divider-color) (• w gui-tab-divider-width) (• h gui-tab-divider-height)
      (= align-y (. Alignment center))
      (= left (call (. PositionOffset coord) (- (+ gui-tab-stroke (/ (+ gui-tab-gap gui-tab-divider-width) 2)))))
      (= display (. Display hidden))
    )
    (blank)
    (when-style #is-divided
      (rule tab-divider
        (= display (. Display visible))
      )
    )
    (blank)
    (rule tab-side (• w gui-tab-side) (• justify-center) (• items-center))
    (blank)
    (rule tab-center (• flex 1) (• justify-center) (• items-center))
    (blank)
    (rule tab-title (• shrink 1)
      (= text-wrap (. TextWrap no-wrap))
      (= text-overflow (. TextOverflow truncate-tail))
    )
    (blank)
    (rule tab-close (• w gui-tab-icon) (• h gui-tab-icon) (• min-w gui-tab-icon) (• min-h gui-tab-icon)
      (= corner-radius (/ gui-tab-icon 2))
      (blank)
      (rule icon (• w 13) (• h 13))
    )
  )
  (blank)
  (rule tab-modified (• bg gui-strong-text-color) (• w gui-tab-modified-size) (• h gui-tab-modified-size)
    (= corner-radius (/ gui-tab-modified-size 2))
  )
  (blank)
  (rule TabBar (• bg gui-window-color) (• h gui-tab-tray-height) (• px 8) (• pt (+ (/ (- gui-tab-bar-height gui-tab-tray-height) 2) 1)) (• pb (- (/ (- gui-tab-bar-height gui-tab-tray-height) 2) 1))
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule TabTray (• bg gui-tab-tray-color))
  (blank)
  (rule Tab
    (= cursor (. CursorStyle arrow))
    (= (. motion position) gui-motion-quick)
    (blank)
    (when-style #is-carried
      (• bg gui-popup-color)
      (• text gui-strong-text-color)
      (= border-color gui-border-color)
      (= background null)
      (= shadow gui-popup-shadow)
    )
    (blank)
    (when-style #is-focus-visible
      (= focus-ring gui-focus-ring)
      (= (. motion focus-ring) gui-motion-quick)
    )
  )
  (blank)
  (rule TabRenameInput (• bg gui-well-color) (• text gui-strong-text-color) (• w 120) (• h 20) (• px 6)
    (= corner-radius gui-control-radius)
    (blank)
    (when-style #is-focused
      (= focus-ring null)
    )
  )
)

(type + (of TabMove T) (is Tuple)
  (prop + value T)
  (prop + index Index)
)

(type + TabDrag (is Tuple)
  (implements DragPayload)
  (prop + strip TabStrip)
  (prop + tab TabBox)
  (fn-expr + drag-kind _ :get
    "tab-bar.tab"
  )
)

(type + (of TabBar T) (is (of ChoiceControl T))
  (prop + is-title-bar _ (= false))
  (prop + is-beside-stoplights _ (= (and #is-title-bar (not (?? (?. owner-window #is-full-screen) false)))))
  (prop + stoplight-inset _ (= (?? (?. owner-window #stoplight-inset) window-stoplight-inset)))
  (prop + is-reorderable _ (= false))
  (event + moved (of TabMove T))
  (blank)
  (prop _ owner-window (of Ancestor Window))
  (blank)
  (rule This
    (when-style #is-title-bar
      (= window-draggable true)
    )
    (when-style #is-beside-stoplights
      (= padding-left #stoplight-inset)
    )
  )
  (content
    (<> This (• flex-row))
  )
  (fn-do + move _
    (param value T)
    (param index Index)
    (<- moved (call (of TabMove T) value index))
  )
)

(type + TabStrip (is Box)
  (prop + tray (? TabTray))
  (prop + order _ (= (call (of List TabBox))))
  (content
    (<> This (• flex-row) (• flex 1) (• items-center)
      (+<> TabTray (• tab-tray) (• flex-row) (• flex 1))
      (+<> Box (id: trailing))
    )
  )
  (subscribe-for (on event drag-over)
    (if (is (. event payload) TabDrag)
      (let drag (as (. event payload) TabDrag))
      (if (and (== (. drag strip) this) tray)
        (call (. event accept) tray)
      )
    )
  )
  (subscribe-for (on event drop (when arrival))
    (if (is (. event payload) TabDrag)
      (let tab (. (as (. event payload) TabDrag) tab))
      (let index (. tab carry-slot))
      (if (!= index null)
        (call (. tab move-tab) index)
      )
    )
  )
  (fn-expr + items _
    (match tray
      (case (: box TabTray)
        (call (of List TabBox)
          (block
            (spread (. box active-children))
            (pipe ?*> (only-if (as each TabBox) (if (is each TabBox))))
          )
        )
      )
      (default
        (call (of List TabBox))
      )
    )
  )
  (fn-do + note-order _
    (let found (call items))
    (return-if (if (call same-tabs found order)))
    (blank)
    (= order found)
  )
)

(type + TabTray (is Box)
  (prop _ strip (of Ancestor TabStrip))
  (fn-do + did-layout _
    (call (. super did-layout))
    (call (?. strip note-order))
  )
  (fn-do + mounted _
    (call (. super mounted))
    (let owner strip)
    (if owner
      (= (. owner tray) this)
    )
  )
)

(type + TabBox (is Box)
  (prop + title _ (= ""))
  (fn-expr + is-tab-selected _ :get
    false
  )
  (fn-do + choose-tab _)
  (fn-do + move-tab _
    (param index Index)
  )
)

(type + (of Tab T) (is TabBox)
  (rule This
    (= focus-mode (. FocusMode press))
    (= window-draggable false)
  )
  (blank)
  (prop + value T)
  (prop + is-selected _ (= (== (?. #bar #selected) #value)))
  (prop + is-framed _ (= #is-selected))
  (prop + shows-hover _ (= (and #is-hover-within (not #is-selected))))
  (prop + is-plain _ (= (and (not #is-selected) (not #is-hover-within) (not #is-carried))))
  (prop + is-divided _ (= (and #is-plain (?? (?. (call tab-leader (?. #strip #order) #value) #is-plain) false))))
  (prop + is-closable _ (= true))
  (prop + is-modified _ (= false))
  (prop + is-untitled _ (= (== #title "")))
  (prop + is-renamable _ (= false))
  (prop + rename-text _ (= #title))
  (prop + rename-selection (? Size))
  (prop + shows-close _ (= (and #is-closable (not #is-untitled) (not #is-renaming) #is-selected (or #is-pointed #is-focus-visible))))
  (event + dismissed (of Tab T))
  (event + renamed String)
  (event + rename-canceled Bool)
  (blank)
  (prop _ bar (of Ancestor (of ChoiceControl T)))
  (prop _ tab-bar (of Ancestor (of TabBar T)))
  (prop _ strip (of Ancestor TabStrip))
  (prop _ is-pointed _ (= false))
  (event _ rename-requested Bool)
  (event _ rename-committed String)
  (content
    (<> This (• tab-pill) (• flex-row) (• flex 1)
      (<> Box (• tab-divider))
      (<> Box (• tab-side) (• flex-row)
        (if #shows-close
          (<> IconButton (• tab-close) (• icon-x)
            (= action (=> () :do (call dismiss)))
          )
        )
      )
      (<> Box (• tab-center) (• flex-row)
        (+<> Box (id: leading) (• flex-row)
          (= align-y (. Alignment center))
        )
        (if #is-renaming
          (<> (of TabRenameInput T) (id: rename-input)
            (= text rename-text)
          )
          (else-if (not #is-untitled)
            (<> Label (• tab-title)
              (= text #title)
            )
          )
        )
      )
      (<> Box (• tab-side) (• flex-row)
        (if #is-modified
          (<> Box (• tab-modified))
        )
      )
      (<> KeyShortcut (text: "Next tab")
        (= key .arrow-right)
        (= discoverable false)
        (= action (=> () :do (call focus-relative 1)))
      )
      (<> KeyShortcut (text: "Previous tab")
        (= key .arrow-left)
        (= discoverable false)
        (= action (=> () :do (call focus-relative -1)))
      )
      (<> KeyShortcut (text: "First tab")
        (= key .home)
        (= discoverable false)
        (= action (=> () :do (call focus-edge false)))
      )
      (<> KeyShortcut (text: "Last tab")
        (= key .end)
        (= discoverable false)
        (= action (=> () :do (call focus-edge true)))
      )
      (<> KeyShortcut (text: "Close tab")
        (= key .delete)
        (= discoverable false)
        (= when (=> () (and is-closable (not is-renaming))))
        (= action (=> () :do (call dismiss)))
      )
      (<> KeyShortcut (text: "Close tab")
        (= key .backspace)
        (= discoverable false)
        (= when (=> () (and is-closable (not is-renaming))))
        (= action (=> () :do (call dismiss)))
      )
      (<> KeyShortcut (text: "Rename tab")
        (= key .enter)
        (= discoverable false)
        (= when (=> () (and is-renamable (not is-renaming))))
        (= action (=> () :do (call begin-rename)))
      )
    )
    (blank)
    (state is-idle)
    (blank)
    (state is-renaming (trigger on rename-requested is-renamable)
      (then is-idle (trigger for name rename-committed)
        (<- renamed name)
      )
      (blank)
      (then is-idle (trigger on rename-canceled))
    )
  )
  (whenever-rule #is-hover-within
    (call settle-close)
  )
  (whenever-rule #is-press-within
    (call settle-close)
  )
  (subscribe-for (on event pointer-down (when (and (== (. event button) (. PointerButton primary)) (not (. event modifiers control)) (== (. event click-count) 1))))
    (call (?. bar choose) value)
  )
  (subscribe-for (on event click)
    (if (>= (. event click-count) 2)
      (call begin-rename)
    )
    (call (. event cancel))
  )
  (subscribe-for (on event drag-start)
    (let owner strip)
    (if (and owner (not is-renaming) (?? (?. tab-bar is-reorderable) false))
      (let ignored (call (. event carry) (call TabDrag owner this)))
    )
  )
  (fn-expr + is-tab-selected _ :get
    is-selected
  )
  (fn-do + choose-tab _
    (call (?. bar choose) value)
  )
  (fn-do + move-tab _
    (param index Index)
    (call (?. tab-bar move) value index)
  )
  (fn-do + dismiss _
    (<- dismissed this)
  )
  (fn-do + begin-rename _
    (<- rename-requested true)
  )
  (fn-do + commit-rename _
    (param next String)
    (<- rename-committed next)
  )
  (fn-do + cancel-rename _
    (<- rename-canceled true)
  )
  (fn-do + focus-relative _
    (param offset Int)
    (let tabs (?? (call (?. strip items)) (call (of List TabBox))))
    (let index (call tab-index tabs this))
    (let next (call (. (call ListCursor (. tabs length) index) stepped) offset))
    (if (!= next null)
      (call focus-tab ([] tabs next))
    )
  )
  (fn-do + focus-edge _
    (param last Bool)
    (let tabs (?? (call (?. strip items)) (call (of List TabBox))))
    (return-if (if (== (. tabs length) 0)))
    (blank)
    (call focus-tab (if-expr last ([] tabs (- (. tabs length) 1)) ([] tabs 0)))
  )
  (fn-do _ focus-tab _
    (param tab TabBox)
    (call (. tab choose-tab))
    (call (. tab request-focus))
  )
  (fn-do _ settle-close _
    (return-if (if is-press-within))
    (blank)
    (= is-pointed is-hover-within)
  )
)

(type + (of TabRenameInput T) (is TextInput)
  (prop _ tab (of Ancestor (of Tab T)))
  (fn-do + mounted _
    (call (. super mounted))
    (call request-focus)
  )
  (subscribe-for (on event focus)
    (let length (?. tab rename-selection))
    (if (!= length null)
      (call select-range 0 length)
      (else
        (call place-caret-at-end)
      )
    )
  )
  (subscribe-for (on event key-press)
    (if (== (. event key) (. Key escape))
      (call (?. tab cancel-rename))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event submit)
    (call (?. tab commit-rename) text)
  )
  (subscribe-for (on event blur)
    (call (?. tab commit-rename) text)
  )
)

(fn-do _ tab-index (? Index)
  (param tabs (list TabBox))
  (param tab TabBox)
  (for (in index (..< 0 (. tabs length)))
    (return-if index (if (== (as ([] tabs index) Pointer) (as tab Pointer))))
  )
)

(fn-do _ (of tab-leader T) (? (of Tab T))
  (param order (? (list TabBox)))
  (param value T)
  (let tabs (?? order (call (of List TabBox))))
  (for (in index (..< 0 (. tabs length)))
    (let tab ([] tabs index))
    (if (and (is tab (of Tab T)) (== (. (as tab (of Tab T)) value) value))
      (return-if null (if (== index 0)))
      (blank)
      (let leader ([] tabs (- index 1)))
      (return-if (as leader (of Tab T)) (if (is leader (of Tab T))))
      (return null)
    )
  )
  (return null)
)

(fn-do _ same-tabs Bool
  (param one (list TabBox))
  (param two (list TabBox))
  (return-if false (if (!= (. one length) (. two length))))
  (blank)
  (for (in index (..< 0 (. one length)))
    (return-if false (if (!= (as ([] one index) Pointer) (as ([] two index) Pointer))))
  )
  (return true)
)
