────────────────────

<This
    <ContextMenu
        <MenuItem "Copy"
            key = copy-key
            is-enabled = #has-selection
            action = => do copy-from-menu()
        <MenuItem "Copy All"
            action = => do copy-all()
        <MenuItem "Paste"
            key = paste-key
            action = => do paste-from-menu()
        <MenuSeparator
        <MenuItem "Clear Scrollback"
            key = KeyCombo("Cmd+K")
            action = => do session.clear-scrollback()

────────────────────
whenever session.#revision

refresh()

────────────────────
for event on key-press

press-key(event)

────────────────────
_ do press-key
    - event KeyPressEvent

. modifiers = event.modifiers
last-key-code = event.native-key-code
. editing = editing-bytes(event.key, modifiers)
if editing
    send-input(editing)
    event.cancel()
    =
if modifiers.command
    if !modifiers.control && !modifiers.option && command-key(event.characters)
        event.cancel()
    =
=? if !is-special-key(event.key) && !modifiers.control
=? if modifiers.control && is-shortcut(event)
. action = if event.is-repeat then TerminalKeyAction.repeat else TerminalKeyAction.press
send-input
    - session.emulator.encode-key
        - event.native-key-code
        - key-mods(modifiers)
        - action
        - null
        - unshifted(event.characters)
event.cancel()

────────────────────
for event on key-release

. bytes = session.emulator.encode-key
    - event.native-key-code
    - key-mods(event.modifiers)
    - TerminalKeyAction.release
    - null
    - unshifted(event.characters)
if bytes
    session.send(bytes)

────────────────────
for event on key-input

input-text(event)

────────────────────
_ do input-text
    - event KeyInputEvent

=? if event.text.size == 0
if event.replaces-before > 0
    . erase = Byte[event.replaces-before]
    for index in 0 .. < event.replaces-before
        erase[index] = terminal-delete-byte
    session.send(erase)
. encoded = session.emulator.encode-key
    - last-key-code
    - key-mods(event.modifiers)
    - TerminalKeyAction.press
    - event.text
if encoded
    send-input(encoded)
else
    send-input(Array'Byte(event.text))

────────────────────
for event on copy

if copy-selection(event.clipboard)
    event.cancel()

────────────────────
for event on paste

if paste-text(event.clipboard)
    event.cancel()

────────────────────
_ do copy-selection Bool
    - clipboard Clipboard

. text = session.emulator.selection-text()
=? false if !text
= clipboard.write-text(text)

────────────────────
_ do paste-text Bool
    - clipboard Clipboard

. text = clipboard.read-text()
=? false if !text
send-input(session.emulator.encode-paste(text))
= true

────────────────────
_ do copy-from-menu

. ignored = copy-selection(Clipboard())

────────────────────
_ do paste-from-menu

. ignored = paste-text(Clipboard())

────────────────────
_ do copy-all

. text = session.emulator.all-text()
if text
    . ignored = Clipboard().write-text(text)

────────────────────
for event on focus

. bytes = session.emulator.encode-focus(true)
if bytes
    session.send(bytes)
invalidate-paint()

────────────────────
for event on blur

. bytes = session.emulator.encode-focus(false)
if bytes
    session.send(bytes)
invalidate-paint()

────────────────────
_ cursor-blink ~>

~> steady
    then blinking on focus

~> blinking on input-sent when is-focused
    then steady on blur
    then steady on closing
    then rested on Timer(terminal-blink-timeout)

    ~> lit
        do repaint-blinking-cursor()
        then dim on Timer(terminal-blink-interval)

    ~> dim
        do repaint-blinking-cursor()
        then lit on Timer(terminal-blink-interval)

~> rested
    do repaint-blinking-cursor()
    then steady on blur
    then steady on closing

────────────────────
for event on pointer-down

press-pointer(event)

────────────────────
_ do press-pointer
    - event PointerDownEvent

. target = hovered?.target
if target && event.button == PointerButton.primary && event.modifiers.command
    path-opened <- target
    event.cancel()
    =
request-focus()
. local = local-point(event.point)
. is-primary = event.button == PointerButton.primary
. is-context = event.button == PointerButton.secondary || (is-primary && event.modifiers.control)
if reports-mouse(event.modifiers)
    is-tracking-press = true
    send-mouse(TerminalMouseAction.press, mouse-button(event.button), event.modifiers, local)
    if is-context
        event.cancel()
    =
=? if !is-primary || is-context
is-selecting = true
drag-point = local
session.emulator.select-press(column-at(local), row-at(local), local.x, local.y)
refresh()

────────────────────
for event on pointer-drag

drag-pointer(event)

────────────────────
_ do drag-pointer
    - event PointerDragEvent

. local = local-point(event.point)
if is-tracking-press
    send-mouse(TerminalMouseAction.motion, mouse-button(event.button), event.modifiers, local)
    =
=? if !is-selecting
drag-point = local
is-rectangle-drag = event.modifiers.option
extend-selection()
start-autoscroll()

────────────────────
_ do extend-selection

session.emulator.select-drag
    - column-at(drag-point)
    - row-at(drag-point)
    - drag-point.x
    - drag-point.y
    - is-rectangle-drag
refresh()

────────────────────
_ do start-autoscroll

=? if is-autoscrolling || autoscroll-delta() == 0
is-autoscrolling = true
autoscroll-remainder = 0
do new
    while step-autoscroll()
        drag-scroll-interval.wait()
    is-autoscrolling = false

────────────────────
_ do step-autoscroll Bool

=? false if !is-selecting || cell-height <= 0
. delta = autoscroll-delta()
=? false if delta == 0
autoscroll-remainder += delta
. rows = (autoscroll-remainder / cell-height) as Int
=? true if rows == 0
autoscroll-remainder -= (rows as Length) * cell-height
=? false if !scroll-backscroll(rows)
extend-selection()
= true

────────────────────
_ autoscroll-delta Length

|? drag-point.y < 0
    -drag-scroll-amount(-drag-point.y)
|? drag-point.y > bottom
    drag-scroll-amount(drag-point.y - bottom)
??
    0

.. bottom = lines.length * cell-height

────────────────────
_ do scroll-backscroll Bool
    - rows Int

. emulator = session.emulator
. resting = emulator.scrollbar.offset
emulator.scroll-by(rows)
=? false if emulator.scrollbar.offset == resting
linger-scroll-indicator()
= true

────────────────────
for event on pointer-up

release-pointer(event)

────────────────────
_ do release-pointer
    - event PointerUpEvent

. local = local-point(event.point)
if is-tracking-press
    is-tracking-press = false
    send-mouse(TerminalMouseAction.release, mouse-button(event.button), event.modifiers, local)
    =
=? if !is-selecting
is-selecting = false
session.emulator.select-release(column-at(local), row-at(local))
refresh()

────────────────────
for event on pointer-move

move-pointer(event)

────────────────────
_ do move-pointer
    - event PointerMoveEvent

hover-point = local-point(event.point)
is-command-held = event.modifiers.command
probe-link()
=? if !session.emulator.is-mouse-tracking
send-mouse
    - TerminalMouseAction.motion
    - TerminalMouseButton.none
    - event.modifiers
    - local-point(event.point)

────────────────────
for event on modifiers-changed

hover-point = local-point(event.point)
is-command-held = event.modifiers.command
probe-link()

────────────────────
whenever #is-hover-within

if !is-hover-within
    hover-point = null
    probe-link()

────────────────────
_ do probe-link

. point = hover-point
if !is-command-held || !point || point.x < 0 || point.y < 0 || cell-height <= 0
    show-hover(null)
    =
. row = row-at(point)
. column = column-at(point)
. columns = session.emulator.columns
if row >= lines.length || column >= columns
    show-hover(null)
    =
. index = row * columns + column
. current = hovered
=? if current && current.columns == columns && index >= current.start && index < current.end
. first = row
while first > 0 && lines[first - 1].wraps
    first -= 1
. last = row
while last + 1 < lines.length && lines[last].wraps
    last += 1
. cells [String]
for joined in first .. < last + 1
    cells ++= terminal-row-cells(lines[joined].runs)
    if joined < last
        while cells.length < (joined - first + 1) * columns
            cells += ""
. span = terminal-path-span(cells, index - first * columns)
if !span
    show-hover(null)
    =
. base = first * columns
show-hover
    - TerminalHover(base + span.start, base + span.end, columns, session.resolve-link(span.text))

────────────────────
_ do show-hover
    - next TerminalHover?

. was-linked = hovered?.target != null
hovered = next
has-link = next?.target != null
if was-linked || has-link
    invalidate-paint()

────────────────────
for event on scroll

scroll-wheel(event)

────────────────────
_ do scroll-wheel
    - event ScrollEvent

=? if cell-height <= 0
. step = if event.is-precise then 1 else cell-height
scroll-remainder += event.delta-y * step
. rows = (scroll-remainder / cell-height) as Int
=? if rows == 0
scroll-remainder -= (rows as Length) * cell-height
event.cancel()
. emulator = session.emulator
if emulator.is-mouse-tracking
    . button = if rows > 0 then TerminalMouseButton.wheel-down else TerminalMouseButton.wheel-up
    . local = local-point(event.point)
    for index in 0 .. < abs(rows)
        send-mouse(TerminalMouseAction.press, button, event.modifiers, local)
else if emulator.is-alternate-screen && emulator.is-alternate-scrolling
    . key-code = if rows > 0 then terminal-down-arrow-code else terminal-up-arrow-code
    for index in 0 .. < abs(rows)
        send-input(emulator.encode-key(key-code, 0, TerminalKeyAction.press, null))
else if scroll-backscroll(rows)
    refresh()

────────────────────
_ is-shortcut Bool
    - event KeyPressEvent

match window
    | host Window
        some(host.key-bindings) • where each.key.matches(event)
    ??
        false

────────────────────
_ do command-key Bool
    - characters String

. emulator = session.emulator
do match characters
    |= "a"
        emulator.select-all()
        refresh()
    |= "k"
        session.clear-scrollback()
    ??
        = false
= true

────────────────────
_ do send-input
    - bytes Byte[]?

=? if !bytes
. emulator = session.emulator
if !emulator.is-viewport-at-bottom
    emulator.scroll-to-bottom()
if emulator.has-selection
    emulator.clear-selection()
session.send(bytes)
input-sent <- true
refresh()

────────────────────
_ do send-mouse
    - action U32
    - button U32
    - modifiers PointerModifiers
    - point Point

. scale = if cell-width > 0 then ceil(cell-width) / cell-width else 1
. bytes = session.emulator.encode-mouse
    - action
    - button
    - key-mods(modifiers)
    - (point.x * scale) as F32
    - point.y as F32
if bytes
    session.send(bytes)

────────────────────
_ reports-mouse Bool
    - modifiers PointerModifiers

session.emulator.is-mouse-tracking && !modifiers.shift

────────────────────
_ local-point Point
    - point Point

Point(point.x - origin.x + frame.x, point.y - origin.y + frame.y)

.. origin = grid-origin()
.. frame = bounds

────────────────────
_ column-at Size
    - point Point

if point.x > 0 && cell-width > 0 then floor(point.x / cell-width) as Size else 0

────────────────────
_ row-at Size
    - point Point

if point.y > 0 && cell-height > 0 then floor(point.y / cell-height) as Size else 0

────────────────────
_ grid-origin Point

Point(round(content.x), round(content.y))

.. content = content-bounds

────────────────────
_ column-offset Length
    - column Size

round(column * cell-width)

────────────────────
_ cell-span Rect
    - origin Point
    - top Length
    - column Size
    - columns Size

Rect(origin.x + left, top, column-offset(column + columns) - left, cell-height)

.. left = column-offset(column)

────────────────────
_ cursor-context TextInputContext?

match shown
    |= null
        null
    ??
        TextInputContext("", "", rect)

        .. rect = Rect
            - origin.x + column-offset(shown.column)
            - origin.y + shown.row * cell-height
            - cell-width
            - cell-height

.. shown = text-cursor
.. origin = grid-origin()

────────────────────
_ do refresh

. emulator = session.emulator
=? if !emulator.is-open || session.is-holding-frame
. palette = theme-colors()
. recolored = shown-colors != palette
if recolored
    shown-colors = palette
    push-colors(emulator, palette)
. dirty = emulator.render-update()
if dirty != terminal-dirty-none || recolored || lines.length != emulator.rows
    fit-lines(emulator.rows)
    . partial = dirty == terminal-dirty-partial && !recolored
    for row in emulator.render-rows(partial)
        if row.y >= 0 && (row.y as Size) < lines.length
            lines[row.y as Size].update(row)
    emulator.render-clean()
text-cursor = emulator.cursor
colors = emulator.colors
backscroll = emulator.scrollbar
has-selection = emulator.has-selection
invalidate-paint()
if is-command-held
    hovered = null
    probe-link()

────────────────────
_ do fit-lines
    - count Size

while lines.length > count
    lines[lines.length - 1].release()
    lines.remove(lines.length - 1)
while lines.length < count
    lines += TerminalLine()

────────────────────
_ do push-colors
    - emulator TerminalEmulator
    - palette [RGBA]

. entries = U32[16]
for index in 0 .. < 16
    entries[index] = rgb-value(palette[index + 3])
emulator.set-colors(rgb-value(palette[0]), rgb-value(palette[1]), rgb-value(palette[2]), entries)
emulator.set-dark(luminance(palette[1]) < 0.5)

────────────────────
_ theme-colors [RGBA]

List'RGBA
    * $gui-terminal-foreground-color
    * $gui-terminal-background-color
    * $gui-terminal-cursor-color
    * $gui-terminal-black-color
    * $gui-terminal-red-color
    * $gui-terminal-green-color
    * $gui-terminal-yellow-color
    * $gui-terminal-blue-color
    * $gui-terminal-magenta-color
    * $gui-terminal-cyan-color
    * $gui-terminal-white-color
    * $gui-terminal-bright-black-color
    * $gui-terminal-bright-red-color
    * $gui-terminal-bright-green-color
    * $gui-terminal-bright-yellow-color
    * $gui-terminal-bright-blue-color
    * $gui-terminal-bright-magenta-color
    * $gui-terminal-bright-cyan-color
    * $gui-terminal-bright-white-color

────────────────────
_ do measure

. font = Font($font-family, $font-size, $font-weight, $font-slant)
=? if font == measured-font
measured-font = font
. wide = use TextLayout("MMMMMMMMMM", font)
cell-width = wide.natural-width / 10
. probe = use TextLayout("M", font)
cell-height = ceil(probe.height) + terminal-line-gap
text-baseline = floor((cell-height - probe.height) / 2) + probe.baseline
for line in lines
    line.release()

────────────────────
_ do layout-line
    - line TerminalLine

line.release()
. segments [TextSegment]
. start Size = 0
for run in line.runs
    if run.has-flag(terminal-run-isolated)
        flush-segments(line, segments, start)
        segments = List'TextSegment()
        . single [TextSegment]
        single += run-segment(run)
        line.layouts += TerminalLayout(run.column, text-layout(single))
    else if run.has-flag(terminal-run-sprite)
        flush-segments(line, segments, start)
        segments = List'TextSegment()
    else
        if segments.length == 0
            start = run.column
        segments += run-segment(run)
flush-segments(line, segments, start)
line.is-laid-out = true

────────────────────
_ do flush-segments
    - line TerminalLine
    - segments [TextSegment]
    - start Size

=? if segments.length == 0
line.layouts += TerminalLayout(start, text-layout(segments))

────────────────────
_ text-layout TextLayout
    - segments [TextSegment]

TextLayout(segments, run-font(false, false), null, TextOverflow.clip, TextWrap.no-wrap)

────────────────────
_ run-segment TextSegment
    - run TerminalRun

TextSegment(0, run.text, font, run-color(run))

.. font = run-font(run.has-flag(terminal-run-bold), run.has-flag(terminal-run-italic))

────────────────────
_ run-color RGBA
    - run TerminalRun

|? run.has-flag(terminal-run-invisible)
    base.with-alpha(0)
|? run.has-flag(terminal-run-faint)
    base.with-alpha(0.5)
??
    base

.. base = rgb-color(run.foreground)

────────────────────
_ do paint-sprites
    - canvas Canvas
    - origin Point
    - top Length
    - run TerminalRun
    - color RGBA

=? if color.alpha <= 0
. stroke = glyph-stroke
. scale = device-scale
canvas.fill-color = color
. column = run.column
for code in run.text.codepoints
    paint-terminal-glyph(canvas, code as U32, cell-span(origin, top, column, 1), stroke, scale)
    column += 1

────────────────────
_ get glyph-stroke Length

cell-width / 8

────────────────────
_ run-font Font
    - is-bold Bool
    - is-italic Bool

Font($font-family, $font-size, weight, slant)

.. weight = if is-bold then FontWeight.bold else FontWeight.regular
.. slant = if is-italic then FontSlant.italic else FontSlant.upright

────────────────────
_ do repaint-blinking-cursor

if text-cursor?.is-blinking ?? false
    invalidate-paint()

────────────────────
_ do paint-cursor
    - canvas Canvas
    - origin Point

. shown = text-cursor
=? if !shown || !shown.is-visible || shown.row >= lines.length
=? if is-focused && shown.is-blinking && cursor-blink is .dim
. x = origin.x + column-offset(shown.column)
. y = origin.y + shown.row * cell-height
canvas.fill-color = rgb-color(colors?.cursor ?? 0xe6edf3)
if !is-focused || shown.style == terminal-cursor-block-hollow
    canvas.rect(Rect(x, y, cell-width, 1))
    canvas.rect(Rect(x, y + cell-height - 1, cell-width, 1))
    canvas.rect(Rect(x, y, 1, cell-height))
    canvas.rect(Rect(x + cell-width - 1, y, 1, cell-height))
else if shown.style == terminal-cursor-bar
    canvas.rect(Rect(x, y, terminal-bar-width, cell-height))
else if shown.style == terminal-cursor-underline
    canvas.rect(Rect(x, y + cell-height - terminal-bar-width, cell-width, terminal-bar-width))
else
    canvas.rect(Rect(x, y, cell-width, cell-height))
    paint-cursor-text(canvas, lines[shown.row], shown.column, x, y)

────────────────────
_ do paint-cursor-text
    - canvas Canvas
    - line TerminalLine
    - column Size
    - x Length
    - y Length

for run in line.runs
    if column >= run.column && column < run.column + run.columns
        . text = cell-text(run, column)
        =? if text.trim().size == 0
        . background = rgb-color(colors?.background ?? 0)
        if run.has-flag(terminal-run-sprite)
            canvas.fill-color = background
            . cell = Rect(x, y, cell-width, cell-height)
            paint-terminal-glyph(canvas, text.codepoints[0] as U32, cell, glyph-stroke, device-scale)
            =
        . segments [TextSegment]
        . font = run-font(run.has-flag(terminal-run-bold), run.has-flag(terminal-run-italic))
        segments += TextSegment(0, text, font, background)
        . layout = use text-layout(segments)
        canvas.draw-text
            - layout
            - Rect(x, y + text-baseline - layout.baseline, layout.width, layout.height)
            - TextAlignment.left
        =

────────────────────
_ cell-text String
    - run TerminalRun
    - column Size

if isolated then run.text else "${run.text.codepoints[column - run.column]}"

.. isolated = run.has-flag(terminal-run-isolated)

────────────────────
_ do paint-link
    - canvas Canvas
    - origin Point
    - shown TerminalHover

. columns = shown.columns
. first = shown.start / columns
. last = (shown.end - 1) / columns
canvas.fill-color = $gui-terminal-link-color
for row in first .. < min(last + 1, lines.length)
    . from = if row == first then shown.start % columns else 0
    . to = if row == last then (shown.end - 1) % columns + 1 else columns
    . left = origin.x + column-offset(from)
    . baseline = origin.y + row * cell-height + text-baseline
    canvas.rect
        - Rect(left, baseline + 1, origin.x + column-offset(to) - left, terminal-underline-height)

────────────────────
+ do mounted

super.mounted()
refresh()

────────────────────
+ do close

closing <- true
for line in lines
    line.release()
lines.clear()
super.close()

────────────────────
+ do did-layout

super.did-layout()
measure()
. content = content-bounds
=? if cell-width <= 0 || cell-height <= 0 || content.width <= 0 || content.height <= 0
. columns = max(1, floor(content.width / cell-width) as Size)
. rows = max(1, floor(content.height / cell-height) as Size)
session.resize(columns, rows, ceil(cell-width) as Size, cell-height as Size)
refresh()

────────────────────
+ do paint-self
    - canvas Canvas

. content = content-bounds
. origin = grid-origin()
. background = rgb-color(colors?.background ?? rgb-value($gui-terminal-background-color))
canvas.fill-color = background
canvas.rect(padding-bounds)
=? if cell-width <= 0 || cell-height <= 0
do use canvas.saved-state
    canvas.clip(content)
    for index in 0 .. < lines.length
        . line = lines[index]
        . top = origin.y + index * cell-height
        for run in line.runs
            if run.has-background
                canvas.fill-color = rgb-color(run.background)
                canvas.rect(cell-span(origin, top, run.column, run.columns))
        if line.selection-start >= 0
            canvas.fill-color = $gui-terminal-selection-color
            . span = (line.selection-end - line.selection-start + 1) as Size
            canvas.rect(cell-span(origin, top, line.selection-start, span))
        if !line.is-laid-out
            layout-line(line)
        . baseline = top + text-baseline
        for item in line.layouts
            . layout = item.layout
            canvas.draw-text
                - layout
                - Rect
                    - origin.x + column-offset(item.column)
                    - baseline - layout.baseline
                    - layout.width
                    - layout.height
                - TextAlignment.left
        for run in line.runs
            if run.has-flag(terminal-run-sprite)
                paint-sprites(canvas, origin, top, run, run-color(run))
            .. struck = run.has-flag(terminal-run-strike)
            .. overlined = run.has-flag(terminal-run-overline)
            . decorated = run.has-flag(terminal-run-underline) || struck || overlined
            if decorated
                . left = origin.x + column-offset(run.column)
                . width = column-offset(run.column + run.columns) - column-offset(run.column)
                canvas.fill-color = rgb-color(run.foreground)
                if run.has-flag(terminal-run-underline)
                    canvas.rect(Rect(left, baseline + 1, width, terminal-underline-height))
                if run.has-flag(terminal-run-strike)
                    canvas.rect
                        - Rect(left, top + floor(cell-height / 2), width, terminal-underline-height)
                if run.has-flag(terminal-run-overline)
                    canvas.rect(Rect(left, top, width, terminal-underline-height))
    . shown = hovered
    if shown && shown.target != null && shown.columns > 0
        paint-link(canvas, origin, shown)

────────────────────
+ do paint-overlay
    - canvas Canvas

. content = content-bounds
=? if cell-width <= 0 || cell-height <= 0
do use canvas.saved-state
    canvas.clip(content)
    paint-cursor(canvas, grid-origin())

────────────────────
+ shows-scroll-indicator
    - axis Orientation

|? axis == Orientation.horizontal || $scroll-indicator-y == ScrollIndicatorVisibility.hidden
    false
|? $scroll-indicator-y == ScrollIndicatorVisibility.always
    true
|? backscroll.total <= backscroll.length
    false
??
    has-lingering-scroll-indicator()

────────────────────
+ scroll-axis-snapshot
    - axis Orientation

|? axis == Orientation.horizontal
    super.scroll-axis-snapshot(axis)
??
    ScrollAxisSnapshot
        - backscroll.offset * cell-height
        - 0
        - max(0, content - viewport)
        - viewport
        - content
        - true

.. viewport = backscroll.length * cell-height
.. content = backscroll.total * cell-height

────────────────────
+ do scroll-indicator-seek Bool
    - axis Orientation
    - position Length

=? false if axis == Orientation.horizontal || cell-height <= 0
. row = round(max(0, position) / cell-height) as Size
=? false if row == backscroll.offset
session.emulator.scroll-to-row(row)
linger-scroll-indicator()
refresh()
= true

━━━━━━━━━━━━━━━━━━━━
_ is-special-key Bool
    - key Key

match key
    | .space
        false
    | .unknown
        false
    ??
        true

━━━━━━━━━━━━━━━━━━━━
_ do editing-bytes Byte[]?
    - key Key
    - modifiers PointerModifiers

=? null if modifiers.shift || modifiers.control || modifiers.option == modifiers.command
= match key
    | .arrow-left
        if modifiers.option then terminal-word-left-bytes else terminal-line-start-bytes
    | .arrow-right
        if modifiers.option then terminal-word-right-bytes else terminal-line-end-bytes
    ??
        null

━━━━━━━━━━━━━━━━━━━━
_ key-mods U32
    - modifiers PointerModifiers

shift /or/ control /or/ alt /or/ command /or/ caps

.. shift = if modifiers.shift then terminal-mods-shift else 0u32
.. control = if modifiers.control then terminal-mods-control else 0u32
.. alt = if modifiers.option then terminal-mods-alt else 0u32
.. command = if modifiers.command then terminal-mods-super else 0u32
.. caps = if modifiers.caps-lock then terminal-mods-caps-lock else 0u32

━━━━━━━━━━━━━━━━━━━━
_ unshifted U32
    - characters String

if code >= 32 && code < 127 then code else 0

.. lowered = characters.lowercased
.. code = if lowered.size > 0 then (lowered.codepoints[0] as U32) else 0u32

━━━━━━━━━━━━━━━━━━━━
_ mouse-button U32
    - button PointerButton

match button
    | .primary
        TerminalMouseButton.left
    | .secondary
        TerminalMouseButton.right
    | .middle
        TerminalMouseButton.middle
    ??
        TerminalMouseButton.none

━━━━━━━━━━━━━━━━━━━━
_ rgb-value U32
    - color RGBA

(red /lshift/ 16) /or/ (green /lshift/ 8) /or/ blue

.. red = color-channel-byte(color.red) as U32
.. green = color-channel-byte(color.green) as U32
.. blue = color-channel-byte(color.blue) as U32

━━━━━━━━━━━━━━━━━━━━
_ rgb-color RGBA
    - value U32

RGBA(red, green, blue, 1)

.. red = (((value /rshift/ 16) /and/ 255) as F64) / 255
.. green = (((value /rshift/ 8) /and/ 255) as F64) / 255
.. blue = ((value /and/ 255) as F64) / 255

━━━━━━━━━━━━━━━━━━━━
_ luminance F64
    - color RGBA

color.red * 0.299 + color.green * 0.587 + color.blue * 0.114
