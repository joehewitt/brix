_ terminal-blink-interval = 530ms
_ terminal-blink-timeout = 10s
_ terminal-line-gap Length = 2
_ terminal-bar-width Length = 2
_ terminal-underline-height Length = 1
_ terminal-delete-byte Byte = 127
_ terminal-down-arrow-code U32 = 125
_ terminal-up-arrow-code U32 = 126
_ terminal-word-left-bytes = Array'Byte("\x1bb")
_ terminal-word-right-bytes = Array'Byte("\x1bf")
_ terminal-line-start-bytes = Array'Byte("\x01")
_ terminal-line-end-bytes = Array'Byte("\x05")

