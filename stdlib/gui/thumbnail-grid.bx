(import ./box)
(import ./events)
(import ./keys)
(import ./primitives)
(import ./styles)
(import ./theme)
(import ./virtual)
(import ./window)
(import /core/style)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/image)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/thumbnail-cache)
(import /math)
(import /os/path)
(import /stream/aggregate)
(import /ui/input)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)
(prop _ thumbnail-stack-depth _ (= 0.05))

(type + GUIThumbnailStyle (is Style)
  (prop + thumbnail-placeholder-color _ (= (call RGBA "#ffffff0d")))
  (prop + thumbnail-stack-color _ (= (call RGBA "#3a3b41")))
  (prop + thumbnail-stack-edge-color _ (= (call RGBA "#ffffff2e")))
  (prop + thumbnail-backdrop-color RGBA @inherited (= (call RGBA 0 0 0 0)))
  (blank)
  (style-domains thumbnail-placeholder-color (domain paint))
  (style-domains thumbnail-stack-color (domain paint))
  (style-domains thumbnail-stack-edge-color (domain paint))
  (style-domains thumbnail-backdrop-color (domain paint))
)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUIBoxSpacing)
  (using GUIThumbnailStyle)
  (rule ThumbnailCell (• p 6)
    (= corner-radius gui-control-radius)
    (blank)
    (when-style #is-selected
      (• bg gui-pressed-color)
    )
  )
  (blank)
  (rule ThumbnailGrid
    (when-style #is-focused
      (rule ThumbnailCell
        (when-style #is-selected
          (• bg gui-accent-color)
        )
      )
    )
  )
)

(type + ThumbnailGrid (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
    (= window-draggable false)
  )
  (blank)
  (prop + paths (list Path))
  (prop + stack-sizes (map Path Size))
  (prop + cache (? ThumbnailCache))
  (prop + cell-length Length (= 160))
  (prop + min-cell-length Length (= 64))
  (prop + max-cell-length Length (= 512))
  (prop + spacing Length (= 4))
  (prop + selected (? Path))
  (prop + path-source _ (:= (call (of VirtualListSource Path))))
  (prop + grid-layout VerticalGridLayout (= (call thumbnail-grid-layout #cell-length #spacing)))
  (blank)
  (event + chosen Path)
  (event + opened Path)
  (event + zoomed Length)
  (blank)
  (prop _ owned-cache (? ThumbnailCache))
  (prop _ is-live _ (= false))
  (prop _ is-scrolling-up _ (= false))
  (prop _ zoom-anchor I64 (= -1))
  (prop _ zoom-top Length)
  (prop _ zoom-fraction F64)
  (blank)
  (depends paths-changed paths)
  (content
    (<> This (• flex-col)
      (<> KeyShortcut (text: "Previous")
        (= key .arrow-left)
        (= discoverable false)
        (= action (=> () :do (call move-selection -1)))
      )
      (<> KeyShortcut (text: "Next")
        (= key .arrow-right)
        (= discoverable false)
        (= action (=> () :do (call move-selection 1)))
      )
      (<> KeyShortcut (text: "Above")
        (= key .arrow-up)
        (= discoverable false)
        (= action (=> () :do (call move-selection (- column-count))))
      )
      (<> KeyShortcut (text: "Below")
        (= key .arrow-down)
        (= discoverable false)
        (= action (=> () :do (call move-selection column-count)))
      )
      (<> KeyShortcut (text: "First")
        (= key .home)
        (= discoverable false)
        (= action (=> () :do (call select-index 0)))
      )
      (<> KeyShortcut (text: "Last")
        (= key .end)
        (= discoverable false)
        (= action (=> () :do (call select-index (- (as (. paths length) Int) 1))))
      )
      (<> KeyShortcut (text: "Open")
        (= key .enter)
        (= repeat false)
        (= discoverable false)
        (= action (=> () :do (call open-selected)))
      )
      (blank)
      (<> (of VirtualRegion Path) (id: rows) (• flex 1) (• p 4)
        (= source path-source)
        (= virtual-layout #grid-layout)
        (= overscan (call thumbnail-grid-overscan #cell-length #spacing))
        (blank)
        (<> ThumbnailCell (id: cell) (slot: row) (param: slot)
          (= grid this)
          (= path (. slot #item))
          (= address (. slot #address))
          (= is-bound (. slot #is-bound))
        )
        (blank)
        (for (on event scroll-changed (when arrival))
          (call note-scroll event)
        )
        (blank)
        (for (on event magnify)
          (call zoom-with-magnify event)
        )
      )
    )
  )
  (fn-do + thumbnail-cache ThumbnailCache :get
    (return-if cache (if cache))
    (blank)
    (let owned owned-cache)
    (return-if owned (if owned))
    (blank)
    (let created (call ThumbnailCache))
    (= owned-cache created)
    (return created)
  )
  (fn-expr + column-count Int :get
    (call (. grid-layout column-count) (as (call floor (. rows content-bounds width)) I64))
  )
  (fn-expr + thumbnail-priority F64
    (param address I64)
    (case? (and (>= address first) (<= address last))
      (as (- address first) F64)
    )
    (case? (!= is-below is-scrolling-up)
      (+ visible distance)
    )
    (default
      (+ visible (as columns F64) distance)
    )
    (where
      (lazy content (. rows content-bounds))
      (lazy width (as (call floor (. content width)) I64))
      (lazy columns (as (call (. grid-layout column-count) width) I64))
      (lazy pitch (as (+ (call (. grid-layout cell-extent) width) (. grid-layout spacing)) Length))
      (lazy top (. rows scroll-y))
      (lazy top-row (as (call floor (/ top pitch)) I64))
      (lazy bottom-row (as (call floor (/ (+ top (call max 0 (- (. content height) 1))) pitch)) I64))
      (lazy first (* top-row columns))
      (lazy last (- (* (+ bottom-row 1) columns) 1))
      (lazy visible (as (+ (- last first) 1) F64))
      (lazy is-below (> address last))
      (lazy distance (if-expr is-below (as (- address last) F64) (as (- first address) F64)))
    )
  )
  (fn-do + begin-zoom _
    (param focus (? Point) (= null))
    (= zoom-anchor -1)
    (return-if (if (== (. paths length) 0)))
    (blank)
    (let content (. rows content-bounds))
    (let point (?? focus (call Point (+ (. content x) (/ (. content width) 2)) (+ (. content y) (/ (. content height) 2)))))
    (let local (call Point (- (. point x) (. content x)) (- (. point y) (. content y))))
    (let width (as (call floor (. content width)) I64))
    (let columns (as (call (. grid-layout column-count) width) I64))
    (let cell (as (call (. grid-layout cell-extent) width) Length))
    (let pitch (as (+ cell (. grid-layout spacing)) Length))
    (let inset (as (call (. grid-layout leading-inset) width) Length))
    (let column (call min (as (call max 0 (call round (/ (- (. local x) inset (/ cell 2)) pitch))) I64) (- columns 1)))
    (let row (as (call max 0 (call round (/ (- (+ (. rows scroll-y) (. local y)) (/ cell 2)) pitch))) I64))
    (let address (call min (+ (* row columns) column) (- (as (. paths length) I64) 1)))
    (let y (- (* (as (/ address columns) Length) pitch) (. rows scroll-y)))
    (= zoom-anchor address)
    (= zoom-top (. local y))
    (= zoom-fraction (/ (- (. local y) y) cell))
  )
  (fn-do + zoom-to _
    (param length Length)
    (let next (call max min-cell-length (call min max-cell-length length)))
    (return-if (if (== next cell-length)))
    (blank)
    (let is-zooming (>= zoom-anchor 0))
    (if (not is-zooming)
      (call begin-zoom)
    )
    (call apply-zoom next)
    (if (not is-zooming)
      (call end-zoom)
    )
  )
  (fn-do + end-zoom _
    (= zoom-anchor -1)
  )
  (fn-do _ apply-zoom _
    (param next Length)
    (= cell-length next)
    (if (>= zoom-anchor 0)
      (let layout (call thumbnail-grid-layout next spacing))
      (let width (as (call floor (. rows content-bounds width)) I64))
      (let columns (as (call (. layout column-count) width) I64))
      (let cell (as (call (. layout cell-extent) width) Length))
      (let pitch (as (+ cell (. layout spacing)) Length))
      (let row (as (/ zoom-anchor columns) Length))
      (call (. rows restore-scroll) (call Point 0 (call max 0 (+ (- (* row pitch) zoom-top) (* zoom-fraction cell)))))
    )
    (<- zoomed next)
  )
  (fn-do _ zoom-with-magnify _
    (param event MagnifyEvent)
    (if (== (. event phase) (. ScrollPhase began))
      (call begin-zoom (. event point))
    )
    (call zoom-to (* cell-length (. event scale)))
    (if (or (== (. event phase) (. ScrollPhase ended)) (== (. event phase) (. ScrollPhase cancelled)))
      (call end-zoom)
    )
    (call (. event cancel))
  )
  (fn-do + scroll-to-top _
    (call (. rows restore-scroll) (call Point 0 0))
  )
  (fn-do + select _
    (param path Path)
    (if (!= selected path)
      (= selected path)
    )
    (call reveal-path path)
    (<- chosen path)
  )
  (fn-do + open _
    (param path Path)
    (call select path)
    (<- opened path)
  )
  (fn-do + select-index _
    (param index Int)
    (return-if (if (== (. paths length) 0)))
    (blank)
    (call select ([] paths (as (call max 0 (call min index (- (as (. paths length) Int) 1))) Size)))
  )
  (fn-do + move-selection _
    (param offset Int)
    (let current selected-index)
    (if (== current null)
      (call select-index 0)
      (return)
    )
    (let next (+ current offset))
    (return-if (if (or (< next 0) (>= next (as (. paths length) Int)))))
    (blank)
    (call select-index next)
  )
  (fn-do + open-selected _
    (let current selected)
    (if current
      (call open current)
    )
  )
  (fn-expr + selected-index (? Int) :get
    (match current
      (case= null
        null
      )
      (default
        (call first (in (as each Int) (..< 0 (. paths length)) (when (== ([] paths each) current))))
      )
    )
    (where
      (lazy current selected)
    )
  )
  (fn-do _ note-scroll _
    (param event ScrollChangedEvent)
    (let delta (- (. event position y) (. event old-position y)))
    (if (!= delta 0)
      (= is-scrolling-up (< delta 0))
    )
  )
  (fn-do _ reveal-path _
    (param path Path)
    (return-if (if (not is-live)))
    (blank)
    (for (in index (..< 0 (. paths length)))
      (if (== ([] paths index) path)
        (let ignored (call (. rows scroll-to-address) index (. ScrollAlignment nearest)))
        (return)
      )
    )
  )
  (fn-do _ paths-changed _
    (call (. path-source replace) paths)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (= is-live true)
    (call (. path-source replace) paths)
  )
  (fn-do + unmounted _
    (= is-live false)
    (call (. super unmounted))
  )
  (fn-do + reveal-focus _
    (let current selected)
    (if current
      (call reveal-path current)
      (else
        (call (. super reveal-focus))
      )
    )
  )
  (fn-do + close _
    (call (. super close))
    (call (?. owned-cache close))
    (= owned-cache null)
  )
)

(type + ThumbnailCell (is Box)
  (implements ThumbnailClient)
  (using GUIThumbnailStyle)
  (prop + grid (? ThumbnailGrid))
  (prop + path (? Path))
  (prop + address I64)
  (prop + is-bound _ (= false))
  (prop + is-selected _ (= (and #is-bound (!= #path null) (== (?. #grid #selected) #path))))
  (prop + stack-size _ (= (call thumbnail-stack-size (?. #grid #stack-sizes) #path #is-bound)))
  (blank)
  (prop _ shown (? ThumbnailTicket))
  (prop _ wanted (? ThumbnailTicket))
  (prop _ ticket-path (? Path))
  (prop _ ticket-cache (? ThumbnailCache))
  (prop _ pixel-size I32)
  (blank)
  (depends thumbnail-changed grid path is-bound)
  (depends invalidate-paint stack-size)
  (subscribe-for (on event pointer-down)
    (call handle-pointer-down event)
  )
  (fn-expr + image (? Image) :get
    (?. shown image)
  )
  (fn-do _ handle-pointer-down _
    (param event PointerDownEvent)
    (let owner grid)
    (let target path)
    (return-if (if (or (!= (. event button) (. PointerButton primary)) (not owner) (not target) (not is-bound))))
    (blank)
    (if (>= (. event click-count) 2)
      (call (. owner open) target)
      (else
        (call (. owner select) target)
      )
    )
  )
  (fn-do _ thumbnail-changed _
    (let owner grid)
    (let target path)
    (if (or (not owner) (not target) (not is-bound))
      (call release-tickets)
      (return)
    )
    (let cache (. owner thumbnail-cache))
    (if (or (!= ticket-path target) (!= (as ticket-cache (? Pointer)) (as cache Pointer)))
      (call release-tickets)
      (= ticket-path target)
      (= ticket-cache cache)
      (= shown (call (. cache ready-ticket) target this))
      (call invalidate-paint)
    )
    (return-if (if (<= pixel-size 0)))
    (blank)
    (let bucket (call (. cache bucket-for) pixel-size))
    (if (== (. (?. shown entry) bucket) bucket)
      (call drop-wanted)
      (return)
    )
    (return-if (if (== (. (?. wanted entry) bucket) bucket)))
    (blank)
    (call drop-wanted)
    (let ticket (call (. cache request) target pixel-size this))
    (if (. ticket is-settled)
      (call adopt ticket)
      (else
        (= wanted ticket)
      )
    )
  )
  (fn-do _ adopt _
    (param ticket ThumbnailTicket)
    (let previous shown)
    (= shown ticket)
    (if previous
      (call (?. ticket-cache cancel) previous)
    )
    (call invalidate-paint)
  )
  (fn-do _ drop-wanted _
    (let pending wanted)
    (return-if (if (not pending)))
    (blank)
    (= wanted null)
    (call (?. ticket-cache cancel) pending)
  )
  (fn-do _ release-tickets _
    (call drop-wanted)
    (let previous shown)
    (if previous
      (= shown null)
      (call (?. ticket-cache cancel) previous)
      (call invalidate-paint)
    )
    (= ticket-path null)
    (= ticket-cache null)
  )
  (fn-expr + thumbnail-priority F64
    (param ticket ThumbnailTicket)
    (if-expr owner (call (. owner thumbnail-priority) address) 0)
    (where
      (lazy owner grid)
    )
  )
  (fn-do + thumbnail-loaded _
    (param ticket ThumbnailTicket)
    (if (and wanted (== (as wanted Pointer) (as ticket Pointer)))
      (= wanted null)
      (call adopt ticket)
      (else-if (and shown (== (as shown Pointer) (as ticket Pointer)))
        (call invalidate-paint)
      )
    )
  )
  (fn-do + unmounted _
    (call release-tickets)
    (call (. super unmounted))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (let content content-bounds)
    (let scale (?? (?. (call (of ancestor Window)) backing-scale) 1))
    (let size (as (call ceil (* (call max (. content width) (. content height)) scale)) I32))
    (if (!= size pixel-size)
      (= pixel-size size)
      (call thumbnail-changed)
    )
  )
  (fn-do + close _
    (call release-tickets)
    (call (. super close))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let content content-bounds)
    (return-if (if (or (<= (. content width) 0) (<= (. content height) 0))))
    (blank)
    (let current (?. shown image))
    (if (or (not current) (. current is-released))
      (do-use (. canvas saved-state)
        (= (. canvas stroke-color) null)
        (= (. canvas fill-color) $thumbnail-placeholder-color)
        (call (. canvas rect) content)
      )
      (return)
    )
    (let depth (if-expr (> stack-size 1) (* (call min (. content width) (. content height)) thumbnail-stack-depth) 0))
    (let fitted
      (call image-fit-rect
        (block
          (arg (. current size))
          (arg (call Rect (. content x) (. content y) (- (. content width) (* depth 2)) (- (. content height) (* depth 2))))
          (arg (. ImageFit contain))
          (arg (. AnchorPoint center))
          (arg (. AnchorPoint center))
        )
      )
    )
    (let rect
      (call Rect
        (block
          (arg (+ (. content x) (/ (- (. content width) (. fitted width) (* depth 2)) 2)))
          (arg (+ (. content y) (/ (- (. content height) (. fitted height) (* depth 2)) 2) (* depth 2)))
          (arg (. fitted width))
          (arg (. fitted height))
        )
      )
    )
    (let backdrop (if-expr (> depth 0) $thumbnail-stack-color $thumbnail-backdrop-color))
    (do-use (. canvas saved-state)
      (= (. canvas fill-color) $thumbnail-stack-color)
      (= (. canvas stroke-color) $thumbnail-stack-edge-color)
      (= (. canvas stroke-width) 1)
      (if (> depth 0)
        (for (in layer (list 2.0 1.0))
          (call (. canvas rect)
            (block
              (arg (call Rect (+ (. rect x) (* depth layer)) (- (. rect y) (* depth layer)) (. rect width) (. rect height)))
            )
          )
        )
      )
      (if (> (. backdrop alpha) 0)
        (= (. canvas fill-color) backdrop)
        (call (. canvas rect) rect)
      )
    )
    (call (. current draw) (:destination canvas)
      (block
        (arg rect)
        (arg (. ImageSampling smooth))
      )
    )
  )
)

(fn-expr _ thumbnail-grid-layout VerticalGridLayout
  (param cell-length Length)
  (param spacing Length)
  (call VerticalGridLayout (as (call max 1 (call floor cell-length)) I64) (as (call max 0 (call floor spacing)) I64))
)

(fn-expr _ thumbnail-grid-overscan VirtualInsets
  (param cell-length Length)
  (param spacing Length)
  (call VirtualInsets pitch 0vcoord pitch 0vcoord)
  (where
    (lazy pitch (as (+ (call max 1 (call floor cell-length)) (call max 0 (call floor spacing))) I64))
  )
)

(fn-expr _ thumbnail-stack-size Size
  (param sizes (? (map Path Size)))
  (param path (? Path))
  (param is-bound Bool)
  (if-expr (and is-bound sizes path) (?? ([] sizes path) 1) 1)
)
