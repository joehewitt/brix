./events
/graphics/point
/math

_ glide-step F64 = 0.008333
_ glide-substep F64 = 0.004
_ glide-stop-speed F64 = 0.12
_ glide-interrupt-speed F64 = 2

━━━━━━━━━━━━━━━━━━━━
+ ScrollResampler

+ lag F64 = 0.010
+ span F64 = 0.0167

_ events [ScrollEvent]
_ starts [F64]
_ spent F64
_ last-time F64
_ motion-time F64
_ horizon F64
_ glide ScrollEvent?
_ glide-time F64
_ glide-velocity Point
_ glide-end ScrollEvent?
_ is-gliding = false
_ is-glide-pending = false
_ is-overriding = false
_ momentum-step F64

────────────────────
+ get is-idle

events.length == 0 && !is-gliding && !is-glide-pending

────────────────────
+ do accept Bool
    - event ScrollEvent

=? false if lag <= 0
. time = event.ordering-time
. momentum = event.momentum-phase
if is-overriding && event.is-precise
    if momentum == ScrollPhase.changed
        momentum-step = event.delta.length
        = true
    if momentum == ScrollPhase.ended || momentum == ScrollPhase.cancelled
        is-overriding = false
        . ended = scroll-resampler-moved(event, Point(0, 0))
        . is-natural = momentum == ScrollPhase.ended && momentum-step < glide-interrupt-speed
        if is-natural && (is-gliding || is-glide-pending)
            glide-end = ended
        else
            enqueue(ended, time)
        = true
if is-gliding || is-glide-pending
    enqueue(event, time)
    = true
if event.is-precise && momentum == ScrollPhase.began
    is-overriding = true
    is-glide-pending = true
    momentum-step = event.delta.length
    enqueue(event, time, max(horizon, motion-time))
    = true
if events.length == 0 && !(event.is-precise && scroll-resampler-moves(event))
    last-time = time
    = false
enqueue(event, time)
= true

────────────────────
+ do take [ScrollEvent]
    - frame-time F64

=? drain() if frame-time <= 0
. taken = List'ScrollEvent()
horizon = max(horizon, frame-time - lag)
while events.length > 0
    . event = events[0]
    . time = event.ordering-time
    . start = starts[0]
    . begins-glide = event.is-precise && event.momentum-phase == ScrollPhase.began
    if begins-glide && start <= horizon
        if is-gliding
            advance-glide(start, taken)
            finish-glide(taken)
        start-glide(event, start)
        taken += scroll-resampler-moved(event, Point(0, 0))
        pop()
    else if time <= horizon
        if is-gliding
            advance-glide(time, taken)
            finish-glide(taken)
        if spent < 1
            taken += scroll-resampler-part(event, 1 - spent, true)
        pop()
    else
        if !begins-glide && scroll-resampler-moves(event)
            . fraction = min(1, max(0, (horizon - start) / max(time - start, 0.0001)))
            if fraction > spent
                taken += scroll-resampler-part(event, fraction - spent, false)
                spent = fraction
        break
if is-gliding
    advance-glide(horizon, taken)
= taken

────────────────────
+ do drain [ScrollEvent]

. taken = List'ScrollEvent()
while events.length > 0
    if spent < 1
        taken += scroll-resampler-part(events[0], 1 - spent, true)
    pop()
finish-glide(taken)
= taken

────────────────────
_ do enqueue
    - event ScrollEvent
    - time F64
    - since F64? = null

. previous = since ?? last-time
. start = if previous > 0 then max(previous, time - span) else time - span
events += event
starts += min(start, time)
last-time = time
if scroll-resampler-moves(event)
    motion-time = time

────────────────────
_ do pop

events.remove(0)
starts.remove(0)
spent = 0

────────────────────
_ do start-glide
    - event ScrollEvent
    - time F64

is-glide-pending = false
is-gliding = true
glide = event
glide-time = time
glide-velocity = Point(event.delta-x / glide-step, event.delta-y / glide-step)

────────────────────
_ do advance-glide
    - time F64
    - taken [ScrollEvent]

. template = glide
=? if !template || time <= glide-time
. delta-x F64
. delta-y F64
. velocity = glide-velocity
. remaining = time - glide-time
while remaining > 0
    . speed = velocity.length * glide-step
    if speed < glide-stop-speed
        is-gliding = false
        break
    . step = min(remaining, glide-substep)
    . rate = -log(scroll-resampler-decay(speed)) / glide-step
    . kept = exp(-rate * step)
    delta-x += velocity.x * (1 - kept) / rate
    delta-y += velocity.y * (1 - kept) / rate
    velocity = Point(velocity.x * kept, velocity.y * kept)
    remaining -= step
glide-velocity = velocity
glide-time = time
if delta-x != 0 || delta-y != 0
    taken += ScrollEvent
        - template.data
        - delta-x
        - delta-y
        - true
        - ScrollPhase.none
        - ScrollPhase.changed
if !is-gliding
    finish-glide(taken)

────────────────────
_ do finish-glide
    - taken [ScrollEvent]

is-gliding = false
is-glide-pending = false
glide = null
. end = glide-end
if end
    glide-end = null
    taken += end

━━━━━━━━━━━━━━━━━━━━
_ scroll-resampler-moves Bool
    - event ScrollEvent

event.phase != ScrollPhase.began && event.phase != ScrollPhase.may-begin && has-delta

.. has-delta = event.delta-x != 0 || event.delta-y != 0

━━━━━━━━━━━━━━━━━━━━
_ scroll-resampler-decay F64
    - speed F64

|? speed >= 90
    0.974
|? speed >= 8
    0.964 + 0.010 * log(speed / 8) / log(90.0 / 8)
|? speed >= 0.5
    0.93 + 0.034 * log(speed / 0.5) / log(16.0)
??
    0.93

━━━━━━━━━━━━━━━━━━━━
_ scroll-resampler-moved ScrollEvent
    - event ScrollEvent
    - delta Point

ScrollEvent(event.data, delta.x, delta.y, event.is-precise, event.phase, event.momentum-phase)

━━━━━━━━━━━━━━━━━━━━
_ scroll-resampler-part ScrollEvent
    - event ScrollEvent
    - fraction F64
    - is-final Bool

if fraction >= 1 && is-final then event else part

.. phase = if is-final || event.phase == ScrollPhase.none then event.phase else ScrollPhase.changed
.. keeps-momentum = is-final || event.momentum-phase == ScrollPhase.none
.. momentum = if keeps-momentum then event.momentum-phase else ScrollPhase.changed
.. part = ScrollEvent
    - event.data
    - event.delta-x * fraction
    - event.delta-y * fraction
    - event.is-precise
    - phase
    - momentum
