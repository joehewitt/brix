(import /BxAppleGUI/BxAppleGUI.h)
(import /graphics/canvas)
(import /graphics/image)
(import /os/path)

(fn-do + move-to-trash _ (?! Error)
  (param path Path)
  (throw (call Error (str "Could not move " (. path name) " to the Trash")) (if (not (call C:brixGuiTrashPath (call native-path (as path String))))))
)

(fn-do + reveal-in-file-viewer Bool
  (param path Path)
  (return (call C:brixGuiRevealPath (call native-path (as path String))))
)

(fn-do + show-path-info Bool
  (param path Path)
  (return (call C:brixGuiShowPathInfo (call native-path (as path String))))
)

(fn-do + open-url Bool
  (param url String)
  (return (call C:brixGuiOpenURL url))
)

(fn-do + open-path Bool
  (param path Path)
  (return (call C:brixGuiOpenPath (call native-path (as path String))))
)

(fn-do + open-path-with Bool
  (param path Path)
  (param application Path)
  (return (call C:brixGuiOpenPathWithApp (call native-path (as path String)) (call native-path (as application String))))
)

(fn-do + path-display-name String
  (param path Path)
  (let name (call C:brixGuiPathDisplayName (call native-path (as path String))))
  (return (if-expr name (as name String) (. path name)))
)

(fn-do + load-path-icon (? Image)
  (param path Path)
  (param size F64 (= 32))
  (param scale F64 (= 2))
  (let raw (call C:brixGuiPathIconCanvas (call native-path (as path String)) size scale))
  (return-if null (if (== raw (call Pointer))))
  (return (call Image (call RasterCanvas raw) scale))
)

(fn-do + bundle-info-value (? String)
  (param bundle Path)
  (param key-path String)
  (let value (call C:brixGuiBundleInfoValue (call native-path (as bundle String)) key-path))
  (return-if null (if (not value)))
  (let text (as value String))
  (return (only-if text (if (> (. text length) 0))))
)

(fn-do + bundle-localized-string (? String)
  (param bundle Path)
  (param key String)
  (param table String (= ""))
  (let value (call C:brixGuiBundleLocalizedString (call native-path (as bundle String)) key table))
  (return-if null (if (not value)))
  (let text (as value String))
  (return (only-if text (if (> (. text length) 0))))
)

(fn-do + load-bundle-icon (? Image)
  (param bundle Path)
  (param icon-name String)
  (param size F64 (= 32))
  (param scale F64 (= 2))
  (let raw (call C:brixGuiBundleIconCanvas (call native-path (as bundle String)) icon-name size scale))
  (return-if null (if (== raw (call Pointer))))
  (return (call Image (call RasterCanvas raw) scale))
)
