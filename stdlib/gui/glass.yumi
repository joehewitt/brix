+ ¶ metal

float glassBox(float2 p, float2 extent, float r) {
    float2 q = abs(p) - extent + r;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
}

float4 backdrop(float2 position, ShaderLayer layer, LiquidGlassArgs args) {
    float2 extent = layer.size * 0.5;
    float2 p = position - extent;
    float limit = min(extent.x, extent.y);
    float r = clamp(args.radius, 0.0, limit);
    float bend = clamp(max(args.radius, args.bevel), 0.0, limit);
    float inset = -glassBox(p, extent, r);
    float2 dx = float2(0.5, 0.0);
    float2 dy = float2(0.0, 0.5);
    float2 normal = float2(
        glassBox(p + dx, extent, bend) - glassBox(p - dx, extent, bend),
        glassBox(p + dy, extent, bend) - glassBox(p - dy, extent, bend));
    normal = length(normal) > 1e-4 ? normalize(normal) : float2(0.0);
    float edge = 1.0 - saturate(inset / max(args.bevel, 1.0));
    float2 shift = -normal * edge * edge * edge * args.refraction;
    float2 low = float2(0.5);
    float2 high = layer.size - 0.5;
    float4 base = layer.sample(clamp(position + shift, low, high));
    float red = layer.sample(clamp(position + shift * (1.0 + args.dispersion), low, high)).r;
    float blue = layer.sample(clamp(position + shift * (1.0 - args.dispersion), low, high)).b;
    float3 color = float3(red, base.g, blue);
    float luma = dot(color, float3(0.2126, 0.7152, 0.0722));
    color = max(mix(float3(luma), color, args.saturation), 0.0);
    color = mix(color, args.tint.rgb, args.tint.a);
    float facing = dot(normal, normalize(float2(-0.55, -0.85)));
    float lit = max(facing, 0.0) + 0.5 * max(-facing, 0.0);
    float rim = exp(-max(inset, 0.0) / max(args.rim, 0.01));
    float shine = args.highlight * (rim * (0.3 + 0.7 * lit) + edge * edge * edge * args.sheen * lit);
    return float4(color + shine, max(base.a, saturate(args.tint.a + shine)));
}
