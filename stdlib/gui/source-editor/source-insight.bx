(import /code/structure/rows)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/primitives)
(import /math)
(blank)
(prop + source-mark-line Length (= 1))
(prop + source-mark-dot Length (= 1))
(prop + source-mark-dot-gap Length (= 2))
(prop + source-hatch-step Length (= 6))

(type + SourceMarkKind (is Union)
  (variant wait)
  (variant raise)
  (variant convert)
)

(type + SourceMark (is Tuple)
  (prop + start Size)
  (prop + end Size)
  (prop + kind SourceMarkKind)
  (prop + detail String)
  (prop + caption (? String))
  (prop + errors (list String))
)

(type + SourceFill (is Tuple)
  (prop + type String)
  (prop + errors (list String))
)

(type + SourceNote (is Tuple)
  (prop + kind String)
  (prop + label String)
  (prop + text String)
)

(type + SourceMessage (is Tuple)
  (prop + kind String)
  (prop + text String)
)

(type + SourceInsight (is Tuple)
  (prop + marks (map U32 (list SourceMark)))
  (prop + unknown (map U32 Bool))
  (prop + fills (map U32 SourceFill))
  (prop + notes (map U32 (list SourceNote)))
  (fn-expr + marks-of (list SourceMark)
    (param row SourceRow)
    (?? ([] marks (. row node-id)) (call (of List SourceMark)))
  )
  (fn-expr + is-unknown Bool
    (param row SourceRow)
    (!= ([] unknown (. row owner-id)) null)
  )
  (fn-expr + fill-of (? SourceFill)
    (param row SourceRow)
    ([] fills (. row node-id))
  )
  (fn-expr + notes-of (list SourceNote)
    (param row SourceRow)
    (?? ([] notes (. row node-id)) (call (of List SourceNote)))
  )
  (fn-do + message-at (? SourceMessage)
    (param row SourceRow)
    (param column Size)
    (let marks (call marks-of row))
    (for (in mark marks)
      (if (and (>= column (. mark start)) (<= column (. mark end)))
        (return (call SourceMessage (call mark-kind (. mark kind)) (. mark detail)))
      )
    )
    (return-if (call SourceMessage (call mark-kind (. ([] marks 0) kind)) (. ([] marks 0) detail)) (if (!= (. marks length) 0)))
    (if (call is-unknown row)
      (return (call SourceMessage "unreached" "No main reaches this function, so nothing is known about it"))
    )
    (return null)
  )
  (fn-do + errors-at (list String)
    (param row SourceRow)
    (param column Size)
    (for (in mark (call marks-of row))
      (return-if (. mark errors) (if (and (>= column (. mark start)) (<= column (. mark end)) (!= (. mark errors length) 0))))
    )
    (return (call (of List String)))
  )
)

(fn-expr _ mark-kind String
  (param kind SourceMarkKind)
  (match kind
    (case .raise
      "raises"
    )
    (case .convert
      "converts"
    )
    (case .wait
      "waits"
    )
  )
)

(fn-do + paint-source-hatch _
  (param canvas Canvas)
  (param shape Outline)
  (param band Rect)
  (param color RGBA)
  (let bounds (. shape bounds))
  (do-use (. canvas saved-state)
    (call (. canvas clip) band)
    (call (. canvas clip-outline) shape)
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) color)
    (= (. canvas stroke-width) 1)
    (let x (- (* (call floor (/ (+ (- (. bounds x) (. band height)) (. band bottom)) source-hatch-step)) source-hatch-step) (. band bottom)))
    (while (< x (. bounds right))
      (call (. canvas line) x (. band bottom) (+ x (. band height)) (. band y))
      (+= x source-hatch-step)
    )
  )
)

(fn-do + paint-source-underline _
  (param canvas Canvas)
  (param mark SourceMark)
  (param left Length)
  (param y Length)
  (param cell-width Length)
  (param height Length)
  (param color RGBA)
  (let x (+ left (* (. mark start) cell-width)))
  (let end (+ left (* (. mark end) cell-width)))
  (let line-y (- (+ y height) 3))
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) color)
  (match (. mark kind)
    (case .raise
      (call (. canvas rect) (call Rect x line-y (- end x) source-mark-line))
    )
    (case .convert
      (let period (+ source-mark-dot source-mark-dot-gap))
      (let dot x)
      (while (< dot end)
        (call (. canvas rect) (call Rect dot line-y (call min source-mark-dot (- end dot)) source-mark-line))
        (+= dot period)
      )
    )
    (case .wait
      (call (. canvas rect) (call Rect x y (- end x) height))
    )
  )
)
