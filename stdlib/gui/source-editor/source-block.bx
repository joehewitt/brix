(import ./source-style)
(import ./source-surface)
(import ./source-view)
(import /code/structure/document)
(import /code/structure/rows)
(import /code/structure/session)
(import /graphics/canvas)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/code-editor)

(type + SourceBlock (is Tuple)
  (prop + rows (list SourceRow))
  (prop + slices (list SourceSlice))
)

(fn-do + source-block SourceBlock
  (param document SourceDocument)
  (let scan (call SourceSliceScan (call SourceSession document)))
  (let rows (list SourceRow))
  (let slices (list SourceSlice))
  (for (in index (..< 0 (- (. document row-count) 1)))
    (+= rows (call (. document row-at) index))
    (+= slices (call (. scan slice) index source-row-length))
  )
  (let first Size 0)
  (let last (. rows length))
  (while (and (> last first) (call source-block-is-bare ([] rows (- last 1)) ([] slices (- last 1))))
    (-= last 1)
  )
  (while (and (< first last) (call source-block-is-bare ([] rows first) ([] slices first)))
    (+= first 1)
  )
  (let block (call SourceBlock))
  (for (in index (..< first last))
    (+= (. block rows) (call source-row-kept ([] rows index)))
    (+= (. block slices) ([] slices index))
  )
  (return block)
)

(fn-expr _ source-block-is-bare Bool
  (param row SourceRow)
  (param slice SourceSlice)
  (and (== (. slice outer) null) (or (. row is-divider) (== (. (call (. (. row content) trim)) size) 0)))
)

(fn-expr _ source-row-kept SourceRow
  (param row SourceRow)
  (call SourceRow
    (block
      (arg (. row node))
      (arg (. row mode))
      (arg (. row indent))
      (arg (call (of List SourceSpan) (in (call SourceSpan (. each kind) (. each text copied) (. each is-optional)) (. row spans))))
      (arg (. row is-invalid))
      (arg (. row divider))
      (arg (. row owner))
      (arg (. row node-id))
      (arg (. row owner-id))
      (arg (. row zone))
      (arg (. row block))
      (arg (. row is-prose))
      (arg (. row is-padding))
      (arg (. row is-private))
      (arg (. row is-open-end))
    )
  )
)

(type + SourceBlockView (is Box)
  (using CodeEditorTheme)
  (using CodeSyntaxStyle)
  (using SourceStructureTheme)
  (prop + block SourceBlock)
  (blank)
  (prop _ bolds Bool)
  (prop _ italics Bool)
  (prop _ measured-font (? Font))
  (blank)
  (rule This (• code-editor-text) (• flex-col) (• px 12) (• py 9) (• bg gui-editor-background-color)
    (= corner-radius source-box-radius)
  )
  (content
    (<> This
      (for (in row (. #block rows))
        (<> SourceRowBox (• h source-row-length) (• pr source-box-indent)
          (= row row)
          (= bolds #bolds)
          (= italics #italics)
          (= inset source-box-indent)
        )
      )
    )
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (return-if (if (== font measured-font)))
    (blank)
    (= measured-font font)
    (let width (call code-cell-width font))
    (= bolds (== (call code-cell-width (call Font $font-family $font-size (. FontWeight bold) $font-slant)) width))
    (= italics (== (call code-cell-width (call Font $font-family $font-size $font-weight (. FontSlant italic))) width))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let content content-bounds)
    (let palette (call source-surface-palette this))
    (let slices (. block slices))
    (for (in index (..< 0 (. slices length)))
      (let y (+ (. content y) (* index source-row-length)))
      (call paint-source-slice
        (block
          (arg canvas)
          (arg ([] slices index))
          (arg (call Rect (. content x) y (. content width) source-row-length))
          (arg (. content x))
          (arg (. content right))
          (arg palette)
        )
      )
      (if (== (. ([] (. block rows) index) divider) source-divider-double)
        (call paint-source-double-rule
          (block
            (arg canvas)
            (arg (+ (. content x) source-box-indent))
            (arg (- (. content right) source-box-indent))
            (arg y)
            (arg $source-thin-divider-color)
          )
        )
      )
    )
  )
)
