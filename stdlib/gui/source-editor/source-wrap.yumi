/code/structure/document
/code/structure/rows
/code/structure/session
/math
/ui/virtual
/ui/virtual-layout

+ source-wrap-least Size = 20

━━━━━━━━━━━━━━━━━━━━
+ SourceWrapSegment is (line Index, start Size, end Size)

━━━━━━━━━━━━━━━━━━━━
+ SourceWrap is Tuple

+ starts [Size]
+ hang Size
+ columns Size

────────────────────
+ get line-count Size

starts.length

────────────────────
+ get last-line Index

starts.length - 1

────────────────────
+ do line-of Index
    - column Size

. low Index = 0
. high = starts.length
while low + 1 < high
    . middle = low + (high - low) / 2
    if starts[middle] <= column
        low = middle
    else
        high = middle
= low

────────────────────
+ line-x Size
    - line Index

if line == 0 then 0 else hang

────────────────────
+ line-end Size
    - line Index

if line < last-line then starts[line + 1] else columns

────────────────────
+ last-column Size
    - line Index

if line < last-line then starts[line + 1] - 1 else columns

────────────────────
+ x-at Size
    - line Index
    - column Size

line-x(line) + column - starts[line]

────────────────────
+ x-of Size
    - column Size

x-at(line-of(column), column)

────────────────────
+ end-x Size
    - line Index

x-at(line, line-end(line))

────────────────────
+ column-at Size
    - line Index
    - x Size

min(starts[line] + offset, last-column(line))

.. offset = if x > line-x(line) then x - line-x(line) else 0

────────────────────
+ column-under Size?
    - line Index
    - x Size

|? x < line-x(line) || column >= line-end(line)
    null
??
    column

.. column = starts[line] + x - line-x(line)

────────────────────
+ do get widest Size

. found Size = 0
for line in 0 .. < starts.length
    found = max(found, end-x(line))
= found

────────────────────
+ do segments [SourceWrapSegment]
    - start Size
    - end Size

. found [SourceWrapSegment]
=? found if end <= start
for line in line-of(start) .. < starts.length
    . from = max(start, starts[line])
    . to = if line < last-line then min(end, starts[line + 1]) else end
    if to <= from
        break
    found += SourceWrapSegment(line, x-at(line, from), x-at(line, to))
= found

━━━━━━━━━━━━━━━━━━━━
+ do source-wrap SourceWrap
    - text String
    - width Size
    - unit Size

. chars = text.codepoints
. count = chars.length
. indent Size = 0
while indent < count && chars[indent] == ' '
    indent += 1
. reach = max(width, indent + source-wrap-least)
=? SourceWrap(List'Size(0), 0, count) if width == 0 || count <= reach
. hang = min(indent + unit, if width > source-wrap-least then width - source-wrap-least else 0)
. room = max(width, hang + source-wrap-least) - hang
. starts = List'Size(0)
. start Size = 0
while count - start > reach
    . end = start + reach
    . cut = end
    . at = end - 1
    . floor = max(start + 1, indent)
    while at >= floor
        if chars[at] == ' '
            cut = at + 1
            break
        at -= 1
    starts += cut
    start = cut
    reach = room
= SourceWrap(starts, hang, count)

━━━━━━━━━━━━━━━━━━━━
+ do source-row-wrap SourceWrap
    - row SourceRow
    - width Size
    - unit Size

. columns = row.columns
=? SourceWrap(List'Size(0), 0, columns) if width == 0 || columns <= width || row.is-divider || row.spans.length == 0
= source-wrap(row.text, width, if row.is-prose then 0 else unit)

━━━━━━━━━━━━━━━━━━━━
+ SourceWrapRows
    is VirtualRowOffsets

+ count Size
+ tops [Size]
+ widest Size
+ line-height VirtualCoord
+ tail VirtualCoord

────────────────────
+ This
    - count
    - tops
    - widest
    - line-height
    - tail

────────────────────
+ get is-wrapped Bool

tops.length != 0

────────────────────
+ do take
    - other SourceWrapRows

count = other.count
tops = other.tops
widest = other.widest

────────────────────
+ top Size
    - display Size

if tops.length == 0 then shown else tops[shown]

.. shown = min(display, count)

────────────────────
+ lines Size
    - display Size

top(display + 1) - top(display)

────────────────────
+ get line-count Size

top(count)

────────────────────
+ do display-at Size
    - line Size

=? 0 if count == 0
=? min(line, count - 1) if tops.length == 0
. low Size = 0
. high = count
while low + 1 < high
    . middle = low + (high - low) / 2
    if tops[middle] <= line
        low = middle
    else
        high = middle
= low

────────────────────
+ get total-height VirtualCoord

(line-count as VirtualCoord) * line-height + tail

────────────────────
+ offset-at VirtualCoord
    - index VirtualCoord

(top(index as Size) as VirtualCoord) * line-height

────────────────────
+ index-at VirtualCoord
    - offset VirtualCoord

display-at((offset / line-height) as Size) as VirtualCoord

━━━━━━━━━━━━━━━━━━━━
_ SourceWrapText is (columns Size, text String, is-prose Bool)

━━━━━━━━━━━━━━━━━━━━
_ SourceWrapLines is (lines [Size], widest Size)

━━━━━━━━━━━━━━━━━━━━
+ SourceWrapCache

_ texts = Map'U32'[SourceWrapText]()
_ counted = Map'U32'SourceWrapLines()
_ counted-width Size
_ compactions Size

────────────────────
+ do reset

texts = Map'U32'[SourceWrapText]()
counted = Map'U32'SourceWrapLines()

────────────────────
+ do rows SourceWrapRows
    - session SourceSession
    - width Size
    - unit Size
    - line-height VirtualCoord
    - tail VirtualCoord

. document = session.document
. folds = session.folds
. count = folds.row-count()
=? SourceWrapRows(count, List'Size(), 0, line-height, tail) if width == 0
if document.compaction-count != compactions
    reset()
    compactions = document.compaction-count
if width != counted-width
    counted = Map'U32'SourceWrapLines()
    counted-width = width
. kept-texts = Map'U32'[SourceWrapText]()
. kept-counts = Map'U32'SourceWrapLines()
. lines [Size]
. widest Size = 0
for index in 0 .. < document.declarations.length
    . place = document.declarations[index]
    . held = texts[place] ?? kept-texts[place] ?? wrap-texts(document, index)
    kept-texts[place] = held
    . found = counted[place] ?? kept-counts[place] ?? wrap-lines(held, width, unit)
    kept-counts[place] = found
    lines ++= found.lines
    widest = max(widest, found.widest)
texts = kept-texts
counted = kept-counts
while lines.length < document.row-count
    lines += 1
if session.is-dirty && session.row < lines.length
    . typed = source-row-wrap(session.row-at(session.row), width, unit)
    lines[session.row] = typed.line-count
    widest = max(widest, typed.widest)
. tops = List'Size(0)
. total Size = 0
for display in 0 .. < count
    . row = folds.actual(display)
    total += if row < lines.length then lines[row] else 1
    tops += total
= SourceWrapRows(count, tops, widest, line-height, tail)

────────────────────
_ do wrap-texts [SourceWrapText]
    - document SourceDocument
    - index Index

. made [SourceWrapText]
for outline in document.rows-of(index)
    . shown = document.language.render(outline)
    . columns = shown.columns
    . wraps = !shown.is-divider && shown.spans.length != 0 && columns > source-wrap-least
    made += SourceWrapText(columns, if wraps then shown.text else "", shown.is-prose)
= made

────────────────────
_ do wrap-lines SourceWrapLines
    - texts [SourceWrapText]
    - width Size
    - unit Size

. lines [Size]
. widest Size = 0
for held in texts
    if held.text.length == 0 || held.columns <= width
        lines += 1
        widest = max(widest, held.columns)
    else
        . wrap = source-wrap(held.text, width, if held.is-prose then 0 else unit)
        lines += wrap.line-count
        widest = max(widest, wrap.widest)
= SourceWrapLines(lines, widest)
