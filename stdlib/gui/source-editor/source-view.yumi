+ do paint-overlay
    - canvas Canvas

. active = session
=? if !active
. stuck = stuck-rows()
. text = text-bounds
. below = source-stuck-height(stuck)
. open = Rect(text.x, text.y + below, text.width, max(text.height - below, 0))
paint-held-marks(canvas, active)
paint-marks(canvas, active, open)
paint-notes(canvas, active, open)
paint-controls(canvas, active, open)
paint-stuck(canvas, active, stuck)
paint-link(canvas, open)
=? if !is-focused || cell-width == 0
. is-spacer = !active.can-edit(active.row) && !is-open-row(active, active.row)
=? if !is-spacer && !is-caret-lit
. color = $gui-editor-caret-color
. caret = caret-rect(active)
do use canvas.saved-state
    canvas.clip(open)
    if is-spacer
        . cell = Rect(caret.x + source-caret-width / 2, caret.y, cell-width, caret.height)
        canvas.fill-color = null
        canvas.stroke-width = source-spacer-caret-stroke
        canvas.stroke-color = color
        canvas.outline(Outline(cell, source-spacer-caret-radius).grow(-source-spacer-caret-stroke / 2))
    else
        canvas.fill-color = color
