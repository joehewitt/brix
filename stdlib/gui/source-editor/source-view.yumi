• This • code-editor-text flex-row
    focus-mode = FocusMode.input
    filters = #scroll-filters
    when #is-control-hovered
        cursor = CursorStyle.pointing-hand
    when #has-link
        cursor = CursorStyle.pointing-hand

────────────────────

<This
    <SourceGutter gutter
        cursor = CursorStyle.pointing-hand
        min-width = SizeSpec.coord(#gutter-width)
        max-width = SizeSpec.coord(#gutter-width)
        changes = #row-changes
    <VirtualRegion'SourceRow region • flex:1
        source = #source
        virtual-layout = source-row-layout(#row-width, #sticky-rows)
        overscan = VirtualInsets(100vcoord, 0vcoord, 100vcoord, 0vcoord)
        top-inset = #top-inset

        <SourceRowBox (row) - slot
            row = slot.#item
            address = slot.#address
            bolds = #bolds
            italics = #italics
            inset = source-text-inset
    <CodeOverview overview • absolute w:code-overview-width
        anchor = Anchor.parent
        top = PositionOffset.coord(#top-inset)
        right = PositionOffset.coord(0)
        bottom = PositionOffset.coord(0)
        rows = #shown-row-count
        row-length = source-row-length
        changes = #row-changes
    <CodeLinkCard link-card
    <SourceNoteCard note-card
    <ContextMenu
        if #context-link != null
            <MenuItem "Go to Definition"
                key = #definition-key
                action = => do go-to-context-definition()
            <MenuSeparator
        <MenuItem "Cut"
            key = cut-key
            is-enabled = #has-selection
            action = => do cut-from-menu()
        <MenuItem "Copy"
            key = copy-key
            is-enabled = #has-selection
            action = => do copy-from-menu()
        <MenuItem "Paste"
            key = paste-key
            action = => do paste-from-menu()

────────────────────
+ do show
    - shown SourceDocument

resume(SourceSession(shown))

────────────────────
+ do resume
    - next SourceSession
    - scroll = Point(0, 0)

clear-link()
find-cache.reset()
. bound = SourceRowSource(next)
bound.revision.value = next.revision + next.document.revision + next.folds.version + 1
session = next
bound-rows = bound
sticky-rows = SourceStickyRows(next)
is-modified = next.is-modified
widest-columns = 0
row-width = null
source = bound
widen()
region.restore-scroll(scroll)
number-rows()
gutter.scrolled = scroll.y - top-inset
track(next)
note-changes(true)
stamp += 1
if is-focused
    start-blink()
invalidate-paint()

────────────────────
+ do clear

stop-blink()
clear-link()
session = null
bound-rows = null
sticky-rows = null
source = null
region.release-bindings()
is-modified = false
insight = null
note-hits.clear()
note-card.dismiss()
gutter.numbered = 0
caret-row = 0
caret-column = 0
row-count = 0
shown-row-count = 0
note-changes(true)
stamp += 1
invalidate-paint()

────────────────────
+ do jump-to
    - row Size
    - column Size

. active = session
=? if !active
active.place(row, column)
refresh()
region.scroll-to-address(active.folds.shown(active.row), ScrollAlignment.center)

────────────────────
+ do show-link
    - probe SourcePoint
    - found SourceLink?

. pressed = context-point
if pressed && pressed.row == probe.row && pressed.column == probe.column && found-definition
    context-link = found
.. found-definition = found?.is-definition ?? false
. last = probed
=? if !last || last.row != probe.row || last.column != probe.column
set-link(found)

────────────────────
+ get text-scroll Point

Point(region.scroll-x, region.scroll-y)

────────────────────
+ do fold

. active = session
=? if !active
active.fold()
refresh()

────────────────────
+ do unfold

. active = session
=? if !active
active.unfold()
refresh()

────────────────────
+ do fold-all

. active = session
=? if !active
active.fold-all()
refresh()

────────────────────
+ do unfold-all

. active = session
=? if !active
active.unfold-all()
refresh()

────────────────────
+ do place-caret
    - point Point
    - extends = false

. active = session
=? if !active
. x = point.x + region.scroll-x - source-text-inset - gutter-width
. y = point.y + shown-top
. column = if x > 0 && cell-width > 0 then round(x / cell-width) as Size else 0
. row = if y > 0 then floor(y / source-row-length) as Size else 0
active.place(active.stop-at(active.folds.actual(row), false), column, extends)
refresh()

────────────────────
+ do type
    - text String
    - replaces-before Size = 0

. active = session
=? if !active
for index in 0 .. < replaces-before
    active.delete-backward()
active.insert(text)
refresh()

────────────────────
+ do perform
    - command TextCommand
    - extends = false

. active = session
=? if !active
. keeps = extends
do match command
    | .move-backward
        active.move-left()
    | .move-forward
        active.move-right()
    | .move-word-backward
        active.move-token-left()
    | .move-word-forward
        active.move-token-right()
    | .move-up
        active.move-up()
    | .move-down
        active.move-down()
    | .move-to-line-start
        active.move-to-line-start()
    | .move-to-line-end
        active.move-to-line-end()
    | .move-to-paragraph-start
        active.move-to-line-start()
    | .move-to-paragraph-end
        active.move-to-line-end()
    | .move-to-start
        active.move-to-start()
    | .move-to-end
        active.move-to-end()
    | .page-up
        active.move-up(page-rows())
    | .page-down
        active.move-down(page-rows())
    | .delete-backward
        active.delete-backward()
    | .delete-forward
        active.delete-forward()
    | .delete-word-backward
        active.delete-token-backward()
    | .delete-to-line-start
        active.delete-to-line-start()
    | .delete-to-line-end
        active.delete-to-line-end()
    | .delete-to-paragraph-end
        active.delete-to-line-end()
    | .insert-newline
        active.split()
    | .insert-line-break
        active.split()
    | .insert-tab
        active.indent()
    | .insert-backtab
        active.outdent()
    | .select-all
        active.select-all()
        keeps = true
    | .cancel
        active.revert()
    ??
        =
if !keeps
    active.collapse()
refresh()

────────────────────
+ do press Bool
    - characters String
    - shift Bool

. active = session
=? false if !active
if characters == "z" && !shift
    active.undo()
else if characters == "z" || characters == "Z" || characters == "y"
    active.redo()
else if characters == "a"
    active.select-all()
else if characters == "s"
    save-requested <- active
else if characters == "/"
    . ignored = active.toggle-comment()
else
    = false
refresh()
= true

────────────────────
_ do copy-selection Bool
    - clipboard Clipboard

. active = session
=? false if !active || !active.has-selection
= clipboard.write-text(active.clipboard-text())

────────────────────
for event on pointer-down

. stuck = stuck-row-at(event.point)
. folded = chip-at(event.point)
. control = control-at(event.point)
. noted = note-at(event.point) if event.button == PointerButton.primary
if noted
    show-note(noted)
else if event.button == PointerButton.secondary || is-control-click
    press-context(event.point)
else if stuck != null && event.button == PointerButton.primary && is-stuck-control(event.point, stuck ?? 0)
    request-focus()
    session!.toggle-fold(session!.folds.actual(stuck ?? 0))
    refresh()
else if stuck != null && event.button == PointerButton.primary
    request-focus()
    . x = event.point.x + region.scroll-x - source-text-inset - gutter-width
    session!.place
        - session!.folds.actual(stuck)
        - if x > 0 && cell-width > 0 then floor(x / cell-width) as Size else 0
    refresh()
else if folded != null && event.button == PointerButton.primary
    request-focus()
    session!.toggle-fold(folded)
    refresh()
else if control != null && event.button == PointerButton.primary
    request-focus()
    press-control(control ?? 0)
else if event.button == PointerButton.primary
    request-focus()
    place-caret(event.point, event.modifiers.shift)
    if event.click-count == 2
        session?.select-token()
        refresh()
    . active = session
    if active && event.click-count == 1 && event.modifiers.command
        definition-requested <- SourcePoint(active.row, active.column)
.. is-control-click = event.button == PointerButton.primary && event.modifiers.control

────────────────────
_ do cut-selection Bool
    - clipboard Clipboard

. active = session
=? false if !active || !copy-selection(clipboard)
active.delete-selection()
refresh()
= true

────────────────────
_ do paste-text Bool
    - clipboard Clipboard

. active = session
. pasted = clipboard.read-text()
=? false if !active || !pasted
active.paste(pasted)
refresh()
= true

────────────────────
_ do cut-from-menu

. ignored = cut-selection(Clipboard())

────────────────────
_ do copy-from-menu

. ignored = copy-selection(Clipboard())

────────────────────
_ do paste-from-menu

. ignored = paste-text(Clipboard())

────────────────────
_ do press-context
    - point Point

request-focus()
context-point = null
context-link = null
. active = session
=? if !active
. found = point-at(active, point)
if found == null || !source-selection-contains(active, found)
    place-caret(point)
=? if found == null
context-point = found
link-probed <- found

────────────────────
_ do go-to-context-definition

. active = session
. pressed = context-point
=? if !active || !pressed
active.place(pressed.row, pressed.column)
refresh()
definition-requested <- pressed

────────────────────
for change on overview.chose

request-focus()
jump-to(session?.folds.actual(change.line) ?? change.line, 0)

────────────────────
for target on gutter.added

request-focus()
add-at(target)

────────────────────
for target on gutter.toggled

. active = session
if active
    active.toggle-fold(target)
    refresh()

────────────────────
for event on pointer-move

hover-point = event.point
probe(event.modifiers.command)
track-hover(event.point)

────────────────────
for event on modifiers-changed

hover-point = event.point
probe(event.modifiers.command)

────────────────────
whenever #is-hover-within

if !is-hover-within
    hover-point = null
    clear-link()
    track-hover(null)

────────────────────
for event on pointer-drag

place-caret(event.point, true)

────────────────────
for event on key-press

. modifiers = event.modifiers
if event.key == Key.tab && !modifiers.command && !modifiers.control && !modifiers.option
    perform(if modifiers.shift then TextCommand.insert-backtab else TextCommand.insert-tab)
    event.cancel()
else if modifiers.command && !modifiers.control && !modifiers.option
    if press(event.characters, modifiers.shift)
        event.cancel()

────────────────────
for event on key-input

type(event.text, event.replaces-before)

────────────────────
for event on text-command

perform(event.command, event.extends-selection)

────────────────────
for event on copy

if copy-selection(event.clipboard)
    event.cancel()

────────────────────
for event on cut

if cut-selection(event.clipboard)
    event.cancel()

────────────────────
for event on paste

if paste-text(event.clipboard)
    event.cancel()

────────────────────
for event on focus

start-blink()
invalidate-paint()

────────────────────
for event on blur

stop-blink()
session?.commit()
refresh()

────────────────────
for event on region.scroll-changed when arrival

clear-link()
widen()
number-rows()
invalidate-paint()
if blurs-scrolling && event.cause.is-direct
    scroll-moved <- event.old-position.y

────────────────────
_ scroll-blur ~>

~> scroll-resting
    then scroll-blurring(from) for from on scroll-moved

~> scroll-blurring(from)
    do scroll-blur-from = from

    do finally
        scroll-filters = List'ShaderFilter()

    for tick on frames
        step-scroll-blur()

    then scroll-resting on scroll-blur-settled

────────────────────
_ do step-scroll-blur

. top = region.scroll-y
. moved = top - scroll-blur-from
scroll-blur-from = top
if moved == 0 || !blurs-scrolling
    scroll-blur-settled <- true
    =
. stuck = stuck-rows()
. still-top = if stuck.length > 0 then top-inset else 0
scroll-filters = code-scroll-blurs(moved, still-top, code-stuck-height(stuck, source-row-length))

────────────────────
_ do refresh

. active = session
. bound = bound-rows
=? if !active || !bound
active.folds.reveal(active.row)
. revision = active.revision + active.document.revision + active.folds.version + 1
if bound.revision.value != revision
    bound.resize()
    bound.revision.value = revision
    clear-link()
. modified = active.is-modified
if modified != is-modified
    is-modified = modified
    modified-changed <- modified
track(active)
note-changes(false)
stamp += 1
widen()
number-rows()
reveal-caret(active)
if is-focused
    start-blink()
invalidate-paint()

────────────────────
_ do probe
    - is-command Bool

. active = session
. point = hover-point
if !is-command || !active || !point
    clear-link()
    =
. found = point-at(active, point)
if !found
    clear-link()
    =
. current = link
=? if current && found.row == current.row && found.column >= current.start && found.column < current.end
. last = probed
=? if last && last.row == found.row && last.column == found.column
probed = found
if current
    set-link(null)
link-probed <- found

────────────────────
_ do clear-link

probed = null
if link
    set-link(null)

────────────────────
_ do set-link
    - found SourceLink?

link = found
has-link = found != null
invalidate-paint()
if !found || (found.title.length == 0 && found.detail.length == 0) || cell-width == 0
    link-card.dismiss()
    =
link-card.title = found.title
link-card.detail = found.detail
link-card.show(PopupAnchor.rect(presentation-rect(link-rect(found))))

────────────────────
_ link-rect Rect
    - found SourceLink

Rect(x, y, (found.end - found.start) * cell-width, source-row-length)

.. content = text-bounds
.. x = content.x + source-text-inset + found.start * cell-width - region.scroll-x
.. y = content.y + (session?.folds.shown(found.row) ?? found.row) * source-row-length - shown-top

────────────────────
_ point-at SourcePoint?
    - active SourceSession
    - point Point

|? x < 0 || y < 0 || cell-width <= 0
    null
|? display >= active.folds.row-count()
    null
|? shown.is-divider || column < shown.content-start || column >= shown.columns
    null
??
    SourcePoint(row, column)

.. x = point.x + region.scroll-x - source-text-inset - gutter-width
.. y = point.y + shown-top
.. display = floor(y / source-row-length) as Size
.. row = active.folds.actual(display)
.. column = floor(x / cell-width) as Size
.. shown = active.row-at(row)

────────────────────
_ do track
    - active SourceSession

caret-row = active.row
caret-column = active.column
if insight
    invalidate-paint()
row-count = active.row-count
shown-row-count = active.folds.row-count()
has-selection = active.has-selection
if active.folds.version + active.document.revision != shown-folds
    show-changes()

────────────────────
+ do show-insight
    - found SourceInsight?

insight = found
if !found
    note-card.dismiss()
retire-ink()
invalidate-paint()

────────────────────
_ do ink-layout TextLayout
    - text String
    - font Font

if ink-font != font
    retire-ink()
    ink-font = font
. kept = ink-layouts[text]
=? kept if kept
. made = TextLayout(TextLayoutRequest(text, font))
ink-layouts[text] = made
ink-made += made
= made

────────────────────
_ do retire-ink

for layout in ink-retired
    layout.close()
ink-retired = ink-made
ink-made = List'TextLayout()
ink-layouts.clear()

────────────────────
_ do note-at SourceNoteHit?
    - point Point

. painted = Point(point.x + bounds.x, point.y + bounds.y)
for hit in note-hits
    =? hit if hit.rect.contains(painted)
= null

────────────────────
_ do show-note
    - hit SourceNoteHit

note-card.text = hit.text
note-card.is-code = hit.is-code
note-card.show(PopupAnchor.rect(presentation-rect(hit.rect)))

────────────────────
_ do rebase

note-changes(true)

────────────────────
_ do inset-changed

number-rows()
invalidate-paint()

────────────────────
_ do note-changes
    - forced Bool

. active = session
. revision = if active then active.revision + active.document.revision + 1 else 0
=? if !forced && revision == noted-revision
noted-revision = revision
edit-stamp += 1
do new mark-changes()

────────────────────
_ do mark-changes

=? if is-marking
is-marking = true
do finally is-marking = false
while marked-stamp != edit-stamp
    . stamp = edit-stamp
    . found = marked-changes()
    if found == null
        break
    if stamp == edit-stamp
        line-changes = found
        marked-stamp = stamp
        show-changes()

────────────────────
_ do marked-changes [DiffLineChange]?

. active = session
. text = baseline
=? List'DiffLineChange() if !active || text == null
. old = text as Byte[]
. current = active.view-text() as Byte[]
. done = Semaphore'[DiffLineChange]()
do new thread
    done.post(diff-document(old, current).line-changes())
= done.await()

────────────────────
_ do show-changes

. active = session
shown-folds = active.folds.version + active.document.revision if active
if !active || active.folds.is-plain
    row-changes = line-changes
    =
. folds = active.folds
. made [DiffLineChange]
for change in line-changes
    . top = folds.shown(change.line)
    if change.kind == DiffLineChangeKind.deleted || change.count == 0
        made += DiffLineChange(change.kind, top, change.count)
    else
        . bottom = folds.shown(change.line + change.count - 1)
        made += DiffLineChange(change.kind, top, bottom - top + 1)
row-changes = made

────────────────────
_ do start-blink

is-caret-lit = true
blinker?.cancel-later()
blinker = do new
    while true
        source-blink-interval.wait()
        is-caret-lit = !is-caret-lit
        invalidate-paint()

────────────────────
_ do stop-blink

blinker?.cancel-later()
blinker = null

────────────────────
_ do reveal-caret
    - active SourceSession

. view = region.content-bounds
=? if view.width <= 0 || view.height <= 0
region.scroll-to-address(active.folds.shown(active.row), ScrollAlignment.nearest)
if active.row + 1 == active.row-count
    region.scroll-to-end(Orientation.vertical)
. left = source-text-inset + active.column * cell-width
. x = region.scroll-x
if left - source-text-inset < x
    x = left - source-text-inset
else if left + source-row-trail > x + view.width
    x = left + source-row-trail - view.width
if x != region.scroll-x
    region.scroll-to(Point(x, region.scroll-y))

────────────────────
_ page-rows Size

if count > 1 then count - 1 else 1

.. count = floor((region.content-bounds.height - top-inset) / source-row-length) as Size

────────────────────
_ caret-rect Rect
    - active SourceSession

Rect(x - source-caret-width / 2, y + 1, source-caret-width, source-row-length - 2)

.. content = text-bounds
.. left = content.x + source-text-inset - region.scroll-x
.. x = if active.is-open-end(active.row) then adder-left(left) + source-add-size + source-add-caret-gap else if is-open-row(active, active.row) then left else left + active.column * cell-width
.. y = content.y + active.folds.shown(active.row) * source-row-length - shown-top

────────────────────
_ adder-left Length
    - left Length

left + cell-width / 2 - source-add-size / 2

────────────────────
_ control-x Length
    - left Length
    - is-member Bool

left - (if is-member then source-member-indent else source-box-indent) + source-border-width / 2 - source-add-size / 2

────────────────────
_ is-adder Bool
    - active SourceSession
    - row Size

row + 1 == active.row-count || (row == active.row && !active.has-selection && is-head-start)

.. is-head-start = active.is-block-head(row) && active.column <= active.row-at(row).content-start

────────────────────
_ do paint-controls
    - canvas Canvas
    - active SourceSession
    - open Rect

. content = content-bounds
. top = shown-top
. folds = active.folds
. first = if top > 0 then floor(top / source-row-length) as Size else 0
. last = min(folds.row-count(), (ceil((top + content.height) / source-row-length) as Size) + 1)
. left = text-bounds.x + source-text-inset - region.scroll-x
. scan = SourceSliceScan(active, source-row-length)
do use canvas.saved-state
    canvas.clip(Rect(content.x, open.y, content.width, open.height))
    for index in first .. < last
        . row = folds.actual(index)
        . adds = is-adder(active, row)
        . is-folded = folds.is-folded(row)
        . folds-here = row == hovered-row && (is-folded || source-fold-head(active, row))
        if adds || is-folded || folds-here
            . x = control-x(left, scan.slice(index).member != null)
            . y = content.y + index * source-row-length - top
            if adds && !folds-here
                paint-add-button(canvas, x, y, row == active.row)
            else
                paint-fold-button(canvas, x, y, !is-folded)

────────────────────
_ do row-under Size?
    - point Point

. active = session
=? null if !active
. y = point.y + shown-top
=? null if y < 0
. display = floor(y / source-row-length) as Size
=? null if display >= active.folds.row-count()
= active.folds.actual(display)

────────────────────
_ do track-hover
    - point Point?

. row Size?
. on-control = false
. active = session
if point && active
    . stuck = stuck-row-at(point)
    row = if stuck != null then active.folds.actual(stuck ?? 0) else row-under(point)
    on-control = if stuck != null then is-stuck-control(point, stuck ?? 0) else control-at(point) != null
=? if row == hovered-row && on-control == is-control-hovered
hovered-row = row
is-control-hovered = on-control
invalidate-paint()

────────────────────
_ do is-on-control Bool
    - point Point
    - row Size

. active = session
=? false if !active
. is-member = SourceSliceScan(active, source-row-length).slice(active.folds.shown(row)).member != null
. x = control-x(gutter-width + source-text-inset - region.scroll-x, is-member)
= point.x >= x - source-border-width && point.x <= x + source-add-size + source-border-width

────────────────────
_ do is-stuck-control Bool
    - point Point
    - display Size

. active = session
=? false if !active
. row = active.folds.actual(display)
= source-fold-head(active, row) && is-on-control(point, row)

────────────────────
_ do control-at Size?
    - point Point

. active = session
=? null if !active
. found = row-under(point)
=? null if found == null
. row = found ?? 0
=? null if !is-on-control(point, row)
= if is-adder(active, row) || active.folds.is-folded(row) || source-fold-head(active, row) then row else null

────────────────────
_ do press-control
    - row Size

. active = session
=? if !active
if is-adder(active, row) && !active.folds.is-folded(row) && !source-fold-head(active, row)
    add-at(row)
    =
active.toggle-fold(row)
refresh()

────────────────────
_ do add-at
    - target Size

. active = session
=? if !active
. is-head = active.is-block-head(target)
active.place(target, 0)
if is-head
    active.split()
refresh()

────────────────────
_ do paint-add-button
    - canvas Canvas
    - x Length
    - y Length
    - is-lit Bool
    - is-lazy = false

if is-lit
    paint-source-add(canvas, x, y, $source-add-lit-color, null, $source-add-lit-mark-color, is-lazy)
else
    paint-source-add(canvas, x, y, $source-add-color, $source-add-border-color, $source-add-mark-color, is-lazy)

────────────────────
_ do paint-fold-button
    - canvas Canvas
    - x Length
    - y Length
    - is-open Bool

paint-source-fold(canvas, x, y, is-open, $source-add-color, $source-add-border-color, $source-add-mark-color)

────────────────────
_ is-open-row Bool
    - active SourceSession
    - row Size

row + 1 == active.row-count || active.is-open-end(row) || active.is-blank-line(row)

────────────────────
_ chip-at Size?
    - point Point

|? !active || cell-width <= 0
    null
|? x < 0 || y < 0
    null
|? display >= active.folds.row-count()
    null
|? !active.folds.is-folded(row)
    null
|? x < start || x > start + code-chip-width
    null
??
    row

.. active = session
.. x = point.x + region.scroll-x - source-text-inset - gutter-width
.. y = point.y + shown-top
.. display = floor(y / source-row-length) as Size
.. row = active.folds.actual(display)
.. start = active.row-at(row).columns * cell-width + code-chip-gap

────────────────────
_ stuck-rows [CodeStuckRow]

|? !sticky || !active
    List'CodeStuckRow()
??
    code-stuck-rows(sticky, active.folds.row-count(), source-row-length, region.scroll-y, top-inset)

.. sticky = sticky-rows
.. active = session

────────────────────
_ stuck-row-at Size?
    - point Point

code-stuck-at(stuck-rows(), point.y, source-row-length)

────────────────────
_ caret-context TextInputContext?

|? !active || active.row-count == 0
    null
??
    TextInputContext(typed[... count], "", caret-rect(active))

.. active = session
.. shown = active.row-at(active.row)
.. count = active.column - shown.content-start
.. typed = shown.content

────────────────────
_ get text-bounds Rect

Rect(content.x + gutter-width, content.y, content.width - gutter-width, content.height)

.. content = content-bounds

────────────────────
_ get shown-top Length

region.scroll-y - top-inset

────────────────────
_ do number-rows

. active = session
=? if !active
. count = active.row-count - 1
. digits = source-gutter-digits
. limit Size = 1000
while count >= limit
    digits += 1
    limit *= 10
. digit = if cell-width > 0 then ceil(cell-width) else source-digit-width
gutter-width = source-gutter-inset + digits * digit + source-gutter-gap
gutter.gap = source-gutter-gap
gutter.folds = active.folds
gutter.session = active
gutter.version = active.folds.version + active.document.revision
gutter.numbered = active.folds.row-count() - 1
gutter.caret-row = active.folds.shown(active.row)
gutter.head-lit = !active.has-selection && active.is-block-head(active.row) && active.column <= active.row-at(active.row).content-start
gutter.scrolled = shown-top
gutter.covered = code-stuck-height(stuck-rows(), source-row-length)

────────────────────
_ do widen

. active = session
=? if !active
. font = Font($font-family, $font-size, $font-weight, $font-slant)
if font != measured-font
    measured-font = font
    cell-width = code-cell-width(font)
    bolds = code-cell-width(Font($font-family, $font-size, FontWeight.bold, $font-slant)) == cell-width
    italics = code-cell-width(Font($font-family, $font-size, $font-weight, FontSlant.italic)) == cell-width
    row-width = null
. widest = max(active.document.widest-columns, widest-columns)
if active.is-dirty
    widest = max(widest, active.row-at(active.row).columns)
. width = ceil(max(text-width, region.content-bounds.width)) as I64
    .. text-width = widest * cell-width + source-text-inset + source-row-trail
=? if widest == widest-columns && row-width == width
widest-columns = widest
row-width = width

────────────────────
+ find-stamp U64

if active then active.revision + active.document.revision + 1 else 0

.. active = session

────────────────────
+ do find-rows [CodeFindRow]
    - editing Bool

. active = session
=? List'CodeFindRow() if !active
if editing
    active.commit()
= find-cache.rows(active)

────────────────────
+ find-caret CodeFindPlace

if active then CodeFindPlace(active.row, active.column) else CodeFindPlace(0, 0)

.. active = session

────────────────────
+ find-origin CodeFindPlace

if active then CodeFindPlace(active.first-selected-row, active.selection-start) else first-place

.. active = session
.. first-place = CodeFindPlace(0, 0)

────────────────────
+ find-selection CodeHit?

|? !active || !active.has-selection || active.first-selected-row != active.last-selected-row
    null
??
    CodeHit(active.first-selected-row, active.selection-start, active.selection-end)

.. active = session

────────────────────
+ find-seed String?

|? find-selection() == null || text.length == 0
    null
??
    text

.. text = session!.selected-text()

────────────────────
+ do find-reveal
    - hit CodeHit

. active = session
=? if !active
active.select-range(hit.row, hit.start, hit.end)
refresh()

────────────────────
+ do find-replace Bool
    - hit CodeHit
    - text String

. active = session
=? false if !active || !active.can-edit(hit.row)
active.select-range(hit.row, hit.start, hit.end)
. done = if text.length > 0 then active.insert(text) else active.delete-selection()
refresh()
= done

────────────────────
+ find-can-edit Bool
    - row Size

session?.can-edit(row) ?? false

────────────────────
+ do find-rewrite CodeRewrite
    - rows [Size]
    - texts [String]

. active = session
=? CodeRewrite(0, 0) if !active
. outcome = active.replace-rows(rows, texts)
refresh()
= CodeRewrite(outcome.changed, outcome.held)

────────────────────
+ do find-show
    - model CodeFind?

find = model
invalidate-paint()

────────────────────
+ do find-focus

request-focus()

────────────────────
+ do close

stop-blink()
retire-ink()
retire-ink()
super.close()

────────────────────
+ do did-layout

super.did-layout()
overview.clearance = region.$scroll-indicator-thickness + region.$scroll-indicator-inset
widen()
number-rows()

────────────────────
+ do paint-self
    - canvas Canvas

. whole = content-bounds
canvas.fill-color = $gui-editor-background-color
canvas.rect(whole)
. active = session
=? if !active || active.row-count == 0
. content = text-bounds
. top = shown-top
. folds = active.folds
. first = if top > 0 then floor(top / source-row-length) as Size else 0
. last = min(folds.row-count(), (ceil((top + content.height) / source-row-length) as Size) + 1)
. selects = active.has-selection
. first-selected = active.first-selected-row
. last-selected = active.last-selected-row
. left = content.x + source-text-inset - region.scroll-x
. finder = find
. hits = if finder then finder.found else List'CodeHit()
. next-hit = if finder then finder.first-at(folds.actual(first)) else 0
. focus-hit = finder.current if finder
. right = box-right(content)
. rule-end = min(content.right, right - source-box-indent)
. scan = SourceSliceScan(active, source-row-length)
. slices [SourceSlice]
for index in first .. < last
    slices += scan.slice(index)
paint-surfaces(canvas, slices, content, first, left, right)
. known = insight
if known
    paint-unknown(canvas, active, known, slices, content, first, left, right)
do use canvas.saved-state
    canvas.clip(whole)
    for index in first .. < last
        . row = folds.actual(index)
        . shown = active.row-at(row)
        . held = shown.is-invalid
        . is-typed = active.is-dirty && row == active.row
        . is-tinted = held && !is-typed
        . is-current = row == active.row && !selects && active.can-edit(row)
        . y = whole.y + index * source-row-length - top
        if is-tinted || is-current
            . band = Rect(whole.x, y, whole.width, source-row-length)
            . shape = source-slice-shape(slices[index - first], Rect(content.x, y, content.width, source-row-length), left - source-box-indent, right)
            do use canvas.saved-state
                canvas.clip(band)
                if shape
                    canvas.clip-outline(shape)
                canvas.stroke-color = null
                canvas.fill-color = if is-tinted then $source-held-band-color else $source-band-color
                canvas.rect(band)
do use canvas.saved-state
    canvas.clip(content)
    for index in first .. < last
        . row = folds.actual(index)
        . shown = active.row-at(row)
        . y = content.y + index * source-row-length - top
        if known && !(active.is-dirty && row == active.row)
            paint-washes(canvas, known, shown, left, y, folds.is-folded(row), lit-for(active, shown))
        if folds.is-folded(row)
            . x = left + shown.columns * cell-width + code-chip-gap
            code-fold-chip
                - canvas
                - x
                - y
                - source-row-length
                - $gui-editor-fold-chip-color
                - $gui-editor-line-number-color
        if active.is-open-end(row)
            paint-add-button(canvas, adder-left(left), y, row == active.row && !selects, slices[index - first].kind == SourceRowBlock.text)
        else if shown.divider == source-divider-double
            . start = max(content.x, left)
            . width = rule-end - start
            . rule-y = y + floor((source-row-length - source-double-divider-height) / 2)
            canvas.fill-color = $source-thin-divider-color
            canvas.rect(Rect(start, rule-y, width, source-thin-divider-height))
            canvas.rect(Rect(start, rule-y + source-double-divider-height - source-thin-divider-height, width, source-thin-divider-height))
        while next-hit < hits.length && hits[next-hit].row < row
            next-hit += 1
        while next-hit < hits.length && hits[next-hit].row == row
            if next-hit != focus-hit
                canvas.fill-color = $gui-editor-find-color
                canvas.rect(found-rect(hits[next-hit], left, y))
            next-hit += 1
        if selects && row >= first-selected && row <= last-selected
            . low = if row == first-selected then active.selection-start else 0
            . high = if row == last-selected then active.selection-end else shown.columns + 1
            if high > low
                . selected-width = (high - low) * cell-width
                canvas.fill-color = if is-focused then $gui-editor-selection-color else $gui-editor-idle-selection-color
                canvas.rect(Rect(left + low * cell-width, y, selected-width, source-row-length))
    . focused = finder.current-found if finder
    if focused && !folds.is-hidden(focused.row)
        . display = folds.shown(focused.row)
        if display >= first && display < last
            . y = content.y + display * source-row-length - top
            canvas.fill-color = $gui-editor-find-current-color
            canvas.rect(found-rect(focused, left, y))

────────────────────
_ do paint-unknown
    - canvas Canvas
    - active SourceSession
    - known SourceInsight
    - slices [SourceSlice]
    - content Rect
    - first Size
    - left Length
    - right Length

=? if known.unknown.length == 0
do use canvas.saved-state
    canvas.clip(content)
    for offset in 0 .. < slices.length
        . row = active.folds.actual(first + offset)
        if known.is-unknown(active.row-at(row))
            . y = content.y + (first + offset) * source-row-length - shown-top
            . band = Rect(content.x, y, content.width, source-row-length)
            . shape = source-slice-shape(slices[offset], band, left - source-box-indent, right)
            if shape
                paint-source-hatch(canvas, shape, band, $source-unknown-color)

────────────────────
_ do paint-washes
    - canvas Canvas
    - known SourceInsight
    - shown SourceRow
    - left Length
    - y Length
    - is-folded Bool
    - lit [String]

. marks = known.marks-of(shown)
for mark in marks
    if mark.kind == SourceMarkKind.wait
        paint-source-underline(canvas, mark, left, y, cell-width, source-row-length, $source-wait-color)
. end = left + shown.columns * cell-width + (if is-folded then code-chip-gap + code-chip-width else 0) + cell-width
. fill = known.fill-of(shown)
if fill
    end = paint-fill(canvas, fill, lit, end, y)
end += cell-width
for mark in marks
    . caption = mark.caption
    if caption
        paint-caption(canvas, caption, end, y)
        =

────────────────────
_ do lit-for [String]
    - active SourceSession
    - shown SourceRow

. known = insight
. none [String]
=? none if !known || active.is-dirty || active.has-selection || active.row >= active.row-count
. at = active.row-at(active.row)
=? none if at.owner-id != shown.owner-id
= known.errors-at(at, active.column)

────────────────────
_ do paint-fill Length
    - canvas Canvas
    - fill SourceFill
    - lit [String]
    - left Length
    - y Length

. column Size = 0
if fill.type.length != 0
    paint-ink(canvas, fill.type, left, y, $source-inferred-color)
    column += fill.type.length + 1
if fill.errors.length != 0
    paint-ink(canvas, "?!", left + column * cell-width, y, $source-inferred-color)
    column += 3
    for position in 0 .. < fill.errors.length
        . name = fill.errors[position]
        if position != 0
            paint-ink(canvas, "|", left + column * cell-width, y, $source-inferred-color)
            column += 2
        . color = if lit.find(name) != null then $source-inferred-lit-color else $source-inferred-color
        paint-ink(canvas, name, left + column * cell-width, y, color)
        column += name.length + 1
= left + column * cell-width

────────────────────
_ do paint-marks
    - canvas Canvas
    - active SourceSession
    - open Rect

. known = insight
=? if !known || known.marks.length == 0 || cell-width == 0
. text = text-bounds
. top = shown-top
. folds = active.folds
. first = if top > 0 then floor(top / source-row-length) as Size else 0
. last = min(folds.row-count(), (ceil((top + text.height) / source-row-length) as Size) + 1)
. left = text.x + source-text-inset - region.scroll-x
do use canvas.saved-state
    canvas.clip(open)
    for index in first .. < last
        . row = folds.actual(index)
        if !(active.is-dirty && row == active.row)
            . y = text.y + index * source-row-length - top
            for mark in known.marks-of(active.row-at(row))
                if mark.kind != SourceMarkKind.wait
                    . color = if mark.kind == SourceMarkKind.raise then $source-raise-color else $source-convert-color
                    paint-source-underline(canvas, mark, left, y, cell-width, source-row-length, color)

────────────────────
+ do paint-stuck-surface
    - canvas Canvas
    - band Rect
    - address I64
    - inset Length

. active = session
=? if !active || address < 0 || address >= (active.folds.row-count() as I64)
. scan = SourceSliceScan(active, source-row-length)
. left = band.x + inset - source-box-indent
paint-source-slice(canvas, scan.slice(address as Size), band, left, band.right - box-clearance, surface-palette())
. known = insight
. row = active.folds.actual(address as Size)
if known && !(active.is-dirty && row == active.row)
    . shown = active.row-at(row)
    paint-washes(canvas, known, shown, band.x + inset, band.y, active.folds.is-folded(row), lit-for(active, shown))

────────────────────
_ do paint-surfaces
    - canvas Canvas
    - slices [SourceSlice]
    - content Rect
    - first Size
    - left Length
    - right Length

. palette = surface-palette()
do use canvas.saved-state
    canvas.clip(content)
    for offset in 0 .. < slices.length
        . y = content.y + (first + offset) * source-row-length - shown-top
        . band = Rect(content.x, y, content.width, source-row-length)
        paint-source-slice(canvas, slices[offset], band, left - source-box-indent, right, palette)

────────────────────
_ box-right Length
    - content Rect

content.x + width - region.scroll-x - box-clearance

.. width = if row-width then (row-width as I64) as Length else content.width

────────────────────
_ get box-clearance Length

code-overview-width + source-box-margin

────────────────────
_ surface-palette SourceSurfacePalette

SourceSurfacePalette
    - $source-box-color
    - $source-box-border-color
    - $source-tray-color
    - $source-tray-border-color
    - $source-member-color
    - $source-member-border-color
    - $source-wash-color
    - $source-steps-wash-color
    - $source-text-wash-color
    - $source-holder-wash-color
    - $source-steps-border-color
    - $source-text-border-color
    - $gui-editor-background-color

────────────────────
_ do paint-notes
    - canvas Canvas
    - active SourceSession
    - open Rect

note-hits.clear()
. known = insight
=? if !known || cell-width == 0
. text = text-bounds
. top = shown-top
. folds = active.folds
. first = if top > 0 then floor(top / source-row-length) as Size else 0
. last = min(folds.row-count(), (ceil((top + text.height) / source-row-length) as Size) + 1)
. left = text.x + source-text-inset - region.scroll-x
. right = min(text.right, box-right(text) - source-box-indent) - cell-width
. font = Font($font-family, $font-size, $font-weight, $font-slant)
do use canvas.saved-state
    canvas.clip(open)
    for index in first .. < last
        . row = folds.actual(index)
        if !(active.is-dirty && row == active.row)
            . shown = active.row-at(row)
            . y = text.y + index * source-row-length - top
            . pills [SourcePill]
            if row == active.row && !active.has-selection
                . message = known.message-at(shown, active.column)
                if message
                    pills += SourcePill(message.kind, message.text, false)
            for note in known.notes-of(shown)
                pills += SourcePill(note.label, note.text, true)
            if pills.length != 0
                . total = pills-width(pills, font)
                . start = left + (shown.columns + written-columns(known, shown, folds.is-folded(row)) + 2) * cell-width
                . x = max(start, right - total)
                for pill in pills
                    . drawn = paint-pill(canvas, pill.label, x, y, font)
                    . seen = drawn.intersection(open)
                    if !seen.is-empty
                        note-hits += SourceNoteHit(seen, pill.text, pill.is-code)
                    x = drawn.right + source-pill-gap

────────────────────
_ do pills-width Length
    - pills [SourcePill]
    - font Font

. total Length = 0
for pill in pills
    total += ink-layout(pill.label, font).width + source-pill-padding * 2
= total + source-pill-gap * (pills.length - 1)

────────────────────
_ do written-columns Size
    - known SourceInsight
    - shown SourceRow
    - is-folded Bool

. columns Size = if is-folded then ceil((code-chip-gap + code-chip-width) / cell-width) as Size else 0
. fill = known.fill-of(shown)
if fill
    columns += fill.type.length + 1
    if fill.errors.length != 0
        columns += 3 + " | ".join(fill.errors).length + 1
for mark in known.marks-of(shown)
    . caption = mark.caption
    if caption
        columns += caption.length + 2
= columns

────────────────────
_ do paint-pill Rect
    - canvas Canvas
    - label String
    - x Length
    - y Length
    - font Font

. layout = ink-layout(label, font)
. height = source-row-length - source-pill-inset * 2
. width = layout.width + source-pill-padding * 2
. rect = Rect(x, y + source-pill-inset, width, height)
canvas.fill-color = $source-pill-color
canvas.stroke-color = $source-pill-border-color
canvas.stroke-width = 1
canvas.outline(Outline(rect, height / 2))
canvas.stroke-color = null
canvas.text-color = $source-caption-color
canvas.draw-text(layout, Rect(rect.x + source-pill-padding, y + (source-row-length - layout.height) / 2, layout.width, layout.height), TextAlignment.left)
= rect




────────────────────
_ do paint-caption
    - canvas Canvas
    - text String
    - left Length
    - y Length

paint-ink(canvas, text, left, y, $source-caption-color)

────────────────────
_ do paint-ink
    - canvas Canvas
    - text String
    - left Length
    - y Length
    - color RGBA

. font = Font($font-family, $font-size, $font-weight, $font-slant)
. layout = ink-layout(text, font)
canvas.text-color = color
canvas.draw-text(layout, Rect(left, y + (source-row-length - layout.height) / 2, layout.width, layout.height), TextAlignment.left)

────────────────────
_ found-rect Rect
    - hit CodeHit
    - left Length
    - y Length

Rect(left + hit.start * cell-width, y, (hit.end - hit.start) * cell-width, source-row-length)

────────────────────
+ do paint-overlay
    - canvas Canvas

. active = session
=? if !active
. stuck = stuck-rows()
. text = text-bounds
. below = code-stuck-height(stuck, source-row-length)
. open = Rect(text.x, text.y + below, text.width, max(text.height - below, 0))
paint-held-marks(canvas, active)
paint-marks(canvas, active, open)
paint-notes(canvas, active, open)
paint-controls(canvas, active, open)
paint-stuck(canvas, active, stuck)
paint-link(canvas, open)
=? if !is-focused || cell-width == 0
. is-spacer = !active.can-edit(active.row) && !is-open-row(active, active.row)
=? if !is-spacer && !is-caret-lit
. color = $gui-editor-caret-color
. caret = caret-rect(active)
do use canvas.saved-state
    canvas.clip(open)
    if is-spacer
        . cell = Rect(caret.x + source-caret-width / 2, caret.y, cell-width, caret.height)
        canvas.fill-color = null
        canvas.stroke-width = source-spacer-caret-stroke
        canvas.stroke-color = color
        canvas.outline(Outline(cell, source-spacer-caret-radius).grow(-source-spacer-caret-stroke / 2))
    else
        canvas.fill-color = color
        canvas.rect(caret)

────────────────────
_ do paint-stuck
    - canvas Canvas
    - active SourceSession
    - stuck [CodeStuckRow]

=? if stuck.length == 0
. content = content-bounds
. font = Font($font-family, $font-size, $font-weight, $font-slant)
. right = content.x + gutter-width - source-gutter-gap
. left = text-bounds.x + source-text-inset - region.scroll-x
. scan = SourceSliceScan(active, source-row-length)
do use canvas.saved-state
    canvas.clip(content)
    canvas.stroke-color = null
    for row in stuck
        . y = content.y + row.y
        canvas.fill-color = $gui-editor-gutter-color
        canvas.rect(Rect(content.x, y, gutter-width, source-row-length))
        . layout = ink-layout("${active.folds.actual(row.row) + 1}", font)
        . text-y = y + (source-row-length - layout.height) / 2
        canvas.text-color = $gui-editor-line-number-color
        canvas.draw-text
            - layout
            - Rect(right - layout.width, text-y, layout.width, layout.height)
            - TextAlignment.left
        . actual = active.folds.actual(row.row)
        if actual == hovered-row && source-fold-head(active, actual)
            paint-fold-button(canvas, control-x(left, scan.slice(row.row).member != null), y, true)
    . last = stuck[stuck.length - 1]
    if last.y > (last.row as Length) * source-row-length - shown-top
        canvas.fill-color = $gui-editor-sticky-border-color
        canvas.rect(Rect(content.x, content.y + last.y + source-row-length, content.width, 1))

────────────────────
_ do paint-link
    - canvas Canvas
    - open Rect

. found = link
=? if !found || cell-width == 0
. rect = link-rect(found)
do use canvas.saved-state
    canvas.clip(open)
    canvas.fill-color = $gui-editor-link-color
    canvas.rect(Rect(rect.x, rect.y + rect.height - 3, rect.width, 1))

────────────────────
_ do paint-held-marks
    - canvas Canvas
    - active SourceSession

. whole = content-bounds
. top = shown-top
. folds = active.folds
. first = if top > 0 then floor(top / source-row-length) as Size else 0
. last = min(folds.row-count(), (ceil((top + whole.height) / source-row-length) as Size) + 1)
do use canvas.saved-state
    canvas.clip(whole)
    canvas.fill-color = $source-held-mark-color
    for index in first .. < last
        . row = folds.actual(index)
        if active.row-at(row).is-invalid || folds.holds-invalid(row)
            . y = whole.y + index * source-row-length - top
            canvas.rect(Rect(whole.x, y, source-marker-width, source-row-length))

