_ do paint-mark
    - canvas Canvas
    - mark SourceMark
    - wrap SourceWrap
    - left Length
    - y Length
    - color RGBA

for part in wrap.segments(mark.start, mark.end)
    . piece = SourceMark(part.start, part.end, mark.kind, mark.detail, mark.caption, mark.errors)
    paint-source-underline(canvas, piece, left, y + part.line * source-row-length, cell-width, source-row-length, color)

