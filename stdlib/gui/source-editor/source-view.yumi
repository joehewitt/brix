_ do paint-stuck
    - canvas Canvas
    - active SourceSession
    - stuck [SourceStuckRow]

=? if stuck.length == 0
. content = content-bounds
. font = Font($font-family, $font-size, $font-weight, $font-slant)
. right = content.x + gutter-width - source-gutter-gap
. left = text-bounds.x + source-text-inset - region.scroll-x
. scan = SourceSliceScan(active)
do use canvas.saved-state
    canvas.clip(content)
    canvas.stroke-color = null
    for row in stuck
        . y = content.y + row.y
        canvas.fill-color = $gui-editor-gutter-color
        canvas.rect(Rect(content.x, y, gutter-width, row.height))
        . layout = ink-layout("${active.folds.actual(row.row) + 1}", font)
        . text-y = y + (source-row-length - layout.height) / 2
        canvas.text-color = $gui-editor-line-number-color
        canvas.draw-text
            - layout
            - Rect(right - layout.width, text-y, layout.width, layout.height)
            - TextAlignment.left
        . actual = active.folds.actual(row.row)
        if actual == hovered-row && source-fold-head(active, actual)
            paint-fold-button(canvas, control-x(left, scan.slice(row.row, row.height).member != null), y, true)
    . last = stuck[stuck.length - 1]
    if last.y > row-top(last.row) - shown-top
        canvas.fill-color = $gui-editor-sticky-border-color
        canvas.rect(Rect(content.x, content.y + last.y + last.height, content.width, 1))

