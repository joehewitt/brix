_ do paint-marks
    - canvas Canvas
    - active SourceSession
    - open Rect

. known = insight
=? if !known || known.marks.length == 0 || cell-width == 0
. text = text-bounds
. top = shown-top
. folds = active.folds
. first = first-shown(top)
. last = last-shown(active, top, text.height)
. left = text.x + source-text-inset - region.scroll-x
do use canvas.saved-state
    canvas.clip(open)
    for index in first .. < last
        . row = folds.actual(index)
        if !(active.is-dirty && row == active.row)
            . y = text.y + row-top(index) - top
            . shown = active.row-at(row)
            . wrap = source-row-wrap(shown, wrap-columns, source-indent-columns)
            for mark in known.marks-of(shown)
                if mark.kind != SourceMarkKind.wait
                    . color = if mark.kind == SourceMarkKind.raise then $source-raise-color else $source-convert-color
                    paint-mark(canvas, mark, wrap, left, y, color)

