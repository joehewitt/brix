. active = session
=? if !active || address < 0 || address >= (active.folds.row-count() as I64)
. scan = SourceSliceScan(active)
. left = band.x + inset - source-box-indent
paint-source-slice(canvas, scan.slice(address as Size, band.height), band, left, band.right - box-clearance, surface-palette())
. known = insight
. row = active.folds.actual(address as Size)
if known && !(active.is-dirty && row == active.row)
    . shown = active.row-at(row)
    . wrap = source-row-wrap(shown, wrap-columns, source-indent-columns)
    paint-washes(canvas, known, shown, wrap, band.x + inset, band.y, active.folds.is-folded(row), lit-for(active, shown))

