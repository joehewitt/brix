_ source-fold-head Bool
    - active SourceSession
    - row Size

active.is-block-head(row) && active.folds.can-fold(row)

━━━━━━━━━━━━━━━━━━━━
_ do paint-source-circle
    - canvas Canvas
    - x Length
    - y Length
    - fill RGBA
    - border RGBA?

. top = y + (source-row-length - source-add-size) / 2
. circle = Outline(Rect(x, top, source-add-size, source-add-size), source-add-size / 2)
canvas.stroke-color = null
canvas.fill-color = fill
canvas.outline(circle)
if border
    canvas.fill-color = null
    canvas.stroke-width = source-border-width
    canvas.stroke-color = border
    canvas.outline(circle.grow(-source-border-width / 2))
    canvas.stroke-color = null

━━━━━━━━━━━━━━━━━━━━
_ do paint-source-fold
    - canvas Canvas
    - x Length
    - y Length
    - is-open Bool
    - fill RGBA
    - border RGBA?
    - mark RGBA

. middle-x = x + source-add-size / 2
. middle-y = y + source-row-length / 2
paint-source-circle(canvas, x, y, fill, border)
. reach = source-chevron-reach
. depth = source-chevron-reach / 2
do use canvas.saved-state
    canvas.fill-color = null
    canvas.stroke-color = mark
    canvas.stroke-width = source-chevron-stroke
    canvas.stroke-cap = LineCap.round
    canvas.stroke-join = LineJoin.round
    canvas.begin()
    if is-open
        canvas.move(middle-x - reach, middle-y - depth)
        canvas.line(middle-x, middle-y + depth)
        canvas.line(middle-x + reach, middle-y - depth)
    else
        canvas.move(middle-x - depth, middle-y - reach)
        canvas.line(middle-x + depth, middle-y)
        canvas.line(middle-x - depth, middle-y + reach)
    canvas.end()

━━━━━━━━━━━━━━━━━━━━
_ do paint-source-add
    - canvas Canvas
    - x Length
    - y Length
    - fill RGBA
    - border RGBA?
    - mark RGBA
    - is-lazy = false

. middle-x = x + source-add-size / 2
. middle-y = y + source-row-length / 2
paint-source-circle(canvas, x, y, fill, border)
canvas.fill-color = mark
if is-lazy
    canvas.stroke-color = null
    paint-source-dot(canvas, middle-x - source-add-dot-gap / 2, middle-y)
    paint-source-dot(canvas, middle-x + source-add-dot-gap / 2, middle-y)
    =
canvas.rect(Rect(middle-x - source-add-arm / 2, middle-y - source-add-stroke / 2, source-add-arm, source-add-stroke))
canvas.rect(Rect(middle-x - source-add-stroke / 2, middle-y - source-add-arm / 2, source-add-stroke, source-add-arm))

━━━━━━━━━━━━━━━━━━━━
_ do paint-source-dot
    - canvas Canvas
    - x Length
    - y Length

canvas.outline(Outline(Rect(x - source-add-dot / 2, y - source-add-dot / 2, source-add-dot, source-add-dot), source-add-dot / 2))

━━━━━━━━━━━━━━━━━━━━
+ SourceGutter is CodeChangeBox
    using SourceStructureTheme

+ numbered Size
+ session SourceSession?
+ caret-row Size
+ head-lit Bool
+ scrolled Length
+ gap Length
+ covered Length
+ version U64
+ folds SourceFolds?
+ changes [DiffLineChange]
+ event toggled Size
+ event added Size

_ numbers [TextLayout]
_ labels [Size]

. changed < numbered, caret-row, head-lit, scrolled, gap, version, changes

────────────────────
_ do changed

invalidate-paint()

────────────────────
whenever #is-hover-within

invalidate-paint()

────────────────────
for event on pointer-down

. active = folds
. y = event.point.y + scrolled
if active && event.button == PointerButton.primary && y >= 0 && event.point.y >= covered
    . display = floor(y / source-row-length) as Size
    . row = if display < active.row-count() then active.actual(display) else active.document.row-count
    if display < numbered && (active.is-folded(row) || (session != null && source-fold-head(session, row)))
        toggled <- row
        event.cancel()
    else if row < active.document.row-count && (has-adder(row) || (head-lit && display == caret-row))
        added <- row
        event.cancel()

────────────────────
_ do release-numbers

for layout in numbers
    layout.close()
numbers = List'TextLayout()
labels = List'Size()

────────────────────
_ do ensure-numbers
    - wanted [Size]

=? if is-labeled(wanted)
release-numbers()
. font = Font($font-family, $font-size, $font-weight, $font-slant)
for label in wanted
    numbers += TextLayout(TextLayoutRequest("$label", font))
labels = wanted

────────────────────
_ is-labeled Bool
    - wanted [Size]

labels == wanted

────────────────────
_ has-adder Bool
    - row Size

session != null && row + 1 == session.row-count


────────────────────
+ do close

release-numbers()
super.close()

────────────────────
+ do paint-self
    - canvas Canvas

. content = content-bounds
=? if content.width <= 0 || content.height <= 0
canvas.fill-color = $gui-editor-gutter-color
canvas.rect(content)
. active = folds
. shown-count = if active then active.row-count() else numbered + 1
. low = if scrolled > 0 then floor(scrolled / source-row-length) as Size else 0
. high = min(shown-count, (ceil((scrolled + content.height) / source-row-length) as Size) + 1)
=? if high <= low
. rows [Size]
. wanted [Size]
for index in low .. < high
    . row = if active then active.actual(index) else index
    rows += row
    wanted += row + 1
ensure-numbers(wanted)
. right = content.x + content.width - gap
do use canvas.saved-state
    canvas.clip(content)
    canvas.stroke-color = null
    for index in low .. < high
        . layout = numbers[index - low]
        . y = content.y + index * source-row-length - scrolled
        . text-y = y + (source-row-length - layout.height) / 2
        . text-rect = Rect(right - layout.width, text-y, layout.width, layout.height)
        . is-caret = index == caret-row
        canvas.text-color = if is-caret then $gui-editor-caret-line-number-color else $gui-editor-line-number-color
        if index < numbered
            canvas.draw-text(layout, text-rect, TextAlignment.left)
    paint-changes(canvas, content, right, changes, scrolled, source-row-length)

━━━━━━━━━━━━━━━━━━━━
+ SourceRowBox is Box
    using CodeSyntaxStyle
    using SourceStructureTheme

+ row SourceRow
+ address I64 = -1
+ bolds Bool
+ italics Bool
+ inset Length = source-row-padding

_ text-layout TextLayout?
_ shown-spans [SourceSpan]
_ shown-indent Size
_ shown-divider U8
_ shown-zone SourceRowZone
_ shown-bolds Bool
_ shown-italics Bool
_ shown-colors [RGBA]

. row-changed < row, bolds, italics

────────────────────
_ do row-changed

if !text-layout || shown-indent != row.indent || shown-divider != row.divider || is-restyled || !source-spans-same(shown-spans, row.spans)
    release-text-layout()
.. is-restyled = shown-zone != row.zone || shown-bolds != bolds || shown-italics != italics
invalidate-paint()

────────────────────
_ do ensure-text-layout TextLayout

. colors = palette()
. cached = text-layout
if cached
    =? cached if has-colors(colors)
    release-text-layout()
. font = Font($font-family, $font-size, $font-weight, $font-slant)
. bold = Font($font-family, $font-size, FontWeight.bold, $font-slant)
. italic = Font($font-family, $font-size, $font-weight, FontSlant.italic)
. bold-italic = Font($font-family, $font-size, FontWeight.bold, FontSlant.italic)
. is-preamble = row.zone == SourceRowZone.preamble
. segments [TextSegment]
if row.indent > 0
    segments += TextSegment(0, " " * (row.indent * source-indent-columns), font)
for span in row.spans
    . is-bold = bolds && source-is-bold(span.kind)
    . is-slanted = italics && span.is-optional
    . shown = if is-bold then (if is-slanted then bold-italic else bold) else (if is-slanted then italic else font)
    . color = if is-preamble then preamble-color(span.kind) else span-color(span.kind)
    segments += TextSegment(0, span.text, shown, color)
. layout = TextLayout(segments, font, null, TextOverflow.clip, TextWrap.no-wrap)
text-layout = layout
shown-spans = row.spans
shown-indent = row.indent
shown-divider = row.divider
shown-zone = row.zone
shown-bolds = bolds
shown-italics = italics
shown-colors = colors
= layout

────────────────────
_ palette [RGBA]

List'RGBA
    * $syntax-plain-color ?? $gui-syntax-plain-color
    * $gui-syntax-keyword-color
    * $gui-syntax-function-color
    * $gui-syntax-variable-color
    * $gui-syntax-type-color
    * $gui-syntax-parameter-color
    * $gui-syntax-number-color
    * $gui-syntax-string-color
    * $gui-syntax-operator-color
    * $gui-syntax-punctuation-color
    * $gui-syntax-comment-color
    * $gui-syntax-invalid-color
    * $source-imports-prefix-color
    * $source-imports-name-color
    * $source-sigil-color
    * $source-operator-color
    * $source-exit-color
    * $source-parameter-color
    * $source-member-name-color
    * $source-tracked-color

────────────────────
_ has-colors Bool
    - colors [RGBA]

shown-colors == colors

────────────────────
_ preamble-color RGBA
    - kind SourceSpanKind

match kind
    | .string
        $source-imports-prefix-color
    | .definition
        $source-imports-name-color
    ??
        span-color(kind)

────────────────────
_ span-color RGBA
    - kind SourceSpanKind

match kind
    | .plain
        $syntax-plain-color ?? $gui-syntax-plain-color
    | .keyword
        $gui-syntax-keyword-color
    | .definition
        $syntax-plain-color ?? $gui-syntax-plain-color
    | .identifier
        $gui-syntax-variable-color
    | .type-name
        $gui-syntax-type-color
    | .rule
        $gui-syntax-function-color
    | .capture
        $gui-syntax-parameter-color
    | .number
        $gui-syntax-number-color
    | .string
        $gui-syntax-string-color
    | .operator
        $source-operator-color
    | .punctuation
        $source-sigil-color
    | .decoration
        $gui-syntax-punctuation-color
    | .comment
        $gui-syntax-comment-color
    | .invalid
        $gui-syntax-invalid-color
    | .parameter
        $source-parameter-color
    | .member
        $source-member-name-color
    | .member-binder
        $source-member-name-color
    | .type-definition
        $gui-syntax-type-color
    | .exit
        $source-exit-color
    | .tracked
        $source-tracked-color
    | .binder
        $syntax-plain-color ?? $gui-syntax-plain-color

────────────────────
_ do release-text-layout

if text-layout
    text-layout.close()
    text-layout = null

────────────────────
+ do close

release-text-layout()
super.close()

────────────────────
+ do paint-self
    - canvas Canvas

. content = content-bounds
=? if content.width <= 0 || content.height <= 0
if virtual-row-is-sticky'SourceRow(this)
    canvas.fill-color = $gui-editor-background-color
    canvas.rect(content)
    ancestor'SourceEditor()?.paint-stuck-surface(canvas, content, address, inset)
=? if row.spans.length == 0 || row.is-divider
do use canvas.saved-state
    canvas.clip(content)
    . layout = ensure-text-layout()
    . text-y = content.y + (content.height - layout.height) / 2
    . text-rect = Rect(content.x + inset, text-y, layout.width, layout.height)
    canvas.text-color = $syntax-plain-color ?? $gui-syntax-plain-color
    canvas.draw-text(layout, text-rect, TextAlignment.left)

━━━━━━━━━━━━━━━━━━━━
+ SourceRowSource
    is VirtualSource'SourceRow

+ session SourceSession
+ revision := VirtualRevision()

_ range VirtualRangeSource

────────────────────
+ do resize

range.count = session.folds.row-count() as VirtualCoord

────────────────────
+ This
    - session

.. range = VirtualRangeSource(session.folds.row-count())

────────────────────
+ get domain VirtualSequenceDomain

range

────────────────────
+ do bind
    - address I64
    - generation U64
    - target VirtualBindingTarget'SourceRow

if address < 0 || address >= session.folds.row-count()
    target.fail(generation)
else
    target.commit
        - VirtualKey(revision.value, address)
        - session.row-at(session.folds.actual(address))
        - generation

━━━━━━━━━━━━━━━━━━━━
+ SourceStickyRows
    is VirtualStickyRows

+ session SourceSession

────────────────────
+ This
    - session

────────────────────
+ do sticky-headers
    - address I64
    - headers List'I64

. folds = session.folds
=? if address < 0 || address >= (folds.row-count() as I64)
for row in folds.headers(folds.actual(address), source-sticky-limit)
    headers += folds.shown(row)

────────────────────
+ sticky-section-last I64
    - header I64

|? header < 0 || header >= (folds.row-count() as I64)
    header
??
    folds.shown(folds.section-end(folds.actual(header))) as I64

.. folds = session.folds

━━━━━━━━━━━━━━━━━━━━
_ source-row-layout VirtualLayout
    - row-width VirtualCoord?
    - sticky SourceStickyRows?

|? sticky != null
    VerticalStickyLayout(VerticalFixedLayout(source-row-height, row-width, null, source-end-space), sticky)
??
    VerticalFixedLayout(source-row-height, row-width, null, source-end-space)

━━━━━━━━━━━━━━━━━━━━
_ source-selection-contains Bool
    - active SourceSession
    - point SourcePoint

active.has-selection && after-start && before-end

.. first = active.first-selected-row
.. last = active.last-selected-row
.. after-start = point.row > first || (point.row == first && point.column >= active.selection-start)
.. before-end = point.row < last || (point.row == last && point.column < active.selection-end)

━━━━━━━━━━━━━━━━━━━━
_ SourceNoteHit is (rect Rect, text String, is-code Bool)

━━━━━━━━━━━━━━━━━━━━
_ SourcePill is (label String, text String, is-code Bool)

━━━━━━━━━━━━━━━━━━━━
_ source-is-bold Bool
    - kind SourceSpanKind

[SourceSpanKind.definition, SourceSpanKind.type-definition, SourceSpanKind.member-binder, SourceSpanKind.binder] has kind
