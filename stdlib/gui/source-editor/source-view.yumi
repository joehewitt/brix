canvas.outline(Outline(Rect(x - source-add-dot / 2, y - source-add-dot / 2, source-add-dot, source-add-dot), source-add-dot / 2))

━━━━━━━━━━━━━━━━━━━━
+ SourceGutter is CodeChangeBox
    using SourceStructureTheme

+ numbered Size
+ session SourceSession?
+ caret-row Size
+ head-lit Bool
+ scrolled Length
+ gap Length
+ covered Length
+ version U64
+ folds SourceFolds?
+ rows SourceWrapRows?
+ changes [DiffLineChange]
+ event toggled Size
+ event added Size

_ numbers [TextLayout]
_ labels [Size]

. changed < numbered, caret-row, head-lit, scrolled, gap, version, changes, rows

────────────────────
_ do changed

invalidate-paint()

────────────────────
whenever #is-hover-within

invalidate-paint()

────────────────────
for event on pointer-down

. active = folds
. y = event.point.y + scrolled
if active && event.button == PointerButton.primary && y >= 0 && event.point.y >= covered
    . display = display-of(floor(y / source-row-length) as Size)
    . row = if display < active.row-count() then active.actual(display) else active.document.row-count
    if display < numbered && (active.is-folded(row) || (session != null && source-fold-head(session, row)))
        toggled <- row
        event.cancel()
    else if row < active.document.row-count && (has-adder(row) || (head-lit && display == caret-row))
        added <- row
        event.cancel()

────────────────────
_ do release-numbers

for layout in numbers
    layout.close()
numbers = List'TextLayout()
labels = List'Size()

────────────────────
_ do ensure-numbers
    - wanted [Size]

=? if is-labeled(wanted)
release-numbers()
. font = Font($font-family, $font-size, $font-weight, $font-slant)
for label in wanted
    numbers += TextLayout(TextLayoutRequest("$label", font))
labels = wanted

────────────────────
_ is-labeled Bool
    - wanted [Size]

labels == wanted

────────────────────
_ has-adder Bool
    - row Size

session != null && row + 1 == session.row-count

────────────────────
_ do display-of Size
    - line Size

. shown = rows
=? line if !shown
=? shown.count if line >= shown.line-count
= shown.display-at(line)

────────────────────
_ top-of Length
    - display Size

(rows?.top(display) ?? display) * source-row-length


────────────────────
+ do close

release-numbers()
super.close()

────────────────────
+ do paint-self
    - canvas Canvas

. content = content-bounds
=? if content.width <= 0 || content.height <= 0
canvas.fill-color = $gui-editor-gutter-color
canvas.rect(content)
. active = folds
. shown-count = if active then active.row-count() else numbered + 1
. low = if scrolled > 0 then display-of(floor(scrolled / source-row-length) as Size) else 0
. high = min(shown-count, display-of(ceil((scrolled + content.height) / source-row-length) as Size) + 1)
=? if high <= low
. rows [Size]
. wanted [Size]
for index in low .. < high
    . row = if active then active.actual(index) else index
    rows += row
    wanted += row + 1
ensure-numbers(wanted)
. right = content.x + content.width - gap
do use canvas.saved-state
    canvas.clip(content)
    canvas.stroke-color = null
    for index in low .. < high
        . layout = numbers[index - low]
        . y = content.y + top-of(index) - scrolled
        . text-y = y + (source-row-length - layout.height) / 2
        . text-rect = Rect(right - layout.width, text-y, layout.width, layout.height)
        . is-caret = index == caret-row
        canvas.text-color = if is-caret then $gui-editor-caret-line-number-color else $gui-editor-line-number-color
        if index < numbered
            canvas.draw-text(layout, text-rect, TextAlignment.left)
    paint-changes(canvas, content, right, changes, scrolled, source-row-length)

━━━━━━━━━━━━━━━━━━━━
+ SourceRowBox is Box
    using CodeSyntaxStyle
    using SourceStructureTheme

+ row SourceRow
+ address I64 = -1
+ bolds Bool
+ italics Bool
+ inset Length = source-row-padding
+ wrap-columns Size = 0

_ text-layouts [TextLayout]
_ shown-spans [SourceSpan]
_ shown-indent Size
_ shown-divider U8
_ shown-zone SourceRowZone
_ shown-bolds Bool
_ shown-italics Bool
_ shown-colors [RGBA]
_ shown-wrap-columns Size

. row-changed < row, bolds, italics, wrap-columns

────────────────────
_ do row-changed

if text-layouts.length == 0 || shown-indent != row.indent || shown-divider != row.divider || is-restyled || !source-spans-same(shown-spans, row.spans)
    release-text-layout()
.. is-restyled = shown-zone != row.zone || shown-bolds != bolds || shown-italics != italics || shown-wrap-columns != wrap-columns
invalidate-paint()

────────────────────
_ do ensure-text-layouts [TextLayout]

. colors = palette()
if text-layouts.length != 0
    =? text-layouts if has-colors(colors)
    release-text-layout()
. font = Font($font-family, $font-size, $font-weight, $font-slant)
. wrap = source-row-wrap(row, wrap-columns, source-indent-columns)
. made [TextLayout]
for line in 0 .. < wrap.line-count
    . segments = line-segments(wrap.starts[line], wrap.line-end(line), wrap.line-x(line), font)
    made += TextLayout(segments, font, null, TextOverflow.clip, TextWrap.no-wrap)
text-layouts = made
shown-spans = row.spans
shown-indent = row.indent
shown-divider = row.divider
shown-zone = row.zone
shown-bolds = bolds
shown-italics = italics
shown-colors = colors
shown-wrap-columns = wrap-columns
= made

────────────────────
_ do line-segments [TextSegment]
    - from Size
    - to Size
    - lead Size
    - font Font

. bold = Font($font-family, $font-size, FontWeight.bold, $font-slant)
. italic = Font($font-family, $font-size, $font-weight, FontSlant.italic)
. bold-italic = Font($font-family, $font-size, FontWeight.bold, FontSlant.italic)
. is-preamble = row.zone == SourceRowZone.preamble
. segments [TextSegment]
. position = row.content-start
. blank = lead + max(min(to, position) - from, 0)
if blank > 0
    segments += TextSegment(0, " " * blank, font)
for span in row.spans
    . end = position + span.text.length
    if end > from && position < to
        . is-bold = bolds && source-is-bold(span.kind)
        . is-slanted = italics && span.is-optional
        . shown = if is-bold then (if is-slanted then bold-italic else bold) else (if is-slanted then italic else font)
        . color = if is-preamble then preamble-color(span.kind) else span-color(span.kind)
        . whole = position >= from && end <= to
        . text = if whole then span.text else span.text[max(from, position) - position .. < min(to, end) - position]
        segments += TextSegment(0, text, shown, color)
    position = end
= segments

────────────────────
_ palette [RGBA]

List'RGBA
    * $syntax-plain-color ?? $gui-syntax-plain-color
    * $gui-syntax-keyword-color
    * $gui-syntax-function-color
    * $gui-syntax-variable-color
    * $gui-syntax-type-color
    * $gui-syntax-parameter-color
    * $gui-syntax-number-color
    * $gui-syntax-string-color
    * $gui-syntax-operator-color
    * $gui-syntax-punctuation-color
    * $gui-syntax-comment-color
    * $gui-syntax-invalid-color
    * $source-imports-prefix-color
    * $source-imports-name-color
    * $source-sigil-color
    * $source-operator-color
    * $source-exit-color
    * $source-parameter-color
    * $source-member-name-color
    * $source-tracked-color

────────────────────
_ has-colors Bool
    - colors [RGBA]

shown-colors == colors

────────────────────
_ preamble-color RGBA
    - kind SourceSpanKind

match kind
    | .string
        $source-imports-prefix-color
    | .definition
        $source-imports-name-color
    ??
        span-color(kind)

────────────────────
_ span-color RGBA
    - kind SourceSpanKind

match kind
    | .plain
        $syntax-plain-color ?? $gui-syntax-plain-color
    | .keyword
        $gui-syntax-keyword-color
    | .definition
        $syntax-plain-color ?? $gui-syntax-plain-color
    | .identifier
        $gui-syntax-variable-color
    | .type-name
        $gui-syntax-type-color
    | .rule
        $gui-syntax-function-color
    | .capture
        $gui-syntax-parameter-color
    | .number
        $gui-syntax-number-color
    | .string
        $gui-syntax-string-color
    | .operator
        $source-operator-color
    | .punctuation
        $source-sigil-color
    | .decoration
        $gui-syntax-punctuation-color
    | .comment
        $gui-syntax-comment-color
    | .invalid
        $gui-syntax-invalid-color
    | .parameter
        $source-parameter-color
    | .member
        $source-member-name-color
    | .member-binder
        $source-member-name-color
    | .type-definition
        $gui-syntax-type-color
    | .exit
        $source-exit-color
    | .tracked
        $source-tracked-color
    | .binder
        $syntax-plain-color ?? $gui-syntax-plain-color

────────────────────
_ do release-text-layout

for layout in text-layouts
    layout.close()
text-layouts = List'TextLayout()

────────────────────
+ do close

release-text-layout()
super.close()

────────────────────
+ do paint-self
    - canvas Canvas

. content = content-bounds
=? if content.width <= 0 || content.height <= 0
if virtual-row-is-sticky'SourceRow(this)
    canvas.fill-color = $gui-editor-background-color
    canvas.rect(content)
    ancestor'SourceEditor()?.paint-stuck-surface(canvas, content, address, inset)
=? if row.spans.length == 0 || row.is-divider
do use canvas.saved-state
    canvas.clip(content)
    . layouts = ensure-text-layouts()
    . pitch = content.height / layouts.length
    canvas.text-color = $syntax-plain-color ?? $gui-syntax-plain-color
    for line in 0 .. < layouts.length
        . layout = layouts[line]
        . text-y = content.y + line * pitch + (pitch - layout.height) / 2
        canvas.draw-text(layout, Rect(content.x + inset, text-y, layout.width, layout.height), TextAlignment.left)

━━━━━━━━━━━━━━━━━━━━
+ SourceRowSource
    is VirtualSource'SourceRow

+ session SourceSession
+ revision := VirtualRevision()

_ range VirtualRangeSource

────────────────────
+ do resize

range.count = session.folds.row-count() as VirtualCoord

────────────────────
+ This
    - session

.. range = VirtualRangeSource(session.folds.row-count())

────────────────────
+ get domain VirtualSequenceDomain

range

────────────────────
+ do bind
    - address I64
    - generation U64
    - target VirtualBindingTarget'SourceRow

if address < 0 || address >= session.folds.row-count()
    target.fail(generation)
else
    target.commit
        - VirtualKey(revision.value, address)
        - session.row-at(session.folds.actual(address))
        - generation

━━━━━━━━━━━━━━━━━━━━
+ SourceStickyRows
    is VirtualStickyRows

+ session SourceSession

────────────────────
+ This
    - session

────────────────────
+ do sticky-headers
    - address I64
    - headers List'I64

. folds = session.folds
=? if address < 0 || address >= (folds.row-count() as I64)
for row in folds.headers(folds.actual(address), source-sticky-limit)
    headers += folds.shown(row)

────────────────────
+ sticky-section-last I64
    - header I64

|? header < 0 || header >= (folds.row-count() as I64)
    header
??
    folds.shown(folds.section-end(folds.actual(header))) as I64

.. folds = session.folds

━━━━━━━━━━━━━━━━━━━━
_ source-row-layout VirtualLayout
    - row-width VirtualCoord?
    - sticky SourceStickyRows?
    - rows SourceWrapRows

|? sticky != null
    VerticalStickyLayout(VerticalOffsetLayout(rows, row-width), sticky)
??
    VerticalOffsetLayout(rows, row-width)

━━━━━━━━━━━━━━━━━━━━
_ do source-stuck-rows [SourceStuckRow]
    - sticky VirtualStickyRows
    - rows SourceWrapRows
    - top Length
    - inset Length

. found [SourceStuckRow]
. bottom = top
. reach = top
. headers = List'I64()
while reach >= 0
    . line = floor(reach / source-row-length) as Size
    =? found if line >= rows.line-count
    headers.clear()
    sticky.sticky-headers(rows.display-at(line), headers)
    =? found if headers.length <= found.length || !source-extends-stuck(headers, found)
    . header = headers[found.length] as Size
    . natural = rows.top(header) * source-row-length
    . height = rows.lines(header) * source-row-length
    . limit = rows.top((sticky.sticky-section-last(header) as Size) + 1) * source-row-length
    . y = max(natural, min(bottom, limit - height))
    found += SourceStuckRow(header, y - top + inset, height)
    bottom = y + height
    reach += height
= found

━━━━━━━━━━━━━━━━━━━━
_ source-extends-stuck Bool
    - headers List'I64
    - found [SourceStuckRow]

all(0 .. < found.length) • where (headers[each] as Size) == found[each].row

━━━━━━━━━━━━━━━━━━━━
_ do source-stuck-at SourceStuckRow?
    - stuck [SourceStuckRow]
    - y Length

for row in stuck
    =? row if y >= row.y && y < row.y + row.height
= null

━━━━━━━━━━━━━━━━━━━━
_ source-stuck-height Length
    - stuck [SourceStuckRow]

if stuck.length > 0 then max(last.y + last.height, 0) else 0

.. last = stuck[stuck.length - 1]

━━━━━━━━━━━━━━━━━━━━
_ source-selection-contains Bool
    - active SourceSession
    - point SourcePoint

active.has-selection && after-start && before-end

.. first = active.first-selected-row
.. last = active.last-selected-row
.. after-start = point.row > first || (point.row == first && point.column >= active.selection-start)
.. before-end = point.row < last || (point.row == last && point.column < active.selection-end)

━━━━━━━━━━━━━━━━━━━━
_ SourceNoteHit is (rect Rect, text String, is-code Bool)

━━━━━━━━━━━━━━━━━━━━
_ SourceSpot is (display Size, row Size, line Index, wrap SourceWrap)

━━━━━━━━━━━━━━━━━━━━
_ SourceStuckRow is (row Size, y Length, height Length)

━━━━━━━━━━━━━━━━━━━━
_ SourcePill is (label String, text String, is-code Bool)

━━━━━━━━━━━━━━━━━━━━
_ source-is-bold Bool
    - kind SourceSpanKind

[SourceSpanKind.definition, SourceSpanKind.type-definition, SourceSpanKind.member-binder, SourceSpanKind.binder] has kind
