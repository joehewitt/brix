_ do paint-pill Rect
    - canvas Canvas
    - label String
    - x Length
    - y Length
    - font Font

. layout = ink-layout(label, font)
. height = source-row-length - source-pill-inset * 2
. width = layout.width + source-pill-padding * 2
. rect = Rect(x, y + source-pill-inset, width, height)
canvas.fill-color = $source-pill-color
canvas.stroke-color = $source-pill-border-color
canvas.stroke-width = 1
canvas.outline(Outline(rect, height / 2))
canvas.stroke-color = null
canvas.text-color = $source-caption-color
canvas.draw-text(layout, Rect(rect.x + source-pill-padding, y + (source-row-length - layout.height) / 2, layout.width, layout.height), TextAlignment.left)
= rect




