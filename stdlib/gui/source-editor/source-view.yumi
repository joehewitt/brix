────────────────────

<This
    <SourceGutter gutter
        cursor = CursorStyle.pointing-hand
        min-width = SizeSpec.coord(#gutter-width)
        max-width = SizeSpec.coord(#gutter-width)
        changes = #row-changes
    <VirtualRegion'SourceRow region • flex:1
        source = #source
        virtual-layout = source-row-layout(#row-width, #sticky-rows, #wrap-rows)
        overscan = VirtualInsets(100vcoord, 0vcoord, 100vcoord, 0vcoord)
        top-inset = #top-inset

        <SourceRowBox (row) - slot
            row = slot.#item
            address = slot.#address
            bolds = #bolds
            italics = #italics
            inset = source-text-inset
            wrap-columns = #wrap-columns
    <CodeOverview overview • absolute w:code-overview-width
        anchor = Anchor.parent
        top = PositionOffset.coord(#top-inset)
        right = PositionOffset.coord(0)
        bottom = PositionOffset.coord(0)
        rows = #line-count
        row-length = source-row-length
        changes = #row-changes
    <CodeLinkCard link-card
    <SourceNoteCard note-card
    <ContextMenu
        if #context-link != null
            <MenuItem "Go to Definition"
                key = #definition-key
                action = => do go-to-context-definition()
            <MenuSeparator
        <MenuItem "Cut"
            key = cut-key
            is-enabled = #has-selection
            action = => do cut-from-menu()
        <MenuItem "Copy"
            key = copy-key
            is-enabled = #has-selection
            action = => do copy-from-menu()
        <MenuItem "Paste"
            key = paste-key
            action = => do paste-from-menu()

────────────────────
+ do show
    - shown SourceDocument

resume(SourceSession(shown))

────────────────────
+ do resume
    - next SourceSession
    - scroll = Point(0, 0)

clear-link()
find-cache.reset()
wrap-cache.reset()
wrapped-stamp = 0
goal-place = null
. bound = SourceRowSource(next)
bound.revision.value = next.revision + next.document.revision + next.folds.version + 1
session = next
bound-rows = bound
sticky-rows = SourceStickyRows(next)
is-modified = next.is-modified
widest-columns = 0
row-width = null
source = bound
widen()
region.restore-scroll(scroll)
number-rows()
gutter.scrolled = scroll.y - top-inset
track(next)
note-changes(true)
stamp += 1
if is-focused
    start-blink()
invalidate-paint()

────────────────────
+ do clear

stop-blink()
clear-link()
session = null
bound-rows = null
sticky-rows = null
source = null
region.release-bindings()
wrap-cache.reset()
wrap-rows.take(SourceWrapRows(0, List'Size(), 0, source-row-height, source-end-space))
wrapped-stamp = 0
line-count = 0
goal-place = null
is-modified = false
insight = null
note-hits.clear()
note-card.dismiss()
gutter.numbered = 0
caret-row = 0
caret-column = 0
row-count = 0
shown-row-count = 0
note-changes(true)
stamp += 1
invalidate-paint()

────────────────────
+ do jump-to
    - row Size
    - column Size

. active = session
=? if !active
active.place(row, column)
refresh()
region.scroll-to-address(active.folds.shown(active.row), ScrollAlignment.center)

────────────────────
+ do show-link
    - probe SourcePoint
    - found SourceLink?

. pressed = context-point
if pressed && pressed.row == probe.row && pressed.column == probe.column && found-definition
    context-link = found
.. found-definition = found?.is-definition ?? false
. last = probed
=? if !last || last.row != probe.row || last.column != probe.column
set-link(found)

────────────────────
+ get text-scroll Point

Point(region.scroll-x, region.scroll-y)

────────────────────
+ do fold

. active = session
=? if !active
active.fold()
refresh()

────────────────────
+ do unfold

. active = session
=? if !active
active.unfold()
refresh()

────────────────────
+ do fold-all

. active = session
=? if !active
active.fold-all()
refresh()

────────────────────
+ do unfold-all

. active = session
=? if !active
active.unfold-all()
refresh()

────────────────────
+ do place-caret
    - point Point
    - extends = false

. active = session
=? if !active || wrap-rows.line-count == 0
. x = point.x + region.scroll-x - source-text-inset - gutter-width
. y = point.y + shown-top
. cell = if x > 0 && cell-width > 0 then round(x / cell-width) as Size else 0
. lines = if y > 0 then floor(y / source-row-length) as Size else 0
. spot = spot-on(active, min(lines, wrap-rows.line-count - 1))
goal-place = null
active.place(active.stop-at(spot.row, false), spot.wrap.column-at(spot.line, cell), extends)
refresh()

────────────────────
+ do type
    - text String
    - replaces-before Size = 0
    - replaces-length Size = 0

. active = session
=? if !active
goal-place = null
if replaces-before > 0 && !active.has-selection
    . start = active.column - replaces-before
    active.select-range(active.row, start, start + replaces-length)
active.insert(text)
refresh()

────────────────────
+ do perform
    - command TextCommand
    - extends = false

. active = session
=? if !active
. keeps = extends
match command
    | .move-backward
        active.move-left()
    | .move-forward
        active.move-right()
    | .move-word-backward
        active.move-token-left()
    | .move-word-forward
        active.move-token-right()
    | .move-up
        move-lines(active, 1, true)
    | .move-down
        move-lines(active, 1, false)
    | .move-to-line-start
        move-to-edge(active, false)
    | .move-to-line-end
        move-to-edge(active, true)
    | .move-to-paragraph-start
        active.move-to-line-start()
    | .move-to-paragraph-end
        active.move-to-line-end()
    | .move-to-start
        active.move-to-start()
    | .move-to-end
        active.move-to-end()
    | .page-up
        move-lines(active, page-lines(), true)
    | .page-down
        move-lines(active, page-lines(), false)
    | .delete-backward
        active.delete-backward()
    | .delete-forward
        active.delete-forward()
    | .delete-word-backward
        active.delete-token-backward()
    | .delete-to-line-start
        active.delete-to-line-start()
    | .delete-to-line-end
        active.delete-to-line-end()
    | .delete-to-paragraph-end
        active.delete-to-line-end()
    | .insert-newline
        active.split()
    | .insert-line-break
        active.split()
    | .insert-tab
        active.indent()
    | .insert-backtab
        active.outdent()
    | .select-all
        active.select-all()
        keeps = true
    | .cancel
        active.revert()
    ??
        =
if !is-vertical(command)
    goal-place = null
if !keeps
    active.collapse()
refresh()

────────────────────
_ is-vertical Bool
    - command TextCommand

match command
    | .move-up
        true
    | .move-down
        true
    | .page-up
        true
    | .page-down
        true
    ??
        false

────────────────────
+ do press Bool
    - characters String
    - shift Bool

. active = session
=? false if !active
if characters == "z" && !shift
    active.undo()
else if characters == "z" || characters == "Z" || characters == "y"
    active.redo()
else if characters == "a"
    active.select-all()
else if characters == "s"
    save-requested <- active
else if characters == "/"
    . ignored = active.toggle-comment()
else
    = false
refresh()
= true

────────────────────
_ do copy-selection Bool
    - clipboard Clipboard

. active = session
=? false if !active || !active.has-selection
= clipboard.write-text(active.clipboard-text())

────────────────────
for event on pointer-down

. stuck = stuck-row-at(event.point)
. folded = chip-at(event.point)
. control = control-at(event.point)
. noted = note-at(event.point) if event.button == PointerButton.primary
if noted
    show-note(noted)
else if event.button == PointerButton.secondary || is-control-click
    press-context(event.point)
else if stuck && event.button == PointerButton.primary && is-stuck-control(event.point, stuck.row)
    request-focus()
    session!.toggle-fold(session!.folds.actual(stuck.row))
    refresh()
else if stuck && event.button == PointerButton.primary
    request-focus()
    place-stuck(event.point, stuck)
else if folded != null && event.button == PointerButton.primary
    request-focus()
    session!.toggle-fold(folded)
    refresh()
else if control != null && event.button == PointerButton.primary
    request-focus()
    press-control(control ?? 0)
else if event.button == PointerButton.primary
    request-focus()
    place-caret(event.point, event.modifiers.shift)
    if event.click-count == 2
        session?.select-token()
        refresh()
    . active = session
    if active && event.click-count == 1 && event.modifiers.command
        definition-requested <- SourcePoint(active.row, active.column)
.. is-control-click = event.button == PointerButton.primary && event.modifiers.control

────────────────────
_ do place-stuck
    - point Point
    - stuck SourceStuckRow

. active = session
=? if !active
. row = active.folds.actual(stuck.row)
. wrap = row-wrap(active, row)
. x = point.x + region.scroll-x - source-text-inset - gutter-width
. cell = if x > 0 && cell-width > 0 then floor(x / cell-width) as Size else 0
. below = point.y - stuck.y
. line = if below > 0 then min(floor(below / source-row-length) as Size, wrap.last-line) else 0
active.place(row, wrap.column-at(line, cell))
refresh()

────────────────────
_ do cut-selection Bool
    - clipboard Clipboard

. active = session
=? false if !active || !copy-selection(clipboard)
active.delete-selection()
refresh()
= true

────────────────────
_ do paste-text Bool
    - clipboard Clipboard

. active = session
. pasted = clipboard.read-text()
=? false if !active || !pasted
active.paste(pasted)
refresh()
= true

────────────────────
_ do cut-from-menu

. ignored = cut-selection(Clipboard())

────────────────────
_ do copy-from-menu

. ignored = copy-selection(Clipboard())

────────────────────
_ do paste-from-menu

. ignored = paste-text(Clipboard())

────────────────────
_ do press-context
    - point Point

request-focus()
context-point = null
context-link = null
. active = session
=? if !active
. found = point-at(active, point)
if found == null || !source-selection-contains(active, found)
    place-caret(point)
=? if found == null
context-point = found
link-probed <- found

────────────────────
_ do go-to-context-definition

. active = session
. pressed = context-point
=? if !active || !pressed
active.place(pressed.row, pressed.column)
refresh()
definition-requested <- pressed

────────────────────
for change on overview.chose

request-focus()
. display = wrap-rows.display-at(change.line)
jump-to(session?.folds.actual(display) ?? display, 0)

────────────────────
for target on gutter.added

request-focus()
add-at(target)

────────────────────
for target on gutter.toggled

. active = session
if active
    active.toggle-fold(target)
    refresh()

────────────────────
for event on pointer-move

hover-point = event.point
probe(event.modifiers.command)
track-hover(event.point)

────────────────────
for event on modifiers-changed

hover-point = event.point
probe(event.modifiers.command)

────────────────────
whenever #is-hover-within

if !is-hover-within
    hover-point = null
    clear-link()
    track-hover(null)

────────────────────
for event on pointer-drag

place-caret(event.point, true)

────────────────────
for event on key-press

. modifiers = event.modifiers
if event.key == Key.tab && !modifiers.command && !modifiers.control && !modifiers.option
    perform(if modifiers.shift then TextCommand.insert-backtab else TextCommand.insert-tab)
    event.cancel()
else if (event.key == Key.home || event.key == Key.end) && !modifiers.command && !modifiers.control && !modifiers.option
    perform(if event.key == Key.home then TextCommand.move-to-line-start else TextCommand.move-to-line-end, modifiers.shift)
    event.cancel()
else if modifiers.command && !modifiers.control && !modifiers.option
    if press(event.characters, modifiers.shift)
        event.cancel()

────────────────────
for event on key-input

type(event.text, event.replaces-before, event.replaces-length)

────────────────────
for event on text-command

perform(event.command, event.extends-selection)

────────────────────
for event on copy

if copy-selection(event.clipboard)
    event.cancel()

────────────────────
for event on cut

if cut-selection(event.clipboard)
    event.cancel()

────────────────────
for event on paste

if paste-text(event.clipboard)
    event.cancel()

────────────────────
for event on focus

start-blink()
invalidate-paint()

────────────────────
for event on blur

stop-blink()
session?.commit()
refresh()

────────────────────
for event on region.scroll-changed when arrival

clear-link()
widen()
number-rows()
invalidate-paint()

────────────────────
_ do refresh

. active = session
. bound = bound-rows
=? if !active || !bound
active.folds.reveal(active.row)
. revision = active.revision + active.document.revision + active.folds.version + 1
if bound.revision.value != revision
    bound.resize()
    bound.revision.value = revision
    clear-link()
. modified = active.is-modified
if modified != is-modified
    is-modified = modified
    modified-changed <- modified
track(active)
note-changes(false)
stamp += 1
widen()
number-rows()
reveal-caret(active)
if is-focused
    start-blink()
invalidate-paint()

────────────────────
_ do probe
    - is-command Bool

. active = session
. point = hover-point
if !is-command || !active || !point
    clear-link()
    =
. found = point-at(active, point)
if !found
    clear-link()
    =
. current = link
=? if current && found.row == current.row && found.column >= current.start && found.column < current.end
. last = probed
=? if last && last.row == found.row && last.column == found.column
probed = found
if current
    set-link(null)
link-probed <- found

────────────────────
_ do clear-link

probed = null
if link
    set-link(null)

────────────────────
_ do set-link
    - found SourceLink?

link = found
has-link = found != null
invalidate-paint()
if !found || (found.title.length == 0 && found.detail.length == 0) || cell-width == 0
    link-card.dismiss()
    =
link-card.title = found.title
link-card.detail = found.detail
. rects = link-rects(found)
if rects.length != 0
    link-card.show(PopupAnchor.rect(presentation-rect(rects[0])))

────────────────────
_ do link-rects [Rect]
    - found SourceLink

. active = session
=? List'Rect() if !active
. content = text-bounds
. left = content.x + source-text-inset - region.scroll-x
. y = content.y + row-top(active.folds.shown(found.row)) - shown-top
= span-rects(row-wrap(active, found.row), found.start, found.end, left, y)

────────────────────
_ do point-at SourcePoint?
    - active SourceSession
    - point Point

. x = point.x + region.scroll-x - source-text-inset - gutter-width
=? null if x < 0 || cell-width <= 0
. spot = spot-under(active, point)
=? null if !spot
. column = spot.wrap.column-under(spot.line, floor(x / cell-width) as Size)
. shown = active.row-at(spot.row)
=? null if column == null || shown.is-divider || column < shown.content-start || column >= shown.columns
= SourcePoint(spot.row, column)

────────────────────
_ do track
    - active SourceSession

caret-row = active.row
caret-column = active.column
if insight
    invalidate-paint()
row-count = active.row-count
shown-row-count = active.folds.row-count()
has-selection = active.has-selection
if active.folds.version + active.document.revision != shown-folds
    show-changes()

────────────────────
+ do show-insight
    - found SourceInsight?

insight = found
if !found
    note-card.dismiss()
retire-ink()
invalidate-paint()

────────────────────
_ do ink-layout TextLayout
    - text String
    - font Font

if ink-font != font
    retire-ink()
    ink-font = font
. kept = ink-layouts[text]
=? kept if kept
. made = TextLayout(TextLayoutRequest(text, font))
ink-layouts[text] = made
ink-made += made
= made

────────────────────
_ do retire-ink

for layout in ink-retired
    layout.close()
ink-retired = ink-made
ink-made = List'TextLayout()
ink-layouts.clear()

────────────────────
_ do note-at SourceNoteHit?
    - point Point

. painted = Point(point.x + bounds.x, point.y + bounds.y)
for hit in note-hits
    =? hit if hit.rect.contains(painted)
= null

────────────────────
_ do show-note
    - hit SourceNoteHit

note-card.text = hit.text
note-card.is-code = hit.is-code
note-card.show(PopupAnchor.rect(presentation-rect(hit.rect)))

────────────────────
_ do rebase

note-changes(true)

────────────────────
_ do inset-changed

number-rows()
invalidate-paint()

────────────────────
_ do wrap-changed

widen()
number-rows()
invalidate-paint()

────────────────────
_ do note-changes
    - forced Bool

. active = session
. revision = if active then active.revision + active.document.revision + 1 else 0
=? if !forced && revision == noted-revision
noted-revision = revision
edit-stamp += 1
do new mark-changes()

────────────────────
_ do mark-changes

=? if is-marking
is-marking = true
do finally is-marking = false
while marked-stamp != edit-stamp
    . stamp = edit-stamp
    . found = marked-changes()
    if found == null
        break
    if stamp == edit-stamp
        line-changes = found
        marked-stamp = stamp
        show-changes()

────────────────────
_ do marked-changes [DiffLineChange]?

. active = session
. text = baseline
=? List'DiffLineChange() if !active || text == null
. old = text as Byte[]
. current = active.view-text() as Byte[]
. done = Semaphore'[DiffLineChange]()
do new thread
    done.post(diff-document(old, current).line-changes())
= done.await()

────────────────────
_ do show-changes

. active = session
shown-folds = active.folds.version + active.document.revision if active
if !active || (active.folds.is-plain && !wrap-rows.is-wrapped)
    row-changes = line-changes
    =
. folds = active.folds
. rows = wrap-rows
. made [DiffLineChange]
for change in line-changes
    . top = rows.top(folds.shown(change.line))
    if change.kind == DiffLineChangeKind.deleted || change.count == 0
        made += DiffLineChange(change.kind, top, change.count)
    else
        . bottom = folds.shown(change.line + change.count - 1)
        made += DiffLineChange(change.kind, top, rows.top(bottom + 1) - top)
row-changes = made

────────────────────
_ do start-blink

is-caret-lit = true
blinker?.cancel-later()
blinker = do new
    while true
        source-blink-interval.wait()
        is-caret-lit = !is-caret-lit
        invalidate-paint()

────────────────────
_ do stop-blink

blinker?.cancel-later()
blinker = null

────────────────────
_ do reveal-caret
    - active SourceSession

. view = region.content-bounds
=? if view.width <= 0 || view.height <= 0
. display = active.folds.shown(active.row)
region.scroll-to-address(display, ScrollAlignment.nearest)
if active.row + 1 == active.row-count
    region.scroll-to-end(Orientation.vertical)
. wrap = row-wrap(active, active.row)
. top = row-top(display) + wrap.line-of(active.column) * source-row-length
. y = region.scroll-y
if top < y
    y = top
else if top + source-row-length + top-inset > y + view.height
    y = top + source-row-length + top-inset - view.height
. left = source-text-inset + wrap.x-of(active.column) * cell-width
. x = region.scroll-x
if left - source-text-inset < x
    x = left - source-text-inset
else if left + source-row-trail > x + view.width
    x = left + source-row-trail - view.width
if x != region.scroll-x || y != region.scroll-y
    region.scroll-to(Point(x, y))

────────────────────
_ page-lines Size

if count > 1 then count - 1 else 1

.. count = floor((region.content-bounds.height - top-inset) / source-row-length) as Size

────────────────────
_ do move-lines
    - active SourceSession
    - count Size
    - upward Bool

. x = goal-for(active)
for step in 0 .. < count
    if !step-line(active, x, upward)
        break
goal-x = x
goal-place = SourcePoint(active.row, active.column)

────────────────────
_ do goal-for Size
    - active SourceSession

. kept = goal-place
=? goal-x if kept && kept.row == active.row && kept.column == active.column
= row-wrap(active, active.row).x-of(active.column)

────────────────────
_ do step-line Bool
    - active SourceSession
    - x Size
    - upward Bool

. wrap = row-wrap(active, active.row)
. next = wrap.line-of(active.column) + (if upward then -1 else 1)
if next >= 0 && next <= wrap.last-line
    active.place(active.row, wrap.column-at(next, x), true)
    = true
. before = active.row
if upward
    active.move-up()
else
    active.move-down()
=? false if active.row == before
. landed = row-wrap(active, active.row)
active.place(active.row, landed.column-at(if upward then landed.last-line else 0, x), true)
= true

────────────────────
_ do move-to-edge
    - active SourceSession
    - is-end Bool

. wrap = row-wrap(active, active.row)
. line = wrap.line-of(active.column)
if is-end && line == wrap.last-line
    active.move-to-line-end()
else if !is-end && line == 0
    active.move-to-line-start()
else
    active.place(active.row, if is-end then wrap.last-column(line) else wrap.starts[line], true)

────────────────────
_ do sync-wrap
    - active SourceSession

. stamp = active.revision + active.document.revision + active.folds.version + 1
=? if stamp == wrapped-stamp && wrap-columns == wrapped-columns
. resized = wrapped-columns > 0 && wrap-columns > 0 && wrap-columns != wrapped-columns
wrapped-stamp = stamp
wrapped-columns = wrap-columns
. next = wrap-cache.rows(active, wrap-columns, source-indent-columns, source-row-height, source-end-space)
=? if next.count == wrap-rows.count && next.widest == wrap-rows.widest && next.tops == wrap-rows.tops
. scroll = max(region.scroll-y, 0)
. anchor = wrap-rows.display-at(floor(scroll / source-row-length) as Size)
. within = scroll - row-top(anchor)
wrap-rows.take(next)
line-count = wrap-rows.line-count
region.invalidate-bindings()
gutter.invalidate-paint()
show-changes()
if resized && anchor < wrap-rows.count
    region.pin-address(anchor, top-inset - min(within, row-height(anchor) - 1))

────────────────────
_ wrap-width Size

|? !wraps-rows || cell-width <= 0 || room <= 0
    0
??
    max(floor(room / cell-width) as Size, 1)

.. room = region.content-bounds.width - source-text-inset - box-clearance - source-box-indent

────────────────────
_ row-wrap SourceWrap
    - active SourceSession
    - row Size

source-row-wrap(active.row-at(row), wrap-columns, source-indent-columns)

────────────────────
_ row-top Length
    - display Size

wrap-rows.top(display) * source-row-length

────────────────────
_ row-height Length
    - display Size

wrap-rows.lines(display) * source-row-length

────────────────────
_ first-shown Size
    - top Length

if top > 0 then wrap-rows.display-at(floor(top / source-row-length) as Size) else 0

────────────────────
_ last-shown Size
    - active SourceSession
    - top Length
    - height Length

min(active.folds.row-count(), wrap-rows.display-at(ceil((top + height) / source-row-length) as Size) + 1)

────────────────────
_ do spot-on SourceSpot
    - active SourceSession
    - lines Size

. display = wrap-rows.display-at(lines)
. row = active.folds.actual(display)
. wrap = row-wrap(active, row)
= SourceSpot(display, row, min(lines - wrap-rows.top(display), wrap.last-line), wrap)

────────────────────
_ do spot-under SourceSpot?
    - active SourceSession
    - point Point

. y = point.y + shown-top
=? null if y < 0
. lines = floor(y / source-row-length) as Size
=? null if lines >= wrap-rows.line-count
= spot-on(active, lines)

────────────────────
_ span-rects [Rect]
    - wrap SourceWrap
    - start Size
    - end Size
    - left Length
    - y Length

List'Rect(Rect(left + each.start * cell-width, y + each.line * source-row-length, (each.end - each.start) * cell-width, source-row-length) in wrap.segments(start, end))

────────────────────
_ caret-rect Rect
    - active SourceSession

Rect(x - source-caret-width / 2, y + 1, source-caret-width, source-row-length - 2)

.. content = text-bounds
.. left = content.x + source-text-inset - region.scroll-x
.. wrap = row-wrap(active, active.row)
.. line = wrap.line-of(active.column)
.. x = if active.is-open-end(active.row) then adder-left(left) + source-add-size + source-add-caret-gap else if is-open-row(active, active.row) then left else left + wrap.x-at(line, active.column) * cell-width
.. y = content.y + row-top(active.folds.shown(active.row)) + line * source-row-length - shown-top

────────────────────
_ adder-left Length
    - left Length

left + cell-width / 2 - source-add-size / 2

────────────────────
_ control-x Length
    - left Length
    - is-member Bool

left - (if is-member then source-member-indent else source-box-indent) + source-border-width / 2 - source-add-size / 2

────────────────────
_ is-adder Bool
    - active SourceSession
    - row Size

row + 1 == active.row-count || (row == active.row && !active.has-selection && is-head-start)

.. is-head-start = active.is-block-head(row) && active.column <= active.row-at(row).content-start

────────────────────
_ do paint-controls
    - canvas Canvas
    - active SourceSession
    - open Rect

. content = content-bounds
. top = shown-top
. folds = active.folds
. first = first-shown(top)
. last = last-shown(active, top, content.height)
. left = text-bounds.x + source-text-inset - region.scroll-x
. scan = SourceSliceScan(active)
do use canvas.saved-state
    canvas.clip(Rect(content.x, open.y, content.width, open.height))
    for index in first .. < last
        . row = folds.actual(index)
        . adds = is-adder(active, row)
        . is-folded = folds.is-folded(row)
        . folds-here = row == hovered-row && (is-folded || source-fold-head(active, row))
        if adds || is-folded || folds-here
            . x = control-x(left, scan.slice(index, row-height(index)).member != null)
            . y = content.y + row-top(index) - top
            if adds && !folds-here
                paint-add-button(canvas, x, y, row == active.row)
            else
                paint-fold-button(canvas, x, y, !is-folded)

────────────────────
_ do row-under Size?
    - point Point

. active = session
=? null if !active
= spot-under(active, point)?.row

────────────────────
_ do track-hover
    - point Point?

. row Size?
. on-control = false
. active = session
if point && active
    . stuck = stuck-row-at(point)
    row = if stuck then active.folds.actual(stuck.row) else row-under(point)
    on-control = if stuck then is-stuck-control(point, stuck.row) else control-at(point) != null
=? if row == hovered-row && on-control == is-control-hovered
hovered-row = row
is-control-hovered = on-control
invalidate-paint()

────────────────────
_ do is-on-control Bool
    - point Point
    - row Size

. active = session
=? false if !active
. display = active.folds.shown(row)
. is-member = SourceSliceScan(active).slice(display, row-height(display)).member != null
. x = control-x(gutter-width + source-text-inset - region.scroll-x, is-member)
= point.x >= x - source-border-width && point.x <= x + source-add-size + source-border-width

────────────────────
_ do is-stuck-control Bool
    - point Point
    - display Size

. active = session
=? false if !active
. row = active.folds.actual(display)
= source-fold-head(active, row) && is-on-control(point, row)

────────────────────
_ do control-at Size?
    - point Point

. active = session
=? null if !active
. spot = spot-under(active, point)
=? null if !spot || spot.line != 0
. row = spot.row
=? null if !is-on-control(point, row)
= if is-adder(active, row) || active.folds.is-folded(row) || source-fold-head(active, row) then row else null

────────────────────
_ do press-control
    - row Size

. active = session
=? if !active
if is-adder(active, row) && !active.folds.is-folded(row) && !source-fold-head(active, row)
    add-at(row)
    =
active.toggle-fold(row)
refresh()

────────────────────
_ do add-at
    - target Size

. active = session
=? if !active
. is-head = active.is-block-head(target)
active.place(target, 0)
if is-head
    active.split()
refresh()

────────────────────
_ do paint-add-button
    - canvas Canvas
    - x Length
    - y Length
    - is-lit Bool
    - is-lazy = false

if is-lit
    paint-source-add(canvas, x, y, $source-add-lit-color, null, $source-add-lit-mark-color, is-lazy)
else
    paint-source-add(canvas, x, y, $source-add-color, $source-add-border-color, $source-add-mark-color, is-lazy)

────────────────────
_ do paint-fold-button
    - canvas Canvas
    - x Length
    - y Length
    - is-open Bool

paint-source-fold(canvas, x, y, is-open, $source-add-color, $source-add-border-color, $source-add-mark-color)

────────────────────
_ is-open-row Bool
    - active SourceSession
    - row Size

row + 1 == active.row-count || active.is-open-end(row) || active.is-blank-line(row)

────────────────────
_ do chip-at Size?
    - point Point

. active = session
=? null if !active || cell-width <= 0
. x = point.x + region.scroll-x - source-text-inset - gutter-width
. spot = spot-under(active, point)
=? null if x < 0 || !spot || !active.folds.is-folded(spot.row) || spot.line != spot.wrap.last-line
. start = spot.wrap.end-x(spot.line) * cell-width + code-chip-gap
= if x < start || x > start + code-chip-width then null else spot.row

────────────────────
_ stuck-rows [SourceStuckRow]

|? !sticky || !session
    List'SourceStuckRow()
??
    source-stuck-rows(sticky, wrap-rows, region.scroll-y, top-inset)

.. sticky = sticky-rows

────────────────────
+ do get scroll-held-rects

. stuck = stuck-rows()
=? List'Rect() if stuck.length == 0
. content = content-bounds
. top = stuck[0].y
= [Rect(content.x, content.y + top, content.width, source-stuck-height(stuck) - top + 1)]

────────────────────
_ stuck-row-at SourceStuckRow?
    - point Point

source-stuck-at(stuck-rows(), point.y)

────────────────────
_ caret-context TextInputContext?

|? !active || active.row-count == 0
    null
??
    TextInputContext(typed[... count], "", caret-rect(active))

.. active = session
.. shown = active.row-at(active.row)
.. count = active.column - shown.content-start
.. typed = shown.content

────────────────────
_ get text-bounds Rect

Rect(content.x + gutter-width, content.y, content.width - gutter-width, content.height)

.. content = content-bounds

────────────────────
_ get shown-top Length

region.scroll-y - top-inset

────────────────────
_ do number-rows

. active = session
=? if !active
. count = active.row-count - 1
. digits = source-gutter-digits
. limit Size = 1000
while count >= limit
    digits += 1
    limit *= 10
. digit = if cell-width > 0 then ceil(cell-width) else source-digit-width
gutter-width = source-gutter-inset + digits * digit + source-gutter-gap
gutter.gap = source-gutter-gap
gutter.folds = active.folds
gutter.session = active
gutter.version = active.folds.version + active.document.revision
gutter.numbered = active.folds.row-count() - 1
gutter.caret-row = active.folds.shown(active.row)
gutter.head-lit = !active.has-selection && active.is-block-head(active.row) && active.column <= active.row-at(active.row).content-start
gutter.scrolled = shown-top
gutter.rows = wrap-rows
gutter.covered = source-stuck-height(stuck-rows())

────────────────────
_ do widen

. active = session
=? if !active
. font = Font($font-family, $font-size, $font-weight, $font-slant)
if font != measured-font
    measured-font = font
    cell-width = code-cell-width(font)
    bolds = code-cell-width(Font($font-family, $font-size, FontWeight.bold, $font-slant)) == cell-width
    italics = code-cell-width(Font($font-family, $font-size, $font-weight, FontSlant.italic)) == cell-width
    row-width = null
wrap-columns = wrap-width()
sync-wrap(active)
. widest = if wrap-columns > 0 then wrap-rows.widest else max(active.document.widest-columns, widest-columns)
if active.is-dirty && wrap-columns == 0
    widest = max(widest, active.row-at(active.row).columns)
. width = ceil(max(text-width, region.content-bounds.width)) as I64
    .. text-width = widest * cell-width + source-text-inset + source-row-trail
=? if widest == widest-columns && row-width == width
widest-columns = widest
row-width = width

────────────────────
+ find-stamp U64

if active then active.revision + active.document.revision + 1 else 0

.. active = session

────────────────────
+ do find-rows [CodeFindRow]
    - editing Bool

. active = session
=? List'CodeFindRow() if !active
if editing
    active.commit()
= find-cache.rows(active)

────────────────────
+ find-caret CodeFindPlace

if active then CodeFindPlace(active.row, active.column) else CodeFindPlace(0, 0)

.. active = session

────────────────────
+ find-origin CodeFindPlace

if active then CodeFindPlace(active.first-selected-row, active.selection-start) else first-place

.. active = session
.. first-place = CodeFindPlace(0, 0)

────────────────────
+ find-selection CodeHit?

|? !active || !active.has-selection || active.first-selected-row != active.last-selected-row
    null
??
    CodeHit(active.first-selected-row, active.selection-start, active.selection-end)

.. active = session

────────────────────
+ find-seed String?

|? find-selection() == null || text.length == 0
    null
??
    text

.. text = session!.selected-text()

────────────────────
+ do find-reveal
    - hit CodeHit

. active = session
=? if !active
active.select-range(hit.row, hit.start, hit.end)
refresh()

────────────────────
+ do find-replace Bool
    - hit CodeHit
    - text String

. active = session
=? false if !active || !active.can-edit(hit.row)
active.select-range(hit.row, hit.start, hit.end)
. done = if text.length > 0 then active.insert(text) else active.delete-selection()
refresh()
= done

────────────────────
+ find-can-edit Bool
    - row Size

session?.can-edit(row) ?? false

────────────────────
+ do find-rewrite CodeRewrite
    - rows [Size]
    - texts [String]

. active = session
=? CodeRewrite(0, 0) if !active
. outcome = active.replace-rows(rows, texts)
refresh()
= CodeRewrite(outcome.changed, outcome.held)

────────────────────
+ do find-show
    - model CodeFind?

find = model
invalidate-paint()

────────────────────
+ do find-focus

request-focus()

────────────────────
+ do close

stop-blink()
retire-ink()
retire-ink()
super.close()

────────────────────
+ do did-layout

super.did-layout()
overview.clearance = region.$scroll-indicator-thickness + region.$scroll-indicator-inset
widen()
number-rows()

────────────────────
+ do paint-self
    - canvas Canvas

. whole = content-bounds
canvas.fill-color = $gui-editor-background-color
canvas.rect(whole)
. active = session
=? if !active || active.row-count == 0
. content = text-bounds
. top = shown-top
. folds = active.folds
. first = first-shown(top)
. last = last-shown(active, top, content.height)
. selects = active.has-selection
. first-selected = active.first-selected-row
. last-selected = active.last-selected-row
. left = content.x + source-text-inset - region.scroll-x
. finder = find
. hits = if finder then finder.found else List'CodeHit()
. next-hit = if finder then finder.first-at(folds.actual(first)) else 0
. focus-hit = finder.current if finder
. right = box-right(content)
. rule-end = min(content.right, right - source-box-indent)
. scan = SourceSliceScan(active)
. slices [SourceSlice]
for index in first .. < last
    slices += scan.slice(index, row-height(index))
paint-surfaces(canvas, slices, content, first, left, right)
. known = insight
if known
    paint-unknown(canvas, active, known, slices, content, first, left, right)
do use canvas.saved-state
    canvas.clip(whole)
    for index in first .. < last
        . row = folds.actual(index)
        . shown = active.row-at(row)
        . held = shown.is-invalid
        . is-typed = active.is-dirty && row == active.row
        . is-tinted = held && !is-typed
        . is-current = row == active.row && !selects && active.can-edit(row)
        . y = whole.y + row-top(index) - top
        . height = row-height(index)
        if is-tinted || is-current
            . band = Rect(whole.x, y, whole.width, height)
            . shape = source-slice-shape(slices[index - first], Rect(content.x, y, content.width, height), left - source-box-indent, right)
            do use canvas.saved-state
                canvas.clip(band)
                if shape
                    canvas.clip-outline(shape)
                canvas.stroke-color = null
                canvas.fill-color = if is-tinted then $source-held-band-color else $source-band-color
                canvas.rect(band)
do use canvas.saved-state
    canvas.clip(content)
    for index in first .. < last
        . row = folds.actual(index)
        . shown = active.row-at(row)
        . wrap = source-row-wrap(shown, wrap-columns, source-indent-columns)
        . y = content.y + row-top(index) - top
        if known && !(active.is-dirty && row == active.row)
            paint-washes(canvas, known, shown, wrap, left, y, folds.is-folded(row), lit-for(active, shown))
        if folds.is-folded(row)
            . x = left + wrap.end-x(wrap.last-line) * cell-width + code-chip-gap
            code-fold-chip
                - canvas
                - x
                - y + wrap.last-line * source-row-length
                - source-row-length
                - $gui-editor-fold-chip-color
                - $gui-editor-line-number-color
        if active.is-open-end(row)
            paint-add-button(canvas, adder-left(left), y, row == active.row && !selects, slices[index - first].kind == SourceRowBlock.text)
        else if shown.divider == source-divider-double
            . start = max(content.x, left)
            . width = rule-end - start
            . rule-y = y + floor((source-row-length - source-double-divider-height) / 2)
            canvas.fill-color = $source-thin-divider-color
            canvas.rect(Rect(start, rule-y, width, source-thin-divider-height))
            canvas.rect(Rect(start, rule-y + source-double-divider-height - source-thin-divider-height, width, source-thin-divider-height))
        while next-hit < hits.length && hits[next-hit].row < row
            next-hit += 1
        while next-hit < hits.length && hits[next-hit].row == row
            if next-hit != focus-hit
                canvas.fill-color = $gui-editor-find-color
                for rect in span-rects(wrap, hits[next-hit].start, hits[next-hit].end, left, y)
                    canvas.rect(rect)
            next-hit += 1
        if selects && row >= first-selected && row <= last-selected
            . low = if row == first-selected then active.selection-start else 0
            . high = if row == last-selected then active.selection-end else shown.columns + 1
            canvas.fill-color = if is-focused then $gui-editor-selection-color else $gui-editor-idle-selection-color
            for rect in span-rects(wrap, low, high, left, y)
                canvas.rect(rect)
    . focused = finder.current-found if finder
    if focused && !folds.is-hidden(focused.row)
        . display = folds.shown(focused.row)
        if display >= first && display < last
            . y = content.y + row-top(display) - top
            canvas.fill-color = $gui-editor-find-current-color
            for rect in span-rects(row-wrap(active, focused.row), focused.start, focused.end, left, y)
                canvas.rect(rect)

────────────────────
_ do paint-unknown
    - canvas Canvas
    - active SourceSession
    - known SourceInsight
    - slices [SourceSlice]
    - content Rect
    - first Size
    - left Length
    - right Length

=? if known.unknown.length == 0
do use canvas.saved-state
    canvas.clip(content)
    for offset in 0 .. < slices.length
        . row = active.folds.actual(first + offset)
        if known.is-unknown(active.row-at(row))
            . y = content.y + row-top(first + offset) - shown-top
            . band = Rect(content.x, y, content.width, row-height(first + offset))
            . shape = source-slice-shape(slices[offset], band, left - source-box-indent, right)
            if shape
                paint-source-hatch(canvas, shape, band, $source-unknown-color)

────────────────────
_ do paint-washes
    - canvas Canvas
    - known SourceInsight
    - shown SourceRow
    - wrap SourceWrap
    - left Length
    - y Length
    - is-folded Bool
    - lit [String]

. marks = known.marks-of(shown)
for mark in marks
    if mark.kind == SourceMarkKind.wait
        paint-mark(canvas, mark, wrap, left, y, $source-wait-color)
. last-y = y + wrap.last-line * source-row-length
. end = left + wrap.end-x(wrap.last-line) * cell-width + (if is-folded then code-chip-gap + code-chip-width else 0) + cell-width
. fill = known.fill-of(shown)
if fill
    end = paint-fill(canvas, fill, lit, end, last-y)
end += cell-width
for mark in marks
    . caption = mark.caption
    if caption
        paint-caption(canvas, caption, end, last-y)
        =

