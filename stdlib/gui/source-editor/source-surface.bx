(import /code/structure/document)
(import /code/structure/fold)
(import /code/structure/rows)
(import /code/structure/session)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(blank)
(prop + source-box-radius Length (= 8))
(prop + source-box-indent Length (= 18))
(prop + source-member-indent Length (= 10))
(prop + source-box-margin Length (= 8))
(prop + source-edge-offset Length (= 9))
(prop + source-edge-step Length (= 4))
(prop + source-wash-trail Length (= 6))
(prop + source-border-width Length (= 1))
(prop _ source-private-dash Length (= 3))

(type + SourceSurface (is Union)
  (variant none)
  (variant box)
  (variant tray)
)

(type + SourceReach (is Tuple)
  (prop + top (? Length))
  (prop + bottom (? Length))
)

(type + SourceSlice (is Tuple)
  (prop + surface SourceSurface)
  (prop + outer (? SourceReach))
  (prop + member (? SourceReach) (= null))
  (prop + wash (? SourceReach) (= null))
  (prop + kind _ (= (. SourceRowBlock none)))
  (prop + is-private _ (= false))
  (prop + is-member-private _ (= false))
  (prop + is-ruled _ (= false))
)

(type + SourceSurfacePalette (is Tuple)
  (prop + box RGBA)
  (prop + box-border RGBA)
  (prop + tray RGBA)
  (prop + tray-border RGBA)
  (prop + member RGBA)
  (prop + member-border RGBA)
  (prop + wash RGBA)
  (prop + steps-wash RGBA)
  (prop + text-wash RGBA)
  (prop + holder-wash RGBA)
  (prop + steps-border RGBA)
  (prop + text-border RGBA)
  (prop + background RGBA)
)

(type + SourceSliceScan
  (prop + session SourceSession)
  (blank)
  (prop _ member-declaration (? Index))
  (prop _ member-start Size)
  (prop _ member-end Size)
  (prop _ is-member _ (= false))
  (fn-do + This _
    (param session _)
  )
  (fn-do + slice SourceSlice
    (param display Size)
    (param height Length)
    (let document (. session document))
    (let folds (. session folds))
    (let row (call (. folds actual) display))
    (return-if (call SourceSlice .none null) (if (>= (+ row 1) (. document row-count))))
    (blank)
    (let index (call (. document declaration-at) row))
    (let rows (call (. document rows-of) index))
    (let base (call (. document first-row) index))
    (let local (- row base))
    (let surface (call block-surface (. ([] rows 0) block)))
    (return-if (call SourceSlice .none null) (if (== surface (. SourceSurface none))))
    (blank)
    (let next (if-expr (< (+ display 1) (call (. folds row-count))) (call (. folds actual) (+ display 1)) (. document row-count)))
    (let after (- next base))
    (let current ([] rows local))
    (let closes (>= after (. rows length)))
    (let is-gap (and (== (. current node) null) (== (. current divider) 0)))
    (let is-tray (== surface (. SourceSurface tray)))
    (let outer-bottom (? Length) null)
    (if closes
      (= outer-bottom (if-expr (not is-gap) height source-edge-offset))
    )
    (let outer (call SourceReach (only-if source-edge-offset (if (== local 0))) outer-bottom))
    (let in-member (and is-tray (call is-member-row index rows local)))
    (let member (? SourceReach) null)
    (let bottom outer-bottom)
    (if in-member
      (let member-closes (or closes (>= after member-end)))
      (let member-bottom (? Length) null)
      (if member-closes
        (let edge (if-expr is-gap source-edge-offset height))
        (= member-bottom (if-expr closes (- edge source-edge-step) edge))
      )
      (= member (call SourceReach (only-if source-edge-offset (if (== local member-start))) member-bottom))
      (= bottom member-bottom)
    )
    (let opens (or (== local 0) (and in-member (== local member-start))))
    (let wash (? SourceReach) null)
    (if (== (. current zone) (. SourceRowZone header))
      (let continues (and (not closes) (== next (+ row 1)) (or (== (. ([] rows after) zone) (. SourceRowZone header)) (== (. ([] rows after) node) null))))
      (= wash (call SourceReach null (if-expr continues null (?? bottom height))))
      (else-if (and opens (< (+ local 1) (. rows length)) (== (. ([] rows (+ local 1)) zone) (. SourceRowZone header)))
        (= wash (call SourceReach source-edge-offset null))
      )
      (else-if (and is-gap (> local 0) (== (. ([] rows (- local 1)) zone) (. SourceRowZone header)))
        (= wash (call SourceReach null (call min source-wash-trail (?? bottom source-wash-trail))))
      )
    )
    (let kind (if-expr in-member (. ([] rows member-start) block) (. ([] rows 0) block)))
    (return
      (call SourceSlice
        (block
          (arg surface)
          (arg outer)
          (arg member)
          (arg wash)
          (arg kind)
          (arg (. ([] rows 0) is-private))
          (arg (and in-member (. ([] rows member-start) is-private)))
          (arg (== (. current divider) source-divider-dashed))
        )
      )
    )
  )
  (fn-do _ is-member-row Bool
    (param index Index)
    (param rows (list SourceOutlineRow))
    (param local Size)
    (let home (. ([] rows 0) owner))
    (return-if false (if (== (. ([] rows local) owner) home)))
    (return-if is-member (if (and (== member-declaration index) (>= local member-start) (< local member-end))))
    (blank)
    (let start local)
    (while (and (> start 0) (!= (. ([] rows start) divider) source-divider-thin) (!= (. ([] rows (- start 1)) owner) home))
      (-= start 1)
    )
    (let end (+ start 1))
    (while (and (< end (. rows length)) (!= (. ([] rows end) owner) home) (!= (. ([] rows end) divider) source-divider-thin))
      (+= end 1)
    )
    (= member-declaration index)
    (= member-start start)
    (= member-end end)
    (= is-member (and (== (. ([] rows start) divider) source-divider-thin) (call source-is-function-block (. ([] rows start) block))))
    (return is-member)
  )
)

(fn-expr _ block-surface SourceSurface
  (param block SourceRowBlock)
  (match block
    (case .holder
      (. SourceSurface tray)
    )
    (case .none
      (. SourceSurface none)
    )
    (default
      (. SourceSurface box)
    )
  )
)

(fn-expr _ source-is-function-block Bool
  (param block SourceRowBlock)
  (or (== block (. SourceRowBlock leaf)) (== block (. SourceRowBlock steps)) (== block (. SourceRowBlock text)))
)

(fn-do + paint-source-slice _
  (param canvas Canvas)
  (param slice SourceSlice)
  (param band Rect)
  (param left Length)
  (param right Length)
  (param palette SourceSurfacePalette)
  (let outer (. slice outer))
  (return-if (if (or (not outer) (<= right left))))
  (blank)
  (let box (call source-reached band outer left right))
  (let step (- source-box-indent source-member-indent))
  (let member (. slice member))
  (let inner box)
  (if member
    (= inner (call source-reached band member (+ left step) (- right step)))
  )
  (let fill (call (. (call source-surface-color (. slice surface) palette) over) (. palette background)))
  (let member-fill (call (. palette member over) fill))
  (do-use (. canvas saved-state)
    (call (. canvas clip) band)
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) fill)
    (call (. canvas outline) (call Outline box source-box-radius))
    (if member
      (= (. canvas fill-color) member-fill)
      (call (. canvas outline) (call Outline inner source-box-radius))
    )
    (let wash (. slice wash))
    (if wash
      (let top (+ (. band y) (?? (. wash top) (* (- source-box-radius) 2))))
      (let bottom (+ (. band y) (?? (. wash bottom) (+ (. band height) (* source-box-radius 2)))))
      (do-use (. canvas saved-state)
        (call (. canvas clip) (call Rect (. band x) top (. band width) (- bottom top)))
        (let washed
          (call (. (call source-wash-fill (. slice kind) palette) over)
            (block
              (arg (if-expr member member-fill fill))
            )
          )
        )
        (= (. canvas fill-color) washed)
        (call (. canvas outline) (call Outline inner source-box-radius))
      )
    )
    (let border (call source-surface-border (. slice surface) palette))
    (let rule (? RGBA) null)
    (if border
      (let shown
        (match (. slice surface)
          (case= (. SourceSurface box)
            (call source-kind-border (. slice kind) border palette)
          )
          (default
            border
          )
        )
      )
      (let edge (call (. shown over) fill))
      (call stroke-source-edge canvas box band edge (. slice is-private))
      (= rule edge)
    )
    (if member
      (let edge (call (. (call source-kind-border (. slice kind) (. palette member-border) palette) over) member-fill))
      (call stroke-source-edge canvas inner band edge (. slice is-member-private))
      (= rule edge)
    )
    (if (and (. slice is-ruled) rule)
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) rule)
      (call paint-source-rule
        (block
          (arg canvas)
          (arg (. inner x))
          (arg (. inner right))
          (arg (+ (. band y) (call floor (/ (- (. band height) source-border-width) 2))))
        )
      )
    )
  )
)

(fn-do _ stroke-source-edge _
  (param canvas Canvas)
  (param box Rect)
  (param band Rect)
  (param color RGBA)
  (param is-dashed Bool)
  (let shape (call (. (call Outline box source-box-radius) grow) (/ (- source-border-width) 2)))
  (= (. canvas fill-color) null)
  (= (. canvas stroke-width) source-border-width)
  (= (. canvas stroke-color) color)
  (if (not is-dashed)
    (call (. canvas outline) shape)
    (return)
  )
  (let radius source-box-radius)
  (call stroke-source-corner canvas (call Point (+ (. box x) radius) (+ (. box y) radius)) 180deg band)
  (call stroke-source-corner canvas (call Point (- (. box right) radius) (+ (. box y) radius)) 270deg band)
  (call stroke-source-corner canvas (call Point (- (. box right) radius) (- (. box bottom) radius)) 0deg band)
  (call stroke-source-corner canvas (call Point (+ (. box x) radius) (- (. box bottom) radius)) 90deg band)
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) color)
  (let width source-border-width)
  (let count (call max (call round (/ (. band height) (* source-private-dash 2))) 1))
  (let period (/ (. band height) count))
  (let top (call max (. band y) (+ (. box y) radius)))
  (let bottom (call min (. band bottom) (- (. box bottom) radius)))
  (let y (. band y))
  (while (< y bottom)
    (let from (call max y top))
    (let to (call min (+ y (/ period 2)) bottom))
    (if (> to from)
      (call (. canvas rect) (call Rect (. box x) from width (- to from)))
      (call (. canvas rect) (call Rect (- (. box right) width) from width (- to from)))
    )
    (+= y period)
  )
  (if (and (>= (. box y) (- (. band y) width)) (< (. box y) (. band bottom)))
    (call paint-source-dashes canvas (+ (. box x) radius) (- (. box right) radius) (. box y))
  )
  (if (and (> (. box bottom) (. band y)) (<= (. box bottom) (+ (. band bottom) width)))
    (call paint-source-dashes canvas (+ (. box x) radius) (- (. box right) radius) (- (. box bottom) width))
  )
)

(fn-do _ stroke-source-corner _
  (param canvas Canvas)
  (param center Point)
  (param start Radians)
  (param band Rect)
  (let radius (- source-box-radius (/ source-border-width 2)))
  (return-if (if (or (<= (+ (. center y) radius) (. band y)) (>= (- (. center y) radius) (. band bottom)))))
  (blank)
  (let count (call max (call round (/ (* radius 1.5707963267948966) (* source-private-dash 2))) 1))
  (let step (/ 90deg count))
  (let dashes (as count Size))
  (for (in index (..< 0 dashes))
    (let from (+ start (* step (+ (as index F64) 0.25))))
    (call (. canvas begin))
    (call (. canvas move) (+ (. center x) (* (call cos from) radius)) (+ (. center y) (* (call sin from) radius)))
    (for (in part (.. 1 4))
      (let angle (+ from (/ (* (/ step 2) (as part F64)) 4)))
      (call (. canvas line) (+ (. center x) (* (call cos angle) radius)) (+ (. center y) (* (call sin angle) radius)))
    )
    (call (. canvas end))
  )
)

(fn-do _ paint-source-dashes _
  (param canvas Canvas)
  (param left Length)
  (param right Length)
  (param y Length)
  (let x left)
  (while (< x right)
    (call (. canvas rect) (call Rect x y (call min source-private-dash (- right x)) source-border-width))
    (+= x (* source-private-dash 2))
  )
)

(fn-do _ paint-source-rule _
  (param canvas Canvas)
  (param left Length)
  (param right Length)
  (param y Length)
  (let count (call max (call round (/ (+ (- right left) source-private-dash) (* source-private-dash 2))) 2))
  (let period (/ (- right left source-private-dash) (- count 1)))
  (let dashes (as count Size))
  (for (in index (..< 0 dashes))
    (call (. canvas rect)
      (block
        (arg (call Rect (call round (+ left (* period (as index F64)))) y source-private-dash source-border-width))
      )
    )
  )
)

(fn-expr + source-slice-shape (? Outline)
  (param slice SourceSlice)
  (param band Rect)
  (param left Length)
  (param right Length)
  (case? (not outer)
    null
  )
  (case? (not member)
    (call Outline (call source-reached band outer left right) source-box-radius)
  )
  (default
    (call Outline (call source-reached band member (+ left step) (- right step)) source-box-radius)
  )
  (where
    (lazy outer (. slice outer))
    (lazy member (. slice member))
    (lazy step (- source-box-indent source-member-indent))
  )
)

(fn-expr _ source-reached Rect
  (param band Rect)
  (param reach SourceReach)
  (param left Length)
  (param right Length)
  (call Rect left top (- right left) (- bottom top))
  (where
    (lazy top (+ (. band y) (?? (. reach top) (* (- source-box-radius) 2))))
    (lazy bottom (+ (. band y) (?? (. reach bottom) (+ (. band height) (* source-box-radius 2)))))
  )
)

(fn-expr _ source-surface-color RGBA
  (param surface SourceSurface)
  (param palette SourceSurfacePalette)
  (match surface
    (case .tray
      (. palette tray)
    )
    (default
      (. palette box)
    )
  )
)

(fn-expr _ source-wash-fill RGBA
  (param kind SourceRowBlock)
  (param palette SourceSurfacePalette)
  (match kind
    (case .steps
      (. palette steps-wash)
    )
    (case .text
      (. palette text-wash)
    )
    (case .holder
      (. palette holder-wash)
    )
    (default
      (. palette wash)
    )
  )
)

(fn-expr _ source-kind-border RGBA
  (param kind SourceRowBlock)
  (param plain RGBA)
  (param palette SourceSurfacePalette)
  (match kind
    (case .steps
      (. palette steps-border)
    )
    (case .text
      (. palette text-border)
    )
    (default
      plain
    )
  )
)

(fn-expr _ source-surface-border (? RGBA)
  (param surface SourceSurface)
  (param palette SourceSurfacePalette)
  (match surface
    (case .tray
      (. palette tray-border)
    )
    (default
      (. palette box-border)
    )
  )
)
