(import /code/structure/document)
(import /code/structure/rows)
(import /code/structure/session)
(import /math)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)
(prop + source-wrap-least Size (= 20))

(type + SourceWrapSegment (is (tuple (: line Index) (: start Size) (: end Size))))

(type + SourceWrap (is Tuple)
  (prop + starts (list Size))
  (prop + hang Size)
  (prop + columns Size)
  (fn-expr + line-count Size :get
    (. starts length)
  )
  (fn-expr + last-line Index :get
    (- (. starts length) 1)
  )
  (fn-do + line-of Index
    (param column Size)
    (let low Index 0)
    (let high (. starts length))
    (while (< (+ low 1) high)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= ([] starts middle) column)
        (= low middle)
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
  (fn-expr + line-x Size
    (param line Index)
    (if-expr (== line 0) 0 hang)
  )
  (fn-expr + line-end Size
    (param line Index)
    (if-expr (< line last-line) ([] starts (+ line 1)) columns)
  )
  (fn-expr + last-column Size
    (param line Index)
    (if-expr (< line last-line) (- ([] starts (+ line 1)) 1) columns)
  )
  (fn-expr + x-at Size
    (param line Index)
    (param column Size)
    (- (+ (call line-x line) column) ([] starts line))
  )
  (fn-expr + x-of Size
    (param column Size)
    (call x-at (call line-of column) column)
  )
  (fn-expr + end-x Size
    (param line Index)
    (call x-at line (call line-end line))
  )
  (fn-expr + column-at Size
    (param line Index)
    (param x Size)
    (call min (+ ([] starts line) offset) (call last-column line))
    (where
      (lazy offset (if-expr (> x (call line-x line)) (- x (call line-x line)) 0))
    )
  )
  (fn-expr + column-under (? Size)
    (param line Index)
    (param x Size)
    (case? (or (< x (call line-x line)) (>= column (call line-end line)))
      null
    )
    (default
      column
    )
    (where
      (lazy column (- (+ ([] starts line) x) (call line-x line)))
    )
  )
  (fn-do + widest Size :get
    (let found Size 0)
    (for (in line (..< 0 (. starts length)))
      (= found (call max found (call end-x line)))
    )
    (return found)
  )
  (fn-do + segments (list SourceWrapSegment)
    (param start Size)
    (param end Size)
    (let found (list SourceWrapSegment))
    (return-if found (if (<= end start)))
    (blank)
    (for (in line (..< (call line-of start) (. starts length)))
      (let from (call max start ([] starts line)))
      (let to (if-expr (< line last-line) (call min end ([] starts (+ line 1))) end))
      (if (<= to from)
        (break)
      )
      (+= found (call SourceWrapSegment line (call x-at line from) (call x-at line to)))
    )
    (return found)
  )
)

(fn-do + source-wrap SourceWrap
  (param text String)
  (param width Size)
  (param unit Size)
  (let chars (. text codepoints))
  (let count (. chars length))
  (let indent Size 0)
  (while (and (< indent count) (== ([] chars indent) (char " ")))
    (+= indent 1)
  )
  (let reach (call max width (+ indent source-wrap-least)))
  (return-if (call SourceWrap (call (of List Size) 0) 0 count) (if (or (== width 0) (<= count reach))))
  (blank)
  (let hang (call min (+ indent unit) (if-expr (> width source-wrap-least) (- width source-wrap-least) 0)))
  (let room (- (call max width (+ hang source-wrap-least)) hang))
  (let starts (call (of List Size) 0))
  (let start Size 0)
  (while (> (- count start) reach)
    (let end (+ start reach))
    (let cut end)
    (let at (- end 1))
    (let floor (call max (+ start 1) indent))
    (while (>= at floor)
      (if (== ([] chars at) (char " "))
        (= cut (+ at 1))
        (break)
      )
      (-= at 1)
    )
    (+= starts cut)
    (= start cut)
    (= reach room)
  )
  (return (call SourceWrap starts hang count))
)

(fn-do + source-row-wrap SourceWrap
  (param row SourceRow)
  (param width Size)
  (param unit Size)
  (let columns (. row columns))
  (if (or (== width 0) (<= columns width) (. row is-divider) (== (. row spans length) 0))
    (return (call SourceWrap (call (of List Size) 0) 0 columns))
  )
  (return (call source-wrap (. row text) width (if-expr (. row is-prose) 0 unit)))
)

(type + SourceWrapRows
  (implements VirtualRowOffsets)
  (prop + count Size)
  (prop + tops (list Size))
  (prop + widest Size)
  (prop + line-height VirtualCoord)
  (prop + tail VirtualCoord)
  (fn-do + This _
    (param count _)
    (param tops _)
    (param widest _)
    (param line-height _)
    (param tail _)
  )
  (fn-expr + is-wrapped Bool :get
    (!= (. tops length) 0)
  )
  (fn-do + take _
    (param other SourceWrapRows)
    (= count (. other count))
    (= tops (. other tops))
    (= widest (. other widest))
  )
  (fn-expr + top Size
    (param display Size)
    (if-expr (== (. tops length) 0) shown ([] tops shown))
    (where
      (lazy shown (call min display count))
    )
  )
  (fn-expr + lines Size
    (param display Size)
    (- (call top (+ display 1)) (call top display))
  )
  (fn-expr + line-count Size :get
    (call top count)
  )
  (fn-do + display-at Size
    (param line Size)
    (return-if 0 (if (== count 0)))
    (return-if (call min line (- count 1)) (if (== (. tops length) 0)))
    (blank)
    (let low Size 0)
    (let high count)
    (while (< (+ low 1) high)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= ([] tops middle) line)
        (= low middle)
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
  (fn-expr + total-height VirtualCoord :get
    (+ (* (as line-count VirtualCoord) line-height) tail)
  )
  (fn-expr + offset-at VirtualCoord
    (param index VirtualCoord)
    (* (as (call top (as index Size)) VirtualCoord) line-height)
  )
  (fn-expr + index-at VirtualCoord
    (param offset VirtualCoord)
    (as (call display-at (as (/ offset line-height) Size)) VirtualCoord)
  )
)

(type _ SourceWrapText (is (tuple (: columns Size) (: text String) (: is-prose Bool))))

(type _ SourceWrapLines (is (tuple (: lines (list Size)) (: widest Size))))

(type + SourceWrapCache
  (prop _ texts _ (= (call (of Map U32 (list SourceWrapText)))))
  (prop _ counted _ (= (call (of Map U32 SourceWrapLines))))
  (prop _ counted-width Size)
  (prop _ compactions Size)
  (fn-do + reset _
    (= texts (call (of Map U32 (list SourceWrapText))))
    (= counted (call (of Map U32 SourceWrapLines)))
  )
  (fn-do + rows SourceWrapRows
    (param session SourceSession)
    (param width Size)
    (param unit Size)
    (param line-height VirtualCoord)
    (param tail VirtualCoord)
    (let document (. session document))
    (let folds (. session folds))
    (let count (call (. folds row-count)))
    (return-if (call SourceWrapRows count (call (of List Size)) 0 line-height tail) (if (== width 0)))
    (blank)
    (if (!= (. document compaction-count) compactions)
      (call reset)
      (= compactions (. document compaction-count))
    )
    (if (!= width counted-width)
      (= counted (call (of Map U32 SourceWrapLines)))
      (= counted-width width)
    )
    (let kept-texts (call (of Map U32 (list SourceWrapText))))
    (let kept-counts (call (of Map U32 SourceWrapLines)))
    (let lines (list Size))
    (let widest Size 0)
    (for (in index (..< 0 (. document declarations length)))
      (let place ([] (. document declarations) index))
      (let held (?? ([] texts place) ([] kept-texts place) (call wrap-texts document index)))
      (= ([] kept-texts place) held)
      (let found (?? ([] counted place) ([] kept-counts place) (call wrap-lines held width unit)))
      (= ([] kept-counts place) found)
      (++= lines (. found lines))
      (= widest (call max widest (. found widest)))
    )
    (= texts kept-texts)
    (= counted kept-counts)
    (while (< (. lines length) (. document row-count))
      (+= lines 1)
    )
    (if (and (. session is-dirty) (< (. session row) (. lines length)))
      (let typed (call source-row-wrap (call (. session row-at) (. session row)) width unit))
      (= ([] lines (. session row)) (. typed line-count))
      (= widest (call max widest (. typed widest)))
    )
    (let tops (call (of List Size) 0))
    (let total Size 0)
    (for (in display (..< 0 count))
      (let row (call (. folds actual) display))
      (+= total (if-expr (< row (. lines length)) ([] lines row) 1))
      (+= tops total)
    )
    (return (call SourceWrapRows count tops widest line-height tail))
  )
  (fn-do _ wrap-texts (list SourceWrapText)
    (param document SourceDocument)
    (param index Index)
    (let made (list SourceWrapText))
    (for (in outline (call (. document rows-of) index))
      (let shown (call (. document language render) outline))
      (let columns (. shown columns))
      (let wraps (and (not (. shown is-divider)) (!= (. shown spans length) 0) (> columns source-wrap-least)))
      (+= made (call SourceWrapText columns (if-expr wraps (. shown text) "") (. shown is-prose)))
    )
    (return made)
  )
  (fn-do _ wrap-lines SourceWrapLines
    (param texts (list SourceWrapText))
    (param width Size)
    (param unit Size)
    (let lines (list Size))
    (let widest Size 0)
    (for (in held texts)
      (if (or (== (. held text length) 0) (<= (. held columns) width))
        (+= lines 1)
        (= widest (call max widest (. held columns)))
        (else
          (let wrap (call source-wrap (. held text) width (if-expr (. held is-prose) 0 unit)))
          (+= lines (. wrap line-count))
          (= widest (call max widest (. wrap widest)))
        )
      )
    )
    (return (call SourceWrapLines lines widest))
  )
)
