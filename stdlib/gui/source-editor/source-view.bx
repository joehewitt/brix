    (case? (or (not sticky) (not session))
      (call (of List SourceStuckRow))
    )
    (default
      (call source-stuck-rows sticky wrap-rows (. region scroll-y) top-inset)
    )
    (where
      (lazy sticky sticky-rows)
    )
