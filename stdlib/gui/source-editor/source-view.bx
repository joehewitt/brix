  (fn-do _ row-under (? Size)
    (param point Point)
    (let active session)
    (return-if null (if (not active)))
    (return (?. (call spot-under active point) row))
  )
  (fn-do _ track-hover _
    (param point (? Point))
    (let row (? Size))
    (let on-control false)
    (let active session)
