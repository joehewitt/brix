  (fn-do _ is-on-control Bool
    (param point Point)
    (param row Size)
    (let active session)
    (return-if false (if (not active)))
    (blank)
    (let display (call (. active folds shown) row))
    (let is-member (!= (. (call (. (call SourceSliceScan active) slice) display (call row-height display)) member) null))
    (let x (call control-x (- (+ gutter-width source-text-inset) (. region scroll-x)) is-member))
    (return (and (>= (. point x) (- x source-border-width)) (<= (. point x) (+ x source-add-size source-border-width))))
  )
  (fn-do _ is-stuck-control Bool
    (param point Point)
    (param display Size)
    (let active session)
    (return-if false (if (not active)))
