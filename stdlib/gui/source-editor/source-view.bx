    (return-if (if (not active)))
    (blank)
    (let is-head (call (. active is-block-head) target))
    (call (. active place) target 0)
    (if is-head
      (call (. active split))
    )
    (call refresh)
  )
  (fn-do _ paint-add-button _
    (param canvas Canvas)
    (param x Length)
    (param y Length)
    (param is-lit Bool)
    (param is-lazy _ (= false))
    (if is-lit
      (call paint-source-add canvas x y $source-add-lit-color null $source-add-lit-mark-color is-lazy)
      (else
        (call paint-source-add
          (block
            (arg canvas)
            (arg x)
            (arg y)
            (arg $source-add-color)
            (arg $source-add-border-color)
            (arg $source-add-mark-color)
            (arg is-lazy)
          )
        )
      )
    )
  )
  (fn-do _ paint-fold-button _
    (param canvas Canvas)
    (param x Length)
    (param y Length)
    (param is-open Bool)
    (call paint-source-fold
      (block
        (arg canvas)
        (arg x)
        (arg y)
        (arg is-open)
        (arg $source-add-color)
        (arg $source-add-border-color)
        (arg $source-add-mark-color)
      )
    )
  )
  (fn-expr _ is-open-row Bool
    (param active SourceSession)
    (param row Size)
    (or (== (+ row 1) (. active row-count)) (call (. active is-open-end) row) (call (. active is-blank-line) row))
  )
  (fn-do _ chip-at (? Size)
    (param point Point)
