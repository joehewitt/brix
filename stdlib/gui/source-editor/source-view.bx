    (let row (call (. active folds actual) display))
    (return (and (call source-fold-head active row) (call is-on-control point row)))
  )
  (fn-do _ control-at (? Size)
    (param point Point)
    (let active session)
    (return-if null (if (not active)))
    (blank)
    (let spot (call spot-under active point))
    (return-if null (if (or (not spot) (!= (. spot line) 0))))
    (blank)
    (let row (. spot row))
    (return-if null (if (not (call is-on-control point row))))
    (return (only-if row (if (or (call is-adder active row) (call (. active folds is-folded) row) (call source-fold-head active row)))))
  )
  (fn-do _ press-control _
    (param row Size)
    (let active session)
    (return-if (if (not active)))
    (blank)
    (if (and (call is-adder active row) (not (call (. active folds is-folded) row)) (not (call source-fold-head active row)))
      (call add-at row)
      (return)
