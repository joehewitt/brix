  (fn-expr _ control-x Length
    (param left Length)
    (param is-member Bool)
    (- (+ (- left (if-expr is-member source-member-indent source-box-indent)) (/ source-border-width 2)) (/ source-add-size 2))
  )
  (fn-expr _ is-adder Bool
    (param active SourceSession)
    (param row Size)
    (or (== (+ row 1) (. active row-count)) (and (== row (. active row)) (not (. active has-selection)) is-head-start))
    (where
      (lazy is-head-start (and (call (. active is-block-head) row) (<= (. active column) (. (call (. active row-at) row) content-start))))
    )
  )
  (fn-do _ paint-controls _
    (param canvas Canvas)
    (param active SourceSession)
    (param open Rect)
    (let content content-bounds)
    (let top shown-top)
    (let folds (. active folds))
    (let first (call first-shown top))
    (let last (call last-shown active top (. content height)))
    (let left (- (+ (. text-bounds x) source-text-inset) (. region scroll-x)))
    (let scan (call SourceSliceScan active))
    (do-use (. canvas saved-state)
      (call (. canvas clip) (call Rect (. content x) (. open y) (. content width) (. open height)))
      (for (in index (..< first last))
        (let row (call (. folds actual) index))
        (let adds (call is-adder active row))
        (let is-folded (call (. folds is-folded) row))
        (let folds-here (and (== row hovered-row) (or is-folded (call source-fold-head active row))))
        (if (or adds is-folded folds-here)
          (let x (call control-x left (!= (. (call (. scan slice) index (call row-height index)) member) null)))
          (let y (- (+ (. content y) (call row-top index)) top))
          (if (and adds (not folds-here))
