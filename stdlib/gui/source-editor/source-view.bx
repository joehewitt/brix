  (fn-do _ start-blink _
    (= is-caret-lit true)
    (call (?. blinker cancel-later))
    (= blinker
      (do-new
        (while true
          (call (. source-blink-interval wait))
          (= is-caret-lit (not is-caret-lit))
          (call invalidate-paint)
        )
      )
    )
  )
  (fn-do _ stop-blink _
    (call (?. blinker cancel-later))
    (= blinker null)
  )
  (fn-do _ reveal-caret _
    (param active SourceSession)
    (let view (. region content-bounds))
    (return-if (if (or (<= (. view width) 0) (<= (. view height) 0))))
    (blank)
    (let display (call (. active folds shown) (. active row)))
    (call (. region scroll-to-address) display (. ScrollAlignment nearest))
    (if (== (+ (. active row) 1) (. active row-count))
      (call (. region scroll-to-end) (. Orientation vertical))
    )
    (let wrap (call row-wrap active (. active row)))
    (let top (+ (call row-top display) (* (call (. wrap line-of) (. active column)) source-row-length)))
    (let y (. region scroll-y))
    (if (< top y)
      (= y top)
      (else-if (> (+ top source-row-length top-inset) (+ y (. view height)))
        (= y (- (+ top source-row-length top-inset) (. view height)))
      )
    )
    (let left (+ source-text-inset (* (call (. wrap x-of) (. active column)) cell-width)))
    (let x (. region scroll-x))
    (if (< (- left source-text-inset) x)
      (= x (- left source-text-inset))
      (else-if (> (+ left source-row-trail) (+ x (. view width)))
        (= x (- (+ left source-row-trail) (. view width)))
      )
    )
    (if (or (!= x (. region scroll-x)) (!= y (. region scroll-y)))
      (call (. region scroll-to) (call Point x y))
    )
