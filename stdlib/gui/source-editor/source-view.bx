      (let stuck (call stuck-row-at point))
      (= row (if-expr stuck (call (. active folds actual) (. stuck row)) (call row-under point)))
      (= on-control (if-expr stuck (call is-stuck-control point (. stuck row)) (!= (call control-at point) null)))
    )
    (return-if (if (and (== row hovered-row) (== on-control is-control-hovered))))
    (blank)
    (= hovered-row row)
    (= is-control-hovered on-control)
    (call invalidate-paint)
