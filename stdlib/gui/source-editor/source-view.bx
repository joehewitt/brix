  (fn-expr _ page-lines Size
    (if-expr (> count 1) (- count 1) 1)
    (where
      (lazy count (as (call floor (/ (- (. region content-bounds height) top-inset) source-row-length)) Size))
    )
  )
  (fn-do _ move-lines _
    (param active SourceSession)
    (param count Size)
    (param upward Bool)
    (let x (call goal-for active))
    (for (in step (..< 0 count))
      (if (not (call step-line active x upward))
        (break)
      )
    )
    (= goal-x x)
    (= goal-place (call SourcePoint (. active row) (. active column)))
  )
  (fn-do _ goal-for Size
    (param active SourceSession)
    (let kept goal-place)
    (return-if goal-x (if (and kept (== (. kept row) (. active row)) (== (. kept column) (. active column)))))
    (return (call (. (call row-wrap active (. active row)) x-of) (. active column)))
  )
  (fn-do _ step-line Bool
    (param active SourceSession)
    (param x Size)
    (param upward Bool)
    (let wrap (call row-wrap active (. active row)))
    (let next (+ (call (. wrap line-of) (. active column)) (if-expr upward -1 1)))
    (if (and (>= next 0) (<= next (. wrap last-line)))
      (call (. active place) (. active row) (call (. wrap column-at) next x) true)
      (return true)
    )
    (let before (. active row))
    (if upward
      (call (. active move-up))
      (else
        (call (. active move-down))
      )
    )
    (return-if false (if (== (. active row) before)))
    (blank)
    (let landed (call row-wrap active (. active row)))
    (call (. active place) (. active row) (call (. landed column-at) (if-expr upward (. landed last-line) 0) x) true)
    (return true)
  )
  (fn-do _ move-to-edge _
    (param active SourceSession)
    (param is-end Bool)
    (let wrap (call row-wrap active (. active row)))
    (let line (call (. wrap line-of) (. active column)))
    (if (and is-end (== line (. wrap last-line)))
      (call (. active move-to-line-end))
      (else-if (and (not is-end) (== line 0))
        (call (. active move-to-line-start))
      )
      (else
        (call (. active place) (. active row) (if-expr is-end (call (. wrap last-column) line) ([] (. wrap starts) line)) true)
      )
    )
  )
  (fn-do _ sync-wrap _
    (param active SourceSession)
    (let stamp (+ (. active revision) (. active document revision) (. active folds version) 1))
    (return-if (if (and (== stamp wrapped-stamp) (== wrap-columns wrapped-columns))))
    (blank)
    (let resized (and (> wrapped-columns 0) (> wrap-columns 0) (!= wrap-columns wrapped-columns)))
    (= wrapped-stamp stamp)
    (= wrapped-columns wrap-columns)
    (let next
      (call (. wrap-cache rows)
        (block
          (arg active)
          (arg wrap-columns)
          (arg source-indent-columns)
          (arg source-row-height)
          (arg source-end-space)
        )
      )
    )
    (if (and (== (. next count) (. wrap-rows count)) (== (. next widest) (. wrap-rows widest)) (== (. next tops) (. wrap-rows tops)))
      (return)
    )
    (let scroll (call max (. region scroll-y) 0))
    (let anchor (call (. wrap-rows display-at) (as (call floor (/ scroll source-row-length)) Size)))
    (let within (- scroll (call row-top anchor)))
    (call (. wrap-rows take) next)
    (= line-count (. wrap-rows line-count))
    (call (. region invalidate-bindings))
    (call (. gutter invalidate-paint))
    (call show-changes)
    (if (and resized (< anchor (. wrap-rows count)))
      (call (. region pin-address) anchor (- top-inset (call min within (- (call row-height anchor) 1))))
    )
  )
  (fn-expr _ wrap-width Size
    (case? (or (not wraps-rows) (<= cell-width 0) (<= room 0))
