  (fn-do _ clear-link _
    (= probed null)
    (if link
      (call set-link null)
    )
  )
  (fn-do _ set-link _
    (param found (? SourceLink))
    (= link found)
    (= has-link (!= found null))
    (call invalidate-paint)
    (if (or (not found) (and (== (. found title length) 0) (== (. found detail length) 0)) (== cell-width 0))
      (call (. link-card dismiss))
      (return)
    )
    (= (. link-card title) (. found title))
    (= (. link-card detail) (. found detail))
    (let rects (call link-rects found))
    (if (!= (. rects length) 0)
      (call (. link-card show) (call (. PopupAnchor rect) (call presentation-rect ([] rects 0))))
    )
  )
  (fn-do _ link-rects (list Rect)
    (param found SourceLink)
    (let active session)
    (return-if (call (of List Rect)) (if (not active)))
    (blank)
    (let content text-bounds)
    (let left (- (+ (. content x) source-text-inset) (. region scroll-x)))
    (let y (- (+ (. content y) (call row-top (call (. active folds shown) (. found row)))) shown-top))
    (return (call span-rects (call row-wrap active (. found row)) (. found start) (. found end) left y))
  )
  (fn-do _ point-at (? SourcePoint)
    (param active SourceSession)
    (param point Point)
    (let x (- (+ (. point x) (. region scroll-x)) source-text-inset gutter-width))
    (return-if null (if (or (< x 0) (<= cell-width 0))))
    (blank)
    (let spot (call spot-under active point))
    (return-if null (if (not spot)))
    (blank)
    (let column (call (. spot wrap column-under) (. spot line) (as (call floor (/ x cell-width)) Size)))
    (let shown (call (. active row-at) (. spot row)))
    (if (or (== column null) (. shown is-divider) (< column (. shown content-start)) (>= column (. shown columns)))
      (return null)
    )
    (return (call SourcePoint (. spot row) column))
  )
  (fn-do _ track _
    (param active SourceSession)
    (= caret-row (. active row))
    (= caret-column (. active column))
    (if insight
      (call invalidate-paint)
    )
    (= row-count (. active row-count))
    (= shown-row-count (call (. active folds row-count)))
    (= has-selection (. active has-selection))
    (if (!= (+ (. active folds version) (. active document revision)) shown-folds)
      (call show-changes)
    )
  )
  (fn-do + show-insight _
    (param found (? SourceInsight))
    (= insight found)
    (if (not found)
      (call (. note-card dismiss))
    )
    (call retire-ink)
    (call invalidate-paint)
  )
  (fn-do _ ink-layout TextLayout
    (param text String)
    (param font Font)
    (if (!= ink-font font)
      (call retire-ink)
      (= ink-font font)
    )
    (let kept ([] ink-layouts text))
    (return-if kept (if kept))
    (blank)
    (let made (call TextLayout (call TextLayoutRequest text font)))
    (= ([] ink-layouts text) made)
    (+= ink-made made)
    (return made)
  )
  (fn-do _ retire-ink _
    (for (in layout ink-retired)
      (call (. layout close))
    )
    (= ink-retired ink-made)
    (= ink-made (call (of List TextLayout)))
    (call (. ink-layouts clear))
  )
  (fn-do _ note-at (? SourceNoteHit)
    (param point Point)
    (let painted (call Point (+ (. point x) (. bounds x)) (+ (. point y) (. bounds y))))
    (for (in hit note-hits)
      (return-if hit (if (call (. hit rect contains) painted)))
    )
    (return null)
  )
  (fn-do _ show-note _
    (param hit SourceNoteHit)
    (= (. note-card text) (. hit text))
    (= (. note-card is-code) (. hit is-code))
    (call (. note-card show) (call (. PopupAnchor rect) (call presentation-rect (. hit rect))))
  )
  (fn-do _ rebase _
    (call note-changes true)
  )
  (fn-do _ inset-changed _
    (call number-rows)
    (call invalidate-paint)
  )
  (fn-do _ wrap-changed _
    (call widen)
    (call number-rows)
    (call invalidate-paint)
  )
  (fn-do _ note-changes _
    (param forced Bool)
    (let active session)
    (let revision (if-expr active (+ (. active revision) (. active document revision) 1) 0))
    (return-if (if (and (not forced) (== revision noted-revision))))
    (blank)
    (= noted-revision revision)
    (+= edit-stamp 1)
    (do-new
      (inline (call mark-changes))
    )
  )
  (fn-do _ mark-changes _
    (return-if (if is-marking))
    (blank)
    (= is-marking true)
    (finally
      (inline (= is-marking false))
    )
    (while (!= marked-stamp edit-stamp)
      (let stamp edit-stamp)
      (let found (call marked-changes))
      (if (== found null)
        (break)
      )
      (if (== stamp edit-stamp)
        (= line-changes found)
        (= marked-stamp stamp)
        (call show-changes)
      )
    )
  )
  (fn-do _ marked-changes (? (list DiffLineChange))
    (let active session)
    (let text baseline)
    (return-if (call (of List DiffLineChange)) (if (or (not active) (== text null))))
    (blank)
    (let old (as text ([] Byte)))
    (let current (as (call (. active view-text)) ([] Byte)))
    (let done (call (of Semaphore (list DiffLineChange))))
    (do-new-thread
      (call (. done post) (call (. (call diff-document old current) line-changes)))
    )
    (return (call (. done await)))
  )
  (fn-do _ show-changes _
    (let active session)
    (= shown-folds (only-if (+ (. active folds version) (. active document revision)) (if active)))
    (if (or (not active) (and (. active folds is-plain) (not (. wrap-rows is-wrapped))))
      (= row-changes line-changes)
      (return)
    )
    (let folds (. active folds))
    (let rows wrap-rows)
    (let made (list DiffLineChange))
    (for (in change line-changes)
      (let top (call (. rows top) (call (. folds shown) (. change line))))
      (if (or (== (. change kind) (. DiffLineChangeKind deleted)) (== (. change count) 0))
        (+= made (call DiffLineChange (. change kind) top (. change count)))
        (else
          (let bottom (call (. folds shown) (- (+ (. change line) (. change count)) 1)))
          (+= made (call DiffLineChange (. change kind) top (- (call (. rows top) (+ bottom 1)) top)))
        )
      )
    )
    (= row-changes made)
