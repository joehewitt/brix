    (default
      (call max (as (call floor (/ room cell-width)) Size) 1)
    )
    (where
      (lazy room (- (. region content-bounds width) source-text-inset box-clearance source-box-indent))
    )
  )
  (fn-expr _ row-wrap SourceWrap
    (param active SourceSession)
    (param row Size)
    (call source-row-wrap (call (. active row-at) row) wrap-columns source-indent-columns)
  )
  (fn-expr _ row-top Length
    (param display Size)
    (* (call (. wrap-rows top) display) source-row-length)
  )
  (fn-expr _ row-height Length
    (param display Size)
    (* (call (. wrap-rows lines) display) source-row-length)
  )
  (fn-expr _ first-shown Size
    (param top Length)
    (if-expr (> top 0) (call (. wrap-rows display-at) (as (call floor (/ top source-row-length)) Size)) 0)
  )
  (fn-expr _ last-shown Size
    (param active SourceSession)
    (param top Length)
    (param height Length)
