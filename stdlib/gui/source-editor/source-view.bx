        (arg (+ (call (. wrap-rows display-at) (as (call ceil (/ (+ top height) source-row-length)) Size)) 1))
      )
    )
  )
  (fn-do _ spot-on SourceSpot
    (param active SourceSession)
    (param lines Size)
    (let display (call (. wrap-rows display-at) lines))
    (let row (call (. active folds actual) display))
    (let wrap (call row-wrap active row))
    (return (call SourceSpot display row (call min (- lines (call (. wrap-rows top) display)) (. wrap last-line)) wrap))
  )
  (fn-do _ spot-under (? SourceSpot)
    (param active SourceSession)
    (param point Point)
    (let y (+ (. point y) shown-top))
    (return-if null (if (< y 0)))
    (blank)
    (let lines (as (call floor (/ y source-row-length)) Size))
    (return-if null (if (>= lines (. wrap-rows line-count))))
    (return (call spot-on active lines))
  )
  (fn-expr _ span-rects (list Rect)
    (param wrap SourceWrap)
    (param start Size)
    (param end Size)
    (param left Length)
    (param y Length)
    (call (of List Rect) (in (call Rect (+ left (* (. each start) cell-width)) (+ y (* (. each line) source-row-length)) (* (- (. each end) (. each start)) cell-width) source-row-length) (call (. wrap segments) start end)))
  )
  (fn-expr _ caret-rect Rect
    (param active SourceSession)
    (call Rect (- x (/ source-caret-width 2)) (+ y 1) source-caret-width (- source-row-length 2))
    (where
      (lazy content text-bounds)
      (lazy left (- (+ (. content x) source-text-inset) (. region scroll-x)))
      (lazy wrap (call row-wrap active (. active row)))
      (lazy line (call (. wrap line-of) (. active column)))
