(import /ui/virtual-layout)
(blank)
(prop + source-row-height VirtualCoord (= 18vcoord))
(prop _ source-end-space VirtualCoord (= 8vcoord))
(prop + source-row-padding Length (= 12))
(blank)
(prop _ source-row-trail Length (= 32))
(prop _ source-pill-inset Length (= 2))
(prop _ source-pill-padding Length (= 7))
(prop _ source-pill-gap Length (= 6))
(prop _ source-caret-width Length (= 2))
(prop _ source-spacer-caret-stroke Length (= 1))
(prop _ source-spacer-caret-radius Length (= 2))
(prop _ source-marker-width Length (= 3))
(prop _ source-gutter-inset Length (= 16))
(prop _ source-gutter-gap Length (= 8))
(prop _ source-control-reach Length (= 8))
(prop _ source-sticky-limit Size (= 5))
(prop _ source-gutter-digits Size (= 3))
(prop + source-text-inset Length (= 24))
(prop _ source-digit-width Length (= 8))
(prop _ source-blink-interval _ (= 530ms))
(prop _ source-add-size Length (= 14))
(prop _ source-add-arm Length (= 8))
(prop _ source-add-stroke Length (= 2))
(prop _ source-add-dot Length (= 2.5))
(prop _ source-add-dot-gap Length (= 5))
(prop _ source-chevron-reach Length (= 3))
(prop _ source-chevron-stroke Length (= 1.5))
(prop _ source-add-caret-gap Length (= 3))

(type + SourcePoint (is (tuple (: row Size) (: column Size))))

(type + SourceLink (is Tuple)
  (prop + row Size)
  (prop + start Size)
  (prop + end Size)
  (prop + title _ (= ""))
  (prop + detail _ (= ""))
  (prop + is-definition _ (= false))
)

(type + SourceEditor (is Box)
  (implements CodeFindTarget)
  (using CodeEditorTheme)
  (using CodeSyntaxStyle)
  (using SourceStructureTheme)
  (prop + session (? SourceSession))
  (prop + is-modified Bool)
  (prop + caret-row Size)
  (prop + caret-column Size)
  (prop + row-count Size)
  (prop + shown-row-count Size)
  (prop + has-selection Bool)
  (prop + stamp U64)
  (prop + baseline (? String))
  (prop + row-changes (list DiffLineChange))
  (prop + source (? (of VirtualSource SourceRow)))
  (prop + row-width (? VirtualCoord))
  (prop + cell-width Length)
  (prop + gutter-width Length)
  (prop + bolds Bool)
  (prop + italics Bool)
  (prop + text-input-context _ (=> (call caret-context)))
  (prop + link (? SourceLink))
  (prop + has-link _ (= false))
  (prop + insight (? SourceInsight))
  (prop + find (? CodeFind))
  (prop + definition-key (? KeyCombo))
  (prop + top-inset Length (= 0))
  (prop + wraps-rows _ (= true))
  (event + modified-changed Bool)
  (event + save-requested SourceSession)
  (event + definition-requested SourcePoint)
  (event + link-probed SourcePoint)
  (blank)
  (prop _ bound-rows (? SourceRowSource))
  (prop _ note-hits (list SourceNoteHit))
  (prop _ ink-layouts (map String TextLayout))
  (prop _ ink-made (list TextLayout))
  (prop _ ink-retired (list TextLayout))
  (prop _ ink-font (? Font))
  (prop _ sticky-rows (? SourceStickyRows))
  (prop _ widest-columns Size)
  (prop _ measured-font (? Font))
  (prop _ is-caret-lit _ (= true))
  (prop _ blinker (? Task))
  (prop _ hover-point (? Point))
  (prop _ hovered-row (? Size))
  (prop + is-control-hovered _ (= false))
  (prop _ probed (? SourcePoint))
  (prop _ context-point (? SourcePoint))
  (prop _ context-link (? SourceLink))
  (prop _ find-cache _ (= (call SourceFindCache)))
  (prop _ line-changes (list DiffLineChange))
  (prop _ noted-revision U64)
  (prop _ edit-stamp U64)
  (prop _ marked-stamp U64)
  (prop _ is-marking _ (= false))
  (prop _ shown-folds (? U64))
  (prop _ wrap-cache _ (= (call SourceWrapCache)))
  (prop _ wrap-rows _ (= (call SourceWrapRows 0 (call (of List Size)) 0 source-row-height source-end-space)))
  (prop _ wrap-columns Size)
  (prop _ wrapped-columns Size)
  (prop _ wrapped-stamp U64)
  (prop _ line-count Size)
  (prop _ goal-x Size)
  (prop _ goal-place (? SourcePoint))
  (blank)
  (depends rebase baseline)
  (depends inset-changed top-inset)
  (depends wrap-changed wraps-rows)
  (blank)
  (rule This (• code-editor-text) (• flex-row)
    (= focus-mode (. FocusMode input))
    (when-style #is-control-hovered
      (= cursor (. CursorStyle pointing-hand))
    )
    (when-style #has-link
      (= cursor (. CursorStyle pointing-hand))
    )
  )
  (content
    (<> This
      (<> SourceGutter (id: gutter)
        (= cursor (. CursorStyle pointing-hand))
        (= min-width (call (. SizeSpec coord) #gutter-width))
        (= max-width (call (. SizeSpec coord) #gutter-width))
        (= changes #row-changes)
      )
      (<> (of VirtualRegion SourceRow) (id: region) (• flex 1)
        (= source #source)
        (= virtual-layout (call source-row-layout #row-width #sticky-rows #wrap-rows))
        (= overscan (call VirtualInsets 100vcoord 0vcoord 100vcoord 0vcoord))
        (= top-inset #top-inset)
        (blank)
        (<> SourceRowBox (slot: row) (param: slot)
          (= row (. slot #item))
          (= address (. slot #address))
          (= bolds #bolds)
          (= italics #italics)
          (= inset source-text-inset)
          (= wrap-columns #wrap-columns)
        )
      )
      (<> CodeOverview (id: overview) (• absolute) (• w code-overview-width)
        (= anchor (. Anchor parent))
        (= top (call (. PositionOffset coord) #top-inset))
        (= right (call (. PositionOffset coord) 0))
        (= bottom (call (. PositionOffset coord) 0))
        (= rows #line-count)
        (= row-length source-row-length)
        (= changes #row-changes)
      )
      (<> CodeLinkCard (id: link-card))
      (<> SourceNoteCard (id: note-card))
      (<> ContextMenu
        (if (!= #context-link null)
          (<> MenuItem (text: "Go to Definition")
            (= key #definition-key)
            (= action (=> () :do (call go-to-context-definition)))
          )
          (<> MenuSeparator)
        )
        (<> MenuItem (text: "Cut")
          (= key cut-key)
          (= is-enabled #has-selection)
          (= action (=> () :do (call cut-from-menu)))
        )
        (<> MenuItem (text: "Copy")
          (= key copy-key)
          (= is-enabled #has-selection)
          (= action (=> () :do (call copy-from-menu)))
        )
        (<> MenuItem (text: "Paste")
          (= key paste-key)
          (= action (=> () :do (call paste-from-menu)))
        )
      )
    )
  )
  (fn-do + show _
    (param shown SourceDocument)
    (call resume (call SourceSession shown))
  )
  (fn-do + resume _
    (param next SourceSession)
    (param scroll _ (= (call Point 0 0)))
    (call clear-link)
    (call (. find-cache reset))
    (call (. wrap-cache reset))
    (= wrapped-stamp 0)
    (= goal-place null)
    (let bound (call SourceRowSource next))
    (= (. bound revision value) (+ (. next revision) (. next document revision) (. next folds version) 1))
    (= session next)
    (= bound-rows bound)
    (= sticky-rows (call SourceStickyRows next))
    (= is-modified (. next is-modified))
    (= widest-columns 0)
    (= row-width null)
    (= source bound)
    (call widen)
    (call (. region restore-scroll) scroll)
    (call number-rows)
    (= (. gutter scrolled) (- (. scroll y) top-inset))
    (call track next)
    (call note-changes true)
    (+= stamp 1)
    (if is-focused
      (call start-blink)
    )
    (call invalidate-paint)
  )
  (fn-do + clear _
    (call stop-blink)
    (call clear-link)
    (= session null)
    (= bound-rows null)
    (= sticky-rows null)
    (= source null)
    (call (. region release-bindings))
    (call (. wrap-cache reset))
    (call (. wrap-rows take) (call SourceWrapRows 0 (call (of List Size)) 0 source-row-height source-end-space))
    (= wrapped-stamp 0)
    (= line-count 0)
    (= goal-place null)
    (= is-modified false)
    (= insight null)
    (call (. note-hits clear))
    (call (. note-card dismiss))
    (= (. gutter numbered) 0)
    (= caret-row 0)
    (= caret-column 0)
    (= row-count 0)
    (= shown-row-count 0)
    (call note-changes true)
    (+= stamp 1)
    (call invalidate-paint)
  )
  (fn-do + jump-to _
    (param row Size)
    (param column Size)
    (let active session)
    (return-if (if (not active)))
    (blank)
    (call (. active place) row column)
    (call refresh)
    (call (. region scroll-to-address) (call (. active folds shown) (. active row)) (. ScrollAlignment center))
  )
  (fn-do + show-link _
    (param probe SourcePoint)
    (param found (? SourceLink))
    (let pressed context-point)
    (if (and pressed (== (. pressed row) (. probe row)) (== (. pressed column) (. probe column)) found-definition)
      (= context-link found)
    )
    (lazy found-definition (?? (?. found is-definition) false))
    (let last probed)
    (return-if (if (or (not last) (!= (. last row) (. probe row)) (!= (. last column) (. probe column)))))
    (blank)
    (call set-link found)
  )
  (fn-expr + text-scroll Point :get
    (call Point (. region scroll-x) (. region scroll-y))
  )
  (fn-do + fold _
    (let active session)
    (return-if (if (not active)))
    (blank)
    (call (. active fold))
    (call refresh)
  )
  (fn-do + unfold _
    (let active session)
    (return-if (if (not active)))
    (blank)
    (call (. active unfold))
    (call refresh)
  )
  (fn-do + fold-all _
    (let active session)
    (return-if (if (not active)))
    (blank)
    (call (. active fold-all))
    (call refresh)
  )
  (fn-do + unfold-all _
    (let active session)
    (return-if (if (not active)))
    (blank)
    (call (. active unfold-all))
    (call refresh)
  )
  (fn-do + place-caret _
    (param point Point)
    (param extends _ (= false))
    (let active session)
    (return-if (if (or (not active) (== (. wrap-rows line-count) 0))))
    (blank)
    (let x (- (+ (. point x) (. region scroll-x)) source-text-inset gutter-width))
    (let y (+ (. point y) shown-top))
    (let cell (if-expr (and (> x 0) (> cell-width 0)) (as (call round (/ x cell-width)) Size) 0))
    (let lines (if-expr (> y 0) (as (call floor (/ y source-row-length)) Size) 0))
    (let spot (call spot-on active (call min lines (- (. wrap-rows line-count) 1))))
    (= goal-place null)
    (call (. active place) (call (. active stop-at) (. spot row) false) (call (. spot wrap column-at) (. spot line) cell) extends)
    (call refresh)
  )
  (fn-do + type _
    (param text String)
    (param replaces-before Size (= 0))
    (param replaces-length Size (= 0))
    (let active session)
    (return-if (if (not active)))
    (blank)
    (= goal-place null)
    (if (and (> replaces-before 0) (not (. active has-selection)))
      (let start (- (. active column) replaces-before))
      (call (. active select-range) (. active row) start (+ start replaces-length))
    )
    (call (. active insert) text)
    (call refresh)
  )
  (fn-do + perform _
    (param command TextCommand)
    (param extends _ (= false))
    (let active session)
    (return-if (if (not active)))
    (blank)
    (let keeps extends)
    (match command
      (case .move-backward
        (call (. active move-left))
      )
      (case .move-forward
        (call (. active move-right))
      )
      (case .move-word-backward
        (call (. active move-token-left))
      )
      (case .move-word-forward
        (call (. active move-token-right))
      )
      (case .move-up
        (call move-lines active 1 true)
      )
      (case .move-down
        (call move-lines active 1 false)
      )
      (case .move-to-line-start
        (call move-to-edge active false)
      )
      (case .move-to-line-end
        (call move-to-edge active true)
      )
      (case .move-to-paragraph-start
        (call (. active move-to-line-start))
      )
      (case .move-to-paragraph-end
        (call (. active move-to-line-end))
      )
      (case .move-to-start
        (call (. active move-to-start))
      )
      (case .move-to-end
        (call (. active move-to-end))
      )
      (case .page-up
        (call move-lines active (call page-lines) true)
      )
      (case .page-down
        (call move-lines active (call page-lines) false)
      )
      (case .delete-backward
        (call (. active delete-backward))
      )
      (case .delete-forward
        (call (. active delete-forward))
      )
      (case .delete-word-backward
        (call (. active delete-token-backward))
      )
      (case .delete-to-line-start
        (call (. active delete-to-line-start))
      )
      (case .delete-to-line-end
        (call (. active delete-to-line-end))
      )
      (case .delete-to-paragraph-end
        (call (. active delete-to-line-end))
      )
      (case .insert-newline
        (call (. active split))
      )
      (case .insert-line-break
        (call (. active split))
      )
      (case .insert-tab
        (call (. active indent))
      )
      (case .insert-backtab
        (call (. active outdent))
      )
      (case .select-all
        (call (. active select-all))
        (= keeps true)
      )
      (case .cancel
        (call (. active revert))
      )
      (default
        (return)
      )
    )
    (if (not (call is-vertical command))
      (= goal-place null)
    )
    (if (not keeps)
      (call (. active collapse))
    )
    (call refresh)
  )
  (fn-expr _ is-vertical Bool
    (param command TextCommand)
    (match command
      (case .move-up
        true
      )
      (case .move-down
        true
      )
      (case .page-up
        true
      )
      (case .page-down
        true
      )
      (default
        false
      )
    )
  )
  (fn-do + press Bool
    (param characters String)
    (param shift Bool)
    (let active session)
    (return-if false (if (not active)))
    (blank)
    (if (and (== characters "z") (not shift))
      (call (. active undo))
      (else-if (or (== characters "z") (== characters "Z") (== characters "y"))
        (call (. active redo))
      )
      (else-if (== characters "a")
        (call (. active select-all))
      )
      (else-if (== characters "s")
        (<- save-requested active)
      )
      (else-if (== characters "/")
        (let ignored (call (. active toggle-comment)))
      )
      (else
        (return false)
      )
    )
    (call refresh)
    (return true)
  )
  (fn-do _ copy-selection Bool
    (param clipboard Clipboard)
    (let active session)
    (return-if false (if (or (not active) (not (. active has-selection)))))
    (return (call (. clipboard write-text) (call (. active clipboard-text))))
  )
  (subscribe-for (on event pointer-down)
    (let stuck (call stuck-row-at (. event point)))
    (let folded (call chip-at (. event point)))
    (let control (call control-at (. event point)))
    (let noted (only-if (call note-at (. event point)) (if (== (. event button) (. PointerButton primary)))))
    (if noted
      (call show-note noted)
      (else-if (or (== (. event button) (. PointerButton secondary)) is-control-click)
        (call press-context (. event point))
      )
      (else-if (and stuck (== (. event button) (. PointerButton primary)) (call is-stuck-control (. event point) (. stuck row)))
        (call request-focus)
        (call (. (!! session) toggle-fold) (call (. (!! session) folds actual) (. stuck row)))
        (call refresh)
      )
      (else-if (and stuck (== (. event button) (. PointerButton primary)))
        (call request-focus)
        (call place-stuck (. event point) stuck)
      )
      (else-if (and (!= folded null) (== (. event button) (. PointerButton primary)))
        (call request-focus)
        (call (. (!! session) toggle-fold) folded)
        (call refresh)
      )
      (else-if (and (!= control null) (== (. event button) (. PointerButton primary)))
        (call request-focus)
        (call press-control (?? control 0))
      )
      (else-if (== (. event button) (. PointerButton primary))
        (call request-focus)
        (call place-caret (. event point) (. event modifiers shift))
        (if (== (. event click-count) 2)
          (call (?. session select-token))
          (call refresh)
        )
        (let active session)
        (if (and active (== (. event click-count) 1) (. event modifiers command))
          (<- definition-requested (call SourcePoint (. active row) (. active column)))
        )
      )
    )
    (lazy is-control-click (and (== (. event button) (. PointerButton primary)) (. event modifiers control)))
  )
  (fn-do _ place-stuck _
    (param point Point)
    (param stuck SourceStuckRow)
    (let active session)
    (return-if (if (not active)))
    (blank)
    (let row (call (. active folds actual) (. stuck row)))
    (let wrap (call row-wrap active row))
    (let x (- (+ (. point x) (. region scroll-x)) source-text-inset gutter-width))
    (let cell (if-expr (and (> x 0) (> cell-width 0)) (as (call floor (/ x cell-width)) Size) 0))
    (let below (- (. point y) (. stuck y)))
    (let line (if-expr (> below 0) (call min (as (call floor (/ below source-row-length)) Size) (. wrap last-line)) 0))
    (call (. active place) row (call (. wrap column-at) line cell))
    (call refresh)
  )
  (fn-do _ cut-selection Bool
    (param clipboard Clipboard)
    (let active session)
    (return-if false (if (or (not active) (not (call copy-selection clipboard)))))
    (blank)
    (call (. active delete-selection))
    (call refresh)
    (return true)
  )
  (fn-do _ paste-text Bool
    (param clipboard Clipboard)
    (let active session)
    (let pasted (call (. clipboard read-text)))
    (return-if false (if (or (not active) (not pasted))))
    (blank)
    (call (. active paste) pasted)
    (call refresh)
    (return true)
  )
  (fn-do _ cut-from-menu _
    (let ignored (call cut-selection (call Clipboard)))
  )
  (fn-do _ copy-from-menu _
    (let ignored (call copy-selection (call Clipboard)))
  )
  (fn-do _ paste-from-menu _
    (let ignored (call paste-text (call Clipboard)))
  )
  (fn-do _ press-context _
    (param point Point)
    (call request-focus)
    (= context-point null)
    (= context-link null)
    (let active session)
    (return-if (if (not active)))
    (blank)
    (let found (call point-at active point))
    (if (or (== found null) (not (call source-selection-contains active found)))
      (call place-caret point)
    )
    (return-if (if (== found null)))
    (blank)
    (= context-point found)
    (<- link-probed found)
  )
  (fn-do _ go-to-context-definition _
    (let active session)
    (let pressed context-point)
    (return-if (if (or (not active) (not pressed))))
    (blank)
    (call (. active place) (. pressed row) (. pressed column))
    (call refresh)
    (<- definition-requested pressed)
  )
  (subscribe-for (on change (. overview chose))
    (call request-focus)
    (let display (call (. wrap-rows display-at) (. change line)))
    (call jump-to (?? (call (. (?. session folds) actual) display) display) 0)
  )
  (subscribe-for (on target (. gutter added))
    (call request-focus)
    (call add-at target)
  )
  (subscribe-for (on target (. gutter toggled))
    (let active session)
    (if active
      (call (. active toggle-fold) target)
      (call refresh)
    )
  )
  (subscribe-for (on event pointer-move)
    (= hover-point (. event point))
    (call probe (. event modifiers command))
    (call track-hover (. event point))
  )
  (subscribe-for (on event modifiers-changed)
    (= hover-point (. event point))
    (call probe (. event modifiers command))
  )
  (whenever-rule #is-hover-within
    (if (not is-hover-within)
      (= hover-point null)
      (call clear-link)
      (call track-hover null)
    )
  )
  (subscribe-for (on event pointer-drag)
    (call place-caret (. event point) true)
  )
  (subscribe-for (on event key-press)
    (let modifiers (. event modifiers))
    (if (and (== (. event key) (. Key tab)) (not (. modifiers command)) (not (. modifiers control)) (not (. modifiers option)))
      (call perform (if-expr (. modifiers shift) (. TextCommand insert-backtab) (. TextCommand insert-tab)))
      (call (. event cancel))
      (else-if (and (or (== (. event key) (. Key home)) (== (. event key) (. Key end))) (not (. modifiers command)) (not (. modifiers control)) (not (. modifiers option)))
        (call perform (if-expr (== (. event key) (. Key home)) (. TextCommand move-to-line-start) (. TextCommand move-to-line-end)) (. modifiers shift))
        (call (. event cancel))
      )
      (else-if (and (. modifiers command) (not (. modifiers control)) (not (. modifiers option)))
        (if (call press (. event characters) (. modifiers shift))
          (call (. event cancel))
        )
      )
    )
  )
  (subscribe-for (on event key-input)
    (call type (. event text) (. event replaces-before) (. event replaces-length))
  )
  (subscribe-for (on event text-command)
    (call perform (. event command) (. event extends-selection))
  )
  (subscribe-for (on event copy)
    (if (call copy-selection (. event clipboard))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event cut)
    (if (call cut-selection (. event clipboard))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event paste)
    (if (call paste-text (. event clipboard))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event focus)
    (call start-blink)
    (call invalidate-paint)
  )
  (subscribe-for (on event blur)
    (call stop-blink)
    (call (?. session commit))
    (call refresh)
  )
  (subscribe-for (on event (. region scroll-changed) (when arrival))
    (call clear-link)
    (call widen)
    (call number-rows)
    (call invalidate-paint)
  )
  (fn-do _ refresh _
    (let active session)
    (let bound bound-rows)
    (return-if (if (or (not active) (not bound))))
    (blank)
    (call (. active folds reveal) (. active row))
    (let revision (+ (. active revision) (. active document revision) (. active folds version) 1))
    (if (!= (. bound revision value) revision)
      (call (. bound resize))
      (= (. bound revision value) revision)
      (call clear-link)
    )
    (let modified (. active is-modified))
    (if (!= modified is-modified)
      (= is-modified modified)
      (<- modified-changed modified)
    )
    (call track active)
    (call note-changes false)
    (+= stamp 1)
    (call widen)
    (call number-rows)
    (call reveal-caret active)
    (if is-focused
      (call start-blink)
    )
    (call invalidate-paint)
  )
  (fn-do _ probe _
    (param is-command Bool)
    (let active session)
    (let point hover-point)
    (if (or (not is-command) (not active) (not point))
      (call clear-link)
      (return)
    )
    (let found (call point-at active point))
    (if (not found)
      (call clear-link)
      (return)
    )
    (let current link)
    (return-if (if (and current (== (. found row) (. current row)) (>= (. found column) (. current start)) (< (. found column) (. current end)))))
    (blank)
    (let last probed)
    (return-if (if (and last (== (. last row) (. found row)) (== (. last column) (. found column)))))
    (blank)
    (= probed found)
    (if current
      (call set-link null)
    )
    (<- link-probed found)
