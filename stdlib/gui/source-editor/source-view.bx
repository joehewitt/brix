    )
  )
  (fn-expr _ text-bounds Rect :get
    (call Rect (+ (. content x) gutter-width) (. content y) (- (. content width) gutter-width) (. content height))
    (where
      (lazy content content-bounds)
    )
  )
  (fn-expr _ shown-top Length :get
    (- (. region scroll-y) top-inset)
  )
  (fn-do _ number-rows _
    (let active session)
    (return-if (if (not active)))
    (blank)
    (let count (- (. active row-count) 1))
    (let digits source-gutter-digits)
    (let limit Size 1000)
    (while (>= count limit)
      (+= digits 1)
      (*= limit 10)
    )
    (let digit (if-expr (> cell-width 0) (call ceil cell-width) source-digit-width))
    (= gutter-width (+ source-gutter-inset (* digits digit) source-gutter-gap))
    (= (. gutter gap) source-gutter-gap)
    (= (. gutter folds) (. active folds))
    (= (. gutter session) active)
    (= (. gutter version) (+ (. active folds version) (. active document revision)))
    (= (. gutter numbered) (- (call (. active folds row-count)) 1))
    (= (. gutter caret-row) (call (. active folds shown) (. active row)))
    (= (. gutter head-lit) (and (not (. active has-selection)) (call (. active is-block-head) (. active row)) (<= (. active column) (. (call (. active row-at) (. active row)) content-start))))
    (= (. gutter scrolled) shown-top)
    (= (. gutter rows) wrap-rows)
    (= (. gutter covered) (call source-stuck-height (call stuck-rows)))
  )
  (fn-do _ widen _
    (let active session)
    (return-if (if (not active)))
    (blank)
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (if (!= font measured-font)
      (= measured-font font)
      (= cell-width (call code-cell-width font))
      (= bolds (== (call code-cell-width (call Font $font-family $font-size (. FontWeight bold) $font-slant)) cell-width))
      (= italics (== (call code-cell-width (call Font $font-family $font-size $font-weight (. FontSlant italic))) cell-width))
      (= row-width null)
    )
    (= wrap-columns (call wrap-width))
    (call sync-wrap active)
    (let widest
      (block
        (case? (> wrap-columns 0)
          (. wrap-rows widest)
        )
        (default
          (call max (. active document widest-columns) widest-columns)
        )
      )
    )
    (if (and (. active is-dirty) (== wrap-columns 0))
      (= widest (call max widest (. (call (. active row-at) (. active row)) columns)))
    )
    (let width
      (scope (as (call ceil (call max text-width (. region content-bounds width))) I64)
        (lazy text-width (+ (* widest cell-width) source-text-inset source-row-trail))
      )
    )
    (return-if (if (and (== widest widest-columns) (== row-width width))))
    (blank)
    (= widest-columns widest)
    (= row-width width)
  )
  (fn-expr + find-stamp U64
    (if-expr active (+ (. active revision) (. active document revision) 1) 0)
    (where
      (lazy active session)
    )
  )
  (fn-do + find-rows (list CodeFindRow)
    (param editing Bool)
    (let active session)
    (return-if (call (of List CodeFindRow)) (if (not active)))
    (blank)
    (if editing
      (call (. active commit))
    )
    (return (call (. find-cache rows) active))
  )
  (fn-expr + find-caret CodeFindPlace
    (if-expr active (call CodeFindPlace (. active row) (. active column)) (call CodeFindPlace 0 0))
    (where
      (lazy active session)
    )
  )
  (fn-expr + find-origin CodeFindPlace
    (if-expr active (call CodeFindPlace (. active first-selected-row) (. active selection-start)) first-place)
    (where
      (lazy active session)
      (lazy first-place (call CodeFindPlace 0 0))
    )
  )
  (fn-expr + find-selection (? CodeHit)
    (case? (or (not active) (not (. active has-selection)) (!= (. active first-selected-row) (. active last-selected-row)))
      null
    )
    (default
      (call CodeHit (. active first-selected-row) (. active selection-start) (. active selection-end))
    )
    (where
      (lazy active session)
    )
  )
  (fn-expr + find-seed (? String)
    (case? (or (== (call find-selection) null) (== (. text length) 0))
      null
    )
    (default
      text
    )
    (where
      (lazy text (call (. (!! session) selected-text)))
    )
  )
  (fn-do + find-reveal _
    (param hit CodeHit)
    (let active session)
    (return-if (if (not active)))
    (blank)
    (call (. active select-range) (. hit row) (. hit start) (. hit end))
    (call refresh)
  )
  (fn-do + find-replace Bool
    (param hit CodeHit)
    (param text String)
    (let active session)
    (return-if false (if (or (not active) (not (call (. active can-edit) (. hit row))))))
    (blank)
    (call (. active select-range) (. hit row) (. hit start) (. hit end))
    (let done (if-expr (> (. text length) 0) (call (. active insert) text) (call (. active delete-selection))))
    (call refresh)
    (return done)
  )
  (fn-expr + find-can-edit Bool
    (param row Size)
    (?? (call (?. session can-edit) row) false)
  )
  (fn-do + find-rewrite CodeRewrite
    (param rows (list Size))
    (param texts (list String))
    (let active session)
    (return-if (call CodeRewrite 0 0) (if (not active)))
    (blank)
    (let outcome (call (. active replace-rows) rows texts))
    (call refresh)
    (return (call CodeRewrite (. outcome changed) (. outcome held)))
  )
  (fn-do + find-show _
    (param model (? CodeFind))
    (= find model)
    (call invalidate-paint)
  )
  (fn-do + find-focus _
    (call request-focus)
  )
  (fn-do + close _
    (call stop-blink)
    (call retire-ink)
    (call retire-ink)
    (call (. super close))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (= (. overview clearance) (+ (. region $scroll-indicator-thickness) (. region $scroll-indicator-inset)))
    (call widen)
    (call number-rows)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let whole content-bounds)
    (= (. canvas fill-color) $gui-editor-background-color)
    (call (. canvas rect) whole)
    (let active session)
    (return-if (if (or (not active) (== (. active row-count) 0))))
    (blank)
    (let content text-bounds)
    (let top shown-top)
    (let folds (. active folds))
    (let first (call first-shown top))
    (let last (call last-shown active top (. content height)))
    (let selects (. active has-selection))
    (let first-selected (. active first-selected-row))
    (let last-selected (. active last-selected-row))
    (let left (- (+ (. content x) source-text-inset) (. region scroll-x)))
    (let finder find)
    (let hits (if-expr finder (. finder found) (call (of List CodeHit))))
    (let next-hit (if-expr finder (call (. finder first-at) (call (. folds actual) first)) 0))
    (let focus-hit (only-if (. finder current) (if finder)))
    (let right (call box-right content))
    (let rule-end (call min (. content right) (- right source-box-indent)))
    (let scan (call SourceSliceScan active))
    (let slices (list SourceSlice))
    (for (in index (..< first last))
      (+= slices (call (. scan slice) index (call row-height index)))
    )
    (call paint-surfaces canvas slices content first left right)
    (let known insight)
    (if known
      (call paint-unknown canvas active known slices content first left right)
    )
    (do-use (. canvas saved-state)
      (call (. canvas clip) whole)
      (for (in index (..< first last))
        (let row (call (. folds actual) index))
        (let shown (call (. active row-at) row))
        (let held (. shown is-invalid))
        (let is-typed (and (. active is-dirty) (== row (. active row))))
        (let is-tinted (and held (not is-typed)))
        (let is-current (and (== row (. active row)) (not selects) (call (. active can-edit) row)))
        (let y (- (+ (. whole y) (call row-top index)) top))
        (let height (call row-height index))
        (if (or is-tinted is-current)
          (let band (call Rect (. whole x) y (. whole width) height))
          (let shape
            (call source-slice-shape
              (block
                (arg ([] slices (- index first)))
                (arg (call Rect (. content x) y (. content width) height))
                (arg (- left source-box-indent))
                (arg right)
              )
            )
          )
          (do-use (. canvas saved-state)
            (call (. canvas clip) band)
            (if shape
              (call (. canvas clip-outline) shape)
            )
            (= (. canvas stroke-color) null)
            (= (. canvas fill-color) (if-expr is-tinted $source-held-band-color $source-band-color))
            (call (. canvas rect) band)
          )
        )
      )
    )
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (for (in index (..< first last))
        (let row (call (. folds actual) index))
        (let shown (call (. active row-at) row))
        (let wrap (call source-row-wrap shown wrap-columns source-indent-columns))
        (let y (- (+ (. content y) (call row-top index)) top))
        (if (and known (not (and (. active is-dirty) (== row (. active row)))))
          (call paint-washes
            (block
              (arg canvas)
              (arg known)
              (arg shown)
              (arg wrap)
              (arg left)
              (arg y)
              (arg (call (. folds is-folded) row))
              (arg (call lit-for active shown))
            )
          )
        )
        (if (call (. folds is-folded) row)
          (let x (+ left (* (call (. wrap end-x) (. wrap last-line)) cell-width) code-chip-gap))
          (call code-fold-chip
            (block
              (arg canvas)
              (arg x)
              (arg (+ y (* (. wrap last-line) source-row-length)))
              (arg source-row-length)
              (arg $gui-editor-fold-chip-color)
              (arg $gui-editor-line-number-color)
            )
          )
        )
        (if (call (. active is-open-end) row)
          (call paint-add-button
            (block
              (arg canvas)
              (arg (call adder-left left))
              (arg y)
              (arg (and (== row (. active row)) (not selects)))
              (arg (== (. ([] slices (- index first)) kind) (. SourceRowBlock text)))
            )
          )
          (else-if (== (. shown divider) source-divider-double)
            (call paint-source-double-rule
              (block
                (arg canvas)
                (arg (call max (. content x) left))
                (arg rule-end)
                (arg y)
                (arg $source-thin-divider-color)
              )
            )
          )
        )
        (while (and (< next-hit (. hits length)) (< (. ([] hits next-hit) row) row))
          (+= next-hit 1)
        )
        (while (and (< next-hit (. hits length)) (== (. ([] hits next-hit) row) row))
          (if (!= next-hit focus-hit)
            (= (. canvas fill-color) $gui-editor-find-color)
            (for (in rect (call span-rects wrap (. ([] hits next-hit) start) (. ([] hits next-hit) end) left y))
              (call (. canvas rect) rect)
            )
          )
          (+= next-hit 1)
        )
        (if (and selects (>= row first-selected) (<= row last-selected))
          (let low (if-expr (== row first-selected) (. active selection-start) 0))
          (let high (if-expr (== row last-selected) (. active selection-end) (+ (. shown columns) 1)))
          (= (. canvas fill-color) (if-expr is-focused $gui-editor-selection-color $gui-editor-idle-selection-color))
          (for (in rect (call span-rects wrap low high left y))
            (call (. canvas rect) rect)
          )
        )
      )
      (let focused (only-if (. finder current-found) (if finder)))
      (if (and focused (not (call (. folds is-hidden) (. focused row))))
        (let display (call (. folds shown) (. focused row)))
        (if (and (>= display first) (< display last))
          (let y (- (+ (. content y) (call row-top display)) top))
          (= (. canvas fill-color) $gui-editor-find-current-color)
          (for (in rect (call span-rects (call row-wrap active (. focused row)) (. focused start) (. focused end) left y))
            (call (. canvas rect) rect)
          )
        )
      )
    )
  )
  (fn-do _ paint-unknown _
    (param canvas Canvas)
    (param active SourceSession)
    (param known SourceInsight)
    (param slices (list SourceSlice))
    (param content Rect)
    (param first Size)
    (param left Length)
    (param right Length)
    (return-if (if (== (. known unknown length) 0)))
    (blank)
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (for (in offset (..< 0 (. slices length)))
        (let row (call (. active folds actual) (+ first offset)))
        (if (call (. known is-unknown) (call (. active row-at) row))
          (let y (- (+ (. content y) (call row-top (+ first offset))) shown-top))
          (let band (call Rect (. content x) y (. content width) (call row-height (+ first offset))))
          (let shape (call source-slice-shape ([] slices offset) band (- left source-box-indent) right))
          (if shape
            (call paint-source-hatch canvas shape band $source-unknown-color)
          )
        )
      )
    )
  )
  (fn-do _ paint-washes _
    (param canvas Canvas)
    (param known SourceInsight)
    (param shown SourceRow)
    (param wrap SourceWrap)
    (param left Length)
    (param y Length)
    (param is-folded Bool)
    (param lit (list String))
    (let marks (call (. known marks-of) shown))
    (for (in mark marks)
      (if (== (. mark kind) (. SourceMarkKind wait))
        (call paint-mark canvas mark wrap left y $source-wait-color)
      )
    )
    (let last-y (+ y (* (. wrap last-line) source-row-length)))
    (let end (+ left (* (call (. wrap end-x) (. wrap last-line)) cell-width) (if-expr is-folded (+ code-chip-gap code-chip-width) 0) cell-width))
    (let fill (call (. known fill-of) shown))
    (if fill
      (= end (call paint-fill canvas fill lit end last-y))
    )
    (+= end cell-width)
    (for (in mark marks)
      (let caption (. mark caption))
      (if caption
        (call paint-caption canvas caption end last-y)
        (return)
      )
    )
  )
  (fn-do _ paint-mark _
    (param canvas Canvas)
    (param mark SourceMark)
    (param wrap SourceWrap)
    (param left Length)
    (param y Length)
    (param color RGBA)
    (for (in part (call (. wrap segments) (. mark start) (. mark end)))
      (let piece (call SourceMark (. part start) (. part end) (. mark kind) (. mark detail) (. mark caption) (. mark errors)))
      (call paint-source-underline
        (block
          (arg canvas)
          (arg piece)
          (arg left)
          (arg (+ y (* (. part line) source-row-length)))
          (arg cell-width)
          (arg source-row-length)
          (arg color)
        )
      )
    )
  )
  (fn-do _ lit-for (list String)
    (param active SourceSession)
    (param shown SourceRow)
    (let known insight)
    (let none (list String))
    (return-if none (if (or (not known) (. active is-dirty) (. active has-selection) (>= (. active row) (. active row-count)))))
    (blank)
    (let at (call (. active row-at) (. active row)))
    (return-if none (if (!= (. at owner-id) (. shown owner-id))))
    (return (call (. known errors-at) at (. active column)))
  )
  (fn-do _ paint-fill Length
    (param canvas Canvas)
    (param fill SourceFill)
    (param lit (list String))
    (param left Length)
    (param y Length)
    (let column Size 0)
    (if (!= (. fill type length) 0)
      (call paint-ink canvas (. fill type) left y $source-inferred-color)
      (+= column (+ (. fill type length) 1))
    )
    (if (!= (. fill errors length) 0)
      (call paint-ink canvas "?!" (+ left (* column cell-width)) y $source-inferred-color)
      (+= column 3)
      (for (in position (..< 0 (. fill errors length)))
        (let name ([] (. fill errors) position))
        (if (!= position 0)
          (call paint-ink canvas "|" (+ left (* column cell-width)) y $source-inferred-color)
          (+= column 2)
        )
        (let color
          (block
            (case? (!= (call (. lit find) name) null)
              $source-inferred-lit-color
            )
            (default
              $source-inferred-color
            )
          )
        )
        (call paint-ink canvas name (+ left (* column cell-width)) y color)
        (+= column (+ (. name length) 1))
      )
    )
    (return (+ left (* column cell-width)))
  )
  (fn-do _ paint-marks _
    (param canvas Canvas)
    (param active SourceSession)
    (param open Rect)
    (let known insight)
    (return-if (if (or (not known) (== (. known marks length) 0) (== cell-width 0))))
    (blank)
    (let text text-bounds)
    (let top shown-top)
    (let folds (. active folds))
    (let first (call first-shown top))
    (let last (call last-shown active top (. text height)))
    (let left (- (+ (. text x) source-text-inset) (. region scroll-x)))
    (do-use (. canvas saved-state)
      (call (. canvas clip) open)
      (for (in index (..< first last))
        (let row (call (. folds actual) index))
        (if (not (and (. active is-dirty) (== row (. active row))))
          (let y (- (+ (. text y) (call row-top index)) top))
          (let shown (call (. active row-at) row))
          (let wrap (call source-row-wrap shown wrap-columns source-indent-columns))
          (for (in mark (call (. known marks-of) shown))
            (if (!= (. mark kind) (. SourceMarkKind wait))
              (let color (if-expr (== (. mark kind) (. SourceMarkKind raise)) $source-raise-color $source-convert-color))
              (call paint-mark canvas mark wrap left y color)
            )
          )
        )
      )
    )
  )
  (fn-do + paint-stuck-surface _
    (param canvas Canvas)
    (param band Rect)
    (param address I64)
    (param inset Length)
    (let active session)
    (return-if (if (or (not active) (< address 0) (>= address (as (call (. active folds row-count)) I64)))))
    (blank)
    (let scan (call SourceSliceScan active))
    (let left (- (+ (. band x) inset) source-box-indent))
    (call paint-source-slice
      (block
        (arg canvas)
        (arg (call (. scan slice) (as address Size) (. band height)))
        (arg band)
        (arg left)
        (arg (- (. band right) box-clearance))
        (arg (call source-surface-palette this))
      )
    )
    (let known insight)
    (let row (call (. active folds actual) (as address Size)))
    (if (and known (not (and (. active is-dirty) (== row (. active row)))))
      (let shown (call (. active row-at) row))
      (let wrap (call source-row-wrap shown wrap-columns source-indent-columns))
      (call paint-washes
        (block
          (arg canvas)
          (arg known)
          (arg shown)
          (arg wrap)
          (arg (+ (. band x) inset))
          (arg (. band y))
          (arg (call (. active folds is-folded) row))
          (arg (call lit-for active shown))
        )
      )
    )
  )
  (fn-do _ paint-surfaces _
    (param canvas Canvas)
    (param slices (list SourceSlice))
    (param content Rect)
    (param first Size)
    (param left Length)
    (param right Length)
    (let palette (call source-surface-palette this))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (for (in offset (..< 0 (. slices length)))
        (let y (- (+ (. content y) (call row-top (+ first offset))) shown-top))
        (let band (call Rect (. content x) y (. content width) (call row-height (+ first offset))))
        (call paint-source-slice canvas ([] slices offset) band (- left source-box-indent) right palette)
      )
    )
  )
  (fn-expr _ box-right Length
    (param content Rect)
    (- (+ (. content x) width) (. region scroll-x) box-clearance)
    (where
      (lazy width (if-expr row-width (as (as row-width I64) Length) (. content width)))
    )
  )
  (fn-expr _ box-clearance Length :get
    (+ code-overview-width source-box-margin)
  )
  (fn-do _ paint-notes _
    (param canvas Canvas)
    (param active SourceSession)
    (param open Rect)
    (call (. note-hits clear))
    (let known insight)
    (return-if (if (or (not known) (== cell-width 0))))
    (blank)
    (let text text-bounds)
    (let top shown-top)
    (let folds (. active folds))
    (let first (call first-shown top))
    (let last (call last-shown active top (. text height)))
    (let left (- (+ (. text x) source-text-inset) (. region scroll-x)))
    (let right (- (call min (. text right) (- (call box-right text) source-box-indent)) cell-width))
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (do-use (. canvas saved-state)
      (call (. canvas clip) open)
      (for (in index (..< first last))
        (let row (call (. folds actual) index))
        (if (not (and (. active is-dirty) (== row (. active row))))
          (let shown (call (. active row-at) row))
          (let wrap (call source-row-wrap shown wrap-columns source-indent-columns))
          (let y (- (+ (. text y) (call row-top index) (* (. wrap last-line) source-row-length)) top))
          (let pills (list SourcePill))
          (if (and (== row (. active row)) (not (. active has-selection)))
            (let message (call (. known message-at) shown (. active column)))
            (if message
              (+= pills (call SourcePill (. message kind) (. message text) false))
            )
          )
          (for (in note (call (. known notes-of) shown))
            (+= pills (call SourcePill (. note label) (. note text) true))
          )
          (if (!= (. pills length) 0)
            (let total (call pills-width pills font))
            (let start (+ left (* (+ (call (. wrap end-x) (. wrap last-line)) (call written-columns known shown (call (. folds is-folded) row)) 2) cell-width)))
            (let x (call max start (- right total)))
            (for (in pill pills)
              (let drawn (call paint-pill canvas (. pill label) x y font))
              (let seen (call (. drawn intersection) open))
              (if (not (. seen is-empty))
                (+= note-hits (call SourceNoteHit seen (. pill text) (. pill is-code)))
              )
              (= x (+ (. drawn right) source-pill-gap))
            )
          )
        )
      )
    )
  )
  (fn-do _ pills-width Length
    (param pills (list SourcePill))
    (param font Font)
    (let total Length 0)
    (for (in pill pills)
      (+= total (+ (. (call ink-layout (. pill label) font) width) (* source-pill-padding 2)))
    )
    (return (+ total (* source-pill-gap (- (. pills length) 1))))
  )
  (fn-do _ written-columns Size
    (param known SourceInsight)
    (param shown SourceRow)
    (param is-folded Bool)
    (let columns Size
      (block
        (case? is-folded
          (as (call ceil (/ (+ code-chip-gap code-chip-width) cell-width)) Size)
        )
        (default
          0
        )
      )
    )
    (let fill (call (. known fill-of) shown))
    (if fill
      (+= columns (+ (. fill type length) 1))
      (if (!= (. fill errors length) 0)
        (+= columns (+ 3 (. (call (. " | " join) (. fill errors)) length) 1))
      )
    )
    (for (in mark (call (. known marks-of) shown))
      (let caption (. mark caption))
      (if caption
        (+= columns (+ (. caption length) 2))
      )
    )
    (return columns)
  )
  (fn-do _ paint-pill Rect
    (param canvas Canvas)
    (param label String)
    (param x Length)
    (param y Length)
    (param font Font)
    (let layout (call ink-layout label font))
    (let height (- source-row-length (* source-pill-inset 2)))
    (let width (+ (. layout width) (* source-pill-padding 2)))
    (let rect (call Rect x (+ y source-pill-inset) width height))
    (= (. canvas fill-color) $source-pill-color)
    (= (. canvas stroke-color) $source-pill-border-color)
    (= (. canvas stroke-width) 1)
    (call (. canvas outline) (call Outline rect (/ height 2)))
    (= (. canvas stroke-color) null)
    (= (. canvas text-color) $source-caption-color)
    (call (. canvas draw-text)
      (block
        (arg layout)
        (arg
          (call Rect
            (block
              (arg (+ (. rect x) source-pill-padding))
              (arg (+ y (/ (- source-row-length (. layout height)) 2)))
              (arg (. layout width))
              (arg (. layout height))
            )
          )
        )
        (arg (. TextAlignment left))
      )
    )
    (return rect)
  )
  (fn-do _ paint-caption _
    (param canvas Canvas)
    (param text String)
    (param left Length)
    (param y Length)
    (call paint-ink canvas text left y $source-caption-color)
  )
  (fn-do _ paint-ink _
    (param canvas Canvas)
    (param text String)
    (param left Length)
    (param y Length)
    (param color RGBA)
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (let layout (call ink-layout text font))
    (= (. canvas text-color) color)
    (call (. canvas draw-text)
      (block
        (arg layout)
        (arg (call Rect left (+ y (/ (- source-row-length (. layout height)) 2)) (. layout width) (. layout height)))
        (arg (. TextAlignment left))
      )
    )
  )
  (fn-do + paint-overlay _
    (param canvas Canvas)
    (let active session)
    (return-if (if (not active)))
    (blank)
    (let stuck (call stuck-rows))
    (let text text-bounds)
    (let below (call source-stuck-height stuck))
    (let open (call Rect (. text x) (+ (. text y) below) (. text width) (call max (- (. text height) below) 0)))
    (call paint-held-marks canvas active)
    (call paint-marks canvas active open)
    (call paint-notes canvas active open)
    (call paint-controls canvas active open)
    (call paint-stuck canvas active stuck)
    (call paint-link canvas open)
    (return-if (if (or (not is-focused) (== cell-width 0))))
    (blank)
    (let is-spacer (and (not (call (. active can-edit) (. active row))) (not (call is-open-row active (. active row)))))
    (return-if (if (and (not is-spacer) (not is-caret-lit))))
    (blank)
    (let color $gui-editor-caret-color)
    (let caret (call caret-rect active))
    (do-use (. canvas saved-state)
      (call (. canvas clip) open)
      (if is-spacer
        (let cell (call Rect (+ (. caret x) (/ source-caret-width 2)) (. caret y) cell-width (. caret height)))
        (= (. canvas fill-color) null)
        (= (. canvas stroke-width) source-spacer-caret-stroke)
        (= (. canvas stroke-color) color)
        (call (. canvas outline)
          (block
            (arg (call (. (call Outline cell source-spacer-caret-radius) grow) (/ (- source-spacer-caret-stroke) 2)))
          )
        )
        (else
          (= (. canvas fill-color) color)
          (call (. canvas rect) caret)
        )
      )
    )
  )
  (fn-do _ paint-stuck _
    (param canvas Canvas)
    (param active SourceSession)
    (param stuck (list SourceStuckRow))
    (return-if (if (== (. stuck length) 0)))
    (blank)
    (let content content-bounds)
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (let right (- (+ (. content x) gutter-width) source-gutter-gap))
    (let left (- (+ (. text-bounds x) source-text-inset) (. region scroll-x)))
    (let scan (call SourceSliceScan active))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (= (. canvas stroke-color) null)
      (for (in row stuck)
        (let y (+ (. content y) (. row y)))
        (= (. canvas fill-color) $gui-editor-gutter-color)
        (call (. canvas rect) (call Rect (. content x) y gutter-width (. row height)))
        (let layout (call ink-layout (str (+ (call (. active folds actual) (. row row)) 1)) font))
        (let text-y (+ y (/ (- source-row-length (. layout height)) 2)))
        (= (. canvas text-color) $gui-editor-line-number-color)
        (call (. canvas draw-text)
          (block
            (arg layout)
            (arg (call Rect (- right (. layout width)) text-y (. layout width) (. layout height)))
            (arg (. TextAlignment left))
          )
        )
        (let actual (call (. active folds actual) (. row row)))
        (if (and (== actual hovered-row) (call source-fold-head active actual))
          (call paint-fold-button
            (block
              (arg canvas)
              (arg (call control-x left (!= (. (call (. scan slice) (. row row) (. row height)) member) null)))
              (arg y)
              (arg true)
            )
          )
        )
      )
      (let last ([] stuck (- (. stuck length) 1)))
      (if (> (. last y) (- (call row-top (. last row)) shown-top))
        (= (. canvas fill-color) $gui-editor-sticky-border-color)
        (call (. canvas rect) (call Rect (. content x) (+ (. content y) (. last y) (. last height)) (. content width) 1))
      )
    )
  )
  (fn-do _ paint-link _
    (param canvas Canvas)
    (param open Rect)
    (let found link)
    (return-if (if (or (not found) (== cell-width 0))))
    (blank)
    (do-use (. canvas saved-state)
      (call (. canvas clip) open)
      (= (. canvas fill-color) $gui-editor-link-color)
      (for (in rect (call link-rects found))
        (call (. canvas rect) (call Rect (. rect x) (- (+ (. rect y) (. rect height)) 3) (. rect width) 1))
      )
    )
  )
  (fn-do _ paint-held-marks _
    (param canvas Canvas)
    (param active SourceSession)
    (let whole content-bounds)
    (let top shown-top)
    (let folds (. active folds))
    (let first (call first-shown top))
    (let last (call last-shown active top (. whole height)))
    (do-use (. canvas saved-state)
      (call (. canvas clip) whole)
      (= (. canvas fill-color) $source-held-mark-color)
      (for (in index (..< first last))
        (let row (call (. folds actual) index))
        (if (or (. (call (. active row-at) row) is-invalid) (call (. folds holds-invalid) row))
          (let y (- (+ (. whole y) (call row-top index)) top))
          (call (. canvas rect) (call Rect (. whole x) y source-marker-width (call row-height index)))
        )
      )
    )
  )
)

(fn-expr _ source-fold-head Bool
  (param active SourceSession)
  (param row Size)
  (and (call (. active is-block-head) row) (call (. active folds can-fold) row))
)

(fn-do _ paint-source-circle _
  (param canvas Canvas)
  (param x Length)
  (param y Length)
  (param fill RGBA)
  (param border (? RGBA))
  (let top (+ y (/ (- source-row-length source-add-size) 2)))
  (let circle (call Outline (call Rect x top source-add-size source-add-size) (/ source-add-size 2)))
  (= (. canvas stroke-color) null)
  (= (. canvas fill-color) fill)
  (call (. canvas outline) circle)
  (if border
    (= (. canvas fill-color) null)
    (= (. canvas stroke-width) source-border-width)
    (= (. canvas stroke-color) border)
    (call (. canvas outline) (call (. circle grow) (/ (- source-border-width) 2)))
    (= (. canvas stroke-color) null)
  )
)

(fn-do _ paint-source-fold _
  (param canvas Canvas)
  (param x Length)
  (param y Length)
  (param is-open Bool)
  (param fill RGBA)
  (param border (? RGBA))
  (param mark RGBA)
  (let middle-x (+ x (/ source-add-size 2)))
  (let middle-y (+ y (/ source-row-length 2)))
  (call paint-source-circle canvas x y fill border)
  (let reach source-chevron-reach)
  (let depth (/ source-chevron-reach 2))
  (do-use (. canvas saved-state)
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) mark)
    (= (. canvas stroke-width) source-chevron-stroke)
    (= (. canvas stroke-cap) (. LineCap round))
    (= (. canvas stroke-join) (. LineJoin round))
    (call (. canvas begin))
    (if is-open
      (call (. canvas move) (- middle-x reach) (- middle-y depth))
      (call (. canvas line) middle-x (+ middle-y depth))
      (call (. canvas line) (+ middle-x reach) (- middle-y depth))
      (else
        (call (. canvas move) (- middle-x depth) (- middle-y reach))
        (call (. canvas line) (+ middle-x depth) middle-y)
        (call (. canvas line) (- middle-x depth) (+ middle-y reach))
      )
    )
    (call (. canvas end))
  )
)

(fn-do _ paint-source-add _
  (param canvas Canvas)
  (param x Length)
  (param y Length)
  (param fill RGBA)
  (param border (? RGBA))
  (param mark RGBA)
  (param is-lazy _ (= false))
  (let middle-x (+ x (/ source-add-size 2)))
  (let middle-y (+ y (/ source-row-length 2)))
  (call paint-source-circle canvas x y fill border)
  (= (. canvas fill-color) mark)
  (if is-lazy
    (= (. canvas stroke-color) null)
    (call paint-source-dot canvas (- middle-x (/ source-add-dot-gap 2)) middle-y)
    (call paint-source-dot canvas (+ middle-x (/ source-add-dot-gap 2)) middle-y)
    (return)
  )
  (call (. canvas rect)
    (block
      (arg
        (call Rect
          (block
            (arg (- middle-x (/ source-add-arm 2)))
            (arg (- middle-y (/ source-add-stroke 2)))
            (arg source-add-arm)
            (arg source-add-stroke)
          )
        )
      )
    )
  )
  (call (. canvas rect)
    (block
      (arg
        (call Rect
          (block
            (arg (- middle-x (/ source-add-stroke 2)))
            (arg (- middle-y (/ source-add-arm 2)))
            (arg source-add-stroke)
            (arg source-add-arm)
          )
        )
      )
    )
  )
)

(fn-do _ paint-source-dot _
  (param canvas Canvas)
  (param x Length)
  (param y Length)
  (call (. canvas outline)
    (block
      (arg
        (call Outline
          (block
            (arg (call Rect (- x (/ source-add-dot 2)) (- y (/ source-add-dot 2)) source-add-dot source-add-dot))
            (arg (/ source-add-dot 2))
          )
        )
      )
    )
  )
)

(type + SourceGutter (is CodeChangeBox)
  (using SourceStructureTheme)
  (prop + numbered Size)
  (prop + session (? SourceSession))
  (prop + caret-row Size)
  (prop + head-lit Bool)
  (prop + scrolled Length)
  (prop + gap Length)
  (prop + covered Length)
  (prop + version U64)
  (prop + folds (? SourceFolds))
  (prop + rows (? SourceWrapRows))
  (prop + changes (list DiffLineChange))
  (event + toggled Size)
  (event + added Size)
  (blank)
  (prop _ numbers (list TextLayout))
  (prop _ labels (list Size))
  (blank)
  (depends changed numbered caret-row head-lit scrolled gap version changes rows)
  (fn-do _ changed _
    (call invalidate-paint)
  )
  (whenever-rule #is-hover-within
    (call invalidate-paint)
  )
  (subscribe-for (on event pointer-down)
    (let active folds)
    (let y (+ (. event point y) scrolled))
    (if (and active (== (. event button) (. PointerButton primary)) (>= y 0) (>= (. event point y) covered))
      (let display (call display-of (as (call floor (/ y source-row-length)) Size)))
      (let row
        (block
          (case? (< display (call (. active row-count)))
            (call (. active actual) display)
          )
          (default
            (. active document row-count)
          )
        )
      )
      (if (and (< display numbered) (or (call (. active is-folded) row) (and (!= session null) (call source-fold-head session row))))
        (<- toggled row)
        (call (. event cancel))
        (else-if (and (< row (. active document row-count)) (or (call has-adder row) (and head-lit (== display caret-row))))
          (<- added row)
          (call (. event cancel))
        )
      )
    )
  )
  (fn-do _ release-numbers _
    (for (in layout numbers)
      (call (. layout close))
    )
    (= numbers (call (of List TextLayout)))
    (= labels (call (of List Size)))
  )
  (fn-do _ ensure-numbers _
    (param wanted (list Size))
    (return-if (if (call is-labeled wanted)))
    (blank)
    (call release-numbers)
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (for (in label wanted)
      (+= numbers (call TextLayout (call TextLayoutRequest (str label) font)))
    )
    (= labels wanted)
  )
  (fn-expr _ is-labeled Bool
    (param wanted (list Size))
    (== labels wanted)
  )
  (fn-expr _ has-adder Bool
    (param row Size)
    (and (!= session null) (== (+ row 1) (. session row-count)))
  )
  (fn-do _ display-of Size
    (param line Size)
    (let shown rows)
    (return-if line (if (not shown)))
    (return-if (. shown count) (if (>= line (. shown line-count))))
    (return (call (. shown display-at) line))
  )
  (fn-expr _ top-of Length
    (param display Size)
    (* (?? (call (?. rows top) display) display) source-row-length)
  )
  (fn-do + close _
    (call release-numbers)
    (call (. super close))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let content content-bounds)
    (return-if (if (or (<= (. content width) 0) (<= (. content height) 0))))
    (blank)
    (= (. canvas fill-color) $gui-editor-gutter-color)
    (call (. canvas rect) content)
    (let active folds)
    (let shown-count (if-expr active (call (. active row-count)) (+ numbered 1)))
    (let low (if-expr (> scrolled 0) (call display-of (as (call floor (/ scrolled source-row-length)) Size)) 0))
    (let high
      (call min
        (block
          (arg shown-count)
          (arg (+ (call display-of (as (call ceil (/ (+ scrolled (. content height)) source-row-length)) Size)) 1))
        )
      )
    )
    (return-if (if (<= high low)))
    (blank)
    (let rows (list Size))
    (let wanted (list Size))
    (for (in index (..< low high))
      (let row (if-expr active (call (. active actual) index) index))
      (+= rows row)
      (+= wanted (+ row 1))
    )
    (call ensure-numbers wanted)
    (let right (- (+ (. content x) (. content width)) gap))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (= (. canvas stroke-color) null)
      (for (in index (..< low high))
        (let layout ([] numbers (- index low)))
        (let y (- (+ (. content y) (call top-of index)) scrolled))
        (let text-y (+ y (/ (- source-row-length (. layout height)) 2)))
        (let text-rect (call Rect (- right (. layout width)) text-y (. layout width) (. layout height)))
        (let is-caret (== index caret-row))
        (= (. canvas text-color) (if-expr is-caret $gui-editor-caret-line-number-color $gui-editor-line-number-color))
        (if (< index numbered)
          (call (. canvas draw-text) layout text-rect (. TextAlignment left))
        )
      )
      (call paint-changes canvas content right changes scrolled source-row-length)
    )
  )
)

(type + SourceRowBox (is Box)
  (using CodeSyntaxStyle)
  (using SourceStructureTheme)
  (prop + row SourceRow)
  (prop + address I64 (= -1))
  (prop + bolds Bool)
  (prop + italics Bool)
  (prop + inset Length (= source-row-padding))
  (prop + wrap-columns Size (= 0))
  (blank)
  (prop _ text-layouts (list TextLayout))
  (prop _ shown-spans (list SourceSpan))
  (prop _ shown-indent Size)
  (prop _ shown-divider U8)
  (prop _ shown-zone SourceRowZone)
  (prop _ shown-bolds Bool)
  (prop _ shown-italics Bool)
  (prop _ shown-colors (list RGBA))
  (prop _ shown-wrap-columns Size)
  (blank)
  (depends row-changed row bolds italics wrap-columns)
  (fn-do _ row-changed _
    (if (or (== (. text-layouts length) 0) (!= shown-indent (. row indent)) (!= shown-divider (. row divider)) is-restyled (not (call source-spans-same shown-spans (. row spans))))
      (call release-text-layout)
    )
    (lazy is-restyled (or (!= shown-zone (. row zone)) (!= shown-bolds bolds) (!= shown-italics italics) (!= shown-wrap-columns wrap-columns)))
    (call invalidate-paint)
  )
  (fn-do _ ensure-text-layouts (list TextLayout)
    (let colors (call palette))
    (if (!= (. text-layouts length) 0)
      (return-if text-layouts (if (call has-colors colors)))
      (blank)
      (call release-text-layout)
    )
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (let wrap (call source-row-wrap row wrap-columns source-indent-columns))
    (let made (list TextLayout))
    (for (in line (..< 0 (. wrap line-count)))
      (let segments (call line-segments ([] (. wrap starts) line) (call (. wrap line-end) line) (call (. wrap line-x) line) font))
      (+= made (call TextLayout segments font null (. TextOverflow clip) (. TextWrap no-wrap)))
    )
    (= text-layouts made)
    (= shown-spans (. row spans))
    (= shown-indent (. row indent))
    (= shown-divider (. row divider))
    (= shown-zone (. row zone))
    (= shown-bolds bolds)
    (= shown-italics italics)
    (= shown-colors colors)
    (= shown-wrap-columns wrap-columns)
    (return made)
  )
  (fn-do _ line-segments (list TextSegment)
    (param from Size)
    (param to Size)
    (param lead Size)
    (param font Font)
    (let bold (call Font $font-family $font-size (. FontWeight bold) $font-slant))
    (let italic (call Font $font-family $font-size $font-weight (. FontSlant italic)))
    (let bold-italic (call Font $font-family $font-size (. FontWeight bold) (. FontSlant italic)))
    (let is-preamble (== (. row zone) (. SourceRowZone preamble)))
    (let segments (list TextSegment))
    (let position (. row content-start))
    (let blank (+ lead (call max (- (call min to position) from) 0)))
    (if (> blank 0)
      (+= segments (call TextSegment 0 (* " " blank) font))
    )
    (for (in span (. row spans))
      (let end (+ position (. span text length)))
      (if (and (> end from) (< position to))
        (let is-bold (and bolds (call source-is-bold (. span kind))))
        (let is-slanted (and italics (. span is-optional)))
        (let shown
          (block
            (case? is-bold
              (if-expr is-slanted bold-italic bold)
            )
            (case? is-slanted
              italic
            )
            (default
              font
            )
          )
        )
        (let color
          (block
            (case? is-preamble
              (call source-preamble-color this (. span kind))
            )
            (default
              (call source-span-color this (. span kind))
            )
          )
        )
        (let whole (and (>= position from) (<= end to)))
        (let text
          (block
            (case? whole
              (. span text)
            )
            (default
              ([] (. span text) (..< (- (call max from position) position) (- (call min to end) position)))
            )
          )
        )
        (+= segments (call TextSegment 0 text shown color))
      )
      (= position end)
    )
    (return segments)
  )
  (fn-expr _ palette (list RGBA)
    (item (?? $syntax-plain-color $gui-syntax-plain-color))
    (item $gui-syntax-keyword-color)
    (item $gui-syntax-function-color)
    (item $gui-syntax-variable-color)
    (item $gui-syntax-type-color)
    (item $gui-syntax-parameter-color)
    (item $gui-syntax-number-color)
    (item $gui-syntax-string-color)
    (item $gui-syntax-operator-color)
    (item $gui-syntax-punctuation-color)
    (item $gui-syntax-comment-color)
    (item $gui-syntax-invalid-color)
    (item $source-imports-prefix-color)
    (item $source-imports-name-color)
    (item $source-sigil-color)
    (item $source-operator-color)
    (item $source-exit-color)
    (item $source-parameter-color)
    (item $source-member-name-color)
    (item $source-tracked-color)
  )
  (fn-expr _ has-colors Bool
    (param colors (list RGBA))
    (== shown-colors colors)
  )
  (fn-do _ release-text-layout _
    (for (in layout text-layouts)
      (call (. layout close))
    )
    (= text-layouts (call (of List TextLayout)))
  )
  (fn-do + close _
    (call release-text-layout)
    (call (. super close))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let content content-bounds)
    (return-if (if (or (<= (. content width) 0) (<= (. content height) 0))))
    (blank)
    (if (call (of virtual-row-is-sticky SourceRow) this)
      (= (. canvas fill-color) $gui-editor-background-color)
      (call (. canvas rect) content)
      (call (?. (call (of ancestor SourceEditor)) paint-stuck-surface) canvas content address inset)
    )
    (return-if (if (or (== (. row spans length) 0) (. row is-divider))))
    (blank)
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (let layouts (call ensure-text-layouts))
      (let pitch (/ (. content height) (. layouts length)))
      (= (. canvas text-color) (?? $syntax-plain-color $gui-syntax-plain-color))
      (for (in line (..< 0 (. layouts length)))
        (let layout ([] layouts line))
        (let text-y (+ (. content y) (* line pitch) (/ (- pitch (. layout height)) 2)))
        (call (. canvas draw-text)
          (block
            (arg layout)
            (arg (call Rect (+ (. content x) inset) text-y (. layout width) (. layout height)))
            (arg (. TextAlignment left))
          )
        )
      )
    )
  )
)

(type + SourceRowSource
  (implements (of VirtualSource SourceRow))
  (prop + session SourceSession)
  (prop + revision _ (:= (call VirtualRevision)))
  (blank)
  (prop _ range VirtualRangeSource)
  (fn-do + resize _
    (= (. range count) (as (call (. session folds row-count)) VirtualCoord))
  )
  (fn-do + This _
    (param session _)
    (lazy range (call VirtualRangeSource (call (. session folds row-count))))
  )
  (fn-expr + domain VirtualSequenceDomain :get
    range
  )
  (fn-do + bind _
    (param address I64)
    (param generation U64)
    (param target (of VirtualBindingTarget SourceRow))
    (if (or (< address 0) (>= address (call (. session folds row-count))))
      (call (. target fail) generation)
      (else
        (call (. target commit)
          (block
            (arg (call VirtualKey (. revision value) address))
            (arg (call (. session row-at) (call (. session folds actual) address)))
            (arg generation)
          )
        )
      )
    )
  )
)

(type + SourceStickyRows
  (implements VirtualStickyRows)
  (prop + session SourceSession)
  (fn-do + This _
    (param session _)
  )
  (fn-do + sticky-headers _
    (param address I64)
    (param headers (of List I64))
    (let folds (. session folds))
    (return-if (if (or (< address 0) (>= address (as (call (. folds row-count)) I64)))))
    (blank)
    (for (in row (call (. folds headers) (call (. folds actual) address) source-sticky-limit))
      (+= headers (call (. folds shown) row))
    )
  )
  (fn-expr + sticky-section-last I64
    (param header I64)
    (case? (or (< header 0) (>= header (as (call (. folds row-count)) I64)))
      header
    )
    (default
      (as (call (. folds shown) (call (. folds section-end) (call (. folds actual) header))) I64)
    )
    (where
      (lazy folds (. session folds))
    )
  )
)

(fn-expr _ source-row-layout VirtualLayout
  (param row-width (? VirtualCoord))
  (param sticky (? SourceStickyRows))
  (param rows SourceWrapRows)
  (case? (!= sticky null)
    (call VerticalStickyLayout (call VerticalOffsetLayout rows row-width) sticky)
  )
  (default
    (call VerticalOffsetLayout rows row-width)
  )
)

(fn-do _ source-stuck-rows (list SourceStuckRow)
  (param sticky VirtualStickyRows)
  (param rows SourceWrapRows)
  (param top Length)
  (param inset Length)
  (let found (list SourceStuckRow))
  (let bottom top)
  (let reach top)
  (let headers (call (of List I64)))
  (while (>= reach 0)
    (let line (as (call floor (/ reach source-row-length)) Size))
    (return-if found (if (>= line (. rows line-count))))
    (blank)
    (call (. headers clear))
    (call (. sticky sticky-headers) (call (. rows display-at) line) headers)
    (return-if found (if (or (<= (. headers length) (. found length)) (not (call source-extends-stuck headers found)))))
    (blank)
    (let header (as ([] headers (. found length)) Size))
    (let natural (* (call (. rows top) header) source-row-length))
    (let height (* (call (. rows lines) header) source-row-length))
    (let limit (* (call (. rows top) (+ (as (call (. sticky sticky-section-last) header) Size) 1)) source-row-length))
    (let y (call max natural (call min bottom (- limit height))))
    (+= found (call SourceStuckRow header (+ (- y top) inset) height))
    (= bottom (+ y height))
    (+= reach height)
  )
  (return found)
)

(fn-expr _ source-extends-stuck Bool
  (param headers (of List I64))
  (param found (list SourceStuckRow))
  (call all (..< 0 (. found length)) (:where (== (as ([] headers each) Size) (. ([] found each) row))))
)

(fn-do _ source-stuck-at (? SourceStuckRow)
  (param stuck (list SourceStuckRow))
  (param y Length)
  (for (in row stuck)
    (return-if row (if (and (>= y (. row y)) (< y (+ (. row y) (. row height))))))
  )
  (return null)
)

(fn-expr _ source-stuck-height Length
  (param stuck (list SourceStuckRow))
  (if-expr (> (. stuck length) 0) (call max (+ (. last y) (. last height)) 0) 0)
  (where
    (lazy last ([] stuck (- (. stuck length) 1)))
  )
)

(fn-expr _ source-selection-contains Bool
  (param active SourceSession)
  (param point SourcePoint)
  (and (. active has-selection) after-start before-end)
  (where
    (lazy first (. active first-selected-row))
    (lazy last (. active last-selected-row))
    (lazy after-start (or (> (. point row) first) (and (== (. point row) first) (>= (. point column) (. active selection-start)))))
    (lazy before-end (or (< (. point row) last) (and (== (. point row) last) (< (. point column) (. active selection-end)))))
  )
)

(type _ SourceNoteHit (is (tuple (: rect Rect) (: text String) (: is-code Bool))))

(type _ SourceSpot (is (tuple (: display Size) (: row Size) (: line Index) (: wrap SourceWrap))))

(type _ SourceStuckRow (is (tuple (: row Size) (: y Length) (: height Length))))

(type _ SourcePill (is (tuple (: label String) (: text String) (: is-code Bool))))
