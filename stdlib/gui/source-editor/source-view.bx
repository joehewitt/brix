    (let x (- (+ (. point x) (. region scroll-x)) source-text-inset gutter-width))
    (let spot (call spot-under active point))
    (return-if null (if (or (< x 0) (not spot) (not (call (. active folds is-folded) (. spot row))) (!= (. spot line) (. spot wrap last-line)))))
    (blank)
    (let start (+ (* (call (. spot wrap end-x) (. spot line)) cell-width) code-chip-gap))
    (return (if-expr (or (< x start) (> x (+ start code-chip-width))) null (. spot row)))
  )
