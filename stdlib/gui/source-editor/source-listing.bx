(import ./source-style)
(import ./source-view)
(import /code/structure/listing)
(import /code/structure/rows)
(import /code/structure/session)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/code-editor)
(import /math)
(import /ui/virtual)
(import /ui/virtual-layout)

(type + SourceListingPane (is Box)
  (using CodeEditorTheme)
  (using CodeSyntaxStyle)
  (using SourceStructureTheme)
  (prop + is-active Bool)
  (prop + session (? SourceSession))
  (prop + stamp U64)
  (prop + source (? (of VirtualSource SourceRow)))
  (prop + row-width (? VirtualCoord))
  (prop + top-inset Length (= 0))
  (blank)
  (prop _ lines (? SourceLineSource))
  (prop _ cell-width Length)
  (prop _ measured-font (? Font))
  (prop _ caret (? SourceLineRange))
  (prop _ band (? SourceLineRange))
  (prop _ is-caret-held Bool)
  (prop _ focused-first (? Size))
  (prop _ is-focus-new Bool)
  (prop _ wants-reveal Bool)
  (prop _ is-picked Bool)
  (blank)
  (event + row-picked Size)
  (blank)
  (depends changed stamp session is-active)
  (depends inset-changed top-inset)
  (blank)
  (rule This (• code-editor-text) (• flex-col))
  (content
    (<> This
      (<> (of VirtualRegion SourceRow) (id: region) (• flex 1)
        (= source #source)
        (= virtual-layout (call VerticalFixedLayout source-row-height #row-width))
        (= overscan (call VirtualInsets 100vcoord 0vcoord 100vcoord 0vcoord))
        (= top-inset #top-inset)
        (blank)
        (<> SourceRowBox (slot: row) (param: slot)
          (= row (. slot #item))
        )
      )
    )
  )
  (subscribe-for (on event (. region scroll-changed) (when arrival))
    (call invalidate-paint)
  )
  (subscribe-for (on event pointer-down)
    (let bound lines)
    (let y (+ (- (. event point y) (. content-bounds y) top-inset) (. region scroll-y)))
    (if (and bound (== (. event button) (. PointerButton primary)) (>= y 0))
      (let row (call (. bound listing row-of) (as (call floor (/ y (as source-row-height Length))) Size)))
      (if (!= row null)
        (= is-picked true)
        (<- row-picked row)
      )
    )
  )
  (fn-do _ changed _
    (let active session)
    (if (or (not active) (not is-active))
      (= lines null)
      (= source null)
      (= caret null)
      (= band null)
      (= focused-first null)
      (= wants-reveal false)
      (= is-picked false)
      (call invalidate-paint)
      (return)
    )
    (let document (. active document))
    (let current lines)
    (let bound
      (block
        (case? (and (!= current null) (== (as (. current listing document) (? Pointer)) (as document (? Pointer))))
          current
        )
        (default
          (call SourceLineSource (call SourceListing document))
        )
      )
    )
    (if (!= (as bound (? Pointer)) (as current (? Pointer)))
      (= lines bound)
      (= source bound)
      (= focused-first null)
    )
    (let listing (. bound listing))
    (let at (call (. document declaration-at) (. active row)))
    (if (call (. listing sync) (call (. active preview)) at)
      (call (. bound refresh))
      (call widen (. listing widest))
    )
    (let shown (call (. active row-at) (. active row)))
    (= caret (call caret-lines active listing at))
    (= is-caret-held (. shown is-invalid))
    (= band (?? (call (. listing find) (. shown owner-id) at) (call (. listing lines-of) at)))
    (let start (?. band first))
    (if (!= start focused-first)
      (= focused-first start)
      (= is-focus-new true)
    )
    (if is-picked
      (= is-picked false)
      (= is-focus-new false)
      (else
        (call reveal)
      )
    )
    (call invalidate-paint)
  )
  (fn-do _ inset-changed _
    (call invalidate-paint)
  )
  (fn-do _ caret-lines (? SourceLineRange)
    (param active SourceSession)
    (param listing SourceListing)
    (param at Index)
    (return-if null (if (== (. (call (. active row-at) (. active row)) node) null)))
    (blank)
    (let first (call (. active document first-row) at))
    (let row (. active row))
    (while (>= row first)
      (let shown (call (. active row-at) row))
      (if (!= (. shown node) null)
        (let found (call (. listing find) (. shown node-id) at))
        (return-if found (if found))
      )
      (return-if null (if (== row first)))
      (blank)
      (-= row 1)
    )
    (return null)
  )
  (fn-do _ reveal _
    (if (<= (. region content-bounds height) 0)
      (= wants-reveal true)
      (return)
    )
    (= wants-reveal false)
    (let focus band)
    (if (and is-focus-new (!= focus null))
      (call (. region scroll-to-address) (. focus last) (. ScrollAlignment nearest))
      (call (. region scroll-to-address) (. focus first) (. ScrollAlignment nearest))
    )
    (= is-focus-new false)
    (let mark caret)
    (if mark
      (call (. region scroll-to-address) (. mark first) (. ScrollAlignment nearest))
    )
  )
  (fn-do _ widen _
    (param widest Size)
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (if (!= font measured-font)
      (= measured-font font)
      (= cell-width (call code-cell-width font))
    )
    (= row-width (as (call ceil (+ (* widest cell-width) (* source-row-padding 2))) I64))
  )
  (fn-expr _ lines-rect Rect
    (param range SourceLineRange)
    (call Rect
      (block
        (arg (. content x))
        (arg (- (+ (. content y) top-inset (* (. range first) height)) (. region scroll-y)))
        (arg (. content width))
        (arg (* (+ (- (. range last) (. range first)) 1) height))
      )
    )
    (where
      (lazy content content-bounds)
      (lazy height (as source-row-height Length))
    )
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (if wants-reveal
      (call reveal)
    )
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let content content-bounds)
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (= (. canvas fill-color) $gui-panel-color)
      (call (. canvas rect) content)
      (let focus band)
      (if focus
        (= (. canvas fill-color) $source-focus-band-color)
        (call (. canvas rect) (call lines-rect focus))
      )
      (let mark caret)
      (if mark
        (= (. canvas fill-color) (if-expr is-caret-held $source-held-band-color $source-focus-line-color))
        (call (. canvas rect) (call lines-rect mark))
      )
      (= (. canvas fill-color) $gui-divider-color)
      (call (. canvas rect) (call Rect (. content x) (. content y) 1 (. content height)))
    )
  )
)

(type + SourceLineSource
  (implements (of VirtualSource SourceRow))
  (prop + listing SourceListing)
  (prop + revision _ (:= (call VirtualRevision)))
  (blank)
  (prop _ range VirtualRangeSource)
  (fn-do + This _
    (param listing _)
    (lazy range (call VirtualRangeSource 0))
  )
  (fn-do + refresh _
    (= (. range count) (as (. listing line-count) VirtualCoord))
    (call (. revision bump))
  )
  (fn-expr + domain VirtualSequenceDomain :get
    range
  )
  (fn-do + bind _
    (param address I64)
    (param generation U64)
    (param target (of VirtualBindingTarget SourceRow))
    (if (or (< address 0) (>= address (. listing line-count)))
      (call (. target fail) generation)
      (else
        (let spans (call source-listing-spans (call (. listing line) address)))
        (call (. target commit)
          (block
            (arg (call VirtualKey (. revision value) address))
            (arg (call SourceRow null source-row-decoration 0 spans))
            (arg generation)
          )
        )
      )
    )
  )
)
