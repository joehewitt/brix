/code/structure/document
/code/structure/fold
/code/structure/rows
/code/structure/session
/graphics/canvas
/graphics/color
/graphics/outline
/graphics/point
/graphics/primitives
/math

+ source-box-radius Length = 8
+ source-box-indent Length = 18
+ source-member-indent Length = 10
+ source-box-margin Length = 8
+ source-edge-offset Length = 9
+ source-edge-step Length = 4
+ source-wash-trail Length = 6
+ source-border-width Length = 1
_ source-private-dash Length = 3

━━━━━━━━━━━━━━━━━━━━
+ SourceSurface is Union

| none
| box
| tray

━━━━━━━━━━━━━━━━━━━━
+ SourceReach is Tuple

+ top Length?
+ bottom Length?

━━━━━━━━━━━━━━━━━━━━
+ SourceSlice is Tuple

+ surface SourceSurface
+ outer SourceReach?
+ member SourceReach? = null
+ wash SourceReach? = null
+ kind = SourceRowBlock.none
+ is-private = false
+ is-member-private = false

━━━━━━━━━━━━━━━━━━━━
+ SourceSurfacePalette is Tuple

+ box RGBA
+ box-border RGBA
+ tray RGBA
+ tray-border RGBA
+ member RGBA
+ member-border RGBA
+ wash RGBA
+ steps-wash RGBA
+ text-wash RGBA
+ holder-wash RGBA
+ steps-border RGBA
+ text-border RGBA
+ background RGBA

━━━━━━━━━━━━━━━━━━━━
+ SourceSliceScan

+ session SourceSession
+ height Length

_ member-declaration Index?
_ member-start Size
_ member-end Size
_ is-member = false

────────────────────
+ This
    - session
    - height

────────────────────
+ do slice SourceSlice
    - display Size

. document = session.document
. folds = session.folds
. row = folds.actual(display)
=? SourceSlice(.none, null) if row + 1 >= document.row-count
. index = document.declaration-at(row)
. rows = document.rows-of(index)
. base = document.first-row(index)
. local = row - base
. surface = block-surface(rows[0].block)
=? SourceSlice(.none, null) if surface == SourceSurface.none
. next = if display + 1 < folds.row-count() then folds.actual(display + 1) else document.row-count
. after = next - base
. current = rows[local]
. closes = after >= rows.length
. is-gap = current.node == null && current.divider == 0
. is-tray = surface == SourceSurface.tray
. outer-bottom Length? = null
if closes
    outer-bottom = if !is-gap then height else source-edge-offset
. outer = SourceReach(if local == 0 then source-edge-offset else null, outer-bottom)
. in-member = is-tray && is-member-row(index, rows, local)
. member SourceReach? = null
. bottom = outer-bottom
if in-member
    . member-closes = closes || after >= member-end
    . member-bottom Length? = null
    if member-closes
        . edge = if is-gap then source-edge-offset else height
        member-bottom = if closes then edge - source-edge-step else edge
    member = SourceReach(if local == member-start then source-edge-offset else null, member-bottom)
    bottom = member-bottom
. opens = local == 0 || (in-member && local == member-start)
. wash SourceReach? = null
if current.zone == SourceRowZone.header
    . continues = !closes && next == row + 1 && (rows[after].zone == SourceRowZone.header || rows[after].node == null)
    wash = SourceReach(null, if continues then null else bottom ?? height)
else if opens && local + 1 < rows.length && rows[local + 1].zone == SourceRowZone.header
    wash = SourceReach(source-edge-offset, null)
else if is-gap && local > 0 && rows[local - 1].zone == SourceRowZone.header
    wash = SourceReach(null, min(source-wash-trail, bottom ?? source-wash-trail))
. kind = if in-member then rows[member-start].block else rows[0].block
= SourceSlice(surface, outer, member, wash, kind, rows[0].is-private, in-member && rows[member-start].is-private)

────────────────────
_ do is-member-row Bool
    - index Index
    - rows [SourceOutlineRow]
    - local Size

. home = rows[0].owner
=? false if rows[local].owner == home
=? is-member if member-declaration == index && local >= member-start && local < member-end
. start = local
while start > 0 && rows[start].divider != source-divider-thin && rows[start - 1].owner != home
    start -= 1
. end = start + 1
while end < rows.length && rows[end].owner != home && rows[end].divider != source-divider-thin
    end += 1
member-declaration = index
member-start = start
member-end = end
is-member = rows[start].divider == source-divider-thin && source-is-function-block(rows[start].block)
= is-member

━━━━━━━━━━━━━━━━━━━━
_ block-surface SourceSurface
    - block SourceRowBlock

match block
    | .holder
        SourceSurface.tray
    | .none
        SourceSurface.none
    ??
        SourceSurface.box

━━━━━━━━━━━━━━━━━━━━
_ source-is-function-block Bool
    - block SourceRowBlock

block == SourceRowBlock.leaf || block == SourceRowBlock.steps || block == SourceRowBlock.text

━━━━━━━━━━━━━━━━━━━━
+ do paint-source-slice
    - canvas Canvas
    - slice SourceSlice
    - band Rect
    - left Length
    - right Length
    - palette SourceSurfacePalette

. outer = slice.outer
=? if !outer || right <= left
. box = source-reached(band, outer, left, right)
. step = source-box-indent - source-member-indent
. member = slice.member
. inner = box
if member
    inner = source-reached(band, member, left + step, right - step)
. fill = source-surface-color(slice.surface, palette).over(palette.background)
. member-fill = palette.member.over(fill)
do use canvas.saved-state
    canvas.clip(band)
    canvas.stroke-color = null
    canvas.fill-color = fill
    canvas.outline(Outline(box, source-box-radius))
    if member
        canvas.fill-color = member-fill
        canvas.outline(Outline(inner, source-box-radius))
    . wash = slice.wash
    if wash
        . top = band.y + (wash.top ?? -source-box-radius * 2)
        . bottom = band.y + (wash.bottom ?? band.height + source-box-radius * 2)
        do use canvas.saved-state
            canvas.clip(Rect(band.x, top, band.width, bottom - top))
            . washed = source-wash-fill(slice.kind, palette).over(if member then member-fill else fill)
            canvas.fill-color = washed
            canvas.outline(Outline(inner, source-box-radius))
    . border = source-surface-border(slice.surface, palette)
    if border
        . shown = if slice.surface == SourceSurface.box then source-kind-border(slice.kind, border, palette) else border
        stroke-source-edge(canvas, box, band, shown.over(fill), slice.is-private)
    if member
        . edge = source-kind-border(slice.kind, palette.member-border, palette).over(member-fill)
        stroke-source-edge(canvas, inner, band, edge, slice.is-member-private)

━━━━━━━━━━━━━━━━━━━━
_ do stroke-source-edge
    - canvas Canvas
    - box Rect
    - band Rect
    - color RGBA
    - is-dashed Bool

. shape = Outline(box, source-box-radius).grow(-source-border-width / 2)
canvas.fill-color = null
canvas.stroke-width = source-border-width
canvas.stroke-color = color
if !is-dashed
    canvas.outline(shape)
    =
. radius = source-box-radius
stroke-source-corner(canvas, Point(box.x + radius, box.y + radius), 180deg, band)
stroke-source-corner(canvas, Point(box.right - radius, box.y + radius), 270deg, band)
stroke-source-corner(canvas, Point(box.right - radius, box.bottom - radius), 0deg, band)
stroke-source-corner(canvas, Point(box.x + radius, box.bottom - radius), 90deg, band)
canvas.stroke-color = null
canvas.fill-color = color
. width = source-border-width
. count = max(round(band.height / (source-private-dash * 2)), 1)
. period = band.height / count
. top = max(band.y, box.y + radius)
. bottom = min(band.bottom, box.bottom - radius)
. y = band.y
while y < bottom
    . from = max(y, top)
    . to = min(y + period / 2, bottom)
    if to > from
        canvas.rect(Rect(box.x, from, width, to - from))
        canvas.rect(Rect(box.right - width, from, width, to - from))
    y += period
if box.y >= band.y - width && box.y < band.bottom
    paint-source-dashes(canvas, box.x + radius, box.right - radius, box.y)
if box.bottom > band.y && box.bottom <= band.bottom + width
    paint-source-dashes(canvas, box.x + radius, box.right - radius, box.bottom - width)

━━━━━━━━━━━━━━━━━━━━
_ do stroke-source-corner
    - canvas Canvas
    - center Point
    - start Radians
    - band Rect

. radius = source-box-radius - source-border-width / 2
=? if center.y + radius <= band.y || center.y - radius >= band.bottom
. count = max(round(radius * 1.5707963267948966 / (source-private-dash * 2)), 1)
. step = 90deg / count
. dashes = count as Size
for index in 0 .. < dashes
    . from = start + step * ((index as F64) + 0.25)
    canvas.begin()
    canvas.move(center.x + cos(from) * radius, center.y + sin(from) * radius)
    for part in 1 .. 4
        . angle = from + step / 2 * (part as F64) / 4
        canvas.line(center.x + cos(angle) * radius, center.y + sin(angle) * radius)
    canvas.end()

━━━━━━━━━━━━━━━━━━━━
_ do paint-source-dashes
    - canvas Canvas
    - left Length
    - right Length
    - y Length

. x = left
while x < right
    canvas.rect(Rect(x, y, min(source-private-dash, right - x), source-border-width))
    x += source-private-dash * 2

━━━━━━━━━━━━━━━━━━━━
+ source-slice-shape Outline?
    - slice SourceSlice
    - band Rect
    - left Length
    - right Length

|? !outer
    null
|? !member
    Outline(source-reached(band, outer, left, right), source-box-radius)
??
    Outline(source-reached(band, member, left + step, right - step), source-box-radius)

.. outer = slice.outer
.. member = slice.member
.. step = source-box-indent - source-member-indent

━━━━━━━━━━━━━━━━━━━━
_ source-reached Rect
    - band Rect
    - reach SourceReach
    - left Length
    - right Length

Rect(left, top, right - left, bottom - top)

.. top = band.y + (reach.top ?? -source-box-radius * 2)
.. bottom = band.y + (reach.bottom ?? band.height + source-box-radius * 2)

━━━━━━━━━━━━━━━━━━━━
_ source-surface-color RGBA
    - surface SourceSurface
    - palette SourceSurfacePalette

match surface
    | .tray
        palette.tray
    ??
        palette.box

━━━━━━━━━━━━━━━━━━━━
_ source-wash-fill RGBA
    - kind SourceRowBlock
    - palette SourceSurfacePalette

match kind
    | .steps
        palette.steps-wash
    | .text
        palette.text-wash
    | .holder
        palette.holder-wash
    ??
        palette.wash

━━━━━━━━━━━━━━━━━━━━
_ source-kind-border RGBA
    - kind SourceRowBlock
    - plain RGBA
    - palette SourceSurfacePalette

match kind
    | .steps
        palette.steps-border
    | .text
        palette.text-border
    ??
        plain

━━━━━━━━━━━━━━━━━━━━
_ source-surface-border RGBA?
    - surface SourceSurface
    - palette SourceSurfacePalette

match surface
    | .tray
        palette.tray-border
    ??
        palette.box-border
