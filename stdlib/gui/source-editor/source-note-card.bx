(import /gui)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIBoxSpacing)
  (using GUIFontStyle)
  (using GUIPopupStyle)
  (rule SourceNoteCard (• bg gui-popup-color) (• text gui-text-color) (• px 12) (• py 10)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shadow gui-popup-shadow)
  )
  (blank)
  (rule source-note-text
    (= font-size gui-body-font-size)
  )
  (blank)
  (rule source-note-code
    (= font-family "Menlo")
    (= font-size gui-body-font-size)
  )
)

(type + SourceNoteCard (is Popup)
  (prop + text _ (= ""))
  (prop + is-code _ (= false))
  (blank)
  (rule This (• flex-col) (• below-end 4))
  (content
    (<> This
      (if #is-code
        (<> Label (• source-note-code)
          (= text #text)
        )
        (else
          (<> Label (• source-note-text)
            (= text #text)
          )
        )
      )
    )
  )
)
