(style SourceStructureLightTheme (is SourceStructureTheme) (for light)
  (prop + source-thin-divider-color _ (= (call RGBA "#d9d4a6")))
  (prop + source-held-band-color _ (= (call RGBA "#cf222e1f")))
  (prop + source-held-mark-color _ (= (call RGBA "#cf222e")))
  (prop + source-focus-band-color _ (= (call RGBA "#f1f6fd")))
  (prop + source-focus-line-color _ (= (call RGBA "#dce8f8")))
  (prop + source-band-color _ (= (call RGBA "#1f23280a")))
  (prop + source-box-color _ (= (call RGBA "#ffffff00")))
  (prop + source-box-border-color _ (= (call RGBA "#d8dee4")))
  (prop + source-tray-color _ (= (call RGBA "#fbfcfd")))
  (prop + source-tray-border-color _ (= (call RGBA "#0969da24")))
  (prop + source-member-color _ (= (call RGBA "#f6f8fa")))
  (prop + source-member-border-color _ (= (call RGBA "#d8dee4")))
  (prop + source-wash-color _ (= (call RGBA "#1f23280d")))
  (prop + source-steps-wash-color _ (= (call RGBA "#8c6f3314")))
  (prop + source-text-wash-color _ (= (call RGBA "#1b7c8312")))
  (prop + source-holder-wash-color _ (= (call RGBA "#0969da12")))
  (prop + source-steps-border-color _ (= (call RGBA "#61512229")))
  (prop + source-text-border-color _ (= (call RGBA "#1b7c8324")))
  (prop + source-imports-prefix-color _ (= (call RGBA "#3b6fa8")))
  (prop + source-imports-name-color _ (= (call RGBA "#083868")))
  (prop + source-caption-color _ (= (call RGBA "#8c959f")))
  (prop + source-wait-color _ (= (call RGBA "#0969da14")))
  (prop + source-raise-color _ (= (call RGBA "#cf222e99")))
  (prop + source-convert-color _ (= (call RGBA "#9a6700")))
  (prop + source-unknown-color _ (= (call RGBA "#1f23280f")))
  (prop + source-inferred-color _ (= (call RGBA "#6e7781")))
  (prop + source-inferred-lit-color _ (= (call RGBA "#cf222e")))
  (prop + source-pill-color _ (= (call RGBA "#1f23280a")))
  (prop + source-pill-border-color _ (= (call RGBA "#1f232829")))
  (prop + source-add-color _ (= (call RGBA "#f6f8fa")))
  (prop + source-add-border-color _ (= (call RGBA "#d0d7de")))
  (prop + source-add-mark-color _ (= (call RGBA "#6e7781")))
  (prop + source-add-lit-color _ (= (call RGBA "#0969da")))
  (prop + source-add-lit-mark-color _ (= (call RGBA "#ffffff")))
  (prop + source-sigil-color _ (= (call RGBA "#8c959f")))
  (prop + source-operator-color _ (= (call RGBA "#6e7781")))
  (prop + source-exit-color _ (= (call RGBA "#cf222e")))
  (prop + source-parameter-color _ (= (call RGBA "#9a6700")))
  (prop + source-member-name-color _ (= (call RGBA "#0f766e")))
  (prop + source-tracked-color _ (= (call RGBA "#bf2b5c")))
)

(fn-expr + source-is-bold Bool
  (param kind SourceSpanKind)
  (has (list (. SourceSpanKind definition) (. SourceSpanKind type-definition) (. SourceSpanKind member-binder) (. SourceSpanKind binder)) kind)
)

(fn-expr + source-preamble-color RGBA
  (param element _)
  (param kind SourceSpanKind)
  (match kind
    (case .string
      (. element $source-imports-prefix-color)
    )
    (case .definition
      (. element $source-imports-name-color)
    )
    (default
      (call source-span-color element kind)
    )
  )
)

(fn-expr + source-span-color RGBA
  (param element _)
  (param kind SourceSpanKind)
  (match kind
    (case .plain
      (?? (. element $syntax-plain-color) (. element $gui-syntax-plain-color))
    )
    (case .keyword
      (. element $gui-syntax-keyword-color)
    )
    (case .definition
      (?? (. element $syntax-plain-color) (. element $gui-syntax-plain-color))
    )
    (case .identifier
      (. element $gui-syntax-variable-color)
    )
    (case .type-name
      (. element $gui-syntax-type-color)
    )
    (case .rule
      (. element $gui-syntax-function-color)
    )
    (case .capture
      (. element $gui-syntax-parameter-color)
    )
    (case .number
      (. element $gui-syntax-number-color)
    )
    (case .string
      (. element $gui-syntax-string-color)
    )
    (case .operator
      (. element $source-operator-color)
    )
    (case .punctuation
      (. element $source-sigil-color)
    )
    (case .decoration
      (. element $gui-syntax-punctuation-color)
    )
    (case .comment
      (. element $gui-syntax-comment-color)
    )
    (case .invalid
      (. element $gui-syntax-invalid-color)
    )
    (case .parameter
      (. element $source-parameter-color)
    )
    (case .member
      (. element $source-member-name-color)
    )
    (case .member-binder
      (. element $source-member-name-color)
    )
    (case .type-definition
      (. element $gui-syntax-type-color)
    )
    (case .exit
      (. element $source-exit-color)
    )
    (case .tracked
      (. element $source-tracked-color)
    )
    (case .binder
      (?? (. element $syntax-plain-color) (. element $gui-syntax-plain-color))
    )
  )
)

(fn-expr + source-surface-palette SourceSurfacePalette
  (param element _)
  (call SourceSurfacePalette
    (block
      (arg (. element $source-box-color))
      (arg (. element $source-box-border-color))
      (arg (. element $source-tray-color))
      (arg (. element $source-tray-border-color))
      (arg (. element $source-member-color))
      (arg (. element $source-member-border-color))
      (arg (. element $source-wash-color))
      (arg (. element $source-steps-wash-color))
      (arg (. element $source-text-wash-color))
      (arg (. element $source-holder-wash-color))
      (arg (. element $source-steps-border-color))
      (arg (. element $source-text-border-color))
      (arg (. element $gui-editor-background-color))
    )
  )
)

(fn-do + paint-source-double-rule _
  (param canvas Canvas)
  (param left Length)
  (param right Length)
  (param y Length)
  (param color RGBA)
  (let top (+ y (call floor (/ (- source-row-length source-double-divider-height) 2))))
  (let width (- right left))
  (= (. canvas fill-color) color)
  (call (. canvas rect) (call Rect left top width source-thin-divider-height))
  (call (. canvas rect) (call Rect left (- (+ top source-double-divider-height) source-thin-divider-height) width source-thin-divider-height))
)
