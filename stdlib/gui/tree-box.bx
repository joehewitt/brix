(import ./box)
(import ./disclosure)
(import ./drag)
(import ./events)
(import ./keys)
(import ./label)
(import ./list-box)
(import ./position)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import ./virtual)
(import ./window)
(import /core/markup)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/style)
(import /math)
(import /os/path)
(import /ui/input)
(import /ui/virtual)
(import /ui/virtual-layout)
(import /units)
(blank)
(prop _ tree-box-indent-width Length (= 14))
(prop + tree-box-chevron-width Length (= 16))
(prop _ tree-box-overscan-rows VirtualCoord (= 3vcoord))
(prop _ tree-box-measured-estimate VirtualCoord (= 28vcoord))
(prop + tree-box-row-inset Length (= 4))
(prop + tree-box-sticky-gap Length (= 2))
(prop + tree-box-sticky-blur Length (= 40))

(style-extend GUIDefaultTheme
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIBoxPlacement)
  (using GUITextPaint)
  (using GUIBoxTransform)
  (using VectorPaintStyle)
  (rule TreeBoxItem (• pl tree-box-row-inset)
    (when-style #shows-hover
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-drop-target
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
    (blank)
    (when-style #is-dragged
      (= opacity 0%%)
    )
  )
  (blank)
  (rule TreeBox
    (when-style #is-drop-root
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-focused
      (rule VirtualSlotRoot
        (when-style #is-sticky
          (rule TreeBoxItem
            (when-style #is-selected
              (• bg gui-accent-color)
            )
          )
        )
      )
    )
    (blank)
    (rule VirtualSlotRoot
      (= (. motion position) gui-motion-quick)
      (blank)
      (when-style #is-sticky
        (= backdrop-blur tree-box-sticky-blur)
        (blank)
        (rule TreeBoxItem (• bg gui-sticky-row-color) (• mt tree-box-sticky-gap)
          (blank)
          (when-style #is-selected
            (= background-color (call (. gui-pressed-color over) gui-sticky-row-color))
          )
        )
      )
      (blank)
      (when-style #is-carried
        (rule TreeBoxItem (• bg gui-raised-color)
          (= corner-radius gui-control-radius)
          (= shadow gui-lifted-shadow)
        )
      )
    )
  )
  (blank)
  (rule TreeBoxDisclosure (• h 16) (• mr 2)
    (rule icon
      (= stroke-width 2.25)
    )
  )
  (blank)
  (rule TreeBoxDropMark (• bg gui-accent-color)
    (= border-color gui-accent-bright-color)
    (= border-width 1)
    (= corner-radius gui-control-radius)
  )
)

(type + (of TreeBox Item) (is ListBox)
  (using GUIVirtualRowStyle)
  (prop + root-node (? Item))
  (prop + load-children (of TreeBoxChildProvider Item) (= tree-box-no-children))
  (prop + item-has-children (? (of TreeBoxItemPredicate Item)))
  (prop + auto-expand (? (of TreeBoxItemPredicate Item)))
  (prop + item-title (? (of TreeBoxItemTitle Item)))
  (prop + expansion-revision Size (= 0))
  (prop + key-builder (? (of MarkupKeyBuilder Item)))
  (prop + entries (list (of TreeBoxEntry Item)) (= (call (of List (of TreeBoxEntry Item)))))
  (prop + selected-entry (? (of TreeBoxEntry Item)) (= (call tree-box-listed-entry #entries entry-indexes #selected-key)))
  (prop + selected-item (? Item) (= (?. #selected-entry item)))
  (prop + can-open-selection Bool (= (call (of tree-box-can-open Item) #selected-entry)))
  (prop + can-leave-selection Bool (= (call (of tree-box-can-leave Item) #selected-entry)))
  (prop + entry-source _ (:= (call (of VirtualListSource (of TreeBoxEntry Item)))))
  (prop + can-drag (? (of TreeBoxItemPredicate Item)))
  (prop + drag-items (? (of TreeBoxDragItems Item)))
  (prop + item-path (? (of TreeBoxItemPath Item)))
  (prop + can-drop (? (of TreeBoxDropPredicate Item)))
  (prop + payload-operation (? (of TreeBoxPayloadOperation Item)))
  (prop + is-ordered _ (= true))
  (prop + measures-rows _ (= false))
  (prop + is-drop-root _ (= false))
  (prop + has-sticky-parents _ (= false))
  (prop + sticky-inset Length (= 0))
  (prop + has-chevrons _ (= true))
  (prop + chevron-width Length (= (if-expr #has-chevrons tree-box-chevron-width 0)))
  (prop + drop-gap (? Index))
  (prop + drop-depth Index (= 0))
  (prop + drop-key (? String))
  (prop + drop-scroll Length (= 0))
  (event + dropped (of TreeBoxDrop Item))
  (blank)
  (prop _ expanded-keys (of Map String Bool) (= (call (of Map String Bool))))
  (prop _ items-by-key (of Map String Item) (= (call (of Map String Item))))
  (prop _ seen-keys (of Map String Bool) (= (call (of Map String Bool))))
  (prop _ child-cache (of Map String (list Item)) (= (call (of Map String (list Item)))))
  (prop _ parent-keys (of Map String String) (= (call (of Map String String))))
  (prop _ entry-indexes (of Map String Index) (= (call (of Map String Index))))
  (prop _ is-live _ (= false))
  (prop _ reveal-pending _ (= false))
  (prop _ reveal-alignment _ (= (. ScrollAlignment nearest)))
  (prop _ dragged-keys (of Map String Bool) (= (call (of Map String Bool))))
  (prop _ carried-keys (of Map String Bool) (= (call (of Map String Bool))))
  (prop _ is-carrying _ (= false))
  (prop _ held-rows (list I64) (= (call (of List I64))))
  (prop _ walked (list (of TreeBoxEntry Item)) (= (call (of List (of TreeBoxEntry Item)))))
  (prop _ resting (list (of TreeBoxEntry Item)) (= (call (of List (of TreeBoxEntry Item)))))
  (prop _ placement (? (of TreeBoxDrop Item)))
  (prop _ held-key (? String))
  (prop _ sticky-rows (? (of TreeBoxStickyRows Item)))
  (blank)
  (rule This
    (= overflow-y (. ScrollOverflow visible))
  )
  (fn-do + This _
    (= (. entry-source identity) (=> (entry) (as (call hash-for (. entry key)) U64)))
  )
  (content
    (<> This
      (if #can-leave-selection
        (<> KeyShortcut (text: "Back")
          (= key .arrow-left)
          (= action (=> () :do (call leave-selection)))
        )
      )
      (blank)
      (if #can-open-selection
        (<> KeyShortcut (text: "Open")
          (= key .arrow-right)
          (= action (=> () :do (call open-selection)))
        )
      )
      (blank)
      (<> (of VirtualRegion (of TreeBoxEntry Item)) (id: rows) (• flex 1)
        (= source entry-source)
        (= virtual-layout
          (call tree-box-layout
            (block
              (arg (if-expr #is-carrying null #drop-gap))
              (arg #sticky-rows)
              (arg #held-rows)
              (arg #measures-rows)
            )
          )
        )
        (= overscan-rows tree-box-overscan-rows)
        (= sticky-inset (- #sticky-inset tree-box-sticky-gap))
        (blank)
        (<> (of TreeBoxItem Item) (id: tree-row) (slot: row) (param: slot)
          (= tree this)
          (= entry (. slot #item))
          (blank)
          (+<> Box (id: row) (param: tree-row (of TreeBoxItem Item)))
        )
      )
      (blank)
      (if (!= #drop-gap null)
        (<> TreeBoxDropSlot (• absolute) (• cover .parent)
          (<> Box (• absolute)
            (= left (call (. PositionOffset coord) (call tree-box-mark-inset #drop-depth #chevron-width)))
            (= right (call (. PositionOffset coord) tree-box-row-inset))
            (= top
              (call (. PositionOffset coord)
                (block
                  (arg (call tree-box-mark-top (. rows #row-extent) #drop-scroll #drop-gap))
                )
              )
            )
            (= min-height (call (. SizeSpec coord) (. rows #row-extent)))
            (= max-height (call (. SizeSpec coord) (. rows #row-extent)))
            (blank)
            (<> TreeBoxDropMark (• absolute) (• cover .parent))
          )
        )
      )
    )
  )
  (whenever-rule #root-node
    (call reset-tree)
  )
  (whenever-rule #has-sticky-parents
    (= sticky-rows (only-if (call (of TreeBoxStickyRows Item) entries) (if has-sticky-parents)))
  )
  (subscribe-for (on event (. rows scroll-changed) (when arrival))
    (= drop-scroll (. event position y))
  )
  (subscribe-for (on event drag-start)
    (call begin-row-drag event)
  )
  (subscribe-for (on event drag-over)
    (let next (call placement-at (. event session) (. event root-point)))
    (call show-placement next)
    (if next
      (call (. event accept)
        (block
          (arg (?? (call (. rows nearest-scroll-container) (. Orientation vertical)) rows))
          (arg (call operation-for (. next drop)))
        )
      )
    )
  )
  (subscribe-for (on event drag-leave (when arrival))
    (call show-placement null)
  )
  (subscribe-for (on event drop (when arrival))
    (let landed placement)
    (call show-placement null)
    (if landed
      (<- dropped landed)
    )
  )
  (subscribe-for (on event drag-end (when arrival))
    (call (. dragged-keys clear))
    (call (. carried-keys clear))
    (= is-carrying false)
    (call rebuild-entries)
    (let key held-key)
    (= held-key null)
    (if (and key (!= key selected-key) (!= (call entry-index-for-key key) null))
      (call move-cursor key)
    )
    (call refresh-row-selection)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (= is-live true)
    (call reset-tree)
    (if reveal-pending
      (call request-reveal)
    )
  )
  (fn-do + unmounted _
    (= is-live false)
    (call (. super unmounted))
  )
  (fn-expr + page-row-step _ :get
    (case? (< rows-per-page 1)
      1
    )
    (default
      rows-per-page
    )
    (where
      (lazy rows-per-page (as (call floor (/ (. page content-bounds height) (. rows row-extent))) Int))
      (lazy page (?? (call (. rows nearest-scroll-container) (. Orientation vertical)) rows))
    )
  )
  (fn-do + activate-selection _
    (call ensure-selection)
    (let entry (call entry-for-key selected-key))
    (if (and entry (. entry has-children))
      (call toggle-key (. entry key))
      (return)
    )
    (call (. super activate-selection))
  )
  (fn-expr + can-choose Bool
    (param key String)
    (not (?? (?. (call entry-for-key key) has-children) false))
  )
  (fn-expr + selection-order (list String)
    (call (of List String)
      (block
        (spread entries)
        (pipe *> (. each key))
      )
    )
  )
  (fn-expr + title-for-key String
    (param key String)
    (if-expr (and titles item) (call titles item) "")
    (where
      (lazy titles item-title)
      (lazy item ([] items-by-key key))
    )
  )
  (fn-expr + key-of-row (? String)
    (param row (? ListItem))
    (match? row
      (case (of TreeBoxItem Item)
        (?. (. it entry) key)
      )
    )
  )
  (fn-expr + press-activates Bool
    (param row ListItem)
    (or (> chevron-width 0) (not (?? (?. (call entry-for-key (call key-of-row row)) has-children) false)))
  )
  (fn-expr + item-at (? Item)
    (param event GUIEvent)
    (?. (call entry-for-key (call key-of-row (call row-at event))) item)
  )
  (fn-do + reveal-key _
    (param key String)
    (call request-reveal)
  )
  (fn-do + show-selection _
    (call refresh-row-selection)
  )
  (fn-do + rows-changed _)
  (fn-expr + selected-index _ :get
    (call entry-index-for-key selected-key)
  )
  (fn-expr + selected-items (list Item) :get
    (in (. each item) entries (when (call is-key-selected (. each key))))
  )
  (fn-expr + item-for-key (? Item)
    (param key String)
    ([] items-by-key key)
  )
  (fn-do + reset-tree _
    (call (. expanded-keys clear))
    (call (. items-by-key clear))
    (call (. seen-keys clear))
    (call (. child-cache clear))
    (call (. parent-keys clear))
    (call rebuild-entries-from null)
  )
  (fn-do + reload _
    (let was-pending reveal-pending)
    (call (. child-cache clear))
    (call rebuild-entries)
    (= reveal-pending was-pending)
  )
  (fn-do + open-selection _
    (call ensure-selection)
    (let entry (call entry-for-key selected-key))
    (return-if (if (or (not entry) (not (. entry has-children)))))
    (blank)
    (if (. entry is-expanded)
      (let child (call first-child-key-of (. entry key)))
      (if child
        (call select-key child)
      )
      (return)
    )
    (call expand-key (. entry key))
  )
  (fn-do + leave-selection _
    (call ensure-selection)
    (let entry (call entry-for-key selected-key))
    (return-if (if (not entry)))
    (blank)
    (if (and (. entry has-children) (. entry is-expanded))
      (call collapse-key (. entry key))
      (return)
    )
    (let parent-key (. entry parent-key))
    (if parent-key
      (call select-key parent-key)
    )
  )
  (fn-expr + is-expanded _
    (param key String)
    (has expanded-keys key)
  )
  (fn-do + expand-key _
    (param key String)
    (return-if (if (call is-expanded key)))
    (= ([] expanded-keys key) true)
    (+= expansion-revision 1)
    (call rebuild-entries)
  )
  (fn-do + expand-items _
    (param items (list Item))
    (let builder key-builder)
    (return-if (if (or (not builder) (== (. items length) 0))))
    (for (in item items)
      (let key (call builder item))
      (= ([] items-by-key key) item)
      (= ([] expanded-keys key) true)
    )
    (+= expansion-revision 1)
    (call rebuild-entries)
  )
  (fn-expr + expanded-items _
    (spread (. expanded-keys keys))
    (pipe ?*> ([] items-by-key each))
    (pipe |> List)
  )
  (fn-do + collapse-key _
    (param key String)
    (return-if (if (not (call is-expanded key))))
    (-= ([] expanded-keys key))
    (+= expansion-revision 1)
    (if (and selected-key (call is-descendant-key selected-key key))
      (call move-cursor key)
    )
    (call rebuild-entries)
  )
  (fn-do + toggle-key _
    (param key String)
    (if (call is-expanded key)
      (call collapse-key key)
      (else
        (call expand-key key)
      )
    )
  )
  (fn-do + expand-all _
    (param max-depth Index (= 64))
    (let current-root root-node)
    (return-if (if (not current-root)))
    (let root-children (call children-for "" current-root))
    (return-if (if (== root-children null)))
    (call expand-descendants root-children "" 0 max-depth)
    (+= expansion-revision 1)
    (call rebuild-entries)
  )
  (fn-do + collapse-all _
    (call (. expanded-keys clear))
    (+= expansion-revision 1)
    (call rebuild-entries)
  )
  (fn-do + reveal-key-path Bool
    (param keys (list String))
    (param alignment _ (= (. ScrollAlignment nearest)))
    (return-if false (if (not keys)))
    (= reveal-alignment alignment)
    (blank)
    (let last-ancestor (- (. keys length) 1))
    (let index Index 0)
    (while (< index last-ancestor)
      (if (not (call is-expanded ([] keys index)))
        (= ([] expanded-keys ([] keys index)) true)
        (+= expansion-revision 1)
      )
      (+= index 1)
    )
    (blank)
    (call rebuild-entries)
    (let target-key ([] keys last-ancestor))
    (return-if false (if (== (call entry-index-for-key target-key) null)))
    (blank)
    (call move-cursor target-key)
    (return true)
  )
  (fn-do + rebuild-entries _
    (call rebuild-entries-from selected-key)
  )
  (fn-do _ rebuild-entries-from _
    (param selection (? String))
    (let next (list (of TreeBoxEntry Item)) (call (of List (of TreeBoxEntry Item))))
    (let current-root root-node)
    (if current-root
      (let root-children (call children-for "" current-root))
      (if (!= root-children null)
        (call append-visible-entries next root-children "" 0 null)
      )
    )
    (blank)
    (= walked next)
    (call arrange-display)
    (let restored (call restored-selection selection))
    (if (!= restored selected-key)
      (call move-cursor restored)
    )
    (call refresh-row-selection)
  )
  (fn-do + refresh-row-selection _
    (return-if (if (not is-live)))
    (for (in index (..< 0 (. rows pool-size)))
      (let row (call pool-row index))
      (if row
        (call sync-row-selection row)
      )
    )
  )
  (fn-do + sync-row-selection _
    (param row (of TreeBoxItem Item))
    (let entry (. row entry))
    (let selected false)
    (let targeted false)
    (let stowed false)
    (if entry
      (= selected (call is-key-selected (. entry key)))
      (= targeted (== (. entry key) drop-key))
      (= stowed (and (has dragged-keys (. entry key)) (not (has carried-keys (. entry key)))))
    )
    (if (!= (. row is-selected) selected)
      (= (. row is-selected) selected)
    )
    (if (!= (. row is-drop-target) targeted)
      (= (. row is-drop-target) targeted)
    )
    (if (!= (. row is-dragged) stowed)
      (= (. row is-dragged) stowed)
    )
  )
  (fn-do + row-for-key (? (of TreeBoxItem Item))
    (param key (? String))
    (return-if (if (or (not key) (not is-live))))
    (let live-key key)
    (for (in index (..< 0 (. rows pool-size)))
      (let row (call pool-row index))
      (return-if row (if (and row (== (?. (. row entry) key) live-key))))
    )
    (return null)
  )
  (fn-expr + entry-for-key (? (of TreeBoxEntry Item))
    (param key (? String))
    (only-if ([] entries index) (if (!= index null)))
    (where
      (lazy index (call entry-index-for-key key))
    )
  )
  (fn-expr + entry-index-for-key (? Index)
    (param key (? String))
    (case? (or (== index null) (>= index (. entries length)) (!= (. ([] entries index) key) key))
      null
    )
    (default
      index
    )
    (where
      (lazy index (only-if ([] entry-indexes key) (if key)))
    )
  )
  (fn-expr _ pool-row _
    (param index Index)
    (match? child
      (case (: row (of TreeBoxItem Item))
        row
      )
    )
    (where
      (lazy root (call (. rows root-at) index))
      (lazy child (only-if (. root %first-child) (if (and root (. root slot is-bound)))))
    )
  )
  (fn-do _ arrange-display _
    (let still (list (of TreeBoxEntry Item)) (call (of List (of TreeBoxEntry Item))))
    (let moving (list (of TreeBoxEntry Item)) (call (of List (of TreeBoxEntry Item))))
    (for (in entry walked)
      (if (has dragged-keys (. entry key))
        (+= moving entry)
        (else
          (+= still entry)
        )
      )
    )
    (= resting still)
    (let shown walked)
    (let gap drop-gap)
    (if (and is-carrying is-ordered (!= gap null))
      (= shown (call (of List (of TreeBoxEntry Item))))
      (for (in index (..< 0 (. still length)))
        (if (== index gap)
          (for (in entry moving)
            (+= shown entry)
          )
        )
        (+= shown ([] still index))
      )
      (if (>= gap (. still length))
        (for (in entry moving)
          (+= shown entry)
        )
      )
    )
    (if (not (call (of tree-box-entries-match Item) entries shown))
      (call publish-entries shown)
    )
    (call sync-held-rows)
  )
  (fn-do _ sync-held-rows _
    (let held (call (of List I64)))
    (if is-carrying
      (for (in index (..< 0 (. entries length)))
        (if (has carried-keys (. ([] entries index) key))
          (+= held index)
        )
      )
    )
    (if (!= held held-rows)
      (= held-rows held)
    )
  )
  (fn-do _ resting-index Index
    (param row Index)
    (let index Index 0)
    (let count (call min row (. entries length)))
    (for (in cursor (..< 0 count))
      (if (not (has dragged-keys (. ([] entries cursor) key)))
        (+= index 1)
      )
    )
    (return index)
  )
  (fn-do _ publish-entries _
    (param next (list (of TreeBoxEntry Item)))
    (call (. entry-indexes clear))
    (for (in index (..< 0 (. next length)))
      (= ([] entry-indexes (. ([] next index) key)) index)
    )
    (= entries next)
    (= is-empty (== (. next length) 0))
    (= sticky-rows (only-if (call (of TreeBoxStickyRows Item) next) (if has-sticky-parents)))
    (call (. entry-source replace) next)
  )
  (fn-do _ move-cursor _
    (param key (? String))
    (call request-reveal)
    (return-if (if (== key selected-key)))
    (= selected-key key)
    (call refresh-row-selection)
  )
  (fn-do _ request-reveal _
    (= reveal-pending true)
    (if is-live
      (call (. rows reveal-address) (=> () (call take-reveal)) reveal-alignment)
    )
  )
  (fn-do _ take-reveal (? I64)
    (return-if null (if (not reveal-pending)))
    (= reveal-pending false)
    (= reveal-alignment (. ScrollAlignment nearest))
    (let index selected-index)
    (return (only-if (as index I64) (if (!= index null))))
  )
  (fn-expr _ restored-selection (? String)
    (param key (? String))
    (case? (or (not entries) (not key))
      null
    )
    (case? (!= (call entry-index-for-key key) null)
      key
    )
    (default
      (call visible-ancestor-key key)
    )
  )
  (fn-do _ visible-ancestor-key _
    (param key String)
    (let candidate (call parent-key-of key))
    (while candidate
      (return-if candidate (if (!= (call entry-index-for-key candidate) null)))
      (= candidate (call parent-key-of candidate))
    )
  )
  (fn-expr _ parent-key-of _
    (param key String)
    ([] parent-keys key)
  )
  (fn-do _ is-descendant-key Bool
    (param key String)
    (param ancestor String)
    (let current (call parent-key-of key))
    (while current
      (return-if true (if (== current ancestor)))
      (= current (call parent-key-of current))
    )
    (return false)
  )
  (fn-expr _ first-child-key-of (? String)
    (param key String)
    (case? (or (== index null) (>= (+ index 1) (. entries length)))
      null
    )
    (default
      (match? ([] entries (+ index 1))
        (case? (== (. it parent-key) key)
          (. it key)
        )
      )
    )
    (where
      (lazy index (call entry-index-for-key key))
    )
  )
  (fn-do _ append-visible-entries _
    (param target (list (of TreeBoxEntry Item)))
    (param items (list Item))
    (param key-prefix String)
    (param depth Index)
    (param parent-key (? String))
    (let index Index 0)
    (for (in item items)
      (let key (call key-for-item item key-prefix index))
      (= ([] items-by-key key) item)
      (if parent-key
        (= ([] parent-keys key) parent-key)
      )
      (let has-children (call item-has-children-at key item))
      (if (and has-children (not (has seen-keys key)))
        (= ([] seen-keys key) true)
        (let auto auto-expand)
        (if (and auto (call auto item))
          (= ([] expanded-keys key) true)
        )
      )
      (let expanded (and has-children (call is-expanded key) (not (has dragged-keys key))))
      (+= target (call (of TreeBoxEntry Item) item key depth parent-key has-children expanded))
      (if expanded
        (let child-items (call children-for key item))
        (if (!= child-items null)
          (call append-visible-entries target child-items key (+ depth 1) key)
        )
      )
      (+= index 1)
    )
  )
  (fn-do _ expand-descendants _
    (param items (list Item))
    (param key-prefix String)
    (param depth Index)
    (param max-depth Index)
    (return-if (if (>= depth max-depth)))
    (let index Index 0)
    (for (in item items)
      (let key (call key-for-item item key-prefix index))
      (if (call item-has-children-at key item)
        (= ([] expanded-keys key) true)
        (= ([] items-by-key key) item)
        (let child-items (call children-for key item))
        (if (!= child-items null)
          (call expand-descendants child-items key (+ depth 1) max-depth)
        )
      )
      (+= index 1)
    )
  )
  (fn-expr _ item-has-children-at Bool
    (param key String)
    (param item Item)
    (case? predicate
      (call predicate item)
    )
    (default
      (and (!= children null) (> (. children length) 0))
    )
    (where
      (lazy predicate item-has-children)
      (lazy children (call children-for key item))
    )
  )
  (fn-expr _ key-for-item _
    (param item Item)
    (param key-prefix String)
    (param index Index)
    (case? builder
      (call builder item)
    )
    (case? key-prefix
      (str key-prefix "/" index)
    )
    (default
      (str index)
    )
    (where
      (lazy builder key-builder)
    )
  )
  (fn-do _ begin-row-drag _
    (param event DragStartEvent)
    (let row (call row-at event))
    (let entry (call entry-for-key (call key-of-row row)))
    (let allows can-drag)
    (return-if (if (or (not entry) (not allows) (not (call allows (. entry item))))))
    (let provider drag-items)
    (let offered (if-expr provider (call provider (. entry item)) (call dragged-selection entry)))
    (let items (list Item))
    (for (in item offered)
      (if (call allows item)
        (+= items item)
      )
    )
    (return-if (if (not (. items length))))
    (let locate item-path)
    (let paths (list Path))
    (if locate
      (for (in item items)
        (let path (call locate item))
        (if path
          (+= paths path)
        )
      )
    )
    (let stack (call (of List Box)))
    (for (in listed entries)
      (if (has items (. listed item))
        (= ([] dragged-keys (. listed key)) true)
        (if (!= (. listed key) (. entry key))
          (let other (?. (call row-for-key (. listed key)) material-parent))
          (if other
            (+= stack other)
            (= ([] carried-keys (. listed key)) true)
          )
        )
      )
    )
    (= ([] carried-keys (. entry key)) true)
    (= is-carrying true)
    (call (. event carry) (call (of TreeBoxDrag Item) this items paths) (?? (?. row material-parent) row) stack)
    (= held-key selected-key)
    (call rebuild-entries)
    (= reveal-pending false)
    (= reveal-alignment (. ScrollAlignment nearest))
  )
  (fn-expr _ dragged-selection (list Item)
    (param entry (of TreeBoxEntry Item))
    (if-expr (not (call is-key-selected (. entry key))) (list (. entry item)) selected-items)
  )
  (fn-do _ show-placement _
    (param next (? (of TreeBoxPlacement Item)))
    (= placement (?. next drop))
    (let gap (? Index) (?. next gap))
    (if (!= gap drop-gap)
      (= drop-gap gap)
      (if is-carrying
        (call arrange-display)
      )
    )
    (let depth (?? (?. next depth) 0))
    (if (!= depth drop-depth)
      (= drop-depth depth)
    )
    (if (!= (. rows scroll-y) drop-scroll)
      (= drop-scroll (. rows scroll-y))
    )
    (let on-root (call (of tree-box-lands-on-root Item) next))
    (if (!= on-root is-drop-root)
      (= is-drop-root on-root)
    )
    (let key (?. next key))
    (if (!= key drop-key)
      (= drop-key key)
      (call refresh-row-selection)
    )
  )
  (fn-do _ placement-at _
    (param session DragSession)
    (param point Point)
    (return-if null (if (or (not root-node) (not (call takes (. session payload))))))
    (let local (call (. rows point-in-box) point))
    (let height (. rows row-extent))
    (let reach (call max 0 (+ (. local y) (. rows scroll-y))))
    (return-if (call folder-placement session (as (call floor (/ reach height)) Index)) (if (not is-ordered)))
    (let held drop-gap)
    (if is-carrying
      (let slot (as (call floor (/ reach height)) Index))
      (if (and (< slot (. entries length)) (has dragged-keys (. ([] entries slot) key)))
        (return-if (call gap-placement session held (. local x)) (if (!= held null)))
        (return (call gap-placement session (call resting-index slot) (. local x)))
      )
      (let above (call resting-index slot))
      (let landing
        (scope (if-expr (and (< slot (. entries length)) past-middle) (+ above 1) above)
          (lazy past-middle (>= (- (/ reach height) (as slot Length)) 0.5))
        )
      )
      (return (call gap-placement session landing (. local x)))
    )
    (if (!= held null)
      (let edge (* (as held Length) height))
      (return-if (call gap-placement session held (. local x)) (if (and (>= reach edge) (< reach (+ edge height)))))
      (if (>= reach (+ edge height))
        (-= reach height)
      )
    )
    (let row (as (call floor (/ reach height)) Index))
    (let gap
      (block
        (case? (>= row (. resting length))
          (. resting length)
        )
        (case? (< (- (/ reach height) (as row Length)) 0.5)
          row
        )
        (default
          (+ row 1)
        )
      )
    )
    (return (call gap-placement session gap (. local x)))
  )
  (fn-expr _ folder-placement _
    (param session DragSession)
    (param row Index)
    (case? (and entry (call is-carried-key (. entry key)))
      null
    )
    (case? (and entry (not (. entry has-children)) (call allows-drop (. inside drop)))
      inside
    )
    (case? (call allows-drop (. landing drop))
      landing
    )
    (default
      null
    )
    (where
      (lazy entry (only-if ([] entries row) (if (< row (. entries length)))))
      (lazy inside (call placement-into session entry))
      (lazy folder (if-expr (and entry (not (. entry has-children))) (call entry-for-key (. entry parent-key)) entry))
      (lazy landing (call placement-into session folder))
    )
  )
  (fn-do _ is-carried-key Bool
    (param key String)
    (let cursor (? String) key)
    (while cursor
      (return-if true (if (has dragged-keys cursor)))
      (= cursor ([] parent-keys cursor))
    )
    (return false)
  )
  (fn-expr _ placement-into _
    (param session DragSession)
    (param folder (? (of TreeBoxEntry Item)))
    (call (of TreeBoxPlacement Item)
      (block
        (arg null)
        (arg 0)
        (arg key)
        (arg (call (of TreeBoxDrop Item) (. session payload) parent null (. session modifiers)))
      )
    )
    (where
      (lazy parent (if-expr folder (. folder item) (!! root-node)))
      (lazy key (only-if (. folder key) (if folder)))
    )
  )
  (fn-expr _ takes _
    (param payload DragPayload)
    (if-expr (is payload (of TreeBoxDrag Item)) (!= can-drop null) (!= payload-operation null))
  )
  (fn-expr _ allows-drop _
    (param drop (of TreeBoxDrop Item))
    (!= (call operation-for drop) (. DropOperation none))
  )
  (fn-expr _ operation-for DropOperation
    (param drop (of TreeBoxDrop Item))
    (case? (and is-own checks)
      (if-expr (call checks drop) (. DropOperation move) (. DropOperation none))
    )
    (case? (and (not is-own) weighs)
      (call weighs drop)
    )
    (default
      (. DropOperation none)
    )
    (where
      (lazy is-own (is (. drop payload) (of TreeBoxDrag Item)))
      (lazy checks can-drop)
      (lazy weighs payload-operation)
    )
  )
  (fn-do _ gap-placement _
    (param session DragSession)
    (param gap Index)
    (param x Length)
    (let lowest (if-expr (< gap (. resting length)) (. ([] resting gap) depth) 0))
    (let highest Index 0)
    (if (> gap 0)
      (let above ([] resting (- gap 1)))
      (= highest (. above depth))
      (if (or (and (. above has-children) (. above is-expanded)) (call allows-drop (. (call placement-in session above) drop)))
        (= highest (+ (. above depth) 1))
      )
    )
    (= highest (call max highest lowest))
    (let pulled (call round (/ (- x tree-box-row-inset chevron-width) tree-box-indent-width)))
    (let wanted (call min highest (call max lowest (as (call max 0 pulled) Index))))
    (let direct (call placement-under session gap wanted))
    (return-if direct (if (call allows-drop (. direct drop))))
    (let depth highest)
    (while true
      (if (!= depth wanted)
        (let other (call placement-under session gap depth))
        (return-if other (if (call allows-drop (. other drop))))
      )
      (return-if null (if (== depth lowest)))
      (-= depth 1)
    )
  )
  (fn-do _ placement-under _
    (param session DragSession)
    (param gap Index)
    (param depth Index)
    (let index Index 0)
    (let cursor gap)
    (while (> cursor 0)
      (-= cursor 1)
      (let entry ([] resting cursor))
      (if (< (. entry depth) depth)
        (return-if (call placement-in session entry gap depth) (if (and (. entry has-children) (not (. entry is-expanded)))))
        (return
          (call (of TreeBoxPlacement Item)
            (block
              (arg gap)
              (arg depth)
              (arg (. entry key))
              (arg (call (of TreeBoxDrop Item) (. session payload) (. entry item) index (. session modifiers)))
            )
          )
        )
      )
      (if (== (. entry depth) depth)
        (+= index 1)
      )
    )
    (return
      (call (of TreeBoxPlacement Item)
        (block
          (arg gap)
          (arg depth)
          (arg null)
          (arg (call (of TreeBoxDrop Item) (. session payload) (!! root-node) index (. session modifiers)))
        )
      )
    )
  )
  (fn-expr _ placement-in _
    (param session DragSession)
    (param entry (of TreeBoxEntry Item))
    (param gap Index (= 0))
    (param depth Index (= 0))
    (call (of TreeBoxPlacement Item)
      (block
        (arg gap)
        (arg depth)
        (arg (. entry key))
        (arg (call (of TreeBoxDrop Item) (. session payload) (. entry item) index (. session modifiers)))
      )
    )
    (where
      (lazy closed (and (. entry has-children) (not (. entry is-expanded))))
      (lazy index (? Index) (if-expr closed null 0))
    )
  )
  (fn-do _ children-for (? (list Item))
    (param key String)
    (param item Item)
    (let cached ([] child-cache key))
    (return-if cached (if (!= cached null)))
    (blank)
    (let children (call load-children item))
    (if (!= children null)
      (= ([] child-cache key) children)
    )
    (return children)
  )
)

(type + (of TreeBoxItem Item) (is ListItem)
  (prop + tree (? (of TreeBox Item)))
  (prop + entry (? (of TreeBoxEntry Item)))
  (prop + item (? Item) (= (?. #entry item)))
  (prop + depth Index (= (?? (?. #entry depth) 0)))
  (prop + is-expanded Bool (= (?? (?. #entry is-expanded) false)))
  (prop + indent Length (= (call tree-box-indent #depth)))
  (prop + chevron-width Length (= (?? (?. #tree #chevron-width) tree-box-chevron-width)))
  (prop + shows-hover _ (= (and #is-hover-within (not #is-selected))))
  (prop + is-drop-target _ (= false))
  (prop + is-dragged _ (= false))
  (blank)
  (rule This (• flex-row))
  (content
    (<> This
      (<> (of TreeBoxDisclosure Item) (id: disclosure) (• flex-row)
        (= row this)
        (= align-y (. Alignment center))
        (= min-width (call (. SizeSpec coord) (+ #indent #chevron-width)))
        (= max-width (call (. SizeSpec coord) (+ #indent #chevron-width)))
        (blank)
        (<> Box (• flex 1))
        (blank)
        (if (and (> #chevron-width 0) #has-children)
          (<> DisclosureChevron (• icon)
            (= align-y (. Alignment center))
            (= is-open #is-expanded)
          )
        )
      )
    )
  )
  (whenever-rule #entry
    (call sync-has-children)
    (call (?. tree sync-row-selection) this)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call sync-has-children)
    (call (?. tree sync-row-selection) this)
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (case? (not box-layout)
      text-size
    )
    (default
      (call Dimensions (call max (. text-size width) (. content width)) (call max (. text-size height) (. content height)))
    )
    (where
      (lazy text-size (call (. super measured-content-size) query))
      (lazy box-layout $layout)
      (lazy content (call (. box-layout measure-content) this query))
    )
  )
  (fn-do _ sync-has-children _
    (= has-children (?? (?. entry has-children) false))
  )
  (subscribe-for (on event click)
    (if (and (== chevron-width 0) has-children)
      (call toggle)
    )
  )
  (fn-do + toggle _
    (let owner tree)
    (let current entry)
    (if (and owner current (. current has-children))
      (call (. owner toggle-key) (. current key))
      (let ignored (call (of virtual-reveal-stuck-row (of TreeBoxEntry Item)) this))
    )
  )
)

(type + (of TreeBoxDisclosure Item) (is Box)
  (prop + row (? (of TreeBoxItem Item)))
  (subscribe-for (on event pointer-down)
    (let current row)
    (let on-chevron (>= (. event root-point x) (- (. bounds right) tree-box-chevron-width)))
    (if (and current (> (. current chevron-width) 0) (. current has-children) on-chevron)
      (call (. current toggle))
      (call (. event cancel))
    )
  )
)

(type + (of TreeBoxEntry Item)
  (prop + item Item)
  (prop + key String)
  (prop + depth Index)
  (prop + parent-key (? String))
  (prop + has-children Bool)
  (prop + is-expanded Bool)
  (fn-do + This _
    (param item _)
    (param key _)
    (param depth _)
    (param parent-key _)
    (param has-children _)
    (param is-expanded _)
  )
)

(type _ (of TreeBoxStickyRows Item)
  (implements VirtualStickyRows)
  (prop + entries (list (of TreeBoxEntry Item)))
  (blank)
  (prop _ parents _ (= (call (of List I64))))
  (prop _ lasts _ (= (call (of List I64))))
  (prop _ heads _ (= (call (of List Bool))))
  (fn-do + This _
    (param entries _)
    (let open (call (of List Index)))
    (for (in index (..< 0 (. entries length)))
      (let entry ([] entries index))
      (while (and (> (. open length) 0) (>= (. ([] entries ([] open (- (. open length) 1))) depth) (. entry depth)))
        (call (. open remove) (- (. open length) 1))
      )
      (+= parents (if-expr (> (. open length) 0) (as ([] open (- (. open length) 1)) I64) -1))
      (+= lasts index)
      (+= heads (and (. entry has-children) (. entry is-expanded)))
      (for (in ancestor open)
        (= ([] lasts ancestor) index)
      )
      (+= open index)
    )
  )
  (fn-do + sticky-headers _
    (param address I64)
    (param headers (of List I64))
    (return-if (if (or (< address 0) (>= address (as (. parents length) I64)))))
    (let start (. headers length))
    (if ([] heads address)
      (+= headers address)
    )
    (let parent ([] parents address))
    (while (>= parent 0)
      (call (. headers insert) parent start)
      (= parent ([] parents parent))
    )
  )
  (fn-expr + sticky-section-last _
    (param header I64)
    (case? (or (< header 0) (>= header (as (. lasts length) I64)))
      header
    )
    (default
      ([] lasts header)
    )
  )
)

(type + TreeBoxDropSlot (is Box)
  (rule This
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
)

(type + TreeBoxDropMark (is Box))

(type + (of TreeBoxDrag Item) (is PathsDrag)
  (prop + tree (of TreeBox Item))
  (prop + items (list Item))
  (fn-do + This _
    (param tree _)
    (param items _)
    (param paths (list Path))
    (call super paths)
  )
  (fn-expr + drag-kind _ :get
    "tree-box.rows"
  )
)

(type + (of TreeBoxDrop Item) (is Tuple)
  (prop + payload DragPayload)
  (prop + parent Item)
  (prop + index (? Index))
  (prop + modifiers PointerModifiers)
  (fn-expr + items (list Item) :get
    (if-expr (is payload (of TreeBoxDrag Item)) (. (as payload (of TreeBoxDrag Item)) items) (call (of List Item)))
  )
  (fn-expr + source (? (of TreeBox Item)) :get
    (only-if (. (as payload (of TreeBoxDrag Item)) tree) (if (is payload (of TreeBoxDrag Item))))
  )
)

(type _ (of TreeBoxPlacement Item) (is Tuple)
  (prop + gap (? Index))
  (prop + depth Index)
  (prop + key (? String))
  (prop + drop (of TreeBoxDrop Item))
)

(type + (of TreeBoxChildProvider TreeItem) (is (fn-type (? (list TreeItem)) (param item TreeItem))))

(type + (of TreeBoxItemPredicate TreeItem) (is (fn-type Bool (param item TreeItem))))

(type + (of TreeBoxItemTitle TreeItem) (is (fn-type String (param item TreeItem))))

(type + (of TreeBoxItemPath TreeItem) (is (fn-type (? Path) (param item TreeItem))))

(type + (of TreeBoxDragItems TreeItem) (is (fn-type (list TreeItem) (param item TreeItem))))

(type + (of TreeBoxDropPredicate TreeItem) (is (fn-type Bool (param drop (of TreeBoxDrop TreeItem)))))

(type + (of TreeBoxPayloadOperation TreeItem) (is (fn-type DropOperation (param drop (of TreeBoxDrop TreeItem)))))

(fn-expr _ (of tree-box-no-children Item) (? (list Item))
  (param item Item)
  null
)

(fn-expr _ (of tree-box-listed-entry Item) _
  (param entries (list (of TreeBoxEntry Item)))
  (param indexes (of Map String Index))
  (param key (? String))
  (case? (or (== index null) (>= index (. entries length)))
    null
  )
  (default
    (match? ([] entries index)
      (case? (== (. it key) key)
        it
      )
    )
  )
  (where
    (lazy index (only-if ([] indexes key) (if key)))
  )
)

(fn-expr _ tree-box-layout VirtualLayout
  (param gap (? Index))
  (param sticky (? VirtualStickyRows))
  (param held (list I64))
  (param measures Bool)
  (case? (> (. held length) 0)
    (call TreeBoxHeldLayout (call tree-box-stuck-layout gap sticky measures) held)
  )
  (default
    (call tree-box-stuck-layout gap sticky measures)
  )
)

(fn-expr _ tree-box-stuck-layout VirtualLayout
  (param gap (? Index))
  (param sticky (? VirtualStickyRows))
  (param measures Bool)
  (case? (!= sticky null)
    (call VerticalStickyLayout (call tree-box-row-layout gap measures) sticky)
  )
  (default
    (call tree-box-row-layout gap measures)
  )
)

(fn-expr _ tree-box-row-layout VirtualLayout
  (param gap (? Index))
  (param measures Bool)
  (case? measures
    (call VerticalMeasuredLayout tree-box-measured-estimate)
  )
  (case? (== gap null)
    (call VerticalRowLayout)
  )
  (default
    (call VerticalRowLayout (as gap VirtualCoord))
  )
)

(fn-expr _ tree-box-mark-inset Length
  (param depth Index)
  (param chevron-width Length)
  (+ tree-box-row-inset (call tree-box-indent depth) chevron-width)
)

(fn-expr _ tree-box-mark-top Length
  (param row-extent Length)
  (param scroll Length)
  (param gap (? Index))
  (- (* (as (?? gap 0) Length) row-extent) scroll)
)

(fn-do _ (of tree-box-entries-match Item) Bool
  (param current (list (of TreeBoxEntry Item)))
  (param next (list (of TreeBoxEntry Item)))
  (return-if false (if (!= (. current length) (. next length))))
  (let index Index 0)
  (while (< index (. current length))
    (let a ([] current index))
    (let b ([] next index))
    (return-if false (if (or (!= (. a key) (. b key)) (!= (. a depth) (. b depth)) (!= (. a parent-key) (. b parent-key)))))
    (return-if false (if (or (!= (. a has-children) (. b has-children)) (!= (. a is-expanded) (. b is-expanded)))))
    (return-if false (if (not (== (. a item) (. b item)))))
    (+= index 1)
  )
  (return true)
)

(fn-expr _ (of tree-box-lands-on-root Item) _
  (param placement (? (of TreeBoxPlacement Item)))
  (case? (not placement)
    false
  )
  (default
    (and (== (. placement gap) null) (== (. placement key) null))
  )
)

(fn-expr _ (of tree-box-can-open Item) _
  (param entry (? (of TreeBoxEntry Item)))
  (case? (not entry)
    false
  )
  (default
    (. entry has-children)
  )
)

(fn-expr _ (of tree-box-can-leave Item) _
  (param entry (? (of TreeBoxEntry Item)))
  (case? (not entry)
    false
  )
  (case? (. entry parent-key)
    true
  )
  (default
    (and (. entry has-children) (. entry is-expanded))
  )
)

(fn-expr _ tree-box-indent Length
  (param depth Index)
  (* (as depth Length) tree-box-indent-width)
)

(type _ TreeBoxHeldLayout
  (implements VirtualLayout)
  (prop + inner VirtualLayout)
  (prop + held (list I64))
  (fn-do + This _
    (param inner _)
    (param held _)
  )
  (fn-expr + revision (? VirtualRevision) :get
    (. inner revision)
  )
  (fn-do + fill-window _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
    (call (. inner fill-window) window domain)
    (for (in address held)
      (let index (call (. domain index-of) address))
      (let rect (call (. inner rect-for-address) address domain window))
      (if (and (!= index null) rect)
        (let position Index 0)
        (while (and (< position (. window placement-count)) (< (. ([] (. window placements) position) placement-id) index))
          (+= position 1)
        )
        (if (or (== position (. window placement-count)) (!= (. ([] (. window placements) position) placement-id) index))
          (call (. window insert-placement)
            (block
              (arg position)
              (arg index)
              (arg address)
              (arg (. rect x))
              (arg (. rect y))
              (arg (. rect width))
              (arg (. rect height))
            )
          )
        )
      )
    )
  )
  (fn-expr + rect-for-address _
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    (call (. inner rect-for-address) address domain window)
  )
  (fn-expr + measures-rows _ :get
    (. inner measures-rows)
  )
  (fn-do + record-row-height _
    (param placement VirtualPlacement)
    (param height VirtualCoord)
    (return (call (. inner record-row-height) placement height))
  )
  (fn-expr + has-sticky-rows _ :get
    (. inner has-sticky-rows)
  )
  (fn-expr + sticky-margin _
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    (call (. inner sticky-margin) address domain window)
  )
)
