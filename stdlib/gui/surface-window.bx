(import ./events)
(import ./layout)
(import ./metal)
(import ./scene)
(import ./surface-view)
(import ./window)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /os/env)
(import /os/file)
(import /os/message-channel)
(import /time/duration)
(import /time/timer)
(import /unistd.h)

(type + SurfaceWindow (is Window)
  (prop + frame-interval Duration (= (/ 1s 60)))
  (prop + channel-descriptor I32 (= 3))
  (prop + output-descriptor I32 (= 4))
  (prop _ renderer _ (= (call MetalOffscreenRenderer 64 64 1)))
  (prop _ scene _ (= (call DisplayScene 1 transparent renderer)))
  (prop _ sender (? SurfaceSender))
  (prop _ requested (? SurfaceSizeRequest))
  (prop _ frame-loop (? TimerLoop))
  (prop _ failure (? Error))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-expr + channel (? MessageChannel) :get
    (?. sender channel)
  )
  (fn-expr + host-size (? SurfaceSizeRequest) :get
    requested
  )
  (fn-do + run _ (?! Error)
    (let rendezvous (call env surface-rendezvous-variable))
    (throw (call Error "No host is waiting for this program's surface") (if (not rendezvous)))
    (blank)
    (call C:dup2 output-descriptor 1)
    (call C:dup2 output-descriptor 2)
    (call C:close output-descriptor)
    (let opened (call SurfaceSender (call MessageChannel (call File channel-descriptor)) rendezvous))
    (= sender opened)
    (finally
      (call (. opened close))
      (call (. renderer close))
    )
    (call open)
    (call accept-window-activated)
    (let loop (call TimerLoop))
    (= frame-loop loop)
    (call (. loop loop) frame-interval step)
    (let stopped failure)
    (throw stopped (if stopped))
  )
  (fn-do _ step _
    (let opened sender)
    (if (or (not opened) (not (. opened channel is-open)))
      (call (?. frame-loop cancel))
      (return)
    )
    (call receive opened)
    (call fit opened
      (block
        (on-error (: error Error)
          (= failure error)
          (call (?. frame-loop cancel))
          (return)
        )
      )
    )
    (if requested
      (call tick)
      (let frame (use (call WindowFrame this)))
      (= (. frame committed) (call update-frame))
    )
  )
  (fn-do + tick _)
  (fn-do + handle _
    (param message Message)
  )
  (fn-do + resized _
    (call relayout)
  )
  (fn-do + relayout _
    (return-if (if (not requested)))
    (blank)
    (call resize-renderer)
    (call settle-layout)
    (call schedule-render)
  )
  (fn-do _ resize-renderer _
    (let view viewport)
    (call (. renderer resize) (. view width) (. view height) backing-scale (?? background transparent))
    (call (. scene add-damage) (call Rect view))
  )
  (fn-do _ receive _
    (param opened SurfaceSender)
    (while true
      (let message (call (. opened channel poll)))
      (return-if (if (not message)))
      (blank)
      (if (not (call (. opened handle) message))
        (call dispatch message)
      )
    )
  )
  (fn-do _ dispatch _
    (param message Message)
    (match (as (. message kind) SurfaceMessageKind)
      (case= .pointer
        (let record (call (of (. message record) PointerRecord)))
        (if record
          (call accept-pointer-record record)
        )
      )
      (case= .key
        (let record (call (of (. message record) SurfaceKeyRecord)))
        (if record
          (call accept-key-record record (call (. message text) (. SurfaceKeyRecord size)))
        )
      )
      (case= .text
        (let record (call (of (. message record) SurfaceTextRecord)))
        (if record
          (call accept-text-record record (call (. message text) (. SurfaceTextRecord size)))
        )
      )
      (case= .focus
        (let record (call (of (. message record) SurfaceFocusRecord)))
        (if (and record (!= (. record is-focused) 0))
          (call accept-window-activated)
          (else-if record
            (call accept-window-deactivated)
          )
        )
      )
      (default
        (call handle message)
      )
    )
  )
  (fn-do _ accept-key-record _
    (param record SurfaceKeyRecord)
    (param characters String)
    (let key (call key-from-native (. record key) (. record native-key-code)))
    (if (== (. record phase) (. SurfaceKeyPhase release))
      (call dispatch-key-release (call KeyReleaseEvent key (. record modifiers) (. record native-key-code) characters))
      (return)
    )
    (call dispatch-key-press
      (block
        (arg
          (call KeyPressEvent
            (block
              (arg key)
              (arg (. record modifiers))
              (arg (!= (. record is-repeat) 0))
              (arg (. record native-key-code))
              (arg characters)
            )
          )
        )
      )
    )
    (let modifiers (. record modifiers))
    (if (and (. characters length) (not (. modifiers command)) (not (. modifiers control)))
      (call accept-text-action (. NativeTextActionKind input) characters 0 0 true)
    )
  )
  (fn-do _ accept-text-record _
    (param record SurfaceTextRecord)
    (param text String)
    (call accept-text-action (as (. record action) NativeTextActionKind) text (. record start) (. record length) false)
  )
  (fn-do _ fit _ (?! Error)
    (param opened SurfaceSender)
    (let wanted (. opened wanted))
    (return-if (if (not wanted)))
    (blank)
    (let current requested)
    (if current
      (let same-size (and (== (. current width) (. wanted width)) (== (. current height) (. wanted height))))
      (return-if (if (and same-size (== (. current scale) (. wanted scale)))))
    )
    (= requested wanted)
    (call (. opened resize)
      (block
        (arg (as (call ceil (* (. wanted width) (. wanted scale))) I32))
        (arg (as (call ceil (* (. wanted height) (. wanted scale))) I32))
        (arg (. wanted scale))
      )
    )
    (= size (call Dimensions (. wanted width) (. wanted height)))
    (call resized)
  )
  (fn-expr + display-scale _ :get
    (if-expr requested (. requested scale) 1)
  )
  (fn-do + ensure-native _)
  (fn-do + accept-native-scroll _
    (param event ScrollEvent)
    (let ignored (call dispatch-pointer-event event))
  )
  (fn-do + render _
    (let opened sender)
    (return-if false (if (or (not opened) (not requested))))
    (blank)
    (let surface (call (. opened acquire)))
    (if (not surface)
      (call schedule-render)
      (return false)
    )
    (let started (call monotonic-time-nanoseconds))
    (let view viewport)
    (if (or (!= (. renderer width) (. view width)) (!= (. renderer height) (. view height)) (!= (. renderer scale) backing-scale))
      (call resize-renderer)
    )
    (call (. scene maintain) this backing-scale (?? background transparent))
    (call (. scene damage-pending-textures))
    (call (. renderer present-into) surface)
    (let did-encode (call (. scene frame-metal) renderer))
    (if (or (. renderer has-pending-fill-frames) (. scene has-pending-textures))
      (call schedule-render)
    )
    (call mark-painted)
    (if (not did-encode)
      (call (. opened abandon))
      (return false)
    )
    (call (. renderer finish))
    (call (. opened deliver) (- (call monotonic-time-nanoseconds) started))
    (return true)
  )
)
