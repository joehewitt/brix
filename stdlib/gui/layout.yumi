gui-carry-slot(box, child, orient)

────────────────────
_ do arrange-flex-content
    - box Box

. content = box.content-bounds
. available = gui-main-size(content.size, orient)
. query = box.child-layout-query()
. scratch GUIFlexScratch = acquire-gui-flex-scratch()
. coupled = box.$stack-motion == StackMotion.coupled

. order = gui-carried-order(box)
if order
    for live in order
        gather-flex-child(scratch, live, query, coupled, false)
else
    . child = box.first-active-child
    . whole = !coupled && !box.has-spaced-children
    . spaced = false
    while child
        . live = child
        child = live.next-active-sibling
        if !whole
            if live.is-released
                spaced = true
                continue
            spaced = spaced || live.layout-space < 1
        gather-flex-child(scratch, live, query, coupled, whole)
    if !whole && !spaced
        box.has-spaced-children = false
. fixed = scratch.fixed
. total-flex = scratch.total-flex

. gap = box.computed-gap
. gaps Length = 0
if scratch.is-uniform
    if scratch.children.length > 1
        gaps = gap * (scratch.children.length - 1)
else
    . reach Float
    for space in scratch.spaces
        gaps += gap * space * reach
        reach = max(reach, space)
fixed += gaps
if fixed > available
    fixed -= gui-flex-shrink(scratch, fixed - available, orient, available)
. remaining = gui-safe-span(available - fixed)
while total-flex > 0
    . clamped-one = false
    for index in 0 .. < scratch.children.length
        if !scratch.flexible[index]
            continue
        . live = scratch.children[index]
        . weight = scratch.weights[index]
        . proposed = remaining * weight / total-flex
        . margin = scratch.margins[index]
        . proposed-outer = proposed + margin
        . constrained-outer = live.constrained-outer-main-size(proposed-outer, orient, available)
        if constrained-outer != proposed-outer
            . constrained = gui-safe-span(constrained-outer - margin)
            . space = scratch.space-at(index)
            . taken = if space < 1 && constrained > proposed then scaled else constrained
                .. scaled = max(proposed, constrained * space)
            scratch.allocations[index] = constrained
            scratch.flexible[index] = false
            if space < 1
                scratch.shares[index] = gui-flex-footprint(constrained, taken, margin, space)
            remaining = gui-safe-span(remaining - taken)
            total-flex -= weight
            clamped-one = true
    if !clamped-one
        break

. allocated-flex Length = 0
. last-flex Index?
if total-flex > 0
    for index in 0 .. < scratch.children.length
        if scratch.flexible[index]
            last-flex = index

for index in 0 .. < scratch.children.length
    if scratch.flexible[index]
        . weight = scratch.weights[index]
        . allocation = remaining * weight / total-flex
        if last-flex && index == last-flex
            allocation = remaining - allocated-flex
        scratch.allocations[index] = gui-safe-span(allocation)
        allocated-flex += scratch.allocations[index]
        . space = scratch.space-at(index)
        if space < 1
            . span = scratch.allocations[index]
            scratch.shares[index] = gui-flex-footprint(span, span, scratch.margins[index], space)

if coupled
    . horizontal = orient == Orientation.horizontal
    for index in 0 .. < scratch.children.length
        if scratch.weights[index] > 0 && scratch.space-at(index) == 1
            . outer = scratch.allocations[index] + scratch.margins[index]
            scratch.set-share(index, scratch.children[index].presented-share(outer, horizontal))

. count = scratch.children.length
. used Length = 0
for index in 0 .. < count
    if scratch.weights[index] <= 0
        used += gui-main-size(scratch.measures[index], orient) * scratch.share-at(index)
    else
        used += (scratch.allocations[index] + scratch.margins[index]) * scratch.share-at(index)
used += gaps
. spacing = gui-flex-justify-spacing(box.$justify, gui-safe-span(available - used), count)
. offset = spacing.lead
. cross-size Length = 0
. has-baseline = false
. rigid = !coupled && !order && scratch.is-uniform && box.$justify == Justify.start
. reach Float
for index in 0 .. < count
    . live = scratch.children[index]
    . space = scratch.space-at(index)
    if index > 0
        offset += gap * space * reach + spacing.between
    reach = max(reach, space)
    . size = scratch.allocations[index]
    . is-flexible = scratch.weights[index] > 0
    if is-flexible
        size += scratch.margins[index]
    else
        size = gui-main-size(scratch.measures[index], orient)
    //gui.layout.arrange.children-arranged ++
    . align = flex-child-align(box, live)
    . child-query = query
    if is-flexible || scratch.shrinks[index] > 0
        rigid = false
        if orient == Orientation.horizontal
            child-query = MeasureQuery
                - if is-flexible then exact-axis-query(size) else fit-axis-query(size)
                - query.block
            live.flow-measure(child-query)
    if orient == Orientation.horizontal
        has-baseline = has-baseline || align == Alignment.first-baseline
    . rect = place-flex-child
        - live
        - content
        - child-query
        - scratch.measures[index]
        - offset
        - size
        - align
    cross-size = max(cross-size, flex-cross-extent(content, rect))
    offset += size * scratch.share-at(index)

box.has-rigid-flex-children = rigid && !has-baseline
if has-baseline
    cross-size = max(cross-size, gui-flex-align-baselines(box, scratch.children, content.y))

if orient == Orientation.horizontal
    box.inner-width = offset
    box.inner-height = cross-size
else
    box.inner-width = cross-size
    box.inner-height = offset

scratch.clear()
gui-flex-scratch-stack += scratch

────────────────────
_ do gather-flex-child @inline
    - scratch GUIFlexScratch
    - live Box
    - query MeasureQuery
    - coupled Bool
    - whole Bool

//gui.layout.arrange.children-considered ++
. space = if whole then 1.0 else live.layout-space
. weight = gui-flex-weight(live.$flex) * space
. margin = gui-main-inset-size(live.margin-edges, orient)
. size = Dimensions(0, 0)
. share = space
if weight > 0
    scratch.total-flex += weight
    scratch.fixed += margin * space
    if !whole
        live.place-flexibly()
else
    size = live.flow-measure(query).outer-size
    if !whole
        share = live.layout-share
            - gui-main-size(size, orient)
            - orient == Orientation.horizontal
            - coupled
    scratch.fixed += gui-main-size(size, orient) * share
if !whole
    scratch.add-space(space, share)
scratch.children += live
scratch.weights += weight
scratch.margins += margin
scratch.measures += size
scratch.allocations += 0
scratch.flexible += weight > 0
scratch.shrinks += if weight > 0 then 0.0 else gui-flex-weight(live.$shrink)

────────────────────
_ flex-child-align Alignment
    - box Box
    - live Box

|? orient == Orientation.horizontal
    live.$align-y ?? box.$align-children
??
    live.$align-x ?? box.$align-children

────────────────────
_ flex-cross-extent Length
    - content Rect
    - rect Rect

|? orient == Orientation.horizontal
    max(content.height, rect.bottom - content.y)
??
    max(content.width, rect.right - content.x)

────────────────────
_ flex-main-start Length
    - child Box

if orient == Orientation.horizontal then bounds.left else bounds.top

.. bounds = child.outer-bounds

────────────────────
_ do place-flex-child Rect
    - live Box
    - content Rect
    - query MeasureQuery
    - measured Dimensions
    - offset Length
    - size Length
    - align Alignment

if orient == Orientation.horizontal
    . stretched = gui-flex-stretched-cross(live, content.height, Orientation.vertical, measured)
    . cross = gui-flex-cross-axis(live, content.y, content.height, stretched, query, orient, align)
    . rect = Rect(content.x + offset, cross.start, size, cross.span)
    live.arrange-outer-bounds(rect)
    = rect
. stretched = gui-flex-stretched-cross(live, content.width, Orientation.horizontal, measured)
. cross = gui-flex-cross-axis(live, content.x, content.width, stretched, query, orient, align)
. rect = Rect(cross.start, content.y + offset, cross.span, size)
live.arrange-outer-bounds(rect)
= rect

────────────────────
_ do arrange-flex-stack-incremental Bool
    - box Box

. indexed-dirty = box.indexed-dirty-layout-children
if indexed-dirty
    . dirty = indexed-dirty
    . first-dirty = dirty[0]
    . last-dirty = first-dirty
    . first-start = flex-main-start(first-dirty)
    . last-start = first-start
    . ambiguous-order = false
    for index in 1 .. < dirty.length
        . candidate = dirty[index]
        . candidate-start = flex-main-start(candidate)
        if candidate-start < first-start
            first-dirty = candidate
            first-start = candidate-start
        else if candidate-start == first-start && candidate as Pointer != first-dirty as Pointer
            ambiguous-order = true
        if candidate-start > last-start
            last-dirty = candidate
            last-start = candidate-start
        else if candidate-start == last-start && candidate as Pointer != last-dirty as Pointer
            ambiguous-order = true
    if !ambiguous-order
        //gui.layout.arrange.indexed-dirty-ranges ++
        = arrange-flex-stack-range(box, first-dirty, last-dirty)
    //gui.layout.arrange.fallback.indexed-order ++

. query = box.child-layout-query()
. first-dirty Box?
. last-dirty Box?
. child = box.first-active-child
while child
    . live = child
    //gui.layout.arrange.children-considered ++
    if !live.has-last-measure-result(query)
        //gui.layout.arrange.fallback.no-child-history ++
        = false
    if live.$is-layout-invalid
        if !first-dirty
            first-dirty = live
        last-dirty = live
    child = live.next-active-sibling

if !first-dirty
    //gui.layout.arrange.fallback.no-candidate ++
    = false
= arrange-flex-stack-range(box, first-dirty, last-dirty!)

────────────────────
_ do arrange-flex-stack-range Bool
    - box Box
    - first-dirty Box
    - last-dirty Box

=? false if !first-dirty.participates-in-parent-layout(box) || last-outside
.. last-outside = !last-dirty.participates-in-parent-layout(box)
if !first-dirty.has-arrangement
    //gui.layout.arrange.fallback.unarranged ++
    = false
. content = box.content-bounds
. query = box.child-layout-query()
. gap = box.computed-gap
. horizontal = orient == Orientation.horizontal
. start = flex-main-start(first-dirty)
. offset = if horizontal then start - content.x else start - content.y
. retained-cross = if horizontal then box.inner-height else box.inner-width
. cross-size = retained-cross
. recompute-cross = false
. passed-dirty-range = false
. end = offset
. child Box? = first-dirty

while child
    . live = child
    . next-child = live.next-active-sibling
    //gui.layout.arrange.children-considered ++
    //gui.layout.arrange.children-arranged ++
    if !live.has-last-measure-result(query)
        //gui.layout.arrange.fallback.no-child-history ++
        = false
    =? false if live.is-released || live.layout-space != 1
    =? false if gui-flex-weight(live.$flex) > 0 || gui-flex-weight(live.$shrink) > 0
    . align = flex-child-align(box, live)
    =? false if horizontal && align == Alignment.first-baseline
    . previous = live.outer-bounds
    . previous-extent = flex-cross-extent(content, previous)
    . measured = live.flow-measure(query).outer-size
    . size = gui-main-size(measured, orient)
    . rect = place-flex-child(live, content, query, measured, offset, size, align)
    live.effective-position.settle(box, live)
    . extent = flex-cross-extent(content, rect)
    cross-size = max(cross-size, extent)
    if previous-extent >= retained-cross && extent < previous-extent
        recompute-cross = true
    end = offset + size
    offset = end + gap

    if live as Pointer == last-dirty as Pointer
        passed-dirty-range = true
    if passed-dirty-range && rect == previous
        settle-flex-stack-cross(box, content, cross-size, recompute-cross)
        //gui.layout.arrange.early-outs ++
        = true

    child = next-child

if horizontal
    box.inner-width = end
else
    box.inner-height = end
settle-flex-stack-cross(box, content, cross-size, recompute-cross)
//gui.layout.arrange.early-outs ++
= true

────────────────────
_ do settle-flex-stack-cross
    - box Box
    - content Rect
    - cross-size Length
    - recompute Bool

. size = cross-size
if recompute
    size = 0
    . child = box.first-active-child
    while child
        . live = child
        //gui.layout.arrange.children-considered ++
        size = max(size, flex-cross-extent(content, live.outer-bounds))
        child = live.next-active-sibling
if orient == Orientation.horizontal
    box.inner-height = size
else
    box.inner-width = size

━━━━━━━━━━━━━━━━━━━━
_ gui-flex-footprint Float
    - span Length
    - taken Length
    - margin Length
    - space Float

if outer > 0 then (taken + margin * space) / outer else 0.0

.. outer = span + margin

