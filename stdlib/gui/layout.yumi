+ do child-content-size-invalidated
    - box Box
    - child Box

=? if box.$is-active-list-invalid
if !child.participates-in-parent-layout(box)
    box.invalidate-layout()
    =
box.retain-indexed-dirty-layout-child(child)

────────────────────
+ get preserves-positioned-children-on-children-only

true

────────────────────
+ get sequence-axis

orient

────────────────────
+ measure-content
    - box Box
    - query MeasureQuery

gui-layout-natural-size(box, orient, query, 0)

────────────────────
+ carry-slot Index?
    - box Box
    - child Box

gui-carry-slot(box, child, orient)

────────────────────
_ do arrange-flow-content
    - box Box

. offset Length = 0
. cross-size Length = 0
. content = box.content-bounds
. query = box.child-layout-query()
. coupled = box.$stack-motion == StackMotion.coupled
. order = gui-carried-order(box)
if order
    for live in order
        . step = flow-place(live, content, query, coupled, offset)
        offset += step.width
        cross-size = max(cross-size, step.height)
else
    . child = box.first-active-child
    while child
        . live = child
        child = live.next-active-sibling
        //gui.layout.arrange.children-considered ++
        //gui.layout.arrange.children-arranged ++
        if !live.is-released
            . step = flow-place(live, content, query, coupled, offset)
            offset += step.width
            cross-size = max(cross-size, step.height)

if orient == Orientation.horizontal
    box.inner-width = offset
    box.inner-height = cross-size
else
    box.inner-width = cross-size
    box.inner-height = offset

────────────────────
_ do flow-place Dimensions
    - live Box
    - content Rect
    - query MeasureQuery
    - coupled Bool
    - offset Length

. intrinsic = live.flow-measure(query).outer-size
if orient == Orientation.horizontal
    . share = live.layout-share(intrinsic.width, true, coupled)
    live.arrange-outer-bounds
        - Rect(content.x + offset, content.y, intrinsic.width, intrinsic.height)
    = Dimensions(intrinsic.width * share, intrinsic.height)
. share = live.layout-share(intrinsic.height, false, coupled)
live.arrange-outer-bounds(Rect(content.x, content.y + offset, content.width, intrinsic.height))
= Dimensions(intrinsic.height * share, intrinsic.width)

────────────────────
_ do arrange-flow-content-incremental
    - box Box

. indexed-dirty = box.indexed-dirty-layout-children
if indexed-dirty
    . dirty = indexed-dirty
    . first-dirty = dirty[0]
    . last-dirty = first-dirty
    . first-start = flow-retained-main-start(first-dirty)
    . last-start = first-start
    . ambiguous-order = false
    for index in 1 .. < dirty.length
        . candidate = dirty[index]
        . candidate-start = flow-retained-main-start(candidate)
        if candidate-start < first-start
            first-dirty = candidate
            first-start = candidate-start
        else if candidate-start == first-start && candidate as Pointer != first-dirty as Pointer
            ambiguous-order = true
        if candidate-start > last-start
            last-dirty = candidate
            last-start = candidate-start
        else if candidate-start == last-start && candidate as Pointer != last-dirty as Pointer
            ambiguous-order = true
    if !ambiguous-order
        //gui.layout.arrange.indexed-dirty-ranges ++
        = arrange-flow-dirty-range(box, first-dirty, last-dirty)
    //gui.layout.arrange.fallback.indexed-order ++

. query = box.child-layout-query()
. first-dirty Box?
. last-dirty Box?
. has-history = true
. child = box.first-active-child
while child
    . live = child
    //gui.layout.arrange.children-considered ++
    if !live.has-last-measure-result(query)
        has-history = false
    if live.$is-layout-invalid
        if !first-dirty
            first-dirty = live
        last-dirty = live
    child = live.next-active-sibling

if !first-dirty
    //gui.layout.arrange.fallback.no-candidate ++
    = false
if !has-history
    //gui.layout.arrange.fallback.no-child-history ++
    = false
= arrange-flow-dirty-range(box, first-dirty, last-dirty!)

────────────────────
_ flow-retained-main-start Length
    - child Box

if orient == Orientation.horizontal then bounds.left else bounds.top

.. bounds = child.outer-bounds

────────────────────
_ do arrange-flow-dirty-range
    - box Box
    - first-dirty Box
    - last-dirty Box

. content = box.content-bounds
. query = box.child-layout-query()
=? false if box.$stack-motion == StackMotion.coupled
if !first-dirty.has-last-measure-result(query)
    //gui.layout.arrange.fallback.no-child-history ++
    = false
if !first-dirty.has-arrangement
    //gui.layout.arrange.fallback.unarranged ++
    = false

. previous-first-bounds = first-dirty.outer-bounds
. offset =
    |? orient == Orientation.horizontal
        previous-first-bounds.left - content.x
    ??
        previous-first-bounds.top - content.y

. retained-cross = if orient == Orientation.horizontal then box.inner-height else box.inner-width
. cross-size = retained-cross
. recompute-cross = false
. passed-dirty-range = false
. child Box? = first-dirty

while child
    . live = child
    . next-child = live.next-active-sibling
    //gui.layout.arrange.children-considered ++
    //gui.layout.arrange.children-arranged ++
    if !live.has-last-measure-result(query)
        //gui.layout.arrange.fallback.no-child-history ++
        = false
    =? false if live.is-released || live.layout-space != 1
    . previous-bounds = live.outer-bounds
    . previous-cross = live.last-measured-outer-cross-size(query, orient)
    . intrinsic = live.flow-measure(query).outer-size
    . intrinsic-cross = if is-horizontal then intrinsic.height else intrinsic.width
        .. is-horizontal = orient == Orientation.horizontal
    . rect =
        |? orient == Orientation.horizontal
            Rect(content.x + offset, content.y, intrinsic.width, intrinsic.height)
        ??
            Rect(content.x, content.y + offset, content.width, intrinsic.height)
    live.arrange-outer-bounds(rect)

    if orient == Orientation.horizontal
        offset += intrinsic.width
    else
        offset += intrinsic.height
    cross-size = max(cross-size, intrinsic-cross)
    if previous-cross == retained-cross && intrinsic-cross < previous-cross
        recompute-cross = true

    if live as Pointer == last-dirty as Pointer
        passed-dirty-range = true
    if passed-dirty-range && rect == previous-bounds
        if recompute-cross
            =? false if !recompute-flow-cross-size(box, query)
        else if orient == Orientation.horizontal
            box.inner-height = cross-size
        else
            box.inner-width = cross-size
        //gui.layout.arrange.early-outs ++
        = true

    child = next-child

if orient == Orientation.horizontal
    box.inner-width = offset
else
    box.inner-height = offset
if recompute-cross
    =? false if !recompute-flow-cross-size(box, query)
else if orient == Orientation.horizontal
    box.inner-height = cross-size
else
    box.inner-width = cross-size

//gui.layout.arrange.early-outs ++
= true

────────────────────
_ do recompute-flow-cross-size
    - box Box
    - query MeasureQuery

. cross-size Length = 0
. child = box.first-active-child
while child
    . live = child
    //gui.layout.arrange.children-considered ++
    =? false if !live.has-last-measure-result(query)
    . intrinsic-cross = live.last-measured-outer-cross-size(query, orient)
    cross-size = max(cross-size, intrinsic-cross)
    child = live.next-active-sibling
if orient == Orientation.horizontal
    box.inner-height = cross-size
else
    box.inner-width = cross-size
= true

━━━━━━━━━━━━━━━━━━━━
